NDS WITH '|' THEN acc WHEN ch >= '0' AND ch <= '9' THEN acc + ch WHEN acc <> '' THEN acc + '|' ELSE acc END), '|', '')]))]) AS m2, head([y IN [x IN [toString(head([(c2)-[:TARGET_RELEASE]->(rl:Release) | coalesce(rl.releaseName, rl.id)])), toString(c2._targetRelease)] WHERE x IS NOT NULL | replace(reduce(acc = '', ch IN [i IN range(0, size(x) - 1) | substring(x, i, 1)] | CASE WHEN acc ENDS WITH '|' THEN acc WHEN ch >= '0' AND ch <= '9' THEN acc + ch WHEN acc <> '' THEN acc + '|' ELSE acc END), '|', '')] WHERE y <> '']) AS c2Rel WHERE c2Rel = crRel AND m2 < pm WITH crRel, specNo, secNo, collect(DISTINCT {pid: id(p2), m: m2}) AS hits, max(m2) AS mx MATCH (p3:CRPack) WHERE id(p3) IN [z IN hits WHERE z.m = mx | z.pid] RETURN DISTINCT specNo AS specification, secNo AS clause, p3.crPackId AS cr_pack, p3.tsgMeeting AS tsg_meeting"
