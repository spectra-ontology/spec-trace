  "items": [
    {
      "id": "RAN1-analytic-pack_disposition_counts",
      "wg": "RAN1",
      "family": "pack_disposition_counts",
      "question": "For CR pack RP-221603, how many distinct RAN1 member documents have each source-verified whole-document disposition? Return the disposition code and its distinct-document count. A document with several recorded codes counts once in each relevant group.",
      "fields": [
        "disposition",
        "document_count"
      ],
      "authorship": "author-written analytical task",
      "selection_sha256": "00cda0f0ef4d6f2bf664e7368dc59364ecf7d392ca2afea47e0ff969d9678495",
      "anchor": [
        "tdoc:crpack/RP-221603"
      ],
      "gold": [
        [
          "agreed",
          "2"
        ]
      ],
      "reference_sql": "SELECT d.code,COUNT(DISTINCT REPLACE(m.cr,'tdoc:','')) FROM cr_in_pack m JOIN disposition d ON d.target=m.cr WHERE m.pack_id='tdoc:crpack/RP-221603' AND d.evidence_status='source_verified' AND d.scope='whole_target' GROUP BY d.code",
      "python_sql_agreement": true
    },
