{"queries":[{"id":"RAN1-q29a6754c388e","query":"MATCH (t:Tdoc {tdocNumber: $document}) WITH t MATCH (r:Resolution)-[:HAS_DISPOSITION]->(d:DecisionDisposition)-[:DISPOSITION_TARGET]->(t:Tdoc) MATCH (r)-[:MADE_AT]->(m:Meeting) WHERE m.workingGroup = 'RAN1' AND d.evidenceStatus = 'source_verified' AND d.assessmentMethod CONTAINS 'whole_target' MATCH (t)-[:BELONGS_TO_CR_PACK]->(p:CRPack) MATCH (t)-[:MODIFIES_SECTION]->(s:Section) RETURN DISTINCT d.dispositionCode AS disposition, m.meetingNumber AS wg_meeting, p.crPackId AS cr_pack, p.tsgMeeting AS tsg_meeting, s.sectionNumber AS clause"},{"id":"RAN1-q2e3bcd13a977","query":"MATCH (focus:CRPack {crPackId: $pack})-[:HAS_CR]->(t:Tdoc) MATCH (r:Resolution)-[:HAS_DISPOSITION]->(d:DecisionDisposition)-[:DISPOSITION_TARGET]->(t:Tdoc) MATCH (r)-[:MADE_AT]->(m:Meeting) WHERE m.workingGroup = 'RAN1' AND d.evidenceStatus = 'source_verified' AND d.assessmentMethod CONTAINS 'whole_target' MATCH (t)-[:MODIFIES_SECTION]->(s:Section) MATCH (s)-[:BELONGS_TO_SPEC]->(sp:Spec) MATCH (candidate:Tdoc)-[:MODIFIES_SECTION]->(s) MATCH (candidate)-[:BELONGS_TO_CR_PACK]->(p:CRPack) WITH t, d, m, s, sp, candidate, p, toInteger(split(p.tsgMeeting, '-')[0]) AS seq WHERE candidate = t OR seq < toInteger(split(m.meetingNumber, '-')[0]) RETURN DISTINCT sp.specNumber AS specification, s.sectionNumber AS clause, p.crPackId AS cr_pack, p.tsgMeeting AS tsg_meeting"},{"id":"RAN1-q3bc833f726da","query":"MATCH (t:Tdoc) WHERE t.type = 'CR' AND t.tdocNumber STARTS WITH 'R' AND t.clausesAffected CONTAINS $clause MATCH (r:Resolution)-[:HAS_DISPOSITION]->(d:DecisionDisposition)-[:DISPOSITION_TARGET]->(t:Tdoc) MATCH (r)-[:MADE_AT]->(m:Meeting) WHERE m.workingGroup = 'RAN1' AND d.evidenceStatus = 'source_verified' AND d.assessmentMethod CONTAINS 'whole_target' MATCH (t)-[:MODIFIES_SECTION]->(s:Section) RETURN DISTINCT t.tdocNumber AS document, d.dispositionCode AS disposition, m.meetingNumber AS wg_meeting, p.crPackId AS cr_pack"},{"id":"RAN1-q45c336a2d020","query":"MATCH (start:Tdoc {tdocNumber: $document})-[:REVISED_TO*1..]->(t:Tdoc) MATCH (r:Resolution)-[:HAS_DISPOSITION]->(d:DecisionDisposition)-[:DISPOSITION_TARGET]->(t:Tdoc) MATCH (r)-[:MADE_AT]->(m:Meeting) WHERE m.workingGroup = 'RAN1' AND d.evidenceStatus = 'source_verified' AND d.assessmentMethod CONTAINS 'whole_target' MATCH (t)-[:BELONGS_TO_CR_PACK]->(p:CRPack) RETURN DISTINCT t.tdocNumber AS final_document, d.dispositionCode AS disposition, p.crPackId AS cr_pack"},{"id":"RAN1-q5154c2ea6399","query":"MATCH (t:Tdoc {tdocNumber: $document}) WITH t MATCH (r:Resolution)-[:HAS_DISPOSITION]->(d:DecisionDisposition)-[:DISPOSITION_TARGET]->(t:Tdoc) MATCH (r)-[:MADE_AT]->(m:Meeting) WHERE m.workingGroup = 'RAN1' AND d.evidenceStatus = 'source_verified' AND d.assessmentMethod CONTAINS 'whole_target' MATCH (t)-[:BELONGS_TO_CR_PACK]->(p:CRPack) MATCH (t)-[:MODIFIES_SECTION]->(s:Section) RETURN DISTINCT d.dispositionCode AS disposition, m.meetingNumber AS wg_meeting, p.crPackId AS cr_pack, p.tsgMeeting AS tsg_meeting, s.sectionNumber AS clause"},{"id":"RAN1-q902d2fcdcbcb","query":"MATCH (t:Tdoc {tdocNumber: $document})-[:BELONGS_TO_CR_PACK]->(p:CRPack) RETURN DISTINCT p.crPackId AS cr_pack, p.tsgMeeting AS tsg_meeting"},{"id":"RAN1-qa546b7e1f645","query":"MATCH (focus:CRPack {crPackId: $pack})-[:HAS_CR]->(t:Tdoc) MATCH (r:Resolution)-[:HAS_DISPOSITION]->(d:DecisionDisposition)-[:DISPOSITION_TARGET]->(t:Tdoc) MATCH (r)-[:MADE_AT]->(m:Meeting) WHERE m.workingGroup = 'RAN1' AND d.evidenceStatus = 'source_verified' AND d.assessmentMethod CONTAINS 'whole_target' MATCH (t)-[:MODIFIES_SECTION]->(s:Section) MATCH (s)-[:BELONGS_TO_SPEC]->(sp:Spec) MATCH (candidate:Tdoc)-[:MODIFIES_SECTION]->(s) MATCH (candidate)-[:BELONGS_TO_CR_PACK]->(p:CRPack) WITH t, d, m, s, sp, candidate, p, toInteger(split(p.tsgMeeting, '-')[0]) AS seq WHERE seq < toInteger(split(m.meetingNumber, '-')[0]) RETURN DISTINCT sp.specNumber AS specification, s.sectionNumber AS clause, p.crPackId AS cr_pack, p.tsgMeeting 