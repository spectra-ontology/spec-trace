{
  "queries": [
    {
      "id": "RAN1-q29a6754c388e",
      "query": "MATCH (d:Tdoc)-[:BELONGS_TO_CR_PACK]->(p:CRPack) WHERE d.tdocNumber='R1-1913654' MATCH (m:Meeting {workingGroup:'RAN1'})<-[:MADE_AT]-(:Resolution)-[:HAS_DISPOSITION]->(v:DecisionDisposition {evidenceStatus:'source_verified'})-[:DISPOSITION_TARGET]->(d) WHERE replace(v.assessmentMethod,' ','') CONTAINS '\"scope\":\"whole_target\"' MATCH (d)-[:MODIFIES_SECTION]->(s:Section {specNumber:'38.213'}) RETURN DISTINCT v.dispositionCode AS disposition, m.meetingNumber AS wg_meeting, p.crPackId AS cr_pack, p.tsgMeeting AS tsg_meeting, s.sectionNumber AS clause"
    },
    {
      "id": "RAN1-q2e3bcd13a977",
      "query": "MATCH (d:Tdoc)-[:BELONGS_TO_CR_PACK]->(p:CRPack) WHERE p.crPackId='RP-192634' MATCH (m:Meeting {workingGroup:'RAN1'})<-[:MADE_AT]-(:Resolution)-[:HAS_DISPOSITION]->(v:DecisionDisposition {evidenceStatus:'source_verified'})-[:DISPOSITION_TARGET]->(d) WHERE replace(v.assessmentMethod,' ','') CONTAINS '\"scope\":\"whole_target\"' MATCH (d)-[:TARGET_RELEASE]->(r:Release), (d)-[:MODIFIES_SECTION]->(s:Section)-[:BELONGS_TO_SPEC]->(sp:Spec) WHERE sp.specRelease = r.releaseName AND r.releaseName IN ['Rel-16'] WITH DISTINCT d,p,s,r,toInteger(reduce(digits = '', ch IN split(toString(p.tsgMeeting), '') | digits + CASE WHEN ch >= '0' AND ch <= '9' THEN ch ELSE '' END)) AS currentMeeting WHERE NOT EXISTS { MATCH (r)<-[:TARGET_RELEASE]-(prev:Tdoc)-[:MODIFIES_SECTION]->(s), (prev)-[:BELONGS_TO_CR_PACK]->(old:CRPack) WHERE toInteger(reduce(digits = '', ch IN split(toString(old.tsgMeeting), '') | digits + CASE WHEN ch >= '0' AND ch <= '9' THEN ch ELSE '' END)) < currentMeeting } RETURN DISTINCT d.tdocNumber AS document, s.specNumber AS specification, s.sectionNumber AS clause"
    },
    {
      "id": "RAN1-q3bc833f726da",
      "query": "MATCH (d:Tdoc)-[:MODIFIES_SECTION]->(s:Section {sectionNumber:'4.2',specNumber:'38.213'})-[:BELONGS_TO_SPEC]->(:Spec {specRelease:'Rel-17'}) MATCH (d)-[:TARGET_RELEASE]->(:Release {releaseName:'Rel-17'}) MATCH (d:Tdoc)-[:BELONGS_TO_CR_PACK]->(p:CRPack) MATCH (m:Meeting {workingGroup:'RAN1'})<-[:MADE_AT]-(:Resolution)-[:HAS_DISPOSITION]->(v:DecisionDisposition {evidenceStatus:'source_verified'})-[:DISPOSITION_TARGET]->(d) WHERE replace(v.assessmentMethod,' ','') CONTAINS '\"scope\":\"whole_target\"' RETURN DISTINCT d.tdocNumber AS document, v.dispositionCode AS disposition, m.meetingNumber AS wg_meeting, p.crPackId AS cr_pack"
    },
