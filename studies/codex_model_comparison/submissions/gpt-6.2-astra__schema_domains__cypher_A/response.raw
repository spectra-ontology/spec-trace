      "query": "MATCH (d:Tdoc)-[:BELONGS_TO_CR_PACK]->(p:CRPack) WHERE d.tdocNumber='R1-1717870' RETURN DISTINCT p.crPackId AS cr_pack, p.tsgMeeting AS tsg_meeting"
    },
    {
      "id": "RAN1-qa546b7e1f645",
      "query": "MATCH (d:Tdoc)-[:BELONGS_TO_CR_PACK]->(p:CRPack) WHERE p.crPackId='RP-200692' MATCH (m:Meeting {workingGroup:'RAN1'})<-[:MADE_AT]-(:Resolution)-[:HAS_DISPOSITION]->(v:DecisionDisposition {evidenceStatus:'source_verified'})-[:DISPOSITION_TARGET]->(d) WHERE replace(v.assessmentMethod,' ','') CONTAINS '\"scope\":\"whole_target\"' MATCH (d)-[:TARGET_RELEASE]->(r:Release), (d)-[:MODIFIES_SECTION]->(s:Section)-[:BELONGS_TO_SPEC]->(sp:Spec) WHERE sp.specRelease = r.releaseName AND r.releaseName IN ['Rel-16'] WITH DISTINCT d,p,s,r,toInteger(reduce(digits = '', ch IN split(toString(p.tsgMeeting), '') | digits + CASE WHEN ch >= '0' AND ch <= '9' THEN ch ELSE '' END)) AS currentMeeting MATCH (r)<-[:TARGET_RELEASE]-(prev:Tdoc)-[:MODIFIES_SECTION]->(s), (prev)-[:BELONGS_TO_CR_PACK]->(old:CRPack) WHERE toInteger(reduce(digits = '', ch IN split(toString(old.tsgMeeting), '') | digits + CASE WHEN ch >= '0' AND ch <= '9' THEN ch ELSE '' END)) < currentMeeting WITH DISTINCT s,r,old,toInteger(reduce(digits = '', ch IN split(toString(old.tsgMeeting), '') | digits + CASE WHEN ch >= '0' AND ch <= '9' THEN ch ELSE '' END)) AS n WITH s,r,max(n) AS latest,collect({pack:old, meeting:n}) AS candidates UNWIND candidates AS candidate WITH s,candidate.pack AS p WHERE candidate.meeting=latest RETURN DISTINCT s.specNumber AS specification, s.sectionNumber AS clause, p.crPackId AS cr_pack, p.tsgMeeting AS tsg_meeting"
    },
