{"id":"RAN5-qe644473c854d","query":"MATCH (:Tdoc {tdocNumber:'R5-194984'})-[:BELONGS_TO_CR_PACK]->(p:CRPack) RETURN DISTINCT p.crPackId AS cr_pack,p.tsgMeeting AS tsg_meeting"},
{"id":"RAN5-qe85e166ea7f5","query":"MATCH (:Tdoc {tdocNumber:'R5-236866'})-[:REVISED_TO*1..]->(t:Tdoc)-[:BELONGS_TO_CR_PACK]->(p:CRPack), (d:DecisionDisposition {evidenceStatus:'source_verified'})-[:DISPOSITION_TARGET]->(t) WHERE d.assessmentMethod =~ '.*\"scope\"\\s*:\\s*\"whole_target\".*' RETURN DISTINCT t.tdocNumber AS final_document,d.dispositionCode AS disposition,p.crPackId AS cr_pack"}
