{"queries":[
{"id":"RAN1-q29a6754c388e","query":"MATCH (t:Tdoc {tdocNumber:'R1-1913654'})-[:BELONGS_TO_CR_PACK]->(p:CRPack), (d:DecisionDisposition {evidenceStatus:'source_verified'})-[:DISPOSITION_TARGET]->(t), (r:Resolution)-[:HAS_DISPOSITION]->(d), (r)-[:MADE_AT]->(m:Meeting {workingGroup:'RAN1'}), (t)-[:MODIFIES_SECTION]->(s:Section {specNumber:'38.213'}) WHERE d.assessmentMethod =~ '.*\"scope\"\\s*:\\s*\"whole_target\".*' RETURN DISTINCT d.dispositionCode AS disposition, m.meetingNumber AS wg_meeting, p.crPackId AS cr_pack, p.tsgMeeting AS tsg_meeting, s.sectionNumber AS clause"},
{"id":"RAN1-q2e3bcd13a977","query":"MATCH (t:Tdoc)-[:BELONGS_TO_CR_PACK]->(p:CRPack {crPackId:'RP-192634'}), (d:DecisionDisposition {evidenceStatus:'source_verified'})-[:DISPOSITION_TARGET]->(t), (t)-[:TARGET_RELEASE]->(rel:Release {releaseName:'Rel-16'}), (t)-[:MODIFIES_SECTION]->(s:Section)-[:BELONGS_TO_SPEC]->(sp:Spec {specRelease:'Rel-16'}) WHERE d.assessmentMethod =~ '.*\"scope\"\\s*:\\s*\"whole_target\".*' AND NOT EXISTS { MATCH (x:Tdoc)-[:TARGET_RELEASE]->(rel), (x)-[:MODIFIES_SECTION]->(s), (x)-[:BELONGS_TO_CR_PACK]->(q:CRPack) WHERE toInteger(q.tsgMeeting) < toInteger(p.tsgMeeting) } RETURN DISTINCT t.tdocNumber AS document, sp.specNumber AS specification, s.sectionNumber AS clause"},
{"id":"RAN1-q3bc833f726da","query":"MATCH (t:Tdoc)-[:TARGET_RELEASE]->(:Release {releaseName:'Rel-17'}), (t)-[:MODIFIES_SECTION]->(s:Section {sectionNumber:'4.2'})-[:BELONGS_TO_SPEC]->(:Spec {specNumber:'38.213',specRelease:'Rel-17'}), (t)-[:BELONGS_TO_CR_PACK]->(p:CRPack), (d:DecisionDisposition {evidenceStatus:'source_verified'})-[:DISPOSITION_TARGET]->(t), (r:Resolution)-[:HAS_DISPOSITION]->(d), (r)-[:MADE_AT]->(m:Meeting {workingGroup:'RAN1'}) WHERE d.assessmentMethod =~ '.*\"scope\"\\s*:\\s*\"whole_target\".*' RETURN DISTINCT t.tdocNumber AS document, d.dispositionCode AS disposition, m.meetingNumber AS wg_meeting, p.crPackId AS cr_pack"},
{"id":"RAN1-q45c336a2d020","query":"MATCH (a:Tdoc {tdocNumber:'R1-2403693'})-[:REVISED_TO*1..]->(t:Tdoc)-[:BELONGS_TO_CR_PACK]->(p:CRPack), (d:DecisionDisposition {evidenceStatus:'source_verified'})-[:DISPOSITION_TARGET]->(t) WHERE d.assessmentMethod =~ '.*\"scope\"\\s*:\\s*\"whole_target\".*' RETURN DISTINCT t.tdocNumber AS final_document, d.dispositionCode AS disposition, p.crPackId AS cr_pack"},
{"id":"RAN1-q5154c2ea6399","query":"MATCH (t:Tdoc {tdocNumber:'R1-2108591'})-[:BELONGS_TO_CR_PACK]->(p:CRPack), (d:DecisionDisposition {evidenceStatus:'source_verified'})-[:DISPOSITION_TARGET]->(t), (r:Resolution)-[:HAS_DISPOSITION]->(d), (r)-[:MADE_AT]->(m:Meeting {workingGroup:'RAN1'}) WHERE d.assessmentMethod =~ '.*\"scope\"\\s*:\\s*\"whole_target\".*' RETURN DISTINCT d.dispositionCode AS disposition, m.meetingNumber AS wg_meeting, p.crPackId AS cr_pack, p.tsgMeeting AS tsg_meeting"},
{"id":"RAN1-q902d2fcdcbcb","query":"MATCH (:Tdoc {tdocNumber:'R1-1717870'})-[:BELONGS_TO_CR_PACK]->(p:CRPack) RETURN DISTINCT p.crPackId AS cr_pack, p.tsgMeeting AS tsg_meeting"},
{"id":"RAN1-qa546b7e1f645","query":"MATCH (t:Tdoc)-[:BELONGS_TO_CR_PACK]->(p:CRPack {crPackId:'RP-200692'}), (d:DecisionDisposition {evidenceStatus:'source_verified'})-[:DISPOSITION_TARGET]->(t), (t)-[:TARGET_RELEASE]->(rel:Release {releaseName:'Rel-16'}), (t)-[:MODIFIES_SECTION]->(s:Section)-[:BELONGS_TO_SPEC]->(sp:Spec {specRelease:'Rel-16'}), (x:Tdoc)-[:TARGET_RELEASE]->(rel), (x)-[:MODIFIES_SECTION]->(s), (x)-[:BELONGS_TO_CR_PACK]->(q:CRPack) WHERE d.assessmentMethod =~ '.*\"scope\"\\s*:\\s*\"whole_target\".*' AND toInteger(q.tsgMeeting)<toInteger(p.tsgMeeting) WITH sp,s,q,p,rel ORDER BY toInteger(q.tsgMeeting) DESC WITH sp,s,collect(q) AS packs RETURN DISTINCT sp.specNumber AS specification,s.sectionNumber AS clause,head(packs).crPackId AS cr_pack,head(packs).tsgMeeting AS tsg_meeting"},
