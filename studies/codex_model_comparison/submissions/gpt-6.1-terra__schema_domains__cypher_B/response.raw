{"id":"RAN4-qb68ee1a1ea1c","query":"MATCH (a:Tdoc {tdocNumber:'R4-2108722'})-[:MODIFIES_SECTION]->(s:Section)-[:BELONGS_TO_SPEC]->(:Spec {specRelease:'Rel-15'}), (t:Tdoc)-[:MODIFIES_SECTION]->(s), (t)-[:TARGET_RELEASE]->(:Release {releaseName:'Rel-15'}), (t)-[:BELONGS_TO_CR_PACK]->(p:CRPack), (d:DecisionDisposition {evidenceStatus:'source_verified'})-[:DISPOSITION_TARGET]->(t), (r:Resolution)-[:HAS_DISPOSITION]->(d), (r)-[:MADE_AT]->(m:Meeting {workingGroup:'RAN4'}) WHERE t.tdocNumber<>a.tdocNumber AND d.assessmentMethod =~ '.*\"scope\"\\s*:\\s*\"whole_target\".*' RETURN DISTINCT s.sectionNumber AS clause,t.tdocNumber AS document,d.dispositionCode AS disposition,m.meetingNumber AS wg_meeting,p.crPackId AS cr_pack"},
{"id":"RAN5-q315c956af92f","query":"MATCH (:Tdoc {tdocNumber:'R5-191564'})-[:BELONGS_TO_CR_PACK]->(p:CRPack) RETURN DISTINCT p.crPackId AS cr_pack,p.tsgMeeting AS tsg_meeting"},
{"id":"RAN5-q4dced09756b2","query":"MATCH (t:Tdoc {tdocNumber:'R5-251067'})-[:BELONGS_TO_CR_PACK]->(p:CRPack), (d:DecisionDisposition {evidenceStatus:'source_verified'})-[:DISPOSITION_TARGET]->(t), (r:Resolution)-[:HAS_DISPOSITION]->(d), (r)-[:MADE_AT]->(m:Meeting {workingGroup:'RAN5'}), (t)-[:MODIFIES_SECTION]->(s:Section {specNumber:'38.522'}) WHERE d.assessmentMethod =~ '.*\"scope\"\\s*:\\s*\"whole_target\".*' RETURN DISTINCT d.dispositionCode AS disposition,m.meetingNumber AS wg_meeting,p.crPackId AS cr_pack,p.tsgMeeting AS tsg_meeting,s.sectionNumber AS clause"},
{"id":"RAN5-q62c0ba2e6e6a","query":"MATCH (t:Tdoc)-[:BELONGS_TO_CR_PACK]->(p:CRPack {crPackId:'RP-230947'}), (d:DecisionDisposition {evidenceStatus:'source_verified'})-[:DISPOSITION_TARGET]->(t), (t)-[:TARGET_RELEASE]->(rel:Release {releaseName:'Rel-17'}), (t)-[:MODIFIES_SECTION]->(s:Section)-[:BELONGS_TO_SPEC]->(sp:Spec {specRelease:'Rel-17'}) WHERE d.assessmentMethod =~ '.*\"scope\"\\s*:\\s*\"whole_target\".*' AND NOT EXISTS { MATCH (x:Tdoc)-[:TARGET_RELEASE]->(rel), (x)-[:MODIFIES_SECTION]->(s), (x)-[:BELONGS_TO_CR_PACK]->(q:CRPack) WHERE toInteger(q.tsgMeeting)<toInteger(p.tsgMeeting) } RETURN DISTINCT t.tdocNumber AS document,sp.specNumber AS specification,s.sectionNumber AS clause"},
{"id":"RAN5-q92cc544cbae2","query":"MATCH (t:Tdoc)-[:BELONGS_TO_CR_PACK]->(p:CRPack {crPackId:'RP-261275'}), (d:DecisionDisposition {evidenceStatus:'source_verified'})-[:DISPOSITION_TARGET]->(t), (t)-[:TARGET_RELEASE]->(rel:Release {releaseName:'Rel-19'}), (t)-[:MODIFIES_SECTION]->(s:Section)-[:BELONGS_TO_SPEC]->(sp:Spec {specRelease:'Rel-19'}), (x:Tdoc)-[:TARGET_RELEASE]->(rel), (x)-[:MODIFIES_SECTION]->(s), (x)-[:BELONGS_TO_CR_PACK]->(q:CRPack) WHERE d.assessmentMethod =~ '.*\"scope\"\\s*:\\s*\"whole_target\".*' AND toInteger(q.tsgMeeting)<toInteger(p.tsgMeeting) WITH sp,s,q ORDER BY toInteger(q.tsgMeeting) DESC WITH sp,s,collect(q) AS packs RETURN DISTINCT sp.specNumber AS specification,s.sectionNumber AS clause,head(packs).crPackId AS cr_pack,head(packs).tsgMeeting AS tsg_meeting"},
{"id":"RAN5-q9dd890b7d2e9","query":"MATCH (t:Tdoc)-[:TARGET_RELEASE]->(:Release {releaseName:'Rel-19'}), (t)-[:MODIFIES_SECTION]->(:Section {sectionNumber:'6.2A.3.1.1.3.3_1'})-[:BELONGS_TO_SPEC]->(:Spec {specNumber:'38.521-4',specRelease:'Rel-19'}), (t)-[:BELONGS_TO_CR_PACK]->(p:CRPack), (d:DecisionDisposition {evidenceStatus:'source_verified'})-[:DISPOSITION_TARGET]->(t), (r:Resolution)-[:HAS_DISPOSITION]->(d), (r)-[:MADE_AT]->(m:Meeting {workingGroup:'RAN5'}) WHERE d.assessmentMethod =~ '.*\"scope\"\\s*:\\s*\"whole_target\".*' RETURN DISTINCT t.tdocNumber AS document,d.dispositionCode AS disposition,m.meetingNumber AS wg_meeting,p.crPackId AS cr_pack"},
{"id":"RAN5-qbd0afb2d46d9","query":"MATCH (a:Tdoc {tdocNumber:'R5-186468'})-[:MODIFIES_SECTION]->(s:Section)-[:BELONGS_TO_SPEC]->(:Spec {specRelease:'Rel-15'}), (t:Tdoc)-[:MODIFIES_SECTION]->(s), (t)-[:TARGET_RELEASE]->(:Release {releaseName:'Rel-15'}), (t)-[:BELONGS_TO_CR_PACK]->(p:CRPack), (d:DecisionDisposition {evidenceStatus:'source_verified'})-[:DISPOSITION_TARGET]->(t), (r:Resolution)-[:HAS_DISPOSITION]->(d), (r)-[:MADE_AT]->(m:Meeting {workingGroup:'RAN5'}) WHERE t.tdocNumber<>a.tdocNumber AND d.assessmentMethod =~ '.*\"scope\"\\s*:\\s*\"whole_target\".*' RETURN DISTINCT s.sectionNumber AS clause,t.tdocNumber AS document,d.dispositionCode AS disposition,m.meetingNumber AS wg_meeting,p.crPackId AS cr_pack"},
{"id":"RAN5-qde317edc86b0","query":"MATCH (t:Tdoc)-[:BELONGS_TO_CR_PACK]->(:CRPack {crPackId:'RP-250731'}), (d:DecisionDisposition {evidenceStatus:'source_verified'})-[:DISPOSITION_TARGET]->(t), (r:Resolution)-[:HAS_DISPOSITION]->(d), (r)-[:MADE_AT]->(m:Meeting {workingGroup:'RAN5'}) WHERE d.assessmentMethod =~ '.*\"scope\"\\s*:\\s*\"whole_target\".*' RETURN DISTINCT t.tdocNumber AS document,d.dispositionCode AS disposition,m.meetingNumber AS wg_meeting"},
