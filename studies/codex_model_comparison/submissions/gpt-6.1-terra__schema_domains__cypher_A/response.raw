    {
      "id": "RAN1-q29a6754c388e",
      "query": "MATCH (c:Tdoc {tdocNumber: 'R1-1913654'}) MATCH (d:DecisionDisposition)-[:DISPOSITION_TARGET]->(c), (r:Resolution)-[:HAS_DISPOSITION]->(d), (r)-[:MADE_AT]->(m:Meeting) WHERE d.evidenceStatus = 'source_verified' AND d.assessmentMethod =~ '(?s).*\"scope\"\\\\s*:\\\\s*\"whole_target\".*' MATCH (c)-[:BELONGS_TO_CR_PACK]->(p:CRPack) MATCH (c)-[:MODIFIES_SECTION]->(s:Section)-[:BELONGS_TO_SPEC]->(sp:Spec {specNumber: '38.213'}) RETURN DISTINCT d.dispositionCode AS disposition, m.meetingNumber AS wg_meeting, p.crPackId AS cr_pack, p.tsgMeeting AS tsg_meeting, s.sectionNumber AS clause"
    },
    {
      "id": "RAN1-q2e3bcd13a977",
      "query": "MATCH (c:Tdoc)-[:BELONGS_TO_CR_PACK]->(p:CRPack {crPackId: 'RP-192634'}), (c)-[:TARGET_RELEASE]->(rel:Release), (c)-[:MODIFIES_SECTION]->(s:Section)-[:BELONGS_TO_SPEC]->(sp:Spec) MATCH (d:DecisionDisposition)-[:DISPOSITION_TARGET]->(c), (r:Resolution)-[:HAS_DISPOSITION]->(d), (r)-[:MADE_AT]->(m:Meeting) WHERE d.evidenceStatus = 'source_verified' AND d.assessmentMethod =~ '(?s).*\"scope\"\\\\s*:\\\\s*\"whole_target\".*' AND rel.releaseName IN ['Rel-16'] AND sp.specRelease = rel.releaseName AND NOT EXISTS { MATCH (other:Tdoc)-[:TARGET_RELEASE]->(rel), (other)-[:MODIFIES_SECTION]->(s), (other)-[:BELONGS_TO_CR_PACK]->(prior:CRPack) WHERE toInteger(reduce(n = '', ch IN split(toString(prior.tsgMeeting), '') | n + CASE WHEN ch >= '0' AND ch <= '9' THEN ch ELSE '' END)) < toInteger(reduce(n = '', ch IN split(toString(p.tsgMeeting), '') | n + CASE WHEN ch >= '0' AND ch <= '9' THEN ch ELSE '' END)) } RETURN DISTINCT c.tdocNumber AS document, sp.specNumber AS specification, s.sectionNumber AS clause"
    },
    {
      "id": "RAN1-q3bc833f726da",
      "query": "MATCH (c:Tdoc)-[:TARGET_RELEASE]->(:Release {releaseName: 'Rel-17'}), (c)-[:MODIFIES_SECTION]->(s:Section {sectionNumber: '4.2'})-[:BELONGS_TO_SPEC]->(sp:Spec {specNumber: '38.213', specRelease: 'Rel-17'}) MATCH (d:DecisionDisposition)-[:DISPOSITION_TARGET]->(c), (r:Resolution)-[:HAS_DISPOSITION]->(d), (r)-[:MADE_AT]->(m:Meeting) WHERE d.evidenceStatus = 'source_verified' AND d.assessmentMethod =~ '(?s).*\"scope\"\\\\s*:\\\\s*\"whole_target\".*' MATCH (c)-[:BELONGS_TO_CR_PACK]->(p:CRPack) RETURN DISTINCT c.tdocNumber AS document, d.dispositionCode AS disposition, m.meetingNumber AS wg_meeting, p.crPackId AS cr_pack"
