      "query": "MATCH path = (a:Tdoc {tdocNumber: 'R1-2403693'})-[:REVISED_TO|IS_REVISION_OF*1..]->(c:Tdoc) WHERE all(rel IN relationships(path) WHERE type(rel) = 'REVISED_TO') MATCH (d:DecisionDisposition)-[:DISPOSITION_TARGET]->(c), (r:Resolution)-[:HAS_DISPOSITION]->(d), (r)-[:MADE_AT]->(m:Meeting) WHERE d.evidenceStatus = 'source_verified' AND d.assessmentMethod =~ '(?s).*\"scope\"\\\\s*:\\\\s*\"whole_target\".*' MATCH (c)-[:BELONGS_TO_CR_PACK]->(p:CRPack) RETURN DISTINCT c.tdocNumber AS final_document, d.dispositionCode AS disposition, p.crPackId AS cr_pack"
    },
