      "query": "MATCH (c:Tdoc {tdocNumber: 'R1-1717870'})-[:BELONGS_TO_CR_PACK]->(p:CRPack) RETURN DISTINCT p.crPackId AS cr_pack, p.tsgMeeting AS tsg_meeting"
    },
    {
      "id": "RAN1-qa546b7e1f645",
      "query": "MATCH (c:Tdoc)-[:BELONGS_TO_CR_PACK]->(p:CRPack {crPackId: 'RP-200692'}), (c)-[:TARGET_RELEASE]->(rel:Release), (c)-[:MODIFIES_SECTION]->(s:Section)-[:BELONGS_TO_SPEC]->(sp:Spec) MATCH (d:DecisionDisposition)-[:DISPOSITION_TARGET]->(c), (r:Resolution)-[:HAS_DISPOSITION]->(d), (r)-[:MADE_AT]->(m:Meeting) WHERE d.evidenceStatus = 'source_verified' AND d.assessmentMethod =~ '(?s).*\"scope\"\\\\s*:\\\\s*\"whole_target\".*' AND rel.releaseName IN ['Rel-16'] AND sp.specRelease = rel.releaseName MATCH (other:Tdoc)-[:TARGET_RELEASE]->(rel), (other)-[:MODIFIES_SECTION]->(s), (other)-[:BELONGS_TO_CR_PACK]->(prior:CRPack) WHERE toInteger(reduce(n = '', ch IN split(toString(prior.tsgMeeting), '') | n + CASE WHEN ch >= '0' AND ch <= '9' THEN ch ELSE '' END)) < toInteger(reduce(n = '', ch IN split(toString(p.tsgMeeting), '') | n + CASE WHEN ch >= '0' AND ch <= '9' THEN ch ELSE '' END)) WITH sp, s, p, prior WHERE NOT EXISTS { MATCH (other2:Tdoc)-[:TARGET_RELEASE]->(rel), (other2)-[:MODIFIES_SECTION]->(s), (other2)-[:BELONGS_TO_CR_PACK]->(later:CRPack) WHERE toInteger(reduce(n = '', ch IN split(toString(later.tsgMeeting), '') | n + CASE WHEN ch >= '0' AND ch <= '9' THEN ch ELSE '' END)) < toInteger(reduce(n = '', ch IN split(toString(p.tsgMeeting), '') | n + CASE WHEN ch >= '0' AND ch <= '9' THEN ch ELSE '' END)) AND toInteger(reduce(n = '', ch IN split(toString(later.tsgMeeting), '') | n + CASE WHEN ch >= '0' AND ch <= '9' THEN ch ELSE '' END)) > toInteger(reduce(n = '', ch IN split(toString(prior.tsgMeeting), '') | n + CASE WHEN ch >= '0' AND ch <= '9' THEN ch ELSE '' END)) } RETURN DISTINCT sp.specNumber AS specification, s.sectionNumber AS clause, prior.crPackId AS cr_pack, prior.tsgMeeting AS tsg_meeting"
    },
