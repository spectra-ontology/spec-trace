{
  "queries": [
    {"id":"RAN1-q29a6754c388e","query":"MATCH (d:Tdoc {tdocNumber:'R1-1913654'})-[:PRESENTED_AT]->(wm:Meeting {workingGroup:'RAN1'}), (d)-[:BELONGS_TO_CR_PACK]->(p:CRPack), (d)-[:MODIFIES_SECTION]->(s:Section)-[:BELONGS_TO_SPEC]->(sp:Spec), (d)-[:PRESENTED_AT]->(tm:Meeting) MATCH (r:Resolution)-[:MADE_AT]->(wm), (r)-[:HAS_DISPOSITION]->(dd:DecisionDisposition)-[:DISPOSITION_TARGET]->(d) WHERE dd.evidenceStatus='source_verified' AND dd.assessmentMethod CONTAINS 'whole_target' AND r.resolutionScope='document_disposition' AND sp.specNumber='38.213' RETURN DISTINCT dd.dispositionCode AS disposition, wm.meetingNumber AS wg_meeting, p.crPackId AS cr_pack, tm.meetingNumber AS tsg_meeting, s.sectionNumber AS clause"},
    {"id":"RAN1-q2e3bcd13a977","query":"MATCH (p:CRPack {crPackId:'RP-192634'})-[:HAS_CR]->(d:Tdoc)-[:BELONGS_TO_CR_PACK]->(p), (d)-[:MODIFIES_SECTION]->(s:Section)-[:BELONGS_TO_SPEC]->(sp:Spec), (d)-[:TARGET_RELEASE]->(rel:Release {releaseName:'Rel-16'}), (d)-[:PRESENTED_AT]->(wm:Meeting {workingGroup:'RAN1'}), (d)-[:PRESENTED_AT]->(tm:Meeting) MATCH (r:Resolution)-[:MADE_AT]->(wm), (r)-[:HAS_DISPOSITION]->(dd:DecisionDisposition)-[:DISPOSITION_TARGET]->(d) WHERE dd.evidenceStatus='source_verified' AND dd.assessmentMethod CONTAINS 'whole_target' AND r.resolutionScope='document_disposition' AND NOT EXISTS { MATCH (prior:Tdoc)-[:MODIFIES_SECTION]->(s), (prior)-[:TARGET_RELEASE]->(rel), (prior)-[:BELONGS_TO_CR_PACK]->(pp:CRPack), (prior)-[:PRESENTED_AT]->(pt:Meeting) WHERE pt.meetingNumberInt < tm.meetingNumberInt } RETURN DISTINCT d.tdocNumber AS document, sp.specNumber AS specification, s.sectionNumber AS clause"},
    {"id":"RAN1-q3bc833f726da","query":"MATCH (d:Tdoc)-[:MODIFIES_SECTION]->(s:Section)-[:BELONGS_TO_SPEC]->(sp:Spec {specNumber:'38.213'}), (d)-[:TARGET_RELEASE]->(:Release {releaseName:'Rel-17'}), (d)-[:BELONGS_TO_CR_PACK]->(p:CRPack), (d)-[:PRESENTED_AT]->(wm:Meeting {workingGroup:'RAN1'}), (d)-[:PRESENTED_AT]->(tm:Meeting), (r:Resolution)-[:MADE_AT]->(wm), (r)-[:HAS_DISPOSITION]->(dd:DecisionDisposition)-[:DISPOSITION_TARGET]->(d) WHERE s.sectionNumber='4.2' AND dd.evidenceStatus='source_verified' AND dd.assessmentMethod CONTAINS 'whole_target' AND r.resolutionScope='document_disposition' RETURN DISTINCT d.tdocNumber AS document, dd.dispositionCode AS disposition, wm.meetingNumber AS wg_meeting, p.crPackId AS cr_pack"},
    {"id":"RAN1-q45c336a2d020","query":"MATCH (root:Tdoc {tdocNumber:'R1-2403693'})-[:REVISED_TO*1..]->(d:Tdoc)-[:BELONGS_TO_CR_PACK]->(p:CRPack), (d)-[:PRESENTED_AT]->(wm:Meeting {workingGroup:'RAN1'}), (r:Resolution)-[:MADE_AT]->(wm), (r)-[:HAS_DISPOSITION]->(dd:DecisionDisposition)-[:DISPOSITION_TARGET]->(d) WHERE dd.evidenceStatus='source_verified' AND dd.assessmentMethod CONTAINS 'whole_target' AND r.resolutionScope='document_disposition' RETURN DISTINCT d.tdocNumber AS final_document, dd.dispositionCode AS disposition, p.crPackId AS cr_pack"},
    {"id":"RAN1-q5154c2ea6399","query":"MATCH (d:Tdoc {tdocNumber:'R1-2108591'})-[:PRESENTED_AT]->(wm:Meeting {workingGroup:'RAN1'}), (d)-[:BELONGS_TO_CR_PACK]->(p:CRPack), (d)-[:PRESENTED_AT]->(tm:Meeting), (r:Resolution)-[:MADE_AT]->(wm), (r)-[:HAS_DISPOSITION]->(dd:DecisionDisposition)-[:DISPOSITION_TARGET]->(d) WHERE dd.evidenceStatus='source_verified' AND dd.assessmentMethod CONTAINS 'whole_target' AND r.resolutionScope='document_disposition' RETURN DISTINCT dd.dispositionCode AS disposition, wm.meetingNumber AS wg_meeting, p.crPackId AS cr_pack, tm.meetingNumber AS tsg_meeting"},
    {"id":"RAN1-q902d2fcdcbcb","query":"MATCH (d:Tdoc {tdocNumber:'R1-1717870'})-[:BELONGS_TO_CR_PACK]->(p:CRPack), (d)-[:PRESENTED_AT]->(tm:Meeting) RETURN DISTINCT p.crPackId AS cr_pack, tm.meetingNumber AS tsg_meeting"},
    {"id":"RAN1-qa546b7e1f645","query":"MATCH (pack:CRPack {crPackId:'RP-200692'})-[:HAS_CR]->(d:Tdoc)-[:MODIFIES_SECTION]->(s:Section)-[:BELONGS_TO_SPEC]->(sp:Spec), (d)-[:TARGET_RELEASE]->(rel:Release {releaseName:'Rel-16'}), (d)-[:BELONGS_TO_CR_PACK]->(pack), (d)-[:PRESENTED_AT]->(wm:Meeting {workingGroup:'RAN1'}), (r:Resolution)-[:MADE_AT]->(wm), (r)-[:HAS_DISPOSITION]->(dd:DecisionDisposition)-[:DISPOSITION_TARGET]->(d) WHERE dd.evidenceStatus='source_verified' AND dd.assessmentMethod CONTAINS 'whole_target' AND r.resolutionScope='document_disposition' WITH DISTINCT s,sp,rel,wm OPTIONAL MATCH (prior:Tdoc)-[:MODIFIES_SECTION]->(s), (prior)-[:TARGET_RELEASE]->(rel), (prior)-[:BELONGS_TO_CR_PACK]->(pp:CRPack), (prior)-[:PRESENTED_AT]->(pt:Meeting) WHERE pt.meetingNumberInt < wm.meetingNumberInt WITH s,sp,wm,max(pt.meetingNumberInt) AS latest WHERE latest IS NOT NULL MATCH (earlier:Tdoc)-[:MODIFIES_SECTION]->(s), (earlier)-[:BELONGS_TO_CR_PACK]->(p:CRPack), (earlier)-[:PRESENTED_AT]->(tm:Meeting {meetingNumberInt:latest}) RETURN DISTINCT sp.specNumber AS specification, s.sectionNumber AS clause, p.crPackId AS cr_pack, tm.meetingNumber AS tsg_meeting"},
