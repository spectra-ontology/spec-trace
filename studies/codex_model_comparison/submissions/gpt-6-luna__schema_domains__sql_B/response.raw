{"id":"RAN3-q1ba7910c1aeb","query":"SELECT DISTINCT x.number,d.code,m.label FROM cr_pack p JOIN cr_in_pack cp ON cp.pack_id=p.id JOIN document x ON x.id=cp.cr JOIN disposition d ON d.target=x.id JOIN resolution r ON r.id=d.resolution_id JOIN meeting m ON m.id=r.meeting_id WHERE p.pack_number='RP-233845' AND d.evidence_status='source_verified' AND d.scope='whole_target' AND m.wg='RAN3'"},
