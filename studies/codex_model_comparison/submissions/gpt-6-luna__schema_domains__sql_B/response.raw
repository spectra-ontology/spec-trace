{"id":"RAN3-q6ec77c41a74a","query":"WITH RECURSIVE chain(id) AS (SELECT id FROM document WHERE number='R3-221570' UNION SELECT rv.later FROM revision rv JOIN chain c ON rv.earlier=c.id) SELECT DISTINCT x.number,d.code,p.pack_number FROM chain c JOIN document x ON x.id=c.id JOIN disposition d ON d.target=x.id JOIN resolution r ON r.id=d.resolution_id JOIN meeting m ON m.id=r.meeting_id JOIN cr_in_pack cp ON cp.cr=x.id JOIN cr_pack p ON p.id=cp.pack_id WHERE x.number<>'R3-221570' AND d.evidence_status='source_verified' AND d.scope='whole_target' AND m.wg='RAN3'"},
{"id":"RAN3-q8a6100612fec","query":"WITH target AS (SELECT DISTINCT s.id,s.clause FROM document x JOIN cr_modifies_section cm ON cm.cr=x.id JOIN section s ON s.id=cm.section_id WHERE x.number='R3-194602' AND s.release='Rel-15') SELECT DISTINCT t.clause,x.number,d.code,m.label,p.pack_number FROM target t JOIN cr_modifies_section cm ON cm.section_id=t.id JOIN document x ON x.id=cm.cr JOIN disposition d ON d.target=x.id JOIN resolution r ON r.id=d.resolution_id JOIN meeting m ON m.id=r.meeting_id JOIN cr_in_pack cp ON cp.cr=x.id JOIN cr_pack p ON p.id=cp.pack_id WHERE x.number<>'R3-194602' AND x.target_release='Rel-15' AND d.evidence_status='source_verified' AND d.scope='whole_target' AND m.wg='RAN3'"},
{"id":"RAN3-qbb384d8ef29b","query":"SELECT DISTINCT p.pack_number,m.label FROM document x JOIN cr_in_pack cp ON cp.cr=x.id JOIN cr_pack p ON p.id=cp.pack_id JOIN meeting m ON m.id=p.tsg_meeting WHERE x.number='R3-215085'"},
{"id":"RAN3-qc544a5a2f69d","query":"WITH chosen AS (SELECT DISTINCT x.id,x.number,x.spec,x.target_release,s.clause FROM cr_pack p JOIN cr_in_pack cp ON cp.pack_id=p.id JOIN document x ON x.id=cp.cr JOIN disposition d ON d.target=x.id JOIN resolution r ON r.id=d.resolution_id JOIN meeting m ON m.id=r.meeting_id JOIN cr_modifies_section cm ON cm.cr=x.id JOIN section s ON s.id=cm.section_id WHERE p.pack_number='RP-233814' AND m.wg='RAN3' AND d.evidence_status='source_verified' AND d.scope='whole_target' AND x.target_release='Rel-18' AND s.release='Rel-18') SELECT DISTINCT c.number,c.spec,c.clause FROM chosen c WHERE NOT EXISTS (SELECT 1 FROM section s JOIN cr_modifies_section cm ON cm.section_id=s.id JOIN document x ON x.id=cm.cr JOIN cr_in_pack cp ON cp.cr=x.id JOIN cr_pack p ON p.id=cp.pack_id JOIN cr_pack cur ON cur.pack_number='RP-233814' WHERE s.spec=c.spec AND s.clause=c.clause AND s.release='Rel-18' AND x.target_release='Rel-18' AND p.tsg_number<cur.tsg_number)"},
{"id":"RAN3-qd2c056f983f8","query":"SELECT DISTINCT p.pack_number,m.label FROM document x JOIN cr_in_pack cp ON cp.cr=x.id JOIN cr_pack p ON p.id=cp.pack_id JOIN meeting m ON m.id=p.tsg_meeting WHERE x.number='R3-255122'"},
{"id":"RAN3-qdfe4d9c918aa","query":"SELECT DISTINCT x.number,d.code,m.label,p.pack_number FROM document x JOIN disposition d ON d.target=x.id JOIN resolution r ON r.id=d.resolution_id JOIN meeting m ON m.id=r.meeting_id JOIN cr_modifies_section cm ON cm.cr=x.id JOIN section s ON s.id=cm.section_id JOIN cr_in_pack cp ON cp.cr=x.id JOIN cr_pack p ON p.id=cp.pack_id WHERE x.target_release='Rel-16' AND s.release='Rel-16' AND s.spec='TS 38.413' AND s.clause='8.3.4' AND d.evidence_status='source_verified' AND d.scope='whole_target' AND m.wg='RAN3'"},
{"id":"RAN3-qf54b7fe1de2c","query":"WITH chosen AS (SELECT DISTINCT s.spec,s.clause,x.target_release FROM cr_pack p JOIN cr_in_pack cp ON cp.pack_id=p.id JOIN document x ON x.id=cp.cr JOIN disposition d ON d.target=x.id JOIN resolution r ON r.id=d.resolution_id JOIN meeting wm ON wm.id=r.meeting_id JOIN cr_modifies_section cm ON cm.cr=x.id JOIN section s ON s.id=cm.section_id WHERE p.pack_number='RP-200423' AND wm.wg='RAN3' AND d.evidence_status='source_verified' AND d.scope='whole_target' AND x.target_release='Rel-16' AND s.release='Rel-16'), prev AS (SELECT c.spec,c.clause,max(p2.tsg_number) n FROM chosen c JOIN section s ON s.spec=c.spec AND s.clause=c.clause AND s.release=c.target_release JOIN cr_modifies_section cm ON cm.section_id=s.id JOIN document x ON x.id=cm.cr AND x.target_release=c.target_release JOIN cr_in_pack cp ON cp.cr=x.id JOIN cr_pack p2 ON p2.id=cp.pack_id JOIN cr_pack cur ON cur.pack_number='RP-200423' WHERE p2.tsg_number<cur.tsg_number GROUP BY c.spec,c.clause) SELECT DISTINCT prev.spec,prev.clause,p.pack_number,m.label FROM prev JOIN cr_pack p ON p.tsg_number=prev.n JOIN meeting m ON m.id=p.tsg_meeting"},
{"id":"RAN4-q0da703b03ce1","query":"WITH chosen AS (SELECT DISTINCT s.spec,s.clause,x.target_release FROM cr_pack p JOIN cr_in_pack cp ON cp.pack_id=p.id JOIN document x ON x.id=cp.cr JOIN disposition d ON d.target=x.id JOIN resolution r ON r.id=d.resolution_id JOIN meeting wm ON wm.id=r.meeting_id JOIN cr_modifies_section cm ON cm.cr=x.id JOIN section s ON s.id=cm.section_id WHERE p.pack_number='RP-231340' AND wm.wg='RAN4' AND d.evidence_status='source_verified' AND d.scope='whole_target' AND x.target_release IN ('Rel-16','Rel-17','Rel-18')), prev AS (SELECT c.spec,c.clause,max(p2.tsg_number) n FROM chosen c JOIN section s ON s.spec=c.spec AND s.clause=c.clause AND s.release=c.target_release JOIN cr_modifies_section cm ON cm.section_id=s.id JOIN document x ON x.id=cm.cr AND x.target_release=c.target_release JOIN cr_in_pack cp ON cp.cr=x.id JOIN cr_pack p2 ON p2.id=cp.pack_id JOIN cr_pack cur ON cur.pack_number='RP-231340' WHERE p2.tsg_number<cur.tsg_number GROUP BY c.spec,c.clause) SELECT DISTINCT prev.spec,prev.clause,p.pack_number,m.label FROM prev JOIN cr_pack p ON p.tsg_number=prev.n JOIN meeting m ON m.id=p.tsg_meeting"},
{"id":"RAN4-q3f128c42c249","query":"WITH chosen AS (SELECT DISTINCT x.id,x.number,x.spec,s.clause FROM cr_pack p JOIN cr_in_pack cp ON cp.pack_id=p.id JOIN document x ON x.id=cp.cr JOIN disposition d ON d.target=x.id JOIN resolution r ON r.id=d.resolution_id JOIN meeting m ON m.id=r.meeting_id JOIN cr_modifies_section cm ON cm.cr=x.id JOIN section s ON s.id=cm.section_id WHERE p.pack_number='RP-250590' AND m.wg='RAN4' AND d.evidence_status='source_verified' AND d.scope='whole_target' AND x.target_release IN ('Rel-17','Rel-18') AND s.release=x.target_release) SELECT DISTINCT c.number,c.spec,c.clause FROM chosen c WHERE NOT EXISTS (SELECT 1 FROM section s JOIN cr_modifies_section cm ON cm.section_id=s.id JOIN document x ON x.id=cm.cr JOIN cr_in_pack cp ON cp.cr=x.id JOIN cr_pack p ON p.id=cp.pack_id JOIN cr_pack cur ON cur.pack_number='RP-250590' WHERE s.spec=c.spec AND s.clause=c.clause AND s.release=x.target_release AND p.tsg_number<cur.tsg_number)"},
{"id":"RAN4-q445cf0b14431","query":"SELECT DISTINCT x.number,d.code,m.label FROM cr_pack p JOIN cr_in_pack cp ON cp.pack_id=p.id JOIN document x ON x.id=cp.cr JOIN disposition d ON d.target=x.id JOIN resolution r ON r.id=d.resolution_id JOIN meeting m ON m.id=r.meeting_id WHERE p.pack_number='RP-202446' AND d.evidence_status='source_verified' AND d.scope='whole_target' AND m.wg='RAN4'"},
{"id":"RAN4-q5564f8be249d","query":"SELECT DISTINCT d.code,m.label,p.pack_number,tm.label,s.clause FROM document x JOIN disposition d ON d.target=x.id JOIN resolution r ON r.id=d.resolution_id JOIN meeting m ON m.id=r.meeting_id JOIN cr_in_pack cp ON cp.cr=x.id JOIN cr_pack p ON p.id=cp.pack_id JOIN meeting tm ON tm.id=p.tsg_meeting JOIN cr_modifies_section cm ON cm.cr=x.id JOIN section s ON s.id=cm.section_id WHERE x.number='R4-2313080' AND d.evidence_status='source_verified' AND d.scope='whole_target' AND m.wg='RAN4' AND s.spec='TS 38.101-1'"},
{"id":"RAN4-q5f9ae7ff4ca2","query":"SELECT DISTINCT p.pack_number,m.label FROM document x JOIN cr_in_pack cp ON cp.cr=x.id JOIN cr_pack p ON p.id=cp.pack_id JOIN meeting m ON m.id=p.tsg_meeting WHERE x.number='R4-2520572'"},
{"id":"RAN4-q686bae23d9ed","query":"SELECT DISTINCT x.number,d.code,m.label,p.pack_number FROM document x JOIN disposition d ON d.target=x.id JOIN resolution r ON r.id=d.resolution_id JOIN meeting m ON m.id=r.meeting_id JOIN cr_modifies_section cm ON cm.cr=x.id JOIN section s ON s.id=cm.section_id JOIN cr_in_pack cp ON cp.cr=x.id JOIN cr_pack p ON p.id=cp.pack_id WHERE x.target_release='Rel-18' AND s.release='Rel-18' AND s.spec='TS 38.133' AND s.clause='A.7.5.1.6' AND d.evidence_status='source_verified' AND d.scope='whole_target' AND m.wg='RAN4'"},
{"id":"RAN4-q6a9a6059b312","query":"WITH RECURSIVE chain(id) AS (SELECT id FROM document WHERE number='R4-2412759' UNION SELECT rv.later FROM revision rv JOIN chain c ON rv.earlier=c.id) SELECT DISTINCT x.number,d.code,p.pack_number FROM chain c JOIN document x ON x.id=c.id JOIN disposition d ON d.target=x.id JOIN resolution r ON r.id=d.resolution_id JOIN meeting m ON m.id=r.meeting_id JOIN cr_in_pack cp ON cp.cr=x.id JOIN cr_pack p ON p.id=cp.pack_id WHERE x.number<>'R4-2412759' AND d.evidence_status='source_verified' AND d.scope='whole_target' AND m.wg='RAN4'"},
{"id":"RAN4-q8321a5639b22","query":"SELECT DISTINCT d.code,m.label,p.pack_number,tm.label FROM document x JOIN disposition d ON d.target=x.id JOIN resolution r ON r.id=d.resolution_id JOIN meeting m ON m.id=r.meeting_id JOIN cr_in_pack cp ON cp.cr=x.id JOIN cr_pack p ON p.id=cp.pack_id JOIN meeting tm ON tm.id=p.tsg_meeting WHERE x.number='R4-1814116' AND d.evidence_status='source_verified' AND d.scope='whole_target' AND m.wg='RAN4'"},
{"id":"RAN4-qab608dcda8a2","query":"SELECT DISTINCT p.pack_number,m.label FROM document x JOIN cr_in_pack cp ON cp.cr=x.id JOIN cr_pack p ON p.id=cp.pack_id JOIN meeting m ON m.id=p.tsg_meeting WHERE x.number='R4-2320863'"},
{"id":"RAN4-qb68ee1a1ea1c","query":"WITH target AS (SELECT DISTINCT s.id,s.clause FROM document x JOIN cr_modifies_section cm ON cm.cr=x.id JOIN section s ON s.id=cm.section_id WHERE x.number='R4-2108722' AND s.release='Rel-15') SELECT DISTINCT t.clause,x.number,d.code,m.label,p.pack_number FROM target t JOIN cr_modifies_section cm ON cm.section_id=t.id JOIN document x ON x.id=cm.cr JOIN disposition d ON d.target=x.id JOIN resolution r ON r.id=d.resolution_id JOIN meeting m ON m.id=r.meeting_id JOIN cr_in_pack cp ON cp.cr=x.id JOIN cr_pack p ON p.id=cp.pack_id WHERE x.number<>'R4-2108722' AND x.target_release='Rel-15' AND d.evidence_status='source_verified' AND d.scope='whole_target' AND m.wg='RAN4'"},
{"id":"RAN5-q315c956af92f","query":"SELECT DISTINCT p.pack_number,m.label FROM document x JOIN cr_in_pack cp ON cp.cr=x.id JOIN cr_pack p ON p.id=cp.pack_id JOIN meeting m ON m.id=p.tsg_meeting WHERE x.number='R5-191564'"},
{"id":"RAN5-q4dced09756b2","query":"SELECT DISTINCT d.code,m.label,p.pack_number,tm.label,s.clause FROM document x JOIN disposition d ON d.target=x.id JOIN resolution r ON r.id=d.resolution_id JOIN meeting m ON m.id=r.meeting_id JOIN cr_in_pack cp ON cp.cr=x.id JOIN cr_pack p ON p.id=cp.pack_id JOIN meeting tm ON tm.id=p.tsg_meeting JOIN cr_modifies_section cm ON cm.cr=x.id JOIN section s ON s.id=cm.section_id WHERE x.number='R5-251067' AND d.evidence_status='source_verified' AND d.scope='whole_target' AND m.wg='RAN5' AND s.spec='TS 38.522'"},
{"id":"RAN5-q62c0ba2e6e6a","query":"WITH chosen AS (SELECT DISTINCT x.id,x.number,x.spec,s.clause FROM cr_pack p JOIN cr_in_pack cp ON cp.pack_id=p.id JOIN document x ON x.id=cp.cr JOIN disposition d ON d.target=x.id JOIN resolution r ON r.id=d.resolution_id JOIN meeting m ON m.id=r.meeting_id JOIN cr_modifies_section cm ON cm.cr=x.id JOIN section s ON s.id=cm.section_id WHERE p.pack_number='RP-230947' AND m.wg='RAN5' AND d.evidence_status='source_verified' AND d.scope='whole_target' AND x.target_release='Rel-17' AND s.release='Rel-17') SELECT DISTINCT c.number,c.spec,c.clause FROM chosen c WHERE NOT EXISTS (SELECT 1 FROM section s JOIN cr_modifies_section cm ON cm.section_id=s.id JOIN document x ON x.id=cm.cr JOIN cr_in_pack cp ON cp.cr=x.id JOIN cr_pack p ON p.id=cp.pack_id JOIN cr_pack cur ON cur.pack_number='RP-230947' WHERE s.spec=c.spec AND s.clause=c.clause AND s.release='Rel-17' AND x.target_release='Rel-17' AND p.tsg_number<cur.tsg_number)"},
{"id":"RAN5-q92cc544cbae2","query":"WITH chosen AS (SELECT DISTINCT s.spec,s.clause,x.target_release FROM cr_pack p JOIN cr_in_pack cp ON cp.pack_id=p.id JOIN document x ON x.id=cp.cr JOIN disposition d ON d.target=x.id JOIN resolution r ON r.id=d.resolution_id JOIN meeting wm ON wm.id=r.meeting_id JOIN cr_modifies_section cm ON cm.cr=x.id JOIN section s ON s.id=cm.section_id WHERE p.pack_number='RP-261275' AND wm.wg='RAN5' AND d.evidence_status='source_verified' AND d.scope='whole_target' AND x.target_release='Rel-19' AND s.release='Rel-19'), prev AS (SELECT c.spec,c.clause,max(p2.tsg_number) n FROM chosen c JOIN section s ON s.spec=c.spec AND s.clause=c.clause AND s.release=c.target_release JOIN cr_modifies_section cm ON cm.section_id=s.id JOIN document x ON x.id=cm.cr AND x.target_release=c.target_release JOIN cr_in_pack cp ON cp.cr=x.id JOIN cr_pack p2 ON p2.id=cp.pack_id JOIN cr_pack cur ON cur.pack_number='RP-261275' WHERE p2.tsg_number<cur.tsg_number GROUP BY c.spec,c.clause) SELECT DISTINCT prev.spec,prev.clause,p.pack_number,m.label FROM prev JOIN cr_pack p ON p.tsg_number=prev.n JOIN meeting m ON m.id=p.tsg_meeting"},
{"id":"RAN5-q9dd890b7d2e9","query":"SELECT DISTINCT x.number,d.code,m.label,p.pack_number FROM document x JOIN disposition d ON d.target=x.id JOIN resolution r ON r.id=d.resolution_id JOIN meeting m ON m.id=r.meeting_id JOIN cr_modifies_section cm ON cm.cr=x.id JOIN section s ON s.id=cm.section_id JOIN cr_in_pack cp ON cp.cr=x.id JOIN cr_pack p ON p.id=cp.pack_id WHERE x.target_release='Rel-19' AND s.release='Rel-19' AND s.spec='TS 38.521-4' AND s.clause='6.2A.3.1.1.3.3_1' AND d.evidence_status='source_verified' AND d.scope='whole_target' AND m.wg='RAN5'"},
{"id":"RAN5-qbd0afb2d46d9","query":"WITH target AS (SELECT DISTINCT s.id,s.clause FROM document x JOIN cr_modifies_section cm ON cm.cr=x.id JOIN section s ON s.id=cm.section_id WHERE x.number='R5-186468' AND s.release='Rel-15') SELECT DISTINCT t.clause,x.number,d.code,m.label,p.pack_number FROM target t JOIN cr_modifies_section cm ON cm.section_id=t.id JOIN document x ON x.id=cm.cr JOIN disposition d ON d.target=x.id JOIN resolution r ON r.id=d.resolution_id JOIN meeting m ON m.id=r.meeting_id JOIN cr_in_pack cp ON cp.cr=x.id JOIN cr_pack p ON p.id=cp.pack_id WHERE x.number<>'R5-186468' AND x.target_release='Rel-15' AND d.evidence_status='source_verified' AND d.scope='whole_target' AND m.wg='RAN5'"},
{"id":"RAN5-qde317edc86b0","query":"SELECT DISTINCT x.number,d.code,m.label FROM cr_pack p JOIN cr_in_pack cp ON cp.pack_id=p.id JOIN document x ON x.id=cp.cr JOIN disposition d ON d.target=x.id JOIN resolution r ON r.id=d.resolution_id JOIN meeting m ON m.id=r.meeting_id WHERE p.pack_number='RP-250731' AND d.evidence_status='source_verified' AND d.scope='whole_target' AND m.wg='RAN5'"},
{"id":"RAN5-qe63e08fab145","query":"SELECT DISTINCT d.code,m.label,p.pack_number,tm.label FROM document x JOIN disposition d ON d.target=x.id JOIN resolution r ON r.id=d.resolution_id JOIN meeting m ON m.id=r.meeting_id JOIN cr_in_pack cp ON cp.cr=x.id JOIN cr_pack p ON p.id=cp.pack_id JOIN meeting tm ON tm.id=p.tsg_meeting WHERE x.number='R5-203000' AND d.evidence_status='source_verified' AND d.scope='whole_target' AND m.wg='RAN5'"},
{"id":"RAN5-qe644473c854d","query":"SELECT DISTINCT p.pack_number,m.label FROM document x JOIN cr_in_pack cp ON cp.cr=x.id JOIN cr_pack p ON p.id=cp.pack_id JOIN meeting m ON m.id=p.tsg_meeting WHERE x.number='R5-194984'"},
{"id":"RAN5-qe85e166ea7f5","query":"WITH RECURSIVE chain(id) AS (SELECT id FROM document WHERE number='R5-236866' UNION SELECT rv.later FROM revision rv JOIN chain c ON rv.earlier=c.id) SELECT DISTINCT x.number,d.code,p.pack_number FROM chain c JOIN document x ON x.id=c.id JOIN disposition d ON d.target=x.id JOIN resolution r ON r.id=d.resolution_id JOIN meeting m ON m.id=r.meeting_id JOIN cr_in_pack cp ON cp.cr=x.id JOIN cr_pack p ON p.id=cp.pack_id WHERE x.number<>'R5-236866' AND d.evidence_status='source_verified' AND d.scope='whole_target' AND m.wg='RAN5'"}
