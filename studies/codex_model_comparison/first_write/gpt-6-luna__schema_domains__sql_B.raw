{"queries":[
{"id":"RAN1-q29a6754c388e","query":"SELECT DISTINCT d.code,m.label,p.pack_number,tm.label,s.clause FROM document x JOIN disposition d ON d.target=x.id JOIN resolution r ON r.id=d.resolution_id JOIN meeting m ON m.id=r.meeting_id JOIN cr_in_pack cp ON cp.cr=x.id JOIN cr_pack p ON p.id=cp.pack_id JOIN meeting tm ON tm.id=p.tsg_meeting JOIN cr_modifies_section cms ON cms.cr=x.id JOIN section s ON s.id=cms.section_id WHERE x.number='R1-1913654' AND d.evidence_status='source_verified' AND d.scope='whole_target' AND m.wg='RAN1' AND s.spec='TS 38.213'"},
{"id":"RAN1-q2e3bcd13a977","query":"WITH chosen AS (SELECT DISTINCT x.id,x.number,x.spec,x.target_release,s.clause FROM cr_pack p JOIN cr_in_pack cp ON cp.pack_id=p.id JOIN document x ON x.id=cp.cr JOIN disposition d ON d.target=x.id JOIN resolution r ON r.id=d.resolution_id JOIN meeting m ON m.id=r.meeting_id JOIN cr_modifies_section cms ON cms.cr=x.id JOIN section s ON s.id=cms.section_id WHERE p.pack_number='RP-192634' AND m.wg='RAN1' AND d.evidence_status='source_verified' AND d.scope='whole_target' AND x.target_release='Rel-16' AND s.release='Rel-16'), earlier AS (SELECT c.*,p2.tsg_number FROM chosen c JOIN cr_modifies_section cm2 ON 1=1 JOIN section s2 ON s2.id=cm2.section_id AND s2.spec=c.spec AND s2.clause=c.clause AND s2.release=c.target_release JOIN document x2 ON x2.id=cm2.cr JOIN cr_in_pack cp2 ON cp2.cr=x2.id JOIN cr_pack p2 ON p2.id=cp2.pack_id WHERE x2.target_release=c.target_release) SELECT DISTINCT c.number,c.spec,c.clause FROM chosen c WHERE NOT EXISTS (SELECT 1 FROM earlier e WHERE e.spec=c.spec AND e.clause=c.clause AND e.tsg_number < (SELECT tsg_number FROM cr_pack WHERE pack_number='RP-192634'))"},
{"id":"RAN1-q3bc833f726da","query":"SELECT DISTINCT x.number,d.code,m.label,p.pack_number FROM document x JOIN disposition d ON d.target=x.id JOIN resolution r ON r.id=d.resolution_id JOIN meeting m ON m.id=r.meeting_id JOIN cr_modifies_section cms ON cms.cr=x.id JOIN section s ON s.id=cms.section_id JOIN cr_in_pack cp ON cp.cr=x.id JOIN cr_pack p ON p.id=cp.pack_id WHERE x.target_release='Rel-17' AND s.release='Rel-17' AND s.spec='TS 38.213' AND s.clause='4.2' AND d.evidence_status='source_verified' AND d.scope='whole_target' AND m.wg='RAN1'"},
{"id":"RAN1-q45c336a2d020","query":"WITH RECURSIVE chain(id) AS (SELECT id FROM document WHERE number='R1-2403693' UNION SELECT rv.later FROM revision rv JOIN chain c ON rv.earlier=c.id) SELECT DISTINCT x.number,d.code,p.pack_number FROM chain c JOIN document x ON x.id=c.id JOIN disposition d ON d.target=x.id JOIN resolution r ON r.id=d.resolution_id JOIN meeting m ON m.id=r.meeting_id JOIN cr_in_pack cp ON cp.cr=x.id JOIN cr_pack p ON p.id=cp.pack_id WHERE x.number<>'R1-2403693' AND d.evidence_status='source_verified' AND d.scope='whole_target' AND m.wg='RAN1'"},
{"id":"RAN1-q5154c2ea6399","query":"SELECT DISTINCT d.code,m.label,p.pack_number,tm.label FROM document x JOIN disposition d ON d.target=x.id JOIN resolution r ON r.id=d.resolution_id JOIN meeting m ON m.id=r.meeting_id JOIN cr_in_pack cp ON cp.cr=x.id JOIN cr_pack p ON p.id=cp.pack_id JOIN meeting tm ON tm.id=p.tsg_meeting WHERE x.number='R1-2108591' AND d.evidence_status='source_verified' AND d.scope='whole_target' AND m.wg='RAN1'"},
{"id":"RAN1-q902d2fcdcbcb","query":"SELECT DISTINCT p.pack_number,m.label FROM document x JOIN cr_in_pack cp ON cp.cr=x.id JOIN cr_pack p ON p.id=cp.pack_id JOIN meeting m ON m.id=p.tsg_meeting WHERE x.number='R1-1717870'"},
{"id":"RAN1-qa546b7e1f645","query":"WITH chosen AS (SELECT DISTINCT s.spec,s.clause,x.target_release FROM cr_pack p JOIN cr_in_pack cp ON cp.pack_id=p.id JOIN document x ON x.id=cp.cr JOIN disposition d ON d.target=x.id JOIN resolution r ON r.id=d.resolution_id JOIN meeting m ON m.id=r.meeting_id JOIN cr_modifies_section cms ON cms.cr=x.id JOIN section s ON s.id=cms.section_id WHERE p.pack_number='RP-200692' AND m.wg='RAN1' AND d.evidence_status='source_verified' AND d.scope='whole_target' AND x.target_release='Rel-16' AND s.release='Rel-16'), earlier AS (SELECT c.spec,c.clause,max(p2.tsg_number) n FROM chosen c JOIN section s2 ON s2.spec=c.spec AND s2.clause=c.clause AND s2.release=c.target_release JOIN cr_modifies_section cm2 ON cm2.section_id=s2.id JOIN document x2 ON x2.id=cm2.cr AND x2.target_release=c.target_release JOIN cr_in_pack cp2 ON cp2.cr=x2.id JOIN cr_pack p2 ON p2.id=cp2.pack_id JOIN cr_pack cur ON cur.pack_number='RP-200692' WHERE p2.tsg_number<cur.tsg_number GROUP BY c.spec,c.clause) SELECT DISTINCT e.spec,e.clause,p.pack_number,m.label FROM earlier e JOIN cr_pack p ON p.tsg_number=e.n JOIN meeting m ON m.id=p.tsg_meeting"},
{"id":"RAN1-qc8472684e9bd","query":"SELECT DISTINCT x.number,d.code,m.label FROM cr_pack p JOIN cr_in_pack cp ON cp.pack_id=p.id JOIN document x ON x.id=cp.cr JOIN disposition d ON d.target=x.id JOIN resolution r ON r.id=d.resolution_id JOIN meeting m ON m.id=r.meeting_id WHERE p.pack_number='RP-241065' AND d.evidence_status='source_verified' AND d.scope='whole_target' AND m.wg='RAN1'"},
{"id":"RAN1-qd1d995f3c7e6","query":"WITH target AS (SELECT DISTINCT s.id,s.clause FROM document x JOIN cr_modifies_section cm ON cm.cr=x.id JOIN section s ON s.id=cm.section_id WHERE x.number='R1-2202802' AND s.release='Rel-17'), peers AS (SELECT DISTINCT s.clause,x.number,d.code,m.label,p.pack_number FROM target t JOIN cr_modifies_section cm ON cm.section_id=t.id JOIN document x ON x.id=cm.cr JOIN disposition d ON d.target=x.id JOIN resolution r ON r.id=d.resolution_id JOIN meeting m ON m.id=r.meeting_id JOIN cr_in_pack cp ON cp.cr=x.id JOIN cr_pack p ON p.id=cp.pack_id WHERE x.number<>'R1-2202802' AND x.target_release='Rel-17' AND d.evidence_status='source_verified' AND d.scope='whole_target' AND m.wg='RAN1') SELECT DISTINCT * FROM peers"},
{"id":"RAN1-qf2e42a4bc65f","query":"SELECT DISTINCT p.pack_number,m.label FROM document x JOIN cr_in_pack cp ON cp.cr=x.id JOIN cr_pack p ON p.id=cp.pack_id JOIN meeting m ON m.id=p.tsg_meeting WHERE x.number='R1-2202945'"},
