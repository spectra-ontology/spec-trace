@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix spectra: <https://w3id.org/spectra#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/spectra> a owl:Ontology ;
    rdfs:label "SPECTRA: A Traceability Ontology for 3GPP RAN Standardization"@en ;
    dcterms:creator <https://orcid.org/0000-0002-3471-1498> ;
    dcterms:description "SPECTRA represents standardization records, source-grounded evidence, target-specific decision dispositions, and qualified relations in a shared vocabulary. This release provides 37 classes, 86 object properties, 112 datatype properties, and a companion set of 44 SHACL node shapes."@en ;
    dcterms:issued "2026-05-08"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-11-25"^^xsd:date ;
    dcterms:publisher <https://github.com/spectra-ontology> ;
    dcterms:rights "Creative Commons Attribution 4.0 International (CC BY 4.0)"@en ;
    dcterms:title "SPECTRA: A Traceability Ontology for 3GPP RAN Standardization"@en ;
    vann:preferredNamespacePrefix "spectra" ;
    vann:preferredNamespaceUri "https://w3id.org/spectra#" ;
    rdfs:seeAlso <https://github.com/spectra-ontology/spec-trace> ;
    owl:priorVersion <https://w3id.org/spectra/1.1.1> ;
    owl:versionIRI <https://w3id.org/spectra/1.2.0> ;
    owl:versionInfo "1.2.0" .

spectra:FeatureAssertion a owl:Class ;
    rdfs:label "Feature and encoding assertion"@en ;
    rdfs:comment "An assessed relation in a feature's source-grounded concept graph, including feature composition, feature evolution and capability-to-ASN.1 encoding correspondences. Subject, predicate IRI and object identify the exact assessed relation."@en ;
    rdfs:subClassOf spectra:EvidenceAssertion .

spectra:aboutTdoc a owl:ObjectProperty ;
    rdfs:label "document discussed by decision"@en ;
    rdfs:comment "The contributed document whose entry supplies this Resolution's discussion or disposition context. This identifies the subject document; approval is represented by its qualified DecisionDisposition."@en ;
    rdfs:domain spectra:Resolution ;
    rdfs:range spectra:Tdoc ;
    rdfs:subPropertyOf spectra:references .

spectra:abstract a owl:DatatypeProperty ;
    rdfs:label "abstract"@en ;
    rdfs:comment "Abstract/summary of the TDoc (often empty)"@en ;
    rdfs:domain spectra:Tdoc ;
    rdfs:range xsd:string .

spectra:affectedSection a owl:DatatypeProperty ;
    rdfs:label "affected section"@en ;
    rdfs:comment "Section number affected by this TR impact (e.g., 5.2, 8.1)"@en ;
    rdfs:domain spectra:TRImpact ;
    rdfs:range xsd:string .

spectra:affectsCN a owl:DatatypeProperty ;
    rdfs:label "affects CN"@en ;
    rdfs:comment "Whether this CR affects CN (Core Network)"@en ;
    rdfs:domain spectra:CR ;
    rdfs:range xsd:boolean .

spectra:affectsCoreSpec a owl:ObjectProperty ;
    rdfs:label "affects core spec"@en ;
    rdfs:comment "Core Specification(s) affected by this CR (from 'Other specs affected' section)"@en ;
    rdfs:domain spectra:CR ;
    rdfs:range spectra:Spec .

spectra:affectsME a owl:DatatypeProperty ;
    rdfs:label "affects ME"@en ;
    rdfs:comment "Whether this CR affects ME (Mobile Equipment)"@en ;
    rdfs:domain spectra:CR ;
    rdfs:range xsd:boolean .

spectra:affectsOMSpec a owl:ObjectProperty ;
    rdfs:label "affects OM spec"@en ;
    rdfs:comment "O&M Specification(s) affected by this CR (from 'Other specs affected' section)"@en ;
    rdfs:domain spectra:CR ;
    rdfs:range spectra:Spec .

spectra:affectsRAN a owl:DatatypeProperty ;
    rdfs:label "affects RAN"@en ;
    rdfs:comment "Whether this CR affects RAN (Radio Access Network)"@en ;
    rdfs:domain spectra:CR ;
    rdfs:range xsd:boolean .

spectra:affectsTestSpec a owl:ObjectProperty ;
    rdfs:label "affects test spec"@en ;
    rdfs:comment "Test Specification(s) affected by this CR (from 'Other specs affected' section)"@en ;
    rdfs:domain spectra:CR ;
    rdfs:range spectra:Spec .

spectra:affectsUICC a owl:DatatypeProperty ;
    rdfs:label "affects UICC"@en ;
    rdfs:comment "Whether this CR affects UICC (Universal Integrated Circuit Card)"@en ;
    rdfs:domain spectra:CR ;
    rdfs:range xsd:boolean .

spectra:agendaDescription a owl:DatatypeProperty ;
    rdfs:label "agenda description"@en ;
    rdfs:comment "Description/title of the agenda item"@en ;
    rdfs:domain spectra:AgendaItem ;
    rdfs:range xsd:string .

spectra:agendaNumber a owl:DatatypeProperty ;
    rdfs:label "agenda number"@en ;
    rdfs:comment "Hierarchical agenda number (e.g., 9.1, 9.1.1)"@en ;
    rdfs:domain spectra:AgendaItem ;
    rdfs:range xsd:string .

spectra:aliases a owl:DatatypeProperty ;
    rdfs:label "aliases"@en ;
    rdfs:comment "Alternative names/spellings for this company"@en ;
    rdfs:domain spectra:Company ;
    rdfs:range xsd:string .

spectra:asn1ChunkId a owl:DatatypeProperty ;
    rdfs:label "ASN.1 chunk ID (Qdrant FK)"@en ;
    rdfs:comment "Foreign key into Qdrant ran{N}_ts_asn1_chunks: the chunk holding the byte-identical ASN.1 body of this RRCParameter. Enables answer-pipeline byte-equal verification of cited IE bodies."@en ;
    rdfs:domain spectra:RRCParameter ;
    rdfs:range xsd:string .

spectra:assertionId a owl:DatatypeProperty ;
    rdfs:label "assertion ID"@en ;
    rdfs:comment "Stable identifier of an assessed evidence assertion."@en ;
    rdfs:domain spectra:EvidenceAssertion ;
    rdfs:range xsd:string .

spectra:assertionObject a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "assertion object"@en ;
    rdfs:comment "The object of the relation being assessed; recording it alone does not assert that relation."@en ;
    rdfs:domain spectra:EvidenceAssertion ;
    rdfs:range rdfs:Resource .

spectra:assertionPredicateIRI a owl:DatatypeProperty ;
    rdfs:label "assertion predicate IRI"@en ;
    rdfs:comment "The full relation IRI represented as an anyURI literal in an assessed application claim."@en ;
    rdfs:domain spectra:EvidenceAssertion ;
    rdfs:range xsd:anyURI .

spectra:assertionSubject a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "assertion subject"@en ;
    rdfs:comment "The subject of the relation being assessed; recording it alone does not assert that relation."@en ;
    rdfs:domain spectra:EvidenceAssertion ;
    rdfs:range rdfs:Resource .

spectra:assessmentMethod a owl:DatatypeProperty ;
    rdfs:label "assessment method"@en ;
    rdfs:comment "The reproducible rule or documented source review that assessed the exact claim."@en ;
    rdfs:domain spectra:EvidenceAssertion ;
    rdfs:range xsd:string .

spectra:belongsTo a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "belongs to"@en ;
    rdfs:comment "Primary AgendaItem recorded in this Tdoc's registration. Actual placement in a meeting report is recorded separately by reportedUnderAgenda, including re-tabled documents."@en ;
    rdfs:domain spectra:Tdoc ;
    rdfs:range spectra:AgendaItem .

spectra:candidateImpactsSection a owl:ObjectProperty ;
    rdfs:label "candidate impact section"@en ;
    rdfs:comment "A proposed target section preserved for assessment, separately from a source-verified incorporation claim."@en ;
    rdfs:domain spectra:TRImpact ;
    rdfs:range spectra:Section .

spectra:candidateImpactsSpec a owl:ObjectProperty ;
    rdfs:label "candidate impact specification"@en ;
    rdfs:comment "A proposed target specification preserved for assessment. This relation asserts the candidate target, rather than incorporation of the TR into the specification."@en ;
    rdfs:domain spectra:TRImpact ;
    rdfs:range spectra:Spec .

spectra:canonicalMeetingNumber a owl:DatatypeProperty ;
    rdfs:label "canonical meeting number"@en ;
    rdfs:comment "Normalized meeting number without -e suffix for COVID e-meeting matching (e.g., RAN1#101-e → RAN1#101). Used for Resolution linking."@en ;
    rdfs:domain spectra:Meeting ;
    rdfs:range xsd:string .

spectra:capabilityGranularity a owl:DatatypeProperty ;
    rdfs:label "capability granularity"@en ;
    rdfs:comment "Per-UE / Per-Band / Per-BC (band combination) / Per-FeatureSet — the granularity level of this capability."@en ;
    rdfs:domain spectra:CapabilityItem ;
    rdfs:range xsd:string .

spectra:capabilityItemName a owl:DatatypeProperty ;
    rdfs:label "capability item name"@en ;
    rdfs:comment "Name of the capability item (e.g., 'codebookParametersAddition-r16', 'tci-StatePDSCH'). Extracted from 38.306 row leading token."@en ;
    rdfs:domain spectra:CapabilityItem ;
    rdfs:range xsd:string .

spectra:caption a owl:DatatypeProperty ;
    rdfs:label "caption"@en ;
    rdfs:comment "Caption text for Figure, Table, or Chart (optional for Figure/Table, required for Chart)"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( spectra:Figure spectra:Table spectra:Chart ) ] ;
    rdfs:range xsd:string .

spectra:ccTo a owl:ObjectProperty ;
    rdfs:label "cc to"@en ;
    rdfs:comment "Working Group(s) copied on this LS"@en ;
    rdfs:domain spectra:LS ;
    rdfs:range spectra:WorkingGroup .

spectra:chairedBy a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "chaired by"@en ;
    rdfs:comment "Company whose employee chaired this session"@en ;
    rdfs:domain spectra:SessionNotes ;
    rdfs:range spectra:Company .

spectra:chartId a owl:DatatypeProperty ;
    rdfs:label "chart ID"@en ;
    rdfs:comment "Chart unique identifier (e.g., CHT-114b-001)"@en ;
    rdfs:domain spectra:Chart ;
    rdfs:range xsd:string .

spectra:chartNumber a owl:DatatypeProperty ;
    rdfs:label "chart number"@en ;
    rdfs:comment "Original number from caption (e.g., 6.3.2-1)"@en ;
    rdfs:domain spectra:Chart ;
    rdfs:range xsd:string .

spectra:chartPath a owl:DatatypeProperty ;
    rdfs:label "chart path"@en ;
    rdfs:comment "Path to the extracted chart XML file"@en ;
    rdfs:domain spectra:Chart ;
    rdfs:range xsd:string .

spectra:chartType a owl:DatatypeProperty ;
    rdfs:label "chart type"@en ;
    rdfs:comment "Chart type extracted from XML (scatterChart, lineChart, barChart, pieChart, etc.)"@en ;
    rdfs:domain spectra:Chart ;
    rdfs:range xsd:string .

spectra:clausesAffected a owl:DatatypeProperty ;
    rdfs:label "clauses affected"@en ;
    rdfs:comment "Specification clauses affected by this CR (e.g., '5.3.1, 5.3.2')"@en ;
    rdfs:domain spectra:CR ;
    rdfs:range xsd:string .

spectra:companyName a owl:DatatypeProperty ;
    rdfs:label "company name"@en ;
    rdfs:comment "Canonical name of the company/organization"@en ;
    rdfs:domain spectra:Company ;
    rdfs:range xsd:string .

spectra:conclusions a owl:DatatypeProperty ;
    rdfs:label "conclusions"@en ;
    rdfs:comment "Research conclusions of the TR (from Conclusions section, 1-10 sentences)"@en ;
    rdfs:domain spectra:TechnicalReport ;
    rdfs:range xsd:string .

spectra:consequencesIfNotApproved a owl:DatatypeProperty ;
    rdfs:label "consequences if not approved"@en ;
    rdfs:comment "Consequences if this CR is not approved (from CR document 'Consequences if not approved' field)"@en ;
    rdfs:domain spectra:CR ;
    rdfs:range xsd:string .

spectra:contactId a owl:DatatypeProperty ;
    rdfs:label "contact ID"@en ;
    rdfs:comment "3GPP system unique ID for the contact"@en ;
    rdfs:domain spectra:Contact ;
    rdfs:range xsd:string .

spectra:contactName a owl:DatatypeProperty ;
    rdfs:label "contact name"@en ;
    rdfs:comment "Name of the contact person"@en ;
    rdfs:domain spectra:Contact ;
    rdfs:range xsd:string .

spectra:containedIn a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "contained in"@en ;
    rdfs:comment "Meeting that contains this Figure/Table/Chart"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( spectra:Figure spectra:Table spectra:Chart ) ] ;
    rdfs:range spectra:Meeting .

spectra:content a owl:DatatypeProperty ;
    rdfs:label "content"@en ;
    rdfs:comment "Resolution text with equations replaced by [EQUATION] markers. For Text-to-Cypher search (Spec §8)."@en ;
    rdfs:domain spectra:Resolution ;
    rdfs:range xsd:string .

spectra:contentWithEquations a owl:DatatypeProperty ;
    rdfs:label "content with equations"@en ;
    rdfs:comment "Resolution content with OMML equations converted to inline LaTeX ($...$). For LLM answer generation and UI rendering (Spec §8)."@en ;
    rdfs:domain spectra:Resolution ;
    rdfs:range xsd:string .

spectra:crCategory a owl:DatatypeProperty ;
    rdfs:label "CR category"@en ;
    rdfs:comment "CR category. Values: F (Fix), A (Mirror), B (Addition), C (Functional modification), D (Editorial), E (Early implementation)"@en ;
    rdfs:domain spectra:CR ;
    rdfs:range xsd:string .

spectra:crNumber a owl:DatatypeProperty ;
    rdfs:label "CR number"@en ;
    rdfs:comment "Official CR number (e.g., 0693). DraftCR and pCR may not have this."@en ;
    rdfs:domain spectra:CR ;
    rdfs:range xsd:string .

spectra:crPackId a owl:DatatypeProperty ;
    rdfs:label "CR pack ID"@en ;
    rdfs:comment "CR Pack unique identifier from Cover Sheet directory name (e.g., RP-250233)"@en ;
    rdfs:domain spectra:CRPack ;
    rdfs:range xsd:string .

spectra:crRevision a owl:DatatypeProperty ;
    rdfs:label "CR revision"@en ;
    rdfs:comment "CR revision number (1-9). Indicates how many times this CR has been revised."@en ;
    rdfs:domain spectra:CR ;
    rdfs:range xsd:string .

spectra:direction a owl:DatatypeProperty ;
    rdfs:label "direction"@en ;
    rdfs:comment "LS direction. Values: in (received), out (sent)"@en ;
    rdfs:domain spectra:LS ;
    rdfs:range xsd:string .

spectra:discussionText a owl:DatatypeProperty ;
    rdfs:label "document discussion text"@en ;
    rdfs:comment "Meeting-report discussion retained on a contributed Tdoc by the RAN5 report producer. Its text provides discussion context; qualified dispositions identify individual document decisions."@en ;
    rdfs:domain spectra:Tdoc ;
    rdfs:range xsd:string .

spectra:disjointWith a owl:IrreflexiveProperty,
        owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "disjoint with feature"@en ;
    rdfs:comment "Marks two Features as conceptually distinct even if they share spec sections (e.g., LTM disjoint with CHO/CPC/CPAC although all sit in 38.331 §5.3.5.x). Catalog disjoint_feature_groups guide answer checks; graph assertions require separately assessed source evidence. The endpoints are distinct Feature individuals; this application relation is separate from OWL class disjointness."@en ;
    rdfs:domain spectra:Feature ;
    rdfs:range spectra:Feature .

spectra:dispositionCode a owl:DatatypeProperty ;
    rdfs:label "disposition code"@en ;
    rdfs:comment "The target-specific disposition: agreed, withdrawn, rejected, not_agreed, not_pursued, not_treated, merged, not_concluded, replied_to, noted, postponed, revised, endorsed, conditionally_agreed, partially_agreed or ambiguous. Only agreed denotes unconditional agreement of the target document."@en ;
    rdfs:domain spectra:DecisionDisposition ;
    rdfs:range xsd:string .

spectra:dispositionId a owl:DatatypeProperty ;
    rdfs:label "disposition ID"@en ;
    rdfs:comment "Stable identity of one decision, target and assessed source span."@en ;
    rdfs:domain spectra:DecisionDisposition ;
    rdfs:range xsd:string .

spectra:dispositionTarget a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "disposition target"@en ;
    rdfs:comment "The exact document revision to which this disposition applies."@en ;
    rdfs:domain spectra:DecisionDisposition ;
    rdfs:range spectra:Tdoc .

spectra:enablesFeature a owl:ObjectProperty ;
    rdfs:label "enables feature"@en ;
    rdfs:comment "Procedure enables a Feature (e.g., BFR Procedure enables 'Beam Failure Recovery' feature)."@en ;
    rdfs:domain spectra:Procedure ;
    rdfs:range spectra:Feature .

spectra:equations a owl:DatatypeProperty ;
    rdfs:label "equations"@en ;
    rdfs:comment "LaTeX equations found within the table cells (multi-valued)"@en ;
    rdfs:domain spectra:Table ;
    rdfs:range xsd:string .

spectra:evidenceLocator a owl:DatatypeProperty ;
    rdfs:label "evidence locator"@en ;
    rdfs:comment "Explicit source-span locator, including the indexing and text extraction convention."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( spectra:EvidenceAssertion spectra:EvidenceFragment ) ] ;
    rdfs:range xsd:string .

spectra:evidencePath a owl:DatatypeProperty ;
    rdfs:label "evidence path"@en ;
    rdfs:comment "Repository-relative path of the assessed source file."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( spectra:EvidenceAssertion spectra:EvidenceFragment ) ] ;
    rdfs:range xsd:string .

spectra:evidenceQuote a owl:DatatypeProperty ;
    rdfs:label "evidence quote"@en ;
    rdfs:comment "Exact source quotation assessed for this claim; source hashes and locators identify its context."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( spectra:EvidenceAssertion spectra:EvidenceFragment ) ] ;
    rdfs:range xsd:string .

spectra:evidenceSha256 a owl:DatatypeProperty ;
    rdfs:label "evidence SHA-256"@en ;
    rdfs:comment "Lowercase SHA-256 of the source file's exact bytes."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( spectra:EvidenceAssertion spectra:EvidenceFragment ) ] ;
    rdfs:range xsd:string .

spectra:evidenceStatus a owl:DatatypeProperty ;
    rdfs:label "evidence status"@en ;
    rdfs:comment "Assessment state: source_verified, pending or rejected. source_verified requires the specified method and exact source evidence; pending preserves a claim awaiting that assessment; rejected preserves a reviewed claim that its evidence does not support."@en ;
    rdfs:domain spectra:EvidenceAssertion ;
    rdfs:range xsd:string .

spectra:evolvesAcrossRelease a owl:ObjectProperty ;
    rdfs:label "evolves across release"@en ;
    rdfs:comment "Feature is updated/extended in this Release. Many-to-many: one Feature can span multiple releases (e.g., Type-II codebook in Rel-15/16/17/18/19)."@en ;
    rdfs:domain spectra:Feature ;
    rdfs:range spectra:Release .

spectra:featureDescription a owl:DatatypeProperty ;
    rdfs:label "feature description"@en ;
    rdfs:comment "Free-text description of the feature for reader context."@en ;
    rdfs:domain spectra:Feature ;
    rdfs:range xsd:string .

spectra:featureName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "feature name"@en ;
    rdfs:comment "Canonical feature name (e.g., 'Rel-16 Enhanced Type-II codebook'). Functional — one canonical name per feature."@en ;
    rdfs:domain spectra:Feature ;
    rdfs:range xsd:string .

spectra:figureCaption a owl:DatatypeProperty ;
    rdfs:label "figure caption"@en ;
    rdfs:comment "TS figure caption text (e.g., 'PDSCH resource allocation procedure')"@en ;
    rdfs:domain spectra:TSFigure ;
    rdfs:range xsd:string .

spectra:figureId a owl:DatatypeProperty ;
    rdfs:label "figure ID"@en ;
    rdfs:comment "Figure unique identifier (e.g., FIG-112-001 for Report Figure, 38.214-F5-1 for TSFigure)"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( spectra:Figure spectra:TSFigure ) ] ;
    rdfs:range xsd:string .

spectra:figureNumber a owl:DatatypeProperty ;
    rdfs:label "figure number"@en ;
    rdfs:comment "Original figure number from caption (e.g., Figure 1 for Report, 5-1 for TSFigure)"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( spectra:Figure spectra:TSFigure ) ] ;
    rdfs:range xsd:string .

spectra:filePath a owl:DatatypeProperty ;
    rdfs:label "file path"@en ;
    rdfs:comment "Path to the extracted file (image for Figure, HTML for Table, or chart asset for Chart)"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( spectra:Figure spectra:Table spectra:Chart ) ] ;
    rdfs:range xsd:string .

spectra:for a owl:DatatypeProperty ;
    rdfs:label "for"@en ;
    rdfs:comment "Purpose of the TDoc. Values: Decision, Discussion, Approval, Agreement, Endorsement, Information, Presentation, Action"@en ;
    rdfs:domain spectra:Tdoc ;
    rdfs:range xsd:string .

spectra:granularity a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "entity granularity"@en ;
    rdfs:comment "Granularity level of an entity instance. Values: 'item' (individual entry, e.g., one specific IE name or one capability item), 'section' (legacy section-level label retained from v2.0/v2.1 ingestion), or 'sub-item' (sub-entry within an item)."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( spectra:SourceUnit spectra:RRCParameter spectra:CapabilityItem spectra:Procedure spectra:PerformanceRequirement spectra:ConformanceTest ) ] ;
    rdfs:range xsd:string .

spectra:hasCapability a owl:ObjectProperty ;
    rdfs:label "has capability"@en ;
    rdfs:comment "Feature has a UE capability item (CapabilityItem). Specialisation of tdoc:hasComponent for capability-typed components."@en ;
    rdfs:domain spectra:Feature ;
    rdfs:range spectra:CapabilityItem ;
    rdfs:subPropertyOf spectra:hasComponent .

spectra:hasChart a owl:ObjectProperty ;
    rdfs:label "has chart"@en ;
    rdfs:comment "Chart(s) referenced in this Resolution content"@en ;
    rdfs:domain spectra:Resolution ;
    rdfs:range spectra:Chart .

spectra:hasConformanceTest a owl:ObjectProperty ;
    rdfs:label "has conformance test"@en ;
    rdfs:comment "Feature has a conformance test (ConformanceTest). Specialisation of tdoc:hasComponent for test-typed components."@en ;
    rdfs:domain spectra:Feature ;
    rdfs:range spectra:ConformanceTest ;
    rdfs:subPropertyOf spectra:hasComponent .

spectra:hasConsensus a owl:DatatypeProperty ;
    rdfs:label "has consensus"@en ;
    rdfs:comment "Whether consensus was reached for this conclusion"@en ;
    rdfs:domain spectra:Conclusion ;
    rdfs:range xsd:boolean .

spectra:hasContact a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has contact"@en ;
    rdfs:comment "Contact person responsible for the TDoc"@en ;
    rdfs:domain spectra:Tdoc ;
    rdfs:range spectra:Contact .

spectra:hasEvidence a owl:ObjectProperty ;
    rdfs:label "has evidence"@en ;
    rdfs:comment "Source fragments assessed together for this recorded claim."@en ;
    rdfs:domain spectra:EvidenceAssertion ;
    rdfs:range spectra:EvidenceFragment .

spectra:hasFFS a owl:DatatypeProperty ;
    rdfs:label "has FFS"@en ;
    rdfs:comment "Whether the resolution contains a 'For Further Study' marker"@en ;
    rdfs:domain spectra:Resolution ;
    rdfs:range xsd:boolean .

spectra:hasFigure a owl:ObjectProperty ;
    rdfs:label "has figure"@en ;
    rdfs:comment "Figure(s) referenced in this Resolution content"@en ;
    rdfs:domain spectra:Resolution ;
    rdfs:range spectra:Figure .

spectra:hasPerfRequirement a owl:ObjectProperty ;
    rdfs:label "has performance requirement"@en ;
    rdfs:comment "Feature has a quantitative performance requirement (PerformanceRequirement). Specialisation of tdoc:hasComponent for perf-req-typed components."@en ;
    rdfs:domain spectra:Feature ;
    rdfs:range spectra:PerformanceRequirement ;
    rdfs:subPropertyOf spectra:hasComponent .

spectra:hasProcedure a owl:ObjectProperty ;
    rdfs:label "has procedure"@en ;
    rdfs:comment "Feature has a protocol procedure (Procedure). Specialisation of tdoc:hasComponent for procedure-typed components."@en ;
    rdfs:domain spectra:Feature ;
    rdfs:range spectra:Procedure ;
    rdfs:subPropertyOf spectra:hasComponent .

spectra:hasReleaseVariant a owl:ObjectProperty ;
    rdfs:label "has release variant"@en ;
    rdfs:comment "v4.1 (release-aware, hybrid): inverse of tdoc:inReleaseOf — an ABSTRACT HUB Spec node to its RELEASE-KEYED variants (one per release present in the corpus). 0..* (a spec lacking a frozen final for some release has no variant there)."@en ;
    rdfs:domain spectra:Spec ;
    rdfs:range spectra:Spec ;
    owl:inverseOf spectra:inReleaseOf .

spectra:hasSection a owl:ObjectProperty ;
    rdfs:label "has section"@en ;
    rdfs:comment "Top-level Section(s) contained in this Spec: only Sections without parentSection. Membership of every Section is belongsToSpec."@en ;
    rdfs:domain spectra:Spec ;
    rdfs:range spectra:Section ;
    rdfs:subPropertyOf [ owl:inverseOf spectra:belongsToSpec ] .

spectra:hasTBD a owl:DatatypeProperty ;
    rdfs:label "has TBD"@en ;
    rdfs:comment "Whether the resolution contains a 'To Be Determined' marker"@en ;
    rdfs:domain spectra:Resolution ;
    rdfs:range xsd:boolean .

spectra:hasTable a owl:ObjectProperty ;
    rdfs:label "has table"@en ;
    rdfs:comment "Table(s) referenced in this Resolution content"@en ;
    rdfs:domain spectra:Resolution ;
    rdfs:range spectra:Table .

spectra:ieKind a owl:DatatypeProperty ;
    rdfs:label "IE kind"@en ;
    rdfs:comment "ASN.1 IE kind (SEQUENCE, CHOICE, ENUMERATED, BIT STRING, etc.)"@en ;
    rdfs:domain spectra:RRCParameter ;
    rdfs:range xsd:string .

spectra:ieName a owl:DatatypeProperty ;
    rdfs:label "IE name"@en ;
    rdfs:comment "ASN.1 IE name (e.g., 'CodebookConfig-r16', 'BeamFailureRecoveryConfig'). Matches Qdrant payload asn1.ieName field."@en ;
    rdfs:domain spectra:RRCParameter ;
    rdfs:range xsd:string .

spectra:impactDescription a owl:DatatypeProperty ;
    rdfs:label "impact description"@en ;
    rdfs:comment "Description of how the TR impacts the TS/Section"@en ;
    rdfs:domain spectra:TRImpact ;
    rdfs:range xsd:string .

spectra:impactType a owl:DatatypeProperty ;
    rdfs:label "impact type"@en ;
    rdfs:comment "Assessed claim category: NewTS, NewSection, ExtendSection, NoChange or TopicalCandidate. TopicalCandidate retains a pending retrieval association to candidateImpactsSpec. evidenceStatus records whether the source supports that claim; a pending NoChange records a proposed classification awaiting assessment."@en ;
    rdfs:domain spectra:TRImpact ;
    rdfs:range xsd:string .

spectra:introducedInRelease a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "introduced in release"@en ;
    rdfs:comment "Release name where this feature was first introduced (e.g., 'Rel-16' for Enhanced Type-II)."@en ;
    rdfs:domain spectra:Feature ;
    rdfs:range xsd:string .

spectra:isCapabilityComposite a owl:DatatypeProperty ;
    rdfs:label "is capability composite"@en ;
    rdfs:comment "Whether this RRCParameter is a UE-capability composite IE (e.g., CodebookComboParametersAdditionPerBC-r16) vs a normal RRC parameter IE. Distinguished by naming patterns (Combo*, ParametersAddition, Mixed). Helps RRC IE vs capability composite separation."@en ;
    rdfs:domain spectra:RRCParameter ;
    rdfs:range xsd:boolean .

spectra:isVoid a owl:DatatypeProperty ;
    rdfs:label "is void"@en ;
    rdfs:comment "Whether this section contains only 'Void' text (true) or has real content (false)"@en ;
    rdfs:domain spectra:Section ;
    rdfs:range xsd:boolean .

spectra:level a owl:DatatypeProperty ;
    rdfs:label "level"@en ;
    rdfs:comment "Hierarchy level (1-6). Derived from heading style: Heading 1-5 → 1-5, H6/Heading 6 → 6, Heading 8/9 → 1 (Annex)"@en ;
    rdfs:domain spectra:Section ;
    rdfs:range xsd:integer .

spectra:madeAt a owl:ObjectProperty ;
    rdfs:label "made at"@en ;
    rdfs:comment "Meeting where this Resolution was made (1..*, including dual meetings during COVID-19; Phase-2 Spec §6 P2-D09)"@en ;
    rdfs:domain spectra:Resolution ;
    rdfs:range spectra:Meeting .

spectra:meetingNumber a owl:DatatypeProperty ;
    rdfs:label "meeting number"@en ;
    rdfs:comment "Meeting identifier on a Meeting (e.g., RAN1#120) or the meeting locator forming an AgendaItem's composite identity (e.g., 120)."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( spectra:Meeting spectra:AgendaItem ) ] ;
    rdfs:range xsd:string .

spectra:meetingNumberInt a owl:DatatypeProperty ;
    rdfs:label "meeting number integer"@en ;
    rdfs:comment "Numeric part of meeting number for proper sorting (e.g., RAN1#122 → 122, RAN1#122b → 122). Extracted via regex #(\\d+)."@en ;
    rdfs:domain spectra:Meeting ;
    rdfs:range xsd:integer .

spectra:moderatedBy a owl:ObjectProperty ;
    rdfs:label "moderated by"@en ;
    rdfs:comment "Company whose employee moderated this Summary discussion. Joint moderators may represent multiple companies."@en ;
    rdfs:domain spectra:Summary ;
    rdfs:range spectra:Company .

spectra:modifies a owl:ObjectProperty ;
    rdfs:label "modifies"@en ;
    rdfs:comment "Specification(s) that this CR modifies. Cardinality 1..*: a single CR may amend more than one Spec (e.g., paired stage-2 and stage-3 updates)."@en ;
    rdfs:domain spectra:CR ;
    rdfs:range spectra:Spec .

spectra:moreFilePaths a owl:DatatypeProperty ;
    rdfs:label "additional figure file paths"@en ;
    rdfs:comment "Paths to additional extracted parts of the same Figure, using the same path base as filePath. Multi-valued and optional; filePath remains the primary file locator."@en ;
    rdfs:domain spectra:Figure ;
    rdfs:range xsd:string .

spectra:note a owl:DatatypeProperty ;
    rdfs:label "note"@en ;
    rdfs:comment "Additional note attached to the resolution"@en ;
    rdfs:domain spectra:Resolution ;
    rdfs:range xsd:string .

spectra:originalLS a owl:ObjectProperty ;
    rdfs:label "original LS"@en ;
    rdfs:comment "Original LS document from another WG (for LS in). Cardinality 0..*: one incoming LS can carry several original LS documents (Phase-1 Spec Step 6 LS property constraints)."@en ;
    rdfs:domain spectra:LS ;
    rdfs:range spectra:Tdoc .

spectra:originatedFrom a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "originated from"@en ;
    rdfs:comment "Working Group that issued this incoming LS, read from the WG prefix of its Original LS number (the number the LS carries at the issuing group). Cardinality 0..1: an Original LS number has one prefix."@en ;
    rdfs:domain spectra:LS ;
    rdfs:range spectra:WorkingGroup .

spectra:perfReqName a owl:DatatypeProperty ;
    rdfs:label "performance requirement name"@en ;
    rdfs:comment "Canonical identifier for a quantitative performance requirement (e.g., 'TEvaluate_BFD_SSB', 'DLTM cell-switch delay'). Used for item-level PerformanceRequirement instances."@en ;
    rdfs:domain spectra:PerformanceRequirement ;
    rdfs:range xsd:string .

spectra:presentedAt a owl:ObjectProperty ;
    rdfs:label "presented at"@en ;
    rdfs:comment "Meeting where this TDoc was presented/discussed. Cardinality is 0..* in practice: a small fraction of TDocs are re-tabled at consecutive meetings under the same identifier (rare in the released RAN1 KG; 1 case in the current snapshot)."@en ;
    rdfs:domain spectra:Tdoc ;
    rdfs:range spectra:Meeting .

spectra:procedureName a owl:DatatypeProperty ;
    rdfs:label "procedure name"@en ;
    rdfs:comment "Canonical name of a Procedure (e.g., 'BFR Procedure', 'LTM Cell Switch Procedure'). Distinct from the section title that hosts the procedure body."@en ;
    rdfs:domain spectra:Procedure ;
    rdfs:range xsd:string .

spectra:promotedTo a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "promoted to"@en ;
    rdfs:comment "Agreement that this WorkingAssumption was promoted to"@en ;
    rdfs:domain spectra:WorkingAssumption ;
    rdfs:range spectra:Agreement .

spectra:reasonForChange a owl:DatatypeProperty ;
    rdfs:label "reason for change"@en ;
    rdfs:comment "Reason why this CR change is needed (from CR document 'Reason for change' field)"@en ;
    rdfs:domain spectra:CR ;
    rdfs:range xsd:string .

spectra:recommendsChangeToSpec a owl:ObjectProperty ;
    rdfs:label "recommends change to specification"@en ;
    rdfs:comment "An explicit source TR recommendation to change a specification. The supporting EvidenceAssertion records the recommendation and its scope."@en ;
    rdfs:domain spectra:TechnicalReport ;
    rdfs:range spectra:Spec ;
    rdfs:subPropertyOf spectra:discussesSpec .

spectra:referencesSpec a owl:ObjectProperty ;
    rdfs:label "references specification"@en ;
    rdfs:comment "A specification cited by this Section without a resolved target clause. The producer retains the actual hub or release-keyed target. Citation alone expresses no modification or causal impact."@en ;
    rdfs:domain spectra:Section ;
    rdfs:range spectra:Spec .

spectra:relatedFeature a owl:ObjectProperty ;
    rdfs:label "related feature"@en ;
    rdfs:comment "A source-grounded association between Features. The supporting assertion records its exact scope; this relation alone carries no replacement or equivalence inference."@en ;
    rdfs:domain spectra:Feature ;
    rdfs:range spectra:Feature .

spectra:relatedTo a owl:ObjectProperty ;
    rdfs:label "related to"@en ;
    rdfs:comment "Work Item(s) related to this TDoc"@en ;
    rdfs:domain spectra:Tdoc ;
    rdfs:range spectra:WorkItem .

spectra:releaseName a owl:DatatypeProperty ;
    rdfs:label "release name"@en ;
    rdfs:comment "3GPP Release version name (e.g., Rel-18, Rel-19)"@en ;
    rdfs:domain spectra:Release ;
    rdfs:range xsd:string .

spectra:replacedByFeature a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "replaced by feature"@en ;
    rdfs:comment "Optional: marks that this Feature was superseded by another (e.g., old codebook replaced by enhanced version). Functional — at most one successor."@en ;
    rdfs:domain spectra:Feature ;
    rdfs:range spectra:Feature .

spectra:reportedUnderAgenda a owl:ObjectProperty ;
    rdfs:label "reported under agenda"@en ;
    rdfs:comment "AgendaItem under which the actual meeting report records this Tdoc. Multiple source reports can place the same document under different agenda items; each assessed placement retains its report source and locator in an EvidenceAssertion."@en ;
    rdfs:domain spectra:Tdoc ;
    rdfs:range spectra:AgendaItem .

spectra:reservationDate a owl:DatatypeProperty ;
    rdfs:label "reservation date"@en ;
    rdfs:comment "Date/time when the TDoc number was reserved"@en ;
    rdfs:domain spectra:Tdoc ;
    rdfs:range xsd:dateTime .

spectra:resolutionId a owl:DatatypeProperty ;
    rdfs:label "resolution ID"@en ;
    rdfs:comment "Unique identifier for the resolution (e.g., AGR-112-8.1-001)"@en ;
    rdfs:domain spectra:Resolution ;
    rdfs:range xsd:string .

spectra:resolutionScope a owl:DatatypeProperty ;
    rdfs:label "resolution scope"@en ;
    rdfs:comment "The value document_disposition identifies a source meeting-report decision about one document entry. Its complete entry text supplies retrieval context; its Agreement class follows the source-verified disposition."@en ;
    rdfs:domain spectra:Resolution ;
    rdfs:range xsd:string .

spectra:roundNumber a owl:DatatypeProperty ;
    rdfs:label "round number"@en ;
    rdfs:comment "Round number for the summary (0, 1, 2, ...)"@en ;
    rdfs:domain spectra:Summary ;
    rdfs:range xsd:integer .

spectra:scope a owl:DatatypeProperty ;
    rdfs:label "scope"@en ;
    rdfs:comment "Scope/objectives of the TR research (from Scope section, 1-10 sentences)"@en ;
    rdfs:domain spectra:TechnicalReport ;
    rdfs:range xsd:string .

spectra:secretaryRemarks a owl:DatatypeProperty ;
    rdfs:label "secretary remarks"@en ;
    rdfs:comment "Notes from the meeting secretary (e.g., 'Late contribution')"@en ;
    rdfs:domain spectra:Tdoc ;
    rdfs:range xsd:string .

spectra:sectionId a owl:DatatypeProperty ;
    rdfs:label "section ID"@en ;
    rdfs:comment "Section unique identifier. v4.0 (release-aware) pattern: {specNumber}-{release}-{sectionNumber}, e.g., 38.214-Rel-15-5.1.3.2 (pre-v4.0: {specNumber}-{sectionNumber})."@en ;
    rdfs:domain spectra:Section ;
    rdfs:range xsd:string .

spectra:sectionNumber a owl:DatatypeProperty ;
    rdfs:label "section number"@en ;
    rdfs:comment "Section number from heading (e.g., 5.1.3.2, A.1, 8.1.4A), also retained as a source locator on Procedure and ConformanceTest instances. Body: ^[0-9]+(\\.[0-9]+)*[a-zA-Z]?$, Annex: ^[A-Z](\\.[0-9]+)*$"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( spectra:Section spectra:SourceUnit spectra:Procedure spectra:ConformanceTest ) ] ;
    rdfs:range xsd:string .

spectra:sectionTitle a owl:DatatypeProperty ;
    rdfs:label "section title"@en ;
    rdfs:comment "Section title text from heading (excluding sectionNumber)"@en ;
    rdfs:domain spectra:Section ;
    rdfs:range xsd:string .

spectra:sentTo a owl:ObjectProperty ;
    rdfs:label "sent to"@en ;
    rdfs:comment "Working Group(s) that receive this LS"@en ;
    rdfs:domain spectra:LS ;
    rdfs:range spectra:WorkingGroup .

spectra:sequence a owl:DatatypeProperty ;
    rdfs:label "sequence"@en ;
    rdfs:comment "Order within the same Agenda Item (1-based)"@en ;
    rdfs:domain spectra:Resolution ;
    rdfs:range xsd:integer .

spectra:sessionContext a owl:DatatypeProperty ;
    rdfs:label "session context"@en ;
    rdfs:comment "Session information (e.g., 'Friday session', 'Online')"@en ;
    rdfs:domain spectra:Resolution ;
    rdfs:range xsd:string .

spectra:sourceUnitInSection a owl:ObjectProperty ;
    rdfs:label "source unit in section"@en ;
    rdfs:comment "Connects an assessed source unit to the matching title and edition of its source Section."@en ;
    rdfs:domain spectra:SourceUnit ;
    rdfs:range spectra:Section .

spectra:sourceUnitTitle a owl:DatatypeProperty ;
    rdfs:label "source unit title"@en ;
    rdfs:domain spectra:SourceUnit ;
    rdfs:range xsd:string .

spectra:specInRelease a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "spec in release"@en ;
    rdfs:comment "v4.1 (release-aware, hybrid): the 3GPP Release a RELEASE-KEYED Spec node represents. Present only on release-keyed Spec nodes (one (specNumber, release) pair → one Release); ABSTRACT HUB Spec nodes have none. Parallels tdoc:targetRelease (which targets Tdoc/TechnicalReport)."@en ;
    rdfs:domain spectra:Spec ;
    rdfs:range spectra:Release .

spectra:specNumber a owl:DatatypeProperty ;
    rdfs:label "spec number"@en ;
    rdfs:comment "Source specification number (e.g., 38.212), carried by a Spec, a source-located Section or a spec-body entity. This shared identifier records provenance without identifying the resource with its source Spec. For a Section the value is the copy of belongsToSpec/specNumber, the number of its single release-keyed owner."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( spectra:Spec spectra:Section spectra:SourceUnit spectra:RRCParameter spectra:CapabilityItem spectra:Procedure spectra:PerformanceRequirement spectra:ConformanceTest ) ] ;
    rdfs:range xsd:string .

spectra:specRelease a owl:DatatypeProperty ;
    rdfs:label "spec release"@en ;
    rdfs:comment "v4.0 (release-aware): denormalized release string of this Spec node (e.g., 'Rel-15'), mirroring tdoc:specInRelease → Release.releaseName for convenient filtering and as the Qdrant/loader release source."@en ;
    rdfs:domain spectra:Spec ;
    rdfs:range xsd:string .

spectra:specTitle a owl:DatatypeProperty ;
    rdfs:label "spec title"@en ;
    rdfs:comment "Title of the specification (e.g., 'Physical channels and modulation')"@en ;
    rdfs:domain spectra:Spec ;
    rdfs:range xsd:string .

spectra:specVersion a owl:DatatypeProperty ;
    rdfs:label "spec version"@en ;
    rdfs:comment "Exact final version of THIS release for this Spec node (e.g., 15.16.0 = Rel-15 final of 38.214). v4.0: per-release final, not a single latest snapshot."@en ;
    rdfs:domain spectra:Spec ;
    rdfs:range xsd:string .

spectra:status a owl:DatatypeProperty ;
    rdfs:label "status"@en ;
    rdfs:comment "Decision status. Values: approved, agreed, noted, revised, postponed, withdrawn, not treated, available, reserved, merged, not concluded, conditionally agreed, endorsed, not pursued, treated"@en ;
    rdfs:domain spectra:Tdoc ;
    rdfs:range xsd:string .

spectra:studyItemRpNumber a owl:DatatypeProperty ;
    rdfs:label "study item RP number"@en ;
    rdfs:comment "Study Item RP number from TR Scope (pattern: RP-xxxxxx, e.g., RP-213599)"@en ;
    rdfs:domain spectra:TechnicalReport ;
    rdfs:range xsd:string .

spectra:submittedBy a owl:ObjectProperty ;
    rdfs:label "submitted by"@en ;
    rdfs:comment "Company/organization that submitted the TDoc. Multiple companies can co-submit."@en ;
    rdfs:domain spectra:Tdoc ;
    rdfs:range spectra:Company .

spectra:summaryOfChange a owl:DatatypeProperty ;
    rdfs:label "summary of change"@en ;
    rdfs:comment "Summary of the changes made by this CR (from CR document 'Summary of change' field)"@en ;
    rdfs:domain spectra:CR ;
    rdfs:range xsd:string .

spectra:summaryType a owl:DatatypeProperty ;
    rdfs:label "summary type"@en ;
    rdfs:comment "Type of summary: FL (Feature Lead) or Moderator"@en ;
    rdfs:domain spectra:Summary ;
    rdfs:range xsd:string .

spectra:tableCaption a owl:DatatypeProperty ;
    rdfs:label "table caption"@en ;
    rdfs:comment "TS table caption text from TH-style paragraph (e.g., 'Supported CSI-RS resource configurations')"@en ;
    rdfs:domain spectra:TSTable ;
    rdfs:range xsd:string .

spectra:tableId a owl:DatatypeProperty ;
    rdfs:label "table ID"@en ;
    rdfs:comment "Table unique identifier (e.g., TBL-112-001 for Report Table, 38.214-T5.1.3.2-1 for TSTable)"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( spectra:Table spectra:TSTable ) ] ;
    rdfs:range xsd:string .

spectra:tableNumber a owl:DatatypeProperty ;
    rdfs:label "table number"@en ;
    rdfs:comment "Original table number from caption (e.g., Table 7.8-1 for Report, 5.1.3.2-1 for TSTable)"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( spectra:Table spectra:TSTable ) ] ;
    rdfs:range xsd:string .

spectra:targetRelease a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "target release"@en ;
    rdfs:comment "Target 3GPP Release version for this TDoc or TechnicalReport"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( spectra:Tdoc spectra:TechnicalReport ) ] ;
    rdfs:range spectra:Release .

spectra:targetTdocNumber a owl:DatatypeProperty ;
    rdfs:label "target Tdoc number"@en ;
    rdfs:comment "Exact document identifier assessed by a DecisionDisposition, retained also when the source references a document awaiting ingestion."@en ;
    rdfs:domain spectra:DecisionDisposition ;
    rdfs:range xsd:string .

spectra:tdocNumber a owl:DatatypeProperty ;
    rdfs:label "TDoc number"@en ;
    rdfs:comment "Unique identifier for the TDoc (e.g., R1-2500001). Format: R1-YYNNNNN"@en ;
    rdfs:domain spectra:Tdoc ;
    rdfs:range xsd:string .

spectra:testCaseId a owl:DatatypeProperty ;
    rdfs:label "conformance test case ID"@en ;
    rdfs:comment "Test-case identifier for a ConformanceTest instance (e.g., '38.521-4 §6.3.2.2.6'). Used for item-level ConformanceTest instances."@en ;
    rdfs:domain spectra:ConformanceTest ;
    rdfs:range xsd:string .

spectra:title a owl:DatatypeProperty ;
    rdfs:label "title"@en ;
    rdfs:comment "Title of the TDoc"@en ;
    rdfs:domain spectra:Tdoc ;
    rdfs:range xsd:string .

spectra:trImpactId a owl:DatatypeProperty ;
    rdfs:label "TR impact ID"@en ;
    rdfs:comment "Unique identifier for TRImpact (e.g., 38.769-38.291, 38.885-38.211-S8)"@en ;
    rdfs:domain spectra:TRImpact ;
    rdfs:range xsd:string .

spectra:trNumber a owl:DatatypeProperty ;
    rdfs:label "TR number"@en ;
    rdfs:comment "Technical Report number (e.g., 38.769, 38.901)"@en ;
    rdfs:domain spectra:TechnicalReport ;
    rdfs:range xsd:string .

spectra:trStatus a owl:DatatypeProperty ;
    rdfs:label "TR status"@en ;
    rdfs:comment "Status of the TR. Values: Draft (v0.x.x), Completed (vX.0.0), Living (vX.Y.Z continuous updates)"@en ;
    rdfs:domain spectra:TechnicalReport ;
    rdfs:range xsd:string .

spectra:trTitle a owl:DatatypeProperty ;
    rdfs:label "TR title"@en ;
    rdfs:comment "Full title of the Technical Report (e.g., 'Study on Ambient IoT')"@en ;
    rdfs:domain spectra:TechnicalReport ;
    rdfs:range xsd:string .

spectra:trVersion a owl:DatatypeProperty ;
    rdfs:label "TR version"@en ;
    rdfs:comment "Version of the TR (e.g., 2.0.0, 18.0.0)"@en ;
    rdfs:domain spectra:TechnicalReport ;
    rdfs:range xsd:string .

spectra:tsgCRPack a owl:DatatypeProperty ;
    rdfs:label "TSG CR pack"@en ;
    rdfs:comment "TSG CR Pack number (e.g., RP-250233) for approved CRs"@en ;
    rdfs:domain spectra:CR ;
    rdfs:range xsd:string .

spectra:tsgMeeting a owl:DatatypeProperty ;
    rdfs:label "TSG meeting"@en ;
    rdfs:comment "TSG plenary meeting where this CR Pack was submitted (e.g., RAN#103)"@en ;
    rdfs:domain spectra:CRPack ;
    rdfs:range xsd:string .

spectra:type a owl:DatatypeProperty ;
    rdfs:label "type"@en ;
    rdfs:comment "Type of the TDoc. Values: discussion, CR, draftCR, pCR, LS out, LS in, other, report, agenda, Work Plan, draft TR, draft TS, response, WID new, SID new, WI summary"@en ;
    rdfs:domain spectra:Tdoc ;
    rdfs:range xsd:string .

spectra:uploadedDate a owl:DatatypeProperty ;
    rdfs:label "uploaded date"@en ;
    rdfs:comment "Date/time when the TDoc file was uploaded"@en ;
    rdfs:domain spectra:Tdoc ;
    rdfs:range xsd:dateTime .

spectra:usesIE a owl:ObjectProperty ;
    rdfs:label "uses IE"@en ;
    rdfs:comment "Feature uses an RRC/interface IE (RRCParameter). Specialisation of tdoc:hasComponent for IE-typed components."@en ;
    rdfs:domain spectra:Feature ;
    rdfs:range spectra:RRCParameter ;
    rdfs:subPropertyOf spectra:hasComponent .

spectra:verifiedImpactScope a owl:DatatypeProperty ;
    rdfs:label "verified impact scope"@en ;
    rdfs:comment "The source-supported operation of a verified TRImpact: new_specification, new_section, existing_section_change, published_definition_reuse, published_analysis_reuse or explicit_no_change. Existing-section change requires an explicit modification/addition to a specification clause; published reuse identifies a current dependency and does not establish when a section was created or changed. This assessed scope is separate from the retained proposed impactType."@en ;
    rdfs:domain spectra:TRImpact ;
    rdfs:range xsd:string .

spectra:wg a owl:DatatypeProperty ;
    rdfs:label "candidate source working group"@en ;
    rdfs:comment "Working-group partition of the TS retrieval collection from which this Spec candidate was obtained. Preserves the candidate producer's source locator."@en ;
    rdfs:domain spectra:Spec ;
    rdfs:range xsd:string .

spectra:wgName a owl:DatatypeProperty ;
    rdfs:label "WG name"@en ;
    rdfs:comment "Working Group name (e.g., RAN1, SA2)"@en ;
    rdfs:domain spectra:WorkingGroup ;
    rdfs:range xsd:string .

spectra:workItemCode a owl:DatatypeProperty ;
    rdfs:label "work item code"@en ;
    rdfs:comment "Work Item code name (e.g., NR_MIMO_Ph5-Core)"@en ;
    rdfs:domain spectra:WorkItem ;
    rdfs:range xsd:string .

spectra:workItemRpNumber a owl:DatatypeProperty ;
    rdfs:label "work item RP number"@en ;
    rdfs:comment "Work Item RP number from TR Scope (pattern: RP-xxxxxx, e.g., RP-213599)"@en ;
    rdfs:domain spectra:TechnicalReport ;
    rdfs:range xsd:string .

spectra:workingGroup a owl:DatatypeProperty ;
    rdfs:label "working group"@en ;
    rdfs:comment "Working Group hosting the meeting (e.g., RAN1)"@en ;
    rdfs:domain spectra:Meeting ;
    rdfs:range xsd:string .

<https://github.com/spectra-ontology> a foaf:Organization ;
    foaf:homepage <https://github.com/spectra-ontology/spec-trace> ;
    foaf:name "SPECTRA Ontology Project"@en .

<https://orcid.org/0000-0002-3471-1498> a foaf:Person ;
    foaf:name "Sihyeon Choi" .

spectra:Agreement a owl:Class ;
    rdfs:label "Agreement"@en ;
    rdfs:comment "Technical agreement reached in the meeting"@en ;
    rdfs:subClassOf spectra:Resolution .

spectra:Conclusion a owl:Class ;
    rdfs:label "Conclusion"@en ;
    rdfs:comment "Discussion conclusion (may or may not have consensus)"@en ;
    rdfs:subClassOf spectra:Resolution .

spectra:SessionNotes a owl:Class ;
    rdfs:label "Session Notes"@en ;
    rdfs:comment "Session notes for ad-hoc discussions from Final Report"@en ;
    rdfs:subClassOf spectra:Tdoc .

spectra:WorkingAssumption a owl:Class ;
    rdfs:label "Working Assumption"@en ;
    rdfs:comment "Tentative assumption that may be promoted to Agreement"@en ;
    rdfs:subClassOf spectra:Resolution .

spectra:belongsToCRPack a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "belongs to CR pack"@en ;
    rdfs:comment "CRPack that this CR belongs to (at most one)"@en ;
    rdfs:domain spectra:CR ;
    rdfs:range spectra:CRPack ;
    owl:inverseOf spectra:hasCR .

spectra:belongsToSpec a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "belongs to spec"@en ;
    rdfs:comment "Spec that this Section belongs to (exactly one)"@en ;
    rdfs:domain spectra:Section ;
    rdfs:range spectra:Spec .

spectra:containsFigure a owl:ObjectProperty ;
    rdfs:label "contains figure"@en ;
    rdfs:comment "TSFigure(s) contained in this Section"@en ;
    rdfs:domain spectra:Section ;
    rdfs:range spectra:TSFigure ;
    owl:inverseOf spectra:figureInSection .

spectra:containsTable a owl:ObjectProperty ;
    rdfs:label "contains table"@en ;
    rdfs:comment "TSTable(s) contained in this Section"@en ;
    rdfs:domain spectra:Section ;
    rdfs:range spectra:TSTable ;
    owl:inverseOf spectra:tableInSection .

spectra:definedByIE a owl:ObjectProperty ;
    rdfs:label "defined by IE"@en ;
    rdfs:comment "The ASN.1 IE whose definition encodes this capability field, grounded in the capability definition and the ASN.1 field declaration or enclosing carrier definition. For example, codebookParametersAddition-r16 is encoded by CodebookParametersAddition-r16. A capability that enables use of a configuration IE is a distinct relation."@en ;
    rdfs:domain spectra:CapabilityItem ;
    rdfs:range spectra:RRCParameter ;
    owl:inverseOf spectra:mapsToCapabilityItem .

spectra:definedInSection a owl:ObjectProperty ;
    rdfs:label "defined in section"@en ;
    rdfs:comment "Entity (RRCParameter/CapabilityItem/Procedure/PerformanceRequirement/ConformanceTest) is defined inside a Section of a Spec. Many-to-many: a single Section may define multiple entities (e.g., 38.306 §4.2.7.2 defines 28+ LTM CapabilityItems); a single entity may span multiple Sections (e.g., one Procedure can span §5.17 + §5.18.x)."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( spectra:RRCParameter spectra:CapabilityItem spectra:Procedure spectra:PerformanceRequirement spectra:ConformanceTest ) ] ;
    rdfs:range spectra:Section ;
    owl:inverseOf spectra:hasEntity .

spectra:discussesSpec a owl:ObjectProperty ;
    rdfs:label "discusses specification"@en ;
    rdfs:comment "A specification explicitly discussed within the source TR's study scope. The supporting EvidenceAssertion identifies the exact source and scope."@en ;
    rdfs:domain spectra:TechnicalReport ;
    rdfs:range spectra:Spec .

spectra:dispositionOf a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "disposition of"@en ;
    rdfs:comment "The decision whose text gives this target-specific disposition."@en ;
    rdfs:domain spectra:DecisionDisposition ;
    rdfs:range spectra:Resolution ;
    owl:inverseOf spectra:hasDisposition .

spectra:figureInSection a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "figure in section"@en ;
    rdfs:comment "Section that contains this TSFigure (exactly one)"@en ;
    rdfs:domain spectra:TSFigure ;
    rdfs:range spectra:Section ;
    owl:inverseOf spectra:containsFigure .

spectra:hasCR a owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has CR"@en ;
    rdfs:comment "CR(s) included in this CRPack"@en ;
    rdfs:domain spectra:CRPack ;
    rdfs:range spectra:CR ;
    owl:inverseOf spectra:belongsToCRPack .

spectra:hasDisposition a owl:ObjectProperty ;
    rdfs:label "has disposition"@en ;
    rdfs:comment "A target-specific disposition recorded in this decision."@en ;
    rdfs:domain spectra:Resolution ;
    rdfs:range spectra:DecisionDisposition ;
    owl:inverseOf spectra:dispositionOf .

spectra:hasEntity a owl:ObjectProperty ;
    rdfs:label "has entity"@en ;
    rdfs:comment "Inverse of tdoc:definedInSection — Section hosts one or more entities (IE / Capability / Procedure / PerfReq / ConformanceTest)."@en ;
    rdfs:domain spectra:Section ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( spectra:RRCParameter spectra:CapabilityItem spectra:Procedure spectra:PerformanceRequirement spectra:ConformanceTest ) ] ;
    owl:inverseOf spectra:definedInSection .

spectra:hasRelatedTR a owl:ObjectProperty ;
    rdfs:label "has related TR"@en ;
    rdfs:comment "TR(s) related to this Work Item (inverse of relatedToWorkItem)"@en ;
    rdfs:domain spectra:WorkItem ;
    rdfs:range spectra:TechnicalReport ;
    owl:inverseOf spectra:relatedToWorkItem .

spectra:hasResolutions a owl:ObjectProperty ;
    rdfs:label "has resolutions"@en ;
    rdfs:comment "Resolutions made under this AgendaItem"@en ;
    rdfs:domain spectra:AgendaItem ;
    rdfs:range spectra:Resolution ;
    owl:inverseOf spectra:resolutionBelongsTo .

spectra:hasSubSection a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "has sub-section"@en ;
    rdfs:comment "Direct child Section(s) of this Section"@en ;
    rdfs:domain spectra:Section ;
    rdfs:range spectra:Section ;
    owl:inverseOf spectra:parentSection .

spectra:hasTRImpact a owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has TR impact"@en ;
    rdfs:comment "Assessed impact claims owned by this TR, including pending claims. Source-verified causal targets are expressed separately through impactsSpec/impactsSection."@en ;
    rdfs:domain spectra:TechnicalReport ;
    rdfs:range spectra:TRImpact ;
    owl:inverseOf spectra:impactOfTR .

spectra:impactOfTR a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "impact of TR"@en ;
    rdfs:comment "TR that this TRImpact belongs to"@en ;
    rdfs:domain spectra:TRImpact ;
    rdfs:range spectra:TechnicalReport ;
    owl:inverseOf spectra:hasTRImpact .

spectra:impactsSection a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "impacts section"@en ;
    rdfs:comment "Source-verified released Section target of an assessed TR change or dependency. verifiedImpactScope distinguishes a new section, an existing-section change and published reuse. Pending targets use candidateImpactsSection."@en ;
    rdfs:domain spectra:TRImpact ;
    rdfs:range spectra:Section ;
    owl:inverseOf spectra:sectionImpactedBy .

spectra:impactsSpec a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "impacts spec"@en ;
    rdfs:comment "Source-verified TS (Spec) target of an assessed TR change or published definition/analysis dependency. verifiedImpactScope distinguishes the supported operation; impactDescription and evidence delimit its exact claim. Pending targets use candidateImpactsSpec."@en ;
    rdfs:domain spectra:TRImpact ;
    rdfs:range spectra:Spec ;
    owl:inverseOf spectra:specImpactedBy .

spectra:inReleaseOf a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "in release of"@en ;
    rdfs:comment "v4.1 (release-aware, hybrid): links a RELEASE-KEYED Spec node (specNumber, release) to its ABSTRACT HUB Spec node (specNumber only). Functional: each release-keyed Spec belongs to exactly one hub. Lets release-blind references resolve to the hub while Sections attach to the release-keyed parent; release-blind aggregation CQs traverse hub ← inReleaseOf ← release-keyed → Section. Neo4j relation type IN_RELEASE_OF."@en ;
    rdfs:domain spectra:Spec ;
    rdfs:range spectra:Spec .

spectra:isRevisionOf a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "is revision of"@en ;
    rdfs:comment "Previous version TDoc that this TDoc revises"@en ;
    rdfs:domain spectra:Tdoc ;
    rdfs:range spectra:Tdoc ;
    owl:inverseOf spectra:revisedTo .

spectra:mapsToCapabilityItem a owl:ObjectProperty ;
    rdfs:label "maps to capability item"@en ;
    rdfs:comment "Inverse of definedByIE — from RRCParameter to its UE-capability-side handle. Many-to-many: an IE may have multiple capability items across releases."@en ;
    rdfs:domain spectra:RRCParameter ;
    rdfs:range spectra:CapabilityItem ;
    owl:inverseOf spectra:definedByIE .

spectra:modifiedByCR a owl:ObjectProperty ;
    rdfs:label "modified by CR"@en ;
    rdfs:comment "CR(s) that modify this Section"@en ;
    rdfs:domain spectra:Section ;
    rdfs:range spectra:CR ;
    owl:inverseOf spectra:modifiesSection .

spectra:modifiesSection a owl:ObjectProperty ;
    rdfs:label "modifies section"@en ;
    rdfs:comment "Section(s) modified by this CR (derived from clausesAffected field)"@en ;
    rdfs:domain spectra:CR ;
    rdfs:range spectra:Section ;
    owl:inverseOf spectra:modifiedByCR .

spectra:parentSection a owl:AsymmetricProperty,
        owl:FunctionalProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "parent section"@en ;
    rdfs:comment "Direct parent Section (exactly one, null for level-1)"@en ;
    rdfs:domain spectra:Section ;
    rdfs:range spectra:Section ;
    owl:inverseOf spectra:hasSubSection .

spectra:partOfFeature a owl:ObjectProperty ;
    rdfs:label "part of feature"@en ;
    rdfs:comment "A Section or spec-body entity belongs to a Feature. Many-to-many: a single IE can span multiple features (e.g., CodebookConfig spans both Type-I and Type-II)."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( spectra:Section spectra:RRCParameter spectra:CapabilityItem spectra:Procedure spectra:PerformanceRequirement spectra:ConformanceTest ) ] ;
    rdfs:range spectra:Feature ;
    owl:inverseOf spectra:hasComponent .

spectra:referencedBySection a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "referenced by section"@en ;
    rdfs:comment "Section(s) that reference this Section"@en ;
    rdfs:domain spectra:Section ;
    rdfs:range spectra:Section ;
    owl:inverseOf spectra:referencesSection .

spectra:referencedByTR a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "referenced by TR"@en ;
    rdfs:comment "TR(s) that reference this TR"@en ;
    rdfs:domain spectra:TechnicalReport ;
    rdfs:range spectra:TechnicalReport ;
    owl:inverseOf spectra:referencesTR .

spectra:references a owl:ObjectProperty ;
    rdfs:label "references"@en ;
    rdfs:comment "TDoc(s) referenced in this Resolution content"@en ;
    rdfs:domain spectra:Resolution ;
    rdfs:range spectra:Tdoc .

spectra:referencesSection a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "references section"@en ;
    rdfs:comment "Section(s) referenced by this Section's content (clause/subclause patterns)"@en ;
    rdfs:domain spectra:Section ;
    rdfs:range spectra:Section ;
    owl:inverseOf spectra:referencedBySection .

spectra:referencesTR a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "references TR"@en ;
    rdfs:comment "Other TR(s) referenced by this TR (from References section)"@en ;
    rdfs:domain spectra:TechnicalReport ;
    rdfs:range spectra:TechnicalReport ;
    owl:inverseOf spectra:referencedByTR .

spectra:relatedToWorkItem a owl:ObjectProperty ;
    rdfs:label "related to work item"@en ;
    rdfs:comment "Work Item (SI/WI) related to this TR, identified by RP-xxxxxx in TR Scope"@en ;
    rdfs:domain spectra:TechnicalReport ;
    rdfs:range spectra:WorkItem ;
    owl:inverseOf spectra:hasRelatedTR .

spectra:replyIn a owl:ObjectProperty ;
    rdfs:label "reply in"@en ;
    rdfs:comment "TDoc that replies to this TDoc (multiple WG replies supported; Phase-1 Spec §10 P1-D09)"@en ;
    rdfs:domain spectra:Tdoc ;
    rdfs:range spectra:Tdoc ;
    owl:inverseOf spectra:replyTo .

spectra:replyTo a owl:ObjectProperty ;
    rdfs:label "reply to"@en ;
    rdfs:comment "TDoc that this TDoc replies to (typically for LS responses). Cardinality 0..*: one reply can answer several TDocs (Phase-1 Spec Step 6 Tdoc property constraints)."@en ;
    rdfs:domain spectra:Tdoc ;
    rdfs:range spectra:Tdoc ;
    owl:inverseOf spectra:replyIn .

spectra:resolutionBelongsTo a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "resolution belongs to"@en ;
    rdfs:comment "Agenda Item under which this Resolution was made"@en ;
    rdfs:domain spectra:Resolution ;
    rdfs:range spectra:AgendaItem ;
    owl:inverseOf spectra:hasResolutions .

spectra:revisedTo a owl:ObjectProperty ;
    rdfs:label "revised to"@en ;
    rdfs:comment "Newer version TDoc that revises this TDoc. Cardinality 0..*: a TDoc can be revised into more than one TDoc (branching revisions; Phase-1 Spec Step 6 Tdoc property constraints)."@en ;
    rdfs:domain spectra:Tdoc ;
    rdfs:range spectra:Tdoc ;
    owl:inverseOf spectra:isRevisionOf .

spectra:sectionImpactedBy a owl:ObjectProperty ;
    rdfs:label "section impacted by"@en ;
    rdfs:comment "TRImpact(s) that affect this Section"@en ;
    rdfs:domain spectra:Section ;
    rdfs:range spectra:TRImpact ;
    owl:inverseOf spectra:impactsSection .

spectra:specImpactedBy a owl:ObjectProperty ;
    rdfs:label "spec impacted by"@en ;
    rdfs:comment "TRImpact(s) that affect this Spec"@en ;
    rdfs:domain spectra:Spec ;
    rdfs:range spectra:TRImpact ;
    owl:inverseOf spectra:impactsSpec .

spectra:tableInSection a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "table in section"@en ;
    rdfs:comment "Section that contains this TSTable (exactly one)"@en ;
    rdfs:domain spectra:TSTable ;
    rdfs:range spectra:Section ;
    owl:inverseOf spectra:containsTable .

spectra:Contact a owl:Class ;
    rdfs:label "Contact"@en ;
    rdfs:comment "Contact person responsible for a TDoc"@en ;
    rdfs:subClassOf prov:Agent,
        prov:Person,
        foaf:Person .

spectra:Summary a owl:Class ;
    rdfs:label "Summary"@en ;
    rdfs:comment "FL Summary or Moderator Summary document from Final Report"@en ;
    rdfs:subClassOf spectra:Tdoc .

spectra:CRPack a owl:Class ;
    rdfs:label "CR Pack"@en ;
    rdfs:comment "TSG CR Pack - a bundle of CRs submitted to TSG plenary meeting (e.g., RP-250233). Identified by Cover Sheet."@en .

spectra:Release a owl:Class ;
    rdfs:label "Release"@en ;
    rdfs:comment "3GPP Release version (e.g., Rel-18, Rel-19)"@en .

spectra:WorkItem a owl:Class ;
    rdfs:label "Work Item"@en ;
    rdfs:comment "3GPP Work Item (WI) or Study Item (SI)"@en .

spectra:WorkingGroup a owl:Class ;
    rdfs:label "Working Group"@en ;
    rdfs:comment "3GPP Working Group (e.g., RAN1, RAN2, SA2)"@en .

spectra:Company a owl:Class ;
    rdfs:label "Company"@en ;
    rdfs:comment "Company or organization that submits TDocs"@en ;
    rdfs:subClassOf prov:Agent,
        prov:Organization,
        foaf:Organization .

spectra:EvidenceFragment a owl:Class ;
    rdfs:label "Evidence fragment"@en ;
    rdfs:comment "A precisely located quotation from a source file identified by its content hash. Several fragments can jointly support a cross-document claim."@en ;
    rdfs:subClassOf prov:Entity .

spectra:LS a owl:Class ;
    rdfs:label "Liaison Statement"@en ;
    rdfs:comment "Liaison Statement for official communication between Working Groups or external organizations"@en ;
    rdfs:subClassOf spectra:Tdoc .

spectra:SourceUnit a owl:Class ;
    rdfs:label "Specification source unit"@en ;
    rdfs:comment "A source-located message definition, ASN.1 module, procedure collection, timing specification, reference unit or specification-writing principle retained after source-unit assessment. Its source title and release-specific Section preserve the original document scope."@en ;
    rdfs:subClassOf prov:Entity ;
    owl:disjointWith spectra:Procedure .

spectra:TSFigure a owl:Class ;
    rdfs:label "TS Figure"@en ;
    rdfs:comment "A figure within a 3GPP Technical Specification document, identified by figure caption"@en .

spectra:TSTable a owl:Class ;
    rdfs:label "TS Table"@en ;
    rdfs:comment "A table within a 3GPP Technical Specification document, identified by TH-style caption"@en .

spectra:DecisionDisposition a owl:Class ;
    rdfs:label "Decision disposition"@en ;
    rdfs:comment "The disposition of one target document within one meeting decision, with the exact decision text as evidence. Approval, withdrawal, partial agreement, revision and citation are distinct meanings. The record is an entity describing a decision activity."@en ;
    rdfs:subClassOf spectra:EvidenceAssertion .

spectra:hasComponent a owl:ObjectProperty ;
    rdfs:label "has component"@en ;
    rdfs:comment "Feature consists of Sections or spec-body entities: RRCParameter, CapabilityItem, Procedure, PerformanceRequirement and ConformanceTest."@en ;
    rdfs:domain spectra:Feature ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( spectra:Section spectra:RRCParameter spectra:CapabilityItem spectra:Procedure spectra:PerformanceRequirement spectra:ConformanceTest ) ] ;
    owl:inverseOf spectra:partOfFeature .

spectra:AgendaItem a owl:Class ;
    rdfs:label "Agenda Item"@en ;
    rdfs:comment "Meeting agenda item with hierarchical numbering (e.g., 9.1, 9.1.1)"@en .

spectra:Figure a owl:Class ;
    rdfs:label "Figure"@en ;
    rdfs:comment "Technical figure embedded in Final Report (captioned or structural >50KB)"@en .

spectra:Meeting a owl:Class ;
    rdfs:label "Meeting"@en ;
    rdfs:comment "3GPP Working Group meeting"@en .

spectra:Table a owl:Class ;
    rdfs:label "Table"@en ;
    rdfs:comment "Technical table embedded in Final Report (captioned or structural heuristic)"@en .

spectra:Chart a owl:Class ;
    rdfs:label "Chart"@en ;
    rdfs:comment "Chart embedded in Final Report (<c:chart> XML, no <a:blip> image)"@en .

spectra:PerformanceRequirement a owl:Class ;
    rdfs:label "RRM/RF Performance Requirement"@en ;
    rdfs:comment "Quantitative performance requirements specs body (38.133 RRM perf req, 38.101-x RF/EMC requirements, 38.104 BS RF requirements). Includes evaluation periods (TEvaluate_*), scaling factors (FR1/FR2/FR2-1/FR2-2), scheduling availability windows, minimum requirements per RS type, timing budgets (e.g., T = T1 × Ceil((T2+D)/T1)). v3.0: independent class. Linked to Section via tdoc:definedInSection. Distinct from CapabilityItem (UE capability declarations) and Procedure (protocol procedures)."@en .

spectra:ConformanceTest a owl:Class ;
    rdfs:label "Conformance Test Specification"@en ;
    rdfs:comment "3GPP conformance test specifications body — by spec body nature (test procedure / test environment / verdict / applicability), regardless of working group. Examples: RAN5 UE test (38.508-x, 38.509, 38.521-x, 38.523-1, 38.533), RAN4 BS test (38.141-1 conducted, 38.141-2 radiated, 38.181 AAS BS). v3.0: independent class. Linked to Section via tdoc:definedInSection. Distinct from Procedure (protocol procedure in spec body, not conformance test)."@en .

spectra:CapabilityItem a owl:Class ;
    rdfs:label "UE Capability Item"@en ;
    rdfs:comment "Individual UE capability row in 3GPP capability spec (e.g., 38.306 §4.2.7.2 BandNR `codebookParametersAddition-r16`, `ltm-MCG-IntraFreq-r18`). v3.0: independent class. Linked to Section via tdoc:definedInSection. Linked to RRCParameter via tdoc:definedByIE for naming-layer bridge."@en .

spectra:Procedure a owl:Class ;
    rdfs:label "Procedure"@en ;
    rdfs:comment "A protocol procedure spanning one or more sections (e.g., 'BFR Procedure' in 38.321 §5.17, 'RACH Procedure' in 38.321 §5.1). v3.0: independent class. Linked to Section via tdoc:definedInSection (multiple if procedure spans sections). In PROV-O terms it is a prov:Plan: the specified description of a procedure, not an execution of it."@en ;
    rdfs:subClassOf prov:Plan .

spectra:RRCParameter a owl:Class ;
    rdfs:label "ASN.1 IE (RRC + interface IE)"@en ;
    rdfs:comment "3GPP ASN.1 IE body — covers RRC IE (38.331 CodebookConfig-r16, etc.), NGAP IE (38.413), XnAP IE (38.423), F1AP IE (38.473), E1AP IE (38.463). The class name 'RRCParameter' is kept for v2.0 backward compatibility, but the class semantically represents any 3GPP-spec ASN.1 IE. v3.0: independent class (no longer rdfs:subClassOf Section). Linked to Section via tdoc:definedInSection. Instances carry tdoc:granularity ∈ {item, section} to distinguish individual IE entries from section-level legacy labels."@en .

spectra:TRImpact a owl:Class ;
    rdfs:label "TR Impact"@en ;
    rdfs:comment "An assessed TR-to-specification impact claim. impactType retains the proposed kind (NewTS, NewSection, ExtendSection, NoChange, TopicalCandidate); evidenceStatus and source spans record its assessment. Verified causal targets use impactsSpec/impactsSection; proposed targets use candidateImpactsSpec/candidateImpactsSection."@en ;
    rdfs:subClassOf spectra:EvidenceAssertion .

spectra:EvidenceAssertion a owl:Class ;
    rdfs:label "Evidence assertion"@en ;
    rdfs:comment "A recorded claim with an explicit source assessment. Its existence records the claim; only the assessed source_verified status authorizes a verified domain relation. Status describes the documented assessment method, rather than an assertion of expert consensus."@en ;
    rdfs:subClassOf prov:Entity .

spectra:Feature a owl:Class ;
    rdfs:label "3GPP Standard Feature"@en ;
    rdfs:comment "A named 3GPP standardization feature spanning one or more IEs/Sections/Capabilities/Releases (e.g., 'Rel-16 Enhanced Type-II codebook', 'Rel-18 LTM', 'BFD/BFR'). Independent class with instances drawn from the shared 22-entry candidate catalog in ontology/config/feature_catalog.yaml and cross-checked against source sections. Curation and verification status are recorded in the catalog metadata."@en ;
    rdfs:subClassOf prov:Entity .

spectra:TechnicalReport a owl:Class ;
    rdfs:label "Technical Report"@en ;
    rdfs:comment "3GPP Technical Report (TR) - research/study documents that may lead to TS changes. Contains scope, conclusions, and TR-TS impact analysis."@en .

spectra:CR a owl:Class ;
    rdfs:label "Change Request"@en ;
    rdfs:comment "Change Request document that modifies a 3GPP specification (TS/TR). Includes CR, draftCR, and pCR types."@en ;
    rdfs:subClassOf spectra:Tdoc .

spectra:Resolution a owl:Class ;
    rdfs:label "Resolution"@en ;
    rdfs:comment "Abstract base class for meeting resolutions (Agreement, Conclusion, WorkingAssumption)"@en ;
    rdfs:subClassOf prov:Activity .

spectra:Spec a owl:Class ;
    rdfs:label "Specification"@en ;
    rdfs:comment "A 3GPP Technical Specification (TS) or Technical Report (TR). v4.1 (release-aware, hybrid) — a Spec exists in two roles. (1) ABSTRACT HUB: one node per specNumber (IRI tdoc:spec/{specNumber_}, e.g. tdoc:spec/38_211), no tdoc:specRelease; the stable target of release-blind document references — Tdoc/CR MODIFIES & AFFECTS_CORE_SPEC, TRImpact IMPACTS_SPEC/SPEC_IMPACTED_BY (a CR modifies 'the spec', not a single release). (2) RELEASE-KEYED: one node per (specNumber, release) (IRI tdoc:spec/{specNumber_}/{release}, e.g. tdoc:spec/38_211/Rel-15), carries tdoc:specInRelease + tdoc:specRelease + that release's specVersion; the parent of release-specific Sections (BELONGS_TO_SPEC/HAS_SECTION); linked to its hub via tdoc:inReleaseOf. This hybrid preserves release-blind reference edges intact (no re-keying) while giving each release's Sections a release-keyed parent. Pre-v4.0 had a single specNumber node (latest snapshot); v4.0 had only release-keyed nodes (broke hub references) — v4.1 restores the hub additively."@en .

spectra:Section a owl:Class ;
    rdfs:label "Section"@en ;
    rdfs:comment "A section within a 3GPP Technical Specification document, identified by heading style"@en .

spectra:Tdoc a owl:Class ;
    rdfs:label "TDoc"@en ;
    rdfs:comment "3GPP Technical Document - base class for all meeting documents"@en ;
    rdfs:subClassOf prov:Entity .

