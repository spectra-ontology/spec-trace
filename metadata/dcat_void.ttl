resource:sqlite a dcat:Dataset ;
    dcterms:description "Five working-group query databases for the released record projection, with one database per working group."@en ;
    dcterms:hasPart <https://raw.githubusercontent.com/spectra-ontology/spec-trace/vldb-2027/metadata/dcat_void.ttl#dataset/sqlite/RAN1.sqlite>,
        <https://raw.githubusercontent.com/spectra-ontology/spec-trace/vldb-2027/metadata/dcat_void.ttl#dataset/sqlite/RAN2.sqlite.gz>,
        <https://raw.githubusercontent.com/spectra-ontology/spec-trace/vldb-2027/metadata/dcat_void.ttl#dataset/sqlite/RAN3.sqlite.gz>,
        <https://raw.githubusercontent.com/spectra-ontology/spec-trace/vldb-2027/metadata/dcat_void.ttl#dataset/sqlite/RAN4.sqlite.gz>,
        <https://raw.githubusercontent.com/spectra-ontology/spec-trace/vldb-2027/metadata/dcat_void.ttl#dataset/sqlite/RAN5.sqlite.gz> ;
    dcterms:isPartOf resource:package ;
    dcterms:rights resource:scopedPackageRights ;
    dcterms:source <https://www.3gpp.org/ftp/> ;
    dcterms:title "SPECTRA released SQLite query projection"@en .

resource:package a dcat:Dataset ;
    dcterms:creator <https://orcid.org/0000-0002-3471-1498> ;
    dcterms:description "The vldb-2027 repository branch provides source-bound standardization records, a traceability vocabulary and SHACL shapes, chain-question benchmarks, stored experimental responses and scores, and executable build, source-restoration and replay tools. This description catalogs the ontology, record and SQLite resource files as components of the package."@en ;
    dcterms:hasPart <https://raw.githubusercontent.com/spectra-ontology/spec-trace/vldb-2027/metadata/dcat_void.ttl#dataset/docs/spectra-shapes.ttl>,
        <https://raw.githubusercontent.com/spectra-ontology/spec-trace/vldb-2027/metadata/dcat_void.ttl#dataset/docs/spectra.ttl>,
        <https://raw.githubusercontent.com/spectra-ontology/spec-trace/vldb-2027/metadata/dcat_void.ttl#dataset/ontology/tdoc-ontology-shapes.ttl>,
        <https://raw.githubusercontent.com/spectra-ontology/spec-trace/vldb-2027/metadata/dcat_void.ttl#dataset/ontology/tdoc-ontology.ttl>,
        resource:records,
        resource:sqlite ;
    dcterms:identifier "spectra-ontology/spec-trace:vldb-2027" ;
    dcterms:publisher <https://github.com/spectra-ontology> ;
    dcterms:rights resource:scopedPackageRights ;
    dcterms:title "SPECTRA: An Ontology and Benchmark for 3GPP Traceability — reproducibility package"@en ;
    dcat:keyword "3GPP"@en,
        "JSON-LD"@en,
        "SQLite"@en,
        "benchmark"@en,
        "ontology"@en,
        "standardization"@en,
        "traceability"@en ;
    dcat:landingPage <https://github.com/spectra-ontology/spec-trace/tree/vldb-2027> ;
    foaf:page <https://github.com/spectra-ontology/spec-trace/blob/vldb-2027/CITATION.cff>,
        <https://github.com/spectra-ontology/spec-trace/blob/vldb-2027/README.md>,
        <https://github.com/spectra-ontology/spec-trace/blob/vldb-2027/REPRODUCING.md>,
        <https://github.com/spectra-ontology/spec-trace/blob/vldb-2027/sources/released_record_counts.json> .

