# SPARQL translation of CQ5-1 — Phase 5
# "Technical Reports that have impacted a given Technical Specification"
#
# Predicate name per the released ontology/data: spectra:impactOfTr.
# Constant verified against the released RAN1-body.ttl: TS 38.211 has 11
# TRImpact individuals. trTitle is OPTIONAL (not every TR carries it).

PREFIX spectra: <https://w3id.org/spectra#>

SELECT ?trNumber ?trTitle
WHERE {
  ?spec a spectra:Spec ;
        spectra:specNumber "38.211" .
  ?impact a spectra:TRImpact ;
          spectra:impactsSpec ?spec ;
          spectra:impactOfTr ?tr .
  ?tr a spectra:TechnicalReport ;
      spectra:trNumber ?trNumber .
  OPTIONAL { ?tr spectra:trTitle ?trTitle . }
}
ORDER BY ?trNumber
