# SPARQL translation of CQ4-1 — Phase 4
# "Reason for change, summary, and affected section for a given CR"
#
# Constant verified against the released RAN1-body.ttl: R1-2601591 carries the
# three cover-sheet text fields and a clause-level modifiesSection edge.
# title is OPTIONAL: cover-sheet-derived CR individuals do not all carry it.

PREFIX spectra: <https://w3id.org/spectra#>

SELECT ?reasonForChange ?summaryOfChange ?consequencesIfNotApproved ?sectionNumber ?title
WHERE {
  ?cr a spectra:CR ;
      spectra:tdocNumber "R1-2601591" ;
      spectra:reasonForChange ?reasonForChange ;
      spectra:summaryOfChange ?summaryOfChange ;
      spectra:consequencesIfNotApproved ?consequencesIfNotApproved ;
      spectra:modifiesSection ?sec .
  ?sec spectra:sectionNumber ?sectionNumber .
  OPTIONAL { ?cr spectra:title ?title . }
}
