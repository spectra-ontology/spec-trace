# Multi-hop traceability: for the current text of TS 38.214 §5.1.5, which
# change requests modified it (and why), and which technical reports shaped
# the parent specification?
# Walks two traceability layers from one section:
#   CR layer:  Section <- modifiesSection <- CR (-> reasonForChange)
#   TR layer:  Section -> belongsToSpec -> Spec <- impactsSpec <- TRImpact -> impactOfTr -> TR
#
# Coverage note: in the released RAN1 KG, meeting placement is carried by Tdoc
# and Resolution individuals rather than by CR individuals (see CQ1-1 and
# CQ2-1 for those hops), so this example chains the CR and TR layers that are
# materialized end-to-end. All constants verified against the released
# RAN1-body.ttl.

PREFIX spectra: <https://w3id.org/spectra#>

SELECT DISTINCT ?crNumber ?reasonForChange ?trNumber
WHERE {
  ?sec a spectra:Section ;
       spectra:sectionId "38.214-5.1.5" ;
       spectra:belongsToSpec ?spec .
  ?cr a spectra:CR ;
      spectra:modifiesSection ?sec ;
      spectra:tdocNumber ?crNumber .
  OPTIONAL { ?cr spectra:reasonForChange ?reasonForChange . }
  ?impact a spectra:TRImpact ;
          spectra:impactsSpec ?spec ;
          spectra:impactOfTr ?tr .
  ?tr spectra:trNumber ?trNumber .
}
ORDER BY ?crNumber ?trNumber
