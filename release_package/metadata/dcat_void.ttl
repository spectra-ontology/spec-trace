    void:classPartition
        [ void:class spectra:Tdoc ; void:entities 120000 ] ,
        [ void:class spectra:CR ;   void:entities 34622 ] ,
        [ void:class spectra:LS ;   void:entities 9400 ] ;
    void:dataDump <https://doi.org/10.5281/zenodo.20034872> ;
    dcat:byteSize "195235898"^^xsd:nonNegativeInteger .

sd:ran3-body
    a void:Dataset ;
