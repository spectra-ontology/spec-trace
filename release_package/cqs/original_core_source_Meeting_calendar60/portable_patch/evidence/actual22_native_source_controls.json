  "fresh_independent_full_SQL": "SELECT cr.tdocNumber AS tdocNumber,MAX(meeting.sourceReportedEndDate) AS meetingPeriodEndDate\n       FROM CR cr JOIN rel_PRESENTED_AT at ON at.src_id=cr.node_id\n       JOIN Meeting meeting ON meeting.node_id=at.dst_id\n       WHERE cr.node_id IN(SELECT edge.src_id FROM edge JOIN Spec target ON target.node_id=edge.dst_id\n          WHERE edge.rel_type='MODIFIES' AND target.specNumber='38.213')\n       GROUP BY cr.node_id,cr.tdocNumber ORDER BY meetingPeriodEndDate DESC,tdocNumber ASC",
  "full_pool_CR_n": 3041,
  "all60_property_SQL": "SELECT i.iri AS iri,m.id AS id,m.meetingNumber AS meetingNumber,\n       m.canonicalMeetingNumber AS canonicalMeetingNumber,m.meetingNumberInt AS meetingNumberInt,\n       m.workingGroup AS workingGroup,m.sourceReportedStartDate AS sourceReportedStartDate,\n       m.sourceReportedEndDate AS sourceReportedEndDate FROM node_identity i\n       JOIN Meeting m ON m.node_id=i.node_id ORDER BY meetingNumber",
  "all60_source_properties_native_SQL_exact": true,
  "full_pool_native_all_two_fields_SQL_exact": true,
