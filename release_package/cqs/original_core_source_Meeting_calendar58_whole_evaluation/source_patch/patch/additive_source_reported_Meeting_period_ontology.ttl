@prefix spectra: <https://w3id.org/spectra#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
spectra:sourceReportedStartDate a owl:DatatypeProperty ; rdfs:domain spectra:Meeting ; rdfs:range xsd:string ; rdfs:comment "Literal calendar start of the own report meeting period; not submission, upload or approval time." .
spectra:sourceReportedEndDate a owl:DatatypeProperty ; rdfs:domain spectra:Meeting ; rdfs:range xsd:string ; rdfs:comment "Literal calendar end of the own report meeting period; not submission, upload or approval time." .
