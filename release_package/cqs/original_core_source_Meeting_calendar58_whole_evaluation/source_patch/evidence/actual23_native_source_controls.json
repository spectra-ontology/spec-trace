  "independent_SQL": "SELECT cr.tdocNumber AS tdocNumber, MAX(m.sourceReportedEndDate) AS meetingPeriodEndDate\n      FROM CR cr JOIN rel_PRESENTED_AT p ON p.src_id=cr.node_id\n      JOIN Meeting m ON m.node_id=p.dst_id\n      WHERE cr.node_id IN (SELECT e.src_id FROM rel_MODIFIES e\n         JOIN Spec s ON s.node_id=e.dst_id WHERE s.specNumber='38.133')\n      GROUP BY cr.node_id,cr.tdocNumber ORDER BY meetingPeriodEndDate DESC,tdocNumber ASC",
  "all58_property_SQL": "SELECT i.iri AS iri,m.id AS id,m.meetingNumber AS meetingNumber,\n      m.canonicalMeetingNumber AS canonicalMeetingNumber,m.meetingNumberInt AS meetingNumberInt,\n      m.workingGroup AS workingGroup,m.sourceReportedStartDate AS sourceReportedStartDate,\n      m.sourceReportedEndDate AS sourceReportedEndDate FROM Meeting m\n      JOIN node_identity i USING(node_id) ORDER BY meetingNumber",
