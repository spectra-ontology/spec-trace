{
  "SQL": "WITH numerator AS(SELECT hub.node_id,hub.specNumber,COUNT(cr.node_id)crCnt FROM Spec hub JOIN rel_MODIFIES m ON m.dst_id=hub.node_id JOIN CR cr ON cr.node_id=m.src_id WHERE hub.specRelease IS NULL GROUP BY hub.node_id), editions AS(SELECT n.node_id hub_id,r.node_id,r.specNumber,r.specRelease,r.specVersion,CAST(REPLACE(r.specRelease,'Rel-','')AS INTEGER)rel FROM numerator n JOIN rel_IN_RELEASE_OF i ON i.dst_id=n.node_id JOIN Spec r ON r.node_id=i.src_id), latest AS(SELECT * FROM editions e WHERE e.rel=(SELECT MAX(e2.rel) FROM editions e2 WHERE e2.hub_id=e.hub_id)), denominator AS(SELECT l.*,COUNT(s.node_id)secCnt FROM latest l JOIN rel_BELONGS_TO_SPEC b ON b.dst_id=l.node_id JOIN Section s ON s.node_id=b.src_id GROUP BY l.hub_id,l.node_id) SELECT n.specNumber,n.crCnt,d.secCnt,ROUND(n.crCnt*1.0/d.secCnt,2)density,d.node_id edition_node_id,d.specRelease,d.specVersion FROM numerator n JOIN denominator d ON d.hub_id=n.node_id ORDER BY density DESC,n.specNumber",
