  "query": "WITH specs AS (\n SELECT n.node_id,json_extract(n.properties_json,'$.specNumber')specNumber,\n json_extract(n.properties_json,'$.specRelease')specRelease,\n json_extract(n.properties_json,'$.specVersion')specVersion\n FROM _node_record n WHERE EXISTS(SELECT 1 FROM json_each(n.labels_json)WHERE value='Spec')),\n numer AS (\n SELECT h.node_id AS hub_id,h.specNumber,count(*) AS crCnt\n FROM specs h JOIN edge m ON m.dst_id=h.node_id AND m.rel_type='MODIFIES'\n JOIN _node_record cr ON cr.node_id=m.src_id\n WHERE h.specRelease IS NULL AND EXISTS(SELECT 1 FROM json_each(cr.labels_json)WHERE value='CR')\n GROUP BY h.node_id),\n editions AS (\n SELECT n.hub_id,s.*,CAST(REPLACE(s.specRelease,'Rel-','') AS INTEGER) AS release_number\n FROM numer n JOIN edge i ON i.dst_id=n.hub_id AND i.rel_type='IN_RELEASE_OF'\n JOIN specs s ON s.node_id=i.src_id),\n latest AS (\n SELECT e.* FROM editions e WHERE e.release_number=(SELECT max(x.release_number)FROM editions x WHERE x.hub_id=e.hub_id)),\n denom AS (\n SELECT l.*,count(*)secCnt FROM latest l JOIN edge b ON b.dst_id=l.node_id AND b.rel_type='BELONGS_TO_SPEC'\n JOIN _node_record sec ON sec.node_id=b.src_id\n WHERE EXISTS(SELECT 1 FROM json_each(sec.labels_json)WHERE value='Section')\n GROUP BY l.hub_id,l.node_id)\n SELECT n.specNumber,n.crCnt,d.secCnt,ROUND(1.0*n.crCnt/d.secCnt,2)density,\n d.node_id AS edition_node_id,d.specRelease,d.specVersion\n FROM numer n JOIN denom d ON d.hub_id=n.hub_id\n ORDER BY density DESC,n.specNumber",
