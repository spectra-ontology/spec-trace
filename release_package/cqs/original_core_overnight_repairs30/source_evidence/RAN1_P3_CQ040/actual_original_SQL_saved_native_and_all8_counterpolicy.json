  },
  "query_only": true,
  "SQL": "WITH crs AS (\nSELECT s.specNumber AS ts,count(c.node_id) AS crCnt,count(DISTINCT c.node_id) AS distinctCR\nFROM CR c JOIN edge m ON m.src_id=c.node_id AND m.rel_type='MODIFIES'\nJOIN Spec s ON s.node_id=m.dst_id GROUP BY s.specNumber\n), agreements AS (\nSELECT s.specNumber AS ts,count(DISTINCT a.node_id) AS agrCnt\nFROM Agreement a JOIN edge r ON r.src_id=a.node_id AND r.rel_type='REFERENCES'\nJOIN CR c ON c.node_id=r.dst_id\nJOIN edge m ON m.src_id=c.node_id AND m.rel_type='MODIFIES'\nJOIN Spec s ON s.node_id=m.dst_id GROUP BY s.specNumber\n)\nSELECT crs.ts,crs.crCnt,COALESCE(agreements.agrCnt,0) AS agrCnt,crs.distinctCR\nFROM crs LEFT JOIN agreements ON agreements.ts=crs.ts ORDER BY crs.crCnt DESC,crs.ts ASC\n",
