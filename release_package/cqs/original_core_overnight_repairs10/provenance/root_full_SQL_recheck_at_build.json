      "status": "PASS",
      "sql": "WITH samsung_documents AS (\n SELECT DISTINCT t.node_id\n FROM Company c JOIN rel_SUBMITTED_BY s ON s.dst_id=c.node_id\n JOIN Tdoc t ON t.node_id=s.src_id\n WHERE c.companyName='Samsung'\n), cited_documents AS (\n SELECT DISTINCT ref.dst_id AS node_id\n FROM Resolution resolution JOIN rel_REFERENCES ref ON ref.src_id=resolution.node_id\n JOIN Tdoc t ON t.node_id=ref.dst_id\n)\nSELECT json_object('numerator',count(cited.node_id),'denominator',count(samsung.node_id))\n AS resolutionLinkedTdocShare\nFROM samsung_documents samsung\nLEFT JOIN cited_documents cited ON cited.node_id=samsung.node_id",
