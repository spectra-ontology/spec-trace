      "status": "PASS",
      "sql": "SELECT DISTINCT r.resolutionId AS resolutionId,m.meetingNumberInt AS meetingNumberInt,a.agendaNumber AS agendaNumber,r.sequence AS sequence\nFROM Resolution r\nJOIN rel_MADE_AT occurred ON occurred.src_id=r.node_id\nJOIN Meeting m ON m.node_id=occurred.dst_id\nLEFT JOIN rel_RESOLUTION_BELONGS_TO belongs ON belongs.src_id=r.node_id\nLEFT JOIN AgendaItem a ON a.node_id=belongs.dst_id\nWHERE EXISTS (\n SELECT 1 FROM rel_REFERENCES cited\n JOIN Tdoc t ON t.node_id=cited.dst_id\n JOIN rel_MODIFIES changes ON changes.src_id=t.node_id\n JOIN Spec sp ON sp.node_id=changes.dst_id\n WHERE cited.src_id=r.node_id AND sp.specNumber='38.331'\n)\nORDER BY meetingNumberInt DESC,agendaNumber ASC,sequence ASC,resolutionId ASC\n",
