# SPARQL translation of P4_CQ1-1 — Return the reason-for-change of CR R1-2504971 (which affects 5 specs for the LP-WUS/WUR adoption).
# Source: ../cypher/RAN1_P4_CQ1-1.cypher

PREFIX spectra: <https://w3id.org/spectra#>

SELECT ?tdocNumber ?reasonForChange
WHERE {
  FILTER EXISTS { ?cr a spectra:CR }
  ?cr
      spectra:tdocNumber ?tdocNumber ;
      spectra:reasonForChange ?reasonForChange .
  FILTER(?tdocNumber = "R1-2504971")
}
