# SPARQL translation of P4_CQ2-2 — For CRs that modify TS 38.214, which other specs do they declare as affected (cross-spec impact)?
# Source: ../cypher/RAN1_P4_CQ2-2.cypher
# Realization note: spec-level modifies and affects*Spec edges sit on the Tdoc
# IRI of the paired CR/Tdoc twins and are emitted only for CRs, so the CR class
# restriction is implied; the Spec type assertions keep both anchors pinned to
# spec hubs.
# Engine note: the pattern starts from the affects*Spec edges (the most
# selective predicate) and uses plain type triples instead of per-row
# FILTER EXISTS, which rdflib evaluates with a fresh sub-query per row and
# times out on this join size.
PREFIX spectra: <https://w3id.org/spectra#>

SELECT ?modifiedSpec ?affectedSpec (COUNT(DISTINCT ?cr) AS ?crCount)
WHERE {
  VALUES ?rel { spectra:affectsCoreSpec spectra:affectsTestSpec spectra:affectsOmSpec }
  ?cr ?rel ?otherSpec .
  ?cr spectra:modifies ?mainSpec .
  ?mainSpec spectra:specNumber "38.214" ;
            a spectra:Spec .
  ?otherSpec a spectra:Spec .
  FILTER(?mainSpec != ?otherSpec)
  BIND("38.214" AS ?modifiedSpec)
  OPTIONAL { ?otherSpec spectra:specNumber ?affectedSpec }
}
GROUP BY ?modifiedSpec ?affectedSpec
ORDER BY DESC(?crCount)
