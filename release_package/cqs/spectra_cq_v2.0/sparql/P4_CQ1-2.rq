# SPARQL translation of P4_CQ1-2 — Return the summary-of-change of CR R1-2506685 (Rel-19 UL Tx switching 3Tx UE scenario).
# Source: ../cypher/RAN1_P4_CQ1-2.cypher

PREFIX spectra: <https://w3id.org/spectra#>

SELECT ?tdocNumber ?summaryOfChange
WHERE {
  FILTER EXISTS { ?cr a spectra:CR }
  ?cr
      spectra:tdocNumber ?tdocNumber ;
      spectra:summaryOfChange ?summaryOfChange .
  FILTER(?tdocNumber = "R1-2506685")
}
