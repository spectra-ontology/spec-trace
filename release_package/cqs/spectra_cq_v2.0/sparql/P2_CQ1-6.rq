# SPARQL translation of P2_CQ1-6 — Return Agreements related to PDCCH blind decoding (PDCCH technical-decision tracing).
# Source: ../cypher/RAN1_P2_CQ1-6.cypher
# Note: Agreement literals and Resolution edges live on paired IRIs sharing resolutionId (1:1 in the released TTL).
PREFIX spectra: <https://w3id.org/spectra#>

SELECT ?resolutionId ?meetingNumber ?content
WHERE {
  FILTER EXISTS { ?a a spectra:Agreement }
  ?a
     spectra:resolutionId ?resolutionId ;
     spectra:content ?content .
  FILTER EXISTS { ?r a spectra:Resolution }
  ?r
     spectra:resolutionId ?resolutionId ;
     spectra:madeAt ?m .
  FILTER EXISTS { ?m a spectra:Meeting }
  FILTER (CONTAINS(?content, 'PDCCH') && CONTAINS(?content, 'blind'))
  OPTIONAL { ?m spectra:meetingNumber ?meetingNumber . }
  OPTIONAL { ?m spectra:meetingNumberInt ?meetingNumberInt . }
}
ORDER BY DESC(?meetingNumberInt)
LIMIT 10
