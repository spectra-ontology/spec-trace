# SPARQL translation of P3_P3-S8-CQ02 — Are all item-level entity nodes linked to a Section via :definedInSection? (grounding-coverage check)
# Source: ../cypher/RAN1_P3_P3-S8-CQ02.cypher
# Realization note: the property-graph relationship definedInSection is
# serialized as spectra:_definedInSection in the released TTL (the loader
# strips the underscore prefix when restoring relationships).

PREFIX spectra: <https://w3id.org/spectra#>

SELECT ?class (COUNT(?n) AS ?total)
       (SUM(IF(BOUND(?sec), 1, 0)) AS ?linked)
       (ROUND(1000 * SUM(IF(BOUND(?sec), 1, 0)) / COUNT(?n)) / 10 AS ?link_pct)
WHERE {
  VALUES (?cls ?class) {
    (spectra:RRCParameter "RRCParameter")
    (spectra:CapabilityItem "CapabilityItem")
    (spectra:Procedure "Procedure")
    (spectra:PerformanceRequirement "PerformanceRequirement")
    (spectra:ConformanceTest "ConformanceTest")
  }
  ?n a ?cls ;
     spectra:granularity "item" .
  OPTIONAL {
    ?n spectra:_definedInSection ?sec .
    FILTER EXISTS { ?sec a spectra:Section }
  }
}
GROUP BY ?class
