# SPARQL translation of P5_CQ1-3 — List TRs currently in Draft status to forecast upcoming standard impact.
# Source: ../cypher/RAN1_P5_CQ1-3.cypher

PREFIX spectra: <https://w3id.org/spectra#>

SELECT ?trNumber ?trTitle ?scope
WHERE {
  FILTER EXISTS { ?tr a spectra:TechnicalReport }
  ?tr
      spectra:trStatus "Draft" .
  OPTIONAL { ?tr spectra:trNumber ?trNumber }
  OPTIONAL { ?tr spectra:trTitle ?trTitle }
  OPTIONAL { ?tr spectra:scope ?scope }
}
ORDER BY ?trNumber
