# SPARQL translation of P3_CQ040 — Per-TS CR counts with the count of Agreements referencing those CRs.
# Source: ../cypher/P3_CQ040.cypher
# Realization note: in the released RDF, spec-level modifies edges, meeting
# placement (presentedAt), authorship (submittedBy) and work-item links
# (relatedTo) sit on the Tdoc IRI of a multi-role TDoc; spec-level modifies
# edges are carried only by CR-role TDocs (measured: 10,671 = CR count in
# RAN1-body.ttl). Agreement/Resolution pairs share one spectra:resolutionId
# across two IRIs.
PREFIX spectra: <https://w3id.org/spectra#>

SELECT ?ts ?crCnt ?agrCnt
WHERE {
  {
    SELECT ?ts (COUNT(?t) AS ?crCnt)
    WHERE {
      ?t spectra:modifies ?sp .
      ?sp spectra:specNumber ?ts .
      FILTER(?ts IN ("38.211", "38.212", "38.213", "38.214", "38.215"))
    }
    GROUP BY ?ts
  }
  OPTIONAL {
    SELECT ?ts (COUNT(DISTINCT ?res) AS ?agrCnt)
    WHERE {
      ?t2 spectra:modifies ?sp2 .
      ?sp2 spectra:specNumber ?ts .
      FILTER(?ts IN ("38.211", "38.212", "38.213", "38.214", "38.215"))
      ?res spectra:references ?t2 ;
           spectra:resolutionId ?resolutionId .
      ?agr spectra:resolutionId ?resolutionId .
      FILTER EXISTS { ?agr a spectra:Agreement }
    }
    GROUP BY ?ts
  }
}
ORDER BY DESC(?crCnt)
