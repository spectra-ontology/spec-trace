# SPARQL translation of P5_CQ2-4 — Which TR study did TS 38.211 Section 8 (Sidelink) originate from?
# Source: ../cypher/RAN1_P5_CQ2-4.cypher

PREFIX spectra: <https://w3id.org/spectra#>

SELECT ?trNumber ?trTitle ?impactType ?impactDescription
WHERE {
  ?s a spectra:Section ;
     spectra:sectionId "38.211-Rel-19-8" .
  ?ti a spectra:TRImpact ;
      spectra:impactsSection ?s .
  ?tr a spectra:TechnicalReport ;
      spectra:hasTrImpact ?ti .
  OPTIONAL { ?tr spectra:trNumber ?trNumber }
  OPTIONAL { ?tr spectra:trTitle ?trTitle }
  OPTIONAL { ?ti spectra:impactType ?impactType }
  OPTIONAL { ?ti spectra:impactDescription ?impactDescription }
}
