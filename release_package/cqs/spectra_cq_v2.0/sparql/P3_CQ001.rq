# SPARQL translation of P3_CQ001 — Return the top-level table of contents of TS 38.214 (locating DL-scheduling content).
# Source: ../cypher/RAN1_P3_CQ001.cypher

PREFIX spectra: <https://w3id.org/spectra#>

SELECT ?sectionNumber ?sectionTitle
WHERE {
  FILTER EXISTS { ?sp a spectra:Spec }
  ?sp
      spectra:specNumber "38.214" ;
      spectra:hasSection ?sec .
  FILTER EXISTS { ?sec a spectra:Section }
  OPTIONAL { ?sec spectra:sectionNumber ?sectionNumber }
  OPTIONAL { ?sec spectra:sectionTitle ?sectionTitle }
}
ORDER BY ?sectionNumber
