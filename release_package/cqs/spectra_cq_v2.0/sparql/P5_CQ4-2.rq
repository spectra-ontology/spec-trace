# SPARQL translation of P5_CQ4-2 — Return the trStatus and scope of TR 38.760-1 (6G Radio) — next-generation roadmap review.
# Source: ../cypher/RAN1_P5_CQ4-2.cypher

PREFIX spectra: <https://w3id.org/spectra#>

SELECT ?trNumber ?trTitle ?trStatus ?trVersion ?scope
WHERE {
  FILTER EXISTS { ?tr a spectra:TechnicalReport }
  ?tr
      spectra:trNumber ?trNumber .
  FILTER(?trNumber = "38.760-1")
  OPTIONAL { ?tr spectra:trTitle ?trTitle }
  OPTIONAL { ?tr spectra:trStatus ?trStatus }
  OPTIONAL { ?tr spectra:trVersion ?trVersion }
  OPTIONAL { ?tr spectra:scope ?scope }
}
