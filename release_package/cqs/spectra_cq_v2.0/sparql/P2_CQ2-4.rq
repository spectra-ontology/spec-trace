# SPARQL translation of P2_CQ2-4 — Return the top-10 agenda items by Resolution count (hotspot-topic identification).
# Source: ../cypher/RAN1_P2_CQ2-4.cypher
PREFIX spectra: <https://w3id.org/spectra#>

SELECT ?agendaNumber (COUNT(?r) AS ?resolutionCount)
WHERE {
  FILTER EXISTS { ?r a spectra:Resolution }
  ?r
     spectra:resolutionBelongsTo ?ai .
  FILTER EXISTS { ?ai a spectra:AgendaItem }
  OPTIONAL { ?ai spectra:agendaNumber ?agendaNumber . }
}
GROUP BY ?agendaNumber
ORDER BY DESC(?resolutionCount)
LIMIT 10
