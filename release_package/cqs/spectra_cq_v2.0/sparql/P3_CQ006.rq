# SPARQL translation of P3_CQ006 — List all tables defined in TS 38.214 (parameter-table reference for implementation).
# Source: ../cypher/RAN1_P3_CQ006.cypher

PREFIX spectra: <https://w3id.org/spectra#>

SELECT ?tableNumber ?tableCaption ?sectionNumber
WHERE {
  FILTER EXISTS { ?tbl a spectra:TSTable }
  ?tbl
       spectra:tableInSection ?sec .
  FILTER EXISTS { ?sec a spectra:Section }
  ?sec
       spectra:belongsToSpec ?sp .
  FILTER EXISTS { ?sp a spectra:Spec }
  ?sp
      spectra:specNumber "38.214" .
  OPTIONAL { ?tbl spectra:tableNumber ?tableNumber }
  OPTIONAL { ?tbl spectra:tableCaption ?tableCaption }
  OPTIONAL { ?sec spectra:sectionNumber ?sectionNumber }
}
ORDER BY ?tableNumber
