# SPARQL translation of P3_CQ036 — Top-5 TSes by CR count, with their section counts.
# Source: ../cypher/P3_CQ036.cypher
# Realization note: in the released RDF, spec-level modifies edges, meeting
# placement (presentedAt), authorship (submittedBy) and work-item links
# (relatedTo) sit on the Tdoc IRI of a multi-role TDoc; spec-level modifies
# edges are carried only by CR-role TDocs (measured: 10,671 = CR count in
# RAN1-body.ttl). Agreement/Resolution pairs share one spectra:resolutionId
# across two IRIs.
PREFIX spectra: <https://w3id.org/spectra#>

SELECT ?ts ?crCount (COUNT(?sec) AS ?sectionCount)
WHERE {
  {
    SELECT ?ts (COUNT(?t) AS ?crCount)
    WHERE {
      ?t spectra:modifies ?sp .
      ?sp spectra:specNumber ?ts .
      FILTER(?ts IN ("38.201", "38.202", "38.211", "38.212", "38.213", "38.214", "38.215", "38.291"))
    }
    GROUP BY ?ts
    ORDER BY DESC(?crCount)
    LIMIT 5
  }
  ?sec spectra:belongsToSpec ?sp2 .
  ?sp2 spectra:specNumber ?ts .
}
GROUP BY ?ts ?crCount
ORDER BY DESC(?crCount)
