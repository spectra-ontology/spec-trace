# SPARQL translation of P3_CQ030 — List CSI-related tables (parameter tables for CSI reporting).
# Source: ../cypher/RAN1_P3_CQ030.cypher

PREFIX spectra: <https://w3id.org/spectra#>

SELECT ?specNumber ?tableNumber ?tableCaption ?sectionNumber
WHERE {
  FILTER EXISTS { ?tbl a spectra:TSTable }
  ?tbl
       spectra:tableCaption ?tableCaption ;
       spectra:tableInSection ?sec .
  FILTER EXISTS { ?sec a spectra:Section }
  ?sec
       spectra:belongsToSpec ?sp .
  FILTER EXISTS { ?sp a spectra:Spec }
  FILTER(REGEX(?tableCaption, "CSI", "i"))
  OPTIONAL { ?sp spectra:specNumber ?specNumber }
  OPTIONAL { ?tbl spectra:tableNumber ?tableNumber }
  OPTIONAL { ?sec spectra:sectionNumber ?sectionNumber }
}
ORDER BY ?specNumber ?tableNumber
LIMIT 20
