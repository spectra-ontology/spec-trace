  "@type": "sc:Dataset",
  "name": "SpectraCQ",
  "description": "SpectraCQ v2.0 — a 624-question scored competency-benchmark dataset (654 authored; 30 held out) for the SPECTRA ontology covering the 3GPP RAN standardization process. Each competency question (CQ) is paired with executable Cypher and a deterministic gold answer set obtained by executing the Cypher against the released per-WG knowledge graphs (no LLM and no human annotation in the gold path). CQs span five development phases (P1 TDoc metadata, P2 meeting resolutions, P3 TS section structure, P4 CR documents, P5 TR impact). Released as a standalone, separately citable sub-resource of SPECTRA.",
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "version": "2.0.0",
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "url": "https://github.com/spectra-ontology/spec-trace/tree/main/release_package/cqs/spectra_cq_v2.0",
  "citeAs": "@misc{spectra-cq-v2, title={SpectraCQ v2.0: Competency Questions for the SPECTRA 3GPP RAN Ontology}, author={Choi, Sihyeon}, year={2026}, note={Companion sub-resource of SPECTRA; accompanying paper under review.}}",
  "creator": [
    {
      "@type": "sc:Person",
      "name": "Sihyeon Choi",
      "affiliation": {
        "@type": "sc:Organization",
        "name": "System LSI Business, Device Solutions Division, Samsung Electronics"
      }
    }
  ],
  "keywords": [
    "Competency questions",
    "Ontology engineering",
    "OWL",
    "3GPP",
    "Standardization process",
    "Document traceability",
    "Knowledge graph",
    "Benchmark dataset"
  ],
  "datePublished": "2026-07-23",
  "isLiveDataset": false,
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "questions.json",
      "name": "questions.json",
      "description": "All 624 scored competency questions with executable Cypher references and deterministic gold answer sets.",
      "contentUrl": "questions.json",
      "encodingFormat": "application/json",
      "sha256": "5722f52ccd568b48bc85d75c3907047108f14414677d3919ee1fb560a3dd483c"
    },
    {
      "@type": "cr:FileSet",
      "@id": "cypher-files",
      "name": "cypher-files",
      "description": "624 executable Cypher query files (one per CQ).",
      "encodingFormat": "application/x-cypher-query",
      "includes": "cypher/*.cypher"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "cqs",
      "name": "cqs",
      "description": "Each record is a competency question (CQ) with id, working group, phase, category, English text, schema area exercised, executable Cypher reference, and a deterministic gold answer set (obtained by executing the Cypher against the released per-WG knowledge graphs).",
      "key": {
        "@id": "cqs/id"
      },
      "field": [
        {
          "@type": "cr:Field",
          "@id": "cqs/id",
          "name": "id",
          "description": "Unique CQ identifier (e.g., P1_CQ2-2).",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "questions.json"
            },
            "extract": {
              "jsonPath": "$.cqs[*].id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "cqs/wg",
          "name": "wg",
          "description": "RAN working group the CQ targets (RAN1..RAN5).",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "questions.json"
            },
            "extract": {
              "jsonPath": "$.cqs[*].wg"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "cqs/phase",
          "name": "phase",
          "description": "Development phase the CQ was elicited in (P1..P5).",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "questions.json"
            },
            "extract": {
              "jsonPath": "$.cqs[*].phase"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "cqs/category",
          "name": "category",
          "description": "Short category label (e.g., CQ1_TdocBasicSearch, CR_TS_ChangeTracing); empty string for uncategorized CQs.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "questions.json"
            },
            "extract": {
              "jsonPath": "$.cqs[*].category"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "cqs/question_en",
          "name": "question_en",
          "description": "Natural-language competency question (English).",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "questions.json"
            },
            "extract": {
              "jsonPath": "$.cqs[*].question_en"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "cqs/schema_area",
          "name": "schema_area",
          "description": "SPECTRA schema region the CQ exercises.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "questions.json"
            },
            "extract": {
              "jsonPath": "$.cqs[*].schema_area"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "cqs/cypher_file",
          "name": "cypher_file",
          "description": "Path to the executable Cypher file under cypher/.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "questions.json"
            },
            "extract": {
              "jsonPath": "$.cqs[*].cypher_file"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "cqs/gold_status",
          "name": "gold_status",
          "description": "Execution status of the reference Cypher when the deterministic gold set was produced (PASS = non-empty result; no human judgment and no language model in the gold path).",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "questions.json"
            },
            "extract": {
              "jsonPath": "$.cqs[*].gold.status"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "cqs/gold_file",
          "name": "gold_file",
          "description": "Path to the per-WG gold answer file (under gold/) holding the full canonicalized gold answer set for this CQ.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "questions.json"
            },
            "extract": {
              "jsonPath": "$.cqs[*].gold_file"
            }
          }
        }
      ]
    }
  ]
}