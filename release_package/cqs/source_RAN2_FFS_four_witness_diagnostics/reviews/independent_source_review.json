          "physical_path": "document/body[1]/p[1568]",
          "text": "For the capability/component is counted across CCs, wait for RAN1 for the conclusion.",
          "XML_sha256": "6f917be8a9fa12a8ebbb94c3667fbb49c82ab6e7b1bad6cc934661ee2ef2c415",
          "all_text_active": true,
          "runs": [
            {
              "text": "For the capability/component is counted across CCs, wait for RAN1 for the conclusion.",
              "active": true,
