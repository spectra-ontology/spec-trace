        },
        {
          "paragraph_index": 1580,
          "coordinate": "body/b1572",
          "physical_path": "document/body[1]/p[1569]",
          "text": "When per BC capability is indicated but some subset of the bands in the BC doesn’t indicate per band capability, the capability/component is not supported in the band without per band capability, the capability/component is supported only in the band with per band capability signalled. This applies to both capability/component that is counted/not counted across CCs.",
          "XML_sha256": "edbdb997cdc16fd72a75e77ba46147cc40bba8e64e48427ed44f9347fa2f4898",
          "all_text_active": true,
          "runs": [
            {
              "text": "When per BC capability is indicated but some subset of the bands in the BC doesn’t indicate per band capability, the capability/component is not supported in the band without per band capability, the capability/component is supported only in the band with per band capability signalled. This applies to both capability/component that is counted/not counted across CCs.",
              "active": true,
              "effective": {
                "strike": false,
                "dstrike": false,
                "vanish": false,
                "webHidden": false
              },
              "style_chain": [
                "Normal",
                "Doc-text2"
