        {
          "paragraph_index": 1583,
          "coordinate": "body/b1575",
          "physical_path": "document/body[1]/p[1572]",
          "text": "A UE supporting feature A per band shall also indicate support of feature B at the given band;",
          "XML_sha256": "556695fae220968a8e77b40532267d9e046431ad6533e2c7265a8bc8baf308c5",
          "all_text_active": true,
          "runs": [
            {
              "text": "A UE supporting feature A per band shall also indicate support of feature B at the given band;",
