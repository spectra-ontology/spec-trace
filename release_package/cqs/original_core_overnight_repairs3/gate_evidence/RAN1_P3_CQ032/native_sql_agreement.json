  "source_sql": "WITH selected AS (\n SELECT s.node_id, s.sectionId FROM Section s\n WHERE (lower(s.sectionTitle) LIKE '%pdcch%') AND EXISTS (\n  SELECT 1 FROM Spec sp JOIN edge b ON b.dst_id=sp.node_id\n  WHERE b.src_id=s.node_id AND b.rel_type='BELONGS_TO_SPEC'))\nSELECT sectionId, (SELECT json_group_array(tableId) FROM (\n SELECT DISTINCT t.tableId FROM TSTable t\n WHERE t.tableId IS NOT NULL AND EXISTS (\n  SELECT 1 FROM edge r JOIN selected own ON own.node_id=r.src_id\n  WHERE r.dst_id=t.node_id AND r.rel_type='CONTAINS_TABLE'\n    AND own.sectionId=domain.sectionId)\n ORDER BY t.tableId)) AS tableIds\nFROM (SELECT DISTINCT sectionId FROM selected) domain ORDER BY sectionId\n",
