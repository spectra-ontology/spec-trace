MATCH (r:Resolution)-[:REFERENCES]->(cr:CR)-[:MODIFIES]->(sp:Spec {specNumber: '38.423'}) WHERE r.content =~ ('(?ims).*^' + cr.tdocNumber + '[ \\t]+\\S[^\\r\\n]*\\r?\\n(?:(?!R3-[0-9]{6}[ \\t]+\\S)[^\\r\\n]*\\r?\\n)*?[ \\t]*(?:Decision:[ \\t]*)?The[ \\t]+document[ \\t]+was[ \\t]+(?:agreed(?:[ \\t]+in[ \\t]+principle)?|endorsed|approved|conditionally[ \\t]+agreed)(?=[ \\t.,!(;]|$)[^\\r\\n]*(?:\\r?\\n.*)?') RETURN r.resolutionId, cr.tdocNumber ORDER BY r.resolutionId DESC LIMIT 10