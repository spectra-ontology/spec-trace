  "original_sql": "SELECT cr.node_id,s.specNumber\n    FROM CR cr JOIN rel_TARGET_RELEASE tr ON tr.src_id=cr.node_id\n    JOIN Release r ON r.node_id=tr.dst_id\n    JOIN rel_MODIFIES m ON m.src_id=cr.node_id\n    JOIN Spec s ON s.node_id=m.dst_id\n    WHERE r.releaseName='Rel-18' AND substr(s.specNumber,1,4)='38.1' ",
