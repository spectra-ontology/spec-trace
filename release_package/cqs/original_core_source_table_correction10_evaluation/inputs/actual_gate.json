  "SQL": "SELECT DISTINCT t.tableId,t.tableNumber,t.tableCaption\nFROM TSTable t\nJOIN edge owner ON owner.src_id=t.node_id AND owner.rel_type='TABLE_IN_SECTION'\nJOIN Section s ON s.node_id=owner.dst_id\nJOIN edge binding ON binding.src_id=s.node_id AND binding.rel_type='BELONGS_TO_SPEC'\nJOIN Spec edition ON edition.node_id=binding.dst_id\nWHERE s.sectionNumber='9.2.5.1' AND edition.specNumber='38.133'\nAND edition.specRelease IS NOT NULL\nAND EXISTS (SELECT 1 FROM edge grouping JOIN Spec hub ON hub.node_id=grouping.dst_id\n WHERE grouping.src_id=edition.node_id AND grouping.rel_type='IN_RELEASE_OF'\n AND hub.specNumber='38.133' AND hub.specRelease IS NULL)\nORDER BY t.tableId",
