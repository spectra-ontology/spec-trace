@prefix spectra: <https://w3id.org/spectra#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
spectra:sourceCaptionBodyBlockIndex a owl:DatatypeProperty ; rdfs:domain spectra:TSTable ; rdfs:range xsd:string .
spectra:sourceCaptionStyleLiteral a owl:DatatypeProperty ; rdfs:domain spectra:TSTable ; rdfs:range xsd:string .
spectra:sourceCaptionXML a owl:DatatypeProperty ; rdfs:domain spectra:TSTable ; rdfs:range xsd:string .
spectra:sourceDOCXHash a owl:DatatypeProperty ; rdfs:domain spectra:TSTable ; rdfs:range xsd:string .
spectra:sourceDocumentXMLHash a owl:DatatypeProperty ; rdfs:domain spectra:TSTable ; rdfs:range xsd:string .
spectra:sourceTableBodyBlockIndex a owl:DatatypeProperty ; rdfs:domain spectra:TSTable ; rdfs:range xsd:string .
spectra:sourceTableXML a owl:DatatypeProperty ; rdfs:domain spectra:TSTable ; rdfs:range xsd:string .
spectra:sourceVersionLiteral a owl:DatatypeProperty ; rdfs:domain spectra:TSTable ; rdfs:range xsd:string .
