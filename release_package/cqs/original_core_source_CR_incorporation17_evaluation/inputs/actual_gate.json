  "fresh_inverse_question_SQL": "SELECT DISTINCT sp.specNumber AS specNumber\nFROM SourceCRNormativeIncorporationObservation ob\nJOIN edge os ON os.src_id=ob.node_id AND os.rel_type='DOCUMENTS_SPEC'\nJOIN Spec sp ON sp.node_id=os.dst_id AND sp.specRelease IS NULL\nJOIN edge co ON co.dst_id=ob.node_id AND co.rel_type='HAS_SOURCE_INCORPORATION_OBSERVATION'\nJOIN CR cr ON cr.node_id=co.src_id\nWHERE ob.individualTSGStatus='approved'\nAND ob.normativeHistoryNewVersion IS NOT NULL AND trim(ob.normativeHistoryNewVersion)<>''\nAND EXISTS(SELECT 1 FROM edge m WHERE m.src_id=cr.node_id AND m.dst_id=sp.node_id AND m.rel_type='MODIFIES')\nAND EXISTS(SELECT 1 FROM edge w JOIN WorkItem wi ON wi.node_id=w.dst_id\n WHERE w.src_id=cr.node_id AND w.rel_type='RELATED_TO' AND wi.workItemCode='NR_FeMIMO-Core')\nAND EXISTS(SELECT 1 FROM edge rf JOIN Resolution res ON res.node_id=rf.src_id\n WHERE rf.dst_id=cr.node_id AND rf.rel_type='REFERENCES')\nORDER BY specNumber",
  "fresh_inverse_direct_edge_SQL": "SELECT cr.id AS crId,cr.tdocNumber AS tdocNumber,\n     ob.observationId AS observationId,sp.id AS specId,sp.specNumber AS specNumber\n     FROM Spec sp JOIN edge os ON os.dst_id=sp.node_id AND os.rel_type='DOCUMENTS_SPEC'\n     JOIN SourceCRNormativeIncorporationObservation ob ON ob.node_id=os.src_id\n     JOIN edge co ON co.dst_id=ob.node_id AND co.rel_type='HAS_SOURCE_INCORPORATION_OBSERVATION'\n     JOIN CR cr ON cr.node_id=co.src_id",
