+def validate_top_k_reachable_record_uniqueness(contract, groups):
+    """Preserve every captured row; reject duplicate records that can enter top-k.
+
+    Duplicate requested records wholly in strictly lower groups cannot affect
+    any permissible top-k answer. They remain in the complete population and
+    are never deduplicated. A duplicate touching ANY member of a reachable
+    boundary group fails, including a lower duplicate of an eligible record.
+    This is an infrastructure policy, not a question-meaning judgment.
+    """
+    limit = contract['collection'].get('value')
+    if type(limit) is not int or limit <= 0:
+        raise ValueError('top-k size must be an explicitly declared positive integer')
+    fields = contract['required_fields']
+    rows_before, reachable, locations = 0, set(), {}
+    for index, group in enumerate(groups):
+        is_reachable = rows_before < limit
+        for row in group:
+            token = typed.record_token(row, fields)
+            locations.setdefault(token, []).append(index)
+            if is_reachable:
+                reachable.add(token)
+        rows_before += len(group)
+    duplicates = {token: ranks for token, ranks in locations.items() if len(ranks) > 1}
+    if any(token in reachable for token in duplicates):
+        raise ValueError('top-k reachable population contains duplicate requested records')
+    return {'complete_population_rows': rows_before,
+            'reachable_distinct_records': len(reachable),
+            'preserved_strictly_lower_duplicate_records': len(duplicates),
+            'deduplicated_rows': 0}
 
 
