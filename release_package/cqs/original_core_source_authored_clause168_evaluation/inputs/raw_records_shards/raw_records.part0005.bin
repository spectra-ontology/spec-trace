{"fields":{"filename":"R2-2505772.zip::R2-2505772_MHSLRelayCap_CR_v0_Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether L2 multi-path remote UE supports PDCP duplication over split SRB1/2 in L2 multi-path relay. A UE supporting this feature shall also indicate support of multipathRemoteUE-PC5L2-r18 or multipathRemoteUE-N3C-r18.","paragraph_zero_based":168},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":169},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":170},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":171},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":172},{"literal_text_all_w_t_and_m_t":"directpathRLF-RecoveryViaSRB1-r18","paragraph_zero_based":173},{"literal_text_all_w_t_and_m_t":"Indicates whether L2 multi-path remote UE supports recovery from direct path RLF via split SRB1 using either PC5 connection or non-3GPP connection (if supported) in TS 38.331 [9].","paragraph_zero_based":174},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":175},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":176},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":177},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":178},{"literal_text_all_w_t_and_m_t":"posSIB-ForwardingSupported-r18","paragraph_zero_based":179},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE, when operating as an NR L2 sidelink relay UE, supports forwarding of posSIBs. The UE capable of operation as an NR L2 sidelink relay UE shall set this field to supported if it is capable of obtaining posSIBs.","paragraph_zero_based":180},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":181},{"literal_text_all_w_t_and_m_t":"CY","paragraph_zero_based":182},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":183},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":184},{"literal_text_all_w_t_and_m_t":"relayUE-Operation-L2-r17","paragraph_zero_based":185},{"literal_text_all_w_t_and_m_t":"Indicates whether NR L2 sidelink relay UE operation is supported by the UE. A UE supporting this feature shall also indicate support of supportedBandCombinationListSL-RelayDiscovery-r17.","paragraph_zero_based":186},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":187},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":188},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":189},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":190},{"literal_text_all_w_t_and_m_t":"relayUE-MH-Operation-L2-r19","paragraph_zero_based":191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3d0669bebb61232fe20acea50a76ee807988cbd3d6f41a5e37816ee6179e9413","original_member_sha256":"c7379de7097f64dafbf008e1c06b57228e6acf168e72c816abdff7ae0ffde250","paragraph_ElementTree_utf8_XML_sha256":["bd6ff8eef47bfbc934fdc6a9944347b273785e733c118b91d907cf515900f2a6","143fbb606c77e252ccffd963049a723f5366fa6841dff02558f57f01d4dd9e24","52e8d04a0ae943429e57faa476cb452a4814a4b2d9b483ef95e5baa3b2287987","da117288d817ce7650f2f02f3c5be931bccdd375254ac141261067e470fb7ded","7b88672a0b0e7992af561909c44995f77a03840358d5689afc02838acf69818c","bac9ffe5b6ee3866ea410cd95757f4cb9d12c7c4799c87f34a9fa9d3bc0f9af4","388729130d834acfcaf6a98867f20fc4f88b48d6be9c36441ae2924b7a621491","7ab3a5217a922c61650c3cf8e5e11dae0ec12cb871a797675b6d1939b9206454","d6a21bc6de90921b69deba15c5abae73645fb9e47ac13dda38e202186924bffc","24cab53ae5779ad0421e004bf0408b386f4a52344d0cf9a9c01c0cd8b517d72f","8e74993c6431b7a5fa39f5dec2cc3df3c596b4ee40ec8fa43bec801dee309277","98df135316064a0bd6297e485e2707801d3f34c2a125424c871a174aed5b67a8","d050ab58a8810e8cb55926de1fef5cef509fb812d64c5a2346351c69c28c27b4","ddec2eb33b0c7a45c7383202750297d9202ede0cf8fec5afb92d41d0d18b7a6a","f2582f24226e68ee6d30921b6ba331d424eef121498b09b808458