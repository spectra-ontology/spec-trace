{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":5160},{"literal_text_all_w_t_and_m_t":"v2x-SensingReportingMode3","paragraph_zero_based":5161},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports sensing measurements and reporting of measurement results in eNB scheduled mode for V2X sidelink communication.","paragraph_zero_based":5162},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":5163},{"literal_text_all_w_t_and_m_t":"v2x-SupportedBandCombinationList","paragraph_zero_based":5164},{"literal_text_all_w_t_and_m_t":"Indicates the supported band combination list on which the UE supports simultaneous transmission and/or reception of V2X sidelink communication.","paragraph_zero_based":5165},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5166},{"literal_text_all_w_t_and_m_t":"v2x-SupportedBandCombinationListEUTRA-NR","paragraph_zero_based":5167},{"literal_text_all_w_t_and_m_t":"Indicates the supported band combination list on which the UE supports simultaneous transmission and/or reception of NR sidelink communication only, or joint V2X sidelink communication and NR sidelink communication. ","paragraph_zero_based":5168},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":5169},{"literal_text_all_w_t_and_m_t":"v2x-SupportedTxBandCombListPerBC, v2x-SupportedRxBandCombListPerBC","paragraph_zero_based":5170},{"literal_text_all_w_t_and_m_t":"Indicates, for a particular band combination of EUTRA, the supported band combination list among v2x-SupportedBandCombinationList on which the UE supports simultaneous transmission or reception of EUTRA and V2X sidelink communication respectively. The first bit refers to the first entry of v2x-SupportedBandCombinationList, with value 1 indicating V2X sidelink transmission/reception is supported.","paragraph_zero_based":5171},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":5172},{"literal_text_all_w_t_and_m_t":"v2x-SupportedTxBandCombListPerBC-v1630, v2x-SupportedRxBandCombListPerBC-v1630","paragraph_zero_based":5173},{"literal_text_all_w_t_and_m_t":"Indicates, for a particular band combination of EUTRA, the supported band combination list among v2x-SupportedBandCombinationListEUTRA-NR on which the UE supports simultaneous transmission or reception of EUTRA and NR sidelink communication respectively, or simultaneous transmission or reception of EUTRA and joint V2X sidelink communication and NR sidelink communication respectively. The first bit refers to the first entry of v2x-SupportedBandCombinationListEUTRA-NR, with value 1 indicating V2X sidelink transmission/reception is supported.","paragraph_zero_based":5174},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":5175},{"literal_text_all_w_t_and_m_t":"v2x-TxWithShortResvInterval","paragraph_zero_based":5176},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports 20 ms and 50 ms resource reservation periods for UE autonomous resource selection and eNB scheduled resource allocation for V2X sidelink communication.","paragraph_zero_based":5177},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":5178},{"literal_text_all_w_t_and_m_t":"virtualCellID-BasicSRS","paragraph_zero_based":5179},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports virtual cell ID for basic SRS symbol(s).","paragraph_zero_based":5180},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":5181},{"literal_text_all_w_t_and_m_t":"virtualCellID-AddSRS","paragraph_zero_based":5182},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE supports virtual cell ID for additional SRS symbol(s).","paragraph_zero_based":5183}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b932