{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":48456},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":48457},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":48458},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":48459},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48460},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RLC-CONFIG-STOP","paragraph_zero_based":48461},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":48462},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48463},{"literal_text_all_w_t_and_m_t":"SL-RLC-Config field descriptions","paragraph_zero_based":48464},{"literal_text_all_w_t_and_m_t":"sl-MaxRetxThreshold","paragraph_zero_based":48465},{"literal_text_all_w_t_and_m_t":"Parameter value of maxRetxThreshold for RLC AM for NR sidelink communications, see TS 38.322 [4]. Value t1 corresponds to 1 retransmission, value t2 corresponds to 2 retransmissions and so on.","paragraph_zero_based":48466},{"literal_text_all_w_t_and_m_t":"sl-PollByte","paragraph_zero_based":48467},{"literal_text_all_w_t_and_m_t":"Parameter value of pollByte for RLC AM for NR sidelink communications, see TS 38.322 [4]. Value kB25 corresponds to 25 kBytes, value kB50 corresponds to 50 kBytes and so on. infinity corresponds to an infinite amount of kBytes.","paragraph_zero_based":48468},{"literal_text_all_w_t_and_m_t":"sl-PollPDU","paragraph_zero_based":48469},{"literal_text_all_w_t_and_m_t":"Parameter value of pollPDU for RLC AM for NR sidelink communications, seeTS 38.322 [4]. Value p4 corresponds to 4 PDUs, value p8 corresponds to 8 PDUs and so on. infinity corresponds to an infinite number of PDUs.","paragraph_zero_based":48470},{"literal_text_all_w_t_and_m_t":"sl-SN-FieldLength","paragraph_zero_based":48471},{"literal_text_all_w_t_and_m_t":"This field indicates the RLC SN field size for NR sidelink communication, see TS 38.322 [4]. For groupcast and broadcast, only value size6 (6 bits) is configured for the field sl-SN-FieldLengthUM.","paragraph_zero_based":48472},{"literal_text_all_w_t_and_m_t":"sl-T-PollRetransmit","paragraph_zero_based":48473},{"literal_text_all_w_t_and_m_t":"Timer value of t-PollRetransmit for RLC AM for NR sidelink communications, see TS 38.322 [4], in milliseconds. Value ms5 means 5 ms, value ms10 means 10 ms and so on.","paragraph_zero_based":48474},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48475},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":48476},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":48477},{"literal_text_all_w_t_and_m_t":"SLRBSetup","paragraph_zero_based":48478},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in case of sidelink DRB setup via the dedicated signalling and in case of sidelink DRB  configuration via system information and pre-configuration; otherwise the field is optionally present, need M.","paragraph_zero_based":48479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["754d0a889ce05fefdae009ac02159cd7964a75b6d87cbd89c21ad2c580ca941d","00662b522c1c6ac07d7f0f542005cffcb92d84b6f45522e1829c23756c814fb2","72f74856a79fcfc69a83458e9bdd1a4570daf30a46fe080469ed33a0e722b5bb","5f2dfae6fb48e3dd082134f3bf04163a836b3dea659684c356bc7bcba2a3641a","aa1bf9394f9aaec2cfddab856f11cf3fa62d59c9fb8b2585efd9662a1bedb88c","a81523278a4dae89d9e339356ffec78661f7f069830ab1d6bd9e037140f22f04","b18f707170f6b627be4282151ad3ec284e1f66f64be098b1ba35d72cd859eb89","727e0ef0f83757