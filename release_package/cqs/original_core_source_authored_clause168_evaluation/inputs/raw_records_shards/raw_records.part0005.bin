 of supported configuration(s) of {primary PUCCH group","paragraph_zero_based":49366},{"literal_text_all_w_t_and_m_t":"                                                            -- config, secondary PUCCH group config} for PUCCH cell switching","paragraph_zero_based":49367}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["f461e710c16875671e3879ed695a27a9500d96104366e2edfef2ff291295b7ca","cf51e26c2d89fc90abf9e6211de7fb6d209b593fed535efda8f22d69c888ad36","4d076ab9bc98c8af083bcb05173fb843f7cf2d077e9fcc7ab5099032a7025603","355c34d7ad29a0f8b2c0d09ba6ce3819c79ad28a6f3432d4ca76c836bb2495d2","aa7592353dd90788b7e86fdb9870807a310395da4333fb4ef9ac3b637b22cd2c","5da1a5dcaed34f6175dd4ba641684d5dfc05288b514de6430fe9f52a2957189f","40b8c6d15f080cfd3bfeac25cd08a7c6a2184390ec209de6106fb577a326de45","88cd845c7174c033793d3e8474f0e7a27662b088293da4800df1d0cd3cfec251","5a69b47372ac1f425c3378078addc6ab732707e73a5e0aea0660cb4c6fefca0d","8747f0ec88d614c14e3f38e0440e9d91d2a627899fc0c786c76286793a089fa0","c5e8d35c291a667dd36a683d9b9e0bf9d86e1048695576e15f3ad24feac3986e","686a48c79b008ee4abf802afae0baeadc984fc32d19d8c9c9367231230b70e19","dc5d4f90d2af57de2e5e1c2975a9df34c3857119d157b9c596d9f5063b30fddb","374b9583dc04496bea275b2487d1fbbf23ba35c48f486fa681ae2cd4d055e2ba","c59507ce8d75e99010038eab71da914a6a661f7296591f1a2673b092c1c2ed37","7eacb8ddb5a757e3e573f59bc7a9f6201e706fff2b338fb7c9ff340c5a3883a4","3b4b95ca5f9b8b74b8993ef67b68f0b351c4919e5fc4e42c9a8e6713862d38d5","3252c5032eed0f3737bc4a3c0e1012a61b7bbec9a628f93b4ef037590be6ba1f","6d4eea9f28fcdaeb11f3dc9d7c82020b316c53b8b4cdb3d9f78f5b86918e6d4f","499c04f4deb13efd37658c4d4c91e20c1380dcdde7cd0264ec969c1e9aad06d6","6c9ae7c974cabf0513cc59d3d5ca91