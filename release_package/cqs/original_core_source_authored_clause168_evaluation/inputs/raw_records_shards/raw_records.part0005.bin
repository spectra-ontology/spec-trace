able paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"23ac61d78ba08dd9826b46899b903769cf46c3a8173197cf89dc0ba4e982a48a","original_member_sha256":"43c19dc78a1b4c8a0c750f94a0794aa2b2e6ff318d5500d0d31364d80b47828b","paragraph_ElementTree_utf8_XML_sha256":["cb1f68c3cb7a527ab8d0f7a4b7dbf74587c5012a7899a22e9846e53e203421fe","65ac2483d208b50090003208e2b80a9b3ba9afa4b052a079f5511890803e3032","13a296cdc0117fe8fab98180233cab30f64a0cefa9202305e6800261ccf44a19","5a13fceff94c505bcc5a761d985dc17eb1bfcf9724f7626d3bae06c87b37acc0","f808acd3b970705ae258759eeef7a8344342951b47350e14c8f9fa6fd100df67","7ae559ec2991ca97b15292717e994fec32dd6bb2702fd82d71df5f6d3449fc80","59190e70ece9ffb806e9984eb0949613812c790031ebd2f417b07742101bcec3","5b9d3e94b2e2469a162f36c651ac6802b31fcc4b4fed4f8769f27295b66f32e3","0e47661d68410752894205dee6a9bbbad763c4fb8f938472f606caa30fd5b3b2","6b05dcac69a67638b7b4bcc3ddfc0e3e4494a5371fd56850bbf0980bf5465e39","046072d789da32203b2dbdc5bf6faf7ce0947321bf61b1475c3867e7f07b4f28","ad7c58beb1d9e90fb0849bcd216a0fa195ed528b17181f725cf2b49a179cb8f1","826ddaefbd35bf5941dd0ba7402603c67afa4054d718e9bc0124542ef7dca6de","f93659204248bf7212a2a073874fa6ef6bab855e1f334d94d95f69bdfcb0d978","2e2a4259e1ab3be06dcf0d652b10a4b9ce9bbceafae231f9dfb24253e4a3909b","84cfffd8b170c458e9fd1f937758338e77952052a138c7c60120dc1e8ee9c412","f7b3a7bb9ad97a828da3323273c2deac8004729d61d7f2c7a25185dd92d4eb66","623edfeb67c2d41b2b9e147012100dce2f709456a108863b11db12637e74c692","972c89243ea25b912af8179a8be8c77ab6d50347dd064fa94fff2d9d947bbd4b","022031e640f79d734e0c0078695b4546709c7cc0e2d4b09f740c852d83464850","90739a9b5718a75a6036a95b91a37f44f1e9aef38922942dfe97f431acb1a425","6c4b79aee2df9417fdcf7ff053d8ed2a9ea25e31efedf31e6292500ff9c4b627","8a2054446422db10127b53522c244dd671006eed469081cd46119e9103434846","09696b54939497a8ca2ba620420c03c7479c8446d64fb680ae1962b6d211066f"],"paragraph_range_zero_based":[120,143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2408827.zip::R2-2408827_Corrections to validity of configured uplink grant for SDT.docx:p120"}
{"fields":{"filename":"R2-2408827.zip::R2-2408827_Corrections to validity of configured uplink grant for SDT.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":144},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":145},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":146},{"literal_text_all_w_t_and_m_t":"Alternate 1","paragraph_zero_based":147},{"literal_text_all_w_t_and_m_t":"5.8.2Uplink","paragraph_zero_based":148},{"literal_text_all_w_t_and_m_t":"There are two types of transmission without dynamic grant:","paragraph_zero_based":149},{"literal_text_all_w_t_and_m_t":"-configured grant Type 1 where an uplink grant is provided by RRC, and stored as configured uplink grant;","paragraph_zero_based":150},{"literal_text_all_w_t_and_m_t":"-configured grant Type 2 where an uplink grant is provided by PDCCH, and stored or cleared as configured uplink grant based on L1 signalling indicating configured uplink grant activation or deactivation.","paragraph_zero_based":151},{"literal_text_all_w_t_and_m_t":"Type 1 and Type 2 are configured by RRC for a Serving Cell per BWP. Multiple configurations can be active simultaneously in the same BWP. For Type 2, activation and deactivation are independent among the Serving Cells. For the same BWP, the MAC entity can be configured with both Type 1 and Type 2.","paragraph_zero_based":152},{"literal_text_all_w_t_and_m_t":"Only configured grant Type 1 can be configured for CG-SDT. CG-SDT can only be configured on initial BWP.","paragraph_zero_based":153},{"literal_text_all_w_t_and_m_t":"RRC configures the following parameters when the configured grant Type 1 is configured:","paragraph_zero_based":154},{"literal_text_all_w_t_and_m_t":"-cs-RNTI: CS-RNTI for retransmission;","paragraph_zero_based":155},{"literal_text_all_w_t_and_m_t":"-cg-SDT-CS-RNTI: CS-RNTI for CG-SDT retransmission;","paragraph_zero_based":156},{"literal_text_all_w_t_and_m_t":"-cg-SDT-RSRP-ThresholdSSB: an RSRP threshold configured for SSB selection for CG-SDT;","paragraph_zero_based":157},{"literal_text_all_w_t_and_m_t":"-periodicity: periodicity of the configured grant Type 1;","paragraph_zero_based":158},{"literal_text_all_w_t_and_m_t":"-timeDomainOffset: Offset of a resource with respect to SFN = timeReferenceSFN in time domain;","paragraph_zero_based":159},{"literal_text_all_w_t_and_m_t":"-timeDomainAllocation: Allocation of configured uplink grant in time domain which contains startSymbolAndLength (i.e. SLIV in TS 38.214 [7]) or startSymbol (i.e. S in TS 38.214 [7]);","paragraph_zero_based":160},{"literal_text_all_w_t_and_m_t":"-nrofHARQ-Processes: the number of HARQ processes for configured grant;","paragraph_zero_based":161},{"literal_text_all_w_t_and_m_t":"-harq-ProcID-Offset: offset of HARQ process for configured grant configured with cg-RetransmissionTimer for operation with shared spectrum channel access;","paragraph_zero_based":162},{"literal_text_all_w_t_and_m_t":"-harq-ProcID-Offset2: offset of HARQ process for configured grant not configured with cg-RetransmissionTimer;","paragraph_zero_based":163},{"literal_text_all_w_t_and_m_t":"-timeReferenceSFN: SFN used for determination of the offset of a resource in time domain. The UE uses the closest SFN with the indicated number preceding the reception of the configured grant configuration.","paragraph_zero_based":164},{"literal_text_all_w_t_and_m_t":"RRC configures the following parameters when the configured grant Type 2 is configured:","paragraph_zero_based":165},{"literal_text_all_w_t_and_m_t":"-cs-RNTI: CS-RNTI for activation, deactivation, and retransmission;","paragraph_zero_based":166},{"literal_text_all_w_t_and_m_t":"-periodicity: periodicity of the configured grant Type 2;","paragraph_zero_based":167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"23ac61d78ba08dd9826b46899b903769cf46c3a8173197cf89dc0ba4e982a48a","original_member_sha256":"43c19dc78a1b4c8a0c750f94a0794aa2b2e6ff318d5500d0d31364d80b47828b","paragraph_ElementTree_utf8_XML_sha256":["c002616492b1923e46d6fa95a25dac7944411eca88ccdcee2199f265ed726678","d02e8cbd697ae1810074c3012247d88e70339f7889a7482c352e21eca4a8f878","bd01d68c49dd1c2e2bce8de7bd2f18493ff381d4927fb0f625839ac1cdce154d","c500e1ffff711dfa762cd43e705dbc39107a59fb326260f659365508f54e73a7","8362559c179d0efed6f3088c53b0c56141c22cdbffbe80ce768e0d137130a67c","f6d801533c516018c29a01ac5d86730555ea2932fdd728653cce9e7bfc0c0e74","db77010b893e87627d9aab9f8ae4578c7061f9a7b2048d3d6a3ff3336448a17a","98ffe8e3408f18b6c20d698fc86431e7a72f177f3b7dfd9a893782535979bfb5","9424f90cdc15aac0736913d3cb7efa102ad912807b78a4b9b4072ea43e2c1c48","74e8e27d27d1ea0ae1e5c3d825cd33a87195c8277f47b8e7e222bbb8ba405a17","6d1f2d04c7e1cb8a50d370beffa487269dc8266a28284370e4a8b5841d892fe9","7a41d46688fa8f6c3c81bde209e7bc0d40eabcd2ea4cb764f44280caa97ad957","4131017de277273e2e99b70c27311a5d8f027e5576b0023076bbfcaae3c8618a","58db48699117f169a3fb19a76c10ce052e1f7f513d8a0bce1549375c63ed2d09","5cc0a7858207d54a7a924c4e887df95831257a745ac5c42918a6d44fb2c7c3fe","142b13b52d768c2d65ca10801d11c3a4ead2df47922f4d541f9e6973fedc4257","f6f9826162d7414baac5086bdbaa4ae5163f46380e22400a054aef48f20f77cd","3405a705e66d83e2cda3cfc8aaab8f468efd9a197ca6e33588645385c50f8325","e6d6671a23162032f140d5b5499530e6de269ed97345938714d18da3a04c685e","86917385bf575c213d877efcff23d5bdc762bd28803e6346d0d75688ece25d2f","f294adbf04cbd0dbb720f4d13dfe699a445f39091b8b76c4113d0d877cf60233","552783ea90c87a220759810e24e867543ef9c77a78c9a648e60652e5b9648de0","8a0357b843b968b2b4ffbd311321eba5140fca3908353ff859904d2894ba53cc","34968bc48af6560c1df5a723fae551d20c2c9ae0fcd040b804b029751b1fa955"],"paragraph_range_zero_based":[144,167],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2408827.zip::R2-2408827_Corrections to validity of configured uplink grant for SDT.docx:p144"}
{"fields":{"filename":"R2-2408827.zip::R2-2408827_Corrections to validity of configured uplink grant for SDT.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-nrofHARQ-Processes: the number of HARQ processes for configured grant;","paragraph_zero_based":168},{"literal_text_all_w_t_and_m_t":"-harq-ProcID-Offset: offset of HARQ process for configured grant configured with cg-RetransmissionTimer for operation with shared spectrum channel access;","paragraph_zero_based":169},{"literal_text_all_w_t_and_m_t":"-harq-ProcID-Offset2: offset of HARQ process for configured grant not configured with cg-RetransmissionTimer.","paragraph_zero_based":170},{"literal_text_all_w_t_and_m_t":"RRC configures the following parameter when retransmissions on configured uplink grant is configured:","paragraph_zero_based":171},{"literal_text_all_w_t_and_m_t":"-cg-RetransmissionTimer: the duration after a configured grant (re)transmission of a HARQ process when the UE shall not autonomously retransmit that HARQ process;","paragraph_zero_based":172},{"literal_text_all_w_t_and_m_t":"-cg-SDT-RetransmissionTimer: the duration after a configured grant (re)transmission of a HARQ process of the initial CG-SDT transmission with CCCH message when the UE shall not autonomously retransmit the HARQ process.","paragraph_zero_based":173},{"literal_text_all_w_t_and_m_t":"Upon configuration of a configured grant Type 1 for a BWP of a Serving Cell by upper layers, the MAC entity shall:","paragraph_zero_based":174},{"literal_text_all_w_t_and_m_t":"1>store the uplink grant provided by upper layers as a configured uplink grant for the indicated BWP of the Serving Cell;","paragraph_zero_based":175},{"literal_text_all_w_t_and_m_t":"1>initialise or re-initialise the configured uplink grant to start in the symbol according to timeDomainOffset, timeReferenceSFN, and S (derived from SLIV or provided by startSymbol as specified in TS 38.214 [7]), and to reoccur with periodicity.","paragraph_zero_based":176},{"literal_text_all_w_t_and_m_t":"After an uplink grant is configured for a configured grant Type 1, the MAC entity shall consider sequentially that the Nth (N >= 0) uplink grant occurs in the symbol for which:","paragraph_zero_based":177},{"literal_text_all_w_t_and_m_t":"[(SFN × numberOfSlotsPerFrame × numberOfSymbolsPerSlot)+ (slot number in the frame × numberOfSymbolsPerSlot) + symbol number in the slot] =(timeReferenceSFN × numberOfSlotsPerFrame × numberOfSymbolsPerSlot+ timeDomainOffset × numberOfSymbolsPerSlot + S + N × periodicity)modulo (1024 × numberOfSlotsPerFrame × numberOfSymbolsPerSlot)","paragraph_zero_based":178},{"literal_text_all_w_t_and_m_t":"For an uplink grant configured for configured grant Type 1 for CG-SDT on the selected uplink carrier as in clause 5.27, when CG-SDT is triggered and not terminated, for each configured uplink grant valid according to TS 38.214 [7] for which the above formula is satisfied, the MAC entity shall:","paragraph_zero_based":179},{"literal_text_all_w_t_and_m_t":"1>if, after initial transmission for CG-SDT with CCCH message has been performed according to clause 5.4.1, PDCCH addressed to the MAC entity's C-RNTI has not been received:","paragraph_zero_based":180},{"literal_text_all_w_t_and_m_t":"2>if the SSB corresponding to the configured UL grant has the same SSB index as the SSB selected for initial transmission for CG-SDT with CCCH message (i.e., retransmission of initial transmission of CG-SDT):","paragraph_zero_based":181},{"literal_text_all_w_t_and_m_t":"3>select this SSB;","paragraph_zero_based":182},{"literal_text_all_w_t_and_m_t":"3>indicate the SSB index corresponding to the configured uplink grant to the lower layer;","paragraph_zero_based":183},{"literal_text_all_w_t_and_m_t":"3>consider this configured uplink grant as valid.","paragraph_zero_based":184},{"literal_text_all_w_t_and_m_t":"2> else:","paragraph_zero_based":185},{"literal_text_all_w_t_and_m_t":"3> consider this configured uplink grant as not valid.","paragraph_zero_based":186},{"literal_text_all_w_t_and_m_t":"1>else if at least one SSB configured for CG-SDT with SS-RSRP above cg-SDT-RSRP-ThresholdSSB is available:","paragraph_zero_based":187},{"literal_text_all_w_t_and_m_t":"2>if at least one SSB corresponding to the configured uplink grant with SS-RSRP above the cg-SDT-RSRP-ThresholdSSB is available:","paragraph_zero_based":188},{"literal_text_all_w_t_and_m_t":"3>if this is the initial transmission of CG-SDT with CCCH message after the CG-SDT procedure is initiated as in clause 5.27 (i.e., initial transmission for CG-SDT):","paragraph_zero_based":189},{"literal_text_all_w_t_and_m_t":"4>select an SSB with SS-RSRP above cg-SDT-RSRP-ThresholdSSB amongst the SSB(s) associated with the configured uplink grant.","paragraph_zero_based":190},{"literal_text_all_w_t_and_m_t":"3>else if PDCCH addressed to C-RNTI has been received after the initial transmission of CG-SDT with CCCH message (i.e., subsequent new transmission for CG-SDT):","paragraph_zero_based":191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"23ac61d78ba08dd9826b46899b903769cf46c3a8173197cf89dc0ba4e982a48a","original_member_sha256":"43c19dc78a1b4c8a0c750f94a0794aa2b2e6ff318d5500d0d31364d80b47828b","paragraph_ElementTree_utf8_XML_sha256":["4a857b9e4462d252eea745a63c589bc2d82af2bfdeddf5f8f6639a011e61c23c","789aae7d96c29698645b7f73e7ddb40caa4423415c6a181671d6662147cb743b","58e6bf55548d7f043ba75308ea320d5558ad4ce0934d67bec3ae79cf2ca73477","1cf9b4a8c32275ce1e2c90e305e030d72d43efd99a895e88bcbb9dbd4294e8a8","bb73289680e3edfde3f6e1402d5cca67f7584350a3357f7dd341d40384246f45","e19f76361b3bc3281dd4173b789d486e9ab3e2704be941450865ab3641b2eeea","f90e4780f63179d896fd0e655ef528729807b3a460e888cc0d4f253aa2e8b45c","9128b07ea6641a186f136fa51cfea7f1801783d1892586d6da1d7d8196f421de","1f5d08cd98c75e2a4b8a8d54c939587a282ed8d68b014ea4053ac213d9f2c587","f8ec5b2867c47cf0d2a1f878ec9ee9f5a72461a4df1ba0280a7b0ef2dd9162f1","cda23378eeca2e0eda5538cdbf4101192a79cbf8af7ba93bde78958cf9d86c4f","a9bbc6ab358ad522ca5ddaf2085b2ac161037d69855502b49743b2075d603f1b","d01b617490f7f1fb04c6cf9ee7d355c89a036466cbb94a1f15cd69ce77a61366","2fbdd91361fc429c6f0bdefa98ffbea9d07d4f1ca3e7a1c090f39553c32ef2fc","1d82ec4857affaa395a6a9e9986fb6cb66ee82eaaa7300f074479be8892a207a","9f2b3eeb326dd4c8d4971411867d3d6090e29ff0ae15e49d28532bf12bd3d726","9a60c996947df7ccdb58e90420e06adbec15e49402a7f59e71457c33ddffda1c","3fe9087730fa25f56e336779810eec6aa121937632f1f9ffece9548841749fb9","b429d93b7dfc0b51fbdc38ff20d7fa5b1a26284b790f5c311dc2c8ab482ac290","4207cb54efabb0daa89b3d0bf6a2aa4e03a13b770d7ea2d12e26a982d504d26b","bfff5d469efd7858341cea7aeb0efc54238439813a80dca62e2bc0cfd5590dc2","8ff37ec38f13f3b68b06eff1e80b391eec418bcdae77247d22f120449c0d7330","217b96649cdb457d0181f9623503c6579b46bed1b336f65d7f27aa076fb7c16a","7a39c8595cf2fc56fd27e0e0f9fc28df2c28a7c06ef71ea22e3d0c275ce7c090"],"paragraph_range_zero_based":[168,191],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2408827.zip::R2-2408827_Corrections to validity of configured uplink grant for SDT.docx:p168"}
{"fields":{"filename":"R2-2408827.zip::R2-2408827_Corrections to validity of configured uplink grant for SDT.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>if SS-RSRP of the SSB selected for the previous transmission for CG-SDT is above cg-SDT-RSRP-ThresholdSSB and this SSB is associated with this configured uplink grant:","paragraph_zero_based":192},{"literal_text_all_w_t_and_m_t":"5>select this SSB.","paragraph_zero_based":193},{"literal_text_all_w_t_and_m_t":"4>else if SS-RSRP of the SSB selected for the previous transmission for CG-SDT is not above cg-SDT-RSRP-ThresholdSSB:","paragraph_zero_based":194},{"literal_text_all_w_t_and_m_t":"5>select an SSB with SS-RSRP above cg-SDT-RSRP-ThresholdSSB amongst the SSB(s) associated with the configured uplink grant.","paragraph_zero_based":195},{"literal_text_all_w_t_and_m_t":"3>if SSB is selected above:","paragraph_zero_based":196},{"literal_text_all_w_t_and_m_t":"4>indicate the SSB index to the lower layer;","paragraph_zero_based":197},{"literal_text_all_w_t_and_m_t":"4>consider this configured uplink grant as valid.","paragraph_zero_based":198},{"literal_text_all_w_t_and_m_t":"2> else:","paragraph_zero_based":199},{"literal_text_all_w_t_and_m_t":"3> consider this configured uplink grant as not valid.","paragraph_zero_based":200},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":201},{"literal_text_all_w_t_and_m_t":"2>consider this configured uplink grant as not valid.","paragraph_zero_based":202},{"literal_text_all_w_t_and_m_t":"2>if PDCCH addressed to C-RNTI after the initial transmission of the CG-SDT with CCCH message has been received:","paragraph_zero_based":203},{"literal_text_all_w_t_and_m_t":"3>if there is data available for transmission for at least one RB configured for SDT:","paragraph_zero_based":204},{"literal_text_all_w_t_and_m_t":"4>initiate Random Access procedure in clause 5.1.","paragraph_zero_based":205},{"literal_text_all_w_t_and_m_t":"NOTE 1:When the UE determines if there is an SSB with SS-RSRP above cg-SDT-RSRP-ThresholdSSB, the UE uses the latest unfiltered L1-RSRP measurement.","paragraph_zero_based":206},{"literal_text_all_w_t_and_m_t":"After an uplink grant is configured for a configured grant Type 2, the MAC entity shall consider sequentially that the Nth (N >= 0) uplink grant occurs in the symbol for which:","paragraph_zero_based":207},{"literal_text_all_w_t_and_m_t":"[(SFN × numberOfSlotsPerFrame × numberOfSymbolsPerSlot)+ (slot number in the frame × numberOfSymbolsPerSlot) + symbol number in the slot] =[(SFNstart time × numberOfSlotsPerFrame × numberOfSymbolsPerSlot+ slotstart time × numberOfSymbolsPerSlot + symbolstart time) + N × periodicity]modulo (1024 × numberOfSlotsPerFrame × numberOfSymbolsPerSlot)","paragraph_zero_based":208},{"literal_text_all_w_t_and_m_t":"where SFNstart time, slotstart time, and symbolstart time are the SFN, slot, and symbol, respectively, of the first transmission opportunity of PUSCH where the configured uplink grant was (re-)initialised.","paragraph_zero_based":209},{"literal_text_all_w_t_and_m_t":"If cg-nrofPUSCH-InSlot or cg-nrofSlots is configured for a configured grant Type 1 or Type 2, the MAC entity shall consider the uplink grants occur in those additional PUSCH allocations as specified in clause 6.1.2.3 of TS 38.214 [7].","paragraph_zero_based":210},{"literal_text_all_w_t_and_m_t":"NOTE 2:In case of unaligned SFN across carriers in a cell group, the SFN of the concerned Serving Cell is used to calculate the occurrences of configured uplink grants.","paragraph_zero_based":211},{"literal_text_all_w_t_and_m_t":"When the configured uplink grant is released by upper layers, all the corresponding configurations shall be released and all corresponding uplink grants shall be cleared.","paragraph_zero_based":212},{"literal_text_all_w_t_and_m_t":"The MAC entity shall:","paragraph_zero_based":213},{"literal_text_all_w_t_and_m_t":"1>if at least one configured uplink grant confirmation has been triggered and not cancelled; and","paragraph_zero_based":214},{"literal_text_all_w_t_and_m_t":"1>if the MAC entity has UL resources allocated for new transmission:","paragraph_zero_based":215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"23ac61d78ba08dd9826b46899b903769cf46c3a8173197cf89dc0ba4e982a48a","original_member_sha256":"43c19dc78a1b4c8a0c750f94a0794aa2b2e6ff318d5500d0d31364d80b47828b","paragraph_ElementTree_utf8_XML_sha256":["bf190a980b569799e334e21d839a972fd5b4f589e4e73b3495f3e20f5671ff94","e9e4c9cf7350310fef56d2e244d7bf78d94ed82aa0ab072e957e006abde5386f","52f1b182aef7cd66cf57b0d6b550603ffe722a721ab22fddb8bde3f15ad81cea","d9763d23d6cc1fc219905ac0b0361388d5ba078968066c135705ea044ece05a5","cebb549e81e4410b25d658a6e376814a992f3d98fbe9e3ef71f538b41fdfadd6","df24af432b38354f6d4f625cefa02fc9ebffe4ba0643bc7ad42b3e23d6a1f29d","1e350b0a337936888ee5b39e52c16d74ad274a2a7a6b925a6d4b184378cbc999","1f78f9ac69a7c8f8e22bb0c472c05d5b4b43c23f4057bab438742cffd47a9f48","77efa4b1e4917f67fce35918e0ae88957f7570c930d7dcb0ba40431514f6d755","404ec2d7e3ccbff31144ae700eb73ae81b82d3333952505a77dcd3be10eb34b5","7b25308797e1bdacb485dac8250d901d99ffe9e2c7e0fea1a41df047710fd2d6","9e5ffb6280046d0775f8f22b682e040c346ebe2b8083e0d9f47783081cbebc24","4f36314e9808465be2bb235d4061b6aed8e35e827172fb79e6234dd3f79e54b5","853900e7b021fd04a3a11e2d97607959b1281ce0a0840fb37ed570ad6a54914c","6937f543b8134b4764f6f0fbcadabb7c90a97a78a99b60138c1169832d3bcbe6","5932ca13b25b1bff18b4a4e7f2b84fa5d4e7ee7341ba44f733b25936e5599ed2","e283df46ddedce3bfd5f95c02c289d0ac6a8f4ff354f238abe59eed527504f88","3323d9271ca8bbb66029c6f570691c149aa424a361911b57eb89fa2e6d8be40f","79911ad61a01c7fa194e66813e57b0cc829d51b0f2b1bc7a135f3c5d5af14709","c0752dd08e5d6820cae8b897b6c68970143becc9d2f2aca773150f93122c8420","d12f53bf6e1d5c6b546dd65caf3de57647b1c5b53f8b1252bd43ceffa0536add","4a324757f62920a5092ae872ecdc91357cea47caaf1bbedd4901ad94e7d27648","6149b1c23aee140f77e31a980a250edebb05386712540c3e2f50affe304a665d","0cb2fdbd9b92b81378d283c91862aecaea2c6229ae03e44b49034d244de184d5"],"paragraph_range_zero_based":[192,215],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2408827.zip::R2-2408827_Corrections to validity of configured uplink grant for SDT.docx:p192"}
{"fields":{"filename":"R2-2408827.zip::R2-2408827_Corrections to validity of configured uplink grant for SDT.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if, in this MAC entity, at least one configured uplink grant is configured by configuredGrantConfigToAddModList:","paragraph_zero_based":216},{"literal_text_all_w_t_and_m_t":"3>instruct the Multiplexing and Assembly procedure to generate a Multiple Entry Configured Grant Confirmation MAC CE as defined in clause 6.1.3.31.","paragraph_zero_based":217},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":218},{"literal_text_all_w_t_and_m_t":"3>instruct the Multiplexing and Assembly procedure to generate a Configured Grant Confirmation MAC CE as defined in clause 6.1.3.7.","paragraph_zero_based":219},{"literal_text_all_w_t_and_m_t":"2>cancel all triggered configured uplink grant confirmation(s).","paragraph_zero_based":220},{"literal_text_all_w_t_and_m_t":"For a configured grant Type 2, the MAC entity shall clear the configured uplink grant(s) immediately after first transmission of Configured Grant Confirmation MAC CE or Multiple Entry Configured Grant Confirmation MAC CE which confirms the configured uplink grant deactivation.","paragraph_zero_based":221},{"literal_text_all_w_t_and_m_t":"Retransmissions use:","paragraph_zero_based":222},{"literal_text_all_w_t_and_m_t":"-repetition of configured uplink grants; or","paragraph_zero_based":223},{"literal_text_all_w_t_and_m_t":"-received uplink grants addressed to CS-RNTI; or","paragraph_zero_based":224},{"literal_text_all_w_t_and_m_t":"-configured uplink grants with cg-RetransmissionTimer or cg-SDT-RetransmissionTimer configured.","paragraph_zero_based":225},{"literal_text_all_w_t_and_m_t":"Alternate 2","paragraph_zero_based":226},{"literal_text_all_w_t_and_m_t":"5.8.2Uplink","paragraph_zero_based":227},{"literal_text_all_w_t_and_m_t":"There are two types of transmission without dynamic grant:","paragraph_zero_based":228},{"literal_text_all_w_t_and_m_t":"-configured grant Type 1 where an uplink grant is provided by RRC, and stored as configured uplink grant;","paragraph_zero_based":229},{"literal_text_all_w_t_and_m_t":"-configured grant Type 2 where an uplink grant is provided by PDCCH, and stored or cleared as configured uplink grant based on L1 signalling indicating configured uplink grant activation or deactivation.","paragraph_zero_based":230},{"literal_text_all_w_t_and_m_t":"Type 1 and Type 2 are configured by RRC for a Serving Cell per BWP. Multiple configurations can be active simultaneously in the same BWP. For Type 2, activation and deactivation are independent among the Serving Cells. For the same BWP, the MAC entity can be configured with both Type 1 and Type 2.","paragraph_zero_based":231},{"literal_text_all_w_t_and_m_t":"Only configured grant Type 1 can be configured for CG-SDT. CG-SDT can only be configured on initial BWP.","paragraph_zero_based":232},{"literal_text_all_w_t_and_m_t":"RRC configures the following parameters when the configured grant Type 1 is configured:","paragraph_zero_based":233},{"literal_text_all_w_t_and_m_t":"-cs-RNTI: CS-RNTI for retransmission;","paragraph_zero_based":234},{"literal_text_all_w_t_and_m_t":"-cg-SDT-CS-RNTI: CS-RNTI for CG-SDT retransmission;","paragraph_zero_based":235},{"literal_text_all_w_t_and_m_t":"-cg-SDT-RSRP-ThresholdSSB: an RSRP threshold configured for SSB selection for CG-SDT;","paragraph_zero_based":236},{"literal_text_all_w_t_and_m_t":"-periodicity: periodicity of the configured grant Type 1;","paragraph_zero_based":237},{"literal_text_all_w_t_and_m_t":"-timeDomainOffset: Offset of a resource with respect to SFN = timeReferenceSFN in time domain;","paragraph_zero_based":238},{"literal_text_all_w_t_and_m_t":"-timeDomainAllocation: Allocation of configured uplink grant in time domain which contains startSymbolAndLength (i.e. SLIV in TS 38.214 [7]) or startSymbol (i.e. S in TS 38.214 [7]);","paragraph_zero_based":239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"23ac61d78ba08dd9826b46899b903769cf46c3a8173197cf89dc0ba4e982a48a","original_member_sha256":"43c19dc78a1b4c8a0c750f94a0794aa2b2e6ff318d5500d0d31364d80b47828b","paragraph_ElementTree_utf8_XML_sha256":["267812d0f12ece60e53f9964b3102e2433dc375927f3c79777d6c371e08b5dfb","7f5be8b24c53b77728085bd773458d1db9f19a8631392997140adc5e180dbd4d","8105a863798f43f70b62f3ab630d953c2212978d762c740f0565771b55e5e0e6","9d4503b050e21474e0df446882759b9efe14e1529f2f4ec13faec59260ee2c01","3b8e7d25770de9502e23a34e786435d2ce4bedf21e2b01750cde9e1a9097f9aa","3b747c3494c60c9b04b13ae21aac7850cf4a5b770cef6bdacb489891736d3772","e1542faa4293558f700020a0c1efbf36639d06c4416c3358cf861f6c65b409d5","8e6a6dc7e90b4f417ce1e92bea56b92b1b215927a84697cf30ca9e786acd3e9b","1009b5f222f45329b969ccf7422c0c26833168b491af5e4ee993b3c3aed274c7","fa626bde7bf9db0cdb99f9209245d7f8be0dedf2713d18e07ab2228f73315cc1","d04ff3d7fef1976992a3144e0bd3bbd0e085c07f20329fd670cdcb77e5ea0300","0f1c250c449046f8e7783b6349385d32b76b68bff664e1f332258da978479d7b","186e73839f1edb6a6080fa40913bc0f14e960f1f63998d0673ab4d8e33d25c53","95f530843205566210e9d18c14c81cd0309c8c691750fe46e2d40e7af5fadbf9","bf52a7ff713199978574ab16c2127387cd5ac7e658c3058ff82697c00d794daf","eb7a63973146ce421874653d8ebceb85a5139c677c8465b826f178f7c9d718e9","690934ac92d63fbfc4acb554ad1f62b2c144f1b8e40b7907f8a6811e3f05bb73","e00968623a1448acf5345047e09b9a789e80a914e6df3f730adb1423560837c3","f15bc4faf32c50b3e70d45cae656f7a6c0478d9f433a8d11d30ede05d9efb201","ea6f93e72691003dd8ea3f2bb00903149d64a7c36222aa23969005c251b47662","d2d2c374199f3df707cae57201b89313a3d396539d19970d7ac944c32e1650ec","d0d04ca9203a5de6d17ed69429f40edfceb5384bb0da6987621d534714ebbc15","40c252c868402abb137b48f30ee1deb83d46a2b5fdb224a1b04fef87712dd9f7","8ebdf54add73cfb2c9f7595fb091097a9030c6ef39b68ed28363d32394fc9c7c"],"paragraph_range_zero_based":[216,239],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2408827.zip::R2-2408827_Corrections to validity of configured uplink grant for SDT.docx:p216"}
{"fields":{"filename":"R2-2408827.zip::R2-2408827_Corrections to validity of configured uplink grant for SDT.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-nrofHARQ-Processes: the number of HARQ processes for configured grant;","paragraph_zero_based":240},{"literal_text_all_w_t_and_m_t":"-harq-ProcID-Offset: offset of HARQ process for configured grant configured with cg-RetransmissionTimer for operation with shared spectrum channel access;","paragraph_zero_based":241},{"literal_text_all_w_t_and_m_t":"-harq-ProcID-Offset2: offset of HARQ process for configured grant not configured with cg-RetransmissionTimer;","paragraph_zero_based":242},{"literal_text_all_w_t_and_m_t":"-timeReferenceSFN: SFN used for determination of the offset of a resource in time domain. The UE uses the closest SFN with the indicated number preceding the reception of the configured grant configuration.","paragraph_zero_based":243},{"literal_text_all_w_t_and_m_t":"RRC configures the following parameters when the configured grant Type 2 is configured:","paragraph_zero_based":244},{"literal_text_all_w_t_and_m_t":"-cs-RNTI: CS-RNTI for activation, deactivation, and retransmission;","paragraph_zero_based":245},{"literal_text_all_w_t_and_m_t":"-periodicity: periodicity of the configured grant Type 2;","paragraph_zero_based":246},{"literal_text_all_w_t_and_m_t":"-nrofHARQ-Processes: the number of HARQ processes for configured grant;","paragraph_zero_based":247},{"literal_text_all_w_t_and_m_t":"-harq-ProcID-Offset: offset of HARQ process for configured grant configured with cg-RetransmissionTimer for operation with shared spectrum channel access;","paragraph_zero_based":248},{"literal_text_all_w_t_and_m_t":"-harq-ProcID-Offset2: offset of HARQ process for configured grant not configured with cg-RetransmissionTimer.","paragraph_zero_based":249},{"literal_text_all_w_t_and_m_t":"RRC configures the following parameter when retransmissions on configured uplink grant is configured:","paragraph_zero_based":250},{"literal_text_all_w_t_and_m_t":"-cg-RetransmissionTimer: the duration after a configured grant (re)transmission of a HARQ process when the UE shall not autonomously retransmit that HARQ process;","paragraph_zero_based":251},{"literal_text_all_w_t_and_m_t":"-cg-SDT-RetransmissionTimer: the duration after a configured grant (re)transmission of a HARQ process of the initial CG-SDT transmission with CCCH message when the UE shall not autonomously retransmit the HARQ process.","paragraph_zero_based":252},{"literal_text_all_w_t_and_m_t":"Upon configuration of a configured grant Type 1 for a BWP of a Serving Cell by upper layers, the MAC entity shall:","paragraph_zero_based":253},{"literal_text_all_w_t_and_m_t":"1>store the uplink grant provided by upper layers as a configured uplink grant for the indicated BWP of the Serving Cell;","paragraph_zero_based":254},{"literal_text_all_w_t_and_m_t":"1>initialise or re-initialise the configured uplink grant to start in the symbol according to timeDomainOffset, timeReferenceSFN, and S (derived from SLIV or provided by startSymbol as specified in TS 38.214 [7]), and to reoccur with periodicity.","paragraph_zero_based":255},{"literal_text_all_w_t_and_m_t":"After an uplink grant is configured for a configured grant Type 1, the MAC entity shall consider sequentially that the Nth (N >= 0) uplink grant occurs in the symbol for which:","paragraph_zero_based":256},{"literal_text_all_w_t_and_m_t":"[(SFN × numberOfSlotsPerFrame × numberOfSymbolsPerSlot)+ (slot number in the frame × numberOfSymbolsPerSlot) + symbol number in the slot] =(timeReferenceSFN × numberOfSlotsPerFrame × numberOfSymbolsPerSlot+ timeDomainOffset × numberOfSymbolsPerSlot + S + N × periodicity)modulo (1024 × numberOfSlotsPerFrame × numberOfSymbolsPerSlot)","paragraph_zero_based":257},{"literal_text_all_w_t_and_m_t":"For an uplink grant configured for configured grant Type 1 for CG-SDT on the selected uplink carrier as in clause 5.27, when CG-SDT is triggered and not terminated, for each configured uplink grant valid according to TS 38.214 [7] for which the above formula is satisfied, the MAC entity shall:","paragraph_zero_based":258},{"literal_text_all_w_t_and_m_t":"1>if, after initial transmission for CG-SDT with CCCH message has been performed according to clause 5.4.1, PDCCH addressed to the MAC entity's C-RNTI has not been received:","paragraph_zero_based":259},{"literal_text_all_w_t_and_m_t":"2>if the SSB corresponding to the configured UL grant has the same SSB index as the SSB selected for initial transmission for CG-SDT with CCCH message (i.e., retransmission of initial transmission of CG-SDT):","paragraph_zero_based":260},{"literal_text_all_w_t_and_m_t":"3>select this SSB;","paragraph_zero_based":261},{"literal_text_all_w_t_and_m_t":"3>indicate the SSB index corresponding to the configured uplink grant to the lower layer;","paragraph_zero_based":262},{"literal_text_all_w_t_and_m_t":"3>consider this configured uplink grant as valid.","paragraph_zero_based":263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"23ac61d78ba08dd9826b46899b903769cf46c3a8173197cf89dc0ba4e982a48a","original_member_sha256":"43c19dc78a1b4c8a0c750f94a0794aa2b2e6ff318d5500d0d31364d80b47828b","paragraph_ElementTree_utf8_XML_sha256":["ebf16e0dd6c3a71c15339e39ccba5d699fc2c3e77cb8f38cb41a6428ecee94b3","44731fb9b2d3bed39d8c86579aeda6777be812c9a1e427482c6a45687b24bde7","020f468a9eca4c46e96908bac4305e89a894dba8a2c68f040e0537f7e29e1d99","afc2dda2344b1239931c121b0de9d0f6693ddbb9a7ac548eba0dc7b9de2f8780","b6f4a8f234e0af2df5372bd5cfc43eeb7fb6321f2f37bac78473eb1613966afd","89ea4359b21d6dbae4089c18f91239a6e990896b9522db60b4d887fe823f6e27","11d762b421834ce0628fe6e72dd0e68c0ba62043e825a63286de37691ad8a0b2","23cf1d94b6015549be0e63aba65d37e1452c4e85e0ff4459e7ea2cc5fa1631f4","9da720e60340d70bba81b55edd556d66e7b480fd657adfd151b7a740a2650a87","37fbed019128bd273305a09611007bad8c8d69402915b3a44abf87c1879a94fc","02d9b0913ac45171b1e898c4fd8bb491234fab09dffd25736d2f75bc4bb28d76","f8295df6908fbc5dd07714d81af3efd9ef7646443cf3f4376a7f72bae4b84f69","eabc100530d9b9d2e004967d643757371b35d26820d6f0e29ad415607e303cd3","a0de954e333b31314e8ad7eb65945f4291e0ef2d72b272eeee0cc4223739a4b7","0a1c9817edfe8f7f34de78cb7b49317e60bbd32b6878f9e112a571660c303ee8","f5603915b0bc297c90c94f341281996dbad68d8cdda740cd99fab2f70e3b77fa","69a6ad6d90c13097a60684a9a06d889b7e3004d341afebeeab02d89ba7b9ff13","8ddc3ead4a8e74ac8e914230616f45d46ddaa695ae8d802564135a18b0d22716","41de43feaba6d761c70a4de2c70e0243d679fb5b2eb897e435788311ffb3c037","27a3e2a8fce7c3a83edd300849dad79a3873f7ebe9e1884a1e86a133dc8761ef","3549f83f740800e8721248f174823e609c7971d173f64c32b768f38379f09961","53c3c7afc2039feec92ae786a6febb3597605dc4d8a2d0689853c75ecf81f301","fd72855bb08e83ebfc612b1a28fd21f35f7ba54a7395a6c45c388ba1e24aed25","f7f8fc9742caf9a690c1410d83e57bda753247baf1cdcd1cc0d39517eb375d7d"],"paragraph_range_zero_based":[240,263],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2408827.zip::R2-2408827_Corrections to validity of configured uplink grant for SDT.docx:p240"}
{"fields":{"filename":"R2-2408827.zip::R2-2408827_Corrections to validity of configured uplink grant for SDT.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>else if at least one SSB configured for CG-SDT with SS-RSRP above cg-SDT-RSRP-ThresholdSSB is available:","paragraph_zero_based":264},{"literal_text_all_w_t_and_m_t":"2>if at least one SSB corresponding to the configured uplink grant with SS-RSRP above the cg-SDT-RSRP-ThresholdSSB is available:","paragraph_zero_based":265},{"literal_text_all_w_t_and_m_t":"3>if this is the initial transmission of CG-SDT with CCCH message after the CG-SDT procedure is initiated as in clause 5.27 (i.e., initial transmission for CG-SDT):","paragraph_zero_based":266},{"literal_text_all_w_t_and_m_t":"4>select an SSB with SS-RSRP above cg-SDT-RSRP-ThresholdSSB amongst the SSB(s) associated with the configured uplink grant.","paragraph_zero_based":267},{"literal_text_all_w_t_and_m_t":"3>else if PDCCH addressed to C-RNTI has been received after the initial transmission of CG-SDT with CCCH message (i.e., subsequent new transmission for CG-SDT):","paragraph_zero_based":268},{"literal_text_all_w_t_and_m_t":"4>if SS-RSRP of the SSB selected for the previous transmission for CG-SDT is above cg-SDT-RSRP-ThresholdSSB and this SSB is associated with this configured uplink grant:","paragraph_zero_based":269},{"literal_text_all_w_t_and_m_t":"5>select this SSB.","paragraph_zero_based":270},{"literal_text_all_w_t_and_m_t":"4>else if SS-RSRP of the SSB selected for the previous transmission for CG-SDT is not above cg-SDT-RSRP-ThresholdSSB:","paragraph_zero_based":271},{"literal_text_all_w_t_and_m_t":"5>select an SSB with SS-RSRP above cg-SDT-RSRP-ThresholdSSB amongst the SSB(s) associated with the configured uplink grant.","paragraph_zero_based":272},{"literal_text_all_w_t_and_m_t":"3>if SSB is selected above:","paragraph_zero_based":273},{"literal_text_all_w_t_and_m_t":"4>indicate the SSB index to the lower layer;","paragraph_zero_based":274},{"literal_text_all_w_t_and_m_t":"4>consider this configured uplink grant as valid.","paragraph_zero_based":275},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":276},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":277},{"literal_text_all_w_t_and_m_t":"2>if PDCCH addressed to C-RNTI after the initial transmission of the CG-SDT with CCCH message has been received:","paragraph_zero_based":278},{"literal_text_all_w_t_and_m_t":"3>if there is data available for transmission for at least one RB configured for SDT:","paragraph_zero_based":279},{"literal_text_all_w_t_and_m_t":"4>initiate Random Access procedure in clause 5.1.","paragraph_zero_based":280},{"literal_text_all_w_t_and_m_t":"NOTE 1:When the UE determines if there is an SSB with SS-RSRP above cg-SDT-RSRP-ThresholdSSB, the UE uses the latest unfiltered L1-RSRP measurement.","paragraph_zero_based":281},{"literal_text_all_w_t_and_m_t":"After an uplink grant is configured for a configured grant Type 2, the MAC entity shall consider sequentially that the Nth (N >= 0) uplink grant occurs in the symbol for which:","paragraph_zero_based":282},{"literal_text_all_w_t_and_m_t":"[(SFN × numberOfSlotsPerFrame × numberOfSymbolsPerSlot)+ (slot number in the frame × numberOfSymbolsPerSlot) + symbol number in the slot] =[(SFNstart time × numberOfSlotsPerFrame × numberOfSymbolsPerSlot+ slotstart time × numberOfSymbolsPerSlot + symbolstart time) + N × periodicity]modulo (1024 × numberOfSlotsPerFrame × numberOfSymbolsPerSlot)","paragraph_zero_based":283},{"literal_text_all_w_t_and_m_t":"where SFNstart time, slotstart time, and symbolstart time are the SFN, slot, and symbol, respectively, of the first transmission opportunity of PUSCH where the configured uplink grant was (re-)initialised.","paragraph_zero_based":284},{"literal_text_all_w_t_and_m_t":"If cg-nrofPUSCH-InSlot or cg-nrofSlots is configured for a configured grant Type 1 or Type 2, the MAC entity shall consider the uplink grants occur in those additional PUSCH allocations as specified in clause 6.1.2.3 of TS 38.214 [7].","paragraph_zero_based":285},{"literal_text_all_w_t_and_m_t":"NOTE 2:In case of unaligned SFN across carriers in a cell group, the SFN of the concerned Serving Cell is used to calculate the occurrences of configured uplink grants.","paragraph_zero_based":286},{"literal_text_all_w_t_and_m_t":"When the configured uplink grant is released by upper layers, all the corresponding configurations shall be released and all corresponding uplink grants shall be cleared.","paragraph_zero_based":287}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"23ac61d78ba08dd9826b46899b903769cf46c3a8173197cf89dc0ba4e982a48a","original_member_sha256":"43c19dc78a1b4c8a0c750f94a0794aa2b2e6ff318d5500d0d31364d80b47828b","paragraph_ElementTree_utf8_XML_sha256":["2991eb80b827441d65b3a732ddedf7079d523e1ee48901b9728c79175be9978c","accdffa6b48d33128a0e3b17f07761fea7b9571e60b6e064a9e3fd5488743dab","9e654e2cf1c4b3c71660c911a2de88643c4bd7f574b9aa2f79b858c7093a22dd","dab9f4d945a74a46af57729871c160d32479e5df3fb73903399fe445ee0d7715","6c436542608dd82016398a54d361455e16129953ea53300fa41eb6ce35a4065c","72255ebbab0b24e7fb07acd323ff1f647fd2af11f88ab42bf0f590dd9131df37","5e90e7285abf16a02aa80a4e3b76a959bf384477e52305113852ee0659d85042","6cf1e8eeace0597ff2b146ce15b7e9b58162fbc9956a644bc07620179ae5ecff","21666d228af5ed1dc8dc6981300673b211c10658d0f106eda651e27b25ce88b1","69094f3330b98a61c3f7396459543a3a1d953f337e3532cee7a0414d0f8d55dc","cc0687ad9b1e4af3da099cc3b1e17e07e2e8a286f0ab23f6b70e512e6a074964","c4d997c15fde9b25b268453419eaadd7182b75d316a2cbf9dfa67c29f62b3819","5744fc5656d72fff6a116661949251d86b5d6e601931454c3b9b0db8fedb3862","43c3042f0f4b44b57a2cb386278ce5429f6650859bba1c6b076270ed5bd6e6cc","8d316b002ae42d31b27791a73d9f06a3b41e9d1f1e126a585474a8c26b213022","7661521e5e607457502df60bed2d3d14b5d4fac2e31fd651330e38d5a6a800d0","3b868a149dae3c80e88398d0598a3ff52969581b94eec39a545a42ba2aac546b","f119e973a43bd7e89900b91781690505c995c52285d24168aed9c6c54d404ee4","ca53c90aeb4be07e5ad90b1fd4f5a09f3fc07797a3adeae814a62585a865e911","5739b93bd0f6226a3808af109dbb364f72b1d8ccf17791382aa8520cf882972f","cae902903fd4e47b6d1c50ba0f96d9d868c0274385f2eb9427d925ac986198f9","166961e2084ae918f3eb45be988bdfd7f0ba4fc1d7e076aed4dd9f4098ce4970","42947bde7627cbba6f8cc632de9353f48a7dc665156bb9d70de4d47d4c22efb3","a3d25351bdb01465ac890133456cc1089d86085d1c00c0a8d538e92c8be83227"],"paragraph_range_zero_based":[264,287],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2408827.zip::R2-2408827_Corrections to validity of configured uplink grant for SDT.docx:p264"}
{"fields":{"filename":"R2-2408827.zip::R2-2408827_Corrections to validity of configured uplink grant for SDT.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The MAC entity shall:","paragraph_zero_based":288},{"literal_text_all_w_t_and_m_t":"1>if at least one configured uplink grant confirmation has been triggered and not cancelled; and","paragraph_zero_based":289},{"literal_text_all_w_t_and_m_t":"1>if the MAC entity has UL resources allocated for new transmission:","paragraph_zero_based":290},{"literal_text_all_w_t_and_m_t":"2>if, in this MAC entity, at least one configured uplink grant is configured by configuredGrantConfigToAddModList:","paragraph_zero_based":291},{"literal_text_all_w_t_and_m_t":"3>instruct the Multiplexing and Assembly procedure to generate a Multiple Entry Configured Grant Confirmation MAC CE as defined in clause 6.1.3.31.","paragraph_zero_based":292},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":293},{"literal_text_all_w_t_and_m_t":"3>instruct the Multiplexing and Assembly procedure to generate a Configured Grant Confirmation MAC CE as defined in clause 6.1.3.7.","paragraph_zero_based":294},{"literal_text_all_w_t_and_m_t":"2>cancel all triggered configured uplink grant confirmation(s).","paragraph_zero_based":295},{"literal_text_all_w_t_and_m_t":"For a configured grant Type 2, the MAC entity shall clear the configured uplink grant(s) immediately after first transmission of Configured Grant Confirmation MAC CE or Multiple Entry Configured Grant Confirmation MAC CE which confirms the configured uplink grant deactivation.","paragraph_zero_based":296},{"literal_text_all_w_t_and_m_t":"Retransmissions use:","paragraph_zero_based":297},{"literal_text_all_w_t_and_m_t":"-repetition of configured uplink grants; or","paragraph_zero_based":298},{"literal_text_all_w_t_and_m_t":"-received uplink grants addressed to CS-RNTI; or","paragraph_zero_based":299},{"literal_text_all_w_t_and_m_t":"-configured uplink grants with cg-RetransmissionTimer or cg-SDT-RetransmissionTimer configured.","paragraph_zero_based":300},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":301}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"23ac61d78ba08dd9826b46899b903769cf46c3a8173197cf89dc0ba4e982a48a","original_member_sha256":"43c19dc78a1b4c8a0c750f94a0794aa2b2e6ff318d5500d0d31364d80b47828b","paragraph_ElementTree_utf8_XML_sha256":["5e70745501a2a21b9ed112c4324c62d7d0459a1ff0714c4512ec32e20ec7d81f","105129d9741a19c0e92ff39e9dc0206e1226ec15d1749a3b5ba72b2ac468b691","bd65bcd4820dda450e7005f427e8b17848bcedbd7829ab06993657522c2d80eb","c0065b619c0e6fa9413962537e69002d595f0cecdc6330af72c4b2bc0551f70a","f0f0306d7f41ca996edb78a2f8efdcc4790cd21ad58290e1c682989687a468b6","f552d2ce96747dc58f259bf0ed9a3e2684d9bd0828999a35642aebbcc75601f8","17fa09a36dee3ecaba145816e7b03d939d99220ce16ed0a474b4aa5e7fcf6878","689ce1d4a7e32aefaae4e689a9f532cfacb461ac2bcf29704ecc318b742210bc","fa27c3ee6291d1bba78a76ef6807e53c4884ffc7f3321f4e217890c74d20ad03","8ca7c70b8ca3b3f35d42d44b356728f2773e4fbf01398d40fb1e0ec288831d62","330bbd316274baae7c26a9cb939f327427b2a5b14df67161947e1e69a46ed885","49c2adabb1c99746d75fcd29ff1985b9ff2ec43bd20b8588c528662d2d78d4b6","8b7fe4b3c3f350abc951cf791bdd546805f3394a4c20b8d0a93aa1db707acbdb","6b2f35e414ba4db2ac02f7ae7972a42f1434a8c4ca7c9506dbff0d1d2d4f07a0"],"paragraph_range_zero_based":[288,301],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2408827.zip::R2-2408827_Corrections to validity of configured uplink grant for SDT.docx:p288"}
