{"fields":{"filename":"R2-2408215.zip::R2-2408215 Correction on UE capability of supporting NavIC in A-GNSS positioning (R18).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"If the target device supports NavIC and GNSS-Almanac assistance, it shall support Model-8.","paragraph_zero_based":192},{"literal_text_all_w_t_and_m_t":"If this field is absent, the target device supports the mandatory (native) almanacModel choice only as listed above for the GNSS indicated by GNSSID.","paragraph_zero_based":193},{"literal_text_all_w_t_and_m_t":" ","paragraph_zero_based":194},{"literal_text_all_w_t_and_m_t":"–GNSS-UTC-ModelSupport","paragraph_zero_based":195},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":196},{"literal_text_all_w_t_and_m_t":" ","paragraph_zero_based":197},{"literal_text_all_w_t_and_m_t":"GNSS-UTC-ModelSupport ::=SEQUENCE {","paragraph_zero_based":198},{"literal_text_all_w_t_and_m_t":"utc-ModelBIT STRING {model-1(0),","paragraph_zero_based":199},{"literal_text_all_w_t_and_m_t":"model-2(1),","paragraph_zero_based":200},{"literal_text_all_w_t_and_m_t":"model-3(2),","paragraph_zero_based":201},{"literal_text_all_w_t_and_m_t":"model-4(3),","paragraph_zero_based":202},{"literal_text_all_w_t_and_m_t":"model-5(4) } (SIZE (1..8))OPTIONAL,","paragraph_zero_based":203},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":204},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":205},{"literal_text_all_w_t_and_m_t":" ","paragraph_zero_based":206},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":207},{"literal_text_all_w_t_and_m_t":" ","paragraph_zero_based":208},{"literal_text_all_w_t_and_m_t":"GNSS-UTC-ModelSupport field descriptions","paragraph_zero_based":209},{"literal_text_all_w_t_and_m_t":"utc-Model","paragraph_zero_based":210},{"literal_text_all_w_t_and_m_t":"This field specifies the GNSS-UTC-Model choice(s) in GNSS-UTC-Model IE supported by the target device for the GNSS indicated by GNSSID. This is represented by a bit string, with a onevalue at the bit position means the particular UTC model is supported; a zerovalue means not supported.","paragraph_zero_based":211},{"literal_text_all_w_t_and_m_t":"If the target device supports GPS and GNSS-UTC-Model assistance, it shall support Model-1.","paragraph_zero_based":212},{"literal_text_all_w_t_and_m_t":"If the target device supports SBAS and GNSS-UTC-Model assistance, it shall support Model-4.","paragraph_zero_based":213},{"literal_text_all_w_t_and_m_t":"If the target device supports QZSS and GNSS-UTC-Model assistance, it shall support Model-1.","paragraph_zero_based":214},{"literal_text_all_w_t_and_m_t":"If the target device supports Galileo and GNSS-UTC-Model assistance, it shall support Model-1.","paragraph_zero_based":215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"b1f4f45546def2664ca2ee7667b8fe23ed4539cfd8edba6b6f93bf09915e1a61","original_member_sha256":"daacb728659b141652fb097c21d93fe1c637dfd6fe5095d8417a2039f13bf59d","paragraph_ElementTree_utf8_XML_sha256":["e09f60a9c79ec7ecb8a0e4675ee2bf24b64267c8aed900d7d28ec793807284b3","de68a379edd1ec5c355bb7b8ebc33f4789d6a3938a23eb28d0a801e4da488ab5","ab3f4752e967f095f8bf42cf79834206e3a545205632e867ae657eacebd1d79c","6662581d1bb02431a349ca7cc4131ffa1eb1cd9fc3f6dbbc2bb51f6b22b1bea6","8e682d998e0680baad900dcbcaffb17864ada3b74cf81ce0edff62ecb33aa547","a3a9fe13ba37b488da597447e8b2f3fa8cddf6aaa28827420e1bfb3b73219adb","8195811a0b6bebb6c9b8e89655038cda0e057bb4a17ae24d790406a8d496ae64","4ae58a570435bf7703309fcc51b380614e0958feea910c49fdc854fde1c65568","ad6d8611edc0a48611eedebdd0d5de46833540d7af87ce4b59b6c8268ac28895","0c500a5c1a7938c67f9ce9af58278dc5891d2efe7fe340938c4d65069ee9c12c","2f9dc1bfdc7477f2ac7e52b49a91aad8621089d6818e49cecbe1c5a7da4aaecf","666b468bc324e338b9df34d9be28d6d9a707693ee0b876