ED{true}                                        OPTIONAL,   -- Need N","paragraph_zero_based":4813},{"literal_text_all_w_t_and_m_t":"    pdcp-Config-r17                         PDCP-Config                                             OPTIONAL,   -- Cond PDCP","paragraph_zero_based":4814},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":4815},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":4816},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4817},{"literal_text_all_w_t_and_m_t":"MRB-ToReleaseList-r17 ::=               SEQUENCE (SIZE (1..maxMRB-r17)) OF MRB-Identity-r17","paragraph_zero_based":4818},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4819},{"literal_text_all_w_t_and_m_t":"-- TAG-RADIOBEARERCONFIG-STOP","paragraph_zero_based":4820},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":4821},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4822},{"literal_text_all_w_t_and_m_t":"DRB-ToAddMod and MRB-ToAddMod field descriptions","paragraph_zero_based":4823}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["1511ea5392b475c465eb1e53bbd37c1c9d3e529c4a2fd955c48e4e8d4a27ed49","9f6a8a0561b4a014ab092a2aff19bc66766cba7586300438c00560a194f7eb38","82d4df3839e44e72ba3394b7a54c136676f35351214c4a25495707d82d6fbcae","238ba7c0933afa9ad663e5b7bb8776a1aaa6f6387f9ca2e54bbe539ec58dff19","7ce1f00fb9f553d13c8483e786930a95968e3aa9350ee04eef654bf3aa7e181a","026cd78afed6b95b885db3ea9b4f314f5766412be011eaf936f50ae9956dbfcd","16190b388769123686ee5fc11c959362b1492756490449f17cb6dfcf3043eec8","ce328f8c456e3510188c059ce90d70ce83cab1ac5c76f04192a9263a20ae5ece","c05c6da01df3a8948ce1bd3f09d674d901a058044ce70e787e8f91005ce38eab","7f46ef69b090396b52e087ac6f9c7c1c6fe9889d1bfa6d7b53d1e465be95133f","76190bb392afe23a177e257a4428edcb5c1aa8d33ae47a7501a7ee9d3ca69950","dda63dece82e2fdede00f0dcc2ed15ab4b213bffcc52aa2ca44bc5b0fdb803a4","657cc81411d4506a71c7e7742b2f1867de3874e2ec59363ce39ecec0dc7698c2","a308421fa6fe9b82423443b01178ae96a15e92be5413cd1204a0a9c91a2672f2","8b587d65a229de338cb5e32b840da89c5aa945dc840a4d9d755a81a2d5d4d4cf","b6f98ab6300113beeecc29f24fc67434925f9a4b4dbbe7a6c98264bd10fd1ec4","9af9377758c2c3cb0a2dfab25d9a40c66c6c3c3624bea957d368c174ecbf74df","ad5baf0aa40a556f8543cda5b54124c9e6621cbd6ac58993d47ecbb438b15535","3ae2f7089c36d027d850099f6547221c8ae687281fe2a34e1e9a1ed1670ec0f6","425e3a20534d08bb6eb8232a45b707da7ffab130522b0f7c06b1d82eaf7b4458","32862043a291c1b4bd65a3fff1c9c22aa353c4b0dd98f31c2d6ed458966127a6","1fa2556b01eb90252bbe0baffa14ef051085471e21b1fd75fa67fa26379d8d32","75f77da25065544a241f3c07511982965d734ac18948fb40ddf51abb735b33fc","46c9b2be5bee96f220de1b5ff1f0fbad256d796fe6c16aae0edca2903d412448"],"paragraph_range_zero_based":[4800,4823],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p4800"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"cnAssociation","paragraph_zero_based":4824},{"literal_text_all_w_t_and_m_t":"Indicates if the bearer is associated with the eps-bearerIdentity (when connected to EPC) or sdap-Config (when connected to 5GC).","paragraph_zero_based":4825},{"literal_text_all_w_t_and_m_t":"daps-Config","paragraph_zero_based":4826},{"literal_text_all_w_t_and_m_t":"Indicates that the bearer is configured as DAPS bearer. The network does not include this field in an RRCReconfiguration message contained within a LTM-Config IE.","paragraph_zero_based":4827},{"literal_text_all_w_t_and_m_t":"drb-Identity","paragraph_zero_based":4828},{"literal_text_all_w_t_and_m_t":"In case of DC, the DRB identity is unique within the scope of the UE, i.e. an MCG DRB cannot use the same value as a split DRB. For a split DRB the same identity is used for the MCG and SCG parts/indirect path of the configuration.","paragraph_zero_based":4829},{"literal_text_all_w_t_and_m_t":"eps-BearerIdentity","paragraph_zero_based":4830},{"literal_text_all_w_t_and_m_t":"The EPS bearer ID determines the EPS bearer.","paragraph_zero_based":4831},{"literal_text_all_w_t_and_m_t":"mbs-SessionId","paragraph_zero_based":4832},{"literal_text_all_w_t_and_m_t":"Indicates which multicast MBS session the bearer is associated with.","paragraph_zero_based":4833},{"literal_text_all_w_t_and_m_t":"mrb-Identity","paragraph_zero_based":4834},{"literal_text_all_w_t_and_m_t":"Identification of the multicast MRB.","paragraph_zero_based":4835},{"literal_text_all_w_t_and_m_t":"mrb-IdentityNew","paragraph_zero_based":4836},{"literal_text_all_w_t_and_m_t":"New identity of the multicast MRB when mrb-Identity needs to be changed, e.g. as a result of a handover.","paragraph_zero_based":4837},{"literal_text_all_w_t_and_m_t":"n3c-BearerAssociated","paragraph_zero_based":4838},{"literal_text_all_w_t_and_m_t":"Indicates that the radio bearer is associated with the N3C indirect path.","paragraph_zero_based":4839},{"literal_text_all_w_t_and_m_t":"reestablishPDCP","paragraph_zero_based":4840},{"literal_text_all_w_t_and_m_t":"Indicates that PDCP should be re-established. Network sets this to true whenever the security key used for this radio bearer changes. Key change could for example be due to termination point change for the bearer, reconfiguration with sync, resuming an RRC connection, or the first reconfiguration after reestablishment. It is also applicable for LTE procedures when NR PDCP is configured. Network doesn't include this field for DRB if the bearer is configured as DAPS bearer, if the RadioBearerConfig IE is part of an RRCReconfiguration message within the LTM-Config IE, or if the RadioBearerConfig IE is part of an RRCReconfiguration message associated with subsequent CPAC within the ConditionalReconfiguration IE","paragraph_zero_based":4841},{"literal_text_all_w_t_and_m_t":"recoverPDCP","paragraph_zero_based":4842},{"literal_text_all_w_t_and_m_t":"Indicates that PDCP should perform recovery according to TS 38.323 [5]. Network doesn't include this field if the bearer is configured as DAPS bearer, if the RadioBearerConfig IE is part of an RRCReconfiguration message within the LTM-Config IE, or if the RadioBearerConfig IE is part of an RRCReconfiguration message associated with subsequent CPAC within the ConditionalReconfiguration IE.","paragraph_zero_based":4843},{"literal_text_all_w_t_and_m_t":"sdap-Config","paragraph_zero_based":4844},{"literal_text_all_w_t_and_m_t":"The SDAP configuration determines how to map QoS flows to DRBs when NR or E-UTRA connects to the 5GC and presence/absence of UL/DL SDAP headers.","paragraph_zero_based":4845},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4846},{"literal_text_all_w_t_and_m_t":"RadioBearerConfig field descriptions","paragraph_zero_based":4847}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["84fe1fa272fb3175e3afdddfaa641f6e8bcd967092ba6a9f636e3aa1b761ab1e","8728a502b64b4ed476e438a99da0169542319a882547f73af0206b2a5de384fc","1ddc6605bd60dd43407ec30efd6995da26a3d84b9c27cf6e8346c3358a9e015f","175b211c69e8fb7499c19d80b96c8e474f58a3fd3dd7c42d20ab7e88f1f374e8","aa085d3aa12a007190d5e47970d6f170786d40eda2d879a357a59dcc7fe86ad6","8ae4647b1b8d1a6dc1457026e76e6e9448cff7e0e9e25fe0e74bc382b250caf6","dcf7bb238d12959d23dd280efea09760c78480ee7a84b0da32d8498d04bee74c","fea08c2f0ff459acd249367c00b4b4af5c63f9ddd103367ba6f26243058bf486","7c0cba89d635d6f0a083c64c5c41d10eec12bca5d2d5afc3c904525021a10e9e","12d2302512c6d4a73c1992952a4e1da6cb0d12bca568d8f1ea4c3f33f9e314b4","a8e3744936a7ea46088aedbf72c8b9a690c86216ca44627bc3906eb787d0a848","1a75e748137cebc44f6e75c437d9e5b1bcd0901447e0a2faf077af3ef13f5d54","0b3d09048d26df7cc269886bb26144bcf93ff8bd94edd3832ebe0fc15d31f780","0ede738dae659d2cf91bdc7823274c7114a8d1f186b3131d1db66aee2a6bd335","5a9048e6be44836c495a21d8c0b94004e357735a42babe473ee3ea2daea3cc88","736bbbd6dbb6ee0f9d756bc5a109d608b14d778113aebc6e82741d3a52a09096","a45e96e9fbd9ae50f0feda13283f49a031673a95a784ba327a9ae3711d79164f","f9cbae6b7147fe42108604637e1a15e53d7fa196870cd8397b6446d2b609f9a9","a141c8c6a7764038c9edfc6e30a90193726ef841b4bd3e46b79c75edf74fb47e","6018924f8e758a0215c01e5da5661c1a85f8297c6c9deabb2bf3391dbb4a955b","51cd66b3b7bfaa3db7b584d57e248013600267c2bfe4fc61c7c19b8a67a8dd27","ccb68338ca70130595d997ee609c99f3714bcc93ff8f1d9c32b8e8bfd49815b9","69cdfa25679b7f9635d4b99b57aca12f0a087c70e04a58f5ef317e5662cabeb0","49a6a9edaae6a1a4611ee2bd5285aed4a7d28c721cfdac07993096ed7967ca26"],"paragraph_range_zero_based":[4824,4847],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p4824"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"securityConfig","paragraph_zero_based":4848},{"literal_text_all_w_t_and_m_t":"Indicates the security algorithm and key to use for the signalling and data radio bearers configured with the list in this IE RadioBearerConfig. When the field is not included after AS security has been activated, the UE shall continue to use the currently configured keyToUse and security algorithm for the radio bearers reconfigured with the lists in this IE RadioBearerConfig. The field is not included when configuring SRB1 before AS security is activated.","paragraph_zero_based":4849},{"literal_text_all_w_t_and_m_t":"srb3-ToRelease","paragraph_zero_based":4850},{"literal_text_all_w_t_and_m_t":"Release SRB3. SRB3 release can only be done over SRB1 and only at SCG release and reconfiguration with sync.","paragraph_zero_based":4851},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4852},{"literal_text_all_w_t_and_m_t":"SecurityConfig field descriptions","paragraph_zero_based":4853},{"literal_text_all_w_t_and_m_t":"keyToUse","paragraph_zero_based":4854},{"literal_text_all_w_t_and_m_t":"Indicates if the bearers configured with the list in this IE RadioBearerConfig are using the master key or the secondary key for deriving ciphering and/or integrity protection keys. For MR-DC, network should not configure SRB1 and SRB2 with secondary key and SRB3 with the master key. When the field is not included, the UE shall continue to use the currently configured keyToUse for the radio bearers reconfigured with the lists in this IE RadioBearerConfig.","paragraph_zero_based":4855},{"literal_text_all_w_t_and_m_t":"securityAlgorithmConfig","paragraph_zero_based":4856},{"literal_text_all_w_t_and_m_t":"Indicates the security algorithm for the signalling and data radio bearers configured with the list in this IE RadioBearerConfig. When the field is not included, the UE shall continue to use the currently configured security algorithm for the radio bearers reconfigured with the lists in this IE RadioBearerConfig.","paragraph_zero_based":4857},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4858},{"literal_text_all_w_t_and_m_t":"SRB-ToAddMod field descriptions","paragraph_zero_based":4859},{"literal_text_all_w_t_and_m_t":"discardOnPDCP","paragraph_zero_based":4860},{"literal_text_all_w_t_and_m_t":"Indicates that PDCP should discard stored SDU and PDU according to TS 38.323 [5]. Network doesn't include this field if the RadioBearerConfig IE is part of an RRCReconfiguration message associated with subsequent CPAC within the ConditionalReconfiguration IE which is received within a MCG RRCReconfiguration message via SRB1, or if the RadioBearerConfig IE is part of an RRCReconfiguration message within the LTM-Config IE which includes the field ltm-NoSecurityChangeID or ltm-NoResetID.","paragraph_zero_based":4861},{"literal_text_all_w_t_and_m_t":"reestablishPDCP","paragraph_zero_based":4862},{"literal_text_all_w_t_and_m_t":"Indicates that PDCP should be re-established. Network sets this to true whenever the security key used for this radio bearer changes. Key change could for example be due to reconfiguration with sync, for SRB2 when resuming an RRC connection, or at the first reconfiguration after RRC connection reestablishment in NR. For SRB1, when resuming an RRC connection, or at the first reconfiguration after RRC connection reestablishment in NR, the network does not set this field to true. For LTE SRBs using NR PDCP, it could be for handover, RRC connection reestablishment or resume. Network doesn't include this field if any DAPS bearer is configured or if the RadioBearerConfig IE is part of an RRCReconfiguration message within the LTM-Config IE. For SRB3, network doesn't include this field if the RadioBearerConfig IE is part of an RRCReconfiguration message associated with subsequent CPAC within the ConditionalReconfiguration IE.","paragraph_zero_based":4863},{"literal_text_all_w_t_and_m_t":"srb-Identity, srb-Identity-v1700, srb-Identity-v1800, srb-Identity-v1900","paragraph_zero_based":4864},{"literal_text_all_w_t_and_m_t":"Value 1 is applicable for SRB1 only. Value 2 is applicable for SRB2 only. Value 3 is applicable for SRB3 only. Value 4 is applicable for SRB4 only. Value 5 is applicable for SRB5 only. Value 6 is applicable for SRB6 only. If srb-Identity-v1700, srb-Identity-v1800 or srb-Identity-v1900 is received for an SRB, the UE shall ignore srb-Identity (i.e. without suffix) for this SRB.","paragraph_zero_based":4865},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4866},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":4867},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":4868},{"literal_text_all_w_t_and_m_t":"RBTermChange","paragraph_zero_based":4869},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in case of:","paragraph_zero_based":4870},{"literal_text_all_w_t_and_m_t":"-set up of signalling and data radio bearer,","paragraph_zero_based":4871}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["ae4426e9011df5b856d3a5f44c9c64f576a044c96430b15b99799f84e88622ca","6b097ff65aa716ca6bd5e26bc8feee6a8f3ef1ae046d5a48f1b46c75b307bff1","8738259477b5c3734440c9511d688f6d83aab25c3910a6b68e92d1e970335298","07f657da74e17d192eed56f80a7aaab970d10bba1e0c00cf5db2c5199eea13d1","1595b85e6f5398b5f9e0c23b95cd6978646c821d929ecc79f3ac846ce9103a36","65b48f86d083ced4a52c3246ac149189483d7618ae3137b52759bc857d305629","739976e6d89aa1a8ea0573ecc0248341f54e3c5e556387bd3c06e6e9a8180f36","2f682e5eeec347aa65aebbd2c6e2fea64a97357ae42a8dfc8a0261ce1762455a","4f970046a80e3a550445a1b73f7eeb2a9397a835f9429acab3d8bd38dc8bde09","9a0b5c0d20263d4502850603f8cdaecaaf313371199492f16135f9d61a41bd4b","bb00f6e89a3224a6868abc854cb566fecc9a39a4b17c0011e9489c47fd9180ef","abc47e5c1659768ba367896482510d2051941477abbd3154e80e3207da3f1156","45c0395fc67defa6d4e489a7d139787d8b3f98aada37cc749383b6c85655b6a3","bde1b6b3c18fc288b731f0089eddc0a345577653882e70f9d4334eda281fb38c","65f21809de6d700533b950c4d7edcce5e69a3d92432c82ff8753c263157f9af9","15050b2ec7ab9c730625aaf7e77a4cf9ae035745f36ce6a876200af044601238","0fe8882bad13ae1b2589eaf11714e7bab959c262e06eed8fddd6b0754024c3cc","fd2dc09bd5f2767bee665c0df22b68646c07e9edfff780effc8cc1d2bd7c2cb9","6439f85c8f8b7c2af673a025ab00e752592732a08b38ecc4f025b5c70fbe069b","73526d09f6c28901f667512844ef7c93aa9a77feba66b3896b6e8a6a32e4fb3f","57794cfea107b922f3e341c05e95005b179647c8febe5fb65b2b55a64c8797be","aba9c5566b440eeef2738debce5eca0a942274b40b402721e1911a0a564ac681","86721271eca7cb4a7fb0c220d1e2c210fcdac0a2ad60dcbe3a6c13d4be92786b","7127825874143374401bf330455b129421b34b47ac6fb3240d8741b5ef7a16c3"],"paragraph_range_zero_based":[4848,4871],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p4848"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-change of termination point for the radio bearer between MN and SN.","paragraph_zero_based":4872},{"literal_text_all_w_t_and_m_t":"It is optionally present otherwise, Need S.","paragraph_zero_based":4873},{"literal_text_all_w_t_and_m_t":"RBTermChange1","paragraph_zero_based":4874},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in case of:","paragraph_zero_based":4875},{"literal_text_all_w_t_and_m_t":"-set up of signalling and data radio bearer,","paragraph_zero_based":4876},{"literal_text_all_w_t_and_m_t":"-change of termination point for the radio bearer between MN and SN,","paragraph_zero_based":4877},{"literal_text_all_w_t_and_m_t":"-handover from E-UTRA/EPC or E-UTRA/5GC to NR,","paragraph_zero_based":4878},{"literal_text_all_w_t_and_m_t":"-handover from NR or E-UTRA/EPC to E-UTRA/5GC if the UE supports NGEN-DC.","paragraph_zero_based":4879},{"literal_text_all_w_t_and_m_t":"It is optionally present otherwise, Need S.","paragraph_zero_based":4880},{"literal_text_all_w_t_and_m_t":"PDCP","paragraph_zero_based":4881},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the corresponding DRB/multicast MRB is being setup or corresponding DRB/multicast MRB is reconfigured with NR PDCP or corresponding SRB associated with two RLC entities is being setup or if the number of RLC bearers associated with the DRB/multicast MRB or SRB is changed. The field is optionally present, Need S, if the corresponding SRB associated with one RLC entity is being setup or corresponding SRB is reconfigured with NR PDCP; otherwise the field is optionally present, need M.","paragraph_zero_based":4882},{"literal_text_all_w_t_and_m_t":"DRBSetup","paragraph_zero_based":4883},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the corresponding DRB is being setup; otherwise the field is optionally present, need M.","paragraph_zero_based":4884},{"literal_text_all_w_t_and_m_t":"HO-Conn","paragraph_zero_based":4885},{"literal_text_all_w_t_and_m_t":"The field is mandatory present","paragraph_zero_based":4886},{"literal_text_all_w_t_and_m_t":"-in case of inter-system handover from E-UTRA/EPC to E-UTRA/5GC or NR,","paragraph_zero_based":4887},{"literal_text_all_w_t_and_m_t":"-or when the fullConfig is included in the RRCReconfiguration message and NE-DC/NR-DC is not configured,","paragraph_zero_based":4888},{"literal_text_all_w_t_and_m_t":"-or in case of RRCSetup.","paragraph_zero_based":4889},{"literal_text_all_w_t_and_m_t":"Otherwise the field is optionally present, need N.","paragraph_zero_based":4890},{"literal_text_all_w_t_and_m_t":"Upon RRCSetup, only SRB1 can be present.","paragraph_zero_based":4891},{"literal_text_all_w_t_and_m_t":"HO-toNR","paragraph_zero_based":4892},{"literal_text_all_w_t_and_m_t":"If mrb-ToAddModList is not included, the field is mandatory present for UEs other than NCR-MT","paragraph_zero_based":4893},{"literal_text_all_w_t_and_m_t":"-in case of inter-system handover from E-UTRA/EPC to E-UTRA/5GC or NR,","paragraph_zero_based":4894},{"literal_text_all_w_t_and_m_t":"-or when the fullConfig is included in the RRCReconfiguration message and NE-DC/NR-DC is not configured.","paragraph_zero_based":4895}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["f7956b7480103e593c95ca7e27508d4ef731168b53c8f9d98e3bc588954ba258","e195363b84055fb2b6053804c34e767aff684a22f3ce107b7a7e427da2b9db9a","7e983d0d499f229be8cbf83e62556eef78e5b139328124b3c51aaa9e44db19b2","208311e7eb8ebfe3aff4626499a6b95b9216e5b0ac2e7bb19cb2306305d5c8f9","d1f333a84568f84059d50a972ca5f6eafacc25fa0ea760ddad791eea0d216a24","8a1a8b8da455599339e1529dc42ef615b80b48ebc3ef1f5b8640c856e6d2fc40","269d8b579b8a979dd41d30ddd9894ac2267ff88bd7e2408ae8081bb26838a68f","475a2f526d4f23af7ca317896639b1a0e0a881aea1cc236b8d98ab6685d1580d","ed0092f3b0d60d9994a39df6036fb6b38b3d93799c53ac4172655511ad5a4586","65c315271ff448e4be5177c1e74f8ba39965462925bffc07b89343333dfcaf02","19619e270d5abbccfb70126f41a1ea4bbe24510d806d087d014ce8c115776b37","c7b0557802788807484f56678237e6950e2acf45da987ad79d17d37910a8b03c","2e79de8a8a4095f9ec49084087eedf6645564a4f7eb1b8dbecb055cf613ba784","ed98eb96712f1e0f515c719885002de3f49e8b3d2810d587d2a81ad119797cfa","497830476aa6f78c7c6abfbea954fb0799d233e9cffaffe0db9a0a5f9f7206ec","c06fdc84bcb5db4cc83de483ab3c7966aa411115f94ed6e9747b287f2ff51e53","47ac1874a0352384a259286425186590c8e671fae8da9ceabfab3e40466ff980","bb48ee75ae89e9f6e00b97d8364af890977ceda83e322d285eb3dff8b730792b","5953c795a92a6a710004a38e19ae8c7d577dba16309ce22b63ed6ddb62f9067f","848594f7e7b4f141045660696a79f48fbbfdd5b58b545c5305bc53ca895c3380","de57eb77a42a4d4dddbe1a09ec44568955efcb1a9ea8f3e45b464f0eb946534c","b3e2c0864be8c70402f12948c470a270e319ab30ec94ea04231a09d8fe6cb0a9","00796897ce8753f1d7e506d273ff41ad2fad448f32e199223f834ebc1fddd91e","b8abecf72cc98b9ccf7554725088e1151b757ddc51b1d1592376ca09c4b1881e"],"paragraph_range_zero_based":[4872,4895],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p4872"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"In case of RRCSetup, the field is absent; otherwise the field is optionally present, need N.","paragraph_zero_based":4896},{"literal_text_all_w_t_and_m_t":"DAPS","paragraph_zero_based":4897},{"literal_text_all_w_t_and_m_t":"The field is optionally present, need N, in case masterCellGroup includes ReconfigurationWithSync, SCell(s) and SCG are  not configured, multi-DCI/single-DCI based multi-TRP are not configured in any DL BWP, supplementaryUplink is not configured, ethernetHeaderCompression is not configured for the DRB, conditionalReconfiguration is not configured, and NR sidelink and V2X sidelink are not configured. Otherwise the field is absent.","paragraph_zero_based":4898},{"literal_text_all_w_t_and_m_t":"MRBSetup","paragraph_zero_based":4899},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the corresponding multicast MRB is being setup; otherwise the field is optionally present, need M.","paragraph_zero_based":4900},{"literal_text_all_w_t_and_m_t":"N3C MP","paragraph_zero_based":4901},{"literal_text_all_w_t_and_m_t":"The field is optionally present if the corresponding radio bearer is being setup for MP with N3C indirect path, need R. It is absent otherwise.","paragraph_zero_based":4902},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4903},{"literal_text_all_w_t_and_m_t":"<Text Omitted>","paragraph_zero_based":4904},{"literal_text_all_w_t_and_m_t":"–RLC-BearerConfig","paragraph_zero_based":4905},{"literal_text_all_w_t_and_m_t":"The IE RLC-BearerConfig is used to configure an RLC entity, a corresponding logical channel in MAC and the linking to a PDCP entity (served radio bearer).","paragraph_zero_based":4906},{"literal_text_all_w_t_and_m_t":"RLC-BearerConfig information element","paragraph_zero_based":4907},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":4908},{"literal_text_all_w_t_and_m_t":"-- TAG-RLC-BEARERCONFIG-START","paragraph_zero_based":4909},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4910},{"literal_text_all_w_t_and_m_t":"RLC-BearerConfig ::=                        SEQUENCE {","paragraph_zero_based":4911},{"literal_text_all_w_t_and_m_t":"    logicalChannelIdentity                      LogicalChannelIdentity,","paragraph_zero_based":4912},{"literal_text_all_w_t_and_m_t":"    servedRadioBearer                           CHOICE {","paragraph_zero_based":4913},{"literal_text_all_w_t_and_m_t":"        srb-Identity                                SRB-Identity,","paragraph_zero_based":4914},{"literal_text_all_w_t_and_m_t":"        drb-Identity                                DRB-Identity","paragraph_zero_based":4915},{"literal_text_all_w_t_and_m_t":"    }                                                                                               OPTIONAL,   -- Cond LCH-SetupOnly","paragraph_zero_based":4916},{"literal_text_all_w_t_and_m_t":"    reestablishRLC                              ENUMERATED {true}                                   OPTIONAL,   -- Need N","paragraph_zero_based":4917},{"literal_text_all_w_t_and_m_t":"    rlc-Config                                  RLC-Config                                          OPTIONAL,   -- Cond LCH-Setup","paragraph_zero_based":4918},{"literal_text_all_w_t_and_m_t":"    mac-LogicalChannelConfig                    LogicalChannelConfig                                OPTIONAL,   -- Cond LCH-Setup","paragraph_zero_based":4919}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["f9c6dfa41ff0f5c6e117