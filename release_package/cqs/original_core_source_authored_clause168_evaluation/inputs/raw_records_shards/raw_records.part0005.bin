{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ElapsedTimeSCG-Failure-r18 ::= INTEGER (0..1023)","paragraph_zero_based":3624},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3625},{"literal_text_all_w_t_and_m_t":"TimeSinceSHR-r18 ::= INTEGER (0..172800)","paragraph_zero_based":3626},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3627},{"literal_text_all_w_t_and_m_t":"TimeSinceSdt-Execution-r19 ::= INTEGER (0..172800)","paragraph_zero_based":3628},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3629},{"literal_text_all_w_t_and_m_t":"-- TAG-UEINFORMATIONRESPONSE-STOP","paragraph_zero_based":3630},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":3631},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3632},{"literal_text_all_w_t_and_m_t":"UEInformationResponse-IEs field descriptions","paragraph_zero_based":3633},{"literal_text_all_w_t_and_m_t":"coarseLocationInfo","paragraph_zero_based":3634},{"literal_text_all_w_t_and_m_t":"Parameter type Ellipsoid-Point defined in TS 37.355 [49]. The first/leftmost bit of the first octet contains the most significant bit. The least significant bits of degreesLatitude and degreesLongitude are set to 0 to meet the accuracy requirement corresponds to a granularity of approximately 2 km.","paragraph_zero_based":3635},{"literal_text_all_w_t_and_m_t":"It is up to UE implementation how many LSBs are set to 0 to meet the accuracy requirement.","paragraph_zero_based":3636},{"literal_text_all_w_t_and_m_t":"connEstFailReport","paragraph_zero_based":3637},{"literal_text_all_w_t_and_m_t":"This field is used to provide connection establishment failure or connection resume failure information.","paragraph_zero_based":3638},{"literal_text_all_w_t_and_m_t":"connEstFailReportList","paragraph_zero_based":3639},{"literal_text_all_w_t_and_m_t":"This field is used to provide the list of connEstFailReport that are stored by the UE for the past up to maxCEFReport-r17.","paragraph_zero_based":3640},{"literal_text_all_w_t_and_m_t":"csi-LogMeasReport","paragraph_zero_based":3641},{"literal_text_all_w_t_and_m_t":"This field is used to provide the logged measurement results for network-side data collection, stored by the UE in accordance with the CSI-LoggedMeasurementConfig.","paragraph_zero_based":3642},{"literal_text_all_w_t_and_m_t":"flightPathInfoReport","paragraph_zero_based":3643},{"literal_text_all_w_t_and_m_t":"This field is used to provide the flight path information as list of waypoints and, if available, corresponding timestamps. List of size zero indicates the previously provided flight path information is no longer valid.","paragraph_zero_based":3644},{"literal_text_all_w_t_and_m_t":"logMeasReport","paragraph_zero_based":3645},{"literal_text_all_w_t_and_m_t":"This field is used to provide the measurement results stored by the UE associated to logged MDT. ","paragraph_zero_based":3646},{"literal_text_all_w_t_and_m_t":"measResultIdleEUTRA","paragraph_zero_based":3647}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["6ed7ae30bf6dc61ad4d7c3577ee31fb379f21fd736889fd694f5d8fa7833b5c1","356c6fe4ad650b9f5f7a04a49652a8a324d90e4b455d74552de9ee6146534a59","3185a071be38c44b834be6e406995512ccd78e0d78888f063c78c39773e45732","e0a11be21dd0e082f444634f6766d7ca51dc8e8c5e87cbd6dc2008d9e4a26c62","b84aaeb60b4c097dc6abe9fb9a006d496a5f7a299a07dcf9ab69e5a4b7cd5a4f","f9d3b3a7e2611f821b40e9e279713e9e5257ad468684377ead10797f0a53e45a","bc9771806f44685a9a0fb43d11ab40727147d4600ee1e3dc4911568170af30c4","492466b1