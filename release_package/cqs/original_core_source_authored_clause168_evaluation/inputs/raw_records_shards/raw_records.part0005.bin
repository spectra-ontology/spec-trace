m_t":"    reportConfigId                          CSI-ReportConfigId,","paragraph_zero_based":138},{"literal_text_all_w_t_and_m_t":"    carrier                                 ServCellIndex                   OPTIONAL,   -- Need S","paragraph_zero_based":139},{"literal_text_all_w_t_and_m_t":"    resourcesForChannelMeasurement          CSI-ResourceConfigId,","paragraph_zero_based":140},{"literal_text_all_w_t_and_m_t":"    csi-IM-ResourcesForInterference         CSI-ResourceConfigId            OPTIONAL,   -- Need R","paragraph_zero_based":141},{"literal_text_all_w_t_and_m_t":"    nzp-CSI-RS-ResourcesForInterference     CSI-ResourceConfigId            OPTIONAL,   -- Need R","paragraph_zero_based":142},{"literal_text_all_w_t_and_m_t":"    reportConfigType                        CHOICE {","paragraph_zero_based":143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"cf905337742c9f19496d5c85a2bc3ca156a35a8b1e77067904260ae404f7b0e1","original_member_sha256":"ec23412413a4460feb833f742d1419bbd28ea8915314355a29d962fd6d7655ac","paragraph_ElementTree_utf8_XML_sha256":["a01976ce62d9598ed727aa6227bab6ee108ce253e07e727aa2c79430931ce34c","f865cecc8ecc33ec1989c7235fb71317b1fb7a83d0665b1cec11fd89484c42c6","b0af2396d0969c116aa18a72372c2466db9eff6e76f9c2c6d0f96dd98dd874d9","801a5ba00b1b25b7e5c3b67df1f42e6f36c0576f8dca0f8bf3e89e9f2bc4cb0d","3abf576389b1d6a77f10576f272170081af4aefa3b447258aee890d85f014703","06bb06e8bc8736175235987553af0b8a0ce7839a2052809626445a9c0a86ec7f","5062d50dcb3cdff73d5e3e2851d155cbb923f290bc7510308328cbc53f973d61","c7d75ae879615aa89e4c700820c2b14fa1c559b9c743959237011856e18c8556","3f400fa358109958d8fb1e6ac09f492005bcea32146797a7311ceeb70fca687c","ff7d5b07568582c263fffa9ad1152bfbf5c894d4860007a6537d47c26304e501","98c83ccc7930a7b1ae76a16859a63fdd8ea59d7e1b3cea07ad2948327275538d","a06da65a1748192819cfc122e7faa055a223375691d101c2f596878e56d9a6fc","f13de68562bff72a6bea