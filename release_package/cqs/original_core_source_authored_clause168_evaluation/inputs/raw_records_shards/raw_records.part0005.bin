"original_member_sha256":"b6e2f6b9b9a49c6e03bb802fbf01fa6ee28f44f95781fdac844951b2e4b263a7","paragraph_ElementTree_utf8_XML_sha256":["ca2fcf2cb5997814a1e8b570fc2c644a7894709a884867d7b66370b844295473","4328dbc2e9ed59984edad9da9f918a037222a8bc1d4a7f801e449d0bf4e71fd0","1b57abbb250ccf0e7dbcfaad8666dd22e39df29408dc1d6e61b3298df1a31533","dca27312d7a1517d19ed558671871fab25e9b549c607883b97a78f9f3628f08a","6d3fba1314de1001e3753ed4f16b9c74cdf0271805f61b17dcc5b42bd590842f","617785343afc34ff86d7085e070e5171c849cf65b766df069d11ae4921b43535","2330ff89f9b8d7efcc06269e0fa7e2f3862b5c7c6ee22e22ca96b4d01090416d","cb9646e53a961acadd8b9d1cbe9977f71385aded0c0dd84e225defb7e8545ad8","e434e65a10e838afc9f35a37c5efebc215fd9aedc21692d7cc12941674744e85","48f27d1f338f2e6cabf1ff384625f9d1a5e67ab8190bf0af224f5e9fd5a2044d","592e5e04942980dfd0387a6cc506d429284d600309dadaa9155fba77861ddf2c","731cd85286f824ffc8ab15b3e076faaf16231b040ec58d5b982eb0b04411f518","a21152b0380040012646945f93e55834d32920bf3e66b43cd272597b6f5b9505","15446e336e26f8e8542354aaa67cefc1b9b0d8b4af76558f1b7e96594ab3e72b","032e9f858d3d59ab048f1c6847f25e5b233bb6ba0c88c96eee40690f328745ca","1ac810a1cab11c95a1df934fbe11d17d0c7b90f828c877e62a98a07ed58b7dfa","20d13325f0d1ab169d56437b12adadf0ff10f3c41bc484875bfe62e7ee95051d","b3f8ba76ec829a0eac6003bc8cbccaed17d41a62756dd1214cc8a7fa8c87c76d","ebb18e058d1fac3e0efc9941e530e6c9327f91af82e47a50969e70a111afea2a","16fd2bbf6f4a4c07307cd81891fb917653b0a540f463c6653da50b26a894a6fe","dcb00a9e6c6c316c0088d2dc5f1b8ad2617b4424352762cd9029642ce44b55be","adf91afec1ef44a2388772bd7103ea6e4f36004e933a3b58dc00af5209fde022","500ae1e95311986e752b9be027e0c22a78d267c2f0de2c686523828721158b14","1cef444d894cdacbe559bb45e53c3b2ef7f77da82c45f0f24d784d4541645307"],"paragraph_range_zero_based":[24,47],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2410826.zip::R2-2410826 MAC.docx:p24"}
{"fields":{"filename":"R2-2410826.zip::R2-2410826 MAC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"A","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Rel-18","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-17(Release 17)Rel-18(Release 18)Rel-19(Release 19) Rel-20(Release 20)","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":"Reason for change:","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"There are two types of SRS transmission. MAC specification states below in ","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"NOTE 2:In this version of the specification, the SRS in the procedural description includes Positioning SRS except for the Positioning SRS for transmission in RRC_INACTIVE as in clause 5.26. Positioning SRS except for the Positioning SRS for transmission in RRC_INACTIVE is treated the same as SRS by the UE unless explicitly stated otherwise.","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"In section 5.2, in one of the clauses, the correct SRS type is not used. It should be only Positioning SRS that should have been mentioned rather than the generic SRS (which also is applicable for communication/MIMO); i.e instead of “SRS” it should be “Positioning SRS”. Hence, a correction is needed to specify the correct SRS type.","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"One of the clause of section 5.2 has been updated to specify Correct SRS type.","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"475d0bd37e37b8aa508fe73eee1a8fb22927094fb103de8fe516608b9cb06d0a","original_member_sha256":"b6e2f6b9b9a49c6e03bb802fbf01fa6ee28f44f95781fdac844951b2e4b263a7","paragraph_ElementTree_utf8_XML_sha256":["e4ea5591218aa96d0cd407936b651eb165fb4c75e229dab64ec9de6be991cb96","2d00e3b1a82065155328ddd802c3d4a8ebff11f4a0d6da9ecf9b1e34dc8ebfc8","d0610b79862bd535cc60e3c2a7f05732e9f9933627bd09904cf70b06892e33a3","761fa4d36b282591b5f5bb5ee554c6086f6eb9d5925f257d405f142f9e3a17e1","9ee3a8ef1b4d8b5d23ae68c79878f83d9a7ffdf02ec93cff53f7b1de6029f4d6","1b2da244350e9a53399f9d92bc8336f257051101444f26970461d2b0ed988d98","b08252b53f111fda758564f01d6aeb287a86ceee9730eba0ca5fcf7c7dadb00e","5397ebe3cc2afa3393b897343a62f60e5b485315d8236802a715ec930f5cc336","275fd5f28330e81a71bc0f424bdb9e870b94721e1fbac96c6b96ce5232317404","dd3de490bf00baf5087f33777fa272abbec9623033d71526d5355fb97ee7f36f","16c8d70f7d429c511b56c375317337c5d5c75b5a185ec91bf088b77069963fb7","acd6206245de4b9556a4853ff1b8b41875944834aa76df6c7d72af763f365262","3c4c80e1e11044a4d07c2d065ab1badcf74a3b84af6435503a27154aade28f9b","e0fadd7e30149bb16e20ddcd07acb1e69eb5ae76f9bdc1f5716a1c0c9b6138ce","d456b6f3b6cea468289a5d16767c79d4da73edde356a3295f6280bfecc8c5b01","bda3ae7cec715dcc1cb2b118aa52b9ba2b3e4e90a28cde13337aa57fa5ca335e","6f46f148aae46726357ea7e16233e9747a95d35cfc7c8b1474fb525283766520","16fef168ca629a0b2e24059e1406d5187085f415e97cf255a124bf328e72969d","d463755adf146dd3919aea3dbef4a3d95c1d4854b7ddd27190fd7dbb8bfade08","50d82f2e9d54a9ad110e7cc68a701bf50368fec17453ca11019b11142d59bc72","8b24573e0133d1c5ee95e1377545628b16380b4d3d980bde5296376e8173041e","7423559940944ed0cc1fe176b76253cf9035dcdbfc0fac2f3e385feb311a2329","288cc60197c635a28716a1c3a9133085106b36b1009fb0a2849670c1b99dfd9f","1be7fd74bd97cb4d5349860ed9b7dfba86f56a04b555a65ac89abfb54da82a4f"],"paragraph_range_zero_based":[48,71],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2410826.zip::R2-2410826 MAC.docx:p48"}
{"fields":{"filename":"R2-2410826.zip::R2-2410826 MAC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":72},{"literal_text_all_w_t_and_m_t":"Impact Analysis","paragraph_zero_based":73},{"literal_text_all_w_t_and_m_t":"Impacted 5G architecture options: NR SA ","paragraph_zero_based":74},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":75},{"literal_text_all_w_t_and_m_t":"Impacted functionality:","paragraph_zero_based":76},{"literal_text_all_w_t_and_m_t":"Positioning SRS transmission in RRC_INACTIVE","paragraph_zero_based":77},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":78},{"literal_text_all_w_t_and_m_t":"Inter-operability:","paragraph_zero_based":79},{"literal_text_all_w_t_and_m_t":"If the UE implements as per the CR and NW does not, no inter-operability is foreseen. ","paragraph_zero_based":80},{"literal_text_all_w_t_and_m_t":"If the NW implements as per the CR and UE does not, UE may consider that SRS for MIMO is applicable for RRC_INACTIVE mode.","paragraph_zero_based":81},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":82},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":83},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":84},{"literal_text_all_w_t_and_m_t":"Error in Specification, incorrect applicable SRS type. It may be mis-understood that SRS for MIMO is applicable also for RRC_INACTIVE mode.","paragraph_zero_based":85},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":86},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":87},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":88},{"literal_text_all_w_t_and_m_t":"5.2","paragraph_zero_based":89},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":90},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":91},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":92},{"literal_text_all_w_t_and_m_t":"Y","paragraph_zero_based":93},{"literal_text_all_w_t_and_m_t":"N","paragraph_zero_based":94},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":95}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"475d0bd37e37b8aa508fe73eee1a8fb22927094fb103de8fe516608b9cb06d0a","original_member_sha256":"b6e2f6b9b9a49c6e03bb802fbf01fa6ee28f44f95781fdac844951b2e4b263a7","paragraph_ElementTree_utf8_XML_sha256":["75dcdc1b8ea44a3aec84464530349fe66bcc58799f9d3da9a397e67b1cc6c33f","92e3d1d951ae23bf70226e0043888a9e8bc7dd4d93dc5c4b4ead8574088f4acb","292fd3ad04a1afded21870f015c5d2f4b832f106007c1c300dae593b7090a11c","d71d6c557bfad0ccd167a67e5b823affa26b5cc05b425ea8b3e8dea617638f0d","b564daa19f9e478b97c1d0c7d5945160b283192f1d70d4d923ff3ebb22430714","d0288c6a510c3bce80db2f269add9aa0e9e8dec955949f79315213b436ccd36b","95a6fcc8cf273c214df0022d5d2fb8f50b12530110738ee739f1928f93f63ad5","dfab861ea11cd808a678a0fb4a2be5981c4427ed0a6d86ef57f370fa6cff34ff","5895a8f11889abba4dd7b31aaf8ac0704c44952566ba320da19a0f11b7bcf0e2","bf23d9919e6b1e14b72a060a1bde68c7465e687971974edb5b491e7845d1ae12","23da18bbbcbc650fad7a07ef8006251a7a06ae59113986d1a2b8d37f6d71a8d1","85f9fe225bf206da5b28016fbb39c62cb1368eb1244f4f20547ea6629294dc69","08f94db90f5dbae40edb3e287739c0b258707aecf5e395e8445fb7cae8ac7829","57b30c38bdebb92a515a0f9b371800c54e7c3600ce6238ac2767810c4fa3bde7","d3098623b4dfc23a1a4b383cc6c305d01a4c1c56ac54d5853c2f6542bbe0ad3e","d88bc81b05cdcb5373fcefe52e78f5e5b7ea4e37e19c0d9ebb00bb2abbe8ad2d","61cf31ccb32ca743f815831546a63f3d4f37ea5f4ff7e02e623d0e686dc91277","2170821d9ad37bf484e71289d0deab563826a0027cd909a06759b0083132305d","d3262b1816fab55992cffb02c05a6ffa91b6523e243fbbc95fea56d1d4a60b90","c3683d587e9395b4366df402366a37ae834beabe3792a5a1f587771601d39ee1","ed998830d31c45491e1e0440155b1f04906345d5cf11cf124da3b8514b084b6e","906013edb57524be9364140bb342f747d25cd914a658ac9688cc0e1c36c48a