{"fields":{"filename":"R2-2409047.zip::R2-2409047_CR on 38.331 for Correction on PHR for mTRP PUSCH repetition (R18).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"x","paragraph_zero_based":24},{"literal_text_all_w_t_and_m_t":"Core Network","paragraph_zero_based":25},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28},{"literal_text_all_w_t_and_m_t":"Title:","paragraph_zero_based":29},{"literal_text_all_w_t_and_m_t":"Correction on PHR for mTRP PUSCH repetition","paragraph_zero_based":30},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32},{"literal_text_all_w_t_and_m_t":"Source to WG:","paragraph_zero_based":33},{"literal_text_all_w_t_and_m_t":"LG Electronics Inc., MediaTek Inc. ","paragraph_zero_based":34},{"literal_text_all_w_t_and_m_t":"Source to TSG:","paragraph_zero_based":35},{"literal_text_all_w_t_and_m_t":"R2","paragraph_zero_based":36},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38},{"literal_text_all_w_t_and_m_t":"Work item code:","paragraph_zero_based":39},{"literal_text_all_w_t_and_m_t":"NR_feMIMO-Core","paragraph_zero_based":40},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41},{"literal_text_all_w_t_and_m_t":"Date:","paragraph_zero_based":42},{"literal_text_all_w_t_and_m_t":"2024-09-26","paragraph_zero_based":43},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"836bd950afefdfc4eed57a69580ee4941c03f676f9ed02619583caae383356f5","original_member_sha256":"b1f7599853483302b17357913146e6b27699dda322cc03d3686d268cb7352535","paragraph_ElementTree_utf8_XML_sha256":["4767c82065312c06a9b9e29a144519350eb887c26ac4a6576cfbe896a957b0d1","4328dbc2e9ed59984edad9da9f918a037222a8bc1d4a7f801e449d0bf4e71fd0","1b57abbb250ccf0e7dbcfaad8666dd22e39df29408dc1d6e61b3298df1a31533","dca27312d7a1517d19ed558671871fab25e9b549c607883b97a78f9f3628f08a","6d3fba1314de1001e3753ed4f16b9c74cdf0271805f61b17dcc5b42bd590842f","44be01bd476a658f87272a0d946d8e3706cbe0e8f6c9fc00eb0933443277a44f","1103078b5aa983bae61bd4788da807aadf1f4fff5280c5bd0716679642efe2e3","d61cd4fb44cb594f6792c59125ac5c81f6c2a1db63d12d382d4f59dcfa22def1","49970c105469ce28d05a8cc157e0f9c92de9948365985a67bc60b1f0f93eaf9b","6d62ae40ccb62a24f83394a37a53780a5b5a5be61753a65f9acae550d9ea3d7b","c868462ca58ae9c4d9f4fa6336b7ce5bd1786d9eddbcdbd3e33f9ae29c6ca9ed","ff2e6df90b87a433fbc0efd9adb26d384d8592c902d049a0ce04f7840e12851f","3de5f5bdcaa8490ee5307ddb88ed7c81abd5e69cd81b64b2e64ace4298af32a0","3ffbcf769f3d5cb6da0ea4f9b28aef5e785cb3278b05667662340a242fd6fefb","3540481fe6fdc0a01b359a09005bf393fe4c29f55514ebb89eb446c61fcc41a9","ac7171bf84a8d3b1884d90cbbcf1ed485f3e9054052750b0968d09cbd5cc8d3c","afe088aa8c68f3949779a8acdfb473fd44565ce021f6c616c46761b2c720c369","ad54f9707a3eef600f0265e6f674964721640828a39527b7c3822081d58328b4","c15d871c57896ef8a967c83aad86341f9212d87a3b10d0ff4e240e28f6700b7c","8038eadf75a5613514c019b58cc6de488dc4fd452c66068e3233b200c26ec88c","189c2f1e64e9484f912f13417487df11e0d6c64e15c458d09ca01c301d8638f6","d641e27af5231fdd882fec18317a6e6ce6709b9947e468c6406f4726bb4a5dab","8d4c6d72e597d0ee70e07ffc1b51e4dac469180a17d7ac65938eeeb6ec52acd3","4c2a1581093791e565bdab4639380e92c91aad2fba97d6ce7bc75e4ddfb767ed"],"paragraph_range_zero_based":[24,47],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2409047.zip::R2-2409047_CR on 38.331 for Correction on PHR for mTRP PUSCH repetition (R18).docx:p24"}
{"fields":{"filename":"R2-2409047.zip::R2-2409047_CR on 38.331 for Correction on PHR for mTRP PUSCH repetition (R18).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"A","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Rel-18","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-17(Release 17)Rel-18(Release 18)Rel-19(Release 19) Rel-20(Release 20)","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":"Reason for change:","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"1.  Based on RAN1 reply LS (R1-2405619), RAN2 agreed that no Type 3 PH value is reported for a serving cell configured with mTRP PUSCH repetition, if the MAC entity the serving cell belongs to is configured with twoPHRMode.","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"In order to distinguish between UEs already implemented to report Type 3 PH value and UEs implemented to report only Type 1 PH value, a new UE capability is introduced.","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"1. Introduce a new UE capability indicating that UE supports reporting of Type 1 power headroom information only, for the case where the Serving Cell is configured with multiple TRP PUSCH repetition and the MAC entity this Serving Cell belongs to is configured with twoPHRMode.","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"Impact analysis","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"Impacted functionality: FeMIMO.","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"Inter-operability: ","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"836bd950afefdfc4eed57a69580ee4941c03f676f9ed02619583caae383356f5","original_member_sha256":"b1f7599853483302b17357913146e6b27699dda322cc03d3686d268cb7352535","paragraph_ElementTree_utf8_XML_sha256":["9a075258e5e09da372058759a27c1622cf02a01b5b402a0c47ab379974b8e683","37c5aaba77b61560cb389215a53bbaf3d8fe15fe32b69f75c56c6036602749b1","98baff56d0fb1795440b44c94b0226083c2807d0072e29f3230684f1bfda5aa7","7a341206d7bd16c0d0a2d7064606bcba9fdbd4f82d81e7d6557796ed64bee952","cb825ef9a43f84b8054be4725a0f7ec6ed82d85c979ca7482ab804248afac5e5","675cd84eec99a82ad13149dda51b19f371da020dc9cd28610c32bcd07ddb8cbd","93aa63b593b2b4b679244cb8af9cf6bc754e79792c46d254adedaa7f00d0f376","c306acef1042500dc05b0420322e978aa56579f3adc8524e3913fed156a73148","244708ab61a7aa77fd8e6ce3f178f74dad6ec77d4a95475ceb7e23e44c2ea19d","cca1d30e44c542f2f468248cc7cd1b3472904d5d67f1c3c93fb919d1ecbef5c7","3808e67012864fd28e4a48aea178e7b4cca6b1a37d3fe0b5fc8e723309ad5de8","d4b39eeeab34b6725087d990af620108230e2cbb262d6d2405836da5036b10a8","3939aec50d60386af66c5f75c8f471e9c0493d3c6e6489e071c2fd60b06ebfd6","ec8b864fb45abecb40d22c85ba142bb680d078c254bae7a46427e886ac0280f8","7864cb7d19c748b38a9adc1b03e74fe409d6b62ff1ea0bf39513b1ee902ea2d9","70e07f69e22614318b3edb744854bf66cd38f434e19ded9f8f25fa2fdaff99da","c042846b129b523bda48f048641f9d70cdbfd9c43737f5c304730b5e59231fd6","1b02ffd47fb349052cdaa87027eaedb0f2d048064828d9eef96f4ff3817a40dc","c5549ae450bb2126cc1ef6a7833df9edad468e563301402dbc55b6eb72451ed8","8b8bdb0a098ce76ccdd53f5cddc4187b0363aafa613c586f59434c5d58635a24","af08bef2e38f00e9878d4f0dca9b39b35ebeb0f2c272f5aa4b86de29ff52bffa","bd057040524bad48a9a7a64a8f12ad184a79b33c636e52c5fede6d4f6ba4f6d6","e5a6d11cdc918a65c2a2ef35b7ccf079b39d1d57aaf2a2caa874095bf686a5ae","bf275a97ad0d1edbacd9154cfb3be8d7f018ee13b2fac6ac3655990978352474"],"paragraph_range_zero_based":[48,71],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2409047.zip::R2-2409047_CR on 38.331 for Correction on PHR for mTRP PUSCH repetition (R18).docx:p48"}
{"fields":{"filename":"R2-2409047.zip::R2-2409047_CR on 38.331 for Correction on PHR for mTRP PUSCH repetition (R18).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"If the network is implemented according to the CR and the UE is not, the network may not correctly decode Enhanced Multiple Entry PHR for mTRP MAC CE.","paragraph_zero_based":72},{"literal_text_all_w_t_and_m_t":"If the UE is implemented according to the CR and the network is not, the network may not correctly decode Enhanced Muyltiple Entry PHR for mTRP MAC CE.","paragraph_zero_based":73},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":74},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":75},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":76},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":77},{"literal_text_all_w_t_and_m_t":"The UE and the network may have different understanding on whether two Type 1 PH values or one Type 3 HP value is included in Enhanced Multiple Entry PHR for mTRP MAC CE, so there may be a misalignment between the UE and the network.","paragraph_zero_based":78},{"literal_text_all_w_t_and_m_t":"Thus, the network may not decode Enhanced Multiple Entry PHR for mTRP MAC CE correctly.","paragraph_zero_based":79},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":80},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":81},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":82},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":83},{"literal_text_all_w_t_and_m_t":"6.3.3","paragraph_zero_based":84},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":85},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":86},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":87},{"literal_text_all_w_t_and_m_t":"Y","paragraph_zero_based":88},{"literal_text_all_w_t_and_m_t":"N","paragraph_zero_based":89},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":90},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":91},{"literal_text_all_w_t_and_m_t":"Other specs","paragraph_zero_based":92},{"literal_text_all_w_t_and_m_t":"X","paragraph_zero_based":93},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":94},{"literal_text_all_w_t_and_m_t":" Other core specifications","paragraph_zero_based":95}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"836bd950afefdfc4eed57a69580ee4941c03f676f9ed02619583caae383356f5","original_member_sha256":"b1f7599853483302b17357913146e6b27699dda322cc03d3686d268cb7352535","paragraph_ElementTree_utf8_XML_sha256":["14225e8def4f89edc1c26340a030712ec63a8f53d8e9683ae53c285b1eb67c1d","e3f6de30e282d59c03cbb9a3bf59d7e43155afe13f86714c9cd96ec79454cb5a","350e36c9d16cec20395bc17e0759638ffb792ce586466958f1849d377df26930","8f2ea4d99242fc2829858b8c102f095e14027fb0fe44a7a302b777d30f3e6f05","320e950219f513e566d8c20f914ae1f524bbbdddc10a250c0b55bfe8b69c4a22","b19868e36f693fa4c9f6f5a7c66d4d30a6e56ace7afc9c3439b93e21260c32bf","1e5de194c9cdac1e731788e26953066ca215d4a15348f381640225552c180b46","6ab1b6a637fc6647a8fbaa87159581f6142bc309309761fa03d7ddb573c226da","21394f203fa512bb6cd7f23acb6bf8aa498ce7ef214876ed7ad1bf43caa33c92","d7dd22f09a1de451e6f9f1e5f98d479a4db633bfd0fb0545539c7965125cfb1c","d690c79e44fa7f8d8c5c878c57f44765b96bf9261573149f0c60508d5d1b6c67","211014c23deaee0b3bfd231d60aea7f2f5001cd7479c5775525a901ff8eba281","0269de0b18078b6f88815dddb98b24b5c0d3ea7c56ac181b87956e52dc3869d8","e174a13523c352e0cb70d16e0539fab8f0200d793e48d1690e6918fe6add1f7a","47a01ff26ebcc97f838309c6d420beea05f506996356f66ad29adb3bfc76df4f","94bf474c4242a6dca12c7c511cfd1ea1217621d31c2af4ffe5f4a3e71ecdb73c","50c8d57a8c9b6eb05405a227ce19cbe4fe532f4ae938a47a8065f7501825e127","a9543c04dc7991e2c360c8c3563c2a39099ce66fe52faf4a3f1afa4b093b5de3","0396b691867514b1c84de67eac