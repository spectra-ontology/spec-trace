{"fields":{"filename":"R2-2502074.zip::R2-2502074 Introudction of control parameters for on-demand posSIB request for RRC_final.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SRS-PosResourceSetAggBW-CombinationList-r18 ::= SEQUENCE (SIZE(1.. maxNrOfLinkedSRS-PosResSetComb-r18)) OF SRS-PosResourceSetLinkedForAggBW-List-r18","paragraph_zero_based":408},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":409},{"literal_text_all_w_t_and_m_t":"SRS-PosResourceSetLinkedForAggBW-List-r18 ::= SEQUENCE (SIZE(2..maxNrOfLinkedSRS-PosResourceSet-r18)) OF SRS-PosResourceSetLinkedForAggBW-r18","paragraph_zero_based":410},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":411},{"literal_text_all_w_t_and_m_t":"-- TAG-RRCRECONFIGURATION-STOP","paragraph_zero_based":412},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":413},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":414},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":415},{"literal_text_all_w_t_and_m_t":"RRCReconfiguration-IEs field descriptions","paragraph_zero_based":416},{"literal_text_all_w_t_and_m_t":"appLayerMeasConfig","paragraph_zero_based":417},{"literal_text_all_w_t_and_m_t":"This field is used to configure application layer measurements. This field is absent when the UE is configured to operate with shared spectrum channel access or if sl-L2RemoteUE-Config-r17 is configured or not released.","paragraph_zero_based":418},{"literal_text_all_w_t_and_m_t":"bap-Config","paragraph_zero_based":419},{"literal_text_all_w_t_and_m_t":"This field is used to configure the BAP entity for IAB nodes.","paragraph_zero_based":420},{"literal_text_all_w_t_and_m_t":"bap-Address","paragraph_zero_based":421},{"literal_text_all_w_t_and_m_t":"Indicates the BAP address of an IAB-node. The BAP address of an IAB-node cannot be changed once configured for the cell group to the BAP entity.","paragraph_zero_based":422},{"literal_text_all_w_t_and_m_t":"conditionalReconfiguration","paragraph_zero_based":423},{"literal_text_all_w_t_and_m_t":"Configuration of candidate target SpCell(s) and execution condition(s) for conditional handover, conditional PSCell addition or conditional PSCell change. The field is absent if any DAPS bearer is configured, if the sl-L2RemoteUE-Config or sl-L2RelayUE-Config is configured, or if the RRCReconfiguration message is contained within condRRCReconfig. When the masterCellGroup and/or secondaryCellGroup includes ReconfigurationWithSync, if this field is present, it only includes configurations/fields specific to subsequent CPAC. The RRCReconfiguration message contained in DLInformationTransferMRDC cannot contain the field conditionalReconfiguration for conditional PSCell change or for conditional PSCell addition. The network does not include this field in an RRCReconfiguration message contained within a LTM-Config IE.","paragraph_zero_based":424},{"literal_text_all_w_t_and_m_t":"daps-SourceRelease","paragraph_zero_based":425},{"literal_text_all_w_t_and_m_t":"Indicates to UE that the source cell part of DAPS operation is to be stopped and the source cell part of DAPS configuration is to be released.","paragraph_zero_based":426},{"literal_text_all_w_t_and_m_t":"dedicatedNAS-MessageList","paragraph_zero_based":427},{"literal_text_all_w_t_and_m_t":"This field is used to transfer UE specific NAS layer information between the network and the UE. The RRC layer is transparent for each PDU in the list. ","paragraph_zero_based":428},{"literal_text_all_w_t_and_m_t":"dedicatedPagingDelivery","paragraph_zero_based":429},{"literal_text_all_w_t_and_m_t":"This field is used to transfer Paging message for the associated L2 U2N Remote UE to the L2 U2N Relay UE in RRC_CONNECTED.","paragraph_zero_based":430},{"literal_text_all_w_t_and_m_t":"dedicatedPosSysInfoDelivery","paragraph_zero_based":431}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e0c257c70d07100f1ede427a4f65f560f2201057cbf73ef45f430ec77898d451","original_member_sha256":"c33e87983ca56840fbfb3ece9b2b5c25c1e6cd4e9cf14026330d400169e5fdbe","paragraph_ElementTree_utf8_XML_sha256":["373d0bba2277e2eddedfe7c742395e98e3c4cbf18ef007975c4a473e5f09d3bb","caaf4442170daabbd946475603ae78c38f9868de882e8eb43bd73b6794b147a3","ceafc7547b5598336101e3383de95333074d5d89e142198c8d410bf7207b350b","d28d2f7dec57a9f5e1cce6add2d4d98a2b26b62755da4697d7273454fd8d9491","8d0f5e61a51ca7991f3ccb1731dace125ceb1b7a20cf85a2bb14c6cf0eb3c2a9","6910880495566521ff330f4b190fac51c1de30152a05f0d3299477ba34e2c2a1","46fa4ab22ff7b97f365ea55f2e284b5fdc8b02f4ebde9fb7d77d1ddf86768dd9","91bcd32e2226852afeb7a53f858d82429f5165c606b04461934e3e913bfdc145","59a6f5107dcc1b1e6d40825dc1c239107af9a1eb27b9b70d1026504af3283ff9","8b90901c0a195df23b1d46a2f89b04c100598506244c9aeb4717f6e3e4d2a995","7957c5366b2050479a854663c2c1c60adb956756932bd6576e66ea9c403a50e5","40cf029b9073f0d1a21f4b1d8f92df2322a87ce73de9321ec595cf90af15903b","d64a9b238a3aa83dbbb98f7576d8101c21b082f533932aad72dcd522b50d2e22","e6ce32f3142a628af2bbbdb3b81388b68bf953aeeafcf8f19dc998fd7f41aa04","936966a19178c639a374b90b38c8f5fd388a16a540a533d02f1478c1d06353d8","8974693e8a359da20491d964b7b88990bb429c93f6d385668ad8fc8b2878ae50","7fd29eb9720eb203786ffdc40dfa3681d86cb5b7f80c344b64628366402e8341","c63a190dca0a7b2464383a2355b31ee8f0659e43e1d856fde9cd6b1103977a87","1a38b8cb5324067a371cc1f2fbcbf600f88a50306b322d7b918d8a0e5ec8ca86","81c847f7d5bcc156bc0631226b88c0bcf0f27f538e057fb3116ca6e3f542e114","2227c7b66f93854660add73543b05ad8e535839f9a8770c426e5aa80e201e394","50b49e5b41eac39beb32cc9249e3e300569bfc63e1b1697d23e7e71700c752a9","f3cb612f3641019e97f77f763936c249735e3b4b6c8fcac7eff91afcadb50e3e","f308f63eb00361d07905e8519336d40ae6e2b0c58ce0ceacd512575b1cdc93e4"],"paragraph_range_zero_based":[408,431],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2502074.zip::R2-2502074 Introudction of control parameters for on-demand posSIB request for RRC_final.docx:p408"}
{"fields":{"filename":"R2-2502074.zip::R2-2502074 Introudction of control parameters for on-demand posSIB request for RRC_final.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is used to transfer SIBPos to the UE in RRC_CONNECTED.","paragraph_zero_based":432},{"literal_text_all_w_t_and_m_t":"dedicatedSIB1-Delivery","paragraph_zero_based":433},{"literal_text_all_w_t_and_m_t":"This field is used to transfer SIB1 to the UE (including L2 U2N Remote UE). The field has the same values as the corresponding configuration in servingCellConfigCommon.","paragraph_zero_based":434},{"literal_text_all_w_t_and_m_t":"dedicatedSystemInformationDelivery","paragraph_zero_based":435},{"literal_text_all_w_t_and_m_t":"This field is used to transfer SIB6, SIB7, SIB8, SIB19, SIB20, SIB21, SIB25 to the UE with an active BWP with no common search space configured or the L2 U2N Remote UE in RRC_CONNECTED. For UEs in RRC_CONNECTED (including L2 U2N Remote UE), this field is also used to transfer the SIBs requested on-demand.","paragraph_zero_based":436},{"literal_text_all_w_t_and_m_t":"defaultUL-BAP-RoutingID","paragraph_zero_based":437},{"literal_text_all_w_t_and_m_t":"This field is used for IAB-node to configure the default uplink Routing ID, which is used by IAB-node during IAB-node bootstrapping, migration, IAB-MT RRC resume and IAB-MT RRC re-establishment for F1-C and non-F1 traffic. The defaultUL-BAP-RoutingID can be (re-)configured when IAB-node IP address for F1-C related traffic changes. This field is mandatory only for IAB-node bootstrapping.","paragraph_zero_based":438},{"literal_text_all_w_t_and_m_t":"defaultUL-BH-RLC-Channel","paragraph_zero_based":439},{"literal_text_all_w_t_and_m_t":"This field is used for IAB-nodes to configure the default uplink BH RLC channel, which is used by IAB-node during IAB-node bootstrapping, migration, IAB-MT RRC resume and IAB-MT RRC re-establishment for F1-C and non-F1 traffic. The defaultUL-BH-RLC-Channel can be (re-)configured when IAB-node IP address for F1-C related traffic changes, and the new IP address is anchored at a different IAB-donor-DU. This field is mandatory for IAB-node bootstrapping. If the IAB-MT is operating in EN-DC, the default uplink BH RLC channel is referring to an RLC channel on the SCG; Otherwise, it is referring to an RLC channel either on the MCG or on the SCG depending on whether the MN or the SN configures this field.","paragraph_zero_based":440},{"literal_text_all_w_t_and_m_t":"flowControlFeedbackType","paragraph_zero_based":441},{"literal_text_all_w_t_and_m_t":"This field is only used for IAB-node that support hop-by-hop flow control to configure the type of flow control feedback. Value perBH-RLC-Channel indicates that the IAB-node shall provide flow control feedback per BH RLC channel, value perRoutingID indicates that the IAB-node shall provide flow control feedback per routing ID, and value both indicates that the IAB-node shall provide flow control feedback both per BH RLC channel and per routing ID.","paragraph_zero_based":442},{"literal_text_all_w_t_and_m_t":"fullConfig","paragraph_zero_based":443},{"literal_text_all_w_t_and_m_t":"Indicates that the full configuration option is applicable for the RRCReconfiguration message for intra-system intra-RAT HO. For inter-RAT HO from E-UTRA to NR, fullConfig indicates whether or not delta signalling of SDAP/PDCP from source RAT is applicable. This field is absent if any DAPS bearer is configured or when the RRCReconfiguration message is transmitted on SRB3, and in an RRCReconfiguration message for SCG contained in another RRCReconfiguration message (or RRCConnectionReconfiguration message, see TS 36.331 [10]) transmitted on SRB1.","paragraph_zero_based":444},{"literal_text_all_w_t_and_m_t":"iab-IP-Address","paragraph_zero_based":445},{"literal_text_all_w_t_and_m_t":"This field is used to provide the IP address information for IAB-node.","paragraph_zero_based":446},{"literal_text_all_w_t_and_m_t":"iab-IP-AddressIndex","paragraph_zero_based":447},{"literal_text_all_w_t_and_m_t":"This field is used to identify a configuration of an IP address.","paragraph_zero_based":448},{"literal_text_all_w_t_and_m_t":"iab-IP-AddressToAddModList","paragraph_zero_based":449},{"literal_text_all_w_t_and_m_t":"List of IP addresses allocated for IAB-node to be added and modified.","paragraph_zero_based":450},{"literal_text_all_w_t_and_m_t":"iab-IP-AddressToReleaseList","paragraph_zero_based":451},{"literal_text_all_w_t_and_m_t":"List of IP address allocated for IAB-node to be released.","paragraph_zero_based":452},{"literal_text_all_w_t_and_m_t":"iab-IP-Usage","paragraph_zero_based":453},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the usage of the assigned IP address. If this field is not configured, the assigned IP address is used for all traffic.","paragraph_zero_based":454},{"literal_text_all_w_t_and_m_t":"iab-donor-DU-BAP-Address","paragraph_zero_based":455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e0c257c70d07100f1ede427a4f65f560f2201057cbf73ef45f430ec77898d451","original_member_sha256":"c33e87983ca56840fbfb3ece9b2b5c25c1e6cd4e9cf14026330d400169e5fdbe","paragraph_ElementTree_utf8_XML_sha256":["efbdb5a0fa6b4d0b49e447bc2072e4f220bca2554d06ba34c8c72cbfa8a17d7a","17534294b5da99fe50cfb1af4ed9a9719b8b1e92db806071932724a0426fcdad","9ee1c8e8ec21934dd9e8d692bbd47379fc3e272bf5d38d165579c4402466fbd4","a74ad8935e12eb2563ac31a656f5c6be2fc9caec73779e612d9bed1f05d7c164","41d0501a96139617de23af6f41f7c4ef980e9685515274db6a12d932796eb494","e2c3f26c366b08dcc77965f250d73a5a0c1c57e3710ea739f9a030ebe2b20a44","3523b4e58af93a571f800de1b207990dd5ae8880bef4b62c015fb79cd973c071","4f57cdd3316bc317f5bcc6e2a3ea5461e09e72a2a344e59e058a5f34b8119465","80c00e973bdab9cd0c85b6e6406117b5b5b9b340d8402a3972441463857e9d78","af0fe1d6d6a8ba35c480f06f290b56d902f145a22412ce4bd3c0b8e96a7c4a26","03c1c0e04f47a50e8d63a92fb2b5f41232ca93e4cebfe5499169bb048e3d9de2","787f768002584cfaf51b6e729c5238de256495eadb03b258872df68512fdb119","c5e5d1f2c6966f7ad74823416efd0026efd310b3dd45c15f011293d76b536512","371faea2e6efe5ea316a1ca3e3ae3995f8eed6f39b1df03828d578e7f4d11d7d","99cc5900082436f0c76c1ac95ff3500df54f1f36d54f4ccff43bc0af76ae94dc","bd9c7dec6d8d959e9896b9638468898fd88d22bb54eb4c14a9a1fdfcc8fc4c96","f706c8cf7537c12757aa11787b4b797bd32a352cfa7c8649ea2135d682672675","25692d64a979d0942ca692129d4133107b7b452cc9047e3808edbaa6379cc72a","cad33ad47add5dde219ecc5255e5df9d9b1d422f5f43bddb2e77ca79ee752f86","365b1a98040cddcd5b69742002f2c493ac827c3dcde815e60760baa4c1029466","4b84c84490b1ef96061b58e7ac1a598c275834cc1d0abdc4bd3e8c14530d5107","219e1414b103eea84270f4415d60707faf31ef38fd7af5ad5a163eb16f7c7d3b","d5ef2fa720907f8dd173f1497c354ff905bf46674985f39b3ab1250bbd37c174","b19fb0067ec3771802294484e903b4b5165a7778ab1981baed63b750c8ded574"],"paragraph_range_zero_based":[432,455],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2502074.zip::R2-2502074 Introudction of control parameters for on-demand posSIB request for RRC_final.docx:p432"}
{"fields":{"filename":"R2-2502074.zip::R2-2502074 Introudction of control parameters for on-demand posSIB request for RRC_final.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is used to indicate the BAP address of the IAB-donor-DU where the IP address is anchored.","paragraph_zero_based":456},{"literal_text_all_w_t_and_m_t":"keySetChangeIndicator","paragraph_zero_based":457},{"literal_text_all_w_t_and_m_t":"Indicates whether UE shall derive a new KgNB. If reconfigurationWithSync is included, value true indicates that a KgNB key is derived from a KAMF key taken into use through the latest successful NAS SMC procedure, or N2 handover procedure with KAMF change, as described in TS 33.501 [11] for KgNB re-keying. Value false indicates that the new KgNB key is obtained from the current KgNB key or from the NH as described in TS 33.501 [11].","paragraph_zero_based":458},{"literal_text_all_w_t_and_m_t":"ltm-Config","paragraph_zero_based":459},{"literal_text_all_w_t_and_m_t":"The network does not configure this field in an RRCReconfiguration message within an LTM-Config IE and ConditionalReconfiguration IE.","paragraph_zero_based":460},{"literal_text_all_w_t_and_m_t":"masterCellGroup","paragraph_zero_based":461},{"literal_text_all_w_t_and_m_t":"Configuration of master cell group.","paragraph_zero_based":462},{"literal_text_all_w_t_and_m_t":"mrdc-ReleaseAndAdd","paragraph_zero_based":463},{"literal_text_all_w_t_and_m_t":"This field indicates that the current SCG configuration is released and a new SCG is added at the same time.","paragraph_zero_based":464},{"literal_text_all_w_t_and_m_t":"mrdc-SecondaryCellGroup","paragraph_zero_based":465},{"literal_text_all_w_t_and_m_t":"Includes an RRC message for SCG configuration in NR-DC or NE-DC.For NR-DC (nr-SCG), mrdc-SecondaryCellGroup contains the RRCReconfiguration message as generated (entirely) by SN gNB. In this version of the specification, the RRC message can only include fields secondaryCellGroup, otherConfig, conditionalReconfiguration, ltm-Config, measConfig, bap-Config, IAB-IP-AddressConfigurationList and appLayerMeasConfig.","paragraph_zero_based":466},{"literal_text_all_w_t_and_m_t":"For NE-DC (eutra-SCG), mrdc-SecondaryCellGroup includes the E-UTRA RRCConnectionReconfiguration message as specified in TS 36.331 [10]. In this version of the specification, the E-UTRA RRC message can only include the field scg-Configuration.","paragraph_zero_based":467},{"literal_text_all_w_t_and_m_t":"mrdc-SecondaryCellGroupConfig","paragraph_zero_based":468},{"literal_text_all_w_t_and_m_t":"This field is used to configure and release an SCG in NR-DC and NE-DC. In an RRCReconfiguration message within an LTM-Config IE associated with the MCG, if this field is present its value can only be set to release.","paragraph_zero_based":469},{"literal_text_all_w_t_and_m_t":"musim-GapConfig","paragraph_zero_based":470},{"literal_text_all_w_t_and_m_t":"Indicates the MUSIM gap configuration and controls setup/release of MUSIM gaps. In this version of the specification, the network does not configure MUSIM gap together preconfigured measurement gap for positioning. For the UE not supporting musim-GapPriorityPreference, the network does not configure MUSIM gap together with concurrent measurement gap.","paragraph_zero_based":471},{"literal_text_all_w_t_and_m_t":"nas-Container","paragraph_zero_based":472},{"literal_text_all_w_t_and_m_t":"This field is used to transfer UE specific NAS layer information between the network and the UE. The RRC layer is transparent for this field, although it affects activation of AS  security after inter-system handover to NR. The content is defined in TS 24.501 [23].","paragraph_zero_based":473},{"literal_text_all_w_t_and_m_t":"needForGapsConfigNR","paragraph_zero_based":474},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurement gap requirement information of NR target bands in the RRCReconfigurationComplete and RRCResumeComplete message.","paragraph_zero_based":475},{"literal_text_all_w_t_and_m_t":"needForGapNCSG-ConfigEUTRA","paragraph_zero_based":476},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurement gap and NCSG requirement information of EUTRA target bands in the RRCReconfigurationComplete and RRCResumeComplete message.","paragraph_zero_based":477},{"literal_text_all_w_t_and_m_t":"needForGapNCSG-ConfigNR","paragraph_zero_based":478},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurement gap and NCSG requirement information of NR target bands in the RRCReconfigurationComplete and RRCResumeComplete message.","paragraph_zero_based":479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e0c257c70d07100f1ede427a4f65f560f2201057cbf73ef45f430ec77898d451","original_member_sha256":"c33e87983ca56840fbfb3ece9b2b5c25c1e6cd4e9cf14026330d400169e5fdbe","paragraph_ElementTree_utf8_XML_sha256":["62407782a097f296fc513a7667402cf2b5c1951449ce41e6957dd53da3c9308f","ce32bcfed883d768b6a2e1b8f7660882c2c1aa90f2d41ab2e1f3a035b007593a","703f586163818c31e47808369ff53d88acab4eb1facffd0519a74d99af79c89a","243c3af775e9c8d87f309eafd95a3f8e366ad6a11733835a14d1fa2be6352ddc","74e40bd23164c29ddf70b5ac2c94e343e531e019ad1e60e495c4d5c61d2667e4","182d0fc9336c6109bf973c14356d4689459f086cf01e63e5a5563703c0b90e60","80c480cbaf7b479741f53e2a3175bfddd7193e19eb2f98ca4ad748c852b05c64","3a345ba97d66921d6b37c85a0a6ad8db0258b3ff4f6ff39fb7e83ffddadefb93","b44bfb3764e13f6d15b11259d37a97c2f2ef53b7b8505e90944f4e8e1f6db797","837991053d45b5804270a91aaf025abc72bb07d77d77eca5578b18d228fb1523","22e9291c313d981fc2821a5c001016a159ed9566db54deeaae6c86c0bbcd4933","c8817aedfeacfc84a6022608cd1112f21c081c6557d8338297e71dcbf9f6220f","18ded638aee997fe7610662e785a5c87eef6e34587265026e9a700339904037c","9f3d07d6b3e86d10fa96102e8f4e5faae306bc7911c9386598326cbc1a2a41a5","617a82a5d37eacb7603ad039c98400ef39663c5b1e6b03db2493e3fb750eaeaa","ff259444cfc9f7f1447398c1750be85bb8065900f94e111175664a9638e074a3","9de9d30a39c4ef8cf558044619f9588420ac627c40d19cee4f5af7b2fc82cbcb","d3aa5881eac35e1d2c6e9ca8ddd7f739c52d242ee439136be6ec186ba98e8cd3","0ec7d174c8c196abda521ff4e083e981d898858d4bf91f46d3e48bc79df8d784","df59f15a580ea921f16b387b6dc20a806bb2d998788eee6ef2396cb3a964bd5d","f557dbf9d4d3e0c4754dc660c7058624566f25966dd6338e80328f46280589c1","3108449ae68fe9c1de47f0fe618ce833322bc896560b30db121d2d91d433a8d9","5653a9e7dfd30d4c53a5d1a0db748d85c31774624551539703537a70b48283fd","a8dc9ce72b5e5420f751492027fe7511a71eb770151fe747292a5291f1c1ca60"],"paragraph_range_zero_based":[456,479],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2502074.zip::R2-2502074 Introudction of control parameters for on-demand posSIB request for RRC_final.docx:p456"}
{"fields":{"filename":"R2-2502074.zip::R2-2502074 Introudction of control parameters for on-demand posSIB request for RRC_final.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"needForInterruptionConfigNR","paragraph_zero_based":480},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE shall report interruption requirement information of NR target bands in the RRCReconfigurationComplete and RRCResumeComplete message. The network sets this field to enabled only if the needForGapsConfigNR is configured. The network sets this field to disabled if the needForGapsConfigNR is released.","paragraph_zero_based":481},{"literal_text_all_w_t_and_m_t":"nextHopChainingCount","paragraph_zero_based":482},{"literal_text_all_w_t_and_m_t":"Parameter NCC: See TS 33.501 [11]","paragraph_zero_based":483},{"literal_text_all_w_t_and_m_t":"onDemandSIB-Request","paragraph_zero_based":484},{"literal_text_all_w_t_and_m_t":"Indicates that the UE is allowed to request SIB(s) on-demand while in RRC_CONNECTED according to clause 5.2.2.3.5.","paragraph_zero_based":485},{"literal_text_all_w_t_and_m_t":"onDemandSIB-RequestProhibitTimer","paragraph_zero_based":486},{"literal_text_all_w_t_and_m_t":"Prohibit timer for requesting SIB(s) on-demand while in RRC_CONNECTED according to clause 5.2.2.3.5. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":487},{"literal_text_all_w_t_and_m_t":"onDemandSIB-RequestCtrlParam","paragraph_zero_based":488},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE can send the control parameters in DedicatedSIBRequest. This field can only be present when the field onDemandSIB-Request is present. ","paragraph_zero_based":489},{"literal_text_all_w_t_and_m_t":"otherConfig","paragraph_zero_based":490},{"literal_text_all_w_t_and_m_t":"Contains configuration related to other configurations. When configured for the SCG, only fields drx-PreferenceConfig, maxBW-PreferenceConfig, maxBW-PreferenceConfigFR2-2, maxCC-PreferenceConfig, maxMIMO-LayerPreferenceConfig, maxMIMO-LayerPreferenceConfigFR2-2, minSchedulingOffsetPreferenceConfig, minSchedulingOffsetPreferenceConfigExt, rlm-RelaxationReportingConfig, bfd-RelaxationReportingConfig, btNameList, wlanNameList, sensorNameList, obtainCommonLocation, idc-AssistanceConfig, multiRx-PreferenceReportingConfigFR2, ul-TrafficInfoReportingConfig, n3c-RelayUE-InfoReportConfig, successPSCell-Config and sn-InitiatedPSCellChange can be included.","paragraph_zero_based":491},{"literal_text_all_w_t_and_m_t":"radioBearerConfig","paragraph_zero_based":492},{"literal_text_all_w_t_and_m_t":"Configuration of Radio Bearers (DRBs, SRBs, multicast MRBs) including SDAP/PDCP. In (NG)EN-DC this field may only be present if the RRCReconfiguration is transmitted over SRB3. SRB4 should not be configured if sl-L2RemoteUE-Config-r17 is configured or not released.","paragraph_zero_based":493},{"literal_text_all_w_t_and_m_t":"radioBearerConfig2","paragraph_zero_based":494},{"literal_text_all_w_t_and_m_t":"Configuration of Radio Bearers (DRBs, SRBs) including SDAP/PDCP. This field can only be used if the UE supports NR-DC or NE-DC.","paragraph_zero_based":495},{"literal_text_all_w_t_and_m_t":"scg-State","paragraph_zero_based":496},{"literal_text_all_w_t_and_m_t":"Indicates that the SCG is in deactivated state.","paragraph_zero_based":497},{"literal_text_all_w_t_and_m_t":"This field is not used","paragraph_zero_based":498},{"literal_text_all_w_t_and_m_t":"-in an RRCReconfiguration message received:","paragraph_zero_based":499},{"literal_text_all_w_t_and_m_t":"-within mrdc-SecondaryCellGroup, or","paragraph_zero_based":500},{"literal_text_all_w_t_and_m_t":"-in an E-UTRA RRCConnectionReconfiguration message, or","paragraph_zero_based":501},{"literal_text_all_w_t_and_m_t":"-in an E-UTRA RRCConnectionResume message or","paragraph_zero_based":502},{"literal_text_all_w_t_and_m_t":"-in an RRCReconfiguration message received via SRB3, except if the RRCReconfiguration message is included in DLInformationTransferMRDC.","paragraph_zero_based":503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e0c257c70d07100f1ede427a4f65f560f2201057cbf73ef45f430ec77898d451","original_member_sha256":"c33e87983ca56840fbfb3ece9b2b5c25c1e6cd4e9cf14026330d400169e5fdbe","paragraph_ElementTree_utf8_XML_sha256":["e156339151e838963eab7b0b8cc3fd7117364dc99f509f0a52d1bc2f1a833f3c","7e1b75424126727415fcea94e0a553ad0956f36d393e4a7de928ce00bf0540fc","bcf535d8ff4f0a6bb3b2348a177f9c5a55a95a2aea7b6fdc82346d059e8c449f","4816b2bd476b258c4610d7130f525028f709ad299114170a078b8b0f306653bf","25a54d01d9f6279cd438c291af237171158551d339c35edf96c554bf7d0c018a","3099eefbcd7a5aa8d4e9c985171780d3bd72789f412acf7d9f514524f04e40e7","8d4cd60e3b8f0c67d1def21609a027b8d13195eccd61ce8e3aad1308cb2fb060","41ff5dfb73cb76da0b133d18a8e9e1418ab46e42dbf8b1d4164920a1752b7604","f561f15bdadba627900c9a16b7c1fcdc7e491ed77e2d01c7302d134bfee962f1","1f0ec3d8312f21acf4909d988fa0a6fdc69fbce37ae576ed7720a4f8c9252924","78c1302bfbbe8f533130b519c059e9d5cde31b4b6fa152400b400866115d2955","9942bf6f50bb383c80f3854cb64c61df9a51f4c005e9310df2d3adb7180ad754","ac16a209d66dfbab9ed33ba47d771f8b1f8dbe688cdebc6224abe31bce09bd69","81270973cd6b7561bdcc081bbdb70b49c872621db600fea11ef7615f91c22cdf","2e79255c61d6309573b1316c468d655b32815113da557de30b807c151e29db94","16638b45ce524c55b06d085a2d5e1768ae64c006606cad6e211b13c68b4798d6","5ff9a12d0f53697f4636c80678ea0b6597bc9eee77bec3ced72a61ccf19dd835","2e85c37ad5cb90073aa6ec1182d0dde8ca4932176cb58208048c6382e5a35fcf","1b90ff04a1cb1c9b7ca7143270170ce10e12ce5d63cb0e408527be840c0b87f5","6358bbf183c7df78da5033a9c5b2cf9b6d0afc0edd088874347d4e4a5b6312e5","23b70c297b3a4650f04d83c9ad2c8bd7ee663c2cd9318be94902fbfe0dcc6e2c","25163a18c5bee550630529e686c6eed215ea5cb25a776e9dea4421f11a3cd1c7","f1199a693a4e5d4b1278f3a7c80c637b7802701750239cbc3798b3a9e8e0ff12","e1161ff8277c31229cdbb970d4c1c40f07a3815855a4c3e9b5babd6e4a8b6707"],"paragraph_range_zero_based":[480,503],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2502074.zip::R2-2502074 Introudction of control parameters for on-demand posSIB request for RRC_final.docx:p480"}
{"fields":{"filename":"R2-2502074.zip::R2-2502074 Introudction of control parameters for on-demand posSIB request for RRC_final.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The field is absent if CPA, CPC, or subsequent CPAC is configured for the UE, or if the RRCReconfiguration message is contained in CondRRCReconfig, or PSCell is configured with tag2, or if the RRCReconfiguration message is included within an LTM-Config IE.","paragraph_zero_based":504},{"literal_text_all_w_t_and_m_t":"sl-L2RelayUE-Config","paragraph_zero_based":505},{"literal_text_all_w_t_and_m_t":"Contains L2 U2N relay operation related configurations used by a UE acting as or to be acting as a L2 U2N Relay UE or L2 U2U relay operation related configuration used by a UE acting as a L2 U2U Relay UE. In case of L2 U2N relay operation, the field is absent if conditionalReconfiguration is configured for CHO.","paragraph_zero_based":506},{"literal_text_all_w_t_and_m_t":"sl-L2RemoteUE-Config","paragraph_zero_based":507},{"literal_text_all_w_t_and_m_t":"Contains L2 U2N relay operation related configurations used by a UE acting as or to be acting as a L2 U2N Remote UE or L2 U2U relay operation related configuration used by a UE acting as a L2 U2U Remote UE. In case of L2 U2N relay operation, the field is absent if conditionalReconfiguration is configured for CHO, or if appLayerMeasConfig or SRB4 is configured/not released.","paragraph_zero_based":508},{"literal_text_all_w_t_and_m_t":"secondaryCellGroup","paragraph_zero_based":509},{"literal_text_all_w_t_and_m_t":"Configuration of secondary cell group ((NG)EN-DC or NR-DC).","paragraph_zero_based":510},{"literal_text_all_w_t_and_m_t":"sk-Counter","paragraph_zero_based":511},{"literal_text_all_w_t_and_m_t":"A counter used upon initial configuration of S-KgNB or S-KeNB, as well as upon refresh of S-KgNB or S-KeNB. This field is always included either upon initial configuration of an NR SCG or upon configuration of the first RB with keyToUse set to secondary, whichever happens first. This field is absent if there is neither any NR SCG nor any RB with keyToUse set to secondary, or if the RRCReconfiguration message is contained in condRRCReconfig for subsequent CPAC.","paragraph_zero_based":512},{"literal_text_all_w_t_and_m_t":"sl-ConfigDedicatedNR","paragraph_zero_based":513},{"literal_text_all_w_t_and_m_t":"This field is used to provide the dedicated configurations for NR sidelink communication/discovery/positioning.","paragraph_zero_based":514},{"literal_text_all_w_t_and_m_t":"sl-ConfigDedicatedEUTRA-Info","paragraph_zero_based":515},{"literal_text_all_w_t_and_m_t":"This field includes the E-UTRA RRCConnectionReconfiguration as specified in TS 36.331 [10]. In this version of the specification, the E-UTRA RRCConnectionReconfiguration can only includes sidelink related fields for V2X sidelink communication, i.e. sl-V2X-ConfigDedicated, sl-V2X-SPS-Config, measConfig and/or otherConfig.","paragraph_zero_based":516},{"literal_text_all_w_t_and_m_t":"srs-PosResourceSetLinkedForAggBWList","paragraph_zero_based":517},{"literal_text_all_w_t_and_m_t":"This field indicates the SRS resource sets across two or three carriers which are linked for SRS bandwidth aggregation in RRC_CONNECTED state as defined in clause 6.2.1.4 of TS 38.214 [19].","paragraph_zero_based":518},{"literal_text_all_w_t_and_m_t":"sl-TimeOffsetEUTRA","paragraph_zero_based":519},{"literal_text_all_w_t_and_m_t":"This field indicates the possible time offset to (de)activation of V2X sidelink transmission after receiving DCI format 3_1 used for scheduling V2X sidelink communication. Value ms0dpt75 corresponds to 0.75ms, ms1 corresponds to 1ms and so on. The network includes this field only when sl-ConfigDedicatedEUTRA is configured.","paragraph_zero_based":520},{"literal_text_all_w_t_and_m_t":"targetCellSMTC-SCG","paragraph_zero_based":521},{"literal_text_all_w_t_and_m_t":"The SSB periodicity/offset/duration configuration of target cell for NR PSCell addition and SN change. When UE receives this field, UE applies the configuration based on the timing reference of NR PCell for PSCell addition and PSCell change for the case of no reconfiguration with sync of MCG, and UE applies the configuration based on the timing reference of target NR PCell for the case of reconfiguration with sync of MCG. If both this field and the smtc in secondaryCellGroup -> SpCellConfig -> reconfigurationWithSync are absent, the UE uses the SMTC in the measObjectNR having the same SSB frequency and subcarrier spacing, as configured before the reception of the RRC message.","paragraph_zero_based":522},{"literal_text_all_w_t_and_m_t":"t316","paragraph_zero_based":523},{"literal_text_all_w_t_and_m_t":"Indicates the value for timer T316 as described in clause 7.1. Value ms50 corresponds to 50 ms, value ms100 corresponds to 100 ms and so on. This field can be configured only if the UE is configured with split SRB1 or SRB3.","paragraph_zero_based":524},{"literal_text_all_w_t_and_m_t":"ue-TxTEG-RequestUL-TDOA-Config","paragraph_zero_based":525},{"literal_text_all_w_t_and_m_t":"Configures the periodicity of UE reporting for the association between Tx TEG and SRS Positioning resources. When configured with oneShot UE reports the association only one time. When configured with periodicReporting UE reports the association periodically and the periodicReporting indicates the periodicity. Value ms160 corresponds to 160ms, value ms320 corresponds to 320ms and so on.","paragraph_zero_based":526},{"literal_text_all_w_t_and_m_t":"ul-GapFR2-Config","paragraph_zero_based":527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e0c257c70d07100f1ede427a4f65f560f2201057cbf73ef45f430ec77898d451","original_member_sha256":"c33e87983ca56840fbfb3ece9b2b5c25c1e6cd4e9cf14026330d400169e5fdbe","paragraph_ElementTree_utf8_XML_sha256":["25ddd7ec558a62208ec6691fd61f79f4b777d447667e26deb644d85abb1e02b3","d12157c3045e8b1e0d76aef996a96fdce7375ce87aa0f11b6af59417f6205aef","f19b08a647d907078733a5520fa7c953a47b2e5cc0b3ed0545a965ccf35c775d","e73a37900fea36a04582f3de711ba5d685aafde1e72de3932fa5c175d4007d45","306348d78ecddcd587a452e42189b5dc0c1f4a25177d97f8861171979e9835b5","f015e1ee87af4a5858fbf44cf3ada338f899468b117e41193da10e274104bf4a","a90977858786512bdfdcc676af8d6b0af9c2cb9d498781a7e6414f0c8038645b","6e71cbf743a0afcda495b776dfe31b135cb73984de138e3f3316ad7b1bddc8f7","d8aebca9cf37ebb593d5d9fb0068c1f972ab4b3932fb718a51ea741f6d54f6bb","6cbb8c1282d79739b253ccdd4938e948c660fabb3bfa1dce0486e6fd4ae982aa","fe4e53ec393bcb039b31ffca71b9182016751a4afcebeba770806f62201a2e70","8d2699990b340a19ba7631256861518887935e82ae75861b80473b204280f8bb","a0e0dce72ff42ebf4ab8b70141218fcbb6856c841bf7dbf94ec47b13773995c4","bac04c5b08dd5f31ded1886395644625970acf03aa7361a117600c1773356f34","089d86f6b475646ba238430b04af0bb117899a729ddbcfafbd959eef514175bf","cbdfadd0f2a0855c04d18d4eb5bf83177fd56c46b03b3cff2296b44ee1f0277f","4149313b6fde6067461004b3c6cfd34a7a3531e8c914303e81bd938144e7bb5b","d4b6762597fac33bee5e081429d8ba1a95afc424670f535a71604b62f578f0b9","a0d01234840acb9d18ad80f9e032b66e07fccc8454e1f8a5c7771eb9abbc152d","17e0d45c428720a75f90f9cf264989a04213889cd0335938dcfadeb1deba9539","ab131cfd152e444f891a6b96dd02e5cca73e846b9ba73a90e6e095f31219eb3a","aecfaa3c319d13336f53b83f487052dc679cea5c3dc0246f58c35d9f4070a94e","d97783ef4aaebf62f3dff6b28ac07e9cef4c1bf3ac4d4487349f0c202d322e3c","7a6ceab457e4780e331ec2b68222cdb85617b3930268af7fdfc52e2dabe5b193"],"paragraph_range_zero_based":[504,527],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2502074.zip::R2-2502074 Introudction of control parameters for on-demand posSIB request for RRC_final.docx:p504"}
{"fields":{"filename":"R2-2502074.zip::R2-2502074 Introudction of control parameters for on-demand posSIB request for RRC_final.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the FR2 UL gap configuration to UE. In EN-DC and NGEN-DC, the SN decides and configures the FR2 UL gap pattern. In NE-DC, the MN decides and configures the FR2 UL gap pattern. In NR-DC without FR2-FR2 band combination, the network entity which is configured with FR2 serving cell(s) decides and configures the FR2 UL gap pattern.","paragraph_zero_based":528},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":529},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":530},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":531},{"literal_text_all_w_t_and_m_t":"nonHO","paragraph_zero_based":532},{"literal_text_all_w_t_and_m_t":"The field is absent in case of reconfiguration with sync within NR or to NR; otherwise it is optionally present, need N.","paragraph_zero_based":533},{"literal_text_all_w_t_and_m_t":"securityNASC","paragraph_zero_based":534},{"literal_text_all_w_t_and_m_t":"This field is mandatory present in case of inter system handover. Otherwise the field is optionally present, need N.","paragraph_zero_based":535},{"literal_text_all_w_t_and_m_t":"MasterKeyChange","paragraph_zero_based":536},{"literal_text_all_w_t_and_m_t":"This field is mandatory present in case masterCellGroup includes ReconfigurationWithSync and RadioBearerConfig includes SecurityConfig with SecurityAlgorithmConfig, indicating a change of the AS security algorithms associated to the master key. If ReconfigurationWithSync is included for other cases, this field is optionally present, need N. If ReconfigurationWithSync is part of an RRCReconfiguration message within an LTM-Config IE associated with the MCG, the field is absent. Otherwise the field is absent.","paragraph_zero_based":537},{"literal_text_all_w_t_and_m_t":"FullConfig","paragraph_zero_based":538},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in case of inter-system handover from E-UTRA/EPC to NR. It is optionally present, Need N, during a reconfiguration with sync which is not related to an LTM cell switch or subsequent CPAC, and also in first reconfiguration after reestablishment; or for intra-system handover from E-UTRA/5GC to NR. It is absent otherwise.","paragraph_zero_based":539},{"literal_text_all_w_t_and_m_t":"SCG","paragraph_zero_based":540},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in:","paragraph_zero_based":541},{"literal_text_all_w_t_and_m_t":"-an RRCReconfiguration message contained in an RRCResume message (or in an RRCConnectionResume message, see TS 36.331 [10]),","paragraph_zero_based":542},{"literal_text_all_w_t_and_m_t":"-an RRCReconfiguration message contained in an RRCConnectionReconfiguration message, see TS 36.331 [10], which is contained in DLInformationTransferMRDC transmitted on SRB3 (as a response to ULInformationTransferMRDC including an MCGFailureInformation).","paragraph_zero_based":543},{"literal_text_all_w_t_and_m_t":"The field is optional present, Need M, in:","paragraph_zero_based":544},{"literal_text_all_w_t_and_m_t":"-an RRCReconfiguration message transmitted on SRB3,","paragraph_zero_based":545},{"literal_text_all_w_t_and_m_t":"-an RRCReconfiguration message contained in another RRCReconfiguration message (or in an RRCConnectionReconfiguration message, see TS 36.331 [10]) transmitted on SRB1","paragraph_zero_based":546},{"literal_text_all_w_t_and_m_t":"-an RRCReconfiguration message contained in another RRCReconfiguration message which is contained in DLInformationTransferMRDC transmitted on SRB3 (as a response to ULInformationTransferMRDC including an MCGFailureInformation).","paragraph_zero_based":547},{"literal_text_all_w_t_and_m_t":"Otherwise, the field is absent.","paragraph_zero_based":548},{"literal_text_all_w_t_and_m_t":"PagingRelay","paragraph_zero_based":549},{"literal_text_all_w_t_and_m_t":"For L2 U2N Relay UE, the field is optionally present, Need N. Otherwise, it is absent.","paragraph_zero_based":550},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":551}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e0c257c70d07100f1ede427a4f65f560f2201057cbf73ef45f430ec77898d451","original_member_sha256":"c33e87983ca56840fbfb3ece9b2b5c25c1e6cd4e9cf14026330d400169e5fdbe","paragraph_ElementTree_utf8_XML_sha256":["e6dd5c759beb3cd80694f5ef1330aea361c8c7bc84b59fe13a4d917c8b272635","3d60de94e5dac74dc2e91c67c4f0f8b3e6088518337c7742bc722b35a873a825","ec03d3d0051ba2f3bd96ec6a856bcb321ec0a2e90d2cd507187e755901eda1b2","a0e0cdf747279f79c684d0e170904ef232fd329432cd5a0f1b8d571e689d3e07","3410d5afcd6741fa3f8a57e9b9a665895bcbc82973104eb4d61ef27d38f5002f","270c43b47c1ea33933d8cc1b7031924a6b6409601f10d1bbe66187eaa662c657","9efd3c699cde1767f6a1359270457fdfe2ada2ddb11d90cb40a0eae6dc9b686a","f100c1cf48f237952490884271745dc3e93854be39314cda3d1fe2733f150d1b","d4b4842e117d50171a4c3875d73e469b78e322b65b7a52a894f0a34bf0185603","832f2df32a418e4e4ae71a145f13af95ddb0f81608a63bd3ef94fffb870a7c1e","6fc9b01fad330f7fc52d02b984f9205cbae43de92af544900c3e27a449162489","2ab371f933dbec482563d37638dbd7a781ab3d23682e91e0d4e4ec1965db9513","3619c4bc10e2018e8e9391f57043081ee80eec45e324bd836331704c8a87862c","95b24aa2c9ec259208d4dd208bfdc0da10de73a40d70d03b481ef2bc9fbaaa81","4c67b3bdd59955dbd1612cbdd24526ff19d28f160c81bc13b4bfc8d01620cbe8","b04342bd22169095f5e68be2dc9db64b0efccbc3a60829963b68b98b3b7381af","625619e62ac7bd2fed1db0a5be584d4cd3ac2215d2a454f13aadad091307a6e2","f65a9d995efd1256a74e540476e669ecfae2dde815abd3be32043aa52bd0e84f","c8deb5ee36c6c5a9fecbaa2face8c3f07b367d95a18d955661a34bc765eb11ea","0b172fd4151a9eea0ae1fc1bcc8cfac05199adfc55e7e1eeaf537733952ecd1c","3b4604dd4501b7c596e9bd68bc8df37