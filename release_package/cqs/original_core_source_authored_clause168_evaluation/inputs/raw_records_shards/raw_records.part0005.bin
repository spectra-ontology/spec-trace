{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    sl-ServedRadioBearer-r16                      SLRB-Uu-ConfigIndex-r16                          OPTIONAL,   -- Cond LCH-SetupOnly","paragraph_zero_based":48360},{"literal_text_all_w_t_and_m_t":"    sl-RLC-Config-r16                             SL-RLC-Config-r16                                OPTIONAL,   -- Cond LCH-Setup","paragraph_zero_based":48361},{"literal_text_all_w_t_and_m_t":"    sl-MAC-LogicalChannelConfig-r16               SL-LogicalChannelConfig-r16                      OPTIONAL,   -- Cond LCH-Setup","paragraph_zero_based":48362},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":48363},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":48364},{"literal_text_all_w_t_and_m_t":"    sl-RLC-BearerConfigIndex-v1800                SL-RLC-BearerConfigIndex-v1800                   OPTIONAL    -- Need R","paragraph_zero_based":48365},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":48366},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":48367},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48368},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RLC-BEARERCONFIG-STOP","paragraph_zero_based":48369},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":48370},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48371},{"literal_text_all_w_t_and_m_t":"SL-RLC-BearerConfig field descriptions","paragraph_zero_based":48372},{"literal_text_all_w_t_and_m_t":"sl-MAC-LogicalChannelConfig","paragraph_zero_based":48373},{"literal_text_all_w_t_and_m_t":"The field is used to configure MAC SL logical channel parameters.","paragraph_zero_based":48374},{"literal_text_all_w_t_and_m_t":"sl-RLC-BearerConfigIndex","paragraph_zero_based":48375},{"literal_text_all_w_t_and_m_t":"The index of the RLC bearer configuration. If the field sl-RLC-BearerConfigIndex-v1800 is present, the UE shall ignore the sl-RLC-BearerConfigIndex-r16 field.","paragraph_zero_based":48376},{"literal_text_all_w_t_and_m_t":"sl-RLC-Config","paragraph_zero_based":48377},{"literal_text_all_w_t_and_m_t":"Determines the RLC mode (UM, AM) and provides corresponding parameters.","paragraph_zero_based":48378},{"literal_text_all_w_t_and_m_t":"sl-ServedRadioBearer","paragraph_zero_based":48379},{"literal_text_all_w_t_and_m_t":"Associates the sidelink RLC Bearer with a sidelink DRB. It indicates the index of SL radio bearer configuration, which is corresponding to the RLC bearer configuration.","paragraph_zero_based":48380},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48381},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":48382},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":48383}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["d0f530f378beb0c4cad3a0526c2fd22b67b74903a49c5fcc87972b711d9e5ffe","88910a5c8ee1d3334ae1b0aa0c3e733e66b3cbcb717a0436393df6935a863f1a","5f38213967ecdbccbfe4074a8a257f42401c2bfc1378b03ae617fa76a1767fb3","e5d16b795f47340d9df517a09f036c5c6de3bbde9334165fd7bb60d1a6c82d2c","61cc939a743b42472a5d31b16ed0f20e35baf53e77a16ccd94cabdf6429640bb","bc543ee5ecb5fecb37167d73aa9a7b4ef20aa1927197a9bc8fc0c427863f9be0","c78911ca3982c5fdb615aca1d2476b9a4398c32fa6334f636d31454a02ba23db","aaf514ed5e9d35dc39f9c8a54d7c8c37cecdcaf7e73a17b1184d687794b7ee87","08ba11e61a3f6e02b86a9ca04ba6473ffc73dce33cce18fa128919dda50bc8f8","34671bc9283466a41cda69ad0e6095be49d7920dbe52b720de304c91d8ed4ee8","5b3228341b10ccb3502fb34fe0d340606bec040d7f135a93e2fae29