{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether UE supports L1 acknowledgement in response to CP transmission using PUR when connected to EPC/ 5GC.","paragraph_zero_based":4416},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4417},{"literal_text_all_w_t_and_m_t":"pur-FrequencyHopping","paragraph_zero_based":4418},{"literal_text_all_w_t_and_m_t":"Indicates whether UE supports frequency hopping for transmission using PUR.","paragraph_zero_based":4419},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4420},{"literal_text_all_w_t_and_m_t":"pur-PUSCH-NB-MaxTBS","paragraph_zero_based":4421},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports 2984 bits max UL TBS in 1.4 MHz for transmission using PUR when operating in CE mode A, as specified in TS 36.212 [22] and TS 36.213 [23].","paragraph_zero_based":4422},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4423},{"literal_text_all_w_t_and_m_t":"pur-RSRP-Validation","paragraph_zero_based":4424},{"literal_text_all_w_t_and_m_t":"Indicates whether UE supports serving cell RSRP for TA validation for transmission using PUR when connected to EPC/ 5GC.","paragraph_zero_based":4425},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4426},{"literal_text_all_w_t_and_m_t":"pur-SubPRB-CE-ModeA, pur-SubPRB-CE-ModeB","paragraph_zero_based":4427},{"literal_text_all_w_t_and_m_t":"Indicates whether UE supports subPRB resource allocation for PUSCH for transmission using PUR when operating in CE mode A/B.","paragraph_zero_based":4428},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4429},{"literal_text_all_w_t_and_m_t":"pur-UP-EPC-CE-ModeA, pur-UP-EPC-CE-ModeB, pur-UP-5GC-CE-ModeA, pur-UP-5GC-CE-ModeB","paragraph_zero_based":4430},{"literal_text_all_w_t_and_m_t":"Indicates whether UE operating in CE mode A/B supports UP transmission using PUR when connected to EPC/ 5GC.","paragraph_zero_based":4431},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4432},{"literal_text_all_w_t_and_m_t":"pusch-Enhancements","paragraph_zero_based":4433},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports the PUSCH enhancement mode as specified in TS 36.211 [21] and TS 36.213 [23].","paragraph_zero_based":4434},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4435},{"literal_text_all_w_t_and_m_t":"pusch-FeedbackMode","paragraph_zero_based":4436},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports PUSCH feedback mode 3-2.","paragraph_zero_based":4437},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":4438},{"literal_text_all_w_t_and_m_t":"pusch-MultiTB-CE-ModeA, pusch-MultiTB-CE-ModeB","paragraph_zero_based":4439}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["9806e4934bc5d5416d61c42d3d02e5e101db61047d3e271fae708c22491353da","a4a48a85b2c113d86cbcb28d3fabfd456f9aaec8b9107e7ab6eca6c9c0b1db77","b5bcf97f6e5f13636d264e617f61667d61343acb7c26c969631dfbc8cb65e1be","774796739d513e94645249de1c2866f13633cfb9081f5afa740776fd0fcbddf8","18ccb5abf127657ace512722d2cf12bf18710f99b3d066ac441da37df366eb6d","447dfca1e2cb0b740bdd0c137abf3a116bd975b1384b06555e7ad1640d9edeb4","b685b71100ba82082d55b1aed2c9837ca58f2ab44fba0826993da27a82e751ad","7ae4c51e5874031f8b46fe5431ba1cb08140cff005ce6083142d60b1d294c768","991badc3fef3f5a7bb785eb6519e9219a1170bbffdcac7e15d2dd7e139ca8ac3","cd355abeaaa41565e6fb552cf708820e2b44380c9abec5718ca7caf09994be35","f1c0b27d86690370d57e26378bdd799f42e0b7dcfc8e7420b1a96e02e38ec2a3","f18d7da51ba310bba0d75a7cbe55fa53c1c0c05e6d48ccc080ebc58b461ada1b","efd11e211d033e658ac1336d96edcf3f72b103d474a59fe69bf77cdab0f74662","9f2bf70f7c0ad1d3d3bd10fce4609c93154204f57d945469032053df53b2e7d1","ca3417e4486b44b763e80fe2b530128af256d2ea63a57413464d57698a868df0","2f316ee7202cebf7e80e8aad8862b4a1b37c2ad3da0325ee910a7e3f2a661325","95306cd66523452e77843c1ba7d75b60bfbc8e269111f0b74e89337c5de96ebd","9361da0b65765277ddb27645abde78f73b703c9003e822ad943f735787b2c81f","fca95a68599218abfe361f23e8f43c7267872b1ffba753be81f488540b18d111","4d9f755366ed864b896dec70b4637127d6deabe8665982a93daf1fc98b224e13","ab51cd5cd23edfb5a13e0fb07e5b701fdc6b9f7f27b56707280a9ecade3b08d1","0291ef39b908580f0a367a12c2ec62a513b97078614c3a1d3613e2051a71e48c","b056b71b14949fdb3152a995bb1610521f37bac5d1cd569a928dfb3deaceaa8f","a0ba0b1aef1669763098f13034e1903d5d03c80cfc962406e0f0e3d34afedc95"],"paragraph_range_zero_based":[4416,4439],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p4416"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports multiple TB scheduling in connected mode for PUSCH when operating in CE mode A/B, as specified in TS 36.211 [21] and TS 36.213 [23].","paragraph_zero_based":4440},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4441},{"literal_text_all_w_t_and_m_t":"pusch-SPS-MaxConfigSlot","paragraph_zero_based":4442},{"literal_text_all_w_t_and_m_t":"Indicates the max number of SPS configurations across all cells for slot PUSCH.","paragraph_zero_based":4443},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4444},{"literal_text_all_w_t_and_m_t":"pusch-SPS-MultiConfigSlot","paragraph_zero_based":4445},{"literal_text_all_w_t_and_m_t":"Indicates the number of multiple SPS configurations of slot PUSCH for each serving cell.","paragraph_zero_based":4446},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4447},{"literal_text_all_w_t_and_m_t":"pusch-SPS-MaxConfigSubframe","paragraph_zero_based":4448},{"literal_text_all_w_t_and_m_t":"Indicates the max number of SPS configurations across all cells for subframe PUSCH.","paragraph_zero_based":4449},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4450},{"literal_text_all_w_t_and_m_t":"pusch-SPS-MultiConfigSubframe","paragraph_zero_based":4451},{"literal_text_all_w_t_and_m_t":"Indicates the number of multiple SPS configurations of subframe PUSCH for each serving cell.","paragraph_zero_based":4452},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4453},{"literal_text_all_w_t_and_m_t":"pusch-SPS-MaxConfigSubslot","paragraph_zero_based":4454},{"literal_text_all_w_t_and_m_t":"Indicates the max number of SPS configurations across all cells for subslot PUSCH.","paragraph_zero_based":4455},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4456},{"literal_text_all_w_t_and_m_t":"pusch-SPS-MultiConfigSubslot","paragraph_zero_based":4457},{"literal_text_all_w_t_and_m_t":"Indicates the number of multiple SPS configurations of subslot PUSCH for each serving cell. This field is only applicable for UEs supporting FDD.","paragraph_zero_based":4458},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4459},{"literal_text_all_w_t_and_m_t":"pusch-SPS-SlotRepPCell","paragraph_zero_based":4460},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports SPS repetition for slot PUSCH for PCell.","paragraph_zero_based":4461},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4462},{"literal_text_all_w_t_and_m_t":"pusch-SPS-SlotRepPSCell","paragraph_zero_based":4463}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["fc9c65dfac71f27af7850a9e3072821caf35d54f94e0159f5350ba04c28e4d1d","2770a6dfec90a28116c81bac66bb352c9904496c748049c58b3cfe1c9c2002f0","8ca2de5432a4322a7d7db5d74d21239c828bb5c928f106643b9702692906e6d7","1bfd82cf7643d4a8f94986480b993b21bdc77678437562154b78b146f320a790","840a2df1828d94bec7bddc841dbf95351855454c8fd6e7da966eff452edbf760","591897f81dd257419bdae04d5076b4cd47efc80c74beabec929e20dcb9ee5c62","ae29c2146d29d28d43469de1ae67de21eaef05a210df650b8d86d8a884f0a235","eea01bbeb7850cb19d90f5833a1ee66ac2714c09b0bccf67af052a12195dd140","9ced5f994030ecd3ef60a44c1ded3c992abd54f7b424cd7c2102afc307c82bc9","217850949b9face075d21f146474aeb05ff1e397d060d72f05261a5d06067126","e76912f5fcffb0c2d6f59b3d9189f324c8fae516a0390acbbc0ff93882548c6b","8f3f7f1a2b515741f58ac88823622c9e953d3f92344315db313dd59edea1d124","fe6a39cdccdb4f7fed8a97eb98550eac148d698af9df716ea9ebc8eae7bc9af6","8790074d2602f593f058d6dfa40432c07cf3f1cc