{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ntn-RRC-HarqDisableMultiTB-CE-ModeB","paragraph_zero_based":4272},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE supports HARQ feedback disabling per HARQ process for downlink transmission by RRC configuration when the UE is operating in CE mode B and when configured with ce-PDSCH-MultiTB-Config.","paragraph_zero_based":4273},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4274},{"literal_text_all_w_t_and_m_t":"ntn-RRC-HarqDisableSingleTB-CE-ModeA","paragraph_zero_based":4275},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE supports HARQ feedback disabling per HARQ process for downlink transmission by RRC configuration when the UE is operating in CE mode A.","paragraph_zero_based":4276},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4277},{"literal_text_all_w_t_and_m_t":"ntn-RRC-HarqDisableSingleTB-CE-ModeB","paragraph_zero_based":4278},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE supports HARQ feedback disabling per HARQ process for downlink transmission by RRC configuration when the UE is operating in CE mode B.","paragraph_zero_based":4279},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4280},{"literal_text_all_w_t_and_m_t":"ntn-SegmentedPrecompensationGaps","paragraph_zero_based":4281},{"literal_text_all_w_t_and_m_t":"Indicates the minumum supported gap length between segments for segmented uplink transmission. Value sym1 corresponds to 1 symbol, value sl1 corresponds to 1 slot, value sf1 corresponds to 1 subframe.","paragraph_zero_based":4282},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4283},{"literal_text_all_w_t_and_m_t":"ntn-ScenarioSupport","paragraph_zero_based":4284},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports NTN features only for GSO or NGSO scenario. If a UE does not include this field but includes ntn-Connectivity-EPC-r17, the UE supports the NTN features for both GSO and NGSO scenarios.","paragraph_zero_based":4285},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4286},{"literal_text_all_w_t_and_m_t":"ntn-SemiStaticHarqDisableSPS","paragraph_zero_based":4287},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE supports HARQ feedback transmission for the first SPS PDSCH transmission after activation when the UE is operating in CE mode A.","paragraph_zero_based":4288},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4289},{"literal_text_all_w_t_and_m_t":"ntn-TA-report","paragraph_zero_based":4290},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports timing advance reporting in RRC_CONNECTED, see TS 36.321 [6].","paragraph_zero_based":4291},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4292},{"literal_text_all_w_t_and_m_t":"ntn-TimeBasedCHO","paragraph_zero_based":4293},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE supports time-based conditional handover, i.e., CondEvent T1.","paragraph_zero_based":4294},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4295}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["a171368f695617ac6dbd72b205c36e951922c76ac431389fca80f7ea7ce04410","19fde5d8d3c76c3bbf1798f228bb61437f5fe51e1e7d1a1f6d642d3e9e17d915","3758e470cbe392a2af7411c37f1ebcc1b80ace1c806a1259801693678b7ca12e","8339670b23db960aae36d368b2ed99b71b506a4203d4b075283dcf092623836f","76759f765968e31c236912b04048f6021cb68e0d41fea34f389190498cd9e253","ffb2616e5ebb985503cbb5bbf6882db58b3649e130d1c3d92