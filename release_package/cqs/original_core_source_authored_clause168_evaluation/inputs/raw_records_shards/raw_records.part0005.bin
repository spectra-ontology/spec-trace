17               MulticastRLC-BearerConfig-r17                       OPTIONAL,   -- Cond LCH-SetupOnlyMRB","paragraph_zero_based":5100},{"literal_text_all_w_t_and_m_t":"    servedRadioBearerSRB4-r17                   SRB-Identity-v1700                                  OPTIONAL    -- Cond LCH-SetupOnlySRB4","paragraph_zero_based":5101},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":5102},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":5103},{"literal_text_all_w_t_and_m_t":"    servedRadioBearerSRB5-r18                   SRB-Identity-v1800                                  OPTIONAL    -- Cond LCH-SetupOnlySRB5","paragraph_zero_based":5104},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":5105},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":5106},{"literal_text_all_w_t_and_m_t":"    rlc-Config-v1900                            RLC-Config-v1900                                    OPTIONAL,   -- Need R","paragraph_zero_based":5107},{"literal_text_all_w_t_and_m_t":"    servedRadioBearerSRB6-r19                   SRB-Identity-v1900                                  OPTIONAL  -- Cond LCH-SetupOnlySRB6","paragraph_zero_based":5108},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":5109},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":5110},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5111}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["36693fa8f8f435969a37997d5109ee5ad455afb416d548a351e0de864ca20ef0","41587b702d6459ab06930553f3484b934d5aef1003ab064a996126c90d0cf7d1","ee4c7f8ef68002c35173228d7b7158339ad6aa2131f3c9b0da9e12d76e8ed123","8a93ebceec5de1752314c9b684e59b74a71f3a53aa