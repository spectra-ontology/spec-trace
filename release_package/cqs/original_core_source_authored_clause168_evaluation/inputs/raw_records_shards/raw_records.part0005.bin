{"fields":{"filename":"R2-2507330.zip::R2-2507330 Correction on NCD-SSB Configuration for Positioning(R19).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":120},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":121},{"literal_text_all_w_t_and_m_t":"Start of the second change ","paragraph_zero_based":122},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":123},{"literal_text_all_w_t_and_m_t":"SRS-Config","paragraph_zero_based":124},{"literal_text_all_w_t_and_m_t":"The IE SRS-Config is used to configure sounding reference signal transmissions. The configuration defines a list of SRS-Resources, a list of SRS-PosResources, a list of SRS-PosResourceSets and a list of SRS-ResourceSets. Each resource set defines a set of SRS-Resources or SRS-PosResources. The network triggers the transmission of the set of SRS-Resources or SRS-PosResources using a configured aperiodicSRS-ResourceTrigger (L1 DCI). The network does not configure SRS specific power control parameters alpha (without suffix) or pathlossReferenceRS if unifiedTCI-StateType is configured for the serving cell.","paragraph_zero_based":125},{"literal_text_all_w_t_and_m_t":"SRS-Config information element","paragraph_zero_based":126},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":127},{"literal_text_all_w_t_and_m_t":"-- TAG-SRS-CONFIG-START","paragraph_zero_based":128},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":129},{"literal_text_all_w_t_and_m_t":"SRS-Config ::=                          SEQUENCE {","paragraph_zero_based":130},{"literal_text_all_w_t_and_m_t":"    srs-ResourceSetToReleaseList            SEQUENCE (SIZE(1..maxNrofSRS-ResourceSets)) OF SRS-ResourceSetId        OPTIONAL,   -- Need N","paragraph_zero_based":131},{"literal_text_all_w_t_and_m_t":"    srs-ResourceSetToAddModList             SEQUENCE (SIZE(1..maxNrofSRS-ResourceSets)) OF SRS-ResourceSet          OPTIONAL,   -- Need N","paragraph_zero_based":132},{"literal_text_all_w_t_and_m_t":"    srs-ResourceToReleaseList               SEQUENCE (SIZE(1..maxNrofSRS-Resources)) OF SRS-ResourceId              OPTIONAL,   -- Need N","paragraph_zero_based":133},{"literal_text_all_w_t_and_m_t":"    srs-ResourceToAddModList                SEQUENCE (SIZE(1..maxNrofSRS-Resources)) OF SRS-Resource                OPTIONAL,   -- Need N","paragraph_zero_based":134},{"literal_text_all_w_t_and_m_t":"    tpc-Accumulation                        ENUMERATED {disabled}                                                   OPTIONAL,   -- Need S","paragraph_zero_based":135},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":136},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":137},{"literal_text_all_w_t_and_m_t":"    srs-RequestDCI-1-2-r16                  INTEGER (1..2)                                                          OPTIONAL, -- Need S","paragraph_zero_based":138},{"literal_text_all_w_t_and_m_t":"    srs-RequestDCI-0-2-r16                  INTEGER (1..2)                                                          OPTIONAL, -- Need S","paragraph_zero_based":139},{"literal_text_all_w_t_and_m_t":"    srs-ResourceSetToAddModListDCI-0-2-r16  SEQUENCE (SIZE(1..maxNrofSRS-ResourceSets)) OF SRS-ResourceSet          OPTIONAL, -- Need N","paragraph_zero_based":140},{"literal_text_all_w_t_and_m_t":"    srs-ResourceSetToReleaseListDCI-0-2-r16 SEQUENCE (SIZE(1..maxNrofSRS-ResourceSets)) OF SRS-ResourceSetId        OPTIONAL, -- Need N","paragraph_zero_based":141},{"literal_text_all_w_t_and_m_t":"    srs-PosResourceSetToReleaseList-r16     SEQUENCE (SIZE(1..maxNrofSRS-PosResourceSets-r16)) OF SRS-PosResourceSetId-r16","paragraph_zero_based":142},{"literal_text_all_w_t_and_m_t":"                                                                                                                    OPTIONAL, -- Need N","paragraph_zero_based":143}],"source":"Whole authentic 