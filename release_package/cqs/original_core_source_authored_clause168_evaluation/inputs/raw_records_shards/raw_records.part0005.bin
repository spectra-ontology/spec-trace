","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"remoteUE-MH-Operation-L2-r19","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":" In addition, Annex presents multihop relay feature update for TR38.822.","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3d0669bebb61232fe20acea50a76ee807988cbd3d6f41a5e37816ee6179e9413","original_member_sha256":"c7379de7097f64dafbf008e1c06b57228e6acf168e72c816abdff7ae0ffde250","paragraph_ElementTree_utf8_XML_sha256":["07fef6ff139280964f9db311cf9d9b7929dc646372ca1b97dd3bcf54d805dc5b","8a71b03df183bbf13fba427a74eb10b285486bc4375b834454db8e15cd1c646f","22502d7de741a9598933dee9bdce31da92ea45ed95629dcdb91a8699980d139b","8d7372e50e4a95a103e7d7a7df1567776da9496fcb32112d4c553fb726fb7367","f23f9535f9c0f0ddb113f8bf4e9c5d8ccea9aca8a6eca293607ded2f14ce5af4","022d22761c7ca5d4c39c89853e612b1152b29a8153d58ac6926bd73543689835","7e77df49fc19f35234bdb0be5f4deb24d2b248d4c1930f53edde3c7b501c0e20","2b6cffa1192fbd22b06b94ad29ac2c0bee91c77e19136b9ac1e3c9bc95a12938","973bee37707a4ceb157af28a2f188b85261d88c6f2999d2cdd251b526e3fbd15","1ece802869bf331f26e6d5ffcf7d2fe707649922a183c08912c98b840942d965","f29759b4834ec7b0058bf6fb34f155b04475a60fdbd7027cdf4cdf7051c311c1","e81cfc1bfc21e19077524f31c53fa018d7624db9e0db73fd1b746bd22a431d39","d41c3bdf81a1ac13d4f11b9f716351a4b117791a5ef98c1bc500a122a0b55f56","1c06a2d979ae6a7eadc143d6baa67a49b4d6ce49fadc5c9846d6018a9eacf0e2","447117f20f84735950365a9be4d7c37ff297c278bc1e1905c74f154649891b5f","bba9cb5e724628dfaf0c93496f6c4f13766da84e830155f0d619b313da464039","59b8a3338fa275ef7fe8757d51a48f7f93ee6fc1311db345f9540e6ebc0e788e","cf2835e1c1cc187252c917172a2c638e966439bb6c74f000fa2480cbd152eb1a","2