{"fields":{"filename":"R2-2410826.zip::R2-2410826 MAC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>if SRS positioning validity area is configured:","paragraph_zero_based":168},{"literal_text_all_w_t_and_m_t":"5>start or restart the inactivePosSRS-ValidityAreaTAT associated with the indicated TAG.","paragraph_zero_based":169},{"literal_text_all_w_t_and_m_t":"4>else:","paragraph_zero_based":170},{"literal_text_all_w_t_and_m_t":"5>start or restart the inactivePosSRS-TimeAlignmentTimer associated with this TAG.","paragraph_zero_based":171},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":172},{"literal_text_all_w_t_and_m_t":"3>ignore the received Timing Advance Command.","paragraph_zero_based":173},{"literal_text_all_w_t_and_m_t":"1>when an Absolute Timing Advance Command is received in response to a MSGA transmission including C-RNTI MAC CE, as specified in clause 5.1.4a, for an SpCell configured with two TAGs:","paragraph_zero_based":174},{"literal_text_all_w_t_and_m_t":"2>apply the Timing Advance Command for the PTAG indicated in the Absolute Timing Advance Command MAC CE;","paragraph_zero_based":175},{"literal_text_all_w_t_and_m_t":"2>start or restart the timeAlignmentTimer associated with this PTAG.","paragraph_zero_based":176},{"literal_text_all_w_t_and_m_t":"1>when an Absolute Timing Advance Command is received in response to a MSGA transmission including C-RNTI MAC CE, as specified in clause 5.1.4a, for an SpCell not configured with two TAGs:","paragraph_zero_based":177},{"literal_text_all_w_t_and_m_t":"2>apply the Timing Advance Command for PTAG;","paragraph_zero_based":178},{"literal_text_all_w_t_and_m_t":"2>if there is ongoing Positioning SRS Transmission in RRC_INACTIVE as in clause 5.26:","paragraph_zero_based":179},{"literal_text_all_w_t_and_m_t":"3>if SRS positioning validity area is configured:","paragraph_zero_based":180},{"literal_text_all_w_t_and_m_t":"4>start or restart the inactivePosSRS-ValidityAreaTAT associated with the indicated TAG.","paragraph_zero_based":181},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":182},{"literal_text_all_w_t_and_m_t":"4>start or restart the inactivePosSRS-TimeAlignmentTimer associated with the indicated TAG.","paragraph_zero_based":183},{"literal_text_all_w_t_and_m_t":"2>if CG-SDT procedure is ongoing:","paragraph_zero_based":184},{"literal_text_all_w_t_and_m_t":"3>start or restart the cg-SDT-TimeAlignmentTimer associated with PTAG.","paragraph_zero_based":185},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":186},{"literal_text_all_w_t_and_m_t":"3>start or restart the timeAlignmentTimer associated with PTAG.","paragraph_zero_based":187},{"literal_text_all_w_t_and_m_t":"1>when the MAC entity is configured with rach-LessHO:","paragraph_zero_based":188},{"literal_text_all_w_t_and_m_t":"2>set the NTA value (as defined in TS 38.211 [8]) to the value indicated by targetNTA in rach-LessHO for PTAG;","paragraph_zero_based":189},{"literal_text_all_w_t_and_m_t":"2>start the timeAlignmentTimer associated with PTAG.","paragraph_zero_based":190},{"literal_text_all_w_t_and_m_t":"1>when the indication is received from upper layer for stopping the inactivePosSRS-TimeAlignmentTimer:","paragraph_zero_based":191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"475d0bd37e37b8aa508fe73eee1a8fb22927094fb103de8fe516608b9cb06d0a","original_member_sha256":"b6e2f6b9b9a49c6e03bb802fbf01fa6ee28f44f95781fdac844951b2e4b263a7","paragraph_ElementTree_utf8_XML_sha256":["9bcf63fa83e2f2f95df7395c3814ba10d613bff75d4755c45f7fa9fbc9fb85d8","9a8a73708f57072a2d816eedd1059248ba56d36c877ddb3e11db6b110aafcda2","fc9fa0096c3b74d16b35c6cec996eecc95663ab47b7128c1baee1607bdb00457","796382b085d22e27082ad8a72288d5b390c81c88eb11bbac7da46194c9cc3ba9","e9e5531ea036288aa19954dab47c6d12312bd0c