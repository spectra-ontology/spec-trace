"sl-SystemInformationDelivery","paragraph_zero_based":50824},{"literal_text_all_w_t_and_m_t":"This field is used to transfer SIBs and posSIBs to the L2 U2N Remote UE in RRC_IDLE or RRC_INACTIVE.","paragraph_zero_based":50825},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":50826},{"literal_text_all_w_t_and_m_t":"–End of PC5-RRC-Definitions","paragraph_zero_based":50827},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":50828},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":50829},{"literal_text_all_w_t_and_m_t":"END","paragraph_zero_based":50830},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":50831}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["b8c73efc8ac5115d3cf9756cc5f766726572759ab73984d69d8f41e41e8f3b4b","0271d62af87f798e1943ee5d25171a4c35ea41fd7bf9e4ebe9fc0e7e3aa385a1","7b05d876d1a7bb40faddc3dc90a1dfc5e1760ac143d33dc16bf33bc1cfdb0ecf","bdb5bcd0051054937449f516f5b22d823e73aaec56fce7b64af0c9b2d69f5ccd","14de174a9b4dccf72bdbf47b061289e41081e47d74e771425c723d384ec4bfa3","b7c952818dffb41ea7b3c1d95388c2736c51f1c4743ae956ff841593b433be44","9a06292f85c8f2d5a60bab7019773192c88ca8159bc2bf286985e2df4742276e","dee4ec4bfbb6fb502d6120ef42f6a588e826913554237a07559b7a66d925af92","4d91bad5fd3982fd1b382172c92efef80e151ecb72773a73760fba366e6c099b","c41db8de5163df191cd98694b3be200bcff1ffd0407a1d723a27b090f5cf3a43","0b895d6a9b7bd5e93ee7c34e23daab51dd4c8c225ff00855a40130e6001b4433","b78d686c0db56588fc201f88580fa4050dd970439b78212795309065a7bdff3b","9a6c285201dc713c15cc8374eb001268a5ae05568619549a6f9d2081b00e9f77","3b227e96ca364c60542d49a5562d4fee34595f975efaffdcb877f35913f24f8d","a75aa15e55dd90b3a574a6d4ea7bd831c048f8cce4a99ba0d6