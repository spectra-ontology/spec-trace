{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>submit the UEAssistanceInformation message to lower layers for transmission.","paragraph_zero_based":1992},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1993},{"literal_text_all_w_t_and_m_t":"NEXT CHANGE","paragraph_zero_based":1994},{"literal_text_all_w_t_and_m_t":"6.2.2Message definitions","paragraph_zero_based":1995},{"literal_text_all_w_t_and_m_t":"<Text Omitted>","paragraph_zero_based":1996},{"literal_text_all_w_t_and_m_t":"–RRCReconfiguration","paragraph_zero_based":1997},{"literal_text_all_w_t_and_m_t":"The RRCReconfiguration message is the command to modify an RRC connection. It may convey information for measurement configuration, mobility control, radio resource configuration (including RBs, MAC main configuration and physical channel configuration) and AS security configuration.","paragraph_zero_based":1998},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1 or SRB3","paragraph_zero_based":1999},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":2000},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":2001},{"literal_text_all_w_t_and_m_t":"Direction: Network to UE","paragraph_zero_based":2002},{"literal_text_all_w_t_and_m_t":"RRCReconfiguration message","paragraph_zero_based":2003},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":2004},{"literal_text_all_w_t_and_m_t":"-- TAG-RRCRECONFIGURATION-START","paragraph_zero_based":2005},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2006},{"literal_text_all_w_t_and_m_t":"RRCReconfiguration ::=                  SEQUENCE {","paragraph_zero_based":2007},{"literal_text_all_w_t_and_m_t":"    rrc-TransactionIdentifier               RRC-TransactionIdentifier,","paragraph_zero_based":2008},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                      CHOICE {","paragraph_zero_based":2009},{"literal_text_all_w_t_and_m_t":"        rrcReconfiguration                      RRCReconfiguration-IEs,","paragraph_zero_based":2010},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture                SEQUENCE {}","paragraph_zero_based":2011},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":2012},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2013},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2014},{"literal_text_all_w_t_and_m_t":"RRCReconfiguration-IEs ::=              SEQUENCE {","paragraph_zero_based":2015}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["949434b86569a4d93373739c405989bb56214b419977371b6fd83d64c0707d6b","7ffb5f2d7dbbfd90c30bcd0bbc663bb31cb38c6654ffbb8a109c19bc438124b9","9eee37bfe5c3aa34c8d76da93ae937665e2651dec0e042baa09aff4ae24eb9c8","08bb38a88c5efc54e6e77bdfe93bb8304342e2366423c42e6c8293f65ed3583b","b101b943ad657bd8ab57fb7d6b40d9051fc80994364096b490393e917096a47e","60a74fc403446040450bf1d2711973fc1a496da4ab31de137e2f75f43887ca20","8d215d574cc1e0dca806b106d795e201488f0c1392a180d39e7aa485cd0244e3","39cc810d3605498e72d2372e3a4a90c7d92c63e77b72e1e2cf41803af0935988","e4ecbef0f58f37253068bff4fede477aa3ec9b19aa81761946860fdd72351103","e46416ec79991132c082d467711edcfc06181c627cc7d95622dc4f3a2286c2be","8816aba5af26fe8c770fc90853ecdfdde7ea36ee4af73ca253053e4618f4116e","7e7d46890a22f8bdcb774d477b2d1471508d32ca45e4eba8b96593b1dee57bc9","dcbd51b18faf86b03bd94d2cc45ae1c25e4e28a8a19e21b8f87564d43e2cb17d","92713be4fddc92524e42ab0562113fb90c3d6303e64cecca759991697db62346","e12f151868bc96ec8a46800daba7989296