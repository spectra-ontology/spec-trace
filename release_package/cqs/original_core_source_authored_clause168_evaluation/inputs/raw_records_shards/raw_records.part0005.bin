{"fields":{"filename":"R2-2503192.zip::R2-2503192 RRC_final.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":120},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":121},{"literal_text_all_w_t_and_m_t":"Other comments:","paragraph_zero_based":122},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":123},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":124},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":125},{"literal_text_all_w_t_and_m_t":"This CR's revision history:","paragraph_zero_based":126},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":127},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":128},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":129},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":130},{"literal_text_all_w_t_and_m_t":"==================================CHANGE BEGINS=====================================","paragraph_zero_based":131},{"literal_text_all_w_t_and_m_t":"5.2.2.3.5Acquisition of SIB(s) or posSIB(s) in RRC_CONNECTED","paragraph_zero_based":132},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":133},{"literal_text_all_w_t_and_m_t":"1>if the UE is in RRC_CONNECTED with an active BWP not configured with common search space with the field searchSpaceOtherSystemInformation and the UE has not stored a valid version of a SIB or posSIB, in accordance with clause 5.2.2.2.1, of one or several required SIB(s) or posSIB(s) in accordance with clause 5.2.2.1, or","paragraph_zero_based":134},{"literal_text_all_w_t_and_m_t":"1>if the UE is in RRC_CONNECTED and acting as a L2 U2N Remote UE and the UE has not stored a valid version of a SIB, in accordance with clause 5.2.2.2.1, of one or several required SIB(s) in accordance with clause 5.2.2.1:","paragraph_zero_based":135},{"literal_text_all_w_t_and_m_t":"2>for the SI message(s) that, according to the si-SchedulingInfo or posSI-SchedulingInfo in the stored SIB1, contain at least one required SIB or requested posSIB:","paragraph_zero_based":136},{"literal_text_all_w_t_and_m_t":"3>if onDemandSIB-Request is configured and timer T350 is not running:","paragraph_zero_based":137},{"literal_text_all_w_t_and_m_t":"4>initiate transmission of the DedicatedSIBRequest message in accordance with 5.2.2.3.6;","paragraph_zero_based":138},{"literal_text_all_w_t_and_m_t":"4>start timer T350 with the timer value set to the onDemandSIB-RequestProhibitTimer;","paragraph_zero_based":139},{"literal_text_all_w_t_and_m_t":"1>else if the UE is in RRC_CONNECTED with an active BWP configured with common search space with the field searchSpaceOtherSystemInformation and the UE has not stored a valid version of a SIB or posSIB, in accordance with clause 5.2.2.2.1, of one or several required SIB(s) or posSIB(s) in accordance with clause 5.2.2.1:","paragraph_zero_based":140},{"literal_text_all_w_t_and_m_t":"2>for the SI message(s) that, according to the si-SchedulingInfo in the stored SIB1, contain at least one required SIB and for which si-BroadcastStatus is set to broadcasting:","paragraph_zero_based":141},{"literal_text_all_w_t_and_m_t":"3>acquire the SI message(s) as defined in clause 5.2.2.3.2;","paragraph_zero_based":142},{"literal_text_all_w_t_and_m_t":"2>for the SI message(s) that, according to the si-SchedulingInfo in the stored SIB1, contain at least one required SIB and for which si-BroadcastStatus is set to notBroadcasting:","paragraph_zero_based":143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"238d3c199e96ece26711109ab9c6ea50c6e7a79f01d965f5726abaadc75d7d70","original_member_sha256":"aef358e3251a43545eb3096bd467322c204ec9bae5d4b3d32209cb0d70701bd4","paragraph_ElementTree_utf8_XML_sha256":["aa822abd7ce7a35638b418c2393fc5b19450135ef840632c7e03b87c743e3f85","5466036223f718f16c535eb45f995