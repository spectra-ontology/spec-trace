{"fields":{"filename":"R2-2509465.zip::R2-2509465.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"additionalPathsExt-r17ENUMERATED { requested }OPTIONAL, -- Need ON","paragraph_zero_based":456},{"literal_text_all_w_t_and_m_t":"additionalPathsDL-PRS-RSRP-Request-r17ENUMERATED { requested }OPTIONAL, -- Need ON","paragraph_zero_based":457},{"literal_text_all_w_t_and_m_t":"multiMeasInSameReport-r17ENUMERATED { requested }OPTIONAL  -- Need ON","paragraph_zero_based":458},{"literal_text_all_w_t_and_m_t":"]],","paragraph_zero_based":459},{"literal_text_all_w_t_and_m_t":"[[","paragraph_zero_based":460},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-JointMeasurementRequest-r18SEQUENCE {","paragraph_zero_based":461},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-JointMeasurementRequestedPFL-List-r18SEQUENCE (SIZE (2..3)) OF","paragraph_zero_based":462},{"literal_text_all_w_t_and_m_t":"INTEGER (0..nrMaxFreqLayers-1-r16)OPTIONAL  -- Need ON","paragraph_zero_based":463},{"literal_text_all_w_t_and_m_t":"}OPTIONAL, -- Need ON","paragraph_zero_based":464},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-RxHoppingRequest-r18SEQUENCE {","paragraph_zero_based":465},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-RxHoppingTotalBandwidth-r18CHOICE {","paragraph_zero_based":466},{"literal_text_all_w_t_and_m_t":"fr1ENUMERATED {mhz40, mhz50, mhz80, mhz100},","paragraph_zero_based":467},{"literal_text_all_w_t_and_m_t":"fr2ENUMERATED {mhz100, mhz200, mhz400}","paragraph_zero_based":468},{"literal_text_all_w_t_and_m_t":"}OPTIONAL -- Need ON","paragraph_zero_based":469},{"literal_text_all_w_t_and_m_t":"}OPTIONAL -- Need ON","paragraph_zero_based":470},{"literal_text_all_w_t_and_m_t":"]]","paragraph_zero_based":471},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":472},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":473},{"literal_text_all_w_t_and_m_t":"NR-DL-TDOA-ReportConfig-r16 ::= SEQUENCE {","paragraph_zero_