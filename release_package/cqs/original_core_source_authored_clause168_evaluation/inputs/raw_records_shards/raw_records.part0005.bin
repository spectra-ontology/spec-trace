{"fields":{"filename":"R2-2406072.zip::R2-2406072_R1-FG55-6.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"PDCCH-BlindDetectionMixed1-r18::=            SEQUENCE {","paragraph_zero_based":912},{"literal_text_all_w_t_and_m_t":"    pdcch-BlindDetectionCG-UE-Mixed-r18          SEQUENCE{","paragraph_zero_based":913},{"literal_text_all_w_t_and_m_t":"        pdcch-BlindDetectionMCG-UE-Mixed-r18         INTEGER (1..15),","paragraph_zero_based":914},{"literal_text_all_w_t_and_m_t":"        pdcch-BlindDetectionSCG-UE-Mixed-r18         INTEGER (1..15)","paragraph_zero_based":915},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":916},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":917},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":918},{"literal_text_all_w_t_and_m_t":"-- TAG-CA-PARAMETERS-NRDC-STOP","paragraph_zero_based":919},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":920},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":921},{"literal_text_all_w_t_and_m_t":"CA-ParametersNRDC field descriptions","paragraph_zero_based":922},{"literal_text_all_w_t_and_m_t":"ca-ParametersNR-forDC (with and without suffix)","paragraph_zero_based":923},{"literal_text_all_w_t_and_m_t":"If this field is present for a band combination, it reports the UE capabilities when NR-DC is configured with the band combination. If a version of this field (i.e., with or without suffix) is absent for a band combination, the corresponding ca-ParametersNR field version in BandCombination is applicable to the UE configured with NR-DC for the band combination. If a version of this field (i.e., with or without suffix) is present for a band combination but does not contain any parameters, the UE does not support the corresponding field version when configured with NR-DC for the band combination.","paragraph_zero_based":924},{"literal_text_all_w_t_and_m_t":"featureSetCombinationDC","paragraph_zero_based":925},{"literal_text_all_w_t_and_m_t":"If this field is present for a band combination, it reports the feature set combination supported for the band combination when NR-DC is configured. If this field is absent for a band combination, the featureSetCombination in BandCombination (without suffix) is applicable to the UE configured with NR-DC for the band combination.","paragraph_zero_based":926},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":927},{"literal_text_all_w_t_and_m_t":"–FeatureSetDownlink","paragraph_zero_based":928},{"literal_text_all_w_t_and_m_t":"The IE FeatureSetDownlink indicates a set of features that the UE supports on the carriers corresponding to one band entry in a band combination.","paragraph_zero_based":929},{"literal_text_all_w_t_and_m_t":"FeatureSetDownlink information element","paragraph_zero_based":930},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":931},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETDOWNLINK-START","paragraph_zero_based":932},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":933},{"literal_text_all_w_t_and_m_t":"FeatureSetDownlink ::=                  SEQUENCE {","paragraph_zero_based":934},{"literal_text_all_w_t_and_m_t":"    featureSetListPerDownlinkCC             SEQUENCE (SIZE (1..maxNrofServingCells)) OF FeatureSetDownlinkPerCC-Id,","paragraph_zero_based":935}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"a1c9ce48225fa42ba77863277de1c1960f3aad0befd2cac147fb3962e728c5d2","original_member_sha256":"9e7c449cbf33f7b7b59179774e334411502417dc18db650656f4a59a48298da5","paragraph_ElementTree_utf8_XML_sha256":["aafd477afffd695772f50b149ef867c656875812b8ef1e446cfa0c2402da5107","f4fef77ce10813edeae0e725b1cf683963b52254f30ee7e229dc7b58c206496d","0514a8917fd96447a0efd64382b4b0c614be967e808dc860222f50b328a61b8a","1b84dbdbf65a517c51c87d0fdea33844f