24"}
{"fields":{"filename":"R2-2407524.zip::R2-2407524.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"F","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Rel-18","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-17(Release 17)Rel-18(Release 18)Rel-19(Release 19) Rel-20(Release 20)","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":"Reason for change:","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"NR has defined two waveforms for UL: CP-OFDM and DFT-S-OFDM. For NCR device, only CP-OFDM is considerred as mandatory feature for UL for NCR-MT. ","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"Table 4.2.23.1-1: Layer-1 mandatory features for NCR-MT","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"Features","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"Index","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"Feature group","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"Components","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"0. Waveform, modulation, subcarrier spacings, and CP","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"0-1","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"CP-OFDM waveform for DL and UL","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"1) CP-OFDM for DL","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"2) CP -OFDM for UL","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e56e4fe7d8e6a5c607933a23a2f1897d8656bfbf7c4bce8238b8e629cd46568a","original_member_sha256":"e10e3900277b3ed34f68058bb1ac2dafe7ed9796062dcc576bb2e3c4decb02a1","paragraph_ElementTree_utf8_XML_sha256":["885f48f1934ed8204e46e949728e60805afe64fbbe5ee9d46796701bf6d98433","d02aaffe9a214aaf2a1c07df1d5bf4c98bb063b264ff62f933beebc4efaef1de","96d0aaabdb72052f2696cd8872f9ad8813a7abf8868ee1b495e6635e938f2314","c8f26d30ce5e0af92ba2cab29620efc9bb60e271a9a6f739e65aa94cf56c7e67","68507e567547a079a709706983b35808595bbd480a640ea367aeba1893ab6eed","40d07df6b127d5ca039db03e1b06c05f419cb966a6c65d5c119d138056ad735e","2d5374e43f95e4736a8b86617a02c67ecae49c139abc50cb3370b0b03290d7f4","14902f1ee6ac639b60e5c76c481edac8c107fd47dde3c52a91ecc6114afda4f4","34311c7fcfa60ba26d71de5dcdda9a2873e002b6d9e59ca425ff0e1a868607a7","c5d51c7f5953bbe607e468c979ef1fc2602f65206ddecae271de738cefd4b074","cd669514b1dd18b67650ecd34761785aa7f2e2e8dc4cc5650589ff431ebfa0aa","847375cb6600d1b548f0cbf7fb40583069c799c0c73726c841c7523854e5f568","19e73575c3be12506bbed4c30c9595e6a205d61f76a2826b8d3a579c5c80c19d","3f13b7e828e1d66a38978e679dcbf5ce12473cd45a99db64eb0eb502fae45c94","2d8cd5b3bafdfd63fe394cfd7652b5e07b8b9217f007e75b9afe5379d93d3400","521af2267ada0b3b9e4f65a4483f93c528c5d0ad39c1c85b5ed307f204c482b8","005d3776d52672afe8879e2cdb8d82cf02c645df7caaf666185956daec1d2bb5","30091640c7ee8166d3fce1ef363ac7863f03145945f3afa058e546af8fb8e537","dc92cd48f5e9855bb772a51671bfdb99504f1125b3f85413c5e19463011780cb","cab993a24b51ced745a8010fc53708f8adebbb3928c8a3c4cc9c7a92f74b65d9","94104bb53decede4320ed28c22342a9aca3c73304840c4de558bf0f2242b8fbf","6eac04f126e898f34e5c2f0c671794d236e103b330b8838d75b66362f3fa8480","9a8f007a00de4a3cde4a92ff8b2f11cbbb29f6fb2513737fdcceb47504a0238f","7dab52cb73f9beed1159af5ac20f282198b626a3824ed9b39ec9b814c9b77e8d"],"paragraph_range_zero_based":[48,71],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2407524.zip::R2-2407524.docx:p48"}
{"fields":{"filename":"R2-2407524.zip::R2-2407524.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":72},{"literal_text_all_w_t_and_m_t":"0-3","paragraph_zero_based":73},{"literal_text_all_w_t_and_m_t":"DL modulation scheme","paragraph_zero_based":74},{"literal_text_all_w_t_and_m_t":"1) QPSK modulation","paragraph_zero_based":75},{"literal_text_all_w_t_and_m_t":"2) 16QAM modulation","paragraph_zero_based":76},{"literal_text_all_w_t_and_m_t":"3) 64QAM modulation for FR1","paragraph_zero_based":77},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":78},{"literal_text_all_w_t_and_m_t":"0-4","paragraph_zero_based":79},{"literal_text_all_w_t_and_m_t":"UL modulation scheme","paragraph_zero_based":80},{"literal_text_all_w_t_and_m_t":"1) QPSK modulation","paragraph_zero_based":81},{"literal_text_all_w_t_and_m_t":"2) 16QAM modulation","paragraph_zero_based":82},{"literal_text_all_w_t_and_m_t":"Therefore, DFT-S-OFDM should be considerred as an optional feature for NCR-MT, this is aligned with the below statement in current spec.  ","paragraph_zero_based":83},{"literal_text_all_w_t_and_m_t":"4.2.23.1Mandatory NCR-MT features","paragraph_zero_based":84},{"literal_text_all_w_t_and_m_t":"Table 4.2.23.1-1, Table 4.2.23.1-2 and Table 4.2.23.1-3 capture feature groups, which are mandatory for an NCR-MT.","paragraph_zero_based":85},{"literal_text_all_w_t_and_m_t":"CA, MR-DC, handover (e.g. CHO, DAPS, CPAC, etc), unlicensed band, HPUE Duty cycle, MPR related UE features and corresponding capabilities are not supported by an NCR-MT. All other feature groups or components of the feature groups as captured in TR 38.822 [24] as well as capabilities specified in this specification are optional for an NCR-MT, unless indicated otherwise.","paragraph_zero_based":86},{"literal_text_all_w_t_and_m_t":"However, because legacy NR UEs must support these two UL waveforms, thus no capability has been introduced for indicating the support of CP-OFDM or DFT-S-OFDM UL waveforms. Therefore, there is no way for a NCR-MT to report its support of DFT-S-OFDM for UL. ","paragraph_zero_based":87},{"literal_text_all_w_t_and_m_t":"For IAB-MT, a separate optional capability (i.e. dft-S-OFDM-WaveformUL-IAB-r16) was introduced, so, for NCR-MT, the similar capability can also be introduced. ","paragraph_zero_based":88},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":89},{"literal_text_all_w_t_and_m_t":"“","paragraph_zero_based":90},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":91},{"literal_text_all_w_t_and_m_t":"Introduce UE capability “ncr-dft-S-OFDM-WaveformUL-r18” for NCR-MT.","paragraph_zero_based":92},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":93},{"literal_text_all_w_t_and_m_t":"Impact analysis","paragraph_zero_based":94},{"literal_text_all_w_t_and_m_t":"Impacted 5G architecture options:","paragraph_zero_based":95}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e56e4fe7d8e6a5c607933a23a2f1897d8656bfbf7c4bce8238b8e629cd46568a","original_member_sha256":"e10e3900277b3ed34f68058bb1ac2dafe7ed9796062dcc576bb2e3c4decb02a1","paragraph_ElementTree_utf8_XML_sha256":["c06744d9e1c1b640f6e0f24adb86bbc7699178406029175fbbd5478a521999c6","a7687ff30705478720330296bf173cbcce172ec226c91d7d0720ce1fa69789ae","3cfac76e1e6a812047d9bf679cabbb74844be497022bcd3ac91c4c410ec91bf1","fa687d4e1462fb7bddce07a8449475b0c4b12e74352d130956b6770260bbb698","1c0e99590e89df1e174d0b907c9e78ce59b0428b59b7c29332a45b35bfe25c19","c71ad6ab0d051df303e946cf3f894f834a7bb88fc553fc0b4ca415aefdb3aad0","8587e6d5aab36ca0e34127e64b58190f609cc54913d871a1d8ebe4853c88c398","7d93db85589771311da79c7a4d8e6662c4261c48e33af63f1ce080ef9ac47829","fb0b6f2fc1642d0d4c5b6386f66df6ffa68bd19c90f62377399dca616d56c3a5","a1945f3a4658645cd29c5cd0465254a1a1955f0001ec6ad8ec03bb846986fac4","c54350a75dfd88e046a989b6515516374313630b4e03488ab82009f4220891c2","10652d85bc29ab17ca98afe04d53f80c1d8be15479b287bd3f529a2889f9737f","ce4e85bb333ce702a6f86c0b5ff11d1fb9da0b1dbd7060ebe62e708173326eb5","209ca18288d95bb308f17651805d515a7e89b08fce4183bf10509049f3743fb1","0cfa7856f00de9b98c1c92008389fa5804768c03339c33cd2c6c1e4f7a778d96","e21065ee7da26150e242c74e47da5d06cf159adfab985359ae50b5cc17b1b852","37a3e259cbe90d9e136a3d1153c63f1edaa3148ceb387a3b8a2387606cce1f29","a85c57f9e64905e0f6128bc18b64fca9a8f4a12e25157ef38bfd9020236a24f9","5caf48a7cf73c9d6899286a33472bf74d69b82e786a2aeffc765421c9ee722d7","d857b27c7f3905bc8905dc4a598a367e19c01a2878de9749574389e8b85f5999","3225812d84ce44a4edae473c2e6f8fdb0e2cb528e8c2133d4051c0fb975d3296","081faa07ed3c6cc1593439ab298696c863224d162331b1f2c5536e6c3b25fcd5","62b5dcecf44a8dede090e0be751dc55ba27b2d206bd078d9d94cdf06e6e4403f","8aa0cd30257394a9e0772b4557d65b1ac402e1170d9ffb5b14b0bb7fb936fcc7"],"paragraph_range_zero_based":[72,95],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2407524.zip::R2-2407524.docx:p72"}
{"fields":{"filename":"R2-2407524.zip::R2-2407524.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"NR SA","paragraph_zero_based":96},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":97},{"literal_text_all_w_t_and_m_t":"Impacted functionality:","paragraph_zero_based":98},{"literal_text_all_w_t_and_m_t":"UL Waveform","paragraph_zero_based":99},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":100},{"literal_text_all_w_t_and_m_t":"Inter-operability:","paragraph_zero_based":101},{"literal_text_all_w_t_and_m_t":"If the network is implemented according to the CR and the NCR-MT is not, or If the NCR-MT is implemented according to the CR and the network is not, the network cannot know whether the NCR-MT supports DFT-S-OFDM and cannot configure such waveform for UL transmission. ","paragraph_zero_based":102},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":103},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":104},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":105},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":106},{"literal_text_all_w_t_and_m_t":"UL waveform DFT-S-OFDM is not supported for NCR-MT. ","paragraph_zero_based":107},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":108},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":109},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":110},{"literal_text_all_w_t_and_m_t":"4.2.23.6.1","paragraph_zero_based":111},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":112},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":113},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":114},{"literal_text_all_w_t_and_m_t":"Y","paragraph_zero_based":115},{"literal_text_all_w_t_and_m_t":"N","paragraph_zero_based":116},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":117},{"literal_text_all_w_t_and_m_t":"","