{"fields":{"filename":"R2-2408474.zip::R2-2408474-Introduction of new capability for intra-band EN-DC channel spacing(38.331).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"A list of band combinations that the UE supports for (NG)EN-DC, or both (NG)EN-DC and NE-DC. The FeatureSetCombinationId:s in this list refer to the FeatureSetCombination entries in the featureSetCombinations list in the UE-MRDC-Capability IE.","paragraph_zero_based":888},{"literal_text_all_w_t_and_m_t":"supportedBandCombinationListNEDC-Only, supportedBandCombinationListNEDC-Only-v1610, supportedBandCombinationListNEDC-Only-v1780","paragraph_zero_based":889},{"literal_text_all_w_t_and_m_t":"A list of band combinations that the UE supports only for NE-DC. The FeatureSetCombinationId:s in this list refer to the FeatureSetCombination entries in the featureSetCombinations list in the UE-MRDC-Capability IE.","paragraph_zero_based":890},{"literal_text_all_w_t_and_m_t":"supportedBandCombinationList-UplinkTxSwitch","paragraph_zero_based":891},{"literal_text_all_w_t_and_m_t":"A list of band combinations that the UE supports dynamic UL Tx switching for (NG)EN-DC. The FeatureSetCombinationId:s in this list refer to the FeatureSetCombination entries in the featureSetCombinations list in the UE-MRDC-Capability IE.","paragraph_zero_based":892},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":893}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"6ef8e29970877c41ee0909c74eb77641f0b7381d1c246e7d2f00fd11d87d6b8a","original_member_sha256":"9b822b165ead0597b4244a63818db6f3e80de23ae72c61027d553645e4b5cc17","paragraph_ElementTree_utf8_XML_sha256":["9d1edcf6253c622c4245907e81a264978c68ab54aaa51962c8c5f6ac002ecb3a","d764831ba52a0cbae3dbfd70353f686c71f991a2a67a1d33412d568c8d5825a4","3a89ee2716ee413581e587fca8ac74cc29b37a6d34a5e