oordinates":{"document_XML_sha256":"aff77448aa0c29346e92838a8068d532bf7fc7cee6b626a0d28c35eb56bc62eb","original_member_sha256":"8fb21086219d6c05d0b1987abc685c28d97deafa9e4dc7a0bcec470d129ecf7a","paragraph_ElementTree_utf8_XML_sha256":["55f29822da39d1ce8fb3a2bfc1d7a7c4abec006111eae06e02a758708054dc1b","1c7480f5e8f6f173b1020f795b5f7a0c0d109664dc35d5395c80bb417ba8fb1f","fa8679ad534fda885649c488c06d4d6c4246d004dbc7d34ea478708dbd9a91f2","d1ffb8c78c317157b96845553f0c776f6fe2a6651a5a3f713bce5a22256e938a","0c2c4d7f75e741cdd8bbd0e57c0004965d5945306e3e6a58116deb1095e01fcd","ab5415a2056971d07ed9b91f163e6f87b111b1db3fc7b4ed63ad0464666e6cb3","42404f5c06ae52177b25d334a8b17c0f7b6c7de771d74db4d1c06a0eeb7a5e62","5f701df667b68013bbd035cf331d007c0d4ed9cc81c3766dd91f2960f91e3c9a","ba8362e30ceeacacf8b51982dce69e4f66a2d3d436a8321feeaf1cfd66884a0f","e5bdc727b54f2ce12f0681e5f10b522120974137a6adf8980b1b013bbc19b774","0062a345ef6a7887740496bd1f7e708eb78c9d552eba1779a70e9ac4edfbbc35","ca93034f2b20062749761a4a4d2e4f962ad95d910316c74cf1e82a3bbeeaf90a","d96280ed61415266541f32dd4e0b222ea71db2db4a27eb7b772fd6604f9b36b3","234a566d44ff2d877b3cfd235a598613f52c0df68677f75dbcda33ee92a62f1f","3af55ac98c85ed5fb0f86f7db6ec21b3e5ada8cec30083d13623c6d626ef3878","3975cf0870bd238fad5bb5180b5ac02ad290631f80c4a7ca072b789c462aa109","e0ee9ba28adf1a6a5591913001324a259b7f0771bfd9984910fc54f697392a7e","99e43e0172246e0c4480cec555f6f546c35c8512eb55f224c1fd0ff9cf31806f","f71db171b34db7353090a5e0e11f5953e3de8f0d6c9b025073dce0cb60ba5bd3","c651f732d5b1a1fab3df2899dac476666d8c2e5a811ef7671e85fc96a11c76cb","99ac25beb073768219bad98d6c4cb3a9b68fc88c97a2b82434053a799aed1d5f","cb00d899e0bddb46ae1d9a5f0e316cce5e43821bce74f4a0d69b703c1712679d","017a3c2b33ef6069c1131a650c9d1eb3756ed7455bb7cd109ee2bace5b401c85","7323bb6246351771f0ebd1f3bf34ccb2360ae2192061f41c4e15214c120e74e9"],"paragraph_range_zero_based":[24,47],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2502080.zip::R2-2502080 Correction on SRS hopping in positioning.docx:p24"}
{"fields":{"filename":"R2-2502080.zip::R2-2502080 Correction on SRS hopping in positioning.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"F","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Rel-18","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-17(Release 17)Rel-18(Release 18)Rel-19(Release 19) Rel-20(Release 20)","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":"Reason for change:","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"For RedCap UE positioning with SRS hopping, RAN1 agreed to introduce a UTW (uplink time window) to resolve the collision between SRS hopping and other UL/DL channel/signals. The UTW is only used for resolving collision, i.e., even if the UTW is not configured, the SRS with hopping can still be transmitted in RRC_CONNECTED and RRC_INACTIVE.","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"Agreement in RAN1#114-bis","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"For RedCap UEs positioning transmitting the UL SRS with frequency hopping, regarding the collisions between other UL and DL signals/channels and the UL SRS with frequency hopping, support both of the following options ","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"Option 1: UL time window where the UE is not expected to transmit other signals/channels and is only expected to transmit FH SRS for positioning.","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"FFS details of an UL time window","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"Note: it implies that UE drops the transmission of other signals/channels and transmits SRS for positioning","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"Option 2: new collision rules between the UL SRS with frequency hopping and other UL and DL signals/channels/. Option 2 can apply without or outside UL time window (i.e. option 1)","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"FFS: details on the collision rules","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"Note: it is understood that option 2 is a component of the feature for UL SRS Tx hopping (FG 41-5-2), and option 1 is a separate feature group.","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"Note: UE is not expected to be configured with a SRS for positioning hopping cycle partially overlapping with UTW.","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"aff77448aa0c29346e92838a8068d532bf7fc7cee6b626a0d28c35eb56bc62eb","original_member_sha256":"8fb21086219d6c05d0b1987abc685c28d97deafa9e4dc7a0bcec470d129ecf7a","paragraph_ElementTree_utf8_XML_sha256":["5148d92e95a3530573ffd13fc3161623baecd0c263ef796ebf9acc3acc6d0dd6","2420d94a7b9142fd64b0f725f4e1950481f82ed2b9f9844f5405c766b3569fb8","30120d7e7078bbdd3b10be530cb09d45f9566a1d5938adf40c9ac7a55bf60cac","f573dbc994647e39a607c447c849f0aa3e4bd3946e613c5746f5790e438f3d65","11d1dd76653e72fa2620c6d45d27b2e1d1ce516ea993c09026dde7fefb514fc2","0f7badee931722a3794f5d48740fb0edb933813cde2cd486a89287c65819e9cc","2752563fbfb5cc2cdeab18b81c34295b1c06ae7fbbf23a2c3a800236c94a8e07","d76c001dc251fd79e79f327e3bc35b8101cd3f8cb99a83e9e78f97c0072a0034","10f3ab37926b7cab9371dcdd56f5386403099a07300355bec889ae1900356d3d","1882e00a939d6512f234c3cb640259acb32c5a6b2c78d53756b9bacccd032022","5513323f114a637b8aa415b71239c9af3e8d5683e6774209c3849e5a2c4da535","25bc2e191500c8770c54920877ee26b140603cf89b768aa3a486535c4c2de6a7","ea06fda973fe9009ae3133bd1b8f60197b7c614eae2790975e3a8cbef408ad55","77d3a7336f461c50a9130096974c1f6b91532d6679258dbb54a10af741b03105","89515bca2af7e129d389e2bd9e8f342b102c8df41a0b07efd2135d42645c802b","c920fd961c2f7d9241ceda1cd678997e5a45323d2a4d028d4b0e26dc3da22923","9c5cd89fd4c152f4ace56f6bc0eaef43aa2f0f579eefeaaaccc2a3c844fe6727","eeafa3cd0f63c2e7c528c2e6e9002cd7060af69245e45925992cdf16d1966d5f","9a01623c6f8d5a8bf6a585017729050bd66979ba3953102bd3e5837b1b957793","9f302eaba3c2fc5193ee7189db62e14d4e73eaf4e8005a094b72105d84ef7b55","0ab3192945280ee040dd444be4abbcbeae53d1574567620b5d17c0d520018c7f","2dab8fd5502a6dde99bd8708f3b1e714fb79e73e24a3a91d4361cc89864d2117","f57e355457e4982ee36b97b413ecdc4fced13fe2d8a2ddd67a933a1324d7e8ab","16daff651ba94185e4330dc80268f44bc4fcd1a40beba4fb37ce465517013918"],"paragraph_range_zero_based":[48,71],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2502080.zip::R2-2502080 Correction on SRS hopping in positioning.docx:p48"}
{"fields":{"filename":"R2-2502080.zip::R2-2502080 Correction on SRS hopping in positioning.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Based on above:","paragraph_zero_based":72},{"literal_text_all_w_t_and_m_t":"1. Neither RAN1 nor RAN2 introduces ‘UplinkTimeWindowTimer’ in Rel-18.","paragraph_zero_based":73},{"literal_text_all_w_t_and_m_t":"2. The UTW does not have any MAC spec impact. After RRC layer configures SRS hopping parameter and UTW, UE’s physical layer will transmit SRS hopping with the corresponding restriction, MAC does not need to translate UTW location to the physical layer. Furthermore, such UE behavior towards UTW is already specified in RAN1 specification, 38.214, 6.2.1.4.1, wherein the physical layer gets the UTW location directly based on/according to RRC configured parameters.","paragraph_zero_based":74},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":75},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":76},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":77},{"literal_text_all_w_t_and_m_t":"Delete UplinkTimeWindowTimer related description in MAC spec","paragraph_zero_based":78},{"literal_text_all_w_t_and_m_t":"Delete UTW formula in MAC spec","paragraph_zero_based":79},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":80},{"literal_text_all_w_t_and_m_t":"Impact analysis","paragraph_zero_based":81},{"literal_text_all_w_t_and_m_t":"Impacted 5G architecture options: ","paragraph_zero_based":82},{"literal_text_all_w_t_and_m_t":"SA","paragraph_zero_based":83},{"literal_text_all_w_t_and_m_t":"Impacted functionality:","paragraph_zero_based":84},{"literal_text_all_w_t_and_m_t":"Positioning SRS frequency hopping for RedCap UE","paragraph_zero_based":85},{"literal_text_all_w_t_and_m_t":"Inter-operability: ","paragraph_zero_based":86},{"literal_text_all_w_t_and_m_t":"If the UE is implemented according to this CR while the NW is not, NW will expect UE to run a UplinkTimeWindowTimer but UE wouldn’t, so gNB will not receive correct SRS hopping; ","paragraph_zero_based":87},{"literal_text_all_w_t_and_m_t":"If the NW is implemented according to this CR while the UE is not, UE will wrongly run an UplinkTimeWindowTimer which is not configured and expected by gNB.","paragraph_zero_based":88},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":89},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":90},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":91},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":92},{"literal_text_all_w_t_and_m_t":"Feature that has not been introduced in Rel-18 will exist in Rel-18 MAC specification","paragraph_zero_based":93},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":94},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":95}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"aff77448aa0c29346e92838a8068d532bf7fc7cee6b626a0d28c35eb56bc62eb","original_member_sha256":"8fb21086219d6c05d0b1987abc685c28d97deafa9e4dc7a0bcec470d129ecf7a","paragraph_ElementTree_utf8_XML_sha256":["3da6f30c568ccaac2b4370881de22fcbec7651a46084cfc0a086f80fd15b713b","739b30a326dcf5115cd122a50b12f3c668f67c98393fae844e123d2c68b0ac2c","1c1189da3e8a7c85e43e11c7fa04ba59c78983144f1cfc1488ca91c85325fc2d","d0763c3be75f1a2765bd50cd12a5845678e80f7efde4d628f3e980bccf3588ff","5338389e4c6419769dc11a0399bb4eabd80441b27b0ae66ceedacca6a71dcaaa","ed1b429b073019cef35ae828d1d63428ba560935cbb910c5e53ad6661642fac4","6d0f6177d623f0ec4b84d230e1bfd1a47ad1bbc2097a4a0022228f5fa1062ddd","a7a60f17593ab1a51109a101466cbdeebd77333c8ed3d30d3344c14238fee08b","288d3f9fdf543291d87c4644dcc7db7f9f3c72610d9b518fdd7163283794d930","231da8cdb47d78c9ec85df9b24a9a6a1d21bd259844d8642bf07e9df03126512","e741cee617d91472d1ee05a12587bebe8537d2331d7e7537ff8dd789ca697c6e","c595c21a1bbf5b77cd9b8563f33865eeb95146b622e2ab9e3fb2366ec0c6d078","84e9bc7a6d541a0e34ebd72debdd4e12cff80f86788166e4eac7d5e6f27b823c","f70f0a57c9e782ca133c8df2905345dfcea813774bdcca4b22c5bf318587e667","dc2b0f952ca4f12959722737f84a4c32774423b8c3a216a6a8e1b1c4818e391a","398a4b7310854851be06cc77dd3064d24676cd2403266a7747cd785d5759cbe5","2cb5e53710f6bc1fe826689e11dfbdcd32936e15743f1ceed8368989f43b78a8","6d7077988a512659b33bd5beb1997818cabf4323266f92dc3d76ce27797a4f2d","14612933d8e11e4148e0469bcc93b658d13e5fe498776358b21c9426f417c1ff","05e69510ae0b2ef864221edc0880db15849f85bba213235c652fc6ccc850de42","6f1a05dc90c2543289a6edcc883f85e6fde1dadb6aa83c54e34112f91572f556","1935d9f7035a2f5aa3afa1dc04191b006a42a6ecba73f3eff69bf09bf73e80ed","a26da6090751c03dd90addc78cc112171740df316590e3b845e1e410d9f46223","b1c707c178b565a7d2c043e4c22c80f171d5613bb94fb8bc91639f6c1cb8727f"],"paragraph_range_zero_based":[72,95],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2502080.zip::R2-2502080 Correction on SRS hopping in positioning.docx:p72"}
