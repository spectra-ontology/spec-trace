yReportList field descriptions","paragraph_zero_based":4002},{"literal_text_all_w_t_and_m_t":"applicabilityCellId","paragraph_zero_based":4003},{"literal_text_all_w_t_and_m_t":"Index of the serving cell that the ApplicabilityReport refers to.","paragraph_zero_based":4004},{"literal_text_all_w_t_and_m_t":"applicabilityInfoReportId","paragraph_zero_based":4005},{"literal_text_all_w_t_and_m_t":"Indicates the ID of a configuration subject to the applicability determination procedure.","paragraph_zero_based":4006},{"literal_text_all_w_t_and_m_t":"applicabilityInfoReportList","paragraph_zero_based":4007}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["98df64cb2aeb42164510f2d9e62ac8a0728e0642f85c1fd74e3e12da4b128425","dafe692deced07005f68f3df95757b4997e312706e102dd1580e64d314203b87","ff2d4703843963022d1684c2c3e95966ce4ba315c74a87797cd9a32fb4f992e7","5029a02a5ad96267abe54382ab4c3d21d539f7bac8e282965970ee22aad50fe2","0e2185c7587bd708e2801385c5edffc223f79aa3663b19d9bdc183610096dac2","c10f46da027d281dde7094b6e4b7949d0c5899cd66971553dfda96317e843b8c","c886cb070647ef450fa33ee954abed34cb9090770e6e9c48239b07331cafb46a","29db33b000a41502c66daa1ffb3c024de4f14b6d4cdb5c12167417ac2c6328d6","802d55a6761d4fe273fc4da344c2f87ff53ffc00fd449cac0c96f2257c0da923","53a6225a27da207eb922ace764f6467e3eb350461ad3e061d3c0858ff8317259","abd9ae506eea177fdcadd1eba1854f1d906ef27893e8a59d5389fcd3824a1862","a7dd6a087bd96008f4eedc97d83e5de410235788d679d66a99e0145a65141960","f9de433304b497da30174689c417c8966eaa5e4f000d2c595b0e4187dd4c59c8","4c9548afa875fd3d6a53729d559b24e408c2c23779bf5d1b9d6656cc9981f4cf","89cece9a302d9e89982007fd9827965a1ed034cffc474881061e87211465dfa8","ab2c85a232cf7f480259989db6e7d864d55