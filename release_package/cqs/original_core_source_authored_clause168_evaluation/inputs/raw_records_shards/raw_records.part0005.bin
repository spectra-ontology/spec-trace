{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is optionally present, need R, if idc-AssistanceConfig-r16 or idc-FDM-AssistanceConfig is setup. Otherwise, it is absent, need R.","paragraph_zero_based":5496},{"literal_text_all_w_t_and_m_t":"maxBW","paragraph_zero_based":5497},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need R, if maxBW-PreferenceConfig-r16 is setup; otherwise it is absent, need R.","paragraph_zero_based":5498},{"literal_text_all_w_t_and_m_t":"maxMIMO","paragraph_zero_based":5499},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need R, if maxMIMO-LayerPreferenceConfig-r16 is setup; otherwise it is absent, need R.","paragraph_zero_based":5500},{"literal_text_all_w_t_and_m_t":"minOffset","paragraph_zero_based":5501},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need R, if minSchedulingOffsetPreferenceConfig-r16 is setup; otherwise it is absent, need R.","paragraph_zero_based":5502},{"literal_text_all_w_t_and_m_t":"musimGapConfig","paragraph_zero_based":5503},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need R, if musim-GapAssistanceConfig-r17 is setup; otherwise it is absent, need R.","paragraph_zero_based":5504},{"literal_text_all_w_t_and_m_t":"SCG","paragraph_zero_based":5505},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need M, in an RRCReconfiguration message not within mrdc-SecondaryCellGroup and received, either via SRB3 within DLInformationTransferMRDC or via SRB1. Otherwise, it is absent.","paragraph_zero_based":5506},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5507},{"literal_text_all_w_t_and_m_t":"NEXT CHANGE","paragraph_zero_based":5508},{"literal_text_all_w_t_and_m_t":"6.4RRC multiplicity and type constraint values","paragraph_zero_based":5509},{"literal_text_all_w_t_and_m_t":"–Multiplicity and type constraint definitions","paragraph_zero_based":5510},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":5511},{"literal_text_all_w_t_and_m_t":"-- TAG-MULTIPLICITY-AND-TYPE-CONSTRAINT-DEFINITIONS-START","paragraph_zero_based":5512},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5513},{"literal_text_all_w_t_and_m_t":"maxFFS                                  INTEGER ::= 999     -- Maximum value is FFS","paragraph_zero_based":5514},{"literal_text_all_w_t_and_m_t":"maxAdditionalRACH-r17                   INTEGER ::= 256     -- Maximum number of additional RACH configurations.","paragraph_zero_based":5515},{"literal_text_all_w_t_and_m_t":"maxAI-DCI-PayloadSize-r16               INTEGER ::= 128      --Maximum size of the DCI payload scrambled with ai-RNTI","paragraph_zero_based":5516},{"literal_text_all_w_t_and_m_t":"maxAI-DCI-PayloadSize-1-r16             INTEGER ::= 127      --Maximum size of the DCI payload scrambled with ai-RNTI minus 1","paragraph_zero_based":5517},{"literal_text_all_w_t_and_m_t":"maxBandComb                             INTEGER ::= 65536   -- Maximum number of DL band combinations","paragraph_zero_based":5518},{"literal_text_all_w_t_and_m_t":"maxBandComb-MUSIM-r18                   INTEGER ::= 64      -- Maximum number of MUSIM bands and/or band combinations","paragraph_zero_based":5519}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["d5d1f36ffc2f323ba621a51c38a1968e9dab9fbe339b02fdffd9fb43bd832bd5","62139d66bfdb826ddcdec3995d1f544b509244007920e14392bcc903e3c825b4","2bc6ded41357fbdb2bb977bb3d6c3a5c27cbb7d494b630d500993b173c8ae243","f4d79ab95a90efe84ada9bfd7036305f