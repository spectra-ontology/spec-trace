{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"If halfDuplex is set to true, only half duplex operation is supported for the band, otherwise full duplex operation is supported.","paragraph_zero_based":3744},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3745},{"literal_text_all_w_t_and_m_t":"heightMeas","paragraph_zero_based":3746},{"literal_text_all_w_t_and_m_t":"Indicates whether UE supports the measurement events H1/H2.","paragraph_zero_based":3747},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3748},{"literal_text_all_w_t_and_m_t":"ho-EUTRA-5GC-FDD-TDD","paragraph_zero_based":3749},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports handover between E-UTRA/5GC FDD and E-UTRA/5GC TDD. ","paragraph_zero_based":3750},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":3751},{"literal_text_all_w_t_and_m_t":"ho-InterfreqEUTRA-5GC","paragraph_zero_based":3752},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports inter frequency handover within E-UTRA/5GC. ","paragraph_zero_based":3753},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3754},{"literal_text_all_w_t_and_m_t":"hybridCSI","paragraph_zero_based":3755},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports hybrid CSI transmission as described in TS 36.213 [23].","paragraph_zero_based":3756},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3757},{"literal_text_all_w_t_and_m_t":"idleInactiveValidityAreaList","paragraph_zero_based":3758},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports list of validity areas for measurements during RRC_IDLE and RRC_INACTIVE.","paragraph_zero_based":3759},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":3760},{"literal_text_all_w_t_and_m_t":"immMeasBT","paragraph_zero_based":3761},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports Bluetooth measurements in RRC connected mode.","paragraph_zero_based":3762},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3763},{"literal_text_all_w_t_and_m_t":"immMeasUnComBarPre","paragraph_zero_based":3764},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports uncompensated barometric pressure measurements in RRC connected mode.","paragraph_zero_based":3765},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3766},{"literal_text_all_w_t_and_m_t":"immMeasWLAN","paragraph_zero_based":3767}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["1368cbd7d3f1bd138b89090d8896adf13f70ab2e460aa403a52d7279e59cd14a","bb6d4fc73a18ebd353d0ac7355f24a3527fbd436bc7bf1cf39409c96a72c60ce","415d39e2209af1d2dcaf7dff469264a1d2dc20caa5cde8575db5308253a64287","64cb6cf658f6a6075fd661706b832e6ff27866c5c29088fc5ac1bc1187374c8b","a28b635180773a34d3ac201e563713555ac90dba105a97486f7cf6f81021eb83","a1e8282ac70139379c408feea22b0344e4480b0b2f3fe97dc8400f839eec7742","808fe3923b2a8e6d3075dadaf60098af94d42522be42e9f2a4186862971019be","c9bb23ec948eede4c81fa896db857e0252e1d45af522439cbdda0f8ddd9d7286","6597eb83462a3e6f743f64566b32836f0f040bb785d5ac4686dee69b521567b6","91e8d92ae092f8b258126ac1d2b3edc546732ed91e3f213c2f65880fee801c00","587f3d9e322bc3ca350f32e8ee32b2ec56ed09ce73c4c9ec51a7f76df1d41fa1","4e037c6cfc37f647904229c265c312fd6869e1413e6410ab065480215216b14d","c99e6a2d1c924b30240a6603f1a2c4b69feb440bce186c94df23bab749741498","fa1f8b9241a74e407c038500fc5525e1520a975206bd2adf705a4b490f97f00c","137348680568be068f9f23d776625d05ba346341616bf8238d8184a7d078d8a3","8c4f487bb32029ac3ecd9cda7202d06b4937a5c3c2fb13e73e020536cbf84584","d