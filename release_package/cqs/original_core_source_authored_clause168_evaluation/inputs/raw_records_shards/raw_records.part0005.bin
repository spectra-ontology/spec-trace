":{"document_XML_sha256":"4495a7d323453d2fb59c658e702b60f42d86f6325ecde37c1f1347fed1b371dc","original_member_sha256":"bb67c4ce90f1f4c0d2f5bba43fbf139e47fca6fb324e52e44bcf258d1775c74e","paragraph_ElementTree_utf8_XML_sha256":["e31d1c70af80a415e6fe868afb61e1110105c2203ab7d858cde2d8b1d782245f","4328dbc2e9ed59984edad9da9f918a037222a8bc1d4a7f801e449d0bf4e71fd0","1b57abbb250ccf0e7dbcfaad8666dd22e39df29408dc1d6e61b3298df1a31533","dca27312d7a1517d19ed558671871fab25e9b549c607883b97a78f9f3628f08a","6d3fba1314de1001e3753ed4f16b9c74cdf0271805f61b17dcc5b42bd590842f","617785343afc34ff86d7085e070e5171c849cf65b766df069d11ae4921b43535","e1e25530b020008a57c985b34dd07f86e78f06b1ebcf6ac4ad654e057d3546c0","cb9646e53a961acadd8b9d1cbe9977f71385aded0c0dd84e225defb7e8545ad8","e434e65a10e838afc9f35a37c5efebc215fd9aedc21692d7cc12941674744e85","48f27d1f338f2e6cabf1ff384625f9d1a5e67ab8190bf0af224f5e9fd5a2044d","c61eb6453a10f28874b2179452dc14076d1b206d442bb9b4811a14e997052358","731cd85286f824ffc8ab15b3e076faaf16231b040ec58d5b982eb0b04411f518","1d65da0d494e07341ad04482ee309076fabc3bccc58c39771f486df197880187","15446e336e26f8e8542354aaa67cefc1b9b0d8b4af76558f1b7e96594ab3e72b","032e9f858d3d59ab048f1c6847f25e5b233bb6ba0c88c96eee40690f328745ca","1ac810a1cab11c95a1df934fbe11d17d0c7b90f828c877e62a98a07ed58b7dfa","6315fa5299d2a4ab94f54fb88c7f787fdb12c09e29d8bee28f95682429dc01ad","b3f8ba76ec829a0eac6003bc8cbccaed17d41a62756dd1214cc8a7fa8c87c76d","ebb18e058d1fac3e0efc9941e530e6c9327f91af82e47a50969e70a111afea2a","e4aa19b16286782fd2defcc1f145907787440d4d560b23c1d047a79cb85d7dd4","dcb00a9e6c6c316c0088d2dc5f1b8ad2617b4424352762cd9029642ce44b55be","adf91afec1ef44a2388772bd7103ea6e4f36004e933a3b58dc00af5209fde022","500ae1e95311986e752b9be027e0c22a78d267c2f0de2c686523828721158b14","1cef444d894cdacbe559bb45e53c3b2ef7f77da82c45f0f24d784d4541645307"],"paragraph_range_zero_based":[24,47],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2409048.zip::R2-2409048_CR on 38.306 for Correction on PHR for mTRP PUSCH repetition (R18).docx:p24"}
{"fields":{"filename":"R2-2409048.zip::R2-2409048_CR on 38.306 for Correction on PHR for mTRP PUSCH repetition (R18).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"A","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Rel-18","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-17(Release 17)Rel-18(Release 18)Rel-19(Release 19) Rel-20(Release 20)","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":"Reason for change:","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"1.  Based on RAN1 reply LS (R1-2405619), RAN2 agreed that no Type 3 PH value is reported for a serving cell configured with mTRP PUSCH repetition, if the MAC entity the serving cell belongs to is configured with twoPHRMode.","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"In order to distinguish between UEs already implemented to report Type 3 PH value and UEs implemented to report only Type 1 PH value, a new UE capability is introduced.","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"1. Introduce a new UE capability indicating that UE supports reporting of Type 1 power headroom information only, for the case where the Serving Cell is configured with multiple TRP PUSCH repetition and the MAC entity this Serving Cell belongs to is configured with twoPHRMode.","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"Impact analysis","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"Impacted functionality: FeMIMO.","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"Inter-operability: ","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"4495a7d323453d2fb59c658e702b60f42d86f6325ecde37c1f1347fed1b371dc","original_member_sha256":"bb67c4ce90f1f4c0d2f5bba43fbf139e47fca6fb324e52e44bcf258d1775c74e","paragraph_ElementTree_utf8_XML_sha256":["e4ea5591218aa96d0cd407936b651eb165fb4c75e229dab64ec9de6be991cb96","2d00e3b1a82065155328ddd802c3d4a8ebff11f4a0d6da9ecf9b1e34dc8ebfc8","1988a338ab722e1794c3000671970cdeeabe0c495462175dac3c36e4e8eb6ad9","761fa4d36b282591b5f5bb5ee554c6086f6eb9d5925f257d405f142f9e3a17e1","9ee3a8ef1b4d8b5d23ae68c79878f83d9a7ffdf02ec93cff53f7b1de6029f4d6","2661ed59da228092d451476a4e822d6bd348f481b2e2ad8e28485739ae5cbbb2","b08252b53f111fda758564f01d6aeb287a86ceee9730eba0ca5fcf7c7dadb00e","5397ebe3cc2afa3393b897343a62f60e5b485315d8236802a715ec930f5cc336","9179ba236853e4a73f15d3d408619f0f62540850e6daa878c17cdc8a8f26dbb9","dd3de490bf00baf5087f33777fa272abbec9623033d71526d5355fb97ee7f36f","16c8d70f7d429c511b56c375317337c5d5c75b5a185ec91bf088b77069963fb7","acd6206245de4b9556a4853ff1b8b41875944834aa76df6c7d72af763f365262","3c4c80e1e11044a4d07c2d065ab1badcf74a3b84af6435503a27154aade28f9b","fae9f291b5bf82aef5018fe0f0416002364a9db1775e9d25847e1415ce1e7340","bd9e8e8332d796086d89f4d2370ade87178004322530a02172a6b9a2bbb09039","912e1ea0f6e7575f06c689f9bd36172bfa41b78d00ef71400c61f28f0d327223","8b24573e0133d1c5ee95e1377545628b16380b4d3d980bde5296376e8173041e","7423559940944ed0cc1fe176b76253cf9035dcdbfc0fac2f3e385feb311a2329","288cc60197c635a28716a1c3a9133085106b36b1009fb0a2849670c1b99dfd9f","262576484c0cf8caa11ab1e87d062af12e952718d8409535a257ad717167e22f","cfc62a8c9d0a8f5d018357c02c0af1b960572fc4a3901c1cf00360138d1b0518","2f1d14b5bec539e2fb2179ccb21ccb3052bfaafff844d12af1b1c929ffe4890d","594b35b95231df3bcbb0a720cbd5d9befaaaa035a12e740950f6e69516f4794c","7e2216168f2000b6023dd5431930234ea762e46299005bda72cc6bc2d2edc4d4"],"paragraph_range_zero_based":[48,71],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2409048.zip::R2-2409048_CR on 38.306 for Correction on PHR for mTRP PUSCH repetition (R18).docx:p48"}
{"fields":{"filename":"R2-2409048.zip::R2-2409048_CR on 38.306 for Correction on PHR for mTRP PUSCH repetition (R18).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"If the network is implemented according to the CR and the UE is not, the network may not correctly decode Enhanced Multiple Entry PHR for mTRP MAC CE.","paragraph_zero_based":72},{"literal_text_all_w_t_and_m_t":"If the UE is implemented according to the CR and the network is not, the network may not correctly decode Enhanced Muyltiple Entry PHR for mTRP MAC CE.","paragraph_zero_based":73},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":74},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":75},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":76},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":77},{"literal_text_all_w_t_and_m_t":"The UE and the network may have different understanding on whether two Type 1 PH values or one Type 3 HP value is included in Enhanced Multiple Entry PHR for mTRP MAC CE, so there may be a misalignment between the UE and the network.","paragraph_zero_based":78},{"literal_text_all_w_t_and_m_t":"Thus, the network may not decode Enhanced Multiple Entry PHR for mTRP MAC CE correctly","paragraph_zero_based":79},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":80},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":81},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":82},{"literal_text_all_w_t_and_m_t":"4.2.6.1","paragraph_zero_based":83},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":84},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":85},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":86},{"literal_text_all_w_t_and_m_t":"Y","paragraph_zero_based":87},{"literal_text_all_w_t_and_m_t":"N","paragraph_zero_based":88},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":89},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":90},{"literal_text_all_w_t_and_m_t":"Other specs","paragraph_zero_based":91},{"literal_text_all_w_t_and_m_t":"X","paragraph_zero_based":92},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":93},{"literal_text_all_w_t_and_m_t":" Other core specifications","paragraph_zero_based":94},{"literal_text_all_w_t_and_m_t":"TS 38.321 CR 1893r2","paragraph_zero_based":95}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"4495a7d323453d2fb59c658e702b60f42d86f6325ecde37c1f1347fed1b371dc","original_member_sha256":"bb67c4ce90f1f4c0d2f5bba43fbf139e47fca6fb324e52e44bcf258d1775c74e","paragraph_ElementTree_utf8_XML_sha256":["987caa6e485d940b17801bfb121d0943a266b4eac52ae48a89bb16996ff99cf2","0d88c0b9110b6f88e39ffacee9275059f57d3a08e37dc6d9af11bab147fbeddd","e823f848bdf4512c62b4f78d08e6bf065f176f45c41b6adc2017fcc7680c968b","23da18bbbcbc650fad7a07ef8006251a7a06ae59113986d1a2b8d37f6d71a8d1","85f9fe225bf206da5b28016fbb39c62cb1368eb1244f4f20547ea6629294dc69","378adf0aa423995360841de5b3ff121413a3320bd55a44c2044b1a4823324310","e6a88ba5f45b917e4bfa80d7abbea1a9018eb9652ed7fb0bbdd90e6c4e2d2b07","7f4d45a02f4c10ca682bf3001c98506a15635c714328c6e5d4c32647f9ae50f9","d3098623b4dfc23a1a4b383cc6c305d01a4c1c56ac54d5853c2f6542bbe0ad3e","d88bc81b05cdcb5373fcefe52e78f5e5b7ea4e37e19c0d9ebb00bb2abbe8ad2d","61cf31ccb32ca743f815831546a63f3d4f37ea5f4ff7e02e623d0e686dc91277","684f4be9a8e98a1c001c876e77be3138ecc06bb88458a5a3d39e3c5f493242a5","d3262b1816fab55992cffb02c05a6ffa91b6523e243fbbc95fea56d1d4a60b90","c3683d587e9395b4366df402366a37ae834beabe3792a5a1f587771601d39ee1","ed998830d31c45491e1e0440155b1f04906345d5cf11cf124da3b8514b084b6e","906013edb57524be9364140bb342f747d25cd914a658ac9688cc0e1c36c48a4e","cab89597302c5ba322c3b7522dfdc53fa38c04425d13ef616d215a001889c126","cb1f68c3cb7a527ab8d0f7a4b7dbf74587c5012a7899a22e9846e53e203421fe","65ac24