{"fields":{"filename":"R2-2408214.zip::R2-2408214 Correction on UE capability of supporting NavIC in A-GNSS positioning (R17).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":168},{"literal_text_all_w_t_and_m_t":" ","paragraph_zero_based":169},{"literal_text_all_w_t_and_m_t":"GNSS-AlmanacSupport ::=SEQUENCE {","paragraph_zero_based":170},{"literal_text_all_w_t_and_m_t":"almanacModelBIT STRING {model-1(0),","paragraph_zero_based":171},{"literal_text_all_w_t_and_m_t":"model-2(1),","paragraph_zero_based":172},{"literal_text_all_w_t_and_m_t":"model-3(2),","paragraph_zero_based":173},{"literal_text_all_w_t_and_m_t":"model-4(3),","paragraph_zero_based":174},{"literal_text_all_w_t_and_m_t":"model-5(4),","paragraph_zero_based":175},{"literal_text_all_w_t_and_m_t":"model-6(5),","paragraph_zero_based":176},{"literal_text_all_w_t_and_m_t":"model-7(6),","paragraph_zero_based":177},{"literal_text_all_w_t_and_m_t":"model-8-v16xy     (7) } (SIZE (1..8))OPTIONAL,","paragraph_zero_based":178},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":179},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":180},{"literal_text_all_w_t_and_m_t":" ","paragraph_zero_based":181},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":182},{"literal_text_all_w_t_and_m_t":" ","paragraph_zero_based":183},{"literal_text_all_w_t_and_m_t":"GNSS-AlmanacSupport field descriptions","paragraph_zero_based":184},{"literal_text_all_w_t_and_m_t":"almanacModel","paragraph_zero_based":185},{"literal_text_all_w_t_and_m_t":"This field specifies the almanacModel choice(s) in GNSS-Almanac IE supported by the target device for the GNSS indicated by GNSSID. This is represented by a bit string, with a onevalue at the bit position means the particular almanac model is supported; a zerovalue means not supported.","paragraph_zero_based":186},{"literal_text_all_w_t_and_m_t":"If the target device supports GPS and GNSS-Almanac assistance, it shall support Model-2.","paragraph_zero_based":187},{"literal_text_all_w_t_and_m_t":"If the target device supports SBAS and GNSS-Almanac assistance, it shall support Model-6.","paragraph_zero_based":188},{"literal_text_all_w_t_and_m_t":"If the target device supports QZSS and GNSS-Almanac assistance, it shall support Model-2.","paragraph_zero_based":189},{"literal_text_all_w_t_and_m_t":"If the target device supports Galileo and GNSS-Almanac assistance, it shall support Model-1.","paragraph_zero_based":190},{"literal_text_all_w_t_and_m_t":"If the target device supports GLONASS and GNSS-Almanac assistance, it shall support Model-5.","paragraph_zero_based":191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e51c2517ccef31616c1373519700b9598c20468e8d5224cbb63673246fdebcc3","original_member_sha256":"11e2ab804fb64d6fce64573faf419b8f335f0b1fa79af34934bcd97c1b0d748e","paragraph_ElementTree_utf8_XML_sha256":["8e682d998e0680baad900dcbcaffb17864ada3b74cf81ce0edff62ecb33aa547","a3a9fe13ba37b488da597447e8b2f3fa8cddf6aaa28827420e1bfb3b73219adb","8ab3773fd11a653b369f1c6390a7f40a097885bef9ccc32370d63904a0a03954","566837db17ea949dfd96cd3ade0d90c513d146bc8fec9eb2b50e6f28dd957789","25154c03f718df117b9704b0b092cbcfefcc3f9eed5f75d237a94933f8adaf53","7667879b445a0653f4193b878e9c734a249331d43c89ef78930ab2939b3e6992","42127fa276b3ee0a70b1034b5245c938aa3152fefe86cc51cfa95fb671afe0c8","31e434cc4c84869430cff80ee0e8b6d41e7d3824bc75d61dd8099aeb0c98bf43","1e2347f5b0ca1f1fa990246a7f05dd295bcaf3ddf1823cc26d3df0865e710e74","9581a57a8577e18f389b7db6c668a8405b6fae61ee26fa181afe47fa6b761eb3","98833b3f4c095efe6d6e4fe25f5c15acb6caff10cbfec725a0cdcc72ed57b591","7f548acba7097ca5529a4ec286b3f1f6a4a57cf9844982d3070b2013c6c815b6","047406c4ad1988f75276e067f4656f3a9f73c5c2102aa37786bb360d304da767","a3a9fe13ba37b488da597447e8b2f3fa8cddf6aaa28827420e1bfb3b73219adb","52ebd33278b04e96c9e0a7c80df2d213e2b3eb16d3077cbe8feeacfb83ecc308","ab3f4752e967f095f8bf42cf79834206e3a545205632e867ae657eacebd1d79c","935db65dff15ed52f933558980275d88184a76154a499f2e879d59383439070a","14c1d04ef3f6318a575973531466ee9a4aac4711caec8b7aa5cef3e8b78f2deb","80259ba1e3ea6c6c6f19df84db3600070561f635afd6b2ff6374f067904329a7","4450600e36af829c92162559cd9b55e394185700256e458b3800ceeea5a8f468","8d14035351b4a58b76f8bedec96e1438703eddfc887d1747fe25b55b6cb22af3","4e9e579baa70b4749f0f7c01acd687605cdbc9d5e8d8b1fef964abfa8ae25052","88c79390355387adfa253ed6f75ff6fe33fed739b0eb1425f222879c9978d760","0c9c1ba644703fac78ba59c6672dfa2785b2767ee022304df3fa9b66d3ff3154"],"paragraph_range_zero_based":[168,191],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2408214.zip::R2-2408214 Correction on UE capability of supporting NavIC in A-GNSS positioning (R17).docx:p168"}
{"fields":{"filename":"R2-2408214.zip::R2-2408214 Correction on UE capability of supporting NavIC in A-GNSS positioning (R17).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"If the target device supports BDS and GNSS-Almanac assistance, it shall support Model-7.","paragraph_zero_based":192},{"literal_text_all_w_t_and_m_t":"If the target device supports NavIC and GNSS-Almanac assistance, it shall support Model-8.","paragraph_zero_based":193},{"literal_text_all_w_t_and_m_t":"If this field is absent, the target device supports the mandatory (native) almanacModel choice only as listed above for the GNSS indicated by GNSSID.","paragraph_zero_based":194},{"literal_text_all_w_t_and_m_t":" ","paragraph_zero_based":195},{"literal_text_all_w_t_and_m_t":"–GNSS-UTC-ModelSupport","paragraph_zero_based":196},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":197},{"literal_text_all_w_t_and_m_t":" ","paragraph_zero_based":198},{"literal_text_all_w_t_and_m_t":"GNSS-UTC-ModelSupport ::=SEQUENCE {","paragraph_zero_based":199},{"literal_text_all_w_t_and_m_t":"utc-ModelBIT STRING {model-1(0),","paragraph_zero_based":200},{"literal_text_all_w_t_and_m_t":"model-2(1),","paragraph_zero_based":201},{"literal_text_all_w_t_and_m_t":"model-3(2),","paragraph_zero_based":202},{"literal_text_all_w_t_and_m_t":"model-4(3),","paragraph_zero_based":203},{"literal_text_all_w_t_and_m_t":"model-5(4) } (SIZE (1..8))OPTIONAL,","paragraph_zero_based":204},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":205},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":206},{"literal_text_all_w_t_and_m_t":" ","paragraph_zero_based":207},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":208},{"literal_text_all_w_t_and_m_t":" ","paragraph_zero_based":209},{"literal_text_all_w_t_and_m_t":"GNSS-UTC-ModelSupport field descriptions","paragraph_zero_based":210},{"literal_text_all_w_t_and_m_t":"utc-Model","paragraph_zero_based":211},{"literal_text_all_w_t_and_m_t":"This field specifies the GNSS-UTC-Model choice(s) in GNSS-UTC-Model IE supported by the target device for the GNSS indicated by GNSSID. This is represented by a bit string, with a onevalue at the bit position means the particular UTC model is supported; a zerovalue means not supported.","paragraph_zero_based":212},{"literal_text_all_w_t_and_m_t":"If the target device supports GPS and GNSS-UTC-Model assistance, it shall support Model-1.","paragraph_zero_based":213},{"literal_text_all_w_t_and_m_t":"If the target device supports SBAS and GNSS-UTC-Model assistance, it shall support Model-4.","paragraph_zero_based":214},{"literal_text_all_w_t_and_m_t":"If the target device supports QZSS and GNSS-UTC-Model assistance, it shall support Model-1.","paragraph_zero_based":215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e51c2517ccef31616c1373519700b9598c20468e8d5224cbb63673246fdebcc3","original_member_sha256":"11e2ab804fb64d6fce64573faf419b8f335f0b1fa79af34934bcd97c1b0d748e","paragraph_ElementTree_utf8_XML_sha256":["6784ad4baa8ff47c05c30f7153070c32088f6b8ec6cd9bfc968470445b57b551","e09f60a9c79ec7ecb8a0e4675ee2bf24b64267c8aed900d7d28ec793807284b3","de68a379edd1ec5c355bb7b8ebc33f4789d6a3938a23eb28d0a801e4da488ab5","ab3f4752e967f095f8bf42cf79834206e3a545205632e867ae657eacebd1d79c","6662581d1bb02431a349ca7cc4131ffa1eb1cd9fc3f6dbbc2bb51f6b22b1bea6","8e682d998e0680baad900dcbcaffb17864ada3b74cf81ce0edff62ecb33aa547","a3a9fe13ba37b488da597447e8b2f3fa8cddf6aaa28827420e1bfb3b73219adb","8195811a0b6bebb6c9b8e89655038cda0e057bb4a17ae24d790406a8d496ae64","4ae58a570435bf7703309fcc51b380614e0958feea910c49fdc854fde1c65568","ad6d8611edc0a48611eedebdd0d5de46833540d7af87ce4b59b6c8268ac28895","0c500a5c1a7938c67f9ce9af58278dc5891d2efe7fe340938c4d65069ee9c12c","2f9dc1bfdc7477f2ac7e52b49a91aad8621089d6818e49cecbe1