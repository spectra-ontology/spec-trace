{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"timeSinceCPAC-Reconfig","paragraph_zero_based":3936},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the time elapsed between the initiation of the last conditional reconfiguration execution towards the target PSCell and the reception of the latest conditional reconfiguration for this target PSCell. Actual value = field value * 100ms. The maximum value 1023 means 102.3s or longer.","paragraph_zero_based":3937},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3938},{"literal_text_all_w_t_and_m_t":"CSI-LogMeasReport field descriptions","paragraph_zero_based":3939},{"literal_text_all_w_t_and_m_t":"cellId","paragraph_zero_based":3940},{"literal_text_all_w_t_and_m_t":"This field indicates the CGI of the cell in which the logging of the measurements included within csi-LogMeasInfoList was performed. If the CGI is not available, this field indicates the PCI-ARFCN-NR of the cell.","paragraph_zero_based":3941},{"literal_text_all_w_t_and_m_t":"csi-MoreLogMeasAvailable","paragraph_zero_based":3942},{"literal_text_all_w_t_and_m_t":"This field is included if the UE has additional logged L1 radio measurements available for transmission.","paragraph_zero_based":3943},{"literal_text_all_w_t_and_m_t":"csi-RS-MeasResultList","paragraph_zero_based":3944},{"literal_text_all_w_t_and_m_t":"List of logged L1 radio measurement results associated to CSI-RS resources.","paragraph_zero_based":3945},{"literal_text_all_w_t_and_m_t":"l1-RSRP","paragraph_zero_based":3946},{"literal_text_all_w_t_and_m_t":"Indicates the measured L1 RSRP associated to the resourceId, if included within CSI-RS-MeasResult. Indicates the measured L1 RSRP associated to the ssb-Id, if included within SSB-MeasResult.","paragraph_zero_based":3947},{"literal_text_all_w_t_and_m_t":"refCSI-LoggedMeasurementConfigId","paragraph_zero_based":3948},{"literal_text_all_w_t_and_m_t":"Reference to the instance of CSI-LoggedMeasurementConfig associated to the L1 radio measurement results reported in csi-RS-MeasResultList or ssb-MeasResultList.","paragraph_zero_based":3949},{"literal_text_all_w_t_and_m_t":"resourceId","paragraph_zero_based":3950},{"literal_text_all_w_t_and_m_t":"Indicates the NZP-CSI-RS-ResourceId associated to which the UE has logged L1 radio measurement results.","paragraph_zero_based":3951},{"literal_text_all_w_t_and_m_t":"ssb-Id","paragraph_zero_based":3952},{"literal_text_all_w_t_and_m_t":"Indicates the SSB-Index associated to which the UE has logged L1 radio measurement results.","paragraph_zero_based":3953},{"literal_text_all_w_t_and_m_t":"ssb-MeasResultList","paragraph_zero_based":3954},{"literal_text_all_w_t_and_m_t":"List of logged L1 radio measurement results associated to SSBs.","paragraph_zero_based":3955},{"literal_text_all_w_t_and_m_t":"timeGap","paragraph_zero_based":3956},{"literal_text_all_w_t_and_m_t":"Indicates that there was a time gap, longer than the logging periodicity, between the reported measurement results in this instance of csi-LogMeasInfoList and the previous instance of csi-LogMeasInfoList with the same refCSI-LoggedMeasurementConfigId for the same serving cell.","paragraph_zero_based":3957},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3958},{"literal_text_all_w_t_and_m_t":"NEXT CHANGE","paragraph_zero_based":3959}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["8cdc738c83a9329960dad06fefca2e0321927655a0b9b4c1d9d41896b955cc7d","4e0f3dd9dde9f2cdb20b0f28e4f8c32ebc6339606a9875e30d3e4f36939737d4","