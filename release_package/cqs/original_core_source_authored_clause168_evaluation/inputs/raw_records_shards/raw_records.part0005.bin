6d4f3dfd71e5b11f9015d259292527","83cf76e78aface817d38f260ae499cc3830e2534758048f9aa4dbd99ad84f928","93632a5b2c035f085efb35fd41ad75f3ba9854e5782d9e180ba692272d686de4","d6b310b21f3b13b9d19e98a61818f828db423082bed26e2537446d25234aa75b","c65bc981ad15b1d3425f97a487e3a28133ddf11a1c38e9ec19504d6d7b703dbc"],"paragraph_range_zero_based":[576,599],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509465.zip::R2-2509465.docx:p576"}
{"fields":{"filename":"R2-2509465.zip::R2-2509465.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}OPTIONAL, -- Need ON","paragraph_zero_based":600},{"literal_text_all_w_t_and_m_t":"reducedDL-PRS-ProcessingSamples-r17ENUMERATED { requested, ... }","paragraph_zero_based":601},{"literal_text_all_w_t_and_m_t":"OPTIONAL, -- Need ON","paragraph_zero_based":602},{"literal_text_all_w_t_and_m_t":"lowerRxBeamSweepingFactor-FR2-r17ENUMERATED { requested }OPTIONAL  -- Need ON","paragraph_zero_based":603},{"literal_text_all_w_t_and_m_t":"]],","paragraph_zero_based":604},{"literal_text_all_w_t_and_m_t":"[[","paragraph_zero_based":605},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-MeasurementTimeWindowsConfig-r18","paragraph_zero_based":606},{"literal_text_all_w_t_and_m_t":"NR-DL-PRS-MeasurementTimeWindowsConfig-r18OPTIONAL  -- Need ON","paragraph_zero_based":607},{"literal_text_all_w_t_and_m_t":"]]","paragraph_zero_based":608},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":609},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":610},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":611},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":612},{"literal_text_all_w_t_and_m_t":"NR-DL-AoD-RequestLocationInformation field descriptions","paragraph_zero_based":613},{"literal_text_all_w_t_and_m_t":"nr-AssistanceAvailability","paragraph_zero_based":614},{"literal_text_all_w_t_and_m_t":"This field indicates whether the target device may request additional DL-PRS assistance data from the server. TRUE means allowed and FALSE means not allowed.","paragraph_zero_based":615},{"literal_text_all_w_t_and_m_t":"multiMeasInSameReport","paragraph_zero_based":616},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to provide multiple measurement instances in a single measurement report; i.e., include the nr-DL-AoD-SignalMeasurementInstances (in the case of UE-assisted mode is requested) or nr-DL-AoD-LocationInformationInstances (in the case of UE-based mode is requested) in IE NR-DL-AoD-ProvideLocationInformation.","paragraph_zero_based":617},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-RxHoppingRequest","paragraph_zero_based":618},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to perform DL-PRS Rx hopping for performing RSRP or RSRPP measurements and report the hopping information used for performing the measurements.","paragraph_zero_based":619},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-RxHoppingTotalBandwidth","paragraph_zero_based":620},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates the total bandwidth of all hops in MHz. If the configured value nr-DL-PRS-RxHoppingTotalBandwidth is larger than the configured DL-PRS bandwidth in the provided assistance data, the UE shall assume that the actual nr-DL-PRS-RxHoppingTotalBandwidth is equal to the width of the configured DL-PRS in the provided assistance data.","paragraph_zero_based":621},{"literal_text_all_w_t_and_m_t":"maxDL-PRS-RSRP-MeasurementsPerTRP","paragraph_zero_based":622},{"literal_text_all_w_t_and_m_t":"This field specifies the maximum number of DL-PRS RSRP measurements on different DL-PRS Resources from the same TRP. If this field with -r17 suffix is present, the field with -r16 suffix should not be present.","paragraph_zero_based":623}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"031803c101a10e427d1f230cc629e09e0bd01d184d1e2938f387ad803c3911dc","original_member_sha256":"2bae8d5ac03017cc49187eaa8fa5f66dd9d41d8add52aa40b5603598875c82af","paragraph_ElementTree_utf8_XML_sha256":["d75172dcc8b23b9f554da36cd0b0421a434e76ca3d30a29ad6d365d0b0b7d994","48b635f0264fd0baf0061b4a93b25592fded94df170b2474fb11afa9267c2595","55ec43b527d929cf7b9d0b424e0b6e84da9df6b2