{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3024},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":3025},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3026},{"literal_text_all_w_t_and_m_t":"UE-EUTRA-Capability field descriptions","paragraph_zero_based":3027},{"literal_text_all_w_t_and_m_t":"FDD/ TDD diff","paragraph_zero_based":3028},{"literal_text_all_w_t_and_m_t":"a4-a5-ReportOnLeaveSupport","paragraph_zero_based":3029},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports a4-a5-ReportOnLeave in the report configuration.","paragraph_zero_based":3030},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3031},{"literal_text_all_w_t_and_m_t":"accessStratumRelease","paragraph_zero_based":3032},{"literal_text_all_w_t_and_m_t":"This field indicates the release supported by the UE. NOTE 7.","paragraph_zero_based":3033},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3034},{"literal_text_all_w_t_and_m_t":"additionalRx-Tx-PerformanceReq","paragraph_zero_based":3035},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports the additional Rx and Tx performance requirement for a given band combination as specified in TS 36.101 [42].","paragraph_zero_based":3036},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3037},{"literal_text_all_w_t_and_m_t":"addSRS","paragraph_zero_based":3038},{"literal_text_all_w_t_and_m_t":"Presence of this field indicates the UE supports the additional SRS symbol(s) within the normal UL subframes in TDD as described in TS 36.213 [23]. ","paragraph_zero_based":3039},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3040},{"literal_text_all_w_t_and_m_t":"addSRS-1T2R","paragraph_zero_based":3041},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports selecting one antenna among two antennas to transmit additional SRS symbol(s) for the corresponding band of the band combination as described in TS 36.213 [23].","paragraph_zero_based":3042},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3043},{"literal_text_all_w_t_and_m_t":"addSRS-1T4R","paragraph_zero_based":3044},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports selecting one antenna among four antennas to transmit additional SRS symbol(s) for the corresponding band of the band combination as described in TS 36.213 [23].","paragraph_zero_based":3045},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3046},{"literal_text_all_w_t_and_m_t":"addSRS-2T4R-2Pairs","paragraph_zero_based":3047}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["8f498a17105d92c89a40752ac63f25134d0a70eab636f0faaa18471e7065ffc0","1161ddbd00ac38b654cf2d557dc14fcf719c9a55660c0e4ad07ab21ef87c9d88","bda35b8bd629b783d721e8af88fd69fcb4cd063e0eee5c4b1074f5af1ae43b76","1045c1d1b578e3d1801e11519e773da1dfbb03c9b584b996c68b07b4068daf1a","9e9caeea6c60c03dfa5dd70ba3a11e829833a87c4be7c69bb7fbcb93e048eb70","8bd0915aa130c822179f41839c9d4c52033d8d7be4ec60c3b514ef62a0250fc5","5988c80f8df23d8917c284348d72779c8307d56322f0cd6a8aecd55ec9fd3105","5b8fb4c7b4e69a28a4a1a086e21272b39f4b3ec950793fa9f38a04193a33ed27","a87de6228e56c2fe471dabcb6034c4e9b1fdb27f7e5b7781c1d8c01fe0a6a223","6e1a6d1ef56c81573414248483c0a0dc3a7e0349648c69e46770eb9ed58c560b","a0dd09085b19f21f1d4806e336e9f09546171943c0ea16ee1412178b152ffd72","8910599867ff31aff60e116e4c2c4dfb8d48af207b30b30e5c60cac218ae2f25","97ae249cbb17c6167e4ecfad990327b8f1af007fdce15b212b88a35669797114","045d0ed40f9a0caff376c0c43472bc13e9dab3011b18bafd80719c76244823d7","3dfe766afc9a28124b89ce3516a9d60bf0b85a4d529d97727a29ea17854242f6","4c0db92f41b6431ce0b1991c80d73ef6e41982812e984e439c78ddd4c43961ea","60d054b817b190d0dc0851b515f6dc470c0c2be43c3408e912a17505d56ecc2a","ca10f88cd0b19dc9d2686f71182bb8d951cbde6bd9701955499ec605b2e641bf","043552779a39eea3c02922df0fd544eda803de64c18397183bd4023e1b1614c1","438517318c987ef5f75847d82757536f22ba035946d85ec5194d3692d33ff8dc","33602c938e781c64353fd2eb96ac573241a462ea10b0bd01ea546c2afe23c370","e927a43ec2772eb4892367eba2f8f522c12056a7f5ec87c266579dc1ade638b5","ad93f9cf638c7c5d682b5fd18e73506eb1282b72bda3b601e36682b07af1e752","a0a3ef2e20f8803dc651140a7f3dac0a319ab413b6005737f9d9222bcaed5c29"],"paragraph_range_zero_based":[3024,3047],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p3024"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports selecting one antenna pair between two antenna pairs to transmit additional SRS symbol(s) simultaneously for the corresponding band of the band combination as described in TS 36.213 [23].","paragraph_zero_based":3048},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3049},{"literal_text_all_w_t_and_m_t":"addSRS-2T4R-3Pairs","paragraph_zero_based":3050},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports selecting one antenna pair among three antenna pairs to transmit additional SRS symbol(s) simultaneously for the corresponding band of the band combination as described in TS 36.213 [23].","paragraph_zero_based":3051},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3052},{"literal_text_all_w_t_and_m_t":"addSRS-AntennaSwitching (in addSRS)","paragraph_zero_based":3053},{"literal_text_all_w_t_and_m_t":"Value useBasic indicates the antenna switching capabilities for additional SRS symbol(s) for a band of band combination for which the capability is not signalled in bandParameterList-v1610 is the same as indicated by bandParameterList-v1380 and/or bandParameterList-v1530 for the concerned band of band combination. ","paragraph_zero_based":3054},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3055},{"literal_text_all_w_t_and_m_t":"addSRS-AntennaSwitching (in bandParameterList-v1610)","paragraph_zero_based":3056},{"literal_text_all_w_t_and_m_t":"If signalled, the field indicates the antenna switching capabilities for additional SRS symbol(s) for the concerned band of band combination.","paragraph_zero_based":3057},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3058},{"literal_text_all_w_t_and_m_t":"addSRS-CarrierSwitching (in addSRS)","paragraph_zero_based":3059},{"literal_text_all_w_t_and_m_t":"Indicates whether carrier switching is supported for additional SRS symbol(s) for all band pairs of band combinations for which UE supports SRS carrier switching. This field is included only if srs-CapabilityPerBandPairList-r14 is included. If this field is included, addSRS-CarrierSwitching (in bandParameterList-v1610) is not included.","paragraph_zero_based":3060},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3061},{"literal_text_all_w_t_and_m_t":"addSRS-CarrierSwitching (in bandParameterList-v1610)","paragraph_zero_based":3062},{"literal_text_all_w_t_and_m_t":"Indicates whether carrier switching is supported for additional SRS symbol(s) for the concerned band pair of band combination. This field is included only if srs-CapabilityPerBandPairList-r14 is included.If this field is included, addSRS-CarrierSwitching (in addSRS) is not included.","paragraph_zero_based":3063},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3064},{"literal_text_all_w_t_and_m_t":"addSRS-FrequencyHopping (in addSRS)","paragraph_zero_based":3065},{"literal_text_all_w_t_and_m_t":"Indicates whether frequency hopping is supported for additional SRS symbol(s) for all bands of band combinations for which the capability is not signalled in bandParameterList-v1610.","paragraph_zero_based":3066},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3067},{"literal_text_all_w_t_and_m_t":"addSRS-FrequencyHopping (in bandParameterList-v1610)","paragraph_zero_based":3068},{"literal_text_all_w_t_and_m_t":"If signalled, the field indicates whether frequency hopping is supported for additional SRS symbol(s) for the concerned band of band combination.","paragraph_zero_based":3069},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3070},{"literal_text_all_w_t_and_m_t":"allowedCellList","paragraph_zero_based":3071}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["995a4be16298c574424b97675c8ff6c50253cc8d3914c1e7a46fc65b3361852d","599745b65add7d65413065097a54485650d2506f525ae01beec66d91ad968f5d","bbcd297f25aa028bb095f6c443b42c94b39d7cc8cdd1dab79af3c75a02d9b4f2","9e1fd789cd2b5525fcc9619706e740101a91fc4c1297ae5654be77a2a04cdf4c","f13b50135fc3e2072b308f36fe69abfc3477f622a9b9de4594e4fe05ca8df556","59596ab83c9e3f8a6e6795567ca7ccfbfabd9d0cd16214b1593491261a40ad2b","afe187f8745ca6c85c6a569f9ad1984743c563b470506a8741275657ff58a9d9","a54000bf065352372124b0475bb7e6088b99f3f29210bf303f3e76e3d53d3258","b8a5f3361ad4cc7ddee0164d9ad80c337826ba26ad6b071f7ed00c32c14736ec","c5897730f036288f57f7343e8bba6c709dfbfc18adac791b17598465249ac5fe","f11ea501ff5b2153fa30422ea1e1ba78a43eff2c385377e9e94329790c4cc45c","f8dd4427208a2c7bc68224d5b98fd2aaab1bb960a732d877a045bd97273a12e6","f7576bbbedcb9470e15197ed6bdb6c47987f91ab97a542a2b4e8fc43a6455e2b","ae2c66a664cc8ff4ac577c83f7c3a14528a9fbfe9b6e7fed4530077804500044","02343b5734d293291ce6bdfd08a7144efc041700a2a316eacaf62bde3a2bb4ee","cac40a191ae96983cf8552d30bf26471c28535f3ff3a8cd88ee8303c626d0bf8","cf51b7b5a4ea21a9df2b1585214b6125f62c15f7ef871995d54894eddaf2bbd2","6a089bef06dacae59ac14e0e5bae2f786c018dde891da827231e61405b356cbd","fdb52debf2b6235139166972548cd9cb06512e89e5023ba2d62a356a1cd49118","a38253b8cc060968a58b1fdf870c79524347eaea5b6bddbbb5a65cc38eecfdb4","4d61c70b3937d3525d5fd4c44b663cd01d189352f6336a173bcb0c8685eb771b","b66cc7824f5137dd75182b1ba43c045e0b3f190bcdda278a6d8d12e2d57f34df","8e2f2aff05b550c0ca59612f6ebbb9b5654fd35b939b06917cfd1ef4c16e0529","b0bff8c81f635f09f2835400f338f6fe40f42775c5c9ce80706d79c17dc2da3a"],"paragraph_range_zero_based":[3048,3071],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p3048"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports EUTRA allowed-cell listing to limit the set of cells applicable for measurements.","paragraph_zero_based":3072},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3073},{"literal_text_all_w_t_and_m_t":"alternativeTBS-Indices","paragraph_zero_based":3074},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports alternative TBS indices ITBS 26A and 33A as specified in TS 36.213 [23].","paragraph_zero_based":3075},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3076},{"literal_text_all_w_t_and_m_t":"alternativeTBS-Index","paragraph_zero_based":3077},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports alternative TBS index ITBS 33B as specified in TS 36.213 [23].","paragraph_zero_based":3078},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":3079},{"literal_text_all_w_t_and_m_t":"alternativeTimeToTrigger","paragraph_zero_based":3080},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports alternativeTimeToTrigger.","paragraph_zero_based":3081},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":3082},{"literal_text_all_w_t_and_m_t":"altFreqPriority","paragraph_zero_based":3083},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports alternative cell reselection priority.","paragraph_zero_based":3084},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":3085},{"literal_text_all_w_t_and_m_t":"altMCS-Table","paragraph_zero_based":3086},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports the 6-bit MCS table as specified in TS 36.212 [22] and TS 36.213 [23].","paragraph_zero_based":3087},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3088},{"literal_text_all_w_t_and_m_t":"aperiodicCSI-Reporting","paragraph_zero_based":3089},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports aperiodic CSI reporting with 3 bits of the CSI request field size as specified in TS 36.213 [23], clause 7.2.1 and/or aperiodic CSI reporting mode 1-0 and mode 1-1 as specified in TS 36.213 [23], clause 7.2.1. The first bit is set to \"1\" if the UE supports the aperiodic CSI reporting with 3 bits of the CSI request field size. The second bit is set to \"1\" if the UE supports the aperiodic CSI reporting mode 1-0 and mode 1-1.","paragraph_zero_based":3090},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":3091},{"literal_text_all_w_t_and_m_t":"aperiodicCsi-ReportingSTTI","paragraph_zero_based":3092},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports aperiodic CSI reporting for short TTI as specified in TS 36.213 [23], clause 7.2.1.","paragraph_zero_based":3093},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3094},{"literal_text_all_w_t_and_m_t":"appliedCapabilityFilterCommon","paragraph_zero_based":3095}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["ee1a4db49f1a4bc937ab7083eb3633cec46ca00dab122e16428cee9fde273b3d","762b97b8f25ba9a374d8793754e77f5ebe38fac69b273abddb90b044edacce96","c82f8db8c0a29a1bd105afd3ff5792c6150d19564678cbb5f4b852954db78ed8","c87adb46d8f78c245149f239c5ee4bc83c6454a1832d079bb2c7b777638da1c6","914e3e5ee50fe618dcdddf55b9d131003c5cf2582b145e76409687e282a44a21","cd0acc8654ed6f889b023c670da148974335aa635c9f94f9e6bfe2f5c9d81dbb","15e0b1319cc89cc9aba0d07a27a1f31b96dcd31eb4f270b40b8dddf699338438","e6561b14733a5a698210cfaf8e2a42181ebec43f60534d4cd6af940d4108ac41","1c37aaaae220bd18e065011d42e77c60249bfc41690e46b3abfe4ecbb77b2341","e54e76efeab67ce1073b8