{"fields":{"filename":"R2-2408369.zip::R2-2408369.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether the SNPN supports IMS emergency bearer services for UEs in limited service mode in the cell. If absent, IMS emergency call is not supported by the SNPN in the cell for UEs in limited service mode.","paragraph_zero_based":456},{"literal_text_all_w_t_and_m_t":"onboardingEnabled","paragraph_zero_based":457},{"literal_text_all_w_t_and_m_t":"Indicates whether the onboarding SNPN allows registration for onboarding in the cell as specified in TS 23.501 [32].","paragraph_zero_based":458},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":459},{"literal_text_all_w_t_and_m_t":"–NPN-IdentityInfoList","paragraph_zero_based":460},{"literal_text_all_w_t_and_m_t":"The IE NPN-IdentityInfoList includes a list of NPN identity information.","paragraph_zero_based":461},{"literal_text_all_w_t_and_m_t":"NPN-IdentityInfoList information element","paragraph_zero_based":462},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":463},{"literal_text_all_w_t_and_m_t":"-- TAG-NPN-IDENTITYINFOLIST-START","paragraph_zero_based":464},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":465},{"literal_text_all_w_t_and_m_t":"NPN-IdentityInfoList-r16 ::=     SEQUENCE (SIZE (1..maxNPN-r16)) OF NPN-IdentityInfo-r16","paragraph_zero_based":466},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":467},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":468},{"literal_text_all_w_t_and_m_t":"NPN-IdentityInfo-r16 ::=         SEQUENCE {","paragraph_zero_based":469},{"literal_text_all_w_t_and_m_t":"    npn-IdentityList-r16             SEQUENCE (SIZE (1..maxNPN-r16)) OF NPN-Identity-r16,","paragraph_zero_based":470},{"literal_text_all_w_t_and_m_t":"    trackingAreaCode-r16             TrackingAreaCode,","paragraph_zero_based":471},{"literal_text_all_w_t_and_m_t":"    ranac-r16                        RAN-AreaCode                                                OPTIONAL,       -- Need R","paragraph_zero_based":472},{"literal_text_all_w_t_and_m_t":"    cellIdentity-r16                 CellIdentity,","paragraph_zero_based":473},{"literal_text_all_w_t_and_m_t":"    cellReservedForOperatorUse-r16   ENUMERATED {reserved, notReserved},","paragraph_zero_based":474},{"literal_text_all_w_t_and_m_t":"    iab-Support-r16                  ENUMERATED {true}                                           OPTIONAL,       -- Need S","paragraph_zero_based":475},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":476},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":477},{"literal_text_all_w_t_and_m_t":"    gNB-ID-Length-r17                INTEGER (22..32)                                            OPTIONAL        -- Need R","paragraph_zero_based":478},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"d66ee83a11e596eb14b64f5886ad9a1363953496b37c5b7ad109af3e6b319447","original_member_sha256":"c496036bf0449256be5ad57c73f5bba9639937fda10ca8d81b5a96b75aefbfc7","paragraph_ElementTree_utf8_XML_sha256":["ef09961eea1afbe85eeb914b7fb49d7f7866c78020c5f944a9d2a0d880bedb76","386fa69987cc140e7525acde294b133f53a1ba5685258ee3ee42434bd5a27044","ad84124ba2d25bce79a899f9463534012aaaea6b0d4e41ea7d29357977fb503c","9b318f7c62df2f80e5dbf3a0a0272f0823eb1baa043f1eca766b6f22a02a0cee","a1ff9a08be0cc6d7302b870832665848e86ec8001e68fd727676940cacab2262","56dc4df81cfd8e7993173371135276fc69d18ba2ee827797d3c260cf7691c9a2","73fe157c9b7ff94c6742ad3192c820baa653f626f6ba85b370cb34843d246175","853b75c74c536561dfb085442d20ee7e28a5e818061e55a0cf23dea92e552e55","0cc844c32cb5b7b75927fae0d4211996b9d03d5db342e3d2400a241942735fc8","521257acdf18ade7e680cf6cc6116f5630dc75ad76a4677e71ebf1058b39ecfd","d6e353ade