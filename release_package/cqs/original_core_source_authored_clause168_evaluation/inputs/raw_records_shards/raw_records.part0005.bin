ell_coordinates":{"document_XML_sha256":"c9de91d67498880932c1dde6923944d236ea8d0fe0d729f049d35a355f05d008","original_member_sha256":"49e0a6406262a36a2ea7274502eea842be303ae6c0fc399f8b32a6ce1c386d04","paragraph_ElementTree_utf8_XML_sha256":["d50a8c5ce86aca474a740eb11232ae03c41f05c71a415aa2d2fbb89dcf936bdf","bb1f0012d040fa71ce6babb9f20fdf515404a580f6c321db2286c348d089e3d6","ab65c829c5639e9f71d471c5c3d443ca5ca0647550fd1885a6f2e40467be8990","0d6fc1b840b5e09a8416f81a4cae160a2bd09afa00c6ab209cf434ab127142b6","49223649f9f5eb050669babdf86616792a2fa422297c0111389995c49116d690","a4384e45a24d0474459613e005407c69ee27483998509088936c6969aa8b3f39","d2f35c61e05afc8a646588c5d745c1acb40867ec0517af6ae4b6710aa730669b","745d71fded0ccb9ff58b126cb7ac4d011926f5e29698fcb1c1603ee19d7ad8aa","03fecea21ae45677826ceb44c62fd6ed5b4fd865de8d734ea4778e1de329b43a","195a9782fe319f711a04e87762ab34c26ef3728571471220be41411c5329d1f3","5858ee86d366ad85b9865f52d5fd8818cff4293f857492974340cff2b2f833d5","7842e7d2852e422f41b5fc54c74af3a8117a08811c0b914ebd12d31fa5a94e6f","41d043810ca3bb1a34ed648831d0b0d567b4cb98a2c1ea0db2ec24a2a23c86ce","1e631a8b70e34020649caaa7fb98e79e9027ea5f1bdbc71f24a684438c436f69","45014abf4540b1d3cd1ced20121ea89d4dfd842fa98b0e1677a0d1bace8127bb","95911d8f920c8dc9ecb705d5ffea0d7f433e041e48db77aa4e2acf8fb27530d2","dfd91ecac20c881a6edb0d9850525182cfb6b4f4fbaaabec2f072cdfd3ee19e0","1b237eca7e7fa47a65d6b80a366d8f8be0a87f45766408ac8f51245e0267e458","864e72c722a84906e0bd1be53e35cb92be24c0ce55b4398f7f212f4ce245314a","2da8bae5a2e6866643b70b94d63a4ca6d395de5d9198d71fdee2de52a3c53474","ec68446ad3312081fa3176eeda9be50bb0034f4a2059c3136fd74590a44b3eb1","d22d9f3df74e8b05ce01e617afb5505406a9f645385140dd86e130e4133fbd40","2b579efeb352ae6e02422a9b384614735f93277355d68e413325d2ac0471debd","8bcfb0309f52b7f5cb2e2e20e91e5be12498de4d5bc93f2cb1ee055da109e466"],"paragraph_range_zero_based":[120,143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation o