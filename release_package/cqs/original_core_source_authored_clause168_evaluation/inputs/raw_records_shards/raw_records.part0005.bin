{"fields":{"filename":"R2-2502077.zip::R2-2502077 Introudction of control parameters for on-demand posSIB request for POS stage2_final.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"X","paragraph_zero_based":24},{"literal_text_all_w_t_and_m_t":"Core Network","paragraph_zero_based":25},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28},{"literal_text_all_w_t_and_m_t":"Title:","paragraph_zero_based":29},{"literal_text_all_w_t_and_m_t":"Introduction of control parameters for on-demand posSIB request [PosOdSIB-Req]","paragraph_zero_based":30},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32},{"literal_text_all_w_t_and_m_t":"Source to WG:","paragraph_zero_based":33},{"literal_text_all_w_t_and_m_t":"Huawei, HiSilicon, Ericsson","paragraph_zero_based":34},{"literal_text_all_w_t_and_m_t":"Source to TSG:","paragraph_zero_based":35},{"literal_text_all_w_t_and_m_t":"R2","paragraph_zero_based":36},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38},{"literal_text_all_w_t_and_m_t":"Work item code:","paragraph_zero_based":39},{"literal_text_all_w_t_and_m_t":"TEI19","paragraph_zero_based":40},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41},{"literal_text_all_w_t_and_m_t":"Date:","paragraph_zero_based":42},{"literal_text_all_w_t_and_m_t":"2025-03-28","paragraph_zero_based":43},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"41a1ff81388387a5840b779624d83c32dbf97e216bde6857a4a94b36bf2e7ed3","original_member_sha256":"76d9499cd89b5d67bda3f2c6d77e6ed77abe885ef392336920340be1e0d2c1cd","paragraph_ElementTree_utf8_XML_sha256":["eca4a4ff04b237951ade685ead3a18d23bfad4a5a02c2e3e24579966fcc22044","1134cb87ce2a928594dab2434d88ee82448c7524bb08e159864167248b30daed","2285b0ddbef8b209abf4c58756fb7ec9689c4b50f563b6f5c0ce4876a32e095a","1d89cded47246361e404cc73eccc85fee84f02e3223a9e9c9f0a5015ba7de7ae","6dfad9c81b0a05924620fa92896c259f01e1a9ee79c7228ab341d03f52bfd3cf","97b969be50bc13d2cc698503377ad31e9799f5c06bcf297a50e853cc41f8a7a2","ca0411ed6a24ea193aa8ad0138dcd7ab86e22e412568e7c9227b6b08564bf00c","7bc05e86766fe6eaa0448dcf3f4bd67b0d5271d055e12ce5699b4a65c92ccb11","f759ac7640a475b6e42b53f5a11a0cced4807ff2e8d2e01350c9e63ef7e83d86","9e2cb3aff516f9d22708df9280c53c074b2ecc32b5b4f7fb65acb43b624aa741","25707ed57526bafd594e8ab2fd6d9078852950f3971e95324d781e41fe1a5daf","f61bed16c83a9ffbc4665b4e9076712a994ed3f27dfa045d803f9a6777360036","8c2f81d89857610ba9ed1d822c2fc5aaaefe1cef1cc12f562dc27df3692e079d","6abec768d060eef0a504b41c1b5f86399d891fe398f340667c28cdff93b3813c","89dea2c0628b20c8176449ad0973ba59587fd4a5dbb7c6b000fb282b4646f436","6949732dd1cd20caf4820d94f3f9348303e74582eaf0c16fac1bd1d4ace1c852","bf99286671c19d25f1fdb88be5aec5238f0ebd9e34502c9c5456f3d26fd7dc09","655c8661ab52512a977c7548d9215166414db04287ab23ce1c37ddb394d9d401","9482074128e9823c01da2c7f423e790aa6d0d0e853d8d8c23ee4c34a4004ed7d","529ad3c415fc9dd771a145dc8f7d9a4563001cff15013f4827aaf40b91d57a4f","8cd6a8c548e00a73b2977d53b09aeb7f7cb18b86ce3bf90a03e0d996948da5bf","f57663ccb2387dd6a7eeda0c692d5158aae17b5adb0b14b64d7dec915177fd82","1ae46176932eecf9c571f380f27f3faa02517077078ca8db7bc63ef4d81714a2","0aeb435b618b9472007330cf62780663a7b01d5f80dbd0db9860664e575afb98"],"paragraph_range_zero_based":[24,47],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2502077.zip::R2-2502077 Introudction of control parameters for on-demand posSIB request for POS stage2_final.docx:p24"}
{"fields":{"filename":"R2-2502077.zip::R2-2502077 Introudction of control parameters for on-demand posSIB request for POS stage2_final.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"B","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Rel-19","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-16(Release 16)Rel-17(Release 17)Rel-18(Release 18)Rel-19(Release 19)Rel-20(Release 20)","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":"Reason for change:","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"For positioning SIB, the assistance data for some of the SIBs require periodic update and periodic delivery of the posSIb is thus required. For instance, RTK message is typically updated periodically (a typical update periodicity is 640ms) and the update needs to be delivered to the UE in a timely manner. ","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"During R16 discussion, we have agreed to introduce on-demand SIB request in RRC_CONNECTED. When a certain SIB/posSIB that the UE needs is not currently broadcasted, the UE may send a UL dedicated RRC message to the gNB to request this needed SIB/posSIB. Then, based on the request, the gNB may send delivers the SIB/posSIB either by dedicated signaling or by system information.","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"The issue is that, based on the current mechanism, the network does not know how many time the SIB should be delivered to the UE. Take posSIB for RTK for example:","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"If the network delivers multiple RTK posSIB per UE request, the network does not know when it should stop","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"If the network delivers only one RTK posSIB per UE request, the UE might repeatedly send the request to the network, which results in much signalling overhead.","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"This hence motivates us to allow for UE to indicate the amount of periodic deliveries that it needs when requesting the posSIB.","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"Note that for the support of RTK in LPP, LPP control parameters are defined for periodic assistance delivery with periodicity and requested amount.","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"41a1ff81388387a5840b779624d83c32dbf97e216bde6857a4a94b36bf2e7ed3","original_member_sha256":"76d9499cd89b5d67bda3f2c6d77e6ed77abe885ef392336920340be1e0d2c1cd","paragraph_ElementTree_utf8_XML_sha256":["50e4213c8f36b8642fa32dce30ed7c921854066f108cb9ac0208d3e3512b8ff1","55bf3829668d5692cedda31c90506ca5f3233751e72f3af1ade4f354892d8efd","d9e637484edfea0191456d94588519bb7c930ffdeb4e0a8b0b1e6e8f6264be4c","9633b6b13cca348843f2d56414896b646e3934da73cf58fc72842d84e850fe6e","4426921fe3c130ad8b9e0f8f4fd47231839752a57876fa450485996022462e75","6c2cf0ee3930ae102559258db0e194c439824079a42639188533e32b06cd033b","b402c4457367b1a68d7c9eb4d05248fbfc25d35d99fe5c8b22c41dd51ebbdb3d","fac096d5f946aecfe82209b418ea1a2a12a0288dba14557e7edd4098b67f5d10","90384601ef7662f36f68e9169e480960ab2da5bb6650cb9d5ef8224ed47af6d8","f2f8e852e49f8b264d4b5913a0989f7da6fa492e702aaf3145d72b1009e813df","f5c8181c0cee0c7dd733f46a279f4b4118e4a6011cfeb967206da978587e7af1","5efb8faaca21118e2f4a5be94974f42026732103b0a04c0de5c9a19ef440df5d","dbe85e4fd16ea458451a9ac73cfb1b3d2cf08aa2a31b18610daebf4b79138def","ed08dca858771a9d9221cb1d4d3de09993fb7477c8affc4a0105b12b33c91f91","7e77b84778855b86c52d464f63dbb9c53933ca8779b96c94c3dac489f59f58b4","ba9e5ad94304bf6f8c69847cbca6f3286379d61c4120a65fa57df6aaa4d986f5","6424eed5f005c0b7e49dbf410faecb7b5fd26b9e1f3b4e1be29b8ae50ffbcae9","490121ce8e411c5bb43e05b7b63bf56c93b5520ceaaeeaf1de531046c26b2f54","80b0f9dcfeb9f67aa5f3b488d9707e7d2e153d03effdbad235d6fc2d9346fa32","7f88c6a5149fdcda4d2c8e64431147df7b08dd54590d030e52313ca5d563e695","edccdde699f7345ed92ae5a251fdfe377cb2cabf33f96d154aca4f67c816987a","f8f7e6ed7d83a6525c60218c5ea849e0e7310b37255e91e2122978b0d496a192","0b81631faacc4bff4b945e33b44fb8f67b3159cc41be706ff85faa066fd3440e","22b59806b66a4e9c9b2ffbf400177986200427b81761d6c3adb7605d463d1db5"],"paragraph_range_zero_based":[48,71],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2502077.zip::R2-2502077 Introudction of control parameters for on-demand posSIB request for POS stage2_final.docx:p48"}
{"fields":{"filename":"R2-2502077.zip::R2-2502077 Introudction of control parameters for on-demand posSIB request for POS stage2_final.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"We can follow what has been defined in LPP for the delivery amount and the posSIB can be delivered to the UE periodically whenever the gNB receives an updated posSIB from the LMF.","paragraph_zero_based":72},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":73},{"literal_text_all_w_t_and_m_t":"========== UPDATE after RAN2#129===========","paragraph_zero_based":74},{"literal_text_all_w_t_and_m_t":"After the discussion during RAN2#129, the following agreement has been achieved","paragraph_zero_based":75},{"literal_text_all_w_t_and_m_t":"Agreements:","paragraph_zero_based":76},{"literal_text_all_w_t_and_m_t":"Introduce control parameters, including delivery amount and start/stop, for posSIBs with periodic delivery requirements for SI request in RRC_CONNECTED.","paragraph_zero_based":77},{"literal_text_all_w_t_and_m_t":"Control signalling in reconfiguration to be encoded as ENUMERATED { enabled } OPTIONAL Need R.","paragraph_zero_based":78},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":79},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":80},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":81},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":82},{"literal_text_all_w_t_and_m_t":"Add description for the control parameters for the deliveries of the posSIB in dedicated RRC messages.","paragraph_zero_based":83},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":84},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":85},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":86},{"literal_text_all_w_t_and_m_t":"The introduced feature is not clear in its usage in stage2.","paragraph_zero_based":87},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":88},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":89},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":90},{"literal_text_all_w_t_and_m_t":"7.5.1","paragraph_zero_based":91},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":92},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":93},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":94},{"literal_text_all_w_t_and_m_t":"Y","paragraph_zero_based":95}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"41a1ff81388387a5840b779624d83c32dbf97e216bde6857a4a94b36bf2e7ed3","original_member_sha256":"76d9499cd89b5d67bda3f2c6d77e6ed77abe885ef392336920340be1e0d2c1cd","paragraph_ElementTree_utf8_XML_sha256":["f7b96eea46414117e37f41867da0f7ca41e71246b36cc3535d3408d96b68310b","993190fd8c3bb254e73d3a08adfb7e183450317b28e51f6f2125be0de90c7110","2135e27375df043a3e561b63ab1b8876ed3721d00ce208bbf458b5838d9f2835","75dd870cb6daeabc6fb9096a2134abf89025fc36d93e76bccad166fe0ef57e52","feee8dbc7d98098869164e97216286930bd8a0a999f1673f34f4ba58e8e00def","c25211ba1fc5c493f5b339091f067349e3f06924629ea9e987b7c34e8166d653","30b51b832a58f082f01ae0c357827c0390d81c143c497e54b6406b9c182541f2","abbb88ee001b9ef433896474127680850ce4c812740c9a3d02100bde027d6df0","f3a2dbd57307a0bd8cf9e36bb0f2e290631105a5c0ba77ea3a2b5f32dd6e9561","5f8c038b8f32e0cd146ff0fc3dea5cbc44fa169eacd0f11e71931a47a206daa9","104c7585efcbe7048a31270578b4bd68ae433a7548bfeda116a0aea927f730cd","ecf70e77fab8c4cfb7dae6d36cc8e62aac492a82dd4e4e90c5ed78fa2e2940f8","4a87bcb45fdd1e867173ae213575d00edeb2170522f42e59a004050da205079f","41caeae449455bcbf7e5588482d3a2df19c668bb305d96a8f1280514758b4cef","fd7129d1bf7836a8320a0796f9d40496a40756ec5132e04a13926c714885cfb1","c1d8c0ccc8311f4e2525865b9c9d2db0da9f4d259829eac77babd7f707e68cfd","4695106b0be6cb7a6a9a6bbe39ffcd066c28538ab8f31922ab711f39588aeb42"