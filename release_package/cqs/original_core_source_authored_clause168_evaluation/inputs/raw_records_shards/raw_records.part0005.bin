b422b045e66f914dc5d4f9a0238502db08d50c0107338","918798df3d1467862e50b658d57439cce15eb7954c22b9da02d0f3185be03c07","199e2836bc3a0b93b36eb227ca5ef0910952ac41d5e861c3eb46c8a99aaacef4","723f02ea2425fab7e2fe4a687898c8b80c645785a61ae300713808bee77f9620","f187129218883f60aa670e13677fb28f83be6448d4ee6d04e4757663d9deed7e"],"paragraph_range_zero_based":[216,239],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx:p216"}
{"fields":{"filename":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SRNCServing RNC","paragraph_zero_based":240},{"literal_text_all_w_t_and_m_t":"SSBSynchronization Signal Block","paragraph_zero_based":241},{"literal_text_all_w_t_and_m_t":"SSIDService Set Identifier","paragraph_zero_based":242},{"literal_text_all_w_t_and_m_t":"TATracking Area","paragraph_zero_based":243},{"literal_text_all_w_t_and_m_t":"TCETrace Collection Entity","paragraph_zero_based":244},{"literal_text_all_w_t_and_m_t":"TDDTime Division Duplex","paragraph_zero_based":245},{"literal_text_all_w_t_and_m_t":"UEUser Equipment","paragraph_zero_based":246},{"literal_text_all_w_t_and_m_t":"ULUplink","paragraph_zero_based":247},{"literal_text_all_w_t_and_m_t":"UMTSUniversal Mobile Telecommunication System","paragraph_zero_based":248},{"literal_text_all_w_t_and_m_t":"UPHUplink PH","paragraph_zero_based":249},{"literal_text_all_w_t_and_m_t":"URAUTRAN Registration Area","paragraph_zero_based":250},{"literal_text_all_w_t_and_m_t":"UTRAUniversal Terrestrial Radio Access","paragraph_zero_based":251},{"literal_text_all_w_t_and_m_t":"UTRANUniversal Terrestrial Radio Access Network","paragraph_zero_based":252},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":253},{"literal_text_all_w_t_and_m_t":"4Main concept and requirements","paragraph_zero_based":254},{"literal_text_all_w_t_and_m_t":"4.1General","paragraph_zero_based":255},{"literal_text_all_w_t_and_m_t":"The general principles and requirements guiding the definition of functions for Minimization of drive tests are the following:","paragraph_zero_based":256},{"literal_text_all_w_t_and_m_t":"1.MDT modeThere are two modes for the MDT measurements: Logged MDT and Immediate MDT. There are also cases of measurement collection not specified as either immediate or logged MDT, such as Accessibility measurements. Additionally, the measurement collection is specified as immediate MDT with logging of UE radio measurements to support network-side data collection.","paragraph_zero_based":257},{"literal_text_all_w_t_and_m_t":"2.UE measurement configurationIt is possible to configure MDT measurements for the UE logging purpose independently from the network configurations for normal RRM purposes. However, in most cases, the availability of measurement results is conditionally dependent on the UE RRM configuration.","paragraph_zero_based":258},{"literal_text_all_w_t_and_m_t":"3.UE measurement collection and reportingUE MDT measurement logs consist of multiple events and measurements taken over time. The time interval for measurement collection and reporting is decoupled in order to limit the impact on the UE battery consumption and network signalling load.","paragraph_zero_based":259},{"literal_text_all_w_t_and_m_t":"4.Geographical scope of measurement loggingIt is possible to configure the geographical area where the defined set of measurements shall be collected.","paragraph_zero_based":260},{"literal_text_all_w_t_and_m_t":"5.Location informationThe measurements shall be linked to available location information and/or other information or measurements that can be used to derive location information.","paragraph_zero_based":261},{"literal_text_all_w_t_and_m_t":"6.Time informationThe measurements in measurement logs shall be linked to a time stamp.","paragraph_zero_based":262},{"literal_text_all_w_t_and_m_t":"7.Sensor informationThe measurements can be linked to available sensor information that can be used to derive UE orientation in a global coordinate system, the uncompensated barometric pressure and the UE speed.","paragraph_zero_based":263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"0254bea9b44234fd4ae3ce61d1b7572c9739a2f3f98aac5d753159622ecf9743","original_member_sha256":"89d3a65a890ec1c34665df3994d13674a43f65265801792df8571bdbaed4c1df","paragraph_ElementTree_utf8_XML_sha256":["ac4b2714c9799455b91191e44d704691412ff382962ed9e776b0cd4156731e06","5c7fef7f666c7286ddd35fed1be956ccd786dacce109f527078678366fd57904","5088ec35b4b213a7e725c132fe5cb8ab1d7db605582957752d502db9926efd1d","b74a428020613a64bfc2feee3d492288a3798e4437de9ff4f4050e45659d16b6","bcccf1fdaefc90e62bdd124f5bb889fc241b8ac262d58798be37f61009f69c25","f3f20a1911104d9c59849abfc6d61c45845973c0b84cb9a3cb3c134376d72813","376ac2491854d5b6725610c9bda867c7397019eff78e25f855a90dce8f6f9f66","ef3aa3bf3b7c28c4a092d5595137d86347d692fda8ab144d564f28c56c139113","4c40512dbfd8899b576c19af42bfaa666221940c6467f882d3c38f82371cddf4","1af3cba0c6098b2d4c089f864554ca5e8b390cf37fe5ee598ed1073808c667da","e156882b9256b7e5e1cce1ae6f0d09f13df79421e5d91045266a5071ece2cc7e","0cd782b478789ecb41820c15ce5eb90bdb70e44d8261f9c2f529c47d2b2c7e87","ca6ed2bb60f4eba148719962e84de9239c669ece57d7f87770ee1593f3c2d7fd","6a00ff68d4ab8a25a61bcbb584d4eccf2c3c7d7db46416fc45dfd795d52edd35","d8a498c10d7be235a614c262b522d7b8af7a7e897a1f4bc48e5086ac9ca3c779","6f67b8557d874a5308909a04d52b5b2cfa7aac00adf03ba1e619fa4202177354","fa7cb3d55e8babb133a20963f552554d27a0acd80e6b5887a77908a7620aad82","e0b81d66b45cd7661fc4d643148282de6cc6b5d89ad0892d04ce74278435709b","2726331e84668809f2b34abe8d431ce29d6eba20fc32061d652c5fa0973c3daf","b91d968d76da5dd99f373b2072bd1d18318f04380502cc8cfdd681c86efa2d69","b8e80aa3a0faf48560c52a0c823a981aa6723721c44e6767093610643748cd31","50e8199224b2f303ef59ea6afbffe85e29fecae1411dce195f3db607233ba49f","beed52f25dd01f3c7b11540ef31113bfc37db107f08c11630886b4d1598f6fc6","79b6f15887f6322e2c8c5cbe6790a7c10d40b406953d3118dabdd94e754ce9b5"],"paragraph_range_zero_based":[240,263],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx:p240"}
{"fields":{"filename":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"8.UE capability informationThe network may use UE capabilities to select terminals for MDT measurements.","paragraph_zero_based":264},{"literal_text_all_w_t_and_m_t":"9.Dependency on SONThe solutions for MDT are able to work independently from SON support in the network. Relation between measurements/solution for MDT and UE side SON functions shall be established in a way that re-use of functions is achieved where possible.","paragraph_zero_based":265},{"literal_text_all_w_t_and_m_t":"10.Dependency on TRACEThe subscriber/cell trace functionality is reused and extended to support MDT. If the MDT is initiated towards a specific UE (e.g. based on IMSI, IMEI-SV, etc.), the signalling based trace procedure is used, otherwise the management based trace procedure (or cell traffic trace procedure) is used. Network signalling and overall control of MDT is described in TS 32.422 [6].","paragraph_zero_based":266},{"literal_text_all_w_t_and_m_t":"The solutions for MDT shall take into account the following constraints:","paragraph_zero_based":267},{"literal_text_all_w_t_and_m_t":"1.UE measurementsThe UE measurement logging mechanism is an optional feature. In order to limit the impact on UE power consumption and processing, the UE measurement logging should as much as possible rely on the measurements that are available in the UE according to radio resource management enforced by the access network.","paragraph_zero_based":268},{"literal_text_all_w_t_and_m_t":"2.Location informationThe availability of location information is subject to UE capability and/or UE implementation. Solutions requiring location information shall take into account power consumption of the UE due to the need to run its positioning components.","paragraph_zero_based":269},{"literal_text_all_w_t_and_m_t":"5Functions and procedures","paragraph_zero_based":270},{"literal_text_all_w_t_and_m_t":"5.1General procedures","paragraph_zero_based":271},{"literal_text_all_w_t_and_m_t":"5.1.1Logged MDT procedures","paragraph_zero_based":272},{"literal_text_all_w_t_and_m_t":"Support of Logged MDT complies with the principles for IDLE and INACTIVE state measurements in the UE specified in TS 25.133[2], TS 36.133 [3] and TS 38.133 [16] and principles for IDLE and CONNECTED mode MBSFN measurements in the UE specified in TS 36.133 [3].","paragraph_zero_based":273},{"literal_text_all_w_t_and_m_t":"NOTE:It should be noted the established principles may result in different logged information in different UEs.","paragraph_zero_based":274},{"literal_text_all_w_t_and_m_t":"Furthermore, measurement logging is differentiated based on UE states in idle mode i.e. camped normally, any cell selection or camped on any cell. The UE shall perform measurement logging in \"camped normally\" state and \"any cell selection\" state. In \"camped on any cell\" state the UE is not required to perform MDT measurement logging (including time and location information).","paragraph_zero_based":275},{"literal_text_all_w_t_and_m_t":"For Logged MDT, the configuration will always be done in cells of the same RAT type. However, measurements included in the logged MDT report comprises of measurements from the same RAT type (serving cell measurements, intra-frequency and inter-frequency neighbor cell measurements) and different RAT types (inter-RAT neighbor cell measurements).","paragraph_zero_based":276},{"literal_text_all_w_t_and_m_t":"Logging of MBSFN measurements is only applicable to E-UTRA.","paragraph_zero_based":277},{"literal_text_all_w_t_and_m_t":"5.1.1.1Measurement configuration","paragraph_zero_based":278},{"literal_text_all_w_t_and_m_t":"Logged MDT measurements are configured with a MDT Measurement Configuration procedure, as shown in Figure 5.1.1.1-1.","paragraph_zero_based":279},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":280},{"literal_text_all_w_t_and_m_t":"Figure 5.1.1.1-1: MDT measurement configuration for Logged MDT","paragraph_zero_based":281},{"literal_text_all_w_t_and_m_t":"Network initiates the procedure to UE in RRC Connected by sending LoggedMeasurementConfiguration message, which is used to transfer configuration parameters for Logged MDT. This is a unidirectional RRC signalling procedure.","paragraph_zero_based":282},{"literal_text_all_w_t_and_m_t":"A release operation for logged measurement configuration in the UE is realized only by configuration replacement when the configuration is overwritten or by configuration clearance in case a duration timer stopping or expiration condition is met.","paragraph_zero_based":283},{"literal_text_all_w_t_and_m_t":"5.1.1.1.1Configuration parameters","paragraph_zero_based":284},{"literal_text_all_w_t_and_m_t":"The logged measurement configuration consists of:","paragraph_zero_based":285},{"literal_text_all_w_t_and_m_t":"-configuration of downlink pilot strength measurements logging for (E-)UTRA and NR.","paragraph_zero_based":286},{"literal_text_all_w_t_and_m_t":"-configuration of MBSFN measurement logging for E-UTRA.","paragraph_zero_based":287}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"0254bea9b44234fd4ae3ce61d1b7572c9739a2f3f98aac5d753159622ecf9743","original_member_sha256":"89d3a65a890ec1c34665df3994d13674a43f65265801792df8571bdbaed4c1df","paragraph_ElementTree_utf8_XML_sha256":["f3dbbf60cc052cfe8ccc82410c659d03bc8e7ee080e4080113ab1cf1ed9b05f2","8e8ef80ce470422d4b40276e1a41ca7e9a3b570ffd58fa48819abb14db9aede7","1394626380de4441c1bda5cde8489645ea6d074d4767a7b89b679bf5a18f59e9","883769ba0d8c8f923ecf3c6a488234e735913fc8495304475069a5394877d262","a5599dd9c8bcdbdd0c364010aa78f16fb0befd6497d9b5704ab11a9080d1bd8e","4d7e7e652b6df40c56647f09068f3572e7fd0f21d5089910abc348e0e52901f9","d17526034d835f4f6a7c3dc15686db6a6883fccc8e1460dd5ef21ee2928efad5","14e224d0c89466ca8a23d5c3a71774515aa5c226ff27a69d860f868d7c1f4f3f","a0efa175472302e43b58ba859c7b1d175fe41dd01e1a1ef214970aacd0b8371d","0cb65a7c27107398691da64f5afd6f4cc18bcb1cee91c3b161b1a898f03991bc","5de258f811d12ddde1b44e17ac72d6b5042519d0fdc1b8d85f9c4ffeeddd3b42","769fac9ef53c293247cd8866b7eb28f8fe223c4d3586037846226e3aab8e796e","33ae1667a16f39010828a128ff706b82dadb82a7dee9e7254c32e1c59b3067a7","267853f21056ccfb8f5d3e43fa03b1a0d11a63b76eb3dda8f25ec136bef395c7","e6231ec0338a90c4abc2449a63b7a006030232bf2ad077d8e6ffab5d1924e41a","08e51305ded6b54148602e286c360c4e17636045feb9a610c5ce57852ee25576","6ae80c24464b2904b51e9c19e72d6e68eeef4778466ac7f0ff28e537d6c75f52","6ad4e77bf0d3a789ef312890839f2b2dc516371daa37679675826fc5f3bab6fb","ac276377cb7d62ef1b316ec8937c69c0b94cccdccb3ec9668b89bf1b6bd40b71","dfd1c5d2d2686be2a5873d809cc563e84635374486f79646d604a4dbfff334a5","1a0c57d83e60c59091fe0d60afd74e6d2df95fcdaac5e1b6f7d0efec211452ec","31cc490ae4ab5c75ebb50c9146bbcb5f7be713fdd6fc704cb30daf5d07c19d29","779c261015071da07dff63135dfc11ed49d38f7f2722be96fbc48563bdcc6794","1cc609ef453e5bd0ad81762adc7ccb43b4e8954954ce00aca1eb86754a216977"],"paragraph_range_zero_based":[264,287],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx:p264"}
{"fields":{"filename":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-configuration of the triggering of logging events:","paragraph_zero_based":288},{"literal_text_all_w_t_and_m_t":"-for (E-)UTRAN:","paragraph_zero_based":289},{"literal_text_all_w_t_and_m_t":"-periodic measurement trigger is supported, for which the logging interval is configurable. The parameter specifies the periodicity for storing MDT measurement results. It should be configured in seconds in multiples of the applied IDLE mode DRX, i.e. multiples of 1.28s which is either a factor or multiple of the IDLE mode DRX. The UE behaviour is unspecified when the UE is configured with a DRX cycle larger than the logging interval.","paragraph_zero_based":290},{"literal_text_all_w_t_and_m_t":"-for NR:","paragraph_zero_based":291},{"literal_text_all_w_t_and_m_t":"-periodic measurement trigger is supported, for which the logging interval is configurable. The parameter specifies the periodicity for storing MDT measurement results.","paragraph_zero_based":292},{"literal_text_all_w_t_and_m_t":"-for E-UTRAN and NR:","paragraph_zero_based":293},{"literal_text_all_w_t_and_m_t":"-event-based trigger is supported, for which the logging interval is configurable, which determines periodical logging of available data (e.g. time stamp, location information), and the following two types of events are supported:","paragraph_zero_based":294},{"literal_text_all_w_t_and_m_t":"-measurement quantity-based event L1, for which the event threshold, hysteresis, and time to trigger are configurable. If the configured time to trigger is not a multiple of the DRX cycle, then the UE uses the next multiple of DRX cycle duration that is larger than the time to trigger for evaluating the event L1;","paragraph_zero_based":295},{"literal_text_all_w_t_and_m_t":"-out-of-coverage detection trigger.","paragraph_zero_based":296},{"literal_text_all_w_t_and_m_t":"NOTE:The logging configuration for event-based and periodical DL pilot strength logged measurements can be configured independently. Only one type of event can be configured to the UE.","paragraph_zero_based":297},{"literal_text_all_w_t_and_m_t":"-configuration of the logging duration. This configuration parameter defines a timer activated at the moment of configuration, that continues independent of state changes, RAT or RPLMN change. When the timer expires the logging is stopped and the configuration is cleared (except for the parameters that are required for further reporting e.g. network absolute time stamp, trace reference, trace recording session reference and TCE Id).","paragraph_zero_based":298},{"literal_text_all_w_t_and_m_t":"-network absolute time stamp to be used as a time reference to UE.","paragraph_zero_based":299},{"literal_text_all_w_t_and_m_t":"-Trace Reference parameter as indicated by the OAM configuration as specified in TS 32.422 [6].","paragraph_zero_based":300},{"literal_text_all_w_t_and_m_t":"-Trace Recording Session Reference as indicated by the OAM configuration as specified in TS 32.422 [6].","paragraph_zero_based":301},{"literal_text_all_w_t_and_m_t":"-TCE Id as indicated by the OAM configuration as specified in TS 32.422 [6].","paragraph_zero_based":302},{"literal_text_all_w_t_and_m_t":"-(optionally) MDT PLMN List, indicating the PLMNs where measurement collection and log reporting is allowed. It is either the Management Based MDT PLMN List or the Signalling Based MDT PLMN List, depending on how the Logged MDT task was initiated (see 5.1.3).","paragraph_zero_based":303},{"literal_text_all_w_t_and_m_t":"-(optionally) configuration of a logging area. A UE will log measurements as long as it is within the configured logging area. The scope of the logging area may consist of one of:","paragraph_zero_based":304},{"literal_text_all_w_t_and_m_t":"-a list of up to 32 global cell identities for PLMN, and, for NR, additionally a list of up to 144 PNI-NPNs with a maximum of 12 different PLMN identities. If one or both of these lists are configured, the UE will only log measurements when camping in any of the cells belonging to the list of global cell identities, or in any of the cells belonging to the listed PNI-NPNs.","paragraph_zero_based":305},{"literal_text_all_w_t_and_m_t":"-a list of up to 8 TAs or 8 LAs or 8 RAs for PLMN, and, for NR, additionally a list of up to 256 PNI-NPNs. If one or both of these lists are configured, the UE will only log measurements when camping in any cell belonging to the preconfigured TA/LA/RAs, or in any of the cells belonging to the listed PNI-NPNs.","paragraph_zero_based":306},{"literal_text_all_w_t_and_m_t":"-for NR, a list of inter-frequency neighbouring cells per frequency.","paragraph_zero_based":307},{"literal_text_all_w_t_and_m_t":"-for NR, a list of up to 144 PNI-NPNs with a maximum of 12 different PLMN identities.","paragraph_zero_based":308},{"literal_text_all_w_t_and_m_t":"-for NR, a list of up to 16 SNPNs.","paragraph_zero_based":309},{"literal_text_all_w_t_and_m_t":"-for NR, a list of up to 32 global cell identities for SNPN. If this list is configured, the UE will only log measurements when camping in any of these cells.","paragraph_zero_based":310},{"literal_text_all_w_t_and_m_t":"-for NR, a list of up to 8 TAs for SNPN. If this list is configured, the UE will only log measurements when camping in any cell belonging to the configured TAs.","paragraph_zero_based":311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"0254bea9b44234fd4ae3ce61d1b7572c9739a2f3f98aac5d753159622ecf9743","original_member_sha256":"89d3a65a890ec1c34665df3994d13674a43f65265801792df8571bdbaed4c1df","paragraph_ElementTree_utf8_XML_sha256":["bc939a88841837e2ce5b7ae37168bed8d4570c5092ab38e171550ed621e486b4","e5722e52a7bb73ba03da5285a02972ab33984b2d0fad3988334a0a53a4c11745","eddcab06c1f1af91f8f93cf07ac8e641c40e9b7b43f0b5b97aceadd22cc90fbb","a75a896654165e372fc670277e05e744c13c43896a0c597437ddef4f7d73c2d0","91dc0f8e937bac8a2e52c6bb223949d4f09b1edd1a94278875dbd08cae701ca0","d210e0ab3e9442d3ef543dad31a8f82ce5bacbb3ee2fab57226554fca6b7fef2","91c2b32f8fa51d89f905d1fce51b6884c7f949311ad24770ce43c4fd0efae184","c1eb8cb14a6d62c9c4aef17dec72f37de6ac2e368b135d76ae7d5004cef7a587","427dafb3f74409fb1281481ff8ec74d6c8a68991771f18e898a107f6223513c9","f091608f53d159a21f84f9a6eaac260ae2cda719732dd6a42518e4f06031049f","909a0e319e1fc924b8c4b5881adc156fb0dfea2fde8eb357928f562df004a396","ee4f29428d515e014fd7ec137c0c85cbdd3a132d73e3f9ff679fdf1df16934b6","877a712e56a597362475a8dba6c0296fcbc70047461e263024ad8df88a06edfc","ec7fcb5580a4eb76d401ac20583c5bfe035c6e2a86ddb29a463dab86d8d6a399","e9250b8f05aa64dd0194a542c1984305079dc5b6f6196594739989d7fa362b13","ea005e2a1b70908a5f7765dc8ea0d036203e9afc27eccd3974ca0c0179b76d47","bb7f47a0704d047319b3de2c0ce49db179b6625efb480781dbae96be8a4e3fcb","dd4bb40a2ae2d8d62e0b042cfb90dad2fc5bfc9bfca8a0cdf7214ddfd2331fc5","0edf4dc94c3f4f00ab509003cb2e8788d407008cb7bf64114415c5bb9df9af86","1b813b17ff04be3c7b8ea1976f48ef6e0721049d3625c857a705c43cc7033b20","eab015219d64f54edd5bf13eed8ff5e14b0d8d6e045895e5209fe6684cab0b41","65d958a02d3592feb8dc1bbb767aab907f447dbfadb51d597cf9fdbbd0400436","37aeda991558d02a66e4430e393eeb007ab8993dc7fdc4e8c6d724052c5b3a4d","e962f31b477dc3ae67a9156f3d0691b85915a37e9966d42c90b57c726d2b5d9d"],"paragraph_range_zero_based":[288,311],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx:p288"}
{"fields":{"filename":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-The configured logging area can span one of:","paragraph_zero_based":312},{"literal_text_all_w_t_and_m_t":"-PLMNs in the MDT PLMN List. If no area is configured, the UE will log measurements throughout the PLMNs of the MDT PLMN list.","paragraph_zero_based":313},{"literal_text_all_w_t_and_m_t":"-Any configured SNPN area.","paragraph_zero_based":314},{"literal_text_all_w_t_and_m_t":"-(optionally) for NR, configuration of a list of neighbouring frequencies and/or cells, indicating the UE to include neighbouring cell's measurements as indicated in the list in the logged MDT report.","paragraph_zero_based":315},{"literal_text_all_w_t_and_m_t":"-(optionally) for E-UTRA, configuration of target MBSFN area(s) for MBSFN measurement logging. If target MBSFN area(s) is configured, UE applies it in addition to other restrictions such as the logging area. The UE will log measurements as long as it receives MBMS service from an indicated target MBSFN area and is within the configured logging area. The target MBSFN area(s) is defined by a list of up to 8 entries, where each entry indicates a carrier frequency and optionally indicates a specific MBSFN area on a carrier frequency.","paragraph_zero_based":316},{"literal_text_all_w_t_and_m_t":"-(optionally) configuration of the WLAN access point names, indicating the UE to attempt to obtain WLAN measurements associated to these access points.","paragraph_zero_based":317},{"literal_text_all_w_t_and_m_t":"-(optionally) configuration of the Bluetooth beacon names, indicating the UE to attempt to obtain Bluetooth measurements associated to these beacons.","paragraph_zero_based":318},{"literal_text_all_w_t_and_m_t":"-(optionally) for NR, configuration of the sensor names, indicating the UE to attempt to obtain sensor measurements.","paragraph_zero_based":319},{"literal_text_all_w_t_and_m_t":"-(optionally) for E-UTRA, configuration indicating the UE to attempt to obtain uncompensated barometric pressure measurements.","paragraph_zero_based":320},{"literal_text_all_w_t_and_m_t":"-(optionally) for NR, the network can use a flag to indicate if an early measurement/idle mode configuration has relevance for logged measurement purposes, indicating the UE is allowed to log the measurement results related to early measurement frequencies in the logged MDT report.","paragraph_zero_based":321},{"literal_text_all_w_t_and_m_t":"-(optionally) for NR and E-UTRA, logged MDT type flag, indicating the logged measurement configuration is the signalling based MDT (see 5.4.0).","paragraph_zero_based":322},{"literal_text_all_w_t_and_m_t":"5.1.1.1.2Configuration effectiveness","paragraph_zero_based":323},{"literal_text_all_w_t_and_m_t":"The logged measurement configuration is provided in a cell by dedicated control while UE is in CONNECTED and implies:","paragraph_zero_based":324},{"literal_text_all_w_t_and_m_t":"-logged measurement configuration for downlink pilot strength measurements (or events) logging is active","paragraph_zero_based":325},{"literal_text_all_w_t_and_m_t":"-in IDLE UE state in E-UTRAN, or","paragraph_zero_based":326},{"literal_text_all_w_t_and_m_t":"-in IDLE mode, CELL_PCH and URA_PCH states in UTRAN, or","paragraph_zero_based":327},{"literal_text_all_w_t_and_m_t":"-in CELL_FACH state when second DRX cycle is used in UTRAN, or","paragraph_zero_based":328},{"literal_text_all_w_t_and_m_t":"-in IDLE and INACTIVE states in NR","paragraph_zero_based":329},{"literal_text_all_w_t_and_m_t":"-until logging duration timer expires or stops","paragraph_zero_based":330},{"literal_text_all_w_t_and_m_t":"-logged measurement configuration for MBSFN measurement logging is active","paragraph_zero_based":331},{"literal_text_all_w_t_and_m_t":"-in IDLE and CONNECTED UE states in E-UTRAN","paragraph_zero_based":332},{"literal_text_all_w_t_and_m_t":"-until logging duration timer expires or stops","paragraph_zero_based":333},{"literal_text_all_w_t_and_m_t":"-logged measurement configuration and logs are maintained when the UE is in any state as described above, despite multiple periods interrupted by UE state transitions, e.g. for downlink pilot strength measurements when the UE is in CONNECTED state for E-UTRAN and NR and CELL_DCH, CELL_FACH state when second DRX cycle is not used in UTRAN","paragraph_zero_based":334},{"literal_text_all_w_t_and_m_t":"-logged measurement configuration and logs are maintained when the UE is in any state as described above in that RAT, despite multiple periods interrupted by UE presence in another RAT","paragraph_zero_based":335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"0254bea9b44234fd4ae3ce61d1b7572c9739a2f3f98aac5d753159622ecf9743","original_member_sha256":"89d3a65a890ec1c34665df3994d13674a43f65265801792df8571bdbaed4c1df","paragraph_ElementTree_utf8_XML_sha256":["d8ab12fda165c40550e191da35d74bee8f413be7692b1de749658c12931fbb4b","1e42ed3104b2c16c6f3369b8ef5837e9e592d797b9f7d96ef64ae84d0a5ef4c2","cdcbd89bf7590e1f078db075b4f95c998af1b71f224707e20ea656f9bd61dea8","01b38138648c7baeaf7024b5f58c0f8475b93bde3bf180b7530d88fa7ff13438","2c69424cd1c650fb1f600432c85f52579350d68d4bb4a4da009072fff52ed8d8","99ee07a73c0d98336ed711b98c07c1c97089c1abee94cc14765eb27b0673fa98","d4c0605ab742127892b0a3e99b56a86d6838e8333da2fb3b882d8a653f09d1aa","c4b0cd83a2f28b4513a4e63e7673caf0b854e20f819986a97bc067f48dabaf18","e0f05ea46c7a40f4215fc456c467db4b77fae9d77d87cfb4493da86685295082","9040cc77e7ea4309a09d51b66cd6a80595b14f59e6939a8cc9c78d704b8a8ac6","d7da16cb38ff42db62d5a1e4321a53427ac1762b20e5a75bc22d024b4239a7ea","8df0cd0080f7aef805ce8c454528c7b24546b2aac7f7c84bef6a320124e37f3e","fb775331d7efadbb475482878bcb879202222f6e64abb926f8502ec897158cca","69d645cee0488750962f6b631a9bca28987d8d2e8dd108346af81a6466cd1de4","52d09c75e25834eabc08ceee57e7e3c8d6c6ad447caa3424080fd83924f439d9","b5c9596d20fc8296b0e2311897eb6a24f2c2b97b3255a0d494692eb69dc90b1d","397bbf8c3fca1a427f8dced3ef4e2112f4b04d13449ad33f481dabdbe2fe3c48","18d1e386b235d201ee351bc0d291ec4e0f486db341ffeae04e55875df5c9b7c8","0fbf1b19cab808c8f0ec2480d28cc29f948c8c6a54c2e1236df34732c648c21c","03e9b0b6fe5cc3a440bd46ae2e04c5945ebbcdced30f8ff2a7ef962b7b06513b","84282f2ae13f9b36125c5dbfbc9d53e8f15c2a84777b80e484cbef4ea9c020ef","5d6e705ca88e0f023552c60b1344bef7729ab3a81928636e6bbf3c9acee3890e","4a3c631a0473514897e6872c18ec67848de0970f333bb18e7a923ece4b1a85c7","3225f734329221c3349d1a24e5d03e5077e61164f38a4a1d4ea94de02dee87e0"],"paragraph_range_zero_based":[312,335],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx:p312"}
{"fields":{"filename":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"There is only one RAT-specific logged measurement configuration for Logged MDT in the UE. When the network provides a configuration, any previously configured logged measurement configuration will be entirely replaced by the new one. Moreover, logged measurements corresponding to the previous configuration will be cleared at the same time. It is left up to the network to retrieve any relevant data before providing a new configuration.","paragraph_zero_based":336},{"literal_text_all_w_t_and_m_t":"NOTE:The network may have to do inter-RAT coordination.","paragraph_zero_based":337},{"literal_text_all_w_t_and_m_t":"When a logging area is configured, logged MDT measurements are performed as long as the UE is within this logging area. For public networks with NR, when determining whether a cell is part of the logging area, only the first entry of the plmn-IdentityList in the first entry of the PLMN-IdentityInfoList (in SIB1), and cellIdentity and TAC corresponding to the first entry of the PLMN-IdentityInfoList are considered. For standalone non-public networks with NR, when determining whether a cell is part of the logging area, all entries of the the NPN-IdentityInfoList (in SIB1) are considered. If no logging area is configured, logged MDT measurements are performed as long as the RPLMN is part of the MDT PLMN list. When the UE is not in the logging area or RPLMN is not part of the MDT PLMN list, the logging is suspended, i.e. the logged measurement configuration and the log are kept but measurement results are not logged. In addition, for MBSFN logged measurements, logged MDT measurements are performed in logging intervals when the UE receives MBMS service from a MBSFN area according to the target MBSFN area(s) configuration When the UE is not in the logging area or does not receive MBMS service from a MBSFN area that matches the target MBSFN area(s) configuration in the logging interval the logged measurement configuration and the log are kept but measurement results are not logged.","paragraph_zero_based":338},{"literal_text_all_w_t_and_m_t":"NOTE:The logging duration timer continues.","paragraph_zero_based":339},{"literal_text_all_w_t_and_m_t":"In case the new PLMN that does not belong to the MDT PLMN list provides a logged measurement configuration any previously configured logged measurement configuration and corresponding log are cleared and overwritten without being retrieved.","paragraph_zero_based":340},{"literal_text_all_w_t_and_m_t":"5.1.1.2Measurement collection","paragraph_zero_based":341},{"literal_text_all_w_t_and_m_t":"In \"camped normally\" state, a UE shall perform logging as per the logged measurement configuration. This state includes a period between cell selection criteria not being met and UE entering \"any cell selection\" state, i.e. 10 s for E-UTRA (See TS 36.133 [3]) or 12 s for UTRA (See TS 25.133 [2]) or 10s for NR (See TS 38.133 [16]).","paragraph_zero_based":342},{"literal_text_all_w_t_and_m_t":"In \"any cell selection\" state, a UE shall perform logging of available information (i.e. at least indicator 'anyCellSelectionDetected', time stamp, and the available location information). In \"camped on any cell\" state, the periodic logging stops. However, it should be noted that the duration timer is kept running. When the UE re-enters \"camped normally\" state and the duration timer has not expired, the periodic logging is restarted based on new DRX and logging resumes automatically (with a leap in time stamp).","paragraph_zero_based":343},{"literal_text_all_w_t_and_m_t":"When an E-UTRA or NR UE detects an in-device coexistence problem that may affect the logged measurement results, the UE shall stop measurement logging, indicate in the log that an in-device coexistence problem has occurred, and keep the duration timer running. When the in-device coexistence problem is no longer present, and the duration timer has not expired, the logging resumes, with a leap in time stamp.","paragraph_zero_based":344},{"literal_text_all_w_t_and_m_t":"For E-UTRA MBSFN measurement logging, the UE shall perform MBSFN measurements only when receiving MBMS service, and measurement logging is performed only for logging intervals for which MBSFN measurements are available. The UE shall perform MBSFN measurements and MBSFN measurement logging in both IDLE and CONNECTED modes.","paragraph_zero_based":345},{"literal_text_all_w_t_and_m_t":"NOTE:the UE is only required to perform MBSFN measurements when receiving MBMS service of the MBSFN area(s) targeted for logging.","paragraph_zero_based":346},{"literal_text_all_w_t_and_m_t":"For WLAN measurement logging and Bluetooth measurement logging, the UE shall perform WLAN and Bluetooth measurements, respectively, only when indicated in the corresponding configuration. The measurement logging is performed only for logging intervals for which WLAN and Bluetooth measurements are available, respectively.","paragraph_zero_based":347},{"literal_text_all_w_t_and_m_t":"The measurement quantities for downlink pilot strength measurement logging are fixed and consist of both RSRP and RSRQ for EUTRA, both RSCP and Ec/No for UTRA FDD, P-CCPCH RSCP for UTRA 1.28 Mcps TDD, Rxlev for GERAN, and Pilot Pn Phase and Pilot Strength for CDMA2000 if the serving cell is EUTRAN cell, and both RSRP and RSRQ for NR.","paragraph_zero_based":348},{"literal_text_all_w_t_and_m_t":"For NR, in addition to the logged measurement quantities of the camped cell, the best beam index (SSB Index) as along with the best beam RSRP/RSRQ are logged as well as the 'number of good beams' (the number of SSBs that are above the configured threshold i.e., absThreshSS-BlocksConsolidation, if configured by the network) associated to the cells within the R value range (which is configured by network for cell reselection) of the highest ranked cell as part of the beam level measurements. Sensor measurements are logged if available.","paragraph_zero_based":349},{"literal_text_all_w_t_and_m_t":"For E-UTRA, uncompensated barometric pressure measurements are logged if available.","paragraph_zero_based":350},{"literal_text_all_w_t_and_m_t":"The measurement quantities for E-UTRA MBSFN measurement logging are fixed and consist of MBSFN RSRP, MBSFN RSRQ, BLER for signalling and BLER for data per MCH, in addition to the measurement quantities for downlink pilot strength measurements.","paragraph_zero_based":351},{"literal_text_all_w_t_and_m_t":"The measurement quantities for WLAN measurement logging are fixed and consist of BSSID, SSID, HESSID of WLAN APs. If configured by the network, optionally available RSSI and RTT can be included.","paragraph_zero_based":352},{"literal_text_all_w_t_and_m_t":"The measurement quantity for Bluetooth measurement logging is fixed and consists of MAC address of Bluetooth beacons. If configured by the network, optionally available RSSI can be included.","paragraph_zero_based":353},{"literal_text_all_w_t_and_m_t":"UE collects MDT measurements and continues logging according to the logged measurement configuration until UE memory reserved for MDT is full. In this case the UE stops logging, stops the log duration timer and starts the 48 hour timer.","paragraph_zero_based":354},{"literal_text_all_w_t_and_m_t":"5.1.1.3Measurement reporting","paragraph_zero_based":355},{"literal_text_all_w_t_and_m_t":"5.1.1.3.1Availability Indicator","paragraph_zero_based":356},{"literal_text_all_w_t_and_m_t":"A UE configured to perform Logged MDT downlink pilot strength measurements indicates the availability of Logged MDT measurements, by means of a one bit, in RRCConnectionSetupComplete or RRCSetupComplete or RRCConnectionResumeComplete or RRCResumeComplete message during connection establishment. Furthermore, the indicator (possibly updated) shall be provided within:","paragraph_zero_based":357},{"literal_text_all_w_t_and_m_t":"-E-UTRAN handover and re-establishment;","paragraph_zero_based":358},{"literal_text_all_w_t_and_m_t":"-UTRAN procedures involving the change of SRNC (SRNC relocation), CELL UPDATE, URA UPDATE messages as well as MEASUREMENT REPORT message in case of state transition to CELL_FACH without CELL UPDATE;","paragraph_zero_based":359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"0254bea9b44234fd4ae3ce61d1b7572c9739a2f3f98aac5d753159622ecf9743","original_member_sha256":"89d3a65a890ec1c34665df3994d13674a43f65265801792df8571bdbaed4c1df","paragraph_ElementTree_utf8_XML_sha256":["5d55df28a3de93916e7cfff91bacac3ff0d12f2a1a7e190e10f29982251d393c","308e3c7f0906d0249126ce24c493e4cec7af9bb1a1f36712d961fac0979ac1ce","23901dc75458997c564fb04134bbc68088de03530ee61e29102a7457bdeb0b9d","aa1a5b9815de40724164b3597ceebb03e56fef216f402d68ea7c8933f7e98950","1a2a6397a12e2f4aa3a893de238e5f4aaf17b46120fa5c66c2690b1c64d89dec","463c564e5cf86248884663111517c4e9abeaaab8d33571c3fa847cfcdfb1730b","114aa5213515a7a83092c15cd575796e204cc20f3b7b00539031c047d50ccbb5","35f868e47c3ad10ef17dcd09c895a4409005c9694d80ad6a9784354f005dc8c8","97c7fbc8e168aa6037cbda965d6cb03e53cf4bee1818bfd16fef2875a8f7e6f7","cd7d9ecda0a14594a9947f98bde9f525a5ce9c458ad14aa9d296a8a46d421c9a","e88995a7f6ce769e862c7214bf4782b597202055decabaf63d67be979f59caa5","82f22b39d8e71f072549b4ce911deb058ff95118a9154ab9248463a3da811750","3ee4adee68d35958a9fc1d9777ccb01ca518fcfac703d66a74cb72ead7ff8447","7f7dc1778ba2ff42261b17260c046b5a55adf490dcd31b8675b21ef089c055e4","99d35ca53886fdfea489e20495d9de8ef50bd5a7acfff9d1c436edbe33896aa7","41f9d111548dcd9c51545f2530fa99b8dcbe3ae6ac4ccac834249c369019de29","c41be51d90510af9e9a77dfff18c24be49ae47fe8758556ae1573864d22a1651","27c2de20ca9491721b5cedffc0a9dc6792a55fafd75099343b198fd4d6111f33","130bfe529ceddce5213b10e04958abfc34c5e468a0f2dcb1df29b20cd5f278cf","89179f042e99ac3ff710184057c6079f38f3a2cc2c4e41213892990f62168a98","259ac4e5c4474a07f96f4801aa24e783280dd6f9fa6a11b6a6c8fd8803a4fce1","06f9cf973a85020ba6c045a9a28ea638f4af53d58b5dbdc41f81f835c612d028","b76eafcd1a43435aeca5f2be0118ba03a405fe81c52f94b5eb56feccc99fc216","14f40a28845bde32a813daa0e265d785254d9922fea6b28442dcfb4f0912c655"],"paragraph_range_zero_based":[336,359],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx:p336"}
{"fields":{"filename":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-NR re-establishment, reconfiguration.","paragraph_zero_based":360},{"literal_text_all_w_t_and_m_t":"The UE includes the indication in one of these messages at every transition to RRC Connected mode even though the logging period has not ended, upon connection to RAT which configured the UE to perform Logged MDT measurements and RPLMN which is equal to a PLMN in the MDT PLMN list or currently registered SNPN whose identity is in the stored SNPN identities.","paragraph_zero_based":361},{"literal_text_all_w_t_and_m_t":"A E-UTRA UE configured to perform Logged MDT MBSFN measurements indicates the availability of Logged MDT MBSFN measurements, by means of an indicator, in RRCConnectionSetupComplete message during connection establishment. The indicator (possibly updated) shall be provided within E-UTRAN also at handover and re-establishment, except when the logged measurement configuration is active in CONNECTED mode, i.e. except when the logging campaign is still ongoing.","paragraph_zero_based":362},{"literal_text_all_w_t_and_m_t":"A E-UTRA UE configured to perform Logged MDT WLAN measurements indicates the availability of Logged MDT WLAN measurements, by means of an indicator, in RRCConnectionSetupComplete message or RRCConnectionResumeComplete message during connection establishment. Furthermore, the indicator can be included in some uplink RRC messages, i.e., RRCConnectionReconfigurationComplete message, RRCConnectionReestablishmentComplete message, or UEInformationResponse message, at every transition to RRC Connected mode even though the logging period has not ended.","paragraph_zero_based":363},{"literal_text_all_w_t_and_m_t":"A E-UTRA UE configured to perform Logged MDT Bluetooth measurements indicates the availability of Logged MDT Bluetooth measurements, by means of an indicator, in RRCConnectionSetupComplete message or RRCConnectionResumeComplete message during connection establishment. Furthermore, the indicator can be included in some uplink RRC messages, i.e., RRCConnectionReconfigurationComplete message, RRCConnectionReestablishmentComplete message, or UEInformationResponse message, at every transition to RRC Connected mode even though the logging period has not ended.","paragraph_zero_based":364},{"literal_text_all_w_t_and_m_t":"A NR UE configured to perform Logged MDT WLAN measurements indicates the availability of Logged MDT WLAN measurements, by means of an indicator, in RRCSetupComplete message or RRCResumeComplete message during connection establishment. Furthermore, the indicator can be included in some uplink RRC messages, i.e., RRCReconfigurationComplete message, RRCReestablishmentComplete message, or UEInformationResponse message, at every transition to RRC Connected mode even though the logging period has not ended.","paragraph_zero_based":365},{"literal_text_all_w_t_and_m_t":"A NR UE configured to perform Logged MDT Bluetooth measurements indicates the availability of Logged MDT Bluetooth measurements, by means of an indicator, in RRCSetupComplete message or RRCResumeComplete message during connection establishment. Furthermore, the indicator can be included in some uplink RRC messages, i.e., RRCReconfigurationComplete message, RRCReestablishmentComplete message, or UEInformationResponse message, at every transition to RRC Connected mode even though the logging period has not ended.","paragraph_zero_based":366},{"literal_text_all_w_t_and_m_t":"An indicator shall be also provided in UEInformationResponse message during MDT report retrieval in case the UE has not transferred the total log in one RRC message in order to indicate the remaining data availability.","paragraph_zero_based":367},{"literal_text_all_w_t_and_m_t":"The UE will not indicate the availability of MDT measurements in another RAT or in a PLMN that is not in the MDT PLMN list or in a SNPN whose identity is not in the stored SNPN identities.","paragraph_zero_based":368},{"literal_text_all_w_t_and_m_t":"The network may decide to retrieve the logged measurements based on this indication. In case Logged MDT measurements are retrieved before the completion of the pre-defined logging duration, the reported measurement results are deleted, but MDT measurement logging will continue according to ongoing logged measurement configuration.","paragraph_zero_based":369},{"literal_text_all_w_t_and_m_t":"In case the network does not retrieve Logged MDT measurements, UE should store non-retrieved measurements for 48 hours from the moment the duration timer for logging expired. There is no requirement to store non-retrieved data beyond 48 hours. In addition, all logged measurement configuration and the log shall be removed by the UE at switch off or detach.","paragraph_zero_based":370},{"literal_text_all_w_t_and_m_t":"5.1.1.3.2Report retrieval","paragraph_zero_based":371},{"literal_text_all_w_t_and_m_t":"For Logged MDT the measurement reporting is triggered by an on-demand mechanism, i.e. the UE is asked by the network to send the collected measurement logs via RRC signalling. UE Information procedure defined in TS 25.331 [4] and TS 36.331 [5] and TS 38.331 [15] is used to request UE to send the collected measurement logs. The reporting may occur in different cells than which the logged measurement configuration is signalled.","paragraph_zero_based":372},{"literal_text_all_w_t_and_m_t":"Transport of Logged MDT reports in multiple RRC messages is supported. With every request, the network may receive a part of the total UE log. To indicate the reported data is a segment, the UE shall include data availability indicator in UEInformatonResponse message to convey the information that further measurement information is available, as specified in 5.1.1.3.1. In multiple RRC transmissions for segmented Logged MDT reporting, FIFO order is followed, i.e. the UE should provide oldest available measurement entries in earliest message. There is no requirement specified on the size of particular reporting parts. However, each reported part should be \"self-decodable\", i.e. interpretable even in case all the other parts are not available.","paragraph_zero_based":373},{"literal_text_all_w_t_and_m_t":"The UE shall send an empty report when retrieval is attempted and the RPLMN is not in the MDT PLMN list or in a SNPN that is not in the stored SNPN identities.","paragraph_zero_based":374},{"literal_text_all_w_t_and_m_t":"5.1.1.3.3Reporting parameters","paragraph_zero_based":375},{"literal_text_all_w_t_and_m_t":"For downlink pilot strength measurements, the logged measurement report consists of measurement results for the serving cell (the measurement quantity), available UE measurements performed in idle or inactive for intra-frequency/inter-frequency/inter-RAT, time stamp and location information.","paragraph_zero_based":376},{"literal_text_all_w_t_and_m_t":"For E-UTRA MBSFN measurements logging, the logged measurement report consists of MBSFN measurement results from target MBSFN area(s), if configured, and available downlink pilot strength measurement results. Inter-RAT downlink pilot strength measurements are not required to be logged.","paragraph_zero_based":377},{"literal_text_all_w_t_and_m_t":"For WLAN and Bluetooth measurement logging, the logged measurement reports consist of WLAN and Bluetooth measurement results, respectively.","paragraph_zero_based":378},{"literal_text_all_w_t_and_m_t":"The number of neighbouring cells to be logged is limited by a fixed upper limit per frequency for each category below. The UE should log the measurement results for the neighbouring cells, if available, up to:","paragraph_zero_based":379},{"literal_text_all_w_t_and_m_t":"-6 for intra-frequency neighbouring cells;","paragraph_zero_based":380},{"literal_text_all_w_t_and_m_t":"-3 for inter-frequency neighbouring cells per frequency;","paragraph_zero_based":381},{"literal_text_all_w_t_and_m_t":"-3 for GERAN neighbouring cells per frequency;","paragraph_zero_based":382},{"literal_text_all_w_t_and_m_t":"-3 for UTRAN (if non-serving) neighbouring cells per frequency;","paragraph_zero_based":383}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"0254bea9b44234fd4ae3ce61d1b7572c9739a2f3f98aac5d753159622ecf9743","original_member_sha256":"89d3a65a890ec1c34665df3994d13674a43f65265801792df8571bdbaed4c1df","paragraph_ElementTree_utf8_XML_sha256":["5be97634509eae92443c93098ba729f8d97f511482f535c4f4a55376bcede9b7","a2ff84f8c118f4e9388a00fd05d7db16678f4b224bccad746351764abe076561","1349771d80cf525f0456804c008334451bfe455dad902304163c6ba5c6bf395c","db77d87f213c22750b4e72f678c741f206b11764981672af23fc645452326806","3b76c6da65a1b74a4a50df0a4d8cf21002333f3a2fa60b9e378ac52856285325","7390285c763549d08edfd93b4ced178cd99ad9a4dd974a2d2bcfcd0a8c369c68","78917d05958c80b5b274ef26f9b9659416a05949d282516ea05edbcbb4172a9d","a4640068671d75aa650ffa479873a437564c9a15549db1d73d3d54a22903d954","f7a13d471de12a2e4a20d099f250797d9cf1ef8468d9b67456453f538a4414a0","cf839add825b37bec738c3332a23573a838c18e55b7797867b796d2b3ea0527b","05589a99320be958634d3bcd220958e6f2601248f6896488a45ea808595e81c7","84e5d8dd03392124fa31e58457be0eacd827699e2c7229e042c9d9a63d198b8e","8a53f58e934bfa726e5c534f55e20ed4fc2dd74c890bfc015798bbeeb9ce824b","c06c41b448600ab1d3498b14a0a9639e60e79565bc5d16bb9d9dc3b2eb1c25d2","022405df88b33580615b0198ca90e84c9e5171dd0bee11081d3928e37bf70fcf","1cd4e3f11970de44a55adf08ba1c4c12449c39e2c4658b8e2a513106b8623f0a","0964fd90cbd03a138661d6c19359409e391a68d961d240f99131c90dfad41b4f","e0589430e69e36d99f86e99d31497e35b43840bb3ca482163c4d6bc6f5b0a8ec","acda1ab4c19f25f3166c8a7f78bfa138c060132aeefccf99ae062efaa0d5c03e","ecf7a002de7238841ec2f428abb9f114e508bda4bcb380d2d8dad0442e28954d","2336b6d4b5297f4db570225c3fe7dba4b91ca00f7684e3ec223eaaae0dd576cd","6d374e48d0a45d3ca84448e1304e1cc5364aea154fa012b3e51cb2500804be4a","8e96b162108d665a57adcb40ccbf2d650e6d3b45b006ed0fa3c838058b0887aa","d1622b1d94fd4715f9ab608326cf5cc1586549f6d6027567b7f71bce322d2b6e"],"paragraph_range_zero_based":[360,383],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx:p360"}
{"fields":{"filename":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-3 for E-UTRAN (if non-serving) neighbouring cells per frequency;","paragraph_zero_based":384},{"literal_text_all_w_t_and_m_t":"-3 for NR (if non-serving) neighbouring cells per frequency;","paragraph_zero_based":385},{"literal_text_all_w_t_and_m_t":"-3 for CDMA2000 (if serving is E-UTRA) neighbouring cells per frequency;","paragraph_zero_based":386},{"literal_text_all_w_t_and_m_t":"-32 for WLAN APs;","paragraph_zero_based":387},{"literal_text_all_w_t_and_m_t":"-32 for Bluetooth Beacons.","paragraph_zero_based":388},{"literal_text_all_w_t_and_m_t":"NOTE:UE in NR IDLE or INACTIVE state will not log measurements from UMTS or GSM.","paragraph_zero_based":389},{"literal_text_all_w_t_and_m_t":"The measurement reports for neighbour cells consist of:","paragraph_zero_based":390},{"literal_text_all_w_t_and_m_t":"-Physical cell identity of the logged cell;","paragraph_zero_based":391},{"literal_text_all_w_t_and_m_t":"-Carrier frequency;","paragraph_zero_based":392},{"literal_text_all_w_t_and_m_t":"-RSRP and RSRQ for EUTRA and NR;","paragraph_zero_based":393},{"literal_text_all_w_t_and_m_t":"-RSCP and Ec/No for UTRA FDD,","paragraph_zero_based":394},{"literal_text_all_w_t_and_m_t":"-P-CCPCH RSCP for UTRA 1.28 Mcps TDD;","paragraph_zero_based":395},{"literal_text_all_w_t_and_m_t":"-Rxlev for GERAN;","paragraph_zero_based":396},{"literal_text_all_w_t_and_m_t":"-Pilot Pn Phase and Pilot Strength for CDMA2000;","paragraph_zero_based":397},{"literal_text_all_w_t_and_m_t":"-RSSI and RTT for WLAN APs;","paragraph_zero_based":398},{"literal_text_all_w_t_and_m_t":"-RSSI for Bluetooth Beacons.","paragraph_zero_based":399},{"literal_text_all_w_t_and_m_t":"For any logged cell (serving or neighbour), latest available measurement result made for cell reselection purposes is included in the log only if it has not already been reported.","paragraph_zero_based":400},{"literal_text_all_w_t_and_m_t":"While logging neighbour cells measurements, the UE shall determine a fixed number of best cells based on the measurement quantity used for ranking during cell reselection per frequency or RAT.","paragraph_zero_based":401},{"literal_text_all_w_t_and_m_t":"The MBSFN measurement results consist of, per MBSFN area where MBMS service is received:","paragraph_zero_based":402},{"literal_text_all_w_t_and_m_t":"-MBSFN area identity;","paragraph_zero_based":403},{"literal_text_all_w_t_and_m_t":"-Carrier frequency;","paragraph_zero_based":404},{"literal_text_all_w_t_and_m_t":"-MBSFN RSRP;","paragraph_zero_based":405},{"literal_text_all_w_t_and_m_t":"-MBSFN RSRQ;","paragraph_zero_based":406},{"literal_text_all_w_t_and_m_t":"-MCH BLER for signalling;","paragraph_zero_based":407}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"0254bea9b44234fd4ae3ce61d1b7572c9739a2f3f98aac5d753159622ecf9743","original_member_sha256":"89d3a65a890ec1c34665df3994d13674a43f65265801792df8571bdbaed4c1df","paragraph_ElementTree_utf8_XML_sha256":["d2ce94f3c4e6dacf394d7d6462e859f623e18ef228d71500f83a5f2b060b9bbb","32b9e15dd0d56e1dcf040c7e2aca8babf14d086ac647d867317982ec71a6f48e","2a8b38afdb89292e6f441c0a80e1be2101d6fed738451634666f2540e3970727","32eda5e1137dbb3b054191e83dc3749470befdb904ee24a1dcfe4c5ead89f3eb","9ac1524dd462f90df0e9545d84c4d93fa8ce459a6c55a2a0c973dd6b9f070d43","fd19bfa16872875a4171e7ce255986466f3d7d710270d3683bc44ebcc5581e82","24557a29cf4cdcd7febac2234da04d6a1a9abc0e870cef6aa64f1a7077a35abd","42f8e5e5055273b288ba1fa0a70f8cd43d05e77397f7be286900a6bb78cb8952","6d2c38f3e017d9b77eb51e5cc408c472f7ce031c13b292b4cd70e57325bd9d5f","8e85bb5083607dd5c05accf3fa025a718e47867dd5c4d40777e55936e1716d13","4bb257b071747df0d68ede15ee4e2e2ed4c73fccb4391e08f3643b52a9c076cd","8c827752683d866c1a9f80bad8595b4480fbfe573b51f1c6ad937b8a82e275dd","68337e41ed37945ff5ea4f9ab68ca65f8da824dc19292e8c861ab3ab1b199747","f182313ecb98b4057595a1ed9c5db64f2cef838f382cf210856d9196ecf3aa80","43d84209b4857766fe8471e075ccc9d5d542c00337684ffd7dc83e977f8e0914","5a9d1c31ca9a898c515831cc012dd8bd4fa84d900c83ff94a478084bd327143e","a7c1ced323585ee6cb027a818172270ca30f04e1dd3e43159910bb92c1058bcd","287a69685ded3655fa56841b9a863bde4a43764e5e5f2e66f23bad83bb16e314","58661ced8baef42845a8899e0a7df1cd4a2be23e3f29a25364b9b3e98f187689","4e628b91fe4f82ab19647fce701ec82476ea699d12615550b5e048333e439b3d","8b0aa8c2bbe8e04fb19b35a97c04bd23b738dcbe4f099fa0e79badf86d9f01f0","a62b3e3998cee104d03de145974507ed1bf4490f80cff4682ea659c9fa0c6978","d4c966779f86baffad0c4578e387f97515fcce90b2072768bc1604d27f63c1ad","91ae17ed80c9ad93081afd91ce84c82d151b5a1db9eb274a5a52cf88ad3866df"],"paragraph_range_zero_based":[384,407],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx:p384"}
{"fields":{"filename":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-MCH BLER for data, and related MCH index.","paragraph_zero_based":408},{"literal_text_all_w_t_and_m_t":"The WLAN measurement results consist of, per wireless network served by the WLAN AP:","paragraph_zero_based":409},{"literal_text_all_w_t_and_m_t":"-BSSID, SSID and HESSID;","paragraph_zero_based":410},{"literal_text_all_w_t_and_m_t":"-RSSI for WLAN;","paragraph_zero_based":411},{"literal_text_all_w_t_and_m_t":"-RTT.","paragraph_zero_based":412},{"literal_text_all_w_t_and_m_t":"The Bluetooth measurement results consist of, per wireless network served by the Bluetooth beacon:","paragraph_zero_based":413},{"literal_text_all_w_t_and_m_t":"-MAC address;","paragraph_zero_based":414},{"literal_text_all_w_t_and_m_t":"-RSSI for Bluetooth.","paragraph_zero_based":415},{"literal_text_all_w_t_and_m_t":"Measurements are performed in accordance with requirements defined in TS 25.133 [2] and TS 36.133 [3] and TS 38.133 [16].","paragraph_zero_based":416},{"literal_text_all_w_t_and_m_t":"The measurement report is self contained, i.e. the RAN node is able to interpret the Logged MDT reporting results even if it does not have access to the logged measurement configuration. Each measurement report also contains the necessary parameters for the network to be able to route the reports to the correct TCE and for OAM to identify what is reported. The parameters are sent to the UE in the logged configuration message, see clause 5.1.1.1.1.","paragraph_zero_based":417},{"literal_text_all_w_t_and_m_t":"For each MDT measurement the UE includes a relative time stamp. The base unit for time information in the Logged MDT reports is the second. In the log associated to periodical logging configuration, the time stamp indicates the point in time when periodic logging timer expires. The time stamp is counted in seconds from the moment the logged measurement configuration is received at the UE, relative to the absolute time stamp received within the configuration. The absolute time stamp is the current network time at the point when Logged MDT is configured to the UE. The UE echoes back this absolute reference time. The time format for Logged MDT report is: YY-MM-DD HH:MM:SS.","paragraph_zero_based":418},{"literal_text_all_w_t_and_m_t":"Location information is based on available location information in the UE. Thus, the Logged MDT measurements are tagged by the UE with location data in the following manner:","paragraph_zero_based":419},{"literal_text_all_w_t_and_m_t":"-ECGI, Cell-Id or NCGI in TS 38.300 [22] of the serving cell when the measurement was taken is always included in E-UTRAN, UTRAN or NR respectively;","paragraph_zero_based":420},{"literal_text_all_w_t_and_m_t":"-Detailed location information (e.g. GNSS location information) is included if available in the UE when the measurement was taken. If detailed location information is available, the reporting shall consist of latitude and longitude. Depending on availability, altitude, uncertainty and confidence may be also additionally included. UE tags available detailed location information only once with upcoming measurement sample, and then the detailed location information is discarded, i.e. the validity of detailed location information is implicitly assumed to be one logging interval;","paragraph_zero_based":421},{"literal_text_all_w_t_and_m_t":"-Sensor information (i.e. uncompensated barometric pressure measurement (for NR and E-UTRA), UE speed and UE orientation (only in NR)) can be included, if available in the UE when the measurement was taken.","paragraph_zero_based":422},{"literal_text_all_w_t_and_m_t":"NOTE:The neighbour cell measurement information that is provided by the UE may be used to determine the UE location (RF fingerprint).","paragraph_zero_based":423},{"literal_text_all_w_t_and_m_t":"Depending on location information availability, measurement log/report consists of:","paragraph_zero_based":424},{"literal_text_all_w_t_and_m_t":"-time information, RF measurements, RF fingerprints; or","paragraph_zero_based":425},{"literal_text_all_w_t_and_m_t":"-time information, RF measurements, detailed location information (e.g. GNSS location information);","paragraph_zero_based":426},{"literal_text_all_w_t_and_m_t":"time information, RF measurements, detailed location information, sensor information.","paragraph_zero_based":427},{"literal_text_all_w_t_and_m_t":"5.1.1.4MDT context handling","paragraph_zero_based":428},{"literal_text_all_w_t_and_m_t":"For Logged MDT in IDLE, CELL_PCH, URA_PCH states and CELL_FACH state when second DRX cycle is used and INACTIVE, no need is identified to transfer an MDT context (any related configuration information about measurement and reporting) between (e/g)NBs/RNCs if corresponding MDT configuration has already been configured to UE. In addition, MDT context is assumed to be released in the RAN nodes when the UE is in IDLE and INACTIVE if corresponding MDT configuration has already been configured to UE.","paragraph_zero_based":429},{"literal_text_all_w_t_and_m_t":"For UE in INACTIVE, the MDT context handling during cell reselection as described in 5.4.2 apply.","paragraph_zero_based":430},{"literal_text_all_w_t_and_m_t":"5.1.2Immediate MDT procedures","paragraph_zero_based":431}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"0254bea9b44234fd4ae3ce61d1b7572c9739a2f3f98aac5d753159622ecf9743","original_member_sha256":"89d3a65a890ec1c34665df3994d13674a43f65265801792df8571bdbaed4c1df","paragraph_ElementTree_utf8_XML_sha256":["db2b0483eb29e87f2d9010241ff7e0e1dd058e34558eea66829d332b37d714d6","15259e4d1b2b3958e055047120f115947c07758b7e61c0e6ed952b6270617c41","c2685e067fafd5e923b47811aa8f58cf6e7337518e2b1e9a36ec44942ae084af","e3c724f592130df6b94cdc006b433e73f0397dcf826f6ee11c34d81595d954ea","497e76ea13e291062897bd102c6d249e42312a7e2adc8374395afdc918f3efe9","ab6f5a6d658036250e5a6aade954cc05e3acb9bbbbf3f9bbbab50844f57e4a53","49949bb3bdf1de7c6c67b33fea1a37dee699d85fd4bd9c154e5d18be670cc90b","ae7e71767796b30bc4cc3f1f2f23e0ed6f3d1352df9c7f4e2f1979cdaa3e5c22","8d72ab1a9eb720cd5a936a50c13b60a1bff3aa35bc2906b0818cc7e3faeb62c0","d9aa867611c45964e9f3ab88d64b2f234d90c3e6b794b32e5698bfadaa1fcb42","62df44a715896e44a0dd6cb0c8bf0f1604a4f00023a28bbfaff5f4bf6e2ddcb2","6945cf1baded989da1ff47b55a0ebfe998aa0ea54d2e5134c9c684005735f6d8","344454213e49df6d194eac35c734ad9ce2550af98ed029e1825904481ce72052","9ae83362c62c98ff5882398c09404406eeed85df294beffb947525361265ff05","9af7fca7031c9db463dd410d1ecc4f10459ce1cb148a6db856e87bb0668e553d","fba74d7546f91ff8ac9d1bb2422790a37777d8914b3309e20d7d21f3957f309c","6bb1bfd26ba5890d1d2fb453959b5be6bf64acce43b8771015f8983b8d5d3fbe","eb0b47540e590795ab4b1d860af175ec7a977f6fd920bc3c1adf759e139fc5b3","254e7b832e9cb8f1e1b31e9c7d8b71cf0a657abb18352102c18a559d37e25e4d","80792c35aba06e5548255e9ac1d11ee73187dbf952caed11f584d5032105b58d","14bb01e7024051837355f7376aed5edecfc3ef56c5bd26e8c0251011c4410932","b3e111a1018df91f5b9d5adbfe669fe225ef038b1bd77373546b5e37dead0cd5","cc98b5e730bfb97be185ba712c33dc72ebedb290f8c281c52bdda7bb87d91c05","c8112426dc45953ee44a97370fb9327c5dcfe1c017b2496d13595d31de98475c"],"paragraph_range_zero_based":[408,431],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx:p408"}
{"fields":{"filename":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.1.2.1Measurement configuration","paragraph_zero_based":432},{"literal_text_all_w_t_and_m_t":"For Immediate MDT without logging of UE radio measurements, RAN measurements and UE measurements can be configured. The configuration for UE measurements is based on the existing RRC measurement procedures for configuration and reporting with some extensions for location information.","paragraph_zero_based":433},{"literal_text_all_w_t_and_m_t":"NOTE:No extensions related to time stamp are expected for Immediate MDT i.e. time stamp is expected to be provided by eNB/RNC/gNB.","paragraph_zero_based":434},{"literal_text_all_w_t_and_m_t":"If area scope is included in the MDT configuration provided to the RAN, the UE is configured with respective measurement when the UE is connected to a cell that is part of the configured area scope.","paragraph_zero_based":435},{"literal_text_all_w_t_and_m_t":"For network-side data collection, immediate MDT can be configured with logging of UE radio measurements as defined in TS 38.331 [15].","paragraph_zero_based":436},{"literal_text_all_w_t_and_m_t":"5.1.2.2Measurement reporting","paragraph_zero_based":437},{"literal_text_all_w_t_and_m_t":"For Immediate MDT, the UE provides detailed location information (e.g. GNSS location information) if available. The UE also provides available neighbour cell measurement information that may be used to determine the UE location (RF fingerprint). ECGI, Cell-Id, or CellIdentity of the serving cell when the measurement was taken is always assumed known in E-UTRAN, UTRAN or NR respectively.","paragraph_zero_based":438},{"literal_text_all_w_t_and_m_t":"The location information which comes with UE radio measurements for MDT can be correlated with other MDT measurements, e.g. RAN measurements. For MDT measurements where UE location information is provided separately, it is assumed that the correlation of location information and MDT measurements should be done in the TCE based on time-stamps.","paragraph_zero_based":439},{"literal_text_all_w_t_and_m_t":"When the gNB becomes aware of an in-device coexistence interference problem for NR reported by the UE, this information should be forwarded to the TCE which may correlate impacted measurements (e.g. RAN measurements M4, M5, M6, M7) with the in-device coexistence interference problem.","paragraph_zero_based":440},{"literal_text_all_w_t_and_m_t":"5.1.2.3MDT context handling during handover and UE context retrieval","paragraph_zero_based":441},{"literal_text_all_w_t_and_m_t":"The measurements configured in the UE for Immediate MDT should fully comply with the transferring and reconfiguration principles for the current measurements configured in the UE for RRM purpose during handover (including conformance with Rel-8 and Rel-9).","paragraph_zero_based":442},{"literal_text_all_w_t_and_m_t":"The target node releases the measurements configured in the UE for immediate MDT which are no longer needed based on any MDT trace configuration it receives or does not receive.","paragraph_zero_based":443},{"literal_text_all_w_t_and_m_t":"In addition, MDT configuration handling during handover and UE context retrieval depends on MDT initiation from OAM defined in clause 5.1.3:","paragraph_zero_based":444},{"literal_text_all_w_t_and_m_t":"-The MDT configuration configured by management based trace function will not propagate during handover.","paragraph_zero_based":445},{"literal_text_all_w_t_and_m_t":"-For LTE, the MDT configuration received by signalling based trace messages for a specific UE will propagate during intra-PLMN handover, and may propagate during inter-PLMN handover if the Signalling Based MDT PLMN List is available and includes the target PLMN. This behaviour applies also for MDT configuration that includes area scope, regardless of whether the source or target cell is part of the configured area scope. This behaviour applies also for Xn inter-RAT handover.","paragraph_zero_based":446},{"literal_text_all_w_t_and_m_t":"-For UMTS, the MDT configuration received by signalling based trace messages for a specific UE will continue during intra-PLMN handover, and may continue during inter-PLMN handover if the Signalling Based MDT PLMN List is available and includes the target PLMN, except for the case of SRNS relocation.","paragraph_zero_based":447},{"literal_text_all_w_t_and_m_t":"-For NR, the MDT configuration received by signalling based trace messages for a specific UE will propagate during intra-PLMN handover, intra-PLMN UE context retrieval, and may propagate during inter-PLMN handover or inter-PLMN UE context retrieval if the Signalling Based MDT PLMN List is available and includes the target PLMN. This behaviour applies also for MDT configuration that includes area scope, regardless of whether the source or target cell is part of the configured area scope. This behaviour applies also for Xn inter-RAT handover.","paragraph_zero_based":448},{"literal_text_all_w_t_and_m_t":"NOTE:In the case of SRNS relocation, MDT may be reactivated by the Core Network following a successful relocation.","paragraph_zero_based":449},{"literal_text_all_w_t_and_m_t":"5.1.3MDT Initiation","paragraph_zero_based":450},{"literal_text_all_w_t_and_m_t":"There are two cases that RAN should initiate a MDT measurements collection task. One is that the MDT task is initiated without targeting a specific UE by the cell traffic trace, i.e. management based trace function from OAM. The other is that the MDT task is initiated towards a specific UE by the signalling trace activation messages from CN nodes, i.e. the Initial Context Setup message, the Trace Start message or the Handover request message in E-UTRAN or NR, the CN Invoke Trace message in UTRAN. The detailed procedures to transfer the MDT configurations to RAN are specified in TS 32.422 [6].","paragraph_zero_based":451},{"literal_text_all_w_t_and_m_t":"For signalling based MDT within a PLMN, the CN shall not initiate MDT towards a particular user unless it is allowed.","paragraph_zero_based":452},{"literal_text_all_w_t_and_m_t":"For management based MDT within a PLMN, the CN indicates to the RAN whether MDT is allowed to be configured by the RAN for this user considering e.g. user consent and roaming status (see TS 32.422 [6]), by providing management based MDT allowed information. For MDT measurements that are not subject to user consent, the RAN may initiate MDT towards a particular UE independently of user consent. For E-UTRAN/UTRAN, the MDT allowed information consists of the Management Based MDT Allowed indication and optionally the Management Based MDT PLMN List. For NR, the MDT allowed information only consists of the Management Based MDT PLMN List. The management based MDT allowed information propagates during inter-PLMN handover or inter-PLMN UE context retrieval if the Management Based MDT PLMN List is available and includes the target PLMN.","paragraph_zero_based":453},{"literal_text_all_w_t_and_m_t":"A UE is configured with an MDT PLMN List from AMF if user consent is valid for the RPLMN, or a UE is configured with an MDT PLMN List from OAM if any of the MDT measurements in the MDT configuration is configurable and not subject to user consent, as specified in TS 32.422 [6].","paragraph_zero_based":454},{"literal_text_all_w_t_and_m_t":"User consent does not apply if the UE is served by an SNPN.","paragraph_zero_based":455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"0254bea9b44234fd4ae3ce61d1b7572c9739a2f3f98aac5d753159622ecf9743","original_member_sha256":"89d3a65a890ec1c34665df3994d13674a43f65265801792df8571bdbaed4c1df","paragraph_ElementTree_utf8_XML_sha256":["1f9c3f7a2ddef79a5a8842c75e3df74adc83bd25d88ead89685574d60e4cc1a1","5c30045979f82333a6b53581a9a55113cef930fbec1cd32c21c247cbe2e332fc","692321feb9265db7d47139c1200ac3f13dd5e37c20f493549111769417b2b204","732d198526bbdc69a28653165766804cd0ef2e134142afa6eed7e31e7e274f19","a09f6cb41ec14312ae4a6e0ab6571e0ec86849e2640e5cfdba39275e58e9fd9d","5af034c187d0bfdf35c64a0ffebddcfcd0ab42955b7eaa32d9c93c968136ecc7","3799519a0d00a60a082d14f49092cc873e2031de4ba60e8e88fdb3eed28a6620","14a52ca70826c7b65a564539a80cc11bd1bf0df440c0057631d5a9f4004c5711","b0d91d8d2195bfab317efb3dcb51162d5baad0ef179c66a0d4400d676161562a","5def20f12ff7e740c34653656e0d18ebd474fa410a07f08b7188c696e2bc4d5f","f6655bfc4b9d1b4ffb8d5e411c09aa9406c291ba3769ad44269b2546c0d78fb6","65c26f37e89fbcfb8282b8f524c57769266b4644d70f13f305307b5dde7763a9","1a2af2de43a45a8fe312c16db904832c585942de0fabd6128aed771cf2b425f6","4c95f8a9f944ed0d095b5801a6cec45fa773da43e4457b204fd0586503fa3ae7","0d79d67ec7ae47e7798dfbb0c52b7598fc1456061824b3b3581c5bd8c82f474e","ccb5fa0c76320e8e83e01773ea907bddd7b9f5356be52d76cc1b4cc2f697403d","b81e3e42de9668ade87cbaa480cb286c86df21e8a6226971a411eb217af6d9c8","c7de904f43ba2a72a594d6c25f1f044f2f62ece9ef5ccfd1e675d107abb6f964","719eb76830e4a64bc9454e283ac56dc8582d26aefc443f60a9c75815f3935752","3525054bcd4b3f79ecf623a36d9e01e5ff0787ea1df04663c551b8f261c8b0ac","8d2a9dd4974e5651b6953b81b7c2a1b61eb483f0e826cdbfe946120750e95251","9bf190d1a28fd9b30c072b3d8e3ec67ebabc7ef1ead36f8b1c8319cf8f1065fc","a3ed685523a12399863c80b7eb0f6b7f385d8a8d68b3501746d3d80d797bbbdb","1029e63947ea05db0a1adc7e3620e40d825b1ffb108cfc9d098e7e7c49d85758"],"paragraph_range_zero_based":[432,455],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx:p432"}
{"fields":{"filename":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.1.4UE capabilities","paragraph_zero_based":456},{"literal_text_all_w_t_and_m_t":"MDT relevant UE capabilities are component of radio access UE capabilities. Thus, the procedures used for handling UE radio capabilities over (E-)UTRAN and NR apply.","paragraph_zero_based":457},{"literal_text_all_w_t_and_m_t":"For (E-)UTRAN:","paragraph_zero_based":458},{"literal_text_all_w_t_and_m_t":"-The UE indicates one capability bit for support for Logged MDT, which indicates that the UE supports logging of downlink pilot strength measurements. The UE may also indicate capability for stand-alone GNSS positioning.","paragraph_zero_based":459},{"literal_text_all_w_t_and_m_t":"-The E-UTRA UE may indicate capability bits for support of event triggered Logged MDT.","paragraph_zero_based":460},{"literal_text_all_w_t_and_m_t":"-The E-UTRA UE may indicate a capability for RX-TX time difference measurement for E-CID positioning for MDT.","paragraph_zero_based":461},{"literal_text_all_w_t_and_m_t":"-The E-UTRA UE may indicate a capability for support of logging of MBSFN measurements.","paragraph_zero_based":462},{"literal_text_all_w_t_and_m_t":"-The E-UTRA UE may indicate a capability for support of UL PDCP delay measurement when the UE is not configured with MR-DC.","paragraph_zero_based":463},{"literal_text_all_w_t_and_m_t":"-The E-UTRA UE may indicate a capability for support of UL PDCP Packet Average Delay measurement when the UE is configured with EN-DC.","paragraph_zero_based":464},{"literal_text_all_w_t_and_m_t":"-The E-UTRA UE may indicate a capability for support of Bluetooth measurements in RRC idle mode.","paragraph_zero_based":465},{"literal_text_all_w_t_and_m_t":"-The E-UTRA UE may indicate a capability for support of WLAN measurements in RRC idle mode.","paragraph_zero_based":466},{"literal_text_all_w_t_and_m_t":"-The E-UTRA UE may indicate a capability for support of Bluetooth measurements in RRC connected mode.","paragraph_zero_based":467},{"literal_text_all_w_t_and_m_t":"-The E-UTRA UE may indicate a capability for support of WLAN measurements in RRC connected mode.","paragraph_zero_based":468},{"literal_text_all_w_t_and_m_t":"-The E-UTRA UE may indicate a capability for support of barometer measurements in RRC idle mode.","paragraph_zero_based":469},{"literal_text_all_w_t_and_m_t":"-The E-UTRA UE may indicate a capability for support of barometer measurements in RRC connected mode.","paragraph_zero_based":470},{"literal_text_all_w_t_and_m_t":"-The E-UTRA UE may indicate a capability for support of E-UTRA configured signalling based logged measurements override protection at mobility from E-UTRA to NR.","paragraph_zero_based":471},{"literal_text_all_w_t_and_m_t":"-For UMTS support of the Accessibility measurements is an optional UE feature.","paragraph_zero_based":472},{"literal_text_all_w_t_and_m_t":"For NR:","paragraph_zero_based":473},{"literal_text_all_w_t_and_m_t":"-The UE indicates one capability bit for support for Logged MDT in RRC idle and inactive mode, to indicate that the UE supports logging of downlink pilot strength measurements, periodical logging and event-triggered logging.","paragraph_zero_based":474},{"literal_text_all_w_t_and_m_t":"NOTE:Logged MDT suspension due to in-device coexistence detection is conditionally mandatory feature, i.e., it is mandatory supported if the UE supports Logged MDT in RRC idle and inactive mode.","paragraph_zero_based":475},{"literal_text_all_w_t_and_m_t":"-The NR UE may indicate a capability bit for support of signalling based Logged MDT overriding protection.","paragraph_zero_based":476},{"literal_text_all_w_t_and_m_t":"-The UE may indicate capability for stand-alone GNSS positioning.","paragraph_zero_based":477},{"literal_text_all_w_t_and_m_t":"-The NR UE may indicate a capability for support of UL PDCP packet average delay measurement.","paragraph_zero_based":478},{"literal_text_all_w_t_and_m_t":"-The NR UE may indicate a capability for support of multiple reports on accessibility measurements.","paragraph_zero_based":479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"0254bea9b44234fd4ae3ce61d1b7572c9739a2f3f98aac5d753159622ecf9743","original_member_sha256":"89d3a65a890ec1c34665df3994d13674a43f65265801792df8571bdbaed4c1df","paragraph_ElementTree_utf8_XML_sha256":["e0f328943ef3db0c78188cd711b58393774c3bd1d86bcd9c76d47013ca0bff96","a704a496123c33ce2f0ec685b4a24a5fae34f5ef0306aaaeeba004984a2aba36","46e6d5ce86a217c8d00557600a807ff674251d42799832dfda22292875f663c7","dc151ea5c1a1d7a8f904d324976c88e50fe356b401c8a2d74946659d69badede","455f205b64954284a69d419b01846ada67cdc2eaa0ae8b16eb9f8e84c18c24ff","5963066a54723d039f83d4ebdd1cf73fd53d8321ec204f9e09807472c9617019","449575df8a4d95c5656d24d936d6372425f6d0d27ae7e30b8a8dbe73c63ec6b9","48ba8209b692c413e38a19ba62a421665381b42bfa3b9a3fcd26fec90af6c216","092f4fa2fed57acac063b273293444faa27aadcc6186730235cfc27a6dbc08b3","6cfd3c45bdd77b070e894ccb660406cbbe196fb3efb55b7544535c83a67ac04f","7698292630e733ca6c7889d41d59b8976ab4515cd9b39b375a61554f75c04774","9f03f97061a2a977311da81b982791c8222398ff61718973c580c777e63de076","57e0d111d2b833a6d8f86c2d73160dec69059a4acd212e58ab72db1f83e67736","ca67a70a33120df0c6318de94a4924abdda876cf3268199e741cb6316d74b15d","1eba401049d1ff8714bd6b272080ce791c2e3fd675eb819d4a00a1e2f1becce1","4f13533b5b49a75db1279cd5d1b9e3b6f1145651420ffe345d8311d44e6407c1","1bccbf454604995a4edc47f1961282db47e0c59a2733f28a8504645ac985a149","6b6c6701931a71740f5e4732147b055bec2a7639fc44474eda89a2a18febe176","8694c36275991ed08bef56d1642ee9aba132c0748740d6189ca55504b5ba2124","6d50d17c37847790d9d61a508894c9e4565b01a2870fe5d5f914e92a183cf505","814206a7f592e20e89ae3dcac98ba4987c35a35581cd90278e243ba5fffb2ada","8d3515aebb86c04c9b3c7e64d68f3968fcc785d5a8da84ec7bea309fa2e71430","69e36be2990caf7bcff3a0776fc9761b7eea6f6d16c5600a5ebf3d8d54352a2e","0187b870b3273590e959268b131d0584865c336a7a1e14936ee26b055deb1f9a"],"paragraph_range_zero_based":[456,479],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx:p456"}
{"fields":{"filename":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-The NR UE may indicate a capability for support of Bluetooth measurements in RRC idle and inactive mode.","paragraph_zero_based":480},{"literal_text_all_w_t_and_m_t":"-The NR UE may indicate a capability for support of WLAN measurements in RRC idle and inactive mode.","paragraph_zero_based":481},{"literal_text_all_w_t_and_m_t":"-The NR UE may indicate a capability for support of Bluetooth measurements in RRC connected state.","paragraph_zero_based":482},{"literal_text_all_w_t_and_m_t":"-The NR UE may indicate a capability for support of WLAN measurements in RRC connected state.","paragraph_zero_based":483},{"literal_text_all_w_t_and_m_t":"-The NR UE may indicate a capability for support of barometer measurements.","paragraph_zero_based":484},{"literal_text_all_w_t_and_m_t":"-The NR UE may indicate a capability for support of orientation measurements.","paragraph_zero_based":485},{"literal_text_all_w_t_and_m_t":"-The NR UE may indicate a capability for support of speed measurements.","paragraph_zero_based":486},{"literal_text_all_w_t_and_m_t":"-The NR UE may indicate a capability for support of UL PDCP excess packet delay.","paragraph_zero_based":487},{"literal_text_all_w_t_and_m_t":"-The NR UE may indicate a capability for logging and reporting on-Demand SI request information support.","paragraph_zero_based":488},{"literal_text_all_w_t_and_m_t":"-The NR UE may indicate a capability for storing and reporting PSCell Mobility History Information.","paragraph_zero_based":489},{"literal_text_all_w_t_and_m_t":"-The NR UE may indicate a capability for support of RLF report for CHO.","paragraph_zero_based":490},{"literal_text_all_w_t_and_m_t":"-The NR UE may indicate a capability for support of RLF report for DAPS.","paragraph_zero_based":491},{"literal_text_all_w_t_and_m_t":"-The NR UE may indicate a capability for support of storage and delivery of 2-step RACH related information.","paragraph_zero_based":492},{"literal_text_all_w_t_and_m_t":"-The NR UE may indicate a capability bit for support of Logged MDT in PNI-NPN(s).","paragraph_zero_based":493},{"literal_text_all_w_t_and_m_t":"-The NR UE may indicate a capability bit for support of Logged MDT in SNPN(s).","paragraph_zero_based":494},{"literal_text_all_w_t_and_m_t":"-The NR UE may indicate a capability bit for support of logging UE radio measurements for network-side data collection in RRC connected state.","paragraph_zero_based":495},{"literal_text_all_w_t_and_m_t":"5.1.5Void","paragraph_zero_based":496},{"literal_text_all_w_t_and_m_t":"5.1.6Accessibility measurements","paragraph_zero_based":497},{"literal_text_all_w_t_and_m_t":"The UE logs failed RRC connection establishments for LTE, UMTS and NR, i.e. a log is created when the RRC connection establishment procedure fails. For NR, UE logs any failed connection establishment attempt, i.e. a log is created when the RRC setup or resume procedure fails. The UE logs failed RRC connection establishments without the need for prior configuration by the network.","paragraph_zero_based":498},{"literal_text_all_w_t_and_m_t":"The UE stores the Selected PLMN or selected SNPN on the RRC connection establishment failure or RRC resume procedure failure. Only if that PLMN is the same as the RPLMN or if the selected SNPN is the same as the registered SNPN stored, the UE may report the log.","paragraph_zero_based":499},{"literal_text_all_w_t_and_m_t":"NOTE:There is no expected performance degradation for networks using EPLMNs.","paragraph_zero_based":500},{"literal_text_all_w_t_and_m_t":"The trigger for creating a log related to a failed RRC connection establishment is for NR when timer T300 expires, for LTE when timer T300 expires and for UMTS when V300 is greater than N300. The trigger for creating log related to a failed RRC resume procedure is for NR when timer T319 expires.","paragraph_zero_based":501},{"literal_text_all_w_t_and_m_t":"The UE can store the following information related to the failed RRC connection establishment or failed RRC resume procedure:","paragraph_zero_based":502},{"literal_text_all_w_t_and_m_t":"-Time stamp, which is the elapsed time between logging and reporting the log.","paragraph_zero_based":503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"0254bea9b44234fd4ae3ce61d1b7572c9739a2f3f98aac5d753159622ecf9743","original_member_sha256":"89d3a65a890ec1c34665df3994d13674a43f65265801792df8571bdbaed4c1df","paragraph_ElementTree_utf8_XML_sha256":["d8b1f4ca0a2b45d492b8bdb32cf105528cb3a32d8ffe2247b3830e36dad79bae","76b7c409d2b6527a7c68471cb098a2127622d2a88e4b5e9f32906786da187bc6","28c396297bf22333dc3769bd186e2f849ee45ef7ff3824ab19b6b10a12578e50","0eab1fe0ad40c2aad5f3f3b46f19f151ab0277013517d459ab407b84dc807810","6d6c7a09ab46fd6e4db3a7c0384718b7b838f834da85dc35381e823b4ef9e48e","7327f1892d76eb3c9f3d453e9f6455928bb6f8c12b41e00829ae81ffbba17581","4343fb1af6fa9fcb37ac3ecc577006056a460bbe6c7576feb50168ca4ed61d32","05e7e57f9744187df37381a37edd17a3bf1814bf1917e26f80b8bb18d8e9d0dc","bb486a1b67df31fd51a70e8deb7b3463141a988c71c3e0482b0c77b7093bfcfe","17f9df265ece0f502640afc901e4968f33ca0d71bd0eb49222223f6f76d8f7d3","d9ca02c02fb0acd9b354d123db03ead4d1badc370bd02b73e0a59b84b6f06232","74096863e616f94e15d73d2802937e2d09213107aaacf7ead55463ba7a831257","c0651901275c1338081eea8ea27a2520b6500edbb65fd5ff8984cedf4641e074","47b64d71ca58c1051e09b446b8fc94dfb50e4464e2ac96a55bbc7df1b343c1ed","b70b08e0b2a06a5c9e5c69d97dff496d0c28f5ecc78106be5aeb2dd91150a767","d731440803b2435fc13306c000798cf8d49ed28d7ad68b526dcd2302d59a0f74","402fef93cf5a4a2389e6bf076c44a79095ea6cea54a73b6119c84382bd8a040b","83d423aa4284406c506d6daeb5fac02f0d075925b40a0982494b271a03af5e51","bbde39aa15b885142d628f9096a51fc1e670d98b3b4813c3c27f5516ee89e449","d8ee096213f183204fbfec6138088e88f9aa19f19e853dd22c97bcb501b00de8","43efb42fbee6b073ca26848e5007d8c40b217977a9f8fdfd0f2aee57c4d0c6a2","a5e9bf8f2f943619adf8266f692045f5d40b6758e29647df520f572e8ca0a75c","bd68dc3bba1b325a4ebfa7c3e34e41bd9859d23f9fe1b7d83128bd1d57f650c6","4e1b5b9db974b562c656cdab9d1d6cf30bf77b624cb54e4e9569df79c4aab6b3"],"paragraph_range_zero_based":[480,503],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx:p480"}
{"fields":{"filename":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-The global cell identity of the serving cell when the RRC connection establishment or resume fails, i.e. the cell which the UE attempted to access.","paragraph_zero_based":504},{"literal_text_all_w_t_and_m_t":"-The latest available radio measurements for any frequency or RAT","paragraph_zero_based":505},{"literal_text_all_w_t_and_m_t":"-The latest detailed location information, if available.","paragraph_zero_based":506},{"literal_text_all_w_t_and_m_t":"-For LTE:","paragraph_zero_based":507},{"literal_text_all_w_t_and_m_t":"-Number of Random Access Preambles transmitted;","paragraph_zero_based":508},{"literal_text_all_w_t_and_m_t":"-Indication whether the maximum transmission power was used;","paragraph_zero_based":509},{"literal_text_all_w_t_and_m_t":"-Contention detected;","paragraph_zero_based":510},{"literal_text_all_w_t_and_m_t":"-The latest WLAN measurement results, if available;","paragraph_zero_based":511},{"literal_text_all_w_t_and_m_t":"-The latest Bluetooth measurement results, if available.","paragraph_zero_based":512},{"literal_text_all_w_t_and_m_t":"-For UMTS FDD:","paragraph_zero_based":513},{"literal_text_all_w_t_and_m_t":"-Number of RRC Connection Request attempts (e.g. T300 expiry after receiving ACK and AICH)","paragraph_zero_based":514},{"literal_text_all_w_t_and_m_t":"-For UMTS 1.28 Mcps TDD:","paragraph_zero_based":515},{"literal_text_all_w_t_and_m_t":"-Number of RRC Connection Request attempts.","paragraph_zero_based":516},{"literal_text_all_w_t_and_m_t":"-Whether the FPACH is received or whether the maximum number Mmax of synchronisation attempts is reached.","paragraph_zero_based":517},{"literal_text_all_w_t_and_m_t":"-Failure indication of the E-RUCCH transmission. It is only applied when common E-DCH is supported by UE and network.","paragraph_zero_based":518},{"literal_text_all_w_t_and_m_t":"-For NR:","paragraph_zero_based":519},{"literal_text_all_w_t_and_m_t":"-SSB index of the downlink beams of serving cell;","paragraph_zero_based":520},{"literal_text_all_w_t_and_m_t":"-The latest number of consecutive connection failures in the last failed cell the UE has experienced independent of RRC state transitions;","paragraph_zero_based":521},{"literal_text_all_w_t_and_m_t":"-RACH failure report:","paragraph_zero_based":522},{"literal_text_all_w_t_and_m_t":"-Tried SSB index and number of Random Access Preambles transmitted for each tried SSB in chronological order of attempts;","paragraph_zero_based":523},{"literal_text_all_w_t_and_m_t":"-Contention detected as per RACH attempt;","paragraph_zero_based":524},{"literal_text_all_w_t_and_m_t":"-Indication whether the selected SSB is above or below the rsrp-ThresholdSSB threshold, as per RACH attempt;","paragraph_zero_based":525},{"literal_text_all_w_t_and_m_t":"-TAC of the cell in which the UE performs the RA procedure;","paragraph_zero_based":526},{"literal_text_all_w_t_and_m_t":"-For 2-step RACH, the following information can be additionally included:","paragraph_zero_based":527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"0254bea9b44234fd4ae3ce61d1b7572c9739a2f3f98aac5d753159622ecf9743","original_member_sha256":"89d3a65a890ec1c34665df3994d13674a43f65265801792df8571bdbaed4c1df","paragraph_ElementTree_utf8_XML_sha256":["11401ced65010c060b7b8e72c8c812fef71c6d834a8ef2b0d3feab3ec29f4199","de2a34dabc370f3eb636a63795cbc643c961385d90a8db72728bf069d6dbe963","bc15a8c04e02fa33c12452bf278fb7745c9e642486542126dbc77214cfb2e7dc","1531862b78da6ea82bbc2a40253ebc28efd1b938570ae9c5edc47a7e5c079c6c","083e0745dba7c10932a6930833d9feee9659e08e674d2fe58503ca5fce64690c","de64e6ae4b5ce59dfa837eab1598886e1ed73b212038869f13d33ac3465c4f4b","6aba821c22f17547d37b564f044888a3f27e1c9d76f3e78299c33ec363a9639a","005f523373ee843e7c01804213b7a2569920bcf000290ac00fd58982f865b8fd","144577b728870e6d316cca6c616ac0aa4c5781d264b0864f8f94f310051ca334","13cc1a4d7f2d754062f0c2834c9b6987ca74367353f71caacd18372cc1666188","e1fa1d19b43d642b0ba39bf6e330e61c30bfe52e7f049077ece9a99cdbdf93c1","f6ffc3f7f2592db864457aa9fd8010b8fcdf884bd6385c67b837ab16be636feb","c3418015d59bae57f11d4a2e8f1cdcc78f2cb2845c58fa66ef100d5dd4afe03c","ad1cd17a12dfec9cd6c023d8ee7c413dfb6fbb59f94b97bab2ff7e9e401a1557","24f4ed78e2f9207ea108cc68bb5bd8324dd50df7c7e64959abc49fd534436975","4472703c2f0551a66067ec086e000c1ca579c19157be5a71741381b58f9c678d","557df71a24cacd7f8cfe9786b75017c44d845fbc1e06793bee9ed53aac1873e3","1a9f745d41547c39d7b93823d3284d12b130537c685574a15325bc17d164346e","e1ff66aab8b4253c845347215b7f676c00ae5e5d0e9a9727af9697658f0c1210","e80392bad3e45af082e19b084f366c8d9e6e60783a7aa989441e9f0bd1f02873","bfa9f5b847b5315c31e9ac141439601dcc295953fec77d53cbe55a7dea057065","0a4eb2f84cd84365a57b4b160cbbbb81df36c2ef0c51a56ba618bf68884fe2d9","b791d39fddc043fb247ee9618b607caa74e4d83e1087f127cf29b43138bad094","3c0e1e3bb17e710bae50a4c681f2c1c395d53b86443548db886388bb632712f1"],"paragraph_range_zero_based":[504,527],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx:p504"}
{"fields":{"filename":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-Indication that fallback from 2-step RA to 4-step RA was performed by the UE, as per RACH attempt.","paragraph_zero_based":528},{"literal_text_all_w_t_and_m_t":"-Preamble configuration and indications specific to features groups (e.g. RedCap, Small Data Transmission or Slicing) or their combinations, associated to the RA procedure, as specified in TS 38.331 [15].","paragraph_zero_based":529},{"literal_text_all_w_t_and_m_t":"-The latest WLAN measurement results, if available;","paragraph_zero_based":530},{"literal_text_all_w_t_and_m_t":"-The latest Bluetooth measurement results, if available;","paragraph_zero_based":531},{"literal_text_all_w_t_and_m_t":"-The latest sensor information, if available.","paragraph_zero_based":532},{"literal_text_all_w_t_and_m_t":"In addition, the CEF report may include additional information required for RACH Optimization solutions, as specified in TS 38.300 [22].","paragraph_zero_based":533},{"literal_text_all_w_t_and_m_t":"For NR, the UE can store multiple CEF (up to 4) reports to solve the problem about UL/DL coverage imbalance. For the failures happening consecutively in different cells, the UE stores multiple CEF report entries in the CEF report list, as specified in TS 38.331 [15]. For the failures happening consecutively in the same cell, the UE stores only one CEF report entry in the CEF report list, and replaces the last information related to the failed RRC connection establishment or failed RRC resume procedure with the new one, while the number of consecutive connection failures is increased. All the entries in the multiple CEF report list correspond to one PLMN or one SNPN. Prior to logging connection setup or resume failure information for a cell belonging to a different RPLMN or a different registered SNPN, the UE clears stored CEF report entries. The UE clears stored CEF report when moves between SNPN and PLMN.","paragraph_zero_based":534},{"literal_text_all_w_t_and_m_t":"5.2E-UTRAN solutions","paragraph_zero_based":535},{"literal_text_all_w_t_and_m_t":"5.2.1RRC_CONNECTED","paragraph_zero_based":536},{"literal_text_all_w_t_and_m_t":"UE in RRC Connected does not support Logged MDT in this release of the specification, except for the case of logged MDT for MBSFN measurements as described in clause 5.1.1. In order to support Immediate MDT where MDT measurements are executed in the UE, the existing RRC measurement configuration and reporting procedures apply. Some extensions are used to carry location information.","paragraph_zero_based":537},{"literal_text_all_w_t_and_m_t":"5.2.1.1Measurements and reporting triggers for Immediate MDT","paragraph_zero_based":538},{"literal_text_all_w_t_and_m_t":"Measurements to be performed for Immediate MDT purposes involve reporting triggers and criteria utilized for RRM. An MDT specific UE-based measurement for UL PDCP delay is applied for QoS verification purpose. In addition, there are measurements performed in eNB.","paragraph_zero_based":539},{"literal_text_all_w_t_and_m_t":"In particular, the following measurements may be supported for Immediate MDT performance:","paragraph_zero_based":540},{"literal_text_all_w_t_and_m_t":"Measurements:","paragraph_zero_based":541},{"literal_text_all_w_t_and_m_t":"-M1: RSRP, RSRQ and SINR measurement by UE, see TS 36.214 [9].","paragraph_zero_based":542},{"literal_text_all_w_t_and_m_t":"-M2: Power Headroom measurement by UE, see TS 36.213 [11].","paragraph_zero_based":543},{"literal_text_all_w_t_and_m_t":"-M3: Received Interference Power measurement by eNB, see TS 36.214 [9]. This is a cell measurement. One sample is logged each measurement collection period, where one sample corresponds to a measurement period as specified in TS 36.133 [3].","paragraph_zero_based":544},{"literal_text_all_w_t_and_m_t":"-M4: Data Volume measurement separately for DL and UL, per QCI per UE, by eNB, see TS 36.314 [13].","paragraph_zero_based":545},{"literal_text_all_w_t_and_m_t":"-M5: Scheduled IP Throughput for MDT measurement separately for DL and UL, per RAB per UE and per UE for the DL, per UE for the UL, by eNB, see TS 36.314 [13]. QCI values of the RABs that have contributed to a measurement value are logged with the measurement values.","paragraph_zero_based":546},{"literal_text_all_w_t_and_m_t":"-M6: Packet Delay measurement, separately for DL and UL, per QCI per UE, see UL PDCP Delay, by the UE, and Packet Delay in the DL per QCI, by the eNB, TS 36.314 [13].","paragraph_zero_based":547},{"literal_text_all_w_t_and_m_t":"NOTE 1:If the UE does not detect any UL PDCP delay based on the delay threshold and delay report interval configured by the network, the UE does not report any UL PDCP delay measurement within that period.","paragraph_zero_based":548},{"literal_text_all_w_t_and_m_t":"NOTE 2:A UE in EN-DC mode of operation can be configured with UL PDCP Packet Average Delay (ul-DelayValueConfig), if UE is capable of performing the UL average PDCP queueing delay.","paragraph_zero_based":549},{"literal_text_all_w_t_and_m_t":"-M7: Packet Loss rate measurement, separately for DL and UL per QCI per UE, by the eNB, see Packet Loss rate in the UL and Packet Uu Loss rate in the DL TS 36.314 [13].","paragraph_zero_based":550},{"literal_text_all_w_t_and_m_t":"-M8: RSSI measurement by UE, see TS 36.331 [5].","paragraph_zero_based":551}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"0254bea9b44234fd4ae3ce61d1b7572c9739a2f3f98aac5d753159622ecf9743","original_member_sha256":"89d3a65a890ec1c34665df3994d13674a43f65265801792df8571bdbaed4c1df","paragraph_ElementTree_utf8_XML_sha256":["6ea8775e3092489d8f2e9b6dc54d2bfd7be8f1c58c215d28d5b6d6f9f072896d","2f544ba125d9563f733d110e56d28aaa6e257ab58361a0826ed78ab4c3045565","39101ffd414ece83d45755d67cb51cba41e7712753af3fdefd294ae8facef69e","9d841bc644fe27be77885a782be6153d2db2f7379a0abfd711c0513af04f720b","e9be9008cc93ab4d23b0e3032449f9836cfb08c23ab6633b35c4d3183e6a3998","ffdf7cf75d2a836473534e8a9df8d9707bed40810f437e84991dab6c325cbd4b","e2f47269ff5f9b1a51e3275e672fb5eaec795e4fd411ac93c882f7c98cd67728","5f4c2cc237ebb9c8653ee2a9644fc4b7f1ce6ce0ce6de551a23a43c525c52914","03372b64a9233c74eaf07393bd61d714b57a762364be7c749611376dfc278d4d","a91053ab6aea2dd4364f54848e0633926f324cbdcceac2289a13eb98a29b8e12","06f5630b0e77935a25b6c26e8c8b914bea21a64ee1e58916a2e38759a2293447","3b6273347c1728b2dd73c5baef4d2bd96566c4bd21fa5f7d819f604ab3259e0e","884e06bfd580652bd24ecbe68d56ae3ad764493a1ae7faae13225f9f7afdb211","9a8567ce8e6b9ff1a24708fb87b9faa21893a4767c89136bcf9afddffae8ebc9","571c7cb3abafd80cfd3cde8e5fb41239dfedb7a55108480a45ee812d1ddce96c","cb3f30b0858e0fdaa75c37f4eaf578402b536734de3b70cbe5e75aca44c0ddf4","79aabafd1d13d8575355fe5c27be28e1c21c3812ab7afd321fd25723df7599b7","0aeb620d67e26588e5ebc57bf728df6e570bfef90ae328696c4bb3738e3dfc72","1f89685b005fc765810c1b9ee38aa1e2f74e4092088a53a11aa9f4167bf502c2","247e70f3372805b5563e0306911cd0b263ce1e15eb107ab0231d3ff7208e1755","4ee7c16e575e227e220f16604c193cf70b68b4f778979b73259cafe65d2ca80b","6d859840251c88a46ed4e75ec0ca2e53d0668554c6f3c5f6696df2adc28cde75","fea13d35016e1878157246b0d658bcd60fca5fbdf5d92326b892a158cad4f3f8","702ca71de273d6edbe33eec8874c3ae6c66a413a8d4b6716ddab0f23ad91b7b7"],"paragraph_range_zero_based":[528,551],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx:p528"}
{"fields":{"filename":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-M9: RTT measurement by UE, see TS 36.331 [5].","paragraph_zero_based":552},{"literal_text_all_w_t_and_m_t":"Measurement collection triggers:","paragraph_zero_based":553},{"literal_text_all_w_t_and_m_t":"-For M1:","paragraph_zero_based":554},{"literal_text_all_w_t_and_m_t":"-Event-triggered measurement reports according to existing RRM configuration for events A1, A2, A3, A4, A5 A6, B1 or B2","paragraph_zero_based":555},{"literal_text_all_w_t_and_m_t":"-Periodic, A2 event-triggered, or A2 event triggered periodic measurement report according to MDT specific measurement configuration.","paragraph_zero_based":556},{"literal_text_all_w_t_and_m_t":"-For M2:","paragraph_zero_based":557},{"literal_text_all_w_t_and_m_t":"-Reception of Power Headroom Report (PHR) according to existing RRM configuration.","paragraph_zero_based":558},{"literal_text_all_w_t_and_m_t":"NOTE 3:PHR is carried by MAC signalling. Thus, the existing mechanism of PHR transmission applies, see TS 36.321 [10].","paragraph_zero_based":559},{"literal_text_all_w_t_and_m_t":"-For M3:","paragraph_zero_based":560},{"literal_text_all_w_t_and_m_t":"-End of measurement collection period","paragraph_zero_based":561},{"literal_text_all_w_t_and_m_t":"-For M4:","paragraph_zero_based":562},{"literal_text_all_w_t_and_m_t":"-End of measurement collection period.","paragraph_zero_based":563},{"literal_text_all_w_t_and_m_t":"-For M5:","paragraph_zero_based":564},{"literal_text_all_w_t_and_m_t":"-End of measurement collection period.","paragraph_zero_based":565},{"literal_text_all_w_t_and_m_t":"-For M6:","paragraph_zero_based":566},{"literal_text_all_w_t_and_m_t":"-End of measurement collection period.","paragraph_zero_based":567},{"literal_text_all_w_t_and_m_t":"-For M7:","paragraph_zero_based":568},{"literal_text_all_w_t_and_m_t":"-End of measurement collection period.","paragraph_zero_based":569},{"literal_text_all_w_t_and_m_t":"-For M8:","paragraph_zero_based":570},{"literal_text_all_w_t_and_m_t":"-Associated to M1 and/or M6 related measurement reporting triggers.","paragraph_zero_based":571},{"literal_text_all_w_t_and_m_t":"-For M9:","paragraph_zero_based":572},{"literal_text_all_w_t_and_m_t":"-Associated to M1 and/or M6 related measurement reporting triggers.","paragraph_zero_based":573},{"literal_text_all_w_t_and_m_t":"5.2.1.2Enhancement to Radio Link Failure report","paragraph_zero_based":574},{"literal_text_all_w_t_and_m_t":"The Radio Link Failure report contains information related to the latest connection failure experienced by the UE. The connection failure can be Radio Link Failure (RLF) or Handover Failure (HOF). The contents of the RLF report and the procedure for retrieving it by an eNB are described in TS 36.300 [12] or by an NG-RAN are described in TS 38.300 [22].","paragraph_zero_based":575}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"0254bea9b44234fd4ae3ce61d1b7572c9739a2f3f98aac5d753159622ecf9743","original_member_sha256":"89d3a65a890ec1c34665df3994d13674a43f65265801792df8571bdbaed4c1df","paragraph_ElementTree_utf8_XML_sha256":["69bb5ae3ac208bc73d85af5753643faff27288985a0652a2511a795a245ac3f2","fbce4377f0b0720aa769580bde91c65152cac4ddbd23ad8f26abae25bef161f0","812b6f146531fecf6d3d0ec4b33d83bc21a643c5fb4fbb74736814761c783264","43a63683d66c779fbc6f63b0213f5dc419fb71b8cce3ca1ef02ef042e794ae31","92e38d56466a0eeabc217e7f1099e72b02c16f94f36abd8bf773a9e98a58ee10","1fe8eedb19bd929ef0d115b20a13502397472ad24677056beb17a1ff586ee684","1ad9b81bea1e589c0251ffbf9e35f129b5b8cf23b0a288cdcb334a9c9596cc0e","f63d178577f65578a6c5af11c747f110ab7aa5feffc7845f2b1d9a0ecbacb3c0","2721e469cf7ab58c1ed0bc648264ff7b662179eb80351996d1e65310ddafc4a3","de1e3e2d26ce201fdcf288806587470e50ab7a651473c853a39be64b0234c2b9","39379d3acc3eee12f76ed68aec0870ce2533cace966459b78f775c1771b72383","983c012af1af77067d241a32c136b8043dff4a0e24eb5c20bca4a923de5d57b1","68c7fbc6c6de0ee2e46205b9756986b26287d4d7c256bdc18f9957f190eddc4c","ecaac6061bbcf8cdd5ad548baeeb066499aadf9d5e4c4a9527de5031ebfc8991","ee32cf90c6902ff36c57de85029ea8be7b143d130d7a120f1e51e7246f36dfc5","4e9cb1cb1bdac046165d9421bac0b8d6c58af672a7e10240ad7606a62eed2ec5","a4f7f68dadf619b906ce82b8002b18227aeeace283bc27f93debf977e4117d2c","4763804f897c0bfc27513405e57fc7bb22c0d97d7a95331b1607d50c54fb52b9","9c0de4831d5d466b960d12744a9346873f0bf95684be171f1ba4acd2a186ea36","2f58027844239074ea1e4629f76be5349811f28af19a27e443fd2a922d1dc6df","f1b5afe041a09f10fbc565f42584670278bea18516b0e7564cf5bc5e9a8eadcd","cd0a5fa3db9a58f7ed2197b70bb3c1bd58f44d0aa3db5a1c43a497aa658b75de","5c09f41a223616ea18fca887242edbd679730205e0ce995c30f4952f2ce87362","3a42ba2a11251afc88e959a21782cf051e4412114cff916c783095f8c212f084"],"paragraph_range_zero_based":[552,575],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx:p552"}
{"fields":{"filename":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"RLF reports can be collected by OAM. Upon RLF/HOF detection in the UE, rlfReport defined in TS 36.331 [5] also includes available location information on where RLF occurred, i.e. if detailed location information (e.g. GNSS location information) is available the reported location information in rlfReport consists of:","paragraph_zero_based":576},{"literal_text_all_w_t_and_m_t":"-Latitude, longitude (mandatory)","paragraph_zero_based":577},{"literal_text_all_w_t_and_m_t":"-Altitude (conditional on availability)","paragraph_zero_based":578},{"literal_text_all_w_t_and_m_t":"-Velocity (conditional on availability)","paragraph_zero_based":579},{"literal_text_all_w_t_and_m_t":"-Uncertainty (conditional on availability)","paragraph_zero_based":580},{"literal_text_all_w_t_and_m_t":"-Confidence (conditional on availability)","paragraph_zero_based":581},{"literal_text_all_w_t_and_m_t":"-Direction (conditional on availability).","paragraph_zero_based":582},{"literal_text_all_w_t_and_m_t":"As an indication of impact to MMTEL calls the UE indicates in the radio link failure report whether a radio bearer with QCI 1 was established when radio link failure was detected.","paragraph_zero_based":583},{"literal_text_all_w_t_and_m_t":"RLF reports may also include available WLAN measurement results and/or Bluetooth measurement results for calculating UE location.","paragraph_zero_based":584},{"literal_text_all_w_t_and_m_t":"If available, the UE can indicate NR neighbor cell measurements in measurements results.","paragraph_zero_based":585},{"literal_text_all_w_t_and_m_t":"5.2.1.3Detailed Location Information","paragraph_zero_based":586},{"literal_text_all_w_t_and_m_t":"The M1 measurements are tagged by the UE with location data in the following manner:","paragraph_zero_based":587},{"literal_text_all_w_t_and_m_t":"-Detailed location information (e.g. GNSS location information) is included if available in the UE when the measurement was taken. If detailed location information is available, the reporting shall consist of latitude and longitude. Depending on availability, altitude, uncertainty and confidence may be also additionally included. The UE should include the available detailed location information only once. If the detailed location information is obtained by GNSS positioning method, GNSS time information shall be included. For both event based and periodic reporting (see 5.2.1.1), the detailed location information is included if the report is transmitted within the validity time after the detailed location information was obtained. The validity evaluation of detailed location information is left to UE implementation.","paragraph_zero_based":588},{"literal_text_all_w_t_and_m_t":"-To support UE location information in SCG failure, the location information (i.e. commonLocationInfo, see TS 38.331 [15] and WLAN and BT information, if available) is included in SCGFailureInformation message, see TS 36.331 [5].","paragraph_zero_based":589},{"literal_text_all_w_t_and_m_t":"For immediate MDT, the eNB can request the UE to attempt to make GNSS location information available. Standalone GNSS is used as the default baseline. It is desired that the UE provides fresh location information with each immediate MDT measurement report. The details how this is achieved is up to UE implementation.","paragraph_zero_based":590},{"literal_text_all_w_t_and_m_t":"The eNB may use an Enhanced Cell ID mechanism for location. The eNB forwards the raw E-CID specific measurements to the TCE. When E-CID positioning is requested, the eNB may choose to not use E-CID positioning for collected measurement for which the UE provides detailed location information.","paragraph_zero_based":591},{"literal_text_all_w_t_and_m_t":"5.2.2RRC_IDLE","paragraph_zero_based":592},{"literal_text_all_w_t_and_m_t":"For UE in RRC_IDLE state Logged MDT procedures as described in 5.1.1 apply.","paragraph_zero_based":593},{"literal_text_all_w_t_and_m_t":"Logged MDT measurements are sent on Signalling Radio Bearer SRB2 in RRC_CONNECTED state.","paragraph_zero_based":594},{"literal_text_all_w_t_and_m_t":"5.3UTRAN solutions","paragraph_zero_based":595},{"literal_text_all_w_t_and_m_t":"5.3.1UTRA RRC Connected","paragraph_zero_based":596},{"literal_text_all_w_t_and_m_t":"In CELL_PCH, URA_PCH states and CELL_FACH state when second DRX cycle is used, UE supports Logged MDT as described in 5.1.1. In CELL_DCH state UE supports Immediate MDT as described in 5.1.2. In CELL_FACH state when second DRX cycle is not used, MDT is not supported in the current release.","paragraph_zero_based":597},{"literal_text_all_w_t_and_m_t":"5.3.1.1Measurements and reporting events for Immediate MDT","paragraph_zero_based":598},{"literal_text_all_w_t_and_m_t":"The solutions for Immediate MDT in UTRAN are only applicable for UEs in CELL_DCH state. Measurements to be performed for Immediate MDT purposes involve normal UTRAN reporting triggers and criteria utilized for controlling the RRC connection. In addition, there are measurements defined that are performed in UTRAN. In particular, the following measurements shall be supported for Immediate MDT:","paragraph_zero_based":599}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"0254bea9b44234fd4ae3ce61d1b7572c9739a2f3f98aac5d753159622ecf9743","original_member_sha256":"89d3a65a890ec1c34665df3994d13674a43f65265801792df8571bdbaed4c1df","paragraph_ElementTree_utf8_XML_sha256":["3530d2e480d9bed263e108c3dd88c8876909a1828464ff1ea03e6c4521aee604","e90fccabda98f1589f0917da69a7f30b4b3ef2ffdc13deed8516af114528cee2","972e4feb66bc45b8db685166c43dabf523ff63b1ab92af7f011151193266b256","45f33bd2fbd19c15a6f3dce804055461200a1af22104aee5ee6a9bab73d384b8","c892fe49bfc32de74e707ea5e854f30aecccb84a2b558c0af38ffc8d5723b27d","49083d446c3788e6891e0353433d50959c78d6c0cb38bc12d31bd73ca37c0fb4","740f5308baef68e3aa41bac07b1f8709568e07e28d1c42d9b3e6416db5a93b04","e69d2c88f18e0acdf5aa81abb813df123a0ca363352451011a7515ff8cfe311c","d8f88f09551b095059028a50efcf0ed88216cfdfbad5d0920c739233b2e80eb9","6146f81134a9c93e052d6ff84376a2251273997f6719e7c0222a4aa1dc418d92","c19280f3fdfa6513e89359e261e2809aca7e40e87b805cc046d849a4564a5744","c05fa852269e9fef0153a839f5c289cad0f1ce365ecebdd131111910d0f76472","74109adeb886c94169c500ed39c010594ecac0683b2a171d9aeb16e598d98d0b","8974072a0ae7ae6b7e0bb338f15db241b2f1c9e446b92a53bb2b8b41dc0ba9da","e6cd22517534c8dd32b25d2f692d7681dcee555939b0785c2db21bb093d4d437","4575a64e22bf1cf7157c790ff66bc51b29f9bc836ad0a10cd59a529d77d1ea16","fc21bfb1a08481d41d314c040784345d95be6d3d01781cfd8f1957ae6f0bbb3c","4ef0c2b2088ecb03793de82b4a1252e5120a53d515475239de38fcc6788c8375","60120ee492d38afaa79929bdea85934bb798b12c75910b7b933c7d5e34484a2d","cb1ad01fb4f24340564d79742ed26e6ff0504781d8489bfaf9a9c6a0e8100de3","0875489026dadcf062caa5e424f832fcaa109fde6061d3f8cbe8676affead754","d5095572be99f5e8ce8a74b47279065715eda59def9f04723ef48933295a36ea","0d92da9117a30bdb453c7f1b225c3ee72784d52b3e046871d29ffd10c3f8fc85","fb0729e1c297c13844adb7fa12b097fb57f9185f8a60afeda1589e8a984bce4f"],"paragraph_range_zero_based":[576,599],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx:p576"}
{"fields":{"filename":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Measurements:","paragraph_zero_based":600},{"literal_text_all_w_t_and_m_t":"-M1: CPICH RSCP and CPICH Ec/No measurement (FDD) by UE, see TS 25.215 [7].","paragraph_zero_based":601},{"literal_text_all_w_t_and_m_t":"-M2: P-CCPCH RSCP and Timeslot ISCP for UTRA 1.28 Mcps TDD by UE, see TS 25.225 [8].","paragraph_zero_based":602},{"literal_text_all_w_t_and_m_t":"-M3: SIR and SIR error (FDD) by NodeB, see TS 25.215 [7] and TS 25.225 [8].","paragraph_zero_based":603},{"literal_text_all_w_t_and_m_t":"-M4: UE power headroom (UPH) by the UE, applicable for E-DCH transport channels, see TS 25.215 [7] and TS 25.225 [8].","paragraph_zero_based":604},{"literal_text_all_w_t_and_m_t":"-M5: Received total wideband power (RTWP) by Node B, see TS 25.215 [7] TS 25.225 [8], and TS 25.133 [2]. This is a cell measurement.","paragraph_zero_based":605},{"literal_text_all_w_t_and_m_t":"-M6: Data Volume measurement, separately for DL and UL, per QoS class per UE, by RNC.","paragraph_zero_based":606},{"literal_text_all_w_t_and_m_t":"-M7: Throughput measurement, separately for DL and UL, per RAB per UE and per UE, by RNC. Traffic class and Traffic Handling Priority for interactive RABs for the RABs that have contributed to a measurement value are logged with the measurement values.","paragraph_zero_based":607},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":608},{"literal_text_all_w_t_and_m_t":"Measurement collection triggers:","paragraph_zero_based":609},{"literal_text_all_w_t_and_m_t":"-For M1:","paragraph_zero_based":610},{"literal_text_all_w_t_and_m_t":"-Event triggered measurement reports according to existing RRM configuration, for measurement types intra-frequency measurement, inter-frequency measurement and inter-RAT measurement.","paragraph_zero_based":611},{"literal_text_all_w_t_and_m_t":"-Periodic, or 1F event-triggered measurement report, primary CPICH becomes worse than an absolute threshold, according to MDT specific measurement configuration.","paragraph_zero_based":612},{"literal_text_all_w_t_and_m_t":"-For M2:","paragraph_zero_based":613},{"literal_text_all_w_t_and_m_t":"-Event triggered measurement reports according to existing RRM configuration, for measurement types intra-frequency measurement, inter-frequency measurement and inter-RAT measurement.","paragraph_zero_based":614},{"literal_text_all_w_t_and_m_t":"-Periodic, or 1I event-triggered measurement report, timeslot ISCP above a certain threshold (TDD), according to MDT specific measurement configuration.","paragraph_zero_based":615},{"literal_text_all_w_t_and_m_t":"-For M3:","paragraph_zero_based":616},{"literal_text_all_w_t_and_m_t":"-When available","paragraph_zero_based":617},{"literal_text_all_w_t_and_m_t":"-For M4:","paragraph_zero_based":618},{"literal_text_all_w_t_and_m_t":"-Reception of UPH according to existing RRM configuration","paragraph_zero_based":619},{"literal_text_all_w_t_and_m_t":"-Provided by the UE according to RRM configuration.","paragraph_zero_based":620},{"literal_text_all_w_t_and_m_t":"-UPH samples may be collected and logged:","paragraph_zero_based":621},{"literal_text_all_w_t_and_m_t":"-always","paragraph_zero_based":622},{"literal_text_all_w_t_and_m_t":"-periodic, one sample per period.","paragraph_zero_based":623}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"0254bea9b44234fd4ae3ce61d1b7572c9739a2f3f98aac5d753159622ecf9743","original_member_sha256":"89d3a65a890ec1c34665df3994d13674a43f65265801792df8571bdbaed4c1df","paragraph_ElementTree_utf8_XML_sha256":["2dff96d630955a8f4cce8b89d93abdcf1b533858a1b6148c84ceeb97cc4543e5","876197f4f7cc101096c7de4abc4ab6d6b8c42cf6eda3d76aeeac1cb2b76d9a1e","68293173329f60a2e3025515159187d9106c60f13d5248343107da55ebf32e6e","00a2b0ebefb59186466abc64365b41906442de9d7470ce304fe8ce0357e9a081","3d946df03221658f77df194081b644f1687047286c19fc8dc4a53cc86e7b592e","78a082f1bcaa026cb8f1641610e2d318c9e78a29a46185c9fbdfedd792fc0f7c","bd899155abd3471df5d9d405bef7aa1896793cf95ec5f0d6c2c4ac0420c91b00","c507580612fb09e6b2c6fbbb9c89a88baa8432ead7c4a81ef92a567cbb86954a","b9a95a3210ffaff0543a49b328db3988f1caf94e0fd1d1866747fa05d2736704","5c5a7963d11afd1956102165e17bf02d1266e3a728c976b8e80791d611b9e386","c14eec546c968f4db02f86d9b7b4e0ac7f340b116945bfc41d0a55e453faa0e9","c11c6b918755aa7b8221db9f3dc9b5d9888c66d903e9dc1fc6657a3cbb9f8cc7","cc1556f02767b7079f9262bda6bb4149431354fc47b8b4ba697ef248c010bba7","07c6d42ef6266f67a5c0e89a532b7416d753c8e331f9c0fb5983c5905e33a048","4e09d96070b2aee7418d445691aeaa0b224c0c4c8c1663f377177aa6bde9e1f7","38b68b672130f8f322fb87aa447fffbc7b8c609c6cc00124412a0c23083dc16b","ebf75f2fc4005d3d1033abf86a9bd125124d978ed96a34322fe22c5c3ca3296f","43b5fbf79fa8415a32d0512083b890ef2245b252ffd898291297ad2ee1a735dd","6eccd583f5c09cb675425e8d007228970b27da95343e6be0edcb1d2ac35bb8c3","20a6f82ced93effe00edd33b4bee127777eaf86b09081013138a0047c9571285","8e494ba829667080395537cfd2ba757f0567ccbe4eca91b51c68191a72b6273b","23eb290093cf707f113683fa042d188cd40f01cfbaddb1a17f3ffc6578e15075","dde67a4e95b4daa1e9d64e2ab1bb23593afa3332a6d7667d1fa16fa7d1f11c52","e97915419b9a819dc66d8001f8f4375dee32b956c09e39e6ba4085e80cc1ae31"],"paragraph_range_zero_based":[600,623],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx:p600"}
{"fields":{"filename":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-periodic, one sample per period, when measurement value < threshold.","paragraph_zero_based":624},{"literal_text_all_w_t_and_m_t":"-For M5:","paragraph_zero_based":625},{"literal_text_all_w_t_and_m_t":"-When available.","paragraph_zero_based":626},{"literal_text_all_w_t_and_m_t":"-End of measurement collection period.","paragraph_zero_based":627},{"literal_text_all_w_t_and_m_t":"-For M6:","paragraph_zero_based":628},{"literal_text_all_w_t_and_m_t":"-End of measurement collection period.","paragraph_zero_based":629},{"literal_text_all_w_t_and_m_t":"-For M7:","paragraph_zero_based":630},{"literal_text_all_w_t_and_m_t":"-End of measurement collection period.","paragraph_zero_based":631},{"literal_text_all_w_t_and_m_t":"5.3.1.2Detailed Location Information","paragraph_zero_based":632},{"literal_text_all_w_t_and_m_t":"For Immediate MDT, existing procedures for UE Location information are used to obtain detailed location information.","paragraph_zero_based":633},{"literal_text_all_w_t_and_m_t":"5.3.2UTRA Idle","paragraph_zero_based":634},{"literal_text_all_w_t_and_m_t":"For UEs in UTRA Idle mode Logged MDT procedures as described in 5.1.1 apply.","paragraph_zero_based":635},{"literal_text_all_w_t_and_m_t":"Logged MDT measurements are sent on Signalling Radio Bearer SRB4 in RRC Connected mode.","paragraph_zero_based":636},{"literal_text_all_w_t_and_m_t":"5.4NR solutions","paragraph_zero_based":637},{"literal_text_all_w_t_and_m_t":"5.4.0General","paragraph_zero_based":638},{"literal_text_all_w_t_and_m_t":"The management-based MDT configuration should not overwrite signalling based MDT configuration.","paragraph_zero_based":639},{"literal_text_all_w_t_and_m_t":"To assist the network in preventing management based logged MDT overwriting signaling based logged MDT, if the UE is configured with logged MDT type in NR or E-UTRA, the UE provides an assistance information in NR during connection establishment, re-establishment, resume, intra-NR handover and mobility from E-UTRA (including connection establishment after reselection to NR cell from E-UTRA cell and handover from E-UTRA to NR). The information indicates the signaling based logged MDT configuration or unretrieved signaling based logged MDT measurement report presence in the UE.","paragraph_zero_based":640},{"literal_text_all_w_t_and_m_t":"5.4.1RRC_CONNECTED","paragraph_zero_based":641},{"literal_text_all_w_t_and_m_t":"In RRC_CONNECTED state UE supports Immediate MDT as described in 5.1.2. In order to support Immediate MDT, the existing RRC measurement configuration and reporting procedures apply. Some extensions are used to carry location information.","paragraph_zero_based":642},{"literal_text_all_w_t_and_m_t":"5.4.1.1Measurements and reporting triggers for Immediate MDT","paragraph_zero_based":643},{"literal_text_all_w_t_and_m_t":"Measurements to be performed for Immediate MDT purposes involve reporting triggers and criteria utilized for RRM. In addition, there are associated network performance measurements performed in the gNB.","paragraph_zero_based":644},{"literal_text_all_w_t_and_m_t":"In particular, the following measurements may be supported for Immediate MDT performance:","paragraph_zero_based":645},{"literal_text_all_w_t_and_m_t":"Measurements:","paragraph_zero_based":646},{"literal_text_all_w_t_and_m_t":"⁻M1: DL signal quantities measurement results for the serving cell and for intra-frequency/Inter-frequency/inter-RAT neighbour cells, including cell/beam level measurement for NR cells only, TS 38.215 [19].","paragraph_zero_based":647}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"0254bea9b44234fd4ae3ce61d1b7572c9739a2f3f98aac5d753159622ecf9743","original_member_sha256":"89d3a65a890ec1c34665df3994d13674a43f65265801792df8571bdbaed4c1df","paragraph_ElementTree_utf8_XML_sha256":["88126553bdbec3a5f45597449dbe4bcbaa5fa8a313f2f3cb04159d37cd5e340a","a5bb2c130bdc94c6d5dfb768f3152c092a00f2b7ec3307d66dec51fbbba1177d","47d8bde954918f81d0cabacaf2019c4223cbfb48fa5dc3f8c08212477b2f5d2b","328042824904dc2e94d538f0930809fa87ad6173838c7bb1d09da9bf4740f578","fc447a88e292cdc3f4f1440a17fdaebac26b1b9ae0187e3b7770db6bc230c12d","fed0bbbc5ce3eee82f91859f6ce4a1e63153400ea5b7f98c9a7b14b6711f7d76","f2fcab908d6ab78d326d94aa46c90c73b5dfd157050ff7b4567cae4f324fd6d6","79531b071e556a1a018f330a43e635db5102207c3ff8e2361d0fda953600788f","0f20f61050774e6ca55f93e184599fdaff36cb2e3414aee14fd73687eec874c6","beab1012cc66bde1f92fcfacd04c456f605852a0d1d8db7faaa9341d96a7023b","205e616cdd92afeeebb2a11de0d9ef2663530b86790f4063dbae18a22ed2487d","9a786574554d8863c0f5230ff7fdf5baeac528bd90357e687778496ae6c59d3c","bab525b1b29a3562fdeea95db1cb10e4033e72eed2a7abb7c2f8bd5931d8b4fa","0afd60a2edc3d2ae2717687604a0c776b3899a03a60258e3b8f5bc159b75b9dd","77a7b1439827e56d483fd9902540a7919e75c290f3365fffbaee81cddd32ca2f","6be18260e0718047329878908a7d746ad71c17e741c47989dfd9c270adf894c8","99ca91ed799602735a7e0f28b96a242067c8de84098cd394b521b193bc0f55fc","d5974ef96fb00f9370fdbb6145ac9e2ea65165ed283560b0245306eea9535741","daaa2065c3d1d710c62f6d5a7fd464c362d237e7df2b78ccf08f8662ed0259c6","306085e880a18a0719b3cb78dcf2f9605a23f3f3aa4ec0804cdf997250a9e925","4e9a388b9bb82072ddc9e29684012029f3e8934d93b62bfa234bbe6eba714b6e","b841d0d6e45dda9c100b1387e05406c12b7c03552fdccea543a54060667a1a58","ce5c7546599e3a6d6730d64262dd103c2a8030ba464f4ceda464d76bfdc744d4","3d24d3ff38c3f5bbf72e0841b4de8acdfc6f99060024240e471226ed575b4c46"],"paragraph_range_zero_based":[624,647],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx:p624"}
{"fields":{"filename":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"⁻M2: Power Headroom measurement by UE, TS 38.213 [20].","paragraph_zero_based":648},{"literal_text_all_w_t_and_m_t":"⁻M3: Void.","paragraph_zero_based":649},{"literal_text_all_w_t_and_m_t":"⁻M4: PDCP SDU Data Volume measurement separately for DL and UL, per DRB per UE, see TS 28.558 [23].","paragraph_zero_based":650},{"literal_text_all_w_t_and_m_t":"⁻M5: Average UE throughput measurement separately for DL and UL, per DRB per UE and per UE for the DL, per DRB per UE and per UE for the UL, by gNB, see TS 28.558 [23].","paragraph_zero_based":651},{"literal_text_all_w_t_and_m_t":"⁻M6: Packet Delay measurement separately for DL and UL, per DRB per UE, TS 28.558 [23] and TS 38.314 [18].","paragraph_zero_based":652},{"literal_text_all_w_t_and_m_t":"NOTE 0:UL PDCP Excess Packet Delay measurement can be configured with a threshold as specified in TS 38.331 [15]. If the UE does not detect any UL PDCP delay based on the delay threshold and delay report interval configured by the network, the UE does not report any UL PDCP delay measurement within that period.","paragraph_zero_based":653},{"literal_text_all_w_t_and_m_t":"⁻M7: Packet loss rate measurement separately for DL and UL, per DRB per UE, TS 28.558 [23] and TS 38.314 [18].","paragraph_zero_based":654},{"literal_text_all_w_t_and_m_t":"⁻M8: RSSI measurement by UE (for WLAN/Bluetooth measurement) see TS 38.331 [15].","paragraph_zero_based":655},{"literal_text_all_w_t_and_m_t":"⁻M9: RTT Measurement by UE (for WLAN measurement) see TS 38.331 [15].","paragraph_zero_based":656},{"literal_text_all_w_t_and_m_t":"NOTE 1:Void","paragraph_zero_based":657},{"literal_text_all_w_t_and_m_t":"NOTE 1a:M5 ~ M7 can apply to MR-DC and EN-DC SN terminated MCG/split bearers and MN terminated SCG/split bearers.","paragraph_zero_based":658},{"literal_text_all_w_t_and_m_t":"Measurement collection triggers:","paragraph_zero_based":659},{"literal_text_all_w_t_and_m_t":"-For M1:","paragraph_zero_based":660},{"literal_text_all_w_t_and_m_t":"-Event-triggered measurement reports according to existing RRM configuration for events A1, A2, A3, A4, A5, A6, B1 or B2.","paragraph_zero_based":661},{"literal_text_all_w_t_and_m_t":"-Periodic, A2 event-triggered, or A2 event triggered periodic measurement report according to MDT specific measurement configuration.","paragraph_zero_based":662},{"literal_text_all_w_t_and_m_t":"-For M2:","paragraph_zero_based":663},{"literal_text_all_w_t_and_m_t":"-Reception of Power Headroom Report (PHR) according to existing RRM configuration.","paragraph_zero_based":664},{"literal_text_all_w_t_and_m_t":"NOTE 2:PHR is carried by MAC signalling. Thus, the existing mechanism of PHR transmission applies, see TS 38.321 [21].","paragraph_zero_based":665},{"literal_text_all_w_t_and_m_t":"-For M3:","paragraph_zero_based":666},{"literal_text_all_w_t_and_m_t":"-Void.","paragraph_zero_based":667},{"literal_text_all_w_t_and_m_t":"-For M4:","paragraph_zero_based":668},{"literal_text_all_w_t_and_m_t":"-End of measurement collection period.","paragraph_zero_based":669},{"literal_text_all_w_t_and_m_t":"-For M5:","paragraph_zero_based":670},{"literal_text_all_w_t_and_m_t":"-End of measurement collection period.","paragraph_zero_based":671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"0254bea9b44234fd4ae3ce61d1b7572c9739a2f3f98aac5d753159622ecf9743","original_member_sha256":"89d3a65a890ec1c34665df3994d13674a43f65265801792df8571bdbaed4c1df","paragraph_ElementTree_utf8_XML_sha256":["b66dede087b3174a63328dda39bd12e70067df8c0c14be65055179cc775b64ae","4719f176880e7244499a176abb6fbea95e96bf53497cb0c19444f3df61e08719","1b4a7d7a6dd18bf2303f0df70007db46dbf9e2b1a90c617ed00f35c5120315bd","621efd689e6f9b5b0221df50856a79935ae3cc47583ac6eb8d285b762f9158ca","28e3e608458ca59263b6885aa6cecb146e78d1b2a660beeb59f02a4acc182e4d","dc1eaad7794d6c9801fee3f6c6d63bf6ee9bf869caf5f816a52f23a25aeca812","98ff216b7dd4881de792d901fa61c2935059dbafce763bac06e935d247d3935e","137d9bd3984559b034e12bdc970eff659aa17e880822b12f300c1d2ec5c16105","61879ab41aa569e4dd7a7fe8c570dd8af7842bff8b312b14acd97b881a0dc608","7dd1d7d03ef92b870d38424f3b2010128258078ca5445b8c3f5645a6fea3deb5","d7d9021f277f4624859e15e027144400a34251ce0239c497c672d84c9c7f40d6","0ebf675df70fe1805d426bfb8cfd767316c32406883cae6ef7eba095573c6adb","c730e6600ea7c1a425538a34bbe9dbfc7183ea717c49eef61d8d0c12d5acbbcb","c8e01bdaeb9e47bfbcc7960a744512b76e5b1a288027a2545c58a2c0b2827e4a","d10f25d408095e6af7dda806465c975f16a82944462f8ad9779aead3bfb8104d","5dee72e0c6c6b5d629d3f66b64ce3fd6c78e7414d513282f62f9cc63cd971512","810f485693a202dfafd44767b534f18ff3783c7038a10feb8078171143214654","81b1bdc6b0b89dd9bbfd5b9491b7f954bd48f6e0e75387433402a790a9388b8e","8856c1848a20007ac1d4151830a050a77adb4872faa8b16860e904df09ffd873","36bc628c611dd5e22872aaa2a48b2c713c0a116d48cf94e9dfbce03a6cfd6e2b","90a18af1cd6a12b1640aebd0ddf38f21cad71aff2f4b5f689ec1bf0678e29419","34800cb11931a9bb1616f6fbd2142075f8d7bdb6af07d3f23e9bec02851718d9","4054455ec6cc6c2fa544205886c9462feadd15ce7bcfec8d25150580445ffddb","0bc365abdecaa632f2c4eda0d7b6d2298b5266519e01e60d1c35033049edf34a"],"paragraph_range_zero_based":[648,671],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx:p648"}
{"fields":{"filename":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"NOTE 3:If transmission of a data burst is ongoing at the boundary of the measurement collection period, T1 and T2 in throughput evaluations are set to the end and the start of the measurement period, respectively.","paragraph_zero_based":672},{"literal_text_all_w_t_and_m_t":"-For M6:","paragraph_zero_based":673},{"literal_text_all_w_t_and_m_t":"-End of measurement collection period.","paragraph_zero_based":674},{"literal_text_all_w_t_and_m_t":"-For M7:","paragraph_zero_based":675},{"literal_text_all_w_t_and_m_t":"-End of measurement collection period.","paragraph_zero_based":676},{"literal_text_all_w_t_and_m_t":"-For M8:","paragraph_zero_based":677},{"literal_text_all_w_t_and_m_t":"-Associated to M1 and/or M6 related measurement reporting triggers.","paragraph_zero_based":678},{"literal_text_all_w_t_and_m_t":"-For M9:","paragraph_zero_based":679},{"literal_text_all_w_t_and_m_t":"-Associated to M1 and/or M6 related UE measurement reporting triggers.","paragraph_zero_based":680},{"literal_text_all_w_t_and_m_t":"5.4.1.2Radio Link Failure report","paragraph_zero_based":681},{"literal_text_all_w_t_and_m_t":"The Radio Link Failure report contains information related to the latest connection failure experienced by the UE. The connection failure can be Radio Link Failure (RLF), or Handover Failure (HOF). The contents of the RLF report and the procedure for retrieving it by a gNB are specified in TS 38.331 [15], including failure information related to CHO, or DAPS Handover Failure (DAPS HOF). In case of consecutive connection failures associated to CHO or DAPS, the UE stores and reports both failure related information in the RLF report.","paragraph_zero_based":682},{"literal_text_all_w_t_and_m_t":"RLF report can contain latest two consecutive failures in case one or both failures are related to CHO. In case of consecutive failures, the UE stores and reports both failure related information in the RLF report. The consecutive failure scenarios concern the following sequence of events:","paragraph_zero_based":683},{"literal_text_all_w_t_and_m_t":"a.A UE that has CHO configuration (as specified in TS 38.331 [15]) detects RLF in the source cell. The UE selects a configured candidate CHO target cell for CHO recovery via re-establishment procedure. The UE fails to re-establish to the selected CHO candidate cell when performing conditional reconfiguration.","paragraph_zero_based":684},{"literal_text_all_w_t_and_m_t":"b.A UE that has CHO configuration, executes the CHO towards the target cell upon fulfilling the configured condition and experiences a HO failure. The UE selects a configured candidate CHO target cell for CHO recovery via re-establishment procedure. The UE fails to re-establish to the selected CHO candidate cell when performing conditional reconfiguration.","paragraph_zero_based":685},{"literal_text_all_w_t_and_m_t":"c.A UE that has CHO configuration executes the normal HO towards the target cell and experiences a HO failure. The UE selects a configured candidate CHO target cell for CHO recovery via re-establishment procedure. The UE fails to re-establish to the selected CHO candidate cell when performing conditional reconfiguration.","paragraph_zero_based":686},{"literal_text_all_w_t_and_m_t":"For DAPS, two consecutive failure information concern the following scenarios:","paragraph_zero_based":687},{"literal_text_all_w_t_and_m_t":"a.A UE detects a connection failure at the source (RLF) while performing access to DAPS target cell and fails to access the target (HOF).","paragraph_zero_based":688},{"literal_text_all_w_t_and_m_t":"b.A UE detects a connection failure at the target cell (HOF) and fails to perform fallback (RLF at source).","paragraph_zero_based":689},{"literal_text_all_w_t_and_m_t":"In addition, for RACH Optimization solutions, NR RLF report may include part of the RACH report with:","paragraph_zero_based":690},{"literal_text_all_w_t_and_m_t":"-preamble configuration and indications specific to features (e.g. RedCap, Small Data Transmission or Slicing) or their combinations, associated to the RA procedure, as specified in TS 38.331 [15].","paragraph_zero_based":691},{"literal_text_all_w_t_and_m_t":"-additional information required for Self-Optimisation solutions, as specified in TS 38.300 [22].","paragraph_zero_based":692},{"literal_text_all_w_t_and_m_t":"NR RLF report content required for MDT includes:","paragraph_zero_based":693},{"literal_text_all_w_t_and_m_t":"-Latest radio measurement results of the serving and neighbouring cells, including SSB/CSI-RS index and associated measurements in the serving and neighbouring cells;","paragraph_zero_based":694},{"literal_text_all_w_t_and_m_t":"NOTE:The measure quantities are sorted through the same RS type depending on the availability, according to the following priority: RSRP, RSRQ, SINR.","paragraph_zero_based":695}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"0254bea9b44234fd4ae3ce61d1b7572c9739a2f3f98aac5d753159622ecf9743","original_member_sha256":"89d3a65a890ec1c34665df3994d13674a43f65265801792df8571bdbaed4c1df","paragraph_ElementTree_utf8_XML_sha256":["07bfda1980442b284c2ceecf2d29d1318b0ee258ea3ddd5af2772956d919b5c9","2a4c9d7dc095dcc19590711091d75a45b028438166b22c98a51f9653a1c539b0","f265b48edb8ec6237c95e4cfab80f156e56b4bdf81d1dc902bcbed2c2a21867d","0ceabd3152c946ffe4982f6f09aaf82e82a2f47665a9f1ce03caadcacc696dea","8c36c5eb0b4a834f3ab6b0f7a75d32122b442107834c3e2c97c9b5aa19bc398f","49fcc4a8c6e3534ada57e7194b9fbb2e3e2b681b80f4c1f442031929b059c10f","336592767e1e5014956e1744255ec371e69afb890610fe924efbd0d2c809f527","6ebe1857af0d3a88eafa53a7dec8c95867f0b506cc742951b4f609ad67ae8d48","a6b209d463faf89e1c95b12c98e6b599f39c323e10945fafa7ee30c3194f56df","f209f60463e44eec947be5dce3449a5b08c38c11813a07b453237590b8a0ce35","b6cb354323f9298c3b378986cce51d1ad927330f4f002f676573f9cf56559241","51c2f4ad1ac53e9c01bce14ba89f2714f28125719bd73a25a9409999632f55a2","5584a29b3aa392ca7b04c6a076e48631098e8a12520acfc24cf2c9170746b4f2","210d6505bbd435738e3c6467191f0a9b4fddc284640ae276ce72e38bc1e0417c","de2fc2a99e7e04d057c8a0e4c4e5e799987503858b7e09ec1092c8c9b7d2cbc2","186ff1955b58a9e8e120aa25fd5e2d77cfccd92bc856b10c99031ee42329e44f","45ef036b8e0f128df9234171378e68afef2cf7f881ae945448793ac616e1fa8d","1969de5920a86c292ccb63218f8fc05e716385a6eae6e8a696a389059e578c8d","cc48f91328d4d86fc47e1b017041626cb1cc325a63d4ced6e50aa219b28126d2","e6848f29384a9ca6706122303f35f29f9ac2f1e3d9b507ae5e9c47056fc232a0","c8b6ded076cc6a0bd5f3f8eb9abb24d2fdf89fb683fd65e6cdf41fa7ccb2f3bd","0ce3fb64686557f672cb7392a4f7cac0f812c1eb94fd241d8ca51d4af79499b9","90baa1cca33eeb9e3b77f56270b75c058939f3258607b09033902605411d012f","f4c23549242eb213d18f3c3b58d2c3cff2d9af8cf8bae92cfd658ed4ba339799"],"paragraph_range_zero_based":[672,695],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx:p672"}
{"fields":{"filename":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-For CHO, UE includes the latest radio measurement results of the candidate target cells;","paragraph_zero_based":696},{"literal_text_all_w_t_and_m_t":"-WLAN and Bluetooth measurement results, if were configured prior RLF and are available for reporting;","paragraph_zero_based":697},{"literal_text_all_w_t_and_m_t":"-\"No suitable cell is found\" flag when T311 expires;","paragraph_zero_based":698},{"literal_text_all_w_t_and_m_t":"-Indication per SSB/CSI-RS beams reporting whether it is configured to RLM purpose;","paragraph_zero_based":699},{"literal_text_all_w_t_and_m_t":"-Available sensor information;","paragraph_zero_based":700},{"literal_text_all_w_t_and_m_t":"-Available detailed location information;","paragraph_zero_based":701},{"literal_text_all_w_t_and_m_t":"-RACH failure report (in case, the cause for RLF is random access problem or Beam Failure Recovery failure):","paragraph_zero_based":702},{"literal_text_all_w_t_and_m_t":"-Tried SSB/CSI-RS index and number of Random Access Preambles transmitted for each tried SSB/CSI-RS in chronological order of attempts;","paragraph_zero_based":703},{"literal_text_all_w_t_and_m_t":"-Contention detected as per RACH attempt;","paragraph_zero_based":704},{"literal_text_all_w_t_and_m_t":"-Indication whether the selected SSB is above or below the rsrp-ThresholdSSB threshold, as per RACH attempt;","paragraph_zero_based":705},{"literal_text_all_w_t_and_m_t":"-TAC of the cell in which the UE performs the RA procedure;","paragraph_zero_based":706},{"literal_text_all_w_t_and_m_t":"-Frequency location related information of the RA resources used by the UE as specified in TS 38.331 [15];","paragraph_zero_based":707},{"literal_text_all_w_t_and_m_t":"-For 2-step RA, the following information can be additionally included:","paragraph_zero_based":708},{"literal_text_all_w_t_and_m_t":"-The measured RSRP of DL pathloss reference obtained just before performing RACH procedure (per RA procedure);","paragraph_zero_based":709},{"literal_text_all_w_t_and_m_t":"-Indication that fallback from 2-step RA to 4-step RA was performed by the UE, as per RACH attempt;","paragraph_zero_based":710},{"literal_text_all_w_t_and_m_t":"-Indication of RA switching point (as defined by the field msgA-TransMax in TS 38.331 [15]);","paragraph_zero_based":711},{"literal_text_all_w_t_and_m_t":"-The payload size available in the UE buffer at the time of initiating the 2-step RA procedure, without considering the padding (per RA procedure);","paragraph_zero_based":712},{"literal_text_all_w_t_and_m_t":"-MSGA PUSCH resources for 2-step RACH as specified in TS 38.331 [15] can be included in case the UE uses random access resources configured with CFRA.","paragraph_zero_based":713},{"literal_text_all_w_t_and_m_t":"If detailed location information (e.g. GNSS location information) is available the reported location information in rlf-Report consists of:","paragraph_zero_based":714},{"literal_text_all_w_t_and_m_t":"-Latitude, longitude (mandatory);","paragraph_zero_based":715},{"literal_text_all_w_t_and_m_t":"-Altitude (conditional on availability);","paragraph_zero_based":716},{"literal_text_all_w_t_and_m_t":"-Velocity (conditional on availability);","paragraph_zero_based":717},{"literal_text_all_w_t_and_m_t":"-Uncertainty (conditional on availability);","paragraph_zero_based":718},{"literal_text_all_w_t_and_m_t":"-Confidence (conditional on availability);","paragraph_zero_based":719}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"0254bea9b44234fd4ae3ce61d1b7572c9739a2f3f98aac5d753159622ecf9743","original_member_sha256":"89d3a65a890ec1c34665df3994d13674a43f65265801792df8571bdbaed4c1df","paragraph_ElementTree_utf8_XML_sha256":["57b6e8750fa884eb76788f0dc0531e821b8be4e223fdba90152f5b409306f888","e702e71cb824e07f9e706c8de13b95589f0bb459be97e03b1b6c38eebd9f4012","40c434c118bbf545afe75586f4f918f6b8e1b0e52de8e18c54e426d1a9cae0fc","06473081e9c51fbbab97a5467f0d33360939d6419ec513fec7639dfbeaa76624","ae4a91d1ce14b20b81e0315e9da481487d64c8cf740dd4037859dbbda9040c78","e80e2a621485bfc621031b37defe5ec3e278227bdc7442deb7dfb0fc8ecced6b","658eef8225e1474df05b0ae13e13fe448e11172f77b018a3a68a41885afa88ae","405e49ae06ac1f53eadca85e5b7df2c3ec320c60c8d3325b0823365f5819a54c","e606b7b1e98fd49bd77e220e2c9470f78ca2fe2039a951534f24ae577d533b4c","bcf8bc3017eec4b42fd599265392d9a5d1e64ac81aa651559e8b5f9605b0fcec","e61df64991541d9a63ea8b0775b69973eb952c6962e18636fd6ec5cc902936ff","f11c12bd1f906d67ab63d6d531fcb9769b172cdabab606820d30054c6a6c775d","0ed9cad8917528394a84f975b0cbd5bf7a11eb4d6bed4daa035e377b43f48ce4","0d3d2ca84db4eef28715025029428a4813329a22b8f48d3afe8897a214d406ae","10eafb88a12e1c58c1bb58954a8d818d1631cb477dfd7590a32401d465052135","64c7a56d8258adb2b364ca92e7f508990704a772b2e0b7d6d7eb8e8e0ef45aad","ca6778a499fa77d665f4f0abfd7a1064f56185d81fd9af327cdd3fe7ff03911b","7cf7747fb634cc41a8736a9ee09e702c15703cd3500dfdebbdc8126a335b1191","decbc8c6523e715f91acdbb9d1fbdc136bc3f1c06ec0a4131dca734643aa58cb","ebbc7d8344d5283bd5b1676849e23638727a84a9eb7321776ef846a67bb4873d","c132f3cb05a563df389e0454f2de24c6ee8f2499e9713ed042ad0dbd9c9e8d09","4b27521164d45ae6531d1af7b855f6de13c09136f38840cdd9b9a4c81f97be39","b18d9c1f5a725bf2cd674409522802eb0cf019401720e3944b5809d1628598b9","314dc50d4c89a1621b0ff0169a70059f2373b62455ae9efe44d5dcba4c4dc7b3"],"paragraph_range_zero_based":[696,719],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx:p696"}
{"fields":{"filename":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-Direction (conditional on availability).","paragraph_zero_based":720},{"literal_text_all_w_t_and_m_t":"If sensor information is available, the sensor information may convey uncompensated barometric pressure, UE speed, and UE orientation.","paragraph_zero_based":721},{"literal_text_all_w_t_and_m_t":"In addition, the RLF report may include additional information required for MRO solutions, as specified in TS 38.300 [22].","paragraph_zero_based":722},{"literal_text_all_w_t_and_m_t":"5.4.1.3Immediate MDT for MR-DC","paragraph_zero_based":723},{"literal_text_all_w_t_and_m_t":"Immediate MDT is supported for (NG)EN-DC, NE-DC and NR-DC scenario. Signalling based immediate MDT is triggered for both MN and SN as default, if the MN only indication is provided by OAM, the MDT configuration applies to MN only.","paragraph_zero_based":724},{"literal_text_all_w_t_and_m_t":"In signalling based immediate MDT, MME provides MDT configuration for both MN and SN towards MN including multi RAT SN configuration, specifically E-UTRA and NR MDT configuration. MN then forwards the NR MDT configuration towards SN (EN-DC scenario, SN is always NR).","paragraph_zero_based":725},{"literal_text_all_w_t_and_m_t":"In management-based immediate MDT, OAM provides the MDT configuration to both MN and SN independently. For both MN and SN, Management based MDT should not overwrite signalling based MDT.","paragraph_zero_based":726},{"literal_text_all_w_t_and_m_t":"For immediate MDT configuration, MN and SN can independently configure and receive measurement from the UE.","paragraph_zero_based":727},{"literal_text_all_w_t_and_m_t":"For MN terminated SCG bearer and SN terminated MCG bearer, the terminated node, e.g., MN in case of MN terminated SCG bearer, configures the configuration to UE.","paragraph_zero_based":728},{"literal_text_all_w_t_and_m_t":"For configuring UL PDCP packet average delay (as specified in clause 4.3.1.1 in TS 38.314 [18]) in case of split bearer: only the terminated node of the split bearer can configure the measurement to UE, and the UE reports the measurement result to corresponding node where the configuration was received from.","paragraph_zero_based":729},{"literal_text_all_w_t_and_m_t":"5.4.1.4Detailed Location Information","paragraph_zero_based":730},{"literal_text_all_w_t_and_m_t":"The M1 measurements are tagged by the UE with location data in the following manner:","paragraph_zero_based":731},{"literal_text_all_w_t_and_m_t":"-Detailed location information (e.g. GNSS location information) is included if available in the UE when the measurement was taken. If detailed location information is available, the reporting consists of information as specified in TS 38.331 [15].","paragraph_zero_based":732},{"literal_text_all_w_t_and_m_t":"5.4.1.5Support of network-side data collection","paragraph_zero_based":733},{"literal_text_all_w_t_and_m_t":"For beam prediction, the management based immediate MDT with logging of UE radio measurements can be used for data collection. As specified in TS 38.300 [22], the measurement framework is applied between UE and NG-RAN. Measurement reports include (see TS 38.331 [15]):","paragraph_zero_based":734},{"literal_text_all_w_t_and_m_t":"⁻Cell identity: CGI or PCI of the cell to which the measurement results are related to.","paragraph_zero_based":735},{"literal_text_all_w_t_and_m_t":"⁻Logged L1 radio measurement results: include the beam identifiers associated with CSI-RS resources or SSBs (CSI-RS indexes or SSB indexes) and the corresponding measured L1-RSRPs.","paragraph_zero_based":736},{"literal_text_all_w_t_and_m_t":"-Presence of a gap that is longer than the configured logging periodicity in the logged measurements.","paragraph_zero_based":737},{"literal_text_all_w_t_and_m_t":"For a UE in NR-DC, the configuration and reporting for data collection can only be performed via the MN, and SN is excluded from the configuration and reporting for data collection.","paragraph_zero_based":738},{"literal_text_all_w_t_and_m_t":"5.4.2RRC_IDLE & RRC_INACTIVE","paragraph_zero_based":739},{"literal_text_all_w_t_and_m_t":"5.4.2.1General","paragraph_zero_based":740},{"literal_text_all_w_t_and_m_t":"For UE in RRC_IDLE and RRC_INACTIVE states Logged MDT procedures as described in 5.1.1 apply.","paragraph_zero_based":741},{"literal_text_all_w_t_and_m_t":"For Logged MDT measurement collection for RRC INACTIVE UEs, the actual process of logging within the UE, takes place in RRC INACTIVE state and may be continued in RRC IDLE state; or vice versa.","paragraph_zero_based":742},{"literal_text_all_w_t_and_m_t":"The logged measurement stored in UE during RRC INACTIVE and RRC IDLE state are kept for a given common period before they are deleted as in LTE MDT.","paragraph_zero_based":743}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"0254bea9b44234fd4ae3ce61d1b7572c9739a2f3f98aac5d753159622ecf9743","original_member_sha256":"89d3a65a890ec1c34665df3994d13674a43f65265801792df8571bdbaed4c1df","paragraph_ElementTree_utf8_XML_sha256":["cce7bc059246079670bfab77ff835ee07ec1107c9a69ebd9904ee31f1c955f13","3ad305b1b2bd3474030629a15822e2fd8757561a7d56c1e706a49788d228cb78","e76bc4ec22e77dce968f186fc314bd7fc43ca9e8a60e644cd66cad826b7aad5c","b6a13cc5ab6118482afeb70506fe2a8157f5d4574bee2545092900c427c1f042","5ab9902219f3d3e04aea74c5ae9a7dbc560f70e64096299064550f555def518a","c1db988b0279d3abbfafe6fce54b49e45f57055000364cb59ca1fc5b3b359890","362fdbea2dbe4fcb430cdaac57c24262b6c5e23211bead658be4e98ad59e3a08","54d9759aa7f9bf495b16ffa0e8b9b2b768c516c5968f6480d6054168931ce4ea","2a79452b280d086d2b0bc1f0d3d457642a7a16920fdb9412d2c1f90e64ca784f","22766f89f952590844d1acc01e3bc20b1779613d58c103c0a47e65f96e408885","538c892821a26173ba862a217954ae9b58f36e89133ee04618b84f758e73ba30","72d6bee73a691b5a6227cea35fc0d715e26c8cff94608a276fd9d6b69c582913","bc127e396afe1d49f633d97711264f65b0259a57afb00fcb580609e5cd33ba7d","8db1083fa2e093ec5d0216f9d22eefc4113d625d61b063e5a577f2e650d22de6","45263e34d26f49956b4e8fb033242af4268e34560e7554bed712d3071d026dc0","f3db909d9b72d31b1e4b065cfff7f8e99ef5f0ce350339ebd11c4cba5c95d7cd","10d9d240ea833572d1327424d2b1eeaae0c9ff9426c874c0d06898912a33b459","5da0943a9d7e62a3776fa31814702779e89e584910773e06119c415c2a746403","c65cb5121f73e89da31a0f53ba896a4ba840d14bfeb89e2ab636dbe63d258b9b","3e2f3c6e1cea9ffff3c39afb5d8bf82e9c20dd1ae898c9a23273237db89905ec","bb9385587a209b3f1819a88d740881bd67cd291a566b08b327e5e885240f1ca2","bf2853a88fc279fd0321800c2959a80cfa3524d205b9c23ed7aeb93cf1480e16","c9e0c98e6cb160434859fa2b8a0e1b6099660121a089a406ae0f532fb0b44181","4bef8aca37dcb1634eec7632f56423224c8a84a933e7e71057eb54254950db92"],"paragraph_range_zero_based":[720,743],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx:p720"}
{"fields":{"filename":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"If the signalling based logged or immediate MDT configuration received by the NG-RAN when UE is in RRC_INACTIVE:","paragraph_zero_based":744},{"literal_text_all_w_t_and_m_t":"-The NG-RAN stores the MDT configuration in the UE context;","paragraph_zero_based":745},{"literal_text_all_w_t_and_m_t":"-When the UE resumes the RRC connection in the last serving NG-RAN, the NG-RAN can configure the MDT configuration for the UE;","paragraph_zero_based":746},{"literal_text_all_w_t_and_m_t":"-When the UE resumes the RRC connection in one new NG-RAN, the new NG-RAN can configure the MDT configuration for the UE, only if the signalling based logged MDT was received by the new NG-RAN from the previous NG-RAN or AMF.","paragraph_zero_based":747},{"literal_text_all_w_t_and_m_t":"If the management based MDT configuration is received by the NG-RAN when UE is in RRC_INACTIVE,","paragraph_zero_based":748},{"literal_text_all_w_t_and_m_t":"-No requirement for the NG-RAN to store the MDT configuration in the UE context;","paragraph_zero_based":749},{"literal_text_all_w_t_and_m_t":"-When the UE resumes the RRC connection in the last serving NG-RAN, the NG-RAN can configure the MDT configuration for the UE;","paragraph_zero_based":750},{"literal_text_all_w_t_and_m_t":"-When the UE resumes the RRC connection in another NG-RAN, the source NG-RAN will not propagate the management based MDT configuration. The source NG-RAN should inform the target NG-RAN of UE consents.","paragraph_zero_based":751},{"literal_text_all_w_t_and_m_t":"Logged MDT measurements are sent on Signalling Radio Bearer SRB2 in RRC_CONNECTED state.","paragraph_zero_based":752},{"literal_text_all_w_t_and_m_t":"5.4.2.2Logging of on-demand SI request related information","paragraph_zero_based":753},{"literal_text_all_w_t_and_m_t":"For NR, following on-demand SI request related information are logged for both Msg1-based and Msg3-based SI request:","paragraph_zero_based":754},{"literal_text_all_w_t_and_m_t":"-The SIB(s) that UE actually intends to request;","paragraph_zero_based":755},{"literal_text_all_w_t_and_m_t":"-The beam identifiers used to acquire the on-demand SI;","paragraph_zero_based":756},{"literal_text_all_w_t_and_m_t":"-One specific raPurpose for MSG3 based on demand SI request;","paragraph_zero_based":757},{"literal_text_all_w_t_and_m_t":"-An indication whether on-demand SI acquisition was successful or not.","paragraph_zero_based":758},{"literal_text_all_w_t_and_m_t":"5.4.3Support of NPN","paragraph_zero_based":759},{"literal_text_all_w_t_and_m_t":"MDT is supported in PNI-NPN and SNPN.","paragraph_zero_based":760},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":761}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"0254bea9b44234fd4ae3ce61d1b7572c9739a2f3f98aac5d753159622ecf9743","original_member_sha256":"89d3a65a890ec1c34665df3994d13674a43f65265801792df8571bdbaed4c1df","paragraph_ElementTree_utf8_XML_sha256":["46438b32557b5fe354df223fc727ec76f4be925cb33f0845352d3a782c88ebb1","8b7e1e84a973cc7c80166360816f7442ef8374906a7e0ba1d059934c9a1629ee","793e5e7315135ec52d3836596fc92955fc247e561195e168e17f8e475c15f7ee","2ea6438ec6c9f8113d702153e33ff56b1c530a48a299945fc20b70500ff9d1b4","0cef05cf9c315dd23f13c7e9ab3bec33624a0c79ec0cd7ffd62bebf923844490","76289ca0f619865acc83bf73b40504cf2456d1ad3c8221ef9936de8231460e70","8c775248968450dce98b25ecb796d163788f38bf441dab8e0a283beaca561c32","3e85652769e5c05c7da08cf2190b9601b74e79afa6ca996996d7dae8bcfc5ac2","f5d54830e3a33cd614807a5850418225681266a91710624fa440c4ee4efef0b7","b838bb04970dfc06ab4889b55d2b99f64253e41b2e776733e373a4e4d6593430","142ad8757fa6d793e44d9597cbbc301b00a6289eb3de1d88d75b0fd36edc2fc4","d0d0b6c9c399a40633990370a9b07e521501289db454559d6c75633a06f61ee9","a647797448d90434301d19e6fa72aa0b1ac02e8f8d0e7250cc768b39de8e9d1f","46dbac22c26331b4e8c36032acdfbbd1478045513c692e0e2e3e4b808f230777","b47596081a9e0d79fec981a1b07516097d54f0b4d15b2c4e0b5e61aa65ff40e2","392be6ad25758af9ef3d95587b70008492bfcd745370b69a5984489035712919","edcde20591335b68a9d651831e5cb6a3be8ccd18c1ea516ff0804c282029f41d","ceac7e2cd92b8cd27db75e06772a4019eaf2300bd4df47b1f3ca3f7f80ace709"],"paragraph_range_zero_based":[744,761],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507420.zip::R2-2507420 Correction on AI for Air Interface Feature in TS 37320.docx:p744"}
