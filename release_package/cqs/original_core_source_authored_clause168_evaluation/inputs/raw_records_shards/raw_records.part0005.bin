{"fields":{"filename":"R2-2507330.zip::R2-2507330 Correction on NCD-SSB Configuration for Positioning(R19).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"            periodicityAndOffset-p-r18          SRS-PeriodicityAndOffset-r16                               OPTIONAL,   -- Need R","paragraph_zero_based":552},{"literal_text_all_w_t_and_m_t":"            periodicityAndOffset-p-Ext-r18      SRS-PeriodicityAndOffsetExt-r16                            OPTIONAL,   -- Need R","paragraph_zero_based":553},{"literal_text_all_w_t_and_m_t":"            startPosition-r18                   INTEGER (0..13)                                            OPTIONAL,   -- Need S","paragraph_zero_based":554},{"literal_text_all_w_t_and_m_t":"            ...","paragraph_zero_based":555},{"literal_text_all_w_t_and_m_t":"          },","paragraph_zero_based":556},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":557},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":558},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":559},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":560},{"literal_text_all_w_t_and_m_t":"-- TAG-SRS-CONFIG-STOP","paragraph_zero_based":561},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":562},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":563},{"literal_text_all_w_t_and_m_t":"End of the second change ","paragraph_zero_based":564},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":565},{"literal_text_all_w_t_and_m_t":"Start of the third change ","paragraph_zero_based":566},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":567},{"literal_text_all_w_t_and_m_t":"SSB-Configuration field descriptions","paragraph_zero_based":568},{"literal_text_all_w_t_and_m_t":"halfFrameIndex","paragraph_zero_based":569},{"literal_text_all_w_t_and_m_t":"Indicates whether SSB is in the first half or the second half of the frame. Value zero indicates the first half and value 1 indicates the second half.","paragraph_zero_based":570},{"literal_text_all_w_t_and_m_t":"integerSubframeOffset","paragraph_zero_based":571},{"literal_text_all_w_t_and_m_t":"Indicates the subframe boundary offset of the cell in which SSB is transmited.","paragraph_zero_based":572},{"literal_text_all_w_t_and_m_t":"sfn0-Offset","paragraph_zero_based":573},{"literal_text_all_w_t_and_m_t":"Indiactes the time offset of the SFN0 slot 0 for the cell with respect to SFN0 slot 0 of serving cell.","paragraph_zero_based":574},{"literal_text_all_w_t_and_m_t":"sfn-Offset","paragraph_zero_based":575}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"6cf447ef83b3f28feadf4e8931d67c8cc1945c8cb922ae1af4aa83e358ac5897","original_member_sha256":"7a8210a9532f1161cc445693b9ebba29d25fff533bd090e41ac97b2833918798","paragraph_ElementTree_utf8_XML_sha256":["e48470b18ad7e46d869a9b837f290c71d80ac53dc47540871f37e358f33d5498","bffdeb3a3b9db02aacc07b4126d6f77a6dcd0e7e2b14f124de938536ec7a3616","87c2007fe3ea2d9b241018bebc9cfa4b98bc3768c08f8b8aaafbafe776c85f8d","e8e6fcf9357347a06d47482655d4a66e7e48b5777d4cff87b99b32dbba68039b","80d7a8cf46fd20e0a78fed646b122be3137bc4162f4e29a4b3d87d150a9ba386","77ced0fac78e3d2726a631dc0ecbb0ff45e9d6731ea33e49779d26bc410beb5a","381d926e6e3ae04c037e9d8084ebdf717e678cb557586da72c034b72d37dab45","a4c32487f38f4f47bfd5ba964b0d47dcc9fbd16a9f4e4665e27946a64ac41922","04db8ad60a9874d22ba8530f67709e9220b862fb6521999a00188c9899390941","5883a53cb116ef2f9f1891de4f85688a6f024726f4e0d75f3e4b1e79203a856e","a4ac130615fa4d79d6d4ed53dc43f565680343d99ff7f86012d6b1953aa7603b","0c4e849d0cd62007718b6cad411ca27498c7e0f797efd3527016582ace9ecca8","e536ad2f9a08ce39a9945567f1fb469510766381989f8e2d0faf4a4f8184d5c3","c6416a49826b0598424c7856761191d25e9748f91afca4b31ac1898bbd28c285","6e24e95da0bc024613ef294615dc0b6961054ba2ede058c44bf73f46e70528e0","caa374936e73117c1f28a0e6b67f59cc274d88dbaea436209dfcf6f20d72f888","4e478e2579e2e35b1bde468c95df7a6cbe87e85dfe7d7d12d43e1630a7793747","662c52d6994f4cbbe49ae2cf77a19c582980417dc27a8eb65715ac49a28f5bda","278132b0d881f70aec962e93bad03f2015c658948a7d8e563c7430296945674d","639380f3f61f93d19c7d81e86aa5ed320e78c22d765b6464651d7434211c6798","20b7f902836ddecf85033541b77c29e919b97c11a211f97fab6c87b9e9d5c947","fd5a43d3f702d2d2f82900c25ec44c18e76174f12324801bde07410ff6864942","49c1d7b4d135500e41bfc93f851b964238212ab9712e0c5e9269f370d736448a","630705f189b70d22218bc20851e58f2b7245b1408c599da1a585f6bfa9f9247b"],"paragraph_range_zero_based":[552,575],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507330.zip::R2-2507330 Correction on NCD-SSB Configuration for Positioning(R19).docx:p552"}
{"fields":{"filename":"R2-2507330.zip::R2-2507330 Correction on NCD-SSB Configuration for Positioning(R19).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Specifies the SFN offset between the cell in which SSB is transmited and serving cell. The offset corresponds to the number of full radio frames counted from the beginning of a radio frame #0 of serving cell to the beginning of the closest subsequent radio frame #0 of the cell in which SSB is transmitted.","paragraph_zero_based":576},{"literal_text_all_w_t_and_m_t":"sfn-SSB-Offset","paragraph_zero_based":577},{"literal_text_all_w_t_and_m_t":"Indicates the SFN offset of the transmitted SSB relative to the start of the SSB period. Value 0 indicates that the SSB is transmitted in the first system frame, value 1 indicates that SSB is transmitted in the second system frame and so on. The network configures this field according to the field ssb-Periodicity such that the indicated system frame does not exceed the configured SSB periodicity.","paragraph_zero_based":578},{"literal_text_all_w_t_and_m_t":"ssb-Freq","paragraph_zero_based":579},{"literal_text_all_w_t_and_m_t":"Indicates the frequency of the SSB.","paragraph_zero_based":580},{"literal_text_all_w_t_and_m_t":"ss-PBCH-BlockPower","paragraph_zero_based":581},{"literal_text_all_w_t_and_m_t":"Average EPRE of the resources elements that carry secondary synchronization signals in dBm that the NW used for SSB transmission, see TS 38.213 [13], clause 7.","paragraph_zero_based":582},{"literal_text_all_w_t_and_m_t":"ssb-Periodicity","paragraph_zero_based":583},{"literal_text_all_w_t_and_m_t":"Indicates the periodicity of the SSB. If the field is absent, the UE applies the value ms5. (see TS 38.213 [13], clause 4.1)","paragraph_zero_based":584},{"literal_text_all_w_t_and_m_t":"ssbSubcarrierSpacing","paragraph_zero_based":585},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing of SSB.","paragraph_zero_based":586},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":587},{"literal_text_all_w_t_and_m_t":"FR1:    15 or 30 kHz","paragraph_zero_based":588},{"literal_text_all_w_t_and_m_t":"FR2-1/FR2-NTN:  120 or 240 kHz","paragraph_zero_based":589},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":590},{"literal_text_all_w_t_and_m_t":"ssb-TimeOffset","paragraph_zero_based":591},{"literal_text_all_w_t_and_m_t":"The time offset between CD-SSB of the serving cell and this NCD-SSB. Value ms5 means the first burst of NCD-SSB is transmitted 5ms later than the first burst of CD-SSB transmitted after the first symbol of SFN=0 of the serving cell, value ms10 means the first burst of NCD-SSB is transmitted 10ms later than the first burst of CD-SSB transmitted after the first symbol in SFN=0 of the serving cell, and so on. If the field is absent, UE considers that the time offset between the first burst of CD-SSB transmitted in the serving cell and the first burst of this NCD-SSB transmitted is zero. For UEs in TDD cells, the network configures this time offset to be an integer multiple of the periodicity of the serving cell's CD-SSB.","paragraph_zero_based":592},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":593},{"literal_text_all_w_t_and_m_t":"End of the third end ","paragraph_zero_based":594}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"6cf447ef83b3f28feadf4e8931d67c8cc1945c8cb922ae1af4aa83e358ac5897","original_member_sha256":"7a8210a9532f1161cc445693b9ebba29d25fff533bd090e41ac97b2833918798","paragraph_ElementTree_utf8_XML_sha256":["317988f2e2cd8f6e4e23a1d8272e2636257f0e2279d132493ce2d593bae6eb32","c3eb1e88720d4a74c4f2f4f47e6a85069faf2b96b228937a7591562da95e8126","a479c0390862cf7caf1e9723b2062c3dcc863299c2f1a638069e5c57e05a1fbe","05908dd