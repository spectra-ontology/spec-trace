2a0409854f","89a5ff47a45f27414f7001d576ac7b4ae082a8eb8fcc1883957d8c3a9f63f402","97922d3437576e3537729d4dfeeb12236649664aea4f04fc4f4e9f6a7f9b4cd5","575d50c906520f4182ca90ba8ce3f117cf4259e1aa1a11206124656b303c004d","1f9ad3b0704b88fa36b25be519999459b40a94be77a72e461eb270ac7fbceb4f","5d4eaeee3277c553b00348ab3f113e8bcce0220b4b18e171f0a310ca5552575f","4745e24cee1f43de3bae827e68e42400d735b74905f7c5fdde926c8f9909bef6","4c204e332b6b4038d6722eba73ac7b1c0a4feb0f17399e42cc8b9404e8d8d3d6","dff30fac5ff761816dcb5f5d815fef08c57bacafe8201da4fa09fd4a6d87636b","74949d39ce35ea5d2d959c16f1893e5ed6f86e5b8ed4717dfb01f526df3f6589","7cbf6ca3e3f8e63300a5c52b5f3fc48ac58e69a6a1674c64324782fbb7d580b5","0620ec035a129c8868a6fa3773cfbec733a39db3031fae25949963f6df274d65","676fb7cfcc20ba4a0f93672cd5a2e1390edf71c8674875e00cf3b32005f121d0","26266db7046f61288bd2da607b6b89cd0d05bccc5784d93d7e3b717d6560f272"],"paragraph_range_zero_based":[48120,48143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p48120"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Editor's note: The value range of sl-PSFCH-PowerOffset may need to be updated based on RAN4 reply LS.","paragraph_zero_based":48144},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48145},{"literal_text_all_w_t_and_m_t":"SL-ZoneConfigMCR field descriptions","paragraph_zero_based":48146},{"literal_text_all_w_t_and_m_t":"sl-TransRange","paragraph_zero_based":48147},{"literal_text_all_w_t_and_m_t":"Indicates the communication range requirement for the corresponding sl-ZoneConfigMCR-Index. The unit is meter.","paragraph_zero_based":48148},{"literal_text_all_w_t_and_m_t":"sl-ZoneConfig","paragraph_zero_based":48149},{"literal_text_all_w_t_and_m_t":"Indicates the zone configuration for the corresponding sl-ZoneConfigMCR-Index.","paragraph_zero_based":48150},{"literal_text_all_w_t_and_m_t":"sl-ZoneConfigMCR-Index","paragraph_zero_based":48151},{"literal_text_all_w_t_and_m_t":"Indicates the codepoint of the communication range requirement field in SCI.","paragraph_zero_based":48152},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48153},{"literal_text_all_w_t_and_m_t":"SL-ResourcePool field descriptions","paragraph_zero_based":48154},{"literal_text_all_w_t_and_m_t":"dummy","paragraph_zero_based":48155},{"literal_text_all_w_t_and_m_t":"This field is not used in the specification. If received it shall be ignored by the UE.","paragraph_zero_based":48156},{"literal_text_all_w_t_and_m_t":"numSym-SL-PRS-2ndStageSCI","paragraph_zero_based":48157},{"literal_text_all_w_t_and_m_t":"Indicates the number symbols to be assumed for SL PRS in determining the number of coded modulation symbols for second stage SCI in a slot of a shared SL PRS resource pool.","paragraph_zero_based":48158},{"literal_text_all_w_t_and_m_t":"sl-A2X-Service","paragraph_zero_based":48159},{"literal_text_all_w_t_and_m_t":"Presence of this field indicates the resource pool is dedicated for A2X service, i.e., not to be used for other than A2X service. Value brid indicates the resource pool is for BRID, value daa indicates the resource pool is for DAA, and value bridAndDAA indicates the resource pool is for both BRID and DAA. If this field is absent in all the configured resource pools, the UE may choose non-dedicated resource pool for A2X service.","paragraph_zero_based":48160},{"literal_text_all_w_t_and_m_t":"sl-Additional-MCS-Table","paragraph_zero_based":48161},{"literal_text_all_w_t_and_m_t":"Indicates the MCS table(s) additionally used in the resource pool. 64QAM table is (pre-)configured as default. Zero, one or two can be additionally (pre-)configured using the 256QAM and/or low-SE MCS tables. If two MCS tables are indicated, 256QAM MCS table is the 1st table and qam64lowSE MCS table is the 2nd table as specified in TS 38.214 [19], clause 8.1.3.1.","paragraph_zero_based":48162},{"literal_text_all_w_t_and_m_t":"sl-CPE-StartingPositionsPSCCH-PSSCH-InitiateCOT-Default","paragraph_zero_based":48163},{"literal_text_all_w_t_and_m_t":"Indicates CPE starting position index for the default CPE starting position, to be used for PSCCH/PSSCH transmission when UE initiating a COT.","paragraph_zero_based":48164},{"literal_text_all_w_t_and_m_t":"sl-CPE-StartingPositionsPSCCH-PSSCH-InitiateCOT-List","paragraph_zero_based":48165},{"literal_text_all_w_t_and_m_t":"Indicates a set of selected indices that correspond to multiple candidate CPE starting positions to be used for PSCCH/PSSCH transmission when UE initiating a COT, associated per L1 priority of PSSCH.","paragraph_zero_based":48166},{"literal_text_all_w_t_and_m_t":"sl-CPE-StartingPositionsPSCCH-PSSCH-WithinCOT-Default","paragraph_zero_based":48167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["ce9bda873e4e9392aea5835a485f0636ad404880d09f7f994a7aa1bfc4ddf135","07a32f1afa32aef96aa77c1318a1ecc37260fd5fcdce9e1d11151798403fd6d8","39a38fb9fc8e2c41d15159ea37065349922f4a0aa8e3a1cb6a807a63e9272a38","dc0bad21033b14099cf7c4cd169cd27d1cbb80ce998e8f0f8b0dd8559566e83f","ad84ec28eecb3905e74eda85b58808d76b3cf418b4be2276c4672dd2ccd650f1","b651c54f840d928b61597925172a36c7b1af4d321f88416ba7d6dd34a40b203d","e2c80b6d9d1d25d6ded5307d096a721655688c11ccce010ee5349a00b67077a5","e2f89df2f6e2581c3030957700f39461ae30e6168d99e6e34f1b23ef855d6c90","6ab8cb3e572ad79bc9f011f55b425f7c6bd499229135df009da2afcceae34ecd","cb3383861cf8941e93047433c031306cf50a89edc849bd11c6f0361520494175","d12172a2b5e338d1ef3354a7485b015a04eeaf3b8cc133e515c142d51b48a646","da1095d7d1cd81e8e25aaf9f1997df6a0eccca340371be9d2a5985ac38e5fecf","3a8a8b06269d89ec163a72f85f7d4241ab6703e119e457490a1aebb6930e5429","bd3db63521f0ff4bf0afdabff6da2295e5f8f210152255aa04aee8615e0b10c2","cb8610a116e552deaecf0994adf140008f1bd9e9ab28ed5932b76ece080e4278","29cec0fc44aa6b678fe693830b9248cafad32556e40adeaaee17001945fc9ae3","6deba42108e903abcc48fe99da8c9f8d042e9572b6ea20255e19e04b9b49b038","96a1cecbbffd702fe453af7101b0a114432e34577a3e4028b925579f546ca23b","880a8b854f4643058c5b5cc358ac57d35266b0eae27ba66bb0780f317eb15bee","d3129d360e7c8a566f8141d1cf1a649de6bc424c6f57284395ba61c21475c1bb","39fa411f29ae840d9e79290a7bb1970190ea935ba3c4973fd5dbba2dd0e5f5ea","57b803fe3fed63e9ab88b51d8f5c6f7e43595ba38ad32f643faf428558559b37","02e46b440d0ea846fcf6d7e81b547fde885627fd4dd2060e8127fdc56ac7e88a","ca3359f8b5c86536a7a30f93cc8c80272fbfd52bb8499155d7adc8e814f8a6ea"],"paragraph_range_zero_based":[48144,48167],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p48144"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates CPE starting position index for the default CPE starting position, to be used by UE for PSCCH/PSSCH transmission within a COT.","paragraph_zero_based":48168},{"literal_text_all_w_t_and_m_t":"sl-CPE-StartingPositionsPSCCH-PSSCH-WithinCOT-List","paragraph_zero_based":48169},{"literal_text_all_w_t_and_m_t":"Indicates a set of one or multiple selected indices that correspond to one or multiple candidate CPE starting positions to be used by UE for PSCCH/PSSCH transmission within a COT, associated per L1 priority of PSSCH.","paragraph_zero_based":48170},{"literal_text_all_w_t_and_m_t":"sl-CPE-StartingPositionPSFCH","paragraph_zero_based":48171},{"literal_text_all_w_t_and_m_t":"Indicates CPE starting position within the GP symbol before PSFCH transmission. The value is an index of the set of all candidate CPE starting positions specified in Table 5.3.1-3 of [16, TS38.211] for Ci=1 and the corresponding SCS of the SL BWP.","paragraph_zero_based":48172},{"literal_text_all_w_t_and_m_t":"sl-FilterCoefficient","paragraph_zero_based":48173},{"literal_text_all_w_t_and_m_t":"This field indicates the filtering coefficient for long-term measurement and reference signal power derivation used for sidelink open-loop power control.","paragraph_zero_based":48174},{"literal_text_all_w_t_and_m_t":"sl-InterUE-CoordinationConfig","paragraph_zero_based":48175},{"literal_text_all_w_t_and_m_t":"Indicates the configured sidelink inter-UE coordination parameters.","paragraph_zero_based":48176},{"literal_text_all_w_t_and_m_t":"sl-IUC-RB-SetList","paragraph_zero_based":48177},{"literal_text_all_w_t_and_m_t":"The n-th value in the list indicates the set of PRBs of n-th PSFCH occasion that are actually used for inter-UE coordination information transmission and reception in Scheme 2. It shall be (pre-)configured such that N candidate PSFCH occasion(s) are associated with N different PRB sets. PRBs within intra-cell guard band are not used for PSFCH transmission. The length of this list is aligned with sl-NumPSFCH-Occasions. For each PSFCH occasion, the set of PRBs are indicated in the same format as in sl-PSFCH-RB-Set.","paragraph_zero_based":48178},{"literal_text_all_w_t_and_m_t":"sl-NumDedicatedPRBs-ForPSFCH","paragraph_zero_based":48179},{"literal_text_all_w_t_and_m_t":"Indicates the value of K3 when each PSFCH transmission occupies \"1 common interlace and K3 dedicated PRB(s)\" (as indicated by sl-TransmissionStructureForPSFCH). Value prb1 corresponds to K3=1, value prb2 corresponds to K3=2, and so on. UE expects the same (pre-)configured value of sl-NumDedicatedPRBs-ForPSFCH across all resource pools.","paragraph_zero_based":48180},{"literal_text_all_w_t_and_m_t":"sl-NumInterlacePerSubchannel","paragraph_zero_based":48181},{"literal_text_all_w_t_and_m_t":"Indicates the number of (K) interlaces per sub-channel within a resource pool. Value sc1 corresponds to 1 interlace per sub-channel, and value sc2 corresponds to 2 interlaces per sub-channel. The applicable values are related to the subcarrier spacing as below:","paragraph_zero_based":48182},{"literal_text_all_w_t_and_m_t":"For SCS = 15 kHz: K=1 or 2","paragraph_zero_based":48183},{"literal_text_all_w_t_and_m_t":"For SCS = 30 kHz: K=1","paragraph_zero_based":48184},{"literal_text_all_w_t_and_m_t":"sl-NumPSFCH-Occasions","paragraph_zero_based":48185},{"literal_text_all_w_t_and_m_t":"Indicates one PSCCH/PSSCH transmission has N associated candidate PSFCH occasion(s). Value o1 corresponds to N=1, value o2 corresponds to N=2, and so on. If the field is not configured, the UE shall use value o1.","paragraph_zero_based":48186},{"literal_text_all_w_t_and_m_t":"sl-NumReferencePRBs-OfInterlace","paragraph_zero_based":48187},{"literal_text_all_w_t_and_m_t":"Indicate reference number of PRBs of one interlace within 1 RB set. Value prb10 corresponds to 10 PRBs, and value prb11 corresponds to 11 PRBs.","paragraph_zero_based":48188},{"literal_text_all_w_t_and_m_t":"sl-NumRefSymbolLength","paragraph_zero_based":48189},{"literal_text_all_w_t_and_m_t":"Indicates a reference number of symbols for TBS determination.","paragraph_zero_based":48190},{"literal_text_all_w_t_and_m_t":"sl-NumSubchannel","paragraph_zero_based":48191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["1d13f9b4d4acc9bda90593a5f027f8dfbcbc7c4a8c178558d46b6f33105442b6","3f05fc719ee40db6a6ba022a175f428d88da0f2d4ca25a7576fb6574a2fe4118","f167d98fa339ce6d2b2b70c4178034a1cd9c9ce332ee6b9b86362c29b41f4c64","c1dc6243f28dde948a770d4508364446eeecc46cedb30812b50849cf682e90ca","58d15b61c1e25b30eb9063e183a63e99e7e2791c243d0760a9b5707d2cafb618","d5f299e5b587fcb7a98b24cf83b3b36fbb587056b111f572f99d6095118518ba","8aba9489e699f8684ae0908983e33eb3d168b518a9840ca176aa2004be7234fb","8b6f1a8bedc98cd6df5f010cf45674dd9c3eef1b5695652df68ca7bedbbac35c","7769a933ac1f2165906bd5cea65dc697cf2c24c07bcc5f06e960369e60e3178d","3405e461d9630d340569e6e77893bff7b635dcb43a92275e6c66c941e4738c6a","69574158536faa25645baf99b399a2ba6e6c084aa0534a0c87575a3b4ffaf213","fe090e6c2e8d634d4cf70f02d69170c5841231731f95598a3981dbc9655ad097","c8c7ffc461a731ea9aabb4ef76c674c88958d9cab7d9dc835b781904de35417e","4f441e6357defbe9375767a526e544b938740cc883e1e1269491f677fbc00f72","d47a689b5f90a0117544ffc2fbae994ac0378588d44e12dabf1c42fecca7f1de","a9b32b9403853929712c355d6eddbd145312110ab37f1657c7547977f8090a73","713476fc99244e7747d98f05178b4ec96889979a5940e89730311640ee881996","c7c9fc928b6bbe467001f02973e2df70b4d603a2708ae115b460b6b4aa9da510","b9b7a2dcc014baa59ada1fb991e3fd3b7d6d31cfe2bd19ff903a1db468526b41","126767b2eafd79b04bca261160c8073dfa556360bdba074382038a2730cac545","7601ab3ec28e661c1492712f808d12688e29c4ae3e1f26d481ccad62d38d3136","aaa5e059202968e51409147f6cfbb3cc4fa5754efdd0acf2891f347ffb7f73ba","b0ec0dacd0918e283c804e1f1b3efee0baa89994371d342559379ea170e4706f","093d2977641050e9eb717ce83ee3c7dc6d0aa885e2be1f319190e747505fedfa"],"paragraph_range_zero_based":[48168,48191],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p48168"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the number of subchannels in the corresponding resource pool, which consists of contiguous PRBs only.","paragraph_zero_based":48192},{"literal_text_all_w_t_and_m_t":"sl-PBPS-CPS-Config","paragraph_zero_based":48193},{"literal_text_all_w_t_and_m_t":"Indicates the allowed resource allocation schemes of full sensing only, partial sensing only, random resource selection only, or any combination(s), and the related configuration for power saving resource allocation schemes. This field is absent for sl-TxPoolExceptional.","paragraph_zero_based":48194},{"literal_text_all_w_t_and_m_t":"sl-PreemptionEnable","paragraph_zero_based":48195},{"literal_text_all_w_t_and_m_t":"Indicates whether pre-emption is disabled or enabled in a resource pool. If the field is present and the value is pl1, pl2, and so on (but not enabled), it means that pre-emption is enabled and a priority level p_preemption is configured. If the field is present and the value is enabled, the pre-emption is enabled (but p_preemption is not configured) and pre-emption is applicable to all levels.","paragraph_zero_based":48196},{"literal_text_all_w_t_and_m_t":"sl-PriorityThreshold-UL-URLLC","paragraph_zero_based":48197},{"literal_text_all_w_t_and_m_t":"Indicates the threshold used to determine whether NR sidelink transmission is prioritized over uplink transmission of priority index 1 as specified in TS 38.213[13], clause 16.2.4.3, or whether PUCCH transmission carrying SL HARQ is prioritized over PUCCH transmission carrying UCI of priority index 1 if they overlap in time as specified in TS 38.213 [13], clause 9.2.5.0.","paragraph_zero_based":48198},{"literal_text_all_w_t_and_m_t":"sl-PriorityThreshold","paragraph_zero_based":48199},{"literal_text_all_w_t_and_m_t":"Indicates the threshold used to determine whether NR sidelink transmission is prioritized over uplink transmission of priority index 0 as specified in TS 38.213[13], clause 16.2.4.3, or whether PUCCH transmission carrying SL HARQ is prioritized over PUCCH transmission carrying UCI of priority index 0 if they overlap in time as specified in TS 38.213 [13], clause 9.2.5.0.","paragraph_zero_based":48200},{"literal_text_all_w_t_and_m_t":"sl-PRS-ResourcesSharedSL-PRS-RP","paragraph_zero_based":48201},{"literal_text_all_w_t_and_m_t":"Indicates SL PRS resources in a slot of shared SL PRS resource pool as defined in TS 38.211 [16].","paragraph_zero_based":48202},{"literal_text_all_w_t_and_m_t":"sl-PSFCH-CommonInterlaceIndex","paragraph_zero_based":48203},{"literal_text_all_w_t_and_m_t":"Indicate the index of common interlace to meet OCB requirements when transmissionStructureForPSFCH is set to common interlace. Value 0 corresponds to interlace 0 is used as common interlace, value 1 corresponds to interlace 1 is used as common interlace and so on.","paragraph_zero_based":48204},{"literal_text_all_w_t_and_m_t":"sl-PSFCH-PowerOffset","paragraph_zero_based":48205},{"literal_text_all_w_t_and_m_t":"Indicates the power offset between Tx power on one common PRB (P_common) and Tx power on one dedicated PRB (P_dedicated) when sl-TransmissionStructureForPSFCH  is (pre-)configured as commonInterlace, i.e., P_common = P_dedicated - offset. UE expects the same (pre-)configured value of sl-PSFCH-PowerOffset across all resource pools. The unit is dB.","paragraph_zero_based":48206},{"literal_text_all_w_t_and_m_t":"sl-PSFCH-RB-SetList","paragraph_zero_based":48207},{"literal_text_all_w_t_and_m_t":"The n-th value in the list indicates the set of PRBs that are actually used for PSFCH transmission and reception of n-th PSFCH occasion of a PSCCH/PSSCH transmission.","paragraph_zero_based":48208},{"literal_text_all_w_t_and_m_t":"It shall be (pre-)configured such that N candidate PSFCH occasion(s) are associated with N different PRB sets. PRBs within intra-cell guard band are not used for PSFCH transmission. The length of this list is aligned with sl-NumPSFCH-Occasions. For each PSFCH occasion, the set of PRBs are indicated in the same format as in sl-PSFCH-RB-Set.","paragraph_zero_based":48209},{"literal_text_all_w_t_and_m_t":"sl-RB-Number","paragraph_zero_based":48210},{"literal_text_all_w_t_and_m_t":"Indicates the number of PRBs in the corresponding resource pool, which consists of contiguous PRBs only. The remaining RB cannot be used (See TS 38.214[19], clause 8).","paragraph_zero_based":48211},{"literal_text_all_w_t_and_m_t":"sl-RBSetIndexOfResourcePool","paragraph_zero_based":48212},{"literal_text_all_w_t_and_m_t":"For interlace RB based PSCCH/PSSCH, indicates the RB set index(s) included in the resource pool. Contiguous RB sets are (pre-)configured for a resource pool.","paragraph_zero_based":48213},{"literal_text_all_w_t_and_m_t":"sl-SCI-based-SL-PRS-Tx-Trigger-SCI2-D","paragraph_zero_based":48214},{"literal_text_all_w_t_and_m_t":"Indicates presence of a bit-field in SCI format 2-D to trigger SL-PRS transmission by a receiving UE.","paragraph_zero_based":48215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["a73e2a536a2854ee38067ec038feddcabbb1bc3f262f07ce4158a5022ab92927","03019a89bf9bdea3ecc8574586636c7193a5d0ef344ed0d78e3e473e5e82892d","4b2de94f01d19fcb595abad1ff8faac057c7e3f52c536d43723ebef4f9ba38f6","4d46164fafd2c307a07700262e525e145ea1879520e5b2f71319eebe04827252","051ae7c786a5fd2710e1c7d873eef580f9de214cd889cb3145d655255f73b6e3","88076e6a2ef4206ac01a5a1ddd8026006852909e33d001f7a2d184eeb269de1d","2b5508ea47b96e9d596ae42ad1c8915571fd219621b1b246930c1a3b47c49548","49a692c260fca643282adabae19b8c1232a8a3a0d887af379f4820666b7ce7ab","429ca57ff778c0002c3c15cac4a73680cff49b13657c5fb99a166391985fb5e5","e46f93810144015e2a41e8d1c716428568ae17a31143842edf6a138e48b1de3d","d4ca4e1a8669c7f9c921e5c019366a64e7c70ae98076a5fedcb8520715cf9b1e","dee091f80c003846d38b673e76320857c926230a4b99333fc6df1f9ad3ac2b0e","c0eb9d8605365293d1dd79a3694fac7cb0fffbf7a14efa2a012c673aa7fea26b","16c3fee5088ec4b708ff66f54f5992d434bd0bf1bfa966199002e3379daa9e6a","e9a7c29250bd28e660050264a595f995e5bc0cf22cba39270156c8650d4b2846","0072ad6b15851636f6f34962603814ccfef4bc69e1c25588753c3c4882038706","6e5aaafe01b25a0d580b95ebf2952690c423d75d9d00407e54185f07fdb79a50","03e088b3adbba4ff8ecec778b53175feb8edaf4fab3f557121378324ab54b727","34d0077edb67fb14b77e48365e4a41091308289103daeea14b46d4f219f5ae01","73895eb4b70e65d634db011d18ea354f4d2d29dfbf29e22a866efc9af5053b1b","b4f16d09f4707809dd8a76bf6e8741883209d0129a1ad9e5e496a871e6073bed","33fbee880b40c8175c54dff8923861788820a7e7a95bce3a33a8b7ac88532278","1eae4692b63d432c6223493d647ff031551e98fa25d484b99a25d22a4f363502","e930d9736f2dccadb9a2935c8ed2f2c2e03aca61190af0440be25ad936ee98d1"],"paragraph_range_zero_based":[48192,48215],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p48192"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-StartRB-Subchannel","paragraph_zero_based":48216},{"literal_text_all_w_t_and_m_t":"Indicates the lowest RB index of the subchannel with the lowest index in the resource pool with respect to the lowest RB index of a SL BWP.","paragraph_zero_based":48217},{"literal_text_all_w_t_and_m_t":"sl-SubchannelSize","paragraph_zero_based":48218},{"literal_text_all_w_t_and_m_t":"Indicates the minimum granularity in frequency domain for the sensing for PSSCH resource selection in the unit of PRB.","paragraph_zero_based":48219},{"literal_text_all_w_t_and_m_t":"sl-SyncAllowed","paragraph_zero_based":48220},{"literal_text_all_w_t_and_m_t":"Indicates the allowed synchronization reference(s) which is (are) allowed to use the configured resource pool.","paragraph_zero_based":48221},{"literal_text_all_w_t_and_m_t":"sl-SyncConfigIndex","paragraph_zero_based":48222},{"literal_text_all_w_t_and_m_t":"Indicates the synchronisation configuration that is associated with a reception pool, by means of an index to the corresponding entry SL-SyncConfigList of in SIB12 for NR sidelink communication.","paragraph_zero_based":48223},{"literal_text_all_w_t_and_m_t":"sl-TDD-Configuration","paragraph_zero_based":48224},{"literal_text_all_w_t_and_m_t":"Indicates the TDD configuration associated with the reception pool of the cell indicated by sl-SyncConfigIndex.","paragraph_zero_based":48225},{"literal_text_all_w_t_and_m_t":"sl-ThreshS-RSSI-CBR","paragraph_zero_based":48226},{"literal_text_all_w_t_and_m_t":"Indicates the S-RSSI threshold for determining the contribution of a sub-channel to the CBR measurement. Value 0 corresponds to -112 dBm, value 1 to -110 dBm, value n to (-112 + n*2) dBm, and so on.","paragraph_zero_based":48227},{"literal_text_all_w_t_and_m_t":"sl-TimeResource","paragraph_zero_based":48228},{"literal_text_all_w_t_and_m_t":"Indicates the bitmap of the resource pool, which is defined by repeating the bitmap with a periodicity during a SFN or DFN cycle.","paragraph_zero_based":48229},{"literal_text_all_w_t_and_m_t":"sl-TimeWindowSizeCBR","paragraph_zero_based":48230},{"literal_text_all_w_t_and_m_t":"Indicates the time window size for CBR measurement.","paragraph_zero_based":48231},{"literal_text_all_w_t_and_m_t":"sl-TimeWindowSizeCR","paragraph_zero_based":48232},{"literal_text_all_w_t_and_m_t":"Indicates the time window size for CR evaluation.","paragraph_zero_based":48233},{"literal_text_all_w_t_and_m_t":"sl-TransmissionStructureForPSFCH","paragraph_zero_based":48234},{"literal_text_all_w_t_and_m_t":"Indicate each PSFCH transmission occupies \"1 common interlace and K3 dedicated PRB(s)\", or \"1 dedicated interlace\". Value commonInterlace corresponds to \"1 common interlace and K3 dedicated PRB(s)\", and value dedicatedInterlace corresponds to \"1 dedicated interlace\". UE expects the same (pre-)configured value of transmissionStructureForPSFCH across all resource pools.","paragraph_zero_based":48235},{"literal_text_all_w_t_and_m_t":"sl-TriggerConditionRequest","paragraph_zero_based":48236},{"literal_text_all_w_t_and_m_t":"Indicates the trigger condition of an explicit request from UE-B to UE-A. Value 0 means the explicit request is triggered by UE-B's implementation. Value 1 means the explicit request can be triggered only when UE-B has SL-PRS to be transmitted to UE-A.","paragraph_zero_based":48237},{"literal_text_all_w_t_and_m_t":"sl-TxPercentageList","paragraph_zero_based":48238},{"literal_text_all_w_t_and_m_t":"Indicates the portion of candidate single-slot PSSCH resources over the total resources. Value p20 corresponds to 20%, and so on.","paragraph_zero_based":48239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["e72b9f72c055b561c50a26e561683e5d6f6b8acf46ce59055fe4630716ba64fc","4bc4fc2f2933939376c1a618461a3f2ebbe3a3a3b13ee4815163eaaa1a4e4922","e18facbf58a33ede9126361ae1b3c9a4b819087b5e292fb806642c5d0774756f","fb737661de5f5a5ffae5f83c59aec46aa30a6a13479bb12524b5b684478f0297","e4dd38748a4b0ec6c20a45adf0588524f6964cca236fa7cb46f455ab5708c1ee","875a7133dfa67bff51487ab539340215326df152aac69e1dfda8bdb45e980a54","fa0665741b5ed03f22da1478b9cdac528cc7b5035b3f743a602abd70e262e0f9","b9b37741504828822ef3db413c5bb0f58914b1e0b5942347dfbc971582e53abc","c9bf4968ba6836e02e94247ca169dffd21fa3e981327d440b3ab30c7918a0147","dca795c19daee8769b13e1ec92ab2acca89eb7d15a5ad5815a5508e36ca74718","44d34f9f3405a5d328d0d5fa6968ccee577bd8ddc0d024ea9591cffdb8944e79","87a0eea84066377e3c01a1a835a1258fd9ff92d5c16470dce00cd3cc59849084","00459b2e9bd753b5ed84ea5481dbb9d4b175d307e78fac236d9f6b31e2202208","1e6ac956cbf9d51006dc718c94da4202469800a5b6eefec9d303ef90cd8d0b62","2fe8f3656a09e6dabca442e219e2c9bd413e48788e2f0ccfb0c29451f9fa7e58","a279bbfa0837dc297deb43dbd48e762088fe2d041aa0da40173b3ba7cebd4593","caa4a078e2451f305a58a77e359247cb92c0cf5224d1bfe102f4256e37d5325e","90489180abe354492f1ba5053b71c9af2f2cc8acad4a2b3886c8f43d29bc31d7","a1d48c937dbcdb90d446623740c6d9de6c3dc8e4a2dc2bf0254d490a02418c32","1339b9b2ab9aca584ee2e3a2a519652b1aab6eb5fb5019f5c7d2fa67aeaa6e99","aa253e4ce4860581cfdd2e21beeedd84360edbeba2714be83f526fbf9f1d396c","3895410e8b1baf76daec797f95824b6c0ad7ef37906ea74b93762a3b9f38475d","281070fa42ff9e1bf1032647c2edb6bea0e674509809ee3b81bedd622d539d79","102c7caa70e5c534325c2db83484aeea5ecd25fd23b05c7a0adfb33a8d7a6cdb"],"paragraph_range_zero_based":[48216,48239],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p48216"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-Type1-LBT-BlockingOption1","paragraph_zero_based":48240},{"literal_text_all_w_t_and_m_t":"Indicates UE may avoid selection of N consecutive resource(s) before a reserved resource of another UE when the L1 SL priority value for the transmission is higher than the L1 SL priority value of the reserved resource, and UE may also avoid selection of M consecutive resource(s) after a reserved resource of another UE when the transmitting symbols of the reserved resource overlap with LBT of the selected resource. The selection of the value N is up to UE implementation from {0, 1, 2}. M is determined based on UE implementation (at least including 0).","paragraph_zero_based":48241},{"literal_text_all_w_t_and_m_t":"sl-Type1-LBT-BlockingOption2","paragraph_zero_based":48242},{"literal_text_all_w_t_and_m_t":"Indicates UE may prioritize/select resource(s) in the slot(s) for transmission, if UE's transmission in slot(s) before a reserved resource is able to share its initiated COT to the reservation.","paragraph_zero_based":48243},{"literal_text_all_w_t_and_m_t":"sl-X-Overhead","paragraph_zero_based":48244},{"literal_text_all_w_t_and_m_t":"Accounts for overhead from CSI-RS, PT-RS. If the field is absent, the UE applies value n0 (see TS 38.214 [19], clause 5.1.3.2).","paragraph_zero_based":48245},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48246},{"literal_text_all_w_t_and_m_t":"SL-SyncAllowed field descriptions","paragraph_zero_based":48247},{"literal_text_all_w_t_and_m_t":"gnbEnb-Sync","paragraph_zero_based":48248},{"literal_text_all_w_t_and_m_t":"If configured, the (pre-) configured resources can be used if the UE is directly or indirectly synchronized to eNB or gNB (i.e., synchronized to a reference UE which is directly synchronized to eNB or gNB).","paragraph_zero_based":48249},{"literal_text_all_w_t_and_m_t":"gnss-Sync","paragraph_zero_based":48250},{"literal_text_all_w_t_and_m_t":"If configured, the (pre-) configured resources can be used if the UE is directly or indirectly synchronized to GNSS (i.e., synchronized to a reference UE which is directly synchronized to GNSS).","paragraph_zero_based":48251},{"literal_text_all_w_t_and_m_t":"ue-Sync","paragraph_zero_based":48252},{"literal_text_all_w_t_and_m_t":"If configured, the (pre-) configured resources can be used if the UE is synchronized to a reference UE which is not synchronized to eNB, gNB and GNSS directly or indirectly.","paragraph_zero_based":48253},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48254},{"literal_text_all_w_t_and_m_t":"SL-PSCCH-Config field descriptions","paragraph_zero_based":48255},{"literal_text_all_w_t_and_m_t":"sl-FreqResourcePSCCH","paragraph_zero_based":48256},{"literal_text_all_w_t_and_m_t":"Indicates the number of PRBs for PSCCH in a resource pool where it is not greater than the number PRBs of the subchannel.","paragraph_zero_based":48257},{"literal_text_all_w_t_and_m_t":"sl-DMRS-ScrambleID","paragraph_zero_based":48258},{"literal_text_all_w_t_and_m_t":"Indicates the initialization value for PSCCH DMRS scrambling.","paragraph_zero_based":48259},{"literal_text_all_w_t_and_m_t":"sl-NumReservedBits","paragraph_zero_based":48260},{"literal_text_all_w_t_and_m_t":"Indicates the number of reserved bits in first stage SCI.","paragraph_zero_based":48261},{"literal_text_all_w_t_and_m_t":"sl-TimeResourcePSCCH","paragraph_zero_based":48262},{"literal_text_all_w_t_and_m_t":"Indicates the number of symbols of PSCCH in a resource pool.","paragraph_zero_based":48263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["1580cc77dfbf73405b9bbb8a09b54b94a1a094fec41b9974d59763a5b5ce1745","7fdcd9d9b5e291365f5f7053a3186fbc56947e9ab113980f529a65b9320467e8","370a4d21dfa523523aaf6b515251c2a1af8dcd781a36cf15403d96cd258309d9","ebed5bd01b6007c94d1897aff07783d2105a315b45ef8d126061c5a387ba89d7","199e28b953ab7f590bdd35966f8bfaa0584b099131c0abc932628fb2c79d56eb","2398a88ae0095582a694fb78b89986d1d7e8b08724cfb43cc992882d92b183d5","172dac2f69a3347139f298d955d0d42678c92e1c59fcabdd56e3f6dad6367af6","cae2e8428cefba0edb367c5d0e2160f369c336b91b703bd7fd739691a5691e38","4592c1a6cb808745275bc1df6758246dea8b68b78ffc93c943310c146b3498f5","9fa6708772f47ea9cc3dfa837539e9c5e3e4537c6aa7a3ae64211318bbd85e6e","d2b78e51d61cb81da980e9baceb9b3917ac61930e8964591247cc242e94cae55","6863bb17813db0e6be373956f86b0b8b953d3af559b1ead32cb3d6da5bf0c194","b79f519869f8d7dde0c8625b4da596c0fb3495bb2ceca6fddd32c17706b16b56","32f6435432e9ae406e5311c669f9890135a54539efcbfed3dbe00067d3230c0d","f11584875408614cb9edb27b63dee9b9d72ee7cc52f9c4118bc5427870750a9c","e6dafd61cf7725dace82fa712d784f8e86d7927517c585e202d1488d05a8868e","782ce097c65e970fec5af87bda4831cde8af9323af2da989d9c42727dc0f3c6b","89f1ed6b52eec64b9d6d28563cb7cd7a216addb307451425a2f6b6c834f39bfd","2188a3f3262896632409dcc0d4f1a13faacff70833ab3ca9a47984bb9b514d07","393343df641f1b3b276a387cafd4da61f3cc799d3054afbd73e8a046a3777c83","0d4a54317ee56d167ba096f085ef1d33f095004dc694dd1e632567c4c21f2705","0888902a7b846145061ab4c34677c5e9b0761a304cb654e9536536d4a4d45bb7","6e5eb9d3ea8e6f260ea05597119ba70d37f3424ba70d6ee6cea40c8cb3adf61d","49cb742c8b00dd0c9a3d146df5ba68060dee1ea1b277daac19bf21fda56de2cf"],"paragraph_range_zero_based":[48240,48263],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p48240"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48264},{"literal_text_all_w_t_and_m_t":"SL-PSSCH-Config field descriptions","paragraph_zero_based":48265},{"literal_text_all_w_t_and_m_t":"sl-BetaOffsets2ndSCI","paragraph_zero_based":48266},{"literal_text_all_w_t_and_m_t":"Indicates candidates of beta-offset values to determine the number of coded modulation symbols for second stage SCI. The value indicates the index of Table 9.3-2 of TS 38.213 [13].","paragraph_zero_based":48267},{"literal_text_all_w_t_and_m_t":"sl-PSSCH-DMRS-TimePatternList","paragraph_zero_based":48268},{"literal_text_all_w_t_and_m_t":"Indicates the set of PSSCH DMRS time domain patterns in terms of PSSCH DMRS symbols in a slot that can be used in the resource pool.","paragraph_zero_based":48269},{"literal_text_all_w_t_and_m_t":"sl-Scaling","paragraph_zero_based":48270},{"literal_text_all_w_t_and_m_t":"Indicates a scaling factor to limit the number of resource elements assigned to the second stage SCI on PSSCH. Value f0p5 corresponds to 0.5, value f0p65 corresponds to 0.65, and so on.","paragraph_zero_based":48271},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48272},{"literal_text_all_w_t_and_m_t":"SL-PSFCH-Config field descriptions","paragraph_zero_based":48273},{"literal_text_all_w_t_and_m_t":"sl-MinTimeGapPSFCH","paragraph_zero_based":48274},{"literal_text_all_w_t_and_m_t":"The minimum time gap between PSFCH and the associated PSSCH in the unit of slots.","paragraph_zero_based":48275},{"literal_text_all_w_t_and_m_t":"sl-NumMuxCS-Pair","paragraph_zero_based":48276},{"literal_text_all_w_t_and_m_t":"Indicates the number of cyclic shift pairs used for a PSFCH transmission that can be multiplexed in a PRB.","paragraph_zero_based":48277},{"literal_text_all_w_t_and_m_t":"sl-PSFCH-CandidateResourceType","paragraph_zero_based":48278},{"literal_text_all_w_t_and_m_t":"Indicates the number of PSFCH resources available for multiplexing HARQ-ACK information in a PSFCH transmission (see TS 38.213 [13], clause 16.3).","paragraph_zero_based":48279},{"literal_text_all_w_t_and_m_t":"sl-PSFCH-HopID","paragraph_zero_based":48280},{"literal_text_all_w_t_and_m_t":"Scrambling ID for sequence hopping of the PSFCH used in the resource pool.","paragraph_zero_based":48281},{"literal_text_all_w_t_and_m_t":"sl-PSFCH-Period","paragraph_zero_based":48282},{"literal_text_all_w_t_and_m_t":"Indicates the period of PSFCH resource in the unit of slots within this resource pool. If set to sl0, no resource for PSFCH, and HARQ feedback for all transmissions in the resource pool is disabled.","paragraph_zero_based":48283},{"literal_text_all_w_t_and_m_t":"sl-PSFCH-RB-Set","paragraph_zero_based":48284},{"literal_text_all_w_t_and_m_t":"Indicates the set of PRBs that are actually used for PSFCH transmission and reception. The leftmost bit of the bitmap refers to the lowest RB index in the resource pool, and so on. Value 0 in the bitmap indicates that the corresponding PRB is not used for PSFCH transmission and reception while value 1 indicates that the corresponding PRB is used for PSFCH transmission and reception (see TS 38.213 [13]).","paragraph_zero_based":48285},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48286},{"literal_text_all_w_t_and_m_t":"SL-PTRS-Config field descriptions","paragraph_zero_based":48287}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["9fd69bb3223acd8ba02fcf62ecd1a701618c0aad83cdf30513f51de687c13efa","bf800934b6d06c4e6c4d76b1e13d4602531d85f13f338eaf80bff6e3e44053f9","75e1962fce80a8a3c89f34ff18204cd480d62364cc7dbce69bbf5b1e7a8ee4f9","7e727ca954de0a42ae43447bc78e7f1dfc8964472547f5a8f06312fa09eec2a7","f59a9d432153c39e1491021cb7f0ba466cd4ae07242d0515ea45652657299465","7d696f7b82783824adcfad568a0eee699687e696e4621c00c6a147d7c8abbf12","26ee70c4c8037dafd833e1cff24ff2138dd80b97c610810ae782824d14f0e354","4f6384b0ddcb539df8416cb29b59729e78e6f4480543cc49cac717bb2b699090","0c9026776ea6fe587a2af082a20c2e5970f51d57923f9e3ed165503ae1302ead","6c72ecd9347179fb7dabe3a896476ff855979cfc6f454f2b85f4aa326703a485","3f0df235ca4873d43b0ba725d58999e3eafc7d279c3042b85e869b6bdb980f30","c406e9ed9c4d4bf6db3ec970534761e714e5d06b8b2e820d7f2064a2218313db","7eb34a848b190cbb2aef4ea7f12b3c86564889f92506258a07d939506806429a","7923402e3024d076be37a0a08335cf24811d000497cf6c08b17454bc38f85278","c2eee436c3a61cda99c024b3ce947f75439fa56a9d2fb442d4454196daf41885","463f935c1b9905a9c5a1a8be5f7089ebe1496127d867e491643bd1a1a5fe28b8","4e9e792c3a308a6e61702f8822ec3e2aacae445291b998d5e71b09cd75d29b22","db7ebe28957a20f10c6ca32fee8c1f3f58717f5af7635a5d163697ee9452e782","387c71bffa809b1167458f99226be7f50b9e7994168eda12cc85e8567d9aed1d","d81f65f047d2e85587f3f1ac44ac27b007b2be7ae09416a654d782981a58198f","b5717258e882d3bf1ea7191e0a0cc5f3dd0f6b1a5e1d7a8dd5f66090dbffef3e","ed1792d5e901ab329573df04070a0fc2bb5531829df057573e8e5c1c3255fec6","aec2a200883c980a51fbb41baffa879513ffc078d28c8b9b31b8f732a0dfa2bd","8dec972e2a273a41de622c9f8160a34bc9a03b1175cb48ee934f02f588dc6907"],"paragraph_range_zero_based":[48264,48287],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p48264"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-PTRS-FreqDensity","paragraph_zero_based":48288},{"literal_text_all_w_t_and_m_t":"Presence and frequency density of SL PT-RS  as a function of scheduled BW. If the field is not configured, the UE uses K_PT-RS = 2","paragraph_zero_based":48289},{"literal_text_all_w_t_and_m_t":"sl-PTRS-TimeDensity","paragraph_zero_based":48290},{"literal_text_all_w_t_and_m_t":"Presence and time density of SL PT-RS  as a function of MCS. If the field is not configured, the UE uses L_PT-RS = 1","paragraph_zero_based":48291},{"literal_text_all_w_t_and_m_t":"sl-PTRS-RE-Offset","paragraph_zero_based":48292},{"literal_text_all_w_t_and_m_t":"Indicates the subcarrier offset for SL PT-RS . If the field is not configured, the UE applies the value offset00 (see TS 38.211 [16], clause 8.4.1.2.2).","paragraph_zero_based":48293},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48294},{"literal_text_all_w_t_and_m_t":"SL-UE-SelectedConfigRP field descriptions","paragraph_zero_based":48295},{"literal_text_all_w_t_and_m_t":"sl-CBR-PriorityTxConfigList","paragraph_zero_based":48296},{"literal_text_all_w_t_and_m_t":"Indicates the mapping between PSSCH transmission parameter (such as MCS, PRB number, retransmission number, CR limit) sets by using the indexes of the configurations in sl-CBR-PSSCH-TxConfigList, CBR ranges by using the indexes to the entry of the CBR range configurations in sl-CBR-RangeConfigList, and priority ranges. It also indicates the default PSSCH transmission parameters to be used when CBR measurement results are not available, and MCS range for the MCS tables used in the resource pool. The field sl-CBR-PriorityTxConfigList-v1650 is present only when sl-CBR-PriorityTxConfigList-r16 is configured.","paragraph_zero_based":48297},{"literal_text_all_w_t_and_m_t":"sl-MaxNumPerReserve","paragraph_zero_based":48298},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of reserved PSCCH/PSSCH resources that can be indicated by an SCI.","paragraph_zero_based":48299},{"literal_text_all_w_t_and_m_t":"sl-MultiReserveResource","paragraph_zero_based":48300},{"literal_text_all_w_t_and_m_t":"Indicates if it is allowed to reserve a sidelink resource for an initial transmission of a TB by an SCI associated with a different TB, based on sensing and resource selection procedure.","paragraph_zero_based":48301},{"literal_text_all_w_t_and_m_t":"sl-NRPSFCH-EUTRA-ThresRSRP-List","paragraph_zero_based":48302},{"literal_text_all_w_t_and_m_t":"Indicates a list of 64 thresholds from which a threshold should be selected based on the priority in the decoded EUTRA SCI and the priority in the NR SCI to be transmitted. A NR SL resource is excluded if the corresponding PSFCH transmission occasions overlap with resources indicated or reserved by the decoded EUTRA SCI in time domain and EUTRA PSSCH RSRP in the associated data resource is above the threshold.","paragraph_zero_based":48303},{"literal_text_all_w_t_and_m_t":"sl-NRPSSCH-EUTRA-ThresRSRP-List","paragraph_zero_based":48304},{"literal_text_all_w_t_and_m_t":"Indicates a list of 64 thresholds, and a threshold should be selected based on the priority in the decoded EUTRA SCI and the priority in the NR SCI to be transmitted. A NR SL resource is excluded if it is indicated or reserved by the decoded EUTRA SCI and EUTRA PSSCH RSRP in the associated data resource is above the threshold. If the field is present, the UE shall perform the dynamic co-channel coexistence of LTE sidelink and NR sidelink as specified in TS 38.214; otherwise it shall not perform it.","paragraph_zero_based":48305},{"literal_text_all_w_t_and_m_t":"sl-ResourceReservePeriodList","paragraph_zero_based":48306},{"literal_text_all_w_t_and_m_t":"Set of possible resource reservation period allowed in the resource pool in the unit of ms. Up to 16 values can be configured per resource pool. The value ms0 is always configured.","paragraph_zero_based":48307},{"literal_text_all_w_t_and_m_t":"sl-RS-ForSensing","paragraph_zero_based":48308},{"literal_text_all_w_t_and_m_t":"Indicates whether DMRS of PSCCH or PSSCH is used for L1 RSRP measurement in the sensing operation.","paragraph_zero_based":48309},{"literal_text_all_w_t_and_m_t":"sl-SensingWindow","paragraph_zero_based":48310},{"literal_text_all_w_t_and_m_t":"Parameter that indicates the start of the sensing window.","paragraph_zero_based":48311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["11023e734ecab43b43c2562d1f14e8e94d4ab5899d9d7fc47f1bafb9edad0bf7","e71372d9df0b70f1152c28dc665cb66ef68f49aeeab72dd45c6cb68a63d649a2","526017a8e24f96099f4b2e6dc544394d0cd1183d139461d7a2043df325f0e5df","da878d1e074e41601eaad3b0708d78abbb2652a9b0157a96fa6e96ba645bac05","4a6967abc04a3cc4d7c0876ef732b8e9152e9b07130c8d8b73e91d2a072da3d1","38ca9fbe32c8740adf88ee815e0e032bbdcf6f39d9e6ffccfb8c3f3585d908c3","b6c91831e2a845a49d89da41c580f296df8d61b8518bb41af9bd9f141eba63cc","884dcaca8b4104962985878c7feacf2e99b79f4bb955f4743dcac9e7ab183926","d7b9142f6dd3fc7b182117e78db788b8d4c819dbed1fec2bb8f76b69ba717c9c","976dc864003cdcba288370796e5454644ef78e259fa95b881e86a24cd3703319","017ca228a8133fd606fe551393b1e24a62f67acb920aac8903b8116795dd37b2","b3c0b3cfbf424d4b2bfed0881c33acb795479e195351397de536c08c06fac254","0818622e6c509d17cf0d37fae4396183913087fbced02e407b96981fedd54428","b4b22f354103f8ede72e247177850eeb90cf574cb17a6d2533032c32fb30fd6d","2a197f2c2050d7dada80d0a9270c3f99f9471f4e82c69e1f97fef3a6078540ab","b9d9079b6ef10834840ef44c1b6b11d11739c26ad24a5ce6b730368d0649741e","18c9f3650448daca0129c3d0c41228d02face47db951ec5af52d20b0229ff4e6","719df1c0f3d273dcb273957640d26bf1a10e728cd2d1e045495b06120ef0fbff","ae2c9a613aebbec92d5cbf3c1ab716dbc660e43cd87095786b483f3b6c84257b","f03268ed1403c33cf554fe708cbfefbb765035e19b87d5301a9e2fda4117ea09","8c18660f75882c4b72af8f123f923834a915628db8809c8f0b2e487421f8b227","201fd2b3713e2d8072205e7ed6fd10e5b8ec6a7509838e4b66a67137acab86d7","0db853e454c22494b036822b75288b797e9dc22e7ff6765cd93a2c11b9ddca38","5116868d8ce936c5b77bc4450f365ff66cabf91830574af7f149cc0c39a96e7b"],"paragraph_range_zero_based":[48288,48311],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p48288"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-SelectionWindowList","paragraph_zero_based":48312},{"literal_text_all_w_t_and_m_t":"Parameter that determines the end of the selection window in the resource selection for a TB with respect to priority indicated in SCI. Value n1 corresponds to 1*2µ, value n5 corresponds to 5*2µ, and so on, where µ = 0,1,2,3 refers to SCS 15,30,60,120 kHz respectively.","paragraph_zero_based":48313},{"literal_text_all_w_t_and_m_t":"sl-Thres-RSRP-List","paragraph_zero_based":48314},{"literal_text_all_w_t_and_m_t":"Indicates a list of 64 thresholds, and the threshold should be selected based on the priority in the decoded SCI and the priority in the SCI to be transmitted. A resource is excluded if it is indicated or reserved by a decoded SCI and PSSCH/PSCCH RSRP in the associated data resource is above a threshold.","paragraph_zero_based":48315},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48316},{"literal_text_all_w_t_and_m_t":"SL-PowerControl field descriptions","paragraph_zero_based":48317},{"literal_text_all_w_t_and_m_t":"sl-MaxTransPower","paragraph_zero_based":48318},{"literal_text_all_w_t_and_m_t":"Indicates the maximum value of the UE's sidelink transmission power on this resource pool when the sidelink transmission is performed only on this resource pool. The unit is dBm. If the sidelink transmission is PSFCH, and multiple resource pools are used, the maximum transmission power for PSFCH is configured as sum of fields sl-maxTransPower over multiple resource pools, as specified in TS 38.101-1 [15].","paragraph_zero_based":48319},{"literal_text_all_w_t_and_m_t":"sl-Alpha-PSSCH-PSCCH","paragraph_zero_based":48320},{"literal_text_all_w_t_and_m_t":"Indicates alpha value for sidelink pathloss based power control for PSCCH/PSSCH when sl-P0-PSSCH-PSCCH is configured. When the field is absent the UE applies the value 1. ","paragraph_zero_based":48321},{"literal_text_all_w_t_and_m_t":"sl-P0-PSSCH-PSCCH","paragraph_zero_based":48322},{"literal_text_all_w_t_and_m_t":"Indicates P0 value for sidelink pathloss based power control for PSCCH/PSSCH. If not configured, sidelink pathloss based power control is disabled for PSCCH/PSSCH. When sl-P0-PSSCH-PSCCH-r17 is configured, the UE ignores sl-P0-PSSCH-PSCCH-r16.","paragraph_zero_based":48323},{"literal_text_all_w_t_and_m_t":"dl-Alpha-PSSCH-PSCCH","paragraph_zero_based":48324},{"literal_text_all_w_t_and_m_t":"Indicates alpha value for downlink pathloss based power control for PSCCH/PSSCH when dl-P0-PSSCH-PSCCH is configured. When the field is absent the UE applies the value 1. ","paragraph_zero_based":48325},{"literal_text_all_w_t_and_m_t":"dl-P0-PSSCH-PSCCH","paragraph_zero_based":48326},{"literal_text_all_w_t_and_m_t":"Indicates P0 value for downlink pathloss based power control for PSCCH/PSSCH. If not configured, downlink pathloss based power control is disabled for PSCCH/PSSCH. When dl-P0-PSSCH-PSCCH-r17 is configured, the UE ignores dl-P0-PSSCH-PSCCH-r16.","paragraph_zero_based":48327},{"literal_text_all_w_t_and_m_t":"A Remote UE which is out of coverage, considers downlink pathloss based power control is disabled for PSCCH/PSSCH when dl-P0-PSSCH-PSCCH is configured.","paragraph_zero_based":48328},{"literal_text_all_w_t_and_m_t":"dl-Alpha-PSFCH","paragraph_zero_based":48329},{"literal_text_all_w_t_and_m_t":"Indicates alpha value for downlink pathloss based power control for PSFCH when dl-P0-PSFCH is configured. When the field is absent the UE applies the value 1. For resource pools configured with PSFCH resources overlapping in time, this field is either not configured in any of the resource pools or configured with the same value for all the resource pools.","paragraph_zero_based":48330},{"literal_text_all_w_t_and_m_t":"dl-P0-PSFCH","paragraph_zero_based":48331},{"literal_text_all_w_t_and_m_t":"Indicates P0 value for downlink pathloss based power control for PSFCH. If not configured, downlink pathloss based power control is disabled for PSFCH. When dl-P0-PSFCH-r17 is configured, the UE ignores dl-P0-PSFCH-r16. For resource pools configured with PSFCH resources overlapping in time, this field is either not configured in any of the resource pools or configured with the same value for all the resource pools.","paragraph_zero_based":48332},{"literal_text_all_w_t_and_m_t":"A Remote UE which is out of coverage, considers downlink pathloss based power control is disabled for PSFCH when dl-P0-PSFCH is configured.","paragraph_zero_based":48333},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48334},{"literal_text_all_w_t_and_m_t":"SL-MinMaxMCS-Config field descriptions","paragraph_zero_based":48335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["8ee631e57eae03c4c01f351672198a8f0ffc9bbca961b9767d89442b0c77d451","b6ed1ff3f04ae902d05e17b18cb9764f9d6b82fe0574b661baeb1f907a27ac66","3c01c6fb9add7e3029e31b27b79cc48353c2834e1f60c2662402f50fb9759703","540a7b798d11873ad50aa0520e68a9ee84f145049e7f42cbc279ab48ff9b52de","fb9d236f36060f3be67a05f54c4b67bfe5e5437c9d27822f647701eb04f936c7","cba1a6c5cb4dd851c0961dc5ac22883c4582c91517ca3fee94b8bdc60e82f9bd","b3847d86643b2e4c5ff2b0ea2f10f6eb34f60fc9b8807629ac8251ee6f0cf56f","842567a1b2b4ff03df1e67ad93eeaa95706fe57a380d45f84b6bd3a516e7a7c9","7e849923a1fb07556d54e0754af298a01d1b6ed16a95d7bc20849cb0583b0b96","962b3bd16a8a13b2be155f13914ac1960e29f406f6dcebd9cba1245b3b09441a","93bfc9f5fd98f58e13899237f68408a7a6749d5cccef553c9ecb4b3d69526570","4d663e3a8093180ed515c0478c75ec1bde577232356b8c9fd5a037ae89f1dcac","cb664ae6fa0c1cf425a6ac21c8536b46361db6f125c4be47579f657fb399ff33","c5951973407c5f65d2e945480eaa77a6f8eefdbea7563a1b9afcbfd9d39079ba","6eae43796f0892fc893fda92272d3e5035d4411b1884fae515a092a80762d21b","25f26ecffdbde037462d3a8f523869ee505aee2f80dbc3e2fdeac0a0b08aaf4d","4fef17b686426a99878c4fbc3826393e48fa615b60e42159a742f47d5ae805a8","ebbabbf91cf8b2efc3d41f09361dd8b179758c889545b106ddc9f9242c04544d","a53813c6850e7fa75ee8eaf76ea2e7aef4542e44a317f29ac6ddc04c17e2cf93","b22c3a5057ca3e20e1efcffc6af1ea0b48cbc4a5757a73ede3e97d432337ff1d","334956052d49414dfe2b5872e53302564524ed2cdfc213a86b3d9971a4e25d53","99d9a2ddc4bbd6c9f8cc8448f624fea0161a71706bc6db599af893f0842a3883","ea654b80385085f322f05aee01d191012d6594c84abe844c5e4ef8ac30601f2c","5628add25206d0807269e1b0b8959dee3666e3dafa78eea7be75e4bb120d6bce"],"paragraph_range_zero_based":[48312,48335],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p48312"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-MaxMCS-PSSCH","paragraph_zero_based":48336},{"literal_text_all_w_t_and_m_t":"Indicates the maximum MCS value when using the associated MCS table. If no MCS is configured, UE autonomously selects MCS from the full range of values.","paragraph_zero_based":48337},{"literal_text_all_w_t_and_m_t":"sl-MinMCS-PSSCH","paragraph_zero_based":48338},{"literal_text_all_w_t_and_m_t":"Indicates the minimum MCS value when using the associated MCS table. If no MCS is configured, UE autonomously selects MCS from the full range of values.","paragraph_zero_based":48339},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48340},{"literal_text_all_w_t_and_m_t":"SL-CPE-StartingPositionsPSCCH-PSSCH field descriptions","paragraph_zero_based":48341},{"literal_text_all_w_t_and_m_t":"sl-Priority","paragraph_zero_based":48342},{"literal_text_all_w_t_and_m_t":"Indicates L1 priority of PSSCH.","paragraph_zero_based":48343},{"literal_text_all_w_t_and_m_t":"sl-CPE-StartingPositions","paragraph_zero_based":48344},{"literal_text_all_w_t_and_m_t":"Indicates a set of candidate CPE starting positions specified in Table 5.3.1-3 [16, TS38.211],","paragraph_zero_based":48345},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48346},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":48347},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":48348},{"literal_text_all_w_t_and_m_t":"A2X","paragraph_zero_based":48349},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in sl-BWP-PoolConfigA2X and sl-BWP-PoolConfigCommonA2X; otherwise the field is optionally present, Need M.","paragraph_zero_based":48350},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48351},{"literal_text_all_w_t_and_m_t":"–SL-RLC-BearerConfig","paragraph_zero_based":48352},{"literal_text_all_w_t_and_m_t":"The IE SL-RLC-BearerConfig specifies the SL RLC bearer configuration information for NR sidelink communication.","paragraph_zero_based":48353},{"literal_text_all_w_t_and_m_t":"SL-RLC-BearerConfig information element","paragraph_zero_based":48354},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":48355},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RLC-BEARERCONFIG-START","paragraph_zero_based":48356},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48357},{"literal_text_all_w_t_and_m_t":"SL-RLC-BearerConfig-r16 ::=                   SEQUENCE {","paragraph_zero_based":48358},{"literal_text_all_w_t_and_m_t":"    sl-RLC-BearerConfigIndex-r16                  SL-RLC-BearerConfigIndex-r16,","paragraph_zero_based":48359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["514caaf8f27cb793b9655d276f7ecab9b87a28470adb8913e146430d1724b8bf","8225d4b42eecd7926fff9613901cc1e3f109c93409a2235dcddbf6f98be93834","a9aaaa8b53fcc5f6202011a042aa7b03029b4de6034d17d7a39a44103daf2ab9","524bd1fc51bf3fbada36f0dcc2fb3646261701ff5869b358bfa5ffbcfc356437","002e4deb5dc9904ed78d0ea98d0ccf7ab04f73ad74255e8b5f601632cad5d744","197385c34922a1987fd1c4436fb105ae4066694739050ae0dd6f5b1b38042969","ac5841feba2bcfe6c624774fe6ec7a478a6ab4a5e5d2983337b5dcf02092c075","59bb5cc3b993395a1eb9c63acb667fbd5afcac85b0a0e54ae83fed0e5f846e51","81dc2d5e7bb6d46dddeea9df92d1e6e7f43558f452d4c78ea814c06959acdc96","44afb45951758c12e1c228d14eae7a923f0441730adbd9243d116b7a523fe550","f3a2c5921555ace6f1c9d184aa9acdd2bbf24270fe8c0777cf572cbab9919264","92889ce63d1542de1616640ec4505a48a8b1719d6620dbf8a80a5be85e74ad20","b3964a15781ebcede3c70ae05623612154d99b9