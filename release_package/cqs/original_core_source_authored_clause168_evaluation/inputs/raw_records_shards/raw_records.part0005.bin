ph_zero_based":52889},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":52890},{"literal_text_all_w_t_and_m_t":"Editor's Note: The mapping configuration (from e2e SLRB to RLC channel) is needed in pre-configuration. The existing table format is used as a baseline, subject to discussion during maintenance.","paragraph_zero_based":52891},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":52892},{"literal_text_all_w_t_and_m_t":"SL-PreconfigurationNR field descriptions","paragraph_zero_based":52893},{"literal_text_all_w_t_and_m_t":"sl-DRX-PreConfig-GC-BC","paragraph_zero_based":52894},{"literal_text_all_w_t_and_m_t":"This field indicates the sidelink DRX configuration for groupcast and broadcast communication, as specified in TS 38.321 [3].","paragraph_zero_based":52895}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["e2a4b0e02ede1b3545a0e4221c04bd34472c68db8da5ed274b30decb46f7b4c6","5bc43d649ae7d1d391a9e4191747d06b13afab918013cc12509a27cc7bab7cec","b284da74d66adb16342c3c45524d92566518446d634effafc6bb4cfa5b8b1c55","6a0f00b910b8312e10829d23b7e07599798e0e8e70e95d5f081d333a4253cd71","f31bc02047f12cf2e058a919015eec0ca545f9048cd13214c4375d579898d599","759fc1cd8f6b4375bdadc017746a5594b1d7e1ff5d72fc33baff1c4aa8a77bda","1e855e4605625bbd3ac8f0a181fdcb92f1c372d85a9c3a9a725dc30821171784","1928772d0decd7eb0967b35b7036cce5cfd12f5eda62d52d9b96dc82f5a645b6","7e6608599ee7239ca0fd4fdb9676bd56ae53e998e0150c780083ab9967090bcc","15ba5537f3e179782bd7d352a3c5c8c2628df3f6870dd84fd6f878625c1648ec","4cde3088ebd311b0793eb61ac04ada14ec4e693e22c50d0fe872a218ff572aaf","bc8780af7e0b5e1aa1508a62db642d940cdd81a6c245718d32f1854e6227b398","e5bc60c852f001c939d64ec2ee76cdccba365b79ec720c14278bbf19a9a1ff4b","ba8438ddd76a20c811876a6c856f401f4409361028bcdf50f8e1248e1dc15d4e","193d1f6a832e3825bf59768833971ef8762b34d0450a1463f5cd858b621ef0f8","684a150bd1fd345a92c263084fe56f642af0eb15aad4b73eef799cec71fba773","65478476979b7ed9b3f6da51f876d8ae6cb9b212bb818d624676b306d95983a9","ca674b67f5b49d3106c89aa79ca47e20ea74251ca758920999b83d6ef9492e3c","5c01ccd2b9a223cb8f9825ce7e9f707572980dccae248edbf7bd36777308f562","175bf398a4f90a123650b70ce1c0ec36556eb67e6218d047c7e564ec6ad7c12e","90be04033080145d611f4c53b524408ca99b507e44608336acf09a51d944231e","6231ab69aa38375c19fd7dd33516b3aeb985d72af1aac3b3caaa644aaa06b3fc","36ee700fc0d13871760fcf12cc854a2a9f70cd648529a66f9f582687b033ca98","a4598e7fdce0756ab53ed1b78ef16b20f753f92dffd113a722bbe3b2ff6c2c2a"],"paragraph_range_zero_based":[52872,52895],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p52872"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-OffsetDFN","paragraph_zero_based":52896},{"literal_text_all_w_t_and_m_t":"Indicates the timing offset for the UE to determine DFN timing when GNSS is used for timing reference. Value 1 corresponds to 0.001 milliseconds, value 2 corresponds to 0.002 milliseconds, and so on. If the field is absent, no offset is applied.","paragraph_zero_based":52897},{"literal_text_all_w_t_and_m_t":"sl-PosPreconfigFreqInfoList","paragraph_zero_based":52898},{"literal_text_all_w_t_and_m_t":"This field indicates the NR sidelink positioning configuration for a set of carrier frequency(ies). In this release, only one SL-FreqConfig can be configured in the list.","paragraph_zero_based":52899},{"literal_text_all_w_t_and_m_t":"sl-PreconfigDiscConfig","paragraph_zero_based":52900},{"literal_text_all_w_t_and_m_t":"This field indicates the configuration for discovery message transmission used by NR sidelink U2N Remote UE, used by NR sidelink U2U Relay UE or used by NR sidelink U2U Remote UE. ","paragraph_zero_based":52901},{"literal_text_all_w_t_and_m_t":"sl-PreconfigEUTRA-AnchorCarrierFreqList","paragraph_zero_based":52902},{"literal_text_all_w_t_and_m_t":"This field indicates the EUTRA anchor carrier frequency list, which can provide the NR sidelink communication configuration.","paragraph_zero_based":52903},{"literal_text_all_w_t_and_m_t":"sl-PreconfigFreqInfoList, sl-PreconfigFreqInfoListSizeExt","paragraph_zero_based":52904},{"literal_text_all_w_t_and_m_t":"This field indicates the NR sidelink communication and/ or NR sidelink discovery configuration some carrier frequency(ies). In this release, only one SL-FreqConfig can be configured in sl-PreconfigFreqInfoList. More entries of SL-FreqConfig can be configured in sl-PreconfigFreqInfoListSizeExt..","paragraph_zero_based":52905},{"literal_text_all_w_t_and_m_t":"sl-PreconfigNR-AnchorCarrierFreqList","paragraph_zero_based":52906},{"literal_text_all_w_t_and_m_t":"This field indicates the NR anchor carrier frequency list, which can provide the NR sidelink communication configuration.","paragraph_zero_based":52907},{"literal_text_all_w_t_and_m_t":"sl-RadioBearerPreConfigList","paragraph_zero_based":52908},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple sidelink radio bearer configurations.","paragraph_zero_based":52909},{"literal_text_all_w_t_and_m_t":"sl-RLC-BearerPreConfigList, sl-RLC-BearerPreConfigListSizeExt","paragraph_zero_based":52910},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple sidelink RLC bearer configurations.","paragraph_zero_based":52911},{"literal_text_all_w_t_and_m_t":"sl-RoHC-Profiles","paragraph_zero_based":52912},{"literal_text_all_w_t_and_m_t":"This field indicates the supported RoHC profiles for NR sidelink communications.","paragraph_zero_based":52913},{"literal_text_all_w_t_and_m_t":"sl-SSB-PriorityNR","paragraph_zero_based":52914},{"literal_text_all_w_t_and_m_t":"This field indicates the priority of NR sidelink SSB transmission and reception.","paragraph_zero_based":52915},{"literal_text_all_w_t_and_m_t":"sl-SyncFreqList","paragraph_zero_based":52916},{"literal_text_all_w_t_and_m_t":"Indicates a list of candidate carrier frequencies that can be used for the synchronisation of NR sidelink communication. For SL-Freq-Id-r16, the value 1 corresponds to the frequency of first entry in sl-PreconfigFreqInfoList, the value 2 corresponds to the frequency of first entry in sl-PreconfigFreqInfoListSizeExt, the value 3 corresponds to the frequency of second entry in sl-PreconfigFreqInfoListSizeExt and so on.","paragraph_zero_based":52917},{"literal_text_all_w_t_and_m_t":"sl-SyncTxMultiFreq","paragraph_zero_based":52918},{"literal_text_all_w_t_and_m_t":"Indicates that the UE transmits S-SSB on multiple carrier frequencies for NR sidelink communication. If this field is absent, the UE transmits S-SSB only on the synchronisation carrier frequency.","paragraph_zero_based":52919}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["6bd8c53be652ed1fa6f6a7f36711165f8d50c33390de6503e35277fed2bb222a","882464ba0141719cf00867367b79374b5c95e240d230afbc0b4d1259938658a1","d8672ea4c1cebd3b95aee2d51a8ec4c42eb720f9de9e320c8c80dff9beee5438","4641a2d477d146e0a31262634a0d403b393539c318969bc9ea440654c38341a2","4845d0120ddc24be0cdeaa45b02f5fe069d6a733702e0a98224f374c6a99a022","aef62a28a63088e6cf079a861994b5b08c1258bfd1ef3bb4b7e3a82fe26cf769","c3b08dca19aedabf9c9713643bb085b65f57f4f53fe8670654a351673bdcc8bc","d9e502399847db98ebc2a5a9765487ace23239ce3fdcf65fe378e3d3b65b9943","1acaae55e74c85a9a7d9000e0749dbde2456d864a15aa02225a9dc509716e731","1d5c7156583a810173ff756b691ae270c4fd9b7735f3a9b3b0c190327ec6d5a6","c79989b9f129096afaadebbcd06b6c9208a2d85b67e39151fd5d70cee5d5903c","d7143024482962db3d8636ce8d07272eb7028e4e6ca6e8121caf5609f9c3830b","87211f9109e4cdebad77ac881eb5e7033195d6c70247359865a82c8e412f501a","ae197a1eb8da1cfa5ebf0e55e49ea473e3ceaa0c6e294054ce03955e6680e569","d2fadf954bc588b9d5b7af81fe002db71a3d9e8f3a9b9cbd8dc11e64427e243a","a24fd44021f44dfb7b7bbdb27862481ed4aa55a7020085d74af5669386d3cb08","a0112d439e3572c8439eadc0e0147416fd411c542110ba1b775a01d080fc8587","d4470807c2c440219dad66184964d99cdbcf397125a034f39f7b75b27f97e4eb","038b6e65ae4542ecc730531ecdf213ddceef604075f3d380b972545e1d52a352","de8abab30f2145a2b5fc02f5d6e8c2fd1469170128a13a683b1c204f7d01ba99","2d3375f14bfe0f5b2a7c90d2a00e5334da28ebb0bef5ffbe9f944a9ba1a00552","57cb49ed0a771b76893112ff83de08c6df6f85bfbf0f9f1c7dc5bf0925007093","4c02687507336bb2b0c4553d208724c7b9