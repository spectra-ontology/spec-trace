{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>if validatedMeasurementsReq is included in the RRCResume and measIdleValidityDuration is included in VarEnhMeasIdleConfig;","paragraph_zero_based":1224},{"literal_text_all_w_t_and_m_t":"5>set the measResultIdleEUTRA in the RRCResumeComplete message to the value of measReportIdleEUTRA in the VarMeasIdleReport for any valid measurement results, if available, and set validityStatus to the value of measIdleValidityDuration in VarEnhMeasIdleConfig;","paragraph_zero_based":1225},{"literal_text_all_w_t_and_m_t":"5>set the measResultIdleNR in the RRCResumeComplete message to the value of measReportIdleNR in the VarMeasIdleReport for any valid measurement results, if available, and set validityStatus to the value of measIdleValidityDuration in VarEnhMeasIdleConfig;","paragraph_zero_based":1226},{"literal_text_all_w_t_and_m_t":"5>discard the VarMeasIdleReport upon successful delivery of the RRCResumeComplete message is confirmed by lower layers;","paragraph_zero_based":1227},{"literal_text_all_w_t_and_m_t":"5>remove the measIdleValidityDuration in VarEnhMeasIdleConfig;","paragraph_zero_based":1228},{"literal_text_all_w_t_and_m_t":"4>else:","paragraph_zero_based":1229},{"literal_text_all_w_t_and_m_t":"5>set the measResultIdleEUTRA in the RRCResumeComplete message to the value of measReportIdleEUTRA in the VarMeasIdleReport, if available;","paragraph_zero_based":1230},{"literal_text_all_w_t_and_m_t":"5>set the measResultIdleNR in the RRCResumeComplete message to the value of measReportIdleNR in the VarMeasIdleReport, if available;","paragraph_zero_based":1231},{"literal_text_all_w_t_and_m_t":"5>discard the VarMeasIdleReport upon successful delivery of the RRCResumeComplete message is confirmed by lower layers;","paragraph_zero_based":1232},{"literal_text_all_w_t_and_m_t":"5>remove the measIdleValidityDuration in VarEnhMeasIdleConfig, if stored;","paragraph_zero_based":1233},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":1234},{"literal_text_all_w_t_and_m_t":"4>if the SIB1 contains idleModeMeasurementsNR and the UE has NR idle/inactive measurement information concerning cells other than the PCell available in VarMeasIdleReport; or","paragraph_zero_based":1235},{"literal_text_all_w_t_and_m_t":"4>if the SIB1 contains idleModeMeasurementsEUTRA and the UE has E-UTRA idle/inactive measurement information available in VarMeasIdleReport:","paragraph_zero_based":1236},{"literal_text_all_w_t_and_m_t":"5>include the idleMeasAvailable;","paragraph_zero_based":1237},{"literal_text_all_w_t_and_m_t":"2>if the reselectionMeasurementReq is included in the RRCResume message:","paragraph_zero_based":1238},{"literal_text_all_w_t_and_m_t":"3> if validatedMeasurementsReq is included in the RRCResume and measReselectionValidityDuration is included in VarMeasReselectionConfig:","paragraph_zero_based":1239},{"literal_text_all_w_t_and_m_t":"4>if measReselectionCarrierListNR is present in VarMeasReselectionConfig:","paragraph_zero_based":1240},{"literal_text_all_w_t_and_m_t":"5>if the UE has valid cell reselection measurements results for any frequency listed in measReselectionCarrierListNR in VarMeasRelectionConfig:","paragraph_zero_based":1241},{"literal_text_all_w_t_and_m_t":"6>set the measResultReselectionNR in the RRCResumeComplete message to the valid NR measurement results, if available for any frequency listed in measReselectionCarrierListNR in VarMeasReselectionConfig and set validityStatus to the value of measReselectionValidityDuration in VarMeasReselectionConfig;","paragraph_zero_based":1242},{"literal_text_all_w_t_and_m_t":"4>else:","paragraph_zero_based":1243},{"literal_text_all_w_t_and_m_t":"5>if the UE has valid NR cell reselection measurements results:","paragraph_zero_based":1244},{"literal_text_all_w_t_and_m_t":"6>set the measResultReselectionNR in the RRCResumeComplete message to any available valid NR measurement results, if available, and set validityStatus to the value of measReselectionValidityDuration in VarMeasReselectionConfig;","paragraph_zero_based":1245},{"literal_text_all_w_t_and_m_t":"3> else:","paragraph_zero_based":1246},{"literal_text_all_w_t_and_m_t":"4>if measReselectionCarrierListNR is present in VarMeasReselectionConfig:","paragraph_zero_based":1247}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["5ac0d91991bef38b007e1a24ebc7658fd876b62c482591ff4cf3b808eff62d18","e0cd781fc2540bc44401cead73605e36614f31731861426174d306845446f3b5","0e638095edfc6bea4261a8a66d8ee11bbc5388202a582bc4f9c680bcc9b78ce0","47e3c36148d5bbcef8dac9a544e1a18f036e8e38d3d7855f1cff190d46dffaa1","63455f5923d33792ca9f16dcb598b6c38123b6701daf32b1c55baea06eccd874","0dabb35664821cb5398f6ffa799e5f6bb20279ecba9fed44cdd387d07e03efe2","39085e2751f253261fa5faca81ca0ef448091f088187c7b0fe7d9838d844bc30","2a8c2af0710fcd9ea75b6ff17d34cbc29baa62614e16c9ac49432b39b8fcab48","a586cb33c8dc198c4b133bae2b08fc8316ea0ce4817957ddbf33fda6dbfac16c","710df368c99c15fe4c3ec59b6e5263b7eb68d6451529853e98fbe166cb69facf","0998282cabb2643ca3ac62c4f6c730a3cd58b73349be5998ec8a3361711913c3","1bdf505b5742a9d00b430b6654815e6087e3cca1b90648f97c363b92c76a12eb","3e4733f465136c29ea8e1077b6c2f8726fe411f6cddaa32fe2de8f072713c089","fdca79a185e68e387e05540b8d27941d425d5086d6906b29558519a904054a34","dd92214fa27ca478a3e75d8136f5067491461a95e2ca623accc26eec8d05c299","0b3ff15f518407dc157a13202461eccc5df6ea460c1aecf2b6ebc1cd79f2b44c","77b4ae26580c356cf5a0d477f17d1048f5bb4fd1a0ba5f6e69b797afdc56e226","56a35b98859469d3643fb607d9411186741c9218a645edaf3235080152c4d41b","58bfdc3fce6c074e425f5973d2e5dbbb1a0167e263ecd0779e57967ab0996cb2","80940f70d69baec3e374b20c06e9db721abf225473d1af7f936019084a004803","0cc9a20feab381a92414525cda54199f8a25739ca9b96a9bc7bb157cc5778e5f","fca3ac5eb43ec3c5bd318380af7fa50435b516d759bb68ab2861977298c21ee3","80a11a3e86a27c5378dad3b36993b3381f511b75ed4d342a59182e4dd9109ecc","8f798e3cd6521cb5e4cdf7e25e2a43213e71d7abc76b7b1736ad857460e5f708"],"paragraph_range_zero_based":[1224,1247],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p1224"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5>if the UE has cell reselection measurements results for any frequency listed in measReselectionCarrierListNR in VarMeasRelectionConfig:","paragraph_zero_based":1248},{"literal_text_all_w_t_and_m_t":"6>set the measResultReselectionNR in the RRCResumeComplete message to the NR measurement results, if available for any frequency listed in measReselectionCarrierListNR in VarMeasReselectionConfig;","paragraph_zero_based":1249},{"literal_text_all_w_t_and_m_t":"4>else:","paragraph_zero_based":1250},{"literal_text_all_w_t_and_m_t":"5>if the UE has NR cell reselection measurements results:","paragraph_zero_based":1251},{"literal_text_all_w_t_and_m_t":"6>set the measResultReselectionNR in the RRCResumeComplete message to any available NR measurement results, if available;","paragraph_zero_based":1252},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":1253},{"literal_text_all_w_t_and_m_t":"3>if the SIB1 contains reselectionMeasurementsNR:","paragraph_zero_based":1254},{"literal_text_all_w_t_and_m_t":"4>if measReselectionCarrierListNR is present in VarMeasReselectionConfig and the UE has NR reselection measurements available for any frequency listed in measReselectionCarrierListNR in VarMeasReselectionConfig; or","paragraph_zero_based":1255},{"literal_text_all_w_t_and_m_t":"4>if measReselectionCarrierListNR is not present in VarMeasReselectionConfig and if the UE has NR reselection measurements available:","paragraph_zero_based":1256},{"literal_text_all_w_t_and_m_t":"5>include the reselectionMeasAvailable;","paragraph_zero_based":1257},{"literal_text_all_w_t_and_m_t":"2>if the RRCResume message includes mrdc-SecondaryCellGroup set to eutra-SCG:","paragraph_zero_based":1258},{"literal_text_all_w_t_and_m_t":"3>include in the eutra-SCG-Response the E-UTRA RRCConnectionReconfigurationComplete message in accordance with TS 36.331 [10] clause 5.3.5.3;","paragraph_zero_based":1259},{"literal_text_all_w_t_and_m_t":"2>if the RRCResume message includes mrdc-SecondaryCellGroup set to nr-SCG:","paragraph_zero_based":1260},{"literal_text_all_w_t_and_m_t":"3>include in the nr-SCG-Response the SCG RRCReconfigurationComplete message;","paragraph_zero_based":1261},{"literal_text_all_w_t_and_m_t":"2>if the UE has logged measurements available for NR and if the RPLMN is included in plmn-IdentityList stored in VarLogMeasReport; or","paragraph_zero_based":1262},{"literal_text_all_w_t_and_m_t":"2>if the UE has logged measurements available for NR and if the current registered SNPN identity is included in snpn-ConfigID-List stored in VarLogMeasReport:","paragraph_zero_based":1263},{"literal_text_all_w_t_and_m_t":"3>include the logMeasAvailable in the RRCResumeComplete message;","paragraph_zero_based":1264},{"literal_text_all_w_t_and_m_t":"3>if Bluetooth measurement results are included in the logged measurements the UE has available for NR:","paragraph_zero_based":1265},{"literal_text_all_w_t_and_m_t":"4>include the logMeasAvailableBT in the RRCResumeComplete message;","paragraph_zero_based":1266},{"literal_text_all_w_t_and_m_t":"3>if WLAN measurement results are included in the logged measurements the UE has available for NR:","paragraph_zero_based":1267},{"literal_text_all_w_t_and_m_t":"4>include the logMeasAvailableWLAN in the RRCResumeComplete message;","paragraph_zero_based":1268},{"literal_text_all_w_t_and_m_t":"2>if the sigLoggedMeasType in VarLogMeasReport is included; or","paragraph_zero_based":1269},{"literal_text_all_w_t_and_m_t":"2>if the UE supports the override protection of the signalling based logged MDT for inter-RAT (i.e. LTE to NR), and if the sigLoggedMeasType in VarLogMeasReport of TS 36.331 [10] is included:","paragraph_zero_based":1270},{"literal_text_all_w_t_and_m_t":"3>if T330 timer is running (associated to the logged measurement configuration for NR or for LTE):","paragraph_zero_based":1271}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["20f5ba1d4ddfad3cc3fffb168e2a4c0d6a42fe918a0c6052dd2d48ce4a165e36","37919b2309caf6dcd7689f976c3b37fd5f3f82cbae14b00004638dcc5598ce16","2c3e562988414b3ff4ff8cea79592df37dbd1bf05b893c084c067a589fa6b178","3b73d969218663012341ece7944ec66eaa4549e55c037f1cdf81fc1961a413c7","4c662eebcde26caa08d1a0775d5f448418bf8bf3d62e405ac030314ae7c93e0d","617534c9cce321205a827c1e6f98143492043519fbc893af5fe94d71e21d7eb4","c75f24bd0821f35a64f4d6c54920b9b9864ad9b5435b5ffa2a72df24149c7ee3","4331220bdeeec7131f19acb0a746bfd26efa8df4f7a4e75f2613f5f9c8ae1c56","e949dfe3e87b177dab99b2099a373b0b9049b1f94d385f5ea034beaa032e7959","4057fe9babb2bb6fcb085cff487ee2256568f5913a7273c306dbd50adf637526","cf1ba81c22b5fbe5aa40b07f1d667e239fea869a508bbe0389eb9ceceb08cd2f","3e91aca1d09d39346082e8b985ded030ca445b524c9e24595698ef27cb26395a","d97b6b6443d017f2dd36ffbb69acb30f6e9e2ae198ab76b997f59e3f8c0ef60e","b3f37642f2aba07ba52244a4f19e1e46399e6e7ea642c0e1a638bde1136f8159","c51b4794f82ba3ff4103a81d1ddadef14472658c023ee0fbeefbc91930a1bffd","5e871f6da9341185769660c8118a47e145a53e9963e1bfe7202136ee67cc68c3","561a0b13d32d8cf7f6db30cf79b858f48e193e5600e765327e9283f124e6673b","1f6ed94857d58929b8b451ddd14dfca19a2266f93b919c9f57719b137c5c69cd","621d42fc07ed6953bb099743ec2f46ce9c9962957981895de19f7649f50f1d30","c41ad03955c554995b5c7ffa64db74052b2c63522acf9a5d5945029ef7e93898","5f51db4f03867c67e06c910637bca5f88a2ae4dcdfb58baf82a8d69eade6428f","4d1e1c03128750b28bb7094c90b25e1ecf798d14c1286b2820333936a6c4ec5c","de8d48516f80921b1c5bb3ca1a1d365276b58c0014c43b89d4cdbad8d26aecf8","6d8d77fdf75e5d5fbeb9465a4052f66b211250e7ab079fb42f13d5c58471dc3d"],"paragraph_range_zero_based":[1248,1271],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p1248"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>set sigLogMeasConfigAvailable to true in the RRCResumeComplete message;","paragraph_zero_based":1272},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":1273},{"literal_text_all_w_t_and_m_t":"4>if the UE has logged measurements in VarLogMeasReport or in VarLogMeasReport of TS 36.331 [10]:","paragraph_zero_based":1274},{"literal_text_all_w_t_and_m_t":"5>set sigLogMeasConfigAvailable to false in the RRCResumeComplete message;","paragraph_zero_based":1275},{"literal_text_all_w_t_and_m_t":"2>if the UE has connection establishment failure or connection resume failure information available in VarConnEstFailReport or VarConnEstFailReportList and if the RPLMN is equal to plmn-Identity stored in VarConnEstFailReport or in at least one of the entries of VarConnEstFailReportList; or","paragraph_zero_based":1276},{"literal_text_all_w_t_and_m_t":"2>if the UE has connection establishment failure information or connection resume failure information available in VarConnEstFailReport or VarConnEstFailReportList and if the registered SNPN identity is equal to snpn-Identity in networkIdentity stored in VarConnEstFailReport or any entry of VarConnEstFailReportList:","paragraph_zero_based":1277},{"literal_text_all_w_t_and_m_t":"3>include connEstFailInfoAvailable in the RRCResumeComplete message;","paragraph_zero_based":1278},{"literal_text_all_w_t_and_m_t":"2>if the UE has radio link failure or handover failure information available in VarRLF-Report and if the RPLMN is included in plmn-IdentityList stored in VarRLF-Report; or","paragraph_zero_based":1279},{"literal_text_all_w_t_and_m_t":"2>if the UE has radio link failure or handover failure information available in VarRLF-Report of TS 36.331 [10] and if the UE is capable of cross-RAT RLF reporting and if the RPLMN is included in plmn-IdentityList stored in VarRLF-Report of TS 36.331 [10]; or","paragraph_zero_based":1280},{"literal_text_all_w_t_and_m_t":"2>if the UE has radio link failure or handover failure information available in VarRLF-Report and if the current registered SNPN identity are included in snpn-IdentityList stored in VarRLF-Report; or","paragraph_zero_based":1281},{"literal_text_all_w_t_and_m_t":"3>include rlf-InfoAvailable in the RRCResumeComplete message;","paragraph_zero_based":1282},{"literal_text_all_w_t_and_m_t":"2>if the UE has successful PSCell change or addition related information available in VarSuccessPSCell-Report and if the RPLMN is included in plmn-IdentityList stored in VarSuccessPSCell-Report; or","paragraph_zero_based":1283},{"literal_text_all_w_t_and_m_t":"2>if the UE has successful PSCell change or addition information available in VarSuccessPSCell-Report and if the current registered SNPN identity is included in snpn-IdentityList stored in the VarSuccessPSCell-Report:","paragraph_zero_based":1284},{"literal_text_all_w_t_and_m_t":"3>include successPSCell-InfoAvailable in the RRCResumeComplete message;","paragraph_zero_based":1285},{"literal_text_all_w_t_and_m_t":"2>if the UE has successful handover information available in VarSuccessHO-Report and if the RPLMN is included in plmn-IdentityList stored in VarSuccessHO-Report; or","paragraph_zero_based":1286},{"literal_text_all_w_t_and_m_t":"2>if the UE has successful handover information available in VarSuccessHO-Report and if the current registered SNPN identity is included in snpn-IdentityList stored in the VarSuccessHO-Report:","paragraph_zero_based":1287},{"literal_text_all_w_t_and_m_t":"3>include successHO-InfoAvailable in the RRCResumeComplete message;","paragraph_zero_based":1288},{"literal_text_all_w_t_and_m_t":"2>if the UE supports storage of mobility history information and the UE has mobility history information available in VarMobilityHistoryReport:","paragraph_zero_based":1289},{"literal_text_all_w_t_and_m_t":"3>include the mobilityHistoryAvail in the RRCResumeComplete message;","paragraph_zero_based":1290},{"literal_text_all_w_t_and_m_t":"2>if speedStateReselectionPars is configured in the SIB2:","paragraph_zero_based":1291},{"literal_text_all_w_t_and_m_t":"3>include the mobilityState in the RRCResumeComplete message and set it to the mobility state (as specified in TS 38.304 [20]) of the UE just prior to entering RRC_CONNECTED state;","paragraph_zero_based":1292},{"literal_text_all_w_t_and_m_t":"2>if the UE has at least one stored application layer measurement configuration with appLayerIdleInactiveConfig configured:","paragraph_zero_based":1293},{"literal_text_all_w_t_and_m_t":"3>include measConfigReportAppLayerAvailable in the RRCResumeComplete message;","paragraph_zero_based":1294},{"literal_text_all_w_t_and_m_t":"2>if the UE is configured to provide the measurement gap requirement information of NR target bands:","paragraph_zero_based":1295}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["1f673162fee37a4e55769b8c219c88f75f5df3c9ae65883468f05b15d6232715","58c0033a4ff190c1e98a99d0399d51d40f334cf3b6440879901d01c0d02d5940","9700b961231842f61cca8d391001a10d717cc69a795f6f8c3ae25e125005d1eb","c9a9f6404b806f7af2e9808750305e85d2f5d781ab7148da632d22e87d8e9ff8","7b4888f625e542cfd03d756a02b3ed6703359c9dd636a13e8d5df75281ca0eca","5a0b973acccd62c69abbedff886c7bb75f7b379f2e84b8450c9cb5ecfb6914eb","3cd62d7ed98b5aec06c126f8bd21845b5abea7ecd2a5ce531eb2b1d4cd226237","d03fa9d71a887e2ec554160958635488a1aa097020d0002b021f9f0cbaf9bf37","2b91fc19368a41822f4c2b746949de55d4fc4bdfb3bc95c443425cf70feda74c","6d155b4fc995de78d97cf5f777bdfd57ba1a106d1cd250807d3ade92a2187fd0","a721efe8b3405914190ca33cde41320a2e4ada0dd06989a0a1229193e0117742","5ee6305a31cd93816150f50841d8eb5213b6d6bf9bd4b80670fa3f815b613279","6d2b2d5d54c9cba571dfd2b8649133ca86791df12cec1be2dcfdfd769942c37c","dbb4cf1220b0742df13c8a41668fa6882f13b9dde417c0cec5fda5619f02c441","abf22b4c2091a277e812e5fcd4e62e9cc5de649c405c474c5ca660ea57bbb8ee","1fd36fdd00b0bfaf3bf3c2abe5c202e282e0862b40a5f0c51ff0208352ef80c7","1bc798ddd7175b776277455e0ab90e5519c6ead04afe7863ff895a702850a226","860f0f0cad5d2a06f921b5595c9d10db836169c91e53df3fa1ed79b06a4ecfb6","cc19057dcfee3003c1a5aeae9c75e7ec676855a5162524bf7052dff183c61bb8","de47b4aaa3a1ee2b0730965d15462e76dd79e4ead60c1fd1b5b744ba9f3231c5","b27ca9b3e24359ea0f960d5a9a02e912bbfa57fe0a101a7363d4f1d5a701ff65","605244916c2007250d4ef46c8100ccc2a5b457983f10295f45abbdf2102fcf7d","2e12892e977ebc6a2d76e834e1d707a62be83c6f4084a0b68d341bfac05febfd","43ce00de5e9bce4f7b299a69700946413d9f67f5f3a1a7ecc9506ca20beb14d3"],"paragraph_range_zero_based":[1272,1295],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p1272"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>include the NeedForGapsInfoNR and set the contents as follows:","paragraph_zero_based":1296},{"literal_text_all_w_t_and_m_t":"4> include intraFreq-needForGap and set the gap requirement information of intra-frequency measurement for each NR serving cell;","paragraph_zero_based":1297},{"literal_text_all_w_t_and_m_t":"4>if requestedTargetBandFilterNR is configured, for each supported NR band that is also included in requestedTargetBandFilterNR, include an entry in interFreq-needForGap and set the gap requirement information for that band; otherwise, include an entry in interFreq-needForGap and set the corresponding gap requirement information for each supported NR band;","paragraph_zero_based":1298},{"literal_text_all_w_t_and_m_t":"3>if the needForInterruptionConfigNR is enabled:","paragraph_zero_based":1299},{"literal_text_all_w_t_and_m_t":"4>include the needForInterruptionInfoNR and set the contents as follows:","paragraph_zero_based":1300},{"literal_text_all_w_t_and_m_t":"5>include intraFreq-needForInterruption with the same number of entries, and listed in the same order, as in intraFreq-needForGap;","paragraph_zero_based":1301},{"literal_text_all_w_t_and_m_t":"5> for each entry in intraFreq-needForInterruption:","paragraph_zero_based":1302},{"literal_text_all_w_t_and_m_t":"6>include interruptionIndication and set the interruption requirement information if the corresponding entry in intraFreq-needForGap is set to no-gap;","paragraph_zero_based":1303},{"literal_text_all_w_t_and_m_t":"5>include interFreq-needForInterruption with the same number of entries, and listed in the same order, as in interFreq-needForGap;","paragraph_zero_based":1304},{"literal_text_all_w_t_and_m_t":"5>for each entry in interFreq-needForInterruption:","paragraph_zero_based":1305},{"literal_text_all_w_t_and_m_t":"6>include interruptionIndication and set the interruption requirement information if the corresponding entry in interFreq-needForGap is set to no-gap;","paragraph_zero_based":1306},{"literal_text_all_w_t_and_m_t":"2>if the UE is configured to provide the measurement gap and NCSG requirement information of NR target bands:","paragraph_zero_based":1307},{"literal_text_all_w_t_and_m_t":"3>include the NeedForGapNCSG-InfoNR and set the contents as follows:","paragraph_zero_based":1308},{"literal_text_all_w_t_and_m_t":"4> include intraFreq-needForNCSG and set the gap and NCSG requirement information of intra-frequency measurement for each NR serving cell;","paragraph_zero_based":1309},{"literal_text_all_w_t_and_m_t":"4>if requestedTargetBandFilterNCSG-NR is configured:","paragraph_zero_based":1310},{"literal_text_all_w_t_and_m_t":"5>for each supported NR band included in requestedTargetBandFilterNCSG-NR, include an entry in interFreq-needForNCSG and set the NCSG requirement information for that band;","paragraph_zero_based":1311},{"literal_text_all_w_t_and_m_t":"4>else:","paragraph_zero_based":1312},{"literal_text_all_w_t_and_m_t":"5>include an entry for each supported NR band in interFreq-needForNCSG and set the corresponding NCSG requirement information;","paragraph_zero_based":1313},{"literal_text_all_w_t_and_m_t":"2>if the UE is configured to provide the measurement gap and NCSG requirement information of EUTRA target bands:","paragraph_zero_based":1314},{"literal_text_all_w_t_and_m_t":"3>include the NeedForGapNCSG-InfoEUTRA and set the contents as follows:","paragraph_zero_based":1315},{"literal_text_all_w_t_and_m_t":"4>if requestedTargetBandFilterNCSG-EUTRA is configured:","paragraph_zero_based":1316},{"literal_text_all_w_t_and_m_t":"5>for each supported E-UTRA band included in requestedTargetBandFilterNCSG-EUTRA, include an entry in needForNCSG-EUTRA and set the NCSG requirement information for that band;","paragraph_zero_based":1317},{"literal_text_all_w_t_and_m_t":"4>else:","paragraph_zero_based":1318},{"literal_text_all_w_t_and_m_t":"5>include an entry for each supported E-UTRA band in needForNCSG-EUTRA and set the corresponding NCSG requirement information;","paragraph_zero_based":1319}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["4189f535fe66c6671ef550ed616a49a2d2e9ef7724f28a0c8919a44f2c6a5794","87527a6b4ac1e524b166cafae2f8cc4ab1141d748e63cfff01b4cbbc8f9842ab","0ab79e0202dbd2e2817141b92c8118c587769cabf485cbaf98779e3755ec698e","70492f2d2c74ee8a589824a94224e71141172b8a5647de04e5cabf9e6971109c","002143c0961bd65f67d8691ed114acd1cf9fd2fc217ebe5cb9e106e01c8aeb1d","3f93b91e0f750fcf9211e08aa44c3d077c0746507bf6344ce9efa37134fde54f","c360a7b964b09f9efe2d43b34b24c8c37c93b6f8575d06af2fe7b45f5970d43b","3ed7fe776d613f8c5bbdc040a738257dd1ce45814ba673e0983fd7185bdf83ff","e7d5482f5e8d99a3fde7c5de08f4081c2f27c9197a774d2994ed76269325baaa","ba4200c84b5c9461c225e9c451b0862c75aa45a01704c8cd4f0b8ee77e65d8ef","470d81ac005aa13a7707540b9a488545f076c8583ca2b778f70c0a9be9dfe425","bf609bed6e4c303aa72fe571dd918377e4e5cf3393bc7bad4f868bfd58fb5196","8451575dc16ceccbe727abffd16ec3418f25aeadd56634e46f4d5ddb5b0a558d","dbde01463a1f4c88edd83e1820f2f99ecba1f900a240d79b1a1402520fae6345","292221dcde252ceed23e3811aeca8d616ee30080fd219ac253b51b9b0be326de","7182c4d8fec80097786e81d079e6dd8012b4096c56a53b65c82c91a6cd523715","8cda3ffb817801f92f79aac4908a14791f2277a8bd95a8f3e9f9678481a13279","f27f1106e3c46a08a138a042e24e1f2fb3eca07a483f2ceba4450d472b36cfc9","31c9232d4d8852ff436462923c98aeb5f33c3cea75cac695ed5f1fd1f1e5df6b","ac6eae22fccd0e017dd028059a737a939e3a19f3095cffd71be3d623a3f5e12e","9e417fd7f0cfb451639a8cd332e1a23ec9252984c82c003bcaa443d27785f6b0","48d5020f0d2a78ab58fad17c7d3e17c999f21ef747737f8fa9f9f4d46813bf13","cf4b7b4fd32f75d804b34a6b4ae7de8749a6fdc3ff23649e3387af769013f4b5","578057b1a530459adc2d9878566af818321ae675dd25d7948c2d08136c6c0562"],"paragraph_range_zero_based":[1296,1319],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p1296"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if SIB1 contains musim-CapRestrictionAllowed:","paragraph_zero_based":1320},{"literal_text_all_w_t_and_m_t":"3>if supported, include the musim-CapRestrictionInd in the RRCResumeComplete message upon determining it has temporary capability restriction;","paragraph_zero_based":1321},{"literal_text_all_w_t_and_m_t":"2>if the UE has flight path information available:","paragraph_zero_based":1322},{"literal_text_all_w_t_and_m_t":"3>include flightPathInfoAvailable;","paragraph_zero_based":1323},{"literal_text_all_w_t_and_m_t":"2>if, for at least one serving cell, the UE is configured with at least one reportConfigId associated to a CSI-ReportConfig including csi-InferencePrediction, or including reportQuantity-r19 set to p-CRI-r19 or p-SSB-Index-r19 or p-CRI-RSRP-r19 or p-SSB-Index-RSRP-r19:","paragraph_zero_based":1324},{"literal_text_all_w_t_and_m_t":"3>for each such serving cell, include an entry in the applicabilityReportList and set the content as follows:","paragraph_zero_based":1325},{"literal_text_all_w_t_and_m_t":"4>set the applicabilityCellId to the serving cell index of the cell;","paragraph_zero_based":1326},{"literal_text_all_w_t_and_m_t":"4>for each configured reportConfigId associated to a CSI-ReportConfig including csi-InferencePrediction, or including reportQuantity-r19 set to p-CRI-r19 or p-SSB-Index-r19 or p-CRI-RSRP-r19 or p-SSB-Index-RSRP-r19:","paragraph_zero_based":1327},{"literal_text_all_w_t_and_m_t":"5>include an entry in the applicabilityInfoReportList and set the content as follows:","paragraph_zero_based":1328},{"literal_text_all_w_t_and_m_t":"6>set the csi-ReportConfigId within applicabilityInfoReportId to the corresponding reportConfigId;","paragraph_zero_based":1329},{"literal_text_all_w_t_and_m_t":"6>set the applicabilityStatus to the applicability status of the configuration corresponding to the applicabilityInfoReportId;","paragraph_zero_based":1330},{"literal_text_all_w_t_and_m_t":"6>if the applicabilityStatus is set to inapplicable:","paragraph_zero_based":1331},{"literal_text_all_w_t_and_m_t":"7>if the UE prefers to release the concerned CSI-ReportConfig, include releaseConfigurationPreference;","paragraph_zero_based":1332},{"literal_text_all_w_t_and_m_t":"1>submit the RRCResumeComplete message to lower layers for transmission;","paragraph_zero_based":1333},{"literal_text_all_w_t_and_m_t":"1>the procedure ends.","paragraph_zero_based":1334},{"literal_text_all_w_t_and_m_t":"NOTE 2:Network only configures at most one of reportUplinkTxDirectCurrent, reportUplinkTxDirectCurrentTwoCarrier or reportUplinkTxDirectCurrentMoreCarrier in one RRC message.","paragraph_zero_based":1335},{"literal_text_all_w_t_and_m_t":"NOTE 3:Upon reception of musim-CapRestrictionInd in RRCResumeComplete, it is up to network implementation to configure the UE with a limited configuration that is used until network sends RRCReconfiguration based on the actual restricted UE capabilities included in UEAssistanceInformation.","paragraph_zero_based":1336},{"literal_text_all_w_t_and_m_t":"NEXT CHANGE","paragraph_zero_based":1337},{"literal_text_all_w_t_and_m_t":"5.5.4.2Event A1 (Serving becomes better than threshold)","paragraph_zero_based":1338},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":1339},{"literal_text_all_w_t_and_m_t":"1>consider the entering condition for this event to be satisfied when condition A1-1, as specified below, is fulfilled;","paragraph_zero_based":1340},{"literal_text_all_w_t_and_m_t":"1>consider the leaving condition for this event to be satisfied when condition A1-2, as specified below, is fulfilled;","paragraph_zero_based":1341},{"literal_text_all_w_t_and_m_t":"1>for this measurement, consider the NR serving cell corresponding to the associated measObjectNR associated with this event.","paragraph_zero_based":1342},{"literal_text_all_w_t_and_m_t":"Inequality A1-1 (Entering condition)","paragraph_zero_based":1343}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["e7258263eaef5977a54fc1a2c70e58a4a831a2cdbb623a017a6fd829df29d8c1","dc27021ccb3d7e1372b59c2d444931cb624683ff4a9310f4b789b3552aa6910f","aeab29188f95c1fccc2c6720257b93824ebc405e56dbf2bfa2c79fa6619db6ae","498a47c7bb3f6547cf233592f9186e47e562f2c3d0b72e540dce03295469d3fc","5ed6464ce945f15c2e55cce9b8358160d3c417a8a5693cb709ae3b63a7b7ca65","a27161b131d5edf0de0b8a942cf5953f91e911188c386bbf23cff58c891f83b5","52e920a6f1fb26c73db966a9e12132c33c3bfee515a618126bb143973d728f7d","b0214370edc3282e75331d1f7bb6886a957324d11202de6035d533a69bdf5c4c","4df10639a71b26ab867a665ab25c2cd831f4c5f241f4311482e5b49874301333","187029c3205704107451c5e0cd1d4ad5c777e71b77e412f78d009c6807d3855b","67423a9f149bf9b34418bd052606c703408e369e21419fa5f1e7953a6168c96f","dd6e93f05ee520bb4811de080808ddba4e028d6510f2e7f77f776013be0e47e0","0b072a0360407ba6d95477fce33b486000fb2d0b9690b979fe9858d2993c5aa5","14dd2deb67ed98797ca6c09153211f1d6929b92764cbc3887d81be05d3dc2ecd","a2af31d21e060b37c4a3dbeb3994ebd0d84de9efef75565d3f5a313a043b73b6","fe5db049d33a6ade58f562f85f943e3c734d76d4c75c25fd8642b8ce05ff7b14","9fafabef64889af0ed5fdad4fa5042eb0d5d13de6ce6c2e96b6f82e0d1c73d3b","94a3416a043103253511ab92e09b10df9f978cfca981a6b2e3490eca6ac44643","b75b68bac826dd7f306b852e2c8a14b82f1a48397a33b559e1a8e09adbfe28cd","c9166e385894b3c75852a058f36310272b11ee200333280a5e4076aa1ecae3d7","542638e679c9d6ee156034e7b787f107736124e4e434d3ef59d74cbc14255e28","281c255da73a8b8d167aba2a4d7da97d8f2182f06983a3578d867f6974aeab89","9ebf6cde8ba63be07eea2dd8cfbb877243d696ab22a4e9dc4070c6862f6f430f","e71f10dc5c5fd6f118a601c9781c31b134c81d86dcbc45737de858b7a0e6e34d"],"paragraph_range_zero_based":[1320,1343],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p1320"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Ms – Hys > Thresh","paragraph_zero_based":1344},{"literal_text_all_w_t_and_m_t":"Inequality A1-2 (Leaving condition)","paragraph_zero_based":1345},{"literal_text_all_w_t_and_m_t":"Ms + Hys < Thresh","paragraph_zero_based":1346},{"literal_text_all_w_t_and_m_t":"The variables in the formula are defined as follows:","paragraph_zero_based":1347},{"literal_text_all_w_t_and_m_t":"Ms is the measurement result of the serving cell, not taking into account any offsets.","paragraph_zero_based":1348},{"literal_text_all_w_t_and_m_t":"Hys is the hysteresis parameter for this event (i.e. hysteresis as defined within reportConfigNR for this event, or hysteresis as defined within csi-LoggedMeasurementEventTriggerConfig in an entry in csi-LoggedMeasurementConfigToAddModList for this event).","paragraph_zero_based":1349},{"literal_text_all_w_t_and_m_t":"Thresh is the threshold parameter for this event (i.e. a1-Threshold as defined within reportConfigNR for this event, or aboveThreshold as defined within csi-LoggedMeasurementEventTriggerConfig in an entry in csi-LoggedMeasurementConfigToAddModList for this event).","paragraph_zero_based":1350},{"literal_text_all_w_t_and_m_t":"Ms is expressed in dBm in case of RSRP, or in dB in case of RSRQ and RS-SINR.","paragraph_zero_based":1351},{"literal_text_all_w_t_and_m_t":"Hys is expressed in dB.","paragraph_zero_based":1352},{"literal_text_all_w_t_and_m_t":"Thresh is expressed in the same unit as Ms.","paragraph_zero_based":1353},{"literal_text_all_w_t_and_m_t":"NEXT CHANGE","paragraph_zero_based":1354},{"literal_text_all_w_t_and_m_t":"5.5.4.3Event A2 (Serving becomes worse than threshold)","paragraph_zero_based":1355},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":1356},{"literal_text_all_w_t_and_m_t":"1>consider the entering condition for this event to be satisfied when condition A2-1, as specified below, is fulfilled;","paragraph_zero_based":1357},{"literal_text_all_w_t_and_m_t":"1>consider the leaving condition for this event to be satisfied when condition A2-2, as specified below, is fulfilled;","paragraph_zero_based":1358},{"literal_text_all_w_t_and_m_t":"1>for this measurement, consider the serving cell indicated by the measObjectNR associated to this event.","paragraph_zero_based":1359},{"literal_text_all_w_t_and_m_t":"NOTE:If the SCell indicated by the measObjectNR associated to this event is not detectable, then the UE should consider for the value of Ms the lowest value of the value range of the measurement quantity as the SCell measurement.","paragraph_zero_based":1360},{"literal_text_all_w_t_and_m_t":"Inequality A2-1 (Entering condition)","paragraph_zero_based":1361},{"literal_text_all_w_t_and_m_t":"Ms + Hys < Thresh","paragraph_zero_based":1362},{"literal_text_all_w_t_and_m_t":"Inequality A2-2 (Leaving condition)","paragraph_zero_based":1363},{"literal_text_all_w_t_and_m_t":"Ms – Hys > Thresh","paragraph_zero_based":1364},{"literal_text_all_w_t_and_m_t":"The variables in the formula are defined as follows:","paragraph_zero_based":1365},{"literal_text_all_w_t_and_m_t":"Ms is the measurement result of the serving cell, not taking into account any offsets.","paragraph_zero_based":1366},{"literal_text_all_w_t_and_m_t":"Hys is the hysteresis parameter for this event (i.e. hysteresis as defined within reportConfigNR for this event, or hysteresis as defined within csi-LoggedMeasurementEventTriggerConfig in an entry in csi-LoggedMeasurementConfigToAddModList for this event).","paragraph_zero_based":1367}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["da027baec47aa25f7e48ec33356de1f48d17b210b6613b2477ff063870f61780","e3f7ce0a57c0b4aaa5a2b618015810f325c98a046ea37f3d2f4878e8cc30c158","2a5c5354888caa8d20455e0f531735623a93456126f1a2c1f6206343802f6237","2b61d6c871acfb8a2ab178213eb27254754ede815fb11c5983235e507a909670","5e6517b1d950533585497b030fb473efb2abaed3830923227b15aed81950f896","23403d69d96bbf095f6d9864f8caea5fa40e22ec31f9761ebf2fccadd5af1f9c","8d2edc9e141369e648a0a99ebe2815cae8495acc068c0079b7389c4308d718b1","a3ec5ad15f955cb53d4c8996a069569274db9b2704a877f88baa9ecab0584be0","8ed348962018f65ee21049de6ea2bf769ab5b07b4269837c5d72a00cce5b21be","d7eb77292405e0428e887e08b8784d3337bcc0ec4191ee8489a08526961e42a7","95da840d01bd8e51ab649318ca986f190f41ee5775acc5338362e62096853995","629c483b7a5b88b968a11e87678b9b1a52567a945f04bb1f911f1b4b26f1fe1b","9adbd1bd07237326325b90c5eb848d90a86358881175649e015090327eba3baa","0ab481759e9013e0d7aeae13c2b6082596b14f8c62c6e3f1272c1027c6377ebf","5ecf9efeb7a0b6f553b7ba4ba01d1af1f00f2475d92f83adf0b09dcba0bb70ce","a11012d9b1729345cbebfece2ec240f8134d211c3f833a8f0c4e15e3cf00ac98","5f7aae9dff21d6e255ac9230a682d6619040bafe9c4d9e0020a8d323112d7df4","f8f7c8729747ed5a7f7b995975fbe6952c420d5359967a32aee386749af3906c","9968e8f6e4da47f3f0a8026e1c49b6e92c0e48241607d25140601da00ed0a17a","8b17b06ce2846c47629c65c4c71db816ae6c670a65205954d4a7d502a4ff3e5d","8c7a4f3c115a29acd0b464b92410816d8ccd58e31b9aa968845789bcd810432f","8481b32fb7947d0f05272dbe5e0cb81a836e9b466bcd95b7696270834dcbef3d","d98b90ccb29504a61e509d62ac62a22dc29d1929df84be8849d58ea03e02fd80","be0102dd1eaf3d605cbcdb638257429b83d917f176fd0f5c12ceea38d1694360"],"paragraph_range_zero_based":[1344,1367],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p1344"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Thresh is the threshold parameter for this event (i.e. a2-Threshold as defined within reportConfigNR for this event, or belowThreshold as defined within csi-LoggedMeasurementEventTriggerConfig in an entry in csi-LoggedMeasurementConfigToAddModList for this event).","paragraph_zero_based":1368},{"literal_text_all_w_t_and_m_t":"Ms is expressed in dBm in case of RSRP, or in dB in case of RSRQ and RS-SINR.","paragraph_zero_based":1369},{"literal_text_all_w_t_and_m_t":"Hys is expressed in dB.","paragraph_zero_based":1370},{"literal_text_all_w_t_and_m_t":"Thresh is expressed in the same unit as Ms.","paragraph_zero_based":1371},{"literal_text_all_w_t_and_m_t":"NEXT CHANGE","paragraph_zero_based":1372},{"literal_text_all_w_t_and_m_t":"5.5a.1.3Reception of CSI-LoggedMeasurementConfig by the UE","paragraph_zero_based":1373},{"literal_text_all_w_t_and_m_t":"Upon receiving csi-LoggedMeasurementConfigToAddModList in the csi-MeasConfig of a serving cell, the UE shall:","paragraph_zero_based":1374},{"literal_text_all_w_t_and_m_t":"1>for each CSI logged measurement configuration included in csi-LoggedMeasurementConfigToAddModList:","paragraph_zero_based":1375},{"literal_text_all_w_t_and_m_t":"2>if the current UE configuration for the serving cell includes the CSI logged measurement configuration associated with the given csi-LoggedMeasurementConfigId:","paragraph_zero_based":1376},{"literal_text_all_w_t_and_m_t":"3>modify the CSI logged measurement configuration according to the configuration received in csi-LoggedMeasurementConfigToAddModList;","paragraph_zero_based":1377},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":1378},{"literal_text_all_w_t_and_m_t":"3>add the received CSI logged measurement configuration to the UE configuration;","paragraph_zero_based":1379},{"literal_text_all_w_t_and_m_t":"2>if the cell identity of the serving cell for which the measurements shall be logged, i.e. the serving cell associated with the serving cell configuration in which csi-LoggedMeasurementConfigToAddModList is received, is not included in an entry in csi-LogMeasInfoCellList in VarCSI-LogMeasReport:","paragraph_zero_based":1380},{"literal_text_all_w_t_and_m_t":"3>include an entry in csi-LogMeasInfoCellList in VarCSI-LogMeasReport;","paragraph_zero_based":1381},{"literal_text_all_w_t_and_m_t":"3>set cellId to the global cell identity, if available, otherwise to the physical cell identity and carrier frequency of the serving cell associated with the serving cell configuration in which csi-LoggedMeasurementConfigToAddModList is received;","paragraph_zero_based":1382},{"literal_text_all_w_t_and_m_t":"2>if not already present, include an entry in csi-LogMeasInfoConfigList in VarCSI-LogMeasReport and set refCSI-LoggedMeasurementConfigId to the csi-LoggedMeasurementConfigId associated to the CSI logged measurement configuration included in csi-LoggedMeasurementConfigToAddModList;","paragraph_zero_based":1383},{"literal_text_all_w_t_and_m_t":"2>perform measurements logging as specified in 5.5a.3.2.","paragraph_zero_based":1384},{"literal_text_all_w_t_and_m_t":"NEXT CHANGE","paragraph_zero_based":1385},{"literal_text_all_w_t_and_m_t":"5.5a.3.2Initiation","paragraph_zero_based":1386},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":1387},{"literal_text_all_w_t_and_m_t":"1>for each CSI logged measurement configuration associated with a refCSI-LoggedMeasurementConfigId in csi-LogMeasInfoConfigList in VarCSI-LogMeasReport, perform the logging of measurements for the serving cell associated with cellId, in accordance with the corresponding CSI logged measurement configuration within csi-LoggedMeasurementConfigToAddModList:","paragraph_zero_based":1388},{"literal_text_all_w_t_and_m_t":"2>if the csi-LoggedMeasurementEventTriggerConfig is not included and the memory for network-side data collection is not full:","paragraph_zero_based":1389},{"literal_text_all_w_t_and_m_t":"3>perform the logging at regular time intervals, according to loggingPeriodicity (if present) or according to the periodicity of the resources indicated by csi-LoggedResourceConfig in the corresponding CSI logged measurement configuration within csi-LoggedMeasurementConfigToAddModList, if loggingPeriodicity is not present;","paragraph_zero_based":1390},{"literal_text_all_w_t_and_m_t":"2>if the csi-LoggedMeasurementEventTriggerConfig is included and the memory for network-side data collection is not full:","paragraph_zero_based":1391}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["66e9ab7daffd4016ea461acfb7e2944626e541f8e982757f883846536c17f212","afee96b6ae50546f57b3b02bce63afd265421f2ec6252bc591c96b6f1c83e6e6","8fd013978c3fd69a37f0ca3cb85bd8db8393a9749ecafc8fb84a655aecbdd781","c66c8dd8fd401f41e651ac32b919c5434e35c6535c84013f7cc77aceff73d44c","ba398307675a41087b84787d8a2e0f50484a9c39a8bc106f48f1ce66f91c17cb","bb11d718f21b1100ef710cfda881e6267246345c70194a6143477c43f69bfa25","8b5fd9a3073d1637e1c32ea9677296a5978e536d6d2601e492525e3a5c1f0ae0","017250e9293bdff5579e5c1a1b127de5ea98ea66d2218ead222abb77d851f3c7","77f0519e3147c87293d24d01b281cd348c236d29b9f3e47b5b74d4c23487b5ea","210761af8f1d9cf5dae8648c60e3a8aeff6a94385c06cbe47ea05a9b456c5907","1b7ad422fefd9480277af37cae4438af33b6c65b62aa2e97051216cab8f918b0","2648e1cc65837530fb1919e365dbaffd0f6534794e2eb527f94e08f4bd73c7d2","d1a38eeec9c03ed1ee135b2401abdf11a810e42bc23d7ce000f2915786cb2a61","e4b54e129f5e32b9c9ed6c133dc51bf121ce48cf46cb974b9c646413893106fb","712bfce7b87855ec35b692863968dbbc58db0088bafa03ee19a51ffcbb5efafc","42d0ee6b857b47685fbfc33004db3073a8d425d7e873745a85c52a7ca1156eb2","5fbf4a8eccc6ed18df07c612c224ff6da469cf2bb63741ee9109a613ce6896f1","cdcf85d91015892ac5c816bba037bf191bf8182da3289c304131afa0b4a402f9","017e0ff4a9fcfeb37795670f6266c0e01c461c32da13761d1a704ae023aae6cb","fed5f148ee5624615d23fc2f7cbca71fbf2779838e021791bc7f142696c86227","2a3c69fa19ae609725fa2869ec602fbb7c281ab8bcb2c88ab31015dc9a9f7e45","2abf781ef9c12cec47b79f6d33e33d8761273bb62ae9909ce48f49ae02bf5a74","ae146f10135c95bad63c3b7ea915d285bc9a050e07aeefb6294c96209bd2e1f7","24a9af7712dbf1ef17bb34389e15fc05becb7ee1b70c92f3a99a1aeff58f4c67"],"paragraph_range_zero_based":[1368,1391],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p1368"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>if threshold within csi-LoggedMeasurementEventTriggerConfig is set to aboveThreshold and the entering condition, as specified in 5.5.4.2, is fulfilled for the serving cell associated with cellId for all measurements taken during timeToTrigger; or","paragraph_zero_based":1392},{"literal_text_all_w_t_and_m_t":"3>if threshold within csi-LoggedMeasurementEventTriggerConfig is set to belowThreshold and the entering condition, as specified in 5.5.4.3, is fulfilled for the serving cell associated with cellId for all measurements taken during timeToTrigger:","paragraph_zero_based":1393},{"literal_text_all_w_t_and_m_t":"4>perform the logging at regular time intervals, according to loggingPeriodicity (if present) or according to the periodicity of the resources indicated by csi-LoggedResourceConfig in the corresponding CSI logged measurement configuration within csi-LoggedMeasurementConfigToAddModList, if loggingPeriodicity is not present;","paragraph_zero_based":1394},{"literal_text_all_w_t_and_m_t":"3>if threshold within csi-LoggedMeasurementEventTriggerConfig is set to aboveThreshold and the leaving condition, as specified in 5.5.4.2, is fulfilled for the serving cell associated with cellId for all measurements taken during timeToTrigger; or","paragraph_zero_based":1395},{"literal_text_all_w_t_and_m_t":"3>if threshold within csi-LoggedMeasurementEventTriggerConfig is set to belowThreshold and the leaving condition, as specified in 5.5.4.3, is fulfilled for the serving cell associated with cellId for all measurements taken during timeToTrigger:","paragraph_zero_based":1396},{"literal_text_all_w_t_and_m_t":"4>stop performing the logging for the corresponding CSI logged measurement configuration within csi-LoggedMeasurementConfigToAddModList;","paragraph_zero_based":1397},{"literal_text_all_w_t_and_m_t":"2>when performing the logging:","paragraph_zero_based":1398},{"literal_text_all_w_t_and_m_t":"3>for each CSI logged measurement configuration associated to refCSI-LoggedMeasurementConfigId in csi-LogMeasInfoConfigList in VarCSI-LogMeasReport:","paragraph_zero_based":1399},{"literal_text_all_w_t_and_m_t":"4>for each logging instance include an entry in csi-LogMeasInfoList and set the csi-RS-MeasResultList and/or SSB-MeasResultList to include the quantities the UE is logging measurements for, upon receiving the quantities from the lower layers;","paragraph_zero_based":1400},{"literal_text_all_w_t_and_m_t":"5>if the time between the measurements that are logged and included in this instance of csi-LogMeasInfoList and the measurements for the previous instance of csi-LogMeasInfoList with the same refCSI-LoggedMeasurementConfigId, for the same serving cell, is longer than the logging periodicity (if configured) or the periodicity of the measurement resources (if the logging periodicity is not configured):","paragraph_zero_based":1401},{"literal_text_all_w_t_and_m_t":"6>set the timeGap to true;","paragraph_zero_based":1402},{"literal_text_all_w_t_and_m_t":"2>when the memory reserved for the logged measurement information for data collection becomes full, stop logging;","paragraph_zero_based":1403},{"literal_text_all_w_t_and_m_t":"2>when the memory reserved for the logged measurement information for data collection is no longer full, resume logging.","paragraph_zero_based":1404},{"literal_text_all_w_t_and_m_t":"NEXT CHANGE","paragraph_zero_based":1405},{"literal_text_all_w_t_and_m_t":"5.7.4.2Initiation","paragraph_zero_based":1406},{"literal_text_all_w_t_and_m_t":"A UE capable of providing delay budget report in RRC_CONNECTED may initiate the procedure in several cases, including upon being configured to provide delay budget report and upon change of delay budget preference.","paragraph_zero_based":1407},{"literal_text_all_w_t_and_m_t":"A UE capable of providing overheating assistance information in RRC_CONNECTED may initiate the procedure if it was configured to do so, upon detecting internal overheating, or upon detecting that it is no longer experiencing an overheating condition.","paragraph_zero_based":1408},{"literal_text_all_w_t_and_m_t":"A UE capable of providing IDC assistance information in RRC_CONNECTED may initiate the procedure if it was configured to do so, upon detecting IDC problem if the UE did not transmit an IDC assistance information since it was configured to provide IDC indications, or upon change of IDC problem information.","paragraph_zero_based":1409},{"literal_text_all_w_t_and_m_t":"A UE capable of providing its preference on DRX parameters of a cell group for power saving or its preference on cell DTX/DRX related parameters in RRC_CONNECTED may initiate the procedure in several cases, if it was configured to do so, including upon having a preference on DRX parameters or cell DTX/DRX related parameters and upon change of its preference on DRX parameters or cell DTX/DRX related parameters.","paragraph_zero_based":1410},{"literal_text_all_w_t_and_m_t":"A UE capable of providing its preference on the maximum aggregated bandwidth of a cell group for power saving in RRC_CONNECTED may initiate the procedure in several cases, if it was configured to do so, including upon having a maximum aggregated bandwidth preference and upon change of its maximum aggregated bandwidth preference.","paragraph_zero_based":1411},{"literal_text_all_w_t_and_m_t":"A UE capable of providing its preference on the maximum number of secondary component carriers of a cell group for power saving in RRC_CONNECTED may initiate the procedure in several cases, if it was configured to do so, including upon having a maximum number of secondary component carriers preference and upon change of its maximum number of secondary component carriers preference.","paragraph_zero_based":1412},{"literal_text_all_w_t_and_m_t":"A UE capable of providing its preference on the maximum number of MIMO layers of a cell group for power saving in RRC_CONNECTED may initiate the procedure in several cases, if it was configured to do so, including upon having a maximum number of MIMO layers preference and upon change of its maximum number of MIMO layers preference.","paragraph_zero_based":1413},{"literal_text_all_w_t_and_m_t":"A UE capable of providing its preference on the minimum scheduling offset for cross-slot scheduling of a cell group for power saving in RRC_CONNECTED may initiate the procedure in several cases, if it was configured to do so, including upon having a minimum scheduling offset preference and upon change of its minimum scheduling offset preference.","paragraph_zero_based":1414},{"literal_text_all_w_t_and_m_t":"A UE capable of providing assistance information to transition out of RRC_CONNECTED state may initiate the procedure if it was configured to do so, upon determining that it prefers to transition out of RRC_CONNECTED state, or upon change of its preferred RRC state.","paragraph_zero_based":1415}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["4cb88ef0a817e7b00a475d7defd4bacdba303e53c0476c54bd381df83ea636b3","0f77eaac1bdc25a4cb8b9bee7250834a786fecd5604320693f890ca81ee624dc","10e332b62bc83d9f65b29bb15c1a57b8fab4876796126f381c8a2a92c691b7e0","3c293cabc3836b2eece4b9e3daac30b99f121f5c29e807ede33645869ce6ca04","bab356354648698dc4313ecc14473b68e101acbe7fea6bec180970b40aea482c","ef796bfd595cc275c8cfe6bccb70cf99ac9a8e617cec274c7186e0f559cf9367","59424a9b30052c767e8c7c5ebfc3ec30b9baf3661bda06fce2a08229c4db00a9","b3622f1ad8ead159ff9551a0ddbb140c5658061f2523a9b73787c11fb8cf38ae","7e1bedc73fda6cc97f70d37907694d9d553487831d72c73159543bed1d7dc09e","e3a6cd9d560b1e7545b2c8b82688908e8362c924324ff9f9135f02650279ffbc","16a3e6a6750e3a33f2d159cc8c6bd34f2dd20a732c807b184f078c2236128f9c","2e4e2d6b07e160ac013ac4b2a3d2a51f0e0824dc66ec55e7f32071f344dae3c4","53e3fb36c402afae1fca9a449a1c6dedf12d99dfcd1a9aaac304817f438e9cef","81d83576956239c123c09c8a7bdfe417dd4798a19e04dc030472f6000417bc71","6aceebc173bd0d59bca0d6b21ef8456b5183f30d4ae805424d80f16184daf29f","fff18024846e88e57e764005f75a14b6c04961a00cc9ae246fa0919c56cfed90","176923e62b6e1742fceb1fa548cb55c5ddac067198cf6e1e9863591429346e6e","8b59c0ab8ca39c586ddb09d1efbb7f99f111f3b18b1d315f7d4de5ec0b1b4dcf","4ecca54b4016322610d5ea1d4d92a84b06fa38edeb1df540fd5da0fb951fe7b3","f27f7213bed7939022a35637b69126d6054b3aac0387b6cf46147e4b459b5948","d82cbf845b8709dbe2be3357ede457ef99df0b569d86a9db80fee5ac18c8db4e","698648f7929eb33525bedd61c3d8710fb1b819445666c377bacc8c17ef7a4776","3b7f3d74b4a555048e06ce317d083ffe6b13431c2971e4f610b1ed6bcce3b664","e10af383672b42fd91c57b4e10227a236f168486fe92eda43812f3232a2e6f95"],"paragraph_range_zero_based":[1392,1415],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p1392"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"A UE capable of providing configured grant assistance information for NR sidelink communication in RRC_CONNECTED may initiate the procedure in several cases, including upon being configured to provide traffic pattern information and upon change of traffic patterns.","paragraph_zero_based":1416},{"literal_text_all_w_t_and_m_t":"A UE capable of providing an indication of its preference in being provisioned with reference time information may initiate the procedure upon being configured to provide this indication, or if it was configured to provide this indication and upon change of its preference.","paragraph_zero_based":1417},{"literal_text_all_w_t_and_m_t":"A UE capable of providing an indication of its preference in FR2 UL gap may initiate the procedure if it was configured to do so, upon detecting the need of FR2 UL gap activation/deactivation.","paragraph_zero_based":1418},{"literal_text_all_w_t_and_m_t":"A UE capable of providing MUSIM assistance information for gap preference may initiate the procedure if it was configured to do so, upon determining it needs the gaps, or upon change of the gap preference information.","paragraph_zero_based":1419},{"literal_text_all_w_t_and_m_t":"A UE capable of providing MUSIM assistance information for gap priority preference and/or preference to keep the colliding MUSIM gaps may initiate the procedure if it was configured to do so, upon determining it has gap priority preference information and/or it has preference to keep the colliding MUSIM gaps.","paragraph_zero_based":1420},{"literal_text_all_w_t_and_m_t":"A UE capable of providing MUSIM assistance information for leave indication may initiate the procedure if it was configured to do so upon determining that it needs to leave RRC_CONNECTED state.","paragraph_zero_based":1421},{"literal_text_all_w_t_and_m_t":"A UE capable of providing MUSIM assistance information for temporary capability restriction may initiate the procedure if it was configured to do so, upon determining it has temporary capability restriction or upon determining the removal of the capability restriction.","paragraph_zero_based":1422},{"literal_text_all_w_t_and_m_t":"A UE capable of relaxing its RLM measurements of a cell group in RRC_CONNECTED state shall initiate the procedure for providing an indication of its relaxation state for RLM measurements upon being configured to do so, and upon change of its relaxation state for RLM measurements in RRC_CONNECTED state.","paragraph_zero_based":1423},{"literal_text_all_w_t_and_m_t":"A UE capable of relaxing its BFD measurements in serving cells of a cell group in RRC_CONNECTED shall initiate the procedure for providing an indication of its relaxation state for BFD measurements upon being configured to do so, and upon change of its relaxation state for BFD measurements in RRC_CONNECTED state.","paragraph_zero_based":1424},{"literal_text_all_w_t_and_m_t":"A UE capable of SDT initiates this procedure when data and/or signalling mapped to radio bearers that are not configured for SDT becomes available during SDT (i.e. while SDT procedure is ongoing).","paragraph_zero_based":1425},{"literal_text_all_w_t_and_m_t":"A UE capable of providing its preference for SCG deactivation may initiate the procedure if it was configured to do so, upon determining that it prefers or does no more prefer the SCG to be deactivated.","paragraph_zero_based":1426},{"literal_text_all_w_t_and_m_t":"A UE that has uplink data to transmit for a DRB for which there is no MCG RLC bearer while the SCG is deactivated shall initiate the procedure.","paragraph_zero_based":1427},{"literal_text_all_w_t_and_m_t":"A UE capable of providing an indication of fulfilment of the RRM measurement relaxation criterion in connected mode may initiate the procedure if it was configured to do so, upon change of its fulfilment status for RRM measurement relaxation criterion for connected mode.","paragraph_zero_based":1428},{"literal_text_all_w_t_and_m_t":"A UE capable of providing service link propagation delay difference between serving cell and neighbour cell(s) shall initiate the procedure upon being configured to do so, and upon determining that service link propagation delay difference between serving cell and a neighbour cell has changed more than threshPropDelayDiff compared with the last reported value.","paragraph_zero_based":1429},{"literal_text_all_w_t_and_m_t":"A UE capable of providing an indication of its preference on multi-Rx operation for FR2 may initiate the procedure if it was configured to do so, upon detecting having a preference on multi-Rx operation for FR2 and upon change of its preference on multi-Rx operation for FR2.","paragraph_zero_based":1430},{"literal_text_all_w_t_and_m_t":"A UE capable of indicating the availability of flight path information may initiate the procedure, if it was configured to do so, upon determining that an initial or updated flight path information is available.","paragraph_zero_based":1431},{"literal_text_all_w_t_and_m_t":"A UE capable of providing UL traffic information shall initiate the procedure when this information is available upon being configured to do so, and upon change of UL traffic information.","paragraph_zero_based":1432},{"literal_text_all_w_t_and_m_t":"A UE capable of N3C remote UE operation initiates the procedure upon being configured to report relay UE information on the available non-3GPP connection(s), and upon change of its available non-3GPP connection(s).","paragraph_zero_based":1433},{"literal_text_all_w_t_and_m_t":"A UE capable of providing configured grant assistance information including SL-PRS transmission periodicity, priority, bandwidth and delay budget for NR sidelink positioning in RRC_CONNECTED may initiate the procedure.","paragraph_zero_based":1434},{"literal_text_all_w_t_and_m_t":"A UE capable of providing UE's preference for gap occasion cancellation ratio initiates the procedure upon being configured to do so when the UE has a preference for gap occasion cancellation ratio, or upon change of its preference.","paragraph_zero_based":1435},{"literal_text_all_w_t_and_m_t":"A UE capable of providing its preference on time offset for LP-WUS monitoring may initiate the procedure in several cases, including upon being configured to provide its preference on time offset for LP-WUS monitoring and upon change of its preference on time offset for LP-WUS monitoring.","paragraph_zero_based":1436},{"literal_text_all_w_t_and_m_t":"A UE capable of applicability reporting and/or its updates (via RRCReconfigurationComplete or via UEAssistanceInformation message) may initiate the procedure if it was configured to report the applicability in UEAssistanceInformation message, upon change of the applicability of the configurations subject to the applicability determination procedure. A UE capable of applicability reporting and/or its updates (via RRCReconfigurationComplete or via UEAssistanceInformation message) shall initiate the procedure if it was configured to report the applicability in UEAssistanceInformation message, upon determining that the applicability of a configuration subject to the applicability determination procedure changed from applicable to inapplicable.","paragraph_zero_based":1437},{"literal_text_all_w_t_and_m_t":"A UE capable of providing its preference to be configured with or stop being configured with radio resources to perform UE-side data collection may initiate the procedure if it was configured to do so, upon determining that it would like to perform UE-side data collection, or upon determining a list of preferred radio resource configurations for UE-side data collection, or upon determining a list of radio resource configurations for which it prefers to stop UE-side data collection.","paragraph_zero_based":1438},{"literal_text_all_w_t_and_m_t":"A UE capable of logging measurements for network-side data collection shall initiate the procedure if it was configured to do so, upon determining that it has entered a low power state, or upon determining that the memory reserved for the logging of radio measurements for network-side data collection has become full.","paragraph_zero_based":1439}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["6af30c030f9bce15b2321b566cf889978f2517ad5f97e07a0f63d8f90401b405","5891a031a83b1661f8bf8d016a2f881d6b696e7d0fcbfa1d136334401a97aab5","427b670f3fb0149e6e76d7b7776ed46a27d9264c1041262323718cc49028d570","600ca83321399f6f56ad3f10d3dd32082732145378f8776fae54a7cee9611adc","cf4b59cd6f2f8e5114303c610067ba67844d3620f649779c430ddc49fdeeefa9","78ccfb155bf0021318339523d2e765888a141145e249cf50329eb3fc79ce892b","85154d2620a26b5a9c254852aebfc2832f3e61d6c72134d1e5afc824f4976563","ec06d8fb084ca3615d28c22fa27bf8c9de9d462d945682da6ad6bb3e9ff0ae06","737f6fcd9a039225ddf74e119d08e68bd2c024708c4bf7f08df1dd723b7615c3","0f281499e072d0eb2dabece41659c9f4a41b83ac24f80fed787919b87f7ac5ce","5dad9cd6f4f6af1ef2f261eda64cf2a03885e9f2094d6dd99a0f4ede61fdaac0","b1dd5e2b489e9da4f5d8050ac9b7622c282da04b30352b10554ec69bc097ce38","18f5f1abd7fec6beab8c9406ec3c7e5057e0f3669bb33c88ff6ba6f67efc0270","78fdc7e4f071aa49e193a0d702ce905960162a8e3d0beae6dbb629b516b97526","75dc5d5abbd291d82b2320f59eb23c94642dfb6d8e293c63b78946f65193e16f","69910120ee325327f38e83c7f72056a6c81f19b4e9ccc956dcd95615c33eeea0","00aa8ea0cf8e080b8eed62f5db7c10bea6a2793e072cbd340c9d11bc96588762","19bfd85233d122c8f7f5fbea2f4911bece28a47b73b12bf4e7b47c680ac996ed","67e84e7103445b6d27b31f733c5c17341bb60d2f23d28eba25c6d76c2254d66a","47d474f976a1554cb1c617b246fdd24606426d9074561b88bfb0d060b8b19cfd","4f6b0d71973dae6f7a749b86c04a8669c53dc78c9e428d0fa1a6e69067183172","016033d0caa94a7d21b3e89342ecb14ca0b386421f394382ffce2f60433748f8","0c2846b1373db6742d7968f2563f84bcc0ed22ac00485ef7db243371f6e40f37","0fb779cc05e98630818592f4d49bba4048e330180471aef7e5aa36db423e51c4"],"paragraph_range_zero_based":[1416,1439],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p1416"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"A UE capable of logging measurements for network-side data collection and of providing a data availability indication based on a memory threshold shall initiate the procedure if it was configured to do so, upon determining that the amount of logged data related to radio measurements for network-side data collection reached a configured memory threshold.","paragraph_zero_based":1440},{"literal_text_all_w_t_and_m_t":"A UE capable of providing location information for assisted SMTC configuration in RRC_CONNECTED state shall initiate the procedure upon being configured to do so, and upon determining that the closest reference location(s) have changed compared with the last reported values.","paragraph_zero_based":1441},{"literal_text_all_w_t_and_m_t":"Upon initiating the procedure, the UE shall:","paragraph_zero_based":1442},{"literal_text_all_w_t_and_m_t":"1>if configured to provide delay budget report:","paragraph_zero_based":1443},{"literal_text_all_w_t_and_m_t":"2>if the UE did not transmit a UEAssistanceInformation message with delayBudgetReport since it was configured to provide delay budget report; or","paragraph_zero_based":1444},{"literal_text_all_w_t_and_m_t":"2>if the current delay budget is different from the one indicated in the last transmission of the UEAssistanceInformation message including delayBudgetReport and timer T342 is not running:","paragraph_zero_based":1445},{"literal_text_all_w_t_and_m_t":"3>start or restart timer T342 with the timer value set to the delayBudgetReportingProhibitTimer;","paragraph_zero_based":1446},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide a delay budget report;","paragraph_zero_based":1447},{"literal_text_all_w_t_and_m_t":"1>if configured to provide overheating assistance information:","paragraph_zero_based":1448},{"literal_text_all_w_t_and_m_t":"2>if the overheating condition has been detected and T345 is not running; or","paragraph_zero_based":1449},{"literal_text_all_w_t_and_m_t":"2>if the current overheating assistance information is different from the one indicated in the last transmission of the UEAssistanceInformation message including overheatingAssistance and timer T345 is not running:","paragraph_zero_based":1450},{"literal_text_all_w_t_and_m_t":"3>start timer T345 with the timer value set to the overheatingIndicationProhibitTimer;","paragraph_zero_based":1451},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide overheating assistance information;","paragraph_zero_based":1452},{"literal_text_all_w_t_and_m_t":"1>if configured to provide IDC assistance information based on candidateServingFreqListNR included in idc-AssistanceConfig of a cell group:","paragraph_zero_based":1453},{"literal_text_all_w_t_and_m_t":"2>if the UE did not transmit a UEAssistanceInformation message with idc-Assistance since it was configured to provide IDC assistance information:","paragraph_zero_based":1454},{"literal_text_all_w_t_and_m_t":"3>if on one or more frequencies included in candidateServingFreqListNR, the UE is experiencing IDC problems that it cannot solve by itself; or","paragraph_zero_based":1455},{"literal_text_all_w_t_and_m_t":"3>if on one or more supported UL CA or NR-DC combination comprising of carrier frequencies included in candidateServingFreqListNR, the UE is experiencing IDC problems that it cannot solve by itself:","paragraph_zero_based":1456},{"literal_text_all_w_t_and_m_t":"4>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide FDM IDC assistance information including a list of affected frequencies and/or frequency combinations;","paragraph_zero_based":1457},{"literal_text_all_w_t_and_m_t":"2>else if the current idc-Assistance information for the cell group is different from the one indicated in the last transmission of the UEAssistanceInformation message:","paragraph_zero_based":1458},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide IDC FDM assistance information including a list of affected frequencies and/or frequency combinations;","paragraph_zero_based":1459},{"literal_text_all_w_t_and_m_t":"1>if configured to provide IDC assistance information based on idc-FDM-AssistanceConfig included in idc-AssistanceConfig of a cell group:","paragraph_zero_based":1460},{"literal_text_all_w_t_and_m_t":"2>if the UE did not transmit a UEAssistanceInformation message with idc-FDM-Assistance since it was configured to provide IDC assistance information:","paragraph_zero_based":1461},{"literal_text_all_w_t_and_m_t":"3>if on one or more frequency ranges included in candidateServingFreqRangeListNR, the UE is experiencing IDC problems that it cannot solve by itself; or","paragraph_zero_based":1462},{"literal_text_all_w_t_and_m_t":"3>if on one or more supported UL CA or NR-DC combination comprising of frequency ranges included in candidateServingFreqRangeListNR, the UE is experiencing IDC problems that it cannot solve by itself:","paragraph_zero_based":1463}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["dc9066d525c8265d2d3eb005829ff42873f294fae60c3c2123de08a41c61e8cd","45509edc941bae262bf9bcc159a58bb8b84dc7e66ce4ee38c3428c17b9d86708","13dceec71b555d3e754ba480d4352b4be6ed280017454666903fcb2aa85fb064","024aabd98c0a7f1baa68fd892bc3909d3fdfeef6f9db03836a94ff13690a967e","a3790e6bbeb9f119c79bbdc51841d45f36bd23459f20f7c1746bd1e17f597863","5584001c409fbb97529bc6444eaa465afac7ab1990096c286303fdc94f09f4dc","7e0567ad93163ae67e9f0fe96315881e0470c6b3be88e2f250cfe094058cf9c8","37b93ca835b0099fb51a5eee059a34be9ce0e3fd55a32a41f5e7b644a3d68c95","e8f03bd5521e410c60768845b56c05699197bc26ac0c2b29fd5392b3b387b4bb","16dee66c80119f8f35e776a9b592d1975e64f6b8d286928ef5ffad448bf478f8","67def77d8bd71276fcacd866929942f7c264cffdfbda3b0a54415af774b7e9fb","82bf83cb20458d331251ed6422c792b26d32105ced14bc12023527effae94117","e287638c6bed1e6d3f5234ca64c73f278014ea73a111b84a1380a0d8b72d717f","09824985c95d0409f56bd16279a8622c86b4883389bdc63785ae2e3366a79531","55ace52c66d117417a4936548bf5c07d02e9d5cf2b788a8a9bbd5acda203e02b","0b5e640d079d3fa4334baeb108f4a505a07990240dd9ffd012d5fc32fa1551a5","69c52fd9c7626fe0808278b2f804434f8070e450c6d33f9f257c3e0a9baf1353","26b2ef6f9920201bfc34bda7bc842662e77cc0c37690c020a52cb7a617710cb4","240f281ea9058cf5d76159cd860efc4956770054e8aee27736c859b959c7debb","617a8f362fd5aa7aa173bb64968e3e620d39502a541fbd8abefc33680a76f092","1cd059d077d9d1be9848e53da180ad83abd8d65f1e874043bca549ee62948691","26104bfc199f06eb02f3801ff112706c4ff54e7ca7dca70547cb7e3085f1f1e9","bdb5d7efbdf8e52db44f9366ecbbb262a50cdce9382a9990f8338995fbdd6182","0f6e4d50a4162fe409e7f94b51d270fb335553513693d87fa9fb453d234f0bdd"],"paragraph_range_zero_based":[1440,1463],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p1440"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide IDC enhanced FDM assistance information including a list of affected frequency ranges and/or frequency range combinations;","paragraph_zero_based":1464},{"literal_text_all_w_t_and_m_t":"2>else if the current idc-FDM-Assistance information for the cell group is different from the one indicated in the last transmission of the UEAssistanceInformation message:","paragraph_zero_based":1465},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide IDC enhanced FDM assistance information including a list of affected frequency ranges and/or frequency range combinations;","paragraph_zero_based":1466},{"literal_text_all_w_t_and_m_t":"1>if configured to provide IDC assistance information based on idc-TDM-AssistanceConfig included in idc-AssistanceConfig of a cell group:","paragraph_zero_based":1467},{"literal_text_all_w_t_and_m_t":"2>if the UE did not transmit a UEAssistanceInformation message with idc-TDM-Assistance since it was configured to provide IDC assistance information:","paragraph_zero_based":1468},{"literal_text_all_w_t_and_m_t":"3>if on one or more frequencies included in candidateServingFreqListNR or frequency ranges included in candidateServingFreqRangeListNR, the UE is experiencing IDC problems that it cannot solve by itself; or","paragraph_zero_based":1469},{"literal_text_all_w_t_and_m_t":"3>if on one or more supported UL CA or NR-DC combination comprising of carrier frequencies included in candidateServingFreqListNR or frequency ranges included in candidateServingFreqRangeListNR, the UE is experiencing IDC problems that it cannot solve by itself:","paragraph_zero_based":1470},{"literal_text_all_w_t_and_m_t":"4>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide IDC TDM assistance information;","paragraph_zero_based":1471},{"literal_text_all_w_t_and_m_t":"2>else if the current idc-TDM-Assistance information for the cell group is different from the one indicated in the last transmission of the UEAssistanceInformation message:","paragraph_zero_based":1472},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide IDC TDM assistance information;","paragraph_zero_based":1473},{"literal_text_all_w_t_and_m_t":"NOTE 1:The term \"IDC problems\" refers to interference issues applicable across several subframes/slots where not necessarily all the subframes/slots are affected.","paragraph_zero_based":1474},{"literal_text_all_w_t_and_m_t":"NOTE 2:For the frequencies or frequency range(s) on which a serving cell or serving cells is configured that is activated, IDC problems consist of interference issues that the UE cannot solve by itself, during either active data exchange or upcoming data activity which is expected in up to a few hundred milliseconds.For frequencies or frequency range(s) on which a SCell or SCells is configured that is deactivated, reporting IDC problems indicates an anticipation that the activation of the SCell or SCells would result in interference issues that the UE would not be able to solve by itself.For a non-serving frequency or frequency range(s), reporting IDC problems indicates an anticipation that if the non-serving frequency or frequencies or frequency range(s) became a serving frequency or serving frequencies or frequency range(s) then this would result in interference issues that the UE would not be able to solve by itself.","paragraph_zero_based":1475},{"literal_text_all_w_t_and_m_t":"1>if configured to provide its preference on DRX parameters of a cell group for power saving and its preference on cell DTX/DRX related parameters:","paragraph_zero_based":1476},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on DRX parameters of the cell group or cell DTX/DRX parameters and the UE did not transmit a UEAssistanceInformation message with drx-Preference for the cell group since it was configured to provide its preference on DRX parameters of the cell group for power saving and cell DTX/DRX parameters; or","paragraph_zero_based":1477},{"literal_text_all_w_t_and_m_t":"2>if the current drx-Preference information for the cell group is different from the one indicated in the last transmission of the UEAssistanceInformation message including drx-Preference for the cell group and timer T346a associated with the cell group is not running:","paragraph_zero_based":1478},{"literal_text_all_w_t_and_m_t":"3>start the timer T346a with the timer value set to the drx-PreferenceProhibitTimer of the cell group;","paragraph_zero_based":1479},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide the current drx-Preference;","paragraph_zero_based":1480},{"literal_text_all_w_t_and_m_t":"1>if configured to provide its preference on the maximum aggregated bandwidth of a cell group for power saving:","paragraph_zero_based":1481},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on the maximum aggregated bandwidth of the cell group and the UE did not transmit a UEAssistanceInformation message with maxBW-Preference and/or maxBW-PreferenceFR2-2 for the cell group since it was configured to provide its preference on the maximum aggregated bandwidth of the cell group for power saving; or","paragraph_zero_based":1482},{"literal_text_all_w_t_and_m_t":"2>if the current maxBW-Preference information for the cell group is different from the one indicated in the last transmission of the UEAssistanceInformation message including maxBW-Preference and/or maxBW-PreferenceFR2-2for the cell group and timer T346b associated with the cell group is not running:","paragraph_zero_based":1483},{"literal_text_all_w_t_and_m_t":"3>start the timer T346b with the timer value set to the maxBW-PreferenceProhibitTimer of the cell group;","paragraph_zero_based":1484},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide the current maxBW-Preference and/or maxBW-PreferenceFR2-2;","paragraph_zero_based":1485},{"literal_text_all_w_t_and_m_t":"1>if configured to provide its preference on the maximum number of secondary component carriers of a cell group for power saving:","paragraph_zero_based":1486},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on the maximum number of secondary component carriers of the cell group and the UE did not transmit a UEAssistanceInformation message with maxCC-Preference for the cell group since it was configured to provide its preference on the maximum number of secondary component carriers of the cell group for power saving; or","paragraph_zero_based":1487}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["00e0f2675b90193d1f88e0d4c8cbf909938da995c06a2644a766fc0ce0b3b72d","7b17962e7c08ca4010d74b5c47f58cfcf6ace917190364e7c39c8d8a02e78529","ff4d38acb1cdd24517dd3ff05c2c39d39d39840fb245ceb0fde4fc7c562eb6b0","f455ce57e0810d5ab40f7bd563aacd79d276c09193c7d0caa8dc406979d88cab","f0fa6bc0e6903f783dcd2d652de2079042145b43e2f77b18cbe231e2ce44df5a","8bd1550afe6816bbb9509ab12aa07245c2c411efb3de822a39a2de604f1d6547","869ab8e1069912f3a78d71ec5315345a6c6652238ba7aa064e31c9443905b1b7","ebb6dddd0631f7a092c9403699c147bd82fad76948ea6d8609ee0b94502d4db9","a2e12e088ae934c4c859097eef97667c304754672586b6a05cd9629ef0342f00","4f4b664e6c3a0e5b8a539770964e6b18238dfb33510890d7bad97d3a4c0ddb66","a029bf59926091c3df5c7f945479380cccbbd3696116062ac628a7ea8e555464","66bdcd181977498e7d2799fed1319c21c81aa8ac13170e6c39018ec6ebeb6774","abdc7d083c1fe51d4f565ea3bee59c76038c9f63f467f69788db91ed7bfc89f3","72b5d205905813b00c82e98f402c7367cdac7fec3547321be46976864573e92f","a45db142eef1a9f851a94d8c0732f0a0dfd1bce270eb13c8b75ec4230f336755","8a78f3c749efc10922eb825793d4935e6fc6d3ffe9b3f06b56ca3907a1cc5c87","1ca7f60bcbeb1754499fbf142a2f3f9bde03b7b4ba009a0f2326f2dbfca042b9","11fefed5893ae293b6a4247c704f775d3dc4c3c75e197016c2cef995e7536599","1bbce27b439bdfa3ae7f7ac3dc98540d7a829de22f8c14061ced7f58c9da8bb8","096d55fa7c749cb025878b53cccef3a5a4475ef1342bed3464c7c808b390cd4f","b00fd5e6838fa65783a17264f9989c20f897c426a2fe836008148bc0fa4d5a18","a1b3fa5b5304316b7f2bc1df81f6ed8097d1e50c6327e58452353f0a22c5aa53","71aa40c42cd759cb4b7a2168f89191dc6ab612c5eb0829a01d037decfde3c9ba","b5da18f66d369d6fec34ee1b3df729724e09d17df146aa5f1babe523714bfb19"],"paragraph_range_zero_based":[1464,1487],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p1464"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if the current maxCC-Preference information for the cell group is different from the one indicated in the last transmission of the UEAssistanceInformation message including maxCC-Preference for the cell group and timer T346c associated with the cell group is not running:","paragraph_zero_based":1488},{"literal_text_all_w_t_and_m_t":"3>start the timer T346c with the timer value set to the maxCC-PreferenceProhibitTimer of the cell group;","paragraph_zero_based":1489},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide the current maxCC-Preference;","paragraph_zero_based":1490},{"literal_text_all_w_t_and_m_t":"1>if configured to provide its preference on the maximum number of MIMO layers of a cell group for power saving:","paragraph_zero_based":1491},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on the maximum number of MIMO layers of the cell group and the UE did not transmit a UEAssistanceInformation message with maxMIMO-LayerPreference and/or maxMIMO-LayerPreferenceFR2-2 for the cell group since it was configured to provide its preference on the maximum number of MIMO layers of the cell group for power saving; or","paragraph_zero_based":1492},{"literal_text_all_w_t_and_m_t":"2>if the current maxMIMO-LayerPreference information for the cell group is different from the one indicated in the last transmission of the UEAssistanceInformation message including maxMIMO-LayerPreference and/or maxMIMO-LayerPreferenceFR2-2 for the cell group and timer T346d associated with the cell group is not running:","paragraph_zero_based":1493},{"literal_text_all_w_t_and_m_t":"3>start the timer T346d with the timer value set to the maxMIMO-LayerPreferenceProhibitTimer of the cell group;","paragraph_zero_based":1494},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide the current maxMIMO-LayerPreference and/or maxMIMO-LayerPreferenceFR2-2;","paragraph_zero_based":1495},{"literal_text_all_w_t_and_m_t":"1>if configured to provide its preference on the minimum scheduling offset for cross-slot scheduling of a cell group for power saving:","paragraph_zero_based":1496},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on the minimum scheduling offset for cross-slot scheduling of the cell group and the UE did not transmit a UEAssistanceInformation message with minSchedulingOffsetPreference and/or minSchedulingOffsetPreferenceExt for the cell group since it was configured to provide its preference on the minimum scheduling offset for cross-slot scheduling of the cell group for power saving; or","paragraph_zero_based":1497},{"literal_text_all_w_t_and_m_t":"2>if the current minSchedulingOffsetPreference and/or minSchedulingOffsetPreferenceExt information for the cell group is different from the one indicated in the last transmission of the UEAssistanceInformation message including minSchedulingOffsetPreference and/or minSchedulingOffsetPreferenceExt for the cell group and timer T346e associated with the cell group is not running:","paragraph_zero_based":1498},{"literal_text_all_w_t_and_m_t":"3>start the timer T346e with the timer value set to the minSchedulingOffsetPreferenceProhibitTimer of the cell group;","paragraph_zero_based":1499},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide the current minSchedulingOffsetPreference and/or minSchedulingOffsetPreferenceExt;","paragraph_zero_based":1500},{"literal_text_all_w_t_and_m_t":"1>if configured to provide its release preference and timer T346f is not running:","paragraph_zero_based":1501},{"literal_text_all_w_t_and_m_t":"2>if the UE determines that it would prefer to transition out of RRC_CONNECTED state; or","paragraph_zero_based":1502},{"literal_text_all_w_t_and_m_t":"2>if the UE is configured with connectedReporting and the UE determines that it would prefer to revert an earlier indication to transition out of RRC_CONNECTED state:","paragraph_zero_based":1503},{"literal_text_all_w_t_and_m_t":"3>start timer T346f with the timer value set to the releasePreferenceProhibitTimer;","paragraph_zero_based":1504},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide the release preference;","paragraph_zero_based":1505},{"literal_text_all_w_t_and_m_t":"1>if configured to provide configured grant assistance information for NR sidelink communication:","paragraph_zero_based":1506},{"literal_text_all_w_t_and_m_t":"2>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide configured grant assistance information for NR sidelink communication;","paragraph_zero_based":1507},{"literal_text_all_w_t_and_m_t":"1>if configured to provide preference in being provisioned with reference time information:","paragraph_zero_based":1508},{"literal_text_all_w_t_and_m_t":"2>if the UE did not transmit a UEAssistanceInformation message with referenceTimeInfoPreference since it was configured to provide preference; or","paragraph_zero_based":1509},{"literal_text_all_w_t_and_m_t":"2>if the UE's preference changed from the last time UE initiated transmission of the UEAssistanceInformation message including referenceTimeInfoPreference:","paragraph_zero_based":1510},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide preference in being provisioned with reference time information.","paragraph_zero_based":1511}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["9c558b8adb2490c4360d93b02176d4221f958d2a81061113677d3d6d8e58d23f","f199139ec9d414748589381605b75fd788d1f1727e50c452ffacb2a19a508daf","4b78328966210bcb1d98ae5928589e4327a3237aac6f34b9d64d95284eca42fe","8f6156ba6b9e1c13cc4f4e6d1fe9984f1e09db512c1fc40a6208eb88b980ad60","2071f1e561a3cff37a533d1d7aa9de82b058f4609a5cbad70b14900262d4fa6f","1f277715bca53aa818475ec7e351c92f37e796a1176e37768484494acf7a9297","55758f02dcfc139a18adbf3902e5cd0ffa3c385446042cc277e1e87207d95fd4","436697765e7da6a267ba58dc6d350554dad04d6e472dde3df8c672375f013a0c","ea74cc62ffb20bfc1e876713a4ca7a811f6d85299764e655a0b1bae8720137f5","88a2f735104ec8cab38edc08900a73f552e65dd0e0916007939fc588d06f2e91","4c127f274e23313b0421bb44dff4ead4473ae532dde64014247f3e4d264e6653","65de87201f0926b114cae8a26e59d52aeb4db5c88b2ab1f7a2ead84cd1e21f6a","1bb855ec62b6da5044f5a21a3c873ae3414f49eb422b18fd9578d1330f50fcab","e7f32ea823589fd35ddd2870946381a91db739043b9cbc486e98e4de707a7fa2","168311bcc34fd247492e36fcaa8e42ee484b91cbd6c8842dd6dd1ceaa31798a6","b74e57e16894312e23f25e7345fd7ec125226a2a95ecf4774504e40e95575b72","bff15e5e35f7ae9f2de68c6650afe140e783bf35a11e31a4d7b6c2d469812212","df50059f9f20fdd4e997a406143c9eabaf936b3659c5fac724ac571dbfe74713","f3f1f1b9e06e8c5a1528873cf2a410367482a324216bffd0a630bfc360291dfd","34affe27fde78470207cb5a1d6f447745355a8624713c68769a97e03487aca1c","b18ca43d8990b7e40c6ff706d52522f93be8118fd6c65d091f4c658bae053a29","98ad84e6f8dee0b1e5040946e4a3b4bdab0586f311ccc6f3f5f0033c08bc40ba","17a6018d3553c7149c722916f6c5f19d58c69aae00898519fa64f710e32a50c6","c86a2de48a992b1c1b9d69c5828278d01637bc2fa0a40533d06657de2c40b105"],"paragraph_range_zero_based":[1488,1511],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p1488"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>if configured to provide its preference on FR2 UL gap:","paragraph_zero_based":1512},{"literal_text_all_w_t_and_m_t":"2>if the UE did not transmit a UEAssistanceInformation message with ul-GapFR2-Preference since it was configured to provide its preference on FR2 UL gap information:","paragraph_zero_based":1513},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference on FR2 UL gap activation/deactivation:","paragraph_zero_based":1514},{"literal_text_all_w_t_and_m_t":"4>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide FR2 UL gap preference;","paragraph_zero_based":1515},{"literal_text_all_w_t_and_m_t":"2>else if the current FR2 UL gap preference is different from the one indicated in the last transmission of the UEAssistanceInformation message:","paragraph_zero_based":1516},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide FR2 UL gap preference.","paragraph_zero_based":1517},{"literal_text_all_w_t_and_m_t":"1>if configured to provide MUSIM assistance information for leaving RRC_CONNECTED:","paragraph_zero_based":1518},{"literal_text_all_w_t_and_m_t":"2>if the UE needs to leave RRC_CONNECTED state and the timer T346g is not running:","paragraph_zero_based":1519},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide MUSIM assistance information for leaving RRC_CONNECTED;","paragraph_zero_based":1520},{"literal_text_all_w_t_and_m_t":"3>start the timer T346g with the timer value set to the musim-LeaveWithoutResponseTimer;","paragraph_zero_based":1521},{"literal_text_all_w_t_and_m_t":"1>if configured to provide MUSIM assistance information for gap preference:","paragraph_zero_based":1522},{"literal_text_all_w_t_and_m_t":"2>if configured to provide MUSIM assistance information for gap priority preference:","paragraph_zero_based":1523},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference on the MUSIM gap(s) and the UE did not transmit a UEAssistanceInformation message with musim-GapPreferenceList and/or musim-GapPriorityPreferenceList and/or musim-GapKeepPreference since it was configured to provide MUSIM assistance information for gap preference and gap priority preference and the timer T346h is not running; or","paragraph_zero_based":1524},{"literal_text_all_w_t_and_m_t":"3>if the current musim-GapPreferenceList and/or musim-GapPriorityPreferenceList and/or musim-GapKeepPreference is different from the one indicated in the last transmission of the UEAssistanceInformation message including musim-GapPreferenceList and/or musim-GapPriorityPreferenceList and/or musim-GapKeepPreference and the timer T346h is not running:","paragraph_zero_based":1525},{"literal_text_all_w_t_and_m_t":"4>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide the current musim-GapPreferenceList and/or musim-GapPriorityPreferenceList and/or musim-GapKeepPreference;","paragraph_zero_based":1526},{"literal_text_all_w_t_and_m_t":"4>start the timer T346h with the timer value set to the musim-GapProhibitTimer.","paragraph_zero_based":1527},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":1528},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference on the MUSIM gap(s) and the UE did not transmit a UEAssistanceInformation message with musim-GapPreferenceList since it was configured to provide MUSIM assistance information for gap preference; or","paragraph_zero_based":1529},{"literal_text_all_w_t_and_m_t":"3>if the current musim-GapPreferenceList is different from the one indicated in the last transmission of the UEAssistanceInformation message including musim-GapPreferenceList and the timer T346h is not running:","paragraph_zero_based":1530},{"literal_text_all_w_t_and_m_t":"4>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide the current musim-GapPreferenceList;","paragraph_zero_based":1531},{"literal_text_all_w_t_and_m_t":"4>start the timer T346h with the timer value set to the musim-GapProhibitTimer.","paragraph_zero_based":1532},{"literal_text_all_w_t_and_m_t":"NOTE 3:The UE does not need to initiate transmission of the UEAssistanceInformation message if the difference between the current musim-GapPreferenceList and the last transmission of the UEAssistanceInformation message including musim-GapPreferenceList is only due to removal of an ended aperiodic gap.","paragraph_zero_based":1533},{"literal_text_all_w_t_and_m_t":"1>if configured to provide MUSIM assistance information for temporary capability restriction:","paragraph_zero_based":1534},{"literal_text_all_w_t_and_m_t":"2>if the UE has temporary capability restriction on the current configuration and timer T348 is not running:","paragraph_zero_based":1535}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["442bccf30a746d68b8e1e92a78b3dbbc2eb8e29dc62e1d8aee5a9334ede7c9a1","b6c6ce49b8e6cfa30000bccced987c4fb9d791ded769a81b1f3b24a8f4bdfac5","851b0f5effda5cd9d07dfc9ff2884c5648add9a34ebe2d4965568855fd4b2d2d","9d89c59784bb3243fafe6dbb71d4d61ef7e42861ee60a6e46348242ff96d4214","aea8a6d3151cffeff0718d7cf191bf2c7cb07a96a326bd8d4301a8e74d9437d2","435ccc844fab93833006f357f53533394782b071794fc4273afe0403909f5c44","d7412f4bb72f979406ade8e0a72e46abc50ca449b5950ce9a7913808086e3152","04cd50695b9ed995c51f41ee8653a9178260d5f8a2fe9be267e3cf5a1913a747","5314702b75d0d9b53710ac81926b8f83d802be43a0dce19ad6085f387a7a2336","7d65c79f9bca5fe138170dda30f9e6265bfb6560858b38f941c9978accd6381d","2a96333997883c007911c2dac7113eff4d3c3962eb4fad9e3e70e0e458d07c36","efa858f181486cf8b0533211818155c270119e7f4365af60e9bf90fe68f52fbb","f8ef4cd1888a20765d28006fdb450ba91934ce580bf0a70e3426365e1c45b800","dfad15f2034bdc3e1e2477440d61c61af964be67ad50fd34fd5971a8b6d00f7d","4f7e9ee9b36daa6e13bb884bc1bf336d9eff233376f09d40803f115c1ba8c08e","c7de00bb59becf0c43dcda4170ae7170790b21c73064cf0b849fca8ddf63dab8","b2f1540db0adf1a9c521f67aa1d65a8e93ccbb2ceafc0e06a47a5960f5f3977a","6497c045a0a40c0a43abbdf1fe3d942c0556655bb86b945d8c45dd9ea2e91b69","41662f08be7e55ca533f08e460d26b67177c5f73360c17745732cf9d3ec0783a","271c41792ef5814153a65f410a24ae1bf0a28952e5dcb83f5c60ff670f2269d8","aeceb6475b36d55d9b8c54c606c45379663161f22dcb5e6c500947e89e7a65d6","b89247c2540ad56763ee61c3bce9b2bcc6a1caac33a87d29ce9118f4ab56009e","36e1d76a530046f09c6c229d269af547596fd8142cde4b2a456654ded3016b74","69ee67bb9b46d64b155019abda8a7aabb51a7be16d1e07092cc6a0e9fd695462"],"paragraph_range_zero_based":[1512,1535],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p1512"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide the current musim-Cell-SCG-ToRelease and/or musim-CellToAffectList;","paragraph_zero_based":1536},{"literal_text_all_w_t_and_m_t":"3>start the timer T348 with the timer value set to the musim-WaitTimer.","paragraph_zero_based":1537},{"literal_text_all_w_t_and_m_t":"2>if the UE has temporary capability restriction on the combination(s) of bands comprising of band(s) included in musim-CandidateBandList or if the UE has temporary capability restriction on the maximum CC number, and the UE did not transmit a UEAssistanceInformation message with musim-AffectedBandsList and/or musim-AvoidedBandsList and/or musim-MaxCC since it was configured to provide MUSIM assistance information for temporary capability restriction and timer T346n is not running; or","paragraph_zero_based":1538},{"literal_text_all_w_t_and_m_t":"2>if the current musim-AffectedBandsList and/or musim-AvoidedBandsList and/or musim-MaxCC is different from the one indicated in the last transmission of the UEAssistanceInformation message including musim-CapRestriction and timer T346n is not running:","paragraph_zero_based":1539},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide the current musim-AffectedBandsList and/or musim-AvoidedBandsList and/or musim-MaxCC;","paragraph_zero_based":1540},{"literal_text_all_w_t_and_m_t":"3>start the timer T346n with the timer value set to the musim-ProhibitTimer.","paragraph_zero_based":1541},{"literal_text_all_w_t_and_m_t":"2>if the UE is configured to provide the measurement gap requirement information of NR target bands and if the current measurement gap requirement information is different from the one indicated in the last transmission of the UEAssistanceInformation message including musim-NeedForGapsInfoNR or RRCReconfigurationComplete message or RRCResumeComplete message including needForGapsInfoNR:","paragraph_zero_based":1542},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide the current musim-NeedForGapsInfoNR;","paragraph_zero_based":1543},{"literal_text_all_w_t_and_m_t":"2>if the UE has included musim-CapRestrictionInd in the RRCSetupComplete message or RRCResumeComplete or RRCReestablishmentComplete message and the temporary capability restriction is not applicable when the UE is configured to provide MUSIM assistance information for temporary capability restriction:","paragraph_zero_based":1544},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to indicate that there is no temporary capability restriction;","paragraph_zero_based":1545},{"literal_text_all_w_t_and_m_t":"1>if configured to provide the relaxation state of RLM measurements of a cell group and RLM measurement of the cell group is not stopped:","paragraph_zero_based":1546},{"literal_text_all_w_t_and_m_t":"2>if the UE did not transmit a UEAssistanceInformation message with rlm-MeasRelaxationState since it was configured to provide the relaxation state of RLM measurements for the cell group; or","paragraph_zero_based":1547},{"literal_text_all_w_t_and_m_t":"2>if the relaxation state of RLM measurements for the cell group is currently different from the relaxation state reported in the last transmission of the UEAssistanceInformation message including rlm-MeasRelaxationState of the cell group and timer T346j associated with the cell group is not running:","paragraph_zero_based":1548},{"literal_text_all_w_t_and_m_t":"3>start timer T346j with the timer value set to the rlm-RelaxtionReportingProhibitTimer;","paragraph_zero_based":1549},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide the relaxation state of RLM measurements of the cell group;","paragraph_zero_based":1550},{"literal_text_all_w_t_and_m_t":"1>if configured to provide the relaxation state of BFD measurements of serving cells of a cell group and BFD measurement of the cell group is not stopped:","paragraph_zero_based":1551},{"literal_text_all_w_t_and_m_t":"2>if the UE did not transmit a UEAssistanceInformation message with bfd-MeasRelaxationState since it was configured to provide the relaxation state of BFD measurements for the cell group; or","paragraph_zero_based":1552},{"literal_text_all_w_t_and_m_t":"2>if the relaxation state of BFD measurements in any serving cell of the cell group is currently different from the relaxation state reported in the last transmission of the UEAssistanceInformation message including bfd-MeasRelaxationState of the cell group and timer T346k associated with the cell group is not running:","paragraph_zero_based":1553},{"literal_text_all_w_t_and_m_t":"3>start timer T346k with the timer value set to the bfd-RelaxtionReportingProhibitTimer;","paragraph_zero_based":1554},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide the relaxation state of BFD measurements of serving cells of the cell group.","paragraph_zero_based":1555},{"literal_text_all_w_t_and_m_t":"1>if data and/or signalling mapped to radio bearers not configured for SDT becomes available during SDT (i.e. while SDT procedure is ongoing):","paragraph_zero_based":1556},{"literal_text_all_w_t_and_m_t":"2>if the UE did not transmit a UEAssistanceInformation message with nonSDT-DataIndication since the initiation of the current resume procedure for SDT:","paragraph_zero_based":1557},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide nonSDT-DataIndication.","paragraph_zero_based":1558},{"literal_text_all_w_t_and_m_t":"1>if configured to provide its preference for SCG deactivation and timer T346i is not running;","paragraph_zero_based":1559}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["99d826f6e936c0b2e9e3bd00311f551d5d91e990951be0665b7c142dab7ee5fc","686c4a8ec39037ae4bbc4b7bb1ad71e7c1e1a40d006328ab100a4ff67f19ab0a","0b92a83047a9802570f1db487d170bfba56f131b5f6b289c41f3adbef4dd5bfd","d59270d996419c60ac973b5fdaed137c350f30b970b62afaa5dc68e308c48b02","bed8016c9ed613dac439cb1d1cfffac67ddd6dd4c0f3c741280434d0f00903d0","220232a228b93670b1189860f14d8d447913b6e31bedef2b2d280d2f3d12087f","0e9e27e21ecf840dae4a12ac8deb520b5745976f081a6bf608c0a5f14d480c1f","32c1542351e7ffc10b104685a5a0a805bd8a4f770dc48c894c4ed594c234a1e6","d44096a641383938c5f9e88f340402c7b7d2fc61c221d7cc5bb4940fc404d157","c71a99170279735966a85ee01742c068cf6d463a4776c459d00d38ffbd98914a","0ca6777ef21690f1296f85432b0277a2838cc23e460ccf09de4930e0b826fe5a","b4d4a624bc2c6af492169d8a5dabd4c173ece23c994158f4ff6de0c0712e8373","da52a5c16a616dff225875c0d54f0db5da21f2915669cea78d6543daaffd7871","1a787bb6acd50d6f5bee7d29168e00c7cbfa7fa9712fc974d5138efe9c12539e","fba98f53d476c875213095edd30ba29056ee4a7b461b3c03c7441a31dd7ccbc6","1991f7086eea92c481f4b5414a7d748d7a433d0dd33c3b5f1508980580a02f00","de9c646f782b8968e20700a76d278a5f1b63afb0cb84675b53f7ffbada8b2594","acdd6da4fcd5a114531ffdf0d7387b8c197a27cc26391efde5a326872084574b","6da6caf067eacd4869c99ceded294cd9ca6054b9e10041bbb5a1e9ace9b3cb48","496bfa31dc8b8f840879d7f85780cdee6aa4fdc74feca4cb92d76701052d2ee8","d461d635051d2a06f8cd798d11311de9ae218af692e7120a5f1895922cee3a61","7497e1db92d7f802d2c45db7b12f785ea2c4babb3e3130cad92025da96ce574c","222e37eb0199097dfbd9bf505fbc3e0cefa38380c05858a8a4ae70c90f68be90","5651281182a00fb03b3b8ae0ce8c71cfcdc27a061111b66db3da0ef6f12f330d"],"paragraph_range_zero_based":[1536,1559],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p1536"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if the UE prefers the SCG to be deactivated and did not transmit a UEAssistanceInformation message with scg-DeactivationPreference since it was configured to provide its SCG deactivation preference; or","paragraph_zero_based":1560},{"literal_text_all_w_t_and_m_t":"2>if the UE preference for SCG deactivation is different from the last indicated scg-DeactivationPreference:","paragraph_zero_based":1561},{"literal_text_all_w_t_and_m_t":"3>start timer T346i with the timer value set to the scg-DeactivationPreferenceProhibitTimer;","paragraph_zero_based":1562},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide the UE preference for SCG deactivation;","paragraph_zero_based":1563},{"literal_text_all_w_t_and_m_t":"1>if the SCG is deactivated, and,","paragraph_zero_based":1564},{"literal_text_all_w_t_and_m_t":"1>the UE has uplink data to send for an SCG RLC entity while the UE previously did not have any uplink data to send for any SCG RLC entity:","paragraph_zero_based":1565},{"literal_text_all_w_t_and_m_t":"2>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to indicate that the UE has uplink data to send for a DRB whose DRB-Identity is not included in any RLC-BearerConfig in the CellGroupConfig associated with the MCG.","paragraph_zero_based":1566},{"literal_text_all_w_t_and_m_t":"1>if configured to send indications of RRM measurement relaxation criterion fulfilment:","paragraph_zero_based":1567},{"literal_text_all_w_t_and_m_t":"2>if the criterion in 5.7.4.4 is met for a period of TSearchDeltaP-StationaryConnected:","paragraph_zero_based":1568},{"literal_text_all_w_t_and_m_t":"3>if the UE did not transmit a UEAssistanceInformation message with rrm-MeasRelaxationFulfilment as true since it was configured to provide indications of RRM measurement relaxation criterion fulfilment; or","paragraph_zero_based":1569},{"literal_text_all_w_t_and_m_t":"3>the last UEAssistanceInformation message indicated the criterion in 5.7.4.4 is not fulfilled with rrm-MeasRelaxationFulfilment as false:","paragraph_zero_based":1570},{"literal_text_all_w_t_and_m_t":"4>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to indicate that the criterion for RRM measurement relaxation for connected mode is fulfilled;","paragraph_zero_based":1571},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":1572},{"literal_text_all_w_t_and_m_t":"3>if the last UEAssistanceInformation message indicated fulfilment of the criterion in 5.7.4.4 with rrm-MeasRelaxationFulfilment as true:","paragraph_zero_based":1573},{"literal_text_all_w_t_and_m_t":"4>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to indicate that the criterion for RRM measurement relaxation for connected mode is not fulfilled.","paragraph_zero_based":1574},{"literal_text_all_w_t_and_m_t":"1>if configured to provide service link propagation delay difference between serving cell and neighbour cell(s);","paragraph_zero_based":1575},{"literal_text_all_w_t_and_m_t":"2>if the UE did not transmit a UEAssistanceInformation message with propagationDelayDifference since it was configured to provide service link propagation delay difference between serving cell and neighbour cell(s); or","paragraph_zero_based":1576},{"literal_text_all_w_t_and_m_t":"2>for any neighbour cell in neighCellInfoList, if the service link propagation delay difference between serving cell and the neighbour cell has changed more than threshPropDelayDiff since the last transmission of the UEAssistanceInformation message including propagationDelayDifference:","paragraph_zero_based":1577},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide service link propagation delay difference between serving cell and each neighbour cell included in the neighCellInfoList;","paragraph_zero_based":1578},{"literal_text_all_w_t_and_m_t":"1>if configured to provide its preference for multi-Rx operation and timer T346m is not running;","paragraph_zero_based":1579},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on multi-Rx operation for FR2 and did not transmit a UEAssistanceInformation message with multiRx-PreferenceFR2 since it was configured to provide its preference on multi-Rx operation; or","paragraph_zero_based":1580},{"literal_text_all_w_t_and_m_t":"2>if the UE has a different preference on multi-Rx operation for FR2 from the last indicated multiRx-PreferenceFR2:","paragraph_zero_based":1581},{"literal_text_all_w_t_and_m_t":"3>start timer T346m with the timer value set to the multiRx-PreferenceReportingConfigFR2ProhibitTimer;","paragraph_zero_based":1582},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide the UE preference for multi-Rx operation for FR2.","paragraph_zero_based":1583}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["cd533341243d4d5b4b086b28fbec540c5f64666ce36fdb9a953cfc363b03e4e7","db328adc563715a85b4d69b703448e0d294fce2d264239c9f9aeb1b2f92a0a39","64f9ec41bd84fd6f512820d8b13e9745f70c4e5ef5ae86ffc077aa9b04c62a82","ca3f06209d8c014508af0d116b59ca7863701fd1a7cbe40aabda1741681a410b","87a41e4acf96c6df27dcf050a794aa26aa94b455cddd31eb5eaf0782da1017c7","b87a03520863b0ffed9e1d2e64b0566dc10e6cde088a68dd0f5b95242d7c85d2","8f1ff468e39a66a6fb670a1a903a9517de18f7061b6cf1da2306d4151e31593a","2e4b38a67bbf0f709abae100852a24f5682ffbaa80954c81a1d12acc119ba59c","44ae0f876a7f57478f87a5b94437492f0423980784d3466505b79578bb98a9bb","4b6fa5907922e5f4fb662fb15781cbe2f0a7759b360541bfcfcf18d164826471","0ab752ad95e597b10a599debc893322855334903301df161516c92a21c65dde0","773d763dd78b1be59e69bf5a04209053c18c5048a1a82877d4334fceaade0372","5832719d985acfb8ef1e9056368927ca4e4d74c9bd7ac943563c91934ed60116","67e31d9ace29f940baf5f68940a81a499b712579a61b5f086cbc4050da95f031","eae17db9fc6a8f1e425e0579d3528d21fa636ae2643723f115ea65eaa0447731","e2a05502a61f77a4738adc37affb506973eca13ad532777d9c29c44eaafde540","7f41dbc2cf659357476e70e4984f0de2ce47fa2ffe853bf1798ddd9f56ae99e5","ccdfe5aa4d4ee4c53b64575b3dacbd16cb2de7d778e29da780a6fb36bafc059e","86c0b02defca4a8b598955a37d6754c46b662004a16b9db9239d95c2651687cc","e4e90838eba74d35e34e4dd1dfb3e09f2284ea6514ef32a4ebaa7aa741e60f8f","f1eb4f5aec1d665774e52d643166baf4bedbd45de9118cc6a14b251b3ebf1eaa","4cb273b2b246bff64b913d6bf1e7adebfee327faabe0b12f6e8ef541f313ff48","6ffa5e95ae0031bd0f31cbd02079338bc5114045387b78c85fd8715c2b8c0564","45b203db837b79232b5725ea0a73ae82d9e0a2c35fed04aea3e085b065383e6c"],"paragraph_range_zero_based":[1560,1583],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p1560"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>if configured to indicate the availability of flight path information and the UE has (updated) flight path information available:","paragraph_zero_based":1584},{"literal_text_all_w_t_and_m_t":"2>if the UE had neither provided a flight path information nor indicated the availability of flight path information since last entering RRC_CONNECTED state; or","paragraph_zero_based":1585},{"literal_text_all_w_t_and_m_t":"2>if at least one waypoint or a timestamp corresponding to a waypoint location that was not previously provided since last entering RRC_CONNECTED state is available; or","paragraph_zero_based":1586},{"literal_text_all_w_t_and_m_t":"2>if at least one upcoming waypoint or a timestamp corresponding to a waypoint location that was previously provided since last entering RRC_CONNECTED state is to be removed; or","paragraph_zero_based":1587},{"literal_text_all_w_t_and_m_t":"2>if flightPathUpdateDistanceThr is configured and, for at least one waypoint, the 3D distance between the previously provided location and the new location is more than the distance threshold configured by flightPathUpdateDistanceThr; or","paragraph_zero_based":1588},{"literal_text_all_w_t_and_m_t":"2> if flightPathUpdateTimeThr is configured and, for at least one waypoint, the time difference between the previously provided timestamp and the new timestamp, if available, is more than the time threshold configured by flightPathUpdateTimeThr:","paragraph_zero_based":1589},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to indicate the availability of flight path information;","paragraph_zero_based":1590},{"literal_text_all_w_t_and_m_t":"NOTE 4:If neither flightPathUpdateDistanceThr nor flightPathUpdateTimeThr is configured, it is up to UE implementation whether to initiate transmission of the UEAssistanceInformation message when updated flight path information is available.","paragraph_zero_based":1591},{"literal_text_all_w_t_and_m_t":"1>if configured to provide UL traffic information:","paragraph_zero_based":1592},{"literal_text_all_w_t_and_m_t":"2>if the UE did not transmit a UEAssistanceInformation message with ul-TrafficInfo since it was configured to provide UL traffic information; or","paragraph_zero_based":1593},{"literal_text_all_w_t_and_m_t":"2>if UL traffic information included in the previous UEAssistanceInformation has changed since the last transmission of the UEAssistanceInformation message containing ul-TrafficInfo for at least one QoS flow for which timer T346l is not running:","paragraph_zero_based":1594},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide UL traffic information.","paragraph_zero_based":1595},{"literal_text_all_w_t_and_m_t":"NOTE 5:The UE only considers burstArrivalTime to have changed when it changes relative to the periodicity of the Data Burst arrival.","paragraph_zero_based":1596},{"literal_text_all_w_t_and_m_t":"1>if configured to report relay UE information with non-3GPP connection(s):","paragraph_zero_based":1597},{"literal_text_all_w_t_and_m_t":"2>if the UE did not transmit a UEAssistanceInformation message with n3c-relayUE-InfoList since it was configured to report available relay UE information with non-3GPP connection(s); or","paragraph_zero_based":1598},{"literal_text_all_w_t_and_m_t":"2>if the UE has new available non-3GPP connection(s); or","paragraph_zero_based":1599},{"literal_text_all_w_t_and_m_t":"2>if the non-3GPP connection(s) with the reported relay UE(s) is not available:","paragraph_zero_based":1600},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to report relay UE information with non-3GPP connection(s) included in the n3c-relayUE-InfoList;","paragraph_zero_based":1601},{"literal_text_all_w_t_and_m_t":"1>if configured to provide configured grant assistance information for NR sidelink positioning:","paragraph_zero_based":1602},{"literal_text_all_w_t_and_m_t":"2>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide configured grant assistance information for NR sidelink positioning;","paragraph_zero_based":1603},{"literal_text_all_w_t_and_m_t":"1>if configured to provide its preference for gap occasion cancellation ratio:","paragraph_zero_based":1604},{"literal_text_all_w_t_and_m_t":"2>if the UE did not transmit a UEAssistanceInformation message with gapOccasionCancelRatio since it was configured to do so and if the UE has the preference for gap occasion cancellation ratio for at least one measurement gap configuration; or","paragraph_zero_based":1605},{"literal_text_all_w_t_and_m_t":"2>if the UE's preference for gap occasion cancellation ratio has changed for at least one measurement gap configuration since the last transmission of the UEAssistanceInformation message with gapOccasionCancelRatio and T346o is not running:","paragraph_zero_based":1606},{"literal_text_all_w_t_and_m_t":"3>start the timer T346o with the timer's value set to gapOccasionCancelRatioProhibitTimer;","paragraph_zero_based":1607}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["12715db36f568874059283599441ee8621419154b255eb2239842d29fc8fe873","bac2f9323f4c24a16d935a059b5d9c64025c5d80c4957df0220bc44369c003f4","fedbbfba618f382ba29d9bd443b0f6903634bb04c33b719484a66d29b89b630e","7c19058583f2967f9d1d35cb658de02a914c9a2a4cad4c16ec07e05da4b01fbb","aec9793a717c293ce388db825e64472137a10b027fe36ecc709d16d5301ff1eb","64f32ac6d0624c1156c02b38be7263670847bb3ff13a28b8119ae4ea8e0c5574","e47be4f780b4476ac04837c0aca98efdd7c63b8af4ceafde452e9796d366e339","5b148f8c42a86a0dbb8a149a82eb7a82cf53900ea12ab275deff7252dbdf91d3","42da6aced923b7421f46408691fe05cfda9dd2288a361cd1ef4a6eec5860b42a","45ef2c55e50473890f046235e9bd8a9c6879a06a6e920062142799e38ebdd51c","c97e4be6a2af0f54cf0a037b85fcdee13044fbae1a5e674cbd4f619e14a757cb","c23803c59ba5b0be6625ac23bfcc04eec93c69dd63a2562f173402b0bbd7debb","6b82ada91c029a71e546bdd5616cca7fa15a0815b5f7adfe22decd12b3bae5e7","7751daca427d8d62085f9a335d089715236f5dd160becce43b3126c8084af5a2","90710439f3041dfc71b1a111e71ce1680049f4d2c2b5388a1f10bdf48196aabd","b1b8a8192b98428e81d6127b8025e79fa41258c27496e50e7a71f690e521581a","2619126298509582032518b42dc90fe222c5430eea197ccc1e533d9ec006fc2c","b073d87a72dbdd7e77f292a206a347f63b6699219b7632edf2c422df4bf5f3a9","5c4013ce3923bbd1cd41a1946a6906cde18c56d39968f311d36aa5d847566dd9","1b8f2b07035920084127bd26063920eae7bf3bf3e2a9043d9680331a566c2690","dd9183eeb20704250162e73c79b05b9218de2814e7ae455315295469691d2b4a","5ae700f667cada65aed45e33c197785ddf6a99832d53de741fd661cf2b252fea","ff7b7def72ed690ce3382bb2dc8f54a2ad7e00a8fbd6f2f0d0e8782ad5b91106","6ab9b82697f8764f3dc74bbdaf2a84ce47e03dffb7b5c4790556b61cbea4b265"],"paragraph_range_zero_based":[1584,1607],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p1584"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide UE's preference for gap occasion cancellation ratio.","paragraph_zero_based":1608},{"literal_text_all_w_t_and_m_t":"1>if configured to provide its preference on time offset for LP-WUS monitoring of a cell group:","paragraph_zero_based":1609},{"literal_text_all_w_t_and_m_t":"2>if [the UE has a preference on time offset for LP-WUS monitoring of the cell group and] the UE did not transmit a UEAssistanceInformation message with lpwus-OffsetPreference for the cell group since it was configured to provide its preference on time offset for LP-WUS monitoring of the cell group for power saving; or","paragraph_zero_based":1610},{"literal_text_all_w_t_and_m_t":"Editor´s note: Brackets should be deleted when issue is resolved.","paragraph_zero_based":1611},{"literal_text_all_w_t_and_m_t":"2>if the current lpwus-OffsetPreference information for the cell group is different from the one indicated in the last transmission of the UEAssistanceInformation message including lpwus-OffsetPreference for the cell group and timer T346p associated with the cell group is not running:","paragraph_zero_based":1612},{"literal_text_all_w_t_and_m_t":"3>start the timer T346p with the timer value set to the lpwus-OffsetPreferenceProhibitTimer of the cell group;","paragraph_zero_based":1613},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide the current lpwus-OffsetPreference.","paragraph_zero_based":1614},{"literal_text_all_w_t_and_m_t":"1>if configured to report assistance information about the applicability of configurations subject to the applicability determination procedure:","paragraph_zero_based":1615},{"literal_text_all_w_t_and_m_t":"2>if the applicability status of configurations subject to the applicability determination procedure has changed since the last transmission of a message containing applicabilityReportList in RRCReconfigurationComplete or in UEAssistanceInformation or in RRCResumeComplete):","paragraph_zero_based":1616},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to report assistance information about the applicability of configurations subject to the applicability determination procedure;","paragraph_zero_based":1617},{"literal_text_all_w_t_and_m_t":"1>if configured to provide its preference to be configured with radio measurement resources for UE-side data collection:","paragraph_zero_based":1618},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference to be configured with radio measurement resources to perform UE-side data collection or to stop configured data collection configurations and did not transmit a UEAssistanceInformation message with dataCollectionPreference since it was configured to provide its preference to be configured with radio measurement resources to perform UE-side data collection; or","paragraph_zero_based":1619},{"literal_text_all_w_t_and_m_t":"2>if the preference to be configured with radio measurement resources to perform UE-side data collection or to stop configured data collection configurations has changed since the last transmission of the UEAssistanceInformation message including dataCollectionPreference:","paragraph_zero_based":1620},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to report the UE preference to be configured with radio measurement resources for UE-side data collection;","paragraph_zero_based":1621},{"literal_text_all_w_t_and_m_t":"1>if configured to provide assistance information related to logging of measurements for network-side data collection based on loggedDataCollectionAssistanceConfig:","paragraph_zero_based":1622},{"literal_text_all_w_t_and_m_t":"2>if the memory reserved for the logging of radio measurements for network-side data collection has become full; or","paragraph_zero_based":1623},{"literal_text_all_w_t_and_m_t":"2>if the UE determines that it has entered a low power state; or","paragraph_zero_based":1624},{"literal_text_all_w_t_and_m_t":"2>if loggedDataCollectionMemoryThreshold is included in loggedDataCollectionAssistanceConfig and the amount of logged data related to radio measurements for network-side data collection has become equal to or above the loggedDataCollectionMemoryThreshold:","paragraph_zero_based":1625},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide assistance information related to logging of measurements for network-side data collection.","paragraph_zero_based":1626},{"literal_text_all_w_t_and_m_t":"NOTE 6:It is up to UE implementation how to determine a low power state and how to determine whether the memory threshold is reached or if the memory is full.","paragraph_zero_based":1627},{"literal_text_all_w_t_and_m_t":"1>if configured to provide location information for assisted SMTC configuration in RRC_CONNECTED state:","paragraph_zero_based":1628},{"literal_text_all_w_t_and_m_t":"2>if the current closest reference locations are different from the ones indicated in the last transmission including referenceLocationReport:","paragraph_zero_based":1629},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide location information for assisted SMTC configuration;","paragraph_zero_based":1630},{"literal_text_all_w_t_and_m_t":"NEXT CHANGE","paragraph_zero_based":1631}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["c30cf843505004f716bce09d5a702280642bd8232334f192c8d4d8c4ea72883f","1290c666f3a71a40ceb5a2ee13a95ff9b1dcac81a6399939799788700f779420","6f25ddfef809025c5d87c81146fe1176acf249bbe3ef317a4456dedf02733138","0115420c3b1a8fce7dbc2113ec6a948cb5a8498537d3ac01b126c2181ca8639e","dab631f648d275e3fa438fc60b535b90f74c5d390ea18caaba17e4bf98d0c95a","45b286932ee90d2022a9a234c6032fbbb2e9b1849c209395adf8e758c7f4df0d","938c239bdeda13fd4121b0b9b22e4d10d2ac52302403ee61837b6fc052c4b48c","701c9cdd19a9aebf4b84f0ea90b54cf8123ce710547806c22356b8c07375f4e6","66850604d8351db2f7be55d2cb9516474f1bbeac9af565e5d9497c73bc1cbaf9","38c5bfc6a98c56cae1d86174f83f4a6d8d72730b8a0da52588d3d84281313097","f2ffcbb847feb9a0582a554b1bf15e4b5c076a8bb3a361a6f13ce427b1aa1417","d9bd44cdb9ee05db6a3ec1e820639b05cbeeb13e7ad9510764263dbdaac84ce3","37c209c1e056c3f9d49edbe4d28a4e6cdfaac7077235582a0a153b3c04be22a8","8fff3211498f1aa2236da26d35c062f0bfb5bbc97890c9a5593a825b8f76fa72","c948c9037309ba50ca45b307379d3a69d3e1e72259d9dd5703f1203298664edf","423984e2a552b776725c8c464cc34fdb6286768e20d4254c3b4b5d4b1a735054","078d0761753f9d3f0c89cb8d541cde8e67b3651b2a56522cc66869ca501409f3","49b5db798608f1004a7414f19ec3f8ca02fbbba2ab04595f444036e7143594e9","3f7c36f2aed7cf5a0af94499212f0090ea7966e5d7528164cd74cb5bbafad86f","71c14240b92ffd20c7d580929e7346c558035b421cb9e4805b7ef7b64430eeb7","48e8d7ab40cce1ec9f743aa6ce83696d54d578756938863ca0e6a22b12d3cc93","09b8fce5fa3ba24701145ae9372aedcb9fe14e285042e9e7dabd4e2194a42684","4bddd92c19ecc1f08064224cf2660c6e94e2a868b21871e80876ca8a60c5230f","9d78870a9d60f98d5de0a0542d26fd57081ef4cd9699fb6eb9545515c1ddd331"],"paragraph_range_zero_based":[1608,1631],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p1608"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.7.4.3Actions related to transmission of UEAssistanceInformation message","paragraph_zero_based":1632},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of the UEAssistanceInformation message as follows:","paragraph_zero_based":1633},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide a delay budget report according to 5.7.4.2 or 5.3.5.3;","paragraph_zero_based":1634},{"literal_text_all_w_t_and_m_t":"2>set delayBudgetReport to type1 according to a desired value;","paragraph_zero_based":1635},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide overheating assistance information according to 5.7.4.2 or 5.3.5.3;","paragraph_zero_based":1636},{"literal_text_all_w_t_and_m_t":"2>if the UE experiences internal overheating:","paragraph_zero_based":1637},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to temporarily reduce the number of maximum secondary component carriers:","paragraph_zero_based":1638},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxCCs in the OverheatingAssistance IE;","paragraph_zero_based":1639},{"literal_text_all_w_t_and_m_t":"4>set reducedCCsDL to the number of maximum SCells the UE prefers to be temporarily configured in downlink;","paragraph_zero_based":1640},{"literal_text_all_w_t_and_m_t":"4>set reducedCCsUL to the number of maximum SCells the UE prefers to be temporarily configured in uplink;","paragraph_zero_based":1641},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to temporarily reduce maximum aggregated bandwidth of FR1:","paragraph_zero_based":1642},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxBW-FR1 in the OverheatingAssistance IE;","paragraph_zero_based":1643},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-DL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all downlink carriers of FR1;","paragraph_zero_based":1644},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-UL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all uplink carriers of FR1;","paragraph_zero_based":1645},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to temporarily reduce maximum aggregated bandwidth of FR2-1:","paragraph_zero_based":1646},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxBW-FR2 in the OverheatingAssistance IE;","paragraph_zero_based":1647},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-DL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all downlink carriers of FR2-1;","paragraph_zero_based":1648},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-UL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all uplink carriers of FR2-1;","paragraph_zero_based":1649},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to temporarily reduce maximum aggregated bandwidth of FR2-2:","paragraph_zero_based":1650},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxBW-FR2-2 in the OverheatingAssistance IE;","paragraph_zero_based":1651},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-FR2-2-DL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all downlink carriers of FR2-2;","paragraph_zero_based":1652},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-FR2-2-UL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all uplink carriers of FR2-2;","paragraph_zero_based":1653},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to temporarily reduce the number of maximum MIMO layers of each serving cell operating on FR1:","paragraph_zero_based":1654},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxMIMO-LayersFR1 in the OverheatingAssistance IE;","paragraph_zero_based":1655}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["52c8dac680a590ad4eb8240637e37d0833fa6b453d6136ca554d3e5b888d68fa","046ef5129d059f35c1de8449c537e3b86702d9a61a35ebb16fd574701025a68e","c4704ce5ee02aba5d25a16fc4b7b244f35dbda799318d0d942b8babc272ff342","a006b8193fe73f7badd6f15b046eb522365032fd98945adf6ab554dbf2843de7","d142675824f2c563b854094b9ea94b9b9a27708c0df7583c4a2904aeef540e62","7727849f6c16b0cd78b7d6c662b82d582b7dd96c053f7769ba568f97cad42935","42bb776caed981feec799cbef2017dc079e6d961058d163a99664d417aadbf90","73e503750488e1afc285ea39b616fc0dadb673a96095492e9536dcdf8484d633","cda651d818164f77c2a35f39cc08a4553cdd7e389fd01b0cf2b0a1639a02a9f2","f5dae011b19912ceee7613ed1793158c7ab72dbf325c4c7f834e7a335d828179","52084fe41433075a87bb5ad3e0ec1c1451714880b4e4eeeb651e1e10a3675a4b","fac21143351e3d16705b0497ca26d6692bb52a71701429addb5fda3d132163d1","83568651891509be05d25fc85b6d203be906d8b866958fe4efa577e7d324dfe5","d1b7fe77eceeb8fe278c0cca06840f54dc0ab95760c4f1a285954fec36646ba6","8ba144a2482394a0011f7ab4aeec04817d1966a18ca1e257c55c70ffea59bd53","8d0dc528ca3c3c10144c1f12754729f945ee333829b40c940847f7986ce7b660","14c8c6641ee538fdaed898ce35afb483d51b1870ffb6ad9cb47c56830f11585a","5caccae6525df2c3e13fda10a2b9d21025f55fe574773adc6079852cc5b4c990","72ff71e216da83f4b8bc833a65c181e54c4b695c6591f5fbd8550afd851eb323","6cf127aed983c368fc5076e2cbac95237484ecd3f4ec4c9f1357036f4ec77b2c","20c00145c0ecdc78fd98fdf3a7aa67c31c70743d4795003e08d9f288192bfb77","451c9c4ff97fa28a6ccf8d391a91cadfb6b83b73040ee8f0b2309699b0e79355","8812d684c1cd0343bc8ddd4b199f9cde7114bc3d96562081813455eff04aad9c","1f017ab6301d737bb7bf88226ef4183b80ea5e80609c3ba87c7f3597e397e866"],"paragraph_range_zero_based":[1632,1655],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p1632"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR1-DL to the number of maximum MIMO layers of each serving cell operating on FR1 the UE prefers to be temporarily configured in downlink;","paragraph_zero_based":1656},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR1-UL to the number of maximum MIMO layers of each serving cell operating on FR1 the UE prefers to be temporarily configured in uplink;","paragraph_zero_based":1657},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to temporarily reduce the number of maximum MIMO layers of each serving cell operating on FR2-1:","paragraph_zero_based":1658},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxMIMO-LayersFR2 in the OverheatingAssistance IE;","paragraph_zero_based":1659},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR2-DL to the number of maximum MIMO layers of each serving cell operating on FR2-1 the UE prefers to be temporarily configured in downlink;","paragraph_zero_based":1660},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR2-UL to the number of maximum MIMO layers of each serving cell operating on FR2-1 the UE prefers to be temporarily configured in uplink;","paragraph_zero_based":1661},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to temporarily reduce the number of maximum MIMO layers of each serving cell operating on FR2-2:","paragraph_zero_based":1662},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxMIMO-LayersFR2-2 in the OverheatingAssistance IE;","paragraph_zero_based":1663},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR2-2-DL to the number of maximum MIMO layers of each serving cell operating on FR2 the UE prefers to be temporarily configured in downlink;","paragraph_zero_based":1664},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR2-2-UL to the number of maximum MIMO layers of each serving cell operating on FR2 the UE prefers to be temporarily configured in uplink;","paragraph_zero_based":1665},{"literal_text_all_w_t_and_m_t":"2>else (if the UE no longer experiences an overheating condition):","paragraph_zero_based":1666},{"literal_text_all_w_t_and_m_t":"3>do not include reducedMaxCCs, reducedMaxBW-FR1, reducedMaxBW-FR2, reducedMaxBW-FR2-2, reducedMaxMIMO-LayersFR1, reducedMaxMIMO-LayersFR2 or reducedMaxMIMO-LayersFR2-2 in OverheatingAssistance IE;","paragraph_zero_based":1667},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide IDC FDM assistance information according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":1668},{"literal_text_all_w_t_and_m_t":"2>if there is at least one carrier frequency included in candidateServingFreqListNR, the UE is experiencing IDC problems that it cannot solve by itself:","paragraph_zero_based":1669},{"literal_text_all_w_t_and_m_t":"3>include the field affectedCarrierFreqList with an entry for each affected carrier frequency included in candidateServingFreqListNR;","paragraph_zero_based":1670},{"literal_text_all_w_t_and_m_t":"3>for each carrier frequency included in the field affectedCarrierFreqList, include interferenceDirection and set it accordingly;","paragraph_zero_based":1671},{"literal_text_all_w_t_and_m_t":"2>if there is at least one supported UL CA or NR-DC combination comprising of carrier frequencies included in candidateServingFreqListNR, the UE is experiencing IDC problems that it cannot solve by itself:","paragraph_zero_based":1672},{"literal_text_all_w_t_and_m_t":"3>include victimSystemType for each UL CA or NR-DC combination included in affectedCarrierFreqCombList;","paragraph_zero_based":1673},{"literal_text_all_w_t_and_m_t":"3>if the UE sets victimSystemType to wlan or bluetooth:","paragraph_zero_based":1674},{"literal_text_all_w_t_and_m_t":"4>include affectedCarrierFreqCombList with an entry for each supported UL CA combination comprising of carrier frequencies included in candidateServingFreqListNR, that is affected by IDC problems;","paragraph_zero_based":1675},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":1676},{"literal_text_all_w_t_and_m_t":"4>optionally include affectedCarrierFreqCombList with an entry for each supported UL CA or NR-DC combination comprising of carrier frequencies included in candidateServingFreqListNR, that is affected by IDC problems;","paragraph_zero_based":1677},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide IDC enhanced FDM assistance information according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":1678},{"literal_text_all_w_t_and_m_t":"2>if there is at least one affected frequency range overlapping with one candidate frequency range included in candidateServingFreqRangeListNR, and the center frequency of the affected frequency range is within the candidate frequency range included in candidateServingFreqRangeListNR, the UE is experiencing IDC problems that it cannot solve by itself:","paragraph_zero_based":1679}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["0600f75cd04eb725d1cf5d1cbf9f388ec99e7c38b04d0a100c4e9ff47610b433","49b80914d9e7c986e69aa66c7e3d2000d0f4ad4e099d3512a500606b94a4a10d","defaa9fc50f8675535ff621f1053f6586d725da50cf3ba52ba677c3f0ff53c01","c08a3c562a25280a4288daa21080c026edcbbc03a091d8df6457cd755f990edf","809020aa52b383e86c53157cfba302ff7277c3df384f1e21f1912ba805cc0a95","8fed55d4be56012b1e370fda3db672966237f9f71e18fe7bf9a5169facf567ad","8b21c1505dcac5d6924746a8ab428354480daadcb31709ca15446a9d71f2899f","4907dde9ecbd4bc2dafe0f2addc7e69e186876c449aa6b9f9b6066d02bd1d9f8","a5a141f716ae943ccc04a3d93e494a6c84b3accd6f34210d3a994d889e2ce0e9","65fc851da3c2e631763e0cabb60da81e206e10ce850ba009bbb06489aaa2d27a","cbd7209989736c22cecc77d89742bc482421e3d464a4091b504296cedb52d0d9","93127314f50d0359dcd40bdf4154b610017d5b166667458097ab5425f709971a","953f42e6b64b10d0b0530afeac39a129097e1808d3bf4e2647f6af385ab27e84","dac65aeca52aefdfa813b0fbe96608a44ed4b6c41c021bf2aff804021184153b","2067bd7bcd4dfc7df7669d074ee1c3589bde0167bbdef9acf37d660789d37588","6ecfbd21388cfc1e7fe37feabfa6e4191894bcb6a2fd991746f18eeee4d0fa67","44c6e5673e8ce8e43c3edc65186f48c8c6b462d59c9f129d1034898b6eec2f1a","9dd2598c8b24cde145d37be640c5b2e7acdcaa90fd811a44b89661665ec1adf7","4c5591e91637ad17c887134914ad3d95eb4e147277dfdcf917da428f70aa1bf3","400ed73e5f1e778c5d6871edd0f0b7d1f4798c5fde3a79b7a0e114f42f1a9e55","058fbfd8962f93b3ce2328afcb1c87528f9a5fb9570ce80a63afa95fb2b6f45a","853ca6f766a49e50066b9256e40381b78247417d31391ef9535cc298758e3f01","a23c4ae3c953018664e44c4a9e73a817a1ca5b872a2a1f1fcec6ad9a3eaf9a17","8328d1f976b2d7af29036f68913369ef5e89c7f2c31335be5c27a2189af22d73"],"paragraph_range_zero_based":[1656,1679],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p1656"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>include the field affectedCarrierFreqRangeList with an entry for each affected frequency range;","paragraph_zero_based":1680},{"literal_text_all_w_t_and_m_t":"3>for each affected frequency range included in the field affectedCarrierFreqRangeList, include centerFreq and affectedBandwidth;","paragraph_zero_based":1681},{"literal_text_all_w_t_and_m_t":"3>for each affected frequency range included in the field affectedCarrierFreqRangeList, include interferenceDirection and optionally victimSystemType, and set it accordingly;","paragraph_zero_based":1682},{"literal_text_all_w_t_and_m_t":"2>if there is at least one supported UL CA or NR-DC combinations comprising of candidate frequency ranges included in candidateServingFreqRangeListNR, and each affected frequency range in the UL CA or NR-DC combination overlapping with one candidate frequency range included in candidateServingFreqRangeListNR, and the center frequency of the affected frequency range is within the candidate frequency range included in candidateServingFreqRangeListNR, the UE is experiencing IDC problems that it cannot solve by itself:","paragraph_zero_based":1683},{"literal_text_all_w_t_and_m_t":"3>include the field affectedCarrierFreqRangeCombList with an entry for each supported UL CA or NR-DC combination comprising of frequency ranges that is affected by IDC problems;","paragraph_zero_based":1684},{"literal_text_all_w_t_and_m_t":"3>for each affected frequency range included in the field affectedCarrierFreqRangeCombList, include centerFreq and affectedBandwidth;","paragraph_zero_based":1685},{"literal_text_all_w_t_and_m_t":"3>for each UL CA or NR-DC combination included in the field affectedCarrierFreqRangeCombList, include interferenceDirection and optionally victimSystemType, and set it accordingly;","paragraph_zero_based":1686},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide IDC TDM assistance information according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":1687},{"literal_text_all_w_t_and_m_t":"2>if there is at least one candidate carrier frequency included in candidateServingFreqListNR or candidate frequency range included in candidateServingFreqRangeListNR or one supported UL CA or NR-DC combination comprising of candidate carrier frequencies included in candidateServingFreqListNR or candidate frequency ranges included in candidateServingFreqRangeListNR, the UE is experiencing IDC problems that it cannot solve by itself, and affectedCarrierFreqList or affectedCarrierFreqCombList or affectedCarrierFreqRangeList or affectedCarrierFreqRangeCombList is included, and idc-TDM-AssistanceConfig is set to setup:","paragraph_zero_based":1688},{"literal_text_all_w_t_and_m_t":"3>include Time Domain Multiplexing (TDM) based assistance information as indicated by idc-TDM-Assistance that could be used to resolve the IDC problems;","paragraph_zero_based":1689},{"literal_text_all_w_t_and_m_t":"NOTE 1:When sending an UEAssistanceInformation message to inform the IDC problems, the UE includes all IDC assistance information in the idc-Assistance (IDC FDM assistance information) or idc-FDM-Assistance (IDC enhanced FDM assistance information) or idc-TDM-Assistance (IDC TDM assistance information) fields respectively (rather than providing e.g. the changed part(s) of the IDC assistance information in respective fields).","paragraph_zero_based":1690},{"literal_text_all_w_t_and_m_t":"NOTE 2:Upon not anymore experiencing a particular IDC problem that the UE previously reported, the UE provides an IDC indication with the modified contents of the UEAssistanceInformation message (e.g. by not including the IDC assistance information in the idc-Assistance or idc-FDM-Assistance or idc-TDM-Assistance fields).","paragraph_zero_based":1691},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide drx-Preference of a cell group for power saving or for DTX/DRX configuration preference according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":1692},{"literal_text_all_w_t_and_m_t":"2>include drx-Preference in the UEAssistanceInformation message;","paragraph_zero_based":1693},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on DRX parameters for the cell group or cell DTX/DRX related parameters:","paragraph_zero_based":1694},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the long DRX cycle or for cellDTX-DRX-Cycle:","paragraph_zero_based":1695},{"literal_text_all_w_t_and_m_t":"4>include preferredDRX-LongCycle in the DRX-Preference IE and set it to the preferred value;","paragraph_zero_based":1696},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the DRX inactivity timer:","paragraph_zero_based":1697},{"literal_text_all_w_t_and_m_t":"4>include preferredDRX-InactivityTimer in the DRX-Preference IE and set it to the preferred value;","paragraph_zero_based":1698},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the short DRX cycle:","paragraph_zero_based":1699},{"literal_text_all_w_t_and_m_t":"4>include preferredDRX-ShortCycle in the DRX-Preference IE and set it to the preferred value;","paragraph_zero_based":1700},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the short DRX timer:","paragraph_zero_based":1701},{"literal_text_all_w_t_and_m_t":"4>include preferredDRX-ShortCycleTimer in the DRX-Preference IE and set it to the preferred value;","paragraph_zero_based":1702},{"literal_text_all_w_t_and_m_t":"2>else (if the UE has no preference on DRX parameters for the cell group):","paragraph_zero_based":1703}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["4c6df3ba706002e819aa737b7f8fbcdab259dc3404c8f5203868e797e8b6a9a0","b8ecd7be2ff881f31ef6c588676163698a01add848f460563444ab0bfdc7a7f8","c8e50597cc626ffa5f7fe394d3d8da24cf2e22d62b9f702740971c67e6d99b47","c58f283c57b11fb4e096ba39e527b0cbcc029358f63f1a24d87c0f9b5a2243b5","46d78e47045b678a19a50a19963909d84cd7b1c374d159a732e417159541b0ed","a6d30fcceb7a353abc2f5e6f8f0001be91a3dc5603c5529d88b007846bf1848c","0cae047001d0428ce4d8ef636c3a000276dbab15b824ae10e688c7329b9a796b","9670e6da53ed269f6213a87bb6cd916c0a00fae29b6065be276dd8fca475c141","26561a0fa1e1884c0d64317f5721d36055ceeeb353d65bf1d4821e74c00436ea","4054fb97e19a0252e7cc86e0e9a4a7f59234d4f09b48d9e5c38a276fc6dae741","4c1cfd7a34dc0329129a5663183983369347b721042ec0951e4bd2d660e29f35","4f662409cdd7531ebe993150191d0676b67d762099dd286ae32274ae5f91514d","81f0fa932398e14cea694da210213af0fe6c63164255493e35c5dbc4966d041c","7c2ec1fb94665290a0875cdd89c444a929545d89fd6ecc57dc3c3044e42504f4","fcb4fc96fd6697079890b1d11aab12798a1c9f0a8aa213aba089f58fdc9d69b3","76af5cfb2ad0e33d1877e2c8eebcf6e9ad504a711318efbaf282fab083d32968","e1fdfcde5dfbead9262f6a4fc2511eeb927bf3c313204908f70d9a628f3f5417","3ce534ed4b98252207f364f274283e386959a827dc44ddfe802fc9eb43d9e280","e7ddc91ff0c9e3d0c6bbc5a24463e16bbd5380b07835e53ce38729fde0ebfbe0","12471cbe55d5e7f5e0cc3871a1eeaa734ad35dba72cfd0b576dac108af35d5f7","99da6698057f553b7dc234c060ecbbe1713799837c8cc405436d8f29ef530d56","471a4a456eae6316d5de20e3249c6661b64680de4c1cbd37c5783cff5bfe42c5","ab7741de34f51fdc36a1ddd7f38761938cb5238c8fbeb68c6dae48ad34e7cdeb","fb65caab21e708ecb6462f53d7b49f882a8f4cedcc4ccc9a4e227a382851c2ba"],"paragraph_range_zero_based":[1680,1703],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p1680"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>do not include preferredDRX-LongCycle, preferredDRX-InactivityTimer, preferredDRX-ShortCycle and preferredDRX-ShortCycleTimer in the DRX-Preference IE;","paragraph_zero_based":1704},{"literal_text_all_w_t_and_m_t":"NOTE 2a:If drx-Preference contains only preferredDRX-LongCycle and it is shorter than the configured cellDTX-DRX-Cycle it implies preference for cell DTX/DRX.","paragraph_zero_based":1705},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide maxBW-Preference of a cell group for power saving according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":1706},{"literal_text_all_w_t_and_m_t":"2>include maxBW-Preference in the UEAssistanceInformation message;","paragraph_zero_based":1707},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on the maximum aggregated bandwidth for the cell group:","paragraph_zero_based":1708},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to reduce the maximum aggregated bandwidth of FR1:","paragraph_zero_based":1709},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxBW-FR1 in the MaxBW-Preference IE;","paragraph_zero_based":1710},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-DL to the maximum aggregated bandwidth the UE desires to have configured across all downlink carriers of FR1 in the cell group;","paragraph_zero_based":1711},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-UL to the maximum aggregated bandwidth the UE desires to have configured across all uplink carriers of FR1 in the cell group;","paragraph_zero_based":1712},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to reduce the maximum aggregated bandwidth of FR2-1:","paragraph_zero_based":1713},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxBW-FR2 in the MaxBW-Preference IE;","paragraph_zero_based":1714},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-DL to the maximum aggregated bandwidth the UE desires to have configured across all downlink carriers of FR2-1 in the cell group;","paragraph_zero_based":1715},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-UL to the maximum aggregated bandwidth the UE desires to have configured across all uplink carriers of FR2-1 in the cell group;","paragraph_zero_based":1716},{"literal_text_all_w_t_and_m_t":"2>else (if the UE has no preference on the maximum aggregated bandwidth for the cell group):","paragraph_zero_based":1717},{"literal_text_all_w_t_and_m_t":"3>do not include reducedMaxBW-FR1 and reducedMaxBW-FR2 in the MaxBW-Preference IE;","paragraph_zero_based":1718},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide maxBW-PreferenceFR2-2 of a cell group for power saving according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":1719},{"literal_text_all_w_t_and_m_t":"2>include maxBW-PreferenceFR2-2 in the UEAssistanceInformation message;","paragraph_zero_based":1720},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to reduce the maximum aggregated bandwidth of FR2-2:","paragraph_zero_based":1721},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxBW-FR2-2 in the MaxBW-PreferenceFR2-2 IE;","paragraph_zero_based":1722},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-FR2-2-DL to the maximum aggregated bandwidth the UE desires to have configured across all downlink carriers of FR2-2 in the cell group;","paragraph_zero_based":1723},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-FR2-2-UL to the maximum aggregated bandwidth the UE desires to have configured across all uplink carriers of FR2-2 in the cell group;","paragraph_zero_based":1724},{"literal_text_all_w_t_and_m_t":"2>else (if the UE has no preference on the maximum aggregated bandwidth for the cell group):","paragraph_zero_based":1725},{"literal_text_all_w_t_and_m_t":"3>do not include reducedMaxBW-FR2-2 in the MaxBW-PreferenceFR2-2 IE;","paragraph_zero_based":1726},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide maxCC-Preference of a cell group for power saving according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":1727}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["77b6af797773a66196654407684594cf640d30dc6ab0527abbcfbad85119ab2a","095d8317f940c72b4139e4103ed8496c25cd01120ccef80df99883c845930dd1","8ffd6a495794fe8f44fb38596cbadf27770f5b72d192f9ffaaa157119e296316","3b873fe8a0993411ffebe42958a81039eb2277b0a21cb6412014188459593da5","38a7713d55168f3e9e423d4fa738a57751ed08f1137f07c3409b366a5953f1e3","367e196f7ac31efa782f7377c13868b7fae6be0b65715d1bee08ca02d9bcc93d","7bf2d6e050e099d4000f73a2c8be6cd03f3cef46745010ced407602b26d45e53","027da581ddc15dbc3d6ef04b0423b7e28842ead15bae6dd1b491aec76fcffb4c","f287aa9189b838fc98f4db4cbe27ea9502f476cadccb70922feffe8f7eb6d956","2ed122ba9c877a98f0aca165f2462d5a40bf926fc87e01f79f1a3e518da0816d","c67a5b41fb8e3ed1ffb929e908a95513bbc1ca5cfb6a2cd5cbfb0b0c10f1da57","4fb8f6019fc471079d572c2f2d3ba76b8a24490281ff9d8ad581d71404252ab7","323884d027522efde52c81fbc4f443a838b5e9de2e719bbfc871b6f2d8692f4c","1591218b09822d059356ec6666667b27123d8e3ca7f50ee7c588a5fdf0cfe4e9","270cbac485b7c157ff062f6a98d6f8935e8f454c5c6b987132e46600707534eb","fdf358d49ea0805d9fd1714b5189f4a93722257e8442553e6b7692c47d4fc269","fdc648708394c0368cde65d778923da1199200a4c2ced0efbf804777dc3257af","6ad4559b9c0428c281e795a8fe6a1d82334c397e5f0b9b5a257d471bbbb6ba4a","531c76ed24a3fa8316019c1c6d0331b6f33fefdf066e34bde531b92451797bd9","8df765c47a6c04991283ee618f9205fefff973388ed02e31c8f6f9e785e62840","ab9a69b8f10a1c2a8467beacf6f9fe6c99ab7802d3e58bf18a22f5840881a8cf","fd407f359658ed157e6136f10744fe6f974290c07697172f086ebde386f905bd","4493a9016d5db0ee2a58b7e3f943ff71b1f401c601cb43906376b8659c216516","7dc902b7ce51f1f3a451c89df59da0116434fc215dcaa09dabc977acbc699337"],"paragraph_range_zero_based":[1704,1727],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p1704"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>include maxCC-Preference in the UEAssistanceInformation message;","paragraph_zero_based":1728},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on the maximum number of secondary component carriers for the cell group:","paragraph_zero_based":1729},{"literal_text_all_w_t_and_m_t":"3>include reducedMaxCCs in the MaxCC-Preference IE;","paragraph_zero_based":1730},{"literal_text_all_w_t_and_m_t":"3>set reducedCCsDL to the number of maximum SCells the UE desires to have configured in downlink in the cell group;","paragraph_zero_based":1731},{"literal_text_all_w_t_and_m_t":"3>set reducedCCsUL to the number of maximum SCells the UE desires to have configured in uplink in the cell group;","paragraph_zero_based":1732},{"literal_text_all_w_t_and_m_t":"2>else (if the UE has no preference on the maximum number of secondary component carriers for the cell group):","paragraph_zero_based":1733},{"literal_text_all_w_t_and_m_t":"3>do not include reducedMaxCCs in the MaxCC-Preference IE;","paragraph_zero_based":1734},{"literal_text_all_w_t_and_m_t":"NOTE 3:The UE can implicitly indicate a preference for NR SCG release by reporting the maximum aggregated bandwidth preference for power saving of the cell group, if configured, as zero for both FR1 and FR2, and by reporting the maximum number of secondary component carriers for power saving of the cell group, if configured, as zero for both uplink and downlink.","paragraph_zero_based":1735},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide maxMIMO-LayerPreference of a cell group for power saving according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":1736},{"literal_text_all_w_t_and_m_t":"2>include maxMIMO-LayerPreference in the UEAssistanceInformation message;","paragraph_zero_based":1737},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on the maximum number of MIMO layers for the cell group:","paragraph_zero_based":1738},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to reduce the number of maximum MIMO layers of each serving cell operating on FR1:","paragraph_zero_based":1739},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxMIMO-LayersFR1 in the MaxMIMO-LayerPreference IE;","paragraph_zero_based":1740},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR1-DL to the preferred maximum number of downlink MIMO layers of each BWP of each FR1 serving cell that the UE operates on in the cell group;","paragraph_zero_based":1741},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR1-UL to the preferred maximum number of uplink MIMO layers of each FR1 serving cell that the UE operates on in the cell group;","paragraph_zero_based":1742},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to reduce the number of maximum MIMO layers of each serving cell operating on FR2-1:","paragraph_zero_based":1743},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxMIMO-LayersFR2 in the MaxMIMO-LayerPreference IE;","paragraph_zero_based":1744},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR2-DL to the preferred maximum number of downlink MIMO layers of each BWP of each FR2-1 serving cell that the UE operates on in the cell group;","paragraph_zero_based":1745},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR2-UL to the preferred maximum number of uplink MIMO layers of each FR2-1 serving cell that the UE operates on in the cell group;","paragraph_zero_based":1746},{"literal_text_all_w_t_and_m_t":"2>else (if the UE has no preference on the maximum number of MIMO layers for the cell group):","paragraph_zero_based":1747},{"literal_text_all_w_t_and_m_t":"3>do not include reducedMaxMIMO-LayersFR1 and reducedMaxMIMO-LayersFR2 in the MaxMIMO-LayerPreference IE;","paragraph_zero_based":1748},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide maxMIMO LayerPreferenceFR2 2 of a cell group for power saving according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":1749},{"literal_text_all_w_t_and_m_t":"2>include maxMIMO-LayerPreferenceFR2-2 in the UEAssistanceInformation message;","paragraph_zero_based":1750},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on the maximum number of MIMO layers for the cell group for FR2-2:","paragraph_zero_based":1751}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["a15ff3287d7fab62d76c118015b9c6441f704fae6a9a851ec833ab77a85a652c","1c736187c053abbd8bec0c9d9cafe6981858c665c00bf136bff19b8565aeccc4","69efab269075f240379c382c8fbbf95f6c42c396fcd8be8cafe882e009ce18b4","cc6c0b5c6dd08d415fa525e0b57e8eb4c72b343a1cfbe10d79704304790e1ffe","af9a47851d2f94f35adc07ba0f7e06b1fac8a40a458fbde3ceef8a50517781da","3e26bb4c643c1050bee561b299d02f0e1d53914b2aba9749600c5f7097e49707","e855c4205532f435a04f41795b9c2b36b4d27963d8fcef3982017e2c9d7cddba","578679cdee161f5fe0f5c0391474a33f74b732a6eada23763034f877b605f89a","d723fc237c0a198b6e2a110c2434025271f1aacbab1b159b58c34e0bdbfcd47f","67ec011869727183a6da1f36488cbee7ad8e551adfa6191abfb8ca5986ab587c","bd5b691bfa74b25800f321ad30800e87029c98b35bc672392cb73da91b4a20b8","01607df4009357b26583f175b9f008075feaab47b983438f7394b2cc17580430","826cd1593db2add68d6a2eb20f6c146e9833fdbb8aa021a46f83f04e7624b3a5","b18728226fcd7ea6161a29ab96bf99072be7a20fb1778355ec8a1d18d1343133","4e1989804e55c323d0faf99c91b97c2c2d72487f56387bdee0312cfc4744289a","de93a34a376b1c4fffe721c084d14bbecc99ed60e16a99e8fca436a68445559f","538926aaf6d80e913f492ee834cdf59626b8f504bf7077ea57a291bc0baac985","bfc08687e3527568b3f48e253385a0c047accb62a0aa76ef2d8f06a7787101a2","97d5e028854f1cdfdfbddb0a920cad9648873ae07ff8bab1e94d294426cf16cf","078c112516423d656879d2211f5709e29761a42afa54971a79c103bcf2a72eca","fe53a78c5225ed48c3bcdc21e94d70c98a29d34d5d035915987eb8cd16fd5792","22fe5c3649ddf860f282976eed9645002c4cac4981ef7e24f121446c55e774c1","9ae9a4769453a9d411e05129671d7160a7b5e0bea57a8f3064a24327a2419d55","15bbbaa68c43cfb3d56f848834be242ebbee0799701ec7453cbba4d3f9379734"],"paragraph_range_zero_based":[1728,1751],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p1728"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to reduce the number of maximum MIMO layers of each serving cell operating on FR2 2:","paragraph_zero_based":1752},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxMIMO-LayersFR2-2 in the MaxMIMO-LayerPreferenceFR2 2 IE;","paragraph_zero_based":1753},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR2-2-DL to the preferred maximum number of downlink MIMO layers of each BWP of each FR2-2 serving cell that the UE operates on in the cell group;","paragraph_zero_based":1754},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR2-2-UL to the preferred maximum number of uplink MIMO layers of each FR2-2 serving cell that the UE operates on in the cell group;","paragraph_zero_based":1755},{"literal_text_all_w_t_and_m_t":"2>else (if the UE has no preference on the maximum number of MIMO layers for the cell group):","paragraph_zero_based":1756},{"literal_text_all_w_t_and_m_t":"3>do not include reducedMaxMIMO-LayersFR2-2 in the MaxMIMO-LayerPreferenceFR2-2 IE;","paragraph_zero_based":1757},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide minSchedulingOffsetPreference of a cell group for power saving according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":1758},{"literal_text_all_w_t_and_m_t":"2>include minSchedulingOffsetPreference in the UEAssistanceInformation message;","paragraph_zero_based":1759},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on the minimum scheduling offset for cross-slot scheduling for the cell group:","paragraph_zero_based":1760},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the value of K0 (TS 38.214 [19], clause 5.1.2.1) for cross-slot scheduling with 15 kHz SCS:","paragraph_zero_based":1761},{"literal_text_all_w_t_and_m_t":"4>include preferredK0-SCS-15kHz in the MinSchedulingOffsetPreference IE and set it to the desired value of K0;","paragraph_zero_based":1762},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the value of K0 for cross-slot scheduling with 30 kHz SCS:","paragraph_zero_based":1763},{"literal_text_all_w_t_and_m_t":"4>include preferredK0-SCS-30kHz in the MinSchedulingOffsetPreference IE and set it to the desired value of K0;","paragraph_zero_based":1764},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the value of K0 for cross-slot scheduling with 60 kHz SCS:","paragraph_zero_based":1765},{"literal_text_all_w_t_and_m_t":"4>include preferredK0-SCS-60kHz in the MinSchedulingOffsetPreference IE and set it to the desired value of K0;","paragraph_zero_based":1766},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the value of K0 for cross-slot scheduling with 120 kHz SCS:","paragraph_zero_based":1767},{"literal_text_all_w_t_and_m_t":"4>include preferredK0-SCS-120kHz in the MinSchedulingOffsetPreference IE and set it to the desired value of K0;","paragraph_zero_based":1768},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the value of K2 (TS 38.214 [19], clause 6.1.2.1) for cross-slot scheduling with 15 kHz SCS:","paragraph_zero_based":1769},{"literal_text_all_w_t_and_m_t":"4>include preferredK2-SCS-15kHz in the MinSchedulingOffsetPreference IE and set it to the desired value of K2;","paragraph_zero_based":1770},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the value of K2 for cross-slot scheduling with 30 kHz SCS:","paragraph_zero_based":1771},{"literal_text_all_w_t_and_m_t":"4>include preferredK2-SCS-30kHz in the MinSchedulingOffsetPreference IE and set it to the desired value of K2;","paragraph_zero_based":1772},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the value of K2 for cross-slot scheduling with 60 kHz SCS:","paragraph_zero_based":1773},{"literal_text_all_w_t_and_m_t":"4>include preferredK2-SCS-60kHz in the MinSchedulingOffsetPreference IE and set it to the desired value of K2;","paragraph_zero_based":1774},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the value of K2 for cross-slot scheduling with 120 kHz SCS:","paragraph_zero_based":1775}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["f64562d5b44ef998a0f4256debf87ac6b1440b10d87149e4cc2d6795e12f20bc","853250eabee9e9c791677107f051665c17a3b0de56d59ce4b040270a4b920e41","5274c6a0820a909ab7da3311134282272b3f094c166d78406d2513768d8300ed","3fc1ea14eb1d127c57f6a9cc381f92f0e9aaeba653ef315164dd6ed24a1fe201","9d4a52dea64373230c62e9cdcce5e710f867626e7b1a47d8bbe7d31aa16f712c","0ebf48a4aa8b113658af598550448b8f45b96d681a29a50c92a60e3c2f358491","6f9c0cb2bccdde0a571d287f60071bd70a1c93a0f9e408dc034b1031ba4d44d5","3558b54fb086979239a777961bd1a7bdc0b9e3b4d930fc783d865bf7cc63556c","b3a1d42c80f2f326a5919a345cd4a0c1f85acb963b9e81816e849df1d913336f","d858a03bc49f989f4954ae692e1ff254cc01171830e2f2fec4f09be6dc06c831","469b0082a3b9385232f619f852b27a2d3c00453598d7b1a18086d9f1ef11d6cb","105e7ebf987cd964b82deea46586751745ef3d6451f54b633a9e34d2215248d9","36adda1decd50fb69caa40867696c3f3e7335eec0bd3b8d3266040d3c23feeaf","15bc24b17677f26c8659559cfceee9733d11dfd6941edda42b09b4c59b6b837d","d02ffb7de2cf0ea274cfc3eb1d7a0ba40438014057b4b640bcbb96936080bd92","56a8d33fb56c3fabc2e54d225f4f21726f590bc5abd5a4f62248462934260b5f","fd739fdc8c4019c9e76cda9f4f22c8a996218e5b33191b11fefcb38f798505c5","da6323726ca4bc37cbe1b36b7051be1971a476b026b7abf7e9135842033e1959","17c07733421c23cb3569e6b80563b954d81f71592c915b4bb389602fa4ee1074","797d89709382dc8e23e8734b6acc6378799595