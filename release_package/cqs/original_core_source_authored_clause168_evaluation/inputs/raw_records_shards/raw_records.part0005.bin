{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Contains the filter, applied by the UE, common for all MR-DC related capability containers that are requested and as defined by UE-CapabilityRequestFilterCommon IE in TS 38.331 [82].","paragraph_zero_based":3096},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3097},{"literal_text_all_w_t_and_m_t":"assistInfoBitForLC","paragraph_zero_based":3098},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports assistance information bit for local cache.","paragraph_zero_based":3099},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3100},{"literal_text_all_w_t_and_m_t":"aul","paragraph_zero_based":3101},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports AUL as specified n TS 36.321 [6].","paragraph_zero_based":3102},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3103},{"literal_text_all_w_t_and_m_t":"bandCombinationListEUTRA","paragraph_zero_based":3104},{"literal_text_all_w_t_and_m_t":"One entry corresponding to each supported band combination listed in the same order as in supportedBandCombination. ","paragraph_zero_based":3105},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3106},{"literal_text_all_w_t_and_m_t":"BandCombinationParameters-v1090, BandCombinationParameters-v10i0, BandCombinationParameters-v1270","paragraph_zero_based":3107},{"literal_text_all_w_t_and_m_t":"If included, the UE shall include the same number of entries, and listed in the same order, as in BandCombinationParameters-r10.","paragraph_zero_based":3108},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3109},{"literal_text_all_w_t_and_m_t":"BandCombinationParameters-v1130","paragraph_zero_based":3110},{"literal_text_all_w_t_and_m_t":"The field is applicable to each supported CA bandwidth class combination (i.e. CA configuration in TS 36.101 [42], clause 5.6A.1) indicated in the corresponding band combination. If included, the UE shall include the same number of entries, and listed in the same order, as in BandCombinationParameters-r10.","paragraph_zero_based":3111},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3112},{"literal_text_all_w_t_and_m_t":"bandEUTRA","paragraph_zero_based":3113},{"literal_text_all_w_t_and_m_t":"EUTRA band as defined in TS 36.101 [42] and TS 36.102 [113] for NTN capable UE. In case the UE includes bandEUTRA-v9e0 or bandEUTRA-v1090, the UE shall set the corresponding entry of bandEUTRA (i.e. without suffix) or bandEUTRA-r10 respectively to maxFBI.","paragraph_zero_based":3114},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3115},{"literal_text_all_w_t_and_m_t":"bandInfoNR","paragraph_zero_based":3116},{"literal_text_all_w_t_and_m_t":"One entry corresponding to each supported E-UTRA band listed in the same order as in supportedBandListEUTRA. If bandInfoNR-r16 is absent, network assumes gap is required when measurement is performed on any NR bands while UE is served by a single E-UTRA carrier belonging to the corresponding E-UTRA band listed in supportedBandListEUTRA except for the FR2 inter-RAT measurement which depends on the support of independentGapConfig or gaplessMeas-FR2-maxCC.","paragraph_zero_based":3117},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3118},{"literal_text_all_w_t_and_m_t":"bandListEUTRA","paragraph_zero_based":3119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["7d3c10cf2f450c6811ecd6ba0ce3de2986b8ee83ed064b1d7097c33048031752","42721ab24ac734c68bdff0b3033208110746d2104253986289f290d8c298cc05","7e13eb0c62cbeaa9f39d7152443497ba2f249c2afe548cc6ed6244a140082d2c","4b63b97b41a3f5f2b73cff367028788779da9334c8bc29b80640c73360b717c4","fa74aef46ed9b70023d92f049e82a3a135743d60833f97ae23f0a0d4aa335737","8c113e6c7c8ab9101662ed73229add47b0be6d29a9785403fd433f8734557871","216bde68b65ec5d1860575b00230062f8ccae94dccdc37748b614069935cfa7e","182afbe8ff902dfb603604b609b0ea5d06f85906c370cd0c9af8bf6f58b6a538","f07d6abff64428e85d0a8b95c5644687dedc4e7b26dcef17ec16120e6e216cff","80324e331396a6cf34937b8cd12b7feb9935d6ceaa8eb45515b916221c57b162","10da8539859cc3980e04edd624903acfa819bb756bd2893e6ef143991321eea3","440155d6747d79e75180a76b02188222a15e5e7d175fbc59a2ac13f8008dc984","a4b1a10d58ee321fca75aaea2a338d708792bde753b0cebfdd05b1c107ae22c8","90db482e28de766d6526ceed723379d9233b5db9b5e6796b3dfad678371ef396","f145b9d50eb898fc6dbd205fada202f740f6ebdc6bf1fcabf2e35b067a2f9634","5a5e02696c3f0a2f6f737fc906d015cad01fc6fc9a51cea274e981697fe590fb","71dda7c9f18e5a29bdba4cf14117b1ef92bc5f746843cb0ca303d5276c0dd0ca","4222602d9f86da85da5c3152a2df0947db78c25854dc33efebf364c84cdbfab9","35a4ddbbca04c9ce4388a5af8cab376ecc9e12840ddde3bc1b1ae4a558167ea8","b6fc745b8be9c30e90e0355f05c0020425d1ea80e8c3496798a0e03477e30301","668c8d8b0e8d45018a0102d5d35a548d243bf38d997330486f3fe8fa9c61d79c","47bf36364e8be10c0de0819001717fa0eafbe6ca76982c5d9d7f10ce681bef65","d72bca919e38a1ded72e71c26f733408227898956c682f94154270b1b0218242","7f6169cc33efe9f2cf64626293cf90f34c30e5f00cf98ec106b3a9d0934923f9"],"paragraph_range_zero_based":[3096,3119],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p3096"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"One entry corresponding to each supported EUTRA band listed in the same order as in supportedBandListEUTRA.","paragraph_zero_based":3120},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3121},{"literal_text_all_w_t_and_m_t":"bandParameterList-v1380","paragraph_zero_based":3122},{"literal_text_all_w_t_and_m_t":"If included, the UE shall include the same number of entries listed in the same order as the band entries in the corresponding band combination.","paragraph_zero_based":3123},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3124},{"literal_text_all_w_t_and_m_t":"bandParametersUL, bandParametersDL","paragraph_zero_based":3125},{"literal_text_all_w_t_and_m_t":"Indicates the supported parameters for the band. Each of CA-MIMO-ParametersUL and CA-MIMO-ParametersDL can be included only once for one band in a single band combination entry.","paragraph_zero_based":3126},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3127},{"literal_text_all_w_t_and_m_t":"beamformed (in MIMO-CA-ParametersPerBoBCPerTM)","paragraph_zero_based":3128},{"literal_text_all_w_t_and_m_t":"If signalled, the field indicates for a particular transmission mode, the UE capabilities concerning beamformed EBF/ FD-MIMO operation (class B) applicable for the concerned band combination.","paragraph_zero_based":3129},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3130},{"literal_text_all_w_t_and_m_t":"beamformed (in MIMO-UE-ParametersPerTM)","paragraph_zero_based":3131},{"literal_text_all_w_t_and_m_t":"Indicates for a particular transmission mode, the UE capabilities concerning beamformed EBF/ FD-MIMO operation (class B) applicable for band combinations for which the concerned capabilities are not signalled.","paragraph_zero_based":3132},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3133},{"literal_text_all_w_t_and_m_t":"benefitsFromInterruption","paragraph_zero_based":3134},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE power consumption would benefit from being allowed to cause interruptions to serving cells when performing measurements of deactivated SCell carriers for measCycleSCell of less than 640ms, as specified in TS 36.133 [16].","paragraph_zero_based":3135},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":3136},{"literal_text_all_w_t_and_m_t":"bwPrefInd","paragraph_zero_based":3137},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports maximum PDSCH/PUSCH bandwidth preference indication.","paragraph_zero_based":3138},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3139},{"literal_text_all_w_t_and_m_t":"ca-BandwidthClass","paragraph_zero_based":3140},{"literal_text_all_w_t_and_m_t":"The CA bandwidth class supported by the UE as defined in TS 36.101 [42], Table 5.6A-1.","paragraph_zero_based":3141},{"literal_text_all_w_t_and_m_t":"The UE explicitly includes all the supported CA bandwidth class combinations in the band combination signalling. Support for one CA bandwidth class does not implicitly indicate support for another CA bandwidth class.","paragraph_zero_based":3142},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["b19b8285d60dc88ea809db7ff987dee58117a9f7cdc22145df33f3977f3cea62","b8915e6f8685dfeb2cb3ecf837c05f2560e017f28a013bd7d20a647d50b6ab51","06e3b03a33fd9fec2d9be3e1b43c641f6579da95b1f8b3a7b4252b084e702c18","0e00a45b1b312768d2e8f7abb2480358d710fa76f30c99b9405b029fd0847d84","461bd42f22dfab23c8f6a2a4b1bf88841b31aa85da7759bc7cd3f56a0894ceca","78422a180bd9a1cb18402b0dd4f61a0605157273f2c55f37aebbf7d7ab6db145","a5f17c574982c8e9e3464b5bc37c8efe5e372ab80c07f2ba45ebf4bf3ffdf651","9adfce126068e140d70e5932de1d7c0e39fd6d8bf25a92a0fbd3de168f6b3acf","4c5160756fd9ad5185be7f9648ec2817859e55ea84e147f460a29e00033a8dcc","f8582afa8f5086349d362ebb5eaef556fc41532373d20c9320fb993db0b05016","a48fbbad5fce6162c5cd0159b45d50a415e09a729f43546a22e87aa4fb679345","74f9297acdfe8bd83aff1f6f50b3cf1e67cb346d7e9c947ad6b7f7c3d9d957f5","de98aa913a2f398c511e48af02e02debed17156db2a268882c32c4435f17d567","f8e0299d451b267436d89d54b15a8ed9d9e230d816dbf762e341fd504f01aad8","0e5f03998b43b2ce16d629c22a147ecb0c887d889f5f40e230192929941f8a17","e737bd078e33c4d51fe821db053bcda619b7f3d79b0ce56482a9fa53bddbe4fc","b11e73f6a4fafa1ac9ecc8aec9d3b0283039698ce3d4e6293497944688bc4e68","0da6e22d9daaa4e56d418332536c72d5b0f65ab0d7a97bbf63b1f92dca25e89e","af65a1c0c43a96def81f6fdea18cb8b92152a077b0e18bfa917bad97cef9d962","ab68d095f6a7ce152cb4252f98489e868647f30f691e5bd1ff71c6e3725689a1","f0c7f7732289e9972730b096d1554ed58d6b28d78407ea9cd2477932b9c05f90","217f525582ddf0ae8df3336c9f2d42b686ca7a6fe73b38c8bd8452137a252e98","eb50fff03f1839fa69c52f9bc1d84c2273d2f2ccba66d6f8b56d84f0200764d1","960af5b35cb96c4b789cd9dcd8d48519ef1917a56dc822b82048a6da2c895d56"],"paragraph_range_zero_based":[3120,3143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p3120"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ca-IdleModeMeasurements","paragraph_zero_based":3144},{"literal_text_all_w_t_and_m_t":"Indicates whether UE supports reporting measurements performed during RRC_IDLE.","paragraph_zero_based":3145},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3146},{"literal_text_all_w_t_and_m_t":"ca-IdleModeValidityArea","paragraph_zero_based":3147},{"literal_text_all_w_t_and_m_t":"Indicates whether UE supports validity area for IDLE measurements during RRC_IDLE.","paragraph_zero_based":3148},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3149},{"literal_text_all_w_t_and_m_t":"cas-Muting-5GB","paragraph_zero_based":3150},{"literal_text_all_w_t_and_m_t":"Indicates, for the corresponding E-UTRA band, whether the UE supports reception of LTE-based 5G broadcast with CAS muting from an MBMS-dedicated cell as described in TS 36.211 [21].","paragraph_zero_based":3151},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3152},{"literal_text_all_w_t_and_m_t":"cch-IM-RefRecTypeA-OneRX-Port","paragraph_zero_based":3153},{"literal_text_all_w_t_and_m_t":"This field defines whether the DL Category 1bis or the DL Category M2 UE supports Type A downlink control channel interference mitigation (CCH-IM) receiver \"LMMSE-IRC + CRS-IC\" for PDCCH/PCFICH/PHICH/EPDCCH receive processing (Enhanced downlink control channel performance requirements Type A in TS 36.101 [6]).","paragraph_zero_based":3154},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":3155},{"literal_text_all_w_t_and_m_t":"cch-InterfMitigation-RefRecTypeA, cch-InterfMitigation-RefRecTypeB, cch-InterfMitigation-MaxNumCCs","paragraph_zero_based":3156},{"literal_text_all_w_t_and_m_t":"The field cch-InterfMitigation-RefRecTypeA defines whether the UE supports Type A downlink control channel interference mitigation (CCH-IM) receiver \"LMMSE-IRC + CRS-IC\" for PDCCH/PCFICH/PHICH/EPDCCH receive processing (Enhanced downlink control channel performance requirements Type A in the TS 36.101 [6]). The field cch-InterfMitigation-RefRecTypeB defines whether the UE supports Type B downlink CCH-IM receiver \"E-LMMSE-IRC + CRS-IC\" for PDCCH/PCFICH/PHICH receive processing in synchronous networks (Enhanced downlink control channel performance requirements Type B in the TS 36.101 [6]). The UE supporting the capability defined by cch-InterfMitigation-RefRecTypeB-r13 shall also support the capability defined by cch-InterfMitigation-RefRecTypeA-r13.","paragraph_zero_based":3157},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3158},{"literal_text_all_w_t_and_m_t":"If the UE sets one or more of the fields cch-InterfMitigation-RefRecTypeA and cch-InterfMitigation-RefRecTypeB to \"supported\", the UE shall include the parameter cch-InterfMitigation-MaxNumCCs to indicate that the UE supports CCH-IM on at least one arbitrary downlink CC for up to cch-InterfMitigation-MaxNumCCs downlink CC CA configuration. The UE shall not include the parameter cch-InterfMitigation-MaxNumCCs if neither cch-InterfMitigation-RefRecTypeA nor cch-InterfMitigation-RefRecTypeB is present. The UE may not perform CCH-IM on more than 1 DL CCs. For example, the UE sets \"cch-InterfMitigation-MaxNumCCs = 3\" to indicate that UE supports CCH-IM on at least one DL CC for supported non-CA, 2DL CA and 3DL CA configurations. For CA scenarios, the CCH-IM is guaranteed to be supported on at least one arbitrary component carrier.","paragraph_zero_based":3159},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3160},{"literal_text_all_w_t_and_m_t":"cdma2000-NW-Sharing","paragraph_zero_based":3161},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports network sharing for CDMA2000.","paragraph_zero_based":3162},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3163},{"literal_text_all_w_t_and_m_t":"ce-ClosedLoopTxAntennaSelection","paragraph_zero_based":3164},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports UL closed-loop Tx antenna selection in CE mode A, as specified in TS 36.212 [22].","paragraph_zero_based":3165},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3166},{"literal_text_all_w_t_and_m_t":"ce-CQI-AlternativeTable","paragraph_zero_based":3167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["99241d34e3cb73c4110d7350e50bf260fac077eff38ebdd7ad3f62108614c987","f61d8722347cf0fd901fd9164fd1aaa8e3f6722a1ec53c0c52ad7953dce8f645","3f2b30fe4d0d7722ec629f716612a1c2d448dfa053ec3744f3e8d839a02914fb","c447482166840efec26afe7e34c23c45c841264a6ec8a926ffcb03b053426e2b","9d2341124bbdb22b9eea56b7b46101e5596ebb4929d10c3f45500acf1b2e0671","257f42687da0b7999a1fce39dd19f5ec0eeeb2e711e1a9c8e0de2bda013597bd","4baa27ccf7d6e608151ce57c1b845329fcaebc58c145627cfa7dbcc9ffe0b8cd","a81151111999aded946c26b8e3207e5ec6e7fd26401640b475806d83e42c391b","08672cd989fc325956e02bdec11ad4daf1b01c5b415ba3d14ad1117dc6f65eea","8a387392b4e59914e5643431a444fafd9b09dee98830b684060b56c60e5e4e72","510bd817ae2c0efbefc135bd13460a1d6d28bdfc6440420a6607ec93d9840504","5348f0931353ebcebb649916625463d1bf2887235a491918aca8d872f32d5e52","bbd3f42588eca46899cca75da4b9cea3ba4a194c01d60975287e6c975c1eaed4","ba02921032ed1aa66d492c2f8432d236f3d18d3b98abbc6319841996bcd4023f","52ad8e1388ac5fd8ab26ca50ef00fb2587569e692121f18813483a84cef594a2","a583345dcbd8e1146fa1ebc9fa5aeec90b25a86e2e1f6f5b1c7961a8d912edfd","963e9e3894d778928e0dfde1e238910a4a92fa613030495df73663a32d9af30b","2e326453fe7f19f6b6d908bc419de128adc6421e7df7aecd379afa76c22cbd58","509740750304c90a4e6c33d7a1f19d3000f535b35104cff0fe03c48a9361dbd3","17108e06013bea88537634ab7a08e921e230ba0fc3f35c156757d38553dc1dd7","d97c463c5c6b50e309016d7b4e638ee553f42aa50b240b3125885190bdde6ed3","0d58dead8c5aa7be9b439196753d715bc24337df7279edf5f7c89551bb2e8975","4745276d182b60c220862d56ed6a097384882ab7692a480571130fe84bf9c8cf","70fa97c560085c73b80fba5da843ab6ede43a172022c9da544938e7a2d2a0f8e"],"paragraph_range_zero_based":[3144,3167],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p3144"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports alternative CQI table in CE mode A. See TS 36.213 [22].","paragraph_zero_based":3168},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3169},{"literal_text_all_w_t_and_m_t":"ce-CRS-IntfMitig","paragraph_zero_based":3170},{"literal_text_all_w_t_and_m_t":"Indicates whether UE supports CRS interference mitigation, i.e., value supported indicates UE does not rely on the CRS outside certain PRBs and subframes as defined in TS 36.133 [16], clauses 3.6.1.2 and 3.6.1.3, and TS 36.213 [23] when operating in coverage enhancement mode.","paragraph_zero_based":3171},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3172},{"literal_text_all_w_t_and_m_t":"ce-CSI-RS-Feedback","paragraph_zero_based":3173},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports CSI-RS based feedback when the UE is operating in CE mode A, as specified in TS 36.213 [23].","paragraph_zero_based":3174},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3175},{"literal_text_all_w_t_and_m_t":"ce-CSI-RS-FeedbackCodebookRestriction","paragraph_zero_based":3176},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports CSI-RS based feedback with codebook subset restriction when the UE in CE is operating in CE mode A, as specified in TS 36.213 [23].","paragraph_zero_based":3177},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3178},{"literal_text_all_w_t_and_m_t":"ce-DL-ChannelQualityReporting","paragraph_zero_based":3179},{"literal_text_all_w_t_and_m_t":"Indicates whether UE operating in CE mode supports aperiodic DL channel quality reporting in RRC_CONNECTED.","paragraph_zero_based":3180},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3181},{"literal_text_all_w_t_and_m_t":"ce-EUTRA-5GC","paragraph_zero_based":3182},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE operating in CE mode A or B supports E-UTRA/5GC.","paragraph_zero_based":3183},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3184},{"literal_text_all_w_t_and_m_t":"ce-EUTRA-5GC-HO-ToNR-FDD-FR1","paragraph_zero_based":3185},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE operating in CE mode A or B supports handover from E-UTRA/5GC to NR FDD FR1.","paragraph_zero_based":3186},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3187},{"literal_text_all_w_t_and_m_t":"ce-EUTRA-5GC-HO-ToNR-TDD-FR1","paragraph_zero_based":3188},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE operating in CE mode A or B supports handover from E-UTRA/5GC to NR TDD FR1.","paragraph_zero_based":3189},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3190},{"literal_text_all_w_t_and_m_t":"ce-EUTRA-5GC-HO-ToNR-FDD-FR2","paragraph_zero_based":3191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["b27d1157fcaa5314d9d23e79adb71d4b7fddbb4218239724139d8cbc0968e8de","0e38cc06e77b83691724229abd1d5a2bb89693b699acac16e21dd63031713db2","663af2b59fee45a92c131c50fcb3a12ee60e3e173a36b3c4d0acfea28b286684","535fda5222d12de7d7c89d79d32069db5c7b5741ef358438f254cf38acec92a0","e532ba3406089570a8486d62b5d27bfa3dab1a6b854e9f56b62144d96de53fb2","4dd8080feabcdb57b3b7a4cc5943226cc2b8693a34f6c48aa208607f97302ee1","eaf9abd9d78afe42aeb1a2d63f2d87299c1a3416dac32c9544e26c8a35cfb899","c16ed3664324c7156037942efc24060e2c48acb10076d26ae8a7f62dc052c96f","68654d62c9a8ddbc6685184aae89370a01fd5ad2835cca31b2a485f431f6c603","676f15815314af8a8dc08d553e3819151b5e4956bd933e14f5979a97ce22ee57","2b79448963f84bf