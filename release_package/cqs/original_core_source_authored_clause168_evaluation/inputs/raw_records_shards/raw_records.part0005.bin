{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the value of K0 for cross-slot scheduling with 30 kHz SCS:","paragraph_zero_based":1776},{"literal_text_all_w_t_and_m_t":"4>include preferredK0-SCS-30kHz in the MinSchedulingOffsetPreference IE and set it to the desired value of K0;","paragraph_zero_based":1777},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the value of K0 for cross-slot scheduling with 60 kHz SCS:","paragraph_zero_based":1778},{"literal_text_all_w_t_and_m_t":"4>include preferredK0-SCS-60kHz in the MinSchedulingOffsetPreference IE and set it to the desired value of K0;","paragraph_zero_based":1779},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the value of K0 for cross-slot scheduling with 120 kHz SCS:","paragraph_zero_based":1780},{"literal_text_all_w_t_and_m_t":"4>include preferredK0-SCS-120kHz in the MinSchedulingOffsetPreference IE and set it to the desired value of K0;","paragraph_zero_based":1781},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the value of K2 (TS 38.214 [19], clause 6.1.2.1) for cross-slot scheduling with 15 kHz SCS:","paragraph_zero_based":1782},{"literal_text_all_w_t_and_m_t":"4>include preferredK2-SCS-15kHz in the MinSchedulingOffsetPreference IE and set it to the desired value of K2;","paragraph_zero_based":1783},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the value of K2 for cross-slot scheduling with 30 kHz SCS:","paragraph_zero_based":1784},{"literal_text_all_w_t_and_m_t":"4>include preferredK2-SCS-30kHz in the MinSchedulingOffsetPreference IE and set it to the desired value of K2;","paragraph_zero_based":1785},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the value of K2 for cross-slot scheduling with 60 kHz SCS:","paragraph_zero_based":1786},{"literal_text_all_w_t_and_m_t":"4>include preferredK2-SCS-60kHz in the MinSchedulingOffsetPreference IE and set it to the desired value of K2;","paragraph_zero_based":1787},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the value of K2 for cross-slot scheduling with 120 kHz SCS:","paragraph_zero_based":1788},{"literal_text_all_w_t_and_m_t":"4>include preferredK2-SCS-120kHz in the MinSchedulingOffsetPreference IE and set it to the desired value of K2;","paragraph_zero_based":1789},{"literal_text_all_w_t_and_m_t":"2>else (if the UE has no preference on the minimum scheduling offset for cross-slot scheduling for the cell group):","paragraph_zero_based":1790},{"literal_text_all_w_t_and_m_t":"3>do not include preferredK0 and preferredK2 in the MinSchedulingOffsetPreference IE;","paragraph_zero_based":1791},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide minSchedulingOffsetPreferenceExt of a cell group for power saving according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":1792},{"literal_text_all_w_t_and_m_t":"2>include minSchedulingOffsetPreferenceExt in the UEAssistanceInformation message;","paragraph_zero_based":1793},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on the minimum scheduling offset for cross-slot scheduling for the cell group for FR2-2:","paragraph_zero_based":1794},{"literal_text_all_w_t_and_m_t":"3>include minSchedulingOffsetPreferenceExt in the UEAssistanceInformation message;","paragraph_zero_based":1795},{"literal_text_all_w_t_and_m_t":"4>if the UE has a preference for the value of K0 (TS 38.214 [19], clause 5.1.2.1) for cross-slot scheduling with 480 kHz SCS:","paragraph_zero_based":1796},{"literal_text_all_w_t_and_m_t":"5>include preferredK0-SCS-480kHz in the minSchedulingOffsetPreferenceExt IE and set it to the desired value of K0;","paragraph_zero_based":1797},{"literal_text_all_w_t_and_m_t":"4>if the UE has a preference for the value of K0 for cross-slot scheduling with 960 kHz SCS:","paragraph_zero_based":1798},{"literal_text_all_w_t_and_m_t":"5>include preferredK0-SCS-960kHz in the minSchedulingOffsetPreferenceExt IE and set it to the desired value of K0;","paragraph_zero_based":1799}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["105e7ebf987cd964b82deea46586751745ef3d6451f54b633a9e34d2215248d9","36adda1decd50fb69caa40867696c3f3e7335eec0bd3b8d3266040d3c23feeaf","15bc24b17677f26c8659559cfceee9733d11dfd6941edda42b09b4c59b6b837d","d02ffb7de2cf0ea274cfc3eb1d7a0ba40438014057b4b640bcbb96936080bd92","56a8d33fb56c3fabc2e54d225f4f21726f590bc5abd5a4f62248462934260b5f","fd739fdc8c4019c9e76cda9f4f22c8a996218e5b33191b11fefcb38f798505c5","da6323726ca4bc37cbe1b36b7051be1971a476b026b7abf7e9135842033e1959","17c07733421c23cb3569e6b80563b954d81f71592c915b4bb389602fa4ee1074","797d89709382dc8e23e8734b6acc6378799595d06f32e90d2392ff6f4bf0e095","89e5515e71f3e2fb2753afc54f1bbd0b246a757d9922bb2416fa7644c151d279","b02c10dfde5d53988b49c9cc982caa364fd33614e7657f1138f7d73bf548be6e","28c8768143b04eee61cd2bfaec5dfb90782e801e599e26ce1d9c0f8a21892053","2353419d1e33bf0cb041ea177900cd566bfa3b47e900c267b7730c46606c29bc","e25bf4af2fbeb4295c605bcf3f01d894937b9b858e2d43fafc696174062af9f1","6fb583888de0a8e67fb8ec2cb2bd422f4e693e66bc4f41bfef81877ab2a515e4","f7df943b207e90c3a13cc4125bdbd16a355ca05184039620162f6de77705edff","6d4ca80991ac1d0defbc820de9ed01f0ba2b670070d872b7ce96e29fb52392db","c7f3c8904976ac7d345a7aeb5fc0c50b308aa6c43c55b1a011714ac1e444972a","5d84f8a21e7d3ce1fcb55650f5bc73b37e14449f44c9c1cd93d60d19948f0e62","8cdde20ca8e450bcff0b64aaf82cfa1f29f78f1b2d928f0cf9174ef3940d8536","e288d5de72426a1fc40a4d8f54bf8820ba13b7e531d26eedc0aac2fbe8c933b5","de97e4ee2eb7ef7a99f7ebb103527cc15dd1ad64f735335eb90ec10a1d8490fe","73968a9dd14d9f7083dbbeee1054298c8af5e9f91f13214d3ce7f5b1fcb6a682","01448f0761584995f467f53f47e6f2493dd4e186667586b0fee99cd2fd26ffbe"],"paragraph_range_zero_based":[1776,1799],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx:p1776"}
{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>if the UE has a preference for the value of K2 for cross-slot scheduling with 480 kHz SCS:","paragraph_zero_based":1800},{"literal_text_all_w_t_and_m_t":"5>include preferredK2-SCS-480kHz in the minSchedulingOffsetPreferenceExt IE and set it to the desired value of K2;","paragraph_zero_based":1801},{"literal_text_all_w_t_and_m_t":"4>if the UE has a preference for the value of K2 for cross-slot scheduling with 960 kHz SCS:","paragraph_zero_based":1802},{"literal_text_all_w_t_and_m_t":"5>include preferredK2-SCS-960kHz in the minSchedulingOffsetPreferenceExt IE and set it to the desired value of K2;","paragraph_zero_based":1803},{"literal_text_all_w_t_and_m_t":"3>else (if the UE has no preference on the minimum scheduling offset for cross-slot scheduling for the cell group):","paragraph_zero_based":1804},{"literal_text_all_w_t_and_m_t":"4>do not include preferredK0 and preferredK2 in the minSchedulingOffsetPreferenceExt IE;","paragraph_zero_based":1805},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide a release preference according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":1806},{"literal_text_all_w_t_and_m_t":"2>include releasePreference in the UEAssistanceInformation message;","paragraph_zero_based":1807},{"literal_text_all_w_t_and_m_t":"2>set preferredRRC-State to the desired RRC state on transmission of the UEAssistanceInformation message;","paragraph_zero_based":1808},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide an indication of preference in being provisioned with reference time information according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":1809},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference in being provisioned with reference time information:","paragraph_zero_based":1810},{"literal_text_all_w_t_and_m_t":"3>set referenceTimeInfoPreference to true;","paragraph_zero_based":1811},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":1812},{"literal_text_all_w_t_and_m_t":"3>set referenceTimeInfoPreference to false.","paragraph_zero_based":1813},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide preference on FR2 UL gap according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":1814},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference for FR2 UL gap configuration:","paragraph_zero_based":1815},{"literal_text_all_w_t_and_m_t":"3>set ul-GapFR2-PatternPreference to the preferred FR2 UL gap pattern;","paragraph_zero_based":1816},{"literal_text_all_w_t_and_m_t":"2>else (if the UE has no preference for the FR2 UL gap configuration):","paragraph_zero_based":1817},{"literal_text_all_w_t_and_m_t":"3>do not include ul-GapFR2-PatternPreference in the UL-GapFR2-Preference IE.","paragraph_zero_based":1818},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide musim-GapPreferenceList and/or musim-GapPriorityPreferenceList and/or musim-GapKeepPreference, or provide MUSIM assistance information for leaving RRC_CONNECTED according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":1819},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference for MUSIM periodic gap(s):","paragraph_zero_based":1820},{"literal_text_all_w_t_and_m_t":"3>include musim-GapPreferenceList with an entry for each periodic gap the UE prefers to be configured;","paragraph_zero_based":1821},{"literal_text_all_w_t_and_m_t":"4>set musim-GapLength and musim-GapRepetitionAndOffset in the musim-GapInfo IE to the values of the length and the repetition/offset of the gap(s), respectively, the UE prefers to be configured with;","paragraph_zero_based":1822},{"literal_text_all_w_t_and_m_t":"4>if UE has a preference for MUSIM gap priority;","paragraph_zero_based":1823}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["dcad847d67b2d9f2c28637260bf0403162448fb6043b631a7f566a82c77a7ff8","642b4cafc29cb8276f4340c6bfb3001d762045196ea986785c36e01ec77e0ce5","4685e51aa3df5c3fb694873b8c963a0912e2f7499c891866770528b5696091bb","50e50c22c951816a896687d9df009c61a266af0cb81533e50b7c2e3c0fc75c35","417421097cc24ccb1714633d66744ada81340565f3c32ab6e26cc65ca17b3534","eed1fdd9b191d7d841f664cb2ed3f7e717cffeb05acc33ee638d64ddfba4b46f","6e7762b4056720789169b5fd4d4bdb63a23ae45488d29024bb205fde9c146ec4","afe3d906d3d647d77ab0eb040837e36d73e91ac567580c239ec8d1f872c7f9c2","92d6a44341c7e7e1fbf7b26f2a86686920497f21cc76dc6c9fb0bbd5050d8672","431afbd780536d52bdd13067eaca4381e21967e5cd7a38dd7079ea82bd505513","ca8eb344d5b5e712eaeb6eec6482c83425b259d09e0317ebe7dfa30cb165c1fd","a9d0be5db81bb08b438d59ef77515a0264e1ccd579d07d23b6fe89bbcfdd22ae","54b6513c03af0dced9e08af4008aa9e43ec8a8a9501713fbaf1af7e9ff8cd1a5","02b499a382f09b946ccb1d2cc9d930a0a62e004200935784fc3c7a5208bad9c8","12a39b62610bc68957a109a5faa36498d34e624e2c72dda85871966acf904c46","ab9b61663c1ab64840ffa687e006ef0c4747d58d5105cdec39fb47978f795d9c","850237c7e3382d3a8f6f0c22cfbf3cede06751ad0d64217e08221b52b6d024bf","7455fcbe2268e6939d7f6e8bb454073e3549544acef75e11d75fd6bc7a9bdf6a","167180879e46c0e8e05efb7a5fd57fdb07ec15b82eb8198315caf1a24fe7bc4d","78714e252cdc360505d95b57ae90c6bd6b7b8c5c595ff8599adcb782362f2927","c20f1341a2a529cdb65ff115a69a558c8bd05df5b8a2219995e1427597776b13","293f79b30d8fa2915d3fb982c4f028fc5692d5ed4d3e73a48641f1d214a69b04","64beebaf24dcd19b1a23521cedf8a8d64bcd00514ae0fff3ae778e458b54a81d","a9280dbf108ba823fb2aee0b172229283b6aa0be316375d4e8650d60c8c1fffc"],"paragraph_range_zero_based":[1800,1823],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx:p1800"}
{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5>include the musim-GapPriorityPreferenceList the UE prefers to be configured;","paragraph_zero_based":1824},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference for MUSIM aperiodic gap:","paragraph_zero_based":1825},{"literal_text_all_w_t_and_m_t":"3>include the field musim-GapPreferenceList, with one entry for the aperiodic gap the UE prefers to be configured;","paragraph_zero_based":1826},{"literal_text_all_w_t_and_m_t":"4>include musim-GapLength in the musim-GapInfo IE and set it to the values of the length of the gap the UE prefers to be configured with;","paragraph_zero_based":1827},{"literal_text_all_w_t_and_m_t":"4>optionally include musim-Starting-SFN-AndSubframe in the musim-GapInfo IE and set it to the starting SFN/subframe of the gap the UE prefers to be configured with;","paragraph_zero_based":1828},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference to keep all colliding MUSIM gaps:","paragraph_zero_based":1829},{"literal_text_all_w_t_and_m_t":"3>include the musim-GapKeepPreference;","paragraph_zero_based":1830},{"literal_text_all_w_t_and_m_t":"2>if the UE has no longer preference for the periodic/aperiodic gaps:","paragraph_zero_based":1831},{"literal_text_all_w_t_and_m_t":"3>do not include musim-GapPreferenceList, musim-GapPriorityPreferenceList and musim-GapKeepPreference in the musim-Assistance IE;","paragraph_zero_based":1832},{"literal_text_all_w_t_and_m_t":"2>if UE has a preference to leave RRC_CONNECTED state:","paragraph_zero_based":1833},{"literal_text_all_w_t_and_m_t":"3>set musim-PreferredRRC-State to the preferred RRC state.","paragraph_zero_based":1834},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide musim-CapRestriction according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":1835},{"literal_text_all_w_t_and_m_t":"2>if UE has a preference for temporary capability restriction:","paragraph_zero_based":1836},{"literal_text_all_w_t_and_m_t":"3>if UE has a preference for serving cell(s), except PCell, and/or SCG to be released:","paragraph_zero_based":1837},{"literal_text_all_w_t_and_m_t":"4>include the musim-Cell-SCG-ToRelease;","paragraph_zero_based":1838},{"literal_text_all_w_t_and_m_t":"5>set musim-CellToRelease to include the serving cell(s) the UE prefers to be released;","paragraph_zero_based":1839},{"literal_text_all_w_t_and_m_t":"5>set scg-ReleasePreference to scgReleasePreferred if the UE prefers the SCG to be released;","paragraph_zero_based":1840},{"literal_text_all_w_t_and_m_t":"3>if UE has a preference to indicate the serving cells with restricted capabilities:","paragraph_zero_based":1841},{"literal_text_all_w_t_and_m_t":"4>include the musim-CellToAffectList the UE prefers to be configured;","paragraph_zero_based":1842},{"literal_text_all_w_t_and_m_t":"5>include the musim-ServCellIndex and the musim-MIMO-Layers-DL/ musim-MIMO-Layers-UL/ musim-SupportedBandwidth-DL/ musim-SupportedBandwidth-UL for the corresponding serving cell;","paragraph_zero_based":1843},{"literal_text_all_w_t_and_m_t":"3>if UE has a preference to indicate the maximum number of CCs:","paragraph_zero_based":1844},{"literal_text_all_w_t_and_m_t":"4>include the musim-CapRestriction for the musim-MaxCC the UE prefers to be configured;","paragraph_zero_based":1845},{"literal_text_all_w_t_and_m_t":"5>include the musim-MaxCC-TotalDL/ musim-MaxCC-TotalUL/ musim-MaxCC-FR1-DL/ musim-MaxCC-FR1-UL/ musim-MaxCC-FR2-1-DL/ musim-MaxCC-FR2-2-UL/ musim-MaxCC-FR2-2-DL/ musim-MaxCC-FR2-2-UL for the corresponding maximum number of CCs;","paragraph_zero_based":1846},{"literal_text_all_w_t_and_m_t":"3>if UE has a preference to indicate band(s) and/or combination(s) of bands with capabilities restricted which comprise of the band(s) that is/are indicated in musim-CandidateBandList:","paragraph_zero_based":1847}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["84156e35265c7d0d9e887b0687d78ebc02cb7a78b4da421b98663572db00af40","f5d653dce438e763290af9a4a55ec86b7c55b7a4626a44beb674983a4079489c","774387acfd2107870c5194f62bdb3952114816fd4025de5d7eab0f95faa791b9","4e1fc75dfdac6e49e23be83143928bc5384f673801d956d79499c6d1ba4c1381","8d0c265acc7c7ac0ee31d716fceaf04eb698593882bfbafa39cef01fb1df94d7","495e56c09e0d6372845929baadd35731c8ea8e3ad49cff76c328e0917df55c09","57ebb481a0e08653faecd196c13dd6ca2e7d077f6d016f23edaf5c6b439bc54b","56f28d9c8c52ceacc6e5e25dfc19310edadd043027053184d234c7208e49e29c","a0da83f4e7511e0d3ecf3345d6d61597fb72eb68b10305e8cd905fff52c90537","8bf27a0d6e9c76ac74612c430036da4fe0ab94002947fa177da06e0cc8cfe1d2","fedf9c342bdbf39c31341efe706d1f58f7533c66b0b3db4cced6c211a225d652","1579ecd4d3653f6be6e9b13f6e3e21397388954678de39cd8bf9da950d348bd3","3693c800e86b7a97e059cd6f47df182b451126a44c4dc0d5e15f919f98d05b5a","13a8d78defe0eef3d838ba6b4ad8418c54af4dbc750f807d962bf8fe5e5a504a","4d1a8b41559a130d3622d3db03457f8446b1c4b57f65e5db85135be19d4a8618","949f3d9ac6cb4c977c264b2a8ae5da51b5580e4613e41346c86e013f53df0632","2076b1b92b6b723b4e237de661da4062df2217cf99cc25dfa81c75a60ee7e59d","8d0361f8355b42683384aee505a689d2271922b1ab2487f562ed8c8c20ab9511","7b43ca2add2261efe86ffcbac9bd7dd6b1586578881ead5e1171f6049ba02439","71238c788c620bf0b9f5169d4bbab4d43cef2e0ae58bdfe8a30aa497e47c69cb","a1c0ed62213dd4b1ca29644ce489b02e13c8bc35700de2bcc1b472a4beb9857f","5a2af003d9d93834be6836da5a5aa15c4190aaf6da0a276f02dc464259f4ab21","c6680daa18794b4ec6eeddf6f10e324ca93bb1b3cf29f8f70fe14deff15a5897","1c123eb8d0104c4d07bd45df3c24c93a039898f3c223eef3d0b1de2f984f4e8f"],"paragraph_range_zero_based":[1824,1847],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx:p1824"}
{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>include the musim-AffectededBandsList the UE prefer to be configured with capabilities restricted;","paragraph_zero_based":1848},{"literal_text_all_w_t_and_m_t":"5>include the musim-bandEntryIndex for each band or each band of the combination(s) for which capabilities are restricted;","paragraph_zero_based":1849},{"literal_text_all_w_t_and_m_t":"5>include the musim-CapabilityRestricted for the corresponding band;","paragraph_zero_based":1850},{"literal_text_all_w_t_and_m_t":"3>if UE has a preference to indicate band(s) and/or combination(s) of bands to be avoided which comprise of band(s) that is indicated in musim-CandidateBandList:","paragraph_zero_based":1851},{"literal_text_all_w_t_and_m_t":"4>include the musim-AvoidedBandsList the UE prefers not to be configured;","paragraph_zero_based":1852},{"literal_text_all_w_t_and_m_t":"5>include the musim-bandEntryIndex for each band or each band of the combination(s) to be avoided;","paragraph_zero_based":1853},{"literal_text_all_w_t_and_m_t":"2>if UE has no longer preference for temporary capability restriction indicated by musim-Cell-SCG-ToRelease, musim-CellToAffectList, musim-MaxCC, musim-AffectededBandsList and/or musim-AvoidedBandsList:","paragraph_zero_based":1854},{"literal_text_all_w_t_and_m_t":"3>do not include the corresponding temporary capability restriction preference in the musim-CapRestriction;","paragraph_zero_based":1855},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide musim-NeedForGapsInfoNR according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":1856},{"literal_text_all_w_t_and_m_t":"2>include intraFreq-needForGap and set the gap requirement information of intra-frequency measurement for each supported NR serving cell;","paragraph_zero_based":1857},{"literal_text_all_w_t_and_m_t":"2>if the requestedTargetBandFilterNR-r16 of NeedForGapsConfigNR is configured:","paragraph_zero_based":1858},{"literal_text_all_w_t_and_m_t":"3>for each supported NR band included in requestedTargetBandFilterNR-r16, include an entry in interFreq-needForGap and set the measurement gap requirement information for that band;","paragraph_zero_based":1859},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":1860},{"literal_text_all_w_t_and_m_t":"3>include an entry in interFreq-needForGap and set the measurement gap requirement information for each supported NR band;","paragraph_zero_based":1861},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide the relaxation state of RLM measurements of a cell group according to 5.7.4.2:","paragraph_zero_based":1862},{"literal_text_all_w_t_and_m_t":"2>if the UE performs RLM measurement relaxation on the cell group according to TS 38.133 [14]:","paragraph_zero_based":1863},{"literal_text_all_w_t_and_m_t":"3>set the rlm-MeasRelaxationState to true;","paragraph_zero_based":1864},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":1865},{"literal_text_all_w_t_and_m_t":"3>set the rlm-MeasRelaxationState to false;","paragraph_zero_based":1866},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide the relaxation state of BFD measurements of a cell group:","paragraph_zero_based":1867},{"literal_text_all_w_t_and_m_t":"2>for each serving cell of the cell group:","paragraph_zero_based":1868},{"literal_text_all_w_t_and_m_t":"3>if the UE performs BFD measurement relaxation on this serving cell according to TS 38.133 [14]:","paragraph_zero_based":1869},{"literal_text_all_w_t_and_m_t":"4>set the n-th bit of bfd-MeasRelaxationState to '1', where n is equal to the servCellIndex value + 1 of the serving cell;","paragraph_zero_based":1870},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":1871}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["759949d94f86b33547ceb4d1c2a20e4140949b25748ebb21386822bfb1679909","0bee69945468d2de11e5f411a6c763e77a0618f83dc261750032173990a9906c","ebd5059543a246c9e4d8eedc027a2c3f9bfa50f1d1e3891d29218cc3672e841e","2c527ad515bb964f28df3ae73e1af83ebe0c87aed4b9d06201589785536094dd","a7a3524de46de3ddc6cb846cd2ca3dc733ae5b3f9bb2e7a32fface49a87a6192","a65ed66b66007063b9c32e6fcee4eec1221781fed52877e9815d1710bc7811c1","9d4a415e560d63c9e619ef1ad3dcad5707ecabd372e715c229ec85a493e55652","74f5eaaa6b891b916e8ead131f5148abafc4d2aa0beac504f616fa6c3bf584d7","6e1dc07fb145e772e65a261181c0715bca38cf0daf72ff0cea1e9edc9bbfe448","12fed949b78408a45d95eb4d1eb176d44550429ae6aca4f0d1950cfdbaea7dc2","7956d94947519e7355ab4f55d726755f8075084d58a541bdf3c35b32cb7d8ad1","da0cf6420769b0dc91ed3ca190ea1dd28a0fb6988c5930ed807f146c5b952480","e7ffe395e8996be5ce56830fbf103c0f53864f2acefa9435638f6ff8900f1444","ce6bed5ab9c3a68d0442079c33a292b4d9bc64889908ca6c6523267f1f65b6c5","8f5c4437d0a4e8013eafa4a442f13d1e3c40e0ce444b9fc8c48a05a798c5ad38","279dbe252e1938ef418cad4f5fe98a858c327cdc54e1b5e89ceca438f820d506","a7b224888ea5736d29fd8f6dc9ff1059c50c1a97c1bc648399ac88bb7e3bbd3f","148b01151596320351fd23a1c9e061c8ca85e9350de3d2cb371d3ec4ae62ad2a","7849dc49af3a0d3fc1b58d16313795763324517e3a63d8af7d2945dcca4f95b2","5dc1b14a75a105d69126c8543cd4014d85529faf42c7ea27dafac627a146d45c","7184e7fae5dd94fb149bebe22ff645599fa9de19308feb23c20983c6f3a14251","c07d383589300b71afe95bb8ee32bfa7293977f1cec17bd9ff72686c9a821bf3","58a7edc3a04ecdf4a458d9e04dbc732f43dc24e893f562702cae22f017269f30","82c8f5794709b4f38d70d0c487600ff21a5f4