ted table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"424eb093f767dd650e5338895960519d92ebea981f57d2d92b779f748b231a17","original_member_sha256":"c43941f5cb11f87748367ce8365b9a3c5ac1bf79a9c30e779a91aa0d1036aaf3","paragraph_ElementTree_utf8_XML_sha256":["20cd41a2604230b889af4affba43f19a74df155dd6e667d37cfac7eefd6b7adb","4328dbc2e9ed59984edad9da9f918a037222a8bc1d4a7f801e449d0bf4e71fd0","1b57abbb250ccf0e7dbcfaad8666dd22e39df29408dc1d6e61b3298df1a31533","dca27312d7a1517d19ed558671871fab25e9b549c607883b97a78f9f3628f08a","6d3fba1314de1001e3753ed4f16b9c74cdf0271805f61b17dcc5b42bd590842f","617785343afc34ff86d7085e070e5171c849cf65b766df069d11ae4921b43535","71c3f147aa800c7827dbc734528090cf1030b54daf02241d689a0ba8e7e256ef","cb9646e53a961acadd8b9d1cbe9977f71385aded0c0dd84e225defb7e8545ad8","e434e65a10e838afc9f35a37c5efebc215fd9aedc21692d7cc12941674744e85","48f27d1f338f2e6cabf1ff384625f9d1a5e67ab8190bf0af224f5e9fd5a2044d","1922bd9f89f171c9b68189ce43b9678222fd91e4cd2b7d0e09c98b410db850b5","731cd85286f824ffc8ab15b3e076faaf16231b040ec58d5b982eb0b04411f518","c7d1edd363ff43b04ccc4b4e034ae335a847cc479f4e835f253c7f633964532d","15446e336e26f8e8542354aaa67cefc1b9b0d8b4af76558f1b7e96594ab3e72b","032e9f858d3d59ab048f1c6847f25e5b233bb6ba0c88c96eee40690f328745ca","1ac810a1cab11c95a1df934fbe11d17d0c7b90f828c877e62a98a07ed58b7dfa","23d2b97bf7365b8f13a13b743bd979ed62c7a17aae3d8a96c8592944c90e3c16","dd30285afd134c378b4bcddbd9cfda345476859925abfa26105ccb7ba6ed8160","ebb18e058d1fac3e0efc9941e530e6c9327f91af82e47a50969e70a111afea2a","65f229fbb72479868879767acc7a736f7f9164c727f25f5e5c51c84c6732aef6","dcb00a9e6c6c316c0088d2dc5f1b8ad2617b4424352762cd9029642ce44b55be","adf91afec1ef44a2388772bd7103ea6e4f36004e933a3b58dc00af5209fde022","500ae1e95311986e752b9be027e0c22a78d267c2f0de2c686523828721158b14","1cef444d894cdacbe559bb45e53c3b2ef7f77da82c45f0f24d784d4541645307"],"paragraph_range_zero_based":[24,47],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a fin