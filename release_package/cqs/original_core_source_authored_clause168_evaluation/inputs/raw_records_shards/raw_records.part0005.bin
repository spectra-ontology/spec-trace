{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Perform the actions as specified in 5.3.8.6.","paragraph_zero_based":50952},{"literal_text_all_w_t_and_m_t":"T346h","paragraph_zero_based":50953},{"literal_text_all_w_t_and_m_t":"Upon transmitting UEAssistanceInformation message with musim-GapPreferenceList or musim-GapPriorityPreferenceList and/or musim-GapKeepPreference Information.","paragraph_zero_based":50954},{"literal_text_all_w_t_and_m_t":"Upon releasing musim-GapAssistanceConfig during the connection re-establishment/resume procedures, or upon receiving musim-GapAssistanceConfig set to release.","paragraph_zero_based":50955},{"literal_text_all_w_t_and_m_t":"No action.","paragraph_zero_based":50956},{"literal_text_all_w_t_and_m_t":"T346i","paragraph_zero_based":50957},{"literal_text_all_w_t_and_m_t":"Upon transmitting UEAssistanceInformation message with scg-DeactivationPreference","paragraph_zero_based":50958},{"literal_text_all_w_t_and_m_t":"Upon releasing scg-DeactivationPreferenceConfig during RRC connection re-establishment/resume or upon receiving scg-DeactivationPreferenceConfig set to release.","paragraph_zero_based":50959},{"literal_text_all_w_t_and_m_t":"No action.","paragraph_zero_based":50960},{"literal_text_all_w_t_and_m_t":"T346j (The UE maintains one instance of this timer per cell group)","paragraph_zero_based":50961},{"literal_text_all_w_t_and_m_t":"Upon transmitting UEAssistanceInformation message with rlm-RelaxationReportingConfig.","paragraph_zero_based":50962},{"literal_text_all_w_t_and_m_t":"Upon releasing rlm-RelaxationReportingConfig during the connection re-establishment/resume procedures, upon receiving rlm-RelaxationReportingConfig set to release, or upon performing MR-DC release.","paragraph_zero_based":50963},{"literal_text_all_w_t_and_m_t":"No action.","paragraph_zero_based":50964},{"literal_text_all_w_t_and_m_t":"T346k (The UE maintains one instance of this timer per cell group)","paragraph_zero_based":50965},{"literal_text_all_w_t_and_m_t":"Upon transmitting UEAssistanceInformation message with bfd-RelaxationReportingConfig.","paragraph_zero_based":50966},{"literal_text_all_w_t_and_m_t":"Upon releasing bfd-RelaxationReportingConfig during the connection re-establishment/resume procedures, upon receiving bfd-RelaxationReportingConfig set to release, or upon performing MR-DC release.","paragraph_zero_based":50967},{"literal_text_all_w_t_and_m_t":"No action.","paragraph_zero_based":50968},{"literal_text_all_w_t_and_m_t":"T346l","paragraph_zero_based":50969},{"literal_text_all_w_t_and_m_t":"(The UE maintains one instance of this timer per QoS flow)","paragraph_zero_based":50970},{"literal_text_all_w_t_and_m_t":"Upon transmitting UEAssistanceInformation message with ul-TrafficInfo for the concerned QoS flow.","paragraph_zero_based":50971},{"literal_text_all_w_t_and_m_t":"Upon releasing ul-TrafficInfoReportingConfig during the connection re-establishment/resume procedures, or upon receiving ul-TrafficInfoReportingConfig set to release.","paragraph_zero_based":50972},{"literal_text_all_w_t_and_m_t":"No action.","paragraph_zero_based":50973},{"literal_text_all_w_t_and_m_t":"T346m","paragraph_zero_based":50974},{"literal_text_all_w_t_and_m_t":"Upon transmitting UEAssistanceInformation message with multiRx-PreferenceFR2.","paragraph_zero_based":50975}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["400b8c4e1596567d18351edb38e88c3842b62083d9296a074779246f41a4d7bb","67c5785a26c7ece7f8f9013d751d5566cb1b48ed59c0afda27317f9c67198283","183598931b03d