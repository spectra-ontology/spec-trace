inates":{"document_XML_sha256":"0e6c32bda25412abb0b58d77181616769d56eae3160cba0d5632b349b9bf7fd4","original_member_sha256":"d85cab2cb82621072a7cb69f1bacdd57619bf18e8ecc115ef77254675e737d67","paragraph_ElementTree_utf8_XML_sha256":["806c076d17cdeadbba9b61c11f1b500d37c13a6cebab1946da0f6e6aaa76020f","4328dbc2e9ed59984edad9da9f918a037222a8bc1d4a7f801e449d0bf4e71fd0","dbba888a7554d6144aa24058089e27e36efc6eb67f19efc349acdb5767c3320c","dca27312d7a1517d19ed558671871fab25e9b549c607883b97a78f9f3628f08a","6d3fba1314de1001e3753ed4f16b9c74cdf0271805f61b17dcc5b42bd590842f","617785343afc34ff86d7085e070e5171c849cf65b766df069d11ae4921b43535","ebc6648c870b9b75d626151d75112e1405aa0dd9bfb6dfe4646edc87ebd3ac3e","cb9646e53a961acadd8b9d1cbe9977f71385aded0c0dd84e225defb7e8545ad8","e434e65a10e838afc9f35a37c5efebc215fd9aedc21692d7cc12941674744e85","48f27d1f338f2e6cabf1ff384625f9d1a5e67ab8190bf0af224f5e9fd5a2044d","91d07d709cd492591488f21fa9204aa2394272a43bb6382981c2cc5ebcc46799","731cd85286f824ffc8ab15b3e076faaf16231b040ec58d5b982eb0b04411f518","f0114d5ad1eac267962abbb727c5f6f34fa6599ec6e7ca0e59e13775cf2e37df","15446e336e26f8e8542354aaa67cefc1b9b0d8b4af76558f1b7e96594ab3e72b","032e9f858d3d59ab048f1c6847f25e5b233bb6ba0c88c96eee40690f328745ca","1ac810a1cab11c95a1df934fbe11d17d0c7b90f828c877e62a98a07ed58b7dfa","60f88602b375b2b768a0407a0506245239854802ab530235e7bb29f81577579d","492b7444226f413f0a1340c12621440bca109e51b0ecbcfc3a0e75d0b19498cc","b3f8ba76ec829a0eac6003bc8cbccaed17d41a62756dd1214cc8a7fa8c87c76d","ebb18e058d1fac3e0efc9941e530e6c9327f91af82e47a50969e70a111afea2a","d30bed076ff6ace3a6e804ac6a8981062e6fdc96fdb68b59152cca2caddf5ee4","dcb00a9e6c6c316c0088d2dc5f1b8ad2617b4424352762cd9029642ce44b55be","adf91afec1ef44a2388772bd7103ea6e4f36004e933a3b58dc00af5209fde022","500ae1e95311986e752b9be027e0c22a78d267c2f0de2c686523828721158b14"],"paragraph_range_zero_based":[24,47],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2408776.zip::R2-2408776 Correction to the need code in AssistanceDataSIBelement-r17.docx:p24"}
{"fields":{"filename":"R2-2408776.zip::R2-2408776 Correction to the need code in AssistanceDataSIBelement-r17.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"A","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"Rel-17","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-17(Release 17)Rel-18(Release 18)Rel-19(Release 19) Rel-20(Release 20)","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"Reason for change:","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"The usage of need code in LPP spec was codified as follows:","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"For the need code of the downlink LPP message, in R16, there has been a CR in R16 discussion period to examine all the issues at that time. The CR R2-2105045 was agreed.","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"However, within the IE AssistanceDataSIBelement, there are two fields whose need code are specified as need OP, namely cipheringKeyData and segmentationInfo. Within the field description of the two fields, currently, there are no descriptions for the UE behavior when the two fields are absent. This deviates from the meaning of Need OP.","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"Furthermore, the field expirationTime is also specified as need OP, while the default UE behavior when the field is absent is not provided. Although within the field description of valueTag, the following description has been given, it is not clear how the UE should interpretate the validity of the broadcast assistance data when the field is absent.","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"0e6c32bda25412abb0b58d77181616769d56eae3160cba0d5632b349b9bf7fd4","original_member_sha256":"d85cab2cb82621072a7cb69f1bacdd57619bf18e8ecc115ef77254675e737d67","paragraph_ElementTree_utf8_XML_sha256":["1cef444d894cdacbe559bb45e53c3b2ef7f77da82c45f0f24d784d4541645307","e4ea5591218aa96d0cd407936b651eb165fb4c75e229dab64ec9de6be991cb96","2d00e3b1a82065155328ddd802c3d4a8ebff11f4a0d6da9ecf9b1e34dc8ebfc8","46405581f8d3505c4d8ba223e84af7c3d68d598350c2d542a9e99acc7721242a","761fa4d36b282591b5f5bb5ee554c6086f6eb9d5925f257d405f142f9e3a17e1","9ee3a8ef1b4d8b5d23ae68c79878f83d9a7ffdf02ec93cff53f7b1de6029f4d6","07e53fd334708bd78f5b73c858489e82f3738639b807f17335a7aa07c29bb72b","b08252b53f111fda758564f01d6aeb287a86ceee9730eba0ca5fcf7c7dadb00e","5397ebe3cc2afa3393b897343a62f60e5b485315d8236802a715ec930f5cc336","7c61598d36231c8c627b619058f3e5bce43e46708c526cd707c053fffd16c7e6","dd3de490bf00baf5087f33777fa272abbec9623033d71526d5355fb97ee7f36f","16c8d70f7d429c511b56c375317337c5d5c75b5a185ec91bf088b77069963fb7","acd6206245de4b9556a4853ff1b8b41875944834aa76df6c7d72af763f365262","3c4c80e1e11044a4d07c2d065ab1badcf74a3b84af6435503a27154aade28f9b","aea0b370a559e9129eb5cc426cf29b1a940395ed90d8eb318dc869dbee08f2db","4418bcdbb4f6daae7cd6f06ccb732424d83df9d3248155e2e66c0b82b178a6d2","055a37f8c968fc8e20da801a83871e69c3dd63354f1f14ad734e8531592833a7","5c06a6de25fb906f6ea60ab437d81bba842511eb8cb0afd3f93549bdb7fa5ab0","537ff6e7dcbe0d4c273f0881d026250ef02f9e2800614ee951d60e11f57e223b","1b5f0512dd3ea5cb153958c1fb38ff926756e570408d15d5d60b123b9a5ad8ee","8be03b3bc73a831d8a36de1080b5c9f30ea3372082675d13b9aa823f01c00b09","df5848019a8a6dea18e10cae6072f61dd34cf5818cc49b5b0024ec4a68582a57","38927fffc1430c09dc750455b5883f219d67f7ec3ebf902c16ed652a91ba9beb","8b24573e0133d1c5ee95e1377545628b16380b4d3d980bde5296376e8173041e"],"paragraph_range_zero_based":[48,71],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2408776.zip::R2-2408776 Correction to the need code in AssistanceDataSIBelement-r17.docx:p48"}
{"fields":{"filename":"R2-2408776.zip::R2-2408776 Correction to the need code in AssistanceDataSIBelement-r17.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":72},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":73},{"literal_text_all_w_t_and_m_t":"1/ Change need code of the field ciperhingKeyData and SegmentationInfo from need OP to need OR","paragraph_zero_based":74},{"literal_text_all_w_t_and_m_t":"2/ Add the defalut UE behavior when the field expirationTime is absent","paragraph_zero_based":75},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":76},{"literal_text_all_w_t_and_m_t":"Inter-Operability analysis:","paragraph_zero_based":77},{"literal_text_all_w_t_and_m_t":"Impacted functionality:","paragraph_zero_based":78},{"literal_text_all_w_t_and_m_t":"Broadcast of assistance data","paragraph_zero_based":79},{"literal_text_all_w_t_and_m_t":"Inter-operability: ","paragraph_zero_based":80},{"literal_text_all_w_t_and_m_t":"If the UE is implemented according to this CR while the network is not, or ","paragraph_zero_based":81},{"literal_text_all_w_t_and_m_t":"If the network is implemented according to this CR while the UE is not, there might be misaligment between the UE behavior and the network’s expectation in dealing of the broadcast assistance data when the field is absent in the posSIB.","paragraph_zero_based":82},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":83},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":84},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":85},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":86},{"literal_text_all_w_t_and_m_t":"Need OP means that the UE behavior when the field is absent should be specified, while within the current spec, there is no such description, which might lead to errornous/unpredictable UE behavior","paragraph_zero_based":87},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":88},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":89},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":90},{"literal_text_all_w_t_and_m_t":"7.4.2","paragraph_zero_based":91},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":92},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":93},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":94},{"literal_text_all_w_t_and_m_t":"Y","paragraph_zero_based":95}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"0e6c32bda25412abb0b58d77181616769d56eae3160cba0d5632b349b9bf7fd4","original_member_sha256":"d85cab2cb82621072a7cb69f1bacdd57619bf18e8ecc115ef77254675e737d67","paragraph_ElementTree_utf8_XML_sha256":["7423559940944ed0cc1fe176b76253cf9035dcdbfc0fac2f3e385feb311a2329","288cc60197c635a28716a1c3a9133085106b36b1009fb0a2849670c1b99dfd9f","9f03bab8d27961220057b150d026d0d810bd986d827bcedbe485a9a52b125107","cf0e1de944740d5f7529c43f83d570cce771dc30e6bdd254a05ed6fab819cb6e","be68b3255e1b0503b320d75dffccf407f60d6c379eb2ae9420bb8e3c9762b1ed","88141b64683316cd2aa831342753bf609a19fb112dc9c1bb4b1c001417acf4dd","e433c5ec607e99f6376207a69c30ec62c94397918fbec24707a0d3a7f81af811","cbcd5f490f4d25918587585a1f9276c49e84894b853387afeb3657a617d19108","0c7cc88acf2ebcbb790f3890350dfd09d26d0b4e8327efb65765ea5d0f854b36","bbe2697b9e482a2cbfe9bb5bf2d027f597ad13dd3c46e14d671a465728a894de","77a3a7ca094bcad7f8b8277a3cdd6bc23323f4fbd25bed8de65a81c96dbc5c7d","c6f3c5973ced2464b5b8b127d654f80b4f23cf74ad4d7f03848439af4638c9e3","23da18bbbcbc650fad7a07ef8006251a7a06ae59113986d1a2b8d37f6d71a8d1","85f9fe225bf206da5b28016fbb39c62cb1368eb1244f4f20547ea6629294dc69","378adf0aa423995360841de5b3ff121413a3320bd55a44c2044b1a4823324310","d9e9dc5ba4eb56873923514b266fd1d17c6fce4a9bcbdbd5ad93ff83a52b228c","d3098623b4dfc23a1a4b383cc6c305d01a4c1c56