nt_XML_sha256":"23ac61d78ba08dd9826b46899b903769cf46c3a8173197cf89dc0ba4e982a48a","original_member_sha256":"43c19dc78a1b4c8a0c750f94a0794aa2b2e6ff318d5500d0d31364d80b47828b","paragraph_ElementTree_utf8_XML_sha256":["296eef63aac1ee5edab54ca5ba84a33a64032e932f4ae4ef1f52a18c462560c0","4328dbc2e9ed59984edad9da9f918a037222a8bc1d4a7f801e449d0bf4e71fd0","1b57abbb250ccf0e7dbcfaad8666dd22e39df29408dc1d6e61b3298df1a31533","dca27312d7a1517d19ed558671871fab25e9b549c607883b97a78f9f3628f08a","6d3fba1314de1001e3753ed4f16b9c74cdf0271805f61b17dcc5b42bd590842f","617785343afc34ff86d7085e070e5171c849cf65b766df069d11ae4921b43535","00cdf1658dfce82585fa71a121d976d39d6f93c5bd16a9917425db98d7e1326c","cb9646e53a961acadd8b9d1cbe9977f71385aded0c0dd84e225defb7e8545ad8","e434e65a10e838afc9f35a37c5efebc215fd9aedc21692d7cc12941674744e85","48f27d1f338f2e6cabf1ff384625f9d1a5e67ab8190bf0af224f5e9fd5a2044d","6462efaa783f142c9ac35e8abef0c2b1c84e24fa6e025746e17c506d00767ec1","731cd85286f824ffc8ab15b3e076faaf16231b040ec58d5b982eb0b04411f518","a4582cbb2548d2fce6d868d2e764b35f4fe50b7691f41b3c23016ca85e2c6866","15446e336e26f8e8542354aaa67cefc1b9b0d8b4af76558f1b7e96594ab3e72b","032e9f858d3d59ab048f1c6847f25e5b233bb6ba0c88c96eee40690f328745ca","1ac810a1cab11c95a1df934fbe11d17d0c7b90f828c877e62a98a07ed58b7dfa","c8a10eb6a00bf10b95aca6d2bbeeea83e0583c2f3368a6d6deec47385712a706","b3f8ba76ec829a0eac6003bc8cbccaed17d41a62756dd1214cc8a7fa8c87c76d","ebb18e058d1fac3e0efc9941e530e6c9327f91af82e47a50969e70a111afea2a","b19a453f4d9273c368639737c3434c5fec89bd5360bc4088b56ff76468deb7c5","dcb00a9e6c6c316c0088d2dc5f1b8ad2617b4424352762cd9029642ce44b55be","adf91afec1ef44a2388772bd7103ea6e4f36004e933a3b58dc00af5209fde022","500ae1e95311986e752b9be027e0c22a78d267c2f0de2c686523828721158b14","1cef444d894cdacbe559bb45e53c3b2ef7f77da82c45f0f24d784d4541645307"],"paragraph_range_zero_based":[24,47],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"sou