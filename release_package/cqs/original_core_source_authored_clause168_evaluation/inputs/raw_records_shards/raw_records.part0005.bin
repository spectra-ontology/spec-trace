{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":50832},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":50833},{"literal_text_all_w_t_and_m_t":"7Variables and constants","paragraph_zero_based":50834},{"literal_text_all_w_t_and_m_t":"7.1Timers","paragraph_zero_based":50835},{"literal_text_all_w_t_and_m_t":"7.1.1Timers (Informative)","paragraph_zero_based":50836},{"literal_text_all_w_t_and_m_t":"Timer","paragraph_zero_based":50837},{"literal_text_all_w_t_and_m_t":"Start","paragraph_zero_based":50838},{"literal_text_all_w_t_and_m_t":"Stop","paragraph_zero_based":50839},{"literal_text_all_w_t_and_m_t":"At expiry","paragraph_zero_based":50840},{"literal_text_all_w_t_and_m_t":"T300","paragraph_zero_based":50841},{"literal_text_all_w_t_and_m_t":"Upon transmission of RRCSetupRequest.","paragraph_zero_based":50842},{"literal_text_all_w_t_and_m_t":"Upon reception of RRCSetup or RRCReject message, cell re-selection, relay reselection, and upon abortion of connection establishment by upper layers.","paragraph_zero_based":50843},{"literal_text_all_w_t_and_m_t":"Perform the actions as specified in 5.3.3.7. ","paragraph_zero_based":50844},{"literal_text_all_w_t_and_m_t":"T301","paragraph_zero_based":50845},{"literal_text_all_w_t_and_m_t":"Upon transmission of RRCReestabilshmentRequest","paragraph_zero_based":50846},{"literal_text_all_w_t_and_m_t":"Upon reception of RRCReestablishment or RRCSetup message as well as when the selected cell becomes unsuitable or the (re)selected L2 U2N Relay UE becomes unsuitable, upon reception of NotificationMessageSidelink indicating relayUE-HO or relayUE-CellReselection.","paragraph_zero_based":50847},{"literal_text_all_w_t_and_m_t":"Go to RRC_IDLE","paragraph_zero_based":50848},{"literal_text_all_w_t_and_m_t":"T302","paragraph_zero_based":50849},{"literal_text_all_w_t_and_m_t":"Upon reception of RRCReject while performing RRC connection establishment or resume, upon reception of RRCRelease with waitTime.","paragraph_zero_based":50850},{"literal_text_all_w_t_and_m_t":"Upon entering RRC_CONNECTED or RRC_IDLE, upon cell re-selection, upon cell change due to relay (re)selection, and upon reception of RRCReject message.","paragraph_zero_based":50851},{"literal_text_all_w_t_and_m_t":"Inform upper layers about barring alleviation as specified in 5.3.14.4","paragraph_zero_based":50852},{"literal_text_all_w_t_and_m_t":"T304","paragraph_zero_based":50853},{"literal_text_all_w_t_and_m_t":"Upon reception of RRCReconfiguration message including reconfigurationWithSync for the MCG which does not include sl-PathSwitchConfig, or upon reception of RRCReconfiguration message including reconfigurationWithSync for the SCG not indicated as deactivated in the NR or E-UTRA message containing the RRCReconfiguration message or upon conditional reconfiguration execution i.e. when applying a stored RRCReconfiguration message including reconfigurationWithSync.","paragraph_zero_based":50854},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":50855}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["a81350d37206388ddf5ab8cf0e456b76d0d008ffe864eb98fdbbf5ac7643cc21","c810d95c05f644fe17303e7ba0d11ba4f3fadb5a20a9e387399e5920efa12467","472ffccafecda1703d9159306b47c4a9008e1bf44e1f5d3467b5af88eac2305d","050232bc4f2f2a2f961a7b02570234b566553ebfd96651301f985a262fcd8808","10c29bd17bcc6291d7eee3a9d7dadf528314756446e213c5525497d189bb47d5","6b1d34c2d866cdcd2d90766d7472255bc1a0e16373d37c6d6aa7615f2703b664","db6922af59b43dbff64118c87251afb56910cbf1ee5793d08409c88da8fef6d6","0b2767e1b3eb7f7ee8e68b493672f1bc9d3afb9fcfaa83cbca8eafe090370f66","51186486760ad26c7b4fedf3c18a80678540cb01878f990f7c1535dbf14c22c8","a536afb9a784fd359d21df76ad8eb46b0316e22a7754dab31d4fc1fcd6b970fe","7ef6419cb401cd5f90e47f9c081d072c4f14ab28bd98b1953c94c68cd972deac","caf969260cfc0b95fabac58d6c203416d9fadc830e47c471f3faa4fbe5820475","6a8f45116fb7c8ef44522c366c527336d0b4cee4fe53eeedd80d8999e99d2406","f36a67c3806181a6d83f4bc1f1977a4b86e8f25625afdf627e78f5b24cf2b299","42a6e457e143a82d5c467a72b64b246190cde7a8aa4b1e7a6bef31b8e1be9dc9","162f291b2ba72dea15f4b4083fbeb790dca281eec9bc460ef98f46bec9ff8e2d","3867b2799db664b9f30052b84a54ed8cd2c37d3c68ff1a053f3342a1fd0c5c19","f601f29e234ed14c7e925c102295bc2c6af5d6ce3f89bf8a40ac4cd4f93ac168","7c2c6da67eef4845eaa863dc754db29bf6e85ee5a0b3bf7dcacfc6075c03d2b5","da5c70997c9c39f91249b140bc1210faa4c8ccd1bf88d1bf22a07028d5357df1","b2ef063d9eaa4fa54f7ee0ffed6ef15231eec8554d17dffc3f41886e09d5edfa","e4237b5f5e618df27f80fb8fe682a3123feff5c629de81da205fa8093aaf2337","f6d3620f650eac1a23eae4fafe5b01f8cd54d6dfb9d8bd5aa00dd3d36c132e89","e877e9818fb8c85e4f6ef510fbdd64abff0586dc9a0ebe7d5903250ce61f16c8"],"paragraph_range_zero_based":[50832,50855],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p50832"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Also, for the MCG and SCG upon an indication from lower layer that an LTM cell switch procedure is triggered and, for the MCG, upon performing an LTM cell switch procedure following cell selection performed while timer T311 is running.","paragraph_zero_based":50856},{"literal_text_all_w_t_and_m_t":"Upon successful completion of random access on the corresponding SpCell.","paragraph_zero_based":50857},{"literal_text_all_w_t_and_m_t":"Upon receiving an indication from lower layers of successful completion of Rach-less handover, or upon receiving an indication from lower layers of successful completion of an LTM RACH-less cell switch.","paragraph_zero_based":50858},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":50859},{"literal_text_all_w_t_and_m_t":"For T304 of SCG, upon SCG release.","paragraph_zero_based":50860},{"literal_text_all_w_t_and_m_t":"For T304 of MCG, in case of the handover from NR or intra-NR handover, or path switch from a L2 U2N Relay UE to a NR cell, or an LTM cell switch procedure, initiate the RRC re-establishment procedure; In case of handover to NR, perform the actions defined in the specifications applicable for the source RAT. If any DAPS bearer is configured and if there is no RLF in source PCell, initiate the failure information procedure.","paragraph_zero_based":50861},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":50862},{"literal_text_all_w_t_and_m_t":"For T304 of SCG, inform network about the reconfiguration with sync failure by initiating the SCG failure information procedure as specified in 5.7.3.","paragraph_zero_based":50863},{"literal_text_all_w_t_and_m_t":"T310","paragraph_zero_based":50864},{"literal_text_all_w_t_and_m_t":"Upon detecting physical layer problems for the SpCell i.e. upon receiving N310 consecutive out-of-sync indications from lower layers.","paragraph_zero_based":50865},{"literal_text_all_w_t_and_m_t":"Upon receiving N311 consecutive in-sync indications from lower layers for the SpCell, upon receiving RRCReconfiguration with reconfigurationWithSync for that cell group, upon reception of MobilityFromNRCommand, upon the reconfiguration of rlf-TimersAndConstant, upon initiating the connection re-establishment procedure, upon conditional reconfiguration execution i.e. when applying a stored RRCReconfiguration message including reconfigurationWithSync for that cell group, and upon initiating the MCG failure information procedure.","paragraph_zero_based":50866},{"literal_text_all_w_t_and_m_t":"Upon SCG release, if the T310 is kept in SCG.","paragraph_zero_based":50867},{"literal_text_all_w_t_and_m_t":"If the T310 is kept in MCG: If AS security is not activated: go to RRC_IDLE else: initiate the MCG failure information procedure as specified in 5.7.3b or the connection re-establishment procedure as specified in 5.3.7 or the procedure as specified in 5.3.10.3 if any DAPS bearer is configured.","paragraph_zero_based":50868},{"literal_text_all_w_t_and_m_t":"If the T310 is kept in SCG, Inform E-UTRAN/NR about the SCG radio link failure by initiating the SCG failure information procedure as specified in 5.7.3.","paragraph_zero_based":50869},{"literal_text_all_w_t_and_m_t":"T311","paragraph_zero_based":50870},{"literal_text_all_w_t_and_m_t":"Upon initiating the RRC connection re-establishment procedure","paragraph_zero_based":50871},{"literal_text_all_w_t_and_m_t":"Upon selection of a suitable NR cell, or upon selection of a suitable L2 U2N Relay UE, or a cell using another RAT.","paragraph_zero_based":50872},{"literal_text_all_w_t_and_m_t":"Enter RRC_IDLE","paragraph_zero_based":50873},{"literal_text_all_w_t_and_m_t":"T312","paragraph_zero_based":50874},{"literal_text_all_w_t_and_m_t":"If T312 is configured in MCG: Upon triggering a measurement report for a measurement identity for which T312 has been configured and useT312 has been set to true, while T310 in PCell is running.","paragraph_zero_based":50875},{"literal_text_all_w_t_and_m_t":"If T312 is configured in SCG and useT312 has been set to true: Upon triggering a measurement report for a measurement identity for which T312 has been configured, while T310 in PSCell is running.","paragraph_zero_based":50876},{"literal_text_all_w_t_and_m_t":"Upon receiving N311 consecutive in-sync indications from lower layers for the SpCell, receiving RRCReconfiguration with reconfigurationWithSync for that cell group, upon reception of MobilityFromNRCommand, upon initiating the connection re-establishment procedure, upon the reconfiguration of rlf-TimersAndConstant, upon initiating the MCG failure information procedure, upon conditional reconfiguration execution i.e. when applying a stored RRCReconfiguration message including reconfigurationWithSync for that cell group, and upon the expiry of T310 in corresponding SpCell.","paragraph_zero_based":50877},{"literal_text_all_w_t_and_m_t":"Upon SCG release, if the T312 is kept in SCG","paragraph_zero_based":50878},{"literal_text_all_w_t_and_m_t":"If the T312 is kept in MCG initiate the MCG failure information procedure as specified in 5.7.3b or the connection re-establishment procedure.","paragraph_zero_based":50879}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["6c2d6e4f60bd6a1a949aafc979a30d51357518b88c5e60f1956b761e768ae1e5","f8e458e811e0277d76d9d6f55155146be6215e67cef3a078dd9832464fe81d46","9f27cc4ab7705d6706b31bf29060839f593f02d61f19e3edb8b1319261eafe5b","e8112be564f841fe47ac2fd5314d0e7610609c5f03fa299389420e655488d938","281c22a36bcc12d375b2d902ce88838088c51c1a4fd0aceb6b6c7fccf3e30a36","628260a126fd1c08f1c60f52309834e4fc5064df8b61e41735010ed2e6652b9f","b609a0891b1c60d0a684ead48548bae6fcff797e001028fd1b7828028e743c0b","ed709859621a3f2213eb43e92c293476e52c5f47da8bc2db7e7f2b804a00d4db","b41b0f0fe801d0bc82547db1981e4f949b5cb93494f326cd97eaafb72037d8bf","5815de7cc665afd6a972c20abc9dd2a312f03cdc20abbe7cec2832523ab0c9c0","f6e62c52947aefd8647151009db17ea624fd52cbb804a08e09b7e48ff0060a19","0e3afa49fa3d0b2603722d62ed2005da2a25cdd580fd3e9f2479088f519ad092","878402c518054781b49aa030ba72ecf79b3961ba92df64130255423153ac435a","07601b575c86178b699d24c67ce0e8aaf9864b52bf667dd374368e3f9d717390","5172f2046520f0531127111887cf12af9041705a4fa5e8e784cc64eabe74cd44","8bd071943f03d29f522b6abd37313e1ea7a0eceb821197ebfb50390b786cd054","874535f7e5f90d67c06669735125465746d6f8a1c82b446312985b2f2dfc8d59","b4800f229e07378166eea622010bf2dc87a5d5a42837b650cf297c9215a94922","be6725cfa7bd91a85ac77b2d2907051956b00e38fdbe076e246164537f7c60f0","564e7185b9e4167811f1856b05087d1a796d00acc1c7f87757a8d514c5b73f2c","0822e9ea1d1e27f853f739773917e4eb9073ab73b42defe139dc4dcc62ab4063","af1441008c1dd29daadc61861173cb96cbe285bc19c1a9219d05ed7e84bff854","04d71a87348859198222bb57c3a65267dba783fa63b0c3ee5d96902b75b1ce7d","94aecd021974d344d31bcbe8bdd789dc79f8bed35d20e5d7670e607f1f358520"],"paragraph_range_zero_based":[50856,50879],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p50856"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"If the T312 is kept in SCG, Inform E-UTRAN/NR about the SCG radio link failure by initiating the SCG failure information procedure.as specified in 5.7.3.","paragraph_zero_based":50880},{"literal_text_all_w_t_and_m_t":"T316","paragraph_zero_based":50881},{"literal_text_all_w_t_and_m_t":"Upon transmission of the MCGFailureInformation message","paragraph_zero_based":50882},{"literal_text_all_w_t_and_m_t":"Upon receiving RRCRelease,  RRCReconfiguration with reconfigurationwithSync for the PCell, MobilityFromNRCommand, or upon initiating the re-establishment procedure","paragraph_zero_based":50883},{"literal_text_all_w_t_and_m_t":"Perform the actions as specified in 5.7.3b.5.","paragraph_zero_based":50884},{"literal_text_all_w_t_and_m_t":"T319","paragraph_zero_based":50885},{"literal_text_all_w_t_and_m_t":"Upon transmission of RRCResumeRequest or RRCResumeRequest1 when the resume procedure is not initiated for SDT.","paragraph_zero_based":50886},{"literal_text_all_w_t_and_m_t":"Upon reception of RRCResume, RRCSetup, RRCRelease, RRCRelease with suspendConfig or RRCReject message, upon cell re-selection or upon relay (re)selection.","paragraph_zero_based":50887},{"literal_text_all_w_t_and_m_t":"Perform the actions as specified in 5.3.13.5.","paragraph_zero_based":50888},{"literal_text_all_w_t_and_m_t":"T319a","paragraph_zero_based":50889},{"literal_text_all_w_t_and_m_t":"Upon transmission of RRCResumeRequest or RRCResumeRequest1 when the resume procedure is initiated for SDT.","paragraph_zero_based":50890},{"literal_text_all_w_t_and_m_t":"Upon reception of RRCResume, RRCSetup, RRCRelease, RRCReject message or upon failure to resume RRC connection for SDT as specified in 5.3.13.5 or upon cell reselection.","paragraph_zero_based":50891},{"literal_text_all_w_t_and_m_t":"Perform the actions as specified in 5.3.13.5.","paragraph_zero_based":50892},{"literal_text_all_w_t_and_m_t":"T320","paragraph_zero_based":50893},{"literal_text_all_w_t_and_m_t":"Upon reception of t320 or upon cell (re)selection to NR from another RAT with validity time configured for dedicated priorities (in which case the remaining validity time is applied).","paragraph_zero_based":50894},{"literal_text_all_w_t_and_m_t":"Upon entering RRC_CONNECTED, upon reception of RRCRelease, when PLMN selection or SNPN selection is performed on request by NAS, when the UE enters RRC_IDLE from RRC_INACTIVE, or upon cell (re)selection to another RAT (in which case the timer is carried on to the other RAT).","paragraph_zero_based":50895},{"literal_text_all_w_t_and_m_t":"Discard the cell reselection priority information provided by dedicated signalling.","paragraph_zero_based":50896},{"literal_text_all_w_t_and_m_t":"T321","paragraph_zero_based":50897},{"literal_text_all_w_t_and_m_t":"Upon receiving measConfig including a reportConfig with the reportType set to reportCGI","paragraph_zero_based":50898},{"literal_text_all_w_t_and_m_t":"Upon acquiring the information needed to set all fields of cgi-info, upon receiving measConfig that includes removal of the reportConfig with the reportType set to reportCGI and upon detecting that a cell is not broadcasting SIB1.","paragraph_zero_based":50899},{"literal_text_all_w_t_and_m_t":"Initiate the measurement reporting procedure, stop performing the related measurements.","paragraph_zero_based":50900},{"literal_text_all_w_t_and_m_t":"T322","paragraph_zero_based":50901},{"literal_text_all_w_t_and_m_t":"Upon receiving measConfig including reportConfigNR with the reportType set to reportSFTD and drx-SFTD-NeighMeas is set to true.","paragraph_zero_based":50902},{"literal_text_all_w_t_and_m_t":"Upon acquiring the SFTD measurement results, upon receiving measConfig that includes removal of the reportConfig with the reportType set to reportSFTD.","paragraph_zero_based":50903}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["68125be122b4ff8b35a4e2141945a9d607d1058ed8883af3b74bf9cbad488dfd","71cf5e6276d70c0f5449055a69de236b5b50670882e83d4adb633cbc285d1d1e","a24a302416830f3052173c5adda0f9441cb35e54abce0ecf921137fa2fb3b107","8fe7496c9b982d69e2fbcecf5b0924bb9078df7dab10d353fa76d919fd7fdef5","a0d162948dcdabc4d60ac35ca5477f1f6d4249cfd52f663e3f2322f9dc653583","d11e3539f5b16617373e560d7f054b0d14a31ff9cd6530f3820a2e130d45407a","cf9ef6c8b8b7ee7ce11d33b281d740981c46b133a6e9299eb5a4dec09c653285","0e7cdc8e1412354950de39e35400a8d39835ea233bfaea620164859c5afb655b","2274cd32c75fc9958eb4c5cbe009d7f0430c20b71f19799608ae3ebc68837915","0a650bfcbc71899ba52f87c61f05eca600eb9cc301820d8f44cf83266adf2f18","95e4c50c5396023a2678b902a386800bebd56fe54686f42de48627adba00942a","60abbbb5396eaef3b93e62d16247fc11cac3c250e8194052611309df0723811f","16c5034c098a564d1d21146d53f890d0776cf77f4bb89374c565c1392e81caeb","39723901c0bd693758e406a1a8238371231b3e6dc13d903b9621caac5a64fb9d","0a004d107d1f2e9d3a6ea2254bab0da0f817aa60e58df868715baabe528b943e","cacb87a47ec80aeb147186cbee1c0cf3aca60ea296480705ecf6a71619c8a897","dd8dc2cb3d97ae3e1bb0924b3df8499a9e9bfe33f546e2289ee199c3e0ef521e","2655f26066cce6c556d97487c3da31d59ee22464e112a8b2f4a84d17d5d01f00","55f5e84bac26feee775f2017565989eaab6ab9cac956f7dbad6cd57dd6adc8df","0312145724615d0f0753e02bdaa207c12d49d24cc7f96b69f30ad9327ffca56d","07c71f318b097ec84b2b57f3dee7e6722016ac252e31d4ddef9ceb110ab14730","827661ae3139c46fe234ed4f8531efb9f2adefd591a84152404e11a171ffd4f9","f31a7f984a0419a61de8bb4277fe0ae96f302b1a7dadfff2ed02289da1184609","dea98c4728043947a501fc6859f15b234105b015236844736468c16c76ac6c14"],"paragraph_r