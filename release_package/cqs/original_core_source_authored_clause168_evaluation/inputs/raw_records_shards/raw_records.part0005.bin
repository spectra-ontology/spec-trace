{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48600},{"literal_text_all_w_t_and_m_t":"–SL-SourceIdentity","paragraph_zero_based":48601},{"literal_text_all_w_t_and_m_t":"The IE SL-SourceIdentity is used to identify a source of a NR sidelink communication.","paragraph_zero_based":48602},{"literal_text_all_w_t_and_m_t":"SL-SourceIdentity information element","paragraph_zero_based":48603},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":48604},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SOURCEIDENTITY-START","paragraph_zero_based":48605},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48606},{"literal_text_all_w_t_and_m_t":"SL-SourceIdentity-r17 ::=   BIT STRING (SIZE (24))","paragraph_zero_based":48607},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48608},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SOURCEIDENTITY-STOP","paragraph_zero_based":48609},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":48610},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48611},{"literal_text_all_w_t_and_m_t":"–SL-SRAP-Config","paragraph_zero_based":48612},{"literal_text_all_w_t_and_m_t":"The IE SL-SRAP-Config is used to set the configurable SRAP parameters used by L2 U2N Relay UE and L2 U2N Remote UE as specified in TS 38.351 [66].","paragraph_zero_based":48613},{"literal_text_all_w_t_and_m_t":"SL-SRAP-Config information element","paragraph_zero_based":48614},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":48615},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SRAP-CONFIG-START","paragraph_zero_based":48616},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48617},{"literal_text_all_w_t_and_m_t":"SL-SRAP-Config-r17 ::=                  SEQUENCE {","paragraph_zero_based":48618},{"literal_text_all_w_t_and_m_t":" 