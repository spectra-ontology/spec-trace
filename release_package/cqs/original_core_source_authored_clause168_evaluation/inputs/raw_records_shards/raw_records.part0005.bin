{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        rohc                                 SEQUENCE {","paragraph_zero_based":49104},{"literal_text_all_w_t_and_m_t":"            maxCID-r17                           INTEGER (1..16)               DEFAULT 15,","paragraph_zero_based":49105},{"literal_text_all_w_t_and_m_t":"            profiles-r17                         SEQUENCE {","paragraph_zero_based":49106},{"literal_text_all_w_t_and_m_t":"                profile0x0000-r17                    BOOLEAN,","paragraph_zero_based":49107},{"literal_text_all_w_t_and_m_t":"                profile0x0001-r17                    BOOLEAN,","paragraph_zero_based":49108},{"literal_text_all_w_t_and_m_t":"                profile0x0002-r17                    BOOLEAN","paragraph_zero_based":49109},{"literal_text_all_w_t_and_m_t":"           }","paragraph_zero_based":49110},{"literal_text_all_w_t_and_m_t":"        }","paragraph_zero_based":49111},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":49112},{"literal_text_all_w_t_and_m_t":"    t-Reordering-r17                     ENUMERATED {ms1, ms10, ms40, ms160, ms500, ms1000, ms1250, ms2750}    OPTIONAL -- Need S","paragraph_zero_based":49113},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":49114},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49115},{"literal_text_all_w_t_and_m_t":"MRB-RLC-ConfigBroadcast-r17 ::=      SEQUENCE {","paragraph_zero_based":49116},{"literal_text_all_w_t_and_m_t":"    logicalChannelIdentity-r17           LogicalChannelIdentity,","paragraph_zero_based":49117},{"literal_text_all_w_t_and_m_t":"    sn-FieldLength-r17                   ENUMERATED {size6}                       OPTIONAL, -- Need S","paragraph_zero_based":49118},{"literal_text_all_w_t_and_m_t":"    t-Reassembly-r17                     T-Reassembly                             OPTIONAL  -- Need S","paragraph_zero_based":49119},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":49120},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49121},{"literal_text_all_w_t_and_m_t":"-- TAG-MBS-SESSIONINFOLIST-STOP","paragraph_zero_based":49122},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":49123},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49124},{"literal_text_all_w_t_and_m_t":"MBS-SessionInfoList field descriptions","paragraph_zero_based":49125},{"literal_text_all_w_t_and_m_t":"g-RNTI","paragraph_zero_based":49126},{"literal_text_all_w_t_and_m_t":"G-RNTI used to scramble the scheduling and transmission of MTCH.","paragraph_zero_based":49127}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["fcfe19e11bd051170dab4681d6831159fc4e4156f17cb7202473beca0a763f96","9b00734b4ccfe641f12d40cb2be63b65caa12b6711015261c46d9f3991498405","41d3b12459af010415c9cf698e95f56287fc2136832ae68f27716251c34cb978","8ced0aba96ee4aa55618a760b6e31f8ef8212b9afa8d678db092b263c7461df5","06d837b3653044132aee771c3857bd4f19ff6bf9250abe993957c5533427a5e8","fdbbdc74c334a6c0f39d9ed1e0575f8d27af477acb8820739f715a82e1879d8d","9e3742ff92146fa86b6210f08e17bf2720d80f400946149f470074cfe30810e5","181d0013d7d8ba2c77dc4e89dad7980022e2667bfeeb4808ad118b05d77baafe","5d77802de802ed03a8b9e121fb35e6d6111fc28766df321f04ce81243b8bb43f","dc45d5e305b11530f200b2aea00d907b22e605f1f95584a2e445132f386326c5","30595147630831a4c7c54689c80d394f6f7df4ea0213d185925e5b92c724a49d","9992b9d957bb6b2bc1c73647f59cd94719a64bd81edc24637635363d2904ba0f","47651e9090adc166b208f68cf8583e8030db7e89d4dbef44797f2714facd0ee1","d1b3ce35994eede98359ef7e7dfb94d918ee3d630b8743cc49d9bd696cad52b0","b28c6bbb3965aff9877b0252ce1aad7802c1a899fb0cb0843f2ad0edb15024d8","0828a265cbfe9462b8bed2b3144c541cf687379ff905b1af3a3c5da533c76cad","51cfb1488d1973bacaec4f3be19441c1bfa986d41fe1d9794b65c137e9cc214e","f819bf900d11c767eb721bdd72ff7330de138dbe09a4505abd90a358b4f4afba","f60df84582b0ad112e2043caa47a8216238b17e9aa60f764fe3529a29ff29d44","be2dea8acf886f8b94949c215d9722a8b4960adfc18bcdc2d9a6b3edf06b40e5","16140469b25247a4696d389bbc635bc985b9bf1018046d85051b87ce94e97379","a2325e35346e5f2524be3dd7c01d4c51bedbab0bea2f8dc3d7a7c605c1a36a70","0aab9b07ec7e44e73bb11d88f8dbc9323c3a14bf093809b408d2106080840e32","f6a90d705e8b3728811b1126f7600ae052d7fc0004997050de323f0d06817220"],"paragraph_range_zero_based":[49104,49127],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p49104"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"headerCompression","paragraph_zero_based":49128},{"literal_text_all_w_t_and_m_t":"If rohc is configured, the UE shall apply the configured ROHC profile(s) in downlink.","paragraph_zero_based":49129},{"literal_text_all_w_t_and_m_t":"mbs-SessionId","paragraph_zero_based":49130},{"literal_text_all_w_t_and_m_t":"Indicates an identifier of the MBS session provided by the MTCH.","paragraph_zero_based":49131},{"literal_text_all_w_t_and_m_t":"mrb-listBroadcast","paragraph_zero_based":49132},{"literal_text_all_w_t_and_m_t":"A list of broadcast MRBs to which the associated broadcast MBS session is mapped to.","paragraph_zero_based":49133},{"literal_text_all_w_t_and_m_t":"mtch-neighbourCell","paragraph_zero_based":49134},{"literal_text_all_w_t_and_m_t":"Indicates neighbour cells which provide this service on MTCH. The first bit is set to 1 if the service is provided on MTCH in the first cell in mbs-NeighbourCellList, otherwise it is set to 0. The second bit is set to 1 if the service is provided on MTCH in the second cell in mbs-NeighbourCellList, and so on. If the service is not available in any neighbouring cell and mbs-NeighbourCellList is signalled, the network sets all bits in this field to 0. The field is absent when mbs-NeighbourCellList is absent or an empty mbs-NeighbourCellList is signalled. If this field is absent when mbs-NeighbourCellList is absent or a non-empty mbs-NeighbourCellList is signalled, the related service may or may not be available in any neighbouring cell, i.e. the UE cannot determine the presence or absence of an MBS service in neighbouring cells based on the absence of this field. If this field is absent and an empty mbs-NeighbourCellList is signalled, then the UE shall assume that MBS broadcast services signalled in mbs-SessionInfoList in the MBSBroadcastConfiguration message are not provided in any neighbour cell.","paragraph_zero_based":49135},{"literal_text_all_w_t_and_m_t":"mtch-schedulingInfo","paragraph_zero_based":49136},{"literal_text_all_w_t_and_m_t":"Indicates the index of DRX configuration entry in drx-ConfigPTM-List that is used for scheduling the MTCH. The value 0 corresponds to the first entry in drx-ConfigPTM-List, the value 1 corresponds to the second entry in drx-ConfigPTM-List and so on. In case mtch-schedulingInfo is absent for a G-RNTI (i.e. no PTM DRX), the UE shall monitor for PDCCH scrambled with G-RNTI in any slot according to the search space configured for MTCH [see TS 38.213 [13], clause 10.1].","paragraph_zero_based":49137},{"literal_text_all_w_t_and_m_t":"mtch-SSB-MappingWindowIndex","paragraph_zero_based":49138},{"literal_text_all_w_t_and_m_t":"Indicates the index of MTCH-SSB-MappingWindowCycleOffset configuration entry in MTCH-SSB-MappingWindowList. The value 0 corresponds to the first entry in MTCH-SSB-MappingWindowList, the value 1 corresponds to the second entry in MTCH-SSB-MappingWindowList and so on. This field is set to the same value for all MBS sessions mapped to the same G-RNTI.","paragraph_zero_based":49139},{"literal_text_all_w_t_and_m_t":"pdcp-SN-SizeDL","paragraph_zero_based":49140},{"literal_text_all_w_t_and_m_t":"Indicates that PDCP sequence number size of 12 bits is used, as specified in TS 38.323 [5]. When the field is absent the UE applies the value as specified in 9.1.1.7.","paragraph_zero_based":49141},{"literal_text_all_w_t_and_m_t":"pdschConfigIndex","paragraph_zero_based":49142},{"literal_text_all_w_t_and_m_t":"Indicates the index of PDSCH configuration entry in pdschConfigList for MTCH. Value 0 corresponds to the first entry in pdschConfigList, the value 1 corresponds to the second entry in pdschConfigList and so on. When the field is absent the UE applies the first entry in pdschConfigList for MTCH.","paragraph_zero_based":49143},{"literal_text_all_w_t_and_m_t":"sn-FieldLength","paragraph_zero_based":49144},{"literal_text_all_w_t_and_m_t":"Indicates that the RLC SN field size of 6 bits is used, see TS 38.322 [4]. When the field is absent the UE applies the value as specified in 9.1.1.7.","paragraph_zero_based":49145},{"literal_text_all_w_t_and_m_t":"t-Reassembly","paragraph_zero_based":49146},{"literal_text_all_w_t_and_m_t":"Timer for reassembly in TS 38.322 [4], in milliseconds. Value ms0 means 0 ms, value ms5 means 5 ms and so on. When the field is absent the UE applies the value in specified in 9.1.1.7.","paragraph_zero_based":49147},{"literal_text_all_w_t_and_m_t":"t-Reordering","paragraph_zero_based":49148},{"literal_text_all_w_t_and_m_t":"Value in ms of t-Reordering specified in TS 38.323 [5]. Value ms1 corresponds to 1 ms, value ms10 corresponds to 10 ms, and so on.  When the field is absent the UE applies the value as specified in 9.1.1.7.","paragraph_zero_based":49149},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49150},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":49151}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["6acc1d7b5544a50e7c12c4d6d50654947ae2b8a2a4bd1d29dc02bac5bc44b04f","1b41ecda64b740814e096e20c4807d31a8778c856d1847e43a3dee5584e5fc15","4871a9fa01fe374d8f32a337e3aaf353fe8665d1916d70da9bc4e3a7fd9310db","b98a4efa313da155abf7f28111b135e5ed8c0d6aef0db6beca34f93dcf2ea0f7","a32949e3f8dc4fd72def2a806f9f1b511118a4769face9d8b618f92c889334bf","0c1560afb62fa9820a7961d2799b2ceb6023ffc33e79054e7bb19c809441043b","e043fe50ffbc2de9f5ebb1a480454d2271b593499da2357fb2e3e6141fccb92a","2bad6ed00531ab144cf842753fadbe38ac80f25eca6a2c1b633b0b2070a54fbb","ac91b290aea