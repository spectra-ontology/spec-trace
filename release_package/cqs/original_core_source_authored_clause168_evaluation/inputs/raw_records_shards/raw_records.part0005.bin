ms61440, ms81920, ms368640, ms737280 }","paragraph_zero_based":302},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":303},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":304},{"literal_text_all_w_t_and_m_t":"SRS-PosResourceSetAggBW-CombinationList-r18 ::= SEQUENCE (SIZE(1.. maxNrOfLinkedSRS-PosResSetComb-r18)) OF SRS-PosResourceSetLinkedForAggBW-List-r18","paragraph_zero_based":305},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":306},{"literal_text_all_w_t_and_m_t":"SRS-PosResourceSetLinkedForAggBW-List-r18 ::= SEQUENCE (SIZE(2..maxNrOfLinkedSRS-PosResourceSet-r18)) OF SRS-PosResourceSetLinkedForAggBW-r18","paragraph_zero_based":307},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":308},{"literal_text_all_w_t_and_m_t":"-- TAG-RRCRECONFIGURATION-STOP","paragraph_zero_based":309},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":310},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"76462aa471fa83431d86182eefda142afacc351f546418f009f044fd915fff93","original_member_sha256":"a0378c459c9ba264d361c3cd6028808c92e1dee1a68688b75ef5a3cdc95396cf","paragraph_ElementTree_utf8_XML_sha256":["9396a96fdd5779e6498860a9d48410d3a4c65b445814cb9a515fef37ba1984fc","615b45e3403955afb17703829ee125b3c5417f933be6c1ae1d96cce1ae220994","124c891d835af8cfb9e72cba1c751fa7c54157549cedeb1ff503ce9a4ce03340","3c325588a6b3f37c42266ce043939bd55988d85a5ddd951084a1d8927ddc5442","d43c1aacf157ee65100237f4a35d2237b2462543a5ad4a92950bea9cd2f42fdc","d3e27d22ff26c2b9dbb7cfc0f20292d8377e3d0f3a8c88f64eeee56930ca2a3e","1efa95cd04033c2c07a52f4eace51b53cf9091079f7b10854f68bcdbcd2723e8","325c3ec4f59c60be0323e9997348fd3adf1bb3e09d9b0e971ba997c628c5e5f8","7cac650af29e6cc9b8bf1002230b9ade53aa3ef70272ac11de83e5e647a83edc","9a4a863a93231ed83748e22136d47523678cfd66c83324b97007657f201f65ef","cc916ac216cca33da0900b56aeb077ae9d6291418b775f0361238298f6538f5d","e7f87cf272fdab8e9a46a5af06a47355f23e332c5852e02ae528d212e0ec64d6","e55e306b8977d3bc07a5d3ac8ee7b59e9f3394dad29fcb9a80545ad62ae0128d","f97efdc803779389bd32ff818001e44e637d1b88bbfbb26960dc52ed5df622a1","50cb0466aad600dd60e9db85cfe23f7669579691650c624c2a4232370a0717d0","3a8cee1cfb443ccae52daeeb65639acfc300c974bdef56aafb56d9571d218ecd","5c3c29dd2d6ee87242800ea5ae9441d158aaa01364017f9100a82a1c3374adbd","9bad16fb98e607dfb227f99da767df87f4b18604ede69172bff40c3afd08c620","943f924b8f07390d1629f620c99cfc118e66d6c1b5f5617c114e0434518486b3","2012f47a05b8457a16ac754936f1907a4e0486f953408ac2c4b84a7c8a633cd5","07ccb620d9618dc7a2b9f478d8a0c17d04c43cf5d9f9447c207913c93f4fd047","0900452b727fd8dbc32169c6205d5f0f7db25987c9ab685a20818ee462747564","5feba9cd9f6f4af2e87101adfc64dac274d29af042d937ffe54e6646d223e630","c1e70ae9f4136cf4abb0b2236e760e65371c78712c17682b4faf9dff2c57c263"],"paragraph_range_zero_based":[288,311],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2506458.zip::R2-2506458 Correction on delivery of posSIB segments by dedicated siganling in RRC_CONNECTED.docx:p288"}
{"fields":{"filename":"R2-2506458.zip::R2-2506458 Correction on delivery of posSIB segments by dedicated siganling in RRC_CONNECTED.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":312},{"literal_text_all_w_t_and_m_t":"RRCReconfiguration-IEs field descriptions","paragraph_zero_based":313},{"literal_text_all_w_t_and_m_t":"appLayerMeasConfig","paragraph_zero_based":314},{"literal_text_all_w_t_and_m_t":"This field is used to configure application layer measurements. This field is absent when the UE is configured to operate with shared spectrum channel access or if sl-L2RemoteUE-Config-r17 is configured or not released.","paragraph_zero_based":315},{"literal_text_all_w_t_and_m_t":"bap-Config","paragraph_zero_based":316},{"literal_text_all_w_t_and_m_t":"This field is used to configure the BAP entity for IAB nodes.","paragraph_zero_based":317},{"literal_text_all_w_t_and_m_t":"bap-Address","paragraph_zero_based":318},{"literal_text_all_w_t_and_m_t":"Indicates the BAP address of an IAB-node. The BAP address of an IAB-node cannot be changed once configured for the cell group to the BAP entity.","paragraph_zero_based":319},{"literal_text_all_w_t_and_m_t":"conditionalReconfiguration","paragraph_zero_based":320},{"literal_text_all_w_t_and_m_t":"Configuration of candidate target SpCell(s) and execution condition(s) for conditional handover, conditional PSCell addition or conditional PSCell change. The field is absent if any DAPS bearer is configured, if the sl-L2RemoteUE-Config or sl-L2RelayUE-Config is configured, or if the RRCReconfiguration message is contained within condRRCReconfig. When the masterCellGroup and/or secondaryCellGroup includes ReconfigurationWithSync, if this field is present, it only includes configurations/fields specific to subsequent CPAC. The RRCReconfiguration message contained in DLInformationTransferMRDC cannot contain the field conditionalReconfiguration for conditional PSCell change or for conditional PSCell addition. The network does not include this field in an RRCReconfiguration message contained within a LTM-Config IE.","paragraph_zero_based":321},{"literal_text_all_w_t_and_m_t":"daps-SourceRelease","paragraph_zero_based":322},{"literal_text_all_w_t_and_m_t":"Indicates to UE that the source cell part of DAPS operation is to be stopped and the source cell part of DAPS configuration is to be released.","paragraph_zero_based":323},{"literal_text_all_w_t_and_m_t":"dedicatedNAS-MessageList","paragraph_zero_based":324},{"literal_text_all_w_t_and_m_t":"This field is used to transfer UE specific NAS layer information between the network and the UE. The RRC layer is transparent for each PDU in the list. ","paragraph_zero_based":325},{"literal_text_all_w_t_and_m_t":"dedicatedPagingDelivery","paragraph_zero_based":326},{"literal_text_all_w_t_and_m_t":"This field is used to transfer Paging message for the associated L2 U2N Remote UE to the L2 U2N Relay UE in RRC_CONNECTED.","paragraph_zero_based":327},{"literal_text_all_w_t_and_m_t":"dedicatedPosSysInfoDelivery","paragraph_zero_based":328},{"literal_text_all_w_t_and_m_t":"This field is used to transfer SIBPos to the UE in RRC_CONNECTED. This field may contain multiple posSIB segments of the same posSIB type. When the number of segments of posSIB of the same posSIB type exceeds the maximum number of posSIBs that this field could carry (i.e., 32), the posSIB segments of the same posSIB type could be delivered in multiple RRCReconfiguration messages.","paragraph_zero_based":329},{"literal_text_all_w_t_and_m_t":"dedicatedSIB1-Delivery","paragraph_zero_based":330},{"literal_text_all_w_t_and_m_t":"This field is used to transfer SIB1 to the UE (including L2 U2N Remote UE). The field has the same values as the corresponding configuration in servingCellConfigCommon.","paragraph_zero_based":331},{"literal_text_all_w_t_and_m_t":"dedicatedSystemInformationDelivery","paragraph_zero_based":332},{"literal_text_all_w_t_and_m_t":"This field is used to transfer SIB6, SIB7, SIB8, SIB19, SIB20, SIB21, SIB25 to the UE with an active BWP with no common search space configured or the L2 U2N Remote UE in RRC_CONNECTED. For UEs in RRC_CONNECTED (including L2 U2N Remote UE), this field is also used to transfer the SIBs requested on-demand.","paragraph_zero_based":333},{"literal_text_all_w_t_and_m_t":"defaultUL-BAP-RoutingID","paragraph_zero_based":334},{"literal_text_all_w_t_and_m_t":"This field is used for IAB-node to configure the default uplink Routing ID, which is used by IAB-node during IAB-node bootstrapping, migration, IAB-MT RRC resume and IAB-MT RRC re-establishment for F1-C and non-F1 traffic. The defaultUL-BAP-RoutingID can be (re-)configured when IAB-node IP address for F1-C related traffic changes. This field is mandatory only for IAB-node bootstrapping.","paragraph_zero_based":335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"76462aa471fa83431d86182eefda142afacc351f546418f009f044fd915fff93","original_member_sha256":"a0378c459c9ba264d361c3cd6028808c92e1dee1a68688b75ef5a3cdc95396cf","paragraph_ElementTree_utf8_XML_sha256":["447197bc64b1f91b57ccb6aeec8261734e6e58358896672af91da4fd5a3373ad","f6a72bffc4649dbe32669f32d95ddf116bee306df32e40d4276f466badac23c6","b44a2792bc9da154c517ce2fb1041350f8f71286bfa1ea1345662a9dc0f3d0a4","a4213b4f3a55f26ecc0d807964eecce741f86ce5e256b75ce0ee2a3ca51998a7","13be62f5b7df831f3dbed2c3df9a5a49efdc1dc459efe8b42747fb3d7fb2f128","060d68e812c9002555a757d952e206cd7ca2a5d973501d56514c74f0056f2d29","efe9a97b70a8bef754cc71a0ce704654527b0b02b803dea4aac96dbb4fca2e86","703bb68c0532ccdea3e7f40f4b9ee1b4811d2b8ff5982a1f78b0e75fd2707eed","52d5eb9388f8370bd55e63de27c83c9467da716a9a5fd4d74485f051050b4cd0","b49e5c880222a8bd7c5e7e42cb37a3dca0f365a33ed990f1bfb5c94e0310ff7e","b5d79ef23675e7024b3a179f20bbef2429968f88fa2c839cd6a1f0ed978b99c8","313b27cbc2b2e707fda0d5e24e1da99a7188fdcdc0af3f8ec45d912d0a0084e6","ee8fc79e488fff8640a978639b866daae76db53b27b47d4952e0553f88d8065b","7c078973ce9c9e683e11052f9277a91dc01da02b9e29e3cf25cd33c7fd96d696","e5b67eac147db1f83f9887edb743b3e969a33ec5ba62bb9f07ef719108cd8544","70605a111abbc2922c21dfdde1579a047dbdb785ab013b823a0c662cec63b8e5","831ef6794dfb920e4e411c4ead97d8416fe7741fdc55fe62ec87dd51980d7353","595496c8a251db2f0fd0cf37c8faa9d8c8da28e445f12d20510252c364024253","40a391551e2a6b1fdaf4674b0d27bd21b0a9f2aae2ecdea4ddb77e8ecb3b6b0c","36a112d4b3e0c575b4f7cda6e957380737be4a872f6962231d591441b84b7c39","0947183721cc7bc6b24f3cfe60cf82376f43aa30b744312ffc65aee58489f2ab","0a8f0efd48d6a95fdbba74a401827d4da3648617ed2332d0131390fc61a9c4a7","2360c17a06e5cd98b3ead53cc0381545e85f5c8a4ff87d895bb27d943e59ee95","cde041e52b3c4ef5440703a14da4f4e7e70c78378eb1027f6386686d3f887484"],"paragraph_range_zero_based":[312,335],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2506458.zip::R2-2506458 Correction on delivery of posSIB segments by dedicated siganling in RRC_CONNECTED.docx:p312"}
{"fields":{"filename":"R2-2506458.zip::R2-2506458 Correction on delivery of posSIB segments by dedicated siganling in RRC_CONNECTED.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"defaultUL-BH-RLC-Channel","paragraph_zero_based":336},{"literal_text_all_w_t_and_m_t":"This field is used for IAB-nodes to configure the default uplink BH RLC channel, which is used by IAB-node during IAB-node bootstrapping, migration, IAB-MT RRC resume and IAB-MT RRC re-establishment for F1-C and non-F1 traffic. The defaultUL-BH-RLC-Channel can be (re-)configured when IAB-node IP address for F1-C related traffic changes, and the new IP address is anchored at a different IAB-donor-DU. This field is mandatory for IAB-node bootstrapping. If the IAB-MT is operating in EN-DC, the default uplink BH RLC channel is referring to an RLC channel on the SCG; Otherwise, it is referring to an RLC channel either on the MCG or on the SCG depending on whether the MN or the SN configures this field.","paragraph_zero_based":337},{"literal_text_all_w_t_and_m_t":"flowControlFeedbackType","paragraph_zero_based":338},{"literal_text_all_w_t_and_m_t":"This field is only used for IAB-node that support hop-by-hop flow control to configure the type of flow control feedback. Value perBH-RLC-Channel indicates that the IAB-node shall provide flow control feedback per BH RLC channel, value perRoutingID indicates that the IAB-node shall provide flow control feedback per routing ID, and value both indicates that the IAB-node shall provide flow control feedback both per BH RLC channel and per routing ID.","paragraph_zero_based":339},{"literal_text_all_w_t_and_m_t":"fullConfig","paragraph_zero_based":340},{"literal_text_all_w_t_and_m_t":"Indicates that the full configuration option is applicable for the RRCReconfiguration message for intra-system intra-RAT HO. For inter-RAT HO from E-UTRA to NR, fullConfig indicates whether or not delta signalling of SDAP/PDCP from source RAT is applicable. This field is absent if any DAPS bearer is configured or when the RRCReconfiguration message is transmitted on SRB3, and in an RRCReconfiguration message for SCG contained in another RRCReconfiguration message (or RRCConnectionReconfiguration message, see TS 36.331 [10]) transmitted on SRB1.","paragraph_zero_based":341},{"literal_text_all_w_t_and_m_t":"iab-IP-Address","paragraph_zero_based":342},{"literal_text_all_w_t_and_m_t":"This field is used to provide the IP address information for IAB-node.","paragraph_zero_based":343},{"literal_text_all_w_t_and_m_t":"iab-IP-AddressIndex","paragraph_zero_based":344},{"literal_text_all_w_t_and_m_t":"This field is used to identify a configuration of an IP address.","paragraph_zero_based":345},{"literal_text_all_w_t_and_m_t":"iab-IP-AddressToAddModList","paragraph_zero_based":346},{"literal_text_all_w_t_and_m_t":"List of IP addresses allocated for IAB-node to be added and modified.","paragraph_zero_based":347},{"literal_text_all_w_t_and_m_t":"iab-IP-AddressToReleaseList","paragraph_zero_based":348},{"literal_text_all_w_t_and_m_t":"List of IP address allocated for IAB-node to be released.","paragraph_zero_based":349},{"literal_text_all_w_t_and_m_t":"iab-IP-Usage","paragraph_zero_based":350},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the usage of the assigned IP address. If this field is not configured, the assigned IP address is used for all traffic.","paragraph_zero_based":351},{"literal_text_all_w_t_and_m_t":"iab-donor-DU-BAP-Address","paragraph_zero_based":352},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the BAP address of the IAB-donor-DU where the IP address is anchored.","paragraph_zero_based":353},{"literal_text_all_w_t_and_m_t":"keySetChangeIndicator","paragraph_zero_based":354},{"literal_text_all_w_t_and_m_t":"Indicates whether UE shall derive a new KgNB. If reconfigurationWithSync is included, value true indicates that a KgNB key is derived from a KAMF key taken into use through the latest successful NAS SMC procedure, or N2 handover procedure with KAMF change, as described in TS 33.501 [11] for KgNB re-keying. Value false indicates that the new KgNB key is obtained from the current KgNB key or from the NH as described in TS 33.501 [11].","paragraph_zero_based":355},{"literal_text_all_w_t_and_m_t":"ltm-Config","paragraph_zero_based":356},{"literal_text_all_w_t_and_m_t":"The network does not configure this field in an RRCReconfiguration message within an LTM-Config IE and ConditionalReconfiguration IE.","paragraph_zero_based":357},{"literal_text_all_w_t_and_m_t":"masterCellGroup","paragraph_zero_based":358},{"literal_text_all_w_t_and_m_t":"Configuration of master cell group.","paragraph_zero_based":359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"76462aa471fa83431d86182eefda142afacc351f546418f009f044fd915fff93","original_member_sha256":"a0378c459c9ba264d361c3cd6028808c92e1dee1a68688b75ef5a3cdc95396cf","paragraph_ElementTree_utf8_XML_sha256":["ef25832242d0798a55b68b782d89af682aaf860f179d119fba9df66817863f06","114340dc471ac0adb6301f8ebaada5a94697f02c6af5c5370fecdbc071c0b971","4c5af18182ae6bff6df004095afba38fef86f6b14e3692b03db54f968ffd69da","dfdadd7781f2e57dd0220f228117c89b9b8d2e04102c1b8d3fcb8e1f41451d58","775efbe6a5cfa403d188e0a7dae4b842a5cfd89cc74fa5dda7b4030bae0b4465","e8d6114200648e59d70a1cd804c08f320de79df37fff92fc626d633ca5ec2ebc","89063e123be7fd4c2c34e91baef8f68358571e56fbc47fd8aac33b5ddfa9464a","647babe20066c49d906f5a65be4da1212bad8c91234da478ea94ed0883ddb079","c1035dde2510ca084218ffcaeca6f727641f1ca6a91e4c1fda84a9e90847e8f0","60c1fd035ef31cbd7e11bd19b2367fa2861c0201f3cd6e69bb1e845bf817d403","385914c5a8aa223488099be84ce23c877995e3ae352e1bab0d1ac7ae6ee3697d","e6960dc8e0fa5a51a2a27354116a410ee3fcde355680b884010a88f9a461a005","eeeede26a4d1e8ed0a1663ac12bd048007138a4ddbbf3a4f879f3eb517449cad","4454847845e19f23d73bb7451e33ec8dc267b12f7e28cdbdff6ebd784b14c18a","2e814a0b8a25b5e4b71b7bc4ba70baaed6e7372f81a2ea712005e2607d342ba8","1cb4ba6f4fcd82f6583c3614aa35e1b6c5117340a4d493139fc7d8c4b935c794","cbe4e9318e952bad0ce2b06ac1012faeaa9519efc497cdf22c6652cb587101ab","88852a6c8fefc7691f5e79cabf9bdb1e9502dfc43c1bbd3dc8cd7e9c9f32032f","daece6bcc40ede4a18f2f6b7d36108bcb90d9e49e711db7fd155bd1d150f0966","a1c008e2534898fdd9fe5abb323613870efb147981c29e51d3a3fcd404d39362","51d86009bee9db6117d914394dd4bc5cefc290360812314bcd8c5c3cd57851e8","b1ca36de50d064979f74d3b5f6a2c00213d99b6d563dafd9f179119bd312c91b","f506883c4290faeefc6e791840a973ab4daa9e1613e3395d827a19d2e50c8145","9b939742812158e4c4ed9cd5be2db411fad4ea5f76c797c849b216d03d7420d3"],"paragraph_range_zero_based":[336,359],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2506458.zip::R2-2506458 Correction on delivery of posSIB segments by dedicated siganling in RRC_CONNECTED.docx:p336"}
{"fields":{"filename":"R2-2506458.zip::R2-2506458 Correction on delivery of posSIB segments by dedicated siganling in RRC_CONNECTED.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"mrdc-ReleaseAndAdd","paragraph_zero_based":360},{"literal_text_all_w_t_and_m_t":"This field indicates that the current SCG configuration is released and a new SCG is added at the same time.","paragraph_zero_based":361},{"literal_text_all_w_t_and_m_t":"mrdc-SecondaryCellGroup","paragraph_zero_based":362},{"literal_text_all_w_t_and_m_t":"Includes an RRC message for SCG configuration in NR-DC or NE-DC.For NR-DC (nr-SCG), mrdc-SecondaryCellGroup contains the RRCReconfiguration message as generated (entirely) by SN gNB. In this version of the specification, the RRC message can only include fields secondaryCellGroup, otherConfig, conditionalReconfiguration, ltm-Config, measConfig, bap-Config, IAB-IP-AddressConfigurationList and appLayerMeasConfig.","paragraph_zero_based":363},{"literal_text_all_w_t_and_m_t":"For NE-DC (eutra-SCG), mrdc-SecondaryCellGroup includes the E-UTRA RRCConnectionReconfiguration message as specified in TS 36.331 [10]. In this version of the specification, the E-UTRA RRC message can only include the field scg-Configuration.","paragraph_zero_based":364},{"literal_text_all_w_t_and_m_t":"mrdc-SecondaryCellGroupConfig","paragraph_zero_based":365},{"literal_text_all_w_t_and_m_t":"This field is used to configure and release an SCG in NR-DC and NE-DC. In an RRCReconfiguration message within an LTM-Config IE associated with the MCG, if this field is present its value can only be set to release.","paragraph_zero_based":366},{"literal_text_all_w_t_and_m_t":"musim-GapConfig","paragraph_zero_based":367},{"literal_text_all_w_t_and_m_t":"Indicates the MUSIM gap configuration and controls setup/release of MUSIM gaps. In this version of the specification, the network does not configure MUSIM gap together preconfigured measurement gap for positioning. For the UE supporting musim-GapPriorityPreference, the network can configure MUSIM gap together with concurrent measurement gap. Otherwise, the network does not configure MUSIM gap together with concurrent measurement gap.","paragraph_zero_based":368},{"literal_text_all_w_t_and_m_t":"nas-Container","paragraph_zero_based":369},{"literal_text_all_w_t_and_m_t":"This field is used to transfer UE specific NAS layer information between the network and the UE. The RRC layer is transparent for this field, although it affects activation of AS  security after inter-system handover to NR. The content is defined in TS 24.501 [23].","paragraph_zero_based":370},{"literal_text_all_w_t_and_m_t":"needForGapsConfigNR","paragraph_zero_based":371},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurement gap requirement information of NR target bands in the RRCReconfigurationComplete and RRCResumeComplete message.","paragraph_zero_based":372},{"literal_text_all_w_t_and_m_t":"needForGapNCSG-ConfigEUTRA","paragraph_zero_based":373},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurement gap and NCSG requirement information of EUTRA target bands in the RRCReconfigurationComplete and RRCResumeComplete message.","paragraph_zero_based":374},{"literal_text_all_w_t_and_m_t":"needForGapNCSG-ConfigNR","paragraph_zero_based":375},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurement gap and NCSG requirement information of NR target bands in the RRCReconfigurationComplete and RRCResumeComplete message.","paragraph_zero_based":376},{"literal_text_all_w_t_and_m_t":"needForInterruptionConfigNR","paragraph_zero_based":377},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE shall report interruption requirement information of NR target bands in the RRCReconfigurationComplete and RRCResumeComplete message. The network sets this field to enabled only if the needForGapsConfigNR is configured. The network sets this field to disabled if the needForGapsConfigNR is released.","paragraph_zero_based":378},{"literal_text_all_w_t_and_m_t":"nextHopChainingCount","paragraph_zero_based":379},{"literal_text_all_w_t_and_m_t":"Parameter NCC: See TS 33.501 [11]","paragraph_zero_based":380},{"literal_text_all_w_t_and_m_t":"onDemandSIB-Request","paragraph_zero_based":381},{"literal_text_all_w_t_and_m_t":"Indicates that the UE is allowed to request SIB(s) on-demand while in RRC_CONNECTED according to clause 5.2.2.3.5.","paragraph_zero_based":382},{"literal_text_all_w_t_and_m_t":"onDemandSIB-RequestProhibitTimer","paragraph_zero_based":383}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"76462aa471fa83431d86182eefda142afacc351f546418f009f044fd915fff93","original_member_sha256":"a0378c459c9ba264d361c3cd6028808c92e1dee1a68688b75ef5a3cdc95396cf","paragraph_ElementTree_utf8_XML_sha256":["2a0c9d15aec2b79719047570f77f823e5f215ccf5af009b0e981e5679e024b71","a2845f6c1930469a3833ef9dc2cfa9c7ebf82593e1aedee8c8d737107076cefc","63c685bb52e50a4755390dff727c7246709174c562dcb5c53906fe2296432259","076cfaaec05e0db07a4d7b7018c2dd32afc1fde38d5ef3de2e8aa817fa27266e","b3eb6d03733882e367c16726e297fa0cbcbcaf2ecdba5c3322155bf5e79d4fc5","052aed12d07e29195e3b98f3e5be1eb2690f42e8ce44ff6f9a82af3de27cc072","7aa6267d97605d07fb6a3c3716bd3cbd5567dce823c15d1d7ee0cc93a761638c","263a4ad025fc3985da33e12d79762bf8851ca26baace0856b28fda1f5b300179","d184ecc6576ef36aa1de354f7c1b73adec57ba16fdcbaadbe67876b404f91c86","29ba92ae8b6b96243583b8d7a40c7d71c653991363289f8c1c8750a63dae9979","d9933afb49b96dc67fde07835b18469744a8f2fad96d6bbd8b5d520143542c6c","e15b487c1ba25b60842a11eb0c269bb3744f48647df53846498cfc126f91d9fb","32511d487e288730f0fe43bc15bcb21c2ceb1e67e5c4e61ffe000f72dd2bdb44","811392ecfe1c62d31b5c681ede60297c3de3276e93b9f0e4fad2c5f76e125529","cfc63b80d7f16e6056ad36c6c8a4843dbece849c25b6069bf0f12990c1259c43","5d2d7ee35dfd954ebded2f848b5d9fca8fd6aa30410ac0abe5d4dc294b048517","6bacb3854997604b2a12aa390d6ad1eefe4a34d519ec88bb51193964de7cb029","8a0a84a6294ff1ca3237fd496c2612b62a98f678ac7bb74ca587cd8787f3b8cd","4bc1b8a98fba66c086df7366ada075be4d0fd0ee083b19981864acd1fb55a50b","d89f14b114aead8e1d3a9c3a56c502dcf5635c7ebb80bb7175a4a5b745eec364","6dca4881bfde70f9d17f249da83d045b64b1a888d6a4927ed5e7e3d0cad9691a","dd29b83c5dff381f4bd628d544faeb528d2c80b863cb2caae0ca0e6c120e853c","04a6a50e24e7bd447aa78fb783248548aeb90331a8283cfaa07ee93f00ce9d9e","220ce319ab1b4032e9f9bdb01b451720c6f45af060d0016f2fa88b54986c0147"],"paragraph_range_zero_based":[360,383],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2506458.zip::R2-2506458 Correction on delivery of posSIB segments by dedicated siganling in RRC_CONNECTED.docx:p360"}
{"fields":{"filename":"R2-2506458.zip::R2-2506458 Correction on delivery of posSIB segments by dedicated siganling in RRC_CONNECTED.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Prohibit timer for requesting SIB(s) on-demand while in RRC_CONNECTED according to clause 5.2.2.3.5. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":384},{"literal_text_all_w_t_and_m_t":"otherConfig","paragraph_zero_based":385},{"literal_text_all_w_t_and_m_t":"Contains configuration related to other configurations. When configured for the SCG, only fields drx-PreferenceConfig, maxBW-PreferenceConfig, maxBW-PreferenceConfigFR2-2, maxCC-PreferenceConfig, maxMIMO-LayerPreferenceConfig, maxMIMO-LayerPreferenceConfigFR2-2, minSchedulingOffsetPreferenceConfig, minSchedulingOffsetPreferenceConfigExt, rlm-RelaxationReportingConfig, bfd-RelaxationReportingConfig, btNameList, wlanNameList, sensorNameList, obtainCommonLocation, idc-AssistanceConfig, multiRx-PreferenceReportingConfigFR2, ul-TrafficInfoReportingConfig, n3c-RelayUE-InfoReportConfig, successPSCell-Config and sn-InitiatedPSCellChange can be included.","paragraph_zero_based":386},{"literal_text_all_w_t_and_m_t":"radioBearerConfig","paragraph_zero_based":387},{"literal_text_all_w_t_and_m_t":"Configuration of Radio Bearers (DRBs, SRBs, multicast MRBs) including SDAP/PDCP. In (NG)EN-DC this field may only be present if the RRCReconfiguration is transmitted over SRB3. SRB4 should not be configured if sl-L2RemoteUE-Config-r17 is configured or not released.","paragraph_zero_based":388},{"literal_text_all_w_t_and_m_t":"radioBearerConfig2","paragraph_zero_based":389},{"literal_text_all_w_t_and_m_t":"Configuration of Radio Bearers (DRBs, SRBs) including SDAP/PDCP. This field can only be used if the UE supports NR-DC or NE-DC.","paragraph_zero_based":390},{"literal_text_all_w_t_and_m_t":"scg-State","paragraph_zero_based":391},{"literal_text_all_w_t_and_m_t":"Indicates that the SCG is in deactivated state.","paragraph_zero_based":392},{"literal_text_all_w_t_and_m_t":"This field is not used","paragraph_zero_based":393},{"literal_text_all_w_t_and_m_t":"-in an RRCReconfiguration message received:","paragraph_zero_based":394},{"literal_text_all_w_t_and_m_t":"-within mrdc-SecondaryCellGroup, or","paragraph_zero_based":395},{"literal_text_all_w_t_and_m_t":"-in an E-UTRA RRCConnectionReconfiguration message, or","paragraph_zero_based":396},{"literal_text_all_w_t_and_m_t":"-in an E-UTRA RRCConnectionResume message or","paragraph_zero_based":397},{"literal_text_all_w_t_and_m_t":"-in an RRCReconfiguration message received via SRB3, except if the RRCReconfiguration message is included in DLInformationTransferMRDC.","paragraph_zero_based":398},{"literal_text_all_w_t_and_m_t":"The field is absent if CPA, CPC, or subsequent CPAC is configured for the UE, or if the RRCReconfiguration message is contained in CondRRCReconfig, or PSCell is configured with tag2, or if the RRCReconfiguration message is included within an LTM-Config IE.","paragraph_zero_based":399},{"literal_text_all_w_t_and_m_t":"sl-L2RelayUE-Config","paragraph_zero_based":400},{"literal_text_all_w_t_and_m_t":"Contains L2 U2N relay operation related configurations used by a UE acting as or to be acting as a L2 U2N Relay UE or L2 U2U relay operation related configuration used by a UE acting as a L2 U2U Relay UE. In case of L2 U2N relay operation, the field is absent if conditionalReconfiguration is configured for CHO.","paragraph_zero_based":401},{"literal_text_all_w_t_and_m_t":"sl-L2RemoteUE-Config","paragraph_zero_based":402},{"literal_text_all_w_t_and_m_t":"Contains L2 U2N relay operation related configurations used by a UE acting as or to be acting as a L2 U2N Remote UE or L2 U2U relay operation related configuration used by a UE acting as a L2 U2U Remote UE. In case of L2 U2N relay operation, the field is absent if conditionalReconfiguration is configured for CHO, or if appLayerMeasConfig or SRB4 is configured/not released.","paragraph_zero_based":403},{"literal_text_all_w_t_and_m_t":"secondaryCellGroup","paragraph_zero_based":404},{"literal_text_all_w_t_and_m_t":"Configuration of secondary cell group ((NG)EN-DC or NR-DC).","paragraph_zero_based":405},{"literal_text_all_w_t_and_m_t":"sk-Counter","paragraph_zero_based":406},{"literal_text_all_w_t_and_m_t":"A counter used upon initial configuration of S-KgNB or S-KeNB, as well as upon refresh of S-KgNB or S-KeNB. This field is always included either upon initial configuration of an NR SCG or upon configuration of the first RB with keyToUse set to secondary, whichever happens first. This field is absent if there is neither any NR SCG nor any RB with keyToUse set to secondary, or if the RRCReconfiguration message is contained in condRRCReconfig for subsequent CPAC.","paragraph_zero_based":407}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"76462aa471fa83431d86182eefda142afacc351f546418f009f044fd915fff93","original_member_sha256":"a0378c459c9ba264d361c3cd6028808c92e1dee1a68688b75ef5a3cdc95396cf","paragraph_ElementTree_utf8_XML_sha256":["9644f0ab1f01820d35ef7239f69f919591d71d639fb4ec1f3735645a24996731","c067002fa7c1ef377b949a924913e36fdd5f75f99160f8bb050598556b28ab53","f3313907a91560294d1369a1b02507e2075d4ff274e1394421c216a479e89ed2","98faeca69dab3530ac7f345b556687dc6e4771a5c8fab25f2d4b52801a23b597","779fef91d2f98d4005ad42c4ca88689caf499a407a5cbdb4aa22afba27306992","adb3884576026d2e63279c62d4b3a5c95132175a47c6db92a570d9dd8f9b3ba5","e86b3a733d54c6c5d948ab3772d89b4f90cc9fae760e9ecbe73f2493c8fe070b","287ffc6e9a173a3e11994541866e0ce47eb111cba6ee0ad83947d4b6c4063338","aed874e2690c97d3945277e2ade5414c3eac4c53dca737d5813a6bad85665e9a","f02b91b5c755b3e20152baea3dd62671fa05d926766b51386410a311fcbe865b","f42c715d5552b868a345920ea0dd1ac3d77e1b88765c2bf07deb9f761dbc5aac","d6ec34bee075164e3830d28484f47ab0929e113b8fd6397a68f73f7819d0eb33","09900c7d262da4ae0a378b4ede81f7507211b2d6841aa5afa2c7576782a685ca","c0ad7347433eadffc97a513b86fb7e9f4e943e92219549c607ce5b3ed8f004f4","c310840a47600ad685a43d946b51c317627270e1f74e337533ab37939e525917","1079547d1562871ce8603015938819a02456c800517f7d9a6894da3a02b4f7a1","a4d79ecfeb1eef99c9e07ab14f628c597ce7d984bbe5c21d10f6f43658331c94","eb829044adbdde23929302f47458a8ff117df37550d553af015c4510b535f515","e2eaeaf3a0766ba5185faef818eb01f9c00d7c983de7f22ba74c30ee35142cf6","05281aefc32e20791d0c07a8816beef8205bb26e5460365dd036b95121320d11","3c66e098d9a3a386ddc3bfc52989a35c85f3f6a9904ca1e097660684aba32795","4e3f4697763bd6d55fcfcc0478bae4c8562bd59e6a10c643842dd7174fef483d","332f9f03b3f6ca1c8d380f0c382b873944c9dedabe5821c35072ff2553bf7d9a","6aefc04770a3bedfb5b0ba0edb76cb3c30428f414625799f1d500c232cf9d8e2"],"paragraph_range_zero_based":[384,407],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2506458.zip::R2-2506458 Correction on delivery of posSIB segments by dedicated siganling in RRC_CONNECTED.docx:p384"}
{"fields":{"filename":"R2-2506458.zip::R2-2506458 Correction on delivery of posSIB segments by dedicated siganling in RRC_CONNECTED.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-ConfigDedicatedNR","paragraph_zero_based":408},{"literal_text_all_w_t_and_m_t":"This field is used to provide the dedicated configurations for NR sidelink communication/discovery/positioning.","paragraph_zero_based":409},{"literal_text_all_w_t_and_m_t":"sl-ConfigDedicatedEUTRA-Info","paragraph_zero_based":410},{"literal_text_all_w_t_and_m_t":"This field includes the E-UTRA RRCConnectionReconfiguration as specified in TS 36.331 [10]. In this version of the specification, the E-UTRA RRCConnectionReconfiguration can only includes sidelink related fields for V2X sidelink communication, i.e. sl-V2X-ConfigDedicated, sl-V2X-SPS-Config, measConfig and/or otherConfig.","paragraph_zero_based":411},{"literal_text_all_w_t_and_m_t":"srs-PosResourceSetLinkedForAggBWList","paragraph_zero_based":412},{"literal_text_all_w_t_and_m_t":"This field indicates the SRS resource sets across two or three carriers which are linked for SRS bandwidth aggregation in RRC_CONNECTED state as defined in clause 6.2.1.4 of TS 38.214 [19].","paragraph_zero_based":413},{"literal_text_all_w_t_and_m_t":"sl-TimeOffsetEUTRA","paragraph_zero_based":414},{"literal_text_all_w_t_and_m_t":"This field indicates the possible time offset to (de)activation of V2X sidelink transmission after receiving DCI format 3_1 used for scheduling V2X sidelink communication. Value ms0dpt75 corresponds to 0.75ms, ms1 corresponds to 1ms and so on. The network includes this field only when sl-ConfigDedicatedEUTRA is configured.","paragraph_zero_based":415},{"literal_text_all_w_t_and_m_t":"targetCellSMTC-SCG","paragraph_zero_based":416},{"literal_text_all_w_t_and_m_t":"The SSB periodicity/offset/duration configuration of target cell for NR PSCell addition and SN change. When UE receives this field, UE applies the configuration based on the timing reference of NR PCell for PSCell addition and PSCell change for the case of no reconfiguration with sync of MCG, and UE applies the configuration based on the timing reference of target NR PCell for the case of reconfiguration with sync of MCG. If both this field and the smtc in secondaryCellGroup -> SpCellConfig -> reconfigurationWithSync are absent, the UE uses the SMTC in the measObjectNR having the same SSB frequency and subcarrier spacing, as configured before the reception of the RRC message.","paragraph_zero_based":417},{"literal_text_all_w_t_and_m_t":"t316","paragraph_zero_based":418},{"literal_text_all_w_t_and_m_t":"Indicates the value for timer T316 as described in clause 7.1. Value ms50 corresponds to 50 ms, value ms100 corresponds to 100 ms and so on. This field can be configured only if the UE is configured with split SRB1 or SRB3.","paragraph_zero_based":419},{"literal_text_all_w_t_and_m_t":"ue-TxTEG-RequestUL-TDOA-Config","paragraph_zero_based":420},{"literal_text_all_w_t_and_m_t":"Configures the periodicity of UE reporting for the association between Tx TEG and SRS Positioning resources. When configured with oneShot UE reports the association only one time. When configured with periodicReporting UE reports the association periodically and the periodicReporting indicates the periodicity. Value ms160 corresponds to 160ms, value ms320 corresponds to 320ms and so on.","paragraph_zero_based":421},{"literal_text_all_w_t_and_m_t":"ul-GapFR2-Config","paragraph_zero_based":422},{"literal_text_all_w_t_and_m_t":"Indicates the FR2 UL gap configuration to UE. In EN-DC and NGEN-DC, the SN decides and configures the FR2 UL gap pattern. In NE-DC, the MN decides and configures the FR2 UL gap pattern. In NR-DC without FR2-FR2 band combination, the network entity which is configured with FR2 serving cell(s) decides and configures the FR2 UL gap pattern.","paragraph_zero_based":423},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":424},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":425},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":426},{"literal_text_all_w_t_and_m_t":"nonHO","paragraph_zero_based":427},{"literal_text_all_w_t_and_m_t":"The field is absent in case of reconfiguration with sync within NR or to NR; otherwise it is optionally present, need N.","paragraph_zero_based":428},{"literal_text_all_w_t_and_m_t":"securityNASC","paragraph_zero_based":429},{"literal_text_all_w_t_and_m_t":"This field is mandatory present in case of inter system handover. Otherwise the field is optionally present, need N.","paragraph_zero_based":430},{"literal_text_all_w_t_and_m_t":"MasterKeyChange","paragraph_zero_based":431}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"76462aa471fa83431d86182eefda142afacc351f546418f009f044fd915fff93","original_member_sha256":"a0378c459c9ba264d361c3cd6028808c92e1dee1a68688b75ef5a3cdc95396cf","paragraph_ElementTree_utf8_XML_sha256":["5412571803bb7325d8c16ddcbb1084bd7d0d0aed2328a6bb715bb772e6d1229e","0afb5422a72033c08c90401e59d595a7ad16ba34e02b1073cb52e1416f01bf2c","e12d53fd59ff8127f7a025ea69c64c82090458e4b188d4a496219a41b6fa0b55","8763c7e13e787f236b9532c590b7ee65f13ec76d802148b53f7b4504900637c8","24bbc02ace72aa0fa8a22c7b0a26996520f122dc48be05827912281353ae7a08","007cd51ead6997ab11b8e3f059333ae659e46ef90eecef02f57f40844db42072","0b6923c90ab1af7ea0a4d95a16332b9d9fbf10bb1f1ee4544217efb8a294b948","126f438d69ddddd9285308fef8fb5229e46734b03a808364460d4fdd0b291ad8","7709d591b3b9b5493611f186ebfd5307d546399d7f58565a0f043225ee65d881","bf063b835ca946c108940cda70fd9c336778da710ca72021f9a8fe3b92dd2769","532bdcf7f9beadeabbc89e5c82ac1b11eef834647c099da79e3a29d68ecc55bb","366b963496d537d187e6c8239d333ae09d6013975f38a840aa476755651d4161","74e8d5347e2427da6b08571c738773f57f5cccd74102e1e8d4ca0ea27c7baac1","5ef1f8d2d9c2b59f540da7ffd6255b0e73cd38d5a5737774b43e0b78523d3e22","6b68c867b2c63e30ebaed43094370a2f658eda2d0402834f25bbf151d68afc72","a6cd8887e79a0448ba19f2c63fff5e3e1d36a288a777a6d9df15cde286ba2905","ce28e1bece7794562640caea5ddb2fb73542e41f97c932c0cb7647b3d0132b54","6ec1184798bad304d1597de9e042c2c5bd4bcb136fec72b912ea1aa15fd89bad","14bca3bbcd457b190800eecbe04c9f110ece8823d44e6d33d7f9fda103b950fa","20406905c5cdf0e5f74fbd571b6873ba3a653871a596a4db5f13f574a0255339","6894e4a50e3fd71fe8585c79ea01bc56034f542d5a07d8ee57b136759cf7bfa0","52d596aed58495973923dcd5ac3f6a5e17002a2931db34208715dc75103b89ae","e330ea4ad1f628207151d91c8774960dfac11aa2c6ebff4bcab9aef1fc1c9e0f","41f5ca48c98942adcab5affaaf571707225ac221275ba039c8c3143806427a77"],"paragraph_range_zero_based":[408,431],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2506458.zip::R2-2506458 Correction on delivery of posSIB segments by dedicated siganling in RRC_CONNECTED.docx:p408"}
{"fields":{"filename":"R2-2506458.zip::R2-2506458 Correction on delivery of posSIB segments by dedicated siganling in RRC_CONNECTED.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is mandatory present in case masterCellGroup includes ReconfigurationWithSync and RadioBearerConfig includes SecurityConfig with SecurityAlgorithmConfig, indicating a change of the AS security algorithms associated to the master key. If ReconfigurationWithSync is included for other cases, this field is optionally present, need N. If ReconfigurationWithSync is part of an RRCReconfiguration message within an LTM-Config IE associated with the MCG, the field is absent. Otherwise the field is absent.","paragraph_zero_based":432},{"literal_text_all_w_t_and_m_t":"FullConfig","paragraph_zero_based":433},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in case of inter-system handover from E-UTRA/EPC to NR. It is optionally present, Need N, during a reconfiguration with sync which is not related to an LTM cell switch or subsequent CPAC, and also in first reconfiguration after reestablishment; or for intra-system handover from E-UTRA/5GC to NR. It is absent otherwise.","paragraph_zero_based":434},{"literal_text_all_w_t_and_m_t":"SCG","paragraph_zero_based":435},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in:","paragraph_zero_based":436},{"literal_text_all_w_t_and_m_t":"-an RRCReconfiguration message contained in an RRCResume message (or in an RRCConnectionResume message, see TS 36.331 [10]),","paragraph_zero_based":437},{"literal_text_all_w_t_and_m_t":"-an RRCReconfiguration message contained in an RRCConnectionReconfiguration message, see TS 36.331 [10], which is contained in DLInformationTransferMRDC transmitted on SRB3 (as a response to ULInformationTransferMRDC including an MCGFailureInformation).","paragraph_zero_based":438},{"literal_text_all_w_t_and_m_t":"The field is optional present, Need M, in:","paragraph_zero_based":439},{"literal_text_all_w_t_and_m_t":"-an RRCReconfiguration message transmitted on SRB3,","paragraph_zero_based":440},{"literal_text_all_w_t_and_m_t":"-an RRCReconfiguration message contained in another RRCReconfiguration message (or in an RRCConnectionReconfiguration message, see TS 36.331 [10]) transmitted on SRB1","paragraph_zero_based":441},{"literal_text_all_w_t_and_m_t":"-an RRCReconfiguration message contained in another RRCReconfiguration message which is contained in DLInformationTransferMRDC transmitted on SRB3 (as a response to ULInformationTransferMRDC including an MCGFailureInformation).","paragraph_zero_based":442},{"literal_text_all_w_t_and_m_t":"Otherwise, the field is absent.","paragraph_zero_based":443},{"literal_text_all_w_t_and_m_t":"PagingRelay","paragraph_zero_based":444},{"literal_text_all_w_t_and_m_t":"For L2 U2N Relay UE, the field is optionally present, Need N. Otherwise, it is absent.","paragraph_zero_based":445},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":446},{"literal_text_all_w_t_and_m_t":"===========================================================END OF CHANGES===================================================","paragraph_zero_based":447}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"76462aa471fa83431d86182eefda142afacc351f546418f009f044fd915fff93","original_member_sha256":"a0378c459c9ba264d361c3cd6028808c92e1dee1a68688b75ef5a3cdc95396cf","paragraph_ElementTree_utf8_XML_sha256":["7428a1990326c03fd640819fcf34d7422cf7730c668a5e10c27276063eb17f19","b8080cdaf0a73308f2dfef07cf09c116b8d2b1e6267731870e0695b04cd1fbf9","95226a523a46dd40a01d347e49add27f5b0bb1d9471dff7ab439b565c7ebbb7e","50474357d52cedd6611ce97c3d21a5aa297cbf2dd3f07158772c8ec33b0e5376","c940e7434617358eaded82ede461f1bf0d4b2a9c1d17ef403b38425e30ba27eb","9e24d2ea256b1b7534a99e036903a75abba9625bd5518bae65