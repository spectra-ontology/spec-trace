{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        sl-MappedQoS-FlowsList-r16              SEQUENCE (SIZE (1..maxNrofSL-QFIs-r16)) OF SL-QoS-Profile-r16,","paragraph_zero_based":48552},{"literal_text_all_w_t_and_m_t":"        sl-MappedQoS-FlowsListDedicated-r16     SL-MappedQoS-FlowsListDedicated-r16","paragraph_zero_based":48553},{"literal_text_all_w_t_and_m_t":"    }                                                                                                           OPTIONAL,   -- Need M","paragraph_zero_based":48554},{"literal_text_all_w_t_and_m_t":"    sl-CastType-r16                        ENUMERATED {broadcast, groupcast, unicast, spare1}                   OPTIONAL,   -- Need M","paragraph_zero_based":48555},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":48556},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":48557},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48558},{"literal_text_all_w_t_and_m_t":"SL-MappedQoS-FlowsListDedicated-r16 ::= SEQUENCE {","paragraph_zero_based":48559},{"literal_text_all_w_t_and_m_t":"    sl-MappedQoS-FlowsToAddList-r16         SEQUENCE (SIZE (1..maxNrofSL-QFIs-r16)) OF SL-QoS-FlowIdentity-r16  OPTIONAL,    -- Need N","paragraph_zero_based":48560},{"literal_text_all_w_t_and_m_t":"    sl-MappedQoS-FlowsToReleaseList-r16      SEQUENCE (SIZE (1..maxNrofSL-QFIs-r16)) OF SL-QoS-FlowIdentity-r16  OPTIONAL     -- Need N","paragraph_zero_based":48561},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":48562},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48563},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SDAP-CONFIG-STOP","paragraph_zero_based":48564},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":48565},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48566},{"literal_text_all_w_t_and_m_t":"SL-SDAP-Config field descriptions","paragraph_zero_based":48567},{"literal_text_all_w_t_and_m_t":"sl-DefaultRB","paragraph_zero_based":48568},{"literal_text_all_w_t_and_m_t":"Indicates whether or not this is the default sidelink DRB for this NR sidelink communication transmission destination. Among all configured instances of SL-SDAP-Config for this destination, this field shall be set to true in at most one instance of SL-SDAP-Config and to false in all other instances.","paragraph_zero_based":48569},{"literal_text_all_w_t_and_m_t":"sl-MappedQoS-Flows","paragraph_zero_based":48570},{"literal_text_all_w_t_and_m_t":"Indicates QoS flows to be mapped to the sidelink DRB. If the field is included in dedicated signalling, it is set to sl-MappedQoS-FlowsListDedicated; otherwise, it is set to sl-MappedQoS-FlowsList.","paragraph_zero_based":48571},{"literal_text_all_w_t_and_m_t":"sl-MappedQoS-FlowsList","paragraph_zero_based":48572},{"literal_text_all_w_t_and_m_t":"Indicates the list of QoS profiles of the NR sidelink communication transmission destination mapped to this sidelink DRB.","paragraph_zero_based":48573},{"literal_text_all_w_t_and_m_t":"sl-MappedQoS-FlowsToAddList","paragraph_zero_based":48574},{"literal_text_all_w_t_and_m_t":"Indicates the list of SL QoS flows ID of the NR sidelink communication transmission destination to be additionally mapped to this sidelink DRB.","paragraph_zero_based":48575}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["ae999c1fc86265752bf8966b02270b9e20adc48fcf7e6432e3e3c4ace5d2bada","cbbeb1f907386854ea162046717bbc88db6c243075a924e1f18a7204d77bad0b","6283bfa45a23ee6fe8c2819a7db473f706c5d2153dc9cf6009fea35b129d947a","8773f20ccd6a0