t_XML_sha256":"e683fd43e9f1fcc1f511d34d3fe1095df4f728b7bb02493cd3769fd9f47ad5fc","original_member_sha256":"25a143f7cd6ab63fbc2d97c8219cb398a3566fe36cf058296392d79803c693da","paragraph_ElementTree_utf8_XML_sha256":["44a6fbae7a163b1a85ed245ef84f58295f78c87f19936130659d81858b9d2df9","cf27c4149ff5ab7e2768de53c3ba915e4506dac270c3b04e19aedb385a8b12c8","69c9b86f58c65fe7c3af9c0ad9156244d4ad04b7c0b9db44b78221ac0cd3e620","894663225c09b9bf8e0b91f9696de54639aa2f8e05e0a0523e46f1ad9cf1d041","aedae053d6bbf27188e314394dd8151f61c53c99cc11f803bceab62da97e353f","42f51dce803bf2578c05a45cdf12a26ba4def04b31f67d1cb6bced7fdd528b51","6380db2edc4a4cd61e3d1d86f239298435fa4a34a20208c3aa25e18e0cb859a5","0a82c9d19c366e8754df2de006d9599944fc2b64fe767e6ca5170ee60c82f1a3","015441e26cc4aae7f09268f4f3d4c0768976e381de11f6ad1fe127c02746e412","a19ea15ba1268cc5917af8c900754836d637719de1da230e218f355ba2903b02","f2f23ba584ea41246879da8c4d50d85bef68825b7d36e066b3ede63eba74a88d","878a52e85221e6093db1fbcf0dc577827b0e81c395a75f35435f81be2a38e3d3","a7328e73b9726f4405de0c5632464b719ce8654cb19595aafac71cf8b03aec7c","3a0a24809194e82c4ea45f7e94843427bf088f467efffa5558d1cf43962ebee9","a8cde9a6ea3e78eca6008d5c7f92031facb6816af32abcd77185ee706d1cebe0","6ebd5c8c75b4887ef25d2b524438ea739cf761fb64cd8cab2a8cfbaa6ae8441d","553909c5fd22cef54b461b692d1501ee8de0802ce544fa4dd45fab164306501b","fe15ae377dab1c1d107a98b83ae87a64223bc8c6833493185bb80ac44bc9b232","df242787365d98a120a1446f4789a815eb0e9be42eceb93c6a27519fbe7da253","2fcdba8dfb859b6925c13368800542938c5baa72a4932e7361469ef551d86d59","901d1ca76aa2d7fec485c92b30a9330916d614cdc5aba19069d60a48d9d16d19","16f1a3effcd1c3a21ab83a65bd5197b80998444c04b5b2823b03acb6d6ecdd45","eb5d3f17b9de33222b9733ddf76b5430cb34cf4bc601acb4ed77207f37ade3d4","30db146523868f26693c728a3bf74b4e4a3bcab1a432c972580aa7c2d62e8f21"],"paragraph_range_zero_based":[24,47],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"sour