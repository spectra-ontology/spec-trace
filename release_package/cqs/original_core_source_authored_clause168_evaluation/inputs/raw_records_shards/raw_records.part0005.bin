{"fields":{"filename":"R2-2505772.zip::R2-2505772_MHSLRelayCap_CR_v0_Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether L2 multi-path remote UE supports PDCP duplication with more than one RLC entity over Uu interface in L2 multi-path relay. A UE supporting this feature shall also indicate support of multipathRemoteUE-PC5L2-r18 or multipathRemoteUE-N3C-r18.","paragraph_zero_based":144},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":145},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":146},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":147},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":148},{"literal_text_all_w_t_and_m_t":"pdcp-CADuplicationDirectpath-DRB-r18","paragraph_zero_based":149},{"literal_text_all_w_t_and_m_t":"Indicates whether L2 multi-path remote UE supports CA-based PDCP duplication over DRB using Uu interface in L2 multi-path relay. A UE supporting this feature shall also indicate support of pdcp-DuplicationMoreThanOneUuRLC-r18.","paragraph_zero_based":150},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":151},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":152},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":153},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":154},{"literal_text_all_w_t_and_m_t":"pdcp-CADuplicationDirectpath-SRB-r18","paragraph_zero_based":155},{"literal_text_all_w_t_and_m_t":"Indicates whether L2 multi-path remote UE supports CA-based PDCP duplication over SRB1/2 using Uu interface in L2 multi-path relay. A UE supporting this feature shall also indicate support of pdcp-DuplicationMoreThanOneUuRLC-r18.","paragraph_zero_based":156},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":157},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":158},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":159},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":160},{"literal_text_all_w_t_and_m_t":"pdcp-DuplicationMP-SplitDRB-r18","paragraph_zero_based":161},{"literal_text_all_w_t_and_m_t":"Indicates whether L2 multi-path remote UE supports PDCP duplication over split DRB in L2 multi-path relay. A UE supporting this feature shall also indicate support of multipathRemoteUE-PC5L2-r18 or multipathRemoteUE-N3C-r18.","paragraph_zero_based":162},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":163},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":164},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":165},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":166},{"literal_text_all_w_t_and_m_t":"pdcp-DuplicationMP-SplitSRB-r18","paragraph_zero_based":167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3d0669bebb61232fe20acea50a76ee807988cbd3d6f41a5e37816ee6179e9413","original_member_sha256":"c7379de7097f64dafbf008e1c06b57228e6acf168e72c816abdff7ae0ffde250","paragraph_ElementTree_utf8_XML_sha256":["f776e2500b58869e531deebcc7dcefc646a183a307f5075447166adec9ea76e3","7815ad1857ecea0195e082edd78adb0a9014806cd85d5b62ba7bd36641cc983a","a80d9e55cd3c26cf08431593f984c1d5bf530010f73885bbeaf3d65f47ae2c4b","34236e6c7dc39ec059fdc914d45b67d465eb343506b1c9371621d080c680fd69","b701546436b3630610c88f5d8641ac80060380ef774dc1bdb31caa1e832a9f71","8a62a79cb34c1d112756d98bf7d24b84e42cf11a030c47747b435cb87556ea8b","e14bee5791490a5b658c59ca84b9bc7cf4fbf9c940fba5e1ab719077032d7c9a","f804fb10ab1e2604f06729c7327a2705020467670921871043104bf86dfe2404","bc3776e8cb5cec3fa5d27adc5409f5ea939e3f8a322bd926d57000273b8d37b4","20b0a3241fcabe703a7f6f92c5760d279a6c084c7a3f7f0298d2e861fbf58606","59e3987e86baa83237b9453f144433c454b50cc70d7d63d1a3bc772cf00f0292","ba76ae397fa94235f75cec8dda4a00f98752963a93059d7f4cd8b4eefe397ce8","2dce052b60017773ec95a32af7edbcbb392f944a8877d67edd434c850