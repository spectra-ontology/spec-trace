{"fields":{"filename":"R2-2505772.zip::R2-2505772_MHSLRelayCap_CR_v0_Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Annex A.4 specifies for each sidelink related capability, in which interface (i.e., UECapabilityInformation in Uu RRC and UECapabilityInformationSidelink in PC5 RRC) a UE supporting sidelink shall report the concerned capability:","paragraph_zero_based":264},{"literal_text_all_w_t_and_m_t":"-UECapabilityInformation: the concerned sidelink capability is reported within UECapabilityInformation;","paragraph_zero_based":265},{"literal_text_all_w_t_and_m_t":"-UECapabilityInformationSidelink: the concerned sidelink capability is reported within UECapabilityInformationSidelink;","paragraph_zero_based":266},{"literal_text_all_w_t_and_m_t":"Table A.4-1: Sidelink capability reported in UECapabilityInformation/ UECapabilityInformationSidelink","paragraph_zero_based":267},{"literal_text_all_w_t_and_m_t":"Sidelink Parameter","paragraph_zero_based":268},{"literal_text_all_w_t_and_m_t":"UECapabilityInformation","paragraph_zero_based":269},{"literal_text_all_w_t_and_m_t":"UECapabilityInformationSidelink","paragraph_zero_based":270},{"literal_text_all_w_t_and_m_t":"accessStratumReleaseSidelink","paragraph_zero_based":271},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":272},{"literal_text_all_w_t_and_m_t":"X","paragraph_zero_based":273},{"literal_text_all_w_t_and_m_t":"outOfOrderDeliverySidelink","paragraph_zero_based":274},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":275},{"literal_text_all_w_t_and_m_t":"X","paragraph_zero_based":276},{"literal_text_all_w_t_and_m_t":"am-WithLongSN-Sidelink","paragraph_zero_based":277},{"literal_text_all_w_t_and_m_t":"X","paragraph_zero_based":278},{"literal_text_all_w_t_and_m_t":"X","paragraph_zero_based":279},{"literal_text_all_w_t_and_m_t":"um-WithLongSN-Sidelink","paragraph_zero_based":280},{"literal_text_all_w_t_and_m_t":