ce_cell_coordinates":{"document_XML_sha256":"d9d011c63c3d251478b414285a8b696398e51e6df9f4b032647a9ae762c61029","original_member_sha256":"d1a6bd19687d85e1704f0d784898e6446f67eb8794484d1e384699a9a0d13807","paragraph_ElementTree_utf8_XML_sha256":["adda21b50630ea595378b7ac1805cfbb4e494093948a30d4d4a60a350e10e222","57386f3709b96264490262e0ccbca469391386c9de2b282255e914948d0c8363","c30c02bb64a04d12455e3f8caa2a6806b0a698d0c779459a9888576cb2e4389b","8336bd59425b55876421d5b1a422cd176fe0baa571dbc8dc81e02029b84a4955","f15892921e401c261dafb17bb38bc4d21f8c8f5ddd0f49ff6cde87a144659290","49bd435fcc81f5a14dfc0fed550a3da67f678ad43077788b25bbe1840486093e","5a6aaa579f1f6f83a1d53d261831aca59917ebe84f98c18cb7a67586c3cbb5e3","bdfcd7cd050f536076d6207aed273d743d61a04812d134bd8c90c337cc04201b","b0c3e04779f45fa75d80864bde13a77edcbef61cd3b4da56a9f8276ac170cf01","2053ccd24106c0532682a5a78f23dce77c44daa0e44f28bc3debaf5ee0c9697d","19a56040407be5f9130416f8f173923077b94744e24908b8b51b5c4198050377","193874ad81d7f6685e9f59cf1ab1c99d58db3587e770e2044d30efed51644366","dc03585445e50a3fca7f25d64a731a9003ce8a7e01e4fe016c4a1695746b0bd9","94e7c8256117ffcdd77878d7a03635ae7b1dccce941fd4358a034514c7237c78","c77f2986723fba5cad2e00a4436f96318dd056ebf4d92ef86b7920c70904f5ad","cb41fb509d3752add79ad69ca3a23eb91c7e7d1bd16ca6c5a1daef8e28ae61d6","ee7901b2581927e691925b784b708bc84f1d914dbf83ec07cf4a48036671531d","5772b2fec48b4e9ae324069dbe86f8556698c78984a54f08c52b27422ac075ee","4f971784628831b10e2887a1940593b8c3d4fc0f0b63641328ccd0632a195650","a6b7372cc2af84e241228d1068105f8db7c7257e5533fd8b7a3407caeae07e89","561af430095ce74cdda0973049624574699525c6bfb857ae6529105fa08bbdfc","a61679fb53d80f29a70392d93af4804578226acba942700829cce7aae86acb67","de828d88a31fc940b464981ab76c31afab36ea7848a70b204ef285aaf6875fc4","0ff028a74222b2874b69382bb8b0a0ce6bf4976b1abf13fbd7685703407995ab"],"paragraph_range_zero_based":[120,143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretati