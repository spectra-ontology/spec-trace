658f24aa611911f4a9890a39c43fd00d01f8","e45ab1302fa559c54ecd422342f07b90aead1d8b0740b178a03e92ba85cb1661","07a5f4a78458239c4f78c086f82affcaa68fdfbfeeb2472f159587bbd058004c","946168f234c2fcd34b1fd437a25ebfb6f4ae5ad3ee845738622b25a6c9895329","f82e63b52a8c65bab5eb0f468a9b90f9a9ea63baa3a06a08d97305119a855e3b","abe0bdc934c2ad9c02282dc3873c1d0a0c8ebc007861f478758094dfcbf31734","28d20a16ae470389a532bc365a55e61c6f1ab45a9e84be2a782d798f5a0ed38a","ed65b8072368b10f29c7cf1b05e4181ae991a4f47f4881559ee1c4be918a2ffa","998ae6937fed9dab38d2ec294e1d1c07fe1b518dca52cae6a2d41dd3008a5792","bf712f7d0e7fcbeeb6bbbd10f5d46e993a9d7e7b66ba554f6a7f1c47cbfd4b8a","8d82c5f3bda15b29badd1143ea8c035dc7cf66d6eb243442f645ab783efed4b6","40d614b3aded5163675ab6f5fea7d6ab087f449d10a68fe45d414d2cb1b1b222","79cf4892af2c35bf6e0d75a9b2bd87f06593fb871bc97d2a4f8f502abf354d8d","aacd60251f0dcada7b29e3aa5183d1782f4fd6eb478a3409ffdf5622c3856641","a86828fb71283748b9d1696b361d7f472b06b4859dd39be184c702a6d56cdfb2"],"paragraph_range_zero_based":[2904,2927],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx:p2904"}
{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-UEASSISTANCEINFORMATION-STOP","paragraph_zero_based":2928},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":2929},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2930},{"literal_text_all_w_t_and_m_t":"UEAssistanceInformation field descriptions","paragraph_zero_based":2931},{"literal_text_all_w_t_and_m_t":"activeDuration","paragraph_zero_based":2932},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred active duration to resolve the IDC problem. Value in multiples of 1/32 ms (subMilliSeconds) or in ms (milliSecond). For the latter, value ms1 corresponds to 1 ms, value ms2 corresponds to 2 ms, and so on.","paragraph_zero_based":2933},{"literal_text_all_w_t_and_m_t":"affectedBandwidth","paragraph_zero_based":2934},{"literal_text_all_w_t_and_m_t":"Indicates the bandwidth around the center frequency of the carrier frequency range which is affected by the IDC problem. Value mhz5 corresponds to 5 MHz, value mhz10 corresponds to 10 MHz and so on. If candidateBandwidth is not configured, the UE is allowed to report the frequency range for any bandwidth as indicated by affectedBandwidth, within the frequency band limitation as defined in TS 38.101-1 [15], TS 38.101-2 [39], TS 38.101-3 [34] and TS 38.101-5 [75].","paragraph_zero_based":2935},{"literal_text_all_w_t_and_m_t":"affectedCarrierFreqList","paragraph_zero_based":2936},{"literal_text_all_w_t_and_m_t":"Indicates a list of NR carrier frequencies that are affected by IDC problem.","paragraph_zero_based":2937},{"literal_text_all_w_t_and_m_t":"affectedCarrierFreqRangeList","paragraph_zero_based":2938},{"literal_text_all_w_t_and_m_t":"Indicates a list of NR carrier frequency ranges that are affected by IDC problem.","paragraph_zero_based":2939},{"literal_text_all_w_t_and_m_t":"affectedCarrierFreqCombList","paragraph_zero_based":2940},{"literal_text_all_w_t_and_m_t":"Indicates a list of NR carrier frequency combinations that are affected by IDC problems due to Inter-Modulation Distortion and harmonics from NR when configured with UL CA or NR-DC.","paragraph_zero_based":2941},{"literal_text_all_w_t_and_m_t":"affectedCarrierFreqRangeCombList","paragraph_zero_based":2942},{"literal_text_all_w_t_and_m_t":"Indicates a list of NR carrier frequency range combinations that are affected by IDC problems due to Inter-Modulation Distortion and harmonics from NR when configured with UL CA or NR-DC","paragraph_zero_based":2943},{"literal_text_all_w_t_and_m_t":"applicabilityReportList","paragraph_zero_based":2944},{"literal_text_all_w_t_and_m_t":"The applicability reports related to prediction configurations and/or sets of parameters for prediction configurations.","paragraph_zero_based":2945},{"literal_text_all_w_t_and_m_t":"bfd-MeasRelaxationState","paragraph_zero_based":2946},{"literal_text_all_w_t_and_m_t":"Indicates the relaxation state of BFD measurements. Each bit corresponds to a serving cell of the cell group. A serving cell is mapped to the (servCellIndex+1)-th bit, starting from MSB. A bit that is set to 1 indicates that the UE is performing BFD measurements relaxation on the serving cell mapped on the bit. A bit that is set to 0 indicates that the UE is not performing BFD measurements relaxation on the serving cell mapped on the bit. If a serving cell is not configured to the UE, the corresponding bit is set to 0.","paragraph_zero_based":2947},{"literal_text_all_w_t_and_m_t":"memoryStatus","paragraph_zero_based":2948},{"literal_text_all_w_t_and_m_t":"Indicates the status of the memory reserved for the logging of radio measurements for network-side data collection.","paragraph_zero_based":2949},{"literal_text_all_w_t_and_m_t":"centerFreq","paragraph_zero_based":2950},{"literal_text_all_w_t_and_m_t":"Indicates the center frequency of the carrier frequency range which is affected by the IDC problem.","paragraph_zero_based":2951}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["e63459582b957e6f9ef2d315ef449b5e4c40f9f3c0c510b4ca87d3f3fa5c63fe","0070ba608e579647b63a3fefefa5e9b6c8e7eb9b334fe38f338b5fa48cf7e532","d5db547e02f4073ce5bd8a7945d57447c4fbc7dd6f42426de5ad1a1b566241f1","37f9cff820cdcc5ff4b3bfeb83cf0516f30d2d7e836bcad368f31f40a90403aa","fac7f8e8ad3f57834bfb12bdc3a8ef601a56c2c69b13e135a71fc66c84dbf33a","6ecff37b874129938f05f7704e034daccb4c52721cef1859a025919106b90120","35c39551dc8792a311799619860f86807ca43e28dd143bbb9bb23e8c27fd6dba","8e4247a788f5c69285243009ba3eb2ed38735ec2f0965e84cebba7d3ef063d83","d3cc77ca511b7e665ae00c53a2267a6e463ba78dd7f9a759ce6e3f6e176a2990","92975be18dc922393a159d741502ed0a8a8ddb0af4159ae068e255549fbbcedf","b52a1227c819df803e8b8ef86bfebdf735cf4cf481b1757ec350a0817992f743","7249c7006e65a61236c3a3652c99f4958b02405711bd16caef857c8fe8ad60f4","7b912207bbf1f451168bc3280044bf99504031992ffe48d30461dc55c286b1ad","35d0b05dbc7e7fd1851a0bbf6c8991b36c8a37535f304719b0713f5d90c66bd8","984463a89a7c89ccddf5370aae990a737458ca3d9512da3cc36831538418f5eb","b61d895896512d9417de6bf0cdc52ffb23a378ad36bbfd653bab5bf16f9d6542","3ddbffdcf8372c67a6ac42af603d27e28b8116c3b2456c49d955b985ff911ce0","210c38853e7fd119975944a062fa73b5fbb1b96f2ff23937b2c4a2e41f465746","ddae9ba618c5f3393a4937e705f70853434a9844837d15bbb2dcab4c312b13fc","79a86cbc1ff2dc6c3c76f92e546576a1d19a33a02050cba92e92f5c5d8d9b2bd","e44658a6d28883e32d0898765b963d229dd933eef9d9154458a9fb4a6b5a6914","464bea95497f172889d97467c7dada28aac812e13589c7d485417bb427a2d1a4","e18cb3ad05ebc957abe834ccd2d42059d1917d2a466fad1fccb87c4f6de65fd4","4000b55baf33f0f2ad24fa5c9bc2e5bd6e63ed1977dc48f0d211757c56183d45"],"paragraph_range_zero_based":[2928,2951],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx:p2928"}
{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"cycleLength","paragraph_zero_based":2952},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred cycle length to resolve the IDC problem. Value in ms. Value ms2 corresponds to 2 ms, value ms3 corresponds to 3 ms, and so on.","paragraph_zero_based":2953},{"literal_text_all_w_t_and_m_t":"dataCollectionCandidateIdList","paragraph_zero_based":2954},{"literal_text_all_w_t_and_m_t":"Indicates one or more IDs of candidate configurations preferred by the UE for UE-side data collection.","paragraph_zero_based":2955},{"literal_text_all_w_t_and_m_t":"dataCollectionIdList","paragraph_zero_based":2956},{"literal_text_all_w_t_and_m_t":"Indicates one or more IDs of UE-side data collection configurations that the UE prefers to stop.","paragraph_zero_based":2957},{"literal_text_all_w_t_and_m_t":"dataCollectionPreferredConfigurationList","paragraph_zero_based":2958},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred radio resource configurations for UE-side data collection.","paragraph_zero_based":2959},{"literal_text_all_w_t_and_m_t":"dataCollectionServCellIndex","paragraph_zero_based":2960},{"literal_text_all_w_t_and_m_t":"Index of the serving cell that the dataCollectionCandidateIdList refers to.","paragraph_zero_based":2961},{"literal_text_all_w_t_and_m_t":"dataCollectionRequest","paragraph_zero_based":2962},{"literal_text_all_w_t_and_m_t":"It indicates the UE's preference to be configured with radio resources for UE-side data collection.","paragraph_zero_based":2963},{"literal_text_all_w_t_and_m_t":"dataCollectionStopConfigurationList","paragraph_zero_based":2964},{"literal_text_all_w_t_and_m_t":"Indicates the radio resource configurations for UE-side data collection that the UE prefers to stop.","paragraph_zero_based":2965},{"literal_text_all_w_t_and_m_t":"dataCollectionStopServCellIndex","paragraph_zero_based":2966},{"literal_text_all_w_t_and_m_t":"Index of the serving cell that the dataCollectionIdList refers to.","paragraph_zero_based":2967},{"literal_text_all_w_t_and_m_t":"delayBudgetReport","paragraph_zero_based":2968},{"literal_text_all_w_t_and_m_t":"Indicates the UE-preferred adjustment to connected mode DRX.","paragraph_zero_based":2969},{"literal_text_all_w_t_and_m_t":"interferenceDirection","paragraph_zero_based":2970},{"literal_text_all_w_t_and_m_t":"Indicates the direction of IDC interference. Value nr indicates that only NR is victim of IDC interference, value other indicates that only another radio is victim of IDC interference and value both indicates that both NR and another radio are victims of IDC interference. The other radio refers to either the ISM radio or GNSS (see TR 36.816 [44]).","paragraph_zero_based":2971},{"literal_text_all_w_t_and_m_t":"loggedDataCollectionAssistance","paragraph_zero_based":2972},{"literal_text_all_w_t_and_m_t":"Indicates assistance information related to the logging of measurements for network-side data collection performed in accordance with CSI-LoggedMeasurementConfig.","paragraph_zero_based":2973},{"literal_text_all_w_t_and_m_t":"lowPowerState","paragraph_zero_based":2974},{"literal_text_all_w_t_and_m_t":"It is set to true if the UE has entered a low power state.","paragraph_zero_based":2975}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["9029fbe448781b9f09748da31a860bfc4f746124c9e977c6c0acc2d6cdbf69f0","55e001153edd26ff0a9783e95277faea785090367c9c382bc1832cdad28a9f44","b079ac288625a24a683c7f8c98c68cbc007160fea638e01c5ad810894f9d73ce","2e3b8ca4c94801865ef8ffd124e0ab37045fa9d9569abd80afd910f96c6f0f11","dcc09102cde26369360322a5ba61101d84a35ee8eae277c4e1f543e96b1de5d0","08b2530d7ec9743a2d370e2d1b6198f40daf70b6f3fc6a6d486c8b337890d499","a691bb5cedd00090037f5fe6118f1828781834d9f5b0f0996ea3ab7fe5540289","09eade42d963a7019993f6bb0b78a741ea0e1d341d1f189ad9d4c208da3c99fa","8fa39c2deb5a6ee632fe17fb16487a01030d0bfc94ef2ac514feb9056edd1546","73ad317ef894850f465e19eb59d602ae62b6872f7d1dff5b8c400499612dbb6b","a75610a1d5174d1617b212361f86dfa2dc9c8f63cd297a462047af6196f27f03","b91f46abcc623e0487d1f2d20da98ba77837cbedd34f133161f12c58829d7fb6","19d56872c87f47cf2ec804211474cce756281a60e5c3c6b9d09dee68e7130091","c824483b9814295a3812925db243cbf6e0c605d91ea6e7e6328615ff9a45ff96","eb2800eac3509099088341008712da2c4a63c0f96b07f8d7391ca8d36a9ee4f8","25f16334521a7bbfa1b7a49ec66b8f06f0eaf3b8689b7f25366c7f0734562773","c0b09405388b21ca34fb06cf43291b9e49b91149e673d3e81d540e93d50524aa","146014da4702c2b51f0a52a1618ba275a8f311f7f7ce7348a133410ec53a54e6","6a6035059fb5682067a1db0df8d408022e6756605f17509e996556aa33d75508","47c1c1a28b8c0ac6b37b9d863dda2fb954b6f545cd0b16907aaf11e0f24def31","b103eddea94fcdf5d899483a9f01dc83162e5141a3c29baef467cdd09bbabbb4","93adc217f97214972f195c84d3443a84586971a7308ae5f8cef4ff9910eb45a1","4e57f49d285bfed0470130b109f6ed771f0ab293e866f556af21b54b8c9c42d7","60058306e4e5adfad31537751617a6b6b560f660ca8c413a06f1c3ce643b7413"],"paragraph_range_zero_based":[2952,2975],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx:p2952"}
{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"lpwus-OffsetPreference","paragraph_zero_based":2976},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred time offset for PDCCH monitoring after LP-WUS monitoring. Value in ms (milliSecond). ms5 corresponds to 5 ms, ms13 corresponds to 13 ms, and ms37 corresponds to 37 ms. The reported preferred time offset value is equal to or longer than the minimum time gap reported by UE capability for a UE. If the field is absent, it is interpreted as the UE having no preference for the time offset for LP-WUS monitoring.","paragraph_zero_based":2977},{"literal_text_all_w_t_and_m_t":"minSchedulingOffsetPreference","paragraph_zero_based":2978},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferences on minimumSchedulingOffset of cross-slot scheduling for power saving.","paragraph_zero_based":2979},{"literal_text_all_w_t_and_m_t":"minSchedulingOffsetPreferenceExt","paragraph_zero_based":2980},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferences on minimumSchedulingOffset of cross-slot scheduling for power saving for SCS 480 kHz and/or 960 kHz.","paragraph_zero_based":2981},{"literal_text_all_w_t_and_m_t":"multiRx-PreferenceFR2","paragraph_zero_based":2982},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on single FR2 Rx operation to address overheating or power saving. This field is allowed to be reported only when UE is configured with serving cells operating on FR2.","paragraph_zero_based":2983},{"literal_text_all_w_t_and_m_t":"musim-AffectedBandsList","paragraph_zero_based":2984},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on the band(s) and/or combination(s) of bands with restricted capability for MUSIM operation. If the MUSIM-CapabilityRestrictedBandParameters-r18 with same musim-bandEntryIndex appears more than once in the list of bands in a MUSIM-AffectedBands entry, the UE supports intra-band non-contiguous CA with restricted capability for MUSIM operation for this band. UE explicitly indicates each band and each combination of bands that are affected. The Network should respect these capability restrictions when configuring the UE with bands or band combinations that contain these bands and/or combination of bands. Fields musim-MIMO-Layers-DL/UL and musim-SupportedBandwidth-DL/UL indicate the max number of MIMO layers and max bandwidth on each CC of the band, respectively. The band(s) and/or combination(s) of bands are supported in UE capability, and the musim-MIMO-Layers-DL/UL and musim-SupportedBandwidth-DL/UL range up to the concerned maximum capability of band(s) and/or combination(s) of bands in UE capability. For each concerned band or band combination, the lowest value of each musim-MIMO-Layers-DL/UL/musim-SupportedBandwidth-DL/UL and the corresponding capabilities in the UE capability determines the supported maximum MIMO layers and maximum bandwidth for DL/UL, respectively.","paragraph_zero_based":2985},{"literal_text_all_w_t_and_m_t":"musim-AvoidedBandsList","paragraph_zero_based":2986},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on band(s) and/or combination(s) of bands to be avoided for MUSIM purpose. UE explicitly indicates each band and each combination of bands to be avoided. The list may include the band of the PCell. The Network should respect these capability restrictions for the band combinations that contain these bands and/or combination of bands. The band(s) and/or combination(s) of bands is a subset of the band combination(s) in UE capability.","paragraph_zero_based":2987},{"literal_text_all_w_t_and_m_t":"musim-bandEntryIndex","paragraph_zero_based":2988},{"literal_text_all_w_t_and_m_t":"Indicates an NR band by referring to the position of a band entry in musim-CandidateBandList IE. Value 1 identifies the first band in the musim-CandidateBandList IE, value 2 identifies the second band in the musim-CandidateBandList IE, and so on.","paragraph_zero_based":2989},{"literal_text_all_w_t_and_m_t":"musim-CapabilityRestricted","paragraph_zero_based":2990},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on the temporary capability restriction on the band for MUSIM operation.","paragraph_zero_based":2991},{"literal_text_all_w_t_and_m_t":"musim-CapRestriction","paragraph_zero_based":2992},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on SCell(s) or PSCell to be released, serving cell(s) with restricted capability, band(s) or combination(s) of bands with restricted capability, or band(s) or band combination(s) to be avoided for UE temporary capabilities restriction.","paragraph_zero_based":2993},{"literal_text_all_w_t_and_m_t":"musim-Cell-SCG-ToRelease","paragraph_zero_based":2994},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on any serving cell(s), except for Pcell, and/or SCG to be released for MUSIM operation.","paragraph_zero_based":2995},{"literal_text_all_w_t_and_m_t":"musim-CellToAffectList","paragraph_zero_based":2996},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on the temporary capability restriction on the serving cell(s) for MUSIM operation.","paragraph_zero_based":2997},{"literal_text_all_w_t_and_m_t":"musim-CellToRelease","paragraph_zero_based":2998},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on the temporary capability restriction on the serving cell(s) to release, except PCell, for MUSIM operation.","paragraph_zero_based":2999}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["986a8df15dad2fe6b74f376861458af874440babac8eedc952858c0f76a8d1f3","54950ac4d3139bea4a4e4a63dbabfb9338de671ee5b38906662c6e6d73a13443","291c45b8a5ba32b308d97feb45a4c93796b1e1ecae9d7d104bd8b770a20a0f8e","e1772edd015a7137b97968a021877dd58b7743fab3978103e2b4bf86abaa597b","7934ee1921056ae5ae740d9594da0b23e5d0688c8320ec16fcf261a869f8fc66","5eaf2d3b81cc8836ac33ada075bc806d6dc27345c7768219953d823e269d1a9f","6c3013244feba29c3193c2709686a4870610761a490856bb26f81d73b9a0cd4d","4d8037a96dd967e0632f53e4a3bd16a7a141ba234c139932fac6ec1f6bce936a","e90a03dcd40c2c1d064e1ebbf5464ac4204aed7bd1609541e366fd2fd775ae6b","31886e83b42f85eb0ad882450655e8dfeb2fc3bc85cfa3c415f5b4037b462156","14a56af718422609213a7469fc9b684b738b4089decf8883a4339566eb5ca3ed","7d17f7d456fff79832c7bea76e1b2f016efebb7b948e6be768bceb693460e3a0","df758539bdf6cfe37beab94a39a31408c12083a3c2f3015a211f42ede03be57a","e9c7ce624ee7a4e3372767ee3ffb842a7b71045aceb1b705f393bc6aaa6b46a8","b0d212cf30fbb27b7fc15c1953605f3b1f37595ff9d0e723229e04f111a387a1","aa10d8ce841f1da3105cfb0cadd8c4162c6255ba08566ad500e2e17e104739eb","ea6d4a8d2cb63bd66d5e7980b03b0366c167aaa2964be0da0f10818f350ddcda","8be1ee6c6e9e8f75a33de5e471f8fd59efdd0ad0795d4233c1dad21bc200a6a1","0595ab14e0dab8ff9c361e6fae178d93e0ba7c60c2fffb55e1d1ab74c13607df","385110208a99fc58604d5ac72218a4c980eb5cc955ebbd3c4f39ee61f25c635a","37cfe02740948517f0ed8eae25e86042e68c1859157a8bfdd21a55ff57c4dac3","73882a39c023c3f289f154bce76661ae522e4051ef0ba1ac7a640d91c15eee28","7b8e2572438ff15a36848ad71e5e4a827e0e0fbc4ef69e0cc419a8b931226dde","de8e2a12589df0a4420b21892ca4a43d0d4b650de05231ad6b87521b06b2560e"],"paragraph_range_zero_based":[2976,2999],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx:p2976"}
{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"musim-GapKeepPreference","paragraph_zero_based":3000},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference to keep all colliding gaps for requested MUSIM gap(s). If the field is absent, the colliding MUSIM gaps with lower priority shall be dropped as specified in TS 38.133 [14].","paragraph_zero_based":3001},{"literal_text_all_w_t_and_m_t":"musim-GapPreferenceList","paragraph_zero_based":3002},{"literal_text_all_w_t_and_m_t":"Indicates the UE's MUSIM gap preference and related MUSIM gap configuration, as defined in TS 38.133 [14] clause 9.1.10.","paragraph_zero_based":3003},{"literal_text_all_w_t_and_m_t":"musim-GapPriorityPreferenceList","paragraph_zero_based":3004},{"literal_text_all_w_t_and_m_t":"Indicates the UE's MUSIM gap priority preference for periodic MUSIM gaps as specified in TS 38.133[14].","paragraph_zero_based":3005},{"literal_text_all_w_t_and_m_t":"If the UE includes musim-GapPriorityPreferenceList-r18, it includes the same number of entries, and listed in the same order for periodic gaps, as in musim-GapPreferenceList-r17.","paragraph_zero_based":3006},{"literal_text_all_w_t_and_m_t":"musim-MaxCC","paragraph_zero_based":3007},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on the temporary capability restriction on maximum number of CCs per DL/UL in total, and per FR1/FR2-1/F2-2.","paragraph_zero_based":3008},{"literal_text_all_w_t_and_m_t":"musim-NeedForGapsInfoNR","paragraph_zero_based":3009},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the measurement gap requirement information of the UE for NR target bands when in MUSIM operation while NR-DC or NE-DC is not configured. ","paragraph_zero_based":3010},{"literal_text_all_w_t_and_m_t":"musim-PreferredRRC-State","paragraph_zero_based":3011},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred RRC state when leaving RRC_CONNECTED.","paragraph_zero_based":3012},{"literal_text_all_w_t_and_m_t":"n3c-RelayUE-InfoList","paragraph_zero_based":3013},{"literal_text_all_w_t_and_m_t":"Information of available N3C relay UE(s).","paragraph_zero_based":3014},{"literal_text_all_w_t_and_m_t":"nonSDT-DataIndication","paragraph_zero_based":3015},{"literal_text_all_w_t_and_m_t":"Informs the network about the arrival of data and/or signaling mapped to radio bearers not configured for SDT while SDT procedure is ongoing.","paragraph_zero_based":3016},{"literal_text_all_w_t_and_m_t":"preferredDRX-InactivityTimer","paragraph_zero_based":3017},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred DRX inactivity timer length for power saving. Value in ms (milliSecond). ms0 corresponds to 0, ms1 corresponds to 1 ms, ms2 corresponds to 2 ms, and so on. If the field is absent from the DRX-Preference IE, it is interpreted as the UE having no preference for the DRX inactivity timer. If secondary DRX group is configured, the preferredDRX-InactivityTimer only applies to the default DRX group.","paragraph_zero_based":3018},{"literal_text_all_w_t_and_m_t":"preferredDRX-LongCycle","paragraph_zero_based":3019},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred long DRX cycle length for power saving. Value in ms. ms10 corresponds to 10ms, ms20 corresponds to 20 ms, ms32 corresponds to 32 ms, and so on. If preferredDRX-ShortCycle is provided, the value of preferredDRX-LongCycle shall be a multiple of the preferredDRX-ShortCycle value. If the field is absent from the DRX-Preference IE, it is interpreted as the UE having no preference for the long DRX cycle. This field may also indicate UE’s preference for cellDTX-DRX-Cycle.","paragraph_zero_based":3020},{"literal_text_all_w_t_and_m_t":"preferredDRX-ShortCycle","paragraph_zero_based":3021},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred short DRX cycle length for power saving. Value in ms. ms2 corresponds to 2ms, ms3 corresponds to 3 ms, ms4 corresponds to 4 ms, and so on. If the field is absent from the DRX-Preference IE, it is interpreted as the UE having no preference for the short DRX cycle.","paragraph_zero_based":3022},{"literal_text_all_w_t_and_m_t":"preferredDRX-ShortCycleTimer","paragraph_zero_based":3023}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["12261f338e64bb91c35a39d0ac91a1425700506157940fb05f40f165c8bb2222","63a6516ec10cba899e86832781d6e501671ad093be3ccf967b87fd13dbf53ad0","8f42690f91d15c9329bb82d866f7db4dd85a043b19937c43947f826b75e5b73e","bb54bb21cacc2cbcb2809110a453ea4c5cfd2d8dfcf5bc6b2a3bc50dd9ec77f2","1067e6d0d65813d11a8f16ca6ecc57f77ae2505ee8bbaba15a16630b34bfc9f9","9f46ffba6c66de5f543bdf36c1830a6b843a033eafedc1b966421eae8d49402c","d331f8464a674ee45fd01f55b4a10348121aa488069815449de80cd8046a7816","e1fc7be571e799917b202e7e5220009ee7817318dfaac40a9c9f23558d534df0","b4bc1fe01dc70326e18035931c530b008e899500916b35938dcb22a640e6b103","56068c01cbb9699c9b560fddd4ace49b0afd8f2a8b282ae8b2a5f11f3afaddf3","cc65608cece816ab1d85d57f6598ef59ac4ca95430f90abfadc4720ea32faee8","05c8499a3346cdf96e2e3a6982cada8a9266bebb4a16f3a40d55ca34489f021c","62a4987ddfef0ff527b3b478484ed66e094f7c9db8ab6369deef61d018b9c04f","0d16ef0191f0c8b609080020c0fb6e52b2af2531e9a06cd0aa750232919d7e9f","f87d96388f66187e08b56435a26f7c0248f0438f461d0a85e792b630fe298945","0c32dfd80283f1289c1627daf56c51940951370d1efd1eb7d70fedd020c36212","03b7fbed8818c943f3fb48839ed9a01c605009e0dc3260c1dfd744fd09ca4e89","f4ad8d0c5a6ff73868dad402b9bd8608fcd5906c61fbce39723199b41daafd94","671ecc9dd7aaf32e0de4333f7232a3ab2b0bc46ff6467a69b21cfd1c4034c636","1fd09fbbbe8b2ca6b87d6c3679467e6288da4469fb87f2d3cc3c82454e9133c5","32b03be65de0956b5f5ab3b359e80d0143aa140b230cc7924994b41e9ef6b639","b48e461285bb601936740bd36aef3bcbf66b605ed4dcfdd32328f4b93ee73013","c6049341cc393f238243db2642fdfc561b0d96a89a66638702658da1849e5a52","75fc11fc2a20d9474675c58c5f9a21884a1846d223c40591b7d08868ff206b8b"],"paragraph_range_zero_based":[3000,3023],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx:p3000"}
{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred short DRX cycle timer for power saving. Value in multiples of preferredDRX-ShortCycle. A value of 1 corresponds to preferredDRX-ShortCycle, a value of 2 corresponds to 2 * preferredDRX-ShortCycle and so on. If the field is absent from the DRX-Preference IE, it is interpreted as the UE having no preference for the short DRX cycle timer. A preference for the short DRX cycle is indicated when a preference for the short DRX cycle timer is indicated.","paragraph_zero_based":3024},{"literal_text_all_w_t_and_m_t":"preferredK0","paragraph_zero_based":3025},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred value of k0 (slot offset between DCI and its scheduled PDSCH - see TS 38.214 [19], clause 5.1.2.1) for cross-slot scheduling for power saving. Value is defined for each subcarrier spacing (numerology) in units of slots. sl1 corresponds to 1 slot, sl2 corresponds to 2 slots, sl4 corresponds to 4 slots, and so on. If a value for a subcarrier spacing is absent, it is interpreted as the UE having no preference on k0 for cross-slot scheduling for that subcarrier spacing. If the field is absent from the MinSchedulingOffsetPreference IE, it is interpreted as the UE having no preference on k0 for cross-slot scheduling.","paragraph_zero_based":3026},{"literal_text_all_w_t_and_m_t":"preferredK2","paragraph_zero_based":3027},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred value of k2 (slot offset between DCI and its scheduled PUSCH - see TS 38.214 [19], clause 6.1.2.1) for cross-slot scheduling for power saving. Value is defined for each subcarrier spacing (numerology) in units of slots. sl1 corresponds to 1 slot, sl2 corresponds to 2 slots, sl4 corresponds to 4 slots, and so on. If a value for a subcarrier spacing is absent, it is interpreted as the UE having no preference on k2 for cross-slot scheduling for that subcarrier spacing. If the field is absent from the MinSchedulingOffsetPreference IE, it is interpreted as the UE having no preference on k2 for cross-slot scheduling.","paragraph_zero_based":3028},{"literal_text_all_w_t_and_m_t":"preferredRRC-State","paragraph_zero_based":3029},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred RRC state. The value idle is indicated if the UE prefers to be released from RRC_CONNECTED and transition to RRC_IDLE. The value inactive is indicated if the UE prefers to be released from RRC_CONNECTED and transition to RRC_INACTIVE. The value connected is indicated if the UE prefers to revert an earlier indication to leave RRC_CONNECTED state. The value outOfConnected is indicated if the UE prefers to be released from RRC_CONNECTED and has no preferred RRC state to transition to. The value connected can only be indicated if the UE is configured with connectedReporting.","paragraph_zero_based":3030},{"literal_text_all_w_t_and_m_t":"propagationDelayDifference","paragraph_zero_based":3031},{"literal_text_all_w_t_and_m_t":"Indicates the one-way service link propagation delay difference between serving cell and each neighbour cell included in neighCellInfoList, defined as neighbour cell's service link propagation delay minus serving cell's service link propagation delay, in number of ms. First entry in propagationDelayDifference corresponds to first entry in neighCellInfoList, second entry in propagationDelayDifference corresponds to second entry in neighCellInfoList, and so on.","paragraph_zero_based":3032},{"literal_text_all_w_t_and_m_t":"reducedCCsDL","paragraph_zero_based":3033},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum number of downlink SCells indicated by the field, to address overheating or power saving.","paragraph_zero_based":3034},{"literal_text_all_w_t_and_m_t":"When indicated to address overheating, this maximum number includes SCells of the NR MCG, PSCell and SCells of the SCG. This maximum number only includes PSCell and SCells of the SCG in (NG)EN-DC.","paragraph_zero_based":3035},{"literal_text_all_w_t_and_m_t":"When indicated to address power saving, this maximum number includes PSCell and SCells of the cell group that this UE assistance information is associated with. The maximum number of downlink SCells can only range up to the current active configuration when indicated to address power savings.","paragraph_zero_based":3036},{"literal_text_all_w_t_and_m_t":"reducedCCsUL","paragraph_zero_based":3037},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum number of uplink SCells indicated by the field, to address overheating or power saving.","paragraph_zero_based":3038},{"literal_text_all_w_t_and_m_t":"When indicated to address overheating, this maximum number includes SCells of the NR MCG, PSCell and SCells of the SCG. This maximum number only includes PSCell and SCells of the SCG in (NG)EN-DC.","paragraph_zero_based":3039},{"literal_text_all_w_t_and_m_t":"When indicated to address power saving, this maximum number includes PSCell and SCells of the cell group that this UE assistance information is associated with. The maximum number of uplink SCells can only range up to the current active configuration when indicated to address power savings.","paragraph_zero_based":3040},{"literal_text_all_w_t_and_m_t":"reducedMaxBW-FR1","paragraph_zero_based":3041},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum aggregated bandwidth across all downlink carrier(s) and across all uplink carrier(s) of FR1, to address overheating or power saving. This field is allowed to be reported only when UE is configured with serving cell(s) operating on FR1. The aggregated bandwidth across all downlink carrier(s) of FR1 is the sum of bandwidth of active downlink BWP(s) across all activated downlink carrier(s) of FR1. The aggregated bandwidth across all uplink carrier(s) of FR1 is the sum of bandwidth of active uplink BWP(s) across all activated uplink carrier(s) of FR1. If the field is absent from the MaxBW-Preference IE or the OverheatingAssistance IE, it is interpreted as the UE having no preference on the maximum aggregated bandwidth of FR1.","paragraph_zero_based":3042},{"literal_text_all_w_t_and_m_t":"When indicated to address overheating, this maximum aggregated bandwidth includes carrier(s) of FR1 of both the NR MCG and the SCG. This maximum aggregated bandwidth only includes carriers of FR1 of the SCG in (NG)EN-DC. Value mhz0 is not used when indicated to address overheating.","paragraph_zero_based":3043},{"literal_text_all_w_t_and_m_t":"When indicated to address power saving, this maximum aggregated bandwidth includes carrier(s) of FR1 of the cell group that this UE assistance information is associated with. The aggregated bandwidth can only range up to the current active configuration when indicated to address power savings.","paragraph_zero_based":3044},{"literal_text_all_w_t_and_m_t":"reducedMaxBW-FR2","paragraph_zero_based":3045},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum aggregated bandwidth across all downlink carrier(s) and across all uplink carrier(s) of FR2-1, to address overheating or power saving. This field is allowed to be reported only when UE is configured with serving cell(s) operating on FR2-1. The aggregated bandwidth across all downlink carrier(s) of FR2-1 is the sum of bandwidth of active downlink BWP(s) across all activated downlink carrier(s) of FR2-1. The aggregated bandwidth across all uplink carrier(s) of FR2-1 is the sum of bandwidth of active uplink BWP(s) across all activated uplink carrier(s) of FR2-1. If the field is absent from the MaxBW-Preference IE or the OverheatingAssistance IE, it is interpreted as the UE having no preference on the maximum aggregated bandwidth of FR2-1.","paragraph_zero_based":3046},{"literal_text_all_w_t_and_m_t":"When indicated to address overheating, this maximum aggregated bandwidth includes carrier(s) of FR2-1 of both the NR MCG and the NR SCG. This maximum aggregated bandwidth only includes carriers of FR2-1 of the SCG in (NG)EN-DC.","paragraph_zero_based":3047}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["b3c1b9413b0c04976e0dd734b619494d2a89f8a10cd0449ef0237db1873ba2ea","aaf34cfed3a9d78f0a2709da36712743c8947159e9ba6b57589dad0312a9ba26","8f22d345c39ff8a3bbd105f58284b89f63627bf5d026c5928c6d68b0ee969ce4","baf8db60a0a7218fd4e9602b412648dedab4d39be526c9ec068942890b5a02b6","0593705d73cf7b88c012e4904782492d238e8485bc0c6a69dada1bb184d8902a","5fb58beed6e149bacc20badccbbd02e170a4d0a9e0832b38ba450806dd8db327","0719d142c3781f7680960183bd4f2f386d78164de3745cbb9fece1283add3b8b","218fb14f774bde7f04e50327bf196449bb3d0f1b46442cc65e172d688e1fc12f","b793c82d931373bfa250e1121196f599b4fff6f8d51b2c07b8d9079ae6902d89","d87dab3159b157b784b45fdfe2d6ce4df6eab339519d4fb3382783824d6703ad","21b3c51b9616431b5af8a29b574970cf61e19ff1a22149f9fca363e1e909f194","2ab8a338bc2866885052c670bb0d473754579bcb0e4b03c346a9757ba6ed0b5b","740a01b84d8d90e9c5a358a8e9222cd057e30078ea961354fc4ca36094480a26","4b8bc1fdc7beccd4ca342d51b65478c9ca531f842f2eaf4f09ced879787d36d9","7c895652e64fa1b1ed7d61175bacf00dfeee292fdeba7d9e2b4c61829cc83bf0","523c124320b8eaa73abcd478cf8759d2f5f020317cf704e45a01951351f19951","3008569a6cee015d16fa2593c6ea4b7c3a69362dc0f822efb35f0c9a030bb590","b40c472b7bb6cb4c6895c049c851ed05904d20edf80480424fb105491a883119","95bb0f7e7d45ba6f1d9353837d480bb14322e735c74910a0e4edcb41d953c5f5","afc16a49cdd892f10cb8cc5ca649baabef18e69f74ef0a50d3543d083b88163c","1b2c6d27d9f70d889f98d97acc06316d692a8c87a29f8a4b0851a031ce987c67","5d731ac339412303f8031fbbbce346801d4c231761ea1546d8b01a1b32948273","fdaaab7e841413f45f28999e18966f52a0b6e7b0e9fb865399d946647b5fa9ea","79b3add4e4faa435dd8d798c60e2570cba33c50d59c72d014e7b83a62e3db9ef"],"paragraph_range_zero_based":[3024,3047],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx:p3024"}
{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"When indicated to address power saving, this maximum aggregated bandwidth includes carrier(s) of FR2-1 of the cell group that this UE assistance information is associated with. The aggregated bandwidth can only range up to the current active configuration when indicated to address power savings.","paragraph_zero_based":3048},{"literal_text_all_w_t_and_m_t":"reducedMaxBW-FR2-2","paragraph_zero_based":3049},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum aggregated bandwidth across all downlink carrier(s) and across all uplink carrier(s) of FR2-2, to address overheating or power saving. This field is allowed to be reported only when UE is configured with serving cell(s) operating on FR2-2. The aggregated bandwidth across all downlink carrier(s) of FR2-2 is the sum of bandwidth of active downlink BWP(s) across all activated downlink carrier(s) of FR2-2. The aggregated bandwidth across all uplink carrier(s) of FR2-2 is the sum of bandwidth of active uplink BWP(s) across all activated uplink carrier(s) of FR2-2. If the field is absent from the MaxBW-PreferenceFR2-2 IE or the OverheatingAssistance IE, it is interpreted as the UE having no preference on the maximum aggregated bandwidth of FR2-2.","paragraph_zero_based":3050},{"literal_text_all_w_t_and_m_t":"When indicated to address overheating, this maximum aggregated bandwidth includes carrier(s) of FR2-2 of both the NR MCG and the NR SCG. This maximum aggregated bandwidth only includes carriers of FR2-2 of the SCG in (NG)EN-DC.","paragraph_zero_based":3051},{"literal_text_all_w_t_and_m_t":"When indicated to address power saving, this maximum aggregated bandwidth includes carrier(s) of FR2-2 of the cell group that this UE assistance information is associated with. The aggregated bandwidth can only range up to the current active configuration when indicated to address power savings.","paragraph_zero_based":3052},{"literal_text_all_w_t_and_m_t":"reducedMIMO-LayersFR1-DL","paragraph_zero_based":3053},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum number of downlink MIMO layers of each serving cell operating on FR1 indicated by the field, to address overheating or power saving. This field is allowed to be reported only when UE is configured with serving cells operating on FR1. The maximum number of downlink MIMO layers can only range up to the maximum number of MIMO layers configured across all activated downlink carrier(s) of FR1 in the cell group when indicated to address power savings.","paragraph_zero_based":3054},{"literal_text_all_w_t_and_m_t":"reducedMIMO-LayersFR1-UL","paragraph_zero_based":3055},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum number of uplink MIMO layers of each serving cell operating on FR1 indicated by the field, to address overheating or power saving (see NOTE 1). This field is allowed to be reported only when UE is configured with serving cells operating on FR1. The maximum number of uplink MIMO layers can only range up to the maximum number of MIMO layers configured across all activated uplink carrier(s) of FR1 in the cell group when indicated to address power savings.","paragraph_zero_based":3056},{"literal_text_all_w_t_and_m_t":"reducedMIMO-LayersFR2-DL","paragraph_zero_based":3057},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum number of downlink MIMO layers of each serving cell operating on FR2-1 indicated by the field, to address overheating or power saving. This field is allowed to be reported only when UE is configured with serving cells operating on FR2-1. The maximum number of downlink MIMO layers can only range up to the maximum number of MIMO layers configured across all activated downlink carrier(s) of FR2-1 in the cell group when indicated to address power savings.","paragraph_zero_based":3058},{"literal_text_all_w_t_and_m_t":"reducedMIMO-LayersFR2-UL","paragraph_zero_based":3059},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum number of uplink MIMO layers of each serving cell operating on FR2-1 indicated by the field, to address overheating or power saving (see NOTE 1). This field is allowed to be reported only when UE is configured with serving cells operating on FR2-1. The maximum number of uplink MIMO layers can only range up to the maximum number of MIMO layers configured across all activated uplink carrier(s) of FR2-1 in the cell group when indicated to address power savings.","paragraph_zero_based":3060},{"literal_text_all_w_t_and_m_t":"reducedMIMO-LayersFR2-2-DL","paragraph_zero_based":3061},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum number of downlink MIMO layers of each serving cell operating on FR2-2 indicated by the field, to address overheating or power saving. This field is allowed to be reported only when UE is configured with serving cells operating on FR2-2. The maximum number of downlink MIMO layers can only range up to the maximum number of MIMO layers configured across all activated downlink carrier(s) of FR2-2 in the cell group when indicated to address power savings.","paragraph_zero_based":3062},{"literal_text_all_w_t_and_m_t":"reducedMIMO-LayersFR2-2-UL","paragraph_zero_based":3063},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum number of uplink MIMO layers of each serving cell operating on FR2-2 indicated by the field, to address overheating or power saving (see NOTE 1). This field is allowed to be reported only when UE is configured with serving cells operating on FR2-2. The maximum number of uplink MIMO layers can only range up to the maximum number of MIMO layers configured across all activated uplink carrier(s) of FR2-2 in the cell group when indicated to address power savings.","paragraph_zero_based":3064},{"literal_text_all_w_t_and_m_t":"referenceLocationReport","paragraph_zero_based":3065},{"literal_text_all_w_t_and_m_t":"This field indicates the reference locations that are closest to the UE for assisted SMTC configuration in RRC_CONNECTED state. The length of the bitmap is equal to the number of entries in the refLocList currently configured for the UE (either via OtherConfig or SIB2). The UE sets the bit at a given position to '1' if the reference location at the corresponding position in the refLocList is one of the closest locations, and to '0' otherwise. The first bit in the string corresponds to the first reference location in the list, and so on.","paragraph_zero_based":3066},{"literal_text_all_w_t_and_m_t":"referenceTimeInfoPreference","paragraph_zero_based":3067},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE prefers being provisioned with the timing information specified in the IE ReferenceTimeInfo.","paragraph_zero_based":3068},{"literal_text_all_w_t_and_m_t":"resumeCause","paragraph_zero_based":3069},{"literal_text_all_w_t_and_m_t":"Provides the resume cause based on the information received from the upper layers.","paragraph_zero_based":3070},{"literal_text_all_w_t_and_m_t":"rlm-MeasRelaxationState","paragraph_zero_based":3071}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["a4346e32027863b213b1dbcb508482ca0e9fa67f333d1161cf9d5221f0431322","0c12329c056f500dfd2ae47b2e8d021fb9e4b48b1b8207a0fc4c52babc0285c2","2b401c84678e1d1eddafef110bc778d0235a7b36d5b2e1a901bc6e88fe512f64","05e40cc48c9e86aa281f4af4e03f66018af310b24f3b5c5687764fe28b6531e8","7a011623a88f2fe4a97207548fbba92b46eb5d5ca09532e1700e9db53c99f54b","10c1d4f9a04963f79d0d40b36b65ecb9a334baa6c4d4a5e3cf98b88623940bc2","27560ae7f67b111d24a7f832ffeac3654e0933d6692d6a5737b6221f8f5fde9a","f5ce8cc45858bea94ff382c1f9323b2b7e4529a0494f2b3ace694c3975d7a803","75dcca24b97d2a60784720c0006b95cef02d436be72aa71abc60260ae823fc14","d5c52d1dcc59e54f8b98bcd9bdf6766f05499a2932a74ee8acb701671e7d0a8b","c56219b9b30d35ee674853a9725523e57642bdd42d37fe68fb9721057738cf0e","6d1d49f42b64aa24a2a8bdbbd4efe8b0060e00f014ff4628e7970c93632f250b","b732ca8e4668cfa8a7a45c89d5df4278f062a2a4620a4a392ee4dd2a7e37c0eb","ad9bc5f594c2fbb84eeb206474c5babe87aa089e1b7262f72aa27dcee69159e9","19179ac505853554b6b8e4500a32b52509dfaa2d5135dbdb35806d97059a97c4","bb1e19d006c6f7ce07d2c0380e9f90d4600368a40c41e5f1ff097894067eb3cd","d2690dd15cde071b8d6e36c54aa4ce5597792491900c054577ed7ea50d46262d","1bcdf96db0761a6037f0c8eff3dadb0130a60a47e209c2538d2bfa03ff31f5eb","8013c5dcdaaeda798381dae235a2616eda79a9b4e2c88a711b813e7f271686a9","9663a741f1a917a059058342ea913e7f4fe6816230eee2ed45f861ba95a7cb2a","0178a30e91b454ab27addf531e916c83635784c8207b73d0c375ad04572998d4","bd7f96585cc40171d4d685d1eadf689a83f2152843e3720180ebfd40a75db57e","1e4d9b9810fe59b4c01463a2fdc01004f93c6b0d0981220b112eed8e6b4f2c2a","0a56e635fcf1771a040a2617dfb224a3aa409c0d66dc4494f1f81c10ead18bdc"],"paragraph_range_zero_based":[3048,3071],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx:p3048"}
{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the relaxation state of RLM measurements. Value true indicates that the UE is performing relaxation of RLM measurements, and value false indicates that the UE is not performing relaxation of RLM measurements.","paragraph_zero_based":3072},{"literal_text_all_w_t_and_m_t":"rrm-MeasRelaxationFulfilment","paragraph_zero_based":3073},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE fulfils the relaxed measurement criterion for stationary UE in 5.7.4.4. Value true indicates that the UE fulfils the criterion, and value false indicates that the UE does not fulfil the criterion.","paragraph_zero_based":3074},{"literal_text_all_w_t_and_m_t":"sl-QoS-FlowIdentity","paragraph_zero_based":3075},{"literal_text_all_w_t_and_m_t":"This identity uniquely identifies one sidelink QoS flow between the UE and the network in the scope of UE, which is unique for different destination and cast type.","paragraph_zero_based":3076},{"literal_text_all_w_t_and_m_t":"sl-PRS-Bandwidth","paragraph_zero_based":3077},{"literal_text_all_w_t_and_m_t":"Indicates the desired bandwidth of the requested SL-PRS resources provided by upper layers (see TS 38.355 [77]) in the unit of MHz.","paragraph_zero_based":3078},{"literal_text_all_w_t_and_m_t":"sl-PRS-DelayBudget","paragraph_zero_based":3079},{"literal_text_all_w_t_and_m_t":"Indicates the SL-PRS delay budget provided by upper layers (see TS 38.355 [77]).","paragraph_zero_based":3080},{"literal_text_all_w_t_and_m_t":"sl-PRS-Periodicity","paragraph_zero_based":3081},{"literal_text_all_w_t_and_m_t":"Indicates the periodicity of SL-PRS transmission.","paragraph_zero_based":3082},{"literal_text_all_w_t_and_m_t":"sl-PRS-Priority","paragraph_zero_based":3083},{"literal_text_all_w_t_and_m_t":"Indicates the priority of SL-PRS provided by upper layers (see TS 38.355 [77]). Value 1 is the highest priority whereas value 8 is the lowest priority.","paragraph_zero_based":3084},{"literal_text_all_w_t_and_m_t":"sl-UE-AssistanceInformationNR","paragraph_zero_based":3085},{"literal_text_all_w_t_and_m_t":"Indicates the traffic characteristic of sidelink logical channel(s), specified in the IE SL-TrafficPatternInfo, that are setup for NR sidelink communication.","paragraph_zero_based":3086},{"literal_text_all_w_t_and_m_t":"slotOffset","paragraph_zero_based":3087},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred slot offset to resolve the IDC problem, in multiples of 1/32 ms.","paragraph_zero_based":3088},{"literal_text_all_w_t_and_m_t":"startOffset","paragraph_zero_based":3089},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred start offset to resolve the IDC problem, in multiples of 1 ms.","paragraph_zero_based":3090},{"literal_text_all_w_t_and_m_t":"type1","paragraph_zero_based":3091},{"literal_text_all_w_t_and_m_t":"Indicates the preferred amount of increment/decrement to the long DRX cycle length with respect to the current configuration. Value in number of milliseconds. Value ms40 corresponds to 40 milliseconds, msMinus40 corresponds to -40 milliseconds and so on.","paragraph_zero_based":3092},{"literal_text_all_w_t_and_m_t":"ul-GapFR2-PatternPreference","paragraph_zero_based":3093},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on FR2 UL gap pattern as defined in TS 38.133 [14].","paragraph_zero_based":3094},{"literal_text_all_w_t_and_m_t":"victimSystemType","paragraph_zero_based":3095}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["6c972621a181152bdc0f7dccd90832e717662537ba1da4ccc52ee1a0e1ea7fc9","ff547a2ca2f74a705d896efb426faf65e1cf4fd3d1764e918d9df78c2840229a","c12fb8bb720154ae44b7d86c5db4c20564e4065b58621a459975ff7699e9b011","bc262a604a664d58ed2d1dbe2966f9cb76c45933a4a410c89309ff919f60f6f0","b135a1bd41e06c9371cbd3437c62b2feddb2149cf1bd51d56d5989f3fb55883d","8b20fd140aa8a6b5c915403d7bd34b7b419fde2905a9257e157804e01efcb3fb","a0db71abe48c6b6add6d742abf900a0118c63bb091cb1f4c3f36bc27f5e9103f","33cff6b939a79d5c63b890f60c0abdf40fa890b785334810435a0691505e75f7","3d21ac5a9c861cb276c24de196cbc1a6d29aed677bcd3c4eee748d38dc6a65d3","306c178e9be5e2c52d4f40623c87adca927fe0b0e91c44982ffb7343d181218a","ca09396a488e47331f3ccd3fdf6d90e76f90cb5161a1698d0dbd0aa6627bd5e5","d4b59ef1428ffc2a226cf9710557587b96cebc224c7d6447edfcb1ff6025c576","21cabcc0cca41aae7dfd84aed584121a6b61b0a58b0f970d73a16e19d4db1427","01810d47c8e2602439a48107e05ae28abeb05005bca0b9b59139a3d5a2c5dbd9","33e52673c417d49780dd558b78cdf30f1681bb46d1d51a9211217b50e30e802e","93d1f4ed12f4d000979e892bead7223d0ab0cf29ee781263f8861a67612f1a62","57b3e7a8e43734cca7ffb843af7176f93b81b578bb32bc23aac011e7cf2ad7ae","3f03d13657d6b7d36fa6ce668ae91b5c537e96d453b872766cba51ac3eedeb5a","076483f9885b08c59670a0f3c256541252b03ba6b38f934e8227810d13683132","1e687b448f85dd804f403a7d559e951b2363ef52e9ff037720c1f25b5da7725d","34cd1f56e8314af179550f52a3f7a052e5b205aad24cf26260ecb2dfbbe4e6a5","b5d3154ac357f065c06673771222fed99cdaa46d250b5d235000b7a9f688af30","d4fddd632cae51f5a584052889996570a2f67cbe0380f36ab2336ef40c8ea7dd","03db219817bab4e8de352c9f6f65510fc21c2675a50337c74d14961d076eff6b"],"paragraph_range_zero_based":[3072,3095],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx:p3072"}
{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicate the list of victim system types to which IDC interference is caused from NR. Value gps, glonass, bds, galileo and navIC indicates the type of GNSS. Value wlan indicates WLAN and value bluetooth indicates Bluetooth. Value uwb indicates Ultra Wide Band.","paragraph_zero_based":3096},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3097},{"literal_text_all_w_t_and_m_t":"NOTE 1:The field may also indicate the UE's preference on reduced configuration corresponding to the maximum number of SRS ports (i.e. nrofSRS-Ports) of each serving cell operating on the associated frequency range.","paragraph_zero_based":3098},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3099},{"literal_text_all_w_t_and_m_t":"SL-TrafficPatternInfo field descriptions","paragraph_zero_based":3100},{"literal_text_all_w_t_and_m_t":"messageSize","paragraph_zero_based":3101},{"literal_text_all_w_t_and_m_t":"Indicates the maximum TB size based on the observed traffic pattern. The value refers to the index of TS 38.321 [3], table 6.1.3.1-2.","paragraph_zero_based":3102},{"literal_text_all_w_t_and_m_t":"timingOffset","paragraph_zero_based":3103},{"literal_text_all_w_t_and_m_t":"This field indicates the estimated timing for a packet arrival in a sidelink logical channel. Specifically, the value indicates the timing offset with respect to subframe#0 of SFN#0 in milliseconds.","paragraph_zero_based":3104},{"literal_text_all_w_t_and_m_t":"trafficPeriodicity","paragraph_zero_based":3105},{"literal_text_all_w_t_and_m_t":"This field indicates the estimated data arrival periodicity in a sidelink logical channel. Value ms20 corresponds to 20 ms, ms50 corresponds to 50 ms and so on.","paragraph_zero_based":3106},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3107},{"literal_text_all_w_t_and_m_t":"UL-TrafficInfo field descriptions","paragraph_zero_based":3108},{"literal_text_all_w_t_and_m_t":"burstArrivalTime","paragraph_zero_based":3109},{"literal_text_all_w_t_and_m_t":"Indicates the expected arrival time of the first packet of the Data Burst for the concerned QoS flow. If the UE provides both burstArrivalTime and jitterRange, burstArrivalTime is used as a reference time for the indicated jitter range.","paragraph_zero_based":3110},{"literal_text_all_w_t_and_m_t":"If burstArrivalTime is indicated as referenceTime, the indicated time in 10ns unit from the origin is refDays*86400*1000*100000 + refSeconds*1000*100000 + refMilliSeconds*100000 + refTenNanoSeconds. The refDays field specifies the sequential number of days (with day count starting at 0) from 00:00:00 on Gregorian calendar date 6 January, 1980 (start of GPS time).","paragraph_zero_based":3111},{"literal_text_all_w_t_and_m_t":"If burstArrivalTime is indicated as referenceSFN-AndSlot, it refers to the UL timing of the closest SFN and slot of the PCell with the indicated number.","paragraph_zero_based":3112},{"literal_text_all_w_t_and_m_t":"jitterRange","paragraph_zero_based":3113},{"literal_text_all_w_t_and_m_t":"Indicates the maximum deviation of the arrival time of the first packet of a Data Burst compared to the time indicated with burstArrivalTime and the periodicity of the Data Bursts. lowerBound indicates the negative deviation while upperBound indicates the positive deviation. This field shall only be reported together with the burstArrivalTime or after the burstArrivalTime has been already reported. Value ms0 corresponds to 0 ms, value 0dot5 to 0.5 ms, value ms1 to 1 ms and so on. Value beyondMs7 indicates the jitter bound is higher than 7 ms. Value 0 ms means there is no Data Burst arrival time deviation from the indicated burstArrivalTime.","paragraph_zero_based":3114},{"literal_text_all_w_t_and_m_t":"pdu-SetIdentification","paragraph_zero_based":3115},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE is able to identify PDU Set(s) for the QoS flow. If set to true, the UE is able to identify PDU Set(s) for the associated QoS flow, otherwise, the UE is not able to do so. Before receiving this indication, the network assumes the value is set to false.","paragraph_zero_based":3116},{"literal_text_all_w_t_and_m_t":"psi-Identification","paragraph_zero_based":3117},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE is able to identify PSI(s) for the QoS flow. This field shall only be set to true if pdu-SetIdentification is also set to true (or was set to true previously for the same QoS flow). If set to true, the UE is able to identify PSI(s) for the associated QoS flow, otherwise, the UE is not able to do so. Before receiving this indication, the network assumes the value is set to false.","paragraph_zero_based":3118},{"literal_text_all_w_t_and_m_t":"qfi","paragraph_zero_based":3119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["71f333a6a68bfe0e167389cba60e7448247d459c8b08e4374998fad3b480bfa5","5d7144ddaf085bf48763ddfdb3a1f001dd93ea0c8608982e4e30e57787f5b8b9","6a0353b6d9b1caf3c8adc2b6a8d18392f337821601180ff49f89e58093602392","f6a0abc82a9c29709b7beb4b910662cad17a90d61acc0523d13d84de229d143a","fe9cde63369cd7dadc4e8a8dbf5076ad1c79b77c9e42ee2e5ab8148958bc9444","c8fa00df9abccc8d43a25941fd84b97ad4cc60ae7111137504054f864ff24e5b","e000b88cc281f25fc2e0e5dd1d1213f836238e77bc4cfc4b2c2512a14c64425c","d63cbf40516407bf07bc76a35551b846fbc48bd730672603c497230f2bca66a2","89b21fda1d9b7f2640d0cb2a8cc53985e6b7f374d76ac776aa1ebb50cff2b6b0","d0df95ad3ee5b43a7814049b717eeb44d495a1355688c422ddfa81ff34944d63","57a0348f4b6e6903fdd