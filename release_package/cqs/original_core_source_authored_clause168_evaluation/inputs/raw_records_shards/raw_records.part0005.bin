{"fields":{"filename":"R2-2408369.zip::R2-2408369.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":408},{"literal_text_all_w_t_and_m_t":"CellAccessRelatedInfo   ::=         SEQUENCE {","paragraph_zero_based":409},{"literal_text_all_w_t_and_m_t":"    plmn-IdentityInfoList               PLMN-IdentityInfoList,","paragraph_zero_based":410},{"literal_text_all_w_t_and_m_t":"    cellReservedForOtherUse             ENUMERATED {true}             OPTIONAL,   -- Need R","paragraph_zero_based":411},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":412},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":413},{"literal_text_all_w_t_and_m_t":"    cellReservedForFutureUse-r16        ENUMERATED {true}             OPTIONAL,   -- Need R","paragraph_zero_based":414},{"literal_text_all_w_t_and_m_t":"    npn-IdentityInfoList-r16            NPN-IdentityInfoList-r16      OPTIONAL    -- Need R","paragraph_zero_based":415},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":416},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":417},{"literal_text_all_w_t_and_m_t":"    snpn-AccessInfoList-r17             SEQUENCE (SIZE (1..maxNPN-r16)) OF SNPN-AccessInfo-r17    OPTIONAL    -- Need R","paragraph_zero_based":418},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":419},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":420},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":421},{"literal_text_all_w_t_and_m_t":"SNPN-AccessInfo-r17 ::=         SEQUENCE {","paragraph_zero_based":422},{"literal_text_all_w_t_and_m_t":"    extCH-Supported-r17                 ENUMERATED {true}             OPTIONAL,   -- Need R","paragraph_zero_based":423},{"literal_text_all_w_t_and_m_t":"    extCH-WithoutConfigAllowed-r17      ENUMERATED {true}             OPTIONAL,   -- Need R","paragraph_zero_based":424},{"literal_text_all_w_t_and_m_t":"    onboardingEnabled-r17               ENUMERATED {true}             OPTIONAL,   -- Need R","paragraph_zero_based":425},{"literal_text_all_w_t_and_m_t":"    imsEmergencySupportForSNPN-r17      ENUMERATED {true}             OPTIONAL    -- Need R","paragraph_zero_based":426},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":427},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":428},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLACCESSRELATEDINFO-STOP","paragraph_zero_based":429},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":430},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":431}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"d66ee83a11e596eb14b64f5886ad9a1363953496b37c5b7ad109af3e6b319447","original_member_sha256":"c496036bf0449256be5ad57c73f5bba9639937fda10ca8d81b5a96b75aefbfc7","paragraph_ElementTree_utf8_XML_sha256":["c584f2eb40e85bf7e8f54c647085b311c717bb887bdd5309b2cc04d0c75e318a","90f735f86f77eb578102632a1d4ab6592c9b7766fb58211191ed3a6afe47ff6e","65b12d652852abd81703783180bd283f2be9467930e3a5c44d256460b11841c8","d186af367213b177b494161d1fcc10c979bfe5f357ccaf9ce7ef1808b44b0298","863ca6fb86a083c2d173b387e5d7b4fdea1add65787d1f30837021da62de9d40","80fd4e5ac49437432574d53588d615d2f36ac5a3dceabf5d53965ae07e04c21a","05be0d6aa29fcaa3dd5fc2529722c7c5d8ded502921cd3e948dcded75fc0e4bb","badb5f328826abe2aa771e185983dac3a0c741d5698eab7240389b7fa326ae7c","eb86f3f9e70a44cb34dfea2ef9852bbea676d3919126e030c6c776090dd996fa","ee5141baa08210c9a715622e59c1b28204903211afcde949c344a79c5d0901bb","154619fe4cd17cb41037279d9e1054397c5242eaefa58a9e7d22946ee89168b2","733a23701acb23210b12e4c02ba43fae89852e87f358c9a146921895c0c5a0c1","cf1ca360e97dd6b2198550e60c7a6d9e3cfbf27dfcca5f190c7436774bc03ff5","2a27c7eb9ccc7224e95b397af2d5351839896b9945467fec4cb76d6940d77772","8aad66fea7e675b0ee3d5f172cab18753458dffd66f9cc0df917196171ce12ba","151658e1e38c5bc614a890bfe801fe1eb57426e16880a0c215d07f35ed0672f4","a0f01d8cebbd8bb27950ab8c6137bb143fd75d28e864712375d2e72adfb4f227","e150ca62aa31213cd2c6b3491c0e9350ed6d5c9545d6322e7f2fb62378fd8eb4","ff4ce3fd815af383f4c0e6006d37c5eb1ff0ca76ab78f91d48244f72dc31081f","2e9875855ae661314781631bc9ebbab809f6ec95f1b18c734334f72e7460ea90","6d838a558f120e3701a5346eec2807ac5643d9756aac9a06bf5b4b9ca61dd214","533bbc1350206e7b364593428bf0daf2f91fec058b890674d53d89c85d8f9a8c","4d49d541a5a3142a035ccc65c509c25708440eb0ed6dedbdaee2de45ba8ae8ca","c3c90760f5e9d3819ca48f6220616f2a52c17bfb3f53751402e4991fab35e398"],"paragraph_range_zero_based":[408,431],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2408369.zip::R2-2408369.docx:p408"}
{"fields":{"filename":"R2-2408369.zip::R2-2408369.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"CellAccessRelatedInfo field descriptions","paragraph_zero_based":432},{"literal_text_all_w_t_and_m_t":"cellReservedForFutureUse","paragraph_zero_based":433},{"literal_text_all_w_t_and_m_t":"Indicates whether the cell is reserved, as defined in 38.304 [20] for future use. The field is applicable to all PLMNs and NPNs.","paragraph_zero_based":434},{"literal_text_all_w_t_and_m_t":"cellReservedForOtherUse","paragraph_zero_based":435},{"literal_text_all_w_t_and_m_t":"Indicates whether the cell is reserved, as defined in 38.304 [20]. The field is applicable to all PLMNs.","paragraph_zero_based":436},{"literal_text_all_w_t_and_m_t":"npn-IdentityInfoList","paragraph_zero_based":437},{"literal_text_all_w_t_and_m_t":"The npn-IdentityInfoList is used to configure a set of NPN-IdentityInfo elements. Each of those elements contains a list of one or more NPN Identities and additional information associated with those NPNs. The total number of PLMNs (identified by a PLMN identity in plmn -IdentityList), PNI-NPNs (identified by a PLMN identity and a CAG-ID), and SNPNs (identified by a PLMN identity and a NID) together in the PLMN-IdentityInfoList and NPN-IdentityInfoList does not exceed 12, except for the NPN-only cells. A PNI-NPN and SNPN can be included only once, and in only one entry of the NPN-IdentityInfoList. In case of NPN-only cells the PLMN-IdentityList contains a single element that does not count to the limit of 12 and the cellIdentity of the first entry of the PLMN-IdentityInfoList is set to the same value as the cellIdentity-r16 of the first entry of the NPN-IdentityInfoList. The NPN index is defined as B+c1+c2+…+c(n-1)+d1+d2+…+d(m-1)+e(i) for the NPN identity included in the n-th entry of NPN-IdentityInfoList and in the m-th entry of npn-Identitylist within that NPN-IdentityInfoList entry, and the i-th entry of its corresponding NPN-Identity, where","paragraph_zero_based":438},{"literal_text_all_w_t_and_m_t":"- B is the index used for the last PLMN in the PLMN-IdentittyInfoList; in NPN-only cells B is considered 0;","paragraph_zero_based":439},{"literal_text_all_w_t_and_m_t":"- c(j) is the number of NPN index values used in the j-th NPN-IdentityInfoList entry;","paragraph_zero_based":440},{"literal_text_all_w_t_and_m_t":"- d(k) is the number of NPN index values used in the k-th npn-IdentityList entry within the n-th NPN-IdentityInfoList entry;","paragraph_zero_based":441},{"literal_text_all_w_t_and_m_t":"- e(i) is","paragraph_zero_based":442},{"literal_text_all_w_t_and_m_t":"    - i if the n-th entry of NPN-IdentityInfoList entry is for SNPN(s);","paragraph_zero_based":443},{"literal_text_all_w_t_and_m_t":"    - 1 if the n-th entry of NPN-IdentityInfoList entry is for PNI-NPN(s).","paragraph_zero_based":444},{"literal_text_all_w_t_and_m_t":"plmn-IdentityInfoList","paragraph_zero_based":445},{"literal_text_all_w_t_and_m_t":"The plmn-IdentityInfoList is used to configure a set of PLMN-IdentityInfo elements. Each of those elements contains a list of one or more PLMN Identities and additional information associated with those PLMNs. A PLMN-identity can be included only once, and in only one entry of the PLMN-IdentityInfoList. The PLMN index is defined as b1+b2+…+b(n-1)+i for the PLMN included at the n-th entry of PLMN-IdentityInfoList and the i-th entry of its corresponding PLMN-IdentityInfo, where b(j) is the number of PLMN-Identity entries in each PLMN-IdentityInfo, respectively.","paragraph_zero_based":446},{"literal_text_all_w_t_and_m_t":"snpn-AccessInfoList","paragraph_zero_based":447},{"literal_text_all_w_t_and_m_t":"This list provides access related information for each SNPN in npn-IdentityInfoList, see TS 23.501 [32]. The n-th entry of the list contains the access related information of the n-th SNPN in npn-IdentityInfoList. ","paragraph_zero_based":448},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":449},{"literal_text_all_w_t_and_m_t":"SNPN-AccessInfo field descriptions","paragraph_zero_based":450},{"literal_text_all_w_t_and_m_t":"extCH-Supported","paragraph_zero_based":451},{"literal_text_all_w_t_and_m_t":"Indicates whether the SNPN supports access using credentials from a Credentials Holder as specified in TS 23.501 [32].","paragraph_zero_based":452},{"literal_text_all_w_t_and_m_t":"extCH-WithoutConfigAllowed","paragraph_zero_based":453},{"literal_text_all_w_t_and_m_t":"Indicates whether the SNPN allows registration attempts with credentials from a Credentials Holder from UEs that are not explicitly configured to select the SNPN as specified in TS 23.501 [32].","paragraph_zero_based":454},{"literal_text_all_w_t_and_m_t":"imsEmergencySupportForSNPN","paragraph_zero_based":455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"d66ee83a11e596eb14b64f5886ad9a1363953496b37c5b7ad109af3e6b319447","original_member_sha256":"c496036bf0449256be5ad57c73f5bba9639937fda10ca8d81b5a96b75aefbfc7","paragraph_ElementTree_utf8_XML_sha256":["ab151a85bb40ebe419c626d83a38085721d9a5ae85a487d42219b19b264a1d42","be957ade44e09ed89d926b54c2362657d7c9b7deb45941bbb6f97cd9fa877d10","c735095908f495cf6d41e380faca6a21eb2fd90a412d349db26778aeb4806ac7","8ce4bd729ff4638dfa64ff62f3c40c58bfa9b546b2438b59a42f4003db8b4c25","4a417d1dcaeee7b3813a39a614be7d5f4b334d631e821807df833232c1f9a0e7","df47baf071c092402db4c1985c6514fc6815f6d78f84ce3d68a7f7d0e3abdc79","25f8d9dd049b162c91d4656eab4ac39fa06dfd90d149f40e6ff863e726f2df16","3226eee84bc5f299703cc71e885452efc2162c771d833f9cc7a4e24100602acf","21dc39c1a52128ff36d0cc00c377d9f2ed78c8236a000ca2de576656a6576a2b","69e4d96c08360d2a1177d63c0b2b3f57f2dcff990ee8acec1cfeb3d1c8b92abb","6b156633c67f8020b2cba4e20ee4019461634c7a94ac681722d4a16d56b4de19","a6c28b81767ec06c25306151685c85e523f9f17e093b6cf1