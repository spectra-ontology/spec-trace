-Config-r17                      MRB-PDCP-ConfigBroadcast-r17,","paragraph_zero_based":49095},{"literal_text_all_w_t_and_m_t":"    rlc-Config-r17                       MRB-RLC-ConfigBroadcast-r17,","paragraph_zero_based":49096},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":49097},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":49098},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49099},{"literal_text_all_w_t_and_m_t":"MRB-PDCP-ConfigBroadcast-r17 ::=     SEQUENCE {","paragraph_zero_based":49100},{"literal_text_all_w_t_and_m_t":"    pdcp-SN-SizeDL-r17                   ENUMERATED {len12bits}                   OPTIONAL, -- Need S","paragraph_zero_based":49101},{"literal_text_all_w_t_and_m_t":"    headerCompression-r17                CHOICE {","paragraph_zero_based":49102},{"literal_text_all_w_t_and_m_t":"        notUsed                              NULL,","paragraph_zero_based":49103}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["65c87ba6ad5d95f309553557c4094d81e5ff049419655ea2606860f6f67bf251","0f44c5c5f4eaa53618fa67aa0b65eb8101d5b2e60a124287b0eb43bcd9ab42dc","affb8f2356be17fd79c3d71cadd58be562c0acb1deca517a4d328359c60ade1e","26a49f9904a69de3665f04e6bf65d966edd470dbb792b952afbb03104a196307","681ebe55d0bbf603ed68f5c0f89e5b023398fcb62057e6484db96fc02b77f216","ad0daab695c52c3c974a434cf39b665c326be8c80bc6fbcbcafe109998bb8d56","c5d785d557226c1ad656daeb97f8f6ded332f8b48763391c701cc84b60a29111","dfba4e673bbb5878692a8ab34bad0a31ddf345d07de10fc07810879e257f980b","76278cce558fa79a26ff8b2b29904da735b53f8583d24cc14478da4fad337037","ab5fd82a6696fcbdf4319b0a4db6dded2de8132a1addd211dbcd12df6c4fd751","d231ced5cb976d1a2952a7f8387c757e334168