{"fields":{"filename":"R2-2406946.zip::R2-2406946 Miscellaneous corrections for SL relay enhancements.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"F","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Rel-18","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-17(Release 17)Rel-18(Release 18)Rel-19(Release 19) Rel-20(Release 20)","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":"Reason for change:","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"To capture the miscellaneous corrections. ","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":" In 5.3.3.1a and 5.3.13.1a, ","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"Add reception of connectionForMP as another exception for the NAS triggered RRC connection setup/resume;","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":" In other clauses, capture some editorial changes.","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"Impact analysis","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"a22ca998f923cf4a9de502434a394294d9d7b59a79b610cef677589f92cad30c","original_member_sha256":"a9c4e67b0d823294c4dc08643f433a8868c3d3e314d299ae362f3e4056cf3a8e","paragraph_ElementTree_utf8_XML_sha256":["e4ea5591218aa96d0cd407936b651eb165fb4c75e229dab64ec9de6be991cb96","2d00e3b1a82065155328ddd802c3d4a8ebff11f4a0d6da9ecf9b1e34dc8ebfc8","dd51b330e6d27e1830212d21a9d897ec4f7f145ba3f8edb22a0665dbf0770cbd","761fa4d36b282591b5f5bb5ee554c6086f6eb9d5925f257d405f142f9e3a17e1","9ee3a8ef1b4d8b5d23ae68c79878f83d9a7ffdf02ec93cff53f7b1de6029f4d6","59da8c6123d3569cd19305b9e850701dcc0d5752ee7665b64f1ba915fdabdfa4","b08252b53f111fda758564f01d6aeb287a86ceee9730eba0ca5fcf7c7dadb00e","5397ebe3cc2afa3393b897343a62f60e5b485315d8236802a715ec930f5cc336","c7f154badb51090dd578312419bcf46f1ff9111557a952165c0ca920b2e5af4d","dd3de490bf00baf5087f33777fa272abbec9623033d71526d5355fb97ee7f36f","16c8d70f7d429c511b56c375317337c5d5c75b5a185ec91bf088b77069963fb7","acd6206245de4b9556a4853ff1b8b41875944834aa76df6c7d72af763f365262","3c4c80e1e11044a4d07c2d065ab1badcf74a3b84af6435503a27154aade28f9b","15e8edfc7827db3b170f30d824378cb02ade52482ffa38712a5338b61c581860","8b24573e0133d1c5ee95e1377545628b16380b4d3d980bde5296376e8173041e","7423559940944ed0cc1fe176b76253cf9035dcdbfc0fac2f3e385feb311a2329","288cc60197c635a28716a1c3a9133085106b36b1009fb0a2849670c1b99dfd9f","8447530e8e5e1d50ad52a282435a5f04c4419d10f3ac3998db3a60d036856e9d","