{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SL-UE-SelectedConfig information element","paragraph_zero_based":48792},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":48793},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-UE-SELECTEDCONFIG-START","paragraph_zero_based":48794},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48795},{"literal_text_all_w_t_and_m_t":"SL-UE-SelectedConfig-r16 ::=                 SEQUENCE {","paragraph_zero_based":48796},{"literal_text_all_w_t_and_m_t":"    sl-PSSCH-TxConfigList-r16                    SL-PSSCH-TxConfigList-r16                                   OPTIONAL,    -- Cond SIB12","paragraph_zero_based":48797},{"literal_text_all_w_t_and_m_t":"    sl-ProbResourceKeep-r16                      ENUMERATED {v0, v0dot2, v0dot4, v0dot6, v0dot8}             OPTIONAL,    -- Need R","paragraph_zero_based":48798},{"literal_text_all_w_t_and_m_t":"    sl-ReselectAfter-r16                         ENUMERATED {n1, n2, n3, n4, n5, n6, n7, n8, n9}             OPTIONAL,    -- Need R","paragraph_zero_based":48799},{"literal_text_all_w_t_and_m_t":"    sl-CBR-CommonTxConfigList-r16                SL-CBR-CommonTxConfigList-r16                               OPTIONAL,    -- Need R","paragraph_zero_based":48800},{"literal_text_all_w_t_and_m_t":"    ul-PrioritizationThres-r16                   INTEGER (1..16)                                             OPTIONAL,    -- Need R","paragraph_zero_based":48801},{"literal_text_all_w_t_and_m_t":"    sl-PrioritizationThres-r16                   INTEGER (1..8)                                              OPTIONAL,    -- Need R","paragraph_zero_based":48802},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":48803},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":48804},{"literal_text_all_w_t_and_m_t":"    sl-CBR-CommonTxDedicatedSL-PRS-RP-List-r18  SL-CBR-CommonTxDedicatedSL-PRS-RP-List-r18                   OPTIONAL  -- Cond notSIB12","paragraph_zero_based":48805},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":48806},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":48807},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48808},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-UE-SELECTEDCONFIG-STOP","paragraph_zero_based":48809},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":48810},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48811},{"literal_text_all_w_t_and_m_t":"SL-UE-SelectedConfig field descriptions","paragraph_zero_based":48812},{"literal_text_all_w_t_and_m_t":"sl-PrioritizationThres","paragraph_zero_based":48813},{"literal_text_all_w_t_and_m_t":"Indicates the SL priority threshold, which is used to determine whether SL TX is prioritized over UL TX, as specified in TS 38.321 [3]. Network does not configure the sl-PrioritizationThres and the ul-PrioritizationThres to the UE separately.","paragraph_zero_based":48814},{"literal_text_all_w_t_and_m_t":"sl-ProbResourceKeep","paragraph_zero_based":48815}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["89c7f3ea3db414413313a85d81c5acb2291c382d1db7260d3dfc6aa0f543971d","3abdd70dcc217919ccc3b2f19c3ad81cfd0e7a4f15a1357c784c17b33d1e739a","8da49abb8f3138f168e276245dcf5b1343029ec1038d6268418a00159d2d399e","1a98e57f1834bdf8981857fafb317ea2c978281220aa89312bff5c27dee0bf8c","3c368f6df08020c78c01c7811a4509c00da7bfa181ef41c1b609d34f58676b06","2b2a70d01f5fbe21d6e1a2002c4c093ce90db93c984316d3eadc24fb54b0d209","c31258856424ae6579d61258aef572b9d2010fb9e10d09da92e38b6e93