{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":624},{"literal_text_all_w_t_and_m_t":"3>consider itself not to be configured to provide its preference on the maximum aggregated bandwidth for power saving for the cell group and stop timer T346b associated with the cell group, if running;","paragraph_zero_based":625},{"literal_text_all_w_t_and_m_t":"1>if the received otherConfig includes the maxCC-PreferenceConfig:","paragraph_zero_based":626},{"literal_text_all_w_t_and_m_t":"2>if maxCC-PreferenceConfig is set to setup:","paragraph_zero_based":627},{"literal_text_all_w_t_and_m_t":"3>consider itself to be configured to provide its preference on the maximum number of secondary component carriers for power saving for the cell group in accordance with 5.7.4;","paragraph_zero_based":628},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":629},{"literal_text_all_w_t_and_m_t":"3>consider itself not to be configured to provide its preference on the maximum number of secondary component carriers for power saving for the cell group and stop timer T346c associated with the cell group, if running;","paragraph_zero_based":630},{"literal_text_all_w_t_and_m_t":"1>if the received otherConfig includes the maxMIMO-LayerPreferenceConfig:","paragraph_zero_based":631},{"literal_text_all_w_t_and_m_t":"2>if maxMIMO-LayerPreferenceConfig is set to setup:","paragraph_zero_based":632},{"literal_text_all_w_t_and_m_t":"3>consider itself to be configured to provide its preference on the maximum number of MIMO layers for power saving for the cell group in accordance with 5.7.4;","paragraph_zero_based":633},{"literal_text_all_w_t_and_m_t":"3>if otherConfig includes maxMIMO-LayerPreferenceConfigFR2-2:","paragraph_zero_based":634},{"literal_text_all_w_t_and_m_t":"4>consider itself to be configured to provide its preference on the maximum number of MIMO layers for FR2-2 for power saving for the cell group in accordance with 5.7.4;","paragraph_zero_based":635},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":636},{"literal_text_all_w_t_and_m_t":"3>consider itself not to be configured to provide its preference on the maximum number of MIMO layers for power saving for the cell group and stop timer T346d associated with the cell group, if running;","paragraph_zero_based":637},{"literal_text_all_w_t_and_m_t":"1>if the received otherConfig includes the minSchedulingOffsetPreferenceConfig:","paragraph_zero_based":638},{"literal_text_all_w_t_and_m_t":"2>if minSchedulingOffsetPreferenceConfig is set to setup:","paragraph_zero_based":639},{"literal_text_all_w_t_and_m_t":"3>consider itself to be configured to provide its preference on the minimum scheduling offset for cross-slot scheduling for power saving for the cell group in accordance with 5.7.4;","paragraph_zero_based":640},{"literal_text_all_w_t_and_m_t":"3>if otherConfig includes minSchedulingOffsetPreferenceConfigExt:","paragraph_zero_based":641},{"literal_text_all_w_t_and_m_t":"4>consider itself to be configured to provide its preference on the minimum scheduling offset for 480 kHz SCS and/or 960 kHz SCS for cross-slot scheduling for power saving for the cell group in accordance with 5.7.4;","paragraph_zero_based":642},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":643},{"literal_text_all_w_t_and_m_t":"3>consider itself not to be configured to provide its preference on the minimum scheduling offset for cross-slot scheduling for power saving for the cell group and stop timer T346e associated with the cell group, if running;","paragraph_zero_based":644},{"literal_text_all_w_t_and_m_t":"1>if the received otherConfig includes the releasePreferenceConfig:","paragraph_zero_based":645},{"literal_text_all_w_t_and_m_t":"2>if releasePreferenceConfig is set to setup:","paragraph_zero_based":646},{"literal_text_all_w_t_and_m_t":"3>consider itself to be configured to provide assistance information to transition out of RRC_CONNECTED in accordance with 5.7.4;","paragraph_zero_based":647}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["e1420f3282359dfb666bbab257a9b66127fe5ee14c714d629631951b0b12f4a1","670c7765b39b468811c3f5b757f0c3f5f3aa46df2eb803a4f8f0304f41d9b7f0","43c851ff4ef2fec23256c336f0de18faabe3f8059ade8f7799d01a3983b5b1dc","4169a5eca13523fb3547f2c9924b988cc1e0426d3095f607d4e1d53970549b13","5c687c6c6964894f6f481d3214f69d7b604b8c6468fe9dd94911204c9a9d134c","0641a2612dd3df1564d14e6a1f1f3cf6a07a303842d60027674d87ad803fd387","36d9d9440a740afdfca3398380d08f4be8df67505d92293ad95a305d1d13ff0b","0274ce9a8b3058c1fe1dc79cf883d3b18d275d5eaad9a89c6a608e110a4f8441","c295399dc81f3410b14019ef8f06e8d8706efd5f490fec7061f29d4e65a59028","486c4fcff24fde8a4757905fe75464ca1a36a53e16a96ca0e98bcbcdb0d87bca","4d4f1c2bae1cd93795dbe1522968a3f7b2988a276236d0d14d953d34442cc9b8","a802876c8b7c9a5b07762db51aa755cdc0aa3a3606c37dfc425f9bf9923ef2fd","a375f9238edd31eaf26ba5efcf4c1a4324ddc2553374904de989b52f9b97d6f3","b43a28ac75035c1190bc5a1754e37a2dfa72ea8fa0f6d63cdc53cdf9abf89621","2778d3845959eeec6739d58cefc909c4f5e694468730d0e0358a31b803062636","e57ccfd72c467b4b5e86f285e921858e5055c1b3932dd81a4454edb3280fe57f","589c87c0f6e0f700b6766cafb424f51f31894448922dde1760bf9acb3dd35c7d","05de93ed071f9613c8e7aeb36795c9d8214b72fb4003943031de420a0756a8d2","54e5d205fb4bb311d996f6c1f4a769e26c7f2dd9eda523962f2449dffa0d5ccb","c1eefee566ea3f14698a6ddb86d7743c744cc2591813eb040845e5f0786060ae","07d515338c2a7e334915e780edad5cafe8f66bce1729f9d17538ac5a4cb80e44","ed79593e9a4960de96fb0c5c717fbc408de89f17dfd555cea4b91e1369642a2a","b49f2220e4bff9cb5abc680103521b1d22aa3dbffd02750ccb88733563626a08","2b201be2e267f992b480b09aa3a9c2466b90e5b7778c2d1b3872f4868c8bff8d"],"paragraph_range_zero_based":[624,647],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx:p624"}
{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":648},{"literal_text_all_w_t_and_m_t":"3>consider itself not to be configured to provide assistance information to transition out of RRC_CONNECTED and stop timer T346f, if running.","paragraph_zero_based":649},{"literal_text_all_w_t_and_m_t":"1>if the received otherConfig includes the lpwus-OffsetPreferenceConfig:","paragraph_zero_based":650},{"literal_text_all_w_t_and_m_t":"2>if lpwus-OffsetPreferenceConfig is set to setup:","paragraph_zero_based":651},{"literal_text_all_w_t_and_m_t":"3>consider itself to be configured to provide its preference on time offset for LP-WUS monitoring in accordance with 5.7.4;","paragraph_zero_based":652},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":653},{"literal_text_all_w_t_and_m_t":"3>consider itself not to be configured to provide its preference on time offset for LP-WUS monitoring and stop timer T346p, if running;","paragraph_zero_based":654},{"literal_text_all_w_t_and_m_t":"1>if the received otherConfig includes the obtainCommonLocation:","paragraph_zero_based":655},{"literal_text_all_w_t_and_m_t":"2>include available detailed location information for any subsequent measurement report or any subsequent RLF report, SCGFailureInformation, successful handover report, and successful PSCell change or addition report (if received for the associated cell group);","paragraph_zero_based":656},{"literal_text_all_w_t_and_m_t":"NOTE 1:The UE is requested to attempt to have valid detailed location information available whenever sending a measurement report for which it is configured to include available detailed location information. The UE may not succeed e.g. because the user manually disabled the GPS hardware, due to no/poor satellite coverage. Further details, e.g. regarding when to activate GNSS, are up to UE implementation.","paragraph_zero_based":657},{"literal_text_all_w_t_and_m_t":"1>if the received otherConfig includes the btNameList:","paragraph_zero_based":658},{"literal_text_all_w_t_and_m_t":"2>if btNameList is set to setup, include available Bluetooth measurement results for any subsequent measurement report or any subsequent RLF report and SCGFailureInformation;","paragraph_zero_based":659},{"literal_text_all_w_t_and_m_t":"1>if the received otherConfig includes the wlanNameList:","paragraph_zero_based":660},{"literal_text_all_w_t_and_m_t":"2>if wlanNameList is set to setup, include available WLAN measurement results for any subsequent measurement report or any subsequent RLF report and SCGFailureInformation;","paragraph_zero_based":661},{"literal_text_all_w_t_and_m_t":"1>if the received otherConfig includes the sensorNameList:","paragraph_zero_based":662},{"literal_text_all_w_t_and_m_t":"2>if sensorNameList is set to setup, include available Sensor measurement results for any subsequent measurement report or any subsequent RLF report and SCGFailureInformation;","paragraph_zero_based":663},{"literal_text_all_w_t_and_m_t":"NOTE 2:The UE is requested to attempt to have valid Bluetooth measurements, WLAN measurements and Sensor measurements whenever sending a measurement report for which it is configured to include these measurements. The UE may not succeed e.g. because the user manually disabled the WLAN or Bluetooth or Sensor hardware. Further details, e.g. regarding when to activate WLAN or Bluetooth or Sensor, are up to UE implementation.","paragraph_zero_based":664},{"literal_text_all_w_t_and_m_t":"1>if the received otherConfig includes the sl-AssistanceConfigNR:","paragraph_zero_based":665},{"literal_text_all_w_t_and_m_t":"2>consider itself to be configured to provide configured grant assistance information for NR sidelink communication in accordance with 5.7.4;","paragraph_zero_based":666},{"literal_text_all_w_t_and_m_t":"1>if the received otherConfig includes the assisted-SSB-MTC-Config:","paragraph_zero_based":667},{"literal_text_all_w_t_and_m_t":"2>if the assisted-SSB-MTC-Config is set to setup:","paragraph_zero_based":668},{"literal_text_all_w_t_and_m_t":"3>consider itself to be configured to provide location information for assisted SMTC configuration in RRC_CONNECTED state in accordance with 5.7.4;","paragraph_zero_based":669},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":670},{"literal_text_all_w_t_and_m_t":"3>consider itself not to be configured to provide location information for assisted SMTC configuration in RRC_CONNECTED state;","paragraph_zero_based":671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["8c73b8c674df739116c669d365ac0a3a244bf3913eb635d53c6819b3cef0ccbf","e587220034f1b994780e224c75ecc70c7fe9bacd1a2b512ef22e8b5e50569ed3","96c9417e64c999b7e4aa408fc7182817b1b1b20bb3ea05b205e0c66ff76cb63e","70e5d4798afc6156476f634d4b03653ec192f1d810df2d089a52b8ce234ece65","9f989efa933aaa84fe35386dab3112648e88d606f6841ba136e076179ae4256f","3e800401642c666bbb7d7a1e4b9d7c56d93fa9270a098c8760a1c1357f17a6dd","5c6db02cc3e856c3b026bd294d7e6001ba59cb3445b04c92f387f1a7b020f080","78b22109dd33ef280e61be179ae53099a82cc91b00a4d8a4532fda4553e3065f","94006b845bd491d3ba6b57fba929ea9712eadd2432eaf35e92e5b86bb04b8f6e","086a623ce5ee8713ba56d7b83da65ede58684c26e639e3e391421ce0a849a2ad","0ab3364ad1e523a53b618cde858b6dbd4905cf4faeaf4aa2ae5655ae0778c20a","0a6a2cd276d70d655d1a068307fedf7f6eb5008c0922b04e095e2b0137ff4648","b6f68d5a903a1942cbff6858e4bf324aaf7f271ff9d6cebfce23391606277dae","615a462a2748b4cfe618051b0e1f24566197b4239942b7b9c21411fb2a35a1da","a429362042b07034d46beacfd249f7e24188928e55e0f62ab14c33fe9a50c312","4445344317bcdf8507f3b814b53d232f20d50025f3773c5f444c9bf883671f9e","c0005e1fcb7113736c91ae38bd5db70e45f295787f59379ce5e248242db60401","684a2d220e839b05eb898785c3f50a558b433587a91fa51980c6a2acfadc3b33","99172d25e5d11af37a4fcf20b10523b1ef4c3275f9452bd4964de44642939398","9859db1aec331d5905604ff3324ded58e8ee84d2c2f4b58a034b99a0d1298653","2d7105431e9bd797b3f2ef8d0590b9486e2d54f2f5275bcfd8965d3c47bc8b53","d1b6e6708e906282462ed3167abd5ee792ee387f277df363454953e01b55df15","7d0ae8283ff45e022d5a72cee2ecbdf0914946c4a5046d6aba1c4e1a700e3e60","37aefda857ef6da753141510b801fe9fc2eb0d6bd9874ec15d3b2f21e8e8638b"],"paragraph_range_zero_based":[648,671],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx:p648"}
{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>if the received otherConfig includes the referenceTimePreferenceReporting:","paragraph_zero_based":672},{"literal_text_all_w_t_and_m_t":"2>consider itself to be configured to provide UE reference time assistance information in accordance with 5.7.4;","paragraph_zero_based":673},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":674},{"literal_text_all_w_t_and_m_t":"2>consider itself not to be configured to provide UE reference time assistance information;","paragraph_zero_based":675},{"literal_text_all_w_t_and_m_t":"1>if successHO-Config is set to setup:","paragraph_zero_based":676},{"literal_text_all_w_t_and_m_t":"2>consider itself to be configured to provide the successful handover information in accordance with 5.7.10.6;","paragraph_zero_based":677},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":678},{"literal_text_all_w_t_and_m_t":"2>consider itself not to be configured to provide the successful handover information.","paragraph_zero_based":679},{"literal_text_all_w_t_and_m_t":"1>if sn-initiatedPSCellChange is not included in the received otherConfig and if the successPSCell-Config in the received otherConfig is set to setup:","paragraph_zero_based":680},{"literal_text_all_w_t_and_m_t":"2>consider itself to be configured by the corresponding cell group to provide the successful PSCell change or addition information in accordance with 5.7.10.7;","paragraph_zero_based":681},{"literal_text_all_w_t_and_m_t":"1>if sn-initiatedPSCellChange is included in the received otherConfig and if the received otherConfig includes successPSCell-Config set to setup and thresholdPercentageT304-SCG is not included; or","paragraph_zero_based":682},{"literal_text_all_w_t_and_m_t":"1>if sn-initiatedPSCellChange is included in received otherConfig and successPSCell-Config is already configured for the SCG:","paragraph_zero_based":683},{"literal_text_all_w_t_and_m_t":"2>consider itself to be configured by the source PSCell to provide the successful PSCell change or addition information in accordance with 5.7.10.7;","paragraph_zero_based":684},{"literal_text_all_w_t_and_m_t":"1>if successPSCell-Config in the received otherConfig is set to setup and thresholdPercentageT304-SCG is included:","paragraph_zero_based":685},{"literal_text_all_w_t_and_m_t":"2>consider itself to be configured by the target PSCell to provide the successful PSCell change or addition information in accordance with 5.7.10.7","paragraph_zero_based":686},{"literal_text_all_w_t_and_m_t":"1>if the successPSCell-Config received in otherConfig is set to release:","paragraph_zero_based":687},{"literal_text_all_w_t_and_m_t":"2>consider itself not to be configured by the corresponding cell group to provide the successful PSCell change or addition information.","paragraph_zero_based":688},{"literal_text_all_w_t_and_m_t":"1>if the received otherConfig includes the ul-GapFR2-PreferenceConfig:","paragraph_zero_based":689},{"literal_text_all_w_t_and_m_t":"2>consider itself to be configured to provide its preference on FR2 UL gap in accordance with 5.7.4;","paragraph_zero_based":690},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":691},{"literal_text_all_w_t_and_m_t":"2>consider itself not to be configured to provide its preference on FR2 UL gap;","paragraph_zero_based":692},{"literal_text_all_w_t_and_m_t":"1>if the received otherConfig includes the musim-GapAssistanceConfig:","paragraph_zero_based":693},{"literal_text_all_w_t_and_m_t":"2>if musim-GapAssistanceConfig is set to setup:","paragraph_zero_based":694},{"literal_text_all_w_t_and_m_t":"3>consider itself to be configured to provide MUSIM assistance information for gap preference in accordance with 5.7.4;","paragraph_zero_based":695}],"source":"Whole authentic original 