{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"MBS-NeighbourCellList information element","paragraph_zero_based":48984},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":48985},{"literal_text_all_w_t_and_m_t":"-- TAG-MBS-NEIGHBOURCELLLIST-START","paragraph_zero_based":48986},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48987},{"literal_text_all_w_t_and_m_t":"MBS-NeighbourCellList-r17 ::=     SEQUENCE (SIZE (0..maxNeighCellMBS-r17)) OF MBS-NeighbourCell-r17","paragraph_zero_based":48988},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48989},{"literal_text_all_w_t_and_m_t":"MBS-NeighbourCell-r17 ::=         SEQUENCE {","paragraph_zero_based":48990},{"literal_text_all_w_t_and_m_t":"    physCellId-r17                    PhysCellId,","paragraph_zero_based":48991},{"literal_text_all_w_t_and_m_t":"    carrierFreq-r17                   ARFCN-ValueNR                                  OPTIONAL  -- Need S","paragraph_zero_based":48992},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":48993},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48994},{"literal_text_all_w_t_and_m_t":"-- TAG-MBS-NEIGHBOURCELLLIST-STOP","paragraph_zero_based":48995},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":48996},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48997},{"literal_text_all_w_t_and_m_t":"MBS-NeighbourCellList field descriptions","paragraph_zero_based":48998},{"literal_text_all_w_t_and_m_t":"carrierFreq","paragraph_zero_based":48999},{"literal_text_all_w_t_and_m_t":"Indicates the frequency of the neighbour cell indicated by physCellId. Absence of the IE means that the neighbour cell is on the same frequency as the current cell.","paragraph_zero_based":49000},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49001},{"literal_te