{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"dmrs-ScramblingID0","paragraph_zero_based":49320},{"literal_text_all_w_t_and_m_t":"DL DMRS scrambling initialization (see TS 38.211 [16], clause 7.4.1.1.1). When the field is absent the UE applies the value physCellId configured for this serving cell.","paragraph_zero_based":49321},{"literal_text_all_w_t_and_m_t":"pdsch-AggregationFactor","paragraph_zero_based":49322},{"literal_text_all_w_t_and_m_t":"Number of repetitions for dynamic scheduling of MBS broadcast data for MTCH PDSCH (see TS 38.214 [19], clause 5.1.2.1). When the field is absent the UE applies the value 1.","paragraph_zero_based":49323},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49324},{"literal_text_all_w_t_and_m_t":"–TMGI","paragraph_zero_based":49325},{"literal_text_all_w_t_and_m_t":"The IE TMGI is used to identify the MBS session.","paragraph_zero_based":49326},{"literal_text_all_w_t_and_m_t":"TMGI information element","paragraph_zero_based":49327},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":49328},{"literal_text_all_w_t_and_m_t":"-- TAG-TMGI-START","paragraph_zero_based":49329},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49330},{"literal_text_all_w_t_and_m_t":"TMGI-r17 ::=                     SEQUENCE {","paragraph_zero_based":49331},{"literal_text_all_w_t_and_m_t":"    plmn-Id-r17                      CHOICE {","paragraph_zero_based":49332},{"literal_text_all_w_t_and_m_t":"        plmn-Index                       INTEGER (1..maxPLMN),","paragraph_zero_based":49333},{"literal_text_all_w_t_and_m_t":"        explicitValue                    PLMN-Identity","paragraph_zero_based":49334},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":49335},{"literal_text_all_w_t_and_m_t":"    serviceId-r17                    OCTET STRING (SIZE (3))","paragraph_zero_based":49336},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":49337},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49338},{"literal_text_all_w_t_and_m_t":"-- TAG-TMGI-STOP","paragraph_zero_based":49339},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":49340},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49341},{"literal_text_all_w_t_and_m_t":"TMGI field descriptions","paragraph_zero_based":49342},{"literal_text_all_w_t_and_m_t":"plmn-Index","paragraph_zero_based":49343}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["fb8b8cf69e8898813aaa7270b1f82117b0cbafddfb116955d09772a3f8251644","769c0133847081b14f5f7d653c3ddce2fd960fa71c7e0a9e1b4cac1f9121a626","5e6613ea8f4218467e8f952c6d95482d91ea5d4c3db18ee5f736bb4cc7b7a1d4","b163410c48c93a9b30ce5f21b02f345b1913fd4f9c7fc163ba49c34676f34dbe","8bf383ea02da85e5a48e4fc8d378eef0476077b213311aa3c8ba5bb2ac8fb59d","57fddabc342822a1392cd5a3040e14c9b9404fde673220c52f1109069d4b1a49","c4ace240bd45eb171e20a60da91845e12cd782b0a9d0ac80e3426949c83af466","7acbf8218f56fe1f29fbc26f82023fe9d486b96acc24236380cef29c28f58c5d","0443d55aded8ec32bcf45c338903677e6d5a0ad05ca20ea6acbbb21db3ded021","240f71881969ac9ba40cbd5c3247ff11d5f7c38df04c77b6a6176c7cf9fa8817","790eedf3dcd0c6558c00fe3e68434b53b987e84996b99b612c85df35a07eef32","dc17d72479048a922d5403506382e7935ebed1791346c0862f785fa5c1ac9ae1","e0c054bf1bcf5104b8e0d36fa20ce22e070fabaaea8178598a4d35a370ef02d7","d15574c7fa8dfdcc053cc1de5d18e7371bd3043b24575f2cff4bb92afe0c9056","69f4f51d84058197f761473f5e843bc4baf33ddb8b1901d5c5bfb62de0663d05","e6181639b4c663a3354dd55ead5d1ae204f0b8597c0f5a7cca9278c95e837b0a","8bf78519dfdffc87ed290