{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"pdsch-RepSubslot","paragraph_zero_based":4368},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports subslot PDSCH repetition. This field is only applicable for UEs supporting FDD.","paragraph_zero_based":4369},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4370},{"literal_text_all_w_t_and_m_t":"pdsch-SlotSubslotPDSCH-Decoding","paragraph_zero_based":4371},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports decoding of PDSCH and slot-PDSCH/subslot-PDSCH assigned with C-RNTI/SPS C-RNTI in the same subframe for a given carrier.","paragraph_zero_based":4372},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4373},{"literal_text_all_w_t_and_m_t":"perServingCellMeasurementGap","paragraph_zero_based":4374},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports per serving cell measurement gap indication, as specified in TS 36.133 [16].","paragraph_zero_based":4375},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4376},{"literal_text_all_w_t_and_m_t":"phy-TDD-ReConfig-FDD-PCell","paragraph_zero_based":4377},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports TDD UL/DL reconfiguration for TDD serving cell(s) via monitoring PDCCH with eIMTA-RNTI on a FDD PCell, and HARQ feedback according to UL and DL HARQ reference configurations. This bit can only be set to supported only if the UE supports FDD PCell and phy-TDD-ReConfig-TDD-PCell is set to supported.","paragraph_zero_based":4378},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":4379},{"literal_text_all_w_t_and_m_t":"phy-TDD-ReConfig-TDD-PCell","paragraph_zero_based":4380},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports TDD UL/DL reconfiguration for TDD serving cell(s) via monitoring PDCCH with eIMTA-RNTI on a TDD PCell, and HARQ feedback according to UL and DL HARQ reference configurations, and PUCCH format 3.","paragraph_zero_based":4381},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4382},{"literal_text_all_w_t_and_m_t":"pmch-Bandwidth-n40, pmch-Bandwidth-n35, pmch-Bandwidth-n30","paragraph_zero_based":4383},{"literal_text_all_w_t_and_m_t":"Indicates, for the E‑UTRA band corresponding to the entry in mbms-SupportedBandInfoList-v1700, whether the UE in RRC_CONNECTED supports MBMS reception via MBSFN from MBMS-dedicated cells in an MBSFN area with PMCH bandwidth of 40/ 35/ 30 PRBs as described in TS 36.211 [21] and TS 36.213 [23].","paragraph_zero_based":4384},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4385},{"literal_text_all_w_t_and_m_t":"pmi-Disabling","paragraph_zero_based":4386},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4387},{"literal_text_all_w_t_and_m_t":"powerClass-14dBm","paragraph_zero_based":4388},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports power class 14 dBm when operating in CE mode A or B for all the bands that are supported by the UE, as specified in TS 36.101 [42].","paragraph_zero_based":4389},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4390},{"literal_text_all_w_t_and_m_t":"powerPrefInd","paragraph_zero_based":4391}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["1ad773b43eae3a3f596989f0629da1132a5a6790fd31bba4cf7d6b97bc7c1998","82b18361b46669dd2f5938025594e9510e293275af7d9b923ae1486750e35b36","168b68d3c31bb099bc83f8df082b515bc79cad667f9fa21c07060a2b636f2f06","283f88f4a07a134482ee1d40e7d2947616402715b73c40c30e9cdffe81d4fd2d","efba03d1f41118c6a23ffed3e0413bfeab5e70ddac891a992e57f142851aad62","b1790bdc8a7742a5c3848866d7c0502e00372e3afd6eff3cd9a5fdb8cd72ed68","44cdffa824f6a3bdfb83ee71621ac7e7287151718a14ac43834693313378a0f2","5e37de855ddd657b26d57935d3551198942e85a6b71a9012371f22951dcc71d2","a8e7d3a1a86117fe91d8a7bf07603546d4ca0446490d886d7abe0c2baa7a494f","3422cc595737257738700b0bca3560b64ce212e70be844fff772ec6ad3304703","91cb72ecbd83015c16c20cd49e04abf7172693fd89145c2cc1dd047511f5fc4a","a9fb4bd5d893b8a7483be0ddba951c50e918cf7c3d324f1f98acb60a5af6bbae","906485860a89c7f1a46e8a05522d15a35e179b466b1ba7c440ec73fa9348e8f2","2fa824825c8e6b42b517c9e486903b187ee0886b3c19dcb41a93e9afd71555b0","2f430c1a900fce43b2c231c0215163376380190d20a3b490ad79c8fd4f4d2d42","28a1c399ecd6c0d53f442af058eec913f019ef6ca8af1281e6f1167d4b08c876","d8f3ac6e7ae895410d3fb55323a2c3cf93a2d0db0226637c64c8bdd2d4a9e8bc","47351e8550a24c2c9f9a171a5124a0f4db943d08c06d9844df44ff9f9a40026e","8b7b0c0099008f94410f4a1995eac550ecc63b60bbfa4b32c53c9020c35b3735","2cd2b21d534f0a26fcf794ed5078f6880dc5d7fd201f9e2446dd456eaebca721","8fa97bbe6662b64217d2230046c116d3535121eb66b4bdfabba7881542e1fffd","c7d1701624dd81c627187d9493b025d9ada46abb7d7abbd10d6227c9dabbc37c","5aeda3089a0acf6ef3ff2053b4b199d9e6d7506ec1bf3cfa63d3337069bfbc7d","a5079cea725d2acb5cd1195d94b6cd034a4fd843cd7944967dda37fcd8367cb1"],"paragraph_range_zero_based":[4368,4391],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p4368"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports power preference indication.","paragraph_zero_based":4392},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":4393},{"literal_text_all_w_t_and_m_t":"powerUCI-SlotPUSCH, powerUCI-SubslotPUSCH","paragraph_zero_based":4394},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports BPRE derivation based on the actual derived O_CQI. The parameter uplinkPower-CSIPayload configures the UE to derive BPRE based on either the actual value of O_CQI or the largest value of O_CQI across all RI values. If the UE does not support the capability, the UE will derive BPRE based on the largest value of O_CQI across all RI values.","paragraph_zero_based":4395},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4396},{"literal_text_all_w_t_and_m_t":"prach-Enhancements","paragraph_zero_based":4397},{"literal_text_all_w_t_and_m_t":"This field defines whether the UE supports random access preambles generated from restricted set type B in high speed scenoario as specified in TS 36.211 [21].","paragraph_zero_based":4398},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4399},{"literal_text_all_w_t_and_m_t":"processingTimelineSet","paragraph_zero_based":4400},{"literal_text_all_w_t_and_m_t":"Indicates, for each SPDCCH configuration, support for a set of TA values. Each set consists of two different processing timelines and associated maximum TA. Set 1 indicates support for n+4 and n+6 and set 2 indicates support for n+6 and n+8, see TS 36.211 [21], clause 8.1, The minimum processing timeline to use, out of the two options for a given set is configured by parameter proc-Timeline. Support of Set 1 implicitly means support of Set 2.","paragraph_zero_based":4401},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4402},{"literal_text_all_w_t_and_m_t":"pucch-Format4","paragraph_zero_based":4403},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports PUCCH format 4.","paragraph_zero_based":4404},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4405},{"literal_text_all_w_t_and_m_t":"pucch-Format5","paragraph_zero_based":4406},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports PUCCH format 5.","paragraph_zero_based":4407},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4408},{"literal_text_all_w_t_and_m_t":"pucch-SCell","paragraph_zero_based":4409},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports PUCCH on SCell.","paragraph_zero_based":4410},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":4411},{"literal_text_all_w_t_and_m_t":"pur-CP-EPC-CE-ModeA, pur-CP-EPC-CE-ModeB, pur-CP-5GC-CE-ModeA, pur-CP-5GC-CE-ModeB","paragraph_zero_based":4412},{"literal_text_all_w_t_and_m_t":"Indicates whether UE operating in CE mode A/B supports CP transmission using PUR when connected to EPC/ 5GC.","paragraph_zero_based":4413},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4414},{"literal_text_all_w_t_and_m_t":"pur-CP-L1Ack","paragraph_zero_based":4415}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["cc58ec33b4ba5af93b0f7f2e54065f034c1300503ae4a79656b6848a1157d5a1","c48362c340885c4a67ad112ddb1e7165984db9ac909fb75d867e95f474a226a7","e23b9e4869e25850c1771718888218f70560a5ffd611b577603271688c2c658f","584ada71270fdab058e7d97f4773a78978e1c6fca6e45db9e9d249841f8344b9","efb5360204fe8814ac8d7cbef414436c0b2da1c550f297c77f4f44eece43acff","b4cdadadfab2a15864c1c2996e8e5fe5160b0bcf8d70f9ee9e9e2bb5ba53ccc9","ae73b1b332a53be1d