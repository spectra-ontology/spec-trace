f7ed00be57002f957095338a3b757e55d4fffeea0ba2df820bd1c6","baffa9a01ab1b05a4357f5e86e29c553b0c624e17fde334a9dbf890fdcf2d42a","0ed8428d91d42fa8d8c163f61b4c47d4a34d1aef7c964f6e24104adb6d2779a1","f39e680c8471156575390507cd244ffac2fc394f14cdd486cad389a12624ceb6","a5f99847ab137caa5d6c579b873df265d368e8e9d7515d0ad7c4e61b88986e6d","66bf6d1d17a8faedce662192ec1bb97ffb0dd09281997f5ac3972d62b51bb49c","3b76ba6d5cdd148949ed026dd71c23e29025e132c812c8688f9e3cea6ce5d88e","67e1995b8b88081210165cb1760a59aaa9aa9663e4961a2f386acf3bbb3dae24","e932ad23b181648775142a7f84a6003335cd99cb799ea6c6f23962467866311b","71f6555ffe0cdbeb7e7a45ca6bfe70e689d30df93701f06ed5c224165e48ade6","fe5bd01f23b52d73fa1a2ba81823fe17b436591d78b4baec3aefcaad920679c8","267429d53d432b11f4d6e108fb64eefe5c8126494c8bbcfc4c5945c5631a8058","a5dece64c0f7fbda362422779d857ac91bc7f064f6e76f30ea8d4ecf4e962dff","07b2f79634dce87dc2a966b797d15fc5e72223c8978f837be3253a25c2226c40","8f427ef89b8a06e4c5e6ac7d6237b1f573edf586821303f843fa71e8888d1144","7a91907a7d5e4f97831cb973202e3ad44d6f9cc7429f336f5ede66e3044697c9"],"paragraph_range_zero_based":[4656,4679],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx:p4656"}
{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-REPORTCONFIG-STOP","paragraph_zero_based":4680},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":4681},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4682},{"literal_text_all_w_t_and_m_t":"Editor's Note:FFS the value range of the field timeInstanceForSGCS-r19, based on RAN1 progress.","paragraph_zero_based":4683},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4684},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4685},{"literal_text_all_w_t_and_m_t":"CSI-ReportConfig field descriptions","paragraph_zero_based":4686},{"literal_text_all_w_t_and_m_t":"associatedIdForChannelMeasurement","paragraph_zero_based":4687},{"literal_text_all_w_t_and_m_t":"Indicates the associated ID for resourcesForChannelMeasurement. This field is absent if resourcesForChannelPrediction is not configured or if resourcesForChannelMeasurement is equal to or a subset of resourcesForChannelPrediction.","paragraph_zero_based":4688},{"literal_text_all_w_t_and_m_t":"associatedIdForChannelPrediction","paragraph_zero_based":4689},{"literal_text_all_w_t_and_m_t":"Indicates the associated ID for resourcesForChannelPrediction. This field is absent if resourcesForChannelPrediction is not configured.","paragraph_zero_based":4690},{"literal_text_all_w_t_and_m_t":"carrier","paragraph_zero_based":4691},{"literal_text_all_w_t_and_m_t":"Indicates in which serving cell the CSI-ResourceConfig indicated below are to be found. If the field is absent, the resources are on the same serving cell as this report configuration.","paragraph_zero_based":4692},{"literal_text_all_w_t_and_m_t":"codebookConfig","paragraph_zero_based":4693},{"literal_text_all_w_t_and_m_t":"Codebook configuration for Type-1 or Type-2 including codebook subset restriction. Network can only configure one of codebookConfig, codebookConfig-r16, codebookConfig-r17, codebookConfig-r18 or codebookConfig-r19 in a CSI-ReportConfig. The network includes codebookConfig-v1730 only if codebookConfig-r17 is configured.","paragraph_zero_based":4694},{"literal_text_all_w_t_and_m_t":"cqi-BitsPerSubband","paragraph_zero_based":4695},{"literal_text_all_w_t_and_m_t":"This field can only be present if cqi-FormatIndicator is set to subbandCQI. If the field is configured with bits4, the UE uses 4-bit sub-band CQI. If the field is not present and cqi-FormatIndicator is set to subbandCQI, the UE uses 2-bit sub-band differential CQI.","paragraph_zero_based":4696},{"literal_text_all_w_t_and_m_t":"cqi-FormatIndicator","paragraph_zero_based":4697},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE shall report a single (wideband) or multiple (subband) CQI (see TS 38.214 [19], clause 5.2.1.4).","paragraph_zero_based":4698},{"literal_text_all_w_t_and_m_t":"cqi-Table","paragraph_zero_based":4699},{"literal_text_all_w_t_and_m_t":"Which CQI table to use for CQI calculation (see TS 38.214 [19], clause 5.2.2.1). For an (e)RedCap UE, CQI table 2 is only supported if the UE indicates support of 256QAM for PDSCH.","paragraph_zero_based":4700},{"literal_text_all_w_t_and_m_t":"csi-IM-ResourcesForInterference","paragraph_zero_based":4701},{"literal_text_all_w_t_and_m_t":"CSI IM resources for interference measurement. csi-ResourceConfigId of a CSI-ResourceConfig included in the configuration of the serving cell indicated with the field \"carrier\" above. The CSI-ResourceConfig indicated here contains only CSI-IM resources. The bwp-Id in that CSI-ResourceConfig is the same value as the bwp-Id in the CSI-ResourceConfig indicated by resourcesForChannelMeasurement.","paragraph_zero_based":4702},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4703}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["ce265424a0432efbeab60c2897ae74012f862b25f2def345e359dd0b0df0f63d","d508da850c2164040f1f6397383567990730709c40f263a1d17a473962ed9dea","209137482bbef598bd6a3a95d10faf875a4159344d7efc4ddcc609e55ef5696c","ba1695e190c29d743a5686134ab5222227cad388acfad1e7d96d72596d3795bb","ddfb49de09f46d0e6e329407210e98fb3dca1df9bfde910d56683528383bcba5","dd91e8206f532a037a0a82e77b6227f2d04ccaba2cba6cdf5f80382d76b538f3","d8a3e8a7544f2d867c7a134697c257192d73da441d3bf5c4d75463d7f1ed8ec4","35b7f32b7064e17d043672cff7474fbbbb70207d1c8778d6cdca857d55cf6879","ba0e9a876ebbbc70ed4d9a78ab279c2dfd263cede677b9bc516ad4efc0991b48","50f5b5da8500651b8d150b1a53c54df3cf92ed63842d2e82790541d26bb486ba","9f8ebeca833d9062565074084d2f14adc2d8a3afc6b00e958defd3e0aaee34c1","64ac795da8aa5deb9c1de0967461562007c661ff37111dbec6a109e11835455b","ac51d891ba4187d53c8ea278f8194a27fb73d1f98b65889d8090ccfab00840ab","0da66326b9e0f80791402b5deb729242e82d3ba938ca1756d0689dd77f514815","1055ee762cad677b8ff894fe28c13939d62ebf30c174f2f62d247694404453b9","776bc025eb793be7e3023305b41acfe91096929a79238e0d1b544a15098b2137","1b49ce003c781a61bfacc644ee96d5ecd2648e11f347a7caa41cf5cb729cc36f","d6dee337f02aa4f8044126e6148192594b4dc9efaa56304b65a0cd8915331ee9","fcfdb2adfe0e5018869bc9c37f1e6ddca7aad15efde9f8894b286024a9d8190e","fa35750df15db7e82c9575143ab0097b18e2b1c905214dbdbc6185fe4d3e6281","2da0f00bf74691a8b3444c53f8a4a412acc4588cf7ba5dc69cf3b78f65b001cc","33a3a689ad439dd93cc5b91d31ff0a6b9203355cb6d1437786c44bcb4a4da619","ce0ffe370d7c9b28ef00b8c665ee32a2d79238c471a0a2104f4538ba6945e915","7f482e957b166e19e821402817cd474c1c8c667ae296845177191a63e579a007"],"paragraph_range_zero_based":[4680,4703],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx:p4680"}
{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4704},{"literal_text_all_w_t_and_m_t":"csi-ReportCJTC","paragraph_zero_based":4705},{"literal_text_all_w_t_and_m_t":"Configures parameters used for CJT calibration.","paragraph_zero_based":4706},{"literal_text_all_w_t_and_m_t":"csi-ReportingBand","paragraph_zero_based":4707},{"literal_text_all_w_t_and_m_t":"Indicates a contiguous or non-contiguous subset of subbands in the bandwidth part which CSI shall be reported for. Each bit in the bit-string represents one subband in order of frequency position in the BWP. The right-most bit in the bit string represents the lowest subband with the lowest frequency position in the BWP. The choice determines the number of subbands (subbands3 for 3 subbands, subbands4 for 4 subbands, and so on) (see TS 38.214 [19], clause 5.2.1.4). This field is absent if there are less than 24 PRBs (no sub band) and present otherwise (see TS 38.214 [19], clause 5.2.1.4).","paragraph_zero_based":4708},{"literal_text_all_w_t_and_m_t":"NOTE:In TS 38.212 [17] clause 6.3.1.1.2 and TS 38.214 [19] clause 5.2.1.4, only subbands to be reported are numbered, e.g. subband #0 is the subband corresponding to the right-most bit set to 1.","paragraph_zero_based":4709},{"literal_text_all_w_t_and_m_t":"csi-ReportMode","paragraph_zero_based":4710},{"literal_text_all_w_t_and_m_t":"Configures the CSI report modes Mode1 or Mode 2 (see TS 38.214 [19], clause 5.2.1.4.2)","paragraph_zero_based":4711},{"literal_text_all_w_t_and_m_t":"csi-ReportSubConfigToAddModList, csi-ReportSubConfigToAddModListExt","paragraph_zero_based":4712},{"literal_text_all_w_t_and_m_t":"List of CSI-ReportSubConfiguration(s) in a CSI report configuration to add or modify. No simultaneous configuration of portSubsetIndicator and a list of nzp-CSI-RS-resources in a same CSI report sub-configuration. The number of elements in a list is at least 2. If the network includes csi-ReportSubConfigToAddModListExt, it includes the same number of entries, and listed in the same order, as in csi-ReportSubConfigToAddModList.","paragraph_zero_based":4713},{"literal_text_all_w_t_and_m_t":"csi-ReportSubConfigToReleaseList","paragraph_zero_based":4714},{"literal_text_all_w_t_and_m_t":"List of CSI-ReportSubConfiguration(s) in a CSI report configuration to release.","paragraph_zero_based":4715},{"literal_text_all_w_t_and_m_t":"csi-ReportUE-IBR","paragraph_zero_based":4716},{"literal_text_all_w_t_and_m_t":"Configures parameters used for the UE initiated CSI reporting. When this field is configured, the UE ignores reportConfigType. When this field is set to event1, eventThreshold can only be configured with values from 14 to 113.","paragraph_zero_based":4717},{"literal_text_all_w_t_and_m_t":"dummy","paragraph_zero_based":4718},{"literal_text_all_w_t_and_m_t":"This field is not used in the specification. If received it shall be ignored by the UE.","paragraph_zero_based":4719},{"literal_text_all_w_t_and_m_t":"groupBasedBeamReporting","paragraph_zero_based":4720},{"literal_text_all_w_t_and_m_t":"Turning on/off group beam based reporting (see TS 38.214 [19], clause 5.2.1.4). If groupBasedBeamReporting (without suffix) is set to disabled, groupBasedBeamReporting-v1710 and groupBasedBeamReporting-v1800 is absent.","paragraph_zero_based":4721},{"literal_text_all_w_t_and_m_t":"linkedCJTC-Report","paragraph_zero_based":4722},{"literal_text_all_w_t_and_m_t":"This field is used in clause 5.2.1.4 in TS 38.214 [19].","paragraph_zero_based":4723},{"literal_text_all_w_t_and_m_t":"mappingToResourcesForChannelPrediction","paragraph_zero_based":4724},{"literal_text_all_w_t_and_m_t":"If configured, this field indicates the resources included in resourcesForChannelMeasurement to be used for monitoring the channel predictions in the resources resourcesForChannelPrediction included within the linked prediction report configuration indicated by refToPredictionConfig. This field indicates Y non-zero bits, where Y is the size of the resource set for monitoring in resourcesForChannelMeasurement. The x-th MSB of the bitmap corresponds to x-th resource in resourcesForChannelPrediction in the linked prediction report configuration indicated by refToPredictionConfig. The y-th nonzero bit of the bitmap corresponds to the y-th entry of associated nzp-CSI-RS-Resources or csi-SSB-ResourceList in the resourcesForChannelMeasurement set for monitoring, 1≤y≤Y. This field is mandatory present only if the size of resourcesForChannelMeasurement is smaller than the size of resourcesForChannelPrediction in the linked prediction report configuration indicated by refToPredictionConfig..","paragraph_zero_based":4725},{"literal_text_all_w_t_and_m_t":"non-PMI-PortIndication","paragraph_zero_based":4726},{"literal_text_all_w_t_and_m_t":"Port indication for RI/CQI calculation. For each CSI-RS resource in the linked ResourceConfig for channel measurement, a port indication for each rank R, indicating which R ports to use. Applicable only for non-PMI feedback (see TS 38.214 [19], clause 5.2.1.4.2).","paragraph_zero_based":4727}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["ca0547111ef8b96dbaaeff9509c32c77d3ab7ee04ab4b7d91d2bd5239643ccb7","429c21dbaa76175556f4d26c1c82fbe38e159c4de530bade514580f57f01ccdc","58e49114802db77d5cec7d2e56a78001fa3e9fb0ca35741aa1c175997db50480","ebe3324b35e250ef110378f20dbd5960e843543b5fe1719dc08c738167d5451d","dac6451fdfda111043f31f6f61b08b525f85a15aa3a627afffec8c6ac02983c8","6b46ff2ef9c80814f927fd23426d01c41f6dabe6891ccacc4dcb2782824d47da","92b0ec46cded9fe14175bc0f411c8e6ac316ecc003d732c5337062d79dbd300e","98d28705eb6f2802ffcf9f84da8ab9b49d733c16a87bda9deea49b8c48bfd1b8","70295fdbfa92b89ac0989c1864bffa382f434a24c1a1583e25aa49cc9305d4fb","7e09128c322f651a75fb8d8e134cf2b3335e37f170e08bee6623602e04358775","9a7d9d936762ee719f9964094e1ad5d1f3f81bc324d3aeaf62bfe1436c108832","6276c8578fb7f42b1064bcdb0d966df6cbbbc500b74713b5ec2da2ef3d09a41f","dba9b077d01a9472bf71c0f91ae9fcd6108b30da9a12d86a9fee8457cd953f29","7b11815c74c7c44df4d5534dced096cbffa8a6175475c0c8cb88507dc3370df3","e06f2f4fcc4bc41df242822c67b86cadee93c062df6d26c1295bf35526cdae6d","f032cec9259e7465bdb3dc71b406f6c7fe68df798bca9d83fd93c6949e2533dc","a3203c7a3d6b92aa8700003cc758c5bab71660def171f70ac30723df9ec25f09","22a150a98ebb05524beccd4698ed26ebc081a04e8a5de48f8c87aa72219e16c3","09dc8d20fbcc1e3676845383b427ce60752f7c55cce44493cf845bc397a9e106","dc89e6de0e407ed582c3fb35d666c96e43129625cc240b14878dd2ba74ad5262","f96a066d1f09fca47409dcd88bdac81b02fd7e7c5eaa165d79a9d00df72be760","467f88daa7bb5aa5fc460235dec70ae2f55d262271d300d8beb2ab4e57dd6173","d623adfe8b02a3caf9b11361e4d226fa1a7216e6e22d1215470f94330c7d75e4","965ec3828e6d08abaa4930c933b2a3e34c11bfcfa0a9f2a63532f84677ab7866"],"paragraph_range_zero_based":[4704,4727],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx:p4704"}
{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The first entry in non-PMI-PortIndication corresponds to the NZP-CSI-RS-Resource indicated by the first entry in nzp-CSI-RS-Resources in the NZP-CSI-RS-ResourceSet indicated in the first entry of nzp-CSI-RS-ResourceSetList of the CSI-ResourceConfig whose CSI-ResourceConfigId is indicated in a CSI-MeasId together with the above CSI-ReportConfigId; the second entry in non-PMI-PortIndication corresponds to the NZP-CSI-RS-Resource indicated by the second entry in nzp-CSI-RS-Resources in the NZP-CSI-RS-ResourceSet indicated in the first entry of nzp-CSI-RS-ResourceSetList of the same CSI-ResourceConfig, and so on until the NZP-CSI-RS-Resource indicated by the last entry in nzp-CSI-RS-Resources in the in the NZP-CSI-RS-ResourceSet indicated in the first entry of nzp-CSI-RS-ResourceSetList of the same CSI-ResourceConfig. Then the next entry corresponds to the NZP-CSI-RS-Resource indicated by the first entry in nzp-CSI-RS-Resources in the NZP-CSI-RS-ResourceSet indicated in the second entry of nzp-CSI-RS-ResourceSetList of the same CSI-ResourceConfig and so on.","paragraph_zero_based":4728},{"literal_text_all_w_t_and_m_t":"nrofBestBeamForMonitoring","paragraph_zero_based":4729},{"literal_text_all_w_t_and_m_t":"Indicates the number of best M beam(s) based on L1-RSRP measurements of the resource set(s) for monitoring for performance metric calculation.","paragraph_zero_based":4730},{"literal_text_all_w_t_and_m_t":"nrofReportedGroups","paragraph_zero_based":4731},{"literal_text_all_w_t_and_m_t":"Number of reported resource groups per CSI-report. Value n1 means one resource group, n2 means 2 resource groups, and so on. If nrofReportedGroups is configured, the UE ignores groupBasedBeamReporting (without suffix).","paragraph_zero_based":4732},{"literal_text_all_w_t_and_m_t":"nrofReportedPredictedRS","paragraph_zero_based":4733},{"literal_text_all_w_t_and_m_t":"Indicates the number (K) of predicted RS resources to be reported per report setting, if nrofTimeInstance is not configured. Indicates the number (K) of predicted RS resources per time instance to be reported per report setting, if nrofTimeInstance is configured. This field is present only if reportQuantity-r19 is set to p-CRI-r19, p-SSB-Index-r19, p-CRI-RSRP-r19 or p-SSB-Index-RSRP-r19.","paragraph_zero_based":4734},{"literal_text_all_w_t_and_m_t":"nrofReportedRS","paragraph_zero_based":4735},{"literal_text_all_w_t_and_m_t":"The number (N) of measured RS resources to be reported per report setting in a non-group-based report. N <= N_max, where N_max is 2, 4, 6 or 8 depending on UE capability.","paragraph_zero_based":4736},{"literal_text_all_w_t_and_m_t":"(see TS 38.214 [19], clause 5.2.1.4) When the field is absent the UE applies the value 1. Network does not configure nrofReportedRS-v1900 at the same time as nrofReportedRS (without suffix).","paragraph_zero_based":4737},{"literal_text_all_w_t_and_m_t":"nrofTimeInstance","paragraph_zero_based":4738},{"literal_text_all_w_t_and_m_t":"When reportQuantity-r19 is set to p-CRI-r19, p-SSB-Index-r19, p-CRI-RSRP-r19 or p-SSB-Index-RSRP-r19, this field indicates the number of future time instance(s) N for prediction to be reported per report setting. When reportQuantity-r19 is set to none-BM-r19, this field indicates the number of expected future time instance(s) N of prediction per report setting. This field is not configured together with other reportQuantity-r19 settings. This field is present only if timeGap is configured.","paragraph_zero_based":4739},{"literal_text_all_w_t_and_m_t":"nrofTransmissionOccasion","paragraph_zero_based":4740},{"literal_text_all_w_t_and_m_t":"Indicates the number of (N) latest transmission occasion(s) of monitoring resources for performance metric calculation.","paragraph_zero_based":4741},{"literal_text_all_w_t_and_m_t":"numberOfSingleTRP-CSI-Mode1","paragraph_zero_based":4742},{"literal_text_all_w_t_and_m_t":"Configures the number of reported X CSIs when csi-ReportMode is set to 'Mode 1' as described in TS 38.214 [19], clause 5.2.1.4.2. The field is present only if csi-ReportMode configures Mode 1.","paragraph_zero_based":4743},{"literal_text_all_w_t_and_m_t":"nzp-CSI-RS-ResourcesForInterference","paragraph_zero_based":4744},{"literal_text_all_w_t_and_m_t":"NZP CSI RS resources for interference measurement. csi-ResourceConfigId of a CSI-ResourceConfig included in the configuration of the serving cell indicated with the field \"carrier\" above. The CSI-ResourceConfig indicated here contains only NZP-CSI-RS resources. The bwp-Id in that CSI-ResourceConfig is the same value as the bwp-Id in the CSI-ResourceConfig indicated by resourcesForChannelMeasurement.","paragraph_zero_based":4745},{"literal_text_all_w_t_and_m_t":"p0alpha","paragraph_zero_based":4746},{"literal_text_all_w_t_and_m_t":"Index of the p0-alpha set determining the power control for this CSI report transmission (see TS 38.214 [19], clause 6.2.1.2).","paragraph_zero_based":4747},{"literal_text_all_w_t_and_m_t":"pdsch-BundleSizeForCSI","paragraph_zero_based":4748},{"literal_text_all_w_t_and_m_t":"PRB bundling size to assume for CQI calculation when reportQuantity is CRI/RI/i1/CQI. If the field is absent, the UE assumes that no PRB bundling is applied (see TS 38.214 [19], clause 5.2.1.4.2).","paragraph_zero_based":4749},{"literal_text_all_w_t_and_m_t":"pmi-FormatIndicator","paragraph_zero_based":4750},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE shall report a single (wideband) or multiple (subband) PMI. (see TS 38.214 [19], clause 5.2.1.4).","paragraph_zero_based":4751}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["1007a82549089d2af6d50159188906314f86db475e554b04a3e59ade1d860bc7","05afdbb889c83a936cea42df2b429d565d9875d5f7d4b0eeb79dd20ee22a3220","6e65b7df8ad9d02b493b592b964f927f86a9248c57fafbf69b403bf2b32da469","e29b948dc4c60e0b79b66c6773111c202e64f043bce97819718d4cfd9ba7cd37","b314cbb8287c37c4a166a11c10bf81ef3801d0ce9f5398a2ad901e32006c15ef","9e0336b6cd33533ea3d5154ca6881b7ba1dc140ba28c55eafca3e9748cd90f6e","fb77ef18d9928250a3796497852b78bcf3ee38aeedf012d64a75f56430521d6b","4b8aae722520519c4b28f7881fc5da0d9d6fbfe264181bab173c97acbaa49338","f8c8116dd3bf8a47f0e18ac45b51e298d38ce8595bd82eeeb002e7b33bfdc9c7","2fe560cd98ca4e0842f7f23aff8c0812aaf2f31bf523d8799fce1dc6c7544bb0","1b3cfd6ec231fe83882ca5d1acd21692d9c17548047aebfb31a51cc17ce1956a","9e202e8b7c30c4aa7e9b027d499e15e48038090b5e08e9d19d1fc9e185428388","9310b164a3baa350c3d9d8e5716980dee191e0ba16d4711017583e3995cc5011","27c3b522dd78d7a35a200025d7c8d54a0102c0bf6cb2bbad7b6e83e7741654d0","91804ec3afe3aae0160ab7c3c1876540638aac80b7ff219fb4df6cc330be195c","5aacb3c80f84ffe23a9682b0f5b749c7a57a55e8b04dbe8f23ea7574fd4b65f5","cc1168bf4f1e7a026ba26a404cf28bfd1963040d09836995319dd26de2dba857","556e444346d40a917e6003c621d2b7d1256b4363aff771d6b965eefce65f4f25","5e4813277f20a24403e3e0b7546038398d039eda82ad8bcdb9e23192d902a16d","be17844f48383f72cc78dbba0764cbd434a29fb0bf9caa7d3c343198fffb2c8d","10b5899ac36cc4126a79af6f3dbe6bfe3d5185d3018e4f1f62aeb19451aa7d44","072fc1f273fffc33e8e10a888f71dbf3140bde8fe7b0496e1f776f7fd27c2eb3","56cd42d5a875ad24808a0a5c61bb7c0b798e15c38ba54c9d7d3d194a041fef8f","332e7f9fc5c927c8b96b3c640e05226b312f506bc5fecf97d4e7ad3107e72868"],"paragraph_range_zero_based":[4728,4751],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx:p4728"}
{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"portMappingMethod","paragraph_zero_based":4752},{"literal_text_all_w_t_and_m_t":"Indicates the mapping from CSI-RS resource index/port index per resource to port index for CSI/PMI calculation (see TS 38.214 [19], clause 5.2.1.4).","paragraph_zero_based":4753},{"literal_text_all_w_t_and_m_t":"predictionConfiguration","paragraph_zero_based":4754},{"literal_text_all_w_t_and_m_t":"Configures the UE with parameters for prediction:","paragraph_zero_based":4755},{"literal_text_all_w_t_and_m_t":"- csi-InferencePrediction-r19 indicates inference for CSI prediction;","paragraph_zero_based":4756},{"literal_text_all_w_t_and_m_t":"- configurationForBM-PredictionAndDataCollection-r19 can only be configured when reportQuantity-r19 is present and indicates inference for beam management (i.e., reportQuantity-r19 is set to p-CRI-r19, p-SSB-Index-r19, p-CRI-RSRP-r19 or p-SSB-Index-RSRP-r19) or indicates UE-side data collection for beam management (i.e., reportQuantity-r19 is set to none-BM-r19);","paragraph_zero_based":4757},{"literal_text_all_w_t_and_m_t":"- configurationForBM-Monitoring-r19 can only be configured when reportQuantity-r19 is present and indicates monitoring for beam management (i.e., reportQuantity-r19 is set to rs-PAI-r19);","paragraph_zero_based":4758},{"literal_text_all_w_t_and_m_t":"- configurationForCSI-Monitoring-r19 can only be configured when reportQuantity-r19 is present and indicates monitoring for CSI prediction (i.e., reportQuantity-r19 is set to csi-PAI-r19).","paragraph_zero_based":4759},{"literal_text_all_w_t_and_m_t":"pucch-CSI-ResourceList","paragraph_zero_based":4760},{"literal_text_all_w_t_and_m_t":"Indicates which PUCCH resource to use for reporting on PUCCH.","paragraph_zero_based":4761},{"literal_text_all_w_t_and_m_t":"refToPredictionConfig","paragraph_zero_based":4762},{"literal_text_all_w_t_and_m_t":"Indicates the linked CSI-ReportConfigId corresponding to a prediction report configuration.","paragraph_zero_based":4763},{"literal_text_all_w_t_and_m_t":"reportConfigType","paragraph_zero_based":4764},{"literal_text_all_w_t_and_m_t":"Time domain behavior of reporting configuration.","paragraph_zero_based":4765},{"literal_text_all_w_t_and_m_t":"reportFreqConfiguration","paragraph_zero_based":4766},{"literal_text_all_w_t_and_m_t":"Reporting configuration in the frequency domain. (see TS 38.214 [19], clause 5.2.1.4).","paragraph_zero_based":4767},{"literal_text_all_w_t_and_m_t":"reportQuantity","paragraph_zero_based":4768},{"literal_text_all_w_t_and_m_t":"The CSI related quantities to report. see TS 38.214 [19], clause 5.2.1. If the field reportQuantity-r16, reportQuantity-r17, reportQuantity-r18 or reportQuantity-r19 is present, UE shall ignore reportQuantity (without suffix). Network does not configure reportQuantity-r16, reportQuantity-r17, reportQuantity-r18 or reportQuantity-r19. Network does not configure reportQuantity-r16, reportQuantity-r17, reportQuantity-r18 or reportQuantity-r19 simultaneously.","paragraph_zero_based":4769},{"literal_text_all_w_t_and_m_t":"reportingMode","paragraph_zero_based":4770},{"literal_text_all_w_t_and_m_t":"Configures the UE with reporting mode for group based reporting.(see TS 38.214 [19] clause 5.2.1.4).","paragraph_zero_based":4771},{"literal_text_all_w_t_and_m_t":"reportSlotConfig","paragraph_zero_based":4772},{"literal_text_all_w_t_and_m_t":"Periodicity and slot offset (see TS 38.214 [19], clause 5.2.1.4). If the field reportSlotConfig-v1530 is present, the UE shall ignore the value provided in reportSlotConfig (without suffix).","paragraph_zero_based":4773},{"literal_text_all_w_t_and_m_t":"reportSlotOffsetList, reportSlotOffsetListDCI-0-1, reportSlotOffsetListDCI-0-2","paragraph_zero_based":4774},{"literal_text_all_w_t_and_m_t":"Timing offset Y for semi persistent reporting using PUSCH. This field lists the allowed offset values. This list must have the same number of entries as the pusch-TimeDomainAllocationList in PUSCH-Config. A particular value is indicated in DCI. The network indicates in the DCI field of the UL grant, which of the configured report slot offsets the UE shall apply. The DCI value 0 corresponds to the first report slot offset in this list, the DCI value 1 corresponds to the second report slot offset in this list, and so on. The first report is transmitted in slot n+Y, second report in n+Y+P, where P is the configured periodicity.","paragraph_zero_based":4775}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["dabc16b57353af32a361323c885ee854619debec9b8c78cd4ecedb04e0b631f4","168605ed01d2ce56a727a7aef402b7c38fcd6ec3c934089771a1a969f9fbfc01","bfc23b2d150e4711d457f9789121a4f9d1fd0056aa8ac559f9a8934cd2e8bafc","887b20521a2422e4159a2e7be4ae0eacad53337a685ca3e7de008b77f48a64be","4dd7c5841d98266f7cb67e374d262092d7a374cd730b6c6ecf52afec84a9817b","90d1e1833f1fe399a42d7da2cc3cdc8b595ee887d5fbbe7f44adbeaa25198d9d","25bcf8b041cae49c0b307c2ea54326692ca9cb5c11b0b211ed025cc65de2c2ef","a4da96d2ce813aa58eb5a136b3adc4eb221db8263a638622d388a14d4801a01f","dab5c48a6f8473b9de345acf8da8810a5631c1f844bf23ea03fd4e0f0057618a","1c7b75ee67c50367f2eaf581749be1cc9839fe8870e67df787c450c04ee4dceb","7d3fe29d5575044bf11116ad235d291b45a53f562c60ecdd090db685dcf9e5a8","742cc9d3522fef66c04203436ce4b8cae68f2b05fc0a5fc25d07755b97363b55","e017a7d1d0dc12017368740637e443e7f0523a47737ed9b5b0126fc3e02d89e7","5551c909c45c91d5a9419164f9de7632a11b3f9a70e98941965bf8b09a9e9b3e","af19b57f650a3528428cabbee5e1e10414ca840efb2a215486066d9349eba498","838f4a73c0a2e7e90b5358f7c91a79a461dc008d253d5d824a99fe11208b1a80","ad9f736c4d953737ed4e569ee9b197c62ee3a053e5b830937925b30181b8657a","7655c6539d765322e01565208421e0521cfa8a7c183e6ef8a89c33d46f9e7daa","6d090d83764ca89eb11f3fe8e6af2e259a73ace8049245dd772b183488a90ca1","728cf00b2dc4a3b09c5d6afc08e26ef68edeb1550e5011d4c08694bd38a64eb3","2084d30438001103a6db97825ba78651b856260d5fda4aa36edd89271ab85124","97755f4b386768999c4b2e7b722846038e7c191ab8fad23c168ddc4c4059e2df","aaa3fd5f1096b7007c48cdf0af0493a42d94a3b6de5a74665175eeeb60567390","4a028fdda0e013cb1db6b7a017f2e42d0af43339d49f76c2146972d68b479e71"],"paragraph_range_zero_based":[4752,4775],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx:p4752"}
{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Timing offset Y for aperiodic reporting using PUSCH. This field lists the allowed offset values. This list must have the same number of entries as the pusch-TimeDomainAllocationList in PUSCH-Config. A particular value is indicated in DCI. The network indicates in the DCI field of the UL grant, which of the configured report slot offsets the UE shall apply. The DCI value 0 corresponds to the first report slot offset in this list, the DCI value 1 corresponds to the second report slot offset in this list, and so on (see TS 38.214 [19], clause 6.1.2.1).","paragraph_zero_based":4776},{"literal_text_all_w_t_and_m_t":"The field reportSlotOffsetListDCI-0-1 applies to DCI format 0_1 and the field reportSlotOffsetListDCI-0-2 applies to DCI format 0_2 (see TS 38.214 [19], clause 6.1.2.1).","paragraph_zero_based":4777},{"literal_text_all_w_t_and_m_t":"The fields reportSlotOffsetList-r17, reportSlotOffsetListDCI-0-1-r17 and reportSlotOffsetListDCI-0-2-r17 are only applicable for SCS 480 kHz and 960 kHz and if they are configured, the UE shall ignore the fields reportSlotOffsetList (without suffix), reportSlotOffsetListDCI-0-1 (without suffix) and reportSlotOffsetListDCI-0-2 (without suffix) for SCS 480 kHz and 960 kHz.","paragraph_zero_based":4778},{"literal_text_all_w_t_and_m_t":"resourcesForChannelMeasurement","paragraph_zero_based":4779},{"literal_text_all_w_t_and_m_t":"Resources for channel measurement. csi-ResourceConfigId of a CSI-ResourceConfig included in the configuration of the serving cell indicated with the field \"carrier\" above. The CSI-ResourceConfig indicated here contains only NZP-CSI-RS resources and/or SSB resources. This CSI-ReportConfig is associated with the DL BWP indicated by bwp-Id in that CSI-ResourceConfig.","paragraph_zero_based":4780},{"literal_text_all_w_t_and_m_t":"resourcesForChannelPrediction","paragraph_zero_based":4781},{"literal_text_all_w_t_and_m_t":"Indicates resources to be predicted based on measurements performed on resourcesForChannelMeasurement. The UE is not expected to measure the resources to be predicted, unless the reportQuantity-r19 is set to none-BM-r19..","paragraph_zero_based":4782},{"literal_text_all_w_t_and_m_t":"sharedCMR","paragraph_zero_based":4783},{"literal_text_all_w_t_and_m_t":"Enables sharing of channel measurement resources between different CSI measurement hypotheses when (1) csi-ReportMode is set to 'Mode1' and numberOfSingleTRP-CSI-Mode1 is set to 1 or 2; or (2) csi-ReportMode is set to 'Mode2' (see TS 38.214 [19], clause 5.2.1.4.2).","paragraph_zero_based":4784},{"literal_text_all_w_t_and_m_t":"subbandSize","paragraph_zero_based":4785},{"literal_text_all_w_t_and_m_t":"Indicates one out of two possible BWP-dependent values for the subband size as indicated in TS 38.214 [19], table 5.2.1.4-2 . If csi-ReportingBand is absent, the UE shall ignore this field.","paragraph_zero_based":4786},{"literal_text_all_w_t_and_m_t":"symbolType","paragraph_zero_based":4787},{"literal_text_all_w_t_and_m_t":"Configures the symbol type of periodic/semi-persistent CSI-RS resources for CSI derivation for a CSI report associated with periodic/semi-persistent CSI-RS (see TS 38.214 [19], clause 5).","paragraph_zero_based":4788},{"literal_text_all_w_t_and_m_t":"timeGap","paragraph_zero_based":4789},{"literal_text_all_w_t_and_m_t":"When reportQuantity-r19 is set to p-CRI-r19, p-SSB-Index-r19, p-CRI-RSRP-r19 or p-SSB-Index-RSRP-r19:","paragraph_zero_based":4790},{"literal_text_all_w_t_and_m_t":"- if nrofTimeInstance-r19 is set to 1, this field indicates the time gap between the reference time and the first future time instance for prediction; ","paragraph_zero_based":4791},{"literal_text_all_w_t_and_m_t":"- if nrofTimeInstance-r19 is set to >1, this field indicates the time gap between two consecutive future time instances for prediction.","paragraph_zero_based":4792},{"literal_text_all_w_t_and_m_t":"When reportQuantity-r19 is set to none-BM-r19:","paragraph_zero_based":4793},{"literal_text_all_w_t_and_m_t":"- if nrofTimeInstance-r19 is set to 1, this field indicates the expected time gap between the reference time and the first future time instance of prediction;","paragraph_zero_based":4794},{"literal_text_all_w_t_and_m_t":"- if nrofTimeInstance-r19 is set to >1, this field indicates the expected time gap between two consecutive future time instances of prediction.","paragraph_zero_based":4795},{"literal_text_all_w_t_and_m_t":"This field is present only if resourcesForChannelPrediction-r19 and nrofTimeInstance-r19 are configured.","paragraph_zero_based":4796},{"literal_text_all_w_t_and_m_t":" timeInstanceForRS-PAI","paragraph_zero_based":4797},{"literal_text_all_w_t_and_m_t":"Indicates the f-th time instance is used for the performance metric calculation.","paragraph_zero_based":4798},{"literal_text_all_w_t_and_m_t":" timeInstanceForSGCS","paragraph_zero_based":4799}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["1cba28b39c1c1c40f56fae1350d29879d1423f59b66051570738e2be136a544b","50b76a4a199685d0b0bb35e37c47a3a56f49c33877a7fe3af64b42ee3c2ba6b4","d21bbc9165f66a1cf818c05fd61b9e49f463ac0f133ad1b04b50d8188d78eb14","580912548d8483eb1ae1a2d3fb4f893dd73fe2c8ce496d54fcdaa24afbd40407","c85e98b09185035b08d8495e1552062378655a7ac4f43ba20aeb6ddc068411f6","b94435549ede7a04171a15ec27897fe6ecfd177deb4eac369ef904223f61dbc8","ab7628a5a660cac9f16f2edc92c873ddbb9b2be3ef1ad8a5dbd5b23b85e9c4a9","cd6d5de5a0edd973d3cfba8f70b52da4507009933ab7aaa4cb8b75bd7d3ec1ea","0dfedc57c8857d76df2075713cfefe93544d9a5212952cf2549781b7c035b73d","6d6af064ad64df3bb7018aaf69b978cc45fb3c10085fe30debad4b875b62dea8","b159787908c0db9057bac4c9378cccd0a521858295e8a986e4b845fd16895794","73a061b28357914ba7a2d7180bd8fcca4f34860fe539758a0142416e754acf30","b429f25b4db6827b4fa7f44278869a67b72cf959883b3ba6a70d09f1e847ff1c","5520c9d26de7dded6c2b94595ff97e4c40c2d13ead9aca82f567fdd0744eee8a","f4f5be41d8a9852321bf2cf8e671ee92ea23ce71bd20201925bd7b398eb3bd20","e6f3fe039d07129a6257663d682c36a5f2805ef01cddf6294b5299cc401fd959","2bab9bc2a383f70801c60cdaa95b0b1f209b3a0a472604a623a3f1e679912de9","3d84b33e267682c50519af9af7dee5e0fd819c776b9fc87d5628104afa61d118","112c0846e12d4a68b3062ab4b3776b2d4386ce5bced8f5c41812e48ae5abebdf","f04ef40c0d904f8e2d109a16ecb3db54d76ea12a703c1307144cce0ff44a665b","ba05d3f4c5f9d2bb7f7ff332f50bcb38c61c6b6a969db9416eb12e75f13ec3fc","04d1be1f545b944a5925bff80a545e794551855f75488eadbe94876a6df0504f","b1d12788d787ad8d795af4649ad811eb4a005f96a48b2d1f7e5e80566e9ce3a3","523530e40e860fe83cbd8d9515dc2eaabed3297903a71b16dcf56b1d4bbc960c"],"paragraph_range_zero_based":[4776,4799],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx:p4776"}
{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the f-th doppler domain unit is used for the performance metric calculation for N4>1.","paragraph_zero_based":4800},{"literal_text_all_w_t_and_m_t":"timeRestrictionForChannelMeasurements","paragraph_zero_based":4801},{"literal_text_all_w_t_and_m_t":"Time domain measurement restriction for the channel (signal) measurements (see TS 38.214 [19], clause 5.2.1.1).","paragraph_zero_based":4802},{"literal_text_all_w_t_and_m_t":"timeRestrictionForInterferenceMeasurements","paragraph_zero_based":4803},{"literal_text_all_w_t_and_m_t":"Time domain measurement restriction for interference measurements (see TS 38.214 [19], clause 5.2.1.1).","paragraph_zero_based":4804},{"literal_text_all_w_t_and_m_t":"valueOfM","paragraph_zero_based":4805},{"literal_text_all_w_t_and_m_t":"This field is used in clause 5.1, 5.2 and 5.4 in TS 38.214 [19]. This field is configured up to value 4 if codebookType is set to typeI-SinglePanel and up to value 2 if codebookType is set to typeII-r16.","paragraph_zero_based":4806},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4807},{"literal_text_all_w_t_and_m_t":"CSI-ReportCJTC field descriptions","paragraph_zero_based":4808},{"literal_text_all_w_t_and_m_t":"associatedSRS-ResourceSet","paragraph_zero_based":4809},{"literal_text_all_w_t_and_m_t":"This field is used in clause 5.2.1.4 in TS 38.214 [19].","paragraph_zero_based":4810},{"literal_text_all_w_t_and_m_t":"nrOfSubbandsPO","paragraph_zero_based":4811},{"literal_text_all_w_t_and_m_t":"This field is used in clause 5.2.1.4 in TS 38.214 [19].","paragraph_zero_based":4812},{"literal_text_all_w_t_and_m_t":"referenceAntennaPort","paragraph_zero_based":4813},{"literal_text_all_w_t_and_m_t":"This field is used in clause 5.2.1.4 in TS 38.214 [19].","paragraph_zero_based":4814},{"literal_text_all_w_t_and_m_t":"subbandSizeCJTC","paragraph_zero_based":4815},{"literal_text_all_w_t_and_m_t":"This field is used in clause 5.2.1.4 in TS 38.214 [19].","paragraph_zero_based":4816},{"literal_text_all_w_t_and_m_t":"valueOfAD","paragraph_zero_based":4817},{"literal_text_all_w_t_and_m_t":"This field is used in clause 5.2.1.4 in TS 38.214 [19]. Value dot5 corresponds to 0.5 CP and value one corresponds to 1 CP.","paragraph_zero_based":4818},{"literal_text_all_w_t_and_m_t":"valueOfAFO","paragraph_zero_based":4819},{"literal_text_all_w_t_and_m_t":"This field is used in clause 5.2.1.4 in TS 38.214 [19]. Value zeroDot1 corresponds to 0.1 ppm and value zeroDot2 corresponds to 0.2 ppm.","paragraph_zero_based":4820},{"literal_text_all_w_t_and_m_t":"valueOfMD","paragraph_zero_based":4821},{"literal_text_all_w_t_and_m_t":"This field is used in clause 5.2.1.4 in TS 38.214 [19].","paragraph_zero_based":4822},{"literal_text_all_w_t_and_m_t":"valueOfMFO","paragraph_zero_based":4823}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["0e142c5c56e49c504f4142c04e138513547a862198a40b680c0ec8179c2c2fb8","ae1d4a36b8ea5bb09707cf3c6d8e1ff0f9ec7ee24fc1bec9155abffa457b89ff","dec8c7b1fab6af356bebcb942a3748affdf2c8728ace6a85b6afeae2d8e7b124","946d61323697596b07f98a5f5d5f3a2740f6ffb677b32bf99e23116c832c2f2d","1a63dcbc597c5d79dd627791f597dba34f13753cb0326897c7688f94fd8703c8","67956307e768de332fe3eeca18cf0a4d744e625b36334fde56250924bdcae120","4cf6b88990018f76378e98497b9cf4e06dd5f810c38659b492528cf24490f5b0","29431cedaf870c36eb02b76e3ea8947d769a01954e2b0e83ff1bbfb2cbccfb1e","33103b2d21d3ec6693fbb40ff0d0c93dcb293073a901e902432c063c661e991d","1de505175e34a1fc915405d65a37e9bf2cb0a280dfc82e33429da77d0186a673","c4141a328166637683c5f14963a55ff295f3c489df4a786a5a6df5147b1a63cf","1db8ac9d0e1ec177e8b22edbe9790caa86c1ab1d2e6ffb00c93d2dfa812de54e","7793e85638cacb76fa901700c37da18b0b4b4e12bcd5776122b8cbd8983a7d1d","a8be0c621b119e14546c94c0747c81107f53b5513bf156966f04487ebc76474b","e3fc8f5ea6037cc2f8c8274d14a480d9e02d281b25cd8bf2f2c222b2fdb5e82f","34feae1db09821fa8980284009190dea214c3618c3cfdb21fb208517bba04418","2f3bdd91f7b3b24242c0b87fd4456adcefdf7cbf5372f35074e6dab4f35603db","6ea47d70da4d00e238a0604fc95a9769731dcd8c2add9a54b9b34d18e793f86d","d25fd06e8f1601f75c9b0dce240b3ecdade3a67d826b9cb2e162e533fe2cad97","f0efe118b3bada94961b73f12c2dccaee5b2991f424b93dcaf3134964ea752d0","d10b4dd2efbf15a3693ed9679396239eb90dad332fd0cdf4c765663eaf766a71","4b359d1665ceb43550c1d958d3901e5b1dc9885da9515d2eefd734ef1dd26d23","6535c846dd0c32a35b215a21b90387c5407e5e88c9ca3bca4e93616c3a98ad20","bf305d123d9e41f8f28f06559930cf259788619f27cafbbdfb37bac4260cf495"],"paragraph_range_zero_based":[4800,4823],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx:p4800"}
{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is used in clause 5.2.1.4 in TS 38.214 [19].","paragraph_zero_based":4824},{"literal_text_all_w_t_and_m_t":"valueOfMPhi","paragraph_zero_based":4825},{"literal_text_all_w_t_and_m_t":"This field is used in clause 5.2.1.4 in TS 38.214 [19].","paragraph_zero_based":4826},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4827},{"literal_text_all_w_t_and_m_t":"CSI-ReportSubConfig field descriptions","paragraph_zero_based":4828},{"literal_text_all_w_t_and_m_t":"codebookSubConfig","paragraph_zero_based":4829},{"literal_text_all_w_t_and_m_t":"Applicable codebook parameters for the ports indicated by portSubsetIndicator. Applicable value ranges for codebook subset restriction, rank restriction, N1, N2, and Ng and twoTX-CodebookSubsetRestriction follow existing specification according to the codebookConfig configured within the CSI-ReportConfig, and apply for the number of ports determined by portSubsetIndicator (see TS 38.214 [19], clause 5.2.1.4.2). In this field, the network always sets the codebookType to type1. When reportQuantity is set to 'cri-RI-i1-CQI', the parameter typeISinglePanel-codebookSubsetRestriction-i2 is mandatory to be configured in the codebookSubConfig for each sub-configuration that includes portSubsetIndicator.","paragraph_zero_based":4830},{"literal_text_all_w_t_and_m_t":"non-PMI-PortIndication","paragraph_zero_based":4831},{"literal_text_all_w_t_and_m_t":"Port indication for RI/CQI calculation applicable only for non-PMI feedback. The field shall be configured only if the portSubsetIndicator-r18 is configured.","paragraph_zero_based":4832},{"literal_text_all_w_t_and_m_t":"For each CSI-RS resource in the linked CSI-ResourceConfig for channel measurement, a port indication for each rank R, indicating which R ports out of P ports to use within the sub-configuration. P corresponds to the number of bits with value 1 in the bitmap portSubsetIndicator-r18.","paragraph_zero_based":4833},{"literal_text_all_w_t_and_m_t":"nzp-CSI-RS-ResourceList","paragraph_zero_based":4834},{"literal_text_all_w_t_and_m_t":"List of NZP CSI RS resources for the sub-configuration that is a (sub)set of NZP CSI-RS resource(s) of the CSI-RS resource set for channel measurement associated with the sub-configuration in the CSI report configuration. Value 0 refers to the first NZP CSI RS resource of the CSI-RS resource set, value 1 refers to the second NZP CSI RS resource of the CSI-RS resource set, and so on.","paragraph_zero_based":4835},{"literal_text_all_w_t_and_m_t":"portSubsetIndicator, portSubsetIndicator-v1900","paragraph_zero_based":4836},{"literal_text_all_w_t_and_m_t":"Indicates the (sub)set of CSI-RS antenna ports used for CSI calculation of the sub-configuration. In the bit string, each bit corresponds to an antenna port. When a bit is set to 1, the corresponding port is enabled for CSI calculation corresponding to the sub-configuration. When the bit is set to zero, the corresponding port is not enabled for CSI calculation corresponding to the sub-configuration. The size of the bit string equals P bits, where P=2/4/8/12/16/24/32/48/64/128 represents the number of ports of the NZP CSI-RS resource(s) in the resource set for channel measurement associated with the CSI-ReportConfig. The network does not configure portSubsetIndicator and portSubsetIndicator-v1900 simultaneously.","paragraph_zero_based":4837},{"literal_text_all_w_t_and_m_t":"powerOffset","paragraph_zero_based":4838},{"literal_text_all_w_t_and_m_t":"When powerControlOffset is configured in NZP CSI-RS resources in the resource set for channel measurement associated with the CSI-ReportConfig, the power offset of PDSCH EPRE to NZP CSI-RS EPRE is equal to powerControlOffset - powerOffset.","paragraph_zero_based":4839},{"literal_text_all_w_t_and_m_t":"reportSubConfigParams, reportSubConfigParams-v1900","paragraph_zero_based":4840},{"literal_text_all_w_t_and_m_t":"Indicates the parameters to be used for the CSI report sub-configuration, which includes either a1-parameters that contain the antenna port subset and the associated parameters relevant to the sub-configuration or a2-parameters that contain the list of NZP CSI-RS resources for the sub-configuration (see TS 38.214 [19], clause 5.2.1.4.2). ","paragraph_zero_based":4841},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4842},{"literal_text_all_w_t_and_m_t":"CSI-ReportUE-IBR field descriptions","paragraph_zero_based":4843},{"literal_text_all_w_t_and_m_t":"conditionFulfillmentIndicator","paragraph_zero_based":4844},{"literal_text_all_w_t_and_m_t":"If configured, the UE includes an indication whether or not each reported RS fulfilled the event condition. This parameter is only configured if eventDetectionTimeWindow is configured and nrofReportedRS is not set to n1.","paragraph_zero_based":4845},{"literal_text_all_w_t_and_m_t":"currentBeamReport","paragraph_zero_based":4846},{"literal_text_all_w_t_and_m_t":"If configured, the UE includes measurements of the current beam in the UE initiated CSI reporting.","paragraph_zero_based":4847}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["53b15fd2b9268eeb2da0c66e2b482b8fc8d3000d15edd2d96b3469e082646563","caace13023897963b03a7a4421fe681f8d5ef4af9a201502156eb2394ba5e413","050f7d99951dd9c3cd804b3b3729c143984b92fdf1e218ad339717960a12a39f","1979d06291d57706f10acbc24a1432429e0052072d60e637c8788cbf8aeb9fb5","db9216138190c2c07506f0065d36a1bb5affe59f908a3cffde9d7da0acbeacb3","5b3a7c87f21c605f52ac56a84c03ce6e6f214f03e007e5572716a8aef92e7192","0b349a262fd5a88a7ff0ce8d3be04c441a69bf4fc5d40bb391f9c05a50db7735","13fc42f63aa930aaef2d67cc64205262e735da1983226e4a1bab7fde67c34858","e250f3fc8c9a5451fcd8032b52938b3c8be35814d2697ba754e93f396e685dd4","a5205fe5690c7b535a413f77ae835766695e41bb70f0374ebb38b669330c0c7c","a5539564466334ad3e8998241f0b5a91c4424328dad18ac6b7f93a87aea33e3b","0ce5cf5a7da1e9ecaca6364b48a0e55f9d82beff02e2e54e555a1269f657ee97","a8fc923d3c5ce75cae834eb58ff3fadc696d1d50ee7f330edd14358db09fdbaf","a45766e12bd51bb4ac9e9a7cf39539b910e6f07554d5014ef6f51d0104ada5af","e275b97bb98a9a6200fd7c2c8f5c1d17b63bc2f76569af8fdcfe236f287573a3","15ef1102b2708d1590db7732d936f5419ce06a1e2e149ea8e16fac2caf07ebf3","44c417a5ded6a52d9495fa840dd0c00adaca638ca50bfb5cfb503011ba5450ce","4e68f7b1117a85a95d80da9981e51467a04ed7f2bbec78cb1baba2c87454d66d","a694782be09fcca6b34568cf31120fb2d88bf9d68f7bea7571deaca68e9e6f9c","ebf88d54f89ab528fa582708eff9fb4d4339f1f3ea9f3c11c5cf568f56737532","fbb4549f2d833955789b1b0f25fc4ce5b46283255a72fe23287e03fef949eb5c","0f5bce83c7e5de4d8a2df54db76c8f6f7d3224ab9626fd8595230157da3855b3","54e13ff8b85668b03ddcfe5ddebe108145a990d38d36dc9ba6010f57810119b4","48e219a75ed61576a497b2a2da07ef590ff68bfdc3717953a4be873c0804c5df"],"paragraph_range_zero_based":[4824,4847],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx:p4824"}
{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"eventDetectionTimeWindow","paragraph_zero_based":4848},{"literal_text_all_w_t_and_m_t":"Indicates the time window length for triggering event determination (see TS 38.214 [19], clause 5.2). Value ms4 corresponds to 4 milliseconds, value ms5 corresponds to 5 milliseconds and so on.","paragraph_zero_based":4849},{"literal_text_all_w_t_and_m_t":"eventInstanceCount","paragraph_zero_based":4850},{"literal_text_all_w_t_and_m_t":"Indicates the minimum number of event instances for one same new beam within a configured time window that the UE can initiate UEIBM report (see TS 38.214 [19], clause 5.2.1.5.4.1). This field is only configured if eventDetectionTimeWindow is configured.","paragraph_zero_based":4851},{"literal_text_all_w_t_and_m_t":"eventTypeUE-IBR","paragraph_zero_based":4852},{"literal_text_all_w_t_and_m_t":"Indicates the event type for UE initiated CSI reporting and associated fields as specified in clause 5.2.1.5.4 of TS 38.214 [19].","paragraph_zero_based":4853},{"literal_text_all_w_t_and_m_t":"minimumPucch-PuschOffset","paragraph_zero_based":4854},{"literal_text_all_w_t_and_m_t":"Indicates the time offset in number of symbols for determining available transmission occasion of PUSCH in Mode-B from the PUCCH. Value symb0 corresponds to 0, value symb1 corresponds to 1 and so on.","paragraph_zero_based":4855},{"literal_text_all_w_t_and_m_t":"nrofReportedRS-UE-IBR","paragraph_zero_based":4856},{"literal_text_all_w_t_and_m_t":"The number of reported RS in the UE initiated CSI reporting. Value n1 corresponds to 1 reported RS, value n2 corresponds to 2 reported RSs and so on.","paragraph_zero_based":4857},{"literal_text_all_w_t_and_m_t":"pucch-Resource","paragraph_zero_based":4858},{"literal_text_all_w_t_and_m_t":"Indicates the periodic PUCCH resource for the UE initiated CSI reporting indicator for both mode-A and mode-B UE initated CSI reporting:","paragraph_zero_based":4859},{"literal_text_all_w_t_and_m_t":"-to request dynamically scheduled PUSCH to carry UE-initiated/event-driven beam report for mode-A;","paragraph_zero_based":4860},{"literal_text_all_w_t_and_m_t":"-to notify the network of a Type-1 CG PUSCH to carry UE-initiated/event-driven beam report for mode-B.","paragraph_zero_based":4861},{"literal_text_all_w_t_and_m_t":"pusch-ResourceOfModeB","paragraph_zero_based":4862},{"literal_text_all_w_t_and_m_t":"Indicates Type-1 CG PUSCH resource for the UE initiated CSI reporting in mode-B.","paragraph_zero_based":4863},{"literal_text_all_w_t_and_m_t":"reportTransmissionMode","paragraph_zero_based":4864},{"literal_text_all_w_t_and_m_t":"Indicates the transmission mode for UE initiated CSI reporting. Value modeA indicates transmission of UE initiated CSI reporting in a dynamically scheduled uplink grant and value modeB indicates transmission of UE initiated CSI reporting in a pre-configured type-1 configured uplink grant.","paragraph_zero_based":4865},{"literal_text_all_w_t_and_m_t":"tci-ServCellIndex","paragraph_zero_based":4866},{"literal_text_all_w_t_and_m_t":"Indicates the serving cell on which the indicated TCI state used to determine the current beam RS is applied (see TS 38.214 [19], clause 5.2.1.5.4).","paragraph_zero_based":4867},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4868},{"literal_text_all_w_t_and_m_t":"PortIndexFor8Ranks field descriptions","paragraph_zero_based":4869},{"literal_text_all_w_t_and_m_t":"portIndex8","paragraph_zero_based":4870},{"literal_text_all_w_t_and_m_t":"Port-Index configuration for up to rank 8. If present, the network configures port indexes for at least one of the ranks.","paragraph_zero_based":4871}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["a2177007bb662a1b045c77b0de5e45c6092dadc79ffc83c5901576f89b5fc10d","73c5cd8be57ddd1044e7ae0aa0c713bc50f6d674a8db8eace9e3f137bda50216","43dedd8e94e43b599b444d7ce53f137c1cf1b72aefa44acdf1c42c848cca5f18","0d31f2acf0b40044affdafce6a5118e962a6594f16d77ed369db92da40955913","8d3cb1205d7c902528503c15cc19716bd20d0770636a7f4bc024ff173ac645b5","bc8360dfc155104f8debb30bcf6aba2358f0bcbd7d07d3f224c5f3a4b1adb063","98547d895a9fef85981c3a6a5e1dbcc16712565f2a8cb4b25df3fd4909a84363","750bb06d6ca3d172ac2ca8b0951c1ad84acd89e39e8aaf0591b83b6c4fb79f76","fe40b10a4d95e88d4690e0fd96ccdee1a7f2845a8bdbce3c811a40b908259a07","32a30ec910e7d57bc0e76987ffeaa04860662508fe1db92807f0c788df638318","4509ff32ea4b5b56208eeaf985015d4a5902594049b29cafa36d241249da60eb","12d8a83723d112dfbce96c347a847a79b74157a58d678b39636df09446b79bd4","1227a539b773f296b09a47d603c77ec908146fa5b22706170118489c836b993d","d767d6f9b9daa8fbf2e116fbcd63e9fef88951e8979d3a7461b8dffe92489cc0","334eca9019056b3727f458cd37587ab5f0b0be69242c9dcb9ee969cd4d1cccb8","1b6d90fec8777523b5c632c1726d3179a4fc7d37a03a237e954c92840c2a0ecb","b3af27378be83b0cca7eb354bf57baf70871db88d9587e2397d317b095651032","8e685d0d1175b14241396a5dbb6756e7e055e04f80ab6400e528f163a40c76f3","5ce68abceec7c27b2419d7fecf17c9999cfc145acf8c99c5e3fe5641636b65ac","04196842544dfe56012a9dbdc8dfa8c466e3516147f8207b08204f63bbf9155f","e74fdf17be4112e25b4d0ae6e1e2798c641647f24316a77f666fcbde0374f64c","7b09a096400a07362264d9a0ad55125cf3146bd1cbf1dc3e69f1de13e571e8b8","e232a983660f6d3cbc7c073ea11d867f91b544ce3f55b56aed9933609ca5c43e","938709f70c9c616428c3d5a400739ddb71192e9d75425b3226f841aee39c5fea"],"paragraph_range_zero_based":[4848,4871],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-