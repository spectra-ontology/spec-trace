{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":49176},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49177},{"literal_text_all_w_t_and_m_t":"MRB-ListMulticast-r18 ::=          SEQUENCE (SIZE (1.. maxMRB-r17)) OF MRB-InfoMulticast-r18","paragraph_zero_based":49178},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49179},{"literal_text_all_w_t_and_m_t":"MRB-InfoMulticast-r18 ::=          SEQUENCE {","paragraph_zero_based":49180},{"literal_text_all_w_t_and_m_t":"    pdcp-Config-r18                    MRB-PDCP-ConfigMulticast-r18,","paragraph_zero_based":49181},{"literal_text_all_w_t_and_m_t":"    rlc-Config-r18                     MRB-RLC-ConfigMulticast-r18,","paragraph_zero_based":49182},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":49183},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":49184},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49185},{"literal_text_all_w_t_and_m_t":"MRB-PDCP-ConfigMulticast-r18 ::=   SEQUENCE {","paragraph_zero_based":49186},{"literal_text_all_w_t_and_m_t":"    pdcp-SN-SizeDL-r18                 ENUMERATED {len12bits, len18bits},","paragraph_zero_based":49187},{"literal_text_all_w_t_and_m_t":"    headerCompression-r18              CHOICE {","paragraph_zero_based":49188},{"literal_text_all_w_t_and_m_t":"        notUsed                            NULL,","paragraph_zero_based":49189},{"literal_text_all_w_t_and_m_t":"        rohc                               SEQUENCE {","paragraph_zero_based":49190},{"literal_text_all_w_t_and_m_t":"            maxCID-r18                         INTEGER (1..16)               DEFAULT 15,","paragraph_zero_based":49191},{"literal_text_all_w_t_and_m_t":"            profiles-r18                       SEQUENCE {","paragraph_zero_based":49192},{"literal_text_all_w_t_and_m_t":"                profile0x0000-r18                  BOOLEAN,","paragraph_zero_based":49193},{"literal_text_all_w_t_and_m_t":"                profile0x0001-r18                  BOOLEAN,","paragraph_zero_based":49194},{"literal_text_all_w_t_and_m_t":"                profile0x0002-r18                  BOOLEAN","paragraph_zero_based":49195},{"literal_text_all_w_t_and_m_t":"           }","paragraph_zero_based":49196},{"literal_text_all_w_t_and_m_t":"        }","paragraph_zero_based":49197},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":49198},{"literal_text_all_w_t_and_m_t":"    t-Reordering-r17                   ENUMERATED {ms1, ms10, ms40, ms160, ms500, ms1000, ms1250, ms2750}    OPTIONAL -- Need R","paragraph_zero_based":49199}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["ac958a7357a01079eb494fddf3ab76251819560a01ffa50a464734a4ffff743b","4ecc28f91d07a5af68ab7ca442992d9257d0b0e8b915ce138c4db67baea8817a","e140e22fbd23b9151e4d27c699eeed800851c9759ccd5e5af5b05d9229124d4b","6fddd03beb25b0b13709a09b7920f03e6585ab6250c578292db026f399c5f264","576311dc5ca709e9a92be3353766ecd6d4d441df59c83b667c54bd6d9f155e1f","483290b09aad2b73a813799ce60102ed12fa9ed0daf7b5198bce01c98f882670","4981c017ce1c9c91dfc3b1068f049a5ebacd6da88ebac37f58ead430b3594692","165f593897b9de3296a62bdf90ccfb79f448a6f5b1e12d2a4651e2ddb635ecdd","a4cd2c1f1f9eed0d045a754dbea7716498f8368e3dceca18894b98d4f1e233f0","8eb9b411721207c563628184697ecb154c9b56bf10454ede28b40bfe11314135","a1fba6b3ed4e07b0e1d1706886dbfa777be726c68b76853c57856c23ddbc93ee","38623855af909c16adf0f892150a3ed769f8e48feeabece1b1098163ca1976b9","23e5b8e94b760366e3d3325149e15a7703e9094140bc9244c6388e9159c3312b","8bbc389ae3f99845c583e0bc511db7548c71dc75b109a6b8e5728c6b5e2e77b6","9952ad7ca052b438eb3889694507777a2984609d18691a871aff078661934e8e","d993cfb7d39c1dabc2aa6df6c1e3023c6acdabd8f6cac7cd019e93518eefabe5","8c9119d59a4fadb3913313bde9af0bf7347bfd704277e1c0f37a712cfd2a0154","e8497a17c682171981148f9df981cdd76e03586b9b874054a6b369600f4198b5","72256f571e6bcf1ad011162e2a1c81b537123670c88f134e084a1f6a3ab1e31a","76ea994e9f5fca6feb6a0d88eb53b8c7e718d11e19c56a6125fdd17cb9e666df","cf29a881e91902f9cc7f2ef8eb98e48c745c4b2d48048cd5935ff55709691f3a","32400ddf3a3ad030bf5d7ffaca532ff2724b15ca6799b8c09af21e7921ee9a9b","2e01156b4b5faa34be66809ccb676e3bc27796888a143e42a4299f522e56d39a","3f6a6c9ef68f25ece2153acd3c32a38df1ac3b6e2dc87942c2e065ad74c102d9"],"paragraph_range_zero_based":[49176,49199],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p49176"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":49200},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49201},{"literal_text_all_w_t_and_m_t":"MRB-RLC-ConfigMulticast-r18 ::=    SEQUENCE {","paragraph_zero_based":49202},{"literal_text_all_w_t_and_m_t":"    logicalChannelIdentity-r18         CHOICE {","paragraph_zero_based":49203},{"literal_text_all_w_t_and_m_t":"        logicalChannelIdentitymulticast-r18 LogicalChannelIdentity,","paragraph_zero_based":49204},{"literal_text_all_w_t_and_m_t":"        logicalChannelIdentityExt-r18       LogicalChannelIdentityExt-r17","paragraph_zero_based":49205},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":49206},{"literal_text_all_w_t_and_m_t":"    sn-FieldLength-r18                 ENUMERATED {size6, size12},","paragraph_zero_based":49207},{"literal_text_all_w_t_and_m_t":"    t-Reassembly-r18                   T-Reassembly                                 OPTIONAL  -- Need R","paragraph_zero_based":49208},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":49209},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49210},{"literal_text_all_w_t_and_m_t":"-- TAG-MBS-SESSIONINFOLISTMULTICAST-STOP","paragraph_zero_based":49211},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":49212},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49213},{"literal_text_all_w_t_and_m_t":"MBS-SessionInfoListMulticast field descriptions","paragraph_zero_based":49214},{"literal_text_all_w_t_and_m_t":"g-RNTI","paragraph_zero_based":49215},{"literal_text_all_w_t_and_m_t":"G-RNTI used to scramble the scheduling and transmission of multicast MTCH. ","paragraph_zero_based":49216},{"literal_text_all_w_t_and_m_t":"mbs-SessionId","paragraph_zero_based":49217},{"literal_text_all_w_t_and_m_t":"Indicates an identifier of the MBS session to be received by the UE in RRC_INACTIVE.","paragraph_zero_based":49218},{"literal_text_all_w_t_and_m_t":"mrb-ListMulticast","paragraph_zero_based":49219},{"literal_text_all_w_t_and_m_t":"A list of multicast MRBs to which the associated MBS multicast session is mapped to.","paragraph_zero_based":49220},{"literal_text_all_w_t_and_m_t":"mtch-NeighbourCell","paragraph_zero_based":49221},{"literal_text_all_w_t_and_m_t":"Indicates neighbour cells which provide this service on MTCH for RRC_INACTIVE. The first bit is set to 1 if the service is provided on MTCH in the first cell in mbs-NeighbourCellList, otherwise it is set to 0. The second bit is set to 1 if the service is provided on MTCH in the second cell in mbs-NeighbourCellList, and so on. If the service is not available in any neighbouring cell and mbs-NeighbourCellList is signalled, the network sets all bits in this field to 0. The field is absent when mbs-NeighbourCellList is absent or an empty mbs-NeighbourCellList is signalled. If this field is absent when mbs-NeighbourCellList is absent or a non-empty mbs-NeighbourCellList is signalled, the related service may or may not be available in any neighbouring cell, i.e. the UE cannot determine the presence or absence of an MBS service in neighbouring cells based on the absence of this field. If this field is absent and an empty mbs-NeighbourCellList is signalled, then the UE shall assume that MBS multicast services signalled in mbs-SessionInfoListMulticast in the MBSMulticastConfiguration message are not provided in any neighbour cell.","paragraph_zero_based":49222},{"literal_text_all_w_t_and_m_t":"mtch-SchedulingInfo","paragraph_zero_based":49223}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["104da2029015e044a22c6b98af65d652c25d67868c339017275ed5c1c9439ecc","edbabde4282869d120ff7df73471876460405e15b84e6affcf2ba8a08572c0de","2eb0479c63f9f99581c3046e8fd77ea343b9d8bce7cc16722eae9a23e372e5db","e1cb97d277f7524a2891f0e4e4353e5313e7826f7043a7955a1e9d6c51a7490f","abf188441e6b27355ac86b7ab58f2edec0b13b5a84a54996adebd4fcc3f57356","a0283935daca9da1b518b655f2b3c187de35ef166e7f11d80f285a3cf37f140c","43d80f112210a6323f48b1ed5c06b27b7a3caeebc5d658c299a0b08d289d4997","8fc345b2ad225ff883af113538e111a9a2b1b1a5b30ea02d1a1395997c19010c","6f9de67ef31b5ac773d337f65485b45fd13c7a9cd45a3e6a97c043cd45c45c19","39313d058927d74330a35badbf157355bd633a2a8cac272d4636bdcc97953507","c575bc393229890fe12a8726d1f2d1b459d63b7ae047978bfe275e1fce5707a7","b6e55c1c0e5cc336a3939ed1882d427341c7818be9ca6cd54d6f13e418dd4a5b","872fe206e549a8f98205029834252c4cddeed5b3242f9a15264fda0ca0d7ef0a","3b0dcfa61dcf2de2806b212bbd06c6225a01bb631dc244326e1f682bf2e31329","41a523eadddbc59d4446a30bfdeed0e988eae125fb41ad5f84dbef0f114b93e7","408fd4f6b4b024d38b16411be8d404451178b345c42efe3e655f89cf53d65164","b7cf071ab11fdb2a98910ff122a7a77a80e0de4ed15032ddc5d1fc1993d3eb9c","dc6c84a7a00d511566410ced469108ff944d33c790c45884655a54d6a0306a08","ec3001ff734e8c5dbc3d204bc37d9a796a4274541123ef7ce130629c9bb19682","a98897e2eb0295076701c41d5c23d7920929e26a1ab2f9884c19b79f32e66379","9ff8ddadd9e09d763c14c55695ed822d1c8eb2d5ed79a75ff0c635f56d289d64","7aa78d30ae412049b8e35b2d3290be1dc5fa114cf4ab260b78a4b827262f7833","f32f4c8396f641f18c9a272cff07df4b457908f55c556b165b7ad4b083526b70","93bab2577a7e8253662102dacb9200a20b8ea47f25eb38a564576f1082e23ae4"],"paragraph_range_zero_based":[49200,49223],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p49200"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the index of DRX configuration entry in drx-ConfigPTM-List that is used for scheduling the MTCH. The value 0 corresponds to the first entry in drx-ConfigPTM-List, the value 1 corresponds to the second entry in drx-ConfigPTM-List and so on. In case mtch-schedulingInfo is absent for a G-RNTI (i.e. no PTM DRX), the UE shall monitor for PDCCH scrambled with G-RNTI in any slot according to the search space configured for MTCH.","paragraph_zero_based":49224},{"literal_text_all_w_t_and_m_t":"mtch-SSB-MappingWindowIndex","paragraph_zero_based":49225},{"literal_text_all_w_t_and_m_t":"Indicates the index of MTCH-SSB-MappingWindowCycleOffset configuration entry in MTCH-SSB-MappingWindowList. The value 0 corresponds to the first entry in MTCH-SSB-MappingWindowList, the value 1 corresponds to the second entry in MTCH-SSB-MappingWindowList and so on. This field is set to the same value for all MBS sessions mapped to the same G-RNTI.","paragraph_zero_based":49226},{"literal_text_all_w_t_and_m_t":"pdcp-SN-SizeDL","paragraph_zero_based":49227},{"literal_text_all_w_t_and_m_t":"Indicates PDCP sequence number size of 12 or 18 bits, as specified in TS 38.323 [5].","paragraph_zero_based":49228},{"literal_text_all_w_t_and_m_t":"pdsch-ConfigIndex","paragraph_zero_based":49229},{"literal_text_all_w_t_and_m_t":"Indicates the index of PDSCH configuration entry in pdsch-ConfigList for MTCH. Value 0 corresponds to the first entry in pdsch-ConfigList, the value 1 corresponds to the second entry in pdsch-ConfigList and so on. When the field is absent the UE applies the first entry in pdsch-ConfigList for MTCH.","paragraph_zero_based":49230},{"literal_text_all_w_t_and_m_t":"pdcp-SyncIndicator","paragraph_zero_based":49231},{"literal_text_all_w_t_and_m_t":"Indicates the PDCP COUNT of the corresponding multicast session is synchronized in the RNA, i.e. the cells in the RNA follow a common QoS flow to MRB mapping rule and at the same time PDCP COUNT is set according to the MBS QoS Flow SN.","paragraph_zero_based":49232},{"literal_text_all_w_t_and_m_t":"sn-FieldLength","paragraph_zero_based":49233},{"literal_text_all_w_t_and_m_t":"Indicates RLC SN field size of 6 or12 bits, as specified in TS 38.322 [4].","paragraph_zero_based":49234},{"literal_text_all_w_t_and_m_t":"stopMonitoringRNTI","paragraph_zero_based":49235},{"literal_text_all_w_t_and_m_t":"Indicates the UE to stop monitoring the G-RNTI for the corresponding multicast session.","paragraph_zero_based":49236},{"literal_text_all_w_t_and_m_t":"t-Reassembly","paragraph_zero_based":49237},{"literal_text_all_w_t_and_m_t":"Timer for reassembly in TS 38.322 [4], in milliseconds. Value ms0 means 0 ms, value ms5 means 5 ms and so on.","paragraph_zero_based":49238},{"literal_text_all_w_t_and_m_t":"t-Reordering","paragraph_zero_based":49239},{"literal_text_all_w_t_and_m_t":"Value in ms of t-Reordering specified in TS 38.323 [5]. Value ms1 corresponds to 1 ms, value ms10 corresponds to 10 ms, and so on.","paragraph_zero_based":49240},{"literal_text_all_w_t_and_m_t":"thresholdIndex","paragraph_zero_based":49241},{"literal_text_all_w_t_and_m_t":"Indicates the index of thresholdMBS entry in thresholdMBS-List that is used for RRC connection resume for a UE receiving the corresponding multicast session in RRC_INACTIVE. Value 0 corresponds to the first entry in thresholdMBS-List, the value 1 corresponds to the second entry in thresholdMBS-List and so on.","paragraph_zero_based":49242},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49243},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":49244},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":49245},{"literal_text_all_w_t_and_m_t":"G-RNTI","paragraph_zero_based":49246},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if g-RNTI is included. Otherwise, it is absent.","paragraph_zero_based":49247}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["f1f1a8bd4c2ce0ff2190d833c4156934943a6c0ce838e88b544e41b0c75091d3","b8d94e233e8bbfc9354151737f98fd1574a92c90800edd94f9899b057e13ec31","82008fedf70654abc357d4a8e6d50d2d090f4cc145de5fbebe11370cc92f9998","5fc02999d7bf3f039b202fc3d37fda24e3246ffc2214ea197a5197d4b8d4a04a","b7284b025e741fbb0079287f8f78660bd80467d272e3c3d81f418578c07cc7eb","0df4dced8718e92c6678d1a87a38242f431d3fa5596d152c00e3241711405ae4","82b634ae3fc34f0233745f31c37bbfb118d74b8eb7344ddf7ee21224dbea0531","78025e07b1bbdb7ffe2cda9459615a854b5527c4834045a3cf52285a8efc8329","a691db654d5f037d8a0fe94fe2f87016ea9f066947090bd52510bd7d9eb169b4","273598940419f5a11d960b38298381071fdd4501542bddcfe2d9a2b10c2d60bb","49ac41377aed2d8d9c7876a0badd451f0a6ad55b11a2a4f6d4fd0d9740a43dc3","7c6a623f86611087477afe0011ed85cd0476907761c1784f55e8a2b2f4ae7bb7","5fda5274a236bb5bbff5bc725f09715290b3ce216c399b786a792e07e5d64523","a3fb7df0509ae83dd53bc9d39b238286bb57fecfeccf0ccdc5b4ddd13985cdea","5a7b4227ebd26eb2c97639d2ace9c82152acfa3ed7d400910535e1708164b29e","49a2b08743f9acd8953224b1ab945d58440cb0d2ef1684eda8db21c74f1473b3","5ffe6a585bef8d6d8717e7b3671e730ed586c1b83c4a91ac0bc7f04deeb948d0","9f54628bb37b43838cfa365116a1e4b7a0ce6f02e5cb52720a75dcfe1593329e","163cbe75c85c64af82ab0cd4ca4637fbbd89ac0d924dd524d876d0f6ce7b2d66","8443fc1cc9b56b2a4291957fb484b285dee9092eeb888507dd392618542df3a3","22cad43d7fbb28844622e1b5d51a8c778b13a3cc44f0119269dae761b8a3fd71","ad20b81247a12b2c22dbe2b36bb3cb170b238275dff2899e1ad6f6c537987ad7","cf0a47d721a60266702adbd0c3e7fac187df13290f9d4c97e061703ea021e109","8383e94b66f9b818605f43cc1b851993eabc3bde1daa5c6edcaf0d72cf5bcf19"],"paragraph_range_zero_based":[49224,49247],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p49224"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"MTCH-Mapping","paragraph_zero_based":49248},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the number of actual transmitted SSBs determined according to ssb-PositionsInBurst in SIB1 is more than 1, and searchSpaceMulticastMTCH is not set to zero (including the case where searchSpaceMulticastMTCH is absent and searchSpaceMulticastMCCH is not set to zero). Otherwise, it is absent, Need R.","paragraph_zero_based":49249},{"literal_text_all_w_t_and_m_t":"RRCRelease","paragraph_zero_based":49250},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if mbs-SessionInfoListMulticast is included in RRCRelease message. Otherwise, it is absent.","paragraph_zero_based":49251},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49252},{"literal_text_all_w_t_and_m_t":"–MTCH-SSB-MappingWindowList","paragraph_zero_based":49253},{"literal_text_all_w_t_and_m_t":"The IE MTCH-SSB-MappingWindowList is used to configure MTCH PDCCH ocassions to SSB mapping window related periodic and offset parameters.","paragraph_zero_based":49254},{"literal_text_all_w_t_and_m_t":"MTCH-SSB-MappingWindowList information element","paragraph_zero_based":49255},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":49256},{"literal_text_all_w_t_and_m_t":"-- TAG-MTCH-SSB-MAPPINGWINDOWLIST-START","paragraph_zero_based":49257},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49258},{"literal_text_all_w_t_and_m_t":"MTCH-SSB-MappingWindowList-r17 ::= SEQUENCE (SIZE (1..maxNrofMTCH-SSB-MappingWindow-r17)) OF MTCH-SSB-MappingWindowCycleOffset-r17","paragraph_zero_based":49259},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49260},{"literal_text_all_w_t_and_m_t":"MTCH-SSB-MappingWindowCycleOffset-r17 ::= CHOICE {","paragraph_zero_based":49261},{"literal_text_all_w_t_and_m_t":"    ms10                                      INTEGER(0..9),","paragraph_zero_based":49262},{"literal_text_all_w_t_and_m_t":"    ms20                                      INTEGER(0..19),","paragraph_zero_based":49263},{"literal_text_all_w_t_and_m_t":"    ms32                                      INTEGER(0..31),","paragraph_zero_based":49264},{"literal_text_all_w_t_and_m_t":"    ms64                                      INTEGER(0..63),","paragraph_zero_based":49265},{"literal_text_all_w_t_and_m_t":"    ms128                                     INTEGER(0..127),","paragraph_zero_based":49266},{"literal_text_all_w_t_and_m_t":"    ms256                                     INTEGER(0..255)","paragraph_zero_based":49267},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":49268},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49269},{"literal_text_all_w_t_and_m_t":"-- TAG-MTCH-SSB-MAPPINGWINDOWLIST-STOP","paragraph_zero_based":49270},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":49271}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["0f4c02650a26968a1926691cc9ddd4e817b1d142d087a5b93af5832bce8050db","cce5d20feba3bf60744673a5d27ebd96951166ac7ee19d979287b73f50471a40","37cf38e5938f5a7b72aab15cdb392c48edb0f57ca2dc6c77a7413d30a2801148","80b49cb16ec69014c8a95293dd154a9a2c86d00c4ef2809fc3fe732abe5a4466","d0e14b54e5e3551a47ab465408aaa45b3bda7c3ace7d11d1294aacd46e2d0419","77a483666dc3441a75d80b6529455380b9b72220b69abb7798c79d8b7f320d63","5b77b8c7215bdea874b410613ca02008571ed99f17c1f75186dc6815a140e1c3","0b2db7973c64860baa2c0cd0c2eb22253e9342a7da67346837b265d4b7dd26c1","9cc7b38af2d05d3143866fe859a75ad27caddd4740af4fb25fb67c5bf8a27f87","3b4e335551c0482d07e62072c2b83e07328fd12b0edbaf733e1fba3e60d06ed0","b8967f156ffc3bbf27c484da36aff0c2554920c6e09772486790b3a6760ef16a","ee2ea7470431d41bbbefeb65ca0c4e9afdc0eda3cf5af9c233dd7483a0c19482","95b8acb61779419dc760788664624e74f8368a14f041c5113ed46fee057f82bf","545938905635699d49ea97d81b32bdfd5bffcc90e54eb61fe41559b33a27c689","1984a9869dced7f5cd5fe67a71164dcb48d7575b90f5e73aefb94aad84a65f95","5d3f4ad4ef74370722543a73313f62636750c3050952e6e4226bdae92596712d","afb257479668484584644049638f26d1139bb02427d2e23ce3b62e3193694bff","41c8bdb5210470d1906f2853cd79a78f7a714de84e0914015cb3587b803bfe7e","4356eb28595231d74aa10ea603f6cb27f3551b13747e4c6c3ef196b7a8e74b51","2610c203d11787543d4b1eb475116a8eff8a09e080bd4824aea2f85992d579f5","fe86b7710d92aca3d1e6983197a5244d382cfc1f8ac44cd12ab8f3d4be88a273","421957fa393b6dd54a7763a2a51125aff9d7879e6c80dbe84287f28f29e754f3","bf498c66c8841b2a008479001448a9ab0c09dd8882288cfbc3d57b742ccdfe67","1fd1a153035b033adfc15f007141519e331f3c1437114393c494af779691bdab"],"paragraph_range_zero_based":[49248,49271],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p49248"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49272},{"literal_text_all_w_t_and_m_t":"MTCH-SSB-MappingWindowList field descriptions","paragraph_zero_based":49273},{"literal_text_all_w_t_and_m_t":"MTCH-SSB-MappingWindowCycleOffset","paragraph_zero_based":49274},{"literal_text_all_w_t_and_m_t":"Indicates the cycle and offset for MTCH PDCCH ocassions to SSB mapping. Values in unit of ms. ms10 corresponds to cycle of 10 ms with corresponding offset between 0 and 9 ms, value ms20 corresponds to cycle of 20 ms with corresponding offset between 0 and 19 ms, and so on. The mapping window starts at a subframe in a SFN where [(SFN number × 10) + subframe number] modulo (cycle) = offset.","paragraph_zero_based":49275},{"literal_text_all_w_t_and_m_t":"PDCCH monitoring occasions for MTCH in a mapping window which are not overlapping with UL symbols (determined according to tdd-UL-DL-ConfigurationCommon) are sequentially numbered starting from 1 in the maping window. The [x×N+K]th PDCCH monitoring occasion for MTCH in this mapping window corresponds to the Kth transmitted SSB, where x = 0, 1, ...X-1, K = 1, 2, …N, N is the number of actual transmitted SSBs determined according to ssb-PositionsInBurst in SIB1 and X is equal to CEIL(number of PDCCH monitoring occasions in MTCH to SSB mapping transmission window/N). The actual transmitted SSBs are sequentially numbered from one in ascending order of their SSB indexes.","paragraph_zero_based":49276},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49277},{"literal_text_all_w_t_and_m_t":"–PDSCH-ConfigBroadcast","paragraph_zero_based":49278},{"literal_text_all_w_t_and_m_t":"The IE PDSCH-ConfigBroadcast is used to configure parameters for acquiring the PDSCH for MCCH and MTCH.","paragraph_zero_based":49279},{"literal_text_all_w_t_and_m_t":"PDSCH-ConfigBroadcast information element","paragraph_zero_based":49280},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":49281},{"literal_text_all_w_t_and_m_t":"-- TAG-PDSCH-CONFIGBROADCAST-START","paragraph_zero_based":49282},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49283},{"literal_text_all_w_t_and_m_t":"PDSCH-ConfigBroadcast-r17 ::= SEQUENCE {","paragraph_zero_based":49284},{"literal_text_all_w_t_and_m_t":"    pdschConfigList-r17                    SEQUENCE (SIZE (1..maxNrofPDSCH-ConfigPTM-r17) ) OF PDSCH-ConfigPTM-r17,","paragraph_zero_based":49285},{"literal_text_all_w_t_and_m_t":"    pdsch-TimeDomainAllocationList-r17     PDSCH-TimeDomainResourceAllocationList-r16                          OPTIONAL,   -- Need R","paragraph_zero_based":49286},{"literal_text_all_w_t_and_m_t":"    rateMatchPatternToAddModList-r17       SEQUENCE (SIZE (1..maxNrofRateMatchPatterns)) OF RateMatchPattern   OPTIONAL,   -- Need R","paragraph_zero_based":49287},{"literal_text_all_w_t_and_m_t":"    lte-CRS-ToMatchAround-r17              RateMatchPatternLTE-CRS                                             OPTIONAL,   -- Need R","paragraph_zero_based":49288},{"literal_text_all_w_t_and_m_t":"    mcs-Table-r17                          ENUMERATED {qam256, qam64LowSE}                                     OPTIONAL,   -- Need S","paragraph_zero_based":49289},{"literal_text_all_w_t_and_m_t":"    xOverhead-r17                          ENUMERATED {xOh6, xOh12, xOh18}                                     OPTIONAL    -- Need S","paragraph_zero_based":49290},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":49291},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49292},{"literal_text_all_w_t_and_m_t":"PDSCH-ConfigPTM-r17 ::= SEQUENCE {","paragraph_zero_based":49293},{"literal_text_all_w_t_and_m_t":"    dataScramblingIdentityPDSCH-r17        INTEGER (0..1023)         OPTIONAL,   -- Need S","paragraph_zero_based":49294},{"literal_text_all_w_t_and_m_t":"    dmrs-ScramblingID0-r17                 INTEGER (0..65535)        OPTIONAL,   -- Need S","paragraph_zero_based":49295}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["3870df0d0eb257f962edf0338b1f68175175dedb73dba0baabbaf7799e595490","7dc578e9fe9e50588f432aa3ca69023b708cd9bc28be8d4a125c47fdb357a8fa","ee08b3b0e44c650cd8d62dee9845e89c870df093186d21ded16460d577babe2d","e3b2210b2c7d840a12254f0af651ed65ab63fc85d190f92a52b6d89011b7c6c9","3166b18fc37199dca93f160c95833daf70db9f122c77bc2b271e975b631a7219","b19b968e45450aa614fc18ae3a9d0270b5bd21d2a3d30018efc867faa3c99c5c","4ddac1957078c7831e8e3ba9fabd3c73b42e8fb8375cfc9b03896210d86aab9f","f3dd96c3baf80cb4eefe9f3b9cd5b27927cf9c8d46c50f2181161806957b88b1","f85db356bf58979d486d6d4e378c6fa57105324193d0761697745db924942d68","de17cf441148f205ea3e65e0b427014def3a7bef20f8ccb3630c5a91a97f8136","bb8b7f075bd9783a88f52b2f11c19c9d52fd4ec9dd512617532f426ebdc271d0","1933a6d729b0a703284bd3c7a1db7babfe19378a439056821b64f33d2abd53ee","ec5394ef16b5e089cd8d75c54281e8b96858ad3cd8f9eefbce69cc1c4ed646b9","2426bdc81a049391efc14cbec5a468ef699e5988e353c810ab393aece7ff8ae7","9a1e1e4199e6cf5dd5c6d8a51ab710743293798386b835e3cca1f1210a505f3d","8a30a5ed2e28e7a28ae8eb292f736ef31b106ab3713eb79d8c296158976d2712","c9700dd8f526a9e22f490fedb52c747be903b591a28c2d5466630f57cc8b0db0","9578649c16ca51fca17ac57d2ccc878159aeacc0640b49ab458c2fa0dbe875eb","5045cc46887fd0f36a95884776c5014b63b369e95705c6c1ae828aa623a782a8","b6ac50399083999b0a5b237500b18ddf085a5136b7c91fc571102ec236ecd81d","d4bb3bc18586818ace70e281489eea958e44cf35b6d5516c4a057e8d7f526b2b","73df88ce0cc76019945a4d30838aeb7038b890f4ea6972ade4b121c49d38409f","c532df520888c9500dffcd95904dfb3d7c61f28d252685404fffa90fe05fbf76","453ff5e59b37858c4a992084669420851403883d4039620a3b851e1e0b349051"],"paragraph_range_zero_based":[49272,49295],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p49272"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    pdsch-AggregationFactor-r17            ENUMERATED {n2, n4, n8}   OPTIONAL    -- Need S","paragraph_zero_based":49296},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":49297},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49298},{"literal_text_all_w_t_and_m_t":"-- TAG-PDSCH-CONFIGBROADCAST-STOP","paragraph_zero_based":49299},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":49300},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49301},{"literal_text_all_w_t_and_m_t":"PDSCH-ConfigBroadcast field descriptions","paragraph_zero_based":49302},{"literal_text_all_w_t_and_m_t":"lte-CRS-ToMatchAround","paragraph_zero_based":49303},{"literal_text_all_w_t_and_m_t":"Parameters to determine an LTE CRS pattern that the UE shall rate match around.","paragraph_zero_based":49304},{"literal_text_all_w_t_and_m_t":"pdschConfigList","paragraph_zero_based":49305},{"literal_text_all_w_t_and_m_t":"List of PDSCH parameters which can be configured per G-RNTI. Only one entity is allowed to be configured if included in SIB20.","paragraph_zero_based":49306},{"literal_text_all_w_t_and_m_t":"pdsch-TimeDomainAllocationList","paragraph_zero_based":49307},{"literal_text_all_w_t_and_m_t":"List of time-domain configurations for timing of DL assignment to DL data.","paragraph_zero_based":49308},{"literal_text_all_w_t_and_m_t":"The field pdsch-TimeDomainAllocationList applies to DCI format 4_0 (see table 5.1.2.1.1-1 in TS 38.214 [19]). When the field is absent, the UE follows PDSCH time domain resource allocation determination rule as specified in TS 38.214 [19], clause 5.1.2.1.1.","paragraph_zero_based":49309},{"literal_text_all_w_t_and_m_t":"rateMatchPatternToAddModList","paragraph_zero_based":49310},{"literal_text_all_w_t_and_m_t":"Resources patterns which the UE should rate match PDSCH around. The UE rate matches around the union of all resources indicated in the rate match patterns (see TS 38.214 [19], clause 5.1.4.1).","paragraph_zero_based":49311},{"literal_text_all_w_t_and_m_t":"mcs-Table","paragraph_zero_based":49312},{"literal_text_all_w_t_and_m_t":"Indicates which MCS table the UE shall use for PDSCH. If the field is absent the UE applies the value 64QAM. The field mcs-Table applies to DCI format 4_0 with CRC scrambled by MCCH-RNTI/G-RNTI (see TS 38.214 [19], clause 5.1.3.1).","paragraph_zero_based":49313},{"literal_text_all_w_t_and_m_t":"xOverhead","paragraph_zero_based":49314},{"literal_text_all_w_t_and_m_t":"Accounts for an overhead from CSI-RS, CORESET, etc. If the field is absent, the UE applies value xOh0 (see TS 38.214 [19], clause 5.1.3.2).","paragraph_zero_based":49315},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49316},{"literal_text_all_w_t_and_m_t":"PDSCH-ConfigPTM field descriptions","paragraph_zero_based":49317},{"literal_text_all_w_t_and_m_t":"dataScramblingIdentityPDSCH","paragraph_zero_based":49318},{"literal_text_all_w_t_and_m_t":"Identifier(s) used to initialize data scrambling (c_init) for PDSCH as specified in TS 38.211 [16], clause 7.3.1.1. When the field is absent the UE applies the value physCellId configured for this serving cell.","paragraph_zero_based":49319}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["dac367ff5750c5ec621b074974cddde7991f95626811747f5ecdfa383fc4efed","352ddc5c8ef0cc4e30cae44e426b59dec0906d1a53f4e4a7d6086b56d254275a","11eed52b8fe062dd9dd0cdc905589d61691deccbe7420b986d5213d537eb6fe0","88de17ea787e4054a3a97ace9bba61ae3bb1a158b8b59225a8d671