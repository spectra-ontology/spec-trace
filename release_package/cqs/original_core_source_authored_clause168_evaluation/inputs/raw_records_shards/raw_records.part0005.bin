{"fields":{"filename":"R2-2407524.zip::R2-2407524.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"NCR-MT","paragraph_zero_based":168},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":169},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":170},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":171},{"literal_text_all_w_t_and_m_t":"ncr-AperiodicBeamInd-AccessLink-r18","paragraph_zero_based":172},{"literal_text_all_w_t_and_m_t":"Indicates whether NCR supports aperiodic beam indication for access link. The UE indicates the value of supported slot-offset for reference slot. The value is selected based on the SCS of the PDCCH received by the NCR-MT. If 0 is reported, the NCR expects that the time resource in NCR-AperiodicFwdConfig of the aperiodic beam indication is at least after the end of time resource for PDCCH carrying the DCI for aperiodic beam indication.","paragraph_zero_based":173},{"literal_text_all_w_t_and_m_t":"NCR-MT","paragraph_zero_based":174},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":175},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":176},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":177},{"literal_text_all_w_t_and_m_t":"ncr-dft-S-OFDM-WaveformUL-r18","paragraph_zero_based":178},{"literal_text_all_w_t_and_m_t":"Indicates whether the NCR-MT supports DFT-S-OFDM waveform for UL and transform precoding for single-layer PUSCH.","paragraph_zero_based":179},{"literal_text_all_w_t_and_m_t":"NCR-MT","paragraph_zero_based":180},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":181},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":182},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":183},{"literal_text_all_w_t_and_m_t":"ncr-Semi-PersistentBeamInd-AccessLink-r18","paragraph_zero_based":184},{"literal_text_all_w_t_and_m_t":"Indicates whether NCR supports semi-persistent beam indication for access link, priority flag for semi-persistent indication and MAC CE override of the RRC configured of the beam index(es) at activation of semi-persistent beam indication.","paragraph_zero_based":185},{"literal_text_all_w_t_and_m_t":"NCR-MT","paragraph_zero_based":186},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":187},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":188},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":189},{"literal_text_all_w_t_and_m_t":"ncr-SimultaneousUL-BackhaulAndC-Link-r18","paragraph_zero_based":190},{"literal_text_all_w_t_and_m_t":"Indicates whether NCR supports simultaneous UL transmission of backhaul link and C-link.","paragraph_zero_based":191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e56e4fe7d8e6a5c607933a23a2f1897d8656bfbf7c4bce8238b8e629cd46568a","original_member_sha256":"e10e3900277b3ed34f68058bb1ac2dafe7ed9796062dcc576bb2e3c4decb02a1","paragraph_ElementTree_utf8_XML_sha256":["3c288d62c5b04d86edf2964da2e89e11af72123876c8f6497e95c72dddc669a8","485f1f25745d2da44c05d6d211651c93e1c257a9a39812c406fd06bdaa12d3e3","a35fce0e8cce6c4e6cdc53b1510b150c8ebd9b28b303f3cf9fc0831a02555110","a0767d1f1d1fce4413274dc0374063e4705c23a856ac53ca57e2562bd59cdb1d","9bcdd325b71b41cf10e17260c591972ddfdc40a47df972e196489cd964fbc1a7","042dea1fc92ba21a51654609e0fb8e6fc5b961b55637a3cb01bd3690d2ef7428","41552e4d5e5fa53b84d9bcd844d29683ea0ea129145cd0e2958079d36d214a75","49a9debfb59efa777daa853b4f17390ca338a8f38186692f19f3846d9a88467e","f04c97bcf7b712c39419fe26b53ba1cf075609201e1fcafd331d29405684a73b","b9262fa0a841d6669bd9380f20d5478b059c7cf42c511fa673de0005d2e2c2fb","0f9e76eb195ff8a233ea104f3db6127cf36effa32a592637ccfee5970a24fc1f","19a12ec94a2d37352e9b450403c3ec4649cc84480bd2d8f0f4c644b1987004c6","a0bc2b336e8572bf47babb7aaa832ed82cbac80a4b83f4e3ba5cac96114e681c","2f1f3d6e829868c1fc94695942c39b6a082dfc606e61b3f