3613e87c72e398dbc53bf8284f6054317cd68d889081aed0f097fa05","original_member_sha256":"f50d2ac5dc3173919b720b1789571429c99d34868211d7575a4df83d430ca020","paragraph_ElementTree_utf8_XML_sha256":["9bfaca1031737f971daefb34b620e4945c7fdc81bbe8f6dcebc4ebc28e2e733a","cc313598816c135f9b4b0199ae10a22964f6fa398f798f7f36f8cfaf4c12715b","976915b033533da8f1728d5f67548338dcfeb08c60486cadfe1f80f9c2394bc4","7ed67d3210e63403d65a54241a7e6557a73e453b91370f14ec489a7147a16596","cb6a241c5cedda03f7e04d3fcecd8b00ecc1dcf681c29043868a879cec6a8818","74d9e4fec91003eb5d8499f6a43847d65d61b3eb5bb673934f1e075deb6926cd","7d8b58e2ad83ff61c4f8c462f019883a3620eb13b7d5d769b588f99b37c9e1fe","f2b1fb02f401a49b86864e407b27b7ff6d7f90c3ef106358c1f50a2bcc872735","8740945a0ccb578d64dfe3896538ff0db1b1ba8b62bb04e7678b84185d093760","b7ef796b4a752135177281315ea4f84332c39cd621d34f861304ed3277b9a4e5","1e7ce662c1b2fc40ea187c6f537f48b432704727427dbb35052763537c4aa38b","453c419495047200ae96c3633e58f3efec4f850a349b714b7a31fca2b2dcf16f","ac8d639d73ce00c1107e79626104673ac42ace62579293babc98321d29cbdfb0","469a72a1dfe4c5b07fb6b792f151a14f9ad26147dbbb9aa4fb863ed8a42028ef","cdba4e3218c2b41312f2e53f95ed46623cce4bfe0902f3aa07f97341ea15ad67","f15b07cdffb72bb58fda4d79986e6624f890f4e0d6b14b383549a8cd531035e4","dfcd808509dadf5733ebb42ea0ae1f82118d4daa7ef217c86d1e55ee0afd994e","9e7edd87ae30551150370116c747b3c7fffc7ae9dbe8e0c06293f7b4a8a0ad9b","e105f803bf211eeaa7bba210a4f176fc4e3aed8cbab2e3ef2754544f8484d4f3","e7b5a7aeb0af54a4b15d4d7586d7bb900f386bfd07d9e1ad0f0e21fd18254b97","1100410aac90349b94289b7cdf2aefad0b232e28c346a555660b8119dcce019f","97cc80228be136c056bad11806735b6671f96ddc828c05192a9ae92f4dddbc07","c26df88aaa2a363d76d5827d85bc69f3da43eb61e44049acb512a79789fa3821","1b69ed6b4caad016efa6c9bd231d3e838fa5b0e37412e6a4b68e228c2ddffee0"],"paragraph_range_zero_based":[24,47],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2408878.zip::R2-2408878 - 38.331_CR5050_Rel18Mirror_Correction on SL Relay Measurement.docx:p24"}
{"fields":{"filename":"R2-2408878.zip::R2-2408878 - 38.331_CR5050_Rel18Mirror_Correction on SL Relay Measurement.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"A","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Rel-18","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-16(Release 16)Rel-17(Release 17)Rel-18(Release 18)Rel-19(Release 19)","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"    Rel-20(Release 20)","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"Reason for change:","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"The following text was agreed in R2-2407754 as normative text:","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"When evaluating the currently selected NR sidelink U2N Relay UE, the U2N Remote UE should apply layer 3 filtering as specified in 5.5.3.2 using the sl-FilterCoefficientRSRP in SIB12 (if in RRC_IDLE/INACTIVE), the sl-FilterCoefficientRSRP in sl-ConfigDedicatedNR (if in RRC_CONNECTED) or the sl-FilterCoefficientRSRP in SidelinkPreconfigNR (out of coverage), before using the SL-RSRP or SD-RSRP measurement results.","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"However, the current formulation of “the U2N Remote UE should apply” is ambigious for UE implementation. According to the drafting rules, the verbal form of ‘should’ is not mandatory behaviour. As a result, it is possible that the UE uses the incorrect filtercoefficient thereby affecting system performance.  ","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"Section 5.8.15.3","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"Update the text enforce the correct usage of filtercoefficient for the selected NR sidelink U2N Relay UE. ","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"70e786fb3613e87c72e398dbc53bf8284f6054317cd68d889081aed0f097fa05","original_member_sha256":"f50d2ac5dc3173919b720b1789571429c99d34868211d7575a4df83d430ca020","paragraph_ElementTree_utf8_XML_sha256":["84c96d2f0b36f95ff7dc724214a5fe664ea623b0eeb77a49e426a8da15c10a2d","b31ecb67bb16d8323d90f54a73d6eee981226e082570a993b93487b2ba50a927","110e3755c30d1739820cdf840898b0516e7789d9c1adafbd0921b17d4cd46d21","6be0f986a71f6af97220eae048c0808d3eba6b326d42deeb99fa09586e297819","73eb04ef48bd67cf0ae3529f9fcbe531683c483f7c474b825c6dcb3e524215f8","9ebb618879fa7a1cd27183c74b92c69cbe18e8eb3cf2e6a2a1e1a500c8e64eca","3ce755cf7271cbc8af87a401591ebc460c603a29e42a74d8db8aa28979d18cb3","69a3461c7f5e1c40922276d1b51fed4674dbb1d93a6e6ca172dd2b1638f4aad5","925174f89dfa2d902060201c6a6395649a5bbbde06ae65ec993981b9dd46ef44","3d69273d016dc0b1a49f6612a1e04518abada47e8fd28796ba233b9f02cf2ad7","f3f0b693750782607d579581c80ee852d83809ac2ef055b383572af33e758d33","48398198f8d0270348a45ab73b0815c243bdb951c72ef58dc0d7f1ee79377967","255117f7334d3945e3bf10ac86b872481743e7b67aee1e7f920930fca076356d","30355d9cf0ae5f2393898bc3a93495ddf842874212adc31c192f8d495be8c113","5ee0b7a9dca9df5fec14cc784782beb0915601860d4975710fe03838e917acfd","014abef4328f7cc247a7b9a91290d757e328c5fdc51a96181ad4572023e0dc7f","f22d5196ef7967e7c2eef7ec054dd3e20e1ff5d11ac716664d3dfab480b662bb","7eb90307cd3d3b72a70e971c720a3d4407a8fe338335bf04ac7396ef876ddb56","e25fd9f858bcadcdc7e98db67e45e002d469b4f32746aff724f9aef21e6d4124","08a357ad41f115c9a65b09c06a5be1ef1e348c1a3dbffefd3bb5f2164d59b5e7","8a49a140471fc0315d1806ef9124c8f7e91693f2c45605780fff796d9f051bcc","d5aea25cb5cbd80d45555585efe6f41d631d0aca8c7636dfc0bf92130796de25","3b4abf6920c2f128808e8f7b0fd67274b922c2c416e3a7e52e296cea3b498c95","a11270f5f06d7afd2c4172bd03040e5a448c3693bb6dc438b61256887e647c92"],"paragraph_range_zero_based":[48,71],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2408878.zip::R2-2408878 - 38.331_CR5050_Rel18Mirror_Correction on SL Relay Measurement.docx:p48"}
{"fields":{"filename":"R2-2408878.zip::R2-2408878 - 38.331_CR5050_Rel18Mirror_Correction on SL Relay Measurement.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Impact Analysis","paragraph_zero_based":72},{"literal_text_all_w_t_and_m_t":"Impacted 5G architecture options: NR SA, Sidelink","paragraph_zero_based":73},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":74},{"literal_text_all_w_t_and_m_t":"Impacted functionality:","paragraph_zero_based":75},{"literal_text_all_w_t_and_m_t":"The support of SL U2N relay operations.","paragraph_zero_based":76},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":77},{"literal_text_all_w_t_and_m_t":"Inter-operability:","paragraph_zero_based":78},{"literal_text_all_w_t_and_m_t":"1. If the network is implemented according to the CR and the UE is not, there will be no inter-operability issues.","paragraph_zero_based":79},{"literal_text_all_w_t_and_m_t":"2. If the UE is implemented according to the CR and the network is not, there is no inter-operability issues.","paragraph_zero_based":80},{"literal_text_all_w_t_and_m_t":"3. If one UE has implemented according to the CR and another UE has not, there is no inter-operability issue","paragraph_zero_based":81},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":82},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":83},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":84},{"literal_text_all_w_t_and_m_t":"Without this clarification, there is an ambiguity in UE implementation. In the current formulation, it can lead to the usage of the incorrect filtercoefficient affecting the system performance.","paragraph_zero_based":85},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":86},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":87},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":88},{"literal_text_all_w_t_and_m_t":"5.8.15.3","paragraph_zero_based":89},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":90},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":91},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":92},{"literal_text_all_w_t_and_m_t":"Y","paragraph_zero_based":93},{"literal_text_all_w_t_and_m_t":"N","paragraph_zero_based":94},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":95}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"70e786fb3613e87c72e398dbc53bf8284f6054317cd68d889081aed0f097fa05","original_member_sha256":"f50d2ac5dc3173919b720b1789571429c99d34868211d7575a4df83d430ca020","paragraph_ElementTree_utf8_XML_sha256":["fc35e3aa91bce3937ba0a92d1bd8e87fcf4682e0ff0197110363ec4f3438fdb1","b8421fc516ce0856b84176150948e7498e9e403a848297ce0ae9e25fe2d04a12","45dd974235460f4424f3da505f5386227eaefc2952552641feea019a0cf24a4f","118a005a8f34bece75d26fd550e062c165ab33a48bd36ebcfefad2bb56a33933","a917148f8366e2f5efa8f0c49dd7550a611a63e4fb3df18477e88a5a9be441da","5ae273d916859e54b95e13b7f1e9378adcb0f609942b2865ebb759323fa94544","615b962ab516279a732c1e887785c351fa3ce557265a22477fabf70be782cbb7","324c6621ae816611d3c609d80cb14648b71bc17d2dff9c760334efe2570776cd","11a4ce46230dc472d4e0ae42b17d9615065294aea70a4f956d84e1279a062bdc","7c9f9a84cc656adce7d6b26426e8723453c601147e5a5a37ece8b9ef7cea3419","10c0bf88b094c57d115e2ce229e2c8afbd1e05afab5bdcabfb5b935291298b5c","845e682240a111b299fc93f476b344e80578da1689c415ebf547779234c65851","ef5ce564430fa4e4a83d40884c8d080780d9b00c9eec659a22f0d0f23bffafc6","3e61c16d324f82ea473143968c7f37fd46acf1aba8302fd5dacca13a15f0d236","b5ee9b0f83006442375b36fe93b47f6e60f5b4e9036fd0b205564e9f0bd0598c","da8e781073d7d61439fa47af8d136a54400cc22a1658eb557ba7a5b1c599fda2","2eb665df7a5ab53057c2be869d70bea8a85ee72df61784da7d4ef6fb0adfcf1c","1a9444c1883b6e6a58c8e28670fb83e9b796b87a19093bc9a297dfc32d35f787","cc099452b9184d35a2