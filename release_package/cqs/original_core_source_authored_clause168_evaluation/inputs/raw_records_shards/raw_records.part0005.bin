{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49848},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":49849},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49850},{"literal_text_all_w_t_and_m_t":"6.5Short Message","paragraph_zero_based":49851},{"literal_text_all_w_t_and_m_t":"Short Messages can be transmitted on PDCCH using P-RNTI with or without associated Paging message using Short Message field in DCI format 1_0 (see TS 38.212 [17], clause 7.3.1.2.1).","paragraph_zero_based":49852},{"literal_text_all_w_t_and_m_t":"Table 6.5-1 defines Short Messages. Bit 1 is the most significant bit.","paragraph_zero_based":49853},{"literal_text_all_w_t_and_m_t":"Table 6.5-1: Short Messages","paragraph_zero_based":49854},{"literal_text_all_w_t_and_m_t":"Bit","paragraph_zero_based":49855},{"literal_text_all_w_t_and_m_t":"Short Message","paragraph_zero_based":49856},{"literal_text_all_w_t_and_m_t":"1","paragraph_zero_based":49857},{"literal_text_all_w_t_and_m_t":"systemInfoModification","paragraph_zero_based":49858},{"literal_text_all_w_t_and_m_t":"If set to 1: indication of a BCCH modification other than SIB6, SIB7, SIB8 and posSIBs.","paragraph_zero_based":49859},{"literal_text_all_w_t_and_m_t":"2","paragraph_zero_based":49860},{"literal_text_all_w_t_and_m_t":"etwsAndCmasIndication","paragraph_zero_based":49861},{"literal_text_all_w_t_and_m_t":"If set to 1: indication of an ETWS primary notification and/or an ETWS secondary notification and/or a CMAS notification.","paragraph_zero_based":49862},{"literal_text_all_w_t_and_m_t":"3","paragraph_zero_based":49863},{"literal_text_all_w_t_and_m_t":"stopPagingMonitoring","paragraph_zero_based":49864},{"literal_text_all_w_t_and_m_t":"This bit can be used for only operation with shared spectrum channel access and if nrofPDCCH-MonitoringOccasionPerSSB-InPO is present.","paragraph_zero_based":49865},{"literal_text_all_w_t_and_m_t":"If set to 1: indication that the UE may stop monitoring PDCCH occasion(s) for paging in this Paging Occasion as specified in TS 38.304 [20], clause 7.1.","paragraph_zero_based":49866},{"literal_text_all_w_t_and_m_t":"4","paragraph_zero_based":49867},{"literal_text_all_w_t_and_m_t":"systemInfoModification-eDRX","paragraph_zero_based":49868},{"literal_text_all_w_t_and_m_t":"If set to 1: indication of a BCCH modification other than SIB6, SIB7, SIB8 and posSIBs. This indication applies only to UEs using IDLE eDRX cycle longer than the BCCH modification period.","paragraph_zero_based":49869},{"literal_text_all_w_t_and_m_t":"5 – 8","paragraph_zero_based":49870},{"literal_text_all_w_t_and_m_t":"Not used in this release of the specification, and shall be ignored by UE if received.","paragraph_zero_based":49871}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["129842a1b266f0e492b878058c3feccc727f3f4de915083b45dd97ec3ad22310","31050fabaa8226ba6fac3bd6e1b4ec33817876a384f8b9c5533eb8f0d00c33c7","cf5e66f3d2a0bce57dbf0fd7ce0deec7c1c1bd766adbd2bac65a696d5c98a3ee","74928841497ff6c7dc13546d71e959ec0d337d366b0f8f51aad8239cc2e3bc9c","2bb280c5c16ad5ebcea3e15f164b6671e8c7a347fe91e64e462d6de3413bbf2c","16b30b352b556dbe223f9f7beb2293d13249b10ce07031429898fb2f48d73b43","08690c5c789b5f5934e93cffb6c57e4a532422e48bcc8d8066c401238711af30","08a40cb07ba2c45b2e5ea01404c432b4656129acf176817704bf7bd7965e396b","fb3983ff096d2296523d2fe89c08c2b70ee7f5d7353a65ea44fe9f1243a3c7c8","e2b3ae1c59181573f9031710afb4f9f91ffd89c9665d444b56a3ae79b8f1f9fb","ad960ff83d5c95566d9b9577b061864a5dcf24dea730243944fe8c