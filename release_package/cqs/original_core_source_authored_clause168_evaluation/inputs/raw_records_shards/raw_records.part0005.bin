{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference to release the configuration associated to applicabilityReportConfigId (e.g. due to model unavailability), if the applicabilityStatus is set toinapplicable.","paragraph_zero_based":4152},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4153},{"literal_text_all_w_t_and_m_t":"<Text Omitted>","paragraph_zero_based":4154},{"literal_text_all_w_t_and_m_t":"–CSI-LoggedMeasurementConfig","paragraph_zero_based":4155},{"literal_text_all_w_t_and_m_t":"The IE CSI-LoggedMeasurementConfig is used to configure a CSI logged measurement configuration. It defines a group of one or more CSI resources for which the UE logs the associated L1 radio measurements.","paragraph_zero_based":4156},{"literal_text_all_w_t_and_m_t":"CSI-LoggedMeasurementConfig information element","paragraph_zero_based":4157},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":4158},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-LOGGEDMEASUREMENTCONFIG-START","paragraph_zero_based":4159},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4160},{"literal_text_all_w_t_and_m_t":"CSI-LoggedMeasurementConfig-r19 ::=             SEQUENCE {","paragraph_zero_based":4161},{"literal_text_all_w_t_and_m_t":"    csi-LoggedMeasurementConfigId-r19               CSI-LoggedMeasurementConfigId-r19,","paragraph_zero_based":4162},{"literal_text_all_w_t_and_m_t":"    csi-LoggedResourceConfig-r19                    CSI-ResourceConfigId,","paragraph_zero_based":4163},{"literal_text_all_w_t_and_m_t":"    loggingPeriodicity-r19                          ENUMERATED {n2, n3, n4, n5, spare4, spare3, spare2, spare1}    OPTIONAL,  -- Need R","paragraph_zero_based":4164},{"literal_text_all_w_t_and_m_t":"    csi-LoggedMeasurementEventTriggerConfig-r19     CSI-LoggedMeasurementEventTriggerConfig-r19                    OPTIONAL,  -- Need R","paragraph_zero_based":4165},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":4166},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":4167},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4168},{"literal_text_all_w_t_and_m_t":"CSI-LoggedMeasurementEventTriggerConfig-r19 ::= SEQUENCE {","paragraph_zero_based":4169},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4170},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4171},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4172},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4173},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4174},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4175}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["be8d98fca299f188616306788ea4369bc63d5d21bca2885f9196deafa1755ca8","9db760ff99eac1609b81637d75ecdf296df9f053a9c63d2e319cb0457b694409","6feb2a8fbed29b0914b8304bda4ed191a6ff314cbf9397695a372998691ed208","2b30937513417984fdd4f1d70cef9f43f0c9b82783b557fd40648806e75c2ab0","d25de247204693f57da00e8bf5f17b74201a6bdf6babb35ad74ea61b5de3f0d2","b22c31e2de2094195a73788a7900a5262365b303df0a595bfe5979ee9f6fd50c","6ac9b9d84b9cd86ff1748bd2849f5a5eaa4c7b34a1490d46cce60f115b5555e3","0673372a17453841718eb6f67e3229909457814404c3b83d8304c6f4a4c688bd","41d0cf486b418e08c28cb629d5add5b03fcc87e33f43024b7b28e38fd2c65451","22b59a24be365a580e1382fb502c2eeed0de3d6be44a1b78d0ab528f9e51f938","4ca3a4c49975d4de7e52024d56034698b2a45b279d95e166ce49d2d27a5717ad","abec9ef784c6ddbca7932c6c0ad8fbbe46d63e77230c7eca815f8ff85304ef44","3049e9353c0df1bf0910ee720aebaf264f2