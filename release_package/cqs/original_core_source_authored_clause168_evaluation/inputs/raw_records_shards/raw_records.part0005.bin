{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    sl-TimeInterval-r16                    INTEGER (0..639)                                                    OPTIONAL     -- Need R","paragraph_zero_based":48720},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":48721},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48722},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SYNCCONFIG-STOP","paragraph_zero_based":48723},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":48724},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48725},{"literal_text_all_w_t_and_m_t":"SL-SyncConfig field descriptions","paragraph_zero_based":48726},{"literal_text_all_w_t_and_m_t":"gnss-Sync","paragraph_zero_based":48727},{"literal_text_all_w_t_and_m_t":"If configured, the synchronization configuration is used for SLSS transmission/reception when the UE is synchronized to GNSS. If not configured, the synchronization configuration is used for SLSS transmission/reception when the UE is synchronized to eNB/gNB.","paragraph_zero_based":48728},{"literal_text_all_w_t_and_m_t":"sl-SyncRefMinHyst","paragraph_zero_based":48729},{"literal_text_all_w_t_and_m_t":"Hysteresis when evaluating a SyncRef UE using absolute comparison.","paragraph_zero_based":48730},{"literal_text_all_w_t_and_m_t":"sl-SyncRefDiffHyst","paragraph_zero_based":48731},{"literal_text_all_w_t_and_m_t":"Hysteresis when evaluating a SyncRef UE using relative comparison.","paragraph_zero_based":48732},{"literal_text_all_w_t_and_m_t":"sl-NumSSB-WithinPeriod","paragraph_zero_based":48733},{"literal_text_all_w_t_and_m_t":"Indicates the number of sidelink SSB transmissions within one sidelink SSB period. The applicable values are related to the subcarrier spacing and frequency as follows:","paragraph_zero_based":48734},{"literal_text_all_w_t_and_m_t":"FR1, SCS = 15 kHz: 1","paragraph_zero_based":48735},{"literal_text_all_w_t_and_m_t":"FR1, SCS = 30 kHz: 1, 2","paragraph_zero_based":48736},{"literal_text_all_w_t_and_m_t":"FR1, SCS = 60 kHz: 1, 2, 4","paragraph_zero_based":48737},{"literal_text_all_w_t_and_m_t":"FR2, SCS = 60 kHz: 1, 2, 4, 8, 16, 32","paragraph_zero_based":48738},{"literal_text_all_w_t_and_m_t":"FR2, SCS = 120 kHz: 1, 2, 4, 8, 16, 32, 64","paragraph_zero_based":48739},{"literal_text_all_w_t_and_m_t":"All values in sl-NumSSB-WithinPeriod in sl-SSB-TimeAllocation1 is set to be same across all carrier frequencies configured for UEs performing NR sidelink communication on multiple carrier frequencies, if configured. All values in sl-NumSSB-WithinPeriod in sl-SSB-TimeAllocation2 is set to be same across all carrier frequencies configured for UEs performing NR sidelink communication on multiple carrier frequencies, if configured. All values in sl-NumSSB-WithinPeriod in sl-SSB-TimeAllocation3 is set to be same across all carrier frequencies configured for UEs performing NR sidelink communication on multiple carrier frequencies, if configured.","paragraph_zero_based":48740},{"literal_text_all_w_t_and_m_t":"sl-TimeOffsetSSB","paragraph_zero_based":48741},{"literal_text_all_w_t_and_m_t":"Indicates the slot offset from the start of sidelink SSB period to the first sidelink SSB. All values in sl-TimeOffsetSSB in sl-SSB-TimeAllocation1 is set to be same across all carrier frequencies configured for UEs performing NR sidelink communication on multiple carrier frequencies, if configured. All values in sl-TimeOffsetSSB in sl-SSB-TimeAllocation2 is set to be same across all carrier frequencies configured for UEs performing NR sidelink communication on multiple carrier frequencies, if configured. All values in sl-TimeOffsetSSB in sl-SSB-TimeAllocation3 is set to be same across all carrier frequencies configured for UEs performing NR sidelink communication on multiple carrier frequencies, if configured.","paragraph_zero_based":48742},{"literal_text_all_w_t_and_m_t":"sl-TimeInterval","paragraph_zero_based":48743}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["29078a88fc6fb156e074b72db106df559a895872f393674cebd17b0335cbef6d","350077acf87e0019908f9d59405fef9afef4f76139540f426a2cd619504eaca2","30e7217f23dca9dcef8788a381e9870d838f7c765f03114b7524ba40ed667677","c8c80f4f8f28d33e957c5e8da9b6b3e245676ec15b7e754331218f99c10b815b","f6663a16c61f0be453902b84ccef68cd0d29c50aa56359ff06c3e55027928d71","47a6def99db3a1d3e4a35020298e763ffb83f239a358b13290fbaa0635b10923","7c6d3a0ba7ca285316d8a42d1e6688772ee8c8da6463260c29ad7a8224c14519","71d44fd0602252aac941d525d0688ef7e0895596aa6029b61f0f23622b9f19a5","b739e6ae28c5794e8b706bb770e46cc9a5c4c7eb38c76ed49b676d37c6c743f5","b7a0017f8bebac8171b218e766042fa18b31ac1291926139fbad0b1306f09c74","7be39a79ce7d91d540254703c755efb6807425534674de6bd28a43b466eefba0","efe2b06954c19af5692946c2c22bc5ed4ccd92fc2c0b45a6d217dee1f4056046","af7d6b72540f7ed6f00b817f7177403794a0c245dbff59fa90d627fb531bca7e","b7bda6d16a10b38da1fc98af52655a450b16f27882f89a679f4aa59fd295bdaf","0889f971aea16a6ae7c1da0326dc61470fafd90b758932b6130607834de9d45e","06f2c66a7f62ccffba7ff0286363c8ed9eb981e0967a81b114dc2831c4fe6c0f","1a7077a6f5ec1f7805af507b1e15c7f25198b8090cbccb95aae7c75261b10c58","aac2ea729c4120b6b3d46c53d32b5a2c46a6e7a94ef458a15e47d6e4b4702bd8","18520118108e062b89b2ee783feed9f951007c849b648d8c69a1fa551fb8a240","e987cc2d4b43f1393289455a34319bc48af594fd5a8e4c7d60c1301bee422e6a","fba8bbd0685f76669d59e1ae82ff10c7725a252faf4a54b2953db94dd206fdde","c0e672e69d0edd63086f1344ac3b3c0b2eff5c5b0fa7ac9ec32cb17398c0fe47","94c4f3eec1af2e292f3a07ef15db3239a7fd538731cb506bca6455a4bb1f1d00","aa9ef6ff6378ce4342af7b7c8b17672e895b6a6e7cff90068cf2cf4bc9b54fa8"],"paragraph_range_zero_based":[48720,48743],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p48720"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the slot interval between neighboring sidelink SSBs. This value is applicable when there are more than one sidelink SSBs within one sidelink SSB period. All values in sl-TimeInterval in sl-SSB-TimeAllocation1 is set to be same across all carrier frequencies configured for UEs performing NR sidelink communication on multiple carrier frequencies, if configured. All values in sl-TimeInterval in sl-SSB-TimeAllocation2 is set to be same across all carrier frequencies configured for UEs performing NR sidelink communication on multiple carrier frequencies, if configured. All values in sl-TimeInterval in sl-SSB-TimeAllocation3 is set to be same across all carrier frequencies configured for UEs performing NR sidelink communication on multiple carrier frequencies, if configured.","paragraph_zero_based":48744},{"literal_text_all_w_t_and_m_t":"sl-SSID","paragraph_zero_based":48745},{"literal_text_all_w_t_and_m_t":"Indicates the ID of sidelink synchronization signal associated with different synchronization priorities.","paragraph_zero_based":48746},{"literal_text_all_w_t_and_m_t":"syncInfoReserved","paragraph_zero_based":48747},{"literal_text_all_w_t_and_m_t":"Reserved for future use.","paragraph_zero_based":48748},{"literal_text_all_w_t_and_m_t":"syncTxThreshIC, syncTxThreshOoC","paragraph_zero_based":48749},{"literal_text_all_w_t_and_m_t":"Indicates the thresholds used while in coverage and out of coverage, respectively. Value 0 corresponds to -infinity, value 1 to -115 dBm, value 2 to -110 dBm, and so on (i.e. in steps of 5 dBm) until value 12, which corresponds to -60 dBm, while value 13 corresponds to +infinity.","paragraph_zero_based":48750},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48751},{"literal_text_all_w_t_and_m_t":"–SL-Thres-RSRP-List","paragraph_zero_based":48752},{"literal_text_all_w_t_and_m_t":"IE SL-Thres-RSRP-List indicates a threshold used for sensing based UE autonomous resource selection (see TS 38.215 [9]). A resource is excluded if it is indicated or reserved by a decoded SCI and PSSCH/PSCCH RSRP in the associated data resource is above the threshold defined by IE SL-Thres-RSRP-List. A NR sidelink resource is excluded if the corresponding PSFCH transmission occasions overlap with resources indicated or reserved by the decoded EUTRA SCI in time domain and EUTRA PSSCH RSRP in the associated data resource is above the threshold defined by IE sl-NRPSFCH-EUTRA-ThresRSRP-List. A NR sidelink resource is excluded if it is indicated or reserved by the decoded EUTRA SCI and EUTRA PSSCH RSRP in the associated data resource is above the threshold defined by IE sl-NRPSSCH-EUTRA-ThresRSRP-List. Value 0 corresponds to minus infinity dBm, value 1 corresponds to -128dBm, value 2 corresponds to -126dBm, value n corresponds to (-128 + (n-1)*2) dBm and so on, value 66 corresponds to infinity dBm.","paragraph_zero_based":48753},{"literal_text_all_w_t_and_m_t":"SL-Thres-RSRP-List information element","paragraph_zero_based":48754},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":48755},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-THRES-RSRP-LIST-START","paragraph_zero_based":48756},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48757},{"literal_text_all_w_t_and_m_t":"SL-Thres-RSRP-List-r16 ::=    SEQUENCE (SIZE (64)) OF SL-Thres-RSRP-r16","paragraph_zero_based":48758},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48759},{"literal_text_all_w_t_and_m_t":"SL-Thres-RSRP-r16 ::=         INTEGER (0..66)","paragraph_zero_based":48760},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48761},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-THRES-RSRP-LIST-STOP","paragraph_zero_based":48762},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":48763},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48764},{"literal_text_all_w_t_and_m_t":"–SL-TxPower","paragraph_zero_based":48765},{"literal_text_all_w_t_and_m_t":"The IE SL-TxPower is used to limit the UE's sidelink transmission power on a carrier frequency. The unit is dBm. Value minusinfinity corresponds to –infinity.","paragraph_zero_based":48766},{"literal_text_all_w_t_and_m_t":"SL-TxPower information element","paragraph_zero_based":48767}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["2191d49d2400b10319efba683a2fbf71ed65945417276de5cb69c4fe0ae1c2b2","99a767ee2584a227ab0ccbb96c225bf7c7d0d0a348274dba849779499c510413","3e67f05f4c00aef9b77e50b08809f4e202041a200dad56eea6633558c711c733","8eb8213eab4d1018597d2317e788b31958c95e5f8435b014feab248ad71014af","62ed20934e3eb7deb7351880aacd9bb1a706df489bdfa0a1865c1f8ed36d6952","da9473e2b63a8e45f8b19c9d51670675f64a1c23df0391070149868836db1dc5","6ce3ca3fdadb66bd74f6803f04363ae7a9c326dda236e7669efc3ae5baa74b15","033c20dc49cb720adf2536dcebd2de985a42a392714f6650362799f8183032d3","8eb5f04cabb96de32d3dadb5d92b1c6410314e1922e723d7ebf0d28ea488b1b6","925e44f4badbe9b1045e63df371bf2f874e7765ed97a67f29535e7b8b27d55a2","9213e23b584993b86cd7734ce721259cfc5e876d23e9f3c43c614a7b6adf9807","fe6b128c38131ebbc3b94cda37edeffe158d6f9fd218b0009277a98c6d9940c1","8649f5b1d0b8272abf41b936b8cc9da59b0ecf84847dfe9ca72c898400dbb708","724814e44fad269783f8a3124ff74c85cd265951a5c9f622399455dde00e4967","60f3ded0b32601bcde9e984ea270843b5118f70d6ec707f5407009f13c896f65","1d64038c540bba68bd2444059157ba28af7222aa70afc0077a16a29f93d48a8c","5b92eb3b208f12212872fc13ed48608268173638e7e4fdfbb9debbc5d9746f4e","69355c7ce1f706501cad5f2059d52e0e7da20aedc3288d9ec92217a8