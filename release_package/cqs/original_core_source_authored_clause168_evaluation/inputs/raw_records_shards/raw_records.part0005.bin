{"fields":{"filename":"R2-2408475.zip::R2-2408475-Introduction of new capability for intra-band EN-DC channel spacing(38.306).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":72},{"literal_text_all_w_t_and_m_t":"Inter-operability:","paragraph_zero_based":73},{"literal_text_all_w_t_and_m_t":"If the network is implemented according to the CR and the UE is not, no inter-operability issue.","paragraph_zero_based":74},{"literal_text_all_w_t_and_m_t":"If the UE is implemented according to the CR and the network is not, no inter-operability issue.","paragraph_zero_based":75},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":76},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":77},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":78},{"literal_text_all_w_t_and_m_t":"The UE indicating support of “non-contiguous” intra-band EN-DC cannot access to the contiguous intra-band EN-DC combination configured by the NW.","paragraph_zero_based":79},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":80},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":81},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":82},{"literal_text_all_w_t_and_m_t":"4.2.7.9","paragraph_zero_based":83},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":84},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":85},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":86},{"literal_text_all_w_t_and_m_t":"Y","paragraph_zero_based":87},{"literal_text_all_w_t_and_m_t":"N","paragraph_zero_based":88},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":89},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":90},{"literal_text_all_w_t_and_m_t":"Other specs","paragraph_zero_based":91},{"literal_text_all_w_t_and_m_t":"x","paragraph_zero_based":92},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_ba