{"fields":{"filename":"R2-2503193.zip::R2-2503193 UE capability_final.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":408},{"literal_text_all_w_t_and_m_t":"FR1 only","paragraph_zero_based":409},{"literal_text_all_w_t_and_m_t":"resumeAfterSDT-Release-r18","paragraph_zero_based":410},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports immediate RRC connection resume procedure triggering after receiving RRCRelease message with a resumeIndication included during an ongoing SDT procedure, as specified in TS 38.331 [9].","paragraph_zero_based":411},{"literal_text_all_w_t_and_m_t":"The UE indicating support of this feature shall also support any of ra-SDT-r17, ra-SDT-NTN-r17, cg-SDT-r17, mt-SDT-r18, mt-SDT-NTN-r18 or mt-CG-SDT-r18.","paragraph_zero_based":412},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":413},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":414},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":415},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":416},{"literal_text_all_w_t_and_m_t":"resumeWithStoredMCG-SCells-r16","paragraph_zero_based":417},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports not deleting the stored MCG SCell configuration when initiating the resume procedure.","paragraph_zero_based":418},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":419},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":420},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":421},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":422},{"literal_text_all_w_t_and_m_t":"resumeWithStoredSCG-r16","paragraph_zero_based":423},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports not deleting the stored SCG configuration when initiating resume. The UE which indicates support for resumeWithStoredSCG-r16 shall also indicate support for resumeWithSCG-Config-r16.","paragraph_zero_based":424},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":425},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":426},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":427},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":428},{"literal_text_all_w_t_and_m_t":"resumeWithSCG-Config-r16","paragraph_zero_based":429},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports (re-)configuration of an SCG during the resume procedure.","paragraph_zero_based":430},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":431}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"56654f9bd149b93ddfaf012bcd674e18c374f6dd7ddf1cc1792dc12229297094","original_member_sha256":"56fb020b0b8197f2dc7d5bb3d81730ac42e27dd1effda03bff60ba62025e75eb","paragraph_ElementTree_utf8_XML_sha256":["1ce3d5cab289ede12b575608788de8cf61139198663624f7c69a922840b8ff41","92842342e8146bd37d46b2f688dc5c9a2f3b14a38fe753486b26ec564721df50","e313c03f238876df011438aecc38d7ba54735df99b376426efc37862790bf60e","67d8730e9ee8d1a2b212b1d95200045df95175c257f29f69dcb5b932b214e2ba","50117b4c8bd719cfb5d2d3dda4bda29c6deb8af3c4e2a694e8f7c24a04b4048f","59efc9067d4bd8d0a6cd1bbb7d1b74b63594e15bcac3b6f19721a0649a72d726","973e4660c472881c54db83ff1f4e8c5b1a89522c3da665e3282a14976585d37e","bce090aa6be9ad8b3955b48dbd6debae09e2e7a4af48ddc650ae5ba9c1515faa","d95a13bcb6a583244cfffbae398447551b2cf1cffb6dec2ff4c6ede8b16a0dc7","aa5f7ac4cee157dbdb277f9ba92745cd4f80fb1c142090cf7b4ec7725d1f80e5","6b8799add9c8f65e26b37887e8ebd8d1fcf75f2934c954aa58e045cb8e852245","4e56637cd77ab59453552d3d646c8b653cf7c932b0b0de0eb09d5a8d65037c7e","2af12d70a8a7dcbc73585acbfb32696804db9afb0fedfa193e5c862d9c204325","88c77eaf225a4581cab27ad211441318fbb7bc82d62072ababd50bfa00219941","e39509a186dbab5d1b90c64608fdbb461688cf78642f5b2166ffbf7195bc8a73","8d59d0b49dfb281323eddb94444d8a0b85008de295e23d6a0526e11bec0be2e6","7cd855e3145bd3e9dfdd00e96f94b3577eeda12841ac56885340a88dd9371504","26830bf0f554dff95086a17365bc1fc306d11adf9a2f13fed4e3b7da97ecba69","64be2c862470ec876b9d5fc08e58485269f1c58434bcb465fd9c8c584b058273","3005bcd1c6639083a03491ac1f0e820a2c82ec622d4ceffb49eceb2058e7b445","743f54cceeb6d8422c2e2be80eff4f55a9f7635b38f412c3fc4a044bca576f2f","433537088326ccb2900d0481e88bcd755e4d5c65f7a7122510294275142e29d8","23f94f4a2681320ab83fa2a55125d12ce9e12ce4d3f3af13a692d55e7bc6856d","1177283b3363252a49e79da60ce505229324765c71d8e6f7aa88c25b3e6c6f8d"],"paragraph_range_zero_based":[408,431],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2503193.zip::R2-2503193 UE capability_final.docx:p408"}
{"fields":{"filename":"R2-2503193.zip::R2-2503193 UE capability_final.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":432},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":433},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":434},{"literal_text_all_w_t_and_m_t":"sib19-Support-r18","paragraph_zero_based":435},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE in RRC_CONNECTED in a TN cell supports reception of SIB19 to acquire satellite assistance information for NTN access. A UE supporting this feature shall also indicate the support of nonTerrestrialNetwork-r17.","paragraph_zero_based":436},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":437},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":438},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":439},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":440},{"literal_text_all_w_t_and_m_t":"sliceInfoforCellReselection-r17","paragraph_zero_based":441},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports slice-based cell reselection information in SIB and on RRC release for slice-based cell reselection in RRC _IDLE and RRC INACTIVE as defined in TS 38.304 [21].","paragraph_zero_based":442},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":443},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":444},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":445},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":446},{"literal_text_all_w_t_and_m_t":"splitSRB-WithOneUL-Path","paragraph_zero_based":447},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports UL transmission via MCG path and DL reception via either MCG path or SCG path, as specified for the split SRB in TS 37.340 [7]. The UE shall not set the FDD/TDD specific fields for this capability (i.e. it shall not include this field in UE-MRDC-CapabilityAddXDD-Mode).","paragraph_zero_based":448},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":449},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":450},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":451},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":452},{"literal_text_all_w_t_and_m_t":"softSatelliteSwitchResyncNTN-r18","paragraph_zero_based":453},{"literal_text_all_w_t_and_m_t":"Indicates whether UE supports soft satellite switch with re-sync, as specified in TS 38.331 [9].","paragraph_zero_based":454},{"literal_text_all_w_t_and_m_t":"A UE supporting this feature shall also indicate support of hardSatelliteSwitchResyncNTN-r18.","paragraph_zero_based":455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"56654f9bd149b93ddfaf012bcd674e18c374f6dd7ddf1cc1792dc12229297094","original_member_sha256":"56fb020b0b8197f2dc7d5bb3d81730ac42e27dd1effda03bff60ba62025e75eb","paragraph_ElementTree_utf8_XML_sha256":["8de74ae4137a683bb40a6c9957afe9ddc9866512a6ad423267a6d30c453b79ff","d53e3882c6e13dd67c887284efdf72cc35a30b0246c0af63936c5e0aeeed331d","07cc8d3852071f576ed54f446151add6cfc1edcd41a0f31155a7ea19800c6743","e0d0369fff56682a2c1e28b9b820b64e3e1b9ffdab0486895606c304cdbd20eb","54ec53bb28eb39bf74bed8162d23bf97620787eb540fe49c65b6556687965590","86c20fd2d1bd0532617b81f1886ea61a17a571bf62354cb22c85491844f82c79","4358bb096ecd1ad556cdd87ce0e46ef862e9743c4678288f6337e629b6390e0e","79cd72297510e2ea3cdc3b73b3c82f6059a8570ed47598d19dbec5a30b106708","af838337e88a49d63340ec8fdac58da1228fb23495b73505da0adf482e2a6b5b","56b74e712714f1c5a72f784e79c6a4d727251e983e198ad0760509c8084e649d","ef572faa2750af7402f2a7929a77d9b568c67e2ad1585b1b0a2c4f2c838b5908","4eb2695bf03f20448a2ad83e3226f0c2200f00e356a90d7549e3b30fece56db0","08f4dab928da69a14df80356f842609b0693947839d5777ae8d9621ad9ae1e76","28d2eef0036aa5fe201d045e42cd542f2013df8fd2404e89cc87a41497bb370f","6e5744c6a66633b092adc980f95d2b9a636b62431d8a392f0784dd40c05fc95d","16cbdebdbff5f562a19f555b014a3f8c46edd5c7d10cc4bcb82a26dc63136dc8","9e92a4dad56738c1eac4d0aa8e860279d23e5d767512970f33478e9c1fbe6cba","85c4896ed124a824ad4ce8f0e46a3a7a8eae422d53142f2b10d63e04b18ece6e","8e60338adca06962a09da8120165465f6cfcca617f381be447c9eb1f49bf34ab","2628ec1f53541b94158ac2b57c450ae811f396eb094b7b34d3ae50a5a4993a50","b2a3c20c7d384685a87dc0d7cf8f1b32a3d448188b40972249772eafea200e18","18e9f5b9d64b27906132e3409761eb356771531deb30e25b05fb69c168d92bfe","57bb75b80e6615535e6915b11051f6e6130f92898a8b19c9bc9d9cd45cf1f421","5b3ed75ee2d90a9a7cf52e10642484929bb8064eaa3a5a679f2f57b14f3a45a7"],"paragraph_range_zero_based":[432,455],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2503193.zip::R2-2503193 UE capability_final.docx:p432"}
{"fields":{"filename":"R2-2503193.zip::R2-2503193 UE capability_final.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":456},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":457},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":458},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":459},{"literal_text_all_w_t_and_m_t":"splitDRB-withUL-Both-MCG-SCG","paragraph_zero_based":460},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports UL transmission via both MCG path and SCG path for the split DRB as specified in TS 37.340 [7]. The UE shall not set the FDD/TDD specific fields for this capability (i.e. it shall not include this field in UE-MRDC-CapabilityAddXDD-Mode).","paragraph_zero_based":461},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":462},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":463},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":464},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":465},{"literal_text_all_w_t_and_m_t":"srb3","paragraph_zero_based":466},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports SRB3 which is a direct SRB between the SN and the UE as specified in TS 37.340 [7]. The UE shall not set the FDD/TDD specific fields for this capability (i.e. it shall not include this field in UE-MRDC-CapabilityAddXDD-Mode). This field is not applied to NE-DC.","paragraph_zero_based":467},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":468},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":469},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":470},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":471},{"literal_text_all_w_t_and_m_t":"srb-SDT-NTN-r17","paragraph_zero_based":472},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports the usage of signalling radio bearer SRB2 for MO-SDT (over RA-SDT or CG-SDT) or MT-SDT (over RA or CG-SDT) in NTN, as specified in TS 38.331 [9].","paragraph_zero_based":473},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":474},{"literal_text_all_w_t_and_m_t":"A UE supporting this feature shall also indicate support of ra-SDT-NTN-r17, cg-SDT-r17, mt-SDT-NTN-r18 or mt-CG-SDT-r18 in NTN bands. A UE supporting this feature shall also indicate the support of nonTerrestrialNetwork-r17.","paragraph_zero_based":475},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":476},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":477},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":478},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"56654f9bd149b93ddfaf012bcd674e18c374f6dd7ddf1cc1792dc12229297094","original_member_sha256":"56fb020b0b8197f2dc7d5bb3d81730ac42e27dd1effda03bff60ba62025e75eb","paragraph_ElementTree_utf8_XML_sha256":["98692fcae98f9e758fba6bedd3503ba143f36e2418468c19f1ca675f29bd71af","de4fb951d5d1e0c2741465df5fb3dc74adaf9e2d9c6e2a242e47252978a78967","da63863db15c089f121b5cb972e0ea554e11fc95d81f4d6ba6519d2ce72aea03","eddc60332d904617e895e59c610971a9c05bc7ec3cecab56fbb7c1ab29a4942c","cabf7e14942a91495e249d45a62f1cb5f9cf1266f6a5f7dee706e34c37ea17f3","892f3e4b54def45f04092e16d1d25f94dcb3bf6ad0ae8f46bf0d6bdc560fd22f","0e212bb2c5d6ecff963e20eb9485294231aa5c7714d0b76dd1543dae1c4ec3f7","2c90951c15a426976ee3955d77146a97c388a442dca0c6f5f6463649429f7e2b","0be9ac33afb2924d70296fbc7928c907a6ab9776110913849b2c5ff52bb058c9","c6b6dd0c78df623c7c6c652f51d9ee692aadc49b6831bb1f6500962692e9d317","c297ea8483f604b432838261bcee4c6c76d4467e4f175d74ea0bdcdd9fdf7b74","07dcabf3cc9c8130d2bf668d4de24666e3cfc98d805d5eaedc4d1d10023cf0b7","e6aa5458a7789156ea0fa9e280973b7a3dd67cb90a9e44b67a46ffb97ec3a9fc","41db1d9fde0f2187a6aed0d5119f439f80784ba713d134d823ca06cc5f957d89","9bbb299266f28200c0589784e34603b8c541f384aeff8c1dc33e900c654f59a7","9cc9f28fca11d09367e0c25f9c61daea3f5f74ce1e2e49be2c9e13dcf98252c7","b2cb54a083e55172bdcf39b5b12464be2cc1b210629544cb2802ea0e9ddae49e","b9559c7db885b52938410b1632c06ed56b62d803566ee8b6895532f91de32cf2","d8037660d0b562cf026d5d44629ecb9c3b1e75ff813907d0ecbfcacc6bbc8be2","2ac050a4be9af31bd4db57ef1fb1db9d4310f03154870ec7a3b27448838f67c3","024ea66fae78e815f91f5267aa33bffc022436839a0a966e787b3451c93e4ba9","e17a56f8777a3aed77d93c9b84c990f299a6163b9eee54f5113644c334441f6b","46ab71b9bf8adb2d18109f724b7d94176c37728d76669b9f82f553cd05efd745","e3624c370aed47ac27f7b2ebc2e7c68d83cc843ecd96123d7191a211d7588d6b"],"paragraph_range_zero_based":[456,479],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2503193.zip::R2-2503193 UE capability_final.docx:p456"}
{"fields":{"filename":"R2-2503193.zip::R2-2503193 UE capability_final.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"srb-SDT-r17","paragraph_zero_based":480},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports the usage of signalling radio bearer SRB2 for MO-SDT (over RA-SDT or CG-SDT) or MT-SDT (over RA or CG-SDT), as specified in TS 38.331 [9].","paragraph_zero_based":481},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":482},{"literal_text_all_w_t_and_m_t":"A UE supporting this feature shall also indicate support of ra-SDT-r17 cg-SDT-r17, mt-SDT-r18 or mt-CG-SDT-r18.","paragraph_zero_based":483},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":484},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":485},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":486},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":487},{"literal_text_all_w_t_and_m_t":"ul-GapFR2-Pattern-r17","paragraph_zero_based":488},{"literal_text_all_w_t_and_m_t":"Indicates FR2 UL gap pattern(s) supported by the UE for NR SA, for NR-DC without FR2-FR2 band combination, for NE-DC, and for (NG)EN-DC, if UE supports a band in FR2. The leading / leftmost bit (bit 0) corresponds to the FR2 UL gap pattern 0, the next bit corresponds to the FR2 UL gap pattern 1, as specified in TS 38.133 [5] and so on. The UE shall set at least one of the bits to 1 for FR2 UL gap pattern 1 and 3, if the UE indicates support for ul-GapFR2-r17 in an FR2 band.","paragraph_zero_based":489},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":490},{"literal_text_all_w_t_and_m_t":"CY","paragraph_zero_based":491},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":492},{"literal_text_all_w_t_and_m_t":"FR2 only","paragraph_zero_based":493},{"literal_text_all_w_t_and_m_t":"ul-RRC-MaxCapaSegments-r17","paragraph_zero_based":494},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports uplink RRC segmentation of UECapabilityInformation according to the network indication rrc-MaxCapaSegAllowed as specified in TS 38.331 [9].","paragraph_zero_based":495},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":496},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":497},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":498},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":499},{"literal_text_all_w_t_and_m_t":"ul-RRC-Segmentation-r16","paragraph_zero_based":500},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports uplink RRC segmentation of UECapabilityInformation according to the network indication rrc-SegAllowed as specified in TS 38.331 [9].","paragraph_zero_based":501},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":502},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"56654f9bd149b93ddfaf012bcd674e18c374f6dd7ddf1cc1792dc12229297094","original_member_sha256":"56fb020b0b8197f2dc7d5bb3d81730ac42e27dd1effda03bff60ba62025e75eb","paragraph_ElementTree_utf8_XML_sha256":["98ec6f00e5c04d5b1661fd727fd8f890a3039ebaa58c7a546489918faec4571b","c74d9fdb49446616ef73d33a0683077298bacffb9b35e26ac1e5f4fdf74e6484","d255169556e942978cfcb26253fb22a103d8623ee784a2b5199dec90daa24ebd","1d0215459da435a4c993ea1ebc42ee1ba78266157c3d5efd0d24c944e892202f","139ac01cfb4f1b5e5f6672cc5a3bf4d50ddd6aa9d1f7609660687f0da9424305","f8b1c106ac603042b85e3f1ff9d8b661a64c8855095ee4d8a9525a0669def83e","a91ac4ec3fb9008376148fecc6470fd4b07b75c47734daf9899312e817bcef36","efe0c93c095ba27a7f691922a8be1b3e10b13377abeec1cfa7f47eb08f065303","83d6504b1c3b5344e00ecd499c4e013c4d7653bb16b6f06f3d34b8bd0c902a20","c8836cd5805a0dba8a66586dc00bcdc756940c9861cdb50b27109076e7601ea0","917e8cf22b0599d158ebeb17f9ab9f1711b78a57a513a969032a9a50e2d23603","4312dd317c873bb