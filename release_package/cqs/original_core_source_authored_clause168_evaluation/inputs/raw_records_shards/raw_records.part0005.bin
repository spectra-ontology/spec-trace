{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Prohibit timer for overheating assistance information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":5616},{"literal_text_all_w_t_and_m_t":"pdu-SessionsToReportUL-TrafficInfoList","paragraph_zero_based":5617},{"literal_text_all_w_t_and_m_t":"A list of PDU sessions for which the UE shall report UL traffic information.","paragraph_zero_based":5618},{"literal_text_all_w_t_and_m_t":"propDelayDiffReportConfig","paragraph_zero_based":5619},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report service link propagation delay difference between serving cell and neighbour cell(s).","paragraph_zero_based":5620},{"literal_text_all_w_t_and_m_t":"qfi-ToReportUL-TrafficInfoList","paragraph_zero_based":5621},{"literal_text_all_w_t_and_m_t":"A list of QFIs of a PDU session for which the UE shall report UL traffic information.","paragraph_zero_based":5622},{"literal_text_all_w_t_and_m_t":"referenceTimePreferenceReporting","paragraph_zero_based":5623},{"literal_text_all_w_t_and_m_t":"If present, the field indicates the UE is configured to provide reference time assistance information.","paragraph_zero_based":5624},{"literal_text_all_w_t_and_m_t":"refLocList","paragraph_zero_based":5625},{"literal_text_all_w_t_and_m_t":"A list of reference locations for assisted SMTC configuration in RRC_CONNECTED state. If this field is absent when closestLocsToReport is signalled, the UE shall use the refLocList associated to smtc5list provided in SIB2, if available.","paragraph_zero_based":5626},{"literal_text_all_w_t_and_m_t":"releasePreferenceConfig","paragraph_zero_based":5627},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preference to leave RRC_CONNECTED state.","paragraph_zero_based":5628},{"literal_text_all_w_t_and_m_t":"releasePreferenceProhibitTimer","paragraph_zero_based":5629},{"literal_text_all_w_t_and_m_t":"Prohibit timer for release preference assistance information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on. Value infinity means that once a UE has reported a release preference, the UE cannot report a release preference again during the RRC connection.","paragraph_zero_based":5630},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5631},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5632},{"literal_text_all_w_t_and_m_t":"rlm-RelaxationReportingConfig","paragraph_zero_based":5633},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report the relaxation state of RLM measurements.","paragraph_zero_based":5634},{"literal_text_all_w_t_and_m_t":"s-SearchDeltaP-Stationary","paragraph_zero_based":5635},{"literal_text_all_w_t_and_m_t":"Parameter \"SSearchDeltaP-StationaryConnected\" in 5.7.4.4. Value dB2 corresponds to 2 dB, dB3 corresponds to 3 dB and so on.","paragraph_zero_based":5636},{"literal_text_all_w_t_and_m_t":"scg-DeactivationPreferenceConfig","paragraph_zero_based":5637},{"literal_text_all_w_t_and_m_t":"Configuration of the UE to indicate its preference for SCG deactivation.","paragraph_zero_based":5638},{"literal_text_all_w_t_and_m_t":"scg -StatePreferenceProhibitTimer","paragraph_zero_based":5639}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["ddd19c90284ad4ab33b7563e8bca0d1e6d6e91373d0e7d131e259bf9d4a3c645","ca625eea7f2ecdec03f461e573c29f74716d6eb3fd440b5966186c2fbab972cf","20f7182003f26efee9d4471b58b4a416f871b207415c10dc4bd89502871bd91f","84839fb83965eb3ec111a9106b7e4fdda8664b55ac7eb8096b044b39d9accd9c","8418879a31eaeed48780252996e320da4ae08124cd2524bc382d51089ab33dfa","2c85ac671b2b0adc133290b31328c0e54ac378a2e0d780e942fb0349807a3cf9","0ea996d6b183a101e34739b33a1ff775b750113c5c19faa5ea02cdaf343d6f65","7858c61b17cbd06d3acdbf87e107c1c452a320d6e55bb7d431900f7c43e433b4","a428dcc52d479bc65e1b9fc9dc2def637881086f784da4c01b1695384704555c","b290254d8cef1950e8dac2920bccf70e990a1132f0c8c6154554508165c15a2a","86c626b6ae8ad375148d2b1821a15f99618df489b30f78af3af19cb5a82d2d22","8580a4d20868b5d553b0c635c6c899f5165467b98bdd6afe4486dbcde3a894b5","37245f4e1e8f2d1b4b9565348e4387da10d91b61cc464f0514432198cb2e2510","e8f0e460734cc3c632b952e1bdb5f671d6ecdcb3b2eac2b82a95f0036016eed9","19138df35b732fbdd5db0914c2905ab0414a6b8e1b74d8a0d5c735347b884268","e495bb9fb2d91644ab21fddf205deddb00d4b4e80272b9779b7099bdfabca9af","0457d9be318a94756fff2ecddb9550069385cc74282d0b9873e58abf723fff8b","1132800d06d1db3bd47462991cac52831ad3d0649f4375374c1bfdc1321b5d68","0e07557a2c39c5dd1816a2d942d88f6f9056311e09f09114f396dbe0b2b91d98","3afe6a672623b87140f95cc8b15e0d7dec75b2b2f963cc78b28cf89a75e72c0b","5e8a06c67b32ef6b09b408989067fdbb2a7d25b8681291f389e9ae459d774a2d","7fa904b8fff7e3278051a1afe60b09b5bbbc19cdcf5f219d690b877e6cfc45b1","92a655c88f523906eeff7f2619b44c16c9adafd1c632e37622bde4847630101e","598517d8f0920f45e0340ad3a4770b428798117ad2674b8de275e1ec4611e9d1"],"paragraph_range_zero_based":[5616,5639],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx:p5616"}
{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Prohibit timer for UE indication of its preference for SCG deactivation. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":5640},{"literal_text_all_w_t_and_m_t":"sensorNameList","paragraph_zero_based":5641},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurements from specific sensors. NG-RAN configures the field if includeSensor-Meas is configured for one or more measurements.","paragraph_zero_based":5642},{"literal_text_all_w_t_and_m_t":"sl-AssistanceConfigNR","paragraph_zero_based":5643},{"literal_text_all_w_t_and_m_t":"Indicate whether UE is configured to provide configured grant assistance information for NR sidelink communication.","paragraph_zero_based":5644},{"literal_text_all_w_t_and_m_t":"sl-PRS-AssistanceConfigNR","paragraph_zero_based":5645},{"literal_text_all_w_t_and_m_t":"Indicate whether UE is configured to provide configured grant assistance information for NR sidelink positioning.","paragraph_zero_based":5646},{"literal_text_all_w_t_and_m_t":"sn-InitiatedPSCellChange","paragraph_zero_based":5647},{"literal_text_all_w_t_and_m_t":"This field indicates whether the PSCell change procedure or the CPC included in the RRCReconfiguration message is SN initiated or not. In case of SN initiated inter-SN PSCell change procedure or SN configured inter-SN CPC, MN includes this field in the MCG RRC Reconfiguration message. In case of intra-SN PSCell change, or intra-SN CPC, source SN includes the field in the SCG RRC Reconfiguration.","paragraph_zero_based":5648},{"literal_text_all_w_t_and_m_t":"sourceDAPS-FailureReporting","paragraph_zero_based":5649},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE shall generate the SHR upon successfully completing the DAPS handover to the target cell and if a radio link failure was experienced in the source PCell while executing the DAPS handover. This field is set in the otherConfig configured by the source cell of the DAPS handover.","paragraph_zero_based":5650},{"literal_text_all_w_t_and_m_t":"successHO-Config","paragraph_zero_based":5651},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report the successful handover information to the network.","paragraph_zero_based":5652},{"literal_text_all_w_t_and_m_t":"successPSCell-Config","paragraph_zero_based":5653},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report the successful PSCell change or addition information to the network. When this field is configured in CG-Config, the thresholdPercentageT304-SCG is absent.","paragraph_zero_based":5654},{"literal_text_all_w_t_and_m_t":"t-SearchDeltaP-Stationary","paragraph_zero_based":5655},{"literal_text_all_w_t_and_m_t":"Parameter \"TSearchDeltaP-StationaryConnected\" in 5.7.4.4. Value in seconds. Value s5 means 5 seconds, value s10 means 10 seconds and so on.","paragraph_zero_based":5656},{"literal_text_all_w_t_and_m_t":"thresholdPercentageT304","paragraph_zero_based":5657},{"literal_text_all_w_t_and_m_t":"This field indicates the threshold for the ratio in percentage between the elapsed T304 timer and the configured value of the T304 timer. Value p40 corresponds to 40%, value p60 corresponds to 60% and so on. This field is set in the otherConfig configured by the target cell of the handover.","paragraph_zero_based":5658},{"literal_text_all_w_t_and_m_t":"thresholdPercentageT310","paragraph_zero_based":5659},{"literal_text_all_w_t_and_m_t":"This field indicates the threshold for the ratio in percentage between the elapsed T310 timer and the configured value of the T310 timer. Value p40 corresponds to 40%, value p60 corresponds to 60% and so on. This field is set in the otherConfig configured by the source cell of the handover.","paragraph_zero_based":5660},{"literal_text_all_w_t_and_m_t":"thresholdPercentageT312","paragraph_zero_based":5661},{"literal_text_all_w_t_and_m_t":"This field indicates the threshold for the ratio in percentage between the elapsed T312 timer and the configured value(s) of the T312 timer. Value p20 corresponds to 20%, value p40 corresponds to 40% and so on. This field is set in the otherConfig configured by the source cell of the handover.","paragraph_zero_based":5662},{"literal_text_all_w_t_and_m_t":"thresholdPercentageT304-SCG","paragraph_zero_based":5663}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["447470542df5796d55108512a0c51cc74a73a619fb6f14aa78579a6c0655a42e","b7064adb542ea9eb380d334688d98ab01adde7ea0ff15dba356af0a186cdc086","bcb9baa36669cd0d6afd348f280ce1f8d14937046f8ba26a264637b8080a4ef7","9d77cd5e22e5b9fcb08af0ad63adfada49a72a4f4c4573183b01114fb235ff8f","728c4f302d24878d903b5843c151b7756eed94298ecf249182da13ab4e6d0b92","2b5ed5db28ea00e13612f191860949833c7e85e744384bfd02bc550765638393","a773309d3026153c5acf7070111b37ebab97811ca112a8344c9bd76e14802998","29b1ce6d2fd52a99719a62434ee9788cf88fca9da179552c55284e79002db417","b64d3e79c580bd512230d5862154d592c99d5f398aa78d4fe70c5de12284c6ac","ad4d16c00dc46a1bbe5d810633a523ad17e06b57b08dc01c9a8b650d08a5d6ef","f4d981f2e4455e21d6ec01d55921a5d26e1b5d12fae99f60480d97086ad3d072","2ad5740f0bbb9b367e63373279d0a1fa00e5f5b82edbae7c1dcc2f1458652d25","5e9991c2c1eeca0bad51b78e5b103f5ce4bcc73f2cedcac9cd84516366786071","bb13242a444645f7f1a14e9e95dbef21c34fd02c89a00a0e979b5cec6b333a65","b3c8776961a44e2d89107fd8cf46868a7742c992c4dc0ca187151ae69b08f302","f6ea7060a874b74e953f4bc67c4fc5413d398fd8921fdf4b5af468940193a2d4","54e1828b73685f7592bf1732125a78d4da8f9a2b8f4ad6613649385b3c6e2d7e","e4f804d1e9a12bfb7021558499b3200fc47bdd208d58613d1beef16118953d32","d8abc2fe3aa423bbda68b71377644c2fcf973ad90d6563d22d7d628573e48350","14fbe20331b956d665849698926fdce95c390d625287ef215b28087f4acbff34","80577aed6e42df3005f6afea396fafebad9f2a31fb0432e8aca39d0f187edcf8","4fae12de6989a43c9c80849acf40bd5ea65c903def69c85a74a4bea18191949f","38e36c4af422634af8dff7e00eb0e4922965d6ab7818eb69cab4bd2e8680f076","ba4ca79356b02de42a2afa8d001a9109ab6e3f1557e75da91669d46f2a89d6c5"],"paragraph_range_zero_based":[5640,5663],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx:p5640"}
{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field indicates the threshold for the ratio in percentage between the elapsed T304 timer associated to the target PSCell and the configured value of the T304 timer. Value p40 corresponds to 40%, value p60 corresponds to 60% and so on. This field is set in the otherConfig configured by the target PSCell of the PSCell change or addition.","paragraph_zero_based":5664},{"literal_text_all_w_t_and_m_t":"thresholdPercentageT310-SCG","paragraph_zero_based":5665},{"literal_text_all_w_t_and_m_t":"This field indicates the threshold for the ratio in percentage between the elapsed T310 timer associated to the source PSCell and the configured value of the T310 timer. Value p40 corresponds to 40%, value p60 corresponds to 60% and so on. This field is set in the otherConfig configured by the source PSCell of the PSCell change or CPC, or in the otherConfig configured by the PCell for the PSCell change or CPC. This field is not configured at the time of PSCell change via SRB3.","paragraph_zero_based":5666},{"literal_text_all_w_t_and_m_t":"thresholdPercentageT312-SCG","paragraph_zero_based":5667},{"literal_text_all_w_t_and_m_t":"This field indicates the threshold for the ratio in percentage between the elapsed T312 timer associated to the measurement identity of the target PSCell and the configured value of the T312 timer. Value p20 corresponds to 20%, value p40 corresponds to 40% and so on. This field is set in the otherConfig configured by the source PSCell of the PSCell change or CPC, or in the otherConfig configured by the PCell for the PSCell change or CPC. This field is not configured at the time of PSCell change via SRB3.","paragraph_zero_based":5668},{"literal_text_all_w_t_and_m_t":"threshPropDelayDiff","paragraph_zero_based":5669},{"literal_text_all_w_t_and_m_t":"Threshold for one-way service link propagation delay difference report as specified in 5.7.4.2.","paragraph_zero_based":5670},{"literal_text_all_w_t_and_m_t":"ul-GapFR2-PreferenceConfig","paragraph_zero_based":5671},{"literal_text_all_w_t_and_m_t":"Indicates whether UE is configured to request for FR2 UL gap activation/deactivation and preferred FR2 UL gap pattern.","paragraph_zero_based":5672},{"literal_text_all_w_t_and_m_t":"wlanNameList","paragraph_zero_based":5673},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurements from specific WLAN APs. NG-RAN configures the field if includeWLAN-Meas is configured for one or more measurements.","paragraph_zero_based":5674},{"literal_text_all_w_t_and_m_t":"ul-TrafficInfoProhibitTimer","paragraph_zero_based":5675},{"literal_text_all_w_t_and_m_t":"Prohibit timer for UL traffic information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":5676},{"literal_text_all_w_t_and_m_t":"ul-TrafficInfoReportingConfig","paragraph_zero_based":5677},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report UL traffic information.","paragraph_zero_based":5678},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5679},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":5680},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":5681},{"literal_text_all_w_t_and_m_t":"FDM","paragraph_zero_based":5682},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need R, if idc-AssistanceConfig-r16 or idc-FDM-AssistanceConfig is setup. Otherwise, it is absent, need R.","paragraph_zero_based":5683},{"literal_text_all_w_t_and_m_t":"maxBW","paragraph_zero_based":5684},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need R, if maxBW-PreferenceConfig-r16 is setup; otherwise it is absent, need R.","paragraph_zero_based":5685},{"literal_text_all_w_t_and_m_t":"maxMIMO","paragraph_zero_based":5686},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need R, if maxMIMO-LayerPreferenceConfig-r16 is setup; otherwise it is absent, need R.","paragraph_zero_based":5687}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["92ccf63b33a9c101806663c422d22b3c0c41f8a03484001fd0bd29f9abdcd521","67b7ab1fbb87569ac0b66b5088da47566a438a62c7ffd2aedd3f7ee1f49f49e4","0b75dcaa22d824aa8688f46a023d97560dfe6a35e9252319a11dd1ae0035ca64","b92029b3d4442f7a48298d5b7c7f58e8456d916a49d1fab3d144df75ee4820a2","10abb97938fd9e6ae2c56b858cb383a99c53c670ec457707c488ecbd21b0ebfe","0c6e1accbb31202e36fc358fdd648bcefb289cf7e77d92c69791a4f18c837c16","dca338c412bc96456d263b49fdcc729076cbb44f0d6904bac21c12fb228f2271","a96bee72d9bcd1597237d9c11e428068cfb98003af0afe349703ecef897b2e3c","4d8d9f1f267c69400e676c42bf13e66ccc02b89986b1d2e180639d4095797848","2dde7b6017ec41fded5e73ed7d374f77e0cbd580c9bcecf8ca55a5ac7a628cd1","9cfab2a6e082890463eb83dca28d8df89fbae36e4f717737af141629b802f50e","0e35caaf35c43586d0922e78b19427481d19d3058cd98c383858f70c1b9dc355","79cfc6a28e45703ec178b99cff303e8a43168c8573492d7f29159ceee91b8425","cf3759fe0d84957c57485ce4501428585e1e9d7cddd4694fbd1d35fb343be12e","68636ac0ab2242d2de80fc3c5ea96f96629c14470472945c3c9017dda05e617b","da3f5d37bb117c1d577068340fd6eb9a4dafdf9338d8fb31b6579442be2e0611","ae4d8b26e2d97e37cfa758b5e12774d7fa9b05dcb5b3e74a05dbf35a956a77f9","f95dcbbec4c1dd3dc61b96d5514f5025c8cd0dc8212255c9cadf6cc04be42bbf","a1a5f2f9a423e97ba6087c332f49478e89a465337ae9e48a81e2af45dea64ee3","5332a54285b56eb21ebc0daf88e44395e6316e56b604fe143b510ab8cbc