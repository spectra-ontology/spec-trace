cabilityInfoReportId","paragraph_zero_based":4145},{"literal_text_all_w_t_and_m_t":"Indicates the ID of a configuration subject to the applicability determination procedure.","paragraph_zero_based":4146},{"literal_text_all_w_t_and_m_t":"applicabilityInfoReportList","paragraph_zero_based":4147},{"literal_text_all_w_t_and_m_t":"Indicates the list of applicability reports, each associatied with a configuration ID for a configuration subject to the applicability determination procedure.","paragraph_zero_based":4148},{"literal_text_all_w_t_and_m_t":"applicabilityStatus","paragraph_zero_based":4149},{"literal_text_all_w_t_and_m_t":"Indicates whether the configuration associated to applicabilityInfoReportId is applicable or inapplicable.","paragraph_zero_based":4150},{"literal_text_all_w_t_and_m_t":"releaseConfigurationPreference","paragraph_zero_based":4151}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["0e2185c7587bd708e2801385c5edffc223f79aa3663b19d9bdc183610096dac2","cfd3b8b0e1c3dfc8a39dd65ed081a026ce74dcff39c8804d216efb3968f32de8","c886cb070647ef450fa33ee954abed34cb9090770e6e9c48239b07331cafb46a","29db33b000a41502c66daa1ffb3c024de4f14b6d4cdb5c12167417ac2c6328d6","802d55a6761d4fe273fc4da344c2f87ff53ffc00fd449cac0c96f2257c0da923","53a6225a27da207eb922ace764f6467e3eb350461ad3e061d3c0858ff8317259","abd9ae506eea177fdcadd1eba1854f1d906ef27893e8a59d5389fcd3824a1862","a7dd6a087bd96008f4eedc97d83e5de410235788d679d66a99e0145a65141960","f9de433304b497da30174689c417c8966eaa5e4f000d2c595b0e4187dd4c59c8","4c9548afa875fd3d6a53729d559b24e408c2c23779bf5d1b9d6656cc9981f4cf","89cece9a302d9e89982007fd9827965a1ed034cffc474881061e87211465dfa8","ab2c85a232cf7f480259989db6e7d864d552cf1e486e