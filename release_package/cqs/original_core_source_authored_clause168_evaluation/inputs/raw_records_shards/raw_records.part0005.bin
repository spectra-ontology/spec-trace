{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"otdoa-UE-Assisted","paragraph_zero_based":4320},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports UE-assisted OTDOA positioning, as specified in TS 36.355 [54].","paragraph_zero_based":4321},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4322},{"literal_text_all_w_t_and_m_t":"outOfOrderDelivery","paragraph_zero_based":4323},{"literal_text_all_w_t_and_m_t":"Same as \"outOfOrderDelivery\" defined in TS 38.306 [87].","paragraph_zero_based":4324},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":4325},{"literal_text_all_w_t_and_m_t":"outOfSequenceGrantHandling","paragraph_zero_based":4326},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports PUSCH transmissions with out of sequence UL grants as defined in TS 36.213 [23]. This field can be included only if uplinkLAA is included.","paragraph_zero_based":4327},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4328},{"literal_text_all_w_t_and_m_t":"overheatingInd","paragraph_zero_based":4329},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports overheating assistance information.","paragraph_zero_based":4330},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":4331},{"literal_text_all_w_t_and_m_t":"overheatingIndForSCG","paragraph_zero_based":4332},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports the inclusion of NR SCG reduced configuration in the overheating assistance information. The UE which indicates support of overheatingIndForSCG shall also indicate support of overheatingInd.","paragraph_zero_based":4333},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4334},{"literal_text_all_w_t_and_m_t":"pdcch-CandidateReductions","paragraph_zero_based":4335},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports PDCCH candidate reduction on UE specific search space as specified in TS 36.213 [23], clause 9.1.1.","paragraph_zero_based":4336},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":4337},{"literal_text_all_w_t_and_m_t":"pdcp-Duplication","paragraph_zero_based":4338},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports PDCP duplication.","paragraph_zero_based":4339},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4340},{"literal_text_all_w_t_and_m_t":"pdcp-SN-Extension","paragraph_zero_based":4341},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports 15 bit length of PDCP sequence number.","paragraph_zero_based":4342},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4343}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["838afa4f5fde4eacb267dd5a3e0588de45e0f15a49eae32941d8d58d9efe4e7f","ba21aa81a18424cafdf83d6624f9190a0383f696014d5b2d0037b78b95ffb203","b297937277a265139cc5d3bdcbe9626d628d1af28407882229fb2f2f769335a1","44db52835864f337149b29268c03f48331209e48667e3559b018ec23cca999e2","b1409b7cf6255bbacf1d2b1f53b084b3b0d5dfc8c78a953c058c611accd8ab72","d2a6033845eaba1d2b11940ba0472ecdb3e5fb711a739c897b25712555d6cd4d","9232f61d11cb3f7a757e4cec858a09547dc48fdb4ec788c37d21a759fa97a318","66a7911b2244902da67c67ff5ad92c3e8ee024e8a978afd378e1230e844c30b4","b9394b29fad6ce4b61700b17a6828d79512f4b199697e5bf6d23c1a5d2c90fc0","49ef91722902dc4be7152b4092ac4d4e4a8fa4fa393a1da85926a86d020cd32a","92e30b65988bbd128110bb54009cf5a62933f7bfc6ca23688e752e4f497c55d9","6720c522409ec3e5d7848a2e9b57daa4436135e7ffe9984eba08d1adcc76e4bc","bfb35ead7ffae89b664c8b787da213bc9ace3882ea26e95b91484e550a905068","5b92cd5d55b979a8ea1b588c7c28db9ece7095bc2c100264582880447f74a6b2","4fcdb65806516a5fe80c024042e619b1a1df348ac5207928db66c1568d4f8d6b","721b02e1af32604535c4c0e04462ac0e6312d7ac65c74f71d952d6b31ddfa923","d911dcc8bef1cd153200b3e258d5235b5e2433090fe68cbdf17d3fada141af31","1347debd75eb305f6717b47600011537d1840db1d332f727755119b2c24fc12a","0ff701210c5aa0edb10ed03f91e6c954098dae3d531a74cee28e550e96455d4a","80e099d635135bd4c865bf71df44f0a2dae4322727866c651e375dfe35df4be6","64aa2f0b0703e606e6d78b2b2c3c80301f9e71f4dd31c212dd497cda978d0710","de1b3ed0fd494b98fe0ecc9c1593da923d6f92cf91a75b006e2f9da123b1b095","a26a1826cc386ba379058110abfda7fbb3c172345105b7e553c0a7f9f2707891","96bd7c13fe1365cea008c260503e1d8c81682dcfbc71a816bf3ffa5f5a8e73ce"],"paragraph_range_zero_based":[4320,4343],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p4320"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"pdcp-SN-Extension-18bits","paragraph_zero_based":4344},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports 18 bit length of PDCP sequence number.","paragraph_zero_based":4345},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4346},{"literal_text_all_w_t_and_m_t":"pdcp-TransferSplitUL","paragraph_zero_based":4347},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports PDCP data transfer split in UL for the drb-TypeSplit as specified in TS 36.323 [8].","paragraph_zero_based":4348},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4349},{"literal_text_all_w_t_and_m_t":"pdcp-VersionChangeWithoutHO","paragraph_zero_based":4350},{"literal_text_all_w_t_and_m_t":"Indicates whether, the UE supports changing the PDCP version of DRBs, from LTE PDCP to NR PDCP and vice versa, with and without handover. A UE supporting PDCP version change shall signal field pdcp-Parameters-v1610. When the field pdcp-VersionChangeWithoutHO is not included and pdcp-Parameters-v1610 is included, it implies the UE supports PDCP version change only with handover.","paragraph_zero_based":4351},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4352},{"literal_text_all_w_t_and_m_t":"pdsch-CollisionHandling","paragraph_zero_based":4353},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports PDSCH collision handling as specified in TS 36.213 [23]. ","paragraph_zero_based":4354},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":4355},{"literal_text_all_w_t_and_m_t":"pdsch-InLteControlRegionCE-ModeA, pdsch-InLteControlRegionCE-ModeB","paragraph_zero_based":4356},{"literal_text_all_w_t_and_m_t":"Indicates whether UE operating in CE mode A/B supports PDSCH reception in LTE control channel region as specified in TS 36.211 [21].","paragraph_zero_based":4357},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4358},{"literal_text_all_w_t_and_m_t":"pdsch-MultiTB-CE-ModeA, pdsch-MultiTB-CE-ModeB","paragraph_zero_based":4359},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports multiple TB scheduling in connected mode for PDSCH when operating in CE mode A/B, as specified in TS 36.211 [21] and TS 36.213 [23].","paragraph_zero_based":4360},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4361},{"literal_text_all_w_t_and_m_t":"pdsch-RepSubframe","paragraph_zero_based":4362},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports subframe PDSCH repetition.","paragraph_zero_based":4363},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4364},{"literal_text_all_w_t_and_m_t":"pdsch-RepSlot","paragraph_zero_based":4365},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports slot PDSCH repetition.","paragraph_zero_based":4366},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4367}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["80b7595a515d05fd762c943ba239247279cee5e96e2e22f682b961385e49ee34","a6482569ec10d669566d4fa5ac0d92bdc837a2f1757abd34011cc0232fd1a9d6","628d25144894c162d3f4ad133d890536ffcc5baf2da73d7f5c8b2c8819a74e6f","8c698cc97a0c87ba525b14e62f40fdcf304026c5ff3107354942cc3a1b95c944","d12284630ee8fffbd0322b408f65a9206216441565316d8920e734fa4b3986b7","4274f3db876dffb0ec8fa1cbf2b4d0bbeeb9fc901aaa8ebcc2e3f8be920e8b29","357351f7560997a36d8ebeb9501a0e705a4eb3c799788ca1cb23acbe1aeebb21","fce303ad24eb018f16c93ef3c4ce55e18594f0249baf48c056b2f2170a07c022","806a2395f66fe473d6158d9719d133cad5f2fecac827f0d1c3f33aa572ee12a6","735643b13ec9f