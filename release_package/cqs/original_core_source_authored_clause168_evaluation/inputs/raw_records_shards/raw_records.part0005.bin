{"fields":{"filename":"R2-2503192.zip::R2-2503192 RRC_final.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"deliveryAmount","paragraph_zero_based":264},{"literal_text_all_w_t_and_m_t":"This field specifies the number of periodic deliveries for the indicated posSIB. Integer values N=1…30 correspond to an amount of 2N. Integer value N=31 indicates an 'infinite/indefinite' amount and integer value N=0 indicates that no more deliveries are needed.","paragraph_zero_based":265},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":266},{"literal_text_all_w_t_and_m_t":"=====================================================NEXT CHANGE=============================================================","paragraph_zero_based":267},{"literal_text_all_w_t_and_m_t":"–RRCReconfiguration","paragraph_zero_based":268},{"literal_text_all_w_t_and_m_t":"The RRCReconfiguration message is the command to modify an RRC connection. It may convey information for measurement configuration, mobility control, radio resource configuration (including RBs, MAC main configuration and physical channel configuration) and AS security configuration.","paragraph_zero_based":269},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1 or SRB3","paragraph_zero_based":270},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":271},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":272},{"literal_text_all_w_t_and_m_t":"Direction: Network to UE","paragraph_zero_based":273},{"literal_text_all_w_t_and_m_t":"RRCReconfiguration message","paragraph_zero_based":274},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":275},{"literal_text_all_w_t_and_m_t":"-- TAG-RRCRECONFIGURATION-START","paragraph_zero_based":276},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":277},{"literal_text_all_w_t_and_m_t":"RRCReconfiguration ::=                  SEQUENCE {","paragraph_zero_based":278},{"literal_text_all_w_t_and_m_t":"    rrc-TransactionIdentifier               RRC-TransactionIdentifier,","paragraph_zero_based":279},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                      CHOICE {","paragraph_zero_based":280},{"literal_text_all_w_t_and_m_t":"        rrcReconfiguration                      RRCReconfiguration-IEs,","paragraph_zero_based":281},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture                SEQUENCE {}","paragraph_zero_based":282},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":283},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":284},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":285},{"literal_text_all_w_t_and_m_t":"RRCReconfiguration-IEs ::=              SEQUENCE {","paragraph_zero_based":286},{"literal_text_all_w_t_and_m_t":"    radioBearerConfig                       RadioBearerConfig                                                      OPTIONAL, -- Need M","paragraph_zero_based":287}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"238d3c199e96ece26711109ab9c6ea50c6e7a79f01d965f5726abaadc75d7d70","original_member_sha256":"aef358e3251a43545eb3096bd467322c204ec9bae5d4b3d32209cb0d70701bd4","paragraph_ElementTree_utf8_XML_sha256":["f72a6b35f1e12989628e66bbcad5b4195dfcc188cb696d6968a4243fa87213c9","00f23a6b0e74721a5136eb2edc685a34524da2f61106c6aeb9c13ea3105f03e8","e2efa3018fe644747f50b4af1b886a35559eb38088688af0a18c46cd9f7c9e5d","97832918d157004664c07551d9ed307072a6042e103536f3093751b1e5ed7213","13d8cdfbb0afe7f4837a120309e4219f2c55ab25e3bfdde34d8479357a85349f","32ce9fb323a566e4f1fa0d5133735bbb119a1f5da651eb1154fe24af87c44548","cade1702b2355b36fb0dbdcd7befc2da090d8135cd4c38b599669d3ac43352c0","f30fa76298a04c07c9f143c5923a595d9713600c936d0b2cca2bfa5900ce4b29","0b41503bf4a271df7a63de641d422099297c3345e94f466c2d37831dfb3d29a8","206196eb713001bb