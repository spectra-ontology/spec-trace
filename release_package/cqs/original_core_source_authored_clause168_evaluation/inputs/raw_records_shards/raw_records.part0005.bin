{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether the UE operating in CE mode A or B supports handover from E-UTRA/5GC to NR FDD FR2.","paragraph_zero_based":3192},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3193},{"literal_text_all_w_t_and_m_t":"ce-EUTRA-5GC-HO-ToNR-TDD-FR2","paragraph_zero_based":3194},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE operating in CE mode A or B supports handover from E-UTRA/5GC to NR TDD FR2-1.","paragraph_zero_based":3195},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3196},{"literal_text_all_w_t_and_m_t":"ce-EUTRA-5GC-HO-ToNR-TDD-FR2-2","paragraph_zero_based":3197},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE operating in CE mode A or B supports handover from E-UTRA/5GC to NR TDD FR2-2.","paragraph_zero_based":3198},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3199},{"literal_text_all_w_t_and_m_t":"ce-HARQ-AckBundling","paragraph_zero_based":3200},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports HARQ-ACK bundling in half duplex FDD in CE mode A, as specified in TS 36.212 [22] and TS 36.213 [23].","paragraph_zero_based":3201},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3202},{"literal_text_all_w_t_and_m_t":"ce-InactiveState","paragraph_zero_based":3203},{"literal_text_all_w_t_and_m_t":"Indicates whether UE operating in CE mode supports RRC_INACTIVE when connected to 5GC. A UE including this field also supports short eDRX cycles in RRC_INACTIVE when connected to 5GC.","paragraph_zero_based":3204},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":3205},{"literal_text_all_w_t_and_m_t":"ce-MeasRSS-Dedicated, ce-MeasRSS-DedicatedSameRBs","paragraph_zero_based":3206},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE operating in CE mode A/B supports receiving neighbour cell RSS information in dedicated signalling and performing serving cell and neighbour cell measurements based on RSS in RRC_CONNECTED as specified in TS 36.306 [5] and TS 36.133 [16].","paragraph_zero_based":3207},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3208},{"literal_text_all_w_t_and_m_t":"ce-ModeA, ce-ModeB","paragraph_zero_based":3209},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports operation in CE mode A and/or B, as specified in TS 36.211 [21] and TS 36.213 [23].","paragraph_zero_based":3210},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3211},{"literal_text_all_w_t_and_m_t":"crs-ChEstMPDCCH-CE-ModeA, crs-ChEstMPDCCH-CE-ModeB","paragraph_zero_based":3212},{"literal_text_all_w_t_and_m_t":"Indicates whether UE operating in CE mode A/B supports using CRS for improving MPDCCH channel estimation.","paragraph_zero_based":3213},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3214},{"literal_text_all_w_t_and_m_t":"crs-ChEstMPDCCH-CSI","paragraph_zero_based":3215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["c404d4c76a6f50739191959029203af3c4c79f125b13ce7924fdb543f53c606a","ffb508e5346f2919df5ed7654cd6c20d1b4a81ef711f3d62dc2421b03679fd68","5163a0cf137fa0f5b5915998f6c7f6e716810212be48b417f3626149761e8fdc","c7a5d2ef1cd1e13cd87b2c445c48ee593ac46e8f96699bb7334906d86f443cc7","201d75bf20aa2c243aeef01c985e1862e559dbf3eb5dc7fb156be90a06eadf39","d8ce11dc686bcc9446964fe4bc30f588c5677cec7cbac6c67323044387edad88","e70a3d1990b59506a41e155f3def645b69aaf47e144c5c1b0fa32bfe928cc622","a428b990db5fd976e7c6fed8182a5674bddd3cdb832c8c6967f5deb900f105c8","68a0c6e8188bc4c27f1a5a8b5eca62352d2f7c78173659f33cc84cb49bfb1bb1","2706e9383b98efde36353c5058aa782371ca029a607da996b121807c4abed481","68ae92af4c68d7e14cd4b23f176d928280047476a2bc0622e7d7041554c68e39","9c9d30307bcaa15a1856708206675cca2a32924682bcd319b1f513827c7fd792","fe328e973b1364c9220bfc85d424a4b87c9bb1196363bd0cf678c28a5598e1a7","cd466ce2997876abe0bc229c4ed9fed2bad42c886a7df70210ae51a7efc0243f","a20466c98885c8707c8da6f2dc54e919c54e0ec9c38a0e2b8e442220a85c0546","75947056a54d5aad671a0f74616bda6294d27db6f77125944069361c4ceb9513","066d1525664e1ffb05188b66757aef72533f24a09616f252fd2349f9853ece4b","e8df8579f99b4fb7fb55e6e57665ee59ff45c0aff0f8b0ed65dca0b113fdc64a","09f95cd13674aaa0a91027f89f9320c0dd9c23a18b272b15163d282069a02b7e","6afa3f5418b8e01820dc5019f55fe5aa2c8277a1a7a7979495eba9202219485d","edbaae3e16c9ff30528ee7e64459a7dd4f457c87506a640f8dad494a08f1f332","5c0dc2cc9a7d4eee51c9a46c0255f43fc4cd63f6ff95b057f8b51546906d51fa","401fa3a738dcb29e2014cb9f406048359e396d7493d22a7915146b1a69640dd6","7a0472246792d45f5258804623dd1a8b4401417db00cd129431f73e09671e919"],"paragraph_range_zero_based":[3192,3215],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p3192"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether UE operating in CE mode A supports CSI-based mapping for improving MPDCCH channel estimation.","paragraph_zero_based":3216},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3217},{"literal_text_all_w_t_and_m_t":"crs-ChEstMPDCCH-ReciprocityTDD","paragraph_zero_based":3218},{"literal_text_all_w_t_and_m_t":"Indicates whether UE operating in CE mode A supports using CRS for improving MPDCCH channel estimation with reciprocity-based candidates in TDD.","paragraph_zero_based":3219},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":3220},{"literal_text_all_w_t_and_m_t":"ceMeasurements","paragraph_zero_based":3221},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports intra-frequency RSRQ measurements and inter-frequency RSRP and RSRQ measurements in RRC_CONNECTED, as specified in TS 36.133 [16] and TS 36.304 [4].","paragraph_zero_based":3222},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3223},{"literal_text_all_w_t_and_m_t":"ce-MultiTB-64QAM","paragraph_zero_based":3224},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports downlink 64QAM for multiple TB scheduling in connected mode for PDSCH when operating in CE mode A, as specified in TS 36.211 [21] and TS 36.213 [23]. This field can be included only if ce-PUSCH-SubPRB-Allocation is included.","paragraph_zero_based":3225},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3226},{"literal_text_all_w_t_and_m_t":"ce-MultiTB-EarlyTermination","paragraph_zero_based":3227},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports early termination of PUSCH transmission for multiple TB scheduling in connected mode, as specified in TS 36.211 [21] and TS 36.213 [23]. ","paragraph_zero_based":3228},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3229},{"literal_text_all_w_t_and_m_t":"ce-MultiTB-FrequencyHopping","paragraph_zero_based":3230},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports frequency hopping for multiple TB scheduling for PDSCH/PUSCH in connected mode, as specified in TS 36.211 [21] and TS 36.213 [23]. ","paragraph_zero_based":3231},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3232},{"literal_text_all_w_t_and_m_t":"ce-MultiTB-HARQ-AckBundling","paragraph_zero_based":3233},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports downlink HARQ-ACK bundling for multiple TB scheduling in connected mode when operating in CE mode A, as specified in TS 36.211 [21] and TS 36.213 [23].","paragraph_zero_based":3234},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3235},{"literal_text_all_w_t_and_m_t":"ce-MultiTB-Interleaving","paragraph_zero_based":3236},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports TB interleaving for multiple TB scheduling in connected mode for PDSCH/PUSCH when operating in CE mode A or B, as specified in TS 36.211 [21] and TS 36.213 [23].","paragraph_zero_based":3237},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3238},{"literal_text_all_w_t_and_m_t":"ce-MultiTB-SubPRB","paragraph_zero_based":3239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["fd43b7d24a4f11aa78d3877f011bf2833f18685e3aa56bdb30e22488cd48df10","6201578332bdeae6e8912a3b76a28bd3ffcff66da20d6f00bb6b56e6fd7eaa0d","76b3fc806ad44b6043b0d090d04aeca5c98c091ca0b76091cd4368e9a5f1d49f","0e2d0e4552a1b68707ed15bdf2b0d5268f203f273ee91f928bb23c3ec6123f94","7782dd682cc2a7645136d7896aea818bbc0a1cd5733644c3b52d219d7acc727c","f69ceae5537a685ddd4777574a0f94b94816b699e88b3dbcf7466252e30cf40c","da030faa7a6da468b4312beedbcc3112e8707e39fc4cc38dd45dd7d76d0d9050","7751630e3b37c8952c039d61f2a146f865d96e312a886ca817b008d5f077ed68","03ec7a636bd4c7b28a6b43a6da8c84c1217a66979889563e54bd319b91e16809","1c25894db9720126ea181b2f8718012da8af28bd8582c22b2d3ac3cadcab6809","a1e7fb95b99822f7aaed09fe32498f41a49e0cfb0cc075f163ec0df946d973a9","001e2fbdb47cc66891218edb279c01f6802bb2c14e0597499319d2717eb23d1f","1e4276540b842c709bea4511291b4280472b1dc1a912cf532185c374a8310b76","8b70b3a5f825c94f5fef7bad28d2c5fbebded372ced5aa55579b5886831a4849","9d9aa569ed461858001ed1676f42f96b16a3f28dc37cdb44c49f0afdcdb1e650","f198669ba4116ac084648b0b257a8e3f7ce313f9b5ba0a07360d0508aede8871","5f4422a8156619eddb0a99c28da79c4084f5f61f203977351e75eca084f9ef67","ec4563c943d7c1ca45c50d749360509e596ce9766f8dd3126372a5df5beb739f","04f119afcf8c493e3fa7080e1ca5872f6c60e73c0042e70c3d33c064ce192c7b","708305576ad277c86871f78899e614dba1aa9a1e111ef3a3c5f22e24d5f05661","55ed96aa4876ddb5b8d5644693074d7149b1ff38dccf8c65abfb0dbed6b6a84b","66467a5de08359bfcf8f15fa743369752893b5ae628ec2ef3b47a30a9d684249","760733c2b1792d20fcb896046f482fae8ce59ad1fdd1300c6bd6605b98f030e0","40d3254eaf191c218ea363cee654139eba6fde4437d019b4c1e86e0adde63fea"],"paragraph_range_zero_based":[3216,3239],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p3216"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports sub-PRB allocation for multiple TB scheduling for PUSCH in connected mode, as specified in TS 36.211 [21] and TS 36.213 [23]. This field can be included only if ce-PUSCH-SubPRB-Allocation is included.","paragraph_zero_based":3240},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3241},{"literal_text_all_w_t_and_m_t":"ce-PDSCH-14HARQProcesses, ce-PDSCH-14HARQProcesses-Alt2","paragraph_zero_based":3242},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports 14-HARQ processes, as specified in TS 36.212 [22].","paragraph_zero_based":3243},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3244},{"literal_text_all_w_t_and_m_t":"ce-PDSCH-64QAM","paragraph_zero_based":3245},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports 64QAM for non-repeated unicast PDSCH in CE mode A.","paragraph_zero_based":3246},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3247},{"literal_text_all_w_t_and_m_t":"ce-PDSCH-FlexibleStartPRB-CE-ModeA, ce-PDSCH-FlexibleStartPRB-CE-ModeB,","paragraph_zero_based":3248},{"literal_text_all_w_t_and_m_t":"ce-PUSCH-FlexibleStartPRB-CE-ModeA, ce-PUSCH-FlexibleStartPRB-CE-ModeB","paragraph_zero_based":3249},{"literal_text_all_w_t_and_m_t":"This field indicates whether UE supports flexible starting PRB for PDSCH/PUSCH when operating in coverage enhancement mode A/B, as specified in TS 36.211 [21] and TS 36.213 [22].","paragraph_zero_based":3250},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3251},{"literal_text_all_w_t_and_m_t":"ce-PDSCH-MaxTBS","paragraph_zero_based":3252},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports downlink TBS of 1736 bits, as specified in TS 36.212 [22].","paragraph_zero_based":3253},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3254},{"literal_text_all_w_t_and_m_t":"ce-PDSCH-PUSCH-Enhancement","paragraph_zero_based":3255},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports new numbers of repetitions for PUSCH and modulation restrictions for PDSCH/PUSCH in CE mode A as specified in TS 36.212 [22] and TS 36.213 [23].","paragraph_zero_based":3256},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":3257},{"literal_text_all_w_t_and_m_t":"ce-PDSCH-PUSCH-MaxBandwidth","paragraph_zero_based":3258},{"literal_text_all_w_t_and_m_t":"Indicates the maximum supported PDSCH/PUSCH channel bandwidth in CE mode A and B, as specified in TS 36.212 [22] and TS 36.213 [23]. Value bw5 corresponds to 5 MHz and value bw20 corresponds to 20 MHz. If the field is absent the maximum PDSCH/PUSCH channel bandwidth in CE mode A and B is 1.4 MHz. If the setting of this parameter is 20 MHz, the max supported PUSCH channel bandwidth in CE mode A is 5 MHz. The maximum PUSCH channel bandwidth in CE mode B is 1.4 MHz regardless of the setting of this parameter. Parameter: transmission bandwidth configuration, see TS 36.101 [42], table 5.6-1.","paragraph_zero_based":3259},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3260},{"literal_text_all_w_t_and_m_t":"ce-PDSCH-TenProcesses","paragraph_zero_based":3261},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports 10 DL HARQ processes in FDD in CE mode A.","paragraph_zero_based":3262},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["0935438c4c7100141a02c8b59c3ce7cf9234c4e21aa968a2a2b2b1d9431ae9ef","79f570f715f390fe7867e76bde27000b3f4d96a838ee2a3a9dfea7e5500f63c2","67c50a62b57935043d9373e9b24ef2327f2844c1e8537249e3b805e28373d109","305a1267a6609e9e2bfbf8acb0af0e0e9b3aab339d824d4c1f629a17b0d779df","d6f7807c95f5978b62ba836d2aba460afabdf2699819165667608a09997575df","567e93c4b411f8d4720d75441272c653d995b4a58ae9fa43190f8959a790816e","52216a1bb466cc1f683b4e7041fc5570f67435c9f7f99b457a9462b7882ab739","3616754c190c7babb91bed365920edb93f7cd0aab6286e8a60113c99a76287e6","e4910920114d1ec3ea93567f264f27ade288b0d0533a02426c1d34b8bc17bcad","5f7ec3eb75fb394f7ce81bd513802d1553b326db56f68675adab98ec5e0c7af7","76a32a0ebf69f33419be9921188637db1f6e6413ed9953121c3d6f7414a31098","45ffd6f25946b4c50c8dfbef64e6f0862a3d860399bc59f2f06b95f86ad67572","159f626a1650dda0873a72d2c531ab8626ebc7c2412fc5ea51fab3dca543673c","776d290a0d098c013ec7c88c0f82bfdfbc9f26e9ab5c2f6923345482eff3aeea","1e6191a85414bc50f271db44dee01c9f76e69d595c869b4fd5415a8a38d3d0c7","5068c40cc9b744156973d5cf322b24fe28a8615ea6fbeea18b417eddda82d271","0499d29fdddec14949c011220c47d7e0d6e522849dd6612f5481537afbef0664","5f50899a2f7235f545e34d20b24feb21af9ec3f32c2cdf598c5bb2e3e173395e","e5085896841545befda4098a6984c7f5c4d61462ae15b6f15208f11de5892734","34e5841ff7ad6a8e8dd2edd6dea87418e0ab7720d9d73deec2bdea92c324edfa","0d5fe8183cfbcac98fcdb1f3b3a0cd516997baa48e17b154dd02bfc6402db7a3","43a98936cc670efddb952e02025dedc85c9404bee4cb6f3dd39c99476cc8638b","f283bcaa23531f01e983b1c43b0a51b0955787a226a13d80709760e2958a71f2","6eb4e1d39a2594fb0b9fbf1713f6a896bddb5a30510b77c91bbcd4675a20f958"],"paragraph_range_zero_based":[3240,3263],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p3240"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ce-PUCCH-Enhancement","paragraph_zero_based":3264},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports repetition levels 64 and 128 for PUCCH in CE Mode B, as specified in TS 36.211 [21] and in TS 36.213 [23].","paragraph_zero_based":3265},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":3266},{"literal_text_all_w_t_and_m_t":"ce-PUSCH-NB-MaxTBS","paragraph_zero_based":3267},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports 2984 bits max UL TBS in 1.4 MHz in CE mode A operation, as specified in TS 36.212 [22] and TS 36.213 [23].","paragraph_zero_based":3268},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3269},{"literal_text_all_w_t_and_m_t":"ce-PUSCH-SubPRB-Allocation","paragraph_zero_based":3270},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports sub-PRB resource allocation for PUSCH in CE mode A or B, as specified in TS 36.211 [21], TS 36.212 [22] and TS 36.213 [23].","paragraph_zero_based":3271},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3272},{"literal_text_all_w_t_and_m_t":"ce-RetuningSymbols","paragraph_zero_based":3273},{"literal_text_all_w_t_and_m_t":"Indicates the number of retuning symbols in CE mode A and B as specified in TS 36.211 [21]. Value n0 corresponds to 0 retuning symbols and value n1 corresponds to 1 retuning symbol. If the field is absent the number of retuning symbols in CE mode A and B is 2.","paragraph_zero_based":3274},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":3275},{"literal_text_all_w_t_and_m_t":"ce-SchedulingEnhancement","paragraph_zero_based":3276},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports dynamic HARQ-ACK delay for HD-FDD in CE mode A as specified in TS 36.212 [22] and TS 36.213 [23].","paragraph_zero_based":3277},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":3278},{"literal_text_all_w_t_and_m_t":"ce-SRS-Enhancement","paragraph_zero_based":3279},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports SRS coverage enhancement in TDD with support of SRS combs 2 and 4 as specified in TS 36.213 [23]. This field can be included only if ce-SRS-EnhancementWithoutComb4 is not included.","paragraph_zero_based":3280},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3281},{"literal_text_all_w_t_and_m_t":"ce-SRS-EnhancementWithoutComb4","paragraph_zero_based":3282},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports SRS coverage enhancement in TDD with support of SRS comb 2 but without support of SRS comb 4 as specified in TS 36.213 [23]. This field can be included only if ce-SRS-Enhancement is not included.","paragraph_zero_based":3283},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3284},{"literal_text_all_w_t_and_m_t":"ce-SwitchWithoutHO","paragraph_zero_based":3285},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports switching between normal mode and enhanced coverage mode without handover.","paragraph_zero_based":3286},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3287}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["72cb51d8656e325a0006e22f04831c7b3e7577b9d1f956e15a16e390ed13b121","929be7c14c28e2d8d83acf1072f5ba46de225dcc9fe4566c3d4f585debddfd80","d4254c1c10e303b9f6fef58c6f3c01e9d439c8aa253bd7d81c897a2835aa3999","b28a93c8b99f789f4d6bf507c1271a3e123beebad722b1fa141e32ae5794dec6","a44ffb87e190bd56db8cc78c13acf7f564f1e84ff638acac082e3eb86f48e3bd","71555625bf312ab087edaafa57927982b7a6e552c3368af127ff769b5014faf4","9ef4faa9414963d99c3afc70c7e6189a023da40b1b3c55825f991f143f04e61c","f2927c65724fc83745efe69033d42ec74f2a3437e5926f7f4d26b5c4fc48e861","d03f81d581f36221f49d68683e2266c0365934037653f4794c0a9999ef35edc1","2d817783bb2e03201b8812acf6b3afd5653e07e9183de926f0592c1c1cf35167","bdf7f17ba2cad66a94ed30405136b0f2ffd2ffd8683c82b00343b9bbfc749b6f","57217a4a22f92be6d2d73a5eb4efd610a3fb22104095a22eef1290abab7c541d","dc2739485c13ec2d7a5636c8e3ab38a29393be8880f5383219a4381eb3bdf829","2b4c983c6076f007001e7638e2ee87e4e1fdec9802c66b4a3f34b06cbfb08414","f458eac99c066839a6ca829486592cc144b62c230f0c7b7782c37447230dcc30","336803e9e6c7b12b983994f2d4f8057ef5778dbd49a80641a7fc83718213384d","e88a4f93a375ab79b944510b3ac4eca7df240fd69c212432aa25b4dda65f9715","4b45356848747b98715e8439220c31894700b582f43aaad184342b1e8e73bcc1","8a3969d34be4ce7cd3acd010c080cbad2e69dd1c3d1b3f597e8be89d677c37c8","60ab53f098066fa5aea1a37f3528472bf2f12d1522dedecac2520264f5adc971","e1b6be68e1f5b3c0488835aef6a71fd242bb8383a96620ed2af213b9358caf91","bb16cf3994753d9dc9a0a997ffce1f0943ea676128ee66cca75bff41dd1e77d8","3911af39e6f4ccc09fa73c94092205f2e0addf843ae0179f5bb8a2d04fe3182c","6d5bd378edc77f1da2b5decbaf9dec96146e722f669f12323131b1055578c0b0"],"paragraph_range_zero_based":[3264,3287],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p3264"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ce-UL-HARQ-ACK-Feedback","paragraph_zero_based":3288},{"literal_text_all_w_t_and_m_t":"This field indicates whether UE supports uplink HARQ ACK feedback when operating in coverage enhancement, as specified in TS36.213 [22].","paragraph_zero_based":3289},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3290},{"literal_text_all_w_t_and_m_t":"channelMeasRestriction","paragraph_zero_based":3291},{"literal_text_all_w_t_and_m_t":"Indicates for a particular transmission mode whether the UE supports channel measurement restriction.","paragraph_zero_based":3292},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3293},{"literal_text_all_w_t_and_m_t":"cho","paragraph_zero_based":3294},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports conditional handover including execution condition, candidate cell configuration and maximum 8 candidate cells.","paragraph_zero_based":3295},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3296},{"literal_text_all_w_t_and_m_t":"cho-Failure","paragraph_zero_based":3297},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports conditional handover during re-establishment procedure when the selected cell is configured as candidate cell for condition handover.","paragraph_zero_based":3298},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3299},{"literal_text_all_w_t_and_m_t":"cho-FDD-TDD","paragraph_zero_based":3300},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports conditional handover between FDD and TDD cells.","paragraph_zero_based":3301},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":3302},{"literal_text_all_w_t_and_m_t":"cho-TwoTriggerEvents","paragraph_zero_based":3303},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports 2 trigger events for same execution condition. It is mandatory supported if the UE suppors cho.","paragraph_zero_based":3304},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3305},{"literal_text_all_w_t_and_m_t":"codebook-HARQ-ACK","paragraph_zero_based":3306},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports determining HARQ ACK codebook size based on the DAI-ased solution and/or the number of configured CCs. The first bit is set to \"1\" if the UE supports the DAI-based codebook size determination. The second bit is set to \"1\" if the UE supports the codebook determination based on the number of configured CCs.","paragraph_zero_based":3307},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":3308},{"literal_text_all_w_t_and_m_t":"commMultipleTx","paragraph_zero_based":3309},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports multiple transmissions of sidelink communication to different destinations in one SC period. If commMultipleTx-r13 is set to supported then the UE support 8 transmitting sidelink processes.","paragraph_zero_based":3310},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["84a0a01f48e4463c37db35dd11079431dc477aaefce6568ce2a3bd0b1fc941ed","7ea306b723114b11401e6c1ff0d9e5b341c100c31ee313fd0267192bf7be527c","7c6590b411a386010419ea2c92ab568c552646b3f61911565061f1295a1c4634","8d14234b8b00cebf43fb62bdbecf76a36f45ead6b3e3994fb74d386f5eff43e7","bcbd403213e181f7e9161dbce6a891ce5f70c1df3d0fee62671268fef5eaa170","a60ca358920f7e794c610bfc9be17c020b633a2b74f5dcc77c48f561eacf180b","3a263ebb7d956c5ba8dfe93d2337aa9ec48b02fbd702d6b4a0c0306b4cd26074","f9c8a80768c79db89e7f8f3d6706531d03e0e490820b418a9b55b3740ce4a778","dfe9129473f29cefd99d1d9774bd71ef5661c60926a7597bd63bd065ccd94584","08802375b747f124e8f7f542c38fc80c2e8d2f02db9926c62150354f8ccd62ce","aa84132566f86e889b1edbc61d4bbcf6ab1280289ba257ee6c0c77a8f3a65434","86d1c6279ab2cd09013a40a610d6163d119cfed1f651d8c653cf97d85b94887a","95401e5858385a84803b8bd9fb17601a7b3428f5d05d93f979bebb85dccb05b5","453ac9bc9f812d8fae9595719a626cfa8bf725dcf7f84f9985d906d1b40f2f7e","755f89658168be8007603531262d827fdaaf1c0277ff43c1c164f288a08b1efd","f628365ae4f0c9f4b8b060ee0d72e8cad633bc965dd014cf49698be4c7094774","92ec411d580c43a74a8242c259003c46c0632985dcebdde37b473ec797b49991","30c67edb374e2303f8ea58be126503d277de4b871db8932cade4d7075fd6ba65","f263710ee9e214935bb0f4316edfecdb05cfd2d1266b650ee2748fa7e0f8c7bd","e6d7fe1f4ad93bf8432b80b5ebc4c147b8d2a7fdec835941045398f40c08de29","25d727db56294df1f37a4ac28a95cab33ce7e4f9e0d39f044592baa80b504d43","41ffef261a27c372553986d97259efcd4fc357b4afac801759574f30995239c4","78f574da6144c7815ee634d139ff8a9a60abc9e812094852b9d169a44f4cc4f3","8935bf5cb760dce2d3c9b31d22e3cdb09adcc207298a296760279beef91e98c8"],"paragraph_range_zero_based":[3288,3311],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p3288"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"commSimultaneousTx","paragraph_zero_based":3312},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports simultaneous transmission of EUTRA and sidelink communication (on different carriers) in all bands for which the UE indicated sidelink support in a band combination (using commSupportedBandsPerBC).","paragraph_zero_based":3313},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3314},{"literal_text_all_w_t_and_m_t":"commSupportedBands","paragraph_zero_based":3315},{"literal_text_all_w_t_and_m_t":"Indicates the bands on which the UE supports sidelink communication, by an independent list of bands i.e. separate from the list of supported E-UTRA band, as indicated in supportedBandListEUTRA.","paragraph_zero_based":3316},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3317},{"literal_text_all_w_t_and_m_t":"commSupportedBandsPerBC","paragraph_zero_based":3318},{"literal_text_all_w_t_and_m_t":"Indicates, for a particular band combination, the bands on which the UE supports simultaneous reception of EUTRA and sidelink communication. If the UE indicates support simultaneous transmission (using commSimultaneousTx), it also indicates, for a particular band combination, the bands on which the UE supports simultaneous transmission of EUTRA and sidelink communication. The first bit refers to the first band included in commSupportedBands, with value 1 indicating sidelink is supported.","paragraph_zero_based":3319},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3320},{"literal_text_all_w_t_and_m_t":"configN (in MIMO-CA-ParametersPerBoBCPerTM)","paragraph_zero_based":3321},{"literal_text_all_w_t_and_m_t":"If signalled, the field indicates for a particular transmission mode whether the UE supports non-precoded EBF/ FD-MIMO (class A) related configuration N for the concerned band combination.","paragraph_zero_based":3322},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3323},{"literal_text_all_w_t_and_m_t":"configN (in MIMO-UE-ParametersPerTM)","paragraph_zero_based":3324},{"literal_text_all_w_t_and_m_t":"Indicates for a particular transmission mode whether the UE supports non-precoded EBF/ FD-MIMO (class A) related configuration N for band combinations for which the concerned capabilities are not signalled.","paragraph_zero_based":3325},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3326},{"literal_text_all_w_t_and_m_t":"continueEHC-Context","paragraph_zero_based":3327},{"literal_text_all_w_t_and_m_t":"Indicates that the UE supports EHC context continuation operation where the UE keeps the established EHC context(s) upon PDCP re-establishment, as specified in TS 36.323 [8].","paragraph_zero_based":3328},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":3329},{"literal_text_all_w_t_and_m_t":"crossCarrierScheduling","paragraph_zero_based":3330},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3331},{"literal_text_all_w_t_and_m_t":"crossCarrierScheduling-B5C","paragraph_zero_based":3332},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports cross carrier scheduling beyond 5 DL CCs.","paragraph_zero_based":3333},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":3334},{"literal_text_all_w_t_and_m_t":"crossCarrierSchedulingLAA-DL","paragraph_zero_based":3335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["2df5b60d8fad1444c830e62b6a1245abf76fc033cba4eefc85ccbd190c143a47","478a295716b9898f356940b840451171eebfe4f3f164b69a8ef421dda4948ed7","80a73a4bf4e89505afe8e0e35c53bd5d0141d6a3c70324a4d6247e332e4d57a0","7ccb9d4acbd7dec7ad776f8298107c08ec660748d474302c7d88f776103dd336","c4df0999f3005b509ba4a780ff4675445f6a8fce50078da38850fd2dce3e7d46","134a0e2b5064b5d86591ded1d7e9b3870243a482c1cc853659c65c5ab4b5e58b","6e9335ad4e5bc6d8913e7168142734fba19c0a8418e52fdfeb47aa8c60a2417a","892a1cc822711b0a6bd2c59bfd5f0367921a16e9be0d203014508000ee4075e7","112438e330bc493994ea6a0fc4fd3ca861fe5909da7479e89adc2dba99987a10","69dad4422f853c323675483d7b5848a43d57d98288467a720596478d3342ebad","fa9033df3844e129314022dd3baa7fc359f5b739b543e35da06ab9c154ab699a","90d58b05bc36f17610ba29bdc4cbe97aae690d1fc2abc785854f111b904cbd87","e13f75ac6fef4d4d8a37abb220cdcfd1a9a3cc87cd235bc9e363dac862d16eb0","e27e2517967e09cb24d16b43d458e1ae0475c0e11b4c07c846d1c4717ef413e4","3c68c6e58834dc8da3da32bb2fd625baeb793a013f49a880282af074d25ea568","5c0198cf841cb6c9152f4e3d0422ff50d87da4d1936f6b4b8a424f704bf39bb6","49f0b1c16db33e2bb5a7a0067b1c3314c4423b8f55e777696b7dbd5c641b9201","829b5e07d781ad29b251e10293c1cfd17d9c75022d8897310ab26794375676a7","4183fcf5853440008bc08818b3cba205d9039bf3f79cbb0803717dbeedf7e544","c88608ac012f83681a0edc19101d4a947a3780345d70cc7d1158dcbea9b3f27e","4cd2fb0a121a2db45c8a48c21e7529f9617cf0f4c0fdbf3116330b54f72acd46","f3b8a31046d45bc03520324fc5cd1312e7d2816ceb46bf2534d3856860ea5d1a","06920f1a84a4df181d66cc103eb82b6e05a0213c63d65cd620398df3675fe31a","1bde9c553f90395172b20a28fb5b6620d9e6135dce48643812c21123de15c218"],"paragraph_range_zero_based":[3312,3335],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p3312"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports cross-carrier scheduling from a licensed carrier for LAA cell(s) for downlink. This field can be included only if downlinkLAA is included.","paragraph_zero_based":3336},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3337},{"literal_text_all_w_t_and_m_t":"crossCarrierSchedulingLAA-UL","paragraph_zero_based":3338},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports cross-carrier scheduling from a licensed carrier for LAA cell(s) for uplink. This field can be included only if uplinkLAA is included.","paragraph_zero_based":3339},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3340},{"literal_text_all_w_t_and_m_t":"crs-DiscoverySignalsMeas","paragraph_zero_based":3341},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports CRS based discovery signals measurement, and PDSCH/EPDCCH RE mapping with zero power CSI-RS configured for discovery signals.","paragraph_zero_based":3342},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3343},{"literal_text_all_w_t_and_m_t":"crs-IM-TM1-toTM9-OneRX-Port","paragraph_zero_based":3344},{"literal_text_all_w_t_and_m_t":"Indicates whether the DL Cateogry 1bis UE ot the DL Category M2 UE supports CRS interference mitigation (IM) while operating in the following transmission modes (TM): TM 1, TM 2, …, TM 8 and TM 9. ","paragraph_zero_based":3345},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":3346},{"literal_text_all_w_t_and_m_t":"crs-InterfHandl","paragraph_zero_based":3347},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports CRS interference handling.","paragraph_zero_based":3348},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3349},{"literal_text_all_w_t_and_m_t":"crs-InterfMitigationTM10","paragraph_zero_based":3350},{"literal_text_all_w_t_and_m_t":"The field defines whether the UE supports CRS interference mitigation in transmission mode 10. The UE supporting the crs-InterfMitigationTM10 capability shall also support the crs-InterfHandl capability.","paragraph_zero_based":3351},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":3352},{"literal_text_all_w_t_and_m_t":"crs-InterfMitigationTM1toTM9","paragraph_zero_based":3353},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports CRS interference mitigation (IM) while operating in the following transmission modes (TM): TM 1, TM 2, …, TM 8 and TM 9. The UE shall not include the field if it does not support CRS IM in TMs 1-9. If the field is present, the UE supports CRS-IM on at least one arbitrary downlink CC for up to crs-InterfMitigationTM1toTM9-r13 downlink CC CA configuration. The UE signals crs-InterfMitigationTM1toTM9-r13 value to indicate the maximum crs-InterfMitigationTM1toTM9-r13 downlink CC CA configuration where UE may apply CRS IM. For example, the UE sets \"crs-InterfMitigationTM1toTM9-r13 = 3\" to indicate that the UE supports CRS-IM on at least one DL CC for supported non-CA, 2DL CA and 3DL CA configurations. The UE supporting the crs-InterfMitigationTM1toTM9-r13 capability shall also support the crs-InterfHandl-r11 capability.","paragraph_zero_based":3354},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3355},{"literal_text_all_w_t_and_m_t":"crs-IntfMitig","paragraph_zero_based":3356},{"literal_text_all_w_t_and_m_t":"Indicate whether the UE supports CRS interference mitigation as specified in TS 36.133 [16], clause 3.6.1.1.","paragraph_zero_based":3357},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3358},{"literal_text_all_w_t_and_m_t":"crs-LessDwPTS","paragraph_zero_based":3359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["2220e99b09ac5be70aa897670b5eca2e38e9a1da9a570181052b72881215889d","f86db5bf3e117b68de014a82d0cdf959383d60ae90121feb2ce3b6997fb0f897","9ffd9cdd363e820e8eb3fc86f9311d873b0d7e01ca89465a5780cd936f5be01e","3400157c816efbbafffa25760683a0d6440588a8c7a7491a44c215b5a09304fd","8c09e7e336cc76b9d64895000ccd05e25cea792c829eee85eecf913499d8e8d1","f9a5754bb9a82c8bb59a9682f0237c3bf2c79c4e5ca53afebdeb4facf95fe121","1b3a8a55a2449830292781d7bd491c4be359f2b2114ea2c0af9d0c18fab29483","e040e2706d26d871d2a6f93b813946de61eea450fbab98fb7f6d64ae699b79f2","c1081ec2bc994cb2d96932312e96a253826fd889ff39edb7064c180343b9a0f7","60bcedfad999b5f5f8366144232188379389e5ae2726c3c1a60099bc08668666","8aef2c52b0ce64b12eeeff06c23be5aaa6d347ce1cf941cea40712c7e68ec7a6","17de2ad0d95f00d4d340702200efbc903d4e6bbd21b277193b08cbb6c65aef11","5a7bc1735604ce6b6845d059c29a55ce162d0769edd3d2d61ef1f182ff8e39ca","4d9ab681e14eb8c4067b7fc8aa2ef86e2e1e3e41165e746de702d13908f1175f","7557ca5f920b5677d4d6b162fac2b191cfcf0a5f73e4a9c4e4ddf4de77e4292d","bd76473c4b1ac61daa2fb8e629dcc14038c93503bfb59eaa3d67a155092eade6","a711d77da9279e43ee503cbfc2882bb9080e382858dc6feaec4867b0b0e11075","68ad019af6bf594b8982f1816fef6aae7f3414a6adc11a20124f14521ad02fda","47ea4231f44f99f0f0f1f2691c268c6f5095972e68f7e983d62e00ddd4179c36","f233713542ce94a9d99b08d271d9acc1200eb26efa12095a71558531a8466445","7d23d5f3948238ed565240118c8ac3daa56e4ce984c11fae820192da69ea0c14","f27a9d951f1cb94541a0a2e68592202b2dbd38690e9423da557f60085301e943","654cbaff14d69d739d78b93ee57f77c1494a1f321f663d0af193e0d35cc1a1ca","62cf27fee4f9512f52ee9994957539f266026b668d8f4d5b5cd7337f5140b1ee"],"paragraph_range_zero_based":[3336,3359],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p3336"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports TDD special subframe configuration 10 without CRS transmission on the 5th symbol of DwPTS, i.e. ssp10-CRS-LessDwPTS, as specified in TS 36.211 [17]. ","paragraph_zero_based":3360},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3361},{"literal_text_all_w_t_and_m_t":"csi-ReportingAdvanced, csi-ReportingAdvancedMaxPorts (in MIMO-CA-ParametersPerBoBCPerTM)","paragraph_zero_based":3362},{"literal_text_all_w_t_and_m_t":"If signalled, the field indicates that for a particular transmission mode, the maximum number of CSI-RS ports supported by the UE for advanced CSI reporting is different in the concerned band of band combination than the value indicated by the field csi-ReportingAdvanced or csi-ReportingAdvancedMaxPorts in MIMO-UE-ParametersPerTM. The UE shall not include both csi-ReportingAdvanced and csi-ReportingAdvancedMaxPorts for a particular transmission mode in the concerned band of band combination.","paragraph_zero_based":3363},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3364},{"literal_text_all_w_t_and_m_t":"csi-ReportingAdvanced (in MIMO-UE-ParametersPerTM)","paragraph_zero_based":3365},{"literal_text_all_w_t_and_m_t":"Indicates for a particular transmission mode the maximum number of CSI-RS ports supported by the UE for advanced CSI reporting. The field csi-ReportingAdvanced indicates 32 CSI-RS ports. The UE shall not include both csi-ReportingAdvanced and csi-ReportingAdvancedMaxPorts for a particular transmission mode. ","paragraph_zero_based":3366},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3367},{"literal_text_all_w_t_and_m_t":"csi-ReportingAdvancedMaxPorts (in MIMO-UE-ParametersPerTM)","paragraph_zero_based":3368},{"literal_text_all_w_t_and_m_t":"Indicates for a particular transmission mode the maximum number of CSI-RS ports supported by the UE for advanced CSI reporting. The field csi-ReportingAdvancedMaxPorts indicates 8, 12, 16, 20, 24 or 28 CSI-RS ports. The UE shall not include both csi-ReportingAdvanced and csi-ReportingAdvancedMaxPorts for a particular transmission mode.","paragraph_zero_based":3369},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3370},{"literal_text_all_w_t_and_m_t":"csi-ReportingNP (in MIMO-CA-ParametersPerBoBCPerTM)","paragraph_zero_based":3371},{"literal_text_all_w_t_and_m_t":"If signalled, value different indicates that for a particular transmission mode, the CSI reporting on non-precoded CSI-RS with 20, 24, 28 or 32 antenna ports for the concerned band of band combination is different than the value indicated by field csi-ReportingNP in MIMO-UE-ParametersPerTM.","paragraph_zero_based":3372},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3373},{"literal_text_all_w_t_and_m_t":"csi-ReportingNP (in MIMO-UE-ParametersPerTM)","paragraph_zero_based":3374},{"literal_text_all_w_t_and_m_t":"Indicates for a particular transmission mode whether the UE supports CSI reporting on non-precoded CSI-RS with 20, 24, 28, or 32 antenna ports for band combinations for which the concerned capabilities are not signalled in MIMO-CA-ParametersPerBoBCPerTM, and the FD-MIMO processing capability condition as described in NOTE 8 is satisfied.","paragraph_zero_based":3375},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3376},{"literal_text_all_w_t_and_m_t":"csi-RS-DiscoverySignalsMeas","paragraph_zero_based":3377},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports CSI-RS based discovery signals measurement. If this field is included, the UE shall also include crs-DiscoverySignalsMeas.","paragraph_zero_based":3378},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3379},{"literal_text_all_w_t_and_m_t":"csi-RS-DRS-RRM-MeasurementsLAA","paragraph_zero_based":3380},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports performing RRM measurements on LAA cell(s) based on CSI-RS-based DRS. This field can be included only if downlinkLAA is included.","paragraph_zero_based":3381},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3382},{"literal_text_all_w_t_and_m_t":"csi-RS-EnhancementsTDD","paragraph_zero_based":3383}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["93bf9be4c25782ae8b6f739a7d77f5c43ce01878486acf4893746c7f69e9225a","6a5b66b36c0ae9b1571eca39b6effba923c2fd24a82ccf0026d25d8b909493af","c989e741247792f48e8eb12e3fcd0f2678037d29ac9c7b39fe70843506cc9515","405a81f791a5c4b7349aaed39943c2e6cfc3fd27244bb146118c269fbc767414","992ec15e47b4ced5f245954082994ddb174c251f446c1734870177e807a7bffb","893f1017bcea98c628cdd163b27f744be3476cbaf484f0675808fd1031e43d45","06b279cb4bfe75e762603d5db75a799ac35cdda5d9de290105d6fd369e6c5bc0","3747416cf733a731f7ee6b198d7e4c88dffbbd71a438b409fb5bf993a88f9346","935e4ce5bc36a4c2625bd856c2796e7a5a0516de3896c4a14f7de4acfe5c1635","14dcc4c9a3106bb48f98021a6c802ea01d5ca0f47e746917cdb43276df51930b","988ce4ed8797bdba32795a122e16729b74e92f9ffdf44d84c78865783ca3e4c3","1bd4f4539dca9a85a9f3e350eaee1a22b8cc38e44b1108b06bf38e77c5b35337","5ff90dfdffd0084e75141ae38b6ef5182eb0a5760ea4b9b527f20fc1b201e1ca","ad1ccafec4cdff89f6eb6cc811605f1b8ce2a39867acf5232abdba3a7db552b6","d13a183998a63c69bbdf528a156cea0af02159bb3c05d9b40a4adb14bf65f9ca","71ab60efe6a6a7a39cd2a6a5ab4dbacb0b9ed58e0e712fed533eb48b3f449609","c62a78faae7ae111f68033ca0394b31e447abaa550d9b789b0c044f3adaa665b","26e49f8f1c4152849f6466a8267560fd223310ea1b471ffb57121ee08ad892b2","6c9a6a2959ba97395b0e6890649d3bcf6537dc2d78c57dab294ef3c180c24f41","8002103a99750a5c73f847496f07ff64cf493451159f0b8aba0c69f604dc1507","94078a9764644eb2ade840328aa2b30de7083eec6322d9e1c5f181ddc7cbd4da","b24c161775108bfdb4d92a77e4c31dc7a9c01d4a59432884e24aedb77c2fafd2","b7b175869d7e75a92e315d622c8b6fa650c36e0ccdf3dc9fc0251c5b57981980","03431feec288f8ae3cf86292e6fb6f854da0a5896b63fbef4ddc8d4db091f559"],"paragraph_range_zero_based":[3360,3383],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p3360"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates for a particular transmission mode whether the UE supports CSI-RS enhancements applicable for TDD.","paragraph_zero_based":3384},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3385},{"literal_text_all_w_t_and_m_t":"csi-SubframeSet","paragraph_zero_based":3386},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports REL-12 DL CSI subframe set configuration, REL-12 DL CSI subframe set dependent CSI measurement/feedback, configuration of up to 2 CSI-IM resources for a CSI process with no more than 4 CSI-IM resources for all CSI processes of one frequency if the UE supports tm10, configuration of two ZP-CSI-RS for tm1 to tm9, PDSCH RE mapping with two ZP-CSI-RS configurations, and EPDCCH RE mapping with two ZP-CSI-RS configurations if the UE supports EPDCCH. This field is only applicable for UEs supporting TDD. ","paragraph_zero_based":3387},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3388},{"literal_text_all_w_t_and_m_t":"csi-SubframeSet2ForDormantSCell","paragraph_zero_based":3389},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports second CSI subframe set for periodic CSI reporting for dormant serving cells. A UE that indicates support of this field shall also indicate support for dormantSCellState-r15. This field is only applicable for UEs supporting TDD.","paragraph_zero_based":3390},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3391},{"literal_text_all_w_t_and_m_t":"dataInactMon","paragraph_zero_based":3392},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports the data inactivity monitoring as specified in TS 36.321 [6].","paragraph_zero_based":3393},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3394},{"literal_text_all_w_t_and_m_t":"dc-Support","paragraph_zero_based":3395},{"literal_text_all_w_t_and_m_t":"Including this field indicates that the UE supports synchronous DC and power control mode 1. Including this field for a band combination entry comprising of single band entry indicates that the UE supports intra-band contiguous DC. Including this field for a band combination entry comprising of two or more band entries, indicates that the UE supports DC for these bands and that the serving cells corresponding to a band entry shall belong to one cell group (i.e. MCG or SCG). Including field asynchronous indicates that the UE supports asynchronous DC and power control mode 2. Including this field for a TDD/FDD band combination indicates that the UE supports TDD/FDD DC for this band combination.","paragraph_zero_based":3396},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3397},{"literal_text_all_w_t_and_m_t":"delayBudgetReporting","paragraph_zero_based":3398},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports delay budget reporting.","paragraph_zero_based":3399},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":3400},{"literal_text_all_w_t_and_m_t":"demodulationEnhancements","paragraph_zero_based":3401},{"literal_text_all_w_t_and_m_t":"This field defines whether the UE supports advanced receiver in SFN scenario (350 km/h) as specified in TS 36.101 [42].","paragraph_zero_based":3402},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3403},{"literal_text_all_w_t_and_m_t":"demodulationEnhancements2","paragraph_zero_based":3404},{"literal_text_all_w_t_and_m_t":"This field defines whether the UE supports further enhanced receiver in HST-SFN scenario (up to 500 km/h velocity) as specified in TS 36.101 [42].","paragraph_zero_based":3405},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3406},{"literal_text_all_w_t_and_m_t":"densityReductionNP, densityReductionBF","paragraph_zero_based":3407}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["d7cdd49db5a57e263a9b1ec56da9d5f4c291b13ed8aca059081bec12fa06e218","234f4e109fd5bf2c016226b493614ea3e647b6b859f4e8c030b29fa223e21618","7353ca8aade79bc638f0505bf1fa65f4da79e7b5a915e39c2ac6d0f7bd133401","61ab77a47797d8f296e6d0ecf0478297c4212331d18e2f324d5fb197b7223d90","19c6b6cdeb887c24d3f8ee02ba34bb8055f8f46078d5d29080f4256ee78a6d2b","5a710a9962f57b19d61aca83e96d2438379935bf9539f745db2531dc5d43f6b4","3b303be0e5ca4f06e2003c9c28592b63082c85fb46d15ebdeeecabbb2b022514","dc36c8c6fe576b4db22a747eb05bbded503d9099ae96556e4b3afc64bd8acacc","ed3e2a1f8b2ceff2aea8a6127f6755638ba0a7894ef64885f1eaa0f4571513e7","80932ed5a86517c64b78d875e48013e9eea5f7d3a6f597ecc02622278c8c2538","f9a2b09ba3c82eb91f445dfcee4958bb88de520b1683d0135a8c477d2b6965fa","f6ec3adaff6d29aac2ea31f5bfb233ea39ba8667336fc6e82fd6497f6273b74b","f63fce0f6556b610caab5b4b65472a2b7abd40d26bc23c2af45f068fafbe156b","80127cfec4c10255ed48ca617aea7edb1c7c1a3199805eb80c9cca7f551dc37e","37d0f9c7530ecd4abe16684be9e9c4d827a4b451a271e5713caa4ba7f0394c75","b378a91236a87308b436864fa0aed98c52e83613ec193e3cdf31d7ec54b46184","8b0bd4cbae2db60b68e96d2eb58715a502f3cab1af105a6a7d27262cfcd1c7d1","8355c85ad4fce440c23986f733c3d54c33d0af537dd7f25705c33626c5fc47d9","c71de1272005ea129bb88a214e2d562117b45b0fea933a2ecb253f15d1324442","eb2cd741c458b6b35f03d0c00a56f327da2221bcb332313cd3656c03c57113be","fc2f72f741e782b0ad33a9c872baa5aa86c9cbf4f1272008850f8b86fc78a575","b9351e63ac057176be0d2552178703737bd1d5883d4e34cc8c99aeadf1a6cad4","899d42ac513b3b21ba71bce61e16dc9371f2d41ade5542d9711a1edb484418ad","59b03041cd795bd13c8828162a174976e00afa43b36d94f866247a9e1242f822"],"paragraph_range_zero_based":[3384,3407],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p3384"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports CSI-RS density reduction with values 1, 1/2 and 1/3 for non-precoded CSI-RS and beamformed CSI-RS respectively.","paragraph_zero_based":3408},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3409},{"literal_text_all_w_t_and_m_t":"deviceType","paragraph_zero_based":3410},{"literal_text_all_w_t_and_m_t":"UE may set the value to \"noBenFromBatConsumpOpt\" when it does not foresee to particularly benefit from NW-based battery consumption optimisation. Absence of this value means that the device does benefit from NW-based battery consumption optimisation.","paragraph_zero_based":3411},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3412},{"literal_text_all_w_t_and_m_t":"diffFallbackCombReport","paragraph_zero_based":3413},{"literal_text_all_w_t_and_m_t":"Indicates that the UE supports reporting of UE radio access capabilities for the CA band combinations asked by the eNB as well as, if any, reporting of different UE radio access capabilities for their fallback band combination as specified in TS 36.306 [5]. The UE does not report fallback combinations if their UE radio access capabilities are the same as the ones for the CA band combination asked by the eNB.","paragraph_zero_based":3414},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3415},{"literal_text_all_w_t_and_m_t":"differentFallbackSupported","paragraph_zero_based":3416},{"literal_text_all_w_t_and_m_t":"Indicates that the UE supports different capabilities for at least one fallback case of this band combination.","paragraph_zero_based":3417},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3418},{"literal_text_all_w_t_and_m_t":"directMCG-SCellActivationResume","paragraph_zero_based":3419},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports having an E-UTRA MCG SCell configured in activated SCell state.","paragraph_zero_based":3420},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3421},{"literal_text_all_w_t_and_m_t":"directSCellActivation","paragraph_zero_based":3422},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports having an E-UTRA SCell configured in activated SCell state in the RRCConnectionReconfiguration message. This field is applicable to both LTE standalone and LTE-DC.","paragraph_zero_based":3423},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3424},{"literal_text_all_w_t_and_m_t":"directSCellHibernation","paragraph_zero_based":3425},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports having an SCell configured in dormant SCell state.","paragraph_zero_based":3426},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3427},{"literal_text_all_w_t_and_m_t":"directSCG-SCellActivationNEDC","paragraph_zero_based":3428},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports having an E-UTRA SCG SCell configured in activated SCell state in the RRCConnectionReconfiguration message contained in the NR RRCReconfiguration message, as defined in TS 36.321 [6] and TS 38.331 [82].","paragraph_zero_based":3429},{"literal_text_all_w_t_and_m_t":"If the UE indicates support of directSCG-SCellActivationNEDC-r16, the UE shall also indicate support of ne-dc as specified in TS 38.331 [82].","paragraph_zero_based":3430},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3431}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["a17c05e8b9e185619958d88e4f156170cd4e47d8033074239ff23071e1317f66","81b4621d1a9b9d4ef4b6d6fa7ac10234156e6c2636ba11c63eb002fd9a27e7e2","b49e1c0cc672cc539d07f31c34178c651f537b2a3c5d1df5fd0579ea69029db5","15573cb50e0c3330d9dd89473425164f017ab420d08eb3cbc25442903a828719","11b4e1527c7c2385dbba31a06edcdc2dd2cb0822480d6deceaa74d9fd959459f","9f69e0ba10f01ad5e4f7c9fb62e64fefba7c2a007d5046bf0fcd99ee4b182620","2369d0f648b0fe674bb33aed5814b8091b485425a74bfb433beb3db0431d6fe7","161931095774420e9840e8315225f3d0482988a290a1b776339f5ce47e5f5c61","71f3fc8a97c8f39258f3c60c5b9ba0d9c47dd24e50dfbd3b842fade32ccc8fab","1f480316222abac0a0ed4e5fd2edfbb54cae546e50525c909e3b41c6b37112e4","4ed6641df639c9e9b9549f572139bad6e56ccb881a3eab646e80a9221f48a5d5","2bd7d1b9d8072fac3f89a5a59678145967486ba5fb8afeb0f7c2ce7e4bef77b8","0c87d33b012896201b0a3bae62e277527e04777fb6906ebff6ab2369006a1103","d9bda06a13f4c93c42bef7c1d70dbae811e9bd890a0359f8f7dbd3925f007d45","b7b7eb0b81220f214047d42a24b8e63b17fcc6c7a37915f5c6c43617ac889cb5","a8799df654f73c826a2107fabbe5ba34f7c1e12574657466e9a491bd72541fa6","30ed9d1a0f82fece7702bb7e5acc4f4c73b51e6f4978fd49e3f1ef20ab3acae0","3fd5cd5fc0847c5f7b392d3459434178ea16b900ac8971d6c2ac218653d5ad38","bcbfc24370d003e50e70c38cd6c654bd53d69205f81c558fd1454e38fe96c1ab","91120d908d3f3c8841c83d56eef6df7da16312ca42c77faa1e5566642c7c294d","a6354d1ff297253217b7eefcd5ad704cc727e03f9d4ebc795b2b13878c3aa679","efb5c4777e7559db9863997640dfa2b8edb323a6e17487af9569cefe5f857b69","65a660a6360eb5334edfa0c601d4f5d83bb5f4fce3e3fb51c51bb8e629945892","52196f4053beb5cf9f833d3709e7d7cd1ce90f824e1877d2139ab7f62b90060f"],"paragraph_range_zero_based":[3408,3431],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p3408"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"directSCG-SCellActivationResume","paragraph_zero_based":3432},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports having an E-UTRA SCG SCell configured in activated SCell state.","paragraph_zero_based":3433},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3434},{"literal_text_all_w_t_and_m_t":"discInterFreqTx","paragraph_zero_based":3435},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE support sidelink discovery announcements either a) on the primary frequency only or b) on other frequencies also, regardless of the UE configuration (e.g. CA, DC). The UE may set discInterFreqTx to supported when having a separate transmitter or if it can request sidelink discovery transmission gaps.","paragraph_zero_based":3436},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3437},{"literal_text_all_w_t_and_m_t":"discoverySignalsInDeactSCell","paragraph_zero_based":3438},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports the behaviour on DL signals and physical channels when SCell is deactivated and discovery signals measurement is configured as specified in TS 36.211 [21], clause 6.11A. This field is included only if UE supports carrier aggregation and includes crs-DiscoverySignalsMeas.","paragraph_zero_based":3439},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3440},{"literal_text_all_w_t_and_m_t":"discPeriodicSLSS","paragraph_zero_based":3441},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports periodic (i.e. not just one time before sidelink discovery announcement) Sidelink Synchronization Signal (SLSS) transmission and reception for sidelink discovery.","paragraph_zero_based":3442},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3443},{"literal_text_all_w_t_and_m_t":"discScheduledResourceAlloc","paragraph_zero_based":3444},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports transmission of discovery announcements based on network scheduled resource allocation.","paragraph_zero_based":3445},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3446},{"literal_text_all_w_t_and_m_t":"disc-UE-SelectedResourceAlloc","paragraph_zero_based":3447},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports transmission of discovery announcements based on UE autonomous resource selection.","paragraph_zero_based":3448},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3449},{"literal_text_all_w_t_and_m_t":"disc-SLSS","paragraph_zero_based":3450},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports Sidelink Synchronization Signal (SLSS) transmission and reception for sidelink discovery.","paragraph_zero_based":3451},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3452},{"literal_text_all_w_t_and_m_t":"discSupportedBands","paragraph_zero_based":3453},{"literal_text_all_w_t_and_m_t":"Indicates the bands on which the UE supports sidelink discovery. One entry corresponding to each supported E-UTRA band, listed in the same order as in supportedBandListEUTRA.","paragraph_zero_based":3454},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["fb8e2f304eaf1665bcac8b6b7005579911b6e89373b80a379c6d46e1f1fb79b6","3908401c9bae0ed3df1cadddae28cdff9281952f04828fa78ffe3e07c47e6b75","7a17eecc2465292ab06c51286d8abce8b12a700d42a8fbb18c15ab3411bda520","f9aca1899d36acecac952a07aeee60ee1363bfa5f0f0c003a1c8317ea0d0b1ea","684ab3fec718bd62ad57fa0e3ee5eb10730400e3ee3f886a8eb6db523d958169","13e4070d8624f9574dbdd9590727967f83d591af23398ce2e6ca2325aaf7691f","b4316379adfd190171eca8c554381ccf4cd8724bdbdb3404bcb128c5b8d2d453","3c31d729fa4f07a40c037387034703c427ce48cde1f5af5407524a51a154daee","990e78ba0b0e1ad1415ac786f25638a4c892b04b1277c2d40e938efb3606513f","a3ebdca58276d71568154bd8fd063098798c1d252b2c7c14ec5307e6c8d357f4","2246e8240f03f5457e1f30fa802687b67761acf76618ab0e76adba4c0b4d0348","e772e4b14f9579178347026c11fba17879b85c9b4d10b442c73b6e96c41e04e3","d210fdefc166b0fbdb3d73d164c1c8b171af644c2657732970452846bf51f18f","4778a7a3fe47be0024b28d911ba9675ffea10e0ccd6208308ddd51c7e7bbc7bc","97e82d3cdad0c0473cbd10c8d5b97948d77b4079696520497d636798770a3181","e7679fe8ca0b05357e73d07ba0c86b34b3b2fcc2a1d55cf298daa07b35fbd556","b37f6c23c0b19a290fe6cb1d8f048df7fbe19bc63d95ff823233ec40ef81f26d","18bbb9a443a9d1a2ad562f6fc1296c9a94b1825ed6d5fdf289185c05e949ea37","4d18db896ce2e08888ca0b2adb10155720078e6343e5c4849d03b9fce0bf78c6","d6a61c837fd2fd1584497c398746248cc5ecd514a154f65c2bac1aebe72795c4","ad48d7cb3e168fbe4744ef82b4d30f3dde028e655ef4f143349a9269ed6b4f5e","7d06f79acb93d6473361b7a1c15b787fe22000320ecec1066ae68a8bf8f6e4f0","d298b3ae8e22137210db884a1b427cb3fd9c2977c83142772d3d186ea0ff81d3","53310dfd40f9fddc766b52fd32548a56706e824f7e2e0e2d19b74c5a90be36a5"],"paragraph_range_zero_based":[3432,3455],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p3432"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"discSupportedProc","paragraph_zero_based":3456},{"literal_text_all_w_t_and_m_t":"Indicates the number of processes supported by the UE for sidelink discovery.","paragraph_zero_based":3457},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3458},{"literal_text_all_w_t_and_m_t":"discSysInfoReporting","paragraph_zero_based":3459},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports reporting of system information for inter-frequency/PLMN sidelink discovery.","paragraph_zero_based":3460},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3461},{"literal_text_all_w_t_and_m_t":"dl-256QAM","paragraph_zero_based":3462},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports 256QAM in DL on the band.","paragraph_zero_based":3463},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3464},{"literal_text_all_w_t_and_m_t":"dl-1024QAM","paragraph_zero_based":3465},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports 1024QAM in DL on the band or on the band within the band combination. When dl-1024QAM-ScalingFactor and dl-1024QAM-TotalWeightedLayers are included, the UE supports 1024QAM in a set of CCs in a band combination if the CCs belong to bands indicated to support 1024QAM in that band combination and the 1024QAM processing capability condition as specified in equation 4.3.5.31-1 in TS 36.306 [5] is satisfied.","paragraph_zero_based":3466},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3467},{"literal_text_all_w_t_and_m_t":"dl-1024QAM-ScalingFactor","paragraph_zero_based":3468},{"literal_text_all_w_t_and_m_t":"Indicates scaling factor for processing a CC configured with 1024QAM with respect to a CC not configured with 1024QAM as described in 4.3.5.31 in TS 36.306 [5]. Value v1 indicates 1, value v1dot2 indicates 1.2 and value v1dot25 indicates 1.25.","paragraph_zero_based":3469},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3470},{"literal_text_all_w_t_and_m_t":"dl-1024QAM-TotalWeightedLayers","paragraph_zero_based":3471},{"literal_text_all_w_t_and_m_t":"Indicates total number of weighted layers the UE can process for 1024QAM as described in 4.3.5.31 in TS 36.306 [5]. Actual value = (10 + indicated value x 2), i.e., value 0 indicates 10 layers, value 1 indicates 12 layers and so on.","paragraph_zero_based":3472},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3473},{"literal_text_all_w_t_and_m_t":"dl-1024QAM-Slot","paragraph_zero_based":3474},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports 1024QAM in DL on the band for slot TTI operation.","paragraph_zero_based":3475},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3476},{"literal_text_all_w_t_and_m_t":"dl-1024QAM-SubslotTA-1","paragraph_zero_based":3477},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports 1024QAM in DL on the band for subslot TTI operation with TA set 1.","paragraph_zero_based":3478},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["1c691d764cb868cff00f4a269b79af0a4d9789c70dc2107863d99552f98e6432","6c811f53873a20f8cf421f01bfd2fc675704bf4e792517cb4b5cdcff6a10fed4","811728bcef370c624e2f923d858acb2c83def0ee94cc7c2f5a2024064a5321d7","b8cfccb89175175164e0634e28f6ace54b7a1ee9ed9e7caa18cd8d3c23e5408f","c2a5cc9a1018710f8d55c65c978c84ecf048014768b9230f95db8449aa98dbba","4f0ffa53b3c36e76e13ac708abb4d929c551971afee6a7458f269661e268cffa","3b434df99f28d7e524a509321f550481184befc6adad9594cd3e7c8da51f7b9f","b710f9ed70f21624bd617fbb2773eb27c2862720a20dc16fa416c63e2d88f36b","c6ccaae28d0e2e26cebd45b7c1ac7ac90166c2c8aab0b8c4a0ff98d0f9cbacd5","160e08f1486c4bc1c38780c9804c780761d26c086f3fabf8282687c2688a7feb","11399f1df84abe0bf95838edd5e1b9a67dfbc12b1d68bfdb4e49cd84e0373f27","df43be1a08a7a28ef3498d75dc791c89862f6575d38d02246bcbac98ea9f1840","61ddb45018f084e7d4fedefb07d2b999f21d2d36ba5218c7cbc158c1bb7a5eef","5632d54eb727cd83e2dcca29ec15f0478afb5e4fc169fea54111454c73c7eb10","8069aabda8eab71a5fa477484183f86aeb30e0f4ad4916fd7c9f105237c14b4b","2f6db5cf69e87e43f0480bc7761cdc02314cc03b45542039fa513fce14be79e3","4fb7ad69ada3227206b152061a53770ffaad288e856a61700c522022e784cdb6","689b598e1dd8405dd1e8b64f22f1fcaf579e2bcba693e313575d1eb68e204167","0e0a71ae8509d6b68a51cb71044266beb29c203476acc5cafb6b0e054e8a1429","e7b7fe7380827587eadb59fe3367010bc117e349fa3d3c746e3b5b5091cc44d5","5bc12c5eae1c4148ac8fb83910d8aa4d88324d7c68d8106279f0d5e3a7380752","d796e6d28da1e221a6233831ce1024a1b13e797f7d6233f60132e00703e20635","83c311dfbf7dfb9afeda7ec24c39d9b38413158983eeb4d0019974c499ba3183","7a529f597e4e9ebd9266be112453fa856b72267461a027020d4b40dcc62a12c3"],"paragraph_range_zero_based":[3456,3479],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p3456"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"dl-1024QAM-SubslotTA-2","paragraph_zero_based":3480},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports 1024QAM in DL on the band for subslot TTI operation with TA set 2, dmrsBasedSPDCCH-nonMBSFN","paragraph_zero_based":3481},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3482},{"literal_text_all_w_t_and_m_t":"dl-DedicatedMessageSegmentation","paragraph_zero_based":3483},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports reception of segmented DL RRC messages.","paragraph_zero_based":3484},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3485},{"literal_text_all_w_t_and_m_t":"dmrs-BasedSPDCCH-MBSFN","paragraph_zero_based":3486},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports sDCI monitoring in DMRS based SPDCCH for MBSFN subframe. If UE supports this, it also provides the corresponding DMRS based SPDCCH capability in min-Proc-TimelineSubslot.","paragraph_zero_based":3487},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3488},{"literal_text_all_w_t_and_m_t":"dmrs-BasedSPDCCH-nonMBSFN","paragraph_zero_based":3489},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports sDCI monitoring in DMRS based SPDCCH for non-MBSFN subframe. If UE supports this, it also provides the corresponding DMRS based SPDCCH capability in min-Proc-TimelineSubslot.","paragraph_zero_based":3490},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3491},{"literal_text_all_w_t_and_m_t":"dmrs-Enhancements (in MIMO-CA-ParametersPerBoBCPerTM)","paragraph_zero_based":3492},{"literal_text_all_w_t_and_m_t":"If signalled, the field indicates for a particular transmission mode, that for the concerned band combination the DMRS enhancements are different than the value indicated by field dmrs-Enhancements in MIMO-UE-ParametersPerTM.","paragraph_zero_based":3493},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3494},{"literal_text_all_w_t_and_m_t":"dmrs-Enhancements (in MIMO-UE-ParametersPerTM)","paragraph_zero_based":3495},{"literal_text_all_w_t_and_m_t":"Indicates for a particular transmission mode whether the UE supports DMRS enhancements for the indicated transmission mode.","paragraph_zero_based":3496},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3497},{"literal_text_all_w_t_and_m_t":"dmrs-LessUpPTS","paragraph_zero_based":3498},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports not to transmit DMRS for PUSCH in UpPTS.","paragraph_zero_based":3499},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":3500},{"literal_text_all_w_t_and_m_t":"dmrs-OverheadReduction","paragraph_zero_based":3501},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports OCC4 for rank 3 and 4 transmission as specified in clause 5.3.3.1.5C of TS 36.212 [22].","paragraph_zero_based":3502},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["4feab1315e55af187682710a9a5f3fe31b5fb106c12d1ac2871f116adad5dddc","eee2af0ae1db2c97512e1e12f0595a1bcb997ce31af821d2fabba73c5ba08d5e","7ea8a2ba4d1705ec2903328b5fbf58867c8d93ab6a705a9be90340b79f2e3d6e","d40ad1a4ece42126d3d073daf7dcab9ed7e4d6b5d8272b5cac85ceda75054239","02e66397f6c714f362797072551f421fc1a40d1502ca5827290e1edb378e865b","cd099ed5030e599019eaeec8f0b9a416bdfcdf3b56ef9ecf622c57d465106873","bfa4e996f4fe987ea46fa365d90611cfb8ff5db67954ea5b85e7426c23c7e422","fc77963d4c7fcbe43829ea636891c52ac8ab5abe8726689ea198c9b32f8366b5","9cfac63a5189acb013bd6dfa9838f607b78920bc0dbded0bcccf8ab00a724e93","d881b8a37045b78aacff8d5ac631886fab75fa8eeefa700bdc10113beadbca7a","06579e2dd4205691fe5cadc12637ec77302c97f3e53d30b04a5c8a0bf53e18b0","0b3ef43b20b8026879a3465d9962a757e2db653fcfb47a94629713ab8b853562","43fa31d8c2427e841d3395ba4328585f977eb3a9e2fbc08e282ee16a15b5f512","db64ebbf58f15eb98eb2b5f8dd6ff840516a6802193113133aaf6f0e09b25878","b0502619f6971ffb39552100dcac81e19b4dfa56b2b3964d35eae753551c30c9","88566cbadc6c91e86e1c5d0887dfb1da54c20cb8c2820aa080632f6a703dc6df","149ba56a1c164a9ac9e30254b22d204b9429f04dd77cd2eb3f1fc5cd234df9e8","216a6fbfd1557d78d368d8e6167126b4f56c91520458b89a5b724b6cf018abf4","8fce33e83aada6485cdb3baee2e2c21414adc62f8fb60114c47470c0bdcef904","7b272d49bef7bddf8561e1e2aec3f66d52e34b6e41941016d50709ff1c3848c4","2cdd86c4dc1a21bb31eea6f97aa238228a36944559f888fc00cfa7449f05fef6","232b080d165a0284d6cc4f60b7d1c5cf2191a3f5d81bf078085c025e7a85ae5a","e978ab131416ba64a493c620de0e7f6c051cb05a1fe50ef1dcbaebad9d66772a","a3e7dedd1b9836824d4372a9d8b2fc8039763bcd838e30bb12077570f8a7a12f"],"paragraph_range_zero_based":[3480,3503],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p3480"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"dmrs-PositionPattern","paragraph_zero_based":3504},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports uplink DMRS position pattern 'D D D' in subslot #5 with application of the 1/6 as the TBS scaling factor.","paragraph_zero_based":3505},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3506},{"literal_text_all_w_t_and_m_t":"dmrs-RepetitionSubslotPDSCH","paragraph_zero_based":3507},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports back-to-back 3/4-layer DMRS reception in two consecutive subslots across subframe boundary for subslot-PDSCH.","paragraph_zero_based":3508},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3509},{"literal_text_all_w_t_and_m_t":"dmrs-SharingSubslotPDSCH","paragraph_zero_based":3510},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports DMRS sharing in two consecutive subslots across subframe boundary for subslot-PDSCH.","paragraph_zero_based":3511},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3512},{"literal_text_all_w_t_and_m_t":"dormantSCellState","paragraph_zero_based":3513},{"literal_text_all_w_t_and_m_t":"Indicates whether UE supports Dormant SCell state (i.e. SCell state with CQI and RRM measurement reporting but no PDCCH monitoring).","paragraph_zero_based":3514},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3515},{"literal_text_all_w_t_and_m_t":"downlinkLAA","paragraph_zero_based":3516},{"literal_text_all_w_t_and_m_t":"Presence of the field indicates that the UE supports downlink LAA operation including identification of downlink transmissions on LAA cell(s) for full downlink subframes, decoding of common downlink control signalling on LAA cell(s), CSI feedback for LAA cell(s), RRM measurements on LAA cell(s) based on CRS-based DRS.","paragraph_zero_based":3517},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3518},{"literal_text_all_w_t_and_m_t":"drb-TypeSCG","paragraph_zero_based":3519},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports SCG bearer.","paragraph_zero_based":3520},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3521},{"literal_text_all_w_t_and_m_t":"drb-TypeSplit","paragraph_zero_based":3522},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports split bearer except for PDCP data transfer in UL. ","paragraph_zero_based":3523},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3524},{"literal_text_all_w_t_and_m_t":"dtm","paragraph_zero_based":3525},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports DTM in GERAN.","paragraph_zero_based":3526},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["1882bde0764aba19a205c789dfc2ef339693cabed6664a37f52864cf7986d576","f4469a57d71e23e46fcf8e72d1b5931d540cacec6f30de99863a2e1e77f0ae41","137f2b9030394b0bebcd8c00402224787ade52e408ae3885b14b0af0f242581f","ecf157ff6e211655d57b969055df0b091dee65b47d6c6d7851616748f9debaef","297e8a19beed7d07caf0d796a3162859827fddee97bf3f8cbd638d1fbd02cc3d","5fcccd157e37ca2d5dbd571903fb993681b7d45c8f38d23eae912cfe75c60f64","8f558f70b181b74abf4fe107d36507a08114ffaca349fb3988dc9fdb76c59330","900a1a1f8c71f2f3a64e4fae2afbefdf0a51f796538ae97264ef077e924a16f8","7e63ca8f78c2f497f09d33358977d36b9524d28e4fb24d2661a08ae48ab12cb7","5dc2541b76e9fe0c9828fd68c10362276eb01c96fe2cb64ba515633673aa484f","68fd8313f739ae4e0d0bb9aacd9e334a40685a691fbfabeeb51f6abde9acf680","c01b28952d23647b1c2e1ded7e8dae77d02952353793bb0365b562aac123015c","83c85502760eeb548fff427353d4447c2e7f3523d8a58835ddc64be4bb0f3e4b","65113e246e33307aae4edb08bd2d089bd840b80179b98bc666f37e76b2ac388d","28de582ba40f5a6f94131139e10df9f834bb778159d78b5b3c84ac99d6e2236e","0e825b48fb9d1b9bca399ff8f4bd3878e9b4b64314e689d31ce9728da799bc6d","e03a15d32c762b1cdfc9c464ba4456a765aa3a51144d670aca00433bfd7a03c3","7a23345b0783ded66bf9bf903089f3212b5f447270aeb38aaf61e66dc2d2367d","481b55bb63759cb386a96d14c657156d80687fbe4193192267e81bcd18a6889f","df6291148176e97b5a189f32fab91235a9ece25d44567154620eb76fbd95f73b","8695e51982b5188d7d39f06587056cd696708bd98c690964f29c6b39256769a4","314b6c5b47581e4ba35588ad63cc5c6e42ca6edbfa0789bd4cf5d29eaff41709","e50b27f2b8547dfd56cf4fde81773b55fdfe6f25c61e20df8db23315f9b6cdb4","052d7021be1d99c7b7b978780dd5fda00135e9fc92061fa3eda2e9ce3347a6de"],"paragraph_range_zero_based":[3504,3527],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p3504"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"dummy","paragraph_zero_based":3528},{"literal_text_all_w_t_and_m_t":"This field is not used in the specification. It shall not be sent by the UE.","paragraph_zero_based":3529},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3530},{"literal_text_all_w_t_and_m_t":"earlyData-UP","paragraph_zero_based":3531},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports UP-EDT when connected to EPC.","paragraph_zero_based":3532},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3533},{"literal_text_all_w_t_and_m_t":"earlyData-UP-5GC","paragraph_zero_based":3534},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports UP-EDT when connected to 5GC.","paragraph_zero_based":3535},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3536},{"literal_text_all_w_t_and_m_t":"earlySecurityReactivation","paragraph_zero_based":3537},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports early security reactivation when resuming a suspended RRC connection.","paragraph_zero_based":3538},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3539},{"literal_text_all_w_t_and_m_t":"e-CSFB-1XRTT","paragraph_zero_based":3540},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports enhanced CS fallback to CDMA2000 1xRTT or not.","paragraph_zero_based":3541},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3542},{"literal_text_all_w_t_and_m_t":"e-CSFB-ConcPS-Mob1XRTT","paragraph_zero_based":3543},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports concurrent enhanced CS fallback to CDMA2000 1xRTT and PS handover/ redirection to CDMA2000 HRPD.","paragraph_zero_based":3544},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3545},{"literal_text_all_w_t_and_m_t":"e-CSFB-dual-1XRTT","paragraph_zero_based":3546},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports enhanced CS fallback to CDMA2000 1xRTT for dual Rx/Tx configuration. This bit can only be set to supported if tx-Config1XRTT and rx-Config1XRTT are both set to dual.","paragraph_zero_based":3547},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3548},{"literal_text_all_w_t_and_m_t":"e-HARQ-Pattern-FDD","paragraph_zero_based":3549},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports enhanced HARQ pattern for TTI bundling operation for FDD.","paragraph_zero_based":3550},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3551}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["6eec818577cde5613eb2201e0a33bbc83a949428ed6ba8ee7733c4cbdd3be44e","82c6ff5126d5c2970411dd57389995c8631f57b187ad3b39051573c0eac4ac91","056e0eb71a44f8ff04902e4effd7295866ba494fed1b942bcaf60d481aacf05e","c2cfed6fdbe92c5c6ab03ee77e726ff649c839f2e4eb97210e809f3ad335dc62","e03faa0f35de51937fc6522af18886c44357e69f97103e42689a54fba4415abd","aad37a95b778075302d955c73437b345c5c22c421cf0fe8d75e4d57eca8ca0e5","86f0aeb632fd7ba238308d3725f6bf5b109e4f8bd5fcff7bb2984f9f0b8b4936","b400f058541e3d78ad22bd1b394d0a8df41a4eb19cdec4ac6dc05ba4528f3d18","53a3ec52f7d996650c62f63e13beca77c9d50a2a9fac158e1e6897ebce18c14c","e7f70ccc4951fa135b8c38d91ddd91a206ac58d78e3ce3c8a7dd4c54da9a9a9d","023c7842de3ce052af423632a77517711e44d465538cf2be029cc351b25d1566","9d9db058cceab1021000150bd8fa27e5b49ca16c7dea5731f29dd60909d64c36","f9925039c9f480a4d37377e66584c494d0370d3633767bd5f458018df9c04486","496f50777afbe5e0be27a6a9c503de01052af386de373b120fb81a290aa57c59","8b39b9417cdc2909be7fc59a832f6612dd7f17782e122d4ee322a9c96b778d9a","d0eec69ad534232ffd6e44c00a9bceff0a70a1b7fc1f1f279d46406a468164a8","32382d3b23eebfa997d30dac9705924c36bfdf0907110e1836fb8e486e5d9a18","1c33925b719193a7d992e196647da95034453e86b964419491ae73b683305023","14bea49044834bd7ae79dfb3a84cdc06a49e5dd3dc65bc907e76a10b178be81d","641978ca90096fa6f1164bfe4c0f7513f8e39e6d4c385febf5f2f64ce6dce68f","6e0c9871a855642ea82d74de4b1b71b81415c5bed5c73b584f8f7ff5926a0fef","6294473eeb37112cdb214816be54ea3887b69b39274cde5ade80748a54a6399d","3bcc7f199999e6058159a663e3ed650e047c2ba975903d53b9a51a58a5b7f64d","571344ad84cad509b7bcb9e3e321511a6bf4d5289ff02136d93262c40b84d5f1"],"paragraph_range_zero_based":[3528,3551],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p3528"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ehc","paragraph_zero_based":3552},{"literal_text_all_w_t_and_m_t":"Indicates that the UE supports Ethernet header compression and decompression using EHC protocol, as specified in TS 36.323 [8] and in Annex A of TS 38.323 [83]. The UE indicating this capability and indicating support for at least one ROHC profile, shall support simultaneous configuration of EHC and ROHC on different DRBs.","paragraph_zero_based":3553},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":3554},{"literal_text_all_w_t_and_m_t":"eLCID-Support","paragraph_zero_based":3555},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports LCID \"10000\" and MAC PDU subheader containing the eLCID field as described in TS 36.321 [6].","paragraph_zero_based":3556},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3557},{"literal_text_all_w_t_and_m_t":"emptyUnicastRegion","paragraph_zero_based":3558},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports unicast reception in subframes with empty unicast control region as described in TS 36.213 [23] clause 12. This field can be included only if unicast-fembmsMixedSCell and crossCarrierScheduling are included.","paragraph_zero_based":3559},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":3560},{"literal_text_all_w_t_and_m_t":"en-DC","paragraph_zero_based":3561},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports EN-DC.","paragraph_zero_based":3562},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3563},{"literal_text_all_w_t_and_m_t":"endingDwPTS","paragraph_zero_based":3564},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports reception ending with a subframe occupied for a DwPTS-duration as described in TS 36.211 [21] and TS 36.213 [23]. This field can be included only if downlinkLAA is included.","paragraph_zero_based":3565},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3566},{"literal_text_all_w_t_and_m_t":"Enhanced-4TxCodebook","paragraph_zero_based":3567},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports enhanced 4Tx codebook.","paragraph_zero_based":3568},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":3569},{"literal_text_all_w_t_and_m_t":"enhancedDualLayerTDD","paragraph_zero_based":3570},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports enhanced dual layer (PDSCH transmission mode 8) for TDD or not.","paragraph_zero_based":3571},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3572},{"literal_text_all_w_t_and_m_t":"ePDCCH","paragraph_zero_based":3573},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE can receive DCI on UE specific search space on Enhanced PDCCH.","paragraph_zero_based":3574},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3575}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["e48e1d147c16e1cc3607acdd9e3ca3719278a34be50e3b6d260bdae053a34bab","21ba1b1a432b3c9e5096aa7b3d16bea24943ee9644ee6576500e6abde6b840c5","c90c44ac069dfb78f47f46110cd20efca0481c0cf762627ffd6360020ff35fab","6ed99f03437e337ca2b853d1a23e16784fa6eaab54c9966797d214877684b128","cfd71f7b7c81239f4d7fc17154d1a1951acb6f7e95cf9431e7d805dfa130a705","580888adbd5ed0a3bb4d85a9a5906ebf86926fb3030d7531085c585cf10373fd","53be5f71331be87bcb6f536319b4211c7f71ada297ed82a8c9b52f3cb834df4b","3683c3eef64c1e489b2021fd0fcc58ee2a3ae1355bc2227d83eb35367532c7b4","af1ae55f0b2114d4dabbb1f3820b0fe8234d47adb99b0f5d773b380f8e49ad2d","c18a6186fe0b8c40152479734eeb35cb8f7f793cae7b9c79e22ea8a673c7d730","74ecd9c39f5069f4b9d71be2334d176dcf668a69f5c4c6804ccfa0ca28b3feed","7f1120b1c38a4f5302d1bdefec5aa810deb413cf8acc20a98e9fd02b120ede3a","b9781f61b6e72b177e6c2623700851a8ad1a8c811dbb8fa4f95581d53ea2d8ad","6dc993eeb5f75022ce6a4ca3d29ac12dcde4bd6d24919652397faa0ded2ee41e","3d8e1c46195a27e7f68dbd9070c4cbc987dbe6d6012f5cc433dc33da7475ee31","22f93dfcc7f79c620f0ffc18f9209b75cc3892eafba01d614c424017c2aa1b62","78e25c02c214570a7a425cddcb4e02c0929ad4d3c39120066864545580abc256","dc4149057f104b4faa5b47823c1f70382ec6fe11b5d3a3147f34bf9fd4d2f5d3","ed0a91050adc0dc72c49bdacc397579ddca3bdde33231f38e72776090e55dcf5","548e9623631d1c1a227b8350b74e14aea1e154457d4c7e8a13b1000a3f898366","7b88f9d42bcb66119e991069e3923c0e2f619490eab70bd95651397c464988c4","37fda91ccabf32bffe5ceaa27b78937e2fc65d0c4eaf9b87be6e97dddacae29d","2f8866b4db9470ab03d7360563df6637be322b5264d644b20a8ae9daa0b2fd0c","b5ef6361a2e98e9a2bd3696542f8e55a76ea112ee4098116a215474142358fc6"],"paragraph_range_zero_based":[3552,3575],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p3552"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"epdcch-SPT-differentCells","paragraph_zero_based":3576},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports EPDCCH and short processing time on different serving cells.","paragraph_zero_based":3577},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3578},{"literal_text_all_w_t_and_m_t":"epdcch-STTI-differentCells","paragraph_zero_based":3579},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports EPDCCH and sTTI on different serving cells.","paragraph_zero_based":3580},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3581},{"literal_text_all_w_t_and_m_t":"e-RedirectionUTRA","paragraph_zero_based":3582},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3583},{"literal_text_all_w_t_and_m_t":"e-RedirectionUTRA-TDD","paragraph_zero_based":3584},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports enhanced redirection to UTRA TDD to multiple carrier frequencies both with and without using related SIB provided by RRCConnectionRelease or not.","paragraph_zero_based":3585},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3586},{"literal_text_all_w_t_and_m_t":"etws-CMAS-RxInConnCE-ModeA, etws-CMAS-RxInConn","paragraph_zero_based":3587},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE operating in CE mode A/B supports reception of ETWS/CMAS indication in RRC_CONNECTED mode as specified in TS 36.212 [22].","paragraph_zero_based":3588},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3589},{"literal_text_all_w_t_and_m_t":"eutra-5GC","paragraph_zero_based":3590},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports E-UTRA/5GC. ","paragraph_zero_based":3591},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3592},{"literal_text_all_w_t_and_m_t":"eutra-5GC-HO-ToNR-FDD-FR1","paragraph_zero_based":3593},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports handover from E-UTRA/5GC to NR FDD FR1. ","paragraph_zero_based":3594},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3595},{"literal_text_all_w_t_and_m_t":"eutra-5GC-HO-ToNR-TDD-FR1","paragraph_zero_based":3596},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports handover from E-UTRA/5GC to NR TDD FR1. ","paragraph_zero_based":3597},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3598},{"literal_text_all_w_t_and_m_t":"eutra-5GC-HO-ToNR-FDD-FR2","paragraph_zero_based":3599}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["bd3b2cb34997537409cd88f35f354e369e62f176f63b91b149ffd30d2a4222bb","7ae738f5a255ff198834112137e61da1dc38a0ae0af7208e14c9400e9e15f744","c4eb46aafacc07c0bf4d11dd825d5b84744b0d68440fba811942f3a5e5bb92e2","0029ed5b2b080fcadc9c82e30fb2bb5840af64445c0515d47079367e117fd0b8","46c31bd18b191558092acf3bd61654d5e6e563c40290741db74fbbf784efd982","25dfb18dddee53af61b194df3d28e0b8b9cf71415f7327ed70f079e37b481284","9d6a51e07cd64732e013ffb696dcbef7dced57c873b0b64a7dc1f9b555621fb1","e924029b95dbbf245d00a2e7eab188769461870abcae5e4e857134c3e7cb7807","6427998d8ec4ba40aa01cabe003e020ff9a92d1bd5670628449c5ae0ab2bfa23","424a70a1ebb21ac2338dba4c65c95039a49deae2f2acca3fa320a0a861ca11c4","23552d2961e502b1088f21a718b9f25a67fc4c718dc3bb768662a7c0150c16e7","927a8fc2c0f7cf8758a2bd8d319a1a54ce5a5eb947c927cc8c5f288c1f091ec4","1b814565f3e955756ffa432c5c51583cc0f82aef0c8a5385df497eb1c9777774","4beaca8eebd86f84c656f83015e28b71b0cec461b7808df05b59cb35e10b5d0a","8a20ba1ef631a3083729503d3c057e34fd6b1e607d509d3fddd06e07ae554268","81838fa