c3c65be8d50e5a4551517aa82a7f8b5dc54c3df72e9603f6829c0c2fa"],"paragraph_range_zero_based":[72,95],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2406946.zip::R2-2406946 Miscellaneous corrections for SL relay enhancements.docx:p72"}
{"fields":{"filename":"R2-2406946.zip::R2-2406946 Miscellaneous corrections for SL relay enhancements.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"affected:","paragraph_zero_based":96},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":97},{"literal_text_all_w_t_and_m_t":"X","paragraph_zero_based":98},{"literal_text_all_w_t_and_m_t":" Test specifications","paragraph_zero_based":99},{"literal_text_all_w_t_and_m_t":"TS/TR ... CR ... ","paragraph_zero_based":100},{"literal_text_all_w_t_and_m_t":"(show related CRs)","paragraph_zero_based":101},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":102},{"literal_text_all_w_t_and_m_t":"X","paragraph_zero_based":103},{"literal_text_all_w_t_and_m_t":" O&M Specifications","paragraph_zero_based":104},{"literal_text_all_w_t_and_m_t":"TS/TR ... CR ... ","paragraph_zero_based":105},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":106},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":107},{"literal_text_all_w_t_and_m_t":"Other comments:","paragraph_zero_based":108},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":109},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":110},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":111},{"literal_text_all_w_t_and_m_t":"This CR's revision history:","paragraph_zero_based":112},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":113},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":114},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":115},{"literal_text_all_w_t_and_m_t":"Start of Change","paragraph_zero_based":116},{"literal_text_all_w_t_and_m_t":"4.2.2Signalling radio bearers","paragraph_zero_based":117},{"literal_text_all_w_t_and_m_t":"\"Signalling Radio Bearers\" (SRBs) are defined as Radio Bearers (RBs) that are used only for the transmission of RRC and NAS messages. More specifically, the following SRBs are defined:","paragraph_zero_based":118},{"literal_text_all_w_t_and_m_t":"-SRB0 is for RRC messages using the CCCH logical channel (except SRB0 of L2 U2N Remote UE);","paragraph_zero_based":119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"a22ca998f923cf4a9de502434a394294d9d7b59a79b610cef677589f92cad30c","original_member_sha256":"a9c4e67b0d823294c4dc08643f433a8868c3d3e314d299ae362f3e4056cf3a8e","paragraph_ElementTree_utf8_XML_sha256":["5b9d3e94b2e2469a162f36c651ac6802b31fcc4b4fed4f8769f27295b66f32e3","0e47661d68410752894205dee6a9bbbad763c4fb8f938472f606caa30fd5b3b2","e5df984f6829673bdbbfc7a54cf177296e5b7ff131b068956bdf6c9544d9dc6e","046072d789da32203b2dbdc5bf6faf7ce0947321bf61b1475c3867e7f07b4f28","ad7c58beb1d9e90fb0849bcd216a0fa195ed528b17181f725cf2b49a179cb8f1","826ddaefbd35bf5941dd0ba7402603c67afa4054d718e9bc0124542ef7dca6de","f93659204248bf7212a2a073874fa6ef6bab855e1f334d94d95f69bdfcb0d978","a6318fe4cb2f84a312026776bb1bc817ab73a5032764a957bdfde1ae28d76645","84cfffd8b170c458e9fd1f937758338e77952052a138c7c60120dc1e8ee9c412","f7b3a7bb9ad97a828da3323273c2deac8004729d61d7f2c7a25185dd92d4eb66","623edfeb67c2d41b2b9e147012100dce2f709456a108863b11db12637e74c692","972c89243ea25b912af8179a8be8c77ab6d50347dd064fa94fff2d9d947bbd4b","022031e640f79d734e0c0078695b4546709c7cc0e2d4b09f740c852d83464850","90739a9b5718a75a6036a95b91a37f44f1e9aef38922942dfe97f431acb1a425","6c4b79aee2df9417fdcf7ff053d8ed2a9ea25e31efedf31e6292500ff9c4b627","8a2054446422db10127b53522c244dd671006eed469081cd46119e9103434846","09696b54939497a8ca2ba620420c03c7479c8446d64fb680ae1962b6d211066f","c002616492b1923e46d6fa95a25dac7944411eca88ccdcee2199f265ed726678","d02e8cbd697ae1810074c3012247d88e70339f7889a7482c352e21eca4a8f878","5e6e78c509901ae3936d881dd0c9b12c94a02c1a5b9226ba72b61bcdd6bc46b1","318d38305e761c29a56a4f1f4fbb3fcea3186b29f9d3ba521f061f62b179d072","c6bebeaf74f4b7abe7dffa289216a31d1106319341083a07124761d8ff49ba49","21a700ef26a96064144e2c89ee18f8a6d9c4d889bac33695f25514639318f9dd","ebc473f7a214ce16c7b90f8c14bd69ead76528ae549682c12bd57f31dcf09e4f"],"paragraph_range_zero_based":[96,119],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2406946.zip::R2-2406946 Miscellaneous corrections for SL relay enhancements.docx:p96"}
{"fields":{"filename":"R2-2406946.zip::R2-2406946 Miscellaneous corrections for SL relay enhancements.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-SRB1 is for RRC messages (which may include a piggybacked NAS message) as well as for NAS messages prior to the establishment of SRB2, all using DCCH logical channel (except SRB1 of L2 U2N Remote UE);","paragraph_zero_based":120},{"literal_text_all_w_t_and_m_t":"-SRB2 is for NAS messages and for RRC messages which include logged measurement information, all using DCCH logical channel (except SRB2 of L2 U2N Remote UE). SRB2 has a lower priority than SRB1 and may be configured by the network after AS security activation;","paragraph_zero_based":121},{"literal_text_all_w_t_and_m_t":"-SRB3 is for specific RRC messages when UE is in (NG)EN-DC or NR-DC, all using DCCH logical channel;","paragraph_zero_based":122},{"literal_text_all_w_t_and_m_t":"-SRB4 is for RRC messages which include application layer measurement report information, all using DCCH logical channel. SRB4 has a lower priority than SRB1 and can only be configured by the network after AS security activation.","paragraph_zero_based":123},{"literal_text_all_w_t_and_m_t":"-SRB5 is for RRC messages which include application layer measurement report information, all using DCCH logical channel. SRB5 has a lower priority than SRB1 and SRB3 and can only be configured by the SN serving the SCG when the UE is in NR-DC, after AS security activation.","paragraph_zero_based":124},{"literal_text_all_w_t_and_m_t":"In downlink, piggybacking of NAS messages is used only for one dependant (i.e. with joint success/failure) procedure: bearer establishment/modification/release. In uplink piggybacking of NAS message is used only for transferring the initial NAS message during connection setup and connection resume.","paragraph_zero_based":125},{"literal_text_all_w_t_and_m_t":"NOTE 1:The NAS messages transferred via SRB2 are also contained in RRC messages, which however do not include any RRC protocol control information.","paragraph_zero_based":126},{"literal_text_all_w_t_and_m_t":"Once AS security is activated, all RRC messages on SRB1, SRB2, SRB3, SRB4 and SRB5, including those containing NAS messages, are integrity protected and ciphered by PDCP. NAS independently applies integrity protection and ciphering to the NAS messages, see TS 24.501 [23].","paragraph_zero_based":127},{"literal_text_all_w_t_and_m_t":"Split SRB is supported for all the MR-DC options as well as MP in both SRB1 and SRB2 (split SRB is not supported for SRB0, SRB3, SRB4 and SRB5).","paragraph_zero_based":128},{"literal_text_all_w_t_and_m_t":"For operation with shared spectrum channel access in FR1, SRB0, SRB1 and SRB3 are assigned with the highest priority Channel Access Priority Class (CAPC), (i.e. CAPC = 1) while CAPC for SRB2 is configurable.","paragraph_zero_based":129},{"literal_text_all_w_t_and_m_t":"For the NR sidelink L2 U2N relay operations not involved in MP, SRB0, SRB1, SRB2 of a L2 U2N Remote UE are not using Uu CCCH/DCCH logical channels. The SRB0, SRB1, SRB2 of a L2 U2N Remote UE are transmitted via the PC5 Relay RLC channels over PC5 and Uu Relay RLC channels over Uu.","paragraph_zero_based":130},{"literal_text_all_w_t_and_m_t":"Next Change","paragraph_zero_based":131},{"literal_text_all_w_t_and_m_t":"5.3.3.1aConditions for establishing RRC Connection for NR sidelink communication/discovery/V2X sidelink communication/MP operation","paragraph_zero_based":132},{"literal_text_all_w_t_and_m_t":"For NR sidelink communication/discovery, an RRC connection establishment is initiated only in the following cases:","paragraph_zero_based":133},{"literal_text_all_w_t_and_m_t":"1>if configured by upper layers to transmit NR sidelink communication and related data is available for transmission:","paragraph_zero_based":134},{"literal_text_all_w_t_and_m_t":"2>if the frequency on which the UE is configured to transmit NR sidelink communication is included in sl-FreqInfoList/sl-FreqInfoListSizeExt within SIB12 provided by the cell on which the UE camps; and if the valid version of SIB12 does not include sl-TxPoolSelectedNormal for the concerned frequency;","paragraph_zero_based":135},{"literal_text_all_w_t_and_m_t":"1>if configured by upper layers to transmit NR sidelink discovery and related data is available for transmission:","paragraph_zero_based":136},{"literal_text_all_w_t_and_m_t":"2>if the UE is configured by upper layers to transmit NR sidelink L2 U2N relay discovery messages and sl-L2U2N-Relay is included in SIB12; or","paragraph_zero_based":137},{"literal_text_all_w_t_and_m_t":"2>if the UE is configured by upper layers to transmit NR sidelink L3 U2N relay discovery messages and sl-L3U2N-RelayDiscovery is included in SIB12; or","paragraph_zero_based":138},{"literal_text_all_w_t_and_m_t":"2>if the UE is configured by upper layers to transmit NR sidelink non-relay discovery messages and sl-NonRelayDiscovery is included in SIB12:","paragraph_zero_based":139},{"literal_text_all_w_t_and_m_t":"3>if the frequency on which the UE is configured to transmit NR sidelink discovery is included in sl-FreqInfoList within SIB12 provided by the cell on which the UE camps; and if the valid version of SIB12 includes neither sl-DiscTxPoolSelected nor sl-TxPoolSelectedNormal for the concerned frequency;","paragraph_zero_based":140},{"literal_text_all_w_t_and_m_t":"For L2 U2N Relay UE in RRC_IDLE, an RRC connection establishment is initiated in the following cases:","paragraph_zero_based":141},{"literal_text_all_w_t_and_m_t":"1>if any message is received from a L2 U2N Remote UE via SL-RLC0 as specified in 9.1.1.4 or SL-RLC1 as specified in 9.2.4; or","paragraph_zero_based":142},{"literal_text_all_w_t_and_m_t":"1>if RemoteUEInformationSidelink containing the connectionForMP is received from a L2 U2N Remote UE as specified in 5.8.9.8.3;","paragraph_zero_based":143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"a22ca998f923cf4a9de502434a394294d9d7b59a79b610cef677589f92cad30c","original_member_sha256":"a9c4e67b0d823294c4dc08643f433a8868c3d3e314d299ae362f3e4056cf3a8e","paragraph_ElementTree_utf8_XML_sha256":["3a57330074b95e965696c4009b71c7b663a8e240d38b8f458ea0593d24af13b0","3313d038bde325b1cabefcbb4d831b381a6a3099400e4c8ff67dbd1b309bb3e4","f68085a1846bf050af983eb7e31f9824595334ea7ebe7af1e35f501a06a7e23a","1762e12d7aaeda08b99849e6a05bbdcb949176ec936ad65d482869a2725c77e5","e798f504f6b498bd942868ec0c24ef31fda1a00ceec6ffd8d106967207d46f3d","61e8e08ddbdd3ee968eacf1579fd954ff47c89570e2a1f73677c2aa531d695ea","f17cbcf88c93bfb4d60f73cf27c676ce1369734ad6383e5bda07493c2e4de814","6a92eccd36001d8c4af4313db847cbe67d25b4f2899a76c868abcfb2aa8a5dbe","168b2f1ddd7026d56433d186097c971abdac578b6ea35a078c9c8db349646c2b","ebc86ab36af9ce9aefe7f0a51efb59d810f5f01309b41fa34eee24571164060b","060d8c89f84c87eaea386f280b053ffe64a1696d7adbc95319a387c41ac108e3","760fcb4dd60d230e0a20c7c315708c6e62804ec6120591ced83cdfd8deff5e96","961c0c1ceb7d14337ac8467ac2d50257de429cca777083bfe9002a584841dc17","a912128bddaa3716976d4e1198db4fde1f48ab8efeb2aee83e8ac8179775388c","c581b9b9a1d14e6f59980e4c8dbc23f5653f6c2f2e87312bb8d8fe9bc4fc38e8","e4930248b129b8854c003f2c20c235e3ab58328132c7af8bbeefa877a0b58075","ef4e76d2fff4815fa4b9811358256ab8cc7b913c6e34f61d00694bd58eb7e0eb","f4103257dced4855ff5f0a5878febee6a883df088f4cfb8c66066e72071d6675","fb29052172e0f5215720c5a85fcd9c84558a2eaaf9c471c83b4d49e73999ce27","a2794a2959b37f9fdf832cfc37f79d43d0dff0eb2befd71e2f194eb2af833c06","2d3786dc404974819d029fa032b3b01602bba03a5bf58bdb3504aa0f5ec5bf39","153f67e24c7fac84801631eca7fe839f208933e6373c6b0043bfacf61b1fab51","2515d486a357dfa7fb6ccf68b9ef4c1ca17dc30906bd00031d540f2f58ae9dd9","a87886af3324bb1b7a4708f556868e1ffc302301cd60e5144ae0297d26a8a366"],"paragraph_range_zero_based":[120,143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2406946.zip::R2-2406946 Miscellaneous corrections for SL relay enhancements.docx:p120"}
{"fields":{"filename":"R2-2406946.zip::R2-2406946 Miscellaneous corrections for SL relay enhancements.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"For V2X sidelink communication, an RRC connection is initiated only when the conditions specified for V2X sidelink communication in clause 5.3.3.1a of TS 36.331 [10] are met.","paragraph_zero_based":144},{"literal_text_all_w_t_and_m_t":"NOTE 1:Upper layers initiate an RRC connection (except if the RRC connection is initiated at the L2 U2N Relay UE upon reception of a message from a L2 U2N Remote UE via SL-RLC0 or SL-RLC1, or upon reception of RemoteUEInformationSidelink message containing the connectionForMP). The interaction with NAS is left to UE implementation.","paragraph_zero_based":145},{"literal_text_all_w_t_and_m_t":"For N3C relay UE in RRC_IDLE, an RRC connection establishment is initiated when a N3C remote UE indicates it to enter RRC_CONNECTED state.","paragraph_zero_based":146},{"literal_text_all_w_t_and_m_t":"NOTE 2:How/when the N3C remote UE to indicate N3C relay UE to enter RRC_CONNECTED state is left to UE implementation, e.g. before reporting relay UE information with non-3GPP connection(s).","paragraph_zero_based":147},{"literal_text_all_w_t_and_m_t":"Next Change","paragraph_zero_based":148},{"literal_text_all_w_t_and_m_t":"5.3.5.15.1General","paragraph_zero_based":149},{"literal_text_all_w_t_and_m_t":"The network configures the L2 U2N or U2U Relay UE with relay operation related configurations. For each connected L2 U2N or U2U Remote UE indicated in sl-L2IdentityRemote, the network provides the configuration parameters used for relaying.","paragraph_zero_based":150},{"literal_text_all_w_t_and_m_t":"The L2 U2N Relay UE shall:","paragraph_zero_based":151},{"literal_text_all_w_t_and_m_t":"1>if sl-L2RelayUE-Config is set to setup:","paragraph_zero_based":152},{"literal_text_all_w_t_and_m_t":"2>if the sl-L2RelayUE-Config contains the sl-RemoteUE-ToReleaseList:","paragraph_zero_based":153},{"literal_text_all_w_t_and_m_t":"3>perform the L2 U2N Remote UE release as specified in 5.3.5.15.2;","paragraph_zero_based":154},{"literal_text_all_w_t_and_m_t":"2>if the sl-L2RelayUE-Config contains the sl-RemoteUE-ToAddModList:","paragraph_zero_based":155},{"literal_text_all_w_t_and_m_t":"3>perform the L2 U2N Remote UE addition/modification as specified in 5.3.5.15.3;","paragraph_zero_based":156},{"literal_text_all_w_t_and_m_t":"1>else if sl-L2RelayUE-Config is set to release:","paragraph_zero_based":157},{"literal_text_all_w_t_and_m_t":"2>release the L2 U2N relay operation related configurations.","paragraph_zero_based":158},{"literal_text_all_w_t_and_m_t":"The L2 U2U Relay UE shall:","paragraph_zero_based":159},{"literal_text_all_w_t_and_m_t":"1>if sl-L2RelayUE-Config is set to setup:","paragraph_zero_based":160},{"literal_text_all_w_t_and_m_t":"2>if the sl-L2RelayUE-Config contains the sl-U2U-RemoteUE-ToReleaseList:","paragraph_zero_based":161},{"literal_text_all_w_t_and_m_t":"3>perform the L2 U2U Remote UE release as specified in 5.3.5.15.2;","paragraph_zero_based":162},{"literal_text_all_w_t_and_m_t":"2>if the sl-L2RelayUE-Config contains the sl-U2U-RemoteUE-ToAddModList:","paragraph_zero_based":163},{"literal_text_all_w_t_and_m_t":"3>perform the L2 U2U Remote UE addition/modification as specified in 5.3.5.15.3;","paragraph_zero_based":164},{"literal_text_all_w_t_and_m_t":"1>else if sl-L2RelayUE-Config is set to release:","paragraph_zero_based":165},{"literal_text_all_w_t_and_m_t":"2>release the L2 U2U relay operation related configurations.","paragraph_zero_based":166},{"literal_text_all_w_t_and_m_t":"Next Change","paragraph_zero_based":167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"a22ca998f923cf4a9de502434a394294d9d7b59a79b610cef677589f92cad30c","original_member_sha256":"a9c4e67b0d823294c4dc08643f433a8868c3d3e314d299ae362f3e4056cf3a8e","paragraph_ElementTree_utf8_XML_sha256":["36a2be6bb21d4f8175c690c64135f2757b7c51387051740ad2c0cdf2865aedea","08cf10bbf0a31c7bfe53591421d30be9f9d53075786830db5dd9fc3c873892e5","aae95e09ba924d75ee627d9f25eb19668b35a6eb97001f7e22bd49862fe5ca3b","b7f2e43bb4f87b05c93616d9b61c8561bdfb7cab7c3f90b2a31f8ba3da94f40e","526ea136986bea22ba16fa26881caace16ccd97cdcd88d786c1d2dee2645e6e2","8c5e4abd90156c5b548e530cff79e42dd9b345ca47c0841e1462d6b9ad312c86","08df2b5c7fa0c5a11345db401a5cc8343134c2a1b115c6c85dafb4e6dfa44249","b5408efe4339797caac8cbe51ccef205d1ac89ab828af5b20e383a9311338da4","6d12e1cddec5ab98ebbd82e0de78d751fc21b599d64f250ee45a8ab89828b1ff","fbe1c1d255148dae8d869c443b25b72fcfba8da5f158183b83c0932f110caa2d","2c854f2e57684e6bc15071649b872941cb11eb9dc3fcc9c37ea49eede203e0ac","d7c446c99e5a5d93aa4b27bb44b7cc5da7b80e1b6469b2758ca62784c5145883","e1c6ef1f8932f2642a21ab2e73b26351fee194f1cce9d60ac568dbad0cd1bc6d","2d2f142d04c9870b52c7216f9dc634a2b1cf5930f5d92d3e5bdb9de6fefc4c0a","eb952b8434a13a27ee20082adb14a7d320269e396c06b2ef070fd9411eae4415","67310fc6875ec3fd8f4d3e24011bc8ef487a1f8eb6b1413792338424ceb16de5","27a682edf59ed5e5dd286583bbf3554534fc08f6d66400839a6169cc19dd05c6","65a2375b5fce52aa824f205b1d9584df7771c79c1cac9459fadae687d1610678","9a7e9478fc321aeea42f1a619c941ba6fc33cb85c35e27016e6dcf984c9b9af3","3f29b247beda1c7240c4c91ed41eaba0205feb03b78fcaae72dfc9fead915f23","ff548cee97d5cb9e4e5a6c99202738e9b1617af72c501ad09a3705ca8a0bc670","ffc92bb85940d9fb1289e59ee9b115d1872f13793a9bd35d52a99faf062a4c6c","088f72aafd577df715ce7585dda2e36eca1148be961309152eb04f2278c11702","be10cab300051ab77702070fbfb55ed602d32fb201e8cb9cc2a227105a99a0c4"],"paragraph_range_zero_based":[144,167],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2406946.zip::R2-2406946 Miscellaneous corrections for SL relay enhancements.docx:p144"}
{"fields":{"filename":"R2-2406946.zip::R2-2406946 Miscellaneous corrections for SL relay enhancements.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.3.5.17.2.2SL indirect path specific configuration","paragraph_zero_based":168},{"literal_text_all_w_t_and_m_t":"The L2 U2N Remote UE shall:","paragraph_zero_based":169},{"literal_text_all_w_t_and_m_t":"1>if sl-IndirectPathAddChange is set to setup:","paragraph_zero_based":170},{"literal_text_all_w_t_and_m_t":"2>if the sl-IndirectPathMaintain is included in reconfigurationWithSync:","paragraph_zero_based":171},{"literal_text_all_w_t_and_m_t":"3>consider the source L2 U2N Relay UE to be the L2 U2N Relay UE on indirect path in MP operation;","paragraph_zero_based":172},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":173},{"literal_text_all_w_t_and_m_t":"3>consider the UE indicated by the sl-IndirectPathRelayUE-Identity to be the (target) L2 U2N Relay UE and indicate to upper layer to trigger the PC5 unicast link establishment with the L2 U2N Relay UE if not establishment;","paragraph_zero_based":174},{"literal_text_all_w_t_and_m_t":"3>start timer T421 for the corresponding L2 U2N Relay UE with the timer value set to T421;","paragraph_zero_based":175},{"literal_text_all_w_t_and_m_t":"3>if reconfigurationWithSync is not included in the same RRCReconfiguration message:","paragraph_zero_based":176},{"literal_text_all_w_t_and_m_t":"4>indicate to upper layer (to trigger the PC5 unicast link release) with the source L2 U2N Relay UE in case of SL indirect path change (i.e. a new L2 U2N Relay UE is indicated via sl-IndirectPathRelayUE-Identity);","paragraph_zero_based":177},{"literal_text_all_w_t_and_m_t":"1>else if sl-IndirectPathAddChange is set to release:","paragraph_zero_based":178},{"literal_text_all_w_t_and_m_t":"2>consider the SL indirect path is released and release the corresponding configurations;","paragraph_zero_based":179},{"literal_text_all_w_t_and_m_t":"2>indicate to upper layer (to trigger the PC5 unicast link release) with the L2 U2N Relay UE.","paragraph_zero_based":180},{"literal_text_all_w_t_and_m_t":"NOTE:The MP direct path addition is realized by indirect-to-direct path switch procedure (i.e. ReconfigurationWithSync included in RRCReconfiguration message), where sl-IndirectPathAddChange is set to setup in RRCReconfiguration message.","paragraph_zero_based":181},{"literal_text_all_w_t_and_m_t":"Next Change","paragraph_zero_based":182},{"literal_text_all_w_t_and_m_t":"5.3.5.17.3.3N3C relay UE configuration","paragraph_zero_based":183},{"literal_text_all_w_t_and_m_t":"The N3C relay UE shall:","paragraph_zero_based":184},{"literal_text_all_w_t_and_m_t":"1>if n3c-IndirectPathConfigRelay is set to setup:","paragraph_zero_based":185},{"literal_text_all_w_t_and_m_t":"2>if n3c-MappingToReleaseList is included:","paragraph_zero_based":186},{"literal_text_all_w_t_and_m_t":"3>perform N3C bearer mapping release as specified in 5.3.5.17.3.4.1;","paragraph_zero_based":187},{"literal_text_all_w_t_and_m_t":"2>if n3c-MappingToAddModList is included:","paragraph_zero_based":188},{"literal_text_all_w_t_and_m_t":"3>perform N3C bearer mapping addition/modification as specified in 5.3.5.17.3.4.2;","paragraph_zero_based":189},{"literal_text_all_w_t_and_m_t":"1>else if n3c-IndirectPathConfigRelay is set to release:","paragraph_zero_based":190},{"literal_text_all_w_t_and_m_t":"2>consider the indirect path with the remote UE is released and release the corresponding configuration.","paragraph_zero_based":191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"a22ca998f923cf4a9de502434a394294d9d7b59a79b610cef677589f92cad30c","original_member_sha256":"a9c4e67b0d823294c4dc08643f433a8868c3d3e314d299ae362f3e4056cf3a8e","paragraph_ElementTree_utf8_XML_sha256":["5d4eba7cd4f13251303665328933906b4a108be3313623916090a40e519b7963","f96b33b63a4a000800f7184db4648aa96b65b65c4085fa8541307cdbdf288e60","e05ea06bd2ec408dae0af9a661b8d6442f8610a25552e6f6a1e1b0db5e3b6a12","6ce5629f8650f894720d23adc54d6dcf16cc76135b664c3323992cdc769db472","9c0802cb55a9bd3d64017b4921c7935dc879a1197d6602228da84dc6d721aa79","68e515eecacc7e57626b9036d5c77d6fd778fa310d9bdc16dacba588065ecf39","89378cb25059c9d9a4bba778c4b0c861ed721cbb21ae4d719a5d016d9a9a418d","544612d871beb01d2f1102094ac69a01eeec63ad81ab40913836d26fa77764e5","efea557d7a7726236f40f97bf2828f6f889cd38d33a49da2a32320b5cd1a00df","1b54dfa00c2d3446161194e99882bfc1906f87111ee224341c24f1177e347c51","bc1375965573f4c35d60d8a89070d2c4663bfece267f672331649d9a9fd19ab7","12d2946fc4dc61c07f9b7b485bdb8d6a1d159ac6f12ec04a157b0faf6789d8cf","a25811e4a800d0c9af48c70a91ccb551ed848949726e85be58b8d09895e4c826","dd0b8b22bc57038b373f772a9c098be89081869423032e455865aeec1c49af5e","dac6943fcdc176125973eb6a9422792ebf3199f1c79094a105bc8fc8f1dcb7af","7240985dc83d39eeb88ce01851150c6b4501d355e1cf947f021291a84d3f5ad7","6bf42e7fc13767d1b727d0aff06bb3205e02a8843790f36c57c2b5b295674efe","a8e3c724b4d5a2e13614f422d8b39cb47078844ef372d19c73208cc6da7ae0ad","2a12c15344d8d9a1d234f093aeb9ef466f473fcafc02a0f8feabf7af0fe226bf","939086b7237ac5569281918fddb58ae44e32cf956b46372aa59dbc16092f9e1a","c7fd62a0d6d246f3201419855fd9f01a94ef37a14b085c87bbaa16dccda94bfc","9e5e02a52425aabff157db7c5f7bed77f56665021f80a1e3bd0463ada32b7f77","146707333fef8fa8ef016086d8ee109e4824b087add7495b364039d69c1b0545","afcabded6e4ef5e07e59e6c0923c9917ee5c65e94e3d4bd8f87b56a12b19d338"],"paragraph_range_zero_based":[168,191],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2406946.zip::R2-2406946 Miscellaneous corrections for SL relay enhancements.docx:p168"}
{"fields":{"filename":"R2-2406946.zip::R2-2406946 Miscellaneous corrections for SL relay enhancements.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Next Change","paragraph_zero_based":192},{"literal_text_all_w_t_and_m_t":"5.3.13.1aConditions for resuming RRC Connection for NR sidelink communication/discovery/V2X sidelink communication","paragraph_zero_based":193},{"literal_text_all_w_t_and_m_t":"For NR sidelink communication/discovery an RRC connection is resumed only in the following cases:","paragraph_zero_based":194},{"literal_text_all_w_t_and_m_t":"1>if configured by upper layers to transmit NR sidelink communication and related data is available for transmission:","paragraph_zero_based":195},{"literal_text_all_w_t_and_m_t":"2>if the frequency on which the UE is configured to transmit NR sidelink communication is included in sl-FreqInfoList/sl-FreqInfoListSizeExt within SIB12 provided by the cell on which the UE camps; and if the valid version of SIB12 does not include sl-TxPoolSelectedNormal for the concerned frequency;","paragraph_zero_based":196},{"literal_text_all_w_t_and_m_t":"1>if configured by upper layers to transmit NR sidelink discovery and related data is available for transmission:","paragraph_zero_based":197},{"literal_text_all_w_t_and_m_t":"2>if the UE is configured by upper layers to transmit NR sidelink L2 U2N relay discovery messages and sl-L2U2N-Relay is included in SIB12; or","paragraph_zero_based":198},{"literal_text_all_w_t_and_m_t":"2>if the UE is configured by upper layers to transmit NR sidelink L3 U2N relay discovery messages and sl-L3U2N-RelayDiscovery is included in SIB12; or","paragraph_zero_based":199},{"literal_text_all_w_t_and_m_t":"2>if the UE is configured by upper layers to transmit NR sidelink non-relay discovery messages and sl-NonRelayDiscovery is included in SIB12:","paragraph_zero_based":200},{"literal_text_all_w_t_and_m_t":"3>if the frequency on which the UE is configured to transmit NR sidelink discovery is included in sl-FreqInfoList within SIB12 provided by the cell on which the UE camps; and if the valid version of SIB12 does not include sl-DiscTxPoolSelected or sl-TxPoolSelectedNormal for the concerned frequency;","paragraph_zero_based":201},{"literal_text_all_w_t_and_m_t":"For L2 U2N Relay UE in RRC_INACTIVE, an RRC connection establishment is resumed in the following cases:","paragraph_zero_based":202},{"literal_text_all_w_t_and_m_t":"1>if any message is received from the L2 U2N Remote UE via SL-RLC0 as specified in 9.1.1.4 or SL-RLC1 as specified in 9.2.4; or","paragraph_zero_based":203},{"literal_text_all_w_t_and_m_t":"1>if RemoteUEInformationSidelink containing the connectionForMP is received from a L2 U2N Remote UE as specified in 5.8.9.8.3;","paragraph_zero_based":204},{"literal_text_all_w_t_and_m_t":"For V2X sidelink communication an RRC connection resume is initiated only when the conditions specified for V2X sidelink communication in clause 5.3.3.1a of TS 36.331 [10] are met.","paragraph_zero_based":205},{"literal_text_all_w_t_and_m_t":"NOTE:Upper layers initiate an RRC connection resume (except if the RRC connection resume is initiated at the L2 U2N Relay UE upon reception of a message from a L2 U2N Remote UE via SL-RLC0 or SL-RLC1, or upon reception of RemoteUEInformationSidelink message containing the connectionForMP). The interaction with NAS is left to UE implementation.","paragraph_zero_based":206},{"literal_text_all_w_t_and_m_t":"End of Changes","paragraph_zero_based":207},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":208}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"a22ca998f923cf4a9de502434a394294d9d7b59a79b610cef677589f92cad30c","original_member_sha256":"a9c4e67b0d823294c4dc08643f433a8868c3d3e314d299ae362f3e4056cf3a8e","paragraph_ElementTree_utf8_XML_sha256"