{"fields":{"filename":"R2-2502074.zip::R2-2502074 Introudction of control parameters for on-demand posSIB request for RRC_final.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field specifies the interval between assistance data deliveries in milliseconds. This field is absent when the field deliveryAmount is set to 0.","paragraph_zero_based":240},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":241},{"literal_text_all_w_t_and_m_t":"PosSIB-ReqInfo field descriptions","paragraph_zero_based":242},{"literal_text_all_w_t_and_m_t":"gnss-id","paragraph_zero_based":243},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that the request positioning SIB type is for a specific GNSS. Indicates a specific GNSS (see also TS 37.355 [49])","paragraph_zero_based":244},{"literal_text_all_w_t_and_m_t":"sbas-id","paragraph_zero_based":245},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that the request positioning SIB type is for a specific SBAS. Indicates a specific SBAS (see also TS 37.355 [49]). If the UE includes this field it shall set gnss-id to sbas.","paragraph_zero_based":246},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":247},{"literal_text_all_w_t_and_m_t":"=====================================================NEXT CHANGE=============================================================","paragraph_zero_based":248},{"literal_text_all_w_t_and_m_t":"–RRCReconfiguration","paragraph_zero_based":249},{"literal_text_all_w_t_and_m_t":"The RRCReconfiguration message is the command to modify an RRC connection. It may convey information for measurement configuration, mobility control, radio resource configuration (including RBs, MAC main configuration and physical channel configuration) and AS security configuration.","paragraph_zero_based":250},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1 or SRB3","paragraph_zero_based":251},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":252},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":253},{"literal_text_all_w_t_and_m_t":"Direction: Network to UE","paragraph_zero_based":254},{"literal_text_all_w_t_and_m_t":"RRCReconfiguration message","paragraph_zero_based":255},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":256},{"literal_text_all_w_t_and_m_t":"-- TAG-RRCRECONFIGURATION-START","paragraph_zero_based":257},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":258},{"literal_text_all_w_t_and_m_t":"RRCReconfiguration ::=                  SEQUENCE {","paragraph_zero_based":259},{"literal_text_all_w_t_and_m_t":"    rrc-TransactionIdentifier               RRC-TransactionIdentifier,","paragraph_zero_based":260},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                      CHOICE {","paragraph_zero_based":261},{"literal_text_all_w_t_and_m_t":"        rrcReconfiguration                      RRCReconfiguration-IEs,","paragraph_zero_based":262},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture                SEQUENCE {}","paragraph_zero_based":263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e0c257c70d07100f1ede427a4f65f560f2201057cbf73ef45f430ec77898d451","original_member_sha256":"c33e87983ca56840fbfb3ece9b2b5c25c1e6cd4e9cf14026330d400169e5fdbe","paragraph_ElementTree_utf8_XML_sha256":["c79feef4eec532a8c804acd3d4ce8544bc817e339f2a50a3febe98816ac7a10d","c2a563eb0cde827eb9dc0b99e6ae07ab7e472dc2544a9beb6f85c3b3df87a762","6eb5ff67ff90999f4963a7545b498e5baa2716a4db7f8b33f12d4245091c9d0e","3c2278d64f792d95aedc3e5d94a10b1b4fbb71821f403c1bade72495b5cc3f8c","59799aa2a6643f030c724718c60205d77bbebb3c5beab77a85029c632dc71e68","75bae36a6693741d4de5e1ca9e12be5b865bec8cf6ffbe412abf91ddc7ff47e5","1b9f8d0a775e8656ad299eb6e56529e33ffba05d635df1037475241ef7