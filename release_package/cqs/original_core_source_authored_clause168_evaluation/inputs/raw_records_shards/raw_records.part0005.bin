{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"EUTRA measurement results performed during RRC_INACTIVE or RRC_IDLE.","paragraph_zero_based":3648},{"literal_text_all_w_t_and_m_t":"measResultIdleNR","paragraph_zero_based":3649},{"literal_text_all_w_t_and_m_t":"NR measurement results performed during RRC_INACTIVE or RRC_IDLE.","paragraph_zero_based":3650},{"literal_text_all_w_t_and_m_t":"ra-ReportList","paragraph_zero_based":3651},{"literal_text_all_w_t_and_m_t":"This field is used to provide the list of RA reports that is stored by the UE for up to maxRAReport-r16 number of random access procedures. If the UE is an eRedCap UE, this field is used to provide the list of RA reports that is stored by the UE for up to 2 number of random access procedures.","paragraph_zero_based":3652},{"literal_text_all_w_t_and_m_t":"rlf-Report","paragraph_zero_based":3653},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the RLF report related contents.","paragraph_zero_based":3654},{"literal_text_all_w_t_and_m_t":"successHO-Report","paragraph_zero_based":3655},{"literal_text_all_w_t_and_m_t":"This field is used to provide the successful handover report if triggered based on the successful handover configuration.","paragraph_zero_based":3656},{"literal_text_all_w_t_and_m_t":"successPSCell-Report","paragraph_zero_based":3657},{"literal_text_all_w_t_and_m_t":"This field is used to provide the successful PSCell change or addition report if triggered based on the successful PSCell change or addition report configuration.","paragraph_zero_based":3658},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3659},{"literal_text_all_w_t_and_m_t":"LogMeasReport field descriptions","paragraph_zero_based":3660},{"literal_text_all_w_t_and_m_t":"absoluteTimeStamp","paragraph_zero_based":3661},{"literal_text_all_w_t_and_m_t":"Indicates the absolute time when the logged measurement configuration logging is provided, as indicated by NR within absoluteTimeInfo.","paragraph_zero_based":3662},{"literal_text_all_w_t_and_m_t":"anyCellSelectionDetected","paragraph_zero_based":3663},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the detection of any cell selection state, as defined in TS 38.304 [20]. The UE sets this field when performing the logging of measurement results in RRC_IDLE or RRC_INACTIVE and there is no suitable cell or no acceptable cell.","paragraph_zero_based":3664},{"literal_text_all_w_t_and_m_t":"inDeviceCoexDetected","paragraph_zero_based":3665},{"literal_text_all_w_t_and_m_t":"Indicates that measurement logging is suspended due to IDC problem detection.","paragraph_zero_based":3666},{"literal_text_all_w_t_and_m_t":"measResultServingCell","paragraph_zero_based":3667},{"literal_text_all_w_t_and_m_t":"This field refers to the log measurement results taken in the Serving cell.","paragraph_zero_based":3668},{"literal_text_all_w_t_and_m_t":"nsag-ID","paragraph_zero_based":3669},{"literal_text_all_w_t_and_m_t":"Indicates the NSAG ID with the highest priority, for the UE that was configured with slice-based cell reselection and was not able to perform a cell reselection to a cell asscoiated with the NSAG with highest priority (as specified in TS 38.304 [20]).","paragraph_zero_based":3670},{"literal_text_all_w_t_and_m_t":"numberOfGoodSSB","paragraph_zero_based":3671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["7ec2dcaf3dc3121d28dde81a2398793c9d0d6f88033bd42a1fc0787de40bf4c8","f7471d738e365e4155e4bf372e635d9d4ac16b0178ab6ab513e7f109132b3084","5287ab44847ac19c9803faa339dad6685a100b5930f28c57589793f2c5ce97a1","5e660db67416c944379287da84af9ded514cc2f9a6921bde79dfc7fffcdc6c97","3c81431ea9956afe86b1a84c75cbfb8e1c9287f7a31a40a26b328f192b0a19af","17585255d586e975e48636e38fd39285d3155f1428df03ccce2ef8669977c847","ac558889e1864fd3a456820f5cec8ab94a7a318c75ac910ca99a5107278bd336","b1bd00101d1d048e2e32d819ad3e331d2223c448ccefc8b1294a46a55777218a","ab8eea5149ba362669e272816965ddae7b6d69a93c22be2ae48e53bb4c2757a7","9f20d98664afa02d5e415c4242c5abba44f0138f51c7f6d707ef6f8e4b47a193","112af0935c88a9332c8adf54e3f00aed9b12aeb8eebac366789c146fe3b23f1f","21ff4f88fb04c4fe07589129a98dc8b9da8a4dd69dd8f90bef5bef8d6e8baf77","7ac5e6cb0e6061b963ac8abecbb6e1bb9397e88a56330369abd2c4cedf8c183b","33addf470e4b5e84f346b21e0be1b3ba40841b42fc59ac1910282ab233ba2c2b","b9ea44da8611b474738940785b44b99ae5e96e39a002abdd8c43334aa09cca38","7ff3a9f31cc3f126ce68524281cfcf7d9b6bee488506bd79a45250aacf0a4b45","c781783e6d427d406e540dc3834be9a8d03b48b0797aa9b9573e3c14470a6552","216e3543b1215585ea98a8a8dd944649dcf692f6dfc70c6fd08a6fdce693f689","0b61604e8767c1659f266da318c77b3bd5f2e96e062a6d2ec62e92b2c8b2535e","fd0b4c407dcd53a3aa0cfca8bf370a344e8d031afb53ba0e3909bb5474b1f584","bb6657b20f82c31e5a1d6111d306d08e8a22182aee5439062fb1383537e6bc52","b7bb555901e4d5321aa6a552a57a2980e0843e2240d58d2f5867782a8d0ed798","3b66b04270a95b030b57298dbcf0fd731fbc5e83ce7f77996701df2d11dfcc04","4e0d45c6ec1d67d97e2f9242790f797fd2e53568eb78afc95d5ffb8e2a491b7e"],"paragraph_range_zero_based":[3648,3671],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p3648"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the number of good beams (beams that are above absThreshSS-BlocksConsolidation, if configured by the network) associated to the cells within the R value range (which is configured by network for cell reselection) of the highest ranked cell as part of the beam level measurements. If the UE has no SSB of a neighbour cell whose measurement quantity is above the absThreshSS-BlocksConsolidation or if the network has not configured the absThreshSS-BlocksConsolidation, then the UE does not include numberOfGoodSSB for the corresponding neighbour cell. If the UE has no SSB of the serving cell whose measurement quantity is above the absThreshSS-BlocksConsolidation or if the network has not configured the absThreshSS-BlocksConsolidation, then the UE shall set the numberOfGoodSSB for the serving cell to one.","paragraph_zero_based":3672},{"literal_text_all_w_t_and_m_t":"relativeTimeStamp","paragraph_zero_based":3673},{"literal_text_all_w_t_and_m_t":"Indicates the time of logging measurement results, measured relative to the absoluteTimeStamp. Value in seconds.","paragraph_zero_based":3674},{"literal_text_all_w_t_and_m_t":"reselectedCellId","paragraph_zero_based":3675},{"literal_text_all_w_t_and_m_t":"Indicates the cell that does not support the NSAG ID with highest priority, for the UE that was configured with slice-based cell reselection and was not able to perform a cell reselection to a cell asscoiated with NSAG with the highest priority (as specified in TS 38.304 [20]).","paragraph_zero_based":3676},{"literal_text_all_w_t_and_m_t":"tce-Id","paragraph_zero_based":3677},{"literal_text_all_w_t_and_m_t":"Parameter Trace Collection Entity Id: See TS 32.422 [52].","paragraph_zero_based":3678},{"literal_text_all_w_t_and_m_t":"traceRecordingSessionRef","paragraph_zero_based":3679},{"literal_text_all_w_t_and_m_t":"Parameter Trace Recording Session Reference: See TS 32.422 [52].","paragraph_zero_based":3680},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3681},{"literal_text_all_w_t_and_m_t":"ConnEstFailReport field descriptions","paragraph_zero_based":3682},{"literal_text_all_w_t_and_m_t":"measResultFailedCell","paragraph_zero_based":3683},{"literal_text_all_w_t_and_m_t":"This field refers to the last measurement results taken in the cell, where connection establishment failure or connection resume failure happened.","paragraph_zero_based":3684},{"literal_text_all_w_t_and_m_t":"measResultNeighCells","paragraph_zero_based":3685},{"literal_text_all_w_t_and_m_t":"This field refers to the neighbour cell measurements when connection establishment failure or connection resume failure happened.","paragraph_zero_based":3686},{"literal_text_all_w_t_and_m_t":"numberOfConnFail","paragraph_zero_based":3687},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the latest number of consecutive failed RRCSetup or RRCResume procedures in the same cell independent of RRC state transition.","paragraph_zero_based":3688},{"literal_text_all_w_t_and_m_t":"timeSinceFailure","paragraph_zero_based":3689},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the time that elapsed since the connection (establishment or resume) failure. Value in seconds. The maximum value 172800 means 172800s or longer.","paragraph_zero_based":3690},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3691},{"literal_text_all_w_t_and_m_t":"RA-InformationCommon field descriptions","paragraph_zero_based":3692},{"literal_text_all_w_t_and_m_t":"absoluteFrequencyPointA","paragraph_zero_based":3693},{"literal_text_all_w_t_and_m_t":"This field indicates the absolute frequency position of the reference resource block (Common RB 0).","paragraph_zero_based":3694},{"literal_text_all_w_t_and_m_t":"allPreamblesBlocked","paragraph_zero_based":3695}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["a171b7169dd384cd5cc5d36cbf396bae4c8299edd857317cfbaf7054e75c0424","e17288a2a012a94026189ca13e27df4438afdf6195322a209fb8bf482007cace","ffa30d23d0b1aaab7f6b204adc681dec7c9c12808fedda1654f239350b86a386","c7fcdc3cfcacdbf641c863a42ddd829b55809ed8b5095713cfa1ff1f60cb07c8","388bdceaed45dce0c85f1941d3b0df34c33232daf23a7514e3b85e624b982540","ea769de05a6b56b0d8c94006188ddd5e4387590674896e34fb4a9d1711852560","7a420081052c8f616c33617b2df84495acca5d583b33923f40a305103211e0fb","4717f01737738c41ad2b551ff81e61c57295671c2552e08128a6d225fd23540c","383e8f0b06d1c083e0794fe12f3ac175ee6662cd48d637a6743f5ffdaf4250a2","6894141ab9def1cc06a064b036b2651402fc66569aead4cd94dd8d567045a5d3","e4d496fba177858d824ae0a006bc69f26b06baba6ffcdbcee8a0efe475ce4c8d","62fbdea3f77193fc09694bbec5b7fdbb3ff117db41e7e67568da551450c4262c","2cb88fe38d5db6f2624e4373c4c0a9e2b812363659f5edc5ae0cc844dabd009b","cba737fb2adca4f8402a9b0b70d64afb50c7cecda9cd1089605a2110c51626ec","1fa3c57b74ab6d1d6e742e8ce68d841f2db042d43fc9fdddc38733e3507fa6e7","afd6e955dacea4c8e3ae8d47959909344cf4ef4afeafe3e8296048aee85d45c0","528071ff7d7ef6e9fb50c30b8805e99726f17247a6367dfe86da5257f42c95f4","bb28331c7cf60a822161dda97112b6cebd314b4ce341ed136987727018f437ac","aad1e0fcbec383e9614a29ee7d829635c571d23fb9f719708868dae7688fef73","2d16bdcd86d23cb9bfda28e95012d25a98e493aa08cdd1701d3931c98de2dff3","bf36d8630553f14e36158a6e5f32018e4871b08e45add579e7925652beadfd90","22091938ab85591d67006c6b474b373848c2cb1cdfa96646f72f12ce741f0c63","5ba6fa6b3a4b8d61bd3d808ca7a7a8c0442bb29324a90c83ed3e2e730849d4a0","01ae487a89851939b1ac59739d7fd3b67bf8aefd5b12d4cc29121802530e8e4e"],"paragraph_range_zero_based":[3672,3695],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p3672"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is included when the all the preamble transmission attempts in the corresponding beam (SSB or CSI-RS) are blocked by failed LBT.","paragraph_zero_based":3696},{"literal_text_all_w_t_and_m_t":"attemptedBWP-InfoList","paragraph_zero_based":3697},{"literal_text_all_w_t_and_m_t":"This field indicates locationAndBandwidth and subcarrierSpacing of all the bandwidth parts in which the consistent LBT failures are triggered at the moment of successful RA completion.","paragraph_zero_based":3698},{"literal_text_all_w_t_and_m_t":"locationAndBandwidth","paragraph_zero_based":3699},{"literal_text_all_w_t_and_m_t":"Frequency domain location and bandwidth of the bandwidth part associated to the random-access resources used by the UE or of the bandwidth part in which the consistent LBT failures is triggered and not cancelled prior to successful completion of random access procedure (if this field is included in attemptedBWP-InfoList) or prior to RLF/HOF (if this field is included in attemptedBWP-InfoList or bwp-Info).","paragraph_zero_based":3700},{"literal_text_all_w_t_and_m_t":"numberOfLBT-Failures","paragraph_zero_based":3701},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the total number of preamble transmission attempts for which LBT failure indication is received in the RA procedure. If the number of LBT failure indications received from lower layers during the RA procedure exceeds or equals to 128, UE sets the field to 128.This field is optional present when there is at least one preamble transmission attempt for which LBT failure indication is received during the RA procedure, otherwise it is absent.","paragraph_zero_based":3702},{"literal_text_all_w_t_and_m_t":"numberOfPreamblesPerSSB-ForThisPartition","paragraph_zero_based":3703},{"literal_text_all_w_t_and_m_t":"This field determines how many consecutive preambles are associated to the used feature or combination of features starting from the starting preamble(s) per SSB.","paragraph_zero_based":3704},{"literal_text_all_w_t_and_m_t":"perRAInfoList, perRAInfoList-v1660","paragraph_zero_based":3705},{"literal_text_all_w_t_and_m_t":"This field provides detailed information about each of the random access attempts in the chronological order of the random access attempts. If perRAInfoList-v1660 is present, it shall contain the same number of entries, listed in the same order as in perRAInfoList-r16.","paragraph_zero_based":3706},{"literal_text_all_w_t_and_m_t":"startPreambleForThisPartition","paragraph_zero_based":3707},{"literal_text_all_w_t_and_m_t":"This field indicates the first preamble associated with the used feature or combination of features.","paragraph_zero_based":3708},{"literal_text_all_w_t_and_m_t":"subcarrierSpacing","paragraph_zero_based":3709},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing used in the bandwidth part associated to the random-access resources used by the UE or of the bandwidth part in which the consistent LBT failures is triggered and not cancelled prior to successful completion of random access procedure (if this field is included in attemptedBWP-InfoList) or prior to RLF/HOF (if this field is included in attemptedBWP-InfoList or bwp-Info).","paragraph_zero_based":3710},{"literal_text_all_w_t_and_m_t":"triggeredFeatureCombination","paragraph_zero_based":3711},{"literal_text_all_w_t_and_m_t":"One or more features (e.g., RedCap, Slicing, SDT and MSG3 repetition) that triggers the random-access procedure. When triggered feature is Slicing, UE includes all the S-NSSAIs associated to the slices triggering the access attempt in the random-access procedure.","paragraph_zero_based":3712},{"literal_text_all_w_t_and_m_t":"usedFeatureCombination","paragraph_zero_based":3713},{"literal_text_all_w_t_and_m_t":"The feature or combination of features (e.g., redCap, smallData, nsag and msg3-Repetitions) associated to the used random-access resources as specified in TS 38.321[3].","paragraph_zero_based":3714},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3715},{"literal_text_all_w_t_and_m_t":"RA-Report field descriptions","paragraph_zero_based":3716},{"literal_text_all_w_t_and_m_t":"cellID","paragraph_zero_based":3717},{"literal_text_all_w_t_and_m_t":"This field indicates the CGI of the cell in which the associated random access procedure was performed.","paragraph_zero_based":3718},{"literal_text_all_w_t_and_m_t":"contentionDetected","paragraph_zero_based":3719}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["9dcce69f0a08e7eea1996944c0f318c04836db1f305e649ffcf4c6ccdfb8987a","db603fe14103a2eefda8de55d9e5003e753a0bf9f05243143a4d1942659d220b","daa7d0997eb5fa2cd6597ab65b8da095d7566f700e6da6a99fbb5de0e906b82a","2ca3ab550b98ea57aeb019864ece357fbdf253bd8201f14d16639556960b8923","bb63d69cf4bb340f7fb489d0be029a28d622a72c2755b073ab7ee6d2b238d394","e713ebcb79ed69c1a6503d9972def96e4a65445498f3f9bac23496a35f05f8ae","6ebc7f2714e970ddccb0988d9809029cbf5436f1f43d67324908d8d161288d9d","39c14ce51dce526e9d140fe4a71d01a7f2219d88e7c67d04886245a5e9169aba","db0b395f684083009cd7d0b4f98a6af39713b9342b9ce1a4cc060a44de07fbd5","78aad54388ff40177933dfbb7004cac9ec917d9989b573298ac00017dc9cf301","dc647f412710b452bd8e8ae0ba52a4df287bb14e141d176d16ccaac50788668b","fcbcf5d9e7e251ddb7360743c3910e714297b0093e44c50e6dd0fd75c78dab4e","b30923710a50909985396229b95eb03e2a0d11ba7931e847d62931a602641357","f7e112dc48dfae8992de804b2d2364ad3566d7eda5583621648ff9d7e565550e","cba581c6a39e1bd362c7721fcce26d86215590a317aac4d5bbf1d68c5926bdb5","c24053daaea618ddca4f946f2651fb36e608b85076297b74f7b118dcbe4f4701","3f5eadef334ef1b029b3d21499af438ae87b18d3b65fb46972e7452734f89f8c","c8f9a21627e6a59acc37aa8058b01b16a6e512f9f58eb7c5d3d115be849f31cb","20647dece467089357b799efa0d4a6b7c840d881f3023d9cf510f3dbb89ad426","c1e8f69e8f06e4dcca159287ddf68dc7cdaa9f63f9b193a6a5336f688f80d5cd","c84443505009b7f5fc05017edd3b575e0e51b19a59b79879df0008b9a98d2d05","16342624b44ebf251698c22497af548ad5e5da9348b5f3b0e88004cacadf79bf","fd42c683a1874d52497d5d1b0f4846c659c7d5ebe07e723473d77235a32f9b1a","1da82f7181c79e8fa731f72880568d30d5470318afb728d11d555310929e7c32"],"paragraph_range_zero_based":[3696,3719],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p3696"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is used to indicate that contention was detected for the transmitted preamble in the given random access attempt or not. This field is not included when the UE performs random access attempt is using contention free random-access resources or when the raPurpose is set to requestForOtherSI or when the RA attempt is a 2-step RA attempt and fallback to 4-step RA did not occur (i.e. fallbackToFourStepRA is not included).","paragraph_zero_based":3720},{"literal_text_all_w_t_and_m_t":"csi-RS-Index, csi-RS-Index-v1660","paragraph_zero_based":3721},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the CSI-RS index corresponding to the random access attempt.","paragraph_zero_based":3722},{"literal_text_all_w_t_and_m_t":"If the random access procedure is for beam failure recovery, the field indicates the NZP-CSI-RS-ResourceId. For CSI-RS index larger than maxNrofCSI-RS-ResourcesRRM-1, the index value is the sum of csi-RS-Index (without suffix) and csi-RS-Index-v1660.","paragraph_zero_based":3723},{"literal_text_all_w_t_and_m_t":"dlPathlossRSRP","paragraph_zero_based":3724},{"literal_text_all_w_t_and_m_t":"Measeured RSRP of the DL pathloss reference obtained at the time of RA_Type selection stage of the RA procedure as captured in TS 38.321 [3].","paragraph_zero_based":3725},{"literal_text_all_w_t_and_m_t":"dlRSRPAboveThreshold","paragraph_zero_based":3726},{"literal_text_all_w_t_and_m_t":"In 4 step random access procedure, this field is used to indicate whether the DL beam (SSB) quality associated to the random access attempt was above or below the threshold rsrp-ThresholdSSB in beamFailureRecoveryConfig in UL BWP configuration of UL BWP selected for random access procedure initiated for beam failure recovery. Otherwise, if the UE has received rsrp-ThresholdSSB-r17 in FeatureCombinationPreambles used for the feature specific random access, the field is used to indicate whether DL beam (SSB) quality associated to the random access attempt was above or below this rsrp-ThresholdSSB-r17; else, if rsrp-ThresholdSSB-r17 is not included in FeatureCombinationPreambles used for the feature specific random access, this field is used to indicate whether DL beam (SSB) quality associated to the random access attempt was above or below rsrp-ThresholdSSB included in the RACH-ConfigCommon which includes this FeatureCombinationPreambles; else, this field is used to indicate whether DL beam (SSB) quality associated to the random access attempt was above or below rsrp-ThresholdSSB in rach-ConfigCommon in UL BWP configuration of UL BWP selected for random access procedure.","paragraph_zero_based":3727},{"literal_text_all_w_t_and_m_t":"In 2 step random access procedure, if the UE has received rsrp-ThresholdSSB-r17 in FeatureCombinationPreambles used for the feature specific random access, the field is used to indicate whether DL beam (SSB) quality associated to the random access attempt was above or below this rsrp-ThresholdSSB-r17; else, if rsrp-ThresholdSSB-r17 is not included in FeatureCombinationPreambles used for the feature specific random access, this field is used to indicate whether the DL beam (SSB) quality associated to the random access attempt was above or below the threshold msgA-RSRP-ThresholdSSB included in the RACH-ConfigCommonTwoStepRA which includes this FeatureCombinationPreambles; else, this field is used to indicate whether the DL beam (SSB) quality associated to the random access attempt was above or below the threshold msgA-RSRP-ThresholdSSB in rach-ConfigCommonTwoStepRA in UL BWP configuration of UL BWP selected for random access procedure.","paragraph_zero_based":3728},{"literal_text_all_w_t_and_m_t":"fallbackToFourStepRA","paragraph_zero_based":3729},{"literal_text_all_w_t_and_m_t":"This field indicates if a fallback indication in MsgB is received (according to TS 38.321 [3]) for the 2-step random access attempt.","paragraph_zero_based":3730},{"literal_text_all_w_t_and_m_t":"intendedSIBs","paragraph_zero_based":3731},{"literal_text_all_w_t_and_m_t":"This field indicates the SIB(s) the UE wanted to receive as a result of the on demand SI request (when the RA procedure is a used as a SI request) initiated by the UE. That is, it indicates the one(s) of the SIB(s) in the SI message(s) requested to be broadcast that the UE was interested in. Value posSIB indicates that the UE wanted to receive one or more positioning SIB(s).","paragraph_zero_based":3732},{"literal_text_all_w_t_and_m_t":"lbt-Detected","paragraph_zero_based":3733},{"literal_text_all_w_t_and_m_t":"This field is included when there is at least one LBT failure indication received prior to change of beam for preamble transmission during RA procedure, otherwise this field is absent.","paragraph_zero_based":3734},{"literal_text_all_w_t_and_m_t":"msg1-SCS-From-prach-ConfigurationIndex","paragraph_zero_based":3735},{"literal_text_all_w_t_and_m_t":"This field is set by the UE with the corresponding SCS for CBRA as derived from the prach-ConfigurationIndex in RACH-ConfigGeneric when the msg1-SubcarrierSpacing is absent; otherwise, this field is absent.","paragraph_zero_based":3736},{"literal_text_all_w_t_and_m_t":"msg1-SCS-From-prach-ConfigurationIndexCFRA","paragraph_zero_based":3737},{"literal_text_all_w_t_and_m_t":"This field is set by the UE with the corresponding SCS for CFRA as derived from the prach-ConfigurationIndex in RACH-ConfigGeneric when the msg1-SubcarrierSpacing is absent; otherwise, this field is absent.","paragraph_zero_based":3738},{"literal_text_all_w_t_and_m_t":"msgA-PUSCH-PayloadSize","paragraph_zero_based":3739},{"literal_text_all_w_t_and_m_t":"This field indicates the size of the overall payload available in the UE buffer at the time of initiating the 2 step RA procedure. The value refers to the index of TS 38.321 [3], table 6.1.3.1-1, corresponding to the UE buffer size.","paragraph_zero_based":3740},{"literal_text_all_w_t_and_m_t":"msgA-RO-FDM","paragraph_zero_based":3741},{"literal_text_all_w_t_and_m_t":"This field indicates the number of msgA PRACH transmission occasions Frequency-Division Multiplexed in one time instance for the PRACH resources configured for 2-step CBRA..","paragraph_zero_based":3742},{"literal_text_all_w_t_and_m_t":"msgA-RO-FDMCFRA","paragraph_zero_based":3743}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["94322bfd91b0f166b46f12abff1fc2471b0b075c2c3fa6f601bd897d18ba2563","d700d288ccb064f015a80875b2d38abdfe18edc4eca1dedc3559cd5c281b8641","474f979c0d40e0e9976e6afd900d6ffe8cc370c209324a47331b36d9bafdec2b","f2498d877a233f08190b928d0dfc35d841acdc6d63a8bfe6c5b313ebcc16338a","c40b18f50fafc798e05c3cb2ac930d17a72467baffb5e494b4d0325d9dfd487f","9d1d11a3ca6554f7b5e0693a92aa852c9de5a8569e50cc824041ae7cc00ca37a","fc54b8beb01fa2f12152732f5a148c140b69fdb2feecc1feec4b21596a3a6ea5","c3c2d9473d229d81c8fba60770a62cbde2e640d44eaeca108c0252ba441c7d14","7787a2b53e38649dcad1e5a7aee4b8fefef941e96e83fd1e7895b78ee03c59af","e6633a3422caba32762ea966050e77e517402879102d229bd063978ab5544422","185d23802585de87a7b71e5f361da8262b49672b70682f27d8166dd3a68cab46","9f0c68f3a8db5828c06fa3c3dce8b6eef0a0cbf5445238a6bb5c404659418f09","d6b45e641eb327b96413383dfc07e7daf08a16cd418d55b0b27eff026059ba17","4a947d96ae67a8171f1d9a464c4853ee26c0de1a1413711caa7bf7bec0524eba","f1827ebc4ec5b389ac34250d6ac32b882052660777e3f743c0669b2537db0b58","cf8f9b869ceae6c07f822a0e8afc4fe37d532e7b39af2e8d9dbc0d099b6b0836","9dd24d79f857a4c27b03b6b17070e1d697a16cffeef7e64d1942e436af6bf0f6","b0408b90d5e93674140395be340667200e71ef9d08cc8382da0647467da843c5","3d0e1eae4d82b2528e923a018acdacfe8dc277cb34bcb1847d7f4b3b22a0942e","3bbe0a63188e89da041de2290dd2aafb25c5ccb3d59be154928944a2ef8f5d47","9fdebb2b69e691e2329e88ed5f8ad6454e328eb0d16792762a62bfa2d0baf502","b92ad5341397e1b9415780764a43c94e8d45dfba3089359676b2a48faf073442","5633b6f2cec7741dcf7a7048f4501b2a73456c02465974c526611e04fb2edd3b","2f8de1748ab4ae03ea5961d5001da923bd8e797f4b32c040c5bcb1e0f6547065"],"paragraph_range_zero_based":[3720,3743],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p3720"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field indicates the number of msgA PRACH transmission occasions Frequency-Division Multiplexed in one time instance for the PRACH resources configured for 2-step CFRA.","paragraph_zero_based":3744},{"literal_text_all_w_t_and_m_t":"msgA-RO-FrequencyStart","paragraph_zero_based":3745},{"literal_text_all_w_t_and_m_t":"This field indicates the lowest resource block of the contention based random-access resources for 2-step CBRA in the random-access procedure. The indication has the form of the offset of the lowest PRACH transmissions occasion with respect to PRB 0 in the frequency domain.","paragraph_zero_based":3746},{"literal_text_all_w_t_and_m_t":"msgA-RO-FrequencyStartCFRA","paragraph_zero_based":3747},{"literal_text_all_w_t_and_m_t":"This field indicates the lowest resource block of the contention free random-access resources for the 2-step CFRA in the random-access procedure. The indication has the form of the offset of the lowest PRACH transmissions occasion with respect to PRB 0 in the frequency domain.","paragraph_zero_based":3748},{"literal_text_all_w_t_and_m_t":"msgA-SCS-From-prach-ConfigurationIndex","paragraph_zero_based":3749},{"literal_text_all_w_t_and_m_t":"This field is set by the UE with the corresponding SCS as derived from the msgA-PRACH-ConfigurationIndex in RACH-ConfigGenericTwoStepRA (see tables Table 6.3.3.1-1, Table 6.3.3.1-2, Table 6.3.3.2-2 and Table 6.3.3.2-3, TS 38.211 [16]) when the msgA-SubcarrierSpacing is absent and when only 2-step random-access resources are available in the UL BWP used in the random-access procedure; otherwise, this field is absent.","paragraph_zero_based":3750},{"literal_text_all_w_t_and_m_t":"numberOfPreamblesSentOnCSI-RS","paragraph_zero_based":3751},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the total number of successive RA preambles that were transmitted on the corresponding CSI-RS.","paragraph_zero_based":3752},{"literal_text_all_w_t_and_m_t":"numberOfPreamblesSentOnSSB","paragraph_zero_based":3753},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the total number of successive RA preambles that were transmitted on the corresponding SS/PBCH block.","paragraph_zero_based":3754},{"literal_text_all_w_t_and_m_t":"onDemandSISuccess","paragraph_zero_based":3755},{"literal_text_all_w_t_and_m_t":"This field is set to true when the RA report entry is included because of either msg1 based on demand SI request or msg3 based on demand SI request and if the on-demand SI request is successful. Otherwise, the field is absent.","paragraph_zero_based":3756},{"literal_text_all_w_t_and_m_t":"perRAAttemptInfoList","paragraph_zero_based":3757},{"literal_text_all_w_t_and_m_t":"This field provides detailed information about a random access attempt.","paragraph_zero_based":3758},{"literal_text_all_w_t_and_m_t":"perRACSI-RSInfoList","paragraph_zero_based":3759},{"literal_text_all_w_t_and_m_t":"This field provides detailed information about the successive random access attempts associated to the same CSI-RS.","paragraph_zero_based":3760},{"literal_text_all_w_t_and_m_t":"perRASSBInfoList","paragraph_zero_based":3761},{"literal_text_all_w_t_and_m_t":"This field provides detailed information about the successive random access attempts associated to the same SS/PBCH block.","paragraph_zero_based":3762},{"literal_text_all_w_t_and_m_t":"ra-InformationCommon","paragraph_zero_based":3763},{"literal_text_all_w_t_and_m_t":"This field is used to provide information on random access attempts. This field is mandatory present.","paragraph_zero_based":3764},{"literal_text_all_w_t_and_m_t":"raPurpose","paragraph_zero_based":3765},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the RA scenario for which the RA report entry is triggered. The RA accesses associated to Initial access from RRC_IDLE, RRC re-establishment procedure, transition from RRC-INACTIVE. The indicator beamFailureRecovery is used in case of successful beam failure recovery related RA procedure in the SpCell [3]. The indicator reconfigurationWithSync is used if the UE executes a reconfiguration with sync. The indicator ltm is used if the UE executes a RACH-based LTM cell switch. The indicator ulUnSynchronized is used if the random access procedure is initiated in a SpCell by DL or UL data arrival during RRC_CONNECTED when the timeAlignmentTimer is not running in the PTAG or if the RA procedure is initiated in a serving cell by a PDCCH order [3]. The indicator schedulingRequestFailure is used in case of SR failures [3]. The indicator noPUCCHResourceAvailable is used when the UE has no valid SR PUCCH resources configured [3]. The indicator requestForOtherSI is used for MSG1 based on demand SI request. The indicator msg3RequestForOtherSI is used in case of MSG3 based SI request. The indication lbtFailure is used when the UE initiates RACH in SpCell due to consistent uplink LBT failures [3]. The field can also be used for the SCG-related RA-Report when the raPurpose is set to beamFailureRecovery, reconfigurationWithSync, ulUnSynchronized, schedulingRequestFailure, noPUCCHResourceAvailable and lbtFailure.","paragraph_zero_based":3766},{"literal_text_all_w_t_and_m_t":"sdt-DL-Rsrp-Info","paragraph_zero_based":3767}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["1ca78f5261f5cd4463e9444c478b5312fa14760383729f96123b1fc4c2c4ea0b","921d902619eb4d5c53937775169a3923295d3ec5d08058e6075efe2d5322ac71","34c5fa6c96a118786a674a4470e8fff54df413b44cea401c0a4c97d87e202f47","ff0359897c6dbdc029664c0f5b839a13e86245c18c3022c82ad84d4d3587f844","263f0f383ec73ca1d1d07eeaf0610017767391431c0ce20d0b64209a91a65daa","7c88cefdf2bccaa95a1704f0863c5f6862b39b7c5109f161092c95de951e6fd0","d60309fb10c5e543cb188c8458ec5d342ac4106fba5ab4461b444d909f37e85d","254c192d9cf31469a38da659601de389116f2f2f4c39d88235b1a542da53ce21","836089698a682e2ca7d7b0d4dc77c291c38ed30bbcdd82df39af772d54fdff49","024e70ec8cca6859d2fd04edb6e25d6b02e5ca310fcdb1cfd72211d3e774aee0","df38f25292e6534f5f194ca8c87287342323c8eaf4d916cb4db2e4ce868a03d6","ed3c4cec7c99b20c826b4ec19a50b27a59a4bc437e4fad739d4c8c601de0e587","8a65fd6ab9a1b40609f0f230ba1b70942f61e6817c33b51320f27f9494d8edcc","d6d32768a50c820460ebbf7c3eca124367ad6f083a9ee367679afd930dfc0d56","14ace56ac651f8ca4a79babbff6711ae3d40f27ed6164ebd2def267c01533ce3","cafee4f8cce23471cc5ebb4283eef5891aa1bb0c75b5bf2ca6fe0531080cfe04","7bdb7892521068165f2b51247132f8ddc6f01e718fbd43c592bee9e720bd157f","c0865ef509a91d6f7b68ceac07bc0bbda596133ac5c195c178fd6b5434faba24","a343b4955cee34d1640bf26add0c05cbe2f5a8230cebbd8e6ba31df3610a3cb3","3552152618892531279bb99e0349726aa800c2b68e41b6ded31baa5076c69e06","04569bb8ce6f92cbd93e10cd5bbf9e17e01a2e9eac64508d9fd912aa2388667e","5d90d34eaa06b532703f4d4bc66da96638c145d6fc15831014be97ca44014600","0b5abd565152033cfcd4fa5a4ef4a5e9bb0b6200350e89d40496c63bc611430e","e6bfa7eb54f7b14e3e82d417a45c43425c10de1e392cd12948619c58a3abf937"],"paragraph_range_zero_based":[3744,3767],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p3744"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field logs the RSRP value measured by UE during evaluation of SDT procedure. This field is included when the RA report entry is included because of SDT initiation failure. Otherwise, the field is absent.","paragraph_zero_based":3768},{"literal_text_all_w_t_and_m_t":"sdt-Failed","paragraph_zero_based":3769},{"literal_text_all_w_t_and_m_t":"This field is included when the RA report entry is included because of SDT and if the SDT transmission failed. Otherwise, the field is absent.","paragraph_zero_based":3770},{"literal_text_all_w_t_and_m_t":"sdt-FailureCause","paragraph_zero_based":3771},{"literal_text_all_w_t_and_m_t":"This field is included when the RA report entry is included because of SDT and if the SDT procedure failed. Otherwise, the field is absent. This field indicates the SDT failure cause.","paragraph_zero_based":3772},{"literal_text_all_w_t_and_m_t":"The field is set to t319a-expiry upon expiration of T319a timer. If the UE upper layers receive maxRetxThreshold reached indication from RLC while SDT procedure is ongoing, this field is set to maxRetxThreshold. It is set to preambleTransMax upon the UE upper layer receiving indication of reaching preambleTransMax from the MAC layer. Upon expiration of cg-SDT-TimeAlignmentTimer from the MAC, the field is set to cg-SDT-TimeAlignmentTimer. The field is set to configuredGrantTimer upon reception of indication that configuration grant timer has been expired from the MAC. The field is set to cellReselection upon SDT failure due to UE’s cell re-selection.","paragraph_zero_based":3773},{"literal_text_all_w_t_and_m_t":"sdt-UL-DataVolume","paragraph_zero_based":3774},{"literal_text_all_w_t_and_m_t":"The field is set to t319a-expiry upon expiration of T319a timer. If the UE upper layers receive maxRetxThreshold reached indication from RLC while SDT procedure is ongoing, this field is set to maxRetxThreshold. It is set to preambleTransMax upon the UE upper layer receiving indication of reaching preambleTransMax from the MAC layer. Upon expiration of cg-SDT-TimeAlignmentTimer from the MAC, the field is set to cg-SDT-TimeAlignmentTimer. The field is set to configuredGrantTimer upon reception of indication that configuration grant timer has been expired from the MAC. The field is set to cellReselection upon SDT failure due to UE’s cell re-selection.","paragraph_zero_based":3775},{"literal_text_all_w_t_and_m_t":"spCellID","paragraph_zero_based":3776},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the CGI of the SpCell of the cell group associated to the SCell in which the associated random access procedure was performed. If the UE performs RA procedure on a SCell associated to the MCG, then this field is set to the CGI of the PCell and if the UE performs RA procedure on a SCell associated to the SCG, then this field is set to the CGI of the PSCell. If the CGI of the PSCell is not available at the UE for the RA procedure performed on a SCell associated to the SCG or for the RA procedure on the PSCell, this field is set to the CGI of the PCell. Otherwise, the field is absent.","paragraph_zero_based":3777},{"literal_text_all_w_t_and_m_t":"ssb-Index","paragraph_zero_based":3778},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the SS/PBCH index of the SS/PBCH block corresponding to the random access attempt.","paragraph_zero_based":3779},{"literal_text_all_w_t_and_m_t":"ssbsForSI-Acquisition","paragraph_zero_based":3780},{"literal_text_all_w_t_and_m_t":"This field indicates the SSB(s) (in the form of SSB index(es)) that the UE used to receive the requested SI message(s). The field is present if the purpose of the random access procedure was to request on-demand SI (i.e. if the raPurpose is set to requestForOtherSI or msg3RequestForOtherSI). Otherwise, the field is absent.","paragraph_zero_based":3781},{"literal_text_all_w_t_and_m_t":"timeSinceSdt-Execution","paragraph_zero_based":3782},{"literal_text_all_w_t_and_m_t":"This field logs the elapsed time since the execution of RA-SDT. Value in seconds. The maximum value is 172800 seconds.","paragraph_zero_based":3783},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3784},{"literal_text_all_w_t_and_m_t":"RLF-Report field descriptions","paragraph_zero_based":3785},{"literal_text_all_w_t_and_m_t":"bwp-Info","paragraph_zero_based":3786},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the BWP information in which the UE detected consistent uplink LBT failure. This field is set only when the detected consistent uplink LBT failure did not trigger the random access procedure.","paragraph_zero_based":3787},{"literal_text_all_w_t_and_m_t":"choCandidateCellList","paragraph_zero_based":3788},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the list of candidate target cells for conditional handover included in condRRCReconfig at the time of connection failure. The field does not include the candidate target cells included in measResultNeighCells.","paragraph_zero_based":3789},{"literal_text_all_w_t_and_m_t":"choCellId","paragraph_zero_based":3790},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the candidate target cell for conditional handover included in condRRCReconfig that the UE selected for CHO based recovery while T311 is running.","paragraph_zero_based":3791}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["af5107ed82482fc2c0685128daf326c495fc0108a7a811fa38b8c24a300d40d4","dfb2f0b04139d250b3145c5923fefdc2fb80c56772f5cf26ca84a5ac03b293c9","a3336e0a628d91d344ea726bf8998eb293d264b9a52e4021283d7bae351edd2b","19b0f64f2c49e051acdd2726d3cb7904da598d382cfad961c5e0a74b1d525bdd","64136dfefa1304b3b933f7db1fbddf27e8db0b92c1d9060d75b1dda6fae7ccc7","03dd5f3e4d1801198629d6b45471aa1da3f0046e1ff26f29b9cabbad96c80cae","fa479e473b79d533f4a02e25718d7423c385e5a398c739ba866ae3e7aec4c3db","a646ddead322f195ecc3d5e688ae5e2cef1ef4143f7272f60b218c05dfe7a3d6","f95696a3f439209dc4e77777a71ae92559a4745298e3b983b170be0558714eec","48b37cfa5ac818681f8a48e2472b1ac546cf978ab87815dafc817e3689ddb63f","7daa1ccb20b8093b0a127b626f61a5a29ab50201f9f49be58e4e406b24b7c1b7","8b8f487fafcf763ecbbdf70317c1f1b1d8593e3256e6d7dca657336e928fb7a7","cba799b2e4b2a6c21af4f22f1721f8e62476717af3159a0835aa6c853a1da6c1","8e71401b3fb3a7e48a360db91fc32e7101445aeb5e9a68f8da4d306d1037c385","8ae7780553342f04b377da536216c76c66704335b2a270b89055f98ce2beffc8","1022c6790d5ad8877b48a9f41eb79970f46235f015f600300c3cc15fb62675a8","9774eadb35aebe2aecf30c54b5ed7573828576dc0a3c11ca16992671e6cb391b","8990befbb565b33e49f3ba1bdc41bdf718a65165ba5cb9435e7788df3df2122c","5d9e1a22da9e486fe8297967fc12cc7948cd981d776edc415a3675e185cced7b","034597f955233202422d970aff6f9919027643f3d181507f484a01a1f1ce1101","f5f8c3a81b79d7e032c0df81696758e696a272f65d2ea6f32595d355783a0c17","bf69dcde225acc652713a1f002acff759355199770f9776de2b94babf9bd849b","e0c2690e6dd0a886df2eddd3e7bdc84b061bb17e8563ac9f89090eeabcb4297e","ec8205a3c5e70d4773091f5ae7dc7d28070ed90f45181039087b51023fa33546"],"paragraph_range_zero_based":[3768,3791],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p3768"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"connectionFailureType","paragraph_zero_based":3792},{"literal_text_all_w_t_and_m_t":"This field is used to indicate whether the connection failure is due to radio link failure or handover failure.","paragraph_zero_based":3793},{"literal_text_all_w_t_and_m_t":"csi-rsRLMConfigBitmap,csi-rsRLMConfigBitmap-v1650","paragraph_zero_based":3794},{"literal_text_all_w_t_and_m_t":"These fields are used to indicate the CSI-RS indexes configured in the RLM configurations for the active BWP when the UE declares RLF or HOF. The UE first fills in the csi-rsRLMConfigBitmap-r16 to indicate the first 96 CSI-RS indexes and then csi-rsRLMConfigBitmap-v1650 to indicate the latter 96 CSI-RS indexes. The first/leftmost bit in csi-rsRLMConfigBitmap-r16 corresponds to CSI-RS index 0, the second bit corresponds to CSI-RS index 1. The first/leftmost bit in csi-rsRLMConfigBitmap-v1650 corresponds to CSI-RS index 96, the second bit corresponds to CSI-RS index 97. These fields are included only if the RadioLinkMonitoringConfig for the respective BWP is configured.","paragraph_zero_based":3795},{"literal_text_all_w_t_and_m_t":"c-RNTI","paragraph_zero_based":3796},{"literal_text_all_w_t_and_m_t":"This field indicates the C-RNTI used in the PCell upon detecting radio link failure or the C-RNTI used in the source PCell upon handover failure.","paragraph_zero_based":3797},{"literal_text_all_w_t_and_m_t":"distanceFromReference1","paragraph_zero_based":3798},{"literal_text_all_w_t_and_m_t":"This field indicates the measured distance between UE and the moving reference locations of the serving cell if the conditional handover is based on condEventD2. Each step represents 50m. The actual distance shall be rounded down to the nearest step value (i.e., FLOOR(actual distance[m] / 50)). The maximum value is 65535, which indicates a distance equal to or greater than 65535 multiplied by 50m.","paragraph_zero_based":3799},{"literal_text_all_w_t_and_m_t":"elapsedTimeSCG-Failure","paragraph_zero_based":3800},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the time elapsed between the SCG failure and the MCG failure. The maximum value 1023 means 1023ms or longer.","paragraph_zero_based":3801},{"literal_text_all_w_t_and_m_t":"elapsedTimeT316","paragraph_zero_based":3802},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the value of the elapsed time of the timer T316. Value in milliseconds.","paragraph_zero_based":3803},{"literal_text_all_w_t_and_m_t":"failedPCellId","paragraph_zero_based":3804},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the PCell in which RLF is detected or the target PCell of the failed handover. For intra-NR handover nrFailedPCellId is included and for the handover from NR to EUTRA eutraFailedPCellId is included. The UE sets the ARFCN according to the frequency band used for transmission/ reception when the failure occurred.","paragraph_zero_based":3805},{"literal_text_all_w_t_and_m_t":"failedPCellId-EUTRA","paragraph_zero_based":3806},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the PCell in which RLF is detected or the source PCell of the failed handover in an E-UTRA RLF report.","paragraph_zero_based":3807},{"literal_text_all_w_t_and_m_t":"lastHO-Type","paragraph_zero_based":3808},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the type of the last executed handover or LTM cell switch before the last detected connection failure. The field is set to cho if the last executed handover was initiated by a conditional reconfiguration execution. The field is set to daps if the last executed handover was a DAPS handover. The field is set to ltm if the last executed RRCReconfiguration message including reconfigurationWithSync was an LTM cell switch.This field is set to choWithCandidateSCG if the last executed RRCReconfiguraiton associated to both condExecutionCond and condExecutionCondPSCell.","paragraph_zero_based":3809},{"literal_text_all_w_t_and_m_t":"tm-RecoveryCellId","paragraph_zero_based":3810},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the candidate target cell for LTM cell switch included in ltm-Config associated with the MCG that the UE selected for LTM based recovery while T311 was running.","paragraph_zero_based":3811},{"literal_text_all_w_t_and_m_t":"mcg-RecoveryFailureCause","paragraph_zero_based":3812},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the cause of the fast MCG recovery failure.","paragraph_zero_based":3813},{"literal_text_all_w_t_and_m_t":"measResultL1-LastServCell","paragraph_zero_based":3814},{"literal_text_all_w_t_and_m_t":"This field contains the last L1 measurement results collected in the PCell upon detecting radio link failure or the source PCell upon reconfiguration with sync failure if the UE was configured with ltm-Config associated with the MCG when connected to the source PCell (in case HO failure) or PCell (in case RLF).","paragraph_zero_based":3815}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["90659a771afcb93aa1bd3c08d3380c4e6ab2cedf5a9a81e1813af88eb9d42f66","6d47a41798bff91c90dcbf20dd473dd3136adec19e8290e8c7a44ca728d20b79","26c5478a29ab090c713b973009e49e01d89b0a59da33857718ba392ac0ead7d0","80987bdc4889a86f928ad218ee6be61a1d6b9b516b2405406151cf8dd790f640","92a46f554aded2bc105cd94cdda115f8b09e0a2d5252a201093b617b76fe0c2c","85666a3cdf4f4a2afa0dbfce29fa6a205fe6507fd5ffc94b4cad562559520b59","279842efcc96109a84eb4fcc8bd9eff02f41258f3f7346226d0faedd54af9941","9a1f110a3eca118b26963bfd0f75710d75bfa19b1bfbe307002c634253e5a25c","e04a7e0f281cf9d1204e02cfe29c0cf5d2b6eff6d0576c7956f3252ca3158aee","f010f2bf42b3d8781bf091af411bb74864f9d632d18472c0aeec2c28f2e9f300","6dc654d35df6f8e4892e4feb49a4d1f5efc13d59bea8474c508a2c81c628697c","88e36b74fc52b5efe0bed00e41981de3a9bbc846111d8c9dee9b0e01fb6f2d19","8b28094f7fa3c3f6007b35ef8ea9187dce1d56ef49f5111856f928773c0abd37","5b712ebefd1ca520a9796a126622a956096d58709d62d818413034ed06d0150e","2a4f13dd5788c8ceaa62b73bc282b31bd62cfaa8a316a95240dd700374404883","380d158ec5098f21802655c628e0707189d23d5a2f4663207c07bc8d885196a1","090ec93e88180af798b4a54326164fcb2342877dfe93480ea94d7d9ffaa58db7","67edcb89a5260160de7b92ce0248f88af7af7e5faffbf226b2f4bae29ef0edfd","62daeb93d55c2e6114eb660c8018ab489626e6d5dd89da53d966f7ad9c73816e","f9908798eaa13b53e3c0dc7112dc55e2b232fae5c84dc4bde549af357930c256","6782b0837107a4beb5404b5ca20fe1aaeff40112e9f505e80bf529f11753c336","004b8092e6008780e7525a1cbfdcab8f2d4bc21f6f9423244130776e1fed9abf","595f61d2db2f3c8199a5126420e9f1c000edbe96b66cc0cd43e9af5e68c9ba04","1f5779e1785e82882ce0273e61eb59186e70c1a948e733cb7864283777b1b15c"],"paragraph_range_zero_based":[3792,3815],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p3792"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"measResultL1-NeighCells","paragraph_zero_based":3816},{"literal_text_all_w_t_and_m_t":"This field contains the last L1 measurement results collected in neighbour MCG LTM candidate cells upon reconfiguration with sync failure or upon detecting radio link failure.","paragraph_zero_based":3817},{"literal_text_all_w_t_and_m_t":"measResultListEUTRA","paragraph_zero_based":3818},{"literal_text_all_w_t_and_m_t":"This field refers to the last measurement results taken in the neighboring EUTRA Cells, when the radio link failure or handover failure happened.","paragraph_zero_based":3819},{"literal_text_all_w_t_and_m_t":"measResultListNR","paragraph_zero_based":3820},{"literal_text_all_w_t_and_m_t":"This field refers to the last measurement results taken in the neighboring NR Cells, when the radio link failure or handover failure happened.","paragraph_zero_based":3821},{"literal_text_all_w_t_and_m_t":"measResultLastServCell","paragraph_zero_based":3822},{"literal_text_all_w_t_and_m_t":"This field refers to the log measurement results taken in the PCell upon detecting radio link failure or the source PCell upon handover failure.","paragraph_zero_based":3823},{"literal_text_all_w_t_and_m_t":"measResultLastServCellRSSI","paragraph_zero_based":3824},{"literal_text_all_w_t_and_m_t":"This field refers to the log RSSI measurement results in dBm (see TS 38.215 [9]) taken for the frequency of the PCell upon detecting radio link failure or source PCell upon detecting handover failure.","paragraph_zero_based":3825},{"literal_text_all_w_t_and_m_t":"measResultNeighFreqListRSSI","paragraph_zero_based":3826},{"literal_text_all_w_t_and_m_t":"This field is used to log the RSSI measurement results in dBm (see TS 38.215 [9]) taken for the neighbouring frequencies upon detecting radio link failure or handover failure, when UE operates in shared spectrum.","paragraph_zero_based":3827},{"literal_text_all_w_t_and_m_t":"measResult-RLF-Report-EUTRA","paragraph_zero_based":3828},{"literal_text_all_w_t_and_m_t":"Includes the E-UTRA RLF-Report-r9 IE as specified in TS 36.331 [10].","paragraph_zero_based":3829},{"literal_text_all_w_t_and_m_t":"measResult-RLF-Report-EUTRA-v1690","paragraph_zero_based":3830},{"literal_text_all_w_t_and_m_t":"Includes the E-UTRA RLF-Report-v9e0 IE as specified in TS 36.331 [10].","paragraph_zero_based":3831},{"literal_text_all_w_t_and_m_t":"noSuitableCellFound","paragraph_zero_based":3832},{"literal_text_all_w_t_and_m_t":"This field is set by the UE when the T311 expires.","paragraph_zero_based":3833},{"literal_text_all_w_t_and_m_t":"previousPCellId","paragraph_zero_based":3834},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the source PCell of the last handover (source PCell when the last executed RRCReconfiguration message including reconfigurationWithSync was received, or when the last MobilityFromNRCommand message concerned an inter-RAT handover from NR to EUTRA was received). For intra-NR handover or the handover from NR to EUTRA nrPreviousCell is included and for the handover from EUTRA to NR eutraPreviousCell is included.","paragraph_zero_based":3835},{"literal_text_all_w_t_and_m_t":"pSCellId","paragraph_zero_based":3836},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the PSCell in which the UE failed to perform fast MCG recovery procedure or the UE successfully performed fast MCG recovery procedure or the source PSCell of the CHO with candidate SCG procedure failure.","paragraph_zero_based":3837},{"literal_text_all_w_t_and_m_t":"ra-InformationCommon","paragraph_zero_based":3838},{"literal_text_all_w_t_and_m_t":"This field is optionally included when connectionFailureType is set to 'hof' and a random access procedure is triggered for the failed reconfiguration with sync, or when connectionFailureType is set to 'rlf' and the rlf-Cause equals to 'randomAccessProblem' or 'beamRecoveryFailure'; otherwise this field is absent.","paragraph_zero_based":3839}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["1fd5c7e2657370a6e0301c9a1c9c7008a3657a79436677512994704d01108de1","19edb8e5c0fd48c3ac9127bf05e9e2b6889dae3af9c3cf9e8aa268bae2dcf64b","c874ce4e53fd6a2329910fcc5c40e162cee208106cf6355bdfeff169c9d927a6","d99da67fd7b752d561021e8321848ee30d5ad59055bcec0c98782802e8322461","3f37dbbb6e6fd133aecba2a3d6d203d61f52bc68eb9c63b61ecab9bc1a188d90","e78ac6ef92068c64410eaa666f10cd9d1c9d6de7ce04b28914a6e09165b149e9","205ace357adb31953e0b44591c95aa317850e839daa4c9dc056057bb8bd7ed08","b0c745b5f5f6a497c20d6a5f6d97b449495b95108592c8ab2ed1d0c30e147d30","b7ff3afeabc1205b308360ee2ee1ef0e24f4290a70ef637a66c730679355d95b","30420c624b471a35ffe971184091eea7cc57eb9b1c9ff256a503c91de85c61ad","bb3bcdf38b0a0f7510e5cf04cf4b62daccba832a1ff57f9df5c5aa79a81231d1","b087b4d87497a3b643a041dd5f512b6815bdb7ffbfec7c06485ac07bc47e808f","608047a402914c97d53c9e1bf122bf0de8158e81a25af2565f69afd50ea7a244","4d45e699a2f009aca03a26fa5cfa53159b199405e6ec7623ef75ec61443aec21","fb8a67dce8ca0aa1972c38cfc5a9bfd1537be71a845c085ff26ff7631bd26447","04d91d490c433cff1d753c200e31bfca1b3c985ce94d1b3d13fc12fb11b2856c","dc207408cb9e09420afcf704c97afe48122465674ecb24aadc11ccea66d2d401","2395808664a8f251547991b2314d644e7233d87cb37e479567738ed65d1b0490","836acd4bea6083dd6cac1d5ef19c5622b7f5df16fe1d71102e02039233da7ffe","0b357ef2b02dff901d8bea8ba8b872d33f493107964fe7032e5369cb5c360693","1bacc101049cabdba94d2d57061664eb3e3320f1afc2c62d3892456de7ecfa91","1dd94ca7943b359096fc2a02a661067d780d76a9131b7fccb79dea439d7a5c5e","8a695187dfa7caa6a320c6e96bc62f98344c63bdae448452ad4a5e76b1bb93dc","03e8e0e71a7634fdc33b9d6d87550fba9b56ba2f57c2025b6d99e9b187eb1f94"],"paragraph_range_zero_based":[3816,3839],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p3816"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"reconnectCellId","paragraph_zero_based":3840},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the cell in which the UE comes back to connected after connection failure and after failing to perform reestablishment, or to indicate the suitable cell in which the UE reconnects after failure in performing MobilityFromNRCommand for voice fallback (without initiating re-establishment procedure). If the UE comes back to RRC CONNECTED in an NR cell then nrReconnectCellID is included and if the UE comes back to RRC CONNECTED in an LTE cell then eutraReconnectCellID is included.","paragraph_zero_based":3841},{"literal_text_all_w_t_and_m_t":"reestablishmentCellId","paragraph_zero_based":3842},{"literal_text_all_w_t_and_m_t":"If the UE was not configured with conditionalReconfiguration at the time of re-establishment attempt, or if the cell selected for the re-establishment attempt is not a candidate target cell for conditional reconfiguration, this field is used to indicate the cell in which the re-establishment attempt was made after connection failure.","paragraph_zero_based":3843},{"literal_text_all_w_t_and_m_t":"rlf-Cause","paragraph_zero_based":3844},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the cause of the last radio link failure that was detected. In case of handover failure information reporting (i.e., the connectionFailureType is set to 'hof'), the UE is allowed to set this field to any value, except for the case in which a radio link failure was detected in the source PCell while performing a DAPS handover.","paragraph_zero_based":3845},{"literal_text_all_w_t_and_m_t":"scg-FailedAfterMCG","paragraph_zero_based":3846},{"literal_text_all_w_t_and_m_t":"This field is set if for the SCG failure is detected after MCG failure while T316 is running.","paragraph_zero_based":3847},{"literal_text_all_w_t_and_m_t":"ssbRLMConfigBitmap","paragraph_zero_based":3848},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the SS/PBCH block indexes configured in the RLM configurations for the active BWP when the UE declares RLF or HOF.The first/leftmost bit corresponds to SSB index 0, the second bit corresponds to SSB index 1. This field is included only if the RadioLinkMonitoringConfig for the respective BWP is configured.","paragraph_zero_based":3849},{"literal_text_all_w_t_and_m_t":"timeConnFailure","paragraph_zero_based":3850},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the time elapsed since the last HO or LTM cell switch execution until connection failure. Actual value = field value * 100ms. The maximum value 1023 means 102.3s or longer.","paragraph_zero_based":3851},{"literal_text_all_w_t_and_m_t":"timeConnSourceDAPS-Failure","paragraph_zero_based":3852},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the time that elapsed between the last DAPS handover execution and the radio link failure detected in the source cell while T304 is running. Value in milliseconds. The maximum value 1023 means 1023ms or longer.","paragraph_zero_based":3853},{"literal_text_all_w_t_and_m_t":"timeSinceFailure","paragraph_zero_based":3854},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the time that elapsed since the connection (radio link, handover or LTM cell switch) failure. Value in seconds. The maximum value 172800 means 172800s or longer. In the case of failure(s) (either at source or at target or at both) associated to DAPS handover, this field indicates the time elapsed since the latest connection (radio link, handover or LTM cell switch) failure.","paragraph_zero_based":3855},{"literal_text_all_w_t_and_m_t":"timeSinceCHO-Reconfig","paragraph_zero_based":3856},{"literal_text_all_w_t_and_m_t":"In case of handover failure, this field is used to indicate the time elapsed between the initiation of the last handover execution towards the target cell and the reception of the latest conditional reconfiguration. In case of radio link failure, this field is used to indicate the time elapsed between the radio link failure and the reception of the latest conditional reconfiguration while connected to the source PCell. Actual value = field value * 100ms. The maximum value 1023 means 102.3s or longer.","paragraph_zero_based":3857},{"literal_text_all_w_t_and_m_t":"timeUntilReconnection","paragraph_zero_based":3858},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the time that elapsed between the connection (radio link, handover or LTM cell switch) failure and the next time the UE comes to RRC CONNECTED in an NR or EUTRA cell, after failing to perform reestablishment. Value in seconds. The maximum value 172800 means 172800s or longer.","paragraph_zero_based":3859},{"literal_text_all_w_t_and_m_t":"voiceFallbackHO","paragraph_zero_based":3860},{"literal_text_all_w_t_and_m_t":"This field is set if for the failed mobility from NR, the voiceFallbackIndication was included in the MobilityFromNRCommand message.","paragraph_zero_based":3861},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3862},{"literal_text_all_w_t_and_m_t":"SuccessHO-Report field descriptions","paragraph_zero_based":3863}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["d25e065ad45fdcaf4009c207237e74c3964d7902a7c2e27aef095e421767cb80","31b2d723ede1793ecd94644ffd24bcc3d6b0e1cfd60d97898e6901e929b94aba","2b615da57748faf7d09f399c78beef99081f1426767f3abb5fde4439e4996689","9a96d45a1139de9a945873de3c7c5f969d18f98e8c62e524061b6cd418386213","8aa0d28f7de5c438e2e0b6dfce6c021f47bbfa503ad491cb2d89c2274bb33288","ce106e2d3ea0918dbd488f8b8b5870a2d8be7862df2bf091e1e54bf59dfffb8f","953d3c1651fda3bfb9ecf833699c5c246da1df575b199f9eb57154abac4f6d9d","523935c67f4cd3849d3d24649a49fd755683d517bb4494faf1660d18539f356b","2a2633f21d0c6e3128dde0b22e9c859160ee2f23a4151e33573a9caf61f50e09","30eecedf75ab6750c34bc3747b1ccfaa53bd189beb5da3661d65d69515ac7643","bb9d75155990fe45e39a29ae24165d9498bc8a5aea91954a7731aacc3ba90285","ef0c5d7fdff2921a26d20f76a3e017719fbd1328d669afa420dd8a8fb027128b","03f4c7aa8d905d63ef7be14ce98df55385240fb07e9f8a607b5d7eebbbd43f83","cb2919ffb449047f23b53531305f90c98e241163bd6f5e504ed0f2f9b187138e","0c714a8d129556152ddef352aeccf50be9f0df15e98624a784694c636047361c","31a214bdd96d57539252208911fdae44680dcbbe4083c786005df0abc11ff830","89aee6401bdcc223a140d3288760c7965245b89a61f4ee546fc8e16e482d9db4","a463c43e1acd3e502341b1daa6266574ac4ab77ccafe8384c501f2ab8897d5b7","c58d6eb0dfd136d554915600b2dac8a14d72c0198f40b96e471c6e6038e39170","9853e43ce4525d1086ab49bed54332c9c22e837194520694bbd6fa4c62b3ebb2","81e0c27faa5b63ac33977d8b8041e6702177e24d2afa8ec97db38abdc6c25fe9","652f05aea502a23bb0c3fef1c43d0484bb7d295cd0703f53f0bbf379e2b2a9ee","c41f004ae344d4bb4d60e71525205d6e91d4cb58b31cc608dbbb51d81aaafa4c","c0e17fa0027bcccc477fe21941a768c0d4c797f3573cd4f1125b3220472eb933"],"paragraph_range_zero_based":[3840,3863],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p3840"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"c-RNTI","paragraph_zero_based":3864},{"literal_text_all_w_t_and_m_t":"This field indicates the C-RNTI assigned by the target PCell of the handover for which the successful HO report was generated.","paragraph_zero_based":3865},{"literal_text_all_w_t_and_m_t":"eutra-TargetCellInfo","paragraph_zero_based":3866},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the target EUTRA PCell and the last measurement results of the target PCell of a handover in which the successful handover triggers the SuccessHO-Report.","paragraph_zero_based":3867},{"literal_text_all_w_t_and_m_t":"eutra-C-RNTI","paragraph_zero_based":3868},{"literal_text_all_w_t_and_m_t":"This field indicates the C-RNTI assigned by the E-UTRA target PCell of the mobility from NR command for which the successful HO report was generated.","paragraph_zero_based":3869},{"literal_text_all_w_t_and_m_t":"measResultListNR","paragraph_zero_based":3870},{"literal_text_all_w_t_and_m_t":"This field refers to the last measurement results taken in the neighboring NR Cells when a successful handover is executed.","paragraph_zero_based":3871},{"literal_text_all_w_t_and_m_t":"measResultNeighFreqListRSSI","paragraph_zero_based":3872},{"literal_text_all_w_t_and_m_t":"This field is used to log the RSSI measurement results in dBm (see TS 38.215 [9]) taken for the neighbouring frequencies upon successful handover execution.","paragraph_zero_based":3873},{"literal_text_all_w_t_and_m_t":"measResultServCellRSSI","paragraph_zero_based":3874},{"literal_text_all_w_t_and_m_t":"This field refers to the log RSSI measurement results in dBm (see TS 38.215 [9]) taken for the frequency of the source PCell upon successful handover execution.","paragraph_zero_based":3875},{"literal_text_all_w_t_and_m_t":"neighCellsMeasL1ListNR","paragraph_zero_based":3876},{"literal_text_all_w_t_and_m_t":"This field refers to the last L1 measurement results taken in the neighboring MCG LTM candidate Cells when a successful reconfiguration with sync is executed if the UE was configured with ltm-Config associated with the MCG when connected to the source PCell.","paragraph_zero_based":3877},{"literal_text_all_w_t_and_m_t":"rach-Less","paragraph_zero_based":3878},{"literal_text_all_w_t_and_m_t":"This field is set if the successful HO report is trigged by RACH-less LTM cell switch.","paragraph_zero_based":3879},{"literal_text_all_w_t_and_m_t":"rlf-InSourceDAPS","paragraph_zero_based":3880},{"literal_text_all_w_t_and_m_t":"This field indicates whether a radio link failure occurred at the source cell while T304 was running.","paragraph_zero_based":3881},{"literal_text_all_w_t_and_m_t":"shr-Cause","paragraph_zero_based":3882},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the cause of the successful HO report.","paragraph_zero_based":3883},{"literal_text_all_w_t_and_m_t":"sourceCellMeas","paragraph_zero_based":3884},{"literal_text_all_w_t_and_m_t":"This field refers to the last measurement results taken in the source PCell of a handover in which the successful handover triggers the SuccessHO-Report.","paragraph_zero_based":3885},{"literal_text_all_w_t_and_m_t":"sourceCellMeasL1","paragraph_zero_based":3886},{"literal_text_all_w_t_and_m_t":"This field refers to the last L1 measurement results taken in the source PCell of a reconfiguration with sync if the UE was configured with ltm-Config associated with the MCG when connected to the source PCell.","paragraph_zero_based":3887}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["c5b089db01c12bc29b11ac0f50f334ac6cec43fc890bf87614ca576416ec7864","c3890a640c1514a47bb9d1037a9a5bf6d01ac947916f5cbdde0e531d9214376a","df397f309b66bbdb104c5399c1a67bc04b5ee62f40f197e4245db50fdb07f5c7","838c6e48d1b333449ea0d2a1c42415371e3a54e7ce16aecb2754f690afb649a1","227744d17055c3a7d12edc5fed8e592045ab6ddfbace34e28b5bdbbf9c6ad99c","948b76889bbca7a93a33d118bc427a9cb23d3873543aae83d9e039e54f972032","9d25b64d59a205b53d70660a7da187574ce23acc8d19d34c701f4a4a8577b707","4d0d09b9263d1fb7bdca0220ba281f77dc923223c9fd4de5075f4c6e9028c98f","39fbecfbec1c6dde3f1112ec6aae96cd2422b3ce92c82d05b01657da239c3617","286914ae928cd6b1b5fd87759f382c74fbc39d894f7da533ac9e5031b054f23a","378d2883b60591898ca611b961e44ae5809e016e7f6d2594adc26f1b07e54ca9","1d548e127732c8487a0a8d22f9b7dd5ce3fdfd1ace3a40158cd51912ad46a0f9","2ff6ea6f79658bfcfb2cb041594dd909690ee2569efa2c931f996a1e0ad91ee1","732b6f59e764e755183b895411985c30c08a40ce5b737dce804de2be3e3c47a7","926338e5c9ec16b366f3eb0ee4ea2c7d7ce0ede1824738a0ba1392e116302bc9","4c6080039f66450849b952a4b111a48d1f18759b745237d5e443724ae3a88271","eee3271a6f22b9ee5b47fd2066e5ed3893a11bc41b8ab7e34328852bf3624dab","c945ef870462226fe25d3bfc0767508582debc69e587243de691e8aafe45fb10","28c559a35a6dee2786ffc715a755bb5663a5089e3b2c25ecfcf6c319abedcd96","8491c329ec3d97e6627744027109b117f3fd94ecf312ba49914e717ade0cf8af","613937ed73a9d3b453e5a860491dad16b5f6939f21f21cc3078fc0c2b905ed5e","b51e82e0dd74060e6f7cebe37f40e3357638c8abeba66fedffde996f5d492d84","aaee0ceeedb31af220601d8de4eca892dfb02017442b83cfcadf0bdbf1d94ef3","5a2515fa8d3a2904d72f3cded529e5cf3eaac53edc5fee3450c09cd6d39fcd39"],"paragraph_range_zero_based":[3864,3887],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p3864"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sourcePCellId","paragraph_zero_based":3888},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the source PCell of a handover in which the successful handover triggers the SuccessHO-Report.","paragraph_zero_based":3889},{"literal_text_all_w_t_and_m_t":"sourcePSCellId","paragraph_zero_based":3890},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the source PSCell of a PSCell change associated with a CHO with candidate SCG in which the successful execution of CHO triggers the SuccessHO-Report.","paragraph_zero_based":3891},{"literal_text_all_w_t_and_m_t":"sourcePSCellMeas","paragraph_zero_based":3892},{"literal_text_all_w_t_and_m_t":"This field refers to the last measurement results taken in the source PSCell of a PSCell change associated with a CHO with candidate SCG in which the successful execution of CHO triggers the SuccessHO-Report.","paragraph_zero_based":3893},{"literal_text_all_w_t_and_m_t":"targetPCellId","paragraph_zero_based":3894},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the target PCell of a handover in which the successful handover triggers the SuccessHO-Report.","paragraph_zero_based":3895},{"literal_text_all_w_t_and_m_t":"targetPSCellId","paragraph_zero_based":3896},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the target PSCell of a PSCell change/addition associated with a CHO with candidate SCG in which the successful execution of CHO triggers the SuccessHO-Report.","paragraph_zero_based":3897},{"literal_text_all_w_t_and_m_t":"targetCellMeas","paragraph_zero_based":3898},{"literal_text_all_w_t_and_m_t":"This field refers to the last measurement results taken in the target PCell of a handover in which the successful handover triggers the SuccessHO-Report.","paragraph_zero_based":3899},{"literal_text_all_w_t_and_m_t":"targetCellMeasL1","paragraph_zero_based":3900},{"literal_text_all_w_t_and_m_t":"This field refers to the last L1 measurement results taken in the target PCell of a reconfiguration with sync if the UE was configured with ltm-Config associated with the MCG when connected to the source PCell.","paragraph_zero_based":3901},{"literal_text_all_w_t_and_m_t":"timeSinceCHO-Reconfig","paragraph_zero_based":3902},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the time elapsed between the initiation of the last conditional reconfiguration execution towards the target cell and the reception of the latest conditional reconfiguration for this target cell. Actual value = field value * 100ms. The maximum value 1023 means 102.3s or longer.","paragraph_zero_based":3903},{"literal_text_all_w_t_and_m_t":"timeSinceSHR","paragraph_zero_based":3904},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the time elapsed since the execution of the last MobilityFromNRCommand towards the target EUTRA cell. Value in seconds. The maximum value 172800 means 172800s or longer.","paragraph_zero_based":3905},{"literal_text_all_w_t_and_m_t":"upInterruptionTimeAtHO","paragraph_zero_based":3906},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the time elapsed between the time of arrival of the last PDCP PDU received from the source cell for any data radio bearer and the time of arrival of the first non-duplicate PDCP PDU received from the target cell for any data radio bearer, and it is measured at the time of arrival of the first non-duplicate PDCP PDU received from the target cell for any data radio bearer. The field is set only in case of DAPS handover.Value in milliseconds. The maximum value 1023 means 1023ms or longer.","paragraph_zero_based":3907},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3908},{"literal_text_all_w_t_and_m_t":"FlightPathInfoReport field descriptions","paragraph_zero_based":3909},{"literal_text_all_w_t_and_m_t":"timeStamp","paragraph_zero_based":3910},{"literal_text_all_w_t_and_m_t":"Time stamp that describes estimated time of arrival, if available, of the UE at the corresponding wayPointLocation.","paragraph_zero_based":3911}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["eeab55e1e55e075e827892ec2f670abcf2a12573a4a889a72f3f319398ad6e23","f318294107cffd4a05d150f9caf568963c7e1a06daeb5e429a1a8d65ecb9f30e","e006bcc22a79f1c81874e85d37fa06e93287ddaba1360f02ebe1461be59b866e","1dba00fd5936f5846bd1f373b986e38803ebc8c32c84f308a59cf21e272274d0","88a4a5c4ec4a47fe0525f01bf67ce1673f0528c17b368da95d50e812d777eee3","d2d78de33c42077c93fed9f1dfbf3566fafac3585daa81b833f07d4a4470f885","113e22ac4b4eb56a033892fbe8655982caa82dc98f1a169a61b959f81bd1b49a","fbc3f8bb02afb281c547f587a5a85ef33663ff03113cc1fdb624013234f454a8","9bccc282f2b2bb89e4c441be2bb5faab06fd15a7f886e7240482353c148bea45","bcec60cfc72a5d81497d34861501953a067fcdfdd7ca00925aaaf79b20198e72","bbfb5aa9883439cb6c07df8161b2cf8ba833aa0e252764f6f69da1a43d0b9773","ef304d9a7025b1ca223637b427ad0fdecb0005b40bb58c4f3a920a0e262a46c6","0b873e4e6ca0032a8c74234a0a4802463d4c5cf1f101953cc5db239f7437e2d7","cae2dc7991d5fd591ae0c7549bc4eaf6811ae6bcce697fc1861ce783c07f1b95","f237e53ef982d36f1d5e236d5b70e2512d2d466098b27ca925a95b2484246613","22422949d5f07e1a1989abca74315346b99fd3c7eac5c062f1bdb21ec6d5c839","523c4d6f4b0461fc60d924dcef64e0017ba350e6b2253eb57a1051c24bc28656","6836d2234f0697e4c95dfdeb87f72c68f0366b0bd17d5096873c713c83be7684","4abeedbe44611980f38266825c7666b2274c1a6d99d52749a6759ff8673774fa","6ba88327dc74caec9ee226e478a8c004c1ddb10335248878c0eecf36fa2aa704","38e032148be75dc2afb4f03e4e5d4fc8f7365d852db4c412755e9aa32ae1e6a3","822278a5888558ad8b94de9fc41a10adf28ed57d819555074490be101d437fe2","1ce53012b4b6fbb7679cea239eb32a914e96b7fe6e85eb5510df09734b687dfe","77ea0b76d2961cf5ca6bea598e435fea961cdcc1ee933c7076fefcaf1c1307d1"],"paragraph_range_zero_based":[3888,3911],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p3888"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"wayPointLocation","paragraph_zero_based":3912},{"literal_text_all_w_t_and_m_t":"Location coordinates of the planned waypoint. Parameter type LocationCoordinates defined in TS 37.355 [49]. The first/leftmost bit of the first octet contains the most significant bit.","paragraph_zero_based":3913},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3914},{"literal_text_all_w_t_and_m_t":"SuccessPSCell-Report field descriptions","paragraph_zero_based":3915},{"literal_text_all_w_t_and_m_t":"c-RNTI","paragraph_zero_based":3916},{"literal_text_all_w_t_and_m_t":"This field indicates the C-RNTI assigned by the target PCell of the conditional handover successfully executed as part of CHO with candidate SCG in which the SuccessPSCell-Report was triggered.","paragraph_zero_based":3917},{"literal_text_all_w_t_and_m_t":"measResultListNR","paragraph_zero_based":3918},{"literal_text_all_w_t_and_m_t":"This field refers to the last measurement results according to the initiating node configuration taken in the neighboring NR Cells when a successful PSCell change/addition is executed.","paragraph_zero_based":3919},{"literal_text_all_w_t_and_m_t":"pCellId","paragraph_zero_based":3920},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the PCell to which the UE was connected when the successful PSCell change or addition triggers the SuccessPSCell-Report. Alternatively this field indicates the source PCell to which the UE was connected to before executing CHO with candidate SCG in which the SuccessPSCell-Report was triggered.","paragraph_zero_based":3921},{"literal_text_all_w_t_and_m_t":"sn-InitiatedPSCellChange","paragraph_zero_based":3922},{"literal_text_all_w_t_and_m_t":"This field indicates whether the PSCell change procedure for which the successful PSCell change report is logged is SN initiated or not.","paragraph_zero_based":3923},{"literal_text_all_w_t_and_m_t":"spr-Cause","paragraph_zero_based":3924},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the cause of the successful PSCell change or addition report.","paragraph_zero_based":3925},{"literal_text_all_w_t_and_m_t":"sourcePSCellId","paragraph_zero_based":3926},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the source PSCell of a PSCell change in which the successful PSCell change triggers the SuccessPSCell-Report.","paragraph_zero_based":3927},{"literal_text_all_w_t_and_m_t":"sourcePSCellMeas","paragraph_zero_based":3928},{"literal_text_all_w_t_and_m_t":"This field refers to the last measurement results taken in the source PSCell of a PSCell change in which the successful PSCell change triggers the SuccessPSCell-Report.","paragraph_zero_based":3929},{"literal_text_all_w_t_and_m_t":"targetPCellId","paragraph_zero_based":3930},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the target PCell of a CHO with candidate SCG procedure in which the SuccessPSCell-Report was triggered.","paragraph_zero_based":3931},{"literal_text_all_w_t_and_m_t":"targetPSCellId","paragraph_zero_based":3932},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the target PSCell of a PSCell change/addition in which the successful PSCell change or addition triggers the SuccessPSCell-Report.","paragraph_zero_based":3933},{"literal_text_all_w_t_and_m_t":"targetPSCellMeas","paragraph_zero_based":3934},{"literal_text_all_w_t_and_m_t":"This field refers to the last measurement results taken in the target PSCell of a PSCell change/addition in which the successful PSCell change or addition triggers the SuccessPSCell-Report.","paragraph_zero_based":3935}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e32