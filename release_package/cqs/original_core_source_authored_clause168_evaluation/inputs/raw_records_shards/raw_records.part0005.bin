3}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"f8fd24dd7ce0847a449e5f0561178376b7de09914bc5aa659d80d87036a6a666","original_member_sha256":"e4160743d6acdff7a4abdf8ce8e52860b820cb36b9a35873d6538611e7926bfc","paragraph_ElementTree_utf8_XML_sha256":["bcfddbc578e3f0e07e71659ef87d01ae4a724c5d4ecd7222fdf4711adb6818e3","8d38957f0a96049bcfcd0ad1b23d3dec0a7e617ecdf1a0db6ec35d60efd27576","a0e567c53399aab830d6289a91fd460da28419c0d87df2588f75a2d75ee6641d","ef72353b67f7028dfc961572d2f4d6f190c451661ae5cf003a7d6801675091b7","e968346e137c093f50f7a4608fa970d9a1fdf777d009f92a2fed3e3c24ffca64","5a66c52b5dabc4a19de4c446e193e4e3948e35a9aa05a2166d00d0a2c4e57c17","e748909d5cd3506a47303ec9bd94e892cf0f64ac959599e79c09ce77220baaa8","5ef535dc6dc29a541a314d2fd6e4275f5f1ff501b1d9372683f7c9a2f63a2486","dfb7e67e6a97f85363cb098be2014edc5e80779f54e6b11dcf80d1cb50ac1723","5688e16b8ae749346f615d4c57721d19e13e5f26a5b55e1e893d7ab951e91c52","1e0773b797aaa8e53a91fd6326ef699f1c8627b147e555c2957e8c3197a89f2c","46485d09d2a28af2d93627bc08a9aaaeddbb57a6d33d73f2938dc8ecb243a038","cedb30adc5d519053d8c4f945ddbe594e869d09d58bdb2fa012f10c0a8ca8ee3","e7e83bcaf5e2fa68ff16fdc70ee21000fcf9a9da9df973ae564d47b9b1de838d","5772a66a37c4e9dc9fe1a3b7442b4b98bc9891c80f8a44bea66c57104db6a99a","d6d5b9983b780ad3348ec8e464b4edfd81ab51b2eab05c3a3f4f3c3175b7a03c","113c4384dacb8c3b6da55669e435084e3beea430c7dcfd3f04b8fb55fb9bffb9","bef3d4c2574985ce4439b583094764bac67061b34a0c76ed1563805924987a6b","f0bc8157bb0bfe205231b95fe5c74884c083d1aaeb0dff2545e7ee8cf37b16ca","f9f7970b4f7be912f28d2470e5c20f455bdf079097b3327aab30a392506cf5c3","d4a57c197fafad7bf75aa835c482186f6ec28f066e95dc89888340c596dbc16e","b4d6d99990b557230d386d1e799821b1033eed25eb98a59bbfae9b4b55b17842","2e7f290d26ea35a13fd0f6c460839c4a3f095822f15d7e3b40632342fbf0756e","a22604a2780c9683bd2f26fb161cc5d32a1af70817f8f4860ac95e73cada1131"],"paragraph_range_zero_based":[0,23]