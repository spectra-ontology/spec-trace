PRS-RPToAddModList-r18","paragraph_zero_based":48517},{"literal_text_all_w_t_and_m_t":"        SEQUENCE (SIZE (1..maxNrofCG-SL-r16)) OF SL-ConfiguredGrantConfigDedicatedSL-PRS-RP-r18                OPTIONAL  -- Need N","paragraph_zero_based":48518},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":48519},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48520},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SCHEDULEDCONFIG-STOP","paragraph_zero_based":48521},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":48522},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48523},{"literal_text_all_w_t_and_m_t":"SL-ScheduledConfig field descriptions","paragraph_zero_based":48524},{"literal_text_all_w_t_and_m_t":"sl-CS-RNTI","paragraph_zero_based":48525},{"literal_text_all_w_t_and_m_t":"Indicate the RNTI used to scramble CRC of DCI format 3_0, see TS 38.321 [3].","paragraph_zero_based":48526},{"literal_text_all_w_t_and_m_t":"sl-DCI-ToSL-Trans","paragraph_zero_based":48527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["87f3fee8b0a5a884e86e71ac9be4699264ceeb54625c55c3d99e5e31d6e39a1d","7f2b667553606ef8f0c0a61b13bff0623941275a698c0c786facaed765633aca","3a7939e91757bcff1cf0ca5d57a3d3cdaf19735371a58c070522efd6c3f55044","81228083fbb8f77dfb08a949b18a50efa35dd3b693b4d66d3d541af8216fefca","fd2647a24572e89e63bdf817b253da86878936b94ca03d835d1411a76954c2ce","29a34ab1ea2cb419595e74c1ccbf29278dd28a93d407a738c0c5e8744c6e25b2","ce7aec5c8357e47871ce4fe3e1de704f4ed4097d19bd1bbe8895cdf3a7fee360","18fae5b6740cbfc26947354b3555a0b078bbb790911817ac6fce615b85fdf9fa","bb68db453b3bdfb3adbc98499499b505dc4363ac479cf0eae9dd2caee076f8f5","997bd94de765cfefb5c53e399c4