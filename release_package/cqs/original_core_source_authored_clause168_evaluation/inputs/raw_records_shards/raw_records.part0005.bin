ext_all_w_t_and_m_t":"","paragraph_zero_based":231},{"literal_text_all_w_t_and_m_t":"DedicatedSIBRequest field descriptions","paragraph_zero_based":232},{"literal_text_all_w_t_and_m_t":"requestedSIB-List","paragraph_zero_based":233},{"literal_text_all_w_t_and_m_t":"Contains a list of SIB(s) the UE requests while in RRC_CONNECTED.","paragraph_zero_based":234},{"literal_text_all_w_t_and_m_t":"requestedPosSIB-List","paragraph_zero_based":235},{"literal_text_all_w_t_and_m_t":"Contains a list of posSIB(s) the UE requests while in RRC_CONNECTED. When requestedPosSIB-List-r19 is present, requestedPosSIB-List-r16 is not present.","paragraph_zero_based":236},{"literal_text_all_w_t_and_m_t":"deliveryAmount","paragraph_zero_based":237},{"literal_text_all_w_t_and_m_t":"This field specifies the number of periodic deliveries for the indicated posSIB. Integer values N=1…30 correspond to an amount of 2^N. Integer value N=31 indicates an 'infinite/indefinite' amount and integer value N=0 indicates that no more deliveries are needed.","paragraph_zero_based":238},{"literal_text_all_w_t_and_m_t":"deliveryInterval","paragraph_zero_based":239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e0c257c70d07100f1ede427a4f65f560f2201057cbf73ef45f430ec77898d451","original_member_sha256":"c33e87983ca56840fbfb3ece9b2b5c25c1e6cd4e9cf14026330d400169e5fdbe","paragraph_ElementTree_utf8_XML_sha256":["efbf126a5e7e39d1e62d3c841e70dc8120fd50e890ceb42bb1e73025c06b979d","c08fbc9b455198e4021c819009d475522382fa708107215fb3456db803351a00","c3c57007708065a7590bfe7911038deb930a2811d8bb90b1151bd6473123fa84","769c41a7ef52e3cd1b469d2f7be39d28e878e52648303da6c2bcac98818f2542","c9c5e6de0829ec57066011d7b87599dbf5d49d3d9359f7bf49cd85eb05a6d9a4","14ae103d9769d380b6551a4e8131ea9c1db83e1795ff45180d3408301db4b1a6","a592035476c3ae819aa1f650b59a4b66a0396aa3844931213126144918980216","98f0dc2aad7634b1920c0b1ff8fc3bf8302c7