{"fields":{"filename":"R2-2509465.zip::R2-2509465.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"[…]","paragraph_zero_based":168},{"literal_text_all_w_t_and_m_t":"–GNSS-LOS-NLOS-GridPoints","paragraph_zero_based":169},{"literal_text_all_w_t_and_m_t":"The IE GNSS-LOS-NLOS-GridPoints is used by the location server to provide a list of grid point coordinates or an array of correction points (\"grid\") for which specific assistance data can be provided.","paragraph_zero_based":170},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":171},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":172},{"literal_text_all_w_t_and_m_t":"GNSS-LOS-NLOS-GridPoints-r18 ::= SEQUENCE {","paragraph_zero_based":173},{"literal_text_all_w_t_and_m_t":"gridPointsSetID-r18INTEGER (0..16383),","paragraph_zero_based":174},{"literal_text_all_w_t_and_m_t":"horizontalGridPoints-r18ArrayOfGridPoints-r18,","paragraph_zero_based":175},{"literal_text_all_w_t_and_m_t":"referenceAltitudeFine-r18INTEGER (0..9)OPTIONAL, -- Need OP","paragraph_zero_based":176},{"literal_text_all_w_t_and_m_t":"verticalGridPoints-r18VerticalGridPoints-r18OPTIONAL, -- Cond 3D","paragraph_zero_based":177},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":178},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":179},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":180},{"literal_text_all_w_t_and_m_t":"ArrayOfGridPoints-r18 ::= SEQUENCE {","paragraph_zero_based":181},{"literal_text_all_w_t_and_m_t":"referencePointLatitude-r18INTEGER (-16777216.. 16777215),","paragraph_zero_based":182},{"literal_text_all_w_t_and_m_t":"referencePointLongitude-r18INTEGER (-33554432.. 33554431),","paragraph_zero_based":183},{"literal_text_all_w_t_and_m_t":"numberOfStepsSouth-r18INTEGER (0.. 255),","paragraph_zero_based":184},{"literal_text_all_w_t_and_m_t":"numberOfStepsEast-r18INTEGER (0.. 255),","paragraph_zero_based":185},{"literal_text_all_w_t_and_m_t":"stepSouth-r18SpatialDelta-r18,","paragraph_zero_based":186},{"literal_text_all_w_t_and_m_t":"stepEast-r18SpatialDelta-r18,","paragraph_zero_based":187},{"literal_text_all_w_t_and_m_t":"bitmaskOfGrids-r18CHOICE {","paragraph_zero_based":188},{"literal_text_all_w_t_and_m_t":"bog16-r18BIT STRING (SIZE(16)),","paragraph_zero_based":189},{"literal_text_all_w_t_and_m_t":"bog64-r18BIT STRING (SIZE(64)),","paragraph_zero_based":190},{"literal_text_all_w_t_and_m_t":"bog256-r18BIT STRING (SIZE(256)),","paragraph_zero_based":191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"031803c101a10e427d1f230cc629e09e0bd01d184d1e2938f387ad803c3911dc","original_member_sha256":"2bae8d5ac03017cc49187eaa8fa5f66dd9d41d8add52aa40b5603598875c82af","paragraph_ElementTree_utf8_XML_sha256":["f92ff71a9559f588da3cd9f33c1b9ca91249831b3c376a335d43f2ab315943cd","e4cc43fb0de22b28611008c50d0b53431f473baf6f754047c6f0811e33b7539f","da693962c0481a2f066f55d56f46572a6750fe55b3e9569b3928eb60b0b5d143","0e7855b2d2bcb1aaf9afe243e68dc729885c7c9e2d3e11b8ebda2c40accec6be","db5111f94563edf82a9271cac3f6344eba333b5cf06b4f51203f3041bf9c735a","41c99562bfaed9ba6f5be15641cc251c1ecfae457b250be7a2857ad0bd3a600d","eabadf12f091d8edd8815426845dc7dd24d823857528374e8bc53b8e63667009","4fb9f18a497ceeb05dc3dfb0571081fe34b349d44751fa0a26f69cc18fa7b4c2","112bccdbba605c7439f8f501ccf9f9245d7425d39d4d7bfd247b5bc60963734b","981a1b6bc5629d07446d138a951ae6504db21c9409bb7e917603fde70ba0c9e3","ca78b1c3f2a253570a902b4e2751a283362d732c0081650fbcf4562cbe738276","777117a5e130907e78f5ea4053d43759f38c1d0cee936e4469c45734630f8528","bc5ec28e8409e1608b50443128ec5b7ec7a884688ec58fce0fe125b58c98ffe1","a307fa620652b3f2c379595c53a48e0879a35443af80b2267fcdaee5c9afab21","5c4ada26b079a3427e23b1477cfb4c515bd625ab1f1bd94be1310661b2844e0a","503433f314b6bad79fe3e72771749a5ebc39ece4f2a1898b455e46b84dfa707e","4f8f83588