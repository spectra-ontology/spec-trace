{"fields":{"filename":"R2-2509465.zip::R2-2509465.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":192},{"literal_text_all_w_t_and_m_t":"}OPTIONAL, -- Need OP","paragraph_zero_based":193},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":194},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":195},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":196},{"literal_text_all_w_t_and_m_t":"VerticalGridPoints-r18 ::=SEQUENCE {","paragraph_zero_based":197},{"literal_text_all_w_t_and_m_t":"referenceAltitudeCoarse-r18INTEGER (-50..900),","paragraph_zero_based":198},{"literal_text_all_w_t_and_m_t":"numberOfStepsDown-r18INTEGER (1..3),","paragraph_zero_based":199},{"literal_text_all_w_t_and_m_t":"stepDown-r18SpatialDelta-r18,","paragraph_zero_based":200},{"literal_text_all_w_t_and_m_t":"upperValidityDeltaAltitude-r18SpatialDelta-r18OPTIONAL, -- Need OP","paragraph_zero_based":201},{"literal_text_all_w_t_and_m_t":"lowerValidityDeltaAltitude-r18SpatialDelta-r18OPTIONAL, -- Need OP","paragraph_zero_based":202},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":203},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":204},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":205},{"literal_text_all_w_t_and_m_t":"SpatialDelta-r18 ::= ENUMERATED {n1, n2, n3, n4, n5, n10, n20, n50, n100}","paragraph_zero_based":206},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":207},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":208},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":209},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":210},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":211},{"literal_text_all_w_t_and_m_t":"3D","paragraph_zero_based":212},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if a 3D grid is provided; otherwise it is absent.","paragraph_zero_based":213},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":214},{"literal_text_all_w_t_and_m_t":"GNSS-LOS-NLOS-GridPoints field descriptions","paragraph_zero_based":215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"031803c101a10e427d1f230cc629e09e0bd01d184d1e2938f387ad803c3911dc","original_member_sha256":"2bae8d5ac03017cc49187eaa8fa5f66dd9d41d8add52aa40b5603598875c82af","paragraph_ElementTree_utf8_XML_sha256":["c258752bfa827fe87eb76c6ca2df9d6dbac4ccc6d1439e507e7f1d6900eafccc","e964cbdad6e6835aded6f6618cb979efb4c84291830e7253f2c663a64a02254f","6e01e71773f2e56315625740a254569e27f9c949c070cc7ba2239ba5ef338a73","ca5027284aa1d418db4a69e9886bd7a6362f94b6adfe55f00e4ab7b0868d1f4a","c8f1584bc13f1ecfe4eb8141a0c0606d15447379fa7722d0ccd85f968975e86c","3ddd30dbd22e6a28a2125e3e80525edac0beee2eedc488aab1e37ccf897bbae1","0a05551cc56c2c0f15f47abb6ceb037afefff0e3a241d16b0b3ffde776b3c66b","927fae1ea29755fe26aa071efbd59b3cd66c6ca0350078dfcf58642c2f87e568","f8acb1fdad33896b507c807af045755cf1e2e0471e3f469429d89362e0b45f0c","f2f72d0078aa8d9f167ba9a823a2cc492d1d2e02cefa857fa8de692d9c761efe","5ffa073b462a796195c201f1604bdd044d0dce49879dc292f0550a8059260ffe","44963a13097040615981e33eab7cd00a54c1cd45e473e1d54a3c31ff09210046","8c779fce2ae0a6c22893acde4ed4144da1c392ba26f7b6aeae3b94c24aeba2cf","c01495dea3c7ebb5d2950ed3e219c47375f2699395ef80a78cc9871c87f44a29","e199edb94c441f2bcf630b2c658ed11741f788c2bee7d1dd8384deeca61e3bda","6f7b9f3a36027906d9bb68c93f0d4a040c57a0fe9ce34fa67631f6ba82f708af","a513870e15b250b678ffefcd44d5cf56c8966ed110ee87177bd886c77ed43a87","0f57ea4b9b3378463a5ce438028e5b9af8bb082060b15bf31677fb725d12f5c3","8f0e200c3612ff450e53fe5ca25aca0be1dee219c9b1015353326fe6af1e029c","a971e916b20001789c6757702346e7e96f5fafc7bd0d8b96e69f1bf6170aa88d","166696d29132af8857062350d1f9930c716008eada619e9e096e7cb2607a548d","f0bbe46598ab35655f7c3e91911360aefb97dcf6caba99c39ff980b3df4dc74a","90e89b81b424741a5bca587252844867d8c73aea5993146aeda8bc1c7e1e6f69","a1fe1ea28b486572cc52583598cc0ca6cdc90cca3f065b4b096750c80a4769c0"],"paragraph_range_zero_based":[192,215],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509465.zip::R2-2509465.docx:p192"}
{"fields":{"filename":"R2-2509465.zip::R2-2509465.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"gridPointsSetID","paragraph_zero_based":216},{"literal_text_all_w_t_and_m_t":"This field provides the ID of the spatial grid point set. It is a regionally unique arbitrary number that is used by the UE to ensure that provided assistance data associated to a spatial grid point set is being applied to the correct set of points.","paragraph_zero_based":217},{"literal_text_all_w_t_and_m_t":"The grid point set ID identifies a grid defined by a reference point corresponding to the northwest corner (of the upper layer in case of a 3D grid), where the rest of the grid is defined by a number of steps and step lengths in the south, east (down in case of a 3D grid). The grid is valid within the horizontal perimeter of the grid and between an upper and lower validity altitude, where the upper validity altitude is (referenceAltitudeFine + 10* referenceAltitudeCoarse + upperValidityDeltaAltitude), and the lower validity altitude is (referenceAltitudeFine + 10* referenceAltitudeCoarse – numberOfStepsDown*stepDown – lowerValidityDeltaAltitude).","paragraph_zero_based":218},{"literal_text_all_w_t_and_m_t":"referencePointLatitude","paragraph_zero_based":219},{"literal_text_all_w_t_and_m_t":"This field specifies the latitude for the reference point, expressed in the range of -90° , +90°, coded as a number between -224 and 224-1, coded in 2's complement binary on 25 bits. The relation between the latitude X in the range [90°, 90°] and the coded number N is:","paragraph_zero_based":220},{"literal_text_all_w_t_and_m_t":"N=X90∘224","paragraph_zero_based":221},{"literal_text_all_w_t_and_m_t":"where  denotes the greatest integer less than or equal to x (floor operator).","paragraph_zero_based":222},{"literal_text_all_w_t_and_m_t":"The reference point defines the northwest corner of the grid point array.","paragraph_zero_based":223},{"literal_text_all_w_t_and_m_t":"referencePointLongitude","paragraph_zero_based":224},{"literal_text_all_w_t_and_m_t":"This field specifies the longitude for the reference point, expressed in the range -180°, +180°, coded as a number between -225 and 225-1, coded in 2's complement binary on 26 bits. The relation between the longitude X in the range [-180°, 180°) and the coded number N is:","paragraph_zero_based":225},{"literal_text_all_w_t_and_m_t":"N=X180∘225","paragraph_zero_based":226},{"literal_text_all_w_t_and_m_t":"The reference point defines the northwest corner of the grid point array.","paragraph_zero_based":227},{"literal_text_all_w_t_and_m_t":"numberOfStepsSouth, numberOfStepsEast, numberOfStepsDown","paragraph_zero_based":228},{"literal_text_all_w_t_and_m_t":"These fields specify the number of steps for south, east and down direction respectively.","paragraph_zero_based":229},{"literal_text_all_w_t_and_m_t":"stepSouth, stepEast, stepDown","paragraph_zero_based":230},{"literal_text_all_w_t_and_m_t":"These fields specify the spacing of the grid points for south, east and down respectively. Enumerated values n1, n2, n3, n4, n5, n10, n20, n50, n100 correspond to 1, 2, 3, 4, 5, 10, 20, 50, 100 metres, respectively.","paragraph_zero_based":231},{"literal_text_all_w_t_and_m_t":"bitmaskOfGrids","paragraph_zero_based":232},{"literal_text_all_w_t_and_m_t":"This field specifies the availability of grid data at the horizontal grid points in the array and applies to all altitude layers of the grid. If a specific bit is enabled (set to '1'), the grid is available. Only the first (numberOfStepsSouth+1)×(numberOfStepsEast+1) bits are used, the remainder are set to '0'. Starting with the northwest corner of the array (top left on a north oriented map) the grid points are enumerated with row precedence – first row west to east, second row west to east, until last row west to east – ending with the southeast corner of the array. If the field is omitted all grid points are used and none omitted.","paragraph_zero_based":233},{"literal_text_all_w_t_and_m_t":"referenceAltitudeFine","paragraph_zero_based":234},{"literal_text_all_w_t_and_m_t":"If this field is present and","paragraph_zero_based":235},{"literal_text_all_w_t_and_m_t":"-the field referenceAltitudeCoarse is also present, it provides the fine resolution of the 3D grid altitude of the upmost layer, or","paragraph_zero_based":236},{"literal_text_all_w_t_and_m_t":"-the field referenceAltitudeCoarse is absent, it provides the altitude above ground level of the 2D grid,","paragraph_zero_based":237},{"literal_text_all_w_t_and_m_t":"with a scale factor of 1m.","paragraph_zero_based":238},{"literal_text_all_w_t_and_m_t":"If the field is absent, the default value is 0m.","paragraph_zero_based":239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"031803c101a10e427d1f230cc629e09e0bd01d184d1e2938f387ad803c3911dc","original_member_sha256":"2bae8d5ac03017cc49187eaa8fa5f66dd9d41d8add52aa40b5603598875c82af","paragraph_ElementTree_utf8_XML_sha256":["ddcd05781450b3866e2a8e8ab1e7810ca5b3e188a5ac83f063d13c5f5488eefa","bdf714519d94ea0a4a954eb3220a1fec360da73503b84a12d28afa41cc2ee822","55c80b5e431eafac8fad9e763f79c3362355e0602f2b6997c1d4fa90ac73425a","4c5a6f4d68960fcb5a4099c4f6ce499894486b3a53b65d34a89d7c34750c2baf","760a40834d592f5651f0a188fd5b622b46c0a8ad4b65baa21e10419acb700682","ef071912d9b87c6a27e94b685ad57808c893a91145fbca74487ff4166ccb5bc3","53c992a4d61d5c67b23de7673b255fc4571942dd1c3d2f4b5f58cc37d673dd0f","678a6a5277a5246bd56e1e9c067792dd35d237eec1925fc06dc41997c6a3041b","51e3c20e61db2ea9928c788cb476f80ff6d14f21bd469378e2fcefdb8f5d0d71","d91724ab715e62e138029a79fcd3c50c476a6bedaf623587a9928b1f20951a2e","40d86614490d78bb3795026a89d0d83ae201e12f074e33cda0a84fa38d0f5379","9dc012c07c806dae3dd1e2d32a0aa586682680ceaf66c41f57b817dc38442f46","f1c8871fd6a6c7dc058d8707ce09e65f53