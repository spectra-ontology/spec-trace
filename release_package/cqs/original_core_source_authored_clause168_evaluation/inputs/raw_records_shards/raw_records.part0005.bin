{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports handover from E-UTRA/5GC to NR FDD FR2. ","paragraph_zero_based":3600},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3601},{"literal_text_all_w_t_and_m_t":"eutra-5GC-HO-ToNR-TDD-FR2","paragraph_zero_based":3602},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports handover from E-UTRA/5GC to NR TDD FR2-1.","paragraph_zero_based":3603},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3604},{"literal_text_all_w_t_and_m_t":"eutra-5GC-HO-ToNR-TDD-FR2-2","paragraph_zero_based":3605},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports handover from E-UTRA/5GC to NR TDD FR2-2.","paragraph_zero_based":3606},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3607},{"literal_text_all_w_t_and_m_t":"eutra-CGI-Reporting-ENDC","paragraph_zero_based":3608},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports Intra-RAT report CGI procedure when it is configured with (NG) EN-DC wherein either MN and SN have different DRX cycles, or on-duration configured by MN does not contain on-duration configured by SN if their DRX cycles are same.","paragraph_zero_based":3609},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3610},{"literal_text_all_w_t_and_m_t":"eutra-CGI-Reporting-NEDC","paragraph_zero_based":3611},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports acquisition of relevant information from a neighbouring E-UTRA cell by reading the SI of the neighbouring cell and reporting the acquired information to the network when the NE-DC is configured.","paragraph_zero_based":3612},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3613},{"literal_text_all_w_t_and_m_t":"eutra-EPC-HO-ToNR-FDD-FR1","paragraph_zero_based":3614},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports handover from E-UTRA/EPC to NR FDD FR1. ","paragraph_zero_based":3615},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3616},{"literal_text_all_w_t_and_m_t":"eutra-EPC-HO-ToNR-TDD-FR1","paragraph_zero_based":3617},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports handover from E-UTRA/EPC to NR TDD FR1. ","paragraph_zero_based":3618},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3619},{"literal_text_all_w_t_and_m_t":"eutra-EPC-HO-ToNR-FDD-FR2","paragraph_zero_based":3620},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports handover from E-UTRA/EPC to NR FDD FR2. ","paragraph_zero_based":3621},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3622},{"literal_text_all_w_t_and_m_t":"eutra-EPC-HO-ToNR-TDD-FR2","paragraph_zero_based":3623}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["23e314b5e555f015d52ce534a3f37f1efc55eda4603dcc072f0afd1dcaa84d10","5a88ef82eee91e2d7c2cb0ae05ed48ee258432224f9dd64c7310ce4802de647e","623ad06df1f61d3bf338a081074710b9f0d5d601df5d7bbedba262048887f197","5664fd2f39afee66131d36d32eac7a93ae4df2325d5794eedd374c65442f93f6","1959fde840f0399d06b7b4e68ff6ef2011652adf7f758add1f1d97d89e798a36","62c0e79ee4854b23c49e93c6cd82a640ec1ad0c5bc50798886ed43065cec4153","8d2a6ec6fe29741c72692fd77b9f00404283d9e0c6e19cd45185644e2253df2f","1290689ce624b1e8e9740c7a20cdb39cf6797bce243e0fda2721d07db25e8ba0","5dd662906b2414248a79a10007168a1f262e925039028dad22d7692ca3f15db9","b137c0af9dab43038b7633c9b02125145596f340f43acb42a7c1f4a2ffdbbc6d","3b68481d4fc99c377db715e7810059a3c2660f3dece0b12452d763d00707c353","d93bcb53ea9d2d700d78346739b6c87afbf0423586e307c0