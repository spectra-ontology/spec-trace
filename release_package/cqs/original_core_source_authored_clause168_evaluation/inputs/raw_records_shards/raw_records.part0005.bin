{"fields":{"filename":"R2-2409048.zip::R2-2409048_CR on 38.306 for Correction on PHR for mTRP PUSCH repetition (R18).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":144},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":145},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":146},{"literal_text_all_w_t_and_m_t":"Yes (Incl FR2-2 DIFF)","paragraph_zero_based":147},{"literal_text_all_w_t_and_m_t":"directMCG-SCellActivationResume-r16, directMCG-SCellActivationResume-r17","paragraph_zero_based":148},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports direct NR MCG SCell activation, as specified in TS 38.321 [8], upon reception of an RRCResume message, as specified in TS 38.331 [9].","paragraph_zero_based":149},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":150},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":151},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":152},{"literal_text_all_w_t_and_m_t":"Yes (Incl FR2-2 DIFF)","paragraph_zero_based":153},{"literal_text_all_w_t_and_m_t":"delayStatusReport-r18","paragraph_zero_based":154},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports the delay status report of the buffered data as specified in TS 38.321 [8], TS 38.331 [9], TS 38.323 [16] and TS 38.322 [36].","paragraph_zero_based":155},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":156},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":157},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":158},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":159},{"literal_text_all_w_t_and_m_t":"directSCG-SCellActivation-r16, directSCG-SCellActivation-r17","paragraph_zero_based":160},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports direct NR SCG SCell activation, as specified in TS 38.321 [8], upon SCell addition and upon reconfiguration with sync of the SCG, both performed via an RRCReconfiguration message received via SRB3 or contained in an RRC(Connection)Reconfiguration message received via SRB1, as specified in TS 38.331 [9] and TS 36.331 [17].","paragraph_zero_based":161},{"literal_text_all_w_t_and_m_t":"A UE indicating support of directSCG-SCellActivation-r16 shall indicate support of EN-DC or support of NGEN-DC as specified in TS 36.331 [17] or support of NR-DC as specified in TS 38.331 [9].","paragraph_zero_based":162},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":163},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":164},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":165},{"literal_text_all_w_t_and_m_t":"Yes (Incl FR2-2 DIFF)","paragraph_zero_based":166},{"literal_text_all_w_t_and_m_t":"directSCG-SCellActivationResume-r16, directSCG-SCellActivationResume-r17","paragraph_zero_based":167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"4495a7d323453d2fb59c658e702b60f42d86f6325ecde37c1f1347fed1b371dc","original_member_sha256":"bb67c4ce90f1f4c0d2f5bba43fbf139e47fca6fb324e52e44bcf258d1775c74e","paragraph_ElementTree_utf8_XML_sha256":["7c8042e1a427a84f994680dfb73e6985b102ccf08d00f7529f1c150f1acfb0d7","d09a69f85eeaa5e37315b145b874ff444ad1e91721c67ccf82cf6829eb996b25","f5c8a9e3e1fc214da3b2d06e4f6cd90aa5b998db46cd322275ad4df416bc35b8","93c886c9819fe9716d101086d29d512cf099740c8abd5223680d75fb6e987158","591ea7d98d05aa59783617058e5b28d1a97f9555180e40271803eed801f4b96e","7d322d29e5eb8f8879d88c93ccfed078aa874210bd39f5cc82a861d05ff2cb43","d86790170f8c15e9cb6b7aef1f2916fb0e79b4e82e37412d3151702e857ae429","200b9110bf640d1e461a0926436551f93bb12cb37a4ca4d6854406831ac54a0b","e659818da0f3c003f67db30864b65cd0ba644408e2a43ddf56671441632d4031","b64757b44521638b694cefc8efb4293e76af56a8e8861206e26ae561f399a733","c2fe04dc7ba0d9e61e78a823fe931ed4996b000cf1624afc7bc05171e327acbe","51b1d93481c77a74832f2c74b0d5fcc1bf63ae90c28a691d6fc4e98aa75c5d69","92cc4adf15eca130fefe183abae062241b3d3c3996eac0ff99b333e8bd779abb","e012add5188ad6acdeb795665c52994a9132e3600fa8e9bf9d697b0b1e1a2736","12c7a6443ad5bb2cd483d41f82a8ddbd9019b9e88e56587110deae362fe45b91","d8a669b0ca43837b57e706caf73d4b8a4a616b206be86b7232606cfca519bc1b","635401ca29480686131a5e47ebd88ad0b70445bb14703138720066451e58b4a4","a07da711f704e7e2b30e48453b1bf16720077972bcf44b1ab4e40b6f1259dc0c","329e90eea0e4fec332895aea0ecb9db730f684d3dcd54f8fe01ede96b61152cb","e7bbea4ab3a253f0b45a48d7fca07d1a452a0b0048178e18ef0738280c434e5d","e4d0863de85a5ca57b6f03343b25cc5871fedfb5a97101c5dffe9a210084e35e","bc59cb1a29352b4406e92c58295673965e368cb534aadc41a9c06acabbab51ef","9ca6e11dd31fbefae9b9eb5362bdfcba4453d153cabc59b5c7e46f7595f359cc","52835cae751822a80e200749fe711396b3bccda6b93583c07d5c7b0d1d823c5a"],"paragraph_range_zero_based":[144,167],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2409048.zip::R2-2409048_CR on 38.306 for Correction on PHR for mTRP PUSCH repetition (R18).docx:p144"}
{"fields":{"filename":"R2-2409048.zip::R2-2409048_CR on 38.306 for Correction on PHR for mTRP PUSCH repetition (R18).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports direct NR SCG SCell activation, as specified in TS 38.321 [8]:","paragraph_zero_based":168},{"literal_text_all_w_t_and_m_t":"-upon reception of an RRCReconfiguration included in an RRCConnectionResume message, as specified in TS 38.331 [9] and TS 36.331 [17], if the UE indicates support of EN-DC or NGEN-DC, and support of resumeWithSCG-Config-r16 as specified in TS 36.331 [17],","paragraph_zero_based":169},{"literal_text_all_w_t_and_m_t":"-upon reception of an RRCReconfiguration included in an RRCResume message, as specified in TS 38.331 [9], if the UE indicates support of NR-DC and of resumeWithSCG-Config-r16 as specified in TS 38.331 [9].","paragraph_zero_based":170},{"literal_text_all_w_t_and_m_t":"A UE indicating support of directSCG-SCellActivationResume-r16 shall indicate support of EN-DC or NGEN-DC and support of resumeWithSCG-Config-r16 as specified in TS 36.331 [17] or indicate support of NR-DC and of resumeWithSCG-Config-r16 as specified in TS 38.331 [9].","paragraph_zero_based":171},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":172},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":173},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":174},{"literal_text_all_w_t_and_m_t":"Yes (Incl FR2-2 DIFF)","paragraph_zero_based":175},{"literal_text_all_w_t_and_m_t":"drx-Adaptation-r16, drx-Adaptation-r17","paragraph_zero_based":176},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports DRX adaptation comprised of the following functional components:","paragraph_zero_based":177},{"literal_text_all_w_t_and_m_t":"-Configured ps-Offset for the detection of DCI format 2_6 with CRC scrambling by ps-RNTI and reported MinTimeGap or MinTimeGapFR2-2 before the start of drx-onDurationTimer of Long DRX","paragraph_zero_based":178},{"literal_text_all_w_t_and_m_t":"-Indication of UE whether or not to start drx-onDurationTimer for the next Long DRX cycle by detection of DCI format 2_6","paragraph_zero_based":179},{"literal_text_all_w_t_and_m_t":"-Configured UE wakeup or not when DCI format 2_6 is not detected at all monitoring occasions outside Active Time","paragraph_zero_based":180},{"literal_text_all_w_t_and_m_t":"-Configured periodic CSI report apart from L1-RSRP (ps-TransmitOtherPeriodicCSI) when impacted by DCI format 2_6 that drx-onDurationTimer does not start for the next Long DRX cycle","paragraph_zero_based":181},{"literal_text_all_w_t_and_m_t":"-Configured periodic L1-RSRP report (ps-TransmitPeriodicL1-RSRP) when impacted by DCI format 2_6 that drx-onDurationTimer does not start for the next Long DRX cycle","paragraph_zero_based":182},{"literal_text_all_w_t_and_m_t":"The capability signalling includes the minimum time gap between the end of the slot of last DCI format 2_6 monitoring occasion and the beginning of the slot where the UE would start the drx-onDurationTimer of Long DRX for each SCS. The value sl1 indicates 1 slot. The value sl2 indicates 2 slots, and so on. Support of this feature is reported for licensed and unlicensed bands, respectively. When drx-Adaptation-r16 is reported, either of sharedSpectrumChAccess-r16 or non-SharedSpectrumChAccess-r16 shall be reported, at least. When drx-Adaptation-r17 is reported, either of sharedSpectrumChAccess-r17 or non-SharedSpectrumChAccess-r17 shall be reported, at least.","paragraph_zero_based":183},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":184},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":185},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":186},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":187},{"literal_text_all_w_t_and_m_t":"(Incl FR2-2 DIFF)","paragraph_zero_based":188},{"literal_text_all_w_t_and_m_t":"enhancedSkipUplinkTxConfigured-r16","paragraph_zero_based":189},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports skipping UL transmission for a configured uplink grant only if no data is available for transmission and no UCI is multiplexed on the corresponding PUSCH of the uplink grant as specified in TS 38.321 [8].","paragraph_zero_based":190},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"4495a7d323453d2fb59c658e702b60f42d86f6325ecde37c1f1347fed1b371dc","original_member_sha256":"bb67c4ce90f1f4c0d2f5bba43fbf139e47fca6fb324e52e44bcf258d1775c74e","paragraph_ElementTree_utf8_XML_sha256":["cfb7862d4798e53b9014bede0780cb6ccb8c84f1de54b4b79271634918c1cbb4","0b66936b8703c33b950b585d4e108801174859332b554bbddf078da685d6f134","10a84d8c2e7bedd569e7ff47e862e7306a7e65687f2a54017753fe5e8a0d5bf6","d57cf45ca1deba6e0a047e2931b182c84642cdf1df9532e5401691232ec7b8ab","6be80d7faf7181a59292155060e5bf3a2d798823c5e38d98dad534ff173bd53d","04a2508840b997a18f7113e58353abee580725290b221d92a56cbbd79f833315","02475541648da73f6e145ea90aed88c981d5785f09eb4ef1a3e6365ce79260e7","03e3206f71b1261ace7131739bc40748fdb1863c7b0dc85f57ee23eec154558b","219c02a7a2f9439e0a5454eea237a76b2ad4190650710cbe19c2444cb978ad17","d0a27cd26bdbecab9c06bfdb9d0c833ad64a84dd5296c7442c6fee609b2eb5eb","0e90ff818f4704831b07c87dc5e635ab6a4368611bbcfb590e2a0446759c7009","cfece36eb1451188698d46d9a33ceffbbffcee31f89c8c8531a1fa9e5a233e1e","1cb854ccf95c56b52f38fa6ff203980a32e5b48837dac63a247c1ed19161ca08","679587f03e892080009e7ff10830782e0ad752fe8f51c297e1da0eb4462cdd5a","977a843a14d7830b482fb95669b86ccb22be0605d33288a0e79c30f685761273","ed0afd4ef03e21fecece3861a20920042b092607e8f5ff7d52e06aa1e0b761f5","5584b2e53a99e5a088bb65576389a69d1465063216e7219e51f059e22fbfd194","441da801179185fe39dcc3607f1f1289965a1c5c55c3f80bbddf751ad94d2b90","e7b6e43f7b92c3660422c3f20f7b98db05763dbbedfc4a067ebc8937e511e69c","9b2abea637339c0f5213ac4ea1c7b5b13f7ff83b8820c48f66fd8b93d0126f5d","d257d07f462715d34b7b70d5d10c0613cf56e48426a656925955da3b06649cce","a92d6d0bb7cde3d2cf526ac2dbaeb2f17114f239ac9a948ea40de9bdd935fdb6","8db2b1c04eaec413619dd854e5486a871f7075c6f1b5bc8524e59f2b0d4751e6","21a36655c14004ff9a0a9bb7e7f3186f8279ece51d87859ad4f91c4d9a09b32a"],"paragraph_range_zero_based":[168,191],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2409048.zip::R2-2409048_CR on 38.306 for Correction on PHR for mTRP PUSCH repetition (R18).docx:p168"}
{"fields":{"filename":"R2-2409048.zip::R2-2409048_CR on 38.306 for Correction on PHR for mTRP PUSCH repetition (R18).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":192},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":193},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":194},{"literal_text_all_w_t_and_m_t":"enhancedSkipUplinkTxDynamic-r16","paragraph_zero_based":195},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports skipping UL transmission for an uplink grant addressed to a C-RNTI only if no data is available for transmission and no UCI is multiplexed on the corresponding PUSCH of the uplink grant as specified in TS 38.321 [8].","paragraph_zero_based":196},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":197},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":198},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":199},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":200},{"literal_text_all_w_t_and_m_t":"enhancedUuDRX-forSidelink-r17","paragraph_zero_based":201},{"literal_text_all_w_t_and_m_t":"Indicates whether UE supports sidelink related Uu-DRX mechanisms for PDCCH monitoring. This field is only applicable if the UE supports sl-TransmissionMode1-r16.","paragraph_zero_based":202},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":203},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":204},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":205},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":206},{"literal_text_all_w_t_and_m_t":"extendedDRX-CycleInactive-r17","paragraph_zero_based":207},{"literal_text_all_w_t_and_m_t":"Indicates whether UE supports the extended DRX in RRC_INACTIVE with values of 256, 512 and 1024 radio frames as specified in TS 38.331 [9]. The UE may indicate support for extended DRX in RRC_INACTIVE only if it supports extended DRX in RRC_IDLE.","paragraph_zero_based":208},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":209},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":210},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":211},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":212},{"literal_text_all_w_t_and_m_t":"extendedDRX-CycleInactive-r18","paragraph_zero_based":213},{"literal_text_all_w_t_and_m_t":"Indicates whether UE supports the extended DRX in RRC_INACTIVE with values above 1024 radio frames as specified in TS 38.331 [9] and TS 38.304 [21]. The UE may indicate support of this capability only if it supports extended DRX in RRC_IDLE.","paragraph_zero_based":214},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"4495a7d323453d2fb59c658e702b60f42d86f6325ecde37c1f1347fed1b371dc","original_member_sha256":"bb67c4ce90f1f4c0d2f5bba43fbf139e47fca6fb324e52e44bcf258d1775c74e","paragraph_ElementTree_utf8_XML_sha256":["eafafd78d32146c256a8f0d5354652bf565b4eb5a2dceed58933f0c7ddf73e21","324b7b9d8053d34289f53ed771d75e00b5e035e50bb8e8501235e9555af29bdd","c5317398404086adcf3d075ac899891606abe0c4e9e02dad24b21c6e1a9b9ea8","feb64564bf940ceb35ba2735cb588c972d696d29edcbbee68c4224586b457e3f","8d82298892f72ebf1607c9d942eccbc51e887d21ed4d37a0363a5891caeabc4e","d064b8d168fb1ef293d96a885f5c084858ff03aa04d54a124ba6a8d71ba6365c","431d283620410f3b19129d8de6c22dda58be08ca0c2297a91a4e6e64a848e9e9","58a6b0ca827024f084ee9c0a35b6666eb9bd9577091e9d5a07fdef0e3dba0ddb","a755cfe547e4420fc95d4993f86fd069e2178fdde736388bfcc23aa52b1c802b","9229f0bfc0b5576d239f9f0bfeac8d198f34eb1a10380d9f624950765778f46f","0f8eb5a73b918535b4609822514c3ef7747d1bf32e44065046bcad35b7713a5b","17c9912fc0d5c40986a6cb0a4ccdae853056d65203e12d4597c3e3909abd1b08","fe80e092dd3c2331b878bbb4e37c6bf6bd31b36e2b0bcd8fb92e7ce16d47bddc",