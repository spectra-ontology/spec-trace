{"fields":{"filename":"R2-2408369.zip::R2-2408369.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"If eventID-TSS is present in SIB9, this field is mandatory present in the PLMN-IdentityInfo IE of PLMN-IdentityInfoList in SIB1. Otherwise, the field is optionally present, Need R.","paragraph_zero_based":552},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":553}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"d66ee83a11e596eb14b64f5886ad9a1363953496b37c5b7ad109af3e6b319447","original_member_sha256":"c496036bf0449256be5ad57c73f5bba9639937fda10ca8d81b5a96b75aefbfc7","paragraph_ElementTree_utf8_XML_sha256":["7d26fa657373e5e10530ce53658cfd141aa548ee28524ba3cc31c515a3a52875","a6657254d887827bb957245f30beb4a6bf20c3ccbfe4c6171beb854b08f4268a"],"paragraph_range_zero_based":[552,553],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2408369.zip::R2-2408369.docx:p552"}
