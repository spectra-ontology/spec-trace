w_t_and_m_t":"CipheringKeyData-r15 ::= SEQUENCE {","paragraph_zero_based":139},{"literal_text_all_w_t_and_m_t":"cipherSetID-r15 INTEGER (0..65535),","paragraph_zero_based":140},{"literal_text_all_w_t_and_m_t":"d0-r15 BIT STRING (SIZE (1..128)),","paragraph_zero_based":141},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":142},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"0e6c32bda25412abb0b58d77181616769d56eae3160cba0d5632b349b9bf7fd4","original_member_sha256":"d85cab2cb82621072a7cb69f1bacdd57619bf18e8ecc115ef77254675e737d67","paragraph_ElementTree_utf8_XML_sha256":["09696b54939497a8ca2ba620420c03c7479c8446d64fb680ae1962b6d211066f","c002616492b1923e46d6fa95a25dac7944411eca88ccdcee2199f265ed726678","d02e8cbd697ae1810074c3012247d88e70339f7889a7482c352e21eca4a8f878","3ff51b52463a7f6da30fc5a8c9ec1a7bf7431f765f14f2ad8a3d95d7d02d3c4e","420bd302ffd10098ecf5cbe1ea0c5bd381747f411b1b1f19ada2658126228c0c","c7e1d1fd9fc653d0fa1beeb39d176f11a3c65cc165923165c3e018ec62cb27db","29f4caf7e4dd0dd8b8ef0e6bc2960d2012ef940b54236288f64bfc2795199e2b","9478ba6287200d5920a0a821e406e2cca53760391b32971ab943f69a63123d6d","1a918dc76703afd4dc8c29d6b19cf37607e102811b9e864d508b1f9a9decb472","cd3be273e5c49dfb08391ce5a6b60b66c4b697f7d7b5432bd6ec65184e27add7","b690f50974c88531c38c8ce2e843fd4fadd130f47a76855376a719ee64251f7d","26673208eff71b60467d9f5587bce7dcd4cf56f72175a8b00314f12c71e58501","4f62ae47fe6a4cd558c35d3ec3e0fde2051e03b2529f4f4d48f9b8f170d4ff39","b7811f113e9a17a828032393fa39ec3591054ee89f5d36dc2d3aea2a6cbc62f3","cdf39d229e4e3dbdc1a6cc15b20b0b18ed77cfa2a0aa24d3bae524c669e41f43","4ac455a2a4b4078dcf5a2adbceb8cde8945a12679951bc96bf5b66561dcbca1d","6ee60604de0716b84d5589fdf011466d707cf9f15a3bbcc89e200010fae64a52","52e28d5f4b45eb580d324b805ead2405f09f5cf0408ed72aeb5d3c65b786885b","46fcb154306af027a65b5399d376378a192605c367295e7653b64ff84d5ab014","27d93360e8aab6070e9e335f201df3b15e41584d22b790673e9b44be186d87b5","17de7964c5b3781154f55a46480d693fc9c9f7b31dffb8e836f0171f63b52683","ceeae2bb5a37c5a9c2cab7768d36ace3229c98568c85758f13ef3b60390f2540","a5fa3947f91d012ca9983e159bdcf031adc2620bc654b49400396a481a029545","e867178a8125c9aa884a1c9c80889a562ffc0d05310115ce64fced70f6d2be02"],"paragraph_range_zero_based":[120,143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2408776.zip::R2-2408776 Correction to the need code in AssistanceDataSIBelement-r17.docx:p120"}
{"fields":{"filename":"R2-2408776.zip::R2-2408776 Correction to the need code in AssistanceDataSIBelement-r17.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":144},{"literal_text_all_w_t_and_m_t":"SegmentationInfo-r15 ::= SEQUENCE {","paragraph_zero_based":145},{"literal_text_all_w_t_and_m_t":"segmentationOption-r15ENUMERATED {pseudo-seg, octet-string-seg},","paragraph_zero_based":146},{"literal_text_all_w_t_and_m_t":"assistanceDataSegmentType-r15ENUMERATED {notLastSegment, lastSegment},","paragraph_zero_based":147},{"literal_text_all_w_t_and_m_t":"assistanceDataSegmentNumber-r15INTEGER (0..63),","paragraph_zero_based":148},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":149},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":150},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":151},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":152},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":153},{"literal_text_all_w_t_and_m_t":"AssistanceDataSIBelement field descriptions","paragraph_zero_based":154},{"literal_text_all_w_t_and_m_t":"valueTag","paragraph_zero_based":155},{"literal_text_all_w_t_and_m_t":"This field is used to indicate to the target device any changes in the broadcast assistance data content. The valueTag is incremented by one, by the location server, every time a modified assistance data content is provided. This field is not included if the broadcast assistance data changes too frequently. If valueTag and expirationTime are absent, the UE assumes that the broadcast assistance data content changes at every broadcast interval.","paragraph_zero_based":156},{"literal_text_all_w_t_and_m_t":"expirationTime","paragraph_zero_based":157},{"literal_text_all_w_t_and_m_t":"This field indicates how long the broadcast assistance data content is valid. It is specified as UTC time and indicates when the broadcast assistance data content will expire. If the field is absent, the UE assumes that the received broadcast assistance data content is valid until update of the broadcast assistance data is received.","paragraph_zero_based":158},{"literal_text_all_w_t_and_m_t":"cipheringKeyData","paragraph_zero_based":159},{"literal_text_all_w_t_and_m_t":"If present, indicates that the assistanceDataElement octet string is ciphered.","paragraph_zero_based":160},{"literal_text_all_w_t_and_m_t":"segmentationInfo","paragraph_zero_based":161},{"literal_text_all_w_t_and_m_t":"If present, indicates that the assistanceDataElement is one of many segments.","paragraph_zero_based":162},{"literal_text_all_w_t_and_m_t":"assistanceDataElement","paragraph_zero_based":163},{"literal_text_all_w_t_and_m_t":"The assistanceDataElement OCTET STRING depends on the posSibType and is specified in Table 7.2-1. NOTE.","paragraph_zero_based":164},{"literal_text_all_w_t_and_m_t":"cipherSetID","paragraph_zero_based":165},{"literal_text_all_w_t_and_m_t":"This field identifies a cipher set comprising a cipher key value and the first component C0 of the initial counter C1.","paragraph_zero_based":166},{"literal_text_all_w_t_and_m_t":"d0","paragraph_zero_based":167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"0e6c32bda25412abb0b58d77181616769d56eae3160cba0d5632b349b9bf7fd4","original_member_sha256":"d85cab2cb82621072a7cb69f1bacdd57619bf18e8ecc115ef77254675e737d67","paragraph_ElementTree_utf8_XML_sha256":["2a7ff225cf6a5b79fdad1e6bfd2bf8c3d2a7c4ab5471d680c03683e120dfa2c8","2b9a8a327a2f18df3ea091853e3d2ad54d42a9255ff5b8ad2cd4c9bf59daa597","bce0c66b8296d2f1e56668fd4178cf3ec99bc2dd2f010301735f113ec22aa30b","76d83bdd3ff7dfe61187f35c9ac5b7d9c89a0cc50942e070a3bc22723cdeb061","bf746266342c23a12d950bfbb9bbbe0202517ff1de911218e907197f49a4bfc8","94edd840e1b9309cdbe8a658498f3ea285da324c60af821518efd00b16b8189d","713dfb99427e07dec20b14465d9bf48b86df717717e4b2c389833e89b77f7b65","1c22aef35c73d22632f7f47369f38473c5bc2ba131e074d16a12d3f5caf58f6c","d50ded754da36c1e117df96232f00c2a75923e355b24276f6236ef97aec02c9e","c6112c575d44c2bdaa2b7423e1d12bf23bb14e119ed7ffac87ec2a1956fbc7a0","8b56d5075ad4b171d0ec361691d9342e122c1e0d62e8718dae59569a3c072fcb","fa8508b9b78ed5ac116d10997548979070f48bf6c23e1ff10306b4f3c7c27810","8fad356bfe9527880e093def50fdd8ccbed3ade6eedc8486ca6042899801dfde","ac7c5f6a6c74dfbc0a48d568f12981f9f4997aa362c8a7ccef88038fa31f5c0b","fc0eed0ab1fd6256e388b62ee4a57e27b66c08f82dcad2191d74e798d6e0cdda","93b2eb5445f4842982e009034489c41de54d3b61272b2515b26aa12afe3af17c","651a0b9829bab458a7d249757df4823748b916dfb1fca3a3d53e3667402c13a2","4f50bcae1131577f23b3d7e8443036a2fd13e7bffde20375850e1cb27867af18","f922fad9c1efecccc0826b45ec7a247f3046b7f3ba933bbc446c300eee823860","f7a5c16e91fa1753bf20d387bd1b000a3ef38bda5103fa89500c89a0cb3dd4a3","2bd0793a4c65ea964d67fb7a87f8bf09b84afb1bebecc144ca097025d5710d56","f898728c7a20ea6ab072bd7e7d16bf96f3f1a2774fa6f99c31f4842a391162ba","2f59e4f6d2ba08b000cc17ef7aa3b0a33ed19ac6bacbdf8ad27cce0e49731a90","4d2e8bf15e1a81cb14ffcf151bc77dd8dd1a81828c5f5c80fa699686eb8775df"],"paragraph_range_zero_based":[144,167],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2408776.zip::R2-2408776 Correction to the need code in AssistanceDataSIBelement-r17.docx:p144"}
{"fields":{"filename":"R2-2408776.zip::R2-2408776 Correction to the need code in AssistanceDataSIBelement-r17.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field provides the second component for the initial ciphering counter C1. This field is defined as a bit string with a length of 1 to 128 bits. A target device first pads out the bit string if less than 128 bits with zeroes in least significant bit positions to achieve 128 bits. C1 is then obtained from D0 and C0 (defined by the cipherSetID) as:","paragraph_zero_based":168},{"literal_text_all_w_t_and_m_t":"C1 = (D0 + C0) mod 2128 (with all values treated as non-negative integers).","paragraph_zero_based":169},{"literal_text_all_w_t_and_m_t":"segmentationOption","paragraph_zero_based":170},{"literal_text_all_w_t_and_m_t":"Indicates the used segmentation option. ","paragraph_zero_based":171},{"literal_text_all_w_t_and_m_t":"assistanceDataSegmentType","paragraph_zero_based":172},{"literal_text_all_w_t_and_m_t":"Indicates whether the included assistanceDataElement segment is the last segment or not.","paragraph_zero_based":173},{"literal_text_all_w_t_and_m_t":"assistanceDataSegmentNumber","paragraph_zero_based":174},{"literal_text_all_w_t_and_m_t":"Segment number of the assistanceDataElement segment. A segment number of zero corresponds to the first segment, one corresponds to the second segment, and so on. Segments numbers wraparound should there be more than 64 segments","paragraph_zero_based":175},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":176},{"literal_text_all_w_t_and_m_t":"NOTE: For example, if the posSibType in IE PosSIB-Type defined in TS 36.331 [12] indicates 'posSibType1-7', the assistanceDataElement OCTET STRING includes the LPP IE GNSSRTKAuxiliaryStationData.","paragraph_zero_based":177},{"literal_text_all_w_t_and_m_t":"========================================CHANGE ENDS================================","paragraph_zero_based":178}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"0e6c32bda25412abb0b58d77181616769d56eae3160cba0d5632b349b9bf7fd4","original_member_sha256":"d85cab2cb82621072a7cb69f1bacdd57619bf18e8ecc115ef77254675e737d67","paragraph_ElementTree_utf8_XML_sha256":["5566b9dc4d46e1649c667953fb3af6c3d38431ad6c9d19093e44c852f0467a5c","aaf25f70014b683f44fe086c098b0e574440d1e6c667124870070eb79e196ba4","640ce0206b773ab739ebc62b229da20ea44f445ebaeec5b06d4c39a9379dd626","f61cfdfa4737034b3e2dadac63191b4b2404dc0f1c0718c7c7b0321272d6c116","a792273d74ab5e49e3e9236f45977a7265fd21f50bd3b385d704c1fd8d1223dd","59ef31f3d8ae3018ee71b6a4ed05e650a23ae7d7b090c0c9f1a89cf138af55cd","cde5bfc2f83dd88fac3ac8eb8a247989f8b16202124e57c3e41a2f5cc73b065b","840693fb482c6a94e80c6482d402fc74a2e0e5564e772f38c0481879502b835d","e389a93ba15b251f3dd07432df1c7afed42f6c908bcb57329919db369f5788d3","af664ab4b5a88101a8b1b8b93dd56a9608599f2242697c51d33533b0393810b6","88ee62a4756c1e4512f1d67134a9bdba46d283c956f8ed940a2c610a78e888bb"],"paragraph_range_zero_based":[168,178],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2408776.zip::R2-2408776 Correction to the need code in AssistanceDataSIBelement-r17.docx:p168"}
