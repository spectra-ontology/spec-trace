_based":48859},{"literal_text_all_w_t_and_m_t":"6.3.6MBS information elements","paragraph_zero_based":48860},{"literal_text_all_w_t_and_m_t":"–CarrierFreqListMBS","paragraph_zero_based":48861},{"literal_text_all_w_t_and_m_t":"The IE CarrierFreqListMBS is used to inform network of the frequencies on which the UE is receiving or interested to receive MBS broadcast service via a broadcast MRB.","paragraph_zero_based":48862},{"literal_text_all_w_t_and_m_t":"CarrierFreqListMBS information element","paragraph_zero_based":48863}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["00e6c95bd89920373ac6d704168d54c465ca9afd80cc3b3e990d0c93154a5e91","3234fa4c27394e5571fc7157ad1f8197ab6b380bfa3f418109c140a0f61b7aa6","f9f4c6e631beb9bbdc86c285058f1c6bbf9e9f923e523bbcd60c52f18c965c3f","49adf4a0ec3425cd3572a6fc7ab7108f08153e840b9d14ce0d2851a0b4f7c373","76460ec0abaec9e42775e0d569aaf3d088dfef5496d5d60a9ce3eedb0a8fd704","fc7c7921f1b69b0d3dd258b1f98b02eae7062f01deb03a752e90e7deb830bdf6","b7a6e97b4a6faa35cd70d9f43082cdcb45a7c103186e38a9c20ad08bcd45baef","5ce1a09f28ef982712a000aaeb3601dc94ad00c9c03e5515c4daf96ea62ea403","06a559540b32091863fdffd9cb2aae1f8fafc9c32ff8a0b4d9c46a3529c19245","c211affec82333c296c371ecce00522b6bb0711a06d87a6dc71789c2f0ffeb16","bc60597bd253862a37bc9094e623d0637872a4c19889869affcecff44196387f","6da97ade5bae649e0f52c9dcd937e9539f4f91ed574d8e19f9c9fb1a33eb95ba","e4218110b597ce357095ecb19c9abfa559566aaf600cb591e3579ab2664a594e","4448d34ca285942d97fb8b270a8d117af171ebb2593aa7e8cca01e594a841e5b","a72f9150ee8e994ce10c8d52232c62bc88c6c882a67c420cfc57f239f83cb9df","a979a0fff848b3b2678302eb4d9c07de5cf857d0f6dc889a28334c6ce3ecb84e","0c64c08bb9ebbff585e2c8e081bb884654a1d36bc9e7ce