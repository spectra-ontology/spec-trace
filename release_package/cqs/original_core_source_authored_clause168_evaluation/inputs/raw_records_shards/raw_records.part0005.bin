{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"minOffset","paragraph_zero_based":5688},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need R, if minSchedulingOffsetPreferenceConfig-r16 is setup; otherwise it is absent, need R.","paragraph_zero_based":5689},{"literal_text_all_w_t_and_m_t":"musimGapConfig","paragraph_zero_based":5690},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need R, if musim-GapAssistanceConfig-r17 is setup; otherwise it is absent, need R.","paragraph_zero_based":5691},{"literal_text_all_w_t_and_m_t":"SCG","paragraph_zero_based":5692},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need M, in an RRCReconfiguration message not within mrdc-SecondaryCellGroup and received, either via SRB3 within DLInformationTransferMRDC or via SRB1. Otherwise, it is absent.","paragraph_zero_based":5693},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5694},{"literal_text_all_w_t_and_m_t":"NEXT CHANGE","paragraph_zero_based":5695},{"literal_text_all_w_t_and_m_t":"6.4RRC multiplicity and type constraint values","paragraph_zero_based":5696},{"literal_text_all_w_t_and_m_t":"–Multiplicity and type constraint definitions","paragraph_zero_based":5697},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":5698},{"literal_text_all_w_t_and_m_t":"-- TAG-MULTIPLICITY-AND-TYPE-CONSTRAINT-DEFINITIONS-START","paragraph_zero_based":5699},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5700},{"literal_text_all_w_t_and_m_t":"maxFFS                                  INTEGER ::= 999     -- Maximum value is FFS","paragraph_zero_based":5701},{"literal_text_all_w_t_and_m_t":"maxAdditionalRACH-r17                   INTEGER ::= 256     -- Maximum number of additional RACH configurations.","paragraph_zero_based":5702},{"litera