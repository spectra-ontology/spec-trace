original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47376},{"literal_text_all_w_t_and_m_t":"SL-PRS-PowerControl-r18::= SEQUENCE {","paragraph_zero_based":47377},{"literal_text_all_w_t_and_m_t":"    dl-P0-SL-PRS-r18           INTEGER(-202..24)                                                                 OPTIONAL,   -- Need M","paragraph_zero_based":47378},{"literal_text_all_w_t_and_m_t":"    dl-Alpha-SL-PRS-r18        ENUMERATED {alpha0, alpha04, alpha05, alpha06, alpha07, alpha08, alpha09, alpha1} OPTIONAL,   -- Need M","paragraph_zero_based":47379},{"literal_text_all_w_t_and_m_t":"    sl-P0-SL-PRS-r18           INTEGER(-202..24)                                                                 OPTIONAL,   -- Need M","paragraph_zero_based":47380},{"literal_text_all_w_t_and_m_t":"    sl-Alpha-SL-PRS-r18        ENUMERATED {alpha0, alpha04, alpha05, alpha06, alpha07, alpha08, alpha09, alpha1} OPTIONAL    -- Need S","paragraph_zero_based":47381},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":47382},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47383},{"literal_text_all_w_t_and_m_t":"SL-TxPercentageDedicatedSL-PRS-RP-Config-r18::= SEQUENCE {","paragraph_zero_based":47384},{"literal_text_all_w_t_and_m_t":"    sl-TxPercentageDedicatedSL-PRS-RP-r18           INTEGER (1..8)                                               OPTIONAL,   -- Need M","paragraph_zero_based":47385},{"literal_text_all_w_t_and_m_t":"    sl-Priority-DedicatedSL-PRS-RP                  ENUMERATED {p20, p35, p50}                                   OPTIONAL    -- Need M","paragraph_zero_based":47386},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":47387},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47388},{"literal_text_all_w_t_and_m_t":"SL-PriorityTxConfigIndexDedicatedSL-PRS-RP-r18 ::= SEQUENCE {","paragraph_zero_based":47389},{"literal_text_all_w_t_and_m_t":"    sl-PriorityThresholdDedicatedSL-PRS-RP-r18         INTEGER (1..8)                                             OPTIONAL,   -- Need M","paragraph_zero_based":47390},{"literal_text_all_w_t_and_m_t":"    sl-DefaultTxConfigIndexDedicatedSL-PRS-RP-r18      INTEGER (0..maxCBR-LevelDedSL-PRS-1-r18)                   OPTIONAL,   -- Need M","paragraph_zero_based":47391},{"literal_text_all_w_t_and_m_t":"    sl-CBR-ConfigIndexDedicatedSL-PRS-RP-r18           INTEGER (0..maxCBR-ConfigDedSL-PRS-1-r18)                  OPTIONAL,   -- Need M","paragraph_zero_based":47392},{"literal_text_all_w_t_and_m_t":"    sl-PRS-TxConfigIndexList-r18                       SEQUENCE (SIZE (1.. maxCBR-LevelDedSL-PRS-1-r18)) OF SL-PRS-TxConfigIndex-r18","paragraph_zero_based":47393},{"literal_text_all_w_t_and_m_t":"                                                                                                                  OPTIONAL    -- Need M","paragraph_zero_based":47394},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":47395},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47396},{"literal_text_all_w_t_and_m_t":"SL-PRS-TxConfigIndex-r18 ::=    INTEGER (0.. maxNrofSL-PRS-TxConfig-r18)","paragraph_zero_based":47397},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47398},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-PRS-RESOURCEPOOL-STOP","paragraph_zero_based":47399}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["0b94840a3dc8605694677d77ed01e48045b7dda693912c44223480c8836a7ba8","0253e654f2cdba23bb434ed4048816a4bb64eb717529313e3ae2de3a4b14988d","dd3fbd9784015bfda71dcbd8797058eb5865fa9a4b1460415689b23c438c2335","42b572599ddafd653d9f5373a389b7bb8a341ce35bd3515168d61e77259ff7fe","468e89a9a4926f37712f36e9eb227188a0e9cc78f0ac301f7a4f7d4763e30b34","24c901c0495ebdb176c0e02045c344d1f07a3b0f678b1c138f1731d6c8e0fe74","3d2df29bf7802ab933e5ee2702423b8363b500970204288a10f05ff161e699aa","be1dc2d5d9edb64d609c7a4ff51d41c4b791ae1825c713942c88fc2edb514e5f","13465543de70f529d5ccb094f1e36e5c7da90645ab01fc8c99ac467cdf2bdc90","4237cbb5574ed275080b7a35e2902448db9a176ea54eff27b951eed60dd058df","4a9e6b5d58f2cdc8d0265dab9c9f6df7339995ff335e2e456c20ebb366508b3c","f89eea7694d431633b9dd55c2be1dfe95cfaff82de1a437ecc82463b8b98966a","04d3a588d3ef12a8f52566da1e9bd570325a2baff338101dc45a8e8add3064d2","0cc6c41d7109c38896f2a007ca75e4fdca35be695d942e968a8e77ef412ea033","80ef8d01b44ec38da73cafe42d59e7040928b24765299444806908d932429672","fc8775237643ce8ca5fab504e1030d6d68de0be71c3babd722743171de473ef0","47b006657522d5762c3a8bb31ed3b2b8ebef97af0a0de17138b5c27389ad4167","23916750c46c8e6dfc4cd995b3bd56aa1523efb3a5866f4bb68963597860709c","d48bbde5e3d611455316d60c28df1984f1c2f820e2d8c8cb0eed3fb8534ff60a","fbd782e4761710747d96aabeafe1aaf731c1c297ec6ca584c96f44ddb908a194","62f8003fde0c95acbcc687bcbc1cbf902765faf1a35c6a44cde729bc51ee38e3","15faa0593c4d986ed07364a9dd8c6764e2b2cde89c5369bfb78f89cd3cba3e66","1c428e987683329a0144730ba8d0f0c9272378adf4ed99b9dab99a5b1757dfc0","69b2c5f8c98635b80377995fdd844b7185c5336e882e1ca999fe232b9505a1de"],"paragraph_range_zero_based":[47376,47399],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p47376"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":47400},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47401},{"literal_text_all_w_t_and_m_t":"SL-PRS-ResourcePool field descriptions","paragraph_zero_based":47402},{"literal_text_all_w_t_and_m_t":"sl-CBR-ConfigIndexDedicatedSL-PRS-RP","paragraph_zero_based":47403},{"literal_text_all_w_t_and_m_t":"Indicates the CBR ranges to be used by an index to the entry of the CBR range configuration in sl-CBR-RangeConfigList-Dedicated-SL-PRS-RP.","paragraph_zero_based":47404},{"literal_text_all_w_t_and_m_t":"sl-CBR-PriorityTxConfigDedicatedSL-PRS-RP-List","paragraph_zero_based":47405},{"literal_text_all_w_t_and_m_t":"Indicates the mapping between SL-PRS transmission parameter (such as transmission power, etc.) sets by using the indexes of the configurations","paragraph_zero_based":47406},{"literal_text_all_w_t_and_m_t":"in sl-CBR-SL-PRS-TxConfigList, CBR ranges by using the indexes to the entry of the CBR range configurations in sl-CBR-SL-PRS-RangeConfigList, and priority ranges. It also indicates the default SL-PRS transmission parameters to be used when CBR measurement results are not available.","paragraph_zero_based":47407},{"literal_text_all_w_t_and_m_t":"sl-DefaultTxConfigIndexDedicatedSL-PRS-RP","paragraph_zero_based":47408},{"literal_text_all_w_t_and_m_t":"Indicates the SL PRS transmission parameters to be used by the UEs which do not have available CBR measurement results, by means of an index to the corresponding entry in sl-PRS-TxConfigIndexList. Value 0 indicates the first entry in sl-PRS-Tx-ConfigIndexList. The field is ignored if the UE has available CBR measurement results.","paragraph_zero_based":47409},{"literal_text_all_w_t_and_m_t":"sl-FilterCoefficient","paragraph_zero_based":47410},{"literal_text_all_w_t_and_m_t":"This field indicates the filtering coefficient for long-term measurement and reference signal power derivation used for sidelink open-loop power control.","paragraph_zero_based":47411},{"literal_text_all_w_t_and_m_t":"sl-MaxNumPerReserveDedicatedSL-PRS-RP","paragraph_zero_based":47412},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of SL PRS reservations that can be indicated by an SCI.","paragraph_zero_based":47413},{"literal_text_all_w_t_and_m_t":"sl-NumReservedBitsSCI1B-DedicatedSL-PRS-RP","paragraph_zero_based":47414},{"literal_text_all_w_t_and_m_t":"Indicates the number of reserved bits in SCI format 1-B.","paragraph_zero_based":47415},{"literal_text_all_w_t_and_m_t":"sl-NumSubchannelDedicatedSL-PRS-RP","paragraph_zero_based":47416},{"literal_text_all_w_t_and_m_t":"Indicates the number of subchannels in the corresponding resource pool, which consists of contiguous PRBs only.","paragraph_zero_based":47417},{"literal_text_all_w_t_and_m_t":"sl-PosAllowedResourceSelectionConfig","paragraph_zero_based":47418},{"literal_text_all_w_t_and_m_t":"Indicates allowed resource allocation method configured per resource pool.","paragraph_zero_based":47419},{"literal_text_all_w_t_and_m_t":"C1: only sensing allowed","paragraph_zero_based":47420},{"literal_text_all_w_t_and_m_t":"c2: only random resource selection allowed","paragraph_zero_based":47421},{"literal_text_all_w_t_and_m_t":"c3: sensing and random resource selection allowed","paragraph_zero_based":47422},{"literal_text_all_w_t_and_m_t":"sl-PriorityThreshold","paragraph_zero_based":47423}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["6cbf40b184159dd0bbfd4d8ec74feac34f8f25f4ba2f30c6ab0d442fd56ea987","4cb28f8bd5385f5ba483d64f23617d5959f4dc5ea838f9f0956b5d4ea602fce5","a70c1cbb88e6f72b1cfda751160ae277134ed727b48460d3c76d0dd9eadbd244","d4269a3fbbafe67876c0bd6fd0dc1b1f44edf0222c08f4ed7b606c8d26a167d6","9f45f3703614fe90db6249e77f78c0b7955d0444209a903cea70941317375567","2f8ecf2eea34e40b6ed17ef7e106ea2d24f2a83f26d5a01a05e0b2ab1cde169e","281fd4c363e4ea3e33af2174928ccc5dbebe3a0814cfb97fb841f773cff59aed","8c2cf24f54eb010b76dc043b7ec163c31e80158752553c905940589ff2613464","2d0a0c3a179bc0134592b719218032a3664a241f1f096cc1989869a1158be22e","764423bd90d6e9d1136d0d11b7b258062265559d4411af3bc1986bbf50c500e0","b8379e2b176a7af7eaa7899a89e0d84943e868184fafc4dda726910f8637da8a","d4ca95e7743d5197cd3fbe2b10a4388cb680295759a10e7cd9121612e01c46a7","26a5610889a6a701175fcd5631dfca3ff0011c27ccd28f11773844e1a3132166","9653956f338e102c5a2cbceb6e993323f13b9483a2f338a20f20d023d813c865","23780dfacc600a98eac5af9fbe3cb71f22ddcea22b9d58086c9290da501a79db","0510fc3265aa7d1256b7c719e145d3478470b03248743b0c35db1cf09aa6a432","842dbf106c8376fddbec242077a57d2b354160d9b8b79eb62563eb27d2a8bfa0","3b81964c4b541de768e294d60915de74ce2b0814314bcf93eaa8e439012f1276","08ecba125450b57142621ea65dee23ea899dd02d8791fbf066ba6cf7355cfd7a","8bcda798c8e1f45faf665d16332def2d63ad9863348c01dd004ef1b2515eba10","2f64d7b10713fe02d68e7a76656d745c04d64a47a71bedf68f3869c9c9d5b59b","871cce2c4447b095dab9c61e3c3ae6ca90489f3072bcdb9ce9a28a310c12eecd","2664426e6fc16b4f9f40b6324258dc60e0cb280c05d42a890dfa73cd5caa3fd4","992b38f99d37890815195d47a4b0f3147de979b5c43bcc4bf24bd37f5b178524"],"paragraph_range_zero_based":[47400,47423],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p47400"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the threshold used to determine whether NR sidelink transmission in dedicated SL PRS resource pool is prioritized over uplink transmission of priority index 0 as specified in TS 38.213[13], clause 16.2.4.3, or whether PUCCH transmission carrying SL HARQ is prioritized over PUCCH transmission carrying UCI of priority index 0 if they overlap in time as specified in TS 38.213 [13], clause 9.2.5.0.","paragraph_zero_based":47424},{"literal_text_all_w_t_and_m_t":"sl-PriorityThresholdDedicatedSL-PRS-RP","paragraph_zero_based":47425},{"literal_text_all_w_t_and_m_t":"Indicates the upper bound of priority range which is associated with the configurations in sl-CBR-ConfigIndex-Dedicated-SL-PRS-RP and in sl-PRS-Tx-ConfigIndex. The upper bounds of the priority ranges are configured in ascending order for consecutive entries of SL-PriorityTxConfigIndex-Dedicated-SL-PRS-RP in SL-PriorityTxConfigList-Dedicated-SL-PRS-RP. For the first entry of sl-PriorityThreshold-Dedicated-SL-PRS-RP, the lower bound of the priority range is 1.","paragraph_zero_based":47426},{"literal_text_all_w_t_and_m_t":"sl-PriorityThresholdUL-URLLC","paragraph_zero_based":47427},{"literal_text_all_w_t_and_m_t":"Indicates the threshold used to determine whether NR sidelink transmission in dedicated SL PRS resource pool is prioritized over uplink transmission of priority index 1 as specified in TS 38.213[13], clause 16.2.4.3, or whether PUCCH transmission carrying SL HARQ is prioritized over PUCCH transmission carrying UCI of priority index 1 if they overlap in time as specified in TS 38.213 [13], clause 9.2.5.0.","paragraph_zero_based":47428},{"literal_text_all_w_t_and_m_t":"sl-PRS-ResourceReservePeriodList","paragraph_zero_based":47429},{"literal_text_all_w_t_and_m_t":"Indicates set of possible resource reservation period in the unit of ms allowed in the resource pool. Up to 16 values can be configured per resource pool. The possible resource reservation period are periodicities for SL communication and the ones defined for DL-PRS.","paragraph_zero_based":47430},{"literal_text_all_w_t_and_m_t":"sl-PRS-ResourcesDedicatedSL-PRS-RP","paragraph_zero_based":47431},{"literal_text_all_w_t_and_m_t":"Indicates SL PRS resources in a slot of dedicated SL PRS resource pool as defined in TS 38.211 [16].","paragraph_zero_based":47432},{"literal_text_all_w_t_and_m_t":"sl-PRS-TxConfigIndex","paragraph_zero_based":47433},{"literal_text_all_w_t_and_m_t":"Indicates SL PRS transmission Configuration index.","paragraph_zero_based":47434},{"literal_text_all_w_t_and_m_t":"sl-PRS-TxConfigIndexList","paragraph_zero_based":47435},{"literal_text_all_w_t_and_m_t":"Indicates List of sl-PRS-Tx-ConfigIndex indicating the SL PRS transmission index","paragraph_zero_based":47436},{"literal_text_all_w_t_and_m_t":"sl-RB-Number","paragraph_zero_based":47437},{"literal_text_all_w_t_and_m_t":"Indicates the number of PRBs in the corresponding SL PRS dedicated resource pool, which consists of contiguous PRBs only.","paragraph_zero_based":47438},{"literal_text_all_w_t_and_m_t":"sl-SCI-basedSL-PRS-TxTriggerSCI1-B","paragraph_zero_based":47439},{"literal_text_all_w_t_and_m_t":"Indicates presence of a bit-field in SCI format 1-B to trigger SL-PRS transmission by a receiving UE.","paragraph_zero_based":47440},{"literal_text_all_w_t_and_m_t":"sl-SensingWindowDedicated-SL-PRS-RP","paragraph_zero_based":47441},{"literal_text_all_w_t_and_m_t":"Indicates Parameter that indicates the start of the sensing window for SL PRS in a dedicated resource pool.","paragraph_zero_based":47442},{"literal_text_all_w_t_and_m_t":"sl-SRC-ID-LenDedicatedSL-PRS-RP","paragraph_zero_based":47443},{"literal_text_all_w_t_and_m_t":"Indicates the number of bits used for the source ID in SCI format 1-B.","paragraph_zero_based":47444},{"literal_text_all_w_t_and_m_t":"sl-StartRB-Subchannel-DedicatedSL-PRS-RP","paragraph_zero_based":47445},{"literal_text_all_w_t_and_m_t":"Indicates the lowest RB index of the SL PRS dedicated resource pool with respect to the lowest RB index of a SL BWP.","paragraph_zero_based":47446},{"literal_text_all_w_t_and_m_t":"sl-SubchannelSizeDedicatedSL-PRS-RP","paragraph_zero_based":47447}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["42bb0f2fa24172e94c76582970600cf0242cc2dfc3f9defba2fb4ce81944b538","638b0a6133ddb9c08e89b93528d5fd5661e71804bbf6f27ec58025041016d50f","ec110b53d2e091d5b31c48b8b8cdadc175f9d78ac8130cc4a50542fb9cadc53d","492ef01eeb73bd6a963fa8d88e09b732a2b424315b3c883ebc18c1e2df319d2b","50aa7d3106a9cea0ec2a3403425a5ed909317770fb6c143085f7aef98052dc82","47e966c821c670639317d1a016244060d06abcb17fa51951d1b55a90d5c4d9ca","a2f16db2abc744e1e7acea4e6504f2fc3b12896b8a6bd612bc5541102015a45e","c002f88924c5429cbaf56fecd10449cf5bce29e044814083c4e8c0cdda1ba3cb","00c7c5e18c5882505ab8bbf7fcda424a0be60854ef30c51160e68ff759e4bedd","af9e1eb3d47a46058bdc6617d81b1ccd5475099e376922ad208336f03f888e8f","749fd711e3e59e9802b948f964d0e9c688b259e3abb0d690c6f15359cf451bd3","8460f460464ebc5ac7713c4e2c966784c9e63120f22d7f532545abe590b104f3","ed09c2251b6db2c9187b60fa46c7a3a960664369e6fec618f8c939b6b07767f4","b1ad49d2f0ef87be623b9abd877e58dd128fceed423c0fe0d4897ca2a3e2329e","1707cbfe3576045f8765fa235bac9cba4b28e156c6f73a172d3fb6a199b0dcf1","3a9ade8a6f9dbab25d90391ae87b17106a3d4d210ee9b2923d85190028d81aec","a15eb1aa3a4dda4e947a7dc26c2803ed0af55b178bcfd9792f6b79f359686ebd","ce220c3dab7db08a332c9cf91a3ab21575fba158fedca7b42843ad5b8af833c3","672635702f4398bb96d24389aa300cc92338f722a285a1855b9aa11b8bc5052c","3adf2d024e3beec27706778ac852ea5cf8bc9c5aa65a518b719cf8a85cf08389","39ab4ad0d61bb9e70ec5576561d740dd6b31dd642badf58d838016fee0827825","7474efb06b9abbd7902e8b1e707a960587c42d2af644de19d8e1cdfd6c3d9d5e","324e39e235c212adad9ae6afe239cec40c0c677032a9302ab1786e7c23929941","3f5d0064f871f29a47a65d60c05fca4c32abc4fcb8646ffab7372ccfa3acd024"],"paragraph_range_zero_based":[47424,47447],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p47424"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates size of a subchannel for PSCCH in number of RBs.","paragraph_zero_based":47448},{"literal_text_all_w_t_and_m_t":"sl-ThreshS-RSSI-PRS-CBR","paragraph_zero_based":47449},{"literal_text_all_w_t_and_m_t":"Indicates the S-RSSI threshold for determining the contribution of a sub-channel to the SL-PRS CBR measurement in a dedicated SL-PRS resource pool. Value 0 corresponds to -112 dBm, value 1 to -110 dBm, value n to (-112 + n*2) dBm, and so on.","paragraph_zero_based":47450},{"literal_text_all_w_t_and_m_t":"sl-TimeResource","paragraph_zero_based":47451},{"literal_text_all_w_t_and_m_t":"This field indicates the bitmap of the SL PRS dedicated resource pool, which is defined by repeating the bitmap with a periodicity during a SFN or DFN cycle.","paragraph_zero_based":47452},{"literal_text_all_w_t_and_m_t":"sl-TimeWindowSizeCBR-DedicatedSL-PRS-RP","paragraph_zero_based":47453},{"literal_text_all_w_t_and_m_t":"Indicates the time window size for CBR measurement in a dedicated SL-PRS resource pool.","paragraph_zero_based":47454},{"literal_text_all_w_t_and_m_t":"sl-TimeWindowSizeCR-DedicatedSL-PRS-RP","paragraph_zero_based":47455},{"literal_text_all_w_t_and_m_t":"Indicates the time window size for CR evaluation in a dedicated SL-PRS resource pool.","paragraph_zero_based":47456},{"literal_text_all_w_t_and_m_t":"sl-TxPercentageDedicatedSL-PRS-RP-List","paragraph_zero_based":47457},{"literal_text_all_w_t_and_m_t":"Indicates List of minimum Tx percentage (list per priority)","paragraph_zero_based":47458},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47459},{"literal_text_all_w_t_and_m_t":"SL-PRS-PSCCH-Config field descriptions","paragraph_zero_based":47460},{"literal_text_all_w_t_and_m_t":"freqResourcePSCCH-Dedicated-SL-PRS-RP","paragraph_zero_based":47461},{"literal_text_all_w_t_and_m_t":"Indicates the number of PRBs for PSCCH in a dedicated SL PRS resource pool.","paragraph_zero_based":47462},{"literal_text_all_w_t_and_m_t":"timeResourcePSCCH-Dedicated-SL-PRS-RP","paragraph_zero_based":47463},{"literal_text_all_w_t_and_m_t":"Indicates the number of symbols for PSCCH in a dedicated SL PRS resource pool.","paragraph_zero_based":47464},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47465},{"literal_text_all_w_t_and_m_t":"SL-PRS-PowerControl field descriptions","paragraph_zero_based":47466},{"literal_text_all_w_t_and_m_t":"dl-P0-SL-PRS","paragraph_zero_based":47467},{"literal_text_all_w_t_and_m_t":"Indicates P0 value for DL pathloss based open loop power control for SL PRS transmission in dedicated SL PRS resource pool.","paragraph_zero_based":47468},{"literal_text_all_w_t_and_m_t":"dl-AlphaSL-PRS","paragraph_zero_based":47469},{"literal_text_all_w_t_and_m_t":"Indicates alpha value for DL pathloss based open loop power control for SL PRS transmission in dedicated SL PRS resource pool. ","paragraph_zero_based":47470},{"literal_text_all_w_t_and_m_t":"sl-P0-SL-PRS","paragraph_zero_based":47471}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["518326499253b18a392e5bc9d9d2903e0d45b6fcfcc0e00f96458dad255f1d04","66f9ceacbd54fab7360d0bfcc82f7afe5958e0e6f8a72af174063b22cfd8ac1d","927f269525295cddcba650cc0cb4b4364e749461eef05cd59eb7b976cd3f0bc2","37c977034a0025748bbb4db3247137b1aed0b2bac834f32989dd54ff79b983ea","aa07e9d8c50f954dd8a62ad57e4ca6b058cd910b803c0c432c0614eff418bbab","dfce7c8bb85df0ef76818bc4703cd4cfd5e06a687a157fc40812b40db6bb3e41","6b444b30bcd542ca77d1bfcffb915879a4e6d67dd0ce131567732c7f2b4c4147","3c16d77f1f1