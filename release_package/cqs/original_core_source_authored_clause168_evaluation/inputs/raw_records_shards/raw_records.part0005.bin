{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports out-of-order delivery from RLC to PDCP for RLC AM.","paragraph_zero_based":4584},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4585},{"literal_text_all_w_t_and_m_t":"rlc-UM-Ooo-Delivery","paragraph_zero_based":4586},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports out-of-order delivery from RLC to PDCP for RLC UM.","paragraph_zero_based":4587},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4588},{"literal_text_all_w_t_and_m_t":"rlm-ReportSupport","paragraph_zero_based":4589},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports RLM event and information reporting. ","paragraph_zero_based":4590},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4591},{"literal_text_all_w_t_and_m_t":"rohc-ContextContinue","paragraph_zero_based":4592},{"literal_text_all_w_t_and_m_t":"Same as \"continueROHC-Context\" defined in TS 38.306 [87].","paragraph_zero_based":4593},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":4594},{"literal_text_all_w_t_and_m_t":"rohc-ContextMaxSessions","paragraph_zero_based":4595},{"literal_text_all_w_t_and_m_t":"Same as \"maxNumberROHC-ContextSessions\" defined in TS 38.306 [87]. ","paragraph_zero_based":4596},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":4597},{"literal_text_all_w_t_and_m_t":"rohc-Profiles","paragraph_zero_based":4598},{"literal_text_all_w_t_and_m_t":"Same as \"supportedROHC-Profiles\" defined in TS 38.306 [87].","paragraph_zero_based":4599},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":4600},{"literal_text_all_w_t_and_m_t":"rohc-ProfilesUL-Only","paragraph_zero_based":4601},{"literal_text_all_w_t_and_m_t":"Same as \"uplinkOnlyROHC-Profiles\" defined in TS 38.306 [87].","paragraph_zero_based":4602},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":4603},{"literal_text_all_w_t_and_m_t":"rsrqMeasWideband","paragraph_zero_based":4604},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE can perform RSRQ measurements with wider bandwidth.","paragraph_zero_based":4605},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4606},{"literal_text_all_w_t_and_m_t":"rsrq-OnAllSymbols","paragraph_zero_based":4607}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["7e87fa5e22ffe1f885414dc5acc2308cadfaa2bbc28bbedc965cafc4a4aacfb7","5eb88da8dd6291202f4c64c568f701795971c766578de2c29004f54e9a147428","73617799d0b2b6f3ce0a6e054b14be784be154a8c28cbf730db9161591f8c73f","9d2aa81a29602dd9a0ef38b0ba4831c18255e608e9489c8a5cd8cfceaa2c66c1","0b9ff4b3fcc737dc8488138cd94e249600799b77ba39746a3eeca84c5002ab99","cd5d44d222e321e6603f1160d4a5d89afab7e794e418f469bf5e663404b2d1f9","8cd9176f9df645a0bd47a1bcd234ef420b537926e71637f8c3d5e76c02d8cf88","64e2e35580a251307108bb9b8974cee5e5c7e51271c54dd5fbd389e274b2eae9","c5632d75c56c9637ebae89065ce6ce195694196f1a814f7444f35fa1f099e45b","fb95956c24feba2a55a8826f1e191d8ad47626bbac41aa0730545a2a10d703b8","a2c91ce6b06be9e35510b9201ffa79c5d32a261a1c4062ab9b14e9a5a7e78a51","8f950fea8cf3daf6993919a95bc6f63cbe224c42e44e7b720c714e416791f9c6","d012f92b1c3121d5f4d82ccd54b049b5f299cb23fb1d1bdaf6d420a75aa46b9c","9de363d504ff05d99d82af2803fce9308e8c101a0938e3b7bcb8d2eab107e0a4","8aa7df9f88ce7cb29f628665d1eddfbb2e116af43a1c4dff7cfbecdb0f7e3236","edb4aafe57108a0b2b13bc830779dd4aee19535f7bc4dfe9b67f72bcae76b6ec","eea379fd7b0f9a68a491973efdc1d8523eadd2e0c64d2fcc2cf164bc63ad52f7","a46b0600086968e16d32c19523adb370dbf433490421ac30be4479aa8d222f8f","298a50c12a05ad1c26a889f02682db5fb67aecce956527500c94dbd24ac41d56","3aa68ff548dc39629f1b4e3e97d9cd91b53ff1bce0a8d9246bab48d72a71ae75","469fbbcfd2b506d7841a9a596bf76b51ca8e3d92f91865ed04ef70140c1d3554","c502cf93d7a34b58f8353e02c53f45f9511cf5c3145bd7143cf1515529473456","0cf970f76d32df2401f18ccb5424635a8fbc7dba2f0f410050912d36e5da2cae","5ee14a0bba595db359c505b25d44eac7b900f250ab54ae7bdd1014a1c356c411"],"paragraph_range_zero_based":[4584,4607],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p4584"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether the UE can perform RSRQ measurement on all OFDM symbols and also support the extended RSRQ upper value range from -3dB to 2.5dB in measurement configuration and reporting as specified in TS 36.133 [16].","paragraph_zero_based":4608},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":4609},{"literal_text_all_w_t_and_m_t":"rs-SINR-Meas","paragraph_zero_based":4610},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE can perform RS-SINR measurements in RRC_CONNECTED as specified in TS 36.214 [48].","paragraph_zero_based":4611},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4612},{"literal_text_all_w_t_and_m_t":"rssi-AndChannelOccupancyReporting","paragraph_zero_based":4613},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports performing measurements and reporting of RSSI and channel occupancy. This field can be included only if downlinkLAA is included.","paragraph_zero_based":4614},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4615},{"literal_text_all_w_t_and_m_t":"sa-NR","paragraph_zero_based":4616},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports standalone NR as specified in TS 38.331 [82].","paragraph_zero_based":4617},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":4618},{"literal_text_all_w_t_and_m_t":"satelliteInfoConfigDedicated","paragraph_zero_based":4619},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE can be configured via dedicated signalling with NTN assistance information (i.e., satelliteId-r18 or ephemeris information in measObjectEUTRA) to measure an NTN cell in RRC_CONNECTED.","paragraph_zero_based":4620},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4621},{"literal_text_all_w_t_and_m_t":"scalingFactorTxSidelink, scalingFactorRxSidelink","paragraph_zero_based":4622},{"literal_text_all_w_t_and_m_t":"Indicates, for a particular band combination of EUTRA, the scaling facor, as defined in TS 38.306 [87], for the PC5 band combination(s) v2x-SupportedBandCombinationListEUTRA-NR on which the UE supports simultaneous transmission/reception of EUTRA and NR sidelink communication respectively, or simultaneous transmission or reception of EUTRA and joint V2X sidelink communication and NR sidelink communication respectively (as indicated by v2x-SupportedTxBandCombListPerBC-v1630 / v2x-SupportedRxBandCombListPerBC-v1630). The leading / leftmost value corresponds to the first band combination included in v2x-SupportedBandCombinationListEUTRA-NR which is indicated with value 1 by v2x-SupportedTxBandCombListPerBC-v1630 / v2x-SupportedRxBandCombListPerBC-v1630, the next value corresponds to the second band combination included in v2x-SupportedBandCombinationListEUTRA-NR which is indicated with value 1 by v2x-SupportedTxBandCombListPerBC-v1630 / v2x-SupportedRxBandCombListPerBC-v1630 and so on. For each value of ScalingFactorSidelink-r16, value f0p4 indicates the scaling factor 0.4, f0p75 indicates 0.75, and so on.","paragraph_zero_based":4623},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4624},{"literal_text_all_w_t_and_m_t":"scptm-AsyncDC","paragraph_zero_based":4625},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE in RRC_CONNECTED supports MBMS reception via SC-MRB on a frequency indicated in an MBMSInterestIndication message, where (according to supportedBandCombination) the carriers that are or can be configured as serving cells in the MCG and the SCG are not synchronized. If this field is included, the UE shall also include scptm-SCell and scptm-NonServingCell.","paragraph_zero_based":4626},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4627},{"literal_text_all_w_t_and_m_t":"scptm-NonServingCell","paragraph_zero_based":4628},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE in RRC_CONNECTED supports MBMS reception via SC-MRB on a frequency indicated in an MBMSInterestIndication message, where (according to supportedBandCombination and to network synchronization properties) a serving cell may be additionally configured. If this field is included, the UE shall also include the scptm-SCell field.","paragraph_zero_based":4629},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4630},{"literal_text_all_w_t_and_m_t":"scptm-Parameters","paragraph_zero_based":4631}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["0af534bd62b9ddd54126a0f4589b65da1b02f6359564a5155c5ce7980bba3cc7","77ec7c865836df51b777af8be99cc670be5e023b3792c1d090c978f84179e0a4","e186eb4b06279d39c3695b8dadff7f9a26d1f6afdf76c4269b78ebb1605ef2e7","eb127e8df7eef31711d620e5d7812a56ee5e5e6bab388871d9755be1a144e33f","d931328547220d8da371f6790a8b83f1c0e34dfa2e4038bdf80688871bbd85d3","107b71bf9e63b2ead0e888b3cdd30f8952338f173c500d8f10fa5c54bfb3a027","6d39f1708714e82453fe2c249ca698d93d8fcc42979fb95e7e2d649b8dc9830b","b467bd90bdb823724a458b0f59424fb6a67c58d2a9aad3ea148ed3787f7861a4","1d38e75d7fd44c09595c99711d7c985d6f6b183ac2c9f946830d31cb9dd0a2cf","f57af4bc2456395cde3c34fca8247c5b4cac811373ed8deb233669147bfcd243","5e07a2ab305e1a1c746708d3f6fc75d23a6d83681e761c042aebd32115d9de09","e902254478aef8233f475e334049f87170c802dfd78a346e6c271f56207a9191","b88ebacc289e68752694a5446a5dc93ae420af28265cf43aa5f1e7b191d02b44","c853ece8b3e64e2fb8240c17452352b39006d3d3e3a8ec80dc5d2bb0d12f2b4b","5d038f4e0a0642aca8b9787a839986d3f85d861e3ffd92bad24be4c8435a2a70","41ed936c32751323802a28746a8ab654e9ada9a639d699bda12acd0cb89793e0","1a8bdaa67e79cf3947bb4b9bc72d10f9adf57918197c3d117b16f9095f2a3ee2","0eac4f9d1f46169cdef4b531146c468b15674da4451e0735a452e84e50b7f0a3","4bd295661096e3a66cef5f73c5efdb6a6596cd95de54a497d2653c840225b352","ce92cab568c2d8d3f064b062fae860d1107fb6ffdfa46b14a27bf2639041ed45","1c0018f55ef627cc1fd474e7d8eb36c1cfba357ae7e022a50054f2eadf8df64b","81dfd17b3a1faef556da13029e11ee75fd1a27c18cc8f4972da9afe7280b16ed","23fd7dc559c5864356fd76db02fd01d5748b8f829c7acc4d65317d9ba242a656","b37448a63636b26b84eb39ead6e2e7eff59c867927f1dbc87d37c72f3fc4081f"],"paragraph_range_zero_based":[4608,4631],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p4608"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Presence of the field indicates that the UE supports SC-PTM reception as specified in TS 36.306 [5].","paragraph_zero_based":4632},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4633},{"literal_text_all_w_t_and_m_t":"scptm-SCell","paragraph_zero_based":4634},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE in RRC_CONNECTED supports MBMS reception via SC-MRB on a frequency indicated in an MBMSInterestIndication message, when an SCell is configured on that frequency (regardless of whether the SCell is activated or deactivated).","paragraph_zero_based":4635},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4636},{"literal_text_all_w_t_and_m_t":"scptm-ParallelReception","paragraph_zero_based":4637},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE in RRC_CONNECTED supports parallel reception in the same subframe of DL-SCH transport blocks transmitted using C-RNTI/Semi-Persistent Scheduling C-RNTI and using SC-RNTI/G-RNTI as specified in TS 36.306 [5].","paragraph_zero_based":4638},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4639},{"literal_text_all_w_t_and_m_t":"secondSlotStartingPosition","paragraph_zero_based":4640},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports reception of subframes with second slot starting position as described in TS 36.211 [21] and TS 36.213 [23]. This field can be included only if downlinkLAA is included.","paragraph_zero_based":4641},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4642},{"literal_text_all_w_t_and_m_t":"semiOL","paragraph_zero_based":4643},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports semi-open-loop transmission for the indicated transmission mode.","paragraph_zero_based":4644},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4645},{"literal_text_all_w_t_and_m_t":"semiStaticCFI","paragraph_zero_based":4646},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports the semi-static configuration of CFI for subframe/slot/sub-slot operation. ","paragraph_zero_based":4647},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4648},{"literal_text_all_w_t_and_m_t":"semiStaticCFI-Pattern","paragraph_zero_based":4649},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports the semi-static configuration of CFI pattern for subframe/slot/sub-slot operation. This field is only applicable for UEs supporting TDD.","paragraph_zero_based":4650},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4651},{"literal_text_all_w_t_and_m_t":"sharedSpectrumMeasNR-EN-DC","paragraph_zero_based":4652},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports performing measurements and reporting of RSSI and channel occupancy on each supported NR band in EN-DC. If included, the UE shall include the same number of entries, and listed in the same order as in supportedBandListEN-DC-r15.","paragraph_zero_based":4653},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4654},{"literal_text_all_w_t_and_m_t":"sharedSpectrumMeasNR-SA","paragraph_zero_based":4655}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["8205a78e72c4a6155b1a478f74d184c3ff002d60a7b2d7d85310be85b456101a","f89b1ff2267057a89cd36a9cbe7a0e13b1aaa5d03c0b6d6de5e319bc31506883","8f176e38871dd58a7fdee1a94aa25be35f37d963e328777327ac9fda131d2a29","5d5c9be360f285055b4656965476cb4caeed4777871c48fc9a4606d069c66dd8","f6909540a93d8e16af848e0441602d122dc807f867117f11ec5d4cac5d2f3d08","cbf2b05a5e22806df691ec249747f7487c70ed34cbe3c71a4b021a41e98f3c09","05855f7c71fe44e7f042c232a72e440985a06bcf86d993cfae6b6a8d65258856","44f0530aff6b4f5bd27cdba1340dcd35bd0a01a651cae2104845b0a3a04be758","abcdad1ba3770ac0f560b4a5dce1788b5f3ada22d3e44fedb83534c26e95f858","a0620eb1cb98d49ea2b4dca706231a7ece5d1c1ad39046f8d127ce8acdcaf4d2","65a7a2e5347a11c43213ff3a7c0c6c25c7d8b5cbc4a4971da825430a84942c25","58ef9ca9aa870b8f8d5519bc3da6b35dc9db95f3e7ea1cd994a547ee5836f987","1710479ca9346c6b96cba4924c7f35e64abdddde8b2468067d9ab675c04a836b","21a07542b2f971839e3de4708f3d96ed4b2f36bc9a037422b27fae481697892a","39fc87c31e24f942ff19dc4b39f9973b5455406f9e6a903573b30346cc17fa5c","79b3836c70d812ec6ec11644aa3470dd6fbabbcbd623d82c9a383e5fa3ea3fa7","1f7d1e628b9cb56803048897827ad8da62db573f9d251551166b61c7443c5bc9","00216989370763d306adfe6ae4c6034196a8aa58d53c59de15e6e3ab2ea80d52","a58a9c8e97b023d39dfd0b1ce4fec42d55c2993d71a23ac5a6c16031717fc643","5dc6f05fb6d57d4ac6f0eea3871d6b1cc0522d449e3f07e681dd8de03de81873","0e38b566f0a9b858424715579371440f31d09d4d3ba14ca5abff6bcaca0c3c67","1b35cc8569d6a7cdda8f400239279fc395abf1d1a16b8eccb55aca4aa5010094","9b93713728eab8a804ffbca51b0be1c89182f3dcb1d189924c3ef1b049d53f03","9c84037a6c89c0cdcfa0fd02c2b18c0b0fdcc1c5745029403c7faa9a3bb6e059"],"paragraph_range_zero_based":[4632,4655],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p4632"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports performing measurements and reporting of RSSI and channel occupancy on each supported NR band in NR SA. If included, the UE shall include the same number of entries, and listed in the same order as in supportedBandListNR-SA-r15.","paragraph_zero_based":4656},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4657},{"literal_text_all_w_t_and_m_t":"shortCQI-ForSCellActivation","paragraph_zero_based":4658},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports additional CQI reporting periodicity after SCell activation.","paragraph_zero_based":4659},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4660},{"literal_text_all_w_t_and_m_t":"shortMeasurementGapIndicates whether the UE supports shorter measurement gap length (i.e. gp2 and gp3) in LTE standalone as specified in TS 36.133 [16], and for independent measurement gap configuration on FR1 and per-UE gap in (NG)EN-DC as specified in TS38.133 [84].","paragraph_zero_based":4661},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":4662},{"literal_text_all_w_t_and_m_t":"shortSPS-IntervalFDD","paragraph_zero_based":4663},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports uplink SPS intervals shorter than 10 subframes in FDD mode.","paragraph_zero_based":4664},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4665},{"literal_text_all_w_t_and_m_t":"shortSPS-IntervalTDD","paragraph_zero_based":4666},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports uplink SPS intervals shorter than 10 subframes in TDD mode.","paragraph_zero_based":4667},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4668},{"literal_text_all_w_t_and_m_t":"sigBasedEUTRA-LoggedMeasOverrideProtect","paragraph_zero_based":4669},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports the override protection of the signalling based logged measurements configured in E-UTRA when entering RRC_CONNECTED state in NR.","paragraph_zero_based":4670},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4671},{"literal_text_all_w_t_and_m_t":"simultaneousPUCCH-PUSCH","paragraph_zero_based":4672},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports simultaneous transmission of PUSCH/PUCCH and SlotOrSubslotPUSCH/SPUCCH (if supported).","paragraph_zero_based":4673},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4674},{"literal_text_all_w_t_and_m_t":"simultaneousRx-Tx","paragraph_zero_based":4675},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports simultaneous reception and transmission on different bands for each band combination listed in supportedBandCombination. This field is only applicable for inter-band TDD band combinations. A UE indicating support of simultaneousRx-Tx and dc-Support-r12 shall support different UL/DL configurations between PCell and PSCell.","paragraph_zero_based":4676},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4677},{"literal_text_all_w_t_and_m_t":"simultaneousTx-DifferentTx-Duration","paragraph_zero_based":4678},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports simultaneous transmission of different transmission durations over different carriers. The different transmission durations can be of subframe, slot or subslot duration.","paragraph_zero_based":4679}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["1f8f8bf420af4b8eb612ccc4c34732de0f73d7dddae733ce0b8bf91b1a523ec2","009070f6a5892b6a79a7268ad59c28ddccbd6872ad245b9bb1a19ef18b657918","d97487a6d8325036f358c66d3fcca14619f1694f2eb979a5c73fc02c2b5ab2ad","7a157cd05ee7b63b6b2b3781a087f4efb82e2e0a192c22517f1e628ca25e3e2c","5aa05ff07768c44ae20f4a5ba7d3546b6a529d9d4b2fabd239510980e8555011","b3d27305f602236cd923a78e0f0a1cbde1a23ce56aab399f44911697b11653c3","09fbb744a6fc5d1560acec765960a4907c2c4148a83e9dd27ae5f622a97c617d","4b33e59e405e2c900bbf2e4f1fdc55451894f6d14a348db44ee04ebdc9c7170b","0b6007ae2d68e540756e06cfe704776a7022872d78def34b07ce15fe7495b322","badf9328e2d5acff4cc01d69297837a9ec47aa3f3ef82aba454a5ccd1d35b304","f883073c2beb5e166caa79bfaf82c3404dd6d8cd7bbb9e0935a471167e5dad81","9dd777eb5793ec21a31981fc3b5bebe0ed2d92e9aea0695c90d8b215e5a445ba","41723014a33c354e032e1268f84b4bd089243ad41b668922230142d1d64878ce","7d0cf4769caf9641c3390a38417e32ca60dccbd1b8e6782e824dd23ec0e0aa19","d5b42e91612f3a179dcf6102bc835fd8529e1cdad2df7b00628da92faf6d4b1f","8d42b0046ef7d90272bc5f14c82e0965e34df9da304e3389a90c219b2478455f","f994560263fa2a68614ea4c3169d37bc3984b39d9d50906819a53c5731b2f06e","e975b949b5f134afc2342650ee75719de8e9f6f34bbd5ff2e9829a1edb7a1665","e4628504a6052ae3296a9a5d1f1de145c132e14a798f82935f0f5cd1b7a2eb0e","fe459c105fe4a25f9a017fdf73bc7aaba16f73c63eb4a84599a65e6c76830951","223174d12f724cf7c8b67a46becd77606dceb83ecc5318cd22f5ee4a0041f3c0","77cf04838aa9bb4e86b463045a741c4a2c08690e7c51c18fdf4cc4a217c7880f","8ee46153873a10b7be4effaed3a98e9cdca18d6fb469eb8e252fb00a91b71bc2","dafa2198a7349800578ca74317f27853717ce01a30a82db5b6621a2581cc4da1"],"paragraph_range_zero_based":[4656,4679],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p4656"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4680},{"literal_text_all_w_t_and_m_t":"skipFallbackCombinations","paragraph_zero_based":4681},{"literal_text_all_w_t_and_m_t":"Indicates whether UE supports receiving requestSkipFallbackComb that requests UE to exclude fallback band combinations from capability signalling.","paragraph_zero_based":4682},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4683},{"literal_text_all_w_t_and_m_t":"skipFallbackCombRequested","paragraph_zero_based":4684},{"literal_text_all_w_t_and_m_t":"Indicates whether requestSkipFallbackComb is requested by E-UTRAN.","paragraph_zero_based":4685},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4686},{"literal_text_all_w_t_and_m_t":"skipMonitoringDCI-Format0-1A","paragraph_zero_based":4687},{"literal_text_all_w_t_and_m_t":"Indicates whether UE supports blind decoding reduction on UE specific search space by not monitoring DCI Format 0 and 1A as specified in TS 36.213 [23], clause 9.1.1.","paragraph_zero_based":4688},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":4689},{"literal_text_all_w_t_and_m_t":"skipSubframeProcessing","paragraph_zero_based":4690},{"literal_text_all_w_t_and_m_t":"This fields defines whether the UE supports aborting reception of PDSCH if the UE receives slot-PDSCH/subslot-PDSCH during an ongoing PDSCH reception and instead starts receiving the slot-PDSCH/subslot-PDSCH, as well as whether the UE supports aborting a PUSCH transmission if the UE gets a grant for a slot-PUSCH/ subslot-PUSCH transmission that overlaps with a grant received for a PUSCH transmission. The capability indicates the number of subframes that the UE may drop prior to the subframe in which it prioritizes the processing of slot/subslot PDSCH/PUSCH as described in TS 36.213 [23], clauses 7.1 and 8.0. Separate capability for UL and DL and per sTTI length in each direction: skipProcessingDL-Slot, skipProcessingDL-Subslot, skipProcessingUL-Slot and skipProcessingUL-Subslot.","paragraph_zero_based":4691},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4692},{"literal_text_all_w_t_and_m_t":"skipUplinkDynamic","paragraph_zero_based":4693},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports skipping of UL transmission for an uplink grant indicated on PDCCH if no data is available for transmission as described in TS 36.321 [6].","paragraph_zero_based":4694},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4695},{"literal_text_all_w_t_and_m_t":"skipUplinkSPS","paragraph_zero_based":4696},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports skipping of UL transmission for a configured uplink grant if no data is available for transmission as described in TS 36.321 [6].","paragraph_zero_based":4697},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4698},{"literal_text_all_w_t_and_m_t":"sl-64QAM-Rx","paragraph_zero_based":4699},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports 64QAM for the reception of V2X sidelink communication.","paragraph_zero_based":4700},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4701},{"literal_text_all_w_t_and_m_t":"sl-64QAM-Tx","paragraph_zero_based":4702},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports 64QAM for the transmission of V2X sidelink communication.","paragraph_zero_based":4703}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["0ff7c95f678d556a6dbc58c4392e08d8551d8882ca401ef6c934fefd0162fa5c","f576a05e46ea1614fae39232e342c9f1629556f72dcc506fa8665daae14cf24b","407ec95b12d8a150f8fb747841cdf5dcaccc544f3ce14cb64a90c3cf43644dfc","48f7bc1d7fba77feb55f73b6476fc6bc8c6e123570654d756d26d729a709529e","0fcc31b484e4aa8728cfa8ba8b54be9ecdf6452c247a2db776851a56d098a29a","f5e9f660d32dc409a52c097106d0f1626c7f384832a88a470dcfcba74da99df3","532268ed33b370fb4e909250f8d860b3ba9d08a0f873f39dcb5ef871a1e498d9","85a40c53326b3f3d948914ecd974081afd0e12f5d2bba01d48c258d8453a507b","020be0a9ed78c4fcc80c5f536fb9c486bd71661d92a43192b9c04f9ecdd3a6c2","3f913ab18909e284143eb9faec04c3e62c939b610c8fe54eb7ee83a9ab814ea3","744ceef89c82b8352be283f00b50ab9d0ceacaa350d83aa6b0bcccfc2a924f19","8fe87a008c1d9890dc5a01182ce17b025cfaf0e8349befdba968fe4e63fb9a8a","cd2e83a372431d768024761c15bc95472908e199c627afb3fb9b0d045124ac3b","e3e9175009b83eb7c9625a119a86de43d4c3fe6eb400ab585ba64d50e67010f2","f0d2251fd6771a47db06ccece248cbdea788d886e9f015e115a7be26e5739f66","7c81ddb08d683f5dbf57b9124ad0c4fd827d3c6102fa7f3f5087c6b5f6466324","ceea5d61c4a5fad747df19b5f5500b4e04c0bc914445f2dc45c889786711ded8","ce797cd7fb8be92c8a103d40716bdd7ed588e6dc9f02ce685e13d4b84d63c527","70ba4a6cbcbc7b68d95a2d8030e5abad96f0b139afffc815bfcef9236588cdf9","f16402ed60dd75a23df7831eea1ccbb8dd75a1eafb64e7d4ee0ca6cbbdf5ac23","4d51d776499f70eec9809ae47084ceaedbb1e670c69ac8c4c834282fc33a7655","3967cb5f2e27fe59f8ed7c2c8582d41a6052219afde1a71e1ac481b3c97c31c4","563564c0f0b9f81cd1c237d036811917b2e08b4ca472d32ebc5902543b029d76","cd4ce73bcefabd5feab1e6168ba7ae53623f03bb42570307dc5ab09bc7ef95a2"],"paragraph_range_zero_based":[4680,4703],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p4680"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4704},{"literal_text_all_w_t_and_m_t":"sl-A2X-Service","paragraph_zero_based":4705},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports A2X service and dedicated resource pool for A2X service. Value 'brid' indicates BRID is supported, value 'daa' indicates DAA is supported, and value 'bridAndDAA' indicates both are supported.","paragraph_zero_based":4706},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4707},{"literal_text_all_w_t_and_m_t":"sl-CongestionControl","paragraph_zero_based":4708},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports Channel Busy Ratio measurement and reporting of Channel Busy Ratio measurement results to eNB for V2X sidelink communication.","paragraph_zero_based":4709},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4710},{"literal_text_all_w_t_and_m_t":"sl-LowT2min","paragraph_zero_based":4711},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports 10ms as minimum value of T2 for resource selection procedure of V2X sidelink communication.","paragraph_zero_based":4712},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4713},{"literal_text_all_w_t_and_m_t":"sl-ParameterNR","paragraph_zero_based":4714},{"literal_text_all_w_t_and_m_t":"Includes the SidelinkParametersNR IE as specified in TS 38.331 [82]. The field includes the sidelink capability for NR-PC5, where multipleSR-ConfigurationsSidelink, logicalChannelSR-DelayTimerSidelink and relayParameters are not applicable.","paragraph_zero_based":4715},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4716},{"literal_text_all_w_t_and_m_t":"sl-RateMatchingTBSScaling","paragraph_zero_based":4717},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports rate matching and TBS scalling for V2X sidelink communication.","paragraph_zero_based":4718},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4719},{"literal_text_all_w_t_and_m_t":"slotPDSCH-TxDiv-TM8","paragraph_zero_based":4720},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports TX diversity transmission using ports 7 and 8 for TM8 for slot PDSCH.","paragraph_zero_based":4721},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4722},{"literal_text_all_w_t_and_m_t":"slotPDSCH-TxDiv-TM9and10","paragraph_zero_based":4723},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports TX diversity transmission using ports 7 and 8 for TM9/10 for slot PDSCH.","paragraph_zero_based":4724},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4725},{"literal_text_all_w_t_and_m_t":"slotSymbolResourceResvDL-CE-ModeA, slotSymbolResourceResvDL-CE-ModeB, slotSymbolResourceResvUL-CE-ModeA, slotSymbolResourceResvUL-CE-ModeB","paragraph_zero_based":4726},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports slot/symbol-level time-domain resource reservation in downlink/uplink when operating in CE mode A/B, as specified in TS 36.211 [21] and TS 36.213 [23].","paragraph_zero_based":4727}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["3c780176b78d2aa6e94016b1e7b50745476643771f052088609f719016ed830d","ca0bde70a9ec0a801bc966c87252aad21267ffe7eeea76e59905a0b9bffe35ff","f28e9d2d01e65d2df376d123d63622f45557355035ebbdfce96051c8cab918dc","91f61e9a5d7ca34c1f62b386ee80b1b04ac775ef4e757ed18c43a2f0f7d77699","d2aaf0c82f8929e8eba2ca2abd8b84a1d6724cfbb4ef9c4aa82cb8afb3d48d52","fa72585c6c9f28f8e135af9663c239b3c7fe399242c1793c753cc3b206300cd6","bbb902cf24d95cbadfac648f20c8789423f9afd2154160601f5a2db37f7a59ea","d9d7d7a740de0a31359563ccd466e8648549556e59734034bc84d77f315b03a7","ef499584ebfde0e9806030cb4a6454030a846427ab16ae7a289a976a707f8ed0","0eb570478006635319110b5ea66c909ba9506a2c29c288db30367d0d1c153c76","ceaf6a0d964fffbeba27233e8f629a48fa0e1d4b3075c6789c49b651a677b3fb","18d7a37b52a779da266d07618d49bd95adcd8595925b5cff791a324047b57eec","1661de60ad44a48b09e9ad4f13c9e8cd49aac63e978556de9e96e71113cbec6f","4d9bd9aecc61a558c2f9d84d53b72cb99d4da4c4cc8c0e812c2a753e7e37c4a8","97e223483ce24db9d6005564d8a96e32f72bbdead51bb3f9001605b515ebf625","caf82061e27fc9283eae664b8a0dee5cc2808914551a3e0ed367fdabb286bd9c","5d1a63c159aa6f3a95cd3aebbdd8ec2cbb2d51f80587ba7257ec0b4030f1b3f1","d281b1d856347c279f9aee43b04eacc117712a5eace9ea99bf445d00d7a69036","82d02d716be11f8a01aeed6abc3dd0c59cea05468ad126d74a2c4417b1f8f1ae","b6fc0b7cb44e77725c6eb47a561f55b7db7a2434156510c1cdd1b2c8ea67d8b3","054821fedb7c3060cb5d261f281f0df8b6f81bce298841dc474b1b5f66f8ca2f","e6aa090915e3098a5eb7826188b7b20fc083618e49d3bfd1ed8f543d5e803547","a894db963d0c9630928c3f69f701f600ae230c31b2b65ac4dcf718a1193b9c0c","8f419e77f1ef495e57790629310f60b956efb06941bc63e9bfaa53978994bebd"],"paragraph_range_zero_based":[4704,4727],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p4704"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4728},{"literal_text_all_w_t_and_m_t":"slss-SupportedTxFreq","paragraph_zero_based":4729},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports the SLSS transmission on single carrier or on multiple carriers in the case of sidelink carrier aggregation.","paragraph_zero_based":4730},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4731},{"literal_text_all_w_t_and_m_t":"slss-TxRx","paragraph_zero_based":4732},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports SLSS/PSBCH transmission and reception in UE autonomous resource selection mode and eNB scheduled mode in a band for V2X sidelink communication.","paragraph_zero_based":4733},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4734},{"literal_text_all_w_t_and_m_t":"sl-TxDiversity","paragraph_zero_based":4735},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports transmit diversity for V2X sidelink communication. See TS 36.101 [42].","paragraph_zero_based":4736},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4737},{"literal_text_all_w_t_and_m_t":"sn-SizeLo","paragraph_zero_based":4738},{"literal_text_all_w_t_and_m_t":"Same as \"shortSN\" defined in TS 38.306 [87].","paragraph_zero_based":4739},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":4740},{"literal_text_all_w_t_and_m_t":"spatialBundling-HARQ-ACK","paragraph_zero_based":4741},{"literal_text_all_w_t_and_m_t":"Indicates whether UE supports HARQ-ACK spatial bundling on PUCCH or PUSCH as specified in TS 36.213 [23], clauses 7.3.1 and 7.3.2.","paragraph_zero_based":4742},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":4743},{"literal_text_all_w_t_and_m_t":"spdcch-differentRS-types","paragraph_zero_based":4744},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports monitoring of sPDCCH on RB sets with different RS types within a TTI.","paragraph_zero_based":4745},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4746},{"literal_text_all_w_t_and_m_t":"spdcch-Reuse","paragraph_zero_based":4747},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports L1 based SPDCCH reuse.","paragraph_zero_based":4748},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4749},{"literal_text_all_w_t_and_m_t":"sps-CyclicShift","paragraph_zero_based":4750},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports RRC configuration of cyclic shift for DMRS for UL SPS using 1ms TTI.","paragraph_zero_based":4751}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["b7eaa3f5e5ce130f52a5dbbeb55e9d053dd954623ad9d6de399122e1a8a65a52","c6031b66455c5736884cbdfe5494e43995b27baffc6dec15cbcc1e2c630cd7c2","2b2baaca2a6c3e339f69c5f8ba17e36e713ede5fad32843598481338492ee56a","635643763ad927cc9cf1107a4caa88bc0733cf749cf86fd4f2bf8bc73e8f0988","8214efef59530ee4c58df9cdee0a36f275dfb242aa44e173911b98262ab0b2f3","3cb5eda7102f0c300e2ab78803062e871dcb75ed49499779c522e9e22221f634","883b7fc1f102a0f7ac0a2d3f9cb3a04c352ecd557a7372d0494ce1a20e4b85d7","05ead926458d48cf6ec2d46b684d493164b2cfca9fe1c76cf41bac10aae5dfaf","dfa29b37bee8462663458ba2ab0f8d2b73066c4c4a08f7e8aedd1e1e985f0b1d","1583b643128fc02f805497115456f976e10c1ad4657a0d50d57ed9e5a7a6ce8e","23fc31ff7938871107c7562fa2cbe84088f8b39ea64b777b4a9a13e2894bd28f","d57bfdb61c55ff6b48dffe5cb57909783c5b58e2f8e710b6e8544b47f4c0bd66","5aa9cf4c7b896ee3fba26c1987acb058e12fbd01e1d9c259b790a3077c38ff59","1457583a142d812d6f1e6a6fc8290b3823bb7ef6aadb089f52df417644897e19","a385f3d3705ddec4b121b978de6b17cf82271a950101f15be1959ad40cdae1c4","56d0622de06136c67d35d320babf48834f33c7e996cca71edec674a9e8223696","564c7bcdd7b62312a9bcb2332be1eba04ce12308ecb61279591cb8a710c46234","e5340376197f6cbff898dc77b908498c9a5087fbfb4d87704761ed7cc7a4acdd","62083563fa12778c4638d2ff87c0d950d3d877174700b74b1cbcc5d618258888","9279b912a70658716cb9729d91fa4f328a2bab41b5eef6627130244081972db5","bbfae252c6805cf3b133e54ea64b3d6bad6fef37b864a92f0b915e31e6045a8b","06180f6732865a0d8e5a3b482aba3ca071ab015dbaa102a4ce729b71747a87c4","a70db7b8dce5e2903dcbdbd453f59a9cb84e324c22ced88a376d0869102feffb","cfafb284166c572271f6cb9aec572c2f0c39cc9850d20eb0a5da6cd9faada545"],"paragraph_range_zero_based":[4728,4751],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p4728"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4752},{"literal_text_all_w_t_and_m_t":"sps-ServingCell","paragraph_zero_based":4753},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports multiple UL/DL SPS configurations simultaneously active on different serving cells as specified in TS 36.321 [6].","paragraph_zero_based":4754},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4755},{"literal_text_all_w_t_and_m_t":"sps-STTI","paragraph_zero_based":4756},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports SPS in DL and/or UL for slot or subslot based PDSCH and PUSCH, respectively. ","paragraph_zero_based":4757},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4758},{"literal_text_all_w_t_and_m_t":"srs-DCI7-TriggeringFS2","paragraph_zero_based":4759},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports SRS triggerring via DCI format 7 for FS2.","paragraph_zero_based":4760},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4761},{"literal_text_all_w_t_and_m_t":"srs-Enhancements","paragraph_zero_based":4762},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports SRS enhancements.","paragraph_zero_based":4763},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4764},{"literal_text_all_w_t_and_m_t":"srs-EnhancementsTDD","paragraph_zero_based":4765},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports TDD specific SRS enhancements.","paragraph_zero_based":4766},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4767},{"literal_text_all_w_t_and_m_t":"srs-FlexibleTiming","paragraph_zero_based":4768},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports configuration of soundingRS-FlexibleTiming-r14 for the corresponding band pair. For a TDD-TDD band pair, UE shall include at least one of srs-FlexibleTiming and/or srs-HARQ-ReferenceConfig when rf-RetuningTimeDL or rf-RetuningTimeUL corresponding to the band pair is larger than 1 OFDM symbol.","paragraph_zero_based":4769},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4770},{"literal_text_all_w_t_and_m_t":"srs-HARQ-ReferenceConfig","paragraph_zero_based":4771},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports configuration of harq-ReferenceConfig-r14 for the corresponding band pair. For a TDD-TDD band pair, UE shall include at least one of srs-FlexibleTiming and/or srs-HARQ-ReferenceConfig when rf-RetuningTimeDL or rf-RetuningTimeUL corresponding to the band pair is larger than 1 OFDM symbol.","paragraph_zero_based":4772},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4773},{"literal_text_all_w_t_and_m_t":"srs-MaxSimultaneousCCs","paragraph_zero_based":4774},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of simultaneously configurable target CCs for SRS switching (i.e., CCs for which srs-SwitchFromServCellIndex is configured) supported by the UE.","paragraph_zero_based":4775}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["cabc3ae6c58cda1e67e75608749943b0620e344d3a873c09d24d676b6f43aee0","b0e0d3421236d3cfbe875ed24de4df4a7c175bb34172025f62428825929c9e5c","af58c617a7639d10c587e2e6016546e3540487a62d9e19cedd1e5bd1888b9ee6","edf9c173def6e4f897c35a2f891bcb2680c8862bd55d3214add9b04f0cafe7cf","5f94a7814aa559308a970ccdb51df05a8f51f19068b7ff036b1f1d70d60220a6","acbba73705937e9165dd574eee57f3554b2960535e301426e24d37f511c23522","c49091fc584865252ce67d9df2040bb076a946461fb950e2c744868b27377548","268a5036a94ca2a029963ad9fd363b84ce637c0bfcc9