{"fields":{"filename":"R2-2409923.zip::R2-2409923 Clarification on LTM capabilities.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Impacted functionality: ","paragraph_zero_based":72},{"literal_text_all_w_t_and_m_t":"LTM, RedCap, eRedCap","paragraph_zero_based":73},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":74},{"literal_text_all_w_t_and_m_t":"Interoperability:","paragraph_zero_based":75},{"literal_text_all_w_t_and_m_t":"If the UE is implemented in accordance with the changes and the network is not, there is no interoperability foreseen. If the network is implemented in accordance with the changes and the UE is not, there is no interoperability foreseen.","paragraph_zero_based":76},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":77},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":78},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":79},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":80},{"literal_text_all_w_t_and_m_t":"4.2.21.1, 4.2.22.1","paragraph_zero_based":81},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":82},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":83},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":84},{"literal_text_all_w_t_and_m_t":"Y","paragraph_zero_based":85},{"literal_text_all_w_t_and_m_t":"N","paragraph_zero_based":86},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":87},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":88},{"literal_text_all_w_t_and_m_t":"Other specs","paragraph_zero_based":89},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":90},{"literal_text_all_w_t_and_m_t":"X","paragraph_zero_based":91},{"literal_text_all_w_t_and_m_t":" Other core specifications","paragraph_zero_based":92},{"literal_text_all_w_t_and_m_t":"TS/TR ... CR ...","paragraph_zero_based":93},{"literal_text_all_w_t_and_m_t":"affected:","paragraph_zero_based"