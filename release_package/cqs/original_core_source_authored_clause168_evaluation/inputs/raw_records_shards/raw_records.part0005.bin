{"fields":{"filename":"R2-2408387.zip::R2-2408387 - CR_Correction on NES field descriptions.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"                p32                                 BIT STRING (SIZE (32))","paragraph_zero_based":336},{"literal_text_all_w_t_and_m_t":"            }                                                                                               OPTIONAL,   -- Need R","paragraph_zero_based":337},{"literal_text_all_w_t_and_m_t":"            non-PMI-PortIndication-r18          SEQUENCE (SIZE (1..maxNrofNZP-CSI-RS-ResourcesPerConfig)) OF PortIndexFor8Ranks","paragraph_zero_based":338},{"literal_text_all_w_t_and_m_t":"                                                                                                            OPTIONAL   --  Need R","paragraph_zero_based":339},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":340},{"literal_text_all_w_t_and_m_t":"        a2-parameters                       SEQUENCE {","paragraph_zero_based":341},{"literal_text_all_w_t_and_m_t":"            nzp-CSI-RS-ResourceList-r18         SEQUENCE (SIZE (1..maxNrofNZP-CSI-RS-ResourcesPerSet)) OF NZP-CSI-RS-ResourceIndex-r18","paragraph_zero_based":342},{"literal_text_all_w_t_and_m_t":"        }","paragraph_zero_based":343},{"literal_text_all_w_t_and_m_t":"    }                                                                                                       OPTIONAL,   -- Need R","paragraph_zero_based":344},{"literal_text_all_w_t_and_m_t":"    powerOffset-r18                     INTEGER(0..23)                                                      OPTIONAL    -- Need R","paragraph_zero_based":345},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":346},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":347},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-ResourceIndex-r18 ::=    INTEGER (0..maxNrofNZP-CSI-RS-ResourcesPerSet-1-r18)","paragraph_zero_based":348},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":349},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-REPORTCONFIG-STOP","paragraph_zero_based":350},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":351},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":352},{"literal_text_all_w_t_and_m_t":"CSI-ReportConfig field descriptions","paragraph_zero_based":353},{"literal_text_all_w_t_and_m_t":"carrier","paragraph_zero_based":354},{"literal_text_all_w_t_and_m_t":"Indicates in which serving cell the CSI-ResourceConfig indicated below are to be found. If the field is absent, the resources are on the same serving cell as this report configuration.","paragraph_zero_based":355},{"literal_text_all_w_t_and_m_t":"codebookConfig","paragraph_zero_based":356},{"literal_text_all_w_t_and_m_t":"Codebook configuration for Type-1 or Type-2 including codebook subset restriction. Network can only configure one of codebookConfig, codebookConfig-r16 or codebookConfig-r17 or codebookConfig-r18 in a CSI-ReportConfig. The network includes codebookConfig-v1730 only if codebookConfig-r17 is configured.","paragraph_zero_based":357},{"literal_text_all_w_t_and_m_t":"cqi-BitsPerSubband","paragraph_zero_based":358},{"literal_text_all_w_t_and_m_t":"This field can only be present if cqi-FormatIndicator is set to subbandCQI. If the field is configured with bits4, the UE uses 4-bit sub-band CQI. If the field is not present and cqi-FormatIndicator is set to subbandCQI, the UE uses 2-bit sub-band differential CQI.","paragraph_zero_based":359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"cf905337742c9f19496d5c85a2bc3ca156a35a8b1e77067904260ae404f7b0e1","original_member_sha256":"ec23412413a4460feb833f742d1419bbd28ea8915314355a29d962fd6d7655ac","paragraph_ElementTree_utf8_XML_sha256":["4458f8c84dac30c84977121820667b55e244d5bef870497b6676adda453d6579","3c494b948d3e1018f779945f48f41d914c05230b14901ac156dcd64c9a6a09d9","9dbabdc685c06dd71eacd4a5fca89f5e0b9bfc9ed3822e7372a5a74c6fd34f11","533c35b1727df7be7d8f02055f33c757029f18a99317150252d22c5b2a99b2da","7714f4bc57021385e1d3a56ddc4c8e89ac62d1f6d7eafa1a3f43fe77683db265","bc71e65d3a800789d06b7bab5f894f2c2b24c6fafb8c4348f6cde0c0d60bbedc","9ffd39a971566f23a22acb098483a37b2eb93c75392fe962b3db6ea5c4114de7","41fdfacac8635a7005caf7d01904e57b775c747aeb937b10e01a239e4aed9e41","c20b1f41160e8fd00eb33a5f71283a391a2c316040f502c667c518f304d4f3ed","ef43e41b68cad9817bc286afdadd702590c6584e0a5c3058cf39d3ce7cb21da6","b52505a91f970dc3de0cfff7aad157ec195a2cfdbec134b18149d61888246262","76360f2cebfc2f1b442ac55830283fe5a814bf789c7e57d08759fbc38316d827","2f75ee3e62c277ad24b0b648d2a643bd9d291f7cee9a08e4cc60041cd2c94e5c","402df0e63109fb2de79548e161f747b0e80b93a24dff6233bf3123783038c8cf","7e0b19bb76d660157c008b4f829e7c2724e49b0dba17ea262e2733cf804ab057","a6c8afca0706a5f4e89fb472e3ca6c9d9478149b72ca40bdaab41c07ab48ebb0","940d38224d486cd691711dbd470831dcf862fe5aa51f303ed052ae977c4b6d58","7bc39969d67ca0f6403a27cd7a0eca6ccd50701732fc0d6afa3561244074a57c","b9913b82fb1727fa07b709b3a95b9193964c1e0628505f308feb1678cc7e94ec","942756929d7dab6d53415601920c90f80c383df59add116c618065a709f812f2","fbd2d032b23f5ff561bf8c9ab97df423de1eb7622a85193e0b0ff3bf29f64bbc","7fbec00885d49545c4d0b4c99a33afbcb0a242608a9cbf980bdf3c341ab6e747","0e2c75190a537a2686bcc47425d062106b693e912a90459cd1545bc056965a53","995299e4095dbdd82f1b2f6e5cb25e16816f55626a383d52a7a431567e4df026"],"paragraph_range_zero_based":[336,359],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2408387.zip::R2-2408387 - CR_Correction on NES field descriptions.docx:p336"}
{"fields":{"filename":"R2-2408387.zip::R2-2408387 - CR_Correction on NES field descriptions.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"cqi-FormatIndicator","paragraph_zero_based":360},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE shall report a single (wideband) or multiple (subband) CQI (see TS 38.214 [19], clause 5.2.1.4).","paragraph_zero_based":361},{"literal_text_all_w_t_and_m_t":"cqi-Table","paragraph_zero_based":362},{"literal_text_all_w_t_and_m_t":"Which CQI table to use for CQI calculation (see TS 38.214 [19], clause 5.2.2.1). For an (e)RedCap UE, CQI table 2 is only supported if the UE indicates support of 256QAM for PDSCH.","paragraph_zero_based":363},{"literal_text_all_w_t_and_m_t":"csi-IM-ResourcesForInterference","paragraph_zero_based":364},{"literal_text_all_w_t_and_m_t":"CSI IM resources for interference measurement. csi-ResourceConfigId of a CSI-ResourceConfig included in the configuration of the serving cell indicated with the field \"carrier\" above. The CSI-ResourceConfig indicated here contains only CSI-IM resources. The bwp-Id in that CSI-ResourceConfig is the same value as the bwp-Id in the CSI-ResourceConfig indicated by resourcesForChannelMeasurement.","paragraph_zero_based":365},{"literal_text_all_w_t_and_m_t":"csi-ReportingBand","paragraph_zero_based":366},{"literal_text_all_w_t_and_m_t":"Indicates a contiguous or non-contiguous subset of subbands in the bandwidth part which CSI shall be reported for. Each bit in the bit-string represents one subband in order of frequency position in the BWP. The right-most bit in the bit string represents the lowest subband with the lowest frequency position in the BWP. The choice determines the number of subbands (subbands3 for 3 subbands, subbands4 for 4 subbands, and so on) (see TS 38.214 [19], clause 5.2.1.4). This field is absent if there are less than 24 PRBs (no sub band) and present otherwise (see TS 38.214 [19], clause 5.2.1.4).","paragraph_zero_based":367},{"literal_text_all_w_t_and_m_t":"NOTE:In TS 38.212 [17] clause 6.3.1.1.2 and TS 38.214 [19] clause 5.2.1.4, only subbands to be reported are numbered, e.g. subband #0 is the subband corresponding to the right-most bit set to 1.","paragraph_zero_based":368},{"literal_text_all_w_t_and_m_t":"csi-ReportMode","paragraph_zero_based":369},{"literal_text_all_w_t_and_m_t":"Configures the CSI report modes Mode1 or Mode 2 (see TS 38.214 [19], clause 5.2.1.4.2)","paragraph_zero_based":370},{"literal_text_all_w_t_and_m_t":"csi-ReportSubConfigToAddModList","paragraph_zero_based":371},{"literal_text_all_w_t_and_m_t":"List of CSI-ReportSubConfiguration(s) in a CSI report configuration to add or modify. No simultaneous configuration of portSubsetIndicator and a list of nzp-CSI-RS-resources in a same CSI report sub-configuration. The number of elements in a list is at least 2.","paragraph_zero_based":372},{"literal_text_all_w_t_and_m_t":"csi-ReportSubConfigToReleaseList","paragraph_zero_based":373},{"literal_text_all_w_t_and_m_t":"List of CSI-ReportSubConfiguration(s) in a CSI report configuration to release.","paragraph_zero_based":374},{"literal_text_all_w_t_and_m_t":"dummy","paragraph_zero_based":375},{"literal_text_all_w_t_and_m_t":"This field is not used in the specification. If received it shall be ignored by the UE.","paragraph_zero_based":376},{"literal_text_all_w_t_and_m_t":"groupBasedBeamReporting","paragraph_zero_based":377},{"literal_text_all_w_t_and_m_t":"Turning on/off group beam based reporting (see TS 38.214 [19], clause 5.2.1.4). If groupBasedBeamReporting (without suffix) is set to disabled, groupBasedBeamReporting-v1710 and groupBasedBeamReporting-v1800 is absent.","paragraph_zero_based":378},{"literal_text_all_w_t_and_m_t":"non-PMI-PortIndication","paragraph_zero_based":379},{"literal_text_all_w_t_and_m_t":"Port indication for RI/CQI calculation. For each CSI-RS resource in the linked ResourceConfig for channel measurement, a port indication for each rank R, indicating which R ports to use. Applicable only for non-PMI feedback (see TS 38.214 [19], clause 5.2.1.4.2).","paragraph_zero_based":380},{"literal_text_all_w_t_and_m_t":"The first entry in non-PMI-PortIndication corresponds to the NZP-CSI-RS-Resource indicated by the first entry in nzp-CSI-RS-Resources in the NZP-CSI-RS-ResourceSet indicated in the first entry of nzp-CSI-RS-ResourceSetList of the CSI-ResourceConfig whose CSI-ResourceConfigId is indicated in a CSI-MeasId together with the above CSI-ReportConfigId; the second entry in non-PMI-PortIndication corresponds to the NZP-CSI-RS-Resource indicated by the second entry in nzp-CSI-RS-Resources in the NZP-CSI-RS-ResourceSet indicated in the first entry of nzp-CSI-RS-ResourceSetList of the same CSI-ResourceConfig, and so on until the NZP-CSI-RS-Resource indicated by the last entry in nzp-CSI-RS-Resources in the in the NZP-CSI-RS-ResourceSet indicated in the first entry of nzp-CSI-RS-ResourceSetList of the same CSI-ResourceConfig. Then the next entry corresponds to the NZP-CSI-RS-Resource indicated by the first entry in nzp-CSI-RS-Resources in the NZP-CSI-RS-ResourceSet indicated in the second entry of nzp-CSI-RS-ResourceSetList of the same CSI-ResourceConfig and so on.","paragraph_zero_based":381},{"literal_text_all_w_t_and_m_t":"nrofReportedGroups","paragraph_zero_based":382},{"literal_text_all_w_t_and_m_t":"Number of reported resource groups per CSI-report. Value n1 means one resource group, n2 means 2 resource groups, and so on. If nrofReportedGroups is configured, the UE ignores groupBasedBeamReporting (without suffix).","paragraph_zero_based":383}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"cf905337742c9f19496d5c85a2bc3ca156a35a8b1e77067904260ae404f7b0e1","original_member_sha256":"ec23412413a4460feb833f742d1419bbd28ea8915314355a29d962fd6d7655ac","paragraph_ElementTree_utf8_XML_sha256":["d6b22cc5014f31fc21b1144e31ef3ef87f94b1dec2f8bb2715fcf0cb1d7c403d","aee570281c7291bd09fe800fa3c527d030c699081aa7e76b07bdc8c526e8cdad","e5e22f734c8088886d9dc43b6bd34be4086029989e6a1131978ddb15c4fdb9d1","17f931d2c7c7a23767086a7bf55ba5cb40cdf44aafcce49b9fd1ce041130bc75","a56d383183590bb6552b0a005bf73a7cbde434896e74cd52dd4e69d9d385d1a1","b6db7663e4da75d6395086bd3e61754a0521ea94c95155eac6ebc7126fced269","0d73f0d9bf32dacd1763e37e2b20d15115c296265cc37b5525e3ae4ec04621ba","21d98103187f9c91085a582418bf3dba707f4dbd6f13160987a549d24479db7a","1529a9e21b88671f10a920184ff1f437e7b430274cf6eb1ae005fa973d3f24da","61260b00b4444394a69b8d927d9c54200db46489b9c2b9defdc0a46e1fdf3a1a","d0b4fdc69d6bb86eda9d180978e4230b5624118b9df367d6f5c7afb12bf642bc","48e1b0b7c9d437fd4cd6a357832ec48784eb793b21c9519a9312ba042c6bdd6b","33c008003e521792e7c1f8adc7492a3f72d84e5dd98d819068715099f14c5fdc","8135c95886cf3a3b3b15556e0f1096a2582bc9b6ac5416ed3cf5fb888c392c30","c885c657a93ecb566129ff02af69047910eabd6e2224089104e8185dcca74a89","f8da2bee8d7b09534b6aa14545dc1b1b712488ee099323f4e9b039d652ac9f40","67a986f77d905d89f4eff39ce730a103e9cd595ca998fa3acd190909f4ef7715","316530935bb0f5170aa200bf0e530a425016dce91f4bfae9d50e83de479f8ed3","c9fdd492098f004f3592ede08d9803f776fd5557226e6a154fda5b38a1d89a24","61b5580a58e10a5feb3accfd0a6c8fff84ec40b667201bc7e0aaac5848bf4331","ef2f99e774bc0ee965a5c8676bec7756e2555a1176dc5451cc430946d5feecc9","da02105dfc6eb2f53fc7e73cc68f4e4f2682259ecd9c7d19ac2102c6e1dc4600","54c28245cd6955d2b67de1d4b1c564f519822e2cf1b50fb245d6cf09fc5c0679","35865ced9eaeb7a92a47d60788225e699fe776339cc1e35f206ef5a91db8cf9b"],"paragraph_range_zero_based":[360,383],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2408387.zip::R2-2408387 - CR_Correction on NES field descriptions.docx:p360"}
{"fields":{"filename":"R2-2408387.zip::R2-2408387 - CR_Correction on NES field descriptions.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"nrofReportedRS","paragraph_zero_based":384},{"literal_text_all_w_t_and_m_t":"The number (N) of measured RS resources to be reported per report setting in a non-group-based report. N <= N_max, where N_max is either 2 or 4 depending on UE capability.","paragraph_zero_based":385},{"literal_text_all_w_t_and_m_t":"(see TS 38.214 [19], clause 5.2.1.4) When the field is absent the UE applies the value 1.","paragraph_zero_based":386},{"literal_text_all_w_t_and_m_t":"numberOfSingleTRP-CSI-Mode1","paragraph_zero_based":387},{"literal_text_all_w_t_and_m_t":"Configures the number of reported X CSIs when csi-ReportMode is set to 'Mode 1' as described in TS 38.214 [19], clause 5.2.1.4.2. The field is present only if csi-ReportMode configures Mode 1.","paragraph_zero_based":388},{"literal_text_all_w_t_and_m_t":"nzp-CSI-RS-ResourcesForInterference","paragraph_zero_based":389},{"literal_text_all_w_t_and_m_t":"NZP CSI RS resources for interference measurement. csi-ResourceConfigId of a CSI-ResourceConfig included in the configuration of the serving cell indicated with the field \"carrier\" above. The CSI-ResourceConfig indicated here contains only NZP-CSI-RS resources. The bwp-Id in that CSI-ResourceConfig is the same value as the bwp-Id in the CSI-ResourceConfig indicated by resourcesForChannelMeasurement.","paragraph_zero_based":390},{"literal_text_all_w_t_and_m_t":"p0alpha","paragraph_zero_based":391},{"literal_text_all_w_t_and_m_t":"Index of the p0-alpha set determining the power control for this CSI report transmission (see TS 38.214 [19], clause 6.2.1.2).","paragraph_zero_based":392},{"literal_text_all_w_t_and_m_t":"pdsch-BundleSizeForCSI","paragraph_zero_based":393},{"literal_text_all_w_t_and_m_t":"PRB bundling size to assume for CQI calculation when reportQuantity is CRI/RI/i1/CQI. If the field is absent, the UE assumes that no PRB bundling is applied (see TS 38.214 [19], clause 5.2.1.4.2).","paragraph_zero_based":394},{"literal_text_all_w_t_and_m_t":"pmi-FormatIndicator","paragraph_zero_based":395},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE shall report a single (wideband) or multiple (subband) PMI. (see TS 38.214 [19], clause 5.2.1.4).","paragraph_zero_based":396},{"literal_text_all_w_t_and_m_t":"pucch-CSI-ResourceList","paragraph_zero_based":397},{"literal_text_all_w_t_and_m_t":"Indicates which PUCCH resource to use for reporting on PUCCH.","paragraph_zero_based":398},{"literal_text_all_w_t_and_m_t":"reportConfigType","paragraph_zero_based":399},{"literal_text_all_w_t_and_m_t":"Time domain behavior of reporting configuration.","paragraph_zero_based":400},{"literal_text_all_w_t_and_m_t":"reportFreqConfiguration","paragraph_zero_based":401},{"literal_text_all_w_t_and_m_t":"Reporting configuration in the frequency domain. (see TS 38.214 [19], clause 5.2.1.4).","paragraph_zero_based":402},{"literal_text_all_w_t_and_m_t":"reportQuantity","paragraph_zero_based":403},{"literal_text_all_w_t_and_m_t":"The CSI related quantities to report. see TS 38.214 [19], clause 5.2.1. If the field reportQuantity-r16, reportQuantity-r17 or reportQuantity-r18 is present, UE shall ignore reportQuantity (without suffix). Network does not configure reportQuantity-r17 or reportQuantity-r18 together with reportQuantity-r16.","paragraph_zero_based":404},{"literal_text_all_w_t_and_m_t":"reportingMode","paragraph_zero_based":405},{"literal_text_all_w_t_and_m_t":"Configures the UE with reporting mode for group based reporting.(see TS 38.214 [19] clause 5.2.1.4).","paragraph_zero_based":406},{"literal_text_all_w_t_and_m_t":"reportSlotConfig","paragraph_zero_based":407}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"cf905337742c9f19496d5c85a2bc3ca156a35a8b1e77067904260ae404f7b0e1","original_member_sha256":"ec23412413a4460feb833f742d1419bbd28ea8915314355a29d962fd6d7655ac","paragraph_ElementTree_utf8_XML_sha256":["f27e36e85c160561ede77c2b9478d89f0112847838d5d4e890faad0fb4ffe3a0","1a87791f0de56abddcf8580b73fb6a7709670a49a75132abbf8ff91cdd323a21","33a473169471410a2287477cee87c2a25c914d11391ae9e6141e01022e770199","e2df59bb9c49d7dd10058585d31b2d8652ff9dd160169f2ae81f157f97765870","74937bf923aacc276ca3bd69577515bfadeca1c498d742764fd971a56a84a389","b6ca83462d25c7339fbddeba54277c453acde8c0670ae72c9bc9cd750e10e4a7","ec500316f3c763ef0fcd7656a9d494eeea14e87930d1a7f8b655235139c519c2","5f8bbc50d820aa89af03e05f44b46de3ea9b6d92d20e278c7f0df755d3f7f14f","cbfecbf87d57ac434cac810b086c73e6f6f86cc7816c7a8c689a92837aa1cc9f","c70547f0ae8fbb729e28ec22e6bd5f5df647d151a08475325332f68dc81cd2d2","2266e835d46961496f579273b8cfe386f059355652657baaa2802111a5bb83bd","ef36003cf7f840f3f92b242b0e4a298a3c549640bf274145af0e574742cf87f5","d63afffbc373deb4dc1384f00175f1238884cec428d18991e5db74a5b59416a7","0622a552b1d05d8e29d6dcbf3eeaf29d577cce266fba9a6ffa3f6d31d1076799","ffef2defa77bf7e218c316289573b9f9afc986c1794cc7713da0fd877ad65275","b9adbbe3e1d9a2cc846fe0f19d0dd25d18963675a09805bb7f1407fd41514f94","6775b89e645c4c0bf1fd4cad087ee9075bfca90714099b0718a71a2154912e1d","7456f1aa893a451c3b873aaec5f68252d8def0f47d2b594d561c64780d81d80a","4a7a019da7eae236b4833d8e167a55d84f728571a8d0e2f491ef4dcc3be590f1","34e5f3cfc18c1ef7b27febb97d299e38cfef0d04028ede66e90bf1f61505452d","474dec74a053cd532eba660ba27e1e4ea810c0b3027f8e8f5f8197ffd41fa349","c0a0db817d480085d3680a74751d31e9aa18e5c2116ded28df2f55369b77250d","825abde5c9a41f669e7b5674d97250d6477a6ce47729612fdd743e686fd2dc7a","62348ab5c84eb7a54d0bf27072a42ba6fdb96b468fc66f30ffa3d0a41eac72a0"],"paragraph_range_zero_based":[384,407],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2408387.zip::R2-2408387 - CR_Correction on NES field descriptions.docx:p384"}
{"fields":{"filename":"R2-2408387.zip::R2-2408387 - CR_Correction on NES field descriptions.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Periodicity and slot offset (see TS 38.214 [19], clause 5.2.1.4). If the field reportSlotConfig-v1530 is present, the UE shall ignore the value provided in reportSlotConfig (without suffix).","paragraph_zero_based":408},{"literal_text_all_w_t_and_m_t":"reportSlotOffsetList, reportSlotOffsetListDCI-0-1, reportSlotOffsetListDCI-0-2","paragraph_zero_based":409},{"literal_text_all_w_t_and_m_t":"Timing offset Y for semi persistent reporting using PUSCH. This field lists the allowed offset values. This list must have the same number of entries as the pusch-TimeDomainAllocationList in PUSCH-Config. A particular value is indicated in DCI. The network indicates in the DCI field of the UL grant, which of the configured report slot offsets the UE shall apply. The DCI value 0 corresponds to the first report slot offset in this list, the DCI value 1 corresponds to the second report slot offset in this list, and so on. The first report is transmitted in slot n+Y, second report in n+Y+P, where P is the configured periodicity.","paragraph_zero_based":410},{"literal_text_all_w_t_and_m_t":"Timing offset Y for aperiodic reporting using PUSCH. This field lists the allowed offset values. This list must have the same number of entries as the pusch-TimeDomainAllocationList in PUSCH-Config. A particular value is indicated in DCI. The network indicates in the DCI field of the UL grant, which of the configured report slot offsets the UE shall apply. The DCI value 0 corresponds to the first report slot offset in this list, the DCI value 1 corresponds to the second report slot offset in this list, and so on (see TS 38.214 [19], clause 6.1.2.1).","paragraph_zero_based":411},{"literal_text_all_w_t_and_m_t":"The field reportSlotOffsetListDCI-0-1 applies to DCI format 0_1 and the field reportSlotOffsetListDCI-0-2 applies to DCI format 0_2 (see TS 38.214 [19], clause 6.1.2.1).","paragraph_zero_based":412},{"literal_text_all_w_t_and_m_t":"The fields reportSlotOffsetList-r17, reportSlotOffsetListDCI-0-1-r17 and reportSlotOffsetListDCI-0-2-r17 are only applicable for SCS 480 kHz and 960 kHz and if they are configured, the UE shall ignore the fields reportSlotOffsetList (without suffix), reportSlotOffsetListDCI-0-1 (without suffix) and reportSlotOffsetListDCI-0-2 (without suffix) for SCS 480 kHz and 960 kHz.","paragraph_zero_based":413},{"literal_text_all_w_t_and_m_t":"resourcesForChannelMeasurement","paragraph_zero_based":414},{"literal_text_all_w_t_and_m_t":"Resources for channel measurement. csi-ResourceConfigId of a CSI-ResourceConfig included in the configuration of the serving cell indicated with the field \"carrier\" above. The CSI-ResourceConfig indicated here contains only NZP-CSI-RS resources and/or SSB resources. This CSI-ReportConfig is associated with the DL BWP indicated by bwp-Id in that CSI-ResourceConfig.","paragraph_zero_based":415},{"literal_text_all_w_t_and_m_t":"sharedCMR","paragraph_zero_based":416},{"literal_text_all_w_t_and_m_t":"Enables sharing of channel measurement resources between different CSI measurement hypotheses when (1) csi-ReportMode is set to 'Mode1' and numberOfSingleTRP-CSI-Mode1 is set to 1 or 2; or (2) csi-ReportMode is set to 'Mode2' (see TS 38.214 [19], clause 5.2.1.4.2).","paragraph_zero_based":417},{"literal_text_all_w_t_and_m_t":"subbandSize","paragraph_zero_based":418},{"literal_text_all_w_t_and_m_t":"Indicates one out of two possible BWP-dependent values for the subband size as indicated in TS 38.214 [19], table 5.2.1.4-2 . If csi-ReportingBand is absent, the UE shall ignore this field.","paragraph_zero_based":419},{"literal_text_all_w_t_and_m_t":"timeRestrictionForChannelMeasurements","paragraph_zero_based":420},{"literal_text_all_w_t_and_m_t":"Time domain measurement restriction for the channel (signal) measurements (see TS 38.214 [19], clause 5.2.1.1).","paragraph_zero_based":421},{"literal_text_all_w_t_and_m_t":"timeRestrictionForInterferenceMeasurements","paragraph_zero_based":422},{"literal_text_all_w_t_and_m_t":"Time domain measurement restriction for interference measurements (see TS 38.214 [19], clause 5.2.1.1).","paragraph_zero_based":423},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":424},{"literal_text_all_w_t_and_m_t":"CSI-ReportSubConfig field descriptions","paragraph_zero_based":425},{"literal_text_all_w_t_and_m_t":"codebookSubConfig","paragraph_zero_based":426},{"literal_text_all_w_t_and_m_t":"Applicable codebook parameters for the ports indicated by portSubsetIndicator. Applicable value ranges for codebook subset restriction, rank restriction, N1, N2, and Ng and twoTX-CodebookSubsetRestriction follow existing specification according to the codebookConfig configured within the CSI-ReportConfig, and apply for the number of ports determined by portSubsetIndicator (see TS 38.214 [19], clause 5.2.1.4.2). In this field, the network always sets the codebookType to type1. When reportQuantity is set to 'cri-RI-i1-CQI', the parameter typeISinglePanel-codebookSubsetRestriction-i2 is mandatory to be configured in the codebookSubConfig for each sub-configuration that includes portSubsetIndicator.","paragraph_zero_based":427},{"literal_text_all_w_t_and_m_t":"non-PMI-PortIndication","paragraph_zero_based":428},{"literal_text_all_w_t_and_m_t":"Port indication for RI/CQI calculation applicable only for non-PMI feedback. The field shall be configured only if the portSubsetIndicator-r18 is configured.","paragraph_zero_based":429},{"literal_text_all_w_t_and_m_t":"For each CSI-RS resource in the linked CSI-ResourceConfig for channel measurement, a port indication for each rank R, indicating which R ports out of P ports to use within the sub-configuration. P corresponds to the number of bits with value 1 in the bitmap portSubsetIndicator-r18.","paragraph_zero_based":430},{"literal_text_all_w_t_and_m_t":"nzp-CSI-RS-ResourceList","paragraph_zero_based":431}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"cf905337742c9f19496d5c85a2bc3ca156a35a8b1e77067904260ae404f7b0e1","original_member_sha256":"ec23412413a4460feb833f742d1419bbd28ea8915314355a29d962fd6d7655ac","paragraph_ElementTree_utf8_XML_sha256":["1e26dc83cd87e9c8eaaab684ab778ddc372d0d6893c911a28c2259d5731fb2d8","92eb1d5f5077ba338b3c88db6d0f31bced4182faa9c815dcd608a6b08c58ebd7","35db801e6aa93f5bd11c7c48e9eea874b37589c88074bb81478004a6a651349f","266aad0a3bcad11dab61ebc4535a8937726a5ee35e66d8b4b1d4c9cd2daf157d","30745c6a6e2ad4ba634861a09af5fbbba27039f56ec31871e622f1651048fe59","4e16cfa19b943005d852cd568b5f2277e5af1941b4b93551efe8fb71e682c423","beef7e8d25b4d3e0c49be01f04a92fbf8e384b0871ec4a130d651b7c8c6bfbb4","5bbdf9b04d5d879e14a1805c90fcd6b58fc621f3f74690edab9cffaba78d7f0a","4ef2c338f9a004bb2a49858a0578cfc4671875e34d8cc84ad337c95dd34b96b3","d715b861fde2d43b0133f859dea714e4a1c9e8701e4f12f298dafef7aed2be26","de9c17ece0b9fac985090505cddb8f541b413981d6de943f18d15b0ff1cbec52","84ebdfe8f1956df037c5f96a1d2c961c305ed484e400935cf833db711211aa0c","562de91d04fb3805a6c36cc22efb1c82766d878f02a79e3fccdfabae67c91aef","ee0089ff7aa8b6577d1a73c5d414fd910b61a2f79c7319780cbeed469dc86aae","81c87d88d2c7289d5fc0928a93dec9ac96d8c76dd88c186f20279155df472896","c272fa3e1aca5862eee78c1811af4309e48c2c84f64266b8d1f1b0dabcf6b033","e59a25f311547c0a836844c27cb2e4cd5c9ce0d584ae3e39c5c00550588321e0","cd53da461c2c40c46272904c82b414489dce3e75f34e59ad10c829e3931e0b0a","99fbe8c3cb8cd8626bd24cab50e81ea9115d447e7330bb70360519523182ad40","c443d9336afdfbe58b4ddc544a79dbd432fab782058929f17072f5d6c696091d","25cdabc80829d5f8bddf997f0b9bebfd319bc58814c2341c1cea54d537fa15c2","30cdbdd21ffcb1ed494a9817fb2389fe48e443d59e52d6e8289ab67a86d9f812","be7be2e0a62c6cd26386786fd2657c68d9d46201d39a3062968cbf2f0a9406a9","7c78cc980ef7a1bd836daf191024ac33eb602958a6217fe6d5ac464f19cbadc7"],"paragraph_range_zero_based":[408,431],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2408387.zip::R2-2408387 - CR_Correction on NES field descriptions.docx:p408"}
{"fields":{"filename":"R2-2408387.zip::R2-2408387 - CR_Correction on NES field descriptions.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"List of NZP CSI RS resources for the sub-configuration that is a (sub)set of NZP CSI-RS resource(s) of the CSI-RS resource set for channel measurement associated with the sub-configuration in the CSI report configuration. Value 0 refers to the first NZP CSI RS resource of the CSI-RS resource set, value 1 refers to the second NZP CSI RS resource of the CSI-RS resource set, and so on.","paragraph_zero_based":432},{"literal_text_all_w_t_and_m_t":"portSubsetIndicator","paragraph_zero_based":433},{"literal_text_all_w_t_and_m_t":"Indicates the (sub)set of CSI-RS antenna ports used for CSI calculation of the sub-configuration. In the bit string, each bit corresponds to an antenna port. When a bit is set to 1, the corresponding port is enabled for CSI calculation corresponding to the sub-configuration. When the bit is set to zero, the corresponding port is not enabled for CSI calcualton corresponding to the sub-configuration. The size of the bit string equals P bits, where P=2/4/8/12/16/24/32 represents the number of ports of the NZP CSI-RS resource(s) in the resource set for channel measurement associated with the CSI-ReportConfig.","paragraph_zero_based":434},{"literal_text_all_w_t_and_m_t":"powerOffset","paragraph_zero_based":435},{"literal_text_all_w_t_and_m_t":"When powerControlOffset is configured in a NZP CSI-RS resources in the resource set for channel measurement associated with the CSI-ReportConfig, the power offset of PDSCH RE to NZP CSI-RS RE is equal to powerControlOffset - powerOffset.","paragraph_zero_based":436},{"literal_text_all_w_t_and_m_t":"reportSubConfigParams","paragraph_zero_based":437},{"literal_text_all_w_t_and_m_t":"Indicates the parameters to be used for the CSI report sub-configuration, which includes either a1-parameters that contain the antenna port subset and the associated parameters relevant to the sub-configuration or a2-parameters that contain the list of NZP CSI-RS resources for the sub-configuration (see TS 38.214 [19], clause 5.2.1.4.2). ","paragraph_zero_based":438},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":439},{"literal_text_all_w_t_and_m_t":"PortIndexFor8Ranks field descriptions","paragraph_zero_based":440},{"literal_text_all_w_t_and_m_t":"portIndex8","paragraph_zero_based":441},{"literal_text_all_w_t_and_m_t":"Port-Index configuration for up to rank 8. If present, the network configures port indexes for at least one of the ranks.","paragraph_zero_based":442},{"literal_text_all_w_t_and_m_t":"portIndex4","paragraph_zero_based":443},{"literal_text_all_w_t_and_m_t":"Port-Index configuration for up to rank 4. If present, the network configures port indexes for at least one of the ranks.","paragraph_zero_based":444},{"literal_text_all_w_t_and_m_t":"portIndex2","paragraph_zero_based":445},{"literal_text_all_w_t_and_m_t":"Port-Index configuration for up to rank 2. If present, the network configures port indexes for at least one of the ranks.","paragraph_zero_based":446},{"literal_text_all_w_t_and_m_t":"portIndex1","paragraph_zero_based":447},{"literal_text_all_w_t_and_m_t":"Port-Index configuration for rank 1.","paragraph_zero_based":448},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":449},{"literal_text_all_w_t_and_m_t":"TDCP field descriptions","paragraph_zero_based":450},{"literal_text_all_w_t_and_m_t":"delayDSetofLengthY","paragraph_zero_based":451},{"literal_text_all_w_t_and_m_t":"Configures a set of Y delay values for TDCP reporting, see reference TS 38.214 clause 5.2.1.4. The symb4 denotes 4 symbols, the slot1 denotes 1 slot, the slot2 denotes 2 slots and so on. The value slot10 is applicable only to SCS >=30kHz. The parameter Y, see reference TS38.214 clause 5.2.1.4, is given by the length of the set of D values.","paragraph_zero_based":452},{"literal_text_all_w_t_and_m_t":"phaseReporting","paragraph_zero_based":453},{"literal_text_all_w_t_and_m_t":"Configures the UE for phase reporting for TDCP reporting see reference TS 38.214 clause 5.2.1.4","paragraph_zero_based":454},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"cf905337742c9f19496d5c85a2bc3ca156a35a8b1e77067904260ae404f7b0e1","original_member_sha256":"ec23412413a4460feb833f742d1419bbd28ea8915314355a29d962fd6d7655ac","paragraph_ElementTree_utf8_XML_sha256":["d61a4e47a1293fc49328172ca4d9310672f5af74f25692ddd05c0e385133fe9c","5377aebda2681b10bc72fbd7f10abcd4c6c3bff65b8da3f231b444c6c3d53a5e","fb8d48889b8f39e660cf57fbe8a3d5d1b2a471a9fdbab3524c6d6a72f59ff557","66d119216cc93013ce4281b36f6c279386ca7adf65a29f3347c969cb14b5c825","cd58c2aa0f36ce63eae82b334e25b323ae8f367f0df36feafa343713946a1da7","b4910cf03cda349ab0a769df46250eee261d35c36eaf4daf6f39413f7e02d5c2","05fedca06ae3de7fb4d0f1af4ecf1d5dd8f43a65f291516b98da5ea738515a20","93a113cb891143490b557145a0837f965cfb4b335a2bab75316d45f11b3a5497","cd5d87809c18fee585127c1de74ff164dee4d79439b20a8c87bb2db7769a2c0f","bf704115abb40bf4de10635e752d097050aab977509e9a08bd7757919f194c2f","de75223cbf655428fde39f791f51326364c0bec08f3d6a1a48133527d6a36d86","adf552d7c7e1805c3bdc401c0c6f198207d1992332a718041156ea137952632f","dfe7b2cd5510a507a7bd717f461285836d9e1211b48d793fff4945efcee424d9","2f34f8896ef2ac6bb94be8f3efc0f883f2ce5e506f9e027f2a4e9b6cff4b55cc","b1b22c8f7a8799cd63f1362afc15b1c555ca600c6ff4e7990e21bc4748aa6c3d","bcec797d1d67e67cbb3ef3be05f01e4c756bab1799742703288450bae63d0fd1","71ad7295740aa52ff8b799e56356049225e18de01bfdef5fcd970d4e35a73ef7","6dbd99e75dacde19bdefb2e446708060c69ba10d3bd52a991892c6f4fce32162","c68c454aa1a11663a17f49397e55b0600fb0ec8ce30160c2ebd9b05a73b1b635","e8d1a168a24c74d149a260c19cc2c7d78a2da891db5e9990e039e143201f7930","0a3ed19a62a6e74f4bd58d465408ec596f29aa6b51c8d3ca6cf735f4c2f2020e","4836b9afb4016f23321586fd995ea6f231a9e7ab6958ff83ecfc81555764249b","2c74a92ac8ab8379d5ad8c25defab3e97942605089ebcd3cc2a38ede21c1eea5","47c5e1430cfb86a1a78b642654678f2c13dbe5203b3455de2d1a8491e50fdf07"],"paragraph_range_zero_based":[432,455],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2408387.zip::R2-2408387 - CR_Correction on NES field descriptions.docx:p432"}
{"fields":{"filename":"R2-2408467.zip::R2-2408467 (Rel-17) Correction on HARQ process.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3GPP TSG-RAN WG2 Meeting #127bisR2-2408467","paragraph_zero_based":0},{"literal_text_all_w_t_and_m_t":"Hefei, China, Oct 14th – 18th, 2024","paragraph_zero_based":1},{"literal_text_all_w_t_and_m_t":"CR-Form-v12.3","paragraph_zero_based":2},{"literal_text_all_w_t_and_m_t":"CHANGE REQUEST","paragraph_zero_based":3},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5},{"literal_text_all_w_t_and_m_t":"38.321","paragraph_zero_based":6},{"literal_text_all_w_t_and_m_t":"CR","paragraph_zero_based":7},{"literal_text_all_w_t_and_m_t":"1937","paragraph_zero_based":8},{"literal_text_all_w_t_and_m_t":"rev","paragraph_zero_based":9},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":10},{"literal_text_all_w_t_and_m_t":"Current version:","paragraph_zero_based":11},{"literal_text_all_w_t_and_m_t":"17.10.0","paragraph_zero_based":12},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14},{"literal_text_all_w_t_and_m_t":"For HELP on using this form: comprehensive instructions can be found at http://www.3gpp.org/Change-Requests.","paragraph_zero_based":15},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17},{"literal_text_all_w_t_and_m_t":"Proposed change affects:","paragraph_zero_based":18},{"literal_text_all_w_t_and_m_t":"UICC apps","paragraph_zero_based":19},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20},{"literal_text_all_w_t_and_m_t":"ME","paragraph_zero_based":21},{"literal_text_all_w_t_and_m_t":"X","paragraph_zero_based":22},{"literal_text_all_w_t_and_m_t":"Radio Access Network","paragraph_zero_based":23}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"c9de91d67498880932c1dde6923944d236ea8d0fe0d729f049d35a355f05d008","original_member_sha256":"49e0a6406262a36a2ea7274502eea842be303ae6c0fc399f8b32a6ce1c386d04","paragraph_ElementTree_utf8_XML_sha256":["705cf9dc2e1ac0d93a1fd4bfe8d34feb00c278aaa004c82133fb16e3daec0ea6","1a0ed8023d48fecc59abc635363a711fb065f0f13991f09583d762c17b85aa8d","4fd35b1b890e88bac94e85a52a83972f606bf7f90c192bbcc0a7ec63f5a74266","09aae4af1f8f927139897dedbb8215f0d886b57ee3a83da4d8d40c61ba2d9b95","602ee220881ce1cb995b3adbdaf34613fd85bd8a13534f5c0a459462247605e4","0e004170f803bb904484b7ff8006039193b4d2cdcbd88680a7d07c59a2e7b061","88255a39bdbfd456eb626853c7746f3763d7aa136ee2cfba6367d815390b42c6","3e80991d81a349c3e6f0e7632da99040505209c551786dd9bfaa4670c902a569","97532036fc94796f8fbf3bdc7c1ef01d014144086a08a291812c0f4f5505998e","361a3545cb44209292ba26bd62d3d57c5599234956a84b38f6bfccc1ed192584","425bb38e74d0b9855aaec58d17194b315d9b700c333d75c764847201a2bfa243","f750e9e06fa7222b62dd30d49b8e0e7d0c92256fb0d98d4feff26cc34dcf9627","b489ff0c0790d36431854e3c30ac12738bcf517f5a5f4b68772cab31c3d527e6","33b1c5ebb4da5c2057d1d8b3232094572415a7f341a9e6ba61f17fecbbcf57b3","f9740d475761f9cf0568428186a61235d6197d4d98fff000928fab9ac02a7a1a","3003892a6fc50a9be841597595d8cedf8018653bfacd9e66c6505cd425d4f18a","41ae8817b3c82014b7b9d4607e90fea2e49112b4e76ebc7f24444dd2d55b8872","3d3da3ed9751ca97aacaa15264403a90cdb5363a8cc77a67421e45eb6a3f3604","786965b9ba8092a27dd93a6fd458b23013be239bdd3ffa2cab4b8eadc1cf8c81","00fef4e0e1ff7b6f199cdc9b37307bfae429153a96ad196ea3a60eb1834b0130","4f240bb4ca7b2eba34beff91f273489e5ea98b419a7bcccb9aaf3d1c5c8c2b92","1a35daf8b042b0037722024c1d80c45f49b01aeb52477823491fc4e71f0925ba","c831977086f16251983f5c555549f9cb709745cfb7f2969801e1deb3b2867907","0950a67eb52ed1ba78df82dafb328fbf6fdfc456d0c0ce33d6481862b7d49cce"],"paragraph_range_zero_based":[0,23],"projection":"All w:t and m:t incl