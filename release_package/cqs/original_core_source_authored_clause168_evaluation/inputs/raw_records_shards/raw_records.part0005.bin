{"fields":{"filename":"R2-2408369.zip::R2-2408369.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether the cell is reserved for operator use (for the NPN(s) identified in the npn-IdentityList) as defined in TS 38.304 [20].","paragraph_zero_based":504},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":505},{"literal_text_all_w_t_and_m_t":"–PLMN-IdentityInfoList","paragraph_zero_based":506},{"literal_text_all_w_t_and_m_t":"The IE PLMN-IdentityInfoList includes a list of PLMN identity information.","paragraph_zero_based":507},{"literal_text_all_w_t_and_m_t":"PLMN-IdentityInfoList information element","paragraph_zero_based":508},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":509},{"literal_text_all_w_t_and_m_t":"-- TAG-PLMN-IDENTITYINFOLIST-START","paragraph_zero_based":510},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":511},{"literal_text_all_w_t_and_m_t":"PLMN-IdentityInfoList ::=               SEQUENCE (SIZE (1..maxPLMN)) OF PLMN-IdentityInfo","paragraph_zero_based":512},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":513},{"literal_text_all_w_t_and_m_t":"PLMN-IdentityInfo ::=                   SEQUENCE {","paragraph_zero_based":514},{"literal_text_all_w_t_and_m_t":"    plmn-IdentityList                       SEQUENCE (SIZE (1..maxPLMN)) OF PLMN-Identity,","paragraph_zero_based":515},{"literal_text_all_w_t_and_m_t":"    trackingAreaCode                        TrackingAreaCode                                            OPTIONAL,       -- Need R","paragraph_zero_based":516},{"literal_text_all_w_t_and_m_t":"    ranac                                   RAN-AreaCode                                                OPTIONAL,       -- Need R","paragraph_zero_based":517},{"literal_text_all_w_t_and_m_t":"    cellIdentity                            CellIdentity,","paragraph_zero_based":518},{"literal_text_all_w_t_and_m_t":"    cellReservedForOperatorUse              ENUMERATED {reserved, notReserved},","paragraph_zero_based":519},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":520},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":521},{"literal_text_all_w_t_and_m_t":"    iab-Support-r16                     ENUMERATED {true}                                               OPTIONAL       -- Need S","paragraph_zero_based":522},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":523},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":524},{"literal_text_all_w_t_and_m_t":"    trackingAreaList-r17                SEQUENCE (SIZE (1..maxTAC-r17)) OF TrackingAreaCode             OPTIONAL,      -- Need R","paragraph_zero_based":525},{"literal_text_all_w_t_and_m_t":"    gNB-ID-Length-r17                   INTEGER (22..32)                                                OPTIONAL    -- Cond eventID-TSS","paragraph_zero_based":526},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"d66ee83a11e596eb14b64f5886ad9a1363953496b37c5b7ad109af3e6b319447","original_member_sha256":"c496036bf0449256be5ad57c73f5bba9639937fda10ca8d81b5a96b75aefbfc7","paragraph_ElementTree_utf8_XML_sha256":["54315af0108677645946bdddd26400db93fdb0ce4d32818eee8b27f93a063643","71dad6d0f232963c736147c3f961dd52d2cc6092919f64e45a6ec83c9707aadf","c6513802b5ef2a7712f20d563081f674c33fc73de173e2214553ab5af352c1e6","1b64870a11c31d60a3280d17aa906cc6670341186b7cc8d58cfd6f3f9be05530","0d96dca1c31280fbffdb7ab09a366e17f02e2df259d1064b9775cf033790a2bd","0adf4a559d82b923f9d25481b702d2c7d941a23cca20b712beac1911ebe94607","48098c27294865125dd9fd6d8c1969870a5186f15d72205061f8dc568b6eed82","9dde5cebe9db8788b4e9d32a77bdc4afed3c7c751499ea3684a783b3ea2fde07","d1dfbbc3049137c50d8f70112b774abc9dd85e1de35ee129a186287d50b73af3","51d1b50f950e9ee883891dc81a576a200837a0459d8bf1170992c818cc3c6929","1e7ce54b9f0698f74a2fab423c8b636c7c418d2d13aa2553a7f95a3fc7023561","0159153b32efdcd038101a9699aa832f5cdf7fcf56ce6cc5ddef3bf59fde1325","da6562e8e5d31f2b9f94f4ed34a07f1d5aa2ebc818fdeb5f861f2cecd45d60c1","586492c3d48389b4b75677274d9361b74c6a0c29acfad83c834ff2a4b64265a2","acd708aaaf1cc7abbb6afa225af1f673301d33f7a352b060640a293f18db9244","54cefcebb10aae2491307c4fbf1d7d04afed470a1626ebac0d5a74da51f47259","1bc1ddbd86a82af887d729ba087069688db52a97f42c2863a82209755e96623b","e04b3a4bf121e413e6831f5976574dcd9c79563d24d28fc0090c78c306dc928e","5b3830b4599176e776336a4a579c90fba2b08f2ab032970b4f6c28d26c925a1b","220d35c0b52a31be826e085e2c64e1294e2ea1a7009171b56fffa4a9af9d1639","c64c8d9703c63e0eaaf2d355dfe04760cd7015af4610906fd778547e294620c4","7e1495737eb24130c4dca66c072040c6563f5265edc47bac988e78a129de4254","2e0f5f40232224f8a33728b476bfa465e1ad8be8dc1cf69dfaf3fa73201e5c16","6b80497d2d2236af43761765ecb4117359f8ceed80c333914446497095792346"],"paragraph_range_zero_based":[504,527],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2408369.zip::R2-2408369.docx:p504"}
{"fields":{"filename":"R2-2408369.zip::R2-2408369.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":528},{"literal_text_all_w_t_and_m_t":"    mobileIAB-Support-r18               ENUMERATED {true}                                               OPTIONAL       -- Need S","paragraph_zero_based":529},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":530},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":531},{"literal_text_all_w_t_and_m_t":"-- TAG-PLMN-IDENTITYINFOLIST-STOP","paragraph_zero_based":532},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":533},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":534},{"literal_text_all_w_t_and_m_t":"PLMN-IdentityInfo field descriptions","paragraph_zero_based":535},{"literal_text_all_w_t_and_m_t":"cellReservedForOperatorUse","paragraph_zero_based":536},{"literal_text_all_w_t_and_m_t":"Indicates whether the cell is reserved for operator use (per PLMN), as defined in TS 38.304 [20].","paragraph_zero_based":537},{"literal_text_all_w_t_and_m_t":"gNB-ID-Length","paragraph_zero_based":538},{"literal_text_all_w_t_and_m_t":"Indicates the length of the gNB ID out of the 36-bit long cellIdentity. This field is always present if the mobileIAB-Support is broadcasted.","paragraph_zero_based":539},{"literal_text_all_w_t_and_m_t":"iab-Support","paragraph_zero_based":540},{"literal_text_all_w_t_and_m_t":"This field combines both the support of IAB and the cell status for IAB. If the field is present, the cell supports IAB and the cell is also considered as a candidate for cell (re)selection for IAB-node; if the field is absent, the cell does not support IAB and/or the cell is barred for IAB-node. This field is absent if mobileIAB-Cell is broadcasted in the cell.","paragraph_zero_based":541},{"literal_text_all_w_t_and_m_t":"mobileIAB-Support","paragraph_zero_based":542},{"literal_text_all_w_t_and_m_t":"This field indicates the support of mobile IAB and whether the cell can be considered as a candidate for cell (re)selection for mobile IAB-node. This field is absent if mobileIAB-Cell is broadcasted in the cell. If the field is absent, the cell is barred for mobile IAB-node.","paragraph_zero_based":543},{"literal_text_all_w_t_and_m_t":"trackingAreaCode","paragraph_zero_based":544},{"literal_text_all_w_t_and_m_t":"Indicates Tracking Area Code to which the cell indicated by cellIdentity field belongs. The absence of the field indicates that the cell only supports PSCell/SCell functionality (per PLMN) or is an NTN cell.","paragraph_zero_based":545},{"literal_text_all_w_t_and_m_t":"trackingAreaList","paragraph_zero_based":546},{"literal_text_all_w_t_and_m_t":"List of Tracking Areas to which the cell indicated by cellIdentity field belongs. If this field is present, network does not configure trackingAreaCode. Total number of different TACs across different PLMN-IdentityInfos shall not exceed maxTAC. This field is only present in an NTN cell.","paragraph_zero_based":547},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":548},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":549},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":550},{"literal_text_all_w_t_and_m_t":"eventID-TSS","paragraph_zero_based":551}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"d66ee83a11e596eb14b64f5886ad9a1363953496b37c5b7ad109af3e6b319447","original_member_sha256":"c496036bf0449256be5ad57c73f5bba9639937fda10ca8d81b5a96b75aefbfc7","paragraph_ElementTree_utf8_XML_sha256":["e1cb8d031fe8f7cf2bdaab075d108be5945b8e867bf2693eeb6446dceb424854","8493441af0eaee8feb1eaefe1801fc28d3ff52ad85bd0b34731a905501d322a3","938e56b95b80c08555bcf54bb079676b4f4fafc4ca11d2d7bc550c6c4d2780e1","941b3a5fe0b1ab85b53251d6f14a94e08352827f9152cb04d5b62