4084a67519390fc8dc896433137f","original_member_sha256":"c6d668d6935093953fc509b8816a1fc06b30897e87624bc3495b0bd88c0aafdc","paragraph_ElementTree_utf8_XML_sha256":["d0b638edb7cdbeb92beecf3157ae3a3fe1c877019fe9a05d1da1586249035e94","65b30b34164666cee4f747c3f9443427e7557b81725de38b46adbfb4c0a11fcf","86d8ac1a44332d88335d4a013d82d572e4b36f32e7a41bfd79c65fd4fdbe129a","9de3af33515c878efb00709957c2fb29f485ada816005bca6b06f6b3b597ce5d","383b37b7c32a11c8542f111ca2ab391c0caa20ca3829bef4b60135a5a1e2eac7","71ac893cc591ce1b3ac8040808c227ffcd0085954b10fa39f8c6fa29107b83eb","160a8025ee1226d3325daf366ff5aeaca6dd573a4b3f8f2d66e16ce80e9c59d6","05b7e90679b2641c84e521dd079d5bd63a0cf26f690741df9ce354f5c7513515","383b37b7c32a11c8542f111ca2ab391c0caa20ca3829bef4b60135a5a1e2eac7","1769ec238bd5cfb565731162714186a7399daa39c16b6a6da410fa6ef73a317f","cc345d84f492be0390d21079c5d04fb247991e56171e1d9e0912a2d3138c359f","8f41602deefdb2566fcf88960e1184b0b5b463bebcc94a2b6ad6eac22ac91fb5","95614a0104980ee1463c02f18ae318e002f870f191bea96ef385dc920fbd5cb5","05b7e90679b2641c84e521dd079d5bd63a0cf26f690741df9ce354f5c7513515","383b37b7c32a11c8542f111ca2ab391c0caa20ca3829bef4b60135a5a1e2eac7","010a30e3feffd57fe3937dfc859d1a8d86cb7437e1777448878f149a7d9e30a8","bfd8991b316799042ddf43aa5030d51b2e8b9ba24d485ec66f162ef8e2b1baff","57b10414e19d52da4c79c0d8c3873bdce01d758e1d373f827072a392a47db547","d2373b5987604f0e5b6b2d2a54d975ad11b832804400af3a335d69ced99493fa","a2e2da9ae839ca95a58a6ddc508e90a2b444b5a6de354f5de5b0da506893d74e","05b7e90679b2641c84e521dd079d5bd63a0cf26f690741df9ce354f5c7513515","383b37b7c32a11c8542f111ca2ab391c0caa20ca3829bef4b60135a5a1e2eac7","383b37b7c32a11c8542f111ca2ab391c0caa20ca3829bef4b60135a5a1e2eac7","383b37b7c32a11c8542f111ca2ab391c0caa20ca3829bef4b60135a5a1e2eac7"],"paragraph_range_zero_based":[24,47],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2406697.zip::R2-2406697 Corrections for SL relay-331.docx:p24"}
{"fields":{"filename":"R2-2406697.zip::R2-2406697 Corrections for SL relay-331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"F","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Rel-18","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-17(Release 17)Rel-18(Release 18)Rel-19(Release 19)Rel-20(Release 20)","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":" Reason for change:","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"In RAN2#125bis meeting, RAN2 agreed “Add a new timer for the E2E equivalent of T400, with double the current values.”. In consequence, a new IE “t400-U2U” was added in SIB12. Similarly, the new IE “t400-U2U” should be also added in pre-configuration. However, it is missing in SL-PreconfigurationNR.","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"The sl-PacketDelayBudget is also used for PC5 Relay RLC channel in L2 U2U relay. However, L2 U2U relay operation is missing in the filed description.","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"In 5.8.9.1.3, the meaning of the sentence “configure SRAP entity to perform NR sidelink L2 U2U relay operation accordingly for the end-to-end PC5 connection peer L2 U2U Remote UE as defined in TS 38.351 [65];” is not complete/clear, correction is needed. ","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"In 5.8.9.7.2, the per hop RLC channel configuration is derived based on the SL-RLC-BearerConfig linked with a SL-RadioBearerConfig matches the per SLRB level QoS. In other words, the per hop RLC channel configuration should include RLC config and logical channel config. However, SL-RLC-Config only includes the RLC mode configuration. While the SL-RLC-BearerConfig includes both SL-RLC-Config and SL-LogicalChannelConfig. So, it is suggested to change the SL-RLC-Config to SL-RLC-BearerConfig.","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"In 5.8.9.8.2, the postfix of release number of the IE sl-DestinationIdentityRemoteUE should be removed, i.e. remove “-r18” from “sl-DestinationIdentityRemoteUE-r18”.","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"434fef05e8d7c531bf190133739015a40f014084a67519390fc8dc896433137f","original_member_sha256":"c6d668d6935093953fc509b8816a1fc06b30897e87624bc3495b0bd88c0aafdc","paragraph_ElementTree_utf8_XML_sha256":["383b37b7c32a11c8542f111ca2ab391c0caa20ca3829bef4b60135a5a1e2eac7","22ccb375c687451993574bb931e4a752506b169e5b545b722d66907abc2bebc9","3e8e272062e8851f51cd0f3f96507414312ecf3c2a6c5737591c00a44e08c3b1","b8c7901ad75283c46c1370c616b1bf1ed050e79e2fdd6d700b74dac09f18a6af","2d2c6c3ee87a33ba9a1bf04db15bf51e7ef4bb89161d86c41d27a22ff8e84397","07d9fc4c4c112888c934f83116019216892e49884b00108301746ec17dc91432","53cef90144ae1c628990c4af4ea056abf9e351069a0cde7d94e406a8f36636a3","8185d5a381869d401f70a6818e683280b6a65f0d16f9822679ef625c1672563c","2aded45960a29bd2a393999741fd344328386a0f98071cebf3d2ce6b37c9a298","0d76bd2a4aba86bc7494106293fa0a450851bef06156a59aca950e76efc9d17b","05b7e90679b2641c84e521dd079d5bd63a0cf26f690741df9ce354f5c7513515","383b37b7c32a11c8542f111ca2ab391c0caa20ca3829bef4b60135a5a1e2eac7","3ab433da1e540256a33aadc6016c1d2c3c083b9985ea1842a576d084cb89bcf8","4cf3ac1fd00847604daf062787625a4753b55640d6307006a772b3833cfeb4fd","949a525d072b606c25d95673947069c1ef93c018994089b1c48243d3ed17d500","e8d1d81a7c7de70b78aa22b3d23a1010862c2224913e4b3544b2e12190378d5d","5ed30d8326d7bc5b34b9dc841c5b10617a9e3d5b18db3d571eb2451b5eddb532","03ed40423fae295866ea00470f77241d081d192f4eb9d348d3db979c9406b509","5ed30d8326d7bc5b34b9dc841c5b10617a9e3d5b18db3d571eb2451b5eddb532","5f302660519a17d46eb4b4ecc6ba131f0f9242879cdd680fa3a540a4473c516c","5ed30d8326d7bc5b34b9dc841c5b10617a9e3d5b18db3d571eb2451b5eddb532","221861af89e95c1b960052958b91afa966b9bb36f6e9a7436762daba00f41999","05b7e90679b2641c84e521dd079d5bd63a0cf26f690741df9ce354f5c7513515","383b37b7c32a11c8542f111ca2ab391c0caa20ca3829bef4b60135a5a1e2eac7"],"paragraph_range_zero_based":[48,71],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2406697.zip::R2-2406697 Corrections for SL relay-331.docx:p48"}
{"fields":{"filename":"R2-2406697.zip::R2-2406697 Corrections for SL relay-331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":72},{"literal_text_all_w_t_and_m_t":"In SL-PreconfigurationNR, add “t400-U2U” and the field description. ","paragraph_zero_based":73},{"literal_text_all_w_t_and_m_t":"In the field description of sl-PacketDelayBudget in SL-RLC-ChannelConfig, add “L2 U2U relay operation”.","paragraph_zero_based":74},{"literal_text_all_w_t_and_m_t":"In 5.8.9.1.3, amend the sentence to “configure SRAP entity to perform NR sidelink L2 U2U relay operation accordingly for the end-to-end PC5 connection with the peer L2 U2U Remote UE as defined in TS 38.351 [65];”.","paragraph_zero_based":75},{"literal_text_all_w_t_and_m_t":"In 5.8.9.7.2, for per hop PC5 RLC channel configuration, change the SL-RLC-Config to SL-RLC-BearerConfig.","paragraph_zero_based":76},{"literal_text_all_w_t_and_m_t":"In 5.8.9.8.2, remove “-r18” from “sl-DestinationIdentityRemoteUE-r18”.","paragraph_zero_based":77},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":78},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":79},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":80},{"literal_text_all_w_t_and_m_t":"Impact analysis","paragraph_zero_based":81},{"literal_text_all_w_t_and_m_t":"Impacted functionality: ","paragraph_zero_based":82},{"literal_text_all_w_t_and_m_t":"The supporting of SL communication.","paragraph_zero_based":83},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":84},{"literal_text_all_w_t_and_m_t":"Inter-operability: ","paragraph_zero_based":85},{"literal_text_all_w_t_and_m_t":"If Sidelink UE implements this change and gNB does not, there is no inter-operability issue between UE and gNB.","paragraph_zero_based":86},{"literal_text_all_w_t_and_m_t":"If Sidelink TX UE implements this change, but the Sidelink RX UE is not implemented this change, there is no inter-operability issue.","paragraph_zero_based":87},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":88},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":89},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":90},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":91},{"literal_text_all_w_t_and_m_t":"Mistakes are remaining in the specification.","paragraph_zero_based":92},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":93},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":94},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":95}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"434fef05e8d7c531bf190133739015a40f014084a67519390fc8dc896433137f","original_member_sha256":"c6d668d6935093953fc509b8816a1fc06b30897e87624bc3495b0bd88c0aafdc","paragraph_ElementTree_utf8_XML_sha256":["ea9c5e4460ace56f5df4e3877ad1cc76f3037dc471f465c2b4c88c0e051db18f","7caccf39d2b8d53b55ab8a9afa2ab8436839616ceed4e521af94bf4593ccd092","ee0800ecc4b40220b294c35b8fb106439da73b940a8d338a80d37826663c5912","8aa550a307eddbbe306c4a638ec690266b7d0999ace572b0f7e612c9e0c3933a","700062144f75354ca3dfeec6f48df464aeaefa69c9a197ddd6ac7a13b6a21b21","f06a943e08d02c63aa94ecfa103223ad04debacd192db2b0221c9271f891595e","b8c7901ad75283c46c1370c616b1bf1ed050e79e2fdd6d700b74dac09f18a6af","b8c7901ad75283c46c1370c616b1bf1ed050e79e2fdd6d700b74dac09f18a6af","b8c7901ad75283c46c1370c616b1bf1ed050e79e2fdd6d700b74dac09f18a6af","d31ba14343f194cdb6c584cc4f9fa6a6cf713507ea013386132f5dcb379314d4","adb81fd485a713bce971eceb9dfb7b91e679bd60e90a28823764712c6fb6d529","93695b40f942a9b6ad1ad8a044a17f2d63efbc2aa25c7c313d6b675b3aaa210e","8e8471e45f459cf84929db6e27bacb875dff067687069c8fa458f8a1e5bcbb89","1d23c275b7e45b7d72c8dbb770459d9493dbf8bc62bc8b9b7cdf556e5cf46a8f","fb419b7cc75798b93c52a15e8a386e1c963e1198