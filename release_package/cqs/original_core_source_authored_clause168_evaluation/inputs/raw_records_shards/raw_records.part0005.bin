{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"loggedMeasIdleEventL1","paragraph_zero_based":3936},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports event triggered logged measurements for eventL1 in camped normally state.","paragraph_zero_based":3937},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3938},{"literal_text_all_w_t_and_m_t":"loggedMeasIdleEventOutOfCoverage","paragraph_zero_based":3939},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports event triggered logged measurements for outOfCoverage in any cell selection state.","paragraph_zero_based":3940},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3941},{"literal_text_all_w_t_and_m_t":"loggedMeasUnComBarPre","paragraph_zero_based":3942},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports uncompensated barometric pressure measurements in RRC_IDLE mode.","paragraph_zero_based":3943},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3944},{"literal_text_all_w_t_and_m_t":"loggedMeasurementsIdle","paragraph_zero_based":3945},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports logged measurements in Idle mode.","paragraph_zero_based":3946},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3947},{"literal_text_all_w_t_and_m_t":"loggedMeasWLAN","paragraph_zero_based":3948},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports WLAN measurements in RRC idle mode.","paragraph_zero_based":3949},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3950},{"literal_text_all_w_t_and_m_t":"logicalChannelSR-ProhibitTimer","paragraph_zero_based":3951},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports the logicalChannelSR-ProhibitTimer as defined in TS 36.321 [6].","paragraph_zero_based":3952},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3953},{"literal_text_all_w_t_and_m_t":"longDRX-Command","paragraph_zero_based":3954},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports Long DRX Command MAC Control Element.","paragraph_zero_based":3955},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3956},{"literal_text_all_w_t_and_m_t":"lowerMSD-MRDC","paragraph_zero_based":3957},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports lower maximum sensitivity degradation when the band is the victim band with sensitivity degradation as specified in TS 38.101-3 [101].","paragraph_zero_based":3958},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3959}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["a2b0c66cd79388f31c41ca59a34e35b6b0d55312fbf317b31c4a3c7c49d8ac8c","b926f6bce2362caac114a9560dcb67138ebc40a4f7b03ac6a4c4f6b1b5db882f","d58ae0fd446fd8ac327092688c1ec0282261850c2993145dd7b8e6d2fa58ac20","210ebec981ced870ab5816f0fa411463af13435eb2cd1cfa8f1622c69e41a8f8","bcfd147a678b9f7855cccaf91b22825ac5d817e6cccdb3c6e44f5f03b53a9c65","d93bd1b21f7667bd7c4f7d23e6c3dc30799b54773b151c47b915e79bd84b3626","1d833003583f909c9c19afb7576d98a7873b54e87baf548574ab8693128245c2","2edde53f7d6cee7690fcaf2615245560521a4281a0ff06b3161b88bbde7c0b1b","156c64cab3af9b3783d7e6a27680a71b78bcc04895ab3f5aadada3252db91fb5","e15b30229575b2f1c7272da0e3cc5fbeba7481fad849d69afa8bef8c02e5fa74","8079daf307591fe21e1f6d3da75b3aebb8cd824615dc668600617b3e3d7d716f","71bdeee1f1738407e9354ad5fdfbb5be979e1cb7c062e4bf9ffe55eecea4a13c","a6c774b13dcd071a19c37c572013fc896425739a375ca1fd98d5e39109f4f99b","9193bd760d63eb3116986832f59d24a67d4200d05e76d5a82335de35805ba5bb","386ab997b1224c6f4438382fbb1a8356e7e9ce99e4775e04b2a0e120fe850716","cc9257f54e30ff0aff00de3d404be6b66b014bb9350d5d859d707862953896bd","44babbba42fc7bdb5f63b2145d7406fd66ab1b3ea7dbdd8035c9740e572f199a","0e2db90f30f06e2d2fd3e3603050ba04a70c0c1cd7d4b5bd492dcf30734ecc11","6a51f3222b6904cdc581630d6a5b05c20c8145dbb03d25d8002455f02e8566ed","c8d790e95a718c95e68e7a15cd56f621f5d80608d9be06f6093c9e01d982820b","b4271a92b8b862c4aba9dbbc38555a6fb42ef05001ed51e22c355261a3d9a312","c4255a4372c326495b75af236c7058b2eded6c4b8a6bb3f3ae8b4e3398a8cabb","b43a005b48f583efc525ccdfe8dbc160118be4f8e4ce4ad913c0b00458e1bb25","4092bc3bd72ec886b2289f14d22f00017f4de0da209b3daa3cb533a2dde6b5ff"],"paragraph_range_zero_based":[3936,3959],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p3936"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"lwa","paragraph_zero_based":3960},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports LTE-WLAN Aggregation (LWA). The UE which supports LWA shall also indicate support of interRAT-ParametersWLAN-r13.","paragraph_zero_based":3961},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3962},{"literal_text_all_w_t_and_m_t":"lwa-BufferSize","paragraph_zero_based":3963},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports the layer 2 buffer sizes for \"with support for split bearers\" as defined in Table 4.1-3 and 4.1A-3 of TS 36.306 [5] for LWA.","paragraph_zero_based":3964},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3965},{"literal_text_all_w_t_and_m_t":"lwa-HO-WithoutWT-Change","paragraph_zero_based":3966},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports handover where LWA configuration is retained without WT change and using LWA end-marker for PDCP key change indication for LWA operation.","paragraph_zero_based":3967},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3968},{"literal_text_all_w_t_and_m_t":"lwa-RLC-UM","paragraph_zero_based":3969},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports RLC UM for LWA bearer.","paragraph_zero_based":3970},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3971},{"literal_text_all_w_t_and_m_t":"lwa-SplitBearer","paragraph_zero_based":3972},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports the split LWA bearer (as defined in TS 36.300 [9]).","paragraph_zero_based":3973},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3974},{"literal_text_all_w_t_and_m_t":"lwa-UL","paragraph_zero_based":3975},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports UL transmission over WLAN for LWA bearer.","paragraph_zero_based":3976},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3977},{"literal_text_all_w_t_and_m_t":"lwip","paragraph_zero_based":3978},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports LTE/WLAN Radio Level Integration with IPsec Tunnel (LWIP). The UE which supports LWIP shall also indicate support of interRAT-ParametersWLAN-r13.","paragraph_zero_based":3979},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3980},{"literal_text_all_w_t_and_m_t":"lwip-Aggregation-DL, lwip-Aggregation-UL","paragraph_zero_based":3981},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports aggregation of LTE and WLAN over DL/UL LWIP. The UE that indicates support of LWIP aggregation over DL or UL shall also indicate support of lwip.","paragraph_zero_based":3982},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3983}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["ef74baa5aa704614faf691efac126a7a5fef666beba08480e25c5c83e1d864ea","c5a36eaf50c2ac00cc079b69140e15c0755e8e45c0df4c65f84701c29a5b29ef","844e4337e6cc9f5d7f482ee123f0fe6a8c9baa73aa3900429775a99dbd0f81ee","8fedb3ba6ac0fa496b94425342f48edd48f14ec5ca427f7a89c440e610bfb1b9","b2af155cbe310db72015183c0348e19959842ebb0a71bbdc101313a1ef5f1837","4f9a1e74efb36230b03e1805682e0987af74ebecd14263748336636c17aec806","111e4608c7ca07957f2c42f98e6b4e08b4133496f86f8c309388cb0e058a4b5a","8089daab2f8fd64296bac5eaf497ce62214630cf6dd677d5d5546d1decc8731f","0965287ad40e347e37f4eee55ee224d8227d020b879698214830dcdcb16c1867","8cd944f1f909e298aa673721ec73e34af4b758812f10e5624e57d596121b943b","76ba5f18e19f3492be0d3c3dce37b4b4f2c9e8aa32f3439b694cf73525109d3f","a9b3020132aea93d8eba3fc370678a0ed6dbec1ccbb3fccaf31dde72dfeed1bf","c3e7a5237ba63cabd0b7671c0d7757579f834ca844974ea2d63e3cd88d55c96b","7822f0c34af19f96e2646127552ca758f8db3e1d3e880b375ec0a14c4589fd62","57b018285501b994ee76e38b77828b0cbaf1463d8da8638132b2d1a453f584c8","e0ca553002def1823e91b2467ce9a28a0163d4e2452cbe37cef4bfc0759f1133","df5a2cd1c881bd3f3f341066afa7e7471206fe64ad80dd94d1bc899b96f35744","2e4a941ccbf1d3247ab5f895b3cdd2b0e34b602541f7e5dcad7e11deadeff17f","87ec14ce05e91a16529de239e05c5eb4b370c8818660cb781cd5d02a9f139d11","21e1883ccdf18bc81a126bcac5ab7c8f7666cacb4ab9cc59477337d0b3ce8160","20ccc7228ec9055094839a09c2cbfb98abdf466f25adc8cee10fa94980537358","fe10f991ef78453cc3d92e484ca4f3abb7ce7f8234fdfe881091f00bb133771c","412fee5f02ec8d0ed6edaf5578a3db590e9042c36f8b4aedf430247466f99d42","7d277b99190fe6e84465c8ee2b0de7d2d8c1df6dc62fb9aebb5830dfb6ec8d5e"],"paragraph_range_zero_based":[3960,3983],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p3960"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"makeBeforeBreak","paragraph_zero_based":3984},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports intra-frequency Make-Before-Break handover, and whether the UE which indicates dc-Parameters supports intra-frequency Make-Before-Break SeNB change, as defined in TS 36.300 [9].","paragraph_zero_based":3985},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3986},{"literal_text_all_w_t_and_m_t":"measGapInfoNR","paragraph_zero_based":3987},{"literal_text_all_w_t_and_m_t":"One entry corresponding to each supported E-UTRA band or band combination listed in the same order as in supportedBandCombination-r10 or supportedBandCombinationAdd-r11 or supportedBandCombinationReduced-r13. If absent, network assumes gap is required when measurement is performed on any NR bands while UE is served by cells belonging to the corresponding E-UTRA band or band combination listed in supportedBandCombination-r10 or supportedBandCombinationAdd-r11 or supportedBandCombinationReduced-r13 except for the FR2 inter-RAT measurement which depends on the support of independentGapConfig or gaplessMeas-FR2-maxCC.","paragraph_zero_based":3988},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3989},{"literal_text_all_w_t_and_m_t":"measGapPatterns-NRonly","paragraph_zero_based":3990},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports gap patterns 2, 3 and 11 in LTE standalone when the frequencies to be measured within this measurement gap are all NR frequencies. ","paragraph_zero_based":3991},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":3992},{"literal_text_all_w_t_and_m_t":"measGapPatterns-NRonly-ENDC","paragraph_zero_based":3993},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports gap patterns 2, 3 and 11 in (NG)EN-DC when the frequencies to be measured within this measurement gap are all NR frequencies. ","paragraph_zero_based":3994},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":3995},{"literal_text_all_w_t_and_m_t":"maximumCCsRetrieval","paragraph_zero_based":3996},{"literal_text_all_w_t_and_m_t":"Indicates whether UE supports reception of requestedMaxCCsDL and requestedMaxCCsUL.","paragraph_zero_based":3997},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3998},{"literal_text_all_w_t_and_m_t":"maxLayersMIMO-Indication","paragraph_zero_based":3999},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports the network configuration of maxLayersMIMO. If the UE supports fourLayerTM3-TM4 or intraBandContiguousCC-InfoList or FeatureSetDL-PerCC for MR-DC, UE supports the configuration of maxLayersMIMO for these cases regardless of indicating maxLayersMIMO-Indication.","paragraph_zero_based":4000},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4001},{"literal_text_all_w_t_and_m_t":"maxLayersSlotOrSubslotPUSCH","paragraph_zero_based":4002},{"literal_text_all_w_t_and_m_t":"Indicates the maxiumum number of layers for slot-PUSCH or subslot-PUSCH transmission.","paragraph_zero_based":4003},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4004},{"literal_text_all_w_t_and_m_t":"maxNumberCCs-SPT","paragraph_zero_based":4005},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of supported CCs for short processing time. The UE capability is reported per band combination. The reported number of carriers applies to all the FS-type(s) frameStructureType-SPT-r15 supported in a given band combination. Absence of the field indicates that 0 number of CCs are supported for short processing time.","paragraph_zero_based":4006},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4007}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["8c7909faffa73f10fe2d4769235e7f7138d2167d07878a1104c72a776420cbf5","96fe10ac49be2c5b0ea4c50629c19a5c06118e82c72dd489a7390f1cb7417027","1ed820137621305071455f4c631bece8b465a998cf82c798b424839b7752d28c","0838a71cdb0637d41b31cfad2db44edc92a0ad63db91435e22d00eadcb28f1dd","d2713a26f1b4984d61dfdd383057b5770330079c3e675125183bfc577a3e905f","3ca0145d20045d75f9809b1cd27e05e888687d960e174b26bcde84cafc73eb77","e78ceec3787deba28b66e3c4a6958b6f25ae67c58b05cb6c69e769a46e91036b","f810cd359c57bf7aa8a27cfdf805cc70bac91cc65fc20b2150b6a75e46319fce","7121e5328c273a94cacdf66044afccd2a9937e8527cf736ef4bc9a78b6d82d6f","3195e3d6d163af2776a92827b8eafeaa469e34d93834d399edc84bfaaf1d194c","31b0be8a2a75a4095d6f50e4cf881cb15cea5ff7c779ad78f84a3ce39da77114","2e8aa938944967a1072d9f5600396bf74286a755b19ebf8945b30dda8dbb925c","ff7cf31983c3f925a986691fc915139afee91e8c5122a053c02c4d58fb9f2d1c","39e9db8c3c6600a1428a5f80758389f592454f8c08de32ebe2201c0b199d5bb3","30e283d2eebf64d923da8c20938434bfa57053e686315b061c32a9bd54661eb5","7ab55fd9415a6e691d914d03bd91203fb56c9ab73642cab6496edf3341a640bb","6fffafc85726314ecc074e781339f111f0e68a7b169ebef485283b3bd53d8f2f","16d6f6cdc9271120aa09a93cc76e74e642c79fa8cc03a8d8c0128af96bd2b789","444145b72740964c6974038d9aa9863acdc6b405b32b73e3a87056e3885f3073","3256b7662727ac6a56ae3160930b02cf3142779cb31f30818935b2948dd799d7","c380b8204d77716b7fab93119018856f57fb69c2af92dae9efa2e93852e24a5b","06d1a846bef3e220cf463ef85b71a95b3aa9622ddf9e39afb6f5db0106ea7649","db442ce86db34e4c1c08574f33825a414d26d378934e41c5d0826627b0baf386","d60b3e62b9c5d3d41e3d6285d3f6a5c72c30a3e73a1cbc2001cd3b336b0ea25d"],"paragraph_range_zero_based":[3984,4007],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p3984"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"maxNumberDL-CCs, maxNumberUL-CCs","paragraph_zero_based":4008},{"literal_text_all_w_t_and_m_t":"Indicates for each TTI combination \"sTTI-SupportedCombinations\", the maximum number of supported DL CCs/UL CCs for short TTI. Absence of the field indicates that 0 number of CCs are supported for short TTI.","paragraph_zero_based":4009},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4010},{"literal_text_all_w_t_and_m_t":"maxNumberDecoding","paragraph_zero_based":4011},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of blind decodes in UE-specific search space per UE in one subframe for CA with more than 5 CCs as defined in TS 36.213 [23] which is supported by the UE. The number of blind decodes supported by the UE is the field value * 32. Only values 5 to 32 can be used in this version of the specification.","paragraph_zero_based":4012},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":4013},{"literal_text_all_w_t_and_m_t":"maxNumberEHC-Contexts","paragraph_zero_based":4014},{"literal_text_all_w_t_and_m_t":"Defines the maximum number of Ethernet header compression contexts supported by the UE across all DRBs and across UE's EHC compressor and EHC decompressor. The indicated number defines the number of contexts in addition to CID = \"all zeros\" as specified in Annex A of TS 38.323 [83].","paragraph_zero_based":4015},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":4016},{"literal_text_all_w_t_and_m_t":"maxNumberROHC-ContextSessions","paragraph_zero_based":4017},{"literal_text_all_w_t_and_m_t":"Set to the maximum number of concurrently active ROHC contexts supported by the UE, excluding context sessions that leave all headers uncompressed. cs2 corresponds with 2 (context sessions), cs4 corresponds with 4 and so on. The network ignores this field if the UE supports none of the ROHC profiles in supportedROHC-Profiles. If the UE indicates both maxNumberROHC-ContextSessions and maxNumberROHC-ContextSessions-r14, same value shall be indicated.","paragraph_zero_based":4018},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4019},{"literal_text_all_w_t_and_m_t":"maxNumberUpdatedCSI-Proc, maxNumberUpdatedCSI-Proc-SPT","paragraph_zero_based":4020},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of CSI processes to be updated across CCs.","paragraph_zero_based":4021},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":4022},{"literal_text_all_w_t_and_m_t":"maxNumberUpdatedCSI-Proc-STTI-Comb77, maxNumberUpdatedCSI-Proc-STTI-Comb27, maxNumberUpdatedCSI-Proc-STTI-Comb22-Set1, maxNumberUpdatedCSI-Proc-STTI-Comb22-Set2","paragraph_zero_based":4023},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of CSI processes to be updated across CCs. Comb77 is applicable for {slot, slot}, Comb27 for {subslot, slot}, Comb22-Set1 for","paragraph_zero_based":4024},{"literal_text_all_w_t_and_m_t":"{subslot, subslot} processing timeline set 1 and the Comb22-Set2 for {subslot, subslot} processing timeline set 2.","paragraph_zero_based":4025},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4026},{"literal_text_all_w_t_and_m_t":"mbms-AsyncDC","paragraph_zero_based":4027},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE in RRC_CONNECTED supports MBMS reception via MRB on a frequency indicated in an MBMSInterestIndication message, where (according to supportedBandCombination) the carriers that are or can be configured as serving cells in the MCG and the SCG are not synchronized. If this field is included, the UE shall also include mbms-SCell and mbms-NonServingCell. The field indicates that the UE supports the feature for xDD if mbms-SCell and mbms-NonServingCell are supported for xDD.","paragraph_zero_based":4028},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4029},{"literal_text_all_w_t_and_m_t":"mbms-MaxBW","paragraph_zero_based":4030},{"literal_text_all_w_t_and_m_t":"Indicates maximum supported bandwidth (T) for MBMS reception, see TS 36.213 [23]. clause 11.1. If the value is set to implicitValue, the corresponding value of T is calculated as specified in TS 36.213 [23], clause 11.1. If the value is set to explicitValue, the actual value of T = explicitValue * 40 MHz.","paragraph_zero_based":4031}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["8f1ccce099fc3d71ceb1953089636d13a738d2082c516919e2d14227b80e436c","86a71d4b3209cd8bda4059ba161ffbba75bf002a92adad9d470d5e7e80e23d37","813fe71b19c86c5342ae1091df975bd36e20f16d7330e364c603d66c33c854d6","e5aeb3b3dcbaccf4c45ffeaf464528af9af9a79c2c95291b958dc1fc54b36ec5","47503cda26bab95ae1f47a45e34f005e2271ed47d2828251662f390ce65b79f2","42ec5f1f1208e714de3e6087cd0df92c7de2a87e5af56daf6584f7c0701e1f8e","88bc3ed923251b61fe0f452b7fbc8f730791070bb7a1d77a4de3533aa7da1262","1f98714112122de893273f95fe971be5aa4f2e0f1a9f7a0ff6f71760bf569728","847ecc7fc5d731b07c87295f1163cdc6aea6017c5d62ea8677394072ffaa886e","54b59800a104a87a774c85a05ec2bb8c62deadcb7b172c76d1f5fad9529d3c68","b881f0c1423959210296d32fa0284adc140c91a7109889fd6aa5273b4b9db447","7b010da0d26cabd93445fcb5fb53781feed8c8de28de007bfc0175b6bf0f2125","da735b98e3faf153a45a0b40bec8a21b9506196470eb67ecee4fc4d3909a3df5","f7e0833dd193d596f62b406a3f2edcc68d1cbf846cb806879ddb74e6b34cb0c4","25d75f5b1408261201bcb881548860d4f00f0ac56e9d1e051261f2f8d41a565f","9ba9996b2c14433564848f84b3634f97fa318d9c80c0bd374795a7d12ad9d61b","90d2c5cb62c1718b2d7c0fbf0cb8ac1cde832e8e5ad991fa8a54dcf168b7def3","55b0536e4b82fab3d3b023d73e7111db20562fd2d498f21be91297ccf1f69690","84799270a34d3c7f60017d5149b53bf562208e66e577c9eaa48e85b205b95eeb","c2cbedc20b45654551694a10d507ce703e525cb4902958be02df287c192ac764","3db961edb18f4f29bc23b9db2c83030fe27e576ec98fd89a23aab797dd638633","f09953e58d9a13acb0fffba378aac61d59d5ef8157a02e3a53698359c6b7b10a","39ad419ccc6ffdd86518c46af295f0894d6ce0c2cd5abc9df62706cf4f22a6a2","cee7e687481494408f9edf5b4e7fb3e8917ad8abd7db9c955c0927419cc1c3df"],"paragraph_range_zero_based":[4008,4031],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p4008"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4032},{"literal_text_all_w_t_and_m_t":"mbms-NonServingCell","paragraph_zero_based":4033},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE in RRC_CONNECTED supports MBMS reception via MRB on a frequency indicated in an MBMSInterestIndication message, where (according to supportedBandCombination and to network synchronization properties) a serving cell may be additionally configured. If this field is included, the UE shall also include the mbms-SCell field.","paragraph_zero_based":4034},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4035},{"literal_text_all_w_t_and_m_t":"mbms-ScalingFactor1dot25, mbms-ScalingFactor7dot5","paragraph_zero_based":4036},{"literal_text_all_w_t_and_m_t":"Indicates parameter A(1.25 / A(7.5, i.e., scaling factor for processing one unit of bandwidth corresponding to subcarrier spacing of 1.25 kHz / 7.5 kHz, with respect to one unit of bandwidth corresponding to subcarrier spacing of 15 kHz. See TS 36.213 [23], clause 11.1. This field is included only if subcarrierSpacingMBMS-khz1dot25 / subcarrierSpacingMBMS-khz7dot5 is included. This field shall be included if mbms-MaxBW and subcarrierSpacingMBMS-khz1dot25 / subcarrierSpacingMBMS-khz7dot5 are included.","paragraph_zero_based":4037},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4038},{"literal_text_all_w_t_and_m_t":"mbms-ScalingFactor0dot37, mbms-ScalingFactor2dot5","paragraph_zero_based":4039},{"literal_text_all_w_t_and_m_t":"Indicates parameter A(0.37 / A(2..5, i.e., scaling factor for processing one unit of bandwidth corresponding to subcarrier spacing of 0.37 kHz / 2.5 kHz, with respect to one unit of bandwidth corresponding to subcarrier spacing of 15 kHz. See TS 36.213 [23], clause 11.1. This field is included only if fembmsMixedCell or fembmsDedicatedCell is included. This field shall be included if subcarrierSpacingMBMS-khz0dot37 / subcarrierSpacingMBMS-khz2dot5 is included for at least one E-UTRA band in mbms-SupportedBandInfoList.","paragraph_zero_based":4040},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4041},{"literal_text_all_w_t_and_m_t":"mbms-SCell","paragraph_zero_based":4042},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE in RRC_CONNECTED supports MBMS reception via MRB on a frequency indicated in an MBMSInterestIndication message, when an SCell is configured on that frequency (regardless of whether the SCell is activated or deactivated).","paragraph_zero_based":4043},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4044},{"literal_text_all_w_t_and_m_t":"mbms-SupportedBandInfoList","paragraph_zero_based":4045},{"literal_text_all_w_t_and_m_t":"One entry corresponding to each supported E-UTRA band listed in the same order as in supportedBandListEUTRA. This list is included only if fembmsMixedCell or fembmsDedicatedCell is included. If mbms-SupportedBandInfoList-v1700 is included, the UE shall include the same number of entries, and listed in the same order, as in mbms-SupportedBandInfoList-r16. If mbms-SupportedBandInfoList-v1900 is included, the UE shall include the same number of entries, and listed in the same order, as in mbms-SupportedBandInfoList-r16.","paragraph_zero_based":4046},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4047},{"literal_text_all_w_t_and_m_t":"mcgRLF-RecoveryViaSCG","paragraph_zero_based":4048},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports recovery from MCG RLF via split SRB1 (if supported) and via SRB3 (if supported).","paragraph_zero_based":4049},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4050},{"literal_text_all_w_t_and_m_t":"measGapPatterns-NRonly","paragraph_zero_based":4051},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports gap patterns 2, 3 and 11 in LTE standalone when the frequencies to be measured within this measurement gap are all NR frequencies. ","paragraph_zero_based":4052},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":4053},{"literal_text_all_w_t_and_m_t":"measGapPatterns-NRonly-ENDC","paragraph_zero_based":4054},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports gap patterns 2, 3 and 11 in (NG)EN-DC when the frequencies to be measured within this measurement gap are all NR frequencies. ","paragraph_zero_based":4055}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["cd321f881c0b5f9443c93d202704b7238f97da76e0eeb68703000af34dce46de","b932819767a61380ae1d183593eec3825fac8eede0aa9a2f7e43b836dadfa56d","db46356a2731a0d1124440dbca5fa3bc3e66b0ae54fa556e638b74ddcc7110bf","0361b92fb31574fecc78a04ad75cc048ba3419af7892bb44485986a2851b4f7d","fe2110ad7a5e38108e3065803119870b4f9896a511575d268636da58c5608508","ec47a78e95df4553192d60186aa5f04f7c6a449bfcacba40cdf5d56170c034f6","30bc911e0d315262420234ddaaca1543f0875684f0ec23a7cde7f5ad34f167ec","b9a17171f670f8523726051d55eba0a28b2c4fbbf59943e7291abfbd34018dfb","fcc36236ef9513e243fec1008116e24628f82179c6e79de9a5e8fe3c3c6141a1","2acad2aa45081376be998ffc345f46887752bc7e74150bb91a0aaec6729381de","ef6c5627a9f072c66e4d10b317061f2b41ed3d3c7343e12a586f6b783d140b1c","08a73febd5846902ef5c2deb02164fc675cf105d477d49a0444aedcdd72eddb3","9114faaac98ff8778a815ce067af25d70c391f68b5367af9e4d83e34595ac0c1","9273208382469d61b3adfd0463b1ff99a11efdaf3aef1922586942bf9b5b384c","8526206bad0b5260ccaea30df74ec281e5fc91195de66a16e331859b66acea92","40dd260814a6a034aa0635ebbc7c90778760619292041148be309a2c65897035","6c09129fbf81b1a45e5cd821684c680e53b9af1f1abb767eba16fd523248bea9","0b0b417e077b8468e8994ff2ec50deb50cf929c7a31c5adf290c90de5a836519","1be2511695dc316b30e759a1c79bd84b781f66ec11fd35a23d08784bb8ed76d3","0f49a45f937f3c9ea6fd53671642b126059cc124ed1fa5b8b8aabcea7e081993","210da23f2472bff745d6a9bba182315c65dcb5abb5658c68fe9a6816397f7b4d","547d43a7bd0296e7adce48c955404d9a461f3f6d7a600407426d2917386d55b7","8432f25af38e032d80e69cd6a81452ce52d492f3db3bbbfd89cd0e2b5938a58e","4db2f150b24efdeb4d422090bea0186afaecae3c4ecceb453690e81101f6a4fd"],"paragraph_range_zero_based":[4032,4055],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p4032"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":4056},{"literal_text_all_w_t_and_m_t":"measurementEnhancements","paragraph_zero_based":4057},{"literal_text_all_w_t_and_m_t":"This field defines whether UE supports measurement enhancements in high speed scenario (350 km/h) as specified in TS 36.133 [16].","paragraph_zero_based":4058},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4059},{"literal_text_all_w_t_and_m_t":"measurementEnhancements2","paragraph_zero_based":4060},{"literal_text_all_w_t_and_m_t":"This field defines whether UE supports measurement enhancements in high speed scenario (up to 500 km/h velocity) as specified in TS 36.133 [16].","paragraph_zero_based":4061},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4062},{"literal_text_all_w_t_and_m_t":"measurementEnhancementsSCell","paragraph_zero_based":4063},{"literal_text_all_w_t_and_m_t":"This field defines whether UE supports SCell measurement enhancements in high speed scenario (350 km/h) as specified in TS 36.133 [16].","paragraph_zero_based":4064},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4065},{"literal_text_all_w_t_and_m_t":"measGapPatterns","paragraph_zero_based":4066},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE that supports NR supports gap patterns 4 to 11 in LTE standalone as specified in TS 36.133 [16], and for independent measurement gap configuration on FR1 and per-UE gap in (NG)EN-DC as specified in TS 38.133 [84]. The first/ leftmost bit covers pattern 4, and so on. Value 1 indicates that the UE supports the concerned gap pattern.","paragraph_zero_based":4067},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4068},{"literal_text_all_w_t_and_m_t":"mfbi-UTRA","paragraph_zero_based":4069},{"literal_text_all_w_t_and_m_t":"It indicates if the UE supports the signalling requirements of multiple radio frequency bands in a UTRA FDD cell, as defined in TS 25.307 [65].","paragraph_zero_based":4070},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4071},{"literal_text_all_w_t_and_m_t":"MIMO-BeamformedCapabilityList","paragraph_zero_based":4072},{"literal_text_all_w_t_and_m_t":"A list of pairs of {k-Max, n-MaxList} values with the nth entry indicating the values that the UE supports for each CSI process in case n CSI processes would be configured.","paragraph_zero_based":4073},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":4074},{"literal_text_all_w_t_and_m_t":"MIMO-CapabilityDL","paragraph_zero_based":4075},{"literal_text_all_w_t_and_m_t":"The number of supported layers for spatial multiplexing in DL. The field may be absent for category 0 and category 1 UE in which case the number of supported layers is 1.","paragraph_zero_based":4076},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4077},{"literal_text_all_w_t_and_m_t":"MIMO-CapabilityUL","paragraph_zero_based":4078},{"literal_text_all_w_t_and_m_t":"The number of supported layers for spatial multiplexing in UL. Absence of the field means that the number of supported layers is 1.","paragraph_zero_based":4079}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["2f4492e0236c401b9f294598150ec26f35cb3e0a89dbf10515cc66a6416464c0","7c3160b1f46ae9dfe89fbfa9c72668dd3246a9c8da4138781de04fe5c75dda00","1b33c33ac719048dc79cdbbc87a3877443cf2e8736791805d2720af99ce034ef","bde45cc4bef07e5701d36d7185f84b8d0e9e9078768a99dd81f6ba6c8e15df91","95a9e84ab5b21c8c63db4f5bd03947eabccf8ca368f39ba2452301dd97192193","e00a84e47fa1644e5860778f4884bd746d909dcfd12c95c3cd87b94fd3fad955","146e1ea06dfa9167e32dc75eb6dce940e293d6ff787d6d3fe7d2d0aa23c3b1df","574f02e2c08f464b1ae36d648dc3ccfb5492d09df4ea038a5c22173a3c0d40d8","ee66c2778c008def75d5ac631e7d63842fdc94116360db097dc5a602ba294771","9d78a97f799f678b40e55c1d028337a1c419bfbc87b8895428d3d3c85dccbfa5","07043360bf647ede9cf4c59735020ac8e5b633a33f504a1dd24b1cae58aedf97","721d93dcffcfc9916997e5127fcdf29835aa59906f01d8a6b3547cc4291c96e6","8e1a183ab1a4592321b36e0d906be04bdbbaa24847463d184c7a308e35286340","ca51ef321a4f119bb214e3eeebef3588a13000333a0f5e23682da8eabb97889c","6fccdadb7c27d043d0cba8987d544b72a36af885975ffd31b1a102ab51b97660","f5bb9f7e2c2dd95721d5d6d64c318c1582e9681043b568555d9da667cffe9f91","1695d7d36e7d7fb119c581b9d211d85fc0d4981336b210f9a94044dec2449237","54a3e33049c8db077948e30b107f847bf752ddb3ae0a6b857bc35ba04106e048","f949524d3c98c771c7d61a5b534b61699636760392b65212a3ca502da215914f","ee9c267ca674c1b37bdf51ffaa0996042c22fb6a4f4216d7f7d0e52c8a808c98","e0da4274544f4b8e999ea828f5c213955d98241845458e8eafed5d78b118e01f","af88f5c0cdef8e85eab0e6ac09e709652ecd0d6bb497ecc0b35d3837583528db","763aa1e3d67f36d005f1b8fa593483a7de171c1be1f783ebbe0afcd78465451f","1442fa4d8d9b4282c75c92ab867a39801f0d9e8ab340dfab3adaa49ee05a5379"],"paragraph_range_zero_based":[4056,4079],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p4056"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4080},{"literal_text_all_w_t_and_m_t":"MIMO-CA-ParametersPerBoBC","paragraph_zero_based":4081},{"literal_text_all_w_t_and_m_t":"A set of MIMO parameters provided per band of a band combination. In case a subfield is absent, the concerned capabilities are the same as indicated at the per UE level (i.e. by MIMO-UE-ParametersPerTM).","paragraph_zero_based":4082},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4083},{"literal_text_all_w_t_and_m_t":"mimo-CBSR-AdvancedCSI","paragraph_zero_based":4084},{"literal_text_all_w_t_and_m_t":"Indicates whether UE supports CBSR for advanced CSI reporting with and without amplitude restriction as defined in TS 36.213 [23], clause 7.2.","paragraph_zero_based":4085},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4086},{"literal_text_all_w_t_and_m_t":"min-Proc-TimelineSubslot","paragraph_zero_based":4087},{"literal_text_all_w_t_and_m_t":"Minimum processing timeline for subslot operation. The minimum processing timeline can belong to one of two sets of associated processing and maximum TA operation. The sets supported can be different for 1os CRS-based SPDCCH, 2os CRS-based SPDCCH and DMRS-based SPDCCH. The sequence applies to:","paragraph_zero_based":4088},{"literal_text_all_w_t_and_m_t":"1. 1os CRS based SPDCCH","paragraph_zero_based":4089},{"literal_text_all_w_t_and_m_t":"2. 2os CRS based SPDCCH","paragraph_zero_based":4090},{"literal_text_all_w_t_and_m_t":"3. DMRS based SPDCCH","paragraph_zero_based":4091},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4092},{"literal_text_all_w_t_and_m_t":"modifiedMPR-Behavior","paragraph_zero_based":4093},{"literal_text_all_w_t_and_m_t":"Field encoded as a bit map, where at least one bit N is set to \"1\" if UE supports modified MPR/A-MPR behaviour N, see TS 36.101 [42]. All remaining bits of the field are set to \"0\". The leading / leftmost bit (bit 0) corresponds to modified MPR/A-MPR behaviour 0, the next bit corresponds to modified MPR/A-MPR behaviour 1 and so on.","paragraph_zero_based":4094},{"literal_text_all_w_t_and_m_t":"Absence of this field means that UE does not support any modified MPR/A-MPR behaviour.","paragraph_zero_based":4095},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4096},{"literal_text_all_w_t_and_m_t":"mpdcch-InLteControlRegionCE-ModeA, mpdcch-InLteControlRegionCE-ModeB","paragraph_zero_based":4097},{"literal_text_all_w_t_and_m_t":"Indicates whether UE operating in CE mode A/B supports MPDCCH reception in LTE control channel region as specified in TS 36.211 [21].","paragraph_zero_based":4098},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4099},{"literal_text_all_w_t_and_m_t":"mpsPriorityIndication","paragraph_zero_based":4100},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports mpsPriorityIndication on release with redirect.","paragraph_zero_based":4101},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4102},{"literal_text_all_w_t_and_m_t":"multiACK-CSI-reporting","paragraph_zero_based":4103}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["ab154c6c0c448e7a63d86d8863947aa5f569faffbfbdf1ac56f18c458632c53a","6506a8334d43483479243fd97ef0864656c8b7fcbc734406f56cb97192817487","e5a72e380f3bc870cbcd687c30aa60ebd8a257de6fbdf109b269af3566488678","46bcc41da7969d5d69b7b87c32a502032fbdd38f1769cc4fe9c0aba83a58274b","dc94cdcabcc34945df553dd6905031ae9aa29fb2d432d68f8174c53ffe1968a7","87db1fdc9c792c5f053f77ad31f27fcf109287d1b8d413ea2dfc0358abacafd5","65a5313545506f437064339e989e27445b30e070dce5a527cda46e7c3005782f","6e84d0090a54b848c5573e33fe518fafd24bd24dc6880cca5aa2558084714b7b","fb7bd4370e9d37a51c9d37c875be9cb5d4afd2cb4bf849ee93e69935eaaea572","d5671f07a04f2231afd46b60a80f51a59b5212b711200cd589505783beca2325","471895a3e63165dac12617b71dcdb10c6ebf4c80fcc8832fcfa02fdc2087b0db","21b7611a995c0725543d27f5fa43847bae770e3032be0337f7885ff6446b03c8","c5cc74ebd5eadc006d4b5d993c68ca7ca904cdf1f4b364c6bac9c177228210ae","effb2d2e36c0d329eec11fb5976ce8779406d0c89569d4fd245df742c65b7b30","e438798638f5ae530ce930a842e1ed5cf4886184fa942584967a139c1b093f01","2d6c90a7970a65bf12743a3a79e89d990d695080aee27d9e6379742d03896d06","14de28e61f90b2897dc3e11bb3c3832f8a2bddcf90cd177d7d454da373a2d90d","cc6ecbeb67c551e17b71bf24bed4e06675ffefe8be76548da82f3cf764ac9edc","c98608979877765ef7b70cb97444ff20b172f35abaf7b8bd827a7498451faf04","c37ff11f779ed61c4d9198249a2312197d56170c28c40da82eabd79f6ade80ed","b8f01f25336383b9f688789b5dd0a683b144937306fc31a26f892ba52728e180","7dd4c3410fb02d4f474e33371bd067c4985da1b725d7176c7860c8430bd32746","aea63b70aa36c970ca71b51604fac5ba4241a3845921257d67e0ab5a3a2a32e1","aa1be4fa39b2aca392044332accb476d86aa25531463e7ba86b1b27e51b1b0e1"],"paragraph_range_zero_based":[4080,4103],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p4080"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports multi-cell HARQ ACK and periodic CSI reporting and SR on PUCCH format 3.","paragraph_zero_based":4104},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4105},{"literal_text_all_w_t_and_m_t":"multiBandInfoReport","paragraph_zero_based":4106},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports the acquisition and reporting of multi band information for reportCGI.","paragraph_zero_based":4107},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4108},{"literal_text_all_w_t_and_m_t":"multiClusterPUSCH-WithinCC","paragraph_zero_based":4109},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4110},{"literal_text_all_w_t_and_m_t":"multiNS-Pmax","paragraph_zero_based":4111},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports the mechanisms defined for cells broadcasting NS-PmaxList.","paragraph_zero_based":4112},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4113},{"literal_text_all_w_t_and_m_t":"multiNS-PmaxAerial","paragraph_zero_based":4114},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports the mechanisms defined for cells broadcasting NS-PmaxListAerial and freqBandInfoAerial.","paragraph_zero_based":4115},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4116},{"literal_text_all_w_t_and_m_t":"multipleCellsMeasExtension","paragraph_zero_based":4117},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports numberOfTriggeringCells in the report configuration.","paragraph_zero_based":4118},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4119},{"literal_text_all_w_t_and_m_t":"multipleTimingAdvance","paragraph_zero_based":4120},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports multiple timing advances for each band combination listed in supportedBandCombination. If the band combination comprised of more than one band entry (i.e., inter-band or intra-band non-contiguous band combination), the field indicates that the same or different timing advances on different band entries are supported. If the band combination comprised of one band entry (i.e., intra-band contiguous band combination), the field indicates that the same or different timing advances across component carriers of the band entry are supported. It is mandatory for UEs to support 2 TAGs for inter frequency DAPS handover.","paragraph_zero_based":4121},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4122},{"literal_text_all_w_t_and_m_t":"multipleUplinkSPS","paragraph_zero_based":4123},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports multiple uplink SPS and reporting SPS assistance information. A UE indicating multipleUplinkSPS shall also support V2X communication via Uu, as defined in TS 36.300 [9].","paragraph_zero_based":4124},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4125},{"literal_text_all_w_t_and_m_t":"must-CapabilityPerBand","paragraph_zero_based":4126},{"literal_text_all_w_t_and_m_t":"Indicates that UE supports MUST, as specified in 36.212 [22], clause 5.3.3.1, on the band in the band combination.","paragraph_zero_based":4127}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["a8bfc8c6587abcedd2a0de6b1f4f4f69326ef0a36ac4ac582d55ca6b03d219b7","b73361569918a9bdcc1e659ca3a7f98c1f75787769936aac19bb5ac04bfd4acd","a914040348489d27440a2dbc4b27f14c8b41d42ee84c05d383f65453e1e7e706","bb67e2b1df5413a54ace3428bc5497ba7ae9dbac6829f98d6c78caa5a09629da","da61067257782dacb20e280df50df0a72f188f1591b2ffc510d10a79d5206cde","a68f260dd24bc604c2c38f8a14330870ca24639004c0b415c376f05a95e91b11","c8a817f5af15bf06d1668eaa9aa6c5c91b95817837ed2f9bf13368a014fd0c63","09d17b046c003e4bcef5c5a879da1e040efd430a6437b816485b2d42487df4e4","40d11dc960cd834454750bbe3a3f50706969540fadc4cb3dc75bb93714c1f848","d7d0602cdeffcc8bdf90b2b0fc36b0f746dc639f48d5fa9e98b670f1680d6170","bf946f76f85232a83713abe5b4db1c271156d004caddd5420ad8b70b0cf3df14","5a3fe08971aa4068a7210af82fdae5a14de09c5baa6aca0421386f395f0e58e2","a050c0c7c727c9f4dd5361e3a649a710312e32bd5e8942b094e12a3298840f5b","262604d628ae444d9b3c4d1054cf34a15114146153c347a2482ce4b2b4576afe","6fcd2500b6f1ae563e40eb1b36cfa88ef08f2ffbc2d8240e3994bd68febd5655","cfa138e2ad04cf98e56450c1fd571eb268604c283a07be9a529fae543e00be33","1e563a57de780fb1a2f09c2fd37db7999cfd90ca346d24d0f92a905863c3f712","b50f92ff50d3c979120ec7d010fcee5b190262fc805c10d7b06fe987d95d9558","79e9113ff2c592cd1c6cc2c0b09aeb72020d82c2c212305016c4356c628e10c9","1c2ebdcce9315e89f761b77f353405f1429dce66aa34688c8af9a58dc3f95b64","c437c836a0e26c28b045aaa841cb0cb784e39b5a8b95f2bbbe35642e2df4fc5e","9c26c7cc3523f37e4d787b28c391728d2b0599d5ed654a06368a2edb1572cbc8","46d14aef21d9b1078534fd7528a5d6238529bbaed9f2b44455ac5abb67fad329","74c076f02f7cb56e28e44b1101cb90607cc18f26f43a53531ef36031db7a59a8"],"paragraph_range_zero_based":[4104,4127],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p4104"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4128},{"literal_text_all_w_t_and_m_t":"must-TM234-UpTo2Tx-r14","paragraph_zero_based":4129},{"literal_text_all_w_t_and_m_t":"Indicates that the UE supports MUST operation for TM2/3/4 using up to 2Tx.","paragraph_zero_based":4130},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4131},{"literal_text_all_w_t_and_m_t":"must-TM89-UpToOneInterferingLayer-r14","paragraph_zero_based":4132},{"literal_text_all_w_t_and_m_t":"Indicates that the UE supports MUST operation for TM8/9 with assistance information for up to 1 interfering layer.","paragraph_zero_based":4133},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4134},{"literal_text_all_w_t_and_m_t":"must-TM89-UpToThreeInterferingLayers-r14","paragraph_zero_based":4135},{"literal_text_all_w_t_and_m_t":"Indicates that the UE supports MUST operation for TM8/9 with assistance information for up to 3 interfering layers.","paragraph_zero_based":4136},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4137},{"literal_text_all_w_t_and_m_t":"must-TM10-UpToOneInterferingLayer-r14","paragraph_zero_based":4138},{"literal_text_all_w_t_and_m_t":"Indicates that the UE supports MUST operation for TM10 with assistance information for up to 1 interfering layer.","paragraph_zero_based":4139},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4140},{"literal_text_all_w_t_and_m_t":"must-TM10-UpToThreeInterferingLayers-r14","paragraph_zero_based":4141},{"literal_text_all_w_t_and_m_t":"Indicates that the UE supports MUST operation for TM10 with assistance information for up to 3 interfering layers.","paragraph_zero_based":4142},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4143},{"literal_text_all_w_t_and_m_t":"naics-Capability-List","paragraph_zero_based":4144},{"literal_text_all_w_t_and_m_t":"Indicates that UE supports NAICS, i.e. receiving assistance information from serving cell and using it to cancel or suppress interference of neighbouring cell(s) for at least one band combination. If not present, UE does not support NAICS for any band combination. The field numberOfNAICS-CapableCC indicates the number of component carriers where the NAICS processing is supported and the field numberOfAggregatedPRB indicates the maximum aggregated bandwidth across these of component carriers (expressed as a number of PRBs) with the restriction that NAICS is only supported over the full carrier bandwidth. The UE shall indicate the combination of {numberOfNAICS-CapableCC, numberOfNAICS-CapableCC} for every supported numberOfNAICS-CapableCC, e.g. if a UE supports {x CC, y PRBs} and {x-n CC, y-m PRBs} where n>=1 and m>=0, the UE shall indicate both.","paragraph_zero_based":4145},{"literal_text_all_w_t_and_m_t":"-For numberOfNAICS-CapableCC = 1, UE signals one value for numberOfAggregatedPRB from the range {50, 75, 100};","paragraph_zero_based":4146},{"literal_text_all_w_t_and_m_t":"-For numberOfNAICS-CapableCC = 2, UE signals one value for numberOfAggregatedPRB from the range {50, 75, 100, 125, 150, 175, 200};","paragraph_zero_based":4147},{"literal_text_all_w_t_and_m_t":"-For numberOfNAICS-CapableCC = 3, UE signals one value for numberOfAggregatedPRB from the range {50, 75, 100, 125, 150, 175, 200, 225, 250, 275, 300};","paragraph_zero_based":4148},{"literal_text_all_w_t_and_m_t":"-For numberOfNAICS-CapableCC = 4, UE signals one value for numberOfAggregatedPRB from the range {50, 100, 150, 200, 250, 300, 350, 400};","paragraph_zero_based":4149},{"literal_text_all_w_t_and_m_t":"-For numberOfNAICS-CapableCC = 5, UE signals one value for numberOfAggregatedPRB from the range {50, 100, 150, 200, 250, 300, 350, 400, 450, 500}.","paragraph_zero_based":4150},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":4151}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["3883a4cd437f0ac70ade6468a13c97fe78a00cfab48a8ccd02943898a70dff32","8ef8c34e2d331004b5c590faf1c79079c640d19813246a58b0097557b82a365e","67bdd1182e50c4cdfcf072f822a795468005a484dbad913535d3f28382f5b15d","72017c5da7deacbe8a5d2660010b50ec1b750564ddb27f011d59a727e21aff11","8e8488ff86d7ed581dae623134272b7a1b836b53a5609cbfa2d85324e51e7518","0db59106910439f6625de42b99313c01278939dd5dd71f32e8803c7360a084d6","59f9c286fd978dae309325e66f62aaa45b1d34310d94f2726e2733170b43ef92","15f993bfec0a3d1c1d8a4a452d76bebe3d90e00c5019d68dd882b3b7991164d9","b3abdd7f14837e920247f79d35bc1451f3c7b61db3dfbea9d92f4ebcd8663e30","10fad37051d3eecd461ecb0c1fb856febf01be4568bb34791d4e9c1a5037f8a3","42001bd172a5a33fc60a1b248bae43522ae82711230709447d1abf12024e6adf","ea8e050f5f897e4b1bf02d31a7bbcf3e78a9d46778d8337757376c98ad78e18c","c8edc6cf6866e55ce23e4681cc177f5b297fa930f7141bceb1af4280989efc76","bb26a3e6f14607b0b0a1dbd4c0c40ad57d32c6bc1c9f1bce1780bb218b64eb92","e68c02d5964e88c2b3080e1c3fee85367b1253905f980c4d39729d3815cfd25b","06cc0502454a155a6f69a9351fcec8f607b570673c111fe85c3c6d359d264de7","65284acb1037cfceb79bec00144f28e9e54706bdd4575d243ef9b063d25bf279","7491cab9522b713347066a392e5be703643856bfe8fa82d719670fc5711a625d","321be1b00a6000dd69050c49772dd3bde9f610661844f3be2e6870366b9ccd2a","bd81b171065903503efabbc07c12331479ece6b765280e91994d305a694042df","9b26e5541a297a25a3eeb86c084b12e9ec99c357500ad4f4de9d0c81b5d7d4ec","0eec9d18dbdb8d0b63d64ddc2dbc4c0d72945d96c87f7948382d1860acba0c44","f3d0152eda0c7a7184be61750a175f03f51aea97e5536474e81a9665f849e151","0ed599732635fad53180bd149cc58834eaabd5daf2ed692b5f6c61b37a96f682"],"paragraph_range_zero_based":[4128,4151],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p4128"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ncsg","paragraph_zero_based":4152},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports measurement NCSG Pattern Id 0, 1, 2 and 3, as specified in TS 36.133 [16]. If this field is included and the UE supports asynchronous DC, the UE shall support NCSG Pattern Id 0, 1, 2 and 3. If this field is included but the UE does not support asynchronous DC, only NCSG Pattern Id 0 and 1 shall be supported","paragraph_zero_based":4153},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":4154},{"literal_text_all_w_t_and_m_t":"ng-EN-DC","paragraph_zero_based":4155},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports NGEN-DC.","paragraph_zero_based":4156},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4157},{"literal_text_all_w_t_and_m_t":"n-MaxList (in MIMO-UE-ParametersPerTM)","paragraph_zero_based":4158},{"literal_text_all_w_t_and_m_t":"Indicates for a particular transmission mode the maximum number of NZP CSI RS ports supported within a CSI process applicable for band combinations for which the concerned capabilities are not signalled. For k-Max values exceeding 1, the UE shall include the field and signal k-Max minus 1 bits. The first bit indicates n-Max2, with value 0 indicating 8 and value 1 indicating 16. The second bit indicates n-Max3, with value 0 indicating 8 and value 1 indicating 16. The third bit indicates n-Max4, with value 0 indicating 8 and value 1 indicating 32. The fourth bit indicates n-Max5, with value 0 indicating 16 and value 1 indicating 32. The fifth bit indicates n-Max6, with value 0 indicating 16 and value 1 indicating 32. The sixt bit indicates n-Max7, with value 0 indicating 16 and value 1 indicating 32. The seventh bit indicates n-Max8, with value 0 indicating 16 and value 1 indicating 64.","paragraph_zero_based":4159},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4160},{"literal_text_all_w_t_and_m_t":"n-MaxList (in MIMO-CA-ParametersPerBoBCPerTM)","paragraph_zero_based":4161},{"literal_text_all_w_t_and_m_t":"If signalled, the field indicates for a particular transmission mode the maximum number of NZP CSI RS ports supported within a CSI process applicable for band the concerned combination. Further details are as indicated for n-MaxList in MIMO-UE-ParametersPerTM.","paragraph_zero_based":4162},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":4163},{"literal_text_all_w_t_and_m_t":"NonContiguousUL-RA-WithinCC-List","paragraph_zero_based":4164},{"literal_text_all_w_t_and_m_t":"One entry corresponding to each supported E-UTRA band listed in the same order as in supportedBandListEUTRA.","paragraph_zero_based":4165},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":4166},{"literal_text_all_w_t_and_m_t":"nonPrecoded (in MIMO-UE-ParametersPerTM)","paragraph_zero_based":4167},{"literal_text_all_w_t_and_m_t":"Indicates for a particular transmission mode the UE capabilities concerning non-precoded EBF/ FD-MIMO operation (class A) for band combinations for which the concerned capabilities are not signalled in MIMO-CA-ParametersPerBoBCPerTM, and the FD-MIMO processing capability condition as described in NOTE 8 is satisfied.","paragraph_zero_based":4168},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4169},{"literal_text_all_w_t_and_m_t":"nonPrecoded (in MIMO-CA-ParametersPerBoBCPerTM)","paragraph_zero_based":4170},{"literal_text_all_w_t_and_m_t":"If signalled, the field indicates for a particular transmission mode, the UE capabilities concerning non-precoded EBF/ FD-MIMO operation (class A) applicable for the concerned band combination.","paragraph_zero_based":4171},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4172},{"literal_text_all_w_t_and_m_t":"nonUniformGap","paragraph_zero_based":4173},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports measurement non uniform Pattern Id 1, 2, 3 and 4 in LTE standalone as specified in TS 36.133 [16].","paragraph_zero_based":4174},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":4175}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["d423cb20b9eaf44abbad76b0db7f9a4ca002f2b09dfbe08e852b74290e81905f","da888807cb2791514e8a94165c503d6763346c7a1d1a14619f04d21f37f95fb9","8aab8bfd2c4e1b9139c1eb71a295b2caaab50c7db1d5ad0b08db578c8e5f45be","c68b0c007522dc1887735e8d8691e1bb0e2bf2565b9d4db272f5b87280f81644","8d3cd6d8938a7d65ab9ae1c2dcadd54824d71824ff6928f9ba23b703c1fb5074","f4fb5ff8bd5da2e65f4e70c27c5b136c324768d1bb36581747d64485d218be02","a30492defdb12ab1200496e661b1e0ddba0c2771623084242ad663b757de0d8f","cfe1e27d8df436b28ce05faeab385103a7b35caf77a0788e71ed2eee9795a195","5f6e3f7685f3f7719012c41af155d0c779c74f580e968b73ab689df7f5d31499","00df8e1220201000b0282a005537c10c98fbf02f7fa72935e2fc362faf4eb6e1","72106f2a715fbd19be62119574961247f998fe74e5d388f14c7c16bd87896907","f523e9aa07a6813c93447127178c6215335023296bff20f0090e65d5d5a869f9","dd5e9d1f392130cd6ad4b0d9aafce512355ed9807046da7f559857562897c1b0","5d83424f8b043aa6f84f8e96687fee9aa7ac917ef86af553b81d8c17ddd78c46","cce08399329c47f874c32e53b900fa0ba6608ee2d609525efdc1ec85cc7780a9","1a6b3fce63b9e36998037847cb8fc233cc1e551e2e2137d8c7d8d7297da82ce0","446ff1408e2ef93371a83f4eb58303f74578e66649662fbd8246942c7e21a80a","fce21a20b1077e44344c63c78342c734c6abbf72d8ae1a887738c0b97a7f17e9","1c582fa5665d8f4b67c23e2e28ac23c4d4290a0d01a4aa5314ed8f4df3738627","1e033e5ad123cac20dde2481a06f3b62cc93658c6190ba828ebc2deb3c850c26","6806fbae0cf677e136c0bf4f7d7091a2244db69c8014486fbd9809bb252202fd","cc2934e1c5531c94def3ee8bf149b81822c29b87d1bf771ba67b3438cf8f91e7","427d44cd66497d186d10dfd8566bda92e60fa620812d95840ddfcf626dbd4edc","eb2ba0c0cdaa654004ac5a4d2344d069a74843a8aa6bcc11d0f2f62e36cab9c5"],"paragraph_range_zero_based":[4152,4175],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p4152"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"noResourceRestrictionForTTIBundling","paragraph_zero_based":4176},{"literal_text_all_w_t_and_m_t":"Indicate whether the UE supports TTI bundling operation without resource allocation restriction.","paragraph_zero_based":4177},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":4178},{"literal_text_all_w_t_and_m_t":"nonCSG-SI-Reporting","paragraph_zero_based":4179},{"literal_text_all_w_t_and_m_t":"Indicates whether UE will report PLMN list from non-CSG cells.","paragraph_zero_based":4180},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4181},{"literal_text_all_w_t_and_m_t":"nr-AutonomousGaps-ENDC-FR1","paragraph_zero_based":4182},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports, upon configuration of useAutonomousGapsNR by the network, acquisition of relevant information from a neighbouring NR cell by reading the SI of the neighbouring cell on FR1 using autonomous gaps and reporting the acquired information to the network when it is configured with (NG)EN-DC.","paragraph_zero_based":4183},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4184},{"literal_text_all_w_t_and_m_t":"nr-AutonomousGaps-ENDC-FR2","paragraph_zero_based":4185},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports, upon configuration of useAutonomousGapsNR by the network, acquisition of relevant information from a neighbouring NR cell by reading the SI of the neighbouring cell on FR2 using autonomous gaps and reporting the acquired information to the network when it is configured with (NG)EN-DC.","paragraph_zero_based":4186},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4187},{"literal_text_all_w_t_and_m_t":"nr-AutonomousGaps-FR1","paragraph_zero_based":4188},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports, upon configuration of useAutonomousGapsNR by the network, acquisition of relevant information from a neighbouring NR cell by reading the SI of the neighbouring cell on FR1 using autonomous gaps and reporting the acquired information to the network when it is not configured with (NG)EN-DC.","paragraph_zero_based":4189},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4190},{"literal_text_all_w_t_and_m_t":"nr-AutonomousGaps-FR2","paragraph_zero_based":4191},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports, upon configuration of useAutonomousGapsNR by the network, acquisition of relevant information from a neighbouring NR cell by reading the SI of the neighbouring cell on FR2 using autonomous gaps and reporting the acquired information to the network when it is not configured with (NG)EN-DC.","paragraph_zero_based":4192},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4193},{"literal_text_all_w_t_and_m_t":"nr-CellIndividualOffset","paragraph_zero_based":4194},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports use of cell specific offset for NR inter-RAT measurements.","paragraph_zero_based":4195},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":4196},{"literal_text_all_w_t_and_m_t":"nr-HO-ToEN-DC","paragraph_zero_based":4197},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports inter-RAT handover from NR to EN-DC while NR-DC or NE-DC is not configured. This field is mandatory present if EN-DC is supported.","paragraph_zero_based":4198},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4199}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["1e4346dd1beda9119b613b8fabc4ba0252dc8440657de73e27bf7b32a7e97f10","ef97ebdded3579b4e76a55f2f4c3453df0529aee1bf78abd150ec6997bba2693","4c51a9e1f711de7a3e175c822f75fb0d4093ce1090c080d8a4a8ca1fc1dc6dc2","b254e4da2dd7edfb4ceb298dd093af2616f8f641484c64d5930be9283fcfe497","a1f72ceeb21f1d58cda240965e70177ff463a600f08863c92ea90cb47f2797a6","23aa44f6e356cc755ee4d62c09e774cd15f7db6c55bee99690aabe2cd5a14a77","24a78413990025b6ed80927d1dcea30ac8a0ad2ca475bbd9f49fb0eb7ef944c0","0e59ea1f33fe334d18a5db923368373b6771c3fcc98c73091d3d6e1179b4491a","b2ae8047529389c8aec50311c9cb70820592c7b158d620c0224e5c8c2494444e","5a4d42010102916b57ddd6acad2aae8f09f83be2aabb6f901ab6e52664f121d8","a99b0c8afd4248c678072b1682315108bec85cdf2f68e41b96874e4cbc4c58db","c162c48111ce4d8371a564bad929b3e447b3df026321a62d36df81b6c2d7f37f","262167ab6656f87b38a485aa156acc24ee9af6b859d751ce8c19c10bd8f064a2","9ee015828200c0105c22f96f20d832e12a1528ef07d898c89ef98bc572f68310","aab7835cd939a5e560559f612bf093215be52d8efb007c7999b43f7675298d64","24a47a2cdf9850f43452f445214a805cced327ecf82150268d0aafad758e5178","6c07ec99c0df29535d8a8fea34bf06143f769707aca9d826b81c985b5e67610e","d0943df3b39556efa4dcbf7aec0f3995258317e410ace81ed031188f2db3f939","46275589dda7f376cb9bf689096124f67cf055a58116672328cf5c69330eddb3","6807ad46b299ad18881e656da0d8a71ea52aa530660e1fe9f3b3a6d46fa9e114","464e83a4e0d0fc4cedae6467c45c0a196c3fdfafbd3dce20655a86ead49cb5e1","1a37dcd060597f668bd2c2fa580d5dae741ebc0e633df02a777680241881dfbc","a689baebb3feae599ee7fafb22048b5ba9c802fbc2147a07fbc11f46017e4032","a0c60f40bb6a262c07f6daea4e81cd357345a70ed4507517d20dd000f5364553"],"paragraph_range_zero_based":[4176,4199],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p4176"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"nr-IdleInactiveBeamMeasFR1","paragraph_zero_based":4200},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports performing eNB-configured SSB-based beam level RRM measurements for configured NR FR1 carrier(s) in RRC_IDLE and in RRC_INACTIVE as specified in TS 36.306 [5], clause 4.3.6.46.","paragraph_zero_based":4201},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":4202},{"literal_text_all_w_t_and_m_t":"nr-IdleInactiveBeamMeasFR2","paragraph_zero_based":4203},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports performing eNB-configured SSB-based beam level RRM measurements for configured NR FR2 carrier(s) in RRC_IDLE and in RRC_INACTIVE as specified in TS 36.306 [5], clause 4.3.6.47.","paragraph_zero_based":4204},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":4205},{"literal_text_all_w_t_and_m_t":"nr-IdleInactiveMeasFR1","paragraph_zero_based":4206},{"literal_text_all_w_t_and_m_t":"Indicates whether UE supports reporting measurements performed on NR FR1 carrier(s) during RRC_IDLE and RRC_INACTIVE.","paragraph_zero_based":4207},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":4208},{"literal_text_all_w_t_and_m_t":"nr-IdleInactiveMeasFR2","paragraph_zero_based":4209},{"literal_text_all_w_t_and_m_t":"Indicates whether UE supports reporting measurements performed on NR FR2 carrier(s) during RRC_IDLE and RRC_INACTIVE.","paragraph_zero_based":4210},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":4211},{"literal_text_all_w_t_and_m_t":"nr-RSSI-ChannelOccupancyReporting","paragraph_zero_based":4212},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports performing measurements and reporting of RSSI and channel occupancy on the corresponding NR band.","paragraph_zero_based":4213},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4214},{"literal_text_all_w_t_and_m_t":"ntn-Autonomous-GNSS-Fix","paragraph_zero_based":4215},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE supports autonomous GNSS position fix in RRC_CONNECTED.","paragraph_zero_based":4216},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4217},{"literal_text_all_w_t_and_m_t":"ntn-Connectivity-EPC","paragraph_zero_based":4218},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports NTN access when connected to EPC. If the UE indicates this capability, the UE shall support all NTN essential features as specified in TS 36.306 [5].","paragraph_zero_based":4219},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4220},{"literal_text_all_w_t_and_m_t":"ntn-DCI-HarqDisableMultiTB-CE-ModeB","paragraph_zero_based":4221},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE supports DCI-based HARQ feedback disabling for downlink transmission when HARQ feedback disabling per HARQ process for downlink transmission is not configured by RRC and the UE is operating in CE mode B and when configured with ce-PDSCH-MultiTB-Config.","paragraph_zero_based":4222},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4223}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["6835ec98a923969e2dd88fec7448aa4c7bec536fc19c99ee35e0c8379abb7ab5","2b6052a233b546ca9697e39943dd0562e313bfb1240e1b99562a674ea84af09c","62aa584799676711a763825091e3a35f3100a32f7b0ef7f3d4531559fd074610","03224456249e2569a5703e2cfe731834a60e65bbce572e6b7bc71c530d460194","1b335afbc8efe5cbec31e4929b39c73c50dab91596ecda68c547687f94d55e73","e29424435feeefa731409172648b236487205eff720d60734ec5a65a7d0a3491","1fd2f6376cc1d29ff19c15f4a13b771733c2da7435e07fdfb6951f2f47341dc6","3046a841c1aabb6ebedc90e2d94b5d27520482c318b78f29b876c28f9a21f3e4","451293b037646844a47b580d9891029d5465ee9ad0d897d53e815c1b76cc363c","c600d5d0b80bea0f9d677a5402ea346bd6a27ce1a381408b2f53efe43ddd61e1","35b005306efd7c489b992c674571957991fd57f12091ba5370f7954ebb757d4c","b43cd720b9892c09978ce5b866c338ee940bf84b030b31b7b885cfee8ec9ca28","2016ee665ba8354ba6339b45780c4567518aecaaa64daad72398f89801f09ff0","0151a491ddd08a07c8fa0c237e3daa15f13fca716d8d326848dbe92a82d7ce28","c0c05f0f6d6dc6168573618bbea31975611960b2a93347eace4a79262f9023fb","9e165b54dda0f6db3589f830cdd2df481ef606993eb16828a90e68c63e407c8e","7324862ddfff46c14fded45b97720d420132faca84c37dbfe54034f879f9bcbf","af5f65e39a799d5e6a6b8143386534ceda2519b51d3ef7eaf5586cce5748cbd8","ed8299ebd22d0cda3b5a70e2c233fdc31eb4c2c79822d707665424e94a71b108","1657c49084d4ef4f1ec3277ad233bb882b61ab11f339d0017cd5572a291f5976","54ef080523db033e43a97b35ae7ce378a74fe7dd3b23fa6c4889eac3cd2eb623","c802c545430362e915941e832a905bd0442592bec90f43112fdb34f0c45f1313","304f71990b266713f15f57fa690283b339d34827bb7910b77b98c232008bfd8f","97aab69495a2f3ecefe8ad6df0165c0657a9fb6f7415b9bd6a34d573d5ddd4ab"],"paragraph_range_zero_based":[4200,4223],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p4200"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ntn-DCI-HarqDisableSingleTB-CE-ModeB","paragraph_zero_based":4224},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE supports DCI-based HARQ feedback disabling for downlink transmission when HARQ feedback disabling per HARQ process for downlink transmission is not configured by RRC and when the UE is operating in CE mode B.","paragraph_zero_based":4225},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4226},{"literal_text_all_w_t_and_m_t":"ntn-EventA4BasedCHO","paragraph_zero_based":4227},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE supports Event A4-based conditional handover, i.e., CondEvent A4.","paragraph_zero_based":4228},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4229},{"literal_text_all_w_t_and_m_t":"ntn-GNSS-EnhScenarioSupport","paragraph_zero_based":4230},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE supports GNSS measurement and UL transmission extension enhancements in RRC_CONNECTED for only GSO or NGSO scenario. If this field is not included, the GNSS measurement and UL transmission extension enhancements in RRC_CONNECTED that are indicated as supported are applicable for both GSO and NGSO scenario.","paragraph_zero_based":4231},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4232},{"literal_text_all_w_t_and_m_t":"ntn-HarqEnhScenarioSupport","paragraph_zero_based":4233},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE supports UL and DL HARQ process enhancements for only GSO or NGSO scenario. If this field is not included, the UL and DL HARQ process enhancements that are indicated as supported are applicable for both GSO and NGSO scenario.","paragraph_zero_based":4234},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4235},{"literal_text_all_w_t_and_m_t":"ntn-IdleMobilityForNR","paragraph_zero_based":4236},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports the inter-RAT redirection from an E-UTRA terrestrial network cell to an NR NTN cell and receiving dedicated priority of NR NTN frequency for cell reselection, see TS 36.304 [4].","paragraph_zero_based":4237},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4238},{"literal_text_all_w_t_and_m_t":"ntn-LocationBasedCHO-EFC","paragraph_zero_based":4239},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE supports location-based conditional handover for earth fixed cell, i.e., CondEvent D1.","paragraph_zero_based":4240},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4241},{"literal_text_all_w_t_and_m_t":"ntn-LocationBasedCHO-EMC","paragraph_zero_based":4242},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE supports location-based conditional handover for earth moving cell, i.e., CondEvent D2.","paragraph_zero_based":4243},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4244},{"literal_text_all_w_t_and_m_t":"ntn-LocationBasedMeasTrigger-EFC","paragraph_zero_based":4245},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE supports location-based measurement trigger in RRC_CONNECTED in earth fixed cell.","paragraph_zero_based":4246},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4247}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["7d15e46bd9ab0f8d71c02aae6483ee5ccf101dc3eccc1955b1a886d4b1a8bfc6","e2b2d77474ac69c0b34ff1b19207c076d60710e55d6bc7e1bc84b7bbf95ccab3","77a4853fc84e40e2f55c05fdf636214dc1a769bfba7fca752e5bad283c248de7","cf7