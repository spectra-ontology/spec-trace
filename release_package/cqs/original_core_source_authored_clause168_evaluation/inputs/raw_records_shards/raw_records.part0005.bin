{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48480},{"literal_text_all_w_t_and_m_t":"–SL-ScheduledConfig","paragraph_zero_based":48481},{"literal_text_all_w_t_and_m_t":"The IE SL-ScheduledConfig specifies sidelink communication/positioning configurations used for network scheduled NR sidelink communication/positioning.","paragraph_zero_based":48482},{"literal_text_all_w_t_and_m_t":"SL-ScheduledConfig information element","paragraph_zero_based":48483},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":48484},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SCHEDULEDCONFIG-START","paragraph_zero_based":48485},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48486},{"literal_text_all_w_t_and_m_t":"SL-ScheduledConfig-r16 ::=                   SEQUENCE {","paragraph_zero_based":48487},{"literal_text_all_w_t_and_m_t":"    sl-RNTI-r16                                  RNTI-Value,","paragraph_zero_based":48488},{"literal_text_all_w_t_and_m_t":"    mac-MainConfigSL-r16                         MAC-MainConfigSL-r16                                     OPTIONAL,    -- Need M","paragraph_zero_based":48489},{"literal_text_all_w_t_and_m_t":"    sl-CS-RNTI-r16                               RNTI-Value                                               OPTIONAL,    -- Need M","paragraph_zero_based":48490},{"literal_text_all_w_t_and_m_t":"    sl-PSFCH-ToPUCCH-r16                         SEQUENCE (SIZE (1..8)) OF INTEGER (0..15)                OPTIONAL,    -- Need M","paragraph_zero_based":48491},{"literal_text_all_w_t_and_m_t":"    sl-ConfiguredGrantConfigList-r16             SL-ConfiguredGrantConfigList-r16                         OPTIONAL,    -- Need M","paragraph_zero_based":48492},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":48493},{"literal_text_all_w_t_and_m_