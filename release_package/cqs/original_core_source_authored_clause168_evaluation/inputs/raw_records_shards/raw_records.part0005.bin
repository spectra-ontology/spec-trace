{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4728},{"literal_text_all_w_t_and_m_t":"<Text Omitted>","paragraph_zero_based":4729},{"literal_text_all_w_t_and_m_t":"–RadioBearerConfig","paragraph_zero_based":4730},{"literal_text_all_w_t_and_m_t":"The IE RadioBearerConfig is used to add, modify and release signalling, multicast MRBs and/or data radio bearers. Specifically, this IE carries the parameters for PDCP and, if applicable, SDAP entities for the radio bearers.","paragraph_zero_based":4731},{"literal_text_all_w_t_and_m_t":"RadioBearerConfig information element","paragraph_zero_based":4732},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":4733},{"literal_text_all_w_t_and_m_t":"-- TAG-RADIOBEARERCONFIG-START","paragraph_zero_based":4734},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4735},{"literal_text_all_w_t_and_m_t":"RadioBearerConfig ::=                   SEQUENCE {","paragraph_zero_based":4736},{"literal_text_all_w_t_and_m_t":"    srb-ToAddModList                        SRB-ToAddModList                                        OPTIONAL,   -- Cond HO-Conn","paragraph_zero_based":4737},{"literal_text_all_w_t_and_m_t":"    srb3-ToRelease                          ENUMERATED{true}                                        OPTIONAL,   -- Need N","paragraph_zero_based":4738},{"literal_text_all_w_t_and_m_t":"    drb-ToAddModList                        DRB-ToAddModList                                        OPTIONAL,   -- Cond HO-toNR","paragraph_zero_based":4739},{"literal_text_all_w_t_and_m_t":"    drb-ToReleaseList                       DRB-ToReleaseList                                       OPTIONAL,   -- Need N","paragraph_zero_based":4740},{"literal_text_all_w_t_and_m_t":"    securityConfig                          SecurityConfig        