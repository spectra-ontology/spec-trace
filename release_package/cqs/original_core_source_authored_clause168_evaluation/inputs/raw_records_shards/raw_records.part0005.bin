{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":72},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":73},{"literal_text_all_w_t_and_m_t":"If the CR is not approved, the specification for AI/ML for NR air interface may not work correctly.","paragraph_zero_based":74},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":75},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":76},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":77},{"literal_text_all_w_t_and_m_t":"5.3.5.3, 5.3.5.9, 5.3.8.3, 5.3.10.3, 5.3.11, 5.3.13.4, 5.5.4.2, 5.5.4.3, 5.5a.1.3, 5.5a.2.2, 5.5a.3.2, 5.7.4.2, 5.7.4.3, 5.7.10.3, 6.2.2, 6.3.2, 6.3.4, 6.4, 11.2.1, 11.2.2","paragraph_zero_based":78},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":79},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":80},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":81},{"literal_text_all_w_t_and_m_t":"Y","paragraph_zero_based":82},{"literal_text_all_w_t_and_m_t":"N","paragraph_zero_based":83},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":84},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":85},{"literal_text_all_w_t_and_m_t":"Other specs","paragraph_zero_based":86},{"literal_text_all_w_t_and_m_t":"x","paragraph_zero_based":87},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":88},{"literal_text_all_w_t_and_m_t":" Other core specifications","paragraph_zero_based":89},{"literal_text_all_w_t_and_m_t":"TS 38.300 CR 1006,","paragraph_zero_based":90},{"literal_text_all_w_t_and_m_t":"TS 37.320 CR 0146 ","paragraph_zero_based":91},{"literal_text_all_w_t_and_m_t":"affected:","paragraph_zero_based":92},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":93},{"literal_text_all_w_t_and_m_t":"x","paragraph_