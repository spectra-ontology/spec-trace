{"fields":{"filename":"R2-2406697.zip::R2-2406697 Corrections for SL relay-331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>upon end-to-end PC5-RRC connection failure due to T400 expiry or integrity check failure of SL-SRB2 or SL-SRB3:","paragraph_zero_based":264},{"literal_text_all_w_t_and_m_t":"2>include sl-DestinationIdentityRemoteUE;","paragraph_zero_based":265},{"literal_text_all_w_t_and_m_t":"2>submit the RemoteUEInformationSidelink message to lower layers for transmission;","paragraph_zero_based":266},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":267},{"literal_text_all_w_t_and_m_t":"NEXT CHANGE","paragraph_zero_based":268},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":269},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":270},{"literal_text_all_w_t_and_m_t":"–SL-RLC-ChannelConfig","paragraph_zero_based":271},{"literal_text_all_w_t_and_m_t":"The IE SL-RLC-ChannelConfig specifies the configuration information for PC5 Relay RLC channel between L2 U2N Relay UE and L2 U2N Remote UE, or between L2 U2U Remote UE and L2 U2U Relay UE.","paragraph_zero_based":272},{"literal_text_all_w_t_and_m_t":"SL-RLC-ChannelConfig information element","paragraph_zero_based":273},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":274},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RLC-RLC-CHANNEL-CONFIG-START","paragraph_zero_based":275},{"literal_text_all_w_t_and_m_t":" ","paragraph_zero_based":276},{"literal_text_all_w_t_and_m_t":"SL-RLC-ChannelConfig-r17 ::=                  SEQUENCE {","paragraph_zero_based":277},{"literal_text_all_w_t_and_m_t":"    sl-RLC-ChannelID-r17                          SL-RLC-ChannelID-r17,","paragraph_zero_based":278},{"literal_text_all_w_t_and_m_t":"    sl-RLC-Config-r17                             SL-RLC-Config-r16                                 OPTIONAL,   -- Need M","paragraph_zero_based":279},{"literal_text_all_w_