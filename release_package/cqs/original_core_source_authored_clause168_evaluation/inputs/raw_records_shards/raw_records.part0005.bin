{"fields":{"filename":"R2-2409139.zip::R2-2409139.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"X","paragraph_zero_based":24},{"literal_text_all_w_t_and_m_t":"Core Network","paragraph_zero_based":25},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28},{"literal_text_all_w_t_and_m_t":"Title:","paragraph_zero_based":29},{"literal_text_all_w_t_and_m_t":"Correction to LTM MAC CE based CFRA with MSG1 repetition","paragraph_zero_based":30},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32},{"literal_text_all_w_t_and_m_t":"Source to WG:","paragraph_zero_based":33},{"literal_text_all_w_t_and_m_t":"Huawei, HiSilicon","paragraph_zero_based":34},{"literal_text_all_w_t_and_m_t":"Source to TSG:","paragraph_zero_based":35},{"literal_text_all_w_t_and_m_t":"R2","paragraph_zero_based":36},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38},{"literal_text_all_w_t_and_m_t":"Work item code:","paragraph_zero_based":39},{"literal_text_all_w_t_and_m_t":"NR_Mob_enh2-Core, NR_cov_enh2-Core, NR_redcap-Core, NR_redcap_enh-Core","paragraph_zero_based":40},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41},{"literal_text_all_w_t_and_m_t":"Date:","paragraph_zero_based":42},{"literal_text_all_w_t_and_m_t":"2024-10-04","paragraph_zero_based":43},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"baf9a6a317ecb737bd27ac62657fd838b2787d36b6e40c23a2dd4a3025606770","original_member_sha256":"4803f0e09a6d5f8c28332929848401ac4e2ba1faa08e4ff6be3754ebe6aca508","paragraph_ElementTree_utf8_XML_sha256":["7fa0d951dac83c421b986b98ee0a58d8e15e4098d17692af9a76eeae8853fa93","f54024002607d0b290c906a4cfe0a939bcf728f878a9c4d41db3706e01b8c5c4","c3974f0594cd0eec3043c0eec39b8b87e03919eba0ee4a3ec2ed914216cf7e94","ba5b3dc94657e9f108e9a099c8ad7c875d86dbc7cc43d2d7a7eab49581b40af3","380e5ef9f935699e737eb7290bc8bdaaee897208ba128d659ac73a169b66ad78","93357f3338f697f0e4de99ff4069d61c6d019cc5b0fafd7630a105b8266ad33f","5cfb5fd64e46f0a516a489a3e137bc1b499f71ce1323b1fb2f44c46dd6f4d4f3","01e06fc02e9b782e3dd551c27859c7d5b4ea025bb9d46a65712851e586ab7e9b","c8f6f8e6e7a87e1661dbc6d4427e2fc9432c1ecf769d1630be4c8c66d6ac72ef","e2e26a63be069ce399bfc5c2ebf3f5ab8d497c44c5b516a5f636d0df082df79c","080bd152904b5ee0233c3218cfe2bd80cce2cdb1bd3a55c57db02fd78fa191dc","353ac41a7f09c9fb85eb7f20ea12c3c695074e829eb30791f87f07ac8393b8cb","3463c7b3721a990824b741a8b5dd0778bb29da6f809b27204bf366dbe04da541","7aafa1fb821d5bf6fe6fef87a3815b62eff7f8fbce9a2c369881ccff4e194e0e","601957edbeae053232ca38f9bd921e88b18f72dea0b435489c218ba14d035d03","2fdbac3f1fe854a1bc7b8279624dca9305fef120c62b344e09c03309b240c5f8","60304a00a907ead195a0e5424e8b8e97bbe4e0819ab7e9fd3af8958f9c501269","ca5d1d26805f6dc0018d1346bc587ca00017d54ad3e1a6a1cd6ffb3956186486","f4535e786156399c243a190efd3cfdd86e874ebd959890c8f9825ad5047163bc","189a208cf1b5c3fde926c6902c5159a2aee435ec2bb91dcc8837f48a3c87f8cd","0b6a9db093be74e5b64a15df3083375eeff321d4fd9a3cffd51d01ae2081e429","b58da0d6ab6c573b9ae463996864d4a96eed80e003a1f160d118bb3696fc7430","b634b13c74d80bb5d311f90771f2e1f5d111d2ec3602116f8ef03dbcf997b123","53852d7fa408fdf035f24abfed3b43ddad70efc7b7f0422e639889126d78bdbd"],"paragraph_range_zero_based":[24,47],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2409139.zip::R2-2409139.docx:p24"}
{"fields":{"filename":"R2-2409139.zip::R2-2409139.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"F","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Rel-18","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-17(Release 17)Rel-18(Release 18)Rel-19(Release 19) Rel-20(Release 20)","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":"Reason for change:","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"When contention-free random access resources have been provided, the UE needs to select a set of random access resources, in order to have a right parameters initialization (e.g. RACH-ConfigCommon) for CFRA and als to enable CFRA-to-CBRA fallback, as specified in TS 38.321, clause 5.1.1b, without parameter re-initialization. Hence when providing the CFRA resource, the restriction on same repetition number with CBRA is the prerequition for CFRA configuration. ","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"For RRC based CFRA, configuration restrictions in rach-ConfigDedicated are defined separately for non-(e)RedCap UEs, Redcap UEs and eRedCap UEs and the (e)RedCap UEs needs to additionally consider the restriction on (e)RedCap indication with same repetition number as below:","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"4StepCFRArep","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"For non-(e)RedCap UEs, the field is optionally present, Need S, if resources is set to ssb and there is one FeatureCombinationPreambles entry indicating only msg1-Repetitions which is associated with the same Msg1 repetition number.","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"For RedCap UEs or if RedCap is considered to be applicable for this Random Access procedure for eRedCap UEs, the field is optionally present, Need S, if resources is set to ssb and there is one FeatureCombinationPreambles entry indicating only redCap and msg1-Repetitions which is associated with the same Msg1 repetition number.","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"For eRedCap UEs, if eRedCap is considered to be applicable for this Random Access procedure, the field is optional present, Need S, if resource is set to ssb and there is one FeatureCombinationPreambles entry indicating only eRedCap and msg1-Repetitions which is associated with the same Msg1 repetition number.","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"Otherwise, it is absent.","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"In LTM with MSG1 repetition, MAC CE based CFRA with MSG1 repetition introduced. To enable right parameters initialization and fallback for all UE types also in LTM CFRA with MSG1 repetition case, MAC CE based CFRA should have similar configuration restriction as RRC based CFRA. ","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"In TS 38.321, a note for configuration restriction is added but it is only for a non-(e)RedCap UEs. ","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"NOTE 1:A non-zero Msg1 repetition number value may only be included in the LTM Cell Switch Command MAC CE when the LTM target cell configuration has contention-based Random Access Resources with a FeatureCombinationPreambles with the same Msg1 repetition number value and featureCombination indicating only msg1-Repetitions.","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"baf9a6a317ecb737bd27ac62657fd838b2787d36b6e40c23a2dd4a3025606770","original_member_sha256":"4803f0e09a6d5f8c28332929848401ac4e2ba1faa08e4ff6be3754ebe6aca508","paragraph_ElementTree_utf8_XML_sha256":["236e3f9ab050304881c77f70bd18658ae78fb4bf19d52b0e76f2a27a85c88cc4","9f3be735a8f12e48b1100084e277c3a433c7db8cecf98d39522abb9bf360952c","1b1c06fbd2f9297480487bbfbcf63b01b0a87f11b0ec171d4374fac39c653f46","4590853b60f9bfed1dcc41e17b23beeb5245c7474a09e05a932938170ba98f9e","772fe42a4c9cd4e407bda3f173236123decacbbff3951f2a6877a3b4fd7e88f6","2be9b23aeaeaf19e4086c44ea582e8df3cf5de45961f5526285f863cb5517f60","b469941d77e28dc8f9655b1aaf5d004fa600f04d10bd592b1a975f5158743e64","4c5a6fa285f1230fc3aedb06c7c0954488b0646790bb6b85e28bee8a7df7ae99","e534dfb7cfd2873d25d393989f6cc330c3ba59ee6f627748c1833da89e9d8140","48654e6245a9d023ec9bca0caf1a77b6908b75c2f7a5397ee0978bde428c9739","cdbd4b49f21af4e014455f56d5b3b3949134ca6cb983617090c8818eb4ba6e95","282e1f57ad13ee46b28e0645218e468916ea2660ea3d540b83e2194693b49918","782adf585e3072647fa0995df05467c4186f6866255ed646defd479d797e4c30","3191a89af52ff6cc695a377de6e6ad5cc2639a1fed538c0b0a76a73c3502c0bd","3f33a72816d582fa1e36dd37d16ee5231c0f09244ef302b64282cf56d53dbe6a","54e116a761fd34e2ad2d7e18c65e329430d80d67b42c198c30ee2a1efa14478a","3550d1e92961ce49f5e2692e2c38b5eebd2d0ee3b01bbb04b83ae8eec8dc3eb4","346071c17558127fe04af66f4075b584094ab4c276af20a9ecb8a0bf35698cf9","4466252fb258df390ff57fa1d430b1458892b275de5053ff5d04d8b60f925b62","214f83b766f19a2ec3105810cd400368da93629a5a2659c13f5c168e9f121965","ac09e82923b3fece6c983625d26e4e45233fddfb5796426d21d0d077b0d40c71","3c247eb26a54ad39d5590396c719f0eb339dacb99b480bae43676fc5737292e4","0a3b2346fbb13cbef31e4db3e43a761fe23ad714bcfbc9a5633a182ae78062d4","9c740f3d7fbcad760c8a4b19e160020c585bfa23db295ee5777abd00841ea09e"],"paragraph_range_zero_based":[48,71],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2409139.zip::R2-2409139.docx:p48"}
{"fields":{"filename":"R2-2409139.zip::R2-2409139.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The Configuration restiction for the (e)RedCap UEs is missing somewhere in TS 38.321. For (e)RedCap UEs, the (e)Redcap indication needs to be included additionally with same repetition number restriction for MAC CE based CFRA, similarly as RRC based CFRA. Hence a MAC clarification is needed.","paragraph_zero_based":72},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":73},{"literal_text_all_w_t_and_m_t":"In MAC specification, “Redcap is considerred to be applicable for random access procedure” can conrrespond to both RedCap UEs and eRedcap UEs who consider itself as Redcap UEs due to there is no RA partition in RRC configuration associated with eRedcap indication. Hence we want to have a simplfiled wording. ","paragraph_zero_based":74},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":75},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":76},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":77},{"literal_text_all_w_t_and_m_t":"Add a NOTE to restict that for (e)RedCap UEs, a non-zero Msg1 repetition number value may only be included in the LTM Cell Switch Command MAC CE when the LTM target cell configuration has contention-based Random Access Resources with a FeatureCombinationPreambles with the same Msg1 repetition number value and featureCombination indicating msg1-Repetitions and (e)RedCap indication.","paragraph_zero_based":78},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":79},{"literal_text_all_w_t_and_m_t":"Impact analysis","paragraph_zero_based":80},{"literal_text_all_w_t_and_m_t":"Impacted functionality:","paragraph_zero_based":81},{"literal_text_all_w_t_and_m_t":"LTM, (e)RedCap, coverage enhancement, RACH partitioning","paragraph_zero_based":82},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":83},{"literal_text_all_w_t_and_m_t":"Inter-operability:","paragraph_zero_based":84},{"literal_text_all_w_t_and_m_t":"If the UE is implemented according to this CR but the network is not, the UE may select a wrong set of RACH resources and the RACH procedure may fail.","paragraph_zero_based":85},{"literal_text_all_w_t_and_m_t":"If the network is implemented according to this CR but the UE is not, there is no inter-operability issue.","paragraph_zero_based":86},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":87},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":88},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":89},{"literal_text_all_w_t_and_m_t":"At LTM cell switch with RACH using msg1 repetition, the UE may select a wrong set of RACH resources and the RACH procedure may fail.","paragraph_zero_based":90},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":91},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":92},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":93},{"literal_text_all_w_t_and_m_t":"6.1.3.75","paragraph_zero_based":94},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":95}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"baf9a6a317ecb737bd27ac62657fd838b2787d36b6e40c23a2dd4a3025606770","original_member_sha256":"4803f0e09a6d5f8c28332929848401ac4e2ba1faa08e4ff6be3754ebe6aca508","paragraph_ElementTree_utf8_XML_sha256":["78f6c102c301141a2ad086c963fd086188991c26685d0114d882b42e94bd0f81","9f88193ff4f7afede6006b82e0a4f211b217fb5f6148f3ff9e900e77a5d756a6","baf6ed7e5f07edf8aa1e719ffe814c5929e3ae021e3ea67a04c0aeff7aa019a0","6bc708a7cd82acb287bd5b5dd3bd5737053ee78215e384470c7d703c4c4d0f7b","cab556f06f2f7267211af1a6465aecf444dc2bc8db1defdb5cd054e299591c4e","bfe94f5aa3a0445238b1aa8acd629ba00629babf2cf39b2530af1c269a38bce8","afff879a08e692448be36b4b42a171060419876fbb0304c482ef5d