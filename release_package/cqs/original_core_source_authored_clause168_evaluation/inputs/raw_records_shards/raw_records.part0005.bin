{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports WLAN measurements in RRC connected mode.","paragraph_zero_based":3768},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3769},{"literal_text_all_w_t_and_m_t":"ims-VoiceOverMCG-BearerEUTRA-5GC","paragraph_zero_based":3770},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports IMS voice over NR PDCP for MCG bearer for E-UTRA/5GC.","paragraph_zero_based":3771},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":3772},{"literal_text_all_w_t_and_m_t":"ims-VoiceOverNR-FR1","paragraph_zero_based":3773},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports IMS voice over NR FR1.","paragraph_zero_based":3774},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":3775},{"literal_text_all_w_t_and_m_t":"ims-VoiceOverNR-FR2","paragraph_zero_based":3776},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports IMS voice over NR FR2-1.","paragraph_zero_based":3777},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":3778},{"literal_text_all_w_t_and_m_t":"ims-VoiceOverNR-FR2-2","paragraph_zero_based":3779},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports IMS voice over NR FR2-2.","paragraph_zero_based":3780},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3781},{"literal_text_all_w_t_and_m_t":"ims-VoiceOverNR-PDCP-MCG-Bearer","paragraph_zero_based":3782},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports IMS voice over NR PDCP with only MCG RLC bearer.","paragraph_zero_based":3783},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3784},{"literal_text_all_w_t_and_m_t":"ims-VoiceOverNR-PDCP-SCG-Bearer","paragraph_zero_based":3785},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports IMS voice over NR PDCP with only SCG RLC bearer when configured with EN-DC.","paragraph_zero_based":3786},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3787},{"literal_text_all_w_t_and_m_t":"ims-VoNR-PDCP-SCG-NGENDC","paragraph_zero_based":3788},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports IMS voice over NR PDCP with only SCG RLC bearer when configured with NGEN-DC.","paragraph_zero_based":3789},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3790},{"literal_text_all_w_t_and_m_t":"inactiveState","paragraph_zero_based":3791}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["500fb1a1a892a6a6cad6e78a9336030f91148bc5430d7efb83db99d8277aeb58","ed78eb0f61c4953e9b20886ae19c9f51cde95bb0b248f310a0f0854ceff35c06","b26b0cb170fda230f20929c418db9a780a479521f5988692f06e44a93b726d46","019b4694ffb487e54ac0ad68f4a34c23aa62ad5dacc349cf0acef8cfbce06ca2","dcca88af49fb4f82fa0a3c9028622903a19616d32a8e28efc80a70f65247fe65","e278d171bba722b8ed838f1f6222c7fb06eebe150aaa2fc5328cf2c12de6367e","162bb977280f1064528c7454b8b9b9e37bcfb46440bfee5c4739771b60a3180f","aba514a76eb935be9e0fa9bc4a0846f22e5111da80fbde5f34ad92b810de138a","0b9cb4076485345289aa4202063b91ef044c080e994b267190562ba66c6e6167","2f073458c77462e1816e0d6533c74393cdf0faedf0660c8549bab83c52b9625b","3d2b11b4825f46316c18093a7efb62398970b2e592a18df4ab0c2fb8635c205f","0336d9a4c1488e92c057944c2ec0febc02864261877088c6cdde2e534b489584","5d71332fe20897f5fa41eda9583b452e827f191eb0b01f5224f4e35b64d0d10f","6b7df4f2a49700972404deec341bc7ec6cacb7c42cabab4b32838df1bcad9d4f","524d53d70b18ea2ce633155aea609077e312d7dad17eb1ecec3aa93443306476","61c957ff24ebf03cfb8d28ba430feab4e970de1345bea96cf7c50854645acd35","2b08a175f0c21a1b22d3d17be6e2c