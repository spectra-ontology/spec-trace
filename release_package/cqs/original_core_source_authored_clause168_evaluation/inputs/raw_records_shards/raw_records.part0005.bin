{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SL-RLC-ChannelConfig-r17 ::=                  SEQUENCE {","paragraph_zero_based":48408},{"literal_text_all_w_t_and_m_t":"    sl-RLC-ChannelID-r17                          SL-RLC-ChannelID-r17,","paragraph_zero_based":48409},{"literal_text_all_w_t_and_m_t":"    sl-RLC-Config-r17                             SL-RLC-Config-r16                                 OPTIONAL,   -- Need M","paragraph_zero_based":48410},{"literal_text_all_w_t_and_m_t":"    sl-MAC-LogicalChannelConfig-r17               SL-LogicalChannelConfig-r16                       OPTIONAL,   -- Need M","paragraph_zero_based":48411},{"literal_text_all_w_t_and_m_t":"    sl-PacketDelayBudget-r17                      INTEGER (0..1023)                                 OPTIONAL,   -- Need M","paragraph_zero_based":48412},{"literal_text_all_w_t_and_m_t":"    ...}","paragraph_zero_based":48413},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48414},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RLC-CHANNEL-CONFIG-STOP","paragraph_zero_based":48415},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":48416},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48417},{"literal_text_all_w_t_and_m_t":"SL-RLC-ChannelConfig field descriptions","paragraph_zero_based":48418},{"literal_text_all_w_t_and_m_t":"sl-MAC-LogicalChannelConfig","paragraph_zero_based":48419},{"literal_text_all_w_t_and_m_t":"The field is used to configure MAC SL logical channel parameters.","paragraph_zero_based":48420},{"literal_text_all_w_t_and_m_t":"sl-RLC-ChannelID","paragraph_zero_based":48421},{"literal_text_all_w_t_and_m_t":"Indicates the PC5 Relay RLC channel in the link between L2 U2N Relay UE and L2 U2N Remote UE, or between L2 U2U Remote UE and L2 U2U Relay UE.","paragraph_zero_based":48422},{"literal_text_all_w_t_and_m_t":"sl-RLC-Config","paragraph_zero_based":48423},{"literal_text_all_w_t_and_m_t":"Determines the RLC mode (UM, AM) and provides corresponding parameters.","paragraph_zero_based":48424},{"literal_text_all_w_t_and_m_t":"sl-PacketDelayBudget","paragraph_zero_based":48425},{"literal_text_all_w_t_and_m_t":"Indicates the Packet Delay Budget for a PC5 Relay RLC channel used in L2 U2N relay operation. Upper bound value for the delay that a packet may experience expressed in unit of 0.5ms.","paragraph_zero_based":48426},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48427},{"literal_text_all_w_t_and_m_t":"–SL-RLC-ChannelID","paragraph_zero_based":48428},{"literal_text_all_w_t_and_m_t":"The IE SL-RLC-ChannelID is used to identify a PC5 Relay RLC channel in the link between L2 U2N Relay UE and L2 U2N Remote UE, or between L2 U2U Relay UE and L2 U2U Remote UE.","paragraph_zero_based":48429},{"literal_text_all_w_t_and_m_t":"SL-RLC-ChannelID information element","paragraph_zero_based":48430},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":48431}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["3f410cb087f08ac93aaefcd4eb3dd16d711021ea32135fe4b4bf910b35b98744","9086c33628ba976df6e3705b0c86dccb0afa6792caaad451f0b914601c05a8ce","994e3dcd7a263f701b2d69ac869dbd82e2a70c5189dd3aa20a1523cb00e257bf","da4c327e5eb62d32d9aef8f1a07abf6d5da2a7c26df6ccad79d9df0a435f3420","8d62993ee043a13e4afec2ecf52677889289e22971cfbcd1e3dd02bde2e8367e","91d4eeae2318cb82d98e050484e11ae25af722bf4990a2a8e6695afddb19660b","2e52c4b9aaf84fcda19a0a9594d8e44bfa34e9d069829a6e1ce862de152ef7f2","78515f3d53b5444bec2cae90a53fd63cde163437c12d0ab4c5fc7067d33c15ad","d440e518791e07be897