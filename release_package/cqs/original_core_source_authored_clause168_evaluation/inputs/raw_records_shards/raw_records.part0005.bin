{"fields":{"filename":"R2-2509465.zip::R2-2509465.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"maxDL-PRS-RSRPP-MeasurementsPerTRP","paragraph_zero_based":624},{"literal_text_all_w_t_and_m_t":"This field specifies the maximum number of DL-PRS RSRPP measurements on different DL-PRS Resources from the same TRP.","paragraph_zero_based":625},{"literal_text_all_w_t_and_m_t":"nr-los-nlos-IndicatorRequest","paragraph_zero_based":626},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to provide the indicated type and granularity of the estimated LOS-NLOS-Indicator in the NR-DL-AoD-SignalMeasurementInformation.","paragraph_zero_based":627},{"literal_text_all_w_t_and_m_t":"reducedDL-PRS-ProcessingSamples","paragraph_zero_based":628},{"literal_text_all_w_t_and_m_t":"This field, if present and set to 'requested', indicates that the target device is requested to perform the requested measurements with reduced number of samples (M=1 or M=2) as specified in TS 38.133 [46].","paragraph_zero_based":629},{"literal_text_all_w_t_and_m_t":"lowerRxBeamSweepingFactor-FR2","paragraph_zero_based":630},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to use a lower Rx beam sweeping factor than 8 for FR2 according to UE's capability.","paragraph_zero_based":631},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-MeasurementTimeWindowsConfig","paragraph_zero_based":632},{"literal_text_all_w_t_and_m_t":"This field indicates DL-PRS Resource Set(s) occurring within time window(s) for performing measurements where the time window is indicated by a start time, periodicity, offset and duration.","paragraph_zero_based":633},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":634},{"literal_text_all_w_t_and_m_t":"[…]","paragraph_zero_based":635}],"source":"Whole authentic original CR source member; all unfiltered bo