_cell_coordinates":{"document_XML_sha256":"979fe2ba5a5970300d42d6c082b964ff9175e28a978c861fb9fd885ab0869b6c","original_member_sha256":"845d752bab35e8e94c85337019358a0f9bfe17c6f04d5e6b9cae8fb230b11301","paragraph_ElementTree_utf8_XML_sha256":["c07b5a28a70e16870dd7e1f799aac8dde46d833f5c9d7bb8792acb67b74567f5","701d9cd70d1642b2670a6bf0b6ef6ae1f4e9f4da99c745fcd410cab0503197c9","6f8d1c9b20f1dbd5471c082cf2af4279d2663b42f1d56f7a46a3ede764cda345","5c04f2942416cc66710e0561b4ed03bfe9f40e3e6555df1359bf2ce85ee015ed","472396934840df5d47965240916228c195ebac3c012bd0170ede44f10b1596cd","7515ffb46616a4ebaa12fae172d399610d13569c32858917d8a52156cf824c08","ebdf2907220ef9ef2702aa55370e61d592ce01fed023ec9cf08fedd303ec7657","264457d0ae02df3caa75e43f2c7871c9a8544bc4eceb4d40baf8b616682f97e2","b4b6848dd2908d69889b35314db1bd1dd348ecf5ced36f471b90ae94d15f80ea","2d6cbb1bfbfcad9cab3651b6f219a44ae4825a66cd1aa70b4dc2b12f3cd99905","db459015eb1431d9befa6c51581a509a4ad244352adeb349cdfa9dd654899916","6e0fca7799c831f76a7c1b4c946a05fe1a1740a606f84c5b3535531303ecbc2f","bceadb22c373d2e8232d68d60549c5ec28e07597f09460968fe947e836a7b566","fac1143b84f961c26b00a258696e2b20e8656ea612881a88439dfec98fbd2b5c","17be645c1058a0e8881a1c10a8c59a68bbb13334bca38b033d236e912f332568","d9d44e736b6689b30983c2c558ae1f4ea50b220b087106246a4d058c2aad2d3c","2b47f731cf3f68180d35195ef458c3d96b2b2c165ad88dc2edbe2a0766ed373c","52d05001c8d2bfd3c51555edcfc4629e50f9c26e62ad233080bd7a428ca0a4b1","f970a063a23712f03a0037deaea7c3ad9e994036fbef97e9c4c6ff4345d5f724","564258ce11598d4d3536a5afe1d1e87948d088ceb75e47401a68d6c8c4a6dec5","1f070165a4fd6bc05d5582a82accfec41169b0efdac73adcf778cd0a8154bd9b","ae0f12197d1e70ced737aa428636f6694943102f8f46683196e9275132413d07","0ab284a0c7bd1833b9392115137b917aadf1f95a68d36d2bb54be85ae94136ca","37d76393019ee00dde6717fd0f79518b97fd48b1a23eb8ed1724f726cad85a2d"],"paragraph_range_zero_based":[72,95],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation o