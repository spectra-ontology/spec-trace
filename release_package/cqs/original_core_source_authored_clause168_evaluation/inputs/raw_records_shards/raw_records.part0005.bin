{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports SPS repetition for slot PUSCH for PSCell.","paragraph_zero_based":4464},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4465},{"literal_text_all_w_t_and_m_t":"pusch-SPS-SlotRepSCell","paragraph_zero_based":4466},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports SPS repetition for slot PUSCH for serving cells other than SpCell.","paragraph_zero_based":4467},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4468},{"literal_text_all_w_t_and_m_t":"pusch-SPS-SubframeRepPCell","paragraph_zero_based":4469},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports SPS repetition for subframe PUSCH for PCell.","paragraph_zero_based":4470},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4471},{"literal_text_all_w_t_and_m_t":"pusch-SPS-SubframeRepPSCell","paragraph_zero_based":4472},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports SPS repetition for subframe PUSCH for PSCell.","paragraph_zero_based":4473},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4474},{"literal_text_all_w_t_and_m_t":"pusch-SPS-SubframeRepSCell","paragraph_zero_based":4475},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports SPS repetition for subframe PUSCH for serving cells other than SpCell.","paragraph_zero_based":4476},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4477},{"literal_text_all_w_t_and_m_t":"pusch-SPS-SubslotRepPCell","paragraph_zero_based":4478},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports SPS repetition for subslot PUSCH for PCell. This field is only applicable for UEs supporting FDD.","paragraph_zero_based":4479},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4480},{"literal_text_all_w_t_and_m_t":"pusch-SPS-SubslotRepPSCell","paragraph_zero_based":4481},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports SPS repetition for subslot PUSCH for PSCell. This field is only applicable for UEs supporting FDD.","paragraph_zero_based":4482},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4483},{"literal_text_all_w_t_and_m_t":"pusch-SPS-SubslotRepSCell","paragraph_zero_based":4484},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports SPS repetition for subslot PUSCH for serving cells other than SpCell. This field is only applicable for UEs supporting FDD.","paragraph_zero_based":4485},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4486},{"literal_text_all_w_t_and_m_t":"pusch-SRS-PowerControl-SubframeSet","paragraph_zero_based":4487}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["45b300e137da87cd4abf9438b7fb37732eb9539bcbfe42846271b4fed96e1bb8","138e69f594f4a354e446566caac51b9d62ff7059a8c03419c67dadd698685de1","c4f6ac40a9e3b5c9e01e83d7ce981cb53630adc88bdf28553d01127041cee861","35feab3ddb02acb8c9e4de8ebf6827f29b44c015f2a21911ab09910842f5fd7d","afe4c594da3091e5e278cdddab291d6afddf74fd9ab279cf5973a6bbb16d1ff5","3475c3052fdbc2193d0faaf25fcad453edff03096fa4ba807879f63d8b4fde0a","131155319172f193e37d8575a93ee34855c0dc5a9bbae9a27ffdc1abfb4ce2dc","4d07115d611fe326cfab0c1fc0afba08004d186fe4f701990664d0c684f6fa15","53433bf8c2b5c6ecfcd9de1b7bc58073089fd41ea5b057ebf26b69923f41ba8a","5ca9421dd6dda5d56638dd3889849f4f92bd2ac4ae4b2cce70667121071bd160","e81cd1ef7ab59dc2cfd099749cd443ed81e9487317449fedd6ff5d3d92422251","527124b7cd7b5337f06d47f8c5bd7d6d79d02133238a041a62d6aa4959def255","30cb827744f4b6b8d524f3b2a4c2ee92a7c2ae37b97b2e66fc7bdc