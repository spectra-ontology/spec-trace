{"fields":{"filename":"R2-2505772.zip::R2-2505772_MHSLRelayCap_CR_v0_Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the access stratum release for NR sidelink communication the UE supports as specified in TS 38.331 [9].","paragraph_zero_based":120},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":121},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":122},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":123},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":124},{"literal_text_all_w_t_and_m_t":"multipathRelayUE-N3C-r18","paragraph_zero_based":125},{"literal_text_all_w_t_and_m_t":"Indicates whether L2 multi-path relay UE operation using non-3GPP connection is supported by the UE.","paragraph_zero_based":126},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":127},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":128},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":129},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":130},{"literal_text_all_w_t_and_m_t":"multipathRemoteUE-N3C-r18","paragraph_zero_based":131},{"literal_text_all_w_t_and_m_t":"Indicates whether L2 multi-path remote UE operation using non-3GPP connection is supported by the UE.","paragraph_zero_based":132},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":133},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":134},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":135},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":136},{"literal_text_all_w_t_and_m_t":"multipathRemoteUE-PC5L2-r18","paragraph_zero_based":137},{"literal_text_all_w_t_and_m_t":"Indicates whether L2 multi-path remote UE operation using PC5 connection is supported by the UE. A UE supporting this feature shall also indicate support of remoteUE-Operation-L2-r17.","paragraph_zero_based":138},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":139},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":140},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":141},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":142},{"literal_text_all_w_t_and_m_t":"pdcp-DuplicationMoreThanOneUuRLC-r18","paragraph_zero_based":143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3d0669bebb61232fe20acea50a76ee807988cbd3d6f41a5e37816ee6179e9413","original_member_sha256":"c7379de7097f64dafbf008e1c06b57228e6acf168e72c816abdff7ae0ffde250","paragraph_ElementTree_utf8_XML_sha256":["1dfb4d4f5a3b3b0014b2fb46d3cec5aa7606a4c4d76096d3a3e310c6e00e51b2","12b43617c9842def91fbb346396ed5928e452c65c982a43d09910163cc8d8c17","3bd9c526d36fda4e2bfc8fb3b1249386f574fff34e978f99505f9052fc19d087","0dd9820736b107c0c4187bb2f48e82c78108a879c30822772d7794f82df4f67e","957edce0f77b18bdfe8a7327dc451fd81906353c80798a08f5bb8a78227fc4ce","a7c3ec7001dcaacdd70c0de1bdfe6b60785b232e15db6a4e09738bde759fde49","dbce7a185fc2fe3efbca1320c8d6cdaaf379760bf35131ce1c242ae772d85c1a","85bdae2c494fdeac47f68d9d5f14fda3d43781150a569c5f28c393b5aed94e13","4fce1d98ba7eacaf8bf8fb1b52d6c1ace6f36c8fccfeceb026e609ff3e7d7665","5dffa3874330a0fa1fffb0a34c2fe007026737a3161149c2f1d430cf16098060","6a165a4105cf888fe2e3c83ed0d75d7ea16dc54286d47e881dd25dc34bb3fb99","fd03e08b31969b76642b29368a3b8618610fbf1a32d4ae4bc79f4ee6554e3f39","ff843c93a764277ca0136f1fd6ac38289a7e0cb7dc49ed8b0853d58106ac605e","d85310401e36e3ae081c6f7256caf2cff3572f96a2bf8456760dcc25c9f2a829","80505b3eb81620aac1a06612b5871882021e2610417a137fecd7bc5de1d2acb4","d13e809e57554543caefa6b1ac7187a86cc4e28f0f6999d2a0c09558e5108eac","1648b96ec9f42099cbc162f51163dde222b02934738fcb78652f855827b90e63","155135d7c237eba90fd31fcff13feaac244bb9400b3d48407de5a0ba4b7afd1d","1c32258867d0043a48eab6163fb6bd654d259be1368234c191f0ba76f22af78d","993d8a31ecd9e38d953a8d8fbdf1af921f83fe108e557d30