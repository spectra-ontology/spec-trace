ce9b4709e18aeea1af83960469f811d7d3385359a7020cee854afe9bdfd781","a024aad5ccdcd4aca102e14d1edfecaec4c909560d063fe109ffa3e2760a40c9","209e9c019f28439e60a1b416dced925b0e4537cd8e3621b0beda0102cb18386e","b620cfcd533be98dbbd23a84df03503af333782759520233f6595f90699c5494","d956faba918b8b8866a50f7cf42de62829e3bceec01f4c27f7159ecbb190f520"],"paragraph_range_zero_based":[216,239],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2505201.zip::R2-2505201 MAC CR1591 for R19 IoT NTN.docx:p216"}
{"fields":{"filename":"R2-2505201.zip::R2-2505201 MAC CR1591 for R19 IoT NTN.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sTAGSecondary Timing Advance Group","paragraph_zero_based":240},{"literal_text_all_w_t_and_m_t":"sTTISlot or subslot TTI","paragraph_zero_based":241},{"literal_text_all_w_t_and_m_t":"TAGTiming Advance Group","paragraph_zero_based":242},{"literal_text_all_w_t_and_m_t":"TBTransport Block","paragraph_zero_based":243},{"literal_text_all_w_t_and_m_t":"TPC-PUCCH-RNTITransmit Power Control-Physical Uplink Control Channel-RNTI","paragraph_zero_based":244},{"literal_text_all_w_t_and_m_t":"TPC-PUSCH-RNTITransmit Power Control-Physical Uplink Shared Channel-RNTI","paragraph_zero_based":245},{"literal_text_all_w_t_and_m_t":"V2XVehicle-to-Everything","paragraph_zero_based":246},{"literal_text_all_w_t_and_m_t":"5MAC procedures","paragraph_zero_based":247},{"literal_text_all_w_t_and_m_t":"<Skip>","paragraph_zero_based":248},{"literal_text_all_w_t_and_m_t":"5.1x CB-Msg3-EDT Procedure","paragraph_zero_based":249},{"literal_text_all_w_t_and_m_t":"5.1x.1CB-Msg3-EDT initialization","paragraph_zero_based":250},{"literal_text_all_w_t_and_m_t":"The CB-Msg3-EDT procedure described in this clause is initiated by the RRC sublayer and can only be performed in a non-terrestrial network. If the UE is an NB-IoT UE, the CB-Msg3-EDT procedure is performed on the anchor carrier or one of the non-anchor carriers for which CB-Msg3-EDT resource has been configured in system information.","paragraph_zero_based":251},{"literal_text_all_w_t_and_m_t":"The following information is assumed to be available before the procedure can be initiated for NB-IoT UEs, BL UEs or UEs in CE mode A, as specified in TS 36.331 [8]:","paragraph_zero_based":252},{"literal_text_all_w_t_and_m_t":"-if the UE is a BL UE or a UE in CE mode A:","paragraph_zero_based":253},{"literal_text_all_w_t_and_m_t":"-the available set of PUSCH resources associated with each enhanced coverage level for the transmission of the CB-Msg3, [FFS cb-Msg3-EDT-PUSCH-Config].","paragraph_zero_based":254},{"literal_text_all_w_t_and_m_t":"-if the UE is an NB-IoT UE:","paragraph_zero_based":255},{"literal_text_all_w_t_and_m_t":"-the available sets of PUSCH resources on the anchor carrier, [FFS cb-Msg3-EDT-StartTimeParameters] and on the non-anchor carriers, in [FFS ul-ConfigList].","paragraph_zero_based":256},{"literal_text_all_w_t_and_m_t":"-the mapping of the PUSCH resources into enhanced coverage levels is determined according to the following:","paragraph_zero_based":257},{"literal_text_all_w_t_and_m_t":"-the number of enhanced coverage levels is equal to one plus the number of RSRP thresholds present in [FFS cb-Msg3-EDT-RSRP-ThresholdList].","paragraph_zero_based":258},{"literal_text_all_w_t_and_m_t":"-each enhanced coverage level has zero or one anchor carrier PUSCH resource present in [FFS cb-Msg3-EDT-StartTimeParameters] and zero or one PUSCH resource for each non-anchor carrier signalled in [FFS ul-ConfigList].","paragraph_zero_based":259},{"literal_text_all_w_t_and_m_t":"-enhanced coverage levels are numbered from 0 and the mapping of PUSCH resources to enhanced coverage levels are done in increasing [FFS npusch-NumRepetitionsIndex] order.","paragraph_zero_based":260},{"literal_text_all_w_t_and_m_t":"-when multiple carriers provide PUSCH resources for the same enhanced coverage level, the UE will randomly select one of them using the following selection probabilities:","paragraph_zero_based":261},{"literal_text_all_w_t_and_m_t":"-the selection probability of the anchor carrier PUSCH resource for the given enhanced coverage level, [FFS nusch-ProbabilityAnchor], is given by the corresponding entry in [FFS npusch-ProbabilityAnchorList].","paragraph_zero_based":262},{"literal_text_all_w_t_and_m_t":"-the selection probability is equal for all non-anchor carrier PUSCH resources and the probability of selecting one PUSCH resource on a given non-anchor carrier is (1- [FFS npusch-ProbabilityAnchor])/(number of non-anchor PUSCH resources).","paragraph_zero_based":263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"252e3db5c0fe6d9887e82b2df2ea8829102397c8af77f7385ddec9a6c33e6ae4","original_member_sha256":"0ffdcfe63374625f16531d69d191fb330a4f3ecc2b0886fb54c08f68a4b7f2f4","paragraph_ElementTree_utf8_XML_sha256":["cd62805545b68279f102aa7b29abf188493c4483c9ed3ad7cfdf20c25045d5d7","c53b741641b44cc5f36111bd7f5f6c08e7ee893139c02d4f2dd90309f4ef0015","e3f2e76489de4cf0bc672efa728bcd6e14e0b62d8899d08bbe3c03932663fdfc","082936edc853892b0633020dc9d7f1b43b0aa72a5cfb398e62b507c3ca1c6185","0116bb20cbd6b87a8ffda0c2956c8175abf23565067797dada140d8b457c6ee6","c3eef3cb262eb83dd878fb11f32877fed46372139e811178f40236edc06375eb","5ce697e96aa2fb87fa67cc7cd1f193f6e408d2b905bc0dcf9ffb05e604191b15","23efc8e7e8e210b8d394a2b4b50857f28ba6a349d5bad6e3e3d1fc360b67c645","22652df12c722cf838e1494153bff7ca781fe8dd00d492dda5a9112e2ff1fb8e","38bf0e06d3339909e58cb4af25075bc1a75a527196f3aba4646216154d1a6770","e8176025dc2e12ae866314521d5c071f74ee45f75d68ef82b8f2e55a917ed8eb","77dd91c4a146f52bf71ff1260e9946d821a03cdc7a83c13c5e13a1a74fc6f5d9","2572657db89d07883b7f69aa349d4d8b85dc077800cfb81ae2f263cd1175108c","20e64e50da929b02dfcb1f571983eb81694c2d8a71de2b5099ce299108267d0b","f04f62954b5c5a68bbc84a2a3a014a233ec944f7c1ff42b466a36f59286bb57d","37b268db1ed36ace813845492022a08961191345fe86560d025ce0169ea3fc60","c09c75dc562a8825a453a95a0db7c7c6d336ed6ba91d688970b082e812c33324","fdf941e366b92e0e88200d2e85e95b975d84dab94ef022a4c146e443045d145c","98ee6c882f0438854996633c92616124c65ae7d01663fc3665fe6f2276411782","0825fe706d00ab51915d8019a6e8b33b454c0df52c04620111818c1223a0b969","30e7319b4c5cbb1e0cd17fca368d85802e35eaacb3370c106040efaa5aa76a5d","519fd27c6b6ff06163bfdabc373da8c3312ecabd2f55537178b0d1aab8c2569d","cd69f36b3d8bff