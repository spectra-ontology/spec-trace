54f9bd149b93ddfaf012bcd674e18c374f6dd7ddf1cc1792dc12229297094","original_member_sha256":"56fb020b0b8197f2dc7d5bb3d81730ac42e27dd1effda03bff60ba62025e75eb","paragraph_ElementTree_utf8_XML_sha256":["eca4a4ff04b237951ade685ead3a18d23bfad4a5a02c2e3e24579966fcc22044","1134cb87ce2a928594dab2434d88ee82448c7524bb08e159864167248b30daed","2285b0ddbef8b209abf4c58756fb7ec9689c4b50f563b6f5c0ce4876a32e095a","1d89cded47246361e404cc73eccc85fee84f02e3223a9e9c9f0a5015ba7de7ae","6dfad9c81b0a05924620fa92896c259f01e1a9ee79c7228ab341d03f52bfd3cf","97b969be50bc13d2cc698503377ad31e9799f5c06bcf297a50e853cc41f8a7a2","ca0411ed6a24ea193aa8ad0138dcd7ab86e22e412568e7c9227b6b08564bf00c","7bc05e86766fe6eaa0448dcf3f4bd67b0d5271d055e12ce5699b4a65c92ccb11","f759ac7640a475b6e42b53f5a11a0cced4807ff2e8d2e01350c9e63ef7e83d86","9e2cb3aff516f9d22708df9280c53c074b2ecc32b5b4f7fb65acb43b624aa741","81c1dbb4c9d668064ae319c43a1b9ca4c1cfcbc16722b75d2267b4ca8fa88120","f61bed16c83a9ffbc4665b4e9076712a994ed3f27dfa045d803f9a6777360036","8c2f81d89857610ba9ed1d822c2fc5aaaefe1cef1cc12f562dc27df3692e079d","6abec768d060eef0a504b41c1b5f86399d891fe398f340667c28cdff93b3813c","89dea2c0628b20c8176449ad0973ba59587fd4a5dbb7c6b000fb282b4646f436","6949732dd1cd20caf4820d94f3f9348303e74582eaf0c16fac1bd1d4ace1c852","bf99286671c19d25f1fdb88be5aec5238f0ebd9e34502c9c5456f3d26fd7dc09","655c8661ab52512a977c7548d9215166414db04287ab23ce1c37ddb394d9d401","9482074128e9823c01da2c7f423e790aa6d0d0e853d8d8c23ee4c34a4004ed7d","5d1b96064b7a5d87159ae5ba28bb768c745aaad27598037a3fd49fec01856c8b","8cd6a8c548e00a73b2977d53b09aeb7f7cb18b86ce3bf90a03e0d996948da5bf","f57663ccb2387dd6a7eeda0c692d5158aae17b5adb0b14b64d7dec915177fd82","1ae46176932eecf9c571f380f27f3faa02517077078ca8db7bc63ef4d81714a2","0aeb435b618b9472007330cf62780663a7b01d5f80dbd0db9860664e575afb98"],"paragraph_range_zero_based":[24,47],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2503193.zip::R2-2503193 UE capability_final.docx:p24"}
{"fields":{"filename":"R2-2503193.zip::R2-2503193 UE capability_final.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"B","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Rel-19","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-16(Release 16)Rel-17(Release 17)Rel-18(Release 18)Rel-19(Release 19)Rel-20(Release 20)","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":"Reason for change:","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"For positioning SIB, the assistance data for some of the SIBs require periodic update and periodic delivery of the posSIB is thus required. For instance, RTK message is typically updated periodically (a typical update periodicity is 640ms) and the update needs to be delivered to the UE in a timely manner. ","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"During R16 discussion, we have agreed to introduce on-demand SIB request in RRC_CONNECTED. When a certain SIB/posSIB that the UE needs is not currently broadcasted, the UE may send a UL dedicated RRC message to the gNB to request this needed SIB/posSIB. Then, based on the request, the gNB may send the SIB/posSIB either by dedicated signaling or by system information.","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"The issue is that, based on the current mechanism, the network does not know how many time the SIB should be delivered to the UE. Take posSIB for RTK for example:","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"If the network delivers multiple RTK posSIB per UE request, the network does not know when it should stop","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"If the network delivers only one RTK posSIB per UE request, the UE might repeatedly send the request to the network, which results in much signalling overhead.","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"This hence motivates us to allow for UE to indicate the amount of periodic deliveries that it needs when requesting the posSIB.","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"Note that for the support of RTK in LPP, LPP control parameters are defined for periodic assistance delivery with periodicity and requested amount.","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"56654f9bd149b93ddfaf012bcd674e18c374f6dd7ddf1cc1792dc12229297094","original_member_sha256":"56fb020b0b8197f2dc7d5bb3d81730ac42e27dd1effda03bff60ba62025e75eb","paragraph_ElementTree_utf8_XML_sha256":["50e4213c8f36b8642fa32dce30ed7c921854066f108cb9ac0208d3e3512b8ff1","55bf3829668d5692cedda31c90506ca5f3233751e72f3af1ade4f354892d8efd","d9e637484edfea0191456d94588519bb7c930ffdeb4e0a8b0b1e6e8f6264be4c","9633b6b13cca348843f2d56414896b646e3934da73cf58fc72842d84e850fe6e","4426921fe3c130ad8b9e0f8f4fd47231839752a57876fa450485996022462e75","6c2cf0ee3930ae102559258db0e194c439824079a42639188533e32b06cd033b","b402c4457367b1a68d7c9eb4d05248fbfc25d35d99fe5c8b22c41dd51ebbdb3d","2816d8e8d98a3929a4ef3ad33efd210539a1a5e18d1fdb7c664e9fecf9c3e718","3f0d24ad258d0fcf16d170946efc6963c81db245710caaa18bc58edc9cae23bd","f2f8e852e49f8b264d4b5913a0989f7da6fa492e702aaf3145d72b1009e813df","f5c8181c0cee0c7dd733f46a279f4b4118e4a6011cfeb967206da978587e7af1","5efb8faaca21118e2f4a5be94974f42026732103b0a04c0de5c9a19ef440df5d","dbe85e4fd16ea458451a9ac73cfb1b3d2cf08aa2a31b18610daebf4b79138def","aab2428f2bd40e70970c0e120c31aa60b92dd14005818bd68dfc19dbf79570d2","7e77b84778855b86c52d464f63dbb9c53933ca8779b96c94c3dac489f59f58b4","e0eadd9a7b800a31f2b438ca326712d66b029c4b6c779abfe4e2eff2510d9bcc","6424eed5f005c0b7e49dbf410faecb7b5fd26b9e1f3b4e1be29b8ae50ffbcae9","490121ce8e411c5bb43e05b7b63bf56c93b5520ceaaeeaf1de531046c26b2f54","80b0f9dcfeb9f67aa5f3b488d9707e7d2e153d03effdbad235d6fc2d9346fa32","7f88c6a5149fdcda4d2c8e64431147df7b08dd54590d030e52313ca5d563e695","e81464f2c13f33c0675cda3b18919df9dd24f30e032e1640f5921d2dd296e6db","f8f7e6ed7d83a6525c60218c5ea849e0e7310b37255e91e2122978b0d496a192","0b81631faacc4bff4b945e33b44fb8f67b3159cc41be706ff85faa066fd3440e","44fbe53e7a6b0ab999bbfe42c75e771f386a8d3406103da3ee32d799704691e5"],"paragraph_range_zero_based":[48,71],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2503193.zip::R2-2503193 UE capability_final.docx:p48"}
{"fields":{"filename":"R2-2503193.zip::R2-2503193 UE capability_final.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"We can follow what has been defined in LPP for the delivery amount and the posSIB can be delivered to the UE periodically whenever the gNB receives an updated posSIB from the LMF.","paragraph_zero_based":72},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":73},{"literal_text_all_w_t_and_m_t":"========== UPDATE after RAN2#129===========","paragraph_zero_based":74},{"literal_text_all_w_t_and_m_t":"After the discussion during RAN2#129, the following agreement has been achieved","paragraph_zero_based":75},{"literal_text_all_w_t_and_m_t":"Agreements:","paragraph_zero_based":76},{"literal_text_all_w_t_and_m_t":"Introduce control parameters, including delivery amount and start/stop, for posSIBs with periodic delivery requirements for SI request in RRC_CONNECTED.","paragraph_zero_based":77},{"literal_text_all_w_t_and_m_t":"Control signalling in reconfiguration to be encoded as ENUMERATED { enabled } OPTIONAL Need R.","paragraph_zero_based":78},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":79},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":80},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":81},{"literal_text_all_w_t_and_m_t":"Add explanation for the UE capability introduced in RRC spec","paragraph_zero_based":82},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":83},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":84},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":85},{"literal_text_all_w_t_and_m_t":"The introduced UE capability is not clear in its usage.","paragraph_zero_based":86},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":87},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":88},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":89},{"literal_text_all_w_t_and_m_t":"4.2.2","paragraph_zero_based":90},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":91},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":92},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":93},{"literal_text_all_w_t_and_m_t":"Y","paragraph_zero_based":94},{"literal_text_all_w_t_and_m_t":"N","paragraph_zero_based":95}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"56654f9bd149b93ddfaf012bcd674e18c374f6dd7ddf1cc1792dc12229297094","original_member_sha256":"56fb020b0b8197f2dc7d5bb3d81730ac42e27dd1effda03bff60ba62025e75eb","paragraph_ElementTree_utf8_XML_sha256":["95342d0a4f486fc768d643804b5c48ccad51783b94467847a496452d12f0703d","b5eba82db4864b43187724b4d4fe2ffaac1c951af6ecaa7708c68f7c5d76c4a4","2f2f60e270c439e59b25ac4ed372b9f0def9f910335aa41966a65d1a88011594","9b71214f780520fd548c1d5956aa3cef07d6930cf81ba3b52b9b6e6a0ac2474e","424dd0b8a3ff3cfc4e3340b3c816cd4efc1fe727e1377ff9ed33c077bc45c8ba","d723ea8616499195073a612a3002b45323470990e5ee6f8f6acfcc2b9b20c76a","3418c060587b03d2c75099b7916e146ae84507572332da897b754fb304b82c5d","f3a2dbd57307a0bd8cf9e36bb0f2e290631105a5c0ba77ea3a2b5f32dd6e9561","5f8c038b8f32e0cd146ff0fc3dea5cbc44fa169eacd0f11e71931a47a206daa9","104c7585efcbe7048a31270578b4bd68ae433a7548bfeda116a0aea927f730cd","b97e984cd704e615ade4a2123acbe8e917f82936662bbbac1a16431dcb1116f9","4a87bcb45fdd1e867173ae213575d00edeb2170522f42e59a004050da205079f","41caeae449455bcbf7e5588482d3a2df19c668bb305d96a8f1280514758b4cef","fd7129d1bf7836a8320a0796f9d40496a40756ec5132e04a13926c714885cfb1","7989871446aa7bf226289302f2c6203fc73fb90ca6e736cf91fc474e0cc37606","4695106b0be6cb7a6a9a6bbe39ffcd066c28538ab8f31922ab711f39588aeb42","7b54f6d068e79acb06efaa9c043a9b281751bf16c99fa890c0c86e6f4b6bf64a","2f905a1e6e1bf91b042b3e6ca0ae98f700930fbb559b5c77288173b2357f1267","6705a6865b0ef0e1735cd8523a250bd19960d611f