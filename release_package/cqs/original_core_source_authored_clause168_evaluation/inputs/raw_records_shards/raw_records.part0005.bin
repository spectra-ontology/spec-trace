{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"memoryStatus","paragraph_zero_based":2808},{"literal_text_all_w_t_and_m_t":"Indicates the status of the memory reserved for the logging of radio measurements for network-side data collection.","paragraph_zero_based":2809},{"literal_text_all_w_t_and_m_t":"centerFreq","paragraph_zero_based":2810},{"literal_text_all_w_t_and_m_t":"Indicates the center frequency of the carrier frequency range which is affected by the IDC problem.","paragraph_zero_based":2811},{"literal_text_all_w_t_and_m_t":"cycleLength","paragraph_zero_based":2812},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred cycle length to resolve the IDC problem. Value in ms. Value ms2 corresponds to 2 ms, value ms3 corresponds to 3 ms, and so on.","paragraph_zero_based":2813},{"literal_text_all_w_t_and_m_t":"dataCollectionCandidateIdList","paragraph_zero_based":2814},{"literal_text_all_w_t_and_m_t":"Indicates one or more IDs of candidate configurations preferred by the UE for UE-side data collection.","paragraph_zero_based":2815},{"literal_text_all_w_t_and_m_t":"dataCollectionIdList","paragraph_zero_based":2816},{"literal_text_all_w_t_and_m_t":"Indicates one or more IDs of UE-side data collection configurations that the UE prefers to stop.","paragraph_zero_based":2817},{"literal_text_all_w_t_and_m_t":"dataCollectionPreferredConfigurationList","paragraph_zero_based":2818},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred radio resource configurations for UE-side data collection.","paragraph_zero_based":2819},{"literal_text_all_w_t_and_m_t":"dataCollectionServCellIndex","paragraph_zero_based":2820},{"literal_text_all_w_t_and_m_t":"Index of the serving cell that the dataCollectionCandidateIdList refers to.","paragraph_zero_based":2821},{"literal_text_all_w_t_and_m_t":"dataCollectionStart","paragraph_zero_based":2822},{"literal_text_all_w_t_and_m_t":"It indicates the UE's preference to be configured with radio resources for UE-side data collection.","paragraph_zero_based":2823},{"literal_text_all_w_t_and_m_t":"dataCollectionStopConfigurationList","paragraph_zero_based":2824},{"literal_text_all_w_t_and_m_t":"Indicates the radio resource configurations for UE-side data collection that the UE prefers to stop.","paragraph_zero_based":2825},{"literal_text_all_w_t_and_m_t":"dataCollectionStopServCellIndex","paragraph_zero_based":2826},{"literal_text_all_w_t_and_m_t":"Index of the serving cell that the dataCollectionIdList refers to.","paragraph_zero_based":2827},{"literal_text_all_w_t_and_m_t":"delayBudgetReport","paragraph_zero_based":2828},{"literal_text_all_w_t_and_m_t":"Indicates the UE-preferred adjustment to connected mode DRX.","paragraph_zero_based":2829},{"literal_text_all_w_t_and_m_t":"interferenceDirection","paragraph_zero_based":2830},{"literal_text_all_w_t_and_m_t":"Indicates the direction of IDC interference. Value nr indicates that only NR is victim of IDC interference, value other indicates that only another radio is victim of IDC interference and value both indicates that both NR and another radio are victims of IDC interference. The other radio refers to either the ISM radio or GNSS (see TR 36.816 [44]).","paragraph_zero_based":2831}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["45c7f83065e3c3001ce6dadc82fa1eccc305140d091d6792474c0f39bb9a0e3d","781236d485cb15e3b77779ab893b45da365d121a3ec09ba3e0623c132c979f65","1c850fb854bcc0ce7e67c49303feecc71d05eea57ffe51e4476b61054fe4b3ac","a12e9a37a44b4dc84f1600798ef24749ec5cf99c87429b35ce926e683cdb736d","e73f5353cb7d072b986d8258e687fd1e890f498f321af2cd455fffc928537fdd","c74d6dc0034671eceb4b5ef0e742416fb08f334b54bef7bb7bca6ba76ab03454","51a11610925aa2bbf00ca81f191cde475aafd49271276d26e606e2a87906a28b","26adb2a7fe15096684a39b5548fcb294b33992397cfe19c8ef66abd04512ea88","aeb70d73388c7495f1eb1b97c2e1b4e4e1fd53de31853abd62475178212112fc","0dc7312996e5f7c5995918b6bf5eec3b3133a73e6f6040c6c63c66ce7c37c429","332266861059a9d81248eab2c54e1fd658b3ca85f516d6c0a7ef91c7dd45b7e6","10924eef7290bf2c07117c4b4e1d432e129ee748846183e30e3371b4e55ee352","3ebc44dade3641525a3cefc0efb423787cc0fd03fe2a0292e5b0556911863b06","b093ea1cc0d97671237b3d418482683d8c20b3288f394edc180f3774ab4eae0f","ee6cff325dfc338556792f38784f9e66a15fe810b8a7cc270f00e775cceed180","c7265b6ef9401db2ec0e92ba717d0625fa2a9378fc792519f9271018316d9993","56b51ee06a06c0142f2214976f002f551df10973131a44100430033da4fab180","9620dc9debe643fe9c160d2c3d8b36eb4228851e78e6471f05d4e458f9bb5a06","b69636b885ad781283798890d1468e6c9afbcda1b9df3b8029829373d29b8cfa","09375c0cdc7a1a7c0a2f47a5a5fcaf7e37f9c5138ec9a907d0061c1ce57caa31","f123e43eba1676e90c27bab419b690680a2333ca28880b8b895ab7749fdaf80f","38e67d8595ed1d7229a40b8ca21e49b8dbc2f0bcad716c000b75c7e0d3e47f41","fc2c02a54079081005ceb16c8c9c078cf2b284e9945d4026779dca9b452d9d35","10af124c20c46194d9db8529c05d0877d5335656fd437cef37ab21271d18cc22"],"paragraph_range_zero_based":[2808,2831],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p2808"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"loggedDataCollectionAssistance","paragraph_zero_based":2832},{"literal_text_all_w_t_and_m_t":"Indicates assistance information related to the logging of measurements for network-side data collection performed in accordance with CSI-LoggedMeasurementConfig.","paragraph_zero_based":2833},{"literal_text_all_w_t_and_m_t":"lowPowerState","paragraph_zero_based":2834},{"literal_text_all_w_t_and_m_t":"It is set to true if the UE has entered a low power state.","paragraph_zero_based":2835},{"literal_text_all_w_t_and_m_t":"lpwus-OffsetPreference","paragraph_zero_based":2836},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred time offset for PDCCH monitoring after LP-WUS monitoring. Value in ms (milliSecond). ms5 corresponds to 5 ms, ms13 corresponds to 13 ms, and ms37 corresponds to 37 ms. The reported preferred time offset value is equal to or longer than the minimum time gap reported by UE capability for a UE. If the field is absent, it is interpreted as the UE having no preference for the time offset for LP-WUS monitoring.","paragraph_zero_based":2837},{"literal_text_all_w_t_and_m_t":"minSchedulingOffsetPreference","paragraph_zero_based":2838},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferences on minimumSchedulingOffset of cross-slot scheduling for power saving.","paragraph_zero_based":2839},{"literal_text_all_w_t_and_m_t":"minSchedulingOffsetPreferenceExt","paragraph_zero_based":2840},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferences on minimumSchedulingOffset of cross-slot scheduling for power saving for SCS 480 kHz and/or 960 kHz.","paragraph_zero_based":2841},{"literal_text_all_w_t_and_m_t":"multiRx-PreferenceFR2","paragraph_zero_based":2842},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on single FR2 Rx operation to address overheating or power saving. This field is allowed to be reported only when UE is configured with serving cells operating on FR2.","paragraph_zero_based":2843},{"literal_text_all_w_t_and_m_t":"musim-AffectedBandsList","paragraph_zero_based":2844},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on the band(s) and/or combination(s) of bands with restricted capability for MUSIM operation. If the MUSIM-CapabilityRestrictedBandParameters-r18 with same musim-bandEntryIndex appears more than once in the list of bands in a MUSIM-AffectedBands entry, the UE supports intra-band non-contiguous CA with restricted capability for MUSIM operation for this band. UE explicitly indicates each band and each combination of bands that are affected. The Network should respect these capability restrictions when configuring the UE with bands or band combinations that contain these bands and/or combination of bands. Fields musim-MIMO-Layers-DL/UL and musim-SupportedBandwidth-DL/UL indicate the max number of MIMO layers and max bandwidth on each CC of the band, respectively. The band(s) and/or combination(s) of bands are supported in UE capability, and the musim-MIMO-Layers-DL/UL and musim-SupportedBandwidth-DL/UL range up to the concerned maximum capability of band(s) and/or combination(s) of bands in UE capability. For each concerned band or band combination, the lowest value of each musim-MIMO-Layers-DL/UL/musim-SupportedBandwidth-DL/UL and the corresponding capabilities in the UE capability determines the supported maximum MIMO layers and maximum bandwidth for DL/UL, respectively.","paragraph_zero_based":2845},{"literal_text_all_w_t_and_m_t":"musim-AvoidedBandsList","paragraph_zero_based":2846},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on band(s) and/or combination(s) of bands to be avoided for MUSIM purpose. UE explicitly indicates each band and each combination of bands to be avoided. The list may include the band of the PCell. The Network should respect these capability restrictions for the band combinations that contain these bands and/or combination of bands. The band(s) and/or combination(s) of bands is a subset of the band combination(s) in UE capability.","paragraph_zero_based":2847},{"literal_text_all_w_t_and_m_t":"musim-bandEntryIndex","paragraph_zero_based":2848},{"literal_text_all_w_t_and_m_t":"Indicates an NR band by referring to the position of a band entry in musim-CandidateBandList IE. Value 1 identifies the first band in the musim-CandidateBandList IE, value 2 identifies the second band in the musim-CandidateBandList IE, and so on.","paragraph_zero_based":2849},{"literal_text_all_w_t_and_m_t":"musim-CapabilityRestricted","paragraph_zero_based":2850},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on the temporary capability restriction on the band for MUSIM operation.","paragraph_zero_based":2851},{"literal_text_all_w_t_and_m_t":"musim-CapRestriction","paragraph_zero_based":2852},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on SCell(s) or PSCell to be released, serving cell(s) with restricted capability, band(s) or combination(s) of bands with restricted capability, or band(s) or band combination(s) to be avoided for UE temporary capabilities restriction.","paragraph_zero_based":2853},{"literal_text_all_w_t_and_m_t":"musim-Cell-SCG-ToRelease","paragraph_zero_based":2854},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on any serving cell(s), except for Pcell, and/or SCG to be released for MUSIM operation.","paragraph_zero_based":2855}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["237b92e886eaf445de80e263fda094d5e7326f0e0cdd93bbea358182499cecfe","68f1d4b1878609fd5b2dbe6ba7cfed88fb5168e68ccd8a1b1159f9836af31c73","e804af76fc82a1fb83c6e5beaf623a2c70479b65f1b1dc07c3b005591d5793bd","f884f9288b66e53520c5f8c31d9454cd1af0049dcdd588b5d2764126eb351524","56d93e796d271e25129a2ff8c0109588122a7b9e07792b5d6346128d73bed064","47697d7982991e449df5a8c289d414f6aa6aefa37f2b81253c618d1bc43b1a12","a26838b61d03ef187509f046c9dd60c1989d31e49475b203b54d9a08267d99a0","2cf77d9b9db280747c72fbd11032f2cc4896ed0fb68f2d21fe5c7a1ed9ec90e0","c361a63533e16e387c779d37d733d5e3bf66583ec93b01b2fecf8629016f727d","803c06c7e4560e001e4014c2c2dd5d86a1622d4df36c72c3715c67e162580894","0dc8b16cbcfc6f5eab36a0260ea5f759d2a9bf6580ef11db406d004c1fc1763f","f48760b029892378e8f523dd8f001ba6bcb5f84a15607320445ff744858219f4","7ea33f7b4d88e72cdb16e80092d917164d33263b199ff45556ba693339db29a6","0042f59e2dd5fd6d6904d1b1a770971dad42f13b639dd2cd95d537da363fa105","480dc148e40c8f14c3eaa3153756e0f8141ea29351e17d94bd21bf0d1f7c3d6e","06b4f478a841e2867ca49ced9e18bf51e36184867375afc9309ff942df194c4d","b80458b9050eb0776231233152da1c9a6422f1cb8693fd7dcc74115519f6206b","3405ba90939786b1116d49a60826f6916388f909a4059db7e69c17b4ea3bbb60","daa99f5d124454bded8ac432e3006456987e9c351710441afaa5dbc19bc1da3d","3286491b1b3135affd21e2432135c4d2c3bbd411ef0deb226dace491ae22e72c","2556afa25d9bd5da77d33c22169eaa1ca3b74f4dd47a7b766f54cdc5f1003388","1a321bc0c01be0829a1698dac744cbbb5a77c5932ba8285788fa329fdd3f2f80","4fac881debdd291c82b4a21fe191e5928ce17f2b9bc56d093352b6968941ea10","74828316727b51c82864851651185be6e4d25335c1819a19bfdf7a28dacc5832"],"paragraph_range_zero_based":[2832,2855],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p2832"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"musim-CellToAffectList","paragraph_zero_based":2856},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on the temporary capability restriction on the serving cell(s) for MUSIM operation.","paragraph_zero_based":2857},{"literal_text_all_w_t_and_m_t":"musim-CellToRelease","paragraph_zero_based":2858},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on the temporary capability restriction on the serving cell(s) to release, except PCell, for MUSIM operation.","paragraph_zero_based":2859},{"literal_text_all_w_t_and_m_t":"musim-GapKeepPreference","paragraph_zero_based":2860},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference to keep all colliding gaps for requested MUSIM gap(s). If the field is absent, the colliding MUSIM gaps with lower priority shall be dropped as specified in TS 38.133 [14].","paragraph_zero_based":2861},{"literal_text_all_w_t_and_m_t":"musim-GapPreferenceList","paragraph_zero_based":2862},{"literal_text_all_w_t_and_m_t":"Indicates the UE's MUSIM gap preference and related MUSIM gap configuration, as defined in TS 38.133 [14] clause 9.1.10.","paragraph_zero_based":2863},{"literal_text_all_w_t_and_m_t":"musim-GapPriorityPreferenceList","paragraph_zero_based":2864},{"literal_text_all_w_t_and_m_t":"Indicates the UE's MUSIM gap priority preference for periodic MUSIM gaps as specified in TS 38.133[14].","paragraph_zero_based":2865},{"literal_text_all_w_t_and_m_t":"If the UE includes musim-GapPriorityPreferenceList-r18, it includes the same number of entries, and listed in the same order for periodic gaps, as in musim-GapPreferenceList-r17.","paragraph_zero_based":2866},{"literal_text_all_w_t_and_m_t":"musim-MaxCC","paragraph_zero_based":2867},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on the temporary capability restriction on maximum number of CCs per DL/UL in total, and per FR1/FR2-1/F2-2.","paragraph_zero_based":2868},{"literal_text_all_w_t_and_m_t":"musim-NeedForGapsInfoNR","paragraph_zero_based":2869},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the measurement gap requirement information of the UE for NR target bands when in MUSIM operation while NR-DC or NE-DC is not configured. ","paragraph_zero_based":2870},{"literal_text_all_w_t_and_m_t":"musim-PreferredRRC-State","paragraph_zero_based":2871},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred RRC state when leaving RRC_CONNECTED.","paragraph_zero_based":2872},{"literal_text_all_w_t_and_m_t":"n3c-RelayUE-InfoList","paragraph_zero_based":2873},{"literal_text_all_w_t_and_m_t":"Information of available N3C relay UE(s).","paragraph_zero_based":2874},{"literal_text_all_w_t_and_m_t":"nonSDT-DataIndication","paragraph_zero_based":2875},{"literal_text_all_w_t_and_m_t":"Informs the network about the arrival of data and/or signaling mapped to radio bearers not configured for SDT while SDT procedure is ongoing.","paragraph_zero_based":2876},{"literal_text_all_w_t_and_m_t":"preferredDRX-InactivityTimer","paragraph_zero_based":2877},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred DRX inactivity timer length for power saving. Value in ms (milliSecond). ms0 corresponds to 0, ms1 corresponds to 1 ms, ms2 corresponds to 2 ms, and so on. If the field is absent from the DRX-Preference IE, it is interpreted as the UE having no preference for the DRX inactivity timer. If secondary DRX group is configured, the preferredDRX-InactivityTimer only applies to the default DRX group.","paragraph_zero_based":2878},{"literal_text_all_w_t_and_m_t":"preferredDRX-LongCycle","paragraph_zero_based":2879}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["26e94515f81867eabaeb21e68dedfe3c1a71a08f6dad5e508b3a2358fc54901a","5861590d0eab92eed42af64a0fac32b363afc9e560961594cd3aaa46e04f8429","288ff0c9105d5b30d6d2d03b54047f1975fa2408d21d3bdf826719300cb3f0a0","9af4c601c148d0e6eb5b992b3caeef9948c139e21817097452259d6b7399daad","5531cfeaf1531c234e17344f0990f01dd24712ed2f11dc4fd16a7b03309dd00d","ff5b8a4877fe0119289f27a107e8817c4a49cbce2c9c74d4543772668afd9ccd","4ffd4e61adff9ee1909ad0e76b0dc1f3802969d0e9dae5e5bb6d8ddc1a857637","1081916fbe8a3886f606d13843ed4361456fc32609e7eaee67471230478bc698","c7b39feed885fc2ebbdaee333dcd840f382710d02530d51cad88358a5ee1305d","1795655a7eed0455ff637bdb94902c671c8303b99253ff3cbdb99bd66671555b","708b12acd23ad021c0f27967303037450c33086ef6e2c9598a32f8a92b9283c7","c2bcf24131dd8ffc35246da73517c9837c4b465256c70047e1286d97c5799982","8dc950c1eb46918a048f344e1332a50d8b064d94bab9a1e33165e448aa69bf7f","ec27118abd412c52d6d2a3bfd699362965f16623ab12def31260ea3cb7cac690","0d4096582e7c17a3f751e0eecd69d2ec77eb66879fd726bf4f992fac6b0be5b5","07f7477927bc30bea4605b54e513d2dacf8ce346f8e9e1bf57ef8bf63b5f975a","af91119407c4df1c5df3339c4a5a2b5f325ca207c787bfa2e88539219ce91366","102f888ae58eec9a346e47c8be47d0effa0c28db549b701ebd310757330cb9b6","d9b672d014aa71c61862b6f47605d02c47b9c3db5f4362a25e9403d085e7c3d0","ea3654e3fe29a6b9914c56b1ef7af6dc1fa373779529401c4a051ca45ecdba3f","ee234c469deba48278dbfc0abd855c3b4a6f4e9bae298543bdd2c9cfda4512fc","b27e6bc305c3af46de274b3d282ed91a323159a7704ef7469060208bfa3930c2","c85ffc4fba2dc01ccb6b1a303a54a171945fe6b40fc4f5b975e2d6131d053d08","d219925d66459da02e990e82a6384ee3cedd268a7359a409dc7e36aea7ea7cc1"],"paragraph_range_zero_based":[2856,2879],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p2856"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred long DRX cycle length for power saving. Value in ms. ms10 corresponds to 10ms, ms20 corresponds to 20 ms, ms32 corresponds to 32 ms, and so on. If preferredDRX-ShortCycle is provided, the value of preferredDRX-LongCycle shall be a multiple of the preferredDRX-ShortCycle value. If the field is absent from the DRX-Preference IE, it is interpreted as the UE having no preference for the long DRX cycle. This field may also indicate UE’s preference for cellDTX-DRX-Cycle.","paragraph_zero_based":2880},{"literal_text_all_w_t_and_m_t":"preferredDRX-ShortCycle","paragraph_zero_based":2881},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred short DRX cycle length for power saving. Value in ms. ms2 corresponds to 2ms, ms3 corresponds to 3 ms, ms4 corresponds to 4 ms, and so on. If the field is absent from the DRX-Preference IE, it is interpreted as the UE having no preference for the short DRX cycle.","paragraph_zero_based":2882},{"literal_text_all_w_t_and_m_t":"preferredDRX-ShortCycleTimer","paragraph_zero_based":2883},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred short DRX cycle timer for power saving. Value in multiples of preferredDRX-ShortCycle. A value of 1 corresponds to preferredDRX-ShortCycle, a value of 2 corresponds to 2 * preferredDRX-ShortCycle and so on. If the field is absent from the DRX-Preference IE, it is interpreted as the UE having no preference for the short DRX cycle timer. A preference for the short DRX cycle is indicated when a preference for the short DRX cycle timer is indicated.","paragraph_zero_based":2884},{"literal_text_all_w_t_and_m_t":"preferredK0","paragraph_zero_based":2885},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred value of k0 (slot offset between DCI and its scheduled PDSCH - see TS 38.214 [19], clause 5.1.2.1) for cross-slot scheduling for power saving. Value is defined for each subcarrier spacing (numerology) in units of slots. sl1 corresponds to 1 slot, sl2 corresponds to 2 slots, sl4 corresponds to 4 slots, and so on. If a value for a subcarrier spacing is absent, it is interpreted as the UE having no preference on k0 for cross-slot scheduling for that subcarrier spacing. If the field is absent from the MinSchedulingOffsetPreference IE, it is interpreted as the UE having no preference on k0 for cross-slot scheduling.","paragraph_zero_based":2886},{"literal_text_all_w_t_and_m_t":"preferredK2","paragraph_zero_based":2887},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred value of k2 (slot offset between DCI and its scheduled PUSCH - see TS 38.214 [19], clause 6.1.2.1) for cross-slot scheduling for power saving. Value is defined for each subcarrier spacing (numerology) in units of slots. sl1 corresponds to 1 slot, sl2 corresponds to 2 slots, sl4 corresponds to 4 slots, and so on. If a value for a subcarrier spacing is absent, it is interpreted as the UE having no preference on k2 for cross-slot scheduling for that subcarrier spacing. If the field is absent from the MinSchedulingOffsetPreference IE, it is interpreted as the UE having no preference on k2 for cross-slot scheduling.","paragraph_zero_based":2888},{"literal_text_all_w_t_and_m_t":"preferredRRC-State","paragraph_zero_based":2889},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred RRC state. The value idle is indicated if the UE prefers to be released from RRC_CONNECTED and transition to RRC_IDLE. The value inactive is indicated if the UE prefers to be released from RRC_CONNECTED and transition to RRC_INACTIVE. The value connected is indicated if the UE prefers to revert an earlier indication to leave RRC_CONNECTED state. The value outOfConnected is indicated if the UE prefers to be released from RRC_CONNECTED and has no preferred RRC state to transition to. The value connected can only be indicated if the UE is configured with connectedReporting.","paragraph_zero_based":2890},{"literal_text_all_w_t_and_m_t":"propagationDelayDifference","paragraph_zero_based":2891},{"literal_text_all_w_t_and_m_t":"Indicates the one-way service link propagation delay difference between serving cell and each neighbour cell included in neighCellInfoList, defined as neighbour cell's service link propagation delay minus serving cell's service link propagation delay, in number of ms. First entry in propagationDelayDifference corresponds to first entry in neighCellInfoList, second entry in propagationDelayDifference corresponds to second entry in neighCellInfoList, and so on.","paragraph_zero_based":2892},{"literal_text_all_w_t_and_m_t":"reducedCCsDL","paragraph_zero_based":2893},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum number of downlink SCells indicated by the field, to address overheating or power saving.","paragraph_zero_based":2894},{"literal_text_all_w_t_and_m_t":"When indicated to address overheating, this maximum number includes SCells of the NR MCG, PSCell and SCells of the SCG. This maximum number only includes PSCell and SCells of the SCG in (NG)EN-DC.","paragraph_zero_based":2895},{"literal_text_all_w_t_and_m_t":"When indicated to address power saving, this maximum number includes PSCell and SCells of the cell group that this UE assistance information is associated with. The maximum number of downlink SCells can only range up to the current active configuration when indicated to address power savings.","paragraph_zero_based":2896},{"literal_text_all_w_t_and_m_t":"reducedCCsUL","paragraph_zero_based":2897},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum number of uplink SCells indicated by the field, to address overheating or power saving.","paragraph_zero_based":2898},{"literal_text_all_w_t_and_m_t":"When indicated to address overheating, this maximum number includes SCells of the NR MCG, PSCell and SCells of the SCG. This maximum number only includes PSCell and SCells of the SCG in (NG)EN-DC.","paragraph_zero_based":2899},{"literal_text_all_w_t_and_m_t":"When indicated to address power saving, this maximum number includes PSCell and SCells of the cell group that this UE assistance information is associated with. The maximum number of uplink SCells can only range up to the current active configuration when indicated to address power savings.","paragraph_zero_based":2900},{"literal_text_all_w_t_and_m_t":"reducedMaxBW-FR1","paragraph_zero_based":2901},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum aggregated bandwidth across all downlink carrier(s) and across all uplink carrier(s) of FR1, to address overheating or power saving. This field is allowed to be reported only when UE is configured with serving cell(s) operating on FR1. The aggregated bandwidth across all downlink carrier(s) of FR1 is the sum of bandwidth of active downlink BWP(s) across all activated downlink carrier(s) of FR1. The aggregated bandwidth across all uplink carrier(s) of FR1 is the sum of bandwidth of active uplink BWP(s) across all activated uplink carrier(s) of FR1. If the field is absent from the MaxBW-Preference IE or the OverheatingAssistance IE, it is interpreted as the UE having no preference on the maximum aggregated bandwidth of FR1.","paragraph_zero_based":2902},{"literal_text_all_w_t_and_m_t":"When indicated to address overheating, this maximum aggregated bandwidth includes carrier(s) of FR1 of both the NR MCG and the SCG. This maximum aggregated bandwidth only includes carriers of FR1 of the SCG in (NG)EN-DC. Value mhz0 is not used when indicated to address overheating.","paragraph_zero_based":2903}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["c40de6af9c172aeb231cdf9936f06f59b1b32a506380f41099d84065d7b4e452","b6f5d79a63e1722a97730efc4cd8a42584e419cdc92fc8ec8451d1f750540303","1bf8b25ee9d9946fd93b0e228c288c602a7dc454e7126a70cfe62d26093eda97","3d16655b6fab68601eb3aebb394be08c142e894e018fff47c89e1d5453069c8c","580e699f726a2e7b52db67851c1acdfb878ffc697365de508b471bcb74fcc44f","ccd4a6ab3989384054d76a5dcffa70ea0dcd6b14f517a8ce897957c1abd6e013","fc3ddddada03790de4fffcfb49daf80d035c65c7d2878851d52ad76edb203d8b","9bc3a7cc5fc200c52360ad8a249fc7e82a7f0f2fb204bd85a3261527211128ea","6bd7c5efb805a13401d20542aef650909195ea68df72797b7b370d5acb8bad68","d58472d26993d62957e78ffa4ce7f0392f735572ceed220f405c63ead58f542f","6da414c76a20089923ea42be9f882964719f4b76d0ad974c057d5db5bfe3476a","7818816ef594bed8e51b90783a70ebccb852f631f2d90b184bde9c4aa593bb5a","06348540e15156aaa3cc4f3fea8bb4dacc7211bc341184ff8a4fc6aaa73163b4","20fbfd1be0ab820ccce7ecc359733b372b768696e943c471afd6d9c9a6efa5f2","101980597b0b28422cc140c490b4656ce5f47328c96ebaa73970b7c4dec28e64","96bf66c982a8e5290ee9bc96331aa426428c55805818fbba5ecc65bfa6800176","1b198ce0b7c10ee329e78d883d5c0957cc8a459b51958e9183577dc8863b7fe4","f0ac54828520dfa7fc50f0e1627654d81ab91345eee9fb034bec62da459e0c6f","3350d1b2d4b7ba6ae00630ba745ebd2ae295ec6dfd49c15864d9d52b4dd09b9f","e1969c2e4a1309a7e6b9fb77006d2659b377a490d4f4e3a22f2c25998800b24b","cda7341adb7ad7777b961d526f2d545af7b6c514345756cbd4bd8a72f9a62ea8","7b6f7b80ca095b59ffed372537f019bf85b06dcd3cf8432442994150858e378c","b9f163a2e9d5215c336d8ee84fc0473088096bdda35ba38245ebffcfe98e7154","00a5c52b0f17ea9c25bdd927bdad0640c0febca1999c5cd1e2f9f5c652aadcb1"],"paragraph_range_zero_based":[2880,2903],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p2880"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"When indicated to address power saving, this maximum aggregated bandwidth includes carrier(s) of FR1 of the cell group that this UE assistance information is associated with. The aggregated bandwidth can only range up to the current active configuration when indicated to address power savings.","paragraph_zero_based":2904},{"literal_text_all_w_t_and_m_t":"reducedMaxBW-FR2","paragraph_zero_based":2905},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum aggregated bandwidth across all downlink carrier(s) and across all uplink carrier(s) of FR2-1, to address overheating or power saving. This field is allowed to be reported only when UE is configured with serving cell(s) operating on FR2-1. The aggregated bandwidth across all downlink carrier(s) of FR2-1 is the sum of bandwidth of active downlink BWP(s) across all activated downlink carrier(s) of FR2-1. The aggregated bandwidth across all uplink carrier(s) of FR2-1 is the sum of bandwidth of active uplink BWP(s) across all activated uplink carrier(s) of FR2-1. If the field is absent from the MaxBW-Preference IE or the OverheatingAssistance IE, it is interpreted as the UE having no preference on the maximum aggregated bandwidth of FR2-1.","paragraph_zero_based":2906},{"literal_text_all_w_t_and_m_t":"When indicated to address overheating, this maximum aggregated bandwidth includes carrier(s) of FR2-1 of both the NR MCG and the NR SCG. This maximum aggregated bandwidth only includes carriers of FR2-1 of the SCG in (NG)EN-DC.","paragraph_zero_based":2907},{"literal_text_all_w_t_and_m_t":"When indicated to address power saving, this maximum aggregated bandwidth includes carrier(s) of FR2-1 of the cell group that this UE assistance information is associated with. The aggregated bandwidth can only range up to the current active configuration when indicated to address power savings.","paragraph_zero_based":2908},{"literal_text_all_w_t_and_m_t":"reducedMaxBW-FR2-2","paragraph_zero_based":2909},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum aggregated bandwidth across all downlink carrier(s) and across all uplink carrier(s) of FR2-2, to address overheating or power saving. This field is allowed to be reported only when UE is configured with serving cell(s) operating on FR2-2. The aggregated bandwidth across all downlink carrier(s) of FR2-2 is the sum of bandwidth of active downlink BWP(s) across all activated downlink carrier(s) of FR2-2. The aggregated bandwidth across all uplink carrier(s) of FR2-2 is the sum of bandwidth of active uplink BWP(s) across all activated uplink carrier(s) of FR2-2. If the field is absent from the MaxBW-PreferenceFR2-2 IE or the OverheatingAssistance IE, it is interpreted as the UE having no preference on the maximum aggregated bandwidth of FR2-2.","paragraph_zero_based":2910},{"literal_text_all_w_t_and_m_t":"When indicated to address overheating, this maximum aggregated bandwidth includes carrier(s) of FR2-2 of both the NR MCG and the NR SCG. This maximum aggregated bandwidth only includes carriers of FR2-2 of the SCG in (NG)EN-DC.","paragraph_zero_based":2911},{"literal_text_all_w_t_and_m_t":"When indicated to address power saving, this maximum aggregated bandwidth includes carrier(s) of FR2-2 of the cell group that this UE assistance information is associated with. The aggregated bandwidth can only range up to the current active configuration when indicated to address power savings.","paragraph_zero_based":2912},{"literal_text_all_w_t_and_m_t":"reducedMIMO-LayersFR1-DL","paragraph_zero_based":2913},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum number of downlink MIMO layers of each serving cell operating on FR1 indicated by the field, to address overheating or power saving. This field is allowed to be reported only when UE is configured with serving cells operating on FR1. The maximum number of downlink MIMO layers can only range up to the maximum number of MIMO layers configured across all activated downlink carrier(s) of FR1 in the cell group when indicated to address power savings.","paragraph_zero_based":2914},{"literal_text_all_w_t_and_m_t":"reducedMIMO-LayersFR1-UL","paragraph_zero_based":2915},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum number of uplink MIMO layers of each serving cell operating on FR1 indicated by the field, to address overheating or power saving (see NOTE 1). This field is allowed to be reported only when UE is configured with serving cells operating on FR1. The maximum number of uplink MIMO layers can only range up to the maximum number of MIMO layers configured across all activated uplink carrier(s) of FR1 in the cell group when indicated to address power savings.","paragraph_zero_based":2916},{"literal_text_all_w_t_and_m_t":"reducedMIMO-LayersFR2-DL","paragraph_zero_based":2917},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum number of downlink MIMO layers of each serving cell operating on FR2-1 indicated by the field, to address overheating or power saving. This field is allowed to be reported only when UE is configured with serving cells operating on FR2-1. The maximum number of downlink MIMO layers can only range up to the maximum number of MIMO layers configured across all activated downlink carrier(s) of FR2-1 in the cell group when indicated to address power savings.","paragraph_zero_based":2918},{"literal_text_all_w_t_and_m_t":"reducedMIMO-LayersFR2-UL","paragraph_zero_based":2919},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum number of uplink MIMO layers of each serving cell operating on FR2-1 indicated by the field, to address overheating or power saving (see NOTE 1). This field is allowed to be reported only when UE is configured with serving cells operating on FR2-1. The maximum number of uplink MIMO layers can only range up to the maximum number of MIMO layers configured across all activated uplink carrier(s) of FR2-1 in the cell group when indicated to address power savings.","paragraph_zero_based":2920},{"literal_text_all_w_t_and_m_t":"reducedMIMO-LayersFR2-2-DL","paragraph_zero_based":2921},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum number of downlink MIMO layers of each serving cell operating on FR2-2 indicated by the field, to address overheating or power saving. This field is allowed to be reported only when UE is configured with serving cells operating on FR2-2. The maximum number of downlink MIMO layers can only range up to the maximum number of MIMO layers configured across all activated downlink carrier(s) of FR2-2 in the cell group when indicated to address power savings.","paragraph_zero_based":2922},{"literal_text_all_w_t_and_m_t":"reducedMIMO-LayersFR2-2-UL","paragraph_zero_based":2923},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum number of uplink MIMO layers of each serving cell operating on FR2-2 indicated by the field, to address overheating or power saving (see NOTE 1). This field is allowed to be reported only when UE is configured with serving cells operating on FR2-2. The maximum number of uplink MIMO layers can only range up to the maximum number of MIMO layers configured across all activated uplink carrier(s) of FR2-2 in the cell group when indicated to address power savings.","paragraph_zero_based":2924},{"literal_text_all_w_t_and_m_t":"referenceLocationReport","paragraph_zero_based":2925},{"literal_text_all_w_t_and_m_t":"This field indicates the reference locations that are closest to the UE for assisted SMTC configuration in RRC_CONNECTED state. The length of the bitmap is equal to the number of entries in the refLocList currently configured for the UE (either via OtherConfig or SIB2). The UE sets the bit at a given position to '1' if the reference location at the corresponding position in the refLocList is one of the closest locations, and to '0' otherwise. The first bit in the string corresponds to the first reference location in the list, and so on.","paragraph_zero_based":2926},{"literal_text_all_w_t_and_m_t":"referenceTimeInfoPreference","paragraph_zero_based":2927}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["4b6e1483de352c7552c73ed658003cb5e75f4eeb70e1c34a69c13cc5032894a7","8582d28383a4dc624e2868e65e2b646c9440b8a3fe51b7cc2561eef1cd02d5dd","5393dec6c7c0163e48e27d8c353754f48e6d5054ff63b4e062da698fcfd0b009","3b668d686f6c37e07ba914a90e02918d89cac0c697d002fa2fa2edc9f8c4a9d1","467b08a4acc5eda6f964dfe51a9c6b200ebf2bca9854dbb76142f7c781f84ec5","7ba79bef83de567ad4dc901b056909a9ee1bf7c8ff64e1d388d5e856f8c06b0b","62e3e1d666d9acb51b5c36ee0fac821efc5fdeba40440daa1b9a06d320235302","59e0ca16b502851c3001a33481ac1ba04eb38bf1c4102fbc51b15f77eb22be72","2f63851f6e7ccc2f0d36686fed01312ed8d1d4b1ad60deb8bf449e399a6431b4","a0ef521dec6841610617f66e065e56290a7768b38fc221e0402ec7085916941d","d317de56f1e9dda6e085c9753c4dd707d86be924ea012d4860799eb8b8d64fa6","dd173b7d81daa571cedeb2492c41d52a6cd1351a4c042e00b3ffb1b7d37ecb42","dbce2b920838c65573f65501be68004596a8b14d8e2d1369164a0719176861a8","33b9ec971bc0fc1d520a5f162c4ace59334836460b5f463f3d2953d1bffe4bc6","08869caac144b4ee29145e1abcfae0152430adf1c21d55f8a20beaad3487d9bc","d2ef8487f1662ba562ad3f6e6ecdbdb04abc9fe4bec0a24a6c0d39c5527c6879","f8c69257a3c572e23074909a9caa8c255e2ed84da3a41431c32a6f425de0e693","b54711c947b026ebee1461920d5a1a08483cd5eda78ee91610ecf678b1eb225c","e3412dc1ba0affaad36ee07b6dd2dd15d46b397d301233b0db5c83b605b44f64","ad74bbb83eab5cccc399cf0260d588e70a30880a20020cba1c435ce4f6dd241d","fd289af0c752cb8aef832dc394695a11cd8ab680145f03b057134036ea1bf906","ec2f124ec21d1cfb9cd14a167b9616dd289568361ea62c3f375f15a2f4e66f6d","75132f4241ae5cbd2b01039e88a44bd436151c7f94a8aec90908a03604c2597d","0deb46df8606eedf9f3bdf450f060e285ea5c3f569ace2f0495391e5aa9c9672"],"paragraph_range_zero_based":[2904,2927],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p2904"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether the UE prefers being provisioned with the timing information specified in the IE ReferenceTimeInfo.","paragraph_zero_based":2928},{"literal_text_all_w_t_and_m_t":"resumeCause","paragraph_zero_based":2929},{"literal_text_all_w_t_and_m_t":"Provides the resume cause based on the information received from the upper layers.","paragraph_zero_based":2930},{"literal_text_all_w_t_and_m_t":"rlm-MeasRelaxationState","paragraph_zero_based":2931},{"literal_text_all_w_t_and_m_t":"Indicates the relaxation state of RLM measurements. Value true indicates that the UE is performing relaxation of RLM measurements, and value false indicates that the UE is not performing relaxation of RLM measurements.","paragraph_zero_based":2932},{"literal_text_all_w_t_and_m_t":"rrm-MeasRelaxationFulfilment","paragraph_zero_based":2933},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE fulfils the relaxed measurement criterion for stationary UE in 5.7.4.4. Value true indicates that the UE fulfils the criterion, and value false indicates that the UE does not fulfil the criterion.","paragraph_zero_based":2934},{"literal_text_all_w_t_and_m_t":"sl-QoS-FlowIdentity","paragraph_zero_based":2935},{"literal_text_all_w_t_and_m_t":"This identity uniquely identifies one sidelink QoS flow between the UE and the network in the scope of UE, which is unique for different destination and cast type.","paragraph_zero_based":2936},{"literal_text_all_w_t_and_m_t":"sl-PRS-Bandwidth","paragraph_zero_based":2937},{"literal_text_all_w_t_and_m_t":"Indicates the desired bandwidth of the requested SL-PRS resources provided by upper layers (see TS 38.355 [77]) in the unit of MHz.","paragraph_zero_based":2938},{"literal_text_all_w_t_and_m_t":"sl-PRS-DelayBudget","paragraph_zero_based":2939},{"literal_text_all_w_t_and_m_t":"Indicates the SL-PRS delay budget provided by upper layers (see TS 38.355 [77]).","paragraph_zero_based":2940},{"literal_text_all_w_t_and_m_t":"sl-PRS-Periodicity","paragraph_zero_based":2941},{"literal_text_all_w_t_and_m_t":"Indicates the periodicity of SL-PRS transmission.","paragraph_zero_based":2942},{"literal_text_all_w_t_and_m_t":"sl-PRS-Priority","paragraph_zero_based":2943},{"literal_text_all_w_t_and_m_t":"Indicates the priority of SL-PRS provided by upper layers (see TS 38.355 [77]). Value 1 is the highest priority whereas value 8 is the lowest priority.","paragraph_zero_based":2944},{"literal_text_all_w_t_and_m_t":"sl-UE-AssistanceInformationNR","paragraph_zero_based":2945},{"literal_text_all_w_t_and_m_t":"Indicates the traffic characteristic of sidelink logical channel(s), specified in the IE SL-TrafficPatternInfo, that are setup for NR sidelink communication.","paragraph_zero_based":2946},{"literal_text_all_w_t_and_m_t":"slotOffset","paragraph_zero_based":2947},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred slot offset to resolve the IDC problem, in multiples of 1/32 ms.","paragraph_zero_based":2948},{"literal_text_all_w_t_and_m_t":"startOffset","paragraph_zero_based":2949},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred start offset to resolve the IDC problem, in multiples of 1 ms.","paragraph_zero_based":2950},{"literal_text_all_w_t_and_m_t":"type1","paragraph_zero_based":2951}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["274662df450f3001f06ae70dc4d14832991d5e5efe46411cce7c532c174f36e0","5b7d7355a4351dd2bc698423b397f13243958837a9471789f0c5fd099c83ece8","a91eb118f668205abc7ba84edcdfaab9b8c961ffd03641c8a6d87cfcc5ef5123","633804bbce799b6e17b2ac6e32444e88219be9f14fa050da8204c5ef5a511305","12ff2c12e27b26fd6f138fdfc8f14fb364aa4fd2064da03086c442b7dd79ffcc","33711315633df6ba104ac9ab0472ecdc9041bb60a1209e6d6e144e046362cbe8","25f1e331c9852b99e6775f5c8be834e23574316b391dd938af2d4cf024588373","447f6cb97baf1c630570041c91de890991ac95a26a52bf1b77b4196a82ea040b","96cd62c3a2325bc11a7cee3e711e3bbb5f575f3fdd9246b1138c827955ed6002","6ce63319152f4f54807a5b21f83abd94bff6cb3624c7d767728d1d5db45a7cc3","814c02f803d720848bdf5ceb05708e90e58649d8cf32e0870ffb95d4f09a65a3","346ee4969b9f1d9d1f84e990a91be655f1c499b64c8645a60a7b5905e2c696f8","3f50849d027b01cecd3113b2df08a974938befbdc91de5a9b34e45175c25ff18","bbdfa697caca797a32a9a19938e82e43827f3de1a552cc037163f38fc749abd9","ddfc2cda495c302f72290c3015323f5f1a842afc56944e55a9d13ad8a2d9153f","2379cc109d20d88a1993642c6bfa5a4aac7f6f369c65c527ff54dddcdb96d1ff","1b52b6e6403a890a160c1f2e4d12e4b2bb55e27cee37c95a72a7d987d77ce51b","76177b8d13dca796c661818eeaec681585f67d69536c6f60510af8f2f5cff990","097499dfe2427e3a2c5c2db4a84cc175b9b125f4e18971326871274d25421318","7cc7c39ae81b5cf25077dfddabb7d25ef3796e097be188d99238adb0ef2c8ebc","2e42a19255df707a96be25f7323a9845702f93cf7d29b637634d7973caafdc84","fb8ec62012f118d9bf67e3a83fd6215f438ba565638075c63a87cb8c863f1d83","6233a83b41a3969dfc2aebd1a3f2d9a7ed122a2c799954ef2d47cb9ca708f751","f71291546a5626bf1b56c783e46406c2ecc05d0be14f137b93a5a303e3dbb370"],"paragraph_range_zero_based":[2928,2951],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p2928"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the preferred amount of increment/decrement to the long DRX cycle length with respect to the current configuration. Value in number of milliseconds. Value ms40 corresponds to 40 milliseconds, msMinus40 corresponds to -40 milliseconds and so on.","paragraph_zero_based":2952},{"literal_text_all_w_t_and_m_t":"ul-GapFR2-PatternPreference","paragraph_zero_based":2953},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on FR2 UL gap pattern as defined in TS 38.133 [14].","paragraph_zero_based":2954},{"literal_text_all_w_t_and_m_t":"victimSystemType","paragraph_zero_based":2955},{"literal_text_all_w_t_and_m_t":"Indicate the list of victim system types to which IDC interference is caused from NR. Value gps, glonass, bds, galileo and navIC indicates the type of GNSS. Value wlan indicates WLAN and value bluetooth indicates Bluetooth. Value uwb indicates Ultra Wide Band.","paragraph_zero_based":2956},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2957},{"literal_text_all_w_t_and_m_t":"NOTE 1:The field may also indicate the UE's preference on reduced configuration corresponding to the maximum number of SRS ports (i.e. nrofSRS-Ports) of each serving cell operating on the associated frequency range.","paragraph_zero_based":2958},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2959},{"literal_text_all_w_t_and_m_t":"SL-TrafficPatternInfo field descriptions","paragraph_zero_based":2960},{"literal_text_all_w_t_and_m_t":"messageSize","paragraph_zero_based":2961},{"literal_text_all_w_t_and_m_t":"Indicates the maximum TB size based on the observed traffic pattern. The value refers to the index of TS 38.321 [3], table 6.1.3.1-2.","paragraph_zero_based":2962},{"literal_text_all_w_t_and_m_t":"timingOffset","paragraph_zero_based":2963},{"literal_text_all_w_t_and_m_t":"This field indicates the estimated timing for a packet arrival in a sidelink logical channel. Specifically, the value indicates the timing offset with respect to subframe#0 of SFN#0 in milliseconds.","paragraph_zero_based":2964},{"literal_text_all_w_t_and_m_t":"trafficPeriodicity","paragraph_zero_based":2965},{"literal_text_all_w_t_and_m_t":"This field indicates the estimated data arrival periodicity in a sidelink logical channel. Value ms20 corresponds to 20 ms, ms50 corresponds to 50 ms and so on.","paragraph_zero_based":2966},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2967},{"literal_text_all_w_t_and_m_t":"UL-TrafficInfo field descriptions","paragraph_zero_based":2968},{"literal_text_all_w_t_and_m_t":"burstArrivalTime","paragraph_zero_based":2969},{"literal_text_all_w_t_and_m_t":"Indicates the expected arrival time of the first packet of the Data Burst for the concerned QoS flow. If the UE provides both burstArrivalTime and jitterRange, burstArrivalTime is used as a reference time for the indicated jitter range.","paragraph_zero_based":2970},{"literal_text_all_w_t_and_m_t":"If burstArrivalTime is indicated as referenceTime, the indicated time in 10ns unit from the origin is refDays*86400*1000*100000 + refSeconds*1000*100000 + refMilliSeconds*100000 + refTenNanoSeconds. The refDays field specifies the sequential number of days (with day count starting at 0) from 00:00:00 on Gregorian calendar date 6 January, 1980 (start of GPS time).","paragraph_zero_based":2971},{"literal_text_all_w_t_and_m_t":"If burstArrivalTime is indicated as referenceSFN-AndSlot, it refers to the UL timing of the closest SFN and slot of the PCell with the indicated number.","paragraph_zero_based":2972},{"literal_text_all_w_t_and_m_t":"jitterRange","paragraph_zero_based":2973},{"literal_text_all_w_t_and_m_t":"Indicates the maximum deviation of the arrival time of the first packet of a Data Burst compared to the time indicated with burstArrivalTime and the periodicity of the Data Bursts. lowerBound indicates the negative deviation while upperBound indicates the positive deviation. This field shall only be reported together with the burstArrivalTime or after the burstArrivalTime has been already reported. Value ms0 corresponds to 0 ms, value 0dot5 to 0.5 ms, value ms1 to 1 ms and so on. Value beyondMs7 indicates the jitter bound is higher than 7 ms. Value 0 ms means there is no Data Burst arrival time deviation from the indicated burstArrivalTime.","paragraph_zero_based":2974},{"literal_text_all_w_t_and_m_t":"pdu-SetIdentification","paragraph_zero_based":2975}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["351f4219d272283a1f29152f988f23139ec5eb02ae08200020198703d86470a2","5ba7591eda055c095cdd93870d0b4ec991afba02be38ebcb0c3e15915dafac4a","412ef9ca06b5117b096890f8711e86772d1d792b40727749cd793c7879c65a80","3a9c6b113de07de4dd6e3f15d02d8f8eb6258ae00926791583ca03631504f5b5","a45451ab0ba7210661af823e720dcfd8085fc0eac7501a5835925f1ab6a6a2eb","5d7144ddaf085bf48763ddfdb3a1f001dd93ea0c8608982e4e30e57787f5b8b9","2f8783f8703c46a0487a246865d8fb59102fea138e38250a62878f0c92e44b4c","f6a0abc82a9c29709b7beb4b910662cad17a90d61acc0523d13d84de229d143a","0a6e9dd492ec84d0d3b19e43f1eff4a4503b37f0090b0bff3b682e97e58c631f","74fb48ed311ab8805f1029b6c293d62f4627766b6e93662ac65cd0280bb75a16","1e76c7dd857b7ec00e71d081ed98bd787c78458c7372c8e055dfc7e9ff92c8f9","27de15d4954b9f261b5df642ca95eff62dbec1c5bdf3602feb028a08b9192f56","e1b308b1742d7ff5b8cb59de87207aa11fb4ea1ee291683455a3da5fb5b79047","1ad0e7375b951c8eaf5c2fd0aabae233daf21e4bf10e4917dabfad12447933c7","df7b921cfc333882477036be1d65df6b61544d6eafc4b3842c1961c23f8ccf46","bbc105cd3905b2b81239736bc8767f6cf35411d566b8d203b6dba9155e472926","21c065b9fd5df797882fe62fe48e5a9bd30dc98dc9a4f21be37145ede8ed036d","ba1a7f775d858a9603928e3cf5de88c4a3c9a87a3426d254da88d67c6df81332","2b88e35992f0e9e7fdc08a8dc4b488f407f4a681b35485b4db5fa5888ff94494","398ad357efb79142b3403fb67ff8e5076d67ab85a0884afece6f580ace830652","522e00d6a4e392df9e5e36dd0edaec20b45fdcfa6b9907f8f8019d887c7a1aaf","ce082b50a73aef43ff907f760cb6019fc1957fd9dd8d3eef902e2849b98a8864","d17c018c9d615c6e4ea05b545b55582816e814b823e5782ca6aad068e318e7f8","8f5ccf956c0c173f2e3f13692dffda62d59023fd27b1b0ead89889488da2bd04"],"paragraph_range_zero_based":[2952,2975],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p2952"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether the UE is able to identify PDU Set(s) for the QoS flow. If set to true, the UE is able to identify PDU Set(s) for the associated QoS flow, otherwise, the UE is not able to do so. Before receiving this indication, the network assumes the value is set to false.","paragraph_zero_based":2976},{"literal_text_all_w_t_and_m_t":"psi-Identification","paragraph_zero_based":2977},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE is able to identify PSI(s) for the QoS flow. This field shall only be set to true if pdu-SetIdentification is also set to true (or was set to true previously for the same QoS flow). If set to true, the UE is able to identify PSI(s) for the associated QoS flow, otherwise, the UE is not able to do so. Before receiving this indication, the network assumes the value is set to false.","paragraph_zero_based":2978},{"literal_text_all_w_t_and_m_t":"qfi","paragraph_zero_based":2979},{"literal_text_all_w_t_and_m_t":"Identity of the QoS flow to which this UL traffic information refers.","paragraph_zero_based":2980},{"literal_text_all_w_t_and_m_t":"trafficPeriodicity","paragraph_zero_based":2981},{"literal_text_all_w_t_and_m_t":"Indicates the average time period between the start times of two data bursts, expressed in the number of microseconds.","paragraph_zero_based":2982},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2983},{"literal_text_all_w_t_and_m_t":"GapOccasionCancelRatio field descriptions","paragraph_zero_based":2984},{"literal_text_all_w_t_and_m_t":"fr1, fr2","paragraph_zero_based":2985},{"literal_text_all_w_t_and_m_t":"Includes the UE's preference for gap occasion cancellation ratio for the configured per FR measurement gap under measGapConfig.","paragraph_zero_based":2986},{"literal_text_all_w_t_and_m_t":"gapConfigRatioList","paragraph_zero_based":2987},{"literal_text_all_w_t_and_m_t":"Includes the UE's preference for gap occasion cancellation ratio for the configured measurement gap with measGapId in gapToAddModList under measGapConfig.","paragraph_zero_based":2988},{"literal_text_all_w_t_and_m_t":"perUE","paragraph_zero_based":2989},{"literal_text_all_w_t_and_m_t":"Includes the UE's perference for gap occasion cancellation ratio for the configured per UE measurement gap under measGapConfig.","paragraph_zero_based":2990},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2991},{"literal_text_all_w_t_and_m_t":"<Text Omitted>","paragraph_zero_based":2992},{"literal_text_all_w_t_and_m_t":"–UEInformationResponse","paragraph_zero_based":2993},{"literal_text_all_w_t_and_m_t":"The UEInformationResponse message is used by the UE to transfer information requested by the network.","paragraph_zero_based":2994},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1 or SRB2 (when logged measurement information is included) or SRB6 (when logged measurement information for network-side data collection is included)","paragraph_zero_based":2995},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":2996},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":2997},{"literal_text_all_w_t_and_m_t":"Direction: UE to network","paragraph_zero_based":2998},{"literal_text_all_w_t_and_m_t":"UEInformationResponse message","paragraph_zero_based":2999}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["937ec47bbe23adc28bee68967c9775d2424fc80d65a147d2efd363824f7cc3f8","c37ef3d1f5d80fae21d96e265d231bc907e84c33156bcb837cbbd148c10d9d5c",