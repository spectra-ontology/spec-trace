"5.26.1General","paragraph_zero_based":119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ddebae022a1023b5fa169df11e1143a683d22a075bd471ce9203075b0e6cf8e6","original_member_sha256":"079347550824507143451300739b9458470390d3606d1be737bdc5d4836fbe92","paragraph_ElementTree_utf8_XML_sha256":["7ae559ec2991ca97b15292717e994fec32dd6bb2702fd82d71df5f6d3449fc80","59190e70ece9ffb806e9984eb0949613812c790031ebd2f417b07742101bcec3","5b9d3e94b2e2469a162f36c651ac6802b31fcc4b4fed4f8769f27295b66f32e3","0e47661d68410752894205dee6a9bbbad763c4fb8f938472f606caa30fd5b3b2","879f574c7533026f0f1fdd9c8956f622a586bad9ece08cd6990393773177293a","046072d789da32203b2dbdc5bf6faf7ce0947321bf61b1475c3867e7f07b4f28","ad7c58beb1d9e90fb0849bcd216a0fa195ed528b17181f725cf2b49a179cb8f1","826ddaefbd35bf5941dd0ba7402603c67afa4054d718e9bc0124542ef7dca6de","f93659204248bf7212a2a073874fa6ef6bab855e1f334d94d95f69bdfcb0d978","1f410e726d304214a874eb5f63bfb936ee9c1cb1603feb77631fabf0a168ec99","84cfffd8b170c458e9fd1f937758338e77952052a138c7c60120dc1e8ee9c412","f7b3a7bb9ad97a828da3323273c2deac8004729d61d7f2c7a25185dd92d4eb66","623edfeb67c2d41b2b9e147012100dce2f709456a108863b11db12637e74c692","972c89243ea25b912af8179a8be8c77ab6d50347dd064fa94fff2d9d947bbd4b","022031e640f79d734e0c0078695b4546709c7cc0e2d4b09f740c852d83464850","90739a9b5718a75a6036a95b91a37f44f1e9aef38922942dfe97f431acb1a425","6c4b79aee2df9417fdcf7ff053d8ed2a9ea25e31efedf31e6292500ff9c4b627","8a2054446422db10127b53522c244dd671006eed469081cd46119e9103434846","09696b54939497a8ca2ba620420c03c7479c8446d64fb680ae1962b6d211066f","c002616492b1923e46d6fa95a25dac7944411eca88ccdcee2199f265ed726678","3ff51b52463a7f6da30fc5a8c9ec1a7bf7431f765f14f2ad8a3d95d7d02d3c4e","a1ce02611ac55121d91028558c68190625e1f1031039b04a6b96d2738520934e","01254d2425e341da3120ebe46ce246a15daaf7cc8c11e8e865e21588e7f6a898","e9ed73e50dd82592eeb74c58de60cef1bf4ded8314b42cb157a9f3052c047