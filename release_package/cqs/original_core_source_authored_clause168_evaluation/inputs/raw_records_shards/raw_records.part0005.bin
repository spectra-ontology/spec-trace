{"fields":{"filename":"R2-2502074.zip::R2-2502074 Introudction of control parameters for on-demand posSIB request for RRC_final.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"==========================================================NEXT CHANGE =======================================================","paragraph_zero_based":552},{"literal_text_all_w_t_and_m_t":"–UE-NR-Capability","paragraph_zero_based":553},{"literal_text_all_w_t_and_m_t":"The IE UE-NR-Capability is used to convey the NR UE Radio Access Capability Parameters, see TS 38.306 [26].","paragraph_zero_based":554},{"literal_text_all_w_t_and_m_t":"UE-NR-Capability information element","paragraph_zero_based":555},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":556},{"literal_text_all_w_t_and_m_t":"-- TAG-UE-NR-CAPABILITY-START","paragraph_zero_based":557},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":558},{"literal_text_all_w_t_and_m_t":"UE-NR-Capability ::=            SEQUENCE {","paragraph_zero_based":559},{"literal_text_all_w_t_and_m_t":"    accessStratumRelease            AccessStratumRelease,","paragraph_zero_based":560},{"literal_text_all_w_t_and_m_t":"    pdcp-Parameters                 PDCP-Parameters,","paragraph_zero_based":561},{"literal_text_all_w_t_and_m_t":"    rlc-Parameters                  RLC-Parameters                                                        OPTIONAL,","paragraph_zero_based":562},{"literal_text_all_w_t_and_m_t":"    mac-Parameters                  MAC-Parameters                                                        OPTIONAL,","paragraph_zero_based":563},{"literal_text_all_w_t_and_m_t":"    phy-Parameters                  Phy-Parameters,","paragraph_zero_based":564},{"literal_text_all_w_t_and_m_t":"    rf-Parameters                   RF-Parameters,","paragraph_zero_based":565},{"literal_text_all_w_t_and_m_t":"    measAndMobParameters            MeasAndMobParame