ument_XML_sha256":"d9500d743df528eaa6f79c82b73858ab5f893a44b9ae1866383034da0664ebbb","original_member_sha256":"93f0ae5e95c15dbf3441eef6a21cff070c81046db872fa11f765b60ddcf4ca20","paragraph_ElementTree_utf8_XML_sha256":["5858ee86d366ad85b9865f52d5fd8818cff4293f857492974340cff2b2f833d5","7842e7d2852e422f41b5fc54c74af3a8117a08811c0b914ebd12d31fa5a94e6f","41d043810ca3bb1a34ed648831d0b0d567b4cb98a2c1ea0db2ec24a2a23c86ce","1e631a8b70e34020649caaa7fb98e79e9027ea5f1bdbc71f24a684438c436f69","45014abf4540b1d3cd1ced20121ea89d4dfd842fa98b0e1677a0d1bace8127bb","95911d8f920c8dc9ecb705d5ffea0d7f433e041e48db77aa4e2acf8fb27530d2","dfd91ecac20c881a6edb0d9850525182cfb6b4f4fbaaabec2f072cdfd3ee19e0","1b237eca7e7fa47a65d6b80a366d8f8be0a87f45766408ac8f51245e0267e458","864e72c722a84906e0bd1be53e35cb92be24c0ce55b4398f7f212f4ce245314a","2da8bae5a2e6866643b70b94d63a4ca6d395de5d9198d71fdee2de52a3c53474","ec68446ad3312081fa3176eeda9be50bb0034f4a2059c3136fd74590a44b3eb1","d22d9f3df74e8b05ce01e617afb5505406a9f645385140dd86e130e4133fbd40","2b579efeb352ae6e02422a9b384614735f93277355d68e413325d2ac0471debd","8bcfb0309f52b7f5cb2e2e20e91e5be12498de4d5bc93f2cb1ee055da109e466","596ba33ea897b28d57898e5933233f9e8c2908fc8bbc1815f2df611f35564879","88c816083f580d6b514d83fe6f43ac195263f6610c88344e8d572bfb9d92eb96","f934cfe6361ff077a3ffe5bcd768cb763be2bbfc86a826f94a9f508fad92adb2","5281f5bbb88838a1c144c7c3c92fc5a6ec1d3837a99511df0033d7dba1e43edb","0897a11238c0f17ed6646e6a45caeb3d655f0b3b97c9c3ff6ac578d7fc0ce116","7271a0d93b68199b25a0b630a79d4b6f47a741bdd9508edf332f421e36f50826","68bee09b0c0eb52381fa1708763875dd8012aba0cfbb9d810b66c83029c6d046","de40bfe44274221b760d5d4551f1b23599a22c80a2697e9d6d6af8f2eac8bd1f","ef83a56f47c9382271fb1a4287a048a20ba15688f876a5b38718ed5f45af6517","f4e36343614a744b803cebdf17f188baf9b082041a0ba16e34945f97863a2c09"],"paragraph_range_zero_based":[96,119],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},