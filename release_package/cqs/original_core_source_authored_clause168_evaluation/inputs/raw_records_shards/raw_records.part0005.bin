{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    sl-TimeOffsetEUTRA-List-r16                    SEQUENCE (SIZE (8)) OF SL-TimeOffsetEUTRA-r16             OPTIONAL    -- Need M","paragraph_zero_based":2160},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2161},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2162},{"literal_text_all_w_t_and_m_t":"SL-TimeOffsetEUTRA-r16 ::=        ENUMERATED {ms0, ms0dot25, ms0dot5, ms0dot625, ms0dot75, ms1, ms1dot25, ms1dot5, ms1dot75,","paragraph_zero_based":2163},{"literal_text_all_w_t_and_m_t":"                                              ms2, ms2dot5, ms3, ms4, ms5, ms6, ms8, ms10, ms20}","paragraph_zero_based":2164},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2165},{"literal_text_all_w_t_and_m_t":"UE-TxTEG-RequestUL-TDOA-Config-r17 ::=  CHOICE {","paragraph_zero_based":2166},{"literal_text_all_w_t_and_m_t":"    oneShot-r17                             NULL,","paragraph_zero_based":2167},{"literal_text_all_w_t_and_m_t":"    periodicReporting-r17                   ENUMERATED { ms160, ms320, ms1280, ms2560, ms61440, ms81920, ms368640, ms737280 }","paragraph_zero_based":2168},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2169},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2170},{"literal_text_all_w_t_and_m_t":"SRS-PosResourceSetAggBW-CombinationList-r18 ::= SEQUENCE (SIZE(1.. maxNrOfLinkedSRS-PosResSetComb-r18)) OF SRS-PosResourceSetLinkedForAggBW-List-r18","paragraph_zero_based":2171},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2172},{"literal_text_all_w_t_and_m_t":"SRS-PosResourceSetLinkedForAggBW-List-r18 ::= SEQUENCE (SIZE(2..maxNrOfLinkedSRS-PosResourceSet-r18)) OF SRS-PosResourceSetLinkedForAggBW-r18","paragraph_zero_based":2173},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2174},{"literal_text_all_w_t_and_m_t":"N3C-ExtIndirectPathAddChange-r19 ::=            SEQUENCE (SIZE(1..maxNrofN3C-RelayUE-r19)) OF N3C-RelayUE-Info-r18","paragraph_zero_based":2175},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2176},{"literal_text_all_w_t_and_m_t":"-- TAG-RRCRECONFIGURATION-STOP","paragraph_zero_based":2177},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":2178},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2179},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2180},{"literal_text_all_w_t_and_m_t":"RRCReconfiguration-IEs field descriptions","paragraph_zero_based":2181},{"literal_text_all_w_t_and_m_t":"appLayerMeasConfig","paragraph_zero_based":2182},{"literal_text_all_w_t_and_m_t":"This field is used to configure application layer measurements. This field is absent when the UE is configured to operate with shared spectrum channel access or if sl-L2RemoteUE-Config-r17 is configured or not released.","paragraph_zero_based":2183}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["e2c2bde8f80a7e8f1de5c456b846ac731f4449f75602815c2f9ef78caa6e2b1d","d8363ddf75f2dce4d896540c62ab4f56d2198a50894aa05952703685db7dc138","d3a7724f7f3c0e8215db3faf8e7d4196542cd2fef006d1de5553904cb0f56ee4","90eec7eedee5e86bda8fd6a9b20e07fdc9a2f24b559fc06f73053d835afaaa14","be8e3d7978baef14d6c4410fbe16fd051c3c943ce9df0aecf257bc130bd7d887","23dd77c71181838fa93e2f2ee6d7fd652d6581931c77164df8b92ba43af4074a","fb189afd41c7e381c422a5cd0b49c1a5cd952a7e09804351b9879d500d8e2bd0","261f5adac59981c9816897d90b2adb38f696bba411a76aed84c3818accc1c3fb","fa4a3fe4aa9bb437c08f3df27ec9a7b57483667f479cc7b63840dac6a74033ee","5b04b21c151fa9f14e75690c1b41cf2c5203036781d895f3af45cd5ad82f577a","27ef36e2aeabbf2afdd4da73c9d9b26c8a95977077c21067e87c0d87e843f271","af022f9975a0af39bd36738821f53d67a7ad82fc25e26f95c9edcb484169f153","1b1bf4ac4c69afeeb4093a2298b2c559939c213735fad58aa05af51d50c3beb3","6d20c20694f8cde2285992f6eea4288f379227fe77b52695aa4f0adbceb5906c","9b079c309b3f03199293ddaae30242017ca1533463931ddca3936273cdb957df","178b4df47d564a590ffc38aa5f2e68963609b2e8f6f23b994088cc1d90d3272e","c0aba7a920718e00408c52cd334bf2ed3ce06026d4a106a9b7b4413f300cc130","4621269ac5693e0665e541f0eeaca5d6842efc874160ad091770c2164e4a2b7c","61bce4258486e071bffc0eb8fc32d4bf77f0797bfbf8252c740e8312977c642b","c69539048e4af730420d42cfab80fc694ddbe91bb2a92d2a517da6021c0220ac","8f269fdc6d542692719870a8ac1f21a93eaf10e09e2f45d4805a08ef14bb73a6","e1c42b332114eb21c523dc6608478221561ecde22c9d9a2edb0020eb4c05dc67","f9147d412e5c6e44603a399c3140a0cb35faf14ba0141b55f8e05cb746d37ebb","3e85bc7f0abc3c60161274fbf1d71135c6618cabd973c66eb6aebfeeb7ca5b12"],"paragraph_range_zero_based":[2160,2183],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p2160"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"bap-Config","paragraph_zero_based":2184},{"literal_text_all_w_t_and_m_t":"This field is used to configure the BAP entity for IAB nodes.","paragraph_zero_based":2185},{"literal_text_all_w_t_and_m_t":"bap-Address","paragraph_zero_based":2186},{"literal_text_all_w_t_and_m_t":"Indicates the BAP address of an IAB-node. The BAP address of an IAB-node cannot be changed once configured for the cell group to the BAP entity.","paragraph_zero_based":2187},{"literal_text_all_w_t_and_m_t":"conditionalReconfiguration","paragraph_zero_based":2188},{"literal_text_all_w_t_and_m_t":"Configuration of candidate target SpCell(s) and execution condition(s) for conditional handover, conditional PSCell addition or conditional PSCell change. The field is absent if any DAPS bearer is configured, if the sl-L2RemoteUE-Config or sl-L2RelayUE-Config is configured, or if the RRCReconfiguration message is contained within condRRCReconfig. When the masterCellGroup and/or secondaryCellGroup includes ReconfigurationWithSync, if this field is present, it only includes configurations/fields specific to subsequent CPAC. The RRCReconfiguration message contained in DLInformationTransferMRDC cannot contain the field conditionalReconfiguration for conditional PSCell change or for conditional PSCell addition. The network does not include this field in an RRCReconfiguration message contained within a LTM-Config IE.","paragraph_zero_based":2189},{"literal_text_all_w_t_and_m_t":"daps-SourceRelease","paragraph_zero_based":2190},{"literal_text_all_w_t_and_m_t":"Indicates to UE that the source cell part of DAPS operation is to be stopped and the source cell part of DAPS configuration is to be released.","paragraph_zero_based":2191},{"literal_text_all_w_t_and_m_t":"dedicatedNAS-MessageList","paragraph_zero_based":2192},{"literal_text_all_w_t_and_m_t":"This field is used to transfer UE specific NAS layer information between the network and the UE. The RRC layer is transparent for each PDU in the list. ","paragraph_zero_based":2193},{"literal_text_all_w_t_and_m_t":"dedicatedPagingDelivery","paragraph_zero_based":2194},{"literal_text_all_w_t_and_m_t":"This field is used to transfer Paging message for the associated L2 U2N Remote UE or for the associated child UE to the L2 U2N Relay UE or to L2 Last U2N Relay UE in RRC_CONNECTED.","paragraph_zero_based":2195},{"literal_text_all_w_t_and_m_t":"dedicatedPosSysInfoDelivery","paragraph_zero_based":2196},{"literal_text_all_w_t_and_m_t":"This field is used to transfer SIBPos to the UE in RRC_CONNECTED. This field may contain multiple posSIB segments of the same posSIB type. When the number of segments of posSIB of the same posSIB type exceeds the maximum number of posSIBs of this field (i.e., 32), the posSIB segments of the same posSIB type may be delivered in multiple RRCReconfiguration messages.","paragraph_zero_based":2197},{"literal_text_all_w_t_and_m_t":"dedicatedSIB1-Delivery","paragraph_zero_based":2198},{"literal_text_all_w_t_and_m_t":"This field is used to transfer SIB1 to the UE (including L2 U2N Remote UE). The field has the same values as the corresponding configuration in servingCellConfigCommon.","paragraph_zero_based":2199},{"literal_text_all_w_t_and_m_t":"dedicatedSystemInformationDelivery","paragraph_zero_based":2200},{"literal_text_all_w_t_and_m_t":"This field is used to transfer SIB6, SIB7, SIB8, SIB19, SIB20, SIB21, SIB25, SIB26 to the UE with an active BWP with no common search space configured or the L2 U2N Remote UE in RRC_CONNECTED. For UEs in RRC_CONNECTED (including L2 U2N Remote UE), this field is also used to transfer the SIBs requested on-demand.","paragraph_zero_based":2201},{"literal_text_all_w_t_and_m_t":"defaultUL-BAP-RoutingID","paragraph_zero_based":2202},{"literal_text_all_w_t_and_m_t":"This field is used for IAB-node to configure the default uplink Routing ID, which is used by IAB-node during IAB-node bootstrapping, migration, IAB-MT RRC resume and IAB-MT RRC re-establishment for F1-C and non-F1 traffic. The defaultUL-BAP-RoutingID can be (re-)configured when IAB-node IP address for F1-C related traffic changes. This field is mandatory only for IAB-node bootstrapping.","paragraph_zero_based":2203},{"literal_text_all_w_t_and_m_t":"defaultUL-BH-RLC-Channel","paragraph_zero_based":2204},{"literal_text_all_w_t_and_m_t":"This field is used for IAB-nodes to configure the default uplink BH RLC channel, which is used by IAB-node during IAB-node bootstrapping, migration, IAB-MT RRC resume and IAB-MT RRC re-establishment for F1-C and non-F1 traffic. The defaultUL-BH-RLC-Channel can be (re-)configured when IAB-node IP address for F1-C related traffic changes, and the new IP address is anchored at a different IAB-donor-DU. This field is mandatory for IAB-node bootstrapping. If the IAB-MT is operating in EN-DC, the default uplink BH RLC channel is referring to an RLC channel on the SCG; Otherwise, it is referring to an RLC channel either on the MCG or on the SCG depending on whether the MN or the SN configures this field.","paragraph_zero_based":2205},{"literal_text_all_w_t_and_m_t":"flowControlFeedbackType","paragraph_zero_based":2206},{"literal_text_all_w_t_and_m_t":"This field is only used for IAB-node that support hop-by-hop flow control to configure the type of flow control feedback. Value perBH-RLC-Channel indicates that the IAB-node shall provide flow control feedback per BH RLC channel, value perRoutingID indicates that the IAB-node shall provide flow control feedback per routing ID, and value both indicates that the IAB-node shall provide flow control feedback both per BH RLC channel and per routing ID.","paragraph_zero_based":2207}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["ccae6ae4b87b5fcdfb59e2193aef121b9c433768303cb1018bffae5f19ab946b","fc7f949d19eb4c0c8c5a1d7060267077ed6b5d1898093a71b506a6dfe7a51ad6","7eed430d6c347fbd4ecf051b334d5b0c91c76a38fd8121eb0bae10d5283e3f56","8b5209c757af93259f776670f178e578cebff3f8718b2d66e74ab05d3b33f408","a1622c64c0fd4db8f19aa2e02b6f9f697ada902859970ce6625e3853ba6b9531","ce6b011ce11bb33497b8b7cf5652ddd904d4428e955506957fbf5b3868f03140","034f2b1987d8d2c12818550538c6e21e74e14bdfe16034cdddfa315d71c9f72b","a0bf87d1c356d532dec016df0da9cfbaf82815c1f565c49ad2a3385a4c03f6ce","d93d12a7fc0cad995dcb4342460b82f074146ee8c3141e58eb35e462aa2280b8","45b02e6ed915db5dc641e810e8d37af4c45bbc977f8203c73de3506e2e39a13b","3f58249da91c4380318d29daaf9a5dcfcab7951c8f0dde3a5c997a0af3557ecb","e49d1345b5276247d214770861edd925555ccae7bd6fd09265474ebba69df553","4fe01a4afbac9e14efd33296ee0f15c8a278b46d7fb42eda83b769bba57137f9","6f1123cf8e36c0f9085bcee6efaa0e95f93cc8751043374aea09ad0621e61c87","21501dac94a898ebbd8fe57419879b66b74568d36bfec81630b8a52304babd55","8610e8b0d385b17da8231763d309a323e76c5e1d9721ab6152177a6ea0041243","3807f33777c931a2254a790f2b77b43bf0777f5d87a847cb2a51e7dbe072e04d","b1cb469439ecc21712dc929840045058c14087b4c79a9d1bffeaa4d71265db68","7eaebb6938c3e069ec0cb34b3580e9fe9f7438ffad22411357422c2d5adba7e6","0cc532841df7b1493fcd3c1d5042a385203216553e69b5eae204e8375b8fd6d0","700b9a7a3ec6c913605d2ebec4adcee16cd80f5a2ced0e0881c97f3ed4101378","8fb5e9f0c5bda507f991d45299d3673742290337c2ad5e570894fa7e3ba0f3d9","f890f1af5c6f7d636ae05b3abb16e1579408ca3285465d607d137af24c86064e","babab85a4dd43f23c39ddce8848122408d9a776cf4981c24b20a87aa3e493de2"],"paragraph_range_zero_based":[2184,2207],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p2184"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"fullConfig","paragraph_zero_based":2208},{"literal_text_all_w_t_and_m_t":"Indicates that the full configuration option is applicable for the RRCReconfiguration message for intra-system intra-RAT HO. For inter-RAT HO from E-UTRA to NR, fullConfig indicates whether or not delta signalling of SDAP/PDCP from source RAT is applicable. This field is absent if any DAPS bearer is configured or when the RRCReconfiguration message is transmitted on SRB3, and in an RRCReconfiguration message for SCG contained in another RRCReconfiguration message (or RRCConnectionReconfiguration message, see TS 36.331 [10]) transmitted on SRB1.","paragraph_zero_based":2209},{"literal_text_all_w_t_and_m_t":"iab-IP-Address","paragraph_zero_based":2210},{"literal_text_all_w_t_and_m_t":"This field is used to provide the IP address information for IAB-node.","paragraph_zero_based":2211},{"literal_text_all_w_t_and_m_t":"iab-IP-AddressIndex","paragraph_zero_based":2212},{"literal_text_all_w_t_and_m_t":"This field is used to identify a configuration of an IP address.","paragraph_zero_based":2213},{"literal_text_all_w_t_and_m_t":"iab-IP-AddressToAddModList","paragraph_zero_based":2214},{"literal_text_all_w_t_and_m_t":"List of IP addresses allocated for IAB-node to be added and modified.","paragraph_zero_based":2215},{"literal_text_all_w_t_and_m_t":"iab-IP-AddressToReleaseList","paragraph_zero_based":2216},{"literal_text_all_w_t_and_m_t":"List of IP address allocated for IAB-node to be released.","paragraph_zero_based":2217},{"literal_text_all_w_t_and_m_t":"iab-IP-Usage","paragraph_zero_based":2218},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the usage of the assigned IP address. If this field is not configured, the assigned IP address is used for all traffic.","paragraph_zero_based":2219},{"literal_text_all_w_t_and_m_t":"iab-donor-DU-BAP-Address","paragraph_zero_based":2220},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the BAP address of the IAB-donor-DU where the IP address is anchored.","paragraph_zero_based":2221},{"literal_text_all_w_t_and_m_t":"keySetChangeIndicator","paragraph_zero_based":2222},{"literal_text_all_w_t_and_m_t":"Indicates whether UE shall derive a new KgNB. If reconfigurationWithSync is included, value true indicates that a KgNB key is derived from a KAMF key taken into use through the latest successful NAS SMC procedure, or N2 handover procedure with KAMF change, as described in TS 33.501 [11] for KgNB re-keying. Value false indicates that the new KgNB key is obtained from the current KgNB key or from the NH as described in TS 33.501 [11].","paragraph_zero_based":2223},{"literal_text_all_w_t_and_m_t":"ltm-Config","paragraph_zero_based":2224},{"literal_text_all_w_t_and_m_t":"The network does not configure this field in an RRCReconfiguration message within an LTM-Config IE and ConditionalReconfiguration IE.","paragraph_zero_based":2225},{"literal_text_all_w_t_and_m_t":"ltm-ConfigNRDC","paragraph_zero_based":2226},{"literal_text_all_w_t_and_m_t":"This field contains LTM candidate configurations associated with the SCG and the MCG. The network does not configure this field in an RRCReconfiguration message contained in nr-SCG or transmitted on SRB3.","paragraph_zero_based":2227},{"literal_text_all_w_t_and_m_t":"masterCellGroup","paragraph_zero_based":2228},{"literal_text_all_w_t_and_m_t":"Configuration of master cell group.","paragraph_zero_based":2229},{"literal_text_all_w_t_and_m_t":"mrdc-ReleaseAndAdd","paragraph_zero_based":2230},{"literal_text_all_w_t_and_m_t":"This field indicates that the current SCG configuration is released and a new SCG is added at the same time. The network always includes this field in an mrdc-SecondaryCellGroup set to setup which is included in an RRCReconfiguration message within an LTM-Config IE.","paragraph_zero_based":2231}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["45c4e1786c069e806be4f233a5920f1fae27e2f53c6dd187727f4d0546a80d20","2ab8d194e09b6bc579a0539b246ebf3b2d3ce6affca2c70979f30f72680f82d6","d22d4ed9f53114250d350efcef925cbee78e4230791a56029e8775e322790101","9134167a048168ca034cd6af00dde5737b8f65c30569d28efe6b9d7f19635ebe","816323cbf30131b30938c95cd2009868c860fbc763541e0e662eb19f2a5085a7","a5ce4012224dcc36df8f723669831f0fe5252848b00c18c411c3761f4971ba29","2e86cf73c63f3e88cfe043ff51a60e9da8f5e12d97d0544a395c0a104713327a","1fdd56084d57d7c18a80cd59a0f76d954c91f3aa1666c09ad6320cabc06374fb","7c65c7f23d75f4028eff6b94420e18f125f5495dacdfa8b02bc333297bfc3d46","d293347ea2a31794fe61d18fa6fd4b0ed656b7a85285561413b558abb16c93b2","ce8793ed67240a92a9ae82449670a033473d195a719b93bbfc5034ddcb2b7970","c810b55905f6c3302cf78dc9ebb63e2780310f71e478c1fbaba38319a789773d","483ca4fb58a528c7dc14ae8641f6451a480f52c312dc44e661215cfbb41e5285","6db13f0f45fee1fcd8fb8d36f4f0bd19c245afb2f1b9547e0f654e7f1a020025","aeb6741c0e6afefc955b0c1b882c767720c71c5da22eb7bf77e6828a7f246938","13cf8873b8a5c1477d54e95864d3af9e8972fc1803a308060d19a818637a48f3","a747f20e7e19db590d8f59db02a3ec9cd7da52f85d2ab0705cb166e6d3b33c3e","15ca91d3eb0185aab5cd6278e1b5fc1ada7d463c152e583b9067b7b09b02c3f2","a9c0b12f5583297f80d54ad7324624e51567b4afaf837429d774764d147bdb76","7cabda0cfc878f97319282d5a1728d532f8eb73538c2c3479d8ad334774cf70a","46c6b780286b473f5d76c5b7cfecf2af4603167405b7432b1a24bf8072e3f8ae","8c74f0ee76bb185cf281380ada1b1020d57babcf1baf3174179b5927a7502599","48da35dd29007be9b77d16643d6703843a30994397a93dada0c5d0cd9f83db4a","485103ede42ecc740c8ca31d24cf446e24e03dfda206d45d2fe38419221c213a"],"paragraph_range_zero_based":[2208,2231],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p2208"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"mrdc-SecondaryCellGroup","paragraph_zero_based":2232},{"literal_text_all_w_t_and_m_t":"Includes an RRC message for SCG configuration in NR-DC or NE-DC.For NR-DC (nr-SCG), mrdc-SecondaryCellGroup contains the RRCReconfiguration message as generated (entirely) by SN gNB. In this version of the specification, the RRC message can only include fields secondaryCellGroup, otherConfig, conditionalReconfiguration, ltm-Config, measConfig, bap-Config, IAB-IP-AddressConfigurationList and appLayerMeasConfig.","paragraph_zero_based":2233},{"literal_text_all_w_t_and_m_t":"For NE-DC (eutra-SCG), mrdc-SecondaryCellGroup includes the E-UTRA RRCConnectionReconfiguration message as specified in TS 36.331 [10]. In this version of the specification, the E-UTRA RRC message can only include the field scg-Configuration.","paragraph_zero_based":2234},{"literal_text_all_w_t_and_m_t":"mrdc-SecondaryCellGroupConfig","paragraph_zero_based":2235},{"literal_text_all_w_t_and_m_t":"This field is used to configure and release an SCG in NR-DC and NE-DC.","paragraph_zero_based":2236},{"literal_text_all_w_t_and_m_t":"musim-GapConfig","paragraph_zero_based":2237},{"literal_text_all_w_t_and_m_t":"Indicates the MUSIM gap configuration and controls setup/release of MUSIM gaps. In this version of the specification, the network does not configure MUSIM gap together preconfigured measurement gap for positioning. For the UE supporting musim-GapPriorityPreference, the network can configure MUSIM gap together with concurrent measurement gap. Otherwise, the network does not configure MUSIM gap together with concurrent measurement gap.","paragraph_zero_based":2238},{"literal_text_all_w_t_and_m_t":"n3c-ExtIndirectPathAddChange","paragraph_zero_based":2239},{"literal_text_all_w_t_and_m_t":"This field indicates the configuration of one or more relay UEs via N3C link. The network does not configure this field together with n3c-IndirectPathAddChange.","paragraph_zero_based":2240},{"literal_text_all_w_t_and_m_t":"nas-Container","paragraph_zero_based":2241},{"literal_text_all_w_t_and_m_t":"This field is used to transfer UE specific NAS layer information between the network and the UE. The RRC layer is transparent for this field, although it affects activation of AS  security after inter-system handover to NR. The content is defined in TS 24.501 [23].","paragraph_zero_based":2242},{"literal_text_all_w_t_and_m_t":"needForGapsConfigNR","paragraph_zero_based":2243},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurement gap requirement information of NR target bands in the RRCReconfigurationComplete and RRCResumeComplete message.","paragraph_zero_based":2244},{"literal_text_all_w_t_and_m_t":"needForGapNCSG-ConfigEUTRA","paragraph_zero_based":2245},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurement gap and NCSG requirement information of EUTRA target bands in the RRCReconfigurationComplete and RRCResumeComplete message.","paragraph_zero_based":2246},{"literal_text_all_w_t_and_m_t":"needForGapNCSG-ConfigNR","paragraph_zero_based":2247},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurement gap and NCSG requirement information of NR target bands in the RRCReconfigurationComplete and RRCResumeComplete message.","paragraph_zero_based":2248},{"literal_text_all_w_t_and_m_t":"needForInterruptionConfigNR","paragraph_zero_based":2249},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE shall report interruption requirement information of NR target bands in the RRCReconfigurationComplete and RRCResumeComplete message. The network sets this field to enabled only if the needForGapsConfigNR is configured. The network sets this field to disabled if the needForGapsConfigNR is released.","paragraph_zero_based":2250},{"literal_text_all_w_t_and_m_t":"nextHopChainingCount","paragraph_zero_based":2251},{"literal_text_all_w_t_and_m_t":"Parameter NCC: See TS 33.501 [11]","paragraph_zero_based":2252},{"literal_text_all_w_t_and_m_t":"onDemandPosSIB-RequestCtrlParam","paragraph_zero_based":2253},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE is enabled to request periodic delivery of posSIB(s) while in RRC_CONNECTED. This field can only be present when the field onDemandSIB-Request is present.","paragraph_zero_based":2254},{"literal_text_all_w_t_and_m_t":"onDemandSIB-Request","paragraph_zero_based":2255}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["cf7d2617229cdceb7a305da36a96e54475a7dfb3e1d8b1095d94af639595d9b2","ffb7105d2f8ceaab00ad0a0aad7876ef86f0fd141b2f908c8f58fac6dd352ca4","9c6474177de1840a0012e98f3c184644c5406a7ec2ceb4e137d4169436a66d69","a11a93339cb56ed2ec4867b873ecbf9debb67063c849f32e751e90935b5cdd56","93998425f1397bccd10599c61bb4fd14cb60b5d7f1ccd32ca3a2ae00b0c8f8e4","67c0faaf3d2f89733c4d2fbcce48f62c16c18003906957ff45eb9a6bc132ec23","94397730bbccbb721afd5daeccb396441b0e5977d921776e26e460bc19ea373a","b1912c2bc224d87ff2c781741c03008e36184e2a67211431e9d7036073330569","82446190582fad9560caf8e2c49bd0a6397a87310f65fb8bf6bc9e391863f461","540d8c0c06faf9c6348c9d81f165e9cdd16c34e39c057dc3ee3cbfd741a3a0fe","6d57b5ce54a7f119c1329765892fc5ae56205b62ffd33dd7c7fa78df4fa68271","cef6096c3a3e6e466a1a0c63993532c9c8d6be81286531b752535885c3a43832","00a19bbfde90373faab3a490fc2bf0ef505d06d539a19e2d97812c970484c0ac","38eba361fd10a10fa25840d819723edd10734e916519b1727df65ae013859ba4","bae6078c4fd96205d9cf8fa4a15d8757bff5c9a8d2fd4b774a588d33fc2da6c2","fc59755fcf7a52ba73ef0fed246359deb5f5759962160ae93bf4039754c5599c","d57b4f75ac055951d1e4e8055cdff4a0c229fcb7ef79f963f41da8da5df6f0d1","df0bbaeabd4a656416d68f3f40652a19cd8f8518c8d4cf938b0e0d9104b7e248","cc78f0d4ccf623388217ad4551b185a2fdff8bf08c4e3398bd3e7b84a65cefad","536b44b8575149e405c5adde8387b83522d69d54ba41fdc82194e55a5ddbc131","e3389759f856ae783596bbe88db0a8f79206ef140f1a642119d9c2bc7032f5de","196d6e3d9251764d37722f1bde61cefef7669790bb90271a45d849ae7df08a68","dac30d11ca46cf8f6ea0ff5bd64ce06217446e7d263a80d20b1221af957aceb3","6b64a2fc77ed04d5c11438e518e2652e4afafa917f8d45f0bc24db04c765ae33"],"paragraph_range_zero_based":[2232,2255],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p2232"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates that the UE is allowed to request SIB(s) on-demand while in RRC_CONNECTED according to clause 5.2.2.3.5.","paragraph_zero_based":2256},{"literal_text_all_w_t_and_m_t":"onDemandSIB-RequestProhibitTimer","paragraph_zero_based":2257},{"literal_text_all_w_t_and_m_t":"Prohibit timer for requesting SIB(s) on-demand while in RRC_CONNECTED according to clause 5.2.2.3.5. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":2258},{"literal_text_all_w_t_and_m_t":"otherConfig","paragraph_zero_based":2259},{"literal_text_all_w_t_and_m_t":"Contains configuration related to other configurations. When configured for the SCG, only fields drx-PreferenceConfig, maxBW-PreferenceConfig, maxBW-PreferenceConfigFR2-2, maxCC-PreferenceConfig, maxMIMO-LayerPreferenceConfig, maxMIMO-LayerPreferenceConfigFR2-2, minSchedulingOffsetPreferenceConfig, minSchedulingOffsetPreferenceConfigExt, rlm-RelaxationReportingConfig, bfd-RelaxationReportingConfig, btNameList, wlanNameList, sensorNameList, obtainCommonLocation, idc-AssistanceConfig, multiRx-PreferenceReportingConfigFR2, ul-TrafficInfoReportingConfig, n3c-RelayUE-InfoReportConfig, successPSCell-Config, sn-InitiatedPSCellChange and gapOccasionCancelRatioReportConfig can be included.","paragraph_zero_based":2260},{"literal_text_all_w_t_and_m_t":"radioBearerConfig","paragraph_zero_based":2261},{"literal_text_all_w_t_and_m_t":"Configuration of Radio Bearers (DRBs, SRBs, multicast MRBs) including SDAP/PDCP. In (NG)EN-DC this field may only be present if the RRCReconfiguration is transmitted over SRB3. SRB4 should not be configured if sl-L2RemoteUE-Config-r17 is configured or not released.","paragraph_zero_based":2262},{"literal_text_all_w_t_and_m_t":"radioBearerConfig2","paragraph_zero_based":2263},{"literal_text_all_w_t_and_m_t":"Configuration of Radio Bearers (DRBs, SRBs) including SDAP/PDCP. This field can only be used if the UE supports NR-DC or NE-DC.","paragraph_zero_based":2264},{"literal_text_all_w_t_and_m_t":"retainLoggedMeasurements","paragraph_zero_based":2265},{"literal_text_all_w_t_and_m_t":"If present, it indicates that the UE shall retain the logged measurements available in VarCSI-LogMeasReport upon execution of this RRCReconfiguration message including the reconfigurationWithSync.","paragraph_zero_based":2266},{"literal_text_all_w_t_and_m_t":"scg-State","paragraph_zero_based":2267},{"literal_text_all_w_t_and_m_t":"Indicates that the SCG is in deactivated state.","paragraph_zero_based":2268},{"literal_text_all_w_t_and_m_t":"This field is not used","paragraph_zero_based":2269},{"literal_text_all_w_t_and_m_t":"-in an RRCReconfiguration message received:","paragraph_zero_based":2270},{"literal_text_all_w_t_and_m_t":"-within mrdc-SecondaryCellGroup, or","paragraph_zero_based":2271},{"literal_text_all_w_t_and_m_t":"-in an E-UTRA RRCConnectionReconfiguration message, or","paragraph_zero_based":2272},{"literal_text_all_w_t_and_m_t":"-in an E-UTRA RRCConnectionResume message or","paragraph_zero_based":2273},{"literal_text_all_w_t_and_m_t":"-in an RRCReconfiguration message received via SRB3, except if the RRCReconfiguration message is included in DLInformationTransferMRDC.","paragraph_zero_based":2274},{"literal_text_all_w_t_and_m_t":"The field is absent if CPA, CPC, or subsequent CPAC is configured for the UE, or if the RRCReconfiguration message is contained in CondRRCReconfig, or PSCell is configured with tag2, or if the RRCReconfiguration message is included within an LTM-Config IE.","paragraph_zero_based":2275},{"literal_text_all_w_t_and_m_t":"sl-L2RelayUE-Config","paragraph_zero_based":2276},{"literal_text_all_w_t_and_m_t":"Contains L2 U2N relay operation related configurations used by a UE acting as or to be acting as a L2 U2N Relay UE or L2 U2U relay operation related configuration used by a UE acting as a L2 U2U Relay UE. In case of L2 U2N relay operation, the field is absent if conditionalReconfiguration is configured for CHO.","paragraph_zero_based":2277},{"literal_text_all_w_t_and_m_t":"sl-L2RemoteUE-Config","paragraph_zero_based":2278},{"literal_text_all_w_t_and_m_t":"Contains L2 U2N relay operation related configurations used by a UE acting as or to be acting as a L2 U2N Remote UE or L2 U2U relay operation related configuration used by a UE acting as a L2 U2U Remote UE. In case of L2 U2N relay operation, the field is absent if conditionalReconfiguration is configured for CHO, or if appLayerMeasConfig or SRB4 is configured/not released.","paragraph_zero_based":2279}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["cc9955f591a5ac75ab7187e7483d167d25c2ade7ad91b4b0a2111975139b3f34","662c7ed1b82d38a18c356f45d598ca4d7539ecd771ea2a3ce32704be2b48c001","277e9ebad27533e647f611d057b98362d392fab1fd19b7e5f1aa4ee970683394","c321617c99d7252c087c2442ea404e3acfd0c672d88353ff80288187217f9d79","1f44ac47b2e7c1da65fa34a6f442bc69269c26778455e104bb388d75e90fe74e","077b56d6ee8a8fd679b9de86c30397c24ce7827ded46ae24c88aeb5b3b99469b","077105c46a13c6fc1af5078f552431ff1fef3df935bdab77377cdae1bbdb752c","6210319a3382872ae8c4089713162b5ed805382e18973069eab8646de89ed31b","d7fe9a4018c659f4b9a6e46939ea587a34ea43932cc4f3a9acd1d91aaa8d54d3","d3e8c6b3329003806e3ea12c52154f5cddd3c9518829abc036a5882b3d4eab35","cc1038454145251a7e69c6755fd2eff2cb2093894eef98318a852d3551c5b66d","5aa874805e516a0d82fa90de314b5d0e640eddabd7b07d57ed5086d07fe1633e","3d7278c8dcaf6bb9ff986048dd163ab82ddb36a102ddbc1b96553cd409879735","bc845948bf1ab2ce65ef2fdb1cbf5edcb428a9eafb86d33a2a0d4ccfbc89115d","d92a6e85d2652d075720ffd21c51d87022ffd326add0aeac03788e7ee055eba7","6793afe26052e179204ca9ba2beac6ee8a8d1d055527c6847d1a96309f586022","e26d37cc0592b7cedfc62dee0dd41cc01cf1587a03538d09b575ba5c0035054e","ab4f7b7b66f764d3fc8d956077c5a8f212803d69b113a7cc237dc9804deeb68f","922c8dfbe7115afeed81ef2595c933c1ab05a8a5ef73ede45622c8112faf04e0","344282331a30e8f421c497b6483656a024a414ea9ea6fdf7d78748e01dbe89ba","26503bb60bd2668adf02cec1763e9170cf5b13936ee293c0dfac5032fe8e95e7","46a5a8ccfca4f5afa398e36cdcc00a893570db1140ba5e11a3ed51055dd3d80c","939b83ff76d64dfaa1a8dcd64611cf1911b647fec2bc00fe7a3f5b07fca9c246","e908b2498ed480fe5798ebc75fdf16f1d770cc33dc524761840fdeca8a25c1ff"],"paragraph_range_zero_based":[2256,2279],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p2256"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"secondaryCellGroup","paragraph_zero_based":2280},{"literal_text_all_w_t_and_m_t":"Configuration of secondary cell group ((NG)EN-DC or NR-DC).","paragraph_zero_based":2281},{"literal_text_all_w_t_and_m_t":"sk-Counter","paragraph_zero_based":2282},{"literal_text_all_w_t_and_m_t":"A counter used upon initial configuration of S-KgNB or S-KeNB, as well as upon refresh of S-KgNB or S-KeNB. This field is always included either upon initial configuration of an NR SCG or upon configuration of the first RB with keyToUse set to secondary, whichever happens first. This field is absent if there is neither any NR SCG nor any RB with keyToUse set to secondary, or if the RRCReconfiguration message is contained in condRRCReconfig for subsequent CPAC.","paragraph_zero_based":2283},{"literal_text_all_w_t_and_m_t":"sl-ConfigDedicatedEUTRA-Info","paragraph_zero_based":2284},{"literal_text_all_w_t_and_m_t":"This field includes the E-UTRA RRCConnectionReconfiguration as specified in TS 36.331 [10]. In this version of the specification, the E-UTRA RRCConnectionReconfiguration can only includes sidelink related fields for V2X sidelink communication, i.e. sl-V2X-ConfigDedicated, sl-V2X-SPS-Config, measConfig and/or otherConfig.","paragraph_zero_based":2285},{"literal_text_all_w_t_and_m_t":"sl-ConfigDedicatedNR","paragraph_zero_based":2286},{"literal_text_all_w_t_and_m_t":"This field is used to provide the dedicated configurations for NR sidelink communication/discovery/positioning.","paragraph_zero_based":2287},{"literal_text_all_w_t_and_m_t":"sl-TimeOffsetEUTRA","paragraph_zero_based":2288},{"literal_text_all_w_t_and_m_t":"This field indicates the possible time offset to (de)activation of V2X sidelink transmission after receiving DCI format 3_1 used for scheduling V2X sidelink communication. Value ms0dpt75 corresponds to 0.75ms, ms1 corresponds to 1ms and so on. The network includes this field only when sl-ConfigDedicatedEUTRA is configured.","paragraph_zero_based":2289},{"literal_text_all_w_t_and_m_t":"srs-PosResourceSetAggBW-CombinationList","paragraph_zero_based":2290},{"literal_text_all_w_t_and_m_t":"This field indicates the SRS resource sets across two or three carriers which are linked for SRS bandwidth aggregation in RRC_CONNECTED state as defined in clause 6.2.1.4 of TS 38.214 [19].","paragraph_zero_based":2291},{"literal_text_all_w_t_and_m_t":"targetCellSMTC-SCG","paragraph_zero_based":2292},{"literal_text_all_w_t_and_m_t":"The SSB periodicity/offset/duration configuration of target cell for NR PSCell addition and SN change. When UE receives this field, UE applies the configuration based on the timing reference of NR PCell for PSCell addition and PSCell change for the case of no reconfiguration with sync of MCG, and UE applies the configuration based on the timing reference of target NR PCell for the case of reconfiguration with sync of MCG. If both this field and the smtc in secondaryCellGroup -> SpCellConfig -> reconfigurationWithSync are absent, the UE uses the SMTC in the measObjectNR having the same SSB frequency and subcarrier spacing, as configured before the reception of the RRC message.","paragraph_zero_based":2293},{"literal_text_all_w_t_and_m_t":"t316","paragraph_zero_based":2294},{"literal_text_all_w_t_and_m_t":"Indicates the value for timer T316 as described in clause 7.1. Value ms50 corresponds to 50 ms, value ms100 corresponds to 100 ms and so on. This field can be configured only if the UE is configured with split SRB1 or SRB3.","paragraph_zero_based":2295},{"literal_text_all_w_t_and_m_t":"ue-TxTEG-RequestUL-TDOA-Config","paragraph_zero_based":2296},{"literal_text_all_w_t_and_m_t":"Configures the periodicity of UE reporting for the association between Tx TEG and SRS Positioning resources. When configured with oneShot UE reports the association only one time. When configured with periodicReporting UE reports the association periodically and the periodicReporting indicates the periodicity. Value ms160 corresponds to 160ms, value ms320 corresponds to 320ms and so on.","paragraph_zero_based":2297},{"literal_text_all_w_t_and_m_t":"ul-GapFR2-Config","paragraph_zero_based":2298},{"literal_text_all_w_t_and_m_t":"Indicates the FR2 UL gap configuration to UE. In EN-DC and NGEN-DC, the SN decides and configures the FR2 UL gap pattern. In NE-DC, the MN decides and configures the FR2 UL gap pattern. In NR-DC without FR2-FR2 band combination, the network entity which is configured with FR2 serving cell(s) decides and configures the FR2 UL gap pattern.","paragraph_zero_based":2299},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2300},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":2301},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":2302},{"literal_text_all_w_t_and_m_t":"nonHO","paragraph_zero_based":2303}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["59b6821342214836540ba32fa15c578579ce0266e9600fa52f3f6c34399132ae","01aceaa8011d161f2051ca5a4cbbd1dced8e1084f8ac7b4f39449f76987cb3ff","efe5d1b2b3616222751e0d22c3592e138caaad3834f817f5f134109a45bcbb49","097ccb7dfcb1d4c06f15bb74451c38804f6e9d911ef8d7fe810bfbd6cef813ba","298ecfdd44ea74c3fbb6e7adffde21acf00eecb11c7a0e935c51804ba23124e0","ea74288c9fb612f23437425607860519bc560a01a42a6d02825b50520ed6a474","a7e3ba26f98560afb69f0fb117ecec086350a1c199194cdd90d102490db2e76a","0f3bb37a24f3838e967e55abec568bc7195baf980a2c8b7d4d10f1b89fe05f79","7664bb6028ac786f5ec564af96aac59a43820077fd5df735bb51f2cfaf23ef6b","e5ef0d347b7651e541230f7bbe570997301bdf45dec9fe755dd153932669b4dc","28bbca9579f89209247525c6012dc3c7e8a99d4c368e06c3051679224add6ecc","abe9189d72c69a1ddec36e66ceff32bc853cd8eb4748ab60a13b82b77b7741b3","62728996ac8b11686d9d4bdffa28cb65c2ee2bfa94c762e5d3a334100bf1bc41","6ca862ec0c54f4d07e3e2a3e62aba12efe095a143b04321fb88284872911f9c7","183ee59f3fe80b6ab0013f29b792c667958ed5494d1f5eba203f3a98d4f1a676","604e35f2ccae5ffa2f8617b7dadf39bf16450b6662ee8e627bc6a48544193755","ceec8e4b21dc0db70ef9a745a22be30fd2ebe4ba2d7899a0c7540a3911a3c03b","2e030ab03e2e3204328c49689cc6c9f73ab65499922094b5ae1f5a204a4a8335","a25012148b906af3588beca00ca31dae794175c7142552cf4f3b49c0a9098268","deb70ca44f1d53f0ab5927ad9a746ed7d9d77edf2fd8675c4ce07c1ebe9fa450","308cad7414d52a1961eea5ce5d41993f996a798b434843fd0d6cb71dc04c5e35","1db2a5ab4fb8656d39b9fcb644e00e2aa61c646c2a479c6d2fe40ea7e0bd1752","442b3eb9ec5695ea30c0ac5811e34049ef7403f2ec8538c9b14e2e71de5bfb36","3c6df22d19a04db3925c9ad48086b539b1a8dcbb9e2aa463961aed3a025f4da8"],"paragraph_range_zero_based":[2280,2303],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p2280"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The field is absent in case of reconfiguration with sync within NR or to NR; otherwise it is optionally present, need N.","paragraph_zero_based":2304},{"literal_text_all_w_t_and_m_t":"securityNASC","paragraph_zero_based":2305},{"literal_text_all_w_t_and_m_t":"This field is mandatory present in case of inter system handover. Otherwise the field is optionally present, need N.","paragraph_zero_based":2306},{"literal_text_all_w_t_and_m_t":"MasterKeyChange","paragraph_zero_based":2307},{"literal_text_all_w_t_and_m_t":"This field is mandatory present in case masterCellGroup includes ReconfigurationWithSync and RadioBearerConfig includes SecurityConfig with SecurityAlgorithmConfig, indicating a change of the AS security algorithms associated to the master key. If ReconfigurationWithSync is included for other cases, this field is optionally present, need N. If ReconfigurationWithSync is part of an RRCReconfiguration message within an LTM-Config IE associated with the MCG, the field is absent. Otherwise the field is absent.","paragraph_zero_based":2308},{"literal_text_all_w_t_and_m_t":"FullConfig","paragraph_zero_based":2309},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in case of inter-system handover from E-UTRA/EPC to NR. It is optionally present, Need N, during a reconfiguration with sync which is not related to an LTM cell switch or subsequent CPAC, and also in first reconfiguration after reestablishment; or for intra-system handover from E-UTRA/5GC to NR. It is absent otherwise.","paragraph_zero_based":2310},{"literal_text_all_w_t_and_m_t":"SCG","paragraph_zero_based":2311},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in:","paragraph_zero_based":2312},{"literal_text_all_w_t_and_m_t":"-an RRCReconfiguration message contained in an RRCResume message (or in an RRCConnectionResume message, see TS 36.331 [10]),","paragraph_zero_based":2313},{"literal_text_all_w_t_and_m_t":"-an RRCReconfiguration message contained in an RRCConnectionReconfiguration message, see TS 36.331 [10], which is contained in DLInformationTransferMRDC transmitted on SRB3 (as a response to ULInformationTransferMRDC including an MCGFailureInformation).","paragraph_zero_based":2314},{"literal_text_all_w_t_and_m_t":"The field is optional present, Need M, in:","paragraph_zero_based":2315},{"literal_text_all_w_t_and_m_t":"-an RRCReconfiguration message transmitted on SRB3,","paragraph_zero_based":2316},{"literal_text_all_w_t_and_m_t":"-an RRCReconfiguration message contained in another RRCReconfiguration message (or in an RRCConnectionReconfiguration message, see TS 36.331 [10]) transmitted on SRB1","paragraph_zero_based":2317},{"literal_text_all_w_t_and_m_t":"-an RRCReconfiguration message contained in another RRCReconfiguration message which is contained in DLInformationTransferMRDC transmitted on SRB3 (as a response to ULInformationTransferMRDC including an MCGFailureInformation).","paragraph_zero_based":2318},{"literal_text_all_w_t_and_m_t":"Otherwise, the field is absent.","paragraph_zero_based":2319},{"literal_text_all_w_t_and_m_t":"PagingRelay","paragraph_zero_based":2320},{"literal_text_all_w_t_and_m_t":"For L2 U2N Relay UE, the field is optionally present, Need N. Otherwise, it is absent.","paragraph_zero_based":2321},{"literal_text_all_w_t_and_m_t":"Sync","paragraph_zero_based":2322},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need N, if reconfigurationWithSync is included in the RRCReconfiguration message. It is absent otherwise.","paragraph_zero_based":2323},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2324},{"literal_text_all_w_t_and_m_t":"<Text Omitted>","paragraph_zero_based":2325},{"literal_text_all_w_t_and_m_t":"–UEAssistanceInformation","paragraph_zero_based":2326},{"literal_text_all_w_t_and_m_t":"The UEAssistanceInformation message is used for the indication of UE assistance information to the network.","paragraph_zero_based":2327}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["cd67bcf94de6488a30133211961d704942652e950fcb23b610c218bd62bbd82a","cff95fbe02072a21c9c429132f39f246f50d79afd41380de360e719301f9742d","46618b2f016316f0df0b2b5aaed415f4365f2155029500a3e715fb4171042528","72d31d9545665df07569a5fdb6d5d4da96882b0dcc59fedc6a340d7214129149","8240574f6dc49b81cea678cf968e97f1899dae5bbdcf90ad14fb9de8f10b4bfd","1603c5f04431ad6d9042fb3632c6eff0f7c96cfad2d2a7f95cf129c15cf941c2","a24d55ac9a8240a4c59f84aae2776d1c4b65cc1fc5a4cdc3cef2b3498ade4a3f","ace15d82b022c649f80a33743a5712286f963470f6471c296f9e0aebcd957497","d801027f035e6b10c4b8f8956a60736f4c28f1f9c794f1f60b58cb2eeb91b5d0","49fb074bbbadcfc88339cd342ab3936a43428f143c46b79b50050661353d14f0","2277a8fe167e056e31f8567041c901fbdf4daa6c14e6753f5e112d8599f3924e","8b22a7d7b52c15a47badce19cf35ce1be2ab6fc38867d910e07854519c2516c2","80e7ec9e0c6b76de4f4f849d41c550d1d952e05debc07207f54865b9ba96be09","8ddef6a5ee0f77a6a361bb4ed8cb16caa61d4c27a0faef1539e70b73af0fc88b","addeff4d63a14188c1dd72254e64a8a1c1b500c9bff6b8fe78e634e9b503a160","1536ca5c717560df96ccda77af81363bf1ee9202ccb84a9452da67097e5f0393","fe87b9304a5d8ff8b7c19b8b93f072a0a89452a5533782a4732b1381dffe87f6","d5325d08e347c5c8f5770fe714263b851a5e4b06179b5804e35720e83f677229","4fe3b7d8479b93fc2c246f6529a0ecb1185bfae9d1b62845fecf89190f164098","b486697e680bb49202299ae103be604fc2a1789218dfbc71ccc99c0751bd2c36","6e410eadad331d080f38cd3ab47baf117aa1fb6b2d9229f76c12b19333b8f3ac","9f7cd5526fe2085d45191ad5c8db85166607a7a2993e15881ba8e9cb75d48ce6","f1558cb3b44236264d1cd9979f237ad5d8cb35c0b04ea9c3f1e8f126a5b2effa","65439e1e8a98409f90f68fb83bc075bc2328aa94a29fe74bef7c2637a36d40a3"],"paragraph_range_zero_based":[2304,2327],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p2304"}
