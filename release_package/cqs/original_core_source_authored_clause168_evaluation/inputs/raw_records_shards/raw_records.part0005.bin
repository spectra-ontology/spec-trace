{"fields":{"filename":"R2-2407505.zip::R2-2407505 38.306 CR for barring exemption for emergency call.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"B","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"Rel-18","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-17(Release 17)Rel-18(Release 18)Rel-19(Release 19) Rel-20(Release 20)","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"Reason for change:","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"The barring exemption for emergency call was introduced in Rel-18, but the related UE capability had not been added in TS 38.306. ","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"The following new optional feature without UE capability signaling is added:","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":" “Barring exemption for emergency call","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"It is optional for UE to support the barring exemption for emergency call, as specified in TS 38.331 [9] and in TS 38.304 [21].”","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"Impact analysis","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"Impacted functionality:","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"a4bf078bb80c4fba0988dff958f3cd858f254214eebc5003084d06a93c38d9d4","original_member_sha256":"997b48ad979fc20ca8333c9b348238c599d44fc790fc15113919d476c7c42728","paragraph_ElementTree_utf8_XML_sha256":["53852d7fa408fdf035f24abfed3b43ddad70efc7b7f0422e639889126d78bdbd","236e3f9ab050304881c77f70bd18658ae78fb4bf19d52b0e76f2a27a85c88cc4","9f3be735a8f12e48b1100084e277c3a433c7db8cecf98d39522abb9bf360952c","fb676eb99526d1b7a357600bba4855123dfde822bd6168d2741226848a541fac","4590853b60f9bfed1dcc41e17b23beeb5245c7474a09e05a932938170ba98f9e","772fe42a4c9cd4e407bda3f173236123decacbbff3951f2a6877a3b4fd7e88f6","78fec0530776b7262cdcd1731985c6e1308ec0d22ffee1ddac5ea89e6e1b88d3","b469941d77e28dc8f9655b1aaf5d004fa600f04d10bd592b1a975f5158743e64","4c5a6fa285f1230fc3aedb06c7c0954488b0646790bb6b85e28bee8a7df7ae99","e534dfb7cfd2873d25d393989f6cc330c3ba59ee6f627748c1833da89e9d8140","48654e6245a9d023ec9bca0caf1a77b6908b75c2f7a5397ee0978bde428c9739","cdbd4b49f21af4e014455f56d5b3b3949134ca6cb983617090c8818eb4ba6e95","282e1f57ad13ee46b28e0645218e468916ea2660ea3d540b83e2194693b49918","782adf585e3072647fa0995df05467c4186f6866255ed646defd479d797e4c30","badbff329385055b003fd35451bbe6bd368230cf50133ec50df3c74cf62ff297","6bc708a7cd82acb287bd5b5dd3bd573