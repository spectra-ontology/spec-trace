{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates P0 value for SL pathloss based open loop power control for SL PRS transmission in dedicated SL PRS resource pool.","paragraph_zero_based":47472},{"literal_text_all_w_t_and_m_t":"sl-AlphaSL-PRS","paragraph_zero_based":47473},{"literal_text_all_w_t_and_m_t":"Indicates alpha value for downlink pathloss based power control for PSCCH/PSSCH when dl-P0-PSSCH-PSCCH is configured. When the field is absent the UE applies the value 1.","paragraph_zero_based":47474},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47475},{"literal_text_all_w_t_and_m_t":"–SL-PSBCH-Config","paragraph_zero_based":47476},{"literal_text_all_w_t_and_m_t":"The IE SL-PSBCH-Config indicates PSBCH transmission parameters on each sidelink bandwidth part.","paragraph_zero_based":47477},{"literal_text_all_w_t_and_m_t":"SL-PSBCH-Config information element","paragraph_zero_based":47478},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":47479},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-PSBCH-CONFIG-START","paragraph_zero_based":47480},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47481},{"literal_text_all_w_t_and_m_t":"SL-PSBCH-Config-r16 ::= SEQUENCE {","paragraph_zero_based":47482},{"literal_text_all_w_t_and_m_t":"    dl-P0-PSBCH-r16         INTEGER (-16..15)                                                                   OPTIONAL,    -- Need M","paragraph_zero_based":47483},{"literal_text_all_w_t_and_m_t":"    dl-Alpha-PSBCH-r16      ENUMERATED {alpha0, alpha04, alpha05, alpha06, alpha07, alpha08, alpha09, alpha1}   OPTIONAL,    -- Need M","paragraph_zero_based":47484},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":47485},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":47486},{"literal_text_all_w_t_and_m_t":"    dl-P0-PSBCH-r17         INTEGER (-202..24)                                                                  OPTIONAL     -- Need M","paragraph_zero_based":47487},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":47488},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":47489},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47490},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-PSBCH-CONFIG-STOP","paragraph_zero_based":47491},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":47492},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47493},{"literal_text_all_w_t_and_m_t":"SL-PSBCH-Config field descriptions","paragraph_zero_based":47494},{"literal_text_all_w_t_and_m_t":"dl-Alpha-PSBCH","paragraph_zero_based":47495}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["0c021146137d6383bf971e601f481d49da0dba45c928604c06b31b9fd86cc9de","6aff9c8c4917bd864d66c519637b57016f9df68f3935ec5d8736c045a6eed2ce","3899a00c5e773d81a79d6e3f809d559f24b5e4157d275d52fae22054b986e0f9","c86a3cebacb07ed65bb88781b98fff1f5cf27449b097dbbc289da68316c7b752","6784c338fed2f3e9a6b10b6a42b97b3941bf8c856bc6392d1f97d5a0f87b3364","901b435c63cf6f46a6d95e8499ff8782e76133fc5a17652b50ffb16f91b342df","a1c5183987821a505e815be372c1365645a8caf23db92aa05fb784a84aa951cb","dfde1462218650be5320cf9791fcd689265a68396915ba5524d817eb7508e054","31b511117a0cf15d311a60079888cd4091a2534199f947b62840d86981d69829","91a5d8cf447660653f7b2871eb11e6b46c329b457c81f4db3a0fbce69b7ca8e3","8628d4d83027f6b3c85de286922b19655c009e81c9ddf45fda4323ac3949390a","7755e69c8f060b4437e25b1e44db5c6d4f2e02943c8b13357a219e5f1f073247","752cee36668c7d057e54952f7e53c6bd495911b64595d05658d8716152faf4da","b3d408599e64fe4df6baea663e43664711677786147c0e57b5a17c6b6632ef2d","5251612bf6aa122fc059add88d5689edf6d3200218eef79d78104cc8a08f210d","312f031602d8d449da5d7be13a9e2ce97d8f5c4e0ed73a145a2e3e9d9e2e91c5","0750260cc1cebd6e7d35b641a7ad0a54262258e9147b4cfbf4204e318ea86d61","c7e0bb6daea8484405fec5876f842541d1cbd92ec575b79332b295dc7e178691","60871321d7135af8a75575e4c4e37ed460db721035bbdaefcfefb44e80777d1f","d14688bb127056cb806081e6d2bf7dab3d79d7ce3691c474c0c026195dfd5e22","f55a863c1dcad9974e178e87520c7426b63ac07f5c9264ea7b3b93fd157ce89e","402f1adb51f87bb6c291a8efc373d8ba0fbf1905e211e209c2545be998f4a4fe","19308f984558bfc991bae6d9cf32fb0dc41ab73ed4cce24b427ea2ae30d85dbf","c7a6e14dd327829992f3087d28733751190d859015f2c291e748a6482524ebbb"],"paragraph_range_zero_based":[47472,47495],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p47472"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates alpha value for DL pathloss based power control for PSBCH. When the field is not configured the UE applies the value 1.","paragraph_zero_based":47496},{"literal_text_all_w_t_and_m_t":"dl-P0-PSBCH","paragraph_zero_based":47497},{"literal_text_all_w_t_and_m_t":"Indicates P0 value for DL pathloss based power control for PSBCH. If not configured, DL pathloss based power control is disabled for PSBCH. When dl-P0-PSBCH-r17 is configured, the UE ignores dl-P0-PSBCH-r16.","paragraph_zero_based":47498},{"literal_text_all_w_t_and_m_t":"A Remote UE which is out of coverage, considers downlink pathloss based power control is disabled for PSBCH when dl-P0-PSBCH is configured.","paragraph_zero_based":47499},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47500},{"literal_text_all_w_t_and_m_t":"–SL-PSSCH-TxConfigList","paragraph_zero_based":47501},{"literal_text_all_w_t_and_m_t":"The IE SL-PSSCH-TxConfigList indicates PSSCH transmission parameters. When lower layers select parameters from the range indicated in IE SL-PSSCH-TxConfigList, the UE considers both configurations in IE SL-PSSCH-TxConfigList and the CBR-dependent configurations represented in IE SL-CBR-PriorityTxConfigList. Only one IE SL-PSSCH-TxConfig is provided per SL-TypeTxSync.","paragraph_zero_based":47502},{"literal_text_all_w_t_and_m_t":"SL-PSSCH-TxConfigList information element","paragraph_zero_based":47503},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":47504},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-PSSCH-TXCONFIGLIST-START","paragraph_zero_based":47505},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47506},{"literal_text_all_w_t_and_m_t":"SL-PSSCH-TxConfigList-r16 ::=    SEQUENCE (SIZE (1..maxPSSCH-TxConfig-r16)) OF SL-PSSCH-TxConfig-r16","paragraph_zero_based":47507},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47508},{"literal_text_all_w_t_and_m_t":"SL-PSSCH-TxConfig-r16 ::=        SEQUENCE {","paragraph_zero_based":47509},{"literal_text_all_w_t_and_m_t":"    sl-TypeTxSync-r16                SL-TypeTxSync-r16                                   OPTIONAL,    -- Need R","paragraph_zero_based":47510},{"literal_text_all_w_t_and_m_t":"    sl-ThresUE-Speed-r16             ENUMERATED {kmph60, kmph80, kmph100, kmph120,","paragraph_zero_based":47511},{"literal_text_all_w_t_and_m_t":"                                                kmph140, kmph160, kmph180, kmph200},","paragraph_zero_based":47512},{"literal_text_all_w_t_and_m_t":"    sl-ParametersAboveThres-r16      SL-PSSCH-TxParameters-r16,","paragraph_zero_based":47513},{"literal_text_all_w_t_and_m_t":"    sl-ParametersBelowThres-r16      SL-PSSCH-TxParameters-r16,","paragraph_zero_based":47514},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":47515},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":47516},{"literal_text_all_w_t_and_m_t":"    sl-ParametersAboveThres-v1650    SL-MinMaxMCS-List-r16                               OPTIONAL,    -- Need R","paragraph_zero_based":47517},{"literal_text_all_w_t_and_m_t":"    sl-ParametersBelowThres-v1650    SL-MinMaxMCS-List-r16                               OPTIONAL     -- Need R","paragraph_zero_based":47518},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":47519}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["dacb85b91ff84ad3ab9ed2ccbdb821e68606e3a3e64a1810f0471cfbb05f16e5","0ff0ed3cebb0136a1c0e0c1891089098749b4814cd9c8266b30ebf580f98b65c","6973bcb7441d3883add1255ee