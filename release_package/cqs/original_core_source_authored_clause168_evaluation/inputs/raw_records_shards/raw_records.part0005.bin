2},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4193},{"literal_text_all_w_t_and_m_t":"CSI-LoggedMeasurementConfig field descriptions","paragraph_zero_based":4194},{"literal_text_all_w_t_and_m_t":"a1-Threshold","paragraph_zero_based":4195},{"literal_text_all_w_t_and_m_t":"Threshold value associated to the selected trigger quantity to be used in measurement logging triggering condition for event a1.","paragraph_zero_based":4196},{"literal_text_all_w_t_and_m_t":"a2-Threshold","paragraph_zero_based":4197},{"literal_text_all_w_t_and_m_t":"Threshold value associated to the selected trigger quantity to be used in measurement logging triggering condition for event a2.","paragraph_zero_based":4198},{"literal_text_all_w_t_and_m_t":"csi-LoggedMeasurementConfigId","paragraph_zero_based":4199}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["53a42cb366c061e8112adf06b1f5d1cb994ca41d46702bd9cad474507ecf290f","51acbf2161d97966cef80ce6b2ddef8ddc52f6a6303703288d9882cc76159aa5","40e1d7d49c3a1608facc324d0c44fd8de90f7133a367be360aae46f9625f10ac","528c0967edf23f36e5b22eb50d1691c99512ca68b0ce67fee61f50fef49026af","1b7f0db43ca5251d4a65eba6c4212c8ec82e8003b3d8137a23d5d5c2af44cf91","d5b6f0e205b17a43af3df33fbd01551d55c1b983bee4b9d33fa8824653196fe2","7f71a1eafcf38b2662db7f39908dc537ef1c467eed34db9e6376df9a6f457d1d","4a4fed284353601263cf687e42b9cb655b3784d358251256a487dd372fdff6fc","a3dac848058a7bbb494027434ba42d0b85ff7d4e882ad53568687c3476071eba","96e440dbf29be13b5512bcfa340baa97d80583b3677905cd21fba53602fd231c","009682419aa86ed3ea5e6daa4ca9e3918f984ffb659328403ff32a0911a7493e","54c9ec0687447137866eb14c2b5c706905a64a6ac5bcb1c9871f78cf8bb6b2d4","47fefd426e6ef5b9972877d92a7977f2f322352b25fe85aef37414a34d1ba5d7","482dbaa5a6ec4689c3c44b7fddf91f2f473a67f113cd8962ff89c8fa9b1ee7c4","b15887b94b94b41608c170c5914cb81c701b8a90b77d04ef6f6dd5d5486d8116","1e0358e7804b6e56b2051a0816533d683b59d75253564a4613f40e6313d9d205","b1db0bc2ade178a8c0e204651125f73f6ab508098952860a57ae3c19c9ac9e8d","c6628a9c01e8d6ba5dc0b1a02dad2590802443aa288f560c0f0f86331486ca84","72cc6d6d2b62a378954ca57a34c9a4879adf78be538b53fec7f2666fbda0c0a7","f99804953718bda6bf6d8da0643fb692a612275f3c9cf789227aeaee3ca6eb4e","1e6aba8c21f5c2c66c5fded2c35502b60fac8e116f17196689606f53c944da3f","c4834b601013ea832ea6f7f6d6ea0a12c89801c5a974f527117f805ed4d1f972","b379629c27dbe1a3eb55a1870e57ec73f20fc8c692e899d22b70c80130e5509f","16bd20762a03fb8813b83c9ec60ddac736273e79dd157029a83556b810d703a9"],"paragraph_range_zero_based":[4176,4199],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx:p4176"}
{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field indicates the instance of CSI-LoggedMeasurementConfig.","paragraph_zero_based":4200},{"literal_text_all_w_t_and_m_t":"csi-LoggedMeasurementEventTriggerConfig","paragraph_zero_based":4201},{"literal_text_all_w_t_and_m_t":"This field is used to configure the UE with event-triggered measurement logging. If this field is not included, the UE starts the measurement logging according to csi-LoggedResourceConfig upon reception.","paragraph_zero_based":4202},{"literal_text_all_w_t_and_m_t":"csi-LoggedResourceConfig","paragraph_zero_based":4203},{"literal_text_all_w_t_and_m_t":"Resources in which the UE performs channel measurement whose associated measurement results are logged by the UE. The csi-LoggedResourceConfig indicated here contains only NZP-CSI-RS resources and/or SSB resources.","paragraph_zero_based":4204},{"literal_text_all_w_t_and_m_t":"eventId","paragraph_zero_based":4205},{"literal_text_all_w_t_and_m_t":"Indicates an event used for measurement logging. If this field is set to eventA1, the UE starts performing logging of measurements when the entering condition as specified in 5.5.4.2 is met and stops logging when the corresponding leaving condition as specified in 5.5.4.2 is met. If this field is set to eventA2, the UE starts performing logging of measurements when the entering condition as specified in 5.5.4.3 is met and stops logging when the corresponding leaving condition as specified in 5.5.4.3 is met.","paragraph_zero_based":4206},{"literal_text_all_w_t_and_m_t":"hysteresis","paragraph_zero_based":4207},{"literal_text_all_w_t_and_m_t":"Hysteresis when evaluating the entering/leaving conditions for an event for CSI measurement logging.","paragraph_zero_based":4208},{"literal_text_all_w_t_and_m_t":"loggingPeriodicity","paragraph_zero_based":4209},{"literal_text_all_w_t_and_m_t":"The periodicity that the UE shall use for the logging of the CSI measurements. The loggingPeriodicity is given as a multiple of the periodicity of the resources indicated by csi-LoggedResourceConfig. If loggingPeriodicity is included and set to 'n2', the UE performs the logging of CSI measurements for every 2nd occasion of the resources, if it is set to 'n3', the UE performs logging of CSI measurements for every 3rd occasion of the resources, and so on. If loggingPeriodicity is not included, the UE performs the logging of CSI measurements according to the periodicity of the resources indicated by csi-LoggedResourceConfig, i.e. for every occasion of the resources.","paragraph_zero_based":4210},{"literal_text_all_w_t_and_m_t":"timeToTrigger","paragraph_zero_based":4211},{"literal_text_all_w_t_and_m_t":"Time during which specific criteria for the event needs to be met in order to trigger logging of CSI measurements.","paragraph_zero_based":4212},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4213},{"literal_text_all_w_t_and_m_t":"–CSI-LoggedMeasurementConfigId","paragraph_zero_based":4214},{"literal_text_all_w_t_and_m_t":"The IE CSI-LoggedMeasurementConfigId is used to identify a CSI-LoggedMeasurementConfig.","paragraph_zero_based":4215},{"literal_text_all_w_t_and_m_t":"CSI-LoggedMeasurementConfigId information element","paragraph_zero_based":4216},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":4217},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-LOGGEDMEASUREMENTCONFIGID-START","paragraph_zero_based":4218},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4219},{"literal_text_all_w_t_and_m_t":"CSI-LoggedMeasurementConfigId-r19 ::=            INTEGER (0..maxNrofLoggedMeasurementConfigurations-1-r19)","paragraph_zero_based":4220},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4221},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-LOGGEDMEASUREMENTCONFIGID-STOP","paragraph_zero_based":4222},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":4223}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["26bdcfe70558a9e4a3dee50951586a30a985142a0e3447be4dd8976913e13435","7e7fc0c467362162b475e7605436439e0f86915e275cf4149074f810b354ddc5","ed1a07a480b11912903e9a4bd9bbc59ef9fcba6bf5c461e66d3f64f510278978","4649889bad12983554e7bfdd7ed2bbe544f8ced891f433532b9c0c26883b6f4e","6253a4dad4ddd3634461202b6b9be7fe5bbe6ccb117d7888e24cec62a66a7349","71b5f14dc6883ee5eb2c3fdd3d2ba2cc280c7d146f16b03b2ee72309b0d02474","294fb44143b48c66a43e28d30b59970b2b8ad90941e12dfbd60992bf8a92f851","97cdf02a0988f42e5f170be67b5cdd3a4dbb77b57bc78a2df039f391b1aeee9e","d6cf7e032d65b8283aab2ed4caba63f14586903f09c89fd4e62501a5cf2f2398","0bd1d9231eae8f7ef94ca8629ec4c76e3e302301369b700c5ffe86036d8200c0","37a2e7c8ed6983fd3fcf7b3aeaaa80ee93db22cae588f68cd499f17e7f878646","41a7bbf2068eaacfe2d6c95a606fa5f360a0b545c677108ed78e855a346b55a5","7f97764ee098f17dd78eee0f8f5071cde01c6e0f7cdf0907ed15b2a1deb4fc02","031c8a56bc8334fbb858ec14a97772a74c90597a39319503ddbbf1eb69bae7b1","ab4931b44239e9207d798a909f2b62874121c2c55aafc44a3944333d77a81775","813ba515fe04419f88121c1a7f90c178337e1cf11e339683fbf2313134c2f0d1","fe0c54739e20acf99cc44826935c6e54c4a9763e71a4b17ed3a8fb0bfa0d2b4b","8ee655b7ba1c535c8029c114d4a1c1a8e3952a78766d33f927a2ee2d9efade4e","62079b702bcd519e4c382260729cbea5c80759cfc4d19030d4467356eeb70667","c13cb5afb9e58bd4826a6a395537ad8acef84c26c28e3b41d0f2abe6fab0bf84","c38e56e3758cb4767fd6196bd687a2794f2962151b13d48ac6bd648d3a3ae31c","58860affa3ff6b868fdb00e47c41505c4ef456151b97367c7e4cf150aef63d2d","2b2db5bb92d821df101e0e78e1985d8e8136c7758502a095b69012539d6f17a4","7268dec6bb6df