{"fields":{"filename":"R2-2410826.zip::R2-2410826 MAC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>stop the inactivePosSRS-TimeAlignmentTimer.","paragraph_zero_based":192},{"literal_text_all_w_t_and_m_t":"1>when the indication is received from upper layer for starting the inactivePosSRS-TimeAlignmentTimer:","paragraph_zero_based":193},{"literal_text_all_w_t_and_m_t":"2>start or restart the inactivePosSRS-TimeAlignmentTimer.","paragraph_zero_based":194},{"literal_text_all_w_t_and_m_t":"1>when instruction from the upper layer has been received for starting the cg-SDT-TimeAlignmentTimer:","paragraph_zero_based":195},{"literal_text_all_w_t_and_m_t":"2>start the cg-SDT-TimeAlignmentTimer.","paragraph_zero_based":196},{"literal_text_all_w_t_and_m_t":"1>when instruction from the upper layer has been received for stopping the cg-SDT-TimeAlignmentTimer:","paragraph_zero_based":197},{"literal_text_all_w_t_and_m_t":"2>consider the cg-SDT-TimeAlignmentTimer as expired.","paragraph_zero_based":198},{"literal_text_all_w_t_and_m_t":"1>when the indication is received from upper layer for starting the inactivePosSRS-ValidityAreaTAT:","paragraph_zero_based":199},{"literal_text_all_w_t_and_m_t":"2>start or restart the inactivePosSRS-ValidityAreaTAT.","paragraph_zero_based":200},{"literal_text_all_w_t_and_m_t":"1>when the indication is received from upper layer for stopping the inactivePosSRS-ValidityAreaTAT:","paragraph_zero_based":201},{"literal_text_all_w_t_and_m_t":"2>stop the inactivePosSRS-ValidityAreaTAT.","paragraph_zero_based":202},{"literal_text_all_w_t_and_m_t":"1>when instruction from the upper layer has been received for starting the TimeAlignmentTimer associated with PTAG:","paragraph_zero_based":203},{"literal_text_all_w_t_and_m_t":"2>start the TimeAlignmentTimer associated with the indicated PTAG.","paragraph_zero_based":204},{"literal_text_all_w_t_and_m_t":"1>when an LTM Cell Switch Command MAC CE is received and the Timing Advance Command is not set as FFF:","paragraph_zero_based":205},{"literal_text_all_w_t_and_m_t":"2>apply the Timing Advance Command for the PTAG as specified in clause 6.1.3.75;","paragraph_zero_based":206},{"literal_text_all_w_t_and_m_t":"2>start or restart the timeAlignmentTimer associated with the PTAG as specified in clause 6.1.3.75.","paragraph_zero_based":207},{"literal_text_all_w_t_and_m_t":"1>when an LTM Cell Switch Command MAC CE is received, and the Timing Advance Command is set as FFF, and the UE has successfully measured the Timing Advance as in clause 5.18.35:","paragraph_zero_based":208},{"literal_text_all_w_t_and_m_t":"2>apply the measured Timing Advance for the PTAG;","paragraph_zero_based":209},{"literal_text_all_w_t_and_m_t":"2>start or restart the timeAlignmentTimer associated with the PTAG.","paragraph_zero_based":210},{"literal_text_all_w_t_and_m_t":"1>when a timeAlignmentTimer expires:","paragraph_zero_based":211},{"literal_text_all_w_t_and_m_t":"2>if the timeAlignmentTimer is associated with a PTAG and the SpCell is not configured with two PTAGs; or","paragraph_zero_based":212},{"literal_text_all_w_t_and_m_t":"2>if the timeAlignmentTimer is associated with a PTAG, the SpCell is configured with two PTAGs, and the timeAlignmentTimer associated with the other PTAG is not running:","paragraph_zero_based":213},{"literal_text_all_w_t_and_m_t":"3>flush all HARQ buffers for all Serving Cells;","paragraph_zero_based":214},{"literal_text_all_w_t_and_m_t":"3>notify RRC to release PUCCH for all Serving Cells, if configured;","paragraph_zero_based":215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"475d0bd37e37b8aa508fe73eee1a8fb22927094fb103de8fe516608b9cb06d0a","original_member_sha256":"b6e2f6b9b9a49c6e03bb802fbf01fa6ee28f44f95781fdac844951b2e4b263a7","paragraph_ElementTree_utf8_XML_sha256":["e9eef0fb80cff9