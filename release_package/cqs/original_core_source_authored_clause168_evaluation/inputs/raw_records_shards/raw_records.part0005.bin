{"fields":{"filename":"R2-2409117.zip::R2-2409117_38331_CR5080_ Correction on field description of reportOnLeave for U2N Relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"carrierFreq","paragraph_zero_based":336},{"literal_text_all_w_t_and_m_t":"Indicates the EUTRA frequency for which cellIndividualOffset is applicable. If the field is not configured, the EUTRA frequency indicated by carrierFreq within the MeasObjectEUTRA of the measID associated with this ReportConfigInterRAT applies.","paragraph_zero_based":337},{"literal_text_all_w_t_and_m_t":"cellIndividualOffset","paragraph_zero_based":338},{"literal_text_all_w_t_and_m_t":"Cell individual offsets applicable to a specific measurement event. If this field is present, the UE, for the same cell, shall ignore the cell individual offset configured within the MeasObjectEUTRA of the measID associated with this ReportConfigInterRAT.","paragraph_zero_based":339},{"literal_text_all_w_t_and_m_t":"physCellId","paragraph_zero_based":340},{"literal_text_all_w_t_and_m_t":"Physical cell identity of a E-UTRAN cell in the cell list.","paragraph_zero_based":341},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":342},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":343},{"literal_text_all_w_t_and_m_t":"PeriodicalReportConfigInterRAT field descriptions","paragraph_zero_based":344},{"literal_text_all_w_t_and_m_t":"maxReportCells","paragraph_zero_based":345},{"literal_text_all_w_t_and_m_t":"Max number of non-serving cells/candidate L2 U2N Relay UEs to include in the measurement report.","paragraph_zero_based":346},{"literal_text_all_w_t_and_m_t":"reportAmount","paragraph_zero_based":347},{"literal_text_all_w_t_and_m_t":"Number of measurement reports applicable for eventTriggered as well as for periodical report types","paragraph_zero_based":348},{"literal_text_all_w_t_and_m_t":"reportQuantity, reportQuantityUTRA-FDD","paragraph_zero_based":349},{"literal_text_all_w_t_and_m_t":"The cell measurement quantities to be included in the measurement report. If the field reportQuantityUTRA-FDD is present, the UE shall ignore the value(s) provided in reportQuantity.","paragraph_zero_based":350},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":351},{"literal_text_all_w_t_and_m_t":"CellIndividualOffsetList-EUTRA field descriptions","paragraph_zero_based":352},{"literal_text_all_w_t_and_m_t":"carrierFreq","paragraph_zero_based":353},{"literal_text_all_w_t_and_m_t":"Indicates the EUTRA frequency for which cellIndividualOffset is applicable. If the field is not configured, the EUTRA frequency indicated by carrierFreq within the MeasObjectEUTRA of the measID associated with this ReportConfigInterRAT applies.","paragraph_zero_based":354},{"literal_text_all_w_t_and_m_t":"cellIndividualOffset","paragraph_zero_based":355},{"literal_text_all_w_t_and_m_t":"Cell individual offsets applicable to a specific measurement event. If this field is present, the UE, for the same cell, shall ignore the cell individual offset configured within the MeasObjectEUTRA of the measID associated with this ReportConfigInterRAT.","paragraph_zero_based":356},{"literal_text_all_w_t_and_m_t":"physCellId","paragraph_zero_based":357},{"literal_text_all_w_t_and_m_t":"Physical cell identity of a E-UTRAN cell in the cell list.","paragraph_zero_based":358},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2e39d9409247d976bab1fc84affd6a30d9bbb347618ef63729a36e72e7264366","original_member_sha256":"a2327727a6de58d4596bd1e3d23e659a6f53dcfb34890e37f139cde46fb2442a","paragraph_ElementTree_utf8_XML_sha256":["4886ea34028095b7c8bfc485657a03792b223b9873d62b4bbfae67d916da263c","388ed0b2c113bd2937a0966d5043b3558ecdd0eca25a508f8cdb3456d64eba8b","139ac0bc7140ee586ffe7808e746a680eae5d52404