{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-StandardizedPQI","paragraph_zero_based":47616},{"literal_text_all_w_t_and_m_t":"Indicate the PQI for standardized PQI.","paragraph_zero_based":47617},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47618},{"literal_text_all_w_t_and_m_t":"–SL-QuantityConfig","paragraph_zero_based":47619},{"literal_text_all_w_t_and_m_t":"The IE SL-QuantityConfig specifies the layer 3 filtering coefficients for NR SL RSRP measurement for a destination.","paragraph_zero_based":47620},{"literal_text_all_w_t_and_m_t":"SL-QuantityConfig information element","paragraph_zero_based":47621},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":47622},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-QUANTITYCONFIG-START","paragraph_zero_based":47623},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47624},{"literal_text_all_w_t_and_m_t":"SL-QuantityConfig-r16 ::=               SEQUENCE {","paragraph_zero_based":47625},{"literal_text_all_w_t_and_m_t":"    sl-FilterCoefficientDMRS-r16            FilterCoefficient                             DEFAULT fc4,","paragraph_zero_based":47626},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":47627},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":47628},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47629},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-QuantityConfig-STOP","paragraph_zero_based":47630},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":47631},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47632},{"literal_text_all_w_t_and_m_t":"SL-QuantityConfig field descriptions","paragraph_zero_based":47633},{"literal_text_all_w_t_and_m_t":"sl-FilterCoefficientDMRS","paragraph_zero_based":47634},{"literal_text_all_w_t_and_m_t":"DMRS based L3 filter configur