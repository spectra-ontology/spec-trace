{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ntn-LocationBasedMeasTrigger-EMC","paragraph_zero_based":4248},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE supports location-based measurement trigger in RRC_CONNECTED in earth moving cell.","paragraph_zero_based":4249},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4250},{"literal_text_all_w_t_and_m_t":"ntn-MO-CB-Msg3-EDT-UP","paragraph_zero_based":4251},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE supports MO contention-based Msg3 EDT for User Plane CIoT EPS optimizations.","paragraph_zero_based":4252},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4253},{"literal_text_all_w_t_and_m_t":"ntn-OffsetTimingEnh","paragraph_zero_based":4254},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports timing relationship enhancement using Differential Koffset as specified in TS 36.321 [6] and TS 36.213 [23].","paragraph_zero_based":4255},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4256},{"literal_text_all_w_t_and_m_t":"ntn-OverriddenHarqDisableMultiTB-CE-ModeB","paragraph_zero_based":4257},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE supports DCI-based HARQ feedback disabling for downlink transmission by overriding the RRC configuration when the UE is operating in CE mode B and when configured with ce-PDSCH-MultiTB-Config.","paragraph_zero_based":4258},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4259},{"literal_text_all_w_t_and_m_t":"ntn-OverriddenHarqDisableSingleTB-CE-ModeB","paragraph_zero_based":4260},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE supports DCI-based HARQ feedback disabling for downlink transmission by overriding the RRC configuration when the UE is operating in CE mode B.","paragraph_zero_based":4261},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4262},{"literal_text_all_w_t_and_m_t":"ntn-PUR-TimerDelay","paragraph_zero_based":4263},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports delaying the start of the pur-ResponseWindowTimer for NTN, see TS 36.321 [6].","paragraph_zero_based":4264},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4265},{"literal_text_all_w_t_and_m_t":"ntn-Redirection","paragraph_zero_based":4266},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports redirection from a terrestrial network to a non-terrestrial network.","paragraph_zero_based":4267},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4268},{"literal_text_all_w_t_and_m_t":"ntn-RRC-HarqDisableMultiTB-CE-ModeA","paragraph_zero_based":4269},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE supports HARQ feedback disabling per HARQ process for downlink transmission by RRC configuration when the UE is operating in CE mode A and when configured with ce-PDSCH-MultiTB-Config.","paragraph_zero_based":4270},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4271}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["3d826981f9118970e56c67dc80ae8eb75f53bc5cbffd0e9c7c3a020aa19f8a0d","de92819e791db47c4af39660935931e692d8c72f4a37a68369084f63457e5597","7237206f079a372429c096c1a60271c53738d29e897164963282ff6067781bde","10a323d825061fbf0fe9f1637fb282d4d8ec37a7fefb24b26604857215805c61","66be0f021a33b62cc4d36c21abec65b19c1284bec808fac57b4186b97824a21a","ec6e5e4e9e2a7260ab6a9fdee1865d7d4dc63e8f836b64a6537622e151bce751","e575579cd002db689afcc48dd22df463c5d62e3845ca51227878e6a95efa6ac3","127bf6538ba8c5ff4617d8a4342cd2d