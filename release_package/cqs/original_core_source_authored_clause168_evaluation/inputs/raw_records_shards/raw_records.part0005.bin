{"fields":{"filename":"R2-2505772.zip::R2-2505772_MHSLRelayCap_CR_v0_Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether NR L2 multihop sidelink relay UE operation is supported by the UE. A UE supporting this feature shall also indicate support of relayUE-Operation-L2-r17 and remoteUE-MH-Operation-L2-r19.","paragraph_zero_based":192},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":193},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":194},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":195},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":196},{"literal_text_all_w_t_and_m_t":"relayUE-U2U-OperationL2-r18","paragraph_zero_based":197},{"literal_text_all_w_t_and_m_t":"Indicates whether L2 U2U sidelink relay UE operation is supported by the UE. A UE supporting this feature shall also indicate support of supportedBandCombinationListSL-U2U-RelayDiscovery-r18.","paragraph_zero_based":198},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":199},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":200},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":201},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":202},{"literal_text_all_w_t_and_m_t":"remoteUE-IndirectPathAddChangeToIdleInactiveRelay-r18","paragraph_zero_based":203},{"literal_text_all_w_t_and_m_t":"Indicates whether L2 multi-path remote UE supports indirect path addition or indirect path change with target relay UE in RRC_IDLE or RRC_INACTIVE state. A UE supporting this feature shall also indicate support of multipathRemoteUE-PC5L2-r18 or multipathRemoteUE-N3C-r18.","paragraph_zero_based":204},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":205},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":206},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":207},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":208},{"literal_text_all_w_t_and_m_t":"remoteUE-MH-Operation-L2-r19","paragraph_zero_based":209},{"literal_text_all_w_t_and_m_t":"Indicates whether NR L2 multihop sidelink remote UE operation is supported by the UE. A UE supporting this feature shall also indicate support of remoteUE-Operation-L2-r17.","paragraph_zero_based":210},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":211},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":212},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":213},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":214},{"literal_text_all_w_t_and_m_t":"remoteUE-Operation-L2-r17","paragraph_zero_based":215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3d0669bebb61232fe20acea50a76ee807988cbd3d6f41a5e37816ee6179e9413","original_member_sha256":"c7379de7097f64dafbf008e1c06b57228e6acf168e72c816abdff7ae0ffde250","paragraph_ElementTree_utf8_XML_sha256":["9a1971c558b9564abfae6afdf41d8e8c0be491bbb09a6e36d0707e61bbac8338","7458602d32c387ef57d1b6f7f50059e490fe6ed11ac4fc187789c6f231f79559","479ef1fc3929025e090036ec65777068a91f25253777408d2ae881412179c99e","383285bcac447bfa36969b6dfda99e3831c0f1f35dfc62c9ea2c0b8fd255e177","4103ccb5076fe6af118515f520646c8a0aa48828d72240ad549adab5419aeeeb","e56bf4578d1c76b0b078e5b7e221d9c13b1d79c4b8d04567d0743d0ce3c7cbfb","ddb2c3a9e978dc1d666eacbdf0e44b11d668631a766218d8a8a2ecd0d261c6af","044f3d8587bfb9556f4197a6968a7d0f57c971a611935ef9b3241882f12b2f0a","354ddfe43ddd89f39cd3d34089e9df1dbc25d3d7cde3420e08715895fb5f8ac1","6addc40e13330363723d0a7aeb41abddca6231961308743b189156639242cd6f","6bc96270aaaa72b21dfc58f362c2206f87ec2225133f884228bea906b88fbce9","16a0f285a9f8cb0780a89d99e7a223e8dfb179ce1db911481b22d700cc6073aa","c1450cdb768826e204a509fe5becaffffbd6707b1b94a60e6dca16ec7f64b64a","a24ee4d686300364651f0ff9d2f8e495f54a8077f1e780ab82637c2dd26cbc1b","69a287f67d11ad74215d0f6