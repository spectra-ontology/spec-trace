{"fields":{"filename":"R2-2408215.zip::R2-2408215 Correction on UE capability of supporting NavIC in A-GNSS positioning (R18).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"If the target device supports GLONASS and GNSS-UTC-Model assistance, it shall support Model-3.","paragraph_zero_based":216},{"literal_text_all_w_t_and_m_t":"If the target device supports BDS and GNSS-UTC-Model assistance, it shall support Model-5.","paragraph_zero_based":217},{"literal_text_all_w_t_and_m_t":"If the target device supports NavIC and GNSS-UTC-Model assistance, it shall support Model-2.","paragraph_zero_based":218},{"literal_text_all_w_t_and_m_t":"If this field is absent, the target device supports the mandatory (native) utc-Model choice only as listed above for the GNSS indicated by GNSSID.","paragraph_zero_based":219},{"literal_text_all_w_t_and_m_t":" ","paragraph_zero_based":220},{"literal_text_all_w_t_and_m_t":"END OF CHANGE","paragraph_zero_based":221},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":222}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"b1f4f45546def2664ca2ee7667b8fe23ed4539cfd8edba6b6f93bf09915e1a61","original_member_sha256":"daacb728659b141652fb097c21d93fe1c637dfd6fe5095d8417a2039f13bf59d","paragraph_ElementTree_utf8_XML_sha256":["2bb4bb59c62d8e288dd10f8c2c73788a8f3ecb041eca9474e6c21116f1ead19e","02237062c073a1627a6be61d50cc24425993a9497d73953f0cc2020d6182e1f7","e9f4940e4db53ffead67031c72c6ff21d59cf7693c017cffab9ffa319ea894ee","bbc2477dd92ee7983f371e4d540e8ad616dbbe5540adbd0fcb0d56bdc7d58581","3b977387136dca508c725c82b9e436191131a95c4ffc6e854ea3be7e04f5e054","56b180409669cbacfcd4632c2ccb3832f504dd63286dbfbbd658220a077fcf60","4b2a45c66e0b2f712e68c2d9bc357400e7131d6f366731131cc047cf2c6b9bee"],"paragraph_range_zero_based":[216,222],"projection":"All w:t and m:t includin