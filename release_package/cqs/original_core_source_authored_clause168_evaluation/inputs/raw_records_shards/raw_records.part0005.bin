{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RLC-CHANNELID-START","paragraph_zero_based":48432},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48433},{"literal_text_all_w_t_and_m_t":"SL-RLC-ChannelID-r17 ::=    INTEGER (1..maxSL-LCID-r16)","paragraph_zero_based":48434},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48435},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RLC-CHANNELID-STOP","paragraph_zero_based":48436},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":48437},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48438},{"literal_text_all_w_t_and_m_t":"–SL-RLC-Config","paragraph_zero_based":48439},{"literal_text_all_w_t_and_m_t":"The IE SL-RLC-Config is used to specify the RLC configuration of sidelink DRB. RLC AM configuration is only applicable to the unicast NR sidelink communication.","paragraph_zero_based":48440},{"literal_text_all_w_t_and_m_t":"SL-RLC-Config information element","paragraph_zero_based":48441},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":48442},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RLC-CONFIG-START","paragraph_zero_based":48443},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48444},{"literal_text_all_w_t_and_m_t":"SL-RLC-Config-r16 ::=                        CHOICE {","paragraph_zero_based":48445},{"literal_text_all_w_t_and_m_t":"    sl-AM-RLC-r16                                SEQUENCE {","paragraph_zero_based":48446},{"literal_text_all_w_t_and_m_t":"        sl-SN-FieldLengthAM-r16                      SN-FieldLengthAM                               OPTIONAL,   -- Cond SLRBSetup","paragraph_zero_based":48447},{"literal_text_all_w_t_and_m_t":"        sl-T-PollRetransmit-r16                      T-PollRetransmit,","paragraph_zero_based":48448},{"literal_text_all_w_t_and_m_t":"        sl-PollPDU-r16                                   PollPDU,","paragraph_zero_based":48449},{"literal_text_all_w_t_and_m_t":"        sl-PollByte-r16                                  PollByte,","paragraph_zero_based":48450},{"literal_text_all_w_t_and_m_t":"        sl-MaxRetxThreshold-r16                          ENUMERATED { t1, t2, t3, t4, t6, t8, t16, t32 },","paragraph_zero_based":48451},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":48452},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":48453},{"literal_text_all_w_t_and_m_t":"    sl-UM-RLC-r16                                SEQUENCE {","paragraph_zero_based":48454},{"literal_text_all_w_t_and_m_t":"        sl-SN-FieldLengthUM-r16                      SN-FieldLengthUM                               OPTIONAL,    -- Cond SLRBSetup","paragraph_zero_based":48455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["b8ff7e42aa9ae9c552349620683573471302f40b19c2ec66cc706ef81ecd9ab2","b99541a8f52cdbf7840d144fb1cb78911ce26af4b7d716c4cd3d65b29e31d32e","02bf477b81f101655a8191462c999377716ed2eb3efec2fce61ec5653413abf5","9bd33a550abc9858bf9eb9f147feb3c34d2d1f100c39625262aa908ee0ed58d7","b2a9ab45e21cadc54b5853c8789d4303f292e318f631f089f35ca232a740dda4","9634b819de9b76d78da6edee603a150a34fbc87fa42f09245ab39ebb4ef800a0","3f982a1dbe6536206e7fc39bc863a6e7bc22af1dd628d35293898bf632aafacf","f2d302a3ca2574865f4457e1dc476efc4e5280eea116e69e8908015ac672363b","bd77b11b92d8b5d60b3b36cf87af548df810c8090f4b14db938ece23d269585c","ca1112a27dd4f7f853ce91f32a3da2526f1333e88642133ec40c92fc85a6cd84","5f3073b12b2ba22086da30807951ab33b6a37b959f0754ef1a67338761788dbf","e7bff3a684ee314a670fbdeed5ba8f1a3072ea22c7e82e710b67d7905