d_m_t":"UE","paragraph_zero_based":233},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":234},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":235},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":236},{"literal_text_all_w_t_and_m_t":"maxMIMO-LayerPreference-r16, maxMIMO-LayerPreference-r17","paragraph_zero_based":237},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports providing its preference of a cell group on the maximum number of MIMO layers for power saving in RRC_CONNECTED, as specified in TS 38.331 [9].","paragraph_zero_based":238},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"07548170a78db80f735ccee09196c0bd7319249104911a4435888a81fa42ebc8","original_member_sha256":"4e1426c6554f6ae9bf90d915c14ab4f606ef4e51023d4fc251844e3b54784cc2","paragraph_ElementTree_utf8_XML_sha256":["0bcdd301815dc19992a1d5cb6e3497cc28edb576ddafc1466c4c352e7a4d49ef","bc27a0edaca896aba5bd830a0744b3197f7a40b7196300a739dc6d404afae011","0a22a03229acab0ca9aeb703dc256332606befc26f45086e14dafc3dd081e41e","4eff76d9130fba49a5d63559afc7805c6c8983dc3f0a52ddc4d172a0648c929b","096b86a2f2a4db4c5875c06cdee112ffa09e367b949648d0cc6699321a6cf51e","44e156a0ae94df46a05ddebe2d9601730d020d8b20e00e18a8d75fae75304f37","c8521e2ddc9550a329e2a27130e86582b0304ec3f25d955560ee84eb2973419f","f5ddaaee59ff909bafad15dabc921f96c2b25da76673ccbbe9782ecb081abd39","b2cccd81c2bdab02d1beb30d882be858de4b453127091c1d8cf58cfad7016b44","41b7fe09a632aa837088ced3a47b30c9f7e9b7d15d2e1b0aa8722027c4074a18","48a576971e6be5181a56c97f97e9f8651b91d79ffebc458b5a7000f349f1b8de","15e9d5a5ddaca3678edd23a5e18f1bdb1a2efb8a950d4ab0f63935e4c8e998fb","86ccfb4d78606bf25332091136570c20edc4c31aecf6431ebfcff33a443a5492","2d4d3f35f1bdbb9500e3d401c21b3dd17b4ecc036bf16cebcd2a298c9ca59d19","5e7c735955b279e76531f2abc4f5de0c59bf7e75aee604a85