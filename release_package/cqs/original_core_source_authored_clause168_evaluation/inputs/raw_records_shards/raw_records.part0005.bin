all_w_t_and_m_t":"Components","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"0. Waveform, modulation, subcarrier spacings, and CP","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"0-1","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"CP-OFDM waveform for DL and UL","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"1) CP-OFDM for DL","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"2) CP -OFDM for UL","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"abf11d476ccb1587c08fc50ad8cf7430b8fce456680c2264c98057397f1240ef","original_member_sha256":"e33c48f2a9a55345abc1b2b94edf844cc8aed534a8b393c4ffbc91820ad41bfc","paragraph_ElementTree_utf8_XML_sha256":["eecfcbe3159b36183f4ef5c978d9dd83ed43d6f2ea2c7ede33f68801ae953b9c","a38bc77f77af07129cf8043a3d9c3762ef2f14ae542812fe45eb9bc49e66523b","73f7324fd42593b35ad978a50f0846bbe56141b53133c901e13aaa3ecbe278ca","ed897b6e9e49dd3be2c35561c2e490ffd600ffa1c59681a6fb9c863bd04bf4cf","8aa7c64e3117859e7455f54a8a98c726a6e122593cd46550c0e582c33b9bb92c","5eecac799f3c67e7149490d0e40fb5fa32b48b8f6b1b3fd20b8f54d5e67e90ed","353f6dc29b9061ef193273b3ac1c6d50bf39d4ef1564f0d18ddfc702035fdd12","1b3d34a4436b3e0c0ffc291c109894d3c3579b0549ebc781a18589701e8199bb","7e1cb8c6e4747624dc0f87598ae77423f7c924b0a660df6f9c9182d2883d367a","17620e7ec9de21e0630cd3e0a5d03dece9ffaf9ab06566a4f7f09a480dd5d5cf","3d371ffeea77ef1b9d285ef876aa8d9889659dc41ec6eeedbacddd8d251338b4","c59ae84f914978c3a2ea1c5eb9f64961fbd655ee4a5614aa97f553188daffb75","79b4efda1d63100e71b8bd502dd23286265467ef2e11e1b9e29c49149111c209","885ee2b44ecf1c60c48eb8a9d16a9b0f0d5807742021ef333ca5d2002ad05c19","8a0b13c8075ed36e1b9897c7faa3fcf25e335df531d1e8dfc3bf8b436b101290","7987ad3db3b3e9b14649248b350e5508b4aae03a18053ba3713e2f8cbbfc8bea","68a6bf23b79ad221370c4a5b3304b64eef3b04415ef9a2cb905192bc9e603534","78bf34e6696da4685d65