{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports RRC_INACTIVE.","paragraph_zero_based":3792},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":3793},{"literal_text_all_w_t_and_m_t":"incMonEUTRA","paragraph_zero_based":3794},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports increased number of E-UTRA carrier monitoring in RRC_IDLE and RRC_CONNECTED, as specified in TS 36.133 [16].","paragraph_zero_based":3795},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":3796},{"literal_text_all_w_t_and_m_t":"incMonUTRA","paragraph_zero_based":3797},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports increased number of UTRA carrier monitoring in RRC_IDLE and RRC_CONNECTED, as specified in TS 36.133 [16].","paragraph_zero_based":3798},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":3799},{"literal_text_all_w_t_and_m_t":"inDeviceCoexInd","paragraph_zero_based":3800},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports in-device coexistence indication as well as autonomous denial functionality.","paragraph_zero_based":3801},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3802},{"literal_text_all_w_t_and_m_t":"inDeviceCoexInd-ENDC","paragraph_zero_based":3803},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports in-device coexistence indication for (NG)EN-DC operation. This field can be included only if inDeviceCoexInd is included. The UE supports inDeviceCoexInd-ENDC in the same duplexing modes as it supports inDeviceCoexInd.","paragraph_zero_based":3804},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3805},{"literal_text_all_w_t_and_m_t":"inDeviceCoexInd-HardwareSharingInd","paragraph_zero_based":3806},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports indicating hardware sharing problems when sending the InDeviceCoexIndication, as well as omitting the TDM assistance information. A UE that supports hardware sharing indication shall also indicate support of LAA operation.","paragraph_zero_based":3807},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3808},{"literal_text_all_w_t_and_m_t":"inDeviceCoexInd-UL-CA","paragraph_zero_based":3809},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports UL CA related in-device coexistence indication. This field can be included only if inDeviceCoexInd is included. The UE supports inDeviceCoexInd-UL-CA in the same duplexing modes as it supports inDeviceCoexInd.","paragraph_zero_based":3810},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3811},{"literal_text_all_w_t_and_m_t":"interBandTDD-CA-WithDifferentConfig","paragraph_zero_based":3812},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports inter-band TDD carrier aggregation with different UL/DL configuration combinations. The first bit indicates UE supports the configuration combination of SCell DL subframes are a subset of PCell and PSCell by SIB1 configuration and the configuration combination of SCell DL subframes are a superset of PCell and PSCell by SIB1 configuration; the second bit indicates UE supports the configuration combination of SCell DL subframes are neither superset nor subset of PCell and PSCell by SIB1 configuration. This field is included only if UE supports inter-band TDD carrier aggregation.","paragraph_zero_based":3813},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3814},{"literal_text_all_w_t_and_m_t":"interBandPowerSharingAsyncDAPS","paragraph_zero_based":3815}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["d26c458121ce9b4127393f9d7556a47d993ff4fbf817f70f7cda7dd82caa9d03","2dad76af187934353f48a92bca9f58c13552689160f9dc3bb482bdc0218ca311","30b0a074bcc87b2bf0271ee1d9427b10770eb548f28133c52b724d9dbb0ec166","8ed36f79ad3c7be8bfa628efc531218d9fefec68928ba44e8cf6ec999520f8bd","3448c78fca34ba4129b75dd628f6d45500f1ec5808bb91d856d7d7bee1045263","81ddb2089944f0de5fe8d1732c6af68020123ac4c3a14ca962d61f254194f536","22e29da22e72ebeb5e1a27fb2ecbae2d0c1db7cc838eb8b5ffb109a091231591","3b5147d344940bfc60c8e0fc89ebb0c65057a41c35e2e9c180de9d4ba161e0cf","5627d2b78ea6c5797e2fc75854d46238928bd1371e8c2c3dd3908c79731f9319","792f817b78702a50e984365640a7f68999dfd9547a1298941f8debc5c68b7e58","4a1aed6081c3581875cf7d5b6f56b1bca0e40140cb3eae829e97664138acc78a","1a7aee2b984fa6af24be9723f57a9a9794c71766978ac671b3890f7a243ea77e","9ca9e1587ba4df81c9d3a707867cfd19c3d10611d73f3fd5a2bb36d4a69c468c","4bc07b7c372d5f03ecf3c5ff5f1c437543e10d543807e3df862e01e66f80cd99","6b4490f7085844d48c0315f5bc63f4cb055ffe01e9095d9fbe2f397af4d2f5d5","65d8d3adfb5540274ff00034e06bea4374e481a6a3bc4c4b88e90ea536abb3c9","cb1e6298242a3d379c05eec5fb5cef5e7cedcce45b7f4f43a79f1571813d87cd","65dc6ba2a65317414648bb2b139d5b97b06ce3c514946ef9324d9a2cc9de43cd","fd357cdbf72801ab405caf81390e6905cafab0ca491bf84f209022f166d2f94e","27b0813e35f0c2da7eaa3635aff41e7c56aef8ab6bd6df836ea99b41d0acffa2","b78143cfb9ab0b27ec9dd10e717572dd575674f1c5a7e9ac34189ff07d3d257f","25f681e0ce60aafc1263a5768cabe6f84b6848fc129a0c437697863dff2ba28c","57cc4e39431539f8945db1d6923446afff94207b60d65d92f9e7b0beb2b46645","513655f071c0153ddd0fd4b2c18a38d1dcd738a179e3201138dfd7715900ad9c"],"paragraph_range_zero_based":[3792,3815],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p3792"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports power sharing for asynchronous inter-band DAPS handovers.","paragraph_zero_based":3816},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3817},{"literal_text_all_w_t_and_m_t":"interBandPowerSharingSyncDAPS","paragraph_zero_based":3818},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports power sharing for synchronous inter-band DAPS handovers.","paragraph_zero_based":3819},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3820},{"literal_text_all_w_t_and_m_t":"interferenceMeasRestriction","paragraph_zero_based":3821},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports interference measurement restriction.","paragraph_zero_based":3822},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3823},{"literal_text_all_w_t_and_m_t":"interFreqAsyncDAPS","paragraph_zero_based":3824},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports asynchronous DAPS handover in source PCell and inter-frequency target PCell. ","paragraph_zero_based":3825},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3826},{"literal_text_all_w_t_and_m_t":"interFreqBandList","paragraph_zero_based":3827},{"literal_text_all_w_t_and_m_t":"One entry corresponding to each supported EUTRA band listed in the same order as in supportedBandListEUTRA.","paragraph_zero_based":3828},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3829},{"literal_text_all_w_t_and_m_t":"interFreqDAPS","paragraph_zero_based":3830},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports DAPS handover in source PCell and inter-frequency target PCell, i.e. support of simultaneous DL reception of PDCCH and PDSCH from source and target cell. For a BC, the capability applies to every carrier pair for source and target. A UE indicating this capability shall also support synchronous DAPS handover, and single UL transmission for inter-frequency DAPS handover.","paragraph_zero_based":3831},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3832},{"literal_text_all_w_t_and_m_t":"interFreqMultiUL-TransmissionDAPS","paragraph_zero_based":3833},{"literal_text_all_w_t_and_m_t":"Indicates that the UE supports simultaneous UL transmission in source PCell and inter-frequency target PCell.","paragraph_zero_based":3834},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3835},{"literal_text_all_w_t_and_m_t":"interFreqNeedForGaps","paragraph_zero_based":3836},{"literal_text_all_w_t_and_m_t":"Indicates need for measurement gaps when operating on the EUTRA band given by the entry in bandListEUTRA or on the E-UTRA band combination given by the entry in bandCombinationListEUTRA and measuring on the EUTRA band given by the entry in interFreqBandList.","paragraph_zero_based":3837},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3838},{"literal_text_all_w_t_and_m_t":"interFreqProximityIndication","paragraph_zero_based":3839}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["da5d4f042a88813c09b86faa129c5abcc81a3f99c2626b5979c19bc306186b52","a671faabbc7df4701699b7dd88e7af67d8249bcd386785c7620f061a222efbfd","9eb1630ff77806242fc561a00d9e07b5933af2dbba9d5d9ec1629b2f6e39d0aa","99767a0dd3da9d21871554788f280b7ef2e17e81c097f93a313be7ecdb68d2b6","7afc8806e117f50b5f31151e3188eb32ca1ca3abeabc6d55adf9156a605a3465","f569e33560bd054b658bd03d683bfb75c36de812ac22788b0a255029b9d2f6b1","5ed10df58c501687e380108e6681ee30d5cae7041a881f2a769313d92176647b","0bcb24747fd32f2114820353a77740ace0d2e1c40f1f7a3f290909d3f5dfeb5e","4f8cb8b78e1cd2634981a2aac4df27e3c9ddb140cda4ccd0f19885d5052676ef","59f984a9450f315de4f1d3e65d18159acd54790fe17371fe706bebc2dc3ac76b","3cd0706f690329bed53619575c59d140a5d512d5daf10396728958dde1c86d67","2594ee5449bc858b94969270c56bb196dd7e988e90175dd6f461f2e2cd85b974","6301ff735c7796e227a408c0929f7d9d861d73c1a1d65308429d95686220cbec","d102022329f54d0e7a376f05d1295279da5596c56271987ec2babb017ae77786","425809452b0c9924831360279472bd31956eddbac98970fd3ef232523e8d3510","d91a093cdb9bbbf75756a79ddd0dd497314cec7d9b08ce9cfd812262cd1f7455","168055ec5b7ca4cf9d8aa1793d8286e37f31ed25d8520ba183a90c40b8580c5d","2ffbe45e410bde69da9fe192e7ea61796ff8106529944ef3090f5b4337ef6129","ffff344c2fafacc278dd36565c3e96d42e1092fc2e32c9f55c39296ce683bde9","770ea09091e221b6919770c7292ce2bfcb94c72e25ca11ca6527d56e921e70f7","640001a47077ac9705261730f9982a5c771b620746a0365ff99f65bf5744a39c","4de27b24a4f3336b73ab064bc5dec05f0c8fd536e8515d0fe1c78001810b18e2","c6d801cf14895ae67e9178cc492bfc61d971055e96acc6abde1d56fd1ef1e786","03616c7b309229594d9838576ca98efad01f2beba4c8a9051c69a7ddf48b2aed"],"paragraph_range_zero_based":[3816,3839],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p3816"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports proximity indication for inter-frequency E-UTRAN CSG member cells.","paragraph_zero_based":3840},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3841},{"literal_text_all_w_t_and_m_t":"interFreqRSTD-Measurement","paragraph_zero_based":3842},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports inter-frequency RSTD measurements for OTDOA positioning, as specified in TS 36.355 [54].","paragraph_zero_based":3843},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3844},{"literal_text_all_w_t_and_m_t":"interFreqSI-AcquisitionForHO","paragraph_zero_based":3845},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports, upon configuration of si-RequestForHO by the network, acquisition and reporting of relevant information using autonomous gaps by reading the SI from a neighbouring inter-frequency cell.","paragraph_zero_based":3846},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3847},{"literal_text_all_w_t_and_m_t":"interRAT-BandList","paragraph_zero_based":3848},{"literal_text_all_w_t_and_m_t":"One entry corresponding to each supported band of another RAT listed in the same order as in the interRAT-Parameters. The NR bands reported in SupportedBandListNR are excluded from this list.","paragraph_zero_based":3849},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3850},{"literal_text_all_w_t_and_m_t":"interRAT-BandListNR-EN-DC","paragraph_zero_based":3851},{"literal_text_all_w_t_and_m_t":"One entry corresponding to each supported NR band listed in the same order as in the supportedBandListEN-DC-r15. If both interRAT-BandListNR-EN-DC and interRAT-BandListNR-SA are included, the UE shall set the same interRAT-NeedForGapsNR value and same interRAT-NeedForInterruptionNR value (if any) for the same NR band.","paragraph_zero_based":3852},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3853},{"literal_text_all_w_t_and_m_t":"interRAT-BandListNR-SA","paragraph_zero_based":3854},{"literal_text_all_w_t_and_m_t":"One entry corresponding to each supported NR band listed in the same order as in the supportedBandListNR-SA. If both interRAT-BandListNR-EN-DC and interRAT-BandListNR-SA are included, the UE shall set the same interRAT-NeedForGapsNR value and same interRAT-NeedForInterruptionNR value (if any) for the same NR band.","paragraph_zero_based":3855},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3856},{"literal_text_all_w_t_and_m_t":"interRAT-enhancementNR","paragraph_zero_based":3857},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports enhanced inter-RAT NR measurement requirements to support high speed up to 500 km/h as specified in TS 36.133 [16], when EN-DC is not configured and when EN-DC is configured.","paragraph_zero_based":3858},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3859},{"literal_text_all_w_t_and_m_t":"interRAT-NeedForGaps","paragraph_zero_based":3860},{"literal_text_all_w_t_and_m_t":"Indicates need for DL measurement gaps when operating on the EUTRA band given by the entry in bandListEUTRA or on the E-UTRA band combination given by the entry in bandCombinationListEUTRA and measuring on the inter-RAT band given by the entry in the interRAT-BandList.","paragraph_zero_based":3861},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3862},{"literal_text_all_w_t_and_m_t":"interRAT-NeedForGapsNR","paragraph_zero_based":3863}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["425c3d08295a0b7995dee892c3a952a1df7d717928855f29887c9495c6f8523b","0d595355a7b75e8ebd25e8f02d753adee4a3007c823c63d5a442ddd0d514a16e","38fd0b5976a012d3b545918a9c2183d3a60f8b3dc9eaab96cf2e0791164bbc6a","dde3fe401c5b71813ec1a4529638db496d75820b54aafb60c0246442e741ef1c","b48593e00d353c67207a22ddbf6cd5481032741f1f7cec6f2ccde47245701830","492884c0ffa6082452e94e0e2cd701b67835fd56776e272816a366531c0b3cf0","e8a6dd7e55ec268f21a57b9406b46fd9faf5bbd763cebb66b421d0c0ccec87d5","917d582b6a86179f08a7241ef59f82e387c04dc8277ac8c2abcf63f34c58e181","b4da469c5bb0dbb32256f235a57ef0955b4c951ba8db397810f4753091cfa6c7","434a89f20083d1a9a7182c01d56f0e597712233bccf7a6b1510adbf836967757","a711c58b860607b48323a381b151bfe798e0766ee266623625b68f6e95aad044","7bee35d3777e0bbea90fa17ecb5199e7a0f4862a3c9806853e9980a342d41baa","df489171de7273557e7ff22dabb94c5aa5706587461d2d19bac5427d4a8bf2fa","3ad1b4150578a20c85e42589f6ca596c2a782189114d264bbd911aa92e5f025a","3f82291e7cdfe0665391ff6d3c683e31f2d0e4645d64693c86784e79f760a6ec","37099a85a4a5556033dcddf94169ed8b061ce896be90cb28ecbe30abcf2db326","bf936d34b6e3915a5b1478f99f766927859a3d4c70f44ac8e414ae33829ebda1","8721a5046a36524c7b762c8eb24d55f9384efa37eaa27db44cf27ceefbebddb7","eea83face3e81cea87a60029b10c1d7990649ac70235422ad0f693528ee75333","e2d0caf7faf110b55598abee598c501fec504cdbb7bafb29bb42f6b9a89f3322","72a9ac160675ef98c238ae6c7baca09a90ed1103cf475636531b8d4ce962129d","9da6d556da43418f7d4084a35b4a526919957218861974ab85a4fb95e4991561","198da86055a0ef9a1db4bc34da204fe2f1ada8c1b35e88ed209af3716afd68e2","54315bde9e57c4e4971218bcd1f68663d9cc89fc95d1ca9b614d400469a123f7"],"paragraph_range_zero_based":[3840,3863],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p3840"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates need for measurement gaps when operating on the EUTRA band given by the entry in supportedBandListEUTRA or on the E-UTRA band combination given by the entry in supportedBandCombination-r10 or supportedBandCombinationAdd-r11 or supportedBandCombinationReduced-r13 and measuring on the NR band given by the entry in the InterRAT-BandListNR.","paragraph_zero_based":3864},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3865},{"literal_text_all_w_t_and_m_t":"interRAT-NeedForInterruptionNR","paragraph_zero_based":3866},{"literal_text_all_w_t_and_m_t":"Indicates need for interruption when operating on the EUTRA band given by the entry in supportedBandListEUTRA or on the E-UTRA band combination given by the entry in supportedBandCombination-r10 or supportedBandCombinationAdd-r11 or supportedBandCombinationReduced-r13 and measuring without measurement gaps on the NR band given by the entry in the InterRAT-BandListNR.","paragraph_zero_based":3867},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3868},{"literal_text_all_w_t_and_m_t":"interRAT-ParametersWLAN","paragraph_zero_based":3869},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports WLAN measurements configured by MeasObjectWLAN with corresponding quantity and report configuration in the supported WLAN bands.","paragraph_zero_based":3870},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3871},{"literal_text_all_w_t_and_m_t":"interRAT-PS-HO-ToGERAN","paragraph_zero_based":3872},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports inter-RAT PS handover to GERAN or not.","paragraph_zero_based":3873},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3874},{"literal_text_all_w_t_and_m_t":"intraBandContiguousCC-InfoList","paragraph_zero_based":3875},{"literal_text_all_w_t_and_m_t":"Indicates, per serving carrier of which the corresponding bandwidth class includes multiple serving carriers (i.e. bandwidth class B, C, D and so on), the maximum number of supported layers for spatial multiplexing in DL and the maximum number of CSI processes supported. The number of entries is equal to the number of component carriers in the corresponding bandwidth class. The UE shall support the setting indicated in each entry of the list regardless of the order of entries in the list.The UE shall include the field only if it supports 4-layer spatial multiplexing in transmission mode3/4 for a subset of component carriers in the corresponding bandwidth class, or if the maximum number of supported layers for at least one component carrier is higher than supportedMIMO-CapabilityDL-r10 in the corresponding bandwidth class, or if the number of CSI processes for at least one component carrier is higher than supportedCSI-Proc-r11 in the corresponding band.","paragraph_zero_based":3876},{"literal_text_all_w_t_and_m_t":"This field may also be included for bandwidth class A but in such a case without including any sub-fields in IntraBandContiguousCC-Info-r12 (see NOTE 6).","paragraph_zero_based":3877},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3878},{"literal_text_all_w_t_and_m_t":"intraFreqA3-CE-ModeA","paragraph_zero_based":3879},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE when operating in CE Mode A supports eventA3 for intra-frequency neighbouring cells.","paragraph_zero_based":3880},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3881},{"literal_text_all_w_t_and_m_t":"intraFreqA3-CE-ModeB","paragraph_zero_based":3882},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE when operating in CE Mode B supports eventA3 for intra-frequency neighbouring cells.","paragraph_zero_based":3883},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3884},{"literal_text_all_w_t_and_m_t":"intraFreq-CE-NeedForGaps","paragraph_zero_based":3885},{"literal_text_all_w_t_and_m_t":"Indicates need for measurement gaps when operating in CE on the EUTRA band given by the entry in supportedBandListEUTRA.","paragraph_zero_based":3886},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3887}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["91d90fd902094f7700637411327268a2bd619820b199f8d526ce25efeacdde32","8139dd744a1cc24fa31dbbaf53753e1f46051b04748a936e7dfb13a68ef63881","5d4d40a340129b2a1beda8ac74950f76ea9d35e710d4ab447f5d3971faf9183a","24b06bca2ca880793d14278e5e9e73954226e2dda24cf343423de032513bd140","046e61b35a6365f9cbecd57abed8d7f9525f94be857dbbc3e31d2f5cfb52314c","7f134e1eb478260b2e3e3178a31f8d11bf96c1c051c76a831514b50f1e4ed3e9","aefacaf699fa85b3acfd36dd1ebbe72e88d01a7b3355814536bc7f881267cfe7","03f1fb57b11b04e46044aab77e04e6296688f2313f8324bacba8aacdd1e9edd7","e80c54a5f60f4ef9b90b136a969f7edbab2f2bdc3d63e07e8f101e629af8fd79","2054987684dd0c05bfb0ccad56cd1cc8be65ac3d7d7bc37d138b10f2d8736081","ac93ce17c8f653cc6684fd3801028234306f1e0082572452f0a676436ab3d671","adfe69d5b894ad84289a3f272f2e437b6a33648afffa8a1e00479edae288774f","1ca17069d8f02514f366392934832a5d5ee51fdc0c06d00ec4d848e0c9973131","79827bf25b475489c0175343f9b5ac0998fdc1418003405792d5716e87c524d3","639a887e08f330069d86acc126a9d1ac677ed651e3f52dd613d9c0864ee86845","26ad43ece8068bd637cce0d1d5f06d591023b3afa3799bdf4c8c755b459e6867","f5a357a06f399110cfc9772fcf8db45f97ab9c459975e5a51e85bd918cad4aa4","b039a718eed49d151f748fc1a99864c4a3d5e0bb485797d95352b1d34c214d87","1b39f292d780466df57f459c157566ff5441d756ca50d3facc0cfc7c4c208e0b","7a70afd2da5b92632d95d0e398722d105cc13839efae3ff6ea92342461a18349","8f53b44332702ef8613d09c349664d2ade380de99afc4c242dc73d3c3682bf6b","672c7b60720e527cfc7ec3e07a8b9186ddd39786ad2cf49e1c5a1a946aedd13f","218b9100db8ce32fc845401b692144c0311fc76cab8756c66630351f3f95b23c","f38ef66b5772a3793a8f9075712f2c55f54553d7eb75384af01e97d133196d04"],"paragraph_range_zero_based":[3864,3887],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p3864"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"intraFreqAsyncDAPS","paragraph_zero_based":3888},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports asynchronous DAPS handover in source PCell and intra-frequency target PCell. ","paragraph_zero_based":3889},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3890},{"literal_text_all_w_t_and_m_t":"intraFreqDAPS","paragraph_zero_based":3891},{"literal_text_all_w_t_and_m_t":"Indicates whether UE supports DAPS handover in source PCell and intra-frequency target PCell, i.e. support of simultaneous DL reception of PDCCH and PDSCH from source and target cell. A UE indicating this capability shall also support synchronous DAPS handover, and single UL transmission for intra-frequency DAPS handover.","paragraph_zero_based":3892},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3893},{"literal_text_all_w_t_and_m_t":"intraFreqHO-CE-ModeA","paragraph_zero_based":3894},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE when operating in CE Mode A supports intra-frequency handover.","paragraph_zero_based":3895},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3896},{"literal_text_all_w_t_and_m_t":"intraFreqHO-CE-ModeB","paragraph_zero_based":3897},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE when operating in CE Mode B supports intra-frequency handover.","paragraph_zero_based":3898},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3899},{"literal_text_all_w_t_and_m_t":"intraFreqProximityIndication","paragraph_zero_based":3900},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports proximity indication for intra-frequency E-UTRAN CSG member cells.","paragraph_zero_based":3901},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3902},{"literal_text_all_w_t_and_m_t":"intraFreqSI-AcquisitionForHO","paragraph_zero_based":3903},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports, upon configuration of si-RequestForHO by the network, acquisition and reporting of relevant information using autonomous gaps by reading the SI from a neighbouring intra-frequency cell.","paragraph_zero_based":3904},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3905},{"literal_text_all_w_t_and_m_t":"intraFreqTwoTAGs-DAPS","paragraph_zero_based":3906},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports different timing advance groups in source PCell and intra-frequency target PCell. It is mandatory for intraFreqDAPS capable UE.","paragraph_zero_based":3907},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3908},{"literal_text_all_w_t_and_m_t":"jointEHC-ROHC-Config","paragraph_zero_based":3909},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports simultaneous configuration of EHC and ROHC protocols for the same DRB.","paragraph_zero_based":3910},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":3911}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["21be22ecf9d84aa214042d1aae57b1663e6978e82474bdfb9edf92d8934ef2af","e9c2b63c65f1da1be6903ec4a1cafce2e1183edf05dff89d5c2438b9d499b9cc","6b0c258f4a804a0f5cb1c8cd47a048094ca7477de21e0e909f634edc358b835f","d958856dbfed630fb3259d7c20bd976cb9a3e299380bc8320b2ba32ab9668682","e426e620f898cc2363e02e2057642cbbff0cc62f4edf08c98d568fbf58f5a767","833505fbe74ea6e142109695553987686977f4b53c14299c8345e1491943dc54","e604f8b0f1e5e72a43f66da9712232e79c2f293d1ec55618d07841e2f8871abe","fb5727a3ef8e9e7231747ba5db1415003719a458917395aab922d2d9df0605e2","60f93901eb75eaf5ef7bcc8652dd704c68ef21d9791bc5f074970f607b871400","f32d8bce50e5430c726f6af68dccd7783fc18dd1a63632d7b6db8b98b0594e54","bef7144a92ec4d1c2482c90356415415513db376db46f9362e569dbb760b9c9c","71e921bef031a2e23d8c691b7157c82b41e6094ef9ea4f0d68eb3b646ff5ad4c","ffbc83da017195943cbdb1431badd100159132829907912d7dd907a94d0bbcaa","e4a82a8a2b617dcb99cddb0ed952f15c929706d4cf05979f9e5329f8efde4ea2","e9590b7be844763824e01afe84804e7ce8bc66de8eb0263be9279380c3add4e4","1ebbed8a6ae74fbcb10279e1d9216d6143387253c2c1b57407f8ab6beea732b2","a185ab9b43256918c817c04f4c44da81dfbb5d85e576705400e113861356c932","cd4bca0082f05e1d2eb7ca777c8d6dc8d441d3ce088a6c17eed33a4a17a7811a","0f2780c9d8a0d6555be800d4b3aea7271ef343c6ed571cd93cfc0a79e51954a3","115e097de555c75e69b34b1eb19c6162498e4c49e1a8448f99a1188e0bc3cd64","358d3755ba91b283810930f915ceb4546f12d546fdd59cf3460ac5ed3676acfe","b515a1b8ca652fbd31d4d9c7572fbee8ee8485193415d81e73a00730caed2574","bad0bfe8c0778f285275114d8d70442f99c92509fe77988718566e94e3cb9b52","c8121fbfaf9b2a546ae9f4eab1992807d39b260620d0d7fa62fb66e594a77333"],"paragraph_range_zero_based":[3888,3911],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx:p3888"}
{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"k-Max (in MIMO-CA-ParametersPerBoBCPerTM)","paragraph_zero_based":3912},{"literal_text_all_w_t_and_m_t":"If signalled, the field indicates for a particular transmission mode the maximum number of NZP CSI RS resource configurations supported within a CSI process applicable for the concerned band combination.","paragraph_zero_based":3913},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":3914},{"literal_text_all_w_t_and_m_t":"k-Max (in MIMO-UE-ParametersPerTM)","paragraph_zero_based":3915},{"literal_text_all_w_t_and_m_t":"Indicates for a particular transmission mode the maximum number of NZP CSI RS resource configurations supported within a CSI process applicable for band combinations for which the concerned capabilities are not signalled.","paragraph_zero_based":3916},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":3917},{"literal_text_all_w_t_and_m_t":"laa-PUSCH-Mode1","paragraph_zero_based":3918},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports LAA PUSCH mode 1 as defined in TS 36.213 [23].","paragraph_zero_based":3919},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3920},{"literal_text_all_w_t_and_m_t":"laa-PUSCH-Mode2","paragraph_zero_based":3921},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports LAA PUSCH mode 2 as defined in TS 36.213 [23].","paragraph_zero_based":3922},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3923},{"literal_text_all_w_t_and_m_t":"laa-PUSCH-Mode3","paragraph_zero_based":3924},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports LAA PUSCH mode 3 as defined in TS 36.213 [23].","paragraph_zero_based":3925},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3926},{"literal_text_all_w_t_and_m_t":"locationReport","paragraph_zero_based":3927},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports reporting of its geographical location information to eNB.","paragraph_zero_based":3928},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3929},{"literal_text_all_w_t_and_m_t":"loggedMBSFNMeasurements","paragraph_zero_based":3930},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports logged measurements for MBSFN. A UE indicating support for logged measurements for MBSFN shall also indicate support for logged measurements in Idle mode.","paragraph_zero_based":3931},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3932},{"literal_text_all_w_t_and_m_t":"loggedMeasBT","paragraph_zero_based":3933},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports Bluetooth measurements in RRC idle mode.","paragraph_zero_based":3934},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":3935}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["e015a6a3a1e99a9e743464e026dbe0f896379bee49fd871477dc0b00d5b7a4dd","ffb05683a598110f767b1cec874fbe3cb9bd6611518a3fda532297e7c8b3b8e2","b19b41efbf3f4a00938a7ed9b03c28e22a51e02567c3d992efb48a72d9bb5452","d940d3571460ee8867a9f7d13deb867de20857aa17702d9cb439e0d7b8ca8be8","4e2a8970692731c561739bbf652ef2d27e63d0d665cb17d63c46a1e554e6bc6b","3cfeb3c889e94771007b31a2bf8b6bcf9140a653b6bc06e328e62f19a462b1e2","638cb1dd708023ae7af7dfdc7eb99c48fb237ec07d90a341dfb7eef9e61db940","1f34f2ed87211e58d7606c3fa242cfb1277797ef3a666a213b7f512102ac146e","4f33e4f51cac8b5541ba760e7e174a6877781af63547eed16aac641610e1aabc","98fd6fd7663a09a9fee59e766b01e88bec5ba1c4315f2b7b3e84b76591372736","52caa089197a825ad2242a8c30f2508789dd36a3d81f9479d360b413f706bb61","fa36bf20