{"fields":{"filename":"R2-2503192.zip::R2-2503192 RRC_final.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"X","paragraph_zero_based":24},{"literal_text_all_w_t_and_m_t":"Core Network","paragraph_zero_based":25},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28},{"literal_text_all_w_t_and_m_t":"Title:","paragraph_zero_based":29},{"literal_text_all_w_t_and_m_t":"Introduction of control parameters for on-demand posSIB request [PosOdSIB-Req]","paragraph_zero_based":30},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32},{"literal_text_all_w_t_and_m_t":"Source to WG:","paragraph_zero_based":33},{"literal_text_all_w_t_and_m_t":"Huawei, HiSilicon, Ericsson","paragraph_zero_based":34},{"literal_text_all_w_t_and_m_t":"Source to TSG:","paragraph_zero_based":35},{"literal_text_all_w_t_and_m_t":"R2","paragraph_zero_based":36},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38},{"literal_text_all_w_t_and_m_t":"Work item code:","paragraph_zero_based":39},{"literal_text_all_w_t_and_m_t":"TEI19","paragraph_zero_based":40},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41},{"literal_text_all_w_t_and_m_t":"Date:","paragraph_zero_based":42},{"literal_text_all_w_t_and_m_t":"2025-04-14","paragraph_zero_based":43},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"238d3c199e96ece26711109ab9c6ea50c6e7a79f01d965f5726abaadc75d7d70","original_member_sha256":"aef358e3251a43545eb3096bd467322c204ec9bae5d4b3d32209cb0d70701bd4","paragraph_ElementTree_utf8_XML_sha256":["588f91a76962581b78204c5b0e98f15139b4f80f8f9a4cf7e43c0d015dad095c","a843b2557fa314bc318b4a6e6acafe5439a882e9b56890839b731b731bc8e8cf","42b826f4a3d97af875ffeccc7aaa1c0a48c8b63931f3264411f66f4cd6f0098a","6a864a33f97de014082f1d8b37e0936c68f90faa7bf366aa12b6dc634976efdc","031787567b6076d9371e00b33224f7ec5ea30d1bfc52a25f3e3cdcc40437bfeb","ad708316f763763ed5553e43b374f239fa493b5b467f9a82c380368523644452","4cfa04170e38bb12e66106a38e6287756389d6d078edce8c811761163f98ca1e","072c9b54b2c46199af01551e514cc2270089008851f95fd56dcac5e5e1d11fd6","cf10237a0bad429639d379d00d57f9175ad294d495105a2fbced93d8dbf401c9","f63c7cf2b2f3d9ea4e594d851651d1d2034b586b116fed002d73e4a74de8994b","f4a6188ece5d4286fe181c1d49cafcad6fc2b2dc8355cc99173d84bea4c45eaa","7642dee7e2dad30d56389cacbeefa7660c5d07276d31cc6aaeea11808c0442f0","0564cbf040f7ddaa3cb1c6d9cb9b879d3b984630dad18165f21b0b1448e1f0e8","06ded5da68dc1b93b2b38dd3a500fce731007a3987e5b2075d60df8d8fa0cc2a","eea2dcbfbc8b26c29ae3b861e062ecfc1220aec718401fdac3b00c7e6a3ca887","8d61bba105c90886e3acdeda5834d833e313f8d979a9766152c408a91fefc87c","e244692ef48169749051aa1f609d565340b5c9bb3b43d46b0c672be5bade94d4","a8b8f4e8577b75e28a9387a4e401ac49f8ded1ed8579fecfcdf7c29ba3ab480b","b02e864d7a9dd62ea6d3806bb3a9a474b7cc14d61c9d0810ddb279f107a7a0c6","9132db0b98297cd40714f64255adefdaf1bc88986738ff37da6cd1eba926a9ff","332011b8ef3e17bb46464848c87dd17177d373e8e407f94cbdb1ed8e2c3e9b5a","828805e2cdc1e21f37b540c753a127f0ef4bc190c1d11a7fd9f51bfbf1ec1847","2c5e39cc0d6d57740627aa5a4e82468bf4a645d12458df94ee73b8d73791a477","0db337bdc2eecbc563c7571bf3ff6a4c7904a21194ac4ffed068132e0f03bcef"],"paragraph_range_zero_based":[24,47],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2503192.zip::R2-2503192 RRC_final.docx:p24"}
{"fields":{"filename":"R2-2503192.zip::R2-2503192 RRC_final.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"B","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Rel-19","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-17(Release 17)Rel-18(Release 18)Rel-19(Release 19) Rel-20(Release 20)","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":"Reason for change:","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"For positioning SIB, the assistance data for some of the SIBs require periodic update and periodic delivery of the posSIB is thus required. For instance, RTK message is typically updated periodically (a typical update periodicity is 640ms) and the update needs to be delivered to the UE in a timely manner. ","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"During R16 discussion, we have agreed to introduce on-demand SIB request in RRC_CONNECTED. When a certain SIB/posSIB that the UE needs is not currently broadcasted, the UE may send a UL dedicated RRC message to the gNB to request this needed SIB/posSIB. Then, based on the request, the gNB may send the SIB/posSIB either by dedicated signaling or by system information.","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"The issue is that, based on the current mechanism, the network does not know how many time the SIB should be delivered to the UE. Take posSIB for RTK for example:","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"If the network delivers multiple RTK posSIB per UE request, the network does not know when it should stop","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"If the network delivers only one RTK posSIB per UE request, the UE might repeatedly send the request to the network, which results in much signalling overhead.","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"This hence motivates us to allow for UE to indicate the amount of periodic deliveries that it needs when requesting the posSIB.","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"Note that for the support of RTK in LPP, LPP control parameters are defined for periodic assistance delivery with periodicity and requested amount.","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"238d3c199e96ece26711109ab9c6ea50c6e7a79f01d965f5726abaadc75d7d70","original_member_sha256":"aef358e3251a43545eb3096bd467322c204ec9bae5d4b3d32209cb0d70701bd4","paragraph_ElementTree_utf8_XML_sha256":["4fe71f1d4044514c73fd67ce93145f72e29754c64935092fb35056efbba00bcc","89dc92d76d1306d94b83c7788b68cec3936ec3f45131639363966741907f743e","3085bb6333acd36b9f8269f43fe587e5bb98c3318df6991f58cf6aac102cf6f6","cc77419c33d53ade88f27fe25be8710e84e34ab3a9d6ef6440f8ef002d49cfc3","0678a9f349411a34c40f6fbca7e2572c7ecad6b8bbe7a4e2785168efb11ce30b","9c21ffc12718bc8b6bc75661458a8bd7e95cb56b1927d898c173e235405070ab","a21ed0d71e11818fee4323b69e028f5abae63073d1a6d1f811efd925a4573118","f49926001ce0143c97ceb68b207b99997d9462c6114e010d540a932ca861ddad","15a1cdae24171fe5080ec5186b4791f1f01b0096bbf6a23c1041206d0fd66655","1203a2dec0c2e5fe97a44f34eca53e053007c21571ac7b1746cc0dac71569077","a9cc187f6956b2ff02d1afd6c323846d51cb2efe0e40ca6d08a080590488ccf5","ff298381005bb965165e181558f7f14c6965a3de4d8b5e0352c19c80f02e1640","295dc501fa962b4ffbe0c35de93ea51e37301100408324542f0a55ef1c5e7673","85d30688e00efb1c21b1b9fdb9c40793ba2a3b1c6411e7eda89419f9c9892b19","6fe84344e8ecb215e6d64ae535ab8eaec6fff38e12c53d63fd3922157a11b07b","33068cac24b00c49cea7d40486794563200f2f9cde96c743258441cd7bfe86ae","b29831a761e05bb78aee45742beff946aa0083431f3bf526a2c46195611f00e3","6a2c188eb5b28e0485909dc72f44ae90697bdc509fed4e978a7d02a7b43d9457","4dfb817dd44156f28b948075e0a75f395a19866ab27e90db83fab042a0692daa","e6c947c943489d15a69698eabefee0fc77e34bfd1e627e5a3c4d42712695ed93","cb782f58952a1a444f9cebc76421e6dad94b9f5a1d49cb2d4022f28707097837","d2927ffc05b2b49ae2558fc34e2ac8f39bb34d1afc59b0edb3af0c35744cd2fc","97926dd06911767880331f7f24b2748e51ddce1a6b7143e282dbc4b8f3b6eaea","8a101689738f16071ceaece87dea236899d1a8229df5ffa4539e9881490c9d65"],"paragraph_range_zero_based":[48,71],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2503192.zip::R2-2503192 RRC_final.docx:p48"}
{"fields":{"filename":"R2-2503192.zip::R2-2503192 RRC_final.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"We can follow what has been defined in LPP for the delivery amount and the posSIB can be delivered to the UE periodically whenever the gNB receives an updated posSIB from the LMF.","paragraph_zero_based":72},{"literal_text_all_w_t_and_m_t":"For the posSIBs that have the requirement for periodic delivery, LPP has the following list of tables for RAT-independent and RAT-dependent positioning methods","paragraph_zero_based":73},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":74},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":75},{"literal_text_all_w_t_and_m_t":"Mapping to posSIBs, the following posSIBs would have the requirement for periodic deliveries","paragraph_zero_based":76},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":77},{"literal_text_all_w_t_and_m_t":"========== UPDATE after RAN2#129===========","paragraph_zero_based":78},{"literal_text_all_w_t_and_m_t":"After the discussion during RAN2#129, the following agreement has been achieved","paragraph_zero_based":79},{"literal_text_all_w_t_and_m_t":"Agreements:","paragraph_zero_based":80},{"literal_text_all_w_t_and_m_t":"Introduce control parameters, including delivery amount and start/stop, for posSIBs with periodic delivery requirements for SI request in RRC_CONNECTED.","paragraph_zero_based":81},{"literal_text_all_w_t_and_m_t":"Control signalling in reconfiguration to be encoded as ENUMERATED { enabled } OPTIONAL Need R.","paragraph_zero_based":82},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":83},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":84},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":85},{"literal_text_all_w_t_and_m_t":"1/ Introduce control parameters, including delivery amount for posSIBs for SIB request in RRC_CONNECTED","paragraph_zero_based":86},{"literal_text_all_w_t_and_m_t":"2/ Added capability signalling for the control parameters for posSIBs","paragraph_zero_based":87},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":88},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":89},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":90},{"literal_text_all_w_t_and_m_t":"The UE needs to repeatedly send on-demand SI request for posSIB, which results in large signaling overhead and delay","paragraph_zero_based":91},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":92},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":93},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":94},{"literal_text_all_w_t_and_m_t":"5.2.2.3.6, 6.2.2, 6.3.3","paragraph_zero_based":95}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"238d3c199e96ece26711109ab9c6ea50c6e7a79f01d965f5726abaadc75d7d70","original_member_sha256":"aef358e3251a43545eb3096bd467322c204ec9bae5d4b3d32209cb0d70701bd4","paragraph_ElementTree_utf8_XML_sha256":["61a6bf8c977290dc2f185362d25035036081cc7b87dd1f15404b5a6dda2a60e7","ec803d911953acd096fe34f736384bf43cf6d3a59d9469e550eecf97a9000ced","e50a108f266b67c865438898a2a96c37629bcc13cfd80bf24042c37698cf2c77","c6724a31d596b91991dbb94484544e8fed42f47798271b29b5b11eb772b8dc52","5ec22690058d7906a1a228842082a71aeb724b975a22a94c7cc2d68e39615a72","5451c223922dc35dc8f192f7b2739ea29f04494c0a4f4a3f041cb31691b56de9","dbd022ddf783353ed818c74d29de0d0b6b728a3c93b00a0167e588386d4e5136","a916191e7ffebfa6c10535852293d24eb94ff123a8f76fca85d5ccd85c5ea7b3","bc2145393e0653adc0e493068fcc27fc2d854d93fc24a30e49dea46d53cefeb9","efd593d7e309260a7204e7fc50ff363680144fe3e360aad53ac5fdb0a2607439","3b3c71784f6159fd86bcd85a414afd6c086dfb9fc0bc091d28c8507722410d4f","16c47eb6c5d7ac70dd4fea0cc6bf56a2553f836cd59b5c0f64bceb7df2600ce3","65d953cfb2ae8