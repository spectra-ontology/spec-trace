{"fields":{"filename":"R2-2408215.zip::R2-2408215 Correction on UE capability of supporting NavIC in A-GNSS positioning (R18).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":" ","paragraph_zero_based":168},{"literal_text_all_w_t_and_m_t":"GNSS-AlmanacSupport ::=SEQUENCE {","paragraph_zero_based":169},{"literal_text_all_w_t_and_m_t":"almanacModelBIT STRING {model-1(0),","paragraph_zero_based":170},{"literal_text_all_w_t_and_m_t":"model-2(1),","paragraph_zero_based":171},{"literal_text_all_w_t_and_m_t":"model-3(2),","paragraph_zero_based":172},{"literal_text_all_w_t_and_m_t":"model-4(3),","paragraph_zero_based":173},{"literal_text_all_w_t_and_m_t":"model-5(4),","paragraph_zero_based":174},{"literal_text_all_w_t_and_m_t":"model-6(5),","paragraph_zero_based":175},{"literal_text_all_w_t_and_m_t":"model-7(6),","paragraph_zero_based":176},{"literal_text_all_w_t_and_m_t":"model-8-v16xy     (7) } (SIZE (1..8))OPTIONAL,","paragraph_zero_based":177},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":178},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":179},{"literal_text_all_w_t_and_m_t":" ","paragraph_zero_based":180},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":181},{"literal_text_all_w_t_and_m_t":" ","paragraph_zero_based":182},{"literal_text_all_w_t_and_m_t":"GNSS-AlmanacSupport field descriptions","paragraph_zero_based":183},{"literal_text_all_w_t_and_m_t":"almanacModel","paragraph_zero_based":184},{"literal_text_all_w_t_and_m_t":"This field specifies the almanacModel choice(s) in GNSS-Almanac IE supported by the target device for the GNSS indicated by GNSSID. This is represented by a bit string, with a onevalue at the bit position means the particular almanac model is supported; a zerovalue means not supported.","paragraph_zero_based":185},{"literal_text_all_w_t_and_m_t":"If the target device supports GPS and GNSS-Almanac assistance, it shall support Model-2.","paragraph_zero_based":186},{"literal_text_all_w_t_and_m_t":"If the target device supports SBAS and GNSS-Almanac assistance, it shall support Model-6.","paragraph_zero_based":187},{"literal_text_all_w_t_and_m_t":"If the target device supports QZSS and GNSS-Almanac assistance, it shall support Model-2.","paragraph_zero_based":188},{"literal_text_all_w_t_and_m_t":"If the target device supports Galileo and GNSS-Almanac assistance, it shall support Model-1.","paragraph_zero_based":189},{"literal_text_all_w_t_and_m_t":"If the target device supports GLONASS and GNSS-Almanac assistance, it shall support Model-5.","paragraph_zero_based":190},{"literal_text_all_w_t_and_m_t":"If the target device supports BDS and GNSS-Almanac assistance, it shall support Model-7.","paragraph_zero_based":191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"b1f4f45546def2664ca2ee7667b8fe23ed4539cfd8edba6b6f93bf09915e1a61","original_member_sha256":"daacb728659b141652fb097c21d93fe1c637dfd6fe5095d8417a2039f13bf59d","paragraph_ElementTree_utf8_XML_sha256":["a3a9fe13ba37b488da597447e8b2f3fa8cddf6aaa28827420e1bfb3b73219adb","8ab3773fd11a653b369f1c6390a7f40a097885bef9ccc32370d63904a0a03954","566837db17ea949dfd96cd3ade0d90c513d146bc8fec9eb2b50e6f28dd957789","25154c03f718df117b9704b0b092cbcfefcc3f9eed5f75d237a94933f8adaf53","7667879b445a0653f4193b878e9c734a249331d43c89ef78930ab2939b3e6992","42127fa276b3ee0a70b1034b5245c938aa3152fefe86cc51cfa95fb671afe0c8","31e434cc4c84869430cff80ee0e8b6d41e7d3824bc75d61dd8099aeb0c98bf43","1e2347f5b0ca1f1fa990246a7f05dd295bcaf3ddf1823cc26d3df0865e710e74","bf658e18205712edc2deb7c71e05e7cb5b112e99872c50e6014f0b24a0369898","99f4fd09f89024b6a5d0209188a162023dd25154ddec3b6cee66a173cde2fb24","7f548acba7097ca5529a4ec286b3f1f6a4a57cf9844982d3070b2013c6c815b6","047406c4ad1988f75276e067f4656f3a9f73c5c2102aa37786bb360d304da767","a3a9fe13ba37b488da597447e8b2f3fa8cd