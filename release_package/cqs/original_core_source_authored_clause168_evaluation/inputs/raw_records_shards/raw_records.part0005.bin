{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-TransRange","paragraph_zero_based":47664},{"literal_text_all_w_t_and_m_t":"This field indicates the transmission range of the sidelink DRB. The unit is meter.","paragraph_zero_based":47665},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47666},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":47667},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":47668},{"literal_text_all_w_t_and_m_t":"SLRBSetup","paragraph_zero_based":47669},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in case of sidelink DRB setup via the dedicated signalling and in case of sidelink DRB configuration via system information and pre-configuration; otherwise the field is optionally present, need M.","paragraph_zero_based":47670},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47671},{"literal_text_all_w_t_and_m_t":"–SL-RBSetConfig","paragraph_zero_based":47672},{"literal_text_all_w_t_and_m_t":"The IE SL-RBSetConfig specifies the configuration information for RB set for NR Sidelink Communication.","paragraph_zero_based":47673},{"literal_text_all_w_t_and_m_t":"SL-RBSetConfig information element","paragraph_zero_based":47674},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":47675},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RBSETCONFIG-START","paragraph_zero_based":47676},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47677},{"literal_text_all_w_t_and_m_t":"SL-RBSetConfig-r18 ::=             SEQUENCE {","paragraph_zero_based":47678},{"literal_text_all_w_t_and_m_t":"    sl-RBSetIndex-r18                  INTEGER (0..4),","paragraph_zero_based":47679},{"literal_text_all_w_t_and_m_t":"    sl-NumOfSSSBRepetition-r18         INTEGER (2..9)                          OPTIONAL,     -- Need R","paragraph_zero_based":47680},{"literal_text_all_w_t_and_m_t":"    sl-GapBetweenSSSBRepetition-r18    INTEGER (1..84)                         OPTIONAL      -- Need R","paragraph_zero_based":47681},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":47682},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47683},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RBSETCONFIG-STOP","paragraph_zero_based":47684},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":47685},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47686},{"literal_text_all_w_t_and_m_t":"SL-RBSetConfig field descriptions","paragraph_zero_based":47687}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["ddc0d6442eaf6b95611b16cffc4a6403860309eb2a65464b7134c89a2217667f","0f72585983066e7f196194dcaa7f310b94a585227982ff16350868fb60928325","57c7cf92ca0a3d1b7693b19c57ac8e18324d4b73142def59e4b76499e547fa48","916fa2bf69a460a8ee27c661ac57d831f22ea9bb93ad6ae0343bed03b82a5ea1","fb4ee667b25e1077410c94f0c321f432b71233ba7f1c7ba88233e37d18dfdefa","f57fa0a62f54628108c5f7a60ce708b907e1c9b25f78bdac8ae163bccd8b0f70","22654c0053a18a1688c26adb0d445c52be02681c0fcaace88ae16eb0f44ccd92","87ae6bc281b04b28ffb7d78b87007f307236d6152dcd9a10f5f31a2e956df9e1","de07a48d3dc2c12566c94f53328c4a230602ad6266f223b16f4664b139d9cacf","ce82732529df972339c45665d98f5c845adfbe121d5b70dbd5a1ffd7418b8518","2bc3be3155b6dbc1dd8b48a3e36cf0b19b59bfe1b88e99f9d40fe90cbb55b53b","a76ad79ba4f4e7b2f3856f7d4b83b2358a3320156b2bcd7a37dab1d40bb52be0","bae1aed0aa75cb455d378de1437cddeea36b9fe1a154fa88adff3e32cf0f40aa","e5843c23aed176e3ec9ee65995554210a4fa64fe4dadab9c38be6c17ac6d436b","0aa7b38162f7a612b24283fe92cc05dd85f6350cb33e