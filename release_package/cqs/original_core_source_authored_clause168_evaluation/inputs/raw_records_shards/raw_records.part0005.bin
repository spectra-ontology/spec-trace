{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"loggedDataCollectionMemoryThreshold","paragraph_zero_based":5376},{"literal_text_all_w_t_and_m_t":"Memory threshold for the UE to report that it has logged radio measurements for network-side data collection, if the amount of data in the memory reserved for logging of radio measurements for network-side data collection has become equal to or above this threshold. Value kB16 means the threshold is set to 16 kB and so on.","paragraph_zero_based":5377},{"literal_text_all_w_t_and_m_t":"lpwus-OffsetPreferenceConfig","paragraph_zero_based":5378},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE’s preferred time offset for LP-WUS monitoring. ","paragraph_zero_based":5379},{"literal_text_all_w_t_and_m_t":"lpwus-OffsetPreferenceProhibitTimer","paragraph_zero_based":5380},{"literal_text_all_w_t_and_m_t":"Prohibit timer for offset preferences assistance information reporting for LP-WUS monitoring. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":5381},{"literal_text_all_w_t_and_m_t":"maxBW-PreferenceConfig","paragraph_zero_based":5382},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preferred bandwidth for power saving.","paragraph_zero_based":5383},{"literal_text_all_w_t_and_m_t":"maxBW-PreferenceProhibitTimer","paragraph_zero_based":5384},{"literal_text_all_w_t_and_m_t":"Prohibit timer for preferred bandwidth assistance information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":5385},{"literal_text_all_w_t_and_m_t":"maxCC-PreferenceConfig","paragraph_zero_based":5386},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preferred number of carriers for power saving.","paragraph_zero_based":5387},{"literal_text_all_w_t_and_m_t":"maxBW-PreferenceConfigFR2-2","paragraph_zero_based":5388},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preferred bandwidth for power saving for FR2-2.","paragraph_zero_based":5389},{"literal_text_all_w_t_and_m_t":"maxCC-PreferenceProhibitTimer","paragraph_zero_based":5390},{"literal_text_all_w_t_and_m_t":"Prohibit timer for preferred number of carriers assistance information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":5391},{"literal_text_all_w_t_and_m_t":"maxMIMO-LayerPreferenceConfig","paragraph_zero_based":5392},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preferred number of MIMO layers for power saving.","paragraph_zero_based":5393},{"literal_text_all_w_t_and_m_t":"maxMIMO-LayerPreferenceConfigFR2-2","paragraph_zero_based":5394},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preferred number of MIMO layers for power saving for FR2-2.","paragraph_zero_based":5395},{"literal_text_all_w_t_and_m_t":"maxMIMO-LayerPreferenceProhibitTimer","paragraph_zero_based":5396},{"literal_text_all_w_t_and_m_t":"Prohibit timer for preferred number of number of MIMO layers assistance information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":5397},{"literal_text_all_w_t_and_m_t":"minSchedulingOffsetPreferenceConfig","paragraph_zero_based":5398},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preferred minimumSchedulingOffset value for cross-slot scheduling for power saving.","paragraph_zero_based":5399}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["1125d7b70fbfdc68bc1989525dd106af02ee776b667344d2815ca97e10afaedc","75de55c29c762678d2b7441e001230ddec176186d1d8b54f570ce239703ec94d","139fdc8e15dc2e5cfae966717c326d83e48d5fb7688bb77c23402bc57f23f865","6cf38bb3ce74eab4d923236de3dc404cae2a632ece62354f63eddf7ca03f0213","96c63a3ae9f5382eee07ca43bd2119b437dfa7a3d571e10ec79410d5bfc7a95e","9d94b781ff24993929c36ef82f02a014a1eaeb8893dbc7cb066040ce48e281f0","683a9168e3bd202d3682d6605d39e2f60f01f7c7f20fbf95d3352a8eb8be6235","c1247cd5d07e99dd478ad72c06e2b717e5553e5dc1e6f89445e7e2642684db96","219589af43cb8e5f0b9e3ba79f76da2e4bea86b57c4e2ea7aa77a12a103a6fde","7da8ba511da4d69bc74e1e780c912f3d2e1bd0f871f8f002cd071ad263ef609a","22c5185eab9d8b6dcd24119c08394080e557e7357d0392e4e971041222445535","b00dd23173cd3d4d940f65b496585b1ea11353c70ba51acdc3528677bdcc1d69","d466dd8f9af3fa8ee869c64b3404752570f383cd8d233e49183173a9c6f75820","2d554fdbbbd0d340f4a1dc20817b8feb5151ec12ed96d437b0ebbd303c4f8d8e","68509e2e2e6ae3146ada5e65696fec467373a20865549d8cc400d33725f466b6","9864e20edab8debab8f80a3c45123c130a010c7898380bea20acdd61403daea1","23fc01fc945a4d43517424cb37d105ab01b501dd33740a3f33e2a1223b46ffa9","9699bbe0dca