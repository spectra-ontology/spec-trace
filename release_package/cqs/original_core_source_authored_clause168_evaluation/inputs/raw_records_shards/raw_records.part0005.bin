{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    sl-RemoteUE-SLRB-Identity-r18           SLRB-Uu-ConfigIndex-r16,","paragraph_zero_based":48672},{"literal_text_all_w_t_and_m_t":"    sl-EgressRLC-ChannelPC5-r18             SL-RLC-ChannelID-r17,","paragraph_zero_based":48673},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":48674},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":48675},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48676},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SRAP-CONFIGU2U-STOP","paragraph_zero_based":48677},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":48678},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48679},{"literal_text_all_w_t_and_m_t":"SL-SRAP-ConfigU2U field descriptions","paragraph_zero_based":48680},{"literal_text_all_w_t_and_m_t":"sl-MappingToAddMod-U2U-List","paragraph_zero_based":48681},{"literal_text_all_w_t_and_m_t":"Indicates the list of mappings between the end-to-end sidelink DRB of a given L2 U2U Remote UE and the egress PC5 Relay RLC channel used by L2 U2U Remote UE and L2 U2U Relay UE when acting as Tx UE, as specified in TS 38.351 [66] to be added or modified.","paragraph_zero_based":48682},{"literal_text_all_w_t_and_m_t":"sl-MappingToRelease-U2U-List","paragraph_zero_based":48683},{"literal_text_all_w_t_and_m_t":"Indicates the list of mappings between the end-to-end sidelink DRB of a given L2 U2U Remote UE and the egress PC5 Relay RLC channel as specified in TS 38.351 [66] to be released, ","paragraph_zero_based":48684},{"literal_text_all_w_t_and_m_t":"sl-EgressRLC-ChannelPC5","paragraph_zero_based":48685},{"literal_text_all_w_t_and_m_t":"Indicates the egress PC5 Relay RLC channel for sidelink transmissions at the L2 U2U Relay UE and at the L2 U2U Remote UE.","paragraph_zero_based":48686},{"literal_text_all_w_t_and_m_t":"sl-RemoteUE-SLRB-Identity","paragraph_zero_based":48687},{"literal_text_all_w_t_and_m_t":"Identity of the end-to-end sidelink DRB of the L2 U2U Remote UE. ","paragraph_zero_based":48688},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48689},{"literal_text_all_w_t_and_m_t":"–SL-SyncConfig","paragraph_zero_based":48690},{"literal_text_all_w_t_and_m_t":"The IE SL-SyncConfig specifies the configuration information concerning reception of synchronisation signals from neighbouring cells as well as concerning the transmission of synchronisation signals for sidelink communication.","paragraph_zero_based":48691},{"literal_text_all_w_t_and_m_t":"SL-SyncConfig information element","paragraph_zero_based":48692},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":48693},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SYNCCONFIG-START","paragraph_zero_based":48694},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48695}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["b46458e2d549fd5c5b974bfb809921f1c9c754d41d95098ece42fbbcf88b63c8","7a77470231d60c8c8dfe216ea8d72fb8982ed2fac3b436fc74ad8060ffe40e7d","24c0bdbf12be5ec58c8cd4765817a3c0087e4c0bb317def584b6a42e0c27e7ac","2d4a9a05096e67cd3048fe782d6aa2a5ed4f1e7ca46b9c8baf70f133cc54fad3","1950bf4c78859285d939176728bd9bea6bc236ed79c24c61c6b81921dda6f023","e36e357141cc6f8e8bd3f3922f22b7c517bcb9851f22e84aa09c26cd4b5f19a6","74b527c9fcecb104673c0048b6e12c90fc460747d24e2bed01710e0e06e035b7","1b7b8c700ef74a6e5844f5388d1cf75257fcf0b4263160a826e387105badfa4b","cd2dd0f267a5a27dc3cb93525c02385a117e9457f48240d69ca9082415d5acac","afb475f86d1a56b002e6b38322e8a86d8f1bf9f745171d36dcb87b27e2