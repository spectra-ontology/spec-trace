{"fields":{"filename":"R2-2406297.zip::R2-2406297 Correction on SP positioning SRS MAC CE-r18.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"A","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Rel-18","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-17(Release 17)Rel-18(Release 18)Rel-19(Release 19) Rel-20(Release 20)","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":"Reason for change:","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"Currently, there are two issues related to the SP positioning SRS activation/deactivation MAC CE","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"1/ There is a typo in the field descriton of the field Positioning SRS resource set ID","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"2/ Add the clarificaiton that the only when the field A/D is set to 1 and C is set to 0, the BWP ID and cell ID are applicable for the spatial relation indication","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"1/ There is a typo in the field descriton of the field Positioning SRS resource set ID","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"2/ Add the clarificaiton to the field description of BWP ID and cell","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"ID that the only when the field A/D is set to 1 and C is set to 0, the BWP ID and cell ID are applicable for the spatial relation indication","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ff084789d8d403d286304fa49e727684f7808cbf541e6fc9a1454dd30a273955","original_member_sha256":"cf43fff4423531a67c38d4767438dc4ea28dbb1e34d24012420240224409c91e","paragraph_ElementTree_utf8_XML_sha256":["e4ea5591218aa96d0cd407936b651eb165fb4c75e229dab64ec9de6be991cb96","2d00e3b1a82065155328ddd802c3d4a8ebff11f4a0d6da9ecf9b1e34dc8ebfc8","dc0f20b3e00df8b62f677bb5c6341f126b771a4b2bbb2063881977a28b60be6b","761fa4d36b282591b5f5bb5ee554c6086f6eb9d5925f257d405f142f9e3a17e1","9ee3a8ef1b4d8b5d23ae68c79878f83d9a7ffdf02ec93cff53f7b1de6029f4d6","a4833cae7a4c9fb584ea039b983786560a2b10b0c930f1613f0f11807fc30bc6","b08252b53f111fda758564f01d6aeb287a86ceee9730eba0ca5fcf7c7dadb00e","5397ebe3cc2afa3393b897343a62f60e5b485315d8236802a715ec930f5cc336","9179ba236853e4a73f15d3d408619f0f62540850e6daa878c17cdc8a8f26dbb9","dd3de490bf00baf5087f33777fa272abbec9623033d71526d5355fb97ee7f36f","16c8d70f7d429c511b56c375317337c5d5c75b5a185ec91bf088b77069963fb7","acd6206245de4b9556a4853ff1b8b41875944834aa76df6c7d72af763f365262","3c4c80e1e11044a4d07c2d065ab1badcf74a3b84af6435503a27154aade28f9b","fc9315bf524ca308b0c391e36a688379df72c889c05fdf4abc33e697d9c52950","83ea4603c8d7c4e385e2a5a56b219d9df5c0fee5205e6fe06f494300607e7bd3","b9a08b77c8ae5896142912860e96f5f5f30539724189d281ac0db0878cc36032","cb28f2f651e26cdcfbc6dbf617e1b948e5ad041b09b11eb9ec2fafdf2e4d7e03","8b24573e0133d1c5ee95e1377545628b16380b4d3d980bde5296376e8173041e","7423559940944ed0cc1fe176b76253cf9035dcdbfc0fac2f3e385feb311a2329","288cc60197c635a28716a1c3a9133085106b36b1009fb0a2849670c1b99dfd9f","6c7b310dcbc8d96a02a730ad9f465f9cb8d27d538cad81a7ddcbf3966588c377","6baf6c1893da44d26235d2fc2a396145b9fccaef85e8e008b2201b7e4c6d23d4","c3d5fe222eec09ec592d002b78bb93f1a57fc8016ed84e2d2f3fc9fc9b0a941b","23da18bbbcbc650fad7a07ef8006251a7a06ae59113986d1a2b8d37f6d71a8d1"],"paragraph_range_zero_based":[48,71],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2406297.zip::R2-2406297 Correction on SP positioning SRS MAC CE-r18.docx:p48"}
{"fields":{"filename":"R2-2406297.zip::R2-2406297 Correction on SP positioning SRS MAC CE-r18.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":72},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":73},{"literal_text_all_w_t_and_m_t":"1/ Wrong text for the spec of SP positioning SRS activation/deactivation MAC CE","paragraph_zero_based":74},{"literal_text_all_w_t_and_m_t":"2/ It is not clear when Positioning SRS Resource Set's BWP ID and Cell ID should be present or not present when the A/D is set to 0/1","paragraph_zero_based":75},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":76},{"literal_text_all_w_t_and_m_t":"Inter-Operability analysis:","paragraph_zero_based":77},{"literal_text_all_w_t_and_m_t":"Impacted functionality:","paragraph_zero_based":78},{"literal_text_all_w_t_and_m_t":"SP positioning SRS activation/deactivation MAC CE","paragraph_zero_based":79},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":80},{"literal_text_all_w_t_and_m_t":"Inter-operability: ","paragraph_zero_based":81},{"literal_text_all_w_t_and_m_t":"1st change: There is no inter-operability issue for the first change","paragraph_zero_based":82},{"literal_text_all_w_t_and_m_t":"2nd change:","paragraph_zero_based":83},{"literal_text_all_w_t_and_m_t":"If the NW is implemented according to the change while the UE is not, the UE may wrongly interpretate the meaning of the field, while may cause the wrong UE behavior","paragraph_zero_based":84},{"literal_text_all_w_t_and_m_t":"If the UE is implemented according to the change while the NW is not, field will be set in-consistently that the UE thinks the MAC CE is wrongly complied and refuses to follow the MAC CE command.","paragraph_zero_based":85},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":86},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":87},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":88},{"literal_text_all_w_t_and_m_t":"6.1.3.36","paragraph_zero_based":89},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":90},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":91},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":92},{"literal_text_all_w_t_and_m_t":"Y","paragraph_zero_based":93},{"literal_text_all_w_t_and_m_t":"N","paragraph_zero_based":94},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":95}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ff084789d8d403d286304fa49e727684f7808cbf541e6fc9a1454dd30a273955","original_member_sha256":"cf43fff4423531a67c38d4767438dc4ea28dbb1e34d24012420240224409c91e","paragraph_ElementTree_utf8_XML_sha256":["85f9fe225bf206da5b28016fbb39c62cb1368eb1244f4f20547ea6629294dc69","378adf0aa423995360841de5b3ff121413a3320bd55a44c2044b1a4823324310","6ec0cdbac0e9a682baf722d80e0db218a9566e0dc2777d4459235c7ee67ee54c","03dda72c6fdf691618ed5a3dcb79ebc4019d6fe3efdf9e6a1c945f89189f3690","ec3c3afe03f3ca83ad77d51464e8ad78bda7f68211893f767ccb3f63cd98c019","4798585dd2621486cb23519903f91b787764a4ae67245807afd98f448593dd5d","083a3f2f53f231a23a2f51f0fa7bd78712bcceab06beb7d88efa2cd03122abd2","8b5d36abaf11325c6ad5b737ba6005d45b66a06128113bbe3734cc103c6f9e65","b5a033f73942aeb0c03cb2ec1afb860b6066b3c5d49d87c2d8be3bdd992e7e73","e9f4627a47d2856de8eb883143c84f4673d12647047a4d2b17e4a6799e2fa335","fb8ab39132eb2f3737da78d84ba34bc7b6d4dff2831abbb9992972eb13884eef","c51e52be53ffcb2f27620776c23422c3376c714d806b27c813be20dad2f3fbc4","a9e90d75cc052924fa5f394360807daffdcd0597613b9cb9d5f085552591d4a1","3866422a54398b291a7e6be8296c7037ad0fb12f466b6cff5bab15926d19b154","d3098623b4dfc23a1a4b383cc6c305d01a4c1c56ac54d5853c2f6542bbe0ad3e","d88bc81b05cdcb5373fcefe52e78f5e5b7ea4e37e19c0d9ebb00bb2abbe8ad2d","61cf31ccb32ca743f815831546a63f3d4f37ea5f4ff7e02e623d0e686dc91277","ce4