{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2160},{"literal_text_all_w_t_and_m_t":"-- Regular non-critical extensions:","paragraph_zero_based":2161},{"literal_text_all_w_t_and_m_t":"RRCReconfiguration-v1530-IEs ::=            SEQUENCE {","paragraph_zero_based":2162},{"literal_text_all_w_t_and_m_t":"    masterCellGroup                         OCTET STRING (CONTAINING CellGroupConfig)                              OPTIONAL, -- Need M","paragraph_zero_based":2163},{"literal_text_all_w_t_and_m_t":"    fullConfig                              ENUMERATED {true}                                                      OPTIONAL, -- Cond FullConfig","paragraph_zero_based":2164},{"literal_text_all_w_t_and_m_t":"    dedicatedNAS-MessageList                SEQUENCE (SIZE(1..maxDRB)) OF DedicatedNAS-Message                     OPTIONAL, -- Cond nonHO","paragraph_zero_based":2165},{"literal_text_all_w_t_and_m_t":"    masterKeyUpdate                         MasterKeyUpdate                                                        OPTIONAL, -- Cond MasterKeyChange","paragraph_zero_based":2166},{"literal_text_all_w_t_and_m_t":"    dedicatedSIB1-Delivery                  OCTET STRING (CONTAINING SIB1)                                         OPTIONAL, -- Need N","paragraph_zero_based":2167},{"literal_text_all_w_t_and_m_t":"    dedicatedSystemInformationDelivery      OCTET STRING (CONTAINING SystemInformation)                            OPTIONAL, -- Need N","paragraph_zero_based":2168},{"literal_text_all_w_t_and_m_t":"    otherConfig                             OtherConfig                                                            OPTIONAL, -- Need M","paragraph_zero_based":2169},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                    RRCReconfiguration-v1540-IEs                                           OPTIONAL","paragraph_zero_based":2170},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2171},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2172},{"literal_text_all_w_t_and_m_t":"RRCReconfiguration-v1540-IEs ::=        SEQUENCE {","paragraph_zero_based":2173},{"literal_text_all_w_t_and_m_t":"    otherConfig-v1540                       OtherConfig-v1540                                                      OPTIONAL, -- Need M","paragraph_zero_based":2174},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                    RRCReconfiguration-v1560-IEs                                           OPTIONAL","paragraph_zero_based":2175},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2176},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2177},{"literal_text_all_w_t_and_m_t":"RRCReconfiguration-v1560-IEs ::=         SEQUENCE {","paragraph_zero_based":2178},{"literal_text_all_w_t_and_m_t":"    mrdc-SecondaryCellGroupConfig            SetupRelease { MRDC-SecondaryCellGroupConfig }                        OPTIONAL,   -- Need M","paragraph_zero_based":2179},{"literal_text_all_w_t_and_m_t":"    radioBearerConfig2                       OCTET STRING (CONTAINING RadioBearerConfig)                           OPTIONAL,   -- Need M","paragraph_zero_based":2180},{"literal_text_all_w_t_and_m_t":"    sk-Counter                               SK-Counter                                                            OPTIONAL,   -- Need N","paragraph_zero_based":2181},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                     RRCReconfiguration-v1610-IEs                                          OPTIONAL","paragraph_zero_based":2182},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2183}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9