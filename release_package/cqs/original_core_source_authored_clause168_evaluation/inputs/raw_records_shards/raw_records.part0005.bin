,{"literal_text_all_w_t_and_m_t":"SC-RNTI","paragraph_zero_based":858},{"literal_text_all_w_t_and_m_t":"FFFC","paragraph_zero_based":859},{"literal_text_all_w_t_and_m_t":"CC-RNTI","paragraph_zero_based":860},{"literal_text_all_w_t_and_m_t":"FFFD","paragraph_zero_based":861},{"literal_text_all_w_t_and_m_t":"M-RNTI","paragraph_zero_based":862},{"literal_text_all_w_t_and_m_t":"FFFE","paragraph_zero_based":863}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"252e3db5c0fe6d9887e82b2df2ea8829102397c8af77f7385ddec9a6c33e6ae4","original_member_sha256":"0ffdcfe63374625f16531d69d191fb330a4f3ecc2b0886fb54c08f68a4b7f2f4","paragraph_ElementTree_utf8_XML_sha256":["46023c2a425279b3f36fb23fdd9ea655baef2236841b2fbb2f13e1221b227213","301724f9dc299f4e1dcfcb80ec7dd961d81415bc05e2d705541ab66672fdbc1e","fc1067de89b88179b1aeb1b84b548e40d764f7f7ec412d75b105f04fe5ffcf66","9420f112594529a9dca76b11ecbdbec60abf9ffd1a6f032a0fdb964331a4fd5c","08ded29f5981c1c0ed7ace6d21d219df4a406ac18c85c63c4cb98b5b51a1ed81","c2e092c24d501267437693dfb7f4e0a794ccadd104681b4ab8740bd0bc447b32","a8980f633bec539e4066b11c6299cfd6b76935311d41a75b089891c2f6ca8495","c74e9e33a335648d02b7cd2b3af04c0c2d2ba9a394fcc6874f494fa027aa4971","baf81c4323620f4c1a9dca4c34c36a800e19467c5d95c012d9b3742122a2ef56","10f7ea1c74443dff85305289743c46313145bccaf6bc113dba1e04d42d42d610","f306e25afdc5ae81380d5b1333bbda92c30c0f4965bb527b23a91f162203f1a6","09d8421669503bbe44509fd1d82e9a0df3c085c5ea1e6ce891919d323fa97008","c05e84745726f4b87c633a60dbdb28c6a99a4300d3a75c04f9c360b755a465b6","8372b8b78cbdf0f669dba567e9cd88c587f78ffe9b33adc8e38ffe2683a0b358","0d089a6d1acc7fd410dfe569f8ea231a9168e1ae7c4179aef2fe92572f4543c5","9607eb7f798cb4593742330a04ff8969e49b0d048c45e5a26bdb71078914f8db","cc6d8ea061dc41f5a1b08d3fe8f66b24c5618ce6d252931e329dbf974c5a6bcc","363e2480ae122ab381ee647caedfcc518fa27a1c680aec38bb861a78700356fe","973bf8a224b98299f42ea7aa28ffd