{"fields":{"filename":"R2-2509465.zip::R2-2509465.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"nr-DL-AoD-LocationInformationInstances-r17SEQUENCE (SIZE (1..maxMeasInstances-r17)) OF","paragraph_zero_based":552},{"literal_text_all_w_t_and_m_t":"NR-DL-AoD-LocationInformation-r16OPTIONAL-- Cond batchUEB","paragraph_zero_based":553},{"literal_text_all_w_t_and_m_t":"]]","paragraph_zero_based":554},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":555},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":556},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":557},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":558},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":559},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":560},{"literal_text_all_w_t_and_m_t":"batchUEA","paragraph_zero_based":561},{"literal_text_all_w_t_and_m_t":"The field is optionally present if the field nr-DL-AoD-SignalMeasurementInformation is absent; otherwise it is not present.","paragraph_zero_based":562},{"literal_text_all_w_t_and_m_t":"batchUEB","paragraph_zero_based":563},{"literal_text_all_w_t_and_m_t":"The field is optionally present if the field nr-dl-AoD-LocationInformation is absent; otherwise it is not present.","paragraph_zero_based":564},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":565},{"literal_text_all_w_t_and_m_t":"[…]","paragraph_zero_based":566},{"literal_text_all_w_t_and_m_t":"6.5.11.5NR DL-AoD Location Information Request","paragraph_zero_based":567},{"literal_text_all_w_t_and_m_t":"–NR-DL-AoD-RequestLocationInformation","paragraph_zero_based":568},{"literal_text_all_w_t_and_m_t":"The IE NR-DL-AoD-RequestLocationInformation is used by the location server to request NR DL-AoD location information from a target device.","paragraph_zero_based":569},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":570},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":571},{"literal_text_all_w_t_and_m_t":"NR-DL-AoD-RequestLocationInformation-r16 ::= SEQUENCE {","paragraph_zero_based":572},{"literal_text_all_w_t_and_m_t":"nr-AssistanceAvailability-r16BOOLEAN,","paragraph_zero_based":573},{"literal_text_all_w_t_and_m_t":"nr-DL-AoD-ReportConfig-r16NR-DL-AoD-ReportConfig-r16,","paragraph_zero_based":574},{"literal_text_all_w_t_and_m_t":"...,","paragraph_zero_based":575}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"031803c101a10e427d1f230cc629e09e0bd01d184d1e2938f387ad803c3911dc","original_member_sha256":"2bae8d5ac03017cc49187eaa8fa5f66dd9d41d8add52aa40b5603598875c82af","paragraph_ElementTree_utf8_XML_sha256":["fe3210f1ad95e8d1c07edf4329011a42e5aa40536a709530493eee8d95bf10f9","6427775b7fd54114fbc3969a6889e9fd65b4f7d895a106138d618886f3f5b078","5c8cdc687e8d3a05d324403d8eb3b39af53889b2617485e75a65a941837263d4","54bfb40f2a890a5d3c7658d2e34903e9c40a1bdc773ee3e5bb87d0bef4226c71","2e26a097ae4dc0ab155dcd3dab103f771f771178ab7033273be17847e9a44920","17bde39413ea5fc278951423e9b1369f88b71a7dc6f826a94d559f0d13053276","4250703085e5120a5edc2c78c32ace67bf22b12ec862166bc0ff0b97d7a7b48e","1af39b18f943cd72eab1c27c69756414dcc9d29a622f1468c87858da8e729cc7","c0152927847d617682663d8a510b5348955568e25b932446430d342ad2ce5b58","890019a69910ad742f32d288e06a8b63f7c158de5d7fbb9fcb7e538b06ca73e6","63e4689d57eeef1b86915322656817cc9e739cb0ef811ed4f754da67d2afbdc5","e8412cba986a9ece87d6b7f342ba3e2463418046cff4c3f3350d1a147ddb4541","72f12dcefea2bd33a06f3215e8e278f829f44833cdb71c77e449321b8f0c18a0","6f02e5dc58e61cb48a8bfaef423ea16aa66470ca502fbca02cd494b9e1aea944","8074eb227d35a1e0bf610522e8176885a61026d016dbe436301a1f475822ef2c","d4442ca675e961aa79148c78048af044a675ba5715ba700e4257d003c0772be5","db36a5fdfa757e3a8e3a15b7ed4c00f14b2d68ad1752f2f654718526d4b03b1a","9177ca2b05d428ceb4c851