ero_based":[72,95],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2505201.zip::R2-2505201 MAC CR1591 for R19 IoT NTN.docx:p72"}
{"fields":{"filename":"R2-2505201.zip::R2-2505201 MAC CR1591 for R19 IoT NTN.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":96},{"literal_text_all_w_t_and_m_t":"(show related CRs)","paragraph_zero_based":97},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":98},{"literal_text_all_w_t_and_m_t":"x","paragraph_zero_based":99},{"literal_text_all_w_t_and_m_t":" O&M Specifications","paragraph_zero_based":100},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":101},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":102},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":103},{"literal_text_all_w_t_and_m_t":"Other comments:","paragraph_zero_based":104},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":105},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":106},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":107},{"literal_text_all_w_t_and_m_t":"This CR's revision history:","paragraph_zero_based":108},{"literal_text_all_w_t_and_m_t":"R2-2502768, R2-2504525","paragraph_zero_based":109},{"literal_text_all_w_t_and_m_t":"3Definitions and abbreviations","paragraph_zero_based":110},{"literal_text_all_w_t_and_m_t":"3.1Definitions","paragraph_zero_based":111},{"literal_text_all_w_t_and_m_t":"For the purposes of the present document, the terms and definitions given in TR 21.905 [1] and the following apply. A term defined in the present document takes precedence over the definition of the same term, if any, in TR 21.905 [1].","paragraph_zero_based":112},{"literal_text_all_w_t_and_m_t":"Active Time: Time related to DRX operation, as defined in clause 5.7, during which the MAC entity monitors the PDCCH.","paragraph_zero_based":113},{"literal_text_all_w_t_and_m_t":"CB-Msg3: Contention based message transmitted on UL-SCH as part of a CB-Msg3-EDT procedure.","paragraph_zero_based":114},{"literal_text_all_w_t_and_m_t":"CB-Msg4: The response message to one or more CB-Msg3.","paragraph_zero_based":115},{"literal_text_all_w_t_and_m_t":"CB-RNTI: The contention based RNTI used on PDCCH when CB-Msg4s are transmitted.","paragraph_zero_based":116},{"literal_text_all_w_t_and_m_t":"CB-Msg3ResponseTimer: Specifies the number of consecutive subframe(s) during which the MAC entity shall monitor the PDCCH after CB-Msg3(s) are transmitted.","paragraph_zero_based":117},{"literal_text_all_w_t_and_m_t":"mac-ContentionResolutionTimer: Specifies the number of consecutive subframe(s) during which the MAC entity shall monitor the PDCCH after Msg3 is transmitted.","paragraph_zero_based":118},{"literal_text_all_w_t_and_m_t":"DRX Cycle: Specifies the periodic repetition of the On Duration followed by a possible period of inactivity (see figure 3.1-1 below).","paragraph_zero_based":119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"252e3db5c0fe6d9887e82b2df2ea8829102397c8af77f7385ddec9a6c33e6ae4","original_member_sha256":"0ffdcfe63374625f16531d69d191fb330a4f3ecc2b0886fb54c08f68a4b7f2f4","paragraph_ElementTree_utf8_XML_sha256":["ff0e8e54032be9a53798bda19e41b99f2a20ee5170c163722bb04c40e5ea4145","3f6c0636500f9eef4f976a3222dad49fa591d92d083a0c37d7d3491dfce7b61d","327cd85ee7da431c045798ee6ab64d909f439fd3f2c00cbb942f54dac4609929","d06b36d6ea04a7a9a3b0c7036ea89bb2b8da0ed8411e79d0dce4fde2eae6505f","a5471ff6fbb3b2e8af61ac981586d7d70f93791817bf53c84d3f76bd15f131c1","dbf3a5704772a06e6604fcd606246cbaae11211198c03453314a3becb53ef9ea","be51a5c520e6ea0dc7b2953745a95c029dfde124c2ee46aa9be85e41a7420014","bba49ef95975ad65287b98ccb3dcc2aec358df5a063b8a3563cd7c48ae93e67c","28095512b715b77ac17e57eb7f5377c8fd44d4d5dbb2bd60d198d27af7f3130f","3df72355c3f057b32145da8c9ab632326ba5d4470456f61d98cf4de320bc2774","5f5de34aed11cb70eb4609053590462e182996be4c25d5b28fe63b95f12fa7cd","c6bf7cb8d726ac103a73ccb78a98600c9212c64d2382c8fbffb7602afb259b6b","6825517c34d62f7b5184239b06d9ee9022168d459399a61f81d8790beb0bf8ff","fc9fe9ed3b79db7cb41d328f5f9dc105d90efd316c0a364a0b76ca99b03d3230","8df2d4ce6d537951392d125f4648f9ad8ab83fb60a8b4eb89a43eeacb14f20db","8e852a60c446ead7f4d176282e76c37a294c8f6955197971267187d69b3aa080","850cb4c26b62a515b323a11092c0e6069763449776fab2e5695952e3dc3b461d","1a8fbdaf820ba987637c60bc3e42a3283135775c396fa24a8b0636a0e3c1c953","21e2aec2ccbcaa4f341ce564572967b6fa7a9356df5a92f97b6840dcbfcf5c22","cc5bdce188d4e3d848aa115eb9049b50a38790fa745f7b2d0b89ffddd223b35d","ba238060a198e7b172dc119e04b57b10d2c85efd43d3f8123bd1288ae852f89b","210f2d0f23220e0f4df43a140be2226269ab9d216253834a8dfbaae92fb84b3a","d0d0bc4d8d6cc3710136e6a070b2f110a8e531e809ee356d80ba81d58e2dfae5","3013b372674d1d4e19feda0ed05672ff8e1af7a3a9a8441904bd43eabcc5047e"],"paragraph_range_zero_based":[96,119],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2505201.zip::R2-2505201 MAC CR1591 for R19 IoT NTN.docx:p96"}
{"fields":{"filename":"R2-2505201.zip::R2-2505201 MAC CR1591 for R19 IoT NTN.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":120},{"literal_text_all_w_t_and_m_t":"Figure 3.1-1: DRX Cycle","paragraph_zero_based":121},{"literal_text_all_w_t_and_m_t":"drx-InactivityTimer: Except for NB-IoT UEs, BL UEs or UEs in enhanced coverage, it specifies the number of consecutive PDCCH-subframe(s) after the subframe in which a PDCCH indicates an initial UL, DL or SL user data transmission for this MAC entity. For NB-IoT UEs, it specifies the number of consecutive PDCCH-subframe(s), after the subframe in which the HARQ RTT timer or UL HARQ RTT timer expires, or after PDCCH indicates a new UL or DL transmission for one TB when the UE is configured with multiple HARQ processes. For BL UEs or UEs in enhanced coverage, it specifies the number of consecutive PDCCH-subframe(s) following the subframe containing the last repetition of the PDCCH reception that indicates an initial UL or DL user data transmission for this MAC entity.","paragraph_zero_based":122},{"literal_text_all_w_t_and_m_t":"drx-RetransmissionTimer: Specifies the maximum number of consecutive PDCCH-subframe(s) until a DL retransmission is received.","paragraph_zero_based":123},{"literal_text_all_w_t_and_m_t":"drx-RetransmissionTimerShortTTI: Specifies the maximum number of consecutive TTI(s) until a DL retransmission is received for HARQ processes scheduled using short TTI.","paragraph_zero_based":124},{"literal_text_all_w_t_and_m_t":"drxShortCycleTimer: Specifies the number of consecutive subframe(s) the MAC entity shall follow the Short DRX cycle.","paragraph_zero_based":125},{"literal_text_all_w_t_and_m_t":"drxStartOffset: Specifies the subframe where the DRX Cycle starts.","paragraph_zero_based":126},{"literal_text_all_w_t_and_m_t":"drx-ULRetransmissionTimer: Specifies the maximum number of consecutive PDCCH-subframe(s) until a grant for UL retransmission or the HARQ feedback is received.","paragraph_zero_based":127},{"literal_text_all_w_t_and_m_t":"drx-ULRetransmissionTimeShortTTI: Specifies the maximum number of consecutive TTI(s) until a grant for UL retransmission is received for HARQ processes scheduled using short TTI.","paragraph_zero_based":128},{"literal_text_all_w_t_and_m_t":"Early Data Transmission: Allows one uplink data transmission optionally followed by one downlink data transmission during the random access procedure as specified in TS 36.300 [20]. The S1 connection is established or resumed upon reception of the uplink data and may be released or suspended along with the transmission of the downlink data. Early data transmission refers to both CP-EDT and UP-EDT.","paragraph_zero_based":129},{"literal_text_all_w_t_and_m_t":"HARQ information: HARQ information for DL-SCH or for UL-SCH transmissions consists of New Data Indicator (NDI), Transport Block (TB) size. For DL-SCH transmissions and for asynchronous UL HARQ and for autonomous UL HARQ, the HARQ information also includes HARQ process ID, except for UEs in NB-IoT configured with a single HARQ process for which this information is not present. For UL-SCH transmission the HARQ information also includes Redundancy Version (RV). In case of spatial multiplexing on DL-SCH the HARQ information comprises a set of NDI and TB size for each transport block. HARQ information for SL-SCH and SL-DCH transmissions consists of TB size only.","paragraph_zero_based":130},{"literal_text_all_w_t_and_m_t":"HARQ RTT Timer: This parameter specifies the minimum amount of subframe(s) before a DL assignment for HARQ retransmission is expected by the MAC entity.","paragraph_zero_based":131},{"literal_text_all_w_t_and_m_t":"Msg3: Message transmitted on UL-SCH containing a C-RNTI MAC CE or a CCCH SDU optionally multiplexed with DTCH for the UP-EDT, submitted from upper layer and associated with the UE Contention Resolution Identity, as part of a random access procedure.","paragraph_zero_based":132},{"literal_text_all_w_t_and_m_t":"NB-IoT: NB-IoT allows access to network services via E-UTRA with a channel bandwidth limited to 200 kHz.","paragraph_zero_based":133},{"literal_text_all_w_t_and_m_t":"NB-IoT UE: A UE that uses NB-IoT.","paragraph_zero_based":134},{"literal_text_all_w_t_and_m_t":"NR sidelink communication: AS functionality enabling at least V2X Communication as defined in TS 23.287 [23], between two or more nearby UEs, using NR technology but not traversing any network node.","paragraph_zero_based":135},{"literal_text_all_w_t_and_m_t":"Non-terrestrial networks: An E-UTRAN consisting of eNBs, which provide non-terrestrial LTE access to UEs by means of an NTN payload embarked on a space-borne NTN vehicle and an NTN Gateway.","paragraph_zero_based":136},{"literal_text_all_w_t_and_m_t":"onDurationTimer: Specifies the number of consecutive PDCCH-subframe(s) at the beginning of a DRX Cycle.","paragraph_zero_based":137},{"literal_text_all_w_t_and_m_t":"PDCCH: Refers to the PDCCH (see TS 36.211 [7]), EPDCCH (in subframes when configured), MPDCCH (see TS 36.213 [2]), for an RN with R-PDCCH configured and not suspended, to the R-PDCCH, for NB-IoT to the NPDCCH or for short TTI to SPDCCH.","paragraph_zero_based":138},{"literal_text_all_w_t_and_m_t":"PDCCH period (pp): Refers to the interval between the start of two consecutive PDCCH occasions and depends on the currently used PDCCH search space, as specified in TS 36.213 [2]. A PDCCH occasion is the start of a search space and is defined by subframe k0 as specified in clause 16.6 of TS 36.213 [2]. The calculation of number of PDCCH-subframes for the timer configured in units of a PDCCH period is done by multiplying the number of PDCCH periods with npdcch-NumRepetitions-RA when the UE uses the common search space or by npdcch-NumRepetitions when the UE uses the UE specific search space. When counting a timer whose length is calculated in PDCCH-subframes, the UE shall include PDCCH-subframes that will be dropped or not required to be monitored as specified in clause 16.6 of TS 36.213 [2]. The calculation of number of subframes for the timer configured in units of a PDCCH period is done by multiplying the number of PDCCH periods with duration between two consecutive PDCCH occasions.","paragraph_zero_based":139},{"literal_text_all_w_t_and_m_t":"PDCCH-subframe: Refers to a subframe with PDCCH. This represents the union over PDCCH-subframes for all serving cells excluding cells configured with cross carrier scheduling for both uplink and downlink, as specified in TS 36.331 [8]; except if the UE is not capable of simultaneous reception and transmission in the aggregated cells where this instead represents the PDCCH-subframes of the SpCell.","paragraph_zero_based":140},{"literal_text_all_w_t_and_m_t":"-For FDD serving cells, all subframes represent PDCCH-subframes, unless specified otherwise in this clause.","paragraph_zero_based":141},{"literal_text_all_w_t_and_m_t":"-For TDD serving cells, all downlink subframes and subframes including DwPTS of the TDD UL/DL configuration indicated by tdd-Config, as specified in TS 36.331 [8] of the cell represent PDCCH-subframes, unless specified otherwise in this clause.","paragraph_zero_based":142},{"literal_text_all_w_t_and_m_t":"-For serving cells operating according to Frame structure Type 3, all subframes represent PDCCH-subframes.","paragraph_zero_based":143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"252e3db5c0fe6d9887e82b2df2ea8829102397c8af77f7385ddec9a6c33e6ae4","original_member_sha256":"0ffdcfe63374625f16531d69d191fb330a4f3ecc2b0886fb54c08f68a4b7f2f4","paragraph_ElementTree_utf8_XML_sha256":["b928d468547e195bee25efb004a4811dba63f49fe5c5fe5a7814bd57e615618b","2d774046b58762cd806485d6408ae37ff38f2594afd596ee362d82390b99a58f","8a6027df3a790c05da00250b90649e99232efd192ca72bd0de48f0ce127653ed","825c4e36fa519b0cff73188c1e98555182a6fa542fa5d55242e2f72fdde256c6","7407fe51d5f24f5692796501474b206a87bb545313b908cbd4d8b0fef187bb35","2edac7f8ac48f4bb600f63ba14854940cc825de0a1cf7a76ffe34ddbe430b4ca","815289186c91f290dc607f1d720236754264020b28b4c1a8be43b4de4a2c998a","09ebad3292a4572a1cfb278b40a00369b0c6c251c603ed2aa9881e7d4c019cf9","9624de5ce8747c03f72d1ce84ffdc94f7fa176f1e81f1ece3e8d9b48eda43de5","8adf88dd92311b700cf2f074ae694b6a68155e85e5060567886e927028e6ca61","b129b3c36a9d2afb2fd962ff630a5dad114e490eb33024d15421963c6e7c1c33","c3be6955b0683a9210c0da69ebe9518b9eba44cf13ef425bff412c3582ca9b49","b3980dab5cbb03c96d5f1519e688078eca13bb05e1bf3f38271ff5b6df51ef45","42bc93c6ec0e932a638e886030d8f245695d460b56ed7866c93451f6844a115f","cdbe6328af7637a73e72c4654618b4275cd2e681ad9759be16e9f0b1eaf85e1e","cb3f7109b9fa8162eef7d2bdcb735e6d18181c8e378ada242ffc48a4d95aa5c4","989a57ca417816473bf3210e27b69f0136cb49de2d971652a0f17cb683921158","5bc4da178ae4f0b582781ef44a376ab1b789d25d4a94ee1ee14d152f8ed035e5","e187a7bdd77b1c3a9e1c7950faae8d0abb93af989ab36e5a3b9d33a594833d14","2f974d768569c02e06e72cfbeec98ee3fc80df241e02ad0062a19634f7424d07","601885a105996c5beec18647d1e987b439c8195c612b1726268ec53204f9961c","7679a46a37bc90aa8cdb1c3ccfc736160a15d9525ebe97129db0acae612c6b80","1ce49ea346ddc19eda9e406919bf083f89d89fe788e412cc45658240225f3368","5a3e1850b5130c64190cf25814993f8fe405bb5c5e6370483eb8d55e5f7c38e7"],"paragraph_range_zero_based":[120,143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2505201.zip::R2-2505201 MAC CR1591 for R19 IoT NTN.docx:p120"}
{"fields":{"filename":"R2-2505201.zip::R2-2505201 MAC CR1591 for R19 IoT NTN.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-For RNs with an RN subframe configuration configured and not suspended, in its communication with the E-UTRAN, all downlink subframes configured for RN communication with the E-UTRAN represent PDCCH-subframes.","paragraph_zero_based":144},{"literal_text_all_w_t_and_m_t":"-For SC-PTM reception on an FDD cell, all subframes except MBSFN subframes represent PDCCH-subframes, unless specified otherwise in this clause.","paragraph_zero_based":145},{"literal_text_all_w_t_and_m_t":"-For SC-PTM reception on a TDD cell, all downlink subframes and subframes including DwPTS of the TDD UL/DL configuration indicated by tdd-Config, as specified in TS 36.331 [8] of the cell except MBSFN subframes represent PDCCH-subframes, unless specified otherwise in this clause.","paragraph_zero_based":146},{"literal_text_all_w_t_and_m_t":"-For BL UE or UE in enhanced coverage, all subframes in which the UE is required to monitor MPDCCH represent PDCCH-subframes among all valid subframes regardless of whether the subframe is dropped, see clause 9.1.5 of TS 36.213 [2].","paragraph_zero_based":147},{"literal_text_all_w_t_and_m_t":"-For NB-IoT UE, all subframes that are part of the NPDCCH search space represent PDCCH-subframes among all NB-IoT downlink subframes, including those which the UE is not required to monitor as specified in clause 16.6 of TS 36.213 [2].","paragraph_zero_based":148},{"literal_text_all_w_t_and_m_t":"PDSCH: Refers to subframe-PDSCH/slot-PDSCH/subslot-PDSCH or for NB-IoT to NPDSCH.","paragraph_zero_based":149},{"literal_text_all_w_t_and_m_t":"PRACH: Refers to PRACH or for NB-IoT to NPRACH.","paragraph_zero_based":150},{"literal_text_all_w_t_and_m_t":"PRACH Resource Index: The index of a PRACH within a system frame, see TS 36.211 [7]","paragraph_zero_based":151},{"literal_text_all_w_t_and_m_t":"Primary Timing Advance Group: Timing Advance Group containing the SpCell.","paragraph_zero_based":152},{"literal_text_all_w_t_and_m_t":"PUCCH SCell: An SCell configured with PUCCH/SPUCCH.","paragraph_zero_based":153},{"literal_text_all_w_t_and_m_t":"PUSCH: Refers to subframe-PUSCH/slot-PUSCH/subslot-PUSCH or for NB-IoT to NPUSCH.","paragraph_zero_based":154},{"literal_text_all_w_t_and_m_t":"ra-PRACH-MaskIndex: Defines in which PRACHs within a system frame the MAC entity can transmit a Random Access Preamble (see clause 7.3).","paragraph_zero_based":155},{"literal_text_all_w_t_and_m_t":"RA-RNTI: The Random Access RNTI is used on the PDCCH when Random Access Response messages are transmitted. It unambiguously identifies which time-frequency resource was utilized by the MAC entity to transmit the Random Access preamble.","paragraph_zero_based":156},{"literal_text_all_w_t_and_m_t":"SC Period: Sidelink Control period, the time period consisting of transmission of SCI and its corresponding data.","paragraph_zero_based":157},{"literal_text_all_w_t_and_m_t":"SCI: The Sidelink Control Information contains the sidelink scheduling information such as resource block assignment, modulation and coding scheme, Group Destination ID (for sidelink communication) and PPPP (for V2X sidelink communication), see TS 36.212 [5].","paragraph_zero_based":158},{"literal_text_all_w_t_and_m_t":"Secondary Timing Advance Group: Timing Advance Group not containing the SpCell. A Secondary Timing Advance Group contains at least one Serving Cell with an UL configured.","paragraph_zero_based":159},{"literal_text_all_w_t_and_m_t":"Serving Cell: A Primary or a Secondary Cell, see TS 36.331 [8].","paragraph_zero_based":160},{"literal_text_all_w_t_and_m_t":"Short Processing Time: For 1 ms TTI length, the operation with short processing time in UL data transmission and DL data reception.","paragraph_zero_based":161},{"literal_text_all_w_t_and_m_t":"Short TTI: TTI length based on a slot or a subslot.","paragraph_zero_based":162},{"literal_text_all_w_t_and_m_t":"Sidelink: UE to UE interface for sidelink communication, sidelink discovery and V2X sidelink communication. The sidelink corresponds to the PC5 interface as defined in TS 23.303 [13] for sidelink communication and sidelink discovery, and as defined in TS 23.285 [14] for V2X sidelink communication.","paragraph_zero_based":163},{"literal_text_all_w_t_and_m_t":"Sidelink communication: AS functionality enabling ProSe Direct Communication as defined in TS 23.303 [13], between two or more nearby UEs, using E-UTRA technology but not traversing any network node.","paragraph_zero_based":164},{"literal_text_all_w_t_and_m_t":"Sidelink Discovery Gap for Reception: Time period during which the UE does not receive any channels in DL from any serving cell, except during random access procedure.","paragraph_zero_based":165},{"literal_text_all_w_t_and_m_t":"Sidelink Discovery Gap for Transmission: Time period during which the UE prioritizes transmission of sidelink discovery and associated procedures e.g. re-tuning and synchronisation over transmission of channels in UL, if they occur in the same subframe, except during random access procedure.","paragraph_zero_based":166},{"literal_text_all_w_t_and_m_t":"Special Cell: For Dual Connectivity operation the term Special Cell refers to the PCell of the MCG or the PSCell of the SCG, otherwise the term Special Cell refers to the PCell.","paragraph_zero_based":167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"252e3db5c0fe6d9887e82b2df2ea8829102397c8af77f7385ddec9a6c33e6ae4","original_member_sha256":"0ffdcfe63374625f16531d69d191fb330a4f3ecc2b0886fb54c08f68a4b7f2f4","paragraph_ElementTree_utf8_XML_sha256":["a7db518ff9cfa4d3753b5547d8cbb93de0ee624ed25777be25ff86fca5f6e14d","66961574519672794c74ddf062619a8518a780ca9d09394e3d56cafdf0945535","9ae39e12dacb49cf3467a8f3abd3cd9a23cf3f839d5b4cbf21459d8afe36b130","49f619b6a70b033de0d8c8f45d520300ee1e5127baf4c30ca5ad77da795ff630","65e7c1af6c1850579ddaa568cbdc93bb8722ef85b72ebba8ba41c8d335a25931","00980159b9070fc86055ddcc0142fd5bc44bb36baf3c3c2dedb0ff7f8b327b4a","36429d9ac7ef448521b78a316e406b639afdab1de352a6f1790461bfa54660ce","9a629e15ee66d8e59afaa8a7120c2bf4b6a40d119f460beec14612f5499efa54","6d52f18ff4be6181d0df3dd51d14929176306a0c777f38129565ef70b1b4e6f5","1a041f62c7c598b1666a3b43c2a3259022b84045f2576e3f6a8ad09276fc5a4a","a66f0e6da3ea04f18caeac57b9fe24f90b546cd59b3d419cc185327600ad1e90","a4f52ec71a4a39e136080c57d1592850305d3d3bda7d1755aa37bb510ddf6c42","fdddc303e02a0dc895926e6733ae3bb38df6b1d7c110821c6e802248a68ae767","e6dce2bdd21f7fefadbb7a091ff529fb1d356170507ca39f09998c1ec78aeedd","4bebc4f5910bf74378cf2a5f0fc409a26a7584a20d32fcfdf6db35567aae0f9d","0cceefecc9ae9a3df61eb44678eecc2429d4974c4ed2d35e1dcf5d26c4c9965f","96c6044759863046f48849fe9676679273def72a8ebe1671706938125700f35a","f69e21eddedf464a3a91e985525beb95d8ffb26904b9fa3004e15312e9b78d2b","99f951011d18a74c3200758136f042a393e72e214dd835ac06fb49aa3c423c01","75e93991e12d15c84ed56475c3698745c3024e12dc3cd924dda62670d9bed332","0e691a72031cdb58f6d029133cefd95bb3b0d41026e8117fb94264e270efeac2","949ab4710fc513a7792604c606cb0023d7c7512534350197ea06d1979809170e","1ba4eeacd8091b08c04189a3cd7e256469e466d2171f055233a41f9300c88e65","9c6bf824692b8c5d432172668539765e8b6a53550873dce474f2f48417f93f0b"],"paragraph_range_zero_based":[144,167],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2505201.zip::R2-2505201 MAC CR1591 for R19 IoT NTN.docx:p144"}
{"fields":{"filename":"R2-2505201.zip::R2-2505201 MAC CR1591 for R19 IoT NTN.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Timing Advance Group: A group of Serving Cells that is configured by RRC and that, for the cells with an UL configured, using the same timing reference cell and the same Timing Advance value.","paragraph_zero_based":168},{"literal_text_all_w_t_and_m_t":"Transmission using PUR: Allows one uplink data transmission using preconfigured uplink resource from RRC_IDLE mode as specified in TS 36.300 [9]. Transmission using PUR refers to both CP transmission using PUR and UP transmission using PUR.","paragraph_zero_based":169},{"literal_text_all_w_t_and_m_t":"UE-eNB RTT: For non-terrestrial networks, the sum of the UE's Timing Advance value (see TS 36.211 [7], clause 8.1) and k-Mac in units of subframe, not rounded or truncated toward an integer number of subframes.","paragraph_zero_based":170},{"literal_text_all_w_t_and_m_t":"UL HARQ RTT Timer: This parameter specifies the minimum amount of subframe(s) before a UL HARQ retransmission grant is expected by the MAC entity.","paragraph_zero_based":171},{"literal_text_all_w_t_and_m_t":"V2X sidelink communication: AS functionality enabling V2X Communication as defined in TS 23.285 [14], between nearby UEs, using E-UTRA technology but not traversing any network node.","paragraph_zero_based":172},{"literal_text_all_w_t_and_m_t":"NOTE:A timer is running once it is started, until it is stopped or until it expires; otherwise it is not running. A timer can be started if it is not running or restarted if it is running. A Timer is always started or restarted from its initial value.","paragraph_zero_based":173},{"literal_text_all_w_t_and_m_t":"3.2Abbreviations","paragraph_zero_based":174},{"literal_text_all_w_t_and_m_t":"For the purposes of the present document, the abbreviations given in TR 21.905 [1] and the following apply. An abbreviation defined in the present document takes precedence over the definition of the same abbreviation, if any, in TR 21.905 [1].","paragraph_zero_based":175},{"literal_text_all_w_t_and_m_t":"ASAccess Stratum","paragraph_zero_based":176},{"literal_text_all_w_t_and_m_t":"AULAutonomous Uplink","paragraph_zero_based":177},{"literal_text_all_w_t_and_m_t":"BLBandwidth reduced Low complexity","paragraph_zero_based":178},{"literal_text_all_w_t_and_m_t":"BRBandwidth Reduced","paragraph_zero_based":179},{"literal_text_all_w_t_and_m_t":"BSRBuffer Status Report","paragraph_zero_based":180},{"literal_text_all_w_t_and_m_t":"C-RNTICell RNTI","paragraph_zero_based":181},{"literal_text_all_w_t_and_m_t":"CB-RNTIContention-Based RNTI","paragraph_zero_based":182},{"literal_text_all_w_t_and_m_t":"CBRChannel Busy Ratio","paragraph_zero_based":183},{"literal_text_all_w_t_and_m_t":"CC-RNTICommon Control RNTI","paragraph_zero_based":184},{"literal_text_all_w_t_and_m_t":"CGCell Group","paragraph_zero_based":185},{"literal_text_all_w_t_and_m_t":"CQIChannel Quality Indicator","paragraph_zero_based":186},{"literal_text_all_w_t_and_m_t":"CMRContention-based Msg3 Response","paragraph_zero_based":187},{"literal_text_all_w_t_and_m_t":"CRICSI-RS Resource Indicator","paragraph_zero_based":188},{"literal_text_all_w_t_and_m_t":"CSIChannel State Information","paragraph_zero_based":189},{"literal_text_all_w_t_and_m_t":"DAPSDual Active Protocol Stack","paragraph_zero_based":190},{"literal_text_all_w_t_and_m_t":"DCQRDownlink Channel Quality Report","paragraph_zero_based":191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"252e3db5c0fe6d9887e82b2df2ea8829102397c8af77f7385ddec9a6c33e6ae4","original_member_sha256":"0ffdcfe63374625f16531d69d191fb330a4f3ecc2b0886fb54c08f68a4b7f2f4","paragraph_ElementTree_utf8_XML_sha256":["fed967ae7b8a68c336ef8aff8155a2e8a799d9c1a455918459da7abc5c66a85e","d2bdfe4615d720425