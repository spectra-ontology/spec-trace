{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>if validatedMeasurementsReq is included in the RRCResume and measIdleValidityDuration is included in VarEnhMeasIdleConfig;","paragraph_zero_based":1224},{"literal_text_all_w_t_and_m_t":"5>set the measResultIdleEUTRA in the RRCResumeComplete message to the value of measReportIdleEUTRA in the VarMeasIdleReport for any valid measurement results, if available, and set validityStatus to the value of measIdleValidityDuration in VarEnhMeasIdleConfig;","paragraph_zero_based":1225},{"literal_text_all_w_t_and_m_t":"5>set the measResultIdleNR in the RRCResumeComplete message to the value of measReportIdleNR in the VarMeasIdleReport for any valid measurement results, if available, and set validityStatus to the value of measIdleValidityDuration in VarEnhMeasIdleConfig;","paragraph_zero_based":1226},{"literal_text_all_w_t_and_m_t":"5>discard the VarMeasIdleReport upon successful delivery of the RRCResumeComplete message is confirmed by lower layers;","paragraph_zero_based":1227},{"literal_text_all_w_t_and_m_t":"5>remove the measIdleValidityDuration in VarEnhMeasIdleConfig;","paragraph_zero_based":1228},{"literal_text_all_w_t_and_m_t":"4>else:","paragraph_zero_based":1229},{"literal_text_all_w_t_and_m_t":"5>set the measResultIdleEUTRA in the RRCResumeComplete message to the value of measReportIdleEUTRA in the VarMeasIdleReport, if available;","paragraph_zero_based":1230},{"literal_text_all_w_t_and_m_t":"5>set the measResultIdleNR in the RRCResumeComplete message to the value of measReportIdleNR in the VarMeasIdleReport, if available;","paragraph_zero_based":1231},{"literal_text_all_w_t_and_m_t":"5>discard the VarMeasIdleReport upon successful delivery of the RRCResumeComplete message is confirmed by lower layers;","paragraph_zero_based":1232},{"literal_text_all_w_t_and_m_t":"5>remove the measIdleValidityDuration in VarEnhMeasIdleConfig, if stored;","paragraph_zero_based":1233},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":1234},{"literal_text_all_w_t_and_m_t":"4>if the SIB1 contains idleModeMeasurementsNR and the UE has NR idle/inactive measurement information concerning cells other than the PCell available in VarMeasIdleReport; or","paragraph_zero_based":1235},{"literal_text_all_w_t_and_m_t":"4>if the SIB1 contains idleModeMeasurementsEUTRA and the UE has E-UTRA idle/inactive measurement information available in VarMeasIdleReport:","paragraph_zero_based":1236},{"literal_text_all_w_t_and_m_t":"5>include the idleMeasAvailable;","paragraph_zero_based":1237},{"literal_text_all_w_t_and_m_t":"2>if the reselectionMeasurementReq is included in the RRCResume message:","paragraph_zero_based":1238},{"literal_text_all_w_t_and_m_t":"3> if validatedMeasurementsReq is included in the RRCResume and measReselectionValidityDuration is included in VarMeasReselectionConfig:","paragraph_zero_based":1239},{"literal_text_all_w_t_and_m_t":"4>if measReselectionCarrierListNR is present in VarMeasReselectionConfig:","paragraph_zero_based":1240},{"literal_text_all_w_t_and_m_t":"5>if the UE has valid cell reselection measurements results for any frequency listed in measReselectionCarrierListNR in VarMeasRelectionConfig:","paragraph_zero_based":1241},{"literal_text_all_w_t_and_m_t":"6>set the measResultReselectionNR in the RRCResumeComplete message to the valid NR measurement results, if available for any frequency listed in measReselectionCarrierListNR in VarMeasReselectionConfig and set validityStatus to the value of measReselectionValidityDuration in VarMeasReselectionConfig;","paragraph_zero_based":1242},{"literal_text_all_w_t_and_m_t":"4>else:","paragraph_zero_based":1243},{"literal_text_all_w_t_and_m_t":"5>if the UE has valid NR cell reselection measurements results:","paragraph_zero_based":1244},{"literal_text_all_w_t_and_m_t":"6>set the measResultReselectionNR in the RRCResumeComplete message to any available valid NR measurement results, if available, and set validityStatus to the value of measReselectionValidityDuration in VarMeasReselectionConfig;","paragraph_zero_based":1245},{"literal_text_all_w_t_and_m_t":"3> else:","paragraph_zero_based":1246},{"literal_text_all_w_t_and_m_t":"4>if measReselectionCarrierListNR is present in VarMeasReselectionConfig:","paragraph_zero_based":1247}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["5ac0d91991bef38b007e1a24ebc7658fd876b62c482591ff4cf3b808eff62d18","e0cd781fc2540bc44401cead73605e36614f31731861426174d306845446f3b5","0e638095edfc6bea4261a8a66d8ee11bbc5388202a582bc4f9c680bcc9b78ce0","47e3c36148d5bbcef8dac9a544e1a18f036e8e38d3d7855f1cff190d46dffaa1","63455f5923d33792ca9f16dcb598b6c38123b6701daf32b1c55baea06eccd874","0dabb35664821cb5398f6ffa799e5f6bb20279ecba9fed44cdd387d07e03efe2","39085e2751f253261fa5faca81ca0ef448091f088187c7b0fe7d9838d844bc30","2a8c2af0710fcd9ea75b6ff17d34cbc29baa62614e16c9ac49432b39b8fcab48","a586cb33c8dc198c4b133bae2b08fc8316ea0ce4817957ddbf33fda6dbfac16c","710df368c99c15fe4c3ec59b6e5263b7eb68d6451529853e98fbe166cb69facf","0998282cabb2643ca3ac62c4f6c730a3cd58b73349be5998ec8a3361711913c3","1bdf505b5742a9d00b430b6654815e6087e3cca1b90648f97c363b92c76a12eb","016364762ecdffd90281be332d3a6efee65ebf502ae34427e7aeef8b01a72b55","fdca79a185e68e387e05540b8d27941d425d5086d6906b29558519a904054a34","dd92214fa27ca478a3e75d8136f5067491461a95e2ca623accc26eec8d05c299","0b3ff15f518407dc157a13202461eccc5df6ea460c1aecf2b6ebc1cd79f2b44c","77b4ae26580c356cf5a0d477f17d1048f5bb4fd1a0ba5f6e69b797afdc56e226","56a35b98859469d3643fb607d9411186741c9218a645edaf3235080152c4d41b","58bfdc3fce6c074e425f5973d2e5dbbb1a0167e263ecd0779e57967ab0996cb2","80940f70d69baec3e374b20c06e9db721abf225473d1af7f936019084a004803","0cc9a20feab381a92414525cda54199f8a25739ca9b96a9bc7bb157cc5778e5f","fca3ac5eb43ec3c5bd318380af7fa50435b516d759bb68ab2861977298c21ee3","80a11a3e86a27c5378dad3b36993b3381f511b75ed4d342a59182e4dd9109ecc","8f798e3cd6521cb5e4cdf7e25e2a43213e71d7abc76b7b1736ad857460e5f708"],"paragraph_range_zero_based":[1224,1247],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx:p1224"}
{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5>if the UE has cell reselection measurements results for any frequency listed in measReselectionCarrierListNR in VarMeasRelectionConfig:","paragraph_zero_based":1248},{"literal_text_all_w_t_and_m_t":"6>set the measResultReselectionNR in the RRCResumeComplete message to the NR measurement results, if available for any frequency listed in measReselectionCarrierListNR in VarMeasReselectionConfig;","paragraph_zero_based":1249},{"literal_text_all_w_t_and_m_t":"4>else:","paragraph_zero_based":1250},{"literal_text_all_w_t_and_m_t":"5>if the UE has NR cell reselection measurements results:","paragraph_zero_based":1251},{"literal_text_all_w_t_and_m_t":"6>set the measResultReselectionNR in the RRCResumeComplete message to any available NR measurement results, if available;","paragraph_zero_based":1252},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":1253},{"literal_text_all_w_t_and_m_t":"3>if the SIB1 contains reselectionMeasurementsNR:","paragraph_zero_based":1254},{"literal_text_all_w_t_and_m_t":"4>if measReselectionCarrierListNR is present in VarMeasReselectionConfig and the UE has NR reselection measurements available for any frequency listed in measReselectionCarrierListNR in VarMeasReselectionConfig; or","paragraph_zero_based":1255},{"literal_text_all_w_t_and_m_t":"4>if measReselectionCarrierListNR is not present in VarMeasReselectionConfig and if the UE has NR reselection measurements available:","paragraph_zero_based":1256},{"literal_text_all_w_t_and_m_t":"5>include the reselectionMeasAvailable;","paragraph_zero_based":1257},{"literal_text_all_w_t_and_m_t":"2>if the RRCResume message includes mrdc-SecondaryCellGroup set to eutra-SCG:","paragraph_zero_based":1258},{"literal_text_all_w_t_and_m_t":"3>include in the eutra-SCG-Response the E-UTRA RRCConnectionReconfigurationComplete message in accordance with TS 36.331 [10] clause 5.3.5.3;","paragraph_zero_based":1259},{"literal_text_all_w_t_and_m_t":"2>if the RRCResume message includes mrdc-SecondaryCellGroup set to nr-SCG:","paragraph_zero_based":1260},{"literal_text_all_w_t_and_m_t":"3>include in the nr-SCG-Response the SCG RRCReconfigurationComplete message;","paragraph_zero_based":1261},{"literal_text_all_w_t_and_m_t":"2>if the UE has logged measurements available for NR and if the RPLMN is included in plmn-IdentityList stored in VarLogMeasReport; or","paragraph_zero_based":1262},{"literal_text_all_w_t_and_m_t":"2>if the UE has logged measurements available for NR and if the current registered SNPN identity is included in snpn-ConfigID-List stored in VarLogMeasReport:","paragraph_zero_based":1263},{"literal_text_all_w_t_and_m_t":"3>include the logMeasAvailable in the RRCResumeComplete message;","paragraph_zero_based":1264},{"literal_text_all_w_t_and_m_t":"3>if Bluetooth measurement results are included in the logged measurements the UE has available for NR:","paragraph_zero_based":1265},{"literal_text_all_w_t_and_m_t":"4>include the logMeasAvailableBT in the RRCResumeComplete message;","paragraph_zero_based":1266},{"literal_text_all_w_t_and_m_t":"3>if WLAN measurement results are included in the logged measurements the UE has available for NR:","paragraph_zero_based":1267},{"literal_text_all_w_t_and_m_t":"4>include the logMeasAvailableWLAN in the RRCResumeComplete message;","paragraph_zero_based":1268},{"literal_text_all_w_t_and_m_t":"2>if the sigLoggedMeasType in VarLogMeasReport is included; or","paragraph_zero_based":1269},{"literal_text_all_w_t_and_m_t":"2>if the UE supports the override protection of the signalling based logged MDT for inter-RAT (i.e. LTE to NR), and if the sigLoggedMeasType in VarLogMeasReport of TS 36.331 [10] is included:","paragraph_zero_based":1270},{"literal_text_all_w_t_and_m_t":"3>if T330 timer is running (associated to the logged measurement configuration for NR or for LTE):","paragraph_zero_based":1271}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["20f5ba1d4ddfad3cc3fffb168e2a4c0d6a42fe918a0c6052dd2d48ce4a165e36","37919b2309caf6dcd7689f976c3b37fd5f3f82cbae14b00004638dcc5598ce16","2c3e562988414b3ff4ff8cea79592df37dbd1bf05b893c084c067a589fa6b178","3b73d969218663012341ece7944ec66eaa4549e55c037f1cdf81fc1961a413c7","4c662eebcde26caa08d1a0775d5f448418bf8bf3d62e405ac030314ae7c93e0d","617534c9cce321205a827c1e6f98143492043519fbc893af5fe94d71e21d7eb4","c75f24bd0821f35a64f4d6c54920b9b9864ad9b5435b5ffa2a72df24149c7ee3","4331220bdeeec7131f19acb0a746bfd26efa8df4f7a4e75f2613f5f9c8ae1c56","e949dfe3e87b177dab99b2099a373b0b9049b1f94d385f5ea034beaa032e7959","4057fe9babb2bb6fcb085cff487ee2256568f5913a7273c306dbd50adf637526","cf1ba81c22b5fbe5aa40b07f1d667e239fea869a508bbe0389eb9ceceb08cd2f","3e91aca1d09d39346082e8b985ded030ca445b524c9e24595698ef27cb26395a","d97b6b6443d017f2dd36ffbb69acb30f6e9e2ae198ab76b997f59e3f8c0ef60e","b3f37642f2aba07ba52244a4f19e1e46399e6e7ea642c0e1a638bde1136f8159","395f921eb1fca85479b382db103fe23f597cd2f05ed11a11d1594ae33dfaf6a6","5e871f6da9341185769660c8118a47e145a53e9963e1bfe7202136ee67cc68c3","561a0b13d32d8cf7f6db30cf79b858f48e193e5600e765327e9283f124e6673b","1f6ed94857d58929b8b451ddd14dfca19a2266f93b919c9f57719b137c5c69cd","621d42fc07ed6953bb099743ec2f46ce9c9962957981895de19f7649f50f1d30","c41ad03955c554995b5c7ffa64db74052b2c63522acf9a5d5945029ef7e93898","5f51db4f03867c67e06c910637bca5f88a2ae4dcdfb58baf82a8d69eade6428f","4d1e1c03128750b28bb7094c90b25e1ecf798d14c1286b2820333936a6c4ec5c","de8d48516f80921b1c5bb3ca1a1d365276b58c0014c43b89d4cdbad8d26aecf8","6d8d77fdf75e