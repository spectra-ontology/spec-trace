{"fields":{"filename":"R2-2502075.zip::R2-2502075 Introudction of control parameters for on-demand posSIB request for UE capability_final.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":240},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":241},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":242},{"literal_text_all_w_t_and_m_t":"(Incl FR2-2 DIFF)","paragraph_zero_based":243},{"literal_text_all_w_t_and_m_t":"maxMRB-Add-r17","paragraph_zero_based":244},{"literal_text_all_w_t_and_m_t":"Indicates the additional maximum number of MRBs that the UE supports for MBS multicast reception in RRC_CONNECTED as specified in TS 38.331 [9].","paragraph_zero_based":245},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":246},{"literal_text_all_w_t_and_m_t":"For the UE indicating support of multicastInactive-r18, this capability is also applicable to multicast reception in RRC_INACTIVE, as specified in TS 38.331 [9].","paragraph_zero_based":247},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":248},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":249},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":250},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":251},{"literal_text_all_w_t_and_m_t":"mcgRLF-RecoveryViaSCG-r16","paragraph_zero_based":252},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports recovery from MCG RLF via split SRB1 (if supported) and via SRB3 (if supported) as specified in TS 38.331[9].","paragraph_zero_based":253},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":254},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":255},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":256},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":257},{"literal_text_all_w_t_and_m_t":"minSchedulingOffsetPreference-r16","paragraph_zero_based":258},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports providing its preference on the minimum scheduling offset for cross-slot scheduling of the cell group for power saving in RRC_CONNECTED, as specified in TS 38.331 [9].","paragraph_zero_based":259},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":260},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":261},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":262},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"07548170a78db80f735ccee09196c0bd7319249104911a4435888a81fa42ebc8","original_member_sha256":"4e1426c6554f6ae9bf90d915c14ab4f606ef4e51023d4fc251844e3b54784cc2","paragraph_ElementTree_utf8_XML_sha256":["cb185ee656f2b73fd75c00f405c5f04b2c9ce6c2f8e87928ba93965e11f2a4de","f61fd591dbe1023a7941313cb70589c8abf232678ba64d3708bbafbd42e1b585","4f5dbea26523d1d564096ad52f34cb3de787e2a6f8244959a7b79b1865a87dca","7aa271c2e04645fcd4adcb75b9fbebc402d128118b0cf76ff181f29d638f0350","94cbfac0cfcbd28d01ffd159590f19d8bfba9954b5f14e29f2c4424cba205668","a069a99bf13b58672a5acd3251d6348358c5b441b5cb046e2d0d8ff512fed2fa","a4b84145878cdb3b3b55f7fb3747c93c1353fa2a2c81308ae13512c1ed70ada7","f475325b848f2782a37a04141b27b7e93b234f36f33d3f1d709f464b379c8deb","ba47534d8420d02bd458573bae069cd214511a7b4c43cfde9814b712316dc328","0699bd8f0e0f726704fce5342941d172b5124f62fbc8f83dfd682a469d557fa2","21261a533daeaf0ad221639f686b2f9b52f9a656fac715ad02547597d9b69542","3864b7afadc427ce28d63bed674e19cd22453892bfb4345bf789d2e2cc47f1ab","d4b4ba201a0fd515d7b38388e54f30ac9102c7c4342c21db40e0cb01b7e18370","157d3e7fe5910f4a2740fda6b39490291b93c49fe131161830dc0e15b99dc68c","3530aa5e027a9f55f5f22c5ee5c5be6f8ba74243472706b85a65c4a3e255315d","2ed0d78df2e314137350e57075fa130deb597fdb9b1c1946f45dbb087b95a04d","a56cb619495a796bddebcf9a38d87c331740a19bf1d5bc386138a2786acb0897","b64d8ce21ec4bea3f482b2320dac22b7c22c59db936d0a7a223f8e35f3fb7fba","7241636a00c17ca93362eccd4171dd2dfc6ff2518ab9c010ff65fe6a11d8ce76","b9b5e60dd4d87b8263610ccc0c3eab5757c76ec91705702c9bab312c80420670","79eea87dedc91683602f2789409fb38ab36ed69f25ef8e0378104971528f32c9","d3282952399acac4eb8797844610cce4175e0e3ed037efda1f821f42c393039f","2889f4df486fc2b4e1a4cd20b8567a1bbe8493334fef82afbffb50a6bbd14730","1e5983518049b6bd9a6f226ca7f928c7df88de92c4bd618b7a2f241567d6a63e"],"paragraph_range_zero_based":[240,263],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2502075.zip::R2-2502075 Introudction of control parameters for on-demand posSIB request for UE capability_final.docx:p240"}
{"fields":{"filename":"R2-2502075.zip::R2-2502075 Introudction of control parameters for on-demand posSIB request for UE capability_final.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"mpsPriorityIndication-r16","paragraph_zero_based":264},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports mpsPriorityIndication on RRC release with redirect as defined in TS 38.331 [9].","paragraph_zero_based":265},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":266},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":267},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":268},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":269},{"literal_text_all_w_t_and_m_t":"mt-SDT-r18","paragraph_zero_based":270},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports initiating MT-SDT procedure via random access procedure with 4-step RA type and if UE supports twoStepRACH-r16, with 2-step RA type, in response to the reception of MT-SDT indication in paging message, as specified in TS 38.331 [9].","paragraph_zero_based":271},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":272},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":273},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":274},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":275},{"literal_text_all_w_t_and_m_t":"mt-SDT-NTN-r18","paragraph_zero_based":276},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports initiating MT-SDT procedure in NTN via random access procedure with 4-step RA type and if UE supports twoStepRACH-r16 for NTN, with 2-step RA type, in response to the reception of MT-SDT indication in paging message, as specified in TS 38.331 [9]. A UE supporting this feature shall also indicate the support of nonTerrestrialNetwork-r17.","paragraph_zero_based":277},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":278},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":279},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":280},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":281},{"literal_text_all_w_t_and_m_t":"musim-CapabilityRestriction-r18","paragraph_zero_based":282},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports providing MUSIM assistance information with temporary capability restriction and capability restriction indication (i.e., musim-CapRestrictionInd), as defined in TS 38.331 [9]. For a UE supporting nr-NeedForGap-Reporting-r16, this field also indicates UE supports providing musim-NeedForGapsInfoNR-r18 with temporary capability restriction as defined in TS 38.331 [9].","paragraph_zero_based":283},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":284},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":285},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":286},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":287}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"07548170a78db80f735ccee09196c0bd7319249104911a4435888a81fa42ebc8","original_member_sha256":"4e1426c6554f6ae9bf90d915c14ab4f606ef4e51023d4fc251844e3b54784cc2","paragraph_ElementTree_utf8_XML_sha256":["1dc4a5c75e852b6df549aedace2c3040d8bdf46de82c2cf1750391fe97c60938","76eb6602929a0647299e3d476545d887e3867bc47261359f8b88a8a6ab41247c","8008d8aa40305837ad181b52e41a49bfc46cbae57184897c002e29010241b2ea","65dd3332f5ee016aa3b0d66003324f8710fa2139ea309f21651358b0d4f1aaa8","5104a5fa6c669739076f5e6ee97765f910b5dd2f3381078a14621415905cdd07","a92db4b5ea0bf5011ae9cdf8038678c4207fe3b092043f3e3ff4362bb636fbd6","9bfc4a0b1117dbf3ff912e78e9ffb7643b1cc9cfea081a724f6f149e6387bb82","7d24ada5ece955813867b7ff2d3117c210883a455283ca73b6273f9d11519789","7b53b14c310bc8f63262d9f885239f9526b285fbe61060bfa5f88a873225b157","76f43ce3f66cf64856679b4151697c093d8d70fd9ec68c1bfcb77bd25ef68921","d43c4abd01723e45bb64e248c0322a494c58c6638ae04c3f7ab42b9f209caa65","f60839cefec9c1a59eea810f76f8045a0888ab1b8b0bb3ad24a31dc648524a6c","c710859c12e1f00b54146051536845d445331f487f26c84dbb149b036b15075a","7b5bb73eb12e9289701d5c6d64cf3d6e40fddb0ef263b9df868696e0aad67cd7","cfc7396b490344d7f7200862060caebf9d13154a35a8d572131049eba1a0263c","e1ec56ff0ee81deb6a4f97560fbb730f48b58237359cbd59a1e03ac97c7f9bc0","199a33ed3c51ed0560e77aa87a8684da951b52009791930b9b5764a659d8628a","c1b3d07f02e9a87b3d687953b72035e48268cbf7b12f5c39717bb45766937e7b","fe6cada810f69f0935d537b605b3868814354ddf65f772b85187627a100a3d65","eb07e189d47ae2f0a5fa522574ae63193cde0cbe3da231df21681d705396cc0c","5bbe307bc4413639cabbb63b1214cb9281aaa03f69f53cca5946bdabbdb0d271","b041112b99a6bf81ca3f7299151e03f14fb946172c92e9980088ae257ac93727","7aa62f765976ea0d510101acf4b898b139a88427d2b72838675c99b52bf764f5","04100910989f55c2b3dba919a23c6529c05ca1f2369db751b2e7a931a63a0b45"],"paragraph_range_zero_based":[264,287],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2502075.zip::R2-2502075 Introudction of control parameters for on-demand posSIB request for UE capability_final.docx:p264"}
{"fields":{"filename":"R2-2502075.zip::R2-2502075 Introudction of control parameters for on-demand posSIB request for UE capability_final.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"musim-GapPreference-r17","paragraph_zero_based":288},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports providing MUSIM assistance information with MUSIM gap preference and related MUSIM gap configuration, as defined in TS 38.331 [9]. UE supporting this feature supports 3 periodic gaps and 1 aperiodic gap.","paragraph_zero_based":289},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":290},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":291},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":292},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":293},{"literal_text_all_w_t_and_m_t":"musim-GapPriorityPreference-r18","paragraph_zero_based":294},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports providing MUSIM assistance information with periodic MUSIM gap priority preference and related periodic MUSIM gap priority configuration, and its preference of keeping all collided MUSIM gaps, as defined in TS 38.331 [9]. A UE supporting this feature shall support musim-GapPreference-r17.","paragraph_zero_based":295},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":296},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":297},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":298},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":299},{"literal_text_all_w_t_and_m_t":"musimLeaveConnected-r17","paragraph_zero_based":300},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports providing MUSIM assistance information with indication of leaving RRC_CONNECTED state as defined in TS 38.331 [9].","paragraph_zero_based":301},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":302},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":303},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":304},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":305},{"literal_text_all_w_t_and_m_t":"nonTerrestrialNetwork-r17","paragraph_zero_based":306},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports NR NTN access. If the UE indicates this capability the UE shall support the following NTN essential features, e.g., timer extension in MAC/RLC/PDCP layers and RACH adaptation to handle long RTT, acquiring NTN specific SIB and more than one TAC per PLMN broadcast in one cell.","paragraph_zero_based":307},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":308},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":309},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":310},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"07548170a78db80f735ccee09196c0bd7319249104911a4435888a81fa42ebc8","original_member_sha256":"4e1426c6554f6ae9bf90d915c14ab4f606ef4e51023d4fc251844e3b54784cc2","paragraph_ElementTree_utf8_XML_sha256":["0c7479499073a6f54a6033f1f6473b5a7890a4ea0cf6b97742577ac14dbeebca","601c02b1cc4a91d6d168628018e794f111825db229c2035c269e2ddda6f46422","3e491ed10d358b54e184eb4ccbd3a3c69581f0a25b698d3bc4c789d914540741","9b3327b12f6f381feeab313ee7cd152e0e2722c84a58f2af2ebcbc1f2baa1d69","ba8708233c53a31522de1eee67d369e1d348b2a45965dde44702c3ac5449c957","b47e1caa1a1e2b3f42f59a812b971fe08b7edf015f6be5b6defc5a63f2cc0d26","9e9ef4bac7f0821bf0dca552a9270b5fd69b4cbdd236363fbe03a8e33e75efac","64b6cbf917fdb3d1cdfafb66b550d5a91c666e6777d8ced4f982411dc0249272","1ed62df2961dd93eb41893c180f75076ad32b2fdcac68333942cd824d5bb7d12","529fefd28a66ee670cd38b5952f54905ce534278a0867a2a581e597d68119162","52fcc58cad4af0d4238a5e55e5174a977c5c177fc8d56633bdd474444e1ec15b","4f0cfa6b8894694bc430828df9e0527e9a3fdf403e4bcc096b5408292d454255","cb28d73ca6c0ad4c6562020d6d898bd972cdf56b0f67a2f121073d1b396e85da","6434f2befa574b2ace3137b590c6612b0e4b85586a880a011f5ad0d086445db1","6882718ab98a5160d53224e9494e3d171b7a17ffeeebaeff720d5d451ee72b5c","fa4a5c6d3b92f00532ceae323ad4efd02b5e3cbd6c2e7eb4e96448b405a91440","979fb4846ce6bc5caf731d91e9cf703679504587756de46511293906af3f73a7","a53d6c983af79f2e8c5a36e2c3398b0220ac613f74e08e2fd5e000a88a7b65ff","177d4885a851d4b4b1f0d925630d0eb4bfd600c5513e4341e7bf1141c762348f","396adec92b3e0cf55a5331c7d9d7fda153e25bd2e4621082f1272405159393e6","568ee8fec8c07f70b6a9e12fcd3b2294c01d948bd2ffcdd42a5f21923361c2a3","17696b587eb7c90f6b4435c7a04e43aac36c8454fdd69684c5459781403822be","74470a7148140177c8376c989eb2b0f295e722a31aed3b2c2a834931e1535eb4","b68a267bf117738515950c3c3d44fe63d8a7a04f00c3c0b58d49d328ca0a5ede"],"paragraph_range_zero_based":[288,311],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2502075.zip::R2-2502075 Introudction of control parameters for on-demand posSIB request for UE capability_final.docx:p288"}
{"fields":{"filename":"R2-2502075.zip::R2-2502075 Introudction of control parameters for on-demand posSIB request for UE capability_final.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ntn-ScenarioSupport-r17","paragraph_zero_based":312},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports the NTN features in GSO scenario or NGSO scenario. If a UE does not include this field but includes nonTerrestrialNetwork-r17, the UE supports the NTN features for both GSO and NGSO scenarios, and also supports mobility between GSO and NGSO scenarios.","paragraph_zero_based":313},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":314},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":315},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":316},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":317},{"literal_text_all_w_t_and_m_t":"ntn-VSAT-AntennaType-r18","paragraph_zero_based":318},{"literal_text_all_w_t_and_m_t":"Indicates whether a VSAT UE uses electronic or mechanical steering antenna. A UE supporting this feature shall also indicate the support of nonTerrestrialNetwork-r17.","paragraph_zero_based":319},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":320},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":321},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":322},{"literal_text_all_w_t_and_m_t":"FR2 only","paragraph_zero_based":323},{"literal_text_all_w_t_and_m_t":"ntn-VSAT-MobilityType-r18","paragraph_zero_based":324},{"literal_text_all_w_t_and_m_t":"Indicates whether a VSAT UE is a mobile or fixed VSAT. A UE supporting this feature shall also indicate the support of nonTerrestrialNetwork-r17.","paragraph_zero_based":325},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":326},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":327},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":328},{"literal_text_all_w_t_and_m_t":"FR2 only","paragraph_zero_based":329},{"literal_text_all_w_t_and_m_t":"onDemandSIB-Connected-r16","paragraph_zero_based":330},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports the on-demand request procedure of SIB(s) or posSIB(s) while in RRC_CONNECTED, as specified in TS 38.331 [9].","paragraph_zero_based":331},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":332},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":333},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":334},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"07548170a78db80f735ccee09196c0bd7319249104911a4435888a81fa42ebc8","original_member_sha256":"4e1426c6554f6ae9bf90d915c14ab4f606ef4e51023d4fc251844e3b54784cc2","paragraph_ElementTree_utf8_XML_sha256":["e8c769f79c1177755d57ddcf12ec982764dc3281327369a2ff988ddd145ba5cf","964ef05553389dbfa3135f09acc8483d964e1c54762648ee29b1df290d73b3ad","f6228c77907fa99b674641290bc3a3b4156586b4198dd3bb2806ab2a2dd42619","5f5fcb9c3ce0361610102f0a61061fe4bade3b658bafd1f289e4824dffdbef16","222b00bc755cf312ad1d39dafb6da37e40cbdd172e65c51b6f5fd7e3b6423085","13b5efa7ef59d067db3266198306b2c06ea0f0630066ba1dd96651ed868a27c1","0fed489f87743c54227761ce71e9dd05b45d25dc187eb77f20c57f74c06fa214","d7097a97744f21bacd012dd3bd18cdbc97d34658adea4753feb4f00bbe4ab98e","1754dc3dbde92e38964b469d4b855af0de68e8a1850b92c1f93c3dfaa9424ac5","cee21ed12c4faa8fc5c87bc5d8f707488a6ba86002017a656b0400b954aee4f0","9e412c208a189b71bbb0cbcdedb086b0defe738c7cdeb2fe70dedec5db7e0f93","29edfb3bbf02259b389f52c6e3541da7cf9f3fdedcbc2bc9f85eb4d14b47a87d","f0d459c236d537269ad9ea68d7a5798723b3f69d802f57c37de5557a68a098bc","f1b4a4c25a5b372bba8ae41249e73bc90fbc64ba97f0026161133ebe66425200","64f85257914c13632170a99529f2bede6ae39ab4682b4a1238558d181b9d0822","3c73e5cbd36b867c27acb342822b8e6a212ced53b41e783e370df68fc659fa6b","6e1870dbd83a2c87729bed698e299d217e6207fc93d2fec77fd747333c65796c","36c729837838a43c3702282e343307c06f3764c6d3282a9465daf774e3bc09ed","7cd9bf5931b053054e223f43fd9649ca5afe9693cc2def31dfd4d1820a823466","75ca49d0d2f86bde3df9cfe35eb3cb8702b0e0052760b7b0c1c40dce29dae3bd","e6ac7ddf346cf6be61cbb7d301a5a0c0d96303fed22ab2bf57ac8623a325d10a","39f47b842e2c16648a519b816d2014a639fd587740f10ebf6bca13a118d84ec4","556d6d54eec96a843dc68d5150931f1f9a26bed7fe639d6eeec7db8a3e606b24","c5bba48ec7aa089f895767a85dd6dbb31784a6d6979e90fc1422556e4adcc0c6"],"paragraph_range_zero_based":[312,335],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2502075.zip::R2-2502075 Introudction of control parameters for on-demand posSIB request for UE capability_final.docx:p312"}
{"fields":{"filename":"R2-2502075.zip::R2-2502075 Introudction of control parameters for on-demand posSIB request for UE capability_final.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"onDemandSIB-ConnectedCtrlParam-r19","paragraph_zero_based":336},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports the on-demand request procedure of posSIB(s) with control parameters in RRC_CONNECTED, as specified in TS 38.331 [9]. A UE supporting this field shall also support onDemandSIB-Connected-r16.","paragraph_zero_based":337},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":338},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":339},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":340},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":341},{"literal_text_all_w_t_and_m_t":"overheatingInd","paragraph_zero_based":342},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports overheating assistance information.","paragraph_zero_based":343},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":344},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":345},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":346},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":347},{"literal_text_all_w_t_and_m_t":"pei-SubgroupingSupportBandList-r17","paragraph_zero_based":348},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports receiving paging early indication in DCI format 2_7 as specified in TS 38.304 [21] for a list of frequency band. The UE shall support UEID based subgrouping for a frequency band if it indicates supporting of paging early indication reception for the frequency band. The set of OFDM symbols within a slot where UE can monitor the PEI PDCCH in Type 2A CSS is the same as the requirement for paging PDCCH in Type 2 CSS for IDLE and INACTIVE mode UEs.","paragraph_zero_based":349},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":350},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":351},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":352},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":353},{"literal_text_all_w_t_and_m_t":"partialFR2-FallbackRX-Req","paragraph_zero_based":354},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE meets only a partial set of the UE minimum receiver requirements for the eligible FR2 fallback band combinations as defined in Clause 4.2 of TS 38.101-2 [3] and Clause 4.2 of TS 38.101-3 [4]. If not indicated, the UE shall meet all the UE minimum receiver requirements for all the FR2 fallback combinations in TS 38.101-2 [3] and TS 38.101-3 [4]. The UE shall support configuration of any of the FR2 fallback band combinations regardless of the presence or the absence of this field.","paragraph_zero_based":355},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":356},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":357},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":358},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"07548170a78db80f735ccee09196c0bd7319249104911a4435888a81fa42ebc8","original_member_sha256":"4e1426c6554f6ae9bf90d915c14ab4f606ef4e51023d4fc251844e3b54784cc2","paragraph_ElementTree_utf8_XML_sha256":["d51a2729368522c632e0f05004053395888dacd92236c0e02c954be9b1140e89","b77db0a24dbb32a76163a0d77792dde2a787bf6d3d62bd7100716dc2e5cfb421","804e094557a8d34d318d088ea230a029622983a3e4a3e2f3fa49c7e5bcc1ba0b","938180c3724749e862725ef33abf6112675767ddf4ad28f7270100194b9f7f3e","7b53d0e4fe08b96dd81b8af68836503f13b9c1719a7d1b5177fa1bc90e259a4a","1e64db21017a2ffa2aa2d99bf8e93dac8b42a419fd74586e6d423892fc2451f3","0f7dec10d95f52461e6d83de46da87d53c265456b6bb2e29c2623ac0bbc88a32","876dd7ca2