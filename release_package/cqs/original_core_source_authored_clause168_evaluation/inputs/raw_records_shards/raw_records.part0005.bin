{"fields":{"filename":"R2-2409048.zip::R2-2409048_CR on 38.306 for Correction on PHR for mTRP PUSCH repetition (R18).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"CY","paragraph_zero_based":312},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":313},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":314},{"literal_text_all_w_t_and_m_t":"multipleConfiguredGrants","paragraph_zero_based":315},{"literal_text_all_w_t_and_m_t":"Indicates whether UE supports more than one configured grant configurations (including both Type 1 and Type 2) in a cell group. For each cell, the UE supports at most one configured grant per BWP and the maximum number of configured grant configurations per cell group is 2. If absent, for each configured cell group, the UE only supports one configured grant configuration on one serving cell.","paragraph_zero_based":316},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":317},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":318},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":319},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":320},{"literal_text_all_w_t_and_m_t":"multipleSR-Configurations","paragraph_zero_based":321},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports 8 SR configurations per PUCCH cell group as specified in TS 38.321 [8].","paragraph_zero_based":322},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":323},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":324},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":325},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":326},{"literal_text_all_w_t_and_m_t":"non-IntegerDRX-r18","paragraph_zero_based":327},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports non-integer DRX periodicity as specified in TS 38.331 [9] and TS 38.321 [8].","paragraph_zero_based":328},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":329},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":330},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":331},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":332},{"literal_text_all_w_t_and_m_t":"recommendedBitRate","paragraph_zero_based":333},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports the bit rate recommendation message from the gNB to the UE as specified in TS 38.321 [8].","paragraph_zero_based":334},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"4495a7d323453d2fb59c658e702b60f42d86f6325ecde37c1f1347fed1b371dc","original_member_sha256":"bb67c4ce90f1f4c0d2f5bba43fbf139e47fca6fb324e52e44bcf258d1775c74e","paragraph_ElementTree_utf8_XML_sha256":["41ee22732ae1537410714a466777f426834bcfa11911a0c6ecbe29c7c5eed8e8","4a9027d95ede231246e55eef9114bdc1577bcdb579cec3c5914167ba872baece","f2c944316d72b182d7a69325cfd097f700a6f5465bc12d6fe6b8a482e1114669","5e8f2758b2c6cd2437724023b91738445d48fd28879e7471e75e0deb12311c7e","08cb654239c5b91cd56b61bf6f2660a1f9ee46c1fc01d7c48cee3faf01fab457","99c2ce0dd877922ba3077754887de9dc93aed9832028ef4c1845bfcc7dc50c48","b78825dcf81f06feadcf377f7c976ec92fdce9e5fe5b152e3241c3ca0b71f81f","996feb8a4e53bf2f0d4ce70fb585bf51c8a373405602772ff80a14c016b1a57d","d5830d11f493925e1f32556ad49b9a6b3c0f6ef029500fa83fa03a85e389961c","3bbcd961b6b68ccc1cee0bc604775fbe97e783f7afe22f2ee620cfcf23d557ec","ae495c14886edf88cb577b1ea0622ae13d95801ce73cc5e91b3a3bbe18278de3","805a420ee60e5ee2f498f0334593fff1d4d41a5e10c5a57901c892667d5b34e5","3973832b37d2d503002cc78093af67df8057c702128bd004f08e89d38537ac77","898bcab3493d0b5c791e426fdab0a3618344eb23524e9fb05690711809ce65fd","19619777bf33b53b8af61a0be3f436c24dda74c9c2bcb1940deddfbefd8a219c","46a57483ca2497d61504570811d9e90d1f897c19d645c929061604e8050a5e