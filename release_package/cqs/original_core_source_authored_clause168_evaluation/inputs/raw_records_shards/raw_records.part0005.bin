{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the list of applicability reports, each associatied with a configuration ID for a configuration subject to the applicability determination procedure.","paragraph_zero_based":4008},{"literal_text_all_w_t_and_m_t":"applicabilityStatus","paragraph_zero_based":4009},{"literal_text_all_w_t_and_m_t":"Indicates whether the configuration associated to applicabilityInfoReportId is applicable or inapplicable.","paragraph_zero_based":4010},{"literal_text_all_w_t_and_m_t":"releaseConfigurationPreference","paragraph_zero_based":4011},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference to release the configuration associated to applicabilityReportConfigId (e.g. due to model unavailability), if the applicabilityStatus is set toinapplicable.","paragraph_zero_based":4012},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4013},{"literal_text_all_w_t_and_m_t":"<Text Omitted>","paragraph_zero_based":4014},{"literal_text_all_w_t_and_m_t":"–CSI-LoggedMeasurementConfig","paragraph_zero_based":4015},{"literal_text_all_w_t_and_m_t":"The IE CSI-LoggedMeasurementConfig is used to configure a CSI logged measurement configuration. It defines a group of one or more CSI resources for which the UE logs the associated L1 radio measurements.","paragraph_zero_based":4016},{"literal_text_all_w_t_and_m_t":"CSI-LoggedMeasurementConfig information element","paragraph_zero_based":4017},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":4018},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-LOGGEDMEASUREMENTCONFIG-START","paragraph_zero_based":4019},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4020},{"literal_text_all_w_t_and_m_t":"CSI-LoggedMeasurementConfig-r19 ::=             SEQUENCE {","paragraph_zero_based":4021},{"literal_text_all_w_t_and_m_t":"    csi-LoggedMeasurementConfigId-r19               CSI-LoggedMeasurementConfigId-r19,","paragraph_zero_based":4022},{"literal_text_all_w_t_and_m_t":"    csi-LoggedResourceConfig-r19                    CSI-ResourceConfigId,","paragraph_zero_based":4023},{"literal_text_all_w_t_and_m_t":"    loggingPeriodicity-r19                          ENUMERATED {n2, n3, n4, n5, spare4, spare3, spare2, spare1}    OPTIONAL,  -- Need R","paragraph_zero_based":4024},{"literal_text_all_w_t_and_m_t":"    csi-LoggedMeasurementEventTriggerConfig-r19     CSI-LoggedMeasurementEventTriggerConfig-r19                    OPTIONAL,  -- Need R","paragraph_zero_based":4025},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":4026},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":4027},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4028},{"literal_text_all_w_t_and_m_t":"CSI-LoggedMeasurementEventTriggerConfig-r19 ::= SEQUENCE {","paragraph_zero_based":4029},{"literal_text_all_w_t_and_m_t":"    threshold-r19                                   CHOICE {","paragraph_zero_based":4030},{"literal_text_all_w_t_and_m_t":"        aboveThreshold-r19                              MeasTriggerQuantity,","paragraph_zero_based":4031}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["faad6ff16f4039f507cbee08c7c85cc49984f429cd3b48cccf6c7667375d651a","5ad1bfaa61eee5f8252f5a40c234c18a3e7a708560afb33f1483fadd1431a35e","b4a66a4b82ac31ad4aa0f0307a175cf69ef9a40bde11ad6059fd390b5743c7d7","a4c7c7a88271efc2a1c1c0c31ed2d7c072b6346c3a7c2a81aa5a4b2724bbfda4","6b174d51347ad35c17c5b30de295af17c77f5d0fb83bd0984d611d0f0e41ff4b","9db760ff99eac1609b81637d75ecdf296df9f053a9c63d2e319cb0457b694409","31f0293c691531e78b3f40d59c656e93c6952080cb73bb638465cfd9910007ff","ec3de175aa7b1af2e55fbb961b4b096cbc9c02b9dba2f5e51b31b73612b86009","d25de247204693f57da00e8bf5f17b74201a6bdf6babb35ad74ea61b5de3f0d2","b22c31e2de2094195a73788a7900a5262365b303df0a595bfe5979ee9f6fd50c","6ac9b9d84b9cd86ff1748bd2849f5a5eaa4c7b34a1490d46cce60f115b5555e3","0673372a17453841718eb6f67e3229909457814404c3b83d8304c6f4a4c688bd","41d0cf486b418e08c28cb629d5add5b03fcc87e33f43024b7b28e38fd2c65451","22b59a24be365a580e1382fb502c2eeed0de3d6be44a1b78d0ab528f9e51f938","ea3fec330fce8b45e789f46a8972c7296eca30b9f6c51dbefc97e1a6dc4c38ff","8df5a8607f2e43bcb360d9ce977850a45fa7a3fceb46ed41960a9ebcd70841b2","50ff5b9844e99bbc598759e7d41a3d6f68606c64889014e5a9234f29f4e715ed","d7ce6098b631caf2f7b26b098e23b8f74fb7851a33525d2d1484eeaa48658d07","4c7202165f34a90c915d59119a7f147d689e26021e0543124ec62ddcbec1e636","2e23df579cb6e3744e1bd292f9c3e9480db903d61dba1da39afe31edf3da67e5","165956d7bc2bd1f21cc3e70ebd48cc5931ec89aa929b35fc183c4577a05890bc","a538d272a95db335d1b0fd582243e31c31d9d52cd2cf7ec136336189862539c8","30451b08ec4f3b60bb299cd4413dd6e8705c201170cd36acd2b87b41f5a68cab","7bdf0477d2464c0bc328f4147fa4e92003cd6bc8a19a99720aff66e8a4d2e024"],"paragraph_range_zero_based":[4008,4031],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p4008"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        belowThreshold-r19                              MeasTriggerQuantity","paragraph_zero_based":4032},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":4033},{"literal_text_all_w_t_and_m_t":"    hysteresis-r19                                  Hysteresis,","paragraph_zero_based":4034},{"literal_text_all_w_t_and_m_t":"    timeToTrigger-r19                               TimeToTrigger,","paragraph_zero_based":4035},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":4036},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":4037},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4038},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-LOGGEDMEASUREMENTCONFIG-STOP","paragraph_zero_based":4039},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":4040},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4041},{"literal_text_all_w_t_and_m_t":"CSI-LoggedMeasurementConfig field descriptions","paragraph_zero_based":4042},{"literal_text_all_w_t_and_m_t":"csi-LoggedMeasurementConfigId","paragraph_zero_based":4043},{"literal_text_all_w_t_and_m_t":"This field indicates the instance of CSI-LoggedMeasurementConfig.","paragraph_zero_based":4044},{"literal_text_all_w_t_and_m_t":"csi-LoggedMeasurementEventTriggerConfig","paragraph_zero_based":4045},{"literal_text_all_w_t_and_m_t":"This field is used to configure the UE with event-triggered measurement logging. If this field is included and threshold is set to aboveThreshold, the UE starts performing logging of measurements when the entering condition as specified in 5.5.4.2 is met and stops logging when the corresponding leaving condition as specified in 5.5.4.2 is met. If this field is included and threshold is set to belowThreshold, the UE starts performing logging of measurements when the entering condition as specified in 5.5.4.3 is met and stops logging when the corresponding leaving condition as specified in 5.5.4.3 is met. If this field is not included, the UE starts the measurement logging according to csi-LoggedResourceConfig upon reception.","paragraph_zero_based":4046},{"literal_text_all_w_t_and_m_t":"csi-LoggedResourceConfig","paragraph_zero_based":4047},{"literal_text_all_w_t_and_m_t":"Resources in which the UE performs channel measurement whose associated measurement results are logged by the UE. The csi-LoggedResourceConfig indicated here contains only NZP-CSI-RS resources and/or SSB resources.","paragraph_zero_based":4048},{"literal_text_all_w_t_and_m_t":"loggingPeriodicity","paragraph_zero_based":4049},{"literal_text_all_w_t_and_m_t":"The periodicity that the UE shall use for the logging of the CSI measurements. The loggingPeriodicity is given as a multiple of the periodicity of the resources indicated by csi-LoggedResourceConfig. If loggingPeriodicity is included and set to 'n2', the UE performs the logging of CSI measurements for every 2nd occasion of the resources, if it is set to 'n3', the UE performs logging of CSI measurements for every 3rd occasion of the resources, and so on. If loggingPeriodicity is not included, the UE performs the logging of CSI measurements according to the periodicity of the resources indicated by csi-LoggedResourceConfig, i.e. for every occasion of the resources.","paragraph_zero_based":4050},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4051},{"literal_text_all_w_t_and_m_t":"–CSI-LoggedMeasurementConfigId","paragraph_zero_based":4052},{"literal_text_all_w_t_and_m_t":"The IE CSI-LoggedMeasurementConfigId is used to identify a CSI-LoggedMeasurementConfig.","paragraph_zero_based":4053},{"literal_text_all_w_t_and_m_t":"CSI-LoggedMeasurementConfigId information element","paragraph_zero_based":4054},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":4055}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["b80320caa4399fcd6898439e585e3dd2ff002015b841bdad952ddf5d2e94a6f6","00b5573f22a276b2d65acaf0f7080b8934abdb6be25991cb847f88219171f3c4","fcbe9e02744cda33b1cef935bfba1d268c28dca966648f87633d9476e820bf62","52f3c1aab6bb47915f41ca55be87d6e946a676c5b5b2e57ac8adadf0f58d341d","f129cb2bdae4dec33ebc8465b553c6d08098bab682c91c062c47fe336b47c203","8b0644dba9ce9fa30ef40beeb4866059d63100a3fabeeb1bd14568ff3d39f400","b15887b94b94b41608c170c5914cb81c701b8a90b77d04ef6f6dd5d5486d8116","1e0358e7804b6e56b2051a0816533d683b59d75253564a4613f40e6313d9d205","b1db0bc2ade178a8c0e204651125f73f6ab508098952860a57ae3c19c9ac9e8d","c6628a9c01e8d6ba5dc0b1a02dad2590802443aa288f560c0f0f86331486ca84","5aa1b342b06f4c96d1ff1b7b4fec750d5afe24296440413802347cd9f10087c2","6e864f200b92f78eba8e9088165e1cb12e436b480424236f628dc55fcbb20e80","9e5b97cc3eae9ad0de8ef1b6ecf7b36dc8e31500964da768554240963e8bba29","1c796b7732ab07544e4e27d3aa6d687d410d6f810827652a6c00aad114320bae","6edc60de574eef7aa3075bb7a8a1f7694441f4c0ac42640b894e32eed186fb98","37ab5ca1df99630dcb34e6af77cc1e1acc15df2c22eba904ad7e735cc59c9e33","91eeb9dda36f9aea0aafd7d5ac6b42f5cc749345e0962c7c822fc5ec1f39764e","75567dba58f50e1a809a10ce3748aec9de3150af1db35202a1ca97fa86e8d2ba","089e2915827e951179e68833923e9bda5b669b18d512d2b904410e5432307067","031c8a56bc8334fbb858ec14a97772a74c90597a39319503ddbbf1eb69bae7b1","5d4f6a7c4677ef0bbb0c66008778e82769ce3d7917981913fcd15e77624e9645","813ba515fe04419f88121c1a7f90c178337e1cf11e339683fbf2313134c2f0d1","fe0c54739e20acf99cc44826935c6e54c4a9763e71a4b17ed3a8fb0bfa0d2b4b","8ee655b7ba1c535c8029c114d4a1c1a8e3952a78766d33f927a2ee2d9efade4e"],"paragraph_range_zero_based":