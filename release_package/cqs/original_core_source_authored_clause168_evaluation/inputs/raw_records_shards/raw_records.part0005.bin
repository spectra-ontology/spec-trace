{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>include preferredK2-SCS-120kHz in the MinSchedulingOffsetPreference IE and set it to the desired value of K2;","paragraph_zero_based":1776},{"literal_text_all_w_t_and_m_t":"2>else (if the UE has no preference on the minimum scheduling offset for cross-slot scheduling for the cell group):","paragraph_zero_based":1777},{"literal_text_all_w_t_and_m_t":"3>do not include preferredK0 and preferredK2 in the MinSchedulingOffsetPreference IE;","paragraph_zero_based":1778},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide minSchedulingOffsetPreferenceExt of a cell group for power saving according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":1779},{"literal_text_all_w_t_and_m_t":"2>include minSchedulingOffsetPreferenceExt in the UEAssistanceInformation message;","paragraph_zero_based":1780},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on the minimum scheduling offset for cross-slot scheduling for the cell group for FR2-2:","paragraph_zero_based":1781},{"literal_text_all_w_t_and_m_t":"3>include minSchedulingOffsetPreferenceExt in the UEAssistanceInformation message;","paragraph_zero_based":1782},{"literal_text_all_w_t_and_m_t":"4>if the UE has a preference for the value of K0 (TS 38.214 [19], clause 5.1.2.1) for cross-slot scheduling with 480 kHz SCS:","paragraph_zero_based":1783},{"literal_text_all_w_t_and_m_t":"5>include preferredK0-SCS-480kHz in the minSchedulingOffsetPreferenceExt IE and set it to the desired value of K0;","paragraph_zero_based":1784},{"literal_text_all_w_t_and_m_t":"4>if the UE has a preference for the value of K0 for cross-slot scheduling with 960 kHz SCS:","paragraph_zero_based":1785},{"literal_text_all_w_t_and_m_t":"5>include preferredK0-SCS-960kHz in the minSchedulingOffsetPreferenceExt IE and set it to the desired value of K0;","paragraph_zero_based":1786},{"literal_text_all_w_t_and_m_t":"4>if the UE has a preference for the value of K2 for cross-slot scheduling with 480 kHz SCS:","paragraph_zero_based":1787},{"literal_text_all_w_t_and_m_t":"5>include preferredK2-SCS-480kHz in the minSchedulingOffsetPreferenceExt IE and set it to the desired value of K2;","paragraph_zero_based":1788},{"literal_text_all_w_t_and_m_t":"4>if the UE has a preference for the value of K2 for cross-slot scheduling with 960 kHz SCS:","paragraph_zero_based":1789},{"literal_text_all_w_t_and_m_t":"5>include preferredK2-SCS-960kHz in the minSchedulingOffsetPreferenceExt IE and set it to the desired value of K2;","paragraph_zero_based":1790},{"literal_text_all_w_t_and_m_t":"3>else (if the UE has no preference on the minimum scheduling offset for cross-slot scheduling for the cell group):","paragraph_zero_based":1791},{"literal_text_all_w_t_and_m_t":"4>do not include preferredK0 and preferredK2 in the minSchedulingOffsetPreferenceExt IE;","paragraph_zero_based":1792},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide a release preference according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":1793},{"literal_text_all_w_t_and_m_t":"2>include releasePreference in the UEAssistanceInformation message;","paragraph_zero_based":1794},{"literal_text_all_w_t_and_m_t":"2>set preferredRRC-State to the desired RRC state on transmission of the UEAssistanceInformation message;","paragraph_zero_based":1795},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide an indication of preference in being provisioned with reference time information according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":1796},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference in being provisioned with reference time information:","paragraph_zero_based":1797},{"literal_text_all_w_t_and_m_t":"3>set referenceTimeInfoPreference to true;","paragraph_zero_based":1798},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":1799}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["e25bf4af2fbeb4295c605bcf3f01d894937b9b858e2d43fafc696174062af9f1","6fb583888de0a8e67fb8ec2cb2bd422f4e693e66bc4f41bfef81877ab2a515e4","f7df943b207e90c3a13cc4125bdbd16a355ca05184039620162f6de77705edff","6d4ca80991ac1d0defbc820de9ed01f0ba2b670070d872b7ce96e29fb52392db","c7f3c8904976ac7d345a7aeb5fc0c50b308aa6c43c55b1a011714ac1e444972a","5d84f8a21e7d3ce1fcb55650f5bc73b37e14449f44c9c1cd93d60d19948f0e62","8cdde20ca8e450bcff0b64aaf82cfa1f29f78f1b2d928f0cf9174ef3940d8536","5eefac0dc473beebe9cd4eb49ecd19c55ef4b55c93180ef0a37929b126441666","de97e4ee2eb7ef7a99f7ebb103527cc15dd1ad64f735335eb90ec10a1d8490fe","73968a9dd14d9f7083dbbeee1054298c8af5e9f91f13214d3ce7f5b1fcb6a682","01448f0761584995f467f53f47e6f2493dd4e186667586b0fee99cd2fd26ffbe","dcad847d67b2d9f2c28637260bf0403162448fb6043b631a7f566a82c77a7ff8","642b4cafc29cb8276f4340c6bfb3001d762045196ea986785c36e01ec77e0ce5","4685e51aa3df5c3fb694873b8c963a0912e2f7499c891866770528b5696091bb","50e50c22c951816a896687d9df009c61a266af0cb81533e50b7c2e3c0fc75c35","417421097cc24ccb1714633d66744ada81340565f3c32ab6e26cc65ca17b3534","eed1fdd9b191d7d841f664cb2ed3f7e717cffeb05acc33ee638d64ddfba4b46f","6e7762b4056720789169b5fd4d4bdb63a23ae45488d29024bb205fde9c146ec4","afe3d906d3d647d77ab0eb040837e36d73e91ac567580c239ec8d1f872c7f9c2","92d6a44341c7e7e1fbf7b26f2a86686920497f21cc76dc6c9fb0bbd5050d8672","431afbd780536d52bdd13067eaca4381e21967e5cd7a38dd7079ea82bd505513","ca8eb344d5b5e712eaeb6eec6482c83425b259d09e0317ebe7dfa