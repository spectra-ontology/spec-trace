{"fields":{"filename":"R2-2409054.zip::R2-2409054_38331_CR5070_ Correction on field description of reportOnLeave for U2N Relay_R17.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"utra-FDD-RSCP corresponds to CPICH_RSCP in TS 25.133 [46] for FDD. utra-FDD-EcN0 corresponds to CPICH_Ec/No in TS 25.133 [46] for FDD.","paragraph_zero_based":288},{"literal_text_all_w_t_and_m_t":"For utra-FDD-RSCP: The actual value is field value – 115 dBm.","paragraph_zero_based":289},{"literal_text_all_w_t_and_m_t":"For utra-FDD-EcN0: The actual value is (field value – 49)/2 dB.","paragraph_zero_based":290},{"literal_text_all_w_t_and_m_t":"y1-Threshold1","paragraph_zero_based":291},{"literal_text_all_w_t_and_m_t":"NR threshold to be used in measurement report triggering condition for event Y1.","paragraph_zero_based":292},{"literal_text_all_w_t_and_m_t":"y1-Threshold2-Relay","paragraph_zero_based":293},{"literal_text_all_w_t_and_m_t":"L2 U2N Relay threshold value associated with the selected trigger quantity (i.e. RSRP) to be used in measurement report triggering condition for event Y1.","paragraph_zero_based":294},{"literal_text_all_w_t_and_m_t":"y2-Threshold-Relay","paragraph_zero_based":295},{"literal_text_all_w_t_and_m_t":"L2 U2N Relay threshold value associated with the selected trigger quantity (i.e. RSRP) to be used in measurement report triggering condition for event Y2.","paragraph_zero_based":296},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":297},{"literal_text_all_w_t_and_m_t":"PeriodicalReportConfigInterRAT field descriptions","paragraph_zero_based":298},{"literal_text_all_w_t_and_m_t":"maxReportCells","paragraph_zero_based":299},{"literal_text_all_w_t_and_m_t":"Max number of non-serving cells/candidate L2 U2N Relay UEs to include in the measurement report.","paragraph_zero_based":300},{"literal_text_all_w_t_and_m_t":"reportAmount","paragraph_zero_based":301},{"literal_text_all_w_t_and_m_t":"Number of measurement reports applicable for eventTriggered as well as for periodical report types","paragraph_zero_based":302},{"literal_text_all_w_t_and_m_t":"reportQuantity, reportQuantityUTRA-FDD","paragraph_zero_based":303},{"literal_text_all_w_t_and_m_t":"The cell measurement quantities to be included in the measurement report. If the field reportQuantityUTRA-FDD is present, the UE shall ignore the value(s) provided in reportQuantity.","paragraph_zero_based":304},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":305},{"literal_text_all_w_t_and_m_t":"Stop Change","paragraph_zero_based":306},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":307}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"dffe1a8445246f2278e7731f675967c0505370e1ba0a5bc356385f19baa56b49","original_member_sha256":"aed2ee8200170ca0334b7fb2250e431150a032326f0b60d8bff3f2577b7af0ff","paragraph_ElementTree_utf8_XML_sha256":["423e0093aa3bec349cc67ec6ac4164c5eed1b0d8e9c534e3a18972bfe7e808a6","369f4901a8bd32d7e271767d46a21b63f3086506ac01db4e8c0e2c825734857d","99051dd070a9bd5614345f5b7223f0623dd76914bf3a271946f2ffee7c7d7b5a","8077d9e45744411419cda75644961190e47b8b2bd83751f2b3672d12a9204d1e","1296720e6ce98d410c5669d10972dbb409ebe9bee39976662ec792fff2550b4b","2717797972457e88c0d0525fb68805a2eba6c06055d751104ac400183d0ed35f","43232af5351c7181dc111e08802fe0bb5e362c174d29a1efc2d8b22d78835b17","c678000a50d1d1b3dbb652b736fe0041116e8f020de7c53d80d1619f0be77ced","0cf93bff64f528c218fd4667edce3c7e1948bd7f157c84d491e62feba2259b01","25c2a9313930c16486e950a1d04343ba4dc144b0451c22322fbbc015d0a1aae3","6d71011ff697c9bdf45841f8dbe3e737cf78fcbc417f6ff26725c5db14c4c057","4417e45bb6bb4b3cf8055be70a0fe1f88c817ac6949ca40f7afe489cfeef79a8","cf60c02ae88b363e3c9c7cd10e70a6f24e2c2cd1208c44ccc84f79ae2dfbf36d","bec0237e023144fbbb971cbdee2f36619dae5924b98d1f82b154733f4a1e1e2f","8b153b3f7ee52611af56ab95