zero_based":211},{"literal_text_all_w_t_and_m_t":"inDeviceCoexIndFDM-r18","paragraph_zero_based":212},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports reporting of affected NR carrier frequency ranges in IDC assistance information as specified in TS 38.331 [9]. A UE supporting this feature shall also support inDeviceCoexInd-r16.","paragraph_zero_based":213},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":214},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"07548170a78db80f735ccee09196c0bd7319249104911a4435888a81fa42ebc8","original_member_sha256":"4e1426c6554f6ae9bf90d915c14ab4f606ef4e51023d4fc251844e3b54784cc2","paragraph_ElementTree_utf8_XML_sha256":["4730bbbce0f34c7afada88891fdda261cae3baaf49df832d69bd282670b3f42d","e5fab2e402e901ccbc358f82426fe77e07cd5ad19dcb255305f3003265aeba87","fb7cbd185566f7a1c924d52c5e462fabc24b1d9375f8dad5f4230fc8f92bf07b","4596ba79fb00ef10dcec5d2ef616bae12146bd35f5d22b0bd1a12ad19dc60a44","6d2f5f929fdc1d1f051ae1fd72b91d38d0976c063646c9c8203289a867409ac0","cecbf1296b54f51d7379f817a3ca07c8924cd70fd67afd24c485772087402429","8ccdd7e92cacaa2ffeb97432f4d559180928b028f3f5f5a2aa7bdae577d3c101","a1f43a281bab22729f03dad775e4d6f1bd3551823c1c2a360a1c73a00f676fe6","9641f536e5480ae4a59154753974fcb3492f297ed09c656e54b46d365336d137","12f3706dc22519551e9e63fdd00fe93001a1b10c04f1b731f29835f7da9889fc","3f9e2fee1d89e681401e8fa896824751ea1e1274932dc0afb1aeaee90b005f76","692d1abb2481b108485f6f1f6bf7d8002f187364bcd0334288ff8f40d9f2eb5d","4c1b42a0d843796dc596a124ee0c16d13b347e6c01eccf3ac89762f479883606","d0f05849bd95862bd0c7e78f82d159f7d343cc67135716a9ffd7e81bc0e0f39c","61c1fa2b1f671504f76e350b639193693bbe9b1364e67d95c9d52409fd1b25c0","e61766f558506de9f3da3786a5d44508d9cbef20d955def156675d71d9a83048","58671878b1171fbf9aa0baee7b63e3e83a16f68285f4ff6a8af613fb1eeac5c0",