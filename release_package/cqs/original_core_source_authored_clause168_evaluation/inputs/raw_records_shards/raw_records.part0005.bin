{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-MappedQoS-FlowsToReleaseList","paragraph_zero_based":48576},{"literal_text_all_w_t_and_m_t":"Indicates the list of SL QoS flows ID of the NR sidelink communication transmission destination to be released from existing QoS flow to SLRB mapping of this sidelink DRB. ","paragraph_zero_based":48577},{"literal_text_all_w_t_and_m_t":"sl-SDAP-Header","paragraph_zero_based":48578},{"literal_text_all_w_t_and_m_t":"Indicates whether or not a SDAP header is present on this sidelink DRB. The field cannot be changed after a sidelink DRB is established. This field is set to present if the field sl-DefaultRB is set to true.","paragraph_zero_based":48579},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48580},{"literal_text_all_w_t_and_m_t":"–SL-ServingCellInfo","paragraph_zero_based":48581},{"literal_text_all_w_t_and_m_t":"The IE SL-ServingCellInfo is used to indicate the L2 U2N Relay UE's PCell/camping cell, which is considered as PCell/camping cell by the L2 U2N Remote UEs connecting with this L2 U2N Relay UE.","paragraph_zero_based":48582},{"literal_text_all_w_t_and_m_t":"SL-ServingCellInfo information element","paragraph_zero_based":48583},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":48584},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SERVINGCELLINFO-START","paragraph_zero_based":48585},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48586},{"literal_text_all_w_t_and_m_t":"SL-ServingCellInfo-r17 ::=     SEQUENCE {","paragraph_zero_based":48587},{"literal_text_all_w_t_and_m_t":"    sl-PhysCellId-r17              PhysCellId,","paragraph_zero_based":48588},{"literal_text_all_w_t_and_m_t":"    sl-CarrierFreqNR-r17           ARFCN-ValueNR","paragraph_zero_based":48589},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":48590},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48591},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SERVINGCELLINFO-STOP","paragraph_zero_based":48592},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":48593},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48594},{"literal_text_all_w_t_and_m_t":"SL-ServingCellInfo field descriptions","paragraph_zero_based":48595},{"literal_text_all_w_t_and_m_t":"sl-CarrierFreqNR","paragraph_zero_based":48596},{"literal_text_all_w_t_and_m_t":"Indicates the DL frequency of the cell indicated by sl-PhysCellId.","paragraph_zero_based":48597},{"literal_text_all_w_t_and_m_t":"sl-PhysCellId","paragraph_zero_based":48598},{"literal_text_all_w_t_and_m_t":"Indicates the PCI of the PCell.","paragraph_zero_based":48599}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["efaeac6bfc2dcbaf15aabe1a359959e846186b29e108e967c7467836c7c084bd","970f887a085faffc859cedea6d59005561a35a6458905979ec6fdc00a5d47678","83578562116ea23e2c03ba27d5cdda6ff1a8967cf9dd8a0b0119958761929a7d","ba976844298524fee5641e865a2e1368fbff27af28f83b12b013e7cb6d2a7071","6be62012617dc4e2b3b5fecad670a1f1f895a4566f488dbf0415907aa0885da6","7608cf9145a173c9a01ecaf17c985fd3f27c67b7e6b0263f90c1eab8f6b1f89c","e90df803734493b2ed0af3ef9497603567ac9a0a08e57e9c16fdd4e0ed544878","4452989501dc9b21ef7eeb8f96fd97b88c23a93be9c5e57429e46ac61f04fc0c","46a892617e2a947c1578ab6ff2430e37dd81459df464de29e1c0a34d5519858b","deb09ae42a39eb45d09996dc92fe47cc3185be0b5d4e9709cc75f1c276895993","f18cbdfb015e7eca9a6ca3bc52e1b5e8624854bf30fa053f8881639a84431201","d3f6933a5406ec0fff8b301505cc72caf43069bcf399ed439f35302e6038c976","d48a5519866c6ee61d5cb4f356f924172d225fb5203831946f2