{"fields":{"filename":"R2-2505201.zip::R2-2505201 MAC CR1591 for R19 IoT NTN.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"B","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Rel-19","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-17(Release 17)Rel-18(Release 18)Rel-19(Release 19)Rel-20(Release 20)","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":"Reason for change:","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"This CR introduces the new feature from Rel-19 IoT NTN enhancement work item. The MAC SPEC should be updated to support the one new feature (referred as CB-MSG3-EDT procedure). ","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"<1> A new section is added to specify the initialization, transmission, and reception for CB-MSG3 EDT procedure.","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"<2> Update DL/UL data transfer, TA Maintenance, and MAC Reset clauses to handle CB-MSG3-EDT procedure.","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"<3> Introduce New MAC PDU format (CB-MSG4, used for CB-MSG3-EDT procedure)","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"<4> Introduce new RNTI (CB-RNTI) for MSG4 monitoring of CB-MSG3-EDT procedure.  ","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":" ","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"252e3db5c0fe6d9887e82b2df2ea8829102397c8af77f7385ddec9a6c33e6ae4","original_member_sha256":"0ffdcfe63374625f16531d69d191fb330a4f3ecc2b0886fb54c08f68a4b7f2f4","paragraph_ElementTree_utf8_XML_sha256":["bee50164aa759fa941a392606fdc259e74194c90e3e94c44ed73bba16cffb903","a184cc8b7bf92957a25df1d0af5f7ae23d3c4bf0316c27f374dddb3a0dbff69f","fea07f5ce609ba075cab4c8d16d526619705781fc79e8c9c7419e927b904fd17","c99b9b447790dd8f45d5ace92445163541b7c75ef151d57372c94093a91b8e29","55bba9ac2c0317f3c0d59e8b02885baf9f88832ff9ad003df50c2eafef7b575d","f862aac4cff75780b751619e9815ae643c4e31e1c265a7bd5974163018549fab","123d10113ca4682acdddf00407803cd789dfa1002415100a515a48f06fb93ca7","c6af085008d5c828e5e30e5a673ab5d1c93235fd4d2c4bc5963665ba5bcf643f","f6e14d129f8d86a29205526f65d54dd0bb4e9c642cda1a6750eddfee76729c72","def7ff14692b4fc8aaace411f2ace4a23af0b956207f9e6be1ca676d490f76ed","3bce664741e61fb0723333a593969534633c4f19b30c1c1542a4f70cb643628e","e35718b2b2beb1e34b2ba6fff9d0100c2a2230d131b5ea6d562e003014b52b32","c8dbbafefcbe56bcddf84f0155b75ee6f2e1e5aa01f41a4d8eecd7ab6db4addb","5b07bc5ba28c0ddb374e166aaefa2b4dc0e600f404c4d19ed3fb68f742512393","316dd9b5787251f04f3987e85950ab7114377718afa67be2b095b82bdea17b3a","89dbe7198bf532cfdd0888ef4e9978d909436ee1118449c7a12d90b6bf1f5b93","8030ee24e10baea18a38ce745b9a6202ef38500490b73dd2f3fe8d25a957706d","a462ec2b0f635f7bd5628776a0e656e3b8a308315c2cf11daf4fcc0e5aae9e8c","812e28cd426df4a4123785a752393e730e6fd4cab0c377746214ee3f28be230b","dcbc818bf1bc2fac6b0c361900bd9c908278ad4f9de831c6341353cf08ae8268","fd5a6b808daa80a69c8fc1089a97d297116a1db786434cf755ecc06fb7ccdfeb","a51fa6baad76bc513bf9eebde0f1b6eb82b45e515261e4fe54316b9a8342e809","9e8fb42383003323e156f1a713d7b803cbaaeca316e3fffaf6c331b28a739c8d","3436ae98acf136b4197557befc1aa249065089119865a908607b8a3bf0fae115"],"paragraph_range_zero_based":[48,71],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2505201.zip::R2-2505201 MAC CR1591 for R19 IoT NTN.docx:p48"}
{"fields":{"filename":"R2-2505201.zip::R2-2505201 MAC CR1591 for R19 IoT NTN.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":72},{"literal_text_all_w_t_and_m_t":"The new feature CB-MSG3-EDT is not supported. ","paragraph_zero_based":73},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":74},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":75},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":76},{"literal_text_all_w_t_and_m_t":"3.1, 3.2, 5.1x (new), 5.2, 5.3.1, 5.3.2.2, 5.3.3, 5.4.1, 5.4.2.1, 5.4.3.2, 5.9, 6.1.2, 6.1.x(new), 6.2.x(new), 6.2.y(new), 7.1","paragraph_zero_based":77},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":78},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":79},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":80},{"literal_text_all_w_t_and_m_t":"Y","paragraph_zero_based":81},{"literal_text_all_w_t_and_m_t":"N","paragraph_zero_based":82},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":83},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":84},{"literal_text_all_w_t_and_m_t":"Other specs","paragraph_zero_based":85},{"literal_text_all_w_t_and_m_t":"X","paragraph_zero_based":86},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":87},{"literal_text_all_w_t_and_m_t":" Other core specifications","paragraph_zero_based":88},{"literal_text_all_w_t_and_m_t":"TS 36.300 CR 1425 TS 36.331 CR 5137","paragraph_zero_based":89},{"literal_text_all_w_t_and_m_t":"TS 36.306 CR 1912","paragraph_zero_based":90},{"literal_text_all_w_t_and_m_t":"TS 36.304 CR 0882 ","paragraph_zero_based":91},{"literal_text_all_w_t_and_m_t":"affected:","paragraph_zero_based":92},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":93},{"literal_text_all_w_t_and_m_t":"x","paragraph_zero_based":94},{"literal_text_all_w_t_and_m_t":" Test specifications","paragr