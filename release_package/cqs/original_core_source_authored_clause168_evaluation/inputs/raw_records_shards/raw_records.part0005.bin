6f935510b907b3185dac68233a5830e09dbf","original_member_sha256":"b825bcf088dee646717bcce3a09c4ddb86bbdb6f5f32b5ea519c42a69f1dcee4","paragraph_ElementTree_utf8_XML_sha256":["8f1f485f5e522aa5fa5cf2b1129756da782769b81130b58628f9442c80e5e2c8","d0f01f104688b45e85bcacfcd35f033d12c0fd35d5ee5796505e3a9070e14552","56298b369fbae8bd0775b7d95de33c5a887222c7ca63b468e6f2223125d7ce6d","6ae938dbe22c1a58362f1475a4f315342e32f427dd536495b0c7c2bea857e359","fc1e0e81c7df81117d85cd0d53f449e7ab6dda415c163935819381551aebb1fd","966b13a5f09fa9b8bd2c326ea6af61c8bc449c3a925bec163cd4d448b45ed27d","9e15c5299139fa99d6b31b6eb931c5c7dd0561466acee2f2cb40a34565aa276d","9bfc08279f1717a1b6f620dabac70b6086491ccc173cddef75f847013108513a","97ed49d5351b2a7df9dc371b48005f8da8cb6edf5dbf0ff82a87e81e9564b8fb","a05eef309eb6b078ff409a3e13789f731bb1989b363c49db6484a8438c85b646","25f1009937adb21ceeb270f12db67094ec7f218a6c980728a64b897dddced307","d8f38a968e37939d55bde373834c3a62d0c37c660290df6a93c1c0d5a19222f0","f90da496dac0aa28618840b00e3ff7d3380343520e0a83709b563b01438c18fc","e8840c584a39d4b6814253c9fe18b4d497453af68920dbeb168969a4bf563413","262b879c88e1f50e091414126ea00afd8046fdd2c49ad0d633b0b3dfc7b44ae7","4fdd825df1d5406f41129c1227a7e6e34ffa941634066645eadda2e35d84026d","6eb6cceeb4eee644bb57875a5e3ce4a9fbcb426c628ca586d1c929422c393b82","74bae889f6066812451a4cd32ff9b60703555ab082d29c9568f6fea0f50bd0c4","47d6a340985476b862d37e32044d8795dc8686b198166247521108b4cab8dc61","5b684a094fd355cc0a10cfd5c8029df0e7d6561ed358edfc720b9dcbb40eafbe","00eac0b3b0be44cfebb9c3f78bddb922103a9b1eab5b66a42873b46632c99670","1ab1cef8465619e3fee757deeb7c2b6ac011444b918cf98c7af3d52a6c92a2b0","a9788523f553b98ef1ec6eab7100948077b647d59bcf5d5c3191876837278875","f54a0055f00fe0c5c12914f0abb3e3817b97f7b301a0b5ddf62c96ef803ea255"],"paragraph_range_zero_based":[24,47],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507098.zip::R2-2507098 RRC_R18_RLC-channel-config-v1.docx:p24"}
{"fields":{"filename":"R2-2507098.zip::R2-2507098 RRC_R18_RLC-channel-config-v1.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"A","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Rel-18","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-17(Release 17)Rel-18(Release 18)Rel-19(Release 19) Rel-20(Release 20)","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":"Reason for change:","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"For L2 U2N relay UE, the PC5 Relay RLC channel configurations in sl-ConfigDedicatedNR in RRCReconfiguration needs to be configured accordingly based on the need of SRAP configuration included in sl-L2RelayUE-Config. This is because the PC5 relay RLC channel configurations included in sl-ConfigDedicatedNR are destination-agnostic and do not indicate which PC5 relay RLC channel is to be established towards which remote UE. ","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"If the relay UE blindly add all configured PC5 relay RLC channels towards all its remote UEs, that would waste PC5-RRC signaling overhead and result a lot of unused RLC channels. If not, then, based on the current specification, necessary PC5 Relay RLC channel(s) will not be setup if only SRAP configuration has been changed but sl-ConfigDedicatedNR remain unchanged. Because SRAP-config change alone will not trigger PC5-RRC procedure. ","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"Hence, the dependency on SRAP configuration needs to be clarified when L2 U2N relay UE adds a new PC5 relay RLC channel.","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"For PC5 relay RLC channel modification/release cases, no change is needed because there is no ambiguity about which RLC channel is referred to which remote UE","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"In 5.8.9.7.2, added the sentence to describe L2 U2N relay UE only initiate PC5 relay RLC channel addition towards a remote UE if the remote UE is indicated to use this RLC channel in accordance with sl-SRAP-ConfigRelay. ","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"Impact analysis","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"Impacted 5G architecture options:","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"NR SA ","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"6a33b84ecdc1f33ed8f6c4004f7e6f935510b907b3185dac68233a5830e09dbf","original_member_sha256":"b825bcf088dee646717bcce3a09c4ddb86bbdb6f5f32b5ea519c42a69f1dcee4","paragraph_ElementTree_utf8_XML_sha256":["0c59172d2ed700262d6e5c281417a023cc7bac19d809c27d13162c91e0eb7875","bca6609961f75cd2f1c7236dd1eb237e73b8bb9020a185d3ed6bf86a2a6e6073","62d9bbc778e16f0a71dd25a3e03ba3711a0cf79f4d1895beb7142ae9d28b6a0a","047a953ed190c0be1d4448c0ef790d3d76d47f379d7edf8679a43f7428c6e9a3","d7f03344c156ea21c8e4c1ce326123168014056057faab7391ef803becfc2718","0f2352fad156d8606d612737cc8e9228175058a356584db22a399a566a915f91","4a9548d48d12f6daad25b598c260c9118caacdd63a181bf6fcd18161d02d98fa","f7095d1357dfe8ce0dc69f8969cd3f82c7b9554554177aa23a98e635f885c934","bed2f467e645d41d8aa1eae39a5f64c764825a9043d005d696ba46302192e951","73936b4b363ee14532022498bb32318442f8db80bbf7b52a259239a37d7ab529","34c6769e1a5404ee288bea7130c80e59a1f4de6b6cb8c8776d0280a95abc6f33","c0c54394bdedd07e23d30cdaf608607166348898eacb204753fb4ddb3e42ec76","2ec31207db7d30e687df0beae014e5e2de1c90eb54bd599df3a7ed1609dfc76c","cac9e08871d38ed7bfb45bfc50a281bf09bf2e3a082074e9b2571c9590a46eef","c6495adf5493673f0894bf112d06e7251e833865f9836fde4c397867faee4f5c","6c2016eb7e5fb47807c7b04e052e45b71d5dd2229d623653531e3a3bf0c63dd3","79b8af271eb0e5d6965d37a79853defe2201127ef7bd68f3b21b18e3e0f8d861","cbf343d7ccdb76edd8afa7e5dd98c98bf0be660776d789d9c6ee92bb48dae846","9f44ebeb28a1df947db4c4ab929ceb0323e5a255e88bd91f1457913ccf98a770","6a6c920286d24f5174bace8e44bdd9976c9266280a5220994dbe765cf4cdf776","f33bdf4cf42ee79c4988ca395028fc1832785dc88c3093ae274f4664de91e984","b59f8f1e3859eb7f2103565076ea7199774e62b1e0b0f7754fb62bb3a2570f89","28934931125e7b0defff420ce5c3f171c3ac6df98a5b384280dbe0770c5170c0","9b5d5c65e163924ebe9c932ace6e3d02e31663c9deab568bf797dc6c7e5f9df6"],"paragraph_range_zero_based":[48,71],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507098.zip::R2-2507098 RRC_R18_RLC-channel-config-v1.docx:p48"}
{"fields":{"filename":"R2-2507098.zip::R2-2507098 RRC_R18_RLC-channel-config-v1.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":72},{"literal_text_all_w_t_and_m_t":"Impacted functionality","paragraph_zero_based":73},{"literal_text_all_w_t_and_m_t":"Layer 2 Sidelink UE-to-NW Relay","paragraph_zero_based":74},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":75},{"literal_text_all_w_t_and_m_t":"Inter-operability: ","paragraph_zero_based":76},{"literal_text_all_w_t_and_m_t":"If the UE implements the CR but not the network, there is no inter-operability issue.","paragraph_zero_based":77},{"literal_text_all_w_t_and_m_t":"If the network implements the CR but not the UE, there is no inter-operability issue.","paragraph_zero_based":78},{"literal_text_all_w_t_and_m_t":"If one UE implements the CR but not the other UE, there is no inter-operability issue.","paragraph_zero_based":79},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":80},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":81},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":82},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":83},{"literal_text_all_w_t_and_m_t":"L2 U2N relay UE will either unable to set up needed PC5 relay RLC channels towards its connected L2 U2N remote UEs or set up useless PC5 Relay RLC channels.","paragraph_zero_based":84},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":85},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":86},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":87},{"literal_text_all_w_t_and_m_t":"5.8.9.7.2","paragraph_zero_based":88},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":89},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":90},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":91},{"literal_text_all_w_t_and_m_t":"Y","paragraph_zero_based":92},{"literal_text_all_w_t_and_m_t":"N","paragraph_zero_based":93},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":94},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":95}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"6a33b84ecdc1f33ed8f6c4004f7e6f935510b907b3185dac68233a5830e09dbf","original_member_sha256":"b825bcf088dee646717bcce3a09c4ddb86bbdb6f5f32b5ea519c42a69f1dcee4","paragraph_ElementTree_utf8_XML_sha256":["9ce2f640a6d9d407f56b554bc54241f74551ca9a72987a3946dc7504f2bb0f90","96888a68f90e7fbf3ca55578b7b2236ac1bd4884746290410d39b2519f3da9ba","a168aab6a14b12bcea779b3df657e3b884675c554c9e3c9e5caecda8106af6b5","af76b59dec7684699cf17f488069dd447fb091596c6f42bfec485570d2b742e7","de6d5c4141eb1f59f5acd758111afa7659b948db2c4140dcbaf33f98b1de379b","f0d71aec3f01e3701bdf63466f50bd09bef76d4e33acd9f4d5a6304120e2be5f","1ecdab2f989f332e84a57192487b3ee43e7972c4e39172c52a5bdecf6db93663","90a6ac79f092c64a3b3c6867c3ba2cee3b01cf3c5c8aefb8243d9b5626d30e21","2680ebbb8e6e796e4381d493498174969ab87198054af556a3da0f68859b1cfa","b812fedd4fcc5b2036c6134eaf57c268c41e91d9898116c8a264adbf8bedfff2","f2236a7aaa561d4f27e86194d667e11dcdeaec7256b65a069edc5dbf352f9b58","d03c71a91f302cf0a2223216f131da8d99c7983166846b02cf219d99695f6e28","d0c31f616cd2031f814c617f5793c985c364d480fa2123656b5732bd300b3a88","b4b2a2de7e66e7e098100dfd52b5289707c26ea50a87b7339b80d1312b252999","add2d1640c309a83284a3032e0304b400c893d05baa0c49f3aa1c0048b79c06c","fe84e378763735cc82208bc045ad62a14a020bf67486718b2493d54e8a36efdb","f60e695144ff88f4320064d661463c02cfc999c4fd2f73697cb76d8201ccff22","b2e337288ca7fb00a48337f39e0f08875a9e736a999bccd95e822f015bc67230","f44748aff7530135bde1ba6137d7860ccaffe9309474b1c7adba47460793466a","94c39a6e17e9c26e07822fc9514249feb20f1773a31d0f732e435ac2b466c75d","1b1e548efccbd61451d2d9c8ecddf4b663d975236b4afb203e92e783628c651d","cac36164eb87b099c4d7bb55e6c419893