agraphs"},"source_cell_coordinates":{"document_XML_sha256":"c136d386c2ab7c411bdfab56c9560da44fc929eeaad6e4d81a109c97d0d25b9f","original_member_sha256":"65d9ccdf99e14a6f15f2b80367bbfb99fd1beb5a06d0e2fb13b1c52519336cad","paragraph_ElementTree_utf8_XML_sha256":["d3098623b4dfc23a1a4b383cc6c305d01a4c1c56ac54d5853c2f6542bbe0ad3e","d88bc81b05cdcb5373fcefe52e78f5e5b7ea4e37e19c0d9ebb00bb2abbe8ad2d","61cf31ccb32ca743f815831546a63f3d4f37ea5f4ff7e02e623d0e686dc91277","e4e56d585997e9eaafd49ea11fadd9ed0b70ab2e61b07361058e1b9f7a01dd92","d3262b1816fab55992cffb02c05a6ffa91b6523e243fbbc95fea56d1d4a60b90","c3683d587e9395b4366df402366a37ae834beabe3792a5a1f587771601d39ee1","ed998830d31c45491e1e0440155b1f04906345d5cf11cf124da3b8514b084b6e","906013edb57524be9364140bb342f747d25cd914a658ac9688cc0e1c36c48a4e","cab89597302c5ba322c3b7522dfdc53fa38c04425d13ef616d215a001889c126","cb1f68c3cb7a527ab8d0f7a4b7dbf74587c5012a7899a22e9846e53e203421fe","65ac2483d208b50090003208e2b80a9b3ba9afa4b052a079f5511890803e3032","13a296cdc0117fe8fab98180233cab30f64a0cefa9202305e6800261ccf44a19","5a13fceff94c505bcc5a761d985dc17eb1bfcf9724f7626d3bae06c87b37acc0","9292f5069abbfd75825746107e0705221d284c10977357e7cf7010ac5cc8abcf","7ae559ec2991ca97b15292717e994fec32dd6bb2702fd82d71df5f6d3449fc80","59190e70ece9ffb806e9984eb0949613812c790031ebd2f417b07742101bcec3","5b9d3e94b2e2469a162f36c651ac6802b31fcc4b4fed4f8769f27295b66f32e3","0e47661d68410752894205dee6a9bbbad763c4fb8f938472f606caa30fd5b3b2","879f574c7533026f0f1fdd9c8956f622a586bad9ece08cd6990393773177293a","046072d789da32203b2dbdc5bf6faf7ce0947321bf61b1475c3867e7f07b4f28","ad7c58beb1d9e90fb0849bcd216a0fa195ed528b17181f725cf2b49a179cb8f1","826ddaefbd35bf5941dd0ba7402603c67afa4054d718e9bc0124542ef7dca6de","f93659204248bf7212a2a073874fa6ef6bab855e1f334d94d95f69bdfcb0d978","1f410e726d304214a874eb5f63bfb936ee9c1cb1603feb77631fabf0a168ec99"],"paragraph_range_zero_based":[96,119],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507533.zip::R2-2507533 Correction on processing of sidelink grant on Dedicated SL-PRS resource pool.docx:p96"}
{"fields":{"filename":"R2-2507533.zip::R2-2507533 Correction on processing of sidelink grant on Dedicated SL-PRS resource pool.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":" O&M Specifications","paragraph_zero_based":120},{"literal_text_all_w_t_and_m_t":"TS/TR ... CR ... ","paragraph_zero_based":121},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":122},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":123},{"literal_text_all_w_t_and_m_t":"Other comments:","paragraph_zero_based":124},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":125},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":126},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":127},{"literal_text_all_w_t_and_m_t":"This CR's revision history:","paragraph_zero_based":128},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":129},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":130},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":131},{"literal_text_all_w_t_and_m_t":"================================== 1st Change =================================","paragraph_zero_based":132},{"literal_text_all_w_t_and_m_t":"5.22.1.3.4Processing of sidelink grant on Dedicated SL-PRS resource pool","paragraph_zero_based":133},{"literal_text_all_w_t_and_m_t":"For each sidelink grant, the MAC entity shall:","paragraph_zero_based":134},{"literal_text_all_w_t_and_m_t":"1>if the MAC entity determines that the sidelink grant is used for initial transmission as specified in clause 5.22.1.1:","paragraph_zero_based":135},{"literal_text_all_w_t_and_m_t":"2>associate a Sidelink process to this sidelink grant;","paragraph_zero_based":136},{"literal_text_all_w_t_and_m_t":"2>set the Destination ID to the Destination layer-2 ID corresponding to the SL-PRS transmission;","paragraph_zero_based":137},{"literal_text_all_w_t_and_m_t":"2>if the length of the Source ID is configured to as 12 bit:","paragraph_zero_based":138},{"literal_text_all_w_t_and_m_t":"3>set the Source ID to the 12 LSB of the Source layer-2 ID corresponding to the SL-PRS transmission;","paragraph_zero_based":139},{"literal_text_all_w_t_and_m_t":"2>else if length of the Source ID is configured to as 24 bit:","paragraph_zero_based":140},{"literal_text_all_w_t_and_m_t":"3>set the Source ID to the Source layer-2 ID corresponding to the SL-PRS transmission;","paragraph_zero_based":141},{"literal_text_all_w_t_and_m_t":"2>set the cast type indicator to one of broadcast, groupcast and unicast as indiated by the upper layer;","paragraph_zero_based":142},{"literal_text_all_w_t_and_m_t":"2>set the SL-PRS priority as the value indicated by upper layer;","paragraph_zero_based":143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"c136d386c2ab7c411bdfab56c9560da44fc929eeaad6e4d81a109c97d0d25b9f","original_member_sha256":"65d9ccdf99e14a6f15f2b80367bbfb99fd1beb5a06d0e2fb13b1c52519336cad","paragraph_ElementTree_utf8_XML_sha256":["84cfffd8b170c458e9fd1f937758338e77952052a138c7c60120dc1e8ee9c412","f7b3a7bb9ad97a828da3323273c2deac8004729d61d7f2c7a25185dd92d4eb66","623edfeb67c2d41b2b9e147012100dce2f709456a108863b11db12637e74c692","972c89243ea25b912af8179a8be8c77ab6d50347dd064fa94fff2d9d947bbd4b","022031e640f79d734e0c0078695b4546709c7cc0e2d4b09f740c852d83464850","90739a9b5718a75a6036a95b91a37f44f1e9aef38922942dfe97f431acb1a425","6c4b79aee2df9417fdcf7ff053d8ed2a9ea25e31efedf31e6292500ff9c4b627","8a2054446422db10127b53522c244dd671006eed469081cd46119e9103434846","09696b54939497a8ca2ba620420c03c7479c8446d64fb680ae1962b6d211066f","c002616492b1923e46d6fa95a25dac7944411eca88ccdcee2199f265ed726678","d02e8cbd697ae1810074c3012247d88e70339f7889a7482c352e21eca4a8f878","5e6e78c509901ae3936d881dd0c9b12c94a02c1a5b9226ba72b61bcdd6bc46b1","7e6ee6c66018cb5440765439d7e94b96e37307f1efe9f80049012c460c70a9ce","b3142356c277674056b27c012fe749b724bcd629730b580f83ab9023bbc351f0","632c1ec853f58b59a3cded559a1bdf7fd60596b696122e7c0d155d339cc21502","d68e99effec1408625e241c16ac27076966d28079a5655b06a021d2121b0dade","eec78aee7470944e7766e75fbadaee1d9e5442cf009ace6042486b784dd3d407","65bd522832edb72743c27e81874162840d97238fecc7467fd452f4bc4100f4b7","d9cd7e3fdb36b6cde19eebe2abbf7236eb4fbb923cfb4dde861aa4cafec01621","2ffaf06c5f98a253482a85e0e7c0b2df9b3bd20821c18fb4fc898c81abbbdeac","b7268914e8bb377fa98362670091ccaf8c30e24a241dcb97beab926e0eb423d9","41e8a25d87ce47f535ddd0beb5ff6802162a4369b7f019ac0758d18cca39b10b","562d9f22df8307e8035368739a93acd19bbe977ade0c2992965c427e58a8a39c","ab5cb2cf1664f07fd8f43c4136d588dd4ad7be914fab71ea4478e39b6937ede3"],"paragraph_range_zero_based":[120,143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507533.zip::R2-2507533 Correction on processing of sidelink grant on Dedicated SL-PRS resource pool.docx:p120"}
{"fields":{"filename":"R2-2507533.zip::R2-2507533 Correction on processing of sidelink grant on Dedicated SL-PRS resource pool.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>set the SL-PRS resource ID;","paragraph_zero_based":144},{"literal_text_all_w_t_and_m_t":"NOTE 1:The SL-PRS resource ID(s) for initial transmission and retransmission(s) are determined by the UE's own upper layers by implementation.","paragraph_zero_based":145},{"literal_text_all_w_t_and_m_t":"2>if the upper layer triggers SL-PRS transmission of the peer UE identified by the Destination layer-2 ID:","paragraph_zero_based":146},{"literal_text_all_w_t_and_m_t":"3>set the SL-PRS request to request;","paragraph_zero_based":147},{"literal_text_all_w_t_and_m_t":"2>deliver the SL-PRS transmission information to the Sidelink process;","paragraph_zero_based":148},{"literal_text_all_w_t_and_m_t":"2>instruct the associated Sidelink process to trigger a new transmission as defined in 5.22.1.3.5.","paragraph_zero_based":149},{"literal_text_all_w_t_and_m_t":"1>else (i.e., retransmission):","paragraph_zero_based":150},{"literal_text_all_w_t_and_m_t":"2>identify the Sidelink process associated with this grant;","paragraph_zero_based":151},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":152},{"literal_text_all_w_t_and_m_t":"2>set the SL-PRS resource ID;","paragraph_zero_based":153},{"literal_text_all_w_t_and_m_t":"2>deliver the SL-PRS transmission information to the Sidelink process;","paragraph_zero_based":154},{"literal_text_all_w_t_and_m_t":"2>instruct the associated Sidelink process to trigger a retransmission as defined in 5.22.1.3.5.","paragraph_zero_based":155},{"literal_text_all_w_t_and_m_t":"NOTE 2:For configured sidelink grant, the Sidelink process for retransmission is identified by the SL-PRS Process ID as specified in clause 5.22.1.1.","paragraph_zero_based":156},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":157},{"literal_text_all_w_t_and_m_t":"================================== 2nd Change =================================","paragraph_zero_based":158},{"literal_text_all_w_t_and_m_t":"5.22.1.4.1.3Allocation of sidelink resources","paragraph_zero_based":159},{"literal_text_all_w_t_and_m_t":"The MAC entity shall for each sidelink grant associated with Shared SL-PRS resource pool:","paragraph_zero_based":160},{"literal_text_all_w_t_and_m_t":"1>if there is SL-PRS pending for transmission for the selected destination:","paragraph_zero_based":161},{"literal_text_all_w_t_and_m_t":"2>derive Transport Block Size for a new transmission for SL-SCH assuming SL-PRS can be transmitted in the sidelink grant according to clause 8.1.3.2 in TS 38.214 [7];","paragraph_zero_based":162},{"literal_text_all_w_t_and_m_t":"2>if all the SL-SCH data within logical channel with higher priority than that of the SL-PRS can be allocated with resources:","paragraph_zero_based":163},{"literal_text_all_w_t_and_m_t":"3>determine that the pending SL-PRS can be transmitted in the sidelink grant.","paragraph_zero_based":164},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":165},{"literal_text_all_w_t_and_m_t":"3>determine that the pending SL-PRS cannot be transmitted in the sidelink grant;","paragraph_zero_based":166},{"literal_text_all_w_t_and_m_t":"3>derive the Transport Block Size for a new transmission for SL-SCH with no SL-PRS according to clause 8.1.3.2 in TS 38.214 [7].","paragraph_zero_based":167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"c136d386c2ab7c411bdfab56c9560da44fc929eeaad6e4d81a109c97d0d25b9f","original_member_sha256":"65d9ccdf99e14a6f15f2b80367bbfb99fd1beb5a06d0e2fb13b1c52519336cad","paragraph_ElementTree_utf8_XML_sha256":["191d4311b97b0e43a92f8db97cb15618709c1979352490854ddd72781847402c","6415d1f64fe5eaee720f9acb7901315acba54257e099e51373971968f2fbefa7","fb7ef935aee32d7c7f59ed0fa1390d66981b296e421a04624248cd4568c49d88","fbb22ea1ae0b4018baa25f9a0c75bc5fa4d2cc50b0124a36d6c1036c1cefb8bb","54b94d7908699a2bdf3ae067a07241d4c8d9c94f4054f8ba766192fd16c406f2","29254585b357fda951673a495152a83bbf35e765295e2239277b7ba4d380a169","5c25613ae485381f1da551010c8bd0830a2b38356b9ec22e56749159a52d2903","c44a5c56de2a0818afbd7cf267dd895c35410b53b847ffda31dbf41b6088e048","7f47a030760f4b7446182dcd0433cef3d6f30c0fc581720e4662f18c929b578f","3c95cb57f7692409985d7f13294ee731d13a7256c635d4f28287c94a99082c66","9c303d51c8e0cb49f2f2510f8e9edec9e74f218fe1aaa14115906623e0c5ccf8","f3bb509bfb33716b293972e31a8a69fea21edcc0ff78369663a799ba495354ee","b25b34a4fb3528f1f7bb667445066d387effe66e521e7b38ce9628bc917e7f2a","c4703c8f310a04120da1753a8e8adb6d746e43d35c0c3df834259b657ba46015","0bfab0cca86ea2a96de6c081d17098d74432c171b91453de5fe16dd4f349642b","975ad9e56a69ed5ee697db288ed12548d7ec5dac9daea8b71d639cb8058625b5","7fdccd6f27ee0662cd53aae7a0ce64053812f6bc72c3c4ce251fa1a8c9f2f67c","bce768115127d70b8fd52983c1fcd70875426e73e12da188d50e484a0c2dbe8e","e7144f5f17d4cf847598b84447c149e233c98126e7f8055fe8a254ce16258c39","298834ed832832ae27d60b13cd72b141ee61df5ddbe8a94480e4c5bff82ba1ed","418dcffa4ba79ce35c5bd18f454f969608c3179db036f147a3add68b40128f09","4badd47ba1cf0f544fcc46717860f6e269725d2429bb03bec8e53ea948b6bc70","f750acf70001d229dff7319107dcc85488560d3e6014c16fb641e9c1a27b1801","288a4b2ffa9355d112db69fa35362ee91e23f96ade2efba2ae6da4c00a944c70"],"paragraph_range_zero_based":[144,167],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507533.zip::R2-2507533 Correction on processing of sidelink grant on Dedicated SL-PRS resource pool.docx:p144"}
{"fields":{"filename":"R2-2507533.zip::R2-2507533 Correction on processing of sidelink grant on Dedicated SL-PRS resource pool.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The MAC entity shall for each SCI corresponding to a new transmission for SL-SCH:","paragraph_zero_based":168},{"literal_text_all_w_t_and_m_t":"1>allocate resources to the logical channels as follows:","paragraph_zero_based":169},{"literal_text_all_w_t_and_m_t":"2>logical channels selected in clause 5.22.1.4.1.2 for the SL grant with SBj > 0 are allocated resources in a decreasing priority order. If the sPBR of a logical channel is set to infinity, the MAC entity shall allocate resources for all the data that is available for transmission on the logical channel before meeting the sPBR of the lower priority logical channel(s);","paragraph_zero_based":170},{"literal_text_all_w_t_and_m_t":"2>decrement SBj by the total size of MAC SDUs served to logical channel j above;","paragraph_zero_based":171},{"literal_text_all_w_t_and_m_t":"2>if any resources remain, all the logical channels selected in clause 5.22.1.4.1.2 are served in a strict decreasing priority order (regardless of the value of SBj) until either the data for that logical channel or the SL grant is exhausted, whichever comes first. Logical channels configured with equal priority should be served equally.","paragraph_zero_based":172},{"literal_text_all_w_t_and_m_t":"NOTE 1:The value of SBj can be negative.","paragraph_zero_based":173},{"literal_text_all_w_t_and_m_t":"The UE shall also follow the rules below during the SL scheduling procedures above:","paragraph_zero_based":174},{"literal_text_all_w_t_and_m_t":"-the UE should not segment an RLC SDU (or partially transmitted SDU or retransmitted RLC PDU) if the whole SDU (or partially transmitted SDU or retransmitted RLC PDU) fits into the remaining resources of the associated MAC entity;","paragraph_zero_based":175},{"literal_text_all_w_t_and_m_t":"-if the UE segments an RLC SDU from the logical channel, it shall maximize the size of the segment to fill the grant of the associated MAC entity as much as possible;","paragraph_zero_based":176},{"literal_text_all_w_t_and_m_t":"-the UE should maximise the transmission of data;","paragraph_zero_based":177},{"literal_text_all_w_t_and_m_t":"-if the MAC entity is given a sidelink grant size that is equal to or larger than 12 bytes while having data available and allowed (according to clause 5.22.1.4.1) for transmission, the MAC entity shall not transmit only padding;","paragraph_zero_based":178},{"literal_text_all_w_t_and_m_t":"-A logical channel configured with sl-HARQ-FeedbackEnabled set to enabled and a logical channel configured with sl-HARQ-FeedbackEnabled set to disabled cannot be multiplexed into the same MAC PDU.","paragraph_zero_based":179},{"literal_text_all_w_t_and_m_t":"The MAC entity shall not generate a MAC PDU for the HARQ entity if the following conditions are satisfied:","paragraph_zero_based":180},{"literal_text_all_w_t_and_m_t":"-there is no Sidelink CSI Reporting MAC CE generated for this PSSCH transmission as specified in clause 5.22.1.7; and","paragraph_zero_based":181},{"literal_text_all_w_t_and_m_t":"-there is no Sidelink DRX Command MAC CE generated for this PSSCH transmission as specified in clause 5.22.1.8; and","paragraph_zero_based":182},{"literal_text_all_w_t_and_m_t":"-there is no Sidelink Inter-UE Coordination Request MAC CE generated for this PSSCH transmission as specified in clause 5.22.1.9; and","paragraph_zero_based":183},{"literal_text_all_w_t_and_m_t":"-there is no Sidelink Inter-UE Coordination Information MAC CE generated for this PSSCH transmission as specified in clause 5.22.1.10; and","paragraph_zero_based":184},{"literal_text_all_w_t_and_m_t":"-the MAC PDU includes zero MAC SDUs and the MAC PDU is not associated with SL-PRS transmission on Shared SL-PRS resource pool.","paragraph_zero_based":185},{"literal_text_all_w_t_and_m_t":"Logical channels shall be prioritised in accordance with the following order (highest priority listed first):","paragraph_zero_based":186},{"literal_text_all_w_t_and_m_t":"-data from SCCH;","paragraph_zero_based":187},{"literal_text_all_w_t_and_m_t":"-Sidelink CSI Reporting MAC CE;","paragraph_zero_based":188},{"literal_text_all_w_t_and_m_t":"-Sidelink Inter-UE Coordination Request MAC CE and Sidelink Inter-UE Coordination Information MAC CE;","paragraph_zero_based":189},{"literal_text_all_w_t_and_m_t":"-Sidelink DRX Command MAC CE;","paragraph_zero_based":190},{"literal_text_all_w_t_and_m_t":"-data from any STCH or SL-PRS.","paragraph_zero_based":191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"c136d386c2ab7c411bdfab56c9560da44fc929eeaad6e4d81a109c97d0d25b9f","original_member_sha256":"65d9ccdf99e14a6f15f2b80367bbfb99fd1beb5a06d0e2fb13b1c52519336cad","paragraph_ElementTree_utf8_XML_sha256":["338170755e5860525b7b5798558113f4d12eb118fea5b927230ad044c0f4b520","ecaceb80516a1c98fc0f850c8f65104743e96484576c5955ba324f209ba9bf3f","e9cf3475d1f406f5c751525de1be17e9acdc765a101ef9b2a1a2b32748cf41c6","959b78f477a236dd38a5878f1652fc49e10a4acccaef19d11692913f34354df3","03636bb5f2a0d188ce6466b06adac649c433d35b550998919d2aa0361464ec17","f752106ce7c40414581bea49012d69ba9c66b9b960195e9a10a542153bc3d20c","fa9ba431f2c7c2cd47e47fbd09ba326b7d42cf3fb30f75e51014b1ee62534a0a","25a180218e5855594c7c87c94adce965164c3331accdf852a27314aac6fcd467","56a389bc8a1ad6a10256d0dee25d72288f859716aad5cf404d74d0c4e9581f98","a2908d73f36dd189a32d6d9f12192080c2d93e1d73607a271e43e451ee7ce6e7","5af2780d8e485c5f3637c91ea52231f0aa67ab1638d7c0a562727ec60d709c8d","d9375a7844d5211699c28499ceb24c99c281036986dec34d1b883a9d65a37754","5ca50636372cbf79b8833583f72e082aa7c2eaac902968bb4817e1951397c170","25e5e9754ec1b32ba261cca800702bc8cb529e7014b6924a9d2a83e5b0d33a9a","0323a3541e7f3cd66108ff8b56ef8f6a2af0901268fcd5b3ad7c160f549bc8b2","9417b67d628d3e5ab2297dabd7fa0856555ad896c7b1d8595363204a35d09708","950a9203420ed6dd8c57ef37908a247bf9826a16a1115cee49b19e7769af4dd8","5e0a26e7f6c015b5ab8f68e679679f8c62f4cab59dd689bfaec6f8feb88efcd7","22d2cba47e6b33ac59c88c4ec165c1e0b5d33d0e3b73536441295a835df0db05","af16e6526140298dfb079455660c21dd843d64b507a7e91ded6c878091dcace6","d2a55ffc1e40db7d2927d40408688c32cb76618444113d598d3d518bd3c0820d","ebf3c81c11637cdf546816e15699826c35eb48eef6b80fc7955b4259c6fd956c","84e5c4764dc76802cc8fc82fdafa0bd9f0cb0f4c7895129161def272bb2125ce","037c21298351b8d689f1fc55839f2a33e14d51ec395b8986b9450c4c487dc1de"],"paragraph_range_zero_based":[168,191],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507533.zip::R2-2507533 Correction on processing of sidelink grant on Dedicated SL-PRS resource pool.docx:p168"}
{"fields":{"filename":"R2-2507533.zip::R2-2507533 Correction on processing of sidelink grant on Dedicated SL-PRS resource pool.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"NOTE 2:The priority order between Sidelink Inter-UE Coordination Request MAC CE and Sidelink Inter-UE Coordination Information MAC CE is up to UE implementation.","paragraph_zero_based":192},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":193},{"literal_text_all_w_t_and_m_t":"================================== 3rd Change =================================","paragraph_zero_based":194},{"literal_text_all_w_t_and_m_t":"5.22.1.5Scheduling Request","paragraph_zero_based":195},{"literal_text_all_w_t_and_m_t":"In addition to clause 5.4.4, the Scheduling Request (SR) is also used for requesting SL-SCH resources for new transmission when triggered by the Sidelink BSR (clause 5.22.1.6) or the SL-CSI reporting (clause 5.22.1.7) or SL-DRX Command indication. The Scheduling Request (SR) is also used for requesting SL-PRS resources for new transmission when triggered by SL-PRS resource request (clause 5.22.1.12). If configured, the MAC entity performs the SR procedure as specified in this clause unless otherwise specified in clause 5.4.4. For a sidelink logical channel or for SL-CSI reporting or for SL-DRX Command indication or for Sidelink consistent LBT failure recovery or for SL-PRS Resource Request, at most one PUCCH resource for SR is configured per UL BWP.","paragraph_zero_based":196},{"literal_text_all_w_t_and_m_t":"The SR configuration of the logical channel that triggered the Sidelink BSR (clause 5.22.1.6) is also considered as corresponding SR configuration for the triggered SR (clause 5.4.4). The value of the priority of the triggered SR corresponds to the value of priority of the logical channel that triggered the SR.","paragraph_zero_based":197},{"literal_text_all_w_t_and_m_t":"Each sidelink logical channel and Sidelink consistent LBT failure recovery may be mapped to zero or one SR configuration, which is configured by RRC. If the SL-CSI reporting procedure is enabled by RRC, the SL-CSI reporting is mapped to one SR configuration for all PC5-RRC connections. The SR configuration of the SL-CSI reporting triggered according to 5.22.1.7 is considered as corresponding SR configuration for the triggered SR (clause 5.4.4). The value of the priority of the triggered SR triggered by SL-CSI reporting corresponds to the value of the priority of the Sidelink CSI Reporting MAC CE. The SR configuration of the SL-CSI reporting is considered as corresponding SR configuration for the triggered SR of SL-DRX Command indication triggered according to 5.28.3. The value of the priority of the triggered SR triggered by SL-DRX Command indication corresponds to the value of the priority of the Sidelink DRX Command MAC CE. The SR configuration of the Sidelink consistent LBT failure recovery triggered according to 5.31.2 is considered as corresponding SR configuration for the triggered SR (clause 5.4.4). The value of the priority of the triggered SR triggered by Sidelink consistent LBT failure recovery corresponds to the value of the priority of the SL LBT failure MAC CE. SL-PRS resource request may be mapped to zero or one SR configuration, which is configured by RRC. The value of the priority of the triggered SR triggered by SL-PRS resource request corresponds to the lowest value of the priority of all SL-PRS(s) indicated in the SL-PRS Resource Request MAC CE.","paragraph_zero_based":198},{"literal_text_all_w_t_and_m_t":"All pending SR(s) triggered according to the Sidelink BSR procedure (clause 5.22.1.6) prior to the MAC PDU assembly shall be cancelled and each respective sr-ProhibitTimer shall be stopped when the MAC PDU is transmitted and this PDU includes an SL-BSR MAC CE which contains buffer status up to (and including) the last event that triggered a Sidelink BSR (see clause 5.22.1.4) prior to the MAC PDU assembly.","paragraph_zero_based":199},{"literal_text_all_w_t_and_m_t":"All pending SR(s) triggered according to the Sidelink consistent LBT failure recovery (clause 5.31.2) shall be cancelled and each respective sr-ProhibitTimer shall be stopped when the MAC PDU is transmitted and this PDU includes an SL LBT failure MAC CE that indicates Sidelink consistent LBT failure or when all the triggered Sidelink consistent LBT failure(s) for an SL BWP is cancelled.","paragraph_zero_based":200},{"literal_text_all_w_t_and_m_t":"All pending SR(s) triggered according to the Sidelink BSR procedure (clause 5.22.1.6) shall be cancelled and each respective sr-ProhibitTimer shall be stopped when the SL grant(s) can accommodate all pending data available for transmission in sidelink.","paragraph_zero_based":201},{"literal_text_all_w_t_and_m_t":"If there is pending SR triggered by Sidelink consistent LBT failure recovery which has no corresponding SR configuration, MAC entity initiate a Random Access procedure (see clause 5.1) on the Serving Cell and cancel the pending SR.","paragraph_zero_based":202},{"literal_text_all_w_t_and_m_t":"The pending SR triggered according to the SL-CSI reporting for a destination shall be cancelled and each respective sr-ProhibitTimer shall be stopped when the SL grant(s) can accommodate the Sidelink CSI Reporting MAC CE when the SL-CSI reporting that has been triggered but not cancelled or when the triggered SL-CSI reporting is cancelled due to latency non-fulfilment as specified in 5.22.1.7. The pending SR triggered according to the SL-DRX Command indication for a destination shall be cancelled and each respective sr-ProhibitTimer shall be stopped when the SL grant(s) can accommodate the Sidelink DRX Command MAC CE when the SL-DRX Command indication that has been triggered but not cancelled. All pending SR(s) triggered by either Sidelink BSR or Sidelink CSI report or Sidelink DRX Command indication shall be cancelled, when RRC configures Sidelink resource allocation mode 2.","paragraph_zero_based":203},{"literal_text_all_w_t_and_m_t":"All pending SR(s) triggered according to the SL-PRS Resource Request procedure (clause 5.22.1.12) prior to the MAC PDU assembly shall be cancelled and each respective sr-ProhibitTimer shall be stopped when the MAC PDU is transmitted and this PDU includes an SL-PRS Resource Request MAC CE which contains status of the pending aperiodic SL-PRS transmission(s) up to (and including) the last event that triggered a SL-PRS Resource Request (see clause 5.22.1.12) prior to the MAC PDU assembly.","paragraph_zero_based":204},{"literal_text_all_w_t_and_m_t":"All pending SR(s) triggered according to the SL-PRS Resource Request procedure (clause 5.22.1.12) shall be cancelled and each respective sr-ProhibitTimer shall be stopped when the SL grant(s) can accommodate the all the pending aperiodic SL-PRS transmission(s).","paragraph_zero_based":205},{"literal_text_all_w_t_and_m_t":"5.22.1.6Buffer Status","paragraph_zero_based":206},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":207},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":208}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"c136d386c2ab7c411bdfab56c9560da44fc929eeaad6e4d81a109c97d0d25b9f","original_member_sha256":"65d9ccdf99e14a6f15f2b80367bbfb99fd1beb5a06d0e2fb13b1c52519336cad","paragraph_ElementTree_utf8_XML_sha256":["02a849fc512ebec39ff853c16977d9ec9efca9a43033d2736bf09a71363766a0","aff13b6d5b95f7701c6bb8dfa3554d85ee14d1e4d99268153d3fe8ba524f8fa5","fef94c1d271c3aeae3115cdf28630e0ab989210d8232b97e0a98b68d9b9dec64","b17080f4115d1def4061486b072211091d6c9dad22b4d16c397e447cb0fc2d11","4acae4bf9ae921ef205e6e24ab694e6125ae29f844d0c90d9b839edc7b68c4b9","ed0f93aed1cce1909dd7e968ae7b2e5b351869c6a49765b436952b72f91a199f","142ab32496746c412a16ca44a14131358bce927a8158eddde8730cdcd46f0854","70a97406dee1dc0