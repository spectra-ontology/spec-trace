e paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2ede92023a12ac332d9ec9faf8cb59f9cd6f2198d68014e3f210dbc1c2f34c95","original_member_sha256":"b7182257b58ed78c13e310a0e0320b7b2a32b1b09686f1a0345e4df8600b4a15","paragraph_ElementTree_utf8_XML_sha256":["109fb7db9d89a81716ea05394868a3d13c3b2e1b0383789ca22e9c3db644cac6","7ae559ec2991ca97b15292717e994fec32dd6bb2702fd82d71df5f6d3449fc80","59190e70ece9ffb806e9984eb0949613812c790031ebd2f417b07742101bcec3","5b9d3e94b2e2469a162f36c651ac6802b31fcc4b4fed4f8769f27295b66f32e3","0e47661d68410752894205dee6a9bbbad763c4fb8f938472f606caa30fd5b3b2","d7c547ef03ad61a75fbec25463ab6761b63265a837a50067b1afa5858b4d522a","046072d789da32203b2dbdc5bf6faf7ce0947321bf61b1475c3867e7f07b4f28","ad7c58beb1d9e90fb0849bcd216a0fa195ed528b17181f725cf2b49a179cb8f1","826ddaefbd35bf5941dd0ba7402603c67afa4054d718e9bc0124542ef7dca6de","f93659204248bf7212a2a073874fa6ef6bab855e1f334d94d95f69bdfcb0d978","e3049278b1321f9afaced708a03dfaf0e4fa7fe84544613d65ddd7c619143ac9","84cfffd8b170c458e9fd1f937758338e77952052a138c7c60120dc1e8ee9c412","f7b3a7bb9ad97a828da3323273c2deac8004729d61d7f2c7a25185dd92d4eb66","623edfeb67c2d41b2b9e147012100dce2f709456a108863b11db12637e74c692","972c89243ea25b912af8179a8be8c77ab6d50347dd064fa94fff2d9d947bbd4b","022031e640f79d734e0c0078695b4546709c7cc0e2d4b09f740c852d83464850","90739a9b5718a75a6036a95b91a37f44f1e9aef38922942dfe97f431acb1a425","6c4b79aee2df9417fdcf7ff053d8ed2a9ea25e31efedf31e6292500ff9c4b627","8a2054446422db10127b53522c244dd671006eed469081cd46119e9103434846","09696b54939497a8ca2ba620420c03c7479c8446d64fb680ae1962b6d211066f","c002616492b1923e46d6fa95a25dac7944411eca88ccdcee2199f265ed726678","43f33cc46603c87f9fa0fd77fbf0c93db79d5cec8b20269dfff5e48d6010932b","bcbcc805a33966bd284f29476ca1dd4d2290474278834d2b1a9b4ec14a9ff2a3","e21339595754b878822ebe6a662bf5d9f508781fbd7c168344d09847b4ab47e1"],"paragraph_range_zero_based":[96,119],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2410825.zip::R2-2410825_MACRel17.docx:p96"}
{"fields":{"filename":"R2-2410825.zip::R2-2410825_MACRel17.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"RRC configures the following parameters for the maintenance of UL time alignment:","paragraph_zero_based":120},{"literal_text_all_w_t_and_m_t":"-timeAlignmentTimer (per TAG) which controls how long the MAC entity considers the Serving Cells belonging to the associated TAG to be uplink time aligned;","paragraph_zero_based":121},{"literal_text_all_w_t_and_m_t":"-inactivePosSRS-TimeAlignmentTimer which controls how long the MAC entity considers the Positioning SRS transmission in RRC_INACTIVE in clause 5.26 to be uplink time aligned;","paragraph_zero_based":122},{"literal_text_all_w_t_and_m_t":"-cg-SDT-TimeAlignmentTimer which controls how long the MAC entity considers the uplink transmission for CG-SDT to be uplink time aligned.","paragraph_zero_based":123},{"literal_text_all_w_t_and_m_t":"The MAC entity shall:","paragraph_zero_based":124},{"literal_text_all_w_t_and_m_t":"1>when a Timing Advance Command MAC CE is received, and if an NTA (as defined in TS 38.211 [8]) has been maintained with the indicated TAG:","paragraph_zero_based":125},{"literal_text_all_w_t_and_m_t":"2>apply the Timing Advance Command for the indicated TAG;","paragraph_zero_based":126},{"literal_text_all_w_t_and_m_t":"2>if there is ongoing Positioning SRS Transmission in RRC_INACTIVE as in clause 5.26:","paragraph_zero_based":127},{"literal_text_all_w_t_and_m_t":"3>start or restart the inactivePosSRS-TimeAlignmentTimer associated with the indicated TAG.","paragraph_zero_based":128},{"literal_text_all_w_t_and_m_t":"2>if CG-SDT procedure triggered as in clause 5.27 is ongoing:","paragraph_zero_based":129},{"literal_text_all_w_t_and_m_t":"3>start or restart the cg-SDT-TimeAlignmentTimer associated with the indicated TAG.","paragraph_zero_based":130},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":131},{"literal_text_all_w_t_and_m_t":"3>start or restart the timeAlignmentTimer associated with the indicated TAG.","paragraph_zero_based":132},{"literal_text_all_w_t_and_m_t":"1>when a Timing Advance Command is received in a Random Access Response message for a Serving Cell belonging to a TAG or in a MSGB for an SpCell:","paragraph_zero_based":133},{"literal_text_all_w_t_and_m_t":"2>if the Random Access Preamble was not selected by the MAC entity among the contention-based Random Access Preamble:","paragraph_zero_based":134},{"literal_text_all_w_t_and_m_t":"3>apply the Timing Advance Command for this TAG;","paragraph_zero_based":135},{"literal_text_all_w_t_and_m_t":"3>start or restart the timeAlignmentTimer associated with this TAG.","paragraph_zero_based":136},{"literal_text_all_w_t_and_m_t":"2>else if the timeAlignmentTimer associated with this TAG is not running:","paragraph_zero_based":137},{"literal_text_all_w_t_and_m_t":"3>apply the Timing Advance Command for this TAG;","paragraph_zero_based":138},{"literal_text_all_w_t_and_m_t":"3>start the timeAlignmentTimer associated with this TAG;","paragraph_zero_based":139},{"literal_text_all_w_t_and_m_t":"3>when the Contention Resolution is considered not successful as described in clause 5.1.5; or","paragraph_zero_based":140},{"literal_text_all_w_t_and_m_t":"3>when the Contention Resolution is considered successful for SI request as described in clause 5.1.5, after transmitting HARQ feedback for MAC PDU including UE Contention Resolution Identity MAC CE:","paragraph_zero_based":141},{"literal_text_all_w_t_and_m_t":"4>stop timeAlignmentTimer associated with this TAG.","paragraph_zero_based":142},{"literal_text_all_w_t_and_m_t":"3>when the Contention Resolution is considered not successful as described in clause 5.1.5:","paragraph_zero_based":143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2ede92023a12ac332d9ec9faf8cb59f9cd6f2198d68014e3f210dbc1c2f34c95","original_member_sha256":"b7182257b58ed78c13e310a0e0320b7b2a32b1b09686f1a0345e4df8600b4a15","paragraph_ElementTree_utf8_XML_sha256":["fb7b9bb08f42571bf851d7265b0994efe5c2046ef03721f02746b990d36af0d5","9c407d4574798f073655e213a38ff463ba840985732ab3067e8444745ac70af8","54beeec5117c17286f199a40875a19d873be6b2b345ad4f7a39d091f7f272951","0d20f07fc30677f16ec0333ee9a37614d71c0b5f9513da7b353b848e83c4cd31","b2da02d5be819617e41067c52a2f463ef5de5e142cd8237137f2863e8fb25265","e3b17f1a99b7669ef0de9160af35a6a6f9cfdd1078ef668e52bfcb5eb7d84933","1fc130ff3deab65b590ea3672ec9387ab5b5a5564551505e913b5d0b1b925b78","42e3504ac56aced0e829da1196bd8c89e0d5674e6a3b5e9a217e7e61371bd2f2","5c9cdbff8b4a991db9fd40951424975b07a5533fe917bc925525ef7bf9c0c557","4ddf2f002a236d17e637ec5a5f8a126b38df82c32dd5b99c5b20b945e8b9f9a3","7bf4d545887ee83b5f12350aef1637d8d0eaf87f3c4e5284e5b75d0c83fb4d0c","df0e57bf36442116909c7ce366827c2a779f10bd55f4763912a63d60fbf1bec1","dd9a44dc1c90207ebfa6503ad19df067dede61aa44db72c4f57abf4cafa3043f","df1e55f0abc8b0030c34451e7c1b0f918817cfb0f034c6e468d146b198add6c6","de465d119b2db3f02023033b5ce6379bdb1fd931e95d4705f30ecff9b5727ac7","ffb66c3e87509a1bfb179335f08fdbbc5398a7c6b44760e244eff2dd89408e35","755799b9ba40be516d39ab722b78c9eafb19700fc304bad61551be10378cdc23","d513566d7ef9a076e6b92701550ae2a28530ce58125dbf19bc0fb86423a421fc","b99e2ed0a1db085cd2e6c6560b15e35bdee4c56df4989050388d54b39b2f0624","205185a5cf38e6b840645a8e213c9d72be6c10637460325e55644e549b450826","f28669e3cb88250da425af4a4ac5f7579ad81e101d03b6c714fd50c6e5f3502c","367661d04c24a041ddf73af796a267fc6ec4beea7085a671e16427ba299b0560","46fa1fc9b0dfe1a15b243fed0d83781d51e0da97fc22a3d184f0d6a29b38a29b","e9a7f6f5bf06c193f109f8bd1036641b988c91a1ecac7a4066cbc185d3fb5f71"],"paragraph_range_zero_based":[120,143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2410825.zip::R2-2410825_MACRel17.docx:p120"}
{"fields":{"filename":"R2-2410825.zip::R2-2410825_MACRel17.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>if CG-SDT procedure triggered as in clause 5.27 is ongoing:","paragraph_zero_based":144},{"literal_text_all_w_t_and_m_t":"5>set the NTA value to the value before applying the received Timing Advance Command as in TS 38.211 [8].","paragraph_zero_based":145},{"literal_text_all_w_t_and_m_t":"3>when the Contention Resolution is considered successful for Random Access procedure while the CG-SDT procedure is ongoing:","paragraph_zero_based":146},{"literal_text_all_w_t_and_m_t":"4>stop timeAlignmentTimer associated with this TAG;","paragraph_zero_based":147},{"literal_text_all_w_t_and_m_t":"4>start or restart the cg-SDT-TimeAlignmentTimer associated with this TAG.","paragraph_zero_based":148},{"literal_text_all_w_t_and_m_t":"3>when the Contention Resolution is considered successful for Random Access procedure while Positioning SRS transmission in RRC_INACTIVE is ongoing as in clause 5.26:","paragraph_zero_based":149},{"literal_text_all_w_t_and_m_t":"4>start or restart the inactivePosSRS-TimeAlignmentTimer associated with this TAG.","paragraph_zero_based":150},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":151},{"literal_text_all_w_t_and_m_t":"3>ignore the received Timing Advance Command.","paragraph_zero_based":152},{"literal_text_all_w_t_and_m_t":"1>when an Absolute Timing Advance Command is received in response to a MSGA transmission including C-RNTI MAC CE as specified in clause 5.1.4a:","paragraph_zero_based":153},{"literal_text_all_w_t_and_m_t":"2>apply the Timing Advance Command for PTAG;","paragraph_zero_based":154},{"literal_text_all_w_t_and_m_t":"2>if there is ongoing Positioning SRS Transmission in RRC_INACTIVE as in clause 5.26:","paragraph_zero_based":155},{"literal_text_all_w_t_and_m_t":"3>start or restart the inactivePosSRS-TimeAlignmentTimer associated with the indicated TAG.","paragraph_zero_based":156},{"literal_text_all_w_t_and_m_t":"2>if CG-SDT procedure is ongoing:","paragraph_zero_based":157},{"literal_text_all_w_t_and_m_t":"3>start or restart the cg-SDT-TimeAlignmentTimer associated with PTAG.","paragraph_zero_based":158},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":159},{"literal_text_all_w_t_and_m_t":"3>start or restart the timeAlignmentTimer associated with PTAG.","paragraph_zero_based":160},{"literal_text_all_w_t_and_m_t":"1>when the indication is received from upper layer for stopping the inactivePosSRS-TimeAlignmentTimer:","paragraph_zero_based":161},{"literal_text_all_w_t_and_m_t":"2>stop the inactivePosSRS-TimeAlignmentTimer.","paragraph_zero_based":162},{"literal_text_all_w_t_and_m_t":"1>when the indication is received from upper layer for starting the inactivePosSRS-TimeAlignmentTimer:","paragraph_zero_based":163},{"literal_text_all_w_t_and_m_t":"2>start or restart the inactivePosSRS-TimeAlignmentTimer.","paragraph_zero_based":164},{"literal_text_all_w_t_and_m_t":"1>when instruction from the upper layer has been received for starting the cg-SDT-TimeAlignmentTimer:","paragraph_zero_based":165},{"literal_text_all_w_t_and_m_t":"2>start the cg-SDT-TimeAlignmentTimer.","paragraph_zero_based":166},{"literal_text_all_w_t_and_m_t":"1>when instruction from the upper layer has been received for stopping the cg-SDT-TimeAlignmentTimer:","paragraph_zero_based":167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2ede92023a12ac332d9ec9faf8cb59f9cd6f2198d68014e3f210dbc1c2f34c95","original_member_sha256":"b7182257b58ed78c13e310a0e0320b7b2a32b1b09686f1a0345e4df8600b4a15","paragraph_ElementTree_utf8_XML_sha256":["207664cc51118f7c1ab004b5616522975de7c4a3fe5725c4b31c6c37657f7f18","64e82848969501991f45926a43165d86530cfe6928db4019437fe41c70f6e035","095700927a2e3dfc23cfb01d69926b6026af899c94c9dab