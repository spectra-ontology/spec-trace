{"fields":{"filename":"R2-2505726.zip::R2-2505726_Fast failover via pre‑configured egress candidate list for multi‑hop L2 U2N relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":216},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-L2RELAYUE-CONFIG-START","paragraph_zero_based":217},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":218},{"literal_text_all_w_t_and_m_t":"SL-L2RelayUE-Config-r17 ::=        SEQUENCE {","paragraph_zero_based":219},{"literal_text_all_w_t_and_m_t":"    sl-RemoteUE-ToAddModList-r17       SEQUENCE (SIZE (1..maxNrofRemoteUE-r17)) OF SL-RemoteUE-ToAddMod-r17    OPTIONAL,    -- Need N","paragraph_zero_based":220},{"literal_text_all_w_t_and_m_t":"    sl-RemoteUE-ToReleaseList-r17      SEQUENCE (SIZE (1..maxNrofRemoteUE-r17)) OF SL-DestinationIdentity-r16  OPTIONAL,    -- Need N","paragraph_zero_based":221},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":222},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":223},{"literal_text_all_w_t_and_m_t":"    sl-U2U-RemoteUE-ToAddModList-r18   SEQUENCE (SIZE (1..maxNrofSL-Dest-r16)) OF SL-U2U-RemoteUE-Config-r18   OPTIONAL,    -- Need N","paragraph_zero_based":224},{"literal_text_all_w_t_and_m_t":"    sl-U2U-RemoteUE-ToReleaseList-r18  SEQUENCE (SIZE (1..maxNrofSL-Dest-r16)) OF SL-DestinationIdentity-r16   OPTIONAL     -- Need N","paragraph_zero_based":225},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":226},{"literal_text_all_w_t_and_m_t":"[[","paragraph_zero_based":227},{"literal_text_all_w_t_and_m_t":"sl-FastFailoverConfig-r19          SL-FastFailoverConfig-r19OPTIONAL     -- Need N","paragraph_zero_based":228},{"literal_text_all_w_t_and_m_t":"]]","paragraph_zero_based":229},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":230},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":231},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":232},{"literal_text_all_w_t_and_m_t":"SL-RemoteUE-ToAddMod-r17 ::=       SEQUENCE {","paragraph_zero_based":233},{"literal_text_all_w_t_and_m_t":"    sl-L2IdentityRemote-r17            SL-DestinationIdentity-r16,","paragraph_zero_based":234},{"literal_text_all_w_t_and_m_t":"    sl-SRAP-ConfigRelay-r17            SL-SRAP-Config-r17                                                      OPTIONAL,    -- Need M","paragraph_zero_based":235},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":236},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":237},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":238},{"literal_text_all_w_t_and_m_t":"SL-U2U-RemoteUE-Config-r18 ::=      SEQUENCE {","paragraph_zero_based":239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"424eb093f767dd650e5338895960519d92ebea981f57d2d92b779f748b231a17","original_member_sha256":"c43941f5cb11f87748367ce8365b9a3c5ac1bf79a9c30e779a91aa0d1036aaf3","paragraph_ElementTree_utf8_XML_sha256":["6dfa1e954673a9f2d958a7ee461b5228f2354aadc2f0f033402393187d700c04","cd03f3c57c470bbecc4c6efff8bb1e1b6d1d06cd1778314fbba92025d29573c3","1480916a6c4d6077dc8d8fcd5abdb961402821d5639dd77296f6c6e7b83e66a9","886d913675686d735a2ab932db02f90b907c7c12c0f28c4b55ab3910a29a56f3","db3f0534e09dc91cb60722f118b2d8d49bdac7f4d37b067d1fb49a4b47b2176c","dc115bdf51233aa08389c7807c464f56841317a9512594b5c04ea5110fbea7d5","8f23e3f25bee0e47ea2b01b942bbc7c2bd9d51cce339dede1debdcf896349226","f315757f896b6f8277e3fb26bac01cb2aec11d88522ea334de81cb289d35371a","a2c7397315596885dc96c7e16e8adf4a4b39df7024844cd38e8330aa8a1ecd76","5ca59edc0d26e6e5842be1977b40e6bb86a0abdf5058f53f4b5bbd25feeef654","55090b248f66437ec03dbfc3a7f046601576bb0c534abecdaa079e3bc096c28a","b1860c0153d6d28c56beb87850c6cec0654f1da9e59a1091f3426bdee5ffb843","9b0a4d038ad28136196cbdc24232b3521fceca7644859d7d62a412aca0cd3582","bd66854