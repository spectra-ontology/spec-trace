tes":{"document_XML_sha256":"3bc04a55600a248d1895aede2a7b470e362bab537658b3360c340ab780e90b9b","original_member_sha256":"bc45667859fcb4c9d22b4980ef357233deb5243944ef156ddbd4d75489ba8acf","paragraph_ElementTree_utf8_XML_sha256":["719ded68a3c9108c6b8a692f59723768e7537c33b56a9b34ba115c1ecbf545ce","4a2c4aab0a20b8c2954f7a2526da85639bcb834282ebe4a4d86d901791b0d69c","82f1bf259a6a2e3b9daf4ed88231a339350013e98229673749e8a271b63c8beb","4953e630329d595d43b34b89e608aa061a24a899c9f97a0b25a6cbfb1a1ec8f4","f803f929f32c8449547c91bc7a6ea1e67ee8280bd78deaff7a36d49f8594fa75","263559c082216cc7891b3b30463b36e7386ee2bc5ad0ff2f6db994ab04be98ea","063dfc158c076af550066bcd86646ff5befb6690722a4d97748f92b2c31cdbbd","e33edb04f9cfe9bbc7e5b5091fbeb794d75b6913693dedb5ff047d373355e46a","0434ec5d0f7109d369234889e0e528aa9682acfe60e00d6977464d3f7bb4b9b8","e4023f23cdcfe5f2fe854b4731101f8784b043733dff2298999a0273c8bc3786","2a6609240a5a86c9fc010f77342cf514744d24b7ac82f1b463565f4d334f23bd","e7fb1a145c1acc82f0197ab5c4a303157abceaa333594ed6581b221dd86cf38f","d28c1856d56590808588a6ffcd0ab72707e9bd7693d46f3e105d72cdb3d5a8d1","6486b91ff40c451d6a9e3979f9bb1be279b2a2342afbd24b67e06a3fd9a974f3","5b81b74a00687cd5d5bb080a8d7b138a5f844900550e5b1b649fde3e0f69090e","6ea300a82ca2c213c795a25f57a16756a20e651bf45d9c24fcc5106fdeb7a6fb","c5b0c29ab7da41ba7b87046ffdb6ddd25b2d074f37ac32cfbe68160ab0a69029","dd4866ea3cf571c1e439c92af684c8197e55a272d8fa1c4d50c2f15b4022d0c1","d271d272d35c75316a757b07c6c754adf6796f5c266940f1233254f0d42b3965","21ea53af5e30e1a51c6a7fe6e9dd847a61d9bcf9c59f9904a4279e085aa137a3","a1bd4bddefff993240295bb936871772cba6600a79bd65662251133def81f166","d4d527ea5f0104f43ba0ade666c888a0b7bfb38bda5206ad99f667a37f345cc4","6227c4c07c3767efddaefa2b0ddb9a93be6c6acd6bed38a33ad1cbafebaf8c76","e392a80ae3827cee45f2d9e4e1f30c313f8ffea1fa4d16e43449c3249e306a14"],"paragraph_range_zero_based":[96,119],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2408475.zip::R2-2408475-Introduction of new capability for intra-band EN-DC channel spacing(38.306).docx:p96"}
{"fields":{"filename":"R2-2408475.zip::R2-2408475-Introduction of new capability for intra-band EN-DC channel spacing(38.306).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":120},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":121},{"literal_text_all_w_t_and_m_t":"START OF CHANGE","paragraph_zero_based":122},{"literal_text_all_w_t_and_m_t":"4.2.7.9MRDC-Parameters","paragraph_zero_based":123},{"literal_text_all_w_t_and_m_t":"Definitions for parameters","paragraph_zero_based":124},{"literal_text_all_w_t_and_m_t":"Per","paragraph_zero_based":125},{"literal_text_all_w_t_and_m_t":"M","paragraph_zero_based":126},{"literal_text_all_w_t_and_m_t":"FDD-TDD","paragraph_zero_based":127},{"literal_text_all_w_t_and_m_t":"DIFF","paragraph_zero_based":128},{"literal_text_all_w_t_and_m_t":"FR1-FR2","paragraph_zero_based":129},{"literal_text_all_w_t_and_m_t":"DIFF","paragraph_zero_based":130},{"literal_text_all_w_t_and_m_t":"asyncIntraBandENDC","paragraph_zero_based":131},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports asynchronous FDD-FDD intra-band (NG)EN-DC and asynchronous FDD-FDD inter-band (NG)EN-DC/NE-DC where the frequency range of the E-UTRA band is a subset of the frequency range of the NR band, with MRTD and MTTD as specified in clause 7.5 and 7.6 of TS 38.133 [5]. If asynchronous FDD-FDD intra-band (NG)EN-DC is not supported, the UE supports only synchronous FDD-FDD intra-band (NG)EN-DC. For FDD-FDD inter-band (NG)EN-DC/NE-DC combination where the frequency range of the E-UTRA band is a subset of the frequency range of the NR band, if this capability is not supported, the MRTD and MTTD requirements indicated by interBandMRDC-WithOverlapDL-Bands-r16 apply.","paragraph_zero_based":132},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":133},{"literal_text_all_w_t_and_m_t":"This capability applies to:","paragraph_zero_based":134},{"literal_text_all_w_t_and_m_t":"-Intra-band (NG)EN-DC combination without additional inter-band NR and LTE CA component;","paragraph_zero_based":135},{"literal_text_all_w_t_and_m_t":"-Intra-band (NG)EN-DC combination supporting both UL and DL intra-band (NG)EN-DC parts with additional inter-band NR/LTE CA component;","paragraph_zero_based":136},{"literal_text_all_w_t_and_m_t":"-Intra-band (NG)EN-DC combination without supporting UL in both the bands of the intra-band (NG)EN-DC UL part;","paragraph_zero_based":137},{"literal_text_all_w_t_and_m_t":"-Inter-band (NG)EN-DC/NE-DC combination, where the frequency range of the E-UTRA band is a subset of the frequency range of the NR band (as specified in Table 5.5B.4.1-1 of TS 38.101-3 [4]).","paragraph_zero_based":138},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":139},{"literal_text_all_w_t_and_m_t":"If this capability is included in an \"Intra-band (NG)EN-DC combination supporting both UL and DL intra-band (NG)EN-DC parts with additional inter-band NR/LTE CA component\" or in an \"Intra-band (NG)EN-DC combination without supporting UL in both the bands of the intra-band (NG)EN-DC UL part\", this capability applies to the intra-band (NG)EN-DC BC part.","paragraph_zero_based":140},{"literal_text_all_w_t_and_m_t":"BC","paragraph_zero_based":141},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":142},{"literal_text_all_w_t_and_m_t":"FDD only","paragraph_zero_based":143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3bc04a55600a248d1895aede2a7b470e362bab537658b3360c340ab780e90b9b","original_member_sha256":"bc45667859fcb4c9d22b4980ef357233deb5243944ef156ddbd4d75489ba8acf","paragraph_ElementTree_utf8_XML_sha256":["50480bd16cb1a5933523aace17a44f53bed5cbffa119f4cd2edb4a62b792534b","14330b616d4495cff07f8ed39e0870362c051abb8338b6ba139520969bf0e09a","31356259bead124c8d7ca9c30c7ef4c0acfb6af4ad2f65bf8719ece546bbb5b4","f69e0b97ef8c4d6e3edee3b880abdb02875a712d91785a6bbfc6c965487e4f9e","28cc6bd1fe2eb6099597f9122150cba89a00355acd025634bad1432b41ce7fbf","12c28680f7202cb2e9d2cfc85449edb5cb183c5206a653c96a0ca7d80440b911","e62a22c1925cc217125b99efb014bcaf40066ec6c12006008537c0e1c43b297c","9af843fa10847919316595438ef6f9aefb2a9b06648cde3383e594a81be34cab","8061fe52311d2657c7bfaa5f71a29469ba9399e1a1b5b81b252cae3588717558","5ea4bbc17f98cbcf73fd7028a82ea0eb7dc0bc3419abef27facfd3c835b7ba77","3d73eaf3731d974c825f9f42f12f561accb5dc8cd7b84b0baa2526b1fbe7ce3a","1d7f79898286f6192e1d1b7b4d7fe9ff243b39229cfcb6eb8e9b892de45a351a","e00e4ba6e3389c79f59b9e32369c658b867dcab67fda5559f9b1722976050a1f","049e2028f80a6f1e4afa65a68cf2c93efdc8da8825634210f807505218a2fb34","44a669eb4c184eac708a6cdddb4e9e3aa14e33046ce436bf39662fa3ce6e2357","ad4a75f8d72b83951dd520f507252c93ea4db884375496768cb3fd0ed848b07e","f3ad4c6f296ace936790ffd86c0d9d38473f98b63ed95bffb83c967d13ee9214","f6c2a7fb1d4a4901c524400ad8c79e2f1ff6c82c76bd9d00e8b10c666fbccd25","558b7182ca477ca3571ee8597e6ec84c2a381dbc111fed13c6c36db2d04f3c81","a33ab0fe22c19d21c152823a9a3f907b44cc9a22715f48aaddadbc29ce4a1f18","a83db723a5955bc977d1880388f28e85c6ddf4e153d124060e078e7148918005","ba0803d99229e3a65096d938df35a2c3953f81446c523c4149b2c9bac49614c4","7382c5570679fcd10afe86bc1c833d77eb56b614f2600e4adb2601de0836747f","54e1d734377005f4ae3f6b4cf05e81c1facc232f0eae4531e30122642cbd4919"],"paragraph_range_zero_based":[120,143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2408475.zip::R2-2408475-Introduction of new capability for intra-band EN-DC channel spacing(38.306).docx:p120"}
{"fields":{"filename":"R2-2408475.zip::R2-2408475-Introduction of new capability for intra-band EN-DC channel spacing(38.306).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"FR1 only","paragraph_zero_based":144},{"literal_text_all_w_t_and_m_t":"condPSCellAdditionENDC-r17","paragraph_zero_based":145},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports conditional PSCell addition in EN-DC. The UE supporting this feature shall also support 2 trigger events for same execution condition in conditional PSCell addition in EN-DC.","paragraph_zero_based":146},{"literal_text_all_w_t_and_m_t":"BC","paragraph_zero_based":147},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":148},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":149},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":150},{"literal_text_all_w_t_and_m_t":"dualPA-Architecture","paragraph_zero_based":151},{"literal_text_all_w_t_and_m_t":"For an intra-band band combination, this field indicates the support of dual PAs. If absent in an intra-band band combination, the UE supports single PA for all the ULs in the intra-band band combination. For other band combinations, this field is not applicable.","paragraph_zero_based":152},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":153},{"literal_text_all_w_t_and_m_t":"This capability applies to:","paragraph_zero_based":154},{"literal_text_all_w_t_and_m_t":"-Intra-band (NG)EN-DC/NE-DC combination without additional inter-band NR and LTE CA component;","paragraph_zero_based":155},{"literal_text_all_w_t_and_m_t":"-Intra-band (NG)EN-DC/NE-DC combination supporting both UL and DL intra-band (NG)EN-DC/NE-DC parts with additional inter-band NR/LTE CA component;","paragraph_zero_based":156},{"literal_text_all_w_t_and_m_t":"-Inter-band (NG)EN-DC/NE-DC combination, where the frequency range of the E-UTRA band is a subset of the frequency range of the NR band (as specified in Table 5.5B.4.1-1 of TS 38.101-3 [4]).","paragraph_zero_based":157},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":158},{"literal_text_all_w_t_and_m_t":"If this capability is included in an \"Intra-band (NG)EN-DC/NE-DC combination supporting both UL and DL intra-band (NG)EN-DC/NE-DC parts with additional inter-band NR/LTE CA component\", this capability applies to the intra-band (NG)EN-DC/NE-DC BC part.","paragraph_zero_based":159},{"literal_text_all_w_t_and_m_t":"BC","paragraph_zero_based":160},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":161},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":162},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":163},{"literal_text_all_w_t_and_m_t":"dynamicPowerSharingENDC","paragraph_zero_based":164},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports dynamic (NG)EN-DC power sharing between NR FR1 carriers and the LTE carriers. If the UE supports this capability the UE supports the dynamic power sharing behaviour as specified in clause 7 of TS 38.213 [11]. In this release of the specification, the UE supporting (NG)EN-DC shall set this field to supported.","paragraph_zero_based":165},{"literal_text_all_w_t_and_m_t":"BC","paragraph_zero_based":166},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3bc04a55600a248d1895aede2a7b470e362bab537658b3360c340ab780e90b9b","original_member_sha256":"bc45667859fcb4c9d22b4980ef357233deb5243944ef156ddbd4d75489ba8acf","paragraph_ElementTree_utf8_XML_sha256":["3ff3dbe79b9292296786b05cf64d979100afe7d9aede1627b3b77d114b94475b","d9dec1d31fa78b5256d05feec17cd4a83052e5d33b248925efe55097f703b3c8","dc70bcee4405c13b7b233bd702048bb820bb50d5fde99d6bbaaf2f9a7b8500dd","f91cf4379c72963a85f2e45a527f7080a21f4214107488d6490f2c4fac2b1c30","4ba178ddf377f626ca470d5d9043bad3a1ecac68ccfc4a62da04ea5152b2063c","591d35a6ed58bdee44cd265ec01e7871c3d3162e3ec5e75ee881b88268bc9ca5","7800a11c280b0a99978430dba3787053b8a7e57b77c32e4b3967bef2527a341b","3421a1e9fbb453ee0549a933300615acf06f0f27d8e361b2e9f6a336866c0166","e2e6ac4b5e28a87cda1a54a11e563cd871217a585c2cf31c63804e7c527fded0","88d26701c685286f426df6e1aeaf885a89a21527a62683fa769f316508745d3e","faf40de741ef2213233972d400fdf199be54f2de14dce30c4eb43d1b042e042b","f2427de112907f7e09e2f1424c38e181a6286f94d50421c3035222a392bf2e7b","13d2a6ce6fcc577014321f872ecdb894236e35ca3c1136ca5879cc44447b2384","690f4cd1bb59cb5b43e8ba15495895662ddd77b973ad182d2ed62358b2c54d07","b43ca544374f3e62958662a2e869b3cb2c3fe823eeb98109c1151ad65f96f196","419d47280274e29ab899029b28c39c92b365d884b3281719cbdc11ee2907f303","31a46c88c3cd8d94e0457a2c57b5f8481c36b40d6f1aa115e09b34af02e44aff","00b7e4b9d4ec7f74e92fc98e57925d4a3f0c38f07802b51ac9b91cb22adae2b9","e638c098fd4405818761d87f3d1cc8a35495bbc0e99b1badd138995af573a27c","928e6f8201fc19d7ba7b4660e188a7a4c1e349e15a5619b08aec4b84c4ca9994","a573e66472d0db0667114fd8a4717187feeb7045e9f4c380f3309a7f8345641e","6eab36bef4c3f9789dc8f0f7ceff0d946317d6c618111503edda51a0efe42887","40c3171b999533ba5241d3155697bfbbbbf2ea7f71f1f5f8583d0de31b3ac6d3","f0ece875e0ce72cfefd3b9c1f57b70d2c33abd758113222c5cc84592af662d01"],"paragraph_range_zero_based":[144,167],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2408475.zip::R2-2408475-Introduction of new capability for intra-band EN-DC channel spacing(38.306).docx:p144"}
{"fields":{"filename":"R2-2408475.zip::R2-2408475-Introduction of new capability for intra-band EN-DC channel spacing(38.306).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":168},{"literal_text_all_w_t_and_m_t":"FR1 only","paragraph_zero_based":169},{"literal_text_all_w_t_and_m_t":"dynamicPowerSharingNEDC","paragraph_zero_based":170},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports dynamic NE-DC power sharing between NR FR1 carriers and the LTE carriers. If the UE supports this capability, the UE supports the dynamic power sharing behavior as specified in clause 7 of TS 38.213 [11].","paragraph_zero_based":171},{"literal_text_all_w_t_and_m_t":"BC","paragraph_zero_based":172},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":173},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":174},{"literal_text_all_w_t_and_m_t":"FR1 only","paragraph_zero_based":175},{"literal_text_all_w_t_and_m_t":"higherPowerLimitMRDC-r17","paragraph_zero_based":176},{"literal_text_all_w_t_and_m_t":"Indicates whether UE supports increase in maximum output power above the power class indication for inter-band UL (NG)EN-DC band combinations as defined in clause 6.2B of TS 38.101-3 [4].","paragraph_zero_based":177},{"literal_text_all_w_t_and_m_t":"BC","paragraph_zero_based":178},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":179},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":180},{"literal_text_all_w_t_and_m_t":"FR1 only","paragraph_zero_based":181},{"literal_text_all_w_t_and_m_t":"intraBandENDC-NominalSpacing-v18xy","paragraph_zero_based":182},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports intra-band non-contiguous (NG)EN-DC with nominal channel spacing as defined in clause 5.4B.1 in the TS 38.101-3[4]. This field is only applicable for the DL and/or UL intra-band (NG)EN-DC component(s) indicating support of “non-contiguous” in intrabandENDC-Support/intrabandENDC-SupportUL/intrabandENDC-Support-DL-v1790/ intrabandENDC-Support-UL-v1790 within the band combination.","paragraph_zero_based":183},{"literal_text_all_w_t_and_m_t":"The UE indicating support of this field shall indicate support of “non-contiguous” in at least one among intrabandENDC-Support/intrabandENDC-SupportUL/intrabandENDC-Support-DL-v1790/ intrabandENDC-Support-UL-v1790.","paragraph_zero_based":184},{"literal_text_all_w_t_and_m_t":"BC","paragraph_zero_based":185},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":186},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":187},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":188},{"literal_text_all_w_t_and_m_t":"intraBandENDC-Support","paragraph_zero_based":189},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports intra-band (NG)EN-DC with only non-contiguous spectrum, or with both contiguous and non-contiguous spectrum for the (NG)EN-DC combination as specified in TS 38.101-3 [4].","paragraph_zero_based":190},{"literal_text_all_w_t_and_m_t":"If the UE does not include this field for an intra-band (NG)EN-DC combination, the UE only supports the contiguous spectrum for all the intra-band (NG)EN-DC component(s) in the inter-band (NG)EN-DC band combination.","paragraph_zero_based":191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3bc04a55600a248d1895aede2a7b470e362bab537658b3360c340ab780e90b9b","original_member_sha256":"bc45667859fcb4c9d22b4980ef357233deb5243944ef156ddbd4d75489ba8acf","paragraph_ElementTree_utf8_XML_sha256":["670e1e7e5c38b7d2b26d005c5d262f4252b318016ad610cbc2824aa1260c1966","22961d820add59ce997fc5b7dd3a102fe12aa3c44ca1b965528e48a52d34b50b","cfe616fdd5ce6903f03f3cfc2e4a153880211a9f4c1416e03f5078a4965e1948","2bd4f0779d0f6fbb332a8ab1d7ea4e3a10020c56b057bea07ff737c108a7a84b","d024c26769070e397a45817aed8cc4f6d35352d30706f00d71deaab3a50526d9","bd6f5a20aad2157ae37c5c4f2b121ce862337bc5efb6d7daac7d628ea97d3112","1035b6d3887429aea1e3a991005c7e8f492b0b180f30b4377da45c7880988263","3d4bd0007a02464d28f5de304f2e5d62ba7f4ea2ae94726212f007d5a6863f1b","98373726ce0e7a7b30b2f12daa164c0407d20b8b82a204f8c341ecdf69e733cc","d1a233945d4ad83115933896c41fe8854f1c8af8242a011afbcff3d09c611e77","377621c2aa71db2558f7761470e7d9b3232f7270ff7ba86c0afaa34ef9abd1f2","f534dd49f75e33a266a77b87a5b9433e4e5ef197055b1c041a58a0aa2fdbf3ab","4d8c2869ea2deb048a3c31a2e22a5ea7c9f6cfabeeb761cfbf810afd755a321d","2cd8c5c8b620b3e3b0fc92c744a29c3a802797ba234c9d818de90e265ed48ae0","e9639e4dd4c3295c8a191361d5b24b87d3c07aae82d1c6df3d8f8261c6ee2484","da30d44fd2d0ebb51e967a627a9a30fec5d394efa3453598d25a66aceb88a4a6","23785d64edd220c31b0ded832e464738d961e6d5ccd9c38db12333976dc1b85a","e01d7cd0e8e32375a059c25eabcf1279df2f2ae179b3e66ab6a18f5e149e3c93","922877add84dbef1386887d87d0e3931ca6258811337ba48c3d8a97f933c6164","c475f3bedcd9cbb94abe7036a327640f3cd4fb1d954bdd0113ba0c382a1660c0","3d1dddac45bd57913f051c8bb40e259d6c04491e50c553dcf837838686cda10a","27a853071562c1f0e2a6232dcf6b1ab6a069253d5cc7848c58006ff5fe580742","b1a314f4b3bf2f3c117abd3f5db4eb4131d9d0bc6e78399cd874b7f03301aeab","0ab15341896a9298ddaf221412971d80311767bf2c09eed9c7395e5345dd63a7"],"paragraph_range_zero_based":[168,191],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2408475.zip::R2-2408475-Introduction of new capability for intra-band EN-DC channel spacing(38.306).docx:p168"}
{"fields":{"filename":"R2-2408475.zip::R2-2408475-Introduction of new capability for intra-band EN-DC channel spacing(38.306).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"If intrabandENDC-Support-UL is absent and the band combination supports intra-band (NG)EN-DC only in DL, this field indicates the DL capability. If intrabandENDC-Support-UL is absent and the band combination supports intra-band (NG)EN-DC in DL and UL, this field indicates the common capability for both DL and UL. If intrabandENDC-Support-UL is included, intraBandENDC-Support indicates the DL capability.","paragraph_zero_based":192},{"literal_text_all_w_t_and_m_t":"For the inter-band (NG)EN-DC band combination with multiple intra-band (NG)EN-DC components as defined in clause 5.5B in the TS 38.101-3 [4]:","paragraph_zero_based":193},{"literal_text_all_w_t_and_m_t":"-This field is applicable only if the UE supports the same spectrum contiguity capability in DL for all the intra-band (NG)EN-DC components.","paragraph_zero_based":194},{"literal_text_all_w_t_and_m_t":"-If the UE supports different spectrum contiguity capabilities for the intra-band (NG)EN-DC components, the UE shall not include this field.","paragraph_zero_based":195},{"literal_text_all_w_t_and_m_t":"BC","paragraph_zero_based":196},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":197},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":198},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":199},{"literal_text_all_w_t_and_m_t":"intrabandENDC-Support-UL","paragraph_zero_based":200},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports intra-band (NG)EN-DC in UL with only non-contiguous spectrum, or with both contiguous and non-contiguous spectrum for the intra-band (NG)EN-DC combination as specified in TS 38.101-3 [4]. The UE includes this field only if the UE supports different UL and DL capabilities for the intra-band (NG)EN-DC band combination.","paragraph_zero_based":201},{"literal_text_all_w_t_and_m_t":"When 'both' is indicated in intrabandENDC-Support and in intraBandENDC-Support-UL, the UE supports the following three cases of intra-band (NG)EN-DC: contiguous DL/contiguous UL, non-contiguous DL/non-contiguous UL, contiguous DL/non-contiguous UL.","paragraph_zero_based":202},{"literal_text_all_w_t_and_m_t":"For the inter-band (NG)EN-DC band combination with multiple intra-band (NG)EN-DC components as defined in clause 5.5B in the TS 38.101-3 [4]:","paragraph_zero_based":203},{"literal_text_all_w_t_and_m_t":"-This field is applicable only if the UE supports the same spectrum contiguity capability in UL for all the intra-band (NG)EN-DC components.","paragraph_zero_based":204},{"literal_text_all_w_t_and_m_t":"-If the UE supports different spectrum contiguity capabilities in UL for the intra-band (NG)EN-DC components, the UE shall not include this field.","paragraph_zero_based":205},{"literal_text_all_w_t_and_m_t":"BC","paragraph_zero_based":206},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":207},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":208},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":209},{"literal_text_all_w_t_and_m_t":"intrabandENDC-Support-UL-v1790","paragraph_zero_based":210},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports intra-band (NG)EN-DC in UL with only non-contiguous spectrum, or with both contiguous and non-contiguous spectrum for the corresponding intra-band (NG)EN-DC component within the inter-band (NG)EN-DC band combination with multiple intra-band (NG)EN-DC components as defined in clause 5.5B in the TS 38.101-3 [4].","paragraph_zero_based":211},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":212},{"literal_text_all_w_t_and_m_t":"The UE includes this field only if the UE supports different UL and DL capabilities for the corresponding intra-band (NG)EN-DC component.","paragraph_zero_based":213},{"literal_text_all_w_t_and_m_t":"When 'both' is indicated in intrabandENDC-Support-v1790 and in intraBandENDC-Support-UL-v1790, the UE supports the following three cases of intra-band (NG)EN-DC: contiguous DL/contiguous UL, non-contiguous DL/non-contiguous UL, contiguous DL/non-contiguous UL for the corresponding intra-band (NG)EN-DC component.","paragraph_zero_based":214},{"literal_text_all_w_t_and_m_t":"BC","paragraph_zero_based":215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3bc04a55600a248d1895aede2a7b470e362bab537658b3360c340ab780e90b9b","original_member_sha256":"bc45667859fcb4c9d22b4980ef357233deb5243944ef156ddbd4d75489ba8acf","paragraph_ElementTree_utf8_XML_sha256":["de38ab6df629dedf3c1aeed35efb9bbcee2d1223c8c73484ed507cb88417e63b","0093b5d0ac74e75c29b988188c807a823e8a3fbc98aa18f1e1fddc53740a45f0","0b95dcde53ac255b1c24eef0aacaaa6ae8e3bfbd90160c29187f3022696bef73","1b9c5bfa638fcbd300d2794312204d21f49286eaf2ddb84cdf4e974a24ae6682","daef8ad77708ad5478ac65eaffcaeed0059c8b02ea5f314917217d5138422dc4","013599ab467ed03ab3a7ddf96f3ff163ab8a48add54ce6ce7d3383e2a1966d34","85f6a99150187d4f04e13a135cbfec20b124b28b1428e3174b3d69fcbfa28349","5ce0de05d8660b117cbbf8b5929fe3946359544ff5cec068dc6f00da924eabcb","8e3517efbf5539bc643ea2dff3e18773751d616bf4bb37856b526723c6d0a88a","3a3e1a872769c6bb6705369e301c74e4039187061f652b29f9d261ee31b2ee81","3de633417b453fb5a74e046dce96314b01d204ad04072dfc25ab04a406bde62a","0c77ad5d6d1ecb60b6a5d060affc2c281d0bb56738073b3eff0e0ac9ee017f88","65b4c3c18a58681a0fa49a1375cbf6f34b547f351f2049288de0354d256f7e22","644835d081d4b5b1ba5a01c4dba8106cb6aaecbb878f455a169e9bf565a2c479","ab362157aa8269cdf7246b58c97a389b80f69c4728918e95d50d680f5b8a12f9","1d4df3fccbd9b6f5cf9ea2a18005300e9e60dfc4f2f6496699c7d864992d08e0","15c0b557bd2103eba20de1bdb09ad514ba8ea6c24a409f98d67a478adeaf80ac","0a5d3cf8de4bf60d9e2a371e28efaca4b7ed2b16c5dee2c9e708302ffb37c7a2","982c17deff4633009542d9b6d56283056cb809a1dcf91a9ec4af3363d1b3c751","b51093757da86e1a4a53287e55c522262ddfd0e6cb0b39dddd7674b52afe3576","d3ef7280127429232df5d2f5cf4a7687e55c3a4d50009451465dc1119c062091","5d7114b80f19e180b9122b00972808a988e1055e48c8bd0d71dbab325a52a94b","7f5fbf25313c84ee3c0782358dda75ad905a634a20cc7f0f0d48fe53d8fa19a2","16e7da061f77f69db48dcd2102a9405568c3ec79173843180f3be70f763f099c"],"paragraph_range_zero_based":[192,215],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2408475.zip::R2-2408475-Introduction of new capability for intra-band EN-DC channel spacing(38.306).docx:p192"}
{"fields":{"filename":"R2-2408475.zip::R2-2408475-Introduction of new capability for intra-band EN-DC channel spacing(38.306).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":216},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":217},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":218},{"literal_text_all_w_t_and_m_t":"intrabandENDC-Support-v1790","paragraph_zero_based":219},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports only non-contiguous spectrum, or with both contiguous and non-contiguous spectrum for the corresponding intra-band (NG)EN-DC component within the inter-band (NG)EN-DC band combination with multiple intra-band (NG)EN-DC components as defined in clause 5.5B in the TS 38.101-3 [4].","paragraph_zero_based":220},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":221},{"literal_text_all_w_t_and_m_t":"If the UE does not include this field, the UE only supports the contiguous spectrum for the corresponding intra-band (NG)EN-DC component.","paragraph_zero_based":222},{"literal_text_all_w_t_and_m_t":"If intrabandENDC-Support-UL-v1790 is absent for the corresponding intra-band (NG)EN-DC component and the corresponding intra-band (NG)EN-DC component supports DL only, this field indicates the DL capability for the corresponding intra-band (NG)EN-DC component. If intrabandENDC-Support-UL-v1790 is absent for the corresponding intra-band (NG)EN-DC component and the corresponding intra-band (NG)EN-DC component supports DL and UL, this field indicates the common capability for both DL and UL for the corresponding intra-band (NG)EN-DC component. If intrabandENDC-Support-UL-v1790 is included for the corresponding intra-band (NG)EN-DC component, intraBandENDC-Support-v1790 indicates the DL capability for the corresponding intra-band (NG)EN-DC component.","paragraph_zero_based":223},{"literal_text_all_w_t_and_m_t":"BC","paragraph_zero_based":224},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":225},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":226},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":227},{"literal_text_all_w_t_and_m_t":"interBandContiguousMRDC","paragraph_zero_based":228},{"literal_text_all_w_t_and_m_t":"Indicates for an inter-band (NG)EN-DC/NE-DC combination, where the frequency range of the E-UTRA band is a subset of the frequency range of the NR band (as specified in Table 5.5B.4.1-1 of TS 38.101-3 [4]), that the UE supports intra-band contiguous (NG)EN-DC/NE-DC requirements (see TS 38.101-3 [4]). If the field is absent for such an inter-band (NG)EN-DC/NE-DC combination, the UE supports intra-band non-contiguous (NG)EN-DC/NE-DC requirements.","paragraph_zero_based":229},{"literal_text_all_w_t_and_m_t":"BC","paragraph_zero_based":230},{"literal_text_all_w_t_and_m_t":"CY","paragraph_zero_based":231},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":232},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":233},{"literal_text_all_w_t_and_m_t":"interBandMRDC-WithOverlapDL-Bands-r16","paragraph_zero_based":234},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports FDD-FDD or TDD-TDD inter-band (NG)EN-DC/NE-DC operation with overlapping or partially overlapping DL bands with an (NG)EN-DC MTTD/MRTD according to clause 7.5.2/7.6.2 in TS 38.133 [5] and NE-DC MTTD/MRTD according to clause 7.5.5/7.6.5 in TS 38.133 [5] and inter-band RF requirements. If the capability is not reported, the UE supports FDD-FDD or TDD-TDD inter-band operation with overlapping or partially overlapping DL bands with (NG)EN-DC/NE-DC MTTD/MRTD according to clause 7.5.3/7.6.3 in TS 38.133 [5] and intra-band RF requirements.","paragraph_zero_based":235},{"literal_text_all_w_t_and_m_t":"BC","paragraph_zero_based":236},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":237},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":238},{"literal_text_all_w_t_and_m_t":"FR1 only","paragraph_zero_based":239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3bc04a55600a248d1895aede2a7b470e362bab537658b3360c340ab780e90b9b","original_member_sha256":"bc45667859fcb4c9d22b4980ef357233deb5243944ef156ddbd4d75489ba8acf","paragraph_ElementTree_utf8_XML_sha256":["a854c99e90aaf4495e6d1553c6e4112c605cae98bc24eeb23b9bd40307102598","6ad173470a0e61a24dccbc3aed1c0a8e49b197fbdb9d80efd8c4eb76ce13e635","456beedc08d883898a052656792a17ba25d2d9d102401c2123a445668111276c","5f8294a34bc55084e2c7e1d07d45ed9374248f97001755a8e24f0239861f3a35","c25a1adcef27e26b12a5da3f8b6e77c26d0473e09ea29edf3947809e8d707ba7","61d017f5ac0947815e16031e782a6bf3b046ddab97d32dd1782e24d8b09ac555","0daf7bb88d532f481d593031f4c5cfba6a1312488bfa6c7be67cb1b2b5de755e","4144e3160e3ee723e280036dcf4ccc9b59e3dfe9ed96c0ae339af3c32940e382","21452f35b89dabb3bc5ef37cef2728ca97b45aa961d9da982de19645c25a763b","4d162b9046aeb1fa01b6c329dc59ba8b971ee5a6254e726efb343d6edb085ccb","2e808fdaaddc511687f0c6380c0803f33b5c6eb4608ccdd3fcafe033ccb94e7e","8167ba6065d90daf9105f3120134a13d0f6d95ca6d48179e78e5e39332065d95","8ba882d41b4df991d6b6bc624b540e746df1d8b9c350bf56a623b11217e105f8","5a24ec8e4be265075422570bb26a6e4e1005c7e0845a6ed9680faa42d7f21f9d","40c1874bf474d035f2b8ec17d6e9a23e5e9cf4bed98364064410687a35c5b695","0fe599ea0c1dbf63b6ce4eadf52592bb2b072d7aac04c773a74faebf309e563a","affc00ba01f6fb3ad9a639a4a9fa1754a3d94daf7622264253b6770d5277a072","a1e8a09a1d6e8934d67d55013e45b37168180ff33e2b2a3ba9d5017b5b4427d8","e065a2b4acbfc7a7d65923943ec776842a3b496157241ee8c6dd293deb9607bd","968e84eb057b4af16a27a53602f8feb8a4c05f8f074be19b2c89112d9fa92040","0814b11175ea579a17910e35cd3bbfa4ea9a295f8e3c155894ab8178cdc3dfd1","47149e01d346aee4057672ebe5146658907dc895d682aa5667c79952ace31c27","5c8ad42f409d127f4c9ef6b1022a9c7bff259369384f83ae47298c8c460579e9","8b91ef307232cc2e2b6c4c088de01dee3ab77f6fb393af382fc03c72fb70827f"],"paragraph_range_zero_based":[216,239],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2408475.zip::R2-2408475-Introduction of new capability for intra-band EN-DC channel spacing(38.306).docx:p216"}
{"fields":{"filename":"R2-2408475.zip::R2-2408475-Introduction of new capability for intra-band EN-DC channel spacing(38.306).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"maxUplinkDutyCycle-interBandENDC-FDD-TDD-PC2-r16","paragraph_zero_based":240},{"literal_text_all_w_t_and_m_t":"Indicates the maximum percentage of symbols during a certain evaluation period that can be scheduled for NR uplink transmission and EUTRA FDD uplink transmission so as to ensure compliance with applicable electromagnetic energy absorption requirements provided by regulatory bodies. This field is only applicable for inter-band FDD+TDD EN-DC power class 2 UE as specified in TS 38.101-3 [4]. This capability signalling comprises of maxUplinkDutyCycle-FDD-TDD-EN-DC1 and maxUplinkDutyCycle-FDD-TDD-EN-DC2 which indicate the maxUplinkDutyCycle capability of NR band corresponding to different LTE reference configurations as described in TS 38.101-3 [4], clause 6.2B.1.3. Value n30 corresponds to 30%, value n40 corresponds to 40% and so on.","paragraph_zero_based":241},{"literal_text_all_w_t_and_m_t":"BC","paragraph_zero_based":242},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":243},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":244},{"literal_text_all_w_t_and_m_t":"FR1 only","paragraph_zero_based":245},{"literal_text_all_w_t_and_m_t":"maxUplinkDutyCycle-interBandENDC-TDD-PC2-r16","paragraph_zero_based":246},{"literal_text_all_w_t_and_m_t":"Indicates the maximum percentage of symbols during a certain evaluation period that can be scheduled for NR uplink transmission under different EUTRA TDD uplink-downlink configurations so as to ensure compliance with applicable electromagnetic energy absorption requirements provided by regulatory bodies. This field is only applicable for inter-band TDD+TDD EN-DC power class 2 UE as specified in TS 38.101-3 [4]. If the field is absent, 30% shall be applied to all EUTRA TDD uplink-downlink configurations. If eutra-TDD-Configx is absent, 30% shall be applied to the corresponding EUTRA TDD uplink-downlink configuration.","paragraph_zero_based":247},{"literal_text_all_w_t_and_m_t":"Value n20 corresponds to 20%, value n40 corresponds to 40% and so on.","paragraph_zero_based":248},{"literal_text_all_w_t_and_m_t":"BC","paragraph_zero_based":249},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":250},{"literal_text_all_w_t_and_m_t":"TDD only","paragraph_zero_based":251},{"literal_text_all_w_t_and_m_t":"FR1 only","paragraph_zero_based":252},{"literal_text_all_w_t_and_m_t":"scg-ActivationDeactivationENDC-r17","paragraph_zero_based":253},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports activation (with or without RACH) and deactivation on SCG in EN-DC, upon SCG addition and upon reconfiguration of the SCG, as specified in TS 38.331 [9]. A UE supporting this feature shall indicate support of EN-DC as specified in TS 36.331 [17]. For the UE supporting this feature, it is mandatory to report maxNumberCSI-RS-BFD and maxNumberSSB-BFD for all NR bands of this band combination where the UE supports SpCell.","paragraph_zero_based":254},{"literal_text_all_w_t_and_m_t":"BC","paragraph_zero_based":255},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":256},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":257},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":258},{"literal_text_all_w_t_and_m_t":"scg-ActivationDeactivationResumeENDC-r17","paragraph_zero_based":259},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports activation (with or without RACH) and deactivation on SCG in EN-DC, upon reception of an RRCReconfiguration included in an RRCConnectionResume message, as specified in TS 38.331 [9] and TS 36.331 [17], A UE supporting this feature shall indicate support of EN-DC and support of resumeWithSCG-Config-r16 as specified in TS 36.331 [17]. For the UE supporting this feature, it is mandatory to report maxNumberCSI-RS-BFD and maxNumberSSB-BFD for all NR bands of this band combination where the UE supports SpCell.","paragraph_zero_based":260},{"literal_text_all_w_t_and_m_t":"BC","paragraph_zero_based":261},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":262},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3bc04a55600a248d1895aede2a7b470e362bab537658b3360c340ab780e90b9b","original_member_sha256":"bc45667859fcb4c9d22b4980ef357233deb5243944ef156ddbd4d75489ba8acf","paragraph_ElementTree_utf8_XML_sha256":["bb06aab944c4b560fd22522265961b2e2ff91067660564978361018e955940fb","0c3e4b2bc7d52deb45465d3abc728143cf416f07f611f58614f861f36063ddbf","a0fa3dd59a9fcbff1a1e8df294d0523107c993b555e2a44e7d18ed0ee891ab3a","43663703bb6303efdccbc6f8b1be198aa0cc18b4a722b288aaac0aaa702335e1","4509f69ad6d5a1756776502e63f2fc645604d108070b189c4f8e54758e424594","47fa5c2d1b565e6c44d9e1afda881a1161e6ce1b1d6f37b9f6b61bcf3612e27d","7b799ed9c631ce8edd967997fa7ab244f1b3bc505f6695bba70f0379505ed3ed","3fdc47171905113b8130b8ba5bcc59cf2156abf328cd1b0ce679a7d1ece529d4","b70f52dcdd24e6dec2696099dd5b0ee4b19a1801085509c1fdabf1848ba3780c","49d011566db2a84ceb6cb9a88aa19e0c2e89aec2fabb513043aeaf3e4f45aa0d","7beb1f5af255abd87ebbeff3b90844bb7c29603c9d9d5b67b69321f0936e25e9","f1b8e09b5890e4f7b6d5345bb8b830bdfa65c4af91d52df9a4a4566e5af3cd66","04ebf1c7b98cfa82c1351dba8a3b984746a72426a1b3a9bdccad94f270128d8a","3929415765412d8e9c4f445e4dacbde2157e62c9ba43f399fde159d710abe595","2df1ca08d18c02306c817fa256f6ab2db6bf5a5aefe9e083972cf1093ecac5fa","039469e14dfd88ad780aa548c45f6f203837c660be56061c6a3938fa61bf8da9","420ae9c6cbf5a3a837f0a777915befc5bf085c1ec98143175489ffd5489e202a","ce2b33dd59cf2acd258529ed3f1db843954e77bb8b5a30cb8a88abecbf0c021b","ab51fe557953905f1d67d86b1cb1e1e7366ffc65f0d94ae42a826b88af110b7a","2f8f35722f46f79229fca4a7f3222c482e3f0dc19ec08a64b3c0e063854edd23","a7ca749b3937863b80219a0d7383822ccab64ef01f7bf3d590ed682b354db6a6","73ee83d797b9d5583edb9dc0227a5b3f4d82237e7b047e2f867219ee27d4453b","0b8c79a8b00c6bf5bfe1aeb63d064d140202055d7a6e5649e0fd9840bd1023ea","6d01af3d997ba515e6aec04c0e64c97c9db8655acf9b35898aaf965b2965233a"],"paragraph_range_zero_based":[240,263],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2408475.zip::R2-2408475-Introduction of new capability for intra-band EN-DC channel spacing(38.306).docx:p240"}
{"fields":{"filename":"R2-2408475.zip::R2-2408475-Introduction of new capability for intra-band EN-DC channel spacing(38.306).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":264},{"literal_text_all_w_t_and_m_t":"simultaneousRxTxInterBandENDC","paragraph_zero_based":265},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports simultaneous transmission and reception in TDD-TDD and TDD-FDD inter-band (NG)EN-DC/NE-DC. It is mandatory for certain TDD-FDD and TDD-TDD band combinations defined in TS 38.101-3 [4].","paragraph_zero_based":266},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":267},{"literal_text_all_w_t_and_m_t":"This capability does not apply to the following components within TDD-TDD and TDD-FDD inter-band (NG)EN-DC/NE-DC combination:","paragraph_zero_based":268},{"literal_text_all_w_t_and_m_t":"-Intra-band (NG)EN-DC/NE-DC component","paragraph_zero_based":269},{"literal_text_all_w_t_and_m_t":"-Inter-band (NG)EN-DC/NE-DC component where the frequency range of the E-UTRA band is a subset of the frequency range of the NR band (as specified in Table 5.5B.4.1-1 of TS 38.101-3 [4]).","paragraph_zero_based":270},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":271},{"literal_text_all_w_t_and_m_t":"BC","paragraph_zero_based":272},{"literal_text_all_w_t_and_m_t":"CY","paragraph_zero_based":273},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":274},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":275},{"literal_text_all_w_t_and_m_t":"simultaneousRxTxInterBandENDCPerBandPair","paragraph_zero_based":276},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports simultaneous transmission and reception in TDD-TDD and TDD-FDD inter-band (NG)EN-DC/NE-DC for each band pair in the band combination.","paragraph_zero_based":277},{"literal_text_all_w_t_and_m_t":"Encoded in the same manner as simultaneousRxTxInterBandCAPerBandPair.","paragraph_zero_based":278},{"literal_text_all_w_t_and_m_t":"The UE does not include this field if the UE supports simultaneous transmission and reception for all applicable band pairs in the band combination (in which case simultaneousRxTxInterBandENDC is included) or does not support for any band pair in the band combination. It is mandatory for certain band pairs as specified in TS 38.101-3 [4]. The UE shall consistently set the bits which correspond to the same band pair.","paragraph_zero_based":279},{"literal_text_all_w_t_and_m_t":"Each bit of the capability only applies to TDD-TDD and TDD-FDD Inter-band (NG)EN-DC/NE-DC band pairs, except for the band pairs where the frequency range of the E-UTRA band is a subset of the frequency range of the NR band (as specified in Table 5.5B.4.1-1 of TS 38.101-3 [4]).","paragraph_zero_based":280},{"literal_text_all_w_t_and_m_t":"BC","paragraph_zero_based":281},{"literal_text_all_w_t_and_m_t":"CY","paragraph_zero_based":282},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":283},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":284},{"literal_text_all_w_t_and_m_t":"singleUL-HARQ-offsetTDD-PCell-r16","paragraph_zero_based":285},{"literal_text_all_w_t_and_m_t":"Indicate support of HARQ offset for single UL transmission in synchronous (NG)EN-DC with LTE TDD PCell. UE indicates support of this feature shall indicate support of tdm-restrictionTDD-endc-r16.","paragraph_zero_based":286},{"literal_text_all_w_t_and_m_t":"BC","paragraph_zero_based":287}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3bc04a55600a248d1895aede2a7b470e362bab537658b3360c340ab780e90b9b","original_member_sha256":"bc45667859fcb4c9d22b4980ef357233deb5243944ef156ddbd4d75489ba8acf","paragraph_ElementTree_utf8_XML_sha256":["6f55be373adeb17936e642869c899f45ace78d1bd1b3552d73e3406d4da18ea3","b191f3eb775f299cfdd285097b86d294af04b18de207d1f1846435e029ca2965","8d1e2a23330ee4e55d2387b85f81030d2c7d95959a1e15b18cccfa50c67715e0","76fb3e15526f1b03cf6e9eb135b004068e98fc87c1df19e8fdfef19fdd4f5da3","73637d6981ad4ef17c45d1b9208c5d2e020501da2cd13cb92b7fb3dd58e18ce2","e3cf9b10d48413fc9cbfa95d0d052184e97491da698f8a9b4aab230b251bc645","606f1da10b2c2ae9289f00a69f448b573bb82f0a87563779e5e6c2de6cb145f9","8bf01c0d230dd2fb57cd339a2d94f3cc1a1603ebb786717ed70c51eeab6a596e","b60728376e65a1037b023a66b7ba8c4de7cddd6fdc69cd2a7cb507bff8363bf1","2e2193e803d1469c111682fe5c0b18ad8b57c086f217b27b860acfe09bd07b5d","1bf280f4c8137557de113449f916333979be1c89a325a771114320c1128051ac","a8cec5ebd6730a6af2d36f887e75235a6b81caaac6e2c763ed3489f0f7f90b46","0fbdf007d06af685e54c837d924ebf537f58816f6d23b53e2990a8ebf787631c","3be6f21fec12d3942e82c4a2a6aa1b8ea81906222a78cf64502b250ce575e19f","ccc9b214a8fdf37510b2fdfd96a34bfcbe709a56c43a79a00c3943a22997aed6","a402364c4d89b4f387068d0d5a5f1f3a1ff4550401b2a313dfa8a33cade1d766","259c9a7788e4ec8515193282614312dc2de2f482f7845999f4cd7e2753ac43cb","f99ce488afa0b5dba6a99786e1861b0ddf08bd3cec331bae5b7b8fe7445f8ac3","bbe107b18a08335a50a687e504c481c4bebdef41990458f27d4e223522bf76eb","996c5f8079e525dfa205601b103376de01dd849d1cad65b647e0eff018c65847","f67262e546301fe305ec2be859147a46dbcf3722878aeccb5a540eebcd5bfa95","a8903f8cc8d5b6c6f5bc054d4637dd1a6879efa4a29e5d22c135e4e67d759031","15e09cce2843f44f883f21f192fb9bcb01a03d4156ffb1f87ab25824eb32d9da","d8578d14037bdc6b3c1235573562d6824d3b007ea8b31ec66d665812f34c43d5"],"paragraph_range_zero_based":[264,287],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2408475.zip::R2-2408475-Introduction of new capability for intra-band EN-DC channel spacing(38.306).docx:p264"}
{"fields":{"filename":"R2-2408475.zip::R2-2408475-Introduction of new capability for intra-band EN-DC channel spacing(38.306).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":288},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":289},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":290},{"literal_text_all_w_t_and_m_t":"singleUL-Transmission","paragraph_zero_based":291},{"literal_text_all_w_t_and_m_t":"Indicates that the UE does not support simultaneous UL transmissions as defined in TS 38.101-3 [4]. The UE may only include this field for certain band combinations defined in TS 38.101-3 [4]. If included for a particular band combination, the field applies to all fallback band combinations of this band combination that are defined in TS 38.101-3 [4] as being allowed to include this field and does not apply to any other fallback band combinations defined in TS 38.101-3 [4].","paragraph_zero_based":292},{"literal_text_all_w_t_and_m_t":"The UE shall include this field for band combinations containing a band pair for which single UL transmission is the only specified operation mode in TS 38.101-3 [4] and if the UE supports UL on both bands. Otherwise, this feature is optional.","paragraph_zero_based":293},{"literal_text_all_w_t_and_m_t":"BC","paragraph_zero_based":294},{"literal_text_all_w_t_and_m_t":"FD","paragraph_zero_based":295},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":296},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":297},{"literal_text_all_w_t_and_m_t":"spCellPlacement","paragraph_zero_based":298},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports a SpCell on FR1-FDD, FR1-TDD and/or FR2-TDD depending on which additional SCells of other frequency range(s) / duplex mode(s) are configured. It is applicable to SCG of (NG)EN-DC and MCG of NE-DC, where UL is configured on more than one of FR1-FDD, FR1-TDD and FR2-TDD in a cell group. If not included, the UE supports SpCell on any serving cell with UL in supported band combinations.","paragraph_zero_based":299},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":300},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":301},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":302},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":303},{"literal_text_all_w_t_and_m_t":"tdm-Pattern","paragraph_zero_based":304},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports the tdm-PatternConfig for single UL-transmission associated functionality, as specified in TS 36.331 [17]. Support is conditionally mandatory in (NG)EN-DC for UEs that do not support dynamicPowerSharingENDC and for UEs that indicate single UL transmission for any (NG)EN-DC BC. Support is conditionally mandatory in NE-DC for UEs that do not support dynamicPowerSharingNEDC and for UEs that indicate single UL transmission for any NE-DC BC. The feature is optional otherwise.","paragraph_zero_based":305},{"literal_text_all_w_t_and_m_t":"BC","paragraph_zero_based":306},{"literal_text_all_w_t_and_m_t":"CY","paragraph_zero_based":307},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":308},{"literal_text_all_w_t_and_m_t":"FR1 only","paragraph_zero_based":309},{"literal_text_all_w_t_and_m_t":"tdm-restrictionDualTX-FDD-endc-r16","paragraph_zero_based":310},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports TDM restriction to LTE FDD PCell in (NG)EN-DC for dual UL transmission operation when tdm-PatternConfig2-R16 is configured, as specified in TS 36.331 [17]. UE indicates support this feature shall also indicate support of tdm-Pattern.","paragraph_zero_based":311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3bc04a55600a248d1895aede2a7b470e362bab537658b3360c340ab780e90b9b","original_member_sha256":"bc45667859fcb4c9d22b4980ef357233deb5243944ef156ddbd4d75489ba8acf","paragraph_ElementTree_utf8_XML_sha256":["919c9aac366d127c2138beb064fd413aef1d8c769dcfb480518537127a64c80f","2f77d04d4b1df7760901a48b0cb798067b6fdd5f658d13fb019a46dc91a710b0","996d682b530a396a5a9f060717906fcbf830ba81f4d4d4275c9f15ddb4a9fd07","3a1edd5d39d3ebc6b3c7f68013a56b9dc1ceb317c37df0bba14f1e4bd29f1c85","0ccaffaf7b5345453a76ceeb250ffccb99419e8b808663ddcdedd681d5257be8","6092e29ff2aea7920ebf27604719594f03d6222484f606da5390b2e53cd5d5c7","8e7238a3af3dd33470309a31c67417bbf1ef0d211f95a9c55decb736b3ed98e1","8c6df88ff1d08df96e86e2870f760682ff11f50b8318e70cb06f327f7e625698","cd4abc0ab6f6b0395f193d09eb2bf569de24310a07878069b9a4653fba90f456","6105c7df0cdda569ccdfd58c32cf9b476a12e57ea7c927cb51fac0fa1c4abc54","c825727bfffe89cb16163363fb93ee52c6419bc8063b2daae95aa3ac673de1e0","09dea98d1cb24273194f446f949e0e10dc65a390fe7f97bb557f147e90b630cd","0566ae08b93d518da0f112ce0059234dbf181e6459b6d32eec2ec6d7bb47a4d7","4482bea804d3f788c8f5e91006fc35b2e46e278e8c5aff2aa6a70eee3587fa77","79d489e1ef8d9aa65438a21141776218e8570dc1269c9350d94cfaf467265519","116ef5b5854e21ab56901bf5a8f54524dedfcf98c17e3dba49ca094fbe1ca9da","5e203cb20d45b092369066f6bc4764d338e8c06c9f4374ffddb188c81872d66d","560a1748ff6be6125b121bc7a8b9e9b1ab21003f514c98b12efe60e5ebfcd3ac","e7deb8622e941ba903aa758382639a293e137e55512b90c7d9cee4b2262d0724","3ddef78c59516d1741472ff177f7b14a8ac7e58b1e9303fa351e34f3d1f8b7ae","4f8c9d471ef27ab64020dd9e3a4e0aa632aa8bd748e1581390a3929566f88792","894fbc72ec84e64eceb3426daca491fea5756b04599c61208cb341afc09fb139","c79c201cbdda53d7d9026e34b7ecd2a5439f021a55abb86a103a2d2a0a4324f5","59cbecaef01df6acb2f7ab58e5b8e2be4f9cabae96146b5ad3a5d15a8d23b194"],"paragraph_range_zero_based":[288,311],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2408475.zip::R2-2408475-Introduction of new capability for intra-band EN-DC channel spacing(38.306).docx:p288"}
{"fields":{"filename":"R2-2408475.zip::R2-2408475-Introduction of new capability for intra-band EN-DC channel spacing(38.306).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"BC","paragraph_zero_based":312},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":313},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":314},{"literal_text_all_w_t_and_m_t":"FR1 only","paragraph_zero_based":315},{"literal_text_all_w_t_and_m_t":"tdm-restrictionFDD-endc-r16","paragraph_zero_based":316},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports TDM restriction to LTE FDD PCell for single UL-transmission associated functionality when tdm-PatternConfig2-R16 is configured, as specified in TS 36.331 [17]. This is applicable for FDD (NG)EN-DC. UE indicates support this feature shall also indicate support of tdm-Pattern.","paragraph_zero_based":317},{"literal_text_all_w_t_and_m_t":"BC","paragraph_zero_based":318},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":319},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":320},{"literal_text_all_w_t_and_m_t":"FR1 only","paragraph_zero_based":321},{"literal_text_all_w_t_and_m_t":"tdm-restrictionTDD-endc-r16","paragraph_zero_based":322},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports TDM restriction to LTE TDD PCell for single UL-transmission associated functionality when tdm-PatternConfig2-R16 is configured, as specified in TS 36.331 [17]. This is applicable for synchronous TDD-TDD (NG)EN-DC.","paragraph_zero_based":323},{"literal_text_all_w_t_and_m_t":"BC","paragraph_zero_based":324},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":325},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":326},{"literal_text_all_w_t_and_m_t":"FR1 only","paragraph_zero_based":327},{"literal_text_all_w_t_and_m_t":"ul-SharingEUTRA-NR","paragraph_zero_based":328},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports (NG)EN-DC/NE-DC with EUTRA-NR coexistence in UL sharing via TDM only, FDM only, or both TDM and FDM from UE perspective as specified in TS 38.101-3 [4].","paragraph_zero_based":329},{"literal_text_all_w_t_and_m_t":"BC","paragraph_zero_based":330},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":331},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":332},{"literal_text_all_w_t_and_m_t":"FR1 only","paragraph_zero_based":333},{"literal_text_all_w_t_and_m_t":"ul-SwitchingTimeEUTRA-NR","paragraph_zero_based":334},{"literal_text_all_w_t_and_m_t":"Indicates support of switching type between LTE UL and NR UL for (NG)EN-DC/NE-DC with LTE-NR coexistence in UL sharing from UE perspective as defined in clause 6.3B of TS 38.101-3 [4]. It is mandatory to report switching time type 1 or type 2 if UE reports ul-SharingEUTRA-NR is tdm or both.","paragraph_zero_based":335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3bc04a55600a248d1895aede2a7b470e362bab537658b3360c340ab780e90b9b","original_member_sha256":"bc45667859fcb4c9d22b4980ef357233deb5243944ef156ddbd4d75489ba8acf","paragraph_ElementTree_utf8_XML_sha256":["7e2d5fc46c384ce0257e09fe5cb772c5b93fe423f0c11fe089de452f74869f25","7fb200cdcbca46f5b323a9cc62e1d7a050ff1a25c5e22ae0fc86743e7665af36","afcedf5c5fc5bcb485b0d2916dfd4e1c5602969b357a150db276eb656eaa0557","629956c6592fbd1cf43d9e00d8911b41c5e343235e7c5f73559dfcd48e035c72","73687a56cb46fe3da70ff65244f34352e4a2032a8db7bc7d72b11ee58b56dbec","e79d8dc0c9f24480d7539c56cd53647e17882bbb4081aaac8349c90011a1e802","ea7b3c4e824508488fa349cadeeb03ab3ecc2161eb5bc9ca6a5bc421b43058d1","b55fb304c929cfdc2852635c56e189f7dbe6e0876f5bb5e8f16a63a7452ace1f","5456cbc1fdc48d46423dd4d215c9b64602e0280b4930f8b0fa2bc3935f83bc89","835b91acddf6b8cb4d2e2539af1abbcf33dc1f5d243072826df76900d99c3815","d3060ba2320b130f38bb846dfaa907f0b80f2c19f9e230a5979cfff4dc9ca43e","00501f078a8b8ae8f58960b5e8419c468a2f522868107cd05910e295aed505d7","d5a63c4ece728f71411d7f06cb3729c8306a8e997e4804b8120ce627596da7b5","edcc2e450034b5f14421ab4a87e043b8dc9c1daef64f17f0d54704ea96c2de9c","5203d713ec3eca40141e71e0591c5e6ab1b19b12582c72efbba996cf80e7b059","cda069108b3afb1bdb89ae1e213361e16b98a93dc9ad85342f57d6b5491c9288","759643cd002129c87e45b7653aceeb8b476cf5b793eea97520f5e002946ce1f5","977bc157c6a97812ad550a078ad3c18c7d3b94a0efec72c70b974166405046d0","ed5ba1336d0f11d62cd51d081a93ef51b9481c11a036ae51e2a3772b359e2bb0","e84029d9936db94d7c0a4a82dfb648c601834288c142b1ee13507f5fb5964c0a","f75567bf749c862a88c78dadb1ed64d3366aacb53ab0b747608a95b04bdf1f08","188c47a21340d92a184001eecff19af667ee902de6b30f6b902ba9c08ee7b081","c753ca4994a252ada95a7b9854229eb353e0e198474bd7631e497cea74375d60","d825e93b7896f771e6ed6215cb38093f0ebda4e2499cc1929598765d573485a6"],"paragraph_range_zero_based":[312,335],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2408475.zip::R2-2408475-Introduction of new capability for intra-band EN-DC channel spacing(38.306).docx:p312"}
{"fields":{"filename":"R2-2408475.zip::R2-2408475-Introduction of new capability for intra-band EN-DC channel spacing(38.306).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"BC","paragraph_zero_based":336},{"literal_text_all_w_t_and_m_t":"CY","paragraph_zero_based":337},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":338},{"literal_text_all_w_t_and_m_t":"FR1 only","paragraph_zero_based":339},{"literal_text_all_w_t_and_m_t":"ul-TimingAlignmentEUTRA-NR","paragraph_zero_based":340},{"literal_text_all_w_t_and_m_t":"Indicates whether to apply the same UL timing between NR and LTE for dynamic power sharing capable UE operating in a synchronous intra-band contiguous (NG)EN-DC. If this field is absent, UE shall be capable of handling a timing difference up to applicable MTTD requirements when operating in a synchronous intra-band contiguous (NG)EN-DC network, as specified in TS 38.133 [5].","paragraph_zero_based":341},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":342},{"literal_text_all_w_t_and_m_t":"This capability applies to:","paragraph_zero_based":343},{"literal_text_all_w_t_and_m_t":"-Intra-band contiguous (NG)EN-DC combination without additional inter-band NR and LTE CA component;","paragraph_zero_based":344},{"literal_text_all_w_t_and_m_t":"-Intra-band contiguous (NG)EN-DC combination supporting both UL and DL intra-band (NG)EN-DC parts with additional inter-band NR/LTE CA component;","paragraph_zero_based":345},{"literal_text_all_w_t_and_m_t":"-Inter-band (NG)EN-DC combination, where the frequency range of the E-UTRA band is a subset of the frequency range of the NR band (as specified in Table 5.5B.4.1-1 of TS 38.101-3 [4]).","paragraph_zero_based":346},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":347},{"literal_text_all_w_t_and_m_t":"If this capability is included in an \"Intra-band contiguous (NG)EN-DC combination supporting both UL and DL intra-band (NG)EN-DC parts with additional inter-band NR/LTE CA component\", this capability applies to the intra-band (NG)EN-DC BC part.","paragraph_zero_based":348},{"literal_text_all_w_t_and_m_t":"BC","paragraph_zero_based":349},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":350},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":351},{"literal_text_all_w_t_and_m_t":"N/A","paragraph_zero_based":352},{"literal_text_all_w_t_and_m_t":"END OF CHANGE","paragraph_zero_based":353}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3bc04a55600a248d1895aede2a7b470e362bab537658b3360c340ab780e90b9b","original_member_sha256":"bc45667859fcb4c9d22b4980ef357233deb5243944ef156ddbd4d75489ba8acf","paragraph_ElementTree_utf8_XML_sha256":["dcf3fdc84a7c49ef4cfb3f999d47fa15aa3116984415137ba6957817cf4fed45","c814189983281c77dfcf03729ae6bf671688cb1804c3ed0d9a8fadc6778bb497","2fca0604278fa98a8a1b969ffef074ec1e8e28391e045bc740fd2cf061774f5c","a93a66589c866d5bb361352620433f49812079e586457688f2304f9b9198a95c","c6a97a502de252feb7f9efb8ba9e7bdae29e519671085c16c4faa7e35b1ded20","3575bf9374b50af967a6606ad811111e9be6c442152999a070b206635fda959e","6f9a0ccbfeb34f1e2e9e6e09d86a6efe88f3eea81edfac8264121477aa9d6c56","a32660baf491cf25d92d3a8bbb69bf36aad66593fbcce0f892de41f56f24c0a2","255326521a43f423991d817b7b2ef90a51a7ec20e6aa02383e85a58ed8e2501e","a44140b08b41730f63c3af83b1a0738174ac74163b3369569300794391e60dcf","3bfd3148ecbcf101630d205738b8422a4ebcf2f0beaa3d753c163551c3a9a55b","c2905fb73455084cb5be136f8dcf07b1c7d1d029c64c3e91741de308876bb78f","eab795978e6dd95fefe14d1faa30a6fb1b1fe569fc16f9b725195eddc5da353d","ece414544c9988a1f0235e5b68d6914148ec780eae246be8fd2243762c1db8ba","e3a4066e81d105c038d6fb96be077e736e42b011c2cf06d68a3c1092fb34e0b8","f1a164242f240b598afdd77dfbbdaaf8d49aa7dfd83449db87b90cff0fc2d481","d830d98ffb263ca30598b33ac6e0232dae2f3b6140171cc137005331d17bd7ed","15880499