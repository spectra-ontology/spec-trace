ource_cell_coordinates":{"document_XML_sha256":"aff77448aa0c29346e92838a8068d532bf7fc7cee6b626a0d28c35eb56bc62eb","original_member_sha256":"8fb21086219d6c05d0b1987abc685c28d97deafa9e4dc7a0bcec470d129ecf7a","paragraph_ElementTree_utf8_XML_sha256":["a96c4640851af5bbd6281f0d3ba9efb878db72b4919db4850ad8e0aa1807b2ab","22b6b38f70509da89a6131c81275d018c47c0f3df81d4c87109e581944a49508","e0029757b0df30a9ff4b59db39a4dcd63ed92c69f8324bb0e6ee3059dc558bda","31da7ee9d091e4cc1556d82592934dbdbeca30ca71b9fa57f86890775b064409","3d936acdd85c9430c2fb0868c48acabcc062e6c3a7a66eba3680d41f35327ba4","175ce7140326d589147ca747402e21f736f6bdaac5bfdac81568ab5ce9b20a86","b412b1aff6b131796af3f8c5bdf97c02069c93dcc3fb389b8a69dbd6414fdec2","4a477af1095e428726fe032d7b52c51a61d0ad7cfd1558d267ffefb1a56bb940","b2a4595a5368def885f107839cae611dead4fe2b279c0532d87f24ef1565cd9d","41bd5898b3438298576106ec31cbbd879a4b1ec63d8558fa24aea51ca589a953","c0c9c9b7b981f27be621a84d57353101c0127f4bf1faa421facebdafd59333ae","13eda996ec431cb50a56bc6bd39f7cf104ba205f9c8ea4a92f89f99b322dac20","5830fa0de458b914acb63023df374335e1defaf4b0c39f0d4c163453d03de819","9acaf27769541616711a4da33f9366f81cd2e1c0cf4d70dbd67cebb064a057d5","6b15c7900849304c0a66ac9595d01891a2475da1d318af9551ca0129f090905e","73fd7fdb2e9950ad2dfebd923cf99eb60f22b5d0898e9ad1dde87e65b620ea22","cb0196eb3eb666baa9e4639ec4531fb71878331aa5927580b5e40b02823cc153","a5b22b0f1b2050a7bfd29ee23470cbabacc7b886880d4fb2796765340438ce9d","279bbb7a4f70c4d8de5ea39afd00437aaf3b721d611e184941e94b633b14c535","92ddfa87eef0e3f192229f8cce55dff820680cd9e8a8ece6fb9e19b3170143c1","43f6d25cd63145c6e68659e90452204be33042df27b23509321e28f49f84bd2b","7a8fc72e3d1e9491e4150a75c3827533971bd2d4405fc5ca1e52d1a23fe96f64","23c01640459bc47b73775327bf84b571aef5a0b0148057b1726e9adb9946c435","b50c54e97cf06e91342d620e333c83631cece47f4a536e4fece2230e271dad2d"],"paragraph_range_zero_based":[96,119],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2502080.zip::R2-2502080 Correction on SRS hopping in positioning.docx:p96"}
{"fields":{"filename":"R2-2502080.zip::R2-2502080 Correction on SRS hopping in positioning.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":120},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":121},{"literal_text_all_w_t_and_m_t":"Other comments:","paragraph_zero_based":122},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":123},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":124},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":125},{"literal_text_all_w_t_and_m_t":"This CR's revision history:","paragraph_zero_based":126},{"literal_text_all_w_t_and_m_t":"This CR is a revision of the postponed CR R2-2501428, with coversheet modification","paragraph_zero_based":127},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":128},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":129},{"literal_text_all_w_t_and_m_t":"START OF CHANGE","paragraph_zero_based":130},{"literal_text_all_w_t_and_m_t":"3Definitions, symbols and abbreviations","paragraph_zero_based":131},{"literal_text_all_w_t_and_m_t":"3.1Definitions","paragraph_zero_based":132},{"literal_text_all_w_t_and_m_t":"For the purposes of the present document, the terms and definitions given in TR 21.905 [1] and the following apply. A term defined in the present document takes precedence over the definition of the same term, if any, in TR 21.905 [1].","paragraph_zero_based":133},{"literal_text_all_w_t_and_m_t":"A2X communication: A communication to support A2X services leveraging PC5 reference points, as defined in TS 23.256 [31]. A2X services are realized by various types of A2X applications, e.g., BRID or DAA.","paragraph_zero_based":134},{"literal_text_all_w_t_and_m_t":"Air to Ground network: An NG-RAN consisting of ground-based gNBs, which provide cell towers that send signals up to an aircraft's antenna(s) of onboard ATG terminal, with typical vertical altitude of around 10,000 m and take-off/landing altitudes down to 3000 m.","paragraph_zero_based":135},{"literal_text_all_w_t_and_m_t":"BWP for SRS for positioning Tx frequency hopping: For SRS for positioning Tx frequency hopping, separate BWP configuration outside BWP configuration for data transmission.","paragraph_zero_based":136},{"literal_text_all_w_t_and_m_t":"Dedicated SL-PRS resource pool: A sidelink resource pool which can be used for the transmission of SL-PRS and cannot be used for the transmission of PSSCH.","paragraph_zero_based":137},{"literal_text_all_w_t_and_m_t":"Dormant BWP: The dormant BWP is one of downlink BWPs configured by the network via dedicated RRC signaling. In the dormant BWP, the UE stop monitoring PDCCH on/for the SCell, but continues performing CSI measurements, Automatic Gain Control (AGC) and beam management, if configured.","paragraph_zero_based":138},{"literal_text_all_w_t_and_m_t":"DRX group: A group of Serving Cells that is configured by RRC and that have the same DRX Active Time.","paragraph_zero_based":139},{"literal_text_all_w_t_and_m_t":"eRedCap UE: A UE with enhanced reduced capabilities as specified in clause 4.2.22.1 of TS 38.306 [25].","paragraph_zero_based":140},{"literal_text_all_w_t_and_m_t":"HARQ information: HARQ information for DL-SCH, for UL-SCH, or for SL-SCH transmissions consists of New Data Indicator (NDI), Transport Block Size (TBS), Redundancy Version (RV), and HARQ process ID.","paragraph_zero_based":141},{"literal_text_all_w_t_and_m_t":"IAB-donor: gNB that provides network access to UEs via a network of backhaul and access links.","paragraph_zero_based":142},{"literal_text_all_w_t_and_m_t":"IAB-node: RAN node that supports NR access links to UEs and NR backhaul links to parent nodes and child nodes.","paragraph_zero_based":143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"aff77448aa0c29346e92838a8068d532bf7fc7cee6b626a0d28c35eb56bc62eb","original_member_sha256":"8fb21086219d6c05d0b1987abc685c28d97deafa9e4dc7a0bcec470d129ecf7a","paragraph_ElementTree_utf8_XML_sha256":["a19a1e9d566d4dd61cc47d719f95b8d73c4917bd30a40392fe889d1ee4658b93","ee60f554460c5c497ca1f90444c02bfe4bba4aa60c43510c36ecddffe64bf89c","f2dc16444835159fcbe3cc934175caeb41c433ede2ebc284de3bb1984da9b984","49f243e471b6b1b68676eddef7b23f0a92aa2f15dd827bb37aea889a44a405fd","5996d0332264b9f3750f43ba3ed96944129c979bab4921eaf543e869f5e81bf3","66e764437c7b4a87be95f3e9e51c7a6d1e45d1f4a54f7d831ddd6785d2e05923","4329b243d31732e328b0129f80dd41b419b852ce48338737a355144da55e2e09","37fdd6627e3a9d3b9d9dba6a51794d4e9087f6e77a695f335faf38506d0e788b","cb6af2d555f62304d58814ed03a982d6bff0c3e34107bf97414b422a7ca729ac","f5360d9b5122ac05e6fffb4f2a8c7fc3f0f666d7d854d23d25a7181b3064b877","be6346558b090fa37cf0bac75bd1062832032a42841d4bbc9195509c49b244c3","151fc739f415afda50ca4480a168b21d464fd62776ed8b5e65e13247f9ac13c4","85e42e24592263ddc2f311ff3043146f3f01ca74a25f51cd85b2ac5925157cc4","e6f5c4e90a07a348e4a7862ebb93566639191efe7fd6d2123e9a928c7cfda3de","bea2570aad983c8fa82305e503b38d9c456e08e099a76da0ea70b959a66a0b20","5e91d25bbdee062a81e09618eeee8f5e31b3046b1f54cbcda8435e308b5927da","d3845ac6122d6bcdbbd60b264da85cf95caac2e19810a57a8f6b91ef4c221e0c","f214d5c9b468aa04adf6cc6d1f6ecad1c20d9edf1d4711dbf1e5f7ada376037e","6f5063fce941f54999cd7a19c12eb046502a552524db3067bf5c9a85db379558","0e60d1c63950dd1c21b9ef9264eb73719bed8ceec5d6a3f38116125613648cc4","7587b80f611714eb8188bb29c9d7b0b07fd9fd96852801b993a322e290305a0d","b31a5c8241f31a4ccf7636c72b1969de58c3fcf358b4d6d13a80856ff92a1446","571b7f100b4f1b1e1ba72ec4cfb9eabbf6648cfb55c6d9938d50e7bcc3b9bcaf","f63fb4ab7d4c7273a27339a7093d3a7d41449badb2bafcc9756c433179b090c0"],"paragraph_range_zero_based":[120,143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2502080.zip::R2-2502080 Correction on SRS hopping in positioning.docx:p120"}
{"fields":{"filename":"R2-2502080.zip::R2-2502080 Correction on SRS hopping in positioning.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Listen Before Talk: A procedure according to which transmissions are not performed if the channel is identified as being occupied, see TS 37.213 [18].","paragraph_zero_based":144},{"literal_text_all_w_t_and_m_t":"LTM candidate cell: A candidate cell configured for LTM as defined in TS 38.331 [5].","paragraph_zero_based":145},{"literal_text_all_w_t_and_m_t":"Msg3: Message transmitted on UL-SCH containing a C-RNTI MAC CE or CCCH SDU, submitted from upper layer and associated with the UE Contention Resolution Identity, as part of a Random Access procedure.","paragraph_zero_based":146},{"literal_text_all_w_t_and_m_t":"Multi-path: Mode of operation of a UE in RRC_CONNECTED configured with one direct path on which the UE connects to gNB using NR Uu, and one indirect path on which the UE connects to the same gNB via another UE using PC5 unicast link or non-3GPP connection (N3C).","paragraph_zero_based":147},{"literal_text_all_w_t_and_m_t":"Multi-PUSCH configured grant: A configured grant configuration configured with nrOfSlotsInCG-Period (see TS 38.331 [5]). It includes multiple consecutive configured uplink grants within a single periodicity.","paragraph_zero_based":148},{"literal_text_all_w_t_and_m_t":"N3C indirect path: In Multi-path, the indirect path using Non-3GPP Connection between remote UE and relay UE.","paragraph_zero_based":149},{"literal_text_all_w_t_and_m_t":"NCR-Fwd: NCR-node function, which performs amplifying-and-forwarding of UL/DL RF signals between gNB and UE. The behavior of the NCR-Fwd is controlled according to the side control information received by the NCR-MT from a gNB.","paragraph_zero_based":150},{"literal_text_all_w_t_and_m_t":"NCR-MT: NCR-node entity which communicates with a gNB via a control link to receive side control information. The control link is based on NR Uu interface.","paragraph_zero_based":151},{"literal_text_all_w_t_and_m_t":"NCR-node: RAN node comprising NCR-MT and NCR-Fwd.","paragraph_zero_based":152},{"literal_text_all_w_t_and_m_t":"Non-terrestrial network: An NG-RAN consisting of gNBs, which provide non-terrestrial NR access to UEs by means of an NTN payload embarked on an airborne or space-borne NTN vehicle and an NTN Gateway.","paragraph_zero_based":153},{"literal_text_all_w_t_and_m_t":"NR backhaul link: NR link used for backhauling between an IAB-node and an IAB-donor, and between IAB-nodes in case of a multi-hop backhauling.","paragraph_zero_based":154},{"literal_text_all_w_t_and_m_t":"NR sidelink communication: AS functionality enabling at least V2X Communication as defined in TS 23.287 [19] and ProSe communication (including ProSe non-Relay, UE-to-Network Relay and UE-to-UE Relay communication (including ProSe UE-to-UE Relay communication with integrated discovery)) as defined in TS 23.304 [26], between two or more nearby UEs, using NR technology but not traversing any network node.","paragraph_zero_based":155},{"literal_text_all_w_t_and_m_t":"NR sidelink discovery: AS functionality enabling ProSe non-Relay discovery, ProSe UE-to-Network Relay discovery and ProSe UE-to-UE Relay discovery for Proximity based Services as defined in TS 23.304 [26], between two or more nearby UEs, using NR technology but not traversing any network node.","paragraph_zero_based":156},{"literal_text_all_w_t_and_m_t":"NR sidelink transmission: Any NR Sidelink-based transmission, including transmission for NR sidelink discovery, transmission for NR sidelink communication, transmission for Ranging/Sidelink Positioning, and transmission for A2X communication.","paragraph_zero_based":157},{"literal_text_all_w_t_and_m_t":"PDCCH occasion: A time duration (i.e. one or a consecutive number of symbols) during which the MAC entity is configured to monitor the PDCCH.","paragraph_zero_based":158},{"literal_text_all_w_t_and_m_t":"Positioning SRS Bandwidth Aggregation: Transmission of positioning SRS on multiple carriers in RRC_CONNECTED and RRC_INACTIVE where the positioning SRS resources are linked in RRC configuration as defined in TS 38.331 [5].","paragraph_zero_based":159},{"literal_text_all_w_t_and_m_t":"PRS Processing Window: A time window during which UE may perform PRS measurement inside the active DL BWP with the same numerology as the active DL BWP without measurement gap.","paragraph_zero_based":160},{"literal_text_all_w_t_and_m_t":"Ranging/Sidelink Positioning: AS functionality enabling ranging-based services and sidelink positioning as specified in TS 23.586 [30].","paragraph_zero_based":161},{"literal_text_all_w_t_and_m_t":"RB set: A RB set refers to a contiguous set of resource blocks (RBs) on which a channel access procedure is performed in shared spectrum as defined in TS 37.213 [18].","paragraph_zero_based":162},{"literal_text_all_w_t_and_m_t":"RedCap UE: A UE with reduced capabilities as specified in clause 4.2.21.1 in TS 38.306 [25].","paragraph_zero_based":163},{"literal_text_all_w_t_and_m_t":"Serving Cell: A PCell, a PSCell, or an SCell in TS 38.331 [5].","paragraph_zero_based":164},{"literal_text_all_w_t_and_m_t":"Shared SL-PRS resource pool: A sidelink resource pool which can be used for the transmission of both SL-PRS and PSSCH.","paragraph_zero_based":165},{"literal_text_all_w_t_and_m_t":"Sidelink transmission information: Sidelink transmission information included in an SCI for an SL-SCH transmission or SL-PRS transmission with or without SL-SCH transmission on Shared SL-PRS resource pool as specified in clause 8.3 and 8.4 of TS 38.212 [9] consists of Sidelink HARQ information including NDI, RV, Sidelink process ID, HARQ feedback enabled/disabled indicator, Sidelink identification information including cast type indicator, Source Layer-1 ID and Destination Layer-1 ID, and Sidelink other information including CSI request, SL-PRS request, SL-PRS resource ID, a priority, a communication range requirement and Zone ID and COT sharing information.","paragraph_zero_based":166},{"literal_text_all_w_t_and_m_t":"SL-PRS delay budget: Delay budget before which the SL-PRS is expected to be transmitted by the Tx UE.","paragraph_zero_based":167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"aff77448aa0c29346e92838a8068d532bf7fc7cee6b626a0d28c35eb56bc62eb","original_member_sha256":"8fb21086219d6c05d0b1987abc685c28d97deafa9e4dc7a0bcec470d129ecf7a","paragraph_ElementTree_utf8_XML_sha256":["0a1f02faee84325fe3f34b864370b2725d0a90b77553f6916624703fa0a2a6c5","be91a7e9e4e0113188360df2f94ac29790876f9e483cf2bf5f865e9ffad95952","750a6c5f5802a836a8b8891862e61bdeff43bc929ce0289f057197bbab99018f","395dcefa2514fe7210523bc19cf2abc672dc1deff2ee20fdff50bf2d657d5f20","5989d826c06f8e0c6fcb47be1524c21c4bfec7cd22e60afcf149b05c3303bfd2","dae129764d553466dbe0a82efb181f496005f2edca5b94263b2b4f828a5d3542","47dfa66dab17cdb02e4f7089b5ef2613e196e3401249e6dfe3f5de6b9268f565","49f9e7004789d16b1d482b9104d1402542178e8e686a306c937a7173cffdfb21","55d9dc1f54932a460d893759f5cdc8afb0b4719cf1a27f6ae26489708f59b73e","118a4055e1c60fd1f38e32542de34cfe7fe8ccd3c78c76349cf0d84751d5f2a3","ea465cc6d3542ce348f2c22a0144bf6f7b5e29b17257d23a345fc6e423613a41","6f2ea8876159029cb33c03c23c82e73ff946cda326f36b4a87353a101230d336","8b14f8f31eea6c4c67b15dbc508003130296a2ea1c813616d4249330315035ca","4a0080361839c0284138570d6eb136ea008d81d4fdc56547173e9d07dcbf7c83","3c6032e574cb853d5e00a53d717867b813df4c3459062249ee9f73bd1d4bed94","8ec86e4686b0a2ba3845bd15d00c1c9d32df3fea4c3b0a6ac5681ccd479d3283","761b211e795319bfaaf5a712fe68179f6c9dc569df56805abfa31b284ecb1be9","e2b7e3a5e7d5944ce882121ade3bcd34cbae748da9aa0f311b02df59941fdd0b","5df9a5dfa248b4dc3f211115315b5c20fab1f525ea72d2b4c4a29740fb62ed6d","4bf8a228f6e866b5dd3e019367502e3111931d4f8529062f5ea5111faaf2a021","8d9022442e275bd9a18c00af772661b7c41c2b5dc5e17b9647a13aa976e44096","d3b9b04c5a1b1058165d540497dc07521af77f60d55f613281da77c1278c6a1a","76b2becbf48dbccf213ab0a8293543fd446b6cb37d0335839ef1754d9d53bf3e","8c614448ac7463f3dec4de6081da7c2f13efacee0a92c1363794c3f0370d92de"],"paragraph_range_zero_based":[144,167],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2502080.zip::R2-2502080 Correction on SRS hopping in positioning.docx:p144"}
{"fields":{"filename":"R2-2502080.zip::R2-2502080 Correction on SRS hopping in positioning.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SL-PRS transmission information on Dedicated SL-PRS resource pool: SL-PRS transmission information on Dedicated SL-PRS resource pool is included in an SCI for an SL-PRS transmission on Dedicated SL-PRS resource pool, as specified in TS 38.212 [9], consisting of","paragraph_zero_based":168},{"literal_text_all_w_t_and_m_t":"-SL-PRS identification information, including cast type indicator, source ID and destination ID;","paragraph_zero_based":169},{"literal_text_all_w_t_and_m_t":"-SL-PRS transmission other information, including SL-PRS priority, SL-PRS request, SL-PRS resource ID and resource reservation period.","paragraph_zero_based":170},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":171},{"literal_text_all_w_t_and_m_t":"SRS positioning validity area: An area consisting of a list of cells within which the corresponding positioning SRS configuration is considered as valid.","paragraph_zero_based":172},{"literal_text_all_w_t_and_m_t":"Special Cell: For Dual Connectivity operation the term Special Cell refers to the PCell of the MCG or the PSCell of the SCG depending on if the MAC entity is associated to the MCG or the SCG, respectively. Otherwise the term Special Cell refers to the PCell. A Special Cell supports PUCCH transmission and contention-based Random Access, and is always activated.","paragraph_zero_based":173},{"literal_text_all_w_t_and_m_t":"Timing Advance Group: A group of Serving Cells that is configured by RRC and that, for the cells with a UL configured, using the same timing reference cell and the same Timing Advance value. A Timing Advance Group containing the SpCell of a MAC entity is referred to as Primary Timing Advance Group (PTAG), whereas the term Secondary Timing Advance Group (STAG) refers to other TAGs.","paragraph_zero_based":174},{"literal_text_all_w_t_and_m_t":"UE-gNB RTT: For non-terrestrial networks, the sum of the UE's Timing Advance value (see TS 38.211 [8] clause 4.3.1) and kmac.","paragraph_zero_based":175},{"literal_text_all_w_t_and_m_t":"V2X sidelink communication: AS functionality enabling V2X Communication as defined in TS 23.285 [20], between nearby UEs, using E-UTRA technology but not traversing any network node.","paragraph_zero_based":176},{"literal_text_all_w_t_and_m_t":"NOTE 1:A timer is running once it is started, until it is stopped or until it expires; otherwise it is not running. A timer can be started if it is not running or restarted if it is running. A Timer is always started or restarted from its initial value. The duration of a timer is not updated until it is stopped or expires (e.g. due to BWP switching). When the MAC entity applies zero value for a timer, the timer shall be started and immediately expire unless explicitly stated otherwise.","paragraph_zero_based":177},{"literal_text_all_w_t_and_m_t":"NOTE 2:In this version of the specification, the SRS in the procedural description includes Positioning SRS except for the Positioning SRS for transmission in RRC_INACTIVE as in clause 5.26. Positioning SRS except for the Positioning SRS for transmission in RRC_INACTIVE is treated the same as SRS by the UE unless explicitly stated otherwise.","paragraph_zero_based":178},{"literal_text_all_w_t_and_m_t":"3.2Abbreviations","paragraph_zero_based":179},{"literal_text_all_w_t_and_m_t":"For the purposes of the present document, the abbreviations given in TR 21.905 [1] and the following apply. An abbreviation defined in the present document takes precedence over the definition of the same abbreviation, if any, in TR 21.905 [1].","paragraph_zero_based":180},{"literal_text_all_w_t_and_m_t":"A2XAircraft-to-Everything","paragraph_zero_based":181},{"literal_text_all_w_t_and_m_t":"APAperiodic","paragraph_zero_based":182},{"literal_text_all_w_t_and_m_t":"BFRBeam Failure Recovery","paragraph_zero_based":183},{"literal_text_all_w_t_and_m_t":"BRIDBroadcast Remote Identification","paragraph_zero_based":184},{"literal_text_all_w_t_and_m_t":"BSRBuffer Status Report","paragraph_zero_based":185},{"literal_text_all_w_t_and_m_t":"BWPBandwidth Part","paragraph_zero_based":186},{"literal_text_all_w_t_and_m_t":"CEControl Element","paragraph_zero_based":187},{"literal_text_all_w_t_and_m_t":"CGCell Group","paragraph_zero_based":188},{"literal_text_all_w_t_and_m_t":"CG-SDTConfigured Grant-based SDT","paragraph_zero_based":189},{"literal_text_all_w_t_and_m_t":"CI-RNTICancellation Indication RNTI","paragraph_zero_based":190},{"literal_text_all_w_t_and_m_t":"CSIChannel State Information","paragraph_zero_based":191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"aff77448aa0c29346e92838a8068d532bf7fc7cee6b626a0d28c35eb56bc62eb","original_member_sha256":"8fb21086219d6c05d0b1987abc685c28d97deafa9e4dc7a0bcec470d129ecf7a","paragraph_ElementTree_utf8_XML_sha256":["f95005cf1586a7c906ea2cf657698b63b828422fbfb40139d30307f1727a8226","f6be07450edf0dfc4da46ae57d245c8ff7ce3546dea1a3a090311ba658a55c48","328d529d8edb6a5287072697357bf022195fccd9da8ca688d4ad800704f4d45a","05f59810d53f315d4cc514b7c74f9e092a23e93f85381ab39a8bcfd15baca5a7","945d473bc8738b40fb8d365dae577cdb699b137670a3b270e25324639e2a83b2","e7a15b43fb654390002f0cfe7b88f84d9be34306d46dc4b167d057f540d6c7cc","1f0398d4b0b1f6be8d85c1cf2a2794796c83447bbc762c7c92147c10820d8f70","fb5b9c9031c95a2cb51190d1917f021015f3133027b80be9be052c5bb5f36b17","9db5f38c68c4ada24868afc2e90fb1543a78718347620912e9555fad7f990f04","ce166a4c4a9892e0ba720701b8f2e2d017c4eb8a0bfcd09c5a73f337105029a1","4051c1ea841fdfd2e13cb0bf559c2772e717249aacb6df39f681d6e9f025bb62","b8a3e91fddd4250a976e3f641fc2d3f38d658ef768a55fb0cdbc13b828c996dd","a5edb6542722cb441c07bf96777bb17c74ef9dc9189de5ca88531cf64719629c","8368264f9999d7c51ab168c0ed6