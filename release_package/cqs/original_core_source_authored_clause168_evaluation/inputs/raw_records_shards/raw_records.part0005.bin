{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"cellId","paragraph_zero_based":4080},{"literal_text_all_w_t_and_m_t":"This field indicates the CGI of the cell in which the logging of the measurements included within csi-LogMeasInfoList was performed. If the CGI is not available, this field indicates the PCI-ARFCN-NR of the cell.","paragraph_zero_based":4081},{"literal_text_all_w_t_and_m_t":"csi-MoreLogMeasAvailable","paragraph_zero_based":4082},{"literal_text_all_w_t_and_m_t":"This field is included if the UE has additional logged L1 radio measurements available for transmission.","paragraph_zero_based":4083},{"literal_text_all_w_t_and_m_t":"csi-RS-MeasResultList","paragraph_zero_based":4084},{"literal_text_all_w_t_and_m_t":"List of logged L1 radio measurement results associated to CSI-RS resources.","paragraph_zero_based":4085},{"literal_text_all_w_t_and_m_t":"l1-RSRP","paragraph_zero_based":4086},{"literal_text_all_w_t_and_m_t":"Indicates the measured L1 RSRP associated to the resourceId, if included within CSI-RS-MeasResult. Indicates the measured L1 RSRP associated to the ssb-Id, if included within SSB-MeasResult.","paragraph_zero_based":4087},{"literal_text_all_w_t_and_m_t":"refCSI-LoggedMeasurementConfigId","paragraph_zero_based":4088},{"literal_text_all_w_t_and_m_t":"Reference to the instance of CSI-LoggedMeasurementConfig associated to the L1 radio measurement results reported in csi-RS-MeasResultList or ssb-MeasResultList.","paragraph_zero_based":4089},{"literal_text_all_w_t_and_m_t":"resourceId","paragraph_zero_based":4090},{"literal_text_all_w_t_and_m_t":"Indicates the NZP-CSI-RS-ResourceId associated to which the UE has logged L1 radio measurement results.","paragraph_zero_based":4091},{"literal_text_all_w_t_and_m_t":"ssb-Id","paragraph_zero_based":4092},{"literal_text_all_w_t_and_m_t":"Indicates the SSB-Index associated to which the UE has logged L1 radio measurement results.","paragraph_zero_based":4093},{"literal_text_all_w_t_and_m_t":"ssb-MeasResultList","paragraph_zero_based":4094},{"literal_text_all_w_t_and_m_t":"List of logged L1 radio measurement results associated to SSBs.","paragraph_zero_based":4095},{"literal_text_all_w_t_and_m_t":"timeGap","paragraph_zero_based":4096},{"literal_text_all_w_t_and_m_t":"Indicates that there was a time gap, longer than the logging periodicity, between the reported measurement results in this instance of csi-LogMeasInfoList and the previous instance of csi-LogMeasInfoList with the same refCSI-LoggedMeasurementConfigId for the same serving cell.","paragraph_zero_based":4097},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4098},{"literal_text_all_w_t_and_m_t":"NEXT CHANGE","paragraph_zero_based":4099},{"literal_text_all_w_t_and_m_t":"6.3.2Radio resource control information elements","paragraph_zero_based":4100},{"literal_text_all_w_t_and_m_t":"<Text Omitted>","paragraph_zero_based":4101},{"literal_text_all_w_t_and_m_t":"–ApplicabilitySetConfigId","paragraph_zero_based":4102},{"literal_text_all_w_t_and_m_t":"The IE ApplicabilitySetConfigId is used to identify an ApplicabilitySetCSI-Config.","paragraph_zero_based":4103}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["2ea2ad44636e2d4614345b26e1f8b41d701dc1c2f89f10546e6582ccf9169c03","7e6e55f888a5f48b35f72a04285ea864f95c29693c41d71a5e4deee92e59aa93","499b3a386be99dfe87b3b00ed30ce0c70de22574cac8fc0ac4d082260c7bbff3","b212419a8d48779969f5f0be50a1096ea6b307e55978abc17a0729679156c7b5","6cc62e90e87769949989eafd82c054bcfe1abdc004d14ab115af2acfae999cc6","a