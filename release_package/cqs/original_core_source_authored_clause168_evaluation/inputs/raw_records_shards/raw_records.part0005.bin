{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":47520},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47521},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47522},{"literal_text_all_w_t_and_m_t":"SL-PSSCH-TxParameters-r16 ::=    SEQUENCE {","paragraph_zero_based":47523},{"literal_text_all_w_t_and_m_t":"    sl-MinMCS-PSSCH-r16              INTEGER (0..27),","paragraph_zero_based":47524},{"literal_text_all_w_t_and_m_t":"    sl-MaxMCS-PSSCH-r16              INTEGER (0..31),","paragraph_zero_based":47525},{"literal_text_all_w_t_and_m_t":"    sl-MinSubChannelNumPSSCH-r16     INTEGER (1..27),","paragraph_zero_based":47526},{"literal_text_all_w_t_and_m_t":"    sl-MaxSubchannelNumPSSCH-r16     INTEGER (1..27),","paragraph_zero_based":47527},{"literal_text_all_w_t_and_m_t":"    sl-MaxTxTransNumPSSCH-r16        INTEGER (1..32),","paragraph_zero_based":47528},{"literal_text_all_w_t_and_m_t":"    sl-MaxTxPower-r16                SL-TxPower-r16                                      OPTIONAL    -- Cond CBR","paragraph_zero_based":47529},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":47530},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47531},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-PSSCH-TXCONFIGLIST-STOP","paragraph_zero_based":47532},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":47533},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47534},{"literal_text_all_w_t_and_m_t":"SL-PSSCH-TxConfigList field descriptions","paragraph_zero_based":47535},{"literal_text_all_w_t_and_m_t":"sl-MaxTxTransNumPSSCH","paragraph_zero_based":47536},{"literal_text_all_w_t_and_m_t":"Indicates the maximum transmission number (including new transmission and retransmission) for PSSCH.","paragraph_zero_based":47537},{"literal_text_all_w_t_and_m_t":"sl-MaxTxPower","paragraph_zero_based":47538},{"literal_text_all_w_t_and_m_t":"This field indicates the maximum transmission power for transmission on PSSCH and PSCCH.","paragraph_zero_based":47539},{"literal_text_all_w_t_and_m_t":"sl-MinMCS-PSSCH, sl-MaxMCS-PSSCH","paragraph_zero_based":47540},{"literal_text_all_w_t_and_m_t":"This field indicates the minimum and maximum MCS values used for transmissions on PSSCH. The UE shall ignore the minimum and maximum MCS values used for the associated MCS table(s) in sl-ParametersAboveThres-r16 and sl-ParametersBelowThres-r16 if sl-ParametersAboveThres-v1650 and sl-ParametersBelowThres-v1650 are present, respectively.","paragraph_zero_based":47541},{"literal_text_all_w_t_and_m_t":"sl-MinSubChannelNumPSSCH, sl-MaxSubChannelNumPSSCH","paragraph_zero_based":47542},{"literal_text_all_w_t_and_m_t":"This field indicates the minimum and maximum number of sub-channels which may be used for transmissions on PSSCH.","paragraph_zero_based":47543}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["cbb65717db3b9d24f64ce20c85c4db59994821d602d23bf8e609a1982f7852d8","945719403830fd845c9ae96043f9054ebba5f43ac84fb8a1585b7c46b698f846","dd2e4da320e293ed768ce33e888d419a545fa3f9eba975555098bb726f7f9cfe","9e7770b24c58cd94a16c8ec797a24651d896985702e4945b5dc85855337942bd","e4199e58aacd3c25946ec8e51046427a5d2c5f75084c5f9a5b820b5c372fdbda","3037c78304c0eb4e7f3036e7d6bf60e78c1979df1cc2b3ff8f4fb1d31cedaa8f","cc28e0a1f005eea0ff07a99fdfd4cb0becf94553e328ab0bf1bf059010cd595b","512617c3567284092b8084918d15fbbb1dc8f1074eaaf02f324b127f4f54a377","4d19472ea932142623cae12f59ec823ad4cc138518076977f3e0d7c124312004","34ab1e655bb848f3b613091571ce8ecc5accc4e290b6839e