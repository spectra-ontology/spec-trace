{"fields":{"filename":"R2-2409139.zip::R2-2409139.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":144},{"literal_text_all_w_t_and_m_t":"Figure 6.1.3.75-1: LTM Cell Switch Command MAC CE","paragraph_zero_based":145},{"literal_text_all_w_t_and_m_t":"NOTE 2:If UE receives the LTM Cell Switch Command MAC CE with a Target Configuration ID value not matching any configured ltm-CandidateId minus 1, as specified in TS 38.331 [5], the procedue of handling LTM Cell Switch Command MAC CE in clause 5.18.35 does not apply.","paragraph_zero_based":146},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":147},{"literal_text_all_w_t_and_m_t":"End of Change","paragraph_zero_based":148},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":149},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":150}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"baf9a6a317ecb737bd27ac62657fd838b2787d36b6e40c23a2dd4a3025606770","original_member_sha256":"4803f0e09a6d5f8c28332929848401ac4e2ba1faa08e4ff6be3754ebe6aca508","paragraph_ElementTree_utf8_XML_sha256":["f0f8b12748044aa6cc822a8b5659dd35b319114356e078a3e9a86c2277d70824","b8dc0f753572c270bcb7a0a59140e40e203aae42ee66f577dd3356e2c8054d0e","5c9ee2fd673b20e51caba2da45427214fa6c5b93470d81ad15dbe64a33959da1","fdef6522d9c9c917733be1f4a6876050145defc0df353214b3c631df843a7c58","4170fd0e3720995d0444b1cefa4567e2043aa9f4c12fceb557b164308e7f1fd8","71b1e1a55e5f63beb60aa463bebb2092b63db01b33a9f13fa05936f64e35f4ca","b72b1212687692a94c00c357f44325c20ad135f1306c8b4c057b0fa28bf632e5"],"paragraph_range_zero_based":[144,150],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2409139.zip::R2-2409139.docx:p144"}
