{"fields":{"filename":"R2-2408467.zip::R2-2408467 (Rel-17) Correction on HARQ process.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"X","paragraph_zero_based":24},{"literal_text_all_w_t_and_m_t":"Core Network","paragraph_zero_based":25},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28},{"literal_text_all_w_t_and_m_t":"Title:","paragraph_zero_based":29},{"literal_text_all_w_t_and_m_t":"Correction on HARQ process ","paragraph_zero_based":30},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32},{"literal_text_all_w_t_and_m_t":"Source to WG:","paragraph_zero_based":33},{"literal_text_all_w_t_and_m_t":"  Samsung, Ericsson, Nokia, LG Electronics Inc., Qualcomm Incorporated, Apple, ZTE,   CATT","paragraph_zero_based":34},{"literal_text_all_w_t_and_m_t":"Source to TSG:","paragraph_zero_based":35},{"literal_text_all_w_t_and_m_t":"R2","paragraph_zero_based":36},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38},{"literal_text_all_w_t_and_m_t":"Work item code:","paragraph_zero_based":39},{"literal_text_all_w_t_and_m_t":"NR_MBS-Core, NR_NTN_solutions-Core","paragraph_zero_based":40},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41},{"literal_text_all_w_t_and_m_t":"Date:","paragraph_zero_based":42},{"literal_text_all_w_t_and_m_t":"2024-10-04","paragraph_zero_based":43},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"c9de91d67498880932c1dde6923944d236ea8d0fe0d729f049d35a355f05d008","original_member_sha256":"49e0a6406262a36a2ea7274502eea842be303ae6c0fc399f8b32a6ce1c386d04","paragraph_ElementTree_utf8_XML_sha256":["324781e6639a9fd1b0e1301e8322d3945795b5a530bbbddcedc8e2415a1c92d9","4328dbc2e9ed59984edad9da9f918a037222a8bc1d4a7f801e449d0bf4e71fd0","1b57abbb250ccf0e7dbcfaad8666dd22e39df29408dc1d6e61b3298df1a31533","dca27312d7a1517d19ed558671871fab25e9b549c607883b97a78f9f3628f08a","6d3fba1314de1001e3753ed4f16b9c74cdf0271805f61b17dcc5b42bd590842f","617785343afc34ff86d7085e070e5171c849cf65b766df069d11ae4921b43535","778c23bf2f5503dcac3b01786e135f657cb4a6862edaa2288e0907d48402e144","cb9646e53a961acadd8b9d1cbe9977f71385aded0c0dd84e225defb7e8545ad8","e434e65a10e838afc9f35a37c5efebc215fd9aedc21692d7cc12941674744e85","48f27d1f338f2e6cabf1ff384625f9d1a5e67ab8190bf0af224f5e9fd5a2044d","9bfb753fad78d3eddd2161a111de0f9784ed805a4b8f9b3f7ce80e80d8c7aa18","731cd85286f824ffc8ab15b3e076faaf16231b040ec58d5b982eb0b04411f518","14af32e70078f76d6a5f09fbf5b5f3aed130fab20a4bc29d9a77122f9ddb8ccd","15446e336e26f8e8542354aaa67cefc1b9b0d8b4af76558f1b7e96594ab3e72b","032e9f858d3d59ab048f1c6847f25e5b233bb6ba0c88c96eee40690f328745ca","1ac810a1cab11c95a1df934fbe11d17d0c7b90f828c877e62a98a07ed58b7dfa","518181e6ef4a5abcc794b5561669f257d2d8dcc203f20b9bb74646b3a6a38cbc","b3f8ba76ec829a0eac6003bc8cbccaed17d41a62756dd1214cc8a7fa8c87c76d","ebb18e058d1fac3e0efc9941e530e6c9327f91af82e47a50969e70a111afea2a","772233448db60c41b7449d4e184f00ad03893168376809f2258c73d5b36669b8","dcb00a9e6c6c316c0088d2dc5f1b8ad2617b4424352762cd9029642ce44b55be","adf91afec1ef44a2388772bd7103ea6e4f36004e933a3b58dc00af5209fde022","500ae1e95311986e752b9be027e0c22a78d267c2f0de2c686523828721158b14","1cef444d894cdacbe559bb45e53c3b2ef7f77da82c45f0f24d784d4541645307"],"paragraph_range_zero_based":[24,47],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2408467.zip::R2-2408467 (Rel-17) Correction on HARQ process.docx:p24"}
{"fields":{"filename":"R2-2408467.zip::R2-2408467 (Rel-17) Correction on HARQ process.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"F","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Rel-17","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-17(Release 17)Rel-18(Release 18)Rel-19(Release 19) Rel-20(Release 20)","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":"Reason for change:","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"Issue 1: HARQ FB determination","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"Clause 5.3.2.2 specifies different conditions for determining whether to or not to instruct the physical layer to generate acknowledgement(s) of the data in this TB. It is noted that the configuration for HARQ process(es) with disabled HARQ feedback is separate/distinct from the configuration of HARQ feedback for a G-RNTI or a G-CS-RNTI or a configured downlink assignment for MBS multicast. Further, NTN service data reception can be through MBS multicast in a serving cell that is part of NTN. Therefore, condition for determining about HARQ feedback is particularly related to the transmission with which the concerned HARQ process is associated with. ","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"Previously, for this scenario of MBS multicast in NR NTN, RAN2#126 made an agreement as below.","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"MBS Multicast HARQ configuration takes precedence","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"Also to be noted that earlier during MBS WI, RAN2 discussed and agreed for no segregation or no dedicated HARQ process(es) for MBS multicast. This is particularly because any such segregation limits the network operation and flexibility. Moreover, MBS multicast HARQ FB configuration can be dynamically changed (e.g. enabled/disabled through DCI), so it is even more complicated to do any such assignment of HARQ processes.","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"As a result, the existing condition of not providing HARQ feedback “if the HARQ process is configured with disabled HARQ feedback”  should be replaced with “if the HARQ process is configured with disabled HARQ feedback and is not associated with a transmission indicated with a G-RNTI or a G-CS-RNTI or a configured downlink assignment for MBS multicast” ","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"c9de91d67498880932c1dde6923944d236ea8d0fe0d729f049d35a355f05d008","original_member_sha256":"49e0a6406262a36a2ea7274502eea842be303ae6c0fc399f8b32a6ce1c386d04","paragraph_ElementTree_utf8_XML_sha256":["e4ea5591218aa96d0cd407936b651eb165fb4c75e229dab64ec9de6be991cb96","2d00e3b1a82065155328ddd802c3d4a8ebff11f4a0d6da9ecf9b1e34dc8ebfc8","167050f74113a53970eb0ca5c3f042242e54486122035f724cbed2ca26d93f59","761fa4d36b282591b5f5bb5ee554c6086f6eb9d5925f257d405f142f9e3a17e1","9ee3a8ef1b4d8b5d23ae68c79878f83d9a7ffdf02ec93cff53f7b1de6029f4d6","28907132f939a51ab2e3f463f3f3b4b83feec57cbde5d62106971cb0c6193b72","b08252b53f111fda758564f01d6aeb287a86ceee9730eba0ca5fcf7c7dadb00e","5397ebe3cc2afa3393b897343a62f60e5b485315d8236802a715ec930f5cc336","c7f154badb51090dd578312419bcf46f1ff9111557a952165c0ca920b2e5af4d","dd3de490bf00baf5087f33777fa272abbec9623033d71526d5355fb97ee7f36f","16c8d70f7d429c511b56c375317337c5d5c75b5a185ec91bf088b77069963fb7","acd6206245de4b9556a4853ff1b8b41875944834aa76df6c7d72af763f365262","323a12f674243c9f6b19dea121faba35a22ef427f1952d64f506f3cfcefac965","4369209577db19d2376150d1c2f030bb25bad7e870365b22edc792c099f6225b","fd6ebbafd82b819f42255a078faab18903a696685f498b428b1de3354f259396","6f943cdb3c0f0769d31baddbe37b54e1e1a81ba88c1a77dd04ac30999d8b8720","cef7f445ff7ca209ad3ee527ff14410783d8d260c1d90abe6177ad7052a4b76b","d7c23222823f64b646e5a96b3208e8156b4c9d9966307eae8dc4f8a5550b18e9","101913be913c5eba668cdd14c83c25469e6922736045cb50ef2ec60956f95efb","09ee302f0892037bc75f987a0ce9bcb5250145698da237b1cfedf8db7022885d","9cf7654e23042ab3ad1e8497840e3bd270eebfdd85e88d282b0aa1f1a02a8bc8","cedbc9ebc55248c3018cfa8e40b002338868c0d02dac9fabbff7701b71168d20","2b0d515920b6c02a2a2c6f0729640d1be3c9a931ea71cb33fff8803a9b6e6abf","c9e5bae0f785a892481e470c8b3a65cd0a71f02d0e4b830655b52fb1f8332bd9"],"paragraph_range_zero_based":[48,71],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2408467.zip::R2-2408467 (Rel-17) Correction on HARQ process.docx:p48"}
{"fields":{"filename":"R2-2408467.zip::R2-2408467 (Rel-17) Correction on HARQ process.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":72},{"literal_text_all_w_t_and_m_t":"Issue 2: Spec misalignment between Rel-17 and Rel-18","paragraph_zero_based":73},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":74},{"literal_text_all_w_t_and_m_t":"Rel-17 and Rel-18 specifications are not consistent as the last OR condition in Rel-17 is specified in the ELSE section in Rel-18.","paragraph_zero_based":75},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":76},{"literal_text_all_w_t_and_m_t":"Rel-17","paragraph_zero_based":77},{"literal_text_all_w_t_and_m_t":"1>if the timeAlignmentTimer, associated with the TAG containing the Serving Cell on which the HARQ feedback is to be transmitted, is stopped or expired and if the cg-SDT-TimeAlignmentTimer, if configured, is not running; or","paragraph_zero_based":78},{"literal_text_all_w_t_and_m_t":"1>if the HARQ process is configured with disabled HARQ feedback:","paragraph_zero_based":79},{"literal_text_all_w_t_and_m_t":"2>if harq-FeedbackEnablingforSPSactive is configured with value true and the transmission is the first transmission on the configured downlink assignment after activation of the configured downlink assignment:","paragraph_zero_based":80},{"literal_text_all_w_t_and_m_t":"3>instruct the physical layer to generate acknowledgement(s) of the data in this TB.","paragraph_zero_based":81},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":82},{"literal_text_all_w_t_and_m_t":"3>not instruct the physical layer to generate acknowledgement(s) of the data in this TB.","paragraph_zero_based":83},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":84},{"literal_text_all_w_t_and_m_t":"Rel-18","paragraph_zero_based":85},{"literal_text_all_w_t_and_m_t":"1>if the timeAlignmentTimer, associated with the TAG containing the Serving Cell on which the HARQ feedback is to be transmitted, is stopped or expired, and the Serving Cell is not configured with two TAGs, and if the cg-SDT-TimeAlignmentTimer, if configured, is not running; or","paragraph_zero_based":86},{"literal_text_all_w_t_and_m_t":"1>if the Serving Cell on which the HARQ feedback is to be transmitted is configured with two TAGs and if the timeAlignmentTimer of the TAG, associated with the TCI state(s) used for transmitting the HARQ feedback, is stopped or expired:","paragraph_zero_based":87},{"literal_text_all_w_t_and_m_t":"2>not instruct the physical layer to generate acknowledgement(s) of the data in this TB.","paragraph_zero_based":88},{"literal_text_all_w_t_and_m_t":"1>else if the HARQ process is configured with disabled HARQ feedback:","paragraph_zero_based":89},{"literal_text_all_w_t_and_m_t":"2>if harq-FeedbackEnablingforSPSactive is configured with value true and the transmission is the first transmission on the configured downlink assignment after activation of the configured downlink assignment:","paragraph_zero_based":90},{"literal_text_all_w_t_and_m_t":"3>instruct the physical layer to generate acknowledgement(s) of the data in this TB.","paragraph_zero_based":91},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":92},{"literal_text_all_w_t_and_m_t":"3>not instruct the physical layer to generate acknowledgement(s) of the data in this TB.","paragraph_zero_based":93},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":94},{"literal_text_all_w_t_and_m_t":"This happened as, CR 1560 to v17.3.0 on NR-NTN (R2-2301983) added an additional condition related to ‘harq-FeedbackEnablingforSPSactive’ for NTN, but before that, the UE behavior for all the ‘or’ conditions was simply to ‘not instruct the physical layer to generate acknowledgement(s) of the data in this TB’ only. Then, Rel-18 CR (R2-2313849) made changes that the changes in the CR 1560 apply only to the NTN feature (i.e. condition of ‘1>        if the HARQ process is configured with disabled HARQ feedback’ for NTN). However, same is not reflected to Rel-17 spec.","paragraph_zero_based":95}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"c9de91d67498880932c1dde6923944d236ea8d0fe0d729f049d35a355f05d008","original_member_sha256":"49e0a6406262a36a2ea7274502eea842be303ae6c0fc399f8b32a6ce1c386d04","paragraph_ElementTree_utf8_XML_sha256":["5320ec2d1cee89cf7338703e831e16a48dbcd542b947b192af5aaa87deba1911","e54907712416b4bb7c94271ba6b00ce74183029852906477e4bc812004d5d1e6","ef381198746231d4c913b1dd26f0ffe88b5c33f014a048f36fc0cdead69e305f","df1cd37a56beaca31748c5dc4c13276b75d2c699e69cba90c0045f4914115cf9","c99796b12ca28a89d3e3ab532105b36c3f5c9fe6f2971a44d455e07de213f7fc","13a8fd089657084770039a8dcf68dbba9a473961a841ea4b776817824c5a9487","09f03e8c3e245cca1b19745baf7bd1dbdf3c22f1dc842544d56256d96eefe733","be63c88c1423546e8c1e87ea42182341606b3260818e360ef17e800e2ccb9f91","9d3102843acba867f58124be89b139efb91a272a60b405d0142fba4aecb92683","43b5d81b053d0b8d496af35a50170477c1f092add99c17b82536e210b58d0363","a34b045731b221f34ac368101f2244922f78a4a0b617fe34f308d99abdc9242b","8c9b0aa8f086c862145f9b4be7f218ff17a7517e9bfecc308e3a07e4538c77d3","b8d2b55176b26b1c34d0e0be78eb72c198878e599b216cbd6886d793981f0906","7998a6a652903083ae7a2f1ed9004f6cd1fede3ae4b4d49213e79deaf4ab059b","53b23bc712181ca7a8dd56f2782f83b111973729bf2c1c650d088b7a1dcc8bb6","37f53224a2a2bc596b7cccf7a8cd6ed770872c0e785d085c5ecaf275b2760093","c7dc7933361940afeb8fe0d6ac2c9f7e8c29ca75ca8d4bd7e2938d7e5ca0940d","a2a52f7c79190755ff5a40573c9abeae9f7033a108aa5ca88706386930d1f980","acbc7b81b8a296c24f6c56badb4604256a8478b550988d6a47d382b4307353d0","1ddbf0ed4999ccc722885b5fb859ace771290828602d0c437f932b52cfd068bd","1d6bb64e85fcacbe4aeac7ea5d2fb73aa5ae7c7a95c05b8fb6021cfe4a0a94fa","97d28078d05f67e1bfb9624b06cc2af197f284cef5b06d96c077d8ed446cac37","a761c8b7f6ddddeb159ff56c8281568c027b075a8565a795f6e0e4a7a2528cd4","9f2f2f244473737de87b5aaba03438bc4488f36bbdc774281615483f4eece7ec"],"paragraph_range_zero_based":[72,95],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2408467.zip::R2-2408467 (Rel-17) Correction on HARQ process.docx:p72"}
{"fields":{"filename":"R2-2408467.zip::R2-2408467 (Rel-17) Correction on HARQ process.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":96},{"literal_text_all_w_t_and_m_t":"As a consequence, there is disparity across Rel-17 and Rel-18 specifications, which is highly undesired from spec consistency and maintainence perspectives. Also, it is not accurate in Rel-17 spec as the changes in the CR 1560 should apply only to the NTN feature. It is therefore required to align the Rel-17 spec to that of Rel-18.","paragraph_zero_based":97},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":98},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":99},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":100},{"literal_text_all_w_t_and_m_t":"In clause 5.3.2.2, the condition is further clarified as ","paragraph_zero_based":101},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":102},{"literal_text_all_w_t_and_m_t":"if the HARQ process is configured with disabled HARQ feedback and is not associated with a transmission indicated with a G-RNTI or a G-CS-RNTI or a configured downlink assignment for MBS multicast”","paragraph_zero_based":103},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":104},{"literal_text_all_w_t_and_m_t":"In clause 5.3.2.2, the conditions in Rel-17 spec are made aligned with Rel-18 spec.","paragraph_zero_based":105},{"literal_text_all_w_t_and_m_t":"1>if the timeAlignmentTimer, associated with the TAG containing the Serving Cell on which the HARQ feedback is to be transmitted, is stopped or expired and if the cg-SDT-TimeAlignmentTimer, if configured, is not running; or:","paragraph_zero_based":106},{"literal_text_all_w_t_and_m_t":"2>not instruct the physical layer to generate acknowledgement(s) of the data in this TB.","paragraph_zero_based":107},{"literal_text_all_w_t_and_m_t":"else if the HARQ process is configured with disabled HARQ feedback:","paragraph_zero_based":108},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":109},{"literal_text_all_w_t_and_m_t":"Impact analysis","paragraph_zero_based":110},{"literal_text_all_w_t_and_m_t":"Impacted functionality:","paragraph_zero_based":111},{"literal_text_all_w_t_and_m_t":"HARQ for MBS in NTNs","paragraph_zero_based":112},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":113},{"literal_text_all_w_t_and_m_t":"Impacted 5G architecture options:","paragraph_zero_based":114},{"literal_text_all_w_t_and_m_t":"NR SA","paragraph_zero_based":115},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":116},{"literal_text_all_w_t_and_m_t":"Inter-operability: ","paragraph_zero_based":117},{"literal_text_all_w_t_and_m_t":"If the network is implemented according to the CR and the UE is not, the HARQ feedback may not be provided by UE.","paragraph_zero_based":118},{"literal_text_all_w_t_and_m_t":"If the UE is implemented according to the CR and the network is not, the UE may provide the HARQ feedback but network may not expect the feedback.","paragraph_zero_based":119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"c9de91d67498880932c1dde6923944d236ea8d0fe0d729f049d35a355f05d008","original_member_sha256":"49e0a6406262a36a2ea7274502eea842be303ae6c0fc399f8b32a6ce1c386d04","paragraph_ElementTree_utf8_XML_sha256":["33b7e372db0e108d67b3999250dff23a4d238e72dbedf0ddf8c7ff6548a87db7","7644069e6c224aca0959461792767ccbd92ef35f6786e8a4c2bcfcc2de99d4c1","63c359e929e7abe9eeba5dffb36e00f5bd87de8b9c45a9d731ab29168c2e030c","f9d207337b43a4275af6008b4d50afa66f420dea0e6c4a05a5872bfe965809ed","6011501d2fde541c5eb1b5be03c2dca157febefd14fb50c75c9b9063d8c707bc","db7597c2c37d5141888ee1058c583a6d385f466147f1803cc052b31357d4b4d7","bc91099fc5cc607889c0e46f32aecefb6c866968823b6f4ebb0b35246e4f226b","661b75244c51d2b706469f77233a4a4840f78f64ac270