{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>set the n-th bit of bfd-MeasRelaxationState to '0', where n is equal to the servCellIndex value + 1 of the serving cell.","paragraph_zero_based":1872},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to indicate availability of data mapped to radio bearers not configured for SDT according to 5.7.4.2:","paragraph_zero_based":1873},{"literal_text_all_w_t_and_m_t":"2>include the nonSDT-DataIndication in the UEAssistanceInformation message;","paragraph_zero_based":1874},{"literal_text_all_w_t_and_m_t":"2>include and set the resumeCause according to the information received from the upper layers, if provided.","paragraph_zero_based":1875},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide an indication of preference for SCG deactivation according to 5.7.4.2:","paragraph_zero_based":1876},{"literal_text_all_w_t_and_m_t":"2>include scg-DeactivationPreference in the UEAssistanceInformation message;","paragraph_zero_based":1877},{"literal_text_all_w_t_and_m_t":"2>set the scg-DeactivationPreference to scg-DeactivationPreferred if the UE prefers the SCG to be deactivated, otherwise set it to noPreference;","paragraph_zero_based":1878},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide an indication that the UE has uplink data related to a deactivated SCG according to 5.7.4.2:","paragraph_zero_based":1879},{"literal_text_all_w_t_and_m_t":"2>include uplinkData in the UEAssistanceInformation message.","paragraph_zero_based":1880},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide an indication about whether the criterion for RRM relaxation for connected mode is fulfilled or not fulfilled:","paragraph_zero_based":1881},{"literal_text_all_w_t_and_m_t":"2>if the criterion for RRM measurement relaxation for connected mode is fulfilled:","paragraph_zero_based":1882},{"literal_text_all_w_t_and_m_t":"3>set the rrm-MeasRelaxationFulfilment to true;","paragraph_zero_based":1883},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":1884},{"literal_text_all_w_t_and_m_t":"3>set the rrm-MeasRelaxationFulfilment to false.","paragraph_zero_based":1885},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide the service link propagation delay difference between serving cell and neighbour cell(s) according to 5.7.4.2;","paragraph_zero_based":1886},{"literal_text_all_w_t_and_m_t":"2>include the propagationDelayDifference for each neighbour cell in the neighCellInfoList;","paragraph_zero_based":1887},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide preference on multi-Rx operation for FR2 according to 5.7.4.2:","paragraph_zero_based":1888},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference for not operating on multi-Rx (i.e. not supporting simultaneous reception with different QCL-typeD) for FR2:","paragraph_zero_based":1889},{"literal_text_all_w_t_and_m_t":"3>set multiRx-PreferenceFR2 to single;","paragraph_zero_based":1890},{"literal_text_all_w_t_and_m_t":"2>else (if the UE has the preference for operating on multi-Rx for FR2):","paragraph_zero_based":1891},{"literal_text_all_w_t_and_m_t":"3>set multiRx-PreferenceFR2 to multiple.","paragraph_zero_based":1892},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to indicate the availability of flight path information according to 5.7.4.2 or 5.3.5.3;","paragraph_zero_based":1893},{"literal_text_all_w_t_and_m_t":"2>include the flightPathInfoAvailable;","paragraph_zero_based":1894},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide UL traffic information according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":1895}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["f07dfa8f730ec903c95c437aa7644e93d6ce4a39af1af8038c454a034bb8b3b1","93b7344366633efe3e6cd570498229156e45b5b44d069185c76efe5594a32f40","238173da7b9d0cec175eecf0595ab33b78b7a4b06d936910adf0695afd8f3a87","71d1a460298505691107892be9057cbea5add38370097dd0cfe552f31f10876f","6e44b82133ddb3176a847446a5d2edcada8074502ea1797c36351a546dd9365f","1b750c9e3f319dc620b279c4d06e949710e540f50520cc329660cee46f4cd395","c6dfcd8697930549a1a7dfdb007bf01c8c10f8b0b8e2b706a4108b0f9bf713f9","9105600d32a9c8b413b20750cb5b7df38b3a568f0af9e1b2cd1d591b373a949c","69d2ec744c7c65393f67cb93c79df4e7257d84eacbd0450d3ec2a89356b10d33","d9d2c9a691d1871bfef0448c056c2dc22aed2c37c320e2cd9fe057b0356b79d3","4c8963c6d062cecd6fc54575956c5bb373ffb9fc27ee83acd45a48acb6654595","7b52dfb427eae010b827df82355672f645e6e685b04be57710d378fc5e62a1f4","b53efa5613d840a33da9bb34bcfc7e84739b95ed90d79a8b5a9b7dc25c64c5a2","4e122b43f5ccf0b163b51fd8eb69ec1b805abc081140e4e3309ab12298550992","ae9525f95fc35e871f0927901710e860dd9a21409647c7cd7722c31e8c02fa41","0968f0712132ed4003422d30b3d6d1cd3bed69b363375145c0afaeb4f6b9b094","0bff311c3d8b2411b1baf462710231d15f47045a1609a2123c9c5d4456125d62","971b6ac5006a79a14964cf17aeee5cb2b207ccc0e03cdff16eb552de5f5badfb","e6f9aabd921b963e08359da85758be9bac47ed790f000d568f09fca25aa7b326","3f12d5b6ef62f8cf276664cc4af41dba19d960f9c64c1f6b5be4e07cda00595b","56d587ad1db5c66487fda594340b361e9fff3b988987533b6042aa8c53f9eb44","6fb026c05b75868535ccd85eb601ab198e6ac41afd7a40a31eb843f9099789f7","4ba8c33e5088f278c7232f7e23df76d0a13cc096f75db13c05158c45d97d6f57","c1d60b6e5b2470efc3232113a9ca69e0d3f192ea3361a098cf0180b90c7c3b57"],"paragraph_range_zero_based":[1872,1895],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx:p1872"}
{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>for each PDU session for which the UE intends to provide UL traffic information in this UEAssistanceInformation message:","paragraph_zero_based":1896},{"literal_text_all_w_t_and_m_t":"3>set pdu-SessionID to the value of the concerned PDU session ID;","paragraph_zero_based":1897},{"literal_text_all_w_t_and_m_t":"3>if transmission of the UEAssistanceInformation message is initiated to provide UL traffic information according to 5.3.5.3:","paragraph_zero_based":1898},{"literal_text_all_w_t_and_m_t":"4>stop timer T346l for each QoS flow of this PDU session for which the UE intends to provide UL traffic information in this UEAssistanceInformation message;","paragraph_zero_based":1899},{"literal_text_all_w_t_and_m_t":"3>for each QoS flow of this PDU session for which timer T346l is not running and for which the UE intends to provide UL traffic information in this UEAssistanceInformation message:","paragraph_zero_based":1900},{"literal_text_all_w_t_and_m_t":"4>start timer T346l associated to this QoS flow with the timer value set to the value of ul-TrafficInfoProhibitTimer;","paragraph_zero_based":1901},{"literal_text_all_w_t_and_m_t":"4>set qfi to the value of the concerned QFI;","paragraph_zero_based":1902},{"literal_text_all_w_t_and_m_t":"4>if the jitter range measurement is available; and","paragraph_zero_based":1903},{"literal_text_all_w_t_and_m_t":"4>if the UE did not provide jitter range since it was configured to provide UL traffic information, or if the measured jitter range has changed since the last transmission of the UEAssistanceInformation message containing jitterRange:","paragraph_zero_based":1904},{"literal_text_all_w_t_and_m_t":"5>set jitterRange to the latest measured value of the jitter range;","paragraph_zero_based":1905},{"literal_text_all_w_t_and_m_t":"4>if the burst arrival time measurement is available; and","paragraph_zero_based":1906},{"literal_text_all_w_t_and_m_t":"4>if the UE did not provide burst arrival time since it was configured to provide UL traffic information, or if the measured burst arrival time has changed since the last transmission of the UEAssistanceInformation message containing burstArrivalTime:","paragraph_zero_based":1907},{"literal_text_all_w_t_and_m_t":"5>set burstArrivalTime to the latest measured value of the burst arrival time;","paragraph_zero_based":1908},{"literal_text_all_w_t_and_m_t":"4>if the traffic periodicity measurement is available; and","paragraph_zero_based":1909},{"literal_text_all_w_t_and_m_t":"4>if the UE did not provide traffic periodicity since it was configured to provide UL traffic information, or if the measured traffic periodicity has changed since the last transmission of the UEAssistanceInformation message containing trafficPeriodicity:","paragraph_zero_based":1910},{"literal_text_all_w_t_and_m_t":"5>set trafficPeriodicity to the latest measured value of the traffic periodicity;","paragraph_zero_based":1911},{"literal_text_all_w_t_and_m_t":"4>if the UE did not provide pdu-SetIdentification since it was configured to provide UL traffic information, or if the information previously provided in pdu-SetIdentification has changed since the last transmission of the UEAssistanceInformation message containing pdu-SetIdentification:","paragraph_zero_based":1912},{"literal_text_all_w_t_and_m_t":"5>if the UE is able to identify PDU Set(s) for the QoS flow:","paragraph_zero_based":1913},{"literal_text_all_w_t_and_m_t":"6>set pdu-SetIdentification to true;","paragraph_zero_based":1914},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":1915},{"literal_text_all_w_t_and_m_t":"6>set pdu-SetIdentification to false.","paragraph_zero_based":1916},{"literal_text_all_w_t_and_m_t":"4>if the UE did not provide psi-Identification since it was configured to provide UL traffic information, or if the information previously provided in psi-Identification has changed since the last transmission of the UEAssistanceInformation message containing psi-Identification:","paragraph_zero_based":1917},{"literal_text_all_w_t_and_m_t":"5>if the UE is able to identify PSI(s) for the QoS flow:","paragraph_zero_based":1918},{"literal_text_all_w_t_and_m_t":"6>set psi-Identification to true;","paragraph_zero_based":1919}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["3fe45098100502f904dc0ca1e9c5569ad571f82d676636c21874fe714dc21508","b2883b27fd2f4ab32122f012fc1a205dbc4fbc83a2ecc93ae18790dbf46b6872","9d1e5a3ebf6e7da5d50fd36ee63d4b90e7154d91058b4dfdcdd579e9b9603656","8acd51d9cd4360e7b080698bff1765ed39046ca7c8bbeb276d96541e044bfc63","bafcf0b45291e925dfa8fa1e6068b00e85517cb0b64cc2864e17007e9decd909","cd82915eeb46e80e3aeab20395f3128b78b4464ec6b67c7d2ebaa928c1a04641","cbbd713b2b93b598c82adb7f41d7abf62e08553a9005f5fa36603849a292ba0a","31d31469d103c6d037e8babd78d2048eda354474f8446acb62d5316179b0f936","8f374acc068d491faf03f3522c3ae0a23b8faf26ee6d0c20fc2959903322babc","a0b133a3ffe23b45a2fe048c85ff76118a8ce1daac9cfd15637529b9b9633626","9dd117b61e2ca6dadbae880215f36c58ea2cfa26fb1eac0e8b066206175edaa5","f3394b990b2213a2e6e825a576df003b985226575abc0850b4b126ecc42cf20b","3e86f750de2bf4366d21af6e28999c36f83b1f596e69a7bc8241fc5ea3a23fe5","6f22d5b6707688bb4821f2bf3e782abae325b6bda94ab6c6eed30f0e2c1b1576","e5fc1d864ff07c33d7f21bce0502173bf993dd60b5bd3c949a92d2d05f8bd7aa","e6287e2791efae3704ebe35064f0447acc31fe1c3631f34536c705826c90706a","904805f3b0daef8c22c8718dd9b9223a2e9b272fb65cfe16a03d847b77947524","b0dd427b2f6247a8043307859429d2d0c6ea821075e1915ab38bcd050e931bf2","1e83615010e0efbe54d7c787042ea0a6911a5c1ae95fc8fac454e1bdf9edcfec","71c2021d1ef56d91dd9e81618b9798ef60f6d581fddf4713fd4be32389c74711","99eaed5df4e165ae131e1dcf140ce94e962c98e047776aac2f3ca66fa78e9edd","3889baa4e7eb0034e669815f67341bbae45a7a5a29ec63e3b144aea4554ce808","78a15d22758b4194bf5124e253de0b390b1d936e4139e8aeef82529f048e47e9","256b63e3aec0620e5a340a7ff57f2507ea7e8fd16ec7327f6e3eaa7a7fdcd4cd"],"paragraph_range_zero_based":[1896,1919],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx:p1896"}
{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":1920},{"literal_text_all_w_t_and_m_t":"6>set psi-Identification to false.","paragraph_zero_based":1921},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to report relay UE information with non-3GPP connection(s) according to 5.7.4.2:","paragraph_zero_based":1922},{"literal_text_all_w_t_and_m_t":"2>include n3c-relayUE-InfoList in the UEAssistanceInformation message;","paragraph_zero_based":1923},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to report the UE's preference for gap occasion cancellation ratio according to 5.7.4.2:","paragraph_zero_based":1924},{"literal_text_all_w_t_and_m_t":"2>if gapUE is configured under measGapConfig; and","paragraph_zero_based":1925},{"literal_text_all_w_t_and_m_t":"2>if the UE has the preference for gap occasion cancellation ratio for per UE gap:","paragraph_zero_based":1926},{"literal_text_all_w_t_and_m_t":"3>set perUE to the preferred gap occasion cancellation ratio;","paragraph_zero_based":1927},{"literal_text_all_w_t_and_m_t":"2>if gapFR1 or gapFR2 is configured under measGapConfig:","paragraph_zero_based":1928},{"literal_text_all_w_t_and_m_t":"3>if the UE has the preference for gap occasion cancellation ratio for FR1:","paragraph_zero_based":1929},{"literal_text_all_w_t_and_m_t":"4>set fr1 to the preferred gap occasion cancellation ratio;","paragraph_zero_based":1930},{"literal_text_all_w_t_and_m_t":"3>if the UE has the preference for gap occasion cancellation ratio for FR2:","paragraph_zero_based":1931},{"literal_text_all_w_t_and_m_t":"4>set fr2 to the preferred gap occasion cancellation ratio;","paragraph_zero_based":1932},{"literal_text_all_w_t_and_m_t":"2>if gapToAddModList is configured under measGapConfig:","paragraph_zero_based":1933},{"literal_text_all_w_t_and_m_t":"3>include the preferred gap occasion cancellation ratio for each measurement gap configuration with measGapId for which the UE has preferred gap occasion cancellation ratio;","paragraph_zero_based":1934},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide lpwus-OffsetPreference of a cell group according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":1935},{"literal_text_all_w_t_and_m_t":"2>include lpwus-OffsetPreference in the UEAssistanceInformation message;","paragraph_zero_based":1936},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on time offset for LP-WUS monitoring:","paragraph_zero_based":1937},{"literal_text_all_w_t_and_m_t":"3>set the timeOffset to the preferred offset value;","paragraph_zero_based":1938},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to report assistance information about the applicability of configurations subject to applicability determination procedure according to 5.7.4.2:","paragraph_zero_based":1939},{"literal_text_all_w_t_and_m_t":"2>include applicabilityReportList in this UEAssistanceInformation message;","paragraph_zero_based":1940},{"literal_text_all_w_t_and_m_t":"2>for each serving cell:","paragraph_zero_based":1941},{"literal_text_all_w_t_and_m_t":"3>if the cell is configured with at least one reportConfigId associated to a CSI-ReportConfig including csi-InferencePrediction, or including reportQuantity-r19 set to p-CRI-r19 or p-SSB-Index-r19 or p-CRI-RSRP-r19 or p-SSB-Index-RSRP-r19, for which the applicability status has changed; or","paragraph_zero_based":1942},{"literal_text_all_w_t_and_m_t":"3>if the associated serving cell index was included in an entry in applicabilityConfigToAddModList within applicabilityReportConfig and the applicability status for at least one of the associated entries in applicabilitySetConfigCSI-ToAddModList has changed:","paragraph_zero_based":1943}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["2644dfa7463a7125aa098bee55267052a49cd4344cd9e29da2ca6905cb0d94ca","12f4406a40b508574f45aff83d8dd8cdc1b9653183429d357d218e4e38961f7b","148f5ac353c569378877e1bd4778f73993db4c013171da629b3ed309a9763125","e01ecd00c5ba5d00cab4b81791126abeac248e2d651fdd5ce8e185aff4091c9c","74ac8ad9e7b8dcab22152a2a0e3b4554fc20884d3baed3656b26c6967424225f","785e3a703f4d43d94a6ecabda1423daeba5aebe4f676fa2e203ddd5b0bf65236","1ccad831603051047bd859cab9253bf7624051eb17303de5051f27106ba629d7","9ff3755aeb0764f80d3421aeb45ba328ceba68cf8d4369fcaf1f7d15e28a6a06","19317a723d89ad6049ec64a13e86fc649066daac5a1e4ca6cf3de5f3a3eca113","56c520c4a834513fece8abeecb7b01e2dffa21253fc3a5e61f77c64e21037191","8b80a0e7d18a0a5ca27d8bd49414e305ae4faaf80c524a07541c11010c014da1","ba95f0606596a684399942c559ee1db28cb4942ef1b3e70708c07a9caa61f4ba","81f96fed7a4e981bc4b8a455cc106dddac5a674ff9833792485c3c678985615c","64576060c19d82174b0096ba02d657148a14e622fa25643620d7e240612c17cf","50f3be663830cc95aa1dc3543b5644413f16effb92d9f10522d53d4b67ac00b1","0a44735fb46f6ef20cc4bd98c04e466553e377b7158f60c0e12610684523fd4b","d225c5c311bb7f4fd1305bf2e7dc9cee916e1fd59cf07c198c064514acc61b23","1df35a4fa74431bfd1c5f1a8163e147ecc0e076e6db3d961a1f272593b4fbe81","2a4f61ac1da752373dae91461525c6a1daa2f3c161c83b39546088c01e5ca0cd","0902558e950a0ec513b8723683b9cde5634dd28d64c340a5019f433823356cd8","778c1a345d7d56086f3a6ebaeddae4938ec82a9d4e0a2c3786901bfe645e2ee6","68408975cc7701003ae2e1802aa6c054bd9427fe8c9d2ac1fde8c15b27b65f3e","8b2ec8f7ee99a416da409ef67b9c51e94c01128b46757c42c15e4bcd5c0d9530","0d44f8366f33668dcf4454289a3609bc15af96f77d4c8eefedbb94bdbdf5216a"],"paragraph_range_zero_based":[1920,1943],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx:p1920"}
{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>include an entry in applicabilityReportList in the UEAssistanceInformation message, and set the content as follows:","paragraph_zero_based":1944},{"literal_text_all_w_t_and_m_t":"5>set the applicabilityCellId to the serving cell index of the cell;","paragraph_zero_based":1945},{"literal_text_all_w_t_and_m_t":"5>for each configured reportConfigId associated to a CSI-ReportConfig including csi-InferencePrediction, or including reportQuantity-r19 set to p-CRI-r19 or p-SSB-Index-r19 or p-CRI-RSRP-r19 or p-SSB-Index-RSRP-r19, for which the applicability status has changed:","paragraph_zero_based":1946},{"literal_text_all_w_t_and_m_t":"6>include an entry in the applicabilityInfoReportList and set the content as follows:","paragraph_zero_based":1947},{"literal_text_all_w_t_and_m_t":"7>set the csi-ReportConfigId within applicabilityInfoReportId to the corresponding reportConfigId;","paragraph_zero_based":1948},{"literal_text_all_w_t_and_m_t":"7>set the applicabilityStatus to the applicability status of the configuration corresponding to the applicabilityInfoReportId;","paragraph_zero_based":1949},{"literal_text_all_w_t_and_m_t":"7>if the applicabilityStatus is set to inapplicable:","paragraph_zero_based":1950},{"literal_text_all_w_t_and_m_t":"8>if the UE prefers to release the concerned CSI-ReportConfig, include releaseConfigurationPreference;","paragraph_zero_based":1951},{"literal_text_all_w_t_and_m_t":"5>for each entry within applicabilitySetConfigCSI-ToAddModList that changed applicability status, associated with the concerned serving cell:","paragraph_zero_based":1952},{"literal_text_all_w_t_and_m_t":"6>include an entry in the applicabilityInfoReportList and set the content as follows:","paragraph_zero_based":1953},{"literal_text_all_w_t_and_m_t":"7>set the applicabilitySetId within applicabilityInfoReportId to the corresponding applicabilitySetConfigId;","paragraph_zero_based":1954},{"literal_text_all_w_t_and_m_t":"7>set the applicabilityStatus to the applicability status of the configuration corresponding to the applicabilityInfoReportId;","paragraph_zero_based":1955},{"literal_text_all_w_t_and_m_t":"7>if the applicabilityStatus is set to inapplicable:","paragraph_zero_based":1956},{"literal_text_all_w_t_and_m_t":"8>if the UE prefers to release the concerned configuration in ApplicabilitySetConfigCSI, include releaseConfigurationPreference;","paragraph_zero_based":1957},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to report the UE preference to be configured or stop being configured with radio resources to perform UE-side data collection according to 5.7.4.2:","paragraph_zero_based":1958},{"literal_text_all_w_t_and_m_t":"2>include dataCollectionPreference in this UEAssistanceInformation message;","paragraph_zero_based":1959},{"literal_text_all_w_t_and_m_t":"2>if the UE prefers to be configured with radio resources to perform data collection:","paragraph_zero_based":1960},{"literal_text_all_w_t_and_m_t":"3>if the UE is configured with dataCollectionPreferenceConfig, but has no stored candidate configurations for UE-side data collection:","paragraph_zero_based":1961},{"literal_text_all_w_t_and_m_t":"4>set dataCollectionRequest to true;","paragraph_zero_based":1962},{"literal_text_all_w_t_and_m_t":"3>else if the UE is configured with dataCollectionPreferenceConfig including, for at least one serving cell, at least one candidate configuration for UE-side data collection:","paragraph_zero_based":1963},{"literal_text_all_w_t_and_m_t":"4>for each serving cell configured with candidate UE-side data collection configuration(s) and for which the UE has one or more preferred radio resource configuration(s):","paragraph_zero_based":1964},{"literal_text_all_w_t_and_m_t":"5>include an entry in dataCollectionPreferredConfigurationList and set the content as follows:","paragraph_zero_based":1965},{"literal_text_all_w_t_and_m_t":"6>set the dataCollectionServCellIndex to the serving cell index of the cell;","paragraph_zero_based":1966},{"literal_text_all_w_t_and_m_t":"6>include in dataCollectionCandidateIdList the dataCollectionCandidateConfigId associated with each preferred candidate UE-side data collection configuration;","paragraph_zero_based":1967}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["794cd0f951541a2e160aed879fee39a413c34cbb82fc69a0eff0b8a87e338156","d0abe6eccae8f33a2765007013e13b5bd5d2480028935a61b67c8eb9b32f7829","3bba620126313395a83a487f3084cc9a959a18251e9dac0bb57bc3fad3f108ab","e1a5ee48bb6f2c0fae551ddaaeac7d3726b5c9d3fbab70e21679e2334f2caa84","fab23a04bcbc3e2f1eba39ef427929cddadc23eaa471caf13c0290718672916c","2000d5e38ff3907a7abd38a053fa7cb0a97b9cce55a1ba8b70e4f4482308f00b","d8d776bab059a600df05e95940975d5fbc6c068b8605ec7374e5c2f66154874c","9ab717494bfb4edb8ae4accdad09a5492af580f4d8e3fa5b2f51ffc6f0033cd9","98c50b534c133fc5e7df90fa1406fb3ed1cd449a893d21246faa6e5e7a80d502","0dca47289ff4d94723c04cd0c00bf2de9fd96c9111172942fe23673037ea8051","12beb3043e1967ba47caef5dd13ec94a4b1a46bdd54d68db3387a8a1c048d3d5","f445acfa05288b7a9c0341306d49da5242cebd0c90007455ddf199c1acbccc07","ad780413c879698ab1f83f1aa9afe3e63f19e2f0523500683b0db7b99fdb7b56","2508dd086a1516b4626fcb7ef353a904393630254289b29e0ab31d505f831aa8","76e5d9678d9673ef8f4edcb5ec99782ca0aa949902f6beabb2e1bf3cb82a309a","b66d765a7fa4f2cc4dccbbe1acca773bda644342d8ef1972b1074fbcd3bdfd51","495de3dff342b597b28d937c9e841b8002ea54630f66ccef36d7251dec50c92b","eb1531e4fbd7ff27af46dd0b8f64416e69fa992260719461e9809d73798f45ed","a54157f91dabbad3ef8ef3edbbc3c00e116be9f4dfa5441486b064e86bde6ca6","4d5a191c38471d35dc11279bcd5910458bb0fb1e1f6a6f0a150fddbe09630b9f","099b00e6f294e4c3270ba470312163051684cbb62cae7c817443f8571ce00e80","cf108fa7a749bdc9702e77058dfa3c891bda9e7da71c4631fde0e2f89eb2b83c","75891029857855f02086bf909f4c48a7ad50ad2287a267943d409e5a157ad3ca","95b296869ce6e485066e5612699eeeecf3345d5a7d3d474909e460ab093ef472"],"paragraph_range_zero_based":[1944,1967],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx:p1944"}
{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if the UE no longer prefers to be configured with radio resources to perform data collection:","paragraph_zero_based":1968},{"literal_text_all_w_t_and_m_t":"3>for each serving cell configured with one or more UE-side data collection configuration(s) corresponding to a CSI-ReportConfig and for which the UE prefers to stop UE-side data collection:","paragraph_zero_based":1969},{"literal_text_all_w_t_and_m_t":"4>include an entry in dataCollectionStopConfigurationList and set the content as follows:","paragraph_zero_based":1970},{"literal_text_all_w_t_and_m_t":"5>set the dataCollectionStopServCellIndex to the serving cell index of the cell;","paragraph_zero_based":1971},{"literal_text_all_w_t_and_m_t":"5>include in dataCollectionIdList the reportConfigId associated with the CSI-ReportConfig including the UE-side data collection configuration(s) that the UE prefers to stop;","paragraph_zero_based":1972},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide assistance information related to logging of measurements for network-side data collection according to 5.7.4.2:","paragraph_zero_based":1973},{"literal_text_all_w_t_and_m_t":"2>if the UE determines that it has entered a low power state:","paragraph_zero_based":1974},{"literal_text_all_w_t_and_m_t":"3>set lowPowerState to true;","paragraph_zero_based":1975},{"literal_text_all_w_t_and_m_t":"2>if the memory reserved for the logging of radio measurements for network-side data collection has become full:","paragraph_zero_based":1976},{"literal_text_all_w_t_and_m_t":"3>set memoryStatus to full;","paragraph_zero_based":1977},{"literal_text_all_w_t_and_m_t":"2>else if loggedDataCollectionMemoryThreshold is configured and if the amount of logged data related to radio measurements for network-side data collection has become equal to or above the loggedDataCollectionMemoryThreshold:","paragraph_zero_based":1978},{"literal_text_all_w_t_and_m_t":"3>set memoryStatusto aboveThreshold;","paragraph_zero_based":1979},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide location information for assisted SMTC configuration in RRC_CONNECTED state according to 5.7.4.2;","paragraph_zero_based":1980},{"literal_text_all_w_t_and_m_t":"2>include the referenceLocationReport with a number of closest reference locations to the current UE’s position determined by closestLocsToReport;","paragraph_zero_based":1981},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of the UEAssistanceInformation message for configured grant assistance information for NR sidelink communication or NR sidelink positioning:","paragraph_zero_based":1982},{"literal_text_all_w_t_and_m_t":"1>if configured to provide configured grant assistance information for NR sidelink:","paragraph_zero_based":1983},{"literal_text_all_w_t_and_m_t":"2>include the sl-UE-AssistanceInformationNR;","paragraph_zero_based":1984},{"literal_text_all_w_t_and_m_t":"1>if configured to provide configured grant assistance information for NR sidelink positioning:","paragraph_zero_based":1985},{"literal_text_all_w_t_and_m_t":"2>include the sl-PRS-UE-AssistanceInformationNR;","paragraph_zero_based":1986},{"literal_text_all_w_t_and_m_t":"NOTE 4:It is up to UE implementation when and how to trigger configured grant assistance information for NR sidelink communication or NR sidelink positioning.","paragraph_zero_based":1987},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":1988},{"literal_text_all_w_t_and_m_t":"1>if the procedure was triggered to provide configured grant assistance information for NR sidelink communication by an NR RRCReconfiguration message that was embedded within an E-UTRA RRCConnectionReconfiguration:","paragraph_zero_based":1989},{"literal_text_all_w_t_and_m_t":"2>submit the UEAssistanceInformation to lower layers via SRB1, embedded in E-UTRA RRC message ULInformationTransferIRAT as specified in TS 36.331 [10], clause 5.6.28;","paragraph_zero_based":1990},{"literal_text_all_w_t_and_m_t":"1>else if the procedure was triggered to provide UE preference for SCG deactivation or to indicate that the UE with a deactivate SCG has uplink data to send on a DRB for which there is no MCG RLC bearer:","paragraph_zero_based":1991}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["cce07a1dd4df326af7df9131a0f1544b722c129a9d634f7951482f489d0a4508","e36b00aafe57b485d9da44bf807f4f4b2375933e58583f36992021e02a28cee5","afd649e767ffb9864255ae163956b8968e79a6d9e60692c43ebfc1d261bc96a4","20a48d7d98a8f8956488149c57a8ec30db509732628f393131d1494db6e61373","2d6669045c10a872e17bb5e3666b3aed4b698b62541c3f1f8b07c04bcaca74a4","3979ee6a711fa60fdab2d18ec222dd938cfe562a1da0fc3353130e601530103b","90d8c6ac5d429edbf34ad05ce3a8ac19a1d97b0b323ae6f62ed0fdae7b3c85a7","2c85f20e9c30b6d927fffba298b1a2c5d982418dcaeb0a4f9a1f6c3aa06239ed","b48350a4a3f12ca34183b9f7c49b8f853625f78ef70dff8aefe38dccc937d3c9","72e61fba4eabcb5bc98e78abb8b216212c9898ef5c6040db4ef8ecc487c8ddc8","af95fc9cd6d57abd2fb4e25f22d1c9270c98d3d4bb00d879b05787dff1d3bb5d","0fc2cd628bc9da04b5a79041cfb936b704dd0616fef1e5beff237fcbbef6aa6a","0e56056f86589151d8ba2e681a4d66be834d2d131e42e9ecaca94d6229ba901f","09d755bc831f6ed02e1eab7724d313784804b1f473d76d432759767878f2a6d5","3bbcfd6d52980810e60a2f4bfe4001c677c2a4a97d3d13f06aeb9f9cf7e9d2cc","f457ad5b4a039bc28e43a960b3f9b045ae6e9f0791c2bc7fa7765794560135ed","7ca322a75f99ce45f87ce07df6b1acbe4531e57106fb5f80f6d90d36f78feafb","eb79d173338a0bb3b551fa5123c09813294cc8719b78d98a4214e7ad4a358f04","edf52cd2a23b9a48df3ca8716e4b5c9105821aa775ed5107f9da34e38b87abf0","881e537157ec01565b97b3d6999f9fe450fcf6910a76362914792519125713ff","b152d8a4b76668aebf4a99833ccfb105c9316dc789fa914429f8ad02fbe124ec","376799b417e5e7bce173800a04e5117fa778dbd69427c8327daced6dc264db1a","01d1841f0c93611fd9fea3ef8950225161f24468a2204d661bb92dbf5900d424","667e280bb512a3d1b52ca52ec74fcb733923425e581e8ad5e699a956be915dd2"],"paragraph_range_zero_based":[1968,1991],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx:p1968"}
{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>submit the UEAssistanceInformation via SRB1 to lower layers for transmission;","paragraph_zero_based":1992},{"literal_text_all_w_t_and_m_t":"1>else if the UE is in (NG)EN-DC:","paragraph_zero_based":1993},{"literal_text_all_w_t_and_m_t":"2>if SRB3 is configured and the SCG is not deactivated:","paragraph_zero_based":1994},{"literal_text_all_w_t_and_m_t":"3>submit the UEAssistanceInformation message via SRB3 to lower layers for transmission;","paragraph_zero_based":1995},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":1996},{"literal_text_all_w_t_and_m_t":"3>submit the UEAssistanceInformation message via the E-UTRA MCG embedded in E-UTRA RRC message ULInformationTransferMRDC as specified in TS 36.331 [10].","paragraph_zero_based":1997},{"literal_text_all_w_t_and_m_t":"1>else if the UE is in NR-DC:","paragraph_zero_based":1998},{"literal_text_all_w_t_and_m_t":"2>if the UE assistance configuration that triggered this UE assistance information is associated with the SCG:","paragraph_zero_based":1999},{"literal_text_all_w_t_and_m_t":"3>if SRB3 is configured and the SCG is not deactivated:","paragraph_zero_based":2000},{"literal_text_all_w_t_and_m_t":"4>submit the UEAssistanceInformation message via SRB3 to lower layers for transmission;","paragraph_zero_based":2001},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":2002},{"literal_text_all_w_t_and_m_t":"4>submit the UEAssistanceInformation message via the NR MCG embedded in NR RRC message ULInformationTransferMRDC as specified in 5.7.2a.3;","paragraph_zero_based":2003},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":2004},{"literal_text_all_w_t_and_m_t":"3>submit the UEAssistanceInformation message via SRB1 to lower layers for transmission;","paragraph_zero_based":2005},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":2006},{"literal_text_all_w_t_and_m_t":"2>submit the UEAssistanceInformation message to lower layers for transmission.","paragraph_zero_based":2007},{"literal_text_all_w_t_and_m_t":"NEXT CHANGE","paragraph_zero_based":2008},{"literal_text_all_w_t_and_m_t":"5.7.10.3Reception of the UEInformationRequest message","paragraph_zero_based":2009},{"literal_text_all_w_t_and_m_t":"Upon receiving the UEInformationRequest message, the UE shall, only after successful security activation:","paragraph_zero_based":2010},{"literal_text_all_w_t_and_m_t":"1>if the idleModeMeasurementReq is included in the UEInformationRequest and the UE has stored VarMeasIdleReport that contains measurement information concerning cells other than the PCell:","paragraph_zero_based":2011},{"literal_text_all_w_t_and_m_t":"2>if validatedMeasurementsReq is included in the UEInformationRequest and measIdleValidityDuration is included in VarEnhMeasIdleConfig;","paragraph_zero_based":2012},{"literal_text_all_w_t_and_m_t":"3>set the measResultIdleEUTRA in the UEInformationResponse message to the value of measReportIdleEUTRA in the VarMeasIdleReport for any valid measurement results, if available, and set validityStatus to the value of measIdleValidityDuration in VarEnhMeasIdleConfig for each reported measurement;","paragraph_zero_based":2013},{"literal_text_all_w_t_and_m_t":"3>set the measResultIdleNR in the UEInformationResponse message to the value of measReportIdleNR in the VarMeasIdleReport for any valid measurement results, if available, and set validityStatus to the value of measIdleValidityDuration in VarEnhMeasIdleConfig for each reported measurement;","paragraph_zero_based":2014},{"literal_text_all_w_t_and_m_t":"3>discard the VarMeasIdleReport upon successful delivery of the UEInformationResponse message confirmed by lower layers;","paragraph_zero_based":2015}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["bac4cdd2aaa9dace301a51e8653700ab811f5bb03c38d37bd67ebe636a95517d","3a97f13ebca660b4063eaa0705df495f76cc60a0798b58041dc22d7347983e17","d5a314e9188e0af064562c80be9aaa81ec8edd0c11a195e2c5ab7ca467def928","196eb9612627fa6e3c4cad806373f7cba7aa0d6a6b593ee2d6b9d9562493bd0f","896db11326c681b237426fcbc5ad0e50327ca76acdf49210855199899d24e312","c9f080ae37eaa4d7be664199ea24310b3a1fb4cf789b27ac85e7195889754ce1","15ee668a167e727ea9997975e8ca5b399ecefcec3d935dd0eb4437197142db5f","12a84e3237b8d02e4330b34f2ec71d5890349b5125616dd0bbe5cc2d5e3ddfea","0ec5bfd3cfea31233adcfda8a5125be947d887682a3b8f5b392fb1fb333bcd83","c20f47a384ff8c9e936a8cfc524cd1cffb51641823e02946b3585932a245cc6c","919c126e25c26ba324ab45876516628ccbab6295d3f9e64ed3042d9b57a1b76a","79f5bc96ab828d7784e0831930344dab6bc4ffb105b946f58b44bfc98bfbc332","380c4f9a5ebf311500dac37a1e3a22abc1b0fe83f542e33b90c15cb0aaa3a453","0a52b9c1bd771026d44e146f1cdb2e0bea009143c49e9a1df15bb2e120e120a2","ba617cadcf3d8a1f7e2a6aeada9f9894d7d07cec63e0933c95856b3590cb030d","55dbc653215d7e7fc5d6ea18d663f68e107737c1b6e3164aa9ec3e2f9b2020c2","28dadaf711d785cf840759b8684baa4d9078b04685deeec5dadff66d7b0e0cc6","d1ac894f50957ee479e3b95b415d18aa69dd4d152bd621b55a240851c2723596","18d30624774cfd0b4eb85a857eeaedc2f3a15c1870bfdb771baa2019aae2424d","74213043990cac3925d3b07a2f16f4157d62b022f272644e947183baa5cdfe28","b618ed1ea069642fd4ad0a22a6903b065fb507b38add373e30c06a00fc330130","29dcf75608be7592ec75682f00def918e819cad9ac1ac124c667cc4b7ffd761a","b1d51a36dc53bcb0c8d960e3bcaf05c68fe9aea6f0d7c3b03df69dbfbfb75019","5f88e157043805d9d5243412128ffe375e84fbccb17c2d1b4add99c150c69cb0"],"paragraph_range_zero_based":[1992,2015],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx:p1992"}
{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>remove the measIdleValidityDuration in VarEnhMeasIdleConfig;","paragraph_zero_based":2016},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":2017},{"literal_text_all_w_t_and_m_t":"3>set the measResultIdleEUTRA in the UEInformationResponse message to the value of measReportIdleEUTRA in the VarMeasIdleReport, if available;","paragraph_zero_based":2018},{"literal_text_all_w_t_and_m_t":"3>set the measResultIdleNR in the UEInformationResponse message to the value of measReportIdleNR in the VarMeasIdleReport, if available;","paragraph_zero_based":2019},{"literal_text_all_w_t_and_m_t":"3>discard the VarMeasIdleReport upon successful delivery of the UEInformationResponse message confirmed by lower layers;","paragraph_zero_based":2020},{"literal_text_all_w_t_and_m_t":"3>remove the measIdleValidityDuration in VarEnhMeasIdleConfig, if stored;","paragraph_zero_based":2021},{"literal_text_all_w_t_and_m_t":"1>if the reselectionMeasurementReq is included in the UEInformationRequest:","paragraph_zero_based":2022},{"literal_text_all_w_t_and_m_t":"2>if validatedMeasurementsReq is included in the UEInformationRequest and measReselectionValidityDuration is included in VarMeasReselectionConfig;","paragraph_zero_based":2023},{"literal_text_all_w_t_and_m_t":"3>if measReselectionCarrierListNR is present in VarMeasReselectionConfig:","paragraph_zero_based":2024},{"literal_text_all_w_t_and_m_t":"4>set the measResultReselectionNR in the UEInformationResponse message the valid NR measurement results, if available for any frequency listed in measReselectionCarrierListNR in VarMeasReselectionConfig and set validityStatus to the value of measIdleValidityDuration in VarMeasReselectionConfig for each reported measurement;","paragraph_zero_based":2025},{"literal_text_all_w_t_and_m_t":"3> else:","paragraph_zero_based":2026},{"literal_text_all_w_t_and_m_t":"4>set the measResultReselectionNR in the UEInformationResponse message to any valid NR measurement results, if available, and set validityStatus to the value of measIdleValidityDuration in VarMeasReselectionConfig;","paragraph_zero_based":2027},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":2028},{"literal_text_all_w_t_and_m_t":"3>if measReselectionCarrierListNR is present in VarMeasReselectionConfig:","paragraph_zero_based":2029},{"literal_text_all_w_t_and_m_t":"4>set the measResultReselectionNR in the UEInformationResponse message the NR measurement results, if available for any frequency listed in measReselectionCarrierListNR in VarMeasReselectionConfig;","paragraph_zero_based":2030},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":2031},{"literal_text_all_w_t_and_m_t":"4>set the measResultReselectionNR in the UEInformationResponse message to any NR measurement results, if available;","paragraph_zero_based":2032},{"literal_text_all_w_t_and_m_t":"1>if the logMeasReportReq is present and if the RPLMN is included in plmn-IdentityList stored in VarLogMeasReport, or if the current registered SNPN identity is included in snpn-ConfigID-List stored in VarLogMeasReport:","paragraph_zero_based":2033},{"literal_text_all_w_t_and_m_t":"2>if VarLogMeasReport includes one or more logged measurement entries, set the contents of the logMeasReport in the UEInformationResponse message as follows:","paragraph_zero_based":2034},{"literal_text_all_w_t_and_m_t":"3>include the absoluteTimeStamp and set it to the value of absoluteTimeInfo in the VarLogMeasReport;","paragraph_zero_based":2035},{"literal_text_all_w_t_and_m_t":"3>include the traceReference and set it to the value of traceReference in the VarLogMeasReport;","paragraph_zero_based":2036},{"literal_text_all_w_t_and_m_t":"3>include the traceRecordingSessionRef and set it to the value of traceRecordingSessionRef in the VarLogMeasReport;","paragraph_zero_based":2037},{"literal_text_all_w_t_and_m_t":"3>include the tce-Id and set it to the value of tce-Id in the VarLogMeasReport;","paragraph_zero_based":2038},{"literal_text_all_w_t_and_m_t":"3>include the logMeasInfoList and set it to include one or more entries from the VarLogMeasReport starting from the entries logged first, and for each entry of the logMeasInfoList that is included, include all information stored in the corresponding logMeasInfoList entry in VarLogMeasReport;","paragraph_zero_based":2039}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["98d951684e92c26cc146f14c0dfdc2348b14daf2062ddf18d1945cfa7bcd01c0","47cecb2e6e9f62a3772131c690dd7f18d6f0bc22de9e7c94b550cbed45543ac2","0f1d0221759566245054f75fb979b682b904b5ab46734f1d87622f5ca73dcbbe","2b4ccf9c0e390f1e070ec91c96d6002d6784ca04d3fc92880851f91e5ae2c199","7a89a2cd255bf6dac479f04e5a9250d19af1845291df259536c4e66d3bb283c5","fe9c5fcc58a99ba8ef214d3a90d3d13489c8ba05d30ffc708c8ab87f622eab49","ba5efbebd0cd25df981a5deb1faf4e99a851e17e51fbf9f75f83e2968d3ed9c9","c2be3a871971edfeb04dda58f7165a22e6dcc6b809c0f7206a98c6cfab10bda0","1ea7ecdc2bee0de180493cfec29d094dfa96ff115835c1b9df0c0a838271ea2c","7082a1a74b2c29465cdb28aa0f13ef7657937ba5ee0801a68778e75558d3ac45","7cdc593cac076b04c3189a52409544770d6b384153ac8c5b6da1679f1d645d40","a35a8b9c058f2d7e5f4bd6583457a2dbdecaea3e79b218553ad4c31860d8aa8e","9fedf8f0dc04e6d210de277d95bc375883b393262d3bd98d241c484d1f21f70c","be636bb504a5587822a147428cce975abe03bd85e64a6b655f764a7a9b8cd492","262a14ed282fcc374966c647956ed455a47542dd4717c2bd3fbc9f50cb073575","02f6976122c02f56379dc3e2fbcd299e413418f4b3279a18d48f4b19f0606417","1076036173dfc729405e01affbfae59199b9114b7fdbaea4e2813f965e869ea8","7572256d4cddb46d7f833f66dcc5b8626e46d0cf23443f4831606fa2c24ea5f2","1f2ae685b3038766150e3daca992a735d1cc65629fb125e4c7d719b38ddfe5be","8dbb92d2dca90f239cd036bf5658d7188c1baf9e54aeb7c4bbd377f483b035b6","3fde9239d1ad0b2f9008580d5282136af5f8303aa4998eab6f3b6c472e6c8693","3ff25e404c795d5fe7b936d9606d09f90489f9e78a68f10f09a5d2957863eb7a","3749c75ea5cbcc73d39cf8dae98fdafe986573dc18321c69a713a2def3af2282","a761e81e3cb9c5a5988e3b11a4598c8bdb49f9136d55c41dd1d3fd7f71f382a9"],"paragraph_range_zero_based":[2016,2039],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx:p2016"}
{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>if the VarLogMeasReport includes one or more additional logged measurement entries that are not included in the logMeasInfoList within the UEInformationResponse message:","paragraph_zero_based":2040},{"literal_text_all_w_t_and_m_t":"4>include the logMeasAvailable;","paragraph_zero_based":2041},{"literal_text_all_w_t_and_m_t":"4>if bt-LocationInfo is included in locationInfo of one or more of the additional logged measurement entries in VarLogMeasReport that are not included in the logMeasInfoList within the UEInformationResponse message:","paragraph_zero_based":2042},{"literal_text_all_w_t_and_m_t":"5>include the logMeasAvailableBT;","paragraph_zero_based":2043},{"literal_text_all_w_t_and_m_t":"4>if wlan-LocationInfo is included in locationInfo of one or more of the additional logged measurement entries in VarLogMeasReport that are not included in the logMeasInfoList within the UEInformationResponse message:","paragraph_zero_based":2044},{"literal_text_all_w_t_and_m_t":"5>include the logMeasAvailableWLAN;","paragraph_zero_based":2045},{"literal_text_all_w_t_and_m_t":"1>if ra-ReportReq is set to true and the UE has random access related information available in VarRA-Report and if the RPLMN is included in plmn-IdentityList stored in VarRA-Report; or","paragraph_zero_based":2046},{"literal_text_all_w_t_and_m_t":"1>if ra-ReportReq is set to true and the UE has random access related information available in VarRA-Report and if the registered SNPN identity is included in snpn-IdentityList stored in VarRA-Report:","paragraph_zero_based":2047},{"literal_text_all_w_t_and_m_t":"2>for each RA-Report stored in ra-ReportList in VarRA-Report that consists of failed SDT information:","paragraph_zero_based":2048},{"literal_text_all_w_t_and_m_t":"3>set timeSinceSdt-Execution to the time that elapsed since SDT execution;","paragraph_zero_based":2049},{"literal_text_all_w_t_and_m_t":"2>set the ra-ReportList in the UEInformationResponse message to the value of ra-ReportList in VarRA-Report;","paragraph_zero_based":2050},{"literal_text_all_w_t_and_m_t":"2>discard the ra-ReportList from VarRA-Report upon successful delivery of the UEInformationResponse message confirmed by lower layers;","paragraph_zero_based":2051},{"literal_text_all_w_t_and_m_t":"1>if rlf-ReportReq is set to true:","paragraph_zero_based":2052},{"literal_text_all_w_t_and_m_t":"2>if the UE has radio link failure information or handover failure information available in VarRLF-Report and if the RPLMN is included in plmn-IdentityList stored in VarRLF-Report; or","paragraph_zero_based":2053},{"literal_text_all_w_t_and_m_t":"2>if the UE has radio link failure information or handover failure information available in VarRLF-Report and if the current registered SNPN identity is included in snpn-IdentityList stored in VarRLF-Report:","paragraph_zero_based":2054},{"literal_text_all_w_t_and_m_t":"3>set timeSinceFailure in VarRLF-Report to the time that elapsed since the last radio link failure or handover failure or LTM cell switch execution failure in NR;","paragraph_zero_based":2055},{"literal_text_all_w_t_and_m_t":"3>set the rlf-Report in the UEInformationResponse message to the value of rlf-Report in VarRLF-Report;","paragraph_zero_based":2056},{"literal_text_all_w_t_and_m_t":"3>discard the rlf-Report from VarRLF-Report upon successful delivery of the UEInformationResponse message confirmed by lower layers;","paragraph_zero_based":2057},{"literal_text_all_w_t_and_m_t":"2>else if the UE is capable of cross-RAT RLF reporting as defined in TS 38.306 [26] and has radio link failure information or handover failure information available in VarRLF-Report of TS 36.331 [10] and if the RPLMN is included in plmn-IdentityList stored in VarRLF-Report of TS 36.331 [10]:","paragraph_zero_based":2058},{"literal_text_all_w_t_and_m_t":"3>set timeSinceFailure in VarRLF-Report of TS 36.331 [10] to the time that elapsed since the last radio link failure or handover failure in EUTRA;","paragraph_zero_based":2059},{"literal_text_all_w_t_and_m_t":"3>set failedPCellId-EUTRA in the rlf-Report in the UEInformationResponse message to indicate the PCell in which RLF was detected or the source PCell of the failed handover in the VarRLF-Report of TS 36.331 [10];","paragraph_zero_based":2060},{"literal_text_all_w_t_and_m_t":"3>set the measResult-RLF-Report-EUTRA in the rlf-Report in the UEInformationResponse message to the value of rlf-Report in VarRLF-Report of TS 36.331 [10];","paragraph_zero_based":2061},{"literal_text_all_w_t_and_m_t":"3>discard the rlf-Report from VarRLF-Report of TS 36.331 [10] upon successful delivery of the UEInformationResponse message confirmed by lower layers;","paragraph_zero_based":2062},{"literal_text_all_w_t_and_m_t":"1>if connEstFailReportReq is set to true and the UE has connection establishment failure or connection resume failure information in VarConnEstFailReport or VarConnEstFailReportList and if the RPLMN is equal to plmn-Identity stored in VarConnEstFailReport or in at least one of the entries of VarConnEstFailReportList:","paragraph_zero_based":2063}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["751bd055790a68ff763b1607c97918158627fac1f890e2485297a1a64616dc51","5e147db242d16a4f22be5095e0d22c85d071d197856cbdbc50edfa457348e5cf","37d1690db4c0cecff5d4d763151c9ad0b398d66225aa120baaf7f69ac66e52d5","2b5cf05cdf75440caea16d036da88cf3ffaa73813b6d73d0d9132b658cd9a3c2","cb90dae0d2ad8d9c68941f2367370da541c60b4a4cd56f01d07eb30379bd7ec0","303677cb8c42282e8e5df40836958df211228954d9bef0c5da2b789048d6c5cf","e4e6047d83c7d4f80ac1a75c3bdb23d4dbf5538e068eb7c535de82d7b94ca5da","7e1660370bf4ead35bb341e0e548d004ff5adde7a37faa17d8973d8f785b3c86","8cdaa2059ce9076d82b4e1c460d747b3064371415bce0e245686222969daca0b","f4d0b2b24db82d2791feccb65d76e283134be1a210ecf6705ca0b8ea4ce87820","a1a7d5b0f89a720908b934861565a0e808bb74739b03aa3dce42826dd311455f","5881dcb84e005e022996a9f6cb055eb35b6fac18f0d8383d8248376e42398de1","711f124910f3ccaa1da9643f982afa3dec657b62169f0c1a8d31cbf0a18f8a9d","be0e4080dfe8cc43678686ccc4c992e310fcadffd4da3fc8711953867d30bcd4","4ea302258a29876ea95f16886ed26108b9529bed96da243d1be3b9be5724fcf9","d51e41a5d7012ff2dcb7cd60229c1ddf40c71a76289eb40120d0e49b20ac6a36","d836ec40dbb5e22cbef5f8f54f78da55d5ed0e0003ce836a1fa139a0f9354877","ab55f0002f6809f705bde187c8a81f30c6e84e8019432c50e3716b8063e91e55","dc89f234cb7b20001ea9e3169e39251036481a0e86ad1bc016df29400b358d8a","07b545de178270ecc122cdee56394366789eede3ce2f49f162fbe6b3de768097","9b9f6908761c835e2fff5c871da4ab7ca44c32078da2130a05e57e8959a88876","4a38fd2057a2846068d9924d5e0a84f34a23954f8e9f0f709c4d9362d4adb0a1","a5aeb5ac18692b763ca459f2afe1cfca45ae9e75b485f2f07fe4fc3d00fb85a6","2785e09c343772f9e1f38fb373b15984c3c36b75bb404337070197acb5212a1a"],"paragraph_range_zero_based":[2040,2063],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx:p2040"}
{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>if connEstFailReportReq is set to true and if the UE has connection establishment failure information or connection resume failure information available in VarConnEstFailReport or VarConnEstFailReportList and if the registered SNPN identity is equal to snpn-Identity in networkIdentity stored in VarConnEstFailReport or any entry of VarConnEstFailReportList:","paragraph_zero_based":2064},{"literal_text_all_w_t_and_m_t":"2>set timeSinceFailure in VarConnEstFailReport to the time that elapsed since the last connection establishment failure or connection resume failure in NR;","paragraph_zero_based":2065},{"literal_text_all_w_t_and_m_t":"2>set the connEstFailReport in the UEInformationResponse message to the value of connEstFailReport in VarConnEstFailReport;","paragraph_zero_based":2066},{"literal_text_all_w_t_and_m_t":"2>if the UE supports multiple CEF report:","paragraph_zero_based":2067},{"literal_text_all_w_t_and_m_t":"3>for each connEstFailReport in the connEstFailReportList in VarConnEstFailReportList:","paragraph_zero_based":2068},{"literal_text_all_w_t_and_m_t":"4>set timeSinceFailure to the time that elapsed since the associated connection establishment failure or connection resume failure in NR;","paragraph_zero_based":2069},{"literal_text_all_w_t_and_m_t":"2>for each connEstFailReport in the connEstFailReportList in the UEInformationResponse message, set the value to the value of connEstFailReport in VarConnEstFailReport in VarConnEstFailReportList;","paragraph_zero_based":2070},{"literal_text_all_w_t_and_m_t":"2>discard the connEstFailReport from VarConnEstFailReport and VarConnEstFailReportList upon successful delivery of the UEInformationResponse message confirmed by lower layers;","paragraph_zero_based":2071},{"literal_text_all_w_t_and_m_t":"1>if the mobilityHistoryReportReq is set to true:","paragraph_zero_based":2072},{"literal_text_all_w_t_and_m_t":"2>include the mobilityHistoryReport and set it to include visitedCellInfoList from VarMobilityHistoryReport;","paragraph_zero_based":2073},{"literal_text_all_w_t_and_m_t":"2>include in the mobilityHistoryReport an entry for the current PCell, possibly after removing the oldest entry if required, and set its fields as follows:","paragraph_zero_based":2074},{"literal_text_all_w_t_and_m_t":"3>set visitedCellId to the global cell identity or the physical cell identity and carrier frequency of the current PCell:","paragraph_zero_based":2075},{"literal_text_all_w_t_and_m_t":"3>set field timeSpent to the time spent in the current PCell;","paragraph_zero_based":2076},{"literal_text_all_w_t_and_m_t":"3>if the UE supports PSCell mobility history information and if visitedPSCellInfoList is present in VarMobilityHistoryReport:","paragraph_zero_based":2077},{"literal_text_all_w_t_and_m_t":"4>for the newest entry of the PCell in the mobilityHistoryReport, include visitedPSCellInfoList from VarMobilityHistoryReport;","paragraph_zero_based":2078},{"literal_text_all_w_t_and_m_t":"4>if the UE is configured with a PSCell:","paragraph_zero_based":2079},{"literal_text_all_w_t_and_m_t":"5>for the newest entry of the PCell in the mobilityHistoryReport, include the current PSCell information in the visitedPSCellInfoListReport, possibly after removing the oldest PSCell entry of a PCell in the mobilityHistoryReport, if required, and set its fields as follows:","paragraph_zero_based":2080},{"literal_text_all_w_t_and_m_t":"6>set visitedCellId to the global cell identity or the physical cell identity and carrier frequency of the current PSCell:","paragraph_zero_based":2081},{"literal_text_all_w_t_and_m_t":"6>set field timeSpent to the time spent in the current PSCell while being connected to the current PCell;","paragraph_zero_based":2082},{"literal_text_all_w_t_and_m_t":"6>if the UE supports storing and reporting SCG activation information in mobility history information:","paragraph_zero_based":2083},{"literal_text_all_w_t_and_m_t":"7> set the field scgActiveDuration of the entry to the accumulated time spent in the current PSCell with SCG state set to activated during the stay in the PSCell while being connected to the current PCell, if available;","paragraph_zero_based":2084},{"literal_text_all_w_t_and_m_t":"4>else:","paragraph_zero_based":2085},{"literal_text_all_w_t_and_m_t":"5>for the newest entry of the PCell in the mobilityHistoryReport, include a new entry in the visitedPSCellInfoListReport, possibly after removing the oldest PSCell entry of a PCell in the mobilityHistoryReport, if required, and set its fields as follows:","paragraph_zero_based":2086},{"literal_text_all_w_t_and_m_t":"6>set field timeSpent to the time spent without PSCell in the current PCell since last PSCell release since connected to the current PCell in RRC_CONNECTED;","paragraph_zero_based":2087}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["9067eb6edf13d7f3112cd381a2ebb78d3b4863404b91216884b10f759f2d149a","3267f28e1aefd3cb2156ae718cd69627112d50efd8ca7d861dc6ec5ab685b0ef","6ed4ec6d1fb4011183e3d8aa15270f42bc120f305edd0ff6232cf16398b566b0","813e93f60d2bad0afe653259064c10edde11066d203b892c8290c5d85b12f0fa","2bdb0b2d078b2c88e24495cdc39f64d4f8083dc4fb45611688221ddc4bffb3a5","c6fd8e69c0feaa91c80557ccee05fb27e1a2741dd9a5fdd9f7dfe2d320faa84a","00a018fa3f1ef6fd046eb08ca0939c8d844d30fb059083795018c86ce39b640d","df9a4952abf2f7ae8f4062cb5e3aaacac333b9acc0e8d5cc3c2f0e08f7fd3fc1","98f6d874755cb2160b767477949313c7305268e10214035735f783155b45595d","fe225ed909f3911fc33fb2de81d3d734a8172373168d317f6cef282bb61a39a2","1a5c63fb223f9d8ee5c8f7d4c112acb3e758bf18690a0a566a93eddb916b1cf0","fc8d277de74359284e1b5eea76398cf42f75469b7bb1353720cac265860991e7","cb2715ae077327488865894323a978c88bc567b5083a7f4655fcd5ac0f91c8b5","3ae3307a267511f997250267f5ba448e0927f5bcf9424ae516dfe254643a80a1","920180b7cf059f8bfbbf0cf0fee189686ccd1e62aa26a14988d55ab251afb3e2","1331bceb5e0477a614bc9bbad276f30445595858f718bb6084f9eaf8ab566d4e","e60908cb6e6b386d2265bb32b209be0bcf00023556ace20a4b53abceddcab6c2","ddbb724e9a750404b794748e3ceef72d86745c2060297872d4a959de096f1042","2d85288c709ead3fd2006a01f44048ed8219eb5a662ec431ca43054c5196f454","3b848de4df8b86b89ea3d6790b6a26cb2af4b3430c3de4151f645e9785e4f3d0","24f1a24ac874bb6116b28a0038f018b849508d633b5a631c3b3b18ac49f75f77","90d3d33adc6fd86a968c2b7a7e49c69d9a0ae904526624a23a7588386b8166af","f783ba782239f8312d3cde5264c8067ed7d3a74e1f2a127fb8e20bf16a84a294","00913ee916bd3c481fbca7134c0a1a5164e21228ed9cd96d1664acc5cec44cda"],"paragraph_range_zero_based":[2064,2087],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx:p2064"}
{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>else if the UE supports PSCell mobility history information:","paragraph_zero_based":2088},{"literal_text_all_w_t_and_m_t":"4>if the UE is configured with a PSCell:","paragraph_zero_based":2089},{"literal_text_all_w_t_and_m_t":"5>for the newest entry of the PCell in the mobilityHistoryReport, include the current PSCell information in the visitedPSCellInfoListReport, possibly after removing the oldest PSCell entry of a PCell in the mobilityHistoryReport, if required, and set its fields as follows:","paragraph_zero_based":2090},{"literal_text_all_w_t_and_m_t":"6>set visitedCellId to the global cell identity or the physical cell identity and carrier frequency of the current PSCell:","paragraph_zero_based":2091},{"literal_text_all_w_t_and_m_t":"6>set field timeSpent to the time spent in the current PSCell while being connected to the current PCell;","paragraph_zero_based":2092},{"literal_text_all_w_t_and_m_t":"6>if the UE supports storing and reporting SCG activation information in mobility history information:","paragraph_zero_based":2093},{"literal_text_all_w_t_and_m_t":"7>set the field scgActiveDuration of the entry to the accumulated time spent in the current PSCell with SCG state set to activated while being connected to the current PCell, if available;","paragraph_zero_based":2094},{"literal_text_all_w_t_and_m_t":"4>else:","paragraph_zero_based":2095},{"literal_text_all_w_t_and_m_t":"5>for the newest entry of the PCell in the mobilityHistoryReport, include a new entry in the visitedPSCellInfoListReport, possibly after removing the oldest PSCell entry of a PCell in the mobilityHistoryReport, if required, and set its fields as follows:","paragraph_zero_based":2096},{"literal_text_all_w_t_and_m_t":"6>set field timeSpent to the time spent without PSCell in the current PCell since connected to the current PCell in RRC_CONNECTED;","paragraph_zero_based":2097},{"literal_text_all_w_t_and_m_t":"1>if the successHO-ReportReq is set to true and if the UE has successful handover related information available in VarSuccessHO-Report and if the RPLMN is included in the plmn-IdentityList stored in VarSuccessHO-Report; or","paragraph_zero_based":2098},{"literal_text_all_w_t_and_m_t":"1>if the successHO-ReportReq is set to true and if the UE has successful handover related information available in VarSuccessHO-Report and if the current registered SNPN identity is included in snpn-IdentityList if stored in the VarSuccessHO-Report:","paragraph_zero_based":2099},{"literal_text_all_w_t_and_m_t":"2>if the successHO-Report in the VarSuccessHO-Report concerns a DAPS handover and if a PDCP PDU has been received from the source cell of the concerned HO and a non-duplicated PDCP PDU has been received from the target cell of the concerned HO:","paragraph_zero_based":2100},{"literal_text_all_w_t_and_m_t":"3>set upInterruptionTimeAtHO in VarSuccessHO-Report to include the time elapsed between the time of arrival of the last PDCP PDU received from the source cell of the concerned handover and the time of arrival of the first non-duplicate PDCP PDU received from the target cell of the concerned handover, as measured at the time of arrival of the first non-duplicate PDCP PDU received from the target cell;","paragraph_zero_based":2101},{"literal_text_all_w_t_and_m_t":"2>if the successHO-Report in the VarSuccessHO-Report concerns a mobilityFromNRCommand:","paragraph_zero_based":2102},{"literal_text_all_w_t_and_m_t":"3>set timeSinceSHR in VarSuccessHO-Report to the time that elapsed since the execution of the MobilityFromNRCommand associated to the successful handover report in the VarSuccessHO-Report;","paragraph_zero_based":2103},{"literal_text_all_w_t_and_m_t":"2>set the successHO-Report in the UEInformationResponse message to the value of successHO-Report in the VarSuccessHO-Report, if available;","paragraph_zero_based":2104},{"literal_text_all_w_t_and_m_t":"2>discard the VarSuccessHO-Report upon successful delivery of the UEInformationResponse message confirmed by lower layers;","paragraph_zero_based":2105},{"literal_text_all_w_t_and_m_t":"1>if the successPSCell-ReportReq is set to true and if the UE has successful PSCell change or addition information available in VarSuccessPSCell-Report and if the RPLMN is included in plmn-IdentityList stored in VarSuccessPSCell-Report; or","paragraph_zero_based":2106},{"literal_text_all_w_t_and_m_t":"1>if the successPSCell-ReportReq is set to true and if the UE has successful PSCell change or addition information available in VarSuccessPSCell-Report and if the current registered SNPN identity is included in snpn-IdentityList if stored in the VarSuccessPSCell-Report:","paragraph_zero_based":2107},{"literal_text_all_w_t_and_m_t":"2>set the successPSCell-Report in the UEInformationResponse message to the value of successPSCell-Report in the VarSuccessPSCell-Report;","paragraph_zero_based":2108},{"literal_text_all_w_t_and_m_t":"2>discard the VarSuccessPSCell-Report upon successful delivery of the UEInformationResponse message confirmed by lower layers;","paragraph_zero_based":2109},{"literal_text_all_w_t_and_m_t":"1>if the coarseLocationRequest is set to true:","paragraph_zero_based":2110},{"literal_text_all_w_t_and_m_t":"2>include coarseLocationInfo, if available;","paragraph_zero_based":2111}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["629de2027c783f8b5ed72f2999e5368e5ee93c0cf1a4646e55cdbbd5798c6294","a8140fac45bb946020a5b138caa23fc34805b5949ac4e4c38a9697ad49b5d7f4","87630ebd020c2692e574f5965b8a0e39a30dbe079ad3a001f728f4831d2645e1","3266cab4fe0d7b65c0531e3e70f7de531141ebeaee118d872d2e95b2d0f31fb4","29750b34c207dddc566c92f3d4766b1a270beabaf509053d29b1c930934d3dd9","efeac9a871c337cae2f1c27612bfb7baf4ac1a32da9277716b57404ebedb38aa","66dc25329c08be16790c02595845c5a6e72c1443eccc61d557d96721f17b06d0","76085bb7a967011493e0475b5eeea57140c1aaf0f39d95694333896f696ee51a","49df4c66c149f8336029cd25a6bd3ae4858c635089cbd06af66dc5317e1e98fa","fc5190d45ec2f5282965a4608ed013f3c554db84818466723d7d1bea036b2cb6","0bc029efc01161df918189ad4042055e5a39e7b6d0d53c05614098917cdaf30a","923f7c99b6955b269707175f1ec7ae639f7c64400d9e0a0b9af883428c5ac8dd","28560ce9b2254541762146529876c5c2a43731001bb19332afa1e5351b6eeb42","3da700a6eedbd559bc81257f959dfb5e9bb8042465ca56f5a8e598c20d3f3cda","1ee3f66d14e4ada45ad304e391e04a84cb7aaa83641531eb306cfa03518c247f","4705d3e1dd90e57742862491f4ff3cd5dcd26b5828f7cdb54d18b5441016d31e","aa931bb425e902c4ac7872ff7cb461536aabd07d00fed4def784becea7df2eb6","c4f4995effa5a6094ea983b9c17ee3daf2efab5a9633fa7cbc5771e5b6424204","7ea84676a44f23da2360612855fbca4587faacfb4844a48b04e59712c192f56b","f1fb6f60c47155bfcf97c021fbc26a13a960892571dcb8b6480bb2d1dcf6c4d4","55e9a16613c0034986544fd59266bdf69635626c732b09604ada316bd3799241","0c5912dac946dfc53f45a4bd3455feff105f9e39ad697f6f77e8e9293b275a9c","0109a7d49f439bda0d454a8ed90ac0bbca0a94d9ea5e2e5e80744243cea5cd6b","4e378e6836f3248d0e682dad8fdc25d7b307604e00fa93403600c8a3b0591cce"],"paragraph_range_zero_based":[2088,2111],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx:p2088"}
{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>if the flightPathInfoReq is included in the UEInformationRequest and the UE has (updated) flight path information available, set the flightPathInfoReport in the UEInformationResponse message as follows:","paragraph_zero_based":2112},{"literal_text_all_w_t_and_m_t":"2>include the list of up to maxWayPointNumber waypoints, if any, along the flight path;","paragraph_zero_based":2113},{"literal_text_all_w_t_and_m_t":"2>if the includeTimeStamp is set to true, for each included waypoint:","paragraph_zero_based":2114},{"literal_text_all_w_t_and_m_t":"3>if available, set the field timestamp to the time when UE intends to arrive at the waypoint;","paragraph_zero_based":2115},{"literal_text_all_w_t_and_m_t":"1>if the csi-LogMeasReportReq is present:","paragraph_zero_based":2116},{"literal_text_all_w_t_and_m_t":"2>if VarCSI-LogMeasReport includes one or more logged measurement entries, set the contents of the csi-LogMeasReport in the UEInformationResponse message as follows:","paragraph_zero_based":2117},{"literal_text_all_w_t_and_m_t":"3>include the csi-LogMeasInfoCellList and set it to include one or more entries from the VarCSI-LogMeasReport starting from the entries logged first;","paragraph_zero_based":2118},{"literal_text_all_w_t_and_m_t":"3>if the VarCSI-LogMeasReport includes one or more additional logged measurement entries that are not included within the UEInformationResponse message:","paragraph_zero_based":2119},{"literal_text_all_w_t_and_m_t":"4>include the csi-MoreLogMeasAvailable;","paragraph_zero_based":2120},{"literal_text_all_w_t_and_m_t":"1>if the logMeasReport is included in the UEInformationResponse:","paragraph_zero_based":2121},{"literal_text_all_w_t_and_m_t":"2>submit the UEInformationResponse message to lower layers for transmission via SRB2;","paragraph_zero_based":2122},{"literal_text_all_w_t_and_m_t":"2>discard the logged measurement entries included in the logMeasInfoList from VarLogMeasReport upon successful delivery of the UEInformationResponse message confirmed by lower layers;","paragraph_zero_based":2123},{"literal_text_all_w_t_and_m_t":"1>else if csi-LogMeasReport is included in the UEInformationResponse:","paragraph_zero_based":2124},{"literal_text_all_w_t_and_m_t":"2>submit the UEInformationResponse message to lower layers for transmission via SRB6;","paragraph_zero_based":2125},{"literal_text_all_w_t_and_m_t":"2>discard the logged measurement entries included in the csi-LogMeasInfoList from VarCSI-LogMeasReport and discard the entries in csi-LogMeasInfoConfigList if the corresponding csi-LogMeasInfoList is empty and the entries in csi-LogMeasInfoCellList if the corresponding csi-LogMeasInfoConfigList is empty upon successful delivery of the UEInformationResponse message confirmed by lower layers;","paragraph_zero_based":2126},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":2127},{"literal_text_all_w_t_and_m_t":"2>submit the UEInformationResponse message to lower layers for transmission via SRB1.","paragraph_zero_based":2128},{"literal_text_all_w_t_and_m_t":"NOTE:It is up to the network to ensure that logged data based on logMeasReportReq and csi-LogMeasReportReq are not requested in the same message.","paragraph_zero_based":2129},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2130},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2131},{"literal_text_all_w_t_and_m_t":"NEXT CHANGE","paragraph_zero_based":2132},{"literal_text_all_w_t_and_m_t":"6.2.2Message definitions","paragraph_zero_based":2133},{"literal_text_all_w_t_and_m_t":"<Text Omitted>","paragraph_zero_based":2134},{"literal_text_all_w_t_and_m_t":"–RRCReconfiguration","paragraph_zero_based":2135}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["90abf25d54e4bd551dc283a389ff33b0cca515fa4ab3291ddb9d682b14c82f8c","18322086e368a3955fb94622f77357f51fb78951cf6bc145a28daf83e04c4a5f","4bfefb7052ac952d8ccf191998f855c21bfc396b8863065a95ff37b157b04879","b8669fc586a8998f1b5988932d8abd1db00abcf9716b7efd846b6aa19fc18801","dbbd2e17dadca4026debc83bc3ecaeb703e698cf3b04dc8a2db8c1771caeed61","ff647a69ce9a856e74b3189c29d6089392276fea0efbdb53a3449ce797673ab8","708bd9a35a9ddc9884b6455f4a7979e08f6b67ab89ec94d575f164b36857512c","93c846e3fd3b04672fb739d86e7af1fb4e5ea125d3dc226b7f15871c179345c7","a7026b5410306aa2529612c49b5cea66bbecb425838aef6d35891e5fa4fc2322","ac29076eb674cfdf6817653a747468cd80e8fe20ce53c8fc7e6fc4a16039911c","f1ef00709644e3045b9cab3381f8a0c7ecac3445fc368649fcdf9a46bfdfd403","d3a824aa86e8c091b73c69825312b7391f6679532cbce45d20cb4f667ec40ed4","b1cc037acd56f580d93a7cdd13b184f1e5aa05234092a8427d6e3f89f8cc5729","33add68a2c60627b5ace478aca65b175897b47ba146724fbcebbce23240cabdc","3a3038879a52755638497124c1bc134772b4d1b36e2c207c6fc5548289c5a23f","92b190700da072d74fda7a3fe658b1f9f339285e9f725988de2ba51a87d6ed10","fe1a2307a3098d2fb58cd789ae3f4723e7d3e05017c8bf9123c7512f0cf679f3","003b59dd3437ced55729a87bd350daf0afaef31b77bcd51ff799fa15712d85b6","f1b457098e39745355ed87a2b451d5b6a1a1f63db1dc2f31b67b28de500c7c08","7ffb5f2d7dbbfd90c30bcd0bbc663bb31cb38c6654ffbb8a109c19bc438124b9","3cd69d8a7bd3ad87f2c013cd4dcd4c7f172947bbe7c6fd782ccc2eb63ea8fe57","1fa6a9617c8d6ca53b7b0a8c4a1752c8b85cdfab36a2073b598966b73894a7cb","276ea05ba2e230ee8d5b6e0e7a3e01a0f8550ab2ad331e588eef7eff6291dbc2","a4c6f7e801730fe0601cb6a6ea365b3fd7933f1e77de4c3ced7cc15805fdf2fa"],"paragraph_range_zero_based":[2112,2135],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx:p2112"}
{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The RRCReconfiguration message is the command to modify an RRC connection. It may convey information for measurement configuration, mobility control, radio resource configuration (including RBs, MAC main configuration and physical channel configuration) and AS security configuration.","paragraph_zero_based":2136},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1 or SRB3","paragraph_zero_based":2137},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":2138},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":2139},{"literal_text_all_w_t_and_m_t":"Direction: Network to UE","paragraph_zero_based":2140},{"literal_text_all_w_t_and_m_t":"RRCReconfiguration message","paragraph_zero_based":2141},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":2142},{"literal_text_all_w_t_and_m_t":"-- TAG-RRCRECONFIGURATION-START","paragraph_zero_based":2143},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2144},{"literal_text_all_w_t_and_m_t":"RRCReconfiguration ::=                  SEQUENCE {","paragraph_zero_based":2145},{"literal_text_all_w_t_and_m_t":"    rrc-TransactionIdentifier               RRC-TransactionIdentifier,","paragraph_zero_based":2146},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                      CHOICE {","paragraph_zero_based":2147},{"literal_text_all_w_t_and_m_t":"        rrcReconfiguration                      RRCReconfiguration-IEs,","paragraph_zero_based":2148},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture                SEQUENCE {}","paragraph_zero_based":2149},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":2150},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2151},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2152},{"literal_text_all_w_t_and_m_t":"RRCReconfiguration-IEs ::=              SEQUENCE {","paragraph_zero_based":2153},{"literal_text_all_w_t_and_m_t":"    radioBearerConfig                       RadioBearerConfig                                                      OPTIONAL, -- Need M","paragraph_zero_based":2154},{"literal_text_all_w_t_and_m_t":"    secondaryCellGroup                      OCTET STRING (CONTAINING CellGroupConfig)                              OPTIONAL, -- Cond SCG","paragraph_zero_based":2155},{"literal_text_all_w_t_and_m_t":"    measConfig                              MeasConfig                                                             OPTIONAL, -- Need M","paragraph_zero_based":2156},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension                OCTET STRING (CONTAINING RRCReconfiguration-v15t0-IEs)                 OPTIONAL,","paragraph_zero_based":2157},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                    RRCReconfiguration-v1530-IEs                                           OPTIONAL","paragraph_zero_based":2158},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2159}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["8d215d574cc1e0dca806b106d795e201488f0c1392a180d39e7aa485cd0244e3","39cc810d3605498e72d2372e3a4a90c7d92c63e77b72e1e2cf41803af0935988","e4ecbef0f58f37253068bff4fede477aa3ec9b19aa81761946860fdd72351103","e46416ec79991132c082d467711edcfc06181c627cc7d95622dc4f3a2286c2be","8816aba5af26fe8c770fc90853ecdfdde7ea36ee4af73ca253053e4618f4116e","7e7d46890a22f8bdcb774d477b2d1471508d32ca45e4eba8b96593b1dee57bc9","dcbd51b18faf86b03bd94d2cc45ae1c25e4e28a8a19e21b8f87564d43e2cb17d