{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"6.3.2Radio resource control information elements","paragraph_zero_based":3960},{"literal_text_all_w_t_and_m_t":"<Text Omitted>","paragraph_zero_based":3961},{"literal_text_all_w_t_and_m_t":"–ApplicabilitySetConfigId","paragraph_zero_based":3962},{"literal_text_all_w_t_and_m_t":"The IE ApplicabilitySetConfigId is used to identify an ApplicabilitySetCSI-Config.","paragraph_zero_based":3963},{"literal_text_all_w_t_and_m_t":"ApplicabilitySetConfigId information element","paragraph_zero_based":3964},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":3965},{"literal_text_all_w_t_and_m_t":"-- TAG-APPLICABILITYSETCONFIGID-START","paragraph_zero_based":3966},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3967},{"literal_text_all_w_t_and_m_t":"ApplicabilitySetConfigId-r19 ::=            INTEGER (0..maxNrofApplicabilitySetCSI-Configs-1-r19)","paragraph_zero_based":3968},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3969},{"literal_text_all_w_t_and_m_t":"-- TAG-APPLICABILITYSETCONFIGID-STOP","paragraph_zero_based":3970},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":3971},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3972},{"literal_text_all_w_t_and_m_t":"–ApplicabilityReportList","paragraph_zero_based":3973},{"literal_text_all_w_t_and_m_t":"The IE ApplicabilityReportList comprises information that the UE reports to gNB related to the applicability of configurations subject to the applicability determination procedure.","paragraph_zero_based":3974},{"literal_text_all_w_t_and_m_t":"ApplicabilityReportList information element","paragraph_zero_based":3975},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":3976},{"literal_text_all_w_t_and_m_t":"-- TAG-APPLICABILITYREPORT