{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ntn-TimeBasedMeasTrigger","paragraph_zero_based":4296},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE supports time-based measurement trigger in RRC_CONNECTED.","paragraph_zero_based":4297},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4298},{"literal_text_all_w_t_and_m_t":"ntn-Triggered-GNSS-Fix","paragraph_zero_based":4299},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE supports network triggered GNSS position fix in RRC_CONNECTED. ","paragraph_zero_based":4300},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4301},{"literal_text_all_w_t_and_m_t":"ntn-UplinkHarq-ModeB-MultiTB","paragraph_zero_based":4302},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE supports HARQ Mode B when scheduled with uplink transmission of multiple TBs. For BL UE or UE in CE, this field also indicates whether the UE supports the corresponding LCP restrictions for uplink transmission.","paragraph_zero_based":4303},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4304},{"literal_text_all_w_t_and_m_t":"ntn-UplinkHarq-ModeB-SingleTB","paragraph_zero_based":4305},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE supports HARQ Mode B. For BL UE or UE in CE, this field also indicates whether the UE supports the corresponding LCP restrictions for uplink transmission.","paragraph_zero_based":4306},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4307},{"literal_text_all_w_t_and_m_t":"ntn-UplinkTxExtension","paragraph_zero_based":4308},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE supports to perform UL transmission in a duration after original GNSS validity duration expires without GNSS re-acquisition.","paragraph_zero_based":4309},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":4310},{"literal_text_all_w_t_and_m_t":"numberOfBlindDecodesUSS","paragraph_zero_based":4311},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of blind decodes in UE specific search space in one subframe for CCs configured with sTTI operation supported by the UE. The number of blind decodes supported by the UE is the field value X*68. Field value ranges from 4 to 32.","paragraph_zero_based":4312},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4313},{"literal_text_all_w_t_and_m_t":"nzp-CSI-RS-AperiodicInfo","paragraph_zero_based":4314},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports aperiodic NZP CSI-RS transmission for the indicated transmission mode.","paragraph_zero_based":4315},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4316},{"literal_text_all_w_t_and_m_t":"nzp-CSI-RS-PeriodicInfo","paragraph_zero_based":4317},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports periodic NZP CSI-RS transmission for the indicated transmission mode.","paragraph_zero_based":4318},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":4319}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bba13f43bf9f9da1510e8bdb4b93207d82d3fbb590e153518aea1c934313854c","original_member_sha256":"d5729ee741f893aa83122cf8a780d8f66a4f43b530a05b8ace1245a510abed95","paragraph_ElementTree_utf8_XML_sha256":["892e39f7a5e5a90782e0e6cf8744cd96421914e1f5b8ec628321bbcde059d0fa","4e43a217ee6fab0430e38e6218870b1a067f7a7e1fea89868fb561919acddbbd","d1d63b6e996966baec9d155781ca9fb3de10fa9d78d23533523e967d3ac4b38f","f8fc8f5db272dec47f722ff2e08545f795fbfad86b108804e1f80562261f1ae6","dc770c16b054cd4a40d5119dd3bf8bb17fbe13dee4084998b8fcf107409474a1","9ebff1f719d71f876f2d2a1aa2c10ac17f182daf1be6c12fe9027d2af9267cda","5980b0d3f2aa3a9bffd463e2b2a131de449c5306b76a198ddca5ef754fcd47be","48d2fab90ecea876