{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":480},{"literal_text_all_w_t_and_m_t":"4>if the RRCReconfiguration does not include the mrdc-SecondaryCellGroupConfig:","paragraph_zero_based":481},{"literal_text_all_w_t_and_m_t":"5>if the RRCReconfiguration includes the scg-State:","paragraph_zero_based":482},{"literal_text_all_w_t_and_m_t":"6>perform SCG deactivation as specified in 5.3.5.13b;","paragraph_zero_based":483},{"literal_text_all_w_t_and_m_t":"4>submit the RRCReconfigurationComplete message via SRB1 to lower layers for transmission using the new configuration;","paragraph_zero_based":484},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":485},{"literal_text_all_w_t_and_m_t":"3>if the RRCReconfiguration includes the reconfigurationWithSync in spCellConfig for the SCG; and","paragraph_zero_based":486},{"literal_text_all_w_t_and_m_t":"3>if the UE was configured with successPSCell-Config when connected to the source PSCell (for PSCell change):","paragraph_zero_based":487},{"literal_text_all_w_t_and_m_t":"4>perform the actions for the successful PSCell change report determination as specified in clause 5.7.10.7, upon successfully completing the Random Access procedure triggered for the reconfigurationWithSync in spCellConfig of the SCG;","paragraph_zero_based":488},{"literal_text_all_w_t_and_m_t":"3>if the UE has successful PSCell change or addition information available in VarSuccessPSCell-Report and if the RPLMN is included in plmn-IdentityList stored in VarSuccessPSCell-Report; or","paragraph_zero_based":489},{"literal_text_all_w_t_and_m_t":"3>if the UE has successful PSCell change or addition information available in VarSuccessPSCell-Report and if the current registered SNPN identity is included in snpn-IdentityList stored in the VarSuccessPSCell-Report:","paragraph_zero_based":490},{"literal_text_all_w_t_and_m_t":"4>include successPSCell-InfoAvailable in the RRCReconfigurationComplete message;","paragraph_zero_based":491},{"literal_text_all_w_t_and_m_t":"3>submit the RRCReconfigurationComplete message via SRB3 to lower layers for transmission using the new configuration;","paragraph_zero_based":492},{"literal_text_all_w_t_and_m_t":"1>else (RRCReconfiguration was received via SRB1):","paragraph_zero_based":493},{"literal_text_all_w_t_and_m_t":"2>if the UE is in NR-DC and;","paragraph_zero_based":494},{"literal_text_all_w_t_and_m_t":"2>if the RRCReconfiguration does not include the mrdc-SecondaryCellGroupConfig:","paragraph_zero_based":495},{"literal_text_all_w_t_and_m_t":"3>if the RRCReconfiguration includes the scg-State:","paragraph_zero_based":496},{"literal_text_all_w_t_and_m_t":"4>perform SCG deactivation as specified in 5.3.5.13b;","paragraph_zero_based":497},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":498},{"literal_text_all_w_t_and_m_t":"4>perform SCG activation without SN message as specified in 5.3.5.13b1;","paragraph_zero_based":499},{"literal_text_all_w_t_and_m_t":"2>if the reconfigurationWithSync was included in spCellConfig of an MCG:","paragraph_zero_based":500},{"literal_text_all_w_t_and_m_t":"3>if ta-Report or ta-ReportATG is configured with value enabled and the UE supports TA reporting:","paragraph_zero_based":501},{"literal_text_all_w_t_and_m_t":"4>indicate TA report initiation to lower layers;","paragraph_zero_based":502},{"literal_text_all_w_t_and_m_t":"2>submit the RRCReconfigurationComplete message via SRB1 to lower layers for transmission using the new configuration;","paragraph_zero_based":503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba9