{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Identity of the QoS flow to which this UL traffic information refers.","paragraph_zero_based":3120},{"literal_text_all_w_t_and_m_t":"trafficPeriodicity","paragraph_zero_based":3121},{"literal_text_all_w_t_and_m_t":"Indicates the average time period between the start times of two data bursts, expressed in the number of microseconds.","paragraph_zero_based":3122},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3123},{"literal_text_all_w_t_and_m_t":"GapOccasionCancelRatio field descriptions","paragraph_zero_based":3124},{"literal_text_all_w_t_and_m_t":"fr1, fr2","paragraph_zero_based":3125},{"literal_text_all_w_t_and_m_t":"Includes the UE's preference for gap occasion cancellation ratio for the configured per FR measurement gap under measGapConfig.","paragraph_zero_based":3126},{"literal_text_all_w_t_and_m_t":"gapConfigRatioList","paragraph_zero_based":3127},{"literal_text_all_w_t_and_m_t":"Includes the UE's preference for gap occasion cancellation ratio for the configured measurement gap with measGapId in gapToAddModList under measGapConfig.","paragraph_zero_based":3128},{"literal_text_all_w_t_and_m_t":"perUE","paragraph_zero_based":3129},{"literal_text_all_w_t_and_m_t":"Includes the UE's perference for gap occasion cancellation ratio for the configured per UE measurement gap under measGapConfig.","paragraph_zero_based":3130},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3131},{"literal_text_all_w_t_and_m_t":"<Text Omitted>","paragraph_zero_based":3132},{"literal_text_all_w_t_and_m_t":"–UEInformationResponse","paragraph_zero_based":3133},{"literal_text_all_w_t_and_m_t":"The UEInformationResponse message is used by the UE to transfer information requested by the network.","paragraph_zero_based":3134},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1 or SRB2 (when logged measurement information is included) or SRB6 (when logged measurement information for network-side data collection is included)","paragraph_zero_based":3135},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":3136},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":3137},{"literal_text_all_w_t_and_m_t":"Direction: UE to network","paragraph_zero_based":3138},{"literal_text_all_w_t_and_m_t":"UEInformationResponse message","paragraph_zero_based":3139},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":3140},{"literal_text_all_w_t_and_m_t":"-- TAG-UEINFORMATIONRESPONSE-START","paragraph_zero_based":3141},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3142},{"literal_text_all_w_t_and_m_t":"UEInformationResponse-r16 ::=        SEQUENCE {","paragraph_zero_based":3143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["ae30f720e2b561a647745f195b16a4ee822b34c58b73dfc794481e8c1629aa7a","45cff23c42204f36608ab7eb51c55bc291d3e8eabc435398eff1c8d8dd15c43e","7d3ddfbbffb9f32b51bb8dc83586a008bd0c18b84b029b7b8091ec231c2745cc","94e7495124a560c9676cf9368cc672b07fb88e9e790c59b6d7d5088530322ddc","130e442a0399b8f5714fa45a4a5833dfbaf0bf473b8d2cb401235f6c5e6827f5","4174ec121bf746bb03e42f06fcb4817aa7ec9e5d6fbf313fa5fe6ffb720a7dcf","73ace82ba01da93c4ed35dddd9c4f97ff387fca7cc5efeed29d04b0703306cb2","4c40546f8fa11f4f9e3cf80299951bdb28b186c1ccef1d5ab5ce884afd4e56ea","be2a2bb639e8043a13eea6f8aeae8f92dd31e330eb6b0d7adf193e8f4f754517","b1ec7295f202f76d17784486d30c1344d176f538fbe3f6ed32a9979266d62795","f5330d962f4a5f402343206fd76f3c80ddb1a844f00febaa3f2f789e1b21ede7","9a55f25