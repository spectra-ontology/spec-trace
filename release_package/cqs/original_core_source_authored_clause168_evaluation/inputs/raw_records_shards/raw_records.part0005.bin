{"fields":{"filename":"R2-2408214.zip::R2-2408214 Correction on UE capability of supporting NavIC in A-GNSS positioning (R17).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"If the target device supports Galileo and GNSS-UTC-Model assistance, it shall support Model-1.","paragraph_zero_based":216},{"literal_text_all_w_t_and_m_t":"If the target device supports GLONASS and GNSS-UTC-Model assistance, it shall support Model-3.","paragraph_zero_based":217},{"literal_text_all_w_t_and_m_t":"If the target device supports BDS and GNSS-UTC-Model assistance, it shall support Model-5.","paragraph_zero_based":218},{"literal_text_all_w_t_and_m_t":"If the target device supports NavIC and GNSS-UTC-Model assistance, it shall support Model-2.","paragraph_zero_based":219},{"literal_text_all_w_t_and_m_t":"If this field is absent, the target device supports the mandatory (native) utc-Model choice only as listed above for the GNSS indicated by GNSSID.","paragraph_zero_based":220},{"literal_text_all_w_t_and_m_t":" ","paragraph_zero_based":221},{"literal_text_all_w_t_and_m_t":"END OF CHANGE","paragraph_zero_based":222},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":223}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e51c2517ccef31616c1373519700b9598c20468e8d5224cbb63673246fdebcc3","original_member_sha256":"11e2ab804fb64d6fce64573faf419b8f335f0b1fa79af34934bcd97c1b0d748e","paragraph_ElementTree_utf8_XML_sha256":["5e9cb50cdab355e004e2dd47720a942e78963ee7534e34d629d00befc6e9e775","2bb4bb59c62d8e288dd10f8c2c73788a8f3ecb041eca9474e6c21116f1ead19e","02237062c073a1627a6be61d50cc24425993a9497d73953f0cc2020d6182e1f7","9db22977175cd64da9e222a67676bfe2c5940c6963c1781c75295fcab233af52","bbc2477dd92ee7983f371e4d540e8ad616dbbe5540adbd0fcb0d56bdc7d58581","3b977387136dca508c725c82b9e436191131a95c4ffc6e854ea3be