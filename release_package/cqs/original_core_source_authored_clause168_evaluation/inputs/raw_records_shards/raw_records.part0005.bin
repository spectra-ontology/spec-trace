h_zero_based":23}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"41a1ff81388387a5840b779624d83c32dbf97e216bde6857a4a94b36bf2e7ed3","original_member_sha256":"76d9499cd89b5d67bda3f2c6d77e6ed77abe885ef392336920340be1e0d2c1cd","paragraph_ElementTree_utf8_XML_sha256":["c557aa41f67388119d812f243772264f9ece18066e86387673edc1df3a99ade1","bd6ccf0d417bafca21035b99cbf71790beae30a2f49bb41cafa55aff7648c555","1018851582733cee7bdf7ab6b4f2f089a8194ce1225ae4f71fe2429f5f30321a","6dfce24ce6b3202c1c4b0f0675af43a9c9a17432a0b3644ace01b3a914cbafb1","f27cd16e2caccc3e3121f94dfaf6ec1451f91a6b1bb0fcdf8a557a29b5de976b","5072ceeb345e27990ac2c2cd4e2e1ecfc4cc5ae3579a63b8978bff0f47c8577b","4be4ee75461bd268f9d94325c16cb191b85b0187f46c97ba56ac83d03ce4dd17","089bcc6da8d0f0c4f3e66910614bde0bf58f845768b1e84631b6d7aed9d2d644","3e8cb3f65fa5aa8889fffe8c771537b46a816bc137b29da176282598598e3e77","fc36eacf0b5a54855e27a5f64d903bbb6db148a23c21c4a50c934abb35d0caa6","830597086b36dea9dbfa30c3b7e16f75451796b505bb1cb7c5f15cfc0460582d","8d7a15acb12397d03a37ce914d76ac927dd1e9d336d9e10d49285df01fbe020d","5e8459d63dfd9b0641d39dcaa7b05889f53ee78617959d71d2300cada8bcee0f","8e4181667b77ff6366a9b06d9f216121f74ab0fffc0e19991b8fc6bfc385af43","48a757101796c3a3fa8109ef5b17c4a7b1a1b33ed42597ac67c89fdfa250b33f","0876e10bb92ed6ad2787ab1a089d5cb3433139dd58172786824e34de1b78ef02","2a447f4e45814a3483391fd58f79277d5a1e272276e7632e0946b46d3639a8ed","c51b681c6900c4fff6c188543cc6ba2aebf271b590ed6bd1bc0d15235214a5a9","f53826574b5ea9756228872e9a032bb4430e94c91feaae4fd0dbde89dd84185a","b068b6201a99522b7aca74ec8daa5ed2c23adb20520ff7d987a4321838eb5bb3","9686fc3b2b9969f6674c9002a3d13822329fd8285e163ea12991b9234f1425d5","7a74d8e42f87c13e0e2c2bb2c3d078730cc1c3c3cceb4202235da1cbbbba9d1c","f39349dc5af107b67a59528e39aa3230f7a501a95076c2fa946f955e7ed37e08","6cfb60539a8d0176f1afae3ac7eb47e59dd4a65d80ae009be39a2389cec06de0"],"paragraph_range_zer