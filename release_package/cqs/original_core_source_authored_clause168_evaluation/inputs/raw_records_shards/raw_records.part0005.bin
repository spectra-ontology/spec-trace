{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"obtainCommonLocation","paragraph_zero_based":5424},{"literal_text_all_w_t_and_m_t":"Requests the UE to attempt to have detailed location information available using GNSS. NR configures the field if includeCommonLocationInfo is configured for one or more measurements.","paragraph_zero_based":5425},{"literal_text_all_w_t_and_m_t":"overheatingAssistanceConfig","paragraph_zero_based":5426},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about UE detected internal overheating.","paragraph_zero_based":5427},{"literal_text_all_w_t_and_m_t":"overheatingIndicationProhibitTimer","paragraph_zero_based":5428},{"literal_text_all_w_t_and_m_t":"Prohibit timer for overheating assistance information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":5429},{"literal_text_all_w_t_and_m_t":"pdu-SessionsToReportUL-TrafficInfoList","paragraph_zero_based":5430},{"literal_text_all_w_t_and_m_t":"A list of PDU sessions for which the UE shall report UL traffic information.","paragraph_zero_based":5431},{"literal_text_all_w_t_and_m_t":"propDelayDiffReportConfig","paragraph_zero_based":5432},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report service link propagation delay difference between serving cell and neighbour cell(s).","paragraph_zero_based":5433},{"literal_text_all_w_t_and_m_t":"qfi-ToReportUL-TrafficInfoList","paragraph_zero_based":5434},{"literal_text_all_w_t_and_m_t":"A list of QFIs of a PDU session for which the UE shall report UL traffic information.","paragraph_zero_based":5435},{"literal_text_all_w_t_and_m_t":"referenceTimePreferenceReporting","paragraph_zero_based":5436},{"literal_text_all_w_t_and_m_t":"If present, the field indicates the UE is configured to provide reference time assistance information.","paragraph_zero_based":5437},{"literal_text_all_w_t_and_m_t":"refLocList","paragraph_zero_based":5438},{"literal_text_all_w_t_and_m_t":"A list of reference locations for assisted SMTC configuration in RRC_CONNECTED state. If this field is absent when closestLocsToReport is signalled, the UE shall use the refLocList associated to smtc5list provided in SIB2, if available.","paragraph_zero_based":5439},{"literal_text_all_w_t_and_m_t":"releasePreferenceConfig","paragraph_zero_based":5440},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preference to leave RRC_CONNECTED state.","paragraph_zero_based":5441},{"literal_text_all_w_t_and_m_t":"releasePreferenceProhibitTimer","paragraph_zero_based":5442},{"literal_text_all_w_t_and_m_t":"Prohibit timer for release preference assistance information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on. Value infinity means that once a UE has reported a release preference, the UE cannot report a release preference again during the RRC connection.","paragraph_zero_based":5443},{"literal_text_all_w_t_and_m_t":"reportApplicabilityUAI","paragraph_zero_based":5444},{"literal_text_all_w_t_and_m_t":"If present, the field indicates the UE shall report applicability in UEAssistanceInformation message.","paragraph_zero_based":5445},{"literal_text_all_w_t_and_m_t":"rlm-RelaxationReportingConfig","paragraph_zero_based":5446},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report the relaxation state of RLM measurements.","paragraph_zero_based":5447}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["97473f4649286be2fd8937d4572da6897dafac91aa61f03068d03d175cd0ce82","3c72b2868fc30917e4f401974f90f40f4912f17db5f47070fb3a6fe6d88e458f","966a67c0bb66a259e24520ffda9b10b4bacfc72c65903fc72d23fac5a22729fa","fe125af928a30a63846e83082b3dfef404118267ae8ae08c4316c7db2e1b615c","1039bb721b5ee39ea8dffa9f65e819180464a582807ef87b74891941444bb536","236a86b638ebdd432c8401741266e6afa0794088ae8e8653bd6832ad8b94699f","8ccac41b04827b7f5ef3f8df7d9a184496c0d36f4368fdd9b78f14b82f0c0669","70fd6fff2b39364f13eb214aa60a0a9fd91696b6f2afe198ebc52c914ca55d1e","24e8bdbbad077a210e7f97cc7aba19dcb350f21e4022e1e9a946f23703a21c4f","c9e2f1340602728051e24acde5134ef6de2827058ef550e0e838b9c1f4bb4136","fd991fc89391a44067f54690beff812a6e49d9eeed33d4c2f58172c4747b317e","73527f605372fe719c8cbc53042872d6a52727606961730e70915e8f19a360ac","31ff748cbc6e6c7b048369fd2d1034bf301e9d4442ed79f2b8ad52d89425ee27","1c52a755ae74e917ff7201a1eb0715c83a0657fb7de842f79d41ed9f3a2b4e98","f3c1645bf47e4c2de38ca58abb01bf308f023a06bc6f39a99493526bfa817323","a41497a778a86f4234c8e929ca38e3e0b830c72bd28ea0a7f8b414a03ed02f9a","3f1713b850e915eeb904e5bfa346199f9fab85b73bedd4434b9e7dfa856f5dc0","a618214af4b00bd0f857faf052929b22731b6e48cf28f75ed2bdec7952baeaf5","2df6d14d0b1f034e43726e010fe840e75ce47ba354f166c074852961bc19ff30","b808b764d944adbd7b29aeaece2597eadc22d2abb187a95d9d7d77ce16a5f0fd","01e72a64813c9d1d96f62b5bc464923682ffeaa0daf5e16f9993e76466174997","e9337de5e0510af575156354031ec5a25872da5ff70a7b1bdd1ca7eb0ec0b36b","0ebd898843f258afd81cd4756033783249fd4e1e26e50cbe172ddb643c1ae687","b9113462a7e113ef901de312b695db653fb50d3d44290dc193d6df25410009a6"],"paragraph_range_zero_based":[5424,5447],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p5424"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"s-SearchDeltaP-Stationary","paragraph_zero_based":5448},{"literal_text_all_w_t_and_m_t":"Parameter \"SSearchDeltaP-StationaryConnected\" in 5.7.4.4. Value dB2 corresponds to 2 dB, dB3 corresponds to 3 dB and so on.","paragraph_zero_based":5449},{"literal_text_all_w_t_and_m_t":"scg-DeactivationPreferenceConfig","paragraph_zero_based":5450},{"literal_text_all_w_t_and_m_t":"Configuration of the UE to indicate its preference for SCG deactivation.","paragraph_zero_based":5451},{"literal_text_all_w_t_and_m_t":"scg -StatePreferenceProhibitTimer","paragraph_zero_based":5452},{"literal_text_all_w_t_and_m_t":"Prohibit timer for UE indication of its preference for SCG deactivation. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":5453},{"literal_text_all_w_t_and_m_t":"sensorNameList","paragraph_zero_based":5454},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurements from specific sensors. NG-RAN configures the field if includeSensor-Meas is configured for one or more measurements.","paragraph_zero_based":5455},{"literal_text_all_w_t_and_m_t":"sl-AssistanceConfigNR","paragraph_zero_based":5456},{"literal_text_all_w_t_and_m_t":"Indicate whether UE is configured to provide configured grant assistance information for NR sidelink communication.","paragraph_zero_based":5457},{"literal_text_all_w_t_and_m_t":"sl-PRS-AssistanceConfigNR","paragraph_zero_based":5458},{"literal_text_all_w_t_and_m_t":"Indicate whether UE is configured to provide configured grant assistance information for NR sidelink positioning.","paragraph_zero_based":5459},{"literal_text_all_w_t_and_m_t":"sn-InitiatedPSCellChange","paragraph_zero_based":5460},{"literal_text_all_w_t_and_m_t":"This field indicates whether the PSCell change procedure or the CPC included in the RRCReconfiguration message is SN initiated or not. In case of SN initiated inter-SN PSCell change procedure or SN configured inter-SN CPC, MN includes this field in the MCG RRC Reconfiguration message. In case of intra-SN PSCell change, or intra-SN CPC, source SN includes the field in the SCG RRC Reconfiguration.","paragraph_zero_based":5461},{"literal_text_all_w_t_and_m_t":"sourceDAPS-FailureReporting","paragraph_zero_based":5462},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE shall generate the SHR upon successfully completing the DAPS handover to the target cell and if a radio link failure was experienced in the source PCell while executing the DAPS handover. This field is set in the otherConfig configured by the source cell of the DAPS handover.","paragraph_zero_based":5463},{"literal_text_all_w_t_and_m_t":"successHO-Config","paragraph_zero_based":5464},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report the successful handover information to the network.","paragraph_zero_based":5465},{"literal_text_all_w_t_and_m_t":"successPSCell-Config","paragraph_zero_based":5466},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report the successful PSCell change or addition information to the network. When this field is configured in CG-Config, the thresholdPercentageT304-SCG is absent.","paragraph_zero_based":5467},{"literal_text_all_w_t_and_m_t":"t-SearchDeltaP-Stationary","paragraph_zero_based":5468},{"literal_text_all_w_t_and_m_t":"Parameter \"TSearchDeltaP-StationaryConnected\" in 5.7.4.4. Value in seconds. Value s5 means 5 seconds, value s10 means 10 seconds and so on.","paragraph_zero_based":5469},{"literal_text_all_w_t_and_m_t":"thresholdPercentageT304","paragraph_zero_based":5470},{"literal_text_all_w_t_and_m_t":"This field indicates the threshold for the ratio in percentage between the elapsed T304 timer and the configured value of the T304 timer. Value p40 corresponds to 40%, value p60 corresponds to 60% and so on. This field is set in the otherConfig configured by the target cell of the handover.","paragraph_zero_based":5471}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["2ab5e7a25976ab07287b3d950328e9c70d08b01ed9dc36567a22a46608b8f3e3","5cd960b152838b64b29a727d8060815ee4eeb72c828791d42fe092594d388fea","6039d3b1e307a46cb51c0cb453195905ca034e87ebd6b376896f54562482ee56","addf9a612c3a50669f060d18b1651e73d1025e2823ac9962e72e445fd9d07318","3b2a020e1dfe3fc7d38b9931bfd5ad64c46a8a674124ad01e0d6698b02701d72","addc14ff3b875b11ef0dbb8bec0f725bd4ae90a08e1525ced4733c4d0fbee2e5","9f9825157fbdf8325d5cadd0fb1864f72ae2c7d33485b142322dc3d0abacdb6a","3c8a6eb0294990c195de81a4538c6404b71f54ea6f3ca6063beb936731fda16e","7cbaf32e2451ad385634b35c5a02f86397cecf021a2ed4933da22a3ae0c2058b","7b4ad6d0dc354ff36d3d922f44dfd90172abc25644a9253447408e66a7853e11","ad6cd1458101c643155cd849a9e4dd653baa685684d13d95cc245808dca96f5d","bd176c2f73e70b69ae7f7483df7eb6d2e909de85eeef763ee80b19c1efbb3029","25866daa50cbc3f7e4cb4c5ead57c56b07c9e45a7caba02d2ee98fbe1e108791","2de64278ef0a358182efd53a3aeec5520c70885c0141dea04363b03f7f49725d","049709e9db45a3c684d35bed8ffa16c77d8dfaca07a66aa485306f825e1961b6","3e409d1553e001f49c1badd94aec432c07c9b43d509689936ae86b114b892ebc","b7d8215ac4e4e8d57e8617d18259cda5b4696d0c014ead4240f25463de96bc74","b91ce15fc00ebca0719acfe9c7432f07591c200ad3ffeeb0d1eddef19a1494a0","428805a64c82fe133b603453e552bb5e45b4f852ea3d5d197fabeffe04c8eaa2","f569dcb709f91bf97b96de80f5edaa5a2a96783f609d6ef8f0f5e07e5c12ff22","b8822eddbff05a30b0d2a50fe47cbeaa75c1cfdc74f15373f650abce0413e11f","de5e0011c835cb271727d4758285a4830e78d75378ebbd5a98cdf84aae1e110d","4d2c93f97cb485bab279405c5e29466873ad8410e8fc4c078959ea75e3ce8183","dc6eab8b2e2e7bedd599b9e532fad2eed68179a1302a5a16b542df38366d9769"],"paragraph_range_zero_based":[5448,5471],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx:p5448"}
{"fields":{"filename":"R2-2507680.zip::R2-2507680 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"thresholdPercentageT310","paragraph_zero_based":5472},{"literal_text_all_w_t_and_m_t":"This field indicates the threshold for the ratio in percentage between the elapsed T310 timer and the configured value of the T310 timer. Value p40 corresponds to 40%, value p60 corresponds to 60% and so on. This field is set in the otherConfig configured by the source cell of the handover.","paragraph_zero_based":5473},{"literal_text_all_w_t_and_m_t":"thresholdPercentageT312","paragraph_zero_based":5474},{"literal_text_all_w_t_and_m_t":"This field indicates the threshold for the ratio in percentage between the elapsed T312 timer and the configured value(s) of the T312 timer. Value p20 corresponds to 20%, value p40 corresponds to 40% and so on. This field is set in the otherConfig configured by the source cell of the handover.","paragraph_zero_based":5475},{"literal_text_all_w_t_and_m_t":"thresholdPercentageT304-SCG","paragraph_zero_based":5476},{"literal_text_all_w_t_and_m_t":"This field indicates the threshold for the ratio in percentage between the elapsed T304 timer associated to the target PSCell and the configured value of the T304 timer. Value p40 corresponds to 40%, value p60 corresponds to 60% and so on. This field is set in the otherConfig configured by the target PSCell of the PSCell change or addition.","paragraph_zero_based":5477},{"literal_text_all_w_t_and_m_t":"thresholdPercentageT310-SCG","paragraph_zero_based":5478},{"literal_text_all_w_t_and_m_t":"This field indicates the threshold for the ratio in percentage between the elapsed T310 timer associated to the source PSCell and the configured value of the T310 timer. Value p40 corresponds to 40%, value p60 corresponds to 60% and so on. This field is set in the otherConfig configured by the source PSCell of the PSCell change or CPC, or in the otherConfig configured by the PCell for the PSCell change or CPC. This field is not configured at the time of PSCell change via SRB3.","paragraph_zero_based":5479},{"literal_text_all_w_t_and_m_t":"thresholdPercentageT312-SCG","paragraph_zero_based":5480},{"literal_text_all_w_t_and_m_t":"This field indicates the threshold for the ratio in percentage between the elapsed T312 timer associated to the measurement identity of the target PSCell and the configured value of the T312 timer. Value p20 corresponds to 20%, value p40 corresponds to 40% and so on. This field is set in the otherConfig configured by the source PSCell of the PSCell change or CPC, or in the otherConfig configured by the PCell for the PSCell change or CPC. This field is not configured at the time of PSCell change via SRB3.","paragraph_zero_based":5481},{"literal_text_all_w_t_and_m_t":"threshPropDelayDiff","paragraph_zero_based":5482},{"literal_text_all_w_t_and_m_t":"Threshold for one-way service link propagation delay difference report as specified in 5.7.4.2.","paragraph_zero_based":5483},{"literal_text_all_w_t_and_m_t":"ul-GapFR2-PreferenceConfig","paragraph_zero_based":5484},{"literal_text_all_w_t_and_m_t":"Indicates whether UE is configured to request for FR2 UL gap activation/deactivation and preferred FR2 UL gap pattern.","paragraph_zero_based":5485},{"literal_text_all_w_t_and_m_t":"wlanNameList","paragraph_zero_based":5486},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurements from specific WLAN APs. NG-RAN configures the field if includeWLAN-Meas is configured for one or more measurements.","paragraph_zero_based":5487},{"literal_text_all_w_t_and_m_t":"ul-TrafficInfoProhibitTimer","paragraph_zero_based":5488},{"literal_text_all_w_t_and_m_t":"Prohibit timer for UL traffic information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":5489},{"literal_text_all_w_t_and_m_t":"ul-TrafficInfoReportingConfig","paragraph_zero_based":5490},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report UL traffic information.","paragraph_zero_based":5491},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5492},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":5493},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":5494},{"literal_text_all_w_t_and_m_t":"FDM","paragraph_zero_based":5495}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8ea3f2cd17cc64a7fc93b34e322a9917fea2f6fb2ccc8fd888363f550f5f01ad","original_member_sha256":"a9ae874fc8477ca54ba94d75064a5096273f26d409ca0f0a3ac4dc63a68b1cd6","paragraph_ElementTree_utf8_XML_sha256":["dd72b592f9dd7f73888df28c66308533fdbc783a5a71011cf713408361f0e21f","b8dc39e306d9156051e894ea23d5dab97787c6ceaec918c8eae9a16a656b4838","5c27b88d8aa880c86a71a6aca5d3a41fcac81e1afcee514c351d67633ca28de1","2d463c1f19740992c659ed4f98e5134c910d12621b300db39d0aa3ca0169b85f","a65ebd02b1a0dc3da17702818f0ca0d1f8605a82ffec10229fffca6ab259f64a","64d4c5ed66c2a2ba5f816b3b42b457039f9dfc809942772636eb93024f5e8e90","fd11c6c95472287cd135254d7bac69bca04baa2fb39ba354b83d92253eeb228d","5105fe9cdabe8e305309489464a85c567aa247d50afb32d92784e8b4f2a92bbe","68ab5ffa8d131c1565c22acb144c2620b4b312e3b32e3fced264234e02aeab18","b86e498ceba9b9eb8d5bedb4625a5ddf82450701d6ab3ea731210ff513f48f4a","acee8b92571a370accd5178a75b0fa6f39a3d9c153f9a9ab47dd7371cfc8cc48","62fff17834cc99bff02298a8377a736ee7e8a7dae3021bd0205f2c516fc4bc2b","a17ee76bf9485c646ab0b426d624f68b77aeec7a2d9118f475ada3486cccaebe","42ca276cf2efb7e2ed5511b69d53797a1720baae1dd149c0c7970bc9eeb3badf","23dcb253f1930af8d64d3ff8279723705a094c125f8dcb17babc6ae7aa06bc28","038a9faa55483e1dd272a77ae33234c7f8b5a5b9eecadc6c161cd4