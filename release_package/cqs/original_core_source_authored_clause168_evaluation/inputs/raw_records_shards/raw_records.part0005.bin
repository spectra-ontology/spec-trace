3d9e5dc989b83db9f44","9fec00b7c468c579be0271bd768120cc124fc411524bd1a96ea8e296901b6e21","2cbe6d2c9889d74e2df672fc2a0c24b90cd0cfe82ac239b42dd33a498697d8a2","918f185386ae83f53507c875539cbb7112e8af55bee562d3a2576f9081426bd2","60a46a0f11e592a9b933d0a9bc309b7adc332a933269dc892ac463948e5a0c85","d51bb28227f72db2e3e22aa9cf665ecb33a54072be1e79828f645d61fdd9ea3e","7692c43f70d107717a87061834a0c9cac9f9f1e548984f476292ee7eecd8dee3","f60dc0f44c2b2faba92adf2c10226bfaf6fa824cbc72b337086a83573d8429b2","4013e116a5a0c167c223d0375945d9685105a319bb9ada38fed3cbcedc6efca8","af70ab9c0555d21f6c5766b19a6dd6840441f2a6004db8e86f3cd325c3a63ee3","c90af4564097736160e878c2c944b4419ab8c73adc2e6346f2bbde8965bbac2f","9e55f160f0c71e59bb73987451b27a37903171b3a8a7ba5b6c29f612b319a3d3","8eb903e56b29fe625941947a762ae276c9c867112a0008ec8da1315a4afab9c1","b10583c8e5c00ce40711170420f43564b36f286e7f727c6a4363d0e76698b7f5"],"paragraph_range_zero_based":[49008,49031],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p49008"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49032},{"literal_text_all_w_t_and_m_t":"MBS-NonServingInfoList field descriptions","paragraph_zero_based":49033},{"literal_text_all_w_t_and_m_t":"freqInfoMBS","paragraph_zero_based":49034},{"literal_text_all_w_t_and_m_t":"Indicates MBS frequency of interest and the frequency band of the non-serving cell for MBS broadcast reception acquired from the SIB21 or the USD as specified in clause 5.9.4.3.","paragraph_zero_based":49035},{"literal_text_all_w_t_and_m_t":"cfr-infoMBS","paragraph_zero_based":49036},{"literal_text_all_w_t_and_m_t":"Indicates the CFR information of the non-serving cell for MBS broadcast reception. It is up to UE implementation to choose cfr-Bandwidth or cfr-LocationAndBW as the reported CFR information.","paragraph_zero_based":49037},{"literal_text_all_w_t_and_m_t":"cfr-Bandwidth","paragraph_zero_based":49038},{"literal_text_all_w_t_and_m_t":"Indicates the CFR bandwidth of the non-serving cell for MBS broadcast reception.","paragraph_zero_based":49039},{"literal_text_all_w_t_and_m_t":"cfr-LocationAndBW","paragraph_zero_based":49040},{"literal_text_all_w_t_and_m_t":"Indicates the CFR location and bandwidth of the non-serving cell for MBS broadcast reception.","paragraph_zero_based":49041},{"literal_text_all_w_t_and_m_t":"subcarrierSpacing","paragraph_zero_based":49042},{"literal_text_all_w_t_and_m_t":"Indicates the subcarrier spacing of the CORESET#0 of the non-serving cell for MBS broadcast reception.","paragraph_zero_based":49043},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49044},{"literal_text_all_w_t_and_m_t":"CFR-LocationAndBW field descriptions","paragraph_zero_based":49045},{"literal_text_all_w_t_and_m_t":"locationAndBandwidthMBS","paragraph_zero_based":49046},{"literal_text_all_w_t_and_m_t":"Indicates the starting PRB and the number of PRBs of CFR used for MBS broadcast reception from non-serving cell. The value of the field shall be interpreted as resource indicator value (RIV) as defined in TS 38.214 [19] with assumptions as described in TS 38.213 [13]. The first PRB is a PRB determined by subcarrierSpacing, offsetToCarrierMBS and absoluteFrequencyPointA-MBS of the non-serving cell.","paragraph_zero_based":49047},{"literal_text_all_w_t_and_m_t":"absoluteFrequencyPointA-MBS","paragraph_zero_based":49048},{"literal_text_all_w_t_and_m_t":"Indicates the absolute frequency position of the reference resource block (common RB 0) of the non-serving cell for MBS broadcast reception. Its lowest subcarrier is also known as Point A (see TS 38.211 [16], clause 4.4.4.2). ","paragraph_zero_based":49049},{"literal_text_all_w_t_and_m_t":"offsetToCarrierMBS","paragraph_zero_based":49050},{"literal_text_all_w_t_and_m_t":"Indicates the offset in frequency domain between Point A (lowest subcarrier of common RB 0) and the lowest usable subcarrier on this carrier in number of PRBs (using the subcarrierSpacing indicated for the non-serving cell).","paragraph_zero_based":49051},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49052},{"literal_text_all_w_t_and_m_t":"–MBS-ServiceList","paragraph_zero_based":49053},{"literal_text_all_w_t_and_m_t":"The IE MBS- ServiceList is used to inform the network of the MBS services that the UE is receiving or interested to receive.","paragraph_zero_based":49054},{"literal_text_all_w_t_and_m_t":"MBS-ServiceList information element","paragraph_zero_based":49055}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["0e50a89ae26bbc320c5a53c98e5189