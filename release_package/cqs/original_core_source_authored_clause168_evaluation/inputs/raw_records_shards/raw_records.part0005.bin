{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-RemoteUE-LocalIdentity","paragraph_zero_based":50424},{"literal_text_all_w_t_and_m_t":"Indicates the local UE ID of the L2 U2U Remote UE used in SRAP as specified in TS 38.351 [66].","paragraph_zero_based":50425},{"literal_text_all_w_t_and_m_t":"sl-RemoteUE-L2Identity","paragraph_zero_based":50426},{"literal_text_all_w_t_and_m_t":"Indicates the Source L2 ID of the L2 U2U Remote UE as specified in TS 23.304 [65].","paragraph_zero_based":50427},{"literal_text_all_w_t_and_m_t":"sl-PeerRemoteUE-LocalIdentity","paragraph_zero_based":50428},{"literal_text_all_w_t_and_m_t":"Indicates the local UE ID of the peer L2 U2U Remote UE used in SRAP as specified in TS 38.351 [66].","paragraph_zero_based":50429},{"literal_text_all_w_t_and_m_t":"sl-PeerRemoteUE-L2Identity","paragraph_zero_based":50430},{"literal_text_all_w_t_and_m_t":"Indicates the destination L2 ID identifying the peer L2 U2U Remote UE as specified in TS 23.304 [65].","paragraph_zero_based":50431},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":50432},{"literal_text_all_w_t_and_m_t":"–RRCReconfigurationCompleteSidelink","paragraph_zero_based":50433},{"literal_text_all_w_t_and_m_t":"The RRCReconfigurationCompleteSidelink message is used to confirm the successful completion of a PC5 RRC AS reconfiguration. It is only applied to unicast of NR sidelink communication.","paragraph_zero_based":50434},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SL-SRB3","paragraph_zero_based":50435},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":50436},{"literal_text_all_w_t_and_m_t":"Logical channel: SCCH","paragraph_zero_based":50437},{"literal_text_all_w_t_and_m_t":"Direction: UE to UE","paragraph_zero_based":50438},{"literal_text_all_w_t_and_m_t":"RRCReconfigurationCompleteSidelink message","paragraph_zero_based":50439},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":50440},{"literal_text_all_w_t_and_m_t":"-- TAG-RRCRECONFIGURATIONCOMPLETESIDELINK-START","paragraph_zero_based":50441},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":50442},{"literal_text_all_w_t_and_m_t":"RRCReconfigurationCompleteSidelink ::=         SEQUENCE {","paragraph_zero_based":50443},{"literal_text_all_w_t_and_m_t":"    rrc-TransactionIdentifier-r16                  RRC-TransactionIdentifier,","paragraph_zero_based":50444},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                             CHOICE {","paragraph_zero_based":50445},{"literal_text_all_w_t_and_m_t":"        rrcReconfigurationCompleteSidelink-r16         RRCReconfigurationCompleteSidelink-r16-IEs,","paragraph_zero_based":50446},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture                       SEQUENCE {}","paragraph_zero_based":50447}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["3f18c8e70b3f6fca04c27d0aa09e2e6e4cbfcca79d57f02927572e47853b5000","86b46ca3a13fc9b6bd8215d52772a62c6366a5978bfa371159f7cdcea55b6f3e","504174488e8d38411676152d1086000b8f849d90aa1e5fa7b01f788554087e97","4b43e93eb50b5ecb56f6ef8ba59f5ca71bf6c234609b1b8c36566014685afda1","b669fe2e50e99d93e0c813869f667e6687ec03f099a8c22647872952acc938d8","1653916824990f2d12bf121590bd65afa4edee804dda54ce8d3329f9e24d6ae9","415189c34c4b747a70da637f8d9985afb7a02923199e481c2dc0a6e38b52696e","9d6d44d249d26bebfb388c706f2bf1f3928687906c415391189ebb7616011ed4","1ba7569a871c0a0d35225574acefb2fe307732453d411b2561aaa007c061edd5","07f16423f79b7df66d896797d58f2a36b3c1089529ed4fa4fb16a3912d46ea10","313