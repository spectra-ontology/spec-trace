c P-Max.","paragraph_zero_based":140},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":141},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":142},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"56654f9bd149b93ddfaf012bcd674e18c374f6dd7ddf1cc1792dc12229297094","original_member_sha256":"56fb020b0b8197f2dc7d5bb3d81730ac42e27dd1effda03bff60ba62025e75eb","paragraph_ElementTree_utf8_XML_sha256":["4cc3ae780c8ced7b1fb8a7319e262251261e97d54bb2e8c667e5ebf1a364e823","5d6a364f6def41f16313e5b186251c16960dda7b572ab7576b19f56096b798b2","08a51ad19eb8fa8586e3e4aa95e627466e0aed3306701b53bbc0a938cf6dd354","9acf1d97c32d0046821f1bfe430f4d441f4153ccbb9b148f48a1ae95f5c5e99c","b537ecc55eaef8b47637f81284173388f8fb9fbda1e34b0ead0babe7592455b3","47b9684b5d7ec89b1add923b8dbab4958ee851a9d48280a888bc050fd2f4cc41","7fca93154b016f4532d88b18e10e1beecc7259b6aed01588364e64d1517ac59d","50ce54f052d430aad92f8706d93b99c1f6a21820a89833ae9e78deaf614857c6","cd2717f8449439b3d0c79738ec36fde6cad2238d7e1d30548d4df1755c29f515","a180d3254faadecdea0320a1ea7cd8685f38310412b14088191ffbcee3db3796","b2a0a945ba9ff68e794d12ccade496d360f2026e087c7205f7f09c3a369bd508","315f96dad7e53720f3ef9d621115b437086c282b4b132d2920842783e6b4420b","9f7eb8601ebc6f40e035605fe04c73ea93696aa884902a376b8c25a6d48e2b12","c180ce235fddc3cd7869a740b5b173e69d78b27a7552060c9a9226126464a4a3","0320bb08f446ec60ed83698cae55f647391f31374d4cbaaabfd5eec5b97076bd","9538f9b13a9d3eae90137b2f5d4a4f94353903b0124325a8bea2f70cdceec7b4","87ea64b41710894f27d50ff9445d7763b183e891fe4005e76811a463d75fda8d","e35aaa8163215a91fa1b72b9d91cff4711e971d61a5a7acc0a85c59b810469c8","bde16aed37ba563e2f4fc154106b9abec0bbf558a4db7c801925ff8da840d3c0","39b973b176e93ffb11f8e920f30c77542bbb653d05b0accd9b7947a487a58fdc","a7c8ca6efdef3d999a4d25f0c5af27b255adc0d0665d905949f63e71a939df72","b22fba