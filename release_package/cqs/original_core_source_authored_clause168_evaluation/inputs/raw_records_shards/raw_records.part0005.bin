{"fields":{"filename":"R2-2407525.zip::R2-2407525.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"NR SA","paragraph_zero_based":96},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":97},{"literal_text_all_w_t_and_m_t":"Impacted functionality:","paragraph_zero_based":98},{"literal_text_all_w_t_and_m_t":"UL Waveform","paragraph_zero_based":99},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":100},{"literal_text_all_w_t_and_m_t":"Inter-operability:","paragraph_zero_based":101},{"literal_text_all_w_t_and_m_t":"If the network is implemented according to the CR and the NCR-MT is not, or If the NCR-MT is implemented according to the CR and the network is not, the network cannot know whether the NCR-MT supports DFT-S-OFDM and cannot configure such waveform for UL transmission. ","paragraph_zero_based":102},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":103},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":104},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":105},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":106},{"literal_text_all_w_t_and_m_t":"UL waveform DFT-S-OFDM is not supported for NCR-MT. ","paragraph_zero_based":107},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":108},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":109},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":110},{"literal_text_all_w_t_and_m_t":"6.3.3","paragraph_zero_based":111},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":112},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":113},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":114},{"literal_text_all_w_t_and_m_t":"Y","paragraph_zero_based":115},{"literal_text_all_w_t_and_m_t":"N","paragraph_zero_based":116},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":117},{"literal_text_all_w_t_and_m_t":"","parag