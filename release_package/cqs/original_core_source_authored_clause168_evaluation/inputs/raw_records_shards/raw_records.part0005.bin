{"fields":{"filename":"R2-2509161.zip::R2-2509161 36331 R19 Misc Rapp.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"6.3.6Other information elements","paragraph_zero_based":120},{"literal_text_all_w_t_and_m_t":"–UE-EUTRA-Capability","paragraph_zero_based":121},{"literal_text_all_w_t_and_m_t":"The IE UE-EUTRA-Capability is used to convey the E-UTRA UE Radio Access Capability Parameters, see TS 36.306 [5], and the Feature Group Indicators for mandatory features (defined in Annexes B.1 and C.1) to the network. The IE UE-EUTRA-Capability is transferred in E-UTRA or in another RAT.","paragraph_zero_based":122},{"literal_text_all_w_t_and_m_t":"NOTE 0:For (UE capability specific) guidelines on the use of keyword OPTIONAL, see Annex A.3.5.","paragraph_zero_based":123},{"literal_text_all_w_t_and_m_t":"UE-EUTRA-Capability information element","paragraph_zero_based":124},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":125},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":126},{"literal_text_all_w_t_and_m_t":"UE-EUTRA-Capability ::=SEQUENCE {","paragraph_zero_based":127},{"literal_text_all_w_t_and_m_t":"accessStratumReleaseAccessStratumRelease,","paragraph_zero_based":128},{"literal_text_all_w_t_and_m_t":"ue-CategoryINTEGER (1..5),","paragraph_zero_based":129},{"literal_text_all_w_t_and_m_t":"pdcp-ParametersPDCP-Parameters,","paragraph_zero_based":130},{"literal_text_all_w_t_and_m_t":"phyLayerParametersPhyLayerParameters,","paragraph_zero_based":131},{"literal_text_all_w_t_and_m_t":"rf-ParametersRF-Parameters,","paragraph_zero_based":132},{"literal_text_all_w_t_and_m_t":"measParametersMeasParameters,","paragraph_zero_based":133},{"literal_text_all_w_t_and_m_t":"featureGroupIndicatorsBIT STRING (SIZE (32))OPTIONAL,","paragraph_zero_based":134},{"literal_text_all_w_t_and_m_t":"interRAT-ParametersSEQUENCE {","paragraph_zero_based":135},{"literal_text_all_w_t_and_m_t":"