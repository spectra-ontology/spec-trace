4c62db597c22a7c75f","8bc73b6bd67d8e0446c4fa69b570665f16498dc7970cb615ff35fa5c3db8ef41","956d318717cf415316b7d8e90cc427a74887e2a76f33c8fdfca00c2be89590fb","3457722a412ffb725f6a488d499a6844ae5d07f95eb7767d8212009f78dd1b1e","e55fa0340005935b03fb1e8d2a769b57cf93a553e6f5dc047012fb1e234e1e0c","44996db33ee8b92bf4f1bceb910657be3fa29101ec6c2558b9bb63bb66f19ea0","0474bde3d154fa07b92b9ae28b5857a971743f0c93e199fc0aa1250c7d9b66ba","defce7fd8940d014390818b94232ed703a14b36f51acebe2000d3eac6ce1d726"],"paragraph_range_zero_based":[456,479],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509465.zip::R2-2509465.docx:p456"}
{"fields":{"filename":"R2-2509465.zip::R2-2509465.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ENUMERATED { n0, n2, n3, n4, n6, n8, ... }","paragraph_zero_based":480},{"literal_text_all_w_t_and_m_t":"OPTIONAL, -- Need ON","paragraph_zero_based":481},{"literal_text_all_w_t_and_m_t":"reducedDL-PRS-ProcessingSamples-r17ENUMERATED { requested, ... }OPTIONAL, -- Need ON","paragraph_zero_based":482},{"literal_text_all_w_t_and_m_t":"lowerRxBeamSweepingFactor-FR2-r17ENUMERATED { requested }OPTIONAL  -- Need ON","paragraph_zero_based":483},{"literal_text_all_w_t_and_m_t":"]],","paragraph_zero_based":484},{"literal_text_all_w_t_and_m_t":"[[","paragraph_zero_based":485},{"literal_text_all_w_t_and_m_t":"timingReportingGranularityFactorExt-r18INTEGER (-6..-1)OPTIONAL, -- Need ON","paragraph_zero_based":486},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-MeasurementTimeWindowsConfig-r18","paragraph_zero_based":487},{"literal_text_all_w_t_and_m_t":"NR-DL-PRS-MeasurementTimeWindowsConfig-r18OPTIONAL  -- Need ON","paragraph_zero_based":488},{"literal_text_all_w_t_and_m_t":"]]","paragraph_zero_based":489},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":490},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":491},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":492},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":493},{"literal_text_all_w_t_and_m_t":"NR-DL-TDOA-RequestLocationInformation field descriptions","paragraph_zero_based":494},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-RstdMeasurementInfoRequest","paragraph_zero_based":495},{"literal_text_all_w_t_and_m_t":"This field indicates whether the target device is requested to report DL-PRS Resource ID(s) or DL-PRS Resource Set ID(s) used for determining the timing of each TRP in RSTD measurements. ","paragraph_zero_based":496},{"literal_text_all_w_t_and_m_t":"nr-RequestedMeasurements","paragraph_zero_based":497},{"literal_text_all_w_t_and_m_t":"This field specifies the NR DL-TDOA measurements requested. This is represented by a bit string, with a onevalue at the bit position means the particular measurement is requested; a zerovalue means not requested. The dl-PRS-RSCPD-Request means that the target device is requested to provide DL RSCPD measurement.","paragraph_zero_based":498},{"literal_text_all_w_t_and_m_t":"nr-AssistanceAvailability","paragraph_zero_based":499},{"literal_text_all_w_t_and_m_t":"This field indicates whether the target device may request additional DL-PRS assistance data from the server. TRUE means allowed and FALSE means not allowed.","paragraph_zero_based":500},{"literal_text_all_w_t_and_m_t":"additionalPaths","paragraph_zero_based":501},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to provide the nr-AdditionalPathList in IE NR-DL-TDOA-SignalMeasurementInformation. If this field is present, the field additionalPathsExt shall be absent.","paragraph_zero_based":502},{"literal_text_all_w_t_and_m_t":"nr-UE-RxTEG-Request","paragraph_zero_based":503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"031803c101a10e427d1f230cc629e09e0bd01d184d1e2938f387ad803c3911dc","original_member_sha256":"2bae8d5ac03017cc49187eaa8fa5f66dd9d41d8add52aa40b5603598875c82af","paragraph_ElementTree_utf8_XML_sha256":["e5a6aed99ed21f527b1d4d9a39b2bc23f12ae0721c80772d3885d8a1f349107b","bda80770357b8bfe42fb726ef0e9b296b1b7fd240048e573c016bcb3fb9867b0","13285f11f09dd9d1cbca80cc35872c7243ed94c5109e8166838e256ab17d6026","c8d61a9ff611bd67e12f24a91101c68cdf5954653337b142e9b355131f1d70c5","82720edbb08ef13b8585be2f6b354903eb93bb490c0eac729d3b5171a98fb2d3","40d834a8a71914308085a05035d1602d9623c039055f0f3237899120aacc0013","a4f47942955e601fee236285bed682c8a13db9f6832eeb0b108d634b3c619de0","c741ecf721bee407881dfe0b958c3969f961ccd6c8478f99f7aec6eab54c54a3","e8afeb5f71de96bec388dba0571863b09f12d08167c59a9bffcbe1503c8687e7","1304cf999ec71fe1db7d527912bf14753f4f0b16a650f0d7bb8bd880fdca7329","857058c68da0e5e61250a77e1fe8666c5c9a9ed3784482d62ed25836e9571722","98fda62c769804ffeb7ac6386d92aba3b0c2dd9d492e95a5cffc670e93f59c87","0f4ba287b7039ad32f6860921f25f76da3010df3a5e5c2da548f6a7c08016f9f","147aa814cd34f41479333a28d3618da78c218ab946d67e75c9295fc633944aa5","05dac8be1a989d4005bf2c37f1abf7521057b4102827cc83805b4986a218777e","958caf53d729bf79c83a9c5c5e2958abc1090d66abf91e46adf1b22230581404","cda19e200f382b8e7d090f91d142ec9f63f85c8cdf9dce19b5602977386d9705","d68d393ccc6fd3db85f2d9f36ba67aa45c2e8f7f778dd4801a222211108c24f0","4499d2c52e9223d148b55abd6d2f1788cdd4c277b2a661739e1c414b86ce2488","a4eb0aea3d93bbbf744b596dd7bff7a64363c1039e346dae294207419ed7e14a","9038a247f13cc4b8c35c86dc82df58c886ee9c24c8363d415915adc9259e1a78","a2cd8a06af50ecfb29887de85337d2c7d166709315ff7828b2c8f43950f54e50","e8400e199d7367ee945c82684060492951111626843e95fe1a17d4f3d254f84e","8e1e6c84279cb85e35f6c584c5a15646d15bf7557c8998258372b753e42d0365"],"paragraph_range_zero_based":[480,503],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509465.zip::R2-2509465.docx:p480"}
{"fields":{"filename":"R2-2509465.zip::R2-2509465.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to provide the nr-UE-Rx-TEG-ID in IE NR-DL-TDOA-SignalMeasurementInformation.","paragraph_zero_based":504},{"literal_text_all_w_t_and_m_t":"nr-los-nlos-IndicatorRequest","paragraph_zero_based":505},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to provide the indicated type and granularity of the estimated LOS-NLOS-Indicator in the NR-DL-TDOA-SignalMeasurementInformation.","paragraph_zero_based":506},{"literal_text_all_w_t_and_m_t":"additionalPathsExt","paragraph_zero_based":507},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to provide the nr-AdditionalPathListExt in IE NR-DL-TDOA-SignalMeasurementInformation. If this field is present, the field additionalPaths shall be absent.","paragraph_zero_based":508},{"literal_text_all_w_t_and_m_t":"additionalPathsDL-PRS-RSRP-Request","paragraph_zero_based":509},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to provide the nr-DL-PRS-RSRPP for the additional paths in fields nr-AdditionalPathList or nr-AdditionalPathListExt.","paragraph_zero_based":510},{"literal_text_all_w_t_and_m_t":"multiMeasInSameReport","paragraph_zero_based":511},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to provide multiple measurement instances in a single measurement report; i.e., include the nr-DL-TDOA-SignalMeasurementInstances (in the case of UE-assisted mode is requested) or nr-DL-TDOA-LocationInformationInstances (in the case of UE-based mode is requested) in IE NR-DL-TDOA-ProvideLocationInformation.","paragraph_zero_based":512},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-JointMeasurementRequest","paragraph_zero_based":513},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to perform joint measurement across aggregated PFLs.","paragraph_zero_based":514},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-JointMeasurementRequestedPFL-List","paragraph_zero_based":515},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates the target device is requested to perform joint measurements on the indicated two or three PFLs. Value 0 corresponds to the first frequency layer provided in nr-DL-PRS-AssistanceDataList, value 1 to the second frequency layer in nr-DL-PRS-AssistanceDataList, and so on.","paragraph_zero_based":516},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-RxHoppingRequest","paragraph_zero_based":517},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to use DL-PRS Rx hopping for performing RSTD, RSRP (if requested in nr-RequestedMeasurements), or RSRPP measurements (if requested in nr-RequestedMeasurements) and report the hopping information used for performing the measurements. This field is not included when dl-PRS-RSCPD-Request or nr-DL-PRS-JointMeasurementRequest is included.","paragraph_zero_based":518},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-RxHoppingTotalBandwidth","paragraph_zero_based":519},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates the total bandwidth in MHz across all hops for the DL-PRS measurement. If the configured value nr-DL-PRS-RxHoppingTotalBandwidth is larger than the configured DL-PRS bandwidth in the provided assistance data, the UE shall assume that the actual nr-DL-PRS-RxHoppingTotalBandwidth is equal to the width of the configured DL-PRS in the provided assistance data.","paragraph_zero_based":520},{"literal_text_all_w_t_and_m_t":"maxDL-PRS-RSTD-MeasurementsPerTRP-Pair","paragraph_zero_based":521},{"literal_text_all_w_t_and_m_t":"This field specifies the maximum number of DL-PRS RSTD measurements per pair of TRPs. The maximum number is defined across all Positioning Frequency Layers. When requested for aggregated measurements by the location server, this field specifies the maximum number of aggregated DL-PRS RSTD measurements per pair of TRPs. The maximum number is defined across all Positioning Frequency Layers.","paragraph_zero_based":522},{"literal_text_all_w_t_and_m_t":"timingReportingGranularityFactor, timingReportingGranularityFactorExt","paragraph_zero_based":523},{"literal_text_all_w_t_and_m_t":"This field specifies the recommended reporting granularity for the DL RSTD measurements. Value (0..5) corresponds to (k0..k5) and value (-6..-1) corresponds to (kMinus6..kMinus1) used for nr-RSTD and nr-RSTD-ResultDiff in NR-DL-TDOA-MeasElement. The UE may select a different granularity value for nr-RSTD and nr-RSTD-ResultDiff. The UE shall ignore timingReportingGranularityFactor when the timingReportingGranularityFactorExt is included.","paragraph_zero_based":524},{"literal_text_all_w_t_and_m_t":"measureSameDL-PRS-ResourceWithDifferentRxTEGs","paragraph_zero_based":525},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to measure the same DL-PRS Resource of a TRP with N different UE Rx TEGs. Enumerated value 'n0' indicates that the number N of different UE Rx TEGs to measure the same DL-PRS Resource can be determined by the target device, value 'n2' indicates that the target device is requested to measure the same DL-PRS Resource of a TRP with 2 different UE Rx TEGs, value 'n3' indicates that the target device is requested to measure the same DL-PRS Resource of a TRP with 3 different UE Rx TEGs, and so on.","paragraph_zero_based":526},{"literal_text_all_w_t_and_m_t":"If this field is present, the field nr-UE-RxTEG-Request should also be present. When the location server requests aggregated measurements, the target device is requested to measure the same aggregated DL-PRS Resources of a TRP with N different UE Rx TEGs.","paragraph_zero_based":527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"031803c101a10e427d1f230cc629e09e0bd01d184d1e2938f387ad803c3911dc","original_member_sha256":"2bae8d5ac03017cc49187eaa8fa5f66dd9d41d8add52aa40b5603598875c82af","paragraph_ElementTree_utf8_XML_sha256":["3ff669493df6febb4340e27924946f586e608d06b5ef77e2c92a6fa33236845b","5f54558f81f79636b3fe6b00627ac6513f94dbbf5642c6c6622ea00b9c5458f1","5e3715fc2c5aee2780e66227823881bd4688f54839b16f417d62d339932007e8","8facc1a426b371408a0f0bc7f7b440898d6e1227939a5b78dfdfec8a26b65667","3767fe0a7365eb232d5eb0134dcc7d906d522d0b6f13d92239b67fbf6661d796","945f378c9c1e5357b1fce0d3e3e1c7af25ccb69474883e511a58875f4bf52a6e","b117aa02ae41c83089dd8e5abfa42390b7be652350ec57f56b77fa899a1eb623","eb0873879fd37f22569ea14a6f7dc2fc5d5a1ae137c1dc74b05724151303cc3b","ccd61c169f8c0349192ae0f5c21954e6fe38f78e218ed9a509e99ffde4af3bfb","d7859c6b5cc912d5c675a12657beefa1cea069da0ae56413b601a79ff838623d","3e976536d078aed10594f87796dd5a67f37978930209aafed248db85ae4f3531","4352369fb6251e9bbb32e4ca03b88f86429d396253312d46c2dab09311c58c5c","8010c5becc3da7c81b7944f12968f9888e84d9139f70d7b40a0235432e22c5b1","2701e7acbd14d2cfc7a484d3425fa8dde83df9e936445150d9a8df5c883647a5","b19c5e668f47ca13ac011009ddb82a0f0a0b6f5875046124f12c8ddab5783873","3fbbd9c20717f94a1db5862b499ad803246d8c270fa33ded81ec1b6666b489ba","d3747f32776d41608eba2442d8a6969907f3b64d6fe824b0032b0615a058d987","19ee27b4a0bf9dbb9a8fffb9395d39b64fd7f47f787bed4f452473f7994a88be","d59513aa1a45ae7fbe53428ba194217d9ce1c7b395a3e4452b7dcbcbd7bd13f6","7a5c45c358316a9b17c4cda4be02ce784c12cdcd7ba014cff5b7040899f19e0c","6a9e8a024336c21b19cb6055525de4b7315f790710c06e8fda231cee04028412","651df0632bd7e67001ca87c2f0fe6787ac94bcd0103acba6ef0b4a30e94e7075","c1519093aaf0012d5b2e8c91d0cf5637a571d6b041e31256878ce80438c6de76","09a79272b56ca6c41f9fc81246c53ef5e93a9c6c41b3f40d2a12e4b8799b1483"],"paragraph_range_zero_based":[504,527],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2509465.zip::R2-2509465.docx:p504"}
{"fields":{"filename":"R2-2509465.zip::R2-2509465.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"reducedDL-PRS-ProcessingSamples","paragraph_zero_based":528},{"literal_text_all_w_t_and_m_t":"This field, if present and set to 'requested', indicates that the target device is requested to perform the requested measurements with reduced number of samples (M=1 or M=2) as specified in TS 38.133 [46]. When requested for aggregated measurements by the location server, this field indicates processing of reduced number of samples for the aggregated measurements.","paragraph_zero_based":529},{"literal_text_all_w_t_and_m_t":"lowerRxBeamSweepingFactor-FR2","paragraph_zero_based":530},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to use a lower Rx beam sweeping factor than 8 for FR2 according to UE's capability. When requested for aggregated measurements by the location server, this field indicates that the target device is requested to use a lower Rx beam sweeping factor than 8 for FR2 according to UE's capability for the aggregated measurements.","paragraph_zero_based":531},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-MeasurementTimeWindowsConfig","paragraph_zero_based":532},{"literal_text_all_w_t_and_m_t":"This field indicates DL-PRS Resource Set(s) occurring within time window(s) for performing measurements where the time window is indicated by a start time, periodicity, offset and duration.","paragraph_zero_based":533},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":534},{"literal_text_all_w_t_and_m_t":"[…]","paragraph_zero_based":535},{"literal_text_all_w_t_and_m_t":"6.5.11.3NR DL-AoD Location Information","paragraph_zero_based":536},{"literal_text_all_w_t_and_m_t":"–NR-DL-AoD-ProvideLocationInformation","paragraph_zero_based":537},{"literal_text_all_w_t_and_m_t":"The IE NR-DL-AoD-ProvideLocationInformation is used by the target device to provide NR DL-AoD location information to the location server. It may also be used to provide NR DL-AoD positioning specific error reason.","paragraph_zero_based":538},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":539},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":540},{"literal_text_all_w_t_and_m_t":"NR-DL-AoD-ProvideLocationInformation-r16 ::= SEQUENCE {","paragraph_zero_based":541},{"literal_text_all_w_t_and_m_t":"nr-DL-AoD-SignalMeasurementInformation-r16","paragraph_zero_based":542},{"literal_text_all_w_t_and_m_t":"NR-DL-AoD-SignalMeasurementInformation-r16","paragraph_zero_based":543},{"literal_text_all_w_t_and_m_t":"OPTIONAL,","paragraph_zero_based":544},{"literal_text_all_w_t_and_m_t":"nr-dl-AoD-LocationInformation-r16NR-DL-AoD-LocationInformation-r16","paragraph_zero_based":545},{"literal_text_all_w_t_and_m_t":"OPTIONAL,","paragraph_zero_based":546},{"literal_text_all_w_t_and_m_t":"nr-DL-AoD-Error-r16NR-DL-AoD-Error-r16OPTIONAL,","paragraph_zero_based":547},{"literal_text_all_w_t_and_m_t":"...,","paragraph_zero_based":548},{"literal_text_all_w_t_and_m_t":"[[","paragraph_zero_based":549},{"literal_text_all_w_t_and_m_t":"nr-DL-AoD-SignalMeasurementInstances-r17SEQUENCE (SIZE (1..maxMeasInstances-r17)) OF","paragraph_zero_based":550},{"literal_text_all_w_t_and_m_t":"NR-DL-AoD-SignalMeasurementInformation-r16OPTIONAL,-- Cond batchUEA","paragraph_zero_based":551}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"031803c101a10e427d1f230cc629e09e0bd01d184d1e2938f387ad803c3911dc","original_member_sha256":"2bae8d5ac03017cc49187eaa8fa5f66dd9d41d8add52aa40b5603598875c82af","paragraph_ElementTree_utf8_XML_sha256":["471fb6830bd548512b7e670cd82044420f5d52212910cb5ab2d4fb2cd9da36f6","e698ffcc67d7a20e24f3b6d164ac56e010b4fd945b988ee7359b6dbceaba09f8","fdbb48fddda728ee6777caf189fe563fdac51e76c691aad2aea1a7ad04342ed6","606950e1