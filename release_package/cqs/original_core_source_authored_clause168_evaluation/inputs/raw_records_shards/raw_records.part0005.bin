{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":50736},{"literal_text_all_w_t_and_m_t":"UEInformationRequestSidelink field descriptions","paragraph_zero_based":50737},{"literal_text_all_w_t_and_m_t":"sl-E2E-QoS-InfoListPC5","paragraph_zero_based":50738},{"literal_text_all_w_t_and_m_t":"Indicates the Per-QoS flow QoS info for a list of end-to-end PC5 connections with each connection indicated by the destination L2 ID of the peer L2 U2U Remote UE. In addition, the end-to-end SLRB index is included to indicate the mapping from the QoS flow to the SLRB.","paragraph_zero_based":50739},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":50740},{"literal_text_all_w_t_and_m_t":"SL-E2E-QoS-InfoPC5 field descriptions","paragraph_zero_based":50741},{"literal_text_all_w_t_and_m_t":"sl-DestinationIdentityRemoteUE","paragraph_zero_based":50742},{"literal_text_all_w_t_and_m_t":"Indicates the destination L2 ID of the peer L2 U2U Remote UE for an end-to-end PC5 connection.","paragraph_zero_based":50743},{"literal_text_all_w_t_and_m_t":"sl-E2E-SLRB-Index-r18","paragraph_zero_based":50744},{"literal_text_all_w_t_and_m_t":"Indicates the index of an end-to-end SLRB","paragraph_zero_based":50745},{"literal_text_all_w_t_and_m_t":"sl-QoS-InfoList","paragraph_zero_based":50746},{"literal_text_all_w_t_and_m_t":"List of QoS profile of the sidelink QoS flow for an end-to-end PC5 connection, with each QoS flow indicated by sl-QoS-FlowIdentity which is unique for different end-to-end PC5 connection in the scope of UE, and uniquely identifies one sidelink QoS flow between the L2 U2U Remote UE and the L2 U2U Relay UE.","paragraph_zero_based":50747},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":50748},{"literal_text_all_w_t_and_m_t":"–UEInformationResponseSidelink","paragraph_zero_based":50749},{"literal_text_all_w_t_and_m_t":"The UEInformationResponseSidelink message is used to deliver UE information in sidelink, e.g. the split QoS information for L2 U2U Relay operation.","paragraph_zero_based":50750},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SL-SRB3","paragraph_zero_based":50751},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":50752},{"literal_text_all_w_t_and_m_t":"Logical channel: SCCH","paragraph_zero_based":50753},{"literal_text_all_w_t_and_m_t":"Direction: L2 U2U Relay UE to L2 U2U Remote UE","paragraph_zero_based":50754},{"literal_text_all_w_t_and_m_t":"UEInformationResponseSidelink message","paragraph_zero_based":50755},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":50756},{"literal_text_all_w_t_and_m_t":"-- TAG-UEINFORMATIONRESPONSESIDELINK-START","paragraph_zero_based":50757},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":50758},{"literal_text_all_w_t_and_m_t":"UEInformationResponseSidelink-r18 ::=       SEQUENCE {","paragraph_zero_based":50759}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["f4bcf624d2e0a95089a013b6434a0ab864b4ddf50b334e421f06d460aa3fb669","4ea312699dfba7d59a556c38297230b7ea1085d8acea0def1c4ca5bbc76af844","6a72009ed1fc43042d8284f883c3a1f9c3b417fe9a0c5d87a4b209e552be342e","c7a79d6f549c7df2c86c1f10410861a9067f4bc2ef8c10b97dc0e8b1de7a1ab4","b386089481fb38cf32d48995d93bef85e6340515d321c91234e9c3e95eea0208","47aa394bd437a91234c150e024b3641b4062a26e1ed80bff91b4d5b5690dbdbf","228a043ea127b2901b168d6c0dcd6c457806065242ca5f4cad77637615dc83fa","fa690812e5bfd98039c8c7766d2d6f68abb5d83ed107f98395d9dc22c3475054","0e4928148129db8f39ed65f0d9f9edb3ce63a3c425edc5897485e256e16365