,"cc25fca27ad10b3d94fa7e9aa12580868dd8606dbd76c167bdf2af96a31ff6a2","238ba7c0933afa9ad663e5b7bb8776a1aaa6f6387f9ca2e54bbe539ec58dff19","7ce1f00fb9f553d13c8483e786930a95968e3aa9350ee04eef654bf3aa7e181a","026cd78afed6b95b885db3ea9b4f314f5766412be011eaf936f50ae9956dbfcd","16190b388769123686ee5fc11c959362b1492756490449f17cb6dfcf3043eec8","ce328f8c456e3510188c059ce90d70ce83cab1ac5c76f04192a9263a20ae5ece","c05c6da01df3a8948ce1bd3f09d674d901a058044ce70e787e8f91005ce38eab","3279a20cbf468c5747f138bb3fb3a580cb5fdcaf1dc8ee09060872adb5eafd8d","5ebf1d1b455b4cf9150b4cb967b10f2a0d11a0c051185f05bca61b868fe0afd6","dda63dece82e2fdede00f0dcc2ed15ab4b213bffcc52aa2ca44bc5b0fdb803a4","657cc81411d4506a71c7e7742b2f1867de3874e2ec59363ce39ecec0dc7698c2","a308421fa6fe9b82423443b01178ae96a15e92be5413cd1204a0a9c91a2672f2","8b587d65a229de338cb5e32b840da89c5aa945dc840a4d9d755a81a2d5d4d4cf","b6f98ab6300113beeecc29f24fc67434925f9a4b4dbbe7a6c98264bd10fd1ec4","9af9377758c2c3cb0a2dfab25d9a40c66c6c3c3624bea957d368c174ecbf74df","ad5baf0aa40a556f8543cda5b54124c9e6621cbd6ac58993d47ecbb438b15535","3ae2f7089c36d027d850099f6547221c8ae687281fe2a34e1e9a1ed1670ec0f6"],"paragraph_range_zero_based":[4968,4991],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx:p4968"}
{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4992},{"literal_text_all_w_t_and_m_t":"-- TAG-RADIOBEARERCONFIG-STOP","paragraph_zero_based":4993},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":4994},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4995},{"literal_text_all_w_t_and_m_t":"DRB-ToAddMod and MRB-ToAddMod field descriptions","paragraph_zero_based":4996},{"literal_text_all_w_t_and_m_t":"cnAssociation","paragraph_zero_based":4997},{"literal_text_all_w_t_and_m_t":"Indicates if the bearer is associated with the eps-bearerIdentity (when connected to EPC) or sdap-Config (when connected to 5GC).","paragraph_zero_based":4998},{"literal_text_all_w_t_and_m_t":"daps-Config","paragraph_zero_based":4999},{"literal_text_all_w_t_and_m_t":"Indicates that the bearer is configured as DAPS bearer. The network does not include this field in an RRCReconfiguration message contained within a LTM-Config IE.","paragraph_zero_based":5000},{"literal_text_all_w_t_and_m_t":"drb-Identity","paragraph_zero_based":5001},{"literal_text_all_w_t_and_m_t":"In case of DC, the DRB identity is unique within the scope of the UE, i.e. an MCG DRB cannot use the same value as a split DRB. For a split DRB the same identity is used for the MCG and SCG parts/indirect path of the configuration.","paragraph_zero_based":5002},{"literal_text_all_w_t_and_m_t":"eps-BearerIdentity","paragraph_zero_based":5003},{"literal_text_all_w_t_and_m_t":"The EPS bearer ID determines the EPS bearer.","paragraph_zero_based":5004},{"literal_text_all_w_t_and_m_t":"mbs-SessionId","paragraph_zero_based":5005},{"literal_text_all_w_t_and_m_t":"Indicates which multicast MBS session the bearer is associated with.","paragraph_zero_based":5006},{"literal_text_all_w_t_and_m_t":"mrb-Identity","paragraph_zero_based":5007},{"literal_text_all_w_t_and_m_t":"Identification of the multicast MRB.","paragraph_zero_based":5008},{"literal_text_all_w_t_and_m_t":"mrb-IdentityNew","paragraph_zero_based":5009},{"literal_text_all_w_t_and_m_t":"New identity of the multicast MRB when mrb-Identity needs to be changed, e.g. as a result of a handover.","paragraph_zero_based":5010},{"literal_text_all_w_t_and_m_t":"n3c-BearerAssociated","paragraph_zero_based":5011},{"literal_text_all_w_t_and_m_t":"Indicates that the radio bearer is associated with the N3C indirect path.","paragraph_zero_based":5012},{"literal_text_all_w_t_and_m_t":"reestablishPDCP","paragraph_zero_based":5013},{"literal_text_all_w_t_and_m_t":"Indicates that PDCP should be re-established. Network sets this to true whenever the security key used for this radio bearer changes. Key change could for example be due to termination point change for the bearer, reconfiguration with sync, resuming an RRC connection, or the first reconfiguration after reestablishment. It is also applicable for LTE procedures when NR PDCP is configured. Network doesn't include this field for DRB if the bearer is configured as DAPS bearer, if the RadioBearerConfig IE is part of an RRCReconfiguration message within the LTM-Config IE, or if the RadioBearerConfig IE is part of an RRCReconfiguration message associated with subsequent CPAC within the ConditionalReconfiguration IE","paragraph_zero_based":5014},{"literal_text_all_w_t_and_m_t":"recoverPDCP","paragraph_zero_based":5015}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["425e3a20534d08bb6eb8232a45b707da7ffab130522b0f7c06b1d82eaf7b4458","32862043a291c1b4bd65a3fff1c9c22aa353c4b0dd98f31c2d6ed458966127a6","1fa2556b01eb90252bbe0baffa14ef051085471e21b1fd75fa67fa26379d8d32","75f77da25065544a241f3c07511982965d734ac18948fb40ddf51abb735b33fc","5df1de4694e564626acbe6f28f2c3d0f12c3b00bcba94b138f0c005d69bf2465","1f650073296e694b7c83186d494e71029c9d538ee89e8a8ec6993c3854f6f1dc","35c90d0979970e76792f9fd1b7a1d31f08b4ab82a8dd3495819d2b5f9837c9b4","9c0711014fb130e34bdd48e5c5ca22fcae7fa8d111f87be0e5ddb433a17631ad","04a4cb9fa42294091eac9fb5380d9812c49940feb2a3568580cc354c7f7ff644","ad5ca917a56c8f5629ac4245b5ddd2c6211f1958476739f5ea274233061b2611","0b707575d9345eb6033785e11a1f5cd1d65969ff72f7ffe11685089365c726c2","c3a1440fd1e7feeeb3a99936647d061e0d0ace5a560cc6bb06e1a3c489df4302","2a96c49938f1c92a1d3df8e5d501da85b7f6f9a126d41dcbda74e3b2ca7d1963","7b37ce24f7470597725a8745fb012a81402ffa3c04679ffb549a2405e301ab62","1a21cfd5020972e5f976ffe51d605d28c8f107076bcb60527307ef173ed90cc4","ff50fb3496a164bc33a0abbc4cef49930251d52a8f342debb7afde599d1c8184","5bf2453cbd1e90ccd926eafbe0e67e44525a122603297e7994139187d1f9bea6","088156aea72f5e7719bc99449179395623504c9ddfbae44861c99d9f74972082","af39dc2d5043641d34e60f7860f1e77c1c4d6bd33278b75422312ba048b1b417","5e5fea3950151b324f957f74d7dd90a4fc22e2534bfc2548e29d9ad74a0ed60d","a7f25fc0b850ce8b25969258780c2f51030c4d397d9f078822328f08ae7fb2bd","63685bfc43de660493a12d331fb9bce344405d241cdbbd616f58efc90375e447","2d0dd4fe393317add42fee5dfcf7e08173b23d922c6f35f785a32ad6dc59c8a5","d534c84174d66e532eb1e6b4af156a8e82939e2c1916720bad1a760b56fb1759"],"paragraph_range_zero_based":[4992,5015],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx:p4992"}
{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates that PDCP should perform recovery according to TS 38.323 [5]. Network doesn't include this field if the bearer is configured as DAPS bearer, if the RadioBearerConfig IE is part of an RRCReconfiguration message within the LTM-Config IE, or if the RadioBearerConfig IE is part of an RRCReconfiguration message associated with subsequent CPAC within the ConditionalReconfiguration IE.","paragraph_zero_based":5016},{"literal_text_all_w_t_and_m_t":"sdap-Config","paragraph_zero_based":5017},{"literal_text_all_w_t_and_m_t":"The SDAP configuration determines how to map QoS flows to DRBs when NR or E-UTRA connects to the 5GC and presence/absence of UL/DL SDAP headers.","paragraph_zero_based":5018},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5019},{"literal_text_all_w_t_and_m_t":"RadioBearerConfig field descriptions","paragraph_zero_based":5020},{"literal_text_all_w_t_and_m_t":"securityConfig","paragraph_zero_based":5021},{"literal_text_all_w_t_and_m_t":"Indicates the security algorithm and key to use for the signalling and data radio bearers configured with the list in this IE RadioBearerConfig. When the field is not included after AS security has been activated, the UE shall continue to use the currently configured keyToUse and security algorithm for the radio bearers reconfigured with the lists in this IE RadioBearerConfig. The field is not included when configuring SRB1 before AS security is activated.","paragraph_zero_based":5022},{"literal_text_all_w_t_and_m_t":"srb3-ToRelease","paragraph_zero_based":5023},{"literal_text_all_w_t_and_m_t":"Release SRB3. SRB3 release can only be done over SRB1 and only at SCG release and reconfiguration with sync.","paragraph_zero_based":5024},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5025},{"literal_text_all_w_t_and_m_t":"SecurityConfig field descriptions","paragraph_zero_based":5026},{"literal_text_all_w_t_and_m_t":"keyToUse","paragraph_zero_based":5027},{"literal_text_all_w_t_and_m_t":"Indicates if the bearers configured with the list in this IE RadioBearerConfig are using the master key or the secondary key for deriving ciphering and/or integrity protection keys. For MR-DC, network should not configure SRB1 and SRB2 with secondary key and SRB3 with the master key. When the field is not included, the UE shall continue to use the currently configured keyToUse for the radio bearers reconfigured with the lists in this IE RadioBearerConfig.","paragraph_zero_based":5028},{"literal_text_all_w_t_and_m_t":"securityAlgorithmConfig","paragraph_zero_based":5029},{"literal_text_all_w_t_and_m_t":"Indicates the security algorithm for the signalling and data radio bearers configured with the list in this IE RadioBearerConfig. When the field is not included, the UE shall continue to use the currently configured security algorithm for the radio bearers reconfigured with the lists in this IE RadioBearerConfig.","paragraph_zero_based":5030},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5031},{"literal_text_all_w_t_and_m_t":"SRB-ToAddMod field descriptions","paragraph_zero_based":5032},{"literal_text_all_w_t_and_m_t":"discardOnPDCP","paragraph_zero_based":5033},{"literal_text_all_w_t_and_m_t":"Indicates that PDCP should discard stored SDU and PDU according to TS 38.323 [5]. Network doesn't include this field if the RadioBearerConfig IE is part of an RRCReconfiguration message associated with subsequent CPAC within the ConditionalReconfiguration IE which is received within a MCG RRCReconfiguration message via SRB1, or if the RadioBearerConfig IE is part of an RRCReconfiguration message within the LTM-Config IE which includes the field ltm-NoSecurityChangeID or ltm-NoResetID.","paragraph_zero_based":5034},{"literal_text_all_w_t_and_m_t":"reestablishPDCP","paragraph_zero_based":5035},{"literal_text_all_w_t_and_m_t":"Indicates that PDCP should be re-established. Network sets this to true whenever the security key used for this radio bearer changes. Key change could for example be due to reconfiguration with sync, for SRB2 when resuming an RRC connection, or at the first reconfiguration after RRC connection reestablishment in NR. For SRB1, when resuming an RRC connection, or at the first reconfiguration after RRC connection reestablishment in NR, the network does not set this field to true. For LTE SRBs using NR PDCP, it could be for handover, RRC connection reestablishment or resume. Network doesn't include this field if any DAPS bearer is configured or if the RadioBearerConfig IE is part of an RRCReconfiguration message within the LTM-Config IE. For SRB3, network doesn't include this field if the RadioBearerConfig IE is part of an RRCReconfiguration message associated with subsequent CPAC within the ConditionalReconfiguration IE.","paragraph_zero_based":5036},{"literal_text_all_w_t_and_m_t":"srb-Identity, srb-Identity-v1700, srb-Identity-v1800, srb-Identity-v1900","paragraph_zero_based":5037},{"literal_text_all_w_t_and_m_t":"Value 1 is applicable for SRB1 only. Value 2 is applicable for SRB2 only. Value 3 is applicable for SRB3 only. Value 4 is applicable for SRB4 only. Value 5 is applicable for SRB5 only. Value 6 is applicable for SRB6 only. If srb-Identity-v1700, srb-Identity-v1800 or srb-Identity-v1900 is received for an SRB, the UE shall ignore srb-Identity (i.e. without suffix) for this SRB.","paragraph_zero_based":5038},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5039}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["4cb38c046519925969ea2701b448c7ebfcaebaa3a465cebe70dd36c3e641e63a","1a7394e6d9790aa7e676f53c13b2ff3fd077acdf3a49b6ac336e5722b96db3b1","68bf3871dee848832415e09c846a08b7514c7c78a3973229d3ea6602ca9d7b1e","69cdfa25679b7f9635d4b99b57aca12f0a087c70e04a58f5ef317e5662cabeb0","054a454532178864909949ecdd044c1c7f5b76542bf4d60e8d63dcc3f34d971f","252b6db48570ca8f7a15bb0626a0f757dd9c0a18b830d6519646987b8b9f8134","7089dee949eb54ba78d9f5e5a3c7fd774a8772c5f7d969f66987b67feacc564a","1d177b87e9e1c41a8fcded9aca365d829577a1886261496f58ddd3f4eb1d77b5","0972d03dfecb5ca401beb6ad490dafe668fc61b90a8dddfacc54436138c5bd95","1595b85e6f5398b5f9e0c23b95cd6978646c821d929ecc79f3ac846ce9103a36","10c031525e37747740cea8f8a03c15e200ae569e1df57470fd5531f0cee9888a","8f99b8c683082aed8ece20358721c1ebaf5480fc6690119973cb812e839d9f54","5efaa49660e60cdf428733dce4472376b996ddb33a02e21b14405640aef160d7","3245bb001fd83e77481c9be3fba1733a7e5bf96ec4ad207da728d5c246150397","d05bdd9cc143cdc28bc722693ee4e2f89ccce5758768220c3d1e55852771ed2a","bb00f6e89a3224a6868abc854cb566fecc9a39a4b17c0011e9489c47fd9180ef","9695cc853f8b9bcd816cfc9d66cc53ba69dbdf3ad813c43aa27b84b8dc9af95e","a3e20de2ef8367f3d2855f137e12691568325ced3978975670ac652216e1d480","522ee61ff4f8cd7a9e77a1e78f37238de60e907a9785ae7ab8cd66f2b9a1911f","61f6bd83c031f66204572990809297568ee4ac098c493c28e376e7074a7c6f03","87b2e5f7ca30681044eafbbf32f8997088cb2d61120df50a52fdc645baf683e2","05a8d854c0036c912acd074fc8bd2d990fbe16e9387b815978660847b90ed6fc","483b919577e194ea8064b1f4307fd78176d5e106a3db9a16f1d19af9ef30d219","6439f85c8f8b7c2af673a025ab00e752592732a08b38ecc4f025b5c70fbe069b"],"paragraph_range_zero_based":[5016,5039],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx:p5016"}
{"fields":{"filename":"R2-2507934.zip::R2-2507934 Corrections to AIML for NR air interface.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":5040},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":5041},{"literal_text_all_w_t_and_m_t":"RBTermChange","paragraph_zero_based":5042},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in case of:","paragraph_zero_based":5043},{"literal_text_all_w_t_and_m_t":"-set up of signalling and data radio bearer,","paragraph_zero_based":5044},{"literal_text_all_w_t_and_m_t":"-change of termination point for the radio bearer between MN and SN.","paragraph_zero_based":5045},{"literal_text_all_w_t_and_m_t":"It is optionally present otherwise, Need S.","paragraph_zero_based":5046},{"literal_text_all_w_t_and_m_t":"RBTermChange1","paragraph_zero_based":5047},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in case of:","paragraph_zero_based":5048},{"literal_text_all_w_t_and_m_t":"-set up of signalling and data radio bearer,","paragraph_zero_based":5049},{"literal_text_all_w_t_and_m_t":"-change of termination point for the radio bearer between MN and SN,","paragraph_zero_based":5050},{"literal_text_all_w_t_and_m_t":"-handover from E-UTRA/EPC or E-UTRA/5GC to NR,","paragraph_zero_based":5051},{"literal_text_all_w_t_and_m_t":"-handover from NR or E-UTRA/EPC to E-UTRA/5GC if the UE supports NGEN-DC.","paragraph_zero_based":5052},{"literal_text_all_w_t_and_m_t":"It is optionally present otherwise, Need S.","paragraph_zero_based":5053},{"literal_text_all_w_t_and_m_t":"PDCP","paragraph_zero_based":5054},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the corresponding DRB/multicast MRB is being setup or corresponding DRB/multicast MRB is reconfigured with NR PDCP or corresponding SRB associated with two RLC entities is being setup or if the number of RLC bearers associated with the DRB/multicast MRB or SRB is changed. The field is optionally present, Need S, if the corresponding SRB associated with one RLC entity is being setup or corresponding SRB is reconfigured with NR PDCP; otherwise the field is optionally present, need M.","paragraph_zero_based":5055},{"literal_text_all_w_t_and_m_t":"DRBSetup","paragraph_zero_based":5056},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the corresponding DRB is being setup; otherwise the field is optionally present, need M.","paragraph_zero_based":5057},{"literal_text_all_w_t_and_m_t":"HO-Conn","paragraph_zero_based":5058},{"literal_text_all_w_t_and_m_t":"The field is mandatory present","paragraph_zero_based":5059},{"literal_text_all_w_t_and_m_t":"-in case of inter-system handover from E-UTRA/EPC to E-UTRA/5GC or NR,","paragraph_zero_based":5060},{"literal_text_all_w_t_and_m_t":"-or when the fullConfig is included in the RRCReconfiguration message and NE-DC/NR-DC is not configured,","paragraph_zero_based":5061},{"literal_text_all_w_t_and_m_t":"-or in case of RRCSetup.","paragraph_zero_based":5062},{"literal_text_all_w_t_and_m_t":"Otherwise the field is optionally present, need N.","paragraph_zero_based":5063}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2c923ef844b31b26bf72e49b8af09884ed1bea6239f8c29d803b9a85603b7844","original_member_sha256":"fca6127e1480323bfb803b07914e61c1b7dcc13de0d3c550e3d33fe0e7ccc48f","paragraph_ElementTree_utf8_XML_sha256":["f1a805bcec61d56369e9f4b54f34678fe1e786eca34de88c8c787f21fa8978a4","e4d0e03d50ea62553eb93c400cc3ca100a663429fe49e5e21f91380639d0d35b","6be02660a286f789c97b9c832f5a8b172693d3f7476ab695a2012cca4d467d84","53f5fed04f3bc53088019d207f9576d1a9391e31e2cd11fd4717db6e154af1c5","867d3fb4fce765e39ee3d546ded607452908d8c6c8a30079bd785dfc122440ed","d4ae6555350f5865b3efef64c1df802841ac4cf5e17fc48163c434b7806739a6","91859c6b1b56