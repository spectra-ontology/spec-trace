{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    gNB-ID-Length-r17                   INTEGER (22..32)                                                OPTIONAL       -- Need R","paragraph_zero_based":23352},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":23353},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":23354},{"literal_text_all_w_t_and_m_t":"-- TAG-PLMN-IDENTITYINFOLIST-STOP","paragraph_zero_based":23355},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23356},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23357},{"literal_text_all_w_t_and_m_t":"PLMN-IdentityInfo field descriptions","paragraph_zero_based":23358},{"literal_text_all_w_t_and_m_t":"cellReservedForOperatorUse","paragraph_zero_based":23359},{"literal_text_all_w_t_and_m_t":"Indicates whether the cell is reserved for operator use (per PLMN), as defined in TS 38.304 [20]. This field is ignored by IAB-MT.","paragraph_zero_based":23360},{"literal_text_all_w_t_and_m_t":"gNB-ID-Length","paragraph_zero_based":23361},{"literal_text_all_w_t_and_m_t":"Indicates the length of the gNB ID out of the 36-bit long cellIdentity.","paragraph_zero_based":23362},{"literal_text_all_w_t_and_m_t":"iab-Support","paragraph_zero_based":23363},{"literal_text_all_w_t_and_m_t":"This field combines both the support of IAB and the cell status for IAB. If the field is present, the cell supports IAB and the cell is also considered as a candidate for cell (re)selection for IAB-node; if the field is absent, the cell does not support IAB and/or the cell is barred for IAB-node.","paragraph_zero_based":23364},{"literal_text_all_w_t_and_m_t":"trackingAreaCode","paragraph_zero_based":23365},{"literal_text_all_w_t_and_m_t":"Indicates Tracking Area Code to which the cell indicated by cellIdentity field belongs. The absence of the field indicates that the cell only supports PSCell/SCell functionality (per PLMN) or is an NTN cell.","paragraph_zero_based":23366},{"literal_text_all_w_t_and_m_t":"trackingAreaList","paragraph_zero_based":23367},{"literal_text_all_w_t_and_m_t":"List of Tracking Areas to which the cell indicated by cellIdentity field belongs. If this field is present, network does not configure trackingAreaCode. Total number of different TACs across different PLMN-IdentityInfos shall not exceed maxTAC. This field is only present in an NTN cell.","paragraph_zero_based":23368},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23369},{"literal_text_all_w_t_and_m_t":"–PLMN-IdentityList2","paragraph_zero_based":23370},{"literal_text_all_w_t_and_m_t":"Includes a list of PLMN identities.","paragraph_zero_based":23371},{"literal_text_all_w_t_and_m_t":"PLMN-IdentityList2 information element","paragraph_zero_based":23372},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":23373},{"literal_text_all_w_t_and_m_t":"-- TAG-PLMNIDENTITYLIST2-START","paragraph_zero_based":23374},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23375}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["b722e6f1a12ee7a1f06da0a2b8cfb2c1070f17fdaf45859e8b0c6826c82258d3","a2c91853a86b9ca6ae1ae80449d5cbe93f0a6c0c8eff5b59a3bab6fb440a7d4f","aa272ab99c4ab4cadb52de1291d33c5f4b56e082f6184f1ad72ced0e1e8281ca","afcd73762abd0524eb9425c557759c574e4987c9e8cf6d3d8b8286f3e8e701fe","9c41fdf79b3a2e6b99a49fd0d658a42d6f9dd2ba0d3c712eaf7dd76b49cf092f","79bcb7bd04ca40b190ae44a66585a4509db12da554f85c66e4df0ea9a554a5d7","a06137514c5659ed00f3caaaaa6e169e57d61e4620f1f5ccc10c58735aac113d","6c46419f8253bdc7014871741107b83d1