{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30912},{"literal_text_all_w_t_and_m_t":"ScalingFactorSidelink-r16 ::=       ENUMERATED {f0p4, f0p75, f0p8, f1}","paragraph_zero_based":30913},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30914},{"literal_text_all_w_t_and_m_t":"IntraBandPowerClass-r16 ::=         ENUMERATED {pc2, pc3, spare6, spare5, spare4, spare3, spare2, spare1}","paragraph_zero_based":30915},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30916},{"literal_text_all_w_t_and_m_t":"SRS-SwitchingAffectedBandsNR-r17 ::= BIT STRING (SIZE (1..maxSimultaneousBands))","paragraph_zero_based":30917},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30918},{"literal_text_all_w_t_and_m_t":"-- TAG-BANDCOMBINATIONLIST-STOP","paragraph_zero_based":30919},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":30920},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30921},{"literal_text_all_w_t_and_m_t":"BandCombination field descriptions","paragraph_zero_based":30922},{"literal_text_all_w_t_and_m_t":"BandCombinationList-v1540, BandCombinationList-v1550, BandCombinationList-v1560, BandCombinationList-v1570, BandCombinationList-v1580, BandCombinationList-v1590, BandCombinationList-v15g0, BandCombinationList-v15n0, BandCombinationList-v1610, BandCombinationList-v1630, BandCombinationList-v1640, BandCombinationList-v1650, BandCombinationList-v1680, BandCombinationList-v1690, BandCombinationList-v16a0, BandCombinationList-v1700, BandCombinationList-v1720, BandCombinationList-v1730, BandCombinationList-v1760","paragraph_zero_based":30923},{"literal_text_all_w_t_and_m_t":"The UE shall include the same number of entries, and listed in the same order, as in BandCombinationList (without suffix). If the field is included in supportedBandCombinationListNEDC-Only-v1610, the UE shall include the same number of entries, and listed in the same order, as in BandCombinationList of supportedBandCombinationListNEDC-Only (without suffix) field.","paragraph_zero_based":30924},{"literal_text_all_w_t_and_m_t":"If the field is included in supportedBandCombinationListNEDC-Only-v15a0, the UE shall include the same number of entries, and listed in the same order, as in BandCombinationList (without suffix) of supportedBandCombinationListNEDC-Only (without suffix) field.","paragraph_zero_based":30925},{"literal_text_all_w_t_and_m_t":"BandCombinationList-UplinkTxSwitch-r16, BandCombinationList-UplinkTxSwitch-v1630, BandCombinationList-UplinkTxSwitch-v1640, BandCombinationList-UplinkTxSwitch-v1650, BandCombinationList-UplinkTxSwitch-v1690, BandCombinationList-UplinkTxSwitch-v16a0, BandCombinationList-UplinkTxSwitch-v16e0, BandCombinationList-UplinkTxSwitch-v1700, BandCombinationList-UplinkTxSwitch-v1720, BandCombinationList-UplinkTxSwitch-v1730, BandCombinationList-UplinkTxSwitch-v1760","paragraph_zero_based":30926},{"literal_text_all_w_t_and_m_t":"The UE shall include the same number of entries, and listed in the same order, as in BandCombinationList-UplinkTxSwitch-r16.","paragraph_zero_based":30927},{"literal_text_all_w_t_and_m_t":"For the field of supportedBandCombinationList-UplinkTxSwitch-v1700, if the UE does not support 2Tx-2Tx switching for a given band combination, the field of supportedBandPairListNR-v1700 in the corresponding entry is absent.","paragraph_zero_based":30928},{"literal_text_all_w_t_and_m_t":"ca-ParametersNRDC","paragraph_zero_based":30929},{"literal_text_all_w_t_and_m_t":"If the field is included for a band combination in the NR capability container, the field indicates support of NR-DC. Otherwise, the field is absent.","paragraph_zero_based":30930},{"literal_text_all_w_t_and_m_t":"featureSetCombinationDAPS","paragraph_zero_based":30931},{"literal_text_all_w_t_and_m_t":"If this field is present for a band combination, it reports the feature set combination supported for the band combination when any DAPS bearer is configured.","paragraph_zero_based":30932},{"literal_text_all_w_t_and_m_t":"ne-DC-BC","paragraph_zero_based":30933},{"literal_text_all_w_t_and_m_t":"If the field is included for a band combination in the MR-DC capability container, the field indicates support of NE-DC. Otherwise, the field is absent.","paragraph_zero_based":30934},{"literal_text_all_w_t_and_m_t":"supportedBandPairListNR-r16, supportedBandPairListNR-v1700","paragraph_zero_based":30935}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["508bb1c96b1cccb89c20099b678d2f81318dba91605c7bd93e6f315ff2a0446f","f2b7df0a2e37043012ea89812c64cfdd9f50b915b9cfc2db776038a4101f9334","0468c7c7384c84b4eff473afbc3ca33d334d0f592a4bcbf84399e9d6facd92f0","5c0dc5a322541a877688b31825f7e8ad03ec759602fc6b1dd747144b8cc970db","fc1e0348459ad0f19d3ba3f443d0d3fc1fa0fbfffbd5d1ba0ed5f0105f11a952","3d367c82e82937ec7ec074a3b0793fe0935ca63d79eedd4aa5fd472f17f45708","ae91ad7f5feddc84e6103061f077f147352fa3cb4d1df732efd905d88fdc531e","7a3bd0b7d7df8dee7d27a79a55c44f8625f14fca73b2f3d53ce1dc976d667af8","89e3616c92363178aa8557b830e7af0c101d1e2cbba3a3db016aab3c56744678","32f80f312db386195212b9e8c23935fbd419ab9a1336d4698c2b71df6a67d856","15d20ce8323e6ba40dd6f37b86748eb97a981419c4c4abcdefdcd437c65ae5e9","b14da38985106ef41a86493ba50eca9dd2c174bdb17471ad8f02ace1feceadb8","5388dd341c345deccf5931721d5335770a5d315e7b6b1babdfaeaf0c6e9546d6","b41ef84017deca2fc17caaad4fa38f369acbb7df8d391fab2b14ac2858a5477b","fed19aa6129dcff29ca4506f38d213d973d1696edea4990258a9c3f1dd7345bd","303c82cbc6066f749277a556af240aead23f3efa8d8d4374a3d69e10391aff46","780ab17f01b55e9028bc6aa95d8e3648ba8576e6122e0c4f12d84f38c315733a","9eec676873a248fde6936e8096c622b66eb434bfb34e644544c1bcdba488c983","f5a4b8ebe0d81a3d1356256e7d2d96893196827265addb8791f20b078167fa70","b6ac68ea01c15c83d778afc6502d725db395464c5734c5a54adb5eb67598b91e","f8926feb559770731bf638ca502ced40bc6b9e97761e57ae2181fa4a07f1589a","2df1103408cdfab53e36df7db24ce78ed70411d54dc2db5dae493cba3a948b84","e5019aaa3c5c625385868db0cc0cc66fb05aaac1d234748cd831705269170d6f","d94dd85efcffa8120de79cf8daa7e5e242cd1dd521354b2742748cc9288b7734"],"paragraph_range_zero_based":[30912,30935],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p30912"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates a list of band pair supporting UL Tx switching as defined in TS 38.101-1 [15] for a given band combination.","paragraph_zero_based":30936},{"literal_text_all_w_t_and_m_t":"A UE supporting 2Tx-2Tx switching should include both of supportedBandPairListNR-r16 and supportedBandPairListNR-v1700. And the UE shall include the same number of entries listed in the same order as in supportedBandPairListNR-r16.","paragraph_zero_based":30937},{"literal_text_all_w_t_and_m_t":"If the UE does not support 2Tx-2Tx switching for a given band pair, the field of uplinkTxSwitchingPeriod2T2T in the corresponding entry is absent.","paragraph_zero_based":30938},{"literal_text_all_w_t_and_m_t":"srs-SwitchingTimesListNR","paragraph_zero_based":30939},{"literal_text_all_w_t_and_m_t":"Indicates, for a particular pair of NR bands, the RF retuning time when switching between a NR carrier corresponding to this band entry and another (PUSCH-less) NR carrier corresponding to the band entry in the order indicated below:","paragraph_zero_based":30940},{"literal_text_all_w_t_and_m_t":"-For the first NR band, the UE shall include the same number of entries for NR bands as in bandList, i.e. first entry corresponds to first NR band in bandList and so on,","paragraph_zero_based":30941},{"literal_text_all_w_t_and_m_t":"-For the second NR band, the UE shall include one entry less, i.e. first entry corresponds to the second NR band in bandList and so on","paragraph_zero_based":30942},{"literal_text_all_w_t_and_m_t":"-And so on","paragraph_zero_based":30943},{"literal_text_all_w_t_and_m_t":"srs-SwitchingTimesListEUTRA","paragraph_zero_based":30944},{"literal_text_all_w_t_and_m_t":"Indicates, for a particular pair of E-UTRA bands, the RF retuning time when switching between an E-UTRA carrier corresponding to this band entry and another (PUSCH-less) E-UTRA carrier corresponding to the band entry in the order indicated below:","paragraph_zero_based":30945},{"literal_text_all_w_t_and_m_t":"-For the first E-UTRA band, the UE shall include the same number of entries for E-UTRA bands as in bandList, i.e. first entry corresponds to first E-UTRA band in bandList and so on,","paragraph_zero_based":30946},{"literal_text_all_w_t_and_m_t":"-For the second E-UTRA band, the UE shall include one entry less, i.e. first entry corresponds to the second E-UTRA band in bandList and so on","paragraph_zero_based":30947},{"literal_text_all_w_t_and_m_t":" -And so on","paragraph_zero_based":30948},{"literal_text_all_w_t_and_m_t":"srs-TxSwitch","paragraph_zero_based":30949},{"literal_text_all_w_t_and_m_t":"Indicates supported SRS antenna switch capability for the associated band. If the UE indicates support of SRS-SwitchingTimeNR, the UE is allowed to set this field for a band with associated FeatureSetUplinkId set to 0 for SRS carrier switching.","paragraph_zero_based":30950},{"literal_text_all_w_t_and_m_t":"uplinkTxSwitchingBandParametersList-v1700","paragraph_zero_based":30951},{"literal_text_all_w_t_and_m_t":"Indicates a list of per band per band combination capabilities for UL Tx switching.","paragraph_zero_based":30952},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30953},{"literal_text_all_w_t_and_m_t":"–BandCombinationListSidelinkEUTRA-NR","paragraph_zero_based":30954},{"literal_text_all_w_t_and_m_t":"The IE BandCombinationListSidelinkEUTRA-NR contains a list of V2X sidelink and NR sidelink band combinations.","paragraph_zero_based":30955},{"literal_text_all_w_t_and_m_t":"BandCombinationListSidelinkEUTRA-NR information element","paragraph_zero_based":30956},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":30957},{"literal_text_all_w_t_and_m_t":"-- TAG-BANDCOMBINATIONLISTSIDELINKEUTRANR-START","paragraph_zero_based":30958},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30959}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["167b63c2d0750cc3ce4f5916359b12c96f12773e1fc0f7db5ec4885c338233cb","fe93d2617ddf5877b3bf2f88ae1ee765f34efbab5afc48f4ffdcdab2331af0bb","b93564c8b1cd4de0267cff4f2148e2963e29e56d1838c445ebe77690ef162e0a","f65b8d34eb36d5316794b75b5f67c290fac3775063f2a4381ac978409140d1b4","68a962df6dcb012e2dcd6b6d686c2ee244abee7b07b8fffce262fe8296f411a7","7931cef14edae1b4dbd29b32708c204b03c5d997b9ac36bb64b65c3546e1b212","0d79bc8ea040049c3f2c0f564381e6b2363ba6002fe6383515e39c394319ab36","b2947f90d69f35f55ea834127b3b51c2810d88151e8925706363fdb13be7b354","da8cb9ce8cad2c836f45121aae2d398a85d72974f9b0118966f23ab926639134","6406498a069fcb962f633443786be74d2ff359f1e7426db03a8b941710444c1e","795408f3a4aefc3328de771e6b7aa4c56de243fe41b0823dbc24e59f3c102eca","2207c6fb3d72587e7ee4721e9c8ee74a051920aef699b3a3b574460c13d7a8b5","dc466fed7ad92e83076a9150594dc81b83a113cd4f14edf09ac8822a16149eb1","00e5881de8281678817d0942aceb67a8e84ea60fec67077ac52b4ee1a5159db3","45437072b19ccb5b429ea9d2b67af7e188bfdcb22bdaf13a2ffdd7cdff8230fa","e3f45e2d98f971a3ca951ee8b137e3266d60ad2c7a4806bc83d5add5b7ed8cd5","44fb57dc4518dfa0bd43cac95179b6f2b01cff66d07615c8f307f6f2591b961a","7f8266850fc17ea7e698c0c8f4dddc1cf0072d1a2af90249ed64aee271922089","2c0a35ef6239eaa816edd73be2f6e1f9bf816b6a2f5f77b55705ae7141f941f6","c8445a903c8d33ab8b6dd26657365bd8ffff57089c1e7ead4ce3101e5c865501","ddc294321a93be9c5589dcd3fa0d63cb9f9cbe214ceede1a86df889e9c2ba85d","a23adc9760204b11402e7ebd4101172c2395294b833d3d1d54140ac2c4d02d0f","eaddc4c30a01b2b82531fffd914408dbbf405b36f8940c4c009952256d2fc40e","d2309a493ef7aa420b3860be1fc50b2e52e45fef5bb0775edc5cb2072c13512f"],"paragr