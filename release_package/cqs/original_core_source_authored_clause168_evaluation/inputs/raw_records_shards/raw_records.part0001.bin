{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    subcarrierSpacing                   SubcarrierSpacing,","paragraph_zero_based":27120},{"literal_text_all_w_t_and_m_t":"    carrierBandwidth                    INTEGER (1..maxNrofPhysicalResourceBlocks),","paragraph_zero_based":27121},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":27122},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":27123},{"literal_text_all_w_t_and_m_t":"    txDirectCurrentLocation         INTEGER (0..4095)                                       OPTIONAL            -- Need S","paragraph_zero_based":27124},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":27125},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27126},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27127},{"literal_text_all_w_t_and_m_t":"-- TAG-SCS-SPECIFICCARRIER-STOP","paragraph_zero_based":27128},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27129},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27130},{"literal_text_all_w_t_and_m_t":"SCS-SpecificCarrier field descriptions","paragraph_zero_based":27131},{"literal_text_all_w_t_and_m_t":"carrierBandwidth","paragraph_zero_based":27132},{"literal_text_all_w_t_and_m_t":"Width of this carrier in number of PRBs (using the subcarrierSpacing defined for this carrier) (see TS 38.211 [16], clause 4.4.2).","paragraph_zero_based":27133},{"literal_text_all_w_t_and_m_t":"offsetToCarrier","paragraph_zero_based":27134},{"literal_text_all_w_t_and_m_t":"Offset in frequency domain between Point A (lowest subcarrier of common RB 0) and the lowest usable subcarrier on this carrier in number of PRBs (using the subcarrierSpacing defined for this carrier). The maximum value corresponds to 275*8-1. See TS 38.211 [16], clause 4.4.2.","paragraph_zero_based":27135},{"literal_text_all_w_t_and_m_t":"txDirectCurrentLocation","paragraph_zero_based":27136},{"literal_text_all_w_t_and_m_t":"Indicates the downlink Tx Direct Current location for the carrier. A value in the range 0..3299 indicates the subcarrier index within the carrier. The values in the value range 3301..4095 are reserved and ignored by the UE. If this field is absent for downlink within ServingCellConfigCommon and ServingCellConfigCommonSIB, the UE assumes the default value of 3300 (i.e. \"Outside the carrier\"). (see TS 38.211 [16], clause 4.4.2). Network does not configure this field via ServingCellConfig or for uplink carriers.","paragraph_zero_based":27137},{"literal_text_all_w_t_and_m_t":"subcarrierSpacing","paragraph_zero_based":27138},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing of this carrier. It is used to convert the offsetToCarrier into an actual frequency.","paragraph_zero_based":27139},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":27140},{"literal_text_all_w_t_and_m_t":"FR1:    15 or 30 kHz","paragraph_zero_based":27141},{"literal_text_all_w_t_and_m_t":"FR2-1:  60 or 120 kHz","paragraph_zero_based":27142},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":27143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["e4dc5be1028edbd87685ffe2b3cf23b2091bf8a8577da6584e7a0a75137b8768","e3945bcfa012720cbfd41117f42d743b1265934cc3118795abc9d4fcc058b421","3a91701a7b9bc11c26b0be201e3c099ba663dcc844316949bee5ed38fe6db28b","b4a19633bda957e63a3039921238dbf90491d18977956ce4841c7be999e83e37","8d5ff9f54121c62ec69120d9b6aecad7e7022980bfc22102dee2299cc61102fc","065a2cb2dbc14d2ca8d3839c9abf002e1f03b36b1c3522ee102493fbb2da2871","ccc13a3d1f2fcea8c5883b69ebd7d6d809771ffd5bcae8124e00b1b7aa70de66","70cdbf8ae9b0c4b1e8a766d1cb1d32d920716f66aac770765a5aa1a75a3b6d68","3c194956a01247173e18f72338300620d6b18484e52ce4a7130851e1d7824e9e","2c27624ecc7dcbfd35d0499083ca064ce1c1eeb7b4dde477367a93d14a00963b","f92fe22b354d467803de4a8d6b7c21936c69ad06ec7de96094f2bb42b49aa644","f8729fc8c8593287451ec7436565a21afe976808bc689241f4c3fe3f45c311c9","757c57254abcdc39224ebda31f20ec00093d4181d72244cff20bab6f86521801","26d606bda156f469b773767c3cb71373f70e42457aa384d7485bf29dff03d63e","e354b6678b9abb1209544bbaa650d8e29319335eb665f4985dea99e4f6fcfa93","c3e0cfbbd1d7ca8ae423ecb61502e466de11899e8e5676af6cd7f0c98253cad3","88b8cd71b84586b3258b1d3656d9c97aaa5ab63632399cb05448fe57bf1f3c15","847d88ea97455afb8569905cbcbd50db323d55abb3c2948d5a3a458cbb419576","9c40e8706668dd3859aec5d7af72afb5421d7aa2878ab651c3e34d81e460086c","c0c8726c93b9d2898437cd2417917aabc39982c864c3105159c8ae2f01f1f128","12dbc1610109d41119c369a38102b8e707d94f99e0fdcdf23270af375b0e5531","7bbdf4609b4551c8d730f6ad1970b090341e64981d8e28663670894a3d31a6c6","96f6136b44a18afb664e639a87853b509581b4f75fc646b355a8ed704f3c2140","a929966938dcd601eb7c9fe0c30640efe4b51e93117856bfaf33ef8273b178ef"],"paragraph_range_zero_based":[27120,27143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p27120"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27144},{"literal_text_all_w_t_and_m_t":"–SDAP-Config","paragraph_zero_based":27145},{"literal_text_all_w_t_and_m_t":"The IE SDAP-Config is used to set the configurable SDAP parameters for a data radio bearer. All configured instances of SDAP-Config with the same value of pdu-Session correspond to the same SDAP entity as specified in TS 37.324 [24].","paragraph_zero_based":27146},{"literal_text_all_w_t_and_m_t":"SDAP-Config information element","paragraph_zero_based":27147},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27148},{"literal_text_all_w_t_and_m_t":"-- TAG-SDAP-CONFIG-START","paragraph_zero_based":27149},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27150},{"literal_text_all_w_t_and_m_t":"SDAP-Config ::=                     SEQUENCE {","paragraph_zero_based":27151},{"literal_text_all_w_t_and_m_t":"    pdu-Session                         PDU-SessionID,","paragraph_zero_based":27152},{"literal_text_all_w_t_and_m_t":"    sdap-HeaderDL                       ENUMERATED {present, absent},","paragraph_zero_based":27153},{"literal_text_all_w_t_and_m_t":"    sdap-HeaderUL                       ENUMERATED {present, absent},","paragraph_zero_based":27154},{"literal_text_all_w_t_and_m_t":"    defaultDRB                          BOOLEAN,","paragraph_zero_based":27155},{"literal_text_all_w_t_and_m_t":"    mappedQoS-FlowsToAdd                SEQUENCE (SIZE (1..maxNrofQFIs)) OF QFI                                 OPTIONAL, -- Need N","paragraph_zero_based":27156},{"literal_text_all_w_t_and_m_t":"    mappedQoS-FlowsToRelease            SEQUENCE (SIZE (1..maxNrofQFIs)) OF QFI                                 OPTIONAL, -- Need N","paragraph_zero_based":27157},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":27158},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27159},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27160},{"literal_text_all_w_t_and_m_t":"QFI ::=                             INTEGER (0..maxQFI)","paragraph_zero_based":27161},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27162},{"literal_text_all_w_t_and_m_t":"PDU-SessionID ::=                   INTEGER (0..255)","paragraph_zero_based":27163},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27164},{"literal_text_all_w_t_and_m_t":"-- TAG-SDAP-CONFIG-STOP","paragraph_zero_based":27165},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27166},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["662581e3e4529389eb02107fc86de87658ca236cb9040d469fbb1bba5e417991","97a6e925b2bc9435b22ce37700554c56de946815c197b9ff1eca05a7f106c2d8","41062b19c1871ba903902ea1c49cf6d0c68874687e77444f59aa2f3ceff84c25","6f448acec15590193b21bd344413c44ec28466feab7b6db37b128e89006fa582","3fe2eb2d4043e36a06a3f81e711bac5b7e37af0597b0ea901462eb739f873c38","85d8410fab840a336173ef7159bd6dd03d3872790bc4c5aafb40720db0a36892","1eab24ec5b7c3aa8e16fa6e2ee866d3f332003cab176600e6c926297d6249a99","e9bd854c6eedaee03c61dfd77535c7779d0bf8b48fd9f0d0ac3fbfac923739d5","adf0e169575b19a2f979481f7d6add4eaf53c0722814faa108d1073ebb399688","5f35288a259b13f14caecb77c58322c725efdb6bf9da0c694b9cd208b13db166","1a46cd9b82b47ee39ae4f929dca77b214a682b6cea6947d84fbdc710936f51ba","74a3c805bc3ab1eda1455796989363398c5259a86e8f8e670fadb94bd8c9fd63","3913e2d496e08888c8de931ae43cf7fce4bcb74882567b059249bda656b4dc2a","c31213229e0c3c5452e7f47bb16fd666e202b6bc6d5f876fc68c817e475210be","d4315720b52b8cffb6b82ff075b1a9fed3880e74ebb31f9f7d4de9cc2361367f","deda273f614d5b1038d7d8f49461014bb9896674d895848080e0270347da044c","879d1507399da500e7b7c82d1d040ef086e01b56fb002e1b5831e8033296bd07","3b88afd647cc4ee25578f10db6452b0deadd28c95bb9d8120cf9133c670faa46","0c1aa2c101d870b485ca30ec8932c0c8c4bf190b61b07487aadf459cbee87fce","783ba97f9c8006651a41e59b7f66ea4af1c0c8b6df37337d016425b219a620b5","a751b292fb0394e398179c1ac65e004ee2773faef20c8e46a3ec95b5321d9aa6","a41ca9eb2e0afe2363709a6da34d6b2977b9412d560a729d091cca7e793ecfad","3ad660f914d4755435c9f305b82c4d1547f48171f76d9c08e415ec7b80f70c64","6b100af25e7edc65ef97c901f85c48e9519e002e5a65562552e9076156ac99bc"],"paragraph_range_zero_based":[27144,27167],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p27144"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SDAP-Config field descriptions","paragraph_zero_based":27168},{"literal_text_all_w_t_and_m_t":"defaultDRB","paragraph_zero_based":27169},{"literal_text_all_w_t_and_m_t":"Indicates whether or not this is the default DRB for this PDU session. Among all configured instances of SDAP-Config with the same value of pdu-Session, this field shall be set to true in at most one instance of SDAP-Config and to false in all other instances.","paragraph_zero_based":27170},{"literal_text_all_w_t_and_m_t":"mappedQoS-FlowsToAdd","paragraph_zero_based":27171},{"literal_text_all_w_t_and_m_t":"Indicates the list of QFIs of UL QoS flows of the PDU session to be additionally mapped to this DRB. A QFI value can be included at most once in all configured instances of SDAP-Config with the same value of pdu-Session. For QoS flow remapping, the QFI value of the remapped QoS flow is only included in mappedQoS-FlowsToAdd in sdap-Config corresponding to the new DRB and not included in mappedQoS-FlowsToRelease in sdap-Config corresponding to the old DRB.","paragraph_zero_based":27172},{"literal_text_all_w_t_and_m_t":"mappedQoS-FlowsToRelease","paragraph_zero_based":27173},{"literal_text_all_w_t_and_m_t":"Indicates the list of QFIs of QoS flows of the PDU session to be released from existing QoS flow to DRB mapping of this DRB. ","paragraph_zero_based":27174},{"literal_text_all_w_t_and_m_t":"pdu-Session","paragraph_zero_based":27175},{"literal_text_all_w_t_and_m_t":"Identity of the PDU session whose QoS flows are mapped to the DRB.","paragraph_zero_based":27176},{"literal_text_all_w_t_and_m_t":"sdap-HeaderUL","paragraph_zero_based":27177},{"literal_text_all_w_t_and_m_t":"Indicates whether or not a SDAP header is present for UL data on this DRB. The field cannot be changed after a DRB is established. The network sets this field to present if the field defaultDRB is set to true.","paragraph_zero_based":27178},{"literal_text_all_w_t_and_m_t":"sdap-HeaderDL","paragraph_zero_based":27179},{"literal_text_all_w_t_and_m_t":"Indicates whether or not a SDAP header is present for DL data on this DRB. The field cannot be changed after a DRB is established.","paragraph_zero_based":27180},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27181},{"literal_text_all_w_t_and_m_t":"–SearchSpace","paragraph_zero_based":27182},{"literal_text_all_w_t_and_m_t":"The IE SearchSpace defines how/where to search for PDCCH candidates. Each search space is associated with one ControlResourceSet. For a scheduled SCell in the case of cross carrier scheduling, except for nrofCandidates, all the optional fields are absent (regardless of their presence conditions). For a scheduled SpCell in the case of the cross carrier scheduling, if the search space is linked to another search space in the scheduling SCell, all the optional fields of this search space in the scheduled SpCell are absent (regardless of their presence conditions) except for nrofCandidates.","paragraph_zero_based":27183},{"literal_text_all_w_t_and_m_t":"SearchSpace information element","paragraph_zero_based":27184},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27185},{"literal_text_all_w_t_and_m_t":"-- TAG-SEARCHSPACE-START","paragraph_zero_based":27186},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27187},{"literal_text_all_w_t_and_m_t":"SearchSpace ::=                         SEQUENCE {","paragraph_zero_based":27188},{"literal_text_all_w_t_and_m_t":"    searchSpaceId                           SearchSpaceId,","paragraph_zero_based":27189},{"literal_text_all_w_t_and_m_t":"    controlResourceSetId                    ControlResourceSetId                                        OPTIONAL,   -- Cond SetupOnly","paragraph_zero_based":27190},{"literal_text_all_w_t_and_m_t":"    monitoringSlotPeriodicity