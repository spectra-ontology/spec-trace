t":"Physical cell identity of a cell in the cell list.","paragraph_zero_based":19652},{"literal_text_all_w_t_and_m_t":"cellIndividualOffset","paragraph_zero_based":19653},{"literal_text_all_w_t_and_m_t":"Cell individual offset applicable to a specific cell. Value dB-24 corresponds to -24 dB, dB-22 corresponds to -22 dB and so on.","paragraph_zero_based":19654},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19655}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["6fb2a65f36a0f62afe76213bda182e00c9a024a36a9c3ac369ddc92a0dc7b732","212cc7b4eebaf045928f2def6d2bfcd5cd6c4ca769ef09ad1b723d6ddf98d801","42e246652fbef192eaa06246150c8e4cced604b3a5db5757dee9a49349d6963c","778ef998df906d66cc610d826e18dd59fd5371cc98a4561e1b26b012bab04896","faa1f635d9e6806db5221902e772d4ed0c3b561a06e99b4ac55a71c4f0cdb1ed","71f664f14e85bd5b80b7e3d646f19733a102d9a7d9cdb5c6e22be2f5b299e49f","ebd873a4666d35a618d604acc0050d4f28a6f88bb5ba20fc87a12081600cd009","64a9c5f20bc69f2dd48b975cf332b3a6aef46c28018ddb591b0e52991b8ad5d9","5a6ba7e582bc62a3daaabb0a0b15e95c858ecbcd4e62f70fc2c18ed1dadeea9b","612ca77ab87eb1126df998258fe251f32a89046d9f4b3379aaee037a6698ef44","0a362cfbd124604913c073baa409a94a2d63c25981ed43d11879f2875b86886f","e55ace655ee0abb8c52a1ccc824215b8f1c665fbecca346254bac3e17c58d3a1","432aff71785891517fca72c59faadb3ee40832945c96f0ff49110eaedb0b642b","50a4b0873417017ecf478f95a70d8da095ab7f698bd83e59974fe693d89b3ac3","856f581a9fb2da8d74db4b06dd60c2552619a3215f7c4c6afe472f029abf9c8d","760aba60afc7da42b795464f24eaae11ac080dfa69391166115d10cf706d928b","88045c26ca57f5dbb3b106725a6fdfc2038f86cf611e2b17f5da1d8c6d037ef8","2bff1103b9bc94692e2deaf480d0c9aa2e594dd766e7ab66abf3bfa8b4e1db97","03e32a7c69f5