{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39888},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39889},{"literal_text_all_w_t_and_m_t":"-- TAG-DRX-CONFIGPTM-STOP","paragraph_zero_based":39890},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39891},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39892},{"literal_text_all_w_t_and_m_t":"DRX-Config-PTM field descriptions","paragraph_zero_based":39893},{"literal_text_all_w_t_and_m_t":"drx-HARQ-RTT-Timer-DL-PTM","paragraph_zero_based":39894},{"literal_text_all_w_t_and_m_t":"Value in number of symbols of the CFR where the transport block was received.","paragraph_zero_based":39895},{"literal_text_all_w_t_and_m_t":"drx-InactivityTimerPTM","paragraph_zero_based":39896},{"literal_text_all_w_t_and_m_t":"Value in multiple integers of 1 ms. ms0 corresponds to 0, ms1 corresponds to 1 ms, ms2 corresponds to 2 ms, and so on.","paragraph_zero_based":39897},{"literal_text_all_w_t_and_m_t":"drx-LongCycleStartOffsetPTM","paragraph_zero_based":39898},{"literal_text_all_w_t_and_m_t":"drx-LongCycle-PTM in ms and drx-StartOffset-PTM in multiples of 1 ms.","paragraph_zero_based":39899},{"literal_text_all_w_t_and_m_t":"drx-onDurationTimerPTM","paragraph_zero_based":39900},{"literal_text_all_w_t_and_m_t":"Value in multiples of 1/32 ms (subMilliSeconds) or in ms (milliSecond). For the latter, value ms1 corresponds to 1 ms, value ms2 corresponds to 2 ms, and so on.","paragraph_zero_based":39901},{"literal_text_all_w_t_and_m_t":"drx-RetransmissionTimer-DL-PTM","paragraph_zero_based":39902},{"literal_text_all_w_t_and_m_t":"Value in number of slot lengths of the CFR where the transport block was received. value sl0 corresponds to 0 slots, sl1 corresponds to 1 slot, sl2 corresponds to 2 slots, and so on.","paragraph_zero_based":39903},{"literal_text_all_w_t_and_m_t":"drx-SlotOffsetPTM","paragraph_zero_based":39904},{"literal_text_all_w_t_and_m_t":"Value in 1/32 ms. Value 0 corresponds to 0 ms, value 1 corresponds to 1/32 ms, value 2 corresponds to 2/32 ms, and so on.","paragraph_zero_based":39905},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39906},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":39907},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":39908},{"literal_text_all_w_t_and_m_t":"HARQFeedback","paragraph_zero_based":39909},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if HARQ feedback is enabled for a G-RNTI/G-CS-RNTI associated with this DRX configuration. It is absent otherwise. ","paragraph_zero_based":39910},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39911}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["f90b4dfc1ae705f8413591d46e00ab313cc2822c776d68096c8e6e87c091865f","4295aa8c8ce5fed3dde80e52be87544e4f725627d81c2c5522acf8c78f1e38c8","4e3b194238d6b432cf93ada8e3bdf638fba25b0b3f5c4f3eef29f7cfd6b32485","4b76b33c1ad14cfa6913682d1681a3cf067d1d79e17320a6aa3f8dbc116e8bf0","1429667503552b4c4d5ceee72ad13edabfcc4e66b424f2abaa9e88548094e1f6","f57c004db19195921c1214e17debed0661a09c6544d8e0e8ff7299a6ed043cc4","2fe7eecc5a18618b2fbc6f7545f763778f4d9b22ffae8c02121c5f214ac40a38","5819169d622275626becedd1d181ef57b3672c730328c4a215b7148b82947b63","581d42c65d8e4accaaf59490f03fb6f09fff4d553f61c7f739feafeda37193c2","b4583db76053eca48006ffcf66a12c61a98c766047f319fc73d0a82c0ffeafb4","6cabdbdb12ff4537833750976c7a9568eedae3e03f86dc06dcf5b605bbe0eda7","a70e3b261e69b9283386759f35a574e7152495e8c3f280899073f6b1e5c