6ca7475fdf381041a33b2e83cd85e26097180524d2cdd85fcce","d1247e53d8f2e2b2648e45ecfcf4434b112386a9a62e5f81815a6bfac17691f1","5c1319528f35e3e36b656463eaa6193553dae0b096faa4ee12201968d6ba580f","dec0ac6b7944e223a3348fa0a2604acf06f6a471dc034491eb3db427754fdbb9","e57bd709c0a6c73007fa949b9d2a79feddeefd4b1c9a3e1459b22de615df2819","e5a28566ebed338cd40fffc11720c291ad8ff0e132c3cb079ca765d042152f74","307e3431bbb20695352149062c81fd9d26fc936143b0cafc08b04d0dd2a10619"],"paragraph_range_zero_based":[14040,14063],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p14040"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    noDisasterRoaming-r17             NULL,","paragraph_zero_based":14064},{"literal_text_all_w_t_and_m_t":"    disasterRelatedIndication-r17     NULL,","paragraph_zero_based":14065},{"literal_text_all_w_t_and_m_t":"    commonPLMNs-r17                   NULL,","paragraph_zero_based":14066},{"literal_text_all_w_t_and_m_t":"    dedicatedPLMNs-r17                SEQUENCE (SIZE (1..maxPLMN)) OF PLMN-Identity","paragraph_zero_based":14067},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14068},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14069},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB15-STOP","paragraph_zero_based":14070},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":14071},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14072},{"literal_text_all_w_t_and_m_t":"SIB15 field descriptions","paragraph_zero_based":14073},{"literal_text_all_w_t_and_m_t":"commonPLMNsWithDisasterCondition","paragraph_zero_based":14074},{"literal_text_all_w_t_and_m_t":"A list of PLMN(s) for which disaster condition applies and that disaster inbound roaming is accepted, which can be commonly applicable to the PLMNs sharing the cell.","paragraph_zero_based":14075},{"literal_text_all_w_t_and_m_t":"applicableDisasterInfoList","paragraph_zero_based":14076},{"literal_text_all_w_t_and_m_t":"A list indicating the applicable disaster roaming information for the networks indicated in plmn-IdentityInfoList and npn-IdentityInfoList-r16. The network indicates in this list one entry for each entry of plmn-IdentityInfoList, followed by one entry for each entry of npn-IdentityInfoList-r16, meaning that this list will have as many entries as the number of entries of the combination of plmn-IdentityInfoList and npn-IdentityInfoList-r16. The first entry in this list indicates the disaster roaming information applicable for the network(s) in the first entry of plmn-IdentityInfoList/npn-IdentityInfoList-r16, the second entry in this list indicates the disaster roaming information applicable for the network(s) in the second entry of plmn-IdentityInfoList/npn-IdentityInfoList-r16, and so on. Each entry in this list can either be having the value noDisasterRoaming, disasterRelatedIndication, commonPLMNs, or dedicatedPLMNs. If an entry in this list takes the value noDisasterRoaming, disaster inbound roaming is not allowed in this network(s). If an entry in this list takes the value disasterRelatedIndication, the meaning of this field for this network(s) is as specified for \"disaster related indication\" in TS 23.122 [74], clause 4.4.3.1.1. If an entry in this list takes the value commonPLMNs, the PLMN(s) with disaster conditions indicated in the field commonPLMNsWithDisasterCondition apply for this network(s). If an entry in this list contains the value dedicatedPLMNs, the listed PLMN(s) are the PLMN(s) with disaster conditions that the network(s) corresponding to this entry accepts disaster inbound roamers from. For SNPNs, the network indicates the value noDisasterRoaming.","paragraph_zero_based":14077},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14078},{"literal_text_all_w_t_and_m_t":"–SIB16","paragraph_zero_based":14079},{"literal_text_all_w_t_and_m_t":"SIB16 contains configurations of slice-based cell reselection information.","paragraph_zero_based":14080},{"literal_text_all_w_t_and_m_t":"SIB16 information element","paragraph_zero_based":14081},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":14082},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB16-START","paragraph_zero_based":14083},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14084},{"literal_text_all_w_t_and_m_t":"SIB16-r17 ::=                    SEQUENCE {","paragraph_zero_based":14085},{"literal_text_all_w_t_and_m_t":"    freqPriorityListSlicing-r17      FreqPriorityListSlicing-r17              OPTIONAL,  -- Need R","paragraph_zero_based":14086},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension         OCTET STRING                             OPTIONAL,","paragraph_zero_based":14087}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["287ee99c502b2c5991e3ae75fb3c316b408db48e5078a5747bb671f6904edb63","ffd82d56abf7fe0be8c92a096b35e346af34231a042eb42c79433504a1d69521","c49ac06737c0212e04c4d12ad5eb0cc49f25c78757ea01894ddb61370586359b","30079eeb9d8b60741c2c5d0bb1d64e2e9d62f325c202f844f8e27b66fc31fb73","25bbe465808edfa51ab94a29b12086b208c30050c0f5f5daa60f2ea0359e6831","f4d8dcd099e42d676536a4e76cb300a633fdd461198f2a431c2e5264ba22acaa","5422972fc5dfde2edcffd565961c8dae80c8093055cf6df90523e349de4ef3fa","5b896dc07f0d67ed7a5762899ac2b955492b0333def593d5867849d10a7d11c3","9259148eb5c645c8b7bc0622a81812225c3a4951493fac3bb5f517bad3ca705c","e864a7da163aa9cf22862812330aee26cd0611623e8d77370c2144d17a601252","bbb30e24010f4cdb62cd9f3edf55659c4aae6c1801aa8c80ccf06ee2be0ad3b1","60ce9dcce8852db28d90187c40cc609918b9bdbeef7f996e4948d4a309385861","e0712b3bd83683f41200cb076d58531cf56424aacfc788c42af9a7cb48ef74b9","a2d793ebe1202e81b4c037df03633fa68eeb7bcbf06abf96fa272209aaa47d12","68d05c0d00ba2c212a7c27ca2a33da249da2e53a49ca07ed393df8522d805fd8","19051b271b3c539a94356dccd23a00b412930ee3fb1ae484ca42ed35c82d9db0","5930c8696ab58f60d5d8812cdc8251defae3ff0c8076175795e5cee52caafc09","bde082e9771fcc6138a830f57ff04842cd562fcf382b7f888fe7ba90d0ab807b","82010a2d7d7840ce306b0e1c287c0a328c191bd2bc2ceff7730577ce4f79eea8","747387cee721df8c38a32038ee9726b515471b5a797e45ead38287c966502e0d","b8c9838ed23de1563036970df3f9f96d9c2