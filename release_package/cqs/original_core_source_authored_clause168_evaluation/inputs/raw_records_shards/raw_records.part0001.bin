{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36768},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36769},{"literal_text_all_w_t_and_m_t":"EUTRA-MBSFN-SubframeConfig field descriptions","paragraph_zero_based":36770},{"literal_text_all_w_t_and_m_t":"radioframeAllocationOffset","paragraph_zero_based":36771},{"literal_text_all_w_t_and_m_t":"Field as defined in MBSFN-SubframeConfig in TS 36.331 [10].","paragraph_zero_based":36772},{"literal_text_all_w_t_and_m_t":"radioframeAllocationPeriod","paragraph_zero_based":36773},{"literal_text_all_w_t_and_m_t":"Field as defined in MBSFN-SubframeConfig in TS 36.331 [10], where SFN refers to the SFN of the NR serving cell.","paragraph_zero_based":36774},{"literal_text_all_w_t_and_m_t":"subframeAllocation1","paragraph_zero_based":36775},{"literal_text_all_w_t_and_m_t":"Field as defined in MBSFN-SubframeConfig in TS 36.331 [10], where the UE assumes the duplex mode (FDD or TDD) of the NR cell for which the E-UTRA-MBSFN-SubframeConfig is provided.","paragraph_zero_based":36776},{"literal_text_all_w_t_and_m_t":"subframeAllocation2","paragraph_zero_based":36777},{"literal_text_all_w_t_and_m_t":"Field as defined in MBSFN-SubframeConfig-v1430 in TS 36.331 [10], where the UE assumes the duplex mode (FDD or TDD) of the NR cell for which the E-UTRA-MBSFN-SubframeConfig is provided.","paragraph_zero_based":36778},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36779},{"literal_text_all_w_t_and_m_t":"–EUTRA-MultiBandInfoList","paragraph_zero_based":36780},{"literal_text_all_w_t_and_m_t":"The IE EUTRA-MultiBandInfoList indicates the list of frequency bands in addition to the band represented by CarrierFreq for which cell reselection parameters are common, and a list of additionalPmax and additionalSpectrumEmission.","paragraph_zero_based":36781},{"literal_text_all_w_t_and_m_t":"EUTRA-MultiBandInfoList information element","paragraph_zero_based":36782},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36783},{"literal_text_all_w_t_and_m_t":"-- TAG-EUTRA-MULTIBANDINFOLIST-START","paragraph_zero_based":36784},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36785},{"literal_text_all_w_t_and_m_t":"EUTRA-MultiBandInfoList ::=     SEQUENCE (SIZE (1..maxMultiBands)) OF EUTRA-MultiBandInfo","paragraph_zero_based":36786},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36787},{"literal_text_all_w_t_and_m_t":"EUTRA-MultiBandInfo ::=         SEQUENCE {","paragraph_zero_based":36788},{"literal_text_all_w_t_and_m_t":"    eutra-FreqBandIndicator         FreqBandIndicatorEUTRA,","paragraph_zero_based":36789},{"literal_text_all_w_t_and_m_t":"    eutra-NS-PmaxList               EUTRA-NS-PmaxList                           OPTIONAL    -- Need R","paragraph_zero_based":36790},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":36791}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["fe49c0713b8cc1717e7895cbdb20dc73e05f30dcbcdc340b61b1e339b7dda966","5966e6df2600978a513d275145825b362108b581603d3b93dfd7454c355317fe","e41b430b4ef7fb5dad5e137f50f83f3a971c1a25c42b166e6d25b16e40a45614","a4f137acad290c4f29734c6aac57fcfca57143513fad633c5d312da414043a3b","0f082a44516c6922193c318ca1f4862c3e59b43a8883d44b514dfceb1a30f391","ba9ee0f04edde1c07466273a32fee0cb2c4d2028c4552f71961839944c6dab34","1cef73bb6fd2820236d9c47fb9a330658f56a9cab71364e028cd386fa6950364","f91b37ad7aa0b72742ad77df36a7c4c5255e43c55caa8c57c27aa1e8427173f7","4fb13df1c869bdfb4f03bd18db6628a77a80c15583fda783cedc56cedae474db","df251