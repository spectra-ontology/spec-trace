{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17160},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-MEASCONFIG-STOP","paragraph_zero_based":17161},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17162},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17163},{"literal_text_all_w_t_and_m_t":"CSI-MeasConfig field descriptions","paragraph_zero_based":17164},{"literal_text_all_w_t_and_m_t":"aperiodicTriggerStateList","paragraph_zero_based":17165},{"literal_text_all_w_t_and_m_t":"Contains trigger states for dynamically selecting one or more aperiodic and semi-persistent reporting configurations and/or triggering one or more aperiodic CSI-RS resource sets for channel and/or interference measurement (see TS 38.214 [19], clause 5.2.1).","paragraph_zero_based":17166},{"literal_text_all_w_t_and_m_t":"csi-IM-ResourceSetToAddModList","paragraph_zero_based":17167},{"literal_text_all_w_t_and_m_t":"Pool of CSI-IM-ResourceSet which can be referred to from CSI-ResourceConfig or from MAC CEs.","paragraph_zero_based":17168},{"literal_text_all_w_t_and_m_t":"csi-IM-ResourceToAddModList","paragraph_zero_based":17169},{"literal_text_all_w_t_and_m_t":"Pool of CSI-IM-Resource which can be referred to from CSI-IM-ResourceSet.","paragraph_zero_based":17170},{"literal_text_all_w_t_and_m_t":"csi-ReportConfigToAddModList","paragraph_zero_based":17171},{"literal_text_all_w_t_and_m_t":"Configured CSI report settings as specified in TS 38.214 [19] clause 5.2.1.1.","paragraph_zero_based":17172},{"literal_text_all_w_t_and_m_t":"csi-ResourceConfigToAddModList","paragraph_zero_based":17173},{"literal_text_all_w_t_and_m_t":"Configured CSI resource settings as specified in TS 38.214 [19] clause 5.2.1.2.","paragraph_zero_based":17174},{"literal_text_all_w_t_and_m_t":"csi-SSB-ResourceSetToAddModList","paragraph_zero_based":17175},{"literal_text_all_w_t_and_m_t":"Pool of CSI-SSB-ResourceSet which can be referred to from CSI-ResourceConfig.","paragraph_zero_based":17176},{"literal_text_all_w_t_and_m_t":"nzp-CSI-RS-ResourceSetToAddModList","paragraph_zero_based":17177},{"literal_text_all_w_t_and_m_t":"Pool of NZP-CSI-RS-ResourceSet which can be referred to from CSI-ResourceConfig or from MAC CEs.","paragraph_zero_based":17178},{"literal_text_all_w_t_and_m_t":"nzp-CSI-RS-ResourceToAddModList","paragraph_zero_based":17179},{"literal_text_all_w_t_and_m_t":"Pool of NZP-CSI-RS-Resource which can be referred to from NZP-CSI-RS-ResourceSet.","paragraph_zero_based":17180},{"literal_text_all_w_t_and_m_t":"reportTriggerSize, reportTriggerSizeDCI-0-2","paragraph_zero_based":17181},{"literal_text_all_w_t_and_m_t":"Size of CSI request field in DCI (bits) (see TS 38.214 [19], clause 5.2.1.5.1). The field reportTriggerSize applies to DCI format 0_1 and the field reportTriggerSizeDCI-0-2 applies to DCI format 0_2 (see TS 38.214 [19], clause 5.2.1.5.1).","paragraph_zero_based":17182},{"literal_text_all_w_t_and_m_t":"scellActivationRS-ConfigToAddModList","paragraph_zero_based":17183}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["9a3f7125b055fd53b23be4c03e25a9f04542b003b5d822331dc2637979581701","2d3c9f02f6fae4a0f12eba8bcc7fb01db961578687b9539f2ba3c5984583cb14","6e3b4b5185dc08409b618a0a9cbcd387ec3d99896f5ca202606110be11841070","3ec0de7845257bc95a9ab38833bc1f06f6bf9c36d3af5186e6a7eb06f25a15cd","a5e7e275179bbe8d8a915eddde54a0ff4991bf2beb7bd6311ef46fc9e32ab607","2d132a43a155b46a5ca1bdd3000bb3f58211babe3ab886f638eb6291eac8c5d6","a4e089419aa94554ac5e8ecc913e29fa60e6615a48d164f2f6245c0e1f3ff136","c