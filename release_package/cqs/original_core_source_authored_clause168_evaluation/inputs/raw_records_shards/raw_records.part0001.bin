{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Scrambling ID (see TS 38.214 [19], clause 5.2.2.3.1).","paragraph_zero_based":21840},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21841},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":21842},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":21843},{"literal_text_all_w_t_and_m_t":"Periodic","paragraph_zero_based":21844},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need M, for periodic NZP-CSI-RS-Resources (as indicated in CSI-ResourceConfig). The field is absent otherwise.","paragraph_zero_based":21845},{"literal_text_all_w_t_and_m_t":"PeriodicOrSemiPersistent","paragraph_zero_based":21846},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need M, for periodic and semi-persistent NZP-CSI-RS-Resources (as indicated in CSI-ResourceConfig). The field is absent otherwise.","paragraph_zero_based":21847},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21848},{"literal_text_all_w_t_and_m_t":"–NZP-CSI-RS-ResourceId","paragraph_zero_based":21849},{"literal_text_all_w_t_and_m_t":"The IE NZP-CSI-RS-ResourceId is used to identify one NZP-CSI-RS-Resource.","paragraph_zero_based":21850},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-ResourceId information element","paragraph_zero_based":21851},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21852},{"literal_text_all_w_t_and_m_t":"-- TAG-NZP-CSI-RS-RESOURCEID-START","paragraph_zero_based":21853},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21854},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-ResourceId ::=           INTEGER (0..maxNrofNZP-CSI-RS-Resources-1)","paragraph_zero_based":21855},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21856},{"literal_text_all_w_t_and_m_t":"-- TAG-NZP-CSI-RS-RESOURCEID-STOP","paragraph_zero_based":21857},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21858},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21859},{"literal_text_all_w_t_and_m_t":"–NZP-CSI-RS-ResourceSet","paragraph_zero_based":21860},{"literal_text_all_w_t_and_m_t":"The IE NZP-CSI-RS-ResourceSet is a set of Non-Zero-Power (NZP) CSI-RS resources (their IDs) and set-specific parameters.","paragraph_zero_based":21861},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-ResourceSet information element","paragraph_zero_based":21862},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21863}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["3c0486fad313a921e33462cad3ccbae1d8163be17a6513cad752fb311db9bc8a","87e69e0cdbfea4447233ca507a6a91381b74ae445513c83447e9d9ea1a00eac6","7e1754aea6796316aaf4940863d0a13bc7bb72b2a271c0eb15253d7284f4496a","1946efd222875f379f6651f5906fb83b8b17cd76a03f1e18e49c5d65f0177737","afae2c5c3a4488d81bd7eb534cfdc1df83434b978c4ae6ae50b206dc2be6012b","dd18c3f692e29663bbcfb17611e85252db307775ab54c091dc535c511fd6c72a","64fb457b99d66a3c34a9d4b7b49e69b0dc1d1ed10abfabe0bc20ea5ad67d3ef4","309a5e732d782f866cfe3d751299d8dac96de44bc648afc9af1cd3d99f32b0f1","2af49ec5a2880b8e0fedae3aac749918bf2030a671a19b4c817e37e134f7b7f7","1247786f370a681a1bb3a49aa10cc38fd4be0ed49c01b2f66f696ad543f6b2ba","c39f3b51237e6a1e13fef5e8f89551cc7adcfcfd2d2f617301d40188ba4126b2","74003ecafbbeef3610abd51f5a32556c4cf2a8c0e13000f464fe291ad3194c6d","d3f1c8c9ae30dea29e4d8ff5c3e3bd262f274466a5720d1b97f2182a85770aea","a1237b70b186988bd14045bb76411bdb6a2488a88d8031ae124ceb6d0ef811ee","91edd6cf80b03ea3051e818b7120b11e302e5e9faad63850639c1c1e6a90be1d","7947a4be58165e9e94a5d5931c6eebf788d51d24d3c67d9a8334a338a85539ac","7774e1ffa046624681ca2a2ec99b9bbc456f0a989723159b11441e12c83d94f3","96c7fb8b2accbdef37f3fa7c6ef1102bd98de77d2b40a22e4e1e99f91b27ef28","a845cacb1e1f68a086a0cf026af318a7c4747e190ef0c6a0283f68d0719d5b69","b447ffa46e76c2fb5c43d02f2df860e4a1f4468f7d6c89cfa6cf3bffb351ab39","f79303a265566bb1088d04c83ad35e2fb25fd51d3ec63106502bb3beeaea4eeb","8dae8a8b4400d8f0acde054d8f0c445e184ce35e40b936fb344841fa6225d5cb","dbafcd584aa9e728435be39e415c4f299ba7c8ba00541a90a180f3676392f55d","30eea7dd72d622cae63b07dbf6895f0655dfe2a6963768c2e7b24578360325fd"],"paragraph_range_zero_based":[21840,21863],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p21840"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-NZP-CSI-RS-RESOURCESET-START","paragraph_zero_based":21864},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21865},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-ResourceSet ::=          SEQUENCE {","paragraph_zero_based":21866},{"literal_text_all_w_t_and_m_t":"    nzp-CSI-ResourceSetId               NZP-CSI-RS-ResourceSetId,","paragraph_zero_based":21867},{"literal_text_all_w_t_and_m_t":"    nzp-CSI-RS-Resources                SEQUENCE (SIZE (1..maxNrofNZP-CSI-RS-ResourcesPerSet)) OF NZP-CSI-RS-ResourceId,","paragraph_zero_based":21868},{"literal_text_all_w_t_and_m_t":"    repetition                          ENUMERATED { on, off }                                                  OPTIONAL,   -- Need S","paragraph_zero_based":21869},{"literal_text_all_w_t_and_m_t":"    aperiodicTriggeringOffset           INTEGER(0..6)                                                           OPTIONAL,   -- Need S","paragraph_zero_based":21870},{"literal_text_all_w_t_and_m_t":"    trs-Info                            ENUMERATED {true}                                                       OPTIONAL,   -- Need R","paragraph_zero_based":21871},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":21872},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":21873},{"literal_text_all_w_t_and_m_t":"    aperiodicTriggeringOffset-r16       INTEGER(0..31)                                                          OPTIONAL   -- Need S","paragraph_zero_based":21874},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":21875},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":21876},{"literal_text_all_w_t_and_m_t":"    pdc-Info-r17                        ENUMERATED {true}                                                       OPTIONAL,  -- Need R","paragraph_zero_based":21877},{"literal_text_all_w_t_and_m_t":"    cmrGroupingAndPairing-r17           CMRGroupingAndPairing-r17                                               OPTIONAL,  -- Need R","paragraph_zero_based":21878},{"literal_text_all_w_t_and_m_t":"    aperiodicTriggeringOffset-r17       INTEGER (0..124)                                                        OPTIONAL,  -- Need S","paragraph_zero_based":21879},{"literal_text_all_w_t_and_m_t":"    aperiodicTriggeringOffsetL2-r17     INTEGER(0..31)                                                          OPTIONAL   -- Need R","paragraph_zero_based":21880},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":21881},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21882},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21883},{"literal_text_all_w_t_and_m_t":"CMRGroupingAndPairing-r17 ::=        SEQUENCE {","paragraph_zero_based":21884},{"literal_text_all_w_t_and_m_t":"    nrofResourcesGroup1-r17              INTEGER (1..7),","paragraph_zero_based":21885},{"literal_text_all_w_t_and_m_t":"    pair1OfNZP-CSI-RS-r17                NZP-CSI-RS-Pairing-r17                                                 OPTIONAL,  -- Need R","paragraph_zero_based":21886},{"literal_text_all_w_t_and_m_t":"    pair2OfNZP-CSI-RS-r17                NZP-CSI-RS-Pairing-r17                                                 OPTIONAL   -- Need R","paragraph_zero_based":21887}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["18e954879500bd42e5983a30ac28969f2d7849b041512ebdbfd58962c88108f4","4d22d7a4593823ca6d87f2d113301c1819b227430de246e9dacce9f0744dbfbf","1af2f6ff98907b513100cb7faf17ed773d79741c2e12dacdadff35ec93457d7a","08bb7967cffba62e5ccc07cadfeee5f5e25f2115652a7388a3b9bbdebf2c751a","da3ad2c917ea8c9216860d489c46d79e3c0cd42c10cdbdacd831c608bb84c9af","29d32c423c64abc206fe71fb770e83d50fc3c3ee39f3247bdfd9534ebc340641","59916f337b353f4cbdf5ae7e8fd7ef93556d66003dd83ffd659b80f8df7c56d4","43412b92f6a67d33673195e43a4d59861634d33d0230f5aeba36068c2a3ffa68","41f78e5ee6e551046d92e6dc4455dcd7a663f30945dcae73bc6c6e4f209dd716","c7d8af6d7b412e37acd9f7ecba559b7cf98407ec6368a989883fcf0dafc50174","ce4955207fee1606a98cff5a355b8f20c5175e0361bdd91faac7ca11b9b4830c","2261e052078e26e2a5c22cd0d260eb4adfc5221d7378ece003caf663079c5d7f","0478dc318b49512ae32e667a82fcd3b3958f626d79dc823bddbc84abd2c1d8b2","1990838cc15a498e6787a8eee0901bb2214e7fb6421fbc0cffb602adaa7e919a","c6984e731377750abeccaf31c430d7beb8b19fea1ea31c7932bc5ec81333f4e8","6178485e804d3c37b583cbf3ed1aadd15c5204ec884182474f42638964e19cb0","7f244e98a0cff4371e80854032a1cfc9edffd2d5005e994b1e4ad523d0696401","c9805389f8155b358a7e95148d7a0c43f339553c30f2d033fdd1b9c041d90752","83d4de392b2b76cbfc49e12c3dc141b417c48ab0967f7b9870dd11607105b8c7","6ed023ec24b8e66747e78e59fa2b300d9d39449a2426a762663f20203672c112","4e70bbff3a3913c54dfe4e9ef75f1a2b592eb482c3dd01764c623b648de4f9fe","d5b52d699030faac8d8ddb8ac9a9541ff799ae6c19a31fdb1010a51f907edf23","eef6e95e05eeabbe95caa6e708190b62cd6be2eee4e09952239eac171f18f544","bdea32ed9948e0d9c14c0ab102eaeb345ad462452e0af3a3cc5cfa1ae2188585"],"paragraph_range_zero_based":[21864,21887],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p21864"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21888},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21889},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-Pairing-r17  ::=          SEQUENCE {","paragraph_zero_based":21890},{"literal_text_all_w_t_and_m_t":"    nzp-CSI-RS-ResourceId1-r17           INTEGER (1..7),","paragraph_zero_based":21891},{"literal_text_all_w_t_and_m_t":"    nzp-CSI-RS-ResourceId2-r17           INTEGER (1..7)","paragraph_zero_based":21892},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21893},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21894},{"literal_text_all_w_t_and_m_t":"-- TAG-NZP-CSI-RS-RESOURCESET-STOP","paragraph_zero_based":21895},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21896},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21897},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-ResourceSet field descriptions","paragraph_zero_based":21898},{"literal_text_all_w_t_and_m_t":"aperiodicTriggeringOffset, aperiodicTriggeringOffset-r16, aperiodicTriggeringOffset-r17","paragraph_zero_based":21899},{"literal_text_all_w_t_and_m_t":"Offset X between the slot containing the DCI that triggers a set of aperiodic NZP CSI-RS resources and the slot in which the CSI-RS resource set is transmitted. For aperiodicTriggeringOffset, the value 0 corresponds to 0 slots, value 1 corresponds to 1 slot, value 2 corresponds to 2 slots, value 3 corresponds to 3 slots, value 4 corresponds to 4 slots, value 5 corresponds to 16 slots, value 6 corresponds to 24 slots. For aperiodicTriggeringOffset-r16 and aperiodicTriggeringOffset-r17, the value indicates the number of slots. aperiodicTriggeringOffset-r17 is applicable to SCS 480 kHz and 960 kHz, and only the values of integer multiples of 4 are valid, i.e. 0, 4, 8, and so on. The network configures only one of the fields. When neither field is included, the UE applies the value 0.","paragraph_zero_based":21900},{"literal_text_all_w_t_and_m_t":"aperiodicTriggeringOffsetL2","paragraph_zero_based":21901},{"literal_text_all_w_t_and_m_t":"Indicates triggering offset of aperiodic NZP CSI-RS resources used for fast activation of the SCell (see clause 5.2.1.5.3 of TS 38.214 [19]), when the NZP CSI-RS resources are activated by the MAC CE (see clause 5.9 of TS 38.321 [3]). The value indicates the number of slots.","paragraph_zero_based":21902},{"literal_text_all_w_t_and_m_t":"cmrGroupingAndPairing","paragraph_zero_based":21903},{"literal_text_all_w_t_and_m_t":"Configures CMR groups and pairs. The first nrofResourcesGroup1 resources in the NZP-CSI-RS resource set belong to Group 1 and the remaining resources in the NZP-CSI-RS resource set belong to Group 2. nrofResourcesGroup1 is K1 and the number of remaining resources in the NZP-CSI-RS resource set belonging to Group 2 is K2 as specified in TS 38.214 clause 5.2.1.4.1. Maximum total number in Group 1 and Group 2 is 8 (see TS 38.214 [19], clauses 5.2.1.4.1 and 5.2.1.4.2).","paragraph_zero_based":21904},{"literal_text_all_w_t_and_m_t":"pair1OfNZP-CSI-RS, pair2OfNZP-CSI-RS","paragraph_zero_based":21905},{"literal_text_all_w_t_and_m_t":"A pair of NZP CSI-RS resources. In one pair, one resource shall belong to group 1 and the other resource shall belong to group 2 (see TS 38.214 [19], clause 5.2.1.4.1).","paragraph_zero_based":21906},{"literal_text_all_w_t_and_m_t":"nzp-CSI-RS-Resources","paragraph_zero_based":21907},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-Resources associated with this NZP-CSI-RS resource set (see TS 38.214 [19], clause 5.2). For CSI, there are at most 8 NZP CSI RS resources per resource set.","paragraph_zero_based":21908},{"literal_text_all_w_t_and_m_t":"nzp-CSI-RS-ResourceId1, nzp-CSI-RS-ResourceId2","paragraph_zero_based":21909},{"literal_text_all_w_t_and_m_t":"The nzp-CSI-RS-ResourceId1-r17 represents the index of the NZP CSI-RS resource in Resource Group 1, and nzp-CSI-RS-ResourceId2-r17 represents the index of the NZP CSI-RS resource in Resource Group 2.","paragraph_zero_based":21910},{"literal_text_all_w_t_and_m_t":"pdc-Info","paragraph_zero_based":21911}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["643df8f6b54329c12a1d1433ea09f1895604ce5f002a96cdc0266462f7b8b176","9962861113ce001784668475188731d9596c88645bbc40ad8c3d90ed21032ef8","fd6d76fa643a314384980964b1cf0f0961af729af8479a0b057308cee40a6c56","343784dcab253e58ae1bea616cf504e144b4518227be59089ada22b16e2d8c06","10aa902b4cecae9ecb7eaf3679466a7922381d204e2e6d60e53f5be37e849c3d","49c1aa8134a47dca6fe9d53db071ed3fc32402a055bd4ba56459540300a0ef51","00699aa9c5b0be6bbc4d38aa61e1bf8c4075f506d6bfa17be358424fb2c930ac","895120d3e9efe4eeef4b46ae42c006bdc21ce0eb71a9d47000f068e18e8a98f8","79e425e6cd5f07dac32fddacfd06431ef8240b22b354d76878bb82cbe524d844","f95345b0e3a34e9ab414a0e4350eaa60d7ce559f75f24b8e1149f3f9f6ace059","bf71e2c68b3ff3a51a8ffd025c48bf6607a26a39ac97a7703a81dbae68bdb464","1c555833f5c5c76aecba7819f927701b39c7afca5a3d2dcb1dcca0eb495b9646","668779944fb415653b6ef47b64b1a9f9a95bf09a242acea4e8c1fc0f298c391c","1186f0a4a81c25d30a84909488c86ead0db7d819276cf905da75770ff9ba1927","34e74c54c76ab0a33e480146fc2d7d7b407348238101335283986a5b0a19caba","2ff5c331bceea2cf04b04ea6f75458a3fc5cb7ff9fdb13d3dcfb428585372a0c","f1c6dc75989935ef6c4c81b50d3684b33f2d9cde0f4edab9726df2e23ffa65eb","e5843d00d37587762d2b064742d8fec80bae69dde6f6ec6735291d7ad0dd773d","838b3dd54a84940ae5f282b0dd58d365e8a07ebc0b75a56750a7cc3bee600d4b","b51a952794dc77ff142c7e3b4d1d178b31d092d1c188b025028a1ab317db0f1f","18e898593a794851e9edb68cf310f47b5b34fc71a7d92d66b6d142723cfd1e35","be3356b23fe21854e3e3e2fe42c16c1647c64d6dd896eede08117b6c2320b9ec","1f79d47ce4aae6718670764a4c4fa17538ff4b3cdf2e824ecadde20a77565e7a","e9485d4b9bb1ef041e547f9125bd1d769c600bcc9491e91ce7cb411416035672"],"paragraph_range_zero_based":[21888,21911],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p21888"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates that this NZP-CSI-RS-ResourceSet, if configured also with trs-Info, is used for propagation delay compensation. The field can be present only if trs-info is present. The field can be present in only one NZP-CSI-RS-ResourceSet. If network configures this field for an NZP-CSI-RS-ResourceSet, the UE measures the UE Rx-Tx time difference based on resources configured in this resource set.","paragraph_zero_based":21912},{"literal_text_all_w_t_and_m_t":"repetition","paragraph_zero_based":21913},{"literal_text_all_w_t_and_m_t":"Indicates whether repetition is on/off. If the field is set to off or if the field is absent, the UE may not assume that the NZP-CSI-RS resources within the resource set are transmitted with the same downlink spatial domain transmission filter (see TS 38.214 [19], clauses 5.2.2.3.1 and 5.1.6.1.2). It can only be configured for CSI-RS resource sets which are associated with CSI-ReportConfig with report of L1 RSRP, L1 SINR or \"no report\".","paragraph_zero_based":21914},{"literal_text_all_w_t_and_m_t":"trs-Info","paragraph_zero_based":21915},{"literal_text_all_w_t_and_m_t":"Indicates that the antenna port for all NZP-CSI-RS resources in the CSI-RS resource set is same. If the field is absent or released the UE applies the value false (see TS 38.214 [19], clause 5.2.2.3.1).","paragraph_zero_based":21916},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21917},{"literal_text_all_w_t_and_m_t":"–NZP-CSI-RS-ResourceSetId","paragraph_zero_based":21918},{"literal_text_all_w_t_and_m_t":"The IE NZP-CSI-RS-ResourceSetId is used to identify one NZP-CSI-RS-ResourceSet.","paragraph_zero_based":21919},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-ResourceSetId information element","paragraph_zero_based":21920},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21921},{"literal_text_all_w_t_and_m_t":"-- TAG-NZP-CSI-RS-RESOURCESETID-START","paragraph_zero_based":21922},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21923},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-ResourceSetId ::=        INTEGER (0..maxNrofNZP-CSI-RS-ResourceSets-1)","paragraph_zero_based":21924},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21925},{"literal_text_all_w_t_and_m_t":"-- TAG-NZP-CSI-RS-RESOURCESETID-STOP","paragraph_zero_based":21926},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21927},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21928},{"literal_text_all_w_t_and_m_t":"–P-Max","paragraph_zero_based":21929},{"literal_text_all_w_t_and_m_t":"The IE P-Max is used to limit the UE's uplink transmission power on a carrier frequency, in TS 38.101-1 [15] and in TS 38.101-5 [75], and is used to calculate the parameter Pcompensation defined in TS 38.304 [20].","paragraph_zero_based":21930},{"literal_text_all_w_t_and_m_t":"P-Max information element","paragraph_zero_based":21931},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21932},{"literal_text_all_w_t_and_m_t":"-- TAG-P-MAX-START","paragraph_zero_based":21933},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21934},{"literal_text_all_w_t_and_m_t":"P-Max ::=                           INTEGER (-30..33)","paragraph_zero_based":21935}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["359294085df8216bde52b62b4b5b8109edcb032572763b3a2fd2240bd49c359b","c540c6a27365c0f5e62ee1455a9bd1ced677b6591094fa107cb746dfece74b24","effb8e39d5ff725ad898bb7e60e51abb5294b7aaac19bdee6227fd5e80e1b5ea","3334a92fcda25