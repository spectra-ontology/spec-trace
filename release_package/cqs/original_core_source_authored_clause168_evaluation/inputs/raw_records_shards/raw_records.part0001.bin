{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    needForNCSG-EUTRA-r17              SEQUENCE (SIZE (1..maxBandsEUTRA)) OF NeedForNCSG-EUTRA-r17","paragraph_zero_based":21048},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21049},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21050},{"literal_text_all_w_t_and_m_t":"NeedForNCSG-EUTRA-r17  ::=         SEQUENCE {","paragraph_zero_based":21051},{"literal_text_all_w_t_and_m_t":"    bandEUTRA-r17                      FreqBandIndicatorEUTRA,","paragraph_zero_based":21052},{"literal_text_all_w_t_and_m_t":"    gapIndication-r17                  ENUMERATED {gap, ncsg, nogap-noncsg}","paragraph_zero_based":21053},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21054},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21055},{"literal_text_all_w_t_and_m_t":"-- TAG-NEEDFORGAPNCSG-INFOEUTRA-STOP","paragraph_zero_based":21056},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21057},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21058},{"literal_text_all_w_t_and_m_t":"NeedForGapNCSG-InfoEUTRA field descriptions","paragraph_zero_based":21059},{"literal_text_all_w_t_and_m_t":"needForNCSG-EUTRA","paragraph_zero_based":21060},{"literal_text_all_w_t_and_m_t":"Indicates the measurement gap and NCSG requirement information for E-UTRA measurement.","paragraph_zero_based":21061},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21062},{"literal_text_all_w_t_and_m_t":"NeedForNCSG-EUTRA field descriptions","paragraph_zero_based":21063},{"literal_text_all_w_t_and_m_t":"bandEUTRA","paragraph_zero_based":21064},{"literal_text_all_w_t_and_m_t":"Indicates the EUTRA target band to be measured.","paragraph_zero_based":21065},{"literal_text_all_w_t_and_m_t":"gapIndication","paragraph_zero_based":21066},{"literal_text