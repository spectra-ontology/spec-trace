{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23736},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23737},{"literal_text_all_w_t_and_m_t":"PUCCH-TPC-CommandConfig field descriptions","paragraph_zero_based":23738},{"literal_text_all_w_t_and_m_t":"tpc-IndexPCell","paragraph_zero_based":23739},{"literal_text_all_w_t_and_m_t":"An index determining the position of the first bit of TPC command (applicable to the SpCell) inside the DCI format 2-2 payload.","paragraph_zero_based":23740},{"literal_text_all_w_t_and_m_t":"tpc-IndexPUCCH-SCell","paragraph_zero_based":23741},{"literal_text_all_w_t_and_m_t":"An index determining the position of the first bit of TPC command (applicable to the PUCCH SCell) inside the DCI format 2-2 payload.","paragraph_zero_based":23742},{"literal_text_all_w_t_and_m_t":"tpc-IndexPUCCH-sSCell, tpc-IndexPUCCH-sSCellSecondaryPUCCHgroup","paragraph_zero_based":23743},{"literal_text_all_w_t_and_m_t":"An index determining the position of the first bit of TPC command (applicable to the alternative PUCCH cell for PUCCH cell switching) inside the DCI format 2-2 payload, for the primary PUCCH group and the secondary PUCCH group respectively.","paragraph_zero_based":23744},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23745},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":23746},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":23747},{"literal_text_all_w_t_and_m_t":"PDCCH-OfSpcell","paragraph_zero_based":23748},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the PUCCH-TPC-CommandConfig is provided in the PDCCH-Config for the SpCell. Otherwise, the field is absent, Need R.","paragraph_zero_based":23749},{"literal_text_all_w_t_and_m_t":"PDCCH-ofSpCellOrPUCCH-SCell","paragraph_zero_based":23750},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the PUCCH-TPC-CommandConfig is provided in the PDCCH-Config for the PUCCH-SCell.","paragraph_zero_based":23751},{"literal_text_all_w_t_and_m_t":"The field is optionally present, need R, if the UE is configured with a PUCCH SCell in this cell group and if the PUCCH-TPC-CommandConfig is provided in the PDCCH-Config for the SpCell.","paragraph_zero_based":23752},{"literal_text_all_w_t_and_m_t":"Otherwise, the field is absent, Need R.","paragraph_zero_based":23753},{"literal_text_all_w_t_and_m_t":"twoPUCCHgroup","paragraph_zero_based":23754},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, if secondary PUCCH group is configured. It is absent otherwise.","paragraph_zero_based":23755},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23756},{"literal_text_all_w_t_and_m_t":"–PUSCH-Config","paragraph_zero_based":23757},{"literal_text_all_w_t_and_m_t":"The IE PUSCH-Config is used to configure the UE specific PUSCH parameters applicable to a particular BWP.","paragraph_zero_based":23758},{"literal_text_all_w_t_and_m_t":"PUSCH-Config information element","paragraph_zero_based":23759}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["dd9676c4012c9607cb850a7632e3df35205d71ccfb2df81948eb1928976f0723","9fefe43f04bca8ceb18557a4331f22fe8d966060af054e5974784dd9b3220b57","5fb9fe124a9e461196e5eed35b2e3961da9ab0b3d4ec6a1a593bdd1828acf338","f8f4d15e410fe3d93ae0b5e23b80027de31278798b5bac2a8b0a970fe49fb4fa","8a3a6e6210266d17404780367a0b6bfa06bf831ed852c656551ebeda31589cbb","7e02e2b9d7969143e81a9863e24bacbbf460b8ceb33327510b262d6fdde8799b","097b90a0d41f951407afc389e3ebb14f83827