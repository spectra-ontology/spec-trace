{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29664},{"literal_text_all_w_t_and_m_t":"TCI-UL-State-r17 ::=             SEQUENCE {","paragraph_zero_based":29665},{"literal_text_all_w_t_and_m_t":"    tci-UL-StateId-r17              TCI-UL-StateId-r17,","paragraph_zero_based":29666},{"literal_text_all_w_t_and_m_t":"    servingCellId-r17                ServCellIndex                                         OPTIONAL,   -- Need R","paragraph_zero_based":29667},{"literal_text_all_w_t_and_m_t":"    bwp-Id-r17                       BWP-Id                                                OPTIONAL,   -- Cond CSI-RSorSRS-Indicated","paragraph_zero_based":29668},{"literal_text_all_w_t_and_m_t":"    referenceSignal-r17              CHOICE {","paragraph_zero_based":29669},{"literal_text_all_w_t_and_m_t":"        ssb-Index-r17                    SSB-Index,","paragraph_zero_based":29670},{"literal_text_all_w_t_and_m_t":"        csi-RS-Index-r17                 NZP-CSI-RS-ResourceId,","paragraph_zero_based":29671},{"literal_text_all_w_t_and_m_t":"        srs-r17                          SRS-ResourceId","paragraph_zero_based":29672},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":29673},{"literal_text_all_w_t_and_m_t":"    additionalPCI-r17                AdditionalPCIIndex-r17                                OPTIONAL,   -- Need R","paragraph_zero_based":29674},{"literal_text_all_w_t_and_m_t":"    ul-powerControl-r17              Uplink-powerControlId-r17                             OPTIONAL,   -- Need R","paragraph_zero_based":29675},{"literal_text_all_w_t_and_m_t":"    pathlossReferenceRS-Id-r17       PathlossReferenceRS-Id-r17                            OPTIONAL,   -- Cond Mandatory","paragraph_zero_based":29676},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":29677},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29678},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29679},{"literal_text_all_w_t_and_m_t":"-- TAG-TCI-UL-STATE-STOP","paragraph_zero_based":29680},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29681},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29682},{"literal_text_all_w_t_and_m_t":"TCI-UL-State field descriptions","paragraph_zero_based":29683},{"literal_text_all_w_t_and_m_t":"additionalPCI","paragraph_zero_based":29684},{"literal_text_all_w_t_and_m_t":"Indicates the physical cell IDs (PCI) of the SSBs when referenceSignal is configured as SSB. In case the servingCellId is present, the additionalPCI refers to a PCI value configured in the list configured using additionalPCI-ToAddModList in the serving cell indicated by the field servingCellId. Otherwise, it refers to a PCI value configured in the list configured using additionalPCI-ToAddModList in the serving cell where the ul-TCI-StateList is applied by the UE.","paragraph_zero_based":29685},{"literal_text_all_w_t_and_m_t":"bwp-Id","paragraph_zero_based":29686},{"literal_text_all_w_t_and_m_t":"The DL BWP which the CSI-RS is located in or UL BWP where the SRS is located in.","paragraph_zero_based":29687}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["61e19b1887d89f721c7b34d85c2c1d35926ad22ad89eaaeda96bb7538253c80c","65f6cdbe22d40ed5ab22adc1092e115cbd4e4947b2297e59b3e1e2ccc1506be6","7a17aea1a2fb690e0077b28e63757a403433703ce6bfe6f49035aa3ce3988e40","791afbb28552292ec01f936b1a72cbfad0c3d57e2f604ba62f0fb03699c856ac","fa63cf8e0286d4f595c957d06b50f55c18a4148c990ca5770316819e3bbfcfac","d13e16ab6644dd4ae398b05c89019ce3a148fb41ca59244e923e4c0d079691ea","d84679dcd37535a5c0c6a11746a11b749b2e66f65a5ae388486c63c2e0839e15","005128404fca84b081af18a5d3c4daa1efe22aeaace46fe459973a048ec87f2a","1c9f689586d0a5daeb44192bfca938faf114cd7f3aa4d9b6c95f51f38305d6a9","881c6ef4b161387e558d001c789aaecab82ef273eae513df882cd3be0114ef3e","bdfd91e74cb9b9d374ca0c436c013aaf8da3539712c869be8194de1f2799579e","e9bbea932d9e0e347ce70d327fdac3bfcb4049e0d49a71a9c7cf18ebb10e10b6","ea4ae1c707de40253a0daff05e31ce4c6ae1dd9fdc63781793acb28dddd8daa8","01f7b75f54cbfbf5c7c66c9001f1f59196ceab6a7ff856819078ee572ba6f1c3","90b2df7c218ff735ef6c092504c536b22015bb0c0cde8d70975c97df7a4cfd10","f9c7a4461861ec0a4891e1e564401dd59d3a1c980a7c6c7951dd8ec1d820b048","015719f67674f5290180b2a2de8c90753601fe2afc8263d3176de9df240c19ee","4a324bfeb01324f1e175d5fce7bd788d6f9cccbb29c8740b097b89108fcc2621","f89770648b45229eb80d2cbaa8e3389f05e7903ab254bede91955cfc85f3cf3f","809cc0f3022e90ec24572dd61dc9d9f0b2f1fcecf057bd7916a75d63ad191c5b","a40d3adb70504e68d01c2d0031a0e0c426221cd48d818aff31372302b1244a68","dd2b5b13ed444c6e2aa49bc38a7a2c861c8242ca906d8ff4b919485a3efccb2b","93813049449a8b45c5ee17db94f35b37d12deb1a295906c1480b94d043c63754","0c261535f674f9b2205c86bdc36e6bd0e6e09e0bc2b13213375fd729e400a0bc"],"paragraph_range_zero_based":[29664,29687],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p29664"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"servingCellId","paragraph_zero_based":29688},{"literal_text_all_w_t_and_m_t":"The UE's serving cell in which the referenceSignal is configured. If the field is absent, the referenceSignal is configured in the serving cell in which the TCI-UL-State is applied by the UE.","paragraph_zero_based":29689},{"literal_text_all_w_t_and_m_t":"pathlossReferenceRS-Id","paragraph_zero_based":29690},{"literal_text_all_w_t_and_m_t":"The ID of the reference Signal (e.g. a CSI-RS or a SS block) used for PUSCH, PUCCH and SRS path loss estimation. This field refers to an element in the list configured using pathlossReferenceRSToAddModList in the serving cell and UL BWP where the UL TCI State is applied by the UE.","paragraph_zero_based":29691},{"literal_text_all_w_t_and_m_t":"ul-powerControl","paragraph_zero_based":29692},{"literal_text_all_w_t_and_m_t":"Configures power control parameters for PUCCH, PUSCH and SRS for this TCI state. The field is present here only if ul-powerControl is not configured in any BWP-Uplink-Dedicated of this serving cell. This field refers to an element in the list configured using uplink-PowerControlToAddModList in the serving cell where the ul-TCI-ToAddModList is configured.","paragraph_zero_based":29693},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29694},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":29695},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":29696},{"literal_text_all_w_t_and_m_t":"CSI-RSorSRS-Indicated","paragraph_zero_based":29697},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if referenceSignal is set to csi-RS-index or to srs, absent otherwise","paragraph_zero_based":29698},{"literal_text_all_w_t_and_m_t":"Mandatory","paragraph_zero_based":29699},{"literal_text_all_w_t_and_m_t":"The field is mandatory present.","paragraph_zero_based":29700},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29701},{"literal_text_all_w_t_and_m_t":"–TCI-UL-StateId","paragraph_zero_based":29702},{"literal_text_all_w_t_and_m_t":"The IE TCI-UL-StateId is used to identify one TCI-UL-State configuration.","paragraph_zero_based":29703},{"literal_text_all_w_t_and_m_t":"TCI-UL-StateId information element","paragraph_zero_based":29704},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29705},{"literal_text_all_w_t_and_m_t":"-- TAG-TCI-UL-STATEID-START","paragraph_zero_based":29706},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29707},{"literal_text_all_w_t_and_m_t":"TCI-UL-StateId-r17 ::=              INTEGER (0..maxUL-TCI-1-r17)","paragraph_zero_based":29708},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29709},{"literal_text_all_w_t_and_m_t":"-- TAG-TCI-UL-STATEID-STOP","paragraph_zero_based":29710},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29711}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["e488b7f89c0ccf192554796cbcc38107d6519606000b89d7c88c4d695cd2ffe8","58a37e30a56902184862d84e01ce76086bca190309d77901e71fba70cdd48966","470ccc8afd597f8d787991cf1efd96c78825f6efc1096500ce02b24dc839ba90","49e408b208953bb41ff7cbb8a559991a35380d57defafebd9e90b7f3b7358d59","54d7f0bbf3f750cd8cd0ee89f52600cc88db612b04f1c77ceb55456abc898b8b","b8bf459d2a3404a24cbbdbdeec619602ff647d2bcc78250c311ffbfa50810cc3","5ced41adec0e6c8f02d54cbfbcb0f73adc890e148d26d444cd5430399f7373ca","41fd215b23cd99865d72d9fbca2affe0ea50e650c7d2e1f1625b50b6f3fa6e10","e9807801f63dc835626e85b94902f418d5f4a547fcfd2ae3bcc703fe