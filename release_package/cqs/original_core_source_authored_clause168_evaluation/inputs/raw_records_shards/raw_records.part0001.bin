{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    k0-v1710                                INTEGER(33..128)                                               OPTIONAL    -- Need S","paragraph_zero_based":22896},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":22897},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":22898},{"literal_text_all_w_t_and_m_t":"    repetitionNumber-v1730                  ENUMERATED {n2, n3, n4, n5, n6, n7, n8, n16}                   OPTIONAL   -- Cond Format1-2","paragraph_zero_based":22899},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":22900},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22901},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22902},{"literal_text_all_w_t_and_m_t":"Dummy-TDRA-List ::= SEQUENCE (SIZE(1.. maxNrofDL-Allocations)) OF MultiPDSCH-TDRA-r17","paragraph_zero_based":22903},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22904},{"literal_text_all_w_t_and_m_t":"MultiPDSCH-TDRA-List-r17 ::= SEQUENCE (SIZE(1.. maxNrofDL-AllocationsExt-r17)) OF MultiPDSCH-TDRA-r17","paragraph_zero_based":22905},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22906},{"literal_text_all_w_t_and_m_t":"MultiPDSCH-TDRA-r17 ::= SEQUENCE {","paragraph_zero_based":22907},{"literal_text_all_w_t_and_m_t":"    pdsch-TDRA-List-r17                 SEQUENCE (SIZE(1..maxNrofMultiplePDSCHs-r17)) OF PDSCH-TimeDomainResourceAllocation-r16,","paragraph_zero_based":22908},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":22909},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22910},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22911},{"literal_text_all_w_t_and_m_t":"-- TAG-PDSCH-TIMEDOMAINRESOURCEALLOCATIONLIST-STOP","paragraph_zero_based":22912},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":22913},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22914},{"literal_text_all_w_t_and_m_t":"PDSCH-TimeDomainResourceAllocation field descriptions","paragraph_zero_based":22915},{"literal_text_all_w_t_and_m_t":"k0","paragraph_zero_based":22916},{"literal_text_all_w_t_and_m_t":"Slot offset between DCI and its scheduled PDSCH (see TS 38.214 [19], clause 5.1.2.1). k0-v1710 is only applicable for PDSCH SCS of 480 kHz and 960 kHz. If multiple PDSCHs are configured per PDCCH, the network always configures this field. Otherwise, when the field is absent and only one PDSCH is configured per PDCCH, the UE applies the value 0.","paragraph_zero_based":22917},{"literal_text_all_w_t_and_m_t":"mappingType","paragraph_zero_based":22918},{"literal_text_all_w_t_and_m_t":"PDSCH mapping type (see TS 38.214 [19], clause 5.3).","paragraph_zero_based":22919}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["75270b01e10e4d246e3284fc0308077593c21a7be21baec02f5e5336921521c4","2fdbd98932a5d042ac4d01e853c072c090ee9adb870ad08b58d8adbecb81f984","78574df40ffbc8d7c488a5bdd926dbc584464c0a2c1b11f2c00d817d45365652","4260fff36d33f9ee506098bae441864edfc4b12fe24a7fee6062a247955df6c0","977954b0799483c032e3ac3943c99d8e03ca2c2ecc8ffe8695093fc43b98da3d","540786132a7d0263f3fde5f687ac741e27783b93032a6b64aad8451eaf3ba15c","c03371a229bdd1375a65658f596d6eabf2f6cbc24a8cc271b8013c9c895d7652","38ec31b46f9a19969845d7dfe7408f75385145403170302d33e2f62c5dd17c99","2f576d5a8b26828224de3d0b9aeb4a5af52964e465d4ce762be116f9efccddcc","40f039abd6c2e14b1de35b3986f3775f4abe4da4b17d1032e677dd7b4be77eca","da2951dc9f8896618e49330615589abdf3fb8a62729523720a57305d178adf5a","9476cf1ac996e0191e3035dc