{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"NSAG-ID-r17 ::=                      BIT STRING (SIZE (8))","paragraph_zero_based":21720},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21721},{"literal_text_all_w_t_and_m_t":"-- TAG-NSAG-ID-STOP","paragraph_zero_based":21722},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21723},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21724},{"literal_text_all_w_t_and_m_t":"–NSAG-IdentityInfo","paragraph_zero_based":21725},{"literal_text_all_w_t_and_m_t":"The IE NSAG-IdentityInfo is used to identify an NSAG (TS 23.501 [32]) for slice-based cell reselection.","paragraph_zero_based":21726},{"literal_text_all_w_t_and_m_t":"NSAG-IdentityInfo information element","paragraph_zero_based":21727},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21728},{"literal_text_all_w_t_and_m_t":"-- TAG-NSAG-IDENTITYINFO-START","paragraph_zero_based":21729},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21730},{"literal_text_all_w_t_and_m_t":"NSAG-IdentityInfo-r17 ::=            SEQUENCE {","paragraph_zero_based":21731},{"literal_text_all_w_t_and_m_t":"    nsag-ID-r17                          NSAG-ID-r17,","paragraph_zero_based":21732},{"literal_text_all_w_t_and_m_t":"    trackingAreaCode-r17                 TrackingAreaCode               OPTIONAL      -- Need R","paragraph_zero_based":21733},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21734},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21735},{"literal_text_all_w_t_and_m_t":"-- TAG-NSAG-IDENTITYINFO-STOP","paragraph_zero_based":21736},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21737},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21738},{"literal_text_all_w_t_and_m_t":"NSAG-IdentityInfo field descriptions","paragraph_zero_based":21739},{"literal_text_all_w_t_and_m_t":"trackingAreaCode","paragraph_zero_based":21740},{"literal_text_all_w_t_and_m_t":"If absent, UE assumes the trackingAreaCode of the serving cell.","paragraph_zero_based":21741},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21742},{"literal_text_all_w_t_and_m_t":"–NTN-Config","paragraph_zero_based":21743}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["73a39c79327f7f468f82dce2feed9b5b07b54bdb27435f29e26aa62605a0a1bf","a1d9e25d2efeffcf907897bca75f1e87ace917f3c9363b72a1e44373aaa4024f","db2e7dfbdcb71f22c381f42a585e329461c5438a4244abb6b5e956deb451181a","ca510243cd76d4ae62e3e014b3d9a9c8575b786144d99d972195f83bbd78b600","fe0eb937c5635536b87c5264f6ccb3a1ec256b194ffafe2ef47f27916751a0c1","7ba831fc3a4649b4ca704d664a24b9e63c2ae57345e6db5e8fb84cda5c8f5e76","66cf42e2ae3d8497ab9d1c721c701bb72f4d8a4159529bdfcbc064951dde97d3","a13296b8d291d42fa099813cad3ebe4cb8746d0579b4885b5cd9773f390527c8","c555edac51b6009189f05a8101fe916584b7cac662e2a50cc707934ab016176b","74d97ce42f3c2530aa1050cda15d73b08641549f6469c2cf503dffadcc78247a","1094d91e7e07d3e980fd918937849aa93762d07a6671f82c337fba94772da7a9","d9b608ad3f9fc34106d65ddf4e5e24102851b1257bc5dd76d85db089c63e47ac","3b5bd48a9e34743923beca73f0d9a370f0524f12cbe8ea44587eab485540c0e5","657024ba6c8dd6dcdfaa7407daf60b96ef0de20c761399033b9e74b1f7ba2e8b","85e0436fb315bfb697ad8ca647ec032bce7c5c880f5ae04b62666a506a88485c","57d96c4d6d6d206707c546194639ade649d8ef7dbe40904970d3be231f576f2a","3d0c2584b11595d569b2ce06127915b1e01b4ef5261de0270499212638766053","28fa27a0b61a0561bfd92b30ca1e8fecc875ff6f3cc72654655868054d88910c","5627517db410fe565040f8e922ae1d21fec06d6396c3f6ff5030bacd34be89f2","5461cfc613d1f6be09753e6d8a45da8fbd3e5d9a89f81a619e02b7d48a5820ed","cee5a0f5e55e04e4fe61de55cafb3b141647e182ed4f3e462cbd08d2eee0b66d","d78882d374fb5879ecb6bd84b02082a174741c1849b29afa00308789572949f9","f383be25b012ff1e2fa723e6b9bc68624734f839a626597de022f487616c705f","109430581204a7cb390e695df62ec8cf7c0a335a4be6ccf28e7c9ee8a680f8c4"],"paragraph_range_zero_based":[21720,21743],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p21720"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE NTN-Config provides parameters needed for the UE to access NR via NTN access.","paragraph_zero_based":21744},{"literal_text_all_w_t_and_m_t":"NTN-Config information element","paragraph_zero_based":21745},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21746},{"literal_text_all_w_t_and_m_t":"-- TAG-NTN-CONFIG-START","paragraph_zero_based":21747},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21748},{"literal_text_all_w_t_and_m_t":"NTN-Config-r17 ::=             SEQUENCE {","paragraph_zero_based":21749},{"literal_text_all_w_t_and_m_t":"    epochTime-r17                  EpochTime-r17                                                            OPTIONAL,  -- Need R","paragraph_zero_based":21750},{"literal_text_all_w_t_and_m_t":"    ntn-UlSyncValidityDuration-r17 ENUMERATED{ s5, s10, s15, s20, s25, s30, s35,","paragraph_zero_based":21751},{"literal_text_all_w_t_and_m_t":"                                              s40, s45, s50, s55, s60, s120, s180, s240, s900}              OPTIONAL,  -- Cond SIB19","paragraph_zero_based":21752},{"literal_text_all_w_t_and_m_t":"    cellSpecificKoffset-r17        INTEGER(1..1023)                                                         OPTIONAL,  -- Need R","paragraph_zero_based":21753},{"literal_text_all_w_t_and_m_t":"    kmac-r17                       INTEGER(1..512)                                                          OPTIONAL,  -- Need R","paragraph_zero_based":21754},{"literal_text_all_w_t_and_m_t":"    ta-Info-r17                    TA-Info-r17                                                              OPTIONAL,  -- Need R","paragraph_zero_based":21755},{"literal_text_all_w_t_and_m_t":"    ntn-PolarizationDL-r17         ENUMERATED {rhcp,lhcp,linear}                                            OPTIONAL,  -- Need R","paragraph_zero_based":21756},{"literal_text_all_w_t_and_m_t":"    ntn-PolarizationUL-r17         ENUMERATED {rhcp,lhcp,linear}                                            OPTIONAL,  -- Need R","paragraph_zero_based":21757},{"literal_text_all_w_t_and_m_t":"    ephemerisInfo-r17              EphemerisInfo-r17                                                        OPTIONAL,  -- Need R","paragraph_zero_based":21758},{"literal_text_all_w_t_and_m_t":"    ta-Report-r17                  ENUMERATED {enabled}                                                     OPTIONAL,  -- Need R","paragraph_zero_based":21759},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":21760},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21761},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21762},{"literal_text_all_w_t_and_m_t":"EpochTime-r17 ::=              SEQUENCE {","paragraph_zero_based":21763},{"literal_text_all_w_t_and_m_t":"    sfn-r17                        INTEGER(0..1023),","paragraph_zero_based":21764},{"literal_text_all_w_t_and_m_t":"    subFrameNR-r17                 INTEGER(0..9)","paragraph_zero_based":21765},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21766},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21767}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["70dba4e26199ff83c6226270f642cfc2010c8acd79eb3a3b82f359fa70c45303","1976a1e4c2a63933d1e5f00dbebfff27b5435a7c31c79ea92908e41e956ab636","756b973eb4568faf77ccbb8a23633cce9db7d53644fdd813cd7218f200857ec6","da1eb83b93915ae325b24cf790869aa04cce0915bd6ea20a479c3383f1aefd0a","6df25d1c25ac3d0ef70b8a67dcf61f8fb321b384f9e9b3eed7de51f7e4b1c02d","5ba773a3684cc76e86de09c0b77d94c7c50943fd25a124ae4d52f0410b5a5adf","bea01097c545326ca5d83eec09bd5241a0a5ab8feb5e04d3921dba49fa0ac295","d4a8e8e677a317fa31a61463542cba204fb94c4c1f9661b9dc44e4ba467923ef","941f41ffce768d4e95bdbfc9bb39492dc61ca5c7b356680b9245a586c6d11d30","6366d4bea194dfd01a807441e951e4457933e65921e766c34654e6db6a2a9496","9378fd0bb63b0e56eb9194af0bc58bc15dfc12b858f8ab789bc065a80bc8d420","495e510ae7259eeb6d69d2608d73122f83434e62f47e0419ed21cbdaa9828a7f","666564bdf1859a1cf1cd7edb47caf72b5500755fc99549124adb9ee3e5e86ca3","6b51f7b104aed1331e6bf4c8fa8f1056c31eb22b5aeda3279f0d2f9f1508fdc0","59c558379f338d0cdf467618450c5304c889b794d4d5843a65f17bf6ba3f70cb","471b760c1dd853060fdbc7b97706e184847a5fad8c5fffafbf03c5986c2f9318","7d6b9041f25dc4bded7b069986f484f026cf2467db668eae4b12f4ed1f4170ac","22d08d9764a8b720816d499f97ae1956320fa24b20add835097ed8ed4a048ac4","527eb55519aaadff5ee00b43dd78fd3e112a88b59041b0ce1afe35fccd4b66c6","8d1ee46ad1d23ca5f55f95a7b8d3d1477864453a6c49995fdd3d1f8f243d7153","57f8b8196ac604cf5f9ff6262fdbd4f9fd456aa10e138ebc5f9b11ac1d895693","8639a57dc7d0d2e1d93f91da572e75793db662eada576632b39e0d9debcca624","d5b77c9055577dac0bf9697a358a66af32edb94f13430ae434e7a63456e41e1c","0827edaff743636f7d270690edfa23684a99ca4fd14e709f00730a78d68d05b3"],"paragraph_range_zero_based":[21744,21767],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p21744"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"TA-Info-r17 ::=                 SEQUENCE  {","paragraph_zero_based":21768},{"literal_text_all_w_t_and_m_t":"    ta-Common-r17                  INTEGER(0..66485757),","paragraph_zero_based":21769},{"literal_text_all_w_t_and_m_t":"    ta-CommonDrift-r17             INTEGER(-257303..257303)                                                 OPTIONAL,  -- Need R","paragraph_zero_based":21770},{"literal_text_all_w_t_and_m_t":"    ta-CommonDriftVariant-r17      INTEGER(0..28949)                                                        OPTIONAL   -- Need R","paragraph_zero_based":21771},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21772},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21773},{"literal_text_all_w_t_and_m_t":"-- TAG-NTN-CONFIG-STOP","paragraph_zero_based":21774},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21775},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21776},{"literal_text_all_w_t_and_m_t":"NTN-Config field descriptions","paragraph_zero_based":21777},{"literal_text_all_w_t_and_m_t":"EphemerisInfo","paragraph_zero_based":21778},{"literal_text_all_w_t_and_m_t":"This field provides satellite ephemeris either in format of position and velocity state vector or in format of orbital parameters. This field is excluded when determining changes in system information, i.e. changes to ephemerisInfo should neither result in system information change notifications nor in a modification of valueTag in SIB1.","paragraph_zero_based":21779},{"literal_text_all_w_t_and_m_t":"epochTime","paragraph_zero_based":21780},{"literal_text_all_w_t_and_m_t":"Indicate the epoch time for the NTN assistance information. When explicitly provided through SIB, or through dedicated signaling, the EpochTime is the starting time of a DL sub-frame, indicated by a SFN and a sub-frame number signaled together with the assistance information. For serving cell, the field sfn indicates the current SFN or the next upcoming SFN after the frame where the message indicating the epochTime is received. For neighbour cell, the sfn indicates the SFN nearest to the frame where the message indicating the epochTime is received. The reference point for epoch time of the serving or neighbour NTN payload ephemeris and Common TA parameters is the uplink time synchronization reference point. If this field is absent, the epoch time is the end of SI window where this SIB19 is scheduled. This field is mandatory present when ntn-Config is provided in dedicated configuration. If this field is absent in ntn-Config provided via NTN-NeighCellConfig the UE uses epoch time of the serving cell, otherwise the field is based on the timing of the serving cell, i.e. the SFN and sub-frame number indicated in this field refers to the SFN and sub-frame of the serving cell. In case of handover or conditional handover, this field is based on the timing of the target cell, i.e. the SFN and sub-frame number indicated in this field refers to the SFN and sub-frame of the target cell. For the target cell the UE considers epoch time, indicated by the SFN and sub-frame number in this field, to be the frame nearest to the frame in which the message indicating the epoch time is received. This field is excluded when determining changes in system information, i.e. changes to epochTime should neither result in system information change notifications nor in a modification of valueTag in SIB1.","paragraph_zero_based":21781},{"literal_text_all_w_t_and_m_t":"cellSpecificKoffset","paragraph_zero_based":21782},{"literal_text_all_w_t_and_m_t":"Scheduling offset used for the timing relationships that are modified for NTN (see TS 38.213 [13]). The unit of the field K_offset is number of slots for a given subcarrier spacing of 15 kHz. If the field is absent UE assumes value 0.","paragraph_zero_based":21783},{"literal_text_all_w_t_and_m_t":"kmac","paragraph_zero_based":21784},{"literal_text_all_w_t_and_m_t":"Scheduling offset provided by network if downlink and uplink frame timing are not aligned at gNB. If the field is absent UE assumes value 0. In FR1, the unit of kmac is number of slots for a given subcarrier spacing of 15 kHz.","paragraph_zero_based":21785},{"literal_text_all_w_t_and_m_t":"ntn-PolarizationDL","paragraph_zero_based":21786},{"literal_text_all_w_t_and_m_t":"If present, this parameter indicates polarization information for downlink transmission on service link: including Right hand, Left hand circular polarizations (RHCP, LHCP) and Linear polarization.","paragraph_zero_based":21787},{"literal_text_all_w_t_and_m_t":"ntn-PolarizationUL","paragraph_zero_based":21788},{"literal_text_all_w_t_and_m_t":"If present, this parameter indicates Polarization information for uplink service link.","paragraph_zero_based":21789},{"literal_text_all_w_t_and_m_t":"If not present and ntn-PolarizationDL is present, UE assumes the same polarization for UL and DL.","paragraph_zero_based":21790},{"literal_text_all_w_t_and_m_t":"ntn-UlSyncValidityDuration","paragraph_zero_based":21791}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["99f216d14fea70e2c3e4f18286324c7b21d1125a6bdae70f6e24f0e0da9c3051","2ee9e49f87104971579287626a08a3cea0f697cef4d8c066c8b4bd95d46a033a","b559f01bd72637d25bab26ada729abd66f22f938d49773db332b46a15bbaf6c3","87474ac88987c047becc39168bc467eea405a42540c6b149fbb945d1325c16f9","de93b023c7e836b44ba3659cc76257133b78691a9c4b4f1f5c42b0bf9e27dc10","54153e0daf1b540526c45ed211d21dc3157c453a89faeed7c2867c19a63ebae9","76b0e87a1d1e829626b0c85eed3668a4389abde0324422cc53b9cb4b0ae9ffbe","8fbd1d17abaa39f0531908b7632dc33c12ab5a38ce09a8e1aeda1899a19ffe7e","d87af5445931a388d3408196cd593b20abf80e960425ed17703d2f6dad2f2c29","f518e342bd027c54dc9028f3b47628527c0f3d8372def456b2b5e4f6b29e8f2a","a6379897e4aa30d0259be79d879ff5bf6416a0fbae45f00b115496a984d66e4d","00a11f6a2b225a32b5129ac999b20e13be4f5b20524487070817c4b78c32fdc1","04928f22c474ed32a1b84200798e5359c2a891c23f84e391189862db9fd4abbd","250c77591be75447a478fcefee24986d57cf1617a9d6b75f332bc711f40116cf","918ad931ceb7cc7813d85138b07e0b66ba06d83856178db07338fb5764948412","911120c1ff3149ba108f29a6e58df27d586ae4fecf39a6b2f5a824044444e00a","ca995ba322c45b2dcaea99b6e07da30c38b41d3dc1274d4958d3e6b488e82277","b075157aab696562efce23f7120669bc4e3ff31a192f014b23591e7c48e035a0","15ec25dabd15007fd26af6dee7ba1fb162cab02d8b0d8005aa2516eb929fbcea","16cec6ab52a50fc537f47b32cdb56bf8d9baeadaefcab14687637e4e9401d048","9399cd608e9723a617e90c3c9818a10bdc0e47d63dc79964158213d282133b7e","56132a17342c0d9ab71f9efb4c0ce9bb21ce0390307235d711ae40fdd4ff131b","117def2f93abb19518e02d3de7320ef36e2c464b10cddffe917ab8b8667eee7f","b8bb583f62f709d4ed1ba771f972124f73a5784188914bb876811ae06888884b"],"paragraph_range_zero_based":[21768,21791],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p21768"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"A validity duration configured by the network for assistance information (i.e. Serving and/or neighbour satellite ephemeris and Common TA parameters) which indicates the maximum time duration (from epochTime) during which the UE can apply assistance information without having acquired new assistance information.","paragraph_zero_based":21792},{"literal_text_all_w_t_and_m_t":"The unit of ntn-UlSyncValidityDuration is second. Value s5 corresponds to 5 s, value s10 indicate 10 s and so on. This parameter applies to both connected and idle mode UEs. If this field is absent in ntn-Config provided via NTN-NeighCellConfig, the UE uses validity duration from the serving cell assistance information. This field is excluded when determining changes in system information, i.e. changes of ntn-UlSyncValidityDuration should neither result in system information change notifications nor in a modification of valueTag in SIB1. ntn-UlSyncValidityDuration is only updated when at least one of epochTime, ta-Info, ephemerisInfo is updated.","paragraph_zero_based":21793},{"literal_text_all_w_t_and_m_t":"ta-Common","paragraph_zero_based":21794},{"literal_text_all_w_t_and_m_t":"Network-controlled common timing advanced value and it may include any timing offset considered necessary by the network. ta-Common with value of 0 is supported. The granularity of ta-Common is 4.072 × 10^(-3) μs. Values are given in unit of corresponding granularity. This field is excluded when determining changes in system information, i.e. changes of ta-Common should neither result in system information change notifications nor in a modification of valueTag in SIB1.","paragraph_zero_based":21795},{"literal_text_all_w_t_and_m_t":"ta-CommonDrift","paragraph_zero_based":21796},{"literal_text_all_w_t_and_m_t":"Indicate drift rate of the common TA. The granularity of ta-CommonDrift is 0.2 × 10^(-3) μs⁄s. Values are given in unit of corresponding granularity. This field is excluded when determining changes in system information, i.e. changes of ta-CommonDrift should neither result in system information change notifications nor in a modification of valueTag in SIB1.","paragraph_zero_based":21797},{"literal_text_all_w_t_and_m_t":"ta-CommonDriftVariant","paragraph_zero_based":21798},{"literal_text_all_w_t_and_m_t":"Indicate drift rate variation of the common TA. The granularity of ta-CommonDriftVariant is 0.2×10^(-4) μs⁄s^2. Values are given in unit of corresponding granularity. This field is excluded when determining changes in system information, i.e. changes of ta-CommonDriftVariant should neither result in system information change notifications nor in a modification of valueTag in SIB1.","paragraph_zero_based":21799},{"literal_text_all_w_t_and_m_t":"ta-Report","paragraph_zero_based":21800},{"literal_text_all_w_t_and_m_t":"When this field is included in SIB19, it indicates reporting of timing advanced is enabled during Random Access due to RRC connection establishment or RRC connection resume, and during RRC connection reestablishment. When this field is included in ServingCellConfigCommon within dedicated signalling, it indicates TA reporting is enabled during Random Access due to reconfiguration with sync (see TS 38.321 [3], clause 5.4.8).","paragraph_zero_based":21801},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21802},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":21803},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":21804},{"literal_text_all_w_t_and_m_t":"SIB19","paragraph_zero_based":21805},{"literal_text_all_w_t_and_m_t":"The field is mandatory present for the serving cell in SIB19. The field is optionally present, Need R, otherwise.","paragraph_zero_based":21806},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21807},{"literal_text_all_w_t_and_m_t":"–NZP-CSI-RS-Resource","paragraph_zero_based":21808},{"literal_text_all_w_t_and_m_t":"The IE NZP-CSI-RS-Resource is used to configure Non-Zero-Power (NZP) CSI-RS transmitted in the cell where the IE is included, which the UE may be configured to measure on (see TS 38.214 [19], clause 5.2.2.3.1). A change of configuration between periodic, semi-persistent or aperiodic for an NZP-CSI-RS-Resource is not supported without a release and add.","paragraph_zero_based":21809},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-Resource information element","paragraph_zero_based":21810},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21811},{"literal_text_all_w_t_and_m_t":"-- TAG-NZP-CSI-RS-RESOURCE-START","paragraph_zero_based":21812},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21813},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-Resource ::=             SEQUENCE {","paragraph_zero_based":21814},{"literal_text_all_w_t_and_m_t":"    nzp-CSI-RS-ResourceId               NZP-CSI-RS-ResourceId,","paragraph_zero_based":21815}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["91695b24ae48809fd90c3ae7573e3c403d58cac25cc67c61950788e6f2f9b913","5fdcd9e76b18de605f4d3da69073cabca7f7e9f87e1c729058a4f8d49a9262b9","347b18c90130265a11fa0dfc34674db341abee4a71d9c1f64b557a90fb021d94","c2a1bc5740fdfcafea2526efa0e7185b7b5679acbe9dd71af9fff06d710776ef","30c2cdd0189f7d6aade0a5e940a94ed530f27489670b4c3da26eaa23d0111616","25515d749ff4c76ec9b7fe6d6437d4b8fcd8ad4af535ab1ecfb8d2884b597cf6","870708d8d26c2f8e84d9b5b6e92eb514123419203c635631f2d0e04d626d6432","b99339ed75bbd3ee793eb7c5150cc30f915c0fc41d02763daeb6e15997f3d0df","d3a3dc2387e1993