{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"PUSCH-ConfigCommon ::=                  SEQUENCE {","paragraph_zero_based":24312},{"literal_text_all_w_t_and_m_t":"    groupHoppingEnabledTransformPrecoding   ENUMERATED {enabled}                                                OPTIONAL,   -- Need R","paragraph_zero_based":24313},{"literal_text_all_w_t_and_m_t":"    pusch-TimeDomainAllocationList          PUSCH-TimeDomainResourceAllocationList                              OPTIONAL,   -- Need R","paragraph_zero_based":24314},{"literal_text_all_w_t_and_m_t":"    msg3-DeltaPreamble                      INTEGER (-1..6)                                                     OPTIONAL,   -- Need R","paragraph_zero_based":24315},{"literal_text_all_w_t_and_m_t":"    p0-NominalWithGrant                     INTEGER (-202..24)                                                  OPTIONAL,   -- Need R","paragraph_zero_based":24316},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":24317},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":24318},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24319},{"literal_text_all_w_t_and_m_t":"-- TAG-PUSCH-CONFIGCOMMON-STOP","paragraph_zero_based":24320},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":24321},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24322},{"literal_text_all_w_t_and_m_t":"PUSCH-ConfigCommon field descriptions","paragraph_zero_based":24323},{"literal_text_all_w_t_and_m_t":"groupHoppingEnabledTransformPrecoding","paragraph_zero_based":24324},{"literal_text_all_w_t_and_m_t":"For DMRS transmission with transform precoder, the NW may configure group hopping by this cell-specific parameter, see TS 38.211 [16], clause 6.4.1.1.1.2.","paragraph_zero_based":24325},{"literal_text_all_w_t_and_m_t":"msg3-DeltaPreamble","paragraph_zero_based":24326},{"literal_text_all_w_t_and_m_t":"Power offset between msg3 and RACH preamble transmission. Actual value = field value * 2 [dB] (see TS 38.213 [13], clause 7.1)","paragraph_zero_based":24327},{"literal_text_all_w_t_and_m_t":"p0-NominalWithGrant","paragraph_zero_based":24328},{"literal_text_all_w_t_and_m_t":"P0 value for PUSCH with grant (except msg3). Value in dBm. Only even values (step size 2) allowed (see TS 38.213 [13], clause 7.1) This field is cell specific","paragraph_zero_based":24329},{"literal_text_all_w_t_and_m_t":"pusch-TimeDomainAllocationList","paragraph_zero_based":24330},{"literal_text_all_w_t_and_m_t":"List of time domain allocations for timing of UL assignment to UL data (see TS 38.214 [19], table 6.1.2.1.1-1).","paragraph_zero_based":24331},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24332},{"literal_text_all_w_t_and_m_t":"–PUSCH-PowerControl","paragraph_zero_based":24333},{"literal_text_all_w_t_and_m_t":"The IE PUSCH-PowerControl is used to configure UE specific power control parameter for PUSCH.","paragraph_zero_based":24334},{"literal_text_all_w_t_and_m_t":"PUSCH-PowerControl information element","paragraph_zero_based":24335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["383788ec4c3a5e5160b74bab8785398b7275da7ffd83470bf49bb3b732f8944a","6ba91e8300eda96d4f923954c2710678bc2501f880b21004de85768b65338b3f","0cdedb2b64927484d0d7f80b6fa0bebb479f4f8a4e511e1b6241c9ca65a3b277","c3105df91c0b2ad80622450ae6d04630df9fc0f73f026be4e11c73468787e152","ee6db1591c8420a16ab0e9b335cb8f0825a57523de2dcc267a33f7d8f4691f26","a7311db6d7741946d5017294619837a7b9982c46a0553257669f38b52c64d332","5b9da2c5ad80ed156070fe46c17c696b3cb54151dd6711f81323