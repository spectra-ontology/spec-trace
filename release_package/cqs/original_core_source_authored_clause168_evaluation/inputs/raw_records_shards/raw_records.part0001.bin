{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SL-MinMaxMCS-Config-r16 ::=            SEQUENCE {","paragraph_zero_based":39168},{"literal_text_all_w_t_and_m_t":"    sl-MCS-Table-r16                       ENUMERATED {qam64, qam256, qam64LowSE},","paragraph_zero_based":39169},{"literal_text_all_w_t_and_m_t":"    sl-MinMCS-PSSCH-r16                    INTEGER (0..27),","paragraph_zero_based":39170},{"literal_text_all_w_t_and_m_t":"    sl-MaxMCS-PSSCH-r16                    INTEGER (0..31)","paragraph_zero_based":39171},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39172},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39173},{"literal_text_all_w_t_and_m_t":"SL-BetaOffsets-r16 ::=                 INTEGER (0..31)","paragraph_zero_based":39174},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39175},{"literal_text_all_w_t_and_m_t":"SL-PowerControl-r16 ::=    SEQUENCE {","paragraph_zero_based":39176},{"literal_text_all_w_t_and_m_t":"    sl-MaxTransPower-r16       INTEGER (-30..33),","paragraph_zero_based":39177},{"literal_text_all_w_t_and_m_t":"    sl-Alpha-PSSCH-PSCCH-r16   ENUMERATED {alpha0, alpha04, alpha05, alpha06, alpha07, alpha08, alpha09, alpha1}  OPTIONAL,   -- Need M","paragraph_zero_based":39178},{"literal_text_all_w_t_and_m_t":"    dl-Alpha-PSSCH-PSCCH-r16   ENUMERATED {alpha0, alpha04, alpha05, alpha06, alpha07, alpha08, alpha09, alpha1}  OPTIONAL,   -- Need S","paragraph_zero_based":39179},{"literal_text_all_w_t_and_m_t":"    sl-P0-PSSCH-PSCCH-r16      INTEGER (-16..15)                                                                  OPTIONAL,   -- Need S","paragraph_zero_based":39180},{"literal_text_all_w_t_and_m_t":"    dl-P0-PSSCH-PSCCH-r16      INTEGER (-16..15)                                                                  OPTIONAL,   -- Need M","paragraph_zero_based":39181},{"literal_text_all_w_t_and_m_t":"    dl-Alpha-PSFCH-r16         ENUMERATED {alpha0, alpha04, alpha05, alpha06, alpha07, alpha08, alpha09, alpha1}  OPTIONAL,   -- Need S","paragraph_zero_based":39182},{"literal_text_all_w_t_and_m_t":"    dl-P0-PSFCH-r16            INTEGER (-16..15)                                                                  OPTIONAL,   -- Need M","paragraph_zero_based":39183},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":39184},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":39185},{"literal_text_all_w_t_and_m_t":"    dl-P0-PSSCH-PSCCH-r17      INTEGER (-202..24)                                                                 OPTIONAL,   -- Need M","paragraph_zero_based":39186},{"literal_text_all_w_t_and_m_t":"    sl-P0-PSSCH-PSCCH-r17      INTEGER (-202..24)                                                                 OPTIONAL,   -- Need S","paragraph_zero_based":39187},{"literal_text_all_w_t_and_m_t":"    dl-P0-PSFCH-r17            INTEGER (-202..24)                                                                 OPTIONAL    -- Need M","paragraph_zero_based":39188},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":39189},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39190},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["822abc64705b6e26a3e8f7e6058e143cbd1e1cbd12e37407276e32a4f7a8409d","994a4eaa2dfc8a2e34b81b5155c339c74b4055ce2c0b2f7c29ecd566081436ce","1033ca719621ca2dc8ed6beaf28137e3d7acb6ccd3b0c758d789ff712c875972","39cf7baaed607f80ee86d618de4b602060a8d8d580a0b6f25f053c24fd6fa20e","3a6599df1f13077c4b73c2e2f90d8aedd6f8d65cf866f019644d883cdb0f248b","9e2ba3a7955a11584e22186df75e16150dd771e56bb22f3371dcf999a5613d48","ecff49ce0a2671b4e96adf544e5ca1e6d713b0468c5fc93d16a883ce25c04074","e3b0173eee64c887893af22f48f1963e1ac152c38e90ea6979f8c4e94d8494ca","55a8edf70670c32b21be10c7e8b7b798cd8514d80961566458a7dcac448fd5b0","e1055c563d07b47230134e10b3c90cc9f0b2be772e5c2d3259c295ef55d93f9e","70a3db9059624198780efa7593538049277c9ae2214d4d3d073568d9f5374146","1eb29d6d848ce5465f0446b59171c40c77a77cb5fcf7697726a72e5eeb24eba9","eed14f865f80ebd7e2ec426b462c0c257a38bcbaa559946e245b985a789297e2","a3f9c8e621fc09cd93622ac6ac49da7e48454cb53bb17e8788e0209da84b3480","12c9161625540a814e6f65a8d6ffc982b190d5e8a5eece7160da8653bee47b6c","bf69677db95a00091d39a9e8963e52cfa33afa6414d9476424e379bcd68aff94","4d5618c9a0a3f4f2f45840a2e236d7fed914bddf43f5869f16f8a3d7d04473a4","37d14e2cadae42c94fe27d6a3d8a6ed373c4a82cb0b7c5e36b8fe1ab5fddc1b6","bbd486ed893d53303dc9e7b9043196559cc6f414a0a35878ab26030e45d7b6bc","a4f021d36f51a4516410fe0529c8c67ea29e452ccb09ca84e8e8c5f9b7797cf1","bddb6eeec4a80ea067f21e194c971c0366259328e1b27f2928084c1c5f1163ce","171c84313aa6db64a2366e83e5c4183c4aacacdb6ce0b60f1134cf83f4006619","03de0a61aad68ffdfaf3f4761efd1062e71eeb3b8e26c4be15ed57fc31a66050","1d48a4f53e6f5095dd1bd6c064717048e66cd42d6361cabe28ffbeebedb24282"],"paragraph_range_zero_based":[39168,39191],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p39168"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RESOURCEPOOL-STOP","paragraph_zero_based":39192},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39193},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39194},{"literal_text_all_w_t_and_m_t":"SL-ZoneConfigMCR field descriptions","paragraph_zero_based":39195},{"literal_text_all_w_t_and_m_t":"sl-TransRange","paragraph_zero_based":39196},{"literal_text_all_w_t_and_m_t":"Indicates the communication range requirement for the corresponding sl-ZoneConfigMCR-Index. The unit is meter.","paragraph_zero_based":39197},{"literal_text_all_w_t_and_m_t":"sl-ZoneConfig","paragraph_zero_based":39198},{"literal_text_all_w_t_and_m_t":"Indicates the zone configuration for the corresponding sl-ZoneConfigMCR-Index.","paragraph_zero_based":39199},{"literal_text_all_w_t_and_m_t":"sl-ZoneConfigMCR-Index","paragraph_zero_based":39200},{"literal_text_all_w_t_and_m_t":"Indicates the codepoint of the communication range requirement field in SCI.","paragraph_zero_based":39201},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39202},{"literal_text_all_w_t_and_m_t":"SL-ResourcePool field descriptions","paragraph_zero_based":39203},{"literal_text_all_w_t_and_m_t":"dummy","paragraph_zero_based":39204},{"literal_text_all_w_t_and_m_t":"This field is not used in the specification. If received it shall be ignored by the UE.","paragraph_zero_based":39205},{"literal_text_all_w_t_and_m_t":"sl-A2X-Service","paragraph_zero_based":39206},{"literal_text_all_w_t_and_m_t":"Presence of this field indicates the resource pool is dedicated for A2X service, i.e., not to be used for other than A2X service. Value brid indicates the resource pool is for BRID, value daa indicates the resource pool is for DAA, and value bridAndDAA indicates the resource poos is for both BRID and DAA. If this field is absent in all the configured resource pools, the UE may choose non-dedidcated resource pool for A2X service.","paragraph_zero_based":39207},{"literal_text_all_w_t_and_m_t":"sl-Additional-MCS-Table","paragraph_zero_based":39208},{"literal_text_all_w_t_and_m_t":"Indicates the MCS table(s) additionally used in the resource pool. 64QAM table is (pre-)configured as default. Zero, one or two can be additionally (pre-)configured using the 256QAM and/or low-SE MCS tables. If two MCS tables are indicated, 256QAM MCS table is the 1st table and qam64lowSE MCS table is the 2nd table as specified in TS 38.214 [19], clause 8.1.3.1.","paragraph_zero_based":39209},{"literal_text_all_w_t_and_m_t":"sl-FilterCoefficient","paragraph_zero_based":39210},{"literal_text_all_w_t_and_m_t":"This field indicates the filtering coefficient for long-term measurement and reference signal power derivation used for sidelink open-loop power control.","paragraph_zero_based":39211},{"literal_text_all_w_t_and_m_t":"sl-InterUE-CoordinationConfig","paragraph_zero_based":39212},{"literal_text_all_w_t_and_m_t":"Indicates the configured sidelink inter-UE coordination parameters.","paragraph_zero_based":39213},{"literal_text_all_w_t_and_m_t":"sl-NumSubchannel","paragraph_zero_based":39214},{"literal_text_all_w_t_and_m_t":"Indicates the number of subchannels in the corresponding resource pool, which consists of contiguous PRBs only.","paragraph_zero_based":39215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["083891e83841c3e4fa59bce9b7eb8e1131d93a58f2c676c3248f376cd7fc3e26","77553d594a7bfcfcaf9fb0e4f34f106fbed689a77b9640847dc2708a999df554","7278bbc05d07317901a10e8bdfe4dda714f43f6e0cefc3663afc98e0dae1d09f","83239ea1340fd5152b10d25cc546bac271bbd1952d7c8525a684373f60160256","99885cf0b39da4d57732a821c09e0a1f2c1e7a8314a64c33f91c5f63888add3d","4f95c244e8d0cbd71255323fccbbdde1143346580c37fbcdb33d7e2c5e795866","badef27c8847865aa8e5b4560d8d94d45d78655492fdcb9b01db83309dbf5ba6","86f0d29205816012107e9c7a642ee9bfe5281c4428dfcb3400adfe843cee72fb","a7c12f7bad2a0bd0db6449d7f7bd90968ff4ad5fdced4c48b4d2a581e13fa0e0","798c9b02d30f1d80ed6610d3bb73c2d1a3fe65e607ac6fe45df3891a929d19cf","c230ef4883085008cf614ee65fdaa2d0c7fe6bfb364eb9fedb53ca211ca181df","e1d3b9ed41bff775839c4ece0c5b7ccf29e03e0e55142295a96c9c3144c5be4f","2c60425f1d31ff11006079587e0133e5bf5a46488e374c25be4b0c602c914ef4","574c7ab9f1469d1007ccbe5973a0b3ab4bc2b70efc8d7ff1eca229349f3fe582","c9be678332115b3f92795f4c28e2b22338c1d0466e61bbe2c900de3f7eac3780","d7ad4e0f71f1ea1a59b8fbb2825d7dea976ba401d6a05ec44e2bc9a847a60f44","0ac5a3fac69b860dcc197efb89be7ac5c2967cc8d9a976b68459d534dee1c48a","9117e1caa8ee7e5df7ec1998e8540af218e8c7f577c149f8b64f8e5d98dd6841","16953aa2a06e2320094ab162f92fd8083ef6569d7643e874273153b2460b5ace","f66d5990c8d41fc53c4881c3dc00f601b6e41bb3eadea6c548035f28acf18e05","415734ccef08631500dac88c011d356e2e9ba5044a166d526f43b45b776f4304","3ad95674699ec35274c9118d5aaa5003c899a06602f62fe913cb9e0ca34244fb","ab558e02e21865a6107b011950ccb8feeb8f06799290c2e5b075e45efef66eaa","d207b612562e4425c640dc0166ab1e16ffce3389d96bc5a0975b530f326a26ac"],"paragraph_range_zero_based":[39192,39215],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p39192"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-PBPS-CPS-Config","paragraph_zero_based":39216},{"literal_text_all_w_t_and_m_t":"Indicates the allowed resource allocation schemes of full sensing only, partial sensing only, random resource selection only, or any combination(s), and the related configuration for power saving resource allocation schemes. This field is absent for sl-TxPoolExceptional.","paragraph_zero_based":39217},{"literal_text_all_w_t_and_m_t":"sl-PreemptionEnable","paragraph_zero_based":39218},{"literal_text_all_w_t_and_m_t":"Indicates whether pre-emption is disabled or enabled in a resource pool. If the field is present and the value is pl1, pl2, and so on (but not enabled), it means that pre-emption is enabled and a priority level p_preemption is configured. If the field is present and the value is enabled, the pre-emption is enabled (but p_preemption is not configured) and pre-emption is applicable to all levels.","paragraph_zero_based":39219},{"literal_text_all_w_t_and_m_t":"sl-PriorityThreshold-UL-URLLC","paragraph_zero_based":39220},{"literal_text_all_w_t_and_m_t":"Indicates the threshold used to determine whether NR sidelink transmission is prioritized over uplink transmission of priority index 1 as specified in TS 38.213[13], clause 16.2.4.3, or whether PUCCH transmission carrying SL HARQ is prioritized over PUCCH transmission carrying UCI of priority index 1 if they overlap in time as specified in TS 38.213 [13], clause 9.2.5.0.","paragraph_zero_based":39221},{"literal_text_all_w_t_and_m_t":"sl-PriorityThreshold","paragraph_zero_based":39222},{"literal_text_all_w_t_and_m_t":"Indicates the threshold used to determine whether NR sidelink transmission is prioritized over uplink transmission of priority index 0 as specified in TS 38.213[13], clause 16.2.4.3, or whether PUCCH transmission carrying SL HARQ is prioritized over PUCCH transmission carrying UCI of priority index 0 if they overlap in time as specified in TS 38.213 [13], clause 9.2.5.0.","paragraph_zero_based":39223},{"literal_text_all_w_t_and_m_t":"sl-RB-Number","paragraph_zero_based":39224},{"literal_text_all_w_t_and_m_t":"Indicates the number of PRBs in the corresponding resource pool, which consists of contiguous PRBs only. The remaining RB cannot be used (See TS 38.214[19], clause 8).","paragraph_zero_based":39225},{"literal_text_all_w_t_and_m_t":"sl-StartRB-Subchannel","paragraph_zero_based":39226},{"literal_text_all_w_t_and_m_t":"Indicates the lowest RB index of the subchannel with the lowest index in the resource pool with respect to the lowest RB index of a SL BWP.","paragraph_zero_based":39227},{"literal_text_all_w_t_and_m_t":"sl-SubchannelSize","paragraph_zero_based":39228},{"literal_text_all_w_t_and_m_t":"Indicates the minimum granularity in frequency domain for the sensing for PSSCH resource selection in the unit of PRB.","paragraph_zero_based":39229},{"literal_text_all_w_t_and_m_t":"sl-SyncAllowed","paragraph_zero_based":39230},{"literal_text_all_w_t_and_m_t":"Indicates the allowed synchronization reference(s) which is (are) allowed to use the configured resource pool.","paragraph_zero_based":39231},{"literal_text_all_w_t_and_m_t":"sl-SyncConfigIndex","paragraph_zero_based":39232},{"literal_text_all_w_t_and_m_t":"Indicates the synchronisation configuration that is associated with a reception pool, by means of an index to the corresponding entry SL-SyncConfigList of in SIB12 for NR sidelink communication.","paragraph_zero_based":39233},{"literal_text_all_w_t_and_m_t":"sl-TDD-Configuration","paragraph_zero_based":39234},{"literal_text_all_w_t_and_m_t":"Indicates the TDD configuration associated with the reception pool of the cell indicated by sl-SyncConfigIndex.","paragraph_zero_based":39235},{"literal_text_all_w_t_and_m_t":"sl-ThreshS-RSSI-CBR","paragraph_zero_based":39236},{"literal_text_all_w_t_and_m_t":"Indicates the S-RSSI threshold for determining the contribution of a sub-channel to the CBR measurement. Value 0 corresponds to -112 dBm, value 1 to -110 dBm, value n to (-112 + n*2) dBm, and so on.","paragraph_zero_based":39237},{"literal_text_all_w_t_and_m_t":"sl-TimeResource","paragraph_zero_based":39238},{"literal_text_all_w_t_and_m_t":"Indicates the bitmap of the resource pool, which is defined by repeating the bitmap with a periodicity during a SFN or DFN cycle.","paragraph_zero_based":39239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["06e0efb5d035d1d4c89e9c79e1a2622edf75d527346033bf2a98c38e208f6537","b0f568947d29cf160ea1862a815965b66ea54154bd319b22e867be531c16dfc2","897bae7fa0753b272afd60829e87c92179bbf5e5be785be8339837902fe3da4b","2723b20562010a072d20610aae87850440b244bde5653c00c9d3d15b57ccb02b","76a3ac128de97ad8c30f3bc257f67418a1958a0b0b6a64f31243f405edf4be45","fced1be3b7cd0e7397127cc19acad609bad0a32211e926e3f967c29aebb3fffa","b54e2b45d241f4b4b21156f9c5ba5c3ef76dcbde6b13ab8ef84facab7d700d64","b40464b986ebc40d0c35ab03b03d878e2531b0388898b5c3bc838516a01c1a78","0a367304fb81548d181f38cabede95684d1a26d326afe0ac80a67d77d65fa97d","ed5d9b6a84dd0db0dcf8ffb9e7f80662882fc6cb4568615a88c1cd8d9337787c","f7712ac6696dacda1c7c1f0b8fe2f69ddc572cbc39daede52226541678186eb6","b7fda2614882e08954d6087b8346b69c4a9a89b95b04dfe571af111a41ae67c6","a52a4c578c2ad859a3156f1f23e2bf63df2e2504d323b190def742d7b7ae5a97","5eb325ef7432210e4f08741358f82ad343d2981b1f9f4f0321063cac7d6d4f54","3b8d396d5943efebf68406e01b7d8be93b3b4c7d79634f8d9583a3af348e6149","ad0490aa58b0251098bd343b28da465f30d54a092dee0146623e111189607ecb","632acfdb37e972c3572b2891dd62c6c9f0b51a5556f358cf7fb3e13510d499de","14c2cc98c5b3892d2968f6de6e0b935bc0e9ac9aec13aea17944b65773d65e2e","73a6aa0352891bf1c10a0bbd36f40430af1248a6f5a5be6bed69044db823fda0","581fe419dd8247174688148950e189cd3a9432483fbd40abcda8f0d04377f477","c500ab3082bf64857aea8d7285091bdba3016b5da10ac194665c3d75a377a21a","5a9ba823c62a97e857c50248aaadc22d896ce4f54e79babbcedd9186789bb812","d64ce629725b22fca8b390be09deeb35bf217f5d805c90dc2975b0b64a24493b","41804c1c3052ffd94290c782c2af846baed16af3cec39d34698b8a48e55742e1"],"paragraph_range_zero_based":[39216,39239],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p39216"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-TimeWindowSizeCBR","paragraph_zero_based":39240},{"literal_text_all_w_t_and_m_t":"Indicates the time window size for CBR measurement.","paragraph_zero_based":39241},{"literal_text_all_w_t_and_m_t":"sl-TimeWindowSizeCR","paragraph_zero_based":39242},{"literal_text_all_w_t_and_m_t":"Indicates the time window size for CR evaluation.","paragraph_zero_based":39243},{"literal_text_all_w_t_and_m_t":"sl-TxPercentageList","paragraph_zero_based":39244},{"literal_text_all_w_t_and_m_t":"Indicates the portion of candidate single-slot PSSCH resources over the total resources. Value p20 corresponds to 20%, and so on.","paragraph_zero_based":39245},{"literal_text_all_w_t_and_m_t":"sl-X-Overhead","paragraph_zero_based":39246},{"literal_text_all_w_t_and_m_t":"Accounts for overhead from CSI-RS, PT-RS. If the field is absent, the UE applies value n0 (see TS 38.214 [19], clause 5.1.3.2).","paragraph_zero_based":39247},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39248},{"literal_text_all_w_t_and_m_t":"SL-SyncAllowed field descriptions","paragraph_zero_based":39249},{"literal_text_all_w_t_and_m_t":"gnbEnb-Sync","paragraph_zero_based":39250},{"literal_text_all_w_t_and_m_t":"If configured, the (pre-) configured resources can be used if the UE is directly or indirectly synchronized to eNB or gNB (i.e., synchronized to a reference UE which is directly synchronized to eNB or gNB).","paragraph_zero_based":39251},{"literal_text_all_w_t_and_m_t":"gnss-Sync","paragraph_zero_based":39252},{"literal_text_all_w_t_and_m_t":"If configured, the (pre-) configured resources can be used if the UE is directly or indirectly synchronized to GNSS (i.e., synchronized to a reference UE which is directly synchronized to GNSS).","paragraph_zero_based":39253},{"literal_text_all_w_t_and_m_t":"ue-Sync","paragraph_zero_based":39254},{"literal_text_all_w_t_and_m_t":"If configured, the (pre-) configured resources can be used if the UE is synchronized to a reference UE which is not synchronized to eNB, gNB and GNSS directly or indirectly.","paragraph_zero_based":39255},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39256},{"literal_text_all_w_t_and_m_t":"SL-PSCCH-Config field descriptions","paragraph_zero_based":39257},{"literal_text_all_w_t_and_m_t":"sl-FreqResourcePSCCH","paragraph_zero_based":39258},{"literal_text_all_w_t_and_m_t":"Indicates the number of PRBs for PSCCH in a resource pool where it is not greater than the number PRBs of the subchannel.","paragraph_zero_based":39259},{"literal_text_all_w_t_and_m_t":"sl-DMRS-ScrambleID","paragraph_zero_based":39260},{"literal_text_all_w_t_and_m_t":"Indicates the initialization value for PSCCH DMRS scrambling.","paragraph_zero_based":39261},{"literal_text_all_w_t_and_m_t":"sl-NumReservedBits","paragraph_zero_based":39262},{"literal_text_all_w_t_and_m_t":"Indicates the number of reserved bits in first stage SCI.","paragraph_zero_based":39263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["749ae109517a9c8d0d84dd3d1e714992eb03c239304689b6a8c6f10bbbadf8e9","c5ccfc85e083b3f0900fa1f85471c95face688d57cc6b09d24796518042214af","529ad46db8209ab0b8e6384515640a08046c1242ba13d6ecbfd2491f6e150836","0db04a196c555c9edd302ed3d5f20d642267252b406e779a66f50b1293a6ba26","6f8ad933dc94770e47282b85d9aceebdb02f9b837f29be8d5233e9de4e83c460","85fe5a093b80b4b43ef5893d34ee5d0d1ca2c005705b0d12583fba818c4f7849","24fc546a1d5fea732f10d385a96b9b154072fb04984e490a9a47bf06c1ca9995","b2c0d747c268299c66c076a7e69f8aa0a6f4f2ec0537ce2c20448089043f971a","7f50de9f161a57b7492f3b6888e82ab42c4e385583b653facc09e0d6728063d4","b791a81594dc70406520a5a5270445925f991b0e2940109e7a86104cfc17ef58","75c6115cf52e31a8a65a6d11fbd832f275a11fbccfe7ed3999141ab4309c7569","e4a99025c5649f314cd9d0e8b2bf2ec1c3b8b975a2a175a20c68182cf059def3","4d93a7ffc76f8f15d38e4f85661b5b53e2c127175f6e3db337fdacb8dd0bb96b","8aebbf7b3e73e3cb608985707ad00a802647392195614778b05014556d6b45a9","cd8b8503c63e3684b755bfea587faa0a06b8618909f24ec686ed317add138a70","5d1e833e6f65e5948e70c2984b46f2a8ae38a63d988e244c672877d2bbb97587","1da9f2db13ac469ec64f1a690379a40d50b1cd5a5a90fd8df6ec8713fc16b9da","a71e53b58468d923a4d5eda9f8b81d6b9a4c4c3d56478ab2f430d49e435ea9e7","3c986fb614ee291da5564e95bec898468324066c4dc2e9f6e4bb16f21ef87976","10deb26d264e1603ae436923b80c8f441beb3d886af87b6397f2af0945e98842","b8515be275c1c7785e37a1fbb84da85b04d561f4c87e637f45272ab9a336a0e4","70b7a9434df31adc82d021882aba91d25b828e35dd02ad4034de98c90907f1dd","b7716d91fd17625f28ef7686b8af31808b4cc7c12dd06d55a0585929b9e8bcf9","a58a286810b6b49ec4ba844bc7a03370822d0177cb7f1a34d6ce59218bef317f"],"paragraph_range_zero_based":[39240,39263],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p39240"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-TimeResourcePSCCH","paragraph_zero_based":39264},{"literal_text_all_w_t_and_m_t":"Indicates the number of symbols of PSCCH in a resource pool.","paragraph_zero_based":39265},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39266},{"literal_text_all_w_t_and_m_t":"SL-PSSCH-Config field descriptions","paragraph_zero_based":39267},{"literal_text_all_w_t_and_m_t":"sl-BetaOffsets2ndSCI","paragraph_zero_based":39268},{"literal_text_all_w_t_and_m_t":"Indicates candidates of beta-offset values to determine the number of coded modulation symbols for second stage SCI. The value indicates the index of Table 9.3-2 of TS 38.213 [13].","paragraph_zero_based":39269},{"literal_text_all_w_t_and_m_t":"sl-PSSCH-DMRS-TimePatternList","paragraph_zero_based":39270},{"literal_text_all_w_t_and_m_t":"Indicates the set of PSSCH DMRS time domain patterns in terms of PSSCH DMRS symbols in a slot that can be used in the resource pool.","paragraph_zero_based":39271},{"literal_text_all_w_t_and_m_t":"sl-Scaling","paragraph_zero_based":39272},{"literal_text_all_w_t_and_m_t":"Indicates a scaling factor to limit the number of resource elements assigned to the second stage SCI on PSSCH. Value f0p5 corresponds to 0.5, value f0p65 corresponds to 0.65, and so on.","paragraph_zero_based":39273},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39274},{"literal_text_all_w_t_and_m_t":"SL-PSFCH-Config field descriptions","paragraph_zero_based":39275},{"literal_text_all_w_t_and_m_t":"sl-MinTimeGapPSFCH","paragraph_zero_based":39276},{"literal_text_all_w_t_and_m_t":"The minimum time gap between PSFCH and the associated PSSCH in the unit of slots.","paragraph_zero_based":39277},{"literal_text_all_w_t_and_m_t":"sl-NumMuxCS-Pair","paragraph_zero_based":39278},{"literal_text_all_w_t_and_m_t":"Indicates the number of cyclic shift pairs used for a PSFCH transmission that can be multiplexed in a PRB.","paragraph_zero_based":39279},{"literal_text_all_w_t_and_m_t":"sl-PSFCH-CandidateResourceType","paragraph_zero_based":39280},{"literal_text_all_w_t_and_m_t":"Indicates the number of PSFCH resources available for multiplexing HARQ-ACK information in a PSFCH transmission (see TS 38.213 [13], clause 16.3).","paragraph_zero_based":39281},{"literal_text_all_w_t_and_m_t":"sl-PSFCH-HopID","paragraph_zero_based":39282},{"literal_text_all_w_t_and_m_t":"Scrambling ID for sequence hopping of the PSFCH used in the resource pool.","paragraph_zero_based":39283},{"literal_text_all_w_t_and_m_t":"sl-PSFCH-Period","paragraph_zero_based":39284},{"literal_text_all_w_t_and_m_t":"Indicates the period of PSFCH resource in the unit of slots within this resource pool. If set to sl0, no resource for PSFCH, and HARQ feedback for all transmissions in the resource pool is disabled.","paragraph_zero_based":39285},{"literal_text_all_w_t_and_m_t":"sl-PSFCH-RB-Set","paragraph_zero_based":39286},{"literal_text_all_w_t_and_m_t":"Indicates the set of PRBs that are actually used for PSFCH transmission and reception. The leftmost bit of the bitmap refers to the lowest RB index in the resource pool, and so on. Value 0 in the bitmap indicates that the corresponding PRB is not used for PSFCH transmission and reception while value 1 indicates that the corresponding PRB is used for PSFCH transmission and reception (see TS 38.213 [13]).","paragraph_zero_based":39287}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["1db38a3463459d9bdad57714f0a96907003ee90569ee85a51d4f43bf789bcdf8","9b2951f18587c6ba2a05f3c5e8aa6ab9ae0de1600f5e05f9c4c8876141a5c059","67b17af07539be042fd509ae9829ae46ffa0d25f6c0f1455bcb69819f9ef6148","6e60a79d96074c187d906b51649301c07ccc944c9b48759a5434e2aaba8c7518","1ac230bd145a0c6be9a73354e4d820154297dd8dfb7abf50453a4f9df1ac3329","304dd8c210cee6843ac541d7d42d21c75797f5d049051e7c709731695dda64c6","0677c3a4df95d625f4d3705b1ce6fc1bbef05c8cf73be00d506d505d09d06649","f02346985bd616413aaa5fdc9b22c612c95d590fd163127a66bdf8302f7fb9f9","1630a902fb2b483adef2a81fa231b16ecb7b90396f3d24831c5f7a49cda2b05b","ca070200e8f7c2e634d645e1433d6a34d56109f110d0535ccd9dbc72adc50118","21038fd8e6d3ebc057436abff5f102454b79564a0a1a0224c829fee57ab4bf88","b42343b92fbc7226874b817aaeeee7e130f303f5869a448d64c2f5c419f5a43e","981d84a55a775daa375fa618a0e82c9fca23bdc3ff1d0d812241f233626d78dc","3981cb00234076dd652fba0a90918ff9935b98010d14c741d4e4ef166ecffe38","3f5eb2dd7a42c0b0c306c9a1d5745b9778d2ba5cfcd12cebb7b6f61ce42ba153","674d83b7285db47de1a6a79fe76018cd955e6b4f1537b5928ccbf95da3130af3","b092b3dc19ae76ee9ee9e830c09981021997ac929773dac978f5be7d1eba5a46","bbd11c7df3d52ed35d57e4599775b6eba8ac794dae810dac541a696f5dc878c4","528d537a021df420ec9a5d0f13c8aaa5a1b22e2d108b9ef5881a70b86f4ca4b4","528ee7ad3baa6baab2297e885bb166072da0ac77e165c577c4140276a83ef073","52dd1b50b5323d16f90afffa7ed168d915fbc24df12506d2c85f81ef0ec6b799","512d4f3c85e1fa767be0b70b66d93191bd13d5d2fe62c67d3bb9a7edd0c5bcaf","d6123959e5a3f88318e10f572c1ae354d10e9ffd9bc36d5f82f469c3a07ef15c","845f0cfef7cfc48be8793f5d12f870378357c9ae0f8b2885114b5797176a21c7"],"paragraph_range_zero_based":[39264,39287],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p39264"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39288},{"literal_text_all_w_t_and_m_t":"SL-PTRS-Config field descriptions","paragraph_zero_based":39289},{"literal_text_all_w_t_and_m_t":"sl-PTRS-FreqDensity","paragraph_zero_based":39290},{"literal_text_all_w_t_and_m_t":"Presence and frequency density of SL PT-RS  as a function of scheduled BW. If the field is not configured, the UE uses K_PT-RS = 2","paragraph_zero_based":39291},{"literal_text_all_w_t_and_m_t":"sl-PTRS-TimeDensity","paragraph_zero_based":39292},{"literal_text_all_w_t_and_m_t":"Presence and time density of SL PT-RS  as a function of MCS. If the field is not configured, the UE uses L_PT-RS = 1","paragraph_zero_based":39293},{"literal_text_all_w_t_and_m_t":"sl-PTRS-RE-Offset","paragraph_zero_based":39294},{"literal_text_all_w_t_and_m_t":"Indicates the subcarrier offset for SL PT-RS . If the field is not configured, the UE applies the value offset00 (see TS 38.211 [16], clause 8.4.1.2.2).","paragraph_zero_based":39295},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39296},{"literal_text_all_w_t_and_m_t":"SL-UE-SelectedConfigRP field descriptions","paragraph_zero_based":39297},{"literal_text_all_w_t_and_m_t":"sl-CBR-PriorityTxConfigList","paragraph_zero_based":39298},{"literal_text_all_w_t_and_m_t":"Indicates the mapping between PSSCH transmission parameter (such as MCS, PRB number, retransmission number, CR limit) sets by using the indexes of the configurations in sl-CBR-PSSCH-TxConfigList, CBR ranges by using the indexes to the entry of the CBR range configurations in sl-CBR-RangeConfigList, and priority ranges. It also indicates the default PSSCH transmission parameters to be used when CBR measurement results are not available, and MCS range for the MCS tables used in the resource pool. The field sl-CBR-PriorityTxConfigList-v1650 is present only when sl-CBR-PriorityTxConfigList-r16 is configured.","paragraph_zero_based":39299},{"literal_text_all_w_t_and_m_t":"sl-MaxNumPerReserve","paragraph_zero_based":39300},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of reserved PSCCH/PSSCH resources that can be indicated by an SCI.","paragraph_zero_based":39301},{"literal_text_all_w_t_and_m_t":"sl-MultiReserveResource","paragraph_zero_based":39302},{"literal_text_all_w_t_and_m_t":"Indicates if it is allowed to reserve a sidelink resource for an initial transmission of a TB by an SCI associated with a different TB, based on sensing and resource selection procedure.","paragraph_zero_based":39303},{"literal_text_all_w_t_and_m_t":"sl-ResourceReservePeriodList","paragraph_zero_based":39304},{"literal_text_all_w_t_and_m_t":"Set of possible resource reservation period allowed in the resource pool in the unit of ms. Up to 16 values can be configured per resource pool. The value ms0 is always configured.","paragraph_zero_based":39305},{"literal_text_all_w_t_and_m_t":"sl-RS-ForSensing","paragraph_zero_based":39306},{"literal_text_all_w_t_and_m_t":"Indicates whether DMRS of PSCCH or PSSCH is used for L1 RSRP measurement in the sensing operation.","paragraph_zero_based":39307},{"literal_text_all_w_t_and_m_t":"sl-SensingWindow","paragraph_zero_based":39308},{"literal_text_all_w_t_and_m_t":"Parameter that indicates the start of the sensing window.","paragraph_zero_based":39309},{"literal_text_all_w_t_and_m_t":"sl-SelectionWindowList","paragraph_zero_based":39310},{"literal_text_all_w_t_and_m_t":"Parameter that determines the end of the selection window in the resource selection for a TB with respect to priority indicated in SCI. Value n1 corresponds to 1*2µ, value n5 corresponds to 5*2µ, and so on, where µ = 0,1,2,3 refers to SCS 15,30,60,120 kHz respectively.","paragraph_zero_based":39311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["8fe4db51c8a513705f06d4692d6e283c0d9680698048965b20b98ccea2fcad14","a0dc8c4643d46dce1e15f6bbdc7236e91a3a9ccbfa4dc5c711f9381a6c027ed2","75f5f3ba07a29442165553f61c99ae1f434d77249065ce7964b0e143d74026b2","585df10a96487acf7c979c0daabb36c0816b154cbca83d57a8657eef53f76fe4","a874a19749a4ab09101633c492d2cf1d65ae4f0b567b9fd4d5005bada1fccc50","04646020c1914ceedf6fa9debcb83c9ed402d75154380f0f1912f65e7873a393","b8b6764e73b7c1fee219b3456c139a64666c3aa10013923bceaef0e38ab9c611","92fabe3cb8e6c117c8c4009a80ba8835b8d9095b6aca550eba64085c26ae7bdb","b15dc0c4f353c5ea8dba70a5bc582c0667d595b7c2c35cedc8a2c4adbc8efa31","b22dec0642ac29f946c338b513efc257bb25dc153e5c3f4641a79306009f4e48","c23a244e1af3f2eb12735420c14dc43b60d32b01cd1975dfab419cb053b2bbed","024fd62bb9408e341307f8f5bc2f7c5bfdb6b5b5ac53652750344502bf68c2d4","8bf7cb8f3b3f34f31d17b2fc3ef71cab3943bfb2d80acb253952cb2d1c43ea8a","83bc8f951f237920b10457e24d67625e49e16d7c5d13653811d65c7ba6224593","c6ff6039a857ba7f9ef28f266b02659a4846d829ca8a4431955e046e10c8f21f","1d58de2eb11fb1d8003e66f990ad4682dc58626aed7772262e1d59fab0154ad4","559feeba2106d341164c6f56928833ae5e45d2b3406a18e0edf1b018f0ef20e0","069aff0adec589a8f6cdadcf959ae6083d487ea43f417105ac206e0b0d17f681","9348f44df472508a289279ac5cb343bb570efc348af25f3a8ed7dc6096f4083b","cb209e134735b50fde14b795ce21c4fd1363efef17b3ca6202abee7a241d84ff","9721cb80ddcdb51cd9f5b6ee9a020b07322a5ba30b92bd48831a047d4cb2a7f2","583d3c7d0c48504d587792fbaae875793f024adbee9b30b475e8a261c6727b1d","423302ed49cdac93a03d986977fe96c56bd601a6f07bdc27b6aebcd35b78ef08","cc44609e6a4166af08744024c6dc2245caea1788fd563eaa2e721cb9a75ac001"],"paragraph_range_zero_based":[39288,39311],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p39288"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-Thres-RSRP-List","paragraph_zero_based":39312},{"literal_text_all_w_t_and_m_t":"Indicates a list of 64 thresholds, and the threshold should be selected based on the priority in the decoded SCI and the priority in the SCI to be transmitted. A resource is excluded if it is indicated or reserved by a decoded SCI and PSSCH/PSCCH RSRP in the associated data resource is above a threshold.","paragraph_zero_based":39313},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39314},{"literal_text_all_w_t_and_m_t":"SL-PowerControl field descriptions","paragraph_zero_based":39315},{"literal_text_all_w_t_and_m_t":"sl-MaxTransPower","paragraph_zero_based":39316},{"literal_text_all_w_t_and_m_t":"Indicates the maximum value of the UE's sidelink transmission power on this resource pool when the sidelink transmission is performed only on this resource pool. The unit is dBm. If the sidelink transmission is PSFCH, and multiple resource pools are used, the maximum transmission power for PSFCH is configured as sum of fields sl-maxTransPower over multiple resource pools, as specified in TS 38.101-1 [15].","paragraph_zero_based":39317},{"literal_text_all_w_t_and_m_t":"sl-Alpha-PSSCH-PSCCH","paragraph_zero_based":39318},{"literal_text_all_w_t_and_m_t":"Indicates alpha value for sidelink pathloss based power control for PSCCH/PSSCH when sl-P0-PSSCH-PSCCH is configured. When the field is absent the UE applies the value 1. ","paragraph_zero_based":39319},{"literal_text_all_w_t_and_m_t":"sl-P0-PSSCH-PSCCH","paragraph_zero_based":39320},{"literal_text_all_w_t_and_m_t":"Indicates P0 value for sidelink pathloss based power control for PSCCH/PSSCH. If not configured, sidelink pathloss based power control is disabled for PSCCH/PSSCH. When sl-P0-PSSCH-PSCCH-r17 is configured, the UE ignores sl-P0-PSSCH-PSCCH-r16.","paragraph_zero_based":39321},{"literal_text_all_w_t_and_m_t":"dl-Alpha-PSSCH-PSCCH","paragraph_zero_based":39322},{"literal_text_all_w_t_and_m_t":"Indicates alpha value for downlink pathloss based power control for PSCCH/PSSCH when dl-P0-PSSCH-PSCCH is configured. When the field is absent the UE applies the value 1. ","paragraph_zero_based":39323},{"literal_text_all_w_t_and_m_t":"dl-P0-PSSCH-PSCCH","paragraph_zero_based":39324},{"literal_text_all_w_t_and_m_t":"Indicates P0 value for downlink pathloss based power control for PSCCH/PSSCH. If not configured, downlink pathloss based power control is disabled for PSCCH/PSSCH. When dl-P0-PSSCH-PSCCH-r17 is configured, the UE ignores dl-P0-PSSCH-PSCCH-r16.","paragraph_zero_based":39325},{"literal_text_all_w_t_and_m_t":"A Remote UE which is out of coverage, considers downlink pathloss based power control is disabled for PSCCH/PSSCH when dl-P0-PSSCH-PSCCH is configured.","paragraph_zero_based":39326},{"literal_text_all_w_t_and_m_t":"dl-Alpha-PSFCH","paragraph_zero_based":39327},{"literal_text_all_w_t_and_m_t":"Indicates alpha value for downlink pathloss based power control for PSFCH when dl-P0-PSFCH is configured. When the field is absent the UE applies the value 1. For resource pools configured with PSFCH resources overlapping in time, this field is either not configured in any of the resource pools or configured with the same value for all the resource pools.","paragraph_zero_based":39328},{"literal_text_all_w_t_and_m_t":"dl-P0-PSFCH","paragraph_zero_based":39329},{"literal_text_all_w_t_and_m_t":"Indicates P0 value for downlink pathloss based power control for PSFCH. If not configured, downlink pathloss based power control is disabled for PSFCH. When dl-P0-PSFCH-r17 is configured, the UE ignores dl-P0-PSFCH-r16. For resource pools configured with PSFCH resources overlapping in time, this field is either not configured in any of the resource pools or configured with the same value for all the resource pools.","paragraph_zero_based":39330},{"literal_text_all_w_t_and_m_t":"A Remote UE which is out of coverage, considers downlink pathloss based power control is disabled for PSFCH when dl-P0-PSFCH is configured.","paragraph_zero_based":39331},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39332},{"literal_text_all_w_t_and_m_t":"SL-MinMaxMCS-Config field descriptions","paragraph_zero_based":39333},{"literal_text_all_w_t_and_m_t":"sl-MaxMCS-PSSCH","paragraph_zero_based":39334},{"literal_text_all_w_t_and_m_t":"Indicates the maximum MCS value when using the associated MCS table. If no MCS is configured, UE autonomously selects MCS from the full range of values.","paragraph_zero_based":39335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["361cbcc0fc977a713999c8791a01e121303fea0a69230d925e4cc4d531fb3b15","d55f2bba06fca5377aaca484ec8cb9ca3f3feb5061f376f8a070b38b2cb33456","ba2911ff6bf7215b7345b4d3b545417c225a6f9373937e95cddc014b9e8ede64","5a906dc614ad3a004f33d785b6984c4465cfd23ee63a0aa4a1dd02a11f3d4082","1c91870108b3a3e78dbfdc7b58b317250f61c7aa7bb5a660af260162cfd89e58","77894828be4bb00cbfd847bdb8f1283ada3128d4b446a0a4026c03669b090467","8b984217a5ea2eef3eb36c2464f74d39a3732304df49bf860f9390961cd43841","6820438fd5ededc0f18978cfb7cfeee8abedb2175e3d005643019f8a9a7181c6","44171c27716b25114220952893710ec1c6917fe5ef99ceff5f8c77b07fbeddd8","8f407130c1464e693f5ca49e8d1ad054a90ac19e9a9ba240eed4d6ef05108d9a","8080d2a4c4407522c839378f44b601d2ac4b3a051b6195df1fd7b01e02a715a1","07d3fe30c6f2ae86574621408170a97c11e9ea2987e3f6d8208227d4b9606c52","ae3e960c152388c0757e8b933f180452e58ee7cf59417abe6bcb48b229d0c796","3e6ffa230b3d384dc3d5f794b460b8dae18651d494743232d47e58458f59a99b","6e440162476e2e628353568edeb84ed904e750a0f474fb848d49b51de8ee0b93","cdb6cdd843817173fc233339ca5d9ff698470dd2ab9838ee44ad5752cc89d83b","4d7483d2c6f8ef17c7eca8f9a4d28eb054107f2756664fc773fd58c16a12fba9","86819345f6663961929d50dabbfc5ee5df9f4480c2f56dea939b3e9936ced13c","dd30dded137d8235dcd931751215594be565ff115b55866179811e219bd90e5d","b5dac8243e9f88acfd1dc9b0f11047c21f7352ddd6e91dcf631e82e0985d7c69","61418dd54fcc334d932e5bfa66655f62eec47466dfd5297ce69bcdc160d49008","d960c533eccc08c5cfb310c1c1032d4d58a0406bf131ffb8c6823fc822d6ed31","30b83b12393cffc6d90cd051bd81ee0827029573025affe38d1bcdbf0b900a76","d554c516b4f5b52129246fbc4046b6ada230bf8e15b551bf852e39f0d01da716"],"paragraph_range_zero_based":[39312,39335],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p39312"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-MinMCS-PSSCH","paragraph_zero_based":39336},{"literal_text_all_w_t_and_m_t":"Indicates the minimum MCS value when using the associated MCS table. If no MCS is configured, UE autonomously selects MCS from the full range of values.","paragraph_zero_based":39337},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39338},{"literal_text_all_w_t_and_m_t":"–SL-RLC-BearerConfig","paragraph_zero_based":39339},{"literal_text_all_w_t_and_m_t":"The IE SL-RLC-BearerConfig specifies the SL RLC bearer configuration information for NR sidelink communication.","paragraph_zero_based":39340},{"literal_text_all_w_t_and_m_t":"SL-RLC-BearerConfig information element","paragraph_zero_based":39341},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39342},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RLC-BEARERCONFIG-START","paragraph_zero_based":39343},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39344},{"literal_text_all_w_t_and_m_t":"SL-RLC-BearerConfig-r16 ::=                   SEQUENCE {","paragraph_zero_based":39345},{"literal_text_all_w_t_and_m_t":"    sl-RLC-BearerConfigIndex-r16                  SL-RLC-BearerConfigIndex-r16,","paragraph_zero_based":39346},{"literal_text_all_w_t_and_m_t":"    sl-ServedRadioBearer-r16                      SLRB-Uu-ConfigIndex-r16                          OPTIONAL,   -- Cond LCH-SetupOnly","paragraph_zero_based":39347},{"literal_text_all_w_t_and_m_t":"    sl-RLC-Config-r16                             SL-RLC-Config-r16                                OPTIONAL,   -- Cond LCH-Setup","paragraph_zero_based":39348},{"literal_text_all_w_t_and_m_t":"    sl-MAC-LogicalChannelConfig-r16               SL-LogicalChannelConfig-r16                      OPTIONAL,   -- Cond LCH-Setup","paragraph_zero_based":39349},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":39350},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39351},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39352},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RLC-BEARERCONFIG-STOP","paragraph_zero_based":39353},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39354},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39355},{"literal_text_all_w_t_and_m_t":"SL-RLC-BearerConfig field descriptions","paragraph_zero_based":39356},{"literal_text_all_w_t_and_m_t":"sl-MAC-LogicalChannelConfig","paragraph_zero_based":39357},{"literal_text_all_w_t_and_m_t":"The field is used to configure MAC SL logical channel parameters.","paragraph_zero_based":39358},{"literal_text_all_w_t_and_m_t":"sl-RLC-BearerConfigIndex","paragraph_zero_based":39359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["45bc67cc53a234f0111508514dfbca9f683272bce9f67cb04d8987bdbacc2661","042d90bcb7289323b783734ad96e15c6e4be55b1d7d035a9ad03292308b52390","dcdecd3b8162973e26afece868e1aa6e95d2da5d575dcc2877ad9393ad616b84","e0551caae92e7418d57f83fb977b55d0ddf140aa04318d95d7732faa603e0bf6","f20296de87a25ae3c741c70ed35901aee57da79943fb9d552fca13439c5aac6e","7b8d37543e1bb84d50584bdf92c4a544b623e85b4452e53de08c6ea9bbc2af86","f677be7cfe6f4ab9e337a4cafdb30b1f029a5963a61cd9c9c1c7803606dfa8df","8643f1051d5d019209f1c222ce21ba0dc995f6a924158f283cf0d80a5afcb52a","ad0d986fde16b3428bc33bb25395226115dac880338291bb21c83afa73f9c141","10e5fe78484f6c19a5180f69e48b80096fd20ed9ac593c7a76011d7f5357ac7f","1e29897d0c0060e04698cd49f236aea0b8dc855f3675384f42c517388a97246f","d810325067b9118caf4610063e8c4754478c6227588cffed2310415149198f2b","49503c4a8c88b