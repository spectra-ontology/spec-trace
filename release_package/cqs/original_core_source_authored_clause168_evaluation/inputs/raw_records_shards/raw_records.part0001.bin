based":36061},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36062},{"literal_text_all_w_t_and_m_t":"CellGrouping-r16 ::=    SEQUENCE {","paragraph_zero_based":36063},{"literal_text_all_w_t_and_m_t":"    mcg-r16                 SEQUENCE (SIZE (1..maxBands)) OF FreqBandIndicatorNR,","paragraph_zero_based":36064},{"literal_text_all_w_t_and_m_t":"    scg-r16                 SEQUENCE (SIZE (1..maxBands)) OF FreqBandIndicatorNR,","paragraph_zero_based":36065},{"literal_text_all_w_t_and_m_t":"    mode-r16                ENUMERATED {sync, async}","paragraph_zero_based":36066},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":36067},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36068},{"literal_text_all_w_t_and_m_t":"-- TAG-UE-CAPABILITYREQUESTFILTERCOMMON-STOP","paragraph_zero_based":36069},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36070},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36071}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["d0c9ed55844b9319a7193471c622e9c0305176d34766624fa1800f9adfb03b5e","1491fa443a10457fa250045671a5b38e849682c4219662b0970c64b3ef1c3b4d","250a596ccc11e155d652b145ccf601d7f7ed4782598eed8a18a7c8640401f3c9","f54310efebf9f8c6bd16fc2e4d3cab12f234c6f82f49803d5f3a55ba3e9cb7ba","180f28f2968661b63a19dcd6ba5d9898cf0eb651d7bae27ad21f543915c212c5","d2bb82f7a765255aff48f2e7eec828dc37990efd75d93423c93dddb235cf2ae6","4b4b5c65f2b1862476241ba7dbe1d4e0339777bb6ebdafc39f878531ed43cf01","342cec8768f2ce5e15dc51eb0c039c0306d72b1ab159cb4777319669c5b294a8","b419273e7ec002f7f38f6d8b00d615d34f2082a945aa474129dc54e3bc1220ef","3c2e76912b16fc920572f45a88db168a1b09472e2fd82b4380ceeeb129759c3d","f4fb383196744d0f1c46c4604bad2e904bb9a6a8e88177ddc1c087f4e3ea0cca","ec93d637896fae9e518c8ab76236ee664aae385bf14321514dbc7f55790fef52","e27f967e58c43e94b33f1258771be99afc1df44d397efcb03ef7bd5d0d45b6de","489039fe9c93ab4eaefb7ea4f6f623d083fddc8ddd4b33557b1b287066f59d46","1109649a8683f81ca9259183adfa826d14506d560bf713d7956bc263b47d4f45","122ec9c6ea50480ba66268d1a515088e3372ce0c1be5a1b2970a8e662afe72de","fa03f12bc22e37353673b63241052befab6e272d28a429057458d5d78b9c4219","62da889016d46663c084a0f836fa4fc8a3e889f3c9a8a8c6af4d17a5785019dc","ce2bcba14f13c7fc30462d54e5b6492e95058a7b88408c9d97c52923673b2708","2320f4b3f5bc6c22c3e91a6632579c3a438cf497c2efa9992c60287b0533aef8","1f386da855e7e6466b3d45921d7151a6ae726e81ec072217cc3310884962d283","be529054061ed032f33d116f1f8724ffb6aab7823c9320e043156bebb2206c9a","35866f805309c3ec1a44e2655efa75b3781d4a501a34aaf72c743f1db59eac83","78b0565ee3ad267b5f945995388de501cd5706d3551cf00a35e8d7e0cb8c94bc"],"paragraph_range_zero_based":[36048,36071],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p36048"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"UE-CapabilityRequestFilterCommon field descriptions","paragraph_zero_based":36072},{"literal_text_all_w_t_and_m_t":"codebookTypeRequest","paragraph_zero_based":36073},{"literal_text_all_w_t_and_m_t":"Only if this field is present, the UE includes SupportedCSI-RS-Resource supported for the codebook type(s) requested within this field (i.e. type I single/multi-panel, type II and type II port selection) into codebookVariantsList, codebookParametersPerBand and codebookParametersPerBC. If this field is present and none of the codebook types is requested within this field (i.e. empty field), the UE includes SupportedCSI-RS-Resource supported for all codebook types into codebookVariantsList, codebookParametersPerBand and codebookParametersPerBC.","paragraph_zero_based":36074},{"literal_text_all_w_t_and_m_t":"fallbackGroupFiveRequest","paragraph_zero_based":36075},{"literal_text_all_w_t_and_m_t":"Only if this field is present, the UE supporting FR2 CA bandwidth class from fallback group 5 shall include band combinations with FR2 CA bandwidth class from fallback group 5, and shall omit band combinations with FR2 CA bandwidth class from fallback group 2 or 3 (see TS 38.101-2 [39]) with same or lower capabilities.","paragraph_zero_based":36076},{"literal_text_all_w_t_and_m_t":"includeNE-DC","paragraph_zero_based":36077},{"literal_text_all_w_t_and_m_t":"Only if this field is present, the UE supporting NE-DC shall indicate support for NE-DC in band combinations and include feature set combinations which are applicable to NE-DC. Band combinations supporting both NE-DC and (NG)EN-DC shall be included in supportedBandCombinationList, band combinations supporting only NE-DC shall be included in supportedBandCombinationListNEDC-Only.","paragraph_zero_based":36078},{"literal_text_all_w_t_and_m_t":"includeNR-DC","paragraph_zero_based":36079},{"literal_text_all_w_t_and_m_t":"Only if this field is present, the UE supporting NR-DC shall indicate support for NR-DC in band combinations and include feature set combinations which are applicable to NR-DC.","paragraph_zero_based":36080},{"literal_text_all_w_t_and_m_t":"mode","paragraph_zero_based":36081},{"literal_text_all_w_t_and_m_t":"The mode of NR-DC operation that the NW is interested in for this cell grouping. The value sync means that the UE only indicates NR-DC support for band combinations for which it supports synchronous NR-DC with the requested cell grouping. The value async means that the UE only indicates NR-DC support for band combinations for which it supports asynchronous NR-DC with the requested cell grouping.","paragraph_zero_based":36082},{"literal_text_all_w_t_and_m_t":"omitEN-DC","paragraph_zero_based":36083},{"literal_text_all_w_t_and_m_t":"Only if this field is present, the UE shall omit band combinations and feature set combinations which are only applicable to (NG)EN-DC.","paragraph_zero_based":36084},{"literal_text_all_w_t_and_m_t":"requestedCellGrouping","paragraph_zero_based":36085},{"literal_text_all_w_t_and_m_t":"The NR-DC cell groupings that the NW is interested in, i.e., the bands that it might use in an MCG and the bands that it might use in an SCG. Only if this field is present, the UE indicates NR-DC support for band combinations for which it supports the requested cell grouping, i.e., in which it supports at least one of the mcg bands on MCG and at least one of the scg bands on the SCG. In its supportedBandCombinationList, the UE indicates which of its NR-DC band combinations supports which of the requested cell groupings. The first element in this list is referred to by ID#0, the second by ID#1 and so on. If this field is absent, the UE only includes band combinations for which it supports NR-DC with only FR1 bands in MCG and only FR2 bands in SCG.","paragraph_zero_based":36086},{"literal_text_all_w_t_and_m_t":"Example 1: requestedCellGrouping is set to mcg=[n1, n7, n41, n66] and scg=[n78, n261]. This assumes that the NW would always use CA among n1, n7, n41 and n66 (depending on which are deployed on a given site) whereas with n78 and/or n261 the NW may need to use DC. With this filter a UE may report a band combination n1A-n7A-n78A for NR-DC only if it supports that serving cells for n1 and n7 are in the MCG and a serving cell for n78 is in the SCG. The UE may also report a band combination n41C-n261M for NR-DC provided that it supports a serving cell for n41 in the MCG and a serving cell for n261 in the SCG.","paragraph_zero_based":36087},{"literal_text_all_w_t_and_m_t":"Example 2: One requestedCellGrouping is set to mcg=[n1, n7, n41, n66] and scg=[n78, n261] and another requestedCellGrouping is set to mcg=[n1, n7, n66] and scg=[ n41, n78, n261]. This assumes that the NW uses sometimes CA among n1, n7, n41 and n66 (as in example 1) and sometimes CA among n1, n7 and n66 but DC towards one or several of n41, n78, n261. If a UE supports n1A-n41A-n78A only if n41A and n78A are in the same cell group, this UE may only indicate cell grouping ID#1 (not #0) in its BC.","paragraph_zero_based":36088},{"literal_text_all_w_t_and_m_t":"uplinkTxSwitchRequest","paragraph_zero_based":36089},{"literal_text_all_w_t_and_m_t":"Only if this field is present, the UE supporting dynamic UL Tx switching shall indicate support for UL Tx switching in band combinations which are applicable to inter-band UL CA, SUL and (NG)EN-DC.","paragraph_zero_based":36090},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36091},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":36092},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":36093},{"literal_text_all_w_t_and_m_t":"NRDC","paragraph_zero_based":36094},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need N, if includeNR-DC is included. It is absent otherwise.","paragraph_zero_based":36095}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["27feba43fab635bac38d6e8b6cc3c6aeef1fbcfb400d367d218e4ebf288cf31c","b58f7bd4251df7bbe8bf57aff366fb387987028ba78118d755526ad42cbcaf36","8ac80e70f68d27b65d14fe091018c53c72d65dc0e695e81c1caab722b8fed290","5f533fc213718bf5aa5cdc856ae4ca5ba8e3b93613a276edfe539f541c385fcc","3b2da348519bf691d32fc72b1f7f309548b90d1f42dec3dcc4896268f6da27e4","94231fb593dbebfc4cbe5f14db062b2c4701a166d1213b0abc79fd933e47b826","3bff50bc6ed9514c2c50f15f5baf8c8478d03875f6e3439f60cd74aa3cb77322","01c06484908a80c5b0452ffe68e48f0e552a6188977c886a398f9d069e59a128","f0d14f7af68c80ccc35c68c64ba22f109994ad39f021cde8e6e69f316de38e50","877134f2b464888dc3d3ee8123ce37bb0d6b3e69f503138d5490cefea7af8764","f51d9a483986961dc8d9ac2fb3ee26175763e3a22e660aa4a9bd91367c28bbf1","13d8a7debacce9bd51d1575c6214486382661849211e9e3952edf752469245b4","13c363346a39b8d6efd04d84672620ab4bb5f885a45ff83395af0c2db7dbb098","92022baf8f1048b232d639019b3a3b62286bac3b3332c949ff0596859279bceb","f3722c8c7261523ffd5980b84e23d01684515f38970448598eaf3b33332f5c2a","1e9ea7ba99e7322fcf5c61f59c132bc850076c31ff15b7561ea2457ae604dca4","57886913d7dbdb1d7e3f9ddaac4afeb02cc994ea6b12a0c61f89fcd64ece58f9","cd1721f6b78f6c5508383f637712407a965a2a3b0f71dd636720b47fb4220151","6f7819123f7f5917a58b7fd2823d0204d122aa535dd94d4fd433449842a4d7ff","c3169266da2271131b91d52c547abc16a514d007a09892ba0e2912e31d917d5e","d1e04763b71b78a790705debd06e85c7eec4a3d3b2df9c2813abb4d69ac40115","50806efb99e586cca8dc83e9bb3318483d9864c6a289be2a599c526a34ef6733","71560c52eb3c51e2d2e8bbc73863006c13f7cd5f33e3af98aee7dc01d5c801a7","3f4d3558a91ed38ffc87020b00e366f6ba5e8aa4a6e33fb2c0c8270934056f0