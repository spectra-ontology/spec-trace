794cf50a95a","f14873e394d54a37e791e2f9553331571396521a9cb49eda5aaecd3d06650121","39b99315c3fecea5509f63ff94fbda41e38c9eb46d12746290909826b89c45d6","86fc14997854ba6e51a0a11666f3aad0e25b32fc5fcd71b7acc8584305082b4f","72745c1b7eb584459c0b94cffe837bf31b3367c79c004a4acd9844147134df40","a1c064ccaec30e5a0cef9a04e19e8e27b61a2351565623bf68de31d71cf82881","9350d5e6689eda3b69863e56987ada020d8927dac5149ab0e90fa62b933dddf3","087dead5bc0153313c048c3e3a66c78dac070a5a217d77b65b4142176ef822da","acd26126dfe9941da4ce3fe84441f842c794b499ad090497545c54c2f6b135b9","5209de8edf6dc09e2293b9e4a941330c021abf8636d01efe67ef1a49dc29d071","1b8873ca773bc6de75dde367c2051e8453416a41e28e11c3b1245616b03cddae","c5e91bba45c0ad4a699e4519aa78d0fb5bb16f5ab48e699d1fef46600220fd0e","ccf59f642f9b699441cdbccf5f6c47614aca84af247d2d3cedce901f2c2708de","8bfbf335881f5a7b18f574bd262d8b8792e5739a559715970ec8711424b89894","65e01703d83e15272e36bd433db247c3afa10f9372250988a5a3e4a2014a1981","e7c42c2ad36203248736272319c6c748fb1308e53f566f45c03593a113948105"],"paragraph_range_zero_based":[24408,24431],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p24408"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24432},{"literal_text_all_w_t_and_m_t":"P0-PUSCH-AlphaSet field descriptions","paragraph_zero_based":24433},{"literal_text_all_w_t_and_m_t":"alpha","paragraph_zero_based":24434},{"literal_text_all_w_t_and_m_t":"alpha value for PUSCH with grant (except msg3) (see TS 38.213 [13], clause 7.1). When the field is absent the UE applies the value 1.","paragraph_zero_based":24435},{"literal_text_all_w_t_and_m_t":"p0","paragraph_zero_based":24436},{"literal_text_all_w_t_and_m_t":"P0 value for PUSCH with grant (except msg3) in steps of 1dB (see TS 38.213 [13], clause 7.1). When the field is absent the UE applies the value 0.","paragraph_zero_based":24437},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24438},{"literal_text_all_w_t_and_m_t":"P0-PUSCH-Set field descriptions","paragraph_zero_based":24439},{"literal_text_all_w_t_and_m_t":"p0-List","paragraph_zero_based":24440},{"literal_text_all_w_t_and_m_t":"Configuration of {p0-PUSCH, p0-PUSCH} sets for PUSCH. If SRI is present in the DCI, then one p0-PUSCH can be configured in P0-PUSCH-Set. If SRI is not present in the DCI, and both olpc-ParameterSetDCI-0-1 and olpc-ParameterSetDCI-0-2 are configured to be 1 bit, then one p0-PUSCH can be configured in P0-PUSCH-Set. If SRI is not present in the DCI, and if any of olpc-ParameterSetDCI-0-1 and olpc-ParameterSetDCI-0-2 is configured to be 2 bits, then two p0-PUSCH values can be configured in P0-PUSCH-Set (see TS 38.213 [13] clause 7 and TS 38.212 [17] clause 7.3.1).","paragraph_zero_based":24441},{"literal_text_all_w_t_and_m_t":"p0-PUSCH-SetId","paragraph_zero_based":24442},{"literal_text_all_w_t_and_m_t":"Configure the index of a p0-PUSCH-Set (see TS 38.213 [13] clause 7 and TS 38.212 [17] clause 7.3.1).","paragraph_zero_based":24443},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24444},{"literal_text_all_w_t_and_m_t":"PUSCH-PowerControl field descriptions","paragraph_zero_based":24445},{"literal_text_all_w_t_and_m_t":"deltaMCS","paragraph_zero_based":24446},{"literal_text_all_w_t_and_m_t":"Indicates whether to apply delta MCS. When the field is absent, the UE applies Ks = 0 in delta_TFC formula for PUSCH (see TS 38.213 [13], clause 7.1).","paragraph_zero_based":24447},{"literal_text_all_w_t_and_m_t":"dummy","paragraph_zero_based":24448},{"literal_text_all_w_t_and_m_t":"This field is not used in the specification. If received it shall be ignored by the UE.","paragraph_zero_based":24449},{"literal_text_all_w_t_and_m_t":"msg3-Alpha","paragraph_zero_based":24450},{"literal_text_all_w_t_and_m_t":"Dedicated alpha value for msg3 PUSCH (see TS 38.213 [13], clause 7.1). When the field is absent the UE applies the value 1.","paragraph_zero_based":24451},{"literal_text_all_w_t_and_m_t":"olpc-ParameterSetDCI-0-1, olpc-ParameterSetDCI-0-2","paragraph_zero_based":24452},{"literal_text_all_w_t_and_m_t":"Configures the number of bits for Open-loop power control parameter set indication for DCI format 0_1/0_2 in case SRI is not configured in the DCI. 2 bits is applicable only if SRI is not present in the DCI format 0_1. The field olpc-ParameterSetDCI-0-1 applies to DCI format 0_1 and the field olpc-ParameterSetDCI-0-2 applies to DCI format 0_2 (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13], clause 11).","paragraph_zero_based":24453},{"literal_text_all_w_t_and_m_t":"p0-AlphaSets","paragraph_zero_based":24454},{"literal_text_all_w_t_and_m_t":"Configuration {p0-pusch, alpha} sets for PUSCH (except msg3 and msgA PUSCH), i.e., { {p0,alpha,index1}, {p0,alpha,index2},...} (see TS 38.213 [13], clause 7.1). When no set is configured, the UE uses the P0-nominal for msg3/msgA PUSCH, P0-UE is set to 0 and alpha is set according to either msg3-Alpha or msgA-Alpha (see TS 38.213 [13], clause 7.1).","paragraph_zero_based":24455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["2021a1b1bb164bab438c41f6c07a6ea9e0940e7ca3365b3f83bc77092d4e535a","904bc3972145f7312ebb058b5d29c9c72ec104ed46a5f4a9e5b3162dde4677e7","76ab0ddb94d66edf03882f9261ded5643fa694002eac1fae230d15951fc914b9","727355e06abc050dd84c97e6729209d8ed291ede9c0b71472cee32dea8384ecd","e384f847446e71b455453df4feef9276aea603929fe6955339fc1dab5c6d2b0e","125eea28a8f8ddab0c2de23593772219331de3c0d400ab707eda92fdb383514d","f364da9cd90ea7195a10d1406bfd71b5a30a9518f692b7cf6ad41b546fa0156c","2fa6b06ed29eb73666b553993c905e0ff6a85957f96ab1ceb68f954ad94dd197","5bddc6551b92d99333569895278b5b4293761b28ffd32905763dcdf6c9257563","5d3e3a3f71e24947ab73e5aab7ff960325df96b9dd88b136a956a042c6e8015b","7a57bfd6df688cb1b9cacaa43070e54c948b3a7ad0be30818f0e0d68b4c28aca","c369c2041f1e91ee8726489a2523ee9704880c56705751b1ab0b8314dbc59245","d7244f6aa117648d81c89812ca8b53a78b3ed0b697a828c75c6581df77c43224","3d9e777c4f60268fc62295ec0bb11e36965f92d46cdc59ae3845c329cfd94c5a","6f3c4f5a2dc09bf150f1cb5e9830b752a18cac1a3fe8c797b46060691351ad9e","661cfdce2d73029cb4fd43d86da3f4564370e1bf0e337081fba4898b1126d5e6","0d71240824f85f9281d3a653f64a99883af5621fd1423678fd237ec914dd9f60","e2ed6d5a6bcbb316ff576c2db34ae6933911a824f3bb3d2afd40a26c956f1369","e1924ae8c7e5ba656d2fa99bd399ab396cc1d71481b18efd8ad80329992b0cc5","1af9787b86a72af6d894a52ffb2c97437bd9b8661f0bc2045368571b20b87c5c","7733d1a6a4b7d15b4a9d4bc579298be2ad29f5eae54dade52240e9a6d80266b5","6f2194433384fc5f2e1bee7d196377cab96c64dddd729bb7974a0edca5c8b5d8","ff4c6bdac579ca1f8337679be7b95337c65c1eb83fa91f40f0339de99c8f2c14","fcac9f7874f445cf0d6a67e505dcc122839a8b84ea439ad018a9abee37eeb598"],"paragraph_range_zero_based":[24432,24455],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p24432"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"p0-NominalWithoutGrant","paragraph_zero_based":24456},{"literal_text_all_w_t_and_m_t":"P0 value for UL grant-free/SPS based PUSCH. Value in dBm. Only even values (step size 2) allowed (see TS 38.213 [13], clause 7.1).","paragraph_zero_based":24457},{"literal_text_all_w_t_and_m_t":"p0-PUSCH-SetList","paragraph_zero_based":24458},{"literal_text_all_w_t_and_m_t":"Configure one additional P0-PUSCH-Set per SRI. If present, the one bit or 2 bits in the DCI is used to dynamically indicate among the P0 value from the existing P0-PUSCH-AlphaSet and the P0 value(s) from the P0-PUSCH-Set (See TS 38.212 [17], clause 7.3.1 and TS 38.213 [13], clause 17).","paragraph_zero_based":24459},{"literal_text_all_w_t_and_m_t":"p0-PUSCH-SetList2","paragraph_zero_based":24460},{"literal_text_all_w_t_and_m_t":"For indicating per-TRP OLPC set in DCI format 0_1/0_2 with the legacy field, a second p0-PUSCH-SetList-r16 is used. When this field is present the p0-PUSCH-SetList corresponds to the first SRS resource set (see TS 38.213).","paragraph_zero_based":24461},{"literal_text_all_w_t_and_m_t":"pathlossReferenceRSToAddModList, pathlossReferenceRSToAddModListSizeExt","paragraph_zero_based":24462},{"literal_text_all_w_t_and_m_t":"A set of Reference Signals (e.g. a CSI-RS config or a SS block) to be used for PUSCH path loss estimation. The set consists of Reference Signals configured using pathLossReferenceRSToAddModList and Reference Signals configured using pathlossReferenceRSToAddModListSizeExt. Up to maxNrofPUSCH-PathlossReferenceRSs may be configured (see TS 38.213 [13], clause 7.1).","paragraph_zero_based":24463},{"literal_text_all_w_t_and_m_t":"pathlossReferenceRSToReleaseList, pathlossReferenceRSToReleaseListSizeExt","paragraph_zero_based":24464},{"literal_text_all_w_t_and_m_t":"Lists of reference signals for PUSCH path loss estimation to be released by the UE.","paragraph_zero_based":24465},{"literal_text_all_w_t_and_m_t":"sri-PUSCH-MappingToAddModList","paragraph_zero_based":24466},{"literal_text_all_w_t_and_m_t":"A list of SRI-PUSCH-PowerControl elements among which one is selected by the SRI field in DCI (see TS 38.213 [13], clause 7.1).","paragraph_zero_based":24467},{"literal_text_all_w_t_and_m_t":"sri-PUSCH-MappingToAddModList2","paragraph_zero_based":24468},{"literal_text_all_w_t_and_m_t":"A list of SRI-PUSCH-PowerControl elements for second SRS-resource set, among which one is selected by the SRI field in DCI (see TS 38.213 [13], clause 7.1). When this field is present the sri-PUSCH-MappingToAddModList corresponds to the first SRS resource set for PUSCH.","paragraph_zero_based":24469},{"literal_text_all_w_t_and_m_t":"tpc-Accumulation","paragraph_zero_based":24470},{"literal_text_all_w_t_and_m_t":"If enabled, UE applies TPC commands via accumulation. If not enabled, UE applies the TPC command without accumulation. If the field is absent, TPC accumulation is enabled (see TS 38.213 [13], clause 7.1).","paragraph_zero_based":24471},{"literal_text_all_w_t_and_m_t":"twoPUSCH-PC-AdjustmentStates","paragraph_zero_based":24472},{"literal_text_all_w_t_and_m_t":"Number of PUSCH power control adjustment states maintained by the UE (i.e., fc(i)). If the field is present (n2) the UE maintains two power control states (i.e., fc(i,0) and fc(i,1)). If the field is absent, it maintains one power control state (i.e., fc(i,0)) (see TS 38.213 [13], clause 7.1).","paragraph_zero_based":24473},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24474},{"literal_text_all_w_t_and_m_t":"SRI-PUSCH-PowerControl field descriptions","paragraph_zero_based":24475},{"literal_text_all_w_t_and_m_t":"sri-P0-PUSCH-AlphaSetId","paragraph_zero_based":24476},{"literal_text_all_w_t_and_m_t":"The ID of a P0-PUSCH-AlphaSet as configured in p0-AlphaSets in PUSCH-PowerControl.","paragraph_zero_based":24477},{"literal_text_all_w_t_and_m_t":"sri-PUSCH-ClosedLoopIndex","paragraph_zero_based":24478},{"literal_text_all_w_t_and_m_t":"The index of the closed power control loop associated with this SRI-PUSCH-PowerControl.","paragraph_zero_based":24479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["a15df79f5938717224951015f212fce2ca18651a9c88a5f325d64ae0c91f87db","95b273ba5e3e44c9e4ccf5e38fe0edbcf1fc324b5d7005fc04b2b07378f89736","8feb3db4a8f560e7fa87c1c1a41b3bc4849f10f8bb86714c7d42fcd3ff9307d3","9e5324145cfae964199d4143e3aecfdaa6621f4064c6e52bf4926bfdcc2e963c","9c6b76de0bb9132ba8ec215f4eac99b9104c7fe7ce7580f394e641a606025946","40b186fe1270dcf78e29ac9edb20a83e9b9b3cf0daca3a63e2625e3a4011836f","10f10df0aff4e20bc6c9ae20a3d83ea14918fc8225ec515f7c028920646f6928","2a3f43138da31c20d2ebe60ce4fb69a476a43619dfceb65e4082185b19ebcdb0","f8885caa4c985e8dad277124227f163e47b29bac88604114576ded655536e765","f1f2ad714a810707f11ec293d01b5f999f31ef1d0210c344b20ea3d9c28994a1","4e77abf7d1155096805ed1760bbc5acc891aa78c66d84777fa9db9598e246102","20ca9dc673e8030811b0b0397f80ac64ad8345390a5b3e61887259c83b579021","93ec468a057ab55aad4d627e15a857ae3ec23a32c6110c44999b0a0f22741954","338574155bcf179b361d362bcdc3d80de6d9f1e2f3657f84f522283d6ce5c57a","eaf3309b8af7f1960229681229236629ae8f542b13d5d06a8468e6b148628068","96531b7574a8fa42a837441aa368b6c1acc33d391cb9a0e63f2aa8446c7f31e4","534ae1ba4b16429a454a8928aa3f41e0cc66551c60e01c67a74d4bb74c4e742a","3d3718a78fa20fc01fc6739c78fe2f136bac9b81583df3865200dd9b00f00389","dc6a52f379434653bf4153768cc14aff12a72f3282ebabda9b4047c3dc233636","8b45638bf658335f81a1ad2e1274337287b598f5fbbe9d82ea009f9b86863fc6","3d31224d6beb02fd7cecb553587d19ab63bf52a7ba30217133cd60aabd581250","4c1013390c9f1cea388fbebe742bba5f39886cd77de3c06422bce2ace8a97a7e","3a06b2f0d509ade2a4e9b38b7a7d81483fe1411eb4d5305eb7498dd57cdaadea","209faba0cf45eb0bd679b079dc98ecd14fafef0fea5eebb065c59e428d3bd8dc"],"paragraph_range_zero_based":[24456,24479],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p24456"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sri-PUSCH-PathlossReferenceRS-Id","paragraph_zero_based":24480},{"literal_text_all_w_t_and_m_t":"The ID of PUSCH-PathlossReferenceRS as configured in the pathlossReferenceRSToAddModList in PUSCH-PowerControl.","paragraph_zero_based":24481},{"literal_text_all_w_t_and_m_t":"sri-PUSCH-PowerControlId","paragraph_zero_based":24482},{"literal_text_all_w_t_and_m_t":"The ID of this SRI-PUSCH-PowerControl configuration. It is used as the codepoint (payload) in the SRI DCI field.","paragraph_zero_based":24483},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24484},{"literal_text_all_w_t_and_m_t":"–PUSCH-ServingCellConfig","paragraph_zero_based":24485},{"literal_text_all_w_t_and_m_t":"The IE PUSCH-ServingCellConfig is used to configure UE specific PUSCH parameters that are common across the UE's BWPs of one serving cell.","paragraph_zero_based":24486},{"literal_text_all_w_t_and_m_t":"PUSCH-ServingCellConfig information element","paragraph_zero_based":24487},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":24488},{"literal_text_all_w_t_and_m_t":"-- TAG-PUSCH-SERVINGCELLCONFIG-START","paragraph_zero_based":24489},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24490},{"literal_text_all_w_t_and_m_t":"PUSCH-ServingCellConfig ::=             SEQUENCE {","paragraph_zero_based":24491},{"literal_text_all_w_t_and_m_t":"    codeBlockGroupTransmission              SetupRelease { PUSCH-CodeBlockGroupTransmission }       OPTIONAL,   -- Need M","paragraph_zero_based":24492},{"literal_text_all_w_t_and_m_t":"    rateMatching                            ENUMERATED {limitedBufferRM}                            OPTIONAL,   -- Need S","paragraph_zero_based":24493},{"literal_text_all_w_t_and_m_t":"    xOverhead                               ENUMERATED {xoh6, xoh12, xoh18}                         OPTIONAL,   -- Need S","paragraph_zero_based":24494},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":24495},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":24496},{"literal_text_all_w_t_and_m_t":"    maxMIMO-Layers                          INTEGER (1..4)                                          OPTIONAL,   -- Need M","paragraph_zero_based":24497},{"literal_text_all_w_t_and_m_t":"    processingType2Enabled                  BOOLEAN                                                 OPTIONAL    -- Need M","paragraph_zero_based":24498},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":24499},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":24500},{"literal_text_all_w_t_and_m_t":"    maxMIMO-LayersDCI-0-2-r16               SetupRelease { MaxMIMO-LayersDCI-0-2-r16}               OPTIONAL    -- Need M","paragraph_zero_based":24501},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":24502},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":24503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["d967be0517f8294b11cbf0ec9451920e214e5a1bab7aadfec4f534d448a0519d","e4bf0868731e8b0b9f94029c0e423d69323bd472369a730aa6c0c3ee6ea24fe1","105f9bd91926421c5a7268dccdea726ccbf14417696a39a59bc5bd07e88f1604","eebae71a2c868c2011b30d41f053b3c867e5d1654135158f14caf4cdf3a36019","f161422392cefb328112889aec3bf3d97850e8524ff14a1e1d359f06c6ff28e4","d4207131a8ee513e6a1491d210be60da42b27e8f05520b12f937b6e9693dc4a9","01e9d5d237d9fefe5f160dbc64ce992f3ad981d253488b364f868ab2dffadb51","2fbc55b72e26a2186f6bc11d96d19c3d991a0c636bed0e498e5513f3df1277d0","f0d00981e978aa4ef980d29c35d68f5372ab67d16