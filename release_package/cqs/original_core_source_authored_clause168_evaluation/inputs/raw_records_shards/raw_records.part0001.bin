[66].","paragraph_zero_based":39185},{"literal_text_all_w_t_and_m_t":"sl-MappingToAddModList","paragraph_zero_based":39186},{"literal_text_all_w_t_and_m_t":"Indicates the list of mappings between the bearer identity of the L2 U2N Remote UE and the egress RLC channel as specified in TS 38.351 [66] to be added or modified.","paragraph_zero_based":39187},{"literal_text_all_w_t_and_m_t":"sl-MappingToReleaseList","paragraph_zero_based":39188},{"literal_text_all_w_t_and_m_t":"Indicates the list of mappings between the bearer identity of the L2 U2N Remote UE and the egress RLC channel as specified in TS 38.351 [66] to be released.","paragraph_zero_based":39189},{"literal_text_all_w_t_and_m_t":"sl-RemoteUE-RB-Identity","paragraph_zero_based":39190},{"literal_text_all_w_t_and_m_t":"Identity of the end-to-end Uu bearer identity of the L2 U2N Remote UE. The value 3 for the field srb-identity-r17 (i.e., for configuring SRB3) is not supported in this version of the specification.","paragraph_zero_based":39191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["848ebe878c6e64479f4343991acca37a17d046decc5d5bf48783c07036658d39","5fe1428d0d26cec902534131e071ad334c1a650278ab45a06c99505934da3d1c","93c044891c2ef7dab2982b669395a30f0567a65b1ff332b4e39fb6297456c882","e68b17ad0af2c9a6c6cd5c1c7ad1568bb34ca333ba3b8acbedf619c8518fe621","0928eee9731b483b20220781e5c5c7a9f8124eaea26228e00e2e4e2567aa78ec","a239a4d793755771d9ab354f05b862e4ae64cecc672decff18aeeb29dec48ab2","a06ae138b6fd37b05df87be7ed19f2a1857166a4584e59b8148d19f275e7c80f","0f938fe5698bb862e698360dedd98744493f53b1fcbce3a822fe893dcf1f2ed0","b18a4b06140e56e229dcf9752e036a57497f93b64fd5ea9b9441c7b881b6fb1a","11ec8b9b6f7c74bff66fdf1b328176