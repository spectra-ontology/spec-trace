0},{"literal_text_all_w_t_and_m_t":"cteStatus","paragraph_zero_based":331},{"literal_text_all_w_t_and_m_t":"This field provides the Bluetooth AoA transmission status of the device. If the field is present and set to enabled, the Bluetooth AoA transmission is enabled and if the field is not present, the Bluetooth AoA transmission is disabled.","paragraph_zero_based":332},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":333},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":334},{"literal_text_all_w_t_and_m_t":"primaryAdvInterval","paragraph_zero_based":335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"038bee5e08277a518e210695a9ad796eb7669167fb359201516fcfc3784430d8","original_member_sha256":"e32d7846969fb9d73f3e6db306c1eaae26983884f0f33261ecdad12458f09ea1","paragraph_ElementTree_utf8_XML_sha256":["bc763735f71d5489caee7739ec5fa6482bc5c5b21a58741f289a20edb595bbcf","dc9879385b20b4e2411e0771d31849d3d514d44ff2cfe56eec62901ce8ca97f3","d4c12809800b5ba28b74fb54071c1348605ddb401fa52a9a57d24988a59d3e90","a5db7e4fcdc473108583fe87d4dcbf0ed34fc7238e88007f2ea4c7c52c0c3a2a","b0b453dc5461233b7ed7871fc4d903904532fd2a5ec073091dc9d231f939e78d","d61a20e5955205ad6c76841c3f530cd9b77099fcb1535e73b18a4c3e0cbcda2c","484ab8a7a8446e1924ba529c20d39e59ca2e8163c489fb292975ec3202cf82cc","5b8c0483e7bb88688f454f40544a6b21ce07f5c6cce26fb3c9a942af85043c41","0083a6e813503f9519fde5d26b451a6b66eb334b49f7df32a06541af948db815","6aab4bd2bfbab9c1cd6b59c959718c1ae9b0c92d0240b55f8ea9bf7790663700","a926cf771f81a7e5f0306effe78ae51f6ffce0a384d3c8b9ee95c3303502504e","c7e9782558dcdc4c741b190709a9193e75b01237c12cd2dfddbe0f2c6e9dce28","bb737aa0d85b9e616aa7598f2001360cb28ba89fd7e89e263d38138b7adf5831","bafbe557185f00f5e5360f50979c1632978d1204112cea36b1941f4e27bebe23","89ff3d697902ee5fd8ca61442cd8728535cef8e3738a7a322eb4d5f895d04501","2c9372db0cbd0a78af75040972350f9f29bd8dbea0989d3581aba49b145bb