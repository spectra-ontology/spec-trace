{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14328},{"literal_text_all_w_t_and_m_t":"SIB21 field descriptions","paragraph_zero_based":14329},{"literal_text_all_w_t_and_m_t":"mbs-FSAI-InterFreqList","paragraph_zero_based":14330},{"literal_text_all_w_t_and_m_t":"Contains a list of neighboring frequencies including additional bands, if any, that provide MBS services and the corresponding MBS FSAIs.","paragraph_zero_based":14331},{"literal_text_all_w_t_and_m_t":"mbs-FSAI-IntraFreq","paragraph_zero_based":14332},{"literal_text_all_w_t_and_m_t":"Contains the list of MBS FSAIs for the current frequency. For MBS service continuity, the UE shall use all MBS FSAIs listed in mbs-FSAI-IntraFreq to derive the MBS frequencies of interest.","paragraph_zero_based":14333},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14334},{"literal_text_all_w_t_and_m_t":"6.3.1aPositioning System information blocks","paragraph_zero_based":14335},{"literal_text_all_w_t_and_m_t":"–PosSystemInformation-r16-IEs","paragraph_zero_based":14336},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":14337},{"literal_text_all_w_t_and_m_t":"-- TAG-POSSYSTEMINFORMATION-R16-IES-START","paragraph_zero_based":14338},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14339},{"literal_text_all_w_t_and_m_t":"PosSystemInformation-r16-IEs ::= SEQUENCE {","paragraph_zero_based":14340},{"literal_text_all_w_t_and_m_t":"    posSIB-TypeAndInfo-r16           SEQUENCE (SIZE (1..maxSIB)) OF CHOICE {","paragraph_zero_based":14341},{"literal_text_all_w_t_and_m_t":"        posSib1-1-r16                    SIBpos-r16,","paragraph_zero_based":14342},{"literal_text_all_w_t_and_m_t":"        posSib1-2-r16                    SIBpos-r16,","paragraph_zero_based":14343},{"literal_text_all_w_t_and_m_t":"        posSib1-3-r16        