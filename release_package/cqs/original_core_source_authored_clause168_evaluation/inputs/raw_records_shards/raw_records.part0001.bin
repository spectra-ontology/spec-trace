{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Need not be included if the UE Radio Capability ID as specified in 23.502 [43] is used. Included otherwise","paragraph_zero_based":44112},{"literal_text_all_w_t_and_m_t":"NR","paragraph_zero_based":44113},{"literal_text_all_w_t_and_m_t":"NR","paragraph_zero_based":44114},{"literal_text_all_w_t_and_m_t":"Need not be included if the UE Radio Capability ID as specified in 23.502 [43] is used. Included otherwise","paragraph_zero_based":44115},{"literal_text_all_w_t_and_m_t":"Not included","paragraph_zero_based":44116},{"literal_text_all_w_t_and_m_t":"Not included","paragraph_zero_based":44117},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44118},{"literal_text_all_w_t_and_m_t":"–MeasurementTimingConfiguration","paragraph_zero_based":44119},{"literal_text_all_w_t_and_m_t":"The MeasurementTimingConfiguration message is used to convey assistance information for measurement timing.","paragraph_zero_based":44120},{"literal_text_all_w_t_and_m_t":"Direction: en-gNB to eNB, eNB to en-gNB, gNB to gNB, ng-eNB to gNB, gNB to ng-eNB, ng-eNB to ng-eNB, gNB DU to gNB CU, and gNB CU to gNB DU.","paragraph_zero_based":44121},{"literal_text_all_w_t_and_m_t":"MeasurementTimingConfiguration message","paragraph_zero_based":44122},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":44123},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASUREMENT-TIMING-CONFIGURATION-START","paragraph_zero_based":44124},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44125},{"literal_text_all_w_t_and_m_t":"MeasurementTimingConfiguration ::=      SEQUENCE {","paragraph_zero_based":44126},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                      CHOICE {","paragraph_zero_based":44127},{"literal_text_all_w_t_and_m_t":"        c1                                      CHOICE{","paragraph_zero_based":44128},{"literal_text_all_w_t_and_m_t":"            measTimingConf                          MeasurementTimingConfiguration-IEs,","paragraph_zero_based":44129},{"literal_text_all_w_t_and_m_t":"            spare3 NULL, spare2 NULL, spare1 NULL","paragraph_zero_based":44130},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":44131},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture        SEQUENCE {}","paragraph_zero_based":44132},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":44133},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44134},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44135}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["d43e26072f7b64458c1889c5fa9cda8c5b6fd5285cbc89de53652c333fda4df6","3f9be96654964bb5611729430ac91290c08bb41db57ddf65143fe19d3f81ffc3","0b45bf82e0543b12c013494191574099b48ebdf38a2d665788c7f8344144a3bb","5a1d7018eb23a87e71c034e10621724148edf73d424cc3d267929c8061b57fa5","ed6f15122bcf79a8b87bfbeaf800a4eaffa291d39f9b03ebaac948396f350045","4ca1cf87fc03421bcfba4d8f9b66f05f228e288a47f1aeb26f52f9f065bb995a","ee00c66c79cc5fbdadff26103616825c5282cd1cd41e211ceee471cfdb71a1be","8e8f0522ad6aed401363d2b915bb1f3bc7075cebf0b4c61027f41a09f47990f9","8545fccc285396ccc72e9d6d2a0075c7bd55d757f9977088988d285d6c0f7910","5863f9cb0e4444da7184e99cc6088347f334aaf49e075f211ca157615c9ac4e3","c8bcd6e0b18665e9fc0999c3562b189388d15c5730be56201ef54c9efd0d931c","af6434a097dd02a82a8c098f553eb18825eb86eec46a60f75512b8b97140f9b3","15ba8e80709e571a0ec1b6fee6498d80f25c6158e7ea5cc9577238e49a530312","28b79acc901a84975e4e0bc66685a56d2b7953d13094fd6e146399de7ff8fbbc","219f82e79ae987