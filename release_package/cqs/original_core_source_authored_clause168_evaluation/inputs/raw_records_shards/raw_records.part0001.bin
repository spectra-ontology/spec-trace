{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"allowCSI-SRS-Tx-MulticastDRX-Active","paragraph_zero_based":19296},{"literal_text_all_w_t_and_m_t":"Used to control the CSI/SRS transmission during MBS multicast DRX ActiveTime, see TS 38.321 [3].","paragraph_zero_based":19297},{"literal_text_all_w_t_and_m_t":"csi-Mask","paragraph_zero_based":19298},{"literal_text_all_w_t_and_m_t":"If set to true, the UE limits CSI reports to the on-duration period of the DRX cycle, see TS 38.321 [3].","paragraph_zero_based":19299},{"literal_text_all_w_t_and_m_t":"dataInactivityTimer","paragraph_zero_based":19300},{"literal_text_all_w_t_and_m_t":"Releases the RRC connection upon data inactivity as specified in clause 5.3.8.5 and in TS 38.321 [3]. Value s1 corresponds to 1 second, value s2 corresponds to 2 seconds, and so on.","paragraph_zero_based":19301},{"literal_text_all_w_t_and_m_t":"drx-Config, drx-ConfigExt","paragraph_zero_based":19302},{"literal_text_all_w_t_and_m_t":"Used to configure DRX as specified in TS 38.321 [3]. Network only configures drx-ConfigExt when drx-Config is configured.","paragraph_zero_based":19303},{"literal_text_all_w_t_and_m_t":"drx-ConfigSecondaryGroup","paragraph_zero_based":19304},{"literal_text_all_w_t_and_m_t":"Used to configure DRX related parameters for the second DRX group as specified in TS 38.321 [3]. The network does not configure secondary DRX group with DCP simultaneously nor secondary DRX group with a dormant BWP simultaneously.","paragraph_zero_based":19305},{"literal_text_all_w_t_and_m_t":"drx-ConfigSL","paragraph_zero_based":19306},{"literal_text_all_w_t_and_m_t":"Used to configure additional DRX parameters for the UE performing sidelink operation with resource allocation mode 1, as specified in TS 38.321 [3]. Network only configures this field if sl-ScheduledConfig is configured and drx-Config is configured.","paragraph_zero_based":19307},{"literal_text_all_w_t_and_m_t":"drx-LastTransmissionUL","paragraph_zero_based":19308},{"literal_text_all_w_t_and_m_t":"If this field is present, the start of the drx-HARQ-RTT-TimerUL is after the last transmission within a bundle, see TS 38.321 [3].","paragraph_zero_based":19309},{"literal_text_all_w_t_and_m_t":"g-RNTI-ConfigToAddModList","paragraph_zero_based":19310},{"literal_text_all_w_t_and_m_t":"List of G-RNTI configurations to add or modify. Up to 8 G-RNTIs can be configured in total in this release based on the UE capability.","paragraph_zero_based":19311},{"literal_text_all_w_t_and_m_t":"g-RNTI-ConfigToReleaseList","paragraph_zero_based":19312},{"literal_text_all_w_t_and_m_t":"List of G-RNTI configurations to release.","paragraph_zero_based":19313},{"literal_text_all_w_t_and_m_t":"g-CS-RNTI-ConfigToAddModList","paragraph_zero_based":19314},{"literal_text_all_w_t_and_m_t":"List of G-CS-RNTI configurations to add or modify. Up to 8 G-CS-RNTIs can be configured in total in this release based on the UE capability.","paragraph_zero_based":19315},{"literal_text_all_w_t_and_m_t":"g-CS-RNTI-ConfigToReleaseList","paragraph_zero_based":19316},{"literal_text_all_w_t_and_m_t":"List of G-CS-RNTI configurations to release.","paragraph_zero_based":19317},{"literal_text_all_w_t_and_m_t":"intraCG-Prioritization","paragraph_zero_based":19318},{"literal_text_all_w_t_and_m_t":"Used to enable HARQ process ID selection based on LCH-priority for one CG as specified in TS 38.321 [3].","paragraph_zero_based":19319}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["c259e5658ec2ad23357de90529cc2a645600c90673e34061013b9f34324dc2da","6532d708a17967caf2acd0e9e162ad3293c3a1e7d9bbc39aa88670f498cbaf45","fd2dbaa3a0681c26c68ed54c30a90a3d903d441aebdc49a8d1d1c3b047dd7508","c0fbc263708d91b41975ab867275275896025b7ccf71db4a6f257ca8c5ee83e6","e524b0836122267fcf64e1b9eb8f9c14860c0f09bfb994f8b0b50d3e3739cd10","65a47ef0216018b3c1d844ae79f903a4baf516a9c925792243281550e9c33ca6","eb87d2b0316c8ba30542be154294627557e2300b1f05c25482166ba9cc2abb84","51446ead1c63d2fc6245a8616d74f0ecf455b0af2d19828df8883f0291cf1a1a","343416b97c4fdc505ee265156153b1a40136a31c743bb28defa7e9664d379f03","4c79340c1746663fc3c32e43d877b91f926688d99c155fc23aac72fa345b1c40","a937c1b62cf278973998351f7cf867d037ff525e2428618587e15dff4ac58c57","53aa16f83fe1365cbdd41023f115dd8449e652a436644fa5d12232747fcce045","93db778ce9b356c13a5e3559b51d2c42064cdccfa116ac85d01bbd5efbf35e7e","102ac5b5ecb1370a8053da1029b2807d836354d169c7ae79315fdadf5fa887b8","d950c8e49185d2a096512843a6de9fc62d3f25fe6d7c71f538f4fbec041a04a5","c46f63a6383e0187a9a4adf5c1cea54df062a902f6b07e0adb36b3f4f388aeec","a15b4b4cfe7d3e35c563ff737c7691dcc03b4262e02b78bdcd08514516cb294c","d16645494d00739b13c1f08d98ad120ee4bca850f955c1ac6eceee83bb6a5240","1a2c2318ee54ecfbcea0d87686ce15268e1834fdb301f7a08129d47a6c7f1ea8","1ac6238e59586322d8b803f620a94ae3caedef1f1fc1ed76c3a7679e6a82e8fe","3de7f86b98c51d34d24556f8112e33d08203956577c2dd0c085cac91debce6d8","d2313a9f6da9a23ac1df2a0fc59582a08b0f9a1b37dbd45496c3f074c779f3c2","99077acc12da523351750bc7a0fe5bf1a352ffa3b2dd9b8654983fc8e1ac0ceb","c2cffc44640b14d2307811ccc6ee4cfa02e46029f2829cc841d621f2aa109eef"],"paragraph_range_zero_based":[19296,19319],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p19296"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"lch-BasedPrioritization","paragraph_zero_based":19320},{"literal_text_all_w_t_and_m_t":"If this field is present, the corresponding MAC entity of the UE is configured with prioritization between overlapping grants and between scheduling request and overlapping grants based on LCH priority, see TS 38.321 [3]. The network does not configure lch-BasedPrioritization with enhancedSkipUplinkTxDynamic simultaneously nor lch-BasedPrioritization with enhancedSkipUplinkTxConfigured simultaneously.","paragraph_zero_based":19321},{"literal_text_all_w_t_and_m_t":"posMG-Request","paragraph_zero_based":19322},{"literal_text_all_w_t_and_m_t":"Indicates whether UE is configured to send UL MAC CE for Positioning Measurement Gap Activation/Deactivation Request, as specified in TS 38.321 [3].","paragraph_zero_based":19323},{"literal_text_all_w_t_and_m_t":"schedulingRequestID-BFR-SCell","paragraph_zero_based":19324},{"literal_text_all_w_t_and_m_t":"Indicates the scheduling request configuration applicable for BFR on SCell, as specified in TS 38.321 [3].","paragraph_zero_based":19325},{"literal_text_all_w_t_and_m_t":"schedulingRequestID-BFR","paragraph_zero_based":19326},{"literal_text_all_w_t_and_m_t":"Indicates the scheduling request configuration (SchedulingRequestConfig) that the UE shall use upon detecting a beam failure on the detection resources configured in failureDetectionSet1 of a serving cell while beam failure is not detected on resources configured in failureDetectionSet2 of the same serving cell.","paragraph_zero_based":19327},{"literal_text_all_w_t_and_m_t":"schedulingRequestID-BFR2","paragraph_zero_based":19328},{"literal_text_all_w_t_and_m_t":"Indicates the scheduling request configuration (SchedulingRequestConfig) that the UE shall use upon detecting a beam failure on the detection resources configured in failureDetectionSet2 of a serving cell while beam failure is not detected on resources configured in failureDetectionSet1 of the same serving cell.","paragraph_zero_based":19329},{"literal_text_all_w_t_and_m_t":"schedulingRequestID-LBT-SCell","paragraph_zero_based":19330},{"literal_text_all_w_t_and_m_t":"Indicates the scheduling request configuration applicable for consistent uplink LBT recovery on SCell, as specified in TS 38.321 [3].","paragraph_zero_based":19331},{"literal_text_all_w_t_and_m_t":"schedulingRequestID-PosMG-Request","paragraph_zero_based":19332},{"literal_text_all_w_t_and_m_t":"Indicates the scheduling request configuration applicable for Positioning Measurement Gap Activation/Deactivation Request, as specified in TS 38.321 [3].","paragraph_zero_based":19333},{"literal_text_all_w_t_and_m_t":"skipUplinkTxDynamic, enhancedSkipUplinkTxDynamic, enhancedSkipUplinkTxConfigured","paragraph_zero_based":19334},{"literal_text_all_w_t_and_m_t":"If set to true, the UE skips UL transmissions as described in TS 38.321 [3]. If the UE is configured with enhancedSkipUplinkTxDynamic or enhancedSkipUplinkTxConfigured with value true, REPETITION_NUMBER (as specified in TS 38.321 [3], clause 5.4.2.1) of the corresponding PUSCH transmission of the uplink grant shall be equal to 1.","paragraph_zero_based":19335},{"literal_text_all_w_t_and_m_t":"tag-Config","paragraph_zero_based":19336},{"literal_text_all_w_t_and_m_t":"The field is used to configure parameters for a time-alignment group. The field is not present if any DAPS bearer is configured.","paragraph_zero_based":19337},{"literal_text_all_w_t_and_m_t":"usePreBSR","paragraph_zero_based":19338},{"literal_text_all_w_t_and_m_t":"If set to true, the MAC entity of the IAB-MT may use the Pre-emptive BSR, see TS 38.321 [3].","paragraph_zero_based":19339},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19340},{"literal_text_all_w_t_and_m_t":"MBS-RNTI-SpecificConfig field descriptions","paragraph_zero_based":19341},{"literal_text_all_w_t_and_m_t":"drx-ConfigPTM","paragraph_zero_based":19342},{"literal_text_all_w_t_and_m_t":"Used to configure DRX for PTM transmission as specified in TS 38.321 [3].","paragraph_zero_based":19343}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["cf1add0031018f8e3ea952d30c42b52e6f2f1b36356acce8dce010ec9b664e0c","e68b23c2461375e7de6ee7cf56c64838b96ad1b464f8f396025e7d870ed3d825","2d30739fdb22dafd68728c95ab82b79d4ad91a8b97b327daf3ab0d1506820c24","4366bcb3105867321212d94fda48059c0c3abb6e6d4ceeebd39bccdfbe5766a9","6158a95009c64ce434785454f10959911b059af4b1d2b8c3603ba31b5b0d0f4e","0fed9fb76775a558d1be09826118fa8c2c029e393cdf7d8515366b40fe90bba6","70676aaefcc6b354816b8e8abb324e34ec996671e9d1c71f757c2a5e411ffd69","55fbf859cee2228a11f3d524fefa1f6c1bb25ed66f7a01e1ad1384c51c4e7a62","db2e27252902180e38a53d82459a2ac78adce222b8ddaf928a76393cf1111f65","53da355ff3c90e511effb6c3bb66f5f1cb46a7df6134e950f209543065d5ce35","b2b281917886dfa50e51f90cc0c8ea46dad5f83fc971017bbb604791c187b1a4","c09357968e0e8bdb31fa86729a2b7f4de94835671a357308314edc1b928b210b","c734fe28e0a154c5afa6a0a02884c9c2cfc2134e49a784435bfabf048ffba28d","41f5d1b5147eaff32847181b2ee062c2d09703ffdc4dbc6515ccb6de0bbdac89","e1a12f9508391315570bde021d1a7fbc31e5c204cef85512f0b99134cff182b8","b1aca8b393f6a9fa6b24c65b798db4130d2a9c1b9a9bfe49a65846ee79823366","ca1ce18b22c2c7d95b366005784fb0eb2c8fa016feb9c430df9c745922cae201","c972acf18c3439b5557f3b20a9f67bb9badbb82f1451d8aee5f6415e1e4dbc00","8f269ff00d48278d83f1b44a655ee8e9e56ec5d09fbb6ec1286455db20d337fb","776fdf3b3384604da6b604fd03218adb10f7d1a3386c7321e95e346fac70c71d","d4329690203bcd4ad5d0f096ab735ff075649ad532b4e810d8f42b9d0f00e093","2522efa0730bfc6c6ff26543f59c1325b6429ca3ddeffc6f75827fdf486598d3","4654472c622f3e7606ad0a0ec51f1a5a28ee856b09b90a7bdd69d3dbdb362928","7cfdcdb14b9b574c55e566206d868daa2cc6b307a7e4a22f4a73f9c7ee304ac5"],"paragraph_range_zero_based":[19320,19343],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p19320"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"g-CS-RNTI","paragraph_zero_based":19344},{"literal_text_all_w_t_and_m_t":"Used to scramble the SPS group-common PDSCH and activation/deactivation of SPS group-common PDSCH for one or more MBS multicast services.","paragraph_zero_based":19345},{"literal_text_all_w_t_and_m_t":"g-RNTI","paragraph_zero_based":19346},{"literal_text_all_w_t_and_m_t":"Used to scramble the scheduling and transmission of PTM for one or more MBS multicast services.","paragraph_zero_based":19347},{"literal_text_all_w_t_and_m_t":"groupCommon-RNTI","paragraph_zero_based":19348},{"literal_text_all_w_t_and_m_t":"Used to configure g-RNTI or g-CS-RNTI.","paragraph_zero_based":19349},{"literal_text_all_w_t_and_m_t":"harq-FeedbackEnablerMulticast","paragraph_zero_based":19350},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE shall provide HARQ feedback for MBS multicast. Value dci-enabler means that whether the UE shall provide HARQ feedback for MBS multicast is indicated by DCI as specified in TS 38.213 [13]. Value enabled means the UE shall always provide HARQ feedback for MBS multicast. When the field is absent, the UE behavior is specified in TS 38.213 [13].","paragraph_zero_based":19351},{"literal_text_all_w_t_and_m_t":"harq-FeedbackOptionMulticast","paragraph_zero_based":19352},{"literal_text_all_w_t_and_m_t":"Indicates the feedback mode for MBS multicast dynamically scheduled PDSCH or SPS PDSCH.","paragraph_zero_based":19353},{"literal_text_all_w_t_and_m_t":"mbs-RNTI-SpecificConfigId","paragraph_zero_based":19354},{"literal_text_all_w_t_and_m_t":"An identifier of the RNTI specific configuration for MBS multicast.","paragraph_zero_based":19355},{"literal_text_all_w_t_and_m_t":"pdsch-AggregationFactor","paragraph_zero_based":19356},{"literal_text_all_w_t_and_m_t":"Number of repetitions for dynamically scheduled MBS multicast data (see TS 38.214 [19], clause 5.1.2.1). When the field is absent and groupCommon-RNTI is set to g-RNTI, the UE applies the value 1.","paragraph_zero_based":19357},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19358},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":19359},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":19360},{"literal_text_all_w_t_and_m_t":"G-RNTI","paragraph_zero_based":19361},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need S, if groupCommon-RNTI is set to g-RNTI. The field is absent when groupCommon-RNTI is set to g-CS-RNTI.","paragraph_zero_based":19362},{"literal_text_all_w_t_and_m_t":"HARQFeedback","paragraph_zero_based":19363},{"literal_text_all_w_t_and_m_t":"The field is mandatory present when harq-FeedbackEnablerMulticast is present. It is absent otherwise. ","paragraph_zero_based":19364},{"literal_text_all_w_t_and_m_t":"MCG-Only","paragraph_zero_based":19365},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need M, for the MAC-CellGroupConfig of the MCG. It is absent otherwise.","paragraph_zero_based":19366},{"literal_text_all_w_t_and_m_t":"LCH-PrioWithReTxTimer","paragraph_zero_based":19367}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["afcce3351f9ca3b07b17e495f27a7d2e68dc0df4e42e068d1c82257ddf308602","15cec6efa960096c124edd6e542fd9df400c553524102e0e37cba05a79c43735","a662b561f43a3b3eed92477cab621668eb3629dc6367459f16300a4e28a26687","4fa35b2d929a96effc5694df9c5a9194bb3d2f7642e602ae5870f2688977ca57","b6f76e4db002da32a3ad4fe409e2e8b74bf9acf901174118d7d4b6a9626289c8","fe8ac70619d7187807a10bdb165d350ce308d9831da9724b88452ef0f84e3937","51939bddc5bae5f42ae8ee2de9b01918579b25cfe1364cdeb2dcc9f5b1350843","eed738c6d713d67de9440c009118c62d92b4dfb79978e74c2a396575997d933c","f47c06a17cfa3a4e2fac17ebd9c37f2bac054afaf0d8a25b15d376a94cf389f3","70087fc4af76ca7ba68d2a7cb6bf91d3b8c233acd5a53a2ba28323f06cca4eb2","d31152c5de81d48935bf09513b9d4c1267c6739d4d61419125918f7414f945d3","8bc2effe68a1797c909c7406cac24db3415c0ae8cd88990e48ecd9062d2ce7ca","fbb3b123ac255c50fff2b49a328f84d2db480fefe466096a7233e5e4c5031918","103922ff7dd668aab7bc6acbbbd681fc127d05a6e8a151a4f0752b83ca91795d","0203bd4d7fdfb5dfb6da05d208a015d55113c970d2807adb3e0cab238f03e374","460914da0287babd167593258eae34f9b33103a99dd0d1ec950729e7e662aeba","e83dad1f471b86b74e2ec73dd588750dbf90a43b044c1193637c9996dc70500c","94d06b2225fc0785787f9530a9c4369b8454a8e810c5a7b38d69f9a41972020a","14d1bbaec29d963aeefca8961dce0af23779833c897073748792dc390fc115ea","aa59424c0d73b80f907629468199fd717ea475ce31f34449ffd2883f721b6740","6408682a062c219d5d38eb6c3927aeb0e7e691bb15a0293340643addd1dbdc30","81348077897d12cf39d15311f204b2e676985e30d4d4de5ce158f27bfc5fb369","b0c5c45dd20f5378a5aa92c9e7a8395519558dacfced573c39270b7daa286c61","763c23c89454eb4d725d9adc5f5e6397950348ae04d7be7d8e9bb76c1b35d389"],"paragraph_range_zero_based":[19344,19367],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p19344"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, if lch-BasedPrioritization-r16 is configured in this MAC entity and cg-RetransmissionTimer-r16 is configured for any configured grant configuration associated with this MAC entity. It is absent otherwise, Need R.","paragraph_zero_based":19368},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19369},{"literal_text_all_w_t_and_m_t":"–MeasConfig","paragraph_zero_based":19370},{"literal_text_all_w_t_and_m_t":"The IE MeasConfig specifies measurements to be performed by the UE, and covers intra-frequency, inter-frequency and inter-RAT mobility as well as configuration of measurement gaps.","paragraph_zero_based":19371},{"literal_text_all_w_t_and_m_t":"MeasConfig information element","paragraph_zero_based":19372},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":19373},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASCONFIG-START","paragraph_zero_based":19374},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19375},{"literal_text_all_w_t_and_m_t":"MeasConfig ::=                      SEQUENCE {","paragraph_zero_based":19376},{"literal_text_all_w_t_and_m_t":"    measObjectToRemoveList              MeasObjectToRemoveList                                              OPTIONAL,   -- Need N","paragraph_zero_based":19377},{"literal_text_all_w_t_and_m_t":"    measObjectToAddModList              MeasObjectToAddModList                                              OPTIONAL,   -- Need N","paragraph_zero_based":19378},{"literal_text_all_w_t_and_m_t":"    reportConfigToRemoveList            ReportConfigToRemoveList                                            OPTIONAL,   -- Need N","paragraph_zero_based":19379},{"literal_text_all_w_t_and_m_t":"    reportConfigToAddModList            ReportConfigToAddModList                                            OPTIONAL,   -- Need N","paragraph_zero_based":19380},{"literal_text_all_w_t_and_m_t":"    measIdToRemoveList                  MeasIdToRemoveList                                                  OPTIONAL,   -- Need N","paragraph_zero_based":19381},{"literal_text_all_w_t_and_m_t":"    measIdToAddModList                  MeasIdToAddModList                                                  OPTIONAL,   -- Need N","paragraph_zero_based":19382},{"literal_text_all_w_t_and_m_t":"    s-MeasureConfig                     CHOICE {","paragraph_zero_based":19383},{"literal_text_all_w_t_and_m_t":"        ssb-RSRP                            RSRP-Range,","paragraph_zero_based":19384},{"literal_text_all_w_t_and_m_t":"        csi-RSRP                            RSRP-Range","paragraph_zero_based":19385},{"literal_text_all_w_t_and_m_t":"    }                                                                                                       OPTIONAL,   -- Need M","paragraph_zero_based":19386},{"literal_text_all_w_t_and_m_t":"    quantityConfig                      QuantityConfig                                                      OPTIONAL,   -- Need M","paragraph_zero_based":19387},{"literal_text_all_w_t_and_m_t":"    measGapConfig                       MeasGapConfig                                                       OPTIONAL,   -- Need M","paragraph_zero_based":19388},{"literal_text_all_w_t_and_m_t":"    measGapSharingConfig                MeasGapSharingConfig                                                OPTIONAL,   -- Need M","paragraph_zero_based":19389},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":19390},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":19391}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995