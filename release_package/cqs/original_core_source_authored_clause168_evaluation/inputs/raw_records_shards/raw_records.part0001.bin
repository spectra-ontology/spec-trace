_zero_based":11655},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":11656},{"literal_text_all_w_t_and_m_t":"    sl-QoS-InfoList-r16                SEQUENCE (SIZE (1..maxNrofSL-QFIsPerDest-r16)) OF SL-QoS-Info-r16","paragraph_zero_based":11657},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":11658},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11659},{"literal_text_all_w_t_and_m_t":"SL-FailureList-r16 ::=                 SEQUENCE (SIZE (1..maxNrofSL-Dest-r16)) OF SL-Failure-r16","paragraph_zero_based":11660},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11661},{"literal_text_all_w_t_and_m_t":"SL-Failure-r16 ::=                     SEQUENCE {","paragraph_zero_based":11662},{"literal_text_all_w_t_and_m_t":"    sl-DestinationIdentity-r16             SL-DestinationIdentity-r16,","paragraph_zero_based":11663}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["822d53ff8b2e58861d40573d40f65e7ddc20e9e68b8a349477f0530f4c99890a","103251cfbabd35f5186e52f3fae7ef1de724a1ffb2571b33b89e417a760a66c5","6083ba10f2179dd509678f47d851f9ff6a8c32bdc042f401f17e068e9d1eca0c","d07bc37f7f2422ca5a7ba521e93f663d745238498058bbae4210bb487f68d7fd","e72dad9c3de421f64d3bcce595aa36bc31d161acf958b6307a1e17bd5f470ce2","52c2087f818e2614d14e0cab934768f393ddb9ba6a6d82f89071712a7687d05e","bd8a143c4b02537143a046db46a63b8b6761d3c87817c4bb72a8a4c74f400beb","cbe0327ff69c620cf5bcb2bb35652cfc16b6ee8872e0f9b570813d08ffb9ee50","04b87b842855205c224ac6f158e5daa5df98fd4818ea975564573c6233d38c7c","cca27aa37167965a0bdfdddf0d11d5f5e4d3379447d321d562ad649bab8bbfbe","7e091c7f1fbeaee16e51fffb004d0334ef172c4cc058fa71bc627aac733f894d","5e5a237fce8e5431f40a7dcd4c92a3ba044effbf9bb