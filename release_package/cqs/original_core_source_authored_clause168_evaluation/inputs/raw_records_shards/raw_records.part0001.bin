{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":3816},{"literal_text_all_w_t_and_m_t":"3>consider itself not to be configured to provide the measurement gap and NCSG requirement information of NR target bands;","paragraph_zero_based":3817},{"literal_text_all_w_t_and_m_t":"1>if the RRCResume message includes the needForGapNCSG-ConfigEUTRA:","paragraph_zero_based":3818},{"literal_text_all_w_t_and_m_t":"2>if needForGapNCSG-ConfigEUTRA is set to setup:","paragraph_zero_based":3819},{"literal_text_all_w_t_and_m_t":"3>consider itself to be configured to provide the measurement gap and NCSG requirement information of EUTRA target bands;","paragraph_zero_based":3820},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":3821},{"literal_text_all_w_t_and_m_t":"3>consider itself not to be configured to provide the measurement gap and NCSG requirement information of EUTRA target bands;","paragraph_zero_based":3822},{"literal_text_all_w_t_and_m_t":"1>if the RRCResume message includes the appLayerMeasConfig:","paragraph_zero_based":3823},{"literal_text_all_w_t_and_m_t":"2>perform the application layer measurement configuration procedure as specified in 5.3.5.13d;","paragraph_zero_based":3824},{"literal_text_all_w_t_and_m_t":"1>if the RRCResume message includes the sl-L2RemoteUE-Config (i.e. the UE is a L2 U2N Remote UE):","paragraph_zero_based":3825},{"literal_text_all_w_t_and_m_t":"2>perform the L2 U2N Remote UE configuration procedure as specified in 5.3.5.16;","paragraph_zero_based":3826},{"literal_text_all_w_t_and_m_t":"1>if the RRCResume message includes the sl-ConfigDedicatedNR:","paragraph_zero_based":3827},{"literal_text_all_w_t_and_m_t":"2>perform the sidelink dedicated configuration procedure as specified in 5.3.5.14;","paragraph_zero_based":3828},{"literal_text_all_w_t_and_m_t":"1>resume SRB2 (if suspended), SRB3 (if configured), SRB4 (if configured), all DRBs (that are suspended) and multicast MRBs;","paragraph_zero_based":3829},{"literal_text_all_w_t_and_m_t":"NOTE 1:If the SCG is deactivated, resuming SRB3 and all DRBs does not imply that PDCP or RRC PDUs can be transmitted or received on SCG RLC bearers.","paragraph_zero_based":3830},{"literal_text_all_w_t_and_m_t":"1>if stored, discard the cell reselection priority information provided by the cellReselectionPriorities or inherited from another RAT;","paragraph_zero_based":3831},{"literal_text_all_w_t_and_m_t":"1>stop timer T320, if running;","paragraph_zero_based":3832},{"literal_text_all_w_t_and_m_t":"1>if the RRCResume message includes the measConfig:","paragraph_zero_based":3833},{"literal_text_all_w_t_and_m_t":"2>perform the measurement configuration procedure as specified in 5.5.2;","paragraph_zero_based":3834},{"literal_text_all_w_t_and_m_t":"1>resume measurements if suspended;","paragraph_zero_based":3835},{"literal_text_all_w_t_and_m_t":"1>if T390 is running:","paragraph_zero_based":3836},{"literal_text_all_w_t_and_m_t":"2>stop timer T390 for all access categories;","paragraph_zero_based":3837},{"literal_text_all_w_t_and_m_t":"2>perform the actions as specified in 5.3.14.4;","paragraph_zero_based":3838},{"literal_text_all_w_t_and_m_t":"1>if T302 is running:","paragraph_zero_based":3839}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["08decaf24261a58254bbc2c02af5515c6bfe64bdb4af0400b9f483764634a3a6","53f00bc6a2143734f006c66d171e1beb1b203bd9a62e7515b09f3d4d3b77f9a7","930c0edc13c60a9f1991cb5b6e7dc9e5bf029b9c5fcb3472fb88d897abb9a992","4c0540598b4db2ac5c3c044fd7af831887c283b9d83f1126b91e26e4ff210f69","3ed698b1bf8ba65704852dfb795e00ec5b3b9bccd9a616fd03f7d3ed9c535669","7d288701b4f6221d1354c2eec88048161c54905f2d4de4b906f90f3cab4e5795","680c23ee9c12ad27496b1ab2f0c883d4002176527f178d0a6ceca0cf0ef2fe0e","dbcea8e2dcce4616661d205e07b2356e38aaf943d0ea7a91417250d8601931aa","ced13c1c661e77c488de135041c45694cd43a3f875404684be22edc7a5d99259","ea428faab4e0da6acfb7d4180bf35fae12bdd7e3fc0a5b538f5d3f4d9b151d30","9e4a9bb4a94bb4e7d96e0bb16b61d3f5a6060dab22a00075d80db21648508f27","2ac0c45d28bd461cee074757a0843a09bda8666e103e5e93cb94bc7a7ea1b7cf","3a44226ee7682970a2be3d1f6fe9685bd0d6a65f4b3ac2c28497e23b89bccbcb","6a04900a763bbf21575ed14d96b747ba10616ad3239a9048ffcccd7fe3090aa1","ec4a6a80bbf65b2bb54e9a574b81ebfefefd012d39281da3a896c9fcbe27999f","c00c5ddf75795eb81545676b2ff5c73c05b9a7ec74e9908d1ae11a49deb90d28","326ee87e638b00b97442e831c6ae9b5ef3f38e89ea3cd579cf4394f654b44276","7ff1ad45460799c3530da6102bbce14bc828ec13acd5224b9565b5f48fbf3057","d29cce019878c49e2365aee6cbcc9dd2cf4d98aa4e1cbda31f9b672df15cb885","dd6151e537a2e6f0379d4f06245ef862fd8384c2a434f6dfae6db749514768de","9ff22b5b92455900fc5264bdeee1f672e728216ac22259f75904872660810e9c","358bd36590c80d799af398474d9da107602e323ef70ce8dfcddc869d48905a96","dfeb445788a4b5ff399fbaeeca8cc99f20f7f37d153a4da515147becdadde5ae","364f7e1a57ded9c89c73af834ca8771e8e2e34e10efd9332858ecf88e63da853"],"paragraph_range_zero_based":[3816,3839],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p3816"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>stop timer T302;","paragraph_zero_based":3840},{"literal_text_all_w_t_and_m_t":"2>perform the actions as specified in 5.3.14.4;","paragraph_zero_based":3841},{"literal_text_all_w_t_and_m_t":"1>enter RRC_CONNECTED;","paragraph_zero_based":3842},{"literal_text_all_w_t_and_m_t":"1>indicate to upper layers that the suspended RRC connection has been resumed;","paragraph_zero_based":3843},{"literal_text_all_w_t_and_m_t":"1>stop the cell re-selection procedure;","paragraph_zero_based":3844},{"literal_text_all_w_t_and_m_t":"1>stop relay reselection procedure if any for L2 U2N Remote UE;","paragraph_zero_based":3845},{"literal_text_all_w_t_and_m_t":"1>consider the current cell to be the PCell;","paragraph_zero_based":3846},{"literal_text_all_w_t_and_m_t":"1>set the content of the of RRCResumeComplete message as follows:","paragraph_zero_based":3847},{"literal_text_all_w_t_and_m_t":"2>if the upper layer provides NAS PDU, set the dedicatedNAS-Message to include the information received from upper layers;","paragraph_zero_based":3848},{"literal_text_all_w_t_and_m_t":"2>if upper layers provides a PLMN:","paragraph_zero_based":3849},{"literal_text_all_w_t_and_m_t":"3>if the UE is either allowed or instructed to access the PLMN via a cell for which at least one CAG ID is broadcast:","paragraph_zero_based":3850},{"literal_text_all_w_t_and_m_t":"4>set the selectedPLMN-Identity from the npn-IdentityInfoList;","paragraph_zero_based":3851},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":3852},{"literal_text_all_w_t_and_m_t":"4>set the selectedPLMN-Identity to the PLMN selected by upper layers from the plmn-IdentityInfoList;","paragraph_zero_based":3853},{"literal_text_all_w_t_and_m_t":"2>if the masterCellGroup contains the reportUplinkTxDirectCurrent:","paragraph_zero_based":3854},{"literal_text_all_w_t_and_m_t":"3>include the uplinkTxDirectCurrentList for each MCG serving cell with UL;","paragraph_zero_based":3855},{"literal_text_all_w_t_and_m_t":"3>include uplinkDirectCurrentBWP-SUL for each MCG serving cell configured with SUL carrier, if any, within the uplinkTxDirectCurrentList;","paragraph_zero_based":3856},{"literal_text_all_w_t_and_m_t":"2>if the masterCellGroup contains the reportUplinkTxDirectCurrentTwoCarrier:","paragraph_zero_based":3857},{"literal_text_all_w_t_and_m_t":"3>include in the uplinkTxDirectCurrentTwoCarrierList the list of uplink Tx DC locations for the configured uplink carrier aggregation in the MCG;","paragraph_zero_based":3858},{"literal_text_all_w_t_and_m_t":"2>if the masterCellGroup contains the reportUplinkTxDirectCurrentMoreCarrier:","paragraph_zero_based":3859},{"literal_text_all_w_t_and_m_t":"3>include in the uplinkTxDirectCurrentMoreCarrierList the list of uplink Tx DC locations for the configured uplink carrier aggregation in the MCG;","paragraph_zero_based":3860},{"literal_text_all_w_t_and_m_t":"2>if the UE has idle/inactive measurement information concerning cells other than the PCell available in VarMeasIdleReport:","paragraph_zero_based":3861},{"literal_text_all_w_t_and_m_t":"3>if the idleModeMeasurementReq is included in the RRCResume message:","paragraph_zero_based":3862},{"literal_text_all_w_t_and_m_t":"4>set the measResultIdleEUTRA in the RRCResumeComplete message to the value of measReportIdleEUTRA in the VarMeasIdleReport, if available;","paragraph_zero_based":3863}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["8fb39d2ceb89b42d66c3cad184f8fd4b1ac05b8995c05d051a387380d3f0fbea","59eb2831b48c48346a4d26f55a06c4ff2046ff9d02e1745a919cc304e5165682","b12403a11b533c0f826bb867a7405882fb9cf5d4523b5920ce346903d185532c","57ded4dcd46fe77f50826878de841081536e71f581441e5df60d8e80ccc6a9be","f11b8f77ae2508340e1fc62649e47f64d719843c33899789125438c929a074c1","b10a827038f26667390d79a63575142b64c25cb91b867e6a27c8f70465bd594c","3faecf48faa8164d0fe1f715a38af29e62e8cb773a5bd8315e79ae75e85611cb","200bbaa2da47a1a3493ca3222f792268c84befa103e18d23912f85b5528976fa","6bbb5d8428b47f8f6abcb8dde549daa4ef8f99d1220c84a8b3c9991e26be3081","b1ce89757d11dddc233e56c5b3472be0d54bcf101a1db6a35831aa51b27d1f8d","92f949eef105fdf8d59701a0921a6832221bc1487eaad97213558b506b523e51","8b8b54f60e4f588744c983c87b1786abd2f9b9bf8ae5edd0cc03f4b34b76a705","6f60c4ac80f66e09b1cfbfc417ab3f582d037b06fbc81b3bf37f53b3e49eac36","f9b775dd25ffce9ef428d3734f36bb89e01bb4917534150e00eade9c24b4613d","26693866ea9c66db9222e6b6fdf9ff5c918a1a49902396c9f407d8e7f89e4a40","6bbcd160daab45487de033b81f4c72380832a5b2d914422bcb3fd32f9be79c11","06feda51c0be9947a36618bdc5cff0269d99f548a928deb10a6706820052d7c6","27d54ef43e1a69a3bd57bd1cf04a6990223ad701d9d5e517ca1f8f02e5a4e8f5","1568fdbd01cb9b3c1093bb9373abe32f579b98a77b02316c266082afaf6f36fe","90f9ff57474bad3f7a3b882fcd332564e02e5cc26cfced090adbf52ca7988a5c","29cf4fe39228ddfc3d592b3fb79055ace911c09f901cc2d78b5f269c235ce0fc","f64fd5dc7268fc0dc3a4890f5bf10411fc265f7a8af3a70c0f6b737ef456e257","3aefdd09a5947c110f6706cab759c72678ea1fee06c2a07723d70a9da563b5f1","727b568672de29aa9975b7db638a8f5b1ea7d09ed14469ef56dce9221423da30"],"paragraph_range_zero_based":[3840,3863],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p3840"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>set the measResultIdleNR in the RRCResumeComplete message to the value of measReportIdleNR in the VarMeasIdleReport, if available;","paragraph_zero_based":3864},{"literal_text_all_w_t_and_m_t":"4>discard the VarMeasIdleReport upon successful delivery of the RRCResumeComplete message is confirmed by lower layers;","paragraph_zero_based":3865},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":3866},{"literal_text_all_w_t_and_m_t":"4>if the SIB1 contains idleModeMeasurementsNR and the UE has NR idle/inactive measurement information concerning cells other than the PCell available in VarMeasIdleReport; or","paragraph_zero_based":3867},{"literal_text_all_w_t_and_m_t":"4>if the SIB1 contains idleModeMeasurementsEUTRA and the UE has E-UTRA idle/inactive measurement information available in VarMeasIdleReport:","paragraph_zero_based":3868},{"literal_text_all_w_t_and_m_t":"5>include the idleMeasAvailable;","paragraph_zero_based":3869},{"literal_text_all_w_t_and_m_t":"2>if the RRCResume message includes mrdc-SecondaryCellGroup set to eutra-SCG:","paragraph_zero_based":3870},{"literal_text_all_w_t_and_m_t":"3>include in the eutra-SCG-Response the E-UTRA RRCConnectionReconfigurationComplete message in accordance with TS 36.331 [10] clause 5.3.5.3;","paragraph_zero_based":3871},{"literal_text_all_w_t_and_m_t":"2>if the RRCResume message includes mrdc-SecondaryCellGroup set to nr-SCG:","paragraph_zero_based":3872},{"literal_text_all_w_t_and_m_t":"3>include in the nr-SCG-Response the SCG RRCReconfigurationComplete message;","paragraph_zero_based":3873},{"literal_text_all_w_t_and_m_t":"2>if the UE has logged measurements available for NR and if the RPLMN is included in plmn-IdentityList stored in VarLogMeasReport:","paragraph_zero_based":3874},{"literal_text_all_w_t_and_m_t":"3>include the logMeasAvailable in the RRCResumeComplete message;","paragraph_zero_based":3875},{"literal_text_all_w_t_and_m_t":"3>if Bluetooth measurement results are included in the logged measurements the UE has available for NR:","paragraph_zero_based":3876},{"literal_text_all_w_t_and_m_t":"4>include the logMeasAvailableBT in the RRCResumeComplete message;","paragraph_zero_based":3877},{"literal_text_all_w_t_and_m_t":"3>if WLAN measurement results are included in the logged measurements the UE has available for NR:","paragraph_zero_based":3878},{"literal_text_all_w_t_and_m_t":"4>include the logMeasAvailableWLAN in the RRCResumeComplete message;","paragraph_zero_based":3879},{"literal_text_all_w_t_and_m_t":"2>if the sigLoggedMeasType in VarLogMeasReport is included:","paragraph_zero_based":3880},{"literal_text_all_w_t_and_m_t":"3>if T330 timer is running and the logged measurements configuration is for NR:","paragraph_zero_based":3881},{"literal_text_all_w_t_and_m_t":"4>set sigLogMeasConfigAvailable to true in the RRCResumeComplete message;","paragraph_zero_based":3882},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":3883},{"literal_text_all_w_t_and_m_t":"4>if the UE has logged measurements available for NR:","paragraph_zero_based":3884},{"literal_text_all_w_t_and_m_t":"5>set sigLogMeasConfigAvailable to false in the RRCResumeComplete message;","paragraph_zero_based":3885},{"literal_text_all_w_t_and_m_t":"2>if the UE has connection establishment failure or connection resume failure information available in VarConnEstFailReport or VarConnEstFailReportList and if the RPLMN is equal to plmn-Identity stored in VarConnEstFailReport or in at least one of the entries of VarConnEstFailReportList:","paragraph_zero_based":3886},{"literal_text_all_w_t_and_m_t":"3>include connEstFailInfoAvailable in the RRCResumeComplete message;","paragraph_zero_based":3887}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["06d59956440e3bd476e2e139b48dcee949612163896dd11b6311dd50a25b0fd0","b0e4b99175d29eaebf8b30ba29ddb9e22fe4c5ddb05c86cc584ab89273501520","06018919783b1f6148570d00f54cc0e462f87f036568a65bd44ecb0dccf3d559","7379de2593f96d6a800582c2b50fa5a5187837ed45423ce914c7e02b5990dd0b","a74272ffb894f837ed0bb6159edcc498d87cc5bc8e23b8bf7428e5980e40aaea","a9a0f2e3eed27c36c17679f32bf9fae13a832d2ff1ce8737a1110aa57167451b","03b6d7d62e5d5098906cc795bfcaf72e63cdc25f2ce2790d98286ad2a8f38035","5f5f9b73c9853300a2bbf677ae2b494f0bfc556be1f3db40799bfbef0de8641c","b8cd3892bb0ac15af3685b1ed0cd531709aca4579ac89df89da7981b92abef74","ab9904810dfaf9cd1271fe78ca055dacc4ecc8d3b9408e7c5356adf5449e62b6","e9a4c16049166035e5de787a120ec1fe52810ab2508003cc75d88317bd2ffc35","00661259c420df8faeaa453283b4177a321ef685b3fda98627e7acfa446e3648","65b5789fd4d8c043aa12691dc1101813c8a613c1e2c2433a53612b95e64d05e8","d8abd0c429ac31739bb47d14c1cfe9b94ba236b30eb61a771a9173ed281ee9c9","9ca590bd4204432549891c01f13077c3d1aa1f5da32183480a677802d5769c39","2638afb9008b13760004f52d528e8cb60e905ce024a6f1321c699964d5285ed5","38d041d3485b44767de82663a2f07937ccbdc9b3b522e12f57ee202315397c7f","8a1ce57b246fa86c7cdec485e30bbeb76a8bafc3cb5a02196ce28d4a0f768709","f9b10397c7d1ec9e5eb010dd09c0fde7c6a3e2fae00183da4dcc1ab840143826","60b71ff41951d36ca34f2fe4404390e6371b00d531ebec9a805bc58ece68463e","643cce78982f9b2c68672e3435f0f0c67fca82ce3ed4de396fc35e92aefadc4c","2bc6c222ee31d2ae55ffa0481ff09df7673f067ccee872f898c666b81a692c68","2c403dadf1acbc6b1e79a7593a211fa6f197a812ff8fd996a594d4752fd66ed0","400ea60ca9a93d82106d27f46a4001227c069b2e10828b577ca7b9ff057a6059"],"paragraph_range_zero_based":[3864,3887],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state in