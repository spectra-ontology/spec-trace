{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-PAGING-STOP","paragraph_zero_based":9816},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":9817},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9818},{"literal_text_all_w_t_and_m_t":"PagingRecord field descriptions","paragraph_zero_based":9819},{"literal_text_all_w_t_and_m_t":"accessType","paragraph_zero_based":9820},{"literal_text_all_w_t_and_m_t":"Indicates whether the Paging message is originated due to the PDU sessions from the non-3GPP access.","paragraph_zero_based":9821},{"literal_text_all_w_t_and_m_t":"pagingRecordList","paragraph_zero_based":9822},{"literal_text_all_w_t_and_m_t":"If the network includes pagingRecordList-v1700, it includes the same number of entries, and listed in the same order, as in pagingRecordList (i.e. without suffix).","paragraph_zero_based":9823},{"literal_text_all_w_t_and_m_t":"pagingCause","paragraph_zero_based":9824},{"literal_text_all_w_t_and_m_t":"Indicates whether the Paging message is originated due to IMS voice. If this field is present, it implies that the corresponding paging entry is for IMS voice. If upper layers indicate the support of paging cause and if this field is not present but pagingRecordList-v1700 is present, it implies that the corresponding paging entry is for a service other than IMS voice. Otherwise, paging cause is undetermined.","paragraph_zero_based":9825},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9826},{"literal_text_all_w_t_and_m_t":"–RRCReestablishment","paragraph_zero_based":9827},{"literal_text_all_w_t_and_m_t":"The RRCReestablishment message is used to re-establish SRB1.","paragraph_zero_based":9828},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1","paragraph_zero_based":9829},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_ba