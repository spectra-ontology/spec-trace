ion.","paragraph_zero_based":41800},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41801},{"literal_text_all_w_t_and_m_t":"–VarRLF-Report","paragraph_zero_based":41802},{"literal_text_all_w_t_and_m_t":"The UE variable VarRLF-Report includes the radio link failure information or handover failure information.","paragraph_zero_based":41803},{"literal_text_all_w_t_and_m_t":"VarRLF-Report UE variable","paragraph_zero_based":41804},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":41805},{"literal_text_all_w_t_and_m_t":"-- TAG-VARRLF-REPORT-START","paragraph_zero_based":41806},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41807}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["e699f1e588b69eba9db36306883085ebc9c1afa26076cc8e3ed38e501e90a30b","a9faef15453af15c8a3b1566f731a4176b0e1a8c145025b14fa98afcb7c0f45f","ffb0eeacd06ee6ab9c2f1065f3686b2d962b22ab60b170fa30eea837495c8c32","6c12c546544db28d61a984b265b6bccda5e677865455eb10b36aa9f960b0216a","91d27130588b88c2568d5cd32156093a1c033eee69443f2e43bc569bc7492041","4f54331c04d0e34363e8f04b1c238f19f4bda5e487eae232f790a60359e2de5f","9df1abdcd4abdfedccdfbcdcb8700726a2e4d9452864ef9ab61b05620e36b0ff","091a80893137b5f2906ded99a9eed5ea767231b887853359779f8c36a11291f3","81e1f1e89a7bf13281280de01a2cae8f075cbdaf33ef75fb58a6b2eb4dde2068","46a34d06565fbfdc39f706e59cbbc0a9f97f3c565c5a27765066f1488208a1e9","6cdb153fda9387edf01151130bd72e50fd7221db82ea78ecac514c6f36ae152a","06f675711becd4be99ca764a4cbe25e1fbaaf3157f43f7473059960ee8605178","5c07aa532f1edb6c8b09c18444cc8568a3b7f5d48a2ebbcc1440924369f908de","a57e9e4778278f64a51a799372eaee73909d4abff1dc4c17fedc06b91b1d04b8","e2a97b9f3bb718074d0b7c69995f8ce68a