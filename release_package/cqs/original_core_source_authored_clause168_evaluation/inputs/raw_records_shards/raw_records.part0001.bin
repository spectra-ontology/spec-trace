ebookTypeRequest-r16        SEQUENCE {","paragraph_zero_based":35654},{"literal_text_all_w_t_and_m_t":"        type1-SinglePanel-r16          ENUMERATED {true}                                    OPTIONAL,    -- Need N","paragraph_zero_based":35655},{"literal_text_all_w_t_and_m_t":"        type1-MultiPanel-r16           ENUMERATED {true}                                    OPTIONAL,    -- Need N","paragraph_zero_based":35656},{"literal_text_all_w_t_and_m_t":"        type2-r16                      ENUMERATED {true}                                    OPTIONAL,    -- Need N","paragraph_zero_based":35657},{"literal_text_all_w_t_and_m_t":"        type2-PortSelection-r16        ENUMERATED {true}                                    OPTIONAL     -- Need N","paragraph_zero_based":35658},{"literal_text_all_w_t_and_m_t":"    }                                                                                   OPTIONAL,    -- Need N","paragraph_zero_based":35659},{"literal_text_all_w_t_and_m_t":"    uplinkTxSwitchRequest-r16      ENUMERATED {true}                                    OPTIONAL     -- Need N","paragraph_zero_based":35660},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":35661},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":35662},{"literal_text_all_w_t_and_m_t":"    requestedCellGrouping-r16      SEQUENCE (SIZE (1..maxCellGroupings-r16)) OF CellGrouping-r16    OPTIONAL    -- Cond NRDC","paragraph_zero_based":35663}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["c74ef8843e4395f1c42204667121bcfde100f33d93745b27576d4b3d9a6cf183","72f4315c7974f783e1785a13378c293a3f4198f887cf409cdfe1822a0a62faa0","a009b54be28dc646fe744fbfda37feee371a216b3efc