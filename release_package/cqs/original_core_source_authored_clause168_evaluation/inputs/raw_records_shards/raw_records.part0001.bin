{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"   }","paragraph_zero_based":38784},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":38785},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38786},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-QOS-PROFILE-STOP","paragraph_zero_based":38787},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":38788},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38789},{"literal_text_all_w_t_and_m_t":"SL-QoS-Profile field descriptions","paragraph_zero_based":38790},{"literal_text_all_w_t_and_m_t":"sl-GFBR","paragraph_zero_based":38791},{"literal_text_all_w_t_and_m_t":"Indicate the guaranteed bit rate for a GBR QoS flow. The unit is: Kbit/s","paragraph_zero_based":38792},{"literal_text_all_w_t_and_m_t":"sl-MFBR","paragraph_zero_based":38793},{"literal_text_all_w_t_and_m_t":"Indicate the maximum bit rate for a GBR QoS flow. The unit is: Kbit/s","paragraph_zero_based":38794},{"literal_text_all_w_t_and_m_t":"sl-PQI","paragraph_zero_based":38795},{"literal_text_all_w_t_and_m_t":"This field indicates either the PQI for standardized PQI or non-standardized QoS parameters.","paragraph_zero_based":38796},{"literal_text_all_w_t_and_m_t":"sl-Range","paragraph_zero_based":38797},{"literal_text_all_w_t_and_m_t":"This field indicates the range parameter of the Qos flow, as defined in clause 5.4.1.1.1, TS 23.287 [55]. It is present only for groupcast. The unit is meter.","paragraph_zero_based":38798},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38799},{"literal_text_all_w_t_and_m_t":"SL-PQI field descriptions","paragraph_zero_based":38800},{"literal_text_all_w_t_and_m_t":"sl-AveragingWindow","paragraph_zero_based":38801},{"literal_text_all_w_t_and_m_t":"Indicates the Averaging Window for a QoS flow, and applies to GBR QoS flows only. Unit: ms. The default value of the IE is 2000ms.","paragraph_zero_based":38802},{"literal_text_all_w_t_and_m_t":"sl-MaxDataBurstVolume","paragraph_zero_based":38803},{"literal_text_all_w_t_and_m_t":"Indicates the Maximum Data Burst Volume for a QoS flow, and applies to delay critical GBR QoS flows only. Unit: byte.","paragraph_zero_based":38804},{"literal_text_all_w_t_and_m_t":"sl-PacketDelayBudget","paragraph_zero_based":38805},{"literal_text_all_w_t_and_m_t":"Indicates the Packet Delay Budget for a QoS flow. Upper bound value for the delay that a packet may experience expressed in unit of 0.5ms.","paragraph_zero_based":38806},{"literal_text_all_w_t_and_m_t":"sl-PacketErrorRate","paragraph_zero_based":38807}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["e3110a4315a0cfbe8a0c7a746c418c425d89565eee1bd0b72f02b8952d16510b","056367d15296a3834e514c87de9d976ea200d63f0dac2802c09210057aa388d7","b3b337e3a29b3d0ca54aeec353ba972e98c8bc6ecc4915fe9d630b3417ec145b","2e2c2e517e9fc5bab8ea9b6eb6e5edf893705ae9a87d2977e8ce7ba8b999f6a4","9100feaed0427a5c4fb47e71e437e61901dc3213af991771aeab0918573aa342","4acc9d8116e785da878c9b378af91e23cbf65bf9057570d50ec4fa5dccdf7442","d89ff2dc92f0602d93efe69613b979b654c50c2506ac018fd142e8c4a432bd7d","e245c7afd8c98d1dcc121167c0dc804e5ffe5732a7bb9ab2192aa4d79769cac5","27fbc349bf192b20450d11a8f10c9073ec3c43a9f7d6452935ecf6a02dc2dbdf","be6af5a2886fe85c3fff0e082fddc5848da01acaab5075f0b33c12d0788f7206","ca379ce4fec22811ea98d619563a8547987ac05b15df26801ffc9b5393aea231","5255d14931f3101c60923b0ec70225cb974c6efa88ea2c2954687ff72d1cd9ff","a06bd54efa989fe9a209c858574caad7c8d16278b8a6d0aeacdf25a1e2c773b6","895ad00095e894a24d5cce6530db9deac9a095627ac79d696cae0a4c4b26d37a","68c8cad156242b148dfd3769d4e562a44d24d91810417e2ec82568aed46c5031","e6cf6e2085eafadcd54c5847db950b694e9a849eea57e9154deb2de0993f6d66","c6ccd91ad374cf083c01e50da0dde3f832b036fd2c36f9b3da3fd46a5f6f211c","e5f95a2c37699bc4842bfc47f7178c78e9b63e1c3d59dc869436af0c3ba0c4fe","25de533fb8a7505dad919105381e72df3cb76ba38957d58b2ac6cffcd9124dc9","cf504a08b275f606aad8e5086bff2a1fb3f7b42e44516f17998cb766e9bae9f3","de97b5cc30d78852d18e11f4b682184851b59d2c91908826474a9086a7e262ea","0626d6f50f7d4af87fa210c6e6c50aba6c40d1ed49a4a4c0db39f3c551fb0ee8","130e362ff9973f0fa1808c1db7ee13f9a516262bd7bd598cfcbb134e5f400fd3","d0cce8787d8bd1160285dc484b55c9f72305c00f88cdfb6468ee48fd44b9b8a1"],"paragraph_range_zero_based":[38784,38807],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p38784"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the Packet Error Rate for a QoS flow. The packet error rate is expressed as Scalar x 10-k where k is the Exponent.","paragraph_zero_based":38808},{"literal_text_all_w_t_and_m_t":"sl-PriorityLevel","paragraph_zero_based":38809},{"literal_text_all_w_t_and_m_t":"Indicates the Priority Level for a QoS flow. Values ordered in decreasing order of priority, i.e. with 1 as the highest priority and 8 as the lowest priority.","paragraph_zero_based":38810},{"literal_text_all_w_t_and_m_t":"sl-StandardizedPQI","paragraph_zero_based":38811},{"literal_text_all_w_t_and_m_t":"Indicate the PQI for standardized PQI.","paragraph_zero_based":38812},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38813},{"literal_text_all_w_t_and_m_t":"–SL-QuantityConfig","paragraph_zero_based":38814},{"literal_text_all_w_t_and_m_t":"The IE SL-QuantityConfig specifies the layer 3 filtering coefficients for NR SL RSRP measurement for a destination.","paragraph_zero_based":38815},{"literal_text_all_w_t_and_m_t":"SL-QuantityConfig information element","paragraph_zero_based":38816},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":38817},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-QUANTITYCONFIG-START","paragraph_zero_based":38818},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38819},{"literal_text_all_w_t_and_m_t":"SL-QuantityConfig-r16 ::=               SEQUENCE {","paragraph_zero_based":38820},{"literal_text_all_w_t_and_m_t":"    sl-FilterCoefficientDMRS-r16            FilterCoefficient                             DEFAULT fc4,","paragraph_zero_based":38821},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":38822},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":38823},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38824},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-QuantityConfig-STOP","paragraph_zero_based":38825},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":38826},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38827},{"literal_text_all_w_t_and_m_t":"SL-QuantityConfig field descriptions","paragraph_zero_based":38828},{"literal_text_all_w_t_and_m_t":"sl-FilterCoefficientDMRS","paragraph_zero_based":38829},{"literal_text_all_w_t_and_m_t":"DMRS based L3 filter configuration:","paragraph_zero_based":38830},{"literal_text_all_w_t_and_m_t":"Specifies L3 filter configuration for sidelink RSRP measurement result from the L1 fiter(s), as defined in TS 38.215 [9].","paragraph_zero_based":38831}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["b4dda453874508dc2df78a34f71b439f24ce936044314dd62e232858b941565e","1d840c784f588eeb687d4436b3823dd1b96b35cdb6cd8834a0d87ed9cb5fe0bc","ae7413a2c95c1514acd81f27a5ffd56ceefd487086dc4418f5d2f27366a4ee88","cc30d49a88e043507482dfdab4d6067129890deeb205444c3420a126e8459c60","62d4ba8ced5aab4793e68f5a429a63499962e4bfe503f536ab93d632798ec91d","93958bcc67d7e2a98b9176be85b8a384aee5876d3ab99c4446d5b693443221a3","d2a1004a579996427d282d81c2cf283e33d8d3e047a896b1e188f5957dc332c9","d50ce6184f7d765b5cb43dc46038267764916fb78aa24214aab4b6d71ddc3dc1","b23f453beb7d8a920c2ed6cc1a25951a58ff49dba3db54af715c5e1bdeccb4bf","dc54bbc8a6995ced9eb2689bc1e107ce51e8232af72dab762fdb0ddc233feec6","0d9231cd68264c30d323d99f89a900f2eca0984fdb66faa493a7beb82e77d0d9","e33e654bb778b0e24e7002c1418b5d5516ac122fe89408253234c566fe9d62f3","890729870b0cdc64f4c07598c2135b235749a949e2bf2b6baefe2d72686a304b","eef398484912f43b3ae11eeed2dbe402841c474f820d189643113d43a8045813","e1832