{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.2.2.4.6Actions upon reception of SIB5","paragraph_zero_based":984},{"literal_text_all_w_t_and_m_t":"No UE requirements related to the contents of this SIB5 apply other than those specified elsewhere e.g. within procedures using the concerned system information, and/ or within the corresponding field descriptions.","paragraph_zero_based":985},{"literal_text_all_w_t_and_m_t":"5.2.2.4.7Actions upon reception of SIB6","paragraph_zero_based":986},{"literal_text_all_w_t_and_m_t":"Upon receiving the SIB6 the UE shall:","paragraph_zero_based":987},{"literal_text_all_w_t_and_m_t":"1>forward the received warningType, messageIdentifier and serialNumber to upper layers;","paragraph_zero_based":988},{"literal_text_all_w_t_and_m_t":"5.2.2.4.8Actions upon reception of SIB7","paragraph_zero_based":989},{"literal_text_all_w_t_and_m_t":"Upon receiving the SIB7 the UE shall:","paragraph_zero_based":990},{"literal_text_all_w_t_and_m_t":"1>if there is no current value for messageIdentifier and serialNumber for SIB7; or","paragraph_zero_based":991},{"literal_text_all_w_t_and_m_t":"1>if either the received value of messageIdentifier or of serialNumber, or of both messageIdentifier and serialNumber are different from the current values of messageIdentifier and serialNumber for SIB7:","paragraph_zero_based":992},{"literal_text_all_w_t_and_m_t":"2>use the received values of messageIdentifier and serialNumber for SIB7 as the current values of messageIdentifier and serialNumber for SIB7;","paragraph_zero_based":993},{"literal_text_all_w_t_and_m_t":"2>discard any previously buffered warningMessageSegment;","paragraph_zero_based":994},{"literal_text_all_w_t_and_m_t":"2>if all segments of a warning message have been received:","paragraph_zero_based":995},{"literal_text_all_w_t_and_m_t":"3>assemble the warning message from the received warningMessageSegment(s);","paragraph_zero_based":996},{"literal_text_all_w_t_and_m_t":"3>forward the received warning message, messageIdentifier, serialNumber and dataCodingScheme to upper layers;","paragraph_zero_based":997},{"literal_text_all_w_t_and_m_t":"3>stop reception of SIB7;","paragraph_zero_based":998},{"literal_text_all_w_t_and_m_t":"3>discard the current values of messageIdentifier and serialNumber for SIB7;","paragraph_zero_based":999},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":1000},{"literal_text_all_w_t_and_m_t":"3>store the received warningMessageSegment;","paragraph_zero_based":1001},{"literal_text_all_w_t_and_m_t":"3>continue reception of SIB7;","paragraph_zero_based":1002},{"literal_text_all_w_t_and_m_t":"1>else if all segments of a warning message have been received:","paragraph_zero_based":1003},{"literal_text_all_w_t_and_m_t":"2>assemble the warning message from the received warningMessageSegment(s);","paragraph_zero_based":1004},{"literal_text_all_w_t_and_m_t":"2>forward the received complete warning message, messageIdentifier, serialNumber and dataCodingScheme to upper layers;","paragraph_zero_based":1005},{"literal_text_all_w_t_and_m_t":"2>stop reception of SIB7;","paragraph_zero_based":1006},{"literal_text_all_w_t_and_m_t":"2>discard the current values of messageIdentifier and serialNumber for SIB7;","paragraph_zero_based":1007}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["6d71ecc2d4d00ef20d5fb8685b85de82195c50bdb20b836701c2ea52b2cb23fa","e5b2729e9a18c423f029b7a24fa73e6769478acf47a77bcc85357bf7010ff48e","dd23f828386c377e7c2495738ba43f36e4d3e97a0f89b3fb79070fe65235b7ab","833b79d7401c42851b75eb37096b5444b663d92809849d7059e3e8109ad2b856","490ebacdd9612abf584f49d7f2f935dbefc7a7f15a494f2c19e6f42042ea9e03","19e044fa6c5a817c39580f147716d5175e5e710a826f4e5877fc5a6e1e80813f","9d2a66a8f2a5a860c823e3289dcaa17f4805b7e23f9b4176fdb361415a378501","3a5b96424e5586370c625e27b02abcc59906cc0a3d3428242846d61c4b147fea","fd95cd03481d84e15ed9c172292d44596be42bbd1bd1cdf8701a0a8541aa784c","985c2bfbb7d6b68db9a2ff17b48a9cfba8636b09ee4240e10c41904f53da05f8","85e6c4142c420869b7e9ee3c4554e364397fbce715bc719b3e2dd0df8ed9f923","1a3f945782f2fdbe5be2c367f92a5dde914cd9f1be0a8873016a81821f08cb27","ee81cacf2591289e905bd6140ff473f1052b6c2383b4f5be7f003f2ea5091e57","09bf4fbb2dfc96d9e1217a462434fe5f7503818e643d0ebefd1a97346a4944f4","347be35f1d4d251c9e230903a6479918640af6a0870d84d615da039355f161e8","a1d86b07900f5f483228d42bb9927fa7cf6b64d278df126a0ceb64addce63161","59c9ab842859b18cdd3e85e8e36eba9d876afad7c0302a58ef08d05a8ea89651","3f65bb10c2d50a061b424543e4019573371ef855a784236e4d2fd5756f3f29c7","bbb7e973da3ff15c1c8a4b48162b3f35dc8e510f9193af90b61db571cbb5fdbe","705fd23cb6c9dda155d0d0c374a0abdc14b2888662309335020b6ea7a529a3c7","73c008621c56e8d71915359d1d0534d365f2cde82bfc12aa4083d1b183fe5aac","dcefb0cca2c511b62f15e9abc5b38cd422099685e4f5ddba34905d39f6bba72c","08b29f6528b4dff1281e1fac7f4c687feecea20d3a7afcb6de0f0731011a9c66","60f836ed5192e90869f6689072529b77e6eddcaddb21bb7a0cadf4ed5bb8edbc"],"paragraph_range_zero_based":[984,1007],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p984"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":1008},{"literal_text_all_w_t_and_m_t":"2>store the received warningMessageSegment;","paragraph_zero_based":1009},{"literal_text_all_w_t_and_m_t":"2>continue reception of SIB7;","paragraph_zero_based":1010},{"literal_text_all_w_t_and_m_t":"The UE should discard any stored warningMessageSegment and the current value of messageIdentifier and serialNumber for SIB7 if the complete warning message has not been assembled within a period of 3 hours.","paragraph_zero_based":1011},{"literal_text_all_w_t_and_m_t":"5.2.2.4.9Actions upon reception of SIB8","paragraph_zero_based":1012},{"literal_text_all_w_t_and_m_t":"Upon receiving the SIB8 the UE shall:","paragraph_zero_based":1013},{"literal_text_all_w_t_and_m_t":"1>if the SIB8 contains a complete warning message and the complete geographical area coordinates (if any):","paragraph_zero_based":1014},{"literal_text_all_w_t_and_m_t":"2>forward the received warning message, messageIdentifier, serialNumber, dataCodingScheme and the geographical area coordinates (if any) to upper layers;","paragraph_zero_based":1015},{"literal_text_all_w_t_and_m_t":"2>continue reception of SIB8;","paragraph_zero_based":1016},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":1017},{"literal_text_all_w_t_and_m_t":"2>if the received values of messageIdentifier and serialNumber are the same (each value is the same) as a pair for which a warning message and the geographical area coordinates (if any) are currently being assembled:","paragraph_zero_based":1018},{"literal_text_all_w_t_and_m_t":"3>store the received warningMessageSegment;","paragraph_zero_based":1019},{"literal_text_all_w_t_and_m_t":"3>store the received warningAreaCoordinatesSegment (if any);","paragraph_zero_based":1020},{"literal_text_all_w_t_and_m_t":"3>if all segments of a warning message and geographical area coordinates (if any) have been received:","paragraph_zero_based":1021},{"literal_text_all_w_t_and_m_t":"4>assemble the warning message from the received warningMessageSegment;","paragraph_zero_based":1022},{"literal_text_all_w_t_and_m_t":"4>assemble the geographical area coordinates from the received warningAreaCoordinatesSegment (if any);","paragraph_zero_based":1023},{"literal_text_all_w_t_and_m_t":"4>forward the received warning message, messageIdentifier, serialNumber, dataCodingScheme and geographical area coordinates (if any) to upper layers;","paragraph_zero_based":1024},{"literal_text_all_w_t_and_m_t":"4>stop assembling a warning message and geographical area coordinates (if any) for this messageIdentifier and serialNumber and delete all stored information held for it;","paragraph_zero_based":1025},{"literal_text_all_w_t_and_m_t":"3>continue reception of SIB8;","paragraph_zero_based":1026},{"literal_text_all_w_t_and_m_t":"2>else if the received values of messageIdentifier and/or serialNumber are not the same as any of the pairs for which a warning message is currently being assembled:","paragraph_zero_based":1027},{"literal_text_all_w_t_and_m_t":"3>start assembling a warning message for this messageIdentifier and serialNumber pair;","paragraph_zero_based":1028},{"literal_text_all_w_t_and_m_t":"3>start assembling the geographical area coordinates (if any) for this messageIdentifier and serialNumber pair;","paragraph_zero_based":1029},{"literal_text_all_w_t_and_m_t":"3>store the received warningMessageSegment;","paragraph_zero_based":1030},{"literal_text_all_w_t_and_m_t":"3>store the received warningAreaCoordinatesSegment (if any);","paragraph_zero_based":1031}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha25