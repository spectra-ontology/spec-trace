{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29304},{"literal_text_all_w_t_and_m_t":"–SRS-TPC-CommandConfig","paragraph_zero_based":29305},{"literal_text_all_w_t_and_m_t":"The IE SRS-TPC-CommandConfig is used to configure the UE for extracting TPC commands for SRS from a group-TPC messages on DCI","paragraph_zero_based":29306},{"literal_text_all_w_t_and_m_t":"SRS-TPC-CommandConfig information element","paragraph_zero_based":29307},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29308},{"literal_text_all_w_t_and_m_t":"-- TAG-SRS-TPC-COMMANDCONFIG-START","paragraph_zero_based":29309},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29310},{"literal_text_all_w_t_and_m_t":"SRS-TPC-CommandConfig ::=               SEQUENCE {","paragraph_zero_based":29311},{"literal_text_all_w_t_and_m_t":"    startingBitOfFormat2-3                  INTEGER (1..31)                                                     OPTIONAL,   -- Need R","paragraph_zero_based":29312},{"literal_text_all_w_t_and_m_t":"    fieldTypeFormat2-3                      INTEGER (0..1)                                                      OPTIONAL,   -- Need R","paragraph_zero_based":29313},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":29314},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":29315},{"literal_text_all_w_t_and_m_t":"    startingBitOfFormat2-3SUL               INTEGER (1..31)                                                     OPTIONAL    -- Need R","paragraph_zero_based":29316},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":29317},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29318},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29319},{"literal_text_all_w_t_and_m_t":"-- TAG-SRS-TPC-COMMANDCONFIG-STOP","paragraph_zero_based":29320},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29321},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29322},{"literal_text_all_w_t_and_m_t":"SRS-TPC-CommandConfig field descriptions","paragraph_zero_based":29323},{"literal_text_all_w_t_and_m_t":"fieldTypeFormat2-3","paragraph_zero_based":29324},{"literal_text_all_w_t_and_m_t":"The type of a field within the group DCI with SRS request fields (optional), which indicates how many bits in the field are for SRS request (0 or 2).","paragraph_zero_based":29325},{"literal_text_all_w_t_and_m_t":"Note that for Type A, there is a common SRS request field for all SCells in the set, but each SCell has its own TPC command bits. See TS 38.212 [17] clause 7.3.1 and , TS 38.213 [13], clause 11.3.","paragraph_zero_based":29326},{"literal_text_all_w_t_and_m_t":"startingBitOfFormat2-3","paragraph_zero_based":29327}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["d65394ad4690e13861d2e99352e4d882a227f96bb28bb7adcd668f6a44fcccbd","cadedcec8f4935a0d180d3825ff333828a1ebd6763090fb6e1e4b06852d93a62","939d535ec42c55ef88b31c01190304548593b159b3cc7c08baccf24e2b1ca61b","163cdf376b144eff17f2739b5424eacdcde4c066930565daa8d799bfe97d62b5","e4bce76bbd31e3f3a6a39649663303a244e776d66c013b0dc6373bf621f04c41","dfb9f29c06ac0358d8985de3b0e95bf11a1a83b9d7c5a3b8e6b60346c9f535eb","204abc37096e2747d055e6b34a7d50de20a1b56fea883dd3a5a9c22e877a0a3e","1e7216c272ee83b5a6c24ebe13ab97a8d2418aa348e9c98365aed3e54dd8aca8","3e128add2f98e1aa202ed82bc0e8aa111e772fa9713f3b9acf28532e978c1d8d","698304b83dc4aed2beed0642a6a022e7b4c8ce3f5e352c521feabb1ec204dc0e","30455db08cda71623256772c014ab13eba86683b7ea5adf3f4e8ab6d18f6a1cd","c7e85467a5136615ff52fe204f53ecbfb14f64e419f44436680b0331b3d4f7af","fc190ef8a8518e4e43c470406b9638e61c7954c323bcd5ab39012bbc8e0fe25e","164b2e5461308f1935399d29e05b7c42b8e56a55965ba72ff9e06c0eb76877b9","38fb242c5eb64d35d6e4f6b79dbffd1d1ac02f6de58c19481818814fe931e4eb","73f4d5bbb1fc063862928c18aac40f33ab1fee82c8ae4f8a06b369604933bab5","b3d085d948b504227ce097781119b2572a8e7b490f304d028d6829631b2cd1d3","40445268ddea36015c6d322e06df23a6d6179610496e76be9a406b0cc6a57904","9c541185de609e263179046447e183c273f404a883a40546c17a7e58a3275c70","5963fe9ec474bd1dc2c0dde7d11e3140b0b899f91cfeb442c96a6a4f6bb4876c","d5322078c8fdc5f2a6337897cc9debc35ea988f7b966e9dc93549406619bfc76","a5b35e316562023d586e62f2b2fcb1457c23141e3ac0595aeeb75f231a12de14","7cc8212d2e532590cc6cfc176a0a25c407d5ae2fd819470eaed0a082af6e7a58","d8548808d30439e074c5375ab6f55919f47264804093bbc9a0c78ca4c9e3ffb1"],"paragraph_range_zero_based":[29304,29327],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p29304"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The starting bit position of a block within the group DCI with SRS request fields (optional) and TPC commands. The value 1 of the field corresponds to the first/left most bit of format2-3. The value 2 of the field corresponds to the second bit format2-3, and so on (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13], clause 11.3).","paragraph_zero_based":29328},{"literal_text_all_w_t_and_m_t":"startingBitOfFormat2-3SUL","paragraph_zero_based":29329},{"literal_text_all_w_t_and_m_t":"The starting bit position of a block within the group DCI with SRS request fields (optional) and TPC commands for SUL carrier (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13], clause 11.3).","paragraph_zero_based":29330},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29331},{"literal_text_all_w_t_and_m_t":"–SSB-Index","paragraph_zero_based":29332},{"literal_text_all_w_t_and_m_t":"The IE SSB-Index identifies an SS-Block within an SS-Burst. See TS 38.213 [13], clause 4.1.","paragraph_zero_based":29333},{"literal_text_all_w_t_and_m_t":"SSB-Index information element","paragraph_zero_based":29334},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29335},{"literal_text_all_w_t_and_m_t":"-- TAG-SSB-INDEX-START","paragraph_zero_based":29336},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29337},{"literal_text_all_w_t_and_m_t":"SSB-Index ::=                       INTEGER (0..maxNrofSSBs-1)","paragraph_zero_based":29338},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29339},{"literal_text_all_w_t_and_m_t":"-- TAG-SSB-INDEX-STOP","paragraph_zero_based":29340},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29341},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29342},{"literal_text_all_w_t_and_m_t":"–SSB-MTC","paragraph_zero_based":29343},{"literal_text_all_w_t_and_m_t":"The IE SSB-MTC is used to configure measurement timing configurations, i.e., timing occasions at which the UE measures SSBs.","paragraph_zero_based":29344},{"literal_text_all_w_t_and_m_t":"SSB-MTC information element","paragraph_zero_based":29345},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29346},{"literal_text_all_w_t_and_m_t":"-- TAG-SSB-MTC-START","paragraph_zero_based":29347},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29348},{"literal_text_all_w_t_and_m_t":"SSB-MTC ::=                             SEQUENCE {","paragraph_zero_based":29349},{"literal_text_all_w_t_and_m_t":"    periodicityAndOffset                    CHOICE {","paragraph_zero_based":29350},{"literal_text_all_w_t_and_m_t":"        sf5                                 INTEGER (0..4),","paragraph_zero_based":29351}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["4c0540b81bb913f2083d1c5cf0a746da5962a35938a59065d93af6a386620e21","26fefb3ae1080175b0c588b33b7721d24becb69c57216f10c64b19beecfd331c","41ca2f178b2855e1a85dd92740aae974e905d82f1bf94a343ab7d1fe600675ec","171709c52c7dd157ccb851b0fe01230f30b17f841635802a55773eb0688dc40b","8733cc0dcf2a50eceeb65bca22fe686ca25c36de9bf17a75da56c7c829888192","e7bee15b3c04e43bb3397f2f1ae2c77c8ba634dc34790473a95dd6a60f1b669d","3f5cdd698f986194d1c0b1774b7e1813ed4d42304578a5f3b58896710c97ec10","1c09f403d763a2643b8dd980c367eb0830fe51ab55fe883a0a525dc4e3079b06","87ad13e1d184051b98638ffb28362352cd9a4c09d0a8cd340a760f5d9aac55d4","25af4ba39d6bbb4a34bbe8106ac59d8990b188aa5469205c2b497cce34857f4a","a320d53122fae2764bbdf65f67120e78ebd9465f09c4e6b243619e886d4be7c1","adfe11d7a73818b468906633a2c1