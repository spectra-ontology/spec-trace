{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":24000},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":24001},{"literal_text_all_w_t_and_m_t":"    tpc-IndexPUCCH-sSCell-r17                             INTEGER (1..15)                         OPTIONAL,  -- Need R","paragraph_zero_based":24002},{"literal_text_all_w_t_and_m_t":"    tpc-IndexPUCCH-sScellSecondaryPUCCHgroup-r17          INTEGER (1..15)                         OPTIONAL   -- Cond twoPUCCHgroup","paragraph_zero_based":24003},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":24004},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":24005},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24006},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-TPC-COMMANDCONFIG-STOP","paragraph_zero_based":24007},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":24008},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24009},{"literal_text_all_w_t_and_m_t":"PUCCH-TPC-CommandConfig field descriptions","paragraph_zero_based":24010},{"literal_text_all_w_t_and_m_t":"tpc-IndexPCell","paragraph_zero_based":24011},{"literal_text_all_w_t_and_m_t":"An index determining the position of the first bit of TPC command (applicable to the SpCell) inside the DCI format 2-2 payload.","paragraph_zero_based":24012},{"literal_text_all_w_t_and_m_t":"tpc-IndexPUCCH-SCell","paragraph_zero_based":24013},{"literal_text_all_w_t_and_m_t":"An index determining the position of the first bit of TPC command (applicable to the PUCCH SCell) inside the DCI format 2-2 payload.","paragraph_zero_based":24014},{"literal_text_all_w_t_and_m_t":"tpc-IndexPUCCH-sSCell, tpc-IndexPUCCH-sSCellSecondaryPUCCHgroup","paragraph_zero_based":24015},{"literal_text_all_w_t_and_m_t":"An index determining the position of the first bit of TPC command (applicable to the alternative PUCCH cell for PUCCH cell switching) inside the DCI format 2-2 payload, for the primary PUCCH group and the secondary PUCCH group respectively.","paragraph_zero_based":24016},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24017},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":24018},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":24019},{"literal_text_all_w_t_and_m_t":"PDCCH-OfSpcell","paragraph_zero_based":24020},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the PUCCH-TPC-CommandConfig is provided in the PDCCH-Config for the SpCell. Otherwise, the field is absent, Need R.","paragraph_zero_based":24021},{"literal_text_all_w_t_and_m_t":"PDCCH-ofSpCellOrPUCCH-SCell","paragraph_zero_based":24022},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the PUCCH-TPC-CommandConfig is provided in the PDCCH-Config for the PUCCH-SCell.","paragraph_zero_based":24023}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["90b73d24c5d1281defbdf4622a8bce14b31b10e4f30d370f20490a1dcb14530e","6fa92b01c1b4280ea922c8e44bf082792e4d5c1728d29e4be04e77a2add425fc","d43e1f25b39002897e06194b870fce580ff80042059c006b0229c539e006fec9","441de722f3b028a8d2e75154557d057c9c06c6aada2d7112ae850d89492b8c7a","fd7494ceb263e83badad3229822728401ef40fdfa853514f2a310ef16df1ab13","573ea933e0ed246d0168d9cada835f68da9b22b55a0bb42452ecb4de60a4d6b0","eefb8f566f73a427b82534466d624031836aa7203d4052274d0043f255bb1812","592f0ae0b65e83ccab833dbd79638149da628359aea37635ccde14b796b346f1","e4abde53d3cabd10d86b900a9d4e10980d86aa5aff9b5decc88f70c1411f8023","5f6af8ade8fca78f7edd6c7037bf93b1ac