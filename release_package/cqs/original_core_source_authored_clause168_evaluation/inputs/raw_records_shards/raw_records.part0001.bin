7e900c013fbd0727f6f458823df19ac33e354f632323a463c862d10e","original_member_sha256":"9be80f761ab1a5a8e2b40c9ef13f4aa84d7d70b3c6af4a740de3e81f68b17102","paragraph_ElementTree_utf8_XML_sha256":["1dd5c6e3e6285b21e30491f34a44233de5333cf30a371c27e03fb0bc361e9305","4328dbc2e9ed59984edad9da9f918a037222a8bc1d4a7f801e449d0bf4e71fd0","1b57abbb250ccf0e7dbcfaad8666dd22e39df29408dc1d6e61b3298df1a31533","dca27312d7a1517d19ed558671871fab25e9b549c607883b97a78f9f3628f08a","6d3fba1314de1001e3753ed4f16b9c74cdf0271805f61b17dcc5b42bd590842f","617785343afc34ff86d7085e070e5171c849cf65b766df069d11ae4921b43535","b43a9677c685bd5f88389972c1d9515dbb01f69389efd9142c4aeb1859ba5e7e","cb9646e53a961acadd8b9d1cbe9977f71385aded0c0dd84e225defb7e8545ad8","e434e65a10e838afc9f35a37c5efebc215fd9aedc21692d7cc12941674744e85","48f27d1f338f2e6cabf1ff384625f9d1a5e67ab8190bf0af224f5e9fd5a2044d","9fc90ec4c1a0189a415eae9682e393cba5b67d0dd1a898eeb73799b6ce95ddd4","731cd85286f824ffc8ab15b3e076faaf16231b040ec58d5b982eb0b04411f518","d3f2044327acd1c0d70ce68220f6403328bcc559f10715f77594fe9c95213634","15446e336e26f8e8542354aaa67cefc1b9b0d8b4af76558f1b7e96594ab3e72b","032e9f858d3d59ab048f1c6847f25e5b233bb6ba0c88c96eee40690f328745ca","1ac810a1cab11c95a1df934fbe11d17d0c7b90f828c877e62a98a07ed58b7dfa","eafccc1c7ffbf6e26592b7fe63294aa8d5bde0f27e6bb41cec4cefdbff8d6992","b3f8ba76ec829a0eac6003bc8cbccaed17d41a62756dd1214cc8a7fa8c87c76d","ebb18e058d1fac3e0efc9941e530e6c9327f91af82e47a50969e70a111afea2a","3414cdb6eb28f3d6bb724524fd9f7aec01719c7565d41cee88e8f9030ce85edc","dcb00a9e6c6c316c0088d2dc5f1b8ad2617b4424352762cd9029642ce44b55be","adf91afec1ef44a2388772bd7103ea6e4f36004e933a3b58dc00af5209fde022","500ae1e95311986e752b9be027e0c22a78d267c2f0de2c686523828721158b14","1cef444d894cdacbe559bb45e53c3b2ef7f77da82c45f0f24d784d4541645307"],"paragraph_range_zero_based":[24,47],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313553.zip::R2-2313553 - Running CR 38304_CR0368_h60 for NES.docx:p24"}
{"fields":{"filename":"R2-2313553.zip::R2-2313553 - Running CR 38304_CR0368_h60 for NES.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"B","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Rel-18","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-15(Release 15)Rel-16(Release 16)Rel-17(Release 17)Rel-18(Release 18)","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"     Rel-19(Release 19)  ","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"Reason for change:","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"Introduction of the support of legacy UE barring mechanism in Rel-18 Network Energy saving ","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"  RAN2 #123 meeting made below agreements:","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"-One single bit in SIB1 is introduced for controlling all “NES-capable UEs” to access a cell.  FFS what “NES capable UE” bit means.  The NES UE always follows the NES bit used for barring, if present.  If not present the UE shall follow legacy barring.  ","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"-No new cell baring techniques for non-NES UEs will be specified.  ","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"-No new cell re-selection techniques will be considered in this Rel-18","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"RAN2 #123b meeting made below agreements:","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"7151fcbc7e900c013fbd0727f6f458823df19ac33e354f632323a463c862d10e","original_member_sha256":"9be80f761ab1a5a8e2b40c9ef13f4aa84d7d70b3c6af4a740de3e81f68b17102","paragraph_ElementTree_utf8_XML_sha256":["e4ea5591218aa96d0cd407936b651eb165fb4c75e229dab64ec9de6be991cb96","2d00e3b1a82065155328ddd802c3d4a8ebff11f4a0d6da9ecf9b1e34dc8ebfc8","9145b9dad15b04aa997264dfb81e050fe282a558c73d5cee760584ad02f4ef7c","761fa4d36b282591b5f5bb5ee554c6086f6eb9d5925f257d405f142f9e3a17e1","9ee3a8ef1b4d8b5d23ae68c79878f83d9a7ffdf02ec93cff53f7b1de6029f4d6","e66831545870d65e5d9dce29f2931a60a6154caf5c937d9e67a4566572f9a062","b08252b53f111fda758564f01d6aeb287a86ceee9730eba0ca5fcf7c7dadb00e","5397ebe3cc2afa3393b897343a62f60e5b485315d8236802a715ec930f5cc336","35a79586a19ee65775f4dff5cf3a4e432ed8af6387d08e3052dca8d1b5d12e12","0106e51393fc174771c2a0a94af4470e811efe6406e8c4494055730827e58c29","c8cf42343e10e47dd7877f82de3424189a1ec9e7959d0fcb13a919d4d08e7d13","16c8d70f7d429c511b56c375317337c5d5c75b5a185ec91bf088b77069963fb7","acd6206245de4b9556a4853ff1b8b41875944834aa76df6c7d72af763f365262","3c4c80e1e11044a4d07c2d065ab1badcf74a3b84af6435503a27154aade28f9b","dcb78014b5b81157a42c3ffe4194566eb60e8b7a9c66f4647cc04c9ae991d269","8b24573e0133d1c5ee95e1377545628b16380b4d3d980bde5296376e8173041e","7423559940944ed0cc1fe176b76253cf9035dcdbfc0fac2f3e385feb311a2329","288cc60197c635a28716a1c3a9133085106b36b1009fb0a2849670c1b99dfd9f","54c3cca867a1274fa662f6fbd9ecdba673484693dbcaac09d70f3219071531c3","19686bb9a9bfd0280afb83bb5654c9c0121f46bf23bf724283fd07f9dd760988","cab1c20e7dc8571e5d2312eb06e1be5bd3b98da71768c0e772ce6fffd9432152","e1b04a1cb73c0b0955c9c453faa632e493422f41bcb09fead71a86555d16d0a3","bb6d37cb0e03456ce27ddc75c6a6b2dc993e5a9b823c2aa286272dcba4412077","128f02c37fd95688c49a0d72cb86ad1f51d8623e30354d4fb5829ff4c66b30f4"],"paragraph_range_zero_based":[48,71],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313553.zip::R2-2313553 - Running CR 38304_CR0368_h60 for NES.docx:p48"}
{"fields":{"filename":"R2-2313553.zip::R2-2313553 - Running CR 38304_CR0368_h60 for NES.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Agreements for cell reselection:","paragraph_zero_based":72},{"literal_text_all_w_t_and_m_t":"For NES-capable UEs, introduce single code point, meaning not barred.","paragraph_zero_based":73},{"literal_text_all_w_t_and_m_t":"A NES-capable UE in the cell barring context is at least UE supporting cell DTX/DRX.  FFS if other NES features will need to be included only if legacy impact is found.   FFS how we capture it in the CR in terms of wording","paragraph_zero_based":74},{"literal_text_all_w_t_and_m_t":"If the NES UE is barred in the NES cell and the IntraFreqReselection field of the MIB is set to ‘Not Allowed’, the UE cannot reselect to another cell of the same frequency as the barred cell.  If it is set to “Allowed” UE follows intra frequency reselection bit in the MIB.","paragraph_zero_based":75},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":76},{"literal_text_all_w_t_and_m_t":"Based on the agreement, add new barring behavior for NES-capable UE in section 5.3.1. ","paragraph_zero_based":77},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":78},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":79},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":80},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":81},{"literal_text_all_w_t_and_m_t":"Legacy UE barring mechanism of Rel-18 Network Energy saving feature is not supported.","paragraph_zero_based":82},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":83},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":84},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":85},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":86},{"literal_text_all_w_t_and_m_t":"5.3.1","paragraph_zero_based":87},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":88},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":89},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":90},{"literal_text_all_w_t_and_m_t":"Y","paragraph_zero_based":91},{"literal_text_all_w_t_and_m_t":"N","paragraph_zero_based":92},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":93},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":94},{"literal_text_all_w_t_and_m_t":"Other specs","paragraph_zero_based":95}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"7151fcbc7e900c013fbd0727f6f458823df19ac33e354f632323a463c862d10e","original_member_sha256":"9be80f761ab1a5a8e2b40c9ef13f4aa84d7d70b3c6af4a740de3e81f68b17102","paragraph_ElementTree_utf8_XML_sha256":["a52f21546d6decd07b791b1de61f70b1dc53b813b3e8ceaeaf2fa4cc0b41f104","0d0b8c3fe36f42c3444416d9cd0a9c03500beef76cdf033554e87a8416da9cf2","7bbf312ddc7fb4217e062b875b5f05bc28b6aa13c8a5720690cba8334c609891","761e9ac6945b2adbbf9d1158f62a6dc80c1f73af286d258f9a6ff34b8407199f","0a400ac4baabbc2658101113fc37e6744c827c634dcf93df6c3094fc4c22596b","0a32ea0b5525e0549a712e3018e3a7580b68e78ed3899c6895733634810fac77","ed45be790445704d3b812616eeb271552f3b696c645578d972f4d86d19f648d6","23da18bbbcbc650fad7a07ef8006251a7a06ae59113986d1a2b8d37f6d71a8d1","85f9fe225bf206da5b28016fbb39c62cb1368eb1244f4f20547ea6629294dc69","378adf0aa423995360841de5b3ff121413a3320bd55a44c2044b1a4823324310","89960e9b77f090f3572ac60314ccdcf8ddf45690e4740af8a55511f3247367d0","1fae3977ad628ccaaa4ca93bf727a66612ce0c9ef8cd8c6ee1e0c6ec04285297","d3098623b4dfc23a1a4b383cc6c305d01a4c1c56ac54d5853c2f6542bbe0ad3e","d88bc81b05cdcb5373fcefe52e78f5e5b7ea4e37e19c0d9ebb00bb2abbe8ad2d","61cf31ccb32ca743f815831546a63f3d4f37ea5f4ff7e02e623d0e686dc91277","fb15d5d1c7b99db5352fad334b8a000a5a07bfd4cd8b0baad3deb101f45915b9","d3262b1816fab55992cffb02c05a6ffa91b6523e243fbbc95fea56d1d4a60b90","c36