{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The number of cell changes to enter medium mobility state. Corresponds to NCR_M in TS 38.304 [20].","paragraph_zero_based":20640},{"literal_text_all_w_t_and_m_t":"t-Evaluation","paragraph_zero_based":20641},{"literal_text_all_w_t_and_m_t":"The duration for evaluating criteria to enter mobility states. Corresponds to TCRmax in TS 38.304 [20]. Value in seconds, s30 corresponds to 30 s and so on.","paragraph_zero_based":20642},{"literal_text_all_w_t_and_m_t":"t-HystNormal","paragraph_zero_based":20643},{"literal_text_all_w_t_and_m_t":"The additional duration for evaluating criteria to enter normal mobility state. Corresponds to TCRmaxHyst in TS 38.304 [20]. Value in seconds, value s30 corresponds to 30 seconds and so on.","paragraph_zero_based":20644},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20645},{"literal_text_all_w_t_and_m_t":"–MRB-Identity","paragraph_zero_based":20646},{"literal_text_all_w_t_and_m_t":"The IE MRB-Identity is used to identify a multicast MRB used by a UE.","paragraph_zero_based":20647},{"literal_text_all_w_t_and_m_t":"MRB-Identity information element","paragraph_zero_based":20648},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":20649},{"literal_text_all_w_t_and_m_t":"-- TAG-MRB-IDENTITY-START","paragraph_zero_based":20650},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20651},{"literal_text_all_w_t_and_m_t":"MRB-Identity-r17 ::=                    INTEGER (1..512)","paragraph_zero_based":20652},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20653},{"literal_text_all_w_t_and_m_t":"-- TAG-MRB-IDENTITY-STOP","paragraph_zero_based":20654},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":20655},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20656},{"literal_text_all_w_t_and_m_t":"–MsgA-ConfigCommon","paragraph_zero_based":20657},{"literal_text_all_w_t_and_m_t":"The IE MsgA-ConfigCommon is used to configure the PRACH and PUSCH resource for transmission of MsgA in 2-step random access type procedure.","paragraph_zero_based":20658},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":20659},{"literal_text_all_w_t_and_m_t":"-- TAG-MSGACONFIGCOMMON-START","paragraph_zero_based":20660},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20661},{"literal_text_all_w_t_and_m_t":"MsgA-ConfigCommon-r16 ::=           SEQUENCE {","paragraph_zero_based":20662},{"literal_text_all_w_t_and_m_t":"    rach-ConfigCommonTwoStepRA-r16      RACH-ConfigCommonTwoStepRA-r16,","paragraph_zero_based":20663}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["b1d921abf0a1798ad377785cafecabefa7de7cad28227c71452a5d68627ea645","e78706b89c7fb4f463d52cfe9e24301c3c997a25b7c510cbb55184a1d23ab7b0","087f4690bc24888d67f75d921a67b4c93e7cbedd0f9ac34ea99e47ce2903b9f4","5124d737aed18e5565619556a90d2f11b54f1eaa31f5fe5d220e9cafd8556bfa","182d041e82f9ec2e40b28d003510b3753d181ed0ef550ad79e21b047c4e517c9","a1170f8c29c5dae5723e6bc1826576e8787674aee8f3836f3f83c28807343b38","de0242fae74abb4a75aa550bd6f05c596df5b6ad7f7dd43264c953b9801a5485","4ead4aa799754b3a294c5aacada56b731bc02a63842b9ce4f7d2ec0b18903e85","4ebf631b10fd3431cc96eafe21fa4ed9ff1cca2e764bc79eaf6b57addd827d5c","120266e7a42910902b07f1a001029ae8c583fc5ba5304d288926acb69d345fd4","6b26ce2d320219cb4cd62528ebd9b5d6ce4fb66072f44aa77e324982f0b60443","08ffae981930454618b86230c3cda4e511c0554efc5bea2991efaaa4110df381","7d949e27e090237a46f64a59f3f607dcbfe50b2337075a598779f5c1e9fd65cc","4c33c84042a5b87a08ef