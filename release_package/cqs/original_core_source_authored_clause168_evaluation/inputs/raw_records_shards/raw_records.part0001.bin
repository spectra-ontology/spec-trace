{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10224},{"literal_text_all_w_t_and_m_t":"RRCReconfigurationComplete ::=              SEQUENCE {","paragraph_zero_based":10225},{"literal_text_all_w_t_and_m_t":"    rrc-TransactionIdentifier                   RRC-TransactionIdentifier,","paragraph_zero_based":10226},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                          CHOICE {","paragraph_zero_based":10227},{"literal_text_all_w_t_and_m_t":"        rrcReconfigurationComplete                  RRCReconfigurationComplete-IEs,","paragraph_zero_based":10228},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture                    SEQUENCE {}","paragraph_zero_based":10229},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":10230},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":10231},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10232},{"literal_text_all_w_t_and_m_t":"RRCReconfigurationComplete-IEs ::=          SEQUENCE {","paragraph_zero_based":10233},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension                    OCTET STRING                                                            OPTIONAL,","paragraph_zero_based":10234},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                        RRCReconfigurationComplete-v1530-IEs                                    OPTIONAL","paragraph_zero_based":10235},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":10236},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10237},{"literal_text_all_w_t_and_m_t":"RRCReconfigurationComplete-v1530-IEs ::=    SEQUENCE {","paragraph_zero_based":10238},{"literal_text_all_w_t_and_m_t":"    uplinkTxDirectCurrentList                   UplinkTxDirectCurrentList                                               OPTIONAL,","paragraph_zero_based":10239},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                        RRCReconfigurationComplete-v1560-IEs                                    OPTIONAL","paragraph_zero_based":10240},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":10241},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10242},{"literal_text_all_w_t_and_m_t":"RRCReconfigurationComplete-v1560-IEs ::=    SEQUENCE {","paragraph_zero_based":10243},{"literal_text_all_w_t_and_m_t":"    scg-Response                                CHOICE {","paragraph_zero_based":10244},{"literal_text_all_w_t_and_m_t":"        nr-SCG-Response                             OCTET STRING (CONTAINING RRCReconfigurationComplete),","paragraph_zero_based":10245},{"literal_text_all_w_t_and_m_t":"        eutra-SCG-Response                          OCTET STRING","paragraph_zero_based":10246},{"literal_text_all_w_t_and_m_t":"    }                                                                                                                       OPTIONAL,","paragraph_zero_based":10247}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["d5d81a3d89f282adbe204c44a4145aee844369e92c9d1ae50998333e8cb633da","bb8c2f38baf7096810bb3f4d6af81962a3b6e13b32befe6ce58f4209acbc1e3f","427d1e29922ff2f402a2065fa219da1dac66182a9e1c7fc6c158b71d1e0fe68e","b93b39e807268fcfe9f11a9f9e865499a83c5ac92865fe167a5dcef4b3c018f7","1fe3da52ff77f5da67f5c5475b01326f1409850b65ca9bf4d811dd482f317191","0885152d79968f5783c2f696dcd3a8474a18e49818aea1f360441d967cac99df","4e099199c090a57704c1d90f4f3f09ff93aa45e46376c2ebc5aa5abb2b117b46","7dfa9a0cf15375702b478adf27cff2d2a2b8ffe07176a9567cf05fb30ba348e8","180c42f85780d43e1