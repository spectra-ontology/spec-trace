{"fields":{"filename":"R2-2401569.zip::R2-2401569 RRC corrections for XR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>stop all instances of timer T346c, if running;","paragraph_zero_based":4560},{"literal_text_all_w_t_and_m_t":"1>release maxMIMO-LayerPreferenceConfig and maxMIMO-LayerPreferenceConfigFR2-2 for all configured cell groups from the UE Inactive AS context, if stored;","paragraph_zero_based":4561},{"literal_text_all_w_t_and_m_t":"1>stop all instances of timer T346d, if running;","paragraph_zero_based":4562},{"literal_text_all_w_t_and_m_t":"1>release minSchedulingOffsetPreferenceConfig and minSchedulingOffsetPreferenceConfigExt for all configured cell groups from the UE Inactive AS context, if stored;","paragraph_zero_based":4563},{"literal_text_all_w_t_and_m_t":"1>stop all instances of timer T346e, if running;","paragraph_zero_based":4564},{"literal_text_all_w_t_and_m_t":"1>release rlm-RelaxationReportingConfig for all configured cell groups from the UE Inactive AS context, if stored;","paragraph_zero_based":4565},{"literal_text_all_w_t_and_m_t":"1>stop all instances of timer T346j, if running;","paragraph_zero_based":4566},{"literal_text_all_w_t_and_m_t":"1>release bfd-RelaxationReportingConfig for all configured cell groups from the UE Inactive AS context, if stored;","paragraph_zero_based":4567},{"literal_text_all_w_t_and_m_t":"1>stop all instances of timer T346k, if running;","paragraph_zero_based":4568},{"literal_text_all_w_t_and_m_t":"1>release releasePreferenceConfig from the UE Inactive AS context, if stored;","paragraph_zero_based":4569},{"literal_text_all_w_t_and_m_t":"1>release wlanNameList from the UE Inactive AS context, if stored;","paragraph_zero_based":4570},{"literal_text_all_w_t_and_m_t":"1>release btNameList from the UE Inactive AS context, if stored;","paragraph_zero_based":4571},{"literal_text_all_w_t_and_m_t":"1>release sensorNameList from the UE Inactive AS context, if stored;","paragraph_zero_based":4572},{"literal_text_all_w_t_and_m_t":"1>release obtainCommonLocation from the UE Inactive AS context, if stored;","paragraph_zero_based":4573},{"literal_text_all_w_t_and_m_t":"1>stop timer T346f, if running;","paragraph_zero_based":4574},{"literal_text_all_w_t_and_m_t":"1>stop timer T346i, if running;","paragraph_zero_based":4575},{"literal_text_all_w_t_and_m_t":"1>release referenceTimePreferenceReporting from the UE Inactive AS context, if stored;","paragraph_zero_based":4576},{"literal_text_all_w_t_and_m_t":"1>release sl-AssistanceConfigNR from the UE Inactive AS context, if stored;","paragraph_zero_based":4577},{"literal_text_all_w_t_and_m_t":"1>release musim-GapAssistanceConfig from the UE Inactive AS context, if stored and stop timer T346h, if running;","paragraph_zero_based":4578},{"literal_text_all_w_t_and_m_t":"1>release musim-GapConfig from the UE Inactive AS context, if stored;","paragraph_zero_based":4579},{"literal_text_all_w_t_and_m_t":"1>release musim-GapPriorityAssistanceConfig from the UE Inactive AS context, if stored;","paragraph_zero_based":4580},{"literal_text_all_w_t_and_m_t":"1>release musim-LeaveAssistanceConfig from the UE Inactive AS context, if stored;","paragraph_zero_based":4581},{"literal_text_all_w_t_and_m_t":"1>release musim-CapabilityRestrictionConfig from the UE Inactive AS context, if stored and stop timer T346n, if running;","paragraph_zero_based":4582},{"literal_text_all_w_t_and_m_t":"1>release propDelayDiffReportConfig from the UE Inactive AS context, if stored;","paragraph_zero_based":4583}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"b3775a5d14ac021fc4f5f3e8002b92527fa1c052d9b7c535f196b5410b17f720","original_member_sha256":"0b2b1acef7c2981dcae001f9ad768411cade15b8ef16fbb988748fdb44fd8de1","paragraph_ElementTree_utf8_XML_sha256":["3be64842dfb007511f9dac215783d149425b