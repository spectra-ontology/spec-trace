,","paragraph_zero_based":17920},{"literal_text_all_w_t_and_m_t":"    payloadSizeDCI-2-7-r17                    INTEGER (1..maxDCI-2-7-Size-r17),","paragraph_zero_based":17921},{"literal_text_all_w_t_and_m_t":"    pei-FrameOffset-r17                       INTEGER (0..16),","paragraph_zero_based":17922},{"literal_text_all_w_t_and_m_t":"    subgroupConfig-r17                        SubgroupConfig-r17,","paragraph_zero_based":17923},{"literal_text_all_w_t_and_m_t":"    lastUsedCellOnly-r17                      ENUMERATED {true}                                                OPTIONAL,  -- Need R","paragraph_zero_based":17924},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":17925},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":17926},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17927}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["378ca8f9fad6f604ce2859d41f3714468e988ae5bb1e6759078ca7b0b25cb070","9298fde6976b5a470cc89d80104cc3d8ddeaf0d2fe407b1fdebfaf63859a8485","c2a93f6d1c3184b306bef472794336ec6d448bcca5e0511953c6154d01f8a170","dcaa8a7bebcf9fa765bc3cac059df249bf609fcef89200258cbdb86a708d3b31","d13eca526f1155a42dd3bbb93ca654ac5d9257b8aea0b29917034728614c0d27","5ed62165439bb4ed40b8eed0ccfe15a7f1f1c6ab1a07e9bf1c8e032aa90c9f16","065c88d2dbce5984572eab5faecf048762d309e44ec0e70df35c0d50b390ea86","8beb5a93784c9fa265dcd72284c1ad7b0762ec008d9722eb8c33c5638e707de3","f7f67db68e011a61c551aaa951b23625e83904fe1a02b8e3af13b94758c374ef","2a04e29967fc9ac5054bcbafbfc5b4a9cff6a9f40d930f7588da354dddd44c37","c0a3d5ebb534602d58200e2cf2b9dc560346176cfbf6cae0d329798b6d684402","10405d19ccd119aa0d25a8a5aabbaac15a43cee44d678d4653f88c9a04a1453b","9b289bfe098c231184a1672a0a2bd70d6c73bfd8487fd96f4e38712002951f21","eeaad82134829201e77401e237ec32c79a956f231750a8168bc199cb8fe4b23b","e46be8f966d97092734528eaf686c8dc347d2346c8bebb31ccd45b9dce5ea67e","717094fbe351b937b20f2b76fc9e16b8eb3e6edbaf690d1bf4ff2b3bec81f464","ddedac432f98c5d53da9ad9c82d229404b00c80cdb6090a35fc8d0e0123edeba","db5e5983c0eb112103be65f0c5101b13f6baec6c6fbad1668caf049d23aee47d","5fa0ca3f8d8c7c28cf8312cba0faad19e4a13129de75762e3652d4117364a2d1","45205f32d30b1e93da4273b03cc821a7677c9198975493f5c6dd2ee21e339986","68e50ca380ff77b1c57bb3e74d9bd6037b2e484ce7e472f7859e40f21ebad09e","dd3bd1a174e7fe8182aba97d922077f5fcebf8060109185ee4a697915f996ce8","695c28e311153686b9aaeb51b5d655c9fb4544035b1bd0ba9b1866244067e652","478013a2b55fd79fceb3de870977228f777dbdb9d21960f3000f11b563fe8cea"],"paragraph_range_zero_based":[17904,17927],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p17904"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SubgroupConfig-r17 ::=     SEQUENCE {","paragraph_zero_based":17928},{"literal_text_all_w_t_and_m_t":"    subgroupsNumPerPO-r17      INTEGER (1.. maxNrofPagingSubgroups-r17),","paragraph_zero_based":17929},{"literal_text_all_w_t_and_m_t":"    subgroupsNumForUEID-r17    INTEGER (1.. maxNrofPagingSubgroups-r17)                                        OPTIONAL,  -- Need S","paragraph_zero_based":17930},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":17931},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":17932},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17933},{"literal_text_all_w_t_and_m_t":"-- TAG-DOWNLINKCONFIGCOMMONSIB-STOP","paragraph_zero_based":17934},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17935},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17936},{"literal_text_all_w_t_and_m_t":"DownlinkConfigCommonSIB field descriptions","paragraph_zero_based":17937},{"literal_text_all_w_t_and_m_t":"bcch-Config","paragraph_zero_based":17938},{"literal_text_all_w_t_and_m_t":"The modification period related configuration.","paragraph_zero_based":17939},{"literal_text_all_w_t_and_m_t":"frequencyInfoDL-SIB","paragraph_zero_based":17940},{"literal_text_all_w_t_and_m_t":"Basic parameters of a downlink carrier and transmission thereon.","paragraph_zero_based":17941},{"literal_text_all_w_t_and_m_t":"initialDownlinkBWP","paragraph_zero_based":17942},{"literal_text_all_w_t_and_m_t":"The initial downlink BWP configuration for a PCell. The network configures the locationAndBandwidth so that the initial downlink BWP contains the entire CORESET#0 of this serving cell in the frequency domain. The UE applies the locationAndBandwidth upon reception of this field (e.g. to determine the frequency position of signals described in relation to this locationAndBandwidth) but it keeps CORESET#0 until after reception of RRCSetup/RRCResume/RRCReestablishment.","paragraph_zero_based":17943},{"literal_text_all_w_t_and_m_t":"initialDownlinkBWP-RedCap","paragraph_zero_based":17944},{"literal_text_all_w_t_and_m_t":"If present, RedCap UEs use this DL BWP instead of initialDownlinkBWP. If the locationAndBandwidth of this BWP contains the entire CORESET#0, the UE applies the locationAndBandwidth upon reception of this field (e.g. to determine the frequency position of signals described in relation to this locationAndBandwidth) but it keeps CORESET#0 until after reception of RRCSetup/RRCResume/RRCReestablishment. Otherwise, i.e., if the locationAndBandwidth of this BWP does not contain the entire CORESET#0, the UE uses this BWP for receiving DL messages during initial access (Msg2, MsgB, Msg4) and after initial access.","paragraph_zero_based":17945},{"literal_text_all_w_t_and_m_t":"If absent, RedCap UEs use initialDownlinkBWP provided that it does not exceed the RedCap UE maximum bandwidth (see also clause 5.2.2.4.2).","paragraph_zero_based":17946},{"literal_text_all_w_t_and_m_t":"lastUsedCellOnly","paragraph_zero_based":17947},{"literal_text_all_w_t_and_m_t":"When present, the field indicates that the UE monitors PEI only if the latest received RRCRelease without noLastCellUpdate is from this cell. A PEI-capable UE stores its last used cell information.","paragraph_zero_based":17948},{"literal_text_all_w_t_and_m_t":"nrofPDCCH-MonitoringOccasionPerSSB-InPO","paragraph_zero_based":17949},{"literal_text_all_w_t_and_m_t":"The number of PDCCH monitoring occasions corresponding to an SSB within a Paging Occasion, see TS 38.304 [20], clause 7.1.","paragraph_zero_based":17950},{"literal_text_all_w_t_and_m_t":"pcch-Config","paragraph_zero_based":17951}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["66eac3337534837d0ac2db8c7d88518c0d49f6a242bedb87ba41c27ffc8f075f","ba7f418815508c8051adb6a40baa58eec3410963beb93d6c739ad642cf2212e2","9b1f085f04e9d35d929827b574f58d75391ba509514c5f8ef2d7cbf270f058c5","90ca174f553be14f2c71eff5e1add9bd9932a24f33a62e16f4c716112fc793cd","13f68192937c1dacad858ba501dfce0f8bb877cd3fc2dd23227d3e850b839544","0ca634123c2860b118eb1b2a99d06070190fd5dbc090f44f4149230eddf95ec3","88be581d8130903b9e23604ab91eb16dcbb49f6c2508a43a5c556e0364c5e33d","dd03ad8aeee1df0d5be1958b5c2b272c111a7fc29ed70a67ad02af425ebb57bc","976f35a1ce659c248556a1d63c3219d8bb3e4afdc2c721ed0feaafa5cf75a39d","38a65e3a8188b613a698f1e2b7f2fbcaec8083f06c4826e00067ecddc5e3358e","721019122f165c717f58332cf8d8e74ad77096e2adf534fd8800d627a8daaca0","869087a959fe222bccf814581999bc2ae2e0ea4e1c09c16ffa314da66814f529","43b4aeb097cd6498636220b6fbee899829f9ea9eebc3226ad99f0e02498e0d67","494f0cc82edd6b02f99cbf66300e3f042b28283eb4f19bda834ad9792dc60eaf","3921c45351aa3abc8b42e00528e0d5cc54fc38db0690554b3c300e5665e335f6","5b139bcb037183fb86499dca67074e555f4a8a1a4a45fd2a4292413cd2d40532","9212606cf595f02b1fa4ba2e05a6bda97d84431d5e842e8cf51bec02622b6b9c","030584ae82d49e2f5213925d5fe01c019ef4d9b2dadd631eac8cc3297d861f26","00d251da2c22e3cfd92f3f31f9d39d43f3e44c3bb98229002e1289f28b468181","26a0f84749c5a8c2e63546916d5c3971c7d8382b002405b8aaa25ac38c6faba8","828a82e8ade7b24aaf45197f7a472d0a22eedc929654f848e4695df1ac99fdec","954609196ba12dadca7c17da5e24c8eb58f7748bb957dafffaa34b822f7785c1","3cb60d8f2b05bb8b2b583033fa576ce17754f4631416813bf36270d8edca168e","f3d799bbfd97f6a1f3ea4940e83bff88da08469a02b8fb64c5cb6701153af35e"],"paragraph_range_zero_based":[17928,17951],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p17928"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The paging related configuration.","paragraph_zero_based":17952},{"literal_text_all_w_t_and_m_t":"pei-Config","paragraph_zero_based":17953},{"literal_text_all_w_t_and_m_t":"The PEI related configuration.","paragraph_zero_based":17954},{"literal_text_all_w_t_and_m_t":"subgroupConfig","paragraph_zero_based":17955},{"literal_text_all_w_t_and_m_t":"The paging subgroup related configuration.","paragraph_zero_based":17956},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17957},{"literal_text_all_w_t_and_m_t":"BCCH-Config field descriptions","paragraph_zero_based":17958},{"literal_text_all_w_t_and_m_t":"modificationPeriodCoeff","paragraph_zero_based":17959},{"literal_text_all_w_t_and_m_t":"Actual modification period, expressed in number of radio frames m = modificationPeriodCoeff * defaultPagingCycle, see clause 5.2.2.2.2. n2 corresponds to value 2, n4 corresponds to value 4, and so on.","paragraph_zero_based":17960},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17961},{"literal_text_all_w_t_and_m_t":"PCCH-Config field descriptions","paragraph_zero_based":17962},{"literal_text_all_w_t_and_m_t":"defaultPagingCycle","paragraph_zero_based":17963},{"literal_text_all_w_t_and_m_t":"Default paging cycle, used to derive 'T' in TS 38.304 [20]. Value rf32 corresponds to 32 radio frames, value rf64 corresponds to 64 radio frames and so on.","paragraph_zero_based":17964},{"literal_text_all_w_t_and_m_t":"firstPDCCH-MonitoringOccasionOfPO","paragraph_zero_based":17965},{"literal_text_all_w_t_and_m_t":"Points out the first PDCCH monitoring occasion for paging of each PO of the PF, see TS 38.304 [20].","paragraph_zero_based":17966},{"literal_text_all_w_t_and_m_t":"nAndPagingFrameOffset","paragraph_zero_based":17967},{"literal_text_all_w_t_and_m_t":"Used to derive the number of total paging frames in T (corresponding to parameter N in TS 38.304 [20]) and paging frame offset (corresponding to parameter PF_offset in TS 38.304 [20]). A value of oneSixteenthT corresponds to T / 16, a value of oneEighthT corresponds to T / 8, and so on.","paragraph_zero_based":17968},{"literal_text_all_w_t_and_m_t":"If pagingSearchSpace is set to zero and if SS/PBCH block and CORESET multiplexing pattern is 2 or 3 (as specified in TS 38.213 [13]):","paragraph_zero_based":17969},{"literal_text_all_w_t_and_m_t":"-for ssb-periodicityServingCell of 5 or 10 ms, N can be set to one of {oneT, halfT, quarterT, oneEighthT, oneSixteenthT}","paragraph_zero_based":17970},{"literal_text_all_w_t_and_m_t":"-for ssb-periodicityServingCell of 20 ms, N can be set to one of {halfT, quarterT, oneEighthT, oneSixteenthT}","paragraph_zero_based":17971},{"literal_text_all_w_t_and_m_t":"-for ssb-periodicityServingCell of 40 ms, N can be set to one of {quarterT, oneEighthT, oneSixteenthT}","paragraph_zero_based":17972},{"literal_text_all_w_t_and_m_t":"-for ssb-periodicityServingCell of 80 ms, N can be set to one of {oneEighthT, oneSixteenthT}","paragraph_zero_based":17973},{"literal_text_all_w_t_and_m_t":"-for ssb-periodicityServingCell of 160 ms, N can be set to oneSixteenthT","paragraph_zero_based":17974},{"literal_text_all_w_t_and_m_t":"If pagingSearchSpace is set to zero and if SS/PBCH block and CORESET multiplexing pattern is 1 (as specified in TS 38.213 [13]), N can be set to one of {halfT, quarterT, oneEighthT, oneSixteenthT}","paragraph_zero_based":17975}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["c8a59febfc926c848c93f0bfb5930acf72cbbff4226d16245cd94cb22a1a20fa","8e729a3e40cbd2916d284a4cb485cc072fef1bce001f2b5320244e047ea772cb","9bed6815cef0dc0b53aeae5c6c262a801c9ad699d185dd703bdc007c89db15e2","517534e94d25b7588e8f6218c67d2136b925efcb2582933899d7398c83beee15","03d5caf1a357f7819e7ce799f8811b6d85affb5124724566e935888776b35f36","e3edcfc8b9617ca7617da9aa5f7db6ee1c330b57c0300156c657a8a748e5ccd3","bd1a9a88c9466defb066614d0da46eae7af2a3ca438cb917f51241f334c2b28f","32b3e74c88d9d5ed1da0fad33c6204bfaf13c0019b698bbdfeed249c86190c54","f11ec87bcee7d7a40309da616a0285891939499134ed43a8634c9ad5a341f866","e04b3be196f997c0467cb5577c8d349e88f0cad3ef0d389a84ad4ffb3f93dd20","52e77bb19e9c67d96a3fc15a3079f938df3f7baa388be1e42c6de16a5cfecd56","e6601caa1c6dfb070220220eaa13ba955d6f3fd6e3d2329200dcddbc2c2634b1","59cdf47bf71d290aa0593b2dd66f07a52b7a47ddb08e5eac68f5b9fab517b74a","123b3b7252a24efcc401a9130b53945f41503cab7a5e00ced1f0b88fc4b25bdf","cce6ad638148f381b9fdf18fba6020ceaf3daf306f073910beac4547ec1ee5fe","9e71753472531c8298ecc0b01d7199caac5031a9ebbefef8eae0dd952a6ee297","f8c462209669b93d840bc29afb81d896a7985f2067526e569d994ce4eb949a0b","1ea7a702b86033d0fd4f394de3d074bfd6236623714b9d96b9089faad675e53f","8365c742b595e1b3e00c31f7d938b99031c53d1654557900b46251be0f483698","86795ee5e08ceec051b76d036a3f9f8f4cedce149e4373b55a9f6d5823fee3f0","41d2187793b454495f8eab4556bb0ce0d9a88c9986e89f7e3a799794cb656ced","a53954a058d774c49b47be729ff4c8b34d3c24eae33eb217c8b9a08418bbb507","e9c2a657864f69431fcfba73b2d746c20d6fb74578401612e5db8b84f8f90ea9","4c034aeb21c37df98a885f53c97cb73a60d7d2137794950ec6a1e159637c9e3d"],"paragraph_range_zero_based":[17952,17975],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p17952"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"If pagingSearchSpace is not set to zero, N can be configured to one of {oneT, halfT, quarterT, oneEighthT, oneSixteenthT}","paragraph_zero_based":17976},{"literal_text_all_w_t_and_m_t":"ns","paragraph_zero_based":17977},{"literal_text_all_w_t_and_m_t":"Number of paging occasions per paging frame.","paragraph_zero_based":17978},{"literal_text_all_w_t_and_m_t":"ranPagingInIdlePO","paragraph_zero_based":17979},{"literal_text_all_w_t_and_m_t":"Indicates that the network supports to send RAN paging in PO that corresponds to the i_s as determined by UE in RRC_IDLE state, see TS38.304 [20].","paragraph_zero_based":17980},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17981},{"literal_text_all_w_t_and_m_t":"PEI-Config field descriptions","paragraph_zero_based":17982},{"literal_text_all_w_t_and_m_t":"payloadSizeDCI-2-7","paragraph_zero_based":17983},{"literal_text_all_w_t_and_m_t":"Payload size of PEI DCI, i.e., DCI format 2_7. The size is no larger than the payload size of paging DCI which has maximum of 41 bits and 43 bits for licensed and unlicensed spectrums, respectively.","paragraph_zero_based":17984},{"literal_text_all_w_t_and_m_t":"pei-FrameOffset","paragraph_zero_based":17985},{"literal_text_all_w_t_and_m_t":"Offset, in number of frames from the start of a reference frame for PEI-O to the start of a first paging frame of the paging frames associated with the PEI-O, see TS 38.213 [13], clause 10.4A.","paragraph_zero_based":17986},{"literal_text_all_w_t_and_m_t":"po-NumPerPEI","paragraph_zero_based":17987},{"literal_text_all_w_t_and_m_t":"The number of PO(s) associated with one PEI monitoring occasion. It is a factor of the total PO number in a paging cycle, i.e N x Ns, as specified in TS 38.304 [20]. The maximum number of PF associated with one PEI monitoring occasion is 2. The number of PO mapping to one PEI should be multiple of Ns when po-NumPerPEI is larger than Ns.","paragraph_zero_based":17988},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17989},{"literal_text_all_w_t_and_m_t":"SubgroupConfig field descriptions","paragraph_zero_based":17990},{"literal_text_all_w_t_and_m_t":"subgroupsNumPerPO","paragraph_zero_based":17991},{"literal_text_all_w_t_and_m_t":"Total number of subgroups per Paging Occasion (PO) for UE to read subgroups indication from physical-layer signaling. The field represents the sum of CN-assigned and UEID-based subgroups supported by the network. When PEI-Config is configured, there is always at least one subgroup (UEID-based subgroup or CN-assigned subgroup) configured.","paragraph_zero_based":17992},{"literal_text_all_w_t_and_m_t":"subgroupsNumForUEID","paragraph_zero_based":17993},{"literal_text_all_w_t_and_m_t":"Number of subgroups per Paging Occasion (PO) for UE to read subgroups indication from physical-layer signaling, for UEID-based subgrouping method. When present, the field is set to an integer smaller than or equal to subgroupsNumPerPO. subgroupsNumPerPO equals to subgroupsNumForUEID when the network does not configure CN-assigned subgrouping. When pei-Config is configured, the field is absent when the network only configures CN-assigned subgrouping. Both this field and subgroupsNumPerPO are equal to 1 when the network does not configure subgrouping. When pei-Config is configured, if the field is absent, the UE uses subgrouping according to TS 38.304 [20], clause 7.3.0.","paragraph_zero_based":17994},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17995},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":17996},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":17997},{"literal_text_all_w_t_and_m_t":"SharedSpectrum2","paragraph_zero_based":17998},{"literal_text_all_w_t_and_m_t":"The field is optional present, Need R, if this cell operates with shared spectrum channel access. Otherwise, it is absent, Need R.","paragraph_zero_based":17999}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["9e1600351b6859f7cc401b05bc740f3882f17ee3ca574bbcda9c9db702d5c694","8e164b2daf0fe24b8dc4cc8f803808499e72506d2d29095870b486409b9a7452","4aad72ea82bbd6f552929f5436a4202634cafd5b58100c8b415187dfdca76229","b7455e2ae07d6a2eb55bfcd48c780cfcdd2f7aedc6a784b4bcdc1846561f83e1","b120b3f3829f409f2af282610ee3f4150de705efb101a7acbf85b13867a2aff5","68083786cd6ae4433d1ee8c61f8a26ad5223a6b39aa07ffcf95ef67672d878f5","5f16905e40ad52ce0683aba95daeeff17feb7f9b5018a875875d40f56e0d33df","5e459c6ab61052535232c0ccc4eb8761a999eb739a5f97dba696b6eb2cb0fdca","c9c3db26ee687401c483c8d32318662d1ce7d7943e6ba5387412b10e15d6d04d","76bbdfdb5900fc2eebf6fabb19d0675459d0ac1bfe611d843f9dc7019751bd4d","8132b94aac654de7de710a2fee00ebbe4a4137767677421257d5880957d0a7a2","d1bac2a4306448d82c5ab6b7c35a28382eecf99c9faba11425b4b72db6b9a4b9","1c3cf5f5da26ab3645a63800513c360d534cb07faaf7f530201f3a71ae622e63","0615f31e92fff560c0625311e08eb170797da3e8d16ffbeee4a5657bcc3c6863","e4451f2eea952c283514838be9d693261c1be9bf4269f24eb8181206c447a1f2","b0afd6a03ac930bb9fc29c29ecc0e30c0d60a9be99b65c5ea16a76573ab77c94","5d0744b9b81c726e08a483e86249681d7ee20aecc30cc70671300efe63c12956","abf99c9a153ab2d6fbff34effd85dd7f38401b0347bedf23890c33f6fe9d67dc","9f2c68ac97a9b16a84b7bdeab2b7884d7485a0ea4782bd458e0eea9cf40bfab9","6d3620bb52ba1f1465a8460870e4e1ca988f9372e1ff30d2943e19882a2ad661","c51a37cc7f710759102235f1cc7fc7223a215d72991e8d358779831bb8728be7","ec1343cc6d627a267d72cdcb117c6fadbf8668529670525a436e795554fcbe27","658a8abae5f0f33b14ea19320372bc011bc4558ac5e68af9