{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    slotFormatIndicator                 SetupRelease { SlotFormatIndicator }                                OPTIONAL,   -- Need M","paragraph_zero_based":22008},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":22009},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":22010},{"literal_text_all_w_t_and_m_t":"    availabilityIndicator-r16           SetupRelease {AvailabilityIndicator-r16}                            OPTIONAL,   -- Need M","paragraph_zero_based":22011},{"literal_text_all_w_t_and_m_t":"    searchSpaceSwitchTimer-r16          INTEGER (1..80)                                                     OPTIONAL    -- Need R","paragraph_zero_based":22012},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":22013},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":22014},{"literal_text_all_w_t_and_m_t":"    searchSpaceSwitchTimer-v1710        INTEGER (81..1280)                                                  OPTIONAL    -- Need R","paragraph_zero_based":22015},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":22016},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22017},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22018},{"literal_text_all_w_t_and_m_t":"-- TAG-PDCCH-SERVINGCELLCONFIG-STOP","paragraph_zero_based":22019},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":22020},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22021},{"literal_text_all_w_t_and_m_t":"PDCCH-ServingCellConfig field descriptions","paragraph_zero_based":22022},{"literal_text_all_w_t_and_m_t":"availabilityIndicator","paragraph_zero_based":22023},{"literal_text_all_w_t_and_m_t":"Use to configure monitoring a PDCCH for Availability Indicators (AI).","paragraph_zero_based":22024},{"literal_text_all_w_t_and_m_t":"searchSpaceSwitchTimer","paragraph_zero_based":22025},{"literal_text_all_w_t_and_m_t":"The value of the timer in slots for monitoring PDCCH in the active DL BWP of the serving cell before moving to the default search space group (see TS 38.213 [13], clause 10.4).","paragraph_zero_based":22026},{"literal_text_all_w_t_and_m_t":"For 15 kHz SCS, {1..20} are valid.","paragraph_zero_based":22027},{"literal_text_all_w_t_and_m_t":"For 30 kHz SCS, {1..40} are valid.","paragraph_zero_based":22028},{"literal_text_all_w_t_and_m_t":"For 60kHz SCS, {1..80} are valid.","paragraph_zero_based":22029},{"literal_text_all_w_t_and_m_t":"For 120 kHz SCS, {1..160} are valid.","paragraph_zero_based":22030},{"literal_text_all_w_t_and_m_t":"For 480 kHz SCS, {1..640} are valid.","paragraph_zero_based":22031}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["1921b0f53de75d0214edca69676efc4e6f6325390abcfeed7207613787bee1b4","3cc57f58451e8006b8f9d784098e3325667c81bd893a121fc2c36e5acd143010","740376ff38a19e7ed005d26b61b9ff5fc705fbe388f18fc09d85b272977fb5e6","d15b5f938198861bb556c5a7c8087999c76a300cfa7a858ffebcd23bb653dcb9","5c03954453629b12380ae958dfc2e2ad7833cb70ed5f908999fbd579fcbeaa1e","d589c86baff81b2acc7d9a188026e4572718acddce7dd2e32705f568c313397b","0c530968d85dd47c332a3d60483c76bab315d9d1962bc958c714861958f83d6e","cca394a90ba25eb4d705a38bf3c0d812487ae21a39c0916b23658e6eab182fe8","f0f60a9f82ea89ec642ab07dff8def9b50cdbe130b085e862f3953fb4477f382","44f4bac0c5a787d48153ece782e8dff0619d582fd54eec194d69732f6da81561","05f27f755e0fca11e12a516508672018517efc1d0b0282848ec74626cccfb193","aa40377de5bd1389111b22d07f6ccea960e546340fc34068a083516d0c0affe9","fb9dede6b696