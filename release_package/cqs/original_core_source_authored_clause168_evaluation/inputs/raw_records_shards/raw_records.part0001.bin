{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Direction: Network to UE","paragraph_zero_based":10680},{"literal_text_all_w_t_and_m_t":"RRCResume message","paragraph_zero_based":10681},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":10682},{"literal_text_all_w_t_and_m_t":"-- TAG-RRCRESUME-START","paragraph_zero_based":10683},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10684},{"literal_text_all_w_t_and_m_t":"RRCResume ::=                       SEQUENCE {","paragraph_zero_based":10685},{"literal_text_all_w_t_and_m_t":"    rrc-TransactionIdentifier           RRC-TransactionIdentifier,","paragraph_zero_based":10686},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                  CHOICE {","paragraph_zero_based":10687},{"literal_text_all_w_t_and_m_t":"        rrcResume                           RRCResume-IEs,","paragraph_zero_based":10688},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture            SEQUENCE {}","paragraph_zero_based":10689},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":10690},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":10691},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10692},{"literal_text_all_w_t_and_m_t":"RRCResume-IEs ::=                   SEQUENCE {","paragraph_zero_based":10693},{"literal_text_all_w_t_and_m_t":"    radioBearerConfig                   RadioBearerConfig                                               OPTIONAL, -- Need M","paragraph_zero_based":10694},{"literal_text_all_w_t_and_m_t":"    masterCellGroup                     OCTET STRING (CONTAINING CellGroupConfig)                       OPTIONAL, -- Need M","paragraph_zero_based":10695},{"literal_text_all_w_t_and_m_t":"    measConfig                          MeasConfig                                                      OPTIONAL, -- Need M","paragraph_zero_based":10696},{"literal_text_all_w_t_and_m_t":"    fullConfig                          ENUMERATED {true}                                               OPTIONAL, -- Need N","paragraph_zero_based":10697},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension            OCTET STRING                                                    OPTIONAL,","paragraph_zero_based":10698},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                RRCResume-v1560-IEs                                             OPTIONAL","paragraph_zero_based":10699},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":10700},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10701},{"literal_text_all_w_t_and_m_t":"RRCResume-v1560-IEs ::=             SEQUENCE {","paragraph_zero_based":10702},{"literal_text_all_w_t_and_m_t":"    radioBearerConfig2                  OCTET STRING (CONTAINING RadioBearerConfig)                     OPTIONAL, -- Need M","paragraph_zero_based":10703}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["92d7fb0ac81440f5f6569d703abee466d2565164d846819c0408b3473111ddd6","b560f21295fe9c7ee1c3c10b3ae43b84f283a349f3c7ce07b98b36daaeee7b10","d42f8c9daa123a39083099b0c7940cc6f2177a12a32d3c3eff4d45f9225248bc","a4fa172fc8d9996c8341e3a833cefe05a7b297bfd159ccf2dccb5fd09ca17678","ca784868f5dd49def770a9aafe82c11045ac6852b3b0816fbfc70bbbb9277361","dceaa07c6a8686ae7f92fdc7734497a4ef75bc065645438a02382d13f0207cf7","ea9e51ee197f8e04f5e01bcbd7c99b997aeb4ae50a2946e4e3c7b94801ef00f8","485da58e17640f5d68bdd28bfa8cfcdb36a066574caafa94a68e589b8382e5be","898ea45b0362353e4a31eb8bc47c014733ef4f444d7ac18baa0e46a47c8448b6","d16cad10c07e761bcd9215b7f03044e222b