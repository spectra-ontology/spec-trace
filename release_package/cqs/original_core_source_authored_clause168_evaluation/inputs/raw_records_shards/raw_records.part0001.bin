{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        ms5120                              INTEGER(0..5119),","paragraph_zero_based":15168},{"literal_text_all_w_t_and_m_t":"        ms10240                             INTEGER(0..10239)","paragraph_zero_based":15169},{"literal_text_all_w_t_and_m_t":"    }                                                                                    OPTIONAL,  -- Need M","paragraph_zero_based":15170},{"literal_text_all_w_t_and_m_t":"    cellDTXDRX-SlotOffset-r18              INTEGER (0..31)                               OPTIONAL,  -- Need M","paragraph_zero_based":15171},{"literal_text_all_w_t_and_m_t":"    cellDTXDRXconfigType-r18               ENUMERATED {dtx, drx, dtxdrx},","paragraph_zero_based":15172},{"literal_text_all_w_t_and_m_t":"    cellDTXDRXactivationStatus-r18         ENUMERATED {activated, deactivated}","paragraph_zero_based":15173},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":15174},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15175},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLDTXDRX-CONFIG-STOP","paragraph_zero_based":15176},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":15177},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15178},{"literal_text_all_w_t_and_m_t":"CellDTXDRX-Config field descriptions","paragraph_zero_based":15179},{"literal_text_all_w_t_and_m_t":"cellDTXDRX-CycleStartOffset","paragraph_zero_based":15180},{"literal_text_all_w_t_and_m_t":"cellDTXDRX-Cycle in ms and cellDTXDRX-StartOffset in multiples of 1 ms.","paragraph_zero_based":15181},{"literal_text_all_w_t_and_m_t":"The configured cellDTXDRX-Cycle is an integer multiple of configured drx-longCycle or vice versa.","paragraph_zero_based":15182},{"literal_text_all_w_t_and_m_t":"If this field is absent, the UE shall apply the stored value of this parameter.","paragraph_zero_based":15183},{"literal_text_all_w_t_and_m_t":"cellDTXDRX-onDurationTimer","paragraph_zero_based":15184},{"literal_text_all_w_t_and_m_t":"Value in multiples of 1/32 ms (subMilliSeconds) or in ms (milliSecond). For the latter, value ms1 corresponds to 1 ms, value ms2 corresponds to 2 ms, and so on.","paragraph_zero_based":15185},{"literal_text_all_w_t_and_m_t":"If this field is absent, the UE shall apply the stored value of this parameter.","paragraph_zero_based":15186},{"literal_text_all_w_t_and_m_t":"cellDTXDRX-SlotOffset","paragraph_zero_based":15187},{"literal_text_all_w_t_and_m_t":"Value in 1/32 ms. Value 0 corresponds to 0 ms, value 1 corresponds to 1/32 ms, value 2 corresponds to 2/32 ms, and so on.","paragraph_zero_based":15188},{"literal_text_all_w_t_and_m_t":"If this field is absent, the UE shall apply the stored value of this parameter.","paragraph_zero_based":15189},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15190},{"literal_text_all_w_t_and_m_t":"cellDTXDRXactivationStatus","paragraph_zero_based":15191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["efce05d6b5cd1b538919f160d26dac02b87b44659f97bf64945a3e3012a6e7f4","fe0722ae7fa2461e14bfb4bf094a79e6d9a79e0e65276f1b7501adf873171b99","05f5ad71fb2bff884cb8593e4ab4e95c0bbd9b7ca58e4b348ae771696754455e","1b9e7430015fac4b16227f5d3c106be9d812cef613c3366f208ab3829716af36","453dd6de4029fac73edf81621f74c908cab32d319dc9fdcaef365139d55e24a1","7e9019dadcde28007698b3785e9b2ad409b57ff0b1584d7ea9a745f3c7ccf8af","a2885a0079dc51e8c78839be1c03caf1f18527c98cc8dc25a7bf4d0f08d38de7","48aecca9f67d1c36efdac9b644018a708fa99136ba79ea457454ee9326bbc790","d854b64755bf2363e92ae3657