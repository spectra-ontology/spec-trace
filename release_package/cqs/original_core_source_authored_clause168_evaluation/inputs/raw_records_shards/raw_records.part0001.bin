{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–ReferenceLocation","paragraph_zero_based":25656},{"literal_text_all_w_t_and_m_t":"The IE ReferenceLocation contains location information used as a reference location. The value of the field is same as Ellipsoid-Point defined in TS37.355 [49]. The first/leftmost bit of the first octet contains the most significant bit.","paragraph_zero_based":25657},{"literal_text_all_w_t_and_m_t":"ReferenceLocation information element","paragraph_zero_based":25658},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25659},{"literal_text_all_w_t_and_m_t":"-- TAG-REFERENCELOCATION-START","paragraph_zero_based":25660},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25661},{"literal_text_all_w_t_and_m_t":"ReferenceLocation-r17 ::= OCTET STRING","paragraph_zero_based":25662},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25663},{"literal_text_all_w_t_and_m_t":"-- TAG-REFERENCELOCATION-STOP","paragraph_zero_based":25664},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":25665},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25666},{"literal_text_all_w_t_and_m_t":"–ReferenceTimeInfo","paragraph_zero_based":25667},{"literal_text_all_w_t_and_m_t":"The IE ReferenceTimeInfo contains timing information for 5G internal system clock used for, e.g., time stamping, see TS 23.501 [32], clause 5.27.1.2.","paragraph_zero_based":25668},{"literal_text_all_w_t_and_m_t":"ReferenceTimeInfo information element","paragraph_zero_based":25669},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25670},{"literal_text_all_w_t_and_m_t":"-- TAG-REFERENCETIMEINFO-START","paragraph_zero_based":25671},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25672},{"literal_text_all_w_t_and_m_t":"ReferenceTimeInfo-r16 ::= SEQUENCE {","paragraph_zero_based":25673},{"literal_text_all_w_t_and_m_t":"    time-r16                            ReferenceTime-r16,","paragraph_zero_based":25674},{"literal_text_all_w_t_and_m_t":"    uncertainty-r16                     INTEGER (0..32767)          OPTIONAL,   -- Need S","paragraph_zero_based":25675},{"literal_text_all_w_t_and_m_t":"    timeInfoType-r16                    ENUMERATED {localClock}     OPTIONAL,   -- Need S","paragraph_zero_based":25676},{"literal_text_all_w_t_and_m_t":"    referenceSFN-r16                    INTEGER (0..1023)           OPTIONAL    -- Cond RefTime","paragraph_zero_based":25677},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25678},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25679}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["d031a7ef10674e1855d848848c2a703e23aa48a0cdff18bc7dbaebb6e02304d7","ba3e809f7a996538cf5903827a6d275e069479f5f2e1261bdc1e937cd96081d9","68cba08dcdbe7baed33ff5896e35c1f49481d84396672b4a77549bfdf48a62c4","2e1bf8ea71b5dda23b6dc069df9a54070366025b264790ef8b4b580fe247bec0","a555903be9a36eb426b91c296a8a0da0d753fbb069b5a15a6f3c0fdb5cb13ef4","9f0373a8e16e76203f777ffe568a9da8e22ddb60126f60a8f3ff5dcc998312f9","28dcad30076cdefa2a2035cb4198b2a665624c673f12583b33063f6292f0f1ce","74fc1befc639b33d44fc0cd589fe6f7ea8e193e222d2b60bdd14ab9a8aa00855","7f9648895f431c04413216916a9b28b2bd0172dfb51b7bc38d6b8d679eca1483","073876a089e304e3ba6dd5db241fd09e2a6c6a84ee64fe1ff0d0d006355aa75d","9a3a2da745a125e8cd7007fe66f1eafa23db5ca16d59369a730fbb3e35358cbc","432730cc27fa8201803fd6e02142d5818dc48e86e2541e7be9f91a12d81113a8","a5e07c3b433dde2d24f72a4bb1004a24fbee8d15feca48e47c8d16791e8c9a10","21a2ef4229c663845f70af5d89720bf5e16f476b1aa094554d4f7959c937ad17","dbe67f8038f97a411a3cecb64558afe13467ce4ffe4772432518e4f505657d43","940ff1615d1b197d2d6680bc174848985f02c0bd858e9c93fcf5a95f96df00bb","63c151f2967dcf444cf85ddde2e01db70dd4f67da9b31647d24533f49e7cf5e9","fa0bc01894228d8a03844b35be1d6ee71f9d6358aa52b6cc79551b48b68ca1f8","3283604525d710796ecf68a12955f5a05de872e0f0e732c5656a8ce89da368bb","381da2b2cf4339d529421b2a0ec479a4fafc4a299105f27615c37cd66d482f15","57e6bf2e80b9466ad8e193832adb3747aab28e5ecc95aeb1629c56aa94505727","24a3a023ec80a689f94602bf034b96d53a6840f0beb1164e131cbb324b7e8544","cf53bca3b9bf05f82f0988ea3f36a62a4289b0d229b35e1cbd2a23e67572dfa7","dd1ed1e491aeea95995d9e6aeffaca158bda92f97dea5010f2184eeafb9b9967"],"paragraph_range_zero_based":[25656,25679],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p25656"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ReferenceTime-r16 ::=           SEQUENCE {","paragraph_zero_based":25680},{"literal_text_all_w_t_and_m_t":"    refDays-r16                         INTEGER (0..72999),","paragraph_zero_based":25681},{"literal_text_all_w_t_and_m_t":"    refSeconds-r16                      INTEGER (0..86399),","paragraph_zero_based":25682},{"literal_text_all_w_t_and_m_t":"    refMilliSeconds-r16                 INTEGER (0..999),","paragraph_zero_based":25683},{"literal_text_all_w_t_and_m_t":"    refTenNanoSeconds-r16               INTEGER (0..99999)","paragraph_zero_based":25684},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25685},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25686},{"literal_text_all_w_t_and_m_t":"-- TAG-REFERENCETIMEINFO-STOP","paragraph_zero_based":25687},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":25688},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25689},{"literal_text_all_w_t_and_m_t":"ReferenceTimeInfo field descriptions","paragraph_zero_based":25690},{"literal_text_all_w_t_and_m_t":"referenceSFN","paragraph_zero_based":25691},{"literal_text_all_w_t_and_m_t":"This field indicates the reference SFN corresponding to the reference time information. If referenceTimeInfo field is received in DLInformationTransfer message, this field indicates the SFN of PCell.","paragraph_zero_based":25692},{"literal_text_all_w_t_and_m_t":"time","paragraph_zero_based":25693},{"literal_text_all_w_t_and_m_t":"This field indicates time reference with 10ns granularity. If included in DLInformationTransfer and if UE-side TA PDC is de-activated, the indicated time may not be referenced at the network, i.e., gNB may pre-compensate for RF propagation delay. If included in DLInformationTransfer and if UE is requested to transmit UE Rx-Tx time difference measurement, the indicated time may not be referenced at the network, i.e., gNB may pre-compensate for RF propagation delay. Otherwise, the indicated time is referenced at the network, i.e., without compensating for RF propagation delay.","paragraph_zero_based":25694},{"literal_text_all_w_t_and_m_t":"The indicated time in 10ns unit from the origin is refDays*86400*1000*100000 + refSeconds*1000*100000 + refMilliSeconds*100000 + refTenNanoSeconds. The refDays field specifies the sequential number of days (with day count starting at 0) from the origin of the time field.","paragraph_zero_based":25695},{"literal_text_all_w_t_and_m_t":"If the referenceTimeInfo field is received in DLInformationTransfer message, the time field indicates the time at the ending boundary of the system frame indicated by referenceSFN. The UE considers this frame (indicated by referenceSFN) to be the frame which is nearest to the frame where the message is received (which can be either in the past or in the future).","paragraph_zero_based":25696},{"literal_text_all_w_t_and_m_t":"If the referenceTimeInfo field is received in SIB9, the time field indicates the time at the SFN boundary at or immediately after the ending boundary of the SI-window in which SIB9 is transmitted.","paragraph_zero_based":25697},{"literal_text_all_w_t_and_m_t":"If referenceTimeInfo field is received in SIB9, this field is excluded when determining changes in system information, i.e. changes of time should neither result in system information change notifications nor in a modification of valueTag in SIB1.","paragraph_zero_based":25698},{"literal_text_all_w_t_and_m_t":"timeInfoType","paragraph_zero_based":25699},{"literal_text_all_w_t_and_m_t":"If timeInfoType is not included, the time indicates the GPS time and the origin of the time field is 00:00:00 on Gregorian calendar date 6 January, 1980 (start of GPS time). If timeInfoType is set to localClock, the origin of the time is unspecified.","paragraph_zero_based":25700},{"literal_text_all_w_t_and_m_t":"uncertainty","paragraph_zero_based":25701},{"literal_text_all_w_t_and_m_t":"This field indicates the uncertainty of the reference time information provided by the time field. The uncertainty is 25ns multiplied by this field. If this field is absent, the uncertainty is unspecified.","paragraph_zero_based":25702},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25703}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["d9c4921f4ad1f949843cf68bc270b4df99be134e2ce7069d89fc3fe32d9baf1e","f0a10ca6f734a63c5e68b57490d87141bed1daed86e45c76fad78c49d712a157","65648b6d81069ae9b078380dc893f3db3d1c62731f34e7580ce07cc2c2993346","e19fa306630c32db6a46c60d50925e6710b07008fa1609178ed7f3eeafdd6bbb","ef57a15a6323e693b7507545f9a9229f0e958cd31c32c5cb314435b3bf09224b","d1b805fcc386ca5fef0515c25747c661221bd92708dcb1610736f5635663b61e","785db42151c01bb7ab9cb326a0a94a4f994cd0e5d17116fa1572528c079383ab","a7dbf89feb6d20e4bc2441776460e9a033712b0ab35deb3f539bba9defacf55e","ab2ac2671ee7753a865feca81d744724d9a0a8ca9119fb09fec0772c9375dfa7","e6123ab9263a9f5ca473b717af35aff67ae43d46b12f67d31dcd970cb76467f2","76e45f60751be4d1d0df5faf99f18477b99d4754ab3e4b18b9ee4eb721e6883b","a904866f9fe69e1881fae17b1bb30dc0071626460012ae6048f5965a7587afef","31f156c3750ccd390b634ccc65e5843b0b88163764e962daa4e96b0a677f32e5","f24e6e273b4de82baa275409ece406f230407324e685c53ffcf1fdc90819838a","01df3506c8e30cec23214e3a85fb046bdd126520d3f9ae27743fcd61708ddc93","130758aa49c65b153e2e0183c5b07f63e8275e77cc8446f2f8836e017e15f6e6","6fa541f554578a07bffeaecfc279d8e3e932d81d2a6ef411ed0d9fbc97272a82","53755cf5021a8869a1909ab6dbffa290a8d53ba3a06538e05c7363569ed1203a","66dfaa6499755d0