{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Initiate the measurement reporting procedure, stop performing the related measurements.","paragraph_zero_based":41328},{"literal_text_all_w_t_and_m_t":"T325","paragraph_zero_based":41329},{"literal_text_all_w_t_and_m_t":"Upon reception of RRCRelease message with deprioritisationTimer.","paragraph_zero_based":41330},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41331},{"literal_text_all_w_t_and_m_t":"Stop deprioritisation of all frequencies or NR signalled by RRCRelease.","paragraph_zero_based":41332},{"literal_text_all_w_t_and_m_t":"T330","paragraph_zero_based":41333},{"literal_text_all_w_t_and_m_t":"Upon receiving LoggedMeasurementConfiguration message","paragraph_zero_based":41334},{"literal_text_all_w_t_and_m_t":"Upon log volume exceeding the suitable UE memory, upon initiating the release of LoggedMeasurementConfiguration procedure","paragraph_zero_based":41335},{"literal_text_all_w_t_and_m_t":"Perform the actions specified in 5.5a.1.4","paragraph_zero_based":41336},{"literal_text_all_w_t_and_m_t":"T331","paragraph_zero_based":41337},{"literal_text_all_w_t_and_m_t":"Upon receiving RRCRelease message with measIdleDuration","paragraph_zero_based":41338},{"literal_text_all_w_t_and_m_t":"Upon receiving RRCSetup, RRCResume, RRCRelease with idle/inactive measurement configuration, upon cell selection/reselection to a cell that does not belong to the validityArea (if configured), or upon cell re-selection to another RAT.","paragraph_zero_based":41339},{"literal_text_all_w_t_and_m_t":"Perform the actions as specified in 5.7.8.3.","paragraph_zero_based":41340},{"literal_text_all_w_t_and_m_t":"T342","paragraph_zero_based":41341},{"literal_text_all_w_t_and_m_t":"Upon transmitting UEAssistanceInformation message with DelayBudgetReport.","paragraph_zero_based":41342},{"lit