{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-SL-QOS-FLOWIDENTITY-START","paragraph_zero_based":38328},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38329},{"literal_text_all_w_t_and_m_t":"SL-QoS-FlowIdentity-r16 ::=                    INTEGER (1..maxNrofSL-QFIs-r16)","paragraph_zero_based":38330},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38331},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-QOS-FLOWIDENTITY-STOP","paragraph_zero_based":38332},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":38333},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38334},{"literal_text_all_w_t_and_m_t":"–SL-QoS-Profile","paragraph_zero_based":38335},{"literal_text_all_w_t_and_m_t":"The IE SL-QoS-Profile is used to give the QoS parameters for a sidelink QoS flow. Need codes or conditions specified for SL-QoS-Profile do not apply, in case SL-QoS-Profile is included in SidelinkUEInformationNR.","paragraph_zero_based":38336},{"literal_text_all_w_t_and_m_t":"SL-QoS-Profile information element","paragraph_zero_based":38337},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":38338},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-QOS-PROFILE-START","paragraph_zero_based":38339},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38340},{"literal_text_all_w_t_and_m_t":"SL-QoS-Profile-r16 ::=        SEQUENCE {","paragraph_zero_based":38341},{"literal_text_all_w_t_and_m_t":"    sl-PQI-r16                    SL-PQI-r16                                                  OPTIONAL,   -- Need R","paragraph_zero_based":38342},{"literal_text_all_w_t_and_m_t":"    sl-GFBR-r16                   INTEGER (0..4000000000)                                     OPTIONAL,   -- Need R","paragraph_zero_based":38343},{"literal_text_all_w_t_and_m_t":"    sl-MFBR-r16                   INTEGER (0..4000000000)                                     OPTIONAL,   -- Need R","paragraph_zero_based":38344},{"literal_text_all_w_t_and_m_t":"    sl-Range-r16                  INTEGER (1..1000)                                           OPTIONAL,   -- Need R","paragraph_zero_based":38345},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":38346},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":38347},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38348},{"literal_text_all_w_t_and_m_t":"SL-PQI-r16 ::=                CHOICE {","paragraph_zero_based":38349},{"literal_text_all_w_t_and_m_t":"    sl-StandardizedPQI-r16        INTEGER (0..255),","paragraph_zero_based":38350},{"literal_text_all_w_t_and_m_t":"    sl-Non-StandardizedPQI-r16    SEQUENCE {","paragraph_zero_based":38351}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["f7f23e47255b56e8131f12bef8cbf18965e7272be7343ead1e3577f0d1e48778","2f8e70a8d8bdf07644bd52598f6eda42753523948d63481891bf563f8a43bf33","aa3bc5e99130a99710ff68b8dce91e8e52aa4900594eeb40d57a5a88eec6bdd4","5319e8ec291a57a1ce94ca226f5300c98981160bd48bfc8acac69b5c64273bb1","c6c125628e4d3f5bcc2e77fad14e1825e773ef0ca0bcfafb081da71801ec8f27","f06d0d5ce476cf19abd8946e5ff307bb0f7122191b7ecffd1d639a08bd22593b","418665e51b947178f04d7f7a67753f787f220f6856ae29e20aec1503d83b3488","5b4613a228efc59423ab49c6f1aad4d85af86b2ffd2a59e2e80a3e64bb18a392","a53a1961472cd208f94ac22e14b407e74fc9f4b0e560ec07150f628a11b88ce5","15f8a1c62064716e3b90e35cc0db301f4153c09d01d8d632bffc6f41252ab840","68104e5ad66659a436f5c0cbec60e411dc3f9a6cf86acb730e5f9b3804165d3d","118fe22525b00388e858361c46c4ac80ce62e809d5878bf3303eabecea7126c4","b0c16e9a2fb0c8d7b4