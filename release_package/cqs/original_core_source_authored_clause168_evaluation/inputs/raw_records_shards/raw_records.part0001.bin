{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":37848},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":37849},{"literal_text_all_w_t_and_m_t":"    sl-DeltaRSRP-Thresh-v1720                 INTEGER (-30..30)                                                    OPTIONAL    -- Need M","paragraph_zero_based":37850},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":37851},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37852},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37853},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37854},{"literal_text_all_w_t_and_m_t":"SL-ThresholdRSRP-Condition1-B-1-r17 ::=   SEQUENCE {","paragraph_zero_based":37855},{"literal_text_all_w_t_and_m_t":"    sl-Priority-r17                           INTEGER (1..8),","paragraph_zero_based":37856},{"literal_text_all_w_t_and_m_t":"    sl-ThresholdRSRP-Condition1-B-1-r17       INTEGER (0..66)","paragraph_zero_based":37857},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37858},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37859},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-INTERUE-COORDINATIONCONFIG-STOP","paragraph_zero_based":37860},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":37861},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37862},{"literal_text_all_w_t_and_m_t":"SL-InterUE-CoordinationScheme1 field descriptions","paragraph_zero_based":37863},{"literal_text_all_w_t_and_m_t":"sl-Condition1-A-2","paragraph_zero_based":37864},{"literal_text_all_w_t_and_m_t":"Indicates disabling the use of condition of excluding from preferred resource set resource(s) in slot(s) where UE-A, when it is intended receiver of UE-B, does not expect to perform SL reception from UE-B due to half duplex operation.","paragraph_zero_based":37865},{"literal_text_all_w_t_and_m_t":"sl-ContainerCoordInfo","paragraph_zero_based":37866},{"literal_text_all_w_t_and_m_t":"Indicates whether a SCI format 2-C can be used as the container of inter-UE coordination information transmission from UE-A to UE-B in Scheme 1 in addition to using MAC CE.","paragraph_zero_based":37867},{"literal_text_all_w_t_and_m_t":"sl-ContainerRequest","paragraph_zero_based":37868},{"literal_text_all_w_t_and_m_t":"Indicates whether a SCI format 2-C can be used as the container of an explicit request for inter-UE coordination information transmission from UE-B to UE-A in Scheme 1 in addition to using MAC CE.","paragraph_zero_based":37869},{"literal_text_all_w_t_and_m_t":"sl-DetermineResourceType","paragraph_zero_based":37870},{"literal_text_all_w_t_and_m_t":"Indicates how to determine the resource set type to be provided by inter-UE coordination information transmission. Value \"uea\" means the resource set type is determined by UE-A's implementation. Value \"ueb\" means the resource set type is determined by UE-B's request.","paragraph_zero_based":37871}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["8cfdf3893b5afd23c4f685eec58075de474c64ab691b55f25ff4e17b3219e2e7","0719fdcfb9d2a538e653cce900637c26965870719baf60402b4d8acf40692203","b0a13f7baf0778c3410246b9d9abd84de2654b479b16202f6fbc9cd427d355b5","f4a1822301e605fa947c7ce0175e26160b13c23d625f9e97f7ba929c5e292bf1","b0fe2989c116c63f3be45b73d9a99589acd9e0157d0188212f3c4d83913856e4","cc3a09121dc65d6e712d21e6df7cb66c106395832d2335839c9717b40c2b5a17","d0c6a4ff3325c342910853f08ad9946d807c6d4640d0cf2df3ccf1bfd41a5c39","3bb8ebb50ef7b0b9e42d70814b1c398dcfb0fa0014f8048eb202ffc882f