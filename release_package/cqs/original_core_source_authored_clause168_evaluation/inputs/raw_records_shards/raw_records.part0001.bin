{"fields":{"filename":"R2-2312967.zip::R2-2312967.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"CD-SSBCell Defining SSB","paragraph_zero_based":216},{"literal_text_all_w_t_and_m_t":"CFRCommon Frequency Resource","paragraph_zero_based":217},{"literal_text_all_w_t_and_m_t":"CFRAContention Free Random Access","paragraph_zero_based":218},{"literal_text_all_w_t_and_m_t":"CGConfigured Grant","paragraph_zero_based":219},{"literal_text_all_w_t_and_m_t":"CHOConditional Handover","paragraph_zero_based":220},{"literal_text_all_w_t_and_m_t":"CIoTCellular Internet of Things","paragraph_zero_based":221},{"literal_text_all_w_t_and_m_t":"CLICross Link interference","paragraph_zero_based":222},{"literal_text_all_w_t_and_m_t":"CMASCommercial Mobile Alert Service","paragraph_zero_based":223},{"literal_text_all_w_t_and_m_t":"CORESETControl Resource Set","paragraph_zero_based":224},{"literal_text_all_w_t_and_m_t":"CPCyclic Prefix","paragraph_zero_based":225},{"literal_text_all_w_t_and_m_t":"CPAConditional PSCell Addition","paragraph_zero_based":226},{"literal_text_all_w_t_and_m_t":"CPCConditional PSCell Change","paragraph_zero_based":227},{"literal_text_all_w_t_and_m_t":"DAGDirected Acyclic Graph","paragraph_zero_based":228},{"literal_text_all_w_t_and_m_t":"DAPSDual Active Protocol Stack","paragraph_zero_based":229},{"literal_text_all_w_t_and_m_t":"DFTDiscrete Fourier Transform","paragraph_zero_based":230},{"literal_text_all_w_t_and_m_t":"DCIDownlink Control Information","paragraph_zero_based":231},{"literal_text_all_w_t_and_m_t":"DCPDCI with CRC scrambled by PS-RNTI","paragraph_zero_based":232},{"literal_text_all_w_t_and_m_t":"DL-AoDDownlink Angle-of-Departure","paragraph_zero_based":233},{"literal_text_all_w_t_and_m_t":"DL-SCHDownlink Shared Channel","paragraph_zero_based":234},{"literal_text_all_w_t_and_m_t":"DL-TDOADownlink Time Difference Of Arrival","paragraph_zero_based":235},{"literal_text_all_w_t_and_m_t":"DMRSDemodulation Reference Signal","paragraph_zero_based":236},{"literal_text_all_w_t_and_m_t":"DRXDiscontinuous Reception","paragraph_zero_based":237},{"literal_text_all_w_t_and_m_t":"DTX Discontinuous Transmission","paragraph_zero_based":238},{"literal_text_all_w_t_and_m_t":"E-CIDEnhanced Cell-ID (positioning method)","paragraph_zero_based":239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2fe1425c1c3063be5b4937213502c4c58233154398c18acff6d04d26b4f67c54","original_member_sha256":"375d1cea2f37b63857f0be6a2a7c087c2f244f800e054566b630753125bd895f","paragraph_ElementTree_utf8_XML_sha256":["da802765c7a3721c86cd5016cad182f873b93c9f849d91cbb170921211782942","24f9a5582f972c9b6cd35c3ee1fb46ad79169383f845c7765b71a45a4e2fed27","22cffa28cd016325632e18fb185ee00d0addf9e68243b602fdd530f553002cee","0fbc393c05d1205cca89603837b6228f56f0ce10bcf473f9879f6e57e0ea263f","ac6c727d2f2ebed2ed410bf900917761908a5307088ded4e64ed1ef1291fc5d6","51cd7d194ee482a9e84162e3199a05fa5d165bf6227c79d91fd115e1b9a208be","ea85e0f18bd912845aada76a38690ce7553d3bfd995e30a4b708c66f099d4bbc","b2279f34356f3276176eb7f3064bf6856942f54399f680cb6b9b6c4e0b3bfb3c","4655b96f07a4dfddb44296ab327b8bb35333d235c5a7bc683ba86b6126aa8de9","9c6258c519f4285d6d69fcaef99255890ab20b4fdb50390770a4b6993785176e","8a3001a9d29cb2975dba960a9fb4e86e5321e338fa94fee1bf4f4a1f32563613","4e01649be16eace81c8c4232a5540c8f46f404c593771fd0069f6244db8f7333","1ebf9d97c2358f14fdd10005fe16fdd5da844540f4c02b93a23e4982555698d3","73e764060f2fb4ec62c4baa286b22994282c69bf1ec02892e87a894227e03b55","b135199de5152a5a99a70a7b8fe60c8f840dc14d6e51eb667dbaa98d1d334176","21e682c9fd57dda2f637cceff362ff7ed7db4ac14cf95100c70dbdef027eeb6d","16c1506dabf0c4654a80ebe9bb3d88bfac9e8c235c0d118bce6086d9cb79f543","b8fed28dc7bb93bccf8df888254e94d5eb80e03ebc213bb3c2a00e1a146e6466","59151d6804ab675c5aca2418312f039fba2782f9f39b746854136be5bf13555b","4e5343f474cb05222058bb4f39f044b9ed484719ff4d634d9ab13d5d4902c251","662c4e8046630da064005ca160399802dfd9273f05fbc796e34760e1c669fcd6","e6ebed517a3d0d2cc0c65eec786cafa5532fe654172591468d4286b22759ee8d","6607e53dab94db2b073edcb0c2e4128f9f875816013f5758082184c1c7c82fb1","b8eb4ea00847c5b5f4a8abf739826fb4bed5e3ff7322e49e1e4c40e896ca2559"],"paragraph_range_zero_based":[216,239],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312967.zip::R2-2312967.docx:p216"}
{"fields":{"filename":"R2-2312967.zip::R2-2312967.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"EHCEthernet Header Compression","paragraph_zero_based":240},{"literal_text_all_w_t_and_m_t":"ePWSenhancements of Public Warning System","paragraph_zero_based":241},{"literal_text_all_w_t_and_m_t":"END OF FIRST CHANGE","paragraph_zero_based":242},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":243},{"literal_text_all_w_t_and_m_t":"START OF SECOND CHANGE","paragraph_zero_based":244},{"literal_text_all_w_t_and_m_t":"15.4Support for Energy Saving","paragraph_zero_based":245},{"literal_text_all_w_t_and_m_t":"15.4.1General","paragraph_zero_based":246},{"literal_text_all_w_t_and_m_t":"The aim of this function is to reduce operational expenses through energy savings.","paragraph_zero_based":247},{"literal_text_all_w_t_and_m_t":"The function allows, for example in a deployment where capacity boosters can be distinguished from cells providing basic coverage, to optimize energy consumption enabling the possibility for an E-UTRA or NR cell providing additional capacity via single or dual connectivity, to be switched off when its capacity is no longer needed and to be re-activated on a need basis, and other various techniques in time, frequency, spatial and power domains.","paragraph_zero_based":248},{"literal_text_all_w_t_and_m_t":"15.4.2Solution description","paragraph_zero_based":249},{"literal_text_all_w_t_and_m_t":"15.4.2.1Intra-system energy saving","paragraph_zero_based":250},{"literal_text_all_w_t_and_m_t":"The solution builds upon the possibility for the NG-RAN node owning a capacity booster cell to autonomously decide to switch-off such cell to lower energy consumption (inactive state). The decision is typically based on cell load information, consistently with configured information. The switch-off decision may also be taken by O&M.","paragraph_zero_based":251},{"literal_text_all_w_t_and_m_t":"The NG-RAN node may initiate handover actions in order to off-load the cell being switched off and may indicate the reason for handover with an appropriate cause value to support the target node in taking subsequent actions, e.g. when selecting the target cell for subsequent handovers.","paragraph_zero_based":252},{"literal_text_all_w_t_and_m_t":"All neighbour NG-RAN nodes are informed by the NG-RAN node owning the concerned cell about the switch-off actions over the Xn interface, by means of the NG-RAN node Configuration Update procedure.","paragraph_zero_based":253},{"literal_text_all_w_t_and_m_t":"All informed nodes maintain the cell configuration data, e.g., neighbour relationship configuration, also when a certain cell is inactive. If basic coverage is ensured by NG-RAN node cells, NG-RAN node owning non-capacity boosting cells may request a re-activation over the Xn interface if capacity needs in such cells demand to do so. This is achieved via the Cell Activation procedure. During switch off time period of the boost cell, the NG-RAN node may prevent idle mode UEs from camping on this cell and may prevent incoming handovers to the same cell.","paragraph_zero_based":254},{"literal_text_all_w_t_and_m_t":"The NG-RAN node receiving a request should act accordingly. The switch-on decision may also be taken by O&M. All peer NG-RAN nodes are informed by the NG-RAN node owning the concerned cell about the re-activation by an indication on the Xn interface.","paragraph_zero_based":255},{"literal_text_all_w_t_and_m_t":"15.4.2.2Inter-system energy saving","paragraph_zero_based":256},{"literal_text_all_w_t_and_m_t":"The solution builds upon the possibility for the NG-RAN node owning a capacity booster cell to autonomously decide to switch-off such cell to dormant state. The decision is typically based on cell load information, consistently with configured information. The switch-off decision may also be taken by O&M. The NG-RAN node indicates the switch-off action to the eNB over NG interface and S1 interface. The NG-RAN node could also indicate the switch-on action to the eNB over NG interface and S1 interface.","paragraph_zero_based":257},{"literal_text_all_w_t_and_m_t":"The eNB providing basic coverage may request a NG-RAN node's cell re-activation based on its own cell load information or neighbour cell load information, the switch-on decision may also be taken by O&M. The eNB requests a NG-RAN node's cell re-activation and receives the NG-RAN node's cell re-activation reply from the NG-RAN node over the S1 interface and NG interface. Upon reception of the re-activation request, the NG-RAN node's cell should remain switched on at least until expiration of the minimum activation time. The minimum activation time may be configured by O&M or be left to the NG-RAN node's implementation.","paragraph_zero_based":258},{"literal_text_all_w_t_and_m_t":"15.4.2.x1Cell DTX/DRX","paragraph_zero_based":259},{"literal_text_all_w_t_and_m_t":"To facilitate reducing gNB downlink transmission/uplink reception activity time, UE can be configured with a periodic cell DTX/DRX pattern (i.e. active and non-active periods). The pattern configuration for cell DTX/DRX is common for the UEs configured with this feature in the cell. The cell DTX and cell DRX patterns can be configured and activated separately. A maximum of two cell DTX/DRX patterns can be configured per MAC entity. When cell DTX is configured and activated for the concerned cell, the UE does not monitor PDCCH in selected cases or SPS occasions during cell DTX non-active duration. When cell DRX is configured and activated for the concerned cell, the UE does not transmit on CG resources or transmit a SR during cell DRX non-active duration. This feature is only applicable to UEs in RRC_CONNECTED state and it does not impact Random Access procedure, SSB transmission, paging, and system information broadcasting.  Cell DTX/DRX can be activated/deactivated by RRC signalling or L1 group common signalling. Cell DTX/DRX is characterized by the following:","paragraph_zero_based":260},{"literal_text_all_w_t_and_m_t":"-active duration: duration that the UE waits for to receive PDCCHs or SPS occasions, and transmit SR or CG. In this duration, the gNB transmission/reception of PDCCH, SPS, SR, CG, periodic and semi-persistent CSI report are not impacted for the purpose of network energy saving; ","paragraph_zero_based":261},{"literal_text_all_w_t_and_m_t":"-cycle: specifies the periodic repetition of the active-duration followed by a period of non-active duration;","paragraph_zero_based":262},{"literal_text_all_w_t_and_m_t":"Active duration and cycle parameters are common between cell DTX and cell DRX, when both are configured;","paragraph_zero_based":263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2fe1425c1c3063be5b4937213502c4c58233154398c18acff6d04d26b4f67c54","original_member_sha256":"375d1cea2f37b63857f0be6a2a7c087c2f244f800e054566b630753125bd895f","paragraph_ElementTree_utf8_XML_sha256":["d3c3a209b55d9e5fddbb103e48ca9128de649f15b32c016b290faf1e0a0e877f","1a2b869355b233e5dee446efcc3643d7d71bba6571adac5dc199d489245e8c1a","a906c47d57352d5a876771a8d556db78d7440e24acd56d17f018ae4920fc8e3a","e1218844b9780e29f57474931bb3b92a8745bc4e5482c4d9a2449c379db36667","dff4f4a0251648cf32a882619d148da3b44faa63b636da451a3f04b22e6f69f5","8ac9ecfb3f9673f7de9d95198bc36515e3679ab7d7f1759a7de2167630e5065e","ead8f1e4f76f428f9436bf7dc16ba2d6d4a9c9f6cbb676ea61f96a8cc2b3612a","9d03b05f13dbe0653d9b868b9149071056b91cd62c3d650686f3942005cd2575","7d13a1e0c74b3e833045d133f46e5bcedf8563216169b17d79209b791c2cf269","99dd7d317ac04abeb54422dcffc8e87cb35d247af7a45c8cbfb1d77bca938e12","680206b0b20726f3c241ba13e3948ca2ac7dc90f76e4525df9eede1990800fb6","431cfacdf4c6b3dff92a0e0e643ccf7b23ecb63a55c696c6626fac0d395186d3","7279d2066edfe1a979153ce9c96870e52f655c2901ec2f0fe2d5f9dfb8a0e61d","c579bb482646a6f2431519a620fdc526397d502eefe41ea6784e3706a1470e50","10ccdbd986a830ea4441ecd89b610ea37bc945294a8baf7a8e77ba55bd76eca3","70eeacad6602128d393a88f11f2d5bc96193338491c39bbda9b56432525eef27","c3c8e19a75bd2f828720588e07a147f693a3f3a3bfeda4649b6a2d3d62445dbc","6479254d9a2c439c7d7a905ab5ed468c9990f6d7031386769707f1efd3e15502","8a9b4c9fbf281bddf44e5f0babbecacccd7327cbada4e755e581ae73c0950772","5f33c7cba900925933eb964ecc10b73c40fd01ee00a5846711af8f9bd8a02fc9","2c7f3a94e8bac36d234e2554f06aea8a6dd8b2450ee741253ff76328a00645e3","36572222afe5db17c62a4c69a9e28ae52e28a0f90789f7565384bacc70ddbc9a","e92762f96acea3faeb68136958d02c79bae371990a833a24a191e5c7b06854b9","b6f2c8ea02bac60e68284caa515c3d5da31ba3f92b42cf7498e3a159b559c08b"],"paragraph_range_zero_based":[240,263],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312967.zip::R2-2312967.docx:p240"}
{"fields":{"filename":"R2-2312967.zip::R2-2312967.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Once the gNB recognizes there is an emergency call or public safety related service (e.g. MPS or MCS), the network should ensure that there is no impact to that service (e.g. it may release or deactivate cell DTX/DRX configuration). The network should also ensure that there is at least partial overlapping between UE’s connected mode DRX on-duration and cell DTX/DRX active duration, i.e. the UE’s connected mode DRX periodicity is a multiple of cell DTX/DRX  periodicity or vice versa.   ","paragraph_zero_based":264},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":265},{"literal_text_all_w_t_and_m_t":"Editor’s note: FFS on how to mention cell DTX/DRX on sections 10.2, 10.3 and 11.","paragraph_zero_based":266},{"literal_text_all_w_t_and_m_t":"15.4.2.x2Conditional Handover","paragraph_zero_based":267},{"literal_text_all_w_t_and_m_t":"The same principle as described in 9.2.3.4 applies to conditional handover in case the source cell is using a network energy saving solution, unless hereunder specified. In this case, the following additional triggering conditions are supported, upon which UE may execute CHO to a candidate cell, as defined in TS 38.331 [x]:","paragraph_zero_based":268},{"literal_text_all_w_t_and_m_t":"Editor’s note: FFS further updates on triggering conditions.","paragraph_zero_based":269},{"literal_text_all_w_t_and_m_t":"Editor’s note: FFS on how UE knows the source cell is using a network energy saving solution and whether this needs to be captured in stage 2.","paragraph_zero_based":270},{"literal_text_all_w_t_and_m_t":"Editor’s note: FFS if this clause could be merged with another clause e.g. 15.4.2.1.","paragraph_zero_based":271},{"literal_text_all_w_t_and_m_t":"15.4.2.x3Camping Restrictions","paragraph_zero_based":272},{"literal_text_all_w_t_and_m_t":"The access of NES Capable UEs to a cell is  controlled by a single bit in SIB1 (if present), otherwise the barring mechanisms described in clause 7.4 apply. The definition of NES capable UEs is FFS.","paragraph_zero_based":273},{"literal_text_all_w_t_and_m_t":"15.4.2.x4Inter-band CA SSB-less SCell","paragraph_zero_based":274},{"literal_text_all_w_t_and_m_t":"Editor’s note: FFS on content and whether a section is needed for inter-band SSB-less.","paragraph_zero_based":275},{"literal_text_all_w_t_and_m_t":"15.4.2.x5Spatial and power domain adaptation","paragraph_zero_based":276},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":277},{"literal_text_all_w_t_and_m_t":"To assist the gNB on muting transceivers and/or adapting transmission power, the UE can be configured to report multiple CSI entries in a CSI report based on one or more sub-configurations, as specified in clause 5.2.1.6 in TS 38.214 [xy]. Each sub-configuration corresponds to a spatial domain adaptation pattern (subsets of available spatial elements) and/or a power offset between PDSCH and CSI-RS. ","paragraph_zero_based":278},{"literal_text_all_w_t_and_m_t":"15.4.3O&M requirements","paragraph_zero_based":279},{"literal_text_all_w_t_and_m_t":"Operators should be able to configure the energy saving function.","paragraph_zero_based":280},{"literal_text_all_w_t_and_m_t":"The configured information should include:","paragraph_zero_based":281},{"literal_text_all_w_t_and_m_t":"-The ability of an NG-RAN node to perform autonomous cell switch-off;","paragraph_zero_based":282},{"literal_text_all_w_t_and_m_t":"-The ability of an NG-RAN node to request the re-activation of a configured list of inactive cells owned by a peer NG-RAN node.","paragraph_zero_based":283},{"literal_text_all_w_t_and_m_t":"O&M may also configure:","paragraph_zero_based":284},{"literal_text_all_w_t_and_m_t":"-policies used by the NG-RAN node for cell switch-off decision;","paragraph_zero_based":285},{"literal_text_all_w_t_and_m_t":"-policies used by peer NG-RAN nodes for requesting the re-activation of an inactive cell;","paragraph_zero_based":286},{"literal_text_all_w_t_and_m_t":"-The minimum time an NG-RAN node's cell should remain activated upon reception of a re-activation request from an eNB.","paragraph_zero_based":287}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2fe1425c1c3063be5b4937213502c4c58233154398c18acff6d04d26b4f67c54","original_member_sha256":"375d1cea2f37b63857f0be6a2a7c087c2f244f800e054566b630753125bd895f","paragraph_ElementTree_utf8_XML_sha256":["79d67d03249a167ca3e289e59407a57f04484ef54c386bc73fca0c4a018ae8bd","b7833d8cf646daa65d3bf2504ab000e8a532daed9ac6ded31e22b2da8361c668","b0b6d977586c6de4073e7f361d979bad29077808854420edeac7f5c5388935bd","24f621c1c7ccfec97ea43f50f69e2a65e2cd7214e3266b2f29f62653e8194e8d","90bd11a2bdda84c66aa0ceeba63c88abb910b4c60172e1e16e41020cdd08872c","1c72bd7ba6a025906805393ed5b42b526a6324463bcd43de558e0c9f92d6402d","eb538eb4195f80e8b2e8a0fb972fd3426d76b2a9215c9b28a6108301cb0b37e7","a71aecb2395493380907aba30d2c7271f3bfec7810bd0bc6cb9fd58bf4a416cf","817f23b8f93f25762b392440d55677decf8c325bf5e73e7d8797eb70f790a1fe","4f86b2da9e5b979e8ac88a80fd5974fea155f2f489c8deb63474f759cdeca6d2","d74c1a55a136c3ca70d02c44cbe50854ca86a2458e5853ba6ee124846b6dc625","36d1e6ea4bea67155c4965a77fdc7eca0399c316a8d079af5608dfbd6a7fb048","3084d1c377e1c262352f745f0d6614ce6c07b201978eba3100be3fbf37e787cf","c80e6f978b987fabcfbb475f9cba699e6f8f470482932daff81938001bca3584","ac52346a63c555cac2251638357a2152525b170c82872684fa0c9379f1b076cf","4cfcd83316ce9af5d69ec5c2235cafc9e0ce453eeea15ff38916140f975d8f69","92b8f4c4c9ce1cb9fde466f843638dda96f668220e705fdf1efd496ecf705792","19c5bdcd917da17fba84754fcfc0e6ceb3f292134796890a6adf7a5f10373b11","636829aad131561f06850196c863f42e61f4e63163c777862cde234925591e35","b550aa12c1af3c87eb28186700d25767a380b6e56106ba7a63c5aabac40371c3","ff0322958b7dda452470dea926256d37b4ce42c0a8b529dfe8cd4fef8806ef74","2ff6733fcdf922beefb74faebd3ed9d9e7c4e3f11f51ec4b3d511e43146e3254","565314aa0814fa5b1a298a42ff26cbe0528615e33c436988a6df6ac567ea7b7a","f73fcca8d9616d6ce28780d679c8dec3cd22f0ba01daf242a043f6274cfe6db6"],"paragraph_range_zero_based":[264,287],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312967.zip::R2-2312967.docx:p264"}
{"fields":{"filename":"R2-2312967.zip::R2-2312967.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"END OF SECOND CHANGE","paragraph_zero_based":288},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":289},{"literal_text_all_w_t_and_m_t":"Annex: RAN2 Agreements","paragraph_zero_based":290},{"literal_text_all_w_t_and_m_t":"RAN2#121","paragraph_zero_based":291},{"literal_text_all_w_t_and_m_t":"Agreements ","paragraph_zero_based":292},{"literal_text_all_w_t_and_m_t":"There will be no impact to RACH, paging, and SIBs in idle/inactive for both gNB and Rel-18 and legacy UEs","paragraph_zero_based":293},{"literal_text_all_w_t_and_m_t":"Rel-18 NES capable CONNECTED UE(s) can perform RACH and receive SIBs in non-active duration of cell DTX and/or DRX (i.e., same behavior for cell DTX and cell DRX).  No further enhancements for CBRA and CFRA will be pursued.","paragraph_zero_based":294},{"literal_text_all_w_t_and_m_t":"Pattern configuration for cell DRX/DTX is common for Rel-18 UEs in the cell.   FFS whether we have DTX UE specific inactivity timer .  FFS on configuration signaling and stage 3.  ","paragraph_zero_based":295},{"literal_text_all_w_t_and_m_t":"Confirm study item agreement that we can have separate DTX and DRX configuration.   We will focus on designing DTX/DRX for at least single configuration.  FFS whether multiple configuration of cell DTX or DRX will be supported.  ","paragraph_zero_based":296},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":297},{"literal_text_all_w_t_and_m_t":"Agreements:","paragraph_zero_based":298},{"literal_text_all_w_t_and_m_t":"RAN2 confirms that non-NES UEs can access to NES cells if NES solution is backwards compatible","paragraph_zero_based":299},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":300},{"literal_text_all_w_t_and_m_t":"Agreements:","paragraph_zero_based":301},{"literal_text_all_w_t_and_m_t":"Study whether CHO enhancements are needed for the purpose of turning off the cell","paragraph_zero_based":302},{"literal_text_all_w_t_and_m_t":"Continue discussing CHO in the context of different NES techniques.  ","paragraph_zero_based":303},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":304},{"literal_text_all_w_t_and_m_t":"RAN2#121bis-e","paragraph_zero_based":305},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":306},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":307},{"literal_text_all_w_t_and_m_t":"Agreements ","paragraph_zero_based":308},{"literal_text_all_w_t_and_m_t":"A periodic cell DTX/DRX configuration is explicitly signalled to the UEs. ","paragraph_zero_based":309},{"literal_text_all_w_t_and_m_t":"A periodic cell DTX/DRX pattern is configured by UE specific RRC signalling. ","paragraph_zero_based":310},{"literal_text_all_w_t_and_m_t":"The Cell DTX/DRX configuration contains at least: periodicity, start slot/offset, on duration. ","paragraph_zero_based":311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2fe1425c1c3063be5b4937213502c4c58233154398c18acff6d04d26b4f67c54","original_member_sha256":"375d1cea2f37b63857f0be6a2a7c087c2f244f800e054566b630753125bd895f","paragraph_ElementTree_utf8_XML_sha256":["02f0c1a77c68b4e38ea169cff8cc5e6ce7e2a6ce1c38277bbbe3b2ff56f1757e","74969ae80f358d9729c0d57866c404ec22fd700b77fb45104d8f35393581823b","c248137f6954d1559f83442f1ae17055281c791a2287df885c97baa08ee0e7f7","32bdc6a628adca68f1850f2024bbc46e4912e814ddaeadf84f7cc065fa2500a5","a6a00e608c91d8de024bd7b40633a3d82c20625096da68ae852a05ee55a3e739","63107e51c976fbf6ab041483a80dd24073f2016cc308ee0d6c498f605b1912e0","6dbc26c0e37a18decb25e4ccac10b6a85b72f0c4f9d020eb5c38adecc6e25d4d","7ed24f4bcdd5e3baee4a5b21d83514046802deaf06b8642d327395ad9a38439d","1a726b1a3a0d2804de73c0ee974b8f1be5ad3b2a854ba1892234aa1b32fefcd9","4c651ea340504e59379abd382fe7bd2fcf4ee63bcabf820a9e109613a75cb203","05d2ce5617626edef606830dc3e8e872d766e50682ddb10e9460df863a431329","2d0ef568b70fa6c4913391f4ba34dba810c94ce04ee7a49344da510f73af173f","4338cf45333156d2f0bb8bbdacc5f5063e4516697e5ba9ce05f802a9b75ccc81","09c61ce7c17499dbc1e399fdc8f91060fa96ef5b6cb3b3cfa9a3939ae5ea8924","d56b763ceacc671f7f60b3e17ec3889cc5d6172f3f11917a346eba8454b84f43","d70e78ef7fc9ec78b1e6fa0d88eddde6a7e6e9856adeec24697659765afc483b","0976b2084d305ed0f6a70afb905f09b303bb4eac5f4b1c53e1f2d92cc5bf79ab","cb9a06b852158e25ea2d030acac0b1b8c89d94ab9f26c4e29d7ca66fec1e60ac","55f7b28d6e60c86eb2e74ff9131b69e8e689f5db014adb830a05212c3296c394","7e38bc76b63bc82eb0b7a99d6f70e486694df61a1d269dc5415156304856531e","28627aa71931af9b61b48415e1588df33c276e79b8ec3eb901cb62026a723e2d","9391062b8420ea9e7b9fe4f290e857891286d51b8be43f21e96e48079fbc43a4","d18e3bddb584d1e4fcb3590861eeb02aa08254b0ef4e5c0315b6a7ff5c1aedfa","091a1a72c995f9b3f6dbd0e4493da8851bf66636046da825288af7ce55ad1ab4"],"paragraph_range_zero_based":[288,311],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312967.zip::R2-2312967.docx:p288"}
{"fields":{"filename":"R2-2312967.zip::R2-2312967.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"As a baseline Cell DTX/DRX is activated/deactivated implicitly by RRC signalling, i.e. activated immediately once configured by RRC and deactivated once the RRC configuration is released. ","paragraph_zero_based":312},{"literal_text_all_w_t_and_m_t":"From RAN2 point of view, majority companies see a benefit with L1 signalling for Cell DTX/DRX activation/deactivation, send a LS to RAN1 (email 308) with our preference and ask about feasibility and design details.   Ask about feasibility and reliability of using L1 signaling.  Clarify that the question is about activation/deactivation copy the agreement from last meeting that we are focusing on single configuration.  Extract a few key benefits of dynamic signaling from email discussion and online discussions","paragraph_zero_based":313},{"literal_text_all_w_t_and_m_t":"As baseline, UE doesn’t monitor SPS occasions during Cell DTX non-active period. As baseline, gNB is assumed to be not transmitting PDSCH to that UE on such SPS occasions during the Cell DTX non-active period","paragraph_zero_based":314},{"literal_text_all_w_t_and_m_t":"As baseline, UE does not transmit on CG occasions during Cell DRX non-active periods","paragraph_zero_based":315},{"literal_text_all_w_t_and_m_t":"As baseline, UE does not transmit SR occasions overlapping with Cell DRX non-active periods, e.g. SR transmissions are dropped during the non-active period ","paragraph_zero_based":316},{"literal_text_all_w_t_and_m_t":"FFS: whether we will allow to configure the UE per SR configuration with whether SR can be transmitted during Cell DRX non-active period to to support high priority traffic ","paragraph_zero_based":317},{"literal_text_all_w_t_and_m_t":"(for the SRs that will be dropped) If SR is not to be transmitted on an PUCCH occasion during Cell DRX non-active time, the UE keep the SR pending, i.e., the UE delays the SR transmission till the Cell DRX active period without triggering RACH.  For the FFS case there may be some exceptions.  ","paragraph_zero_based":318},{"literal_text_all_w_t_and_m_t":"The understanding for the gNB scheduling behaviour for new transmissions during Cell DTX non-active period is that the gNB does not schedule UE-specific dynamic grants/assignments, even if the UE is in C-DRX Active Time.   UE doesn’t monitor PDCCH for dynamic grants/assignments for new transmissions during Cell DTX non-active period, even if the UE is in C-DRX Active time.   FFS how to deal with any exceptions (e.g. SR if agreed and RACH).  ","paragraph_zero_based":319},{"literal_text_all_w_t_and_m_t":"FFS how to deal with retransmissions","paragraph_zero_based":320},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":321},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":322},{"literal_text_all_w_t_and_m_t":"Agreements","paragraph_zero_based":323},{"literal_text_all_w_t_and_m_t":"-RAN2 agree to make enhancement in CHO procedure based on that the source cell entering “NES mode”.  FFS further details","paragraph_zero_based":324},{"literal_text_all_w_t_and_m_t":"-For source cell CHO framework, RAN2 assumes a reference scenario where the UE has already performed CHO conditions evaluation by the time the source cell starts some “NES-mode”","paragraph_zero_based":325},{"literal_text_all_w_t_and_m_t":"-As a baseline, UE initiates CHO evaluation upon receiving the CHO configuration.  FFS what trigger is used for execution of CHO","paragraph_zero_based":326},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":327},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":328},{"literal_text_all_w_t_and_m_t":"RAN2#122","paragraph_zero_based":329},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":330},{"literal_text_all_w_t_and_m_t":"Agreements:","paragraph_zero_based":331},{"literal_text_all_w_t_and_m_t":"1UE monitors PDCCH for RAR during Cell DTX non-active time. The ra-ResponseWindow could be started as legacy.","paragraph_zero_based":332},{"literal_text_all_w_t_and_m_t":"2UE monitors PDCCH for msg4 during Cell DTX non-active time. The ra-ContentionResolutionTimer could be started as legacy.","paragraph_zero_based":333},{"literal_text_all_w_t_and_m_t":"3Working assumption:  When the retransmission timer is running (if C-DRX is configured), the UE is expected to monitor PDCCH, like in legacy.  It is up to the network whether it schedules retransmissions out of the Cell DTX active period, i.e., when the DRX retransmission timer is running, the UE should monitor PDCCH regardless of the Cell DTX.   ","paragraph_zero_based":334},{"literal_text_all_w_t_and_m_t":"4Once gNB recognizes there is an emergency call or public safety related service (e.g. MPS/MCS), the NW should ensure there is no impact to the emergency call (e.g. may deactivate Cell DTX/DRX).  The behavior is captured in stage 2 spec","paragraph_zero_based":335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2fe1425c1c3063be5b4937213502c4c58233154398c18acff6d04d26b4f67c54","original_member_sha256":"375d1cea2f37b63857f0be6a2a7c087c2f244f800e054566b630753125bd895f","paragraph_ElementTree_utf8_XML_sha256":["a5f290d286c9c60e7e193c72bb26da826fcebf8524530cf19033fc8b2fabef5c","a5819ea0fbc5359edf2c71530cd18d78cb58787cee9ad6183aa4e87066e01dd5","4742850c81f53b6c47c09ed8799e259dc6947f4ed9d820c70196048e6805fbc7","08b3bcee95cb14c24560feef1b042d1ede07b1b78cbc2543997d1db7fe0e34f5","2fe611d208a2d3fefcce3573f3edc64f74f695561080ce2f0fd004b7cd53c2dd","e749cadb4e46921ef5e2f556cf561621437305831b3e31dad08c54d88b5818fd","539341f49c7b573f07fc9dacab5d147fa2441563d1821f65055d9e934957f3b1","8848bd303b800f480a1330f32dc95ad5c6d9dc10342a07188c85f5f002565f38","3a2f8ac227b253baf98a82ff8e37e4ebbbf3694694e5db337db1a5bdeb91d1d9","34281396065335f09cd03005c477806c831d6c08024d4b7a21f19fba3fe8bcfc","978e6a757fe46e66a87465bcd47a3a5a2c48d5167806de644e92d3522eed8471","fb0aa829ab1c56e0982652c1ea88cab181ef932244599db363237205932293f3","0b896e81c61d6f35ada6bcda7a4d1c4ad2d7234d8358236af0009947f1316274","b7cfa939a82081f9e328265e5eae4e5a6b092407514bd0a912b14761ac8b9f4c","0a77bc31ab2482a34055b255c66e02973fb99a666ee38acf25d65f41e18bcc85","c702b1fb0c6582a8caef6aa8108f6ff46930a779858289e7c97f34d481380736","68febbfb9c0a9c8d18b05e14e620986dd2eb135fe06a221f9657d97f5d586f67","2ce837b00ddb64de30b3c81612f1fa3f61a8cff1dc94417278ee839f9cd270c7","dc6722595b593928d81a7b8bca6d43ce146a5bf0e18431c69f4180b054fdc8f5","7224feddc0ea9faa4b77a0ad255087c9c79713be48843681c185063d1d6efbf6","97be840a7700e9c7e3e3c3bf1167b04a73e32fa9ee378f4b62f446e2315de674","5967f83aa06995a25793e3fe95bf766fd341413bedb5c4c1c4ec64b1a5c566c3","0c27e29b0f19b3d645555077cdf3d6ff1a64725edc2dd23deafc2d5c14dc64a8","296afbf7a3df4c18d5eb8784dfb229c5c0f948c9769e3aab26e6e715f84bc712"],"paragraph_range_zero_based":[312,335],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312967.zip::R2-2312967.docx:p312"}
{"fields":{"filename":"R2-2312967.zip::R2-2312967.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5When an DG grant is received, by the gNB during cell DRX/DTX, the UE follows the grant assignment (i.e. like in legacy).  This includes DL HARQ feedback.  ","paragraph_zero_based":336},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":337},{"literal_text_all_w_t_and_m_t":"Agreements:","paragraph_zero_based":338},{"literal_text_all_w_t_and_m_t":"If RAN4 conclude SSB-less SCell for inter-band CA for FR1 and co-located cells is feasible, the signaling of intra-band CA (including RRC change on timing of SSB-less SCell and capability signaling) can be considered as its baseline. Whether other new signaling is required depends on RAN4 input.","paragraph_zero_based":339},{"literal_text_all_w_t_and_m_t":"If RAN4 concludes it is feasible, RAN2 can further work on at leaest the following specification impacts:","paragraph_zero_based":340},{"literal_text_all_w_t_and_m_t":"-RRC configuration of the frequency of the SSB to be used for the UE to obtain the timing reference for the inter-band SCell.","paragraph_zero_based":341},{"literal_text_all_w_t_and_m_t":"-UE capability reporting to indicate whether UE supports configuration of inter-band SCell that does not transmit SS/PBCH block.","paragraph_zero_based":342},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":343},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":344},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":345},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":346},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":347},{"literal_text_all_w_t_and_m_t":"Agreements:","paragraph_zero_based":348},{"literal_text_all_w_t_and_m_t":"We will define UE capabilities with signaling.  Details are FFS and will be discussed later during the WI phase.  ","paragraph_zero_based":349},{"literal_text_all_w_t_and_m_t":"Separate camping restrictions for NES-capable and non-NES UEs will be defined.  FFS if it is a single bit or more.   ","paragraph_zero_based":350},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":351},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":352},{"literal_text_all_w_t_and_m_t":"Agreements","paragraph_zero_based":353},{"literal_text_all_w_t_and_m_t":"1.We will have a CHO solution that considers NES mode of at least source cell.  ","paragraph_zero_based":354},{"literal_text_all_w_t_and_m_t":"2.We can have a specific NES CHO execution condition based on source cell NES mode.   FFS how the UE determines is in NES mode.   FFS on how this is achieved in RRC","paragraph_zero_based":355},{"literal_text_all_w_t_and_m_t":"3.We will not introduce new L1 signalling for the purpose of CHO","paragraph_zero_based":356},{"literal_text_all_w_t_and_m_t":"4.Event A3, A4, A5 can be configured as a CHO execution condition in the NES scenario.   We will study the time based mechanism","paragraph_zero_based":357},{"literal_text_all_w_t_and_m_t":"RAN2#123","paragraph_zero_based":358},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2fe1425c1c3063be5b4937213502c4c58233154398c18acff6d04d26b4f67c54","original_member_sha256":"375d1cea2f37b63857f0be6a2a7c087c2f244f800e054566b630753125bd895f","paragraph_ElementTree_utf8_XML_sha256":["cbb8056e1a217d1d4a4c63f61ad8c108b38a9d9250b8d15d6ec275cf17a38d6d","5bb24263b556cd72a6c9660d86ff37a7421527ffe438b35be93d421d5937aa93","cf9da81a1c42b6a547d72367f4eca7901039abcd4698528be7541348ccad71a5","c855d3ee3c631b1a9056975f18d65b54ad00de149f0e8b88ffb33d907cc70712","8d64c0b52460074ae7fb4f23fe58f142d720f63806b67ee14d9f0a0223e4493f","a1ae2ac7b741f06fd333541a5e57d45a44bbaf6a77ac167794757e5e6a8dce5b","9100d53c8e0d2b7f73212533c2278cb74a2c55955760a7e32cc2ed5752493ace","9f539656711e18e0867761b846eda3a8a268b5965b6779641a87a547aa2ad7c3","50dbe1592a799c2530bf019c10d8fdd1a92d94747d404178ea95dc8611f08f11","b7f39a47acd936ecb0ffc46dff81e240751923c64bb0c434168d151d5d29af61","f5c791059e284994ef0ad7cb7f8e2b051dff8ace1662379f50344c4dff8e2698","7a884010e7afc2cf2e2b868bc72d706539aaac8f90e5324591ac42a8befd9776","14eb69a96d736ef535c2591955a0eeccdc8ed875673371222913b04f65ab0a3f","b1da92322a5e19bb95d414403b5dd05f3cc59f0aa1c7c6d35c664b45df62647f","f22673ad1d5c73ecea4b35ac5d89bdc3f542e8c97255c4e0829a305a996d4bea","0112d93bcbc584e366636f7a277542bed317fa38bda621b4365d7cd45204cd24","4e3c441fcbece5f9075031f3afd69e3a331a08de21d77958ff7ef817b54cbc62","e3b5f8fba985781124980c9b0154ab8feff9c46f61d1974534fb2b38a4e05ccc","a093afaeb024b57270b8bf404ad21dddc89132db79601fbd69c5d1eeb13a082c","aaa6ad2dde4ca3357d8d77eb25e62cd2be63ef83c10f494648c239bac280d617","58d19d2226b3e20d149d847778fb79e864ca2622fdf00b838096ad0e37bbb994","415d89acb0d4bdbc43b6f1fdc4d4e5580a8dc572e2dae429a9beb28ea206011a","788a52ec2601bde0303fb9f56a46c799050a8a936f6dbda79651550778f23761","97b006303acd215c4533ed2a4226b18aa3a3dd98e5e59aaa996e2c0180c55911"],"paragraph_range_zero_based":[336,359],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312967.zip::R2-2312967.docx:p336"}
{"fields":{"filename":"R2-2312967.zip::R2-2312967.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Agreements:","paragraph_zero_based":360},{"literal_text_all_w_t_and_m_t":"1Activation/deactivation is per serving cell.  FFS if the configuration is per cell or per MAC entity ","paragraph_zero_based":361},{"literal_text_all_w_t_and_m_t":"2RAN2 will reuse the start timer formula of the onDurationTimer from UE C-DRX (including SlotOffset) to specify the start of cellDTX-onDurationTimer (and cellDRX-onDurationTimer) in 38.321.","paragraph_zero_based":362},{"literal_text_all_w_t_and_m_t":"3The gNB should ensures that there is at least partial overlapping between UE C-DRX on-duration and cell DTX/DRX on-duration.  It is up to network implementation to ensure the alignment.  We will capture this in stage 2 specification.  ","paragraph_zero_based":363},{"literal_text_all_w_t_and_m_t":"Understanding is that alignment means that the cell DTX/DRX and C-DRX periodicity should be multiple of each other.   FFS if we anything needs to be specified in stage 3 (i.e. in IE description)","paragraph_zero_based":364},{"literal_text_all_w_t_and_m_t":"4As a baseline legacy C-DRX reconfiguration is used to change UE C-DRX configuration once Cell DTX/DRX is activated/deactivated.","paragraph_zero_based":365},{"literal_text_all_w_t_and_m_t":"5RAN2 specifies cellDTX-onDurationTimer (and cellDRX-onDurationTimer) to have the same value range as UE C-DRX on-duration timer. ","paragraph_zero_based":366},{"literal_text_all_w_t_and_m_t":"6RAN2 specifies cellDTX-Cycle (and cellDRX-Cycle) to have the same value range as UE C-DRX Long cycle. ","paragraph_zero_based":367},{"literal_text_all_w_t_and_m_t":"7Separate DTX and DRX configuration means that the features can be enabled separately (i.e. Cell DTX can be configured without Cell DRX)","paragraph_zero_based":368},{"literal_text_all_w_t_and_m_t":"8On-duration and Cycle parameters are common between cell DTX and DRX, when both are configured.  FFS if we have different start offset configuration for cell DTX and cell DRX","paragraph_zero_based":369},{"literal_text_all_w_t_and_m_t":"9RAN2 will not introduce a MAC CE for cell DTX/DRX (de)activation.  ","paragraph_zero_based":370},{"literal_text_all_w_t_and_m_t":"10Confirm working assumption, when the retransmission timer is running (if C-DRX is configured), the UE is expected to monitor PDCCH, like in legacy.  It is up to the network whether it schedules retransmissions out of the Cell DTX active period, i.e., when the DRX retransmission timer is running, the UE should monitor PDCCH regardless of the Cell DTX.","paragraph_zero_based":371},{"literal_text_all_w_t_and_m_t":"11We focus on the case where DTX in RRC can only be configured when C-DRX is configured.  We will not optimize for the case where C-DRX is not configured.","paragraph_zero_based":372},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":373},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":374},{"literal_text_all_w_t_and_m_t":"Agreements","paragraph_zero_based":375},{"literal_text_all_w_t_and_m_t":"-One single bit in SIB1 is introduced for controlling all “NES-capable UEs” to access a cell.  FFS what “NES capable UE” bit means.  The NES UE always follows the NES bit used for barring, if present.  If not present the UE shall follow legacy barring.  ","paragraph_zero_based":376},{"literal_text_all_w_t_and_m_t":"-No new cell baring techniques for non-NES UEs will be specified.  ","paragraph_zero_based":377},{"literal_text_all_w_t_and_m_t":"-No new cell re-selection techniques will be considered in this Rel-18","paragraph_zero_based":378},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":379},{"literal_text_all_w_t_and_m_t":"Agreements ","paragraph_zero_based":380},{"literal_text_all_w_t_and_m_t":"1We will support the CHO triggers for the use case of turning off the cell ","paragraph_zero_based":381},{"literal_text_all_w_t_and_m_t":"2(At least for cell DTX/DRX) Time-based CHO is not to be considered in NES.","paragraph_zero_based":382},{"literal_text_all_w_t_and_m_t":"3 Do not consider using an indication in SIB1 for triggering NES CHO execution condition","paragraph_zero_based":383}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2fe1425c1c3063be5b4937213502c4c58233154398c18acff6d04d26b4f67c54","original_member_sha256":"375d1cea2f37b63857f0be6a2a7c087c2f244f800e054566b630753125bd895f","paragraph_ElementTree_utf8_XML_sha256":["2182bac00a5a9d0e9c50640cab5109d3918266ad048a9163b2a393ab157acaa9","362e961443652dec5eaaef075c1d4907f7da1ed9c75a1942ed190bd4f135d1d1","87368434afa0ffdf992e6cc71f53ba13690867acc56705cd2205c05e34fd692f","e3e510ca4ca5a8b9205ffba85a6be5baeaf4610c09e8c1103968118b0b4e2b33","83ac923f2a3e7cecf93b6569a667ce190d43f92f99d8d3a4ed4c2ae494d36465","f546cbf7f89b336b5b69a736e7c2af5cb12ea73d3df828011947709ec2175490","d15bb290ee52f615f0f400d51ec2960ac4b561157114f61149558ce626b5aa9d","4b87686ca568b7bef317f1bd5d5b77faf6f0f54f39c27fb23f4cb96122605f37","ca099f4619d81f3927835e4612ec4be3872f26d9e3e659711ddef44a348957c7","d343469dbe829e1a1a7e96d9b7fa127dd23f3079175f46a049fbafb9a45969f2","c8b7b278a35a86e3ff5c7e98432de51de75d6cc9897043548d9a43064cdba8cd","7e23564077fcb70df2f1297a21951291484f56c47741e3dc0d5ddb125a8746e8","c0e4274a96d1b159ca56a95f150e3e9262151eba55be7238aa3057e22a6ead22","2c955e8f1ff1bd19e09f7b7f0d274dcc20a431af194fc94c05def4c2aaa46f98","5c9e02c143c83912b61dfc2c9e114a0409023bb779a27a2deb927737a59fbbc3","2c468cd185afb523a30da0758312dafa3716db6d9f7b71c1ea77852bfad398fb","bc562c3cdf25c3ba5c2bebea33bf607f8277ddd9440bf0ea2800dbe82b217882","1347666f16dd543bbb7b8b0f380d45f4c1278e97a2df94ea0d879f52d2d9b2d5","0718ad0067a435689bc192171dd5273eeb3f52018d4c47fe9b459a5419a9c600","f9014c4c836c43c1b7e5bb228761151d2738f1c2b1d2b4dfadcbc9936b5589e0","eed279b3bfa825e1165657b31c2f8035f004f83a7fbcbe70ba889377502ba52a","42aa45fe3c65687f19020090f770f671ecd7cf458b6c4e5c3aba13c3623dda69","b87acca460d9ba7db12f1d161d10ff48ba2beebdc5588d57a8625322c169e70f","0d3b6117972450efc7842457a8fb9c9b2403d36b87a1129d7201bc5635ecbaab"],"paragraph_range_zero_based":[360,383],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312967.zip::R2-2312967.docx:p360"}
{"fields":{"filename":"R2-2312967.zip::R2-2312967.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":384},{"literal_text_all_w_t_and_m_t":"RAN2#123bis","paragraph_zero_based":385},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":386},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":387},{"literal_text_all_w_t_and_m_t":"Agreements","paragraph_zero_based":388},{"literal_text_all_w_t_and_m_t":"Cell DTX/DRX configuration is provided per Serving Cell with the following restrictions:","paragraph_zero_based":389},{"literal_text_all_w_t_and_m_t":"A maximum of two cell DTX/DRX patterns can be configured per MAC entity ","paragraph_zero_based":390},{"literal_text_all_w_t_and_m_t":"The two configured patterns are aligned, ","paragraph_zero_based":391},{"literal_text_all_w_t_and_m_t":"The start and slot offset are common for the two patterns.","paragraph_zero_based":392},{"literal_text_all_w_t_and_m_t":"one periodicity is an integer multiple of the other.","paragraph_zero_based":393},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":394},{"literal_text_all_w_t_and_m_t":"Working assumption: UE triggers RACH upon determining that an emergency call is initiated during the cell DTX/DRX non active period. We rely on the UE implementation to determine whether an emergency call is initiated.  We will take time to check until next meeting to confirm the WA.","paragraph_zero_based":395},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":396},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":397},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":398},{"literal_text_all_w_t_and_m_t":"Agreements on CP open issues:","paragraph_zero_based":399},{"literal_text_all_w_t_and_m_t":"Introduce explicit activation/deactivation in RRC once DTX/DRX is configured (i.e. not for dynamic activation/deactivation).   This reverses previous agreement on implicit activation.","paragraph_zero_based":400},{"literal_text_all_w_t_and_m_t":"Start offset and slot offset configuration is also common between Cell DTX and Cell DRX when both are configured ","paragraph_zero_based":401},{"literal_text_all_w_t_and_m_t":"Standalone cell DRX configuration is possible to configure  ","paragraph_zero_based":402},{"literal_text_all_w_t_and_m_t":"Multiple configurations of Cell DTX/DRX are not pursued in Rel-18 for serving cell.  ","paragraph_zero_based":403},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":404},{"literal_text_all_w_t_and_m_t":"Agreements for MAC open issues:","paragraph_zero_based":405},{"literal_text_all_w_t_and_m_t":"The case that Cell DRX activation is received between delivering a configured grant to the HARQ entity and HARQ processing for the CGO will not be addressed by RAN2, as it is not valid for the MAC model.  ","paragraph_zero_based":406},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":407}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2fe1425c1c3063be5b4937213502c4c58233154398c18acff6d04d26b4f67c54","original_member_sha256":"375d1cea2f37b63857f0be6a2a7c087c2f244f800e054566b630753125bd895f","paragraph_ElementTree_utf8_XML_sha256":["002cb805aef6cd131c05f04f2dd67bfe8a50c8f944e1fbcdca6e879011cce092","1a3d407f9f26f0f8ab7e547062ee2b6307cd238f6d35cc5d53a944474f297f4f","4c3b76033c4d5f697cab19bee950ca3f4657d233f9d1afe4ccf181b0a22f992c","a55f349867dbba45666baebb071a505ccb08a2bf208e03cccdfbeca3f9c08ce0","52fc2638a0ecfd82f3c709bd8652a4608b45c0182b2125e7dd0bc06ec2c633a3","1d95f1dbf5e1bcce7da450867a03f4890ccece5ed19523d3cbfe4d2c4522f1b0","58314c37de47a1550d7fc124c37768f37eefee623e9825d6fb3511d23a084e25","3abf5d60ce27f76c1f35e02cc3c0061feea475a86c4aedb38038fcc94d0874d0","f9507be40d7e1c6286b1da389d331661a4b9ce45a8771f5fe667fc264f7212b1","235367220b3be3fc3087338946339556b524b1fc3dfb6f7e4af6efb76405010e","97f6576aca740603efd87f04a8185607cb62b6029f8a5efa03c53836c8c71999","10701d5e08432023d75da6011c326a3ffffecf153bee1cd23ef84489cf093044","a1883ecf74d46c0cc001508fe3957c120b80df91735598f99b97cc92ebae4f27","88d2e85909996613c741e628773e18a4759c4c43fb6795fa783b8031324b89cb","b0343109cb603c7a51331bcb6977454e3c8c5917a1b58f58f0820ccf81cb6229","41fde0665746f4f9b82cc15d71290b592dd1b681da4e4afc87a5d2523b79ac6a","230562dbf2c47ce0d869692eacbb9bb9b78a1bb33e45c19b6045fb2cfaed350f","edd160c19a16f53e53c731eadad0eb6c7b50165f18fd9de34e3471a4dc4284cf","6158574239f87114a4bfa6a074df8a81dd3f98897015f0e77395af786e7f9da2","033e05aea92ac89103e5cc08c00e5080fb68f3fca5044941889b47721fe60ff7","4d093693584023e1f206cc8589df32e0d2d21079a3660ee1ccc80ac3ae1e67f3","4be9957b421cddd49f4430215aed06a99e2b1d195ddf9217d57638549d6bf841","e5ea41e2ec9401a5d9f3ea1bf72775d3bdf84d00aaac72468690007306632be1","1e48ea3f24b0afa1b14e93f535af2a80f8d8a49f214aca5367a5bd9fee27cfd0"],"paragraph_range_zero_based":[384,407],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312967.zip::R2-2312967.docx:p384"}
{"fields":{"filename":"R2-2312967.zip::R2-2312967.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":408},{"literal_text_all_w_t_and_m_t":"Agreements for cell reselection:","paragraph_zero_based":409},{"literal_text_all_w_t_and_m_t":"For NES-capable UEs, introduce single code point, meaning not barred.","paragraph_zero_based":410},{"literal_text_all_w_t_and_m_t":"A NES-capable UE in the cell barring context is at least UE supporting cell DTX/DRX.  FFS if other NES features will need to be included only if legacy impact is found.   FFS how we capture it in the CR in terms of wording","paragraph_zero_based":411},{"literal_text_all_w_t_and_m_t":"If the NES UE is barred in the NES cell and the IntraFreqReselection field of the MIB is set to ‘Not Allowed’, the UE cannot reselect to another cell of the same frequency as the barred cell.  If it is set to “Allowed” UE follows intra frequency reselection bit in the MIB.","paragraph_zero_based":412},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":413},{"literal_text_all_w_t_and_m_t":"=>RAN2 agrees that there no RAN2 impact of paging enhancement. The paging failure could be avoided by proper NW implementation.","paragraph_zero_based":414},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":415},{"literal_text_all_w_t_and_m_t":"Agreements","paragraph_zero_based":416},{"literal_text_all_w_t_and_m_t":"Group common DCI format 2-X is reused to notify the UE that source cell is entering NES mode.","paragraph_zero_based":417},{"literal_text_all_w_t_and_m_t":"•add one bit of DCI 2-X to trigger both use cases of Cell DTX/DRX activation and cell turning off. RAN2 send LS to RAN1 to request this signaling change.","paragraph_zero_based":418},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":419},{"literal_text_all_w_t_and_m_t":"Agreements:","paragraph_zero_based":420},{"literal_text_all_w_t_and_m_t":"RAN2 will not specify anything related to target cell NES mode for CHO","paragraph_zero_based":421},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":422},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":423},{"literal_text_all_w_t_and_m_t":"Agreements:","paragraph_zero_based":424},{"literal_text_all_w_t_and_m_t":"design a new MAC CE for activating/deactivating SP CSI report configurations and selecting N out of L subconfigurations for each CSI reportconfiguration.","paragraph_zero_based":425},{"literal_text_all_w_t_and_m_t":"The new MAC CE can be used to activate/deactivate configuration and sub-configuration. One new bit per sub-configuration will be added to activate/deactivate.  ","paragraph_zero_based":426},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":427},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":428}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2fe1425c1c3063be5b4937213502c4c58233154398c18acff6d04d26b4f67c54","original_member_sha256":"375d1cea2f37b63857f0be6a2a7c087c2f244f800e054566b630753125bd895f","paragraph_ElementTree_utf8_XML_sha256":["7c9d9b0bcd4bc498d736bc0c420c98e8e65bffa1c07207f7277371b2711cb688","f9e7fcc7a13a8153fa0ad68eed2fb2638f348c6924cfa205e7e35d3ba20ce81b","01cd710dcec03134d05a076700a26fc8787e9f32a5dc4c4752702860a4cdd051","5ba54f2383ffca00fa032183133bd37a39a68e89e805f436f9d445c2e9dd3045","f51805b8d5b2bd59f1b72f87490b0c057d3bb70348ab35824cea899631ef316a","5e2469509ffdba50da12c887b2884e6c9bcd8991ad4fd0d3d249af70a20ef9db","54e0f11b843925b794cff44f49aa789553c45c714bfb6804732001087f84d400","b053abd9cef0b44ea68cc9c78eefd7c28dc2bd703783ccd37cd2528fcc9789f4","630f0f5dc3a6e0967754b568527efc3dfef4c0fe68e15a0b5c4e9bc8b32622d2","f45a5c537a89eab2d10a1ca228d9f016dca2f710e5360ff0b47a3b273c646273","f1c71743019fd01f0f3e37b9d6c2b5bb0e134cf07a4783a72b5241b0c70e4a1f","aaddc5c2ac91f0c19df61afb93629d1e8ade28bb602dbbbaedf85f5