{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":24216},{"literal_text_all_w_t_and_m_t":"-- TAG-PUSCH-SERVINGCELLCONFIG-START","paragraph_zero_based":24217},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24218},{"literal_text_all_w_t_and_m_t":"PUSCH-ServingCellConfig ::=             SEQUENCE {","paragraph_zero_based":24219},{"literal_text_all_w_t_and_m_t":"    codeBlockGroupTransmission              SetupRelease { PUSCH-CodeBlockGroupTransmission }       OPTIONAL,   -- Need M","paragraph_zero_based":24220},{"literal_text_all_w_t_and_m_t":"    rateMatching                            ENUMERATED {limitedBufferRM}                            OPTIONAL,   -- Need S","paragraph_zero_based":24221},{"literal_text_all_w_t_and_m_t":"    xOverhead                               ENUMERATED {xoh6, xoh12, xoh18}                         OPTIONAL,   -- Need S","paragraph_zero_based":24222},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":24223},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":24224},{"literal_text_all_w_t_and_m_t":"    maxMIMO-Layers                          INTEGER (1..4)                                          OPTIONAL,   -- Need M","paragraph_zero_based":24225},{"literal_text_all_w_t_and_m_t":"    processingType2Enabled                  BOOLEAN                                                 OPTIONAL    -- Need M","paragraph_zero_based":24226},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":24227},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":24228},{"literal_text_all_w_t_and_m_t":"    maxMIMO-LayersDCI-0-2-r16               SetupRelease { MaxMIMO-LayersDCI-0-2-r16}               OPTIONAL    -- Need M","paragraph_zero_based":24229},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":24230},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":24231},{"literal_text_all_w_t_and_m_t":"    nrofHARQ-ProcessesForPUSCH-r17          ENUMERATED {n32}                                   OPTIONAL,   -- Need R","paragraph_zero_based":24232},{"literal_text_all_w_t_and_m_t":"    uplinkHARQ-mode-r17                     SetupRelease { UplinkHARQ-mode-r17}                     OPTIONAL    -- Need M","paragraph_zero_based":24233},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":24234},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":24235},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24236},{"literal_text_all_w_t_and_m_t":"PUSCH-CodeBlockGroupTransmission ::=    SEQUENCE {","paragraph_zero_based":24237},{"literal_text_all_w_t_and_m_t":"    maxCodeBlockGroupsPerTransportBlock     ENUMERATED {n2, n4, n6, n8},","paragraph_zero_based":24238},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":24239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["0783fe4ec337bba3fbfe8ec43b1913c9f090e9d67adc0a255511c4ee4c7a1e16","a94e9a1c76ce59d9da3fc89fc8ae9ae8ec3628ce29723d6948134e3b934826ce","ca642984136641abe8939ce196715dc891a9abf70258a0768dd755cf1996202a","9b2fc09b57ef45a992b606e58d0c8d4d331b2ecd01cc700d5d741891f30325d0","810bf2efad5343647a85581a9337d04e91f0a9b6084f173002a0b90917680563","65686fc6096f9da878455a0cd5ec97cb447c4e616bc645de47cd0f536d3849a8","02c3eb6444ad5390574bb004ec976d08d43b110938aafcaf18ae70111bba6b99","61e3bfd72e34a96b46e404275635094e313b36752090103d399f4c398175ed1c","0fced7f722e08775ce7408caebbb3692be00b1191edfa3bd5b07cabd81f49596","bbc1eb0414baf2280eb7132c7c3c9fa9f047732114d1b5b33d6e33228a4a3ac8","6a81467a