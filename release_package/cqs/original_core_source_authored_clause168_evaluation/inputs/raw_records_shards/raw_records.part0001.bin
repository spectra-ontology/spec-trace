{"fields":{"filename":"R2-2401569.zip::R2-2401569 RRC corrections for XR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.3.5.5.12Uu Relay RLC channel release","paragraph_zero_based":2352},{"literal_text_all_w_t_and_m_t":"The L2 U2N Relay UE or N3C relay UE shall:","paragraph_zero_based":2353},{"literal_text_all_w_t_and_m_t":"1>for each Uu-RelayRLC-ChannelID value included in the uu-RelayRLC-ChannelToReleaseList that is part of the current configuration within the same cell group (LCH release):","paragraph_zero_based":2354},{"literal_text_all_w_t_and_m_t":"2>release the RLC entity as specified in TS 38.322 [4], clause 5.1.3;","paragraph_zero_based":2355},{"literal_text_all_w_t_and_m_t":"2>release the corresponding logical channel.","paragraph_zero_based":2356},{"literal_text_all_w_t_and_m_t":"5.3.5.5.13Uu Relay RLC channel addition/modification","paragraph_zero_based":2357},{"literal_text_all_w_t_and_m_t":"For each Uu-RelayRLC-ChannelConfig received in the uu-RelayRLC-ChannelToAddModList the L2 U2N Relay UE or N3C relay UE shall:","paragraph_zero_based":2358},{"literal_text_all_w_t_and_m_t":"1>if the current configuration contains a Uu Relay RLC channel with the same uu-RelayRLC-ChannelID within the same cell group:","paragraph_zero_based":2359},{"literal_text_all_w_t_and_m_t":"2>if reestablishRLC is received:","paragraph_zero_based":2360},{"literal_text_all_w_t_and_m_t":"3>re-establish the RLC entity as specified in TS 38.322 [4];","paragraph_zero_based":2361},{"literal_text_all_w_t_and_m_t":"2>reconfigure the RLC entity in accordance with the received rlc-Config;","paragraph_zero_based":2362},{"literal_text_all_w_t_and_m_t":"2>reconfigure the logical channel in accordance with the received mac-LogicalChannelConfig;","paragraph_zero_based":2363},{"literal_text_all_w_t_and_m_t":"1>else (a logical channel with the given uu-RelayRLC-ChannelID was not configured before within the same cell group):","paragraph_zero_based":2364},{"literal_text_all_w_t_and_m_t":"2>establish an RLC entity in accordance with the received rlc-Config;","paragraph_zero_based":2365},{"literal_text_all_w_t_and_m_t":"2>configure this MAC entity with a logical channel in accordance to the received mac-LogicalChannelConfig.","paragraph_zero_based":2366},{"literal_text_all_w_t_and_m_t":"5.3.5.5.14NCR-Fwd configuration","paragraph_zero_based":2367},{"literal_text_all_w_t_and_m_t":"The NCR-MT shall:","paragraph_zero_based":2368},{"literal_text_all_w_t_and_m_t":"1>if NCR-FwdConfig is set to setup:","paragraph_zero_based":2369},{"literal_text_all_w_t_and_m_t":"2>if NCR-FwdConfig includes periodic forwarding resource configuration:","paragraph_zero_based":2370},{"literal_text_all_w_t_and_m_t":"3>indicate to NCR-Fwd to forward in accordance with the configured periodic forwarding resource set(s);","paragraph_zero_based":2371},{"literal_text_all_w_t_and_m_t":"1>else (NCR-FwdConfig is set to release):","paragraph_zero_based":2372},{"literal_text_all_w_t_and_m_t":"2>release NCR-Fwd configuration;","paragraph_zero_based":2373},{"literal_text_all_w_t_and_m_t":"2>indicate to NCR-Fwd to cease forwarding.","paragraph_zero_based":2374},{"literal_text_all_w_t_and_m_t":"5.3.5.6Radio Bearer configuration","paragraph_zero_based":2375}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"b3775a5d14ac021fc4f5f3e8002b92527fa1c052d9b7c535f196b5410b17f720","original_member_sha256":"0b2b1acef7c2981dcae001f9ad768411cade15b8ef16fbb988748fdb44fd8de1","paragraph_ElementTree_utf8_XML_sha256":["6295cdedc58886f56889744f192fbd92375b7980fe6079f0251d184f7db02f82","4d81cbc316c277076cd8f5f96b47b4c1d6a734f1f7ec5ebe63010d035f26bc75","bf8a2e4b75c352550f46d57665e82cfa1be88fa1c5f0c331137628d838647728","994383cd90bb8997e847c0d6e30ccb5891c112ece25983439447001b02f6e181","4790837ddb9d3e635e5518c9a1b31e5bb7b137591f1fd988b86a5