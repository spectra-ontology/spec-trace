{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21576},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-ResourceSet ::=          SEQUENCE {","paragraph_zero_based":21577},{"literal_text_all_w_t_and_m_t":"    nzp-CSI-ResourceSetId               NZP-CSI-RS-ResourceSetId,","paragraph_zero_based":21578},{"literal_text_all_w_t_and_m_t":"    nzp-CSI-RS-Resources                SEQUENCE (SIZE (1..maxNrofNZP-CSI-RS-ResourcesPerSet)) OF NZP-CSI-RS-ResourceId,","paragraph_zero_based":21579},{"literal_text_all_w_t_and_m_t":"    repetition                          ENUMERATED { on, off }                                                  OPTIONAL,   -- Need S","paragraph_zero_based":21580},{"literal_text_all_w_t_and_m_t":"    aperiodicTriggeringOffset           INTEGER(0..6)                                                           OPTIONAL,   -- Need S","paragraph_zero_based":21581},{"literal_text_all_w_t_and_m_t":"    trs-Info                            ENUMERATED {true}                                                       OPTIONAL,   -- Need R","paragraph_zero_based":21582},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":21583},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":21584},{"literal_text_all_w_t_and_m_t":"    aperiodicTriggeringOffset-r16       INTEGER(0..31)                                                          OPTIONAL   -- Need S","paragraph_zero_based":21585},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":21586},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":21587},{"literal_text_all_w_t_and_m_t":"    pdc-Info-r17                        ENUMERATED {true}                                                       OPTIONAL,  -- Need R","paragraph_zero_based":21588},{"literal_text_all_w_t_and_m_t":"    cmrGroupingAndPairing-r17           CMRGroupingAndPairing-r17                                               OPTIONAL,  -- Need R","paragraph_zero_based":21589},{"literal_text_all_w_t_and_m_t":"    aperiodicTriggeringOffset-r17       INTEGER (0..124)                                                        OPTIONAL,  -- Need S","paragraph_zero_based":21590},{"literal_text_all_w_t_and_m_t":"    aperiodicTriggeringOffsetL2-r17     INTEGER(0..31)                                                          OPTIONAL   -- Need R","paragraph_zero_based":21591},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":21592},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21593},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21594},{"literal_text_all_w_t_and_m_t":"CMRGroupingAndPairing-r17 ::=        SEQUENCE {","paragraph_zero_based":21595},{"literal_text_all_w_t_and_m_t":"    nrofResourcesGroup1-r17              INTEGER (1..7),","paragraph_zero_based":21596},{"literal_text_all_w_t_and_m_t":"    pair1OfNZP-CSI-RS-r17                NZP-CSI-RS-Pairing-r17                                                 OPTIONAL,  -- Need R","paragraph_zero_based":21597},{"literal_text_all_w_t_and_m_t":"    pair2OfNZP-CSI-RS-r17                NZP-CSI-RS-Pairing-r17                                                 OPTIONAL   -- Need R","paragraph_zero_based":21598},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21599}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["04ab04df121a321415dcbb0c94d60782794cd68273d77dac9b0f8faeddda2387","105c08803b3ba0241ae2b8829b365bb02f3c19ea5283a42558f7a228e7982f32","32dd6e1600e6cbe43904e0a305269db5ad698fca84c898d43a31541b05f196c6","ceb93d981bade6e8141b22ef63dde358ad154ca4e00df2a268bd13bd2c1b2728","b9783e16775925ff95b12ac9738f02cd1f12a4435fa483ccc1ae435a33018122","77721be99fc1e4c883264fa413738dea6268f5c10e7e072d453ed504f07221d8","34fc9f110263f8bb56ac70b5f39470729fb970f80cf1327775265f1674a10164","cbdbc432b0c477720c33e9a003a6bb25192ff43ce0b386992a0f9696040c5842","d954e81f5448aee5d39b0094ddcc27ce28d25336b824b45b640d981d0c722e6b","eb630e446fe3d355fcbbc8f98a6b0cefcdb002c4d4ea795b117725e2587dba30","cf369612930651fb3e09c5ff32d27da9a208a6a14f140083f19407ac3b10a4a6","dde126bba67c66160b738f315a75251954d9680942ebdcaa263ea358cf615516","f42ab9f3be93bf405cd8a610b7bdad5e770a2a9201847549702b73cde24ade10","ce9419cfbb98b5fe4176bab4d56ce273e72b4bf7bd1b00abab098d2f8229b743","e88a6040252511331d25b4904770c80c7ff0293f818cc40ef46e86663573d66c","e558901a0ef53d12c29afd4813c0889f4be4632fedc94d07c641bed3dc5a71ac","f4e3412287320e09ffd74934b78cab698edf9799744c63a45a830134a660390a","4f4146abbf1fb3ce489d2c8dc229a071bfd280bbdf1c5b16a318668bb853010a","591449796cb22c23e3a9d08ff5f01e9a80976de966cc003160ae8669ab2a7edd","0afea9db34b1e873c15ac8ac971243cf48c85900429bf8157024822294382844","f1a0989a623ba749c61b8cd4736b19aaa3d6cd0239f3c82254552b6e23ca5c4f","4a49fa4379f72acb6d021f1dcd27aa0955f58a2785cd1dbcd93c135ece89a07e","00d7dd9c360e2d1cd6273162aae972d1df180103f3a8b40fd63648f3d37654aa","6701fe9400bd6d76771691067651c328f8e9075e96f887611d3e7b50c8a955bc"],"paragraph_range_zero_based":[21576,21599],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p21576"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21600},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-Pairing-r17  ::=          SEQUENCE {","paragraph_zero_based":21601},{"literal_text_all_w_t_and_m_t":"    nzp-CSI-RS-ResourceId1-r17           INTEGER (1..7),","paragraph_zero_based":21602},{"literal_text_all_w_t_and_m_t":"    nzp-CSI-RS-ResourceId2-r17           INTEGER (1..7)","paragraph_zero_based":21603},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21604},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21605},{"literal_text_all_w_t_and_m_t":"-- TAG-NZP-CSI-RS-RESOURCESET-STOP","paragraph_zero_based":21606},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21607},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21608},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-ResourceSet field descriptions","paragraph_zero_based":21609},{"literal_text_all_w_t_and_m_t":"aperiodicTriggeringOffset, aperiodicTriggeringOffset-r16, aperiodicTriggeringOffset-r17","paragraph_zero_based":21610},{"literal_text_all_w_t_and_m_t":"Offset X between the slot containing the DCI that triggers a set of aperiodic NZP CSI-RS resources and the slot in which the CSI-RS resource set is transmitted. For aperiodicTriggeringOffset, the value 0 corresponds to 0 slots, value 1 corresponds to 1 slot, value 2 corresponds to 2 slots, value 3 corresponds to 3 slots, value 4 corresponds to 4 slots, value 5 corresponds to 16 slots, value 6 corresponds to 24 slots. For aperiodicTriggeringOffset-r16 and aperiodicTriggeringOffset-r17, the value indicates the number of slots. aperiodicTriggeringOffset-r17 is applicable to SCS 480 kHz and 960 kHz, and only the values of integer multiples of 4 are valid, i.e. 0, 4, 8, and so on. The network configures only one of the fields. When neither field is included, the UE applies the value 0.","paragraph_zero_based":21611},{"literal_text_all_w_t_and_m_t":"aperiodicTriggeringOffsetL2","paragraph_zero_based":21612},{"literal_text_all_w_t_and_m_t":"Indicates triggering offset of aperiodic NZP CSI-RS resources used for fast activation of the SCell (see clause 5.2.1.5.3 of TS 38.214 [19]), when the NZP CSI-RS resources are activated by the MAC CE (see clause 5.9 of TS 38.321 [3]). The value indicates the number of slots.","paragraph_zero_based":21613},{"literal_text_all_w_t_and_m_t":"cmrGroupingAndPairing","paragraph_zero_based":21614},{"literal_text_all_w_t_and_m_t":"Configures CMR groups and pairs. The first nrofResourcesGroup1 resources in the NZP-CSI-RS resource set belong to Group 1 and the remaining resources in the NZP-CSI-RS resource set belong to Group 2. nrofResourcesGroup1 is K1 and the number of remaining resources in the NZP-CSI-RS resource set belonging to Group 2 is K2 as specified in TS 38.214 clause 5.2.1.4.1. Maximum total number in Group 1 and Group 2 is 8 (see TS 38.214 [19], clauses 5.2.1.4.1 and 5.2.1.4.2).","paragraph_zero_based":21615},{"literal_text_all_w_t_and_m_t":"pair1OfNZP-CSI-RS, pair2OfNZP-CSI-RS","paragraph_zero_based":21616},{"literal_text_all_w_t_and_m_t":"A pair of NZP CSI-RS resources. In one pair, one resource shall belong to group 1 and the other resource shall belong to group 2 (see TS 38.214 [19], clause 5.2.1.4.1).","paragraph_zero_based":21617},{"literal_text_all_w_t_and_m_t":"nzp-CSI-RS-Resources","paragraph_zero_based":21618},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-Resources associated with this NZP-CSI-RS resource set (see TS 38.214 [19], clause 5.2). For CSI, there are at most 8 NZP CSI RS resources per resource set.","paragraph_zero_based":21619},{"literal_text_all_w_t_and_m_t":"nzp-CSI-RS-ResourceId1, nzp-CSI-RS-ResourceId2","paragraph_zero_based":21620},{"literal_text_all_w_t_and_m_t":"The nzp-CSI-RS-ResourceId1-r17 represents the index of the NZP CSI-RS resource in Resource Group 1, and nzp-CSI-RS-ResourceId2-r17 represents the index of the NZP CSI-RS resource in Resource Group 2.","paragraph_zero_based":21621},{"literal_text_all_w_t_and_m_t":"pdc-Info","paragraph_zero_based":21622},{"literal_text_all_w_t_and_m_t":"Indicates that this NZP-CSI-RS-ResourceSet, if configured also with trs-Info, is used for propagation delay compensation. The field can be present only if trs-info is present. The field can be present in only one NZP-CSI-RS-ResourceSet. If network configures this field for an NZP-CSI-RS-ResourceSet, the UE measures the UE Rx-Tx time difference based on resources configured in this resource set.","paragraph_zero_based":21623}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["c523a1b5be77b509316d7e6226fabfb599ec3db79b54dd66791a26cb854d1f4d","8296a14f7d363dfd8225aafd4fe1de9b590566e5a2ae2520171a419df4a043a6","433c1f8e6d45a8b2d0a61c3837aa4905ac49553b311f017422150ec07e324573","1759d47611fde8a46348bf795b0b0add062bbeadc7304ba8d50b17a626339957","51838b43a56a014a89b66e40a1c8fb3d18e39755282df533254150febee4eb17","4ec762a085694b4abf9d2c7d8c662fe5fcb868bd95000bde5b4c63f16fa92143","682430648f47670f88b02e6e06da7223d88c1a771e1aaeadcf95b989ffe21ecf","2eea0f30074cabf6ccdc1c8201cf560bcbe8240e59999c7dc7f9e9a8a2d174c2","2956f9d55f979e2d4a421089ace8e302ac3235b9b7ab167b63d0758740491c6d","96436bf5ea9d2708798de0f829e60934566f09e9f0d31c15e40a1b39fbb242bf","9b49e9ef146fb82693df893812475dcd1294b8737fe2e48d574f5471a2021394","8313d7d1855bd6b864af570cf035cb330dbbc55a428d45be17ff7feb981c9924","8273b6202f5bac8dd45aba40ea5920201e168366d0ba597d777b47cb64357646","9f4fbcade12000f0c97bea6dcf07ead18ef9a8832eb69034b991f417ba0ffd50","64ad001f8af70470b531bffc977b16cc5d1595ef59d1f55c78378d6058293fc7","bf76e9d7fd9facb80b5359008bb19f38aeac7dfb6a3a3b1540de06dcbb68453e","23c9348700c42113cdc791f3ac18ea166997c81980b451e95baa52ea96af5922","9ad88f84490d5f7ed083f7bcedea483e4b7d206e2949993976057e0673db5a51","5b684351a31f6a9496fc238d292f9ad5df8ad13d225cb1af0a7cd991b455355f","b05e663428f1011604120b09ec9d125c4945b330441c0476f3ce765bece8fa86","3eda817b23edd03998066eb06a506c9850893e2dd0ec1e3451f878a6de69ddb0","05bc885bfde612e16ba0a7d2cbe839a933a93c0f68d702a732f93b9df96985bd","8deae42483a886648cedeb58e8668a8cb997f2115290f8cfdd11f51d3bf566bd","a5d3b17bc4bb0d51308ad7bdd3565f4d55589cc2df45c8452f2cd0e1bbc7bfe9"],"paragraph_range_zero_based":[21600,21623],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p21600"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"repetition","paragraph_zero_based":21624},{"literal_text_all_w_t_and_m_t":"Indicates whether repetition is on/off. If the field is set to off or if the field is absent, the UE may not assume that the NZP-CSI-RS resources within the resource set are transmitted with the same downlink spatial domain transmission filter (see TS 38.214 [19], clauses 5.2.2.3.1 and 5.1.6.1.2). It can only be configured for CSI-RS resource sets which are associated with CSI-ReportConfig with report of L1 RSRP, L1 SINR or \"no report\".","paragraph_zero_based":21625},{"literal_text_all_w_t_and_m_t":"trs-Info","paragraph_zero_based":21626},{"literal_text_all_w_t_and_m_t":"Indicates that the antenna port for all NZP-CSI-RS resources in the CSI-RS resource set is same. If the field is absent or released the UE applies the value false (see TS 38.214 [19], clause 5.2.2.3.1).","paragraph_zero_based":21627},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21628},{"literal_text_all_w_t_and_m_t":"–NZP-CSI-RS-ResourceSetId","paragraph_zero_based":21629},{"literal_text_all_w_t_and_m_t":"The IE NZP-CSI-RS-ResourceSetId is used to identify one NZP-CSI-RS-ResourceSet.","paragraph_zero_based":21630},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-ResourceSetId information element","paragraph_zero_based":21631},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21632},{"literal_text_all_w_t_and_m_t":"-- TAG-NZP-CSI-RS-RESOURCESETID-START","paragraph_zero_based":21633},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21634},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-ResourceSetId ::=        INTEGER (0..maxNrofNZP-CSI-RS-ResourceSets-1)","paragraph_zero_based":21635},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21636},{"literal_text_all_w_t_and_m_t":"-- TAG-NZP-CSI-RS-RESOURCESETID-STOP","paragraph_zero_based":21637},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21638},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21639},{"literal_text_all_w_t_and_m_t":"–P-Max","paragraph_zero_based":21640},{"literal_text_all_w_t_and_m_t":"The IE P-Max is used to limit the UE's uplink transmission power on a carrier frequency, in TS 38.101-1 [15] and in TS 38.101-5 [75], and is used to calculate the parameter Pcompensation defined in TS 38.304 [20].","paragraph_zero_based":21641},{"literal_text_all_w_t_and_m_t":"P-Max information element","paragraph_zero_based":21642},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21643},{"literal_text_all_w_t_and_m_t":"-- TAG-P-MAX-START","paragraph_zero_based":21644},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21645},{"literal_text_all_w_t_and_m_t":"P-Max ::=                           INTEGER (-30..33)","paragraph_zero_based":21646},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21647}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["c1430926234e723f6a024581e185c3fc785dea7dcf555ca10bd7a92e6b307ee5","b73cf0201f412b1156cde6da30e445c711636d15e7341dcfd9b86cca6f0096f6","40b7f24da65058a8e8547dada26cd6d094e840a8fab52db427bb6d89982742f7","3c65da4c625360a235a9d4553e00213786f66e965bbac2b8f22a51ca3b971f2a","a4c29895aa9a771676b6f5bcbc54ae20dbaabd656ee8430c9b0e4017939c326f","2861b4ec13b8f3b2972e0a48f34c5d3a94d8507d80ed8dd1c1e66b8877673535","c176f1b2c835c6350c1351ec4a8027a4fd9f916da36d29ce8d62b00408605c06","37817769af7cdef94dbeaccd627f17a117308a3e637bae6d7a4aa650519e906e","170a1de988af826a7063b4cb46649663dae4e9f0ea078578eeafa93b0823e762"