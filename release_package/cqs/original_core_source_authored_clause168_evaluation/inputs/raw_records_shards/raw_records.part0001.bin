{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"dci-PayloadSize","paragraph_zero_based":18024},{"literal_text_all_w_t_and_m_t":"Total length of the DCI payload scrambled with INT-RNTI (see TS 38.213 [13], clause 11.2).","paragraph_zero_based":18025},{"literal_text_all_w_t_and_m_t":"int-ConfigurationPerServingCell","paragraph_zero_based":18026},{"literal_text_all_w_t_and_m_t":"Indicates (per serving cell) the position of the 14 bit INT values inside the DCI payload (see TS 38.213 [13], clause 11.2).","paragraph_zero_based":18027},{"literal_text_all_w_t_and_m_t":"int-RNTI","paragraph_zero_based":18028},{"literal_text_all_w_t_and_m_t":"RNTI used for indication pre-emption in DL (see TS 38.213 [13], clause 10).","paragraph_zero_based":18029},{"literal_text_all_w_t_and_m_t":"timeFrequencySet","paragraph_zero_based":18030},{"literal_text_all_w_t_and_m_t":"Set selection for DL-preemption indication (see TS 38.213 [13], clause 11.2) The set determines how the UE interprets the DL preemption DCI payload.","paragraph_zero_based":18031},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18032},{"literal_text_all_w_t_and_m_t":"INT-ConfigurationPerServingCell field descriptions","paragraph_zero_based":18033},{"literal_text_all_w_t_and_m_t":"positionInDCI","paragraph_zero_based":18034},{"literal_text_all_w_t_and_m_t":"Starting position (in number of bit) of the 14 bit INT value applicable for this serving cell (servingCellId) within the DCI payload (see TS 38.213 [13], clause 11.2). Must be multiples of 14 (bit).","paragraph_zero_based":18035},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18036},{"literal_text_all_w_t_and_m_t":"–DRB-Identity","paragraph_zero_based":18037},{"literal_text_all_w_t_and_m_t":"The IE DRB-Identity is used to identify a DRB used by a UE.","paragraph_zero_based":18038},{"literal_text_all_w_t_and_m_t":"DRB-Identity information element","paragraph_zero_based":18039},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18040},{"literal_text_all_w_t_and_m_t":"-- TAG-DRB-IDENTITY-START","paragraph_zero_based":18041},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18042},{"literal_text_all_w_t_and_m_t":"DRB-Identity ::=                    INTEGER (1..32)","paragraph_zero_based":18043},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18044},{"literal_text_all_w_t_and_m_t":"-- TAG-DRB-IDENTITY-STOP","paragraph_zero_based":18045},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18046},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18047}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["6464eb7b9bc4bbd744862691324c7f587292a20f0d4eb314db0693c5db1cd555","a14541e9ae96d233f3d0e1532e8b91558794b919fb52cb1b78652222ce744aad","86ede3af2b7de51733d4cea9062cbf36807b01cb613c9167c4c398ee18322320","ea369cdd5ed10898829bfe833420d45b4b02b973e78a831ddd330bb97c2522e3","338e4e4e9759bfe3321a0d6eb0fde6e5637bc1b3451809a2da0c5405a1f78857","004a6c885a5820942b7c47d45039d73a2af9ca7e3eb8e3c95647079f397e9009","2c73ef8b2e85a4148b0346f3c76aee4940c94bfedf84ee5436e35dc10789aa27","2b2e7f494a2b0b2edfcab15f70e75f21db3277266b38705b731a3e63c8c77d8b","d0aa81f104789e12f7686a21e702446f1bfa670aaeedf1d61918801c853e4bb4","903ef38bade5e6a21f3b70af65a2236b1940c9bd44553b74b1194626ebe5f63e","58fcd8a7f3323e210fe676d5df3ec467bc193eb7a1e3e3de5a5e70d8b2a44976","cf1feec24dff534ae68eece08c448303a0775c1417d385dc9b8ea9dd3a4742b9","cc3551faeb6b1f8ffc3ebd31105afa314bf0da351da47352abe39e1007a89cc6","969a61184cd00552844ecea261ab241a0aba6d1e70d4fd9b1