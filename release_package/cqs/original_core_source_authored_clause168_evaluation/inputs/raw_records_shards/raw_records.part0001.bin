{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Counter","paragraph_zero_based":40992},{"literal_text_all_w_t_and_m_t":"Reset","paragraph_zero_based":40993},{"literal_text_all_w_t_and_m_t":"Incremented","paragraph_zero_based":40994},{"literal_text_all_w_t_and_m_t":"When reaching max value","paragraph_zero_based":40995},{"literal_text_all_w_t_and_m_t":"N310","paragraph_zero_based":40996},{"literal_text_all_w_t_and_m_t":"Upon reception of \"in-sync\" indication from lower layers;","paragraph_zero_based":40997},{"literal_text_all_w_t_and_m_t":"upon receiving RRCReconfiguration with reconfigurationWithSync for that cell group;","paragraph_zero_based":40998},{"literal_text_all_w_t_and_m_t":"upon initiating the connection re-establishment procedure.","paragraph_zero_based":40999},{"literal_text_all_w_t_and_m_t":"Upon reception of \"out-of-sync\" from lower layer while the timer T310 is stopped.","paragraph_zero_based":41000},{"literal_text_all_w_t_and_m_t":"Start timer T310","paragraph_zero_based":41001},{"literal_text_all_w_t_and_m_t":"N311","paragraph_zero_based":41002},{"literal_text_all_w_t_and_m_t":"Upon reception of \"out-of-sync\" indication from lower layers;","paragraph_zero_based":41003},{"literal_text_all_w_t_and_m_t":"upon receiving RRCReconfiguration with reconfigurationWithSync for that cell group;","paragraph_zero_based":41004},{"literal_text_all_w_t_and_m_t":"upon initiating the connection re-establishment procedure.","paragraph_zero_based":41005},{"literal_text_all_w_t_and_m_t":"Upon reception of the \"in-sync\" from lower layer while the timer T310 is running.","paragraph_zero_based":41006},{"literal_text_all_w_t_and_m_t":"Stop the timer T310.","paragraph_zero_based":41007},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41008},{"literal_text_all_w_t_and_m_t":"7.3Constants","paragraph_zero_b