f68584d583de8d0914d05647a281c873f2a0","6f79c7aee87de01578d1b907033c90e0f9a137f19fd9c36ddfe38baef32f44f1","fe04a677651471ad9b2bba070502861ef27c1a0180d28f9f0494440122ee1a60","2be860308ae2c9eeeba002e2a0eff7ad0460f7ed9eebd41a78cc506859d6e444","3f868f52e1ed75580774c7cfea4fe901fc126b46db3119cea777c675e31d91cd","de3ace06ed4646e3b3360c29e4a3409e5ba30e5e7e1cc4c0f42dfbfcf11aa3bb","1144de0dc4417ab115fd924049aa7d2a507fe59574e9f7b4bf4f3763708614d2","41adf70f06fbbe54bb7f82da8603582809901d9e04daa29e90ba66e77a33127e","37d3a85000fd7a5360295a6ff8b7fdddb351bcd853fd173735551f71c59c440f","ac56559adcad5d7372db48ded753431a4224b39ce0dbe868423a8959201642c1","ea80875e4d14a467cc6c5643f5d63d9bb66d02d9fa35dc2efbacc1bb6c5da10f","b7f7c141bfb6ada89acaaf08e422eb4f1abee3101052aa60c317b33962ce76fe","e8b7f70fb2ccd440ef7b14cf8c9571d0d3c2261088224afb5f03e8376633f463","d3aa124bcf5aee8826f360895dfe86fbc1e816f31407e21342274eafe4277728"],"paragraph_range_zero_based":[32352,32375],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p32352"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":32376},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32377},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETDOWNLINK-STOP","paragraph_zero_based":32378},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32379},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32380},{"literal_text_all_w_t_and_m_t":"FeatureSetDownlink field descriptions","paragraph_zero_based":32381},{"literal_text_all_w_t_and_m_t":"featureSetListPerDownlinkCC","paragraph_zero_based":32382},{"literal_text_all_w_t_and_m_t":"Indicates which features the UE supports on the individual DL carriers of the feature set (and hence of a band entry that refer to the feature set). The UE shall hence include at least as many FeatureSetDownlinkPerCC-Id in this list as the number of carriers it supports according to the ca-BandwidthClassDL, except if indicating additional functionality by reducing the number of FeatureSetDownlinkPerCC-Id in the feature set (see NOTE 1 in FeatureSetCombination IE description). The order of the elements in this list is not relevant, i.e., the network may configure any of the carriers in accordance with any of the FeatureSetDownlinkPerCC-Id in this list.","paragraph_zero_based":32383},{"literal_text_all_w_t_and_m_t":"supportedSRS-Resources","paragraph_zero_based":32384},{"literal_text_all_w_t_and_m_t":"Indicates supported SRS resources for SRS carrier switching to the band associated with this FeatureSetDownlink. The UE is only allowed to set this field for a band with associated FeatureSetUplinkId set to 0.","paragraph_zero_based":32385},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32386},{"literal_text_all_w_t_and_m_t":"–FeatureSetDownlinkId","paragraph_zero_based":32387},{"literal_text_all_w_t_and_m_t":"The IE FeatureSetDownlinkId identifies a downlink feature set. The FeatureSetDownlinkId of a FeatureSetDownlink is the index position of the FeatureSetDownlink in the featureSetsDownlink list in the FeatureSets IE. The first element in that list is referred to by FeatureSetDownlinkId = 1. The FeatureSetDownlinkId=0 is not used by an actual FeatureSetDownlink but means that the UE does not support a carrier in this band of a band combination.","paragraph_zero_based":32388},{"literal_text_all_w_t_and_m_t":"FeatureSetDownlinkId information element","paragraph_zero_based":32389},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32390},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETDOWNLINKID-START","paragraph_zero_based":32391},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32392},{"literal_text_all_w_t_and_m_t":"FeatureSetDownlinkId ::=            INTEGER (0..maxDownlinkFeatureSets)","paragraph_zero_based":32393},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32394},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETDOWNLINKID-STOP","paragraph_zero_based":32395},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32396},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32397},{"literal_text_all_w_t_and_m_t":"–FeatureSetDownlinkPerCC","paragraph_zero_based":32398},{"literal_text_all_w_t_and_m_t":"The IE FeatureSetDownlinkPerCC indicates a set of features that the UE supports on the corresponding carrier of one band entry of a band combination.","paragraph_zero_based":32399}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["39e617ed5fc28dc5ee20c6e0b13330a9dccfe24add076e2315b1f2069e4d6ad6","55d717ca27860477b4449a8f