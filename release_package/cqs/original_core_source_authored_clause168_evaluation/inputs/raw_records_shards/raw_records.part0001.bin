{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field indicates how to map sidelink QoS flows to sidelink DRB.","paragraph_zero_based":38856},{"literal_text_all_w_t_and_m_t":"slrb-Uu-ConfigIndex","paragraph_zero_based":38857},{"literal_text_all_w_t_and_m_t":"This field indicates the index of sidelink DRB configuration.","paragraph_zero_based":38858},{"literal_text_all_w_t_and_m_t":"sl-TransRange","paragraph_zero_based":38859},{"literal_text_all_w_t_and_m_t":"This field indicates the transmission range of the sidelink DRB. The unit is meter.","paragraph_zero_based":38860},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38861},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":38862},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":38863},{"literal_text_all_w_t_and_m_t":"SLRBSetup","paragraph_zero_based":38864},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in case of sidelink DRB setup via the dedicated signalling and in case of sidelink DRB configuration via system information and pre-configuration; otherwise the field is optionally present, need M.","paragraph_zero_based":38865},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38866},{"literal_text_all_w_t_and_m_t":"–SL-RelayUE-Config","paragraph_zero_based":38867},{"literal_text_all_w_t_and_m_t":"The IE SL-RelayUE-Config specifies the configuration information for NR sidelink U2N Relay UE.","paragraph_zero_based":38868},{"literal_text_all_w_t_and_m_t":"SL-RelayUE-Config information element","paragraph_zero_based":38869},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":38870},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RELAYUE-CONFIG-START","paragraph_zero_based":38871},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38872},{"literal_text_all_w_t_and_m_t":"SL-RelayUE-Config-r17::=           SEQUENCE {","paragraph_zero_based":38873},{"literal_text_all_w_t_and_m_t":"    threshHighRelay-r17                RSRP-Range                              OPTIONAL,     -- Need R","paragraph_zero_based":38874},{"literal_text_all_w_t_and_m_t":"    threshLowRelay-r17                 RSRP-Range                              OPTIONAL,     -- Need R","paragraph_zero_based":38875},{"literal_text_all_w_t_and_m_t":"    hystMaxRelay-r17                   Hysteresis                              OPTIONAL,     -- Cond ThreshHighRelay","paragraph_zero_based":38876},{"literal_text_all_w_t_and_m_t":"    hystMinRelay-r17                   Hysteresis                              OPTIONAL      -- Cond ThreshLowRelay","paragraph_zero_based":38877},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":38878},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38879}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["21332caea83a6fbaaa6c1d2555a95d7e859a82b8d48a2853d45c960ae73de99e","a4c515515db0b2f97837b10f171abbfb0d4cf4dee01d5bd8a9bdc1fbae071165","a297448e8af88d21ec96ccd11fca1b510bd8e094b87afff58437604f2ecd531d","27395f39cdeaeb6121ab1c7db0c2ca608a3da10a5aeb4ea2eea574f27844c830","e69afd9cd6716e6d94cf5f672705e63e9d7d8da2bb8687fc0404d8f015326c71","47ca0d5f4f701c53a8a37f59432fa9d1fa5a3e145a15a95368d993a4c88543f3","5a5184136be6ea20e166f13a6b5fded13c13a40e93565f35876cac03ddacc04e","192444668b2bb9edb4caee459ab87d0d91bd6755214ba632a48d3a6912653939","99a64d8b7bb365eeaefb3ff1f11efcb353806873febb50a21f8b6fbf658a0019","54e89d3638dc535824392d970439bbd2a03c6216ab790f9f48d30c7c4efa4635","27364cbbc80a5d59d47526dbdc4460b6a627c9654d596bcd3e4949ebc78cc1a9","33f0e