_based":37982},{"literal_text_all_w_t_and_m_t":"                                                      ms1, ms2, ms3, ms4, ms5,ms6, ms8, ms10, ms20, ms30, ms40, ms50, ms60,","paragraph_zero_based":37983},{"literal_text_all_w_t_and_m_t":"                                                      ms80, ms100, ms200, ms300, ms400, ms500, ms600, ms800, ms1000, ms1200,","paragraph_zero_based":37984},{"literal_text_all_w_t_and_m_t":"                                                      ms1600, spare8, spare7, spare6, spare5, spare4, spare3, spare2, spare1}","paragraph_zero_based":37985},{"literal_text_all_w_t_and_m_t":"                                            },","paragraph_zero_based":37986},{"literal_text_all_w_t_and_m_t":"    sl-DRX-GC-InactivityTimer-r17           ENUMERATED {","paragraph_zero_based":37987},{"literal_text_all_w_t_and_m_t":"                                                ms0, ms1, ms2, ms3, ms4, ms5, ms6, ms8, ms10, ms20, ms30, ms40, ms50, ms60, ms80,","paragraph_zero_based":37988},{"literal_text_all_w_t_and_m_t":"                                                ms100, ms200, ms300, ms500, ms750, ms1280, ms1920, ms2560, spare9, spare8,","paragraph_zero_based":37989},{"literal_text_all_w_t_and_m_t":"                                                spare7, spare6, spare5, spare4, spare3, spare2, spare1},","paragraph_zero_based":37990},{"literal_text_all_w_t_and_m_t":"    sl-DRX-GC-BC-Cycle-r17                  ENUMERATED {","paragraph_zero_based":37991}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["454fc7b06d532a74c364b191102ed6fc7acb5c217a052780735ab65e964b6769","2b20a0949b2135e7cf5ebb332b2c3647efa1c6207be713778fbf0b0431caa2f0","525acdff9afeffceb693f6a531c