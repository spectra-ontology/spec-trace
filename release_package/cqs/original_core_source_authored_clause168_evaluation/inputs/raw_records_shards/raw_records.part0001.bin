{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    frequencyStartMsgA-PUSCH-r16                   INTEGER (0..maxNrofPhysicalResourceBlocks-1),","paragraph_zero_based":20976},{"literal_text_all_w_t_and_m_t":"    nrofPRBs-PerMsgA-PO-r16                        INTEGER (1..32),","paragraph_zero_based":20977},{"literal_text_all_w_t_and_m_t":"    nrofMsgA-PO-FDM-r16                            ENUMERATED {one, two, four, eight},","paragraph_zero_based":20978},{"literal_text_all_w_t_and_m_t":"    msgA-IntraSlotFrequencyHopping-r16             ENUMERATED {enabled}                                          OPTIONAL, -- Need R","paragraph_zero_based":20979},{"literal_text_all_w_t_and_m_t":"    msgA-HoppingBits-r16                           BIT STRING (SIZE(2))                                          OPTIONAL, -- Cond FreqHopConfigured","paragraph_zero_based":20980},{"literal_text_all_w_t_and_m_t":"    msgA-DMRS-Config-r16                           MsgA-DMRS-Config-r16,","paragraph_zero_based":20981},{"literal_text_all_w_t_and_m_t":"    nrofDMRS-Sequences-r16                         INTEGER (1..2),","paragraph_zero_based":20982},{"literal_text_all_w_t_and_m_t":"    msgA-Alpha-r16                                 ENUMERATED {alpha0, alpha04, alpha05, alpha06,","paragraph_zero_based":20983},{"literal_text_all_w_t_and_m_t":"                                                               alpha07, alpha08, alpha09, alpha1}                OPTIONAL, -- Need S","paragraph_zero_based":20984},{"literal_text_all_w_t_and_m_t":"    interlaceIndexFirstPO-MsgA-PUSCH-r16           INTEGER (1..10)                                               OPTIONAL, -- Need R","paragraph_zero_based":20985},{"literal_text_all_w_t_and_m_t":"    nrofInterlacesPerMsgA-PO-r16                   INTEGER (1..10)                                               OPTIONAL, -- Need R","paragraph_zero_based":20986},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":20987},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":20988},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20989},{"literal_text_all_w_t_and_m_t":"MsgA-DMRS-Config-r16 ::=                       SEQUENCE {","paragraph_zero_based":20990},{"literal_text_all_w_t_and_m_t":"    msgA-DMRS-AdditionalPosition-r16               ENUMERATED {pos0, pos1, pos3}                                 OPTIONAL, -- Need S","paragraph_zero_based":20991},{"literal_text_all_w_t_and_m_t":"    msgA-MaxLength-r16                             ENUMERATED {len2}                                             OPTIONAL, -- Need S","paragraph_zero_based":20992},{"literal_text_all_w_t_and_m_t":"    msgA-PUSCH-DMRS-CDM-Group-r16                  INTEGER (0..1)                                                OPTIONAL, -- Need S","paragraph_zero_based":20993},{"literal_text_all_w_t_and_m_t":"    msgA-PUSCH-NrofPorts-r16                       INTEGER (0..1)                                                OPTIONAL, -- Need S","paragraph_zero_based":20994},{"literal_text_all_w_t_and_m_t":"    msgA-ScramblingID0-r16                         INTEGER (0..65535)                                            OPTIONAL, -- Need S","paragraph_zero_based":20995},{"literal_text_all_w_t_and_m_t":"    msgA-ScramblingID1-r16                         INTEGER (0..65535)                                            OPTIONAL  -- Need S","paragraph_zero_based":20996},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":20997},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20998},{"literal_text_all_w_t_and_m_t":"-- TAG-MSGA-PUSCH-CONFIG-STOP","paragraph_zero_based":20999}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["dcf70778297de53b5df83bb3c6503dda99cf9864c6682a9a21e8992cff6c7007","4c9d2b3f896586dcba1518f1083ec067e5ad384f28674d6677a00e57eda0b35c","9bbad41b990a9de5915f0492db0daf8c507e995337e43001e888685cb16ce12d","c7ff9079b0d5924a469602985823f05c24f3ca2efcfb4c060a3ea1744793ac96","8951ace0dab4c587fb3d4f04ecaeddff4fddb6dfb818053d542c8c193b803401","64eb8b01529af11e85cd47944fef3cb14c813579320bdfb332c26a8b46b9ada3","4a7bbb68bdeab0bc06089620ec06a5d41752cadc7bbf27657da0a82a59486f33","78ef630045740abef3ca3d56f3e737fff3ab8e164dd73803aa9bda8c9c53600c","83cc4d4cc33f4e6759debd7bc012f84e0eb80bde6a001141627f64acd0c5df1f","b5bbd2269234f665195787208e1aabf334d7983770e63fe13df6150b36c22bdf","f31310b6e83648f1fd85c73c207a6b30975ce143087ca50cf38fb7de8c591626","e5d87dfc9bacbb50bf1973f7f3e4d203b0b817df904d62bedf1fe03c96dc4174","36b778392449939922c0035e4f59d3e62f72dc661c5b59ce08c1f1e08c584b0a","5a72950d3356d6bdef72f79f962c7db8573b5eecb7c37bb58bfe60207c87c7ed","c59251b9abbc52d64bde46bd1344bb224ea2d35a9c624fd6414f97530082bedd","2c286554f38e73459bac4b603092c64564986e80f9147d8ba024886fccdfb41e","6424bcd1653593609e2dcdee5c8be6d8f1ff3fb2f42a72d9241605645b53f407","36ea682e6d90d077ab53acc58f1a163e062edda517dee0751737abeaf85f0c91","b1cdb56820f593f88cd61c4d507b3e64620c8cf98f868cf10457df3f80883fba","5cd7cf2db7ef2bd39bfc5dda950639063efc53be69859c5dd16a67c0e9b75801","cd09bc35cad266f5ce000782413cedb070750fc6b4a13bd5bd7020915581578a","fc7e384821ae2978cb3dd9629fb9c37dd496a462ed36e2a71bf700fc0e6c360e","899ae4402be5d0d4822c68c6bc59a69a6b0e3750324224fcdacd25d957ccbda4","4dfe0e1372df9204a3844afae5a881e00a007b2cef3da4b53f4da8d788f317ea"],"paragraph_range_zero_based":[20976,20999],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p20976"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21000},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21001},{"literal_text_all_w_t_and_m_t":"MsgA-PUSCH-Config field descriptions ","paragraph_zero_based":21002},{"literal_text_all_w_t_and_m_t":"msgA-DataScramblingIndex","paragraph_zero_based":21003},{"literal_text_all_w_t_and_m_t":"Identifier used to initiate data scrambling (c_init) for msgA PUSCH. If the field is absent the UE applies the value Physical cell ID (physCellID).","paragraph_zero_based":21004},{"literal_text_all_w_t_and_m_t":"msgA-DeltaPreamble","paragraph_zero_based":21005},{"literal_text_all_w_t_and_m_t":"Power offset of msgA PUSCH relative to the preamble received target power. Actual value = field value * 2 [dB] (see TS 38.213 [13], clause 7.1).","paragraph_zero_based":21006},{"literal_text_all_w_t_and_m_t":"msgA-PUSCH-ResourceGroupA","paragraph_zero_based":21007},{"literal_text_all_w_t_and_m_t":"MsgA PUSCH resources that the UE shall use when performing MsgA transmission using preambles group A. If field is not configured for the selected UL BWP, the UE shall use the MsgA PUSCH configuration for group A of initial UL BWP or RedCap-specific initial UL BWP (if configured) for RedCap UEs.","paragraph_zero_based":21008},{"literal_text_all_w_t_and_m_t":"msgA-PUSCH-ResourceGroupB","paragraph_zero_based":21009},{"literal_text_all_w_t_and_m_t":"MsgA PUSCH resources that the UE shall use when performing MsgA transmission using preambles group B.","paragraph_zero_based":21010},{"literal_text_all_w_t_and_m_t":"msgA-TransformPrecoder","paragraph_zero_based":21011},{"literal_text_all_w_t_and_m_t":"Enables or disables the transform precoder for MsgA transmission (see clause 6.1.3 of TS 38.214 [19]).","paragraph_zero_based":21012},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21013},{"literal_text_all_w_t_and_m_t":"MsgA-PUSCH-Resource field descriptions ","paragraph_zero_based":21014},{"literal_text_all_w_t_and_m_t":"guardBandMsgA-PUSCH","paragraph_zero_based":21015},{"literal_text_all_w_t_and_m_t":"PRB-level guard band between FDMed PUSCH occasions (see TS 38.213 [13], clause 8.1A). If interlaced PUSCH is configured, value 0 is applied.","paragraph_zero_based":21016},{"literal_text_all_w_t_and_m_t":"guardPeriodMsgA-PUSCH","paragraph_zero_based":21017},{"literal_text_all_w_t_and_m_t":"Guard period between PUSCH occasions in the unit of symbols (see TS 38.213 [13], clause 8.1A).","paragraph_zero_based":21018},{"literal_text_all_w_t_and_m_t":"frequencyStartMsgA-PUSCH","paragraph_zero_based":21019},{"literal_text_all_w_t_and_m_t":"Offset of lowest PUSCH occasion in frequency domain with respect to PRB 0 (see TS 38.213 [13], clause 8.1A).","paragraph_zero_based":21020},{"literal_text_all_w_t_and_m_t":"interlaceIndexFirstPO-MsgA-PUSCH","paragraph_zero_based":21021},{"literal_text_all_w_t_and_m_t":"Interlace index of the first PUSCH occasion in frequency domain if interlaced PUSCH is configured. For 30kHz SCS only the integers 1, 2, 3, 4, 5 are applicable (see TS 38.213 [13], clause 8.1A).","paragraph_zero_based":21022},{"literal_text_all_w_t_and_m_t":"mappingTypeMsgA-PUSCH","paragraph_zero_based":21023}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["4037b4302865265f2e5966bb4c8d8555a47d82e3fa9c55ee7b087697c900e3e5","ee4a5b82d3b7a65402339603ce242d5b3a4f427863e174ba6d6896183ab58c40","ddd6548e87a196265fc8e7f54d6438b191f55cd57d6a0963f41e7677a9ce0556","be9439f6584b53e653fbe01eea5d22aea66754ef6baa6293d8fb86daff63a65d","acb9fea0ce36955fc0e7d97d70bb3b7c513780560052b444ee94604a257f4d60","cbc8901ab8ff99108c6a6a215ef1ccecc3ad058248f21457c4c1b4380f371da5","43119c41dd246eaa6522e91ab5d6abb8dde3ebfc0c0c466022ce2247cce687de","5a1dc5a75beaef98507e34042f434ebb4567249de7ecb3e5840ba98fee5ac7f6","75188779f0e175deda4d7c5a6d2399492f2f27e3ab7aee552328e7e5424c08a8","1056714baf6eb8c2c3f952bcbc67f900723224acfcf373fefa22033df8140ab8","b25fba5e36deff6a3917610d3efe493c79befa28fa468ba239f1d86c67725b4b","1e7fec1a6d153f1c7d621353f5de18b16b8689168cfcd441b7f7f28cae624082","f419ee23169b45268ce5c1b0bf7183150f7aec2afb96ccfd9aae33d4fd670d65","f1116de155cb9f985d08261d4084cf38d7de3caf0ec5146ca154fb9cd7401b6e","c9c84b1b8d8324ddf0d2e5d15d03f49252ab29c3eb414338c769f9a49d94ea3f","f1a32860c93f0e2875fcea58d2b78142a3353315b97713b54bea05228692709e","ded7a9e6e3d43e69e4afca347dc7f526896deca5084a2910ae752e200d60634f","ba1f54565036e8f7f7fb5af0fa5b6fea5300e5eb8da3658a914c920d27ebc7d0","bb74fb32a813a7cff264de45d9842cf181db0835f847c88e1d59de0ab6154875","fab0dccd83786f28fc791419d19cebbb23c11ad13621e51ea90bf6138e18bc8d","0f4ed823750692d600a22ad8538b26955f7582409a70c11df08ed22ddedd102e","865792fcd00779baaaa739dbb69852899b58291dec2a8aa1b6b1ab57dddc2fa1","94bbf857a8d311d2c78f8427cec81294c7c7e3d2be6e6c1741b927b5bea8e928","f6b5fe7bda3ca14ad91189f502c5fb15e3a3c6fa5726f0692177b55c7089adc9"],"paragraph_range_zero_based":[21000,21023],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p21000"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"PUSCH mapping type A or B. If the field is absent, the UE shall use the parameter msgA-PUSCH-TimeDomainAllocation (see TS 38.213 [13], clause 8.1A).","paragraph_zero_based":21024},{"literal_text_all_w_t_and_m_t":"msgA-Alpha","paragraph_zero_based":21025},{"literal_text_all_w_t_and_m_t":"Dedicated alpha value for MsgA PUSCH. If the field is absent, the UE shall use the value of msg3-Alpha if configured, else UE applies value 1 (see TS 38.213 [13], clause 7.1.1).","paragraph_zero_based":21026},{"literal_text_all_w_t_and_m_t":"msgA-DMRS-Config","paragraph_zero_based":21027},{"literal_text_all_w_t_and_m_t":"DMRS configuration for msgA PUSCH (see TS 38.213 [13], clause 8.1A and TS 38.214 [19] clause 6.2.2).","paragraph_zero_based":21028},{"literal_text_all_w_t_and_m_t":"msgA-HoppingBits","paragraph_zero_based":21029},{"literal_text_all_w_t_and_m_t":"Value of hopping bits to indicate which frequency offset to be used for second hop. See Table 8.3-1 in TS 38.213 [13].","paragraph_zero_based":21030},{"literal_text_all_w_t_and_m_t":"msgA-IntraSlotFrequencyHopping","paragraph_zero_based":21031},{"literal_text_all_w_t_and_m_t":"Intra-slot frequency hopping per PUSCH occasion (see TS 38.213 [13], clause 8.1A).","paragraph_zero_based":21032},{"literal_text_all_w_t_and_m_t":"msgA-MCS","paragraph_zero_based":21033},{"literal_text_all_w_t_and_m_t":"Indicates the MCS index for msgA PUSCH from the Table 6.1.4.1-1 for DFT-s-OFDM and Table 5.1.3.1-1 for CP-OFDM in TS 38.214 [19].","paragraph_zero_based":21034},{"literal_text_all_w_t_and_m_t":"msgA-PUSCH-TimeDomainAllocation","paragraph_zero_based":21035},{"literal_text_all_w_t_and_m_t":"Indicates a combination of start symbol and length and PUSCH mapping type from the TDRA table (PUSCH-TimeDomainResourceAllocationList if provided in PUSCH-ConfigCommon, or else the default Table 6.1.2.1.1-2 in 38.214 [19] is used if pusch-TimeDomainAllocationList is not provided in PUSCH-ConfigCommon). The parameter K2 in the table is not used for msgA PUSCH. The network configures one of msgA-PUSCH-TimeDomainAllocation and startSymbolAndLengthMsgA-PO, but not both. If the field is absent, the UE shall use the value of startSymbolAndLenghtMsgA-PO.","paragraph_zero_based":21036},{"literal_text_all_w_t_and_m_t":"msgA-PUSCH-TimeDomainOffset","paragraph_zero_based":21037},{"literal_text_all_w_t_and_m_t":"A single time offset with respect to the start of each PRACH slot (with at least one valid RO), counted as the number of slots (based on the numerology of active UL BWP). See TS 38.213 [13], clause 8.1A.","paragraph_zero_based":21038},{"literal_text_all_w_t_and_m_t":"nrofDMRS-Sequences","paragraph_zero_based":21039},{"literal_text_all_w_t_and_m_t":"Number of DMRS sequences for MsgA PUSCH for CP-OFDM. In case of single PUSCH configuration or if the DMRS symbols of multiple configurations are not overlapped, if the DMRS resources configured in one PUSCH occasion is no larger than 8 (for len2) or 4 (for len1), then only DMRS port is configured.","paragraph_zero_based":21040},{"literal_text_all_w_t_and_m_t":"nrofInterlacesPerMsgA-PO","paragraph_zero_based":21041},{"literal_text_all_w_t_and_m_t":"Number of consecutive interlaces per PUSCH occasion if interlaced PUSCH is configured. For 30kHz SCS only the integers 1, 2, 3, 4, 5 are applicable (see TS 38.213 [13], clause 8.1A).","paragraph_zero_based":21042},{"literal_text_all_w_t_and_m_t":"nrofMsgA-PO-FDM","paragraph_zero_based":21043},{"literal_text_all_w_t_and_m_t":"The number of msgA PUSCH occasions FDMed in one time instance (see TS 38.213 [13], clause 8.1A).","paragraph_zero_based":21044},{"literal_text_all_w_t_and_m_t":"nrofMsgA-PO-PerSlot","paragraph_zero_based":21045},{"literal_text_all_w_t_and_m_t":"Number of time domain PUSCH occasions in each slot. PUSCH occasions including guard period are contiguous in time domain within a slot (see TS 38.213 [13], clause 8.1A).","paragraph_zero_based":21046},{"literal_text_all_w_t_and_m_t":"nrofPRBs-PerMsgA-PO","paragraph_zero_based":21047}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["283b05c2ba07ef3e4641e26adee2eaf3b76e628696b92f832051a9f9436bfc30","74dcaafe5af715f7fab34ebf4f944f0c5a30d330d1ae90e1013fbf7cceb15730","0862316347558d1494ec77160904cd6a806062c0d8c38c2a47c6584d1c0b2707","9f063be9abd6887f24a1c15de67ff1de8a776370c8b4132c9d2e460b3f30e252","07555088aaeb14c3887009e7d59587e972e904d953d54f67b32766e83249c223","aeae4e54aff2cc57fbd03a2acda07317806860b5ce97593e193087ed927bf33c","a48cdf3bc184f119bc9803ba97b3e3d72dcc7bc3e52e40a3c833c84f339f5cd5","9c1ec9981e56db9ee239e03c1d303942a7aa887e7b61f8d69808d67e17e189dc","0154097b75bdf3f21585bd2b8cefc505bbd8c4b50a13dde4fd63e73d70c5e1fa","b53585399bbc2597f501dc7e25cf42de585f25991de173afe18ee12746b3fdae","a13da222f884517a5339d778d79a6506254a3694d6a3cb5514eeebc21e071ba7","90c0de09c2ff4c68059ccf8e29d83d73e5722a0d63b64c76e85356d0be0e6bf7","8f32744ef90fa8f1eef0569fd80f82560464ced5d355fff4b3c608a5f5775926","67f0716ac5f50ec337389292f4985187f2df921824d7a84e6db7e81b5073ab4d","0f820085429e79083a139106c788db1dc104fc7f06b6ce41e2b785710761b944","7e9fe9bad150b0043575c6a0e8b303a131475f437222b89f3af241ef6714b986","0b5c7416eb41f5107cf3a5fba7806c82cfd8a3333577fac36cb717d8a30d77df","57b9c871b048f02f05a7af40b1f3db507626ff60b3a8bc456839d6eef8897f1e","41cfb9f6128fea752ad116b944e7aade974c7a0f46fbdf89b12d453fbbc09189","876ebbb75c6befdeca06d4c0dffd7335914b9704e1ccf2d10a058fe7fafb446f","c86fefdc2b25d099e50cc6e64125c9bc796620f3102ac83dd97565cfb1434f84","f780991c43f5857cd53cbe6a0641ff228ee5184ead7ebf95ab6c9fa45d050a0c","6a04a40ca3fdb34dfef72c6df03ad6600e5f9f406be9feb88aaf9a60b68c4a8b","f76cb0813808e35bd24bc4ddb2983939aff6e5210fd1020ae1f04d35fc2a89ed"],"paragraph_range_zero_based":[21024,21047],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p21024"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Number of PRBs per PUSCH occasion (see TS 38.213 [13], clause 8.1A).","paragraph_zero_based":21048},{"literal_text_all_w_t_and_m_t":"nrofSlotsMsgA-PUSCH","paragraph_zero_based":21049},{"literal_text_all_w_t_and_m_t":"Number of slots (in active UL BWP numerology) containing one or multiple PUSCH occasions, each slot has the same time domain resource allocation (see TS 38.213 [13], clause 8.1A).","paragraph_zero_based":21050},{"literal_text_all_w_t_and_m_t":"startSymbolAndLengthMsgA-PO","paragraph_zero_based":21051},{"literal_text_all_w_t_and_m_t":"An index giving valid combinations of start symbol, length and mapping type as start and length indicator (SLIV) for the first msgA PUSCH occasion, for RRC_CONNECTED UEs in non-initial BWP as described in TS 38.214 [19] clause 6.1.2. The network configures the field so that the allocation does not cross the slot boundary. The number of occupied symbols excludes the guard period. If the field is absent, the UE shall use the value in msgA-PUSCH-TimeDomainAllocation (see TS 38.213 [13], clause 8.1A). The network configures one of msgA-PUSCH-TimeDomainAllocation and startSymbolAndLengthMsgA-PO, but not both. If the field is absent, the UE shall use the value of msgA-PUSCH-TimeDomainAllocation.","paragraph_zero_based":21052},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21053},{"literal_text_all_w_t_and_m_t":"MsgA-DMRS-Config field descriptions ","paragraph_zero_based":21054},{"literal_text_all_w_t_and_m_t":"msgA-DMRS-AdditionalPosition","paragraph_zero_based":21055},{"literal_text_all_w_t_and_m_t":"Indicates the position for additional DM-RS. If the field is absent, the UE applies value pos2.","paragraph_zero_based":21056},{"literal_text_all_w_t_and_m_t":"msgA-MaxLength","paragraph_zero_based":21057},{"literal_text_all_w_t_and_m_t":"indicates single-symbol or double-symbol DMRS. If the field is absent, the UE applies value len1.","paragraph_zero_based":21058},{"literal_text_all_w_t_and_m_t":"msgA-PUSCH-DMRS-CDM-Group","paragraph_zero_based":21059},{"literal_text_all_w_t_and_m_t":"1-bit indication of indices of CDM group(s). If the field is absent, then both CDM groups are used.","paragraph_zero_based":21060},{"literal_text_all_w_t_and_m_t":"msgA-PUSCH-NrofPorts","paragraph_zero_based":21061},{"literal_text_all_w_t_and_m_t":"0 indicates 1 port per CDM group, 1 indicates 2 ports per CDM group. If the field is absent then 4 ports per CDM group are used (see TS 38.213 [13], clause 8.1A).","paragraph_zero_based":21062},{"literal_text_all_w_t_and_m_t":"msgA-ScramblingID0","paragraph_zero_based":21063},{"literal_text_all_w_t_and_m_t":"UL DMRS scrambling initialization for CP-OFDM. If the field is absent the UE applies the value Physical cell ID (physCellID).","paragraph_zero_based":21064},{"literal_text_all_w_t_and_m_t":"msgA-ScramblingID1","paragraph_zero_based":21065},{"literal_text_all_w_t_and_m_t":"UL DMRS scrambling initialization for CP-OFDM. If the field is absent the UE applies the value Physical cell ID (physCellID).","paragraph_zero_based":21066},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21067},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":21068},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":21069},{"literal_text_all_w_t_and_m_t":"FreqHopConfigured","paragraph_zero_based":21070},{"literal_text_all_w_t_and_m_t":"This field is mandatory present when the field msgA-IntraSlotFrequencyHopping is configured. Otherwise, the field is absent.","paragraph_zero_based":21071}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec