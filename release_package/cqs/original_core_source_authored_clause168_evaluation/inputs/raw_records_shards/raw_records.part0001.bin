{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30216},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":30217},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":30218},{"literal_text_all_w_t_and_m_t":"InterFreqHOAndServCellAdd","paragraph_zero_based":30219},{"literal_text_all_w_t_and_m_t":"This field is mandatory present for inter-frequency handover and upon serving cell (PSCell/SCell) addition. Otherwise, the field is optionally present, Need M.","paragraph_zero_based":30220},{"literal_text_all_w_t_and_m_t":"ServCellAdd","paragraph_zero_based":30221},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon serving cell addition (for PSCell and SCell) and upon handover from E-UTRA to NR. It is optionally present, Need M otherwise.","paragraph_zero_based":30222},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30223},{"literal_text_all_w_t_and_m_t":"–UplinkConfigCommonSIB","paragraph_zero_based":30224},{"literal_text_all_w_t_and_m_t":"The IE UplinkConfigCommonSIB provides common uplink parameters of a cell.","paragraph_zero_based":30225},{"literal_text_all_w_t_and_m_t":"UplinkConfigCommonSIB information element","paragraph_zero_based":30226},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":30227},{"literal_text_all_w_t_and_m_t":"-- TAG-UPLINKCONFIGCOMMONSIB-START","paragraph_zero_based":30228},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30229},{"literal_text_all_w_t_and_m_t":"UplinkConfigCommonSIB ::=               SEQUENCE {","paragraph_zero_based":30230},{"literal_text_all_w_t_and_m_t":"    frequencyInfoUL                         FrequencyInfoUL-SIB,","paragraph_zero_based":30231},{"literal_text_all_w_t_and_m_t":"    initialUplinkBWP                        BWP-UplinkCommon,","paragraph_zero_based":30232},{"literal_text_all_w_t_and_m_t":"    timeAlignmentTimerCommon                TimeAlignmentTimer","paragraph_zero_based":30233},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30234},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30235},{"literal_text_all_w_t_and_m_t":"UplinkConfigCommonSIB-v1700 ::=         SEQUENCE {","paragraph_zero_based":30236},{"literal_text_all_w_t_and_m_t":"    initialUplinkBWP-RedCap-r17             BWP-UplinkCommon                                OPTIONAL   -- Need R","paragraph_zero_based":30237},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30238},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["acd29604f2219a8ebed11b587a4efdae81a9dd0e023859da1cd3dc3586cd0073","fb83aedeec78aa16f43c3aaa845c170ef3bdfc8972ed18f126eb5c1a3821cc40","d0f205c9fdfe92c26d090d19f63af1f3f1311cd07603aa1697d330eb586736b8","7a6b0d4490925c61ad11be2be44bbdf0d8b48f8bab11a743bedbe606b4ddb10c","37d329140d82803661e453b8e4c51940fd187e8b8a576d9e1b4c4f9b901547cd","7af7da39ba77407ae6d1b0bf88eb2b26049facceb90a1d6a54b3d55d795e54e2","2cca8bd8f9a4f8f89400d13aa7bfd9f9062e17c747e2c92e2f735707f3287f72","03db5467841ed443bf051c76b4d6bbd798ed0556c9b52736016b17cf23a2e8d9","859d611bcbeb4da423fbb65717826bda5edbf22f507e448ec6eba2f036b57327","41d64c61e050c17b2d31c638fc120ce53ff6d968b5dbeec9d4ed539c20dc32df","bca0950fa555e4abb42641b7be7061500a2d00bc09db06d18e7808b7378decf0","3f264e6dbf17310b177770cf4858522c195cf68ec62cb82ab3a6aaaabd233988","6ead6b96fa938b6c45ef458ab3f9782329ad6678b7afa5b1b75ab870cf41a9a5","4fc4aa0a47c0e3b285b584b3ccac08dac282ff2da3f26e17855aa33e88f8c53b","706c19099f6e90b0