{"fields":{"filename":"R2-2313845.zip::R2-2313845 Introduction of R18 positioning to MR-DC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-For a specific reference, subsequent revisions do not apply.","paragraph_zero_based":120},{"literal_text_all_w_t_and_m_t":"-For a non-specific reference, the latest version applies. In the case of a reference to a 3GPP document (including a GSM document), a non-specific reference implicitly refers to the latest version of that document in the same Release as the present document.","paragraph_zero_based":121},{"literal_text_all_w_t_and_m_t":"[1]3GPP TR 21.905: \"Vocabulary for 3GPP Specifications\".","paragraph_zero_based":122},{"literal_text_all_w_t_and_m_t":"[2]3GPP TS 36.300: \"Evolved Universal Terrestrial Radio Access (E-UTRA) and Evolved Universal Terrestrial Radio Access Network (E-UTRAN); Overall description; Stage 2\".","paragraph_zero_based":123},{"literal_text_all_w_t_and_m_t":"[3]3GPP TS 38.300: \"NR; NR and NG-RAN Overall description; Stage 2\".","paragraph_zero_based":124},{"literal_text_all_w_t_and_m_t":"[4]3GPP TS 38.331: \"NR; Radio Resource Control (RRC) protocol specification\".","paragraph_zero_based":125},{"literal_text_all_w_t_and_m_t":"[5]3GPP TS 38.423: \"NG-RAN; Xn application protocol (XnAP)\".","paragraph_zero_based":126},{"literal_text_all_w_t_and_m_t":"[6]3GPP TS 38.425: \"NG-RAN; NR user plane protocol\".","paragraph_zero_based":127},{"literal_text_all_w_t_and_m_t":"[7]3GPP TS 38.401: \"NG-RAN; Architecture description\".","paragraph_zero_based":128},{"literal_text_all_w_t_and_m_t":"[8]3GPP TS 38.133: \"NG-RAN; Requirements for support of radio resource management\".","paragraph_zero_based":129},{"literal_text_all_w_t_and_m_t":"[9]3GPP TS 36.423: \"Evolved Universal Terrestrial Radio Access Network (E-UTRAN); X2 Application Protocol (X2AP)\".","paragraph_zero_based":130},{"literal_text_all_w_t_and_m_t":"[10]3GPP TS 36.331: \"Evolved Universal Terrestrial Radio Access (E-UTRA); Radio Resource Control (RRC); Protocol specification\".","paragraph_zero_based":131},{"literal_text_all_w_t_and_m_t":"[11]3GPP TS 23.501: \"System Architecture for the 5G System; Stage 2\".","paragraph_zero_based":132},{"literal_text_all_w_t_and_m_t":"[12]3GPP TS 38.101-1: \"User Equipment (UE) radio transmission and reception; Part 1: Range 1 Standalone\".","paragraph_zero_based":133},{"literal_text_all_w_t_and_m_t":"[13]3GPP TS 38.101-2: \"User Equipment (UE) radio transmission and reception; Part 2: Range 2 Standalone\".","paragraph_zero_based":134},{"literal_text_all_w_t_and_m_t":"[14]3GPP TS 38.101-3: \"User Equipment (UE) radio transmission and reception; Part 3: Range 1 and Range 2 Interworking operation with other radios\".","paragraph_zero_based":135},{"literal_text_all_w_t_and_m_t":"[15]3GPP TS 36.323: \"Evolved Universal Terrestrial Radio Access (E-UTRA); Packet Data Convergence Protocol (PDCP) specification\".","paragraph_zero_based":136},{"literal_text_all_w_t_and_m_t":"[16]3GPP TS 38.323: \"NR; Packet Data Convergence Protocol (PDCP) specification\".","paragraph_zero_based":137},{"literal_text_all_w_t_and_m_t":"[17]3GPP TS 38.340: \"Backhaul Adaptation Protocol (BAP) specification\".","paragraph_zero_based":138},{"literal_text_all_w_t_and_m_t":"[18]3GPP TS 23.287: \"Architecture enhancements for 5G System (5GS) to support Vehicle-to-Everything (V2X) services \".","paragraph_zero_based":139},{"literal_text_all_w_t_and_m_t":"[19]3GPP TS 23.285: \"Architecture enhancements for V2X services\".","paragraph_zero_based":140},{"literal_text_all_w_t_and_m_t":"[20]3GPP TS 23.502: \"Procedures for the 5G System; Stage 2\".","paragraph_zero_based":141},{"literal_text_all_w_t_and_m_t":"[21]3GPP TS 38.213: \"NR; Physical layer procedures\".","paragraph_zero_based":142},{"literal_text_all_w_t_and_m_t":"[22]3GPP TS 24.301: \"Non-Access-Stratum (NAS) protocol for Evolved Packet System (EPS); Stage 3\".","paragraph_zero_based":143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"da5f2e9ad82a2fe16c0ac8f47ac3a2bf5df15d5802210995528b085ea041fe8c","original_member_sha256":"4dd1bab56896055218acba90ada05dd206b70fbd7a2f3b846c0e4a02e9fd0070","paragraph_ElementTree_utf8_XML_sha256":["8a45fae682782b264eaa87b55d3902596eeb3e128d2cba14de51bdfd48e5ba72","e322aa7f4ab2657a95a8ba19220badeddeb7d9a3789be65336adb844ded67f44","b08315e27032532b6c5bf9704aaf36fc44dfff93f69e7b04ffa6884fa0a1c5ba","0d3823ce76d5c6bc27b7c1b2ca706a518d7295c2530cee0542441cf91567a019","e1cadf79f4fa7d3381aaf91efd66001e3c5942f0d0f8d32afb027ca0439991ef","46a8d2e6d86926788361091a322013a02688fdd9824463835455e69f6882a9a4","177ee03dd6074055bc86daa8424cc5f0d3d8d5206a98a20125438cb07c63958e","9113ee2e791ac4eebc76f9fba11e0ee3343116b8364157dc1480b76bbe8ca532","251309fe8c2bb2fe82f206d3a65c5a5901297369705aef9b903763a370065034","5fa1300b8e2ec1fc1f7538e5d5cafbb0036e459a0df8651812d5319c8fb3e360","1a25ac7feb6658deaffb75d58ee33e849956a91a1a613193b2a54de0dc030885","1cf57099a4dade0d2a019f3b8542172437fe9b9eda8fd687b16cebe7235c6c01","b1c6724a9c5ec7e148cf0a618069b81b1e09012ae47d868ed16ac988812e35ad","5201e256496eb0b2ebbec0f92d62efe28422fa06ab2c6def311a1d4787b43cb3","286eac25df5e84eb7cd48b7c006a8f0fd2badeed5a358a464837c9fa1eda0166","23acc721628bfa636767cbd9e915950c4fe69c9b2a8abdbc206c2b20736dd5ba","b40af2a8258f1ccc53bdc87ce2536a4439ea41b1667454185bdea1e6ea41ca3d","4570867e5eb9287208230562fc45717d598e79bf524c826cb2ab6307e909f62a","31826122e93eb26c6cf6947b08b8064738fb1405ca9f14b4fa6561d3239bdcde","bc70d920b12f72fc8c74631f0f4152476a725b235d44763cda54d05701d90030","3dfc16a52d5f9b0d5b69166b350461245c96ee1b2f2c9fd3ea3e02fb492ebf31","1d071ce3ec0c56785482a8ea11eec647bdd59fae307119bd7168853dc9e5a9b6","bc62ddecf7e92678c5f94840885c044b4e441aa37a4beeae99cd34f0aa1d8da1","297dc6a93e66d53482f78dd9e4774768cedca80f01c388ad1c7c892de4d02cff"],"paragraph_range_zero_based":[120,143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313845.zip::R2-2313845 Introduction of R18 positioning to MR-DC.docx:p120"}
{"fields":{"filename":"R2-2313845.zip::R2-2313845 Introduction of R18 positioning to MR-DC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"[23]3GPP TS 38.473: \"F1 application protocol (F1AP)\".","paragraph_zero_based":144},{"literal_text_all_w_t_and_m_t":"[24]3GPP TS 23.304: \"Proximity based Services (ProSe) in the 5G System (5GS)\".","paragraph_zero_based":145},{"literal_text_all_w_t_and_m_t":"[xx]3GPP TS 23.586: \"Technical Specification Group Services and System Aspects; Architectural Enhancements to support Ranging based services and Sidelink Positioning\".","paragraph_zero_based":146},{"literal_text_all_w_t_and_m_t":"===============================NEXT CHANGE=========================================","paragraph_zero_based":147},{"literal_text_all_w_t_and_m_t":"3.1Definitions","paragraph_zero_based":148},{"literal_text_all_w_t_and_m_t":"For the purposes of the present document, the terms and definitions given in TR 21.905 [1] and the following apply. A term defined in the present document takes precedence over the definition of the same term, if any, in TR 21.905 [1] and TS 36.300 [2].","paragraph_zero_based":149},{"literal_text_all_w_t_and_m_t":"Child node: IAB-DU's or IAB-donor-DU's next hop neighbour IAB-node.","paragraph_zero_based":150},{"literal_text_all_w_t_and_m_t":"Conditional PSCell Addition: a PSCell addition procedure that is executed only when PSCell addition execution condition is met.","paragraph_zero_based":151},{"literal_text_all_w_t_and_m_t":"Conditional PSCell Change: a PSCell change procedure that is executed only when PSCell change execution condition is met.","paragraph_zero_based":152},{"literal_text_all_w_t_and_m_t":"En-gNB: node providing NR user plane and control plane protocol terminations towards the UE, and acting as Secondary Node in EN-DC.","paragraph_zero_based":153},{"literal_text_all_w_t_and_m_t":"Fast MCG link recovery: in MR-DC, an RRC procedure where the UE sends an MCG Failure Information message to the MN via the SCG upon the detection of a radio link failure on the MCG.","paragraph_zero_based":154},{"literal_text_all_w_t_and_m_t":"IAB-donor: gNB that provides network access to UEs via a network of backhaul and access links.","paragraph_zero_based":155},{"literal_text_all_w_t_and_m_t":"IAB-MT: IAB-node function that terminates the Uu interface to the parent node using the procedures and behaviours specified for UEs unless stated otherwise.","paragraph_zero_based":156},{"literal_text_all_w_t_and_m_t":"IAB-node: RAN node that supports NR access links to UEs and NR backhaul links to parent nodes and child nodes. The IAB-node does not support backhauling via E-UTRA.","paragraph_zero_based":157},{"literal_text_all_w_t_and_m_t":"Master Cell Group:in MR-DC, a group of serving cells associated with the Master Node, comprising of the SpCell (PCell) and optionally one or more SCells.","paragraph_zero_based":158},{"literal_text_all_w_t_and_m_t":"Master node: in MR-DC, the radio access node that provides the control plane connection to the core network. It may be a Master eNB (in EN-DC), a Master ng-eNB (in NGEN-DC) or a Master gNB (in NR-DC and NE-DC).","paragraph_zero_based":159},{"literal_text_all_w_t_and_m_t":"MCG bearer: in MR-DC, a radio bearer with an RLC bearer (or two RLC bearers, in case of CA packet duplication in an E-UTRAN cell group, or up to four RLC bearers in case of CA packet duplication in a NR cell group) only in the MCG.","paragraph_zero_based":160},{"literal_text_all_w_t_and_m_t":"MN terminated bearer: in MR-DC, a radio bearer for which PDCP is located in the MN.","paragraph_zero_based":161},{"literal_text_all_w_t_and_m_t":"MCG SRB: in MR-DC, a direct SRB between the MN and the UE.","paragraph_zero_based":162},{"literal_text_all_w_t_and_m_t":"Multi-Radio Dual Connectivity: Dual Connectivity between E-UTRA and NR nodes, or between two NR nodes.","paragraph_zero_based":163},{"literal_text_all_w_t_and_m_t":"Ng-eNB: as defined in TS 38.300 [3].","paragraph_zero_based":164},{"literal_text_all_w_t_and_m_t":"NR sidelink communication: AS functionality enabling at least V2X Communication as defined in TS 23.287 [18] and ProSe Communication (including ProSe UE-to-Network Relay and non-Relay communication) as defined in TS 23.304 [24], between two or more nearby UEs, using NR technology but not traversing any network node.","paragraph_zero_based":165},{"literal_text_all_w_t_and_m_t":"NR sidelink discovery: AS functionality enabling ProSe non-Relay Discovery and ProSe UE-to-Network Relay discovery for Proximity based Services as defined in TS 23.304 [24] between two or more nearby UEs, using NR technology but not traversing any network node.","paragraph_zero_based":166},{"literal_text_all_w_t_and_m_t":"Parent node: IAB-MT's next hop neighbour node; the parent node can be IAB-node or IAB-donor-DU.","paragraph_zero_based":167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"da5f2e9ad82a2fe16c0ac8f47ac3a2bf5df15d5802210995528b085ea041fe8c","original_member_sha256":"4dd1bab56896055218acba90ada05dd206b70fbd7a2f3b846c0e4a02e9fd0070","paragraph_ElementTree_utf8_XML_sha256":["b9ed6dcb89649a3692ca2ccef4034fd27144e69d01370ca65b4258cf2ccbe748","e672a1946972592629016bc33c7eee28fcaec7102640e9912f320678308bf831","d0cd43bcafec9803798c1c763f950988a66135de29c6ea27b8e6b6f484c10221","8c8aa1eeecc6c7c9e93207aa03384a347d6a161de116409d665c338c66b2a9b2","eb80f3e8d383f7be5c1fb4783b24cf11f359f3d449d3a2057fc9426aa413dfbd","e03346670dd9edde3a15baff51a381660c77e40987d1b2c75bf4782850ccfee4","b3e1697b31c3c7078e165601f431faf7d5ce0c1c1ad3909311a1c39ce3c2f436","b96e55c2e260c48137980363ae5357bd74d58712ba495530a84eea36664509c9","728e3c47a3d5b7276b707a379cc7458f019745396f1f5ac24b95aa55d709c13d","a232daa639181965154d85a08f3153308154d11352774a40cd3b7032bba730ae","c3ee40bc9dd1ef6774461c583b46a5581eb2909478e6655d1e380348a89f13bf","b22c6abf4370359f3e8279a27ede1d7ac6d030a84d06b1c801c83feb870bf591","b6657979b41959030eda8163859d23797cb56d652339f6ca0c2a05f979eb4c0f","cf9e176502b3e89fa6a33c059d5693895dc1925ace2e39595c2ee45cfd14576a","eaa4a838dc4e9612054af089685b110bc7ab1703889b3f9781bb295b5e375348","0a5f7c9f1fa6265afc18b3e02332d8a845a2872b8e238d282954c0b8b6717cf9","eedda89ff854b2fe0f1182334223b84609527731aa612053ea05c01c34b91532","d9ba33e42113f17a8c3afb1205beb22cc98435674da41a43cc89b34410ab8b9f","81aafb1e7b9322704dbbee603326793276c2c14d1db541e30dde34357a888c32","c0e7edae33a29c771b0d1a3159b46895519d49dd8ccbcfdd07fa18fdda46d0b7","7b482d5acf18cfd7962b95755523e40d865685cb2d0ec109d5471a796fb4d5ba","fcc6f24175776dedce3d29fc3a8e093eb923b7a92483c7e26dcbac03dc1c590a","10f252f789aa507f1adaf47d575978f4d5a84cbf4848d87fefff8e549b8d9d51","355b59ba607ac86b6a91b9271e161a81b10eaee256f206473488e567467efac9"],"paragraph_range_zero_based":[144,167],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313845.zip::R2-2313845 Introduction of R18 positioning to MR-DC.docx:p144"}
{"fields":{"filename":"R2-2313845.zip::R2-2313845 Introduction of R18 positioning to MR-DC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"PCell: SpCell of a master cell group.","paragraph_zero_based":168},{"literal_text_all_w_t_and_m_t":"PSCell: SpCell of a secondary cell group.","paragraph_zero_based":169},{"literal_text_all_w_t_and_m_t":"RLC bearer: RLC and MAC logical channel configuration of a radio bearer in one cell group.","paragraph_zero_based":170},{"literal_text_all_w_t_and_m_t":"Ranging/Sidelink Positioning: AS functionality enabling ranging-based services and sidelink positioning as defined in TS 23.586 [xx].","paragraph_zero_based":171},{"literal_text_all_w_t_and_m_t":"Secondary Cell Group: in MR-DC, a group of serving cells associated with the Secondary Node, comprising of the SpCell (PSCell) and optionally one or more SCells.","paragraph_zero_based":172},{"literal_text_all_w_t_and_m_t":"Secondary node: in MR-DC, the radio access node, with no control plane connection to the core network, providing additional resources to the UE. It may be an en-gNB (in EN-DC), a Secondary ng-eNB (in NE-DC) or a Secondary gNB (in NR-DC and NGEN-DC).","paragraph_zero_based":173},{"literal_text_all_w_t_and_m_t":"SCG bearer: in MR-DC, a radio bearer with an RLC bearer (or two RLC bearers, in case of CA packet duplication in an E-UTRAN cell group, or up to four RLC bearers in case of CA packet duplication in a NR cell group) only in the SCG.","paragraph_zero_based":174},{"literal_text_all_w_t_and_m_t":"SN terminated bearer: in MR-DC, a radio bearer for which PDCP is located in the SN.","paragraph_zero_based":175},{"literal_text_all_w_t_and_m_t":"SpCell: primary cell of a master or secondary cell group.","paragraph_zero_based":176},{"literal_text_all_w_t_and_m_t":"SRB3: in EN-DC, NGEN-DC and NR-DC, a direct SRB between the SN and the UE.","paragraph_zero_based":177},{"literal_text_all_w_t_and_m_t":"Split bearer: in MR-DC, a radio bearer with RLC bearers both in MCG and SCG.","paragraph_zero_based":178},{"literal_text_all_w_t_and_m_t":"Split PDU Session (or PDU Session split): a PDU Session whose QoS Flows are served by more than one SDAP entities in the NG-RAN.","paragraph_zero_based":179},{"literal_text_all_w_t_and_m_t":"Split SRB: in MR-DC, a SRB between the MN and the UE with RLC bearers both in MCG and SCG.","paragraph_zero_based":180},{"literal_text_all_w_t_and_m_t":"User plane resource configuration: in MR-DC with 5GC, encompasses radio network resources and radio access resources related to either one or more PDU sessions, one or more QoS flows, one or more DRBs, or any combination thereof.","paragraph_zero_based":181},{"literal_text_all_w_t_and_m_t":"V2X sidelink communication: AS functionality enabling V2X Communication as defined in TS 23.285 [19], between nearby UEs, using E-UTRA technology but not traversing any network node.","paragraph_zero_based":182},{"literal_text_all_w_t_and_m_t":"===============================NEXT CHANGE =========================================","paragraph_zero_based":183},{"literal_text_all_w_t_and_m_t":"13.2Sidelink","paragraph_zero_based":184},{"literal_text_all_w_t_and_m_t":"NR Sidelink Communication, V2X Sidelink Communication,NR Sidelink Discovery and Ranging/Sidelink Positioning cannot be configured in MR-DC in this release.","paragraph_zero_based":185},{"literal_text_all_w_t_and_m_t":"===============================CHANGE ENDS=========================================","paragraph_zero_based":186}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"da5f2e9ad82a2fe16c0ac8f47ac3a2bf5df15d5802210995528b085ea041fe8c","original_member_sha256":"4dd1bab56896055218acba90ada05dd206b70fbd7a2f3b846c0e4a02e9fd0070","paragraph_ElementTree_utf8_XML_sha256":["76479253054108973b3f98589b050f98cb619c9b508a0ade3c5d0fa31d5680e4","de6cfaf62293c03e33ed75a30e3fff5c1151681316713aed66fe6e0f12c76e25","6ccc04ff31842d0ec58aa8654cd90d304a21bdee024eedbdd2650331ba93266d","92b1f720a99c77db852fccf3f240d1130950d643f5ef7d3bf2af7431c0bb6f88","71d49edba9f23471b0eaf1da26e13339d59e4e2375eb2c8238952e1748df939b","6b0bb79da5034a1715d72c775bcabb0541e9074f8516872db65aa7678858de51","ed4cafae2e3847f917871114e0d7a44298544d31905283d011b5b4f810dcc95e","33277301f56905ea55895f460cd213d18f58ce92b5e74c232d7b37968678c186","56258fa88d8fc476c49318bf617dbabf03bf6aff6dcd7152596c1d02ec434fca","1751daf46cc2389cf638977e0849a91d0b94f499095410cc08ea692f397fcf00","028ff7ac3d60085ff78f2375032fc0e940cbdc2d7c5d30f466e6dda838f97089","56140fd31a61e0beb0e5643848b6a01e34a24549a6e31126bfe94108e2c746f0","232a6f388130332b164b7fdfd9ca839987007c6eb2ff4685b799ee0486f2114b","571c3b63613f3ff491fd01ad7f7440bcd657c9285c525fe201bdf7c87e2ccb36","5a4cb872a5882b06c12c761bdb96dc8f9e14ac81ed8f5dc101e5e1850a92d281","55e02fb78cb210b080d59b2eb33c8513a1318de6906059da7b7383ce0ef5d644","4aa5ebb97c0af6c0c9304fe57ba4ef4118a3ea26cc8471f2c8611adac353e234","782b76135c35be7ee8f52ac31b2a3c194488feb8c5497e029bd004fd08197e43","51bcfdcb995d297106c420ebb11f5e43ec603ffb524a5cab5c088e9da1701fda"],"paragraph_range_zero_based":[168,186],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313845.zip::R2-2313845 Introduction of R18 positioning to MR-DC.docx:p168"}
