{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":36264},{"literal_text_all_w_t_and_m_t":"ServiceType","paragraph_zero_based":36265},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need M, when serviceType is set to streaming or vr. Otherwise, it is absent.","paragraph_zero_based":36266},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36267},{"literal_text_all_w_t_and_m_t":"–AreaConfiguration","paragraph_zero_based":36268},{"literal_text_all_w_t_and_m_t":"The AreaConfiguration indicates area for which UE is requested to perform measurement logging. If not configured, measurement logging is not restricted to specific cells or tracking areas but applies as long as the RPLMN is contained in plmn-IdentityList stored in VarLogMeasReport.","paragraph_zero_based":36269},{"literal_text_all_w_t_and_m_t":"AreaConfiguration information element","paragraph_zero_based":36270},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36271},{"literal_text_all_w_t_and_m_t":"-- TAG-AREACONFIGURATION-START","paragraph_zero_based":36272},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36273},{"literal_text_all_w_t_and_m_t":"AreaConfiguration-r16 ::=        SEQUENCE {","paragraph_zero_based":36274},{"literal_text_all_w_t_and_m_t":"    areaConfig-r16                   AreaConfig-r16,","paragraph_zero_based":36275},{"literal_text_all_w_t_and_m_t":"    interFreqTargetList-r16          SEQUENCE(SIZE (1..maxFreq)) OF InterFreqTargetInfo-r16              OPTIONAL  -- Need R","paragraph_zero_based":36276},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":36277},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36278},{"literal_text_all_w_t_and_m_t":"AreaConfiguration-v1700 ::=      SEQUENCE {","paragraph_zero_based":36279},{"literal_text_