{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-SECURITYALGORITHMCONFIG-START","paragraph_zero_based":27480},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27481},{"literal_text_all_w_t_and_m_t":"SecurityAlgorithmConfig ::=         SEQUENCE {","paragraph_zero_based":27482},{"literal_text_all_w_t_and_m_t":"    cipheringAlgorithm                  CipheringAlgorithm,","paragraph_zero_based":27483},{"literal_text_all_w_t_and_m_t":"    integrityProtAlgorithm              IntegrityProtAlgorithm          OPTIONAL,   -- Need R","paragraph_zero_based":27484},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":27485},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27486},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27487},{"literal_text_all_w_t_and_m_t":"IntegrityProtAlgorithm ::=          ENUMERATED {","paragraph_zero_based":27488},{"literal_text_all_w_t_and_m_t":"                                        nia0, nia1, nia2, nia3, spare4, spare3,","paragraph_zero_based":27489},{"literal_text_all_w_t_and_m_t":"                                        spare2, spare1, ...}","paragraph_zero_based":27490},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27491},{"literal_text_all_w_t_and_m_t":"CipheringAlgorithm ::=              ENUMERATED {","paragraph_zero_based":27492},{"literal_text_all_w_t_and_m_t":"                                        nea0, nea1, nea2, nea3, spare4, spare3,","paragraph_zero_based":27493},{"literal_text_all_w_t_and_m_t":"                                        spare2, spare1, ...}","paragraph_zero_based":27494},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27495},{"literal_text_all_w_t_and_m_t":"-- TAG-SECURITYALGORITHMCONFIG-STOP","paragraph_zero_based":27496},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27497},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27498},{"literal_text_all_w_t_and_m_t":"SecurityAlgorithmConfig field descriptions","paragraph_zero_based":27499},{"literal_text_all_w_t_and_m_t":"cipheringAlgorithm","paragraph_zero_based":27500},{"literal_text_all_w_t_and_m_t":"Indicates the ciphering algorithm to be used for SRBs and DRBs, as specified in TS 33.501 [11]. The algorithms nea0-nea3 are identical to the LTE algorithms eea0-3. The algorithms configured for all bearers using master key shall be the same, and the algorithms configured for all bearers using secondary key, if any, shall be the same. If UE is connected to E-UTRA/EPC, this field indicates the ciphering algorithm to be used for RBs configured with NR PDCP, as specified in TS 33.501 [11].","paragraph_zero_based":27501},{"literal_text_all_w_t_and_m_t":"integrityProtAlgorithm","paragraph_zero_based":27502},{"literal_text_all_w_t_and_m_t":"Indicates the integrity protection algorithm to be used for SRBs and DRBs, as specified in TS 33.501 [11]. The algorithms nia0-nia3 are identical to the E-UTRA algorithms eia0-3. The algorithms configured for all bearers using master key shall be the same and the algorithms configured for all bearers using secondary key, if any, shall be the same. The network does not configure nia0 except for unauthenticated emergency sessions for unauthenticated UEs in LSM (limited service mode).","paragraph_zero_based":27503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["5abe71e2e355c78be2bf05303a4fb074c2cdc37a1dec40c619a9745b274d64a9","2064d4ff1d4993e067af79354febdb1bbff9b200fb6cbf8ffb799a4cde0a0256","83d0dd214c103795162418a27c186ccf2882f3e04c249e7a0a72840a5644ed1e","942ab43819307651864215e4e89402fe722d14a7ad666225c99e5150583deab4","77db7e517adfc05bf19f159c64f3e7d7cd575d16da043ebd08bddba4d1ffb058","ae698ee8c426fe059ce10fa258d5772c3e1fea1c4c900ec349b9f5d9cfe13bbc","8856e1aeeec958664ba3f384b240c6192aa03bbea28a6f5ce317aee474466ba4","82590cf038571927601127f4f51341a879f98352865f2c0e7a14e1bc17feee9e","45b1ad7aacebd290113dd93fad6e1a2531817236f4005f49e803661fd7a4141a","e604216eda2a67d3a27c3a35bff7e4b9a709b5bd436bd3d455feb86ad381b509","92a4a76c884d5a74715b87c5171e9e05e734eafb5f685651c4ca0e65d7b62863","47153b2a21ae0220768772a0453c0102c2abd73aa74847f5b582337fac5d090b","29b7f2ed9d7b5b425847b9e869b574d83b00b49a3be28191889ca0370470ac6f","0768e4f538880a4a3663102f20a2c7bdeb1aab5ac2017ccc752b9a3d2133f1c8","20269bf24db6201cc52754de42971b8529976081e2adfd60444abb0bae143e73","e8554d0bdc41ae370853f108d18a7ac191b6a02565aa55e7c3baa3cf4b5fda31","a54e1b508fbd2a5f257e32637cfc8d91980c59e844840a21459bb51a41bc8485","197ad641ec5c8594bd45feb1d56de52ec3c4a489a487f11a01e7bc92835a307c","28846b4a0a26fa992d6e305c4bb784f29be2f8fd4146bc50aec65f223ba6b758","7000ffad004b4971512164833f66250fddd459858d111e92d3c0936a0d3a4849","1e6a95d461a3f2eecf4efc8b0d97e253f8577012a9c32dd74f24a4e137a45c90","bb769c2c4d7dec660863af948a96da8cf4226adf82ae02efc604bbc1f5e188db","bdad91e156f19c640677d527d028598d448e4e5807e29216e7dc566930f9b01e","e75a0aec2883709f37794434d0eaeb3fa6ff0964b017f3802831050ef7e5f1ca"],"paragraph_range_zero_based":[27480,27503],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p27480"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"If UE is connected to E-UTRA/EPC, this field indicates the integrity protection algorithm to be used for SRBs configured with NR PDCP as specified in TS 33.501 [11], and DRBs configured with integrity protection as specified in TS 33.401 [30]. The network does not configure nia0 for SRB3.","paragraph_zero_based":27504},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27505},{"literal_text_all_w_t_and_m_t":"–SemiStaticChannelAccessConfig","paragraph_zero_based":27506},{"literal_text_all_w_t_and_m_t":"The IE SemiStaticChannelAccessConfig is used to configure channel access parameters when the network is operating in semi-static channel access mode (see clause 4.3 in TS 37.213 [48].","paragraph_zero_based":27507},{"literal_text_all_w_t_and_m_t":"SemiStaticChannelAccessConfig information element","paragraph_zero_based":27508},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27509},{"literal_text_all_w_t_and_m_t":"-- TAG-SEMISTATICCHANNELACCESSCONFIG-START","paragraph_zero_based":27510},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27511},{"literal_text_all_w_t_and_m_t":"SemiStaticChannelAccessConfig-r16 ::=    SEQUENCE {","paragraph_zero_based":27512},{"literal_text_all_w_t_and_m_t":"    period-r16                               ENUMERATED {ms1, ms2, ms2dot5, ms4, ms5, ms10}","paragraph_zero_based":27513},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27514},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27515},{"literal_text_all_w_t_and_m_t":"-- TAG-SEMISTATICCHANNELACCESSCONFIG-STOP","paragraph_zero_based":27516},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27517},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27518},{"literal_text_all_w_t_and_m_t":"SemiStaticChannelAccessConfig field descriptions","paragraph_zero_based":27519},{"literal_text_all_w_t_and_m_t":"period","paragraph_zero_based":27520},{"literal_text_all_w_t_and_m_t":"Indicates the periodicity of the semi-static channel access mode (see TS 37.213 [48], clause 4.3). Value ms1 corresponds to 1 ms, value ms2 corresponds to 2 ms, value ms2dot5 corresponds to 2.5 ms, and so on.","paragraph_zero_based":27521},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27522},{"literal_text_all_w_t_and_m_t":"–SemiStaticChannelAccessConfigUE","paragraph_zero_based":27523},{"literal_text_all_w_t_and_m_t":"The IE SemiStaticChannelAccessConfigUE is used to configure channel access parameters for UE initiated semi-static channel access.","paragraph_zero_based":27524},{"literal_text_all_w_t_and_m_t":"SemiStaticChannelAccessConfigUE information element","paragraph_zero_based":27525},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27526},{"literal_text_all_w_t_and_m_t":"-- TAG-SEMISTATICCHANNELACCESSCONFIGUE-START","paragraph_zero_based":27527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["79080ed9647f7d87558e0b36d4bc6e8e4bf02a3c936dd69d8691e8e98055c50f","b1d5b2e612b865e8987a562159565616294968868c4f49aa2d3f98b978e0f4de","d7459a61a3fcece64af066ca8a2e6df88b0e3440ac193b801eed2a84b38dacc4","a7a6f7967e641ec75d1a720807cd7d285a241c92a7eae076924b920cb1256abd","5c56c3a2e046806899c6d6bddc3045e038ca1388e7256262de2b4a33c9f3c882","3b9bf489016f4cdb2ed3d5810084c6312bdd697e65f3d7849a9664947df0055d","24cbc249f2508de6b62edde296c19bf89d48fb795c6ed22e510ee66edf1b11f8","dbdc186c55d0e1405a3f929c850e28bee070220c060ebb741d2b00355f30f018","8bede670e27bc4e2588a4ae1224030d3572f83f5219f9c483a3cadf6cd