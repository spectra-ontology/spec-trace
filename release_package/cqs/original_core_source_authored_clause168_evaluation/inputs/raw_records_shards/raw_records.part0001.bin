{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETDOWNLINKPERCC-ID-STOP","paragraph_zero_based":32088},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32089},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32090},{"literal_text_all_w_t_and_m_t":"–FeatureSetEUTRA-DownlinkId","paragraph_zero_based":32091},{"literal_text_all_w_t_and_m_t":"The IE FeatureSetEUTRA-DownlinkId identifies a downlink feature set in E-UTRA list (see TS 36.331 [10]. The first element in that list is referred to by FeatureSetEUTRA-DownlinkId = 1. The FeatureSetEUTRA-DownlinkId=0 is used when the UE does not support a carrier in this band of a band combination.","paragraph_zero_based":32092},{"literal_text_all_w_t_and_m_t":"FeatureSetEUTRA-DownlinkId information element","paragraph_zero_based":32093},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32094},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETEUTRADOWNLINKID-START","paragraph_zero_based":32095},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32096},{"literal_text_all_w_t_and_m_t":"FeatureSetEUTRA-DownlinkId ::=      INTEGER (0..maxEUTRA-DL-FeatureSets)","paragraph_zero_based":32097},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32098},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETEUTRADOWNLINKID-STOP","paragraph_zero_based":32099},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32100},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32101},{"literal_text_all_w_t_and_m_t":"–FeatureSetEUTRA-UplinkId","paragraph_zero_based":32102},{"literal_text_all_w_t_and_m_t":"The IE FeatureSetEUTRA-UplinkId identifies an uplink feature set in E-UTRA list (see TS 36.331 [10]. The first element in that list is referred to by FeatureSetEUTRA-UplinkId = 1. The FeatureSetEUTRA-UplinkId =0 is used when the UE does not support a carrier in this band of a band combination.","paragraph_zero_based":32103},{"literal_text_all_w_t_and_m_t":"FeatureSetEUTRA-UplinkId information element","paragraph_zero_based":32104},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32105},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETEUTRAUPLINKID-START","paragraph_zero_based":32106},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32107},{"literal_text_all_w_t_and_m_t":"FeatureSetEUTRA-UplinkId ::=                    INTEGER (0..maxEUTRA-UL-FeatureSets)","paragraph_zero_based":32108},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32109},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETEUTRAUPLINKID-STOP","paragraph_zero_based":32110},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32111}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["1bdb5b35e49b48653c0badfab4f32399310feb89733405775ea3bd87cf04238e","1a56e014140226bd9bd6d86f0e061351bdde680dfb709caaf3f39a4e369f5d09","e0991cf341210632ab6eb7ec5b4fef1f9273521b9b555c4d9b260f37086c6978","d537924ab68db36d352052ce2c01ee3ec0b634d3d13654ee14e2eafe13f96faa","917ef65fa8c22d0e08540498a1ef32867f40b2a33e2b04eb3c8480d56387bfa5","b9288a8e4505ac44fb4e808bb93a3b1f7abfd467b70a2f378f5730e2d9ea1682","48e361817a824ceeb07dcce9f90f4444f761d00487935db75db03d0e04d7f41b","c1d0612dc8a876cb2bd20db40b1d5817e068781f6a600751fdb907bdfdcfb333","790223726a79bae5e164ae6afaba9db9ca6c3db9cee9f34df78331a7df8ac662","fc868ca301cb001f52429f476ea8b9cd4003badb89fda842f3cbe82c79a0d06a","1ac981f204f7c72a7927f9bc7d284a1d5bba7b3d60efd02b906c959a295855e2","4766ffe6330e578c84838c8948375c9fd7dbe8d13e2a5396b1059d6ef1cbf61c","1694ea262aaf22fbe8c79322e109398b36a6f22654839a36233a2aa7cdff2244","88cf2a4c689e1915460911e30936deabd3d8e09789b04b92951566cb88aa87ef","e3a92e6680623e9883f9b40aabc3d80092795096f55b22158f65be8dcec178f2","3c84d181b18f5f0ba0f702055b33a6f180a44dccac1f95acbe5608eb3719e739","a284a429192afaa8aa0331618cd35aa37328428a1f8dd406f2f9ea3f9fe6f5bb","71cb11ba5cabbfad48b6c91c95fdab4dfa0adc991fe1c437c425538ff2027bd1","1cb5321b383ae95231af80095b1df882215e4d4b7673897d95b1b476cf1703fa","fba4d43aeae8f7bbbb0f6179a01b2e1c97b821803515b254b8999edbcf3af5d1","619145e6bb6a67185e185549a78b646d183360fd4402a0e17c8f689a91005ada","3a09362a1ad4f8007877c31b41dd9d84e16575fc888c3ca96e68f2cd05d22202","72aeee7eb82877b8a200d4804554ce3d74d6946193ce0181b07ab812395403e4","9d82543919ad545b8407bdd1c9187f83632e40ebc8dd7bb2d6d2140e0b10e6f2"],"paragraph_range_zero_based":[32088,32111],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p32088"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32112},{"literal_text_all_w_t_and_m_t":"–FeatureSets","paragraph_zero_based":32113},{"literal_text_all_w_t_and_m_t":"The IE FeatureSets is used to provide pools of downlink and uplink features sets. A FeatureSetCombination refers to the IDs of the feature set(s) that the UE supports in that FeatureSetCombination. The BandCombination entries in the BandCombinationList then indicate the ID of the FeatureSetCombination that the UE supports for that band combination.","paragraph_zero_based":32114},{"literal_text_all_w_t_and_m_t":"The entries in the lists in this IE are identified by their index position. For example, the FeatureSetUplinkPerCC-Id = 4 identifies the 4th element in the featureSetsUplinkPerCC list.","paragraph_zero_based":32115},{"literal_text_all_w_t_and_m_t":"NOTE:When feature sets (per CC) IEs require extension in future versions of the specification, new versions of the FeatureSetDownlink, FeatureSetUplink, FeatureSets, FeatureSetDownlinkPerCC and/or FeatureSetUplinkPerCC will be created and instantiated in corresponding new lists in the FeatureSets IE. For example, if new capability bits are to be added to the FeatureSetDownlink, they will instead be defined in a new FeatureSetDownlink-rxy which will be instantiated in a new featureSetDownlinkList-rxy list. If a UE indicates in a FeatureSetCombination that it supports the FeatureSetDownlink with ID #5, it implies that it supports both the features in FeatureSetDownlink #5 and FeatureSetDownlink-rxy #5 (if present). The number of entries in the new list(s) shall be the same as in the original list(s).","paragraph_zero_based":32116},{"literal_text_all_w_t_and_m_t":"FeatureSets information element","paragraph_zero_based":32117},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32118},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETS-START","paragraph_zero_based":32119},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32120},{"literal_text_all_w_t_and_m_t":"FeatureSets ::=    SEQUENCE {","paragraph_zero_based":32121},{"literal_text_all_w_t_and_m_t":"    featureSetsDownlink                 SEQUENCE (SIZE (1..maxDownlinkFeatureSets)) OF FeatureSetDownlink               OPTIONAL,","paragraph_zero_based":32122},{"literal_text_all_w_t_and_m_t":"    featureSetsDownlinkPerCC            SEQUENCE (SIZE (1..maxPerCC-FeatureSets)) OF FeatureSetDownlinkPerCC            OPTIONAL,","paragraph_zero_based":32123},{"literal_text_all_w_t_and_m_t":"    featureSetsUplink                   SEQUENCE (SIZE (1..maxUplinkFeatureSets)) OF FeatureSetUplink                   OPTIONAL,","paragraph_zero_based":32124},{"literal_text_all_w_t_and_m_t":"    featureSetsUplinkPerCC              SEQUENCE (SIZE (1..maxPerCC-FeatureSets)) OF FeatureSetUplinkPerCC              OPTIONAL,","paragraph_zero_based":32125},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":32126},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":32127},{"literal_text_all_w_t_and_m_t":"    featureSetsDownlink-v1540           SEQUENCE (SIZE (1..maxDownlinkFeatureSets)) OF FeatureSetDownlink-v1540         OPTIONAL,","paragraph_zero_based":32128},{"literal_text_all_w_t_and_m_t":"    featureSetsUplink-v1540             SEQUENCE (SIZE (1..maxUplinkFeatureSets)) OF FeatureSetUplink-v1540             OPTIONAL,","paragraph_zero_based":32129},{"literal_text_all_w_t_and_m_t":"    featureSetsUplinkPerCC-v1540        SEQUENCE (SIZE (1..maxPerCC-FeatureSets)) OF FeatureSetUplinkPerCC-v1540        OPTIONAL","paragraph_zero_based":32130},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":32131},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":32132},{"literal_text_all_w_t_and_m_t":"    featureSetsDownlink-v15a0           SEQUENCE (SIZE (1..maxDownlinkFeatureSets)) OF FeatureSetDownlink-v15a0         OPTIONAL","paragraph_zero_based":32133},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":32134},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":32135}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["575d75facf9d5c9c59cee93c0dad5d818a0f6e006839b1d2058d8c8704bea4c9","a25a7d68427d639b977cbc0d18be80f8cf6f8a826aae2025d3bb695c69762a21","f31c4a6d0785024e2bcb5628d630dcbc62bd48a5ec2f396178883a7d8266a04a","04179b7b5a821fa254b7bf8c8c288a9a6aab76e82c357f1fd00e8dcbc9d494fd","401264e73f51f6b18629e88522e6d1b841e04f8b2c6ee2369295af1af1a356f1","7e27bf06f5976a19b0cc4659c2e8eac8f862d1f9023bd6b09c311b9870db0412","22ca97167719029c7499416c1b1971b7967354a651de2cfc4daed3227f7b5ca7","622b2b7a1f71e96870e9ef4b468b6ddd4776f3c8cbdd414fb963ce26f5d1018b","19835465b4b5cbce0da41e7b28248cf632be3fa8a82dbf7468e4049bcaddd279","932f8657f3d58cbd1fa576d6b54e3ba3636b57ca2baa854aaf6f913297d99e4d","524e6a692ef117c0fab8879962b889404c70974bb15f80819914dab6808ae52c","893e47077e328dd1ff47f2735d28c71cb13e23449d7dcb59f5b4ddddbfaac8a3","f6b3db68d80c84e56d35e17bc6c7afdf5ae138a6dc712cf8d0c08e4a41e78f90","2bcb6f496dd894f96642a69d8480af22111fde90f2a9b671194f08d4bf290d42","96d0f2f948dc249671e0e3d48b04d9829836b8d59982fdceebea3e57fdcb1e44","08adeb1eca3162914e2a9dba783258c3dbc9c4bd56d7e8361c2bd2fb0daf17d9","7d1fdaf932be6ee07537d3587d9a2dd62f7254dd30fcbd5b1df28492cc6c41d0","6197275dda3406e537d3cfef27c7f65ab4efa1dfe0e1919d62c945981c497897","f04e63358d261308208f58282f6d8bdfe5c6f31aca553c3ddaa2e8924e44f602","2f9537e717e71558af1e8e10d32a15460084e5f8626a178cb773f8401f3a4276","5bc74e40ca3cbb9443a8209299346c166fc3905a85c0b8d733e9f5