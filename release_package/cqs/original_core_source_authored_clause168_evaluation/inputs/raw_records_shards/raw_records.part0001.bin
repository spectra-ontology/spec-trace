{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44016},{"literal_text_all_w_t_and_m_t":"RRC resume","paragraph_zero_based":44017},{"literal_text_all_w_t_and_m_t":"RRCResume","paragraph_zero_based":44018},{"literal_text_all_w_t_and_m_t":"RRCResumeComplete","paragraph_zero_based":44019},{"literal_text_all_w_t_and_m_t":"6 or 10","paragraph_zero_based":44020},{"literal_text_all_w_t_and_m_t":"Value=6 applies for a UE supporting reduced CP latency for the case of RRCResume message only including MAC and PHY configuration, reestablishPDCP and reestablishRLC for SRB2, multicast MRB(s) and DRB(s), and no DRX, SPS, configured grant, CA or MIMO re-configuration will be triggered by this message. Further, the UL grant for transmission of RRCResumeComplete and the data is transmitted over common search space with DCI format 0_0.","paragraph_zero_based":44021},{"literal_text_all_w_t_and_m_t":"In this scenario, the RRC procedure delay [ms] can extend beyond the reception of the UL grant, up to 7 ms.","paragraph_zero_based":44022},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44023},{"literal_text_all_w_t_and_m_t":"For other cases, Value = 10 applies.","paragraph_zero_based":44024},{"literal_text_all_w_t_and_m_t":"RRC resume (MCG SCell addition/restoration/release)","paragraph_zero_based":44025},{"literal_text_all_w_t_and_m_t":"RRCResume","paragraph_zero_based":44026},{"literal_text_all_w_t_and_m_t":"RRCResumeComplete","paragraph_zero_based":44027},{"literal_text_all_w_t_and_m_t":"16","paragraph_zero_based":44028},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44029},{"literal_text_all_w_t_and_m_t":"RRC resume (SCG establishment/ restoration/release)","paragraph_zero_based":44030},{"literal_text_all_w_t_and_m_t":"RRCResume","paragraph_zero_based":44031},{"literal_text_all_w_t_and_m_t":"RRCResumeComplete","paragraph_zero_based":44032},{"literal_text_all_w_t_and_m_t":"16","paragraph_zero_based":44033},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44034},{"literal_text_all_w_t_and_m_t":"RRC resume","paragraph_zero_based":44035},{"literal_text_all_w_t_and_m_t":"DLDedicatedMessageSegment","paragraph_zero_based":44036},{"literal_text_all_w_t_and_m_t":"RRCResumeComplete","paragraph_zero_based":44037},{"literal_text_all_w_t_and_m_t":"16+( Nseg","paragraph_zero_based":44038},{"literal_text_all_w_t_and_m_t":"-1)*10","paragraph_zero_based":44039}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["03e7bb3c4d1683688dae75ce94107f4ed24e64339c229d5833cb04aca49b6c87","0a12169576b83ebcb8b2664714e0d5485fe28750a0ffad932eb2ab010788002c","f8d753da41885c1a756b8e911eff9dfc409f7143a82bfd6236184c2799562bf7","7a1fb9e8fcf760c2057bf0a996564e7dad4395834fc8413850d116ef5b3b92e7","20aa15122db9d48111b139029fed390cf1ff29804662d22d5f707e5d05752489","f61a516d81b97bf367eedde62ba639fbb2a4c2db099232b4b87b0ec42e34ad71","bdb4ecb4ca6ccf9ca8734b75284313adebf7f7a149b40d3e621a6b1e28525df1","0a7b37ea6eb4be191686ac2504021b01e554bdb6ee63ad7dddf010e652829c1f","cfb356496d5814cb89650595bc359e6d1f237caef8b1dd7604844b8ed84f2662","c5165d7a31ebdbcd81fc03d81f71d5ccc660e9b6d72ce63d0b1a316c562fca83","fab63c750f927f947cb77af42775ffd130cfb0128d93473e5cfd69a475c4a80c","f2b133c059b489a776c757f2a2049fccf2637630e5f475a0dabd8242369d9d20","91eef0ae0b9cddbbb1033f26d5882854c18aa9d6a30758af9d483aaba971b2a0","fe93adf1728d92bd858acfb6ce1695a0648e6a40d946a5f24885d52f8f730588","91b1609aeeb500fc3ec6d62d2ac810c812eaa55eeab04c12a51737ffebb3d6af","e332757ee96643e85b639d1de45159d24358d9f7a63785b0665b9c20fd1749e