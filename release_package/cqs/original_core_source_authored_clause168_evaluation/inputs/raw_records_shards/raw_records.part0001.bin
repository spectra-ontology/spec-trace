{"fields":{"filename":"R2-2401569.zip::R2-2401569 RRC corrections for XR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.2.2.4.3Actions upon reception of SIB2","paragraph_zero_based":1032},{"literal_text_all_w_t_and_m_t":"Upon receiving SIB2, the UE shall:","paragraph_zero_based":1033},{"literal_text_all_w_t_and_m_t":"1>if in RRC_IDLE or in RRC_INACTIVE or in RRC_CONNECTED while T311 is running:","paragraph_zero_based":1034},{"literal_text_all_w_t_and_m_t":"2>if, for the entry in frequencyBandList with the same index as the frequency band selected in clause 5.2.2.4.2, the UE supports at least one additionalSpectrumEmission in the nr-NS-PmaxList within the frequencyBandList or","paragraph_zero_based":1035},{"literal_text_all_w_t_and_m_t":"2>if, for the entry in frequencyBandListAerial with the same index as the frequency band selected in clause 5.2.2.4.2, the UE supports at least one additionalSpectrumEmission in the nr-Ns-PmaxListAerial within the frequencyBandListAerial:","paragraph_zero_based":1036},{"literal_text_all_w_t_and_m_t":"3>if the UE is aerial UE and it supports at least one additionalSpectrumEmission values in nr-NS-PmaxListAerial within the frequencyBandListAerial:","paragraph_zero_based":1037},{"literal_text_all_w_t_and_m_t":"4>apply the first listed additionalSpectrumEmission which it supports among the values included in nr-NS-PmaxListAerial within frequencyBandListAerial;","paragraph_zero_based":1038},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":1039},{"literal_text_all_w_t_and_m_t":"4>apply the first listed additionalSpectrumEmission which it supports among the values included in nr-NS-PmaxList within frequencyBandList;","paragraph_zero_based":1040},{"literal_text_all_w_t_and_m_t":"3>if the additionalPmax is present in the same entry of the selected additionalSpectrumEmission within nr-NS-PmaxList or nr-NS-PmaxListAerial:","paragraph_zero_based":1041},{"literal_text_all_w_t_and_m_t":"4>apply the additionalPmax;","paragraph_zero_based":1042},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":1043},{"literal_text_all_w_t_and_m_t":"4>apply the p-Max;","paragraph_zero_based":1044},{"literal_text_all_w_t_and_m_t":"3>if the UE selects a frequency band (from the procedure in clause 5.2.2.4.2) for the supplementary uplink:","paragraph_zero_based":1045},{"literal_text_all_w_t_and_m_t":"4>if, for the entry in frequencyBandListSUL with the same index as the frequency band selected in clause 5.2.2.4.2, the UE supports at least one additionalSpectrumEmission in the nr-NS-PmaxList within the frequencyBandListSUL:","paragraph_zero_based":1046},{"literal_text_all_w_t_and_m_t":"5>apply the first listed additionalSpectrumEmission which it supports among the values included in nr-NS-PmaxList within frequencyBandListSUL;","paragraph_zero_based":1047},{"literal_text_all_w_t_and_m_t":"5>if the additionalPmax is present in the same entry of the selected additionalSpectrumEmission within nr-NS-PmaxList:","paragraph_zero_based":1048},{"literal_text_all_w_t_and_m_t":"6>apply the additionalPmax;","paragraph_zero_based":1049},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":1050},{"literal_text_all_w_t_and_m_t":"6>apply the p-Max;","paragraph_zero_based":1051},{"literal_text_all_w_t_and_m_t":"4>else:","paragraph_zero_based":1052},{"literal_text_all_w_t_and_m_t":"5>apply the p-Max.","paragraph_zero_based":1053},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":1054},{"literal_text_all_w_t_and_m_t":"3>apply the p-Max;","paragraph_zero_based":1055}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"b3775a5d14ac021fc4f5f3e8002b92527fa1c052d9b7c535f196b5410b17f720","original_member_sha256":"0b2b1acef7c2981dcae001f9ad768411cade15b8ef16fbb988748fdb44fd8de1","paragraph_ElementTree_utf8_XML_sha256