{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":24240},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24241},{"literal_text_all_w_t_and_m_t":"MaxMIMO-LayersDCI-0-2-r16 ::=           INTEGER (1..4)","paragraph_zero_based":24242},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24243},{"literal_text_all_w_t_and_m_t":"UplinkHARQ-mode-r17 ::=                 BIT STRING (SIZE (32))","paragraph_zero_based":24244},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24245},{"literal_text_all_w_t_and_m_t":"-- TAG-PUSCH-SERVINGCELLCONFIG-STOP","paragraph_zero_based":24246},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":24247},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24248},{"literal_text_all_w_t_and_m_t":"PUSCH-CodeBlockGroupTransmission field descriptions","paragraph_zero_based":24249},{"literal_text_all_w_t_and_m_t":"maxCodeBlockGroupsPerTransportBlock","paragraph_zero_based":24250},{"literal_text_all_w_t_and_m_t":"Maximum number of code-block-groups (CBGs) per TB (see TS 38.213 [13], clause 9.1).","paragraph_zero_based":24251},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24252},{"literal_text_all_w_t_and_m_t":"PUSCH-ServingCellConfig field descriptions","paragraph_zero_based":24253},{"literal_text_all_w_t_and_m_t":"codeBlockGroupTransmission","paragraph_zero_based":24254},{"literal_text_all_w_t_and_m_t":"Enables and configures code-block-group (CBG) based transmission (see TS 38.214 [19], clause 5.1.5).","paragraph_zero_based":24255},{"literal_text_all_w_t_and_m_t":"The network does not configure this field if the SCS of at least one UL BWP configured in the cell is 480 or 960 kHz.","paragraph_zero_based":24256},{"literal_text_all_w_t_and_m_t":"maxMIMO-Layers","paragraph_zero_based":24257},{"literal_text_all_w_t_and_m_t":"Indicates the maximum MIMO layer to be used for PUSCH in all BWPs of the corresponding UL of this serving cell (see TS 38.212 [17], clause 5.4.2.1). If present, the network sets maxRank to the same value. The field maxMIMO-Layers refers to DCI format 0_1.","paragraph_zero_based":24258},{"literal_text_all_w_t_and_m_t":"nrofHARQ-ProcessesForPUSCH","paragraph_zero_based":24259},{"literal_text_all_w_t_and_m_t":"The number of HARQ processes to be used on the PUSCH of a serving cell. Value n32 corresponds to 32 HARQ processes. If the field is absent, the UE uses 16 HARQ processes (see TS 38.214 [19], clause 6.1).","paragraph_zero_based":24260},{"literal_text_all_w_t_and_m_t":"processingType2Enabled","paragraph_zero_based":24261},{"literal_text_all_w_t_and_m_t":"Enables configuration of advanced processing time capability 2 for PUSCH (see 38.214 [19], clause 6.4).","paragraph_zero_based":24262},{"literal_text_all_w_t_and_m_t":"rateMatching","paragraph_zero_based":24263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["6abb577dc495683d03f860c1ca62f2e1e33c6fbe3a63d2aa304f503aa890df1c","80427e685fded05f630688e0614c6c5c4b885def4f92739ea771a0a4b6bb8371","f4ac4369abd7de7988a49008632d829c98aa02aa6b287c0b7d90253e2be9ee8f","13d6281975a1c44ad9ab6e7d9fac8de61d9607e29d303ad2136fe457f918bc5f","a209b337dfbbae412a12f53c883c25b9921df5e8d207136b3897dc124c4bcb36","9184dc940a00aeaa2db30e7aade2a5cef8a6e7447ff92fa1f5bacc8fa235840e","b364f73f9b78e33605cd1eca5bd4bd45fe5fdf6bf9004d750a904d74ce4c241f","83955283e34c4d8473d6a217cb80a1d586f7d39fe93b0eb6d0826f7cb0831c27","f638e74b4c92ad58ffe168db2d9bec47bfe611d13e4f54215342832d6f506b9b","0356d7eb1ae564413bd1d1d91d2d226ec652e4aba2a89c66c49abc834ae658b2","a86a5aa3696ae1d4a6522a4cfff5bbda504abb68105ff00d78976d2eb39fd54a","11a5095c547af1bf9bcb35534d47cf14d84648467adf55407e8d3ba8f8dc6820","2cab041d8e4d72ab6e99a66bbd17014bd7b0066bd249ae1ba8137bcb218cf2c3","02832a24238369ff4c424a4ae553b6531f7f6de299a9bb08b6e044eff77febc0","dd43b29468b381841e37561a883bccfadbe5563edf774fd0d92569aa63d9ba69","b930c47f5bc9e93589c7ebb8c173a2946e5526a1ee9fa1db38e647b14b23a354","6fe7fa198831fd80236540814692bc08031040585e9ebb425f5b50ed5c95d587","92e74f256eeab6f815fa3afb5c80583837495a0984b548ac05c92532cce8285b","a8c06c93cf2e74a027ac1e1c8cdf94f775d6c70999aff748479ebced41933a65","4ab05fe6b8d01c72ad798d26971f6e843934f5b4b71147d2e79a642726a846fd","da89837805b02541e04ce24d136532f879dcbe5b808b3ba41dace533b382c24f","555bf7ecb6eaafe94cd1fbcd9931a550f0f3039d99d157a6b43dd0ec2ee6a2f2","4c880068e14fce448ad72242890718c1437532c66009d45039f2d9838a26c332","39dd42f27c2351c53b445e2a1411d66da15f2c246d21cc90f9c2b72a5751e4eb"],"paragraph_range_zero_based":[24240,24263],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p24240"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Enables LBRM (Limited buffer rate-matching). When the field is absent the UE applies FBRM (Full buffer rate-matchingLBRM) (see TS 38.212 [17], clause 5.4.2).","paragraph_zero_based":24264},{"literal_text_all_w_t_and_m_t":"xOverhead","paragraph_zero_based":24265},{"literal_text_all_w_t_and_m_t":"If the field is absent, the UE applies the value 'xoh0' (see TS 38.214 [19], clause 5.1.3.2).","paragraph_zero_based":24266},{"literal_text_all_w_t_and_m_t":"maxMIMO-LayersDCI-0-2","paragraph_zero_based":24267},{"literal_text_all_w_t_and_m_t":"Indicates the maximum MIMO layer to be used for PUSCH for DCI format 0_2 in all BWPs of the corresponding UL of this serving cell (see TS 38.212 [17], clause 5.4.2.1). If present, the network sets maxRankDCI-0-2 to the same value.","paragraph_zero_based":24268},{"literal_text_all_w_t_and_m_t":"uplinkHARQ-mode","paragraph_zero_based":24269},{"literal_text_all_w_t_and_m_t":"Used to set the HARQ mode per HARQ process ID, see TS 38.321 [3]. The first/leftmost bit corresponds to HARQ process ID 0, the next bit to HARQ process ID 1 and so on. Bits corresponding to HARQ process IDs that are not configured shall be ignored. A bit set to one identifies a HARQ process with HARQmodeA and a bit set to zero identifies a HARQ process with HARQ modeB. This field applies for SRBs and DRBs.","paragraph_zero_based":24270},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24271},{"literal_text_all_w_t_and_m_t":"–PUSCH-TimeDomainResourceAllocationList","paragraph_zero_based":24272},{"literal_text_all_w_t_and_m_t":"The IE PUSCH-TimeDomainResourceAllocation is used to configure a time domain relation between PDCCH and PUSCH. PUSCH-TimeDomainResourceAllocationList contains one or more of such PUSCH-TimeDomainResourceAllocations. The network indicates in the UL grant which of the configured time domain allocations the UE shall apply for that UL grant. The UE determines the bit width of the DCI field based on the number of entries in the PUSCH-TimeDomainResourceAllocationList. Value 0 in the DCI field refers to the first element in this list, value 1 in the DCI field refers to the second element in this list, and so on.","paragraph_zero_based":24273},{"literal_text_all_w_t_and_m_t":"PUSCH-TimeDomainResourceAllocation information element","paragraph_zero_based":24274},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":24275},{"literal_text_all_w_t_and_m_t":"-- TAG-PUSCH-TIMEDOMAINRESOURCEALLOCATIONLIST-START","paragraph_zero_based":24276},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24277},{"literal_text_all_w_t_and_m_t":"PUSCH-TimeDomainResourceAllocationList ::=  SEQUENCE (SIZE(1..maxNrofUL-Allocations)) OF PUSCH-TimeDomainResourceAllocation","paragraph_zero_based":24278},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24279},{"literal_text_all_w_t_and_m_t":"PUSCH-TimeDomainResourceAllocation ::=  SEQUENCE {","paragraph_zero_based":24280},{"literal_text_all_w_t_and_m_t":"    k2                                      INTEGER(0..32)                                  OPTIONAL,   -- Need S","paragraph_zero_based":24281},{"literal_text_all_w_t_and_m_t":"    mappingType                             ENUMERATED {typeA, typeB},","paragraph_zero_based":24282},{"literal_text_all_w_t_and_m_t":"    startSymbolAndLength                    INTEGER (0..127)","paragraph_zero_based":24283},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":24284},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24285},{"literal_text_all_w_t_and_m_t":"PUSCH-TimeDomainResourceAllocationList-r16 ::=  SEQUENCE (SIZE(1..maxNrofUL-Allocations-r16)) OF PUSCH-TimeDomainResourceAllocation-r16","paragraph_zero_based":24286},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24287}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["f14644ffe2cd1e0d520cb81886d21dba88b68cd9595790a5fded0754e5e0480a","f630c7c344977c2c8a72d289b96e1445893a29f0a0c94f7761c0fbdba069bbae","6022e2f101d845f6d3f2e3f3e30795990400ac155ae983fcf54e48121d431e7b","6d20e5189a6f47cdff0fc26b0bd660d611de43252ead8c8a931b4f2dd5649987","e07017f64e59144571fee794fb0bc86860d6425eddcc5556e0ad1103c1dd5371","0607b1bf6815b26b9559b6f6b1d1db416bebbfe6779a41f8b29e3427f9bedc26","16492a73508d3650d937afd1c347470d1f6d3cff687524822863358e62b89a2e","e85b5224090cf37c45e0cb0b06813fad2153739ca5b9b4abce488c122a360c7b","5e1366a6208c4c406893685a89394a3d6ec63dc01cf71fcccf802b5d335eae06","dcec812534fb1748ea893555e998572c2481e0403717274ef15984f4b301f41d","4f320cc37dbd587fe13b1073b04b04fa8977666585c0f36f3d11f4ca6b93fd8f","b4a95fa40e40d444a131291780f1ee823dde682186c03193adf2979e7ab83c0c","ce34ec14f51bdb18ecda6d21da38d442a076b32c10bce7ec7dbfc85f67f2509a","41e9b8acb9b2781e10c583923d3e140470a22f79a89ddf399d6e9fa5fb0ab9af","963b9d107306408c73eabfdf5ae674d93bb08440ac12a9e14d59c8e5cdafe99a","288d7741372ebd613b415942c7689ce0e2d00b726118cde6116985c7696dcdb6","ef1dd62c91ae556cd0b46586769b6aa6b391a5c1657bb675ac408dd2b0918ef2","90338c02add2182c8fe07892194f4789d0befd9900b2c5aacb9e4b1565fc70a7","256a6d88e2a6c0a3dbb9586052dbbd6b2d07c1fbe80474621959db22726582e5","910e1fcc175065d4c6f974252919aa5414ac0de9e990b343b3d814d403506d2b","b5ae9569450f07a6c55aa2b687ba554f99fe70b1ee1e3e3e6b6eca6bc607c1ce","bcd9bdc97ff894ced631c119dcc2ba7d7dad48da63524f204f8fe4375dcfbe40","f8ebd0967f313732d960631358008a4d287ea3aa8f0336a35d38b82765d11f02","6dbd2cc7f1b8c685d90c203a348b26c615f071875a9b203be5a4efe8c68c3555"],"paragraph_range_zero_based":[24264,24287],"projectio