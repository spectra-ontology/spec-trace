{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE CellReselectionSubPriority indicates a fractional value to be added to the value of cellReselectionPriority to obtain the absolute priority of the concerned carrier frequency for E-UTRA and NR. Value oDot2 corresponds to 0.2, value oDot4 corresponds to 0.4 and so on.","paragraph_zero_based":15600},{"literal_text_all_w_t_and_m_t":"CellReselectionSubPriority information element","paragraph_zero_based":15601},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":15602},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLRESELECTIONSUBPRIORITY-START","paragraph_zero_based":15603},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15604},{"literal_text_all_w_t_and_m_t":"CellReselectionSubPriority ::=          ENUMERATED {oDot2, oDot4, oDot6, oDot8}","paragraph_zero_based":15605},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15606},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLRESELECTIONSUBPRIORITY-STOP","paragraph_zero_based":15607},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":15608},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15609},{"literal_text_all_w_t_and_m_t":"–CFR-ConfigMulticast","paragraph_zero_based":15610},{"literal_text_all_w_t_and_m_t":"The IE CFR-ConfigMulticast indicates UE specific common frequency resource configuration for multicast for one dedicated BWP.","paragraph_zero_based":15611},{"literal_text_all_w_t_and_m_t":"CFR-ConfigMulticast information element","paragraph_zero_based":15612},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":15613},{"literal_text_all_w_t_and_m_t":"-- TAG-CFR-CONFIGMULTICAST-START","paragraph_zero_based":15614},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15615},{"literal_text_all_w_t_and_m_t":"CFR-ConfigMulticast-r17::= SEQUENCE {","paragraph_zero_based":15616},{"literal_text_all_w_t_and_m_t":"    locationAndBandwidthMulticast-r17              INTEGER (0..37949)                       OPTIONAL,    -- Need S","paragraph_zero_based":15617},{"literal_text_all_w_t_and_m_t":"    pdcch-ConfigMulticast-r17                      PDCCH-Config                             OPTIONAL,    -- Need M","paragraph_zero_based":15618},{"literal_text_all_w_t_and_m_t":"    pdsch-ConfigMulticast-r17                      PDSCH-Config                             OPTIONAL,    -- Need M","paragraph_zero_based":15619},{"literal_text_all_w_t_and_m_t":"    sps-ConfigMulticastToAddModList-r17            SPS-ConfigMulticastToAddModList-r17      OPTIONAL,    -- Need N","paragraph_zero_based":15620},{"literal_text_all_w_t_and_m_t":"    sps-ConfigMulticastToReleaseList-r17           SPS-ConfigMulticastToReleaseList-r17     OPTIONAL     -- Need N","paragraph_zero_based":15621},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":15622},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15623}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["984ca625fcd0f8a16df2497ba16e1e4bce44753be996583caa0a863416da86c5","16d9af06ab9d966c81091fcd7ed4e0e2088df17276f4101b7bf6ecc707b80901","4914427f69316108f04940c7be86968c231a4bd4158fe38a05ab52053cf5cd2b","64264d823b3d66ff07121a3b3e257f93eecfac7e19bd88fd760c81dd56af86dd","e49744ccd4691ddd6286f96271cd7a6b03e1b5f20d751cec267a3d3f82266676","ba15144e3b6b6677cb2a342911998985387d600544ff686539513ad1d3719849","08598e5d6cf3298d3e9532dfbbb414030e5b2bb87669c1374d60384087b35d9b","4bde2c62a6976f936757c839fd5db5ccc476e7cf97bddee5e1d008a5e67cade2","4d83e2f93aaf0b90e482104d44b43be0d2c9e1bbd117