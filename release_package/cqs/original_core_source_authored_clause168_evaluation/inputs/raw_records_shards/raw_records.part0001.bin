{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-UE-SelectedConfig","paragraph_zero_based":37824},{"literal_text_all_w_t_and_m_t":"Indicates the configuration used for UE autonomous resource selection. This field is not configured simultaneously with sl-ScheduledConfig.","paragraph_zero_based":37825},{"literal_text_all_w_t_and_m_t":"sl-CSI-Acquisition","paragraph_zero_based":37826},{"literal_text_all_w_t_and_m_t":"Indicates whether CSI reporting is enabled in sidelink unicast. If the field is absent, sidelink CSI reporting is disabled.","paragraph_zero_based":37827},{"literal_text_all_w_t_and_m_t":"sl-CSI-SchedulingRequestId","paragraph_zero_based":37828},{"literal_text_all_w_t_and_m_t":"If present, it indicates the scheduling request configuration applicable for Sidelink CSI Reporting MAC CE and Sidelink DRX Command MAC CE, as specified in TS 38.321 [3].","paragraph_zero_based":37829},{"literal_text_all_w_t_and_m_t":"sl-SSB-PriorityNR","paragraph_zero_based":37830},{"literal_text_all_w_t_and_m_t":"This field indicates the priority of NR sidelink SSB transmission and reception.","paragraph_zero_based":37831},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37832},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":37833},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":37834},{"literal_text_all_w_t_and_m_t":"L2RelayUE","paragraph_zero_based":37835},{"literal_text_all_w_t_and_m_t":"For L2 U2N Relay UE, the field is optionally present, Need M. Otherwise, it is absent.","paragraph_zero_based":37836},{"literal_text_all_w_t_and_m_t":"L2RemoteUE","paragraph_zero_based":37837},{"literal_text_all_w_t_and_m_t":"For L2 U2N Remote UE, the field is optionally present, Need M. Otherwise, it is absent.","paragraph_zero_based":37838},{"literal_text_all_w_t_and_m_t":"L2U2N","paragraph_zero_based":37839},{"literal_text_all_w_t_and_m_t":"The field is optional present for L2 U2N Relay UE and L2 U2N Remote UE, need N. Otherwise, it is absent.","paragraph_zero_based":37840},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37841},{"literal_text_all_w_t_and_m_t":"–SL-ConfiguredGrantConfig","paragraph_zero_based":37842},{"literal_text_all_w_t_and_m_t":"The IE SL-ConfiguredGrantConfig specifies the configured grant configuration information for NR sidelink communication.","paragraph_zero_based":37843},{"literal_text_all_w_t_and_m_t":"SL-ConfiguredGrantConfig information element","paragraph_zero_based":37844},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":37845},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-CONFIGUREDGRANTCONFIG-START","paragraph_zero_based":37846},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37847}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["006f695223e0614ebca24635a2dacc54ea565fb50ae5d15c810875f3b5e6ab2f","676609e4f8bad45eab8d1bbc48471dad22df83cb9a990f143622cc7c0fecbf05","c4b02f21fa14511e17f015147be05c47f9e60015048f22a8885e59f7843cf82d","0704ae997575ff093519f0f1d0131a969cde783878685064a97f3345eb23271c","5a9ad074fc171c2ace75c6edefe0282be6294f068ab251b0fad5f321b4927ec0","5bdf7119c804d6808af8472abd120e0228ed8dbebe32f3fc9beb29565fc653ec","35d837cbf26b241f6f95bd5c646c93a857b3f90c881d611063dfba34d2982532","841f493bd53441226d0ef0b4e2cec8bcb30ba2ca051691fe8f1349054ee04fc2","bfb07f3f9fb56d25817427f289347a4e9d0a2de2626bdcde31ffbda88c6be69f","25c21ee37f0f4b60672538ff11c527e21b2f1e73b2401dad27220adf28bd57ec","58f34c7e4bff0f41371cc72dcd549558ba78ee8a616b60c1aedada80c412abb5","63ba5843a957d358a018d88bdf