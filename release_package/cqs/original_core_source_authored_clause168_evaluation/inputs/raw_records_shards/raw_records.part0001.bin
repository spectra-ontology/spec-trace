{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SearchSpaceId information element","paragraph_zero_based":27456},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27457},{"literal_text_all_w_t_and_m_t":"-- TAG-SEARCHSPACEID-START","paragraph_zero_based":27458},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27459},{"literal_text_all_w_t_and_m_t":"SearchSpaceId ::=                   INTEGER (0..maxNrofSearchSpaces-1)","paragraph_zero_based":27460},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27461},{"literal_text_all_w_t_and_m_t":"-- TAG-SEARCHSPACEID-STOP","paragraph_zero_based":27462},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27463},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27464},{"literal_text_all_w_t_and_m_t":"–SearchSpaceZero","paragraph_zero_based":27465},{"literal_text_all_w_t_and_m_t":"The IE SearchSpaceZero is used to configure SearchSpace#0 of the initial BWP (see TS 38.213 [13], clause 13).","paragraph_zero_based":27466},{"literal_text_all_w_t_and_m_t":"SearchSpaceZero information element","paragraph_zero_based":27467},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27468},{"literal_text_all_w_t_and_m_t":"-- TAG-SEARCHSPACEZERO-START","paragraph_zero_based":27469},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27470},{"literal_text_all_w_t_and_m_t":"SearchSpaceZero ::=                 INTEGER (0..15)","paragraph_zero_based":27471},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27472},{"literal_text_all_w_t_and_m_t":"-- TAG-SEARCHSPACEZERO-STOP","paragraph_zero_based":27473},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27474},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27475},{"literal_text_all_w_t_and_m_t":"–SecurityAlgorithmConfig","paragraph_zero_based":27476},{"literal_text_all_w_t_and_m_t":"The IE SecurityAlgorithmConfig is used to configure AS integrity protection algorithm and AS ciphering algorithm for SRBs and DRBs.","paragraph_zero_based":27477},{"literal_text_all_w_t_and_m_t":"SecurityAlgorithmConfig information element","paragraph_zero_based":27478},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["150c2c1aab1238fe7d1789857e550bf6730d38b641f62df5f962983a59295e8c","7267279cddd79637041db697fd284377c8dabd3a22589884fd1ad4e16aa0864c","53a1e20c3730f4f2dbbb033384acb6a48b98385a58204987ed8cad774ee9bf7c","8a19170a3f2905533cfb9da4dc14543bc5e5b2eeed36762f0a56e093f7a3569a","112631c9517b228a7db7e7dfd574a104e1bc8d61bf11ebc170e8dfe3ef4a7270","6a90f4e89783f7f2e364398bf7a81a0291635789ad77ed7b4a04d1eb500ddfce","9c74a9ca6d57d89dda507b63bccf0d62f1bc072d7a42f5ca87a25575fdf26c84","545451b24e610c84d8e5aab99725dfb49bf2b3a31b00999da2bf183f38d426a7","4c72bd1aee082601e3390ede6138aa70ee0c6d0c850a3fb315c72689bf9b1242","6f471ad3bb6af2ebbba679edbca9518d119daa98707d4c955dade099c043eebd","b9ab4dc1d8dad443a717d71c1e831aa8ffe24fcd88b816a41ab01a82879cf2a2","e057d155c853f2eda00d260872addbac78537d318efe29fe6a4dee206f5a8c8a","5b7334eff6dcd0f9347b9048f9166d255dc952eb7a73f2c5314e5015a8c011a4","cd748ce4694a723d88424ed117691fc7ba0e6ccdc4bc7692f4ba406824604984","f0e07806d9b69bda9fbf6e1f1041be33c15b6be6ab23c5e43ce9f07cee1984ca","3437e168531822cdd7201f6b5ca4c9875b5047b38b0bf63ddcc1a4a604477ea9","3dbe5b9306aa83fa8b7f8c83a5d54fe45dd5614e1ba9318af661b3c8d362d94b","d3fbb6b2706850f33717b4c05c864c1fa9967809276a33dc1c5f13c538a1a77b","c46240e0c23863575966877ff92070dd237267357d9