9, min10, min12, min14, min17, min20,","paragraph_zero_based":43216},{"literal_text_all_w_t_and_m_t":"                                    min24, min28, min33, min38, min44, min50, hr1,","paragraph_zero_based":43217},{"literal_text_all_w_t_and_m_t":"                                    hr1min30, hr2, hr2min30, hr3, hr3min30, hr4, hr5, hr6,","paragraph_zero_based":43218},{"literal_text_all_w_t_and_m_t":"                                    hr8, hr10, hr13, hr16, hr20, day1, day1hr12, day2,","paragraph_zero_based":43219},{"literal_text_all_w_t_and_m_t":"                                    day2hr12, day3, day4, day5, day7, day10, day14, day19,","paragraph_zero_based":43220},{"literal_text_all_w_t_and_m_t":"                                    day24, day30, dayMoreThan30}                            OPTIONAL,","paragraph_zero_based":43221},{"literal_text_all_w_t_and_m_t":"    candidateCellInfoList       MeasResultList2NR                                           OPTIONAL,","paragraph_zero_based":43222},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":43223}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["4e64521b090a6b17d455ee1939e3addc9157aca78d251a51cf3f751dfd4cac79","a2096630da6da8a40c0665f0d688c92e32f2e861ee4a6b05dfa433aa3c9d7b0e","8974a17524f580b6c77a06d48a82ebf0813bd8f85295909479644252de1cea70","02b29998ee4313085dddfe951f77a1718cc74f10d257d4f11382b65f189a3921","7a6f984cdb7931b868e44f4f1c708f6bb802a2b9942b9db20a84fca1713f4fd6","3dd8ba223ecd030ba9d27a9676fe46f0461b0de127945f6f1f8ac1fff324451f","6c9c2a164281ef345df2051e57a7bd4797b1421756314a066842bdfd19e2190c","462280e2f700d453d4bc2d11e1570e96e76a897160e7da587541181093bfc300","a644310f7a38c6da9bd23e6ec4d8