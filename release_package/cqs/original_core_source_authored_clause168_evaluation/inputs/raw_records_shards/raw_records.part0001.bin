{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"MeasTriggerQuantityUTRA-FDD-r16 ::=          CHOICE{","paragraph_zero_based":25632},{"literal_text_all_w_t_and_m_t":"    utra-FDD-RSCP-r16                            INTEGER (-5..91),","paragraph_zero_based":25633},{"literal_text_all_w_t_and_m_t":"    utra-FDD-EcN0-r16                            INTEGER (0..49)","paragraph_zero_based":25634},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25635},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25636},{"literal_text_all_w_t_and_m_t":"MeasReportQuantityUTRA-FDD-r16 ::=        SEQUENCE {","paragraph_zero_based":25637},{"literal_text_all_w_t_and_m_t":"    cpich-RSCP                                BOOLEAN,","paragraph_zero_based":25638},{"literal_text_all_w_t_and_m_t":"    cpich-EcN0                                BOOLEAN","paragraph_zero_based":25639},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25640},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25641},{"literal_text_all_w_t_and_m_t":"-- TAG-REPORTCONFIGINTERRAT-STOP","paragraph_zero_based":25642},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":25643},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25644},{"literal_text_all_w_t_and_m_t":"ReportConfigInterRAT field descriptions","paragraph_zero_based":25645},{"literal_text_all_w_t_and_m_t":"reportType","paragraph_zero_based":25646},{"literal_text_all_w_t_and_m_t":"Type of the configured measurement report. In (NG)EN-DC, and NR-DC, network does not configure report of type ReportCGI-EUTRA for SCG.","paragraph_zero_based":25647},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25648},{"literal_text_all_w_t_and_m_t":"ReportCGI-EUTRA field descriptions","paragraph_zero_based":25649},{"literal_text_all_w_t_and_m_t":"useAutonomousGaps","paragraph_zero_based":25650},{"literal_text_all_w_t_and_m_t":"Indicates whether or not the UE is allowed to use autonomous gaps in acquiring system information from the E-UTRAN neighbour cell. When the field is included, the UE applies the corresponding value for T321.","paragraph_zero_based":25651},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25652},{"literal_text_all_w_t_and_m_t":"EventTriggerConfigInterRAT field descriptions","paragraph_zero_based":25653},{"literal_text_all_w_t_and_m_t":"b2-Threshold1","paragraph_zero_based":25654},{"literal_text_all_w_t_and_m_t":"NR threshold to be used in inter RAT measurement report triggering condition for event B2.","paragraph_zero_based":25655}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["9b1803c01e30ef4a94aa92f99d3a112195d924026ff92df1a4ac0803849e2e71","a985a70933cd584a2767f0dc7f66d36f41edb3ac650706567e9d0bb90b9abc11","4e8a22ec378e6539737f09d9a2bacf712e916477d41c0e564decc5f319d2adbb","5d031c83d33badb19c8e3e0591458b999d07d38dec676adaa69ab2582faa1d66","fc33c7115e6f692762279fe1bd9b88bec4f58b4d9c83e9840fa37caa130d9a27","eaf29aa8a71706088edf6af7e613692075eb612c234aaa195bef2078953bfb87","b82c8bfd1372ecc6170ada8395cdc5932433af0fca9ce2f7ae85f6e8d2d8a40c","fcc75ba37f380e8c72a5d7e63053911c249c9a9e9542703f0beb61107189be7c","f6fe4cb102c7d2c72226fe2607d53a0d38c7a9d544653f746ca9399d01428226","c8245440da23bcd050bbc103dcf7832a4416e998afcc7006804842b6d36d1ba8","6872f97c689893fab5892035617e47e2b40f00884e1ab5cd9e77a3cf0065e5fc","f864361ba6a72f430b3d56dd597e1600ca7e4e07f4df4e1e2200ef3f8a768f3b","9de77501fe43a505cd8649637769f5853542ac39e2e8735d2c23397dae77fbc1","2df5110b2077f6b5bda02a977986125330b32887334e4028fd1797757bd81310","cbf64b1ea149ba8bdc8c166bb28f0680fcf909f28e3c4f2d2f98f5909ffa7447","190fa19d1ddb3c0393132b1da61ba963827574ab0a40ea34a2ca9fe5745bb98a","41593649795d74dace34b21f7f67c88fbec1283282a4580fbbed825fdf911f4b","0db157ea8b26feb41d1850b0ac905507ea867275799cecfdafdec0c51f086841","1ba54dcce2f3c36a994183f041d8c939ca87fbdb72d5805f0c026e7115c78556","e12b5f452ee412449bd5add43c4daf69220feea7d492b3661d1d0fc3278fce12","1682f8e1a7439a1b30db11e63d1d8104a61dbb8e3b62bfbc5f22a5dfcb68d8fa","2dd95710826bb658f9ae94bbe937a4ceae9ae4d1c981508ef2f014f657e49b91","01180329c0e78f9301583679faf318188d6f2e1b46ce71f8bd444bc8eebca936","40e9c24fd7d39eb11955c1f4305770ca0f31e3b972c5fbd115f27c4bad390768"],"paragraph_range_zero_based":[25632,25655],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p25632"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"bN-ThresholdEUTRA","paragraph_zero_based":25656},{"literal_text_all_w_t_and_m_t":"E-UTRA threshold value associated with the selected trigger quantity (RSRP, RSRQ, SINR) to be used in inter RAT measurement report triggering condition for event number bN. In the same eventB2, the network configures the same CHOICE name (rsrp, rsrq or sinr) for the MeasTriggerQuantity of the b2-Threshold1 and for the MeasTriggerQuantityEUTRA of the b2-Threshold2EUTRA.","paragraph_zero_based":25657},{"literal_text_all_w_t_and_m_t":"eventId","paragraph_zero_based":25658},{"literal_text_all_w_t_and_m_t":"Choice of inter RAT event triggered reporting criteria.","paragraph_zero_based":25659},{"literal_text_all_w_t_and_m_t":"maxReportCells","paragraph_zero_based":25660},{"literal_text_all_w_t_and_m_t":"Max number of non-serving cells/candidate L2 U2N Relay UEs to include in the measurement report.","paragraph_zero_based":25661},{"literal_text_all_w_t_and_m_t":"reportAmount","paragraph_zero_based":25662},{"literal_text_all_w_t_and_m_t":"Number of measurement reports applicable for eventTriggered as well as for periodical report types","paragraph_zero_based":25663},{"literal_text_all_w_t_and_m_t":"reportOnLeave","paragraph_zero_based":25664},{"literal_text_all_w_t_and_m_t":"Indicates whether or not the UE shall initiate the measurement reporting procedure when the leaving condition is met for a cell in cellsTriggeredList, as specified in 5.5.4.1.","paragraph_zero_based":25665},{"literal_text_all_w_t_and_m_t":"reportQuantity, reportQuantityUTRA-FDD","paragraph_zero_based":25666},{"literal_text_all_w_t_and_m_t":"The cell measurement quantities to be included in the measurement report. If the field eventB1-UTRA-FDD or eventB2-UTRA-FDD is present, the UE shall ignore the value(s) provided in reportQuantity.","paragraph_zero_based":25667},{"literal_text_all_w_t_and_m_t":"reportQuantityRelay","paragraph_zero_based":25668},{"literal_text_all_w_t_and_m_t":"The L2 U2N Relay UE measurement quantity to be included in measuremet report.","paragraph_zero_based":25669},{"literal_text_all_w_t_and_m_t":"timeToTrigger","paragraph_zero_based":25670},{"literal_text_all_w_t_and_m_t":"Time during which specific criteria for the event needs to be met in order to trigger a measurement report.","paragraph_zero_based":25671},{"literal_text_all_w_t_and_m_t":"bN-ThresholdUTRA-FDD","paragraph_zero_based":25672},{"literal_text_all_w_t_and_m_t":"UTRA-FDD threshold value associated with the selected trigger quantity (RSCP, EcN0) to be used in inter RAT measurement report triggering condition for event number bN.","paragraph_zero_based":25673},{"literal_text_all_w_t_and_m_t":"utra-FDD-RSCP corresponds to CPICH_RSCP in TS 25.133 [46] for FDD. utra-FDD-EcN0 corresponds to CPICH_Ec/No in TS 25.133 [46] for FDD.","paragraph_zero_based":25674},{"literal_text_all_w_t_and_m_t":"For utra-FDD-RSCP: The actual value is field value – 115 dBm.","paragraph_zero_based":25675},{"literal_text_all_w_t_and_m_t":"For utra-FDD-EcN0: The actual value is (field value – 49)/2 dB.","paragraph_zero_based":25676},{"literal_text_all_w_t_and_m_t":"y1-Threshold1","paragraph_zero_based":25677},{"literal_text_all_w_t_and_m_t":"NR threshold to be used in measurement report triggering condition for event Y1.","paragraph_zero_based":25678},{"literal_text_all_w_t_and_m_t":"yN-Threshold2-Relay","paragraph_zero_based":25679}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["5a27155b29d5a21a4497e247cd70c24e29a444c148409838c