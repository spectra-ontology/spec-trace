er-r16 ::=   SEQUENCE {","paragraph_zero_based":28482},{"literal_text_all_w_t_and_m_t":"    servingCellId-r16                  ServCellIndex,","paragraph_zero_based":28483},{"literal_text_all_w_t_and_m_t":"    positionInDCI-r16                  INTEGER(0..maxSFI-DCI-PayloadSize-1)","paragraph_zero_based":28484},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28485},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28486},{"literal_text_all_w_t_and_m_t":"-- TAG-SLOTFORMATINDICATOR-STOP","paragraph_zero_based":28487}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["d842e228687f3fa3f8799684d92e03ad25923598155e18f0a5316d9763d9e3d6","d3b5ab68f9a26a65c711187efbd90656bf05f637b2ac86ed7f56da2c96496eec","945e669efa3915935e3775d5a372b14fdf82821ee7a1265e30e9b177e73dccfc","fefd9fe99cb477f6dfdf6b08c47ff9fdf9ad9fcf57246d58a757764c7c2e1b84","7b014c5105ebe6c8ba08d65941447b86b3c7eaf431bf994261542f89f58a3e4e","d3e783c8307f73eabfacb53ca7423a84ffe76eb7e37f21e0ae1d45458e7cef4d","24a6101f8a20c50d3b3db5448dd1b085bc87c2383eda93bef2ed0cb246bce776","be962a33e2d72b90769174eaf706ff79cff7f56e804a3d020be4a0ac29a3c0dd","5f7b94deda567ce1a14a2cc374ffcf6723b253d73c8bc68f42042f69e3149c17","4a1510626fa3b3c7095794a828667234ac9786a5ae1e492fd03449283ecdbf7b","50809940c40aeb41410a2149c616c12ca88fe48b5a940f3aa5383a9d4b7953f3","535a4debc722994ac7fc5e3b59c2b8e6ff7845998a9b2e3cb16904896ed25be3","df4e7b8fd4d42f26a5ebc2198003ae149037739cf39e050c534912ff61ed38a0","d49e23cce796c97889e54a4dc437524a6647def35799dcb606eae7cca5d34f0d","3ec117693d4db98b4de417f44a4959746a880bfd38ba545152040f8e2383a6b7","3ac6317b7652346739992b8b592f4a93d58d8a9ac729ad6b38d729d78edaf387","d0ef077c36a2f5361e597b06de47531344