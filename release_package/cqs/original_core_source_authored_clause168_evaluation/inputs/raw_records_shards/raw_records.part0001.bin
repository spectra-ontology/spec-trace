{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"eutra-ExcludedCellList","paragraph_zero_based":13344},{"literal_text_all_w_t_and_m_t":"List of exclude-listed E-UTRA neighbouring cells.","paragraph_zero_based":13345},{"literal_text_all_w_t_and_m_t":"eutra-FreqNeighHSDN-CellList","paragraph_zero_based":13346},{"literal_text_all_w_t_and_m_t":"List of neighbouring EUTRA HSDN cells as specified in TS 36.304 [27].","paragraph_zero_based":13347},{"literal_text_all_w_t_and_m_t":"eutra-multiBandInfoList","paragraph_zero_based":13348},{"literal_text_all_w_t_and_m_t":"Indicates the list of frequency bands in addition to the band represented by carrierFreq for which cell reselection parameters are common, and a list of additionalPmax and additionalSpectrumEmission values, as defined in TS 36.101 [22], table 6.2.4-1, for the frequency bands in eutra-multiBandInfoList","paragraph_zero_based":13349},{"literal_text_all_w_t_and_m_t":"highSpeedEUTRACarrier","paragraph_zero_based":13350},{"literal_text_all_w_t_and_m_t":"If the field is present, the UE shall apply the enhanced NR-EUTRA inter-RAT measurement requirements to support high speed up to 500 km/h as specified in TS 38.133 [14] to the E-UTRA carrier.","paragraph_zero_based":13351},{"literal_text_all_w_t_and_m_t":"idleModeMeasVoiceFallback","paragraph_zero_based":13352},{"literal_text_all_w_t_and_m_t":"Indicates whether E-UTRA idle/inactive measurements and reporting for EPS fallback can be used.","paragraph_zero_based":13353},{"literal_text_all_w_t_and_m_t":"p-MaxEUTRA","paragraph_zero_based":13354},{"literal_text_all_w_t_and_m_t":"The maximum allowed transmission power in dBm on the (uplink) carrier frequency, see TS 36.304 [27].","paragraph_zero_based":13355},{"literal_text_all_w_t_and_m_t":"q-QualMin","paragraph_zero_based":13356},{"literal_text_all_w_t_and_m_t":"Parameter \"Qqualmin\" in TS 36.304 [27]. Actual value Qqualmin = field value [dB].","paragraph_zero_based":13357},{"literal_text_all_w_t_and_m_t":"q-QualMinOffsetCell","paragraph_zero_based":13358},{"literal_text_all_w_t_and_m_t":"Parameter \"Qqualminoffsetcell\" in TS 36.304 [27]. Actual value Qqualminoffsetcell = field value [dB].","paragraph_zero_based":13359},{"literal_text_all_w_t_and_m_t":"q-RxLevMin","paragraph_zero_based":13360},{"literal_text_all_w_t_and_m_t":"Parameter \"Qrxlevmin\" in TS 36.304 [27]. Actual value Qrxlevmin = field value * 2 [dBm].","paragraph_zero_based":13361},{"literal_text_all_w_t_and_m_t":"q-RxLevMinOffsetCell","paragraph_zero_based":13362},{"literal_text_all_w_t_and_m_t":"Parameter \"Qrxlevminoffsetcell\" in TS 36.304 [27]. Actual value Qrxlevminoffsetcell = field value * 2 [dB].","paragraph_zero_based":13363},{"literal_text_all_w_t_and_m_t":"t-ReselectionEUTRA","paragraph_zero_based":13364},{"literal_text_all_w_t_and_m_t":"Parameter \"TreselectionEUTRA\" in TS 38.304 [20].","paragraph_zero_based":13365},{"literal_text_all_w_t_and_m_t":"threshX-High","paragraph_zero_based":13366},{"literal_text_all_w_t_and_m_t":"Parameter \"ThreshX, HighP\" in TS 38.304 [20].","paragraph_zero_based":13367}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["d4a9b547612c03ad16e0c822aee0ea1908d3b58a7f855283e8fc0ecfe09591d6","dbc1dbba77a7434da1a0a4658addb7941a4adf817665356f2fb6d3733bca6ca7","691530ac536ffba46fe8e2651374f327ba0aa1b4b442a4f15dfc5ada6c2f3d8f","6a341912390e3097fdd217cb19eb1d63d93562914860cb4ccd4c7294b5b63e6f","8f19c8aca3535b8bd502aecba6007d56ecb90847fa2595d8784b825e0832e58a","280d4205a882c6fabe9323cef8175896488edb5a644ed696054ea69ccd55d6ed","65ebcc5a