{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"MBSBroadcastConfiguration message","paragraph_zero_based":9456},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":9457},{"literal_text_all_w_t_and_m_t":"-- TAG-MBSBROADCASTCONFIGURATION-START","paragraph_zero_based":9458},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9459},{"literal_text_all_w_t_and_m_t":"MBSBroadcastConfiguration-r17 ::= SEQUENCE {","paragraph_zero_based":9460},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                CHOICE {","paragraph_zero_based":9461},{"literal_text_all_w_t_and_m_t":"        mbsBroadcastConfiguration-r17     MBSBroadcastConfiguration-r17-IEs,","paragraph_zero_based":9462},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture          SEQUENCE {}","paragraph_zero_based":9463},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":9464},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":9465},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9466},{"literal_text_all_w_t_and_m_t":"MBSBroadcastConfiguration-r17-IEs ::= SEQUENCE {","paragraph_zero_based":9467},{"literal_text_all_w_t_and_m_t":"    mbs-SessionInfoList-r17               MBS-SessionInfoList-r17                                              OPTIONAL,   -- Need R","paragraph_zero_based":9468},{"literal_text_all_w_t_and_m_t":"    mbs-NeighbourCellList-r17             MBS-NeighbourCellList-r17                                            OPTIONAL,   -- Need S","paragraph_zero_based":9469},{"literal_text_all_w_t_and_m_t":"    drx-ConfigPTM-List-r17                SEQUENCE (SIZE (1..maxNrofDRX-ConfigPTM-r17)) OF DRX-ConfigPTM-r17   OPTIONAL,   -- Need R","paragraph_zero_based":9470},{"literal_text_all_w_t_and_m_t":"    pdsch-ConfigMTCH-r17                  PDSCH-ConfigBroadcast-r17                                            OPTIONAL,   -- Need S","paragraph_zero_based":9471},{"literal_text_all_w_t_and_m_t":"    mtch-SSB-MappingWindowList-r17        MTCH-SSB-MappingWindowList-r17                                       OPTIONAL,   -- Need R","paragraph_zero_based":9472},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension              OCTET STRING                                                         OPTIONAL,","paragraph_zero_based":9473},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                  SEQUENCE {}                                                          OPTIONAL","paragraph_zero_based":9474},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":9475},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9476},{"literal_text_all_w_t_and_m_t":"-- TAG-MBSBROADCASTCONFIGURATION-STOP","paragraph_zero_based":9477},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":9478},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["e79583d445c36202ac713b27e714be599aa1fa8b9334acdfddde0b869aaa4168","d8c0749e5bacd2a71c7be9ea5f34405c825f2960b6b62f9882051c0742e2ba9c","7a52f898ce86df472d2fc2c2cfb3873f719c3fd73806facc7b6664c25ec9c46b","0e24128adab6382980bc874ed47fc67ec4b5454a96e27abaa9a140a8ca9d0fdc","826ced49b745672998da05f8d7681c1be2efd48bab088a5a7b6f03538b336404","b7af6ac7b667a4e0e0c305a9835edf36d4e9c46e83a6e122e74d2d4d9cdd7bb0","b2f524b7597a66fe59dfb01f216dda805bd9a4c91ea8e84a6081e3e47d78a0ce","f08751588175da6b0d732790f8d90811842a37ff31de883cc9df07e7edd983f4","8109574841905ebd5d5ec5b515554ab65b8a3a25bdd17fa6cf115cbe6514c896","373521413b97aadfc213dfdd67311e30b910af60e5