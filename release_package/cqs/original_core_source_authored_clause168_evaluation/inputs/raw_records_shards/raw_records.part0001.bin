{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14664},{"literal_text_all_w_t_and_m_t":"AvailabilityIndicator field descriptions","paragraph_zero_based":14665},{"literal_text_all_w_t_and_m_t":"ai-RNTI","paragraph_zero_based":14666},{"literal_text_all_w_t_and_m_t":"Used by an IAB-MT for detection of DCI format 2_5 indicating AvailabilityCombinationId for an IAB-DU's cells.","paragraph_zero_based":14667},{"literal_text_all_w_t_and_m_t":"availableCombToAddModList","paragraph_zero_based":14668},{"literal_text_all_w_t_and_m_t":"A list of availabilityCombinations to add for the IAB-DU's cells. (see TS 38.213 [13], clause 14).","paragraph_zero_based":14669},{"literal_text_all_w_t_and_m_t":"availableCombToReleaseList","paragraph_zero_based":14670},{"literal_text_all_w_t_and_m_t":"A list of availabilityCombinations to release for the IAB-DU's cells. (see TS 38.213 [13], clause 14).","paragraph_zero_based":14671},{"literal_text_all_w_t_and_m_t":"dci-PayloadSizeAI","paragraph_zero_based":14672},{"literal_text_all_w_t_and_m_t":"Total length of the DCI payload scrambled with ai-RNTI (see TS 38.213 [13]).","paragraph_zero_based":14673},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14674},{"literal_text_all_w_t_and_m_t":"–BAP-RoutingID","paragraph_zero_based":14675},{"literal_text_all_w_t_and_m_t":"The IE BAP-RoutingID is used for IAB-node to configure the BAP Routing ID.","paragraph_zero_based":14676},{"literal_text_all_w_t_and_m_t":"BAP-RoutingID information element","paragraph_zero_based":14677},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":14678},{"literal_text_all_w_t_and_m_t":"-- TAG-BAPROUTINGID-START","paragraph_zero_based":14679},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14680},{"literal_text_all_w_t_and_m_t":"BAP-RoutingID-r16::=        SEQUENCE{","paragraph_zero_based":14681},{"literal_text_all_w_t_and_m_t":"    bap-Address-r16              BIT STRING (SIZE (10)),","paragraph_zero_based":14682},{"literal_text_all_w_t_and_m_t":"    bap-PathId-r16               BIT STRING (SIZE (10))","paragraph_zero_based":14683},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14684},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14685},{"literal_text_all_w_t_and_m_t":"-- TAG-BAPROUTINGID-STOP","paragraph_zero_based":14686},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":14687}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["b7735c11ce1e05713cf32521f520b4cd430c0ba07d91d744ba65bc60f9f7527a","7e06d7963fbb20ff0a360230c7ce56a626eeb850344c519cc978b2b3feb4f19d","f4ba7918142951e621f5d7f7492c72d0c13c61e9a4e2ee8ff1c0804fe8302c86","3cc582d48d3b2f4f3ecfdd8dedb4355b59bf56af9508019afc59a8a9c3086aba","42948b20a7323d377b561db74223a0d59319017d24a94be18dce25315316ba93","db8d1e48607cf38d09ed86687494fcf37d372a920e8cf80f39afc9f3476bf9e6","0b25ad761ec000510bf6bc95dddab0d191393a192799204eaafe1a90d05a9a9c","16439de06681576645f050354b11154e15139b2524be21e9e2e87960d8eecf2c","4806a32112f1941597dcac21100e315f9672a4a28f4e228812d6850311950b4e","a694e303b6acc2684256a3c32ae0b9643d77834cb81bf17aead51c5baa3257d2","23b5d47e93c2ac577267ff450f81ebfbcfa3fea811065b02ad57a43486f17f19","bd1a6674d5fdbc05a6e9193f51ed5ef3f9390572dce0956c33d5ed3d499045a9","3e5cc1dbbae50c669d28f163e88ee75ad0400b5b0e4b9e74cd0667002faeeaaa","05c7e488d07481ba08fd163ad1c5b3c0f297561ea90ddca436c325a6c890f0bb","ffa6cb58d7b5bfb5d228d2313f7bc97f796d459cca4b262eb9ab6a1b6f79af60","e8ddc3dd122fd69ba9149b8fccad30023e5106b1066bf9ee8b8be527a72af055","55cd694f2e47e2fb13483c96b49d7a6bba1721a6ba9419ab6b2fec8d426bd015","5aa8496c674ad8c9c4e1264bd360dae78340a503c4269db62310ec7bacfb1bcd","dfdb4cb1a0b7795d2903a82e1300d5cdf42bbae4d731acfbb6f42192ff48c719","1e9199859cf12ac97a995551fa09d2ccb970638072d1bb2f7f073dd57631db8a","cd1dc6d3e802a9180bffe5b8fa3d2f04b6163bd195a323dd45888d0df57025b7","0d6e65192a4c792b8f0baef65901d62a64237573c1b24af10a89316b345c2956","b9a1ce59e90589e26264fbb74db8610246ff881d04e41bb01f2493fe145c72b1","831a5053577d01f8b3ca04346f166cdb46a8892e298086904b941806f4d38c1a"],"paragraph_range_zero_based":[14664,14687],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p14664"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14688},{"literal_text_all_w_t_and_m_t":"BAP-RoutingID field descriptions","paragraph_zero_based":14689},{"literal_text_all_w_t_and_m_t":"bap-Address","paragraph_zero_based":14690},{"literal_text_all_w_t_and_m_t":"The ID of a destination IAB-node or IAB-donor-DU used in the BAP header.","paragraph_zero_based":14691},{"literal_text_all_w_t_and_m_t":"bap-PathId","paragraph_zero_based":14692},{"literal_text_all_w_t_and_m_t":"The ID of a path used in the BAP header.","paragraph_zero_based":14693},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14694},{"literal_text_all_w_t_and_m_t":"–BeamFailureRecoveryConfig","paragraph_zero_based":14695},{"literal_text_all_w_t_and_m_t":"The IE BeamFailureRecoveryConfig is used to configure the UE with RACH resources and candidate beams for beam failure recovery in case of beam failure detection. See also TS 38.321 [3], clause 5.1.1.","paragraph_zero_based":14696},{"literal_text_all_w_t_and_m_t":"BeamFailureRecoveryConfig information element","paragraph_zero_based":14697},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":14698},{"literal_text_all_w_t_and_m_t":"-- TAG-BEAMFAILURERECOVERYCONFIG-START","paragraph_zero_based":14699},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14700},{"literal_text_all_w_t_and_m_t":"BeamFailureRecoveryConfig ::=       SEQUENCE {","paragraph_zero_based":14701},{"literal_text_all_w_t_and_m_t":"    rootSequenceIndex-BFR               INTEGER (0..137)                                                          OPTIONAL, -- Need M","paragraph_zero_based":14702},{"literal_text_all_w_t_and_m_t":"    rach-ConfigBFR                      RACH-ConfigGeneric                                                        OPTIONAL, -- Need M","paragraph_zero_based":14703},{"literal_text_all_w_t_and_m_t":"    rsrp-ThresholdSSB                   RSRP-Range                                                                OPTIONAL, -- Need M","paragraph_zero_based":14704},{"literal_text_all_w_t_and_m_t":"    candidateBeamRSList                 SEQUENCE (SIZE(1..maxNrofCandidateBeams)) OF PRACH-ResourceDedicatedBFR   OPTIONAL, -- Need M","paragraph_zero_based":14705},{"literal_text_all_w_t_and_m_t":"    ssb-perRACH-Occasion                ENUMERATED {oneEighth, oneFourth, oneHalf, one, two,","paragraph_zero_based":14706},{"literal_text_all_w_t_and_m_t":"                                                       four, eight, sixteen}                                      OPTIONAL, -- Need M","paragraph_zero_based":14707},{"literal_text_all_w_t_and_m_t":"    ra-ssb-OccasionMaskIndex            INTEGER (0..15)                                                           OPTIONAL, -- Need M","paragraph_zero_based":14708},{"literal_text_all_w_t_and_m_t":"    recoverySearchSpaceId               SearchSpaceId                                                             OPTIONAL, -- Need R","paragraph_zero_based":14709},{"literal_text_all_w_t_and_m_t":"    ra-Prioritization                   RA-Prioritization                                                         OPTIONAL, -- Need R","paragraph_zero_based":14710},{"literal_text_all_w_t_and_m_t":"    beamFailureRecoveryTimer            ENUMERATED {ms10, ms20, ms40, ms60, ms80, ms100, ms150, ms200}            OPTIONAL, -- Need M","paragraph_zero_based":14711}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["39d01b613a58254ffb119c438a6e2870e1011753194b598d6199667358bd798c","7371f9cc9468985860d3c6b848c088e05c7854