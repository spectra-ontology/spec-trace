{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    sameAsSib1ConfiguredLocationAndBW          NULL,","paragraph_zero_based":39816},{"literal_text_all_w_t_and_m_t":"    locationAndBandwidth                       INTEGER (0..37949)","paragraph_zero_based":39817},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39818},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39819},{"literal_text_all_w_t_and_m_t":"-- TAG-CFR-CONFIGMCCH-MTCH-STOP","paragraph_zero_based":39820},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39821},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39822},{"literal_text_all_w_t_and_m_t":"CFR-ConfigMCCH-MTCH field descriptions","paragraph_zero_based":39823},{"literal_text_all_w_t_and_m_t":"commonControlResourceSetExt","paragraph_zero_based":39824},{"literal_text_all_w_t_and_m_t":"An additional common control resource set which may be configured and used for searchSpaceMCCH/searchSpaceMTCH or UE-specific search space in the BWP where searchSpaceMCCH is configured. It is contained in the bandwidth of the CFR for broadcast and larger than CORESET#0.","paragraph_zero_based":39825},{"literal_text_all_w_t_and_m_t":"locationAndBandwidthBroadcast","paragraph_zero_based":39826},{"literal_text_all_w_t_and_m_t":"Indicates starting PRB and the number of PRBs of CFR used for MCCH and MTCH reception.","paragraph_zero_based":39827},{"literal_text_all_w_t_and_m_t":"Value sameAsSib1ConfiguredLocationAndBW means the CFR for broadcast has the same location and size as the locationAndBandwidth for initial BWP configured in SIB1.","paragraph_zero_based":39828},{"literal_text_all_w_t_and_m_t":"Value locationAndBandwidth is used to configure CFR with bandwidth that is larger than and fully contains the bandwidth for the initial DL BWP configured in SIB1 and CORESET#0. The value of the field shall be interpreted as defined in TS 38.214 [19] with assumptions as described in TS 38.213 [13].","paragraph_zero_based":39829},{"literal_text_all_w_t_and_m_t":"If the field is absent, the CFR for broadcast has the same location and size as CORESET#0.","paragraph_zero_based":39830},{"literal_text_all_w_t_and_m_t":"pdsch-ConfigMCCH","paragraph_zero_based":39831},{"literal_text_all_w_t_and_m_t":"Indicates PDSCH parameters used for MCCH transmission. If the field is absent, PDSCH parameters used for MCCH are the same as those of PDSCH configuration provided in initialDownlinkBWP in SIB1.","paragraph_zero_based":39832},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39833},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":39834},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":39835},{"literal_text_all_w_t_and_m_t":"NotSIB1CommonControlResource","paragraph_zero_based":39836},{"literal_text_all_w_t_and_m_t":"The field is optional present in case commonControlResourceSet is not configured in SIB1, Need R, otherwise it is absent.","paragraph_zero_based":39837},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39838},{"literal_text_all_w_t_and_m_t":"–DRX-ConfigPTM","paragraph_zero_based":39839}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["ff41b7e4f7178d9d0e2417f2ae99dd118842bfe029dd062965349034fac30a8f","3f8e4b9ff80e3fa7e3a7aba340debf06aad1b5513be9a874bafa6b37e14a30e4","83b8d271620be27adf0c5e0c2765d5b3ff01a9a761439457a0aa28013bac3b5d","a96d0dd9ceb321bb83d0b709f309025c10335a7f2c780297bf1dd108ed44bcb6","aba5d3663a6f084d7a742c28e713712ea15eed945cedfaa06ad294aa6bcb8972","0da2baba21b2fbbb5b8d78790