{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–SL-QoS-Profile","paragraph_zero_based":38760},{"literal_text_all_w_t_and_m_t":"The IE SL-QoS-Profile is used to give the QoS parameters for a sidelink QoS flow. Need codes or conditions specified for SL-QoS-Profile do not apply, in case SL-QoS-Profile is included in SidelinkUEInformationNR.","paragraph_zero_based":38761},{"literal_text_all_w_t_and_m_t":"SL-QoS-Profile information element","paragraph_zero_based":38762},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":38763},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-QOS-PROFILE-START","paragraph_zero_based":38764},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38765},{"literal_text_all_w_t_and_m_t":"SL-QoS-Profile-r16 ::=        SEQUENCE {","paragraph_zero_based":38766},{"literal_text_all_w_t_and_m_t":"    sl-PQI-r16                    SL-PQI-r16                                                  OPTIONAL,   -- Need R","paragraph_zero_based":38767},{"literal_text_all_w_t_and_m_t":"    sl-GFBR-r16                   INTEGER (0..4000000000)                                     OPTIONAL,   -- Need R","paragraph_zero_based":38768},{"literal_text_all_w_t_and_m_t":"    sl-MFBR-r16                   INTEGER (0..4000000000)                                     OPTIONAL,   -- Need R","paragraph_zero_based":38769},{"literal_text_all_w_t_and_m_t":"    sl-Range-r16                  INTEGER (1..1000)                                           OPTIONAL,   -- Need R","paragraph_zero_based":38770},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":38771},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":38772},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38773},{"literal_text_all_w_t_and_m_t":"SL-PQI-r16 ::=                CHOICE {","paragraph_zero_based":38774},{"literal_text_all_w_t_and_m_t":"    sl-StandardizedPQI-r16        INTEGER (0..255),","paragraph_zero_based":38775},{"literal_text_all_w_t_and_m_t":"    sl-Non-StandardizedPQI-r16    SEQUENCE {","paragraph_zero_based":38776},{"literal_text_all_w_t_and_m_t":"        sl-ResourceType-r16           ENUMERATED {gbr, non-GBR, delayCriticalGBR, spare1}     OPTIONAL,   -- Need R","paragraph_zero_based":38777},{"literal_text_all_w_t_and_m_t":"        sl-PriorityLevel-r16          INTEGER (1..8)                                          OPTIONAL,   -- Need R","paragraph_zero_based":38778},{"literal_text_all_w_t_and_m_t":"        sl-PacketDelayBudget-r16      INTEGER (0..1023)                                       OPTIONAL,   -- Need R","paragraph_zero_based":38779},{"literal_text_all_w_t_and_m_t":"        sl-PacketErrorRate-r16        INTEGER (0..9)                                          OPTIONAL,   -- Need R","paragraph_zero_based":38780},{"literal_text_all_w_t_and_m_t":"        sl-AveragingWindow-r16        INTEGER (0..4095)                                       OPTIONAL,   -- Need R","paragraph_zero_based":38781},{"literal_text_all_w_t_and_m_t":"        sl-MaxDataBurstVolume-r16     INTEGER (0..4095)                                       OPTIONAL,   -- Need R","paragraph_zero_based":38782},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":38783}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["fad21515636a162e5dfd2d9021a456cd594e26301e750a2b5bea308a54003c20","bf2cf248a92f9eecbdea7ab2d899a0a74bd15b9c4ce0d07b3fdc3c69d8e41387","3151389d41b7b011413894eacad93166726df1bce1c5860bc473a5d25d965587","7d2eed0fde400f7e6cca1b39c60098f45d29ab06d2e603b31805a15fd3501b26","a86fbd5a00cf8fb2362