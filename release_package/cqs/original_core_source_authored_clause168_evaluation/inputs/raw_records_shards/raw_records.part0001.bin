{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    powerRampingStep                    ENUMERATED {dB0, dB2, dB4, dB6},","paragraph_zero_based":25152},{"literal_text_all_w_t_and_m_t":"    ra-ResponseWindow                   ENUMERATED {sl1, sl2, sl4, sl8, sl10, sl20, sl40, sl80},","paragraph_zero_based":25153},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":25154},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":25155},{"literal_text_all_w_t_and_m_t":"    prach-ConfigurationPeriodScaling-IAB-r16    ENUMERATED {scf1,scf2,scf4,scf8,scf16,scf32,scf64}              OPTIONAL,   -- Need R","paragraph_zero_based":25156},{"literal_text_all_w_t_and_m_t":"    prach-ConfigurationFrameOffset-IAB-r16      INTEGER (0..63)                                                 OPTIONAL,   -- Need R","paragraph_zero_based":25157},{"literal_text_all_w_t_and_m_t":"    prach-ConfigurationSOffset-IAB-r16          INTEGER (0..39)                                                 OPTIONAL,   -- Need R","paragraph_zero_based":25158},{"literal_text_all_w_t_and_m_t":"    ra-ResponseWindow-v1610                     ENUMERATED { sl60, sl160}                                       OPTIONAL,   -- Need R","paragraph_zero_based":25159},{"literal_text_all_w_t_and_m_t":"    prach-ConfigurationIndex-v1610              INTEGER (256..262)                                              OPTIONAL    -- Need R","paragraph_zero_based":25160},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":25161},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":25162},{"literal_text_all_w_t_and_m_t":"    ra-ResponseWindow-v1700                     ENUMERATED {sl240, sl320, sl640, sl960, sl1280, sl1920, sl2560} OPTIONAL    -- Need R","paragraph_zero_based":25163},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":25164},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25165},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25166},{"literal_text_all_w_t_and_m_t":"-- TAG-RACH-CONFIGGENERIC-STOP","paragraph_zero_based":25167},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":25168},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25169},{"literal_text_all_w_t_and_m_t":"RACH-ConfigGeneric field descriptions","paragraph_zero_based":25170},{"literal_text_all_w_t_and_m_t":"msg1-FDM","paragraph_zero_based":25171},{"literal_text_all_w_t_and_m_t":"The number of PRACH transmission occasions FDMed in one time instance. (see TS 38.211 [16], clause 6.3.3.2).","paragraph_zero_based":25172},{"literal_text_all_w_t_and_m_t":"msg1-FrequencyStart","paragraph_zero_based":25173},{"literal_text_all_w_t_and_m_t":"Offset of lowest PRACH transmission occasion in frequency domain with respective to PRB 0. The value is configured so that the corresponding RACH resource is entirely within the bandwidth of the UL BWP. (see TS 38.211 [16], clause 6.3.3.2).","paragraph_zero_based":25174},{"literal_text_all_w_t_and_m_t":"powerRampingStep","paragraph_zero_based":25175}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["3012c782527e8ca2c2e0071877c706634a02ebf4399d3faa05e43a6c1ae92331","78cb3649f4df3d9d51a9611a865ed9ded278a0d45266e9d5d4163281e34d2be6","d7212afb38bdaaa639fdaacf8f23ffaa58349b4c6ba4129f578ea7a028cac8d0","76601dd6bca02c9006bf3d8b10000b291f3745bb7d625ac6768c0ca89bdcedf2","69d807ae2ec4860093de07fb4cda7cd384b08e7ecd230b4f0d0eeda0d36362a7","e3d4c5466df35b6b88d50271ab4a91ed8c095ee4dc94fc13b9f4b47f21f9f84a","4c116d46bbd62ab8b4cb8f3288e1e921ddfb35fe9c6cc50770faaadb94823840","1a7559c63c1551e95afe4512bf4571dfd8a8019dc27d1f2224caa068dd56e89c","16cd525766abbc7c71afb6bcfdaaffa0368d96aa76a02570d1dcc4d3db589d86","b766bc40686adfd51c69d6d4b3c99d4843f365ca4615e27e08e68ff213266961","a582d850729041f9d1a4aaeb042e3071dcc57373d19edaa2010297bdabdb7583","f9c5c1be2caf5035505fb7cfdd55335a70b7c610b1886e04d93924f665c8a151","5c1708497132c857e8c18958f658f8937cda76a1fa096ea4ae10f1b2685030ea","66d30a70c356c068f6c5d4820f51500af8c81f8ffd88f70d3404f2d4dd1340b0","ab0b43f157b980a232f2b914e350bf1676fb9608b1188ca7598a45a62bca5970","64265cbd76385bd58a5418e6d76e99e235efc21d0e7c3e6a4754b9a0e681ec51","7f74da05efb4a42b037866dbce9469bf118c0781ac42c350263c8d800324d97f","5e31e03f599ebfd2e70f15d37e0122f8ffeb51b23771315293199e9dbe95c833","ac4ce25a259728192efb9d2ffaa951237ee6c49b68eb8aed0171e8e8c2a4d888","561fbd342db15358fbdd4e0c397e82159a2898365d0367b51bb961f8ad4af92b","e3add2703d8d3f2e6b55257c1541491de3bf06f2c8d768aa58c1567a639fb030","3f1a9ad4a8555a9a2992e9f2a0c5b978e5510f1fe39e5596163539a5bb432791","733426aec377c676b72433748857db7639a37ba969a0a5eae731afa61acb4787","93fa57052f5d8a181db24907c7f1acad5fe387854ca15c5cc471c96569693653"],"paragraph_range_zero_based":[25152,25175],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p25152"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Power ramping steps for PRACH (see TS 38.321 [3],5.1.3).","paragraph_zero_based":25176},{"literal_text_all_w_t_and_m_t":"prach-ConfigurationFrameOffset-IAB","paragraph_zero_based":25177},{"literal_text_all_w_t_and_m_t":"Frame offset for ROs defined in the baseline configuration indicated by prach-ConfigurationIndex and is used only by the IAB-MT. (see TS 38.211 [16], clause 6.3.3.2).","paragraph_zero_based":25178},{"literal_text_all_w_t_and_m_t":"prach-ConfigurationIndex","paragraph_zero_based":25179},{"literal_text_all_w_t_and_m_t":"PRACH configuration index. For prach-ConfigurationIndex configured under beamFailureRecoveryConfig, the prach-ConfigurationIndex can only correspond to the short preamble format, (see TS 38.211 [16], clause 6.3.3.2). If the field prach-ConfigurationIndex-v1610 is present, the UE shall ignore the value provided in prach-ConfigurationIndex (without suffix).","paragraph_zero_based":25180},{"literal_text_all_w_t_and_m_t":"prach-ConfigurationPeriodScaling-IAB","paragraph_zero_based":25181},{"literal_text_all_w_t_and_m_t":"Scaling factor to extend the periodicity of the baseline configuration indicated by prach-ConfigurationIndex and is used only by the IAB-MT. Value scf1 corresponds to scaling factor of 1 and so on. (see TS 38.211 [16], clause 6.3.3.2).","paragraph_zero_based":25182},{"literal_text_all_w_t_and_m_t":"prach-ConfigurationSOffset-IAB","paragraph_zero_based":25183},{"literal_text_all_w_t_and_m_t":"Subframe/Slot offset for ROs defined in the baseline configuration indicated by prach-ConfigurationIndex and is used only by the IAB-MT. (see TS 38.211 [16], clause 6.3.3.2).","paragraph_zero_based":25184},{"literal_text_all_w_t_and_m_t":"preambleReceivedTargetPower","paragraph_zero_based":25185},{"literal_text_all_w_t_and_m_t":"The target power level at the network receiver side (see TS 38.213 [13], clause 7.4, TS 38.321 [3], clauses 5.1.2, 5.1.3). Only multiples of 2 dBm may be chosen (e.g. -202, -200, -198, ...). ","paragraph_zero_based":25186},{"literal_text_all_w_t_and_m_t":"preambleTransMax","paragraph_zero_based":25187},{"literal_text_all_w_t_and_m_t":"Max number of RA preamble transmission performed before declaring a failure (see TS 38.321 [3], clauses 5.1.4, 5.1.5).","paragraph_zero_based":25188},{"literal_text_all_w_t_and_m_t":"ra-ResponseWindow","paragraph_zero_based":25189},{"literal_text_all_w_t_and_m_t":"Msg2 (RAR) window length in number of slots. The network configures a value lower than or equal to 10 ms when Msg2 is transmitted in licensed spectrum and a value lower than or equal to 40 ms when Msg2 is transmitted with shared spectrum channel access (see TS 38.321 [3], clause 5.1.4). UE ignores the field if included in SCellConfig. If ra-ResponseWindow-v1610 or ra-ResponseWindow-v1700 is signalled, UE shall ignore the ra-ResponseWindow (without suffix). The field ra-ResponseWindow-v1700 is applicable to SCS 480 kHz and SCS 960 kHz.","paragraph_zero_based":25190},{"literal_text_all_w_t_and_m_t":"zeroCorrelationZoneConfig","paragraph_zero_based":25191},{"literal_text_all_w_t_and_m_t":"N-CS configuration, see Table 6.3.3.1-5 in TS 38.211 [16].","paragraph_zero_based":25192},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25193},{"literal_text_all_w_t_and_m_t":"–RACH-ConfigGenericTwoStepRA","paragraph_zero_based":25194},{"literal_text_all_w_t_and_m_t":"The IE RACH-ConfigGenericTwoStepRA is used to specify the 2-step random access type parameters.","paragraph_zero_based":25195},{"literal_text_all_w_t_and_m_t":"RACH-ConfigGenericTwoStepRA information element","paragraph_zero_based":25196},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25197},{"literal_text_all_w_t_and_m_t":"-- TAG-RACH-CONFIGGENERICTWOSTEPRA-START","paragraph_zero_based":25198},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25199}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["1b0ad6d41a13bb4e10646d2b056a79e326821598196074a53ec0dc1292b2ed5f","a9cf451fe6440797773663a510e95a38138f484b3d042d3b6c9d2d5f70168ebc","e830344a08063b400eaa80956cd13d65adbb9df6233f5a32e5908c705b33a767","7574f7e91229efee28efd9a77dabec169fe81f9b0250ee02a46d377df4f730ea","bbb474dc436ec5f627e1c3f739df90a877ed1f91360431f62111c6298e398394","b726da421aec82b7d5542cb700a75408942f5406779afa514e89412556bfe1ad","5054afdaf88c355f7f39ce8fbf6f21a389f7cb403b0224aafc565a4590caad1d","837b1f6280d2105fccee5006e1f54670ccd1d25cbee8af231299306b52ed102e","739cb10c267f92d6a27b00e80411028cca0b94e145020326ee0ec92b0d0516e2","a3a04449dc1a35ba39fb758ab52a900cadca6e464edd35686f368a42df97591d","5b8493ea200ab2c49f6a624e0169b69098338bdc3cdb2e55c9eff851cfc12acd","101b9ec2ab0a10532d939432033d3c48d71d25d89d5821dd5feb055ba43f1636","345098efc9cfae5f8df89fba23fb68e31db8f2ea57109327526b5830fba961dc","c53ac0da5103c906fd35b1173284e9ee074c42339c8935cda012e8c1d2ff924e","10529d5f8f651783ac7f211be5f3e3d3adcde4e1d5a39f06125b3e4f2bd23b35","40287b6e9e6117d368ae9e644b779f3e186ed67bf56dd3425951816d5e15ebb9","ea5d4a7a498348f87d19115216bd180e62a231884019a7edc2d4322b5edde881","f2252f1da8486f53027ca8c74c6b97b0345f639db1361ca1098544a16e313d6c","f4a0e98d2bf050bb5eac4b6e42259ee1919aec5a264f4be137e038b6425d537e","a67c61d251a59f80cac7fe0b2f52fc1595aa5daabbb1800f2d1a6c24aebd6ec0","cab0a8400cb9a216b7a84ac8d8fec7d6b4003162e4c01f1e2dd3ea7e52d02ae5","db2371ef04f00521f8feaa535b10b0706af3463cee01a49f47a6730dfeeff2b7","eb723abd1b8d1659c929dba5d379546fad5aebb6a7dcd9a6f29e9b275821f2da","e4ac05871e5e18a5b27dd7df201cd23260c7c5a980c70971d44367cd2dfe6386"],"paragraph_range_zero_based":[25176,25199],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p25176"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"RACH-ConfigGenericTwoStepRA-r16 ::=     SEQUENCE {","paragraph_zero_based":25200},{"literal_text_all_w_t_and_m_t":"    msgA-PRACH-ConfigurationIndex-r16       INTEGER (0..262)                                                OPTIONAL, -- Cond 2StepOnly","paragraph_zero_based":25201},{"literal_text_all_w_t_and_m_t":"    msgA-RO-FDM-r16                         ENUMERATED {one, two, four, eight}                              OPTIONAL, -- Cond 2StepOnly","paragraph_zero_based":25202},{"literal_text_all_w_t_and_m_t":"    msgA-RO-FrequencyStart-r16              INTEGER (0..maxNrofPhysicalResourceBlocks-1)                    OPTIONAL, -- Cond 2StepOnly","paragraph_zero_based":25203},{"literal_text_all_w_t_and_m_t":"    msgA-ZeroCorrelationZoneConfig-r16      INTEGER (0..15)                                                 OPTIONAL, -- Cond 2StepOnly","paragraph_zero_based":25204},{"literal_text_all_w_t_and_m_t":"    msgA-PreamblePowerRampingStep-r16       ENUMERATED {dB0, dB2, dB4, dB6}                                 OPTIONAL, -- Cond 2StepOnlyNoCFRA","paragraph_zero_based":25205},{"literal_text_all_w_t_and_m_t":"    msgA-PreambleReceivedTargetPower-r16    INTEGER (-202..-60)                                             OPTIONAL, -- Cond 2StepOnlyNoCFRA","paragraph_zero_based":25206},{"literal_text_all_w_t_and_m_t":"    msgB-ResponseWindow-r16                 ENUMERATED {sl1, sl2, sl4, sl8, sl10, sl20, sl40, sl80, sl160, sl320}","paragraph_zero_based":25207},{"literal_text_all_w_t_and_m_t":"                                                                                                            OPTIONAL, -- Cond NoCFRA","paragraph_zero_based":25208},{"literal_text_all_w_t_and_m_t":"    preambleTransMax-r16                    ENUMERATED {n3, n4, n5, n6, n7, n8, n10, n20, n50, n100, n200}  OPTIONAL, -- Cond 2StepOnlyNoCFRA","paragraph_zero_based":25209},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":25210},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":25211},{"literal_text_all_w_t_and_m_t":"    msgB-ResponseWindow-v1700               ENUMERATED {sl240, sl640, sl960, sl1280, sl1920, sl2560}        OPTIONAL  -- Cond NoCFRA2","paragraph_zero_based":25212},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":25213},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25214},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25215},{"literal_text_all_w_t_and_m_t":"-- TAG-RACH-CONFIGGENERICTWOSTEPRA-STOP","paragraph_zero_based":25216},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":25217},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25218},{"literal_text_all_w_t_and_m_t":"RACH-ConfigGenericTwoStepRA field descriptions","paragraph_zero_based":25219},{"literal_text_all_w_t_and_m_t":"msgA-PreamblePowerRampingStep","paragraph_zero_based":25220},{"literal_text_all_w_t_and_m_t":"Power ramping steps for msgA PRACH. If the field is absent in RACH-ConfigCommonTwoStepRA in AdditionalRACH-Config, the UE shall apply the corresponding value in RACH-ConfigCommon in the same AdditionalRACH-Config. If the field is absent in other cases, UE shall use the value of powerRampingStep in RACH-ConfigGeneric in the configured BWP (see TS 38.321 [3], 5.1.3). This field may only be present if no 4-step type RA is configured in the BWP or in the case of separate ROs with 4-step type RA. The field is absent if RACH-ConfigGenericTwoStepRA is included in CFRA-TwoStep in RACH-ConfigDedicated and then the UE uses the value of msgA-PreamblePowerRampingStep in RACH-ConfigGenericTwoStepRA configured for CBRA.","paragraph_zero_based":25221},{"literal_text_all_w_t_and_m_t":"msgA-PreambleReceivedTargetPower","paragraph_zero_based":25222},{"literal_text_all_w_t_and_m_t":"The target power level at the network receiver side (see TS 38.213 [13], clause 7.1.1 and TS 38.321 [3], clause 5.1.1). Only multiples of 2 dBm may be chosen (e.g -202, -200, -198, …). If the field is absent, UE shall use the value of preambleReceivedTargetPower in RACH-ConfigGeneric in the configured BWP. This field may only be present if no 4-step type RA is configured in the BWP. The field is absent if RACH-ConfigGenericTwoStepRA is included in CFRA-TwoStep in RACH-ConfigDedicated and then the UE uses the value of msgA-PreambleReceivedTargetPower in RACH-ConfigGenericTwoStepRA configured for CBRA.","paragraph_zero_based":25223}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["10b588f2978a8acc006f929b100870b486c4a389e5f51d8bf353661e63fdd65e","dc896ab512f700e6e8f03606b0250d99ce0349d9b8b8ec450bf8b540861086fd","193c1afd5f99f7179df721de82d45731d7957aad374ccbc595cd13360a466243","b49807f876de46a58b14c7f1393b53501dd9d221867da0f151d7a686d3e167f2","7c46490081e1ef8e5cba4deec64b50d1eefed7ba6a1e88e27619441f6b1a0b4d","0af54ba40e1fa7b83348c1157722346aa6a6a90f416e23580088e4e2e1cd71c0","c86162d17e57d3025c8b40ab63e62a8a1ff11d418c1085c1f7b298e3923d6bd0","241e4f1ffb4b1a94e5caf6a3b07530f8f2f28affb9da6a4769301fdf663acaa9","5992f05695d09e227f5d779b7682fe91a6343434d228e1184f30c91e65917038","e4358632291fd28b28529967333cdd5b43dc44b24b4b92c68c42d0630d68a82a","9aace7a7cfda9034487c6346100a0adb2f97f31b35ef9cbf26afeb968654235a","85a016b243017231244f5a677d0c2b73e428e1dcf7870129d43a57d2ff968683","813d1516d79395b84578b77e6ca72ba12b3021d2e26b2e57a717191d0adaebf0","73d28ae53ec4008a6384a7bfd95fb826e2f92b8212fb3dde05dd0f86cf7514eb","3e8cdefd744b812210c0694585d2bc7ac768bab85de10a4f7c4b261b0743b95a","82e8ddadfead8aec8646d79b61fc4fc6b24fb0df75581731ee3a249bcb09938e","01c81e7563c7f7b03883686ab26cb9ba5656eba02b5e4d5d87606d34d4921d67","c6ec6f93bdddb47270bbd6743fb01dadec6c1b5a6613b6060d731faaa75e3ad7","2bf0a10757d54d9fe0283355e2458af35f816532535065c1646a60dbbc0b07c8","97a8bb340563b1cc2b79f8d3467c488067ead2a28d00487046d3a735aac6af80","768f15669e966919d911d3bdf9f4ea669777bad6cdf459991d5b4ee4b009982d","bf7b0bb9d12d3c6c5b6ae945d640385f4de6dcc7f59e254aff1f48c746c19ceb","c0d60ea18fadf6f58439e6a32a2b0316af34b3b26a1f2489d47d1cfc5e3b54d6","883e281dd198f9da40d69332a4f0c53fac0712d7da240887852da437da660b88"],"paragraph_range_zero_based":[25200,25223],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p25200"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"msgA-PRACH-ConfigurationIndex","paragraph_zero_based":25224},{"literal_text_all_w_t_and_m_t":"Cell-specific PRACH configuration index for 2-step RA type. If the field is absent in RACH-ConfigCommonTwoStepRA which is configured directly within a BWP (i.e. not within AdditionalRACH-Config), the UE shall use the value of corresponding 4-step random access parameter in the configured BWP. If the field is absent in RACH-ConfigCommonTwoStepRA in AdditionalRACH-Config, the UE shall apply the corresponding value in RACH-ConfigCommon in the same AdditionalRACH-Config. If the value is in the range of 256 to 262, the field prach-ConfigurationIndex-v1610 should be considered configured (see TS 38.211 [16], clause 6.3.3.2). This field may only be present if no 4-step type RA is configured in the BWP or in the case of separate ROs with 4-step type RA.","paragraph_zero_based":25225},{"literal_text_all_w_t_and_m_t":"msgA-RO-FDM","paragraph_zero_based":25226},{"literal_text_all_w_t_and_m_t":"The number of msgA PRACH transmission occasions Frequency-Division Multiplexed in one time instance. If the field is absent in RACH-ConfigCommonTwoStepRA which is configured directly within a BWP (i.e. not within AdditionalRACH-Config), UE shall use value of msg1-FDM in RACH-ConfigGeneric in the configured BWP. If the field is absent in RACH-ConfigCommonTwoStepRA in AdditionalRACH-Config, the UE shall apply the value of msg1-FDM in RACH-ConfigCommon in the same AdditionalRACH-Config (see TS 38.211 [16], clause 6.3.3.2). This field may only be present if no 4-step type RA is configured in the BWP or in the case of separate ROs with 4-step type RA.","paragraph_zero_based":25227},{"literal_text_all_w_t_and_m_t":"msgA-RO-FrequencyStart","paragraph_zero_based":25228},{"literal_text_all_w_t_and_m_t":"Offset of lowest PRACH transmissions occasion in frequency domain with respect to PRB 0. If the field is absent in RACH-ConfigCommonTwoStepRA which is configured directly within a BWP (i.e. not within AdditionalRACH-Config), UE shall use value of msg1-FrequencyStart in RACH-ConfigGeneric in the configured BWP. If the field is absent in RACH-ConfigCommonTwoStepRA in AdditionalRACH-Config, the UE shall apply the value of msg1-FrequencyStart in RACH-ConfigCommon in the same AdditionalRACH-Config (see TS 38.211 [16], clauses 5.3.2 and 6.3.3.2). This field may only be present if no 4-step type RA is configured in the BWP or in the case of separate ROs with 4-step type RA.","paragraph_zero_based":25229},{"literal_text_all_w_t_and_m_t":"msgA-ZeroCorrelationZoneConfig","paragraph_zero_based":25230},{"literal_text_all_w_t_and_m_t":"N-CS configuration for msgA preamble, see Table 6.3.3.1-5 in TS 38.211 [16]. If the field is absent in RACH-ConfigCommonTwoStepRA in AdditionalRACH-Config, the UE shall apply the corresponding value in RACH-ConfigCommon in the same AdditionalRACH-Config. If the field is absent in other cases, UE shall use value zeroCorrelationZoneConfig in RACH-ConfigGeneric in the configured BWP. This field may only be present if no 4-step type RA is configured in the BWP or in the case of separate ROs with 4-step type RA.","paragraph_zero_based":25231},{"literal_text_all_w_t_and_m_t":"msgB-ResponseWindow","paragraph_zero_based":25232},{"literal_text_all_w_t_and_m_t":"MsgB monitoring window length in number of slots. The network configures a value lower than or equal to 40ms (see TS 38.321 [3], clause 5.1.1). The network does not configure msgB-ResponseWindow-r16 simultaneously with msgB-ResponseWindow-v1700, and if both fields are absent, the UE uses the value of msgB-ResponseWindow in RACH-ConfigGenericTwoStepRA configured for CBRA.","paragraph_zero_based":25233},{"literal_text_all_w_t_and_m_t":"preambleTransMax","paragraph_zero_based":25234},{"literal_text_all_w_t_and_m_t":"Max number of RA preamble transmission performed before declaring a failure (see TS 38.321 [3], clauses 5.1.4, 5.1.5). If the field is absent in RACH-ConfigCommonTwoStepRA in AdditionalRACH-Config, the UE shall apply the corresponding value in RACH-ConfigCommon in the same AdditionalRACH-Config. If the field is absent in other cases, UE shall use the value of preambleTransMax in RACH-ConfigGeneric in the configured BWP. The field is absent if RACH-ConfigGenericTwoStepRA is included in CFRA-TwoStep in RACH-ConfigDedicated and then the UE uses the value of preambleTransMax in RACH-ConfigGenericTwoStepRA configured for CBRA.","paragraph_zero_based":25235},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25236},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":25237},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":25238},{"literal_text_all_w_t_and_m_t":"2StepOnly","paragraph_zero_based":25239},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in msgA-ConfigCommon field in BWP-UplinkCommon if rach-ConfigCommon field is absent in this BWP-UplinkCommon, otherwise the field is optionally present in msgA-ConfigCommon field in BWP-UplinkCommon, Need S.","paragraph_zero_based":25240},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in msgA-ConfigCommon in AdditionalRACH-Config if rach-ConfigCommon field is absent in this AdditionalRACH-Config, otherwise the field is optionally present in msgA-ConfigCommon field in AdditionalRACH-Config, Need S.","paragraph_zero_based":25241},{"literal_text_all_w_t_and_m_t":"2StepOnlyNoCFRA","paragraph_zero_based":25242},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if RACH-ConfigGenericTwoStepRA is included in the RACH-ConfigCommonTwoStepRA and there are no 4-step random access configurations configured in the BWP (i.e only 2-step random access type configured in the BWP), otherwise (i.e. 4-step random access configuration also exists in the BWP) the field is optionally present, Need S. When RACH-ConfigGenericTwoStepRA is included in the RACH-ConfigDedicated, this field is absent.","paragraph_zero_based":25243},{"literal_text_all_w_t_and_m_t":"NoCFRA","paragraph_zero_based":25244},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if msgB-ResponseWindow-r17 is absent and RACH-ConfigGenericTwoStepRA is not included in CFRA-TwoStep in RACH-ConfigDedicated, otherwise the field is absent, Need S.","paragraph_zero_based":25245},{"literal_text_all_w_t_and_m_t":"NoCFRA2","paragraph_zero_based":25246},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if msgB-ResponseWindow-r16 is absent and RACH-ConfigGenericTwoStepRA is not included in CFRA-TwoStep in RACH-ConfigDedicated, otherwise the field is absent, Need S.","paragraph_zero_based":25247}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["a8964767054655b85b4d61ee6c8d4b2cf1d36a12953699dbca576cfa1007f152","1b0d5b4c33ec56141375ca2c458205a0cbcbe3390f2c9445ff60d68f6232d7a6","f3cfc50e2b57d1d4acc08da3e40ff908255bbc1a8d055ee6d97e2cfb7083f37f","61809d3666622622a78eb80c105e13c42bd78f7b1261d1475b256342877be5db","075485a3e240f7e2c0967f55aef69d7606bb50de0bc00a26c11f4f9a2afc7f26","dad8de8de157e2abff5261ee440115e9c552830efdd52a8ae7f93106a0a4fcdd","c60a8039ebdb1ee2361e7fb49514778b5b51e755295baff2f03a16726ca1b1a3","574d1755e9f8b9ea682e44ccb6d389a4b1b27b94959b38c01e82893373d79ae4","faf41ce2b7132e61642dc61328b52edba8bc80b5a97bc47fdfa793b441ab099e","cec060b64f37a1373ac70e4307e3be3c7f50eb0a9dc0b25d7b28cfd51170ba20","919cdf5032387d871a2c5d2584f1203346d871eff38d2c17b618c565b7fa53d1","a875c3eb9dc783ac7b5b43f42124a1135af97531c8a6b301304fb6f37e24ba03",