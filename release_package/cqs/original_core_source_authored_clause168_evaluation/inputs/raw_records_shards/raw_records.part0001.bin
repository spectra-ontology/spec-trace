{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the E-UTRA carriers to be measured during RRC_IDLE or RRC_INACTIVE.","paragraph_zero_based":19704},{"literal_text_all_w_t_and_m_t":"measIdleCarrierListNR","paragraph_zero_based":19705},{"literal_text_all_w_t_and_m_t":"Indicates the NR carriers to be measured during RRC_IDLE or RRC_INACTIVE.","paragraph_zero_based":19706},{"literal_text_all_w_t_and_m_t":"measIdleDuration","paragraph_zero_based":19707},{"literal_text_all_w_t_and_m_t":"Indicates the duration for performing idle/inactive measurements while in RRC_IDLE or RRC_INACTIVE. Value sec10 correspond to 10 seconds, value sec30 to 30 seconds and so on.","paragraph_zero_based":19708},{"literal_text_all_w_t_and_m_t":"nrofSS-BlocksToAverage","paragraph_zero_based":19709},{"literal_text_all_w_t_and_m_t":"Number of SS blocks to average for cell measurement derivation.","paragraph_zero_based":19710},{"literal_text_all_w_t_and_m_t":"qualityThreshold","paragraph_zero_based":19711},{"literal_text_all_w_t_and_m_t":"Indicates the quality thresholds for reporting the measured cells for idle/inactive NR measurements.","paragraph_zero_based":19712},{"literal_text_all_w_t_and_m_t":"qualityThresholdEUTRA","paragraph_zero_based":19713},{"literal_text_all_w_t_and_m_t":"Indicates the quality thresholds for reporting the measured cells for idle/inactive E-UTRA measurements.","paragraph_zero_based":19714},{"literal_text_all_w_t_and_m_t":"reportQuantities","paragraph_zero_based":19715},{"literal_text_all_w_t_and_m_t":"Indicates which measurement quantities UE is requested to report in the idle/inactive measurement report. ","paragraph_zero_based":19716},{"literal_text_all_w_t_and_m_t":"reportQuantitiesEUTRA","paragraph_zero_based":19717},{"literal_text_all_w_t_and_m_t":"Indicates which E-UTRA measurement quantities the UE is requested to report in the idle/inactive measurement report.","paragraph_zero_based":19718},{"literal_text_all_w_t_and_m_t":"reportQuantityRS-Indexes","paragraph_zero_based":19719},{"literal_text_all_w_t_and_m_t":"Indicates which measurement information per beam index the UE shall include in the NR idle/inactive measurement results.","paragraph_zero_based":19720},{"literal_text_all_w_t_and_m_t":"smtc","paragraph_zero_based":19721},{"literal_text_all_w_t_and_m_t":"Indicates the measurement timing configuration for inter-frequency measurement. If this field is absent in VarMeasIdleConfig, the UE assumes that SSB periodicity is 5 ms in this frequency.","paragraph_zero_based":19722},{"literal_text_all_w_t_and_m_t":"ssbSubcarrierSpacing","paragraph_zero_based":19723},{"literal_text_all_w_t_and_m_t":"Indicates subcarrier spacing of SSB.","paragraph_zero_based":19724},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":19725},{"literal_text_all_w_t_and_m_t":"FR1:    15 or 30 kHz","paragraph_zero_based":19726},{"literal_text_all_w_t_and_m_t":"FR2-1:  120 or 240 kHz","paragraph_zero_based":19727}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["c5226c018c023d80fdc9556b90ee6a4655e0bf5269bbc27ab9a01aef4f7d8ce7","8e68e3850332890ae1eeabeaab50f70818d267278934d934d8f011581dba6c31","9d91727536bee62afe13d1918fd68fb81cf8bae007bb2ee53bd02b3d7d6551d5","9bb31313a70a1352b48a4c3b06e3a1fe32ab9f20e567add2c8f3519f901b2687","edb34ff53cacee38304df4e50108230c03fc79e82ceb927c152b0578652ac379","e1b9a8b514284b62cc7d169bbce232f4556d86aed518411f6d5db0a4501e6d49","0518e7558646f071d080a5832f7109abaf9b14e79f0b66aa1db135344ec36a33","54f