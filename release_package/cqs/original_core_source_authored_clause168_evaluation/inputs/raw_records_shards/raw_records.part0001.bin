{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"pdsch-AggregationFactor","paragraph_zero_based":40104},{"literal_text_all_w_t_and_m_t":"Number of repetitions for dynamic scheduling of MBS broadcast data for MTCH PDSCH (see TS 38.214 [19], clause 5.1.2.1). When the field is absent the UE applies the value 1.","paragraph_zero_based":40105},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40106},{"literal_text_all_w_t_and_m_t":"–TMGI","paragraph_zero_based":40107},{"literal_text_all_w_t_and_m_t":"The IE TMGI is used to identify the MBS session.","paragraph_zero_based":40108},{"literal_text_all_w_t_and_m_t":"TMGI information element","paragraph_zero_based":40109},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":40110},{"literal_text_all_w_t_and_m_t":"-- TAG-TMGI-START","paragraph_zero_based":40111},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40112},{"literal_text_all_w_t_and_m_t":"TMGI-r17 ::=                     SEQUENCE {","paragraph_zero_based":40113},{"literal_text_all_w_t_and_m_t":"    plmn-Id-r17                      CHOICE {","paragraph_zero_based":40114},{"literal_text_all_w_t_and_m_t":"        plmn-Index                       INTEGER (1..maxPLMN),","paragraph_zero_based":40115},{"literal_text_all_w_t_and_m_t":"        explicitValue                    PLMN-Identity","paragraph_zero_based":40116},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":40117},{"literal_text_all_w_t_and_m_t":"    serviceId-r17                    OCTET STRING (SIZE (3))","paragraph_zero_based":40118},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":40119},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40120},{"literal_text_all_w_t_and_m_t":"-- TAG-TMGI-STOP","paragraph_zero_based":40121},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":40122},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40123},{"literal_text_all_w_t_and_m_t":"TMGI field descriptions","paragraph_zero_based":40124},{"literal_text_all_w_t_and_m_t":"plmn-Index","paragraph_zero_based":40125},{"literal_text_all_w_t_and_m_t":"PLMN index or NPN index according to the plmn-IdentityInfoList and npn-IdentityInfoList fields included in SIB1. If this field is included in the MRB-ToAddMod-r17, the UE translates the plmn-Index into the PLMN Identity or SNPN Identity based on the configuration in SIB1 (which is the SIB1 of the target cell in case of handover). The explicitValue is not used for MBS service(s) of an SNPN.","paragraph_zero_based":40126},{"literal_text_all_w_t_and_m_t":"serviceId","paragraph_zero_based":40127}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["b3855dee56495d49c9ab053e4b50ccc4afda2afa08ff93a763841da8fe2ecf1d","5f52f8ff993d334887058fed8e7fb3e06b23cff927b93127b17d67b8e9bbac16","443283861d4ff38c9b1e476695ac05b4c5b21ba889e2a3de78804561c9aecf56","6549f633fdbae375ce20da63a21a31107b8f54ad799c4879d16018d053ff7134","d3aadd6c01a22f21937d3495556bcbf39df65bd53aee7939570990d6d76ab714","9fc7eae45f63d433bbe625f31d77498dba7c5a2910d0f77de687018228bb9b19","a7f4a9123558d4452e1519dea81dcc558d8014087bf246aa02976bfa68efa1a9","84677b371ab4380d41d052041a8b77a5d576c26859295abd963589c329229d19","abed6f1aff695e2f141e1cbc083e3dca245e8d4589e8d57c7ef3aaec0b74d87f","6f50fad7ed836d987126a97902ca4be6efda423f17f676b45b59c7db74926841","c692bc9e025f18670e6a289f0b5e2830a0a1032e5ef6e10f7569cf98f903e7c6","8b96f7b5c9d67abb7e31b987547be28bd8670a1f4deae6c62555655880ce0737","5bb15e9ece81ec13d2acfb94b551b9d41221d3e4a6b4203247ce4917d5640682","d7a5f004befb3f7d807ee