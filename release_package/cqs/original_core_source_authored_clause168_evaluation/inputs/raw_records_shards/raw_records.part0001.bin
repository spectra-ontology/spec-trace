{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":36600},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":36601},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36602},{"literal_text_all_w_t_and_m_t":"-- TAG-LOGMEASRESULTLISTWLAN-STOP","paragraph_zero_based":36603},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36604},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36605},{"literal_text_all_w_t_and_m_t":"LogMeasResultListWLAN field descriptions","paragraph_zero_based":36606},{"literal_text_all_w_t_and_m_t":"Bssid","paragraph_zero_based":36607},{"literal_text_all_w_t_and_m_t":"Basic Service Set Identifier (BSSID) defined in IEEE 802.11-2012 [50].","paragraph_zero_based":36608},{"literal_text_all_w_t_and_m_t":"Hessid","paragraph_zero_based":36609},{"literal_text_all_w_t_and_m_t":"Homogenous Extended Service Set Identifier (HESSID) defined in IEEE 802.11-2012 [50].","paragraph_zero_based":36610},{"literal_text_all_w_t_and_m_t":"rssiWLAN","paragraph_zero_based":36611},{"literal_text_all_w_t_and_m_t":"Measured WLAN RSSI result in dBm. The IE WLAN-RSSI-Range specifies the value range used in WLAN RSSI measurements and thresholds. Integer value for WLAN RSSI measurements is according to mapping table in TS 36.133 [40]. Value 0 corresponds to –infinity, value 1 to -100dBm, value 2 to -99dBm, and so on (i.e. in steps of 1dBm) until value 140, which corresponds to 39dBm, while value 141 corresponds to +infinity.","paragraph_zero_based":36612},{"literal_text_all_w_t_and_m_t":"rtt-WLAN","paragraph_zero_based":36613},{"literal_text_all_w_t_and_m_t":"This field provides the measured roundtrip time between the target device and WLAN AP and optionally the accuracy expressed as the standard deviation of the delay. Units for each of these are 1000ns, 100ns, 10ns, 1ns, and 0.1ns as defined in TS 37.355 [49].","paragraph_zero_based":36614},{"literal_text_all_w_t_and_m_t":"rttValue","paragraph_zero_based":36615},{"literal_text_all_w_t_and_m_t":"This field specifies the Round Trip Time (RTT) measurement between the target device and WLAN AP in units given by the field rttUnits as defined in TS 37.355 [49].","paragraph_zero_based":36616},{"literal_text_all_w_t_and_m_t":"rttUnits","paragraph_zero_based":36617},{"literal_text_all_w_t_and_m_t":"This field specifies the Units for the fields rttValue and rttAccuracy. The available Units are 1000ns, 100ns, 10ns, 1ns, and 0.1ns as defined in TS 37.355 [49].","paragraph_zero_based":36618},{"literal_text_all_w_t_and_m_t":"rttAccuracy","paragraph_zero_based":36619},{"literal_text_all_w_t_and_m_t":"This field provides the estimated accuracy of the provided rttValue expressed as the standard deviation in units given by the field rttUnits as defined in TS 37.355 [49].","paragraph_zero_based":36620},{"literal_text_all_w_t_and_m_t":"Ssid","paragraph_zero_based":36621},{"literal_text_all_w_t_and_m_t":"Service Set Identifier (SSID) defined in IEEE 802.11-2012 [50].","paragraph_zero_based":36622},{"literal_text_all_w_t_and_m_t":"Wlan-Identifiers","paragraph_zero_based":36623}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["f1907294ed059d3829bc519768df06e61219a5e2814384f615a2ce0e1fad2460","9aedf35b2ff82f825aa8dd9c9dba9ac225cfd3f39f2818f0b56fe39ed24b053b","8a2895fdf3b37d0c64f30ae6311cb54bb9c6e39c73c33a3abefa0ebc5894bb65","2aa76506d07820c94ed166c26d58678d8c660383ef5a5555affeeefed3a06aab","092ff5cca0718eb355ab0478afe94c7206b05efa74cc2752200d9bb4fbede1ea","184e862ca839fa9a9f880dc40d75c7e6