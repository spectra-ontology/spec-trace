{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Configured RS for fast SCell activation as specified in TS 38.214 [19] clause 5.2.1.5.3.","paragraph_zero_based":17184},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17185},{"literal_text_all_w_t_and_m_t":"–CSI-ReportConfig","paragraph_zero_based":17186},{"literal_text_all_w_t_and_m_t":"The IE CSI-ReportConfig is used to configure a periodic or semi-persistent report sent on PUCCH on the cell in which the CSI-ReportConfig is included, or to configure a semi-persistent or aperiodic report sent on PUSCH triggered by DCI received on the cell in which the CSI-ReportConfig is included (in this case, the cell on which the report is sent is determined by the received DCI). See TS 38.214 [19], clause 5.2.1.","paragraph_zero_based":17187},{"literal_text_all_w_t_and_m_t":"CSI-ReportConfig information element","paragraph_zero_based":17188},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17189},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-REPORTCONFIG-START","paragraph_zero_based":17190},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17191},{"literal_text_all_w_t_and_m_t":"CSI-ReportConfig ::=                SEQUENCE {","paragraph_zero_based":17192},{"literal_text_all_w_t_and_m_t":"    reportConfigId                          CSI-ReportConfigId,","paragraph_zero_based":17193},{"literal_text_all_w_t_and_m_t":"    carrier                                 ServCellIndex                   OPTIONAL,   -- Need S","paragraph_zero_based":17194},{"literal_text_all_w_t_and_m_t":"    resourcesForChannelMeasurement          CSI-ResourceConfigId,","paragraph_zero_based":17195},{"literal_text_all_w_t_and_m_t":"    csi-IM-ResourcesForInterference         CSI-ResourceConfigId            OPTIONAL,   -- Need R","paragraph_zero_based":17196},{"literal_text_all_w_t_a