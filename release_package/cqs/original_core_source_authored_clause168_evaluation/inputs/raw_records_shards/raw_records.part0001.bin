{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: N/A","paragraph_zero_based":9672},{"literal_text_all_w_t_and_m_t":"RLC-SAP: TM","paragraph_zero_based":9673},{"literal_text_all_w_t_and_m_t":"Logical channel: BCCH","paragraph_zero_based":9674},{"literal_text_all_w_t_and_m_t":"Direction: Network to UE","paragraph_zero_based":9675},{"literal_text_all_w_t_and_m_t":"MIB","paragraph_zero_based":9676},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":9677},{"literal_text_all_w_t_and_m_t":"-- TAG-MIB-START","paragraph_zero_based":9678},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9679},{"literal_text_all_w_t_and_m_t":"MIB ::=                             SEQUENCE {","paragraph_zero_based":9680},{"literal_text_all_w_t_and_m_t":"    systemFrameNumber                   BIT STRING (SIZE (6)),","paragraph_zero_based":9681},{"literal_text_all_w_t_and_m_t":"    subCarrierSpacingCommon             ENUMERATED {scs15or60, scs30or120},","paragraph_zero_based":9682},{"literal_text_all_w_t_and_m_t":"    ssb-SubcarrierOffset                INTEGER (0..15),","paragraph_zero_based":9683},{"literal_text_all_w_t_and_m_t":"    dmrs-TypeA-Position                 ENUMERATED {pos2, pos3},","paragraph_zero_based":9684},{"literal_text_all_w_t_and_m_t":"    pdcch-ConfigSIB1                    PDCCH-ConfigSIB1,","paragraph_zero_based":9685},{"literal_text_all_w_t_and_m_t":"    cellBarred                          ENUMERATED {barred, notBarred},","paragraph_zero_based":9686},{"literal_text_all_w_t_and_m_t":"    intraFreqReselection                ENUMERATED {allowed, notAllowed},","paragraph_zero_based":9687},{"literal_text_all_w_t_and_m_t":"    spare                               BIT STRING (SIZE (1))","paragraph_zero_based":9688},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":9689},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9690},{"literal_text_all_w_t_and_m_t":"-- TAG-MIB-STOP","paragraph_zero_based":9691},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":9692},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9693},{"literal_text_all_w_t_and_m_t":"MIB field descriptions","paragraph_zero_based":9694},{"literal_text_all_w_t_and_m_t":"cellBarred","paragraph_zero_based":9695}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["5d846f05e22392a95128176a70ce26925a31cc663cf19e2402a73b528d2e62ea","8d648cda907d59798e28620d544ec4a4bd0b5db43e0615dbf3b4e0bcced25fcd","b586a2ed2e37b4f834966084eaa54321f02fd762c0a855c18ddecea53476d27d","a7e414555b203f3f0dbbac2e5f6a095f40d4912af6801d8caad671440e45c8c2","58721aff3fdf392d971baedffdcf4b225f47478a5f6b71d739e78f8a3d70aacb","fe8b128fd4cb1cc6050974461a0829f9f665336fd7d86c36805eb60cccc7b657","0752087c4da2543d8aead8852acd4e841e539c9055359b952fd10ea370a97424","3dfd6ad683245a999726074213bad0487f15b649ba4255aa55f62a8acddada7a","b4cf1809f7b9d1aaea532b53ec49004f745779c667c78ab3bb65c9d37ff20124","a093d5952f3d7594b9b69bbe05d87e7c28ad645b36384fe735fbf30496539f51","1a73611a645fea9ed2a23c98d859c018d60914f008e5cc8d29f89a08310a1153","fd29f107728fdb1b22e06c5ed9e622fa4aa7b3d8e63cc71dfafb06a189e83421","7dce15e23f9c740fd5264e138e94322563b7d1b84057b17e30a5c057cd991c64","64b06a959a2a187700fe5dcee303be9007402cba380dbe5c3e83e0a747c80817","c5f9a3a079ae92742a8850983d2571ef95c29e09872ee5098dfbea18e8c447cc","d5eac51a2d22098d867900b6103f4131210b5e35b35cee496ba8f4cffa8953cd","8ba2d9d9d71bf61eb0896c4030c11fa8fe8572a9080df493200bfdf9f9defa4a","0d6703dceb06cbd73075386de5e579d9d21d35943680cf6928d8ab4b99aa936c","72693db793e1bbae9d6d651b6908c12c096bb77c68e9c2ff0597248da1b6b0fa","00f9858b3e94b962dbcdb1642aff1782a202384db0b7efec89187507d676a2e0","290b853339ae93738378e668753783af6fa0922044a7f5ee7c7217b04b3d4f28","1de914c43977cf188fc35bfceb6de47b4d3bb9a4f3a6d5b2a9c522c3a0aa743b","e8b0c5f1740d4eb9e0e59a6cb270144ddf18f7d34bb922e41d283bfd0f9ab362","e7b2549240c9dec94eba07b3001253bcd5a55f9a4561fff65f77ed8c1457bfdf"],"paragraph_range_zero_based":[9672,9695],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p9672"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Value barred means that the cell is barred, as defined in TS 38.304 [20]. This field is ignored by IAB-MT. This field is ignored for connectivity to NTN.","paragraph_zero_based":9696},{"literal_text_all_w_t_and_m_t":"dmrs-TypeA-Position","paragraph_zero_based":9697},{"literal_text_all_w_t_and_m_t":"Position of (first) DM-RS for downlink (see TS 38.211 [16], clause 7.4.1.1.2) and uplink (see TS 38.211 [16], clause 6.4.1.1.3).","paragraph_zero_based":9698},{"literal_text_all_w_t_and_m_t":"intraFreqReselection","paragraph_zero_based":9699},{"literal_text_all_w_t_and_m_t":"Controls cell selection/reselection to intra-frequency cells when the highest ranked cell is barred, or treated as barred by the UE, as specified in TS 38.304 [20]. This field is ignored by IAB-MT.","paragraph_zero_based":9700},{"literal_text_all_w_t_and_m_t":"pdcch-ConfigSIB1","paragraph_zero_based":9701},{"literal_text_all_w_t_and_m_t":"Determines a common ControlResourceSet (CORESET), a common search space and necessary PDCCH parameters. If the field ssb-SubcarrierOffset indicates that SIB1 is absent, the field pdcch-ConfigSIB1 indicates the frequency positions where the UE may find SS/PBCH block with SIB1 or the frequency range where the network does not provide SS/PBCH block with SIB1 (see TS 38.213 [13], clause 13).","paragraph_zero_based":9702},{"literal_text_all_w_t_and_m_t":"ssb-SubcarrierOffset","paragraph_zero_based":9703},{"literal_text_all_w_t_and_m_t":"Corresponds to kSSB (see TS 38.213 [13]), which is the frequency domain offset between SSB and the overall resource block grid in number of subcarriers. (See TS 38.211 [16], clause 7.4.3.1). For operation with shared spectrum channel access in FR1 (see 37.213 [48]), this field corresponds to kSSB, and kSSB is obtained from kSSB (see TS 38.211 [16], clause 7.4.3.1); the LSB of this field is used also for deriving the QCL relation between SS/PBCH blocks as specified in TS 38.213 [13], clause 4.1.","paragraph_zero_based":9704},{"literal_text_all_w_t_and_m_t":"The value range of this field may be extended by an additional most significant bit encoded within PBCH as specified in TS 38.213 [13].","paragraph_zero_based":9705},{"literal_text_all_w_t_and_m_t":"This field may indicate that this cell does not provide SIB1 and that there is hence no CORESET#0 configured in MIB (see TS 38.213 [13], clause 13). In this case, the field pdcch-ConfigSIB1 may indicate the frequency positions where the UE may (not) find a SS/PBCH with a control resource set and search space for SIB1 (see TS 38.213 [13], clause 13).","paragraph_zero_based":9706},{"literal_text_all_w_t_and_m_t":"subCarrierSpacingCommon","paragraph_zero_based":9707},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing for SIB1, Msg.2/4 and MsgB for initial access, paging and broadcast SI-messages. If the UE acquires this MIB on an FR1 carrier frequency, the value scs15or60 corresponds to 15 kHz and the value scs30or120 corresponds to 30 kHz. If the UE acquires this MIB on an FR2 carrier frequency, the value scs15or60 corresponds to 60 kHz and the value scs30or120 corresponds to 120 kHz. For operation with shared spectrum channel access in FR1 (see 37.213 [48]) and for operation in FR2-2, the subcarrier spacing for SIB1, Msg.2/4 and MsgB for initial access, paging and broadcast SI-messages is same as that for the corresponding SSB. For operation with shared spectrum channel access, this field instead is used for deriving the QCL relation between SS/PBCH blocks as specified in TS 38.213 [13], clause 4.1.","paragraph_zero_based":9708},{"literal_text_all_w_t_and_m_t":"systemFrameNumber","paragraph_zero_based":9709},{"literal_text_all_w_t_and_m_t":"The 6 most significant bits (MSB) of the 10-bit System Frame Number (SFN). The 4 LSB of the SFN are conveyed in the PBCH transport block as part of channel coding (i.e. outside the MIB encoding), as defined in clause 7.1 in TS 38.212 [17].","paragraph_zero_based":9710},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9711},{"literal_text_all_w_t_and_m_t":"–MobilityFromNRCommand","paragraph_zero_based":9712},{"literal_text_all_w_t_and_m_t":"The MobilityFromNRCommand message is used to command handover from NR to E-UTRA/EPC, E-UTRA/5GC or UTRA-FDD.","paragraph_zero_based":9713},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1","paragraph_zero_based":9714},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":9715},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":9716},{"literal_text_all_w_t_and_m_t":"Direction: Network to UE","paragraph_zero_based":9717},{"literal_text_all_w_t_and_m_t":"MobilityFromNRCommand message","paragraph_zero_based":9718},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":9719}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["76a9c7fe40dc3927106638ce0593de3224bdc38b923bb30235722d8e0cfab377","2c45b0e6caef537dbb1a8e45282b8e6f79cec493bdefc10557e847b9d0a9ac57","358d23fb659d2b03976b1a90c94bd85d193018fd7e3a0ba321cf8f7c36b1b9ac","1b825b9ad6dcb7ff1c4692e34f83f1e8270b007974348397dae7f42ce7cf3e4d","192b6b97d283f6ec33ac13d92f2e089c0582f29aeda5276b0ec02606601b5c25","07d71128e73ae5d5ae7d0f9473de043d202746cb56df6f1381fe5fc3a5340641","13a73234d55dea52a5a5870b5575ecfa4c859d955105851f0398162cbf31a71d","62e4d402f85384df872d3d30bd05383579f3a101f4bad7a707015b5f84e61f4f","f065491a1a264f2d3e055392cd02f38a1be8b3b23a822fa0478eea5790d9394f","b820ebe900b500d3513cd68bbdbac79e2586124de1b34261f3c35f35a055c6f8","a6b7f2ff9c71a36d2ba30f76980cf7de47e3ac13d3a8e5779798874dbb307cc3","7314630e3b6bc97b2665a1a869e372c370b22e12a5e5004afccf28f90fa32ceb","0cdf3a68290c44da39e6ae7ae9192e2c107a32e1bebce15a458f7c47d43c3cbd","a43dfb4ac8e5a84870b2ed50e6de20562fb6b1ce9256f591039a919314bd9a5e","76c9800809332fa3def7c6fc1c041d2bdc7737a3c103d212b7c2f0b7f31dcf8e","b1a58f378c43cd59b5716074d52b97a44422f75aacf83415ff35417abb3b1275","4d80c8c014d93f855711d1afb610bcea4b849adbaf402a64b7d53313b62693f1","f9e1a219d1d77481d291e2fb2e21f96e8073aaab1ba8e2f8699cfb31695497e7","e341222ffa563759c9598e09e9d17348714d5ca79b28038dc00cd5e0cab12b1b","20d83656652807f659e4f6c40969d90557927a117389106796cb72d1de44cfb6","c72cf8eed698c9bbfd99d39bcfeaa75a4f5ce7daf8685d894febc26ed9093a63","9638be2d959f92581d69b58bc6ee03d58b4b33c0263a4583e1d373aacb7d502c","d1433c4e1c1641643309dda85a041437dc7f8dbb213f41f1e55f2547019ab015","6962c3e7cedadf647756e3d7c2ec094f5f00ceae11abb04994c16f4973b91466"],"paragraph_range_zero_based":[9696,9719],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p9696"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-MOBILITYFROMNRCOMMAND-START","paragraph_zero_based":9720},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9721},{"literal_text_all_w_t_and_m_t":"MobilityFromNRCommand ::=           SEQUENCE {","paragraph_zero_based":9722},{"literal_text_all_w_t_and_m_t":"    rrc-TransactionIdentifier           RRC-TransactionIdentifier,","paragraph_zero_based":9723},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                  CHOICE {","paragraph_zero_based":9724},{"literal_text_all_w_t_and_m_t":"            mobilityFromNRCommand           MobilityFromNRCommand-IEs,","paragraph_zero_based":9725},{"literal_text_all_w_t_and_m_t":"            criticalExtensionsFuture        SEQUENCE {}","paragraph_zero_based":9726},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":9727},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":9728},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9729},{"literal_text_all_w_t_and_m_t":"MobilityFromNRCommand-IEs ::=       SEQUENCE {","paragraph_zero_based":9730},{"literal_text_all_w_t_and_m_t":"    targetRAT-Type                      ENUMERATED { eutra, utra-fdd-v1610, spare2, spare1, ...},","paragraph_zero_based":9731},{"literal_text_all_w_t_and_m_t":"    targetRAT-MessageContainer          OCTET STRING,","paragraph_zero_based":9732},{"literal_text_all_w_t_and_m_t":"    nas-SecurityParamFromNR             OCTET STRING                                                OPTIONAL,   -- Cond HO-ToEPCUTRAN","paragraph_zero_based":9733},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension            OCTET STRING                                                OPTIONAL,","paragraph_zero_based":9734},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                MobilityFromNRCommand-v1610-IEs                             OPTIONAL","paragraph_zero_based":9735},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":9736},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9737},{"literal_text_all_w_t_and_m_t":"MobilityFromNRCommand-v1610-IEs ::=     SEQUENCE {","paragraph_zero_based":9738},{"literal_text_all_w_t_and_m_t":"    voiceFallbackIndication-r16             ENUMERATED {true}                                       OPTIONAL,   -- Need N","paragraph_zero_based":9739},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                    SEQUENCE {}                                             OPTIONAL","paragraph_zero_based":9740},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":9741},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9742},{"literal_text_all_w_t_and_m_t":"-- TAG-MOBILITYFROMNRCOMMAND-STOP","paragraph_zero_based":9743}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["bc877c0328c6c2ab440cd9a8a955e8a86e81b1756bc80886fed60266abb837f5","ae8241314c0eeeedf48bcc3eefab381ed7545e55f78ae03aca0ed1f33c802955","7d2fa232ab22c5dcff365a4787bd0240b3c0d10cfc3a8a98afcb62183d889051","5b18dbf0b3146558242ea3696b886c9a71547213f9518ee8ce7e9a8a7960b801","8a13f9be0e6277928929730ff66f9034da0024b8187afc9898e77df42a0224eb","2fd3323864c73a01a43b906233c66bb50e799a36f16045b88e278912e9381950","69e6e6eda602d53c826291d19b0ad805a3de72a6defa9b4b3be7ddb95ed52b98","a84d721fafcb542d796d46db444dd5b4efe0b23b78a09427bd1606ddbc13c81b","a92ead291f6ab2498cd8e1e33bfb15f21ec4e9d4d9fb3e0ceb8c89f9be21a6ba","216a25c082ad791dce92974728862cef6b67514b34394706e320b023e71aa140","5050da57c2d31358143ad2e2319a3ad50b9f4bfb5953f4d39439c7748dce8d03","403467ab396f2a3f4745a0f3f200b35a74cfa28349e7306e91c2f49861799e5b","1bd4d99cd0aeebd6323106625572a2c2b79c64d4445ec94c52a3f021f51da113","68df1ce50c5b227c81108666cf90e0cb6da3e0612e90b8fb082c7fbe2c43b831","c0acbeee475676159de5afe6451e30923ee947e81445f282f6152245618318e9","493dfbc7c41a09e7920ac54338a686067d50eda9856b4ea123002011e32e3331","7f414b298773b708302f36158984970f508e804741257c3f6fdc3c4dbe616278","29ee7d18b0dd9f0f4b6add4399bd1913e72e25ac69190bdce69ef63b9f2b175a","4256d43018c063a20894e19273ac0a95ab73ed041df8f4d34a5a0955f95d7e52","7de0e8be7610268381156c774e7a7f05e36a628abcca966fd57fad56e24cadd9","2feb282f9882f239a8a584f9293f1de7f59dce95743019be6aa975fec28ca474","6faa51f5ed8bf785798bc34238cad1df3eb03ac8f07c5db012e6239d49001179","34c76889e69cf053ea327ac549ddf4a90198acb5907ddaeb1c00622d91478427","1f0cab94485c08200bee0a143f38dcc196f204c6eb66d6d17c0545d230ab73d8"],"paragraph_range_zero_based":[9720,9743],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p9720"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":9744},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9745},{"literal_text_all_w_t_and_m_t":"MobilityFromNRCommand-IEs field descriptions","paragraph_zero_based":9746},{"literal_text_all_w_t_and_m_t":"nas-SecurityParamFromNR","paragraph_zero_based":9747},{"literal_text_all_w_t_and_m_t":"If targetRAT-Type is eutra, this field is used to deliver the key synchronisation and Key freshness for the NR to LTE/EPC handovers and a part of the downlink NAS COUNT as specified in TS 33.501 [11] and the content of the parameter is defined in TS 24.501 [23]. If targetRAT-Type is utra-fdd, this field is used to deliver the key synchronisation and Key freshness for the NR to FDD UTRAN handover and a part of the downlink NAS COUNT as specified in TS 33.501 [11] and the content of the parameter is defined in TS 24.501 [23].","paragraph_zero_based":9748},{"literal_text_all_w_t_and_m_t":"targetRAT-MessageContainer","paragraph_zero_based":9749},{"literal_text_all_w_t_and_m_t":"The field contains a message specified in another standard, as indicated by the targetRAT-Type, and carries information about the target cell identifier(s) and radio parameters relevant for the target radio access technology. A complete message is included, as specified in the other standard. See NOTE 1","paragraph_zero_based":9750},{"literal_text_all_w_t_and_m_t":"targetRAT-Type","paragraph_zero_based":9751},{"literal_text_all_w_t_and_m_t":"Indicates the target RAT type.","paragraph_zero_based":9752},{"literal_text_all_w_t_and_m_t":"voiceFallbackIndication","paragraph_zero_based":9753},{"literal_text_all_w_t_and_m_t":"Indicates the handover is triggered by EPS fallback for IMS voice as specified in TS 23.502 [43].","paragraph_zero_based":9754},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9755},{"literal_text_all_w_t_and_m_t":"NOTE 1:The correspondence between the value of the targetRAT-Type, the standard to apply, and the message contained within the targetRAT-MessageContainer is shown in the table below:","paragraph_zero_based":9756},{"literal_text_all_w_t_and_m_t":"targetRAT-Type","paragraph_zero_based":9757},{"literal_text_all_w_t_and_m_t":"Standard to apply","paragraph_zero_based":9758},{"literal_text_all_w_t_and_m_t":"targetRAT-MessageContainer","paragraph_zero_based":9759},{"literal_text_all_w_t_and_m_t":"eutra","paragraph_zero_based":9760},{"literal_text_all_w_t_and_m_t":"TS 36.331 [10] (clause 5.4.2)","paragraph_zero_based":9761},{"literal_text_all_w_t_and_m_t":"DL-DCCH-Message including the RRCConnectionReconfiguration","paragraph_zero_based":9762},{"literal_text_all_w_t_and_m_t":"utra-fdd","paragraph_zero_based":9763},{"literal_text_all_w_t_and_m_t":"TS 25.331 [45] (clause 10.2.16a)","paragraph_zero_based":9764},{"literal_text_all_w_t_and_m_t":"Handover TO UTRAN command","paragraph_zero_based":9765},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9766},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":9767}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["b27629acd2482f84600529b8eed664c29207292c71578fa8bf0aa3a1d8d0f71e","00017cf1a05bf9cceb451678456d52cd462d2dd9d1f204cc1074d8f20f538cdb","086c04f08ed374743d4f0e43102d8ee6e565c35a2c6a73d5794eb0381172e86d","4042466318b9806bac23a7085b73d9f19ec3b1b54ef42a01dd75305460974324","e700f7a2f286ab0286b319a25b9d76d4d42e73ed0eb515d03963825808413ff9","e8041f3bfb0091deb995bc10d691bd98237e3b0dd7fbf28ae06ecb9c1fa29f17","50f07d0ca89b75ef28fe5be200c8c4