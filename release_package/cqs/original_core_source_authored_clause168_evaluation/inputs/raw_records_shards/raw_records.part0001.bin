{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    sl-Failure-r16                         ENUMERATED {rlf,configFailure, drxReject-v1710, spare5, spare4, spare3, spare2, spare1}","paragraph_zero_based":11664},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":11665},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11666},{"literal_text_all_w_t_and_m_t":"-- TAG-SIDELINKUEINFORMATIONNR-STOP","paragraph_zero_based":11667},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":11668},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11669},{"literal_text_all_w_t_and_m_t":"SidelinkUEinformationNR field descriptions","paragraph_zero_based":11670},{"literal_text_all_w_t_and_m_t":"sl-RxDRX-ReportList","paragraph_zero_based":11671},{"literal_text_all_w_t_and_m_t":"Indicates the accepted DRX configuration that is received from the peer UE and reported to the network for NR sidelink unicast communication.","paragraph_zero_based":11672},{"literal_text_all_w_t_and_m_t":"sl-RxInterestedFreqList","paragraph_zero_based":11673},{"literal_text_all_w_t_and_m_t":"Indicates the index of frequency on which the UE is interested to receive NR sidelink communication. The value 1 corresponds to the frequency of first entry in sl-FreqInfoList broadcast in SIB12, the value 2 corresponds to the frequency of second entry in sl-FreqInfoList broadcast in SIB12 and so on. In this release, only value 1 can be included in the interested frequency list. ","paragraph_zero_based":11674},{"literal_text_all_w_t_and_m_t":"sl-RxInterestedGC-BC-DestList","paragraph_zero_based":11675},{"literal_text_all_w_t_and_m_t":"Indicates the reported QoS profile and associated destination for which UE is interested in reception to the network for NR sidelink groupcast and broadcast communication, or for NR sidelink discovery or ProSe Direct Link Establishment Request as described in TS 24.554 [72], or for Direct Link Establishment Request (TS 24.587 [57]).","paragraph_zero_based":11676},{"literal_text_all_w_t_and_m_t":"sl-SourceIdentityRemoteUE","paragraph_zero_based":11677},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the Source Layer-2 ID to be used to establish PC5 link with the target L2 U2N Relay UE for path switch.","paragraph_zero_based":11678},{"literal_text_all_w_t_and_m_t":"sl-TxResourceReq","paragraph_zero_based":11679},{"literal_text_all_w_t_and_m_t":"Parameters to request the transmission resources for NR sidelink communication to the network in the Sidelink UE Information report.","paragraph_zero_based":11680},{"literal_text_all_w_t_and_m_t":"sl-TxResourceReqList","paragraph_zero_based":11681},{"literal_text_all_w_t_and_m_t":"List of parameters to request the transmission resources for NR sidelink communication for the associated destination. If sl-TxResourceReqList-v1700 is present, it shall contain the same number of entries, listed in the same order as in sl-TxResourceReqList-r16.","paragraph_zero_based":11682},{"literal_text_all_w_t_and_m_t":"ue-Type","paragraph_zero_based":11683},{"literal_text_all_w_t_and_m_t":"Indicates the UE is acting as U2N Relay UE or U2N Remote UE.","paragraph_zero_based":11684},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11685},{"literal_text_all_w_t_and_m_t":"SL-TxResourceReq field descriptions","paragraph_zero_based":11686},{"literal_text_all_w_t_and_m_t":"sl-CapabilityInformationSidelink","paragraph_zero_based":11687}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["c0143f370a6e6463bfe94e59e9aad3da95ae3547c430dcccc2639fa248874dc0","ec71f5e5e8e76ed717090da92cd507a73bd7c38397d3d145c6070e2c051dd610","707d9bd5802cb11516232094f8227b6a2087976ba0ee70ae61a21af49f5893f1","4ae5a8b511a840377eb38ad355d95291c4a6061c6c7ee5013f29e605d1c2089f","699c4e08408e9c36c7de532b369eb6461f9986af0b90362ee028beda3b6b8374","3624cde4868c8d13cc5502cbaa028bbf0bd36719e01efb2df463f80f5e8b921f","474e06139147762e82d5f0356418a9f6b3f2bf0081ce8751492a044e3d6f0a40","215715969bd328a72f78a956d35199b3422f1d1dc242b76efef91c4c7a9e6390","fad5f91140d3e2beeae2b26582dbf31bf367f12bcfeb9aa378d531dabe3b5b04","0ac65f7dce0aaefdfc420d5687ae01fd13287f87d3e55e8ffc3adf378473e625","6896bb07f4591d9bcd6cdd26714554313d6480fc435e585548c6203379a85196","2ab4729d93cb476150819d45cb2815db5366cf7eeb26fa0f8047e32aa1abcc36","178a6ce9ed3baae110b83c928588d570ba3583050ede6bdee1ba0937c3e8f129","84904a0a3d4cdd13d64a974b02241ff5a397e884d22225382433b26c62bdff18","116639a0e99113008880024f86c44244d8ac74688828630d6d739561744bc5bd","3336801f83ad66c7fccae1a1c1c75584b1ab9d9c6643ed4554c19b3cc95ccbd5","72aab7f68677420db902d7f558eacb5e197bb41c9278ee27d7f963e690323646","91c8cc07afd49e31e38dd25457042333c0e9035a6d3f9b012e6ed04cb8a2145a","d36a3c806d34b0eceedb27b9ce8ce5dbe5b7a262ba49aef8422ae4265690347a","0f7d08832411b290f02857ac3f129c4a3db85c49c6a0e97b0dc682ab37d57ec5","a64edcc9921fa698820cdf289587672e3c67ba827278363b3ebb052344f4454f","ceb0c39afb2734b7d4cea71b51c78f734e860926451a873826726c1fe49ea66e","8ae920d07dc36cce9ef22a44623d50b0d3df0790a97fe9420d80ff053b935d7f","a89e3bfbf3eb8b297269c9f3c08d00e604af5f795ebdef98b6fa4c0ec1d3b13f"],"paragraph_range_zero_based":[11664,11687],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p11664"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Includes the UECapabilityInformationSidelink message (which can be also included in ueCapabilityInformationSidelink-r16 in UECapabilityEnquirySidelink from peer UE) received from the peer UE.","paragraph_zero_based":11688},{"literal_text_all_w_t_and_m_t":"sl-CastType","paragraph_zero_based":11689},{"literal_text_all_w_t_and_m_t":"Indicates the cast type for the corresponding destination for which to request the resource.","paragraph_zero_based":11690},{"literal_text_all_w_t_and_m_t":"sl-DestinationIdentity","paragraph_zero_based":11691},{"literal_text_all_w_t_and_m_t":"Indicates the destination for which the TX resource request and allocation from the network are concerned.","paragraph_zero_based":11692},{"literal_text_all_w_t_and_m_t":"sl-DRX-Indication","paragraph_zero_based":11693},{"literal_text_all_w_t_and_m_t":"Indicates the sidelink DRX is applied (value on) or not applied (value off) for the associated destination. This field is only valid for NR sidelink groupcast communication.","paragraph_zero_based":11694},{"literal_text_all_w_t_and_m_t":"sl-DRX-InfoFromRxList","paragraph_zero_based":11695},{"literal_text_all_w_t_and_m_t":"Indicates list of the sidelink DRX configurations as assistance information received from the peer UE for NR sidelink unicast communication.","paragraph_zero_based":11696},{"literal_text_all_w_t_and_m_t":"sl-QoS-InfoList","paragraph_zero_based":11697},{"literal_text_all_w_t_and_m_t":"Includes the QoS profile of the sidelink QoS flow as specified in TS 23.287 [55].","paragraph_zero_based":11698},{"literal_text_all_w_t_and_m_t":"sl-QoS-FlowIdentity","paragraph_zero_based":11699},{"literal_text_all_w_t_and_m_t":"This identity uniquely identifies one sidelink QoS flow between the UE and the network in the scope of UE, which is unique for different destination and cast type.","paragraph_zero_based":11700},{"literal_text_all_w_t_and_m_t":"sl-RLC-ModeIndication","paragraph_zero_based":11701},{"literal_text_all_w_t_and_m_t":"This field indicates the RLC mode and optionally the related QoS profiles for the sidelink radio bearer, which has not been configured by the network and is initiated by another UE in unicast. The RLC mode for one sidelink radio bearer is aligned between UE and NW by the sl-QoS-FlowIdentity.","paragraph_zero_based":11702},{"literal_text_all_w_t_and_m_t":"sl-TxInterestedFreqList","paragraph_zero_based":11703},{"literal_text_all_w_t_and_m_t":"Each entry of this field indicates the index of frequency on which the UE is interested to transmit NR sidelink communication. The value 1 corresponds to the frequency of first entry in sl-FreqInfoList broadcast in SIB12, the value 2 corresponds to the frequency of second entry in sl-FreqInfoList broadcast in SIB12 and so on. In this release, only value 1 can be included in the interested frequency list. In this release, only one entry can be included in the list.","paragraph_zero_based":11704},{"literal_text_all_w_t_and_m_t":"sl-TypeTxSyncList","paragraph_zero_based":11705},{"literal_text_all_w_t_and_m_t":"A list of synchronization reference used by the UE. The UE shall include the same number of entries, listed in the same order, as in sl-TxInterestedFreqList, i.e. one for each carrier frequency included in sl-TxInterestedFreqList.","paragraph_zero_based":11706},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11707},{"literal_text_all_w_t_and_m_t":"SL-Failure field descriptions","paragraph_zero_based":11708},{"literal_text_all_w_t_and_m_t":"sl-DestinationIdentity","paragraph_zero_based":11709},{"literal_text_all_w_t_and_m_t":"Indicates the destination for which the SL failure is reporting for unicast.","paragraph_zero_based":11710},{"literal_text_all_w_t_and_m_t":"sl-Failure","paragraph_zero_based":11711}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["15ab158eaa8e38ec6073d9214fcdb56346d580529ea0d88d5db573761f0ceef9","5b2825768b93924ee41e749db67c17b65b7362709ab9249465cd125b00221b74","20889a2554a704a41b30b9d1b77ff8d5384fc8ae4bde0cf67ee4848e55de0b93","3c28a75faecf32c6a2d85022c17cd44a8a85b51c9734bf98aad771470a02905b","db0a45c29669dc40ae50eef3a0b42ef8fc2dfc9ca41b80eb2dd5d6b6bd5ced90","95eb98c56cc1d0453efe565855d6b00c385984744682b69e9cc67e4e5a4ba9fe","e799a0047efa99fe4b770f67ebd2b62563f891fbd310e14e4e5f9b279129da17","5598e8e303334671ef1b7902bdfe2e8cb2cc744db0cee1a567f414d1c06a0afc","2aa159ffd3ce411e6e8810d19fd9bb8faab3b5fc87e6a14f4cfdd8b23111ac02","7b44d1d7f5e14b2729d404a3bab97b4a28bfefa90addebc7ac5776458571356e","2d7e8c18d8901708d6028d1a5fb21db4810ffcab6e641f7830989af007c68ca7","b463f81fb51996100def568551c8714acbc99866a3a0496c77a511b531557d67","cf9aacfbc01700e11968cc174389c6d2751786bbef2317151dfedb1192006868","7170536b9456fd6770df505d05fdc0f47f926b29c7aabcff3257c11810a40d31","41b161606de0e02bcaedc9fe1a1a23913ce53c9856598d3d544ad1a2bacde3a7","e1db91468d62ddb1f0695c63da3c466aba7ec14fe8fcc1434b2601af7a6256f1","7e96b3ea423d6225147dee8a7b837957bcbc3957b8693e811072cc8acaa35aa7","187b92a010cf4d2dc1879a370810a84c680cf961897593def6a0cab6f9427b44","cd8941d906e9cabf275910a0b075bf1dd632c16bcf8a0280453044b09e6d4cad","994ae916cc93aa38b7a02ad1b30554695cada988f67e9d650d0f0b4ee699add8","041122b0388d5d452a3c2646c4d448b10212d6093632c187a6e213dc8abf80b3","4840a6812f8425ffd15412f7b55629f611d4713926188ef51e30148fa1d7a11b","f519adca1474c90ec06a393307e0c5e747dad8e82429ae741e11665575f07913","bb0c7d16f828cd5a675966d48fda46cc51706bbd3a6ac7dbd895348a0da9de2f"],"paragraph_range_zero_based":[11688,11711],"projection":"All w:t and m:t inclu