{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RADIOBEARERCONFIG-STOP","paragraph_zero_based":38424},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":38425},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38426},{"literal_text_all_w_t_and_m_t":"SL-RadioBearerConfig field descriptions","paragraph_zero_based":38427},{"literal_text_all_w_t_and_m_t":"sl-PDCP-Config","paragraph_zero_based":38428},{"literal_text_all_w_t_and_m_t":"This field indicates the PDCP parameters for the sidelink DRB.","paragraph_zero_based":38429},{"literal_text_all_w_t_and_m_t":"sl-SDAP-Config","paragraph_zero_based":38430},{"literal_text_all_w_t_and_m_t":"This field indicates how to map sidelink QoS flows to sidelink DRB.","paragraph_zero_based":38431},{"literal_text_all_w_t_and_m_t":"slrb-Uu-ConfigIndex","paragraph_zero_based":38432},{"literal_text_all_w_t_and_m_t":"This field indicates the index of sidelink DRB configuration.","paragraph_zero_based":38433},{"literal_text_all_w_t_and_m_t":"sl-TransRange","paragraph_zero_based":38434},{"literal_text_all_w_t_and_m_t":"This field indicates the transmission range of the sidelink DRB. The unit is meter.","paragraph_zero_based":38435},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38436},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":38437},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":38438},{"literal_text_all_w_t_and_m_t":"SLRBSetup","paragraph_zero_based":38439},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in case of sidelink DRB setup via the dedicated signalling and in case of sidelink DRB configuration via system information and pre-configuration; otherwise the field is optionally present, need M.","paragraph_zero_based":38440},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38441},{"literal_text_all_w_t_and_m_t":"–SL-RelayUE-Config","paragraph_zero_based":38442},{"literal_text_all_w_t_and_m_t":"The IE SL-RelayUE-Config specifies the configuration information for NR sidelink U2N Relay UE.","paragraph_zero_based":38443},{"literal_text_all_w_t_and_m_t":"SL-RelayUE-Config information element","paragraph_zero_based":38444},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":38445},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RELAYUE-CONFIG-START","paragraph_zero_based":38446},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38447}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["746ed01f5e052f676dbc22c2e02469ca0bbccd27bc4e3f8923932d653633c95f","c6ac471eb4d2797ac1b376207370dfb3a1cb1082766592ed5eab9bd76f83fde7","282a8ade98dfd891824c3f80dca1062b5d3ab39c48bdcf30fb8947d8f255c2f1","dad8cf3e98808df505fb8cdad7b541864415688454bc809a58082d6a2cced310","5310829627391c4bd5522bc000dcaf4f6cf318bec7afb4a74691bdf54a41f127","a4b89d1c09fbf3859cb98f820e46efa1eec1368715e164cbff00a453a7e79869","9e3e9fb31ef71bfba3bd446bbd092ebbc619f9c54247608179a5a04f89f9ca83","39f76e06edb82795cefc364eed6d985e4ad1a83de6316a8f70d76921d0989da1","af730b1a6f92d05a6461d07c75e1f5de5d78efbdc6bda6240bf67676775be938","04b83a2ddd6288dda91d42b675a711f29720e371a8303a19703c3b48e6063624","8dd914ce02a09d523e4494247a1c0869be03574204ed0af1ed4d97c2001b9b14","1d77af8e10934db0f301e4a17e0e21fcafe5165ded61981ee227ccb5d2b93d0d","63e581cef19fa89a29f2bf84025fef3497a8c46a7c584200920cf1f66c1bf7eb","ab7c1816d093c5f27b0ab399c3a451bc207fa0fb52e49173d041f3784d59a71a","5b4791ec52fbc266514682b6d55c3f6dc8e5018b5cea193706c8f3403b6d42bc","c21ac1d6fc9344621ac550befa5479144f5a