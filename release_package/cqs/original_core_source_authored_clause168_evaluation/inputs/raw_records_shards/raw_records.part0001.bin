{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Subframe/Slot offset for ROs defined in the baseline configuration indicated by prach-ConfigurationIndex and is used only by the IAB-MT. (see TS 38.211 [16], clause 6.3.3.2).","paragraph_zero_based":24912},{"literal_text_all_w_t_and_m_t":"preambleReceivedTargetPower","paragraph_zero_based":24913},{"literal_text_all_w_t_and_m_t":"The target power level at the network receiver side (see TS 38.213 [13], clause 7.4, TS 38.321 [3], clauses 5.1.2, 5.1.3). Only multiples of 2 dBm may be chosen (e.g. -202, -200, -198, ...). ","paragraph_zero_based":24914},{"literal_text_all_w_t_and_m_t":"preambleTransMax","paragraph_zero_based":24915},{"literal_text_all_w_t_and_m_t":"Max number of RA preamble transmission performed before declaring a failure (see TS 38.321 [3], clauses 5.1.4, 5.1.5).","paragraph_zero_based":24916},{"literal_text_all_w_t_and_m_t":"ra-ResponseWindow","paragraph_zero_based":24917},{"literal_text_all_w_t_and_m_t":"Msg2 (RAR) window length in number of slots. The network configures a value lower than or equal to 10 ms when Msg2 is transmitted in licensed spectrum and a value lower than or equal to 40 ms when Msg2 is transmitted with shared spectrum channel access (see TS 38.321 [3], clause 5.1.4). UE ignores the field if included in SCellConfig. If ra-ResponseWindow-v1610 or ra-ResponseWindow-v1700 is signalled, UE shall ignore the ra-ResponseWindow (without suffix). The field ra-ResponseWindow-v1700 is applicable to SCS 480 kHz and SCS 960 kHz.","paragraph_zero_based":24918},{"literal_text_all_w_t_and_m_t":"zeroCorrelationZoneConfig","paragraph_zero_based":24919},{"literal_text_all_w_t_and_m_t":"N-CS configuration, see Table 6.3.3.1-5 in TS 38.211 [16].","paragraph_zero_based":24920},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24921},{"literal_text_all_w_t_and_m_t":"–RACH-ConfigGenericTwoStepRA","paragraph_zero_based":24922},{"literal_text_all_w_t_and_m_t":"The IE RACH-ConfigGenericTwoStepRA is used to specify the 2-step random access type parameters.","paragraph_zero_based":24923},{"literal_text_all_w_t_and_m_t":"RACH-ConfigGenericTwoStepRA information element","paragraph_zero_based":24924},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":24925},{"literal_text_all_w_t_and_m_t":"-- TAG-RACH-CONFIGGENERICTWOSTEPRA-START","paragraph_zero_based":24926},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24927},{"literal_text_all_w_t_and_m_t":"RACH-ConfigGenericTwoStepRA-r16 ::=     SEQUENCE {","paragraph_zero_based":24928},{"literal_text_all_w_t_and_m_t":"    msgA-PRACH-ConfigurationIndex-r16       INTEGER (0..262)                                                OPTIONAL, -- Cond 2StepOnly","paragraph_zero_based":24929},{"literal_text_all_w_t_and_m_t":"    msgA-RO-FDM-r16                         ENUMERATED {one, two, four, eight}                              OPTIONAL, -- Cond 2StepOnly","paragraph_zero_based":24930},{"literal_text_all_w_t_and_m_t":"    msgA-RO-FrequencyStart-r16              INTEGER (0..maxNrofPhysicalResourceBlocks-1)                    OPTIONAL, -- Cond 2StepOnly","paragraph_zero_based":24931},{"literal_text_all_w_t_and_m_t":"    msgA-ZeroCorrelationZoneConfig-r16      INTEGER (0..15)                                                 OPTIONAL, -- Cond 2StepOnly","paragraph_zero_based":24932},{"literal_text_all_w_t_and_m_t":"    msgA-PreamblePowerRampingStep-r16       ENUMERATED {dB0, dB2, dB4, dB6}                                 OPTIONAL, -- Cond 2StepOnlyNoCFRA","paragraph_zero_based":24933},{"literal_text_all_w_t_and_m_t":"    msgA-PreambleReceivedTargetPower-r16    INTEGER (-202..-60)                                             OPTIONAL, -- Cond 2StepOnlyNoCFRA","paragraph_zero_based":24934},{"literal_text_all_w_t_and_m_t":"    msgB-ResponseWindow-r16                 ENUMERATED {sl1, sl2, sl4, sl8, sl10, sl20, sl40, sl80, sl160, sl320}","paragraph_zero_based":24935}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["92e98ec31054baa34c92884716a69337421c593696044d97d726ccf38eeba8e1","979ad79ed0618782205cb5f87ec6a1fcb294a585d3979b37aebff822269013ca","85e3afcd6d926b86062b88e3966c6e39a13c38afea082d46ae59ec6258e7afc5","c839b950d61b83799030e9d7f4c14c00c98bff62175a6e635f85f50f62415cdb","83f7e0ab13f682768980c93ed95faba0d94ecee4ad33f87270d2c297944d1f48","892a4901edc5f348ea086e28f897be2aca0b9f15ea14cc26a4937b0337416433","25447444e8bb0f691088aecdeafeaa3319471f9c189346c0e40c4798f5a46e31","0f676c4b0ad05d74962907a2ee09b068752a6adec603e8dc995f7590efce435e","bd70e6fd6255e0a6a8e2979993edbb3c8a26247f3ba146a5ab157438404286ed","b2c99ea9a16b256a57371617ba249cc7739b1a1aa04c60d22dbaf1cdb9c9f789","0b8441680568f37d41d99de88c4c2a8923f58a70b7f4a1ae86e5e0357be39838","fd2bc361ae6e06c2fdc927a04b8bfaa75849452ae20823eaa0f376d71c4584a6","2409c0c38ce870bd77c27808df91a7dc015f6bdda40e43b00ddfc68ef6b71f26","f335db0e9991c5795bd1c4c822f5ed324f53a5b1a3525b48d7aaa06bac214d2a","08da71aa9f340560733e38153371eb03385141c6c3260b1c3f3005326a448da2","7aa509a0d250c69300ba8aaee1e0a156347841a334d744e028906e0859f818d9","e8141955f2c2e7ccc6651e790bf0cdad186e4e39ba8a2cb02fd1600b56893391","7f0211b313121e06a7e50ad930c33746f35c20df23db8d4054b979ab0ad88830","4b6ff3371a9eb2a64ba0817b80c12ea0f4092ed2a65801e56e415e2f441ff263","2cb05358189787fd75f1bc21dc996a3951997abb68f91beab0e3835464478df9","96d006b4bd272d153bfd7278dea5936168fc500d5847fd38e4b5b35fd304d1fb","d8cb2aebfa16ae1460c031f031c45b9161091cf31913af13eaf3b2b31fcfa8fd","13e4abba5b40e7a802297705d5febf0adf7714ce85386d6d44d310ea08c8db0b","9