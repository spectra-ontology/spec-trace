h_zero_based":29607},{"literal_text_all_w_t_and_m_t":"plmn-IdentityIndex","paragraph_zero_based":29608},{"literal_text_all_w_t_and_m_t":"Index of the PLMN or SNPN across the plmn-IdentityInfoList and npn-IdentityInfoList fields included in SIB1.","paragraph_zero_based":29609},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29610},{"literal_text_all_w_t_and_m_t":"–UE-TimersAndConstants","paragraph_zero_based":29611},{"literal_text_all_w_t_and_m_t":"The IE UE-TimersAndConstants contains timers and constants used by the UE in RRC_CONNECTED, RRC_INACTIVE and RRC_IDLE.","paragraph_zero_based":29612},{"literal_text_all_w_t_and_m_t":"UE-TimersAndConstants information element","paragraph_zero_based":29613},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29614},{"literal_text_all_w_t_and_m_t":"-- TAG-UE-TIMERSANDCONSTANTS-START","paragraph_zero_based":29615}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["4c6ab39e8c59c2eff6047ec1c4f7b604ef61415a02837c3ee529e9e329fd3671","da2e851d435a7d8b632bb8e1f11d4fcd603f6a3cc713ab0f79442e55a81251ec","e13029ea7101762dd6d03cb364d64445ede25b28ff0a2f17ab2890f90062dd0d","9af0be59f307596d9391988d662348f86a3f8909989669528c6920da739865d3","f7a3377ba32e254f8d5f4c2c111c2853b7f132a0e52f638595a5012a335ce037","d6f357af09dd1378d7baf990a03a8b6e05aca2efea57531e982b4149b12308f1","07e435ff191cd389dd9e96243ece659b5a78b96a4c053144ab97280fbea15082","6e7ddf44175f6e009479ba1634ced93e80dfa820b132ed289ac7d1bbae5afb64","dd74999d202666b4fa7797402c1fdab8a8809d0631905a8753dfa2c97ca6558c","6ccaece52c9cf4fa84ca3e76a1dea86d4527f5e883206f550e26f0232446b6c5","0076905599047014748ed3619bd917d2c9dcc01f2df362619e3312ce864faf9f","e66602bebae14b7