{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5>if the useAutonomousGaps is included in the reportConfig associated with this measId:","paragraph_zero_based":4344},{"literal_text_all_w_t_and_m_t":"6>if the UE is a RedCap UE with 1 Rx branch","paragraph_zero_based":4345},{"literal_text_all_w_t_and_m_t":"7>start timer T321 with the timer value set to 3 seconds for this measId;","paragraph_zero_based":4346},{"literal_text_all_w_t_and_m_t":"6>else","paragraph_zero_based":4347},{"literal_text_all_w_t_and_m_t":"7>start timer T321 with the timer value set to 2 seconds for this measId;","paragraph_zero_based":4348},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":4349},{"literal_text_all_w_t_and_m_t":"6>start timer T321 with the timer value set to 2 seconds for this measId;","paragraph_zero_based":4350},{"literal_text_all_w_t_and_m_t":"4>if the measObject associated with this measId concerns FR2:","paragraph_zero_based":4351},{"literal_text_all_w_t_and_m_t":"5>if the useAutonomousGaps is included in the reportConfig associated with this measId:","paragraph_zero_based":4352},{"literal_text_all_w_t_and_m_t":"6>if the UE is a RedCap UE with 1 Rx branch","paragraph_zero_based":4353},{"literal_text_all_w_t_and_m_t":"7>start timer T321 with the timer value set to 6 seconds for this measId;","paragraph_zero_based":4354},{"literal_text_all_w_t_and_m_t":"6>else","paragraph_zero_based":4355},{"literal_text_all_w_t_and_m_t":"7>start timer T321 with the timer value set to 5 seconds for this measId;","paragraph_zero_based":4356},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":4357},{"literal_text_all_w_t_and_m_t":"6>start timer T321 with the timer value set to 16 seconds for this measId.","paragraph_zero_based":4358},{"literal_text_all_w_t_and_m_t":"2>if the reportType is set to reportSFTD in the reportConfigNR associated with this measId and the drx-SFTD-NeighMeas is included:","paragraph_zero_based":4359},{"literal_text_all_w_t_and_m_t":"3>if the measObject associated with this measId concerns FR1:","paragraph_zero_based":4360},{"literal_text_all_w_t_and_m_t":"4>start timer T322 with the timer value set to 3 seconds for this measId;","paragraph_zero_based":4361},{"literal_text_all_w_t_and_m_t":"3>if the measObject associated with this measId concerns FR2:","paragraph_zero_based":4362},{"literal_text_all_w_t_and_m_t":"4>start timer T322 with the timer value set to 24 seconds for this measId.","paragraph_zero_based":4363},{"literal_text_all_w_t_and_m_t":"5.5.2.4Measurement object removal","paragraph_zero_based":4364},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":4365},{"literal_text_all_w_t_and_m_t":"1>for each measObjectId included in the received measObjectToRemoveList that is part of measObjectList in VarMeasConfig:","paragraph_zero_based":4366},{"literal_text_all_w_t_and_m_t":"2>remove the entry with the matching measObjectId from the measObjectList within the VarMeasConfig;","paragraph_zero_based":4367}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["d85cc6e03550e769ff9e712ed2c988a99ffce9302c1c3668a827239431e03631","5377ff2c938da5709ef213057a8fce60e3a70e6137296ee68ba285cca7be976f","2d1b743aaff52908282c34372a788f01dd91fd4193a1bec53fce9aa84813aecf","d271b760e675da7ce74bb3ccebf2d70f94f521a89cfa3571f6ffe1c18dffb266","b493fb338875730281e811ccc1e1665e02d7cada7376bfa294a151f6d57f3b0d","1befede0b43226df3053f7ff1d2bf86940d01763610b9619df805fdcf73cffd9","628cd9c69c68b22d32f49668dd35d9c3c46064defe18d75954dac6dab9a4ef4c","83782cc9b052d283090022f78300a5