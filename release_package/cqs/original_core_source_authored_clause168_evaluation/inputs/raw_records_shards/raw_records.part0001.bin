ph_zero_based":22958},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22959},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22960},{"literal_text_all_w_t_and_m_t":"MPE-Config-FR2-r16 ::=              SEQUENCE {","paragraph_zero_based":22961},{"literal_text_all_w_t_and_m_t":"    mpe-ProhibitTimer-r16               ENUMERATED {sf0, sf10, sf20, sf50, sf100, sf200, sf500, sf1000},","paragraph_zero_based":22962},{"literal_text_all_w_t_and_m_t":"    mpe-Threshold-r16                   ENUMERATED {dB3, dB6, dB9, dB12}","paragraph_zero_based":22963},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22964},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22965},{"literal_text_all_w_t_and_m_t":"MPE-Config-FR2-r17 ::=              SEQUENCE {","paragraph_zero_based":22966},{"literal_text_all_w_t_and_m_t":"    mpe-ProhibitTimer-r17               ENUMERATED {sf0, sf10, sf20, sf50, sf100, sf200, sf500, sf1000},","paragraph_zero_based":22967}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["80f95bf8b6062e03f595d405c1ce9f21700391d44787fd958183b93f88d7351d","7a3dafd2c9f628114e2b5d5d26f598cb634c763076bc3b75d769fab21f350cf2","4e3c2ddc1c8333937748e520ae995211bf69c61ac7894016e4a2d2375b2a4f6f","bc9420eb2b33d9f12476768512eb49c3e3ed7ccfa5a8c6703bb20b1f59fe4310","d06037931c3893cd25009c48902d3eafd7c305f1029d961c5a189b51584b2c6b","f4b15b84bfebc6bfcab9e4dc1b80e08eddce6e4f517aa30b41ad5e2881efce2b","39500d9c1d35710af7bc73933c288fce31dd4d944b5a0b3305911d05c3d0117a","3617b4bf5ca80b3e2cd282405c03a7a5145ee6062cde3293adb647a2ec85701f","e50f93356580ebb6430f65e8099fc8108ab4bfdc8fbd1987872eff29829aed29","cd1023f1c0321c3e9b7df93cdedc5a68459a4e442c5d2501f4a05afbf803d6