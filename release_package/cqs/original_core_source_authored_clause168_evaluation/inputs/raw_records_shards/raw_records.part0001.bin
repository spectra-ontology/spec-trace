{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Frequency domain density for the 1-port CSI-RS for L3 mobility. See TS 38.211 [16], clause 7.4.1.","paragraph_zero_based":17376},{"literal_text_all_w_t_and_m_t":"nrofPRBs","paragraph_zero_based":17377},{"literal_text_all_w_t_and_m_t":"Allowed size of the measurement BW in PRBs. See TS 38.211 [16], clause 7.4.1.","paragraph_zero_based":17378},{"literal_text_all_w_t_and_m_t":"startPRB","paragraph_zero_based":17379},{"literal_text_all_w_t_and_m_t":"Starting PRB index of the measurement bandwidth. See TS 38.211 [16], clause 7.4.1.","paragraph_zero_based":17380},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17381},{"literal_text_all_w_t_and_m_t":"CSI-RS-ResourceConfigMobility field descriptions","paragraph_zero_based":17382},{"literal_text_all_w_t_and_m_t":"csi-RS-CellList-Mobility","paragraph_zero_based":17383},{"literal_text_all_w_t_and_m_t":"List of cells for CSI-RS based RRM measurements.","paragraph_zero_based":17384},{"literal_text_all_w_t_and_m_t":"refServCellIndex","paragraph_zero_based":17385},{"literal_text_all_w_t_and_m_t":"Indicates the serving cell providing the timing reference for CSI-RS resources without associatedSSB. The field may be present only if there is at least one CSI-RS resource configured without associatedSSB. If this field is absent, the UE shall use the timing of the PCell for measurements on the CSI-RS resources without associatedSSB. The CSI-RS resources and the serving cell indicated by refServCellIndex for timing reference should be located in the same band.","paragraph_zero_based":17386},{"literal_text_all_w_t_and_m_t":"subcarrierSpacing","paragraph_zero_based":17387},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing of CSI-RS.","paragraph_zero_based":17388},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":17389},{"literal_text_all_w_t_and_m_t":"FR1:    15, 30, or 60 kHz","paragraph_zero_based":17390},{"literal_text_all_w_t_and_m_t":"FR2-1:  60 or 120 kHz","paragraph_zero_based":17391},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":17392},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17393},{"literal_text_all_w_t_and_m_t":"CSI-RS-Resource-Mobility field descriptions","paragraph_zero_based":17394},{"literal_text_all_w_t_and_m_t":"associatedSSB","paragraph_zero_based":17395},{"literal_text_all_w_t_and_m_t":"If this field is present, the UE may base the timing of the CSI-RS resource indicated in CSI-RS-Resource-Mobility on the timing of the cell indicated by the cellId in the CSI-RS-CellMobility. In this case, the UE is not required to monitor that CSI-RS resource if the UE cannot detect the SS/PBCH block indicated by this associatedSSB and cellId. If this field is absent, the UE shall base the timing of the CSI-RS resource indicated in CSI-RS-Resource-Mobility on the timing of the serving cell indicated by refServCellIndex. In this case, the UE is required to measure the CSI-RS resource even if SS/PBCH block(s) with cellId in the CSI-RS-CellMobility are not detected.","paragraph_zero_based":17396},{"literal_text_all_w_t_and_m_t":"CSI-RS resources with and without associatedSSB may be configured in accordance with the rules in TS 38.214 [19], clause 5.1.6.1.3.","paragraph_zero_based":17397},{"literal_text_all_w_t_and_m_t":"csi-RS-Index","paragraph_zero_based":17398},{"literal_text_all_w_t_and_m_t":"CSI-RS resource index associated to the CSI-RS resource to be measured (and used for reporting).","paragraph_zero_based":17399}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["3a69a2019b4ee13d0204c42af197513f62dd2581416e79d928bfa76c3a9ea1d0","4da69dd226785bd9faea294cccacd4066f1ea482a211641f8e57d08461cf329b","b4c38ebaeb87abbf40bf79763f0e0a6c659af981ebb3c08f8213bd3664eda1c1","1aff19a082f8199f7f1d31137ef79b58c7c60357b02d99b9e8870c34da548de8","fe2c89e4dd07ae535156e59c90910c2ab34211a7bad7daad6269000015c3f2d5","51bf899e9e91ab810ba8a8bc97771367241de61506874cbb90b8117307911ac0","432626a07708505bc32ee28229dfe55ae8bb7503f332739231c011b89177910f","5b46ff04a65f19dc05a78123dbd491ceee5d57a3479ef1d68cdcb8db8bb73e51","b1e6cc739a92cc470cf4c69580a20d699433f1840808c2f9d6269ca8a5e611da","4d351b38c5eb31065731276648343a9b4e334f8651731ffd1001d5f6ab67f152","0e4a0dc0e231f61fdf46078800b9ea523a033c4a1a50b7c112d798f3be7bd98c","fdd936a5a3fca5607bf37b8efe6ce65fb30356d3baf08963de86ace878434c61","f886baaa363a2b269ba07441234794ecc1c4a174d1051c30b7dc1f78f59cc8b8","58434798d7c794b0ff147867770bb816d729b2463f4cebfd6a83a7015906ad4d","f294ca0a26eacd7b295ee2e8398cf5c437513b7ae39a846277a8ebe0028a03b9","b93040ba163d5c576f3eed3b11301daf3909b4aef33b6e05953fd2272b0ca3b4","50b4c2584e441308265be3691507a9f5c417398d8e18bd39034c681eb703e0c8","4efd3b869475d0c3816fc0c4002f34227b9bd9a6c7cd07410fb7599e9be706fe","c5e22a4758fb905ede22f48e40d514cf5713b8cd12f2de1eebf6e057b29a6974","2eca30e3a828b6cc31185448346af40febc7089c95d61b86075eb7fdbac56c49","dd5e170c6de7aa25e9ebc071970851145a47d410cb47e03f35df0c1ad0653abe","4b587995707e036dfde3934977d1697b8bcb5fcbaf004a767c6c351b0ec45eed","ebec432f93f18f98f224b5d13a525b93b21e6eabfa7280caeeffd556366739c4","dc3510f9bd4f3f1a87876311fadc01bb80a3c93797521ce6f59092c4019f16f0"],"paragraph_range_zero_based":[17376,17399],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p17376"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"firstOFDMSymbolInTimeDomain","paragraph_zero_based":17400},{"literal_text_all_w_t_and_m_t":"Time domain allocation within a physical resource block. The field indicates the first OFDM symbol in the PRB used for CSI-RS, see TS 38.211 [16], clause 7.4.1.5.3.","paragraph_zero_based":17401},{"literal_text_all_w_t_and_m_t":"frequencyDomainAllocation","paragraph_zero_based":17402},{"literal_text_all_w_t_and_m_t":"Frequency domain allocation within a physical resource block in accordance with TS 38.211 [16], clause 7.4.1.5.3 including table 7.4.1.5.2-1. The number of bits that may be set to one depend on the chosen row in that table.","paragraph_zero_based":17403},{"literal_text_all_w_t_and_m_t":"isQuasiColocated","paragraph_zero_based":17404},{"literal_text_all_w_t_and_m_t":"Indicates that the CSI-RS resource is quasi co-located with the associated SS/PBCH block, see TS 38.214 [19], clause 5.1.6.1.3.","paragraph_zero_based":17405},{"literal_text_all_w_t_and_m_t":"sequenceGenerationConfig","paragraph_zero_based":17406},{"literal_text_all_w_t_and_m_t":"Scrambling ID for CSI-RS (see TS 38.211 [16], clause 7.4.1.5.2).","paragraph_zero_based":17407},{"literal_text_all_w_t_and_m_t":"slotConfig","paragraph_zero_based":17408},{"literal_text_all_w_t_and_m_t":"Indicates the CSI-RS periodicity (in milliseconds) and for each periodicity the offset (in number of slots). When subcarrierSpacing is set to kHz15, the maximum offset values for periodicities ms4/ms5/ms10/ms20/ms40 are 3/4/9/19/39 slots. When subcarrierSpacing is set to kHz30, the maximum offset values for periodicities ms4/ms5/ms10/ms20/ms40 are 7/9/19/39/79 slots. When subcarrierSpacing is set to kHz60, the maximum offset values for periodicities ms4/ms5/ms10/ms20/ms40 are 15/19/39/79/159 slots. When subcarrierSpacing is set kHz120, the maximum offset values for periodicities ms4/ms5/ms10/ms20/ms40 are 31/39/79/159/319 slots. When subcarrierSpacing is set to kHz480, the maximum offset values for periodicities ms4/ms5/ms10/ms20/ms40 are 127/159/319/639/1279 slots. When subcarrierSpacing is set to kHz960, the maximum offset values for periodicities ms4/ms5/ms10/ms20/ms40 are 255/319/639/1279/2559 slots. If slotConfig-r17 is present, UE shall ignore the slotConfig (without suffix).","paragraph_zero_based":17409},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17410},{"literal_text_all_w_t_and_m_t":"–CSI-RS-ResourceMapping","paragraph_zero_based":17411},{"literal_text_all_w_t_and_m_t":"The IE CSI-RS-ResourceMapping is used to configure the resource element mapping of a CSI-RS resource in time- and frequency domain.","paragraph_zero_based":17412},{"literal_text_all_w_t_and_m_t":"CSI-RS-ResourceMapping information element","paragraph_zero_based":17413},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17414},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-RS-RESOURCEMAPPING-START","paragraph_zero_based":17415},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17416},{"literal_text_all_w_t_and_m_t":"CSI-RS-ResourceMapping ::=          SEQUENCE {","paragraph_zero_based":17417},{"literal_text_all_w_t_and_m_t":"    frequencyDomainAllocation           CHOICE {","paragraph_zero_based":17418},{"literal_text_all_w_t_and_m_t":"        row1                                BIT STRING (SIZE (4)),","paragraph_zero_based":17419},{"literal_text_all_w_t_and_m_t":"        row2                                BIT STRING (SIZE (12)),","paragraph_zero_based":17420},{"literal_text_all_w_t_and_m_t":"        row4                                BIT STRING (SIZE (3)),","paragraph_zero_based":17421},{"literal_text_all_w_t_and_m_t":"        other                               BIT STRING (SIZE (6))","paragraph_zero_based":17422},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":17423}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["7d0316138a7140e8d53c9b7fc2119fc1dde626cfc0e9e61afad6971e97bef28e","250a6ebaaab582ff2a0266c089f142ca1e9b3624256d159daac3169597532fd1","015a9b88409cd29b4a833601bec9693be20cbbb8896c437353eab5677c5c1712","54d485c0b864e9d7a214e55435c08c1bc8bf5d11ba750effcb2fdaf938c3c53d","954cedbb20935a03f64e4f0ec45ec671a04a4557fdbba94ab84ddb136bfc044d","c4b051332b968b7d3eb061c4d2f47fe401adcea777ca6a750a2455c7b244d847","c39a04db9f53ebda82287ecd12ced7e4b8275817cd8fc16d30236bbc2a511c1c","39b3468a5f9af55015ed2d54bb748d2507fba8da3d2817d5a03659e0e6679c72","ab6130ecba773266e52ecbf799d678b17a5e0d0745bed285f6e744d51d1c3911","af26ccfe70f6130b907696174e02dc362ef4d87cbf298f4bd370175bba001f49","fe97683aa7e9bdbfc05c821beab7ba92bfae1bbf6a00de14ed1d35fe6aaff3a7","a893db79bb1329b9a8c56df95e855edddcfa522739e0a18ea4cfe2d396df4136","1e4bf4834618e23308495395d62af9635c9e2a14a2c61ecf08c25e8babf5411a","87faf9b92255df3fe573841890166141c7822207253ad045029dbf66318afafe","3d6e70abd8833a06c55b7c1c7fc44d030f6918e5534fe0a6bddf8ebbc29181aa","4af4a68808f4ffc0b1e260279c1d5697f67e986db6a033b7480866e0e19345cb","23bc94eb24ba14a0415dd16280e005912f7fba1e40c2d2cfd1e7375f7af8f2d3","5be04a71e30bdd87832e8c56832e5917567b0c7aa66da4d530e97ab3273a8c53","85079c2838f6d2428d5f85c568bc690217a7d5b696c3ddac079c9c6be907aa23","6f50cd76a2cba42377ca9500f4f9e37da296c49992d6a7de05ec281a1bec2f8b","39d84a921971d3437f1f19f053c98cd623ae9bc7d564dafe544b080ae83fb233","3e36b9b34c818c2df107a17257a508b49bbf548725d8aa18b062d6d63c60611c","70d457c6ff6eb4923af081e3682cf864f91dc536c17337cb9de292d308a1ad81","4cd07cf45b3eaeb3a84c40ccdba868b9bdf183e1a4f918504fef7746aa18faf8"],"paragraph_range_zero_ba