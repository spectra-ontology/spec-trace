{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41016},{"literal_text_all_w_t_and_m_t":"7.4UE variables","paragraph_zero_based":41017},{"literal_text_all_w_t_and_m_t":"NOTE:To facilitate the specification of the UE behavioural requirements, UE variables are represented using ASN.1. Unless explicitly specified otherwise, it is however up to UE implementation how to store the variables. The optionality of the IEs in ASN.1 is used only to indicate that the values may not always be available.","paragraph_zero_based":41018},{"literal_text_all_w_t_and_m_t":"–NR-UE-Variables","paragraph_zero_based":41019},{"literal_text_all_w_t_and_m_t":"This ASN.1 segment is the start of the NR UE variable definitions.","paragraph_zero_based":41020},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":41021},{"literal_text_all_w_t_and_m_t":"-- NR-UE-VARIABLES-START","paragraph_zero_based":41022},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41023},{"literal_text_all_w_t_and_m_t":"NR-UE-Variables DEFINITIONS AUTOMATIC TAGS ::=","paragraph_zero_based":41024},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41025},{"literal_text_all_w_t_and_m_t":"BEGIN","paragraph_zero_based":41026},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41027},{"literal_text_all_w_t_and_m_t":"IMPORTS","paragraph_zero_based":41028},{"literal_text_all_w_t_and_m_t":"    AreaConfiguration-v1700,","paragraph_zero_based":41029},{"literal_text_all_w_t_and_m_t":"    ARFCN-ValueNR,","paragraph_zero_based":41030},{"literal_text_all_w_t_and_m_t":"    CellIdentity,","paragraph_zero_based":41031},{"literal_text_all_w_t_and_m_t":"    EUTRA-PhysCellId,","paragraph_zero_based":41032},{"literal_text_all_w_t_and_m_t":"    maxCEFReport-r17,","paragraph_zero_based":41033},{"literal_text_all_w_t_and_m_t":"    MeasId,","paragraph_zero_based":41034},{"literal_text_all_w_t_and_m_t":"    MeasIdToAddModList,","paragraph_zero_based":41035},{"literal_text_all_w_t_and_m_t":"    MeasIdleCarrierEUTRA-r16,","paragraph_zero_based":41036},{"literal_text_all_w_t_and_m_t":"    MeasIdleCarrierNR-r16,","paragraph_zero_based":41037},{"literal_text_all_w_t_and_m_t":"    MeasResultIdleEUTRA-r16,","paragraph_zero_based":41038},{"literal_text_all_w_t_and_m_t":"    MeasResultIdleNR-r16,","paragraph_zero_based":41039}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["3cbe16c9a408ab575572eb31b16c9611675dfc8c65d1dd0f42a3b71bf7ede4ae","5a88979ebc0e46a7efac722e165a7b63017f6bd8f36d86288b1457a06b1ad892","b01428f1665ae10ba81c83175ed58d7608cbb6cb5612ac73c647aec78e343c0c","36c8c5cf5e5f8fc704425e09444ccfc6ed98a6ed66dabf54661cfe4b37ad75c6","80edc205735ef2b3ff054e0599d46b65ab7acbf1973b192b75bc9376450ef099","b89a324a1963472496e48e3db686b56c72410a21c922eab16baa4b77351a2e30","011ffe5955beec72b4176a82eec4abc7321141abf8c5afa2eee3a84619e560e0","5e62a7b15364b01c231fb16a4174b282b3edf81c220dee1e8e56d2b2d7485c16","41d3be4fac42a94a3d27055ccb7b9d93382a04cb1bc404f3fc84aa2dc72a94f8","dc26068ce4d04cc459996352e0b8ba10eb896df91ceb29657eaa1fce9ef34e61","6eea604c289721b7b9ee69484cfa9b3261d2c165fa044831a18ade89d92dbde0","99dc401356b2b1e0c857560f7b63a7109f0ff006c49085e6748c274a670d1b67","47d0617f1121068c9fd5be133a1488d6ec8a05e8bdceed78974bf80e81e1fd81","c794ea281c670af25ec308159cbe63a45632515c2725af5300be342105ca5c09","eb408b3e9aae4691f535e968331719234426a30178e849f18fa1d5811aa54dc6","c2a922870d4053faadb862f92a28f7933c279c981f24afc75f80153183d9bfc6","008d6c31883c6ba3a3b95710b3a4c655754691a0c7f3dbc35ec50d8ddab11f5e","e6144b2664a13