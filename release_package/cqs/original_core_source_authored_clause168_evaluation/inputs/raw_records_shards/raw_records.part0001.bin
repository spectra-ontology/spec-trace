{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"dl-SchedulingOffset-PDSCH-TypeB-TDD-FR2","paragraph_zero_based":43824},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports DL scheduling slot offset (K0) greater than 0 for PDSCH mapping type B in TDD FR2.","paragraph_zero_based":43825},{"literal_text_all_w_t_and_m_t":"halfDuplexFDD-TypeA-RedCap","paragraph_zero_based":43826},{"literal_text_all_w_t_and_m_t":"Indicates whether the RedCap UE only supports half-duplex operation for FDD in the indicated band(s).","paragraph_zero_based":43827},{"literal_text_all_w_t_and_m_t":"inactiveStatePO-Determination","paragraph_zero_based":43828},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports to use the same i_s to determine PO in RRC_INACTIVE state as in RRC_IDLE state.","paragraph_zero_based":43829},{"literal_text_all_w_t_and_m_t":"numberOfRxRedCap","paragraph_zero_based":43830},{"literal_text_all_w_t_and_m_t":"Indicates the number of Rx branches supported by a RedCap UE.","paragraph_zero_based":43831},{"literal_text_all_w_t_and_m_t":"ue-RadioPagingInfo","paragraph_zero_based":43832},{"literal_text_all_w_t_and_m_t":"The field is used to transfer UE capability information used for paging. The gNB generates the ue-RadioPagingInfo and the contained UE capability information is absent when not supported by the UE.","paragraph_zero_based":43833},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43834},{"literal_text_all_w_t_and_m_t":"–UERadioAccessCapabilityInformation","paragraph_zero_based":43835},{"literal_text_all_w_t_and_m_t":"This message is used to transfer UE radio access capability information, covering both upload to and download from the 5GC.","paragraph_zero_based":43836},{"literal_text_all_w_t_and_m_t":"Direction: ng-eNB or gNB to/ from 5GC","paragraph_zero_based":43837},{"literal_text_all_w_t_and_m_t":"UERadioAccessCapabilityInformation message","paragraph_zero_based":43838},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":43839},{"literal_text_all_w_t_and_m_t":"-- TAG-UE-RADIO-ACCESS-CAPABILITY-INFORMATION-START","paragraph_zero_based":43840},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43841},{"literal_text_all_w_t_and_m_t":"UERadioAccessCapabilityInformation ::= SEQUENCE {","paragraph_zero_based":43842},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                  CHOICE {","paragraph_zero_based":43843},{"literal_text_all_w_t_and_m_t":"        c1                                  CHOICE{","paragraph_zero_based":43844},{"literal_text_all_w_t_and_m_t":"            ueRadioAccessCapabilityInformation    UERadioAccessCapabilityInformation-IEs,","paragraph_zero_based":43845},{"literal_text_all_w_t_and_m_t":"            spare7 NULL,","paragraph_zero_based":43846},{"literal_text_all_w_t_and_m_t":"            spare6 NULL, spare5 NULL, spare4 NULL,","paragraph_zero_based":43847}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["271702c3bff12f548f9690c0f90cd93ff3885afdd479088239caccb7a17d0ee1","2c1ced7518fdc02114fee2a0f226059c037dfdd5be2d5f3423f1ebb3c6ec69dc","7d7437ce84030f97af6d0fd465441404c66453479309cdf984b043945cbcdb7d","400e78435c7dccf49bdf2575beda1f623c622e244f2a6d7417c6fa8cbe70de46","581a63c7bccce050f67f4faa5a362a7208ad2027ef8702df213981f7f4cadcad","aca17e59274e70a9592d6f1e9ca810a501d6e3444f0d061ffd380a2ca16cf7aa","9c754722ad34c397ab5f62122da55b61e34fdb02f25990399aca9b099b7ceedc","269a18138fc40a991e4891b3768617be72449008129346dd8ecd9e8a4389afcb","a2a8d5eec1773951c0f1da1b0653e15405cf8223bb966d00f1f0