{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SL-CBR-PriorityTxConfigList-v1650","paragraph_zero_based":37704},{"literal_text_all_w_t_and_m_t":"If included, it includes the same number of entries, and listed in the same order, as in SL-CBR-PriorityTxConfigList-r16.","paragraph_zero_based":37705},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37706},{"literal_text_all_w_t_and_m_t":"–SL-CBR-CommonTxConfigList","paragraph_zero_based":37707},{"literal_text_all_w_t_and_m_t":"The IE SL-CBR-CommonTxConfigList indicates the list of PSSCH transmission parameters (such as MCS, sub-channel number, retransmission number, CR limit) in sl-CBR-PSSCH-TxConfigList, and the list of CBR ranges in sl-CBR-RangeConfigList, to configure congestion control to the UE for sidelink communication.","paragraph_zero_based":37708},{"literal_text_all_w_t_and_m_t":"SL-CBR-CommonTxConfigList information element","paragraph_zero_based":37709},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":37710},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-CBR-COMMONTXCONFIGLIST-START","paragraph_zero_based":37711},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37712},{"literal_text_all_w_t_and_m_t":"SL-CBR-CommonTxConfigList-r16 ::=     SEQUENCE {","paragraph_zero_based":37713},{"literal_text_all_w_t_and_m_t":"    sl-CBR-RangeConfigList-r16            SEQUENCE (SIZE (1..maxCBR-Config-r16)) OF SL-CBR-LevelsConfig-r16     OPTIONAL,   -- Need M","paragraph_zero_based":37714},{"literal_text_all_w_t_and_m_t":"    sl-CBR-PSSCH-TxConfigList-r16         SEQUENCE (SIZE (1.. maxTxConfig-r16)) OF SL-CBR-PSSCH-TxConfig-r16    OPTIONAL    -- Need M","paragraph_zero_based":37715},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37716},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37717},{"literal_text_all_w_t_and_m_t":"S