{"fields":{"filename":"R2-2401316.zip::R2-2401316 BLE.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"BT-GenericArray-r18 ::= SEQUENCE (SIZE (2..maxBT-BeaconAntElt-r18)) OF BT-ULA-GenericAntElement-r18","paragraph_zero_based":744},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":745},{"literal_text_all_w_t_and_m_t":"BT-ULA-GenericAntElement-r18 ::= SEQUENCE {","paragraph_zero_based":746},{"literal_text_all_w_t_and_m_t":"deltaY-r18INTEGER (-135..135)OPTIONAL,-- Need OP","paragraph_zero_based":747},{"literal_text_all_w_t_and_m_t":"deltaX-r18INTEGER (-135..135)OPTIONAL,-- Need OP","paragraph_zero_based":748},{"literal_text_all_w_t_and_m_t":"deltaZ-r18INTEGER (-135..135)OPTIONAL-- Need OP","paragraph_zero_based":749},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":750},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":751},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":752},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":753},{"literal_text_all_w_t_and_m_t":"BT-GenericArray field descriptions","paragraph_zero_based":754},{"literal_text_all_w_t_and_m_t":"deltaX, deltaY, deltaZ","paragraph_zero_based":755},{"literal_text_all_w_t_and_m_t":"This field specifies the antenna element location offset in X, Y, Z directions respectively. If not present, the delta is zero. Scale factor 1mm.","paragraph_zero_based":756},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":757},{"literal_text_all_w_t_and_m_t":"6.5.7.9Bluetooth Assistance Data Request","paragraph_zero_based":758},{"literal_text_all_w_t_and_m_t":"–BT-RequestAssistanceData","paragraph_zero_based":759},{"literal_text_all_w_t_and_m_t":"The IE BT-RequestAssistanceData is used by the target device to request BT assistance data from a location server.","paragraph_zero_based":760},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":761},{"literal_text_all_w_t_and