nabled}                                                 OPTIONAL,   -- Need R","paragraph_zero_based":37845},{"literal_text_all_w_t_and_m_t":"    sl-OptionForCondition2-A-1-r17            INTEGER (0..1)                                                       OPTIONAL,   -- Need M","paragraph_zero_based":37846},{"literal_text_all_w_t_and_m_t":"    sl-IndicationUE-B-r17                     ENUMERATED {enabled, disabled}                                       OPTIONAL,   -- Need M","paragraph_zero_based":37847}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["f07c0d157deea958c658c627a29e9c4a7d811e523970d17bc024f076243e9160","756e55da0800950e4944dedcd54672fc6519303453709afda0a87e5d876f4e72","7da08f7ba0462fe5d3436ba9ce59a72f8669034fb89b5254dd64a7f87f588734","cd3f185da4a1bac13e2de89da70d444fc2fd18f4a1c2e2fa83169ddc2f378681","ef66108ade93319f18e292ecfb8e87b960b2a5539fd3f9f6d3126c3bc11375be","d094f9b4f30f691f37ef419732d09bbfe6349cf38c8e854e94ba01197008289a","c5f6065992d4cdb095e223b2c577416c6bcf4b0a6f9e177eb03ec5610a97095e","d6ab82cf40034664576a450d69c8f8f2c9202c58e2c50d883182877fc87c3dc1","6e7adde5c33288ae284694a115ece21175d98212cb7ec255c1ec8124af7dd003","c91fcf52ba704f79eb8f7bd3d90c79ecf3ab89d50a3c3233991c8cc911e64bde","c6af93797e347e49dbd4cb1a053814c023fd1a3c6f4fbd154a461643c314c31e","f11105d5e4a07800b3d04f69499ce55f4219b1a3232842364895f2c5fb6c1732","2617ed5f907a5538edd750f1748eca867c2bd1fba19618afa7c794fcf34cee37","d02cb45dddedc5836e9917115fe12f29e7fe596eb06594f8768d33fdc1bcea4f","2fa8b8f8fc580be8b00dab78fc5e24192087b3fe2de2c0d614e1205c347bbbba","b62811562ebd6ba59f45ac829a6831fe5710b0809a5032ae1cc6f5a308a8fedb","a3a0677c5d3897d2ce72d1681fc3b87c7a1a512ca03a73c30ea3bcc0b6987a0