{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"GroupBConfigured","paragraph_zero_based":21072},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if groupB-ConfiguredTwoStepRA is configured in RACH-ConfigCommonTwoStepRA, otherwise the field is absent.","paragraph_zero_based":21073},{"literal_text_all_w_t_and_m_t":"InitialBWPConfig","paragraph_zero_based":21074},{"literal_text_all_w_t_and_m_t":"The field is mandatory present when MsgA-ConfigCommon is configured for the initial uplink BWP, or when MsgA-ConfigCommon is configured for a non-initial uplink BWP and MsgA-ConfigCommon is not configured for the initial uplink BWP, otherwise the field is optionally present, Need S.","paragraph_zero_based":21075},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21076},{"literal_text_all_w_t_and_m_t":"–MultiFrequencyBandListNR","paragraph_zero_based":21077},{"literal_text_all_w_t_and_m_t":"The IE MultiFrequencyBandListNR is used to configure a list of one or multiple NR frequency bands.","paragraph_zero_based":21078},{"literal_text_all_w_t_and_m_t":"MultiFrequencyBandListNR information element","paragraph_zero_based":21079},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21080},{"literal_text_all_w_t_and_m_t":"-- TAG-MULTIFREQUENCYBANDLISTNR-START","paragraph_zero_based":21081},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21082},{"literal_text_all_w_t_and_m_t":"MultiFrequencyBandListNR ::=        SEQUENCE (SIZE (1..maxNrofMultiBands)) OF FreqBandIndicatorNR","paragraph_zero_based":21083},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21084},{"literal_text_all_w_t_and_m_t":"-- TAG-MULTIFREQUENCYBANDLISTNR-STOP","paragraph_zero_based":21085},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21086},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21087},{"literal_text_all_w_t_and_m_t":"–MultiFrequencyBandListNR-SIB","paragraph_zero_based":21088},{"literal_text_all_w_t_and_m_t":"The IE MultiFrequencyBandListNR-SIB indicates the list of frequency bands, for which cell (re-)selection parameters are common, and a list of additionalPmax and additionalSpectrumEmission.","paragraph_zero_based":21089},{"literal_text_all_w_t_and_m_t":"MultiFrequencyBandListNR-SIB information element","paragraph_zero_based":21090},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21091},{"literal_text_all_w_t_and_m_t":"-- TAG-MULTIFREQUENCYBANDLISTNR-SIB-START","paragraph_zero_based":21092},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21093},{"literal_text_all_w_t_and_m_t":"MultiFrequencyBandListNR-SIB ::=            SEQUENCE (SIZE (1.. maxNrofMultiBands)) OF NR-MultiBandInfo","paragraph_zero_based":21094},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21095}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["ef6c24709b57bd27f770673656dc7c8fa0d339b503e9de3f3cd7f3a443212e20","f8db458fa0f36e6434b53c4a479f624cfe7148b9232b0fe1baffb736ab7faa16","2a8ce64648efc1fe3b18ae485a75f8c4149442bf8747024eba97d56ec4195f8e","3ca998d61b2cf88cc0c82926d60a1527e77c23214dc3d5b08efecee6a49ceaf7","aa2b9ee96e9005fabfb2b5e2fe5702558293758c097a78a69e73844d2e489e07","3d051bc2e04c407aeb21bc583d809867e34452ff6f0d3fedce82998310c48425","60ae34811548a13dba4477930ce5fbdba779397bea1e51f9ea1a03428d7c7c89","57550e91b92a42221aad82b883a3f7873eca15cd3700865e11565b10e9e28142","3abd270c8973e442f3ba5aae2ac1e6e9a926982618d716c4c8ce6ea96cbb9e0d","32c27ebcc194e4249cf2a0da69c39f56208fce48cb4eab81e9bf89da26b4eea2","d430d50ff8e1a1b78521e0714025e009dc8313b564afe9fd95996e935f29249d","0e5c8d1018cf04ff60a0b08cc88cd0cf73b542ccf5396437b40aa822febfc38b","b410685381d4d62a3b150790d98f75afaad85daf6a5064bbf2ffc6feaee2859d","a05edd77276e48c423e0fb3ab1386fcca6388af547f2341eef81d35dbed41e83","2bc6c5ac086c364ebc177d2f08f72155616c3f614601bfbce7a02f6874220e20","3288889b67076935f1fdb8ca67dffc5e6034f0f38523fef1161094986330e832","707f69bfd2e9220200ab1077c89b837180b801db62048c533e9a18312e3b350b","f9c3d530be50b9e7b71fcaca436a4ba5716038dc97cc333b5455798eaa45975d","a58e9582938d4c7467009872321537eb262ef6b72450ff9572117be5b021fc1b","adacb5f62a7341d785d0797482e591d140bc3ba9e19ce02efc776c6ee71fe786","719b559991fe3ba73bf8fba046ec577940a0c415ba1beb0978486e28c194479e","4407c931ba5e751133ed1c6f6adcf791261d77ca356d3d0959ed7eadaa0b732a","61880c963e95b7921d4d903d7f6ca04a0ee951789e5219daded99af86c1b677c","0900e0d614c984e7908430b18cdf29b816f181a730bb55f0bea6833553e236a2"],"paragraph_range_zero_based":[21072,21095],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p21072"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"NR-MultiBandInfo ::=                        SEQUENCE {","paragraph_zero_based":21096},{"literal_text_all_w_t_and_m_t":"    freqBandIndicatorNR                         FreqBandIndicatorNR         OPTIONAL,   -- Cond OptULNotSIB2","paragraph_zero_based":21097},{"literal_text_all_w_t_and_m_t":"    nr-NS-PmaxList                              NR-NS-PmaxList              OPTIONAL    -- Need S","paragraph_zero_based":21098},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21099},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21100},{"literal_text_all_w_t_and_m_t":"MultiFrequencyBandListNR-SIB-v1760 ::=      SEQUENCE (SIZE (1.. maxNrofMultiBands)) OF NR-MultiBandInfo-v1760","paragraph_zero_based":21101},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21102},{"literal_text_all_w_t_and_m_t":"NR-MultiBandInfo-v1760 ::=                  SEQUENCE {","paragraph_zero_based":21103},{"literal_text_all_w_t_and_m_t":"    nr-NS-PmaxList-v1760                        NR-NS-PmaxList-v1760        OPTIONAL    -- Need S","paragraph_zero_based":21104},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21105},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21106},{"literal_text_all_w_t_and_m_t":"MultiFrequencyBandListNR-Aerial-SIB-r18 ::= SEQUENCE (SIZE (1.. maxNrofMultiBands)) OF NR-MultiBandInfoAerial-r18","paragraph_zero_based":21107},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21108},{"literal_text_all_w_t_and_m_t":"NR-MultiBandInfoAerial-r18 ::=              SEQUENCE {","paragraph_zero_based":21109},{"literal_text_all_w_t_and_m_t":"    freqBandIndicatorNR-Aerial-r18              FreqBandIndicatorNR         OPTIONAL,   -- Cond OptULNotSIB2","paragraph_zero_based":21110},{"literal_text_all_w_t_and_m_t":"    nr-NS-PmaxListAerial-r18                    NR-NS-PmaxListAerial-r18    OPTIONAL    -- Need S","paragraph_zero_based":21111},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21112},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21113},{"literal_text_all_w_t_and_m_t":"-- TAG-MULTIFREQUENCYBANDLISTNR-SIB-STOP","paragraph_zero_based":21114},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21115},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21116},{"literal_text_all_w_t_and_m_t":"NR-MultiBandInfo field descriptions","paragraph_zero_based":21117},{"literal_text_all_w_t_and_m_t":"freqBandIndicatorNR","paragraph_zero_based":21118},{"literal_text_all_w_t_and_m_t":"Provides an NR frequency band number as defined in TS 38.101-1 [15], TS 38.101-2 [39], table 5.2-1, and TS 38.101-5 [75], table 5.2.2-1.","paragraph_zero_based":21119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["c623dff9e8907fb274bf332b8906d9d3b692c2456387f753cba72cc8cf153c35","b90bcc1e4c5d59b8446e4555097712db37a5f1f968c3bc4d6ece6e23c82a1076","cf9ab1663dbbcf4be561d47b3bf9432b60f9c26e128891bdee53832a709fce4f","11685e643ca0ab798822be62560af4558140bc52b8338fff7c58eb9242c64d19","1e9c941beb86a71803c4fa48d8639f1e1fca76e2d832d800dd95be9c26e55e92","8a5770b71f30e3ef949d4ea5be818bd2094bf5080eefd516d8d2c4ca75be7cd2","03094d7e6598a7a1ad17bb9bec10b0988d965513cdc5629880bdf3ade2e92809","293d228a7a3b4b4c28fb93527109c66ab47afb316b3841df8d5ae36be1ada31a","990c67e9f286e29c988eddbd2fa0ea2f1af0bb9e30ccc4440ec2a45b9f05cf30","7788fe50e3590ef77ea1f60c51015a24aa7b88a5f59c23872bc474efa032e28b","89479a1a623b3aeb3e87a412953b488dcc380b89e677fc5ef01390402043bdf4","158445612d69a35d6f30d1a3a8bf1e6a5d764795f7f7285c4148452803d97f30","3133f4da906b41ee3362430e495c5d7b5b8fe761159dfe1f2bf4c9371801c133","57734be7468fa164e3eea1f6470febac9f00360cdaae6ea6f6f8e0693e02275f","7e009f99014e8c26f87b70262f0d5e06a2587a8a52150151c099aa64f6dfd23c","1312a286205df99b811b2a5292a67fd3cffc11b8075d91730fdca3a0761448a4","7416b4cfe9cbe6076f7771f79a81fba5650decbff9d398b7f62c8357229d01bf","021504c9de6a24397cb17f54b914d5dd428bdc1a3853db44b859a7bd25f098e9","348dde09f7b00ea3c6d92752a5fb8805e3571757ddc97271ed12343427c04259","68905708a4fca20f51ab04edc458b2b7b69b8a2033e6767bbe000f9e7400abe4","7e116cb19e31605d1a2ffe294f7a4a49463e949ed3c6189dbdec68e0e2c05041","230c1362df4b522bc7395ea6260393108ad07bd4fdc63856c13e36f8a5c4c7df","e805cacf26cc8c4897cbb16517c670a915efbb90124935c89c7b8ae905ca7dbf","88e27a88c794658b4dd8ffa4573ead37d3fef346501caeb70e2fd6584b0457c8"],"paragraph_range_zero_based":[21096,21119],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p21096"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"freqBandIndicatorNR-Aerial","paragraph_zero_based":21120},{"literal_text_all_w_t_and_m_t":"Provides an NR frequency band number for aerial UE(s), as defined in TS 38.101-1 [15], TS 38.101-2 [39], table 5.2-1, and TS 38.101-5 [75], table 5.2.2-1.","paragraph_zero_based":21121},{"literal_text_all_w_t_and_m_t":"nr-NS-PmaxList","paragraph_zero_based":21122},{"literal_text_all_w_t_and_m_t":"Provides a list of additionalPmax and additionalSpectrumEmission values. If the field is absent the UE uses value 0 for the additionalSpectrumEmission (see TS 38.101-1 [15] table 6.2.3.1-1A, TS 38.101-2 [39], table 6.2.3.1-2, and TS 38.101-5 [75], table 6.2.3.1-1A). This field is ignored by IAB-MT, the IAB-MT applies output power and emissions requirements, as specified in TS 38.174 [63]. If nr-NS-PmaxList-v1760 is present, it shall contain the same number of entries, listed in the same order as in nr-NS-PmaxList (without suffix).","paragraph_zero_based":21123},{"literal_text_all_w_t_and_m_t":"nr-NS-PmaxListAerial","paragraph_zero_based":21124},{"literal_text_all_w_t_and_m_t":"Provides a list of additionalPmax and additionalSpectrumEmission values for aerial UE(s). If the field is absent, the value indicated by the corresponding field within frequencyBandList for the corresponding NR frequency band number applies, if present. Otherwise (i.e. the field is not present for the corresponding NR frequency band number in any of the nr-NS-PmaxList, nr-NS-PmaxList-v1760 or nr-NS-PmaxListAerial), the UE uses value 0 for the additionalSpectrumEmission (see TS 38.101-1 [15] table 6.2.3.1-1A, TS 38.101-2 [39], table 6.2.3.1-2, and TS 38.101-5 [75], table 6.2.3.1-1A). This field is ignored by IAB-MT, the IAB-MT applies output power and emissions requirements, as specified in TS 38.174 [63].","paragraph_zero_based":21125},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21126},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":21127},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":21128},{"literal_text_all_w_t_and_m_t":"OptULNotSIB2","paragraph_zero_based":21129},{"literal_text_all_w_t_and_m_t":"The field is absent for SIB2 and is mandatory present in SIB4 and frequencyInfoDL-SIB. Otherwise, if the field is absent in frequencyInfoUL-SIB in UplinkConfigCommonSIB, the UE will use the frequency band indicated in frequencyInfoDL-SIB in DownlinkConfigCommonSIB.","paragraph_zero_based":21130},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21131},{"literal_text_all_w_t_and_m_t":"–MUSIM-GapConfig","paragraph_zero_based":21132},{"literal_text_all_w_t_and_m_t":"The IE MUSIM-GapConfig specifies the MUSIM gap configuration and controls setup/release of MUSIM gaps.","paragraph_zero_based":21133},{"literal_text_all_w_t_and_m_t":"MUSIM-GapConfig information element","paragraph_zero_based":21134},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21135},{"literal_text_all_w_t_and_m_t":"-- TAG-MUSIM-GAPCONFIG-START","paragraph_zero_based":21136},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21137},{"literal_text_all_w_t_and_m_t":"MUSIM-GapConfig-r17 ::=                  SEQUENCE {","paragraph_zero_based":21138},{"literal_text_all_w_t_and_m_t":"musim-GapToReleaseList-r17       SEQUENCE (SIZE (1..3)) OF MUSIM-GapId-r17               OPTIONAL, -- Need N","paragraph_zero_based":21139},{"literal_text_all_w_t_and_m_t":"musim-GapToAddModList-r17        SEQUENCE (SIZE (1..3)) OF MUSIM-Gap-r17             OPTIONAL, -- Need N","paragraph_zero_based":21140},{"literal_text_all_w_t_and_m_t":"musim-AperiodicGap-r17           MUSIM-GapInfo-r17                OPTIONAL, -- Need N","paragraph_zero_based":21141},{"literal_text_all_w_t_and_m_t":"   ...","paragraph_zero_based":21142},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["3dd04368631bad3ae3a685fb21027ece21c5e1bdd09f4d3b78e9605598513c77","03c510c1cb4114163367a6e95d58de2d3d6b8d725c8256f53d3bd0dcdf11cce0","2b1065955604338043ab2b000482192ebb2e5b83bf87e352f60b0333356b03da","a841173e1e6635c484cbd905317e34dc680384c3408ac74e6726473c8d32eff4","bbec98a2c735a52d3cd3107e8bec69121c6ff76783088a6bfb2a379b6381e5f8","5ee7ff654d881853b61949b433db07cd98ae54aac00a46cc6bdba67217d79cb8","b1b78f7e4ca67cf6e33147587cf445f04c6dfbc130f9cdb0a58ab0162fb9a750","0223a799c7fb72409efadc735c944f96c198d0a1b698b7902bec9cafaef98785","1acca6b9e1709a2a969a94a981698416ac735f43fbeaff9ba3f9d800aa643ca0","3bbe61fd94da86ffa9da6274f386e2715400ab5b801142c8c6498ead38530f09","b0e9f587c83c655e2fb8cea2e227618a1e4e106d5b48ec7ad832e0e9e98f9d7b","4dc4d46df820c03f17acbbee235b1d43b56b9dbff5d7b85e10b2e69041123319","40a45cbfad5285793e2f1f4ccc6e0d09f3434b14ee93925ca7798d12a6e6a79d","7fe3cbf8298b6710498d21d34b4039ed69f2285440e04bc7e3574921a520a26e","82373651f5c86c9ba32c17c4294bcf6d2ff9762592171b71f95d890404d40b98","2b35ef7b597a28d6db3233b9c477241f765aac2b91804d3a9209ff3e56642e3e","6fae023e883a90c6f3f41544043d14383fb2c55d451f70be4dd89461b5c951e2","45180c1f28c63483d1f39eca2741212568bf9cda3a1c546cbfd88d0c27d01c8a","c8ca7a4fe43d050fad9b2b41325d32ab8d803cdcc7a749204961d1f948109dfc","e058e400776a9f56f27b748350d37b09076c772a079bf8b26c9bec6ac5a16df8","ca66905520f7a258734fb7df4c9133ef5032826c85ee9319c0644c4041f51159","eb4d920abc2386911915e9ff3ebcc0a5e3502b9d1748e4b79907c042d3b53dbd","7169ca0f64c73d80a64e248fca99e05024c8609e2cd75ed3cc1e3d3e50f6a643","46c650183c128b75a0961be4387bee6d14ab90911715d8e74c5c2f9cd6dd3922"],"paragraph_range_zero_based":[21120,21143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p21120"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"MUSIM-Gap-r17 ::=          SEQUENCE {","paragraph_zero_based":21144},{"literal_text_all_w_t_and_m_t":"    musim-GapId-r17                        MUSIM-GapId-r17,","paragraph_zero_based":21145},{"literal_text_all_w_t_and_m_t":"    musim-GapInfo-r17                      MUSIM-GapInfo-r17","paragraph_zero_based":21146},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21147},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21148},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21149},{"literal_text_all_w_t_and_m_t":"-- TAG-MUSIM-GAPCONFIG-STOP","paragraph_zero_based":21150},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21151},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21152},{"literal_text_all_w_t_and_m_t":"MUSIM-GapConfig field descriptions","paragraph_zero_based":21153},{"literal_text_all_w_t_and_m_t":"musim-AperiodicGap","paragraph_zero_based":21154},{"literal_text_all_w_t_and_m_t":"Indicates the MUSIM aperiodic gap as specified in TS 38.133 [14] clause 9.1.10. If UE indicates the musim-Starting-SFN-AndSubframe when requesting aperiodic gap the network can only configure the aperiodic gap with the same start point or no aperiodic gap. If the field musim-Starting-SFN-AndSubframe is absent for aperiodic gap, network can configure any timing as the starting point for aperiodic gap or configure no aperiodic gap.","paragraph_zero_based":21155},{"literal_text_all_w_t_and_m_t":"musim-GapInfo","paragraph_zero_based":21156},{"literal_text_all_w_t_and_m_t":"Indicates the values for musim-GapLength and musim-GapRepetitionAndOffset. When network provides periodic gap, network always signals the musim-GapLength and musim-GapRepetitionAndOffset as indicated by the UE's preferred MUSIM gap configuration.","paragraph_zero_based":21157},{"literal_text_all_w_t_and_m_t":"musim-GapToAddModList","paragraph_zero_based":21158},{"literal_text_all_w_t_and_m_t":"List of MUSIM periodic gap patterns to add or modify.","paragraph_zero_based":21159},{"literal_text_all_w_t_and_m_t":"musim-GapToReleaseList","paragraph_zero_based":21160},{"literal_text_all_w_t_and_m_t":"List of MUSIM periodic gap patterns to release.","paragraph_zero_based":21161},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21162},{"literal_text_all_w_t_and_m_t":"–MUSIM-GapId","paragraph_zero_based":21163},{"literal_text_all_w_t_and_m_t":"The IE MUSIM-GapId is used to identify UE periodic MUSIM gap(s) to add, modify or release.","paragraph_zero_based":21164},{"literal_text_all_w_t_and_m_t":"MUSIM-GapId information element","paragraph_zero_based":21165},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21166},{"literal_text_all_w_t_and_m_t":"-- TAG-MUSIM-GAPID-START","paragraph_zero_based":21167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["07d6273ae70aeac36197e350bf26d140d3e63c44e25bd4177a82d2136437eb7c","54371210c3ae966fc0fd5cd313cb6635e6885df6d1c344dec42f182b6bf64c46","38f6bb5656def736218817fbb79731c249e72508683bb7646b68cf9d3c0fdc80","98102c67481bd50a8e9cfd587cf8ee50534d5fb54a908b4230dcd261a571fec5","ebf0b9e5f3ceddf267024e7f86f52441b3c445cf836488804eb437de8e6adebf","371ab27cf99b9a45f614b77cc5ef9c9df02552b886f4214925eddd132897af55","ba35cd102ee59781b1b3023be82a3b581e1b9f9da48744e183db03e8dd8f9b19","c710c34383dcb343da6280461012f6244b705f951cfd23d56f09a456627f8b56","fb1f138a1b19160474baef38291f8fad0e5a9b76299d2520d1b57eacabeea49f","0d075695ecf674c38f88a0f76cd71995e5d7c1d00be9d5719c589c02e38834d6","71ec