{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"PCI-Range field descriptions","paragraph_zero_based":21744},{"literal_text_all_w_t_and_m_t":"range","paragraph_zero_based":21745},{"literal_text_all_w_t_and_m_t":"Indicates the number of physical cell identities in the range (including start). Value n4 corresponds with 4, value n8 corresponds with 8 and so on. The UE shall apply value 1 in case the field is absent, in which case only the physical cell identity value indicated by start applies.","paragraph_zero_based":21746},{"literal_text_all_w_t_and_m_t":"start","paragraph_zero_based":21747},{"literal_text_all_w_t_and_m_t":"Indicates the lowest physical cell identity in the range.","paragraph_zero_based":21748},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21749},{"literal_text_all_w_t_and_m_t":"–PCI-RangeElement","paragraph_zero_based":21750},{"literal_text_all_w_t_and_m_t":"The IE PCI-RangeElement is used to define a PCI-Range as part of a list (e.g. AddMod list).","paragraph_zero_based":21751},{"literal_text_all_w_t_and_m_t":"PCI-RangeElement information element","paragraph_zero_based":21752},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21753},{"literal_text_all_w_t_and_m_t":"-- TAG-PCI-RANGEELEMENT-START","paragraph_zero_based":21754},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21755},{"literal_text_all_w_t_and_m_t":"PCI-RangeElement ::=                SEQUENCE {","paragraph_zero_based":21756},{"literal_text_all_w_t_and_m_t":"    pci-RangeIndex                      PCI-RangeIndex,","paragraph_zero_based":21757},{"literal_text_all_w_t_and_m_t":"    pci-Range                           PCI-Range","paragraph_zero_based":21758},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21759},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21760},{"literal_text_all_w_t_and_m_t":"-- TAG-PCI-RANGEELEMENT-STOP","paragraph_zero_based":21761},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21762},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21763},{"literal_text_all_w_t_and_m_t":"PCI-RangeElement field descriptions","paragraph_zero_based":21764},{"literal_text_all_w_t_and_m_t":"pci-Range","paragraph_zero_based":21765},{"literal_text_all_w_t_and_m_t":"Physical cell identity or a range of physical cell identities.","paragraph_zero_based":21766},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21767}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["069f90f8ab0aee810e5a283b78882c919fa4ef85fa3c7702191747da9d3c1db8","31ec34cb3eaebf50a83318e1f75d0bf4e11f2dbfa9ee4172f1ef169ff59d8d09","12de81e6e161527f0c4b839425b46f0b99b1ca38b3634ab963156a5e6073f954","4b4ad49e24ee0e704bb6d44be57050cf0307b0ab9c77123bd26f9e8f98098a69","7add90ba92a82a65e3569777d09a55804218b9e2c3ed4f46532c41747798e826","1905f8e2287f47fa3f45453f9b55e11b639be1a556261721b60cde4d4fb02268","616a3a51e0d4ca39182624b665e25875962a0b7c52f75ce859e6900aeadc8182","7b36edde7b803c18ae2d846d4af251384ad4b7bfe852b0193e57a2d20a0168d1","9cf73423b4f7207d9df703fd97b454eca670cfe77e2ab524a7a6706fb9bf3acc","ac1770d736ad693ff35fa6746818321ff1aec48991b2b56b14be45066664fb2b","68c325c920a267d11bc6f088bcf87e1816cb136228aa6b440afb534c98392b9e","579a63bc410b4ae187038a3b4f33206f432b15c47aa37b83f2fba956e2a053c0","759f177f68c0d7fa303cb3af30fe9a109fcbdae7e7659bd751a15dad9828c522","efd0a645f2d58dd60de4541969549998655e9d9b9023c8b6b8ddc3f50104e177","0da7520f4ae4a34c62e364993dc037ef7431a8888bc305eb2a5bad2692d21a70","120d35b8d4e6df113a044e76686a3908e24dfc18b69bc64030