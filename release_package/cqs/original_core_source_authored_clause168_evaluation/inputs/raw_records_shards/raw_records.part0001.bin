{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    sl-ParametersAboveThres-v1650    SL-MinMaxMCS-List-r16                               OPTIONAL,    -- Need R","paragraph_zero_based":38712},{"literal_text_all_w_t_and_m_t":"    sl-ParametersBelowThres-v1650    SL-MinMaxMCS-List-r16                               OPTIONAL     -- Need R","paragraph_zero_based":38713},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":38714},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":38715},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38716},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38717},{"literal_text_all_w_t_and_m_t":"SL-PSSCH-TxParameters-r16 ::=    SEQUENCE {","paragraph_zero_based":38718},{"literal_text_all_w_t_and_m_t":"    sl-MinMCS-PSSCH-r16              INTEGER (0..27),","paragraph_zero_based":38719},{"literal_text_all_w_t_and_m_t":"    sl-MaxMCS-PSSCH-r16              INTEGER (0..31),","paragraph_zero_based":38720},{"literal_text_all_w_t_and_m_t":"    sl-MinSubChannelNumPSSCH-r16     INTEGER (1..27),","paragraph_zero_based":38721},{"literal_text_all_w_t_and_m_t":"    sl-MaxSubchannelNumPSSCH-r16     INTEGER (1..27),","paragraph_zero_based":38722},{"literal_text_all_w_t_and_m_t":"    sl-MaxTxTransNumPSSCH-r16        INTEGER (1..32),","paragraph_zero_based":38723},{"literal_text_all_w_t_and_m_t":"    sl-MaxTxPower-r16                SL-TxPower-r16                                      OPTIONAL    -- Cond CBR","paragraph_zero_based":38724},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":38725},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38726},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-PSSCH-TXCONFIGLIST-STOP","paragraph_zero_based":38727},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":38728},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38729},{"literal_text_all_w_t_and_m_t":"SL-PSSCH-TxConfigList field descriptions","paragraph_zero_based":38730},{"literal_text_all_w_t_and_m_t":"sl-MaxTxTransNumPSSCH","paragraph_zero_based":38731},{"literal_text_all_w_t_and_m_t":"Indicates the maximum transmission number (including new transmission and retransmission) for PSSCH.","paragraph_zero_based":38732},{"literal_text_all_w_t_and_m_t":"sl-MaxTxPower","paragraph_zero_based":38733},{"literal_text_all_w_t_and_m_t":"This field indicates the maximum transmission power for transmission on PSSCH and PSCCH.","paragraph_zero_based":38734},{"literal_text_all_w_t_and_m_t":"sl-MinMCS-PSSCH, sl-MaxMCS-PSSCH","paragraph_zero_based":38735}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["8b1e3a857bb80cd515cb5bcaa96fc16f70439166e6b39df42e7ceaf4124fe797","d6b8d269de88d7257070f04f93af023d4480a89f8aa202795648f69c4f3168bc","c5c5e8f69d466e02c95c95f9aab444ca28eede74a11a74e806c5b3f19cc645f0","9e65f39cad6454c77905f2e62ea58d914a29c9d6ff472f2be5e54947ffdfdaed","d157f62d041517f7c079435a023356f3632a5c1b7b783aa81c5199ccae8ad106","d1dea732f9c0917091ca07ba9ff4e11852ce46a17e557f5605380fb83cf3d1bd","b5a9840b25b1abc67ea065bc72e469800f950a9b7d5d3a8abe96010308ca2ba6","8f8e3896be19d770cce24d6266508e68d13313b9861d6db51d6c06376cea5746","144a2f78c381e340acbdd09751ede0b022545c0c1c52bc21fa21b45416ffc6ec","ec91dc2c27d0a2d605459b16f2709d7b286179023b8798cfbbc8bb401fa4b4aa","88f4d175338aa94e234bb3003e2af0e1663bb451a1416b3f896ef20d98ad6a2a","29584d731b4da514595240892192d963cc15221c222e2ce8ece528bbac67c146","3a617c569120c4a49b40b8385a7980a96c83148ece329abca8ffe95608ee7dde","3951fde94b029fa2ae36789b16a69dd4be0e8cb028bd368b7bf7763f65ea2de9","ca016067c27f88a52c98fe01340fae02b4727c3f3fcb8cc0a2ece580397dbc81","8522062a771dbd59eee3bc3787727fa72e097e74c6f6b4b278365039b28f92cd","e9a9a2298dc2ce0f41dca6d87079c427bf6a670e7900a9b634f3b2e0522aa4d1","554423b677936a653af9abbcf5ec782e2d1921373f1d554c861b43b38ffba70e","18e81ded34540c7c8e77071aeb800958c884baa99e6e06ed8cf86ac7d1f1e276","a58c51298843698fc688fa4896d96120217edf00baa56ca1d710f0ef812638d1","a34b6e0e60b9580868dbff0976011e64a46a525d0ccc2bbb42186ab4bdf713a3","fb731aba1f89b22c648408ec9eb2437c13bdaf7179d23d47b71fe211a3c502c6","b7bb502ddd4970034a1cc2288a99ffee2d836af99c4b9ef1fc876c4e3bf75bd2","752b5d92921473bd06f8d4cc2485b89fafa6860b19cfa9b8691ee7c0df0f323e"],"paragraph_range_zero_based":[38712,38735],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p38712"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field indicates the minimum and maximum MCS values used for transmissions on PSSCH. The UE shall ignore the minimum and maximum MCS values used for the associated MCS table(s) in sl-ParametersAboveThres-r16 and sl-ParametersBelowThres-r16 if sl-ParametersAboveThres-v1650 and sl-ParametersBelowThres-v1650 are present, respectively.","paragraph_zero_based":38736},{"literal_text_all_w_t_and_m_t":"sl-MinSubChannelNumPSSCH, sl-MaxSubChannelNumPSSCH","paragraph_zero_based":38737},{"literal_text_all_w_t_and_m_t":"This field indicates the minimum and maximum number of sub-channels which may be used for transmissions on PSSCH.","paragraph_zero_based":38738},{"literal_text_all_w_t_and_m_t":"sl-TypeTxSync","paragraph_zero_based":38739},{"literal_text_all_w_t_and_m_t":"This field indicates the synchronization reference type. For configurations by the eNB/gNB, only gnbEnb can be configured; and for pre-configuration or when this field is absent, the configuration is applicable for all synchronization reference types. ","paragraph_zero_based":38740},{"literal_text_all_w_t_and_m_t":"sl-ThresUE-Speed","paragraph_zero_based":38741},{"literal_text_all_w_t_and_m_t":"This field indicates a UE absolute speed threshold.","paragraph_zero_based":38742},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38743},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":38744},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":38745},{"literal_text_all_w_t_and_m_t":"CBR","paragraph_zero_based":38746},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, when the IE SL-PSSCH-TxParameters is present in SL-CBR-CommonTxConfigList, SL-UE-SelectedConfig, SIB12 or SidelinkPreconfigNR; otherwise the field is not present, need R.","paragraph_zero_based":38747},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38748},{"literal_text_all_w_t_and_m_t":"–SL-QoS-FlowIdentity","paragraph_zero_based":38749},{"literal_text_all_w_t_and_m_t":"The IE SL-QoS-FlowIdentity is used to identify a sidelink QoS flow.","paragraph_zero_based":38750},{"literal_text_all_w_t_and_m_t":"SL-QoS-FlowIdentity information element","paragraph_zero_based":38751},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":38752},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-QOS-FLOWIDENTITY-START","paragraph_zero_based":38753},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38754},{"literal_text_all_w_t_and_m_t":"SL-QoS-FlowIdentity-r16 ::=                    INTEGER (1..maxNrofSL-QFIs-r16)","paragraph_zero_based":38755},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38756},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-QOS-FLOWIDENTITY-STOP","paragraph_zero_based":38757},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":38758},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38759}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["8f7146a35d1121d9917be36c3e7b818f022703d5a546d439a9aab64870b709ab","419ef40cdc6b6f8194e91d9692cae0a6a7afe5ef33788220d2aa6f058919e5d3","f722c3432c5559681ebd13fff120f00044e99b1d457a7550fc7f6010f12b469c","c791e79ddfe3143abe39f8f231024b6958eadd103d994bfea7974414f184aa43","290eadc7b680e3c6cf05ef85e0001e6f0284125713b55a6df05a08d82a9a5f87","3d44d71da23a109e6cb60e7ad09b093f1fa23200f595a0038d102329aef78ca1","8dbcc42a150c05264dd4956c6a8eb4a914ef4f6fb057551d87d9acd284e8fbf5","a74f0fb58f63b9eaf9043074a8c8895bddeb43c35540cade5d8825c050947b9c","67674b7b19545dc3a5d4d8