{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17040},{"literal_text_all_w_t_and_m_t":"CSI-IM-Resource ::=                 SEQUENCE {","paragraph_zero_based":17041},{"literal_text_all_w_t_and_m_t":"    csi-IM-ResourceId                   CSI-IM-ResourceId,","paragraph_zero_based":17042},{"literal_text_all_w_t_and_m_t":"    csi-IM-ResourceElementPattern           CHOICE {","paragraph_zero_based":17043},{"literal_text_all_w_t_and_m_t":"        pattern0                                SEQUENCE {","paragraph_zero_based":17044},{"literal_text_all_w_t_and_m_t":"            subcarrierLocation-p0                   ENUMERATED { s0, s2, s4, s6, s8, s10 },","paragraph_zero_based":17045},{"literal_text_all_w_t_and_m_t":"            symbolLocation-p0                       INTEGER (0..12)","paragraph_zero_based":17046},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":17047},{"literal_text_all_w_t_and_m_t":"        pattern1                                SEQUENCE {","paragraph_zero_based":17048},{"literal_text_all_w_t_and_m_t":"            subcarrierLocation-p1                   ENUMERATED { s0, s4, s8 },","paragraph_zero_based":17049},{"literal_text_all_w_t_and_m_t":"            symbolLocation-p1                       INTEGER (0..13)","paragraph_zero_based":17050},{"literal_text_all_w_t_and_m_t":"        }","paragraph_zero_based":17051},{"literal_text_all_w_t_and_m_t":"    }                                                                                   OPTIONAL,   -- Need M","paragraph_zero_based":17052},{"literal_text_all_w_t_and_m_t":"    freqBand                            CSI-FrequencyOccupation                         OPTIONAL,   -- Need M","paragraph_zero_based":17053},{"literal_text_all_w_t_and_m_t":"    periodicityAndOffset                CSI-ResourcePeriodicityAndOffset                OPTIONAL,   -- Cond PeriodicOrSemiPersistent","paragraph_zero_based":17054},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":17055},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":17056},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17057},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-IM-RESOURCE-STOP","paragraph_zero_based":17058},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17059},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17060},{"literal_text_all_w_t_and_m_t":"CSI-IM-Resource field descriptions","paragraph_zero_based":17061},{"literal_text_all_w_t_and_m_t":"csi-IM-ResourceElementPattern","paragraph_zero_based":17062},{"literal_text_all_w_t_and_m_t":"The resource element pattern (Pattern0 (2,2) or Pattern1 (4,1)) with corresponding parameters (see TS 38.214 [19], clause 5.2.2.4)","paragraph_zero_based":17063}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["271c650b11a36835ae6d70722bed0ad60cdbf7d6470e3a56e74cea0dbff18881","e3e55d0a52f5a93d00549e247dc6898dd98d12090651f490961f39e2b17cb822","7e8f397b4a35c0bd733936e2fc4089d90c1168d4e77d265115f529b63bf8f03f","75b35551212af2dcc97de80d687dc0649660c3fa55919cf2ed875b509546fd34","42e8818c6c6bb203c47ee3c9c9bced9126c37a936efbbd42c20693477cb09962","a3559c6e0f38332bb7c7f1d9cf14a7968fa2ac5342d4086033488dfbc3081323","22be2e2ad3e09aa693c2e1187b8d76cb9444dabff88f10aa29ad8ade993a7e4a","e8396ab33c449fd9bf0da66960041bdccb7f195d9c7d9d5ffad11f6f8ac5cce5","4d495d3e42cbc38bdc0f7288f9e4e14f831de566a170bfe3e9b6a450d19ce842","2e4710d6bddc3434674c3bcb7c3405440478e2da84be0ecf8640de746254748d","969460abfc2eedc437f08e76d16346fdf13f3ac24d17b2d38850ed7fded57aa6","59fac