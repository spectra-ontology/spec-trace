{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–CGI-Info-Logging","paragraph_zero_based":15720},{"literal_text_all_w_t_and_m_t":"The IE CGI-Info-Logging indicates the NR Cell Global Identifier (NCGI) for logging purposes (e.g. RLF report), the globally unique identity, and the TAC information of a cell in NR.","paragraph_zero_based":15721},{"literal_text_all_w_t_and_m_t":"CGI-Info-Logging information element","paragraph_zero_based":15722},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":15723},{"literal_text_all_w_t_and_m_t":"-- TAG-CGI-INFO-LOGGING-START","paragraph_zero_based":15724},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15725},{"literal_text_all_w_t_and_m_t":"CGI-Info-Logging-r16 ::=     SEQUENCE {","paragraph_zero_based":15726},{"literal_text_all_w_t_and_m_t":"    plmn-Identity-r16                    PLMN-Identity,","paragraph_zero_based":15727},{"literal_text_all_w_t_and_m_t":"    cellIdentity-r16                     CellIdentity,","paragraph_zero_based":15728},{"literal_text_all_w_t_and_m_t":"    trackingAreaCode-r16                 TrackingAreaCode               OPTIONAL","paragraph_zero_based":15729},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":15730},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15731},{"literal_text_all_w_t_and_m_t":"-- TAG-CGI-INFO-LOGGING-STOP","paragraph_zero_based":15732},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":15733},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15734},{"literal_text_all_w_t_and_m_t":"CGI-Info-Logging field descriptions","paragraph_zero_based":15735},{"literal_text_all_w_t_and_m_t":"cellIdentity","paragraph_zero_based":15736},{"literal_text_all_w_t_and_m_t":"Unambiguously identify a cell within the context of the PLMN. It belongs the first PLMN-IdentityInfo IE of PLMN-IdentityInfoList in SIB1.","paragraph_zero_based":15737},{"literal_text_all_w_t_and_m_t":"plmn-Identity","paragraph_zero_based":15738},{"literal_text_all_w_t_and_m_t":"Identifies the PLMN of the cell for the reported cellIdentity: the first PLMN entry of plmn-IdentityList (in SIB1) in the instance of PLMN-IdentityInfoList that contained the reported cellIdentity.","paragraph_zero_based":15739},{"literal_text_all_w_t_and_m_t":"trackingAreaCode","paragraph_zero_based":15740},{"literal_text_all_w_t_and_m_t":"Indicates Tracking Area Code to which the cell indicated by cellIdentity field belongs.","paragraph_zero_based":15741},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15742},{"literal_text_all_w_t_and_m_t":"–CLI-RSSI-Range","paragraph_zero_based":15743}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["a259391a82409193df20b042d4e20b652e71495fbd5e13da18dcad44fc0b4dbf","f095ef8e01af0dfb4c1f211649fe731da9f4bf0c75ec3a0d99c0f34f54ef360d","526b7962992391d005b6c009a5df5476d4b9b6dddf319e421e28834d21bad516","231c7a9f5f0eb116fba4cc8db2214f1abeda5367abd9d7283396387ca9a6e15a","f4842ceb8d4c91248cc14d4b46414b59539a62fb34bfe4f26569e7fc3055eebe","620247366faead3cfb88208f295828605b1709976e5438032ba299a1119c9c11","fa35b2c92cf5506ccf9900c5b6355e8062d764b4d5e674350f6a56c1a46856b8","ceae5262adebc6cf06c47316e38031e3550947d87fefec95bdd3237f97e95f94","f1da23fb199ba1d356e4698f06b03d25488245bf21f74891439b851613d17f90","3c8a46491bda4cfa4caf79c101f6cb1904bb87a46d09a95c135ef3e09ee6bb39","85afb1d728464af674048863134d605f7febed834139254d7547617d0b73a110","7d0933b698240d2de2bbd569cb38be1a1ee34528965e4ad5e24acf9c6f251096","256c75565915a60a607229fc9a361f2e05fd4cf0022cf13058eb3c1e