,{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":16769},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16770},{"literal_text_all_w_t_and_m_t":"-- TAG-CONNESTFAILURECONTROL-STOP","paragraph_zero_based":16771},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":16772},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16773},{"literal_text_all_w_t_and_m_t":"ConnEstFailureControl field descriptions","paragraph_zero_based":16774},{"literal_text_all_w_t_and_m_t":"connEstFailCount","paragraph_zero_based":16775}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["094999b4ef9c9d015c6423edb0e8b5a912972304eca53689959e73d333a81882","ac209bd672cae49a9b84e739b5adb0b502ac13dc1662205a9843c2d9c11077b2","d4cb3a62e7ea0ccde1f64bad42251a7f0f4d770179cb08a1874010299884bb04","980289445d236b272487a4322f88da0bcc489911a20f5820c35d52e004ff89fe","29dd704e0056fe94b65b5b35821f6a0b9d0be731c2a899fe41deb106791fe4b4","330718cc2d23a561e7b6cb11ca5e8298a8b891097ff6748ff2d29b6873db88e2","1031482f66d07bbb27f96742b6fd1cf86cadb5814abf3c1c8825f4cc67ea68d1","e30a12e65687b20a314df236a67b9f87ceaeb4ad99b75a30a09059b092153ec3","6211a60896f4d1f1c761d850afed131b699a39ee16e9feaf3aece4ed4a2a4456","fd16177137e2fcf0032b2ea3807b48892a4135ba4ec91704ee0112eaaef9277f","858c9e8b764e31d5136758dd9bebdcc38b26b5ec3fe414594202fb747383b191","36b6b98b6e6ffb8c6683399a96b7b1ae19e14d9ee02c5259a41fffcc13788b3b","595f5febc5de0cab783d3122fa910367a098125948ce538a8ee2ef7d74a26d96","3bf4755d3d9b57604c9d41635f3270daab676f8416d3db09ca8ce45d6819ebd6","242e25996163f166f20cece5d4dc053dec6df245b7088d4a8ab4089f413d79e6","ce781d73ed5cf21e0020d291931cb6bd589af05b6628ebdac53568645e85ee95","6c425ed78c017a4c895202a1dfffd02dbb687382172db34efd88469cb3694f2c","de5a61de92f15722c6e2908fcf55f8a6c5d26d38f0e74e53a7d339b8c8dc965e","16b180d4758901b00cd7f23461d68bbbdd8ba63d26581f477cb86d3edb557776","d27e16e220ae40a317b625f344d1ff9e3b740391f1e185a5ab5fbb61726dd53b","20bae4f0af605b5873fa25a7d5fd76329191d9ca2adbdfdcb3989a3a8d4aae07","baba80180402c98f2e1db589b4b66d844c1afd0ed58e61c80c3d5cc5331eddd1","422c2ed5be72d9f5a370a7b01dabb007ac9286e661236876d5b8cf1b9e68dafd","b39687c09f4c8a24f7e7398ae0459dd89f1e8865028484036fc30c4bd1132412"],"paragraph_range_zero_based":[16752,16775],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p16752"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Number of times that the UE detects T300 expiry on the same cell before applying connEstFailOffset.","paragraph_zero_based":16776},{"literal_text_all_w_t_and_m_t":"connEstFailOffset","paragraph_zero_based":16777},{"literal_text_all_w_t_and_m_t":"Parameter \"Qoffsettemp\" in TS 38.304 [20]. If the field is absent, the value of infinity shall be used for \"Qoffsettemp\".","paragraph_zero_based":16778},{"literal_text_all_w_t_and_m_t":"connEstFailOffsetValidity","paragraph_zero_based":16779},{"literal_text_all_w_t_and_m_t":"Amount of time that the UE applies connEstFailOffset before removing the offset from evaluation of the cell. Value s30 corresponds to 30 seconds, value s60 corresponds to 60 seconds, and so on.","paragraph_zero_based":16780},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16781},{"literal_text_all_w_t_and_m_t":"–ControlResourceSet","paragraph_zero_based":16782},{"literal_text_all_w_t_and_m_t":"The IE ControlResourceSet is used to configure a time/frequency control resource set (CORESET) in which to search for downlink control information (see TS 38.213 [13], clause 10.1). For the UE not supporting multipleCORESET in FR1, in order to receive MBS multicast in CFR within the UE's active BWP, if a CORESET is not configured within the PDCCH-ConfigMulticast, the CORESET other than CORESET#0 configured within the UE's active BWP for scheduling unicast can be used for scheduling MBS multicast, and the CORESET is expected to be included completely within the CFR and the parameters configured in the CORESET are expected to be supported by the UE for MBS multicast.","paragraph_zero_based":16783},{"literal_text_all_w_t_and_m_t":"ControlResourceSet information element","paragraph_zero_based":16784},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":16785},{"literal_text_all_w_t_and_m_t":"-- TAG-CONTROLRESOURCESET-START","paragraph_zero_based":16786},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16787},{"literal_text_all_w_t_and_m_t":"ControlResourceSet ::=              SEQUENCE {","paragraph_zero_based":16788},{"literal_text_all_w_t_and_m_t":"    controlResourceSetId                ControlResourceSetId,","paragraph_zero_based":16789},{"literal_text_all_w_t_and_m_t":"    frequencyDomainResources            BIT STRING (SIZE (45)),","paragraph_zero_based":16790},{"literal_text_all_w_t_and_m_t":"    duration                            INTEGER (1..maxCoReSetDuration),","paragraph_zero_based":16791},{"literal_text_all_w_t_and_m_t":"    cce-REG-MappingType                 CHOICE {","paragraph_zero_based":16792},{"literal_text_all_w_t_and_m_t":"        interleaved                         SEQUENCE {","paragraph_zero_based":16793},{"literal_text_all_w_t_and_m_t":"            reg-BundleSize                      ENUMERATED {n2, n3, n6},","paragraph_zero_based":16794},{"literal_text_all_w_t_and_m_t":"            interleaverSize                     ENUMERATED {n2, n3, n6},","paragraph_zero_based":16795},{"literal_text_all_w_t_and_m_t":"            shiftIndex                          INTEGER(0..maxNrofPhysicalResourceBlocks-1)       OPTIONAL -- Need S","paragraph_zero_based":16796},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":16797},{"literal_text_all_w_t_and_m_t":"        nonInterleaved                      NULL","paragraph_zero_based":16798},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":16799}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["b11e79e1b27e93099494be40d