{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SIB8 ::=                        SEQUENCE {","paragraph_zero_based":13800},{"literal_text_all_w_t_and_m_t":"    messageIdentifier               BIT STRING (SIZE (16)),","paragraph_zero_based":13801},{"literal_text_all_w_t_and_m_t":"    serialNumber                    BIT STRING (SIZE (16)),","paragraph_zero_based":13802},{"literal_text_all_w_t_and_m_t":"    warningMessageSegmentType       ENUMERATED {notLastSegment, lastSegment},","paragraph_zero_based":13803},{"literal_text_all_w_t_and_m_t":"    warningMessageSegmentNumber     INTEGER (0..63),","paragraph_zero_based":13804},{"literal_text_all_w_t_and_m_t":"    warningMessageSegment           OCTET STRING,","paragraph_zero_based":13805},{"literal_text_all_w_t_and_m_t":"    dataCodingScheme                OCTET STRING (SIZE (1))                         OPTIONAL,   -- Cond Segment1","paragraph_zero_based":13806},{"literal_text_all_w_t_and_m_t":"    warningAreaCoordinatesSegment   OCTET STRING                                    OPTIONAL,   -- Need R","paragraph_zero_based":13807},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension        OCTET STRING                                    OPTIONAL,","paragraph_zero_based":13808},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":13809},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":13810},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13811},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB8-STOP","paragraph_zero_based":13812},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":13813},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13814},{"literal_text_all_w_t_and_m_t":"SIB8 field descriptions","paragraph_zero_based":13815},{"literal_text_all_w_t_and_m_t":"dataCodingScheme","paragraph_zero_based":13816},{"literal_text_all_w_t_and_m_t":"Identifies the alphabet/coding and the language applied variations of a CMAS notification.","paragraph_zero_based":13817},{"literal_text_all_w_t_and_m_t":"messageIdentifier","paragraph_zero_based":13818},{"literal_text_all_w_t_and_m_t":"Identifies the source and type of CMAS notification.","paragraph_zero_based":13819},{"literal_text_all_w_t_and_m_t":"serialNumber","paragraph_zero_based":13820},{"literal_text_all_w_t_and_m_t":"Identifies variations of a CMAS notification.","paragraph_zero_based":13821},{"literal_text_all_w_t_and_m_t":"warningAreaCoordinatesSegment","paragraph_zero_based":13822},{"literal_text_all_w_t_and_m_t":"If present, carries a segment, with one or more octets, of the geographical area where the CMAS warning message is valid as defined in [28]. The first octet of the first warningAreaCoordinatesSegment is equivalent to the first octet of Warning Area Coordinates IE defined in and encoded according to TS 23.041 [29] and so on.","paragraph_zero_based":13823}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["000f86ce340043cf9f24879ed087f96c86fae6e01905913238875ad5262be2d0","58bda1ad8195203733fdc6e8b7c17a77d2cc3443da8afc90d595305687c70615","c306c285f8bbc8bb9b54f59d048a6c07a5c10bab4aaf159509bcd27df9d8c6e3","59c7047a9f105bc7bf8e3f01b9caa51ea264946d3abcca8171bb9f14fe60bff5","11bea370124d78d91593b12733cf9b6c88629520d55f6c212005c7400318c6d8","04288843d9fbf74326f86657f08ea93ebf78284caca88e45d342f621990c7e21","e9c160ef7115112f9cfdf8114190513e3629dc4ce2b02231efe201b934682f8e","3cce3ef7b9fb90b23a1609f1f084cd2bea8336f7fdfbc2687cff17f931289a13","b2ad09aa19076bdede92ff1f2d52a475f26530d6b17cfcd0449ee02479515d44","3eb7a4149ee77b23e70ab57c1a3ee095681562e46951357f540d88a8af0a7ed4","f2fc57d527a04c1026cb6684d49931b9470197daef3151b7e9aece76becff42d","090269088798690d176ec523d2147f20906856307c1c66bbdfde1f7339e2e2e9","495a77ec9dc1d0a360fc6db11fe0d30dcab6090812a71a22786fe7291955a49f","bb09eedfcb8080ff7e3643a9fc25bde796119e7fdacf3517f3b72ec43bad3df1","9ef96113ebe1d7aa2983dc10161940c3b07bd5b3ff6866a37d9f4c9cd5210430","a89aca4576daee1346a6c5b053a7f99741792805121aa05a8c7e7755bd99ab2b","6b4ef1b797bb09df7bff7892622a3b07f0666fa99f6c0a185cdc5c1a27f0ee4a","e4c1fa43d60b96b6e2ea0eef5cd24a3159ffc6dbe83f98fcb5c5c39e4c87803d","3bac38bc41e5b1fb5da0b8a87061252607f7d472cd2ca41ad7337aef1d90fb19","36e12c475023cc4e28480c6b8d4f2ee7e971798116a3933258b54156d5645799","7cc7ca03c0d8f4b60058f284cac4b1c97d9dd01b8bf6fe8001e8eb6f51b42c46","287556e394f074628108d6c4b243119b751c4a17464e4caa3501f9ecac9401b1","6aee5c672e91c96e248cdd8b97998ab695ca04d6fe7fb334fec05548c5baad1a","c2dfa05469f2ed8ac9f91e6fd7be7ab3a8c9e382236feb403e2d300e36e12695"],"paragraph_range_zero_based":[13800,13823],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p13800"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"warningMessageSegment","paragraph_zero_based":13824},{"literal_text_all_w_t_and_m_t":"Carries a segment, with one or more octets, of the Warning Message Contents IE defined in TS 38.413 [42]. The first octet of the Warning Message Contents IE is equivalent to the first octet of the CB data IE defined in and encoded according to TS 23.041 [29], clause 9.4.2.2.5, and so on.","paragraph_zero_based":13825},{"literal_text_all_w_t_and_m_t":"warningMessageSegmentNumber","paragraph_zero_based":13826},{"literal_text_all_w_t_and_m_t":"Segment number of the CMAS warning message segment contained in the SIB. A segment number of zero corresponds to the first segment, one corresponds to the second segment, and so on. If warning area coordinates are provided for the warning message, then this field applies to both warning message segment and warning area coordinates segment.","paragraph_zero_based":13827},{"literal_text_all_w_t_and_m_t":"warningMessageSegmentType","paragraph_zero_based":13828},{"literal_text_all_w_t_and_m_t":"Indicates whether the included CMAS warning message segment is the last segment or not. If warning area coordinates are provided for the warning message, then this field applies to both warning message segment and warning area coordinates segment.","paragraph_zero_based":13829},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13830},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":13831},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":13832},{"literal_text_all_w_t_and_m_t":"Segment1","paragraph_zero_based":13833},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in the first segment of SIB8, otherwise it is absent.","paragraph_zero_based":13834},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13835},{"literal_text_all_w_t_and_m_t":"–SIB9","paragraph_zero_based":13836},{"literal_text_all_w_t_and_m_t":"SIB9 contains information related to GPS time and Coordinated Universal Time (UTC). The UE may use the parameters provided in this system information block to obtain the UTC, the GPS and the local time.","paragraph_zero_based":13837},{"literal_text_all_w_t_and_m_t":"NOTE:The UE may use the time information for numerous purposes, possibly involving upper layers e.g. to assist GPS initialisation, to synchronise the UE clock.","paragraph_zero_based":13838},{"literal_text_all_w_t_and_m_t":"SIB9 information element","paragraph_zero_based":13839},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":13840},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB9-START","paragraph_zero_based":13841},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13842},{"literal_text_all_w_t_and_m_t":"SIB9 ::=                            SEQUENCE {","paragraph_zero_based":13843},{"literal_text_all_w_t_and_m_t":"    timeInfo                            SEQUENCE {","paragraph_zero_based":13844},{"literal_text_all_w_t_and_m_t":"        timeInfoUTC                         INTEGER (0..549755813887),","paragraph_zero_based":13845},{"literal_text_all_w_t_and_m_t":"        dayLightSavingTime                  BIT STRING (SIZE (2))                   OPTIONAL,   -- Need R","paragraph_zero_based":13846},{"literal_text_all_w_t_and_m_t":"        leapSeconds                         INTEGER (-127..128)                     OPTIONAL,   -- Need R","paragraph_zero_based":13847}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["3af0c0c8bc74a1969afe3a49a784ffa9d3464e9134f9bb6d1868cfe0329682ff","a9d2d9bf19219c17360f92b8bfdf05dfc67c29dd4f98dc27fe0b14fb9f320d3c","c7f6ceb074114655e41f3e544b7594a908aeab745230096073711638229e0be3","860d556d8a71ce473446153e081865708229b3fcf67f49eeb2e75bb3fc668759","acaecf8c4601b216b8d490aa059f248784a9d6c129b15867544a66183fbabbb0","2eb1eba00362c42502ec5a420f38f6c476d38b63e7157b51e424784fad123983","791b7da4fabbd9e02382eb27f6d72f744b9fb08cf61c32afd05e36e36161023e","5832cc42dd89570d456a7afdb7b6d49d4fcfc6b07b0f857404534621dffcb2ec","59b19eca299eba5420215027c759dbff45a135849dcc9e396f6e566250c108d1","5ba9296d67b3e3436da85298229e60230a1eaa241edbd39df17b58bf15e5e33b","8a333325ae0760c763a7b910bc3a6fe50293c8c0fd7fc8106dc90f7f97fb2888","3a5dfdbc53627ec777dd68e4d797d895cc3a768d939b6ad5610c6331076b3e4b","3348316d46e2595be361391141dd55d5a9cf435bbbc8c3f607313d7967837993","62fadaa44e7e5cf6ee71084cf7b3ec6c1a5e2b9ee5d239897ec9cca2b75fba7e","6cf2920e7667f731965fbb4d398758b553493be50b9bd9db29bcd42295168001","326351079ccb6c2eba4540194f3688a9668eb9bb5b976cc4b69b717007676dca","aa9cd9fa6028ff5750fa6e16d21d3f549ec7f2a3e0ee7bdbad802c24580e1a38","f1bae986dcbde25bd533cb602049eb5400f8a5b12ea65c387e9e6c31d5ceb4ba","c190e952d38a938d980a90af4c74e1ecc13ce416999d565c2c2ef7a8c5d36dfc","991ecf4c5c345c5beabc15dca97a500e1930338eda29cab7f52ef246706f72be","f5b197c617259e74871da9bad5e424177d77f60f7cdc64eb88ded6b0a3784b96","6da05741dde5be71d3f008aaae9b88e5d684a23623be517ac45cf01c3bf9e1cc","599e820ce7f2501e5f451d235e1d3e848670304ff69653e27c560df39fe522cd","5069a2176d390cf8332a689e04afe3e78e3a7815eb1f4354b2c8325445db63f9"],"paragraph_range_zero_based":[13824,13847],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p13824"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        localTimeOffset                     INTEGER (-63..64)                       OPTIONAL    -- Need R","paragraph_zero_based":13848},{"literal_text_all_w_t_and_m_t":"    }                                                                               OPTIONAL,   -- Need R","paragraph_zero_based":13849},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension            OCTET STRING                                OPTIONAL,","paragraph_zero_based":13850},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":13851},{"literal_text_all_w_t_and_m_t":"     [[","paragraph_zero_based":13852},{"literal_text_all_w_t_and_m_t":"    referenceTimeInfo-r16           ReferenceTimeInfo-r16                           OPTIONAL    -- Need R","paragraph_zero_based":13853},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":13854},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":13855},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13856},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB9-STOP","paragraph_zero_based":13857},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":13858},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13859},{"literal_text_all_w_t_and_m_t":"SIB9 field descriptions","paragraph_zero_based":13860},{"literal_text_all_w_t_and_m_t":"dayLightSavingTime","paragraph_zero_based":13861},{"literal_text_all_w_t_and_m_t":"Indicates if and how daylight-saving time (DST) is applied to obtain the local time. The semantics are the same as the semantics of the Daylight Saving Time IE in TS 24.501 [23] and TS 24.008 [38]. The first/leftmost bit of the bit string contains the b2 of octet 3 and the second bit of the bit string contains b1 of octet 3 in the value part of the Daylight Saving Time IE in TS 24.008 [38].","paragraph_zero_based":13862},{"literal_text_all_w_t_and_m_t":"leapSeconds","paragraph_zero_based":13863},{"literal_text_all_w_t_and_m_t":"Number of leap seconds offset between GPS Time and UTC. UTC and GPS time are related i.e. GPS time -leapSeconds = UTC time.","paragraph_zero_based":13864},{"literal_text_all_w_t_and_m_t":"localTimeOffset","paragraph_zero_based":13865},{"literal_text_all_w_t_and_m_t":"Offset between UTC and local time in units of 15 minutes. Actual value = field value * 15 minutes. Local time of the day is calculated as UTC time + localTimeOffset.","paragraph_zero_based":13866},{"literal_text_all_w_t_and_m_t":"timeInfoUTC","paragraph_zero_based":13867},{"literal_text_all_w_t_and_m_t":"Coordinated Universal Time corresponding to the SFN boundary at or immediately after the ending boundary of the SI-window in which SIB9 is transmitted. The field counts the number of UTC seconds in 10 ms units since 00:00:00 on Gregorian calendar date 1 January, 1900 (midnight between Sunday, December 31, 1899 and Monday, January 1, 1900). See NOTE 1. This field is excluded when determining changes in system information, i.e. changes of timeInfoUTC should neither result in system information change notifications nor in a modification of valueTag in SIB1.","paragraph_zero_based":13868},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13869},{"literal_text_all_w_t_and_m_t":"NOTE 1:The UE may use this field together with the leapSeconds field to obtain GPS time as follows: GPS Time (in seconds) = timeInfoUTC (in seconds) -  2,524,953,600 (seconds) + leapSeconds, where 2,524,953,600 is the number of seconds between 00:00:00 on Gregorian calendar date 1 January, 1900 and 00:00:00 on Gregorian calendar date 6 January, 1980 (start of GPS time).","paragraph_zero_based":13870},{"literal_text_all_w_t_and_m_t":"–SIB10","paragraph_zero_based":13871}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordina