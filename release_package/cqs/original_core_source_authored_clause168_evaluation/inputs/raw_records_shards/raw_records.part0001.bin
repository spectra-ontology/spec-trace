{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    field2                              CHOICE {","paragraph_zero_based":44664},{"literal_text_all_w_t_and_m_t":"        field2a                             BOOLEAN,","paragraph_zero_based":44665},{"literal_text_all_w_t_and_m_t":"        field2b                             InformationElement2b,","paragraph_zero_based":44666},{"literal_text_all_w_t_and_m_t":"        ...,","paragraph_zero_based":44667},{"literal_text_all_w_t_and_m_t":"        field2c-v960                        InformationElement2c-r9","paragraph_zero_based":44668},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":44669},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":44670},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":44671},{"literal_text_all_w_t_and_m_t":"    field3-r9                           InformationElement3-r9      OPTIONAL        -- Need R","paragraph_zero_based":44672},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":44673},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":44674},{"literal_text_all_w_t_and_m_t":"    field3-v9a0                         InformationElement3-v9a0    OPTIONAL,       -- Need R","paragraph_zero_based":44675},{"literal_text_all_w_t_and_m_t":"    field4-r9                           InformationElement4         OPTIONAL        -- Need R","paragraph_zero_based":44676},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":44677},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44678},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44679},{"literal_text_all_w_t_and_m_t":"InformationElement1-r10 ::=         SEQUENCE {","paragraph_zero_based":44680},{"literal_text_all_w_t_and_m_t":"    field1                              ENUMERATED {","paragraph_zero_based":44681},{"literal_text_all_w_t_and_m_t":"                                            value1, value2, value3, value4-v880,","paragraph_zero_based":44682},{"literal_text_all_w_t_and_m_t":"                                            value5-v960, value6-v1170, spare2, spare1, ... },","paragraph_zero_based":44683},{"literal_text_all_w_t_and_m_t":"    field2                              CHOICE {","paragraph_zero_based":44684},{"literal_text_all_w_t_and_m_t":"        field2a                             BOOLEAN,","paragraph_zero_based":44685},{"literal_text_all_w_t_and_m_t":"        field2b                             InformationElement2b,","paragraph_zero_based":44686},{"literal_text_all_w_t_and_m_t":"        field2c-v960                        InformationElement2c-r9,","paragraph_zero_based":44687}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["63b8f9214a335a30ea53a142d6be13e09362e0d418593c131d2b14e280dec37e","da662985e638f44067c693905afe07b7db9e7d9cdcf39eeeca78e4af9023e3a9","ac1123ed3b1c3889e7aef029530fc24d4f0d6c3181a44f99e81b251579809e76","2299abdc38789956999db0c8a4a8d2bf56a09fa55fc25cf8ea123708afe545ae","7ff8fb9134b0f7e74c106a33a90be05c15d157ee49c8628eae825576d0235b18","cefa3f0f58f7f0f65c6f7e996cd19265499a4522b0bc4b239c904a9fc90932b3","d58cf3b8d6bb78c714a3ebe7eac815c002b9b0d1d2e276e832c01d1371bc034f","35e738a5834f1e75d335b3f47855afee8cf2e324b4ae2840dc3c1fbbde1af28c","32ef0c7ce5bae40206ed2211fe890e1c83991eb30883170c3bf043867d706f98","c3fc191ed5e852dfd0495a1e09b556bd2ef4d2aff44971229a378dec059f8b2b","68ae6ec6a70a4802bc83389fed3cdaa49a9b8f6de994371db29ba53c996a8c10","2a28d5028876aa04147ea3786b673fbd4dded9cfcf2b58c99d1975c8c6dba59f","a9e9dcc1f0a00ee109da88e0e9d849883c0b797ada23f373535f22e2f6ee04b0","be15334274f5189d0a71f056133a3817ca2fa4e1eb627d567e0c3386b91496e1","2ca7c7f983bd9ac16d8d6e86dca263ca8b26d6b5f21c218c1ebe10847832590b","b15ea0fbccf7b944019b043cbc676f0a5b14f04cac6807659911dbde26f809e0","90bae7b0ac035af7c7c6526efd04c4be42750905fcb0ab316efb960b684533f5","7e7e13fba73743a9bffe421c6a557c317d5a36f2b33dd11d55cf88c9fa575e24","e4c965f9a0d48fd13998b1c381238ee28802356144b4cef913f1156d69cd9c36","405f7f8c4fd7e65a609f880410c22f031be171e95813c550e666ecb6f207befc","0bfd5b543f741936cd42cc1014ca65795879774efe3d62574d6c10e5e2bfea7f","e8c1037e55179a076fdbc4145069310a5ac020907724a3705e1b3c933d4643e0","ed32c75a96fad13bc11e2bda36626be0cde81d9946473359b64ba35917f9174b","ba50e79aa3eaec4887f1f45c147165c8a4fb3564c68661a86875666014302676"],"paragraph_range_zero_based":[44664,44687],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p44664"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        ...,","paragraph_zero_based":44688},{"literal_text_all_w_t_and_m_t":"        field2d-v12b0                       INTEGER (0..63)","paragraph_zero_based":44689},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":44690},{"literal_text_all_w_t_and_m_t":"    field3-r9                           InformationElement3-r10         OPTIONAL,   -- Need R","paragraph_zero_based":44691},{"literal_text_all_w_t_and_m_t":"    field4-r9                           InformationElement4             OPTIONAL,   -- Need R","paragraph_zero_based":44692},{"literal_text_all_w_t_and_m_t":"    field5-r10                          BOOLEAN,","paragraph_zero_based":44693},{"literal_text_all_w_t_and_m_t":"    field6-r10                          InformationElement6-r10         OPTIONAL,   -- Need R","paragraph_zero_based":44694},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":44695},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":44696},{"literal_text_all_w_t_and_m_t":"    field3-v1170                        InformationElement3-v1170       OPTIONAL    -- Need R","paragraph_zero_based":44697},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":44698},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44699},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44700},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44701},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44702},{"literal_text_all_w_t_and_m_t":"Some remarks regarding the extensions of InformationElement1 as shown in the above example:","paragraph_zero_based":44703},{"literal_text_all_w_t_and_m_t":"–The InformationElement1 is initially extended with a number of non-critical extensions. In release 10 however, a critical extension is introduced for the message using this IE. Consequently, a new version of the IE InformationElement1 (i.e. InformationElement1-r10) is defined in which the earlier non-critical extensions are incorporated by means of a revision of the original field.","paragraph_zero_based":44704},{"literal_text_all_w_t_and_m_t":"–The value4-v880 is replacing a spare value defined in the original protocol version for field1. Likewise value6-v1170 replaces spare3 that was originally defined in the r10 version of field1.","paragraph_zero_based":44705},{"literal_text_all_w_t_and_m_t":"–Within the critically extended release 10 version of InformationElement1, the names of the original fields/IEs are not changed, unless there is a real need to distinguish them from other fields/IEs. E.g. the field1 and InformationElement4 were defined in the original protocol version (release 8) and hence not tagged. Moreover, the field3-r9 is introduced in release 9 and not re-tagged; although, the InformationElement3 is also critically extended and therefore tagged InformationElement3-r10 in the release 10 version of InformationElement1.","paragraph_zero_based":44706},{"literal_text_all_w_t_and_m_t":"A.4.3.4Typical examples of non critical extension at the end of a message","paragraph_zero_based":44707},{"literal_text_all_w_t_and_m_t":"The following example illustrates the use of non-critical extensions at the end of the message or at the end of a field that is contained in a BIT or OCTET STRING i.e. when an empty sequence is used.","paragraph_zero_based":44708},{"literal_text_all_w_t_and_m_t":"-- /example/ ASN1START","paragraph_zero_based":44709},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44710},{"literal_text_all_w_t_and_m_t":"RRCMessage-r8-IEs ::=           SEQUENCE {","paragraph_zero_based":44711}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["58ad0aaf6de2e2026ac2acb573311affd49de983a0d10dce5e008ba68efe20e6","746aa20515288f2eea12aebb4cd43aae793d4f8f081d014f2634eb6b46f34cd7","520429e8a2f03868e9ec93e2b6509ab76ed90e0a3c89a86fe5fb942289e14b47","dcbe103a384eeeacd858057f77824933da605da7d0e5735a0eb900ea3444e9c6","775906851d80fc294b5a5093e47ff4f42952c875335d3be8f87db25bb29bdf11","2dddcb658fed976243325b42a7227ed852e67077765defd13f6af5b925cb8cf7","c95d4b14dbed76ffed24cba2796639860b42ce7bc1c441f37310a2fe187921df","27d2627993f27d1cbd2b9d6cb84cc857979f5f4256a5fde5150022acec008cd4","7c415137ae1ecfa9a416475e8737d1d2abc077ea2b5d555737e60b0a371dce4e","1f6368f3845fc4acb945d23017597899bfe654cdb689bece3ce96b842fa80a14","98cd67a0b7f8cda2634feec657d05cc7427194c1ae055b43870b7da487ee9a79","218808bdb41cc447eaccf85fda4363f76527ddac01040347cbfa74e6947bb074","75b8bc5cdefa7126263ad869f9a851dcec54883e4ac1c45444400e487e01051b","a89f7d13ba6f521a4dc42eaafdcff97530eb763abd92dcba3ce452338eb26e13","9462ca16f4d4738e466c53bb1d8d1044b5d3000d09970bff3a460521cd2e0a4f","8490412f74dacec1c56d901f5355ce64ce2d58e9e578717ab68ea6ef6bf015b7","84c29d625c40519bc7a9abf2b647301733eb033eefe9d5c1d7c8732f1a4ae96e","3f1b4727f403bf98c56cd46de4fb545fd5ba16ba6a6caf19b24b9806f9d2a3c7","f9a024088b71bd87bda4c7c1ac77fe3c6d183694f6927e0ab30d47589fa4d1fc","9fe4a33e59e85f7c38c00dff315cabd4c8c8ffc4f3ff537bc1cb6e149bdf236d","d8ed09f5125dffc1c2c9fa1fc57a0db1ab47743ae099503178b8cb2abf4e7626","184211755baac2a6ac624b2a37cf76a99743c1c22e7af7bbaeb83ccbd85e4245","481ab74d8c4b813d9b45725ca53463334dc930ae5a81dd2593eb11a31acb4cf4","89174c711e6ca09c8369da3640ff2d0be9c2bf96491568c3035151ed0e374cad"],"paragraph_range_zero_based":[44688,44711],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p44688"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    field1                          InformationElement1,","paragraph_zero_based":44712},{"literal_text_all_w_t_and_m_t":"    field2                          InformationElement2,","paragraph_zero_based":44713},{"literal_text_all_w_t_and_m_t":"    field3                          InformationElement3                 OPTIONAL,   -- Need N","paragraph_zero_based":44714},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension            RRCMessage-v860-IEs                 OPTIONAL","paragraph_zero_based":44715},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44716},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44717},{"literal_text_all_w_t_and_m_t":"RRCMessage-v860-IEs ::=         SEQUENCE {","paragraph_zero_based":44718},{"literal_text_all_w_t_and_m_t":"    field4-v860                     InformationElement4                 OPTIONAL,   -- Need S","paragraph_zero_based":44719},{"literal_text_all_w_t_and_m_t":"    field5-v860                     BOOLEAN                             OPTIONAL,   -- Cond C54","paragraph_zero_based":44720},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension            RRCMessage-v940-IEs                 OPTIONAL","paragraph_zero_based":44721},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44722},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44723},{"literal_text_all_w_t_and_m_t":"RRCMessage-v940-IEs ::=         SEQUENCE {","paragraph_zero_based":44724},{"literal_text_all_w_t_and_m_t":"    field6-v940                     InformationElement6-r9              OPTIONAL,   -- Need R","paragraph_zero_based":44725},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtensions           SEQUENCE {}                         OPTIONAL","paragraph_zero_based":44726},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44727},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44728},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44729},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44730},{"literal_text_all_w_t_and_m_t":"Some remarks regarding the extensions shown in the above example:","paragraph_zero_based":44731},{"literal_text_all_w_t_and_m_t":"–The InformationElement4 is introduced in the original version of the protocol (release 8) and hence no suffix is used.","paragraph_zero_based":44732},{"literal_text_all_w_t_and_m_t":"A.4.3.5Examples of non-critical extensions not placed at the default extension location","paragraph_zero_based":44733},{"literal_text_all_w_t_and_m_t":"The following example illustrates the use of non-critical extensions in case an extension is not placed at the default extension location.","paragraph_zero_based":44734},{"literal_text_all_w_t_and_m_t":"–ParentIE-WithEM","paragraph_zero_based":44735}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["496687464e025ec73c81d9769ec4e39b244cc0f009f5f16cb7200a8f441098c5","1c0aa95f07f911fe51c090b1adce9068b36fd62ac33782282d0e4994010fd357","cac71d2cf52c24728fe8d3b51ecb8666f1b45d323f205c1d989dfef958c6998d","bcaf3e80dd3b9d1aebb10ee1aea374b6da3d86578652918f7f5ffe2bf899f763","b152e0fb539daf9c71c2058e63ab61c36f1aba361f56b7604ce0161d325d73df","e2fe4ee4d2a23328bdfec723d8cfdb99e103bea52944655981cb9e9aa2334fba","5bda299913495bd4f586698ecfb6f854136641b6208dc47d60b64a5c9ea3047e","70417fa8f68ad7a6ebebb2efee2b2787402fe379a7b65e9ecaeb8d976b8c6fc1","117d1e5727b84d70497e27134df1e55b020153da5c79865837800ea3bf85501b","5ea917bde418ce7566cccac4957d04a4ddfe0c953dfbc351cfa6cd22804d566e","59f5e56da46c016189d9de12b30a04b5cfd9996f91e88f7fa1b2936b4e67f9cc","1b1c256aae4cdf45b7d11f1805b3c479dbb1c43a9d344bf216795ba79888f227","6fc541ac13c1acc8d2eda113567f2bd92437fc78e261c871a5edc73b7a09cbce","1e22b9f84b4ecbbf9af03dc0adf2d6f7427f18e6ae8116a15e37fbefffde8dcf","e6537b90f680649abfbb7ae9e3fcd8556bb7742e92d543f16cc60b906c020340","d3c217fc623baaf5ce82d2956dc61fed1acdb5153512bea94d84589bb1cda3a9","f666e7fbc2b5ee3aab4509dc679525b6603f967b3cc11cc14f42737706c03507","0d59a89a8877dfd591599fa76e0276f85c679a028273fe42bd45ecf4725c256b","ede1be1e31f87c693e354f942ab0303348fcab707fc0a2f87242508a488d6c29","b30a96bf947e85b7d5d64b8a825536b5c251f406e95a8798f8765fa3dc57d051","7f05d0fe5ddb248d80e0ead331f7e9ddc89b1a3278b4a752ef1ff76926b9d777","675adc6d3ca436cc1409fe9087ab2464611a680985c616d748d6ac4fb9d4c268","5b6aa9a9060f77873c25f81baa276806b810309a3918cd179835f5a928412bce","18af01093f4dedc8db114fbad964f0a2a6aaf1ffa5e3fcbdd24f9fe32a8906de"],"paragraph_range_zero_based":[44712,44735],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p44712"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE ParentIE-WithEMis an example of a high level IE including the extension marker (EM). The root encoding of this IE includes two lower level IEs ChildIE1-WithoutEM and ChildIE2-WithoutEM which not include the extension marker. Consequently, non-critical extensions of the Child-IEs have to be included at the level of the Parent-IE.","paragraph_zero_based":44736},{"literal_text_all_w_t_and_m_t":"The example illustrates how the two extension IEs ChildIE1-WithoutEM-vNx0 and ChildIE2-WithoutEM-vNx0 (both in release N) are used to connect non-critical extensions with a default extension location in the lower level IEs to the actual extension location in this IE.","paragraph_zero_based":44737},{"literal_text_all_w_t_and_m_t":"ParentIE-WithEM information element","paragraph_zero_based":44738},{"literal_text_all_w_t_and_m_t":"-- /example/ ASN1START","paragraph_zero_based":44739},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44740},{"literal_text_all_w_t_and_m_t":"ParentIE-WithEM ::=                 SEQUENCE {","paragraph_zero_based":44741},{"literal_text_all_w_t_and_m_t":"    -- Root encoding, including:","paragraph_zero_based":44742},{"literal_text_all_w_t_and_m_t":"    childIE1-WithoutEM                  ChildIE1-WithoutEM              OPTIONAL,       -- Need N","paragraph_zero_based":44743},{"literal_text_all_w_t_and_m_t":"    childIE2-WithoutEM                  ChildIE2-WithoutEM              OPTIONAL,       -- Need N","paragraph_zero_based":44744},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":44745},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":44746},{"literal_text_all_w_t_and_m_t":"    childIE1-WithoutEM-vNx0             ChildIE1-WithoutEM-vNx0     OPTIONAL,       -- Need N","paragraph_zero_based":44747},{"literal_text_all_w_t_and_m_t":"    childIE2-WithoutEM-vNx0             ChildIE2-WithoutEM-vNx0     OPTIONAL        -- Need N","paragraph_zero_based":44748},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":44749},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44750},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44751},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44752},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44753},{"literal_text_all_w_t_and_m_t":"Some remarks regarding the extensions shown in the above example:","paragraph_zero_based":44754},{"literal_text_all_w_t_and_m_t":"–The fields childIEx-WithoutEM-vNx0 may not really need to be optional (depends on what is defined at the next lower level).","paragraph_zero_based":44755},{"literal_text_all_w_t_and_m_t":"–In general, especially when there are several nesting levels, fields should be marked as optional only when there is a clear reason.","paragraph_zero_based":44756},{"literal_text_all_w_t_and_m_t":"–ChildIE1-WithoutEM","paragraph_zero_based":44757},{"literal_text_all_w_t_and_m_t":"The IE ChildIE1-WithoutEM is an example of a lower level IE, used to control certain radio configurations including a configurable feature which can be setup or released using the local IE ChIE1-ConfigurableFeature. The example illustrates how the new field chIE1-NewField is added in release N to the configuration of the configurable feature. The example is based on the following assumptions:","paragraph_zero_based":44758},{"literal_text_all_w_t_and_m_t":"–When initially configuring as well as when modifying the new field, the original fields of the configurable feature have to be provided also i.e. as if the extended ones were present within the setup branch of this feature.","paragraph_zero_based":44759}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["2bf68a75f225629c07e9b13664bca1e9f76e993bafd89a880b9eb7c574d789c7","85508fa204453a9c1cecb31a54a7babf30d1cdf24488cdea0e5fc7ecef041f61","cd3c5da949f031dd82516ab34635f0e0ac320385deada409069f1baa3b73db8b","c15846d622539cfa97bafb729ee263d0cef5a6a0385add33d1c3209eacc3b413","5029c30f8677a31dffe41e12932644fc7ca8a568970f4e77850750e587d1c169","f00585608a873e79cf3ba2432b25bd5cb78fb65c6e95ec57427fe23fa42d30c8","74786ce613da55a2bd3512662704598f765a8bc1131573120285479867c4ef43","3946234b1727e4b4a28a393da1e80490de42393270848f2d32df5d15c075f276","6d7eb1f968c86e39efdd179253e22abbd4079b7db6c0f0f8037d0c5276ccc4ed","da6ec416c37a0f08ab783ac681e4009061fcd060db8caf8b971eafd2d324ed55","5f2404422a556648cd283a1c0a40e6458eb3ed8d74accce65a4a336aa64ee691","c4552ce157a7a3d9d8cac45b5227e4ba1dc3926ee4139a8e3a10d7b3ba783722","53476d706f4736ded4831a808e4998b3aafe68d1cf9d0f46a2ec01076eeeb206","3b1eb02d96d596ae371b3b81080b67f14e13e09e3ecd17b72dd9dacccbd86718","ad7c9e9b46db9b73ab56a03589e8275a100b16a95f273edff53e1555ec4aaa18","b5d80b14fd7ee05cdc4ea087f6d93bff37854da8db70d8a28bb0d18396697057","65dfec114a306a5d2c0789e199340c1a2833270611b7e27e4b76c16b895e8182","4a7529ba2ece43781af898565b5c14e4d4dfab6c3ae2af4df5d0e1c031ef08ab","48149f76f5a335e6986b48d98b19b93f1edded092675a967b0a6edf730e53dc7","c476db12d6d5afc3dcddf892e9839dd8ad46eeeec100522ba31ed955266836b3","efd4a7ebd96cec5834c39425fe48619c09124730b76375539b788100fe42dc18","eed3e1d07b74f59ecdc8241842842a71399452e86c758c801b3dea358e333372","c82283fa91c309146a5570d8a04cdcb296ac9efae4e04f980b56cb5513673a28","4f194415ea9a399904f7266be4369702a1a76c1a82b5b4e8be9716650e89e55d"],"paragraph_range_zero_based":[44736,44759],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p44736"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–When the configurable feature is released, the new field should be released also.","paragraph_zero_based":44760},{"literal_text_all_w_t_and_m_t":"–When omitting the original fields of the configurable feature the UE continues using the existing values (which is used to optimise the signalling for features that typically continue unchanged upon handover).","paragraph_zero_based":44761},{"literal_text_all_w_t_and_m_t":"–When omitting the new field of the configurable feature the UE releases the existing values and discontinues the associated functionality (which may be used to support release of unsupported functionality upon handover to an eNB supporting an earlier protocol version).","paragraph_zero_based":44762},{"literal_text_all_w_t_and_m_t":"The above assumptions, which affect the use of conditions and need codes, may not always apply. Hence, the example should not be re-used blindly.","paragraph_zero_based":44763},{"literal_text_all_w_t_and_m_t":"ChildIE1-WithoutEM information element","paragraph_zero_based":44764},{"literal_text_all_w_t_and_m_t":"-- /example/ ASN1START","paragraph_zero_based":44765},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44766},{"literal_text_all_w_t_and_m_t":"ChildIE1-WithoutEM ::=              SEQUENCE {","paragraph_zero_based":44767},{"literal_text_all_w_t_and_m_t":"    -- Root encoding, including:","paragraph_zero_based":44768},{"literal_text_all_w_t_and_m_t":"    chIE1-ConfigurableFeature           ChIE1-ConfigurableFeature       OPTIONAL        -- Need N","paragraph_zero_based":44769},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44770},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44771},{"literal_text_all_w_t_and_m_t":"ChildIE1-WithoutEM-vNx0 ::=     SEQUENCE {","paragraph_zero_based":44772},{"literal_text_all_w_t_and_m_t":"    chIE1-ConfigurableFeature-vNx0      ChIE1-ConfigurableFeature-vNx0  OPTIONAL    -- Cond ConfigF","paragraph_zero_based":44773},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44774},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44775},{"literal_text_all_w_t_and_m_t":"ChIE1-ConfigurableFeature ::=       CHOICE {","paragraph_zero_based":44776},{"literal_text_all_w_t_and_m_t":"    release                             NULL,","paragraph_zero_based":44777},{"literal_text_all_w_t_and_m_t":"    setup                               SEQUENCE {","paragraph_zero_based":44778},{"literal_text_all_w_t_and_m_t":"        -- Root encoding","paragraph_zero_based":44779},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":44780},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44781},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44782},{"literal_text_all_w_t_and_m_t":"ChIE1-ConfigurableFeature-vNx0 ::=  SEQUENCE {","paragraph_zero_based":44783}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["722f876d5e7628e11729f9f6d1a378daa8978b6a92ab70b93ae69dfdfedf0f3a","6b4aa26bb18e65bc5ae39d7e033cd51951e1a2a198aee63eb4bb6c48d6b6d8a6","2bc2fe0b5c5878e06233f6506482b9da7f9fa87900469c6db9334b5e8a8762d6","c2b7b378b7e3652b8c094453a9a1a989b7fae6d964bf4cb6acd5605117141d8e","750cee208045757610a479ee003a574151f69e8b33d9cf07b2f1ad76868d945f","8159d2a0a5ce241015a940b8a2ddb014d8ed19fe7e28ebc21e0deffcbc9f4ffd","9d7329c3fccbde4efd6fcc4bb996bd6a30200e7bbefb59e6f2834967edfe43d3","a065141e53a1f2c4c0698c039c350c0b935e434c8a721c1a40f06ce9af206108","105c42c9de2b20b37cfe329c47af4d49ebbcbcb1639af8769c8752cdce4f6e2b","8c8e1cff9818030246189561b52f88c542d8b0d4cd7c20903cdb23d9364e7836","21b3afb717d04e300c40d4490c30ba0dd9aa7f3a91fef47dc846bb158006151f","258d057fbda76f8be1480108219f28cff22b1556b2e4dd550af91f98b6003077","2cd0fd94d7792c2f9719aac72f2c553ea1ac22710bab55a174824fced550ed8d","3986892f048994ab978a1b61e4d11a513ea2ebd51a6237edb433abc9de68489f","965a1e3ade8a9a4666c0cd02109e1ac661a189a71f1725bce92923047fc2b551","58fc4b5d75630b07a9c424267c9b5ae1c16e093a08bcc1383949a14a9af412a9","5d2d3281b802266befdcff1346136de830d847bb1e39c427cee3212cc3fb64ba","dd46fc2fc091211310a009306bcb2dae9b5717476b6ccd2a116b27938cea07c1","2a7d0718bb1cdff98af0d592495239f4394f6c4dd9de7e4f93044389d4f3e14f","6624a92d52f798d49862ef480aa9a73a2e72ef80639a231fac89602db68d5ba9","b37103e07375abfd55377dc861d3ccbf873658dda8ecca6229c2ab0dec4009d2","d0bca30caea415bac6a8cfd4c5e7c34c63a833ab4997cb99d980c6373d1e905d","91d8f15d29755036a3eb53f36251be516c417f78e7e059e5bccf5ea118fc7fe8","bcb45d174b761b4d4cd56f7e4e1e92177e28ff443b6886ac923441645df23379"],"paragraph_range_zero_based":[44760,44783],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p44760"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    chIE1-NewField-rN                   INTEGER (0..31)","paragraph_zero_based":44784},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44785},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44786},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44787},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44788},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":44789},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":44790},{"literal_text_all_w_t_and_m_t":"ConfigF","paragraph_zero_based":44791},{"literal_text_all_w_t_and_m_t":"The field is optional present, need R, in case of chIE1-ConfigurableFeature is included and set to \"setup\"; otherwise the field is absent and the UE shall delete any existing value for this field.","paragraph_zero_based":44792},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44793},{"literal_text_all_w_t_and_m_t":"–ChildIE2-WithoutEM","paragraph_zero_based":44794},{"literal_text_all_w_t_and_m_t":"The IE ChildIE2-WithoutEM is an example of a lower level IE, typically used to control certain radio configurations. The example illustrates how the new field chIE1-NewField is added in release N to the configuration of the configurable feature.","paragraph_zero_based":44795},{"literal_text_all_w_t_and_m_t":"ChildIE2-WithoutEM information element","paragraph_zero_based":44796},{"literal_text_all_w_t_and_m_t":"-- /example/ ASN1START","paragraph_zero_based":44797},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44798},{"literal_text_all_w_t_and_m_t":"ChildIE2-WithoutEM ::=              CHOICE {","paragraph_zero_based":44799},{"literal_text_all_w_t_and_m_t":"    release                             NULL,","paragraph_zero_based":44800},{"literal_text_all_w_t_and_m_t":"    setup                               SEQUENCE {","paragraph_zero_based":44801},{"literal_text_all_w_t_and_m_t":"        -- Root encoding","paragraph_zero_based":44802},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":44803},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44804},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44805},{"literal_text_all_w_t_and_m_t":"ChildIE2-WithoutEM-vNx0 ::=         SEQUENCE {","paragraph_zero_based":44806},{"literal_text_all_w_t_and_m_t":"    chIE2-NewField-rN                   INTEGER (0..31)                 OPTIONAL    -- Cond ConfigF","paragraph_zero_based":44807}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["6d8c5b84154353bf4211eeb8637bf419c50b07718c927754015e94ac8e9eed13","0ecf215e26914c74a5b3c554412f050d7f036b106e12966ad73b5944b6435bc1","34f8d8abe71138cf263bf076c703a3b4305cbd492035ec3421033c6d1a5522ab","50a23a295ef3972f84a88ab149a8910538dee8c52e4e058da3003edd7dac58f2","3da37089f02c2965e579b6d364fbbe2b327f2d2c97de159b9ddc171812844f98","f93653c6122e5df13c69e974fde5944dbb95b09552bc93c305070fce31715c38","21ed089356abefec52acf5d3c9e9616a345d287438457e511f88dc0bff86dd22","3ce31a04f66e7a44ebb08b44b77e6a319f663edbaa2dabc785d8a8af94f96535","e10d785675ccadedab45e117fc843e657e282a0965bff7e013af35d4dc3cf2a4","dacc4276ecceccc3d2ddf51bdf8f698da66ace1593f53d03f1a2be3d71d124f5","2a9231408501b2bfc6b6ead02aff304dc62ab0b24e3a66e6edbd85a4eea788cb","7b9fd1ec296ee14f88b1f6e951f14090d6eadc8e75814cf1d3e1f9a7a245a5c3","3263bd47f574dbe65398efd5c390993595f57118045b90d86838965a68bd4c65","09bbfbb0e4906eb5cabbc3097854bb3d3c5499f03b3b56ff29f6e9f3f086540e","be19f0d1ce2b16868a5d9df0463f0359abed2219341ac3845826b70afa5c36b1","5f7cc876619a78c7a69027e423348f3528f9e78213d0c65b7ffbe20db4d79dd3","cc91921ecfd00fb6608c1d87850a79f63d91f4b0530c6e88b74bfdea4428b211","a0750d8f04dc2e6608d7a87364e4835ca417b87ab1ae597cd4b56bac3e7eff9e","37d35c19f5b4f911c5980e8345966c6f6d66a02d1bc03dc74794f30fff57a71a","7e2af41ac0bd88768eb768a78175691bdd5618f139a866c15900b7db2caadb9f","b9e998669ff95e1b98eeee81f3d8db93afb05d1d40b0053d0329dc817b154e59","c9994ff28c8a64291e6033928ab56186951e856f3ae53d0846f671ea2df0a9e7","bd5ceef1d511094c3b60d3c7d9d1542b1522a4698e63e8eadac2090c88d99ce6","f05246447a4597f4067cb956ac2ed94d096f05a3f8b3e4a1a9db9b9c91bd9b28"],"paragraph_range_zero_based":[44784,44807],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p44784"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44808},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44809},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44810},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44811},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":44812},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":44813},{"literal_text_all_w_t_and_m_t":"ConfigF","paragraph_zero_based":44814},{"literal_text_all_w_t_and_m_t":"The field is optional present, need R, in case of chIE2-ConfigurableFeature is included and set to \"setup\"; otherwise the field is absent and the UE shall delete any existing value for this field.","paragraph_zero_based":44815},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44816},{"literal_text_all_w_t_and_m_t":"A.4.3.6Non-critical extensions of lists with ToAddMod/ToRelease","paragraph_zero_based":44817},{"literal_text_all_w_t_and_m_t":"When the size of a list using the ToAddMod/ToRelease construction is extended and/or fields are added to the list element structure, the list should be non-critically extended in accordance with the following general principles:","paragraph_zero_based":44818},{"literal_text_all_w_t_and_m_t":"–When only the size of the list is extended, this extension is reflected in a non-critical extension of the list, with a \"SizeExt\" suffix added to the end of the field name (before the -vNxy suffix). The differential size of the extended list uses the suffix \"Diff\". A new ToRelease list is needed, and its range should include only the increase in list size. In many cases, extending the list size will also require an extended list element ID type to account for the increased size of the list; in these cases the element type will need to be extended to include the extended element ID, resulting in a more complex extension (see example 3 for further discussion of this case). The field description table should indicate that the UE considers the original list and the extension list as a single list; thus entries added with the original list can be modified by the extension list (or removed by the extension of the ToRelease list), or vice versa. The result is as shown in the following example:","paragraph_zero_based":44819},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44820},{"literal_text_all_w_t_and_m_t":"-- /example 1/ ASN1START","paragraph_zero_based":44821},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44822},{"literal_text_all_w_t_and_m_t":"ContainingStructure ::=             SEQUENCE {","paragraph_zero_based":44823},{"literal_text_all_w_t_and_m_t":"    listElementToAddModList              SEQUENCE (SIZE (1..maxNrofListElements)) OF ListElement             OPTIONAL,    -- Need N","paragraph_zero_based":44824},{"literal_text_all_w_t_and_m_t":"    listElementToReleaseList             SEQUENCE (SIZE (1..maxNrofListElements)) OF ListElementId           OPTIONAL,    -- Need N","paragraph_zero_based":44825},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":44826},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":44827},{"literal_text_all_w_t_and_m_t":"    -- Non-critical extension lists","paragraph_zero_based":44828},{"literal_text_all_w_t_and_m_t":"    listElementToAddModListSizeExt-vNxy  SEQUENCE (SIZE (1..maxNrofListElementsDiff-rN)) OF ListElement      OPTIONAL,    -- Need N","paragraph_zero_based":44829},{"literal_text_all_w_t_and_m_t":"    listElementToReleaseListSizeExt-vNxy SEQUENCE (SIZE (1..maxNrofListElementsDiff-rN)) OF ListElementId    OPTIONAL     -- Need N","paragraph_zero_based":44830},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":44831}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["75441ba323e6ad67ccad5a513ce2e6c69c91b5e50c4ee69d55aaecf6ef984b4c","d2bd4ed79f390a6336452be0c0cd6da5451e39ab78d90d14c3af029cc9f13a14","fe7c1e65451738ac5b740c943d1f1268b84c71eca9bb69df243487494d9a624a","07a5788c8cd40564f1d32caa35b50acf52a177744e2e8a57c8a7588bda2aae3d","7742d52305ce5b4ac32349fba4db00027f6cd4aa142fcde4a8b5a00a330ef56f","6b4a4488ed32700f508be2c3b1ea3c6cb7b58fb5c4e369b61434583d4947d0ea","595a50ef4f2643f5ab1b44915d0af5de3000ebd39d3bfdf443bd94e655c01cfc","68256eca1691b16335268d360697c8ae9c74557c329b1d548439ee5fc32c2f5b","ab2df772dbd4a11b05eb5f8ae3a1de4bcf50ea64e4ddc19a3442b7f99365ebcb","fa8c09aecd600c76044aae2e77b3974d438900369bc05f45d234eeceb778e3fb","4e57b1418d85c014e602a6da514756889152d3268e01a050068bdf55b959c3fa","72b93711602097fdc0299c8fc23f7b3da7d2c4bd11f8b8a7bf2d89ffc5955388","fd40fb96fb59c7d0e6424bfdcb5ddaf64446d540ed556357c19198d594bb1886","c78286a199390e1d9a2170f90c6b77bd80274ea2b235cb867e2eee0e84d51e27","94597a68beeda4694dcc1a07ffbdb826c41c8f9cba5d7b1a606550e139d8292d","e8c7eff3696ffb15cd4cd796efdeb7e511e25fc8406205a582c5e55879e53a77","4a68c0e29f2353e23f061699cdc5b1aff344da259946b63a5d3464c8f70c7ad2","1e7aa342eb190392cd10ae82797306602438be0e18eab4383185bc3ba56be49e","476e34c6eac12bbbc05f1dfc82775f28e570e5a38adcade98f0e13c382be34a5","a596bbe3a9aaa512d0ec774ea5c52378f79e3f5c36e43a1cd39d033df9cdaa19","2440a5709199964a209d5336d758a7f64e0749aa82c756cfc2560713e54fe33c","90948189c9e83e8c01dfe16421bf4f772a2f71cb260599c32f09f397301f8a0f","88029b2aa2eea1a89f1ad4a12cb0d24905fb1853d23f707fcb3b3fd397660bd9","a70b304c05fcbc409c212d6bac1949fd11b7f463ea42712a33371a35bf45f61c"],"paragraph_range_zero_based":[44808,44831],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p44808"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44832},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44833},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44834},{"literal_text_all_w_t_and_m_t":"–When fields are added to the list element structure, an extension marker should normally be used if available. If no extension marker is available or if overhead or other considerations prevent using the extension marker, an extension structure should be created for the new fields, with the suffix \"Ext\" added to the end of the field name and the element structure type name (before the -vNxy suffix), and a parallel ToAddMod list introduced to hold the new structures, also with the \"Ext\" suffix. The field description table should indicate that the parallel list contains the same number of entries, and in the same order, as the original list. No new ToRelease list is typically needed (unless the list element ID type changes). It should typically be ensured that the contained fields in the \"Ext\" elements are releasable without release and add of the entire list element; this can, for instance, be ensured by having the new fields be OPTIONAL Need R. If multiple extensions of the same list are needed, the version suffix should distinguish the lists (e.g. listElementToAddModListExt-vNwz added after listElementToAddModListExt-vNxy). The result is as shown in the following example:","paragraph_zero_based":44835},{"literal_text_all_w_t_and_m_t":"-- /example 2/ ASN1START","paragraph_zero_based":44836},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44837},{"literal_text_all_w_t_and_m_t":"ContainingStructure ::=             SEQUENCE {","paragraph_zero_based":44838},{"literal_text_all_w_t_and_m_t":"    listElementToAddModList             SEQUENCE (SIZE (1..maxNrofListElements)) OF ListElement             OPTIONAL,    -- Need N","paragraph_zero_based":44839},{"literal_text_all_w_t_and_m_t":"    listElementToReleaseList            SEQUENCE (SIZE (1..maxNrofListElements)) OF ListElementId           OPTIONAL,    -- Need N","paragraph_zero_based":44840},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":44841},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":44842},{"literal_text_all_w_t_and_m_t":"    -- Parallel list","paragraph_zero_based":44843},{"literal_text_all_w_t_and_m_t":"    listElementToAddModListExt-vNxy     SEQUENCE (SIZE (1..maxNrofListElements)) OF ListElementExt-vNxy     OPTIONAL     -- Need N","paragraph_zero_based":44844},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":44845},{"literal_text_all_w_t_and_m_t":"[[","paragraph_zero_based":44846},{"literal_text_all_w_t_and_m_t":"-- Second parallel list from a later spec version","paragraph_zero_based":44847},{"literal_text_all_w_t_and_m_t":"listElementToAddModListExt-vNwzSEQUENCE (SIZE (1..maxNrofListElements)) OF ListElementExt-vNwz     OPTIONAL    -- Need N","paragraph_zero_based":44848},{"literal_text_all_w_t_and_m_t":"]]","paragraph_zero_based":44849},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44850},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44851},{"literal_text_all_w_t_and_m_t":"ListElement ::=                      SEQUENCE {","paragraph_zero_based":44852},{"literal_text_all_w_t_and_m_t":"    elementId                            ListElementId,","paragraph_zero_based":44853},{"literal_text_all_w_t_and_m_t":"    field1                               INTEGER (0..3),","paragraph_zero_based":44854},{"literal_text_all_w_t_and_m_t":"    field2                               ENUMERATED { value1, value2, value3 }","paragraph_zero_based":44855}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["b291d956995cfefdb86203fff6e6a84d74a48839c02677a8b6c3fdded530b8dc","3947883e30722bc18ac842bc4b3c4f056e3f5fe056dcc7196dafe4c6cab7d08f","378c1b97408840c2ff6d5e7e00d16e0362b645d7be5b41c159565c0b90ffabe7","c5f7191d520cb068c2cc56e5500423607295865b5fb3a11d2912f7e04ed8b18a","2b7f8af5f7bd4292cd68abdf4a37febc8cee227c78e1254b1d61b5d4fb27c15c","b3e828773719668af64468a9c3a8ba757342aafb34eab9feaa0e556be4d77ad1","8754fceca2472fa39f9b5dd4d429c7c0ad24aaa280946287e660a11cab76f071","85b6d1ca3e8a2583fe70876e1e8271a2479c53dcb022260acef8aab46445ff63","aa4cf8501349ed40696ce5e3e579dfbac639954e4ed18994c05098caa14b5bf4","8990a0475eaaf659d0d50e2cca15864dec6b1e444c368da13d1987c54c419310","5b7ba8a78049abe70a6774e3c59af955dfa584c770735716990fa6330d4b0f9c","761956cd6b624a36283567740fbbbbba2e476baf186eab01077f85e1ec7cadc5","00f0d34e39cf1c0f684a72222a77aaac96729f527a0086a355e25dbbf7269f04","0aab22806ef2e1675716621ff32321d242fd55b9274d039df4b488e54f645c1e","251529cddeca84e5ef8a09c85a4dc9df3dec2cb966ec995e12a53ce1beaa8888","c3e62ad51ffbbfffedd7eb7c2c88519136cee6780c9e115e20f52d2a39a5acfc","a5340f74ae71c6f858a086044a7fdd1e548032fe594ea70ebebd5848c25225dc","cb9379d895c7e4a1efd6f8613d589bac03f7b9245e90ac97379cf1175ce1f69c","54e980e79d7642c2d273204a2134cb9cabc50e1ae572587a40f6f4b7689fb1d2","ca78c68aca7117a65dbca563da1467574865e204b03c5c722f35a7c300966ce6","9bc94fdf76d1ea7119e972eac7efd6d609e149066bbfedb2269e06772f81b809","795cd8b46f3c866351871340e67efae7bf39d388997cb41d887fbf4e495ae85e","462e087bd49c265e461d2547b9234af60ea6e469e21db1c017b29d28d264d8cf","d751ba11891de1584d78b53b875a2ac458deadc2f6aae28339837ef20f970c1c"],"paragraph_range_zero_based":[44832,44855],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_