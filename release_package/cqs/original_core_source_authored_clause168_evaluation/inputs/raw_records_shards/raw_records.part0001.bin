{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    txParameters-r16                   SEQUENCE {","paragraph_zero_based":39648},{"literal_text_all_w_t_and_m_t":"        syncTxThreshIC-r16                 SL-RSRP-Range-r16                                                   OPTIONAL,    -- Need R","paragraph_zero_based":39649},{"literal_text_all_w_t_and_m_t":"        syncTxThreshOoC-r16                SL-RSRP-Range-r16                                                   OPTIONAL,    -- Need R","paragraph_zero_based":39650},{"literal_text_all_w_t_and_m_t":"        syncInfoReserved-r16               BIT STRING (SIZE (2))                                               OPTIONAL     -- Need R","paragraph_zero_based":39651},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":39652},{"literal_text_all_w_t_and_m_t":"    gnss-Sync-r16                      ENUMERATED {true}                                                       OPTIONAL,    -- Need R","paragraph_zero_based":39653},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":39654},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39655},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39656},{"literal_text_all_w_t_and_m_t":"SL-RSRP-Range-r16 ::=                  INTEGER (0..13)","paragraph_zero_based":39657},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39658},{"literal_text_all_w_t_and_m_t":"SL-SSB-TimeAllocation-r16 ::=          SEQUENCE {","paragraph_zero_based":39659},{"literal_text_all_w_t_and_m_t":"    sl-NumSSB-WithinPeriod-r16             ENUMERATED {n1, n2, n4, n8, n16, n32, n64}                          OPTIONAL,    -- Need R","paragraph_zero_based":39660},{"literal_text_all_w_t_and_m_t":"    sl-TimeOffsetSSB-r16                   INTEGER (0..1279)                                                   OPTIONAL,    -- Need R","paragraph_zero_based":39661},{"literal_text_all_w_t_and_m_t":"    sl-TimeInterval-r16                    INTEGER (0..639)                                                    OPTIONAL     -- Need R","paragraph_zero_based":39662},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39663},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39664},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SYNCCONFIG-STOP","paragraph_zero_based":39665},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39666},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39667},{"literal_text_all_w_t_and_m_t":"SL-SyncConfig field descriptions","paragraph_zero_based":39668},{"literal_text_all_w_t_and_m_t":"gnss-Sync","paragraph_zero_based":39669},{"literal_text_all_w_t_and_m_t":"If configured, the synchronization configuration is used for SLSS transmission/reception when the UE is synchronized to GNSS. If not configured, the synchronization configuration is used for SLSS transmission/reception when the UE is synchronized to eNB/gNB.","paragraph_zero_based":39670},{"literal_text_all_w_t_and_m_t":"sl-SyncRefMinHyst","paragraph_zero_based":39671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["47e521e402030235e12f79c4c9576e3b16162866d6c78bf705ca4f5f9453ef80","cda658b74f36d97307f17d877bb530135bc151e2e8392308c2502ba0f690b593","ab0216a885bc77fcaddd09be380d42a4b2f2dd5c04152afb9181cb20155865ee","58b188de08c9d4f50281ea371d036a1437f6de264d794d85ec50549067d8373e","118007bdda2a671b4e1611a2af62eea0ac96ce859d67a2c4214da26d537e368d","9cb2b9c0f0c38c37769c4e7bf294ead5e9a77b96ab605d4d4d645d50de27753e","8366dd77984552f6499ce92156b0a95288d0ce4009ddfbef6a02a668ec2dc4b8","7de015