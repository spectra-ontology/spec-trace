    INTEGER (1..2)                                                              OPTIONAL,   -- Need R","paragraph_zero_based":28596},{"literal_text_all_w_t_and_m_t":"    pdsch-AggregationFactor-r16     ENUMERATED {n1, n2, n4, n8 }                                                OPTIONAL    -- Need S","paragraph_zero_based":28597},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":28598},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":28599},{"literal_text_all_w_t_and_m_t":"    sps-HARQ-Deferral-r17           INTEGER (1..32)                                                             OPTIONAL,   -- Need R","paragraph_zero_based":28600},{"literal_text_all_w_t_and_m_t":"    n1PUCCH-AN-PUCCHsSCell-r17      PUCCH-ResourceId                                                            OPTIONAL,   -- Need R","paragraph_zero_based":28601},{"literal_text_all_w_t_and_m_t":"    periodicityExt-r17              INTEGER (1..40960)                                                          OPTIONAL,   -- Need R","paragraph_zero_based":28602},{"literal_text_all_w_t_and_m_t":"    nrofHARQ-Processes-v1710        INTEGER(9..32)                                                              OPTIONAL,   -- Need R","paragraph_zero_based":28603},{"literal_text_all_w_t_and_m_t":"    harq-ProcID-Offset-v1700        INTEGER (16..31)                                                            OPTIONAL    -- Need R","paragraph_zero_based":28604},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":28605},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28606},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28607}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["605ff17eed0274bd8b01ded1054c5509462f63c50f335b5b701deea3cebbccad","f9ad9c456e20f52d58cc205245b1a7b3e77b8bcfac8db709ced7c392dd4547bf","bcfea9ffba9dba16447bcc3543dc6d3d3cb6849b1ef552e6d0168df64ddb1f11","43b05027c431a2ec87ad7f22257da556ef6cd3063515d728a29fd1924d17fada","3998a9d91603df2a92c59811914cb28c7ae09fcf1ef4f8afda9cd0ca8c6f0c9e","a8a943a30465071022e05e00033c84325ad73d5f15ab769fc33e60bb7baf936e","c4c038bc7c4b7e7dde5782e7597b2c5ea622a3d016348bc094b1162c6028a367","2932f1015380d552572b598dc3bbe23959c11d3b67fed5f4afa17b67661ef0ff","363b53075301b7cac03de7f0638d3be6b5218fd6b77eeba4c3264a75b5a2ad9c","09ff8a626257b1ba49bb153da3534902dd30877ac23766866c17e36798d123bd","fc9fa6388fe2c7cefa55633e4af57fa24a071e5c216b1c37f2cd23c563a5b674","e107e3775253746d62d739ac4db916751f494107f09c2cf376d92bf95ecdc1cf","d479865a724ffe524b4f0af105a3b6f625fda52dfdf51c66b814535339c9a5e8","d19e11bb30cca1d5c13ebc1947e9b161a49537964ae995a15deae2a86b8292a2","f1e50ca0309ac7565be527ac4d1c599d4277946dce88b821c71d313bcc395958","9c0022e7cad6f4ebb1029783cea149d812f1b797b604ba7f6aad2042bd18c5ba","6b538b5796be30d8af0f8d8b6e8ccdd35271df41e0bdff545885db6150c9fb94","863454bcffc532661f9909280bb0f519dd4c807a9144e8112560797b9b16c925","3aafd96ed614949de344da6b2c92442af0c407b6de211b379997a894be5549de","633d049fff503f13b0ff72426313cf33f5b50a8cddbaab4aaa1e3beba3e90c99","b002c496528ce9df385ec72f165df664cdf56d6db78b86f71a9ea602cee786b7","97666c89f757455a81f379f88a5c0f3d28c9b55ff40844987c3eb218b7e58f61","b789eef2f6c39f537f97cd5d5069f9e52b71e0be05da0e3fc5eb11e7e5bcc80a","99b3f65b67f0c3d547fb4592db6d5e11d68fc4b0b34a58976530e4c4d18bca73"],"paragraph_range_zero_based":[28584,28607],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p28584"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-SPS-CONFIG-STOP","paragraph_zero_based":28608},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28609},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28610},{"literal_text_all_w_t_and_m_t":"SPS-Config field descriptions","paragraph_zero_based":28611},{"literal_text_all_w_t_and_m_t":"harq-CodebookID","paragraph_zero_based":28612},{"literal_text_all_w_t_and_m_t":"Indicates the HARQ-ACK codebook index for the corresponding HARQ-ACK codebook for SPS PDSCH and ACK for SPS PDSCH release.","paragraph_zero_based":28613},{"literal_text_all_w_t_and_m_t":"harq-ProcID-Offset","paragraph_zero_based":28614},{"literal_text_all_w_t_and_m_t":"Indicates the offset used in deriving the HARQ process IDs, see TS 38.321 [3], clause 5.3.1.","paragraph_zero_based":28615},{"literal_text_all_w_t_and_m_t":"mcs-Table","paragraph_zero_based":28616},{"literal_text_all_w_t_and_m_t":"Indicates the MCS table the UE shall use for DL SPS (see TS 38.214 [19],clause 5.1.3.1. If present, the UE shall use the MCS table of low-SE 64QAM table indicated in Table 5.1.3.1-3 of TS 38.214 [19]. If this field is absent and field mcs-table in PDSCH-Config is set to 'qam256' and the activating DCI is of format 1_1, the UE applies the 256QAM table indicated in Table 5.1.3.1-2 of TS 38.214 [19]. If this field is absent and the field mcs-Table-r17 in PDSCH-Config is set to 'qam1024' and the activating DCI is format 1_1, the UE applies the 1024QAM table indicated in Table 5.1.3.1-4 of TS 38.214 [19]. Otherwise, the UE applies the non-low-SE 64QAM table indicated in Table 5.1.3.1-1 of TS 38.214 [19].","paragraph_zero_based":28617},{"literal_text_all_w_t_and_m_t":"n1PUCCH-AN","paragraph_zero_based":28618},{"literal_text_all_w_t_and_m_t":"HARQ resource for PUCCH for DL SPS. The network configures the resource either as format0 or format1. The actual PUCCH-Resource is configured in PUCCH-Config and referred to by its ID. See TS 38.213 [13], clause 9.2.3.","paragraph_zero_based":28619},{"literal_text_all_w_t_and_m_t":"n1PUCCH-AN-PUCCHsSCell","paragraph_zero_based":28620},{"literal_text_all_w_t_and_m_t":"HARQ resource for PUCCH on PUCCH switching SCell (sSCell) for DL SPS. The network configures the resource either as format 0 or format 1. The actual PUCCH-Resource is configured in PUCCH-Config of the PUCCH sSCell and referred to by its ID. See TS 38.213 [13], clause 9.2.3.","paragraph_zero_based":28621},{"literal_text_all_w_t_and_m_t":"nrofHARQ-Processes","paragraph_zero_based":28622},{"literal_text_all_w_t_and_m_t":"Number of configured HARQ processes for SPS DL (see TS 38.321 [3], clause 5.8.1). If UE is configured with nrofHARQ-Processes-v1710 UE shall ignore nrofHARQ-Processes (without suffix).","paragraph_zero_based":28623},{"literal_text_all_w_t_and_m_t":"pdsch-AggregationFactor","paragraph_zero_based":28624},{"literal_text_all_w_t_and_m_t":"Number of repetitions for SPS PDSCH (see TS 38.214 [19], clause 5.1.2.1). When the field is absent, the UE applies the value 1 for MBS multicast data and the pdsch-AggregationFactor in pdsch-Config for other data.","paragraph_zero_based":28625},{"literal_text_all_w_t_and_m_t":"periodicity","paragraph_zero_based":28626},{"literal_text_all_w_t_and_m_t":"Periodicity for DL SPS (see TS 38.214 [19] and TS 38.321 [3], clause 5.8.1).","paragraph_zero_based":28627},{"literal_text_all_w_t_and_m_t":"periodicityExt","paragraph_zero_based":28628},{"literal_text_all_w_t_and_m_t":"This field is used to calculate the periodicity for DL SPS (see TS 38.214 [19] and see TS 38.321 [3], clause 5.8.1). If this field is present, the field periodicity is ignored.","paragraph_zero_based":28629},{"literal_text_all_w_t_and_m_t":"The following periodicities are supported depending on the configured subcarrier spacing [ms]:","paragraph_zero_based":28630},{"literal_text_all_w_t_and_m_t":"15 kHz:periodicityExt, where periodicityExt has a value between 1 and 640.","paragraph_zero_based":28631}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["4c89bdbd144fecaf29db118cec537d3e6431d3fe9600aedeb276b349583d65e9","30fb0c28fc239c500c67da541f0f9f1a0921c15814fe2e456197453db090c16a","d81dbdbad8ffc84be38b827d05397d5f40a13c988c47ec1b2f6de9a1a01834e9","48f2dc49f08f76441294d6f5548257b5aca724c774af0d17c3934ba71313fbc3","9edd298469d55f3db59cf805a0ac8fda668674ed10e1e990ecc6fcfb7df7a3b8","dbe159e3f0063d2ecf00b37ea4bc3bacb6ab6dfe915aff22a805750039c0127d","aa70d233ddeeb1f048452b464387661e3b6751693551bb92fc350fccc6d93a6c","3a925b730e1113f7fa654ac213479585f68fd96ad9f1f34556043d0a10333105","d7d36509dc5ae65f8bb6b470aae8f34ea4a869d7ce7d4bd6a99f43026be5550d","1cfa3ed12fb6ccd942c5e60cf706424c7877bc45405a41924d6379862d3a91fb","aeb31b5eca533ae054b5668cc106a5278f96301052855e3722c88cd8a1b34219","7ab991c0ab511abc43010a60e9dc72c1076d1357192a8648e35a567771a7123f","13afb3b097d1afb3c042982d746d02b8d354b41eee4688257ebe7d4929278654","6707c1050c513b70b3f8b2ed39d0d9c08309c4fbb5e0d62aa530a81672fea7c4","569207b8916179c6ce645b58331629f642e9bf3423aae4ba4efb0875fbe61648","67793ef8b2b4fed5f5c833f7c5ceca3838b16810035378953e7b376ee766985e","bc28eeb2072dc7073f832056e24b8703671d11d90fc18bc2d68cd22114670338","6a58a5e5a84009b9994626a4936a5672ea8c2bc9959a107576895d6dde8ade0f","12883570f3f2976886a45e23e498a89071b7cdd349233589b49a3f9225d0ca04","6e8bbfa121d431d75a0be42bb34095ce8d679380f7af15132d74bdb9ffb4dcc5","e07e27fbc3091fe3e327ebd3d46d353a667d030a1b26a734447d25aa250ecb19","a00e079bc7b50cb4e931d78692453a6d656727ec0ba5c4afcc992f138edcad50","5270b516453426b5a3c87b59cc4b813c4970bdb625482ccc01eca49cc037a3c1","bb7963b9e10ecf927e06db65b82cb31e9a79fabcf4527f9ff436af30a287a468"],"paragraph_range_zero_based":[28608,28631],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p28608"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"30 kHz:0.5 x periodicityExt, where periodicityExt has a value between 1 and 1280.","paragraph_zero_based":28632},{"literal_text_all_w_t_and_m_t":"60 kHz with normal CP.0.25 x periodicityExt, where periodicityExt has a value between 1 and 2560.","paragraph_zero_based":28633},{"literal_text_all_w_t_and_m_t":"60 kHz with ECP:0.25 x periodicityExt, where periodicityExt has a value between 1 and 2560.","paragraph_zero_based":28634},{"literal_text_all_w_t_and_m_t":"120 kHz:0.125 x periodicityExt, where periodicityExt has a value between 1 and 5120.","paragraph_zero_based":28635},{"literal_text_all_w_t_and_m_t":"480 kHz:0.03125 x periodicityExt, where periodicityExt has a value between 1 and 20480.","paragraph_zero_based":28636},{"literal_text_all_w_t_and_m_t":"960 kHz:0.015625 x periodicityExt, where periodicityExt has a value between 1 and 40960.","paragraph_zero_based":28637},{"literal_text_all_w_t_and_m_t":"periodicityExt-r17 is only applicable for SCS 480 kHz and 960 kHz.","paragraph_zero_based":28638},{"literal_text_all_w_t_and_m_t":"sps-ConfigIndex","paragraph_zero_based":28639},{"literal_text_all_w_t_and_m_t":"Indicates the index of one of multiple SPS configurations.","paragraph_zero_based":28640},{"literal_text_all_w_t_and_m_t":"sps-HARQ-Deferral","paragraph_zero_based":28641},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of slots or subslots the transmission of DL SPS HARQ-ACK in a slot or subslot can be deferred (see TS 38.213 [13], clause 9.2.5.4).","paragraph_zero_based":28642},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28643},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":28644},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":28645},{"literal_text_all_w_t_and_m_t":"SPS-List","paragraph_zero_based":28646},{"literal_text_all_w_t_and_m_t":"The field is mandatory present when included in sps-ConfigToAddModList-r16 or sps-ConfigMulticastToAddModList-r17, otherwise the field is absent.","paragraph_zero_based":28647},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28648},{"literal_text_all_w_t_and_m_t":"–SPS-ConfigIndex","paragraph_zero_based":28649},{"literal_text_all_w_t_and_m_t":"The IE SPS-ConfigIndex is used to indicate the index of one of multiple DL SPS configurations in one BWP.","paragraph_zero_based":28650},{"literal_text_all_w_t_and_m_t":"SPS-ConfigIndex information element","paragraph_zero_based":28651},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28652},{"literal_text_all_w_t_and_m_t":"-- TAG-SPS-CONFIGINDEX-START","paragraph_zero_based":28653},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28654},{"literal_text_all_w_t_and_m_t":"SPS-ConfigIndex-r16             ::= INTEGER (0.. maxNrofSPS-Config-1-r16)","paragraph_zero_based":28655}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["ed3905005da3c2f17e63ef43a828d05ca5de07f5ac4c153102ba1869bd526da0","b9015d48bdeb639ee9d294c17494c7640eab943d3737a52d08995a8606a74756","3f95d133ed6b136c3bb268b6cc890b275d8f38d97a0a59d6076d884b25823273","d6e39da1452265e4809806ce76132bd71ffd2a40c262d97ecb42dc7fad8b6909","d669d70d101bedb2b99b58679f34c7a51a6c9459522b50b344c6528b7c98fc44","f0a020b8fee4744bb74e4dc5857fc3a9f7f4702afebc748a4ff01d1c5383076c","9f41d809739c9cd851b10045a57b353658f4773a20706ce7b84a58eb9598e7b8","c142c05b886d471465e431aac99a0ff7df30ccfd832fc32f8aa36b19c670f5b2","da5938ff3a7e882605dfeb1e203109d49b2d5a8fd9674faa155b026328ae0092","267f78f317ff8d4bed3d8be8e