{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SchedulingRequestResourceConfigExt-v1700 ::=    SEQUENCE {","paragraph_zero_based":26688},{"literal_text_all_w_t_and_m_t":"    periodicityAndOffset-r17                        CHOICE {","paragraph_zero_based":26689},{"literal_text_all_w_t_and_m_t":"        sl1280                                          INTEGER (0..1279),","paragraph_zero_based":26690},{"literal_text_all_w_t_and_m_t":"        sl2560                                          INTEGER (0..2559),","paragraph_zero_based":26691},{"literal_text_all_w_t_and_m_t":"        sl5120                                          INTEGER (0..5119)","paragraph_zero_based":26692},{"literal_text_all_w_t_and_m_t":"    }                                                                                                       OPTIONAL   -- Need M","paragraph_zero_based":26693},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":26694},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26695},{"literal_text_all_w_t_and_m_t":"-- TAG-SCHEDULINGREQUESTRESOURCECONFIG-STOP","paragraph_zero_based":26696},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26697},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26698},{"literal_text_all_w_t_and_m_t":"SchedulingRequestResourceConfig field descriptions","paragraph_zero_based":26699},{"literal_text_all_w_t_and_m_t":"periodicityAndOffset","paragraph_zero_based":26700},{"literal_text_all_w_t_and_m_t":"SR periodicity and offset in number of symbols or slots (see TS 38.213 [13], clause 9.2.4) The following periodicities may be configured depending on the chosen subcarrier spacing:","paragraph_zero_based":26701},{"literal_text_all_w_t_and_m_t":"SCS =  15 kHz: 2sym, 7sym, 1sl, 2sl, 4sl, 5sl, 8sl, 10sl, 16sl, 20sl, 40sl, 80sl","paragraph_zero_based":26702},{"literal_text_all_w_t_and_m_t":"SCS =  30 kHz: 2sym, 7sym, 1sl, 2sl, 4sl, 8sl, 10sl, 16sl, 20sl, 40sl, 80sl, 160sl","paragraph_zero_based":26703},{"literal_text_all_w_t_and_m_t":"SCS =  60 kHz: 2sym, 7sym/6sym, 1sl, 2sl, 4sl, 8sl, 16sl, 20sl, 40sl, 80sl, 160sl, 320sl","paragraph_zero_based":26704},{"literal_text_all_w_t_and_m_t":"SCS = 120 kHz: 2sym, 7sym, 1sl, 2sl, 4sl, 8sl, 16sl, 40sl, 80sl, 160sl, 320sl, 640sl","paragraph_zero_based":26705},{"literal_text_all_w_t_and_m_t":"SCS = 480 kHz: 1sl, 2sl, 4sl, 8sl, 16sl, 40sl, 80sl, 160sl, 320sl, 640sl, 1280sl, 2560sl","paragraph_zero_based":26706},{"literal_text_all_w_t_and_m_t":"SCS = 960 kHz: 1sl, 2sl, 4sl, 8sl, 16sl, 40sl, 80sl, 160sl, 320sl, 640sl, 1280sl, 2560sl, 5120sl","paragraph_zero_based":26707},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26708},{"literal_text_all_w_t_and_m_t":"sym6or7 corresponds to 6 symbols if extended cyclic prefix and a SCS of 60 kHz are configured, otherwise it corresponds to 7 symbols.","paragraph_zero_based":26709},{"literal_text_all_w_t_and_m_t":"For periodicities 2sym, 7sym and sl1 the UE assumes an offset of 0 slots.","paragraph_zero_based":26710},{"literal_text_all_w_t_and_m_t":"If periodicityAndOffset-r17 is present, any previously configured periodicityAndOffset (without suffix) is released, and vice versa.","paragraph_zero_based":26711}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["9ba9e353beb2ca95c8dea2d3f22f9c09eab189db10c9b7c419d77c42b43b1a09","07d565f722587b707e734c5019e7726eabe4314c3ef77cc5395b421202cbff3f","028c42d27bede586b0ad43e2292f1bded1292966587bba554db050fe987b5efe","1f357d4118535a79889e3d6b1505ca4cc32b4725902046a03867119a75eb9f01","d8f8f74d134f1e5ce2f