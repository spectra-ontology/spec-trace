{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field indicates the support of NR sidelink non-relay discovery.","paragraph_zero_based":13992},{"literal_text_all_w_t_and_m_t":"sl-NR-AnchorCarrierFreqList","paragraph_zero_based":13993},{"literal_text_all_w_t_and_m_t":"This field indicates the NR anchor carrier frequency list, which can provide the NR sidelink communication/discovery configurations.","paragraph_zero_based":13994},{"literal_text_all_w_t_and_m_t":"sl-OffsetDFN","paragraph_zero_based":13995},{"literal_text_all_w_t_and_m_t":"Indicates the timing offset for the UE to determine DFN timing when GNSS is used for timing reference. Value 1 corresponds to 0.001 milliseconds, value 2 corresponds to 0.002 milliseconds, and so on.","paragraph_zero_based":13996},{"literal_text_all_w_t_and_m_t":"sl-RadioBearerConfigList","paragraph_zero_based":13997},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple sidelink radio bearer configurations.","paragraph_zero_based":13998},{"literal_text_all_w_t_and_m_t":"sl-RLC-BearerConfigList","paragraph_zero_based":13999},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple sidelink RLC bearer configurations.","paragraph_zero_based":14000},{"literal_text_all_w_t_and_m_t":"sl-SSB-PriorityNR","paragraph_zero_based":14001},{"literal_text_all_w_t_and_m_t":"This field indicates the priority of NR sidelink SSB transmission and reception.","paragraph_zero_based":14002},{"literal_text_all_w_t_and_m_t":"t400","paragraph_zero_based":14003},{"literal_text_all_w_t_and_m_t":"Indicates the value for timer T400 as described in clause 7.1. Value ms100 corresponds to 100 ms, value ms200 corresponds to 200 ms and so on.","paragraph_zero_based":14004},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14005},{"literal_text_all_w_t_and_m_t":"–SIB13","paragraph_zer