{"fields":{"filename":"R2-2400190.zip::R2-2400190_SDT CR 38306 for TEI18_v2a.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Access Category 1 selection assistance information enhancement","paragraph_zero_based":120},{"literal_text_all_w_t_and_m_t":"It is optional for UE that is configured for delay tolerant service to support Access Category 1 selection assistance information enhancement, according to uac-AC1-SelectAssistInfo-r16 as specified in TS 38.331 [9].","paragraph_zero_based":121},{"literal_text_all_w_t_and_m_t":"eCall over IMS","paragraph_zero_based":122},{"literal_text_all_w_t_and_m_t":"It is optional for UE to support eCall over IMS as specified in TS 38.331 [9].","paragraph_zero_based":123},{"literal_text_all_w_t_and_m_t":"Equivalent SNPNs for cell (re)selection","paragraph_zero_based":124},{"literal_text_all_w_t_and_m_t":"It is optional for UE in SNPN access mode to support cell (re)selection for equivalent SNPNs as specified in TS 38.304 [21].","paragraph_zero_based":125},{"literal_text_all_w_t_and_m_t":"HSDN cell reselection","paragraph_zero_based":126},{"literal_text_all_w_t_and_m_t":"It is optional for UE to support HSDN cell reselection priority handling in RRC_IDLE/RRC_INACTIVE as specified in TS 38.304 [21] and TS 38.331 [9].","paragraph_zero_based":127},{"literal_text_all_w_t_and_m_t":"Minimization of service interruption","paragraph_zero_based":128},{"literal_text_all_w_t_and_m_t":"It is optional for UE to support minimization of service interruption including reporting to NAS of disaster roaming information for available PLMNs and Access Barring check for Access Identity 3, as specified in TS 38.331 [9].","paragraph_zero_based":129},{"literal_text_all_w_t_and_m_t":"Mobile IAB cell reselection","paragraph_zero_based":130},{"literal_text_all_w_t_and_m_t":"It is optional for UE to support mobile IAB cell reselection priority handling in RRC_IDLE/RRC_INACTIVE, as specified in TS 38.304 [21] and TS 38.331 [9].","paragraph_zero_based":131},{"literal_text_all_w_t_and_m_t":"Random access prioritization for MPS and MCS","paragraph_zero_based":132},{"literal_text_all_w_t_and_m_t":"It is optional for UE that is configured for MPS or MCS to support random access prioritization for Access Identity 1 or 2 as specified in TS 38.321 [8].","paragraph_zero_based":133},{"literal_text_all_w_t_and_m_t":"Random access prioritisation for Slicing","paragraph_zero_based":134},{"literal_text_all_w_t_and_m_t":"It is optional for UE to support slice-based prioritisation for random access as specified in TS 38.321 [8].","paragraph_zero_based":135},{"literal_text_all_w_t_and_m_t":"Random access partitioning for Slicing","paragraph_zero_based":136},{"literal_text_all_w_t_and_m_t":"It is optional for UE to support slice-based RACH partitioning as specified in TS 38.321 [8].","paragraph_zero_based":137},{"literal_text_all_w_t_and_m_t":"Relaxed cell reselection on GEO","paragraph_zero_based":138},{"literal_text_all_w_t_and_m_t":"It is optional for UE to support the relaxed cell reselection on GEO.","paragraph_zero_based":139},{"literal_text_all_w_t_and_m_t":"Support of polarization signalling in NR NTN","paragraph_zero_based":140},{"literal_text_all_w_t_and_m_t":"It is optional for UE to support the polarization signalling in NR NTN comprised of the following functional components:","paragraph_zero_based":141},{"literal_text_all_w_t_and_m_t":"-Support polarization indication reception in SIB indicating DL and/or UL polarization information using respective polarization type parameters to indicate: RHCP or LHCP or linear;","paragraph_zero_based":142},{"literal_text_all_w_t_and_m_t":"-Support polarization signalling for target serving cell in handover command message;","paragraph_zero_based":143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"f3779c4942