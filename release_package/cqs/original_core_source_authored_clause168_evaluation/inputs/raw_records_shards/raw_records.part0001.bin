{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"AvailabilityCombinationRB-Groups field descriptions","paragraph_zero_based":14640},{"literal_text_all_w_t_and_m_t":"rb-SetGroups","paragraph_zero_based":14641},{"literal_text_all_w_t_and_m_t":"Indicates the RB set groups configured for the availability combination. Each group includes consecutive RB sets.","paragraph_zero_based":14642},{"literal_text_all_w_t_and_m_t":"rb-Sets","paragraph_zero_based":14643},{"literal_text_all_w_t_and_m_t":"Indicates the one or more RB set indexes associated to one or more RB sets configured for one RB set group.","paragraph_zero_based":14644},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14645},{"literal_text_all_w_t_and_m_t":"–AvailabilityIndicator","paragraph_zero_based":14646},{"literal_text_all_w_t_and_m_t":"The IE AvailabilityIndicator is used to configure monitoring a PDCCH for Availability Indicators (AI).","paragraph_zero_based":14647},{"literal_text_all_w_t_and_m_t":"AvailabilityIndicator information element","paragraph_zero_based":14648},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":14649},{"literal_text_all_w_t_and_m_t":"-- TAG-AVAILABILITYINDICATOR-START","paragraph_zero_based":14650},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14651},{"literal_text_all_w_t_and_m_t":"AvailabilityIndicator-r16 ::=    SEQUENCE {","paragraph_zero_based":14652},{"literal_text_all_w_t_and_m_t":"    ai-RNTI-r16                      AI-RNTI-r16,","paragraph_zero_based":14653},{"literal_text_all_w_t_and_m_t":"    dci-PayloadSizeAI-r16            INTEGER (1..maxAI-DCI-PayloadSize-r16),","paragraph_zero_based":14654},{"literal_text_all_w_t_and_m_t":"    availableCombToAddModList-r16    SEQUENCE (SIZE(1..maxNrofDUCells-r16)) OF AvailabilityCombinationsPerCell-r16          OPTIONAL, -- Need N","paragraph_zero_b