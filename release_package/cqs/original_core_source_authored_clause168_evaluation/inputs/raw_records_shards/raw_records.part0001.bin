{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38832},{"literal_text_all_w_t_and_m_t":"–SL-RadioBearerConfig","paragraph_zero_based":38833},{"literal_text_all_w_t_and_m_t":"The IE SL-RadioBearerConfig specifies the sidelink DRB configuration information for NR sidelink communication.","paragraph_zero_based":38834},{"literal_text_all_w_t_and_m_t":"SL-RadioBearerConfig information element","paragraph_zero_based":38835},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":38836},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RADIOBEARERCONFIG-START","paragraph_zero_based":38837},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38838},{"literal_text_all_w_t_and_m_t":"SL-RadioBearerConfig-r16 ::=     SEQUENCE {","paragraph_zero_based":38839},{"literal_text_all_w_t_and_m_t":"    slrb-Uu-ConfigIndex-r16           SLRB-Uu-ConfigIndex-r16,","paragraph_zero_based":38840},{"literal_text_all_w_t_and_m_t":"    sl-SDAP-Config-r16                SL-SDAP-Config-r16                                                 OPTIONAL,    -- Cond SLRBSetup","paragraph_zero_based":38841},{"literal_text_all_w_t_and_m_t":"    sl-PDCP-Config-r16                SL-PDCP-Config-r16                                                 OPTIONAL,    -- Cond SLRBSetup","paragraph_zero_based":38842},{"literal_text_all_w_t_and_m_t":"    sl-TransRange-r16                 ENUMERATED {m20, m50, m80, m100, m120, m150, m180, m200, m220, m250, m270, m300, m350, m370,","paragraph_zero_based":38843},{"literal_text_all_w_t_and_m_t":"                                                 m400, m420, m450, m480, m500, m550, m600, m700, m1000, spare9, spare8, spare7, spare6,","paragraph_zero_based":38844},{"literal_text_all_w_t_and_m_t":"                                                 spare5, spare4, spare3, spare2, spare1}                