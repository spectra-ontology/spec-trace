t-r16 ::= SEQUENCE {","paragraph_zero_based":37339},{"literal_text_all_w_t_and_m_t":"    measUncomBarPre-r16     ENUMERATED {true}            OPTIONAL,  -- Need R","paragraph_zero_based":37340},{"literal_text_all_w_t_and_m_t":"    measUeSpeed             ENUMERATED {true}            OPTIONAL,  -- Need R","paragraph_zero_based":37341},{"literal_text_all_w_t_and_m_t":"    measUeOrientation       ENUMERATED {true}            OPTIONAL   -- Need R","paragraph_zero_based":37342},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37343}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["55ed511afd84e4ad93415a04e8b83b8009f27264b06ca3f382bfeed894f35ca0","58e727dc18d31edef678e736e63f8ed270985f9e13267dca07f8955dbcd80b6b","3cc37e792772a2c11ff17727d4d3671e8bd39225fd28c586a0fd29990aa40590","7e2496255c9a0f368c622b451d1821120ab31003903eb62ab79c21aefa29959e","d036830f09b0a223021f224475625ab83f5316d36561a4eabf74aeae097681bc","056fc56047fcc23dd46282eea5e36dd7ab0909177482a66f410695075d1f0a21","26bfe756887ef50278871c163437ea691fdf6f53aa2690f99065bbbabc55fb0e","fb960a89dedd45825e01276859314b3e27d6721b572c7b18a40d4d142043c10a","d10f0e854bb5738fdc24f50992d160242f03f9019a420a4c8dc3faa47b5d0de8","97da1c1d60c57f0611e4ea8a8ee8d266381d9ece3434738cddc0b5db8c4c6ddc","0296104a99a92712529124e7e148b3fbaea9abcda796785f9a652917c1a3758e","364bad8ccb23e8e3ad464bc56a876fd442405c51fa74519b29ed1740243f77bb","ad4aadc0133e55a2cf8f1988b05579219086130e1f30abd54d6d89e970c2598b","727dc36466912bf47bb7e36b8d0d61511a4e80dea4bdb5ddf3470cecb5449f20","df86566294f0eb4279817b1d1efbc348798a2f42d2c9ed2b815929f09a2a1d51","597bab5ef8b421a922d53418d22cf72ea60355ac1c78e0ceb6ee4d2ed1033807","473cc32673d4e9713333baace3055b