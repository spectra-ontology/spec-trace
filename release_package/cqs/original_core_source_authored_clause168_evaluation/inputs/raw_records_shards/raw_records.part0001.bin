{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-AMF-IDENTIFIER-START","paragraph_zero_based":14544},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14545},{"literal_text_all_w_t_and_m_t":"AMF-Identifier ::=                      BIT STRING (SIZE (24))","paragraph_zero_based":14546},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14547},{"literal_text_all_w_t_and_m_t":"-- TAG-AMF-IDENTIFIER-STOP","paragraph_zero_based":14548},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":14549},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14550},{"literal_text_all_w_t_and_m_t":"–ARFCN-ValueEUTRA","paragraph_zero_based":14551},{"literal_text_all_w_t_and_m_t":"The IE ARFCN-ValueEUTRA is used to indicate the ARFCN applicable for a downlink, uplink or bi-directional (TDD) E-UTRA carrier frequency, as defined in TS 36.101 [22].","paragraph_zero_based":14552},{"literal_text_all_w_t_and_m_t":"ARFCN-ValueEUTRA information element","paragraph_zero_based":14553},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":14554},{"literal_text_all_w_t_and_m_t":"-- TAG-ARFCN-VALUEEUTRA-START","paragraph_zero_based":14555},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14556},{"literal_text_all_w_t_and_m_t":"ARFCN-ValueEUTRA ::=                INTEGER (0..maxEARFCN)","paragraph_zero_based":14557},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14558},{"literal_text_all_w_t_and_m_t":"-- TAG-ARFCN-VALUEEUTRA-STOP","paragraph_zero_based":14559},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":14560},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14561},{"literal_text_all_w_t_and_m_t":"–ARFCN-ValueNR","paragraph_zero_based":14562},{"literal_text_all_w_t_and_m_t":"The IE ARFCN-ValueNR is used to indicate the ARFCN applicable for a downlink, uplink or bi-directional (TDD) NR global frequency raster, as defined in TS 38.101-1 [15], TS 38.101-2 [39] and TS 38.101-5 [75], clause 5.4.2.","paragraph_zero_based":14563},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":14564},{"literal_text_all_w_t_and_m_t":"-- TAG-ARFCN-VALUENR-START","paragraph_zero_based":14565},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14566},{"literal_text_all_w_t_and_m_t":"ARFCN-ValueNR ::=               INTEGER (0..maxNARFCN)","paragraph_zero_based":14567}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["4aee7250f332c76d41d875386c4cb8fe85cb12cdf3847190d58ad180b2cee010","b78052b8db7909ab6258b94c38d38b2bd80a8aee3fd87ab90be42345f867a983","0fa2d8e469fbddf83f6ea8a10c7bb351dfe011b12e37ec5ab7cbc7cd761c7914","874df24d2c712cde861f3eea3536864bb45c4b160a1d32a1e3e0c74f4a77afd4","2149e022de0e17540ace316279b511b3537af9db1a76d25b8b9b6f30101efa03","32e859bb80953aeadf9e5064c62f7c00b9dd9ba06e33f7f7ab024c56c0605819","75a7188238f153625e740ccde61068ca95facf6b31ef26d81a54dac2cee1a23a","33ef82907529435e1c095de5ca23ff0d547f776a374f449d864f5693937da657","2440d33a4ab3be2e0533597bea94abc7ff89f29aaa472cb3feceb653d6cc6058","9312d01ee9e697923a5b6e3130b150afaea9c6a0bd6ab90ae0c9372e9d580140","bfe2993973b490215187106930c252474a99a55392223448d0e6cf62c82e55f5","3b2c18b8c51897850c39ac75bd8aa79aabf3efc20b4230da9623725fe9e20cc8","eb41790a80aa0e5502d374364aa710da6e49cc4ec639af2becddc3aa8bdbecb5","79b08cc8272c2e4698b349a7d7bb547842833adb599b7e5d05e39ae24e86ff0f","81409364848409f24bfdcb9cb9c13eda522c5c04d88a4e1416259c7dc6868462","f917ed16e2935b300a72849b0fb60d8dd07e81b7b96b60bb64da7b75b1fef7ea","7c8a650e7782bf5a6c28a042e5527aa02c004d763c