{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-CGI-INFOEUTRA-STOP","paragraph_zero_based":15960},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":15961},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15962},{"literal_text_all_w_t_and_m_t":"–CGI-InfoEUTRALogging","paragraph_zero_based":15963},{"literal_text_all_w_t_and_m_t":"The IE CGI-InfoEUTRALogging indicates EUTRA cell related information, which is reported by the UE as part of RLF reporting procedure.","paragraph_zero_based":15964},{"literal_text_all_w_t_and_m_t":"CGI-InfoEUTRALogging information element","paragraph_zero_based":15965},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":15966},{"literal_text_all_w_t_and_m_t":"-- TAG-CGI-INFOEUTRALOGGING-START","paragraph_zero_based":15967},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15968},{"literal_text_all_w_t_and_m_t":"CGI-InfoEUTRALogging ::=         SEQUENCE {","paragraph_zero_based":15969},{"literal_text_all_w_t_and_m_t":"    plmn-Identity-eutra-5gc          PLMN-Identity                                          OPTIONAL,","paragraph_zero_based":15970},{"literal_text_all_w_t_and_m_t":"    trackingAreaCode-eutra-5gc       TrackingAreaCode                                       OPTIONAL,","paragraph_zero_based":15971},{"literal_text_all_w_t_and_m_t":"    cellIdentity-eutra-5gc           BIT STRING (SIZE (28))                                 OPTIONAL,","paragraph_zero_based":15972},{"literal_text_all_w_t_and_m_t":"    plmn-Identity-eutra-epc          PLMN-Identity                                          OPTIONAL,","paragraph_zero_based":15973},{"literal_text_all_w_t_and_m_t":"    trackingAreaCode-eutra-epc       BIT STRING (SIZE (16))                                 OPTIONAL,","paragraph_zero_based":15974},{"literal_text_all_w_t_and_m_t":"    cellIdentity-eutra-epc           BIT STRING (SIZE (28))                                 OPTIONAL","paragraph_zero_based":15975},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":15976},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15977},{"literal_text_all_w_t_and_m_t":"-- TAG-CGI-INFOEUTRALOGGING-STOP","paragraph_zero_based":15978},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":15979},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15980},{"literal_text_all_w_t_and_m_t":"CGI-InfoEUTRALogging field descriptions","paragraph_zero_based":15981},{"literal_text_all_w_t_and_m_t":"cellIdentity-eutra-epc, cellIdentity-eutra-5GC","paragraph_zero_based":15982},{"literal_text_all_w_t_and_m_t":"Unambiguously identify a cell within the context of the PLMN. It belongs the first PLMN entry of plmn-IdentityList (when connected to EPC) or of plmn-IdentityList-r15 (when connected to 5GC) in SystemInformationBlockType1.","paragraph_zero_based":15983}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["55db4574d34d5b44965607e832ba4f699355eb9a246a19af13775b1f4adf017a","92cb4f73529aa3463fa08c88053184957e90bc0a5fb66205a1ab4d8d4b92564f","7299e2086fc69896b97af87a02b2aa047ac3b6a8f40d19153b490e0d1c9157f6","d5ea62d051239b884f4fd49a23e52189b87efc9dafedbe384efba773e45876f8","48cda6f85179a38e500ccf773ba16881b31a5e57d3e1caa5972041b35e2c6307","0aa29dbb974f0cab8332d60ca2a24f13d83ab530df1512704245bdb70e1f6c0e","1669b0a22cd48e618bfb8bc7dc958704d732db7af97671ee4c14ee2c0be343f9","b5b57bd602d727bc118fa80d22f84054a871288a43485dfc49afe5da735866dc","c7b2b7ff4efb8170eb583dce31e42a93997b020eab9897ac4f861f1f13a40f10","8cf2527c211621d3597515105aadf251be97913adac652b7