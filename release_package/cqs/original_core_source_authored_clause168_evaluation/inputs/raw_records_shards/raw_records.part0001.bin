{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    purpose                             ENUMERATED {beamFailure, rlf, both},","paragraph_zero_based":25200},{"literal_text_all_w_t_and_m_t":"    detectionResource                   CHOICE {","paragraph_zero_based":25201},{"literal_text_all_w_t_and_m_t":"        ssb-Index                           SSB-Index,","paragraph_zero_based":25202},{"literal_text_all_w_t_and_m_t":"        csi-RS-Index                        NZP-CSI-RS-ResourceId","paragraph_zero_based":25203},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":25204},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":25205},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25206},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25207},{"literal_text_all_w_t_and_m_t":"BeamFailureDetectionSet-r17  ::=    SEQUENCE {","paragraph_zero_based":25208},{"literal_text_all_w_t_and_m_t":"    bfdResourcesToAddModList-r17        SEQUENCE (SIZE(1..maxNrofBFDResourcePerSet-r17)) OF BeamLinkMonitoringRS-r17","paragraph_zero_based":25209},{"literal_text_all_w_t_and_m_t":"                                                                                                                  OPTIONAL, -- Need N","paragraph_zero_based":25210},{"literal_text_all_w_t_and_m_t":"    bfdResourcesToReleaseList-r17       SEQUENCE (SIZE(1..maxNrofBFDResourcePerSet-r17)) OF BeamLinkMonitoringRS-Id-r17","paragraph_zero_based":25211},{"literal_text_all_w_t_and_m_t":"                                                                                                                  OPTIONAL, -- Need N","paragraph_zero_based":25212},{"literal_text_all_w_t_and_m_t":"    beamFailureInstanceMaxCount-r17     ENUMERATED {n1, n2, n3, n4, n5, n6, n8, n10}                              OPTIONAL, -- Need R","paragraph_zero_based":25213},{"literal_text_all_w_t_and_m_t":"    beamFailureDetectionTimer-r17       ENUMERATED {pbfd1, pbfd2, pbfd3, pbfd4, pbfd5, pbfd6, pbfd8, pbfd10}      OPTIONAL, -- Need R","paragraph_zero_based":25214},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":25215},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25216},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25217},{"literal_text_all_w_t_and_m_t":"BeamLinkMonitoringRS-r17 ::=        SEQUENCE {","paragraph_zero_based":25218},{"literal_text_all_w_t_and_m_t":"    beamLinkMonitoringRS-Id-r17         BeamLinkMonitoringRS-Id-r17,","paragraph_zero_based":25219},{"literal_text_all_w_t_and_m_t":"    detectionResource-r17               CHOICE {","paragraph_zero_based":25220},{"literal_text_all_w_t_and_m_t":"        ssb-Index                       SSB-Index,","paragraph_zero_based":25221},{"literal_text_all_w_t_and_m_t":"        csi-RS-Index                    NZP-CSI-RS-ResourceId","paragraph_zero_based":25222},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":25223}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["1387bbc574165282058841cfed1150016104a8c755b109b74ca3a1241aebf1e3","f5bd061d5880a93cb475832457a0fa34404267123b08913968e115d658182647","9e11676cdf7943e5a743c61171e0da637326a5fefe44d5e3c5b7f5a4d3ebbbcf","5d29bfcb3578a840d97126361dd82f3897893b06a39685403ea2b397e9dc3c47","28607d487a200ede60dc293f2b0a633aaee94d9af55f2be56b4c5b1ec90a99e3","e421dfe5d4de6e96749b87805e9ab5ef1031f80c462a54cf5869b10ee4ed4e85","aee02630c537e6ca5f8898c1ee35454d2ec465a3ad7e9ba804930b338eb055fc","b60e52261a5a4c6270cf6774fa1856e8209fe4436b917a7a5da9fc670f55cae8","3767f30c78c7debffc9ce2