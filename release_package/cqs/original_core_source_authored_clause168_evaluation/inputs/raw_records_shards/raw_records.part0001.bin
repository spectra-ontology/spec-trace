{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":27552},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27553},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27554},{"literal_text_all_w_t_and_m_t":"-- TAG-SENSORLOCATIONINFO-STOP","paragraph_zero_based":27555},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27556},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27557},{"literal_text_all_w_t_and_m_t":"Sensor-LocationInfo field descriptions","paragraph_zero_based":27558},{"literal_text_all_w_t_and_m_t":"sensor-MeasurementInformation","paragraph_zero_based":27559},{"literal_text_all_w_t_and_m_t":"This field provides barometric pressure measurements as Sensor-MeasurementInformation defined in TS 37.355 [49]. The first/leftmost bit of the first octet contains the most significant bit.","paragraph_zero_based":27560},{"literal_text_all_w_t_and_m_t":"sensor-MotionInformation","paragraph_zero_based":27561},{"literal_text_all_w_t_and_m_t":"This field provides motion sensor measurements as Sensor-MotionInformation defined in TS 37.355 [49]. The first/leftmost bit of the first octet contains the most significant bit.","paragraph_zero_based":27562},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27563},{"literal_text_all_w_t_and_m_t":"–ServingCellAndBWP-Id","paragraph_zero_based":27564},{"literal_text_all_w_t_and_m_t":"The IE ServingCellAndBWP-Id is used to indicate a serving cell and an uplink or a downlink BWP.","paragraph_zero_based":27565},{"literal_text_all_w_t_and_m_t":"ServingCellAndBWP-Id information element","paragraph_zero_based":27566},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27567},{"literal_text_all_w_t_and_m_t":"-- TAG-SERVINGCELLANDBWP-ID-START","paragraph_zero_based":27568},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27569},{"literal_text_all_w_t_and_m_t":"ServingCellAndBWP-Id-r17 ::= SEQUENCE {","paragraph_zero_based":27570},{"literal_text_all_w_t_and_m_t":"    servingcell-r17              ServCellIndex,","paragraph_zero_based":27571},{"literal_text_all_w_t_and_m_t":"    bwp-r17                      BWP-Id","paragraph_zero_based":27572},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27573},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27574},{"literal_text_all_w_t_and_m_t":"-- TAG-SERVINGCELLANDBWP-ID-STOP","paragraph_zero_based":27575}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["320a93700eb63bdbb60da856418bfe056f88143a9e8b241857c760a3dfef22f0","454cfcb5646a023622c9fadfb56c38ef2ec246d3c78686ad941ecfae3f8047b0","14cd6cd731534336e009582d90362ad1bb998fec88cd05eb7d432cbbd4826fb2","1f1d930fd25b12d295aba8ff96aa03530b16093ed216b4c5c5c3ce58f89267fc","357513af3104ebd91ccdae901e8daf59a6c6c3544bac7c082e74c14649b2744d","0e06c659787cce62d1891ad9a046d30cbad435edf62ac008964a51647ea83716","3292449557b87890c47b0a566bd695ad39ddc76214a99b8ade506653573c5def","91ab29a262584c5e18912f0d4d40fc01ab6dc08b96a677d60deea7378f2e3057","772a2b2070f8bec8829e8d478d5ca12f2e90cf383572c91514d1be839a64bbfd","b18eebf99da7fce1046c8ce4166ac616f7b93895ff18131fb41663b974a10271","e96f2cf0d4cba2fd6ec216ec6b5769a577d56e680f8a9c03ae9ae477d1c7e371","99586c564032d97a06ced8d46c4c0cdc758124c20731017bf88dc5e08eb36411","3e9486fcef774521993bf15edb183530c0a10f0326cfeb59d82ec19da434037b","0e90f51c388f55fafc9205e6e11eeb36b2b0242927cf4759403bb7088be82220","b1837e167166b863fd236d91e190e6d735912d770a215d90f36f9038ecfb3b19","97731b5897b594338a6a0f97249ee668c2ad526cc91fbc21f11333153e653965","2a0ef735dff2e099d9dec202c73cdae9a8bbd42324fd726bacf459f43e6e0c7e","444d5c84b0d4d9f23202604d2da67449f8bb3f726d9ecb1e8dccf95aa60fd625","325334772f7f3ae68e80185da651ad6068ae1cec0429571943922705cf2600b3","a43787bfd9c206c4c8476415211fd93e9fd72dbb0fcd1f617d9cfda05980f4cd","c0638068e505fe39c098f23d859a31d43d3a97cc26ca049111ab43e88fb1e421","7c8ae2fc371aae2693e6cec07797b632f7347dfdfef8b1495c01a646ef31a934","532af23cfc0e30e580bfd2eb457ecfe3f950227545fb13a0209bacd13872be02","c491dc7832fa6e68393dd36844e53764c1bf24d47027964ce61c38bf73ed324a"],"paragraph_range_zero_based":[27552,27575],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p27552"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27576},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27577},{"literal_text_all_w_t_and_m_t":"–ServCellIndex","paragraph_zero_based":27578},{"literal_text_all_w_t_and_m_t":"The IE ServCellIndex concerns a short identity, used to uniquely identify a serving cell (i.e. the PCell, the PSCell or an SCell) across the cell groups. Value 0 applies for the PCell, while the SCellIndex that has previously been assigned applies for SCells.","paragraph_zero_based":27579},{"literal_text_all_w_t_and_m_t":"ServCellIndex information element","paragraph_zero_based":27580},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27581},{"literal_text_all_w_t_and_m_t":"-- TAG-SERVCELLINDEX-START","paragraph_zero_based":27582},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27583},{"literal_text_all_w_t_and_m_t":"ServCellIndex ::=                   INTEGER (0..maxNrofServingCells-1)","paragraph_zero_based":27584},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27585},{"literal_text_all_w_t_and_m_t":"-- TAG-SERVCELLINDEX-STOP","paragraph_zero_based":27586},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27587},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27588},{"literal_text_all_w_t_and_m_t":"–ServingCellConfig","paragraph_zero_based":27589},{"literal_text_all_w_t_and_m_t":"The IE ServingCellConfig is used to configure (add or modify) the UE with a serving cell, which may be the SpCell or an SCell of an MCG or SCG. The parameters herein are mostly UE specific but partly also cell specific (e.g. in additionally configured bandwidth parts). Reconfiguration between a PUCCH and PUCCHless SCell is only supported using an SCell release and add.","paragraph_zero_based":27590},{"literal_text_all_w_t_and_m_t":"ServingCellConfig information element","paragraph_zero_based":27591},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27592},{"literal_text_all_w_t_and_m_t":"-- TAG-SERVINGCELLCONFIG-START","paragraph_zero_based":27593},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27594},{"literal_text_all_w_t_and_m_t":"ServingCellConfig ::=               SEQUENCE {","paragraph_zero_based":27595},{"literal_text_all_w_t_and_m_t":"    tdd-UL-DL-ConfigurationDedicated    TDD-UL-DL-ConfigDedicated                                                OPTIONAL,   -- Cond TDD","paragraph_zero_based":27596},{"literal_text_all_w_t_and_m_t":"    initialDownlinkBWP                  BWP-DownlinkDedicated                                                    OPTIONAL,   -- Need M","paragraph_zero_based":27597},{"literal_text_all_w_t_and_m_t":"    downlinkBWP-ToReleaseList           SEQUENCE (SIZE (1..maxNrofBWPs)) OF BWP-Id                               OPTIONAL,   -- Need N","paragraph_zero_based":27598},{"literal_text_all_w_t_and_m_t":"    downlinkBWP-ToAddModList            SEQUENCE (SIZE (1..maxNrofBWPs)) OF BWP-Downlink                         OPTIONAL,   -- Need N","paragraph_zero_based":27599}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["df7536c1274c599a0fc49b7dcbd92546e0e8a996f214468538210be5cb0e1c2b","a32cd0d45f5333f3f64b4b63ed65d496318214c46b512fd1c444b75952aea28f","9f84c2a4071965cb95ce0bf67282c7b816d33b372fe2f43bae0d7d79ed83468d","134326530abe818ba6e2180ac9c718f82ad0738d76cb1cadb61e86fab59fc0a6","9191b11eb3429c26818ebc1e29eef2c3062b95acd98db38b49993ba16a0c0741","5ac18793b25a76750f1b17faf378f99b50b67bbc162ca54811de916d03090470","1d1d6d1be5