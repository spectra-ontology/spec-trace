{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ControlResourceSet ::=              SEQUENCE {","paragraph_zero_based":16488},{"literal_text_all_w_t_and_m_t":"    controlResourceSetId                ControlResourceSetId,","paragraph_zero_based":16489},{"literal_text_all_w_t_and_m_t":"    frequencyDomainResources            BIT STRING (SIZE (45)),","paragraph_zero_based":16490},{"literal_text_all_w_t_and_m_t":"    duration                            INTEGER (1..maxCoReSetDuration),","paragraph_zero_based":16491},{"literal_text_all_w_t_and_m_t":"    cce-REG-MappingType                 CHOICE {","paragraph_zero_based":16492},{"literal_text_all_w_t_and_m_t":"        interleaved                         SEQUENCE {","paragraph_zero_based":16493},{"literal_text_all_w_t_and_m_t":"            reg-BundleSize                      ENUMERATED {n2, n3, n6},","paragraph_zero_based":16494},{"literal_text_all_w_t_and_m_t":"            interleaverSize                     ENUMERATED {n2, n3, n6},","paragraph_zero_based":16495},{"literal_text_all_w_t_and_m_t":"            shiftIndex                          INTEGER(0..maxNrofPhysicalResourceBlocks-1)       OPTIONAL -- Need S","paragraph_zero_based":16496},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":16497},{"literal_text_all_w_t_and_m_t":"        nonInterleaved                      NULL","paragraph_zero_based":16498},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":16499},{"literal_text_all_w_t_and_m_t":"    precoderGranularity                 ENUMERATED {sameAsREG-bundle, allContiguousRBs},","paragraph_zero_based":16500},{"literal_text_all_w_t_and_m_t":"    tci-StatesPDCCH-ToAddList           SEQUENCE(SIZE (1..maxNrofTCI-StatesPDCCH)) OF TCI-StateId OPTIONAL, -- Cond NotSIB-initialBWP","paragraph_zero_based":16501},{"literal_text_all_w_t_and_m_t":"    tci-StatesPDCCH-ToReleaseList       SEQUENCE(SIZE (1..maxNrofTCI-StatesPDCCH)) OF TCI-StateId OPTIONAL, -- Cond NotSIB-initialBWP","paragraph_zero_based":16502},{"literal_text_all_w_t_and_m_t":"    tci-PresentInDCI                        ENUMERATED {enabled}                                  OPTIONAL, -- Need S","paragraph_zero_based":16503},{"literal_text_all_w_t_and_m_t":"    pdcch-DMRS-ScramblingID                 INTEGER (0..65535)                                    OPTIONAL, -- Need S","paragraph_zero_based":16504},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":16505},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":16506},{"literal_text_all_w_t_and_m_t":"    rb-Offset-r16                       INTEGER (0..5)                                            OPTIONAL, -- Need S","paragraph_zero_based":16507},{"literal_text_all_w_t_and_m_t":"    tci-PresentDCI-1-2-r16              INTEGER (1..3)                                            OPTIONAL, -- Need S","paragraph_zero_based":16508},{"literal_text_all_w_t_and_m_t":"    coresetPoolIndex-r16                INTEGER (0..1)                                            OPTIONAL, -- Need S","paragraph_zero_based":16509},{"literal_text_all_w_t_and_m_t":"    controlResourceSetId-v1610          ControlResourceSetId-v1610                                OPTIONAL  -- Need S","paragraph_zero_based":16510},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":16511}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["0d464a526bed181a8dfba0cfa379f27af2d8a2d81cb981c487f9099a21fcbcc6","4b33387007300df989404e9a8bb9a43487621237660028b3d16ff9678f23919d","9adeb2d5aa980a44835d328ff132aa228c276ec0b5234e62509b87261dd1c323","5acacdc8295a3652377c2b2bcc922ebc345650a98dfbba05e4165b79448b557a","a3c0f249a653829e35279de70b72b434bf9e7dcacbdf29a19d956480db4db881","3604474a1d843f7550261c87d2f48f09c56de0226837b0c3d7966ab4dd7c988a","a0c395f81ed59abea67d8c0ef07f86ab168092340f08bbc8e2ffdff1a502c46c","a4d3c5f4d4249c9fb3612d1729185439872a27c82feaa23244085f78a6db0fb7","6b967dad09cf51ec022a232753c884b535756b0387d55840eae408c0ea28f0de","6b6ab232f0a28a3738fb562ad252b1e8f85cd9f0aabe5f3a839a92ac87bea239","283d27d5dda66cc6d0f21a1559f6d66fd77c7f15c610ccfb4903668f9b37f7b5","8f680d07739508300788147f81699b0626ee6d080800291b9648065cf344382b","d8c54eac58cf4fca3a00d1e4b3a9dee4fb8e3864679fef0f07d4c0aad4936e68","d0400b38f3e0847899d63454077edd61c60b7d68934f96d5acc07699492f0ff4","82978b6489f0c890d5991f378a362ea3424750a575d53bc4c654ac859c57758e","f7ae3c78b388becb92871c62ff9c92cfa0bef57e2ffe2b677c43e8c5a30a5bfc","78c2817c1ed25603b41284f232a135d52cad379a2d241dd3643b3c917ee91c80","c33284234072fe1e22921ae8c1922c028e85a75926763c0186d87d4283ac6116","623306bf8d4e01128b2e351d85568724c39e5c36c0d0bb7a60b8874c98465c2a","df84ab7438960464d3f050be99b797803db5306b2b7f7ce7f1f7f71aad750da7","f9892051ae62f3bb255962a71be005ebb53b82cd76b7c75199fd1d16b7bbb2ed","e159385cdc8f0319aeb12ba6c5c23b6c6271156858285e771ff7386fad8d8c4d","2d2234911b16b88c613fcf98cb41091bc2086995512d11e83ca8d391a194a04e","21bda344f1d8c6ecea42dee6b6066c9b5a58f28bccb27a2873b614d17a8816d6"],"paragraph_range_zero_based":[16488,16511],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p16488"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":16512},{"literal_text_all_w_t_and_m_t":"    followUnifiedTCI-State-r17           ENUMERATED {enabled}                                      OPTIONAL  -- Need R","paragraph_zero_based":16513},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":16514},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":16515},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16516},{"literal_text_all_w_t_and_m_t":"-- TAG-CONTROLRESOURCESET-STOP","paragraph_zero_based":16517},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":16518},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16519},{"literal_text_all_w_t_and_m_t":"ControlResourceSet field descriptions","paragraph_zero_based":16520},{"literal_text_all_w_t_and_m_t":"cce-REG-MappingType","paragraph_zero_based":16521},{"literal_text_all_w_t_and_m_t":"Mapping of Control Channel Elements (CCE) to Resource Element Groups (REG) (see TS 38.211 [16], clauses 7.3.2.2 and 7.4.1.3.2).","paragraph_zero_based":16522},{"literal_text_all_w_t_and_m_t":"controlResourceSetId","paragraph_zero_based":16523},{"literal_text_all_w_t_and_m_t":"Identifies the instance of the ControlResourceSet IE. Value 0 identifies the common CORESET configured in MIB and in ServingCellConfigCommon (controlResourceSetZero) and is hence not used here in the ControlResourceSet IE. Other values identify CORESETs configured by dedicated signalling or in SIB1 or SIB20. The controlResourceSetId is unique among the BWPs of a serving cell.","paragraph_zero_based":16524},{"literal_text_all_w_t_and_m_t":"If the field controlResourceSetId-v1610 is present, the UE shall ignore the controlResourceSetId field (without suffix).","paragraph_zero_based":16525},{"literal_text_all_w_t_and_m_t":"coresetPoolIndex","paragraph_zero_based":16526},{"literal_text_all_w_t_and_m_t":"The index of the CORESET pool for this CORESET as specified in TS 38.213 [13] (clauses 9 and 10) and TS 38.214 [19] (clauses 5.1 and 6.1). If the field is absent, the UE applies the value 0.","paragraph_zero_based":16527},{"literal_text_all_w_t_and_m_t":"duration","paragraph_zero_based":16528},{"literal_text_all_w_t_and_m_t":"Contiguous time duration of the CORESET in number of symbols (see TS 38.211 [16], clause 7.3.2.2).","paragraph_zero_based":16529},{"literal_text_all_w_t_and_m_t":"followUnifiedTCI-State","paragraph_zero_based":16530},{"literal_text_all_w_t_and_m_t":"When set to enabled, for PDCCH reception on this CORESET, the UE applies the \"indicated\" DL only TCI or joint TCI as specified in TS 38.214 [19], clause 5.1.5.","paragraph_zero_based":16531},{"literal_text_all_w_t_and_m_t":"frequencyDomainResources","paragraph_zero_based":16532},{"literal_text_all_w_t_and_m_t":"Frequency domain resources for the CORESET. Each bit corresponds a group of 6 RBs, with grouping starting from the first RB group in the BWP or MBS CFR where the CORESET is configured. When at least one search space is configured with freqMonitorLocation-r16, only the first NRBG,set0size bits are valid (see TS 38.213 [13], clause 10.1). The first (left-most / most significant) bit corresponds to the first RB group in the BWP or MBS CFR where the CORESET is configured, and so on. A bit that is set to 1 indicates that this RB group belongs to the frequency domain resource of this CORESET. Bits corresponding to a group of RBs not fully contained in the bandwidth part within which the CORESET is configured are set to zero (see TS 38.211 [16], clause 7.3.2.2).","paragraph_zero_based":16533},{"literal_text_all_w_t_and_m_t":"interleaverSize","paragraph_zero_based":16534},{"literal_text_all_w_t_and_m_t":"Interleaver-size (see TS 38.211 [16], clause 7.3.2.2).","paragraph_zero_based":16535}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["c57dcbf5434b58b57492bb79f180dfab0c337ae5c09ad09c19a61c1bb959a7f8","ea3ba0b25d901375c25b13b627bdf20a27687f5ad431eae65702d4b68ec6142b","74986971fca3bef066aa5b3bf56512d873ea766d9f09d98c3ecc1ea10ab892f5","72af250fc31480bffbf8d0b7e57ac913321a7bcf60a085ae7adb122d5b6ce159","c639f3dd80408ec4a705b5797390e71c25cb0720e358725248a949359cf51982","672498839e01ea6a43a41e90431f0d8ba1d8cd6cb3b6cdea48d2e923d4095d70","8800cc4508a94a9aa0ecbc860ede210c20272779c4b6647674520664145691a6","b77b1dabc533b9274290d62a095d4f4a8e4d2546500cd84aa5764df917959d75","984a8139a68993c97b42dbfd377b64f18f04ad5b6fa65056a3c2af3f45ca0e65","de37941df0b980497ae46a65737003fa5dd1d159ccbef726c01b194dcf84d6fa","8d73085d6470457b30e61c2d5a50e9dfebdac9656f9acfac7672bdcc2b44b3ee","a4ea3d55a8a756d4b498f2f9af10c821484570634bbcceb3ce06a929646bdc50","5c3069d4473abd033458760f340660da98dc207cc8e3e629d18a86e5dcf68544","02c6633b14ef29e9d9e1381a6b51a87e8587afd701f83dbd6c7415fd141145e5","2e290c5c2f3aacfdc2881c0b59f803d6098e2e1d42c5afb86d054b2e9cd37293","e63c4e4ee09b331511cc5b796be706028edd6015d224a1c2176abcc571f3fc64","267eee5a00ff05cb566858d1fe32bfb4855b66d26270ae8f370b8927062e7ada","80ca714551c2c5166fade95b68b54716e3553efae4b254d182d15d4fffba4103","fcb30cc2470ddbdc5cdfdac7180e0874b145cfa51d97c4a655c56359d266196c","199e43223cb1d32e3dd054f680d3f025ac0c787274394ab18d2c4d05dc980886","59855e4a0d3bb7749843c6e343d8cbe5ecbce488e926710e26d25645bcc26964","8529d7044f2364d51b13ce2f1b3bd1c188828b4060876161a30162bd11c33705","a1f975e7c2e1b2fff44829aba2c7d05392462c9ddd6ce015149889536e947a66","8676406995f6c6d8acb930c9d39260a9e3e2731e7ecd1e4b9415586ff292c3e0"],"paragraph_range_zero_based":[16512,16535],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p16512"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"pdcch-DMRS-ScramblingID","paragraph_zero_based":16536},{"literal_text_all_w_t_and_m_t":"PDCCH DMRS scrambling initialization (see TS 38.211 [16], clause 7.4.1.3.1). When the field is absent the UE applies the value of the physCellId configured for this serving cell.","paragraph_zero_based":16537},{"literal_text_all_w_t_and_m_t":"precoderGranularity","paragraph_zero_based":16538},{"literal_text_all_w_t_and_m_t":"Precoder granularity in frequency domain (see TS 38.211 [16], clauses 7.3.2.2 and 7.4.1.3.2).","paragraph_zero_based":16539},{"literal_text_all_w_t_and_m_t":"rb-Offset","paragraph_zero_based":16540},{"literal_text_all_w_t_and_m_t":"Indicates the RB level offset in units of RB from the first RB of the first 6RB group to the first RB of BWP (see 38.213 [13], clause 10.1).","paragraph_zero_based":16541},{"literal_text_all_w_t_and_m_t":"reg-BundleSize","paragraph_zero_based":16542},{"literal_text_all_w_t_and_m_t":"Resource Element Groups (REGs) can be bundled to create REG bundles. This parameter defines the size of such bundles (see TS 38.211 [16], clause 7.3.2.2).","paragraph_zero_based":16543},{"literal_text_all_w_t_and_m_t":"shiftIndex","paragraph_zero_based":16544},{"literal_text_all_w_t_and_m_t":"When the field is absent the UE applies the value of the physCellIdconfigured for this serving cell (see TS 38.211 [16], clause 7.3.2.2).","paragraph_zero_based":16545},{"literal_text_all_w_t_and_m_t":"tci-PresentInDCI","paragraph_zero_based":16546},{"literal_text_all_w_t_and_m_t":"This field indicates if TCI field is present or absent in DCI format 1_1 and DCI format 4_2. When the field is absent the UE considers the TCI to be absent/disabled. In case of cross carrier scheduling, the network sets this field to enabled for the ControlResourceSet used for cross carrier scheduling in DCI format 1_1 in the scheduling cell if enableDefaultBeamForCCS is not configured (see TS 38.214 [19], clause 5.1.5).","paragraph_zero_based":16547},{"literal_text_all_w_t_and_m_t":"tci-PresentDCI-1-2","paragraph_zero_based":16548},{"literal_text_all_w_t_and_m_t":"Configures the number of bits for \"Transmission configuration indicator\" in DCI format 1_2. When the field is absent the UE applies the value of 0 bit for the \"Transmission configuration indicator\" in DCI format 1_2 (see TS 38.212 [17], clause 7.3.1 and TS 38.214 [19], clause 5.1.5). In case of cross carrier scheduling, the network configures this field for the ControlResourceSet used for cross carrier scheduling in DCI format 1_2 in the scheduling cell if enableDefaultBeamForCCS is not configured (see TS 38.214 [19], clause 5.1.5).","paragraph_zero_based":16549},{"literal_text_all_w_t_and_m_t":"tci-StatesPDCCH-ToAddList","paragraph_zero_based":16550},{"literal_text_all_w_t_and_m_t":"A subset of the TCI states defined in pdsch-Config, either with tci-StatesToAddModList or dl-OrJointTCI-StateList, included in the BWP-DownlinkDedicated corresponding to the serving cell and to the DL BWP to which the ControlResourceSet belong to. They are used for providing QCL relationships between the DL RS(s) in one RS Set (TCI-State) and the PDCCH DMRS ports (see TS 38.213 [13], clause 6.). The network configures at most maxNrofTCI-StatesPDCCH entries. The QCL relationships defined herein do not apply to MBS broadcast.","paragraph_zero_based":16551},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16552},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":16553},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":16554},{"literal_text_all_w_t_and_m_t":"NotSIB-initialBWP","paragraph_zero_based":16555},{"literal_text_all_w_t_and_m_t":"The field is absent in SIB1/SIB20 and in the PDCCH-ConfigCommon of the initial BWP in ServingCellConfigCommon, if SIB1/SIB20 is broadcasted. Otherwise, it is optionally present, Need N.","paragraph_zero_based":16556},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16557},{"literal_text_all_w_t_and_m_t":"–ControlResourceSetId","paragraph_zero_based":16558},{"literal_text_all_w_t_and_m_t":"The ControlResourceSetId IE concerns a short identity, used to identify a control resource set within a serving cell. The ControlResourceSetId = 0 identifies the ControlResourceSet#0 configured via PBCH (MIB) and in controlResourceSetZero (ServingCellConfigCommon). The ID space is used across the BWPs and MBS CFRs of a Serving Cell.","paragraph_zero_based":16559}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["9ad014836f9220a6e60831b5a6d64612ac55efa2f87c75eb8882f71fdac14604","ed7f91e4140dd37c172ea6fa6d3757ca35102ec9cf270c49063aab459bd311e7","876bad72720111c400330fcc71ddddeb6dd367bb3f5ea11dfed430110631142d","6646dbcfc68b45f55bbc28d0f61fbfbecafb9aba797d8c1821fd5654cd6da46c","789bc63b4ecaf127cd3212b15384c57e78eb3b18b463e556e0997e6303b9d5bb","83c6998f33138ccebe0f6365250c50a5710f8c60d1ff6807bb3eea9b6d8ea321","a46737dd2efbbe173e216743ea63ad1c6274f416aaf7ecbea2a75722a3d36321","d3101ee94c99447bddac1c5b22f30600c51028229c1ef0b34267e0ba5aabaf1d","b1ad04092cfa05ceedfabc6d70b688360aacda13380962cf1ddd593f41a8503e","cf5e9bafb4cdc2b4f80288571c574767623a7f29cbb4128bd17b0a4e2df3ec92","dd8b00ba013c96dcd9d5656998b6930bf4da6a8cd46fe7bb398cbf7ac00b39f9","b9a542883b6057af2ace9463e165f0f47a1cf4cf317bc8615ea6c4228bc7d244","a471939294ec2fbf8efea5c1eb40d4322557fb3f3321f512e30cd60323c4d22d","914c1131e710714745ac81ca73af6217d7cd64211449cc7a188f1fa43bf27174","4add9ae8c7cb15caebe4cc6a8dd0228391b9f7a12f296ee86c2dd02d96fe2aef","5be466824735b43fd9d08d75429b80ee8c8dae101712e01ff4f15285462d0118","2c69ebadb7a8426604adf334b5b9292b8c88891849d83fc54487cae9092c393c","2b79bc874c9cd06e8f2af9b99ab53f8fa47391662f2e2f7722d78f8e875bddcf","da17e746380faaa72299a684b5a3e8cd51127a5f3a28ce81c6f3a80dac405cd8","58c75b030404674b8ec34e7bfd2fde9d320db0a06754828a90a5bcc83463a74a","7938f6d313568578f9a23aa505967251a568139725721c63921d255e7b7bea44","069b4998bd0bb34b27c01ceada34fae2afaa8832cc7ef9d71be273121c76ec73","e5b8bf249d8eeae3c350f6005a3c5483f2c14fd86688ef8d7040d5cbcfe77d0d","d6a77967f5ebcb19a894e9c22b1cb1e385d160bd381f548ffe3eb1e0cfac1303"],"paragraph_range_zero_based":[16536,16559],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p16536"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ControlResourceSetId information element","paragraph_zero_based":16560},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":16561},{"literal_text_all_w_t_and_m_t":"-- TAG-CONTROLRESOURCESETID-START","paragraph_zero_based":16562},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16563},{"literal_text_all_w_t_and_m_t":"ControlResourceSetId ::=                INTEGER (0..maxNrofControlResourceSets-1)","paragraph_zero_based":16564},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16565},{"literal_text_all_w_t_and_m_t":"ControlResourceSetId-r16 ::=            INTEGER (0..maxNrofControlResourceSets-1-r16)","paragraph_zero_based":16566},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16567},{"literal_text_all_w_t_and_m_t":"ControlResourceSetId-v1610 ::=          INTEGER (maxNrofControlResourceSets..maxNrofControlResourceSets-1-r16)","paragraph_zero_based":16568},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16569},{"literal_text_all_w_t_and_m_t":"-- TAG-CONTROLRESOURCESETID-STOP","paragraph_zero_based":16570},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":16571},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16572},{"literal_text_all_w_t_and_m_t":"–ControlResourceSetZero","paragraph_zero_based":16573},{"literal_text_all_w_t_and_m_t":"The IE ControlResourceSetZero is used to configure CORESET#0 of the initial BWP (see TS 38.213 [13], clause 13).","paragraph_zero_based":16574},{"literal_text_all_w_t_and_m_t":"ControlResourceSetZero information element","paragraph_zero_based":16575},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":16576},{"literal_text_all_w_t_and_m_t":"-- TAG-CONTROLRESOURCESETZERO-START","paragraph_zero_based":16577},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16578},{"literal_text_all_w_t_and_m_t":"ControlResourceSetZero ::=                  INTEGER (0..15)","paragraph_zero_based":16579},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16580},{"literal_text_all_w_t_and_m_t":"-- TAG-CONTROLRESOURCESETZERO-STOP","paragraph_zero_based":16581},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":16582},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16583}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["001c1a57f256ff5d4f6fab911131da97ed61394e7562b4a10e4467911e7fb306","c67a31fba1141c14d3e1a5cfba1e406e2dbe1f15538095bf7a7300141703aba1","b860ca2497bffc9ad786776961c6ba34aedffed67bc083eb7eb6b15993b6f70f","fe04840813ff5b3261f9393c7d87791ab756b0e3eaed8a160a363ca1b0de3bd4","961cd8b577c88374ca104162ede60bacef91995b8324932f339ed53659a4643b","a52ae4b387284d6adc68c9b89e0c544c5cc5b1bc737ae4ac99655bc696ad28ca","639205a0a44220556e4d88f1727e29b06311c5955f7c50264f37b01f53a8ef70","9c2c7713bdeda78ef2980149dadc790e183493933383160253c355c9a57265e3","619e3d750d873ed4b0aa2b012a9fac0f24445cf3c80703c89c8e7146ebb9a1d7","819bad6254fdeb2d861949890fcc8bd109e3fe7f2d2f9336b1bfde5d338cc08c","68a00fc7a540af1ed0450f60cebec8140970b3155b65e1ce5e880c07d6917357","3a44074e05adc2e0941d95fde144558c3c5f6f4b31b458f24a8dd2559d21f036","1f6b06a1e8a8fd8a996a8dce2cbbbfd7a255f5be2f360654254c21b29d2de480","7ec09a9e55f9ebb0db87013c1f1142f6d011e77875ff1ed4cc5b10953140bea7","fe496b6b1b0696a73e5b6b26c42aeacab7521a93b07c3eba51cc0fba5c93d045","bf55d63df94dd0392ee46f4fb72d54c2438de5bc186382cd3a8ad52511c3692f","40e5902575634cedfc29a984124eae440daa12a9eefb3b1a8659835a4fe9d4f9","68a8c6d8fa41c30790c4ecf44424656e9f38711866ba