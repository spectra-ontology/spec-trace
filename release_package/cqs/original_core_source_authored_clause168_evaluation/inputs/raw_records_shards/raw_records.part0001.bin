48e08ad544f37b628a62813","ebd366dc8d819b3614d8757653b34df659a5ef6bef897be4bb1bb4dcd85d53a6","5bf2b39ccf82f2a93b5a5ce70b70cd7b5e3e97eb2fadbed0c36d3b89bab0f467","53aa4e6c0774dcf7de085114b7d22892f6ffd3327c34ef3cccc4d45eb67f84c5","5b6d7246d5424681c5cd8896dfaadc405685f305393a3328ac556833f308111f","84d372fd3d137f3bb251fb9c578c4e911bb1d9c4a1cf3a120b2f675fd75bac36","3e5586c9520e2a0d6f4e05b45a64e880b289381567d882ae40f114bb83175cfb","2ff41907f70b6e4c12e1d99f07c7fb79b271135a803d1018d6e44f5b95cfed2f","0b2d88fd83242ab6c0b5a05a14287eb31697a106d6ba46922388310e1fef5e13","73db1acc8ed42bf0b18b8231ebf50f4854c2cba84fcbb0d2d972f72bc5d968bf","4c2eca56d33ef38c671da0392cfb42b9f6b26d20069ecfcaa9a4c279b2a5af9d","59e6aa501ce74ad1032f51ee1a34fb72de0252d47721270e0b49759fbbf98d0f","625c9b6740720f0f28d2541bc5a273b41088f14125d8e9bebfbc12b6412f68de","e30474b8e9d6eeaca308d34c50de7bc7e199ac7de2352bb82b8c42278fcef68e","f3119c00bb04e96110a40516ba38b80b34ccc0bb3dbb66dd57aa29f82159418f","4f3c9df7b5b337987aabb497e5a6533ac44fd3baa6a17d482d733156c078c04a","334995aba695f48c9d75a852cd66ebc2004a49eeb3c3cc0f5d4800753aebba80","5d916fb77739f99b0a86259be4ba42385c57dcd28909df6467e4e9bc9bac5fa9","0736e5103835ab1eaefc2d3412205d479e03870d177d06a181c745d4f1e103c7","968955a6a8911cd3be275eb81d365e1185f93e0de0a420674745b1361f39d78d","d8a78fed9752fbb44942ca30f9a0b42c4ff961e23c7b73f15136277b6306faaa"],"paragraph_range_zero_based":[27312,27335],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p27312"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27336},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27337},{"literal_text_all_w_t_and_m_t":"SearchSpace field descriptions","paragraph_zero_based":27338},{"literal_text_all_w_t_and_m_t":"common","paragraph_zero_based":27339},{"literal_text_all_w_t_and_m_t":"Configures this search space as common search space (CSS) and DCI formats to monitor.","paragraph_zero_based":27340},{"literal_text_all_w_t_and_m_t":"controlResourceSetId","paragraph_zero_based":27341},{"literal_text_all_w_t_and_m_t":"The CORESET applicable for this SearchSpace. Value 0 identifies the common CORESET#0 configured in MIB and in ServingCellConfigCommon. Values 1..maxNrofControlResourceSets-1 identify CORESETs configured in System Information or by dedicated signalling. The CORESETs with non-zero controlResourceSetId are configured in the same BWP as this SearchSpace except commonControlResourceSetExt which is configured by SIB20. If the field controlResourceSetId-r16 is present, UE shall ignore the controlResourceSetId (without suffix).","paragraph_zero_based":27342},{"literal_text_all_w_t_and_m_t":"dummy1, dummy2","paragraph_zero_based":27343},{"literal_text_all_w_t_and_m_t":"This field is not used in the specification. If received it shall be ignored by the UE.","paragraph_zero_based":27344},{"literal_text_all_w_t_and_m_t":"dci-Format0-0-AndFormat1-0","paragraph_zero_based":27345},{"literal_text_all_w_t_and_m_t":"If configured, the UE monitors the DCI formats 0_0 and 1_0 according to TS 38.213 [13], clause 10.1.","paragraph_zero_based":27346},{"literal_text_all_w_t_and_m_t":"dci-Format2-0","paragraph_zero_based":27347},{"literal_text_all_w_t_and_m_t":"If configured, UE monitors the DCI format 2_0 according to TS 38.213 [13], clause 10.1, 11.1.1.","paragraph_zero_based":27348},{"literal_text_all_w_t_and_m_t":"dci-Format2-1","paragraph_zero_based":27349},{"literal_text_all_w_t_and_m_t":"If configured, UE monitors the DCI format 2_1 according to TS 38.213 [13], clause 10.1, 11.2.","paragraph_zero_based":27350},{"literal_text_all_w_t_and_m_t":"dci-Format2-2","paragraph_zero_based":27351},{"literal_text_all_w_t_and_m_t":"If configured, UE monitors the DCI format 2_2 according to TS 38.213 [13], clause 10.1, 11.3.","paragraph_zero_based":27352},{"literal_text_all_w_t_and_m_t":"dci-Format2-3","paragraph_zero_based":27353},{"literal_text_all_w_t_and_m_t":"If configured, UE monitors the DCI format 2_3 according to TS 38.213 [13], clause 10.1, 11.4","paragraph_zero_based":27354},{"literal_text_all_w_t_and_m_t":"dci-Format2-4","paragraph_zero_based":27355},{"literal_text_all_w_t_and_m_t":"If configured, UE monitors the DCI format 2_4 according to TS 38.213 [13], clause 11.2A.","paragraph_zero_based":27356},{"literal_text_all_w_t_and_m_t":"dci-Format2-5","paragraph_zero_based":27357},{"literal_text_all_w_t_and_m_t":"If configured, IAB-MT monitors the DCI format 2_5 according to TS 38.213 [13], clause 14.","paragraph_zero_based":27358},{"literal_text_all_w_t_and_m_t":"dci-Format2-6","paragraph_zero_based":27359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["897ed77148198a7fe7242ed6aef15a1902903f49e79fe49c65fbf30df8c0a58a","a7258b61c9a2a62775ae64774c0608f3bf286281efe32839a6f5c2bf2a2cbf79","16ed3f067ca9b0d68e9587cda78902bcbb7b22101a43e7096d0ca1fbab3e56a5","3e0369566f6becdc1f31ecccec7a35a2c20dc9326c4cf86b905781a02c464db1","9b01508e2c14a91cdf1968cdc49995b1a201b9198dbe8b268d6ad65234f8f15a","81c4a42dc85f2b3fc6ec5bf4a6cede38f4e558934653cf2481bed5e8a010e40e","a5961d9f4e52f50064beb2d40d19fdb9bbf8b8ca8db2baa50bcedefb9546b9c7","70d7966c41824816c7e1e944bea3a0eda93d1dd610b7974adc3ce2d4f1193c8f","69137413ec6e90efa4438cd265f44229359f758c7b36f3a8d3d6e5a714030583","cdacf9de717dc5631609217bf13bf407e35c78ef750e752bd9bfe9bc6a42a4aa","62ad531bea4a933408706d23792598f639eddcef823e9be2f86a3f69fa5be74d","aa52f2898d2321c64488d4803bddd84727f7860524e3be1d1e8a87b363e840b7","a953c0bfb806025eb8f8fbe1f7de67f451d6ed253b856700576b29b29b9fdcc0","3fc08547b835d2b5e8eb410f6909a677d7c1ebdc840116a10259385ad5b62c87","74de362dcea044876ee204d74199502bc35c2c52c766fdcf5702b6b4add9197e","fc4cdf055cf6b77b7d6ea821b8e78bdd3105517b3a2f3aea31e18f783315d961","5b965009f0c563c1f851804095977b53889c6b6a1b65cce48fa018b87d2b1b3b","21d8b993595091117ff6d1e09503cb148f096daf14d23c6703c56565e3202c99","17c55f80d13ac4158b96c3b74589aa6a46855c706e28e29ff7d339b56139ed9b","e19c4843b8ad235842f3ebde9eae602cc36da2803b870c40b8996fbdfbba48fb","6f7a5583a897d4868fbd6293962d8cc6d0c078a957025e4843c54295aad73369","78311a54f2931caf788ceae602b143ff7bb9d662ac02e929a55c3e803e4be69a","382e7c909b88f0e0ba273f8a18c85bf84fa5104dcf6a440509dbed770e20d6a2","c4dc80a4c3361ec4e61a09b97844c6a758fc91cb5dc56e170e339ab2c42c8f51"],"paragraph_range_zero_based":[27336,27359],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p27336"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"If configured, UE monitors the DCI format 2_6 according to TS 38.213 [13], clause 10.1, 10.3. DCI format 2_6 can only be configured on the SpCell.","paragraph_zero_based":27360},{"literal_text_all_w_t_and_m_t":"dci-Format2-7","paragraph_zero_based":27361},{"literal_text_all_w_t_and_m_t":"If configured, UE monitors the DCI format 2_7 according to TS 38.213 [13], clause 10.1, 10.4A.","paragraph_zero_based":27362},{"literal_text_all_w_t_and_m_t":"dci-Format4-0","paragraph_zero_based":27363},{"literal_text_all_w_t_and_m_t":"If configured, the UE monitors the DCI format 4_0 with CRC scrambled by MCCH-RNTI/G-RNTI according to TS 38.213 [13], clause [10.1].","paragraph_zero_based":27364},{"literal_text_all_w_t_and_m_t":"dci-Format4-1-AndFormat4-2","paragraph_zero_based":27365},{"literal_text_all_w_t_and_m_t":"If configured, the UE monitors the DCI format 4_1 and 4_2 with CRC scrambled by G-RNTI/G-CS-RNTI according to TS 38.213 [13], clause [11.1].","paragraph_zero_based":27366},{"literal_text_all_w_t_and_m_t":"dci-Format4-1","paragraph_zero_based":27367},{"literal_text_all_w_t_and_m_t":"If configured, the UE monitors the DCI format 4_1 with CRC scrambled by G-RNTI/G-CS-RNTI according to TS 38.213 [13], clause [10.1].","paragraph_zero_based":27368},{"literal_text_all_w_t_and_m_t":"dci-Format4-2","paragraph_zero_based":27369},{"literal_text_all_w_t_and_m_t":"If configured, the UE monitors the DCI format 4_2 with CRC scrambled by G-RNTI/G-CS-RNTI according to TS 38.213 [13], clause [10.1].","paragraph_zero_based":27370},{"literal_text_all_w_t_and_m_t":"dci-Formats","paragraph_zero_based":27371},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE monitors in this USS for DCI formats 0-0 and 1-0 or for formats 0-1 and 1-1.","paragraph_zero_based":27372},{"literal_text_all_w_t_and_m_t":"dci-FormatsExt","paragraph_zero_based":27373},{"literal_text_all_w_t_and_m_t":"If this field is present, the field dci-Formats is ignored and dci-FormatsExt is used instead to indicate whether the UE monitors in this USS for DCI format 0_2 and 1_2 or formats 0_1 and 1_1 and 0_2 and 1_2 (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13], clause 10.1). This field is not configured for operation with shared spectrum channel access in this release.","paragraph_zero_based":27374},{"literal_text_all_w_t_and_m_t":"dci-Formats-MT","paragraph_zero_based":27375},{"literal_text_all_w_t_and_m_t":"Indicates whether the IAB-MT monitors the DCI formats 2-5 according to TS 38.213 [13], clause 14.","paragraph_zero_based":27376},{"literal_text_all_w_t_and_m_t":"dci-FormatsSL","paragraph_zero_based":27377},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE monitors in this USS for DCI formats 0-0 and 1-0 or for formats 0-1 and 1-1 or for format 3-0 or for format 3-1 or for formats 3-0 and 3-1. If this field is present, the field dci-Formats is ignored and dci-FormatsSL is used.","paragraph_zero_based":27378},{"literal_text_all_w_t_and_m_t":"duration","paragraph_zero_based":27379},{"literal_text_all_w_t_and_m_t":"Number of consecutive slots that a SearchSpace lasts in every occasion, i.e., upon every period as given in the periodicityAndOffset. If the field is absent, the UE applies the value 1 slot, except for DCI format 2_0. The UE ignores this field for DCI format 2_0. The maximum valid duration is periodicity-1 (periodicity as given in the monitoringSlotPeriodicityAndOffset).","paragraph_zero_based":27380},{"literal_text_all_w_t_and_m_t":"For SCS 480 kHz and SCS 960 kHz, duration-r17 is used, and the configured duration is restricted to be an integer multiple of L slots and smaller than periodicity, where L is the configured length of the bitmap monitoringSlotsWithinSlotGroup-r17. If duration-r17 is absent, the UE assumes the duration in slots is equal to L. The maximum valid duration is periodicity-L.","paragraph_zero_based":27381},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27382},{"literal_text_all_w_t_and_m_t":"For IAB-MT, duration indicates number of consecutive slots that a SearchSpace lasts in every occasion, i.e., upon every period as given in the periodicityAndOffset. If the field is absent, the IAB-MT applies the value 1 slot, except for DCI format 2_0 and DCI format 2_5. The IAB-MT ignores this field for DCI format 2_0 and DCI format 2_5. The maximum valid duration is periodicity-1 (periodicity as given in the monitoringSlotPeriodicityAndOffset).","paragraph_zero_based":27383}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["3b8c21cce22c5cf62e2edc800ba90204f6e1b87729ebbeb476c58e34b68262d0","8d89be7b234fe1857ae44b9b559d0d47d54d80cec217134e36466a8a911ec11f","f86076b4809861f2d36eb41b8f33f4d85b2156347b4fd617c24c32812dee6247","78599548e80ac93060908ee4c93ef4a51a2c82814a269ecf0447c202c66ac935","d7e1f8bca82a115d42e37b49a78d5e4bd05dea30439a51c9b629057d67979e3c","f12f36b15c4121fdf9a63144e641a34dbb84db6da2ad616ab52a563e91245ff9","03fb5735b8ef75aa04febc80231cb936f6efb2cc092bc3ed49df36518eba207b","1fccb1ce56367612c7f151cd3b99e203165778469eea53eaa7416862dacfe98a","65a96795cef67464defdb55ba5b2e4f6e89142cf2be06ffa572dd1d6c9003ce3","94a53ecd8bf4b905c4764ea3d5f0947b2cd933159f361f3ab627fef3a513e31e","dec394e36019ecf562120160cec2940423821354e9b7c2dbdc4383b1b7b98633","db4ad25802d5076a142f20eb73eaebe23dd3e79a0bec83c5b50e402e7e89beea","f8f4cff7884a5ba300c3aa10ce8f2f886d56d0a414d8e7a13cd1e9bb28c9d4b9","5ec269f0e9a0c49ca2a08ef525eb92ae8974544a79e40c1669820adda1ca2d9c","b9464657cd2900fa9f6bcd562d7674abfc942422279bd704729a353087e6c984","fa0f83376169039fd0686fb3d62e4934b3da324b9f219390db3408d9eca4f59d","7ed8cba19f2f0fe777c9787cf4b943466270ab6b973d5f4e342c3be78b0b845a","ac72c4fa28dd336f52a70dedc18a524f2e8321437cce4b7df2d1200a3a58e5a1","e2eca8eba6b6ffe6f12d31219d7e0596a5508c375394681ff7329777cd0885c2","b0c0b36a4e4002c8eb91990da41a72809d4df0571ced0a312a1eecc9b4b9fb9c","be6ca5d008e13d644a20eb46e2af921c444276266bb85a8e37a2f3f2d7c13b1f","c282b0ec3bcc5fd7d07eda22779668cb1699067144246ca50ad3f32711729947","2395803b65394f61975d371b8c996daff2177938a095d97b3e04291184c8d40e","152725a91e66011aef4d905c5fa2298fbd1528a91cbca7aa0bb2832a65bade66"],"paragraph_range_zero_based":[27360,27383],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p27360"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"freqMonitorLocations","paragraph_zero_based":27384},{"literal_text_all_w_t_and_m_t":"Defines an association of the search space to multiple monitoring locations in the frequency domain and indicates whether the pattern configured in the associated CORESET is replicated to a specific RB set, see TS 38.213, clause 10.1. Each bit in the bitmap corresponds to one RB set, and the leftmost (most significant) bit corresponds to RB set 0 in the BWP. A bit set to 1 indicates that a frequency domain resource allocation replicated from the pattern configured in the associated CORESET is mapped to the RB set.","paragraph_zero_based":27385},{"literal_text_all_w_t_and_m_t":"monitoringSlotPeriodicityAndOffset","paragraph_zero_based":27386},{"literal_text_all_w_t_and_m_t":"Slots for PDCCH Monitoring configured as periodicity and offset.","paragraph_zero_based":27387},{"literal_text_all_w_t_and_m_t":"For SCS 15, 30, 60, and 120 kHz and if the UE is configured to monitor:","paragraph_zero_based":27388},{"literal_text_all_w_t_and_m_t":"- DCI format 2_1, only the values 'sl1', 'sl2' or 'sl4' are applicable.","paragraph_zero_based":27389},{"literal_text_all_w_t_and_m_t":"- DCI format 2_0, only the values ′sl1′, ′sl2′, ′sl4′, ′sl5′, ′sl8′, ′sl10′, ′sl16′, and ′sl20′ are applicable (see TS 38.213 [13], clause 10).","paragraph_zero_based":27390},{"literal_text_all_w_t_and_m_t":"- DCI format 2_4, only the values 'sl1', 'sl2', 'sl4', 'sl5', 'sl8' and 'sl10' are applicable.","paragraph_zero_based":27391},{"literal_text_all_w_t_and_m_t":"For SCS 480 kHz and if the UE is configured to monitor:","paragraph_zero_based":27392},{"literal_text_all_w_t_and_m_t":"- DCI format 2_0, only the values 'sl4', 'sl8', 'sl16', 'sl20', 'sl32', 'sl40', 'sl64', and 'sl80' are applicable.","paragraph_zero_based":27393},{"literal_text_all_w_t_and_m_t":"- DCI format 2_1, only the values ′sl4′, ′sl8′, and ′sl16′ are applicable.","paragraph_zero_based":27394},{"literal_text_all_w_t_and_m_t":"- DCI format 2_4, only the values 'sl4', 'sl8', 'sl16', 'sl20', 'sl32', 'sl40' are applicable.","paragraph_zero_based":27395},{"literal_text_all_w_t_and_m_t":"For SCS 960 kHz and if the UE is configured to monitor:","paragraph_zero_based":27396},{"literal_text_all_w_t_and_m_t":"- DCI format 2_0, only the values 'sl8', 'sl16', 'sl32', 'sl40', 'sl64', 'sl80', 'sl128', and 'sl160' are applicable.","paragraph_zero_based":27397},{"literal_text_all_w_t_and_m_t":"- DCI format 2_1, only the values ′sl8′, ′sl16′, and 'sl32' are applicable.","paragraph_zero_based":27398},{"literal_text_all_w_t_and_m_t":"- DCI format 2_4, only the values 'sl8', 'sl16', 'sl32', 'sl40', 'sl64', 'sl80' are applicable.","paragraph_zero_based":27399},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27400},{"literal_text_all_w_t_and_m_t":"For SCS 480 kHz and SCS 960 kHz, and the configured periodicity and offset are restricted to be an integer multiple of L slots, where L is the configured length of the bitmap provided by monitoringSlotsWithinSlotGroup-r17, i.e. for a given periodicity, the offset has a range of {0, L, 2*L, …, L*FLOOR(1/L*(periodicity-1))}.","paragraph_zero_based":27401},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27402},{"literal_text_all_w_t_and_m_t":"For IAB-MT, If the IAB-MT is configured to monitor DCI format 2_1, only the values 'sl1', 'sl2' or 'sl4' are applicable. If the IAB-MT is configured to monitor DCI format 2_0 or DCI format 2_5, only the values ′sl1′, ′sl2′, ′sl4′, ′sl5′, ′sl8′, ′sl10′, ′sl16′, and ′sl20′ are applicable (see TS 38.213, clause 10).","paragraph_zero_based":27403},{"literal_text_all_w_t_and_m_t":"If monitoringSlotPeriodicityAndOffset-v1710 is present, any previously configured monitoringSlotPeriodicityAndOffset is released, and if monitoringSlotPeriodicityAndOffset is present, any previously configured monitoringSlotPeriodicityAndOffset-v1710 is released.","paragraph_zero_based":27404},{"literal_text_all_w_t_and_m_t":"monitoringSlotsWithinSlotGroup","paragraph_zero_based":27405},{"literal_text_all_w_t_and_m_t":"Indicates which slot(s) within a slot group are configured for multi-slot PDCCH monitoring. The first (leftmost, most significant) bit represents the first slot in the slot group, the second bit represents the second slot in the slot group, and so on. A bit set to '1' indicates that the corresponding slot is configured for multi-slot PDCCH monitoring (see TS 38.213 [13], clause 10). The number of slots for multi-slot PDCCH monitoring is configured according to clause 10 in TS 38.213 [13].","paragraph_zero_based":27406},{"literal_text_all_w_t_and_m_t":"monitoringSymbolsWithinSlot","paragraph_zero_based":27407}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["d3ea98c4c4169606deb29f646925dca6f459262d907d2a5311cd09085a6132c0","72c965461170e1ceca5b97a46f20c648999c155c8fea3f17caf6322dee109a60","be900ef69d0cb9cd75354651a18168f56bccd7a1e45fcc184e528635b571bc57","33ca67d23d30ee8c7b2c3145d8bcc21ea2ef8d4d667b059e076a5de28a71f327","dd9159ef690273232101f24f033648b0c97ca100bc78f27cb38cec9e3ec062e6","42d3118bd47153202bb529338275de08ce93d9bee99edbe2c596b212ae73e218","271e8e0f08cb3bdd29cd2d28569f396b60cf1b92876bb406af3167fd155a7dfb","4b31943c93b8c80a4209a907b393ce30b13bb7059cb84d6a4b2585b56e7243e8","49b1369d18664146492deb2cd325b7afd30105f6704b7a5c48c8db2878576fa2","e645402d5ab4d9588e8af6098d7005d0e12f25034ec07531320b3874371eec95","05ec547b888ede6fc166a19f2021bd2ff5e678efaedf0ddebb4fb389acaf2124","4637eb19a35ff3ac61a26d15010e969bbe8255c1a85513697599afe3f07dbcbf","bc031e378ad1f3eed50982e3f1413e3c4e4a6af969d3ca8ce5647e452ec0745f","3cd952e8ec8a5b568cd3c72e2228f6f9121c54f2d7dcb561a80cab2916bff7f3","b47370d4e5902854b43811154272bdb115b6e2d94b23c56b4abf8e61b557127c","b4de1374dd39118fef5676090664fae90296e8180f7a03e04a95fd3ee70f2f23","ba518b8db2440d4d43f7541e1a43129f26986255f108d6cf6d53266a0da3d5e8","6901d72ab6a2afadee4976329d873877d4b54d239ddae55a08b06af1668e6083","361495931cbef8de9c8ffaba5a6bfcd6758b4ee796ae4588967d5fb0b52e5e58","a905aeebd2209bc9ae36b455f980062df4298c871116bc6e9b6d4c4bc7e6aca6","f233bcde3595e4580ff23ead20f5e2fbb067dce5a35ad31ec2a2d8b8cbb7b47d","742056003176bd62f38f1abc689402f7b4adccb872b749941c0db6c72f7bd669","32d458d08e4f5924d64b3ddabc0ab5752fa5fe79201e7439f89f85eb1f69a2f4","af87eba1bd7586846df1ba9373d46ad151d51057d3c0f73ca8f17a52704ed497"],"paragraph_range_zero_based":[27384,27407],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p27384"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The first symbol(s) for PDCCH monitoring in the slots configured for (multi-slot) PDCCH monitoring (see monitoringSlotPeriodicityAndOffset and duration). The most significant (left) bit represents the first OFDM in a slot, and the second most significant (left) bit represents the second OFDM symbol in a slot and so on. The bit(s) set to one identify the first OFDM symbol(s) of the control resource set within a slot. If the cyclic prefix of the BWP is set to extended CP, the last two bits within the bit string shall be ignored by the UE or IAB-MT.","paragraph_zero_based":27408},{"literal_text_all_w_t_and_m_t":"For DCI format 2_0, the first one symbol applies if the duration of CORESET (in the IE ControlResourceSet) identified by controlResourceSetId indicates 3 symbols, the first two symbols apply if the duration of CORESET identified by controlResourceSetId indicates 2 symbols, and the first three symbols apply if the duration of CORESET identified by controlResourceSetId indicates 1 symbol.","paragraph_zero_based":27409},{"literal_text_all_w_t_and_m_t":"See TS 38.213 [13], clause 10.","paragraph_zero_based":27410},{"literal_text_all_w_t_and_m_t":"For IAB-MT: For DCI format 2_0 or DCI format 2_5, the first one symbol applies if the duration of CORESET (in the IE ControlResourceSet) identified by controlResourceSetId indicates 3 symbols, the first two symbols apply if the duration of CORESET identified by controlResourceSetId indicates 2 symbols, and the first three symbols apply if the duration of CORESET identified by controlResourceSetId indicates 1 symbol.","paragraph_zero_based":27411},{"literal_text_all_w_t_and_m_t":"See TS 38.213 [13], clause 10.","paragraph_zero_based":27412},{"literal_text_all_w_t_and_m_t":"nrofCandidates-CI","paragraph_zero_based":27413},{"literal_text_all_w_t_and_m_t":"The number of PDCCH candidates specifically for format 2-4 for the configured aggregation level. If an aggregation level is absent, the UE does not search for any candidates with that aggregation level. The network configures only one aggregationLevel and the corresponding number of candidates (see TS 38.213 [13], clause 10.1).","paragraph_zero_based":27414},{"literal_text_all_w_t_and_m_t":"nrofCandidates-PEI","paragraph_zero_based":27415},{"literal_text_all_w_t_and_m_t":"The number of PDCCH candidates specifically for format 2-7 for the configured aggregation level.","paragraph_zero_based":27416},{"literal_text_all_w_t_and_m_t":"nrofCandidates-SFI","paragraph_zero_based":27417},{"literal_text_all_w_t_and_m_t":"The number of PDCCH candidates specifically for format 2-0 for the configured aggregation level. If an aggregation level is absent, the UE does not search for any candidates with that aggregation level. The network configures only one aggregationLevel and the corresponding number of candidates (see TS 38.213 [13], clause 11.1.1). For a search space configured with freqMonitorLocations-r16, only value ′n1′ is valid.","paragraph_zero_based":27418},{"literal_text_all_w_t_and_m_t":"nrofCandidates","paragraph_zero_based":27419},{"literal_text_all_w_t_and_m_t":"Number of PDCCH candidates per aggregation level. The number of candidates and aggregation levels configured here applies to all formats unless a particular value is specified or a format-specific value is provided (see inside searchSpaceType). If configured in the SearchSpace of a cross carrier scheduled cell, this field determines the number of candidates and aggregation levels to be used on the linked scheduling cell (see TS 38.213 [13], clause 10).","paragraph_zero_based":27420},{"literal_text_all_w_t_and_m_t":"searchSpaceGroupIdList-r16, searchSpaceGroupIdList-r17","paragraph_zero_based":27421},{"literal_text_all_w_t_and_m_t":"List of search space group IDs which the search space is associated with. The network configures at most 2 search space groups per BWP where the group ID is either 0 or 1 if searchSpaceGroupIdList-r16 is included. The network configures at most 3 search space groups per BWP where the group ID is either 0, 1 or 2 if searchSpaceGroupIdList-r17 is included. And if searchSpaceGroupIdList-r17 is included, searchSpaceGroupIdList-r16 is ignored.","paragraph_zero_based":27422},{"literal_text_all_w_t_and_m_t":"searchSpaceId","paragraph_zero_based":27423},{"literal_text_all_w_t_and_m_t":"Identity of the search space. SearchSpaceId = 0 identifies the searchSpaceZero configured via PBCH (MIB) or ServingCellConfigCommon and may hence not be used in the SearchSpace IE. The searchSpaceId is unique among the BWPs of a Serving Cell. In case of cross carrier scheduling, search spaces with the same searchSpaceId in scheduled cell and scheduling cell are linked to each other. The UE applies the search space for the scheduled cell only if the DL BWPs in which the linked search spaces are configured in scheduling cell and scheduled cell are both active.","paragraph_zero_based":27424},{"literal_text_all_w_t_and_m_t":"For an IAB-MT, the search space defines how/where to search for PDCCH candidates for an IAB-MT where each search space is associated with one ControlResearchSet and for a scheduled cell in the case of cross carrier scheduling, except for nrofCandidates, all the optional fields are absent.","paragraph_zero_based":27425},{"literal_text_all_w_t_and_m_t":"SearchSpaceLinkingId","paragraph_zero_based":27426},{"literal_text_all_w_t_and_m_t":"This parameter is used to link two search spaces of same type in the same BWP. If two search spaces have the same SearchSpaceLinkingId UE assumes these search spaces are linked to PDCCH repetition REF. When PDCCH repetition is monitored in two linked search space (SS) sets, the UE does not expect a third monitored SS set to be linked with any of the two linked SS sets. The two linked SS sets have the same SS set type (USS/CSS). The two linked SS sets have the same DCI formats to monitor. For intra-slot PDCCH repetition: The two SS sets should have the same periodicity and offset (monitoringSlotPeriodicityAndOffset), and the same duration. For linking monitoring occasions across the two SS sets that exist in the same slot: The two SS sets have the same number of monitoring occasions within a slot and n-th monitoring occasion of one SS set is linked to n-th monitoring occasion of the other SS set. The following SS sets cannot be linked with another SS set for PDCCH repetition: SS set 0, searchSpaceSIB1, searchSpaceOtherSystemInformation, pagingSearchSpace, ra-SearchSpace, searchSpaceMCCH, searchSpaceMTCH, peiSearchSpace, and sdt-SearchSpace. SS set configured by recoverySearchSpaceId cannot be linked to another SS set for PDCCH repetition. When a scheduled serving cell is configured to be cross-carrier scheduled by a scheduling serving cell, two PDCCH candidates (with the same AL and candidate index associated with the scheduled serving cell) are linked only if the corresponding two SS sets in the scheduling serving cell are linked and two SS sets in the scheduled serving cell with the same SS set IDs are also linked.","paragraph_zero_based":27427},{"literal_text_all_w_t_and_m_t":"This parameter is not applicable to search space configured with dci-FormatsSL for monitoring format 3-0 or format 3-1 or for monitoring formats 3-0 and format 3-1.","paragraph_zero_based":27428},{"literal_text_all_w_t_and_m_t":"searchSpaceType","paragraph_zero_based":27429},{"literal_text_all_w_t_and_m_t":"Indicates whether this is a common search space (present) or a UE specific search space as well as DCI formats to monitor for.","paragraph_zero_based":27430},{"literal_text_all_w_t_and_m_t":"ue-Specific","paragraph_zero_based":27431}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["fe6c73cab6050e0e5fb81c1ce7aad39ad6f7714cc73a6d12829ecddc199f3353","30adf3e41c4874e1d9499382b638d22d91b3e765230e9d79f2501a0a9f8deace","3933103da35571c077469ada509a11dc0b302febd0619fd600b8c55965eab460","8f643f3928d3cad9dedb525b58ba4f8a1808581c0efa395d4a4507f3f6611c51","aac03eb863c98575f6475c57a0e797fa18fff579f00b8843b7c9a260db189f21","7bc113f1cafb75df4d7f88257994476036f11877e7692dafaf17b7a364de95e5","7cd6166a70eedc6b887e47271ab4af608e5e081ec086664c5cdd1c5c16399dc0","f2bbf8aa1324d62d8925ab9aadcc13778a58fd156d17668a901abc6681565bbe","4dfd0ac773312a7e833cd189e3aa845b94236016ea1811b4b7060d725295a8f7","fc9f52cf1197f1a077c874ea5c77f03667ba33e600fb3b250a3fa1327927f68e","20a696ff21d8ea59a65fad1dcbf988475ce1fe4110272d2c7da7f609301fd03d","ccca0b438167be531504bef2d3dda27eab7938ebc71338176ac949c81de0eba5","70cc33338e9601c05670bb453a9307d3961f64ce780456c63ffb2c7e8cbc064c","6f8ddc3b4885d61010fbba848671a8b04a924c4b7aa2416ead0bfbb613a748e9","6455417ef3064459f43523b848fb8c24017ae925d64ce3b5d109d38583631769","222cac91af0bbc725b9b404d9f5b44dbe0ccfc2977b2906a3e3d6c7bd590180b","f3ff0e6402fa52fd705ad7111f4c79cd463df2ff8182c6c09e53d25e333298a5","b6122d1b799985a5446331a85ad16ac696bbf7739bffdce55b2193f65f6834fc","8498692376d94c6efd5f9b14d46933e3d9f2512b0e655d3445d73a968f0c724d","04541e4bc0c80d2e614b86009c53175bf08de60f171f4fedd3ba2b70a2070237","f5383f5d1c54122fcae59678c2a657557a9ae484bc9ad9c265b2536525c36183","18861b88fab59cafc0fe186f75e6131d0c178c78f1bc2ab65e88477319920ebd","9a35e770d8b8146296554f06d70289e3d5bd894a709d440da52dbd32e92d5b35","7e11077e891d244f080671ed15990bf6a3fbcc20b84978747a71c872ea87643b"],"paragraph_range_zero_based":[27408,27431],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p27408"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Configures this search space as UE specific search space (USS). The UE monitors the DCI format with CRC scrambled by C-RNTI, CS-RNTI (if configured), and SP-CSI-RNTI (if configured)","paragraph_zero_based":27432},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27433},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":27434},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":27435},{"literal_text_all_w_t_and_m_t":"DedicatedOnly","paragraph_zero_based":27436},{"literal_text_all_w_t_and_m_t":"In PDCCH-Config, the field is optionally present, Need R. Otherwise it is absent, Need R.","paragraph_zero_based":27437},{"literal_text_all_w_t_and_m_t":"Setup","paragraph_zero_based":27438},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new SearchSpace. It is optionally present, Need M, otherwise.","paragraph_zero_based":27439},{"literal_text_all_w_t_and_m_t":"Setup2","paragraph_zero_based":27440},{"literal_text_all_w_t_and_m_t":"This field is mandatory present when a new SearchSpace is set up, if the same SearchSpace ID is not included in searchSpacesToAddModListExt-r16 of the parent IE with the field searchSpaceType-r16 or searchSpaceType-r17 included. Otherwise it is optionally present, Need M.","paragraph_zero_based":27441},{"literal_text_all_w_t_and_m_t":"Setup3","paragraph_zero_based":27442},{"literal_text_all_w_t_and_m_t":"This field is mandatory present when a new SearchSpace is set up, if the same SearchSpace ID is not included in searchSpacesToAddModListExt (without suffix) of the parent IE with the field searchSpaceType (without suffix) included.  Otherwise it is optionally present, Need M.","paragraph_zero_based":27443},{"literal_text_all_w_t_and_m_t":"Setup4","paragraph_zero_based":27444},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new SearchSpace if monitoringSlotPeriodicityAndOffset-v1710 is not included. It is optionally present, Need M, otherwise.","paragraph_zero_based":27445},{"literal_text_all_w_t_and_m_t":"Setup5","paragraph_zero_based":27446},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new SearchSpace if monitoringSlotPeriodicityAndOffset (without suffix) is not included. It is optionally present, Need M, otherwise.","paragraph_zero_based":27447},{"literal_text_all_w_t_and_m_t":"SetupOnly","paragraph_zero_based":27448},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new SearchSpace. It is absent, Need M, otherwise.","paragraph_zero_based":27449},{"literal_text_all_w_t_and_m_t":"SetupOnly2","paragraph_zero_based":27450},{"literal_text_all_w_t_and_m_t":"In PDCCH-Config, the field is optionally present upon creation of a new SearchSpace and absent, Need M upon reconfiguration of an existing SearchSpace.","paragraph_zero_based":27451},{"literal_text_all_w_t_and_m_t":"In PDCCH-ConfigCommon, the field is absent.","paragraph_zero_based":27452},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27453},{"literal_text_all_w_t_and_m_t":"–SearchSpaceId","paragraph_zero_based":27454},{"literal_text_all_w_t_and_m_t":"The IE SearchSpaceId is used to identify Search Spaces. The ID space is used across the BWPs of a Serving Cell. The search space with the SearchSpaceId = 0 identifies the search space configured via PBCH (MIB) and in ServingCellConfigCommon (searchSpaceZero). The number of Search Spaces per BWP is limited to 10 including the common and UE specific Search Spaces.","paragraph_zero_based":27455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_