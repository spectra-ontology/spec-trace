{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":42792},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42793},{"literal_text_all_w_t_and_m_t":"SL-RoHC-Profiles-r16 ::=              SEQUENCE {","paragraph_zero_based":42794},{"literal_text_all_w_t_and_m_t":"    profile0x0001-r16                     BOOLEAN,","paragraph_zero_based":42795},{"literal_text_all_w_t_and_m_t":"    profile0x0002-r16                     BOOLEAN,","paragraph_zero_based":42796},{"literal_text_all_w_t_and_m_t":"    profile0x0003-r16                     BOOLEAN,","paragraph_zero_based":42797},{"literal_text_all_w_t_and_m_t":"    profile0x0004-r16                     BOOLEAN,","paragraph_zero_based":42798},{"literal_text_all_w_t_and_m_t":"    profile0x0006-r16                     BOOLEAN,","paragraph_zero_based":42799},{"literal_text_all_w_t_and_m_t":"    profile0x0101-r16                     BOOLEAN,","paragraph_zero_based":42800},{"literal_text_all_w_t_and_m_t":"    profile0x0102-r16                     BOOLEAN,","paragraph_zero_based":42801},{"literal_text_all_w_t_and_m_t":"    profile0x0103-r16                     BOOLEAN,","paragraph_zero_based":42802},{"literal_text_all_w_t_and_m_t":"    profile0x0104-r16                     BOOLEAN","paragraph_zero_based":42803},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":42804},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42805},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-PRECONFIGURATIONNR-STOP","paragraph_zero_based":42806},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":42807},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42808},{"literal_text_all_w_t_and_m_t":"SL-PreconfigurationNR field descriptions","paragraph_zero_based":42809},{"literal_text_all_w_t_and_m_t":"sl-DRX-PreConfig-GC-BC","paragraph_zero_based":42810},{"literal_text_all_w_t_and_m_t":"This field indicates the sidelink DRX configuration for groupcast and broadcast communication, as specified in TS 38.321 [3].","paragraph_zero_based":42811},{"literal_text_all_w_t_and_m_t":"sl-OffsetDFN","paragraph_zero_based":42812},{"literal_text_all_w_t_and_m_t":"Indicates the timing offset for the UE to determine DFN timing when GNSS is used for timing reference. Value 1 corresponds to 0.001 milliseconds, value 2 corresponds to 0.002 milliseconds, and so on. If the field is absent, no offset is applied.","paragraph_zero_based":42813},{"literal_text_all_w_t_and_m_t":"sl-PreconfigDiscConfig","paragraph_zero_based":42814},{"literal_text_all_w_t_and_m_t":"This field indicates the configuration for discovery message transmission used by NR sidelink U2N Remote UE. ","paragraph_zero_based":42815}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["047b91fd351ac93840205273a33116121515fb2be2ef8bd4c73d66e96434e571","80cae27619596f16e56d52d2d040d5654692816ac5ee6c0b50c655bbd3528c9d","4435b2b062155eb4b4d8ed8a3a1a5d3745e47b85da05a9cb223d9b2e7f7ae5d5","97e3aac79ca0a7988f7246808c121c161ce65b5ba2d8c4287f46332d15f970e4","744365f827ac3ba1a829ce6ad9340b4c7b04b7bf078d07920fd30a7be989675a","0030ade459b721fb6dfa4b282c65a8f7b3d992b5bffb6bfcbdb3c5d21bddb7f1","7c5218841a7f8cc19e10d4c7dbed5a4e0a9031c52be23165493dfe5daf1c229e","03091f97a64c8d221b03da9754fb533b10266b7f631603094c0325be0492e2af","a5bce6924b744528e361b8c8e7ef00b2528c38f89ceb457fdea549be4df7fb03","aded4b662802a227bf8ae51ff81633967f760573b4fde0371ee435a3af7831e2","e8c8b9ad53265b6d1801ebf4a5d27395e5128ddfbcfa40f621f4c3c6188d1c7f","b610ef125fa59cccf2066fb8cbed7bcb069667979ec454e5c2d56941a16f039a","5a5