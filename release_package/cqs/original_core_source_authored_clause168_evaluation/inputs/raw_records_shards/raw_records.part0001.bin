{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"FrequencyInfoUL ::=                 SEQUENCE {","paragraph_zero_based":18744},{"literal_text_all_w_t_and_m_t":"    frequencyBandList                   MultiFrequencyBandListNR                                OPTIONAL,   -- Cond FDD-OrSUL","paragraph_zero_based":18745},{"literal_text_all_w_t_and_m_t":"    absoluteFrequencyPointA             ARFCN-ValueNR                                           OPTIONAL,   -- Cond FDD-OrSUL","paragraph_zero_based":18746},{"literal_text_all_w_t_and_m_t":"    scs-SpecificCarrierList             SEQUENCE (SIZE (1..maxSCSs)) OF SCS-SpecificCarrier,","paragraph_zero_based":18747},{"literal_text_all_w_t_and_m_t":"    additionalSpectrumEmission          AdditionalSpectrumEmission                              OPTIONAL,   -- Need S","paragraph_zero_based":18748},{"literal_text_all_w_t_and_m_t":"    p-Max                               P-Max                                                   OPTIONAL,   -- Need S","paragraph_zero_based":18749},{"literal_text_all_w_t_and_m_t":"    frequencyShift7p5khz                ENUMERATED {true}                                       OPTIONAL,   -- Cond FDD-TDD-OrSUL-Optional","paragraph_zero_based":18750},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":18751},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":18752},{"literal_text_all_w_t_and_m_t":"    additionalSpectrumEmission-v1760    AdditionalSpectrumEmission-v1760                        OPTIONAL    -- Need S","paragraph_zero_based":18753},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":18754},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":18755},{"literal_text_all_w_t_and_m_t":"    additionalSpectrumEmissionAerial-r18   AdditionalSpectrumEmission-r18                       OPTIONAL   -- Need S","paragraph_zero_based":18756},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":18757},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18758},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18759},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQUENCYINFOUL-STOP","paragraph_zero_based":18760},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18761},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18762},{"literal_text_all_w_t_and_m_t":"FrequencyInfoUL field descriptions","paragraph_zero_based":18763},{"literal_text_all_w_t_and_m_t":"absoluteFrequencyPointA","paragraph_zero_based":18764},{"literal_text_all_w_t_and_m_t":"Absolute frequency of the reference resource block (Common RB 0). Its lowest subcarrier is also known as Point A. Note that the lower edge of the actual carrier is not defined by this field but rather in the scs-SpecificCarrierList (see TS 38.211 [16], clause 4.4.4.2).","paragraph_zero_based":18765},{"literal_text_all_w_t_and_m_t":"additionalSpectrumEmission","paragraph_zero_based":18766},{"literal_text_all_w_t_and_m_t":"The additional spectrum emission requirements to be applied by the UE on this uplink. If both additionalSpectrumEmission (without suffix) and additionalSpectrumEmission-v1760 are absent, the UE uses value 0 for the additionalSpectrumEmission (see TS 38.101-1 [15], tables 6.2.3.1-1A, 6.2A.3.1.1-2 and 6.2A.3.1.2-2, TS 38.101-2 [39], tables 6.2.3.1-2 and 6.2A.3.1-2, and TS 38.101-5 [75], table 6.2.3.1-1A). Network configures the same value in additionalSpectrumEmission for all uplink carrier(s) of the same band with UL configured and if signalled, the same vaue in additionalSpectrumEmission-v1760 for all uplink carrier(s) of the same band with UL configured, except for additionalSpectrumEmission value corresponding to NS_55/NS_57. If NS_55/NS_57 (see TS 38.101-1 [15], table 6.2.3.1-1) is applicable for at least one uplink carrier, the network may configure either NS_55/NS_57 or NS_01 for these uplink carriers, and NS_01 for the remaining uplink carrier(s) of band n77. The additionalSpectrumEmission is applicable for all uplink carriers of the same band with UL configured.","paragraph_zero_based":18767}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["1315a69ce8eb3085d13aaa289d00f4f46812f1bbffc84cafa9d50d65cafd4c57","94132d2c4e788bed1bc027eee2ecce0e87aba60cfdebae85e32761de33bdc493","2e13a10f6ace3791e339d13ab4de8d2fa8dec0364d4fd7586222feb761b15338","63fa6756b4eb70fe1f249a3e82072a8ab93999ee442a2ad00982f8929d53f352","0682ba90c94d9c461050284c40fc5f6e825bca892f1433dfd9970053951b311f","069e4b527109db95c0d5e77214df22909fde0631236fa7c08e6d706865efb9f2","fabbdebf34047f658aad23cec20ac20167739b540d88038ee6406d1c1b2403ae","ad5a7df87a1152b78631297e0f3f9482ef33b19360ecb87538daf73185e0e539","f7d4ca551cf6943f89efd5e01665a0f1590550e3f1dd9b830ebb0b1a304768d2","11b7b8b8639d1c24c4549b5da364e4a32bbec5b5f9773cdf83ce431f4bd4d846","c6f0288dbeed792565c61f1d50304a1a0ce750ca33cb54dca49eb0f4d682c48f","e67784d7d1776ce698cc77404fcf42b793ba7f80013ea1a2914bb0089be0624c","ed35e84bbe9dace210ce3ac11c84e362514ea514970a2a20ed1a7e2e280e8a0e","9543f4786abe287a27ac403dbbb92cfaee249ee07141744e709ed21d402c936c","a7d51ba8583bfd80fba85a520197c3f5e62db66deeca994c537681d9ec0e66d0","016e10543b185a67cf83f347e55c200ed470c7fe4bc9e1514136d376a133ea78","a7a0287617b2981dc9af50a1ed7b4532b3bf773cc9954953e6f60b8af85d6dd7","8d25e904b6b2c273a8cc0839b250cfb3fbe25f7c01813523b619f6c3b99ab48e","e145b2b4817c1a0698cfabff9e10d1bb2a6475a5c1250ac83de6eae81ce27bb7","a984428480a4dc50e1359f976bb120ae2ff2b0e6ce3496656ffb4219747d5955","2f967dc9349fb0d596cd5e5f2ab6fec119a50298f6eaf294f368884382229291","6a5431fdb9e28b8ee35f57a2b339de585564bcdc8064a26acd70625684c353bf","174f339f95752888740983f921a4d03cdb32dcc28d964bb10924d81f3cccea76","c9ed4843176e0fa9169a90fb32e0eb221552c14a8be7826316c4ca0d447f55ab"],"paragraph_range_zero_based":[18744,18767],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p18744"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"additionalSpectrumEmissionAerial","paragraph_zero_based":18768},{"literal_text_all_w_t_and_m_t":"The additional spectrum emission requirements to be applied by the aerial UE on this uplink (see TS 38.101-1 [15], tables TBD, TS 38.101-2 [39], tables TBD, and TS 38.101-5 [75], table TBD). If the field is absent, the aerial UE uses value indicated by the field additionalSpectrumEmission/ additionalSpectrumEmission-v1760.","paragraph_zero_based":18769},{"literal_text_all_w_t_and_m_t":"frequencyBandList","paragraph_zero_based":18770},{"literal_text_all_w_t_and_m_t":"List containing only one frequency band to which this carrier(s) belongs. Multiple values are not supported.","paragraph_zero_based":18771},{"literal_text_all_w_t_and_m_t":"frequencyShift7p5khz","paragraph_zero_based":18772},{"literal_text_all_w_t_and_m_t":"Enable the NR UL transmission with a 7.5 kHz shift to the LTE raster. If the field is absent, the frequency shift is disabled.","paragraph_zero_based":18773},{"literal_text_all_w_t_and_m_t":"p-Max","paragraph_zero_based":18774},{"literal_text_all_w_t_and_m_t":"Maximum transmit power allowed in this serving cell. The maximum transmit power that the UE may use on this serving cell may be additionally limited by p-NR-FR1 (configured for the cell group) and by p-UE-FR1 (configured total for all serving cells operating on FR1). If absent, the UE applies the maximum power according to TS 38.101-1 [15] in case of an FR1 cell, TS 38.101-2 [39] in case of an FR2 cell or TS 38.101-5 [75] in case of an NTN cell. In this release of the specification, if p-Max is present on a carrier frequency in FR2, the UE shall ignore the field and applies the maximum power according to TS 38.101-2 [39]. Value in dBm. This field is ignored by IAB-MT, the IAB-MT applies output power and emissions requirements, as specified in TS 38.174 [63].","paragraph_zero_based":18775},{"literal_text_all_w_t_and_m_t":"scs-SpecificCarrierList","paragraph_zero_based":18776},{"literal_text_all_w_t_and_m_t":"A set of carriers for different subcarrier spacings (numerologies). Defined in relation to Point A. The network configures a scs-SpecificCarrier at least for each numerology (SCS) that is used e.g. in a BWP (see TS 38.211 [16], clause 5.3).","paragraph_zero_based":18777},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18778},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":18779},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":18780},{"literal_text_all_w_t_and_m_t":"FDD-OrSUL","paragraph_zero_based":18781},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if this FrequencyInfoUL is for the paired UL for a DL (defined in a FrequencyInfoDL) or if this FrequencyInfoUL is for a supplementary uplink (SUL). It is absent, Need R, otherwise (if this FrequencyInfoUL is for an unpaired UL (TDD).","paragraph_zero_based":18782},{"literal_text_all_w_t_and_m_t":"FDD-TDD-OrSUL-Optional","paragraph_zero_based":18783},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if this FrequencyInfoUL is for the paired UL for a DL (defined in a FrequencyInfoDL), or if this FrequencyInfoUL is for an unpaired UL (TDD) in certain bands (as defined in clause 5.4.2.1 of TS 38.101-1 and in clause 5.4.2.1 of TS 38.104 [12]), or if this FrequencyInfoUL is for a supplementary uplink (SUL). It is absent, Need R, otherwise.","paragraph_zero_based":18784},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18785},{"literal_text_all_w_t_and_m_t":"–FrequencyInfoUL-SIB","paragraph_zero_based":18786},{"literal_text_all_w_t_and_m_t":"The IE FrequencyInfoUL-SIB provides basic parameters of an uplink carrier and transmission thereon.","paragraph_zero_based":18787},{"literal_text_all_w_t_and_m_t":"FrequencyInfoUL-SIB information element","paragraph_zero_based":18788},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18789},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQUENCYINFOUL-SIB-START","paragraph_zero_based":18790},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18791}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["db3bcd2577aa87a6889e1fe10e94a137f04cbfb61414f71fbb485864d0ee0997","f89c42851b6c2b0bfda0bf8b13f7cac162725ed5216d4536e0718c84a88e6b25","37d38ccfa151e8889fc360a81bbd28cc105ef6f5c1413b830791aa64c4ac5490","718c0eddf0df6deedeefb841d04488cc4b4faf71a7d75f2c8dbb8dd7cefa3c53","2845daaef0d6585ce04b8b9e451cdd25a68a3ecb4c9a8ce8bc81d81be999afb2","05258487e3c5752d01800adc195ce1b869698da215180429c38adc18dd084eb1","4418082be1459b426f0dc621da3934291074f6c40b87fe2c5be194064950a571","796d4390a0c99e2492f19ffaadbe4b252720026c7c80261800a309b6526b8857","989ea61dbcddaa22ee9b5d0028cb6f58bf2768d5eada2db65e7450416e45c095","6ff4adc8bd0b1cf6b15676d8034f9438f97c7a590c0ea3c98c447cd829a3a791","5cff784156abb5ba7a50a3fe08b9e204bd9a01631122b765764a7ffff82c5696","c787836caf16fb37a10f47d709b5adefe966337271fc23ffe8a4f62bd1825d9e","5d18c9a7c02d9260115454388d8fd2e448a0b750882994e653e027b8a994f16a","6191acb9a4861b255c539373fed4b568c8a220d9aa97e3e2a9d0475317cbe2bc","eb305b18c9e71c12a3b74e2a988d702ed99388eb9ae22d212083c1da3e0497b2","2c36f409bf30157a4eaff1e59d4556511868b316d4570c7e3c17f3618da10fc5","21ea88e64ad43db8e82b74efde6936b6c888d4eff76e0fe5bb15c6dd7cd8eb93","9c7bddb482f5a6ad79c1fde6d468fca09697aa5d211f8a19785c6244562ec67d","b5d10da640660c7836f5ca4e6d6b6e92deaed6020560cc97623bb727ec8a148c","d1ae18c1f857e1804d3f9dc7bd1a5e9914c1ef6052795cdef20e36ca6ca6b5fd","724bc95034f626ea74801368789f351c1ba10d489fd9a8be5a6c3d4b880d805f","5b5584ad0b47284a4947e64e0e3cfc77d270a7cd48a8e5cddd1349be054c7a73","9ebd92b12b26f7c13eaa4b298719be23753127df9fbe7e6b497a17a2c502ca3a","5850f68b7be4735abaa1c38e3b724a056e574954a821573a2d05b56144aea197"],"paragraph_range_zero_based":[18768,18791],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p18768"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"FrequencyInfoUL-SIB ::=             SEQUENCE {","paragraph_zero_based":18792},{"literal_text_all_w_t_and_m_t":"    frequencyBandList                   MultiFrequencyBandListNR-SIB                            OPTIONAL,   -- Cond FDD-OrSUL","paragraph_zero_based":18793},{"literal_text_all_w_t_and_m_t":"    absoluteFrequencyPointA             ARFCN-ValueNR                                           OPTIONAL,   -- Cond FDD-OrSUL","paragraph_zero_based":18794},{"literal_text_all_w_t_and_m_t":"    scs-SpecificCarrierList             SEQUENCE (SIZE (1..maxSCSs)) OF SCS-SpecificCarrier,","paragraph_zero_based":18795},{"literal_text_all_w_t_and_m_t":"    p-Max                               P-Max                                                   OPTIONAL,   -- Need S","paragraph_zero_based":18796},{"literal_text_all_w_t_and_m_t":"    frequencyShift7p5khz                ENUMERATED {true}                                       OPTIONAL,   -- Cond FDD-TDD-OrSUL-Optional","paragraph_zero_based":18797},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":18798},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":18799},{"literal_text_all_w_t_and_m_t":"    frequencyBandListAerial-r18         MultiFrequencyBandListNR-Aerial-SIB-r18                 OPTIONAL    -- Need S","paragraph_zero_based":18800},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":18801},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18802},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18803},{"literal_text_all_w_t_and_m_t":"FrequencyInfoUL-SIB-v1760 ::=       SEQUENCE {","paragraph_zero_based":18804},{"literal_text_all_w_t_and_m_t":"    frequencyBandList-v1760             MultiFrequencyBandListNR-SIB-v1760","paragraph_zero_based":18805},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18806},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18807},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQUENCYINFOUL-SIB-STOP","paragraph_zero_based":18808},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18809},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18810},{"literal_text_all_w_t_and_m_t":"FrequencyInfoUL-SIB field descriptions","paragraph_zero_based":18811},{"literal_text_all_w_t_and_m_t":"absoluteFrequencyPointA","paragraph_zero_based":18812},{"literal_text_all_w_t_and_m_t":"Absolute frequency of the reference resource block (Common RB 0). Its lowest subcarrier is also known as Point A. Note that the lower edge of the actual carrier is not defined by this field but rather in the scs-SpecificCarrierList (see TS 38.211 [16], clause 4.4.4.2).","paragraph_zero_based":18813},{"literal_text_all_w_t_and_m_t":"frequencyBandList","paragraph_zero_based":18814},{"literal_text_all_w_t_and_m_t":"Provides the frequency band indicator and a list of additionalPmax and additionalSpectrumEmission values as defined in TS 38.101-1 [15], table 6.2.3.1-1, TS 38.101-2 [39], table 6.2.3.1-2, and TS 38.101-5 [75], table 6.2.3.1-1. The UE shall apply the first listed band which it supports in the frequencyBandList field. If frequencyBandList-v1760 is present, it shall contain the same number of entries, listed in the same order as in frequencyBandList (without suffix).","paragraph_zero_based":18815}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["9b9151df7b22771274e7a88ba238c9124a55e2f1c596cfc382afa46511e94912","f243963fe462ba3ba28e58fffbeb8e1d1d1e2a23d993393e082a4e8ac87226d6","617b0a471751191aeb2b0855bc03a2434239e980971389756333a911e5579f56","4f76a55fbe0181da2b8c8dee06e67c9e8a644b267488b26f477e7844aa34b872","22cf30120cb9d3da121dd1b92d672c3d2554f9dd7a321713568b8f8e91ab71c3","0dc84edce78714c220ca96d241aa55adbfe6f07814fb3769fadad17f44821e26","cad9fe3b3273bb2c07f4adf729beea0cba09ac4c72ae539f67b61d94a42777ed","74c66a66264822f2265a4d6d3f2b1d4b5bf22ebf87df52ea46ab577673d46ce8","db8cf7131d972446be0c1e2c2ac2b8ad8fb0297aa5d3d9bf2156d5830da07330","9ee95f5fd14e385bcd0cb9c10191e2c2654f61871e317e666e50a11d163d408f","80d9af004d042b9ee39dd4da67dc2520d857fdf6c088f70b6c3973e04a514790","0dd7f8b798a5bfd25d7ff7bbd06328560cca52ca5619eb3960223410034224f6","6285d29d1cbe846ec1a40622189ef67de6f19973715e0189b31cf08020437139","fba80e07f52a0c0ecffb57a15de58191f43ba637822df66f9a7dee57b7926362","9db0cb2e081366b52bb7f5a92c56e90706492031a2c1f747726a15e441203dd8","841e585a957610612031958205b9b9a699d33c89e85b80f86db8428bdb2c33ff","3d8edce200f4b54afe697c194157a1f123980ad36aba3cbbc02720a4f65fd95d","bcc8cab4f64d94270712d431ad91f1f75d9234a255b74b11475439cd9a697d29","5433ee610e9b609742d72cf5140a3b4f521d86501394f114a32171362a91e959","4006ed167caa0628c8c442f29aaf5195788fbea41d1527c589992df068ace2fa","f60f9554ee12c21407ed2d7419c01b74969fa68b95c892e40fe31cbc3b7a6d2e","71fb6e69588773a8224912e6bc1f77276cd7624e86bb56634469c3c769ef9c62","e58b66f849912312ba83e4defd981314e40b0a689f8544af27f6ffaa3601814a","9b6875e00f97d05fc3e843acccd12a7209cae5197c3991d909cda411a0f03d31"],"paragraph_range_zero_based":[18792,18815],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p18792"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"frequencyBandListAerial","paragraph_zero_based":18816},{"literal_text_all_w_t_and_m_t":"Provides the frequency band indicator and a list of additionalPmax and additionalSpectrumEmission values for aerial UE as defined in TS 38.101-1 [15], table TBD, TS 38.101-2 [39], table TBD, and TS 38.101-5 [75], table TBD. If the field is present, the aerial UE shall apply the first listed band which it supports in the frequencyBandListAerial field. If the field is absent, frequencyBandList applies.","paragraph_zero_based":18817},{"literal_text_all_w_t_and_m_t":"frequencyShift7p5khz","paragraph_zero_based":18818},{"literal_text_all_w_t_and_m_t":"Enable the NR UL transmission with a 7.5 kHz shift to the LTE raster. If the field is absent, the frequency shift is disabled.","paragraph_zero_based":18819},{"literal_text_all_w_t_and_m_t":"p-Max","paragraph_zero_based":18820},{"literal_text_all_w_t_and_m_t":"Value in dBm applicable for the cell. If absent the UE applies the maximum power according to TS 38.101-1 [15] in case of an FR1 cell, TS 38.101-2 [39] in case of an FR2 cell or TS 38.101-5 [75] in case of an NTN cell. In this release of the specification, if p-Max is present on a carrier frequency in FR2, the UE shall ignore the field and applies the maximum power according to TS 38.101-2 [39]. This field is ignored by IAB-MT, the IAB-MT applies output power and emissions requirements, as specified in TS 38.174 [63].","paragraph_zero_based":18821},{"literal_text_all_w_t_and_m_t":"scs-SpecificCarrierList","paragraph_zero_based":18822},{"literal_text_all_w_t_and_m_t":"A set of carriers for different subcarrier spacings (numerologies). Defined in relation to Point A (see TS 38.211 [16], clause 5.3). The network configures this for all SCSs that are used in UL BWPs configured in this serving cell.","paragraph_zero_based":18823},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18824},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":18825},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":18826},{"literal_text_all_w_t_and_m_t":"FDD-OrSUL","paragraph_zero_based":18827},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if this FrequencyInfoUL-SIB is for the paired UL for a DL (defined in a FrequencyInfoDL-SIB) or if this FrequencyInfoUL-SIB is for a supplementary uplink (SUL). It is absent otherwise (if this FrequencyInfoUL-SIB is for an unpaired UL (TDD).","paragraph_zero_based":18828},{"literal_text_all_w_t_and_m_t":"FDD-TDD-OrSUL-Optional","paragraph_zero_based":18829},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if this FrequencyInfoUL-SIB is for the paired UL for a DL (defined in a FrequencyInfoDL-SIB), or if this FrequencyInfoUL-SIB is for an unpaired UL (TDD) in certain bands (as defined in clause 5.4.2.1 of TS 38.101-1 and in clause 5.4.2.1 of TS 38.104 [12]), or if this FrequencyInfoUL-SIB is for a supplementary uplink (SUL). It is absent otherwise.","paragraph_zero_based":18830},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18831},{"literal_text_all_w_t_and_m_t":"–GapPriority","paragraph_zero_based":18832},{"literal_text_all_w_t_and_m_t":"The IE GapPriority is used to identify the priority of a gap configuration.","paragraph_zero_based":18833},{"literal_text_all_w_t_and_m_t":"GapPriority information element","paragraph_zero_based":18834},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18835},{"literal_text_all_w_t_and_m_t":"-- TAG-GAPPRIORITY-START","paragraph_zero_based":18836},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18837},{"literal_text_all_w_t_and_m_t":"GapPriority-r17 ::=                       INTEGER (1..maxNrOfGapPri-r17)","paragraph_zero_based":18838},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18839}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["09669f4b26c2c0c8b782b3bc9ec9743badbf662e8ab961bfee6edf841f329c03","b4cc29bdd28318b415cad7884d64e349582ae0806538ceb88201c07edd956354","6d7b51fa20ebba6670e1b2b2b446ad3d4add7e9294700c1a15cbe16f0ce2285f","e73e65b776824ca13ef6a89053d833d8d51654f31b9985648d70e58dd08197c4","198a576e07e282047df19c293e36225cfa234bba215517792b9b8fa9d937baea","ff4454a616ec03eade2d5840554bffd06ef03aa72bf6eb21ee0e6f5e5e2188b4","f1cfb78c60dbc349ea25e5e3ddbbcfbe5aeaab74a35e89165a0ac11059064489","0d4befb04b077a8958163e1226f39820d311388020a06e856534d4dc0b9b93ba","99ccd3fac59ce8c47b181bfbf4d46f23b5199ba37b2b7743025eac6f642caed6","17de99f588a3613a10dbda28c8133142ff070cdce3f3cf1306e9ec59ecd0dab3","21ca4b80c2e773f04938da31085afcf4c0c99d7d11afce9fbdd343ba575f6ab3","8b4dd01f0499ccfe189919e334dfd940c046470df2771674621a1e0d8246ac64","bd2688f00f92b64c3159b682a135b92dd6a40614df75849a07ef444eb4425da9","bfa3f6e7ec95d50e09a38f1e8803af26c69b3af83991cc23bb43b62d2931bd61","80cc0e73a0754544bdc7b366c54d915af327f0492af4bf6f35c893852c0cf4c0","5a36fe9b313c425945046f24ae278ccf8267c7c340e2fa4e33de4f8b146ca283","f54f7cf175bada974b0be33e01c2ae88894156f0b6a6d220dfc247468725d8c7","50a75c1307e55503873f63c8e4f63a6b3dd70f10bb4cdf847c337f7b7e9efd22","3126f6bd941b24d9286908eb434cb73cf1263a6ac4ac7905cb2bf708c4d798e9","db672ec3c80cd5c373e102ef16c2b3065c9bb4bbfda8b1178a0cea5c11d08535","a6a8b3b17ad022096a21707427b19d9d549949b808346459749d4533ad94cca4","6b85f8f26a97193c37f48ba854ddfde2669ec33022478083848808df5549b7c9","c0a425684bded26d8d07adedaa06035c5e2e55a6151b0a595b5d71a59bf087d4","d790e10b43f1b51e0eb9eb3596ec3e7a8f0f502476e679d894d8a54e7a9d2e35"],"paragraph_ran