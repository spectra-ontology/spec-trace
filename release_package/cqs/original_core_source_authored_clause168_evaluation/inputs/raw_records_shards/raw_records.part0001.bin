{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        g-CS-RNTI                              RNTI-Value","paragraph_zero_based":19032},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":19033},{"literal_text_all_w_t_and_m_t":"    drx-ConfigPTM-r17                      SetupRelease { DRX-ConfigPTM-r17 }                          OPTIONAL,   -- Need M","paragraph_zero_based":19034},{"literal_text_all_w_t_and_m_t":"    harq-FeedbackEnablerMulticast-r17      ENUMERATED {dci-enabler, enabled}                           OPTIONAL,   -- Need S","paragraph_zero_based":19035},{"literal_text_all_w_t_and_m_t":"    harq-FeedbackOptionMulticast-r17       ENUMERATED {ack-nack, nack-only}                            OPTIONAL,   -- Cond HARQFeedback","paragraph_zero_based":19036},{"literal_text_all_w_t_and_m_t":"    pdsch-AggregationFactor-r17            ENUMERATED {n2, n4, n8}                                     OPTIONAL    -- Cond G-RNTI","paragraph_zero_based":19037},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":19038},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19039},{"literal_text_all_w_t_and_m_t":"MBS-RNTI-SpecificConfigId-r17 ::= INTEGER (0..maxG-RNTI-1-r17)","paragraph_zero_based":19040},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19041},{"literal_text_all_w_t_and_m_t":"-- TAG-MAC-CELLGROUPCONFIG-STOP","paragraph_zero_based":19042},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":19043},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19044},{"literal_text_all_w_t_and_m_t":"MAC-CellGroupConfig field descriptions","paragraph_zero_based":19045},{"literal_text_all_w_t_and_m_t":"allowCSI-SRS-Tx-MulticastDRX-Active","paragraph_zero_based":19046},{"literal_text_all_w_t_and_m_t":"Used to control the CSI/SRS transmission during MBS multicast DRX ActiveTime, see TS 38.321 [3].","paragraph_zero_based":19047},{"literal_text_all_w_t_and_m_t":"csi-Mask","paragraph_zero_based":19048},{"literal_text_all_w_t_and_m_t":"If set to true, the UE limits CSI reports to the on-duration period of the DRX cycle, see TS 38.321 [3].","paragraph_zero_based":19049},{"literal_text_all_w_t_and_m_t":"dataInactivityTimer","paragraph_zero_based":19050},{"literal_text_all_w_t_and_m_t":"Releases the RRC connection upon data inactivity as specified in clause 5.3.8.5 and in TS 38.321 [3]. Value s1 corresponds to 1 second, value s2 corresponds to 2 seconds, and so on.","paragraph_zero_based":19051},{"literal_text_all_w_t_and_m_t":"drx-Config, drx-ConfigExt","paragraph_zero_based":19052},{"literal_text_all_w_t_and_m_t":"Used to configure DRX as specified in TS 38.321 [3]. Network only configures drx-ConfigExt when drx-Config is configured.","paragraph_zero_based":19053},{"literal_text_all_w_t_and_m_t":"drx-ConfigSecondaryGroup","paragraph_zero_based":19054},{"literal_text_all_w_t_and_m_t":"Used to configure DRX related parameters for the second DRX group as specified in TS 38.321 [3]. The network does not configure secondary DRX group with DCP simultaneously nor secondary DRX group with a dormant BWP simultaneously.","paragraph_zero_based":19055}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["fe76f8359c5d999a7c5d6eacb37820a688192223aec8ca89d5eb187843cc5370","e8c2987409cc2ca32291cd51524b057636ec66649b8f30c2d2ac799354820d01","885d24c918596a15baaf500e13c9ddc6f207dd6dad171ee76b1136b8c0c1c519","fb8b3ccc85d77fe5d8f528bebb974149477cc7f23e0fcc38b3559c66b9e31051","7955214fc9abfe3f58bc014bc72061e86942dba4058cfdd7cf2e3e90e7b9ed92","2cf07f194e9fe2839ac478c6596f26dc6d4b2a4c5757f58e79f1a92284dd3571","9188a343d3fd7a45a1e3f541e866f56476cf27df0cb45d707892d7526df9ba0f","1d08e03c95435c731539808a9409b4640bc9e7567080f662b44c0e589e6ba093","7298212682b21802b9fccd5a80bee6a0f2057a65b5db1d5ef968c76a16538d23","fd825a8a7fd4c35c88e95b430ca72ca0101a358019865661883dde66b300c5c0","3dcd4b6de2014b3b46902af94228b9f63ebcb2559a49bf8049a4246adc3c037f","e2d8fa5608868d7473cd30e8b0672e46203bc3425d5bca96892dbab4d944cfb9","08b3609034dc20dfe2eb9a9fc8944dd7f428c50f0a5c3ffc1c8a7eaa79c5caeb","d0cf5c0209973247fbe5fdd8f9be2a44a9cf5d92518abe0513bd6e88a4930646","e9cde87dd890345b799d4831375cd6bb7b82856ddd1a670f614e4f4af7b52d8c","02bd5cd997625ead6a5ed0f9f323eb9252d4aab066426b263f44a127fe8a1f6d","99a46019a10e7b48836b11ce1d15f1501bf5f6e6f26833a08cc70c8cb909c6d2","7ee98b40a14fbd9b07f1215cd4f510fb77278fcf10bec85d826d7e85f30a6b0a","15d11600e71a8014585f4aa3a0814cb6f5ec4544a46fc1c7988838fbee1b9fdb","441c06fc7acf4f2ca15a1bd7a18d406b5ca2f35f6faf09bd66b541444886ca39","cd6423961d3be5bc6aea9d8f6f18aaac5d44db9bb9b18663095cad1208b219f5","776a5645ad401d100f563fda9b97d6d6cdf8bc5455f8d91d7a345798d351f188","01a77ddb9ab7bdca891710415105a3d9ba0e581d2df6eeb1020a2bb37fee937d","d974f285a0faa465110f8807ceb9dd1ac947193a7f87212c07005ee3650c9c29"],"paragraph_range_zero_based":[19032,19055],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p19032"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"drx-ConfigSL","paragraph_zero_based":19056},{"literal_text_all_w_t_and_m_t":"Used to configure additional DRX parameters for the UE performing sidelink operation with resource allocation mode 1, as specified in TS 38.321 [3]. Network only configures this field if sl-ScheduledConfig is configured and drx-Config is configured.","paragraph_zero_based":19057},{"literal_text_all_w_t_and_m_t":"drx-LastTransmissionUL","paragraph_zero_based":19058},{"literal_text_all_w_t_and_m_t":"If this field is present, the start of the drx-HARQ-RTT-TimerUL is after the last transmission within a bundle, see TS 38.321 [3].","paragraph_zero_based":19059},{"literal_text_all_w_t_and_m_t":"g-RNTI-ConfigToAddModList","paragraph_zero_based":19060},{"literal_text_all_w_t_and_m_t":"List of G-RNTI configurations to add or modify. Up to 8 G-RNTIs can be configured in total in this release based on the UE capability.","paragraph_zero_based":19061},{"literal_text_all_w_t_and_m_t":"g-RNTI-ConfigToReleaseList","paragraph_zero_based":19062},{"literal_text_all_w_t_and_m_t":"List of G-RNTI configurations to release.","paragraph_zero_based":19063},{"literal_text_all_w_t_and_m_t":"g-CS-RNTI-ConfigToAddModList","paragraph_zero_based":19064},{"literal_text_all_w_t_and_m_t":"List of G-CS-RNTI configurations to add or modify. Up to 8 G-CS-RNTIs can be configured in total in this release based on the UE capability.","paragraph_zero_based":19065},{"literal_text_all_w_t_and_m_t":"g-CS-RNTI-ConfigToReleaseList","paragraph_zero_based":19066},{"literal_text_all_w_t_and_m_t":"List of G-CS-RNTI configurations to release.","paragraph_zero_based":19067},{"literal_text_all_w_t_and_m_t":"intraCG-Prioritization","paragraph_zero_based":19068},{"literal_text_all_w_t_and_m_t":"Used to enable HARQ process ID selection based on LCH-priority for one CG as specified in TS 38.321 [3].","paragraph_zero_based":19069},{"literal_text_all_w_t_and_m_t":"lch-BasedPrioritization","paragraph_zero_based":19070},{"literal_text_all_w_t_and_m_t":"If this field is present, the corresponding MAC entity of the UE is configured with prioritization between overlapping grants and between scheduling request and overlapping grants based on LCH priority, see TS 38.321 [3]. The network does not configure lch-BasedPrioritization with enhancedSkipUplinkTxDynamic simultaneously nor lch-BasedPrioritization with enhancedSkipUplinkTxConfigured simultaneously.","paragraph_zero_based":19071},{"literal_text_all_w_t_and_m_t":"posMG-Request","paragraph_zero_based":19072},{"literal_text_all_w_t_and_m_t":"Indicates whether UE is configured to send UL MAC CE for Positioning Measurement Gap Activation/Deactivation Request, as specified in TS 38.321 [3].","paragraph_zero_based":19073},{"literal_text_all_w_t_and_m_t":"schedulingRequestID-BFR-SCell","paragraph_zero_based":19074},{"literal_text_all_w_t_and_m_t":"Indicates the scheduling request configuration applicable for BFR on SCell, as specified in TS 38.321 [3].","paragraph_zero_based":19075},{"literal_text_all_w_t_and_m_t":"schedulingRequestID-BFR","paragraph_zero_based":19076},{"literal_text_all_w_t_and_m_t":"Indicates the scheduling request configuration (SchedulingRequestConfig) that the UE shall use upon detecting a beam failure on the detection resources configured in failureDetectionSet1 of a serving cell while beam failure is not detected on resources configured in failureDetectionSet2 of the same serving cell.","paragraph_zero_based":19077},{"literal_text_all_w_t_and_m_t":"schedulingRequestID-BFR2","paragraph_zero_based":19078},{"literal_text_all_w_t_and_m_t":"Indicates the scheduling request configuration (SchedulingRequestConfig) that the UE shall use upon detecting a beam failure on the detection resources configured in failureDetectionSet2 of a serving cell while beam failure is not detected on resources configured in failureDetectionSet1 of the same serving cell.","paragraph_zero_based":19079}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["890c84b5d82bd34715204feeb73aab2e36e41734b86321b1a484df9c0b3eaa84","ddcf3b26a5115c7312a688f4f6faa71a22c6daa00e1f0545ecd411aee171faf4","0e455421c250b2ce77608d6fb0c9f27f3d768a91fb9a9a5665b8097fe5c75192","19696d391f97e0a72dc4d42ce808c4447b2a68b8ddc06cdc6ad2fb616d0b0e39","e665b18aeb532424b18ea7adddfd1eeb5dbb16d6990c4a2eb87912df17725803","6d77873a9250ab64102750896509effc0526994bea4ac208b85a5a1f39f03b70","e8657fda9e41af9915ea0673f99367f8f77299fbac5d24a11dc8c704e8788106","63360edaa72f642356d533761fdef22ccd46a545bcfc5ab8eb4dfa267ab0d361","fb2ef222b47c60c8ca635726fd047d01babc80690a9be2f89e24efc717bd6393","e7b12ec59af4bdc9ec731462517d9a266dde6e4d1c5f0c3d81969242547e8655","c59aadfcbdfef46dacedc4941f0335fdb50a1c17754bdf3bee9e36e70791e772","027b093395da2abfbdcd26a8ec631b05a6dba705e7ea8b2ab014dcbd5919a7b5","efc38bc17c776b652a3cbc86b91de7c801ef21f69a38e074c8e9720b7ca96f64","e6278284e5e99f91ff698b76d044ca2a287ff3c819d97612e673d721c7aa9ddb","2f5fadc719e7de5befa05c31a560dcdbbd49bd637e5a926ae33f771e110a9859","e5c76e1e0736c275e0913291845af18b1814521d468e96e893071c6e88e5b26a","367fdf38bde9af60221a57dcd9abcacff79e09a27ed7a71b9fd01c1c04fda15c","e3f1af58cb585b39f5fda8780beb9a4671606c51fdf3b00a084cd9c28e6a0e2a","464e468947fb20c162e117ab42ddf4bbf6a646bc3d6bfdb3a3c61bc554fc33eb","b297218f5de99c5288c655d5943ed3925ff79067e6334279302d8f40f704109a","81bf4cefd0abe741a9bd5a946987f2f1849a5bda89d2608a00da0e4da6771790","c998953eaaa90a842b7254c5c0cb6a28e79bb4108ef29feae0cbe58d66c55ea9","81bc32354c5b5aeaf81fc5974b9573de12516f0d33d17957ed2ae598a82f4096","b75c3e02e6a762680e01a5ed51120a3a4833364fe1163b4da36319064edc80d3"],"paragraph_range_zero_based":[19056,19079],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p19056"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"schedulingRequestID-LBT-SCell","paragraph_zero_based":19080},{"literal_text_all_w_t_and_m_t":"Indicates the scheduling request configuration applicable for consistent uplink LBT recovery on SCell, as specified in TS 38.321 [3].","paragraph_zero_based":19081},{"literal_text_all_w_t_and_m_t":"schedulingRequestID-PosMG-Request","paragraph_zero_based":19082},{"literal_text_all_w_t_and_m_t":"Indicates the scheduling request configuration applicable for Positioning Measurement Gap Activation/Deactivation Request, as specified in TS 38.321 [3].","paragraph_zero_based":19083},{"literal_text_all_w_t_and_m_t":"skipUplinkTxDynamic, enhancedSkipUplinkTxDynamic, enhancedSkipUplinkTxConfigured","paragraph_zero_based":19084},{"literal_text_all_w_t_and_m_t":"If set to true, the UE skips UL transmissions as described in TS 38.321 [3]. If the UE is configured with enhancedSkipUplinkTxDynamic or enhancedSkipUplinkTxConfigured with value true, REPETITION_NUMBER (as specified in TS 38.321 [3], clause 5.4.2.1) of the corresponding PUSCH transmission of the uplink grant shall be equal to 1.","paragraph_zero_based":19085},{"literal_text_all_w_t_and_m_t":"tag-Config","paragraph_zero_based":19086},{"literal_text_all_w_t_and_m_t":"The field is used to configure parameters for a time-alignment group. The field is not present if any DAPS bearer is configured.","paragraph_zero_based":19087},{"literal_text_all_w_t_and_m_t":"usePreBSR","paragraph_zero_based":19088},{"literal_text_all_w_t_and_m_t":"If set to true, the MAC entity of the IAB-MT may use the Pre-emptive BSR, see TS 38.321 [3].","paragraph_zero_based":19089},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19090},{"literal_text_all_w_t_and_m_t":"MBS-RNTI-SpecificConfig field descriptions","paragraph_zero_based":19091},{"literal_text_all_w_t_and_m_t":"drx-ConfigPTM","paragraph_zero_based":19092},{"literal_text_all_w_t_and_m_t":"Used to configure DRX for PTM transmission as specified in TS 38.321 [3].","paragraph_zero_based":19093},{"literal_text_all_w_t_and_m_t":"g-CS-RNTI","paragraph_zero_based":19094},{"literal_text_all_w_t_and_m_t":"Used to scramble the SPS group-common PDSCH and activation/deactivation of SPS group-common PDSCH for one or more MBS multicast services.","paragraph_zero_based":19095},{"literal_text_all_w_t_and_m_t":"g-RNTI","paragraph_zero_based":19096},{"literal_text_all_w_t_and_m_t":"Used to scramble the scheduling and transmission of PTM for one or more MBS multicast services.","paragraph_zero_based":19097},{"literal_text_all_w_t_and_m_t":"groupCommon-RNTI","paragraph_zero_based":19098},{"literal_text_all_w_t_and_m_t":"Used to configure g-RNTI or g-CS-RNTI.","paragraph_zero_based":19099},{"literal_text_all_w_t_and_m_t":"harq-FeedbackEnablerMulticast","paragraph_zero_based":19100},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE shall provide HARQ feedback for MBS multicast. Value dci-enabler means that whether the UE shall provide HARQ feedback for MBS multicast is indicated by DCI as specified in TS 38.213 [13]. Value enabled means the UE shall always provide HARQ feedback for MBS multicast. When the field is absent, the UE behavior is specified in TS 38.213 [13].","paragraph_zero_based":19101},{"literal_text_all_w_t_and_m_t":"harq-FeedbackOptionMulticast","paragraph_zero_based":19102},{"literal_text_all_w_t_and_m_t":"Indicates the feedback mode for MBS multicast dynamically scheduled PDSCH or SPS PDSCH.","paragraph_zero_based":19103}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["2ad0b436284c474fa8e5c28f18124a9d2ad70a64095f407bbbee9e44d234653c","85ec589b9b076c4e21de44dae186c896977f9094101cb5e21075bb334649c13a","57b732f0808bfe054b7b2a63dd9363d38ee0ca13f8bbe231817141e05de840bc","e79a460bff90eba0477d7a117bd8d4e9dc8c1e221e97664101dbd8fb17f9039d","d5086c3443f5f2f8f1ac9efcb9c719e42188d7b5e7ea044a067c5ea63be1cd7d","b5f5b6440136cdd30629e25db25a01c32502eb0f8350366905a71f44f937334a","def5e5475ea3e678d0f2966dc413093c9e4569cb5607d59abbf37a0269d70a79","a35b70de77932422f18b56c05968f285814e3033e8d0690b0e60eb0966058e5e","a902906ababe5b55b505c1f80c67498abbcf9e7387f4ba64d1d0c4d475c90d0c","fa2b77f1cd7f0c508f90728049d3af61e846701a4e5903e96e2934e7186dac68","83f19a81e4fcf0b598dbc3bf254df90f1ca17a9632574f036772673ca332854c","a9c445c2d3acb4fcb3114239866630d19fc51f20ef5de40e6c35e96ceac37203","d5662a4f76e45ae68fa9eb0b40632fd5d5474b0f21235450e6fb3906e18f4bb4","e894f5715186637303f564d47599219b890ca560eb25ac4d522bd1d072298de6","58e0ffb3bac0291b33ce853724581ac40fa059c16e087770181f9d530c04802d","0ca0eb3face99ab74dff7756092b4e0ecfdd4319e8b3d60e9e94e5d028f9c7ae","8746812cdf96494bc3ccebb8a12ea042e7ebe415ba082addf39c1e44b35c4502","cf30e8781624295f0421d6c1abb8d593db2ea7527c69295052547c9c5e092f15","b35c1dd73762cdab3df709fc925e9003d80fd7841e0e3e4c4819eac9bb5b2220","ec9d4dfb531594d351fbe5af0ce0003b2274bd82c866261dc94c6214be70d0ec","3694e509345958a7ce338a4aff791ceb84d915bb60ff4020c59914c1daea56ba","567711cdd00e76f0abc36eeb7a08ad1cef4670041a784f9b2c96ee6784b61079","6170eb742b743e1ed4fb0aef9dc7454b65a8e382118e78b1d9e640aaa34a048a","1e101f9ec200dbb69965b58a86bd264167f46971e254679ba41d9d2ec951537c"],"paragraph_range_zero_based":[19080,19103],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p19080"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"mbs-RNTI-SpecificConfigId","paragraph_zero_based":19104},{"literal_text_all_w_t_and_m_t":"An identifier of the RNTI specific configuration for MBS multicast.","paragraph_zero_based":19105},{"literal_text_all_w_t_and_m_t":"pdsch-AggregationFactor","paragraph_zero_based":19106},{"literal_text_all_w_t_and_m_t":"Number of repetitions for dynamically scheduled MBS multicast data (see TS 38.214 [19], clause 5.1.2.1). When the field is absent and groupCommon-RNTI is set to g-RNTI, the UE applies the value 1.","paragraph_zero_based":19107},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19108},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":19109},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":19110},{"literal_text_all_w_t_and_m_t":"G-RNTI","paragraph_zero_based":19111},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need S, if groupCommon-RNTI is set to g-RNTI. The field is absent when groupCommon-RNTI is set to g-CS-RNTI.","paragraph_zero_based":19112},{"literal_text_all_w_t_and_m_t":"HARQFeedback","paragraph_zero_based":19113},{"literal_text_all_w_t_and_m_t":"The field is mandatory present when harq-FeedbackEnablerMulticast is present. It is absent otherwise. ","paragraph_zero_based":19114},{"literal_text_all_w_t_and_m_t":"MCG-Only","paragraph_zero_based":19115},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need M, for the MAC-CellGroupConfig of the MCG. It is absent otherwise.","paragraph_zero_based":19116},{"literal_text_all_w_t_and_m_t":"LCH-PrioWithReTxTimer","paragraph_zero_based":19117},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, if lch-BasedPrioritization-r16 is configured in this MAC entity and cg-RetransmissionTimer-r16 is configured for any configured grant configuration associated with this MAC entity. It is absent otherwise, Need R.","paragraph_zero_based":19118},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19119},{"literal_text_all_w_t_and_m_t":"–MeasConfig","paragraph_zero_based":19120},{"literal_text_all_w_t_and_m_t":"The IE MeasConfig specifies measurements to be performed by the UE, and covers intra-frequency, inter-frequency and inter-RAT mobility as well as configuration of measurement gaps.","paragraph_zero_based":19121},{"literal_text_all_w_t_and_m_t":"MeasConfig information element","paragraph_zero_based":19122},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":19123},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASCONFIG-START","paragraph_zero_based":19124},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19125},{"literal_text_all_w_t_and_m_t":"MeasConfig ::=                      SEQUENCE {","paragraph_zero_based":19126},{"literal_text_all_w_t_and_m_t":"    measObjectToRemoveList              MeasObjectToRemoveList                                              OPTIONAL,   -- Need N","paragraph_zero_based":19127}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["9173f0c67ee77af80ea9586ced72264206192ba2f80202bd7b0ce19f141e9368","356512aa8d0cf9fe4a1d0cb422d40eec185fe436118cd1913279a04b3377d1ed","499d165babca6fc6ae2214bf8f94758f225815218f86a0b1ba65380c062e0187","bbf0abb520c99aa0e5720d414062c826c9d9cc7128ee685fd97bacc28f9a168a","f300bd68c11dac0fcd4db276ec360a03656c5ccb82a06211a4b254ae7b914ff4","403c0c0d3144ef1ecec36e7277452e0dc9b33fa93ad225597b3616bcc199f655","f5e2520b3f911df4ac2d6e21a0dafe6d7eb58c6342eb606a5e7d27381bd12a78","409f7539abcfda01548a8e8