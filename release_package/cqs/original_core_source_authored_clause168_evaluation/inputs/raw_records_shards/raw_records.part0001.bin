{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Parameters which apply for prioritized 2-step random access type procedure to a given target cell (see TS 38.321 [3], clause 5.1.1).","paragraph_zero_based":25128},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25129},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":25130},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":25131},{"literal_text_all_w_t_and_m_t":"Mandatory","paragraph_zero_based":25132},{"literal_text_all_w_t_and_m_t":"The field is mandatory present.","paragraph_zero_based":25133},{"literal_text_all_w_t_and_m_t":"Occasions","paragraph_zero_based":25134},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need S, if the field occasions is present, otherwise it is absent.","paragraph_zero_based":25135},{"literal_text_all_w_t_and_m_t":"2StepCFRA","paragraph_zero_based":25136},{"literal_text_all_w_t_and_m_t":"The field is optionally present for the case of 2-step RA type contention free random access, Need S, otherwise it is absent.","paragraph_zero_based":25137},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25138},{"literal_text_all_w_t_and_m_t":"–RACH-ConfigGeneric","paragraph_zero_based":25139},{"literal_text_all_w_t_and_m_t":"The IE RACH-ConfigGeneric is used to specify the random-access parameters both for regular random access as well as for beam failure recovery.","paragraph_zero_based":25140},{"literal_text_all_w_t_and_m_t":"RACH-ConfigGeneric information element","paragraph_zero_based":25141},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25142},{"literal_text_all_w_t_and_m_t":"-- TAG-RACH-CONFIGGENERIC-START","paragraph_zero_based":25143},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25144},{"literal_text_all_w_t_and_m_t":"RACH-ConfigGeneric ::=              SEQUENCE {","paragraph_zero_based":25145},{"literal_text_all_w_t_and_m_t":"    prach-ConfigurationIndex            INTEGER (0..255),","paragraph_zero_based":25146},{"literal_text_all_w_t_and_m_t":"    msg1-FDM                            ENUMERATED {one, two, four, eight},","paragraph_zero_based":25147},{"literal_text_all_w_t_and_m_t":"    msg1-FrequencyStart                 INTEGER (0..maxNrofPhysicalResourceBlocks-1),","paragraph_zero_based":25148},{"literal_text_all_w_t_and_m_t":"    zeroCorrelationZoneConfig           INTEGER(0..15),","paragraph_zero_based":25149},{"literal_text_all_w_t_and_m_t":"    preambleReceivedTargetPower         INTEGER (-202..-60),","paragraph_zero_based":25150},{"literal_text_all_w_t_and_m_t":"    preambleTransMax                    ENUMERATED {n3, n4, n5, n6, n7, n8, n10, n20, n50, n100, n200},","paragraph_zero_based":25151}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["8ab4f25d38cf39b450eb9655ec4d6e241cdf1cf98841a7ca9a7e62965f329d76","ecd51ae88f88e330a4942a41b96f50afb706b56340cf268869bf7eb3835c3354","1b39e0a23a60c5ddaf5f1f4a004e763663753da779d791281502a6708a295c72","50595c1a5a0bce7e83aa7e21b3516689864a4bc0dec6886af14c7195953ec318","289379b8b2941e11bd54b971c85391611b2a4d28a2b498933e0990080f8e9620","cb4da57347dc12e9d048ea4bbeceb0b92bb2e8b1cf4ab96021502ddbc07370fa","f0a5f6ce802c6f035929029278623baed730c540da772f1e23cc591eec90059e","00006293cfba9dc7c383da0b2633f166d33c2a781a628bc644ba7c10e7e571c2","cc8b9ece7a0698dc678715d669c25b118ed70db98e92c9e8a04a53ffcc4e6031","9f1d05de9df95a01b19f3ce155c6e6a4c4d06a544924cf68d38086248926b05d","3a8787a10e468787db535d990ecd49b92cadb62761ef811a3d8ce76b8e997363","90e34b0859f7b03254ea