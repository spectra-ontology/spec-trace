{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    interFrequencyConfig-NoGap-r16      ENUMERATED {true}                                                   OPTIONAL    -- Need R","paragraph_zero_based":19392},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":19393},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":19394},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19395},{"literal_text_all_w_t_and_m_t":"MeasObjectToRemoveList ::=              SEQUENCE (SIZE (1..maxNrofObjectId)) OF MeasObjectId","paragraph_zero_based":19396},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19397},{"literal_text_all_w_t_and_m_t":"MeasIdToRemoveList ::=                  SEQUENCE (SIZE (1..maxNrofMeasId)) OF MeasId","paragraph_zero_based":19398},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19399},{"literal_text_all_w_t_and_m_t":"ReportConfigToRemoveList ::=            SEQUENCE (SIZE (1..maxReportConfigId)) OF ReportConfigId","paragraph_zero_based":19400},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19401},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASCONFIG-STOP","paragraph_zero_based":19402},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":19403},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19404},{"literal_text_all_w_t_and_m_t":"MeasConfig field descriptions","paragraph_zero_based":19405},{"literal_text_all_w_t_and_m_t":"interFrequencyConfig-NoGap-r16","paragraph_zero_based":19406},{"literal_text_all_w_t_and_m_t":"If the field is set to true, UE is configured to perform SSB based inter-frequency measurement without measurement gaps when the inter-frequency SSB is completely contained in the active DL BWP of the UE, as specified in TS 38.133 [14], clause 9.3. Otherwise, the SSB based inter-frequency measurement is performed within measurement gaps. In NR-DC, the field can only be configured in the measConfig associated with MCG, and when configured, it applies to all the inter-frequency measurements configured by MN and SN.","paragraph_zero_based":19407},{"literal_text_all_w_t_and_m_t":"measGapConfig","paragraph_zero_based":19408},{"literal_text_all_w_t_and_m_t":"Used to setup and release measurement gaps in NR.","paragraph_zero_based":19409},{"literal_text_all_w_t_and_m_t":"measIdToAddModList","paragraph_zero_based":19410},{"literal_text_all_w_t_and_m_t":"List of measurement identities to add and/or modify.","paragraph_zero_based":19411},{"literal_text_all_w_t_and_m_t":"measIdToRemoveList","paragraph_zero_based":19412},{"literal_text_all_w_t_and_m_t":"List of measurement identities to remove.","paragraph_zero_based":19413},{"literal_text_all_w_t_and_m_t":"measObjectToAddModList","paragraph_zero_based":19414},{"literal_text_all_w_t_and_m_t":"List of measurement objects to add and/or modify.","paragraph_zero_based":19415}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["35e3844544a53e8e33f90e7a8cba660f2cd93e6eeca2f22ea436f9150697f83c","6cae91da46c59986ea3503aa084db2db2e39e84685d1ba0e0e2eb657c3c4b71c","2b285ec846f383ebbef89036be876d0c4c7498497d5500473457b80eb204ad3c","489816f8e608e073327007b2fc0a6177e54bf8e8ea2512f7091f55cf452c1e47","b7bb6b692a35fcde60240657efba1f6149ce93dabe81c448941e01375db086c7","d7a4fd02e87d2276f1304f769c02b8e61f5d25a24a12b568cff16370db493305","01c5e3119a7203613687a20691f2bd930297f96fc09975bb9dd4737ad7a50a37","4e973af4f78069fa77c48d0f5f9c8f751c3766f188e6a3c76b26c1cb197032c5","9f16cfbf4b206ccfe0b2fff11539b5d1a6e06221effb02818317379fc047df8c","e116d41a7294e31299de2d2c7ca4e8bef038bad58a