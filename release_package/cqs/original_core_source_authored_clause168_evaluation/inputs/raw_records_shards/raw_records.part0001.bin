{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    dummy SEQUENCE (SIZE (1..maxNrofPUSCH-PathlossReferenceRSs-r16)) OF DummyPathlossReferenceRS-v1710          OPTIONAL  -- Need N","paragraph_zero_based":24144},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":24145},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":24146},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24147},{"literal_text_all_w_t_and_m_t":"P0-PUSCH-Set-r16 ::=                SEQUENCE {","paragraph_zero_based":24148},{"literal_text_all_w_t_and_m_t":"    p0-PUSCH-SetId-r16                  P0-PUSCH-SetId-r16,","paragraph_zero_based":24149},{"literal_text_all_w_t_and_m_t":"    p0-List-r16                         SEQUENCE (SIZE (1..maxNrofP0-PUSCH-Set-r16)) OF P0-PUSCH-r16            OPTIONAL, -- Need R","paragraph_zero_based":24150},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":24151},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":24152},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24153},{"literal_text_all_w_t_and_m_t":"P0-PUSCH-SetId-r16 ::=              INTEGER (0..maxNrofSRI-PUSCH-Mappings-1)","paragraph_zero_based":24154},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24155},{"literal_text_all_w_t_and_m_t":"P0-PUSCH-r16 ::=                    INTEGER (-16..15)","paragraph_zero_based":24156},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24157},{"literal_text_all_w_t_and_m_t":"-- TAG-PUSCH-POWERCONTROL-STOP","paragraph_zero_based":24158},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":24159},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24160},{"literal_text_all_w_t_and_m_t":"P0-PUSCH-AlphaSet field descriptions","paragraph_zero_based":24161},{"literal_text_all_w_t_and_m_t":"alpha","paragraph_zero_based":24162},{"literal_text_all_w_t_and_m_t":"alpha value for PUSCH with grant (except msg3) (see TS 38.213 [13], clause 7.1). When the field is absent the UE applies the value 1.","paragraph_zero_based":24163},{"literal_text_all_w_t_and_m_t":"p0","paragraph_zero_based":24164},{"literal_text_all_w_t_and_m_t":"P0 value for PUSCH with grant (except msg3) in steps of 1dB (see TS 38.213 [13], clause 7.1). When the field is absent the UE applies the value 0.","paragraph_zero_based":24165},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24166},{"literal_text_all_w_t_and_m_t":"P0-PUSCH-Set field descriptions","paragraph_zero_based":24167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["a76dc57cafe46f9cb5d0bc84cbd2d126c5b17e96d2e45e4306f40f18caa5c13e","1af16a75d1d223cc16ae2224b1127819e9b28127fa1d3f3db756b24ecc95add5","4c735a36b27c8792a85a50daa088d52720cd9b73742a30e3637398c854ee9d08","03fd4912f8cae7ed9eff3edc725c1ac21c4f91a66e7aa46d168c8461e4c8b477","b68db9f3f971e1f899a5f2fd5481cd1143d6539af9806328c1c1aa404e4e7dc1","fd898987ddab009c514f5223b312743deef8017e19c60a3554b8e9a65b415209","df2ab80ac8376accc4261c89f4d22e4379c343dac52e461453cac49397421350","67328ad8470c8b15806c8e76c10a3a8fcd4d23209e7490fd4d417cbf8e5fc940","9a8f779cd1085d932286ff3019c10ed582cc0a16eda9460b13c94f3bd94e7ca3","0505498846aeeba1ef5210d2f081d9db72b6f55ec4386ea5937fb606da49e4b3","237283e27f96035914e6a8a25b12466c5cee0c6d1fb0dd51ae885fb2729a9340","da0058de55c9e0e98fff1288162956c985502c4838ce229bb4f2f6710d2d7b74","f2ce97e5d5c36397add604800f98cdfdcc6e124c7bf5ab39e48d87c9ab565067","b52f55be4ec53c61a5f12461152bcadc00ed5da46488b169fa3da84fb8f1d39c","4e604964068db8827fa85afb9ac25971db7f6d8100c2042471b4316f2612877a","cdd94a5a0032fb83ec06dbd1a4feb60a05558fd763dfa4fcfa6c9cd522d04a76","7a665f5e6cae3cb11e86f236087a9d4f93993fc18013cd9945eb782fc41068a3","71ef40894da3c91136eec0724547e708215bda53b5ccc655e6fbe69b7604de97","2a6998ebd5d5e7d1fb46d87a2fe8cfaf0759216fbe9dd3ae4b1061bb50b4ca0d","7a397b5175d1af4b1ba32da0876a9a24ea0514965ba81db4dd8fcca52d7711d2","352c259523cd63b2c4d520c7b3fd65e6358bdff9076a0b63b470a92b49ddb7eb","d9df308e039118183a51ccacfdf8710cd8d296329d1ba9fe1263ac4d060798d5","ae3683e6b5b981c265be8486d12cf72e5a38059490dfb6ae79cf94047f934798","c6fe7301993d23e1883661b94adb1af72129e646f61d88e25d90ab791f92ce0d"],"paragraph_range_zero_based":[24144,24167],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p24144"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"p0-List","paragraph_zero_based":24168},{"literal_text_all_w_t_and_m_t":"Configuration of {p0-PUSCH, p0-PUSCH} sets for PUSCH. If SRI is present in the DCI, then one p0-PUSCH can be configured in P0-PUSCH-Set. If SRI is not present in the DCI, and both olpc-ParameterSetDCI-0-1 and olpc-ParameterSetDCI-0-2 are configured to be 1 bit, then one p0-PUSCH can be configured in P0-PUSCH-Set. If SRI is not present in the DCI, and if any of olpc-ParameterSetDCI-0-1 and olpc-ParameterSetDCI-0-2 is configured to be 2 bits, then two p0-PUSCH values can be configured in P0-PUSCH-Set (see TS 38.213 [13] clause 7 and TS 38.212 [17] clause 7.3.1).","paragraph_zero_based":24169},{"literal_text_all_w_t_and_m_t":"p0-PUSCH-SetId","paragraph_zero_based":24170},{"literal_text_all_w_t_and_m_t":"Configure the index of a p0-PUSCH-Set (see TS 38.213 [13] clause 7 and TS 38.212 [17] clause 7.3.1).","paragraph_zero_based":24171},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24172},{"literal_text_all_w_t_and_m_t":"PUSCH-PowerControl field descriptions","paragraph_zero_based":24173},{"literal_text_all_w_t_and_m_t":"deltaMCS","paragraph_zero_based":24174},{"literal_text_all_w_t_and_m_t":"Indicates whether to apply delta MCS. When the field is absent, the UE applies Ks = 0 in delta_TFC formula for PUSCH (see TS 38.213 [13], clause 7.1).","paragraph_zero_based":24175},{"literal_text_all_w_t_and_m_t":"dummy","paragraph_zero_based":24176},{"literal_text_all_w_t_and_m_t":"This field is not used in the specification. If received it shall be ignored by the UE.","paragraph_zero_based":24177},{"literal_text_all_w_t_and_m_t":"msg3-Alpha","paragraph_zero_based":24178},{"literal_text_all_w_t_and_m_t":"Dedicated alpha value for msg3 PUSCH (see TS 38.213 [13], clause 7.1). When the field is absent the UE applies the value 1.","paragraph_zero_based":24179},{"literal_text_all_w_t_and_m_t":"olpc-ParameterSetDCI-0-1, olpc-ParameterSetDCI-0-2","paragraph_zero_based":24180},{"literal_text_all_w_t_and_m_t":"Configures the number of bits for Open-loop power control parameter set indication for DCI format 0_1/0_2 in case SRI is not configured in the DCI. 2 bits is applicable only if SRI is not present in the DCI format 0_1. The field olpc-ParameterSetDCI-0-1 applies to DCI format 0_1 and the field olpc-ParameterSetDCI-0-2 applies to DCI format 0_2 (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13], clause 11).","paragraph_zero_based":24181},{"literal_text_all_w_t_and_m_t":"p0-AlphaSets","paragraph_zero_based":24182},{"literal_text_all_w_t_and_m_t":"Configuration {p0-pusch, alpha} sets for PUSCH (except msg3 and msgA PUSCH), i.e., { {p0,alpha,index1}, {p0,alpha,index2},...} (see TS 38.213 [13], clause 7.1). When no set is configured, the UE uses the P0-nominal for msg3/msgA PUSCH, P0-UE is set to 0 and alpha is set according to either msg3-Alpha or msgA-Alpha (see TS 38.213 [13], clause 7.1).","paragraph_zero_based":24183},{"literal_text_all_w_t_and_m_t":"p0-NominalWithoutGrant","paragraph_zero_based":24184},{"literal_text_all_w_t_and_m_t":"P0 value for UL grant-free/SPS based PUSCH. Value in dBm. Only even values (step size 2) allowed (see TS 38.213 [13], clause 7.1).","paragraph_zero_based":24185},{"literal_text_all_w_t_and_m_t":"p0-PUSCH-SetList","paragraph_zero_based":24186},{"literal_text_all_w_t_and_m_t":"Configure one additional P0-PUSCH-Set per SRI. If present, the one bit or 2 bits in the DCI is used to dynamically indicate among the P0 value from the existing P0-PUSCH-AlphaSet and the P0 value(s) from the P0-PUSCH-Set (See TS 38.212 [17], clause 7.3.1 and TS 38.213 [13], clause 17).","paragraph_zero_based":24187},{"literal_text_all_w_t_and_m_t":"p0-PUSCH-SetList2","paragraph_zero_based":24188},{"literal_text_all_w_t_and_m_t":"For indicating per-TRP OLPC set in DCI format 0_1/0_2 with the legacy field, a second p0-PUSCH-SetList-r16 is used. When this field is present the p0-PUSCH-SetList corresponds to the first SRS resource set (see TS 38.213).","paragraph_zero_based":24189},{"literal_text_all_w_t_and_m_t":"pathlossReferenceRSToAddModList, pathlossReferenceRSToAddModListSizeExt","paragraph_zero_based":24190},{"literal_text_all_w_t_and_m_t":"A set of Reference Signals (e.g. a CSI-RS config or a SS block) to be used for PUSCH path loss estimation. The set consists of Reference Signals configured using pathLossReferenceRSToAddModList and Reference Signals configured using pathlossReferenceRSToAddModListSizeExt. Up to maxNrofPUSCH-PathlossReferenceRSs may be configured (see TS 38.213 [13], clause 7.1).","paragraph_zero_based":24191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["911947be33e952e28bfdf64be728c702fcedd11a483d7192f3749f059e9a0aac","68c90afc63c77da87a6a0a6cfb4047038ad16e27b9ce2548b65e4829544a9b82","4158b433f0496ca161e28befb333537e37b9d12b2cee3f6cf13ace8d5fa39fe1","a1a37d4a6c8b9621ea101083a766362d2a001b796fad394b640eceda3faa72f0","5b05eca17b7d9155b01789fb503531700924cfe3acdb01b9d45799ba196e7811","7e1e604582e95ce2ae4c579ea1d9f62beb797624e34acac577f9e639673fd9c8","fe20f07e69e142b70fbb31e0b9af040ca1bd22a310d27b9aea29eb0a7391381f","b24606af087dea791faec1b62c3c3529f44d2a1528dc649437232307dc569649","52f453f95419b69d16d73a1438d8b931b481c13c9d76c00653376bebf70dc62f","272a9276c54983dcc875b3b93e16f2578901412db9fcc3e7d92c23c9b945d10b","a2190627f10082eb52648b084d1566680325a9842a0fbdb509efec29ba73e517","c3608e7df55526abd15b0ec9a5ea5cc0b80eb7b03ec9893dd18504da5de0628e","c218f261abc5145bbd7b7f50171c88167197cdafdd94465fc071c9d7cc02fb8a","61c5364e5c8f058ea15e2156e293e8f3e24f82d82677d9dcc0a0f3f89aa08c0d","7303689dba125d8f0b14330034d4df3a6599e43cc72bd5ea9b924dc2360a2852","99bf0655ba7ab753bf131e33d2fce85107d35d1ba569120612fba21fc4d06206","53121ed029aec0791960026525a2b441109d01b11e57df85a1ed485c1b7d4bf4","28baed12e4e62e6992d94be07752d396c7da103dbe184e6645559fc9674941c1","91c23ec9af65ded20afed78e99d698afd5d1cbc9a84da7700feffa17bd698d36","d37da02eaf051e3f6b25d0a08fc6c271defc0be432f4a5b665b806d103b2d19e","66d888e29823ee1ab130c1823a4d150efff50252d0ca41e5176f7ae6eef86ef2","bc2524da2da38ef348deea363827146d6bc2908d97a741bb00ea436a09e9dafb","63b4c45f4e6eeb53fda02e4435bee3cdfd01c9b2e60beab1b105a664e5404a06","578cd0be62f07bf701dfd2e49f9db54a8a4a097e32451791471b947f8f7a82fc"],"paragraph_range_zero_based":[24168,24191],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p24168"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"pathlossReferenceRSToReleaseList, pathlossReferenceRSToReleaseListSizeExt","paragraph_zero_based":24192},{"literal_text_all_w_t_and_m_t":"Lists of reference signals for PUSCH path loss estimation to be released by the UE.","paragraph_zero_based":24193},{"literal_text_all_w_t_and_m_t":"sri-PUSCH-MappingToAddModList","paragraph_zero_based":24194},{"literal_text_all_w_t_and_m_t":"A list of SRI-PUSCH-PowerControl elements among which one is selected by the SRI field in DCI (see TS 38.213 [13], clause 7.1).","paragraph_zero_based":24195},{"literal_text_all_w_t_and_m_t":"sri-PUSCH-MappingToAddModList2","paragraph_zero_based":24196},{"literal_text_all_w_t_and_m_t":"A list of SRI-PUSCH-PowerControl elements for second SRS-resource set, among which one is selected by the SRI field in DCI (see TS 38.213 [13], clause 7.1). When this field is present the sri-PUSCH-MappingToAddModList corresponds to the first SRS resource set for PUSCH.","paragraph_zero_based":24197},{"literal_text_all_w_t_and_m_t":"tpc-Accumulation","paragraph_zero_based":24198},{"literal_text_all_w_t_and_m_t":"If enabled, UE applies TPC commands via accumulation. If not enabled, UE applies the TPC command without accumulation. If the field is absent, TPC accumulation is enabled (see TS 38.213 [13], clause 7.1).","paragraph_zero_based":24199},{"literal_text_all_w_t_and_m_t":"twoPUSCH-PC-AdjustmentStates","paragraph_zero_based":24200},{"literal_text_all_w_t_and_m_t":"Number of PUSCH power control adjustment states maintained by the UE (i.e., fc(i)). If the field is present (n2) the UE maintains two power control states (i.e., fc(i,0) and fc(i,1)). If the field is absent, it maintains one power control state (i.e., fc(i,0)) (see TS 38.213 [13], clause 7.1).","paragraph_zero_based":24201},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24202},{"literal_text_all_w_t_and_m_t":"SRI-PUSCH-PowerControl field descriptions","paragraph_zero_based":24203},{"literal_text_all_w_t_and_m_t":"sri-P0-PUSCH-AlphaSetId","paragraph_zero_based":24204},{"literal_text_all_w_t_and_m_t":"The ID of a P0-PUSCH-AlphaSet as configured in p0-AlphaSets in PUSCH-PowerControl.","paragraph_zero_based":24205},{"literal_text_all_w_t_and_m_t":"sri-PUSCH-ClosedLoopIndex","paragraph_zero_based":24206},{"literal_text_all_w_t_and_m_t":"The index of the closed power control loop associated with this SRI-PUSCH-PowerControl.","paragraph_zero_based":24207},{"literal_text_all_w_t_and_m_t":"sri-PUSCH-PathlossReferenceRS-Id","paragraph_zero_based":24208},{"literal_text_all_w_t_and_m_t":"The ID of PUSCH-PathlossReferenceRS as configured in the pathlossReferenceRSToAddModList in PUSCH-PowerControl.","paragraph_zero_based":24209},{"literal_text_all_w_t_and_m_t":"sri-PUSCH-PowerControlId","paragraph_zero_based":24210},{"literal_text_all_w_t_and_m_t":"The ID of this SRI-PUSCH-PowerControl configuration. It is used as the codepoint (payload) in the SRI DCI field.","paragraph_zero_based":24211},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24212},{"literal_text_all_w_t_and_m_t":"–PUSCH-ServingCellConfig","paragraph_zero_based":24213},{"literal_text_all_w_t_and_m_t":"The IE PUSCH-ServingCellConfig is used to configure UE specific PUSCH parameters that are common across the UE's BWPs of one serving cell.","paragraph_zero_based":24214},{"literal_text_all_w_t_and_m_t":"PUSCH-ServingCellConfig information element","paragraph_zero_based":24215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["9cd804a2e6721264e44