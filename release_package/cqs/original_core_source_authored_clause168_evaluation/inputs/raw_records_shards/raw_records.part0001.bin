{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–PUCCH-SpatialRelationInfo-Id","paragraph_zero_based":23976},{"literal_text_all_w_t_and_m_t":"The IE PUCCH-SpatialRelationInfo-Id is used to identify a PUCCH-SpatialRelationInfo","paragraph_zero_based":23977},{"literal_text_all_w_t_and_m_t":"PUCCH-SpatialRelationInfo-Id information element","paragraph_zero_based":23978},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":23979},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-SPATIALRELATIONINFO-START","paragraph_zero_based":23980},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23981},{"literal_text_all_w_t_and_m_t":"PUCCH-SpatialRelationInfoId ::=         INTEGER (1..maxNrofSpatialRelationInfos)","paragraph_zero_based":23982},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23983},{"literal_text_all_w_t_and_m_t":"PUCCH-SpatialRelationInfoId-r16 ::=     INTEGER (1..maxNrofSpatialRelationInfos-r16)","paragraph_zero_based":23984},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23985},{"literal_text_all_w_t_and_m_t":"PUCCH-SpatialRelationInfoId-v1610::=    INTEGER (maxNrofSpatialRelationInfos-plus-1..maxNrofSpatialRelationInfos-r16)","paragraph_zero_based":23986},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23987},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-SPATIALRELATIONINFO-STOP","paragraph_zero_based":23988},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23989},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23990},{"literal_text_all_w_t_and_m_t":"–PUCCH-TPC-CommandConfig","paragraph_zero_based":23991},{"literal_text_all_w_t_and_m_t":"The IE PUCCH-TPC-CommandConfig is used to configure the UE for extracting TPC commands for PUCCH from a group-TPC messages on DCI.","paragraph_zero_based":23992},{"literal_text_all_w_t_and_m_t":"PUCCH-TPC-CommandConfig information element","paragraph_zero_based":23993},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":23994},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-TPC-COMMANDCONFIG-START","paragraph_zero_based":23995},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23996},{"literal_text_all_w_t_and_m_t":"PUCCH-TPC-CommandConfig ::=             SEQUENCE {","paragraph_zero_based":23997},{"literal_text_all_w_t_and_m_t":"    tpc-IndexPCell                          INTEGER (1..15)                         OPTIONAL,   -- Cond PDCCH-OfSpcell","paragraph_zero_based":23998},{"literal_text_all_w_t_and_m_t":"    tpc-IndexPUCCH-SCell                    INTEGER (1..15)                         OPTIONAL,   -- Cond PDCCH-ofSpCellOrPUCCH-SCell","paragraph_zero_based":23999}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["23ad9443b085260ebc81cda99eca2af0ed32ce5c433f45a941bdb6cb39e71d1c","64054d876bcc57ab26677f9cc0c147fb25e25bb1024e687da26b044331ce960f","e961da1bd6a1ee756853f2063ad32f2897d80ced2e42db97af27c89ebc99b8f7","f3f90cbf291ba11fd435334ae44bb55b496a7249f0a29b3b2328dee6e31f9f89","eb6c20624c5546e15f763a20222162bd18bb49bcd3c44d74f70433cbeee22a72","9bdecee977afb7d019add56e7eb405d1660e1f639dfaca58cd2a878e85c8f9ac","815acfdd2dca9456b5b8d9af5e34fb3b342180ff57eb7278f7ab7a99da529063","83c149273f414974195b86fec977a9ee3d203bf4a0f62c57036f4b4df8982527","6a61bce5b65c33a4c236376729183e7039db8370129fa8053a4c2a32361b98c0","e90f954be4bc9173dadad980cd3a2f1e8a490d3ae45339cf68a7b01287577aeb","d4ded198c655ca04c79f462a17060b0eeda9f84a87d656882a3718fabe529c7c","403ad79b39b67274908bd03fc51b295870f8ac104970bfc17962fc3c830f632b","156b366f2f1331990c72c86bf6f59056352d03