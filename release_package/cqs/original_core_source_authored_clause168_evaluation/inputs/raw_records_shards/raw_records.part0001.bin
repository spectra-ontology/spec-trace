{"fields":{"filename":"R2-2313675.zip::R2-2313675 38.321 CR for UAV.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"B","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Rel-18","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-16(Release 16)Rel-17(Release 17)Rel-18(Release 18)Rel-19(Release 19)","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":"Reason for change:","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"Introduction of NR Support for Uncrewed Aerial Vehicles.","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"In Section 2 new reference is inserted.","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"In Section 3.1 new UAV-related definitions are added.","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"In Section 3.2 new UAV-related abbreviations are added.","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"In Section 5.22.1.1 and Section 5.22.1.4.1.2, UE behavior to select a resource pool from separately configured UAV resource pool(s) and corresponding logical channel prioritization procedure are added.","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"fba70860f835d9038c47a1505397a4d028ca137ae0fa283b50bee18b2e83b295","original_member_sha256":"59b1d22b48df6067ac54d71b650dbe3cbd5d4468742f5ada8121a61670aac922","paragraph_ElementTree_utf8_XML_sha256":["29fea6c116b5aa0c325c6eda58e92ad311d2c2fdd246390023124b4816a0b03a","2580f2ff440825e8cc70d669cb5080b1ee35d364d5f30f3db9420d2cd812baba","0ff3d203e913e71878ac1122bcacb9c058911c6fc4df2f3ddd359633bfcc71a2","16181f6be83d81574817e362d31849158686aebfbc2b3db2cb96c77e51d75e63","6d06ebb0a782cf130aea0f577183e1f48b9ad736922104cb5c2eac44c1b642be","a127d821b41895c575766e7af041f3bd66dfb969390ec3d2e0a4389d275c0574","d41ed84597ae7af9dd5c6978696440ceecf17dd2eb272e99127e085104515d5e","a72d1cc19e03154ae3eb493e3c35b6a529ffccb562ba658fcf006744dd632fa7","bc4f0745a8610da3e7fed31aa279698118ff071365a3d8a9b622efff65efe678","178cd294a94991a3a113d38af4ee78a0964d2f2ea71d6489faffd8f87f525219","4e7dd2b31d176385be44f3d28ffc12973d359d639de3c9a38e61b9a3f1c3690f","a375db127f31894121aeff9f24a6ead3b774dda7607ec6a9f76620c01e5bc093","eb006e02600e26f7636b053b4b099ad01fe0a5c4d5a6e2312ade5d16e3507eab","fcf7e80b192b3e103a014ec8ffa18c16b85740848cbd25b2ef49fdfc8a54cecf","1d861d956d45ed962a2840167e4187f76f0cd5b86a69d292018151353dc1dad6","3cad68a775303a655f7bc1c74d40961168098f7b04