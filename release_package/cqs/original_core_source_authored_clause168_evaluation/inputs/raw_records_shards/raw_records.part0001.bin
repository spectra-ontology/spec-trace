{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"nr-TimeStamp","paragraph_zero_based":12912},{"literal_text_all_w_t_and_m_t":"This field specifies the latest time instance at which the association is valid prior to the reporting.","paragraph_zero_based":12913},{"literal_text_all_w_t_and_m_t":"servCellID","paragraph_zero_based":12914},{"literal_text_all_w_t_and_m_t":"This field indicates the serving cell information of SRS for positioning resources associated to the UE Tx TEG report.","paragraph_zero_based":12915},{"literal_text_all_w_t_and_m_t":"ue-TxTEG-ID","paragraph_zero_based":12916},{"literal_text_all_w_t_and_m_t":"Identifies the ID of UE Tx TEG.","paragraph_zero_based":12917},{"literal_text_all_w_t_and_m_t":"ue-TxTEG-TimingErrorMarginValue","paragraph_zero_based":12918},{"literal_text_all_w_t_and_m_t":"This field specifies the UE Tx TEG timing error margin value of all the UE Tx TEGs within one UEPositioningAssistanceInfo. Value tc0 corresponds to 0 Tc, tc2 corresponds to 2 Tc and so on (see TS 37.355 [49]).","paragraph_zero_based":12919},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12920},{"literal_text_all_w_t_and_m_t":"–ULDedicatedMessageSegment","paragraph_zero_based":12921},{"literal_text_all_w_t_and_m_t":"The ULDedicatedMessageSegment message is used to transfer segments of the UECapabilityInformation or MeasurementReportAppLayer message. SRB1 is used at transfer of segments of UECapabilityInformation and SRB4 is used at transfer of segments of MeasurementReportAppLayer.","paragraph_zero_based":12922},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1 or SRB4","paragraph_zero_based":12923},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":12924},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":12925},{"literal_text_all_w_t_and_m_t":"Direction: UE to Network","paragraph_zero_based":12926},{"literal_text_all_w_t_and_m_t":"ULDedicatedMessageSegment message","paragraph_zero_based":12927},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":12928},{"literal_text_all_w_t_and_m_t":"-- TAG-ULDEDICATEDMESSAGESEGMENT-START","paragraph_zero_based":12929},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12930},{"literal_text_all_w_t_and_m_t":"ULDedicatedMessageSegment-r16 ::=       SEQUENCE {","paragraph_zero_based":12931},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                      CHOICE {","paragraph_zero_based":12932},{"literal_text_all_w_t_and_m_t":"        ulDedicatedMessageSegment-r16           ULDedicatedMessageSegment-r16-IEs,","paragraph_zero_based":12933},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture                SEQUENCE {}","paragraph_zero_based":12934},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":12935}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["d5909169721a2a510c7fc05611eea8654b4dca7624e0f64345018f9d611fcea3","1a6086327b0f0cefe035ac47cd02e3ff4d5feeb9bf615650de5fdc60154e454d","dcc29dee3cc66f1183878abac6fae1b546d275bc33891b7207febac1f8ad47ad","6aa5e5a073dd93e6704b4faa22c2dfa2b0c4a2adfe257f884e18c57f8c7b6285","be36c31c42d2d8a8f5c42a6d90600e5a73d31ad1baf6799f5091632b458a62cb","15edcd1cc0f0aec5176f9ebed3c6b91d0f15c71611cb6e52180f329b7a622437","052f928908dad90a4675627d5212bd9e9aa1b7c62012c3156a0aa3c2693c54e4","43038b03fef973ec8d239eaa48ee7342d4de35b6115cc331f8cecb2d214ee2a7","954d36b8ec844fcf22acf6cb29de51344b27ebb632495e087f3a3f6dde9b5187","2be1540a05fe3342df1eebf1979c62521b6b25ffb0558fd4a660922c76e162dd","347b25be15