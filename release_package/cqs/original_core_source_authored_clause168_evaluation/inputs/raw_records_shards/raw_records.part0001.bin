{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"PUSCH-TimeDomainResourceAllocation-r16 ::=  SEQUENCE {","paragraph_zero_based":24288},{"literal_text_all_w_t_and_m_t":"    k2-r16                                     INTEGER(0..32)          OPTIONAL,   -- Need S","paragraph_zero_based":24289},{"literal_text_all_w_t_and_m_t":"    puschAllocationList-r16                    SEQUENCE (SIZE(1..maxNrofMultiplePUSCHs-r16)) OF PUSCH-Allocation-r16,","paragraph_zero_based":24290},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":24291},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":24292},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24293},{"literal_text_all_w_t_and_m_t":"PUSCH-Allocation-r16 ::=  SEQUENCE {","paragraph_zero_based":24294},{"literal_text_all_w_t_and_m_t":"    mappingType-r16                           ENUMERATED {typeA, typeB}                     OPTIONAL,   -- Cond NotFormat01-02-Or-TypeA","paragraph_zero_based":24295},{"literal_text_all_w_t_and_m_t":"    startSymbolAndLength-r16                  INTEGER (0..127)                              OPTIONAL,   -- Cond NotFormat01-02-Or-TypeA","paragraph_zero_based":24296},{"literal_text_all_w_t_and_m_t":"    startSymbol-r16                           INTEGER (0..13)                               OPTIONAL,   -- Cond RepTypeB","paragraph_zero_based":24297},{"literal_text_all_w_t_and_m_t":"    length-r16                                INTEGER (1..14)                               OPTIONAL,   -- Cond RepTypeB","paragraph_zero_based":24298},{"literal_text_all_w_t_and_m_t":"    numberOfRepetitions-r16                   ENUMERATED {n1, n2, n3, n4, n7, n8, n12, n16} OPTIONAL,   -- Cond Format01-02","paragraph_zero_based":24299},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":24300},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":24301},{"literal_text_all_w_t_and_m_t":"    numberOfRepetitionsExt-r17                ENUMERATED {n1, n2, n3, n4, n7, n8, n12, n16, n20, n24, n28, n32, spare4, spare3, spare2,","paragraph_zero_based":24302},{"literal_text_all_w_t_and_m_t":"                                                          spare1}                           OPTIONAL,   -- Cond Format01-02-For-TypeA","paragraph_zero_based":24303},{"literal_text_all_w_t_and_m_t":"    numberOfSlotsTBoMS-r17                   ENUMERATED {n1, n2, n4, n8, spare4, spare3, spare2, spare1}   OPTIONAL,   -- Need R","paragraph_zero_based":24304},{"literal_text_all_w_t_and_m_t":"    extendedK2-r17                            INTEGER (0..128)                              OPTIONAL    -- Cond MultiPUSCH","paragraph_zero_based":24305},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":24306},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":24307},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24308},{"literal_text_all_w_t_and_m_t":"-- TAG-PUSCH-TIMEDOMAINRESOURCEALLOCATIONLIST-STOP","paragraph_zero_based":24309},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":24310},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["4838af8d1afb2e293a5eae439935554f6ca9c979598bb9645b7128ab1f8319ef","dfff5189c69215a1fa27d14c0ddf3be0a8ae7bd98c2e6111e012645ad5b8423a","e3c13679efd06426c68de68c4938383344b788a5c29ac8a213eefd9cb273efa5","4f88ca705698d1ed45985d775a964d4d7991b2cde532ea280dabacfeaa59da27","b9ba2f26c64101cec794eb63fe073530a8d3a455749d5b2f68c219db662550c1","fb0440c920b9edbf4c899742cd11e8c0da4e02a8356977ac45fd84850573fb65","da99c0e91e800e6b218b8eb60473a93b165c04ac5c6fd027ebe08099ee336411","61374dbd2787797fd8363f68e39edd91b5309c391fa811d7a1199fcb04b4739c","3c73b0ced0494779911a3367cc107ff9910260582cc2236f55fceb31f17e0f97","4c438f7da8fe8916175aa3cedbf9b3d1f6edfb5a4c199f9431cedc512fb26e28","2d9bf253de6030c96616f175e6506769fc41e81b9f792433e559f3263d839747","7f461fc7f28d4cca9e64253484ccfb4e15a85343afd0dc7d574f2ec70bb25274","e883e737a766f89f5bbfc1bd2b0a1b884561c0539ebfca5b0b95326f3f4bf491","e6ade2010fca4d7530368e196f3e60e032cee07362582cf7b680fb372da46802","2582b2ef04eedbffd222f0ea7091412a1a4fe46ee71cb2fa03385fcd32ffa3a5","ef83bee924099fd5f31d0a7f904a642284f12288546cc6a4d25d4809fd3e5960","99343833bba99fb32c8c8f1b5624d9ead0de583d2d050ba4a7e102c8cf1f211d","f201c98ff2c12ba3d9d44c7dfa8210b1ab64ab7b367079d4a22c455f7923146d","86f067ca21541c0bc0ced4398d6139fd2d320f93aecad0b1ad6681a60cbf293a","b1eb6e66451948610398f2ed90443f2ad1e7c6bc63f897f1e40b9edb632d6aec","dc59b498dd6cfc28f3b8b0e25e437cbc86a23f6ad20e888aba57a741cd0ca2cc","14a7e1d8246f0ad4cb07e483f3749d1d671f7458a18664fe955bf34413402df6","57cad36d6ddd6ed3a82411351f286625e7b181a82f54862deb3203fd270746a1","270874227bcb2bf9ecf2d173b43e011ceb3fcd2073bcccc2e30f38e1fe4de76b"],"paragraph_range_zero_based":[24288,24311],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p24288"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"PUSCH-TimeDomainResourceAllocationList field descriptions","paragraph_zero_based":24312},{"literal_text_all_w_t_and_m_t":"extendedK2","paragraph_zero_based":24313},{"literal_text_all_w_t_and_m_t":"Corresponds to L1 parameter 'K2' (see TS 38.214 [19], clause 6.1.2.1) configurable per PUSCH allocation. Only values {0..32} are applicable for PUSCH SCS of 120 kHz.","paragraph_zero_based":24314},{"literal_text_all_w_t_and_m_t":"When the field is absent for the first PUSCH if multiple PUSCH are configured per PDCCH, or when the field is absent and only one PUSCH is configured per PDCCH, the UE applies the value 1 when PUSCH SCS is 15/30 kHz; the value 2 when PUSCH SCS is 60 kHz, the value 3 when PUSCH SCS is 120 kHz, the value 11 when PUSCH SCS is 480 kHz, and the value 21 when PUSCH SCS is 960 kHz.","paragraph_zero_based":24315},{"literal_text_all_w_t_and_m_t":"k2","paragraph_zero_based":24316},{"literal_text_all_w_t_and_m_t":"Corresponds to L1 parameter 'K2' (see TS 38.214 [19], clause 6.1.2.1). When the field is absent the UE applies the value 1 when PUSCH SCS is 15/30 kHz; the value 2 when PUSCH SCS is 60 kHz, and the value 3 when PUSCH SCS is 120 kHz. k2 is absent/ignored if extendedK2 is present.","paragraph_zero_based":24317},{"literal_text_all_w_t_and_m_t":"length","paragraph_zero_based":24318},{"literal_text_all_w_t_and_m_t":"Indicates the length allocated for PUSCH for DCI format 0_1/0_2 (see TS 38.214 [19], clause 6.1.2.1).","paragraph_zero_based":24319},{"literal_text_all_w_t_and_m_t":"mappingType","paragraph_zero_based":24320},{"literal_text_all_w_t_and_m_t":"Mapping type (see TS 38.214 [19], clause 6.1.2.1).","paragraph_zero_based":24321},{"literal_text_all_w_t_and_m_t":"numberOfRepetitions","paragraph_zero_based":24322},{"literal_text_all_w_t_and_m_t":"Number of repetitions for DCI format 0_1/0_2 (see TS 38.214 [19], clause 6.1.2.1). When numberOfSlotsTBoMS-r17 is set to 2, 4 or 8 (i.e. TB processing over multi-slot (TBoMS) PUSCH is enabled), it indicates the number of repetitions of a single TBoMS.","paragraph_zero_based":24323},{"literal_text_all_w_t_and_m_t":"numberOfRepetitionsExt","paragraph_zero_based":24324},{"literal_text_all_w_t_and_m_t":"Number of repetitions for DCI format 0_1/0_2 if pusch-RepTypeIndicatorDCI-0-1/pusch-RepTypeIndicatorDCI-0-2 is not set to pusch-RepTypeB (see TS 38.214 [19], clause 6.1.2.1). If this field is present, the field numberOfRepeitions-r16 is ignored for PUSCH repetition Type A.","paragraph_zero_based":24325},{"literal_text_all_w_t_and_m_t":"numberOfSlotsTBoMS","paragraph_zero_based":24326},{"literal_text_all_w_t_and_m_t":"Number of slots allocated for TB processing over multi-slot PUSCH for DCI format 0_1/0_2. If a number of repetitions K is configured by numberOfRepetitions or numberOfRepetitionsExt, the network configures numberOfSlotsTBoMS (N) and K such that N*K ≤ 32 (see TS 38.214 [19], clause 6.1.2.1). The network does not configure the numberOfSlotsTBoMS-r17 simultaneously with the pusch-TimeDomainAllocationListForMultiPUSCH-r16.","paragraph_zero_based":24327},{"literal_text_all_w_t_and_m_t":"puschAllocationList","paragraph_zero_based":24328},{"literal_text_all_w_t_and_m_t":"The field puschAllocationList-r16 indicates one or multiple PUSCH continuous in time domain which share a common k2 (see TS 38.214 [19], clause 6.1.2.1). The field pusch-AllocationList-r17 configures one or multiple PUSCH that may be in consecutive or non-consecutive slots (see TS 38.214 [19], clause 6.1.2.1). The puschAllocationList-r16 only has one element in pusch-TimeDomainAllocationListDCI-0-1-r16 and in pusch-TimeDomainAllocationListDCI-0-2-r16.","paragraph_zero_based":24329},{"literal_text_all_w_t_and_m_t":"startSymbol","paragraph_zero_based":24330},{"literal_text_all_w_t_and_m_t":"Indicates the index of start symbol for PUSCH for DCI format 0_1/0_2 (see TS 38.214 [19], clause 6.1.2.1).","paragraph_zero_based":24331},{"literal_text_all_w_t_and_m_t":"startSymbolAndLength","paragraph_zero_based":24332},{"literal_text_all_w_t_and_m_t":"An index giving valid combinations of start symbol and length (jointly encoded) as start and length indicator (SLIV). The network configures the field so that the allocation does not cross the slot boundary. (see TS 38.214 [19], clause 6.1.2.1).","paragraph_zero_based":24333},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24334},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":24335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["32240998f44bf7dd25e5629419204ea457fdaff8ba30d4f370d6a6c65a949f70","25b17ef058618012692142bb90b7c6d5e58f57b8486bac5d1750c79ff2abe122","dab0f482130c69e585ff28c98c3c00881d9e074e275e4589209bb63b1a57358e","1c0e0d76a44f93fe2a1de477226cdb10b3088223b6a3896af538401f30d8002e","9460cdaeaee6745aff766d198e671a3376b19cf7d52ac6299abf218a5f54d7ce","c79fc5898f2c243c48b11014f170fa5275d35beabe0663f9500af39436d46981","23d64f673202b29a7627b50f83cd7284c789a35fccefa77e6d4662f09673a95c","71b9ab1b9c7b98ab24c1cf6d32de3fbb83f306a35691596c3ba06fdb80deab87","2a72e36ccb713cf2c289068cd977515a59a412400c172daf7fa6c1aaed00102b","bbe5b52a52f89b56e351f69239dff15009a92e5cdc505370093fbbd8bc97c11b","96a47b4ff969a3ababe025a78c140c961c04ce4a7f812313aebea3f5e34083a3","46eff91d15b24e350f7a9f0160e3bdbfd7956158d1fa526f605e5eec98af8af3","81336677bef1c6b40df0b4a0a1d0313958941708004f0c1699ea3b26d846c77f","a5e9af099f55f3eb85345514f7226873b7ab45ab654a83b4f929e74c398fb966","2b1947d7961fd72962df5ceef31d34261c932ac3c66cf59b789b2f7dc8f7f19a","55e12b7a306d8c2fe8eddd5adbdc0100adc180c630b95517ee879df409c8a4a0","1c2ae9b59b7dd5d70be7659d334b456d2bbb8fcc7317affb43cb1f29e992c60c","cb3249e6f93612be2aa726b80d6ec8723aa9e13353f609d346a3a82204674cda","d4cd98d987e5ef2d4b8fbdf5ebb9a0d9b3073afc3e6e684be0f524f7e1a98338","03d1114dc6570cdcb4230890b5c497116fb451bfd12957dd65a67cb67cc57427","f23af1c947ac03999404ae3a3706329b0b49e6de2950df2cb8df6307739ef225","99fbc8992aac64727c326b56358f377d2dbd0946d95cf21834b65ab356c7a1ac","a5fd1f6f14b15d9a89cad62163c92b425225ff285ba311f8b4e2bf3b522b4f28","77f5bb1aea4aa5e50da48f2564f7291e05d41c00da84821d920b4937a0e0f1a0"],"paragraph_range_zero_based":[24312,24335],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p24312"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":24336},{"literal_text_all_w_t_and_m_t":"Format01-02","paragraph_zero_based":24337},{"literal_text_all_w_t_and_m_t":"In pusch-TimeDomainAllocationListForMultiPUSCH-r16, the field is absent.","paragraph_zero_based":24338},{"literal_text_all_w_t_and_m_t":"In pusch-TimeDomainAllocationListDCI-0-1 and in pusch-TimeDomainAllocationListDCI-0-2, the field is mandatory present.","paragraph_zero_based":24339},{"literal_text_all_w_t_and_m_t":"Format01-02-For-TypeA","paragraph_zero_based":24340},{"literal_text_all_w_t_and_m_t":"In pusch-TimeDomainAllocationListForMultiPUSCH-r16, the field is absent.","paragraph_zero_based":24341},{"literal_text_all_w_t_and_m_t":"In pusch-TimeDomainAllocationListDCI-0-1, the field is optionally present if pusch-RepTypeIndicatorDCI-0-1 is not set to pusch-RepTypeB, Need R. It is absent otherwise, Need R.","paragraph_zero_based":24342},{"literal_text_all_w_t_and_m_t":"In pusch-TimeDomainAllocationListDCI-0-2, the field is optionally present if pusch-RepTypeIndicatorDCI-0-2 is not set to pusch-RepTypeB, Need R. It is absent otherwise, Need R.","paragraph_zero_based":24343},{"literal_text_all_w_t_and_m_t":"NotFormat01-02-Or-TypeA","paragraph_zero_based":24344},{"literal_text_all_w_t_and_m_t":"In pusch-TimeDomainAllocationListForMultiPUSCH-r16, the field is mandatory present.","paragraph_zero_based":24345},{"literal_text_all_w_t_and_m_t":"In pusch-TimeDomainAllocationListDCI-0-1, the field is mandatory present if pusch-RepTypeIndicatorDCI-0-1 is not set to pusch-RepTypeB. It is absent otherwise, Need R.","paragraph_zero_based":24346},{"literal_text_all_w_t_and_m_t":"In pusch-TimeDomainAllocationListDCI-0-2, the field is mandatory present if pusch-RepTypeIndicatorDCI-0-2 is not set to pusch-RepTypeB. It is absent otherwise, Need R.","paragraph_zero_based":24347},{"literal_text_all_w_t_and_m_t":"RepTypeB","paragraph_zero_based":24348},{"literal_text_all_w_t_and_m_t":"In pusch-TimeDomainAllocationListForMultiPUSCH-r16, the field is absent.","paragraph_zero_based":24349},{"literal_text_all_w_t_and_m_t":"In pusch-TimeDomainAllocationListDCI-0-1, the field is mandatory present if pusch-RepTypeIndicatorDCI-0-1 is set to pusch-RepTypeB. It is absent otherwise, Need R.","paragraph_zero_based":24350},{"literal_text_all_w_t_and_m_t":"In pusch-TimeDomainAllocationListDCI-0-2, the field is mandatory present if pusch-RepTypeIndicatorDCI-0-2 is set to pusch-RepTypeB. It is absent otherwise, Need R.","paragraph_zero_based":24351},{"literal_text_all_w_t_and_m_t":"MultiPUSCH","paragraph_zero_based":24352},{"literal_text_all_w_t_and_m_t":"In case size of puschAllocationList is higher than 1, the field extendedK2(n) corresponding to k2 of the n-th PUSCH, n>1, is mandatory present. Otherwise, it is optionally present, Need S.","paragraph_zero_based":24353},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24354},{"literal_text_all_w_t_and_m_t":"–PUSCH-TPC-CommandConfig","paragraph_zero_based":24355},{"literal_text_all_w_t_and_m_t":"The IE PUSCH-TPC-CommandConfig is used to configure the UE for extracting TPC commands for PUSCH from a group-TPC messages on DCI.","paragraph_zero_based":24356},{"literal_text_all_w_t_and_m_t":"PUSCH-TPC-CommandConfig information element","paragraph_zero_based":24357},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":24358},{"literal_text_all_w_t_and_m_t":"-- TAG-PUSCH-TPC-COMMANDCONFIG-START","paragraph_zero_based":24359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_