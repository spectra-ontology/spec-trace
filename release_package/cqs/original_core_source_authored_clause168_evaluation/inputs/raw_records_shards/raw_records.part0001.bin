ntityConfig information element","paragraph_zero_based":24426},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":24427},{"literal_text_all_w_t_and_m_t":"-- TAG-QUANTITYCONFIG-START","paragraph_zero_based":24428},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24429},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24430},{"literal_text_all_w_t_and_m_t":"QuantityConfig ::=                  SEQUENCE {","paragraph_zero_based":24431}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["2608626133ed335a9f29ed18e7a5531d7b88b0de3602bda498b551351e709663","8d16aec98a14674cc13edd095d707ee57ca4f97717d259146eeec1ee51ce9d64","70768b9b8f59a2053d2017496971dc790809ea5fc3234872f7fcc6711afad968","af5c39536192d4c66847b402273c5fefb8ccfbf3bf1f280026c0d0da20df6d91","c296228a0e2a301c9a4b9915e7739e8b178451c64c8ad791cdda13e1df90b2d4","5640516fa72a987035b9a47a42c68d20e64cb99ef7c782740bf9a8e43e918a3b","70f287001a0dfa6f0007625274cf50058c9f5edfa6c4d0bff0fb2ce94a3c0d57","bd1b5362d8d41b3ef4575ef2c1783e10c5f86c512d3674c8f8298638a39e6f64","fa3d7140d00d15243697f667b977cde978067ba5fdd77dc3036dc8151800d5d1","6caec2d67b33deeb8acdcb96a353501300a962bee7ff89fdeeec12c7e5fdfb23","7572e598f8fd114cf371085a05748ce8f4d70f782afa8441d62cec779bcaf321","93573faa121de7e54e0fd5dea0ae041d587251e3ad32708ba5cbf1ebd4d5acd9","454a219655958c682f1c515642f42c5153ee454951663a0af2853ac4a9815537","6e1e1cad3270966800cfd51b925d873ed3ac19c5311b0bd7135e944393855bcc","48def4b7c02c5c87f8600103ecc48dc4f81ccacfda7c4842c9443fe19c4edaf4","b220c6d18bd62ce8889972bddc1255487a1f389c87a6f44bfba7590f9cf9b471","87d8a8e6f2d889b84626d2d5e104ea1a6e9f26b65406eb88aea757e1163d0aab","326db040a87f1641415e82423cd7ad8268