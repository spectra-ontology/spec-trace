{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Choice of NR event triggered reporting criteria.","paragraph_zero_based":26016},{"literal_text_all_w_t_and_m_t":"maxNrofRS-IndexesToReport","paragraph_zero_based":26017},{"literal_text_all_w_t_and_m_t":"Max number of RS indexes to include in the measurement report for A1-A6 events.","paragraph_zero_based":26018},{"literal_text_all_w_t_and_m_t":"maxReportCells","paragraph_zero_based":26019},{"literal_text_all_w_t_and_m_t":"Max number of non-serving cells to include in the measurement report.","paragraph_zero_based":26020},{"literal_text_all_w_t_and_m_t":"referenceLocation1, referenceLocation2","paragraph_zero_based":26021},{"literal_text_all_w_t_and_m_t":"Reference locations used for eventD1. The referenceLocation1 is associated to serving cell and referenceLocation2 is associated to neighbour cell.","paragraph_zero_based":26022},{"literal_text_all_w_t_and_m_t":"reportAddNeighMeas","paragraph_zero_based":26023},{"literal_text_all_w_t_and_m_t":"Indicates that the UE shall include the best neighbour cells per serving frequency.","paragraph_zero_based":26024},{"literal_text_all_w_t_and_m_t":"reportAmount","paragraph_zero_based":26025},{"literal_text_all_w_t_and_m_t":"Number of measurement reports applicable for eventTriggered as well as for periodical report types.","paragraph_zero_based":26026},{"literal_text_all_w_t_and_m_t":"reportOnLeave","paragraph_zero_based":26027},{"literal_text_all_w_t_and_m_t":"Indicates whether or not the UE shall initiate the measurement reporting procedure when the leaving condition is met for a cell in cellsTriggeredList, as specified in 5.5.4.1.","paragraph_zero_based":26028},{"literal_text_all_w_t_and_m_t":"Indicates whether or not the UE shall initiate the measurement reporting procedure when the leaving condition is met if configured in eventD1, as specified in 5.5.4.1.","paragraph_zero_based":26029},{"literal_text_all_w_t_and_m_t":"reportQuantityCell","paragraph_zero_based":26030},{"literal_text_all_w_t_and_m_t":"The cell measurement quantities to be included in the measurement report.","paragraph_zero_based":26031},{"literal_text_all_w_t_and_m_t":"reportQuantityRS-Indexes","paragraph_zero_based":26032},{"literal_text_all_w_t_and_m_t":"Indicates which measurement information per RS index the UE shall include in the measurement report.","paragraph_zero_based":26033},{"literal_text_all_w_t_and_m_t":"timeToTrigger","paragraph_zero_based":26034},{"literal_text_all_w_t_and_m_t":"Time during which specific criteria for the event needs to be met in order to trigger a measurement report.","paragraph_zero_based":26035},{"literal_text_all_w_t_and_m_t":"useAllowedCellList","paragraph_zero_based":26036},{"literal_text_all_w_t_and_m_t":"Indicates whether only the cells included in the allow-list of the associated measObject are applicable as specified in 5.5.4.1.","paragraph_zero_based":26037},{"literal_text_all_w_t_and_m_t":"useT312","paragraph_zero_based":26038},{"literal_text_all_w_t_and_m_t":"If value TRUE is configured, the UE shall use the timer T312 with the value t312 as specified in the corresponding measObjectNR. If value FALSE is configured, the timer T312 is considered as disabled. Network configures value TRUE only if reportType is set to eventTriggered.","paragraph_zero_based":26039}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["5bef6f1ec6a62b2e0a04c1ead6c0a87dee7dea01a67b6afeb75052cc20b26dd5","cb7bf5d6e766d07e613d0e0eaa12f92b27ef7a70b0953494841a2a577ce47984","3ea67b92ee6f1119435e8de7789a74eb408bc3489b34d2ae8dfe93119e87974f","b4a372c97e440be068c849e3f18e183023d9f5ba45f2fc0172726a38bc32daa9","4b1d3ead2cebc443782ca21996136907859bff569fb961738dba300ea4ed3ffc","38e4808c266682c53926b3f443d20fabba76128723f3e9d3bd59e5ef76a0bbf0","c41c5e64bdba3f597bfb796ad9cf34e249efc82ddd2445c7defbad6e3f9e88e3","eec2f72dac71d0dc74e3fc7ff9496e5ca17f9b23edc1dd0bf949b8c0d7f57321","758665aeb555f94699cc4876b020e04398c42467a230af50d802e29d20a502b6","bcc7176481d5a8c77b0f1dbc7a82a92f90d6709dcad07ef3de6cbab59e798131","34577f546b831517560ee11d83fe414ce1dcc9a5c696536b947a6f4b3bad2260","598a9d5df644ebfcfa0acce2270d9152f01b79e5d4f070c8b1659f115a899ac9","b4aacb36da5d5426eda7ddf4fdc16cca1638a5e4225bf7febbb925c7cb1a803f","6d870dbe705dc1e2e47f9b2cef2b69e821c655dc3fb39e501a90706fe3a7aa19","14256e2b64bf97ccfc59dc5e4a3121cefe717d6a97adf459569df4c7ba69a3e0","8935a371887044e8b38d7a56f3b4a236ab4d9ad75026b39e6923514fa1cadccd","56cb32b02437ae898bc299502800b80f52d9509579084ea79380f4b48e07eea2","1f468d97a0bf905bc531824c16342ebeb8f2317d62eb8d0c1d7b43e316dd534f","2f2408482d04a1675c13026f83a44e8d0a5c06909950285235cbd67ab6c8d167","f9a892fa17666941255d1359c19a665b30b2dda92acb8b12fd5519c7948daf5e","1403200e86f4f5b3ed079d29688bf842ba379f349537994d6bdacd475f7b5cbe","3003e7354cd321f63ad4789fa553d12fbcc8ff8bf7244f7fc1b3b3457a4300de","3c1cd950c4baf50c3cca70a4450428a057d4f25347748b1139819e7a3433aa3f","cdc9eaa933ca2d1f2d0d080d4da9a9751ce863b4b88ba46f657837ecafe53cc6"],"paragraph_range_zero_based":[26016,26039],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p26016"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"xN-ThresholdM","paragraph_zero_based":26040},{"literal_text_all_w_t_and_m_t":"Threshold value associated to the selected trigger quantity (e.g. RSRP, RSRQ, SINR) per RS Type (e.g. SS/PBCH block, CSI-RS) to be used in NR measurement report triggering condition for event xN. If multiple thresholds are defined for event number xN, the thresholds are differentiated by M. x1-Threshold1 and x2-Threshold indicates the threshold value for the serving L2 U2N Relay UE, x1-Threshold2 indicates the threshold value for the NR Cells.","paragraph_zero_based":26041},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26042},{"literal_text_all_w_t_and_m_t":"CLI-EventTriggerConfig field descriptions","paragraph_zero_based":26043},{"literal_text_all_w_t_and_m_t":"i1-Threshold","paragraph_zero_based":26044},{"literal_text_all_w_t_and_m_t":"Threshold value associated to the selected trigger quantity (e.g. SRS-RSRP, CLI-RSSI) to be used in CLI measurement report triggering condition for event i1.","paragraph_zero_based":26045},{"literal_text_all_w_t_and_m_t":"eventId","paragraph_zero_based":26046},{"literal_text_all_w_t_and_m_t":"Choice of CLI event triggered reporting criteria.","paragraph_zero_based":26047},{"literal_text_all_w_t_and_m_t":"maxReportCLI","paragraph_zero_based":26048},{"literal_text_all_w_t_and_m_t":"Max number of CLI measurement resource to include in the measurement report.","paragraph_zero_based":26049},{"literal_text_all_w_t_and_m_t":"reportAmount","paragraph_zero_based":26050},{"literal_text_all_w_t_and_m_t":"Number of measurement reports.","paragraph_zero_based":26051},{"literal_text_all_w_t_and_m_t":"reportOnLeave","paragraph_zero_based":26052},{"literal_text_all_w_t_and_m_t":"Indicates whether or not the UE shall initiate the measurement reporting procedure when the leaving condition is met for a CLI measurement resource in srsTriggeredList or rssiTriggeredList, as specified in 5.5.4.1.","paragraph_zero_based":26053},{"literal_text_all_w_t_and_m_t":"timeToTrigger","paragraph_zero_based":26054},{"literal_text_all_w_t_and_m_t":"Time during which specific criteria for the event needs to be met in order to trigger a measurement report.","paragraph_zero_based":26055},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26056},{"literal_text_all_w_t_and_m_t":"CLI-PeriodicalReportConfig field descriptions","paragraph_zero_based":26057},{"literal_text_all_w_t_and_m_t":"maxReportCLI","paragraph_zero_based":26058},{"literal_text_all_w_t_and_m_t":"Max number of CLI measurement resource to include in the measurement report.","paragraph_zero_based":26059},{"literal_text_all_w_t_and_m_t":"reportAmount","paragraph_zero_based":26060},{"literal_text_all_w_t_and_m_t":"Number of measurement reports.","paragraph_zero_based":26061},{"literal_text_all_w_t_and_m_t":"reportQuantityCLI","paragraph_zero_based":26062},{"literal_text_all_w_t_and_m_t":"The CLI measurement quantities to be included in the measurement report.","paragraph_zero_based":26063}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["4865afde03382dc5a493c0f2cd7fd2c463cda9361957a53ef88a789c0d083c9d","c7cde2cf408585b3c398bfff2083b8640f892177b71d1e7d649f2a5c7e12130a","4cde10723759a6a0b31819b753de8a0f142529a735decd80a64cf0aeb58e32ea","4aa9084800124ac8d153ffb55d3f0357756868a59bdc8fdd53cb70348c228b43","ff86f167f4d40e4c34e35a06796c1bc9f6bcf945890cae7c9a8cfb145124ac60","9b015303c67a25067665a7536b9088d167157af0464dd462231a5e724dc51f68","a0b5f71030eb031900e0a6f4b722eb14cc734769931935163b686ed7d8d33119","9fc6473ef77455fe8a0f2f80027498b695f0f206bde2b075c21fabb211959ac4","27bd0292ece10465ab049442f5f5cf9bc556bbc6fdbb278f49b01ff053150acc","2d9c8440a510fe1082b4ec3b080d1ca0d36da54d822a1b49a575c40787867c9c","5740424b1d1fec9fd5d3197df67cddc49036f3b362ff88b9ce75e646b6581f68","da69071ec0d8cde4b59a8d1a8c4bdefacd3e12c7bbb35691066dcdee140b5c42","121ef169e421276f442d2b5b094f0eb86c665526751a5bfa620e789252cd1307","27591a2e9b75b31a1c953ca318e98e5de1ebb322e88476b139d1a8835c3035af","ad11324a3d0ff6048c5f8f2f4a0f83ba577cdef25f8b2471a5ac732e62ec075b","cba07bb8fb084ab82f4a96585e84996c9cc32a8553c7adae9ac754022e8e92d0","6b0e138be085fdda72f7b3ca3e73a2e6cf92a59e78727cc969ce7fff2c10c53e","129591fcc24776e17e9924b15cde50244dc6216bc7ccb4d7120a2ff46c507b96","218b0317e314822bc6e5d9cc07586269ac5f1382e87718282a2ac64bff7d3bd5","8bd7b634ecac550e7dcaa2f4d9569eb9400b5d8df98f42d19336045bda9f5abc","28f23c11f0795083ebbe7ad0cb9e66dd18ededf587ea7fe0ae224d635f1cd705","c8b42dc6020f708d99eb119d5f11d53f0c441121ab6d026906aed478df6b7ae2","52c3415908beaba03966d2da45604dea48e71604c3160ceeebf9a1595b144f8a","f9f4e3e0030a97efeffd61373387b68a234a31ad8bcdaa1dc8b3a0f405856341"],"paragraph_range_zero_based":[26040,26063],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p26040"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26064},{"literal_text_all_w_t_and_m_t":"PeriodicalReportConfig field descriptions","paragraph_zero_based":26065},{"literal_text_all_w_t_and_m_t":"coarseLocationRequest","paragraph_zero_based":26066},{"literal_text_all_w_t_and_m_t":"This field is used to request UE to report coarse location information.","paragraph_zero_based":26067},{"literal_text_all_w_t_and_m_t":"maxNrofRS-IndexesToReport","paragraph_zero_based":26068},{"literal_text_all_w_t_and_m_t":"Max number of RS indexes to include in the measurement report.","paragraph_zero_based":26069},{"literal_text_all_w_t_and_m_t":"maxReportCells","paragraph_zero_based":26070},{"literal_text_all_w_t_and_m_t":"Max number of non-serving cells to include in the measurement report.","paragraph_zero_based":26071},{"literal_text_all_w_t_and_m_t":"reportAddNeighMeas","paragraph_zero_based":26072},{"literal_text_all_w_t_and_m_t":"Indicates that the UE shall include the best neighbour cells per serving frequency.","paragraph_zero_based":26073},{"literal_text_all_w_t_and_m_t":"reportAmount","paragraph_zero_based":26074},{"literal_text_all_w_t_and_m_t":"Number of measurement reports applicable for eventTriggered as well as for periodical report types","paragraph_zero_based":26075},{"literal_text_all_w_t_and_m_t":"reportQuantityCell","paragraph_zero_based":26076},{"literal_text_all_w_t_and_m_t":"The cell measurement quantities to be included in the measurement report.","paragraph_zero_based":26077},{"literal_text_all_w_t_and_m_t":"reportQuantityRS-Indexes","paragraph_zero_based":26078},{"literal_text_all_w_t_and_m_t":"Indicates which measurement information per RS index the UE shall include in the measurement report.","paragraph_zero_based":26079},{"literal_text_all_w_t_and_m_t":"ul-DelayValueConfig","paragraph_zero_based":26080},{"literal_text_all_w_t_and_m_t":"If the field is present, the UE shall perform the actual UL PDCP Packet Average Delay measurement per DRB as specified in TS 38.314 [53] and the UE shall ignore the fields reportQuantityCell and maxReportCells. The applicable values for the corresponding reportInterval are (one of the) {ms120, ms240, ms480, ms640, ms1024, ms2048, ms5120, ms10240, ms20480, ms40960, min1,min6, min12, min30}. The reportInterval indicates the periodicity for performing and reporting of UL PDCP Packet Average Delay per DRB measurement as specified in TS 38.314 [53].","paragraph_zero_based":26081},{"literal_text_all_w_t_and_m_t":"ul-ExcessDelayConfig","paragraph_zero_based":26082},{"literal_text_all_w_t_and_m_t":"If the field is present, the UE shall perform the actual UL PDCP Excess Packet Delay per DRB measurement as specified in TS 38.314 [53] and the UE shall ignore the fields reportQuantityCell and maxReportCells. The applicable values for the corresponding reportInterval are (one of the) {ms120, ms240, ms480, ms640, ms1024, ms2048, ms5120, ms10240, ms20480, ms40960, min1,min6, min12, min30}. The reportInterval indicates the periodicity for performing and reporting of UL PDCP Excess Packet Delay per DRB measurement as specified in TS 38.314 [53].","paragraph_zero_based":26083},{"literal_text_all_w_t_and_m_t":"useAllowedCellList","paragraph_zero_based":26084},{"literal_text_all_w_t_and_m_t":"Indicates whether only the cells included in the allow-list of the associated measObject are applicable as specified in 5.5.4.1.","paragraph_zero_based":26085},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26086},{"literal_text_all_w_t_and_m_t":"ReportSFTD-NR field descriptions","paragraph_zero_based":26087}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["224fec0e33613bf7e2459b60ecb030f6c3955ddbd96aa58aaad253ff6e4481ab","42c8271c4abd5357a26779e2d9acc52b0262f0f343053ceb5e4bbcd9abcfdd88","196abd46a9d79f81d11b4e6cd3d31daf39cabee27922cd6edfeedad198d8a359","02673c27620df8a814a2d179779a3f76f458282be8aa2e8122ffe36160285e57","c3baf88d4150013b5e18261d6832ffb95bbf7e764bfc3c8e5deb7caff7c88daa","52a758cc45b3882830fa5eb29d0e2b2e4fdc527ccdd533fe15b7934891e109ea","8b6726341194d7f271c98f74b0931a882ed71d34ea651ba59f3551a31d717997","81be8df39528bff65213796b22b56f90a793dd2b45344f33176d76803425923d","45db1287049e09337ff7c5cd49ffd88fb86bca34eb8f234c50079f005a0035c2","e3cd597d9c750b41f2fecea37e77ebd67be97ccb054bef111fe684c138ea21fb","835bb23dd0657b6a0ce1ccc50e879fd6f6f4e7cf7df969e90bc17c932ca2c7ee","76bb73c45d81cf888e19e4eb11f0da9e29869aaaa326492c437b010cb130147e","a321fc6b112383db0ad1bd8111873f9be8108ff5f3dd67d7b9bde37ce1b8b1cf","e0239ce4d670b1bda3ebdce053ed77de6535b1ad0b58cdfb07d9fd22fc2c38d1","4a5071dd0a78d7aee5dc2a6a9b670d8a6024f51a7a451b22920c7edefcd7aeae","ce96b4f01cfbfd1ce56f7a30a295a0032c5c3fd1781e2184aabb9c8f218d99b0","c9160eae0641f86a4b0b64e6d687fc7dd30c73f6781d01528fb5628be574f556","55abae886d3a7989186e6c3c335033baea3985e10a3205427ff5d166d8c3440e","c7557d17408808a814d12c5f4c2da08c8b8f5f83277b7d778526a0bae50b966f","6f213727f2884bf23429c67c0d0c7d9ea1ceab4514da49b72c00def2b585226d","77db80444a9e7848b15bc5c47b86ac39311ec62cf849a8837923c0dbecc52b73","58fdeb084e91e543db61e3cdded647849c952e1038244b51448d8d47072b9fea","5ae15a5ea14df4dec173c59348a2e3b5c8eea0fd04447dabb8e0fb3f843b480e","fa3c8188c85301e8f928f547aca6daf9ab90679cf7344948ef7ca901134e549c"],"paragraph_range_zero_based":[26064,26087],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p26064"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"cellForWhichToReportSFTD","paragraph_zero_based":26088},{"literal_text_all_w_t_and_m_t":"Indicates the target NR neighbour cells for SFTD measurement between PCell and NR neighbour cells.","paragraph_zero_based":26089},{"literal_text_all_w_t_and_m_t":"drx-SFTD-NeighMeas","paragraph_zero_based":26090},{"literal_text_all_w_t_and_m_t":"Indicates that the UE shall use available idle periods (i.e. DRX off periods) for the SFTD measurement in NR standalone. The network only includes drx-SFTD-NeighMeas field when reprtSFTD-NeighMeas is set to true.","paragraph_zero_based":26091},{"literal_text_all_w_t_and_m_t":"reportSFTD-Meas","paragraph_zero_based":26092},{"literal_text_all_w_t_and_m_t":"Indicates whether UE is required to perform SFTD measurement between PCell and NR PSCell in NR-DC.","paragraph_zero_based":26093},{"literal_text_all_w_t_and_m_t":"reportSFTD-NeighMeas","paragraph_zero_based":26094},{"literal_text_all_w_t_and_m_t":"Indicates whether UE is required to perform SFTD measurement between PCell and NR neighbour cells in NR standalone. The network does not include this field if reportSFTD-Meas is set to true.","paragraph_zero_based":26095},{"literal_text_all_w_t_and_m_t":"reportRSRP","paragraph_zero_based":26096},{"literal_text_all_w_t_and_m_t":"Indicates whether UE is required to include RSRP result of NR PSCell or NR neighbour cells in SFTD measurement result, derived based on SSB. If it is set to true, the network should ensure that ssb-ConfigMobility is included in the measurement object for NR PSCell or NR neighbour cells.","paragraph_zero_based":26097},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26098},{"literal_text_all_w_t_and_m_t":"RxTxPeriodical field descriptions","paragraph_zero_based":26099},{"literal_text_all_w_t_and_m_t":"reportAmount","paragraph_zero_based":26100},{"literal_text_all_w_t_and_m_t":"This field indicates the number of UE Rx-Tx time difference measurement reports. If configured to r1, the network does not configure rxTxReportInterval and only one measurement is reported. If configured to infinity, UE periodically reports measurements according to the periodicity configured by rxTxReportInterval.","paragraph_zero_based":26101},{"literal_text_all_w_t_and_m_t":"rxTxReportInterval","paragraph_zero_based":26102},{"literal_text_all_w_t_and_m_t":"This field indicates the measurement reporting periodicity of UE Rx-Tx time difference.","paragraph_zero_based":26103},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26104},{"literal_text_all_w_t_and_m_t":"other field descriptions","paragraph_zero_based":26105},{"literal_text_all_w_t_and_m_t":"MeasTriggerQuantity","paragraph_zero_based":26106},{"literal_text_all_w_t_and_m_t":"SINR is applicable only for CONNECTED mode events.","paragraph_zero_based":26107},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26108},{"literal_text_all_w_t_and_m_t":"–ReportConfigNR-SL","paragraph_zero_based":26109},{"literal_text_all_w_t_and_m_t":"The IE ReportConfigNR-SL specifies criteria for triggering of a CBR measurement reporting event for NR sidelink communication/discovery. Measurement reporting events are based on CBR measurement results on the corresponding transmission resource pools. These events are labelled CN with N equal to 1 and 2.","paragraph_zero_based":26110},{"literal_text_all_w_t_and_m_t":"Event C1:CBR of NR sidelink communication/discovery is above a threshold;","paragraph_zero_based":26111}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_X