7563bb","fcf7f27bfb3a01217ffc40750150ecd54967ab79fd95049f4278e0a28c21f220","9187befad42c1a7fb06e7b95a3231e7146d2b7393387db541b63ec8bd9d5886a","0b195b82c7cfffdafab3d661962dff237a4d9790cfa877a6bbd8c48139ff7d2e","d23727797768a0ef9c829e93760de0e7ec46fa744c1be4220ba6c809b22be25b","4053b9e1dce563841812cbb64552bcc2fb8e3c8fbb5619dc5a60c4c68fb1232d","03254cd5efa0dc598ade0f7c251117161849efb57060894b2807a1181a41e400","b61056eb18357b107806ae22c060de6bb4aceae296e7e01cd1f8c39078195165","de8368178d6d7305931299528a35784671579c5a6c233408b5beef2e49b3fbcf","243535ce35806bf9c20477a776f0ef8174ca8f5646ba1c386cc473da6e9987e7","ce2bd65ac5693adcd0678023e356cef5cba5a121a2be92ce894bdf8058de86db"],"paragraph_range_zero_based":[13704,13727],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p13704"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"applicableDisasterInfoList","paragraph_zero_based":13728},{"literal_text_all_w_t_and_m_t":"A list indicating the applicable disaster roaming information for the networks indicated in plmn-IdentityInfoList and npn-IdentityInfoList-r16. The network indicates in this list one entry for each entry of plmn-IdentityInfoList, followed by one entry for each entry of npn-IdentityInfoList-r16, meaning that this list will have as many entries as the number of entries of the combination of plmn-IdentityInfoList and npn-IdentityInfoList-r16. The first entry in this list indicates the disaster roaming information applicable for the network(s) in the first entry of plmn-IdentityInfoList/npn-IdentityInfoList-r16, the second entry in this list indicates the disaster roaming information applicable for the network(s) in the second entry of plmn-IdentityInfoList/npn-IdentityInfoList-r16, and so on. Each entry in this list can either be having the value noDisasterRoaming, disasterRelatedIndication, commonPLMNs, or dedicatedPLMNs. If an entry in this list takes the value noDisasterRoaming, disaster inbound roaming is not allowed in this network(s). If an entry in this list takes the value disasterRelatedIndication, the meaning of this field for this network(s) is as specified for \"disaster related indication\" in TS 23.122 [74], clause 4.4.3.1.1. If an entry in this list takes the value commonPLMNs, the PLMN(s) with disaster conditions indicated in the field commonPLMNsWithDisasterCondition apply for this network(s). If an entry in this list contains the value dedicatedPLMNs, the listed PLMN(s) are the PLMN(s) with disaster conditions that the network(s) corresponding to this entry accepts disaster inbound roamers from. For SNPNs, the network indicates the value noDisasterRoaming.","paragraph_zero_based":13729},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13730},{"literal_text_all_w_t_and_m_t":"–SIB16","paragraph_zero_based":13731},{"literal_text_all_w_t_and_m_t":"SIB16 contains configurations of slice-based cell reselection information.","paragraph_zero_based":13732},{"literal_text_all_w_t_and_m_t":"SIB16 information element","paragraph_zero_based":13733},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":13734},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB16-START","paragraph_zero_based":13735},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13736},{"literal_text_all_w_t_and_m_t":"SIB16-r17 ::=                    SEQUENCE {","paragraph_zero_based":13737},{"literal_text_all_w_t_and_m_t":"    freqPriorityListSlicing-r17      FreqPriorityListSlicing-r17              OPTIONAL,  -- Need R","paragraph_zero_based":13738},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension         OCTET STRING                             OPTIONAL,","paragraph_zero_based":13739},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":13740},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":13741},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13742},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB16-STOP","paragraph_zero_based":13743},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":13744},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13745},{"literal_text_all_w_t_and_m_t":"SIB16 field descriptions","paragraph_zero_based":13746},{"literal_text_all_w_t_and_m_t":"freqPriorityListSlicing","paragraph_zero_based":13747},{"literal_text_all_w_t_and_m_t":"This field indicates cell reselection priorities for slicing.","paragraph_zero_based":13748},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13749},{"literal_text_all_w_t_and_m_t":"–SIB17","paragraph_zero_based":13750},{"literal_text_all_w_t_and_m_t":"SIB17 contains configurations of TRS resources for idle/inactive UEs.","paragraph_zero_based":13751}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["18709607005856f019e35f2ebaf7974d1bef7650c669499712d3cdc454c1dfed","5fe65af0f5c48dd852e4917c02d55bdbb826d44567b092b394c96c2fadf8bd83","456b8041a3caa209944d3624ec07c06c8c638f627ad2f68b32ee5f4e6abda14f","2cd45bb997cdec007e9fcbafe84b00e56cff4191515ffe112dd7932958fe451a","4c5af5e6621b990f1e7c663f6f2f1bc28c4850829a36f8bdba78437cbf91bc4a","2046f471035d7e4da309cfcd17200835c7579f738438cbeda02d9f0dbb9fe319","3f94eb98f7c7602d6dc1563b6ec5033c4a0057d543ef023976736339378137ca","df3b54d688ae94c733163050259be4965892e016b375980c32b06ba874c658b3","c24a6c36f16d24b98e71ded574756c4d2806d3a10303527a9e9888d19a6f47e2","b0ad2268eab28e8f3d2bb6297dce7c0be2b39667873d5141acf5c6695323a32b","41bd7976a10f0f7a1262b6c4391cd3e0dddace768d0eea3b1959d7d97ddfa37d","89d6d36a29cdac8c83d6d04e7e879f6ea3342a6eab9abe54a29a347e5720b012","b027a606a3171c22aaa8429671d09c97fac945a63ec48dab3ffd8b1ce638fff1","898a4d1e03c0ad2a2e06fc5a08a62c26b7044fc2eb5d31c359d19677df8768da","f38472c90ee2b090f363ea45eb3d561cfef31d2e2d6846f420ef43c993a4a99d","ab39f47928872a4f8446e4a7f5556747f22af235ac54d9795980019106e4b1f0","b3e771c49fc679278bd340e9d48a3b3efe9d085141e23443b070d4d7e8aaeb51","b986063f6d7c765617d6e6662783d0a6871772b3d17ffdde363821643a41535a","d65da1b2bce4e76e343864a0fbb2c354fee3ff07bdf4561236110a21d9fb295f","42dd454393a3045890078dadac7473beb6236a529eabbf0394d62d67b55bb64d","ee7a57ede2be521733053e649b5e0f4fecf6b24ab9f153411e1c687ce0762356","7a9e16101b9f18d88ccf4c7cd229b916e45f637b76d1499c2551ca99eadd09ff","4c6238af37e6f417ccda3062117f9d420d908b0c0796d03598ab322dcf92f6ef","48402bf364c9ec59528cf8904e436696ef04dfe180bae3f61050c84226697bce"],