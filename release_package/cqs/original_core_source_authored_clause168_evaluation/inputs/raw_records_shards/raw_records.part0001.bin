{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-RATEMATCHPATTERNID-START","paragraph_zero_based":25344},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25345},{"literal_text_all_w_t_and_m_t":"RateMatchPatternId ::=              INTEGER (0..maxNrofRateMatchPatterns-1)","paragraph_zero_based":25346},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25347},{"literal_text_all_w_t_and_m_t":"-- TAG-RATEMATCHPATTERNID-STOP","paragraph_zero_based":25348},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":25349},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25350},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25351},{"literal_text_all_w_t_and_m_t":"–RateMatchPatternLTE-CRS","paragraph_zero_based":25352},{"literal_text_all_w_t_and_m_t":"The IE RateMatchPatternLTE-CRS is used to configure a pattern to rate match around LTE CRS. See TS 38.214 [19], clause 5.1.4.2.","paragraph_zero_based":25353},{"literal_text_all_w_t_and_m_t":"RateMatchPatternLTE-CRS information element","paragraph_zero_based":25354},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25355},{"literal_text_all_w_t_and_m_t":"-- TAG-RATEMATCHPATTERNLTE-CRS-START","paragraph_zero_based":25356},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25357},{"literal_text_all_w_t_and_m_t":"RateMatchPatternLTE-CRS ::=         SEQUENCE {","paragraph_zero_based":25358},{"literal_text_all_w_t_and_m_t":"    carrierFreqDL                       INTEGER (0..16383),","paragraph_zero_based":25359},{"literal_text_all_w_t_and_m_t":"    carrierBandwidthDL                  ENUMERATED {n6, n15, n25, n50, n75, n100, spare2, spare1},","paragraph_zero_based":25360},{"literal_text_all_w_t_and_m_t":"    mbsfn-SubframeConfigList            EUTRA-MBSFN-SubframeConfigList                                          OPTIONAL,   -- Need M","paragraph_zero_based":25361},{"literal_text_all_w_t_and_m_t":"    nrofCRS-Ports                       ENUMERATED {n1, n2, n4},","paragraph_zero_based":25362},{"literal_text_all_w_t_and_m_t":"    v-Shift                             ENUMERATED {n0, n1, n2, n3, n4, n5}","paragraph_zero_based":25363},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25364},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25365},{"literal_text_all_w_t_and_m_t":"LTE-CRS-PatternList-r16 ::=         SEQUENCE (SIZE (1..maxLTE-CRS-Patterns-r16)) OF RateMatchPatternLTE-CRS","paragraph_zero_based":25366},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25367}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["99f6625b8667b24eca97300430f0c71bdec3a5a1505b30b687427381555ab9d1","dce36943ee08868ebb0cf5fbd4d7e030f5efe83bb0020cf762b9d237de186318","00b47ad0c1840292ff376456ad7bbc53d3c4c8b7adfdb573e700bf0afadaad6e","5ced5b0dcc73d94ec432a1e0a5e5a655b4019c9ba592658d5a1a26c830cfcbf2","e4006d2428f2337c397740421619128eb95505920fbe1b9333ec0770886e5a22","3f6d48384c70a156a5c55b55fae31b2f20fa072f8b480246f99fa04f709e51aa","fad8c3fd539f1a4b401efad37af1ad9ab25207d86ed243528979111ee19eb3f2","1defd4d677c92dbd0e06879a4c75f72cd311c0d23f0a4f133736edabf39eb1cc","c803a1e61c93acd5e51e65cd677d88afb8856609303d005a97264b14b3961501","20181371f8b0eb54792a65bcfd9c13de7fa0a9ed935fde78be1657ffe01ad150","33ff686a1d0fb2023e31aa504f4d34e0ca80ef1ab87caa5577e05a4ec427d8cc","7165e795b2a403bf70331dc62eb5b7132218e5264b667fcd7f6b04cf28ab9e57","fa2071e991c034c1335bdc875271435849fb55cf28f268bc1c454668f4561d90","9db6db61b9a6013a855a554046438a53e5a7f95b2837c71426c3f051abd8f831","8f96e