{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15576},{"literal_text_all_w_t_and_m_t":"–CellIdentity","paragraph_zero_based":15577},{"literal_text_all_w_t_and_m_t":"The IE CellIdentity is used to unambiguously identify a cell within a PLMN/SNPN.","paragraph_zero_based":15578},{"literal_text_all_w_t_and_m_t":"CellIdentity information element","paragraph_zero_based":15579},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":15580},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLIDENTITY-START","paragraph_zero_based":15581},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15582},{"literal_text_all_w_t_and_m_t":"CellIdentity ::=                         BIT STRING (SIZE (36))","paragraph_zero_based":15583},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15584},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLIDENTITY-STOP","paragraph_zero_based":15585},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":15586},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15587},{"literal_text_all_w_t_and_m_t":"–CellReselectionPriority","paragraph_zero_based":15588},{"literal_text_all_w_t_and_m_t":"The IE CellReselectionPriority concerns the absolute priority of the concerned carrier frequency, as used by the cell reselection procedure. Corresponds to parameter \"priority\" in TS 38.304 [20]. Value 0 means lowest priority. The UE behaviour for the case the field is absent, if applicable, is specified in TS 38.304 [20].","paragraph_zero_based":15589},{"literal_text_all_w_t_and_m_t":"CellReselectionPriority information element","paragraph_zero_based":15590},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":15591},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLRESELECTIONPRIORITY-START","paragraph_zero_based":15592},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15593},{"literal_text_all_w_t_and_m_t":"CellReselectionPriority ::=             INTEGER (0..7)","paragraph_zero_based":15594},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15595},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLRESELECTIONPRIORITY-STOP","paragraph_zero_based":15596},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":15597},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15598},{"literal_text_all_w_t_and_m_t":"–CellReselectionSubPriority","paragraph_zero_based":15599}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["c380da086933b0572efb90238b5edff1f6880a491e26f6036b3bbdee763c9aa1","e2b7b78bb221002e14ec10ccdc002a9ef6e57c4cb265e41c58f8222a37885fd5","6be6a291f602ae20837daa709b29577a32d37a12b588357cfe645049898e5bf2","e6043a3f6ce50b8803bc4edc22191be549f1c8e8306a91be2b73ae280fca111b","5f3e754d24554c016c3b18e2e0f40c74b5d0ba972e589eb23e8411616bff92c5","afb7fd2044cde71ae79506f652342cb568d739e3cd82ccca9a58e89949a5cb1d","80bb90e1d483d7131c3e56f7f7f7cc12973a55b6e71cdd38aefd3da72ff4f7b5","8df3868a44e691262b05972f2f17753f38c0bb470c274d9e9946bfaec997fb0c","d00e87308c2a7bd02751d256ba197ec8fcec9b6e7b265029d2cea5112e494348","ceb1b8a17dded9b5ce89dc6e9696d4d7cdbfe56f1ecbffdc85af722807409b6b","8f6131400011d4338fc925e345afdfa54c13c4e83cff0c72f5bbe28044546617","8c0d1570fff1055d9ae5adc90bd46ee64a65227be71a590e35d137d6e2afa330","1647622f90ec61eadf67266938d18cd07aa73f334b404b235fd395e878e413bb","55af00c4fcec94cee675c330b87881167d8db8f7fa448174835c6a739690c8f4","31e287a65310eeac30e1d52962195ece66195abcf3e483ef5f24aa475fc9eb98","ea6ddf40dd56ad0803b2f2bece9d6536ee9f64b3f4a4d294e28edf12c01043e2","2238a3c3b0661a2