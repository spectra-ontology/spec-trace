{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":17472},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":17473},{"literal_text_all_w_t_and_m_t":"    csi-ReportSubConfigTriggerList-r18             CSI-ReportSubConfigTriggerList-r18                         OPTIONAL   -- Need R","paragraph_zero_based":17474},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":17475},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":17476},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17477},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-SEMIPERSISTENTONPUSCHTRIGGERSTATELIST-STOP","paragraph_zero_based":17478},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17479},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17480},{"literal_text_all_w_t_and_m_t":"CSI-SemiPersistentOnPUSCH-TriggerStateList field descriptions","paragraph_zero_based":17481},{"literal_text_all_w_t_and_m_t":"csi-ReportSubConfigTriggerList","paragraph_zero_based":17482},{"literal_text_all_w_t_and_m_t":"A list of sub-configuration ID(s) of N sub-configurations out of L configured sub-configurations within a CSI-ReportConfig associated with a triggering state for semi-persistent CSI reporting on PUSCH.","paragraph_zero_based":17483},{"literal_text_all_w_t_and_m_t":"sp-CSI-MultiplexingMode","paragraph_zero_based":17484},{"literal_text_all_w_t_and_m_t":"Indicates if the behavior of transmitting SP-CSI on the first PUSCH repetitions corresponding to two SRS resource sets configured in srs-ResourceSetToAddModList or srs-ResourceSetToAddModListDCI-0-2 with usage 'codebook' or 'noncodebook' is enabled or not.","paragraph_zero_based":17485},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17486},{"literal_text_all_w_t_and_m_t":"–CSI-SSB-ResourceSet","paragraph_zero_based":17487},{"literal_text_all_w_t_and_m_t":"The IE CSI-SSB-ResourceSet is used to configure one SS/PBCH block resource set which refers to SS/PBCH as indicated in ServingCellConfigCommon and ServingCellConfig.","paragraph_zero_based":17488},{"literal_text_all_w_t_and_m_t":"CSI-SSB-ResourceSet information element","paragraph_zero_based":17489},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17490},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-SSB-RESOURCESET-START","paragraph_zero_based":17491},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17492},{"literal_text_all_w_t_and_m_t":"CSI-SSB-ResourceSet ::=             SEQUENCE {","paragraph_zero_based":17493},{"literal_text_all_w_t_and_m_t":"    csi-SSB-ResourceSetId               CSI-SSB-ResourceSetId,","paragraph_zero_based":17494},{"literal_text_all_w_t_and_m_t":"    csi-SSB-ResourceList                SEQUENCE (SIZE(1..maxNrofCSI-SSB-ResourcePerSet)) OF SSB-Index,","paragraph_zero_based":17495}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["65b25c33f644bc18b8d72b21e77323613f250463d61260648f1b1767632b90f2","74973a130e2670d793d04d7e6d41a0ea2de03d5b5c2028f557ebaec986d073cb","951175ea558863ead3516c461e3d530e007cf74aa792bc18eb0f96cd977b7695","a0ef0b613c5530807e44d0b5e76a812b71a63a0b5e0dbed3cf87ef7b38caa058","a33b0ac41d6f8950dc29a241e9175f99acb5311961f8e70a3900a4a34c59f252","371ccf3967db7cafb762f4cdcc847ec56ecf1361c9b85eca1fdfb11079e9720f","c25dde3a4fdde37475c5466ae445c1092fc5546ffe601a2a86360cc88683201a","4a3d783540bbfb129f4c48c5cbc2aacc6262cecf2f5053a32d160b07bf6f05e2","39e88635cb4e4e014301a3c905fc927160fab157f36f3ba09bb3fcc44ddedd11","0462ef90be07427d3a166ab7fffc88d470f2673782b4d9a4