{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Direction: Network to UE","paragraph_zero_based":12144},{"literal_text_all_w_t_and_m_t":"UECapabilityEnquiry message","paragraph_zero_based":12145},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":12146},{"literal_text_all_w_t_and_m_t":"-- TAG-UECAPABILITYENQUIRY-START","paragraph_zero_based":12147},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12148},{"literal_text_all_w_t_and_m_t":"UECapabilityEnquiry ::=             SEQUENCE {","paragraph_zero_based":12149},{"literal_text_all_w_t_and_m_t":"    rrc-TransactionIdentifier           RRC-TransactionIdentifier,","paragraph_zero_based":12150},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                  CHOICE {","paragraph_zero_based":12151},{"literal_text_all_w_t_and_m_t":"        ueCapabilityEnquiry                 UECapabilityEnquiry-IEs,","paragraph_zero_based":12152},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture            SEQUENCE {}","paragraph_zero_based":12153},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":12154},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":12155},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12156},{"literal_text_all_w_t_and_m_t":"UECapabilityEnquiry-IEs ::=         SEQUENCE {","paragraph_zero_based":12157},{"literal_text_all_w_t_and_m_t":"    ue-CapabilityRAT-RequestList        UE-CapabilityRAT-RequestList,","paragraph_zero_based":12158},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension            OCTET STRING                                                            OPTIONAL,","paragraph_zero_based":12159},{"literal_text_all_w_t_and_m_t":"    ue-CapabilityEnquiryExt             OCTET STRING (CONTAINING UECapabilityEnquiry-v1560-IEs)                 OPTIONAL --  Need N","paragraph_ze