{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"PUSCH-TimeDomainResourceAllocation ::=  SEQUENCE {","paragraph_zero_based":24552},{"literal_text_all_w_t_and_m_t":"    k2                                      INTEGER(0..32)                                  OPTIONAL,   -- Need S","paragraph_zero_based":24553},{"literal_text_all_w_t_and_m_t":"    mappingType                             ENUMERATED {typeA, typeB},","paragraph_zero_based":24554},{"literal_text_all_w_t_and_m_t":"    startSymbolAndLength                    INTEGER (0..127)","paragraph_zero_based":24555},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":24556},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24557},{"literal_text_all_w_t_and_m_t":"PUSCH-TimeDomainResourceAllocationList-r16 ::=  SEQUENCE (SIZE(1..maxNrofUL-Allocations-r16)) OF PUSCH-TimeDomainResourceAllocation-r16","paragraph_zero_based":24558},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24559},{"literal_text_all_w_t_and_m_t":"PUSCH-TimeDomainResourceAllocation-r16 ::=  SEQUENCE {","paragraph_zero_based":24560},{"literal_text_all_w_t_and_m_t":"    k2-r16                                     INTEGER(0..32)          OPTIONAL,   -- Need S","paragraph_zero_based":24561},{"literal_text_all_w_t_and_m_t":"    puschAllocationList-r16                    SEQUENCE (SIZE(1..maxNrofMultiplePUSCHs-r16)) OF PUSCH-Allocation-r16,","paragraph_zero_based":24562},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":24563},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":24564},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24565},{"literal_text_all_w_t_and_m_t":"PUSCH-Allocation-r16 ::=  SEQUENCE {","paragraph_zero_based":24566},{"literal_text_all_w_t_and_m_t":"    mappingType-r16                           ENUMERATED {typeA, typeB}                     OPTIONAL,   -- Cond NotFormat01-02-Or-TypeA","paragraph_zero_based":24567},{"literal_text_all_w_t_and_m_t":"    startSymbolAndLength-r16                  INTEGER (0..127)                              OPTIONAL,   -- Cond NotFormat01-02-Or-TypeA","paragraph_zero_based":24568},{"literal_text_all_w_t_and_m_t":"    startSymbol-r16                           INTEGER (0..13)                               OPTIONAL,   -- Cond RepTypeB","paragraph_zero_based":24569},{"literal_text_all_w_t_and_m_t":"    length-r16                                INTEGER (1..14)                               OPTIONAL,   -- Cond RepTypeB","paragraph_zero_based":24570},{"literal_text_all_w_t_and_m_t":"    numberOfRepetitions-r16                   ENUMERATED {n1, n2, n3, n4, n7, n8, n12, n16} OPTIONAL,   -- Cond Format01-02","paragraph_zero_based":24571},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":24572},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":24573},{"literal_text_all_w_t_and_m_t":"    numberOfRepetitionsExt-r17                ENUMERATED {n1, n2, n3, n4, n7, n8, n12, n16, n20, n24, n28, n32, spare4, spare3, spare2,","paragraph_zero_based":24574},{"literal_text_all_w_t_and_m_t":"                                                          spare1}                           OPTIONAL,   -- Cond Format01-02-For-TypeA","paragraph_zero_based":24575}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["6d55cf9d616f45e9904d23dda1ca5a4535ef5f33a3a6c9d6977570055034d035","461afa22725716bfa87cc8d047b07ad1d0708fa73e255e16bdcdc4d5e5a98715","54a42498642c71b29155c02467d093fb54564cabe7965b2ca410251c3fb929a1","b7b31d208e64c11483070c6e8c69d9f91d0a8009518ca892c9523d1e0cf68653","1f5bf60f2a