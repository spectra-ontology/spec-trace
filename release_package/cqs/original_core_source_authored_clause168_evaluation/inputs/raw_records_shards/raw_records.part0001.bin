{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The index of the RLC bearer configuration.","paragraph_zero_based":39360},{"literal_text_all_w_t_and_m_t":"sl-RLC-Config","paragraph_zero_based":39361},{"literal_text_all_w_t_and_m_t":"Determines the RLC mode (UM, AM) and provides corresponding parameters.","paragraph_zero_based":39362},{"literal_text_all_w_t_and_m_t":"sl-ServedRadioBearer","paragraph_zero_based":39363},{"literal_text_all_w_t_and_m_t":"Associates the sidelink RLC Bearer with a sidelink DRB. It indicates the index of SL radio bearer configuration, which is corresponding to the RLC bearer configuration.","paragraph_zero_based":39364},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39365},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":39366},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":39367},{"literal_text_all_w_t_and_m_t":"LCH-Setup","paragraph_zero_based":39368},{"literal_text_all_w_t_and_m_t":"The field is mandatory present upon creation of a new sidelink logical channel via the dedicated signalling and in case of sidelink DRB configuration via system information and pre-configuration; otherwise the field is optionally present, Need M.","paragraph_zero_based":39369},{"literal_text_all_w_t_and_m_t":"LCH-SetupOnly","paragraph_zero_based":39370},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new sidelink logical channel via the dedicated signalling and in case of sidelink DRB configuration via system information and pre-configuration. Otherwise, it is absent, Need M.","paragraph_zero_based":39371},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39372},{"literal_text_all_w_t_and_m_t":"–SL-RLC-BearerConfigIndex","paragraph_zero_based":39373},{"literal_text_all_w_t_and_m_t":"The IE SL-RLC-BearerConfigIndex is used to identify a SL RLC bearer configuration.","paragraph_zero_based":39374},{"literal_text_all_w_t_and_m_t":"SL-RLC-BearerConfigIndex information element","paragraph_zero_based":39375},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39376},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RLC-BEARERCONFIGINDEX-START","paragraph_zero_based":39377},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39378},{"literal_text_all_w_t_and_m_t":"SL-RLC-BearerConfigIndex-r16 ::=                    INTEGER (1..maxSL-LCID-r16)","paragraph_zero_based":39379},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39380},{"literal_text_all_w_t_and_m_t":"-- TAG-RLC-BEARERCONFIGINDEX-STOP","paragraph_zero_based":39381},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39382},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39383}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["7d649f85c44d7d6c4e05422cf844437f85ddd3f52ef319a6f7793393b616367c","946f0a5e9bbfc2d27b7796b80f1e45a3c9c89e62f2b9665e38692d1780ee725b","975a04e347d70f55ad1e4608d7387307e508c13e4475cad6bec5e4c393cc429e","59662f7a144f33a38056c05caabd123872271769d8542f2db06545ef37f5efc9","5a0cdfa9f87481cd12af6b81c5089c0db210d99335120e9065e49c7f11cf34fd","da9383dd4d4f8f631157404b231db894236618c978b5e5874b2998b177437c84","f4b0d1d62cd7a57fee972994978b3ec30310ab1569363be7961c07c14ec3fff6","e633c03def9b68a4167900567b46b6ce2c7c497bec8ab726e9b66bb37e486932","d6013d74366564e981867801ccd6b4f799656a2173a377353f946e34eaf1fcee","69f8edd4bef224691adc2d69d6d5a8e2c9aa448c25966b3ac43b998e12eeb945","12e2e6aef78700ff9d7b07ba315c3579b8d22c55b52e3b5501879a68f5ce7724","f74d1cefd101d561b0ddf1a