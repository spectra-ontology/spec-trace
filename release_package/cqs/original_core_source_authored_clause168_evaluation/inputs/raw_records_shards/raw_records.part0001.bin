  selectedPLMN-Identity                   INTEGER (1..maxPLMN)                                                    OPTIONAL,","paragraph_zero_based":10794},{"literal_text_all_w_t_and_m_t":"    uplinkTxDirectCurrentList               UplinkTxDirectCurrentList                                               OPTIONAL,","paragraph_zero_based":10795},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension                OCTET STRING                                                            OPTIONAL,","paragraph_zero_based":10796},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                    RRCResumeComplete-v1610-IEs                                             OPTIONAL","paragraph_zero_based":10797},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":10798},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10799}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["0a23b1834fbf9d40a34bac66be97257162255d78b6808a4762df86cc936eba45","8f463fcd3128d486ea6679fab33841c8ddd03f55c758f5993af1e927be1e59fc","e05b999cf17fc9db1a4421aeb31d4083a38dfbe2f6679e9c9ef1de7d731185b0","23ab69029ba464f1b127c70bca376229b471b68f8c87e764368476fb382635ed","5c1c650335692bedb9588a6c34551d5f696ae29108fd0a096de4fa8194f28efe","0e6908e1c4a714bfe6588046b62562a20ac91723f246c5c29d17c7115fad8da9","5064cfd24051f411d4ef55bfbac871597b36a29aea7ada843c7f5607faeb53e3","ef59132707ecfdb60aa98b5eea3bf97d05b796ce4867dc4db0e723ac765ec930","4ce295c39f5317523e3d0fb36b600d5243ddc5c1802deab1f019a26cb5dba046","fdf20dc6df70852f52a5a8d14981b93eeccd4cc1645e6251402adfb728aacdbf","4d364892b8acfe19c2ace98a9e1624fa6c30530923eeee075b1f7da5837c1abc","4d797ad8545770b5a096cbc8f7f7761cf654e0548ff013f93eee7e