0-PSSCH-PSCCH-r16      INTEGER (-16..15)                                                                  OPTIONAL,   -- Need S","paragraph_zero_based":38752},{"literal_text_all_w_t_and_m_t":"    dl-P0-PSSCH-PSCCH-r16      INTEGER (-16..15)                                                                  OPTIONAL,   -- Need M","paragraph_zero_based":38753},{"literal_text_all_w_t_and_m_t":"    dl-Alpha-PSFCH-r16         ENUMERATED {alpha0, alpha04, alpha05, alpha06, alpha07, alpha08, alpha09, alpha1}  OPTIONAL,   -- Need S","paragraph_zero_based":38754},{"literal_text_all_w_t_and_m_t":"    dl-P0-PSFCH-r16            INTEGER (-16..15)                                                                  OPTIONAL,   -- Need M","paragraph_zero_based":38755},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":38756},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":38757},{"literal_text_all_w_t_and_m_t":"    dl-P0-PSSCH-PSCCH-r17      INTEGER (-202..24)                                                                 OPTIONAL,   -- Need M","paragraph_zero_based":38758},{"literal_text_all_w_t_and_m_t":"    sl-P0-PSSCH-PSCCH-r17      INTEGER (-202..24)                                                                 OPTIONAL,   -- Need S","paragraph_zero_based":38759}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["398a73f34d387adb60f5cc0fbdae91e89fc6974be7711cc0fd006ccf31af9b7c","029da2cdcf5c5edd787c359608fc39b091c715f33481cce3c42e04c79d65752b","68a6b0a8732c8f735dba6fa0e898d33c326ca9dfcba0c96cf47cb87f05e19b1d","db478063c7961cd481a5298b4461c686cc5bf0751761fac221509c633c50614d","eb8c5b53f22abdea44eb5f9ae29ef04933e93c1d57cc13841770c145ee058852","f7f2c9c4