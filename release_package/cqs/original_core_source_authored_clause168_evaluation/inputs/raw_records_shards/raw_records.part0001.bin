{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    nr-Slot-r17          CHOICE {","paragraph_zero_based":12576},{"literal_text_all_w_t_and_m_t":"        scs15-r17            INTEGER (0..9),","paragraph_zero_based":12577},{"literal_text_all_w_t_and_m_t":"        scs30-r17            INTEGER (0..19),","paragraph_zero_based":12578},{"literal_text_all_w_t_and_m_t":"        scs60-r17            INTEGER (0..39),","paragraph_zero_based":12579},{"literal_text_all_w_t_and_m_t":"        scs120-r17           INTEGER (0..79)","paragraph_zero_based":12580},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":12581},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":12582},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":12583},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12584},{"literal_text_all_w_t_and_m_t":"-- TAG-UEPOSITIONINGASSISTANCEINFO-STOP","paragraph_zero_based":12585},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":12586},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12587},{"literal_text_all_w_t_and_m_t":"UEPositioningAssistanceInfo field descriptions","paragraph_zero_based":12588},{"literal_text_all_w_t_and_m_t":"nr-TimeStamp","paragraph_zero_based":12589},{"literal_text_all_w_t_and_m_t":"This field specifies the latest time instance at which the association is valid prior to the reporting.","paragraph_zero_based":12590},{"literal_text_all_w_t_and_m_t":"servCellID","paragraph_zero_based":12591},{"literal_text_all_w_t_and_m_t":"This field indicates the serving cell information of SRS for positioning resources associated to the UE Tx TEG report.","paragraph_zero_based":12592},{"literal_text_all_w_t_and_m_t":"ue-TxTEG-ID","paragraph_zero_based":12593},{"literal_text_all_w_t_and_m_t":"Identifies the ID of UE Tx TEG.","paragraph_zero_ba