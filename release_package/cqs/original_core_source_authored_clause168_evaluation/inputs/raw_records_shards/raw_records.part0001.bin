{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports DL scheduling slot offset (K0) greater than 0 for PDSCH mapping type B in TDD FR1.","paragraph_zero_based":44256},{"literal_text_all_w_t_and_m_t":"dl-SchedulingOffset-PDSCH-TypeB-TDD-FR2","paragraph_zero_based":44257},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports DL scheduling slot offset (K0) greater than 0 for PDSCH mapping type B in TDD FR2.","paragraph_zero_based":44258},{"literal_text_all_w_t_and_m_t":"halfDuplexFDD-TypeA-RedCap","paragraph_zero_based":44259},{"literal_text_all_w_t_and_m_t":"Indicates whether the RedCap UE only supports half-duplex operation for FDD in the indicated band(s).","paragraph_zero_based":44260},{"literal_text_all_w_t_and_m_t":"inactiveStatePO-Determination","paragraph_zero_based":44261},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports to use the same i_s to determine PO in RRC_INACTIVE state as in RRC_IDLE state.","paragraph_zero_based":44262},{"literal_text_all_w_t_and_m_t":"numberOfRxRedCap","paragraph_zero_based":44263},{"literal_text_all_w_t_and_m_t":"Indicates the number of Rx branches supported by a RedCap UE.","paragraph_zero_based":44264},{"literal_text_all_w_t_and_m_t":"ue-RadioPagingInfo","paragraph_zero_based":44265},{"literal_text_all_w_t_and_m_t":"The field is used to transfer UE capability information used for paging. The gNB generates the ue-RadioPagingInfo and the contained UE capability information is absent when not supported by the UE.","paragraph_zero_based":44266},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44267},{"literal_text_all_w_t_and_m_t":"–UERadioAccessCapabilityInformation","paragraph_zero_based":44268},{"literal_text_all_w_t_and_m_t":"This message is used to transfer UE radio access capability information, covering both upload to and download from the 5GC.","paragraph_zero_based":44269},{"literal_text_all_w_t_and_m_t":"Direction: ng-eNB or gNB to/ from 5GC","paragraph_zero_based":44270},{"literal_text_all_w_t_and_m_t":"UERadioAccessCapabilityInformation message","paragraph_zero_based":44271},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":44272},{"literal_text_all_w_t_and_m_t":"-- TAG-UE-RADIO-ACCESS-CAPABILITY-INFORMATION-START","paragraph_zero_based":44273},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44274},{"literal_text_all_w_t_and_m_t":"UERadioAccessCapabilityInformation ::= SEQUENCE {","paragraph_zero_based":44275},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                  CHOICE {","paragraph_zero_based":44276},{"literal_text_all_w_t_and_m_t":"        c1                                  CHOICE{","paragraph_zero_based":44277},{"literal_text_all_w_t_and_m_t":"            ueRadioAccessCapabilityInformation    UERadioAccessCapabilityInformation-IEs,","paragraph_zero_based":44278},{"literal_text_all_w_t_and_m_t":"            spare7 NULL,","paragraph_zero_based":44279}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["55bc34d27a7979cfabb50728f113dda33452cda27f07c88a497778fa944a61d0","9e09b9c848dd1803990248fa99148afb4e9296fd1e33c5f5b8d7d84ae7f0c7ff","a75691caf17f8f5c811b5bec8b488379e41f76cb47f1b945033c5be6875d8534","cab9ad52dc9feff7452d8505cbc5bb974f44339f277a0c961b90334a2ce89bba","7d2fe8a4e405b43bc75578ca8bfc7f89b062606583939e848b2376577a5b089b","27dfb254306811f12465173debfeda967df8ba25651a887db30b421b78871536","756b510f03b6677af5ea704c499db645f57d7c89f2ba3a055d5e7f8b94bd4120","7500cdb92c04c2887e1d865c951d7b8dd63c53982368a8a6152557c586dec55