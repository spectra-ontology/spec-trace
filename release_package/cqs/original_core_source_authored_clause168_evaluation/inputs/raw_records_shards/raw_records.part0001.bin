{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–CSI-SemiPersistentOnPUSCH-TriggerStateList","paragraph_zero_based":17688},{"literal_text_all_w_t_and_m_t":"The CSI-SemiPersistentOnPUSCH-TriggerStateList IE is used to configure the UE with list of trigger states for semi-persistent reporting of channel state information on L1. See also TS 38.214 [19], clause 5.2.","paragraph_zero_based":17689},{"literal_text_all_w_t_and_m_t":"CSI-SemiPersistentOnPUSCH-TriggerStateList information element","paragraph_zero_based":17690},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17691},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-SEMIPERSISTENTONPUSCHTRIGGERSTATELIST-START","paragraph_zero_based":17692},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17693},{"literal_text_all_w_t_and_m_t":"CSI-SemiPersistentOnPUSCH-TriggerStateList ::= SEQUENCE(SIZE (1..maxNrOfSemiPersistentPUSCH-Triggers)) OF CSI-SemiPersistentOnPUSCH-TriggerState","paragraph_zero_based":17694},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17695},{"literal_text_all_w_t_and_m_t":"CSI-SemiPersistentOnPUSCH-TriggerState ::=     SEQUENCE {","paragraph_zero_based":17696},{"literal_text_all_w_t_and_m_t":"    associatedReportConfigInfo                     CSI-ReportConfigId,","paragraph_zero_based":17697},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":17698},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":17699},{"literal_text_all_w_t_and_m_t":"    sp-CSI-MultiplexingMode-r17                ENUMERATED {enabled}                                           OPTIONAL   -- Need R","paragraph_zero_based":17700},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":17701},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":17702},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17703},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-SEMIPERSISTENTONPUSCHTRIGGERSTATELIST-STOP","paragraph_zero_based":17704},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17705},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17706},{"literal_text_all_w_t_and_m_t":"CSI-SemiPersistentOnPUSCH-TriggerStateList field descriptions","paragraph_zero_based":17707},{"literal_text_all_w_t_and_m_t":"sp-CSI-MultiplexingMode","paragraph_zero_based":17708},{"literal_text_all_w_t_and_m_t":"Indicates if the behavior of transmitting SP-CSI on the first PUSCH repetitions corresponding to two SRS resource sets configured in srs-ResourceSetToAddModList or srs-ResourceSetToAddModListDCI-0-2 with usage 'codebook' or 'noncodebook' is enabled or not.","paragraph_zero_based":17709},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17710},{"literal_text_all_w_t_and_m_t":"–CSI-SSB-ResourceSet","paragraph_zero_based":17711}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["92e9def86b2af5e8d9bd0f6eec656a99a94c9a03f26b21a364a91948780a2dc8","874af3a91791c327b5f85b170348ae7b34beb34d558c7f55844345ade64300c4","b448825f84ba06095e2ef7c226f9970d9be1b5328781341ffc6a2ee6419604db","1756b8b5f19d94051e431fb698b2973f97ae012075dcafd695b8a66b1a385feb","033c18683fcf8b1022bf450af33067aaefe8ef07c91d6e8acb4d674ada630620","f75e85b01bc321b0306d28ed7d4b6b2842a3df03d000502b0cfecf92a85e7776","ded905c6b8dd804a0212c5ac95c59402e3e4191feedeccad2b651535f6f14530","ac090213e0023fbe2a0b769af07425494f834bf6a46f0ccbfa01304167291e93","da0139facc9ba63dc46f9c84db6df1ba545f12aed2a4b08d08024426fab38865","1972ca51fdd1c1c823218877b215dbb7f36dbb743509c162df97756811fa2d53","f4e3a00119009f32f53815e1a2aee8