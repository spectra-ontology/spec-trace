{"fields":{"filename":"R2-2401316.zip::R2-2401316 BLE.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":528},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":529},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":530},{"literal_text_all_w_t_and_m_t":"–BT-TargetDeviceErrorCauses","paragraph_zero_based":531},{"literal_text_all_w_t_and_m_t":"The IE BT-TargetDeviceErrorCauses is used by the target device to provide error reasons for Bluetooth positioning to the location server.","paragraph_zero_based":532},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":533},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":534},{"literal_text_all_w_t_and_m_t":"BT-TargetDeviceErrorCauses-r13 ::= SEQUENCE {","paragraph_zero_based":535},{"literal_text_all_w_t_and_m_t":"cause-r13ENUMERATED {undefined,","paragraph_zero_based":536},{"literal_text_all_w_t_and_m_t":"requestedMeasurementsNotAvailable,","paragraph_zero_based":537},{"literal_text_all_w_t_and_m_t":"notAllrequestedMeasurementsPossible,","paragraph_zero_based":538},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":539},{"literal_text_all_w_t_and_m_t":"},","paragraph_zero_based":540},{"literal_text_all_w_t_and_m_t":"bt-Beacon-rssiMeasurementNotPossible-r13NULLOPTIONAL,","paragraph_zero_based":541},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":542},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":543},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":544},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":545},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":546},{"literal_text_all_w_t_and_m_t":"BT-TargetDeviceErrorCauses field descriptions","paragraph_zero_based":547},{"literal_text_all_w_t_and_m_t":"cause","paragraph_zero_based":548},{"literal_text_all_w_t_and_m_t":"This field provides a Bluetooth specific error cause. If the cause value is 'notAllRequestedMeasurementsPossible', the target device was not able to provide all requested Bluetooth measurements (but may be able to provide some measurements). In this case, the target device should include bt-Beacon-rssiMeasurementNotPossible field.","paragraph_zero_based":549},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":550},{"literal_text_all_w_t_and_m_t":"6.5.7.7Bluetooth Assistance Data","paragraph_zero_based":551}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"038bee5e08277a518e210695a9ad796eb7669167fb359201516fcfc3784430d8","original_member_sha256":"e32d7846969fb9d73f3e6db306c1eaae26983884f0f33261ecdad12458f09ea1","paragraph_ElementTree_utf8_XML_sha256":["f42187d5b2c7516b9650317689f4643dcf57250bee322d787f73e550137bccb5","85a089f8a2816c142358ab2b7af357c22e260737f87914ad090075486232227f","e65bff549006331e2c714b43b7d31089f10f4f9a8283a4311aa2643c1f85e517","2597d7bcf1eea1d36a78c8a5b4ceacf60096aa4890cb9766380688a505ed54b9","eadfe447948981345d71976cb41f9a5a63a5423885895cf80cacc72c841d7338","03b2f9726903b23c97ec2311bc15df2238b9b5fcf2bede7f986186a79b188b31","a927742ecc0a4c5537a056d63983e1bbeea764940a8bac65bef4d4e0893da6fa","1f580e2fdf26b64a4a1ee3e9d42daf070ee3d19f56c56f3ea17386fa999706de","4ca446dcd13ef2da3dec558648f3bb3ffd6bf76f648c0165116219749b03b48a","f7c9207b9f0ab2b3385be9bb6e8772648ad0de5a49513ac796d61aef2ff4b0e5","03fc732f99839db475d4b0dbf9401420d72d4145c5b5a8029f57164308b47f82","6c501e7716d31893b6137e287ffd72bd2d0acf014af4a4746e26b8d99300e440","13cb14683525e60dbcacba65402da8a6e5c672dac49df2b9c884546f8505c77d","1f1f862597531be1a7e97fa3a71d727db2acb3a557d0dcdc118414ba39e54247","695c06a7b5396e5e2cf0cb62cab6810091ad0f83125d1b7f753b1646eb5e717a","4783161316a18ea08e1c3e3a4c23e4142a00be6ef3210224bfd42f7c5626f35e","245aeef71aef719fc51bdf3874d1fcfa544f9e1231b8d92b3cac8398723af575","38c1e236fed503ce2cb3ef0c