{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE PUCCH-SpatialRelationInfo is used to configure the spatial setting for PUCCH transmission and the parameters for PUCCH power control, see TS 38.213, [13], clause 9.2.2.","paragraph_zero_based":23664},{"literal_text_all_w_t_and_m_t":"PUCCH-SpatialRelationInfo information element","paragraph_zero_based":23665},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":23666},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-SPATIALRELATIONINFO-START","paragraph_zero_based":23667},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23668},{"literal_text_all_w_t_and_m_t":"PUCCH-SpatialRelationInfo ::=           SEQUENCE {","paragraph_zero_based":23669},{"literal_text_all_w_t_and_m_t":"    pucch-SpatialRelationInfoId         PUCCH-SpatialRelationInfoId,","paragraph_zero_based":23670},{"literal_text_all_w_t_and_m_t":"    servingCellId                           ServCellIndex                                                    OPTIONAL,   -- Need S","paragraph_zero_based":23671},{"literal_text_all_w_t_and_m_t":"    referenceSignal                         CHOICE {","paragraph_zero_based":23672},{"literal_text_all_w_t_and_m_t":"        ssb-Index                               SSB-Index,","paragraph_zero_based":23673},{"literal_text_all_w_t_and_m_t":"        csi-RS-Index                            NZP-CSI-RS-ResourceId,","paragraph_zero_based":23674},{"literal_text_all_w_t_and_m_t":"        srs                                     PUCCH-SRS","paragraph_zero_based":23675},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":23676},{"literal_text_all_w_t_and_m_t":"    pucch-PathlossReferenceRS-Id            PUCCH-PathlossReferenceRS-Id,","paragraph_zero_based":23677},{"literal_text_all_w_t_and_m_t":"    p0-PUCCH-Id                             P0-PUCCH-Id,","paragraph_zero_based":23678},{"literal_text_all_w_t_and_m_t":"    closedLoopIndex                         ENUMERATED { i0, i1 }","paragraph_zero_based":23679},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":23680},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23681},{"literal_text_all_w_t_and_m_t":"PUCCH-SpatialRelationInfoExt-r16 ::=       SEQUENCE {","paragraph_zero_based":23682},{"literal_text_all_w_t_and_m_t":"    pucch-SpatialRelationInfoId-v1610         PUCCH-SpatialRelationInfoId-v1610                              OPTIONAL,   -- Need S","paragraph_zero_based":23683},{"literal_text_all_w_t_and_m_t":"    pucch-PathlossReferenceRS-Id-v1610        PUCCH-PathlossReferenceRS-Id-v1610                             OPTIONAL,    --Need R","paragraph_zero_based":23684},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":23685},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":23686},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23687}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["2f703b7790dc246dcd44b6d35c22d8209585fc47f53bb86a1d8056b178962a47","bb78428cea17750ff5ddacfdd9032951042b36f063e01f997ae8848e9e5642e2","dbbd37adc34cd8f1830457b353a0df68e50ace08e5e0f9a4cf8d793134bef3f0","607340c4ff6b941a76bcd016bb4008729e3d0653c8e21ebbcee4c7eca8889394","2dc1a4e61b5c46b21af0ef5b5147cf7f06b837adc8914936a94d23ebbdce5a02","f499cc1fd2ced9ce28182892118854cd8094002419eec798f128c8a9d03a3029","e1efd18c53a73c2b34aef3459b3c729a23e720630be78cf2cb9abc2fb6c2f691","b3dd642f2f60817824cfa01c61eda7936b0f891b409ebd2f6a232ba01e5a5085","c19c8aa7968dcbb8efaa2dd97f3e6307b058e9886e6d6aecd3e8200787f21c5d","d137492ef4db9850045fa8f67510eead1b2