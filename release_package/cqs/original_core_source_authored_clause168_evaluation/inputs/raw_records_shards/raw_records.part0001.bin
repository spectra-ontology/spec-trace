{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-APERIODICTRIGGERSTATELIST-START","paragraph_zero_based":16944},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16945},{"literal_text_all_w_t_and_m_t":"CSI-AperiodicTriggerStateList ::=   SEQUENCE (SIZE (1..maxNrOfCSI-AperiodicTriggers)) OF CSI-AperiodicTriggerState","paragraph_zero_based":16946},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16947},{"literal_text_all_w_t_and_m_t":"CSI-AperiodicTriggerState ::=       SEQUENCE {","paragraph_zero_based":16948},{"literal_text_all_w_t_and_m_t":"    associatedReportConfigInfoList      SEQUENCE (SIZE(1..maxNrofReportConfigPerAperiodicTrigger)) OF CSI-AssociatedReportConfigInfo,","paragraph_zero_based":16949},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":16950},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":16951},{"literal_text_all_w_t_and_m_t":"    ap-CSI-MultiplexingMode-r17         ENUMERATED {enabled}                                          OPTIONAL  -- Need R","paragraph_zero_based":16952},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":16953},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":16954},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16955},{"literal_text_all_w_t_and_m_t":"CSI-AssociatedReportConfigInfo ::=  SEQUENCE {","paragraph_zero_based":16956},{"literal_text_all_w_t_and_m_t":"    reportConfigId                      CSI-ReportConfigId,","paragraph_zero_based":16957},{"literal_text_all_w_t_and_m_t":"    resourcesForChannel                 CHOICE {","paragraph_zero_based":16958},{"literal_text_all_w_t_and_m_t":"        nzp-CSI-RS                          SEQUENCE {","paragraph_zero_based":16959},{"literal_text_all_w_t_and_m_t":"            resourceSet                         INTEGER (1..maxNrofNZP-CSI-RS-ResourceSetsPerConfig),","paragraph_zero_based":16960},{"literal_text_all_w_t_and_m_t":"            qcl-info                            SEQUENCE (SIZE(1..maxNrofAP-CSI-RS-ResourcesPerSet)) OF TCI-StateId","paragraph_zero_based":16961},{"literal_text_all_w_t_and_m_t":"                                                                                                      OPTIONAL  -- Cond Aperiodic","paragraph_zero_based":16962},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":16963},{"literal_text_all_w_t_and_m_t":"        csi-SSB-ResourceSet                 INTEGER (1..maxNrofCSI-SSB-ResourceSetsPerConfig)","paragraph_zero_based":16964},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":16965},{"literal_text_all_w_t_and_m_t":"    csi-IM-ResourcesForInterference     INTEGER(1..maxNrofCSI-IM-ResourceSetsPerConfig)               OPTIONAL, -- Cond CSI-IM-ForInterference","paragraph_zero_based":16966},{"literal_text_all_w_t_and_m_t":"    nzp-CSI-RS-ResourcesForInterference INTEGER (1..maxNrofNZP-CSI-RS-ResourceSetsPerConfig)          OPTIONAL, -- Cond NZP-CSI-RS-ForInterference","paragraph_zero_based":16967}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["ada5009bac511105cf1fb12da1d831cf3537421353e734292a817a70c4feacc6","af70ab9eb9b071822200c3c9ddd10c679614d6f77ef8ef983a036d2f413398cd","675fb6b943c02242454cd25c4551c609155f9ff72a7efdc6eff5ccfb4152bb96","70949512fd98e70dc49bd709fd1abb6a92368eaa070592982e98698c13e6ba45","41861b52f6afae7d53674d2a31d81c93dc0e63b5a74db22d4441628fea6d33b6","a1293eabdc6ce2e0343601626d249f0b0ffff8bbff36f56538475c2f875e85bc","ee7e7f9e96f845c74581630f1dc7cf267b7c3d0b76f3940995010bf15344d632","2a6b0c55e378374e7eca8390853765