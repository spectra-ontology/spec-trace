{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"MeasResultEUTRA field descriptions","paragraph_zero_based":20304},{"literal_text_all_w_t_and_m_t":"eutra-PhysCellId","paragraph_zero_based":20305},{"literal_text_all_w_t_and_m_t":"Identifies the physical cell identity of the E-UTRA cell for which the reporting is being performed. The UE reports a value in the range 0..503, other values are reserved.","paragraph_zero_based":20306},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20307},{"literal_text_all_w_t_and_m_t":"MeasResultNR field descriptions","paragraph_zero_based":20308},{"literal_text_all_w_t_and_m_t":"averageDelay","paragraph_zero_based":20309},{"literal_text_all_w_t_and_m_t":"Indicates average delay for the packets during the reporting period, as specified in TS 38.314 [53]. Value 0 corresponds to 0 millisecond, value 1 corresponds to 0.1 millisecond, value 2 corresponds to 0.2 millisecond, and so on.","paragraph_zero_based":20310},{"literal_text_all_w_t_and_m_t":"cellResults","paragraph_zero_based":20311},{"literal_text_all_w_t_and_m_t":"Cell level measurement results.","paragraph_zero_based":20312},{"literal_text_all_w_t_and_m_t":"choCandidate","paragraph_zero_based":20313},{"literal_text_all_w_t_and_m_t":"This field indicates whether the associated cell is a candidate target cell for conditional handover. This field may be included only in the SuccessHO-Report within UEInformationResponse message.","paragraph_zero_based":20314},{"literal_text_all_w_t_and_m_t":"choConfig","paragraph_zero_based":20315},{"literal_text_all_w_t_and_m_t":"If the associated cell is a candidate target cell for conditional handover, this field indicates the conditional handover execution condition for each measId within condTriggerConfig associated to the cell. This field may be included only in the rlf-report within UEInformationResponse message.","paragraph_zero_based":20316},{"literal_text_all_w_t_and_m_t":"drb-Id","paragraph_zero_based":20317},{"literal_text_all_w_t_and_m_t":"Indicates DRB value for which uplink PDCP delay ratio or value is provided, according to TS 38.314 [53].","paragraph_zero_based":20318},{"literal_text_all_w_t_and_m_t":"firstTriggeredEvent","paragraph_zero_based":20319},{"literal_text_all_w_t_and_m_t":"This field is set to condFirstEvent if the execution condition associated to the first entry of choConfig was fulfilled first in time. This field is set to condSecondEvent if the execution condition associated to the second entry of choConfig was fulfilled first in time. This field may be included only in rlf-report within UEInformationResponse message.","paragraph_zero_based":20320},{"literal_text_all_w_t_and_m_t":"locationInfo","paragraph_zero_based":20321},{"literal_text_all_w_t_and_m_t":"Positioning related information and measurements.","paragraph_zero_based":20322},{"literal_text_all_w_t_and_m_t":"physCellId","paragraph_zero_based":20323},{"literal_text_all_w_t_and_m_t":"The physical cell identity of the NR cell for which the reporting is being performed.","paragraph_zero_based":20324},{"literal_text_all_w_t_and_m_t":"resultsSSB-Cell","paragraph_zero_based":20325},{"literal_text_all_w_t_and_m_t":"Cell level measurement results based on SS/PBCH related measurements.","paragraph_zero_based":20326},{"literal_text_all_w_t_and_m_t":"resultsSSB-Indexes","paragraph_zero_based":20327}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["be077f22631a45719d79135021c317c99e82095f86291bbed60bd6bc14c510ab","2c4b7c7d37ba04a7e352c133fcf091363b157921f1d1a26a005d57fb54175f39","de06741d2ae5f3c44f674039e36154af5bbd58ce5ee193ac794e0949dd79abaf","75f9e4a0b2ae808c4702f98ad0d31627c7a43f40dd9d31a8595309c5861d17e1","41424ae395dabd2b2d9f48466a9decf25dc6ba91dbf0678737d1da87de82a038","b083b785fc6e63700cbf49f78876d95766693882a84e1cc839f8ac45392407ae","b3da0ce7deba69b116ad726c1307af11fee93dec4cd7ee0f06fa739f57150bbf","eed953fa3e37c97814b8c4fde93046d3785d053a6395382d2dc2b02bcd75eb8f","76168a990f166cd441ac9a9a04cdf8d3cd3ac2d857d6a975d8e7903e08718a01","bbc54ca6e1e1657a9cf4669b9dbb6b770b212ecf95cadc31bb1874fc224892cc","260c822532341d66a5436271d79d0a171a16cc366f745dfd5ec8debf847b3b09","b5225f0bfc8d4ca1ad1237aef1300512f2f44db89f751bceb2a6d1ce4675ef59","34c2cd55bf0b4fcba15adf13b98cff4f48aae4d9af93d5a77d532cd15ab0b9dc","d0c1514f4f72ef059df8a2787b9ac39a766543e16648bff4bd6a43a364f05eae","95861410a5cb767d36e4bf072c34b0aa4d4d474ed6fd7203910a12bffab88642","71a2ca9b5a77fc526f04fe047e3199cbd83d07244f76de6201e81fdad6f01d67","2edb9193d7e0ba2df709d86f7491c71fe81391bf8066c7947edb733a6aa2a8bc","9de768cdb12343564bdd0fe936094aeca3b1454bd8c78f40507bef0b7c319725","77449f3492e16898f9915b7d3e6c56768c47574b2befbe3660d94568cda475ad","47022c16daced8da16bd6d3fb5290fd26b860ddd2945e4307fb9b3e2443b440f","eec74cbf404bce7058876f84bb8f956a2bfbafa3523a8dd55b866d2d94624f17","ce50a643764a975fdd22a822c3601a1b9bf9f2c4c3365d89f8a55bfd0cdc783a","dbe806d4a29765a40830562501967bdf056567bd6df5bb2db7251f7ec25de378","e00a28c9670073a366d136eaac893cd1ec8dd9099fd411ec3e2b6af6267f5d4a"],"paragraph_range_zero_based":[20304,20327],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p20304"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Beam level measurement results based on SS/PBCH related measurements.","paragraph_zero_based":20328},{"literal_text_all_w_t_and_m_t":"resultsCSI-RS-Cell","paragraph_zero_based":20329},{"literal_text_all_w_t_and_m_t":"Cell level measurement results based on CSI-RS related measurements.","paragraph_zero_based":20330},{"literal_text_all_w_t_and_m_t":"resultsCSI-RS-Indexes","paragraph_zero_based":20331},{"literal_text_all_w_t_and_m_t":"Beam level measurement results based on CSI-RS related measurements.","paragraph_zero_based":20332},{"literal_text_all_w_t_and_m_t":"rsIndexResults","paragraph_zero_based":20333},{"literal_text_all_w_t_and_m_t":"Beam level measurement results.","paragraph_zero_based":20334},{"literal_text_all_w_t_and_m_t":"timeBetweenEvents","paragraph_zero_based":20335},{"literal_text_all_w_t_and_m_t":"Indicates the time elapsed between fulfilling the conditional execution conditions included in choConfig. Value in milliseconds. The maximum value 1023 means 1023ms or longer. This field may be included only in the reports associated to UEInformationResponse message, e.g., rlf-Report.","paragraph_zero_based":20336},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20337},{"literal_text_all_w_t_and_m_t":"MeasResultUTRA-FDD field descriptions","paragraph_zero_based":20338},{"literal_text_all_w_t_and_m_t":"physCellId","paragraph_zero_based":20339},{"literal_text_all_w_t_and_m_t":"The physical cell identity of the UTRA-FDD cell for which the reporting is being performed.","paragraph_zero_based":20340},{"literal_text_all_w_t_and_m_t":"utra-FDD-EcN0","paragraph_zero_based":20341},{"literal_text_all_w_t_and_m_t":"According to CPICH_Ec/No in TS 25.133 [46] for FDD.","paragraph_zero_based":20342},{"literal_text_all_w_t_and_m_t":"utra-FDD-RSCP","paragraph_zero_based":20343},{"literal_text_all_w_t_and_m_t":"According to CPICH_RSCP in TS 25.133 [46] for FDD.","paragraph_zero_based":20344},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20345},{"literal_text_all_w_t_and_m_t":"MeasResults field descriptions","paragraph_zero_based":20346},{"literal_text_all_w_t_and_m_t":"coarseLocationInfo","paragraph_zero_based":20347},{"literal_text_all_w_t_and_m_t":"This field indicates the coarse location information reported by the UE. This field is coded as the Ellipsoid-Point defined in TS 37.355 [49]. The first/leftmost bit of the first octet contains the most significant bit. The least significant bits of degreesLatitude and degreesLongitude are set to 0 to meet the accuracy requirement corresponds to a granularity of approximately 2 km.","paragraph_zero_based":20348},{"literal_text_all_w_t_and_m_t":"It is up to UE implementation how many LSBs are set to 0 to meet the accuracy requirement","paragraph_zero_based":20349},{"literal_text_all_w_t_and_m_t":"excessDelay","paragraph_zero_based":20350},{"literal_text_all_w_t_and_m_t":"Indicates the ratio of packets in UL per DRB exceeding the configured delay threshold among the UL PDCP SDUs, according to the UL PDCP Excess Packet Delay per DRB mapping table, as defined in TS 38.314 [53], Table 4.3.1.e-1.","paragraph_zero_based":20351}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["65a6d62d100fe90635cd50495ce3459c3604f88e0ea15fd6b4e1ffbd23257dbf","3cf1a4c60c9d5b9a7330e83cc3917789a5420efbe29022057cfcdfd23083f2a6","c80d7a3cc8f1b6f42905be7fd459417eb1322185b266be4f114072aaca7f87e7","130d029868084e5e8824534dedbbbd73bc9cdc6fe50e1b1617737954268451ab","4558a1cda99aea18b8af246b4334808693e