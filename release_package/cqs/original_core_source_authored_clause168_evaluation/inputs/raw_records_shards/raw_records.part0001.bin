{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"EUTRA-MBSFN-SubframeConfig ::=      SEQUENCE {","paragraph_zero_based":36360},{"literal_text_all_w_t_and_m_t":"    radioframeAllocationPeriod          ENUMERATED {n1, n2, n4, n8, n16, n32},","paragraph_zero_based":36361},{"literal_text_all_w_t_and_m_t":"    radioframeAllocationOffset          INTEGER (0..7),","paragraph_zero_based":36362},{"literal_text_all_w_t_and_m_t":"    subframeAllocation1                 CHOICE {","paragraph_zero_based":36363},{"literal_text_all_w_t_and_m_t":"        oneFrame                            BIT STRING (SIZE(6)),","paragraph_zero_based":36364},{"literal_text_all_w_t_and_m_t":"        fourFrames                          BIT STRING (SIZE(24))","paragraph_zero_based":36365},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":36366},{"literal_text_all_w_t_and_m_t":"    subframeAllocation2                 CHOICE {","paragraph_zero_based":36367},{"literal_text_all_w_t_and_m_t":"        oneFrame                            BIT STRING (SIZE(2)),","paragraph_zero_based":36368},{"literal_text_all_w_t_and_m_t":"        fourFrames                          BIT STRING (SIZE(8))","paragraph_zero_based":36369},{"literal_text_all_w_t_and_m_t":"    }                                                                                                       OPTIONAL,   -- Need R","paragraph_zero_based":36370},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":36371},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":36372},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36373},{"literal_text_all_w_t_and_m_t":"-- TAG-EUTRA-MBSFN-SUBFRAMECONFIGLIST-STOP","paragraph_zero_based":36374},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36375},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36376},{"literal_text_all_w_t_and_m_t":"EUTRA-MBSFN-SubframeConfig field descriptions","paragraph_zero_based":36377},{"literal_text_all_w_t_and_m_t":"radioframeAllocationOffset","paragraph_zero_based":36378},{"literal_text_all_w_t_and_m_t":"Field as defined in MBSFN-SubframeConfig in TS 36.331 [10].","paragraph_zero_based":36379},{"literal_text_all_w_t_and_m_t":"radioframeAllocationPeriod","paragraph_zero_based":36380},{"literal_text_all_w_t_and_m_t":"Field as defined in MBSFN-SubframeConfig in TS 36.331 [10], where SFN refers to the SFN of the NR serving cell.","paragraph_zero_based":36381},{"literal_text_all_w_t_and_m_t":"subframeAllocation1","paragraph_zero_based":36382},{"literal_text_all_w_t_and_m_t":"Field as defined in MBSFN-SubframeConfig in TS 36.331 [10], where the UE assumes the duplex mode (FDD or TDD) of the NR cell for which the E-UTRA-MBSFN-SubframeConfig is provided.","paragraph_zero_based":36383}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["ce938617a4b1e6a82be9c1665a63a25c5872ecad0d0b7e614c058bd10cbbf6cf","7791a92d2c27c2bf1acb65e1687940fccba7f1e1d05572e1c26d1ebfc7ad118b","3144a843eaed60d25047602769e3444920d4a72e88ef965ae4f3a524a12ece7d","52c76afa59458ef1d04e923c0cab7d09414f4089195702cc5a28ec8bc262a1fd","34ed8b4470f30e223c474ff5bea32845ea6833f415fff3b03ba5fe4333ce8bf0","d469acf78dc358a984aee11ddbe718793bba55cda21681e52aafa48d815fa4fe","1721f6637118a94b480d0ae25572bebc1a334c16c1b907a4ea1d802a40abdd2b","6751a6dd3bad2b99823efa7d5531c5c8576ed418a379ef2215eaa590d4ab94f9","11f6e8351d15b57faa0362b486de859950d9c8a786c6c39e0f1a504f203cbf55","b88b8f89a8dcb3ef2072aa5dc91504ebd20805ef953c9ca9e1b6593be28faeed","745cf6a6cb24ff1869737ab643bbc5c9c03e2d04ab15df9593