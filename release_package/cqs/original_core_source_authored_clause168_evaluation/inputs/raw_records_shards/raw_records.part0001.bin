{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–SL-InterUE-CoordinationConfig","paragraph_zero_based":38232},{"literal_text_all_w_t_and_m_t":"The IE SL-InterUE-CoordinationConfig is used to configure the sidelink inter-UE coordination (between a UE, UE-A, and a peer UE, UE-B) parameters.","paragraph_zero_based":38233},{"literal_text_all_w_t_and_m_t":"SL-InterUE-CoordinationConfig information element","paragraph_zero_based":38234},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":38235},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-INTERUE-COORDINATIONCONFIG-START","paragraph_zero_based":38236},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38237},{"literal_text_all_w_t_and_m_t":"SL-InterUE-CoordinationConfig-r17 ::=     SEQUENCE {","paragraph_zero_based":38238},{"literal_text_all_w_t_and_m_t":"    sl-InterUE-CoordinationScheme1-r17        SL-InterUE-CoordinationScheme1-r17                                   OPTIONAL,   -- Need M","paragraph_zero_based":38239},{"literal_text_all_w_t_and_m_t":"    sl-InterUE-CoordinationScheme2-r17        SL-InterUE-CoordinationScheme2-r17                                   OPTIONAL,   -- Need M","paragraph_zero_based":38240},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":38241},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":38242},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38243},{"literal_text_all_w_t_and_m_t":"SL-InterUE-CoordinationScheme1-r17 ::=    SEQUENCE {","paragraph_zero_based":38244},{"literal_text_all_w_t_and_m_t":"    sl-IUC-Explicit-r17                       ENUMERATED {enabled, disabled}                                       OPTIONAL,   -- Need M","paragraph_zero_based":38245},{"literal_text_all_w_t_and_m_t":"    sl-IUC-Condition-r17                      ENUMERATED {enabled, disabled}                                       OPTIONAL,   -- Need M","paragraph_zero_based":38246},{"literal_text_all_w_t_and_m_t":"    sl-Condition1-A-2-r17                     ENUMERATED {disabled}                                                OPTIONAL,   -- Need M","paragraph_zero_based":38247},{"literal_text_all_w_t_and_m_t":"    sl-ThresholdRSRP-Condition1-B-1-Option1List-r17  SEQUENCE (SIZE (1..8)) OF SL-ThresholdRSRP-Condition1-B-1-r17 OPTIONAL,   -- Need M","paragraph_zero_based":38248},{"literal_text_all_w_t_and_m_t":"    sl-ThresholdRSRP-Condition1-B-1-Option2List-r17  SEQUENCE (SIZE (1..8)) OF SL-ThresholdRSRP-Condition1-B-1-r17 OPTIONAL,   -- Need M","paragraph_zero_based":38249},{"literal_text_all_w_t_and_m_t":"    sl-ContainerCoordInfo-r17                 ENUMERATED {enabled, disabled}                                       OPTIONAL,   -- Need M","paragraph_zero_based":38250},{"literal_text_all_w_t_and_m_t":"    sl-ContainerRequest-r17                   ENUMERATED {enabled, disabled}                                       OPTIONAL,   -- Need M","paragraph_zero_based":38251},{"literal_text_all_w_t_and_m_t":"    sl-TriggerConditionCoordInfo-r17          INTEGER (0..1)                                                       OPTIONAL,   -- Need M","paragraph_zero_based":38252},{"literal_text_all_w_t_and_m_t":"    sl-TriggerConditionRequest-r17            INTEGER (0..1)                                                       OPTIONAL,   -- Need M","paragraph_zero_based":38253},{"literal_text_all_w_t_and_m_t":"    sl-PriorityCoordInfoExplicit-r17          INTEGER (1..8)                                                       OPTIONAL,   -- Need M","paragraph_zero_based":38254},{"literal_text_all_w_t_and_m_t":"    sl-PriorityCoordInfoCondition-r17         INTEGER (1..8)                                                       OPTIONAL,   -- Need M","paragraph_zero_based":38255}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coo