{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-RATEMATCHPATTERNLTE-CRS-STOP","paragraph_zero_based":25368},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":25369},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25370},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25371},{"literal_text_all_w_t_and_m_t":"RateMatchPatternLTE-CRS field descriptions","paragraph_zero_based":25372},{"literal_text_all_w_t_and_m_t":"carrierBandwidthDL","paragraph_zero_based":25373},{"literal_text_all_w_t_and_m_t":"BW of the LTE carrier in number of PRBs (see TS 38.214 [19], clause 5.1.4.2).","paragraph_zero_based":25374},{"literal_text_all_w_t_and_m_t":"carrierFreqDL","paragraph_zero_based":25375},{"literal_text_all_w_t_and_m_t":"Center of the LTE carrier (see TS 38.214 [19], clause 5.1.4.2).","paragraph_zero_based":25376},{"literal_text_all_w_t_and_m_t":"mbsfn-SubframeConfigList","paragraph_zero_based":25377},{"literal_text_all_w_t_and_m_t":"LTE MBSFN subframe configuration (see TS 38.214 [19], clause 5.1.4.2).","paragraph_zero_based":25378},{"literal_text_all_w_t_and_m_t":"nrofCRS-Ports","paragraph_zero_based":25379},{"literal_text_all_w_t_and_m_t":"Number of LTE CRS antenna port to rate-match around (see TS 38.214 [19], clause 5.1.4.2).","paragraph_zero_based":25380},{"literal_text_all_w_t_and_m_t":"v-Shift","paragraph_zero_based":25381},{"literal_text_all_w_t_and_m_t":"Shifting value v-shift in LTE to rate match around LTE CRS (see TS 38.214 [19], clause 5.1.4.2).","paragraph_zero_based":25382},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25383},{"literal_text_all_w_t_and_m_t":"–ReferenceLocation","paragraph_zero_based":25384},{"literal_text_all_w_t_and_m_t":"The IE ReferenceLocation contains location information used as a reference location. The value of the field is same as Ellipsoid-Point defined in TS37.355 [49]. The first/leftmost bit of the first octet contains the most significant bit.","paragraph_zero_based":25385},{"literal_text_all_w_t_and_m_t":"ReferenceLocation information element","paragraph_zero_based":25386},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25387},{"literal_text_all_w_t_and_m_t":"-- TAG-REFERENCELOCATION-START","paragraph_zero_based":25388},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25389},{"literal_text_all_w_t_and_m_t":"ReferenceLocation-r17 ::= OCTET STRING","paragraph_zero_based":25390},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25391}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["a36815e57b334764780e09201625a0c303ba3f82155cb91c3a63c24addb0c7f8","0671f3b51b6313579d6a22ddd16481daa1e462dd230e4b013a630a5559b2ceaa","1afcd0204473918964412919d374028f7fd792fdd677eccfff614078fb5e55ce","cc2a8d5a6376dfb01e630f8d30201b94fd7c2336cb48432a94fade5f1ab9e461","f28fc37b63a3ce52ec679f3843cf94b9eb8f7f94e092fc913bdb6f68f1a4a833","eeeafe73d18f0f4d067cdba312e39ce0a6ef1cb1daf6f12c2a0969c9af31e596","3876184e3001dd279cf923ab0185b87a963d6ccbfa61e74d3699d1055f13e8fb","56be5515ed9ce145c67414d8c363bae0f5c269cceba5782d6e7670e63d92bbf1","f4bef3b9807804c2023b332b93c94f8b8993904b8556bba6d56486a4349bbd18","9ebe5f5bb93a74227fe2cf316db3f7050115c72fb317822d953475226d15d0e9","58e527ce31c05b62cc931df43f6cb5a836bfe763072bc845f29ea101c75a2d2e","dfe5119bb73d76d9dc4e7b5da574e7cea774ea8e12fa5886dd58f0867a797e84","8a4f4e0be857e706353a3e4b2819db8eb32314cc2d6e4c3d47fb5c76502bd938","afbd06c71835510e22566505a3ce2fdf6ef6f326adde327c61a5187d11679b2e","3eb5a24ec4a32ba2aa286a1ebe1389409b0dabed5e8b3bb