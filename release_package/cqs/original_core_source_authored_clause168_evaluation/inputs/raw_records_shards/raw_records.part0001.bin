{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"freqBand","paragraph_zero_based":17064},{"literal_text_all_w_t_and_m_t":"Frequency-occupancy of CSI-IM (see TS 38.214 [19], clause 5.2.2.4)","paragraph_zero_based":17065},{"literal_text_all_w_t_and_m_t":"periodicityAndOffset","paragraph_zero_based":17066},{"literal_text_all_w_t_and_m_t":"Periodicity and slot offset for periodic/semi-persistent CSI-IM. Network always configures the UE with a value for this field for periodic and semi-persistent CSI-IM-Resources (as indicated in CSI-ResourceConfig). A change of configuration between periodic or semi-persistent and aperiodic for a CSI-IM-Resource is not supported without a release and add.","paragraph_zero_based":17067},{"literal_text_all_w_t_and_m_t":"subcarrierLocation-p0","paragraph_zero_based":17068},{"literal_text_all_w_t_and_m_t":"OFDM subcarrier occupancy of the CSI-IM resource for Pattern0 (see TS 38.214 [19], clause 5.2.2.4)","paragraph_zero_based":17069},{"literal_text_all_w_t_and_m_t":"subcarrierLocation-p1","paragraph_zero_based":17070},{"literal_text_all_w_t_and_m_t":"OFDM subcarrier occupancy of the CSI-IM resource for Pattern1 (see TS 38.214 [19], clause 5.2.2.4)","paragraph_zero_based":17071},{"literal_text_all_w_t_and_m_t":"symbolLocation-p0","paragraph_zero_based":17072},{"literal_text_all_w_t_and_m_t":"OFDM symbol location of the CSI-IM resource for Pattern0 (see TS 38.214 [19], clause 5.2.2.4)","paragraph_zero_based":17073},{"literal_text_all_w_t_and_m_t":"symbolLocation-p1","paragraph_zero_based":17074},{"literal_text_all_w_t_and_m_t":"OFDM symbol location of the CSI-IM resource for Pattern1 (see TS 38.214 [19], clause 5.2.2.4)","paragraph_zero_based":17075},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17076},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":17077},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":17078},{"literal_text_all_w_t_and_m_t":"PeriodicOrSemiPersistent","paragraph_zero_based":17079},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need M, for periodic and semi-persistent CSI-IM-Resources (as indicated in CSI-ResourceConfig). The field is absent otherwise.","paragraph_zero_based":17080},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17081},{"literal_text_all_w_t_and_m_t":"–CSI-IM-ResourceId","paragraph_zero_based":17082},{"literal_text_all_w_t_and_m_t":"The IE CSI-IM-ResourceId is used to identify one CSI-IM-Resource.","paragraph_zero_based":17083},{"literal_text_all_w_t_and_m_t":"CSI-IM-ResourceId information element","paragraph_zero_based":17084},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17085},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-IM-RESOURCEID-START","paragraph_zero_based":17086},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17087}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["34a429fb8fbf48385c466833b963848634a44fc24baddd18ff74105ad3d8dcac","dd61d99d5dff72e19b256ea91615bf1b122ccad44b05d850e1458e999f7fd0ea","894e5bb57165ff855d1317e3e18bfb295985cad73533903d4cb230491dd36741","46a06168d5dd5c22d2cdd97519b90a6b9c90321969af9e68a2a820a1b9cf9b80","c0b7d93c6db2b72193ad7e1975be0d2a09a69ce0273b0994d2de7c61475141d4","5d412731a0a3bc484519cdab9064f71aa2ad6dba4a541bcd149a6666d96e2b24","0000df9f2b4b73d26c3c9b08cb88d488e257848eb573c327ed8fc76d56af85f0","289b77ec146b102a8f986acb5e6bdefe9d25e047e73fbe33d4ffb31ec8488edd","c4f3c334eadf6ccb85f8bb97643d32fdb60b40b907dabc5a6d1d58b67b4de1d5","47f09c861b7baa3a7015134b6fbe368d64d3575