ms8, spare2, spare1}","paragraph_zero_based":22429},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22430},{"literal_text_all_w_t_and_m_t":"DiscardTimerExt2-r17 ::= ENUMERATED {ms2000, spare3, spare2, spare1}","paragraph_zero_based":22431},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22432},{"literal_text_all_w_t_and_m_t":"UplinkDataCompression-r17 ::= CHOICE {","paragraph_zero_based":22433},{"literal_text_all_w_t_and_m_t":"    newSetup                      SEQUENCE {","paragraph_zero_based":22434},{"literal_text_all_w_t_and_m_t":"        bufferSize-r17                ENUMERATED {kbyte2, kbyte4, kbyte8, spare1},","paragraph_zero_based":22435},{"literal_text_all_w_t_and_m_t":"        dictionary-r17                ENUMERATED {sip-SDP, operator}                            OPTIONAL    -- Need N","paragraph_zero_based":22436},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":22437},{"literal_text_all_w_t_and_m_t":"    drb-ContinueUDC           NULL","paragraph_zero_based":22438},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22439}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["1456a5af2418f5d62eacf175446975cb9854dc045fb922a7d5961f35fb62a6a8","bc68b7fa81f4ddaccc23d5d789a70670a7286d057ca0629e7de58fe3b238938e","0c5b50319a31bbd38965058addc109c119ff2140805abad328f6e3387770f711","79c8a31cc391411646c149f6ac30b236660990645207d72eacea9f036c38e44a","959a64b70a113ad2fb9a307da8a2314a3a8626400fdde051c58c48f7975a1bd0","9f61f36aebe5ba0a41f09920fed232b929acd0a66f4567a3479c2aace1491f1f","5700b58abc10b1b5ddd712e92621cc50f9e1ba35493fc982d055a6bc6293737a","0de054d3a6d45ead51cd31d7ececf5b043dc3b4cd214dbad0cb4a06bb543c601","c8ba72202df87da6e4170b67c2632babdcc35c7b88788c722a145b69ed2af51f","5694b6dfda742be01fe26cb12ecf791b5e702caa11760bb1c8eddbc35b94091e","3d219722e11ed2ed282797c426b8d10205e35fa90da995f2793dc63d555d758c","540b46791ee1c043607000e97bc6e42ada38be219d623025a9983e8ca429dc48","e0c3e73fe0794d43c14bb720227e3feef76efd96346c9cd507f0ce565c4499df","4e02ea5f88bb2ecee2a3d069f8194ecd10724d032b4276f2017fcd06f3004930","1f6b395582d7e5c2718e4b2cd5ddaf1f092f5088781ae22ec4308886a3f88826","4dfea8208954276896f5d2b99821bed6cb4e925f0cf21d01b978abcf7e01ce2f","db5399f33fdda0eb2980662a03b97d20a33ce28a526aaa79b688569de29051f0","a0a4f91654aafcd2ef5135b73b41a456158dccb15614c05829e4f20f9b5fec33","3aeb7f3dd7d021f68192cadd763097346e73fdd2f977b795a1e4fb4bb1a5899c","36a0092b65bdad196a4f8a6cb4189ff16a89b91cbc84c9e62b7723a7b3b1c285","e1333f8b9022bc3cb960912cf661fb044ace3fbea4751a97f960fbc85d2c7d56","bc63a4b6051bd31413265d6168882ea4eb619efe7682378bf841121b47667337","044a531fc17e77cd0febc7c5b24a22b911d598b9e00073d99e5156d85941bc12","4fcbd5d67d678f4da0b934e3083f39b6da540edd031904627cf9031fe3f77373"],"paragraph_range_zero_based":[22416,22439],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p22416"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22440},{"literal_text_all_w_t_and_m_t":"-- TAG-PDCP-CONFIG-STOP","paragraph_zero_based":22441},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":22442},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22443},{"literal_text_all_w_t_and_m_t":"PDCP-Config field descriptions","paragraph_zero_based":22444},{"literal_text_all_w_t_and_m_t":"cipheringDisabled","paragraph_zero_based":22445},{"literal_text_all_w_t_and_m_t":"If included, ciphering is disabled for this DRB regardless of which ciphering algorithm is configured for the SRB/DRBs. The field may only be included if the UE is connected to 5GC. Otherwise the field is absent. The network configures all DRBs with the same PDU-session ID with same value for this field. The value for this field cannot be changed after the DRB is set up.","paragraph_zero_based":22446},{"literal_text_all_w_t_and_m_t":"discardTimer","paragraph_zero_based":22447},{"literal_text_all_w_t_and_m_t":"Value in ms of discardTimer specified in TS 38.323 [5]. Value ms10 corresponds to 10 ms, value ms20 corresponds to 20 ms and so on. The value for this field cannot be changed in case of reconfiguration with sync, if the bearer is configured as DAPS bearer.","paragraph_zero_based":22448},{"literal_text_all_w_t_and_m_t":"discardTimerExt","paragraph_zero_based":22449},{"literal_text_all_w_t_and_m_t":"Value in ms of discardTimer specified in TS 38.323 [5]. Value ms0dot5 corresponds to 0.5 ms, value ms1 corresponds to 1ms and so on. If this field is present, the field discardTimer is ignored and discardTimerExt is used instead.","paragraph_zero_based":22450},{"literal_text_all_w_t_and_m_t":"discardTimerExt2","paragraph_zero_based":22451},{"literal_text_all_w_t_and_m_t":"Value in ms of discardTimerExt specified in TS 38.323 [5]. Value ms2000 corresponds to 2000 ms. If this field is present, the field discardTimer and discardTimerExt are ignored and discardTimerExt2 is used instead.","paragraph_zero_based":22452},{"literal_text_all_w_t_and_m_t":"drb-ContinueROHC","paragraph_zero_based":22453},{"literal_text_all_w_t_and_m_t":"Indicates whether the PDCP entity continues or resets the ROHC header compression protocol during PDCP re-establishment, as specified in TS 38.323 [5]. This field is configured only in case of resuming an RRC connection or reconfiguration with sync, where the PDCP termination point is not changed and the fullConfig is not indicated. The network does not include the field if the bearer is configured as DAPS bearer. This field can be configured for both DRB and multicast MRB.","paragraph_zero_based":22454},{"literal_text_all_w_t_and_m_t":"duplicationState","paragraph_zero_based":22455},{"literal_text_all_w_t_and_m_t":"This field indicates the uplink PDCP duplication state for the associated RLC entities at the time of receiving this IE. If set to true, the PDCP duplication state is activated for the associated RLC entity. The index for the indication is determined by ascending order of logical channel ID of all RLC entities other than the primary RLC entity indicated by primaryPath in the order of MCG and SCG, as in clause 6.1.3.32 of TS 38.321 [3]. If the number of associated RLC entities other than the primary RLC entity is two, UE ignores the value in the largest index of this field. If the field is absent, the PDCP duplication states are deactivated for all associated RLC entities. ","paragraph_zero_based":22456},{"literal_text_all_w_t_and_m_t":"ethernetHeaderCompression","paragraph_zero_based":22457},{"literal_text_all_w_t_and_m_t":"This fields configures Ethernet Header Compression. This field can only be configured for a bi-directional DRB or a bi-directional multicast MRB. The network reconfigures ethernetHeaderCompression only upon reconfiguration involving PDCP re-establishment and with neither drb-ContinueEHC-DL nor drb-ContinueEHC-UL configured. Network only configures this field when uplinkDataCompression is not configured.","paragraph_zero_based":22458},{"literal_text_all_w_t_and_m_t":"headerCompression","paragraph_zero_based":22459},{"literal_text_all_w_t_and_m_t":"If rohc is configured, the UE shall apply the configured ROHC profile(s) in both uplink and downlink. If uplinkOnlyROHC is configured, the UE shall apply the configured ROHC profile(s) in uplink (there is no header compression in downlink). ROHC can be configured for any bearer type. ROHC and EHC can be both configured simultaneously for a DRB or a multicast MRB. The network reconfigures headerCompression only upon reconfiguration involving PDCP re-establishment or involving PDCP entity reconfiguration to configure DAPS bearer(s), and without any drb-ContinueROHC. Network configures headerCompression to notUsed when outOfOrderDelivery is configured. Network only configures this field when uplinkDataCompression is not configured.","paragraph_zero_based":22460},{"literal_text_all_w_t_and_m_t":"initialRX-DELIV","paragraph_zero_based":22461},{"literal_text_all_w_t_and_m_t":"Indicates the initial value of RX_DELIV during PDCP window initialization for multicast MRB as specified in TS 38.323 [5].","paragraph_zero_based":22462},{"literal_text_all_w_t_and_m_t":"integrityProtection","paragraph_zero_based":22463}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["6ce1977c3b833aa1fc2700301b71ee337c75587ae26dbe960f94ed09424847b4","31cbff8c99d7ed52dac1f1f79452627cb9a9ae5264932ac7b4e80251b4a593d8","21fa45ac65e2c6464607e8262c68a62b5f8c8dbafd4d4aa4236312db456c273d","e93e2d23e1bc8921aab58c1e3c14c7dea2284c6290a5ce41b81a6053dd13e2f6","e29168f6db9e6e501e6594af1537e394db08509baf5ac7edbf42efc0b548efc7","4e098f103409cf307fcbd00163b0dc5a4a47c4eeaeebb9c31102c79598dfb430","1b10480fc07155bc1adfea208b7452d980e440e5071be88e2a8ec0ddfe142df5","a8dbfad2393c2363e85bb2002b8b9e9dd7e28562b54b31459478467bad9e6409","7d12d99d3b7f48f364ac9167de5a914c73b0ca1602e2444d77f127d28d242898","aa8b628148e3d3dfad58451f99a57aa1b2d3c746f81699525611e5ff07350fca","dcb485ab152652eee72f5bd8d2cd06ab47ba3938e710706286348f2410584f1c","498a9048f62c34b64fd29292bc2e7e7d7649b852d8d90d3e62fb8725e82241fd","bfe15d9b13c2ef5ffa1fda3baa8b66f8234b3b59f877a71688e6602620fe9157","9de476b50787dc21874f163b688e81dc66383892c9f027699df8296725daa952","41f5a0e995c20992122f8ac4ca1e889a54663550b7cef2cd3a80f372fb084d66","dd7ea8b96ed30ac34cafdb4a7f08f19e6d3c589d326bd01eb6b8e763ad6992d1","125a0338187ac95155bd2018f959699440b294cba8b3598082f0946ca2978da2","3c8466515b918f5bbe4a647ad25e85e40333988b2cedb71246fc63191c50bb2b","375403fa65d1ef35482d2fc6ca4bfaab19c44d5eac8d2653c14d2d09283f2196","024b16933682555b72b2c7d3a82a63f873b532f2ff1e78b3ca3c89c06626bed8","c20c2f748ddad87d2f6cf722f787a4bcf70a6362f900fd5c0ccd378d5dab3247","033791e26c1ceeb1ac4a66dc922f6283edc216054b7a199a4be61f469e741fda","3a67868e3b903b72ae4ac7859b7efc6f1ffd13c72c8354b4bac43c6c1b91e750","19cc8cf4f2b29bf2165d337fbac0b9294fa019165df133ccb7f9fbacfa0431cc"],"paragraph_range_zero_based":[22440,22463],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p22440"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether or not integrity protection is configured for this radio bearer. The network configures all DRBs with the same PDU-session ID with same value for this field. The value for this field cannot be changed after the DRB is set up.","paragraph_zero_based":22464},{"literal_text_all_w_t_and_m_t":"maxCID","paragraph_zero_based":22465},{"literal_text_all_w_t_and_m_t":"Indicates the value of the MAX_CID parameter as specified in TS 38.323 [5].","paragraph_zero_based":22466},{"literal_text_all_w_t_and_m_t":"The total value of MAX_CIDs across all bearers for the UE should be less than or equal to the value of maxNumberROHC-ContextSessions parameter as indicated by the UE.","paragraph_zero_based":22467},{"literal_text_all_w_t_and_m_t":"moreThanOneRLC","paragraph_zero_based":22468},{"literal_text_all_w_t_and_m_t":"This field configures UL data transmission when more than one RLC entity is associated with the PDCP entity. This field is not present if the bearer is configured as DAPS bearer.","paragraph_zero_based":22469},{"literal_text_all_w_t_and_m_t":"moreThanTwoRLC-DRB","paragraph_zero_based":22470},{"literal_text_all_w_t_and_m_t":"This field configures UL data transmission when more than two RLC entities are associated with the PDCP entity for DRBs.","paragraph_zero_based":22471},{"literal_text_all_w_t_and_m_t":"outOfOrderDelivery","paragraph_zero_based":22472},{"literal_text_all_w_t_and_m_t":"Indicates whether or not outOfOrderDelivery specified in TS 38.323 [5] is configured. This field should be either always present or always absent, after the radio bearer is established.","paragraph_zero_based":22473},{"literal_text_all_w_t_and_m_t":"pdcp-Duplication","paragraph_zero_based":22474},{"literal_text_all_w_t_and_m_t":"Indicates whether or not uplink duplication status at the time of receiving this IE is configured and activated as specified in TS 38.323 [5]. The presence of this field indicates that duplication is configured. PDCP duplication is not configured for CA packet duplication of LTE RLC bearer. The value of this field, when the field is present, indicates the state of the duplication at the time of receiving this IE. If set to true, duplication is activated. The value of this field is always true, when configured for a SRB. For PDCP entity with more than two associated RLC entities for UL transmission, this field is always present. If the field moreThanTwoRLC-DRB is present, the value of this field is ignored and the state of the duplication is indicated by duplicationState. For PDCP entity with more than two associated RLC entities, only NR RLC bearer is supported.","paragraph_zero_based":22475},{"literal_text_all_w_t_and_m_t":"pdcp-SN-SizeDL","paragraph_zero_based":22476},{"literal_text_all_w_t_and_m_t":"PDCP sequence number size for downlink, 12 or 18 bits, as specified in TS 38.323 [5]. For SRBs only the value len12bits is applicable. The value for this field cannot be changed in case of reconfiguration with sync, if the bearer is configured as DAPS bearer.","paragraph_zero_based":22477},{"literal_text_all_w_t_and_m_t":"pdcp-SN-SizeUL","paragraph_zero_based":22478},{"literal_text_all_w_t_and_m_t":"PDCP sequence number size for uplink, 12 or 18 bits, as specified in TS 38.323 [5]. For SRBs only the value len12bits is applicable. The value for this field cannot be changed in case of reconfiguration with sync, if the bearer is configured as DAPS bearer.","paragraph_zero_based":22479},{"literal_text_all_w_t_and_m_t":"primaryPath","paragraph_zero_based":22480},{"literal_text_all_w_t_and_m_t":"Indicates the cell group ID and LCID of the primary RLC entity as specified in TS 38.323 [5], clause 5.2.1 for UL data transmission when more than one RLC entity is associated with the PDCP entity. In this version of the specification, only cell group ID corresponding to MCG is supported for SRBs, except for the split SRB2 of the IAB-MT, and except when the UE is required to set the primaryPath to refer to the SCG as specified in clause 5.7.3b.4. In this last case, if the network sends an RRCReconfiguration message (in NR-DC) or an EUTRA RRCConnectionReconfiguration message (in (NG)EN-DC) keeping SRB1 as split SRB, the network explicitly configures the primaryPath for the PDCP entity of SRB1 to refer to the MCG. In this version of the specification, only cell group ID corresponding to MCG is supported for DRBs when the SCG is deactivated. The NW indicates cellGroup for split bearers using logical channels in different cell groups. The NW always indicates logicalChannel if CA based PDCP duplication is configured in the cell group indicated by cellGroup of this field.","paragraph_zero_based":22481},{"literal_text_all_w_t_and_m_t":"splitSecondaryPath","paragraph_zero_based":22482},{"literal_text_all_w_t_and_m_t":"Indicates the LCID of the split secondary RLC entity as specified in TS 38.323 [5] for fallback to split bearer operation when UL data transmission with more than two RLC entities is associated with the PDCP entity. This RLC entity belongs to a cell group that is different from the cell group indicated by cellGroup in the field primaryPath.","paragraph_zero_based":22483},{"literal_text_all_w_t_and_m_t":"statusReportRequired","paragraph_zero_based":22484},{"literal_text_all_w_t_and_m_t":"For AM DRBs, AM MRBs and DAPS UM DRBs, indicates whether the DRB or the multicast MRB is configured to send a PDCP status report in the uplink, as specified in TS 38.323 [5]. For DAPS AM DRBs, it also indicates whether the DRB is configured to send a second PDCP status report in the uplink, as specified in TS 38.323 [5].","paragraph_zero_based":22485},{"literal_text_all_w_t_and_m_t":"survivalTimeStateSupport","paragraph_zero_based":22486},{"literal_text_all_w_t_and_m_t":"Indicates whether the DRB associated with this PDCP entity has survival time state support. If this field is configured to be true, all associated RLC entities are activated for PDCP duplication upon reception of a retransmission grant addressed to CS-RNTI, as specified in TS 38.321 [3].","paragraph_zero_based":22487}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["abe8bad8fc40dee7a8c1d2e4bd89622dcc1284d8aab1e9dbf258f1f8a6767615","5e0fd679b0d17f1c6a1f1481ed2ad563dafa03d4def4befd1d16e0f6d2b3edba","7e0026743a9114f4c2c2f6448ab71b210696fa4128856af144043e0991bda14f","d58aa778068e952c7d9b3073064a4a2b46108a413a176c75515c0959049e2e3f","691bef0a9cc17afddac34acd7e43c95e4ba4579b9819e61fd89a4f99b4a27b08","c2409c5092c00c6b48d750a916ad74f9180a2dab88ffa47d9118200638cc7489","03be7227e927f52499d7de901329f6cfc37ff58ac9d98e1b46025399e888623c","c46bddc1b5c7a29cdc9a29b5b3853509fe182bee0e6d44f8799bd308cd55fef9","0ef72d3bf2302d834fbd2bb36b12af420aee86b13c4c903ec82d16ba5bd04d1f","bd434d1d9bbd5ea6d704fb088674a3372aa4fccf9a3aa37224f011c205a82be3","866a9265c982497eefaeb5c6380fd6d3281a2670ae2b8663c578b167b6fdb327","fb19cf488e4e500409b99c9c420dd766059804b9583e61309e09b1d375453398","3bab8032c54e08160393efa68e42eeac95f8c227cfb39952b9b183d2971085e1","ff79753b407abb8847e45dd33d842c9ce514e43e98b23da8dcea4c859ca70509","b560b9c96708e32aad4e0878fcca41e73f264b39f35c52e24cfa87306a2109eb","f57997c0810c21615d9cb923b485280d1b3845ce669ff477c38b462dc94ad0e3","eeb0a67d9402450bdf79cc2016e2895fecfd0ef9b8e9aead4627a6231c2c69f7","6c9818957dd7b1d2211cec4da9384e3e15831acc5fb72f560d16abb2f11f612f","cae16c12000e18a79f14e1450dbd208d5454ee03c220be1b15e285f53beb7f14","4b85688f5147d3e60461a7f172d68d2fb0db6ed1ace45d8caff46189b494a418","7ddc151188579ba5ed9d0482d893a807d29dab18ef780e04c795779ab83223be","ae267be2c5ebd18c6649f499096c5a954e86a64262f7dceb11ff491c75382eed","e3320a9fb83887176bca9121c6302d7ce197eb6ba2e188f7aed5e3ebe96dff70","31bb85882e6f841d54290b3f0099ab74298963f2da7f4217ece75a8c17433e0c"],"paragraph_range_zero_based":[22464,22487],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p22464"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"t-Reordering","paragraph_zero_based":22488},{"literal_text_all_w_t_and_m_t":"Value in ms of t-Reordering specified in TS 38.323 [5]. Value ms0 corresponds to 0 ms, value ms20 corresponds to 20 ms, value ms40 corresponds to 40 ms, and so on.  When the field is absent the UE applies the value infinity. The value for this field cannot be changed in case of reconfiguration with sync, if the bearer is configured as DAPS bearer.","paragraph_zero_based":22489},{"literal_text_all_w_t_and_m_t":"ul-DataSplitThreshold","paragraph_zero_based":22490},{"literal_text_all_w_t_and_m_t":"Parameter specified in TS 38.323 [5]. Value b0 corresponds to 0 bytes, value b100 corresponds to 100 bytes, value b200 corresponds to 200 bytes, and so on. The network sets this field to infinity for UEs not supporting splitDRB-withUL-Both-MCG-SCG and when the SCG is deactivated. If the field is absent when the split bearer is configured for the radio bearer first time, then the default value infinity is applied.","paragraph_zero_based":22491},{"literal_text_all_w_t_and_m_t":"uplinkDataCompression","paragraph_zero_based":22492},{"literal_text_all_w_t_and_m_t":"Indicates the UDC configuration that the UE shall apply. Network does not configure uplinkDataCompression for a DRB, if headerCompression or ethernetHeaderCompression is already configured or outOfOrderDelivery or DAPS is configured for the DRB. The maximum number of DRBs where uplinkDataCompression can be applied is two. The network reconfigures uplinkDataCompression only upon reconfiguration involving PDCP re-establishment. If the field is set to drb-ContinueUDC, the PDCP entity continues the uplink data compression protocol during PDCP re-establishment, as specified in TS 38.323 [5]. The field is set to drb-ContinueUDC only in case of resuming an RRC connection or reconfiguration with sync, where the PDCP termination point is not changed and the fullConfig is not indicated.","paragraph_zero_based":22493},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22494},{"literal_text_all_w_t_and_m_t":"EthernetHeaderCompression field descriptions","paragraph_zero_based":22495},{"literal_text_all_w_t_and_m_t":"drb-ContinueEHC-DL","paragraph_zero_based":22496},{"literal_text_all_w_t_and_m_t":"Indicates whether the PDCP entity continues or resets the downlink EHC header compression protocol during PDCP re-establishment, as specified in TS 38.323 [5]. The field is configured only in case of resuming an RRC connection or reconfiguration with sync, where the PDCP termination point is not changed and the fullConfig is not indicated.","paragraph_zero_based":22497},{"literal_text_all_w_t_and_m_t":"drb-ContinueEHC-UL","paragraph_zero_based":22498},{"literal_text_all_w_t_and_m_t":"Indicates whether the PDCP entity continues or resets the uplink EHC header compression protocol during PDCP re-establishment, as specified in TS 38.323 [5]. The field is configured only in case of resuming an RRC connection or reconfiguration with sync, where the PDCP termination point is not changed and the fullConfig is not indicated.","paragraph_zero_based":22499},{"literal_text_all_w_t_and_m_t":"ehc-CID-Length","paragraph_zero_based":22500},{"literal_text_all_w_t_and_m_t":"Indicates the length of the CID field for EHC packet. The value bits7 indicates the length is 7 bits, and the value bits15 indicates the length is 15 bits. Once the field ethernetHeaderCompression-r16 is configured for a DRB or a multicast MRB, the value of the field ehc-CID-Length for this DRB or multicast MRB is not reconfigured to a different value.","paragraph_zero_based":22501},{"literal_text_all_w_t_and_m_t":"ehc-Common","paragraph_zero_based":22502},{"literal_text_all_w_t_and_m_t":"Indicates the configurations that apply for both downlink and uplink.","paragraph_zero_based":22503},{"literal_text_all_w_t_and_m_t":"ehc-Downlink","paragraph_zero_based":22504},{"literal_text_all_w_t_and_m_t":"Indicates the configurations that apply for only downlink. If the field is configured, then Ethernet header compression is configured for downlink. Otherwise, it is not configured for downlink.","paragraph_zero_based":22505},{"literal_text_all_w_t_and_m_t":"ehc-Uplink","paragraph_zero_based":22506},{"literal_text_all_w_t_and_m_t":"Indicates the configurations that apply for only uplink. If the field is configured, then Ethernet header compression is configured for uplnik. Otherwise, it is not configured for uplink.","paragraph_zero_based":22507},{"literal_text_all_w_t_and_m_t":"maxCID-EHC-UL","paragraph_zero_based":22508},{"literal_text_all_w_t_and_m_t":"Indicates the value of the MAX_CID_EHC_UL parameter as specified in TS 38.323 [5]. The total value of MAX_CID_EHC_UL across all bearers for the UE should be less than or equal to the value of maxNumberEHC-Contexts parameter as indicated by the UE.","paragraph_zero_based":22509},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22510},{"literal_text_all_w_t_and_m_t":"UplinkDataCompression field descriptions","paragraph_zero_based":22511}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["5679d4491ffcbc81aa0f2f54d34b78494606cae2d5d2c3a10edca72f5251a3c1","fec85b77975e082a32adc0b83cffa5d1b4f7ea2d0b3813b56a747149e7258796","26eaec2ada89400b17c8d9a6965704241929416a209080c52c93d7c5699ffb2a","38a6336c6423f7b4544bee8a27202d8562fda970363a9c4a87e1f0188d6071a6","67e372029c68ecdb3f3f9482a794249e55cef36e1366d78531e163d6b47813bc","b95769e82bed0994c6aed792e62af91bbd095200f0f5b0901048edc4d20fd299","825a4de5239309f6ae756d6313799d92c4bcff3137141fa8058037e9e2818e8a","97ce0fee175ae8573a5548e261fd1cea902202c5ff427a653ec4f59fd7b8aa6e","789b97db916de9b697861956d92dcc4f232663abc4aa26fcdbcfebbc826f1cd5","b1ad6258f5cba9be2c8abe236b065ae0a855c096b42762086a45a81a81148113","24af53eeb88c71faf48abd4651668493e3770995be760c8ca058b07b13a93fdc","1d6340d396d848bfadc6776994c80097b5611cbc09944a48db3a4a2c14db01d3","9053fd9249d9c93e6015b3d61b4643167b8ca6ecb0ad0bc12c0d01f08353a144","fe1c6964f1212fa9cf00e50d95c8a3418e8773c324f484342eb263a2181cefc6","bef371eb212542d278f924c5c5fea1dddc960aea44e03badb79220a487c3075a","1d43c189cdd12cdd5dae59209277c5b0add6652c75fdd97656317b4df3b7a32f","5b9860d8dc08a576d6da27fa1b03ffc011803aa4142ab3c4d686c4028c8a824f","05a74cf7cc4c302eac37b889147737f3f4e601fc354e1c85e0cd763721b47121","22d359216a4c9237b9d8004b53c7446a1e6279d81a64e1b25c943b0e281a4e01","637bd5f474eb3e0b6cd727273d9a6321c7aa710f4beb431149057fe3bb62a6e3","f4a1a76692aa344f496a3a29d08668c64860316854386129e4947919df751fdc","8c92f3da3079d53d23a08e7e7381140b5cb52054aeebe1e39ae0f10e78bcad0d","d0971afbf4941e7e636cfcd4ea9b56a4095405066521da3953f21e2a804f1ad7","b20e4e83132ec8a7166fddbe20fd2dfe62ddc8de9974ff0579e0e2ab9a9b60bf"],"paragraph_range_zero_based":[22488,22511],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p22488"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"bufferSize","paragraph_zero_based":22512},{"literal_text_all_w_t_and_m_t":"This field indicates the buffer size applied for UDC as specified in TS 38.323 [5]. Value kbyte2 means 2048 bytes, kbyte4 means 4096 bytes and so on.","paragraph_zero_based":22513},{"literal_text_all_w_t_and_m_t":"dictionary","paragraph_zero_based":22514},{"literal_text_all_w_t_and_m_t":"This field indicates which pre-defined dictionary is used for UDC as specified in TS 38.323 [5]. The value sip-SDP means that UE shall prefill the buffer with standard dictionary for SIP and SDP defined in TS 38.323 [5], and the value operator means that UE shall prefill the buffer with operator-defined dictionary.","paragraph_zero_based":22515},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22516},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":22517},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":22518},{"literal_text_all_w_t_and_m_t":"DRB","paragraph_zero_based":22519},{"literal_text_all_w_t_and_m_t":"This field is mandatory present when the corresponding DRB/multicast MRB is being set up, absent for SRBs. Otherwise this field is optionally present, need M.","paragraph_zero_based":22520},{"literal_text_all_w_t_and_m_t":"DRB2","paragraph_zero_based":22521},{"literal_text_all_w_t_and_m_t":"This field is optionally present in case of DRB, need M. Otherwise, it is absent for SRBs and MRBs.","paragraph_zero_based":22522},{"literal_text_all_w_t_and_m_t":"Drb-Duplication","paragraph_zero_based":22523},{"literal_text_all_w_t_and_m_t":"For SRBs, this field is absent. For DRBs, this field is absent if duplication is not configured. Otherwise, this field is optional, need R.","paragraph_zero_based":22524},{"literal_text_all_w_t_and_m_t":"MoreThanOneRLC","paragraph_zero_based":22525},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon RRC reconfiguration with setup of a PDCP entity for a radio bearer (except for multicast MRB) with more than one associated logical channel and upon RRC reconfiguration with the association of additional logical channels to the PDCP entity.","paragraph_zero_based":22526},{"literal_text_all_w_t_and_m_t":"The field is also mandatory present in case the field moreThanTwoRLC-DRB is included in PDCP-Config.","paragraph_zero_based":22527},{"literal_text_all_w_t_and_m_t":"Upon RRC reconfiguration when a PDCP entity is associated with multiple logical channels, this field is optionally present need M. Otherwise, this field is absent. Need R.","paragraph_zero_based":22528},{"literal_text_all_w_t_and_m_t":"MoreThanTwoRLC-DRB","paragraph_zero_based":22529},{"literal_text_all_w_t_and_m_t":"For SRBs, this field is absent.","paragraph_zero_based":22530},{"literal_text_all_w_t_and_m_t":"For DRBs, this field is mandatory present upon RRC reconfiguration with setup of a PDCP entity for a radio bearer with more than two associated logical channels and upon RRC reconfiguration with the association of one or more additional logical channel(s) to the PDCP entity so that the PDCP entity has more than two associated logical channels.","paragraph_zero_based":22531},{"literal_text_all_w_t_and_m_t":"Upon RRC reconfiguration when a PDCP entity is associated with more than two logical channels, this field is optionally present, Need M. Otherwise, the field is absent, Need R.","paragraph_zero_based":22532},{"literal_text_all_w_t_and_m_t":"Rlc-AM","paragraph_zero_based":22533},{"literal_text_all_w_t_and_m_t":"For RLC AM, the field is optionally present, need M. Otherwise, the field is absent.","paragraph_zero_based":22534},{"literal_text_all_w_t_and_m_t":"Rlc-AM-UM","paragraph_zero_based":22535}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["fd2e3b2f4a87cb2e9096aadc1bbf8c848c254c95483720b202b4d2aa956ec16a","dbc70e14aacf9c763c4c8e27c3b870eb601ff36ed530d0e428c69736402eb0c7","a702832b4aea15393b5e4a9aa5e1abdebb583a288820850af5146587e19db4fb","06e2a0380534d749406b9162441eb552d12041c82b4ef69e06a3d26a0f39668e","477ff7e5c486e61477c71d9af895cfaaa6fe494ec2dfbba317fada139cff4de4","35d28259d93e5c108068d652f215907ab372f21c219df136262ee7710804a756","edc9c2c5f9e169d450b6b325f6c09abbb12aa480b920487ca77ede71499ccbb2","af13bfc53b8062e3771067bb6a09a809d1a19d56312c8fa5501f237af18e294f","83c3a8d8737160cb37781b15ce28aa3c08d81f46b699b66c731096f7cddaeb0d","3f45ee7da7c3129bbd7943347c4af74844ebac2c9603747fc202547d7217ecc3","b2f4450e58f87c311df2fb2b541abd8d2301d3a9150c3e46b96d179742838a83","717fbb890e71085ed0e2ab7855d11fdc8dc04bf4fe4faa65a56fd6427dcc8709","a4f6d06c60f7b6d154def76eefbd045024b17fb3bd69469a91cc42c966b00eba","0d1a5768d95b122cb62d1bd703eba9d0fb5a93a0a98a832063169dff4245a4dd","b15ee6d24895f0cfd5c5e8b9944bcfd04370582e5157e37625b905a93bee73a7","24c99a4dd7c7ce4fa077fe9f4d0218490dfad043c4ed0d44c84df242e1bfa03c","89394587f1e14e4ed6dc10d2fec9e4fdd87dfcf5a276ec2feda165ed2a45d919","bccf8cbcc51e94ace1539dc9eb1a66031392c9f572c9d74457e9bd155abedf49","2d0b2a48c75353b82291baf84bb2a1ad5dd07d703b0874ee0b7d4d1003fb048b","22b7573c47a781db23470daa7d883d68f3de30f229fed71c60dd3999b515f8a5","ea4494669a0544cea6f85ffe004e18d5e3141e33d01a0bfb4268244e08d6a88f","1a49f5e16cba4400658ab2b2d28cfc70139034e25727d0ae09bd2e9bc29c0889","876b1b3d43d491b5b442d3faec0b1081602a9768712a1d95802cb4638c86a99a","a41517b0c76ef0fa47af56de317f37ccff59b9bbe678675fc0ddbcf237fb6682"],"paragraph_range_zero_based":[22512,22535],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p22512"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"In case of DRB, for RLC UM (if the UE supports DAPS handover) or RLC AM, the field is optionally present, need R. In case of multicast MRB, if multicast MRB is associated with at least one RLC AM entity, the field is optionally present, need R. Otherwise, the field is absent.","paragraph_zero_based":22536},{"literal_text_all_w_t_and_m_t":"Setup","paragraph_zero_based":22537},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in case of DRB setup. Otherwise the field is optionally present, need M.","paragraph_zero_based":22538},{"literal_text_all_w_t_and_m_t":"SplitBearer","paragraph_zero_based":22539},{"literal_text_all_w_t_and_m_t":"The field is absent for SRBs. Otherwise, the field is optional present, need M, in case of radio bearer with more than one associated RLC mapped to different cell groups.","paragraph_zero_based":22540},{"literal_text_all_w_t_and_m_t":"SplitBearer2","paragraph_zero_based":22541},{"literal_text_all_w_t_and_m_t":"The field is mandatory present, in case of a split bearer. Otherwise the field is absent.","paragraph_zero_based":22542},{"literal_text_all_w_t_and_m_t":"ConnectedTo5GC","paragraph_zero_based":22543},{"literal_text_all_w_t_and_m_t":"The field is optionally present, need R, if the UE is connected to 5GC. Otherwise the field is absent.","paragraph_zero_based":22544},{"literal_text_all_w_t_and_m_t":"ConnectedTo5GC1","paragraph_zero_based":22545},{"literal_text_all_w_t_and_m_t":"The field is optionally present, need R, if the UE is connected to NR/5GC or if the UE supports user plane integrity protection when connected to E-UTRA/EPC (as specified in TS 33.401 [30]). Otherwise the field is absent.","paragraph_zero_based":22546},{"literal_text_all_w_t_and_m_t":"Setup1","paragraph_zero_based":22547},{"literal_text_all_w_t_and_m_t":"This field is mandatory present in case of DRB setup for RLC-AM and RLC-UM. Otherwise, this field is absent, Need M.","paragraph_zero_based":22548},{"literal_text_all_w_t_and_m_t":"Setup2","paragraph_zero_based":22549},{"literal_text_all_w_t_and_m_t":"This field is mandatory present in case for radio bearer setup for RLC-AM and RLC-UM. Otherwise, this field is absent, Need M.","paragraph_zero_based":22550},{"literal_text_all_w_t_and_m_t":"MRB-Initialization","paragraph_zero_based":22551},{"literal_text_all_w_t_and_m_t":"This field is mandatory present in case of multicast MRB setup. In case of PDCP re-establishment for multicast MRB, this field is optionally present, Need N. Otherwise, this field is absent, Need N.","paragraph_zero_based":22552},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22553},{"literal_text_all_w_t_and_m_t":"–PDSCH-Config","paragraph_zero_based":22554},{"literal_text_all_w_t_and_m_t":"The PDSCH-Config IE is used to configure the UE specific PDSCH parameters. If this IE is used for MBS CFR, the following fields shall be absent: tci-StatesToAddModList, tci-StatesToReleaseList, zp-CSI-RS-ResourceToAddModList, minimumSchedulingOffsetK0, antennaPortsFieldPresenceDCI-1-2, aperiodicZP-CSI-RS-ResourceSetsToAddModListDCI-1-2, aperiodicZP-CSI-RS-ResourceSetsToReleaseListDCI-1-2, dmrs-DownlinkForPDSCH-MappingTypeA-DCI-1-2, dmrs-DownlinkForPDSCH-MappingTypeB-DCI-1-2, dmrs-SequenceInitializationDCI-1-2, harq-ProcessNumberSizeDCI-1-2, mcs-TableDCI-1-2, numberOfBitsForRV-DCI-1-2, pdsch-AggregationFactor, pdsch-TimeDomainAllocationListDCI-1-2, prb-BundlingTypeDCI-1-2, priorityIndicatorDCI-1-2, rateMatchPatternGroup1DCI-1-2, rateMatchPatternGroup2DCI-1-2, resourceAllocationType1GranularityDCI-1-2, vrb-ToPRB-InterleaverDCI-1-2, referenceOfSLIVDCI-1-2, resourceAllocationDCI-1-2, dataScramblingIdentityPDSCH2-r16, repetitionSchemeConfig.","paragraph_zero_based":22555},{"literal_text_all_w_t_and_m_t":"PDSCH-Config information element","paragraph_zero_based":22556},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":22557},{"literal_text_all_w_t_and_m_t":"-- TAG-PDSCH-CONFIG-START","paragraph_zero_based":22558},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22559}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["0337138fd9c0579480870e599ec9f809e75213c4cf1178d7d5e524b1534c8966","82fd309e5e49b6ab171a9d40032670131960879f6d3767ed7fb9debfd72f3953","a2daf24e4420f809f4b092cdc96b4534b2179cfced08c590f21b4bc7b18e98d3","0cc745c0779f8d543e8be6cc72cadbb55f8a0a0175e34309f38082c69aac4a32","2f37b4b142f711e5935374fce35471f3744448233e4b13c25db0cdc0743f3ab1","2bf21c72590bc07c8ee350b30bf893a7506593031b6da1a5d079420f451a968e","3c1ee6016c5c8380ee7cd15f4e153417bebcbe4e2f01bbef26848fe3db2b8aa7","27ad987c7dc5d48cb874ca6abc998c8c2992bb7ba068abe0926682a133cfca43","3aca6ad4306b9eccf24a2dbd317d420dfac1cff5426f6a3c625b1c52ec31521e","8f8bb94467b2950c56cd3cac2bd27ff361cc32866222550936ee5434006b7950","e88a0ff352b99c71d37dc71e45bf52757e41f9163bb829c32b724ec3647919df","5b884ca07735011b52eaaff1c0111109d5fa5fc64e3b32687fc3a13588795c6d","d568847b3587d23f47bdcb09dfbe0231964c9903e898c2dcc3f8948195f0cb57","352099a77a077af781820a89b7920dcc93ee08a76974cd86ede592b171aa8731","8baaf04dd079318f1ac455bc343a62ce6be7708f57ffbe9931274ce21b305433","c3be8cfba42406afcabde12bb4de339ae7cd85d627f6b2628fb74867f0f28016","0370455ca9041882bb83f0e7036d3b885caa4904e0b0ff71f0d2deca23699391","5d38c9029fd0703c8fc2668fe7ee5afcc534e0afbfc3acc50a3875102af6d7b6","0b7bd12c98271de4b38364f649773eb0491250c641dd3ecd76a41a1491b75770","95b7ab60a6a3ac50acbc2ae479284b6a7a2841f3db056a950d8c72d8fcc49aca","30d35c9b6378c21a3ebe55c47fbf5297028847b8dfcc12e19b85f86e37d7dad4","baddaa14e0250afd7022c2c3f4221f4f207a32376a9bd86a1ee9aa640bc56bff","b8e821b7848bed85e5a3609e740153134ef3c73262eb8c3d515080b200240001","95b540fbcb27a400a480e68e74012c52234c6e8c74da80ef0df857990f58ca57"],"paragraph_range_zero_based":[22536,22559],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p22536"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"PDSCH-Config ::=                        SEQUENCE {","paragraph_zero_based":22560},{"literal_text_all_w_t_and_m_t":"    dataScramblingIdentityPDSCH             INTEGER (0..1023)                                                   OPTIONAL,   -- Need S","paragraph_zero_based":22561},{"literal_text_all_w_t_and_m_t":"    dmrs-DownlinkForPDSCH-MappingTypeA      SetupRelease { DMRS-DownlinkConfig }                                OPTIONAL,   -- Need M","paragraph_zero_based":22562},{"literal_text_all_w_t_and_m_t":"    dmrs-DownlinkForPDSCH-MappingTypeB      SetupRelease { DMRS-DownlinkConfig }                                OPTIONAL,   -- Need M","paragraph_zero_based":22563},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22564},{"literal_text_all_w_t_and_m_t":"    tci-StatesToAddModList                  SEQUENCE (SIZE(1..maxNrofTCI-States)) OF TCI-State                  OPTIONAL,   -- Need N","paragraph_zero_based":22565},{"literal_text_all_w_t_and_m_t":"    tci-StatesToReleaseList                 SEQUENCE (SIZE(1..maxNrofTCI-States)) OF TCI-StateId                OPTIONAL,   -- Need N","paragraph_zero_based":22566},{"literal_text_all_w_t_and_m_t":"    vrb-ToPRB-Interleaver                   ENUMERATED {n2, n4}                                                 OPTIONAL,   -- Need S","paragraph_zero_based":22567},{"literal_text_all_w_t_and_m_t":"    resourceAllocation                      ENUMERATED { resourceAllocationType0, resourceAllocationType1, dynamicSwitch},","paragraph_zero_based":22568},{"literal_text_all_w_t_and_m_t":"    pdsch-TimeDomainAllocationList          SetupRelease { PDSCH-TimeDomainResourceAllocationList }             OPTIONAL,   -- Need M","paragraph_zero_based":22569},{"literal_text_all_w_t_and_m_t":"    pdsch-AggregationFactor                 ENUMERATED { n2, n4, n8 }                                           OPTIONAL,   -- Need S","paragraph_zero_based":22570},{"literal_text_all_w_t_and_m_t":"    rateMatchPatternToAddModList            SEQUENCE (SIZE (1..maxNrofRateMatchPatterns)) OF RateMatchPattern   OPTIONAL,   -- Need N","paragraph_zero_based":22571},{"literal_text_all_w_t_and_m_t":"    rateMatchPatternToReleaseList           SEQUENCE (SIZE (1..maxNrofRateMatchPatterns)) OF RateMatchPatternId OPTIONAL,   -- Need N","paragraph_zero_based":22572},{"literal_text_all_w_t_and_m_t":"    rateMatchPatternGroup1                  RateMatchPatternGroup                                               OPTIONAL,   -- Need R","paragraph_zero_based":22573},{"literal_text_all_w_t_and_m_t":"    rateMatchPatternGroup2                  RateMatchPatternGroup                                               OPTIONAL,   -- Need R","paragraph_zero_based":22574},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22575},{"literal_text_all_w_t_and_m_t":"    rbg-Size                                ENUMERATED {config1, config2},","paragraph_zero_based":22576},{"literal_text_all_w_t_and_m_t":"    mcs-Table                               ENUMERATED {qam256, qam64LowSE}                                     OPTIONAL,   -- Need S","paragraph_zero_based":22577},{"literal_text_all_w_t_and_m_t":"    maxNrofCodeWordsScheduledByDCI          ENUMERATED {n1, n2}                                                 OPTIONAL,   -- Need R","paragraph_zero_based":22578},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22579},{"literal_text_all_w_t_and_m_t":"    prb-BundlingType                        CHOICE {","paragraph_zero_based":22580},{"literal_text_all_w_t_and_m_t":"        staticBundling                          SEQUENCE {","paragraph_zero_based":22581},{"literal_text_all_w_t_and_m_t":"            bundleSize                              ENUMERATED { n4, wideband }                                 OPTIONAL    -- Need S","paragraph_zero_based":