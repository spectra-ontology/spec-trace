{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"UL-GapFR2-Config-r17 ::=      SEQUENCE {","paragraph_zero_based":30096},{"literal_text_all_w_t_and_m_t":"    gapOffset-r17                 INTEGER (0..159),","paragraph_zero_based":30097},{"literal_text_all_w_t_and_m_t":"    ugl-r17                       ENUMERATED {ms0dot125, ms0dot25, ms0dot5, ms1},","paragraph_zero_based":30098},{"literal_text_all_w_t_and_m_t":"    ugrp-r17                      ENUMERATED {ms5, ms20, ms40, ms160},","paragraph_zero_based":30099},{"literal_text_all_w_t_and_m_t":"    refFR2-ServCellAsyncCA-r17    ServCellIndex                                                      OPTIONAL -- Cond AsyncCA","paragraph_zero_based":30100},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30101},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30102},{"literal_text_all_w_t_and_m_t":"-- TAG-UL-GAPFR2-CONFIG-STOP","paragraph_zero_based":30103},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":30104},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30105},{"literal_text_all_w_t_and_m_t":"UL-GapFR2-Config field descriptions","paragraph_zero_based":30106},{"literal_text_all_w_t_and_m_t":"gapOffset","paragraph_zero_based":30107},{"literal_text_all_w_t_and_m_t":"Value gapOffset is the gap offset of the FR2 UL gap pattern with UGRP indicated in the field ugrp. The value range is from 0 to ugrp-1.","paragraph_zero_based":30108},{"literal_text_all_w_t_and_m_t":"refFR2-ServCellAsyncCA","paragraph_zero_based":30109},{"literal_text_all_w_t_and_m_t":"Indicates the FR2 serving cell identifier whose SFN and subframe is used for FR2 UL gap calculation for this gap pattern with asynchronous CA involving FR2 carrier(s).","paragraph_zero_based":30110},{"literal_text_all_w_t_and_m_t":"ugl","paragraph_zero_based":30111},{"literal_text_all_w_t_and_m_t":"Value ugl is the gap length in ms of the FR2 UL gap. The FR2 UL gap length is according to Table 9.1.11-1 in TS 38.133 [14]. Value ms0dot125 corresponds to 0.125 ms, ms0dot25 corresponds to 0.25 ms and so on. ","paragraph_zero_based":30112},{"literal_text_all_w_t_and_m_t":"ugrp","paragraph_zero_based":30113},{"literal_text_all_w_t_and_m_t":"Value ugrp is the gap repetition period in (ms) of the FR2 UL gap. The FR2 UL gap repetition period is according to Table 9.1.11-1 in TS 38.133 [14].","paragraph_zero_based":30114},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30115},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":30116},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":30117},{"literal_text_all_w_t_and_m_t":"AsyncCA","paragraph_zero_based":30118},{"literal_text_all_w_t_and_m_t":"This field is mandatory present when configuring FR2 UL gap pattern to UE in:","paragraph_zero_based":30119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["c7307f537f9a613c7785e6616736dfd924948b02b7657185d1f8aa20d9799f59","e2e0bd448840b9d2e2ae9e7999232027267d6893ba56fff5acde821737393763","e14c7875341b1e5e191acc4c78a0345384e0bcaa302d07f4541bd6cb16e8bb57","20baa0cbff19c7beb1174becf64ee5f29f5234cda1b65114551b0e66708c0cb1","3b919ea1490d945fbf17f6216019a63238c766927fe7072e12d8e48b68b42032","55cd205af54f70ec860e04cf516f2ba3c4c00cb2bc057c249df6302aff7b95ca","22d4b2f8d68b123405a4a83c4fd6ea3beebe99f220d796f91a9c8d5bd1567896","234bc2e7f83e6758e2b859fb58d3dcf92ad042b336d097e41ccd0f6fed7af849","c6be2e05552ab6c1150f3ba3db3c4b1c2530e6c3d4171d1f95280a868a3c3fca","8d7ce9e36234f4adff1bc32e1e690a23b1f904b8d21bf93d3e919364852d2a5b","