","6aa94e51165afb2ba94c88c43e873b6455399fe5b2375f72bdbbd333b65914b9","116cd8df15593e303fa0cb3b5e671c4cff12f7dcd096dc5acef6033a130e6c27"],"paragraph_range_zero_based":[600,623],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2401316.zip::R2-2401316 BLE.docx:p600"}
{"fields":{"filename":"R2-2401316.zip::R2-2401316 BLE.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":624},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":625},{"literal_text_all_w_t_and_m_t":"NotSameAsPrev1","paragraph_zero_based":626},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in the first element of the bt-BeaconInfoList list; otherwise if not present, the bt-LCS-GCS-TranslationParameter of this element is the same as the bt-LCS-GCS-TranslationParameter of the previous element in the bt-BeaconInfoList list","paragraph_zero_based":627},{"literal_text_all_w_t_and_m_t":"NotSameAsPrev2","paragraph_zero_based":628},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in the first element of the bt-BeaconInfoList list; otherwise if not present, the bt-antArrayConfig of this element is the same as the bt-antArrayConfig of the previous element in the bt-BeaconInfoList list","paragraph_zero_based":629},{"literal_text_all_w_t_and_m_t":"NotSameAsPrev3","paragraph_zero_based":630},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in the first element of the bt-BeaconInfoList list; otherwise if not present, the bt-antElementList of this element is the same as the bt-antElementList of the previous element in the bt-BeaconInfoList list","paragraph_zero_based":631},{"literal_text_all_w_t_and_m_t":"NotSameAsPrev4","paragraph_zero_based":632},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in the first element of the bt-BeaconInfoList list; otherwise if not present, the bt-antSwitchingPattern of this element is the same as the bt-antSwitchingPattern of the previous element in the bt-BeaconInfoList list","paragraph_zero_based":633},{"literal_text_all_w_t_and_m_t":"NotSameAsPrev5","paragraph_zero_based":634},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in the first element of the bt-BeaconInfoList list; otherwise if not present, the bt-AoDTransmConfig of this element is the same as the bt-AoDTransmConfig of the previous element in the bt-BeaconInfoList list","paragraph_zero_based":635},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":636},{"literal_text_all_w_t_and_m_t":"BT-BeaconInfo field descriptions","paragraph_zero_based":637},{"literal_text_all_w_t_and_m_t":"btAddr","paragraph_zero_based":638},{"literal_text_all_w_t_and_m_t":"This field specifies the Bluetooth public address of the Bluetooth beacon [53].","paragraph_zero_based":639},{"literal_text_all_w_t_and_m_t":"referencePoint","paragraph_zero_based":640},{"literal_text_all_w_t_and_m_t":"This field specifies the reference point used to define the locations of the set of Bluetooth beacons.","paragraph_zero_based":641},{"literal_text_all_w_t_and_m_t":"bt-BeaconLocation","paragraph_zero_based":642},{"literal_text_all_w_t_and_m_t":"This field provides the location of the Bluetooth beacon relative to the referencePoint location. If this field is absent the Bluetooth beacon location coincides with the referencePoint location ","paragraph_zero_based":643},{"literal_text_all_w_t_and_m_t":"bt-LCS-GCS-TranslationParameter","paragraph_zero_based":644},{"literal_text_all_w_t_and_m_t":"This field provides the angles α (bearing angle), β (downtilt angle) and γ (slant angle) for the translation of a Local Coordinate System (LCS) to a Global Coordinate System (GCS) as defined in TR 38.901 [44].","paragraph_zero_based":645},{"literal_text_all_w_t_and_m_t":"polarization","paragraph_zero_based":646},{"literal_text_all_w_t_and_m_t":"This field specifies the antenna element polarization in degrees relative the positive y-axis, where m45, zero, p45, p90 represents -45, zero, 45 and 90 degrees respectively towards the z-axis, and circ represents circular polarization.","paragraph_zero_based":647}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"038bee5e08277a518e210695a9ad796eb7669167fb359201516fcfc3784430d8","original_member_sha256":"e32d7846969fb9d73f3e6db306c1eaae26983884f0f33261ecdad12458f09ea1","paragraph_ElementTree_utf8_XML_sha256":["2f24a4baf598edff1734af0de88d91ee054b13729e68b64cb7aeab3252643cde","7ff0486c52ea2ef035e6584aaa6ac4afb33d5cd70c1726e37890cc9f3a887230","2d4c1f398cd2435446483acf239e10b774b3e7a239094642df67d1a5a6d6eb86","2d9f4cb3c7fca5284029ae34563165245003c1efe6c249194fecf8494fd85b61","d215218a00c06aacec3e14f13e08c7707aff42832248c0a534ac3a7b734fdf23","36cbd2e67ad0fa5e538aa6caac0abfc33c5362efb3ef95b4e08fbd49f19bb994","80ca36ec8d571abb7a448492593237ee8a30ac1b92b086f0ecaaa1d410ca5052","b9554c70f0fc22c8adb0ad90b48d2fb8b861983e1f149195801e86b42b0f3337","980fd74854ab203ea6394eba4b83c2cf51b8762222f4125e73d43312e9685296","79f4f691d7e11f052cbb971b54445981f8ce217043cd9d1d6a77dae691b67ed0","a2c9a6dd87159f4906c301c9e7cc46b502130ff187eb5bf4920d1d139ba85dad","fb545f3e19fa6e6c3f8e1a0e0002097fbb673fbc73c0e22816e17a2b428c5d51","c1c9350802320f517c521ca71384b622a6f6fd99e2a7e75284b5a35428f86a3b","b8c204a9658b0fb0fc887442c0a4a01573d6bad3412a7094f104a4880b723824","a4f97a56d58b78f6bff1aaf73cdec49233b7fe2ef257b8f8ae5d3631228c3ed1","26a8ed2266c17d05975ef1da28ebce4f241953475398180598d650691ca4e2a6","1d9cd09747abf828183a1570ec8e9cf0845fef64e825ae2a9b1290bfc0956dbd","992166e2b4d7a8b1d032cc2b7160d2c16b3154682add7231ce18a29c8fe0cfc6","858b1dfd5d80ba0ea17a4d407d19b4e75c4a7b94151b302ddae1f14c7707da0d","017793862b97d239d0d8605e216a7e0371343af4e4fe1e505718ea303ca2a9dd","a5bf6ffe5f0d693871f7b6729ef1b5144b6bdb3a69682681f319177c56e01b1b","f9e82cb448e49e059a35ca4fecb8ac7d494bf9306a9c103d5d0380bdc8d2293e","e6fde23aa432dd502eb186263b7246c07db24e2594f9279a03a236a87fe46552","c58865478b8b668a1c6710f45f267a2f8a4743e91abe5a11c2fff88f5702065f"],"paragraph_range_zero_based":[624,647],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2401316.zip::R2-2401316 BLE.docx:p624"}
{"fields":{"filename":"R2-2401316.zip::R2-2401316 BLE.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"bt-AoDTransmConfig","paragraph_zero_based":648},{"literal_text_all_w_t_and_m_t":"This field specifies Bluetooth beacon AoD transmission configuration in terms of advertising periodicities and CTE configuration to support the device to configure its scan windows and intervals.","paragraph_zero_based":649},{"literal_text_all_w_t_and_m_t":"primaryAdvInterval","paragraph_zero_based":650},{"literal_text_all_w_t_and_m_t":"This field specifies the Bluetooth primary advertisement channel periodicity used by the Bluetooth beacon, scaling factor 0.625 ms [53].","paragraph_zero_based":651},{"literal_text_all_w_t_and_m_t":"secondAdvInterval","paragraph_zero_based":652},{"literal_text_all_w_t_and_m_t":"This field specifies the Bluetooth periodic advertising interval on secondary advertisement channels used by the Bluetooth beacon, scaling factor 0.625 ms [53].","paragraph_zero_based":653},{"literal_text_all_w_t_and_m_t":"cteLength","paragraph_zero_based":654},{"literal_text_all_w_t_and_m_t":"This field specifies the configured CTE length to be used by the beacon in number of 8us segments.","paragraph_zero_based":655},{"literal_text_all_w_t_and_m_t":"cteCount","paragraph_zero_based":656},{"literal_text_all_w_t_and_m_t":"This field specifies the number of Bluetooth packets that include a CTE that are transmitted each periodic advertising event","paragraph_zero_based":657},{"literal_text_all_w_t_and_m_t":"cteType2us","paragraph_zero_based":658},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that 2us antenna switching slot duration is used by the beacon, otherwise 1us antenna switching slot duration is used,","paragraph_zero_based":659},{"literal_text_all_w_t_and_m_t":"tx-PHY-M2","paragraph_zero_based":660},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that Bluetooth TX PHY 2 Megasymbols/s is used by the beacon, otherwise Bluetooth TX PHY 1 Megasymbols/s is used,","paragraph_zero_based":661},{"literal_text_all_w_t_and_m_t":"bt-antSwitchingPattern","paragraph_zero_based":662},{"literal_text_all_w_t_and_m_t":"This field specifies the Bluetooth antenna switching pattern as a list of indices, where each index is the order value of a specific antenna element in the bt-antElementList-r18 attribute of the IE BT-BeaconInfoElement-r18 – first element in the list corresponds to index 1 and so on. If the antenna switching pattern is shorter than the number of available sample slots, then the antenna switching patterns continues from the beginning of the bt-antSwitchingPattern-r18. If antenna switching pattern is longer than the number of available sample slots, then the elements in bt-antSwitchingPattern-r18 are discarded. If this field is not present, the target device can assume an antenna switching pattern with the configured antenna element in the same order as in the bt-antElementList-r18.","paragraph_zero_based":663},{"literal_text_all_w_t_and_m_t":"antElementIndexShort","paragraph_zero_based":664},{"literal_text_all_w_t_and_m_t":"This field specifies short part of the antenna element index ","paragraph_zero_based":665},{"literal_text_all_w_t_and_m_t":"antElementIndexOffset","paragraph_zero_based":666},{"literal_text_all_w_t_and_m_t":"This field specifies offset of the antenna element index, where o16, o32, o48 and o64 respresents 16, 32, 48 and 64 respectively to offset the short part of the antenna element index. If not present, the offset is zero.","paragraph_zero_based":667},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":668},{"literal_text_all_w_t_and_m_t":"–BT-UniformLinearArray","paragraph_zero_based":669},{"literal_text_all_w_t_and_m_t":"The IE BT-UniformLinearArray is used by the location server to define a linear antenna array as a formula based on the antenna element index.","paragraph_zero_based":670},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"038bee5e08277a518e210695a9ad796eb7669167fb359201516fcfc3784430d8","original_member_sha256":"e32d7846969fb9d73f3e6db306c1eaae26983884f0f33261ecdad12458f09ea1","paragraph_ElementTree_utf8_XML_sha256":["7caeeb1e1e8388349d354734f49c7052574e157b08872bbbc8d592036f88a999","b69ecb53c0b127d52f18ac2ee3777ffaedeca11f35894abee1d28a8849cff20e","92d011fbb5562e3c6dd5410b54cf99bb09e154ee0247452b61d06e206f3c3684","539ac327c3b121d4b205a17145a78def2bf715a1c64f49fa2f0afd24833733f5","95b909c0216a7c5bc67b0ab0b20c33367957a10e096df1970d539c441722a574","11d08aebb65ab4c3eb63d0435ddcf5cf5a43ec87a519fc805971038438d1355c","32a1167edac04355b6097785223349f5dbbdf981db4b99814ef7b424ae211c3f","1b735546603da55b0cd4b1b2051b658523fb2e84d3fbdd67850c4ad99c9892e6","fc5da568c85c8d059ab2c634b85108bf969e16e6b10a92939e0c5cb35d57a98a","6e625b81795d79a760daf6ebb5991f37e86f4f955b2e1efc7405268e09d46854","d30dca191b72c9174d3d4401b3e8e712ad1e347686582c69a74cb68c2e81d077","3d005c3be14a834501a358c450069e19e0aa20722a8cacaca2d4b74fe2797cb4","626d6b1cd1d7f9bd979d70aefbf40d1df654dfdd46ce9b03e04ea228c5de8c4a","c2c4d9d223225a2f45d75e9428283c9d822d55b8c15e83aaaa2d17879544b33a","f294a6a99e8c0b6ec0a0f015e8084b25ef8c0580a34442ef331f47fb0c8557a6","f788b52e6da6bfc7fa449c7a9d5839303ad956ce3eca65dfb4ef1522fdcd1776","f43d3541bf04b1bbb989de13c9c14c309b2d497c65122912bfaf1eb0978ecc44","fdcd4dcc445d7c262c62a25abd3dbaec73b9a5a56634dc127eb3d2792337c919","1d1eb63e3805a0f68b0b0e327e77dba91a6828f73aa5938d2dccc96df9a9e592","1405ab248089f6cc4553812919c038bb3d92e5c7e5419f5f65199050ba8fed55","0d0640e90bd5511fd4eb37a4c77abcf81224b85e52ac486e42a29a335462fd69","6eea1d364f97646dfcad9e559ba82fbfbf88ad78191862f3404c911305dd9504","55975cdc7f05e56e355369b69da187d0925b16f917b6394cbfd563bed88cb5af","7a4cd0c6d587790fe8bd0e71b39006cad002eace43adfcf746bfe3f000dc6c6f"],"paragraph_range_zero_based":[648,671],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2401316.zip::R2-2401316 BLE.docx:p648"}
{"fields":{"filename":"R2-2401316.zip::R2-2401316 BLE.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":672},{"literal_text_all_w_t_and_m_t":"BT-UniformLinearArray-r18 ::= SEQUENCE {","paragraph_zero_based":673},{"literal_text_all_w_t_and_m_t":"bt-NoElements-r18INTEGER (2..maxBT-BeaconAntElt-r18),","paragraph_zero_based":674},{"literal_text_all_w_t_and_m_t":"bt-InterElementDist-r18INTEGER (30..130)","paragraph_zero_based":675},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":676},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":677},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":678},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":679},{"literal_text_all_w_t_and_m_t":"BT-UniformLinearArray field descriptions","paragraph_zero_based":680},{"literal_text_all_w_t_and_m_t":"bt-NoElements","paragraph_zero_based":681},{"literal_text_all_w_t_and_m_t":"This field specifies the number of antenna elements in the linear antenna array. It is the same as the number of antenna elements in the bt-antElementList-r18 of the IE BT-BeaconInfoElement-r18.","paragraph_zero_based":682},{"literal_text_all_w_t_and_m_t":"bt-InterElementDist","paragraph_zero_based":683},{"literal_text_all_w_t_and_m_t":"This field specifies the distance between to adjacent elements in the uniform linear antenna array between ¼ and just above 1 wavelength. Scale factor 1mm.","paragraph_zero_based":684},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":685},{"literal_text_all_w_t_and_m_t":"The antenna element locations of the antenna array are defined along the y-axis from the reference point. The coordinates of the elements are x=0, z=0 and y = (index-1)*bt-InterElementDist-r18, where index is the order value of a specific antenna element in the bt-antElementList-r18 attribute of the IE BT-BeaconInfoElement-r18 – first element in the list corresponds to index 1 and so on.","paragraph_zero_based":686},{"literal_text_all_w_t_and_m_t":"–BT-UniformRectangularArray","paragraph_zero_based":687},{"literal_text_all_w_t_and_m_t":"The IE BT-UniformRectangularArray is used by the location server to define a rectangular antenna array as a formula based on the antenna element index.","paragraph_zero_based":688},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":689},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":690},{"literal_text_all_w_t_and_m_t":"BT-UniformRectangularArray-r18 ::= SEQUENCE {","paragraph_zero_based":691},{"literal_text_all_w_t_and_m_t":"bt-NoElementsY-r18INTEGER (1..maxBT-BeaconAntElt-r18),","paragraph_zero_based":692},{"literal_text_all_w_t_and_m_t":"bt-NoElementsZ-r18INTEGER (1..maxBT-BeaconAntElt-r18),","paragraph_zero_based":693},{"literal_text_all_w_t_and_m_t":"bt-InterElementDistY-r18INTEGER (30..135),","paragraph_zero_based":694},{"literal_text_all_w_t_and_m_t":"bt-InterElementDistZ-r18INTEGER (30..135)","paragraph_zero_based":695}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"038bee5e08277a518e210695a9ad796eb7669167fb359201516fcfc3784430d8","original_member_sha256":"e32d7846969fb9d73f3e6db306c1eaae26983884f0f33261ecdad12458f09ea1","paragraph_ElementTree_utf8_XML_sha256":["f168c8c0ef28812f495146ec95a144351463adb0769264a48b67a4e77a8a54f3","79c3a8d8de7d7a5aeb9b107fbb88ab5756242926c70fa5c1456adb759ad781d8","241d1dbe769bc7fccac5302e5745ed059d921b1c9146964d02b10eb3da146664","7a7486808982833996a6e2446da342c34c6c7ece2d289141abdb1efbca3f17ac","3339cdb990b04b0d2e1174e8b041236fa89232e831a765c4afefddc97f02f5eb","4eb954236eaaf233849eb53af00bb9d70da17f40903f547b15aaf63e0dd4b637","8e57cebf3de7122c20216412dce76b669848edee687814e85ee346f8ab2a1225","96690112664363f75deffb781ad8f1314a502b35caf90bad501e2afc9c70f275","544ddd5ce30ea90716e3efa15293d0c675650e9a506eb1f8f963a6265a7fb42a","fef71c42770d350905faee5f75b0ef06c09395eca6333e0dc15a70d6541b7fe4","1c39e47c78c084b0510b5d5757ed24d46324e9f9718bf97cf2eb853ae5b7eb1b","c726298c5acef7a77ddb11e625cf322a784234a9c4dbf961ea6e7e3340a388e8","1575556bb0cd999e045b6d9d59bae683cede44449a939f67528efbad184f739b","94bbcab4c055190e01dcd3349094aafc97b99b0e5b4151100dab350136070937","3212d48c7e57760504098b293d7a6789ac8f2aa294e496b2b417625a774e71ce","156ec8ce2ba49a7a9304b81ee235068b13cf70666943ef93133c82364e720c93","ff18b27cad6e93cfdfe3e2cd4d83ba3a4d7dbb84b65afbd74120dcbe787b1a4d","b87e98a057fa533e87cc58d7b27e1acc85dedaec60365f347a7ea89c31ae8f0f","8e1e740213c881112c11d18330d5cffa0aaf3712c5f9ecf93c8cb1f4daa64b74","961311a0c87d4a7c5944db58eaee9adb860f719360bf85a507aae9b8b7819e60","8544969828c6820ea6e053ac2a3aa5ab5cb053d96b977157243023a599b9d322","152669bfcd4baee235efa55341b6d596212dff07fc550821cd3cedb469ae729c","94846b22e22014d88eaec5fa51581a458eb73a9d9c5db8e6731782afa0d60027","d057e27666a3135633b774d5b403b4f838828ed6da409d09fadc396a8e4acff4"],"paragraph_range_zero_based":[672,695],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2401316.zip::R2-2401316 BLE.docx:p672"}
{"fields":{"filename":"R2-2401316.zip::R2-2401316 BLE.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":696},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":697},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":698},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":699},{"literal_text_all_w_t_and_m_t":"BT-UniformRectangularArray field descriptions","paragraph_zero_based":700},{"literal_text_all_w_t_and_m_t":"bt-NoElementsY","paragraph_zero_based":701},{"literal_text_all_w_t_and_m_t":"This field specifies the number of antenna elements in the L-shaped antenna array along the y-axis. The product bt-ElementDeltaY* bt-ElementDeltaZ is the same as the number of antenna elements in the bt-antElementList-r18 of the IE BT-BeaconInfoElement-r18.","paragraph_zero_based":702},{"literal_text_all_w_t_and_m_t":"bt-NoElementsZ","paragraph_zero_based":703},{"literal_text_all_w_t_and_m_t":"This field specifies the number of antenna elements in the linear antenna array along the z-axis.","paragraph_zero_based":704},{"literal_text_all_w_t_and_m_t":"bt-InterElementDistY","paragraph_zero_based":705},{"literal_text_all_w_t_and_m_t":"This field specifies the distance between to adjacent elements in the uniform rectangular antenna array along the y-axis.","paragraph_zero_based":706},{"literal_text_all_w_t_and_m_t":"bt-InterElementDistZ","paragraph_zero_based":707},{"literal_text_all_w_t_and_m_t":"This field specifies the distance between to adjacent elements in the uniform rectangular antenna array along the z-axis.","paragraph_zero_based":708},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":709},{"literal_text_all_w_t_and_m_t":"The antenna element locations of the uniform rectangular antenna array are defined row by row along the y-axis with an increasing offset in the z-direction for each row from the reference point. The coordinates of the elements of the","paragraph_zero_based":710},{"literal_text_all_w_t_and_m_t":"-first row are x=0, z=0 and y = (index-1)*bt-InterElementDistY-r18, for index 1 to bt-NoElementsY","paragraph_zero_based":711},{"literal_text_all_w_t_and_m_t":"-second row are x=0, z = bt-InterElementDistZ and y = (index-bt-NoElementsY-1)*bt-InterElementDistY-r18, for index (bt-NoElementsY+1) to 2*bt-NoElementsY","paragraph_zero_based":712},{"literal_text_all_w_t_and_m_t":"-row N are x=0, z = (N-1)*bt-InterElementDistZ and y = (index-(N-1)*bt-NoElementsY-1)*bt-InterElementDistY-r18, for index ((N-1)*bt-NoElementsY+1) to N*bt-NoElementsY, where N = 1 to bt-NoElementsZ.","paragraph_zero_based":713},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":714},{"literal_text_all_w_t_and_m_t":"–BT-UniformCircularArray","paragraph_zero_based":715},{"literal_text_all_w_t_and_m_t":"The IE BT-UniformCircularArray is used by the location server to define a uniform circular antenna array as a formula based on the antenna element index.","paragraph_zero_based":716},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":717},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":718},{"literal_text_all_w_t_and_m_t":"BT-UniformCircularArray-r18 ::= SEQUENCE {","paragraph_zero_based":719}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"038bee5e08277a518e210695a9ad796eb7669167fb359201516fcfc3784430d8","original_member_sha256":"e32d7846969fb9d73f3e6db306c1eaae26983884f0f33261ecdad12458f09ea1","paragraph_ElementTree_utf8_XML_sha256":["ede3d08483265c9404c9aadc8b9185b146313ccc90db37657bda2337756f0276","bec6847be581102eb13ceabe753709c0e40c9b2f5cfa6701d4331cfbbe2b0723","1d77f7a635627ecb3e39db4088eb530d82d29223f948ab0d2f099f551c59ba1d","1283c6467457e39e66bb93a99fc5307e652ccdc22a6c3e6873fb06b90faf3385","769cd4c68a545712539e951769ae8090274633d556dfed7a442c4998d073d39f","906b92b39f7d10f