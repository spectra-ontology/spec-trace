{"fields":{"filename":"R2-2401569.zip::R2-2401569 RRC corrections for XR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>release maxCC-PreferenceConfig for the MCG, if configured and stop timer T346c associated with the MCG, if running;","paragraph_zero_based":3840},{"literal_text_all_w_t_and_m_t":"3>release maxMIMO-LayerPreferenceConfig for the MCG, if configured and stop timer T346d associated with the MCG, if running;","paragraph_zero_based":3841},{"literal_text_all_w_t_and_m_t":"3>release minSchedulingOffsetPreferenceConfig for the MCG, if configured and stop timer T346e associated with the MCG, if running;","paragraph_zero_based":3842},{"literal_text_all_w_t_and_m_t":"3>release rlm-RelaxationReportingConfig for the MCG, if configured and stop timer T346j associated with the MCG, if running;","paragraph_zero_based":3843},{"literal_text_all_w_t_and_m_t":"3>release bfd-RelaxationReportingConfig for the MCG, if configured and stop timer T346k associated with the MCG, if running;","paragraph_zero_based":3844},{"literal_text_all_w_t_and_m_t":"3>release releasePreferenceConfig, if configured and stop timer T346f, if running;","paragraph_zero_based":3845},{"literal_text_all_w_t_and_m_t":"3>release onDemandSIB-Request if configured, and stop timer T350, if running;","paragraph_zero_based":3846},{"literal_text_all_w_t_and_m_t":"3>release referenceTimePreferenceReporting, if configured;","paragraph_zero_based":3847},{"literal_text_all_w_t_and_m_t":"3>release sl-AssistanceConfigNR, if configured;","paragraph_zero_based":3848},{"literal_text_all_w_t_and_m_t":"3>release obtainCommonLocation, if configured;","paragraph_zero_based":3849},{"literal_text_all_w_t_and_m_t":"3>release scg-DeactivationPreferenceConfig, if configured, and stop timer T346i, if running;","paragraph_zero_based":3850},{"literal_text_all_w_t_and_m_t":"3>release musim-GapAssistanceConfig, if configured and stop timer T346h, if running;","paragraph_zero_based":3851},{"literal_text_all_w_t_and_m_t":"3>release musim-GapPriorityAssistanceConfig, if configured;","paragraph_zero_based":3852},{"literal_text_all_w_t_and_m_t":"3>release musim-LeaveAssistanceConfig, if configured;","paragraph_zero_based":3853},{"literal_text_all_w_t_and_m_t":"3>release musim-CapabilityRestrictionConfig, if configured and stop timer T346n, if running;","paragraph_zero_based":3854},{"literal_text_all_w_t_and_m_t":"3>release propDelayDiffReportConfig, if configured;","paragraph_zero_based":3855},{"literal_text_all_w_t_and_m_t":"3>release ul-GapFR2-PreferenceConfig, if configured;","paragraph_zero_based":3856},{"literal_text_all_w_t_and_m_t":"3>release rrm-MeasRelaxationReportingConfig, if configured;","paragraph_zero_based":3857},{"literal_text_all_w_t_and_m_t":"3>release maxBW-PreferenceConfigFR2-2, if configured;","paragraph_zero_based":3858},{"literal_text_all_w_t_and_m_t":"3>release maxMIMO-LayerPreferenceConfigFR2-2, if configured;","paragraph_zero_based":3859},{"literal_text_all_w_t_and_m_t":"3>release minSchedulingOffsetPreferenceConfigExt, if configured;","paragraph_zero_based":3860},{"literal_text_all_w_t_and_m_t":"3>release uav-FlightPathAvailabilityConfig, if configured;","paragraph_zero_based":3861},{"literal_text_all_w_t_and_m_t":"3>release ul-TrafficInfoReportingConfig, if configured, and stop all instances of timer T346l, if running;","paragraph_zero_based":3862},{"literal_text_all_w_t_and_m_t":"3>suspend all RBs, and BH RLC channels for the IAB-MT, except SRB0 and broadcast MRBs;","paragraph_zero_based":3863}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"b3775a5d14ac021fc4f5f3e8002b92527fa1c052d9b7c535f196b5410b17f720","original_member_sha256":"0b2b1acef7c2981dcae001f9ad768411cade15b8ef16fbb988748fdb44fd8de1","paragraph_ElementTree_utf8_XML_sha256":["d74d280912369a9e9cb0c2788a9d9531f876c5e85e