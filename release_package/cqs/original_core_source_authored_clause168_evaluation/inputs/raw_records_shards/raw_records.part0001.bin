{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>consider itself to be configured to provide overheating assistance information in accordance with 5.7.4;","paragraph_zero_based":2400},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":2401},{"literal_text_all_w_t_and_m_t":"3>consider itself not to be configured to provide overheating assistance information and stop timer T345, if running;","paragraph_zero_based":2402},{"literal_text_all_w_t_and_m_t":"1>if the received otherConfig includes the idc-AssistanceConfig:","paragraph_zero_based":2403},{"literal_text_all_w_t_and_m_t":"2>if idc-AssistanceConfig is set to setup:","paragraph_zero_based":2404},{"literal_text_all_w_t_and_m_t":"3>consider itself to be configured to provide IDC assistance information in accordance with 5.7.4;","paragraph_zero_based":2405},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":2406},{"literal_text_all_w_t_and_m_t":"3>consider itself not to be configured to provide IDC assistance information;","paragraph_zero_based":2407},{"literal_text_all_w_t_and_m_t":"1>if the received otherConfig includes the drx-PreferenceConfig:","paragraph_zero_based":2408},{"literal_text_all_w_t_and_m_t":"2>if drx-PreferenceConfig is set to setup:","paragraph_zero_based":2409},{"literal_text_all_w_t_and_m_t":"3>consider itself to be configured to provide its preference on DRX parameters for power saving for the cell group in accordance with 5.7.4;","paragraph_zero_based":2410},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":2411},{"literal_text_all_w_t_and_m_t":"3>consider itself not to be configured to provide its preference on DRX parameters for power saving for the cell group and stop timer T346a associated with the cell group, if running;","paragraph_zero_based":2412},{"literal_text_all_w_t_and_m_t":"1>if the received otherConfig includes the maxBW-PreferenceConfig:","paragraph_zero_based":2413},{"literal_text_all_w_t_and_m_t":"2>if maxBW-PreferenceConfig is set to setup:","paragraph_zero_based":2414},{"literal_text_all_w_t_and_m_t":"3>consider itself to be configured to provide its preference on the maximum aggregated bandwidth for power saving for the cell group in accordance with 5.7.4;","paragraph_zero_based":2415},{"literal_text_all_w_t_and_m_t":"3>if otherConfig includes maxBW-PreferenceConfigFR2-2:","paragraph_zero_based":2416},{"literal_text_all_w_t_and_m_t":"4>consider itself to be configured to provide its preference on the maximum aggregated bandwidth for FR2-2 for power saving for the cell group in accordance with 5.7.4;","paragraph_zero_based":2417},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":2418},{"literal_text_all_w_t_and_m_t":"3>consider itself not to be configured to provide its preference on the maximum aggregated bandwidth for power saving for the cell group and stop timer T346b associated with the cell group, if running;","paragraph_zero_based":2419},{"literal_text_all_w_t_and_m_t":"1>if the received otherConfig includes the maxCC-PreferenceConfig:","paragraph_zero_based":2420},{"literal_text_all_w_t_and_m_t":"2>if maxCC-PreferenceConfig is set to setup:","paragraph_zero_based":2421},{"literal_text_all_w_t_and_m_t":"3>consider itself to be configured to provide its preference on the maximum number of secondary component carriers for power saving for the cell group in accordance with 5.7.4;","paragraph_zero_based":2422},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":2423}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["bd81