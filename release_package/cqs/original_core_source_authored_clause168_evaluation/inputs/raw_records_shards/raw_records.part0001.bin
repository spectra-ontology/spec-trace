{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-RRCSETUPREQUEST-STOP","paragraph_zero_based":11088},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":11089},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11090},{"literal_text_all_w_t_and_m_t":"RRCSetupRequest-IEs field descriptions","paragraph_zero_based":11091},{"literal_text_all_w_t_and_m_t":"establishmentCause","paragraph_zero_based":11092},{"literal_text_all_w_t_and_m_t":"Provides the establishment cause for the RRCSetupRequest in accordance with the information received from upper layers. gNB is not expected to reject an RRCSetupRequest due to unknown cause value being used by the UE.","paragraph_zero_based":11093},{"literal_text_all_w_t_and_m_t":"ue-Identity","paragraph_zero_based":11094},{"literal_text_all_w_t_and_m_t":"UE identity included to facilitate contention resolution by lower layers.","paragraph_zero_based":11095},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11096},{"literal_text_all_w_t_and_m_t":"InitialUE-Identity field descriptions","paragraph_zero_based":11097},{"literal_text_all_w_t_and_m_t":"ng-5G-S-TMSI-Part1","paragraph_zero_based":11098},{"literal_text_all_w_t_and_m_t":"The rightmost 39 bits of 5G-S-TMSI.","paragraph_zero_based":11099},{"literal_text_all_w_t_and_m_t":"randomValue","paragraph_zero_based":11100},{"literal_text_all_w_t_and_m_t":"Integer value in the range 0 to 239 – 1.","paragraph_zero_based":11101},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11102},{"literal_text_all_w_t_and_m_t":"–RRCSystemInfoRequest","paragraph_zero_based":11103},{"literal_text_all_w_t_and_m_t":"The RRCSystemInfoRequest message is used to request SI message(s) required by the UE as specified in clause 5.2.2.3.3 and 5.2.2.3.3a.","paragraph_zero_based":11104},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB0","paragraph_zero_based":11105},{"literal_text_all_w_t_and_m_t":"RLC-SAP: TM","paragraph_zero_based":11106},{"literal_text_all_w_t_and_m_t":"Logical channel: CCCH","paragraph_zero_based":11107},{"literal_text_all_w_t_and_m_t":"Direction: UE to Network","paragraph_zero_based":11108},{"literal_text_all_w_t_and_m_t":"RRCSystemInfoRequest message","paragraph_zero_based":11109},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":11110},{"literal_text_all_w_t_and_m_t":"-- TAG-RRCSYSTEMINFOREQUEST-START","paragraph_zero_based":11111}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["79cde22072d9a27f79880def9b624d10ec961c9d1fd1c7cfd935ea5355a0dfa1","7f1226adc20656d721499380cc65a6d47a84c4ece3ebf871c513c5a6c221489b","35293c0d04cd4968f80d5085ca6b90c6bd7cc7f51e8758b88425dcfeaa210757","4f942d1ce6b4191791997ad23dda95e7efc95496193fea554f896e9defa226b2","bc425d95812aff73684ef9c4693b525c22614bc1b8f856a6a6b64aaf0e5c1361","65d98f7bcccd23d7130cfb80088fcf17399646a710d4cf5735d955a5bd7202bd","1e17300f071dd972d6281c61ca1de1409c63a19f6496fcc8ed2924467b40eba3","cc3248abd28fa11e710f72f68b2a4c19a88c724309c3dd451842ef276baf4140","a4213fe25d71c33b3536623dcd41c4114f006cbb3acbda9c67653b1a6222af67","8b99ff59b6a52abdc334b7c7f27e8768652a2c0d47e5f30fe98bcff1dc311676","2c9d55b6b63e8f24747a6eee4d82242d70e266c4b260dfc0523aa1afb8869211","b0ad547dc0e6a6a57b9dbc51b99d8c55d1a71ebe1bdbe51f23e3a020c3b4e652","afc722ace0bdda0f728f25a0ed0f84588143625181b87dee4282d41bfa3417b2","c29a31ce12e8e1ec47dafe9af2a42d94805bab7af8e8c2b659dcbef38da6cba9","2c8550066062791a32a738f4383b5af9034e9e4f321df6e1d6b942f08f77c1ed","b00bd122004aa4f75cc15200a79d09e44e60995423b47773ff3e8076ae6c3f01","4d0bb