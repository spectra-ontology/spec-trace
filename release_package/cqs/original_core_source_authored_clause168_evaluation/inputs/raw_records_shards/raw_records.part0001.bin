{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    nrofHARQ-ProcessesForPUSCH-r17          ENUMERATED {n32}                                   OPTIONAL,   -- Need R","paragraph_zero_based":24504},{"literal_text_all_w_t_and_m_t":"    uplinkHARQ-mode-r17                     SetupRelease { UplinkHARQ-mode-r17}                     OPTIONAL    -- Need M","paragraph_zero_based":24505},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":24506},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":24507},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24508},{"literal_text_all_w_t_and_m_t":"PUSCH-CodeBlockGroupTransmission ::=    SEQUENCE {","paragraph_zero_based":24509},{"literal_text_all_w_t_and_m_t":"    maxCodeBlockGroupsPerTransportBlock     ENUMERATED {n2, n4, n6, n8},","paragraph_zero_based":24510},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":24511},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":24512},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24513},{"literal_text_all_w_t_and_m_t":"MaxMIMO-LayersDCI-0-2-r16 ::=           INTEGER (1..4)","paragraph_zero_based":24514},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24515},{"literal_text_all_w_t_and_m_t":"UplinkHARQ-mode-r17 ::=                 BIT STRING (SIZE (32))","paragraph_zero_based":24516},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24517},{"literal_text_all_w_t_and_m_t":"-- TAG-PUSCH-SERVINGCELLCONFIG-STOP","paragraph_zero_based":24518},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":24519},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24520},{"literal_text_all_w_t_and_m_t":"PUSCH-CodeBlockGroupTransmission field descriptions","paragraph_zero_based":24521},{"literal_text_all_w_t_and_m_t":"maxCodeBlockGroupsPerTransportBlock","paragraph_zero_based":24522},{"literal_text_all_w_t_and_m_t":"Maximum number of code-block-groups (CBGs) per TB (see TS 38.213 [13], clause 9.1).","paragraph_zero_based":24523},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24524},{"literal_text_all_w_t_and_m_t":"PUSCH-ServingCellConfig field descriptions","paragraph_zero_based":24525},{"literal_text_all_w_t_and_m_t":"codeBlockGroupTransmission","paragraph_zero_based":24526},{"literal_text_all_w_t_and_m_t":"Enables and configures code-block-group (CBG) based transmission (see TS 38.214 [19], clause 5.1.5).","paragraph_zero_based":24527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["3b8e36a034fb621cc290c3ebdf066eb4c27f7ea9988c2850ef22b04347f98a70","c2fcc9c9e6f3a87ecb49da67d4e622c79b3a35d3f9581ae51055bbe543e9933e","463be69ecfcdd0ac62ef319d6378611402a3c2997502acf0bc9b9182d0b1fcf9","a505e24874c384eb737d61ba603a4213e91123f2ac73d364db82b82470032218","418118e8612fb11ad443c19ff80ad77c11ab7af2fa981832f008bb52d22fb8b2","c9d5f74d2001008c68aa2390190dcc5ee804b6c36e1a53784a761795f1665a77","ffb077e584bc0f48134435b6d302e8215c6405b701e2ae0cd156178929ef985a","91af01509cee419aa44f25936e76faf785d8a4422000791198941d8dd8a49940","f6b3a71cbbea2b8c0051df12bb31ef62b1d2c8ae191a9649c60e3735164a014f","a7c8336198e1860570e23e24cdafdb72f34d5713e19bca9399700d55cbb6eb27","e698c30cc77cb2fbd52565a40679710a8252065c481210f0591caec564eeec99","9e6e9a680a58d37c68411d5100069077382d9ee81eb1c608ad111a71bed8d2bd","26cf9e782cdf1d0065ae1d6993678244f7fe4d9da35bda2eff83c2c077e0c56b","be2b1ae2cb27314179b6d230321ada17cce577d5ee79a99535bf1a3bf0e3f80e","33fb3f098fe6cbf87c89ef659e359359f1d52a6c8e6b1691737b7d194e1ee7fc","0c856d31df9466fb24d62faf51a3843f86354053a0fd4f34aa11707c085097ef","24a7ac65a1f3237ad939fb213a455b719c2ff7d17ac80c2c1870baff66efb907","97782e23a1472e6736ed4382adafc623444c61cc04a896f1f621f3a61be200bd","357eafdc74736831642776108b8da04ed53baa5bd5c8980f81e12e69e4f0c36f","6694c28e26109dd65f21ed3b854c33c1917aa1e161fe0954994c8b6c30569337","2d971a97f8c403b6669edfb8a0b63cf9cfb4ae966d0d1827b3e07ce573de5cc3","d570e425e85c39e9464016c3da98661a908ab5ebc5f1dc4fa17fc31c4beab4c9","d8ce7a78001daaf582b30c903c998bb6c1000bb6be2621876d971dc7f1b80ad4","c7721c00a2ec5e5d64e533f60dcee0766939e49267fca47393f92895d2545bea"],"paragraph_range_zero_based":[24504,24527],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p24504"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The network does not configure this field if the SCS of at least one UL BWP configured in the cell is 480 or 960 kHz.","paragraph_zero_based":24528},{"literal_text_all_w_t_and_m_t":"maxMIMO-Layers","paragraph_zero_based":24529},{"literal_text_all_w_t_and_m_t":"Indicates the maximum MIMO layer to be used for PUSCH in all BWPs of the corresponding UL of this serving cell (see TS 38.212 [17], clause 5.4.2.1). If present, the network sets maxRank to the same value. The field maxMIMO-Layers refers to DCI format 0_1.","paragraph_zero_based":24530},{"literal_text_all_w_t_and_m_t":"nrofHARQ-ProcessesForPUSCH","paragraph_zero_based":24531},{"literal_text_all_w_t_and_m_t":"The number of HARQ processes to be used on the PUSCH of a serving cell. Value n32 corresponds to 32 HARQ processes. If the field is absent, the UE uses 16 HARQ processes (see TS 38.214 [19], clause 6.1).","paragraph_zero_based":24532},{"literal_text_all_w_t_and_m_t":"processingType2Enabled","paragraph_zero_based":24533},{"literal_text_all_w_t_and_m_t":"Enables configuration of advanced processing time capability 2 for PUSCH (see 38.214 [19], clause 6.4).","paragraph_zero_based":24534},{"literal_text_all_w_t_and_m_t":"rateMatching","paragraph_zero_based":24535},{"literal_text_all_w_t_and_m_t":"Enables LBRM (Limited buffer rate-matching). When the field is absent the UE applies FBRM (Full buffer rate-matchingLBRM) (see TS 38.212 [17], clause 5.4.2).","paragraph_zero_based":24536},{"literal_text_all_w_t_and_m_t":"xOverhead","paragraph_zero_based":24537},{"literal_text_all_w_t_and_m_t":"If the field is absent, the UE applies the value 'xoh0' (see TS 38.214 [19], clause 5.1.3.2).","paragraph_zero_based":24538},{"literal_text_all_w_t_and_m_t":"maxMIMO-LayersDCI-0-2","paragraph_zero_based":24539},{"literal_text_all_w_t_and_m_t":"Indicates the maximum MIMO layer to be used for PUSCH for DCI format 0_2 in all BWPs of the corresponding UL of this serving cell (see TS 38.212 [17], clause 5.4.2.1). If present, the network sets maxRankDCI-0-2 to the same value.","paragraph_zero_based":24540},{"literal_text_all_w_t_and_m_t":"uplinkHARQ-mode","paragraph_zero_based":24541},{"literal_text_all_w_t_and_m_t":"Used to set the HARQ mode per HARQ process ID, see TS 38.321 [3]. The first/leftmost bit corresponds to HARQ process ID 0, the next bit to HARQ process ID 1 and so on. Bits corresponding to HARQ process IDs that are not configured shall be ignored. A bit set to one identifies a HARQ process with HARQmodeA and a bit set to zero identifies a HARQ process with HARQ modeB. This field applies for SRBs and DRBs.","paragraph_zero_based":24542},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24543},{"literal_text_all_w_t_and_m_t":"–PUSCH-TimeDomainResourceAllocationList","paragraph_zero_based":24544},{"literal_text_all_w_t_and_m_t":"The IE PUSCH-TimeDomainResourceAllocation is used to configure a time domain relation between PDCCH and PUSCH. PUSCH-TimeDomainResourceAllocationList contains one or more of such PUSCH-TimeDomainResourceAllocations. The network indicates in the UL grant which of the configured time domain allocations the UE shall apply for that UL grant. The UE determines the bit width of the DCI field based on the number of entries in the PUSCH-TimeDomainResourceAllocationList. Value 0 in the DCI field refers to the first element in this list, value 1 in the DCI field refers to the second element in this list, and so on.","paragraph_zero_based":24545},{"literal_text_all_w_t_and_m_t":"PUSCH-TimeDomainResourceAllocation information element","paragraph_zero_based":24546},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":24547},{"literal_text_all_w_t_and_m_t":"-- TAG-PUSCH-TIMEDOMAINRESOURCEALLOCATIONLIST-START","paragraph_zero_based":24548},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24549},{"literal_text_all_w_t_and_m_t":"PUSCH-TimeDomainResourceAllocationList ::=  SEQUENCE (SIZE(1..maxNrofUL-Allocations)) OF PUSCH-TimeDomainResourceAllocation","paragraph_zero_based":24550},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24551}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["6511b8eb4904d81fcd1243324242229ec528a66e6ef9beed372c193fcff2b169","cb69e7269d9697630aca80745ecd9695307acc8b17b508554d4f5babfd7f9952","42c4976b0463545f3ce5a282259e4ed92e1bd19a8493e7c3dfb52bb2544e2806","51c3d1708f9cce8bb35075af0aef2e435c395728665d42e4da5037dc3f97405d","1fd2dab26498aac78b0941fed82eeb3f15a5085b5230da7c686f04860e121d6b","34a8c59d4c575756c183c28306e378c3cc8eb5536d88a2e62d40c0aa6eec51e0","5de6db0764620bdb00c88f9e2be36a4bab500d3d6976474e15cfcf0a66153e1e","427a468c7d90bf00a934162c74dd41c5a113a3a404d7d45ce977adb2c1ccd283","faa5b0bd027951177399aa39cd158f25f26be328d8c8a9aa8ae1173ac50af555","c94e962d6169967393be40bc4955b63159dc9093475b04230a1477ab5cbf1b34","c0844b6ef1e9f7b4b8a3acfcae78d93509a0b98a972aafc3da3a3ad7eae1ab60","367cc2d8e25587ed01b6e20c203ccbf846b6ce0a5e299cc5d42f1a7b22a84bf1","8ddcd4b5a9edda131bfb51a16f1853a7e862bdb3c49d7c023afcb096a4a696de","12f8d03ae429f16a5ef5c326a1e8e6d399e14d14ad58853085ca73957045684a","f3377e3ae4f8ca8574ef8e754b346d993ffa66c5f9ace9c2c5da431fc04747f5","cc7d7440e387499342e8644d85d7115b4df49d16c0f95f242945c9c42519e517","9290571d7946c52c5033ca1eeedaa9760f2ba06dd7670eb7d3d43727dcfb3ea7","4b655f08d1e9f5843f5423077b112bb7312aebebdc634dd65d2fea5f70bd8e4b","1857f81672ac2e2ed93c53b0dea8405bdfc36a6d95163a81ae38a935ed0153b5","8555124426bd5dd310b0c41aa8e43c548c7b5aa276dd77556179b2cdf2618a1a","c64e20d6