{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":39048},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39049},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39050},{"literal_text_all_w_t_and_m_t":"MAC-MainConfigSL-r16 ::=                     SEQUENCE {","paragraph_zero_based":39051},{"literal_text_all_w_t_and_m_t":"    sl-BSR-Config-r16                            BSR-Config                                           OPTIONAL,    -- Need M","paragraph_zero_based":39052},{"literal_text_all_w_t_and_m_t":"    ul-PrioritizationThres-r16                   INTEGER (1..16)                                      OPTIONAL,    -- Need M","paragraph_zero_based":39053},{"literal_text_all_w_t_and_m_t":"    sl-PrioritizationThres-r16                   INTEGER (1..8)                                       OPTIONAL,    -- Need M","paragraph_zero_based":39054},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":39055},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39056},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39057},{"literal_text_all_w_t_and_m_t":"SL-ConfiguredGrantConfigList-r16 ::=       SEQUENCE {","paragraph_zero_based":39058},{"literal_text_all_w_t_and_m_t":"    sl-ConfiguredGrantConfigToReleaseList-r16  SEQUENCE (SIZE (1..maxNrofCG-SL-r16)) OF SL-ConfigIndexCG-r16         OPTIONAL, -- Need N","paragraph_zero_based":39059},{"literal_text_all_w_t_and_m_t":"    sl-ConfiguredGrantConfigToAddModList-r16   SEQUENCE (SIZE (1..maxNrofCG-SL-r16)) OF SL-ConfiguredGrantConfig-r16 OPTIONAL  -- Need N","paragraph_zero_based":39060},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39061},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39062},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SCHEDULEDCONFIG-STOP","paragraph_zero_based":39063},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39064},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39065},{"literal_text_all_w_t_and_m_t":"SL-ScheduledConfig field descriptions","paragraph_zero_based":39066},{"literal_text_all_w_t_and_m_t":"sl-CS-RNTI","paragraph_zero_based":39067},{"literal_text_all_w_t_and_m_t":"Indicate the RNTI used to scramble CRC of DCI format 3_0, see TS 38.321 [3].","paragraph_zero_based":39068},{"literal_text_all_w_t_and_m_t":"sl-DCI-ToSL-Trans","paragraph_zero_based":39069},{"literal_text_all_w_t_and_m_t":"Indicate the time gap between DCI reception and the first sidelink transmission scheduled by the DCI (see TS 38.214 [19], clause 8.1.2.1). Value 1 included in this field corresponds to 1 slot, value 2 corresponds to 2 slots and so on, based on the numerology of sidelink BWP.","paragraph_zero_based":39070},{"literal_text_all_w_t_and_m_t":"sl-PSFCH-ToPUCCH","paragraph_zero_based":39071}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["128f08c6a9aeed3f3e8d4718c34004b3787036e344d5af9ff72578001e652a7b","acc8ad28fafa30bfe3c146958df0dbf47f4b98d694273f62f8b4bd6fbe10d264","567a9e5be7659077e262531900b0c7592d5eed98a3351c781e26fcbe0243d9ad","f61f50729d611e46201ea59bf2eb1f49189ee02ded61bd513c5da5ffa269964c","5cf5250e358369b6b36b756dba0d1aa239d363f39bd65020942269a4b4ac77aa","4523a2d0f76ff63f724f08229e27f7f61c260ebc32c4d26cbb27e31a882b3c44","b39143e687c7930f594f95760fb72665027443753eeb0e55444d6fe5059e961c","bcd6c6ecaa0801d70a45fb900c463bb855ba1bcae7970e2ca673bff76f63d398","ad6a293bcf5f89000a4f65b250fe28cb79fa03a7e4e7a21c1a5125816a3df958","3ab6be60271af91fac33a7787430fdb1ccd402c51a2d551734bf166b64f134e7","dce58a9a185b454e3827ab66769596027fb95f9b09354b45ede5a2da699559dd","d19391247d550c90a1771cbea31a8a7d4f79ba01fb29bd29009c389ab9ae6130","5b383f2f11113a4d51aa07930b39fa0bd32693ec90930d596111486b4f4d272f","d400182732f5c66855efe0c05ae9371980a8843d77b63dad789a9d05b164c68a","8f54056bbb8329b14f4d2c16fe52092d5b77e7633bdbffddc8e877479b127bfa","1d4e1b871210c70976fdafe628997faa7dac9866df2b290258a848d17a27089b","10ad30371d23ebf7cb75471af746a2fa6c0c8001205eaf53e94e0da7320a1668","f75dbc6e5e623802ec20de5e5e7df5f20b744cf33f08048114c1c2cfab9959f9","ab4f43bde6f608bd411333949223dbde38afdc1724dd4c16c2787f42a8c07837","305e16168b67c16cb13d70ebc2034010bdf51642f59251ab59498a93c55b6455","6f177d5a1f1e65e1b7605d47ccf4ce6e90ff82582e7573965d6c72ebb5f79981","2d85dda527ccd0c26092b8da9381c712554068e2971abc9608135d869b35a9e6","9ef7eb502b15c51135c517872c40f0070ce68cc6330555cf906a2357fe58002b","ba05353557843d6e14cf2a63bc45db149822eba29706a4f69b0afe044ef56861"],"paragraph_range_zero_based":[39048,39071],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p39048"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"For dynamic grant and configured grant type 2, this field configures the values (in number of slot lengths) of the PSFCH to PUCCH gap. The field PSFCH-to-HARQ_feedback timing indicator in DCI format 3_0 selects one of the configured values of the PSFCH to PUCCH gap.","paragraph_zero_based":39072},{"literal_text_all_w_t_and_m_t":"sl-RNTI","paragraph_zero_based":39073},{"literal_text_all_w_t_and_m_t":"Indicate the SL-RNTI used for monitoring the network scheduling to transmit NR sidelink communication (i.e. the mode 1).","paragraph_zero_based":39074},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39075},{"literal_text_all_w_t_and_m_t":"MAC-MainConfigSL field descriptions","paragraph_zero_based":39076},{"literal_text_all_w_t_and_m_t":"sl-BSR-Config","paragraph_zero_based":39077},{"literal_text_all_w_t_and_m_t":"This field is to configure the sidelink buffer status report.","paragraph_zero_based":39078},{"literal_text_all_w_t_and_m_t":"sl-PrioritizationThres","paragraph_zero_based":39079},{"literal_text_all_w_t_and_m_t":"Indicates the SL priority threshold, which is used to determine whether SL TX is prioritized over UL TX, as specified in TS 38.321 [3]. Network does not configure the sl-PrioritizationThres and the ul-PrioritizationThres to the UE separately.","paragraph_zero_based":39080},{"literal_text_all_w_t_and_m_t":"ul-PrioritizationThres","paragraph_zero_based":39081},{"literal_text_all_w_t_and_m_t":"Indicates the UL priority threshold, which is used to determine whether SL TX is prioritized over UL TX, as specified in TS 38.321 [3]. Network does not configure the sl-PrioritizationThres and the ul-PrioritizationThres to the UE separately.","paragraph_zero_based":39082},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39083},{"literal_text_all_w_t_and_m_t":"–SL-SDAP-Config","paragraph_zero_based":39084},{"literal_text_all_w_t_and_m_t":"The IE SL-SDAP-Config is used to set the configurable SDAP parameters for a Sidelink DRB.","paragraph_zero_based":39085},{"literal_text_all_w_t_and_m_t":"SL-SDAP-Config information element","paragraph_zero_based":39086},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39087},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SDAP-CONFIG-START","paragraph_zero_based":39088},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39089},{"literal_text_all_w_t_and_m_t":"SL-SDAP-Config-r16 ::=                  SEQUENCE {","paragraph_zero_based":39090},{"literal_text_all_w_t_and_m_t":"    sl-SDAP-Header-r16                      ENUMERATED {present, absent},","paragraph_zero_based":39091},{"literal_text_all_w_t_and_m_t":"    sl-DefaultRB-r16                        BOOLEAN,","paragraph_zero_based":39092},{"literal_text_all_w_t_and_m_t":"    sl-MappedQoS-Flows-r16                  CHOICE {","paragraph_zero_based":39093},{"literal_text_all_w_t_and_m_t":"        sl-MappedQoS-FlowsList-r16              SEQUENCE (SIZE (1..maxNrofSL-QFIs-r16)) OF SL-QoS-Profile-r16,","paragraph_zero_based":39094},{"literal_text_all_w_t_and_m_t":"        sl-MappedQoS-FlowsListDedicated-r16     SL-MappedQoS-FlowsListDedicated-r16","paragraph_zero_based":39095}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["7ff443310b097ab32876d86dedac1fd9eda47c6d03b08ddad4342bd72393fcf0","8faa31647670d67196044340b93d468c5d063fc9cc81d3ce96a621b166573404","064c306c1eeb5e219be4b8a7f2fac3723fd07cb3a68baa0f8b5b9a27530f948b","548dd35feb05f1d35c03864651ed15a691385c412bc6febd2c70fc0573f97948","b03da932cf455181cde3