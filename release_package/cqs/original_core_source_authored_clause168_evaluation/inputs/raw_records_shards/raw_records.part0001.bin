{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE MeasId is used to identify a measurement configuration, i.e., linking of a measurement object and a reporting configuration.","paragraph_zero_based":19344},{"literal_text_all_w_t_and_m_t":"MeasId information element","paragraph_zero_based":19345},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":19346},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASID-START","paragraph_zero_based":19347},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19348},{"literal_text_all_w_t_and_m_t":"MeasId ::=                          INTEGER (1..maxNrofMeasId)","paragraph_zero_based":19349},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19350},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASID-STOP","paragraph_zero_based":19351},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":19352},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19353},{"literal_text_all_w_t_and_m_t":"–MeasIdleConfig","paragraph_zero_based":19354},{"literal_text_all_w_t_and_m_t":"The IE MeasIdleConfig is used to convey information to UE about measurements requested to be done while in RRC_IDLE or RRC_INACTIVE.","paragraph_zero_based":19355},{"literal_text_all_w_t_and_m_t":"MeasIdleConfig information element","paragraph_zero_based":19356},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":19357},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASIDLECONFIG-START","paragraph_zero_based":19358},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19359},{"literal_text_all_w_t_and_m_t":"MeasIdleConfigSIB-r16 ::= SEQUENCE {","paragraph_zero_based":19360},{"literal_text_all_w_t_and_m_t":"    measIdleCarrierListNR-r16       SEQUENCE (SIZE (1..maxFreqIdle-r16)) OF MeasIdleCarrierNR-r16          OPTIONAL,     -- Need S","paragraph_zero_based":1