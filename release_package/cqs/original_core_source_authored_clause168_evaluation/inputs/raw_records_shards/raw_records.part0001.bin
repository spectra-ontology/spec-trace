{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE SL-SourceIdentity is used to identify a source of a NR sidelink communication.","paragraph_zero_based":39144},{"literal_text_all_w_t_and_m_t":"SL-SourceIdentity information element","paragraph_zero_based":39145},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39146},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SOURCEIDENTITY-START","paragraph_zero_based":39147},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39148},{"literal_text_all_w_t_and_m_t":"SL-SourceIdentity-r17 ::=   BIT STRING (SIZE (24))","paragraph_zero_based":39149},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39150},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SOURCEIDENTITY-STOP","paragraph_zero_based":39151},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39152},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39153},{"literal_text_all_w_t_and_m_t":"–SL-SRAP-Config","paragraph_zero_based":39154},{"literal_text_all_w_t_and_m_t":"The IE SL-SRAP-Config is used to set the configurable SRAP parameters used by L2 U2N Relay UE and L2 U2N Remote UE as specified in TS 38.351 [66].","paragraph_zero_based":39155},{"literal_text_all_w_t_and_m_t":"SL-SRAP-Config information element","paragraph_zero_based":39156},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39157},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SRAP-CONFIG-START","paragraph_zero_based":39158},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39159},{"literal_text_all_w_t_and_m_t":"SL-SRAP-Config-r17 ::=                  SEQUENCE {","paragraph_zero_based":39160},{"literal_text_all_w_t_and_m_t":"    sl-LocalIdentity-r17                    INTEGER (0..255)                                                 OPTIONAL, -- Need M","paragraph_zero_based":