{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–NG-5G-S-TMSI","paragraph_zero_based":21408},{"literal_text_all_w_t_and_m_t":"The IE NG-5G-S-TMSI contains a 5G S-Temporary Mobile Subscription Identifier (5G-S-TMSI), a temporary UE identity provided by the 5GC which uniquely identifies the UE within the tracking area, see TS 23.003 [21].","paragraph_zero_based":21409},{"literal_text_all_w_t_and_m_t":"NG-5G-S-TMSI information element","paragraph_zero_based":21410},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21411},{"literal_text_all_w_t_and_m_t":"-- TAG-NG-5G-S-TMSI-START","paragraph_zero_based":21412},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21413},{"literal_text_all_w_t_and_m_t":"NG-5G-S-TMSI ::=                         BIT STRING (SIZE (48))","paragraph_zero_based":21414},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21415},{"literal_text_all_w_t_and_m_t":"-- TAG-NG-5G-S-TMSI-STOP","paragraph_zero_based":21416},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21417},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21418},{"literal_text_all_w_t_and_m_t":"–NonCellDefiningSSB","paragraph_zero_based":21419},{"literal_text_all_w_t_and_m_t":"The IE NonCellDefiningSSB is used to configure a NCD-SSB to be used while the UE operates in a RedCap-specific initial BWP or dedicated BWP.","paragraph_zero_based":21420},{"literal_text_all_w_t_and_m_t":"NonCellDefiningSSB information element","paragraph_zero_based":21421},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21422},{"literal_text_all_w_t_and_m_t":"-- TAG-NONCELLDEFININGSSB-START","paragraph_zero_based":21423},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21424},{"literal_text_all_w_t_and_m_t":"NonCellDefiningSSB-r17 ::=      SEQUENCE {","paragraph_zero_based":21425},{"literal_text_all_w_t_and_m_t":"    absoluteFrequencySSB-r17        ARFCN-ValueNR,","paragraph_zero_based":21426},{"literal_text_all_w_t_and_m_t":"    ssb-Periodicity-r17             ENUMERATED { ms5, ms10, ms20, ms40, ms80, ms160, spare2, spare1 }       OPTIONAL,   -- Need S","paragraph_zero_based":21427},{"literal_text_all_w_t_and_m_t":"    ssb-TimeOffset-r17              ENUMERATED { ms5, ms10, ms15, ms20, ms40, ms80, spare2, spare1 }      OPTIONAL,   -- Need S","paragraph_zero_based":21428},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":21429},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21430},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21431}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["27b9a563d186b452a7176dc1a1ee4f96000ca2888f1ded0ceb9003f301f29371","d2867c6f6833e3043107e9fa6d9a8f670e7dda94e3f57111451cc030da9eebb7","f204b595b774a55c614dd9f958aa0414b6c4997b12c8feda40c3e103d5b5cb54","ae297b8d6ff1b79bb0be6b75d53104a50700116603aa9dc6e289bd2b8af3409c","9f7d530104dff8897608ea8c63b9e349d47a745e4229d9bfc51d990dba8739f7","1bfa0beea11c5424f231174cfeebac43d2e0ce45606f4551731f8f0ea1527ca9","783b490b9bdb0d07aeed21a196e941f5ff63e347571efe890ebeafc705dd9fcc","fb3930abf1125ae798dcd140d6ef4b2da690cad8fc38490ac096dbafc486434d","2945ad74b4d9a0deb0f15d4d4a91c6e32e985983f3accebeb34b96dfa19658e0","c88d57326f9129fb98cac7f765c023643297e4b3717f140698539d3e66d26976","99fa15918f9d43cb2929029f11c926e43cef6a16cad06d2db36b8d7726308f5c","f3e5f6e4135e8b25c7ab98259c38f5818b29f6aa0afe49a460272ecfa0c1374a","9abc354d22502624ab90762485d66c902cbb65caf31dfec57baddf7d79f1daa3","eaac34c5d072e2c9d433a4579b5e877d01390e91217b4af7daa558eb278e9963","4b3ee0b6f311e9f69a5bd7d0e8864f2386af024cc2010fa511e913a0bcabc11c","e82f8d202094bca5bcf15d82ee174c6b5b70a3ea4cbd991fe942f1b445a4fac7","43f270485ac332d7356bbbdbdbc4cad075d4eeebcf318733fc71e030e7ecce95","b5398b4594403005bc07b1e35bb84ccebd94224ad6602be06353f535e1eae626","6eb970392b1db64566a5357afa3388ed9cb1966b52d700e199f07b226670e178","e443987e2e0a9f63d4d0173fc4e977ce2320382909522a541e23adda423b62ec","aa37f97b7dca7e0957ca4a51a028202e70186ca9295a0c0e1f1f35009e2e8d0a","40b4a1cda2ad5d0713fc76ebaeefdb8c94fd1f3a1965ab32a2e5b6e333ac11b8","d2e0d0eb333ad4c62d014a33b79144a3e8f6e5472c72fd18731ee9bd976e3ce7","8c24c7d746da027cc5fceb194a64d24c5b2a0dbc780b82ce963f7487b4074e25"],"paragraph_range_zero_based":[21408,21431],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p21408"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-NONCELLDEFININGSSB-STOP","paragraph_zero_based":21432},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21433},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21434},{"literal_text_all_w_t_and_m_t":"NonCellDefiningSSB field descriptions","paragraph_zero_based":21435},{"literal_text_all_w_t_and_m_t":"absoluteFrequencySSB","paragraph_zero_based":21436},{"literal_text_all_w_t_and_m_t":"Frequency of the NCD-SSB. The network configures this field so that the SSB is within the bandwidth of the BWP configured in BWP-DownlinkCommon.","paragraph_zero_based":21437},{"literal_text_all_w_t_and_m_t":"ssb-Periodicity","paragraph_zero_based":21438},{"literal_text_all_w_t_and_m_t":"The periodicity of this NCD-SSB. The network configures only periodicities that are larger than the periodicity of serving cell's CD-SSB. If the field is absent, the UE applies the SSB periodicity of the CD-SSB (ssb-periodicityServingCell configured in ServingCellConfigCommon or ServingCellConfigCommonSIB).","paragraph_zero_based":21439},{"literal_text_all_w_t_and_m_t":"ssb-TimeOffset","paragraph_zero_based":21440},{"literal_text_all_w_t_and_m_t":"The time offset between CD-SSB of the serving cell and this NCD-SSB. Value ms5 means the first burst of NCD-SSB is transmitted 5ms later than the first burst of CD-SSB transmitted after the first symbol of SFN=0 of the serving cell, value ms10 means the first burst of NCD-SSB is transmitted 10ms later than the first burst of CD-SSB transmitted after the first symbol in SFN=0 of the serving cell, and so on. If the field is absent, RedCap UE considers that the time offset between the first burst of CD-SSB transmitted in the serving cell and the first burst of this NCD-SSB transmitted is zero.","paragraph_zero_based":21441},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21442},{"literal_text_all_w_t_and_m_t":"–NPN-Identity","paragraph_zero_based":21443},{"literal_text_all_w_t_and_m_t":"The IE NPN-Identity includes either a list of CAG-IDs or a list of NIDs per PLMN Identity. Further information regarding how to set the IE is specified in TS 23.003 [21].","paragraph_zero_based":21444},{"literal_text_all_w_t_and_m_t":"NPN-Identity information element","paragraph_zero_based":21445},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21446},{"literal_text_all_w_t_and_m_t":"-- TAG-NPN-IDENTITY-START","paragraph_zero_based":21447},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21448},{"literal_text_all_w_t_and_m_t":"NPN-Identity-r16 ::=             CHOICE {","paragraph_zero_based":21449},{"literal_text_all_w_t_and_m_t":"    pni-npn-r16                      SEQUENCE {","paragraph_zero_based":21450},{"literal_text_all_w_t_and_m_t":"        plmn-Identity-r16                PLMN-Identity,","paragraph_zero_based":21451},{"literal_text_all_w_t_and_m_t":"        cag-IdentityList-r16             SEQUENCE (SIZE (1..maxNPN-r16)) OF CAG-IdentityInfo-r16","paragraph_zero_based":21452},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":21453},{"literal_text_all_w_t_and_m_t":"    snpn-r16                         SEQUENCE {","paragraph_zero_based":21454},{"literal_text_all_w_t_and_m_t":"        plmn-Identity-r16                PLMN-Identity,","paragraph_zero_based":21455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["b2a2849878afcc44f1e19dff74e3483092d08197760862a147ae51fb32fc4edd","ed22df471f0f3a04c6368808c2727405a7eeabf6a229e837ac92aa943d81b374","8ee9002e812b693b