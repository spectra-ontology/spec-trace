{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"PUCCH-SRS ::=                       SEQUENCE {","paragraph_zero_based":23688},{"literal_text_all_w_t_and_m_t":"    resource                            SRS-ResourceId,","paragraph_zero_based":23689},{"literal_text_all_w_t_and_m_t":"    uplinkBWP                           BWP-Id","paragraph_zero_based":23690},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":23691},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23692},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-SPATIALRELATIONINFO-STOP","paragraph_zero_based":23693},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23694},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23695},{"literal_text_all_w_t_and_m_t":"PUCCH-SpatialRelationInfo field descriptions","paragraph_zero_based":23696},{"literal_text_all_w_t_and_m_t":"pucch-PathLossReferenceRS-Id","paragraph_zero_based":23697},{"literal_text_all_w_t_and_m_t":"When pucch-PathLossReferenceRS-Id-v1610 is configured, the UE shall ignore pucch-PathLossReferenceRS-Id (without suffix).","paragraph_zero_based":23698},{"literal_text_all_w_t_and_m_t":"pucch-SpatialRelationInfoId","paragraph_zero_based":23699},{"literal_text_all_w_t_and_m_t":"When pucch-SpatialRelationInfoId-v1610 is configured, the UE shall ignore pucch-SpatialRelationInfoId (without suffix). If pucch-SpatialRelationInfoId-v1610 is absent, the UE shall use the pucch-SpatialRelationInfoId (without suffix).","paragraph_zero_based":23700},{"literal_text_all_w_t_and_m_t":"servingCellId","paragraph_zero_based":23701},{"literal_text_all_w_t_and_m_t":"If the field is absent, the UE applies the ServCellId of the serving cell in which this PUCCH-SpatialRelationInfo is configured","paragraph_zero_based":23702},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23703},{"literal_text_all_w_t_and_m_t":"–PUCCH-SpatialRelationInfo-Id","paragraph_zero_based":23704},{"literal_text_all_w_t_and_m_t":"The IE PUCCH-SpatialRelationInfo-Id is used to identify a PUCCH-SpatialRelationInfo","paragraph_zero_based":23705},{"literal_text_all_w_t_and_m_t":"PUCCH-SpatialRelationInfo-Id information element","paragraph_zero_based":23706},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":23707},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-SPATIALRELATIONINFO-START","paragraph_zero_based":23708},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23709},{"literal_text_all_w_t_and_m_t":"PUCCH-SpatialRelationInfoId ::=         INTEGER (1..maxNrofSpatialRelationInfos)","paragraph_zero_based":23710},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23711}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["3a4d26719c68266f327ba06113336f442d46a35f2bd281a0cd8613f8267ba258","3b6ef2997a0fb5e0f34bfffa34db7d19db723797b4fa46d5b1d3f451a70eb38d","c195fff573990e1ccdb28fa0658f3deaf8c80fc6e288b33a90adf9b6c45091a1","5550b5a55ce51f4c98a179dd828dbe35c6d45d9e9d5d35919712b1457308e8fe","30aa9018356c13640badc72c003928bd2523e6a1bc73edb434bfec2ed0d8a86e","a8ffec7f3e61a956616513484c344483a7509a43f63793c3c1dd4e38ad2f3709","58fce72f5881985d473c12c70d68ce90465a68cf17cdfeed53cfefc2f751e104","bbb6a8d34aede1abeae8198cc5ce284b2c3f07049b52865650339aa4633a54d8","c9f1e514fb94c0e88ec418455e2f8d7d0d850d348fc3b4a2eac341a2d3a05f3f","17b593d3f80f548350c2966e583e503b9858812b6a52756e5d7a97826fe6871f","d7d400410e3df3d5fd5bf6f538f273b72abb06c738fe7108a2dfe59099b58909","4f540b844362ead9e662c5df7e144433ac66edb6b01af7695b304f1d2a53812f","ba51b1adce19c0fbaebc3b71a3cdf0b