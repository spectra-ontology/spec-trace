{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The nid-List contains one or more NID.","paragraph_zero_based":21480},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21481},{"literal_text_all_w_t_and_m_t":"–NPN-IdentityInfoList","paragraph_zero_based":21482},{"literal_text_all_w_t_and_m_t":"The IE NPN-IdentityInfoList includes a list of NPN identity information.","paragraph_zero_based":21483},{"literal_text_all_w_t_and_m_t":"NPN-IdentityInfoList information element","paragraph_zero_based":21484},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21485},{"literal_text_all_w_t_and_m_t":"-- TAG-NPN-IDENTITYINFOLIST-START","paragraph_zero_based":21486},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21487},{"literal_text_all_w_t_and_m_t":"NPN-IdentityInfoList-r16 ::=     SEQUENCE (SIZE (1..maxNPN-r16)) OF NPN-IdentityInfo-r16","paragraph_zero_based":21488},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21489},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21490},{"literal_text_all_w_t_and_m_t":"NPN-IdentityInfo-r16 ::=         SEQUENCE {","paragraph_zero_based":21491},{"literal_text_all_w_t_and_m_t":"    npn-IdentityList-r16             SEQUENCE (SIZE (1..maxNPN-r16)) OF NPN-Identity-r16,","paragraph_zero_based":21492},{"literal_text_all_w_t_and_m_t":"    trackingAreaCode-r16             TrackingAreaCode,","paragraph_zero_based":21493},{"literal_text_all_w_t_and_m_t":"    ranac-r16                        RAN-AreaCode                                                OPTIONAL,       -- Need R","paragraph_zero_based":21494},{"literal_text_all_w_t_and_m_t":"    cellIdentity-r16                 CellIdentity,","paragraph_zero_based":21495},{"literal_text_all_w_t_and_m_t":"    cellReservedForOperatorUse-r16   ENUMERATED {reserved, notReserved},","paragraph_zero_based":21496},{"literal_text_all_w_t_and_m_t":"    iab-Support-r16                  ENUMERATED {true}                                           OPTIONAL,       -- Need S","paragraph_zero_based":21497},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":21498},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":21499},{"literal_text_all_w_t_and_m_t":"    gNB-ID-Length-r17                INTEGER (22..32)                                            OPTIONAL        -- Need R","paragraph_zero_based":21500},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":21501},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21502},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["8a57ab548873993597d383453090f327b849111cbfdcc308357fd59089f40c1a","5d682ea504f711352713035eb815be977c63982a61c55f784834bd3a004a1a94","97dc227577ed630e1ddfeee0fcb127a20f450f37120b03c676c982a1426cee4b","2cd61bf385e6a2407a68e37a478bf45fc46ffa4124d87549188f1da2bf9107e9","4683b7dc58a8d31c5dd060495e07ba868dd49c126e6d67afda265c31c4c230bf","16ec97bfdf4bae8bf1b4e87ddbd57146a4e81a637596c0f15f934973e4c30f47","4bd244e58fa9a89ff4541b3c334a2f635172680605bade0b7fc934f3c7138bcc","7c2dddc16b653d9c56dc574634e4c1ca1425c3d277b2493a9bb57b7b3a0cdc14","f4475d4430aa1399f8b7e8d9a7b7d7c753a0cd60c84b75a09e5b322b971d8e01","f844f4fff42434354fa933e5ad59c6480bd9d812e92b5f53ed433fad8893adeb","4dad2542efaf9f42334f17a775fe8b72d0dc5d589bbd472d20f96046e0d2818d","49408fab57e2a08c12c3b8c344b51f145fa6ad6f7abcd4d08efee804d44db52f","9617bffc8adac1f9b90c9b4e80d99e3d099a501e65da23b296f31eaaa40d8a30","cc6143d1074b6890f0773510b78fd283c9c5e9f8fe00113380c410e7c39e4dc1","4ce68e2bf2432e183a80201f067690411e71c61f8b752f888831e6ac2672bf79","4045d4fb211b6882e50216d12d6254a302a0dbb063971ed8e7b6638aeb59305b","8fe146881a28f2ebf3d7f54091c4f411ffa2b46dcaee19bfd23d567dd98b9d4f","c4c5a6597c82361ffeb9a753d370c6d2e28653a442eff37b2ecfd763e897e8c2","fadd09ea0ab8cc2c0549c293ec1619a7caa4c2f35784f140b2a6dd321f975aec","5e05a39a4b67d8215c0384175ee1422c64d12be1747c89b128519fc3aa355c42","8383a43aa5f6e5b3fa5312811a47455359ce321367e6b1fb9ebff6d12803d10d","cfb71a23e4e0ac3c4b540e7dd2485a23776a7b56de6836bd2f22d6696864bac2","24bf2664e41b69735e6ac83f612d72618ed225a13933a76a1bce4ac103ea3244","d646d7e5bd314cc01bfe3926bad6a39ff436cbf1ffcf0b27e34d40ad545a09d5"],"paragraph_range_zero_based":[21480,21503],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p21480"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-NPN-IDENTITYINFOLIST-STOP","paragraph_zero_based":21504},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21505},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21506},{"literal_text_all_w_t_and_m_t":"NPN-IdentityInfoList field descriptions","paragraph_zero_based":21507},{"literal_text_all_w_t_and_m_t":"iab-Support","paragraph_zero_based":21508},{"literal_text_all_w_t_and_m_t":"This field combines both the support of IAB and the cell status for IAB. If the field is present, the cell supports IAB and the cell is also considered as a candidate for cell (re)selection for IAB-nodes; if the field is absent, the cell does not support IAB and/or the cell is barred for IAB-node.","paragraph_zero_based":21509},{"literal_text_all_w_t_and_m_t":"gNB-ID-Length","paragraph_zero_based":21510},{"literal_text_all_w_t_and_m_t":"Indicates the length of the gNB ID out of the 36-bit long cellIdentity.","paragraph_zero_based":21511},{"literal_text_all_w_t_and_m_t":"NPN-IdentityInfo","paragraph_zero_based":21512},{"literal_text_all_w_t_and_m_t":"The NPN-IdentityInfo contains one or more NPN identities and additional information associated with those NPNs. Only the same type of NPNs (either SNPNs or PNI-NPNs) can be listed in a NPN-IdentityInfo element.","paragraph_zero_based":21513},{"literal_text_all_w_t_and_m_t":"npn-IdentityList","paragraph_zero_based":21514},{"literal_text_all_w_t_and_m_t":"The npn-IdentityList contains one or more NPN Identity elements.","paragraph_zero_based":21515},{"literal_text_all_w_t_and_m_t":"trackingAreaCode","paragraph_zero_based":21516},{"literal_text_all_w_t_and_m_t":"Indicates the Tracking Area Code to which the cell indicated by cellIdentity field belongs. ","paragraph_zero_based":21517},{"literal_text_all_w_t_and_m_t":"ranac","paragraph_zero_based":21518},{"literal_text_all_w_t_and_m_t":"Indicates the RAN Area Code to which the cell indicated by cellIdentity field belongs. ","paragraph_zero_based":21519},{"literal_text_all_w_t_and_m_t":"cellReservedForOperatorUse","paragraph_zero_based":21520},{"literal_text_all_w_t_and_m_t":"Indicates whether the cell is reserved for operator use (for the NPN(s) identified in the npn-IdentityList) as defined in TS 38.304 [20]. This field is ignored by NPN capable IAB-MT.","paragraph_zero_based":21521},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21522},{"literal_text_all_w_t_and_m_t":"–NR-DL-PRS-PDC-Info","paragraph_zero_based":21523},{"literal_text_all_w_t_and_m_t":"The IE NR-DL-PRS-PDC-Info defines downlink PRS configuration for PDC.","paragraph_zero_based":21524},{"literal_text_all_w_t_and_m_t":"NR-DL-PRS-PDC-Info information element","paragraph_zero_based":21525},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21526},{"literal_text_all_w_t_and_m_t":"-- TAG-NR-DL-PRS-PDC-INFO-START","paragraph_zero_based":21527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["5d15020461d0a9a1292eb9ce8bb0eaa69d11dd17e141045143f5e37884d66057","9acf463331cb790b512d9e5ce883da0bc055bfe6ccba5ccb3d48e31c529ca81c","3f7d701f86fe7ae155239c2e0f7a36076e68982a9338f93c58ec0a0f3118e975","3ff6b6b6db19f364e152dd0e59c4323bbe762d2fc2b74205c7ebfa8070f8f220","74b3e0b2db0639ef3f8bc8aa8309554905a84518e80a48b4afc33e2bd0784c43","fd76b7815b30e3ff7d1245e411f74c518710feba24c718173a86171d530bcb8a","da0bba309ef017ebabf7b113f9cc4ab7fc7115077a72ec7cea280e14b45be7c0","0e2bb1acfa821758313ab6397fd84a84c833803d8253f8eab1e32615388a8442","b41795c3b16ca35bd4575d47a657530