{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"IAB-ResourceConfigID-r17 ::=        INTEGER(0..maxNrofIABResourceConfig-1-r17)","paragraph_zero_based":15648},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15649},{"literal_text_all_w_t_and_m_t":"ReportUplinkTxDirectCurrentMoreCarrier-r17 ::= SEQUENCE (SIZE(1.. maxSimultaneousBands)) OF IntraBandCC-CombinationReqList-r17","paragraph_zero_based":15650},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15651},{"literal_text_all_w_t_and_m_t":"IntraBandCC-CombinationReqList-r17::=   SEQUENCE {","paragraph_zero_based":15652},{"literal_text_all_w_t_and_m_t":"    servCellIndexList-r17                   SEQUENCE (SIZE(1.. maxNrofServingCells)) OF ServCellIndex,","paragraph_zero_based":15653},{"literal_text_all_w_t_and_m_t":"    cc-CombinationList-r17                  SEQUENCE (SIZE(1.. maxNrofReqComDC-Location-r17)) OF IntraBandCC-Combination-r17","paragraph_zero_based":15654},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":15655},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15656},{"literal_text_all_w_t_and_m_t":"IntraBandCC-Combination-r17::=      SEQUENCE (SIZE(1.. maxNrofServingCells)) OF CC-State-r17","paragraph_zero_based":15657},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15658},{"literal_text_all_w_t_and_m_t":"CC-State-r17::=                     SEQUENCE {","paragraph_zero_based":15659},{"literal_text_all_w_t_and_m_t":"    dlCarrier-r17                       CarrierState-r17                             OPTIONAL, -- Need N","paragraph_zero_based":15660},{"literal_text_all_w_t_and_m_t":"    ulCarrier-r17                       CarrierState-r17                             OPTIONAL  -- Need N","paragraph_zero_based":15661},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":15662},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15663},{"literal_text_all_w_t_and_m_t":"CarrierState-r17::=                 CHOICE {","paragraph_zero_based":15664},{"literal_text_all_w_t_and_m_t":"    deActivated-r17                     NULL,","paragraph_zero_based":15665},{"literal_text_all_w_t_and_m_t":"    activeBWP-r17                       INTEGER (0..maxNrofBWPs)","paragraph_zero_based":15666},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":15667},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15668},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLGROUPCONFIG-STOP","paragraph_zero_based":15669},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":15670},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["251f012b73fde81c0943638af546e31f12c77557bf9cfaec6d9fa4b692e09028","b2253082659f0299c660aaed6d905748f5fb910cecb827ad22b1d916379c6918","287191fd06e57d03694528707b1d0f009a6601b01e05c231f3249c03e91f0532","d745dc6e22b927bdbf5bbee280df498cdaf31a40a7b13bbddd5ab553d269c177","0907b087a025ac7d56d59f1f3fd8ecffeec917846683a19ef331a8c5e7e5ea1e","72731b38c57833673d162a0c1dfcd21fd3941ac565a4bf42da1be1cf95d3a3fd","7999b27fdfc5dae187fa416f12a96761b476e9286f6236aba8433795427100ae","1df23acf3f91b74e9ad484798faf6fee4b072f90e88851cc2966d70d59a16d27","7f7b604048a80504de59d6b756b9d4224f9c519577827ad0846b0eae49e9dff2","8a5c13ac3cbef88774fabd8e9eed9b4c54f5ff1c1675c78fd85cb56b9bc9d237","65eb6751841bc3809f1c68dc8ef5ba179c086d29c2511dc3290c8416386d6336","1b4290277907844f51ee776c54593174f1dfeee1c45c92bdb95c441dad15a74c","df9d9a5a4e9624d0c59de0b34b533ba49b0f7ee041e9441051387bb8d703de7c","6437870b050c86e36648c2731412347385135eee62ba3934d04ee99a621b8159","003e3928d06cef2bba69b1c31b3b46e76232f6a37c8a29d94decc3105664ef60","fc5b761f90624d032cfb186675eef386eb64952717ef1f9eab68f3b83cb92687","7157d8988b29620c7ce57dc20450220a9e2a0c16fa4f6297350af29de633046b","4dcbc7832ede8427c7166207a0869a1125285009f42f988f35b913a4e2bda69a","1290f9332b215e446991363e605a98a1e09e16a5f74042534ed58f9eeb294981","61f1abc57eed9ade7f7722cad8cb1e6bdb7b83402063ce4eb60e5d2f5d016d4e","aeb17f58ffe2f6a0baa3a0aea422171a8e2a36e4bfb9f6022ccaa298effa26f8","3f0679619d4b6bcd5b24cb9a81ada667e09f6e7dde800219dca9b76e270422c0","e78ddacb4fb8f6d28e171ee7ae4ae8e71cdc2817c7682d6184bc0e584b18251e","f5625702e88357756828317c8d1bcc82dda8a867f0c8b9935cddfd5acd4daf2c"],"paragraph_range_zero_based":[15648,15671],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p15648"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"CC-State field descriptions","paragraph_zero_based":15672},{"literal_text_all_w_t_and_m_t":"dlCarrier","paragraph_zero_based":15673},{"literal_text_all_w_t_and_m_t":"Indicates DL carrier activation state for this carrier and the related active BWP Index, if activated.","paragraph_zero_based":15674},{"literal_text_all_w_t_and_m_t":"ulCarrier","paragraph_zero_based":15675},{"literal_text_all_w_t_and_m_t":"Indicates UL carrier activation state for this carrier and the related active BWP Index, if activated.","paragraph_zero_based":15676},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15677},{"literal_text_all_w_t_and_m_t":"CellGroupConfig field descriptions","paragraph_zero_based":15678},{"literal_text_all_w_t_and_m_t":"bap-Address","paragraph_zero_based":15679},{"literal_text_all_w_t_and_m_t":"BAP address of the parent node in cell group.","paragraph_zero_based":15680},{"literal_text_all_w_t_and_m_t":"bh-RLC-ChannelToAddModList","paragraph_zero_based":15681},{"literal_text_all_w_t_and_m_t":"Configuration of the backhaul RLC entities and the corresponding MAC Logical Channels to be added and modified.","paragraph_zero_based":15682},{"literal_text_all_w_t_and_m_t":"bh-RLC-ChannelToReleaseList","paragraph_zero_based":15683},{"literal_text_all_w_t_and_m_t":"List of the backhaul RLC entities and the corresponding MAC Logical Channels to be released.","paragraph_zero_based":15684},{"literal_text_all_w_t_and_m_t":"f1c-TransferPath","paragraph_zero_based":15685},{"literal_text_all_w_t_and_m_t":"The F1-C transfer path that an EN-DC IAB-MT should use for transferring F1-C packets to the IAB-donor-CU. If IAB-MT is configured with lte, IAB-MT can only use LTE leg for F1-C transfer. If IAB-MT is configured with nr, IAB-MT can only use NR leg for F1-C transfer. If IAB-MT is configured with both, it is up to IAB-MT to select an LTE leg or a NR leg for F1-C transfer. If the field is not configured, the IAB node uses the NR leg as the default one.","paragraph_zero_based":15686},{"literal_text_all_w_t_and_m_t":"f1c-TransferPathNRDC","paragraph_zero_based":15687},{"literal_text_all_w_t_and_m_t":"The F1-C transfer path that an NR-DC IAB-MT should use for transferring F1-C packets to the IAB-donor-CU. If IAB-MT is configured with mcg, IAB-MT can only use the MCG for F1-C transfer. If IAB-MT is configured with scg, IAB-MT can only use the SCG for F1-C transfer. If IAB-MT is configured with both, it is up to IAB-MT to select the MCG or the SCG for F1-C transfer.","paragraph_zero_based":15688},{"literal_text_all_w_t_and_m_t":"mac-CellGroupConfig","paragraph_zero_based":15689},{"literal_text_all_w_t_and_m_t":"MAC parameters applicable for the entire cell group.","paragraph_zero_based":15690},{"literal_text_all_w_t_and_m_t":"npn-IdentityInfoList","paragraph_zero_based":15691},{"literal_text_all_w_t_and_m_t":"This field is used to transfer npn-IdentityInfoList in SIB1 of the SCell. The UE uses this field to translate the plmn-Index in MCCH of SCell to SNPN Identity. If this field and plmn-IdentityInfoList are both absent, the UE uses the npn-IdentityInfoList in SIB1 of the PCell.","paragraph_zero_based":15692},{"literal_text_all_w_t_and_m_t":"plmn-IdentityInfoList","paragraph_zero_based":15693},{"literal_text_all_w_t_and_m_t":"This field is used to transfer plmn-IdentityInfoList in SIB1 of the SCell. The UE uses this field to translate the plmn-Index in MCCH of SCell to PLMN Identity. If this field and npn-IdentityInfoList are both absent, the UE uses the plmn-IdentityInfoList in SIB1 of the PCell.","paragraph_zero_based":15694},{"literal_text_all_w_t_and_m_t":"prioSCellPRACH-OverSP-PeriodicSRS","paragraph_zero_based":15695}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["10ac416325530d5fbd90b87808631b9e057f8809bbaf42f68dbfecef89335987","f40c0b6269bfe356b6b0dd1d77acb2054e55d3bf428b2722123fcdee1318c819","393d695da63424071c17ea4a7e3027695ed9670e98d47e16d09e44bd93ba7608","0602e92fc7a13cbeab9ab645eae30e6fbba34fde800b57445e27cda26f457ac6","44f1f20bcc0edd05a10ad32bdec385346e21cf75814f4d930806343c3c7410f7","91b92494023dc96429e5daa8cbe47e13a68ac52cfa26c6ed1cd27a6d78d62a1e","714336c9c848337f6f12c32eeaeecb6b32c92ba758449c7cd433212131e9e0aa","65000fa876a407452ab2912a0790c5d924457a0574c2aaeb2548b1cd75c3ac30","20b6a2683df50c4599c8f4e2891e7312f4e0ef4fd4f880618dd97f0d192ad85c","c8755410abcbc1d687ce4fadf58aaea9de63e9f9a24f46f6f484fd0ec1fd467d","a2d1e5d535f22bf9fdfb6c48eda0693a1037a461fa1d9500a6bd536120a98925","9d40a3ef9078b17665df55883eba109526f0df20a85034da6629b9d19f9d4c97","100f30237e4d261c67d0721a6fb8171132c0f3f85f1c0e6649dba12b2d1eb69d","e86edfca2d06ec6a25e5f84f9da2427e5e5bbb1c4a332260838d1973763689e6","013b9c58b5dc423234421acc584721ef3148075dc1ee267bd0da3e11d24ebf49","9938cb9acb76413c6ca916288fde7e074b95f3cdbbaa8ddd94505cb9e6b3047e","bebd1a9c2dad710ceef69906148ef7094b1f6c28edb229a1699060653ab38c13","abbcf5c6df497884e1646bce99606f8fccd955794b65b1040203663df3e3bdfe","86daec42616e84e22e011507ffa7e7667a4633d787cc3c38e4549504a05657cb","dcaf86326e359c91286e460ba30fde33b4952991145191705bf7cae2ea800752","7f2f92227f2a9339bac5fb87d40d8563fa232d81697aab0f3f80747b9c590ef2","d5c232b601fa97f2c063e6858a5d3cfb5cddefae930c76367aa78e2be0e84c55","66f822a717bcc955cff3d5b7a8556ba7def04e5969d659f48bf3170f5915dd29","cc16009d4a07dbd3bfbbebae30cbda51b7e290f927dbfa5a7ce47b6d2de028f5"],"paragraph_range_zero_based":[15672,15695],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p15672"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"When configured, the UE applies UL power control prioritization by prioritizing PRACH transmission on SCell over semi-persistent and/or periodic SRS transmission as defined in subclause 7.5 of TS 38.213 [13].","paragraph_zero_based":15696},{"literal_text_all_w_t_and_m_t":"rlc-BearerToAddModList","paragraph_zero_based":15697},{"literal_text_all_w_t_and_m_t":"Configuration of the MAC Logical Channel, the corresponding RLC entities and association with radio bearers.","paragraph_zero_based":15698},{"literal_text_all_w_t_and_m_t":"reportUplinkTxDirectCurrent","paragraph_zero_based":15699},{"literal_text_all_w_t_and_m_t":"Enables reporting of uplink and supplementary uplink Direct Current location information upon BWP configuration and reconfiguration. This field is only present when the BWP configuration is modified or any serving cell is added or removed. This field is absent in the IE CellGroupConfig when provided as part of RRCSetup message. If UE is configured with SUL carrier, UE reports both UL and SUL Direct Current locations.","paragraph_zero_based":15700},{"literal_text_all_w_t_and_m_t":"reportUplinkTxDirectCurrentMoreCarrier","paragraph_zero_based":15701},{"literal_text_all_w_t_and_m_t":"Enables reporting of uplink Direct Current location information when the UE is configured with intra-band CA. This field is absent in the IE CellGroupConfig when provided as part of RRCSetup message. The UE only reports the uplink Direct Current location information that are related to the indicated cc-CombinationList. The network does not include carriers which locate in DL only spectrum described in TS 38.101-2 [39], clause 5.3A.4 and defined by Fsd according to Table 5.3A.4-3 in FR2 in the IntraBandCC-CombinationReqList. I.e. DL-only carrier in FR2 frequency spectrum is not used to calculate the default DC location.","paragraph_zero_based":15702},{"literal_text_all_w_t_and_m_t":"reportUplinkTxDirectCurrentTwoCarrier","paragraph_zero_based":15703},{"literal_text_all_w_t_and_m_t":"Enables reporting of uplink Direct Current location information when the UE is configured with uplink intra-band CA with two carriers. This field is absent in the IE CellGroupConfig when provided as part of RRCSetup message.","paragraph_zero_based":15704},{"literal_text_all_w_t_and_m_t":"rlc-BearerToReleaseListExt","paragraph_zero_based":15705},{"literal_text_all_w_t_and_m_t":"List of the RLC entities and the corresponding MAC Logical Channels to be released for multicast MRBs.","paragraph_zero_based":15706},{"literal_text_all_w_t_and_m_t":"rlmInSyncOutOfSyncThreshold","paragraph_zero_based":15707},{"literal_text_all_w_t_and_m_t":"BLER threshold pair index for IS/OOS indication generation, see TS 38.133 [14], table 8.1.1-1. n1 corresponds to the value 1. When the field is absent, the UE applies the value 0. Whenever this is reconfigured, UE resets N310 and N311, and stops T310, if running. Network does not include this field.","paragraph_zero_based":15708},{"literal_text_all_w_t_and_m_t":"sCellSIB20","paragraph_zero_based":15709},{"literal_text_all_w_t_and_m_t":"This field is used to transfer SIB20 of the SCell in order to allow the UE for MBS broadcast reception on SCell. The network configures this field only for a single SCell at a time.","paragraph_zero_based":15710},{"literal_text_all_w_t_and_m_t":"sCellState","paragraph_zero_based":15711},{"literal_text_all_w_t_and_m_t":"Indicates whether the SCell shall be considered to be in activated state upon SCell configuration. If the field is included for an SCell configured with TRS for fast activation of the SCell, such TRS is not used for the corresponding SCell.","paragraph_zero_based":15712},{"literal_text_all_w_t_and_m_t":"sCellToAddModList","paragraph_zero_based":15713},{"literal_text_all_w_t_and_m_t":"List of secondary serving cells (SCells) to be added or modified.","paragraph_zero_based":15714},{"literal_text_all_w_t_and_m_t":"sCellToReleaseList","paragraph_zero_based":15715},{"literal_text_all_w_t_and_m_t":"List of secondary serving cells (SCells) to be released.","paragraph_zero_based":15716},{"literal_text_all_w_t_and_m_t":"simultaneousSpatial-UpdatedList1, simultaneousSpatial-UpdatedList2","paragraph_zero_based":15717},{"literal_text_all_w_t_and_m_t":"List of serving cells which can be updated simultaneously for spatial relation with a MAC CE. The simultaneousSpatial-UpdatedList1 and simultaneousSpatial-UpdatedList2 shall not contain same serving cells. Network should not configure serving cells that are configured with a BWP with two different values for the coresetPoolIndex in these lists.","paragraph_zero_based":15718},{"literal_text_all_w_t_and_m_t":"simultaneousTCI-UpdateList1, simultaneousTCI-UpdateList2","paragraph_zero_based":15719}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["ce841203825a9beab15201957516ce3d2533b23bd6643ba81db49342cb0ffc1d","fa7b813b82bbc7e185db470cee335aca1a94f125189b7cd3f3aeca13837b123b","d1f69365a8cd0c4934d71b3d6a608437a8e881c7541dfb3d07d04da56fdf10fb","6ec0686f3fedcb6c7f0f92e0060e32baacb72da7f635a07e9c68a1f2c189a48e","e18d0106a5232af2affaa5c38200930c6b033e651945c159e4ad0888dfcc0d61","780b254c2604c1b96eece83c966d049154703c56c4c7cf8abc68cefc73fbf4db","0e7b4c5f6c7cf2c4af3cb5df07997fdf2e3f43b3a568c0731e555cfdb4786a30","382478c0472822e549aab40352ceebc7f43477959c1c65a1b8955a85b7697e44","b3b935c63849ec33c400dbaf72106b921892bd8c437c5a864475953274551e18","bcfd4a0ea5706e5d1448d739a295540e7ba68c5fb59ff7d979d1e8afcd2ce696","b69160822acbadaa4de4bd1d2e7609068c2dc0f8fcf4f23674de3245b8bb71d8","eeae9cd162b901b1df8fb6be6cd5917c2676a0b28532ef68d45229eb6fc87368","671d1112a75d9d7089322eaea1bffdaf56e8144863684178fa4fe53d81329c20","e5e5d2c4f2ec5ba75ae7f2cc84b75611c078274d9502d8440cc88f613866c505","54a7a3a27a825dce85ac3d462dc32c3e3b64616a46e4afd8b7245a21ac184d37","a66ae59820456d284b14d73a7c7af95c9b8455aa9fce98a45482276ab045f4cd","4c581d51b93592fbb0073184354a77868a800667e0ccb44a3839ec845772c5c0","cf44fee1cbbcd393c514138e07fa42f09d04823dbda32a47f96cca8a2902f64b","cbbfa782cb3a9b71811acb1ca5a4fdd9344b9a818d1949e878e1ef97154e7bbf","689c814b8677710469771d7e9580a3f47fb821d7793375bc6e33391b9b801b64","f7a48f15bac4a7d17fb38a51136c326b1b857240d1117d7c0a87250b84639446","5fbba9de625bb57e0b91fd5af51dd94694b5f903d32cc993898ceefe0de88557","20c9b15631a1965b1ad0d94962603a46592b1025be77fb9ef98f89e53a2fe620","e826e5730755bbc384f572e0ccd82bd3b0cf8d1faa87f9682d657e9007cfa4b2"],"paragraph_range_zero_based":[15696,15719],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p15696"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"List of serving cells which can be updated simultaneously for TCI relation with a MAC CE. The simultaneousTCI-UpdateList1 and simultaneousTCI-UpdateList2 shall not contain same serving cells. Network should not configure serving cells that are configured with a BWP with two different values for the coresetPoolIndex in these lists.","paragraph_zero_based":15720},{"literal_text_all_w_t_and_m_t":"simultaneousU-TCI-UpdateList1, simultaneousU-TCI-UpdateList2, simultaneousU-TCI-UpdateList3, simultaneousU-TCI-UpdateList4","paragraph_zero_based":15721},{"literal_text_all_w_t_and_m_t":"List of serving cells for which the Unified TCI States Activation/Deactivation MAC CE applies simultaneously, as specified in TS 38.321 [3] clause 6.1.3.47. The different lists shall not contain same serving cells. Network only configures in these lists serving cells that are configured with unifiedTCI-StateType.","paragraph_zero_based":15722},{"literal_text_all_w_t_and_m_t":"spCellConfig","paragraph_zero_based":15723},{"literal_text_all_w_t_and_m_t":"Parameters for the SpCell of this cell group (PCell of MCG or PSCell of SCG). ","paragraph_zero_based":15724},{"literal_text_all_w_t_and_m_t":"uplinkTxSwitchingOption","paragraph_zero_based":15725},{"literal_text_all_w_t_and_m_t":"Indicates which option is configured for dynamic UL Tx switching for inter-band UL CA or (NG)EN-DC. The field is set to switchedUL if network configures option 1 as specified in TS 38.214 [19], or dualUL if network configures option 2 as specified in TS 38.214 [19]. Network always configures UE with a value for this field in inter-band UL CA case and (NG)EN-DC case where UE supports dynamic UL Tx switching.","paragraph_zero_based":15726},{"literal_text_all_w_t_and_m_t":"uplinkTxSwitchingPowerBoosting","paragraph_zero_based":15727},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE is allowed to enable 3dB boosting on the maximum output power for transmission on carrier2 under the operation state in which 2-port transmission can be supported on carrier2 for inter-band UL CA case with dynamic UL Tx switching as defined in TS 38.101-1 [15]. Network can only configure this field for dynamic UL Tx switching in inter-band UL CA case with power Class 3 as defined in TS 38.101-1 [15].","paragraph_zero_based":15728},{"literal_text_all_w_t_and_m_t":"uplinkTxSwitching-2T-Mode","paragraph_zero_based":15729},{"literal_text_all_w_t_and_m_t":"Indicates 2Tx-2Tx switching mode is configured for inter-band UL CA or SUL, in which the switching gap duration for a triggered uplink switching (as specified in TS 38.214 [19]) is equal to the switching time capability value reported for the switching mode.","paragraph_zero_based":15730},{"literal_text_all_w_t_and_m_t":"If this field is absent and uplinkTxSwitching is configured, it is interpreted that 1Tx-2Tx UL Tx switching is configured as specified in TS 38.214 [19]. In this case, there is one uplink (or one uplink band in case of intra-band) configured with uplinkTxSwitching, on which the maximum number of antenna ports among all configured P-SRS/A-SRS and activated SP-SRS resources should be 1 and non-codebook based UL MIMO is not configured.","paragraph_zero_based":15731},{"literal_text_all_w_t_and_m_t":"uplinkTxSwitching-DualUL-TxState","paragraph_zero_based":15732},{"literal_text_all_w_t_and_m_t":"Indicates the state of Tx chains if the state of Tx chains after the UL Tx switching is not unique (as specified in TS 38.214 [19]) in case of 2Tx-2Tx switching is configured and uplinkTxSwitchingOption is set to dualUL. Value oneT indicates 1Tx is assumed to be supported on the carriers on each band, value twoT indicates 2Tx is assumed to be supported on that carrier.","paragraph_zero_based":15733},{"literal_text_all_w_t_and_m_t":"uu-RelayRLC-ChannelToAddModList","paragraph_zero_based":15734},{"literal_text_all_w_t_and_m_t":"List of the Uu RLC entities and the corresponding MAC Logical Channels to be added or modified.","paragraph_zero_based":15735},{"literal_text_all_w_t_and_m_t":"uu-RelayRLC-ChannelToReleaseList","paragraph_zero_based":15736},{"literal_text_all_w_t_and_m_t":"List of the Uu RLC entities and the corresponding MAC Logical Channels to be released.","paragraph_zero_based":15737},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15738},{"literal_text_all_w_t_and_m_t":"DeactivatedSCG-Config field descriptions","paragraph_zero_based":15739},{"literal_text_all_w_t_and_m_t":"bfd-and-RLM","paragraph_zero_based":15740},{"literal_text_all_w_t_and_m_t":"If the field is set to true, the UE shall perform RLM and BFD on the PSCell when the SCG is deactivated and the network ensures that beamFailure-r17 is not configured in the radioLinkMonitoringConfig of the DL BWP of the PSCell in which the UE performs BFD. If set to false, the UE is not required to perform RLM and BFD on the PSCell when the SCG is deactivated.","paragraph_zero_based":15741},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15742},{"literal_text_all_w_t_and_m_t":"DAPS-UplinkPowerConfig field descriptions","paragraph_zero_based":15743}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["0abba81aa8f2398312a3e6b276a5527508b3a857fbab581dccafb5e5cb7b5d9c","ba17c53a840f4225aafe5a92730dd6ebcd0ab3085b76593d000080198731dd36","9379b29003484b0f908c53a40844e5bcf077c8171a097631f5d3df09a3a932fd","a993942a6bb82de0c5d7321efeff3dc5b42af6ed4991f4223f392e92554130db","c61c0c4532f26bd55697ec04a2507ace6697ea445f3178a825f33a84f9cfbbf3","d5be2714c94c043ae9fca0729cb7f8fe4f667ec39e3ad766dcf07c885e24cae6","9b5b260f0e17cf788752e7b9b474d5a68390870ce3a9638e2e33697db9cbd6f8","10010e02ef8606bff6022c9add719f8588593dde4162faa4103afc3025b673bc","650b64e4b9840365a180691e6156594c5bc43acb0ba6c37e4e54548c0042071f","af037210256c13ef6f798b1b8a22f1dfa26b619d30cee5803f168854d75c6ab4","8d8d897269f93c2de161a240f8ce091808434b089bc38ef38cd09710983f8f88","1a50e6a55b4e3bc60180a583174c43552ec21aa75942ed591472025ac4c989c5","b0e55af6a4cc9e7bfc1c57e7ffb03a0f264a83fb17b24ae6aaa0f3625b99dd68","a3669cbd9fb49465c366beda1f7a867b105630ba566655bc58ded99260de3f5b","2506f11d62d7fd8b0dafbf6c165c1de32cd3354b8235b66c5f5e475dcd70b9a2","8041426d45f72cb518d09e5b0ed84683011e53b8be1b6440591d338b5f65ff03","364343405bd251de01bd6dd9884758070214a04bd134fb19eec13ae6991840cc","537f7942e9199b0e7bee41ca7795932368004d130317731329b0146f2cb4e8fe","f32c0a4cb4a522d2838eacb20547e8c42fd0e174f6fdb540d968b77a52fed17a","c5a5d3de4cd9806a0a779db387cd1c78b3a31e14653174d93ebefc94454ff1fd","2db124302cd74d6c65a4d8703a25809c2e90efe9ae13660eb580711754883848","5381c2d9decf2ed83ffc86d2154cc7d614272eb7821c3d8ad54c54cc417d14ef","8d9bd1139d402372508b3770d3b414cd04376ec88f28b2df4bde903a68abc962","b6f46cf9e7f12d3dabe98afefc59a4499d605967848fe468ac0d9645de9b0380"],"paragraph_range_zero_based":[15720,15743],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p15720"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"p-DAPS-Source","paragraph_zero_based":15744},{"literal_text_all_w_t_and_m_t":"The maximum total transmit power to be used by the UE in the source cell group during DAPS handover.","paragraph_zero_based":15745},{"literal_text_all_w_t_and_m_t":"p-DAPS-Target","paragraph_zero_based":15746},{"literal_text_all_w_t_and_m_t":"The maximum total transmit power to be used by the UE in the target cell group during DAPS handover.","paragraph_zero_based":15747},{"literal_text_all_w_t_and_m_t":"uplinkPowerSharingDAPS-Mode","paragraph_zero_based":15748},{"literal_text_all_w_t_and_m_t":"Indicates the uplink power sharing mode that the UE uses in DAPS handover (see TS 38.213 [13]).","paragraph_zero_based":15749},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15750},{"literal_text_all_w_t_and_m_t":"GoodServingCellEvaluation field descriptions","paragraph_zero_based":15751},{"literal_text_all_w_t_and_m_t":"offset","paragraph_zero_based":15752},{"literal_text_all_w_t_and_m_t":"The parameter \"X\" (dB) for the good serving cell quality criterion in RRC_CONNECTED, for a cell operating in FR1 and FR2, respectively. If this field is absent, the UE applies the (default) value of 0 dB for \"X\".","paragraph_zero_based":15753},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15754},{"literal_text_all_w_t_and_m_t":"IAB-ResourceConfig field descriptions","paragraph_zero_based":15755},{"literal_text_all_w_t_and_m_t":"iab-ResourceConfigID","paragraph_zero_based":15756},{"literal_text_all_w_t_and_m_t":"This ID is used to indicate the specific resource configuration addressed by the MAC CEs specified in TS 38.321 [3].","paragraph_zero_based":15757},{"literal_text_all_w_t_and_m_t":"periodicitySlotList","paragraph_zero_based":15758},{"literal_text_all_w_t_and_m_t":"Indicates the periodicity in ms of the list of slot indexes indicated in slotList.","paragraph_zero_based":15759},{"literal_text_all_w_t_and_m_t":"slotList","paragraph_zero_based":15760},{"literal_text_all_w_t_and_m_t":"Indicates the list of slot indexes to which the information indicated in the specific MAC CE applies to, as specified in TS 38.321 [3]. The values of the entries in the slotList are strictly less than the value of the periodicitySlotList.","paragraph_zero_based":15761},{"literal_text_all_w_t_and_m_t":"slotListSubcarrierSpacing","paragraph_zero_based":15762},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing used as reference for the slotList configuration.","paragraph_zero_based":15763},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":15764},{"literal_text_all_w_t_and_m_t":"FR1:    15 or 30 kHz","paragraph_zero_based":15765},{"literal_text_all_w_t_and_m_t":"FR2-1:  60 or 120 kHz","paragraph_zero_based":15766},{"literal_text_all_w_t_and_m_t":"FR2-2:  120 or 480 kHz","paragraph_zero_based":15767}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["592a18d68c15430234ee063128950d1f1c6e128580a28ea113e8396358e2c5e8","2b8b65f6d591f4ae0ac7755dd0199d4f1ec23874c9f4519d226b358b4fb460dc","fbc6c078fd22d8255c0ba8ebbe35d96771bb1cd69327d272193186985e2e8127","8a1427d7c6cb6576b0dbb80ae32b7d992dc8da2e73304b884b1b281a4abd2bbf","03ee79ac7bd9ab6da29cb3e5153bc1591f275290bdad38c64259065319bd4a51","e70ae4471d05780dccca07fb45c3099cb37f1aab575a49e9b52c076b13856bf1","b230bdba6e454f8657b2bc701b6dc279a1d4a280a62ad7d648e18a6fff7dd94f","eb039e6930c563c9f316790e284ab8f143e485e2eb5ebe961db517548b28032b","02949d308b5802f642d23182e0f3674d0beeae978afbe74bf0fe1f5293267e0c","2713555f1449435214bb579f7c2325a26aaec63f685c957eeaf885d6a948d5c6","19691e504304127a901868171f3c3a0881fb3081ac964775a742449397b2f91e","75a0da35533d9b57d8a0c626be9aae8c5441911583b3c9e0dea9c45b397de14a","597827698ab3c437b1f5255a8de3ed94d3d3ab602a62cb4386550ecf77ffd24e","91e01943dc8bd4ba26346868ac3736783a961cc6718bc6f3ba65a5a197bb1782","e2c3e6695bcaa20ed1511e6fc5b7253c980ef6c46f9ecef83c327178b023d905","dabab11fb99daaa528a8024b957e6a29b4b5e75e55054fd42060474df9450f82","612e42fd104567e3fe93925ec8ff763c9eb4d3435c4f59040aec37299754f3ef","80d9a320008aabfe382356752348f160de4a9b7715f05d3fe6a93f75aa84db33","b00da6a8e78dac40efbf156489aab8958408cd81a507f0b9e07b56a0a584d441","d2a1c809810e270aaec6c47e62c5525e21ad2954f82dffeebd99d789060b1a7b","a284ca5cb74be0c82267a479d1996da51b05baa985b8ea4caaf20ed2c6b6c036","3fe3dd4e975c7c3f26813297ef5fb92cf087e486a9004cbe1687cd156c573d02","9e8a3dddc1e1c17db31387c7d38b045782f60f098a88a3e14fd3c4cbd5c6bf5c","591ca7af9169ba95545d471365e323c36afd84bd07527c06e45c109c2daf1054"],"paragraph_range_zero_based":[15744,15767],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p15744"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15768},{"literal_text_all_w_t_and_m_t":"ReconfigurationWithSync field descriptions","paragraph_zero_based":15769},{"literal_text_all_w_t_and_m_t":"rach-ConfigDedicated","paragraph_zero_based":15770},{"literal_text_all_w_t_and_m_t":"Random access configuration to be used for the reconfiguration with sync (e.g. handover). The UE performs the RA according to these parameters in the firstActiveUplinkBWP (see UplinkConfig).","paragraph_zero_based":15771},{"literal_text_all_w_t_and_m_t":"smtc","paragraph_zero_based":15772},{"literal_text_all_w_t_and_m_t":"The SSB periodicity/offset/duration configuration of target cell for NR PSCell change and NR PCell change. The network sets the periodicityAndOffset to indicate the same periodicity as ssb-periodicityServingCell in spCellConfigCommon or sets to the same periodicity as ssb-Periodicity-r17 in nonCellDefiningSSB-r17 if the first active DL BWP included in this RRC message is configured with nonCellDefiningSSB-r17 for RedCap.","paragraph_zero_based":15773},{"literal_text_all_w_t_and_m_t":"For case of NR PCell change, the smtc is based on the timing reference of (source) PCell. For case of NR PSCell change, it is based on the timing reference of source PSCell.","paragraph_zero_based":15774},{"literal_text_all_w_t_and_m_t":"If both this field and targetCellSMTC-SCG are absent, the UE uses the SMTC in the measObjectNR having the same SSB frequency and subcarrier spacing, as configured before the reception of the RRC message. For a RedCap UE, if the first active DL BWP included in this RRC message is configured with nonCellDefiningSSB-r17, this field corresponds to the NCD-SSB indicated by nonCellDefiningSSB-r17, otherwise, this field corresponds to the CD-SSB indicated by absoluteFrequencySSB in frequencyInfoDL.","paragraph_zero_based":15775},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15776},{"literal_text_all_w_t_and_m_t":"ReportUplinkTxDirectCurrentMoreCarrier field descriptions","paragraph_zero_based":15777},{"literal_text_all_w_t_and_m_t":"IntraBandCC-Combination","paragraph_zero_based":15778},{"literal_text_all_w_t_and_m_t":"Indicates the state of the carriers and BWPs indexes of the carriers in a CC combination, each carrier in this combination corresponds to an entry in servCellIndexList with same order. This IE shall have the same size as servCellIndexList.","paragraph_zero_based":15779},{"literal_text_all_w_t_and_m_t":"IntraBandCC-CombinationReqList","paragraph_zero_based":15780},{"literal_text_all_w_t_and_m_t":"Indicates the list of the requested carriers/BWPs combinations for an intra-band CA component.","paragraph_zero_based":15781},{"literal_text_all_w_t_and_m_t":"servCellIndexList","paragraph_zero_based":15782},{"literal_text_all_w_t_and_m_t":"indicates the list of cell index for an intra-band CA component.","paragraph_zero_based":15783},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15784},{"literal_text_all_w_t_and_m_t":"SCellConfig field descriptions","paragraph_zero_based":15785},{"literal_text_all_w_t_and_m_t":"goodServingCellEvaluationBFD","paragraph_zero_based":15786},{"literal_text_all_w_t_and_m_t":"Indicates the criterion for a UE to detect the good serving cell quality for BFD relaxation in an SCell in RRC_CONNECTED. This field is always configured when the network enables BFD relaxation for the UE in this SCell. This field is absent if failureDetectionSetN is present for the SCell.","paragraph_zero_based":15787},{"literal_text_all_w_t_and_m_t":"preConfGapStatus","paragraph_zero_based":15788},{"literal_text_all_w_t_and_m_t":"Indicates whether the pre-configured measurement gaps (i.e. the gaps configured with preConfigInd) are activated or deactivated while this SCell is deactivated. If this field is configured, the UE shall apply network-controlled mechanism for activation and deactivation of the pre-configured measurement gaps, otherwise the UE shall apply the autonomous activation/deactivation mechanism, as specified in TS 38.133 [14]. The first/leftmost bit corresponds to the measurement gap with gap ID 1, the second bit corresponds to measurement gap with gap ID 2, and so on. Value 0 indicates that the corresponding pre-configured measurement gap is deactivated while value 1 indicates that the corresponding pre-configured measurement gap is activated. The UE shall ignore the bit if the corresponding measurement gap is not a pre-configured measurement gap.","paragraph_zero_based":15789},{"literal_text_all_w_t_and_m_t":"secondaryDRX-GroupConfig","paragraph_zero_based":15790},{"literal_text_all_w_t_and_m_t":"The field is used to indicate whether the SCell belongs to the secondary DRX group. All serving cells in the secondary DRX group shall belong to one Frequency Range and all serving cells in the legacy DRX group shall belong to another Frequency Range. If drx-ConfigSecondaryGroup is configured, the field is optionally present. The network always includes the field if the field was previously configured for this SCell and the SCell remains in the secondary DRX group. Removal of an individual SCell from the secondary DRX group is supported by using an SCell release and addition. Otherwise, if drx-ConfigSecondaryGroup is not configured, the field is absent and the UE shall release the field. The UE shall also release the field if drx-ConfigSecondaryGroup is released without including sCellToAddModList.","paragraph_zero_based":15791}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["58f2091620e26613c609b3a48a06899511199db7ee7201f498b76c74fbdb2c60","8853dd4481e269d0bf5152897c943a0cee1c9a25c2e5c98aac3d8de13e730738","6a207696b6be4e0951e686cabb2bec3d8021057c56a0bd7918b2917443229e36","0ffe871dc73d199d29899f7c1f226180504ab335950cd115f48529b55ba89fe0","7608ac2e0b087492bdd49ed0fd80fd5387739b2cd3ac8fc511f23bb06b507912","48f982b9684a93a2a33d2414670b7136e57bf21b96b0eade38bdd06ee3b7e22f","94b9aeffd8eca77dc7c631a86a7b1194b9e0cd0a79bce68df4f5e26b0aee81cb","08231f8f695531e6bfff6785a652c200d252eeaf6745792f16f4386e3cd56d5f","3f3214d8abc57388692e25d50760af23fcea80a6169649a7ce6b58e0b84833c4","8e95527865e4ee9293fa4a99211475e73ff1193fd2bdd5ed5328f9175f76d5a3","2b49a524164a553a9f52ad52f7a9011c58968468e4603e7cca9bb12d60dc6c2f","fb301c697ca647d3a80d49fcc8c7928cf4b6d5e1bde6862cacb713190a6e3882","e3383a4fe1b445eff3427e5b5213a0b1b8852dd1aff1e33ccce5bf52946c0130","7d681c661b07f71bf746f8f65e8a03677170a47588ccee7c16fa0e487c69cfb3","722ab15ac99ab267375dcdfabc48a382c7a6e5c506c1acfdc81d9532f4a74eec","6848962f30bcadcaac65255d020ed8b43da946da9da2d1346fccdfba544db7b5","aa30d6e1937c09f8bf87efafab7c6613b763245d24d4ca344bd11da2c41554bd","e075e806bb5c02ed292c32fec1a04bcec932e54601f13570986ad1bb16051aaa","638a4cbddffddea44a16f4e05d67a8d6911f3b8ff980b4615888bbd39f19bfdd","43e551708ad33b7b67e82213523707b50d09b952f0c91e695f5f734219a99b80","9a6340740ec5b733e1a98b0abc28c902283066d411ad1c8920027eb4fda73f52","487c57b1dcd525d234cfeff2452916ecf8b2fcf64f3780dd21b88b821651e248","71f645a510090ed2912ae8a033869f033e480979904243a3fc687aaacd3ecf4b","c4fe28af0624ec73d34b09e7cb1b461ea1776bd402c9f2876c84b8151e2efcac"],"paragraph_range_zero_based":[15768,15791],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p15768"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"smtc","paragraph_zero_based":15792},{"literal_text_all_w_t_and_m_t":"The SSB periodicity/offset/duration configuration of target cell for NR SCell addition. The network sets the periodicityAndOffset to indicate the same periodicity as ssb-periodicityServingCell in sCellConfigCommon. The smtc is based on the timing of the SpCell of associated cell group. In case of inter-RAT handover to NR, the timing reference is the NR PCell. In case of intra-NR PCell change (standalone NR) or NR PSCell change (EN-DC), the timing reference is the target SpCell. If the field is absent, the UE uses the SMTC in the measObjectNR having the same SSB frequency and subcarrier spacing, as configured before the reception of the RRC message.","paragraph_zero_based":15793},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15794},{"literal_text_all_w_t_and_m_t":"SpCellConfig field descriptions","paragraph_zero_based":15795},{"literal_text_all_w_t_and_m_t":"deactivatedSCG-Config","paragraph_zero_based":15796},{"literal_text_all_w_t_and_m_t":"Configuration applicable when the SCG is deactivated. The network always configures this field before or when indicating that the SCG is deactivated in an RRCReconfiguration, RRCResume, E-UTRA RRCConnectionReconfiguration or E-UTRA RRCConnectionResume message.","paragraph_zero_based":15797},{"literal_text_all_w_t_and_m_t":"goodServingCellEvaluationBFD","paragraph_zero_based":15798},{"literal_text_all_w_t_and_m_t":"Indicates the criterion for a UE to detect the good serving cell quality for BFD relaxation in the SpCell in RRC_CONNECTED. The field is always configured when the network enables BFD relaxation for the UE in this SpCell. This field is absent if failureDetectionSetN is present for the SpCell.","paragraph_zero_based":15799},{"literal_text_all_w_t_and_m_t":"goodServingCellEvaluationRLM","paragraph_zero_based":15800},{"literal_text_all_w_t_and_m_t":"Indicates the criterion for a UE to detect the good serving cell quality for RLM relaxation in the SpCell in RRC_CONNECTED. The field is always configured when the network enables RLM relaxation for the UE in this SpCell.","paragraph_zero_based":15801},{"literal_text_all_w_t_and_m_t":"lowMobilityEvaluationConnected","paragraph_zero_based":15802},{"literal_text_all_w_t_and_m_t":"Indicates the criterion for a UE to detect low mobility in RRC_CONNECTED in an SpCell. The s-SearchDeltaP-Connected is the parameter \"SSearchDeltaP-connected\". Value dB3 corresponds to 3 dB, dB6 corresponds to 6 dB and so on. The t-SearchDeltaP-Connected is the parameter \"TSearchDeltaP-Connected\". Value s5 means 5 seconds, value s10 means 10 seconds and so on. Low mobility criterion is configured in NR PCell for the case of NR SA/ NR CA/ NE-DC/NR-DC, and in the NR PSCell for the case of EN-DC.","paragraph_zero_based":15803},{"literal_text_all_w_t_and_m_t":"reconfigurationWithSync","paragraph_zero_based":15804},{"literal_text_all_w_t_and_m_t":"Parameters for the synchronous reconfiguration to the target SpCell.","paragraph_zero_based":15805},{"literal_text_all_w_t_and_m_t":"rlf-TimersAndConstants","paragraph_zero_based":15806},{"literal_text_all_w_t_and_m_t":"Timers and constants for detecting and triggering cell-level radio link failure. For the SCG, rlf-TimersAndConstants can only be set to setup and is always included at SCG addition.","paragraph_zero_based":15807},{"literal_text_all_w_t_and_m_t":"servCellIndex","paragraph_zero_based":15808},{"literal_text_all_w_t_and_m_t":"Serving cell ID of a PSCell. The PCell of the Master Cell Group uses ID = 0.","paragraph_zero_based":15809},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15810},{"literal_text_all_w_t_and_m_t":"SL-PathSwitchConfig field descriptions","paragraph_zero_based":15811},{"literal_text_all_w_t_and_m_t":"targetRelayUE-Identity","paragraph_zero_based":15812},{"literal_text_all_w_t_and_m_t":"Indicates the L2 source ID of the target L2 U2N Relay UE during path switch.","paragraph_zero_based":15813},{"literal_text_all_w_t_and_m_t":"T420","paragraph_zero_based":15814},{"literal_text_all_w_t_and_m_t":"Indicates the timer value of T420 to be used during path switch.","paragraph_zero_based":15815}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["78f1decbdc065bab94c51e03bdfe250ba565b9c718559744d9c0659929746658","5d7cc6a58d4132e39fd0561e522f18b250866c8be3023b8565b6d2472a1bad3a","2fb21f38c81fad9dbffd3631f63537735c9e33e794933ad20ec4eb7e2a483322","22e4d29dc1c38a627ff58230f5a4aee29eb31044b7a09e34c2f32866dfbef6f9","d45cca1b4bac78fed623d50a458bc2f4595b259d76b94afdacdec6892d2286f0","d49a55c6b87d09e6e479e6adc78810455cf4fac53892e0098c62077ae684c3ea","998fa48cdc50adca17e1a5cff44b283b86e7fdaf15f141beddc28aaa51846502","55393ba6729f29f8ba4714866485bee0f103afa938a51cbf37786d6066ac534f","67aa9316d8c1e7acf867ab5f1b7497f070460daf58081e72c411849c041bd470","a8383f1921eb706f383454f8875094e3fa0ba9f5377b174324a70957d40a2927","716147cce7ce6a46c6efc6520c92722ba91f8fa8f2148bbadee4981c9cf0e09f","7aadd2b22cdc3b7a3112201a7ad05d38d94b635bd1d7c5a412dff4fb85731e41","f3ed6c49a45a1c20a5e0e2934dca58eeca3f173354fb0883ee3743058e43f471","16b7f4039903f3b037c9e91c336f8cc72fc74ef15f1654de9a218e3539c6da9a","a88e29037e06475866aa59386ebfc245ef9839a1b58292e08aca5c504407220e","987e4e3133b4450d339a47c03759c5348b59f061f30b9c893551e01873fe6983","a142ef44a6fd0bfbf513f86d97321a1d936bf89727c7970a9f206817cd8b6140","440136c972698d444347b8196b1f33c4969642aaebb188fa4c84deb319e412a9","5656cdf4b1e22fb36fa33407482ec4a7b3dd7f06a8bdee37cb3bee4b6ec40bff","635dd407f8f71175a8c9d98f885941cd8a7014a6b6fab73e6b5f4ede54af5403","8bc9f284ee63e98ecfc08a3cf8105f0081c5ecfec7d2d03cf7628dcdd955507e","71ec9acceb18cc810fe51a269926ffb2310bcf7f6b2641cdd70bc75cb5257644","cf186c8ad74ff9d37e5a38831f0f92169dedd4479d490e316b3f5a48466a94ad","c8ef118b2ff95ff04ae9cb3924402d782716362ff14a80e22bd1180626fb746d"],"paragraph_range_zero_based":[15792,15815],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p15792"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15816},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":15817},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":15818},{"literal_text_all_w_t_and_m_t":"2Tx","paragraph_zero_based":15819},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if uplinkTxSwitching is configured; otherwise it is absent, Need R.","paragraph_zero_based":15820},{"literal_text_all_w_t_and_m_t":"BWP-Reconfig","paragraph_zero_based":15821},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need N, if the BWPs are reconfigured or if serving cells are added or removed. Otherwise it is absent. ","paragraph_zero_based":15822},{"literal_text_all_w_t_and_m_t":"DirectToIndirect-PathSwitch","paragraph_zero_based":15823},{"literal_text_all_w_t_and_m_t":"The field is mandatory present for the L2 U2N remote UE at path switch to the target L2 U2N Relay UE. It is absent otherwise.","paragraph_zero_based":15824},{"literal_text_all_w_t_and_m_t":"PreConfigMG","paragraph_zero_based":15825},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if there is at least one per UE gap configured with preConfigInd or there is at least one per FR gap of the same FR which the SCell belongs to and configured with preConfigInd. It is absent, Need R, otherwise.","paragraph_zero_based":15826},{"literal_text_all_w_t_and_m_t":"ReconfWithSync","paragraph_zero_based":15827},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in the RRCReconfiguration message:","paragraph_zero_based":15828},{"literal_text_all_w_t_and_m_t":"-in each configured CellGroupConfig for which the SpCell changes,","paragraph_zero_based":15829},{"literal_text_all_w_t_and_m_t":"-in the masterCellGroup:","paragraph_zero_based":15830},{"literal_text_all_w_t_and_m_t":"-at change of AS security key derived from KgNB,","paragraph_zero_based":15831},{"literal_text_all_w_t_and_m_t":"-in an RRCReconfiguration message contained in a DLInformationTransferMRDC message,","paragraph_zero_based":15832},{"literal_text_all_w_t_and_m_t":"-path switch of L2 U2N remote UE to the target PCell,","paragraph_zero_based":15833},{"literal_text_all_w_t_and_m_t":"-path switch of L2 U2N remote UE to the target L2 U2N Relay UE,","paragraph_zero_based":15834},{"literal_text_all_w_t_and_m_t":"-in the secondaryCellGroup at:","paragraph_zero_based":15835},{"literal_text_all_w_t_and_m_t":"-PSCell addition,","paragraph_zero_based":15836},{"literal_text_all_w_t_and_m_t":"-SCG resume with NR-DC or (NG)EN-DC,","paragraph_zero_based":15837},{"literal_text_all_w_t_and_m_t":"-update of required SI for PSCell,","paragraph_zero_based":15838},{"literal_text_all_w_t_and_m_t":"-change of AS security key derived from S-KgNB in NR-DC while the UE is configured with at least one radio bearer with keyToUse set to secondary and that is not released by this RRCReconfiguration message,","paragraph_zero_based":15839}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["bafd8db311f996525df602ca8d2297d8262292292ad53f309cdcd91157eb4ce1","b8b308d2dedee77f2eef6b625d97ea1c0c0b2c19dedf62c40f7253f0a4f0fe0f","7a6e1455f5a37f456502d082b756bb020df52c8f36606c4d8895332a86f946f6","4bbfb49cca00f451f4fc3139824425b9802396e0f540ee900ed6f96edb2c80ff","bff553547bde386ef0d560c4562b803a7c3c536009cbb25e5bf38e75045d9176","25e3b73ac7440bc3241a28ddd70ffceb709afa2ea3edfad98bd15bbf961c7fb4","2ba9bbf114bb4fb7a0a2ce1729ba55ea3f306e8814fb2e444d6735334fd42e15","dfecb4f6dd87ae6fc297f115eee0387eda53e76cb345068bd8b862c47a1cf0d6","d5e05be18e9eafc3207981d38286da34bdef4e9ce7cea14c940cc8d6f72bce26","b9072d654b638fb481d394b82eba700227d7b936082e6b04796040f616e2056c","17beb15c8e104e9126f7fd0220941f201a868079c6c9fb61f53ceffe989a91e6","35a907480f9cb1222fed78eef8ff94b63ac93f3811e497848d7e8957de30e5f5","b6512c31b253c71c1a42735e7498860cceccec1bc8b35e6dca0f6b796f6ca9f9","7ed5f0bfcd214286f1b7322413f1cab7d269418228b148b6d476c53477a2a401","510bf31c0cbf356f73a6579136a46de805996766e8faf6b84615e812154c532f","0b1dbef9f51e4fe4943cdf763c6c76a00e3630ba81f86fd4dd8e34638b9fbc24","6ddee1073461f9e649e67169f5df37a1844a3e2a4e70e95c7467637fa6d832de","71536eb67674d3753f78b7c498f61525f13e6ac512f8db95d7ee125241b7a0ba","ec4b63dda610823190e826b6ee914cd968659dc645ac348f53e60ccda5a58e56","908cd80b137608b9f92a32ac8f15e1414a74418e1e86d84d3089acd994aae966","f07bc263e5f3938b48bf899ed0f6cddef85b39ba61528edbe763d529da7a6c55","0b9a44a9c81b67f5d305ebb629d33bf0aa7cbb644e4d997601f836e2d09b9f3f","48e5e40aac8dd1cf0c5e3e0562ea9a56e51b6c52dc4e059e8bb7b64db762f33a","7435bbf8bfc203d79ed86e128b5c9c05cc66b0312e9b85d72a80f43ab4c7fd99"],"paragraph_range_zero_based":[15816,15839],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p15816"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-MN handover in (NG)EN-DC.","paragraph_zero_based":15840},{"literal_text_all_w_t_and_m_t":"Otherwise, it is optionally present, need M. The field is absent in the masterCellGroup in RRCResume and RRCSetup messages and is absent in the masterCellGroup in RRCReconfiguration messages if source configuration is not released during DAPS handover.","paragraph_zero_based":15841},{"literal_text_all_w_t_and_m_t":"SCellAdd","paragraph_zero_based":15842},{"literal_text_all_w_t_and_m_t":"The field is mandatory present upon SCell addition; otherwise it is absent, Need M.","paragraph_zero_based":15843},{"literal_text_all_w_t_and_m_t":"SCellAddMod","paragraph_zero_based":15844},{"literal_text_all_w_t_and_m_t":"The field is mandatory present upon SCell addition; otherwise it is optionally present, need M.","paragraph_zero_based":15845},{"literal_text_all_w_t_and_m_t":"SCellAddSync","paragraph_zero_based":15846},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need N:","paragraph_zero_based":15847},{"literal_text_all_w_t_and_m_t":"-in the masterCellGroup at","paragraph_zero_based":15848},{"literal_text_all_w_t_and_m_t":"-SCell addition,","paragraph_zero_based":15849},{"literal_text_all_w_t_and_m_t":"-reconfiguration with sync,","paragraph_zero_based":15850},{"literal_text_all_w_t_and_m_t":"-resume of an RRC connection.","paragraph_zero_based":15851},{"literal_text_all_w_t_and_m_t":"-in the secondaryCellGroup, when the SCG is not indicated as deactivated at:","paragraph_zero_based":15852},{"literal_text_all_w_t_and_m_t":"-SCG activation while the SCG was previously deactivated,","paragraph_zero_based":15853},{"literal_text_all_w_t_and_m_t":"-SCell addition,","paragraph_zero_based":15854},{"literal_text_all_w_t_and_m_t":"-reconfiguration with sync.","paragraph_zero_based":15855},{"literal_text_all_w_t_and_m_t":"It is absent otherwise.","paragraph_zero_based":15856},{"literal_text_all_w_t_and_m_t":"SCG","paragraph_zero_based":15857},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in an SpCellConfig for the PSCell. It is absent otherwise. ","paragraph_zero_based":15858},{"literal_text_all_w_t_and_m_t":"SCellSIB20-Opt","paragraph_zero_based":15859},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need M, if the field sCellSIB20 is configured. It is absent otherwise.","paragraph_zero_based":15860},{"literal_text_all_w_t_and_m_t":"SCG-Opt","paragraph_zero_based":15861},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need M, in an SpCellConfig for the PSCell. It is absent otherwise.","paragraph_zero_based":15862},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15863}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["9562dca39e244986145e7a51a56ab5a19a8950748f63157bcf1a1b7211a01e14","1d4de5348f441d9076b1e9d02f4ae41a539424e17209e9a6c19692c70e6fe137","5518b17d94ed8287569e0630ef51407620cd92da00cd4959899ef8761fb27801","a7796ef0f8189f2955c295a082c5ea96deb1f5dc3d5980e54160fc5428f5f438","5cb6c16167601d9f4f670f7a996ddf1907af6d051859ccb325e05da652e1f1dc","e34389f0da1ad800c367d491907aa6336d0f85d74fe2c66fd0a67dd16e50a3ed","98abd0fbed0ca49a53b3ab7c7f7804f1ef8689a25f4ef71a9f3f08758573b63c","cfc889174b9edd1eebb077ad390e83c9f44aaf3b8bebc835eff7fbf8237a7b0e","16e525a4f933956e218a6285929b49b63fc987061cc8501e5c047c341021418e","28a2a0cb1b1ee1759b3d6c71f61d8695fba1bd9ab006edc515b80c2a440afa47","47acfb42aa132f1c53a60d1b5314cf45e6f7dfe089c9c92492cd2b0126a5b6c1","883f97b04f99999baed472bcaaf7ec1ec4b51cb2b0bd2552afc8d2afdecc1403","b92f3ad30983eb095cb7060cac1c35c974decd16b8f74667b33b3dadefebbb5b","2bdf581553395bc40be14882017b44f550c3d70f078cf096d4f2c98600e4a77a","c575e0d493a1b7889e81f92ff2f3376e3f4de5312657c3a11b549bac43434db8","a222fe16f04536f160208c8be61a98358bbd15203c837b598d1201bcdb44dd34","7f9d18899e80968a77fdcb036ff9e0d1599fc5e3f234a538befc79fa2e0ceac3","8afa89e80efa22042ceb5bbc3f9ab2538011ba4f3d32f294084cc7cd8ac83b06","fae8c7301180ff1191a7b35b875db6421e1bf4d54c8675f7e48753c1669df16c","9a2cad49ad7ed466b1ee4e868d11404f676a3fa3f25e0dad6172050dce404294","7590fb9130f67fb9919db58fdadc0c0fa23d86ac3a6f64cdbaefb08e8316ea9f","cd37631007ef1507809cbe06f6530f452040190612132045fd57ddb87dc09a75","c3b4e540e0cbb4aafc4f6d1133769474b480159a85d67812d11b195b49967dd4","f66ab1c03e3cd3b991d176c01d48dfd57d2a37b70c6068425b2eb0078476cb25"],"paragraph_range_zero_based":[15840,15863],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p15840"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"NOTE:In case of change of AS security key derived from S-KgNB/S-KeNB, if reconfigurationWithSync is not included in the masterCellGroup, the network releases all existing MCG RLC bearers associated with a radio bearer with keyToUse set to secondary. In case of change of AS security key derived from KgNB/KeNB, if reconfigurationWithSync is not included in the secondaryCellGroup, the network releases all existing SCG RLC bearers associated with a radio bearer with keyToUse set to primary.","paragraph_zero_based":15864},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15865},{"literal_text_all_w_t_and_m_t":"–CellGroupId","paragraph_zero_based":15866},{"literal_text_all_w_t_and_m_t":"The IE CellGroupId is used to identify a cell group. Value 0 identifies the master cell group. Other values identify secondary cell groups. In this version of the specification only values 0 and 1 are supported.","paragraph_zero_based":15867},{"literal_text_all_w_t_and_m_t":"CellGroupId information element","paragraph_zero_based":15868},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":15869},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLGROUPID-START","paragraph_zero_based":15870},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15871},{"literal_text_all_w_t_and_m_t":"CellGroupId ::=                             INTEGER (0.. maxSecondaryCellGroups)","paragraph_zero_based":15872},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15873},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLGROUPID-STOP","paragraph_zero_based":15874},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":15875},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15876},{"literal_text_all_w_t_and_m_t":"–CellIdentity","paragraph_zero_based":15877},{"literal_text_all_w_t_and_m_t":"The IE CellIdentity is used to unambiguously identify a cell within a PLMN/SNPN.","paragraph_zero_based":15878},{"literal_text_all_w_t_and_m_t":"CellIdentity information element","paragraph_zero_based":15879},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":15880},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLIDENTITY-START","paragraph_zero_based":15881},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15882},{"literal_text_all_w_t_and_m_t":"CellIdentity ::=                         BIT STRING (SIZE (36))","paragraph_zero_based":15883},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15884},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLIDENTITY-STOP","paragraph_zero_based":15885},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":15886},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15887}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["8c36a6658515221382631caf01557ff87e7c81db9668adf456a2502fb99d262f","d0fdc65ad9753334cd57ae9a467dd519ef176d0f0e8a5bb42033847669e39a70","4054d81370ba1f586148d49cc58e26b8035da4916d440d3887df549da2c4043e","e83daca4aa21419794a1d6acd19e9875279ad221d34408018bbc813bec401375","a0620aad27ae1036a7d10a4c826b69a18ea49b79877e3f16c6d0556a0ce0e468","b5cf2178eb0f833a7333b8693dcd0d779345ac7300bf79c98d8e1e29a5f5e90f","04c638c70ef0edbcfa72e22a8d071ca655049f63cf4645c78a846b1e74377fa9","4f92231ad0ce392e88a4b25a4e43b4434945a94ee20ff0ea6482aa0245a61218","ba6be4c42c3e7b6441c73e3965eb53fd11f877e57190b16740cea59610d88ca7","0e07b51c1e64701fa967b6732262fac3c5177cfc24f20bfd7be35bfa597be03b","d810f4959e1f8017ef2a5f2779ed932bb657618dc47fefe39610dc59486238b4","2a02c9332c405c6ec5fbb861f52e8001e6fd2984d34a9cb68c5f80818d7a504b","3dbb534692271b54860151407bc22debce9f1ae86eb2b83510c1d14191d6d04c","e35a7dfdcc8e7bd9efa921741c1eab49860d5808b1f542bb830f8d5254096f8b","7cf4ce8d85ea32d33bc7ca5cbd75f855229375c445f1e60c8860617f35e4e5ee","14cb818b7f111f463983818057e7871ce5932b1503310589b4c23532d4aa5046","5fe4b99ffb021387304864b1f14d7178ad99ce4898a5dabbaa571c7e51f9c8bb","efda5848380e90a52b1f3e249195988eca3777d0ce382deae1f40411325e6d52","bc9db79062d19b168c1b1b488d4d540c3d4ec3708e2b07efabc9ba085b6a35da","0af21dfaf9ab83ebd3b2b3b8c484a0bdd56aecc4b78106600639ebf49ad3f4cf","bc3ec8f1412469e0dcecd709c984eeda99acd4d6c13940105fe6163f4b8e95a1","a6b863f540e34ee6541f59d14b2c0a303f40feb917d97520fc226f73ffcd06aa","1e85111d8f9f6f193b820c7e1b46e6374583e00a8ac0d4eb7fd333c29577927f","70f73d9122c0e2b7629c60281eb70414446d9c859dc124b4148269dd534e84b1"],"paragraph_range_zero_based":[15864,15887],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p15864"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–CellReselectionPriority","paragraph_zero_based":15888},{"literal_text_all_w_t_and_m_t":"The IE CellReselectionPriority concerns the absolute priority of the concerned carrier frequency, as used by the cell reselection procedure. Corresponds to parameter \"priority\" in TS 38.304 [20]. Value 0 means lowest priority. The UE behaviour for the case the field is absent, if applicable, is specified in TS 38.304 [20].","paragraph_zero_based":15889},{"literal_text_all_w_t_and_m_t":"CellReselectionPriority information element","paragraph_zero_based":15890},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":15891},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLRESELECTIONPRIORITY-START","paragraph_zero_based":15892},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15893},{"literal_text_all_w_t_and_m_t":"CellReselectionPriority ::=             INTEGER (0..7)","paragraph_zero_based":15894},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15895},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLRESELECTIONPRIORITY-STOP","paragraph_zero_based":15896},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":15897},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15898},{"literal_text_all_w_t_and_m_t":"–CellReselectionSubPriority","paragraph_zero_based":15899},{"literal_text_all_w_t_and_m_t":"The IE CellReselectionSubPriority indicates a fractional value to be added to the value of cellReselectionPriority to obtain the absolute priority of the concerned carrier frequency for E-UTRA and NR. Value oDot2 corresponds to 0.2, value oDot4 corresponds to 0.4 and so on.","paragraph_zero_based":15900},{"literal_text_all_w_t_and_m_t":"CellReselectionSubPriority information element","paragraph_zero_based":15901},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":15902},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLRESELECTIONSUBPRIORITY-START","paragraph_zero_based":15903},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15904},{"literal_text_all_w_t_and_m_t":"CellReselectionSubPriority ::=          ENUMERATED {oDot2, oDot4, oDot6, oDot8}","paragraph_zero_based":15905},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15906},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLRESELECTIONSUBPRIORITY-STOP","paragraph_zero_based":15907},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":15908},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15909},{"literal_text_all_w_t_and_m_t":"–CFR-ConfigMulticast","paragraph_zero_based":15910},{"literal_text_all_w_t_and_m_t":"The IE CFR-ConfigMulticast indicates UE specific common frequency resource configuration for multicast for one dedicated BWP.","paragraph_zero_based":15911}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["3ad1a28c00c1aafa8a3f570e260ce60118bc58fc59e81160188a7a7210e04fb6","6cd7b3a60fe106ec7e6892770d18bbb9b62a67d23e35f157e7794055ec5f6180","8163c485b4c8f69cce6b44587599dc62e2b2e9c46fe0c6fdc9f8dfc1ceb6fa3c","2ff18f9a388b7106f65f664c871a8d15d0161f0b1a64d4a338b8ada681a11a83","8ba0569e49cb5d6f3240b47310eb6c1c27d512dfd51cb9f430ff37624f56519f","17f31f2e56f179f4d252c24629be6aa5b5c24d8eb3ff56ecfa07fd597ec8de56","0ed775147e74f195c77fe526fc45cfbff2bb155f40db80611f4e3c3bf9539ed2","e527c602de10bda0c027023f460dc5ea956d25ffd1d39ced847064261da34af5","c516f550c7be79609d8b738f1e3fdd874d06bd36ec54ba9044c82c3cae9b071a","62ae85b3c2b33d859a0f3f61d64af886d5af79bba5255ae6a2354fb18daaa46d","b24eaaaa880aa3cfb7eb15ac19f1245827391538226