{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31248},{"literal_text_all_w_t_and_m_t":"CA-ParametersNRDC-v1730 ::=                  SEQUENCE {","paragraph_zero_based":31249},{"literal_text_all_w_t_and_m_t":"    ca-ParametersNR-ForDC-v1730                   CA-ParametersNR-v1730                        OPTIONAL","paragraph_zero_based":31250},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":31251},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31252},{"literal_text_all_w_t_and_m_t":"CA-ParametersNRDC-v1760 ::=                  SEQUENCE {","paragraph_zero_based":31253},{"literal_text_all_w_t_and_m_t":"    ca-ParametersNR-ForDC-v1760                  CA-ParametersNR-v1760","paragraph_zero_based":31254},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":31255},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31256},{"literal_text_all_w_t_and_m_t":"-- TAG-CA-PARAMETERS-NRDC-STOP","paragraph_zero_based":31257},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":31258},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31259},{"literal_text_all_w_t_and_m_t":"CA-ParametersNRDC field descriptions","paragraph_zero_based":31260},{"literal_text_all_w_t_and_m_t":"ca-ParametersNR-forDC (with and without suffix)","paragraph_zero_based":31261},{"literal_text_all_w_t_and_m_t":"If this field is present for a band combination, it reports the UE capabilities when NR-DC is configured with the band combination. If a version of this field (i.e., with or without suffix) is absent for a band combination, the corresponding ca-ParametersNR field version in BandCombination is applicable to the UE configured with NR-DC for the band combination. If a version of this field (i.e., with or without suffix) is present for a band combination but does not contain any parameters, the UE does not support the corresponding field version when configured with NR-DC for the band combination.","paragraph_zero_based":31262},{"literal_text_all_w_t_and_m_t":"featureSetCombinationDC","paragraph_zero_based":31263},{"literal_text_all_w_t_and_m_t":"If this field is present for a band combination, it reports the feature set combination supported for the band combination when NR-DC is configured. If this field is absent for a band combination, the featureSetCombination in BandCombination (without suffix) is applicable to the UE configured with NR-DC for the band combination.","paragraph_zero_based":31264},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31265},{"literal_text_all_w_t_and_m_t":"–CarrierAggregationVariant","paragraph_zero_based":31266},{"literal_text_all_w_t_and_m_t":"The IE CarrierAggregationVariant informs the network about supported \"placement\" of the SpCell in an NR cell group.","paragraph_zero_based":31267},{"literal_text_all_w_t_and_m_t":"CarrierAggregationVariant information element","paragraph_zero_based":31268},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":31269},{"literal_text_all_w_t_and_m_t":"-- TAG-CARRIERAGGREGATIONVARIANT-START","paragraph_zero_based":31270},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31271}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["c894cec5326eb47c6e2678ad7074fcebb293b8b4baf00c694d969003184540a5","d7489079926dcc3beb62f4affb0cb2fad0e27651e631d72cf916a4ef2ae8762e","e9662839fdef1c7109289b921b1ada452365b759b77b2658cb06569b302e4b7b","3a9ce3627b49562e8b6a61e8bd9ac2939ca7af9669c67465deaecc899e9266ab","37d13c89c234302b66cab90c01e6ff01e0ea061246436cc