{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SchedulingRequestConfig field descriptions","paragraph_zero_based":27000},{"literal_text_all_w_t_and_m_t":"schedulingRequestToAddModList, schedulingRequestToAddModListExt","paragraph_zero_based":27001},{"literal_text_all_w_t_and_m_t":"List of Scheduling Request configurations to add or modify. If schedulingRequestToAddModListExt is configured, it contains the same number of entries, and in the same order, as schedulingRequestToAddModList.","paragraph_zero_based":27002},{"literal_text_all_w_t_and_m_t":"schedulingRequestToReleaseList","paragraph_zero_based":27003},{"literal_text_all_w_t_and_m_t":"List of Scheduling Request configurations to release.","paragraph_zero_based":27004},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27005},{"literal_text_all_w_t_and_m_t":"SchedulingRequestToAddMod field descriptions","paragraph_zero_based":27006},{"literal_text_all_w_t_and_m_t":"schedulingRequestId","paragraph_zero_based":27007},{"literal_text_all_w_t_and_m_t":"Used to modify a SR configuration and to indicate, in LogicalChannelConfig, the SR configuration to which a logical channel is mapped and to indicate, in SchedulingRequestresourceConfig, the SR configuration for which a scheduling request resource is used.","paragraph_zero_based":27008},{"literal_text_all_w_t_and_m_t":"sr-ProhibitTimer","paragraph_zero_based":27009},{"literal_text_all_w_t_and_m_t":"Timer for SR transmission on PUCCH in TS 38.321 [3]. Value is in ms. Value ms1 corresponds to 1ms, value ms2 corresponds to 2ms, and so on. If sr-ProhibitTimer-v1700 is configured, UE shall ignore sr-ProhibitTimer (without suffix). If both sr-ProhibitTimer (without suffix) and sr-ProhibitTimer-v1700 are absent, the UE applies the value 0.","paragraph_zero_based":27010},{"literal_text_all_w_t_and_m_t":"sr-TransMax","paragraph_zero_based":27011},{"literal_text_all_w_t_and_m_t":"Maximum number of SR transmissions as described in TS 38.321 [3]. Value n4 corresponds to 4, value n8 corresponds to 8, and so on. ","paragraph_zero_based":27012},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27013},{"literal_text_all_w_t_and_m_t":"–SchedulingRequestId","paragraph_zero_based":27014},{"literal_text_all_w_t_and_m_t":"The IE SchedulingRequestId is used to identify a Scheduling Request instance in the MAC layer.","paragraph_zero_based":27015},{"literal_text_all_w_t_and_m_t":"SchedulingRequestId information element","paragraph_zero_based":27016},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27017},{"literal_text_all_w_t_and_m_t":"-- TAG-SCHEDULINGREQUESTID-START","paragraph_zero_based":27018},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27019},{"literal_text_all_w_t_and_m_t":"SchedulingRequestId ::=             INTEGER (0..7)","paragraph_zero_based":27020},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27021},{"literal_text_all_w_t_and_m_t":"-- TAG-SCHEDULINGREQUESTID-STOP","paragraph_zero_based":27022},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27023}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["92209fd1df6ac84b93c56968c094885b5cf3548614a12909d01dee28a03241cf","0b2f4153232a6cec0301110684c04946762b84a053c1e3706c377e9638562720","7872d17a6f0b2e459a52cfde0d9d59bf1cebf6a0e963431e2f916209d4380305","98bdba2c8e6c3de76b7828f73af135455abb4557a98d75a66f9609200f826219","cc7626371dab8ceddd74252b4013764599dd093bffef37bdf890436f4bbeb8b4","c20e761857775dabd309805be6a26f77dff6c2570b725e814b37859f82ffc1c0","916101f0e4a1df617430ec