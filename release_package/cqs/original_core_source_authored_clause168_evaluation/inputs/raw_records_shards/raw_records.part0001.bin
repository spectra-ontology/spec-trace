{"fields":{"filename":"R2-2313691.zip::R2-2313691_Introduction of support for BWP operation without restriction in TS38.331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-SCell addition,","paragraph_zero_based":648},{"literal_text_all_w_t_and_m_t":"-reconfiguration with sync,","paragraph_zero_based":649},{"literal_text_all_w_t_and_m_t":"-resume of an RRC connection.","paragraph_zero_based":650},{"literal_text_all_w_t_and_m_t":"-in the secondaryCellGroup, when the SCG is not indicated as deactivated at:","paragraph_zero_based":651},{"literal_text_all_w_t_and_m_t":"-SCG activation while the SCG was previously deactivated,","paragraph_zero_based":652},{"literal_text_all_w_t_and_m_t":"-SCell addition,","paragraph_zero_based":653},{"literal_text_all_w_t_and_m_t":"-reconfiguration with sync.","paragraph_zero_based":654},{"literal_text_all_w_t_and_m_t":"It is absent otherwise.","paragraph_zero_based":655},{"literal_text_all_w_t_and_m_t":"SCG","paragraph_zero_based":656},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in an SpCellConfig for the PSCell. It is absent otherwise. ","paragraph_zero_based":657},{"literal_text_all_w_t_and_m_t":"SCellSIB20-Opt","paragraph_zero_based":658},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need M, if the field sCellSIB20 is configured. It is absent otherwise.","paragraph_zero_based":659},{"literal_text_all_w_t_and_m_t":"SCG-Opt","paragraph_zero_based":660},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need M, in an SpCellConfig for the PSCell. It is absent otherwise.","paragraph_zero_based":661},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":662},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":663},{"literal_text_all_w_t_and_m_t":"Next change ","paragraph_zero_based":664},{"literal_text_all_w_t_and_m_t":"–NeedForGapsInfoNR","paragraph_zero_based":665},{"literal_text_all_w_t_and_m_t":"The IE NeedForGapsInfoNR indicates whether measurement gap is required for the UE to perform SSB based measurements on an NR target band while NR-DC or NE-DC is not configured.","paragraph_zero_based":666},{"literal_text_all_w_t_and_m_t":"NeedForGapsInfoNR information element","paragraph_zero_based":667},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":668},{"literal_text_all_w_t_and_m_t":"-- TAG-NeedForGapsInfoNR-START","paragraph_zero_based":669},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":670},{"literal_text_all_w_t_and_m_t":"NeedForGapsInfoNR-r16 ::=        SEQUENCE {","paragraph_zero_based":671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"61f02ceef1d524906560f8f1a482d15e83f76eb00023609c334c63ed8d6c34a9","original_member_sha256":"f9c2336c81c37716b94a78c676bf5f6ace0ec61f8e01450cd0d55d702a9ad7ba","paragraph_ElementTree_utf8_XML_sha256":["8b95d0560195d119cd7a3780aa430c0beef9fd3f8ff1311bc06ac994136f6494","f70914b359da83d9ace45c87328d90d7bd5c1696b9b8c8e382d16f4936cb3e8d","d21756c02ff4c8392f49a88725a28a245124ef68d25d5aeace59feb7de2ee67c","79439ee7373f58c97a5b03d8553f3aa2ba5634d72b4b3c238c346d9d50892ca8","fe0051d1fb3ad29eaa8d61de6305fd3e004bff7816cda87da78a9a98472047de","0b4569a4c28ca08521e57f884c2b3c9563561284fe6b8bf3ff415d8d0e94c40b","db44d2b9c2117d32e86e8bf432f9b5e7b4be81ac2aa3e4c42e8c89b2a9557606","75a0be8f335dfe19737f4654c8ee11c13fb22842ad21c8e7a4daea5ba4199de2","cdb09772d21feefb51741419f49da89153c7088a4d5f4e1d5df02c6bce8ce1ee","ec222335b9e82ea9e98df6a6cfaa32d489e797a39389ccb3988368c07d227d67","e0a9a84e4d123560dff8cf2a343605621d4e6fb90abcddccaada655d2dbd94ee","6ae73428a51aab73209cf874f982372a5361e8dbd3312fee3d5601a1aa5dccc1","1d48a0e161d36dfe89d819d565b61988e77d90a6de4a6d0323248ad316f267b0","abd587a5529e37426a46f686c301bcf58a92ad374a8e7179bfea8121676cacfb","a21c1ca04518bc3fb7fb59e9260375c7e6c3369d838b527d89842de77d6