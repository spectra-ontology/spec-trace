ER (2..256)","paragraph_zero_based":32077},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":32078},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32079},{"literal_text_all_w_t_and_m_t":"-- TAG-CODEBOOKPARAMETERS-STOP","paragraph_zero_based":32080},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32081},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32082},{"literal_text_all_w_t_and_m_t":"CodebookParameters field descriptions","paragraph_zero_based":32083},{"literal_text_all_w_t_and_m_t":"supportedCSI-RS-ResourceListAlt","paragraph_zero_based":32084},{"literal_text_all_w_t_and_m_t":"This field indicates the alternative list of SupportedCSI-RS-Resource supported for each codebook type. The supported CSI-RS resource is indicated by an integer value which pinpoints SupportedCSI-RS-Resource defined in CodebookVariantsList. The value 0 corresponds to the first entry of CodebookVariantsList. The value 1 corresponds to the second entry of CodebookVariantsList, and so on. For each codebook type, the field shall be included in both codebookParametersPerBC (but optional for single CC) and codebookParametersPerBand.","paragraph_zero_based":32085},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32086},{"literal_text_all_w_t_and_m_t":"–FeatureSetCombination","paragraph_zero_based":32087}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["f19e550c84f8c06722d2ff310a216d041c9d39c09a5cb3803da652c02d27d72c","6e954e9ffd43aa73d74aa3031383c5beee944289765be64227c9b762588334ec","c535eee0e452e7941b4533d2839addca2c9a24f8d87b014e31dd0877ff0bb562","9e8710c9656ac6ba35a5105c394c164194a17f259ad3484d5cad7805b87fd44b","7cc80740413be7cb3f9a8