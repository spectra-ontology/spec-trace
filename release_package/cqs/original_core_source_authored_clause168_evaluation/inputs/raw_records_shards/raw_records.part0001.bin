{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"If absent, RedCap UEs use initialDownlinkBWP provided that it does not exceed the RedCap UE maximum bandwidth (see also clause 5.2.2.4.2).","paragraph_zero_based":18072},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18073},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":18074},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":18075},{"literal_text_all_w_t_and_m_t":"InterFreqHOAndServCellAdd","paragraph_zero_based":18076},{"literal_text_all_w_t_and_m_t":"This field is mandatory present for inter-frequency handover, and upon serving cell (PSCell/SCell) addition. Otherwise, the field is optionally present, Need M.","paragraph_zero_based":18077},{"literal_text_all_w_t_and_m_t":"ServCellAdd","paragraph_zero_based":18078},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon serving cell addition (for PSCell and SCell) and upon handover from E-UTRA to NR. It is optionally present, Need M otherwise.","paragraph_zero_based":18079},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18080},{"literal_text_all_w_t_and_m_t":"–DownlinkConfigCommonSIB","paragraph_zero_based":18081},{"literal_text_all_w_t_and_m_t":"The IE DownlinkConfigCommonSIB provides common downlink parameters of a cell.","paragraph_zero_based":18082},{"literal_text_all_w_t_and_m_t":"DownlinkConfigCommonSIB information element","paragraph_zero_based":18083},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18084},{"literal_text_all_w_t_and_m_t":"-- TAG-DOWNLINKCONFIGCOMMONSIB-START","paragraph_zero_based":18085},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18086},{"literal_text_all_w_t_and_m_t":"DownlinkConfigCommonSIB ::=     SEQUENCE {","paragraph_zero_based":18087},{"literal_text_all_w_t_and_m_t":"    f