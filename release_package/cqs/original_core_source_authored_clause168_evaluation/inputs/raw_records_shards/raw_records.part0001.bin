{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        frequencyRegionForCI-r16                 INTEGER (0..37949),","paragraph_zero_based":30144},{"literal_text_all_w_t_and_m_t":"        deltaOffset-r16                          INTEGER (0..2),","paragraph_zero_based":30145},{"literal_text_all_w_t_and_m_t":"        ...","paragraph_zero_based":30146},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":30147},{"literal_text_all_w_t_and_m_t":"    uplinkCancellationPriority-v1610         ENUMERATED {enabled}                                                  OPTIONAL    -- Need S","paragraph_zero_based":30148},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30149},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30150},{"literal_text_all_w_t_and_m_t":"-- TAG-UPLINKCANCELLATION-STOP","paragraph_zero_based":30151},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":30152},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30153},{"literal_text_all_w_t_and_m_t":"UplinkCancellation field descriptions","paragraph_zero_based":30154},{"literal_text_all_w_t_and_m_t":"ci-ConfigurationPerServingCell","paragraph_zero_based":30155},{"literal_text_all_w_t_and_m_t":"Indicates (per serving cell) the position of the ci-PaylaodSize bit CI values inside the DCI payload (see TS 38.213 [13], clause 11.2A).","paragraph_zero_based":30156},{"literal_text_all_w_t_and_m_t":"ci-RNTI","paragraph_zero_based":30157},{"literal_text_all_w_t_and_m_t":"RNTI used for indication cancellation in UL (see TS 38.212 [17] clause 7.3.1 and TS 38.213 [13], clause 11.2A).","paragraph_zero_based":30158},{"literal_text_all_w_t_and_m_t":"dci-PayloadSizeForCI","paragraph_zero_based":30159},{"literal_text_all_w_t_and_m_t":"Total length of the DCI payload scrambled with CI-RNTI (see TS 38.213 [13], clause 11.2A).","paragraph_zero_based":30160},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30161},{"literal_text_all_w_t_and_m_t":"CI-ConfigurationPerServingCell field descriptions","paragraph_zero_based":30162},{"literal_text_all_w_t_and_m_t":"ci-PayloadSize","paragraph_zero_based":30163},{"literal_text_all_w_t_and_m_t":"Configures the field size for each UL cancelation indicator of this serving cell (servingCellId) (see TS 38.213 [13], clause 11.2A).","paragraph_zero_based":30164},{"literal_text_all_w_t_and_m_t":"deltaOffset","paragraph_zero_based":30165},{"literal_text_all_w_t_and_m_t":"Configures the additional offset from the end of a PDCCH reception where the UE detects the DCI format 2_4 and the first symbol of the T_\"CI\" symbols, in the unit of OFDM symbols (see TS 38.213 [13], clause 11.2A).","paragraph_zero_based":30166},{"literal_text_all_w_t_and_m_t":"frequencyRegionForCI","paragraph_zero_based":30167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["e737f8dfca913ec017e0c52ed749ffae74a2dbe542646d14b10685a5fffd958c","ada7e3c0d952cace9213ff6c3ca27062b6585da83b4e59c25bf6576984e7c80b","116d9beaef278d52bcc8a32d6bf2c7798f5ce22d82507cbfc569da6788df713f","d1eed7e551561ffb0725700ec5db3529eaf33ed12f0f27451534d8ebaf19b040","843de190f10e21b37d0d55b21e7cf633efbb8113f7b477862c73f5aac4001479","190dc566b967dcd59b1b8a8d7cfbd80afc558e522e0f84e06f230f04cbcc789f","79a241864294746e7ae88eb8907a559e564781981f8102fa89d1d06e6c69d9af","8ecbd079c9aac1e0285f02659d83c1308d6d42721b7b039baed0362598f79b13","20d841f8e0caf0f1b24d2cfdf0227f41851a35a8d9c3a12cad7d3d5d84fafc72","a6e8ff23a495b9667b30c289ba62460eb396aaac8d92b399de996125e5d88dc6","f084465c26f0790b0477bcf3d84ea80815d4b88a2ffbac4042e619e516b6f604","fb2aaa6e91f07c3c9559b3e3bc6717c41f48fcce49699173bb535ba73cd1ead1","6cd5f2b9eaec21b596426f2069bf7b27ad9727b420eb5e23c3976a982559774d","440cb45a2b310974835d151d4c637915def761d3e7c579de2cf07d56d8a5b6ce","ee490ca0931baf7f1119887f82077115a74b81f1cfc237c1f17d0b65e245786c","c0efb802c2ef1de713867672d6886b0fa7fae534fbf03d6008d76cc5063cafb8","a561d198bdaa7ae6aea02c740a9e3cc1307548483bd119a49ebfd5834203ec01","dead8a303987ada9fefcc07b50d7604035f2aa868189f4ec29de6ceb0ac746d1","10b30ca465b3f65b3138323b9b9dc59832c405aa28700c95434ba95595923e14","dfe3a0eaa7a9bd5db841bb9bff2d7ca8968a3b9248fe56b91e119bea4b018a63","a85ade139c11e7a9a91181aebd475c58034f7a7a3d1a249116ffe26446803e9a","ba87bc32733084d76c81af09482db951f989711671a96225d1f662b5cc517c35","dcfde9e1f5f15656590033e47b94f617a42e13fb2a9431e7a5159a203f92f6b8","da79c4dda85e7bb07a50dfd615c8ab7e89a0bbc01d1d1affb1c659fc8ba0b22e"],"paragraph_range_zero_based":[30144,30167],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p30144"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Configures the reference frequency region where a detected UL CI is applicable (see TS 38.213 [13], clause 11.2A). It is defined in the same way as locationAndBandwidth.","paragraph_zero_based":30168},{"literal_text_all_w_t_and_m_t":"positionInDCI","paragraph_zero_based":30169},{"literal_text_all_w_t_and_m_t":"Starting position (in number of bit) of the ci-PayloadSize bit CI value applicable for this serving cell (servingCellId) within the DCI payload (see TS 38.213 [13], clause 11.2A).","paragraph_zero_based":30170},{"literal_text_all_w_t_and_m_t":"positionInDCI-ForSUL","paragraph_zero_based":30171},{"literal_text_all_w_t_and_m_t":"Starting position (in number of bit) of the ci-PayloadSize bit CI value applicable for SUL of this serving cell (servingCellId) within the DCI payload (see TS 38.213 [13], clause 11.2A).","paragraph_zero_based":30172},{"literal_text_all_w_t_and_m_t":"timeDurationForCI","paragraph_zero_based":30173},{"literal_text_all_w_t_and_m_t":"Configures the duration of the reference time region in symbols where a detected UL CI is applicable of this serving cell (servingCellId) (see TS 38.213 [13], clause 11.2A). If the field is absent, i.e., the configured UL CI monitoring periodicity indicated by monitoringSlotPeriodicityAndOffset for DCI format 2_4 is larger than 1 slot or 1 slot with only one monitoring occasion, the UE applies the value of the configured UL CI monitoring periodicity,","paragraph_zero_based":30174},{"literal_text_all_w_t_and_m_t":"timeFrequencyRegion","paragraph_zero_based":30175},{"literal_text_all_w_t_and_m_t":"Configures the reference time and frequency region where a detected UL CI is applicable of this serving cell (servingCellId) (see TS 38.213 [13], clause 11.2A).","paragraph_zero_based":30176},{"literal_text_all_w_t_and_m_t":"timeGranularityForCI","paragraph_zero_based":30177},{"literal_text_all_w_t_and_m_t":"Configures the number of partitions within the time region of this serving cell (servingCellId) (see TS 38.213 [13], clause 11.2A).","paragraph_zero_based":30178},{"literal_text_all_w_t_and_m_t":"uplinkCancellationPriority","paragraph_zero_based":30179},{"literal_text_all_w_t_and_m_t":"Configures uplink cancellation behavior if both UL CI and intra-UE priority indicator are configured for a given UE. If the field is present, then UL CI is only applicable to the UL transmissions indicated/configured as low priority level. If the field is absent, UL CI is applicable to UL transmission irrespective of its priority level (see TS 38.213 [13], clause 11.2A).","paragraph_zero_based":30180},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30181},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":30182},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":30183},{"literal_text_all_w_t_and_m_t":"SUL-Only","paragraph_zero_based":30184},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if supplementaryUplink is configured in ServingCellConfig. It is absent otherwise.","paragraph_zero_based":30185},{"literal_text_all_w_t_and_m_t":"SymbolPeriodicity","paragraph_zero_based":30186},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if the configured UL CI monitoring periodicity indicated by monitoringSlotPeriodicityAndOffset for DCI format 2_4 is 1 slot with more than one monitoring occasion, otherwise absent.","paragraph_zero_based":30187},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30188},{"literal_text_all_w_t_and_m_t":"–UplinkConfigCommon","paragraph_zero_based":30189},{"literal_text_all_w_t_and_m_t":"The IE UplinkConfigCommon provides common uplink parameters of a cell.","paragraph_zero_based":30190},{"literal_text_all_w_t_and_m_t":"UplinkConfigCommon information element","paragraph_zero_based":30191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["ccb669fc60cc1152f5e644fdb792a53208e954df6aa2fae0fc2ae7becdff5bca","3b88fc777ae09f5eb25e9c376b6d5a275f71aaaf7273d52c363909a1c2ea5e18","1cfd5081fa2fd7fe981245b74f8480b548cb866fb18907a9e4fc57813b2e9673","8c170542310d93d114211dc3320ecfd89aa103470fd9e818137200345c6764df","e1ec8103760222e2f861a89f911abcbe4a082f09f08ef04c6923a9738c45bb01","04e8603440e5b5668da511c009cfde5e3765fd3be6013604ededafd600f8d83d","77cb4218b852b9facf81a8f0a7a191125ed724da17e95f078820e0463d509cce","d375bc7c794c7d919ac3ba577ef54a2fab23267c895d7aca40424aeb7a3fa375","ce4e99bdde26e05de546b5ac3f100981d6b52954f0d011a4af180beeaf3df45e","101ade427f1c7f0d5bab3457a8c6c27514608688b3038f3251d1b816db961ea7","7909ffd931672210dc8d20251b1d4eb5ae6ecfb49cfbbffd06ee76b5fc37e4dc","00bbf49b4cd5fe4246459f3daf8fade6683d2d18981e02447a668eef4277611f","38fb795626df8b77dc7b3eb473774992100d799f0ca5f2f32550e99c2080b596","5d065cda2b4060ec17b55e4e86dc1bcb682a73ca04be165be6fea69db47763c4","1953220b22ce59290f0113a2efce772122012aacdd98f88e8fef6efbffb8431c","105737f96e50e387ef59976187c68bed5cc296aded6edbc594a5b4b3f864b38a","916ba013442b9a2c71bbd9471686c1d0f8bec8c80d8f20a94a412db880beb4e7","8a7eaa4e7cea2a49057df3c08c5a189baae85db78b12c29757d8ad53071b9a25","6fef17c1ff1dc452a52bcbd2bd9a060242ce0d2710f7285de2435e86311a9ca2","2ae67977b718c89573b7258a284631ed38c1cdc717f5be9d12061968abe133d9","163b38157d9f5531bdf596472e83277942416c811a0f151ad900359248d7bdfd","88398d120c5b4f08b1146bcad474a565a3a45d0b47128c93374bd127d6a0a8a8","be2478a65cb7fed8fb2e8903091eddf40b0c2d894f57a31d86b67f7133cd8e48","874516c28504ac870a4327355d0e3642527acac1214bc6586a6801a4a846925e"],"paragraph_range_zero_based":[3