{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Timer value of t-PollRetransmit for RLC AM for NR sidelink communications, see TS 38.322 [4], in milliseconds. Value ms5 means 5 ms, value ms10 means 10 ms and so on.","paragraph_zero_based":39456},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39457},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":39458},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":39459},{"literal_text_all_w_t_and_m_t":"SLRBSetup","paragraph_zero_based":39460},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in case of sidelink DRB setup via the dedicated signalling and in case of sidelink DRB  configuration via system information and pre-configuration; otherwise the field is optionally present, need M.","paragraph_zero_based":39461},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39462},{"literal_text_all_w_t_and_m_t":"–SL-ScheduledConfig","paragraph_zero_based":39463},{"literal_text_all_w_t_and_m_t":"The IE SL-ScheduledConfig specifies sidelink communication configurations used for network scheduled NR sidelink communication.","paragraph_zero_based":39464},{"literal_text_all_w_t_and_m_t":"SL-ScheduledConfig information element","paragraph_zero_based":39465},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39466},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SCHEDULEDCONFIG-START","paragraph_zero_based":39467},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39468},{"literal_text_all_w_t_and_m_t":"SL-ScheduledConfig-r16 ::=                   SEQUENCE {","paragraph_zero_based":39469},{"literal_text_all_w_t_and_m_t":"    sl-RNTI-r16                                  RNTI-Value,","paragraph_zero_based":39470},{"literal_text_all_w_t_and_m_t":"    mac-MainConfigSL-r16                         MAC-MainConfigSL-r16                                     OPTIONAL,    -- Need M","paragraph_zero_based":39471},{"literal_text_all_w_t_and_m_t":"    sl-CS-RNTI-r16                               RNTI-Value                                               OPTIONAL,    -- Need M","paragraph_zero_based":39472},{"literal_text_all_w_t_and_m_t":"    sl-PSFCH-ToPUCCH-r16                         SEQUENCE (SIZE (1..8)) OF INTEGER (0..15)                OPTIONAL,    -- Need M","paragraph_zero_based":39473},{"literal_text_all_w_t_and_m_t":"    sl-ConfiguredGrantConfigList-r16             SL-ConfiguredGrantConfigList-r16                         OPTIONAL,    -- Need M","paragraph_zero_based":39474},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":39475},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":39476},{"literal_text_all_w_t_and_m_t":"    sl-DCI-ToSL-Trans-r16                        SEQUENCE (SIZE (1..8)) OF INTEGER (1..32)                OPTIONAL     -- Need M","paragraph_zero_based":39477},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":39478},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["e1f8dfa10c2808a0dca128eba1df2c1542400eabe2086db1542a6b79908d11d6","91bc6c9289fdf95e686d88dbba0a991ccce8b604fe2c033b5024866ac5890029","40ebbdbdc5747adbdf492fc032db3cd8a1a38ae9ab6fb0f7de5129dae081efd2","c576ce6aa5363ffbdfd8c4d30de0d178de364ed7f22bd06148021e718b083069","3e1d5d055c6fd6cf02954a1d3484862a67428e0e3a4828b077fdc6a141f7323d","78768022d457b23617935638aabeca0f837e39d82e821043137911538d667963","95cb8d35cc49896e643120177f0b9bd132ccf357d25d4fa0ddcfcbea6ddcc54c","c9db2d53ef9b53b5d3