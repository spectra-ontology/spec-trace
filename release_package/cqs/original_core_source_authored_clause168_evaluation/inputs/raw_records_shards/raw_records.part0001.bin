0034c96a","043056fe4422bfa86089fb1c77e140610c8c06aa2bda0b62d9f4e15b75aaccf0","6c5ee8680604385a22527759c543946c41a9e7d5d19e165484d48b52c893b6a7","7d7a315d3e71ee61f36270bf57260202399c55a545fc1d257c6170ea3e368d59","51e6c6c7dd4e8b47b2359e1ed099f1f21fa1e0840d2cd58306c743c530bf7ed0","30e91c2e3e931dc93486f86c15592baad5092390a6af060d675090eca208431d","074c700ebf4ea0b6bcfde9cd6b14f4ceafe0d772e4a3901fc61033ee1251dfdb","96dc4eed1e8a2132f401bd878d801673c2fed155511ef958a100cdbcd8fb7456","169a4cd6877186b26a5bfc62c2e4865a2987e04b6cd3ec672572747d29667be3","99a613009859f3ac2f362347ff36854f973994f9414cc0379a85b40cfb74ba3d","18279d0bf081f5f34feb420098e99df668601527b089b5ca7fa0e0ff4b8f9636","616eb1d01beccfd45fa001b64a9d40e19dad05e0e8063c8803183d2fd9373d23","aa7457e7c8ab679ea2d1e23a0cee523effa66aa74ca77ed9eaf85688c6dd3775","e7237e5f9648f956a520a27b9ea448c9f061f0dc89da1286581659bcf51333c7","0f32ea574d1d587cb2ef009f6fc7cba4b76c29908792e68d94e527950045a550","e799393d887e5f2f3465a0af1851a9f1f59134df14019c945b41313f12f4dbeb","245700548b1a1654ce2188b5c6c4db2108b96fd087dcfb64a712fdf0c261f76b","367de1e6f0de8d22df399c9f3d37e57f792b39ba09ec15ce62c44c448335b809","949c832fde8200b714757c9f645e1e5e02dd652bb9cacdd2c5ea9e60fd11212d","9001bcfc1c86b74d81fcbfa1571b9c5cd2fb6251b99bc335de96a352055665fe"],"paragraph_range_zero_based":[27744,27767],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p27744"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27768},{"literal_text_all_w_t_and_m_t":"-- TAG-SERVINGCELLCONFIGCOMMONSIB-STOP","paragraph_zero_based":27769},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27770},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27771},{"literal_text_all_w_t_and_m_t":"ServingCellConfigCommonSIB field descriptions","paragraph_zero_based":27772},{"literal_text_all_w_t_and_m_t":"channelAccessMode","paragraph_zero_based":27773},{"literal_text_all_w_t_and_m_t":"If present, this field indicates which channel access procedures to apply for operation with shared spectrum channel access as defined in TS 37.213 [48]. If the field is configured as \"semiStatic\", the UE shall apply the channel access procedures for semi-static channel occupancy as described in clause 4.3 in TS 37.213. If the field is configured as \"dynamic\", the UE shall apply the channel access procedures as defined in TS 37.213, clause 4.1 and 4.2.","paragraph_zero_based":27774},{"literal_text_all_w_t_and_m_t":"channelAccessMode2","paragraph_zero_based":27775},{"literal_text_all_w_t_and_m_t":"If present, this field indicates that the UE shall apply channel access procedures for operation with shared spectrum channel access in accordance with TS 37.213 [48], clause 4.4 for FR2-2. If absent, the UE shall not apply any channel access procedure. The network always configures this field if channel access procedures are required for the serving cell within this region by regulations.","paragraph_zero_based":27776},{"literal_text_all_w_t_and_m_t":"discoveryBurstWindowLength","paragraph_zero_based":27777},{"literal_text_all_w_t_and_m_t":"Indicates the window length of the discovery burst in ms (see TS 37.213 [48]). The field discoveryBurstWindowLength-v1700 is applicable to SCS 480 kHz and SCS 960 kHz.","paragraph_zero_based":27778},{"literal_text_all_w_t_and_m_t":"enhancedMeasurementLEO","paragraph_zero_based":27779},{"literal_text_all_w_t_and_m_t":"If the field is present and UE supports the enhanced cell reselection requirements for NTN LEO in RRC_IDLE/RRC_INACTIVE, the UE shall apply the enhanced cell reselection requirements for NTN LEO as specified in TS 38.133 [14], clauses 4.2C.2.3 and 4.2C.2.4.","paragraph_zero_based":27780},{"literal_text_all_w_t_and_m_t":"groupPresence","paragraph_zero_based":27781},{"literal_text_all_w_t_and_m_t":"This field is present when maximum number of SS/PBCH blocks per half frame equals to 64 as defined in TS 38.213 [13], clause 4.1. The first/leftmost bit corresponds to the SS/PBCH index 0-7, the second bit corresponds to SS/PBCH block 8-15, and so on. Value 0 in the bitmap indicates that the SSBs according to inOneGroup are absent. Value 1 indicates that the SS/PBCH blocks are transmitted in accordance with inOneGroup.","paragraph_zero_based":27782},{"literal_text_all_w_t_and_m_t":"inOneGroup","paragraph_zero_based":27783},{"literal_text_all_w_t_and_m_t":"When maximum number of SS/PBCH blocks per half frame equals to 4 as defined in TS 38.213 [13], clause 4.1, only the 4 leftmost bits are valid; the UE ignores the 4 rightmost bits. When maximum number of SS/PBCH blocks per half frame equals to 8 as defined in TS 38.213 [13], clause 4.1, all 8 bits are valid. The first/ leftmost bit corresponds to SS/PBCH block index 0, the second bit corresponds to SS/PBCH block index 1, and so on. When maximum number of SS/PBCH blocks per half frame equals to 64 as defined in TS 38.213 [13], clause 4.1, all 8 bit are valid; The first/ leftmost bit corresponds to the first SS/PBCH block index in the group (i.e., to SSB index 0, 8, and so on); the second bit corresponds to the second SS/PBCH block index in the group (i.e., to SSB index 1, 9, and so on), and so on. Value 0 in the bitmap indicates that the corresponding SS/PBCH block is not transmitted while value 1 indicates that the corresponding SS/PBCH block is transmitted.","paragraph_zero_based":27784},{"literal_text_all_w_t_and_m_t":"n-TimingAdvanceOffset","paragraph_zero_based":27785},{"literal_text_all_w_t_and_m_t":"The N_TA-Offset to be applied for random access on this serving cell. If the field is absent, the UE applies the value defined for the duplex mode and frequency range of this serving cell. See TS 38.133 [14], table 7.1.2-2.","paragraph_zero_based":27786},{"literal_text_all_w_t_and_m_t":"ra-ChannelAccess","paragraph_zero_based":27787},{"literal_text_all_w_t_and_m_t":"If present, this field indicates that the UE shall apply channel access procedures before msg1/msgA transmission for operation with shared spectrum channel access in accordance with TS 37.213 [48], clause 4.4.5 for FR2-2.","paragraph_zero_based":27788},{"literal_text_all_w_t_and_m_t":"ssb-PositionsInBurst","paragraph_zero_based":27789},{"literal_text_all_w_t_and_m_t":"Time domain positions of the transmitted SS-blocks in an SS-burst as defined in TS 38.213 [13], clause 4.1.","paragraph_zero_based":27790},{"literal_text_all_w_t_and_m_t":"For operation with shared spectrum channel access in FR1, only inOneGroup is used and the UE interprets this field same as mediumBitmap in ServingCellConfigCommon. The UE assumes that a bit in inOneGroup at position k > NSSBQCL is 0, where NSSBQCL is obtained from MIB as specified in TS 38.213 [13], clause 4.1. For operation with shared spectrum channel access in FR2-2, the m-th bit in groupPresence is set to 0 for m > NSSBQCL/8, where NSSBQCL is obtained from MIB as specified in TS 38.213 [13], clause 4.1.","paragraph_zero_based":27791}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["573882dac45a50528f28a080b471a731c7765b119585b3d21b49f6766e1d9726","387687b437ba8346445f7cfb9af6105a935c3306b3109fd45f989583601970bf","d910b3743a261f03577849788f90d1704d323fbcbf6becd89fa338da0591dbed","f8c0d698ae448abc8eceddcd1be01a076a983dbd08540a58b2e569ef8a6ad1ff","b465dc9596fb81908716656aec3d08d856f83d552a16621eaca961858aa01124","4e47f3acc4070f41341c2e4494a1d683bde48a9712412ea834808cda40360ed4","d2556a4b0a0c696bf743fa5c93b4654faa652e2400287f8ebbe16bf6955122fd","f7435a650ac5f6daebc7f2b26875c2b411323b5e0adbfaa9d49d31973034b82f","cbca2b06fa2e923d886116b1a6f9e37d3f9b9d17f9e897003f4b919b7be7fdeb","20ad1698ab63945d7f6c7c43252ba08e377489c96db42e785e154a4fe1b0c314","3e2ee653ed12a2d2998f24210efb68dd509e2b19b23537c5c1c707692066a2ab","2dde288c9120fad684b37c4b16fa8b68812c68a1b2ebbf4364370d763fc1bd62","fd85115dd32c0d06a0ca9a517235f07053a46d4dc1c13711a17ecebe2dbcdb4c","e9282d78acf5eff9785f9dc8c83d4ce27a8f47b0a250710fb93492a3174e044d","8033932911b8094d11599b71f95a4492219cd181180761a49018707dc393e1cd","d6a9c0c438cedbe709b856694e707d66e1ef41c81bc050a774cad58d9f3b0a40","5c671e50adbf203383a789e62e2fb5031f8b6a250d57f0fbc4414f1ab84e0e05","cbf18886cc8bbdffc4592ccc2d6be06fdf6daac518fc993905efb0aadc46aad9","071cb761934227a29b84c7e7330f358e5e0a35a3e403ec184e7084c05de915f7","419a8319b803cb50eace87089d14317f85a22baf81b39d89b6c464c3ed88d324","32a629afc8ea7f8d31cf00398e4c66f8a7b6ad307d4b1f0415d286f0f4a684b0","142d9e7d5c2d9e42b15ee402f493387ca969fae0f661e457bbe3a907199b1a4f","473f7f39e06d611a76f88a6017efed7eb36742083d9facb0883b077e0a189834","a9487f28748fb10d540b9a306039e5559b5b5dc8fa47a0efd29bfd382e714684"],"paragraph_range_zero_based":[27768,27791],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p27768"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ss-PBCH-BlockPower","paragraph_zero_based":27792},{"literal_text_all_w_t_and_m_t":"Average EPRE of the resources elements that carry secondary synchronization signals in dBm that the NW used for SSB transmission, see TS 38.213 [13], clause 7.","paragraph_zero_based":27793},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27794},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":27795},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":27796},{"literal_text_all_w_t_and_m_t":"FR2-Only","paragraph_zero_based":27797},{"literal_text_all_w_t_and_m_t":"This field is mandatory present for an FR2 carrier frequency. It is absent otherwise and UE releases any configured value.","paragraph_zero_based":27798},{"literal_text_all_w_t_and_m_t":"SharedSpectrum","paragraph_zero_based":27799},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if this cell operates with shared spectrum channel access in FR1. Otherwise, it is absent, Need R.","paragraph_zero_based":27800},{"literal_text_all_w_t_and_m_t":"SharedSpectrum2","paragraph_zero_based":27801},{"literal_text_all_w_t_and_m_t":"This field is optionally present if this cell operates with shared spectrum channel access in FR2-2, Need R. Otherwise, it is absent, Need R.","paragraph_zero_based":27802},{"literal_text_all_w_t_and_m_t":"TDD","paragraph_zero_based":27803},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, for TDD cells; otherwise it is absent.","paragraph_zero_based":27804},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27805},{"literal_text_all_w_t_and_m_t":"–ShortI-RNTI-Value","paragraph_zero_based":27806},{"literal_text_all_w_t_and_m_t":"The IE ShortI-RNTI-Value is used to identify the suspended UE context of a UE in RRC_INACTIVE using fewer bits compared to I-RNTI-Value.","paragraph_zero_based":27807},{"literal_text_all_w_t_and_m_t":"ShortI-RNTI-Value information element","paragraph_zero_based":27808},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27809},{"literal_text_all_w_t_and_m_t":"-- TAG-SHORTI-RNTI-VALUE-START","paragraph_zero_based":27810},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27811},{"literal_text_all_w_t_and_m_t":"ShortI-RNTI-Value ::=   BIT STRING (SIZE(24))","paragraph_zero_based":27812},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27813},{"literal_text_all_w_t_and_m_t":"-- TAG-SHORTI-RNTI-VALUE-STOP","paragraph_zero_based":27814},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27815}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["16772135bc2673c853b71e969152dbf79ac98455ba1b391475afc915a5b544d9","09465000534cec065d61d73bb93ac9cb5600b3583325eb2bfe783cbfa0a02fb9","26033c660b1eb12adb542e7adf1f804a70115d0bf65abaeeefe605f6de12ef50","bdd9a735ad816e89b752f4b9c23395de0140f7ea888dd9658ec8e08bfcb50b88","44d74f421953f637adf6653c18fee35691d41ce323774f035ae276045ac0286a","76826d821e495972d241f863d4dae2301fcbbde31ce50f4b1b47407bf906e9fa","854714330a8bc52373382eda9e33858b78afbf2292c3990392da2eb8bbfb6e36","ab5cc219f254de77f43b453029dd1e7659db228dd8d36323ee7d5bbe6b667a2a","10d87ad7ae2eccfd9ee20a3ff7fffd7dc45a9e9ed82bfaa4254ab758cc606807","d940c6dcbec5d8c182035353a9f0bde374f4eb3d49ab579d81aaf685c15eacd9","36c0bb5788d0d5cd6e18e7568637558d2ea3b011cf5008f47d5b753c30db7b63","873489b90ebe81f0e9e89bb91b1ffe8e08d70d14f5253b9c459675736e765a2f","f79a6f6844a17c018cb7bc8d537cf038fa1371e54718225ba3fab53a1a810bf0","553f8cc3072ae1b6e270230063b828a872a516bc7ae6d1d9302cda8196ecf94b","5db66645fcfe60e8bdc6a61e3f2c5e8a505cf568d8c7c39bee61976699937f3b","ca97ff79ecb38f3366009d497805e5d3126896424d3900f287e2dd62ef7cbd2b","fa2cbb2374ee961c5bc38d7ccfb9f16f69b6f0b2afde25fb08b8e9cc722fd184","0144fa452ab0d05a906b5aa37040ca0d97daa1828bd8f0aed22a64685b0e338d","fc646414e765fc4a85a483388a2c02d30db15bea8de298155022afa3c63da6f8","901e30456fd5d6840c8a9af7659a604e9c037017f860f4cf4e942802404a257d","f0526ddc90b30e163a221149bc983b4bbe638ad0bb588954fd7d7163c2399133","d98ae0b79a598e3fe4cebba22ee5606db8e8e7956b275cfe7f1a01b0c78013e9","69e8f4093baf21d1b4360d4fb2ffea5b3b8e832970ba508edd4873dd45a38f93","8a9bded5e2d5004476e905a61bb6d6bd3ae7e471ed89e16c05c133032028ec71"],"paragraph_range_zero_based":[27792,27815],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p27792"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27816},{"literal_text_all_w_t_and_m_t":"–ShortMAC-I","paragraph_zero_based":27817},{"literal_text_all_w_t_and_m_t":"The IE ShortMAC-I is used to identify and verify the UE at RRC connection re-establishment. The 16 least significant bits of the MAC-I calculated using the AS security configuration of the source PCell, as specified in 5.3.7.4.","paragraph_zero_based":27818},{"literal_text_all_w_t_and_m_t":"ShortMAC-I information element","paragraph_zero_based":27819},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27820},{"literal_text_all_w_t_and_m_t":"-- TAG-SHORTMAC-I-START","paragraph_zero_based":27821},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27822},{"literal_text_all_w_t_and_m_t":"ShortMAC-I ::=                      BIT STRING (SIZE (16))","paragraph_zero_based":27823},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27824},{"literal_text_all_w_t_and_m_t":"-- TAG-SHORTMAC-I-STOP","paragraph_zero_based":27825},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27826},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27827},{"literal_text_all_w_t_and_m_t":"–SINR-Range","paragraph_zero_based":27828},{"literal_text_all_w_t_and_m_t":"The IE SINR-Range specifies the value range used in SINR measurements and thresholds. For measurements, integer value for SINR measurements is according to Table 10.1.16.1-1 in TS 38.133 [14]. For thresholds, the actual value is (IE value – 46) / 2 dB.","paragraph_zero_based":27829},{"literal_text_all_w_t_and_m_t":"SINR-Range information element","paragraph_zero_based":27830},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27831},{"literal_text_all_w_t_and_m_t":"-- TAG-SINR-RANGE-START","paragraph_zero_based":27832},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27833},{"literal_text_all_w_t_and_m_t":"SINR-Range ::=                      INTEGER(0..127)","paragraph_zero_based":27834},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27835},{"literal_text_all_w_t_and_m_t":"-- TAG-SINR-RANGE-STOP","paragraph_zero_based":27836},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27837},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27838},{"literal_text_all_w_t_and_m_t":"–SI-RequestConfig","paragraph_zero_based":27839}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["424e17a97a23bd9193a52f277e7b8825d1b8fa0e1cb0a81c6be82f26e34ea6f1","417c43d59d9c8bbe68e260bcc51ccc0a5ce09463e4a96deda2a21a290efc2c46","1092359e81b1004c9b3b96148e14e0429afbac1ca94efe2f56f7ce28fb2c6eb0","b8d8fce2ba9e922d365cc242ff2e268d84cc13147c023a0ad1d424df6b7ef66d","7588b5ef65541539a28080aeb98c384b8956f268a76c42c77cb395c942b67683","ddc3c603b0fcf7b6c36e6c16ba74eff5faba7a239e9b0a5521010aca0f3535e8","50edaeb183490bcc8946bbf993447be526464c9a5993e325ecb5fe1d7217165d","3b0e1f5af1db2eed1f110627db86d4851bd07f7b4870bb8816020d862a41bb3c","c98181270fded7abdcb71bdf5ef4e33c937620653eb60c9352f364b13330e573","b17cdb8e1576ac6e16dff61eb714d01262410e7d4d8924f14f68f341e666ff3f","6c89698955e517311223372ef7767d2f84d3756425a872060af58ca7f92c524d","31de98b794552e79d5381f2e1170e56369d8e6d67c9727728308834351e8fd52","d8d408bff481779a689578d6f41f20190c73b2f040ab887b71a2e96e996195f6","fb0c8aa1b38cf9744b95e0c9107acc260e0cd6283398ed8c8a5d4a9489f362d2","42ff49a1874cbde56aa6b5a7d66e246c0622326e14c2fbb81a6c938744018f80","a3cc95526a84d008f922f292906912c9e87771bf94f428e35c68e96b968d71b6","b41c107c2a8a6bf8d74c