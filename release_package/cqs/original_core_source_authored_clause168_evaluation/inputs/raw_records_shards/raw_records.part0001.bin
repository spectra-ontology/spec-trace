{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-ADDITIONALSPECTRUMEMISSION-START","paragraph_zero_based":14160},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14161},{"literal_text_all_w_t_and_m_t":"AdditionalSpectrumEmission ::=              INTEGER (0..7)","paragraph_zero_based":14162},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14163},{"literal_text_all_w_t_and_m_t":"AdditionalSpectrumEmission-v1760 ::=        INTEGER (8..39)","paragraph_zero_based":14164},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14165},{"literal_text_all_w_t_and_m_t":"-- TAG-ADDITIONALSPECTRUMEMISSION-STOP","paragraph_zero_based":14166},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":14167},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14168},{"literal_text_all_w_t_and_m_t":"–Alpha","paragraph_zero_based":14169},{"literal_text_all_w_t_and_m_t":"The IE Alpha defines possible values of a the pathloss compensation coefficient for uplink power control. Value alpha0 corresponds to the value 0, Value alpha04 corresponds to the value 0.4, Value alpha05 corresponds to the value 0.5 and so on. Value alpha1 corresponds to value 1. See also clause 7.1 of TS 38.213 [13].","paragraph_zero_based":14170},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":14171},{"literal_text_all_w_t_and_m_t":"-- TAG-ALPHA-START","paragraph_zero_based":14172},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14173},{"literal_text_all_w_t_and_m_t":"Alpha ::=                       ENUMERATED {alpha0, alpha04, alpha05, alpha06, alpha07, alpha08, alpha09, alpha1}","paragraph_zero_based":14174},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14175},{"literal_text_all_w_t_and_m_t":"-- TAG-ALPHA-STOP","paragraph_zero_based":14176},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":14177},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14178},{"literal_text_all_w_t_and_m_t":"–AMF-Identifier","paragraph_zero_based":14179},{"literal_text_all_w_t_and_m_t":"The IE AMF-Identifier (AMFI) comprises of an AMF Region ID, an AMF Set ID and an AMF Pointer as specified in TS 23.003 [21], clause 2.10.1.","paragraph_zero_based":14180},{"literal_text_all_w_t_and_m_t":"AMF-Identifier information element","paragraph_zero_based":14181},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":14182},{"literal_text_all_w_t_and_m_t":"-- TAG-AMF-IDENTIFIER-START","paragraph_zero_based":14183}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["8aea40d1446eef2dcb1f3ed1657505bc49ccc4b5541c67117cb2be9287bf475b","95b596a6c26fe9cb5f4b83b435d9bad493ab850882a4dff09470bd8d3b899b2e","12c316c4e3ea35e2d7dbb9eb527be22f554e3e5d80ea6269d55184832b2d8123","94370e38770d9e14c22d19b600ca1803ddbf76a48eba053a5ce42a4121df4240","d32b8776621df22721da5e092202c08112c7eacbd2d22479d9e9f2bc45f14b6f","2e2c0df2386ed338e88fc1c5282483157eaf2044465a5f2d1f56e8c882eb3d3b","118573c6335161630235e36bfea77686bb7eb5e528749fbb7d7ada52a68fbe44","f16ec7ddd6a3b0010201e9d91537dc5770eaff6b8050ab4228a0ebb972152327","e6b0026d8f006fbd75e1db387fd4f5ac2579cac6f2d4c6ddc242c4ebe96b17ec","0374263e2543ed0a29e5b8dc471b925a4adc7dddbdd10161e97ea79f5175072d","ccacdb5270bbb83aa3d595444d7d62903a488e28b44ff38d21c4d76832002b3d","963b494a39e920d0585779f3a3d63b82aa2f1dcd83063a05e65b67007d713b97","11c605d0680afe4ea1af675ea056cfbd53c8d0f92464a94444230f37928c92ba","c4d4dc49a3053e6af622a4c9595e071664c224acd44893200fdc4a5dc10f0c15","38c402470f4d38c01ed32cc59665b6fa442e224f5f952588