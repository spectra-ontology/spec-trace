{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Initial activation status of cell DTX/DRX indicating whether the UE shall activate the configuration according to the received parameters.","paragraph_zero_based":15192},{"literal_text_all_w_t_and_m_t":"cellDTXDRXconfigType","paragraph_zero_based":15193},{"literal_text_all_w_t_and_m_t":"Indicates whether the configuration is for cell DTX only, cell DRX only, or joint cell DTX/DRX configuration. If set to dtxdrx, the UE shall apply a a joint cell DTX and DRX configuration with the same parameters as in CellDTXDRX-Config. ","paragraph_zero_based":15194},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15195},{"literal_text_all_w_t_and_m_t":"–CellGroupConfig","paragraph_zero_based":15196},{"literal_text_all_w_t_and_m_t":"The CellGroupConfig IE is used to configure a master cell group (MCG) or secondary cell group (SCG). A cell group comprises of one MAC entity, a set of logical channels with associated RLC entities and of a primary cell (SpCell) and one or more secondary cells (SCells).","paragraph_zero_based":15197},{"literal_text_all_w_t_and_m_t":"CellGroupConfig information element","paragraph_zero_based":15198},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":15199},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLGROUPCONFIG-START","paragraph_zero_based":15200},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15201},{"literal_text_all_w_t_and_m_t":"-- Configuration of one Cell-Group:","paragraph_zero_based":15202},{"literal_text_all_w_t_and_m_t":"CellGroupConfig ::=                        SEQUENCE {","paragraph_zero_based":15203},{"literal_text_all_w_t_and_m_t":"    cellGroupId                                CellGroupId,","paragraph_zero_based":15204},{"literal_text_all_w_t_and_m_t":"    rlc-BearerToAddModList                     SEQUENCE (SIZE(1..maxLC-ID)) OF RLC-BearerConfig                        OPTIONAL,   -- Need N","paragraph_zero_based":15205},{"literal_text_all_w_t_and_m_t":"    rlc-BearerToReleaseList                    SEQUENCE (SIZE(1..maxLC-ID)) OF LogicalChannelIdentity                  OPTIONAL,   -- Need N","paragraph_zero_based":15206},{"literal_text_all_w_t_and_m_t":"    mac-CellGroupConfig                        MAC-CellGroupConfig                                                     OPTIONAL,   -- Need M","paragraph_zero_based":15207},{"literal_text_all_w_t_and_m_t":"    physicalCellGroupConfig                    PhysicalCellGroupConfig                                                 OPTIONAL,   -- Need M","paragraph_zero_based":15208},{"literal_text_all_w_t_and_m_t":"    spCellConfig                               SpCellConfig                                                            OPTIONAL,   -- Need M","paragraph_zero_based":15209},{"literal_text_all_w_t_and_m_t":"    sCellToAddModList                          SEQUENCE (SIZE (1..maxNrofSCells)) OF SCellConfig                       OPTIONAL,   -- Need N","paragraph_zero_based":15210},{"literal_text_all_w_t_and_m_t":"    sCellToReleaseList                         SEQUENCE (SIZE (1..maxNrofSCells)) OF SCellIndex                        OPTIONAL,   -- Need N","paragraph_zero_based":15211},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":15212},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":15213},{"literal_text_all_w_t_and_m_t":"    reportUplinkTxDirectCurrent                ENUMERATED {true}                                                   OPTIONAL    -- Cond BWP-Reconfig","paragraph_zero_based":15214},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":15215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca6644