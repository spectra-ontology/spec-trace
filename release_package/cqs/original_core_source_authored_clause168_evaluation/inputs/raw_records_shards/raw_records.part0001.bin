ph_zero_based":21714},{"literal_text_all_w_t_and_m_t":"The IE NSAG-ID is used to identify an NSAG (TS 23.501 [32]) for slice-based cell reselection or slice-based random access.","paragraph_zero_based":21715},{"literal_text_all_w_t_and_m_t":"NSAG-ID information element","paragraph_zero_based":21716},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21717},{"literal_text_all_w_t_and_m_t":"-- TAG-NSAG-ID-START","paragraph_zero_based":21718},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21719}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["c9c406fe6eab4c7d582478d581a7849bc618a784591a1f932f8cd0c73f3ac398","38323ce9fe1c5908b965b489102951f31aa069c4a21154fdf6b2ab618051e86c","8116376613f8943fbb4b347ce608eda689e138e6ef2df9f5584c6cd3b798c672","eaca2b8b9601e0458a2027ff7348208c007b17ba4f9abac74bf26b5ad7284617","4032d1c0e1599bc2924ac32de969f8a85fee0ab69860b3639ddbaf097427ed6e","304635911f11ee4cb2ceb3b25ee28e06a687b08fdb1d00e8b7c2631e185de22d","8b6fa59ad7812b3eaf450832eff0f983ab7d7ad28c35d25e6ab6116f8a6c8184","d3bd2a6189f39e2e91a46aed997b1bb4553c10bd3d6c267ed53ec07d56676607","b980ac4031143c678a92daf71ac63c022c0859ab00acbe0a48133fb25568c51a","fdb5c1b23077d03def5203e98bee0f42e2808ade416a6c2dbcdb10ce422ebece","cc7ba8b8e5b45afe57d7b8d5516332f578608de004996e49cb80d6b06e97e911","0f5b6d386ca9e209563459e038b07e578b0b6ad1ae1c9ee339491199dcba883d","5780db7d45dced7ee33d79dfb82a382b58496c2cf057e028a477eaa746457d43","0918b98afac54a055b5d4291613c1eddafecc59841be92d31e2b57a69628a0c5","63bf169fe8037ac315d0d357995615f40367a6a26611560741f3d4e6a69f4429","f40fb50038297390c6c57b62b0f5568981f029112c78df39ab260e93124aeca2","830703b18ab22f0626ecdea4d816ba2daffcfa3de66082