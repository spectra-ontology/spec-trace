{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":26568},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26569},{"literal_text_all_w_t_and_m_t":"-- TAG-REPORTCONFIGTOADDMODLIST-STOP","paragraph_zero_based":26570},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26571},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26572},{"literal_text_all_w_t_and_m_t":"–ReportInterval","paragraph_zero_based":26573},{"literal_text_all_w_t_and_m_t":"The IE ReportInterval indicates the interval between periodical reports. The ReportInterval is applicable if the UE performs periodical reporting (i.e. when reportAmount exceeds 1) when reportType is set to either eventTriggered, periodical, cli-EventTriggered or cli-Periodical. Value ms120 corresponds to 120 ms, value ms240 corresponds to 240 ms and so on, while value min1 corresponds to 1 min, min6 corresponds to 6 min and so on.","paragraph_zero_based":26574},{"literal_text_all_w_t_and_m_t":"ReportInterval information element","paragraph_zero_based":26575},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26576},{"literal_text_all_w_t_and_m_t":"-- TAG-REPORTINTERVAL-START","paragraph_zero_based":26577},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26578},{"literal_text_all_w_t_and_m_t":"ReportInterval ::=                  ENUMERATED {ms120, ms240, ms480, ms640, ms1024, ms2048, ms5120, ms10240, ms20480, ms40960,","paragraph_zero_based":26579},{"literal_text_all_w_t_and_m_t":"                                                    min1,min6, min12, min30 }","paragraph_zero_based":26580},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26581},{"literal_text_all_w_t_and_m_t":"-- TAG-REPORTINTERVAL-STOP","paragraph_zero_based":26582},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26583},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26584},{"literal_text_all_w_t_and_m_t":"–ReselectionThreshold","paragraph_zero_based":26585},{"literal_text_all_w_t_and_m_t":"The IE ReselectionThreshold is used to indicate an Rx level threshold for cell reselection. Actual value of threshold = field value * 2 [dB].","paragraph_zero_based":26586},{"literal_text_all_w_t_and_m_t":"ReselectionThreshold information element","paragraph_zero_based":26587},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26588},{"literal_text_all_w_t_and_m_t":"-- TAG-RESELECTIONTHRESHOLD-START","paragraph_zero_based":26589},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26590},{"literal_text_all_w_t_and_m_t":"ReselectionThreshold ::=                INTEGER (0..31)","paragraph_zero_based":26591}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["67bcad0452a61ddf36410821d61d38d7eaff1fcebf3d8acdbaee9791499be3a5","949d5e24dfbf4f2a6cc24c5aafe90be04a4d63aa42b2ffcbd6eefff0dadb50ff","ee644f929d870f019efc9455ac85ebe49f67960d09c03baa32a19d8e761c7fed","bddb4a98147a4a889b9c0982a449b0a6fad8e8cc7e6b63368d47bee00cbde05a","2aab59425228942aa4f59821355fdde034fca39a4c2c53b7783889fd4777ec43","98eeff108ebd3f83aef587df9b2061bf54c1cd6e4de6a75f405e796d82e25ccf","6248fd04e0f5bf5c72f3db829bd4f00c94733e343abe73d8c28b85487033a125","9df0c458a05f13044470dd1ca39220900d96291f149846d6e280ccd38d04955d","4e558e5f4ea2e6a2dddc7c5acf096edfaf1e512ed732f4cede0f260661ebdc2a","e7c2118fa1b8e986efaeb8e2035ce75b004c8e4a7fb4e3e54969a16d63824fd6","1049bcffb581b3621373961c23d58c938039e98e21970a70c8a6cdd6eea1a66b","da25e170bfefaed71ab56623433b3703ab38d3aed46468dc59efb4e5ac018c7f","1032e8d1