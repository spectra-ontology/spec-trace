{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":40536},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40537},{"literal_text_all_w_t_and_m_t":"–End of NR-RRC-Definitions","paragraph_zero_based":40538},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":40539},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40540},{"literal_text_all_w_t_and_m_t":"END","paragraph_zero_based":40541},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40542},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":40543},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40544},{"literal_text_all_w_t_and_m_t":"6.5Short Message","paragraph_zero_based":40545},{"literal_text_all_w_t_and_m_t":"Short Messages can be transmitted on PDCCH using P-RNTI with or without associated Paging message using Short Message field in DCI format 1_0 (see TS 38.212 [17], clause 7.3.1.2.1).","paragraph_zero_based":40546},{"literal_text_all_w_t_and_m_t":"Table 6.5-1 defines Short Messages. Bit 1 is the most significant bit.","paragraph_zero_based":40547},{"literal_text_all_w_t_and_m_t":"Table 6.5-1: Short Messages","paragraph_zero_based":40548},{"literal_text_all_w_t_and_m_t":"Bit","paragraph_zero_based":40549},{"literal_text_all_w_t_and_m_t":"Short Message","paragraph_zero_based":40550},{"literal_text_all_w_t_and_m_t":"1","paragraph_zero_based":40551},{"literal_text_all_w_t_and_m_t":"systemInfoModification","paragraph_zero_based":40552},{"literal_text_all_w_t_and_m_t":"If set to 1: indication of a BCCH modification other than SIB6, SIB7, SIB8 and posSIBs.","paragraph_zero_based":40553},{"literal_text_all_w_t_and_m_t":"2","paragraph_zero_based":40554},{"literal_text_all_w_t_and_m_t":"etwsAndCmasIndication","paragraph_zero_based":40555},{"literal_text_all_w_t_and_m_t":"If set to 1: indication of an ETWS primary notification and/or an ETWS secondary notification and/or a CMAS notification.","paragraph_zero_based":40556},{"literal_text_all_w_t_and_m_t":"3","paragraph_zero_based":40557},{"literal_text_all_w_t_and_m_t":"stopPagingMonitoring","paragraph_zero_based":40558},{"literal_text_all_w_t_and_m_t":"This bit can be used for only operation with shared spectrum channel access and if nrofPDCCH-MonitoringOccasionPerSSB-InPO is present.","paragraph_zero_based":40559}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["bbe3fa490b257a202a24be13e16c28294ba7471891197116c8c13ef3174b52a7","9f91816ef3ce64129568436fb909be694ab21e76949b1ab34d6399a75e0ee7d6","b8798f3535301ccff6c487205e41da4644a161d35136eb114a5a3c489ff21500","78305a03408f4db0d14b810e2b751674908ca99d5d973a78e9b45f6b2e31d714","85e5caec477538b4d538d8c491584d41d008d3b54c9bdf887d49de2e219f27f4","33b78f4eb2d7cbecff309dfb1022b9a4d3700c8f332d445b52b14d735a513468","565bbb0c2f3395cddee6ab983a71e94cd70cd5f8bac6eec1e2209897c1df8fc4","77c64285577a250f042e203d678a0bbd2fce783b3a91d72df3aec056c5c6a842","d4f2148c8dbc5fef2696b59d26e2939f36a60b114a31603155db65f2591e06f8","4e69fc7ecf43d38373544c4eb3727b8227303b75e8f1d873140eaba201f84b7a","69091f6e6b2da7c63513093e37fe212c517738ce628393c69c006d6fe7652940","f01236be84e46653405ca946596ec8f82911407a12ae41790ff94c29fde96208","de41d3ed81c248573e5285eacee1fc201b6b235ad7c47eb2e1adc326ba798d28","ac0405cab05f15a101b2744ebeb225143eb5c70910b4a76623e6a7dfd50bad08","6c71b79e316dea7f11deaa4fb8d555a42b949b28299d0016a4d372844c28be3a","f0bc67c20002df20825574d729e32526a61adad5dd19f1a8e59fb09aca5870e2","2536966b629ce539c15b0cec80871b8f45c60c996aeec27c1d752c5b08000f04","e3b4c