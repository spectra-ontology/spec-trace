{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":38184},{"literal_text_all_w_t_and_m_t":"V2X-SL-Shared","paragraph_zero_based":38185},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if the carrier frequency configured for NR sidelink communication is shared by V2X sidelink communication. It is absent, Need R, otherwise.","paragraph_zero_based":38186},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38187},{"literal_text_all_w_t_and_m_t":"–SL-FreqConfigCommon","paragraph_zero_based":38188},{"literal_text_all_w_t_and_m_t":"The IE SL-FreqConfigCommon specifies the cell-specific configuration information on one particular carrier frequency for NR sidelink communication.","paragraph_zero_based":38189},{"literal_text_all_w_t_and_m_t":"SL-FreqConfigCommon information element","paragraph_zero_based":38190},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":38191},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-FREQCONFIGCOMMON-START","paragraph_zero_based":38192},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38193},{"literal_text_all_w_t_and_m_t":"SL-FreqConfigCommon-r16 ::=      SEQUENCE {","paragraph_zero_based":38194},{"literal_text_all_w_t_and_m_t":"    sl-SCS-SpecificCarrierList-r16   SEQUENCE (SIZE (1..maxSCSs)) OF SCS-SpecificCarrier,","paragraph_zero_based":38195},{"literal_text_all_w_t_and_m_t":"    sl-AbsoluteFrequencyPointA-r16   ARFCN-ValueNR,","paragraph_zero_based":38196},{"literal_text_all_w_t_and_m_t":"    sl-AbsoluteFrequencySSB-r16      ARFCN-ValueNR                                                       OPTIONAL, -- Need R","paragraph_zero_based":38197},{"literal_text_all_w_t_and_m_t":"    frequencyShift7p5khzSL-r16       ENUMERATED {true}                                                   OPTIONAL, -- Cond V2X-SL-Shared","paragraph_zero_based":38198},{"literal_text_all_w_t_and_m_t":"    valueN-r16                       INTEGER (-1..1),","paragraph_zero_based":38199},{"literal_text_all_w_t_and_m_t":"    sl-BWP-List-r16                  SEQUENCE (SIZE (1..maxNrofSL-BWPs-r16)) OF SL-BWP-ConfigCommon-r16  OPTIONAL, -- Need R","paragraph_zero_based":38200},{"literal_text_all_w_t_and_m_t":"    sl-SyncPriority-r16              ENUMERATED {gnss, gnbEnb}                                           OPTIONAL, -- Need R","paragraph_zero_based":38201},{"literal_text_all_w_t_and_m_t":"    sl-NbAsSync-r16                  BOOLEAN                                                             OPTIONAL, -- Need R","paragraph_zero_based":38202},{"literal_text_all_w_t_and_m_t":"    sl-SyncConfigList-r16            SL-SyncConfigList-r16                                               OPTIONAL, -- Need R","paragraph_zero_based":38203},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":38204},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":38205},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-FREQCONFIGCOMMON-STOP","paragraph_zero_based":38206},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":38207}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["1692130c8e5a9f3bd6fe4700e6a2784238b5e0e48d670d1fcd6d618b6798b682","d1d85b4057107292e72e22cbb99139ea6ea8817d3d4127fa2146e09a4bc54c42","0feb6ff182660ba7ad799c42be1e49fc706a47c766f575576bd849c86eb2a473","d7d8476c4e81b71e1fa1b9e2956fa3013b5a58a0b4a72a38d4663e3a711959a3","7c266c643162ead17c98525d9927790a54eeceb4c2f8dc356fdfdcf8e8dc9e27","8d2194fdbae73da4af31dfa7fced3205c0f721cf9028bdedec006f589e181c6d","b79f390407ea7ddae8103e83347383286cc4