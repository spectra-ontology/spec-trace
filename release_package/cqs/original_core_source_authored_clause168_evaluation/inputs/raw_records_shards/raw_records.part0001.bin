{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":35664},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":35665},{"literal_text_all_w_t_and_m_t":"    fallbackGroupFiveRequest-r17   ENUMERATED {true}                                    OPTIONAL     -- Need N","paragraph_zero_based":35666},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":35667},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":35668},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35669},{"literal_text_all_w_t_and_m_t":"CellGrouping-r16 ::=    SEQUENCE {","paragraph_zero_based":35670},{"literal_text_all_w_t_and_m_t":"    mcg-r16                 SEQUENCE (SIZE (1..maxBands)) OF FreqBandIndicatorNR,","paragraph_zero_based":35671},{"literal_text_all_w_t_and_m_t":"    scg-r16                 SEQUENCE (SIZE (1..maxBands)) OF FreqBandIndicatorNR,","paragraph_zero_based":35672},{"literal_text_all_w_t_and_m_t":"    mode-r16                ENUMERATED {sync, async}","paragraph_zero_based":35673},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":35674},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35675},{"literal_text_all_w_t_and_m_t":"-- TAG-UE-CAPABILITYREQUESTFILTERCOMMON-STOP","paragraph_zero_based":35676},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":35677},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35678},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRequestFilterCommon field descriptions","paragraph_zero_based":35679},{"literal_text_all_w_t_and_m_t":"codebookTypeRequest","paragraph_zero_based":35680},{"literal_text_all_w_t_and_m_t":"Only if this field is present, the UE includes SupportedCSI-RS-Resource supported for the codebook type(s) requested within this field (i.e. type I single/multi-panel, type II and type II port selection) into codebookVariantsList, codebookParametersPerBand and codebookParametersPerBC. If this field is present and none of the codebook types is requested within this field (i.e. empty field), the UE includes SupportedCSI-RS-Resource supported for all codebook types into codebookVariantsList, codebookParametersPerBand and codebookParametersPerBC.","paragraph_zero_based":35681},{"literal_text_all_w_t_and_m_t":"fallbackGroupFiveRequest","paragraph_zero_based":35682},{"literal_text_all_w_t_and_m_t":"Only if this field is present, the UE supporting FR2 CA bandwidth class from fallback group 5 shall include band combinations with FR2 CA bandwidth class from fallback group 5, and shall omit band combinations with FR2 CA bandwidth class from fallback group 2 or 3 (see TS 38.101-2 [39]) with same or lower capabilities.","paragraph_zero_based":35683},{"literal_text_all_w_t_and_m_t":"includeNE-DC","paragraph_zero_based":35684},{"literal_text_all_w_t_and_m_t":"Only if this field is present, the UE supporting NE-DC shall indicate support for NE-DC in band combinations and include feature set combinations which are applicable to NE-DC. Band combinations supporting both NE-DC and (NG)EN-DC shall be included in supportedBandCombinationList, band combinations supporting only NE-DC shall be included in supportedBandCombinationListNEDC-Only.","paragraph_zero_based":35685},{"literal_text_all_w_t_and_m_t":"includeNR-DC","paragraph_zero_based":35686},{"literal_text_all_w_t_and_m_t":"Only if this field is present, the UE supporting NR-DC shall indicate support for NR-DC in band combinations and include feature set combinations which are applicable to NR-DC.","paragraph_zero_based":35687}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["3482e6ce8f1bf8bfc39a91aceda42388ca7d37028eb063523bd263f2a28914ad","f3275580c58aef38d93a094f4e4811a95a38cd7d8afcb6da65af5ec63479c4c9","3369b0ec6b3e4a1438c6e817c01f2a4acbf7a2a20274501a13704d74d395ad50","e7288b6fc9b6fce20c0a4ebb4c30f4ebd091fee160343f0c94c641127f9cd0dc","f060467fd7dcca42f806584695aaf4cf2e2b3921bd2ae0ba35a098b9d3500863","1ebf3815880bb8ce708f800a1e5c4e636fd44c47f9312383d4ab0b3c43785113","2e2e6c969ddebdc6d811477288629605194b9a76e037a8700bf07a0a7bb1cd37","1e6ee7172a93bf015a791c7e9230c2db1c9c09183c9edd0f47d0adfed012ed93","f8a3c8cf5d9c778c9b24d303750c0902ec3c1f58046660c379c5913f92161e4f","a3b846f3e26d8f9f0d44c1aa2d1a66792f4097aa7bc5c3e91f391d4961d2d682","60d16641be6ed68fd4652c75b5ce1cd490326a8ebf7c5ff67b46c47651e9f3bc","5505ba9b953363209132976345eea9862896614edeb7fa514357af4ebc537e0a","cbee0f0c7b2aa4cebf9d6baff36088de4eac46d2c84fb9bfdf387297ca3931da","7aa540fb22461d12bd3920e80865ea4f9691c507b26e4a86da6634e921f17df6","759711acfc97586303e8611d7620ce735b51d18e6b114310d610b9e7a6414f04","fded81c475b64bbb7ca2aa479a015f84ea61d0921f8f95ed252ffbae64b6ac5b","870598b3fc492df318eb31423af6085924d99c9c92f8501638e4a5f27cc9e6aa","254cd94a204ecfb6333fd33729a41c5e72b64e765b80900e219e3fc814bb3436","bbf4350e55549e9aa54d8f3af19a605a43df03d1d1d3cb7699290ea74d466a17","05dfe484154daa3b216770c1c0c76e38cc92885b29d11221fe429c121d1d3f61","665ac116728c0eba6924b6f0e4a661d1ce1b4b825987e07a6535e50aea532503","2d417520012a7675c599a99c06a33fda7000c270c7cc693a4fdce0b20b4ae8cd","27d7c1274578d9d8f8a669316e59e6c0d2228c939315699b1642c9804941984f","5c3587a2686405a37dbaf5b85fad6a0d3bb521736f6a39bc21e8f683beba1700"],"paragraph_range_zero_based":[35664,35687],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p35664"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"mode","paragraph_zero_based":35688},{"literal_text_all_w_t_and_m_t":"The mode of NR-DC operation that the NW is interested in for this cell grouping. The value sync means that the UE only indicates NR-DC support for band combinations for which it supports synchronous NR-DC with the requested cell grouping. The value async means that the UE only indicates NR-DC support for band combinations for which it supports asynchronous NR-DC with the requested cell grouping.","paragraph_zero_based":35689},{"literal_text_all_w_t_and_m_t":"omitEN-DC","paragraph_zero_based":35690},{"literal_text_all_w_t_and_m_t":"Only if this field is present, the UE shall omit band combinations and feature set combinations which are only applicable to (NG)EN-DC.","paragraph_zero_based":35691},{"literal_text_all_w_t_and_m_t":"requestedCellGrouping","paragraph_zero_based":35692},{"literal_text_all_w_t_and_m_t":"The NR-DC cell groupings that the NW is interested in, i.e., the bands that it might use in an MCG and the bands that it might use in an SCG. Only if this field is present, the UE indicates NR-DC support for band combinations for which it supports the requested cell grouping, i.e., in which it supports at least one of the mcg bands on MCG and at least one of the scg bands on the SCG. In its supportedBandCombinationList, the UE indicates which of its NR-DC band combinations supports which of the requested cell groupings. The first element in this list is referred to by ID#0, the second by ID#1 and so on. If this field is absent, the UE only includes band combinations for which it supports NR-DC with only FR1 bands in MCG and only FR2 bands in SCG.","paragraph_zero_based":35693},{"literal_text_all_w_t_and_m_t":"Example 1: requestedCellGrouping is set to mcg=[n1, n7, n41, n66] and scg=[n78, n261]. This assumes that the NW would always use CA among n1, n7, n41 and n66 (depending on which are deployed on a given site) whereas with n78 and/or n261 the NW may need to use DC. With this filter a UE may report a band combination n1A-n7A-n78A for NR-DC only if it supports that serving cells for n1 and n7 are in the MCG and a serving cell for n78 is in the SCG. The UE may also report a band combination n41C-n261M for NR-DC provided that it supports a serving cell for n41 in the MCG and a serving cell for n261 in the SCG.","paragraph_zero_based":35694},{"literal_text_all_w_t_and_m_t":"Example 2: One requestedCellGrouping is set to mcg=[n1, n7, n41, n66] and scg=[n78, n261] and another requestedCellGrouping is set to mcg=[n1, n7, n66] and scg=[ n41, n78, n261]. This assumes that the NW uses sometimes CA among n1, n7, n41 and n66 (as in example 1) and sometimes CA among n1, n7 and n66 but DC towards one or several of n41, n78, n261. If a UE supports n1A-n41A-n78A only if n41A and n78A are in the same cell group, this UE may only indicate cell grouping ID#1 (not #0) in its BC.","paragraph_zero_based":35695},{"literal_text_all_w_t_and_m_t":"uplinkTxSwitchRequest","paragraph_zero_based":35696},{"literal_text_all_w_t_and_m_t":"Only if this field is present, the UE supporting dynamic UL Tx switching shall indicate support for UL Tx switching in band combinations which are applicable to inter-band UL CA, SUL and (NG)EN-DC.","paragraph_zero_based":35697},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35698},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":35699},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":35700},{"literal_text_all_w_t_and_m_t":"NRDC","paragraph_zero_based":35701},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need N, if includeNR-DC is included. It is absent otherwise.","paragraph_zero_based":35702},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35703},{"literal_text_all_w_t_and_m_t":"–UE-CapabilityRequestFilterNR","paragraph_zero_based":35704},{"literal_text_all_w_t_and_m_t":"The IE UE-CapabilityRequestFilterNR is used to request filtered UE capabilities.","paragraph_zero_based":35705},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRequestFilterNR information element","paragraph_zero_based":35706},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":35707},{"literal_text_all_w_t_and_m_t":"-- TAG-UE-CAPABILITYREQUESTFILTERNR-START","paragraph_zero_based":35708},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35709},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRequestFilterNR ::=            SEQUENCE {","paragraph_zero_based":35710},{"literal_text_all_w_t_and_m_t":"    frequencyBandListFilter                     FreqBandList                          OPTIONAL,   -- Need N","paragraph_zero_based":35711}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["3723df25bc4b3af0045952d159306ac531be077b08b47d93b55abdd0ecce6c08","c8fa2df7cc90b66eb10904c18b53b09fba572cedb1a77dc42ef4c37b9502ab23","924854df9722c45990a0eb1a837bae52d9ae6c11a17002119373e86083023fe6","7612f5d3ea07474180eb9e46a1791ed56af41a6c8255f02cd6fb0328d6a227a3","a36713c39d00bf90b46a28ac1c1a3579d4b774886d9a74808e7bb2a614bbdb64","8dbf8554e52bce0bed50415ee4e8212d0c07216fe68c6a09f11a4dee54df0cff","42a091d91d747cf0dd4f9ca9bdee5424afd9d3386d8ae2087848558f597a8dd6","8b944803dd8e745eb9ce34ff6c02b9ccb7d5a296c09fceefca31d87d8096399a","13207ce1c12f83f7ae30ebe188737b3e837b8d339dd9aa0f77588f1393c7bd17","0d4ef92d6d5578d94b5c43127251cac2569d165a71362e31ea45a16d04515753","54e4d3a740d4a75cd204f0f7f68ae58e8a49098410dc52bf5bbc332a418f5196","8a21ceddb0777efb7b11a1ea4c318