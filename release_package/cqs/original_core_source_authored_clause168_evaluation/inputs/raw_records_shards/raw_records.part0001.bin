{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SharedSpectrum2","paragraph_zero_based":13368},{"literal_text_all_w_t_and_m_t":"The field is optional present, Need R, if this intra-frequency or neighbor cell operates with shared spectrum channel access. Otherwise, it is absent, Need R.","paragraph_zero_based":13369},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13370},{"literal_text_all_w_t_and_m_t":"–SIB4","paragraph_zero_based":13371},{"literal_text_all_w_t_and_m_t":"SIB4 contains information relevant for inter-frequency cell re-selection (i.e. information about other NR frequencies and inter-frequency neighbouring cells relevant for cell re-selection), which can also be used for NR idle/inactive measurements. The IE includes cell re-selection parameters common for a frequency as well as cell specific re-selection parameters.","paragraph_zero_based":13372},{"literal_text_all_w_t_and_m_t":"SIB4 information element","paragraph_zero_based":13373},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":13374},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB4-START","paragraph_zero_based":13375},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13376},{"literal_text_all_w_t_and_m_t":"SIB4 ::=                            SEQUENCE {","paragraph_zero_based":13377},{"literal_text_all_w_t_and_m_t":"    interFreqCarrierFreqList            InterFreqCarrierFreqList,","paragraph_zero_based":13378},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension            OCTET STRING                                OPTIONAL,","paragraph_zero_based":13379},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":13380},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":13381},{"literal_text_all_w_t_and_m_t":"    interFreqCarrierFreqList-v1610      InterFreqCarrierFreqList-v1610              OPTIONAL   -- Need R","paragraph_zero_based":13382},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":13383},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":13384},{"literal_text_all_w_t_and_m_t":"    interFreqCarrierFreqList-v1700      InterFreqCarrierFreqList-v1700              OPTIONAL   -- Need R","paragraph_zero_based":13385},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":13386},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":13387},{"literal_text_all_w_t_and_m_t":"    interFreqCarrierFreqList-v1720      InterFreqCarrierFreqList-v1720              OPTIONAL   -- Need R","paragraph_zero_based":13388},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":13389},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":13390},{"literal_text_all_w_t_and_m_t":"    interFreqCarrierFreqList-v1730      InterFreqCarrierFreqList-v1730              OPTIONAL   -- Need R","paragraph_zero_based":13391}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["e1a251efd3e92a1e7bcd22db831562a061c16ffd61787c2efc32d541a5d47b7a","b927ffb6ac9ca25bf1db83dfe5d27320ce00ed600be05950910aefe6a1310a69","8ac3159f83040daaa68eca03a7c995445d169cd92fc5de419d0a62c617f5fde1","84b346d8c250e04ce6972178ee58fae752421dc0c41b4c8214762b2716f20472","c2b8b74e35d1a5966bf706319e0723002606100cf116fa3c088735c67676d3e0","1a8dbc66fb35da484632d6d5bd92dd62122320c7cad4d9884a879026a4dc8e1b","c39b7b698837a36dfee54169d94e3ea29da5e13854e628cf04be1f7f9efe2a65","387f1195d3f0def4b212c29b63e40305d7e5f006971e0bb64810a628908f2f5a","d5e6f95a2897c4d5d5da4d8cade2f265bf52b59a8811e7fce63761cdd0663765","76ae24940cc79383a61a8443af2604914caefd0d9141dfd0e6bc4