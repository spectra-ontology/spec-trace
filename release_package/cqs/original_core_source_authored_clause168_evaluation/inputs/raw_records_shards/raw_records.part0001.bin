                      OPTIONAL,   -- Need M","paragraph_zero_based":19138},{"literal_text_all_w_t_and_m_t":"    measGapSharingConfig                MeasGapSharingConfig                                                OPTIONAL,   -- Need M","paragraph_zero_based":19139},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":19140},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":19141},{"literal_text_all_w_t_and_m_t":"    interFrequencyConfig-NoGap-r16      ENUMERATED {true}                                                   OPTIONAL    -- Need R","paragraph_zero_based":19142},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":19143},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":19144},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19145},{"literal_text_all_w_t_and_m_t":"MeasObjectToRemoveList ::=              SEQUENCE (SIZE (1..maxNrofObjectId)) OF MeasObjectId","paragraph_zero_based":19146},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19147},{"literal_text_all_w_t_and_m_t":"MeasIdToRemoveList ::=                  SEQUENCE (SIZE (1..maxNrofMeasId)) OF MeasId","paragraph_zero_based":19148},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19149},{"literal_text_all_w_t_and_m_t":"ReportConfigToRemoveList ::=            SEQUENCE (SIZE (1..maxReportConfigId)) OF ReportConfigId","paragraph_zero_based":19150},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19151}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["428b03c7596b8dfa87a9d50b31d90f79227da46d78882ea2a7349a2178e28a51","00cf16a49883318d19d37040cc288e3f6c031ccd8671ce155f7e16ffeb3ed8f3","6900f4066c1248658977fb31b9228c931d6fcb501772636a8af7d9231c533946","49f50b7a9e4a5f374bce35da96987c6c0506701aeb0b40aed02f99cbc1cd207d","c7c100bea977b87eb4f102e129f3af9d146c5d8e1c6e6e491164d0362a06f6b7","294c98e7c576146f13d7cacf49440484219e375bf8940b49eac536521d01c13e","dec146274f8d459f5bff0dd926f19132c19a6d0f6af34e4ffe9ce159e38fe282","90b57c05e7669ad02f2b915590700f8323baee27ef7a0a85d9e28d205fad68c7","37d53e9b2d202d6e4c4f68649dccf8efe56018648a3eeff015f541098fa8aaba","44cce1fd0bd871db69479d3bfd355c2435c17a3f98165ae8e828dda8b84f3e2e","e2ffac58b164bb69a9348463f7824ed48947664d74f7188630209934fb933610","2015e12db801f81061d2435c74366db0185216e8c1dd4025a2bb936b09dc1131","eda01155d15b4ecfe2a96deb7a5d547a07c31cf00c424f635d59255287d354b0","c8dfaa6d6ee4289e9035ec68859d4b119a424121fe20117d537d2d21be85cd64","16e06d0aeaa2b93a2a9c781394d8fe903e4ec5119ea612ba54eeb9a123c14af0","59d717045ff20cd3c52ce5bd0890f98192ad8a2568fc475999e860277a9114cd","f53ed45deb3813aa7df47483572e7a36bb7ac6eb53a5a6d79d6970d2334c9162","4a5310627973b9a644bba4d401740d84e5e29c7f10a6bcc891a871aea1fdaade","69e0d1d18e7b2b460d2ac696e03ab17d345fd0e5aa8140f767d17d5c69ff3708","46ec55a3577c04c234e137b3aa1d2ec102c1ea64f036a105eb78880e3a040c6f","494418c7c90a00a7f57278300c0f435c986806c58cbb6933d9d169dbe584c27a","6b0f2a5ae2e1c49191e0eb815de6df8bca979aa35f8be4f6d337e3e6c0478911","cb358c10ae1b44c573816ed2ea62888d54cbe87809649e0ce824e84ed1cec46a","e80e9fc84be4e23edea56bc383da45f25d42952f4f1f88483fba636629911733"],"paragraph_range_zero_based":[19128,19151],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p19128"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-MEASCONFIG-STOP","paragraph_zero_based":19152},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":19153},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19154},{"literal_text_all_w_t_and_m_t":"MeasConfig field descriptions","paragraph_zero_based":19155},{"literal_text_all_w_t_and_m_t":"interFrequencyConfig-NoGap-r16","paragraph_zero_based":19156},{"literal_text_all_w_t_and_m_t":"If the field is set to true, UE is configured to perform SSB based inter-frequency measurement without measurement gaps when the inter-frequency SSB is completely contained in the active DL BWP of the UE, as specified in TS 38.133 [14], clause 9.3. Otherwise, the SSB based inter-frequency measurement is performed within measurement gaps. In NR-DC, the field can only be configured in the measConfig associated with MCG, and when configured, it applies to all the inter-frequency measurements configured by MN and SN.","paragraph_zero_based":19157},{"literal_text_all_w_t_and_m_t":"measGapConfig","paragraph_zero_based":19158},{"literal_text_all_w_t_and_m_t":"Used to setup and release measurement gaps in NR.","paragraph_zero_based":19159},{"literal_text_all_w_t_and_m_t":"measIdToAddModList","paragraph_zero_based":19160},{"literal_text_all_w_t_and_m_t":"List of measurement identities to add and/or modify.","paragraph_zero_based":19161},{"literal_text_all_w_t_and_m_t":"measIdToRemoveList","paragraph_zero_based":19162},{"literal_text_all_w_t_and_m_t":"List of measurement identities to remove.","paragraph_zero_based":19163},{"literal_text_all_w_t_and_m_t":"measObjectToAddModList","paragraph_zero_based":19164},{"literal_text_all_w_t_and_m_t":"List of measurement objects to add and/or modify.","paragraph_zero_based":19165},{"literal_text_all_w_t_and_m_t":"measObjectToRemoveList","paragraph_zero_based":19166},{"literal_text_all_w_t_and_m_t":"List of measurement objects to remove.","paragraph_zero_based":19167},{"literal_text_all_w_t_and_m_t":"reportConfigToAddModList","paragraph_zero_based":19168},{"literal_text_all_w_t_and_m_t":"List of measurement reporting configurations to add and/or modify.","paragraph_zero_based":19169},{"literal_text_all_w_t_and_m_t":"reportConfigToRemoveList","paragraph_zero_based":19170},{"literal_text_all_w_t_and_m_t":"List of measurement reporting configurations to remove.","paragraph_zero_based":19171},{"literal_text_all_w_t_and_m_t":"s-MeasureConfig","paragraph_zero_based":19172},{"literal_text_all_w_t_and_m_t":"Threshold for NR SpCell RSRP measurement controlling when the UE is required to perform measurements on non-serving cells. Choice of ssb-RSRP corresponds to cell RSRP based on SS/PBCH block and choice of csi-RSRP corresponds to cell RSRP of CSI-RS. ","paragraph_zero_based":19173},{"literal_text_all_w_t_and_m_t":"measGapSharingConfig","paragraph_zero_based":19174},{"literal_text_all_w_t_and_m_t":"Specifies the measurement gap sharing scheme and controls setup/ release of measurement gap sharing.","paragraph_zero_based":19175}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["a85717a49737ca3a05248224dc107d7788b7e422b0ae32d37e6cb8c462977340","df383de606eaeaacfc00a7fe5459f12b89333b400ded711d363233e138c612b4","d2842022a691c50107549d58c07a9dbb9ad336dad1f7594d0a295cd84024f1bc","edeffdf2c68bc7076e61a1dca08c8846d5bed9f473d677107fca00065329d102","fc72f4d990c77649cb224e7e6d3487c9d43ff424629f837fe4aa95784027febf","6d1fa44c6d59dd50a31ed981683ce56593c6d119085a6e3ea1fd8655da72606e","449c2b26e9cdcf11cb0d5d303d45