{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27216},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27217},{"literal_text_all_w_t_and_m_t":"–ServingCellConfig","paragraph_zero_based":27218},{"literal_text_all_w_t_and_m_t":"The IE ServingCellConfig is used to configure (add or modify) the UE with a serving cell, which may be the SpCell or an SCell of an MCG or SCG. The parameters herein are mostly UE specific but partly also cell specific (e.g. in additionally configured bandwidth parts). Reconfiguration between a PUCCH and PUCCHless SCell is only supported using an SCell release and add.","paragraph_zero_based":27219},{"literal_text_all_w_t_and_m_t":"ServingCellConfig information element","paragraph_zero_based":27220},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27221},{"literal_text_all_w_t_and_m_t":"-- TAG-SERVINGCELLCONFIG-START","paragraph_zero_based":27222},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27223},{"literal_text_all_w_t_and_m_t":"ServingCellConfig ::=               SEQUENCE {","paragraph_zero_based":27224},{"literal_text_all_w_t_and_m_t":"    tdd-UL-DL-ConfigurationDedicated    TDD-UL-DL-ConfigDedicated                                                OPTIONAL,   -- Cond TDD","paragraph_zero_based":27225},{"literal_text_all_w_t_and_m_t":"    initialDownlinkBWP                  BWP-DownlinkDedicated                                                    OPTIONAL,   -- Need M","paragraph_zero_based":27226},{"literal_text_all_w_t_and_m_t":"    downlinkBWP-ToReleaseList           SEQUENCE (SIZE (1..maxNrofBWPs)) OF BWP-Id                               OPTIONAL,   -- Need N","paragraph_zero_based":27227},{"literal_text_all_w_t_and_m_t":"    downlinkBWP-ToAddModList            SEQUENCE (SIZE (1..maxNrofBWPs)) OF BWP-Downlink                         OPTIONAL,   -- Need N","paragraph_zero_based":27228},{"literal_text_all_w_t_and_m_t":"    firstActiveDownlinkBWP-Id           BWP-Id                                                                   OPTIONAL,   -- Cond SyncAndCellAdd","paragraph_zero_based":27229},{"literal_text_all_w_t_and_m_t":"    bwp-InactivityTimer                 ENUMERATED {ms2, ms3, ms4, ms5, ms6, ms8, ms10, ms20, ms30,","paragraph_zero_based":27230},{"literal_text_all_w_t_and_m_t":"                                                    ms40,ms50, ms60, ms80,ms100, ms200,ms300, ms500,","paragraph_zero_based":27231},{"literal_text_all_w_t_and_m_t":"                                                    ms750, ms1280, ms1920, ms2560, spare10, spare9, spare8,","paragraph_zero_based":27232},{"literal_text_all_w_t_and_m_t":"                                                    spare7, spare6, spare5, spare4, spare3, spare2, spare1 }    OPTIONAL,   --Need R","paragraph_zero_based":27233},{"literal_text_all_w_t_and_m_t":"    defaultDownlinkBWP-Id               BWP-Id                                                                  OPTIONAL,   -- Need S","paragraph_zero_based":27234},{"literal_text_all_w_t_and_m_t":"    uplinkConfig                        UplinkConfig                                                            OPTIONAL,   -- Need M","paragraph_zero_based":27235},{"literal_text_all_w_t_and_m_t":"    supplementaryUplink                 UplinkConfig                                                            OPTIONAL,   -- Need M","paragraph_zero_based":27236},{"literal_text_all_w_t_and_m_t":"    pdcch-ServingCellConfig             SetupRelease { PDCCH-ServingCellConfig }                                OPTIONAL,   -- Need M","paragraph_zero_based":27237},{"literal_text_all_w_t_and_m_t":"    pdsch-ServingCellConfig             SetupRelease { PDSCH-ServingCellConfig }                                OPTIONAL,   -- Need M","paragraph_zero_based":27238},{"literal_text_all_w_