{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"additionalPCI","paragraph_zero_based":21960},{"literal_text_all_w_t_and_m_t":"Indicates the physical cell ID (PCI) of the SSB for the referenceSignal.","paragraph_zero_based":21961},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21962},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":21963},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":21964},{"literal_text_all_w_t_and_m_t":"RS-SSB","paragraph_zero_based":21965},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if ssb-Index is configured for referenceSignal. Otherwise it is absent, Need R.","paragraph_zero_based":21966},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21967},{"literal_text_all_w_t_and_m_t":"–PathlossReferenceRS-Id","paragraph_zero_based":21968},{"literal_text_all_w_t_and_m_t":"The IE PathlossReferenceRS-Id is an ID for a reference signal (RS) configured as PUSCH, PUCCH and SRS pathloss reference RS for unified TCI state operation.","paragraph_zero_based":21969},{"literal_text_all_w_t_and_m_t":"PathlossReferenceRS-Id information element","paragraph_zero_based":21970},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21971},{"literal_text_all_w_t_and_m_t":"-- TAG-PATHLOSSREFERENCERS-ID-START","paragraph_zero_based":21972},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21973},{"literal_text_all_w_t_and_m_t":"PathlossReferenceRS-Id-r17 ::= INTEGER (0..maxNrofPathlossReferenceRSs-1-r17)","paragraph_zero_based":21974},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21975},{"literal_text_all_w_t_and_m_t":"-- TAG-PATHLOSSREFERENCERS-ID-STOP","paragraph_zero_based":21976},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21977},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21978},{"literal_text_all_w_t_and_m_t":"–PCI-ARFCN-EUTRA","paragraph_zero_based":21979},{"literal_text_all_w_t_and_m_t":"The IE PCI-ARFCN-EUTRA is used to encode EUTRA PCI and ARFCN.","paragraph_zero_based":21980},{"literal_text_all_w_t_and_m_t":"PCI-ARFCN-EUTRA information element","paragraph_zero_based":21981},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21982},{"literal_text_all_w_t_and_m_t":"-- TAG-PCIARFCNEUTRA-START","paragraph_zero_based":21983}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["7fe7d193bd39a430f94457c1421cb3fbed8eb4997db41d2ef7e5b853b605c06e","bbc761ab68d1089ee0ecfb75390b5770f94cbed05a2d031cfc01e3224ed20bd8","f538d90f0b64709b08fbcdc6d9548770d9e03c8e17fb84dd51b7daf1074692b6","6381c9a83e8dd3ec3c415bd1c310b7f91bfe4e310c329dcf5506e159bc7a9a7f","95006c421b2d3c7f70a1fb262352856f1764c3712ae293b327a0a7a804d1df65","1f788c36df16a05ce4ece63b945398c62e0fc2b80947fbdff1d6d7839b64c7cd","d7047071784bfaaa256dae8cc4c6f77d5b38a9011c49b2644564ccb57e3f4c7c","b77075e6c6bf22d19fad9e1a439864405228224f3cb815c7018d1c80c97a3518","da2849ea4ecab007e082d3816a58309cf9b07df2a330f83d8db5a24b38f68292","726e67ee71116bbb94d1799759ec7c25119c34248fc4bd1df26589e36b158244","5bd9496d03c21eb0eb9e348c827b119d5090fa9a419d299b65ebe5caa533bbb1","6c29288696427573c846e1aab75ffbb67ddf98efa651fa84079a5f610a59fa2b","6cff9cb1b9c6511077f479b7b177b20ba42d1fb092b0702c7bad0b3a754577e3","e45c7b6b25be0319f44a6f4b388eda7875d811d76cffbd2db0e1d49f0239c274","cb7ce418bdb47545afef01d1edb319f848c5849bdc897cfae6a788b15f0ffd91","d39c25613165237234666c45bca7ec0f6f8224fa0baf381c57f4afce70c0b57a","5046bdb6a0950e47fbf19511635245d67e958726b8851c4d6d535de533273523","0ef8