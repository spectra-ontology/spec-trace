{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"btNameList","paragraph_zero_based":36792},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurements from specific Bluetooth beacons. NG-RAN configures the field if includeBT-Meas is configured for one or more measurements.","paragraph_zero_based":36793},{"literal_text_all_w_t_and_m_t":"candidateServingFreqListNR","paragraph_zero_based":36794},{"literal_text_all_w_t_and_m_t":"Indicates for each candidate NR serving cells, the center frequency around which UE is requested to report IDC issues.","paragraph_zero_based":36795},{"literal_text_all_w_t_and_m_t":"connectedReporting","paragraph_zero_based":36796},{"literal_text_all_w_t_and_m_t":"Indicates that the UE can report a preference to remain in RRC_CONNECTED state following a report to leave RRC_CONNECTED state. If absent, the UE cannot report a preference to stay in RRC_CONNECTED state.","paragraph_zero_based":36797},{"literal_text_all_w_t_and_m_t":"delayBudgetReportingProhibitTimer","paragraph_zero_based":36798},{"literal_text_all_w_t_and_m_t":"Prohibit timer for delay budget reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot4 means prohibit timer is set to 0.4 seconds, and so on.","paragraph_zero_based":36799},{"literal_text_all_w_t_and_m_t":"drx-PreferenceConfig","paragraph_zero_based":36800},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's DRX preferences for power saving.","paragraph_zero_based":36801},{"literal_text_all_w_t_and_m_t":"drx-PreferenceProhibitTimer","paragraph_zero_based":36802},{"literal_text_all_w_t_and_m_t":"Prohibit timer for DRX preferences assistance information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":36803},{"literal_text_all_w_t_and_m_t":"idc-AssistanceConfig","paragraph_zero_based":36804},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about UE detected IDC problem.","paragraph_zero_based":36805},{"literal_text_all_w_t_and_m_t":"maxBW-PreferenceConfig","paragraph_zero_based":36806},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preferred bandwidth for power saving.","paragraph_zero_based":36807},{"literal_text_all_w_t_and_m_t":"maxBW-PreferenceProhibitTimer","paragraph_zero_based":36808},{"literal_text_all_w_t_and_m_t":"Prohibit timer for preferred bandwidth assistance information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":36809},{"literal_text_all_w_t_and_m_t":"maxCC-PreferenceConfig","paragraph_zero_based":36810},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preferred number of carriers for power saving.","paragraph_zero_based":36811},{"literal_text_all_w_t_and_m_t":"maxBW-PreferenceConfigFR2-2","paragraph_zero_based":36812},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preferred bandwidth for power saving for FR2-2.","paragraph_zero_based":36813},{"literal_text_all_w_t_and_m_t":"maxCC-PreferenceProhibitTimer","paragraph_zero_based":36814},{"literal_text_all_w_t_and_m_t":"Prohibit timer for preferred number of carriers assistance information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":36815}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["6dc0ba0f8352aafa7b1d90ff07fbd1095be7231db6c68a09d6887c7463044b1a","21249198efae25049a8b444a1bf07b15a02c687510df2de80e5e8c1a44f4bfc7","4733f71539d5099ce09dcb71e10b624b238fe3cb4fd5ac1c91bbd95523d99042","395f361549fe1653f252a805e9782d2bc2d7abc6ae9f7013e2e1275176ce0b10","f9e54d6eb6bb0f7ed2ca506da2b525519fe67d7a72df2a6bd3e6c549be1c1b29","c4b30f9aa006bb918dd1b76f2aa5400e4210ca44e6ac5622816b95e46509854b","df08b40e14cecf3917b7df88d308f9a51b637500b3acd58e706903b559ac35ff","cb0702e6b820159e66dbd044af8c9196d5c8faa5e2f212b6c44a297fe489a62d","cf520a979aeea489177b43ab8ea13551f3e9a15336d6aeca4596ac8c3a885d9c","b45ee1d0569227d81ec94e927fb782ecd4bda862d20227db2bd75e2872959c49","82512b70bd4a25d6cf4e58830039ef02a24f75d3b49e32c681cf9cc0aef543c0","4e46507c076237926de25a08c5dc4b6fe965aab150779aafee79a7f49b9588e1","f473878d1f1911540854f861057defc592aa494e242bc15f4fe00babf9f1fb6d","21f86f620dbfb4655a053aede96076ce3fcd15dcf8f46b7b10fbe0d8cf3feb0d","d8e42e75eef2d03b9b9043eb4e3ae1891e43f2e21a5d9aabbee27f9ac03547d1","40520164ee914bc129e1f3787b59526b8711e26e432938278645133884af1a3d","b2450d9b5fbaed9713b91c631cdd44355bed70f1b37b4162269fbc72762d0f47","32d1998aa5620416ac8091b1f790b8efa07eade79259ab04df9ee5e0f6f1dd50","21025fd8c5f019cee857a7847ae9bfdbfce1465dd78ba088248a2346b8008a40","2fe7000d3290eaa253121911a3b2c1f3ad686d25ce29161a80307e7e6817e88b","bfd4ddad7800bf93d93ed7e414947272cf6db306bd9639cc519d720808d40577","f7fc3d7cf3bd4da1240cb27f379b8373d965f81baa1545331295dff70f85dd43","8ad0c27bba1f559f1c7793f00d617e48e53b14d31f55b518b21c0da98b6d2832","5f9ccef1