{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    si-BroadcastStatus-r17              ENUMERATED {broadcasting, notBroadcasting},","paragraph_zero_based":27912},{"literal_text_all_w_t_and_m_t":"    si-WindowPosition-r17               INTEGER (1..256),","paragraph_zero_based":27913},{"literal_text_all_w_t_and_m_t":"    si-Periodicity-r17                  ENUMERATED {rf8, rf16, rf32, rf64, rf128, rf256, rf512},","paragraph_zero_based":27914},{"literal_text_all_w_t_and_m_t":"    sib-MappingInfo-r17                 SIB-Mapping-v1700","paragraph_zero_based":27915},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27916},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27917},{"literal_text_all_w_t_and_m_t":"SIB-Mapping ::=                     SEQUENCE (SIZE (1..maxSIB)) OF SIB-TypeInfo","paragraph_zero_based":27918},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27919},{"literal_text_all_w_t_and_m_t":"SIB-Mapping-v1700  ::=              SEQUENCE (SIZE (1..maxSIB)) OF SIB-TypeInfo-v1700","paragraph_zero_based":27920},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27921},{"literal_text_all_w_t_and_m_t":"SIB-TypeInfo ::=                    SEQUENCE {","paragraph_zero_based":27922},{"literal_text_all_w_t_and_m_t":"    type                                ENUMERATED {sibType2, sibType3, sibType4, sibType5, sibType6, sibType7, sibType8, sibType9,","paragraph_zero_based":27923},{"literal_text_all_w_t_and_m_t":"                                                     sibType10-v1610, sibType11-v1610, sibType12-v1610, sibType13-v1610,","paragraph_zero_based":27924},{"literal_text_all_w_t_and_m_t":"                                                     sibType14-v1610, spare3, spare2, spare1,... },","paragraph_zero_based":27925},{"literal_text_all_w_t_and_m_t":"    valueTag                            INTEGER (0..31)                                                 OPTIONAL, -- Cond SIB-TYPE","paragraph_zero_based":27926},{"literal_text_all_w_t_and_m_t":"    areaScope                           ENUMERATED {true}                                               OPTIONAL -- Need S","paragraph_zero_based":27927},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27928},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27929},{"literal_text_all_w_t_and_m_t":"SIB-TypeInfo-v1700 ::=              SEQUENCE {","paragraph_zero_based":27930},{"literal_text_all_w_t_and_m_t":"    sibType-r17                         CHOICE {","paragraph_zero_based":27931},{"literal_text_all_w_t_and_m_t":"        type1-r17                           ENUMERATED {sibType15, sibType16, sibType17, sibType18, sibType19, sibType20, sibType21,","paragraph_zero_based":27932},{"literal_text_all_w_t_and_m_t":"                                                        spare9, spare8, spare7, spare6, spare5, spare4, spare3, spare2, spare1,...},","paragraph_zero_based":27933},{"literal_text_all_w_t_and_m_t":"        type2-r17                           SEQUENCE {","paragraph_zero_based":27934},{"literal_text_all_w_t_and_m_t":"            posSibType-r17                      ENUMERATED {posSibType1-9, posSibType1-10, posSibType2-24, posSibType2-25,","paragraph_zero_based":27935}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["34b8f81082fe69c7d5038d0a3f907088e66d440ead3248b802875a722836337a","73c7cf20707a2f5c5dce979fcc98bc2c091ce180f7b0cab243101625b1a8b23b","7c867579a17fdcd43ebb16063a395d664449da9a395460e30d7d9060895cdb34","88f1be3405cbc912347b6e140cad43a4253f339c51ad494ebdec2767ea709d39","2479ff