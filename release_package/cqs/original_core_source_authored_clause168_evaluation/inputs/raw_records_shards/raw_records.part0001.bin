ph_zero_based":156},{"literal_text_all_w_t_and_m_t":"SPS-ConfigDeactivationState-r16 ::=     SEQUENCE (SIZE (1..maxNrofSPS-Config-r16)) OF SPS-ConfigIndex-r16","paragraph_zero_based":157},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":158},{"literal_text_all_w_t_and_m_t":"SPS-ConfigDeactivationStateList-r16 ::= SEQUENCE (SIZE (1..maxNrofSPS-DeactivationState)) OF SPS-ConfigDeactivationState-r16","paragraph_zero_based":159},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":160},{"literal_text_all_w_t_and_m_t":"DL-PPW-PreConfigToAddModList-r17 ::=    SEQUENCE (SIZE (1..maxNrofPPW-Config-r17)) OF DL-PPW-PreConfig-r17","paragraph_zero_based":161},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":162},{"literal_text_all_w_t_and_m_t":"DL-PPW-PreConfigToReleaseList-r17 ::=   SEQUENCE (SIZE (1..maxNrofPPW-Config-r17)) OF DL-PPW-ID-r17","paragraph_zero_based":163},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":164},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-DOWNLINKDEDICATED-STOP","paragraph_zero_based":165},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":166},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"61f02ceef1d524906560f8f1a482d15e83f76eb00023609c334c63ed8d6c34a9","original_member_sha256":"f9c2336c81c37716b94a78c676bf5f6ace0ec61f8e01450cd0d55d702a9ad7ba","paragraph_ElementTree_utf8_XML_sha256":["89a4b779336d8ff4e63ac388ba8352b2185c170df343bba17ffa6f1d25d3b6ec","688e650a67de9d63acc37ee585502713b58b09737a54c4bcb7bf823ef9206e5b","43de6512738e9435db80ca8c3f662283647749a70dddf13b31dda57d0fed3df1","0d60d7ae0e429ec17a7a0b7a25dc68f5b2df86ae46a1ea6599f4326ce50e035c","cf917fa1749b972ddf02539882428eed2fb8314035cd2ed78c59603065b985e5","171dfa1a5a2f551a0487d75e5621ad44452616819e4acd23b8137c3594d95037","728eb6c0c27c63cc3d13c235d0b91c112260a0c41b683b2cfa067c218fc190d0","0f47e53131477e62f1a5cc9a4ff9d91100a5768e0b2be276e91f8b7e96b72dd0","0ef6e9dd68ca3156be5d7516498e4d34e5f83a36d3f132a62915f9fdafa089ee","ec83a6ab23477f155a4103fed34fceb4db5a45ddde7d31fa655f15427250838b","285615baaa30aa0318b09815aa1f1be0edbaddf3da3cdda327863b475bdaa375","89d48d90a54e144c4e534088556871e73e2aa1cfef4db65e39ffccf2f09fad35","565f3ce87c296baf19f9962a020ade45a028cd9d58821ab9538c21395bb09c52","801102b81885178da70d7257fa09cf2d47e82234d50a55d5df24f5ac726982a5","7af303d92116ac3fc71fd673de88c18f273eb02caf234292d2eb5a501f6f44ef","2498e3003e4fd5a2ecd3fbbf88b5be366037f5bbecc38c21c9513a5e5b95fffc","7200fd2aee66229edf28dd3e7dcffdc2e58bedabb1dcbfb13fd8d6eef38caf9c","2ca5c7cbd8ef58e260823782b362061ecaf1e34640962d7d950a490ce0f88f25","acc6c6a0470886ab377667e7daa8ceb347a9b77962cec10acb569e1fe1cea03f","cb8286cb80d897464821b2b5b9a0b60b134983aca0a5d459a45d9466db498866","ab384a90b84a910e57f8623356218ceb5b340634a6bbd9dfc6539971d558a319","e820dda41be0b8b30fbf0dc09d42a5d673ab6fff464b2b9bb8bca19aa5fbba6c","3fa614841c3295e4718d7e18dfa0716f73b7b9383b7528c9cdb86f9e5e9b6829","613dc3f428df12f2e2daca30c8ed003e9460de2f7325d73e68ab4823e82934ae"],"paragraph_range_zero_based":[144,167],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313691.zip::R2-2313691_Introduction of support for BWP operation without restriction in TS38.331.docx:p144"}
{"fields":{"filename":"R2-2313691.zip::R2-2313691_Introduction of support for BWP operation without restriction in TS38.331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"BWP-DownlinkDedicated field descriptions","paragraph_zero_based":168},{"literal_text_all_w_t_and_m_t":"beamFailureRecoverySCellConfig","paragraph_zero_based":169},{"literal_text_all_w_t_and_m_t":"Configuration of candidate RS for beam failure recovery on SCells.","paragraph_zero_based":170},{"literal_text_all_w_t_and_m_t":"beamFailureRecoverySpCellConfig","paragraph_zero_based":171},{"literal_text_all_w_t_and_m_t":"Configuration of candidate RS for beam failure recovery on the SpCell. This field can only be configured when beamFailure-r17 is configured in RadioLinkMonitoringConfig.","paragraph_zero_based":172},{"literal_text_all_w_t_and_m_t":"cfr-ConfigMulticast","paragraph_zero_based":173},{"literal_text_all_w_t_and_m_t":"UE specific common frequency resource configuration for MBS multicast for one dedicated BWP. This field can be configured within at most one serving cell.","paragraph_zero_based":174},{"literal_text_all_w_t_and_m_t":"dl-PPW-PreConfigToAddModList","paragraph_zero_based":175},{"literal_text_all_w_t_and_m_t":"Indicates a list of DL-PRS processing window configurations to be added or modified for the dedicated DL BWP.","paragraph_zero_based":176},{"literal_text_all_w_t_and_m_t":"dl-PPW-PreConfigToReleaseList","paragraph_zero_based":177},{"literal_text_all_w_t_and_m_t":"Indicates a list of DL-PRS processing window configurations to be released for the dedicated DL BWP.","paragraph_zero_based":178},{"literal_text_all_w_t_and_m_t":"harq-FeedbackEnablingforSPSactive","paragraph_zero_based":179},{"literal_text_all_w_t_and_m_t":"If enabled, UE reports ACK/NACK for the first SPS PDSCH after activation, regardless of if HARQ feedback is enabled or disabled corresponding to the first SPS PDSCH after activation. Otherwise, UE follows configuration of HARQ feedback enabled/disabled corresponding to the first SPS PDSCH after activation.","paragraph_zero_based":180},{"literal_text_all_w_t_and_m_t":"nonCellDefiningSSB","paragraph_zero_based":181},{"literal_text_all_w_t_and_m_t":"If configured, the UE operating in this BWP uses this SSB for the purposes for which it would otherwise have used the CD-SSB of the serving cell (e.g. obtaining sync, measurements, RLM, BFD, beam management). Furthermore, other parts of the BWP configuration that refer to an SSB (e.g. the \"SSB\" configured in the QCL-Info IE; the \"ssb-Index\" configured in the RadioLinkMonitoringRS; CFRA-SSB-Resource; PRACH-ResourceDedicatedBFR) refer implicitly to this NCD-SSB.","paragraph_zero_based":182},{"literal_text_all_w_t_and_m_t":"The NCD-SSB has the same values for the properties (e.g., ssb-PositionsInBurst, PCI, ssb-PBCH-BlockPower) of the corresponding CD-SSB apart from the values of the properties configured in the NonCellDefiningSSB-r17 IE.","paragraph_zero_based":183},{"literal_text_all_w_t_and_m_t":"pdcch-Config","paragraph_zero_based":184},{"literal_text_all_w_t_and_m_t":"UE specific PDCCH configuration for one BWP.","paragraph_zero_based":185},{"literal_text_all_w_t_and_m_t":"pdsch-Config","paragraph_zero_based":186},{"literal_text_all_w_t_and_m_t":"UE specific PDSCH configuration for one BWP.","paragraph_zero_based":187},{"literal_text_all_w_t_and_m_t":"preConfGapStatus","paragraph_zero_based":188},{"literal_text_all_w_t_and_m_t":"Indicates whether the pre-configured measurement gaps (i.e. the gaps configured with preConfigInd) are activated or deactivated upon the switch to this BWP. If this field is configured, the UE shall apply network-controlled mechanism for activation and deactivation of the pre-configured measurement gaps, otherwise the UE shall apply the autonomous activation/deactivation mechanism, as specified in TS 38.133 [14]. The first/leftmost bit corresponds to the measurement gap with gap ID 1, the second bit corresponds to measurement gap with gap ID 2, and so on. Value 0 indicates that the corresponding pre-configured measurement gap is deactivated while value 1 indicates that the corresponding pre-configured measurement gap is activated. The UE shall ignore the bit if the corresponding measurement gap is not a pre-configured measurement gap.","paragraph_zero_based":189},{"literal_text_all_w_t_and_m_t":"servingCellMO","paragraph_zero_based":190},{"literal_text_all_w_t_and_m_t":"measObjectId of the MeasObjectNR in MeasConfig which is associated to the serving cell. For this MeasObjectNR, the following relationship applies between this MeasObjectNR and nonCellDefiningSSB in BWP-DownlinkDedicated of the associated downlink BWP: if ssbFrequency is configured, its value is the same as the absoluteFrequencySSB in the nonCellDefiningSSB. If the field is present in a downlink BWP and the BWP is activated, the UE uses this measurement object for serving cell measurements (e.g., including those used in measurement report triggering events), otherwise, the UE uses the servingCellMO in ServingCellConfig IE.","paragraph_zero_based":191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"61f02ceef1d524906560f8f1a482d15e83f76eb00023609c334c63ed8d6c34a9","original_member_sha256":"f9c2336c81c37716b94a78c676bf5f6ace0ec61f8e01450cd0d55d702a9ad7ba","paragraph_ElementTree_utf8_XML_sha256":["9997b99df22cd7e3b459a49f8806bcd02260467fd330e7847627757ee9563280","8e17fe688239669b2367d2462faa1bab75f76cdea8af6b68fcfe57fb7c8ffb72","689c7fbe25997aef420ee166e83dd6643820e079ed74d234c1bfcf462d07830d","560119b2a83e103d41f5f0ed6a7354369ed63630027750f62442c3aebe249cdd","fe3bd41fd0c5000582ef5cf6db6cf7ffd374cde6f0917235275389e034a2e100","28e28d42ccbdc9e5c1be33352917172dc3ad5963de67e08ea15f97e29d263b01","530a01d9996499881ec2c1c34b20944720f91134424ff61a7b161251082562a7","08379a864820f89b06a7dc581c1025340dde77e41a8e125e3d23e852c5a04cbe","ff0745182803c4f57fbb29d4f8c25a375e343c053b8376b46e0f042b86da7eef","e8fcbc4d74115e55b8d9cb9adf0bb899ba4689ab9f30b5021f822c053e7c8d34","76c1dd0bf819176097cb04dbf28d3e6e49b79779b0e5036528c8fa7d4e8a84b4","5442f22b9232f17daee01bef73802e005cb0b1ecb930ac5a45fc3322d106e546","65685218743df07525533098c3b9b81605a3be17ec1d867513cda5a4a0d77c08","a3c1db0964f03e46eb2d32f2ba548babaf589ec65106af65715d80174433c3e7","d4bc3b7b9eb41849742275e11ac647c1fe387ded50c644f1e43282075a6bf546","e14a34ad374a1a708441dbf7d5efeeec35c16bb186261e7239bb0883936b5dea","33362672526ab0fd6f64a25acc403ebccf4bcea793342e41618705370fe916ef","fe2aa890218e2aceb48adeffc42b06994410c4ec7617b935a2a8bb108717c232","fb14875c183ad6bfaf91adb18118e4b599ce6c7bd793d6de29171e46b5519f52","402996edd88c0cd49142d8fdb6c02855c01ec932be7052fcd158ded8280550e6","0c533a3a853cea3f088e5c586016e85df32dd119bb233b4569b08b40fba45db3","1ba8c728d06413b1d0bca1dfb173fab509fbf6ffc4da90390830c68af632d526","9f7c05ae980650bf781678280e865b089c27fab93f591c6f7cf9880bcae0e5a5","6125de0d141cf87051f03aaf546795274f4957cd1c1f70505be60dfa523ff145"],"paragraph_range_zero_based":[168,191],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313691.zip::R2-2313691_Introduction of support for BWP operation without restriction in TS38.331.docx:p168"}
{"fields":{"filename":"R2-2313691.zip::R2-2313691_Introduction of support for BWP operation without restriction in TS38.331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sps-Config","paragraph_zero_based":192},{"literal_text_all_w_t_and_m_t":"UE specific SPS (Semi-Persistent Scheduling) configuration for one BWP. Except for reconfiguration with sync, the NW does not reconfigure sps-Config when there is an active configured downlink assignment (see TS 38.321 [3]). However, the NW may release the sps-Config at any time. Network can only configure SPS in one BWP using either this field or sps-ConfigToAddModList. Network does not configure SPS in one BWP using this field and sps-ConfigMulticastToAddModList-r17 simultaneously.","paragraph_zero_based":193},{"literal_text_all_w_t_and_m_t":"sps-ConfigDeactivationStateList","paragraph_zero_based":194},{"literal_text_all_w_t_and_m_t":"Indicates a list of the deactivation states in which each state can be mapped to a single or multiple SPS configurations to be deactivated, see clause 10.2 in TS 38.213 [13]. If a state is mapped to multiple SPS configurations, each of these SPS configurations is configured with the same harq-CodebookID.","paragraph_zero_based":195},{"literal_text_all_w_t_and_m_t":"sps-ConfigToAddModList","paragraph_zero_based":196},{"literal_text_all_w_t_and_m_t":"Indicates a list of one or more DL SPS configurations to be added or modified in one BWP. Except for reconfiguration with sync, the NW does not reconfigure a SPS configuration when it is active (see TS 38.321 [3]).","paragraph_zero_based":197},{"literal_text_all_w_t_and_m_t":"sps-ConfigToReleaseList","paragraph_zero_based":198},{"literal_text_all_w_t_and_m_t":"Indicates a list of one or more DL SPS configurations to be released. The NW may release a SPS configuration at any time.","paragraph_zero_based":199},{"literal_text_all_w_t_and_m_t":"radioLinkMonitoringConfig","paragraph_zero_based":200},{"literal_text_all_w_t_and_m_t":"UE specific configuration of radio link monitoring for detecting cell- and beam radio link failure occasions. The maximum number of failure detection resources should be limited up to 8 for both cell and beam radio link failure detection. For SCells, only periodic 1-port CSI-RS can be configured in IE RadioLinkMonitoringConfig.","paragraph_zero_based":201},{"literal_text_all_w_t_and_m_t":"sl-PDCCH-Config","paragraph_zero_based":202},{"literal_text_all_w_t_and_m_t":"Indicates the UE specific PDCCH configurations for receiving the SL grants (via SL-RNTI or SL-CS-RNTI) for NR sidelink communication/discovery.","paragraph_zero_based":203},{"literal_text_all_w_t_and_m_t":"sl-V2X-PDCCH-Config","paragraph_zero_based":204},{"literal_text_all_w_t_and_m_t":"Indicates the UE specific PDCCH configurations for receiving SL grants (i.e. sidelink SPS) for V2X sidelink communication.","paragraph_zero_based":205},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":206},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":207},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":208},{"literal_text_all_w_t_and_m_t":"MeasObject-NCD-SSB","paragraph_zero_based":209},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need S, if nonCellDefiningSSB is configured in this DL BWP. It is absent otherwise.","paragraph_zero_based":210},{"literal_text_all_w_t_and_m_t":"PreConfigMG","paragraph_zero_based":211},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if there is at least one per UE gap configured with preConfigInd or there is at least one per FR gap of the same FR which the BWP belongs to and configured with preConfigInd. It is absent, Need R, otherwise.","paragraph_zero_based":212},{"literal_text_all_w_t_and_m_t":"ScellOnly","paragraph_zero_based":213},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need M, in the BWP-DownlinkDedicated of an Scell. It is absent otherwise.","paragraph_zero_based":214},{"literal_text_all_w_t_and_m_t":"SpCellOnly","paragraph_zero_based":215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"61f02ceef1d524906560f8f1a482d15e83f76eb00023609c334c63ed8d6c34a9","original_member_sha256":"f9c2336c81c37716b94a78c676bf5f6ace0ec61f8e01450cd0d55d702a9ad7ba","paragraph_ElementTree_utf8_XML_sha256":["9dad0b7c64f036ca6d8b5c6a76ab35ff6b1126f86f7310c6589560da80408faa","34b5edbf38f6ffbde6f77201a3ac5f94ae649c256ed56a5a0232bc60bd260656","4d71512ed734075fa223791c4cca6c2e3e1014c4d0608e7d77200d96c66d38ab","e3551ae2a6d366d4f0b3a2d572d13bb5429192b264ac042d3156913b8c85909b","d8ff390c7e19064726594892a05c789ff7afff1356dd537fe8ed6167f1142b04","18a65324ee596cf5c8dbf513348a0badfeff20a0878df517c465fdd3a97e86bc","c4c8920ff47193c6e815ee53739204a53ea53e18fb797ddb727fa56f2e3b9f57","f60c5e196307c5de294be3457cf2083b41645c7fe129dcc88e38132d93ff8ef1","9bf4132c3d37348900bfb27accaba49871e8e353ff6b6e67bd4a4e80a645a7d5","c00f6ed86be2afbc5150b3bbd2ec5a105ca55742adb4ea6f68985e07196d209b","d7b038741f7328cf39dc4c05a3d88e7e0c7eac4834a5164f4af59bfa0d7ff38e","b8d88d909cc0961293bc15c7e17a194e14541bce7150abe17203e71b5cf8903a","77da13db3fb18d3d0817447c3e27a6c9aba45b7c0e61eeb28498fb9948e761da","9afe282c8468da44d48bb6a880a2ce5adb2731551bcf63797482c8777c113411","f9b0fa152050876928c6789ca49070204c9296692eaad25156b3fcb0c5536774","79c4f1ed9df6f0ffe3767a81761f0ae47c0b66ac628f8d99ce3ea20a0c449853","17fe7bbb37b1a2eecabdbe4924ff4abef6913f9cf7988d47733935278a690fba","9c47c97c8a169856cc2b8a41ee2b5a6e971154688ed5097c98545a3f9b091ade","452d284723208f7abc111d22fa48e5e393451cc99330ee563e8fde5cae76728b","b79ef21ac3345fb9cef6c89c535c7702ea5c1a0edcb8512ccb0d03fd44b23fe6","6b51ca4892bdd6ea7ccb9d002fe1324283404f922fa1491490999167121e913d","019fb746afd90e3d5c7a469667d9b422d2f0ed78687ce2d0f2b1cd8b0595b980","25cda8549ff2e04867b53755aae60888e7eee444e86b9a37c430e50bee45a107","1895cd383df1689e2f2c4cc29791e353f39d1e5f91449b97e44c967f0dd6ce52"],"paragraph_range_zero_based":[192,215],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313691.zip::R2-2313691_Introduction of support for BWP operation without restriction in TS38.331.docx:p192"}
{"fields":{"filename":"R2-2313691.zip::R2-2313691_Introduction of support for BWP operation without restriction in TS38.331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need M, in the BWP-DownlinkDedicated of an Spcell. It is absent otherwise.","paragraph_zero_based":216},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":217},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":218},{"literal_text_all_w_t_and_m_t":"Next change ","paragraph_zero_based":219},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":220},{"literal_text_all_w_t_and_m_t":"–BWP-UplinkCommon","paragraph_zero_based":221},{"literal_text_all_w_t_and_m_t":"The IE BWP-UplinkCommon is used to configure the common parameters of an uplink BWP. They are \"cell specific\" and the network ensures the necessary alignment with corresponding parameters of other UEs. The common parameters of the initial bandwidth part of the PCell are also provided via system information. For all other serving cells, the network provides the common parameters via dedicated signalling.","paragraph_zero_based":222},{"literal_text_all_w_t_and_m_t":"BWP-UplinkCommon information element","paragraph_zero_based":223},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":224},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-UPLINKCOMMON-START","paragraph_zero_based":225},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":226},{"literal_text_all_w_t_and_m_t":"BWP-UplinkCommon ::=                SEQUENCE {","paragraph_zero_based":227},{"literal_text_all_w_t_and_m_t":"    genericParameters                   BWP,","paragraph_zero_based":228},{"literal_text_all_w_t_and_m_t":"    rach-ConfigCommon                   SetupRelease { RACH-ConfigCommon }                                      OPTIONAL,   -- Need M","paragraph_zero_based":229},{"literal_text_all_w_t_and_m_t":"    pusch-ConfigCommon                  SetupRelease { PUSCH-ConfigCommon }                                     OPTIONAL,   -- Need M","paragraph_zero_based":230},{"literal_text_all_w_t_and_m_t":"    pucch-ConfigCommon                  SetupRelease { PUCCH-ConfigCommon }                                     OPTIONAL,   -- Need M","paragraph_zero_based":231},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":232},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":233},{"literal_text_all_w_t_and_m_t":"    rach-ConfigCommonIAB-r16            SetupRelease { RACH-ConfigCommon }                                      OPTIONAL,   -- Need M","paragraph_zero_based":234},{"literal_text_all_w_t_and_m_t":"    useInterlacePUCCH-PUSCH-r16         ENUMERATED {enabled}                                                    OPTIONAL,   -- Need R","paragraph_zero_based":235},{"literal_text_all_w_t_and_m_t":"    msgA-ConfigCommon-r16               SetupRelease { MsgA-ConfigCommon-r16 }                                  OPTIONAL    -- Cond SpCellOnly2","paragraph_zero_based":236},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":237},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":238},{"literal_text_all_w_t_and_m_t":"    enableRA-PrioritizationForSlicing-r17 BOOLEAN                                                    OPTIONAL, -- Cond RA-PrioSliceAI","paragraph_zero_based":239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"61f02ceef1d524906560f8f1a482d15e83f76eb00023609c334c63ed8d6c34a9","original_member_sha256":"f9c2336c81c37716b94a78c676bf5f6ace0ec61f8e01450cd0d55d702a9ad7ba","paragraph_ElementTree_utf8_XML_sha256":["121411fcee8d4509fbc7fd45a310ccceb025f383a23c5477f49f486e3de70a86","fb081a842371d3f1a746285e6613b42f4302227ca3be5d8af420349f4bbf203e","0517c495d9fc8e587be8066b76b7a21484ee6c0706b9f5a54fb715c655a34110","8f02c1115f6579c34a4d7ad3734e6af39f2bcc4932f15d6e7d8875ad9e3f410e","3bdcc2d94e32a411cb150aaba50f936632870a512e0a9401f21c17cb5e0b7896","c7720eb221964d884333bfe7c2b9fc971dd8fb07bfeda8877147f289253bdee2","66eb682c5c16a397ef40d3bfcb311695d01c8e34de492af4bed95cefbd7543d2","65ab67330c4673777a5797d118e647b6fc9f1e4379add38cbae0e5bc1be600f4","c175d8e1ac88a24e4d375b9c98bd6c5b17e7dc392a51a3713eec04f1bd05742e","f4b7d7d88b0ba646e43bd55986b45ec9e3f8d596d2a8dcc229f505ad021fa794","3a94d3d4694c5f81d9f5a35369068328a6322a806f5e2b033d3e437153a2da65","0cda782aa0bc3a4bba172a9cddd614b3833a28439c192d70b029f2cdbbbb66ab","c3ff3ef996116b990229a5b1d4c1996b0b7b1fc238629bc15a7142ce20851d51","4fdf069ff85f8f595b3ec682133a81c50a23dd4e669ce7932a1fadc90b2aad15","0cff82f9705ab1bfde0b737e29478fae6f10fb0b0b1cc555e4bae1f62dc9a6cc","a5e4c445492b3c62f31bf734e882d5a4cafbc65d3a5d9f95e459a76220ee54e4","227779b2d90da6a77a1f88d1b4d67085fb9afe520e5c431fa0074793bfc34e95","a90fc8702f3c859dfcd149f4c30996d65f137f0ae6bc3b1d8ccd4ba17dfb1e81","c0bfd94be71f4128e4976cb5d6d858d263d7c7bfac6336217a549382749f9c09","b51713e0d21e0895fa25659220558af4a10de2cb220031c18b004f2a5e857556","8131e31cbc5143223ad7f6715100a2031945c685dbb67e900f940d22298e0b14","94f34f95f17b788b042c81801ca020abeacb4bf84104b5ab1012cade0e87aa5d","abf63314a8cabc199a7c6bf06b68fa711fe6bdc1029114a22ee0e21c2c76f2cc","bf3d351f0418a9303212abda00f7163ead1b698a9b7c1aaba122cc191e35dc58"],"paragraph_range_zero_based":[216,239],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313691.zip::R2-2313691_Introduction of support for BWP operation without restriction in TS38.331.docx:p216"}
{"fields":{"filename":"R2-2313691.zip::R2-2313691_Introduction of support for BWP operation without restriction in TS38.331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    additionalRACH-ConfigList-r17       SetupRelease { AdditionalRACH-ConfigList-r17 }               OPTIONAL, -- Cond SpCellOnly2","paragraph_zero_based":240},{"literal_text_all_w_t_and_m_t":"    rsrp-ThresholdMsg3-r17              RSRP-Range                                                   OPTIONAL, -- Need R","paragraph_zero_based":241},{"literal_text_all_w_t_and_m_t":"    numberOfMsg3-RepetitionsList-r17    SEQUENCE (SIZE (4)) OF NumberOfMsg3-Repetitions-r17                  OPTIONAL,  -- Cond Msg3Rep","paragraph_zero_based":242},{"literal_text_all_w_t_and_m_t":"    mcs-Msg3-Repetitions-r17            SEQUENCE (SIZE (8)) OF INTEGER (0..31)                               OPTIONAL   -- Cond Msg3Rep","paragraph_zero_based":243},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":244},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":245},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":246},{"literal_text_all_w_t_and_m_t":"AdditionalRACH-ConfigList-r17 ::=       SEQUENCE (SIZE(1..maxAdditionalRACH-r17)) OF AdditionalRACH-Config-r17","paragraph_zero_based":247},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":248},{"literal_text_all_w_t_and_m_t":"AdditionalRACH-Config-r17 ::=       SEQUENCE {","paragraph_zero_based":249},{"literal_text_all_w_t_and_m_t":"    rach-ConfigCommon-r17               RACH-ConfigCommon                                                   OPTIONAL,  -- Need R","paragraph_zero_based":250},{"literal_text_all_w_t_and_m_t":"    msgA-ConfigCommon-r17               MsgA-ConfigCommon-r16                                               OPTIONAL,  -- Need R","paragraph_zero_based":251},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":252},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":253},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":254},{"literal_text_all_w_t_and_m_t":"NumberOfMsg3-Repetitions-r17::=         ENUMERATED {n1, n2, n3, n4, n7, n8, n12, n16}","paragraph_zero_based":255},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":256},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-UPLINKCOMMON-STOP","paragraph_zero_based":257},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":258},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":259},{"literal_text_all_w_t_and_m_t":"BWP-UplinkCommon field descriptions","paragraph_zero_based":260},{"literal_text_all_w_t_and_m_t":"additionalRACH-ConfigList","paragraph_zero_based":261},{"literal_text_all_w_t_and_m_t":"List of feature or feature combination-specific RACH configurations, i.e. the RACH configurations configured in addition to the one configured by rach-ConfigCommon and by msgA-ConfigCommon. The network associates all possible preambles of an additional RACH configuration to one or more feature(s) or feature combination(s). The network does not configure this list to have more than 16 entries. If both rach-ConfigCommon and msgA-ConfigCommon are configured for a specific FeatureCombination, the network always provides them in the same additionalRACH-Config.","paragraph_zero_based":262},{"literal_text_all_w_t_and_m_t":"enableRA-PrioritizationForSlicing","paragraph_zero_based":263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"61f02ceef1d524906560f8f1a482d15e83f76eb00023609c334c63ed8d6c34a9","original_member_sha256":"f9c2336c81c37716b94a78c676bf5f6ace0ec61f8e01450cd0d55d702a9ad7ba","paragraph_ElementTree_utf8_XML_sha256":["c01ca9c5175f9cadc23c92b2818a54989415f4f8bc51d8362f5ebe467b404dd8","259bf1f4147587f1f0e74138ce4a2c89dab0df25085e51ca371a5c2083d923ee","2b2f905c55898eec8489537142e1445d0ac70cdc1bc05c1ebf38f0ae198af50b","80bb035bc9ae5e244a641032736c659fcbe0335f915dba946e37f43bb7d05f15","913acb0196794bce29b6ebbf8c12345b4eb18997298c57da6790e1529c02f68a","9f536d29ec3945a93af3499320ddc32a9401f53c1f19276da6ff4ec2fd5a8f3e","2b730de819495aee52676cea2afbc6e7a476b4dce87594254cf96f01f661ebe7","e82ece099ff3668a2716df781776bd59ec113cf916a1e5a52cac7462ff23ad5f","ada03eed1efac154eb369a0350beab7f1f36ca03f4e34b9537f1ae3a268ad58a","9f28c497c3665812a4f2413ffe17a9682c30eabb0fa2295045c8799b2ca47ef4","4fc4760b588fdb7ce45c26467e4224761f98a2b4cfcfc9ba7b13caefb8f88856","da7f0466f7b9a9cb62b0f957817c8b7c6c3ff30e35cba5e0e220cc169cf0b4cf","211d8a76f6a602d20aab046e449a458fce96a4ec35b6d569382eac0ca2b8d4b8","0296ae8ea35da2805c214f17596c079f4956935914c222839cc468152dd7d70c","1497de074ab37bdd2b66de77ce3e35c7c982bbc03dc9c4a556c3e6503fec36db","bcd90ded6bba99f89a6900a2e0acec6d7d697a9084070363ddac005e7e6fe7a0","8a00fb2793f7f30bd49c7dee3c073671f194e6d5912e342a50bf524ae97a09ab","1b45c9994abe4c195092f6dee6aa2aaa1068d80944a105c272baefce8e09b785","ce18849297a6917eda67b626c581e13dae9fb923e8a7b9935fa5fd968e9e9df4","3b9cf14d107776996142820eb651540918c1a8ff7b83f68ed1ec1cb5a4794bd1","7aa5922b0b9f7f393791aa3db4de1e25a68bec40f492a53fa648c1a36822995f","e2b0d20efd3e27c25a7e57106e57ed738293b0c55c2690e706989f7e8b91feeb","3e787b4ef3716e27078150071015f2a75494cc4606310285f6737012d3029372","43fd45672418883263dabaa6bf4584fd11d0961ba7c890f00eaf3ced9270a94f"],"paragraph_range_zero_based":[240,263],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313691.zip::R2-2313691_Introduction of support for BWP operation without restriction in TS38.331.docx:p240"}
{"fields":{"filename":"R2-2313691.zip::R2-2313691_Introduction of support for BWP operation without restriction in TS38.331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether or not the ra-PrioritizationForSlicing/ra-PrioritizationForSlicingTwoStep should override the ra-PrioritizationForAccessIdentity. The field is applicable only when the UE is configured by upper layers with both NSAG and Access Identity 1 or 2. If value TRUE is configured, the UE should only apply the ra-PrioritizationForSlicing/ra-PrioritizationForSlicingTwoStep. If value FALSE is configured, the UE should only apply ra-PrioritizationForAccessIdentity. If the field is absent, whether to use ra-PrioritizationForSlicing/ra-PrioritizationForSlicingTwoStep or ra-PrioritizationForAccessIdentity is up to UE implementation.","paragraph_zero_based":264},{"literal_text_all_w_t_and_m_t":"mcs-Msg3-Repetitions","paragraph_zero_based":265},{"literal_text_all_w_t_and_m_t":"Configuration of eight candidate MCS indexes for PUSCH transmission scheduled by RAR UL grant and DCI format 0_0 with CRC scrambled by TC-RNTI. Only the first 4 configured or default MCS indexes are used for PUSCH transmission scheduled by RAR UL grant. This field is only applicable when the UE selects Random Access resources indicating Msg3 repetition in this BWP. If this field is absent when the set(s) of Random Access resources with MSG3 repetition indication are configured in the BWP-UplinkCommon, the UE shall apply the values {0, 1, 2, 3, 4, 5, 6, 7} (see TS 38.214 [19], clause 6.1.4).","paragraph_zero_based":266},{"literal_text_all_w_t_and_m_t":"msgA-ConfigCommon","paragraph_zero_based":267},{"literal_text_all_w_t_and_m_t":"Configuration of the cell specific PRACH and PUSCH resource parameters for transmission of MsgA in 2-step random access type procedure. The NW can configure msgA-ConfigCommon only for UL BWPs if the linked DL BWPs (same bwp-Id as UL-BWP) are the initial DL BWPs or DL BWPs containing the SSB associated to the initial DL BWP or DL BWPs associated with nonCellDefiningSSB or, for (e)RedCap UEs, the RedCap-specific initial downlink BWP.","paragraph_zero_based":268},{"literal_text_all_w_t_and_m_t":"numberOfMsg3-RepetitionsList","paragraph_zero_based":269},{"literal_text_all_w_t_and_m_t":"The number of repetitions for PUSCH transmission scheduled by RAR UL grant and DCI format 0_0 with CRC scrambled by TC-RNTI. This field is only applicable when the UE selects Random Access resources indicating Msg3 repetition in this BWP. If this field is absent when the set(s) of Random Access resources with MSG3 repetition indication are configured in the BWP-UplinkCommon, the UE shall apply the values {n1, n2, n3, n4} (see TS 38.214 [19], clause 6.1.2.1).","paragraph_zero_based":270},{"literal_text_all_w_t_and_m_t":"pucch-ConfigCommon","paragraph_zero_based":271},{"literal_text_all_w_t_and_m_t":"Cell specific parameters for the PUCCH of this BWP. ","paragraph_zero_based":272},{"literal_text_all_w_t_and_m_t":"pusch-ConfigCommon","paragraph_zero_based":273},{"literal_text_all_w_t_and_m_t":"Cell specific parameters for the PUSCH of this BWP.","paragraph_zero_based":274},{"literal_text_all_w_t_and_m_t":"rach-ConfigCommon","paragraph_zero_based":275},{"literal_text_all_w_t_and_m_t":"Configuration of cell specific random access parameters which the UE uses for contention based and contention free random access as well as for contention based beam failure recovery in this BWP. The NW configures SSB-based RA (and hence RACH-ConfigCommon) only for UL BWPs if the linked DL BWPs (same bwp-Id as UL-BWP) are the initial DL BWPs or DL BWPs containing the SSB associated to the initial DL BWP or DL BWPs associated with nonCellDefiningSSB or, for (e)RedCap UEs, the RedCap-specific initial downlink BWP. The network configures rach-ConfigCommon, whenever it configures contention free random access (for reconfiguration with sync or for beam failure recovery). For RedCap-specific initial uplink BWP, rach-ConfigCommon is always configured when msgA-ConfigCommon is configured in this BWP.","paragraph_zero_based":276},{"literal_text_all_w_t_and_m_t":"rach-ConfigCommonIAB","paragraph_zero_based":277},{"literal_text_all_w_t_and_m_t":"Configuration of cell specific random access parameters for the IAB-MT. The IAB specific IAB RACH configuration is used by IAB-MT, if configured.","paragraph_zero_based":278},{"literal_text_all_w_t_and_m_t":"rsrp-ThresholdMsg3","paragraph_zero_based":279},{"literal_text_all_w_t_and_m_t":"Threshold used by the UE for determining whether to select resources indicating Msg3 repetition in this BWP, as specified in TS 38.321 [3]. The field is mandatory if both set(s) of Random Access resources with MSG3 repetition indication and set(s) of Random Access resources without MSG3 repetition indication are configured in the BWP. It is absent otherwise.","paragraph_zero_based":280},{"literal_text_all_w_t_and_m_t":"useInterlacePUCCH-PUSCH","paragraph_zero_based":281},{"literal_text_all_w_t_and_m_t":"If the field is present, the UE uses uplink frequency domain resource allocation Type 2 for cell-specific PUSCH, e.g., PUSCH scheduled by RAR UL grant (see TS 38.213 [13] clause 8.3 and TS 38.214 [19], clause 6.1.2.2) and uses interlaced PUCCH Format 0 and 1 for cell-specific PUCCH (see TS 38.213 [13], clause 9.2.1).","paragraph_zero_based":282},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":283},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":284},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":285},{"literal_text_all_w_t_and_m_t":"Msg3Rep","paragraph_zero_based":286},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need S, if the set(s) of Random Access resources with MSG3 repetition indication are configured in the BWP-UplinkCommon. It is absent otherwise.","paragraph_zero_based":287}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"61f02ceef1d524906560f8f1a482d15e83f76eb00023609c334c63ed8d6c34a9","original_member_sha256":"f9c2336c81c37716b94a78c676bf5f6ace0ec61f8e01450cd0d55d702a9ad7ba","paragraph_ElementTree_utf8_XML_sha256":["cebf49fd2d55d41258ddc5c18fbb95826e62fae21c6469db94dda78ed453e0e7","8ae38a472e289b6c4e8356b9a1b7ca7c82f20b929396e84b6937048ed664476f","f62ccd0ec5379410d8320b86b19c4b88ae90a4fee470db8fd377854f7ad915be","c552bd4a4b9cdeb4dafee91843d1b2258ce71458c5a351fc85a3cf3c2e72487b","5c7804fd9d4c4edbb0e8ebaeda3c6a16ce023aecc5cb5160cc2be8c581a4f72b","eb33726923bdef2879a0a4ed1393b80c7151d9be2dfe074a55c15bca42a2206a","f82a9d0c13febbf6dabf12e74ad74d6bc946b4400aad9baad1e0b50a9a352c51","c01a81b28000be9d548aaa37f148159e667e346334ee6294458bb22452bf032b","c7e92bb04b237984a5d473245a1314534c8b5ae8318531af18de05584a3f9213","1682f41ad5ca98301b27050ae96958ee3eddca8c90e97ab9bba16ca5e19c23ca","8e16ef0ad1672639961e28d91a47b127b127a76484d143e1b8111f7399b30c42","967fd8caf2bcb4238e8439e9a7dfa793ca2ec193bdff52a85d5a553c0ffd9680","c173058fc1e6cdbcb425d1f7a114c5f3605e52c761554f5875b8905929159dd4","7d860e0578f3b420d483dd1ba9e9f31acd20b7ee3625829aba5ab1be0fbc6d9b","dea7533e800d9f28c7f16b19271969501943739f5a30fc88a2406a3b6c6466e2","13103ab6aec519223fd7086647f264349eb9fa4abc627945c52a08b243da9e1b","609749c7e7c6ba63c8bfcf65d595d477767e8b0df5d2efc696bb6d976147a44b","af6261f312d2e664c8b7b5582a46f30da2b07666c212175a0709a58b8e0d94b7","ff7812024823b2f2575fc102c13c70aa7180fcab559e7837cf3fff970cf7f1bc","f34ad500845e3579e32f3d0b0b116015304ede2f6624a61ee7a78d37c88340e8","23cd3b13be4aad1ba4bfa3579a446876f00ac125ca78f1deba30e22e14479c8e","a6631836a01bd12dcb2183c5ae884a2ac3bf7db2747fb16c320fc75ca38e4886","c86600802f24317806b4c78f480ae02b269b1d062119ea70be445e87208e9ad0","7d7fe508962ba1f581d8c67a2ca3d86b1f14c0280afb7679e60934e7d13c58b2"],"paragraph_range_zero_based":[264,287],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313691.zip::R2-2313691_Introduction of support for BWP operation without restriction in TS38.331.docx:p264"}
{"fields":{"filename":"R2-2313691.zip::R2-2313691_Introduction of support for BWP operation without restriction in TS38.331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"RA-PrioSliceAI","paragraph_zero_based":288},{"literal_text_all_w_t_and_m_t":"The field is optionally present in SIB1, Need R, if both parameters ra-PrioritizationForAccessIdentity and the ra-PrioritizationForSlicing/ra-PrioritizationForSlicingTwoStep are present in SIB1. It is absent otherwise.","paragraph_zero_based":289},{"literal_text_all_w_t_and_m_t":"SpCellOnly2","paragraph_zero_based":290},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need M, in the BWP-UplinkCommon of an SpCell. It is absent otherwise.","paragraph_zero_based":291},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":292},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":293},{"literal_text_all_w_t_and_m_t":"Next change ","paragraph_zero_based":294},{"literal_text_all_w_t_and_m_t":"–CellGroupConfig","paragraph_zero_based":295},{"literal_text_all_w_t_and_m_t":"The CellGroupConfig IE is used to configure a master cell group (MCG) or secondary cell group (SCG). A cell group comprises of one MAC entity, a set of logical channels with associated RLC entities and of a primary cell (SpCell) and one or more secondary cells (SCells).","paragraph_zero_based":296},{"literal_text_all_w_t_and_m_t":"CellGroupConfig information element","paragraph_zero_based":297},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":298},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLGROUPCONFIG-START","paragraph_zero_based":299},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":300},{"literal_text_all_w_t_and_m_t":"-- Configuration of one Cell-Group:","paragraph_zero_based":301},{"literal_text_all_w_t_and_m_t":"CellGroupConfig ::=                        SEQUENCE {","paragraph_zero_based":302},{"literal_text_all_w_t_and_m_t":"    cellGroupId                                CellGroupId,","paragraph_zero_based":303},{"literal_text_all_w_t_and_m_t":"    rlc-BearerToAddModList                     SEQUENCE (SIZE(1..maxLC-ID)) OF RLC-BearerConfig                        OPTIONAL,   -- Need N","paragraph_zero_based":304},{"literal_text_all_w_t_and_m_t":"    rlc-BearerToReleaseList                    SEQUENCE (SIZE(1..maxLC-ID)) OF LogicalChannelIdentity                  OPTIONAL,   -- Need N","paragraph_zero_based":305},{"literal_text_all_w_t_and_m_t":"    mac-CellGroupConfig                        MAC-CellGroupConfig                                                     OPTIONAL,   -- Need M","paragraph_zero_based":306},{"literal_text_all_w_t_and_m_t":"    physicalCellGroupConfig                    PhysicalCellGroupConfig                                                 OPTIONAL,   -- Need M","paragraph_zero_based":307},{"literal_text_all_w_t_and_m_t":"    spCellConfig                               SpCellConfig                                                            OPTIONAL,   -- Need M","paragraph_zero_based":308},{"literal_text_all_w_t_and_m_t":"    sCellToAddModList                          SEQUENCE (SIZE (1..maxNrofSCells)) OF SCellConfig                       OPTIONAL,   -- Need N","paragraph_zero_based":309},{"literal_text_all_w_t_and_m_t":"    sCellToReleaseList                         SEQUENCE (SIZE (1..maxNrofSCells)) OF SCellIndex                        OPTIONAL,   -- Need N","paragraph_zero_based":310},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"61f02ceef1d524906560f8f1a482d15e83f76eb00023609c334c63ed8d6c34a9","original_member_sha256":"f9c2336c81c37716b94a78c676bf5f6ace0ec61f8e01450cd0d55d702a9ad7ba","paragraph_ElementTree_utf8_XML_sha256":["a3f29fab2f7e4be6a65914967c01450725e1b3730070720f50205e6657ef