{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        dlInformationTransfer                   DLInformationTransfer,","paragraph_zero_based":44232},{"literal_text_all_w_t_and_m_t":"        handoverFromEUTRAPreparationRequest     HandoverFromEUTRAPreparationRequest,","paragraph_zero_based":44233},{"literal_text_all_w_t_and_m_t":"        mobilityFromEUTRACommand                MobilityFromEUTRACommand,","paragraph_zero_based":44234},{"literal_text_all_w_t_and_m_t":"        rrcConnectionReconfiguration            RRCConnectionReconfiguration,","paragraph_zero_based":44235},{"literal_text_all_w_t_and_m_t":"        rrcConnectionRelease                    RRCConnectionRelease,","paragraph_zero_based":44236},{"literal_text_all_w_t_and_m_t":"        securityModeCommand                     SecurityModeCommand,","paragraph_zero_based":44237},{"literal_text_all_w_t_and_m_t":"        ueCapabilityEnquiry                     UECapabilityEnquiry,","paragraph_zero_based":44238},{"literal_text_all_w_t_and_m_t":"        spare1 NULL","paragraph_zero_based":44239},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":44240},{"literal_text_all_w_t_and_m_t":"    messageClassExtension   SEQUENCE {}","paragraph_zero_based":44241},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44242},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44243},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44244},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44245},{"literal_text_all_w_t_and_m_t":"A nested two-level CHOICE structure is used, where the alternative PDU types are alternatives within the inner level c1 CHOICE.","paragraph_zero_based":44246},{"literal_text_all_w_t_and_m_t":"Spare alternatives (i.e., spare1 in this case) may be included within the c1 CHOICE to facilitate future extension. The number of such spare alternatives should not extend the total number of alternatives beyond an integer-power-of-two number of alternatives (i.e., eight in this case).","paragraph_zero_based":44247},{"literal_text_all_w_t_and_m_t":"Further extension of the number of alternative PDU types is facilitated using the messageClassExtension alternative in the outer level CHOICE.","paragraph_zero_based":44248},{"literal_text_all_w_t_and_m_t":"A.3.3Message definition","paragraph_zero_based":44249},{"literal_text_all_w_t_and_m_t":"Each PDU (message) type is specified in an ASN.1 clause similar to the one shown in the example below.","paragraph_zero_based":44250},{"literal_text_all_w_t_and_m_t":"-- /example/ ASN1START","paragraph_zero_based":44251},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44252},{"literal_text_all_w_t_and_m_t":"RRCConnectionReconfiguration ::=    SEQUENCE {","paragraph_zero_based":44253},{"literal_text_all_w_t_and_m_t":"    rrc-TransactionIdentifier           RRC-TransactionIdentifier,","paragraph_zero_based":44254},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                  CHOICE {","paragraph_zero_based":44255}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["b4fe46b6ae51ac1a4bab1ca45ee13065c87e08af8c979a0a736512891d06ed06","7a3cf98c7b9f9f7073813778ce03dd57b0fda1d2e30f44243807a2c82200d73d","d7eca751c5a539ebb728f24027a1140aaa37c627d0915fbacc5dc93c52b9f921","3b8b6f5b48bd128c10698ff67f0d8b21c7177ee0c85a49d41aae2d93cafe301b","14324357d18dd402f2b383c8b66893ef8c00d4781c05cf72e6ec826478ff2fbb","27a41619ee04d7c49036655b64f5b2ce8aa6ccfb62054c40660b6a657ce5c19f","82c330b11d8e5c0c25fae5fc9f59798b998e8fbba872fa49cd7b12034933ec1b","225853b5d2f6ee24bba775a419b439a9f3ab61ab78653c132ed1fbb9768a5190","729326b01873e60d4c8cea61fe8a4cdf4e59a07789b2b03b3172a3240eef1658","52c52119686fd51f43f71ada515a686a803b87cb61b47b4a0b90ba85e93eb7a9","4733d8d9d246c83ccdfc36e3ce6b9a9d7143483068538f1be790d8b462b4f9c1","70493e912789058a995df34b026e755ebd4ef1bed5a86a76d58d6a262b0fbaf8","8ac0d166cd97edb91b26bf36d831eaa04ab6108ff75f53a7b25559fea7219d87","ec67ab567203ff30cb5c8dbf1e3fbd537b74694a182336d913d36b2a6f383a5b","69755ff47dccea781af494412e982fe9c65b45c4f292a4055be0f28b22cec281","d2d7ff727535fd96fbfeebc66d792c4e05c159332cebb2aff2fbd4cffca988e7","029d22c882ee5ca12283455109047618a038838f30949b658694f34eed7bc4f9","835ca259597e48bd6642ee2ce3040a4ffbe2bb50dad479480e0d2df5006224b9","928eebb55844f4099359077b38a1a8ce65d28346b332c40e21e143adbe3bb2ab","a79202d10d70e8728e1ab6ea243dd5bfdb017bb449b1cc9121a4e9fc31afc388","d68545e66a7069e16d69c63c08d80953367499de9521f8de64fc49d5c3f51a53","13f0cf16a6115de55ba72fc18dec46a5009eb4c0ab46c4ecf68fbf4afd620fb4","808e53d33c6123d88b6cc10b5df4099cf770bc9d9f185d5f3427c8f16252b1ad","695d4e2a3f244f56401311f5940dfe45ffa778bf62909917f9b1b5d032b5dd44"],"paragraph_range_zero_based":[44232,44255],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p44232"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        c1                                  CHOICE{","paragraph_zero_based":44256},{"literal_text_all_w_t_and_m_t":"            rrcConnectionReconfiguration-r8     RRCConnectionReconfiguration-r8-IEs,","paragraph_zero_based":44257},{"literal_text_all_w_t_and_m_t":"            spare3 NULL, spare2 NULL, spare1 NULL","paragraph_zero_based":44258},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":44259},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture            SEQUENCE {}","paragraph_zero_based":44260},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":44261},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44262},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44263},{"literal_text_all_w_t_and_m_t":"RRCConnectionReconfiguration-r8-IEs ::= SEQUENCE {","paragraph_zero_based":44264},{"literal_text_all_w_t_and_m_t":"    -- Enter the IEs here.","paragraph_zero_based":44265},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":44266},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44267},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44268},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44269},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44270},{"literal_text_all_w_t_and_m_t":"Hooks for critical and non-critical extension should normally be included in the PDU type specification. How these hooks are used is further described in clause A.4.","paragraph_zero_based":44271},{"literal_text_all_w_t_and_m_t":"Critical extensions are characterised by a redefinition of the PDU contents and need to be governed by a mechanism for protocol version agreement between the encoder and the decoder of the PDU, such that the encoder is prevented from sending a critically extended version of the PDU type, which is not comprehended by the decoder.","paragraph_zero_based":44272},{"literal_text_all_w_t_and_m_t":"Critical extension of a PDU type is facilitated by a two-level CHOICE structure, where the alternative PDU contents are alternatives within the inner level c1 CHOICE. Spare alternatives (i.e., spare3 down to spare1 in this case) may be included within the c1 CHOICE. The number of spare alternatives to be included in the original PDU specification should be decided case by case, based on the expected rate of critical extension in the future releases of the protocol.","paragraph_zero_based":44273},{"literal_text_all_w_t_and_m_t":"Further critical extension, when the spare alternatives from the original specifications are used up, is facilitated using the criticalExtensionsFuture in the outer level CHOICE.","paragraph_zero_based":44274},{"literal_text_all_w_t_and_m_t":"In PDU types where critical extension is not expected in the future releases of the protocol, the inner level c1 CHOICE and the spare alternatives may be excluded, as shown in the example below.","paragraph_zero_based":44275},{"literal_text_all_w_t_and_m_t":"-- /example/ ASN1START","paragraph_zero_based":44276},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44277},{"literal_text_all_w_t_and_m_t":"RRCConnectionReconfigurationComplete ::= SEQUENCE {","paragraph_zero_based":44278},{"literal_text_all_w_t_and_m_t":"    rrc-TransactionIdentifier           RRC-TransactionIdentifier,","paragraph_zero_based":44279}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["efc3fe11f62f02836dd324c77077a56bdaebfa4538662de3bde5a761823838c2","f98a52b597799b726461c3665e7256e887b5ae4db3a1ce48e1bee73ac69cfed5","d37261cbd6b1ffe972cdc7328afda25f7ad7043717690515e049123661102032","b0401675877b6d532ed50d19ce95b77800d3a12c69edc9ea26fb8fc5c015ccc1","5c580915e9aa5f84b10148b8765e45a6aa6beda972fb715d4497f49fc396c768","b6bbf3818feee5ee169d784cc45887ae4462a4332199caf893feded8dbb8086e","37e7841da06973c16617cd8956af7b60ca1c2ed5865c12206c51e64efcf44dde","1eec38116784078fd19e19ca2592e6b4b39f80a8fb57d24ee94cb882cdf4fbd2","8c92001058d696663a8212477f39af465da808c611554e0afd7514b1b7ac1eee","5b6f1b6fd5f788dd14de71d1e2f5b601b895b7137fd04e3f56e5aaa24ebc0031","2a8e59b65c3b59d99a521f57a08dd84379ededea588a9aeccc44f293f3084aa3","f46c8a385ee162494dbb73dc209b21de5256b019662e1a823e147e3077fdc4de","c960d80fcc68bc06b0041205f711695250ab12b19fd71d5cdfc8a0fa13f27d5a","c51969f54641b41fae726e807038b5b4f99282ded3e652d0b9309c3b62b4b903","4ba16c4c79acccb2ec35b57d4068c069a85d9f3e37c0d1c3e15e37a724d0a78e","2b68c6e09ac78d077652a0443178cffab5cd78da18c98295be5bffb37c159afa","d0cce9a3dffda58b76770b23c95b57b0b7cc8c763f88ddf21b6df53ad8ce9b3d","ca7c6a574032f62a768e200ddda2eb6385b697692cc5b1308e29506c0999d3c5","37da486355530831a72b197fa2e6d8c64f48a56d444a691a638e6e92e8d99b81","fab065aaef2cf363c9ba0e6729935200f6f949b15fab6e3057ef24b2a788c7b9","11aabb48e92b60d9039a0b432ef4e903bf7ba2d9e4f7e2c6647ebeb7565584d7","b1787bbbfa3a741aad113e74356d1c1e7f40d2f2ed1eb53e3a8c655dc3047301","0036cd5b93bf8bc8bbb5dc2be82f0719d141c8c4d78cb5f229e3f20bd5275b73","ecc16d42f4ad0d1e754eaafa5dcaba3398e8b29a1f69b1ea8e5f5e404009d366"],"paragraph_range_zero_based":[44256,44279],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p44256"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    criticalExtensions                  CHOICE {","paragraph_zero_based":44280},{"literal_text_all_w_t_and_m_t":"        rrcConnectionReconfigurationComplete-r8","paragraph_zero_based":44281},{"literal_text_all_w_t_and_m_t":"                                            RRCConnectionReconfigurationComplete-r8-IEs,","paragraph_zero_based":44282},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture            SEQUENCE {}","paragraph_zero_based":44283},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":44284},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44285},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44286},{"literal_text_all_w_t_and_m_t":"RRCConnectionReconfigurationComplete-r8-IEs ::= SEQUENCE {","paragraph_zero_based":44287},{"literal_text_all_w_t_and_m_t":"    -- Enter the fields here.","paragraph_zero_based":44288},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":44289},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44290},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44291},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44292},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44293},{"literal_text_all_w_t_and_m_t":"Non-critical extensions are characterised by the addition of new information to the original specification of the PDU type. If not comprehended, a non-critical extension may be skipped by the decoder, whilst the decoder is still able to complete the decoding of the comprehended parts of the PDU contents.","paragraph_zero_based":44294},{"literal_text_all_w_t_and_m_t":"Non-critical extensions at locations other than the end of the message or other than at the end of a field contained in a BIT or OCTET STRING are facilitated by use of the ASN.1 extension marker \"...\". The original specification of a PDU type should normally include the extension marker at the end of the sequence of information elements contained.","paragraph_zero_based":44295},{"literal_text_all_w_t_and_m_t":"Non-critical extensions at the end of the message or at the end of a field that is contained in a BIT or OCTET STRING may be facilitated by use of an empty sequence that is marked OPTIONAL e.g. as shown in the following example:","paragraph_zero_based":44296},{"literal_text_all_w_t_and_m_t":"-- /example/ ASN1START","paragraph_zero_based":44297},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44298},{"literal_text_all_w_t_and_m_t":"RRCMessage-r8-IEs ::=                   SEQUENCE {","paragraph_zero_based":44299},{"literal_text_all_w_t_and_m_t":"    field1                                  InformationElement1,","paragraph_zero_based":44300},{"literal_text_all_w_t_and_m_t":"    field2                                  InformationElement2,","paragraph_zero_based":44301},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44302},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                    SEQUENCE {}                     OPTIONAL","paragraph_zero_based":44303}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["11c1f16e134d93bd1e4921aeacf14af5adc6a3c427025b0a346b6e36c78600f8","555203c3a0f9f6e340d6fe2ad3fe9fd2e8b87de4cbca60718ebd9f57e3140506","d6e0c9b3db3eb6061e59224fc493ada014986dda8197065da0869a13f431d0f2","7b8401a56fd79f4ec55a7dd1e901a01fa3d52224d925fd5ccd4be3e4baf1b9cb","51137dd4c1cff4e9f0eabb03c52640f9269dfc359ea43619111c017a4d4979cd","25b273879c08f0b74028d6b1abc315ed0f7aad27339d32c00d0f3ee0af3d64f0","32873f941d1d8d14b234b5a9504805484903bcb8542fce8c9cb232d924c0de16","a28a39ff92170e70845106f55555a926a3f7e66227bf7c40770f7ec2d61eb0f2","212f5f28d851a5797f6326bebd111f77b6ec0e70617ed1961c506dac5503f2b7","ed3605c87a11a1826fdea3a72ba224b0d39632bd1fbf4e9ed7b12f716e91ccb9","cff0e213487479d01ea46a0985ffe553869a90e206d56c6de84c5bc3f5525034","7bea46fe27bcba4627a2da3d87ad7f5b59f753098b0293fb762c9f5759bc167b","4139f4976be5ecfd2e7003dc0f9a80b5c8068986319c3dfd73502450fa08473d","139d23c0571dbfe2443e0d7faa0520c411ac4e752a7cb29e8f19081c0664ebc1","5f244f8ae67be6072130f47d2768c4b0613946cbe79b2235ca54d2754fe6334a","b1c13b0d5696035a79b811600ac87750c81e3160710767c4c47e236223ecd656","0a96f0717d9f4af0d26a30bf4ba05d4bdae48c99978095e93bfc0b463d7d4b23","6fc0769ac272925bc292294db6e2937a3b264cc2bfd6d3cb871ba7fc75e0a816","38a9dc7e2eb56836157f86e81431601c20fbb911a521878e28ac136afb0a5695","ae54a7ea9bb57d25935f7d2a41a5f1940ea7982fd0fdb84cab1834999cf32eac","a44280bb473e4c132a86369c0611922f28e40d0b6e5946aeb34ceda861d64301","776a1358be049dc8c2db73d9b0825dd4a82d60bf4bb310e14f95636d634ea69d","632d6cac3cef2d32485bac9e84f8b826c4b7908559f8bee814986fb3b3cd3331","109661db1945288082a55196e0b46314e122ea1fef564e4e9f2d41de0c37c745"],"paragraph_range_zero_based":[44280,44303],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p44280"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44304},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44305},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44306},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44307},{"literal_text_all_w_t_and_m_t":"The ASN.1 clause specifying the contents of a PDU type may be followed by a field description table where a further description of, e.g., the semantic properties of the fields may be included. The general format of this table is shown in the example below. The field description table is absent in case there are no fields for which further description needs to be provided e.g. because the PDU does not include any fields, or because an IE is defined for each field while there is nothing specific regarding the use of this IE that needs to be specified.","paragraph_zero_based":44308},{"literal_text_all_w_t_and_m_t":"%PDU-TypeIdentifier% field descriptions","paragraph_zero_based":44309},{"literal_text_all_w_t_and_m_t":"%field identifier%","paragraph_zero_based":44310},{"literal_text_all_w_t_and_m_t":"Field description.","paragraph_zero_based":44311},{"literal_text_all_w_t_and_m_t":"%field identifier%","paragraph_zero_based":44312},{"literal_text_all_w_t_and_m_t":"Field description.","paragraph_zero_based":44313},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44314},{"literal_text_all_w_t_and_m_t":"The field description table has one column. The header row shall contain the ASN.1 type identifier of the PDU type.","paragraph_zero_based":44315},{"literal_text_all_w_t_and_m_t":"The following rows are used to provide field descriptions. Each row shall include a first paragraph with a field identifier (in bold and italic font style) referring to the part of the PDU to which it applies. The following paragraphs at the same row may include (in regular font style), e.g., semantic description, references to other specifications and/or specification of value units, which are relevant for the particular part of the PDU.","paragraph_zero_based":44316},{"literal_text_all_w_t_and_m_t":"The parts of the PDU contents that do not require a field description shall be omitted from the field description table.","paragraph_zero_based":44317},{"literal_text_all_w_t_and_m_t":"A.3.4Information elements","paragraph_zero_based":44318},{"literal_text_all_w_t_and_m_t":"Each IE (information element) type is specified in an ASN.1 clause similar to the one shown in the example below.","paragraph_zero_based":44319},{"literal_text_all_w_t_and_m_t":"-- /example/ ASN1START","paragraph_zero_based":44320},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44321},{"literal_text_all_w_t_and_m_t":"PRACH-ConfigSIB ::=                 SEQUENCE {","paragraph_zero_based":44322},{"literal_text_all_w_t_and_m_t":"    rootSequenceIndex                   INTEGER (0..1023),","paragraph_zero_based":44323},{"literal_text_all_w_t_and_m_t":"    prach-ConfigInfo                    PRACH-ConfigInfo","paragraph_zero_based":44324},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44325},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44326},{"literal_text_all_w_t_and_m_t":"PRACH-Config ::=                    SEQUENCE {","paragraph_zero_based":44327}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["3151fb73b8ecfe5efb96c3751bae5040f9f7fd83ea4df33604f84d539fd4beb2","0a17902ee24eaa77124628c69b6e1eed36d098004c2bee157e267e0c0741fcba","8b84202348dda14c68d4b28788eceb72e5bcec4fa402ad015f6301bad5b6abe4","9f656bdeca5cee41510790d0622ea3f130e2b58db63a0c061f82b7c183010e29","82704895c735c7c1fd34c2fc329f666504479485a538727210c495bf63e74023","3119604c4b26a8888ae2eedc422cfa79338f1037be7130bb96867a843f680fdc","e16efad8969b598edc9d211f9c59f27dc5bd18af3ffca88664cebfca41ef44de","ccda70e0bbbd8b4a52edb703f7ebe9ce1ebb14c5d5ef6e3efa5441862c5fd915","9262733a6e0d90533a4b07a9e5df2927908e3eff22c2421546a8273672c3189a","cb8a37d68ed047ad2be40ce36314737b873271742e2f40e7a60999c7b88a49f1","14a4ec64797a7313c2d8e93506ffa5483ca8f992477f84bc4e98633842306e61","19b6eeec72a002298a7fb2a4accd717036cfd052831822f509a43dc9344aad50","8ac0bed1bfeb909ee9d02b995dd3488a73e619bb5f417bea2a268e848b32edaa","e8e5571e20c5b4326ab919d7a703a49cacf75ec65d76323ffd71c193289362b0","5e9a8df23fab8959bb576d6adb73cc8a8fa5d9c8b35a1021b2450678ab900b5a","7a04ff36f4e4f631ad26c63c6f7920e1378157f136f535895050fa28f1f7cfb5","ffb62a59cca1ea9a15195b496dafea9c0af17638e73424f1dc7dac7b1c411f57","a5dce2e1cd768529a46262bd9f7d92415421f67e690e0669a23425945ef9788d","7f4c5369fb0fc0ac9cda23acc1f2c99bec428a32c3b5d2ddb5e68817512578be","1db83e154fc9ccdc40403134d92fe6a368ad86606f7c9d7094b41bb4e64adc53","d92d3f661e81c4971b8ade69756a5c4cdaa30b0b82891bb165b1a1175cb78b0e","7d0895a5e798d7d994e348a1dee216657fec7cfac6e3115ef412452842c38ba9","ee3df3567802d5a953a6bed10ce1f15d35df8289c9e007496f3f96cfdabac99a","58b47f513762e321b7c85ff2051c2a43e6aa298306352647d1032ce2978979dd"],"paragraph_range_zero_based":[44304,44327],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p44304"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    rootSequenceIndex                   INTEGER (0..1023),","paragraph_zero_based":44328},{"literal_text_all_w_t_and_m_t":"    prach-ConfigInfo                    PRACH-ConfigInfo                    OPTIONAL    -- Need N","paragraph_zero_based":44329},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44330},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44331},{"literal_text_all_w_t_and_m_t":"PRACH-ConfigInfo ::=                SEQUENCE {","paragraph_zero_based":44332},{"literal_text_all_w_t_and_m_t":"    prach-ConfigIndex                   ENUMERATED {ffs},","paragraph_zero_based":44333},{"literal_text_all_w_t_and_m_t":"    highSpeedFlag                       ENUMERATED {ffs},","paragraph_zero_based":44334},{"literal_text_all_w_t_and_m_t":"    zeroCorrelationZoneConfig           ENUMERATED {ffs}","paragraph_zero_based":44335},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44336},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44337},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44338},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44339},{"literal_text_all_w_t_and_m_t":"IEs should be introduced whenever there are multiple fields for which the same set of values apply. IEs may also be defined for other reasons e.g. to break down a ASN.1 definition in to smaller pieces.","paragraph_zero_based":44340},{"literal_text_all_w_t_and_m_t":"A group of closely related IE type definitions, like the IEs PRACH-ConfigSIB and PRACH-Config in this example, are preferably placed together in a common ASN.1 clause. The IE type identifiers should in this case have a common base, defined as the generic type identifier. It may be complemented by a suffix to distinguish the different variants. The \"PRACH-Config\" is the generic type identifier in this example, and the \"SIB\" suffix is added to distinguish the variant. The clause heading and generic references to a group of closely related IEs defined in this way should use the generic type identifier.","paragraph_zero_based":44341},{"literal_text_all_w_t_and_m_t":"The same principle should apply if a new version, or an extension version, of an existing IE is created for critical or non-critical extension of the protocol (see clause A.4). The new version, or the extension version, of the IE is included in the same ASN.1 clause defining the original. A suffix is added to the type identifier, using the naming conventions defined in clause A.3.1.2, indicating the release or version of the where the new version, or extension version, was introduced.","paragraph_zero_based":44342},{"literal_text_all_w_t_and_m_t":"Local IE type definitions, like the IE PRACH-ConfigInfo in the example above, may be included in the ASN.1 clause and be referenced in the other IE types defined in the same ASN.1 clause. The use of locally defined IE types should be encouraged, as a tool to break up large and complex IE type definitions. It can improve the readability of the code. There may also be a benefit for the software implementation of the protocol end-points, as these IE types are typically provided by the ASN.1 compiler as independent data elements, to be used in the software implementation.","paragraph_zero_based":44343},{"literal_text_all_w_t_and_m_t":"An IE type defined in a local context, like the IE PRACH-ConfigInfo, should not be referenced directly from other ASN.1 clauses in the RRC specification. An IE type which is referenced in more than one ASN.1 clause should be defined in a separate clause, with a separate heading and a separate ASN.1 clause (possibly as one in a set of closely related IE types, like the IEs PRACH-ConfigSIB and PRACH-Config in the example above). Such IE types are also referred to as 'global IEs'.","paragraph_zero_based":44344},{"literal_text_all_w_t_and_m_t":"NOTE:Referring to an IE type, that is defined as a local IE type in the context of another ASN.1 clause, does not generate an ASN.1 compilation error. Nevertheless, using a locally defined IE type in that way makes the IE type definition difficult to find, as it would not be visible at an outline level of the specification. It should be avoided.","paragraph_zero_based":44345},{"literal_text_all_w_t_and_m_t":"The ASN.1 clause specifying the contents of one or more IE types, like in the example above, may be followed by a field description table, where a further description of, e.g., the semantic properties of the fields of the information elements may be included. This table may be absent, similar as indicated in clause A.3.3 for the specification of the PDU type. The general format of the field description table is the same as shown in clause A.3.3 for the specification of the PDU type.","paragraph_zero_based":44346},{"literal_text_all_w_t_and_m_t":"A.3.5Fields with optional presence","paragraph_zero_based":44347},{"literal_text_all_w_t_and_m_t":"A field with optional presence may be declared with the keyword DEFAULT. It identifies a default value to be assumed, if the sender does not include a value for that field in the encoding:","paragraph_zero_based":44348},{"literal_text_all_w_t_and_m_t":"-- /example/ ASN1START","paragraph_zero_based":44349},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44350},{"literal_text_all_w_t_and_m_t":"PreambleInfo ::=                    SEQUENCE {","paragraph_zero_based":44351}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["abb4ac8bff8d7ccc91f1717626d5d5758cc5991e8a9b2df545149dbdfd5d2005","bbc38d0bc43f95b0667bae6f3740e308d93ae6b71a05c4d170da1c896d962b7d","9341725951e3dd1f84f7bb6b2535cd428a14bd3b094c66e1dafc86adeeac9584","7b47ed1df316755680c83ebbfa9782e92cf1c5bb20aa3ab1964e2fb6a3d01224","e1189f7d33804b3fcaf8ab7dbb31bda8a252ecfd2c95ee874bcad04c9cce0b85","0e033c1a5a05c5b70c69fa56c0107c3c2a367d61ae03ae58da22b0e6a1779318","e3b04fc9da415a036f13c7c6d5a7bcffbc4f7e888a2f0cb00086b6129659854d","f1ee68e635b34b93106e8e653f7692fc6dcef3e833ad993d153947b8cbd9f7c6","03fce4ba3d6f0f8d15a0610d9148832f9dabb3e9c588d92c459dcb66326a8b55","7945be76befbcb543e39d6b08307f748530024f1b0912fdcb4a0bb29bf1f756d","d5cd082dcb76ec2333007593bcb139572494be8beca00e51658332249abfbac5","d2f12b90c7406744205006c6a16190663e914e2f7b584497a4903b3bfae0c04d","163a049225d7409367ac2c6cd701825f1e0241f9cbcb43ec0eda3effe5322817","d287d157f5db72989fbbfef7acfcc81dc0410a1a2f0ace85c4579362823ef547","3e8c75ea6e71913e3009f5499962680cb4b802eccbe37c1c9a9e3c66b59bddad","9df16a3614c68afdfa90042b3c78179cbbfb1b266a7cf5e44d2d2f79e53357e1","d35fcd3d9881e645e38f679705fc73ab451d44ed5c98e69a29d4de2e52327798","42528826218e1b1f4960e595dd438dd23a6cefb79034d11e3e092baab5b462a9","b46c86f920370106dfdeedb215108997d2647cfb1eb0c2ec2e2310d7a53bff22","edeec86d703034511b7ff59d8717ed666ee702f46d4ea82ce4f4f1a625d2340c","a6b4333af6e3bf08f3f372a02383e2ceb1ae3f80255ab209830026b9069e2e30","98265757056e9a14dcdf85eb311acdb946c96b48ecba74fb245a01206011feb0","ac9c266f7afa449c8ca9491016bc542ef661258094b7345090149690c08180a8","0082c26ddab285a78f28b811a760e251fe3a46bc5d79d9c5a08ca0d3eb0c39a9"],"paragraph_range_zero_based":[44328,44351],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p44328"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    numberOfRA-Preambles                INTEGER (1..64)                     DEFAULT 1,","paragraph_zero_based":44352},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":44353},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44354},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44355},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44356},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44357},{"literal_text_all_w_t_and_m_t":"Alternatively, a field with optional presence may be declared with the keyword OPTIONAL. It identifies a field for which a value can be omitted. The omission carries semantics, which is different from any normal value of the field:","paragraph_zero_based":44358},{"literal_text_all_w_t_and_m_t":"-- /example/ ASN1START","paragraph_zero_based":44359},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44360},{"literal_text_all_w_t_and_m_t":"PRACH-Config ::=                    SEQUENCE {","paragraph_zero_based":44361},{"literal_text_all_w_t_and_m_t":"    rootSequenceIndex                   INTEGER (0..1023),","paragraph_zero_based":44362},{"literal_text_all_w_t_and_m_t":"    prach-ConfigInfo                    PRACH-ConfigInfo                    OPTIONAL    -- Need N","paragraph_zero_based":44363},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44364},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44365},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44366},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44367},{"literal_text_all_w_t_and_m_t":"The semantics of an optionally present field, in the case it is omitted, should be indicated at the end of the paragraph including the keyword OPTIONAL, using a short comment text with a need code. The need code includes the keyword \"Need\", followed by one of the predefined semantics tags (S, M, N or R) defined in clause 6.1. If the semantics tag S is used, the semantics of the absent field are further specified either in the field description table following the ASN.1 clause, or in procedure text.","paragraph_zero_based":44368},{"literal_text_all_w_t_and_m_t":"The addition of OPTIONAL keywords for capability groups is based on the following guideline. If there is more than one field in the lower level IE, then OPTIONAL keyword is added at the group level. If there is only one field in the lower level IE, OPTIONAL keyword is not added at the group level.","paragraph_zero_based":44369},{"literal_text_all_w_t_and_m_t":"A.3.6Fields with conditional presence","paragraph_zero_based":44370},{"literal_text_all_w_t_and_m_t":"A field with conditional presence is declared with the keyword OPTIONAL. In addition, a short comment text shall be included at the end of the paragraph including the keyword OPTIONAL. The comment text includes the keyword \"Cond\", followed by a condition tag associated with the field (\"UL\" in this example):","paragraph_zero_based":44371},{"literal_text_all_w_t_and_m_t":"-- /example/ ASN1START","paragraph_zero_based":44372},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44373},{"literal_text_all_w_t_and_m_t":"LogicalChannelConfig ::=            SEQUENCE {","paragraph_zero_based":44374},{"literal_text_all_w_t_and_m_t":"    ul-SpecificParameters               SEQUENCE {","paragraph_zero_based":44375}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["15fe348046ecedb029a325666d28b9cd9f6e41d9ca5236955adbbcd1b45147e8","a28aa349c0274678edbadc53a254fd3f9ba7cadeb2b86a9b4871f5419d7d4535","8940d75d5420cf8a8cf32bf0dff0912a8807fab1d4d35f93d8fdb72e93c777d0","d6d340a56d8bbd0e27e469dbb79e6d5e039527a3b3acdcb5321d1d2c2f77740f","673a06abbb18adfb1eabc63fc538339c692a97a5ec294d0bbdfe20886ff089d7","d74b20bee971fe75afd5c55070df236c696eaa712d3d554e40d5bfa43a4e85ac","8a52d034c8edf93d077e5004fe150140fb57bc34bb6266758cf587a005a7f9e6","e8b12834e8559dc84ca254d4cc3935ab8f2c3bd81cef8c8407e5edf3b2d84899","2252c796fb5f3c7637d137e84c291bd9c4ddad7b8eef65858ef23b955c66bbf2","068878791f2d0b9b03d57e67bddd428390a2b628df1d45b37b776d254f0a7cb5","760b8b4eb4f13021bacef4bdcfe6a2d3f63d8cc5257322f0b7085f7db4ec78f5","737e62251cb5e1c1c5594f91c36d992183f09509be8060e8f7fdc7953347f4d6","7ec82cf9c40d06328b50f9e877870f3bc6fdd1243fe15b02938188d8a5d948db","6dea8b9b46fa3198b0fa7a6170479f67bade288d36d5e13f2579cca49d2db719","f2cb82224c7b00a8aad4797e8c28f72b859294f2143dd3d759e7fb0104ddce7d","a828ba9becf669e2baf5085b7acba3c448980c308f8b75d8d05278c3c23f4c44","c76f7aaabd31a03b60b2f1ca52e7b92e298c583a8df278267672200fab6447b9","07f379fb269f159127f6b29bd6490387d263fe1cdc3c8b3dfcc7d315d745461d","2ec5184eafacf75c22a15b3f934d8f4718fa8675581f4166299394299e7867e9","8b9ff881d7e2f9ba27d6adbc7e19ef176722cba8e3cddfc9f4b8a682f5ef3471","59337053acd3746bb5325122d2aeffb1fc764cde947dc0ba10a959b83886395f","a1d4094d66d6deeeb3bfbe95796aa50146d1524288eda0284aa1d2ff56823013","9b8c64956655bd735c6c24487410389a5b0d19f03b9da738e06c9452c4455a1d","2457a0a6e30f43e46ccb51c96e3fe3e1dc4e56f46cc8ad2f6242484ea59d1257"],"paragraph_range_zero_based":[44352,44375],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p44352"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        priority                            INTEGER (0),","paragraph_zero_based":44376},{"literal_text_all_w_t_and_m_t":"        ...","paragraph_zero_based":44377},{"literal_text_all_w_t_and_m_t":"    }       OPTIONAL                                                                    -- Cond UL","paragraph_zero_based":44378},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44379},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44380},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44381},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44382},{"literal_text_all_w_t_and_m_t":"When conditionally present fields are included in an ASN.1 clause, the field description table after the ASN.1 clause shall be followed by a conditional presence table. The conditional presence table specifies the conditions for including the fields with conditional presence in the particular ASN.1 clause.","paragraph_zero_based":44383},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":44384},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":44385},{"literal_text_all_w_t_and_m_t":"UL","paragraph_zero_based":44386},{"literal_text_all_w_t_and_m_t":"Specification of the conditions for including the field associated with the condition tag = \"UL\". Semantics in case of optional presence under certain conditions may also be specified.","paragraph_zero_based":44387},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44388},{"literal_text_all_w_t_and_m_t":"The conditional presence table has two columns. The first column (heading: \"Conditional presence\") contains the condition tag (in italic font style), which links the fields with a condition tag in the ASN.1 clause to an entry in the table. The second column (heading: \"Explanation\") contains a text specification of the conditions and requirements for the presence of the field. The second column may also include semantics, in case of an optional presence of the field, under certain conditions i.e. using the same predefined tags as defined for optional fields in A.3.5.","paragraph_zero_based":44389},{"literal_text_all_w_t_and_m_t":"Conditional presence should primarily be used when presence of a field depends on the presence and/or value of other fields within the same message. If the presence of a field depends on whether another feature/function has been configured, while this function can be configured independently e.g. by another message and/or at another point in time, the relation is best reflected by means of a statement in the field description table.","paragraph_zero_based":44390},{"literal_text_all_w_t_and_m_t":"If the ASN.1 clause does not include any fields with conditional presence, the conditional presence table shall not be included.","paragraph_zero_based":44391},{"literal_text_all_w_t_and_m_t":"Whenever a field is only applicable in specific cases e.g. TDD, use of conditional presence should be considered.","paragraph_zero_based":44392},{"literal_text_all_w_t_and_m_t":"A.3.7Guidelines on use of lists with elements of SEQUENCE type","paragraph_zero_based":44393},{"literal_text_all_w_t_and_m_t":"Where an information element has the form of a list (the SEQUENCE OF construct in ASN.1) with the type of the list elements being a SEQUENCE data type, an information element shall be defined for the list elements even if it would not otherwise be needed.","paragraph_zero_based":44394},{"literal_text_all_w_t_and_m_t":"For example, a list of PLMN identities with reservation flags is defined as in the following example:","paragraph_zero_based":44395},{"literal_text_all_w_t_and_m_t":"-- /example/ ASN1START","paragraph_zero_based":44396},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44397},{"literal_text_all_w_t_and_m_t":"PLMN-IdentityInfoList ::=           SEQUENCE (SIZE (1..6)) OF PLMN-IdentityInfo","paragraph_zero_based":44398},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44399}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["6735d556870bdfcf6c846cea63ed1458ab64dde1822162ea94d74265a031e81c","739092c55c9eb8731c1896faf429776e8c868f0b0dea84e4c6c6decdef76199d","a8350dc45d6e56a6f503cc255939627a4e1734b5215c9fa016858aef55f61bb1","f575124789e21ba0eed0d39bbcb7132c13a4a3bb279aafd51e9cc3d706dcdaa8","0e2c856cc1736f3ed00fe0f1f96007f446ea6852a98316f0620733fff8dec4af","88a66df0e8252083fd9296eedde19ef3e69b1c8a41c899f3c385762d5216bd0f","40cfdd442cc6c1fb59c127302004bd1f1ae16b17051ae5bed5365b83ee78ef6c","85ad3b3e4d7694a1c64000c74d820489cafd5b95a44c45ce6e8a7f36daed743f","e4d5d8c921ef869f634301488b0f1ad0d2b1df5751d8ea773280595f3abe257a","e42cae636ff16d34a552e5627d58a54bb2f925a2345b19af96d8a15a9a00a16b","e6a171d2f24ead698dc75f1c571653f3db5505a2f660d36bcbc60accff084d0d","f6336c334b9a9776b6476ece9f51cd3f2de7087d07e160530c19a104ddcc3df0","ddeb60a5624ba43fff8c458e6faa34dacb9137d6495d67b35dbc2e0652f452e6","5fa7332787f060e9990d4047f36577a2fe8c4b41b4ce0c6084a2f33ee2b8f07a","535a2aa881ba92c9358ab408a14de8e94e9860c34434d2d10270aa2470d4347e","995dc907af60ade107cda1bb0475525895aee753876ef8e5f14e40bbdc1737b8","b16b12b75e6ce79999d9d5f10e4bfdff74067e4235446a3ec880d8f63367b6d0","c0ff438ef49bf672ee83dac974c6954b02115500ae1897f0e1b122c6af328b1f","5ccffab2f78c76980ad3987ab1d79b13ba5d2ff2bf9e6c2d019455fe88ca62dd","a35e6fcf6766efa4c6fea9b960d4689b15e05dbef00ccb3e3f29578a70464819","4ea04e6b8233a1047d48aa86be0b5d9fb3bfd5b9c26ae0d691ea73f71a848f74","4d3ef18fc7fe166a7977cd24aa31d0dc46d42a8603510072146c55bf53b133d5","a50a82d10f7fac10ca25824bcd32139621b7fab1ff996a705069332d24511587","4e8fb0c719888d32a1b9cdbc72d95ab6b12a5d76bd69a8d7523dc3fc137d5fa3"],"paragraph_range_zero_based":[44376,44399],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p44376"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"PLMN-IdentityInfo ::=               SEQUENCE {","paragraph_zero_based":44400},{"literal_text_all_w_t_and_m_t":"    plmn-Identity                       PLMN-Identity,","paragraph_zero_based":44401},{"literal_text_all_w_t_and_m_t":"    cellReservedForOperatorUse          ENUMERATED {reserved, notReserved}","paragraph_zero_based":44402},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44403},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44404},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44405},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44406},{"literal_text_all_w_t_and_m_t":"rather than as in the following (bad) example, which may cause generated code to contain types with unpredictable names:","paragraph_zero_based":44407},{"literal_text_all_w_t_and_m_t":"-- /bad example/ ASN1START","paragraph_zero_based":44408},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44409},{"literal_text_all_w_t_and_m_t":"PLMN-IdentityList ::=                   SEQUENCE (SIZE (1..6)) OF SEQUENCE {","paragraph_zero_based":44410},{"literal_text_all_w_t_and_m_t":"    plmn-Identity                           PLMN-Identity,","paragraph_zero_based":44411},{"literal_text_all_w_t_and_m_t":"    cellReservedForOperatorUse              ENUMERATED {reserved, notReserved}","paragraph_zero_based":44412},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44413},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44414},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44415},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44416},{"literal_text_all_w_t_and_m_t":"A.3.8Guidelines on use of parameterised SetupRelease type","paragraph_zero_based":44417},{"literal_text_all_w_t_and_m_t":"The usage of the parameterised SetupRelease type is like a function call in programming languages where the element type parameter is passed as a parameter. The parameterised type only implies a textual change in abstract syntax where all references to the parameterised type are replaced by the compiler with the release/setup choice. Two examples of the usage are shown below:","paragraph_zero_based":44418},{"literal_text_all_w_t_and_m_t":"-- /example/ ASN1START","paragraph_zero_based":44419},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44420},{"literal_text_all_w_t_and_m_t":"RRCMessage-rX-IEs ::= SEQUENCE {","paragraph_zero_based":44421},{"literal_text_all_w_t_and_m_t":"    field-rX               SetupRelease { IE-rX }                   OPTIONAL,      --  Need M","paragraph_zero_based":44422},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":44423}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["5d0c591bc62ea7dbdf8e356e828ba4610ef3f1a563a1d4cd62290db2506d288b","c8a4b5d8fc4f0064def91cc980f2093f138c34d2ea1c18a0c49adf943e88ecc3","8667b66391ad36de02381a51b3010bb644a64f28bffcd90bdf77629adc83de87","cfef7a52baccbc63e9227d9549708055d78835231208f6184dc34b67c754bb80","dfdaeb82410ff59f88cb5c21493603b4e300949e9db12629d131e24bb0f4b6b9","947a7fc72fee51ba032554df68cf5f2cf8fa0775bc95124f9064e1a5d0d3f3a0","057d734bfb8c3dd53f3a81a99b2ffa884ae0a742a0ebd14f4cfc0bbbfc983aa7","8c58b036a4b41f5506311fdbb7c0698de6566baa8bced9d18cbce3ed868eab6a","585abecf1b1af43018383c277255f7590ee695f4680cc9466fe9e2a077e26806","0c34d4d399cb7b4d017330c22faf77138ed7599818b763f4609c792a3af71077","87ddc4f611dd1ce3bebcb6eed0b36fe6f0df37a20979b52bedf2183e5e973c97","5902d28b022316b7fc239688d965ec48ff2a6d727ca1e2be75a211eaee9987e3","fa57149f9c2c350298760a166d14b345ac957ab9722559e7c472ae71c05a5ad2","5107cadd238bb32fb603892061c86601974a1ad2bfdb4097ae54f723b2a3d198","04b9ee0ed17bd9e2303d80d9631720e9accafb946a043967c88e89507e8acf2b","ac238908585682ef427b937986ac719546fc87a31c3392dc4a39cfabef13c4eb","b817fbdafa5d16df797dd119c9b4a72a7a7c98c9b7b48701ddc4048a743ffd4e","fc045a0e64865a636a5461f4ba4515310bbf5c3b7f7afa6b8efbccd64ea80a67","0d436efd4e90968f7d897dc5c69163e1212bf19475bc15f50c26a401ee8612b1","a6561e4a96139f2cd9fe203ad800c5ee55c992bdcb53d0a79de22c2d7baa4711","0279207d5be4fc720a8819a6f0a275dc8ab6ab82b9ffc185c5b55b95d7733aa8","c2da81a89449e6d50c70c83075c96d454cd2c6481057aa66ddd2c3b5ad29e0b8","b88fe804723e4bb93e8b46529c11d7c6790f2ea94adeb426eec29f83b8aa4f90","c1099e7e9e6f1121c92ba80d5ce6dc14553726574bda2ac20d384c1fa7465860"],"paragraph_range_zero_based":[44400,44423],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p44400"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44424},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44425},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44426},{"literal_text_all_w_t_and_m_t":"RRCMessage-rX-IEs ::= SEQUENCE {","paragraph_zero_based":44427},{"literal_text_all_w_t_and_m_t":"    field-rX               SetupRelease { Element-rX }","paragraph_zero_based":44428},{"literal_text_all_w_t_and_m_t":"}                                                                   OPTIONAL,       -- Need M","paragraph_zero_based":44429},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44430},{"literal_text_all_w_t_and_m_t":"Element-rX ::= SEQUENCE {","paragraph_zero_based":44431},{"literal_text_all_w_t_and_m_t":"    field1-rX                  IE1-rX,","paragraph_zero_based":44432},{"literal_text_all_w_t_and_m_t":"    field2-rX                  IE2-rX                               OPTIONAL        -- Need N","paragraph_zero_based":44433},{"literal_text_all_w_t_and_m_t":"}                                                                       OPTIONAL,   -- Need M","paragraph_zero_based":44434},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44435},{"literal_text_all_w_t_and_m_t":"-- /example/ ASN1STOP","paragraph_zero_based":44436},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44437},{"literal_text_all_w_t_and_m_t":"The SetupRelease is always be used with only named IEs, i.e. the example below is not allowed:","paragraph_zero_based":44438},{"literal_text_all_w_t_and_m_t":"-- /example/ ASN1START","paragraph_zero_based":44439},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44440},{"literal_text_all_w_t_and_m_t":"RRCMessage-rX-IEs ::= SEQUENCE {","paragraph_zero_based":44441},{"literal_text_all_w_t_and_m_t":"    field-rX       SetupRelease { SEQUENCE {   -- Unnamed SEQUENCEs are not allowed!","paragraph_zero_based":44442},{"literal_text_all_w_t_and_m_t":"            field1-rX                  IE1-rX,","paragraph_zero_based":44443},{"literal_text_all_w_t_and_m_t":"            field2-rX                  IE2-rX                         OPTIONAL        -- Need N","paragraph_zero_based":44444},{"literal_text_all_w_t_and_m_t":"        }","paragraph_zero_based":44445},{"literal_text_all_w_t_and_m_t":"    }                                                                     OPTIONAL,   -- Need M","paragraph_zero_based":44446},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44447}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["9d088c33960aa61c8dc91ba6cc614dc552bd3fe7ad04e8049573ee67ff8fc77a","4777c0cb0a218158df17b459036046316b16fb48872f0c81f6412c092218a2ea","66079c7f1d9c91d2a09cb37bb8995f29acc4d3ec160ccd2bc0bd2dd4b401f93c","658994ab71f732959d5377f173a48c962721157000f637c0941e65d88e64e5f8","19cbfb1bbc344e88812853b712a480d7498deddffd7601fcf192d5a5ee9d2a39","a11b09ad904ccc493a88a0fb3b05e0c750fd6dde19da7d60e42ef476227080fd","96687ec1c2df27a445e702e3d6e4a086414efd4ed182a2134c46f198ab12d80a","006aef10cf6248c883e13c20f4366aa40f775b9e2fb5f68f9178ce79fa6f9945","ac3fd59fe9ef4a71381570d06cabd3eda493e08c1d80d8b4fb82ffaad4f250ec","d14a2fbc1729831990cb13d1063d618c4864ed91ce209f4632dd971c6523d6ec","093c46178f06ace303b0a91c9ace158e717d2b6fd151cf8027bfb802320f295b","22704c36cb935ea46b11fdda9bea2e64d72aec0643fef1c1a3c4724b0d9a1d65","f2cfb1a5b798ebb74e2528564304a53805fa7782a95050a7152f1dae392fc97d","c9a91b8d0107ebba47e324589bf607ad270dddf8d9a571603b488753ede9a740","66a890d28e4097482109a7eaa187e14e3785e91359117614758ac404fdf5256d","2687952e9ef83a0ef30d56da06cedaf67e7f9ba7a157c4bc9e8a813a9bf9d0e9","f86e2bb9d6f528a29f097d51d3f3a83b1e8e698c42132a8b54583e37f744afd4","dc40fa8a2e1dd320b3869f4baeb4e4c8d9ac9f94d91a8ba69404a77af5664f6a","cb4b6bb01769d29035cb887d10fbb959405e83e8b0e50d6d253e7465ead6329e","b5203ba62dcf64fda2ec61ccd54c2b10c6e696802eb7d399e78bdcfc8dbcd3a7","3249dd1b349d52109bb494bc97d445ffa021f3533e084d4e3848ba4abe8bc2c2","847b05d539b82dae4fc25c5e93013d6473ae46114d4ba3c82c043b4c2e52fe10","d7a712bfa62c87f0b3e09182934f1708ddc172a3e19f487f11b58e7bfee3cdcb","00759df9942ce3ab25b9d0a94c7c1fc1945b214472f92393b9f9ccefe8d757f4"],"paragraph_range_zero_based":[44424,44447],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p44424"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44448},{"literal_text_all_w_t_and_m_t":"-- /example/ ASN1STOP","paragraph_zero_based":44449},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44450},{"literal_text_all_w_t_and_m_t":"If a field defined using the parameterized SetupRelease type requires procedural text, the field is referred to using the values defined for the type itself, namely, \"setup\" and \"release\". For example, procedural text for field-rX above could be as follows:","paragraph_zero_based":44451},{"literal_text_all_w_t_and_m_t":"1> if field-rX is set to \"setup\":","paragraph_zero_based":44452},{"literal_text_all_w_t_and_m_t":"2> do something;","paragraph_zero_based":44453},{"literal_text_all_w_t_and_m_t":"1> else (field-rX is set to \"release\"):","paragraph_zero_based":44454},{"literal_text_all_w_t_and_m_t":"2> release field-rX (if appropriate).","paragraph_zero_based":44455},{"literal_text_all_w_t_and_m_t":"A.3.9Guidelines on use of ToAddModList and ToReleaseList","paragraph_zero_based":44456},{"literal_text_all_w_t_and_m_t":"In order to benefit from delta signalling when modifying lists with many and/or large elements, so-called add/mod- and release- lists should be used. Instead of a single list containing all elements of the list, the ASN.1 provides two lists. One list is used to convey the actual elements that are to be added to the list or modified in the list. The second list conveys only the identities (IDs) of the list elements that are to be released from the list. In other words, the ASN.1 defines only means to signal modifications to a list maintained in the receiver (typically the UE). An example is provided below:","paragraph_zero_based":44457},{"literal_text_all_w_t_and_m_t":"-- /example/ ASN1START","paragraph_zero_based":44458},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44459},{"literal_text_all_w_t_and_m_t":"AnExampleIE ::=         SEQUENCE {","paragraph_zero_based":44460},{"literal_text_all_w_t_and_m_t":"    elementsToAddModList    SEQUENCE (SIZE (1..maxNrofElements)) OF Element                                     OPTIONAL,   --  Need N","paragraph_zero_based":44461},{"literal_text_all_w_t_and_m_t":"    elementsToReleaseList   SEQUENCE (SIZE (1..maxNrofElements)) OF ElementId                                   OPTIONAL,   --  Need N","paragraph_zero_based":44462},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":44463},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44464},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44465},{"literal_text_all_w_t_and_m_t":"Element ::=             SEQUENCE {","paragraph_zero_based":44466},{"literal_text_all_w_t_and_m_t":"    elementId               ElementId,","paragraph_zero_based":44467},{"literal_text_all_w_t_and_m_t":"    aField                  INTEG ER (0..16777215),","paragraph_zero_based":44468},{"literal_text_all_w_t_and_m_t":"    anotherField            OCTET STRING,","paragraph_zero_based":44469},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":44470},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44471}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["b30e81aaf1a839ea4fcc464cd2fc426c54ab4419a742cef31a191e7efadaf190","6c64a6cbe701087bebc2a9959338f2bdec29d488bc8f9e4cf20e20f75d6a6c77","0692c7ea145b6783a65286245c64fed16a8f1c67f1365bf08711614df6be382b","b50fa83563e241319eba3e92f4f59f23c502e70088cc05bbdc1c42a2be376935","459503bd8d16214533e0ac697dd3ebf39233358201212d9d4de80adb8ac2a400","408fd2f45698bbb16fcc09ec17d8515475c31d90033db2d9e21dee6701f9d592","621d8256f8e40b5fa80e256d8f240036170e43f69ecac6bbea6eaffcdb1bc221","5f3b97545b35f8f30682cf8cd961ca67fc3679e423ef7d664491aeeca1ab59c8","13f2dab219c9de6881a1c88527c6d7650f3e5fc2cc688bcd53d8c54baf00eb21","7dce9b03f6754ec0b25b874909f50d9544f3a2e99e78f30bd0b13a5913e2ec16","edddf61cf08508de1f83619cef269da77c589359a69b8b240df28eb053c82aa0","cdb4e30c3ad7d8545027100c78fb7e79f0796c195766c37a71192e71f0c98dc9","719c35c7bdfe7a0919b3d6a32af4e99b199d908d846500299bbfb3f87af3ffc5","97894a22273a547cb9da09f9c3a791bf03358c499bab9531ad5c37c29890fe50","370b118e962e2aa0497051264b241d4d52f0818c0b9a222d20d26b3e54107be5","3284842368c86e5cf127db690e9dc9f35b46e7098e38eeafa091f7f8293c4558","6721041de75e685bfda4d45d446a0cf46c11d795e32e7e9f5b14e36c4afe3ca6","16747ebc62dba9fabb1c42c0f9024ede1e52357b9c1e117a25ef80fb100cb290","134a145d67871578a53935c468e6e063b2c43e089ada4db799715607ba8d8a80","d1219e548064beec74956b9e6b54fd3d8c19936641442750bf6179fe9681c4c8","72539f9a487acf7e7c0ca7d7992d0319ed6897fdc9c3d65a6fbb09684a5134a5","1b5d72cf2cf30be1febf2229b1be71ff94ebd85998a668eaf13c058c7ea6cf1f","4f3d82be588456ae9d3440b980bf557eccc8fa39fabba0f6fac1bd9aefd79f94","573279a6e11366618529b0b5d5bfa6d5a8cc0d881ea07e8ce737ce32f8c41c4e"],"paragraph_range_zero_based":[44448,44471],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p44448"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44472},{"literal_text_all_w_t_and_m_t":"ElementId ::=           INTEGER (0..maxNrofElements-1)","paragraph_zero_based":44473},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44474},{"literal_text_all_w_t_and_m_t":"maxNrofElements         INTEGER ::= 50","paragraph_zero_based":44475},{"literal_text_all_w_t_and_m_t":"maxNrofElements-1       INTEGER ::= 49","paragraph_zero_based":44476},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44477},{"literal_text_all_w_t_and_m_t":"-- /example/ ASN1STOP","paragraph_zero_based":44478},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44479},{"literal_text_all_w_t_and_m_t":"As can be seen, the elements of the list must contain an identity (INTEGER) that identifies the elements unambiguously upon addition, modification and removal. It is recommended to define an IE for that identifier (here ElementId) so that it can be used both for a field inside the element as well as in the elementsToReleaseList.","paragraph_zero_based":44480},{"literal_text_all_w_t_and_m_t":"Both lists should be made OPTIONAL and flagged as \"Need N\". The need code reflects that the UE does not maintain the received lists as such but rather updates its configuration using the information therein. In other words, it is not possible to provide via delta signalling an update to a previously signalled elementsToAddModList or elementsToReleaseList (which Need M would imply). The update is always in relation to the UE's internal configuration.","paragraph_zero_based":44481},{"literal_text_all_w_t_and_m_t":"Note that the release of a field (a list element as well as any other field) releases all its sub-fields (sub-fields configured by elementsToAddModList and any other sub-field).","paragraph_zero_based":44482},{"literal_text_all_w_t_and_m_t":"If no procedural text is provided for a set of ToAddModList and ToReleaseList, the following generic procedure applies:","paragraph_zero_based":44483},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":44484},{"literal_text_all_w_t_and_m_t":"1>for each ElementId in the elementsToReleaseList,:","paragraph_zero_based":44485},{"literal_text_all_w_t_and_m_t":"2>if the current UE configuration includes an Element with the given ElementId:","paragraph_zero_based":44486},{"literal_text_all_w_t_and_m_t":"3>release the Element from the current UE configuration;","paragraph_zero_based":44487},{"literal_text_all_w_t_and_m_t":"1>for each Element in the elementsToAddModList:","paragraph_zero_based":44488},{"literal_text_all_w_t_and_m_t":"2>if the current UE configuration includes an Element with the given ElementId:","paragraph_zero_based":44489},{"literal_text_all_w_t_and_m_t":"3>modify the configured Element in accordance with the received Element;","paragraph_zero_based":44490},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":44491},{"literal_text_all_w_t_and_m_t":"3>add received Element to the UE configuration.","paragraph_zero_based":44492},{"literal_text_all_w_t_and_m_t":"A.3.10Guidelines on use of lists (without ToAddModList and ToReleaseList)","paragraph_zero_based":44493},{"literal_text_all_w_t_and_m_t":"As per clause 6.1.3, when using lists without the ToAddModList and ToReleaseList structure, the contents of the lists are always replaced. To illustrate this, an example is provided below:","paragraph_zero_based":44494},{"literal_text_all_w_t_and_m_t":"-- /example/ ASN1START","paragraph_zero_based":44495}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["521182b3a762047c0bdade15c46b0b53c1905dbcdadca68b119f25adb674b1a8","3eaa1d83791a5c6ba35c77ef20006db66e9974726799cde36f225ad2aa4b24cc","3556f2d7cfd3d1e6d36244f61e4e6eaa33756ae76fcb071ec33465716651274c","2d1da360057a6ccb36dc74328e398fdb2d2bf873a30a1e61c2fc4bd167e757d1","997d2aaa43a0bf632e8dc77c20e862d78c20809062b44d2a61e86d8a1b0adeb3","4b501c58f700e12b58e515fbb68aba93bb32ba3c7ba9436716c7a46a4e20e624","e48fcdd10aeab6278de55d30a53a2c08cef33b91a759b80fa4e34187da023cd0","f1d57aa809af69c02cd2c37600886e53db3743ec9e0afd87533dfd9b451bf95f","8c3ab35c229ae0d6d8b02a1c08d3a3660e1fe9a7073f941ea12287979c325427","f26626f41b212d7961d02febddb07f39dba477e4ada7d464ce2b195bf030d9cf","ae08fb4153a3af92d85428425902878e0dc4f14f6277164acbe39c92c903e499","65178a7d0fc4744765ebacf54e6ffdd9fed66cb9062efc6e3f9096f4a31c015d","69a33ce03f0bca54a0ca8a1328c3b4877412aee9512d61e0fffc6bccbdc1668f","72145555c94a124f5da167a654d10da4ff78abe4b316e78b787091fcd7c52fa4","fd87c650461c72c6bb4817082ea088e5799d9dac45cf6e361b76a1d071fcd61e","7f12ee1089e467df39bb299fd2c406cb9b80b258d13d2788d0d8696b2bd2f8f3","8dde48ef5886c774259ec73287109cf1ff5b25190d8f692c6f705640b2094712","58946af9f29d7527964452b8966eb325c6f452895bbee7fc1560177179208f4d","58c3024b4b4ce7cbb23275142a6bd789891e1487f6ddfe8a522d1008d2008d51","972798e6a49e6494b206df7c4fcb719d9f2d7673b9c9f89953bb3d1ef6310760","f08faef54bf3df921374a088e58816275f8b4215222011ee7f1f83b73dc4eaf1","12573498e23964ce74b0e070e93771bb4d4c3873d86b76a50f62faeb98597c1b","4dd9109a981173c0ab4ef5f3bf3443a21e8c011905023371174f245b4d748b41","803c74d0075a4943194a2c7f4f42bb175a10a1c986146d1b31645b6b037015ed"],"paragraph_range_zero_based":[44472,44495],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p44472"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG_EXAMPLE_LISTS_START","paragraph_zero_based":44496},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44497},{"literal_text_all_w_t_and_m_t":"AnExampleIE ::=         SEQUENCE {","paragraph_zero_based":44498},{"literal_text_all_w_t_and_m_t":"    elementList             SEQUENCE (SIZE (1..maxNrofElements)) OF Element                                     OPTIONAL,   --  Need M","paragraph_zero_based":44499},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":44500},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":44501},{"literal_text_all_w_t_and_m_t":"    elementListExt-v2030    SEQUENCE (SIZE (1..maxNrofElementsExt)) OF Element                                  OPTIONAL,   --  Need M","paragraph_zero_based":44502},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":44503},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44504},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44505},{"literal_text_all_w_t_and_m_t":"Element ::=         SEQUENCE {","paragraph_zero_based":44506},{"literal_text_all_w_t_and_m_t":"    useFeatureX         BOOLEAN,","paragraph_zero_based":44507},{"literal_text_all_w_t_and_m_t":"    aField              INTEGER (0..127)                                                                        OPTIONAL,   --  Need M","paragraph_zero_based":44508},{"literal_text_all_w_t_and_m_t":"    anotherField        INTEGER (0..127)                                                                        OPTIONAL,   --  Need R","paragraph_zero_based":44509},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":44510},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44511},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44512},{"literal_text_all_w_t_and_m_t":"maxNrofElements         INTEGER ::= 8","paragraph_zero_based":44513},{"literal_text_all_w_t_and_m_t":"maxNrofElements-1       INTEGER ::= 7","paragraph_zero_based":44514},{"literal_text_all_w_t_and_m_t":"maxNrofElementsExt      INTEGER ::= 8","paragraph_zero_based":44515},{"literal_text_all_w_t_and_m_t":"maxNrofElementsExt-1    INTEGER ::= 7","paragraph_zero_based":44516},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44517},{"literal_text_all_w_t_and_m_t":"-- TAG_EXAMPLE_LISTS_STOP","paragraph_zero_based":44518},{"literal_text_all_w_t_and_m_t":"-- /example/ ASN1STOP","paragraph_zero_based":44519}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["d63fbef69bd1c139f737f0c87e0ddeddcefe15794c4bf434ec33dfb2f61810d2","d8092c183b644eb9141f49239f9c5e56dc2e15599dc2ab418ec85f68381904b3","99a78ba4d5d12cc7461167ef491222d334458ca9bbecae9c7f111ad506367d5a","cebd45d7bcb2de2a32150d8b024d57b07cda27f2163b86344d2afcbfd5342aaa","0e5582a61af307255faf494676a841e76f73ff2b23ee8023d2686604ca4303db","7b17abb747d3e6c2ffbc3de0ff7dad99e012ea9cf0a3d8dd7df71768dee21faf","9ddcd2e99c9c8d10b3445308c7427fb961872bdb6b6a94f1114f752e875fe915","b114e3a7ebbb679c6a06bee556fe673d28e19109bc221e94f1c7141a41546765","8564da5951e158b53aec23db718563e07ecae8786ef94a9a18574feabf0521dd","575bfbbdbea8d3a86a10990721f2471708da33ae23d9b79fc9d117ac0da522b7","513ed9d696fc0eefcc6d5da5e0553530592dd2d876d830680c267a83998a923f","49e6c7b0633300cc7b5c2e0a96c644f0c38ee87ce35d9297c7f346c971b06754","2eda6e84bdf528ab4df4243ec7d87b2e0a7d1123631566c108976873f2fe8fbf","8dc3e634ace67a2f615e64dd35629de75f1525ba4b57332564c799502f0735fd","0b8a2e64a7a1ae794dfb8c4c9fdc693b4a8cba6127d4d15776dc389e834ce1cb","6fc1eef443e0432b6d882fd6937cb40a32855f3f748427d99e321b3a286186bd","f71e55a0236b253a4df0726a1e37f5a74b0cc73f0bbfbb525265224b21385ddb","78c399cd14d02da3581cf10b0178e5d6481c2f566cab4991059a31007137fe12","c777e8d26d5cccb73ba44785388e7640f97148b3cbb111977f629ddea5823011","f02c76679460fd5456f8c62f67ebe16fd0943f7e28fbde33bc55fd7c23e12c8b","15fd36d4e274a69cd49d9c00284b9e5d0c9cf9d8d3d505623914978ecffc116f","254a86293927c113c035f7d2c135fe064001193ec0c193e34e32aa73423f47bc","1e0faaa64879301fbb6fe32d63c3e1119e7b564db09f749216be2eadb1c793b5","00ea3a6bb8bc36002d34410752cce95fc08ecde1772e6f664a10410b9d3ca303"],"paragraph_range_zero_based":[44496,44519],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p44496"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44520},{"literal_text_all_w_t_and_m_t":"As can be seen, the elementList list itself uses Need M, but each list entry Element contains mandatory, Need M and Need R fields. If the list is first signalled to UE with 3 entries, and subsequently again with 2 entries, UE shall retain only the latter list, i.e. the list with 2 elements will completely replace the list with 3 elements. That also means that the field aField will be treated as if it was newly created, i.e. network must include it if it wishes UE to utilize the field even if it was previously signalled. This also implies that the Need M field (aField) will be treated in the same way as the Need R field (anotherField), i.e. delta signalling is not applied and the network has to signal the field to ensure UE does not release the value (which is why Need M should not normally be used in the entries of these lists).","paragraph_zero_based":44521},{"literal_text_all_w_t_and_m_t":"A.4Extension of the PDU specifications","paragraph_zero_based":44522},{"literal_text_all_w_t_and_m_t":"A.4.1General principles to ensure compatibility","paragraph_zero_based":44523},{"literal_text_all_w_t_and_m_t":"It is essential that extension of the protocol does not affect interoperability i.e. it is essential that implementations based on different versions of the RRC protocol are able to interoperate. In particular, this requirement applies for the following kind of protocol extensions:","paragraph_zero_based":44524},{"literal_text_all_w_t_and_m_t":"-Introduction of new PDU types (i.e. these should not cause unexpected behaviour or damage).","paragraph_zero_based":44525},{"literal_text_all_w_t_and_m_t":"-Introduction of additional fields in an extensible PDUs (i.e. it should be possible to ignore uncomprehended extensions without affecting the handling of the other parts of the message).","paragraph_zero_based":44526},{"literal_text_all_w_t_and_m_t":"-Introduction of additional values of an extensible field of PDUs. If used, the behaviour upon reception of an uncomprehended value should be defined.","paragraph_zero_based":44527},{"literal_text_all_w_t_and_m_t":"It should be noted that the PDU extension mechanism may depend on the logical channel used to transfer the message e.g. for some PDUs an implementation may be aware of the protocol version of the peer in which case selective ignoring of extensions may not be required.","paragraph_zero_based":44528},{"literal_text_all_w_t_and_m_t":"The non-critical extension mechanism is the primary mechanism for introducing protocol extensions i.e. the critical extension mechanism is used merely when there is a need to introduce a 'clean' message version. Such a need appears when the last message version includes a large number of non-critical extensions, which results in issues like readability, overhead associated with the extension markers. The critical extension mechanism may also be considered when it is complicated to accommodate the extensions by means of non-critical extension mechanisms.","paragraph_zero_based":44529},{"literal_text_all_w_t_and_m_t":"A.4.2Critical extension of messages and fields","paragraph_zero_based":44530},{"literal_text_all_w_t_and_m_t":"The mechanisms to critically extend a message are defined in A.3.3. There are both \"outer branch\" and \"inner branch\" mechanisms available. The \"outer branch\" consists of a CHOICE having the name criticalExtensions, with two values, c1 and criticalExtensionsFuture. The criticalExtensionsFuture branch consists of an empty SEQUENCE, while the c1 branch contains the \"inner branch\" mechanism.","paragraph_zero_based":44531},{"literal_text_all_w_t_and_m_t":"The \"inner branch\" structure is a CHOICE with values of the form \"MessageName-rX-IEs\" (e.g., \"RRCConnectionReconfiguration-r8-IEs\") or \"spareX\", with the spare values having type NULL. The \"-rX-IEs\" structures contain the complete structure of the message IEs for the appropriate release; i.e., the critical extension branch for the Rel-10 version of a message includes all Rel-8 and Rel-9 fields (that are not obviated in the later version), rather than containing only the additional Rel-10 fields.","paragraph_zero_based":44532},{"literal_text_all_w_t_and_m_t":"The following guidelines may be used when deciding which mechanism to introduce for a particular message, i.e. only an 'outer branch', or an 'outer branch' in combination with an 'inner branch' including a certain number of spares:","paragraph_zero_based":44533},{"literal_text_all_w_t_and_m_t":"-For certain messages, e.g. initial uplink messages, messages transmitted on a broadcast channel, critical extension may not be applicable.","paragraph_zero_based":44534},{"literal_text_all_w_t_and_m_t":"-An outer branch may be sufficient for messages not including any fields.","paragraph_zero_based":44535},{"literal_text_all_w_t_and_m_t":"-The number of spares within inner branch should reflect the likelihood that the message will be critically extended in future releases (since each release with a critical extension for the message consumes one of the spare values). The estimation of the critical extension likelihood may be based on the number, size and changeability of the fields included in the message.","paragraph_zero_based":44536},{"literal_text_all_w_t_and_m_t":"-In messages where an inner branch extension mechanism is available, all spare values of the inner branch should be used before any critical extensions are added using the outer branch.","paragraph_zero_based":44537},{"literal_text_all_w_t_and_m_t":"The following example illustrates the use of the critical extension mechanism by showing the ASN.1 of the original and of a later release","paragraph_zero_based":44538},{"literal_text_all_w_t_and_m_t":"-- /example/ ASN1START                  -- Original release","paragraph_zero_based":44539},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44540},{"literal_text_all_w_t_and_m_t":"RRCMessage ::=                          SEQUENCE {","paragraph_zero_based":44541},{"literal_text_all_w_t_and_m_t":"    rrc-TransactionIdentifier               RRC-TransactionIdentifier,","paragraph_zero_based":44542},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                      CHOICE {","paragraph_zero_based":44543}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["03fd9b0f9b3a5945c7f73784b679c209e802a23e0c5e9a1871e76fe37cf7c440","67aade3db7614033a74e3fba3f36ab117fa54647057ae0ca0b023a937e25e70e","3be43c33f8c7193506b33f998799a4bdb2a3b77f21df2a27e26ebd34277e698d","47749af9f00cb9d622c528463aa32181f77b6b6e839273fcf356416898ace3df","a74fb33037a4e4954ad23c33cd4ff2fbcc8e5584f84709eea4fb11b0c7e7cf80","66dfdc3e5cbeb35763ab0ac4a3a29e675b363548d0b8e7b88042da079419c4f7","573ec3962e5f31031ed852ccec1739ad49f2ba6546ddbd3961bb639f8886f545","232219fb24330386d9d2e5c6023de03dfe60ae039a0eba479765893769c9f991","d54925e4b0adb1295b336e4ed44d37aec441ad6e8332e6b9ae706d25ec86bca0","12ebd3f7b16c5de315d141717b8f608c98351ebedf0a25971d435c39eca26db6","a55b9bbfaac80a6adf67f4ea4e61f88185d99ee1d857f03a2b97ca8301c9639f","54abd5781d938a3c50f1308d80759d19855476c1ef3c35ac86766af2c4ffdb98","e05ea99730c37858b5a997d8780e8b59d295dc75a9d36d4a0b4c602804a062c9","b82064069c8d604995d2bada2910a3296961436f5fd3458ae7adc20cbb4a0640","13bf92d036a65c557eeb837a6a46466e9725960697612379df229e16779ff466","9ff0afd43c1fcd15ac16e5610f236e1d52e2910c15b8b5e5dac6a757491cd6a3","6dcd0f2f9d16345cab3c229e34b183201accc5a9f8d5deef820186181dabd5a0","87468a99f7743da19db2d637ba791433ddc549e537c54d5f20cf8b18e7808f1d","b4a23a40d284c8cf6a9ba0fbe3cc0dd7eeed2702b18a6d1547f7f0b1e92e28a1","dc7738e778e4962f6bd5e26bcb09e8b0dbb0dbcb0cd090ea988c44a0bcaeeced","ea1ef25c02cdeffc882a31e54d85f832d75abe6a3b5f8d16b48a130901d1cea0","7405a7519bdaed4bb7ce973f7dafb37ff8abc6a7f0c38693f0000937d5a0e963","cc333bdb723dd0f3893d677f7b194f8f0e25fac2686038ef6f1c984d4c5fbc25","04f99d3653b9176c7f983af03c0d6663b2be7225e21be4fae170fbccd06fa6ef"],"paragraph_range_zero_based":[44520,44543],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p44520"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        c1                                      CHOICE{","paragraph_zero_based":44544},{"literal_text_all_w_t_and_m_t":"            rrcMessage-r8                           RRCMessage-r8-IEs,","paragraph_zero_based":44545},{"literal_text_all_w_t_and_m_t":"            spare3 NULL, spare2 NULL, spare1 NULL","paragraph_zero_based":44546},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":44547},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture                SEQUENCE {}","paragraph_zero_based":44548},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":44549},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44550},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44551},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44552},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44553},{"literal_text_all_w_t_and_m_t":"-- /example/ ASN1START                  -- Later release","paragraph_zero_based":44554},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44555},{"literal_text_all_w_t_and_m_t":"RRCMessage ::=                          SEQUENCE {","paragraph_zero_based":44556},{"literal_text_all_w_t_and_m_t":"    rrc-TransactionIdentifier               RRC-TransactionIdentifier,","paragraph_zero_based":44557},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                          CHOICE {","paragraph_zero_based":44558},{"literal_text_all_w_t_and_m_t":"        c1                                          CHOICE{","paragraph_zero_based":44559},{"literal_text_all_w_t_and_m_t":"            rrcMessage-r8                               RRCMessage-r8-IEs,","paragraph_zero_based":44560},{"literal_text_all_w_t_and_m_t":"            rrcMessage-r10                              RRCMessage-r10-IEs,","paragraph_zero_based":44561},{"literal_text_all_w_t_and_m_t":"            rrcMessage-r11                              RRCMessage-r11-IEs,","paragraph_zero_based":44562},{"literal_text_all_w_t_and_m_t":"            rrcMessage-r14                              RRCMessage-r14-IEs","paragraph_zero_based":44563},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":44564},{"literal_text_all_w_t_and_m_t":"        later                                      CHOICE {","paragraph_zero_based":44565},{"literal_text_all_w_t_and_m_t":"            c2                                         CHOICE{","paragraph_zero_based":44566},{"literal_text_all_w_t_and_m_t":"                rrcMessage-r16                             RRCMessage-r16-IEs,","paragraph_zero_based":44567}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["2e746c5c2beca2c388eae3ae802d735017129dd58aa05168e00bd91c33a38718","c2b97fcf36b3d1752c7a8406e6ed1ae3d2bdd92d7b57c47f3bc8f0eeb458f22a","5ec3732c91ea432d67c2bf9d94aa59872ca9ced3026d730f24c3b541c4155d6b","6a27e9820fcab6bbc02666f7f0ade482fbcb576cff04441a7cb6fa0e86808669","13a30d7555cce7f4b3de8b07d0c82e2e42f3c3279823df92ce036762aa9d72b9","199854c0377d3fc806e031cbe8315844c84bf0c63fec4da206aa2a83d8913bed","7162b607816e8222645b943a99eb71880028260e6daacda583b3285cf6f92316","4dd8342f9ceb6fbb28d0b9ea6a4b30e8d3f831182971146adc9617bd7d2fbf42","e5bc1d64244626c0a78783d78534823c4d9a8d2ec6b675e1f11c99d03060b49b","fec28b27821db0b6bc8bbe7fdd00b00e3b2b753b3779157838e352a001538c41","80f698ae8379aca08a42ca57c78d2df1423f081247ffb93e92f1bd9c8612d0af","c24bd099d33260d999aae4803e8292540b05d76723c42d3f25dead3c4fd1d03d","69e67c5d9b0de2f94ea8536de959a0ed9e596ce03ee113fb425d536ff6f6acd1","aa6e3da89ad3cf35d4cfec86894e5b3ea525d98c3a5e26fa5773a0f352be9a0e","d856092eb2ff322359b926fb24385ab0cd4931b963bc4a0d1f226ebde6644587","e57e6f9fcb869d2e65e0ffd6ff1307f62e7d01c9d425b84274e1d933b6ef6e79","f6d347b17597fdebde390b36642f584007cd50dfcda8de5cbacf1c3089a2d1e3","878524820bb5bfe212e12b94cb14c1885ffbcc5509d54f0f214eaafe06a966ed","829a17f49dda096fd33d73ad6496cf70353b7e55724ce0a7fa278029a1168cc8","a0873bff8977a8d12961c21d337e41a7b4c5b47c458d30357ac9754fd6f445ad","b9517220849a7eeb2b890407ff375ecda075345c10fa2a128bb24421e181bfcf","cb72111cb547b3b46272b8f07a6484747935769d40927d2f32cbde514891f8cd","cffc80313308bec00c225d24f4be774db31db26d265545616b2b41c37e00450c","c313eed881efe91fd9b25d101a27a6812dbfd08cde5bd76da364d6703280c177"],"paragraph_range_zero_based":[44544,44567],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p44544"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"                spare7 NULL, spare6 NULL, spare5 NULL, spare4 NULL,","paragraph_zero_based":44568},{"literal_text_all_w_t_and_m_t":"                spare3 NULL, spare2 NULL, spare1 NULL","paragraph_zero_based":44569},{"literal_text_all_w_t_and_m_t":"            },","paragraph_zero_based":44570},{"literal_text_all_w_t_and_m_t":"            criticalExtensionsFuture                SEQUENCE {}","paragraph_zero_based":44571},{"literal_text_all_w_t_and_m_t":"        }","paragraph_zero_based":44572},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":44573},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44574},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44575},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44576},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44577},{"literal_text_all_w_t_and_m_t":"It is important to note that critical extensions may also be used at the level of individual fields i.e. a field may be replaced by a critically extended version. When sending the extended version, the original version may also be included (e.g. original field is mandatory, E-UTRAN is unaware if UE supports the extended version). In such cases, a UE supporting both versions may be required to ignore the original field. The following example illustrates the use of the critical extension mechanism by showing the ASN.1 of the original and of a later release.","paragraph_zero_based":44578},{"literal_text_all_w_t_and_m_t":"-- /example/ ASN1START                  -- Original release","paragraph_zero_based":44579},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44580},{"literal_text_all_w_t_and_m_t":"RRCMessage ::=                          SEQUENCE {","paragraph_zero_based":44581},{"literal_text_all_w_t_and_m_t":"    rrc-TransactionIdentifier               RRC-TransactionIdentifier,","paragraph_zero_based":44582},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                      CHOICE {","paragraph_zero_based":44583},{"literal_text_all_w_t_and_m_t":"        c1                                      CHOICE{","paragraph_zero_based":44584},{"literal_text_all_w_t_and_m_t":"            rrcMessage-r8                           RRCMessage-r8-IEs,","paragraph_zero_based":44585},{"literal_text_all_w_t_and_m_t":"            spare3 NULL, spare2 NULL, spare1 NULL","paragraph_zero_based":44586},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":44587},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture            SEQUENCE {}","paragraph_zero_based":44588},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":44589},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44590},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44591}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["b37cee64e642cf69661f731af0693b02258d8c05c5d6d25bf418ebc9d70b83a1","513ff09ee0f667eb9c0c595dfc4a67731403ddeea42e75d5d562e8049c46b5dd","60b18c8e40a43bf61068194c3134ef75f4f6af603e7dbbeb6242d4db1da20573","696323ab3e366e8e92266ae85f37bf42beea8f982fc4042385e5eccb0755d4cb","4ed1b6be001d3b3dc5c5564b64a278af2424ae866b94b0937f715caaea34983c","2123acdd2c3a02551c846d8f38ff722a34b23a2a8a97c38f15c6fbe7ab1b3e9d","0fd49d0c82273677242c5e1decf6c729c4de86ae67a56243fc527a84292690f6","f0e28c3d1528d714ad126f0df5deb711cd3680211ef9279a6aa180eae437ebbe","00608c49c55b3b3b697d8e8d1f1809a77340ae17e0df94e98325cc8b7aaef8ad","30b238814551a9a15138d2a4ef59c13d1e5607e617cd922d44be6b1b0cf2e3e1","3a4feedc96921b29e1b8537480009ac252caaac5f2784276e16363a1d67a0b08","db544edd8ceb2d83c47869da6a8ee7ec177c83b1863a810418b92641b5bf9689","d0705a88a168ff168a199df82eb0420a91d7322761f5dc10bfef8e0b7849494c","ba5d3e2f5458742c9366e741b8cee72ea025bc39b5609d7deeec1a4568fa7178","6706f0ffcb61e1e0c6a7cfc1f443768819f87ca88fdbc6720411c633b781927c","2cc4f9e88ff5fddff333e6f5c50ca67e6fb5b538ae87657b1db50acdaa5d106a","05b2d6de65d36d11bf0a4d94758f3f77d4476a9264c6544a52756922c03a08cd","cfcf7911b9d811712d5b56a58c97cab728989bfe55e2ddc3bab3dd55c399934d","5b48fc195f951bd48c02c6dad5e4bbdb19049fc8c1e7714b4dedf52dfa3f4c9b","b0be1dd67632881a0638555bb2f1de7f802ae0d8b8719040b4ec8fa45c5ea175","f527313a4a46cde9219366f3794f806ba9429c3e8b8abd943b16abd44cd8153b","f5509063840cd61ecda011744845e140dc0f0527ba7466a7be2b93219ba28e1c","681c67f18925952405c873b6f3c4d6a7f40ee26180b2392d49c19b4c38c53412","9fb999d9a082757f4e51ae3c4eb262856452317927e0c973db25113a60344057"],"paragraph_range_zero_based":[44568,44591],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p44568"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"RRCMessage-rN-IEs ::= SEQUENCE {","paragraph_zero_based":44592},{"literal_text_all_w_t_and_m_t":"    field1-rN                           ENUMERATED {","paragraph_zero_based":44593},{"literal_text_all_w_t_and_m_t":"                                            value1, value2, value3, value4}     OPTIONAL,   -- Need N","paragraph_zero_based":44594},{"literal_text_all_w_t_and_m_t":"    field2-rN                           InformationElement2-rN                  OPTIONAL,   -- Need N","paragraph_zero_based":44595},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                RRCConnectionReconfiguration-vMxy-IEs   OPTIONAL","paragraph_zero_based":44596},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44597},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44598},{"literal_text_all_w_t_and_m_t":"RRCConnectionReconfiguration-vMxy-IEs ::= SEQUENCE {","paragraph_zero_based":44599},{"literal_text_all_w_t_and_m_t":"    field2-rM                                 InformationElement2-rM            OPTIONAL, -- Cond NoField2rN","paragraph_zero_based":44600},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                      SEQUENCE {}                       OPTIONAL","paragraph_zero_based":44601},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44602},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44603},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44604},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44605},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":44606},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":44607},{"literal_text_all_w_t_and_m_t":"NoField2rN","paragraph_zero_based":44608},{"literal_text_all_w_t_and_m_t":"The field is optionally present, need N, if field2-rN is absent. Otherwise the field is absent","paragraph_zero_based":44609},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44610},{"literal_text_all_w_t_and_m_t":"Finally, it is noted that a critical extension may be introduced in the same release as the one in which the original field was introduced e.g. to correct an essential ASN.1 error. In such cases a UE capability may be introduced, to assist the network in deciding whether or not to use the critical extension.","paragraph_zero_based":44611},{"literal_text_all_w_t_and_m_t":"In the case of list fields (SEQUENCE OF types in ASN.1) using the ToAddMod/ToRelease construction, the use of critical extensions to increase the size of a list should be avoided; that is, replacing the original list field by a new field also used to signal entries previously covered by the original field (i.e. extensions done according to the following example) should be avoided:","paragraph_zero_based":44612},{"literal_text_all_w_t_and_m_t":"-- /example/ ASN1START                  -- Discouraged example","paragraph_zero_based":44613},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44614},{"literal_text_all_w_t_and_m_t":"ContainingStructure ::=                 SEQUENCE {","paragraph_zero_based":44615}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["005994f08a6ca00285e499a6cf72cb3bd70dfc0ee3da8c983e4e8e892b768b83","9a1904134472baa6ceaebe52885fcfb5be2d3d1a84781ba384f098d53873d6c8","f2a47499da58354493d6f406c48181aa72274bcfe21b6f2e4f4193246e681400","a294800c6debbc2fca1bfbd257cb424cd0937f799763ebd92704a244a2b67250","e37a3fb94d070d8dede64d746bd7423543b6e0332a3d898f99025e0e053640d4","140997bfade451aee76c3e436121593c523b15b370504e572854a5eecb5f5e5e","7c54d6397ca41aef60a88b74001c85e43456c463b0c20a4b355d01448f54b99a","748ac4275897413a5db426f1dc2326909bdaf321a85b56a9c44ceaee93b436dd","70418684a8b1672f4b1f8c07c21996936ea07e29cd7fa958aca75551f3798b86","04410a0101fa8bd24eba53ac5441bae1550c50cb4a2e78c00bf906faed67a829","88089923f6fd764fda09ceda8fc9e45ba3cf2cc831e932cba158b5ae7ad9ea5e","62b048629777d61178208c20ae4264ef31c77fd60c416e79e8474c9d1d2e542b","06bbcefbae397ea648980026466aecc1476d347a3abbcd1807470ca7e26579ee","6e6d3413a04644a9e95bc5a56ea43565158f30893cef3cc7c2c1ac4f50aa6f00","5bc8174fbd6d8fc556fe677c08331df5833fa087df77de61d929a49bac244f6b","70a4690a52e5392eaa08ce1d1f8964a5230a9c3e97219f6c03a36b10909d9a12","ba45f599d18171f7d7112eb0506fd5dcf47685722543082319dc9ca4820233ce","c904b47b495ff95008d3e7b04d5e8708f49681f4f9abdc708d823919cfce261b","e420695adc2eecfb83b5f94637880c277ed5fca413154167a13031caf860d76c","b124caa3fbf65169e672369b136a4aa9ea9b0deb695a95d73eea7234e2f63cf8","f5c379c1d7f53a51c26b848064eab45f84ffeb85198f44b990ce4928ccd46207","147f26c57cf646fdcaff06ec828e413eedb9e6eeafbadacabfc0d7124dd69d30","18213eaa2a5e6a432d82f36f9fdc8661503f79e2b7ab7484fc13d000393a361b","e85da2b71489948faa1ae5f8019582d870d09ccce23acde05424f34cb028dde3"],"paragraph_range_zero_based":[44592,44615],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p44592"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    listElementToAddModList                 SEQUENCE (SIZE (1..maxNrofListElements)) OF ListElement         OPTIONAL,    -- Need N","paragraph_zero_based":44616},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":44617},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":44618},{"literal_text_all_w_t_and_m_t":"    listElementToAddModList-rN              SEQUENCE (SIZE (1..maxNrofListElements-rN)) OF ListElement      OPTIONAL     -- Need N","paragraph_zero_based":44619},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":44620},{"literal_text_all_w_t_and_m_t":"}-- ASN1STOP","paragraph_zero_based":44621},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44622},{"literal_text_all_w_t_and_m_t":"Instead, a non-critical list extension mechanism should typically be used, such that the extension field only adds the new entries of the list.  This approach is further described in clause A.4.3.6.","paragraph_zero_based":44623},{"literal_text_all_w_t_and_m_t":"If the critical extension mechanism for a list is used, it should be clarified in the field description that the two versions of the list are not configured together, and that the network should release the contents of the original version when configuring the replacement version.","paragraph_zero_based":44624},{"literal_text_all_w_t_and_m_t":"A.4.3Non-critical extension of messages","paragraph_zero_based":44625},{"literal_text_all_w_t_and_m_t":"A.4.3.1General principles","paragraph_zero_based":44626},{"literal_text_all_w_t_and_m_t":"The mechanisms to extend a message in a non-critical manner are defined in A.3.3. W.r.t. the use of extension markers, the following additional guidelines apply:","paragraph_zero_based":44627},{"literal_text_all_w_t_and_m_t":"-When further non-critical extensions are added to a message that has been critically extended, the inclusion of these non-critical extensions in earlier critical branches of the message should be avoided when possible.","paragraph_zero_based":44628},{"literal_text_all_w_t_and_m_t":"-The extension marker (\"...\") is the primary non-critical extension mechanism that is used but empty sequences may be used if length determinant is not required. Examples of cases where a length determinant is not required:","paragraph_zero_based":44629},{"literal_text_all_w_t_and_m_t":"-at the end of a message;","paragraph_zero_based":44630},{"literal_text_all_w_t_and_m_t":"-at the end of a structure contained in a BIT STRING or OCTET STRING.","paragraph_zero_based":44631},{"literal_text_all_w_t_and_m_t":"-When an extension marker is available, non-critical extensions are preferably placed at the location (e.g. the IE) where the concerned parameter belongs from a logical/ functional perspective (referred to as the 'default extension location').","paragraph_zero_based":44632},{"literal_text_all_w_t_and_m_t":"-It is desirable to aggregate extensions of the same release or version of the specification into a group, which should be placed at the lowest possible level.","paragraph_zero_based":44633},{"literal_text_all_w_t_and_m_t":"-In specific cases it may be preferable to place extensions elsewhere (referred to as the 'actual extension location') e.g. when it is possible to aggregate several extensions in a group. In such a case, the group should be placed at the lowest suitable level in the message.","paragraph_zero_based":44634},{"literal_text_all_w_t_and_m_t":"-In case placement at the default extension location affects earlier critical branches of the message, locating the extension at a following higher level in the message should be considered.","paragraph_zero_based":44635},{"literal_text_all_w_t_and_m_t":"-In case an extension is not placed at the default extension location, an IE should be defined. The IE's ASN.1 definition should be placed in the same ASN.1 clause as the default extension location. In case there are intermediate levels in-between the actual and the default extension location, an IE may be defined for each level. Intermediate levels are primarily introduced for readability and overview. Hence intermediate levels need not always be introduced e.g. they may not be needed when the default and the actual extension location are within the same ASN.1 clause.","paragraph_zero_based":44636},{"literal_text_all_w_t_and_m_t":"A.4.3.2Further guidelines","paragraph_zero_based":44637},{"literal_text_all_w_t_and_m_t":"Further to the general principles defined in the previous clause, the following additional guidelines apply regarding the use of extension markers:","paragraph_zero_based":44638},{"literal_text_all_w_t_and_m_t":"-Extension markers within SEQUENCE:","paragraph_zero_based":44639}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["641b927c25659e6e28c4eb9165686fd73f592e167aa34696e76ad1f3912d1237","cafb2100b0e2c40784dfccb418be79abf2c0af211d740a2d5d3a1d62b817d555","c8bb08171a5744220337ef450828495a0480fcd040a6c72125c2de218e400a22","bc593b14305979aa7e704043b3181b446f85f838e9573f1ee2842a1c555a91c6","ceb344ac027cf12beac556031788aae2d65d9a3c57bb3c6dbc28bcfd5ef2f53c","2e4aa1e3fc2372bf987fc3541d74ea22038bff9d61e47c5f0c669ba400e3d482","6cb15d10768a7da13184293dd06728aaf047b5a56ad3a1de1d60f613db4a1363","54f989ebb9b69dc508ea65542333845e8ca157de3a2e637eb0ca641453d38e28","2609caecc39d8242d656b8095e560ed2ff6b8156763762d643c9c27b4984df0c","2b9b4b47e44abc520f708bf865c29fca487f76c78914e6ad89599841e3131b6c","6aa49aaae3d19b0d9bc76d1e4fc91f90cb1cd60921100a4fac7056e294e7d055","870f03aa26af1b49101a6a5f23c37fcb3138eaf09359e2ecc07614e0791f7b1b","10281ed8e4107b8df0bd59554b50dd4b18a7d7e6a8c74a6296d9219a82ce6c64","a197fa0f5f1f39a10fc7d4d3ec83cc3a13d20d7b37b6b526bdc9fa9f42c7d190","bd62f52f5de3e6a419e67b02555b94b2dacde3c3ecb8417e78e778214cadb008","d8c390cd30b0e528850b5195e80fb3f96b16536027a927504ae8a0c7176c207b","a80a25795d612dbf2909e726dded716c7cf0260f7084a926df4b21d23babf2e4","20906fc5ba100cd2c6d13c69766ad1b62b7116d80532216afbbff89348038f4a","c9fe00d23a68e91a8fa62a721448c7f1b130c240fcee89b0ef130cf35b01ed06","15b2b814d73423dd7d839127b6e74e08eb21e5cd634f702f67e34077def577db","df10cc9afeec15e543a6df3736730f1d6d17696005cbd77352a711eef8083c89","bf22d20eca53ce58ba8314df7b3adef88b064ae0589a874d25c63cffb37a1ce0","def9712cf78e89f4f03ad8b5c00dca8ab084e2a2bca5191a2b3a55b555b87876","bbd84872fee3d45ecd1a4e300c2be00fa00477a239067297a91b43ac5d766305"],"paragraph_range_zero_based":[44616,44639],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p44616"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-Extension markers are primarily, but not exclusively, introduced at the higher nesting levels.","paragraph_zero_based":44640},{"literal_text_all_w_t_and_m_t":"-Extension markers are introduced for a SEQUENCE comprising several fields as well as for information elements whose extension would result in complex structures without it (e.g. re-introducing another list).","paragraph_zero_based":44641},{"literal_text_all_w_t_and_m_t":"-Extension markers are introduced to make it possible to maintain important information structures e.g. parameters relevant for one particular RAT.","paragraph_zero_based":44642},{"literal_text_all_w_t_and_m_t":"-Extension markers are also used for size critical messages (i.e. messages on BCCH, BR-BCCH, PCCH and CCCH), although introduced somewhat more carefully.","paragraph_zero_based":44643},{"literal_text_all_w_t_and_m_t":"-The extension fields introduced (or frozen) in a specific version of the specification are grouped together using double brackets.","paragraph_zero_based":44644},{"literal_text_all_w_t_and_m_t":"-Extension markers within ENUMERATED:","paragraph_zero_based":44645},{"literal_text_all_w_t_and_m_t":"-Spare values may be used until the number of values reaches the next power of 2, while the extension marker caters for extension beyond that limit, given that the use of spare values in a later Release is possible without any error cases.","paragraph_zero_based":44646},{"literal_text_all_w_t_and_m_t":"-A suffix of the form \"vXYZ\" is used for the identifier of each new value, e.g. \"value-vXYZ\".","paragraph_zero_based":44647},{"literal_text_all_w_t_and_m_t":"-Extension markers within CHOICE:","paragraph_zero_based":44648},{"literal_text_all_w_t_and_m_t":"-Extension markers are introduced when extension is foreseen and when comprehension is not required by the receiver i.e. behaviour is defined for the case where the receiver cannot comprehend the extended value (e.g. ignoring an optional CHOICE field). It should be noted that defining the behaviour of a receiver upon receiving a not comprehended choice value is not required if the sender is aware whether or not the receiver supports the extended value.","paragraph_zero_based":44649},{"literal_text_all_w_t_and_m_t":"-A suffix of the form \"vXYZ\" is used for the identifier of each new choice value, e.g. \"choice-vXYZ\".","paragraph_zero_based":44650},{"literal_text_all_w_t_and_m_t":"Non-critical extensions at the end of a message/ of a field contained in an OCTET or BIT STRING:","paragraph_zero_based":44651},{"literal_text_all_w_t_and_m_t":"-When a nonCriticalExtension is actually used, a \"Need\" code should not be provided for the field, which always is a group including at least one extension and a field facilitating further possible extensions. For simplicity, it is recommended not to provide a \"Need\" code when the field is not actually used either.","paragraph_zero_based":44652},{"literal_text_all_w_t_and_m_t":"Further, more general, guidelines:","paragraph_zero_based":44653},{"literal_text_all_w_t_and_m_t":"-In case a need code is not provided for a group, a \"Need\" code is provided for all individual extension fields within the group i.e. including for fields that are not marked as OPTIONAL. The latter is to clarify the action upon absence of the whole group.","paragraph_zero_based":44654},{"literal_text_all_w_t_and_m_t":"A.4.3.3Typical example of evolution of IE with local extensions","paragraph_zero_based":44655},{"literal_text_all_w_t_and_m_t":"The following example illustrates the use of the extension marker for a number of elementary cases (sequence, enumerated, choice). The example also illustrates how the IE may be revised in case the critical extension mechanism is used.","paragraph_zero_based":44656},{"literal_text_all_w_t_and_m_t":"NOTEIn case there is a need to support further extensions of release n while the ASN.1 of release (n+1) has been frozen, without requiring the release n receiver to support decoding of release (n+1) extensions, more advanced mechanisms are needed e.g. including multiple extension markers.","paragraph_zero_based":44657},{"literal_text_all_w_t_and_m_t":"-- /example/ ASN1START","paragraph_zero_based":44658},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44659},{"literal_text_all_w_t_and_m_t":"InformationElement1 ::=             SEQUENCE {","paragraph_zero_based":44660},{"literal_text_all_w_t_and_m_t":"    field1                              ENUMERATED {","paragraph_zero_based":44661},{"literal_text_all_w_t_and_m_t":"                                            value1, value2, value3, value4-v880,","paragraph_zero_based":44662},{"literal_text_all_w_t_and_m_t":"                                            ..., value5-v960 },","paragraph_zero_based":44663}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["91dce424565a76934d98c9adb3c5f09a80dec8c881a0afe02434c7152e1a23a2","bbde93260406b2f19aed35fe4e479028f40739479991ac4f4601cd931fad01bd","5747302446d09de8633026f8b17bd75c0775b8ad17d75660df5cbc8d03e759ef","d169f06d61d41d7f9a94df8c9d63a699e883c5eb413de51fbcd93a77cbba31ba","304fbca99b73dff7a0bd8fb45531c5ead8c183f7585205f91304da9439853b0a","10b86a71f1614db16369f24649e30aebf4e2df9942c3557094228b2f3ea49e8d","450ce7935e9bcb0b4791a84deb1ef85dec8948c7ddfbc53495ddc2673abf92f7","c2949867a30a8c6689fd1f43036f703b94235c7bb6ccd9dcdc228e25aa401990","f4518404b947c7c3b7e55e0e963df1fa47739d9389121daa1f1ab9f210515753","2cb877aafbcb8e46bd0ca7c49d7438864049277d4b929a5c21355