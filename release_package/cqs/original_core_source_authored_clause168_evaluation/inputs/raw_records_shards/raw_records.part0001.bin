{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":19728},{"literal_text_all_w_t_and_m_t":"ssb-ToMeasure","paragraph_zero_based":19729},{"literal_text_all_w_t_and_m_t":"The set of SS blocks to be measured within the SMTC measurement duration (see TS 38.215 [9]). When the field is absent in VarMeasIdleConfig, the UE measures on all SS-blocks.","paragraph_zero_based":19730},{"literal_text_all_w_t_and_m_t":"ss-RSSI-Measurement","paragraph_zero_based":19731},{"literal_text_all_w_t_and_m_t":"Indicates the SSB-based RSSI measurement configuration. If the field is absent in VarMeasIdleConfig, the UE behaviour is defined in TS 38.215 [89], clause 5.1.3.","paragraph_zero_based":19732},{"literal_text_all_w_t_and_m_t":"validityAreaList","paragraph_zero_based":19733},{"literal_text_all_w_t_and_m_t":"Indicates the list of frequencies and optionally, for each frequency, a list of cells within which the UE is required to perform measurements while in RRC_IDLE and RRC_INACTIVE. ","paragraph_zero_based":19734},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19735},{"literal_text_all_w_t_and_m_t":"–MeasIdToAddModList","paragraph_zero_based":19736},{"literal_text_all_w_t_and_m_t":"The IE MeasIdToAddModList concerns a list of measurement identities to add or modify, with for each entry the measId, the associated measObjectId and the associated reportConfigId.","paragraph_zero_based":19737},{"literal_text_all_w_t_and_m_t":"MeasIdToAddModList information element","paragraph_zero_based":19738},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":19739},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASIDTOADDMODLIST-START","paragraph_zero_based":19740},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19741},{"literal_text_all_w_t_and_m_t":"MeasIdToAddModList ::=              SEQUENCE (SIZE (1..maxNrofMeasId)) OF MeasIdToAddMod","paragraph_zero_based":19742},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19743},{"literal_text_all_w_t_and_m_t":"MeasIdToAddMod ::=                  SEQUENCE {","paragraph_zero_based":19744},{"literal_text_all_w_t_and_m_t":"    measId                              MeasId,","paragraph_zero_based":19745},{"literal_text_all_w_t_and_m_t":"    measObjectId                        MeasObjectId,","paragraph_zero_based":19746},{"literal_text_all_w_t_and_m_t":"    reportConfigId                      ReportConfigId","paragraph_zero_based":19747},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":19748},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19749},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASIDTOADDMODLIST-STOP","paragraph_zero_based":19750},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":19751}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["96ba640ad1db4307efff93b3dd9d5af4deca8f85b96e1f2a40c671aeb3ddf600","12bc4dee74eafbee6c8ea63646da497a48e77012ddd52aef57a0e07a27b10e03","b57c1a88289432afa4d6f4dc677b4e702773bb392fded6237767858dbccd5927","8ff6ff4189313dd491cc51ea2352657b224ea71f3e9f9f14124b9ca1d6716c20","d2f14f386138c427df9ca2c3c825e720569ea2a5c6242effbcccdfbd66251d0f","bd2dfc1369fccbaa44c0d1d030aa098a4c87245305a9cbb63a81169dd790ef85","41d1cd8693e3ac9aa1d0268a98c8d280197b5888886b2a44755a2141c32a69eb","de5e21bba0441da6d6057101f1d3a2e7d37e75c1447071a7ce5cc510a3285cd3","3f3c2e0a4f9a3c842cb91f44be554643a47162e189ed3a8d6514691c91823b5f","0ae9c9dfc11961513b8f6fbec68195f28d3bb235c043fc58ea62424312a53413","c5680718755c4bf949b5df485ee1a543f422bf3bc22f341ce352792e