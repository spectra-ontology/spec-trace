{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21984},{"literal_text_all_w_t_and_m_t":"-- TAG-PDCCH-CONFIGSIB1-START","paragraph_zero_based":21985},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21986},{"literal_text_all_w_t_and_m_t":"PDCCH-ConfigSIB1 ::=                SEQUENCE {","paragraph_zero_based":21987},{"literal_text_all_w_t_and_m_t":"    controlResourceSetZero              ControlResourceSetZero,","paragraph_zero_based":21988},{"literal_text_all_w_t_and_m_t":"    searchSpaceZero                     SearchSpaceZero","paragraph_zero_based":21989},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21990},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21991},{"literal_text_all_w_t_and_m_t":"-- TAG-PDCCH-CONFIGSIB1-STOP","paragraph_zero_based":21992},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21993},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21994},{"literal_text_all_w_t_and_m_t":"PDCCH-ConfigSIB1 field descriptions","paragraph_zero_based":21995},{"literal_text_all_w_t_and_m_t":"controlResourceSetZero","paragraph_zero_based":21996},{"literal_text_all_w_t_and_m_t":"Determines a common ControlResourceSet (CORESET) with ID #0, see TS 38.213 [13], clause 13.","paragraph_zero_based":21997},{"literal_text_all_w_t_and_m_t":"searchSpaceZero","paragraph_zero_based":21998},{"literal_text_all_w_t_and_m_t":"Determines a common search space with ID #0, see TS 38.213 [13], clause 13.","paragraph_zero_based":21999},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22000},{"literal_text_all_w_t_and_m_t":"–PDCCH-ServingCellConfig","paragraph_zero_based":22001},{"literal_text_all_w_t_and_m_t":"The IE PDCCH-ServingCellConfig is used to configure UE specific PDCCH parameters applicable across all bandwidth parts 