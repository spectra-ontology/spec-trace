002a998dfa105139c9a4bb7bc147","2bbd2fd184db8e07218d74a4ce8817e40a6621945eb94a40e69109cbc2f15037","e031435dcd7cfbac69b9f6a7a5a3838e764de31dd72d6617d3849cef1ccd98bd","fc8b7b7e0ae6073a4a4f584ab8e968ab76e4e46d9e95f262cd4e01ad0547b953","4c0c4a9e8e5e954b5ff9ca4ab8c89b164697f7fef079c3cd1e9878f4d742b433","fb878b8628f693c75bc9d64bda5502367b541a789f625428c23575f8a37cfd64","2f6bd7b66da338a40bf5868a0eeaf5dc76b3acc461cfa6bd10a37fe9cbe0e494","94e4265860884e7778022ddf1407b7e7e85587d6850f3a88e8aff81a425fcc8e","40b72b61f06e2f437a4e916b0d6b6d841ea885ca81eb4ff8dc22f6705b1952da","ec0aa854801b3b8d7c3834d6b26af6f2892d43884f550c8b847fa365f6e0210a","bc1b0a1c2f6fb5d3410cc6f303a877cdb0a9a2ac1b7afad630bae2784f4140ae"],"paragraph_range_zero_based":[36984,37007],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p36984"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    rttAccuracy-r16                  INTEGER (0..255)             OPTIONAL,","paragraph_zero_based":37008},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":37009},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37010},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37011},{"literal_text_all_w_t_and_m_t":"-- TAG-LOGMEASRESULTLISTWLAN-STOP","paragraph_zero_based":37012},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":37013},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37014},{"literal_text_all_w_t_and_m_t":"LogMeasResultListWLAN field descriptions","paragraph_zero_based":37015},{"literal_text_all_w_t_and_m_t":"Bssid","paragraph_zero_based":37016},{"literal_text_all_w_t_and_m_t":"Basic Service Set Identifier (BSSID) defined in IEEE 802.11-2012 [50].","paragraph_zero_based":37017},{"literal_text_all_w_t_and_m_t":"Hessid","paragraph_zero_based":37018},{"literal_text_all_w_t_and_m_t":"Homogenous Extended Service Set Identifier (HESSID) defined in IEEE 802.11-2012 [50].","paragraph_zero_based":37019},{"literal_text_all_w_t_and_m_t":"rssiWLAN","paragraph_zero_based":37020},{"literal_text_all_w_t_and_m_t":"Measured WLAN RSSI result in dBm. The IE WLAN-RSSI-Range specifies the value range used in WLAN RSSI measurements and thresholds. Integer value for WLAN RSSI measurements is according to mapping table in TS 36.133 [40]. Value 0 corresponds to –infinity, value 1 to -100dBm, value 2 to -99dBm, and so on (i.e. in steps of 1dBm) until value 140, which corresponds to 39dBm, while value 141 corresponds to +infinity.","paragraph_zero_based":37021},{"literal_text_all_w_t_and_m_t":"rtt-WLAN","paragraph_zero_based":37022},{"literal_text_all_w_t_and_m_t":"This field provides the measured roundtrip time between the target device and WLAN AP and optionally the accuracy expressed as the standard deviation of the delay. Units for each of these are 1000ns, 100ns, 10ns, 1ns, and 0.1ns as defined in TS 37.355 [49].","paragraph_zero_based":37023},{"literal_text_all_w_t_and_m_t":"rttValue","paragraph_zero_based":37024},{"literal_text_all_w_t_and_m_t":"This field specifies the Round Trip Time (RTT) measurement between the target device and WLAN AP in units given by the field rttUnits as defined in TS 37.355 [49].","paragraph_zero_based":37025},{"literal_text_all_w_t_and_m_t":"rttUnits","paragraph_zero_based":37026},{"literal_text_all_w_t_and_m_t":"This field specifies the Units for the fields rttValue and rttAccuracy. The available Units are 1000ns, 100ns, 10ns, 1ns, and 0.1ns as defined in TS 37.355 [49].","paragraph_zero_based":37027},{"literal_text_all_w_t_and_m_t":"rttAccuracy","paragraph_zero_based":37028},{"literal_text_all_w_t_and_m_t":"This field provides the estimated accuracy of the provided rttValue expressed as the standard deviation in units given by the field rttUnits as defined in TS 37.355 [49].","paragraph_zero_based":37029},{"literal_text_all_w_t_and_m_t":"Ssid","paragraph_zero_based":37030},{"literal_text_all_w_t_and_m_t":"Service Set Identifier (SSID) defined in IEEE 802.11-2012 [50].","paragraph_zero_based":37031}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["13bd8e64a7949a94d5124d135ecd2ea67e72c5a732580ce064ecb27098e4a7bf","d8fd63ab121092285fc8b7002a46644a3c3ed311fc00e86d6f6102d45694506a","73ed19f22a9e9a8eb0d2f1db5b243ed3a146ec335839a3e4c6d9b316ea3a4aee","a6bc98df0cd8fef0a85168154aca37e633eb1eb4f1d574101ca0fb3f8e824291","f1d5abdb8a60255d4294e64a27abf58d762b72267e8b982d2f