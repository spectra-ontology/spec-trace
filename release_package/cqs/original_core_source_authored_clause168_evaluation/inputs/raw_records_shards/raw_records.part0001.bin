{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"CSI-FrequencyOccupation information element","paragraph_zero_based":17016},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17017},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-FREQUENCYOCCUPATION-START","paragraph_zero_based":17018},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17019},{"literal_text_all_w_t_and_m_t":"CSI-FrequencyOccupation ::=         SEQUENCE {","paragraph_zero_based":17020},{"literal_text_all_w_t_and_m_t":"    startingRB                          INTEGER (0..maxNrofPhysicalResourceBlocks-1),","paragraph_zero_based":17021},{"literal_text_all_w_t_and_m_t":"    nrofRBs                             INTEGER (24..maxNrofPhysicalResourceBlocksPlus1),","paragraph_zero_based":17022},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":17023},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":17024},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17025},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-FREQUENCYOCCUPATION-STOP","paragraph_zero_based":17026},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17027},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17028},{"literal_text_all_w_t_and_m_t":"CSI-FrequencyOccupation field descriptions","paragraph_zero_based":17029},{"literal_text_all_w_t_and_m_t":"nrofRBs","paragraph_zero_based":17030},{"literal_text_all_w_t_and_m_t":"Number of PRBs across which this CSI resource spans. Only multiples of 4 are allowed. The smallest configurable number is the minimum of 24 and the width of the associated BWP. If the configured value is larger than the width of the corresponding BWP, the UE shall assume that the actual CSI-RS bandwidth is equal to the width of the BWP.","paragraph_zero_based":17031},{"literal_text_all_w_t_and_m_t":"startingRB","paragraph_zero_based":17032},{"literal_text_all_w_t_and_m_t":"PRB where this CSI resource starts in relation to common resource block #0 (CRB#0) on the common resource block grid. Only multiples of 4 are allowed (0, 4, ...)","paragraph_zero_based":17033},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17034},{"literal_text_all_w_t_and_m_t":"–CSI-IM-Resource","paragraph_zero_based":17035},{"literal_text_all_w_t_and_m_t":"The IE CSI-IM-Resource is used to configure one CSI Interference Management (IM) resource.","paragraph_zero_based":17036},{"literal_text_all_w_t_and_m_t":"CSI-IM-Resource information element","paragraph_zero_based":17037},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17038},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-IM-RESOURCE-START","paragraph_zero_based":17039}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["f47c4bc8746f113c56c4167503e54d452d9c2891f810797843dc07a790150248","e215c0de4fc89ca0215867479613c48fe914c2ef657a3233f78f79b72e17d537","f814402ebc2d62b7954d129eb0696487924142080683601216e3ac252269be58","fc63138e6e6a3839c95c349b98371ab3680a0a4e0f51770ec0667b8be9070779","6db1324544ddfec9b043a1ee5efd7adeba0db3a5c345cfe6907b45b1c136f36c","1b9e6298c5dc2c13d97a98a24a5aa0fcfad89320e6a1a8ce0b7c183b00faebac","6716c49d1ffc92ab1d307f82825b4be549e00eaf60ef78785cbec54aca47ea28","6ff03160b125e3321093655fa8c23e8fb40d2f3432d95ca8b27a831d2bd86634","3290831870ee913c7385da944925e8bd2bdb8434ce2575933986ce12ba741baa","ea157746ce7a118d0b4c0b2e5b26cad2ddadbedace8e0e19a25bcaaef8da9460","1d0b77df2fe6dfa2c72352ae453b01b5bc6d0ed834de3ebd30bf0511969c3ae1","e2bc62df82e6404b301b035ebdbd62042d458a5e8634b44117c7a8b1f9eaa575","fcab2a3abf6ddea8b