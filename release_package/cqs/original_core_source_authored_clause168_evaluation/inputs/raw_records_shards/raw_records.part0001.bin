esAlt-1-r16)","paragraph_zero_based":31642},{"literal_text_all_w_t_and_m_t":"                                                               OPTIONAL,","paragraph_zero_based":31643},{"literal_text_all_w_t_and_m_t":"    nCJT1SP-eType2R2PS-null-r16  SEQUENCE (SIZE (1..maxNrofCSI-RS-ResourcesExt-r16)) OF INTEGER (0..maxNrofCSI-RS-ResourcesAlt-1-r16)","paragraph_zero_based":31644},{"literal_text_all_w_t_and_m_t":"                                                               OPTIONAL,","paragraph_zero_based":31645},{"literal_text_all_w_t_and_m_t":"    nCJT1SP-Type2-Type2PS-r16    SEQUENCE (SIZE (1..maxNrofCSI-RS-ResourcesExt-r16)) OF INTEGER (0..maxNrofCSI-RS-ResourcesAlt-1-r16)","paragraph_zero_based":31646},{"literal_text_all_w_t_and_m_t":"                                                               OPTIONAL,","paragraph_zero_based":31647},{"literal_text_all_w_t_and_m_t":"    -- {Codebook 2, Codebook 3} = {\"New Rel17 combinations in FG 23-9-5\"}","paragraph_zero_based":31648},{"literal_text_all_w_t_and_m_t":"    nCJT-feType2PS-null-r17         SEQUENCE (SIZE (1..maxNrofCSI-RS-ResourcesExt-r16)) OF INTEGER (0..maxNrofCSI-RS-ResourcesAlt-1-r16)","paragraph_zero_based":31649},{"literal_text_all_w_t_and_m_t":"                                                               OPTIONAL,","paragraph_zero_based":31650},{"literal_text_all_w_t_and_m_t":"    nCJT-feType2PS-M2R1-null-r17    SEQUENCE (SIZE (1..maxNrofCSI-RS-ResourcesExt-r16)) OF INTEGER (0..maxNrofCSI-RS-ResourcesAlt-1-r16)","paragraph_zero_based":31651},{"literal_text_all_w_t_and_m_t":"                                                               OPTIONAL,","paragraph_zero_based":31652},{"literal_text_all_w_t_and_m_t":"    nCJT-feType2PS-M2R2-null-r17    SEQUENCE (SIZE (1..maxNrofCSI-RS-ResourcesExt-r16)) OF INTEGER (0..maxNrofCSI-RS-ResourcesAlt-1-r16)","paragraph_zero_based":31653},{"literal_text_all_w_t_and_m_t":"                                                               OPTIONAL,","paragraph_zero_based":31