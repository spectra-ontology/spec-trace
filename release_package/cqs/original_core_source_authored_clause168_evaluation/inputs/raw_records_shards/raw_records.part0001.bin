{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        logicalChannelGroupIAB-Ext-r17      INTEGER (0..maxLCG-ID-IAB-r17)                                      OPTIONAL,   -- Need R","paragraph_zero_based":19104},{"literal_text_all_w_t_and_m_t":"        allowedHARQ-mode-r17                ENUMERATED {harqModeA, harqModeB}                                   OPTIONAL    -- Need R","paragraph_zero_based":19105},{"literal_text_all_w_t_and_m_t":"        ]]","paragraph_zero_based":19106},{"literal_text_all_w_t_and_m_t":"    }                                                                                                       OPTIONAL,   -- Cond UL","paragraph_zero_based":19107},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":19108},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":19109},{"literal_text_all_w_t_and_m_t":"    channelAccessPriority-r16           INTEGER (1..4)                                                      OPTIONAL,   -- Need R","paragraph_zero_based":19110},{"literal_text_all_w_t_and_m_t":"    bitRateMultiplier-r16               ENUMERATED {x40, x70, x100, x200}                                   OPTIONAL    -- Need R","paragraph_zero_based":19111},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":19112},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":19113},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19114},{"literal_text_all_w_t_and_m_t":"-- TAG-LOGICALCHANNELCONFIG-STOP","paragraph_zero_based":19115},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":19116},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19117},{"literal_text_all_w_t_and_m_t":"LogicalChannelConfig field descriptions","paragraph_zero_based":19118},{"literal_text_all_w_t_and_m_t":"allowedCG-List","paragraph_zero_based":19119},{"literal_text_all_w_t_and_m_t":"This restriction applies only when the UL grant is a configured grant. If present, UL MAC SDUs from this logical channel can only be mapped to the indicated configured grant configuration. If the size of the sequence is zero, then UL MAC SDUs from this logical channel cannot be mapped to any configured grant configurations. If the field is not present, UL MAC SDUs from this logical channel can be mapped to any configured grant configurations. If the field configuredGrantType1Allowed is present, only those configured grant type 1 configuration indicated in this sequence are allowed for use by this logical channel; otherwise, this sequence shall not include any configured grant type 1 configuration. Corresponds to \"allowedCG-List\" as specified in TS 38.321 [3]. This field is ignored when SDT procedure is ongoing.","paragraph_zero_based":19120},{"literal_text_all_w_t_and_m_t":"allowedHARQ-mode","paragraph_zero_based":19121},{"literal_text_all_w_t_and_m_t":"Indicates the allowed HARQ mode of a HARQ process mapped to this logical channel. If the parameter is absent, there is no restriction for HARQ mode for the mapping. This field applies to SRB1, SRB2 and DRBs.","paragraph_zero_based":19122},{"literal_text_all_w_t_and_m_t":"allowedPHY-PriorityIndex","paragraph_zero_based":19123},{"literal_text_all_w_t_and_m_t":"This restriction applies only when the UL grant is a dynamic grant. If the field is present and the dynamic grant has a PHY-priority index, UL MAC SDUs from this logical channel can only be mapped to the dynamic grants indicating PHY-priority index equal to the values configured by this field. If the field is present and the dynamic grant does not have a PHY-priority index, UL MAC SDUs from this logical channel can only be mapped to this dynamic grant if the value of the field is p0, see TS 38.213 [13], clause 9. If the field is not present, UL MAC SDUs from this logical channel can be mapped to any dynamic grants. Corresponds to \"allowedPHY-PriorityIndex\" as specified in TS 38.321 [3].","paragraph_zero_based":19124},{"literal_text_all_w_t_and_m_t":"allowedSCS-List","paragraph_zero_based":19125},{"literal_text_all_w_t_and_m_t":"If present, UL MAC SDUs from this logical channel can only be mapped to the indicated numerology. Otherwise, UL MAC SDUs from this logical channel can be mapped to any configured numerology. Corresponds to 'allowedSCS-List' as specified in TS 38.321 [3].","paragraph_zero_based":19126},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":19127}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["f7a9ab82c682e37e5e00829feffed3a0a6a54103962bb4027b51df4e401b1211","cb00503663ba1da2bec630b99500e9ac5f8efe271c8c9bd7d9dad5191ed19c9b","59778dd7f705f894d2a7342e10e9c853308fac4777efdbf656821060b6a2af05","76514d1e89afce58fed987f88c1d1157aad576172c115aa59e4f020b3a719925","833b77f1835e7708d861ee8e8f19e620b7a5e594347975b2c7dc3d47e4eada0b","4e80f013cad3f144d5b3a3a4cdc0871bbac396da1d7d1eb5bef967df4cb01f78","9663e203c6e35b62a4965e070ca4e3c34869343272b95b4fde3dbfaf102d6fd8","ec17295030a8e51162b91d4e6ed3a03f495050e272c60601ba041b2f66fd4f85","663ac0a1f37e8e15bc4925f347afba18dfdcc92a58ca4992785be2ab3bc37140","1febda6becdbacde17a1bd4968b1a80f66cfba47a4b56c702337f6d742903c89","cde24e9aea4396c8a054338d231043e876689d649dcbb47e0985e5b8874bd2b4","78298d49003fd11487d46a5c39be705aa95c07d2596355f5d7483b47a1ab2319","8426690f819a7cda6da115f200e710710a88f460e70e354df7d779fd148a61b0","60d3926be0426938de5d0e7d28f6645084cb753065ed7e405c82b9d69c151bcf","946dae19978ac78cd4e49ff9b9669d2ccdfa07ce4148a2eb8bc7849da86a03c1","f7b408c0a3c49a6a9921dd405f6dcfa61db17b2c188200bfb74153f73345321d","908a1f9c58c008242574dbe1f841ffb8f72c5789bc409db6f39d328ebfebefdc","7335b9576391c2cd36ac6088715675d149b52c86a2f79171f471656db7e89b7c","92967225aee4b0748ba606963c787d544558ac1a35f1627b6893a2f596d56723","c0d6e38f95aaf07ac6e5edca83cfdf7799211da3853cf8b6b0444ac6114d4bf0","a95bea1e68808bf832803fb5edeb80a84bc3b42ca25360a30232dfd2c23957c8","a5b53666489d34d98402afe4cf848ffbf42b3f72a351496983b1ab26c382bee6","096f216e5d135a84473b294d382ac55e54482db131fad1cf0fca3f65b0bdc14f","44c3e5b03d82f7b6ef8894ffc580593393a9dfda91143054b6733bb85f5665e4"],"paragraph_range_zero_based":[19104,19127],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p19104"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"FR1:    15, 30, or 60 kHz","paragraph_zero_based":19128},{"literal_text_all_w_t_and_m_t":"FR2-1:  60 or 120 kHz","paragraph_zero_based":19129},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":19130},{"literal_text_all_w_t_and_m_t":"allowedServingCells","paragraph_zero_based":19131},{"literal_text_all_w_t_and_m_t":"If present, UL MAC SDUs from this logical channel can only be mapped to the serving cells indicated in this list. Otherwise, UL MAC SDUs from this logical channel can be mapped to any configured serving cell of this cell group. Corresponds to 'allowedServingCells' in TS 38.321 [3].","paragraph_zero_based":19132},{"literal_text_all_w_t_and_m_t":"bitRateMultiplier","paragraph_zero_based":19133},{"literal_text_all_w_t_and_m_t":"Bit rate multiplier for recommended bit rate MAC CE as specified in TS 38.321 [3]. Value x40 indicates bit rate multiplier 40, value x70 indicates bit rate multiplier 70 and so on.","paragraph_zero_based":19134},{"literal_text_all_w_t_and_m_t":"bitRateQueryProhibitTimer","paragraph_zero_based":19135},{"literal_text_all_w_t_and_m_t":"The timer is used for bit rate recommendation query in TS 38.321 [3], in seconds. Value s0 means 0 s, s0dot4 means 0.4 s and so on.","paragraph_zero_based":19136},{"literal_text_all_w_t_and_m_t":"bucketSizeDuration","paragraph_zero_based":19137},{"literal_text_all_w_t_and_m_t":"Value in ms. ms5 corresponds to 5 ms, value ms10 corresponds to 10 ms, and so on.","paragraph_zero_based":19138},{"literal_text_all_w_t_and_m_t":"channelAccessPriority","paragraph_zero_based":19139},{"literal_text_all_w_t_and_m_t":"Indicates the Channel Access Priority Class (CAPC), as specified in TS 38.300 [2], to be used on uplink transmissions for operation with shared spectrum channel access in FR1. The network configures this field only for SRB2 and DRBs.","paragraph_zero_based":19140},{"literal_text_all_w_t_and_m_t":"configuredGrantType1Allowed","paragraph_zero_based":19141},{"literal_text_all_w_t_and_m_t":"If present, or if the capability lcp-Restriction as specified in TS 38.306 [26] is not supported, UL MAC SDUs from this logical channel can be transmitted on a configured grant type 1. Otherwise, UL MAC SDUs from this logical channel cannot be transmitted on a configured grant type 1. Corresponds to 'configuredGrantType1Allowed' in TS 38.321 [3]. This field is ignored when SDT procedure is ongoing.","paragraph_zero_based":19142},{"literal_text_all_w_t_and_m_t":"logicalChannelGroup, logicalChannelGroupIAB-Ext","paragraph_zero_based":19143},{"literal_text_all_w_t_and_m_t":"ID of the logical channel group, as specified in TS 38.321 [3], which the logical channel belongs to. The logicalChannelGroupIAB-Ext is only applicable to the IAB-MT. When logicalChannelGroupIAB-Ext is configured, logicalChannelGroup shall be ignored.","paragraph_zero_based":19144},{"literal_text_all_w_t_and_m_t":"logicalChannelSR-Mask","paragraph_zero_based":19145},{"literal_text_all_w_t_and_m_t":"Controls SR triggering when a configured uplink grant of type1 or type2 is configured. true indicates that SR masking is configured for this logical channel as specified in TS 38.321 [3].","paragraph_zero_based":19146},{"literal_text_all_w_t_and_m_t":"logicalChannelSR-DelayTimerApplied","paragraph_zero_based":19147},{"literal_text_all_w_t_and_m_t":"Indicates whether to apply the delay timer for SR transmission for this logical channel. Set to false if logicalChannelSR-DelayTimer is not included in BSR-Config.","paragraph_zero_based":19148},{"literal_text_all_w_t_and_m_t":"maxPUSCH-Duration","paragraph_zero_based":19149},{"literal_text_all_w_t_and_m_t":"If present, UL MAC SDUs from this logical channel can only be transmitted using uplink grants that result in a PUSCH duration shorter than or equal to the duration indicated by this field. Otherwise, UL MAC SDUs from this logical channel can be transmitted using an uplink grant resulting in any PUSCH duration. Corresponds to \"maxPUSCH-Duration\" in TS 38.321 [3]. The PUSCH duration is calculated based on the same length of all symbols, and the shortest length applies if the symbol lengths are different.","paragraph_zero_based":19150},{"literal_text_all_w_t_and_m_t":"priority","paragraph_zero_based":19151}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["0fd4eb8f5241540fd2b06584cfe310170dec7468bddaa76f1d1923db8f8b2842","4066ab7b9fd95387df242c8e90be6b6ea4fe14bc2333a64509ae34357a42838e","00d212b613f9c3c660c9b194b7049481af7c8cec9394e7d9f7b1ff142dd4ba92","f17aa56f713dfcaae7facf553bd7b6cba8a60011d15cdc37fb62c247c57bdd11","cb779932e0129b27a3c86a5dd728920ae68c9ebe2c23f0a681a2bfe5e43b6d82","6fc362fea633d843391dab5f88f0d78a1914a0424a0144d6a5fe938a2917ec9b","6d148d1750f15872a546136f844c0eb992d7c67c2493fd36eb4359f87fc7a9fd","5123ca92e1f88e87317ec466db5c4c06d722a38983face4b91bc4cf15900c61c","daad431b6534a99b47529387d03ddc5a6205f6cbf7ead550bf9541673e6f2d4e","6fc94b52af805e2b0e5e7dd8e3be186229d27d1c55c01c0e48b80258645a12d8","e004d515c5487b0a5d71243ae950f5336463e1b50ca69d5725e422284c89166b","c949ce230a86fcc31b809a2182439545fd60d9f7eb4807b9a49e8bcb6d14d710","bfc3a87edc6419f23be38f9b33e3fc9903374e5e80e916ef4c3467bdb078de0b","a605ceed71a47c0f013f9da860a724c2fa4abe1bf6a299a1c5f3a56cf3f2bdc4","096ee65db706e9ce2f4832c5f2b8227f9a6c007d693f056dd2257e74c109c0ee","1cd0c50ecdfa3c6bbdd4c1b63982916dfda6f7544c3e6cf319d5117121551407","c3f1b85cc9d31c88e2920f66b4d9d193b9fff0512e89db6ee8b83311fb1c4e36","dc366a139548c5305ff7a19ba84fa9c5a572059f83131be5824de67c4f7ee1ab","bdf19e89b03334eab800cf558c24944ae375e76357f4fde9b9158ee21f4cbac2","7fa6c5dbd18a80131f35697a690ea53e0e0aff655d4c712940cdc8fbd6642b08","ce6206252e1644370d28f1cc323ccc9b313ce2bd74d8d9842ea30419c100637f","c996bb98ffebec6c1d74a82d8cb038a1b610359d833b8b8c1fd9b5755077b02c","c446c9fd97dce02581fcffd203e55a4d3cee70489c5079355fb6d47fed008b8a","6ff6aca93d08a4e43ee1f05abfa2ad620fee469dfaaf07be775432a6b007a25c"],"paragraph_range_zero_based":[19128,19151],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p19128"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Logical channel priority, as specified in TS 38.321 [3].","paragraph_zero_based":19152},{"literal_text_all_w_t_and_m_t":"prioritisedBitRate","paragraph_zero_based":19153},{"literal_text_all_w_t_and_m_t":"Value in kiloBytes/s. Value kBps0 corresponds to 0 kiloBytes/s, value kBps8 corresponds to 8 kiloBytes/s, value kBps16 corresponds to 16 kiloBytes/s, and so on. For SRBs, the value can only be set to infinity.","paragraph_zero_based":19154},{"literal_text_all_w_t_and_m_t":"schedulingRequestId","paragraph_zero_based":19155},{"literal_text_all_w_t_and_m_t":"If present, it indicates the scheduling request configuration applicable for this logical channel, as specified in TS 38.321 [3].","paragraph_zero_based":19156},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19157},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":19158},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":19159},{"literal_text_all_w_t_and_m_t":"PDCP-CADuplication","paragraph_zero_based":19160},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the DRB/SRB associated with this logical channel is configured with PDCP CA duplication in UL in the cell group in which this IE is included (i.e. the PDCP entity is associated with multiple RLC entities belonging to this cell group). Otherwise the field is optionally present, need R.","paragraph_zero_based":19161},{"literal_text_all_w_t_and_m_t":"UL","paragraph_zero_based":19162},{"literal_text_all_w_t_and_m_t":"The field is mandatory present for a logical channel with uplink if it serves DRB or multicast MRB. It is optionally present, Need R, for a logical channel with uplink if it serves an SRB. Otherwise it is absent.","paragraph_zero_based":19163},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19164},{"literal_text_all_w_t_and_m_t":"–LogicalChannelIdentity","paragraph_zero_based":19165},{"literal_text_all_w_t_and_m_t":"The IE LogicalChannelIdentity is used to identify one logical channel (LogicalChannelConfig) and the corresponding RLC bearer (RLC-BearerConfig) or BH RLC channel (BH-RLC-ChannelConfig) or Uu Relay RLC channel (Uu-RelayRLC-ChannelConfig) or PC5 Relay RLC channel (SL-RLC-ChannelConfig).","paragraph_zero_based":19166},{"literal_text_all_w_t_and_m_t":"LogicalChannelIdentity information element","paragraph_zero_based":19167},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":19168},{"literal_text_all_w_t_and_m_t":"-- TAG-LOGICALCHANNELIDENTITY-START","paragraph_zero_based":19169},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19170},{"literal_text_all_w_t_and_m_t":"LogicalChannelIdentity ::=          INTEGER (1..maxLC-ID)","paragraph_zero_based":19171},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19172},{"literal_text_all_w_t_and_m_t":"-- TAG-LOGICALCHANNELIDENTITY-STOP","paragraph_zero_based":19173},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":19174},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19175}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["4239be721f864e402fb82b68d5ffe5fff422d732b9393a0101a006b9a361a326","f32cd8bc16441a89b84f2579fec74cfdfb11562105f342211a65593c1981a084","e7f84ebe8ceefa17500ca959f8661ffd9e513e060aa2210d0e8dd264e71fface","ccf82dd50421b9bce8997bbecb7bd358d6d87192ed6f0fbffa17c407f5a8a099","22c5c27552986378588f4f307cb6ab42bef9741dbeaa14312bc789b99650d1e9","6a31687172361e43bc9ca16e6fb57e3adf555eea648407538cccc7bc63d0c83d","a40be57b667188e2b342e35a1dd2cff96b9db6ea57ec91731316b78cfd69041a","a9aabb4f304c4f11303441cb664ecb166f34310296a222dd1c9af8eb48beefc6","cb613529b7619d3c7effdf935217db64df84fa8368d098bda42918e85434c147","8ec411449be9a453fb14cd37a71e2086d396a676aefd48d12aa500d35ee91e53","537c05abf5784fd884f47fb5e43fa25db18203a54def331a4499d76ba4356f9d","ba33e2a169470ae9713d55578facf492da9095a98c4f114782b9eee0b21f10fb","986e2e9afbc8816c6b465993b2a8d44a462a02f147ec05a8be0f25e0be637fbd","cc17bdff268fd01b3be4db73e2d27458011766857ea74c27438bf61680bf03c2","369a9272ead6095b24c6d780ee5f190a1ed0bc869e16ef81a5ade6ebc83bd99a","d852e76e1fed89e8accdd88c99562e4bb3a242c99a5efc112f76c60c7b424ffe","128971a15b23cb28ae07137c97bbdbfddb08169a39361b9173ae02e64ff57ed4","86baea712a39bb435a57a05af8b644492cc65676fa375ae00c991307cfb00e7e","04f820ee59cb6188d4599d4caaa4751b4eb46f0d2c815aaa81434380443a2f4d","50b37aae184bdb684b89fb052ccdb987dfbde1c720a6645a548edced1ab810d5","234b015c6516cdc4952034d1ccdd8921c1a19635d9d52a252ff8f07b73c792ae","23a573a83662d32e627f5c3c1ed79b68433b89ef825c58da98688f7e0f2c6e12","657432e976732771f4681834e408143dde0df642b51e4ce226bf836d4afd6dfc","9576a9f9ae6b63adcc69eacd20e5675d8f2f986681b7d584613429484a060172"],"paragraph_range_zero_based":[19152,19175],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p19152"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–LTE-NeighCellsCRS-AssistInfoList","paragraph_zero_based":19176},{"literal_text_all_w_t_and_m_t":"The IE LTE-NeighCellsCRS-AssistInfoList-r17 is used to provide configuration information of neighbour LTE cells to assist the UE to perform CRS interference mitigation (CRS-IM) in scenarios with overlapping spectrum for LTE and NR.","paragraph_zero_based":19177},{"literal_text_all_w_t_and_m_t":"LTE-NeighCellsCRS-AssistInfoList information element","paragraph_zero_based":19178},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":19179},{"literal_text_all_w_t_and_m_t":"-- TAG-LTE-NEIGHCELLSCRS-ASSISTINFOLIST-START","paragraph_zero_based":19180},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19181},{"literal_text_all_w_t_and_m_t":"LTE-NeighCellsCRS-AssistInfoList-r17 ::= SEQUENCE (SIZE (1..maxNrofCRS-IM-InterfCell-r17)) OF LTE-NeighCellsCRS-AssistInfo-r17","paragraph_zero_based":19182},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19183},{"literal_text_all_w_t_and_m_t":"LTE-NeighCellsCRS-AssistInfo-r17 ::=     SEQUENCE {","paragraph_zero_based":19184},{"literal_text_all_w_t_and_m_t":"    neighCarrierBandwidthDL-r17              ENUMERATED {n6, n15, n25, n50, n75, n100, spare2, spare1}   OPTIONAL,   -- Cond CRS-IM","paragraph_zero_based":19185},{"literal_text_all_w_t_and_m_t":"    neighCarrierFreqDL-r17                   INTEGER (0..16383)                                          OPTIONAL,   -- Need S","paragraph_zero_based":19186},{"literal_text_all_w_t_and_m_t":"    neighCellId-r17                          EUTRA-PhysCellId                                            OPTIONAL,   -- Need S","paragraph_zero_based":19187},{"literal_text_all_w_t_and_m_t":"    neighCRS-muting-r17                      ENUMERATED {enabled}                                        OPTIONAL,   -- Need R","paragraph_zero_based":19188},{"literal_text_all_w_t_and_m_t":"    neighMBSFN-SubframeConfigList-r17        EUTRA-MBSFN-SubframeConfigList                              OPTIONAL,   -- Need S","paragraph_zero_based":19189},{"literal_text_all_w_t_and_m_t":"    neighNrofCRS-Ports-r17                   ENUMERATED {n1, n2, n4}                                     OPTIONAL,   -- Need S","paragraph_zero_based":19190},{"literal_text_all_w_t_and_m_t":"    neighV-Shift-r17                         ENUMERATED {n0, n1, n2, n3, n4, n5}                         OPTIONAL    -- Cond NotCellID","paragraph_zero_based":19191},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":19192},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19193},{"literal_text_all_w_t_and_m_t":"-- TAG-LTE-NEIGHCELLSCRS-ASSISTINFOLIST-STOP","paragraph_zero_based":19194},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":19195},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19196},{"literal_text_all_w_t_and_m_t":"LTE-NeighCellsCRS-AssistInfo field descriptions","paragraph_zero_based":19197},{"literal_text_all_w_t_and_m_t":"neighCarrierBandwidthDL","paragraph_zero_based":19198},{"literal_text_all_w_t_and_m_t":"Indicates the channel bandwidth of the neighbour LTE cell in number of PRBs. If the field is absent, the UE applies the value of carrierBandwidthDL indicated in RateMatchPatternLTE-CRS for this serving cell, if configured.","paragraph_zero_based":19199}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["5c2973f4bab7b80385d1477daee6de3421c40fa6fdc91da81dbe80f5fc18ec77","d9eaa65a44a88f974f77cf8934446e2a9d372291e98ca8fa04547ecbce3cabe5","b2b5865a414a259ec42970bba75a2257ace6f65545e66034d6705c7521e2b84d","d9a8b0b5ac73aaade50ddfc61525049913fcd10860ab0d39ceea00446f56b4fc","f6faa45983990433f8f1a9fd803667ac85ffa9accfe0f70858ba6b7f3cae1f04","2b90991f8424c4ad0ab068a4a75f01fda66a2c7582b2c79ed0fd38f468f73fb1","617f5f2c6759e6de4b93928ef9ca6b47fc748ace49c7f530673b2eb2d011a237","e0499d9a1a1d6e97cdccfda65475f61e844593140c7f25987c863b8c9c906153","c8414f87db4d43da5cefe054b126bce06cccb5e245cc5cf16dae99412f9c1903","4a8744026093d7267768b676fb0ab2ab3949ff20bced0cfc38434d250d1e8cde","f4bfc0beccfe64355d52159ff103ecd0b14fd76d10d401c30a25ce521193ffe7","ecbcd926b6a40e5cefc12238c087348d178f44016b7ac9c8f9761a12b8bd1d93","050415869e501d16a73f11632313fc5bab2bcf922cb4ea326d8ed23b4897eb5b","f28b984d07f12ba077df70102ccb7daec8c4eb5ffd0c995dc87e4ba133bd9a8b","1fd55c4ba4a6a3d8efabed0dfa0bb5fba32faffb2af27ebe6cae4076bda03036","be43a8c1e0a15b93fef06fc7c3d6b60dc580d2cbb1e053db250b0dc663960395","34790497df183abf36c47faba26b9001c37d711ac2e8d0843f36497e9d959cd5","91e72198500ca850c666fc890612847ef20ef33ce7795a630c29b7fe580b8f42","795401aad95cfd947f2da7a3c372459d3f24fc0fe5c840935b34a33ff370b908","9bdbf0703b1dcccfd226fa803674541a23f1e13834472d41b3fe3593122f5ef6","2c0d87c206009b90f074f497a8dca3160c3a9ac7fccd066f00db35b5fc1e3ce3","8786e2256be7c3d0fb712c326a3bd0c67206834ac063382e2074f6e25b5109f2","083d3e74cc141eec02f96919bbc63bf477191f7f0e30b2fc348b01e26a91c0c3","45a3ea22708244f0da082a3a72ff1d286ed7529bc0d6e007a4b000668cbeedab"],"paragraph_range_zero_based":[19176,19199],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p19176"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"neighCarrierFreqDL","paragraph_zero_based":19200},{"literal_text_all_w_t_and_m_t":"Indicates the downlink centre frequency of the neighbour LTE cell. If the field is absent, the UE applies the value of carrierFreqDL indicated in RateMatchPatternLTE-CRS for this serving cell, if configured.","paragraph_zero_based":19201},{"literal_text_all_w_t_and_m_t":"neighCellId","paragraph_zero_based":19202},{"literal_text_all_w_t_and_m_t":"Indicates the physical cell ID of the neighbour LTE cell for which the other fields within the same LTE-NeighCellsCRS-AssistInfo apply.","paragraph_zero_based":19203},{"literal_text_all_w_t_and_m_t":"If the IE LTE-NeighCellsCRS-AssistInfoList contains multiple list entries, either this field or neighV-Shift is included in each instance.","paragraph_zero_based":19204},{"literal_text_all_w_t_and_m_t":"If the IE LTE-NeighCellsCRS-AssistInfoList contains multiple list entries, the entry with neighV-Shift is only used for neighbour LTE cells for which neighCellId is not provided (i.e. the entry with neighCellId takes precedence over the entry with neighV-Shift, if provided).","paragraph_zero_based":19205},{"literal_text_all_w_t_and_m_t":"If the IE LTE-NeighCellsCRS-AssistInfoList contains one list entry with neither this field nor neighV-Shift, the information within the entry applies to all neighbour LTE cells.","paragraph_zero_based":19206},{"literal_text_all_w_t_and_m_t":"neighCRS-muting","paragraph_zero_based":19207},{"literal_text_all_w_t_and_m_t":"Indicates whether the CRS interference mitigation is enabled in the neighbour LTE cell, as specified in TS 36.133 [40], clause 3.6.1.1.","paragraph_zero_based":19208},{"literal_text_all_w_t_and_m_t":"neighMBSFN-SubframeConfigList","paragraph_zero_based":19209},{"literal_text_all_w_t_and_m_t":"Indicates the MBSFN subframe configuration of the neighbour LTE cell. If RateMatchPatternLTE-CRS is configured for this serving cell and the field is absent, the UE applies the value of mbsfn-SubframeConfigList indicated in RateMatchPatternLTE-CRS for this serving cell if configured; otherwise, if the field is absent, the UE assumes MBSFN is not configured in the neighbour LTE cell.","paragraph_zero_based":19210},{"literal_text_all_w_t_and_m_t":"neighNrofCRS-Ports","paragraph_zero_based":19211},{"literal_text_all_w_t_and_m_t":"Indicates the CRS antenna ports number of the neighbour LTE cell. If the field is absent, the UE applies the value of nrofCRS-Ports indicated in RateMatchPatternLTE-CRS for this serving cell, if configured. If RateMatchPatternLTE-CRS is not configured for this serving cell and the field is absent, the UE applies the default value n4.","paragraph_zero_based":19212},{"literal_text_all_w_t_and_m_t":"neighV-Shift","paragraph_zero_based":19213},{"literal_text_all_w_t_and_m_t":"Indicates the shifting value v-shift of neighbour LTE cells for which the other fields within the same LTE-NeighCellsCRS-AssistInfo apply.","paragraph_zero_based":19214},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19215},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":19216},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":19217},{"literal_text_all_w_t_and_m_t":"CRS-IM","paragraph_zero_based":19218},{"literal_text_all_w_t_and_m_t":"For the serving cell with 15kHz SCS, this field is mandatory present for the UE supporting the capability of crs-IM-nonDSS-NWA-15kHzSCS-r17, but not supporting crs-IM-nonDSS-15kHzSCS-r17, if RateMatchPatternLTE-CRS is not configured for this serving cell. Otherwise it is optionally present, Need S if RateMatchPatternLTE-CRS is configured for this serving cell; Need M otherwise.","paragraph_zero_based":19219},{"literal_text_all_w_t_and_m_t":"For the serving cell with 30kHz SCS, this field is mandatory present for the UE supporting the capability of crs-IM-nonDSS-NWA-30kHzSCS-r17, but not supporting crs-IM-nonDSS-30kHzSCS-r17, if RateMatchPatternLTE-CRS is not configured for this serving cell. Otherwise it is optionally present, Need S if RateMatchPatternLTE-CRS is configured for this serving cell; Need M otherwise.","paragraph_zero_based":19220},{"literal_text_all_w_t_and_m_t":"NotCellID","paragraph_zero_based":19221},{"literal_text_all_w_t_and_m_t":"If the field neighCellId is present, this field shall be absent; otherwise, it is optionally present if the IE LTE-NeighCellsCRS-AssistInfoList contains one list entry, Need S, or it is mandatory present if the IE LTE-NeighCellsCRS-AssistInfoList contains multiple list entries.","paragraph_zero_based":19222},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19223}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["408dff7c881cbdb4bc603164ef18325695e0060acb7540239647210b0a0f285c","44ac03432a5215e4810631f08bd1fbf5bf392e613b6b3fe0c8cfd52494ad15b9","3774b619062e1d6bdec54eacae8ac46d9c0428a650fd168b6adff61fbd6fd04b","924159d5b2271646337d379320a61e2cf0d47df51dbddd950fcc2f5b4c83c1af","20c5e4bb546d20040cd823ab110df7e3c338699f53ea4a24c2f9f1bfd28cc0c0","09765aeb419c99192e57fa1231ed6a4bf53485e51d7b250fdb33e93b6a03730f","b8f09345e5b3d20242f37ffff0571ad072eedae284b41c885e00d08cfe90f00f","cb7cf0b0dbf8885be21fb6b8dcbd8ed869cc03841e7ca483635c3e2671fe32d7","249c2ff2a96b51264ed3554b39ae572b275dd8b4c13dba5f8d419a0240e68a89","d51d7b4ba0b2e8c413b14c7cd75d1a678e9c314158b8cb2795b796dabd0b77fa","ef6135eff92ab1cef96d9dddefd371edfbf6816db3e1a6c0b701a6aafa5772cb","ce734a2ef8b477359ee702c09157d7a0ff1ab48c855087d56467f2502898bba9","eaef87e1c0812f28bb0df06206aeb02b2a4a0d480891020df3a84fc2e77a70d3","ba4124482ce69e2b53e61953131e9f2febf5568a01e45bbd7c96f79f09cd6e15","53467bb59928c6fbb639c152583995ddd21712a84ecc5adba6ff9b04eaeb3ac4","44de07e47f3814ab956ad8d82aff865eb3b15e3eab1f12d5b958e79024667143","c70030a04a51406fe0b26932099c3c44c9a28b7ffefeabca8f0d7d64b7385c75","80cc0fdf66f303ca6dc785da75c95fc4208687b69ae35e6887457508e82b0fbf","064eed309b5d44f99a8894e179eba5f663c5c45afe35eb1b8babb224a1cc8029","00740e4dec8cd5d6db4afd4a6d40c5bb64b4766d97f5bf6098a64aae2e70c9e5","d8e53fe6915efdbf22a1214e1ea4f60801f72cc339819b85a6589f28c74092ba","399ea4b1aee8799892fd8514d088da90368a9fb5fcccdb6a28544f9f220f3785","abca106c7a1dea98d3812129e9ec752b2d5e75bcb53eeaa446fd230b811ba1a6","1e0d67e78626416ad1ed101a3bdd0e6a6741bc7211978f2819086f4c0071865f"],"paragraph_range_zero_based":[19200,19223],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p19200"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–MAC-CellGroupConfig","paragraph_zero_based":19224},{"literal_text_all_w_t_and_m_t":"The IE MAC-CellGroupConfig is used to configure MAC parameters for a cell group, including DRX.","paragraph_zero_based":19225},{"literal_text_all_w_t_and_m_t":"MAC-CellGroupConfig information element","paragraph_zero_based":19226},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":19227},{"literal_text_all_w_t_and_m_t":"-- TAG-MAC-CELLGROUPCONFIG-START","paragraph_zero_based":19228},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19229},{"literal_text_all_w_t_and_m_t":"MAC-CellGroupConfig ::=             SEQUENCE {","paragraph_zero_based":19230},{"literal_text_all_w_t_and_m_t":"    drx-Config                          SetupRelease { DRX-Config }                                     OPTIONAL,   -- Need M","paragraph_zero_based":19231},{"literal_text_all_w_t_and_m_t":"    schedulingRequestConfig             SchedulingRequestConfig                                         OPTIONAL,   -- Need M","paragraph_zero_based":19232},{"literal_text_all_w_t_and_m_t":"    bsr-Config                          BSR-Config                                                      OPTIONAL,   -- Need M","paragraph_zero_based":19233},{"literal_text_all_w_t_and_m_t":"    tag-Config                          TAG-Config                                                      OPTIONAL,   -- Need M","paragraph_zero_based":19234},{"literal_text_all_w_t_and_m_t":"    phr-Config                          SetupRelease { PHR-Config }                                     OPTIONAL,   -- Need M","paragraph_zero_based":19235},{"literal_text_all_w_t_and_m_t":"    skipUplinkTxDynamic                 BOOLEAN,","paragraph_zero_based":19236},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":19237},{"li