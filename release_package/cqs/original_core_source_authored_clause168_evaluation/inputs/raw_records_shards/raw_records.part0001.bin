eral_text_all_w_t_and_m_t":"ConfiguredGrantConfigToReleaseList-r16   ::= SEQUENCE (SIZE (1..maxNrofConfiguredGrantConfig-r16)) OF ConfiguredGrantConfigIndex-r16","paragraph_zero_based":15302},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15303},{"literal_text_all_w_t_and_m_t":"ConfiguredGrantConfigType2DeactivationState-r16 ::= SEQUENCE (SIZE (1..maxNrofConfiguredGrantConfig-r16)) OF ConfiguredGrantConfigIndex-r16","paragraph_zero_based":15304},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15305},{"literal_text_all_w_t_and_m_t":"ConfiguredGrantConfigType2DeactivationStateList-r16  ::=","paragraph_zero_based":15306},{"literal_text_all_w_t_and_m_t":"                             SEQUENCE (SIZE (1..maxNrofCG-Type2DeactivationState)) OF ConfiguredGrantConfigType2DeactivationState-r16","paragraph_zero_based":15307},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15308},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-UPLINKDEDICATED-STOP","paragraph_zero_based":15309},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":15310},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["8bc2a234c73fbe375de353e690ff338736c46f1b0f9406aaa2c9f3834facc97e","bf243d119995adb9335966f98a80725ef304f49e66a66507613464b38f27ecd7","bafd6f6d53bba72d16a0863db3a2375d2df482cc49b699318c11227f5257fe22","4db505a97c5fe1948dbd0cac8de6a266b0b6c0a89df53372d4b849db7545e485","e92887a97d0819b94de2d5680bbb51299e4c52e118ce28c3c03bca72881df972","c731c98154fae8b7d8a7491b57369e543b7b80142e683a7184040ae1e2122a8e","5888eb0b746a2f0c5c3b5cfea1dc7f05119ef914028fc73f70dfa9e31bdb7711","233d263fe1cd683957c3c99d98f4a9ded4cf98aed60aeb406de927d0ae6689cb","e8f760e8a480aae464edad1bac1823eb9df17d729e53450f3ea2677c18c56b34","dd44594f828f905857c4f7a47c9f17379cce816351bc83a9de057b960bf1e1a0","cc2359ccb396c858650f229b259c1f11842a0111738b1fb2139ff8e295de82a7","c1363edd6ccac1aba9d694819041114f22e33c535dfd9ef4deafbfbbfee8f6a2","2f9b1fb5f9bec5916bf92ca1524e9a30852f728ae3ffdb688e4de8222b781b43","45111926f0cffb04a3e929161b5633bb397659a3607a398c002f2ca725aad2ab","3b9de77d7b8226fe2d609d914c6fef6e81ccf7de19535a307eefb32bad34d80b","c22e6b508443263f59ac2d27dd80c25bc05a75b9e38608cd389e174b079c04ae","6c81beff0b918a7d50108d5c31d02494c97ef67e01907753edf8dd3d2e89ce33","c77c30ee9e1cdd9c172532236cee3533de8334d8c293740d5852bc56a2877075","58b32cc27f25a517111168622a057af71de7b97fad9fd85487c2bc578a3bfb04","ca15b93655dd0b7659be9c97aa3d5ea3191959c87253eb85397ba18bc6ccf36d","968b29efdcb671c0271b8e28b3dda3368ac74bc0106c3c56b9d7575c3c93e1f9","9b7dda3caf6e0496f615d54657d78818364f2fe288d9f59c098a1b453c08f69c","935c5bb60ecf144b4f2357035044f56190e5d7e36443655f75e146491d9439c1","ce1216b9a79448c49418b71df619a5de5d2ff897b3e3ab2e8589929396e30901"],"paragraph_range_zero_based":[15288,15311],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p15288"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"BWP-UplinkDedicated field descriptions","paragraph_zero_based":15312},{"literal_text_all_w_t_and_m_t":"beamFailureRecoveryConfig","paragraph_zero_based":15313},{"literal_text_all_w_t_and_m_t":"Configuration of beam failure recovery. If supplementaryUplink is present, the field is present only in one of the uplink carriers, either UL or SUL.","paragraph_zero_based":15314},{"literal_text_all_w_t_and_m_t":"configuredGrantConfig","paragraph_zero_based":15315},{"literal_text_all_w_t_and_m_t":"A Configured-Grant of type1 or type2. It may be configured for UL or SUL but in case of type1 not for both at a time. Except for reconfiguration with sync, the NW does not reconfigure configuredGrantConfig when there is an active configured uplink grant Type 2 (see TS 38.321 [3]). However, the NW may release the configuredGrantConfig at any time. Network can only configure configured grant in one BWP using either this field or configuredGrantConfigToAddModList.","paragraph_zero_based":15316},{"literal_text_all_w_t_and_m_t":"configuredGrantConfigToAddModList","paragraph_zero_based":15317},{"literal_text_all_w_t_and_m_t":"Indicates a list of one or more configured grant configurations to be added or modified for one BWP. Except for reconfiguration with sync, the NW does not reconfigure a Type 2 configured grant configuration when it is active (see TS 38.321 [3]). The network configures multiple CG configurations for one BWP with either all configurations or no configuration configured with cg-RetransmissionTimer-r16.","paragraph_zero_based":15318},{"literal_text_all_w_t_and_m_t":"configuredGrantConfigToReleaseList","paragraph_zero_based":15319},{"literal_text_all_w_t_and_m_t":"Indicates a list of one or more UL Configured Grant configurations to be released. The NW may release a configured grant configuration at any time.","paragraph_zero_based":15320},{"literal_text_all_w_t_and_m_t":"configuredGrantConfigType2DeactivationStateList","paragraph_zero_based":15321},{"literal_text_all_w_t_and_m_t":"Indicates a list of the deactivation states in which each state can be mapped to a single or multiple Configured Grant type 2 configurations to be deactivated when the corresponding deactivation DCI is received, see clause 7.3.1 in TS 38.212 [17] and clause 10.2 in TS 38.213 [13].","paragraph_zero_based":15322},{"literal_text_all_w_t_and_m_t":"cp-ExtensionC2, cp-ExtensionC3","paragraph_zero_based":15323},{"literal_text_all_w_t_and_m_t":"Configures the cyclic prefix (CP) extension (see TS 38.211 [16], clause 5.3.1). For 15 kHz SCS, {1..28} are valid for both cp-ExtensionC2 and cp-ExtensionC3. For 30 kHz SCS, {1..28} are valid for cp-ExtensionC2 and {2..28} are valid for cp-ExtensionC3. For 60 kHz SCS, {2..28} are valid for cp-ExtensionC2 and {3..28} are valid for cp-ExtensionC3.","paragraph_zero_based":15324},{"literal_text_all_w_t_and_m_t":"lbt-FailureRecoveryConfig","paragraph_zero_based":15325},{"literal_text_all_w_t_and_m_t":"Configures parameters used for detection of consistent uplink LBT failures for operation with shared spectrum channel access, as specified in TS 38.321 [3].","paragraph_zero_based":15326},{"literal_text_all_w_t_and_m_t":"pathlossReferenceRSToAddModList","paragraph_zero_based":15327},{"literal_text_all_w_t_and_m_t":"A list of Reference Signals (e.g. a CSI-RS config or a SS block) to be used for path loss estimation for PUSCH, PUCCH and SRS for unified TCI state operation. If unifiedTCI-StateType is not configured for the serving cell, no element in this list is configured.","paragraph_zero_based":15328},{"literal_text_all_w_t_and_m_t":"pucch-Config","paragraph_zero_based":15329},{"literal_text_all_w_t_and_m_t":"PUCCH configuration for one BWP of the normal UL or SUL of a serving cell. If the UE is configured with SUL, the network configures PUCCH only on the BWPs of one of the uplinks (normal UL or SUL). The network configures PUCCH-Config at least on non-initial BWP(s) for SpCell and on all BWP(s) for PUCCH SCell. If supported by the UE, the network may configure at most one additional SCell of a cell group with PUCCH-Config (i.e. PUCCH SCell). If PUCCH cell switching is supported by the UE, the network may configure two TDD serving cells with PUCCH-Config within each PUCCH group. For supporting PUCCH cell switching in the PUCCH group with the SpCell, the TDD SpCell and one TDD SCell shall have PUCCH-Config on their normal UL. For supporting PUCCH cell switching in the PUCCH group with only SCells, two TDD SCells shall have PUCCH-Config on their normal UL.","paragraph_zero_based":15330},{"literal_text_all_w_t_and_m_t":"In (NG)EN-DC and NE-DC, the NW configures at most one serving cell per frequency range with PUCCH. In (NG)EN-DC and NE-DC, if two PUCCH groups are configured, the serving cells of the NR PUCCH group in FR2 use the same numerology. For NR-DC, the maximum number of PUCCH groups in each cell group is one, and only the same numerology is supported for the cell group with carriers only in FR2.","paragraph_zero_based":15331},{"literal_text_all_w_t_and_m_t":"The NW may configure PUCCH for a BWP when setting up the BWP. The network may also add/remove the pucch-Config in an RRCReconfiguration with reconfigurationWithSync (for SpCell or PUCCH SCell) or with SCell release and add (for PUCCH SCell) to move the PUCCH between the UL and SUL carrier of one serving cell. In other cases, only modifications of a previously configured pucch-Config are allowed.","paragraph_zero_based":15332},{"literal_text_all_w_t_and_m_t":"If one (S)UL BWP of a serving cell is configured with PUCCH, all other (S)UL BWPs must be configured with PUCCH, too.","paragraph_zero_based":15333},{"literal_text_all_w_t_and_m_t":"pucch-ConfigurationList","paragraph_zero_based":15334},{"literal_text_all_w_t_and_m_t":"PUCCH configurations for two simultaneously constructed HARQ-ACK codebooks (see TS 38.213 [13], clause 9.1). Different PUCCH Resource IDs are configured in different PUCCH-Config within the pucch-ConfigurationList if configured.","paragraph_zero_based":15335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["ae67d1647bfe70157b34a2d687e294055ebf09de5b9ff4890d2ee41d84665a23","7a4855078e52cfa721ddd3d7474114d1ddb837e7eab29da29b168f5abf37e49d","67adfd3baf278f28ac1628625100c7c657e0213ef5b90a032cf2b5183ff2707a","3b1ce81ca4de8ee11aa7978d6956496a2d2bbc86a5835c7181409e79d1a2bddc","b40eff1575f3a559eb3ababcf5efb343e7f6353450a0db81eb9bfb59aff2dabf","b87e165542a03d5537114a68ffdd1148191e1ba22556a2d96ced1ca7422811d9","89e04eee0106cfc3007b258bf65a07197e0b48fc1250d1af64ef95ae7d37b68f","4336e1130c6d0450d39ce50ff8ce4e626475ecfd0c8fdbef2fe8de1e86819b8c","ffb6989a8507567889ba66b9f6f468790623bdeb1745ae11ae5dcfbfcb89113e","7c238bf68d20d60caca9348dff7136bb28c782a25387b62fe18d3762ca77ea05","d72fb2636e0ec7c3ef73ca4f4bc332590c1cd0e3cab58460732ef92e4ca636fb","9aabbf4dc0ee9a5fc42b70ceae2916752d042489625bba8222c343dacf698f7c","b52e3dc0830d42abbb8820f000c4402e737c55e474cd0d10fdac2cdc64232ba3","6f942aac88d54f04dc7fd852d4d88bc2e90779b1bde71b9ccc101aaaf96ffe39","4f1086cf1c24643b340dfcddbf6d00fe75daf5e8f0409b30d94e3a5e1d5b5cab","8e72ee447117b10b6032530723eb066e6507f0dd3d6ad55bbb347ccd51326aeb","52717634e3ae7c3a9141bf63232c1f9e322c0e9ffe41f8493583082764b39ce2","3347a7afce55ca8eb150a3412f17bdcd3e119f6ce69967c2fd146046e89e2f6e","f2d1c01c2ebc24cc95757662ec0cc647abedb25622089cf9d7fe84da7df4201f","edb9429119917737bd7966a2916f8fa33943101731280df94c0792828bee7a03","62f10b3cf67f97dc34f9e534b89dda507655aa4d62a589df9a4bb14f5ff0d860","18cd08b23635e2495e24654098265e83e0ed2db3e2fcd7b125a0c0013e9eafa1","00aa73c440a7d4939b749e7618db84b985bd2949260d924950e5f5dc76404869","a2116d167011f30f281b9639ad14ca1c8e88265d2fe5affaf2e9134d42c79ccb"],"paragraph_range_zero_based":[15312,15335],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p15312"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"pucch-ConfigurationListMulticast1","paragraph_zero_based":15336},{"literal_text_all_w_t_and_m_t":"PUCCH configurations for two simultaneously constructed HARQ-ACK codebooks for MBS multicast (see TS 38.213, clause 9).","paragraph_zero_based":15337},{"literal_text_all_w_t_and_m_t":"pucch-ConfigurationListMulticast2","paragraph_zero_based":15338},{"literal_text_all_w_t_and_m_t":"PUCCH configurations for two simultaneously constructed NACK-only feedback for MBS multicast (see TS 38.213, clause 9).","paragraph_zero_based":15339},{"literal_text_all_w_t_and_m_t":"pusch-Config","paragraph_zero_based":15340},{"literal_text_all_w_t_and_m_t":"PUSCH configuration for one BWP of the normal UL or SUL of a serving cell. If the UE is configured with SUL and if it has a PUSCH-Config for both UL and SUL, an UL/SUL indicator field in DCI indicates which of the two to use. See TS 38.212 [17], clause 7.3.1.","paragraph_zero_based":15341},{"literal_text_all_w_t_and_m_t":"pucch-ConfigMulticast1","paragraph_zero_based":15342},{"literal_text_all_w_t_and_m_t":"PUCCH configuration for the HARQ-ACK codebook for MBS multicast when multicast feedback is not configured with a priority value (see TS 38.213 [13], clause 9). If the field is not configured, pucch-Config applies.","paragraph_zero_based":15343},{"literal_text_all_w_t_and_m_t":"pucch-ConfigMulticast2","paragraph_zero_based":15344},{"literal_text_all_w_t_and_m_t":"PUCCH configuration for the NACK-only feedback for MBS multicast when multicast feedback is not configured with a priority value (see TS 38.213 [13], clause 9). If the field is not configured, pucch-Config applies.","paragraph_zero_based":15345},{"literal_text_all_w_t_and_m_t":"sl-PUCCH-Config","paragraph_zero_based":15346},{"literal_text_all_w_t_and_m_t":"Indicates the UE specific PUCCH configurations used for the HARQ-ACK feedback reporting for NR sidelink communication.","paragraph_zero_based":15347},{"literal_text_all_w_t_and_m_t":"srs-Config","paragraph_zero_based":15348},{"literal_text_all_w_t_and_m_t":"Uplink sounding reference signal configuration.","paragraph_zero_based":15349},{"literal_text_all_w_t_and_m_t":"ul-powerControl","paragraph_zero_based":15350},{"literal_text_all_w_t_and_m_t":"Configures power control parameters for PUCCH, PUSCH and SRS when UE is configured with unifiedTCI-StateType for this serving cell. For each serving cell, ul-powerControl is either configured in all BWP-UplinkDedicated or it is not configured in any BWP-UplinkDedicated. When unifiedTCI-StateRef in the BWP-UplinkDedicated or in the PDSCH-Config if the unifiedTCI-StateType is set to joint, of a serving cell refers to another serving cell, ul-powerControl is either configured in all BWP-UplinkDedicated of these two serving cells or it is not configured in any BWP-UplinkDedicated of these two serving cells.","paragraph_zero_based":15351},{"literal_text_all_w_t_and_m_t":"ul-TCI-StateList","paragraph_zero_based":15352},{"literal_text_all_w_t_and_m_t":"Indicates the applicable UL TCI states for PUCCH, PUSCH and SRS.","paragraph_zero_based":15353},{"literal_text_all_w_t_and_m_t":"ul-TCI-ToAddModList","paragraph_zero_based":15354},{"literal_text_all_w_t_and_m_t":"Indicates a list of UL TCI states.","paragraph_zero_based":15355},{"literal_text_all_w_t_and_m_t":"unifiedTCI-StateRef","paragraph_zero_based":15356},{"literal_text_all_w_t_and_m_t":"Provides the serving cell and UL BWP where UL TCI states applicable to this UL BWP are defined. The value of unifiedTCI-StateType of current serving cell is the same in the serving cell indicated by unifiedTCI-StateRef.","paragraph_zero_based":15357},{"literal_text_all_w_t_and_m_t":"useInterlacePUCCH-PUSCH","paragraph_zero_based":15358},{"literal_text_all_w_t_and_m_t":"If the field is present, the UE uses uplink frequency domain resource allocation Type 2 for PUSCH (see TS 38.213 [13], clause 8.3 and TS 38.214 [19], clause 6.1.2.2) and uses interlaced PUCCH Format 0, 1, 2, and 3 for PUCCH (see TS 38.213 [13], clause 9.2.1).","paragraph_zero_based":15359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["9052d129ebde1fcafe47be4c3ba8d3da416091a7e4b795304d9f093d349422fc","c935ef834aebd341c259da1ab1fe5b84f6ac866b20221e9bfe99b869ee85f01c","05239016e523cdf157de6ff0bc276a0b62ed0976b6589eec404b3a3d680143b8","e3f6d2e63674cd6929391df018896bdbd8e340b704189b4e0120c9e455093557","b266f0c08b29eaacdb4f72a6018a78b438ca98cbeff107c9374837a0c93bffae","1981b87547a3f69a8458f472fa18c2b68c545e3034fbbdd0110dce1b92e26456","b05529a64f5a9a926eff31a58c1c34343a5eedf480172d84e959c5dbcc07249f","65498f55417f2f25e37384acb9db4b5b542c345af45d4bf84fa77a1823ed6071","65de0e7bbfab7ff0773137d248eee65da9c52e3db2452f23152384997014d753","7c59b004c55c16868a0a3cd821093f25982611e844cfbf64f170f786806566cc","b852774cf8d855ec89c024785eedf82ed973286b4d744aafcb888034d1687194","86fb046458cd97530c9709d634940448a4098bb3ddcae0015a0b6d12474afd0b","160b5f3bad9eeb06a4056c4047efa887529d000b9d969fb36fa37dc4ad53b5ee","738b67b241fd6df3b78013bfa1718425208815a25f9f34e92e2bffbe591a7be9","f8b549d95dd44577991653f398c40c0b04b9463f09f1b1ac9767f6eaa01a1073","e76e805eceebbf9bcc09fb323f332217563fcf98d47a41aee11baedfbbfbede6","28b2d26c52a92774131ac2def972c7d9c4d4e5826a2614b4af709946fbbc6d28","dde0e254dff83795dd15f292fcf658bb9893244ee1bdd03ba2d6b7bcdda76137","75861203512a6450a1638301978f88d1a74cfff9cf64d3170592a8bdb255e99b","d30581a78d5338eb5a5dab0fd72e905e89acaf8a383e986aad455afd2bf2fdef","a66cf46d091f3372b9d85e581b940b9e4239b1e19323595928d62f654377c09a","9ca7212eb8e488f50e17f2609315d25cf30b5345b422a1f546e1f32b177f73cc","569801b197a4c57281e26d0eb9ed06da7197ea359d25dc3b9b7a2e1cfa02a916","dc687f9156ba604cd612829626ab5af6dac20af518f957768a80d6d3b4d137b1"],"paragraph_range_zero_based":[15336,15359],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p15336"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15360},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":15361},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":15362},{"literal_text_all_w_t_and_m_t":"NoTCI-PC","paragraph_zero_based":15363},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if unifiedTCI-StateType is configured for this serving cell and ul-powerControl is not configured for any UL TCI state or joint TCI state of this serving cell. Otherwise it is absent, Need R","paragraph_zero_based":15364},{"literal_text_all_w_t_and_m_t":"SpCellOnly","paragraph_zero_based":15365},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need M, in the BWP-UplinkDedicated of an SpCell. It is absent otherwise. ","paragraph_zero_based":15366},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15367},{"literal_text_all_w_t_and_m_t":"NOTE 1:In case of RRCReconfiguration with reconfigurationWithSync, the UE performs a MAC reset, which involves releasing the PUCCH-CSI/SRS/SR configuration in accordance with clause 5.3.12 and TS 38.321 [3], clauses 5.12 and 5.2. Hence, for these parts of the dedicated radio resource configuration, delta signalling is not supported in the message when reconfigurationWithSync is included.","paragraph_zero_based":15368},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15369},{"literal_text_all_w_t_and_m_t":"–CandidateBeamRS","paragraph_zero_based":15370},{"literal_text_all_w_t_and_m_t":"The IE CandidateBeamRS inlcudes candidate beams for beam failure recovery in case of beam failure detection. See also TS 38.321 [3], clause 5.17.","paragraph_zero_based":15371},{"literal_text_all_w_t_and_m_t":"CandidateBeamRS information element","paragraph_zero_based":15372},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":15373},{"literal_text_all_w_t_and_m_t":"-- TAG-CANDIDATEBEAMRS-START","paragraph_zero_based":15374},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15375},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15376},{"literal_text_all_w_t_and_m_t":"CandidateBeamRS-r16 ::=                SEQUENCE {","paragraph_zero_based":15377},{"literal_text_all_w_t_and_m_t":"    candidateBeamConfig-r16                CHOICE {","paragraph_zero_based":15378},{"literal_text_all_w_t_and_m_t":"        ssb-r16                                SSB-Index,","paragraph_zero_based":15379},{"literal_text_all_w_t_and_m_t":"        csi-RS-r16                             NZP-CSI-RS-ResourceId","paragraph_zero_based":15380},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":15381},{"literal_text_all_w_t_and_m_t":"    servingCellId                          ServCellIndex                                                            OPTIONAL  -- Need R","paragraph_zero_based":15382},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":15383}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["f5efc72c5f51c6c4b1953a41e4fa39e0f4096b91fad2f4ff6db583b62e3fcc92","6dd146de43eb524fcfd53dc6e488bd054e73803d10029cb9f570f762983d7110","68b14d3c034767ab5d1d5b97dddbb23b89cfb1b5e13055a017707c441d2e7f19","c0bc53160e74e617126ff8596c20f47d5117b87dc771813bbc17a9a4e785e464","47eae548a1569753007c524b8af6fc588181ac2910fe1f8b996ca90b56b551ba","3985006d85e4060244e62a894be607c2ee4b1fea783495f0f3641e06d812ba92","8036f880020d0ff2599782027073c1dcb7f41fe7e908c5607cde663c66dd6760","905998b4bdd799671382cc894bd7b10399fc40b78f055e886b62a4140633e324","b1b50ffbb6