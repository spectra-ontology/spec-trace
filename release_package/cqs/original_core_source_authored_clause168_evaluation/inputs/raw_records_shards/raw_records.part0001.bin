{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"NeedForGapsIntraFreq-r16  ::=                 SEQUENCE {","paragraph_zero_based":20976},{"literal_text_all_w_t_and_m_t":"    servCellId-r16                               ServCellIndex,","paragraph_zero_based":20977},{"literal_text_all_w_t_and_m_t":"    gapIndicationIntra-r16                       ENUMERATED {gap, no-gap}","paragraph_zero_based":20978},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":20979},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20980},{"literal_text_all_w_t_and_m_t":"NeedForGapsNR-r16  ::=                        SEQUENCE {","paragraph_zero_based":20981},{"literal_text_all_w_t_and_m_t":"    bandNR-r16                                   FreqBandIndicatorNR,","paragraph_zero_based":20982},{"literal_text_all_w_t_and_m_t":"    gapIndication-r16                            ENUMERATED {gap, no-gap}","paragraph_zero_based":20983},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":20984},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20985},{"literal_text_all_w_t_and_m_t":"-- TAG-NeedForGapsInfoNR-STOP","paragraph_zero_based":20986},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":20987},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20988},{"literal_text_all_w_t_and_m_t":"NeedForGapsInfoNR field descriptions","paragraph_zero_based":20989},{"literal_text_all_w_t_and_m_t":"intraFreq-needForGap","paragraph_zero_based":20990},{"literal_text_all_w_t_and_m_t":"Indicates the measurement gap requirement information for NR intra-frequency measurement.","paragraph_zero_based":20991},{"literal_text_all_w_t_and_m_t":"interFreq-needForGap","paragraph_zero_based":20992},{"literal_text_all_w_t_and_m_t":"Indicates the measurement gap requirement information for NR inter-frequency measurement.","paragraph_zero_based":20993},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20994},{"literal_text_all_w_t_and_m_t":"NeedForGapsIntraFreq field descriptions","paragraph_zero_based":20995},{"literal_text_all_w_t_and_m_t":"servCellId","paragraph_zero_based":20996},{"literal_text_all_w_t_and_m_t":"Indicates the serving cell which contains the target SSB (associated with the initial DL BWP) to be measured. ","paragraph_zero_based":20997},{"literal_text_all_w_t_and_m_t":"gapIndicationIntra","paragraph_zero_based":20998},{"literal_text_all_w_t_and_m_t":"Indicates whether measurement gap is required for the UE to perform intra-frequency SSB based measurements on the concerned serving cell. Value gap indicates that a measurement gap is needed if any of the UE configured BWPs (except the BWP(s) configured with servingCellMO associated with NCD-SSB) do not contain the frequency domain resources of the SSB associated to the initial DL BWP (CD-SSB). Value no-gap indicates a measurement gap is not needed to measure the SSB associated to the initial DL BWP (CD-SSB) for all configured BWPs (except the BWP(s) configured with servingCellMO associated with NCD-SSB), no matter the SSB is within the configured BWP or not. ","paragraph_zero_based":20999}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["650708875386b552bf95fd79af98c76e13a4bb064ff01fd1b43bade98ecdce8a","5f05dac00c83207116dbae7f7fa53940f42dfaf630cb266aed939a0fd4a3e44c","a6656bfb19b265875666b33057766e2ee35b228781fc0bba91c1c3d3888b03af","100da0f8c3960367ab616121d2c0e439d480a72cad85eb03853fa3d869c5c52b","ea723195c87a71b229acd87a641db65f01558026e07b7d0a41efb2d430dae876","1a9626a61db894f85f4acb42c0ce6873828dde493fad2585f