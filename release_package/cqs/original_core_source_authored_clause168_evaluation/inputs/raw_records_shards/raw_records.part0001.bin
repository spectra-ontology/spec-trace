{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-BWP-PoolConfigCommon","paragraph_zero_based":37560},{"literal_text_all_w_t_and_m_t":"This field indicates the resource pool configurations on the configured sidelink BWP.","paragraph_zero_based":37561},{"literal_text_all_w_t_and_m_t":"sl-BWP-PoolConfigCommonA2X","paragraph_zero_based":37562},{"literal_text_all_w_t_and_m_t":"This field indicates the resource pool configurations for A2X services on the configured sidelink BWP.","paragraph_zero_based":37563},{"literal_text_all_w_t_and_m_t":"sl-BWP-PoolConfigCommonPS","paragraph_zero_based":37564},{"literal_text_all_w_t_and_m_t":"This field indicates the resource pool configurations for power saving on the configured sidelink BWP. This field does not include sl-TxPoolExceptional.","paragraph_zero_based":37565},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37566},{"literal_text_all_w_t_and_m_t":"–SL-BWP-DiscPoolConfig","paragraph_zero_based":37567},{"literal_text_all_w_t_and_m_t":"The IE SL-BWP-DiscPoolConfig is used to configure UE specific NR sidelink discovery dedicated resource pool.","paragraph_zero_based":37568},{"literal_text_all_w_t_and_m_t":"SL-BWP-DiscPoolConfig information element","paragraph_zero_based":37569},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":37570},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-BWP-DISCPOOLCONFIG-START","paragraph_zero_based":37571},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37572},{"literal_text_all_w_t_and_m_t":"SL-BWP-DiscPoolConfig-r17 ::=        SEQUENCE {","paragraph_zero_based":37573},{"literal_text_all_w_t_and_m_t":"    sl-DiscRxPool-r17                    SEQUENCE (SIZE (1..maxNrofRXPool-r16)) OF SL-ResourcePool-r16        OPTIONAL,    -- Cond HO","paragraph_zero_based":37574},{"literal_text_all_w_t_and_m_t":"    sl-DiscTxPoolSelected-r17            SL-TxPoolDedicated-r16                                               OPTIONAL,    -- Need M","paragraph_zero_based":37575},{"literal_text_all_w_t_and_m_t":"    sl-DiscTxPoolScheduling-r17          SL-TxPoolDedicated-r16                                               OPTIONAL     -- Need N","paragraph_zero_based":37576},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37577},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37578},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-BWP-DISCPOOLCONFIG-STOP","paragraph_zero_based":37579},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":37580},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37581},{"literal_text_all_w_t_and_m_t":"SL-BWP-DiscPoolConfig field descriptions","paragraph_zero_based":37582},{"literal_text_all_w_t_and_m_t":"sl-DiscTxPoolScheduling","paragraph_zero_based":37583}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["cd3a66c96d10a38826be8d55d48ae86c179f5c5722d6a8c7d333c68613cf54e1","5372ac71ea295dee19e1424e4d388b2f22b22b45d6ab80bd312008bee567f8db","04d224be645e21ed228bba65169a9b1fe070b85d88841878bd2b3a84ca64a2ca","d20d46c8fe2f1b9a09463b6bfa8c6830ab8ebafe51ad5ec0ab59879a6dc4e9da","d77e4db0043389f8d388f700e9824079b0ff8b827ce9175f75c12c5b2b89d33c","61a9aed10c3761cb42dd2a5e24b2b621e47fcbb728630e956dd59afce48483f4","f4129b4ab2d2f05298dbff826e737148740187928f6469c1eb3539781dcef8dd","baf82a532a4a2e7704e27e53998f2f117440e9d2bbf0b7fd9df4d43b6a2b73be","bdaa58bd5b2c52ff810653bd381f485d4863c109cda85df5daab073a59a23a85","d56a2fee4708026c5848c2da521f553b101e1ccd8ecfd13c9fbf448f7921a10d","5aa5cbd335f8f67c29f898d156654a32aae98eb366e41bf263c248851015db32","e5edc381a0c269a788ae2c36936f438a20cdd270337354e8389b1a8a52e90d86","cb93613a002e3dcd8e78e6b316f9c8747ee10b32ecccc25d704345f49e969f68","4b8e2e2b95ae9c2628918b31974bdc302e9bf17418b58cdf1c7fc284242935b8","01a3a9f68479d77280a27405cf3fe06ed1a74ff70e54d6c7f8b0721d5ab4a31f","07d70e52fd4c8cb547cc1284c42adbcd0468737bd67df27d3aa246790114f9f5","b23caed1af26b96f38a27422ba6c30ebc2a683ca29b9acc6d8630a4a7a9adbc4","6d6686a1655854813d4630a461d75303037be6659082fe2414a7b3b6de35b8f2","1da8ac1e2abd31988f96fb308f33bc219dcce4a2745bd9bad295988067b6e14c","670da370909740231e3cd7497034e000edff0c32584978d8e6c9c56662554870","c8e2ce2cc108ffb8558c164c573469d71953b056557d4a1c4dbc8a2f79dff033","91ae06e2c7b160b4587a95be5b6e2343172880432263dc40d16913d672f6abac","b2df3c0fb63c64f56e34f7385eb3f28a7228c38556822a12708ea0f331a539c3","54830b57734b5713a52c6c0898d0b5b2c32ba8d74b923d1fdf95965f2944449b"],"paragraph_range_zero_based":[37560,37583],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p37560"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the resources by which the UE is allowed to transmit NR sidelink discover based on network scheduling on the configured BWP. For the PSFCH related configuration, if configured, will be used for PSFCH transmission/reception.","paragraph_zero_based":37584},{"literal_text_all_w_t_and_m_t":"When this field is configured together with sl-TxPoolScheduling, the resource pool index (which is used in DCI Format 3_0 in TS 38.212 [17], clause 7.3.1.4.1) is defined as 0, 1,  …,  x-1 for the resource pools included in the sl-TxPoolScheduling, and x, x+1, …, x+y-1 for the resource pools included in sl-DiscTxPoolScheduling, where x is the number of the resource pools in sl-TxPoolScheduling, and y is the number of resource pools in sl-DiscTxPoolScheduling.","paragraph_zero_based":37585},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37586},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":37587},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":37588},{"literal_text_all_w_t_and_m_t":"HO","paragraph_zero_based":37589},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need M, in an RRCReconfiguration message including reconfigurationWithSync; otherwise it is absent, need M.","paragraph_zero_based":37590},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37591},{"literal_text_all_w_t_and_m_t":"–SL-BWP-DiscPoolConfigCommon","paragraph_zero_based":37592},{"literal_text_all_w_t_and_m_t":"The IE SL-BWP-DiscPoolConfigCommon is used to configure the cell-specific NR sidelink discovery dedicated resource pool.","paragraph_zero_based":37593},{"literal_text_all_w_t_and_m_t":"SL-BWP-DiscPoolConfigCommon information element","paragraph_zero_based":37594},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":37595},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-BWP-DISCPOOLCONFIGCOMMON-START","paragraph_zero_based":37596},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37597},{"literal_text_all_w_t_and_m_t":"SL-BWP-DiscPoolConfigCommon-r17 ::= SEQUENCE {","paragraph_zero_based":37598},{"literal_text_all_w_t_and_m_t":"    sl-DiscRxPool-r17                   SEQUENCE (SIZE (1..maxNrofRXPool-r16)) OF SL-ResourcePool-r16         OPTIONAL,    -- Need R","paragraph_zero_based":37599},{"literal_text_all_w_t_and_m_t":"    sl-DiscTxPoolSelected-r17           SEQUENCE (SIZE (1..maxNrofTXPool-r16)) OF SL-ResourcePoolConfig-r16   OPTIONAL,    -- Need R","paragraph_zero_based":37600},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":37601},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37602},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37603},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-BWP-DISCPOOLCONFIGCOMMON-STOP","paragraph_zero_based":37604},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":37605},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37606},{"literal_text_all_w_t_and_m_t":"–SL-BWP-PoolConfig","paragraph_zero_based":37607}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["f54c2f66640d1a682bd55c42e4e6884a85654cb5b5fa6d3866fa27cdadd275c3","a3aff67607ba5fb6d92337f59aa2ae9afc3fc6c4ac05281c54d5bff4e901bc1e","99b08fb498067ce72dfd6c72edcf1b15ee9294591287ef03e9eb7677ea98a410","073dde8c8a73f799c53a44c81544b8266f37bfcca313c522e8f5869e44d47b50","b41a71ba886624ba286391f4405b40cc8fb4d47f5bb662bba44e0d3efcbb5f3f","fc5d6d35cc26d06419f485a0c24e4d9338029145fda74827aba5bb57aeb35bc0","12839f027e79b38b9dc86