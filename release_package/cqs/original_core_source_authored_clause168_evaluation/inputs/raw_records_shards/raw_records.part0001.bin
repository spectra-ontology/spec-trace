{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-EgressRLC-ChannelPC5","paragraph_zero_based":39624},{"literal_text_all_w_t_and_m_t":"Indicates the egress RLC channel on PC5 Hop for downlink transmissions at the L2 U2N Relay UE and for uplink transmissions at the L2 U2N Remote UE.","paragraph_zero_based":39625},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39626},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":39627},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":39628},{"literal_text_all_w_t_and_m_t":"L2RelayUE","paragraph_zero_based":39629},{"literal_text_all_w_t_and_m_t":"For L2 U2N Relay UE, the field is optionally present, Need M. Otherwise, it is absent.","paragraph_zero_based":39630},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39631},{"literal_text_all_w_t_and_m_t":"–SL-SyncConfig","paragraph_zero_based":39632},{"literal_text_all_w_t_and_m_t":"The IE SL-SyncConfig specifies the configuration information concerning reception of synchronisation signals from neighbouring cells as well as concerning the transmission of synchronisation signals for sidelink communication.","paragraph_zero_based":39633},{"literal_text_all_w_t_and_m_t":"SL-SyncConfig information element","paragraph_zero_based":39634},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39635},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SYNCCONFIG-START","paragraph_zero_based":39636},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39637},{"literal_text_all_w_t_and_m_t":"SL-SyncConfigList-r16 ::=          SEQUENCE (SIZE (1..maxSL-SyncConfig-r16)) OF SL-SyncConfig-r16","paragraph_zero_based":39638},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39639},{"literal_text_all_w_t_and_m_t":"SL-SyncConfig-r16 ::=              SEQUENCE {","paragraph_zero_based":39640},{"literal_text_all_w_t_and_m_t":"    sl-SyncRefMinHyst-r16              ENUMERATED {dB0, dB3, dB6, dB9, dB12}                                   OPTIONAL,    -- Need R","paragraph_zero_based":39641},{"literal_text_all_w_t_and_m_t":"    sl-SyncRefDiffHyst-r16             ENUMERATED {dB0, dB3, dB6, dB9, dB12, dBinf}                            OPTIONAL,    -- Need R","paragraph_zero_based":39642},{"literal_text_all_w_t_and_m_t":"    sl-filterCoefficient-r16           FilterCoefficient                                                       OPTIONAL,    -- Need R","paragraph_zero_based":39643},{"literal_text_all_w_t_and_m_t":"    sl-SSB-TimeAllocation1-r16         SL-SSB-TimeAllocation-r16                                               OPTIONAL,    -- Need R","paragraph_zero_based":39644},{"literal_text_all_w_t_and_m_t":"    sl-SSB-TimeAllocation2-r16         SL-SSB-TimeAllocation-r16                                               OPTIONAL,    -- Need R","paragraph_zero_based":39645},{"literal_text_all_w_t_and_m_t":"    sl-SSB-TimeAllocation3-r16         SL-SSB-TimeAllocation-r16                                               OPTIONAL,    -- Need R","paragraph_zero_based":39646},{"literal_text_all_w_t_and_m_t":"    sl-SSID-r16                        INTEGER (0..671)                                                        OPTIONAL,    -- Need R","paragraph_zero_based":39647}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["f2ca34af8d12827b29934a32eef5f7e8f28d9fd2b4cdba3b8efd38d109ca0845","d4b3ca49f5d463769056638adbeff8dfca78643f078082504cf568e6c47a55b9","74d8f92c26e50b9d02c77b3d6106901025f0993c89f7831c31716f058ae0f564","667555730131af22778a91b386150c54980cd1bcc078