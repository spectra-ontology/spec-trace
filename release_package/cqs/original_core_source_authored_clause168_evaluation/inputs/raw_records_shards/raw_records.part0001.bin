cb1ab7a0c765e86ee1a0ec0517077e64f75408924c25385","025eaad7dae5f6c80fc1e16c0ea4f14d8128f095a94d002672cf29f985abf565","3dcecc3e759fa81dc8b76c038f886d6671c5dd54449e35fb767598c80c9582ef","53ab03dd7de345bd63d23135cc6eba4131abe30fb9d820da465056827a66ab94","bb05050ba2573c99efe430fb22766e15ed76c47984c8ba733ec1d907ff0bac05","80cd2362f1c7afab5556c5174d2f84c2e9891a726d9a96f27a5e886005794ee6"],"paragraph_range_zero_based":[21360,21383],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p21360"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21384},{"literal_text_all_w_t_and_m_t":"NR-DL-PRS-PDC-ResourceSet field descriptions","paragraph_zero_based":21385},{"literal_text_all_w_t_and_m_t":"dl-PRS-ResourceBandwidth","paragraph_zero_based":21386},{"literal_text_all_w_t_and_m_t":"This field specifies the number of PRBs allocated for all the DL-PRS Resource (allocated DL-PRS bandwidth) in multiples of 4 PRBs in this resource set. All DL-PRS Resources of the DL-PRS-PDC Resource Set have the same bandwidth. Integer value 1 corresponds to 24 PRBs, value 2 corresponds to 28 PRBs, value 3 corresponds to 32 PRBs and so on.","paragraph_zero_based":21387},{"literal_text_all_w_t_and_m_t":"dl-PRS-StartPRB","paragraph_zero_based":21388},{"literal_text_all_w_t_and_m_t":"This field specifies the start PRB index defined as offset with respect to subcarrier 0 in common resource block 0 for the DL-PRS Resource. All DL-PRS Resources of the DL-PRS-PDC Resource Set have the same value of dl-PRS-StartPRB.","paragraph_zero_based":21389},{"literal_text_all_w_t_and_m_t":"numSymbols","paragraph_zero_based":21390},{"literal_text_all_w_t_and_m_t":"This field specifies the number of symbols per DL-PRS Resource within a slot.","paragraph_zero_based":21391},{"literal_text_all_w_t_and_m_t":"periodicityAndOffset","paragraph_zero_based":21392},{"literal_text_all_w_t_and_m_t":"This field specifies the periodicity of DL-PRS allocation in slots and the slot offset with respect to SFN #0 slot #0 in the PCell where the DL-PRS-PDC Resource Set is configured (i.e., slot where the first DL-PRS Resource of DL-PRS-PDC Resource Set occurs).","paragraph_zero_based":21393},{"literal_text_all_w_t_and_m_t":"repFactorAndTimeGap","paragraph_zero_based":21394},{"literal_text_all_w_t_and_m_t":"If this field is absent, the value for repetitionFactor is 1 (i.e., no resource repetition).","paragraph_zero_based":21395},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21396},{"literal_text_all_w_t_and_m_t":"RepFactorAndTimeGap field descriptions","paragraph_zero_based":21397},{"literal_text_all_w_t_and_m_t":"repetitionFactor","paragraph_zero_based":21398},{"literal_text_all_w_t_and_m_t":"This field specifies how many times each DL-PRS Resource is repeated for a single instance of the DL-PRS Resource Set. It is applied to all resources of the DL-PRS Resource Set. Enumerated values n2, n4, n6, n8, n16, n32 correspond to 2, 4, 6, 8, 16, 32 resource repetitions, respectively.","paragraph_zero_based":21399},{"literal_text_all_w_t_and_m_t":"timeGap","paragraph_zero_based":21400},{"literal_text_all_w_t_and_m_t":"This field specifies the offset in units of slots between two repeated instances of a DL-PRS Resource corresponding to the same DL-PRS Resource ID within a single instance of the DL-PRS Resource Set. The time duration spanned by one DL-PRS Resource Set containing repeated DL-PRS Resources should not exceed the periodicity configured by periodicityAndOffset.","paragraph_zero_based":21401},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21402},{"literal_text_all_w_t_and_m_t":"–NR-NS-PmaxList","paragraph_zero_based":21403},{"literal_text_all_w_t_and_m_t":"The IE NR-NS-PmaxList is used to configure a list of additionalPmax and additionalSpectrumEmission, as defined in TS 38.101-1 [15], table 6.2.3.1-1A, TS 38.101-2 [39], table 6.2.3.1-2, and TS 38.101-5 [75], table 6.2.3.1-1A for a given frequency band.","paragraph_zero_based":21404},{"literal_text_all_w_t_and_m_t":"NR-NS-PmaxList information element","paragraph_zero_based":21405},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21406},{"literal_text_all_w_t_and_m_t":"-- TAG-NR-NS-PMAXLIST-START","paragraph_zero_based":21407}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["babcd0e568998a80bdbd2da9aade49970da06a7191319678efc31fd57b772167","eaac1cdd758958ef08d62569280cb47ad8718e3d7c9d831c1ba6f8f38c0a0fcd","a33bad3f8616e09312e574fdab3402ebccc4a12b00e86682ba527c6d5bbfa4c6","776e43c94f17265833899b7a8d0a82a19480d35cc0dcae56476aa97cd1c2935f","63abc6e8902991cc547ab176f8cee05bc85ba2aec906668555842a902577bf6d","2b476542edcc8ea2a991e1ab6684129cc67d2571e49e46652394cc9dd0b3bef0","2b9dab7ca664c67ae9ab31f3f9f725338fdb757e6c1f08d25a15cdf350d9f098","f12516659262e50c2140fb5aa9fbcc8ecf19da0aedc97f004d8d144fe4a12384","2459dceb227115327535b195a77cb869482bdb2882066bb9b751fda8099872de","8a980f6dd45d6440d1ee764743f712970869dd67111a5742c436e74e1abbe8ea","82f83d89e79a9d494065265229b1dd5db0255e28fa8bc1ee6db6d7a184e68c22","79e3b2235970a55a31666546998e741ec61ebe87dd44f7210145255b3a88e3d5","71e1471e2a2fed02485cc8db5cc7a806a8a9809e2e8290e3454866e3659ae0cd","fec59b7131415d61db3408430b3f1006ba31812d201d7ef6729a99f53a17cbc0","3ce41d298213646e719209568dabae7d3f2ffd1d1c7f9404f5fe2788ce105d5e","5c0d6678161c661e56192f1961a72fb26d3f1496e7ce3a22966169d30af443b0","3fc7a12b6afbbebf9510d4515e79f1e53607d48a577fa3b242d3d04d12b9cdab","4d534502d6109c125c481e8fbd211411365e8dfe5a29edd6cd68ce7713b449b8","22b3ef1f143439c68dd7b6466ac800eea9dfb2e3ab9065c59349945a839c0e5e","db1f7f680a2cba0565ade831599ad8f1a447467fb4fb1de18a0be53514cc6134","8b5368db1b4f0cc69a387a52d1802cf5d6cf069d75ed987b2800c2e8e43657f3","fce53168c544d42504ee17f50f13b3de88679cd8bf269942224fcea9fb805efe","ca1f93d8050a7b138072804a2bdcb9b9e9466adc6b5fe6a4422d9517a3b3c739","762afb7678216ef0bf36cedb903a345a567386fa9c87a75868a63a9f5cd80ffd"],"paragraph_range_zero_based":[21384,21407],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final