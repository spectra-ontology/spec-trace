b34179db382bc73e361f5165459eabed3d0bb281611f1b27","823f78e703d2049518daf02ed3fdc6740ec25ac22787120154622036a94098b2","6480a60764bf4993eec32fab0e98b3fb7d24ea0202d5165a64286ceb6e0061a0","d2e1ef70f3f5d91b0666bc5c7f85f3b3701d4fb459c98666d1436d85cdce60be","39276743c873d1f2c318291e4027d25a44477f5f0b8fba07098c3a1b1ff7d6cd","a7d06c87b35f27b33a52ccefb7045ed0782e4b27bb2f5653ca27fa9a2e3ac2f4","abcfe9ee800614380ef041b5c9c7f7c9d07772830260eb7bf6a1fa71a9272543","d5e697596eca746a6218f3c0d3244cf6835d89fbb6de7fce038bda55dd2983c8","99d56989771e27e3c51971c4fd1ccba942d2d75f36a60c5ee8797441f115e0bc","1b27995eecc2d177886e9815a7cca5f45b191371f5f13458f92c94821d08c45c","71b3daaf12accf0e46ca4fdd9d899a191979c8d774dbc40f18c8f74cd64aa766","a48e13f27d51742fb232a8ed2bb1591ad7a5dcd190dbaa8f3a93f50e3c0b7d54"],"paragraph_range_zero_based":[13920,13943],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p13920"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Common frequency resource used for MCCH and MTCH reception. If the field is absent, the CFR for broadcast has the same location and size as CORESET#0 and PDSCH configuration of MCCH is the same as PDSCH configuration provided in initialDownlinkBWP in SIB1.","paragraph_zero_based":13944},{"literal_text_all_w_t_and_m_t":"mcch-WindowDuration","paragraph_zero_based":13945},{"literal_text_all_w_t_and_m_t":"Indicates, starting from the slot indicated by mcch-WindowStartSlot, the duration in slots during which MCCH may be scheduled. Absence of this field means that MCCH is only scheduled in the slot indicated by mcch-WindowStartSlot. The network always configures mcch-WindowDuration to be shorter or equal to the length of MCCH repetition period.","paragraph_zero_based":13946},{"literal_text_all_w_t_and_m_t":"mcch-ModificationPeriod","paragraph_zero_based":13947},{"literal_text_all_w_t_and_m_t":"Defines periodically appearing boundaries, i.e. radio frames for which SFN mod mcch-ModificationPeriod = 0. The contents of different transmissions of MCCH information can only be different if there is at least one such boundary in-between them. Value rf2 corresponds to two radio frames, value rf4 corresponds to four radio frames and so on.","paragraph_zero_based":13948},{"literal_text_all_w_t_and_m_t":"mcch-RepetitionPeriodAndOffset","paragraph_zero_based":13949},{"literal_text_all_w_t_and_m_t":"Defines the length and the offset of the MCCH repetition period. rf1 corresponds to a repetition period length of one radio frame, rf2 corresponds to a repetition period length of two radio frames and so on. The corresponding integer value indicates the offset of the repetition period in the number of radio frames. MCCH is scheduled in the MCCH transmission window starting from each radio frame for which: SFN mod repetition period length = offset of the repetition period.","paragraph_zero_based":13950},{"literal_text_all_w_t_and_m_t":"mcch-WindowStartSlot","paragraph_zero_based":13951},{"literal_text_all_w_t_and_m_t":"Indicates the slot in which MCCH transmission window starts.","paragraph_zero_based":13952},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13953},{"literal_text_all_w_t_and_m_t":"–SIB21","paragraph_zero_based":13954},{"literal_text_all_w_t_and_m_t":"SIB21 contains the mapping between the current and/or neighbouring carrier frequencies and MBS Frequency Selection Area Identities (FSAI).","paragraph_zero_based":13955},{"literal_text_all_w_t_and_m_t":"SIB21 information element","paragraph_zero_based":13956},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":13957},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB21-START","paragraph_zero_based":13958},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13959},{"literal_text_all_w_t_and_m_t":"SIB21-r17 ::= SEQUENCE {","paragraph_zero_based":13960},{"literal_text_all_w_t_and_m_t":"    mbs-FSAI-IntraFreq-r17                   MBS-FSAI-List-r17                OPTIONAL,  -- Need R","paragraph_zero_based":13961},{"literal_text_all_w_t_and_m_t":"    mbs-FSAI-InterFreqList-r17               MBS-FSAI-InterFreqList-r17       OPTIONAL,  -- Need R","paragraph_zero_based":13962},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension                 OCTET STRING                     OPTIONAL,","paragraph_zero_based":13963},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":13964},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":13965},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13966},{"literal_text_all_w_t_and_m_t":"MBS-FSAI-List-r17 ::= SEQUENCE (SIZE (1..maxFSAI-MBS-r17)) OF MBS-FSAI-r17","paragraph_zero_based":13967}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_