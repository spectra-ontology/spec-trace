{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"UplinkConfigCommon-v1700 ::=        SEQUENCE {","paragraph_zero_based":29808},{"literal_text_all_w_t_and_m_t":"    initialUplinkBWP-RedCap-r17         BWP-UplinkCommon                                OPTIONAL    -- Need R","paragraph_zero_based":29809},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29810},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29811},{"literal_text_all_w_t_and_m_t":"-- TAG-UPLINKCONFIGCOMMON-STOP","paragraph_zero_based":29812},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29813},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29814},{"literal_text_all_w_t_and_m_t":"UplinkConfigCommon field descriptions","paragraph_zero_based":29815},{"literal_text_all_w_t_and_m_t":"frequencyInfoUL","paragraph_zero_based":29816},{"literal_text_all_w_t_and_m_t":"Absolute uplink frequency configuration and subcarrier specific virtual carriers.","paragraph_zero_based":29817},{"literal_text_all_w_t_and_m_t":"initialUplinkBWP","paragraph_zero_based":29818},{"literal_text_all_w_t_and_m_t":"The initial uplink BWP configuration for a serving cell (see TS 38.213 [13], clause 12).","paragraph_zero_based":29819},{"literal_text_all_w_t_and_m_t":"initialUplinkBWP-RedCap","paragraph_zero_based":29820},{"literal_text_all_w_t_and_m_t":"If present, RedCap UEs use this UL BWP instead of initialUplinkBWP.","paragraph_zero_based":29821},{"literal_text_all_w_t_and_m_t":"If absent, RedCap UEs use initialUplinkBWP provided that it does not exceed the RedCap UE maximum bandwidth (see also clause 5.2.2.4.2).","paragraph_zero_based":29822},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29823},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":29824},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":29825},{"literal_text_all_w_t_and_m_t":"InterFreqHOAndServCellAdd","paragraph_zero_based":29826},{"literal_text_all_w_t_and_m_t":"This field is mandatory present for inter-frequency handover and upon serving cell (PSCell/SCell) addition. Otherwise, the field is optionally present, Need M.","paragraph_zero_based":29827},{"literal_text_all_w_t_and_m_t":"ServCellAdd","paragraph_zero_based":29828},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon serving cell addition (for PSCell and SCell) and upon handover from E-UTRA to NR. It is optionally present, Need M otherwise.","paragraph_zero_based":29829},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29830},{"literal_text_all_w_t_and_m_t":"–UplinkConfigCommonSIB","paragraph_zero_based":29831}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["cb1faa5a21cbb917006fee87a87c00f9628350b42570cba7de69179d3dd9949f","752e6a8a93408a6971052468dcd185416035d592706081ac3d877d3725c80f0b","6733a51567a13791c19dd891443325541d42d0a930ed68b60fec23a5520d9ca9","54f5aae6ad78a0b501dc68e844efe052260a4b9cb2b132305b7ee1a8ccd04601","26a3264840c6369bbb375eb23c2e6e58e78063d3e62e300fbafc4057618c1e5e","6f3663699c39a81e3d8bf0db3c8196513187254d6e896cd3b494ec21dc6898ae","ebaf8f21569ebce05d8ea5643075c399de728940ee4950ebcddba4c5d6cf5211","1f4dcc65da639aa57174d4fc7c792ee1aaf5eecd46ed43e7806c9d9378a7e39c","83cfe6363e44018742c96a8958f85f459d3b7481ed348db2465beeb9e9bdd69e","32807b9ef58ec71ab11d977083deb515827b1dfcfd677c747b0d139cd99a2c94","34c1b72aaf3be360e65422ba68239fb03f2f42509be83dacce4b352c5708bc54","eca3392e376b16bebfed7f2a89c7d4553931e725cd281ceb51c55322aff483bd","b6fcc54408421aaf04ca2a8d15f6be257666f2325