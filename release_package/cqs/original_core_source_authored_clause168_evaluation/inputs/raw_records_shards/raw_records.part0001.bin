{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":30192},{"literal_text_all_w_t_and_m_t":"-- TAG-UPLINKCONFIGCOMMON-START","paragraph_zero_based":30193},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30194},{"literal_text_all_w_t_and_m_t":"UplinkConfigCommon ::=              SEQUENCE {","paragraph_zero_based":30195},{"literal_text_all_w_t_and_m_t":"    frequencyInfoUL                     FrequencyInfoUL                                 OPTIONAL,   -- Cond InterFreqHOAndServCellAdd","paragraph_zero_based":30196},{"literal_text_all_w_t_and_m_t":"    initialUplinkBWP                    BWP-UplinkCommon                                OPTIONAL,   -- Cond ServCellAdd","paragraph_zero_based":30197},{"literal_text_all_w_t_and_m_t":"    dummy                               TimeAlignmentTimer","paragraph_zero_based":30198},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30199},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30200},{"literal_text_all_w_t_and_m_t":"UplinkConfigCommon-v1700 ::=        SEQUENCE {","paragraph_zero_based":30201},{"literal_text_all_w_t_and_m_t":"    initialUplinkBWP-RedCap-r17         BWP-UplinkCommon                                OPTIONAL    -- Need R","paragraph_zero_based":30202},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30203},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30204},{"literal_text_all_w_t_and_m_t":"-- TAG-UPLINKCONFIGCOMMON-STOP","paragraph_zero_based":30205},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":30206},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30207},{"literal_text_all_w_t_and_m_t":"UplinkConfigCommon field descriptions","paragraph_zero_based":30208},{"literal_text_all_w_t_and_m_t":"frequencyInfoUL","paragraph_zero_based":30209},{"literal_text_all_w_t_and_m_t":"Absolute uplink frequency configuration and subcarrier specific virtual carriers.","paragraph_zero_based":30210},{"literal_text_all_w_t_and_m_t":"initialUplinkBWP","paragraph_zero_based":30211},{"literal_text_all_w_t_and_m_t":"The initial uplink BWP configuration for a serving cell (see TS 38.213 [13], clause 12).","paragraph_zero_based":30212},{"literal_text_all_w_t_and_m_t":"initialUplinkBWP-RedCap","paragraph_zero_based":30213},{"literal_text_all_w_t_and_m_t":"If present, RedCap UEs use this UL BWP instead of initialUplinkBWP.","paragraph_zero_based":30214},{"literal_text_all_w_t_and_m_t":"If absent, RedCap UEs use initialUplinkBWP provided that it does not exceed the RedCap UE maximum bandwidth (see also clause 5.2.2.4.2).","paragraph_zero_based":30215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["6ca96b722c2931fa5d8c8da0e471becd2028c02f0e5acae415d4f7189ac734f0","76df65b4bb638aa741c6772e5e2ef64c9e30c305921fda8d2efe2aed2ad808c5","460436351e81bb9971a75d0745df4e06510105f7c8f9359aff0b154ac8e40aa0","8ead9d97757ff0431771331ac90245d09f9430271b5521b88c9bd23bc1847238","5e6b835d25efbda6c1c54493605579b383e51c4698c44e30ede5ea7351e5334c","ff834e7f1359d68ad22e447bff7df7d7f91955c9d336930de7de899c2080ff78","e34aad2c0ffcb684a156c3c3665e68701c8e57649edfb590a0f7ed6f27b1f3ff","7a1dc0346e92fc6c3500d954bff00e41eb0d934d5c73fcddfb6875775d651236","25e8952aad140eeef07b73018300ca07b49a971ad0f851656adb982496b5b0b6","cb0bd319dfe9da37dfd629ec564efb7b88e360c4fff42c8817faa6c8327f730b","9d8178ad26895e42c0d29eadc016d27e6a7f726e8761cecfc6989f593ecbc294","760672e6926cdf73d52bd4b71f2b4c3648f8c497a538d593fb5573cfa68c12c2","e88073388d8b15aa63695a9d578929dc6e30a60bc4fb71c2560f988c9295e