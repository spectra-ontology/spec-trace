{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>release maxBW-PreferenceConfig for the MCG, if configured and stop timer T346b associated with the MCG, if running;","paragraph_zero_based":2976},{"literal_text_all_w_t_and_m_t":"2>release maxCC-PreferenceConfig for the MCG, if configured and stop timer T346c associated with the MCG, if running;","paragraph_zero_based":2977},{"literal_text_all_w_t_and_m_t":"2>release maxMIMO-LayerPreferenceConfig for the MCG, if configured and stop timer T346d associated with the MCG, if running;","paragraph_zero_based":2978},{"literal_text_all_w_t_and_m_t":"2>release minSchedulingOffsetPreferenceConfig for the MCG, if configured stop timer T346e associated with the MCG, if running;","paragraph_zero_based":2979},{"literal_text_all_w_t_and_m_t":"2>release rlm-RelaxationReportingConfig for the MCG, if configured and stop timer T346j associated with the MCG, if running;","paragraph_zero_based":2980},{"literal_text_all_w_t_and_m_t":"2>release bfd-RelaxationReportingConfig for the MCG, if configured and stop timer T346k associated with the MCG, if running;","paragraph_zero_based":2981},{"literal_text_all_w_t_and_m_t":"2>release releasePreferenceConfig, if configured stop timer T346f, if running;","paragraph_zero_based":2982},{"literal_text_all_w_t_and_m_t":"2>release onDemandSIB-Request if configured, and stop timer T350, if running;","paragraph_zero_based":2983},{"literal_text_all_w_t_and_m_t":"2>release referenceTimePreferenceReporting, if configured;","paragraph_zero_based":2984},{"literal_text_all_w_t_and_m_t":"2>release sl-AssistanceConfigNR, if configured;","paragraph_zero_based":2985},{"literal_text_all_w_t_and_m_t":"2>release obtainCommonLocation, if configured;","paragraph_zero_based":2986},{"literal_text_all_w_t_and_m_t":"2>release musim-GapAssistanceConfig, if configured and stop timer T346h, if running;","paragraph_zero_based":2987},{"literal_text_all_w_t_and_m_t":"2>release musim-LeaveAssistanceConfig, if configured;","paragraph_zero_based":2988},{"literal_text_all_w_t_and_m_t":"2>release ul-GapFR2-PreferenceConfig, if configured;","paragraph_zero_based":2989},{"literal_text_all_w_t_and_m_t":"2>release scg-DeactivationPreferenceConfig, if configured, and stop timer T346i, if running;","paragraph_zero_based":2990},{"literal_text_all_w_t_and_m_t":"2>release propDelayDiffReportConfig, if configured;","paragraph_zero_based":2991},{"literal_text_all_w_t_and_m_t":"2>release rrm-MeasRelaxationReportingConfig, if configured;","paragraph_zero_based":2992},{"literal_text_all_w_t_and_m_t":"2>release maxBW-PreferenceConfigFR2-2, if configured;","paragraph_zero_based":2993},{"literal_text_all_w_t_and_m_t":"2>release maxMIMO-LayerPreferenceConfigFR2-2, if configured;","paragraph_zero_based":2994},{"literal_text_all_w_t_and_m_t":"2>release minSchedulingOffsetPreferenceConfigExt, if configured;","paragraph_zero_based":2995},{"literal_text_all_w_t_and_m_t":"2>release uav-FlightPathAvailabilityConfig, if configured;","paragraph_zero_based":2996},{"literal_text_all_w_t_and_m_t":"1>release successHO-Config, if configured;","paragraph_zero_based":2997},{"literal_text_all_w_t_and_m_t":"1>if any DAPS bearer is configured:","paragraph_zero_based":2998},{"literal_text_all_w_t_and_m_t":"2>reset the source MAC and release the source MAC configuration;","paragraph_zero_based":2999}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["a4155f0e86879fc75f48cca3e7d18999e201bd1631bb693dc5a649526dbb13a5","bc2f6c3d6afb6f51ef3f863c8de456c90279401d6fbfd318cb7121251a4912e2","e90e6c8ede