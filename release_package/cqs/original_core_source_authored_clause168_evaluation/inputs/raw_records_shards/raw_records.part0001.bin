{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"PDCCH-ConfigSIB1 information element","paragraph_zero_based":22272},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":22273},{"literal_text_all_w_t_and_m_t":"-- TAG-PDCCH-CONFIGSIB1-START","paragraph_zero_based":22274},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22275},{"literal_text_all_w_t_and_m_t":"PDCCH-ConfigSIB1 ::=                SEQUENCE {","paragraph_zero_based":22276},{"literal_text_all_w_t_and_m_t":"    controlResourceSetZero              ControlResourceSetZero,","paragraph_zero_based":22277},{"literal_text_all_w_t_and_m_t":"    searchSpaceZero                     SearchSpaceZero","paragraph_zero_based":22278},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22279},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22280},{"literal_text_all_w_t_and_m_t":"-- TAG-PDCCH-CONFIGSIB1-STOP","paragraph_zero_based":22281},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":22282},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22283},{"literal_text_all_w_t_and_m_t":"PDCCH-ConfigSIB1 field descriptions","paragraph_zero_based":22284},{"literal_text_all_w_t_and_m_t":"controlResourceSetZero","paragraph_zero_based":22285},{"literal_text_all_w_t_and_m_t":"Determines a common ControlResourceSet (CORESET) with ID #0, see TS 38.213 [13], clause 13.","paragraph_zero_based":22286},{"literal_text_all_w_t_and_m_t":"searchSpaceZero","paragraph_zero_based":22287},{"literal_text_all_w_t_and_m_t":"Determines a common search space with ID #0, see TS 38.213 [13], clause 13.","paragraph_zero_based":22288},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22289},{"literal_text_all_w_t_and_m_t":"–PDCCH-ServingCellConfig","paragraph_zero_based":22290},{"literal_text_all_w_t_and_m_t":"The IE PDCCH-ServingCellConfig is used to configure UE specific PDCCH parameters applicable across all bandwidth parts of a serving cell.","paragraph_zero_based":22291},{"literal_text_all_w_t_and_m_t":"PDCCH-ServingCellConfig information element","paragraph_zero_based":22292},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":22293},{"literal_text_all_w_t_and_m_t":"-- TAG-PDCCH-SERVINGCELLCONFIG-START","paragraph_zero_based":22294},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22295}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["2efc0f78a700261e997e36c983961d512592b6d9f1af29e6239cabb6b0417a0d","eea059a9dc41c91ab32348f63d110d2943e7033084b6144e9b5520a29669d694","a16836b8928e99818f03d5ea64a730707c3fecd0046316372a63b968c65cd96b","aec93834a916a85bbb81058e1f53ec9c33c15ee38a426bd7c84a8d0943d6508f","c9251b553f2c907e3ceee1a1ea85774b1efe6739e57be1534a10e394ed690f6b","cf6e396e3a4133e5d13462ee11990c3c10775ace0d323e735c3167857eff658d","c7c4a22372fee666dbf278c1a97ceed494114de3a6090805856768b4ee75d433","1b7f50008307c69eb7d2516acb357e51b6c55c380259b70d6ec85e7778e1a046","95f500c605dc94de3645c785883f3d7faefa084a75978475129d99d9bb5f65c2","bc32cde41efeaa30e002d26883febba2033ef0595ec191167cda2cf23c598f2c","875ae32bcde30091cb640309ff0eb998ff58ef74184ffddce5605bbe50325850","c528e7a3cd4b4f4c1f837437c8fe1e35a064fe29df454ed945629eba4a110acc","17fe44ef4d8845957dd6022a2b61ce03c555b718ed8fef4d2f83da8153cbbb5d","9c88dc6c1ddf7a85504726c8894174e72ca7b94b526f92fcaadebfe70c96122c","2b1f54fed9a355496c8c2570ea17780169af631f5cdb09f93172687c56df0f2b","e18a1d12987ce246c52ad1c5961a4e396ff82f012666a9d40e4e184ce7624435","9422e3361cf73381adb85f0e002aa981f1b3dbb4f65c046c8d5eccf966f221ea","bb755f39bf4d9f5