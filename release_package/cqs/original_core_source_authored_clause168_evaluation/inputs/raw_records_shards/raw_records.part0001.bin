ca0b6e8a2a63549539d4b36618a2bb256ff7dd1af2372a5e2123b7a171e","ea149f4cde9c88ba05fbcc96c4b4a3940047bdd6d2e14f371823ee7a27a54b5d","2959ea9ca4772d175f8c85b786ef8d28e37058e6e41637743baa088632905d3f","5a2bfe25d2ca3543c7a8e8bda888f724029d60815720319afe3000fa13c9eb9e","8597b69a88ac2f7912a22e1a0a94583de3444eca1d6f89ae09b59b3f80f6c775","b160f94d505691f073b3064884f3da1337c30e2c6d8c4a1a9a6f31f6f80ead84","f15d366af95dfaa8f59a8362d7c81673d771e7f349c214a1a8719bb77d42b6d8","821ad05e58a9cdba1ffe1c8657c4c3f30a1d48c6238427b20c1d1d81e1380b3c","ba174f7830c15fee6b0c1babe2ae60b660928502dce2e19142c67b92d4d4be9a","6a6f0615882a06aba0cf2f321e9cd442fc78fffcbd5f589e4c7ceb587978dee2","4e29b3291da327142a272f506d050ab79ef28d6581e8953cb024e3fca4cf667f","f8edc243839048663610096e4cd0128884cbcccbb30cc21b875b6bd5b1fe208c","259b5d495275f504ca66bf36a4bd6a0cbea01cadef3b625efa0330d3691b9c9b"],"paragraph_range_zero_based":[18408,18431],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p18408"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the downlink carrier frequency to which sliceInfoList is associated with. The frequency is signalled implicitly, value 0 corresponds to the serving frequency, value 1 corresponds to the first frequency indicated by the InterFreqCarrierFreqList in SIB4, and value 2 corresponds to the second frequency indicated by the InterFreqCarrierFreqList in SIB4, and so on.","paragraph_zero_based":18432},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18433},{"literal_text_all_w_t_and_m_t":"SliceInfo field descriptions","paragraph_zero_based":18434},{"literal_text_all_w_t_and_m_t":"sliceAllowedCellListNR","paragraph_zero_based":18435},{"literal_text_all_w_t_and_m_t":"List of allow-listed cells for slicing. If present, the cells listed in this list support the corresponding nsag-frequency pair, and the cells not listed in this list do not support the corresponding nsag-frequency pair, according to TS 38.304 [20], clause 5.2.4.11.","paragraph_zero_based":18436},{"literal_text_all_w_t_and_m_t":"sliceCellListNR","paragraph_zero_based":18437},{"literal_text_all_w_t_and_m_t":"Contains either the list of allow-listed or exclude-listed cells for slicing. If absent, it implies all the cells support the corresponding nsag-frequency pair, according to 38.304 [20], clause 5.2.4.11.","paragraph_zero_based":18438},{"literal_text_all_w_t_and_m_t":"sliceExcludedCellListNR","paragraph_zero_based":18439},{"literal_text_all_w_t_and_m_t":"List of exclude-listed cells for slicing. If present, the cells listed in this list do not support the corresponding nsag-frequency pair, and the cells not listed in this list support the corresponding nsag-frequency pair, according to TS 38.304 [20], clause 5.2.4.11.","paragraph_zero_based":18440},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18441},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":18442},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":18443},{"literal_text_all_w_t_and_m_t":"Mandatory","paragraph_zero_based":18444},{"literal_text_all_w_t_and_m_t":"The field is mandatory present.","paragraph_zero_based":18445},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18446},{"literal_text_all_w_t_and_m_t":"–FrequencyInfoDL","paragraph_zero_based":18447},{"literal_text_all_w_t_and_m_t":"The IE FrequencyInfoDL provides basic parameters of a downlink carrier and transmission thereon.","paragraph_zero_based":18448},{"literal_text_all_w_t_and_m_t":"FrequencyInfoDL information element","paragraph_zero_based":18449},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18450},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQUENCYINFODL-START","paragraph_zero_based":18451},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18452},{"literal_text_all_w_t_and_m_t":"FrequencyInfoDL ::=                 SEQUENCE {","paragraph_zero_based":18453},{"literal_text_all_w_t_and_m_t":"    absoluteFrequencySSB                ARFCN-ValueNR                                                   OPTIONAL,   -- Cond SpCellAdd","paragraph_zero_based":18454},{"literal_text_all_w_t_and_m_t":"    frequencyBandList                   MultiFrequencyBandListNR,","paragraph_zero_based":18455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["7d6296334f7c73441acba64d587ff5e2a98bc1799ce0c7a30955c5cb47ced6d6","d34b1d5b727387e54d012379d3916ac125b4771515313a047f12baaf75d9758c","3ce0a6969dc54bff7a1cc630657c33aca2436cb3b058841617b09b53d126e928","25b1fb2345fdb4afb6d7152ffc614441e964f6a5604c6a819379ceab616f90d0","bb5a2bcd3930f8fc562cf94e7e809c0cc4156c30898b9e41fcbb473123997fc9","0930dba2261962aa42d588a81e5bbf049ad4b27238e26ee0abfaeda3dc0ab7da","397d3b75894ae0753f2fa7b507b15b5cbf311f9603f8276e4e7eeca0cbb61e74","0e5e49475c90e51d1b654ef4d8cc05437423cc4262fe003b5986ac6223b3ce39","02597f1e546a53ae310ffa04082d34302a4b61c1c77ffccac7eba0ff64e81849","fc7a89cd757730696232edad8823dec7c404fb00059bd3eed4a891a7aea17c1f","31cbdaa93e18a34643afc07234697ae5da939b2c73d942fe67d489417ee9547b","89d7c75b260268d41778931a82deb0d75dd874fc9cf8e53e14945884fbabfc82","f65eec273bb03f545f9fa6b8e7987e25b60b6e46970d5e9ff145db2485ce4279","351f4f84bd1d67912d66c1caab627d7e4351e484c0ca1ba650fa6c54ad2126fd","56377f8800574fad9944fcc5f5cbb2a445538b8c4a3c302379feee31f27b7a3f","9c0a7b9239e831101f958f77bc253ec49d7cbd0296b9a0aeee84ba36550ca28b","de783341aa2c9a3e66a99e34bb765a0bf7972aa24f417ec3fe977be93b9052dd","50a83786dc4a6c35772fada6fc6dd698d16a69fd0e1c63476527acd104ee46b0","6110ff7cdf5a3af977ba3912cf92c73ea781f2fb70c3a7fcfacdd43fe031e41b","2e19965dca60015e83c2a6b1286639f27943231c7023befe7789e644ff77cbae","d4175985008ffc91556cabdc5938740e48f733c9519c382d313330409447cb8e","cee265584f66c235fec3538ccbd5482e70116d3ae10f62c0eee3c62a0392e02e","2533a4d80041c61ff24c908850527b885d238a8607b05bf0877dfedb576011a1","3a0b899a889ebabeaf79cf09ae5ed51f94fe7aa697ef3d3ff7f266ab70d31067"],"paragraph_range_zero_based":[18432,18455],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p18432"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    absoluteFrequencyPointA             ARFCN-ValueNR,","paragraph_zero_based":18456},{"literal_text_all_w_t_and_m_t":"    scs-SpecificCarrierList             SEQUENCE (SIZE (1..maxSCSs)) OF SCS-SpecificCarrier,","paragraph_zero_based":18457},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":18458},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18459},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18460},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQUENCYINFODL-STOP","paragraph_zero_based":18461},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18462},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18463},{"literal_text_all_w_t_and_m_t":"FrequencyInfoDL field descriptions","paragraph_zero_based":18464},{"literal_text_all_w_t_and_m_t":"absoluteFrequencyPointA","paragraph_zero_based":18465},{"literal_text_all_w_t_and_m_t":"Absolute frequency position of the reference resource block (Common RB 0). Its lowest subcarrier is also known as Point A (see TS 38.211 [16], clause 4.4.4.2). Note that the lower edge of the actual carrier is not defined by this field but rather in the scs-SpecificCarrierList.","paragraph_zero_based":18466},{"literal_text_all_w_t_and_m_t":"absoluteFrequencySSB","paragraph_zero_based":18467},{"literal_text_all_w_t_and_m_t":"Frequency of the SSB to be used for this serving cell. SSB related parameters (e.g. SSB index) provided for a serving cell refer to this SSB frequency unless mentioned otherwise. The CD-SSB of the PCell is always on the sync raster. Frequencies are considered to be on the sync raster if they are also identifiable with a GSCN value (see TS 38.101-1 [15] or TS 38.101-5 [75]). If the field is absent, the SSB related parameters should be absent, e.g. ssb-PositionsInBurst, ssb-periodicityServingCell and subcarrierSpacing in ServingCellConfigCommon IE. If the field is absent, the UE obtains timing reference from the SpCell or an SCell if applicable as described in TS 38.213 [13], clause 4.1. This is only supported in case the SCell for which the UE obtains the timing reference is in the same frequency band as the cell (i.e. the SpCell or the SCell, respectively) from which the UE obtains the timing reference.","paragraph_zero_based":18468},{"literal_text_all_w_t_and_m_t":"For cells supporting RedCap, this field corresponds to the CD-SSB.","paragraph_zero_based":18469},{"literal_text_all_w_t_and_m_t":"frequencyBandList","paragraph_zero_based":18470},{"literal_text_all_w_t_and_m_t":"List containing only one frequency band to which this carrier(s) belongs. Multiple values are not supported.","paragraph_zero_based":18471},{"literal_text_all_w_t_and_m_t":"scs-SpecificCarrierList","paragraph_zero_based":18472},{"literal_text_all_w_t_and_m_t":"A set of carriers for different subcarrier spacings (numerologies). Defined in relation to Point A. The network configures a scs-SpecificCarrier at least for each numerology (SCS) that is used e.g. in a BWP (see TS 38.211 [16], clause 5.3).","paragraph_zero_based":18473},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18474},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":18475},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":18476},{"literal_text_all_w_t_and_m_t":"SpCellAdd","paragraph_zero_based":18477},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if this FrequencyInfoDL is for SpCell. Otherwise the field is optionally present, Need S.","paragraph_zero_based":18478},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f