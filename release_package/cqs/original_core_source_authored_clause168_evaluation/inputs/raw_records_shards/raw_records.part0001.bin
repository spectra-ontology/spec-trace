                           OPTIONAL,  -- Need M","paragraph_zero_based":10070},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":10071},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":10072},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10073},{"literal_text_all_w_t_and_m_t":"SL-ConfigDedicatedEUTRA-Info-r16 ::=            SEQUENCE {","paragraph_zero_based":10074},{"literal_text_all_w_t_and_m_t":"    sl-ConfigDedicatedEUTRA-r16                    OCTET STRING                                              OPTIONAL,  -- Need M","paragraph_zero_based":10075},{"literal_text_all_w_t_and_m_t":"    sl-TimeOffsetEUTRA-List-r16                    SEQUENCE (SIZE (8)) OF SL-TimeOffsetEUTRA-r16             OPTIONAL    -- Need M","paragraph_zero_based":10076},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":10077},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10078},{"literal_text_all_w_t_and_m_t":"SL-TimeOffsetEUTRA-r16 ::=        ENUMERATED {ms0, ms0dot25, ms0dot5, ms0dot625, ms0dot75, ms1, ms1dot25, ms1dot5, ms1dot75,","paragraph_zero_based":10079}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["ed04bfd246f614d54540456cdb71abdc1c40cd8f69462c23cf37469043b3854b","f8457c0e24e17d462941fa5cfbbe5a4508104e124580ecbdc85a98a8cf3faae5","7045f62cd7e02090a0ef4a8b55d9908f90f465460511837f3f013658ec181d76","c541077ce2e3836488f4ad42857b9b8ba741cc48c71b47bf3bebc19509d08b39","1ab5f0a6775ee7c4b9e676040d80dc6077fadc8d9c3737566195b795dfef39df","00f2648e504bf0f8adca4501acca8def538298287e068a9fd904b0fb1705f9a6","ee4a549bf4aba1fb61f85696fbd3d42f724df7c05494f31ca3627694afba34cc","0ada11b117198e0abf36bed25d7d602f7cc5f5f5436561bd627b883501370ebd","