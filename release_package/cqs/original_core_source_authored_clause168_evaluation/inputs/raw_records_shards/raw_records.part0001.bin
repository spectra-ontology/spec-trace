{"fields":{"filename":"R2-2401316.zip::R2-2401316 BLE.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–BT-ProvideAssistanceData","paragraph_zero_based":552},{"literal_text_all_w_t_and_m_t":"The IE BT-ProvideAssistanceData is used by the location server to provide assistance data to enable UEbased and UE-assisted AoD positioning. It may also be used to provide Bluetooth positioning specific error reasons.","paragraph_zero_based":553},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":554},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":555},{"literal_text_all_w_t_and_m_t":"BT-ProvideAssistanceData-r18 ::= SEQUENCE {","paragraph_zero_based":556},{"literal_text_all_w_t_and_m_t":"bt-BeaconInfo-r18BT-BeaconInfo-r18,","paragraph_zero_based":557},{"literal_text_all_w_t_and_m_t":"bt-Error-r18BT-Error-r13OPTIONAL,-- Need ON","paragraph_zero_based":558},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":559},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":560},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":561},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":562},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":563},{"literal_text_all_w_t_and_m_t":"BT-ProvideAssistanceData field descriptions","paragraph_zero_based":564},{"literal_text_all_w_t_and_m_t":"bt-BeaconInfoThis field provides data for aset of Bluetooth beacons.","paragraph_zero_based":565},{"literal_text_all_w_t_and_m_t":"bt-ErrorThis field provides error information and may be included when a Provide Assistance Data is sent in response to a Request Assistance Data. ","paragraph_zero_based":566},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":567},{"literal_text_all_w_t_and_m_t":"6.5.7.8Bluetooth Assistance Data Elements","paragraph_zero_based":568},{"literal_text_all_w_t_and_m_t":"–BT-BeaconInfo","paragraph_zero_based":569},{"literal_te