{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>if the received rlf-TimersAndConstants is set to release:","paragraph_zero_based":1968},{"literal_text_all_w_t_and_m_t":"2>if any DAPS bearer is configured:","paragraph_zero_based":1969},{"literal_text_all_w_t_and_m_t":"3>use values for timers T301, T310, T311 and constants N310, N311 for the target cell group, as included in ue-TimersAndConstants received in SIB1;","paragraph_zero_based":1970},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":1971},{"literal_text_all_w_t_and_m_t":"3>use values for timers T301, T310, T311 and constants N310, N311, as included in ue-TimersAndConstants received in SIB1;","paragraph_zero_based":1972},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":1973},{"literal_text_all_w_t_and_m_t":"2>if any DAPS bearer is configured:","paragraph_zero_based":1974},{"literal_text_all_w_t_and_m_t":"3>configure the value of timers and constants for the target cell group in accordance with received rlf-TimersAndConstants;","paragraph_zero_based":1975},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":1976},{"literal_text_all_w_t_and_m_t":"3>(re-)configure the value of timers and constants in accordance with received rlf-TimersAndConstants;","paragraph_zero_based":1977},{"literal_text_all_w_t_and_m_t":"3>stop timer T310 for this cell group, if running;","paragraph_zero_based":1978},{"literal_text_all_w_t_and_m_t":"3>stop timer T312 for this cell group, if running;","paragraph_zero_based":1979},{"literal_text_all_w_t_and_m_t":"3>reset the counters N310 and N311.","paragraph_zero_based":1980},{"literal_text_all_w_t_and_m_t":"5.3.5.5.7SpCell Configuration","paragraph_zero_based":1981},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":1982},{"literal_text_all_w_t_and_m_t":"1>if the UE is acting as L2 U2N Remote UE:","paragraph_zero_based":1983},{"literal_text_all_w_t_and_m_t":"2>if the SpCellConfig contains the rlf-TimersAndConstants which is set to setup:","paragraph_zero_based":1984},{"literal_text_all_w_t_and_m_t":"3>use value for timers T311 as received in rlf-TimersAndConstants;","paragraph_zero_based":1985},{"literal_text_all_w_t_and_m_t":"2>else if rlf-TimersAndConstants is not configured for this cell group or SpCellConfig contains the rlf-TimersAndConstants which is set to release:","paragraph_zero_based":1986},{"literal_text_all_w_t_and_m_t":"3>use value for timers T311, as included in ue-TimersAndConstants received in SIB1;","paragraph_zero_based":1987},{"literal_text_all_w_t_and_m_t":"1>else","paragraph_zero_based":1988},{"literal_text_all_w_t_and_m_t":"2>if the SpCellConfig contains the rlf-TimersAndConstants:","paragraph_zero_based":1989},{"literal_text_all_w_t_and_m_t":"3>configure the RLF timers and constants for this cell group as specified in 5.3.5.5.6;","paragraph_zero_based":1990},{"literal_text_all_w_t_and_m_t":"2>else if rlf-TimersAndConstants is not configured for this cell group:","paragraph_zero_based":1991}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["0d16d0777f41f1bbda9ab246978747e7d1e0ed029635de344acfb62c0275659d","65e77b3a90fee489cac759495d697b8e2caf477bb492ca9c0d8c9d4156bcad43","485864bd880a21f13ca8545b5e6966176084289d4457363f12cd8d19b8c14be4","683a08a3e41e1076147613a72a1d79f1c36346e618befcb6d31ff49921b4ea3a","24430f66d1b886e3066e3ace3780b40838e5e3e28aa1e9d92740055dc4fc0990","31ab953dbbcb79815535e929b06308d7124dc5a01a0e7ca1912c3c4ad12e0553","d58e9f8081d26befb671b37241e9df7802e629b14f95d850b2e2ea9fbd58d992","612d8c7d57aa8f64868d