b3bf5352ba2eb89c5e45c9e7f870a8ea024ed4611151b1927d","5bf963b650754241578cabcce611f6d7becf1e09372ac54ae524a73ebe711ceb","4186f26eaaf5c660317ca4b830dfbf0047e0149e51a37908237a33145f144e6e","f99bde5eb6a5c3252af88daaf2a1bd29905190c17b0dfd75d09b3bdde6d6aef7","735b098251790dd0cd21eb878393d06e26c343fd14ca9a96823c4e4e2395073e","e672df364ab2198866f590fd2369764767fd0adf8a573a5ac9ad323fe2cee086","1583acf77b4f5bfacd3b860a83e9daa19dafd94fa095caeadecef8a79edec8db","31738eaf10c7607d190a387fe1c1e02313fb80a40547d6954ed4d2d3f0ec6a86"],"paragraph_range_zero_based":[19032,19055],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p19032"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-LOCATIONMEASUREMENTINFO-STOP","paragraph_zero_based":19056},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":19057},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19058},{"literal_text_all_w_t_and_m_t":"LocationMeasurementInfo field descriptions","paragraph_zero_based":19059},{"literal_text_all_w_t_and_m_t":"carrierFreq","paragraph_zero_based":19060},{"literal_text_all_w_t_and_m_t":"The EARFCN value of the carrier received from upper layers for which the UE needs to perform the inter-RAT RSTD measurements.","paragraph_zero_based":19061},{"literal_text_all_w_t_and_m_t":"measPRS-Offset","paragraph_zero_based":19062},{"literal_text_all_w_t_and_m_t":"Indicates the requested gap offset for performing RSTD measurements towards E-UTRA. It is the smallest subframe offset from the beginning of subframe 0 of SFN=0 of the serving cell of the requested gap for measuring PRS positioning occasions in the carrier frequency carrierFreq for which the UE needs to perform the inter-RAT RSTD measurements. The PRS positioning occasion information is received from upper layers. The value of measPRS-Offset is obtained by mapping the starting subframe of the PRS positioning occasion in the measured cell onto the corresponding subframe in the serving cell and is calculated as the serving cell's number of subframes from SFN=0 mod 40.","paragraph_zero_based":19063},{"literal_text_all_w_t_and_m_t":"The UE shall take into account any additional time required by the UE to start PRS measurements on the other carrier when it does this mapping for determining the measPRS-Offset.","paragraph_zero_based":19064},{"literal_text_all_w_t_and_m_t":"NOTE:Figure 6.2.2-1 in TS 36.331[10] illustrates the measPRS-Offset field.","paragraph_zero_based":19065},{"literal_text_all_w_t_and_m_t":"dl-PRS-PointA","paragraph_zero_based":19066},{"literal_text_all_w_t_and_m_t":"The ARFCN value of the carrier received from upper layers for which the UE needs to perform the NR DL-PRS measurements.","paragraph_zero_based":19067},{"literal_text_all_w_t_and_m_t":"nr-MeasPRS-RepetitionAndOffset","paragraph_zero_based":19068},{"literal_text_all_w_t_and_m_t":"Indicates the gap periodicity in ms and offset in number of subframes of the requested measurement gap for performing NR DL-PRS measurements.","paragraph_zero_based":19069},{"literal_text_all_w_t_and_m_t":"nr-MeasPRS-length","paragraph_zero_based":19070},{"literal_text_all_w_t_and_m_t":"Indicates measurement gap length in ms of the requested measurement gap for performing NR DL-PRS measurements. The measurement gap length is according to in Table 9.1.2-1 in TS 38.133 [14].","paragraph_zero_based":19071},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19072},{"literal_text_all_w_t_and_m_t":"–LogicalChannelConfig","paragraph_zero_based":19073},{"literal_text_all_w_t_and_m_t":"The IE LogicalChannelConfig is used to configure the logical channel parameters.","paragraph_zero_based":19074},{"literal_text_all_w_t_and_m_t":"LogicalChannelConfig information element","paragraph_zero_based":19075},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":19076},{"literal_text_all_w_t_and_m_t":"-- TAG-LOGICALCHANNELCONFIG-START","paragraph_zero_based":19077},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19078},{"literal_text_all_w_t_and_m_t":"LogicalChannelConfig ::=            SEQUENCE {","paragraph_zero_based":19079}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["e151be78935c100672f1