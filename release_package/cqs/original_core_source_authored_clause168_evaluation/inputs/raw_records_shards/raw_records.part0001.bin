{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Mandatory","paragraph_zero_based":18624},{"literal_text_all_w_t_and_m_t":"The field is mandatory present.","paragraph_zero_based":18625},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18626},{"literal_text_all_w_t_and_m_t":"–FreqPriorityListSlicing","paragraph_zero_based":18627},{"literal_text_all_w_t_and_m_t":"The IE FreqPriorityListSlicing indicates cell reselection priorities for slicing in SIB16.","paragraph_zero_based":18628},{"literal_text_all_w_t_and_m_t":"FreqPriorityListSlicing information element","paragraph_zero_based":18629},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18630},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQPRIORITYLISTSLICING-START","paragraph_zero_based":18631},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18632},{"literal_text_all_w_t_and_m_t":"FreqPriorityListSlicing-r17 ::= SEQUENCE (SIZE (1..maxFreqPlus1)) OF FreqPrioritySlicing-r17","paragraph_zero_based":18633},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18634},{"literal_text_all_w_t_and_m_t":"FreqPrioritySlicing-r17 ::=     SEQUENCE {","paragraph_zero_based":18635},{"literal_text_all_w_t_and_m_t":"     dl-ImplicitCarrierFreq-r17            INTEGER (0..maxFreq),","paragraph_zero_based":18636},{"literal_text_all_w_t_and_m_t":"    sliceInfoList-r17                     SliceInfoList-r17                                               OPTIONAL  -- Cond Mandatory","paragraph_zero_based":18637},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18638},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18639},{"literal_text_all_w_t_and_m_t":"SliceInfoList-r17 ::=             SEQUENCE (SIZE (1..maxSliceInfo-r17)) OF SliceInfo-r17","paragraph_zero_based":18640},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18641},{"literal_text_all_w_t_and_m_t":"SliceInfo-r17 ::=                 SEQUENCE {","paragraph_zero_based":18642},{"literal_text_all_w_t_and_m_t":"    nsag-IdentityInfo-r17             NSAG-IdentityInfo-r17,","paragraph_zero_based":18643},{"literal_text_all_w_t_and_m_t":"    nsag-CellReselectionPriority-r17  CellReselectionPriority                                             OPTIONAL,  -- Need R","paragraph_zero_based":18644},{"literal_text_all_w_t_and_m_t":"    nsag-CellReselectionSubPriority-r17 CellReselectionSubPriority                                        OPTIONAL,  -- Need R","paragraph_zero_based":18645},{"literal_text_all_w_t_and_m_t":"    sliceCellListNR-r17               CHOICE {","paragraph_zero_based":18646},{"literal_text_all_w_t_and_m_t":"        sliceAllowedCellListNR-r17        SliceCellListNR-r17,","paragraph_zero_based":18647}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["ce3723c028f7b61a97915bd695ebb08e88824b57c96d36739062cad533a38888","e1eb6b89695ba0ebda61a270293db386afade513d00f36557c50cbbe55fc4ede","cfede1f2aa30abe007d3340161531172267991ad31a3aeb7a906b3eb47c48f8d","c36959c0bccb16e2a5ca96c233ebbbc3838bb9150ab74309ed893ce78894a2ff","80c738de6abbd639cd338839359469f234940d7ff72f3278cba811d6acd61146","1f272336acc7787afdde4fdf20e21183ac267b48421dbb1a6791ec9743d106d1","80e7596024a86c969ef0fbe513f1af9279e1e437a33d92a754b172ad0e644a10","91d358a1c7e6e49f92d6b661d0754bb1354a63759cca79956fa5ae8fd3d27849","4a6fc883f5c905e1ebc4eee933fa9ff8fa0ae90ced36b62e214e3c12ad5f5a91","f02a79123300a044da906b7f5efb540ce378e8c140f69ae459675740261b4f34","88e77eab3f36f87cf5fd5e70f64e0fc3f810a1bc168b5f4557dc28c67f0fe225","c021f9e66f10260cdae9828344c00b78eccce801489007c12007840b15f