                                          OPTIONAL,   -- Need M","paragraph_zero_based":38171},{"literal_text_all_w_t_and_m_t":"sl-MinNumRssiMeasurementSlots-r17         INTEGER (1..800)                                                    OPTIONAL,   -- Need M","paragraph_zero_based":38172},{"literal_text_all_w_t_and_m_t":"sl-DefaultCBR-RandomSelection-r17         INTEGER (0..100)                                                    OPTIONAL,   -- Need M","paragraph_zero_based":38173},{"literal_text_all_w_t_and_m_t":"sl-DefaultCBR-PartialSensing-r17          INTEGER (0..100)                                                    OPTIONAL,   -- Need M","paragraph_zero_based":38174},{"literal_text_all_w_t_and_m_t":"sl-CPS-WindowAperiodic-r17                INTEGER (0..30)                                                     OPTIONAL,   -- Need M","paragraph_zero_based":38175},{"literal_text_all_w_t_and_m_t":"sl-PartialSensingInactiveTime-r17         ENUMERATED { enabled, disabled }                                    OPTIONAL,   -- Need M","paragraph_zero_based":38176},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":38177},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":38178},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38179},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-PBPS-CPS-CONFIG-STOP","paragraph_zero_based":38180},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":38181},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38182},{"literal_text_all_w_t_and_m_t":"SL-PBPS-CPS-Config field descriptions","paragraph_zero_based":38183}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["ea66c565f16357979b31f17204dc3e