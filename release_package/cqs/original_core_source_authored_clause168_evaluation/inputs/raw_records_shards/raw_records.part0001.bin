ased":26176},{"literal_text_all_w_t_and_m_t":"Number of measurement reports applicable for eventTriggered as well as for periodical report types.","paragraph_zero_based":26177},{"literal_text_all_w_t_and_m_t":"reportQuantity","paragraph_zero_based":26178},{"literal_text_all_w_t_and_m_t":"The sidelink measurement quantities to be included in the measurement report. In this release, this is set as the CBR measurement result.","paragraph_zero_based":26179},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26180},{"literal_text_all_w_t_and_m_t":"–ReportConfigToAddModList","paragraph_zero_based":26181},{"literal_text_all_w_t_and_m_t":"The IE ReportConfigToAddModList concerns a list of reporting configurations to add or modify.","paragraph_zero_based":26182},{"literal_text_all_w_t_and_m_t":"ReportConfigToAddModList information element","paragraph_zero_based":26183}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["e409fd53a17c0410272024fe28837896088b3306812b185990a4c2b49acdc698","7465ab832811c476670b4453301033ebe38c82093eac36716b0dd0dd207b6df3","c6852f74e38880526c7cd5b6635b8ebdd091ebc869d8ac0a23e1898c191456c1","a7a6b062e17b848fd9f487efdc56b7e08793b8fdacd226dfa7a2f5ac568179ab","3e6db4644b426f3918b207d42a16fc740a61b2e8b99a13681c21330fb4ace24c","c797606afbba3e57608aff668525b6c5fc673d9652abcd81d2256bbba350d870","6f3ee3c80a260aead9761458c04ebf1cd6580b9e2723cb81409086f21d1b2d65","9587fb29dd16efff9999d0f557c231c24d695b50dcff486869d429b5a46bde7e","c03656be43bec60ad56dd8f122055470b03aa2e39fc6a42d8b2377a70ce27b85","077997ab8cd9e10e5b3bb48d8f2a12877fb8d110fe786614f803cc5eba2ebed2","f0c09ebb71efaf79287d785f60c0f39d49946f12874e1e27cb03931b7d39ce3e","919f61655deef24e51b6eaed4a526