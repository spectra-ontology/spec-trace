{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SpeedStateScaleFactors ::=          SEQUENCE {","paragraph_zero_based":28200},{"literal_text_all_w_t_and_m_t":"    sf-Medium                           ENUMERATED {oDot25, oDot5, oDot75, lDot0},","paragraph_zero_based":28201},{"literal_text_all_w_t_and_m_t":"    sf-High                             ENUMERATED {oDot25, oDot5, oDot75, lDot0}","paragraph_zero_based":28202},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28203},{"literal_text_all_w_t_and_m_t":"-- TAG-SPEEDSTATESCALEFACTORS-STOP","paragraph_zero_based":28204},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28205},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28206},{"literal_text_all_w_t_and_m_t":"SpeedStateScaleFactors field descriptions","paragraph_zero_based":28207},{"literal_text_all_w_t_and_m_t":"sf-High","paragraph_zero_based":28208},{"literal_text_all_w_t_and_m_t":"The concerned mobility control related parameter is multiplied with this factor if the UE is in High Mobility state as defined in TS 38.304 [20]. Value oDot25 corresponds to 0.25, value oDot5 corresponds to 0.5, oDot75 corresponds to 0.75 and so on.","paragraph_zero_based":28209},{"literal_text_all_w_t_and_m_t":"sf-Medium","paragraph_zero_based":28210},{"literal_text_all_w_t_and_m_t":"The concerned mobility control related parameter is multiplied with this factor if the UE is in Medium Mobility state as defined in TS 38.304 [20]. Value oDot25 corresponds to 0.25, value oDot5 corresponds to 0.5, value oDot75 corresponds to 0.75, and so on.","paragraph_zero_based":28211},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28212},{"literal_text_all_w_t_and_m_t":"–SPS-Config","paragraph_zero_based":28213},{"literal_text_all_w_t_and_m_t":"The IE SPS-Config is used to configure downlink semi-persistent transmission. Multiple Downlink SPS configurations may be configured in one BWP of a serving cell.","paragraph_zero_based":28214},{"literal_text_all_w_t_and_m_t":"SPS-Config information element","paragraph_zero_based":28215},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28216},{"literal_text_all_w_t_and_m_t":"-- TAG-SPS-CONFIG-START","paragraph_zero_based":28217},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28218},{"literal_text_all_w_t_and_m_t":"SPS-Config ::=                  SEQUENCE {","paragraph_zero_based":28219},{"literal_text_all_w_t_and_m_t":"    periodicity                     ENUMERATED {ms10, ms20, ms32, ms40, ms64, ms80, ms128, ms160, ms320, ms640,","paragraph_zero_based":28220},{"literal_text_all_w_t_and_m_t":"                                                        spare6, spare5, spare4, spare3, spare2, spare1},","paragraph_zero_based":28221},{"literal_text_all_w_t_and_m_t":"    nrofHARQ-Processes              INTEGER (1..8),","paragraph_zero_based":28222},{"literal_text_all_w_t_and_m_t":"    n1PUCCH-AN                      PUCCH-ResourceId                                                            OPTIONAL,   -- Need M","paragraph_zero_based":28223}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["bbcd0b15a18fcc3c504bffcfd8d3671f550906bb4629764661c33b0ecf94beb1","51b9fcdffeba5faafa65c6658bcd4edfd24fa3c0a99d883204f3b3e6b38f7815","3ad29d32e9e11c416564626bb8abe94f864e089c0a7bed901b1ea59f8ca70042","3e8fc2877ab6eaca9fed11a7608179734a948d6b6dea54baa6daff70d73a7b1b","56f820248872777f757e0151ad0db6a160f4de4ee74c23d6108e78c6cbeb3408","1dac33f92430f4f2d1a923fa777525cec4f886206e1d3869897e7f775a97181e","4568d56bff2687c