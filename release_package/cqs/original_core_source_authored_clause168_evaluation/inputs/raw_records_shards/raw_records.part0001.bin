{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-PLMN-IDENTITYINFOLIST-START","paragraph_zero_based":23064},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23065},{"literal_text_all_w_t_and_m_t":"PLMN-IdentityInfoList ::=               SEQUENCE (SIZE (1..maxPLMN)) OF PLMN-IdentityInfo","paragraph_zero_based":23066},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23067},{"literal_text_all_w_t_and_m_t":"PLMN-IdentityInfo ::=                   SEQUENCE {","paragraph_zero_based":23068},{"literal_text_all_w_t_and_m_t":"    plmn-IdentityList                       SEQUENCE (SIZE (1..maxPLMN)) OF PLMN-Identity,","paragraph_zero_based":23069},{"literal_text_all_w_t_and_m_t":"    trackingAreaCode                        TrackingAreaCode                                            OPTIONAL,       -- Need R","paragraph_zero_based":23070},{"literal_text_all_w_t_and_m_t":"    ranac                                   RAN-AreaCode                                                OPTIONAL,       -- Need R","paragraph_zero_based":23071},{"literal_text_all_w_t_and_m_t":"    cellIdentity                            CellIdentity,","paragraph_zero_based":23072},{"literal_text_all_w_t_and_m_t":"    cellReservedForOperatorUse              ENUMERATED {reserved, notReserved},","paragraph_zero_based":23073},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":23074},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":23075},{"literal_text_all_w_t_and_m_t":"    iab-Support-r16                     ENUMERATED {true}                                               OPTIONAL       -- Need S","paragraph_zero_based":23076},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":23077},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":23078},{"literal_text_all_w_t_and_m_t":"    trackingAreaList-r17                SEQUENCE (SIZE (1..maxTAC-r17)) OF TrackingAreaCode             OPTIONAL,      -- Need R","paragraph_zero_based":23079},{"literal_text_all_w_t_and_m_t":"    gNB-ID-Length-r17                   INTEGER (22..32)                                                OPTIONAL       -- Need R","paragraph_zero_based":23080},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":23081},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":23082},{"literal_text_all_w_t_and_m_t":"-- TAG-PLMN-IDENTITYINFOLIST-STOP","paragraph_zero_based":23083},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23084},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23085},{"literal_text_all_w_t_and_m_t":"PLMN-IdentityInfo field descriptions","paragraph_zero_based":23086},{"literal_text_all_w_t_and_m_t":"cellReservedForOperatorUse","paragraph_zero_based":23087}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["812f6d4cea66263e9cfc5a82288d3a0f78a7b43195c1f605a51849ba8b250429","7333b2b5b86b235dfe097d071740c49f843074895c1c1623b2e303648904f9c9","df873217e72ac3ef7ebc3fd367f2b5e7b58d029aaa949add3ae683efdae6cb19","b0f6920fac7d752d00bc6d411004d1d4f177a60b2a23e53512ce92badb2c164c","5ca80b8d08919ecf3d17c191bc91793179dd5e829cc1bc55eefc69bf0ecbe89a","bf65c1af4bde98f36fa5852569133b63ecc79783d91c1039cc80354d8b200492","55559c0b1ff1d2f1d4e1181e56540deaba575276b6dd57bcef605f9fd519af70","58bd1a869c613ea37d6c906525588a56cacc92223b491b8fa5d084ddbf91aa67","6faa77d697a2d423afedbe3e768b578f547cab89cad68f4565964764ade6dd84","8de18071fed8824613e47a006c443fc448ef8347d2eca57573fde2daee9f74f0","3aee08cd39633500ba3febd86837635b27f70f8754b0397fc6503c38d4c1b8b7","c2f3d054bbf07503233e2dd39fa7078ea58b57cf818a2ebc087a750ea7246b37","5b7ddf3d1f549e554cb40b9369c2c8cbb7cfd614cc2ff00c8923bc196e94f19c","e6630af92d57e3591d779db79cdd1d93717627ac54870295f6f9e9695cc5c0e3","f964797520b3bdcc34cc1b2a59b28450eab9113ba7700eb949c82e815ce82f29","97eb6c58ad8506ac7f3826f70c03c77279e804bf7892a92486bf7cd4fb7f0d90","fac0ee7944a92ef48b0b9ff8ecab235c08d5cb807080554f1aed390962fc2ca7","599903a6b719326695cb56cb55d7579ad6ffb75ff8513a3bbcebb96048264e16","b854e97474ab19ba25f410d97e606320089d06c831bc5c1e296c5940b675685a","6fb526054cbbb2d7ce62248717fb399d5e6e729c9ac32017a4fa139e29659a46","6667c8749fa39ac11bdbd0a58f75f57175fc61412b992b0cfbf86b3049318c52","151414a72237521b390c46eaa4ec8215c9ad8cadafb469f258d602331cf8e35c","02eac4ded31b688ae3ef2c3856a45494ba632378415eca4ec3956f06287ee450","36377bbf57a089902db4365cde29e096501248285cf501e7500300c90cc4cad8"],"paragraph_range_zero_based":[23064,23087],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p23064"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether the cell is reserved for operator use (per PLMN), as defined in TS 38.304 [20]. This field is ignored by IAB-MT.","paragraph_zero_based":23088},{"literal_text_all_w_t_and_m_t":"gNB-ID-Length","paragraph_zero_based":23089},{"literal_text_all_w_t_and_m_t":"Indicates the length of the gNB ID out of the 36-bit long cellIdentity.","paragraph_zero_based":23090},{"literal_text_all_w_t_and_m_t":"iab-Support","paragraph_zero_based":23091},{"literal_text_all_w_t_and_m_t":"This field combines both the support of IAB and the cell status for IAB. If the field is present, the cell supports IAB and the cell is also considered as a candidate for cell (re)selection for IAB-node; if the field is absent, the cell does not support IAB and/or the cell is barred for IAB-node.","paragraph_zero_based":23092},{"literal_text_all_w_t_and_m_t":"trackingAreaCode","paragraph_zero_based":23093},{"literal_text_all_w_t_and_m_t":"Indicates Tracking Area Code to which the cell indicated by cellIdentity field belongs. The absence of the field indicates that the cell only supports PSCell/SCell functionality (per PLMN) or is an NTN cell.","paragraph_zero_based":23094},{"literal_text_all_w_t_and_m_t":"trackingAreaList","paragraph_zero_based":23095},{"literal_text_all_w_t_and_m_t":"List of Tracking Areas to which the cell indicated by cellIdentity field belongs. If this field is present, network does not configure trackingAreaCode. Total number of different TACs across different PLMN-IdentityInfos shall not exceed maxTAC. This field is only present in an NTN cell.","paragraph_zero_based":23096},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23097},{"literal_text_all_w_t_and_m_t":"–PLMN-IdentityList2","paragraph_zero_based":23098},{"literal_text_all_w_t_and_m_t":"Includes a list of PLMN identities.","paragraph_zero_based":23099},{"literal_text_all_w_t_and_m_t":"PLMN-IdentityList2 information element","paragraph_zero_based":23100},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":23101},{"literal_text_all_w_t_and_m_t":"-- TAG-PLMNIDENTITYLIST2-START","paragraph_zero_based":23102},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23103},{"literal_text_all_w_t_and_m_t":"PLMN-IdentityList2-r16 ::= SEQUENCE (SIZE (1..16)) OF PLMN-Identity","paragraph_zero_based":23104},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23105},{"literal_text_all_w_t_and_m_t":"-- TAG-PLMNIDENTITYLIST2-STOP","paragraph_zero_based":23106},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23107},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23108},{"literal_text_all_w_t_and_m_t":"–PRB-Id","paragraph_zero_based":23109},{"literal_text_all_w_t_and_m_t":"The IE PRB-Id identifies a Physical Resource Block (PRB) position within a carrier.","paragraph_zero_based":23110},{"literal_text_all_w_t_and_m_t":"PRB-Id information element","paragraph_zero_based":23111}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["e886e67dad46bd85e7863d02eeee613d74060aab9d90fcbd14fb99fdf437b597","81ddf6fb476a85248c8f22651cc53aa3055d818294e042e2545cda9048648e69","5a733eef485ee508fd8e0ae244143fe75eac66fa20aec88ecba7fa879fa2306c","c445ea155a942b86e9b430c78ac6810bb3c6cc119031d85f2278fe90ee91f9d7","5402c0427c6d3617e4f274468ecd0ad43bda5cfcf1929d33836d409d913829e4","8da6edfd7a5d9e177283fcb0eac25fc29ccf29ae4cdd0e85a158d1b9136581cc","41ba672b26a1ee4132a4ff46e993621b1ab00376ea48226c2bb3af5f949d1d7d","5d699cdd430ea1ca0b27247d77ab77851d52ee30c