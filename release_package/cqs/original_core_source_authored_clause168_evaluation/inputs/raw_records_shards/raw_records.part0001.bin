{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":19680},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19681},{"literal_text_all_w_t_and_m_t":"MeasIdleConfig field descriptions","paragraph_zero_based":19682},{"literal_text_all_w_t_and_m_t":"absThreshSS-BlocksConsolidation","paragraph_zero_based":19683},{"literal_text_all_w_t_and_m_t":"Threshold for consolidation of L1 measurements per RS index.","paragraph_zero_based":19684},{"literal_text_all_w_t_and_m_t":"beamMeasConfigIdle","paragraph_zero_based":19685},{"literal_text_all_w_t_and_m_t":"Indicates the beam level measurement configuration.","paragraph_zero_based":19686},{"literal_text_all_w_t_and_m_t":"carrierFreq","paragraph_zero_based":19687},{"literal_text_all_w_t_and_m_t":"Indicates the NR carrier frequency to be used for measurements during RRC_IDLE or RRC_INACTIVE.","paragraph_zero_based":19688},{"literal_text_all_w_t_and_m_t":"carrierFreqEUTRA","paragraph_zero_based":19689},{"literal_text_all_w_t_and_m_t":"Indicates the E-UTRA carrier frequency to be used for measurements during RRC_IDLE or RRC_INACTIVE.","paragraph_zero_based":19690},{"literal_text_all_w_t_and_m_t":"deriveSSB-IndexFromCell","paragraph_zero_based":19691},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE may use the timing of any detected cell on that frequency to derive the SSB index of all neighbour cells on that frequency. If this field is set to true, the UE assumes SFN and frame boundary alignment across cells on the neighbor frequency as specified in TS 38.133 [14].","paragraph_zero_based":19692},{"literal_text_all_w_t_and_m_t":"frequencyBandList","paragraph_zero_based":19693},{"literal_text_all_w_t_and_m_t":"Indicates the list of frequency bands for which the NR idle/inactive measurement parameters apply. The UE shall select the first listed band which it supports in the frequencyBandList field to represent the NR neighbour carrier frequency.","paragraph_zero_based":19694},{"literal_text_all_w_t_and_m_t":"includeBeamMeasurements","paragraph_zero_based":19695},{"literal_text_all_w_t_and_m_t":"Indicates whether or not the UE shall include beam measurements in the NR idle/inactive measurement results.","paragraph_zero_based":19696},{"literal_text_all_w_t_and_m_t":"maxNrofRS-IndexesToReport","paragraph_zero_based":19697},{"literal_text_all_w_t_and_m_t":"Max number of beam indices to include in the idle/inactive measurement result.","paragraph_zero_based":19698},{"literal_text_all_w_t_and_m_t":"measCellListEUTRA","paragraph_zero_based":19699},{"literal_text_all_w_t_and_m_t":"Indicates the list of E-UTRA cells which the UE is requested to measure and report for idle/inactive measurements.","paragraph_zero_based":19700},{"literal_text_all_w_t_and_m_t":"measCellListNR","paragraph_zero_based":19701},{"literal_text_all_w_t_and_m_t":"Indicates the list of NR cells which the UE is requested to measure and report for idle/inactive measurements.","paragraph_zero_based":19702},{"literal_text_all_w_t_and_m_t":"measIdleCarrierListEUTRA","paragraph_zero_based":19703}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["6777a33ff86060f750775aa6e988541956702cadaa4512353f63a68a043de19f","085ef30ec7c9e79114a1ef2d1354b9356eb83e7f4ea5c3d1f90a7dc35c4786b6","a2accdd553698ed482dd0c91742a300e241cbee6ca016ca01de4987771176484","22a5f9f67eefae744fd9bdbad2c7adce164304678584bbdb3e0bfeaed4f25bbf","d3690224b3d29f900b1df7e31401f077536554c4cbbda29da2440b77247dfe69","d49f9c3edc9b76d44168118122bab4f6154a425006933e53d92487d1885d3d8f",