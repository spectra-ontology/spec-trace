{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-DRX-ConfigUC-PC5","paragraph_zero_based":40944},{"literal_text_all_w_t_and_m_t":"Indicates the NR sidelink DRX configuration for unicast communication, as specified in TS 38.321 [3]","paragraph_zero_based":40945},{"literal_text_all_w_t_and_m_t":"sl-LatencyBoundCSI-Report","paragraph_zero_based":40946},{"literal_text_all_w_t_and_m_t":"Indicates the latency bound of SL CSI report from the associated SL CSI triggering in terms of number of slots.","paragraph_zero_based":40947},{"literal_text_all_w_t_and_m_t":"sl-LatencyBoundIUC-Report","paragraph_zero_based":40948},{"literal_text_all_w_t_and_m_t":"Indicates the latency bound of SL Inter-UE coordination report from the associated SL Inter-UE coordination explicit request triggering in terms of number of slots.","paragraph_zero_based":40949},{"literal_text_all_w_t_and_m_t":"sl-LogicalChannelIdentity","paragraph_zero_based":40950},{"literal_text_all_w_t_and_m_t":"Indicates the identity of the sidelink logical channel.","paragraph_zero_based":40951},{"literal_text_all_w_t_and_m_t":"sl-MappedQoS-FlowsToAddList","paragraph_zero_based":40952},{"literal_text_all_w_t_and_m_t":"Indicate the QoS flows to be mapped to the configured sidelink DRB. Each entry is indicated by the SL-PQFI, which is used between UEs, as defined in TS 23.287 [55].","paragraph_zero_based":40953},{"literal_text_all_w_t_and_m_t":"sl-MappedQoS-FlowsToReleaseList","paragraph_zero_based":40954},{"literal_text_all_w_t_and_m_t":"Indicate the QoS flows to be released from the configured sidelink DRB. Each entry is indicated by the SL-PQFI, which is used between UEs, as defined in TS 23.287 [55].","paragraph_zero_based":40955},{"literal_text_all_w_t_and_m_t":"sl-MeasConfig","paragraph_zero_based":40956},{"literal_text_all_w_t_and_m_t":"Indicates the sidelink measurement configuration for the unicast destination.","paragraph_zero_based":40957},{"literal_text_all_w_t_and_m_t":"sl-OutOfOrderDelivery","paragraph_zero_based":40958},{"literal_text_all_w_t_and_m_t":"Indicates whether or not outOfOrderDelivery specified in TS 38.323 [5] is configured. This field should be either always present or always absent, after the sidelink radio bearer is established.","paragraph_zero_based":40959},{"literal_text_all_w_t_and_m_t":"sl-PDCP-SN-Size","paragraph_zero_based":40960},{"literal_text_all_w_t_and_m_t":"Indicates the PDCP SN size of the configured sidelink DRB.","paragraph_zero_based":40961},{"literal_text_all_w_t_and_m_t":"sl-Resetconfig","paragraph_zero_based":40962},{"literal_text_all_w_t_and_m_t":"Indicates that the full configuration should be applicable for the RRCReconfigurationSidelink message.","paragraph_zero_based":40963},{"literal_text_all_w_t_and_m_t":"sl-SDAP-Header","paragraph_zero_based":40964},{"literal_text_all_w_t_and_m_t":"Indicates whether or not a SDAP header is present on this sidelink DRB.","paragraph_zero_based":40965},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40966},{"literal_text_all_w_t_and_m_t":"–RRCReconfigurationCompleteSidelink","paragraph_zero_based":40967}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["78e31396d2cb81fddc704863ed4e0d458716590111d1a8ea2f967e6b63a33171","f0f8ff684254465ae7530faa5ec72438bbeee9636aaa6a87f8d1eb2cde23c343","3948bd8379beadb886f35b580aa020b91173b8d91bb9cd03478b7a99762314fc","17cfde475f23ba589720835f266d438d14b97f13519dfb12dafe8b1f8edfdd06","b8aa1cc0c89dba2f54aa5947dfb40e4c43c67edc69a626eaf96b71e467594a1b","0c90b0860d770a61332fa21671661d0ad99e3a7a899fa226cedb57e3117fad