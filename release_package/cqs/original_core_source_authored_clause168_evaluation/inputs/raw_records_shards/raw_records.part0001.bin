10b17f720","original_member_sha256":"0b2b1acef7c2981dcae001f9ad768411cade15b8ef16fbb988748fdb44fd8de1","paragraph_ElementTree_utf8_XML_sha256":["586634351eb7820c97b387513bd9335c125483a8e3d4ed09ff79d8461f22f7f5","391b80c4c3c851017d4d888c0c5edc2b18720131600a45f28b9a60d19370967c","7cb37d29dc5a41e6e4f6bd99f399ac98374bb03661454baf7f45a71acd447025","5fd94d3af24b4872f677a0501a8d86c738c87efee5031fdd619fa3f953224eae","f8771cf76a18c5f1b38ea8feb56657109c61058d275875ef098c6cbd0397331f","8db6b5c0f077ef91dc530554c9b35fccf37850832a1b9c9c7ab88ca43b5ba3ba","0ac0e862303e5c9c9e7d2783fcf9e86a37bda29d4cbb6a272222d6d466f9264c","8d823dab579d433207a35eb60893a2a0781179cef4954984635093f358277b18","deb18718bb86f31a7e1f589234da9392728afe45b652f98d50da65260678a144","186675b0c441cc14593b06a29ee787bd6e08f1c3f03573336dab19091fd61eca","4383975ac09924b1edf4a6d2a945e7b74ff2f3a54ee09502d9d989b7a346f2a8","d0b0ec0c1ff0fc2f43b4199e794aa68f237417ec05d9b91ebe56a739217297e5","685d324b21ef882db9d87c4605c66255c926ba6a20ab7c3047276bbf6c57183b","d059c3563f3f9aeb3a725eb3903778325a274bfd0755968679321bd0058af419","b02b8431d24739adba75bb71230572f49fa1556cf93c09b0fd22c17ac8c897e4","138f190e9be56390e2e2f63401328fa2126d2decb85a5c247e5e5aec5cdad731","1f4273ab80da0e3d35a6dbb59b7f130428c70646f8db9f97a5b583df700f8f10","b61a946ef7d025b37ef403a552c587fd59b566a2178ce1497eb653d31e2b97d0","3b2b9692325cf95da21686d53158f0d688225238868e7034a347e8eca003823e","596fa15042b53ba31b1acdf91e245d1e2f80db84550ffe537085087e900df958","1911e92cd0cf49185f612e5a420a9c5f9225d017ce96701b75c66b2f131ebcc5","3c7ff9b257dc20e094635e3b4c6a8522dd7eec921a5410a9833b85c0c8e75a65","d0944908612898311bd39dd95801c1ae1619078ef21aff11061c53de521d8570","99fbb8be3064bf6c47bd22a37de2ee1c5c03f172e0de05be5eeae2593fb9743c"],"paragraph_range_zero_based":[24,47],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2401569.zip::R2-2401569 RRC corrections for XR.docx:p24"}
{"fields":{"filename":"R2-2401569.zip::R2-2401569 RRC corrections for XR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"F","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Rel-18","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-16(Release 16)Rel-17(Release 17)Rel-18(Release 18)Rel-19(Release 19)","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":"Reason for change:","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"During ASN.1 review, companies identified a number of issues in TS 38.331 related to the changes introduced by XR Work Item (see R2-2401695). This CR captures corrections to the issues which were found relevant by RAN2 as well as some editorial changes (class 0 issues from ASN.1 review).","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"The following issues are addressed in this CR, following the agreed RIL resolutions as per R2-2401695: H550, V153, I113, H551, V150, I052, H552, H553, F011, H554, H555, H556, F010, H558, X093, A500, F012, H399.","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"Editorial corrections are introduced to address class 0 issues identified during ASN.1 review.","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"The XR related features are not captured entirely correct in the specifications.","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"b3775a5d14ac021fc4f5f3e8002b92527fa1c052d9b7c535f196b5410b17f720","original_member_sha256":"0b2b1acef7c2981dcae001f9ad768411cade15b8ef16fbb988748fdb44fd8de1","paragraph_ElementTree_utf8_XML_sha256":["71847d287eb051d0f409db19ff69ddfff415543e7b880c91894a3130325ca693","f7e83466925653fa04ce845acbeedc7f5809cd24af5a277b428a69be9bbb72bc","5894e47466119f2ffbe8891913b9e2b967bb2b0d36edbcddce77ed24d8f2af93","f6e66e5110d54a8f7bab76509b119a9b2b5913947fd7a12613e1ba28774ebf27","f165183d038c894e522185b2890dbb51cbcbc9971378beae891ae4f169780709","d43795f776aa455320f40b855959ffe52cc00e0c5bdbb9f5d2cdd89de10e8c43","7e0e2ebe1a7d6539c21e17cfdc63907645c3c9a22c0a837eb8b48ef7133f7d25","5c8ccedba467727414edc582590a1b41e0589881ebd5a1fa54d2c2c7131c4e5b","5903056a456a7a9af760dd8239d9226c83b0b2a7158a83cc3da8ef64997cf085","07c05a820d8f2ee94ae063aad0f8ea39f01452c0305b178ea5a8d54c6234be97","10dfb32c6fc51bb3c4eb82e806f1f80ac0a1826f8f1c46882740553657d9ba12","25888bafd8f9cff36ba378946b5ac82eb3e04