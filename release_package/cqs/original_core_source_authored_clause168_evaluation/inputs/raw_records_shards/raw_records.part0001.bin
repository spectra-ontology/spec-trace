{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"For 960 kHz SCS, {1..1280} are valid.","paragraph_zero_based":22032},{"literal_text_all_w_t_and_m_t":"The network configures the same value for all serving cells in the same CellGroupForSwitch.","paragraph_zero_based":22033},{"literal_text_all_w_t_and_m_t":"slotFormatIndicator","paragraph_zero_based":22034},{"literal_text_all_w_t_and_m_t":"Configuration of Slot-Format-Indicators to be monitored in the correspondingly configured PDCCHs of this serving cell.","paragraph_zero_based":22035},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22036},{"literal_text_all_w_t_and_m_t":"–PDCP-Config","paragraph_zero_based":22037},{"literal_text_all_w_t_and_m_t":"The IE PDCP-Config is used to set the configurable PDCP parameters for signalling, MBS multicast and data radio bearers.","paragraph_zero_based":22038},{"literal_text_all_w_t_and_m_t":"PDCP-Config information element","paragraph_zero_based":22039},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":22040},{"literal_text_all_w_t_and_m_t":"-- TAG-PDCP-CONFIG-START","paragraph_zero_based":22041},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22042},{"literal_text_all_w_t_and_m_t":"PDCP-Config ::=         SEQUENCE {","paragraph_zero_based":22043},{"literal_text_all_w_t_and_m_t":"    drb                     SEQUENCE {","paragraph_zero_based":22044},{"literal_text_all_w_t_and_m_t":"        discardTimer            ENUMERATED {ms10, ms20, ms30, ms40, ms50, ms60, ms75, ms100, ms150, ms200,","paragraph_zero_based":22045},{"literal_text_all_w_t_and_m_t":"                                            ms250, ms300, ms500, ms750, ms1500, infinity}       OPTIONAL, -- Cond Setup","paragraph_zero_based":22046},{"literal_text_all_w_t_and_m_t":"        pdcp-SN-SizeUL          ENUMERATED {len12bits, len18