{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the Packet Delay Budget for a PC5 Relay RLC channel. Upper bound value for the delay that a packet may experience expressed in unit of 0.5ms.","paragraph_zero_based":39408},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39409},{"literal_text_all_w_t_and_m_t":"–SL-RLC-ChannelID","paragraph_zero_based":39410},{"literal_text_all_w_t_and_m_t":"The IE SL-RLC-ChannelID is used to identify a PC5 Relay RLC channel in the link between L2 U2N Relay UE and L2 U2N Remote UE.","paragraph_zero_based":39411},{"literal_text_all_w_t_and_m_t":"SL-RLC-ChannelID information element","paragraph_zero_based":39412},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39413},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RLC-CHANNELID-START","paragraph_zero_based":39414},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39415},{"literal_text_all_w_t_and_m_t":"SL-RLC-ChannelID-r17 ::=    INTEGER (1..maxSL-LCID-r16)","paragraph_zero_based":39416},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39417},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RLC-CHANNELID-STOP","paragraph_zero_based":39418},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39419},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39420},{"literal_text_all_w_t_and_m_t":"–SL-RLC-Config","paragraph_zero_based":39421},{"literal_text_all_w_t_and_m_t":"The IE SL-RLC-Config is used to specify the RLC configuration of sidelink DRB. RLC AM configuration is only applicable to the unicast NR sidelink communication.","paragraph_zero_based":39422},{"literal_text_all_w_t_and_m_t":"SL-RLC-Config information element","paragraph_zero_based":39423},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39424},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RLC-CONF