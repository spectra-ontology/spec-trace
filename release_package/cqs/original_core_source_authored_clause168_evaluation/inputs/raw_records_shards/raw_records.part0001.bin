{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    bh-RLC-ChannelID-r16             BH-RLC-ChannelID-r16,","paragraph_zero_based":14904},{"literal_text_all_w_t_and_m_t":"    reestablishRLC-r16               ENUMERATED {true}                 OPTIONAL,   -- Need N","paragraph_zero_based":14905},{"literal_text_all_w_t_and_m_t":"    rlc-Config-r16                   RLC-Config                        OPTIONAL,   -- Cond LCH-Setup","paragraph_zero_based":14906},{"literal_text_all_w_t_and_m_t":"    mac-LogicalChannelConfig-r16     LogicalChannelConfig              OPTIONAL,   -- Cond LCH-Setup","paragraph_zero_based":14907},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":14908},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14909},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14910},{"literal_text_all_w_t_and_m_t":"-- TAG-BHRLCCHANNELCONFIG-STOP","paragraph_zero_based":14911},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":14912},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14913},{"literal_text_all_w_t_and_m_t":"BH-RLC-ChannelConfig field descriptions","paragraph_zero_based":14914},{"literal_text_all_w_t_and_m_t":"bh-LogicalChannelIdentity","paragraph_zero_based":14915},{"literal_text_all_w_t_and_m_t":"Indicates the logical channel id for BH RLC channel of the IAB-node.","paragraph_zero_based":14916},{"literal_text_all_w_t_and_m_t":"bh-RLC-ChannelID","paragraph_zero_based":14917},{"literal_text_all_w_t_and_m_t":"Indicates the BH RLC channel in the link between IAB-MT of the IAB-node and IAB-DU of the parent IAB-node or IAB-donor-DU.","paragraph_zero_based":14918},{"literal_text_all_w_t_and_m_t":"reestablishRLC","paragraph_zero_based":14919},{"literal_text_all_w_t_and_m_t":"Indicates that RLC should be re-established.","paragraph_zero_based":14920},{"literal_text_all_w_t_and_m_t":"rlc-Config","paragraph_zero_based":14921},{"literal_text_all_w_t_and_m_t":"Determines the RLC mode (UM, AM) and provides corresponding parameters.","paragraph_zero_based":14922},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14923},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":14924},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":14925},{"literal_text_all_w_t_and_m_t":"LCH-Setup","paragraph_zero_based":14926},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new logical channel for a BH RLC channel. It is optionally present, Need M, otherwise.","paragraph_zero_based":14927}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["ea72c563fb5bd0bff20b5869db60d31308fa12e59a9063b0efb729b9a8d833aa","a5ad96537af52b27b509c957a48c8e027a989cf036a51b3a7880c97923da9d98","954fd534c9a6368d8cc313eedcc39b426fa34318b63ba5fcf055156567b7e922","d506aff1b70ccfa32c84e30c45d2dbc61a391b84f5de01c85decb8afcfb97c1c","1e1d2e9798819c2effad4c27dadb99698faff9d4012b30da2bd52be2ff2be4e7","aea6c6f50730a5085fc64c629fc83508bd745596aaeb2e0896f69c787da21929","bb31d5dbbfa8e29f58eba555d04f6c182764374ad6b92e134107ec73fa9b7aed","9ad822744f0901e240daedb93b16c7a8c0745af1f7a988716d2e032fd469756a","531b7afc0708590b893483cf8c4bf2d2d91f1f28419780166a59be35aa8ce950","8e97340210df4d86eac8bfcd23bd1c7ac09b8ddb5a533c2bd20afa12c61104fe","5bf2406088eefc18d807b497e831c2c5bbb569480e467e80e829044b6f0c6d04","042dbc6adb03c2ddd64514cdef0b473974359854efbd55d27ec4d3abfc321d2f","4c878dd1459ec0dd10b98ef270482a0988aa304dcb3abcebbbc46a31a35912b1","f5596e1803907b14c16d3c6a0d6dc5513e724843cc7262ad2b937c11fdb8616c","30