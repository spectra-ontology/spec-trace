{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18792},{"literal_text_all_w_t_and_m_t":"NR-PRS-MeasurementInfo-r16 ::=      SEQUENCE {","paragraph_zero_based":18793},{"literal_text_all_w_t_and_m_t":"    dl-PRS-PointA-r16                   ARFCN-ValueNR,","paragraph_zero_based":18794},{"literal_text_all_w_t_and_m_t":"    nr-MeasPRS-RepetitionAndOffset-r16  CHOICE {","paragraph_zero_based":18795},{"literal_text_all_w_t_and_m_t":"        ms20-r16                            INTEGER (0..19),","paragraph_zero_based":18796},{"literal_text_all_w_t_and_m_t":"        ms40-r16                            INTEGER (0..39),","paragraph_zero_based":18797},{"literal_text_all_w_t_and_m_t":"        ms80-r16                            INTEGER (0..79),","paragraph_zero_based":18798},{"literal_text_all_w_t_and_m_t":"        ms160-r16                           INTEGER (0..159),","paragraph_zero_based":18799},{"literal_text_all_w_t_and_m_t":"        ...","paragraph_zero_based":18800},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":18801},{"literal_text_all_w_t_and_m_t":"    nr-MeasPRS-length-r16               ENUMERATED {ms1dot5, ms3, ms3dot5, ms4, ms5dot5, ms6, ms10, ms20},","paragraph_zero_based":18802},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":18803},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18804},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18805},{"literal_text_all_w_t_and_m_t":"-- TAG-LOCATIONMEASUREMENTINFO-STOP","paragraph_zero_based":18806},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18807},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18808},{"literal_text_all_w_t_and_m_t":"LocationMeasurementInfo field descriptions","paragraph_zero_based":18809},{"literal_text_all_w_t_and_m_t":"carrierFreq","paragraph_zero_based":18810},{"literal_text_all_w_t_and_m_t":"The EARFCN value of the carrier received from upper layers for which the UE needs to perform the inter-RAT RSTD measurements.","paragraph_zero_based":18811},{"literal_text_all_w_t_and_m_t":"measPRS-Offset","paragraph_zero_based":18812},{"literal_text_all_w_t_and_m_t":"Indicates the requested gap offset for performing RSTD measurements towards E-UTRA. It is the smallest subframe offset from the beginning of subframe 0 of SFN=0 of the serving cell of the requested gap for measuring PRS positioning occasions in the carrier frequency carrierFreq for which the UE needs to perform the inter-RAT RSTD measurements. The PRS positioning occasion information is received from upper layers. The value of measPRS-Offset is obtained by mapping the starting subframe of the PRS positioning occasion in the measured cell onto the corresponding subframe in the serving cell and is calculated as the serving cell's number of subframes from SFN=0 mod 40.","paragraph_zero_based":18813},{"literal_text_all_w_t_and_m_t":"The UE shall take into account any additional time required by the UE to start PRS measurements on the other carrier when it does this mapping for determining the measPRS-Offset.","paragraph_zero_based":18814},{"literal_text_all_w_t_and_m_t":"NOTE:Figure 6.2.2-1 in TS 36.331[10] illustrates the measPRS-Offset field.","paragraph_zero_based":18815}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["19a16568fc38c2328b236f7e3fe0dc1242b48c7ee7962e3d928e67e37c8e2468","29cb6b45043a375aa4d520b30ad56fda1bb1121603151fc1cd9d8e43f60cae0c","769808077f19befaaae09412a79df0c8c5e7c479da86f6ea920d59a3808985d4","129b7499ea451e6872209cdc1710f0