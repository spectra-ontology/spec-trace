841bdb236a7e08efab6aff70bef7daca2c5959196f4dad840154","0a07f857c489d4dbceb72000bcba10ba48ecf582c2309ea8672f2fcc774158a8","68375d5dbe6406ac2917108c50a0e5cf881645f3d7e8b0e11eb426cbf299b4e3","8576e0a364f0d4e2e56a2e9986a0df5b75b252f791d41e082a68eef4f041a08f","778d1df311405e65a86a690ca2b487f6bb1a6f4c7d1d1f8576abee210cc7bc62","c4ea5398a83048b7144ef169fcdb4d4b8dbee223cd53908ca713d110ed53c040","72486fdcc8d1fc3b13baeb8a95683dc4616fa9a681636186632364b0da67b8e3","ca851208a3cd37f984b7e02b27fb1d6765fc94d435cc9388eadcea6572554417","f37a9b11f751ba9685dc066d746b13392202a19204b169f323c072818d255c1c","34866f8ef202e3b465385ccec3ac746261f80947e9d8bfb51695d878620a7e0f","afb061ba9b8a9ab01ebc6423e8a7bd61e84b4004b4a3f6ed49c403fd4bbdd6f2","8641ce581c8a1ec8460f1ce82420e615707c627edab09b2cf21bb674b8d289e2","4d39e08f67bcaf8944e2f7eae440bd5c46c609b30424924e6834879cc32ab43d","5600b4c36baaffd4643c75504b79f6a54bd07668ab7c005ea780f096319602d1","22124620496574a89afbd94460b1a8933f03008c4f91147b8c11119e333e7344","5fb1c774160f017d8b510cc82aa49cf0c1f4bc595e7efe90640863559e787e21"],"paragraph_range_zero_based":[9624,9647],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p9624"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9648},{"literal_text_all_w_t_and_m_t":"AppLayerBufferLevel-r17 ::= INTEGER (0..30000)","paragraph_zero_based":9649},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9650},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASUREMENTREPORTAPPLAYER-STOP","paragraph_zero_based":9651},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":9652},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9653},{"literal_text_all_w_t_and_m_t":"MeasReportAppLayer field descriptions","paragraph_zero_based":9654},{"literal_text_all_w_t_and_m_t":"appLayerSessionStatus","paragraph_zero_based":9655},{"literal_text_all_w_t_and_m_t":"Indicates that an application layer measurement session in the application layer starts or ends.","paragraph_zero_based":9656},{"literal_text_all_w_t_and_m_t":"measReportAppLayerContainer","paragraph_zero_based":9657},{"literal_text_all_w_t_and_m_t":"The field contains the application layer measurement report container, see Annex L (normative) in TS 26.247 [68], clause 16.5 in TS 26.114 [69] and TS 26.118 [70].","paragraph_zero_based":9658},{"literal_text_all_w_t_and_m_t":"ran-VisibleMeasurements","paragraph_zero_based":9659},{"literal_text_all_w_t_and_m_t":"The field contains the RAN visible application layer measurement report.","paragraph_zero_based":9660},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9661},{"literal_text_all_w_t_and_m_t":"RAN-VisibleMeasurements field descriptions","paragraph_zero_based":9662},{"literal_text_all_w_t_and_m_t":"appLayerBufferLevelList","paragraph_zero_based":9663},{"literal_text_all_w_t_and_m_t":"The field indicates a list of application layer buffer levels, and each AppLayerBufferLevel indicates the application layer buffer level in ms. Value 0 corresponds to 0ms, value 1 corresponds to 10ms, value 2 corresponds to 20 ms and so on. If the buffer level is larger than the maximum value of 30000 (5 minutes), the UE reports 30000.","paragraph_zero_based":9664},{"literal_text_all_w_t_and_m_t":"playoutDelayForMediaStartup","paragraph_zero_based":9665},{"literal_text_all_w_t_and_m_t":"Indicates the application layer playout delay for media start-up in ms. Value 0 corresponds to 0ms, value 1 corresponds to 1ms, value 2 corresponds to 2 ms and so on. If the playout delay for media start-up is larger than the maximum value of 30000ms, the UE reports 30000.","paragraph_zero_based":9666},{"literal_text_all_w_t_and_m_t":"pdu-SessionIdList","paragraph_zero_based":9667},{"literal_text_all_w_t_and_m_t":"Contains the identity of the PDU session, or the identities of the PDU sessions, used for application data flows subject to the RAN visible application layer measurements.","paragraph_zero_based":9668},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9669},{"literal_text_all_w_t_and_m_t":"–MIB","paragraph_zero_based":9670},{"literal_text_all_w_t_and_m_t":"The MIB includes the system information transmitted on BCH.","paragraph_zero_based":9671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["6eb42508193f4660e667c72a96c348f5782cfd61d9d2e8ae8cc5975486fc56f2","5767c4cc31e1467578dd36605759654c2975de889bb7d6aaf23dfbaf8152edc3","3d242e08b5d32be02954eebb62ba957444a992dc680fbb584a05acd4e2ec72ab","84c6dfb544f1938fc773b3ba7f919f549052d7b7345720e48f4352583e67ec47","9b9f8ae0f1126282ea5d68ad6f9d56bfafa6ed834759e22806606ed8fe776dc9","50cd8f44b139529e1716066642f514465b76cb8364a657df3d0256f00647a825","59cd1f5845c529f79360d4d2352704ab6828d0aa88c4b5b6cb6cbef98cbff