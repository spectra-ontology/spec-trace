{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":37056},{"literal_text_all_w_t_and_m_t":"-- TAG-WLANNAMELIST-STOP","paragraph_zero_based":37057},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37058},{"literal_text_all_w_t_and_m_t":"WLAN-NameList field descriptions","paragraph_zero_based":37059},{"literal_text_all_w_t_and_m_t":"WLAN-Name","paragraph_zero_based":37060},{"literal_text_all_w_t_and_m_t":"If configured, the UE only performs WLAN measurements according to the names identified. For each name, it refers to Service Set Identifier (SSID) defined in IEEE 802.11-2012 [50].","paragraph_zero_based":37061},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37062},{"literal_text_all_w_t_and_m_t":"6.3.5Sidelink information elements","paragraph_zero_based":37063},{"literal_text_all_w_t_and_m_t":"–SL-BWP-Config","paragraph_zero_based":37064},{"literal_text_all_w_t_and_m_t":"The IE SL-BWP-Config is used to configure the UE specific NR sidelink communication/discovery on one particular sidelink bandwidth part.","paragraph_zero_based":37065},{"literal_text_all_w_t_and_m_t":"SL-BWP-Config information element","paragraph_zero_based":37066},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":37067},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-BWP-CONFIG-START","paragraph_zero_based":37068},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37069},{"literal_text_all_w_t_and_m_t":"SL-BWP-Config-r16 ::=                    SEQUENCE {","paragraph_zero_based":37070},{"literal_text_all_w_t_and_m_t":"    sl-BWP-Id                                BWP-Id,","paragraph_zero_based":37071},{"literal_text_all_w_t_and_m_t":"    sl-BWP-Generic-r16                       SL-BWP-Generic-r16                                   OPTIONAL,    -- Need M","paragraph_zero_based":37072},{"literal_text_all_w_t_and_m_t":"    sl-BWP-PoolConfig-r16                    SL-BWP-PoolConfig-r16                                OPTIONAL,    -- Need M","paragraph_zero_based":37073},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":37074},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":37075},{"literal_text_all_w_t_and_m_t":"    sl-BWP-PoolConfigPS-r17              SetupRelease {SL-BWP-PoolConfig-r16}                     OPTIONAL,    -- Need M","paragraph_zero_based":37076},{"literal_text_all_w_t_and_m_t":"    sl-BWP-DiscPoolConfig-r17            SetupRelease {SL-BWP-DiscPoolConfig-r17}                 OPTIONAL     -- Need M","paragraph_zero_based":37077},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":37078},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37079}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["877892786e14f82a87cd291598661c35dfae71c340fe5a4cbe8df9dfd1e2802b","d76c095d45981e390e88ea980d1e6189c5e5d8102e3682e950b5beb871e99057","f230013a0253b7b5b45a25063e1d9f508bc24bde3a3faa5756bd5fd90a8cb3ef","7c3db5b7f6c57bb27807407aaee7650163993a1b8802442a5fdab8b768e60c09","7095ef0aba1ba67af221cffc336c601ce5768083a51df23c12bdf3cd3b9afdfd","31ae22f084214cc091ae667c450788d168037c946d7a0814f77888e8f3292a64","691027a1d979938c2585defa2b7e29eb275455d309daba6eb05d155fb8d6de40","8b776df934a99c89b1de4ebd12fbc35b60b5508e865db446699eca0ac49904a6","b530f43b73dcc807714539d5587fdad1c08bb521cecd24e25c269d9bf75c1565","9cefca3d4ddb91b869d6b4d8eff4012bb4884f06e070b47048fd1e31b4dae376","f773c381cab87b92e84de81aa06b4dccc5fb1d51abe34ea40ea61320a2e3e8e2","5322386ea985948f96d073ae26453a6016179f255823879f558074a1f0f398d