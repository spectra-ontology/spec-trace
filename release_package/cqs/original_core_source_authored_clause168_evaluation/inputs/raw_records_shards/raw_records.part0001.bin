S 38.213 [13], clause 7.2).","paragraph_zero_based":23923},{"literal_text_all_w_t_and_m_t":"deltaF-PUCCH-f3","paragraph_zero_based":23924},{"literal_text_all_w_t_and_m_t":"deltaF for PUCCH format 3 with 1dB step size (see TS 38.213 [13], clause 7.2).","paragraph_zero_based":23925},{"literal_text_all_w_t_and_m_t":"deltaF-PUCCH-f4","paragraph_zero_based":23926},{"literal_text_all_w_t_and_m_t":"deltaF for PUCCH format 4 with 1dB step size (see TS 38.213 [13], clause 7.2).","paragraph_zero_based":23927}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["774bf04f80c9f70b12454f3d9f10f917db1ae6599b6f49f4beb1caba453b894b","0589f4289b153d3ab25a1f9dc4589270b660cf2392a99c4f05be624452befb27","26d458365ddcb6c46154919428ec4657dab0a8e64185ca69127008b889611f98","c373d1bbf27a484b6eaa37eeccf6d25c83c688e672082f0b813edca386b42476","bc3124309cc06ba47c212a6ab136b74836de733bcff6986d4b3c27e34de2c92a","0131301eb0fad254b510068eec756918e7b8f8871df03f27374ba8b29eeabef2","cbaf77ecf0c94c6c65e97de256b45c92bd37b9de7ba955acd46d38d7714009bc","7b42f0bc78d171381a7ee073a5d747cab294152083d347abb78b97561b836fa7","ec3ed0738e0ec7c9cf1a422bebdf88511b873c3e005282db541ef0bf5539b858","1aedf728bb98041f386bbfce0dc68a146b3039004f92be8b4143dca85296bbf4","17474244b13f3d6a6ae0744da0173a90276dc95d3d41ac50ccd118bf6b5fa305","0a719ca96e9ed0f6937773eabc1b8dc0f05e43ac06f675a58ab5a1af3a1e1c7d","3a76c2186286d0e435ad2d1197552697af7155b24b6af98db3ff8ce65642af75","3a324df869806261b343911151c62de37ffda293c7424ff4d59118d6a421a706","7f8bebc422cf8bea9d7cbc8e3c05fa08c39d3c43ec4dc63718def55aa52d6490","655df7c6c127052a96cfc4d0905b852f31e51e343dc01c719530191489b0acd0","f536441b18bee7f4c3e0eed1fd25f30508c33a99216005f1ac5bda4d6fb8f795","de