{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"MeasObjectRxTxDiff information element","paragraph_zero_based":19992},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":19993},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASOBJECTRXTXDIFF-START","paragraph_zero_based":19994},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19995},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19996},{"literal_text_all_w_t_and_m_t":"MeasObjectRxTxDiff-r17 ::=      SEQUENCE {","paragraph_zero_based":19997},{"literal_text_all_w_t_and_m_t":"    dl-Ref-r17      CHOICE {","paragraph_zero_based":19998},{"literal_text_all_w_t_and_m_t":"        prs-Ref-r17             NULL,","paragraph_zero_based":19999},{"literal_text_all_w_t_and_m_t":"        csi-RS-Ref-r17          NULL,","paragraph_zero_based":20000},{"literal_text_all_w_t_and_m_t":"        ...","paragraph_zero_based":20001},{"literal_text_all_w_t_and_m_t":"    }                               OPTIONAL,   -- Need R","paragraph_zero_based":20002},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":20003},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":20004},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20005},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASOBJECTRXTXDIFF-STOP","paragraph_zero_based":20006},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":20007},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20008},{"literal_text_all_w_t_and_m_t":"MeasObjectRxTxDiff field descriptions","paragraph_zero_based":20009},{"literal_text_all_w_t_and_m_t":"dl-Ref","paragraph_zero_based":20010},{"literal_text_all_w_t_and_m_t":"configures the DL references signals to measure Rx-Tx time difference. prs-Ref-r17 indicates PRS is chosen, and csi-RS-Ref-r17 indicates that CSI-RS for tracking is chosen.","paragraph_zero_based":20011},{"literal_text_all_w_t_and_m_t":"Only one PRS resource set is configured by the network. Only one NZP-CSI-RS-ResourceSet can be configured with pdc-Info-r17 set to true and it is used for UE Rx-Tx time difference measurement. Only reference signals from the PCell of the MCG can be configured by the network.","paragraph_zero_based":20012},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20013},{"literal_text_all_w_t_and_m_t":"–MeasObjectToAddModList","paragraph_zero_based":20014},{"literal_text_all_w_t_and_m_t":"The IE MeasObjectToAddModList concerns a list of measurement objects to add or modify.","paragraph_zero_based":20015}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["5788834146696a2994c1f411f5854611868725432ded535f69cb533e4d0f6560","529c09fae47fe50334e951095f76865167c7bab1f6709ea6d4f27741bdababc5","84d946091e35835af312ce8a411d1966514fbbd2476cdfef11458e3daafb9f90","13400ec4d93aabb4435a463beb001875470509c8aa4db666f4994faf0c6a39c7","49aeb7ea63454c34d515a46028981c7c92f0d372644ed9cb2b3dea3333992dd0","fb4cb8a93ce534f94620e298a8cebc82d73f72a7a5eb8f08d1e7e55a60a238e8","c1a7e7b757c6b5a52b8c4e82ce70db9a1ffe747a3b19df9f5f2132c367116b74","53154437728874b2cfeddc1096376e4da37db5576a1c0dd40ba5f153bc2c706c","f50e3cb56d1d2fea657485c748fceadb8871389c649209556e05ef1444caf533","11b955a871c8309cb2a73daa64a47bf69cb15cfb1acbd7251d2b3357b5704391","2978f0495dfee721796e055ee0f9dcd48cb173fa3cdbb80cef67e2cec43decbe","3f9ef2ba08b692477399c614371463245bc0282ad653cd66621b2e4f1b88440e","e60d027431e720766700ee50ecbb75f87877031cd4614fa037d6e322d1fe41d2","edd8ba90ac0f8b9fde57b5058956e321d15ef9ffa84930207d900fd25227e3fe","b732dae342d6c82b6582e8a4ad6f083e5ecd