{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36864},{"literal_text_all_w_t_and_m_t":"–EUTRA-Q-OffsetRange","paragraph_zero_based":36865},{"literal_text_all_w_t_and_m_t":"The IE EUTRA-Q-OffsetRange is used to indicate a cell, or frequency specific offset to be applied when evaluating triggering conditions for measurement reporting. The value in dB. Value dB-24 corresponds to -24 dB, value dB-22 corresponds to -22 dB and so on.","paragraph_zero_based":36866},{"literal_text_all_w_t_and_m_t":"EUTRA-Q-OffsetRange information element","paragraph_zero_based":36867},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36868},{"literal_text_all_w_t_and_m_t":"-- TAG-EUTRA-Q-OFFSETRANGE-START","paragraph_zero_based":36869},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36870},{"literal_text_all_w_t_and_m_t":"EUTRA-Q-OffsetRange ::=                     ENUMERATED {","paragraph_zero_based":36871},{"literal_text_all_w_t_and_m_t":"                                                dB-24, dB-22, dB-20, dB-18, dB-16, dB-14,","paragraph_zero_based":36872},{"literal_text_all_w_t_and_m_t":"                                                dB-12, dB-10, dB-8, dB-6, dB-5, dB-4, dB-3,","paragraph_zero_based":36873},{"literal_text_all_w_t_and_m_t":"                                                dB-2, dB-1, dB0, dB1, dB2, dB3, dB4, dB5,","paragraph_zero_based":36874},{"literal_text_all_w_t_and_m_t":"                                                dB6, dB8, dB10, dB12, dB14, dB16, dB18,","paragraph_zero_based":36875},{"literal_text_all_w_t_and_m_t":"                                                dB20, dB22, dB24}","paragraph_zero_based":36876},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36877},{"literal_text_all_w_t_and_m_t":"-- TAG-EUTRA-Q-OFFSETRANGE-STOP","paragraph_zero_based":3