{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":40392},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40393},{"literal_text_all_w_t_and_m_t":"RemoteUEInformationSidelink-IEs field descriptions","paragraph_zero_based":40394},{"literal_text_all_w_t_and_m_t":"sl-RequestedSIB-List","paragraph_zero_based":40395},{"literal_text_all_w_t_and_m_t":"Contains a list of requested SIBs.","paragraph_zero_based":40396},{"literal_text_all_w_t_and_m_t":"SL-SIB-ReqInfo","paragraph_zero_based":40397},{"literal_text_all_w_t_and_m_t":"Indicates the requested SIB type. Values sibNotReq11, sibNotReq10, …, sibNotReq1 shall be ignored by L2 U2N relay UE (i.e., no SIB requested).","paragraph_zero_based":40398},{"literal_text_all_w_t_and_m_t":"sl-PagingInfo-RemoteUE","paragraph_zero_based":40399},{"literal_text_all_w_t_and_m_t":"Indicates the paging information used by L2 U2N Relay UE to perform the connected L2 U2N Remote UE's paging monitoring.","paragraph_zero_based":40400},{"literal_text_all_w_t_and_m_t":"sl-PagingIdentityRemoteUE","paragraph_zero_based":40401},{"literal_text_all_w_t_and_m_t":"Indicates the L2 U2N Remote UE's paging UE ID.","paragraph_zero_based":40402},{"literal_text_all_w_t_and_m_t":"sl-PagingCycleRemoteUE","paragraph_zero_based":40403},{"literal_text_all_w_t_and_m_t":"Indicates the L2 U2N Remote UE's UE specific DRX cycle as the minimum value of the one provided by upper layers (if configured) and the one provided by RRC layer (if configured). Value rf32 corresponds to 32 radio frames, value rf64 corresponds to 64 radio frames and so on.","paragraph_zero_based":40404},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40405},{"literal_text_all_w_t_and_m_t":"–RRCReconfigurationSidelink","paragraph_zero_based":40406},{"literal_text_all_w_t_and_m_t":"The RRCReconfigurationSidelink message is the command to AS configuration of the PC5 RRC connection. It is only applied to unicast of NR sidelink communication.","paragraph_zero_based":40407},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SL-SRB3","paragraph_zero_based":40408},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":40409},{"literal_text_all_w_t_and_m_t":"Logical channel: SCCH","paragraph_zero_based":40410},{"literal_text_all_w_t_and_m_t":"Direction: UE to UE","paragraph_zero_based":40411},{"literal_text_all_w_t_and_m_t":"RRCReconfigurationSidelink message","paragraph_zero_based":40412},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":40413},{"literal_text_all_w_t_and_m_t":"-- TAG-RRCRECONFIGURATIONSIDELINK-START","paragraph_zero_based":40414},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40415}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["d644822adaa41b0e9e7b2cad3a2f19208c9a5db9ecd1c755b859f62c0d505bde","08b0592624bfc6bb28063215f268c8eced295d4635aff5bcbd68f4b4717d2cc3","6396468e4971b5fe637919a70131952971fdd932f6293f7c84cd6ac009b37bef","d6d2d37ccd480d6a3481cfae46cdca2f8d61e35eeba23fcde0c3baa533de04c4","85b9dd416fa0d81ad481b6ce79283697026022e5eafc9111f0b859f5a7a00780","95a77d5662e794283b572a3c9d873f8918aa98ddba14c4b191c928900943f987","1d58411b4d55904d6dc13bc468b955825521deab5cfa0a1f619b8a43d38843fb","2851977d5b3755f1e0364b8395c61411b38222801e6d9209b2de7dbc586a76b9","fc39f5ecea90ba58943114aaf8cc09d2ac69f2f134f4f6630851282f1487ec06","e6ccd98591eb1245203fe30c65b26c1ce932fde85145959b3c33b106f25f8646","efe1e4a6a1f6bdeff15244fc2a94257292c8b1afd0b503f756725ce8539f97da","d681b1a101a2d03e7c336991e219c09a82f96c68aa24