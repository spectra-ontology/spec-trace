{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    sl-BWP-ToAddModList-r16            SEQUENCE (SIZE (1..maxNrofSL-BWPs-r16)) OF SL-BWP-Config-r16    OPTIONAL,  -- Need N","paragraph_zero_based":37728},{"literal_text_all_w_t_and_m_t":"    sl-SyncConfigList-r16              SL-SyncConfigList-r16                                           OPTIONAL,  -- Need M","paragraph_zero_based":37729},{"literal_text_all_w_t_and_m_t":"    sl-SyncPriority-r16                ENUMERATED {gnss, gnbEnb}                                       OPTIONAL   -- Need M","paragraph_zero_based":37730},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37731},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37732},{"literal_text_all_w_t_and_m_t":"SL-Freq-Id-r16 ::=                     INTEGER (1.. maxNrofFreqSL-r16)","paragraph_zero_based":37733},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37734},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-FREQCONFIG-STOP","paragraph_zero_based":37735},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":37736},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37737},{"literal_text_all_w_t_and_m_t":"SL-FreqConfig field descriptions","paragraph_zero_based":37738},{"literal_text_all_w_t_and_m_t":"frequencyShift7p5khzSL","paragraph_zero_based":37739},{"literal_text_all_w_t_and_m_t":"Enable the NR SL transmission with a 7.5 kHz shift to the LTE raster. If the field is absent, the frequency shift is disabled.","paragraph_zero_based":37740},{"literal_text_all_w_t_and_m_t":"sl-AbsoluteFrequencyPointA","paragraph_zero_based":37741},{"literal_text_all_w_t_and_m_t":"Absolute frequency of the reference resource block (Common RB 0). Its lowest subcarrier is also known as Point A.","paragraph_zero_based":37742},{"literal_text_all_w_t_and_m_t":"sl-AbsoluteFrequencySSB","paragraph_zero_based":37743},{"literal_text_all_w_t_and_m_t":"Indicates the frequency location of sidelink SSB. The transmission bandwidth for sidelink SSB is within the bandwidth of this sidelink BWP.","paragraph_zero_based":37744},{"literal_text_all_w_t_and_m_t":"sl-BWP-ToAddModList","paragraph_zero_based":37745},{"literal_text_all_w_t_and_m_t":"This field indicates the list of sidelink BWP(s) on which the NR sidelink communication configuration is to be added or reconfigured. In this release, only one BWP is allowed to be configured for NR sidelink communication.","paragraph_zero_based":37746},{"literal_text_all_w_t_and_m_t":"sl-BWP-ToReleaseList","paragraph_zero_based":37747},{"literal_text_all_w_t_and_m_t":"This field indicates the list of sidelink BWP(s) on which the NR sidelink communication configuration is to be released. ","paragraph_zero_based":37748},{"literal_text_all_w_t_and_m_t":"sl-Freq-Id","paragraph_zero_based":37749},{"literal_text_all_w_t_and_m_t":"This field indicates the identity of the dedicated configuration information on the carrier frequency for NR sidelink communication.","paragraph_zero_based":37750},{"literal_text_all_w_t_and_m_t":"sl-SCS-SpecificCarrierList","paragraph_zero_based":37751}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["9b17a244b16f38f4c6828dddfdc1fcf6e3d6ce3f764aa5fd3111c51274792e5d","a3db64280a85c36bbe093743cc067de4e1ebb65034f7cbaaf7c4351dc8dac0da","69cc09946129eb0837b911a934b37759973fb24a68f51c0adb23375c99f33b9f","0b79c02a973c4ed94c722fd10b09efd30b26c34b036d29765b1f4cf86b80a850","00d0302fa12056d65f0a40aea0ae94fa5b1a9d257425bbbe3fd55745d0e28d99","b153d784a58ccc1b06fbbc94cd9e548fb4075011a0a28a5ab5d692e546c31f0b","9085f1