{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"measId","paragraph_zero_based":20352},{"literal_text_all_w_t_and_m_t":"Identifies the measurement identity for which the reporting is being performed.","paragraph_zero_based":20353},{"literal_text_all_w_t_and_m_t":"measQuantityResults","paragraph_zero_based":20354},{"literal_text_all_w_t_and_m_t":"The value sinr is not included when it is used for LogMeasReport-r16.","paragraph_zero_based":20355},{"literal_text_all_w_t_and_m_t":"measResultCellListSFTD-NR","paragraph_zero_based":20356},{"literal_text_all_w_t_and_m_t":"SFTD measurement results between the PCell and the NR neighbour cell(s) in NR standalone.","paragraph_zero_based":20357},{"literal_text_all_w_t_and_m_t":"measResultCLI","paragraph_zero_based":20358},{"literal_text_all_w_t_and_m_t":"CLI measurement results.","paragraph_zero_based":20359},{"literal_text_all_w_t_and_m_t":"measResultEUTRA","paragraph_zero_based":20360},{"literal_text_all_w_t_and_m_t":"Measured results of an E-UTRA cell.","paragraph_zero_based":20361},{"literal_text_all_w_t_and_m_t":"measResultForRSSI","paragraph_zero_based":20362},{"literal_text_all_w_t_and_m_t":"Includes measured RSSI result in dBm (see TS 38.215 [9]) and channelOccupancy which is the percentage of samples when the RSSI was above the configured channelOccupancyThreshold for the associated reportConfig.","paragraph_zero_based":20363},{"literal_text_all_w_t_and_m_t":"measResultListEUTRA","paragraph_zero_based":20364},{"literal_text_all_w_t_and_m_t":"List of measured results for the maximum number of reported best cells for an E-UTRA measurement identity.","paragraph_zero_based":20365},{"literal_text_all_w_t_and_m_t":"measResultListNR","paragraph_zero_based":20366},{"literal_text_all_w_t_and_m_t":"List of measured results for the maximum number of reported best cells for an NR measurement identity.","paragraph_zero_based":20367},{"literal_text_all_w_t_and_m_t":"measResultListUTRA-FDD","paragraph_zero_based":20368},{"literal_text_all_w_t_and_m_t":"List of measured results for the maximum number of reported best cells for a UTRA-FDD measurement identity.","paragraph_zero_based":20369},{"literal_text_all_w_t_and_m_t":"measResultNR","paragraph_zero_based":20370},{"literal_text_all_w_t_and_m_t":"Measured results of an NR cell.","paragraph_zero_based":20371},{"literal_text_all_w_t_and_m_t":"measResultServFreqListEUTRA-SCG","paragraph_zero_based":20372},{"literal_text_all_w_t_and_m_t":"Measured results of the E-UTRA SCG serving frequencies: the measurement result of PSCell and each SCell, if any, and of the best neighbouring cell on each E-UTRA SCG serving frequency.","paragraph_zero_based":20373},{"literal_text_all_w_t_and_m_t":"measResultServFreqListNR-SCG","paragraph_zero_based":20374},{"literal_text_all_w_t_and_m_t":"Measured results of the NR SCG serving frequencies: the measurement result of PSCell and each SCell, if any, and of the best neighbouring cell on each NR SCG serving frequency.","paragraph_zero_based":20375}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["4d4ab5d81835d190779f8bdd0d55dceeb70d6e2ebca6f08526cc7cf692e1ac6a","d77ed503ad1dfeb05ae0862384c8951dc69effe153094d3407dd4cd5c43be3b9","38df7b90361324c396c44c36a67f7713232b314ed0cad61201344a063135bc02","5ab285609e786d894864f027e9b5929de75a4659a72947aa0d0f350076b6caf3","89f91b01b3fe35fda0a529aba4c0d9150f735e629ce98a7a794bdfd7e07d2f36","836e0ea56881ef155210d17fe60d4fea62fca38eab0363c6e3569aaa5560e117","836cc7efc054af340db669bab88d87c628260128475be497181ee4815b8f1db4","2547b872a3f