{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21000},{"literal_text_all_w_t_and_m_t":"NeedForGapsNR field descriptions","paragraph_zero_based":21001},{"literal_text_all_w_t_and_m_t":"bandNR","paragraph_zero_based":21002},{"literal_text_all_w_t_and_m_t":"Indicates the NR target band to be measured.","paragraph_zero_based":21003},{"literal_text_all_w_t_and_m_t":"gapIndication","paragraph_zero_based":21004},{"literal_text_all_w_t_and_m_t":"Indicates whether measurement gap is required for the UE to perform SSB based measurements on the concerned NR target band while NR-DC or NE-DC is not configured. The UE determines this information based on the resultant configuration of the RRCReconfiguration or RRCResume message that triggers this response. Value gap indicates that a measurement gap is needed, value no-gap indicates a measurement gap is not needed. ","paragraph_zero_based":21005},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21006},{"literal_text_all_w_t_and_m_t":"–NeedForGapNCSG-ConfigEUTRA","paragraph_zero_based":21007},{"literal_text_all_w_t_and_m_t":"The IE NeedForGapNCSG-ConfigEUTRA contains configuration related to the reporting of measurement gap and NCSG requirement information.","paragraph_zero_based":21008},{"literal_text_all_w_t_and_m_t":"NeedForGapNCSG-ConfigEUTRA information element","paragraph_zero_based":21009},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21010},{"literal_text_all_w_t_and_m_t":"-- TAG-NeedForGapNCSG-ConfigEUTRA-START","paragraph_zero_based":21011},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21012},{"literal_text_all_w_t_and_m_t":"NeedForGapNCSG-ConfigEUTRA-r17 ::=        SEQUENCE {","paragraph_zero_based":21013},{"literal_text_all_w_t_and_m_t":"    requestedTargetBandFilterNCSG-EUTRA-r17   SEQUENCE (SIZE