       ENUMERATED {true}                                   OPTIONAL,   -- Need N","paragraph_zero_based":26632},{"literal_text_all_w_t_and_m_t":"    rlc-Config                                  RLC-Config                                          OPTIONAL,   -- Cond LCH-Setup","paragraph_zero_based":26633},{"literal_text_all_w_t_and_m_t":"    mac-LogicalChannelConfig                    LogicalChannelConfig                                OPTIONAL,   -- Cond LCH-Setup","paragraph_zero_based":26634},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":26635},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":26636},{"literal_text_all_w_t_and_m_t":"    rlc-Config-v1610                            RLC-Config-v1610                                    OPTIONAL    -- Need R","paragraph_zero_based":26637},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":26638},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":26639}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["ac0d5022463995ab682bd5659f52d492b8f28684339ddd62ec722902acf0d72a","6d49b4df32c998e17fbcc8aafd29689477902cb35b3c1799097ab8c7eb01b06f","7cfc22fdb17d28ea39318921dfe685ec818a7e8764347a0749b8aa8208966a4f","25b4abd15c8988c7fea5eae1664103eafac7f43789571fc9744e75453216b885","bbe394ee8ee478d5d5e7290ac778f890eab7c8563ad91e1bb3e0f6b020c4ef49","9f10f947f4e8cf16abb1a1b1be21bb185d130ff77d9196c83b9ddfcbd29a3ed0","cb89dce6db4ca8819a017f36a36cc47562b39e7fd705f82e85c9ca450229bee1","c9f8885a1405376aa9074fdf7cfc30ec4a1c0b0ca10530db1d8633d796f053ed","ddccc9a98fbc8db1e2c2783eae829209ea130874992f64aaf2256f7aec0795e3","7143c5033e67e6dbfb52e422f33ccc5985245e88c7af4cff5489fd8199da3b3d","7b2