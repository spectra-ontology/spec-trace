{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE SI-SchedulingInfo contains information needed for acquisition of SI messages.","paragraph_zero_based":28248},{"literal_text_all_w_t_and_m_t":"SI-SchedulingInfo information element","paragraph_zero_based":28249},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28250},{"literal_text_all_w_t_and_m_t":"-- TAG-SI-SCHEDULINGINFO-START","paragraph_zero_based":28251},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28252},{"literal_text_all_w_t_and_m_t":"SI-SchedulingInfo ::=               SEQUENCE {","paragraph_zero_based":28253},{"literal_text_all_w_t_and_m_t":"    schedulingInfoList                  SEQUENCE (SIZE (1..maxSI-Message)) OF SchedulingInfo,","paragraph_zero_based":28254},{"literal_text_all_w_t_and_m_t":"    si-WindowLength                     ENUMERATED {s5, s10, s20, s40, s80, s160, s320, s640, s1280, s2560-v1710, s5120-v1710 },","paragraph_zero_based":28255},{"literal_text_all_w_t_and_m_t":"    si-RequestConfig                    SI-RequestConfig                                                OPTIONAL,  -- Cond MSG-1","paragraph_zero_based":28256},{"literal_text_all_w_t_and_m_t":"    si-RequestConfigSUL                 SI-RequestConfig                                                OPTIONAL,  -- Cond SUL-MSG-1","paragraph_zero_based":28257},{"literal_text_all_w_t_and_m_t":"    systemInformationAreaID             BIT STRING (SIZE (24))                                          OPTIONAL,  -- Need R","paragraph_zero_based":28258},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":28259},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28260},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28261},{"literal_text_all_w_t_and_m_t":"SchedulingInfo ::=                  SEQUENCE {","paragraph_zero_based":282