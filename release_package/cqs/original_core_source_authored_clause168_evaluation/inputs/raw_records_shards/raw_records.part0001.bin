{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26544},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26545},{"literal_text_all_w_t_and_m_t":"RxTxTimeDiff field descriptions","paragraph_zero_based":26546},{"literal_text_all_w_t_and_m_t":"result-k5","paragraph_zero_based":26547},{"literal_text_all_w_t_and_m_t":"This field indicates the Rx-Tx time difference measurement, see TS 38.215 [9], clause 10.1.25.3.1 of TS 38.133 [14] for UE Rx-Tx time difference and clause 13.2.1 of TS 38.133 [14] for gNB Rx-Tx time difference.","paragraph_zero_based":26548},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26549},{"literal_text_all_w_t_and_m_t":"–SCellActivationRS-Config","paragraph_zero_based":26550},{"literal_text_all_w_t_and_m_t":"The IE SCellActivationRS-Config is used to configure a Reference Signal for fast activation of the SCell where the IE is included (see TS 38.214 [19], clause 5.2.1.5.3. Usage of an SCellActivationRS-Config is indicated by including its scellActivationRS-Id in the Enhanced SCell activation MAC CE (see TS 38.321 [3] clause 6.1.3.55).","paragraph_zero_based":26551},{"literal_text_all_w_t_and_m_t":"SCellActivationRS-Config information element","paragraph_zero_based":26552},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26553},{"literal_text_all_w_t_and_m_t":"-- TAG-SCELLACTIVATIONRS-CONFIG-START","paragraph_zero_based":26554},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26555},{"literal_text_all_w_t_and_m_t":"SCellActivationRS-Config-r17 ::= SEQUENCE {","paragraph_zero_based":26556},{"literal_text_all_w_t_and_m_t":"    scellActivationRS-Id-r17         SCellActivationRS-ConfigId-r17,","paragraph_zero_based":26557},{"literal_text_all_w_t_and_m_t":"    resourceSet-r17                  NZP-CSI-RS-ResourceSetId,","paragraph_zero_based":26558},{"literal_text_all_w_t_and_m_t":"    gapBetweenBursts-r17             INTEGER (2..31)                                                            OPTIONAL, -- Need R","paragraph_zero_based":26559},{"literal_text_all_w_t_and_m_t":"    qcl-Info-r17                     TCI-StateId,","paragraph_zero_based":26560},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":26561},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":26562},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26563},{"literal_text_all_w_t_and_m_t":"-- TAG-SCELLACTIVATIONRS-CONFIG-STOP","paragraph_zero_based":26564},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26565},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26566},{"literal_text_all_w_t_and_m_t":"SCellActivationRS-Config field descriptions","paragraph_zero_based":26567}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["930f6ffa2f28dbb38a2e34bb8e17c15f56aa630cadcbd65c46e19ea08e608f8c","cbaf3ee3fe390aefcb856273c35bbb77238374c7d891da4e2ad7eb1be2af7255","22498f0eeaa94de45720776aaed431872f879f70e510136990e367c8652f382c","288ed8cd5789aa98667118faefb28158f15e86b6ef77ac64fc3422b8b1e43de4","337779994c55dc0d7f2ec3953923b7fdef541f07daa46e610e6417ca964cf833","3155a8cf38e2f7b884115807055f016e553b12d8f4a6a076c228c7133f17fcda","8a428b710af5ad579cb84bdac06a0941609c22deca15491f8a583ab895d7e529","7cdc6ca074456138310fca9be822949bd36efe59f263b569268879f962af9d4b","4081ed067f7ad3c1930203ac1f25a0851c80623461f6e82d20623ba0057546f8","c009373b485dad0ccdb2701be6934461d6484299af1cbcb83b6e7e9ab16f8896","f22adbd80029d2111ef6171820e16b77394ef96a443bf80d3deca9d837ad3517","f884ad034a64b5462d63ca869d6ac8c590c404260652e9dbafef9156cec04245","e8b95b1f104f699b8780d15e440574493d50de2c4745b6870b7d03778f9f6e10","9d76a10c239dc03195a834bd78f5664736aef405f56b52d6e968cf6a42e5cd73","f057bd860ecbb95c0805c6e3edd57434341c7dc83e68615b44be825cbacef824","ae69119f3f822d633053f11b793f00f419f2968f2e23c1ea4338890b9ae9bed3","fcb2ef419075bd076cf60c1c13f9a358db5696bea55c943648b8376b16974fba","c30c6f3bf5c58e93c0c12ac571e199c5afb13be07d12b1e2f224894161a74bfc","110821ddad0eb1af80452722471fb634d8bc1087457fed7ea55f61d81e46585d","1647ebc7b9443b970a0c5e3bb830b41f82669993d09620eaf53744dc78f12ee0","3ea6356c38f90d0c182aaf74bad8c6bac43d78472926c8ed93aaa740c03eae53","414cb596729150b01118a90375002eea2c0f9a47655ae82f802ab65e880d2f2f","3c524721868fb2457087920aafe3786259c835d207ad0546bfdfd0774d36664f","ab856df67d796ef809f4eb2928ffa1e52b5c44df770efb173609ee93d790d9ac"],"paragraph_range_zero_based":[26544,26567],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p26544"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"gapBetweenBursts","paragraph_zero_based":26568},{"literal_text_all_w_t_and_m_t":"When this field is present, there are two bursts and it indicates the gap between the two bursts in number of slots. When this field is absent, there is a single burst.","paragraph_zero_based":26569},{"literal_text_all_w_t_and_m_t":"qcl-Info","paragraph_zero_based":26570},{"literal_text_all_w_t_and_m_t":"Reference to TCI-State for providing the QCL source and QCL type for each NZP-CSI-RS-Resource listed in nzp-CSI-RS-Resources of the NZP-CSI-RS-ResourceSet indicated by resourceSet (see TS 38.214 [19], clause 5.1.6.1.1.1). TCI-StateId refers to the TCI-State which has this value for tci-StateId and is defined in tci-StatesToAddModList or dl-OrJointTCI-StateList in the PDSCH-Config included in the BWP-Downlink of this serving cell indicated by firstActiveDownlinkBWP-Id in the ServingCellConfig in which this IE is included.","paragraph_zero_based":26571},{"literal_text_all_w_t_and_m_t":"resourceSet","paragraph_zero_based":26572},{"literal_text_all_w_t_and_m_t":"nzp-CSI-ResourceSetId of the NZP-CSI-RS-ResourceSet of this serving cell used as resource configuration for one or two bursts for SCell activation. This NZP-CSI-RS-ResourceSet consists of four NZP CSI-RS resources in two consecutive slots with two NZP CSI-RS resources in each slot (see TS 38.214 [19], clause 5.1.6.1.1.1). The CSI-RS associated with this NZP-CSI-RS-ResourceSet are located in the BWP addressed by firstActiveDownlinkBWP-Id.","paragraph_zero_based":26573},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26574},{"literal_text_all_w_t_and_m_t":"–SCellActivationRS-ConfigId","paragraph_zero_based":26575},{"literal_text_all_w_t_and_m_t":"The IE SCellActivationRS-ConfigId is used to identify one SCellActivationRS-Config.","paragraph_zero_based":26576},{"literal_text_all_w_t_and_m_t":"SCellActivationRS-ConfigId information element","paragraph_zero_based":26577},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26578},{"literal_text_all_w_t_and_m_t":"-- TAG-SCELLACTIVATIONRS-CONFIGID-START","paragraph_zero_based":26579},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26580},{"literal_text_all_w_t_and_m_t":"SCellActivationRS-ConfigId-r17 ::=        INTEGER (1.. maxNrofSCellActRS-r17)","paragraph_zero_based":26581},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26582},{"literal_text_all_w_t_and_m_t":"-- TAG-SCELLACTIVATIONRS-CONFIGID-STOP","paragraph_zero_based":26583},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26584},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26585},{"literal_text_all_w_t_and_m_t":"–SCellIndex","paragraph_zero_based":26586},{"literal_text_all_w_t_and_m_t":"The IE SCellIndex concerns a short identity, used to identify an SCell. The value range is shared across the Cell Groups.","paragraph_zero_based":26587},{"literal_text_all_w_t_and_m_t":"SCellIndex information element","paragraph_zero_based":26588},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26589},{"literal_text_all_w_t_and_m_t":"-- TAG-SCELLINDEX-START","paragraph_zero_based":26590},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26591}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["0bc152f3032c14abefc8cbcb7bb7157ccfcf2139c8e403bffb57426ea2c9fe6d","c782cfb69927894afa4cd02f83dae26e80f0e1df5dfa292305ec160944b22696","a4abba495e632e12fa3e54981b20dfedd78a3ff4a239ad4acbd8ebd984e3c036","be343746e76436