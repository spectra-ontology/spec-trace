{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    }                                                                                                           OPTIONAL,   -- Need M","paragraph_zero_based":39096},{"literal_text_all_w_t_and_m_t":"    sl-CastType-r16                        ENUMERATED {broadcast, groupcast, unicast, spare1}                   OPTIONAL,   -- Need M","paragraph_zero_based":39097},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":39098},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39099},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39100},{"literal_text_all_w_t_and_m_t":"SL-MappedQoS-FlowsListDedicated-r16 ::= SEQUENCE {","paragraph_zero_based":39101},{"literal_text_all_w_t_and_m_t":"    sl-MappedQoS-FlowsToAddList-r16         SEQUENCE (SIZE (1..maxNrofSL-QFIs-r16)) OF SL-QoS-FlowIdentity-r16  OPTIONAL,    -- Need N","paragraph_zero_based":39102},{"literal_text_all_w_t_and_m_t":"    sl-MappedQoS-FlowsToReleaseList-r16      SEQUENCE (SIZE (1..maxNrofSL-QFIs-r16)) OF SL-QoS-FlowIdentity-r16  OPTIONAL     -- Need N","paragraph_zero_based":39103},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39104},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39105},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SDAP-CONFIG-STOP","paragraph_zero_based":39106},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39107},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39108},{"literal_text_all_w_t_and_m_t":"SL-SDAP-Config field descriptions","paragraph_zero_based":39109},{"literal_text_all_w_t_and_m_t":"sl-DefaultRB","paragraph_zero_based":39110},{"literal_text_all_w_t_and_m_t":"Indicates whether or not this is the default sidelink DRB for this NR sidelink communication transmission destination. Among all configured instances of SL-SDAP-Config for this destination, this field shall be set to true in at most one instance of SL-SDAP-Config and to false in all other instances.","paragraph_zero_based":39111},{"literal_text_all_w_t_and_m_t":"sl-MappedQoS-Flows","paragraph_zero_based":39112},{"literal_text_all_w_t_and_m_t":"Indicates QoS flows to be mapped to the sidelink DRB. If the field is included in dedicated signalling, it is set to sl-MappedQoS-FlowsListDedicated; otherwise, it is set to sl-MappedQoS-FlowsList.","paragraph_zero_based":39113},{"literal_text_all_w_t_and_m_t":"sl-MappedQoS-FlowsList","paragraph_zero_based":39114},{"literal_text_all_w_t_and_m_t":"Indicates the list of QoS profiles of the NR sidelink communication transmission destination mapped to this sidelink DRB.","paragraph_zero_based":39115},{"literal_text_all_w_t_and_m_t":"sl-MappedQoS-FlowsToAddList","paragraph_zero_based":39116},{"literal_text_all_w_t_and_m_t":"Indicates the list of SL QoS flows ID of the NR sidelink communication transmission destination to be additionally mapped to this sidelink DRB.","paragraph_zero_based":39117},{"literal_text_all_w_t_and_m_t":"sl-MappedQoS-FlowsToReleaseList","paragraph_zero_based":39118},{"literal_text_all_w_t_and_m_t":"Indicates the list of SL QoS flows ID of the NR sidelink communication transmission destination to be released from existing QoS flow to SLRB mapping of this sidelink DRB. ","paragraph_zero_based":39119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["de14a469fae46aa0c72ba8efb26676e032a23a968920f01de1f064c6b2dcc939","3ad4b8cf792140b269da700720b9239481c23cd6ecf462f697d234afbe2fbd1c","bd8093e82c54244583277a633184efac564205a6360f782f08dc5c7bdc0906f6","ff44a41