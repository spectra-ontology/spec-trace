{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20088},{"literal_text_all_w_t_and_m_t":"SSB-ToMeasureAltitudeBasedList-r18 ::= SEQUENCE (SIZE (1..maxNrofAltitudeRanges-r18)) OF SSB-ToMeasureAltitudeBased-r18","paragraph_zero_based":20089},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20090},{"literal_text_all_w_t_and_m_t":"SSB-ToMeasureAltitudeBased-r18 ::=     SEQUENCE {","paragraph_zero_based":20091},{"literal_text_all_w_t_and_m_t":"   altitudeRange-r18     SEQUENCE {","paragraph_zero_based":20092},{"literal_text_all_w_t_and_m_t":"      altitudeMin-r18       Altitude-r18   OPTIONAL,  -- Need S","paragraph_zero_based":20093},{"literal_text_all_w_t_and_m_t":"      altitudeMax-r18       Altitude-r18   OPTIONAL,  -- Need S","paragraph_zero_based":20094},{"literal_text_all_w_t_and_m_t":"      altitudeHyst-r18      HysteresisAltitude-r18     OPTIONAL  -- Need S","paragraph_zero_based":20095},{"literal_text_all_w_t_and_m_t":"   },","paragraph_zero_based":20096},{"literal_text_all_w_t_and_m_t":"   ssb-ToMeasure-r18   SSB-ToMeasure     OPTIONAL  -- Need S","paragraph_zero_based":20097},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":20098},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASOBJECTNR-STOP","paragraph_zero_based":20099},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":20100},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20101},{"literal_text_all_w_t_and_m_t":"CellsToAddMod field descriptions","paragraph_zero_based":20102},{"literal_text_all_w_t_and_m_t":"cellIndividualOffset","paragraph_zero_based":20103},{"literal_text_all_w_t_and_m_t":"Cell individual offsets applicable to a specific cell.","paragraph_zero_based":20104},{"literal_text_all_w_t_and_m_t":"physCellId","paragraph_zero_based":20105},{"literal_text_all_w_t_and_m_t":"Physical cell identity of a cell in the cell list.","paragraph_zero_based":20106},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20107},{"literal_text_all_w_t_and_m_t":"MeasObjectNR field descriptions","paragraph_zero_based":20108},{"literal_text_all_w_t_and_m_t":"absThreshCSI-RS-Consolidation","paragraph_zero_based":20109},{"literal_text_all_w_t_and_m_t":"Absolute threshold for the consolidation of measurement results per CSI-RS resource(s) from L1 filter(s). The field is used for the derivation of cell measurement results as described in 5.5.3.3 and the reporting of beam measurement information per CSI-RS resource as described in 5.5.5.2.","paragraph_zero_based":20110},{"literal_text_all_w_t_and_m_t":"absThreshSS-BlocksConsolidation","paragraph_zero_based":20111}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["7555f3f1697ca685ba40c24c7a686bfbd73a734e0da6b183edc6cb47c4500669","d319d783d512badf2b05f80a872e13ee1bb41e899bdd7f39c51a736defd8bd7f","782dea275de196f28d407592d105444dd6e5dd24e09360dcc5594ce03e64d9e7","ea7f153d04aaad4eff067a49edac92d79e648bc92d9bfcd3da9f55582a7ad79c","cafa71a851c79dd2a20a26ef59aecac4c113fed2b736fa3592176ffbb8dabef1","db0d1c5b2604316eb9f7dba0ac94f45d6cf431114479aa0dfe42296f69338a19","0e106c0054102fa4673be42abe356543f56808fe9e9234c16a4c2320ce6b7fa0","99a8785c9ef191d4862b854f00607293e20e22574868cb4132814ace325d827a","255f80569f2b032309814643826c9e7d7553f928658499400a212b2a29007673","a4390aca1cf6db9291e7f8e1a32bce2dfeff1b670535c12c8e0dae44f4c91a8c","c792d8ff68e2bc8e77d6200bdcdf9b96784cea62a37470c305c1f67d2ad13fd4","aa75ac14ce4df018e67b90b114336c43aee97ad3cc18bcb8b78ad4eb05d64c06","53379614ab4cf677b1c06c6dc61e3fa54457acbee463c423a64a389fa8c0919d","8f095d7898faf655ebf34c6ac8cfc020f721c34f7d5f3cd26743b05c4e7e0e19","1fabd0a8799c00763d706b5ffa4f5d9e0853202e76dbc057ffaf85c6ca6059c8","68a8a727a492ab9366f3ce0827835b98bbc88643b798b2d4b59146d525eb1235","e2d223aa2a999b30732e5d4e9ad28111d100220de6bc68253913c4521028c4c3","d87cc4b87880607ebe6faaad77cf0f230f2a2a9a2afdd4d13fcc06c407e11356","c5a5311d752f6564586d2e6023a1ee858d7518cfc176e2314eea9ff3d37c609d","ac2d05a8aa881ccc4190af871d327960c47b9083b30c3428100049ed93162274","5dd09f2e9ba768137424e52f3225db4acb08beb88a7d8e7eb8c0d6ea29e71c4d","0a164e9bc335b1f5ddc661ef6f8e9c139ef9c01abe8037efcaf00a81b8eb2ef3","15c72a8e3338bdd085d39ffe538b211881f00d78420b69b1046ee49fd9998cfd","43c18fd708a4d7ae1db438e036be37794aaf2301c3a4cc16f837760ba95ae228"],"paragraph_range_zero_based":[20088,20111],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p20088"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Absolute threshold for the consolidation of measurement results per SS/PBCH block(s) from L1 filter(s). The field is used for the derivation of cell measurement results as described in 5.5.3.3 and the reporting of beam measurement information per SS/PBCH block index as described in 5.5.5.2.","paragraph_zero_based":20112},{"literal_text_all_w_t_and_m_t":"allowedCellsToAddModList","paragraph_zero_based":20113},{"literal_text_all_w_t_and_m_t":"List of cells to add/modify in the allow-list of cells. It applies only to SSB resources.","paragraph_zero_based":20114},{"literal_text_all_w_t_and_m_t":"allowedCellsToRemoveList","paragraph_zero_based":20115},{"literal_text_all_w_t_and_m_t":"List of cells to remove from the allow-list of cells.","paragraph_zero_based":20116},{"literal_text_all_w_t_and_m_t":"associatedMeasGapSSB","paragraph_zero_based":20117},{"literal_text_all_w_t_and_m_t":"Indicates the associated measurement gap for SSB measuring identified by ssb-ConfigMobility in this measurement object. When multiple MeasObjectNR with the same SSB frequency are configured, the network configures the same measurement gap ID in this field for each MeasObjectNR. If this field is absent, the associated measurement gap is the gap configured via gapFR1, gapFR2, or gapUE.","paragraph_zero_based":20118},{"literal_text_all_w_t_and_m_t":"associatedMeasGapSSB2","paragraph_zero_based":20119},{"literal_text_all_w_t_and_m_t":"Indicates the associated additional measurement gap for SSB measuring identified by ssb-ConfigMobility in this measurement object for NTN deployments. When multiple MeasObjectNR with the same SSB frequency are configured, the network configures the same measurement gap ID in this field for each MeasObjectNR. If this field is absent, the associated measurement gap is the gap indicated by associatedMeasGapSSB.","paragraph_zero_based":20120},{"literal_text_all_w_t_and_m_t":"associatedMeasGapCSIRS","paragraph_zero_based":20121},{"literal_text_all_w_t_and_m_t":"Indicates the associated measurement gap for CSI-RS measuring identified by csi-rs-ResourceConfigMobility in this measurement object. If this field is absent, the associated measurement gap is the gap configured via gapFR1, gapFR2, or gapUE.","paragraph_zero_based":20122},{"literal_text_all_w_t_and_m_t":"associatedMeasGapCSIRS2","paragraph_zero_based":20123},{"literal_text_all_w_t_and_m_t":"Indicates the associated additional measurement gap for CSI-RS measuring identified by csi-rs-ResourceConfigMobility in this measurement object for NTN deployments. If this field is absent, the associated measurement gap is the gap indicated by associatedMeasGapCSIRS. In this release of the specification, this field is not configured for NTN deployments.","paragraph_zero_based":20124},{"literal_text_all_w_t_and_m_t":"cellsToAddModList","paragraph_zero_based":20125},{"literal_text_all_w_t_and_m_t":"List of cells to add/modify in the cell list.","paragraph_zero_based":20126},{"literal_text_all_w_t_and_m_t":"cellsToRemoveList","paragraph_zero_based":20127},{"literal_text_all_w_t_and_m_t":"List of cells to remove from the cell list. ","paragraph_zero_based":20128},{"literal_text_all_w_t_and_m_t":"excludedCellsToAddModList","paragraph_zero_based":20129},{"literal_text_all_w_t_and_m_t":"List of cells to add/modify in the exclude-list of cells. It applies only to SSB resources.","paragraph_zero_based":20130},{"literal_text_all_w_t_and_m_t":"excludedCellsToRemoveList","paragraph_zero_based":20131},{"literal_text_all_w_t_and_m_t":"List of cells to remove from the exclude-list of cells.","paragraph_zero_based":20132},{"literal_text_all_w_t_and_m_t":"freqBandIndicatorNR","paragraph_zero_based":20133},{"literal_text_all_w_t_and_m_t":"The frequency band in which the SSB and/or CSI-RS indicated in this MeasObjectNR are located and according to which the UE shall perform the RRM measurements. This field is always provided when the network configures measurements with this MeasObjectNR.","paragraph_zero_based":20134},{"literal_text_all_w_t_and_m_t":"measCyclePSCell","paragraph_zero_based":20135}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["890cfc67838ec42849d3b8edbf55d88e1911b4924444675c93c40320bdd9f7b4","9ecce0c62a2574192d0b93f15405e4fc7a1b3ef5536b3acabb59c2e59abbb431","ca2cf5a5eb508f71a1db52c6c7a37d57c2b8a65ec8ed382500509a674946b540","f6ec4c3bb2199b1701d620d7ee079fbb64ba8fdd203a6b0c654f4cdb640cf241","71f4762f8606d7859330892c0476db3357940e1b1632c7bd8a8df6923cc42829","e3c24616288a229ebad223d6a337489358ea349dd5f1cebfc9217be44d31c889","5bb212ce58db0ad2e93cf6f0292b44b5db1a9a6b7029a307e5159ce50b863e8e","2a52ed9e4ea04047fdb1a2bca699bdbd4b7f381ca9565e788c258a838202c042","aac2bcb47c11b3fdac40d124ad1f20e2b93028aba7b0ccd2a6e34089b8672ff0","cecd0cd06888c472c039675f68d0b2a465c090e2001fe13568719994d17ea5df","5463f602ae4f407c7feec01f5c9b5f82d939b3f22f946e83e1a088999f1e3ab2","1c497f4309c6f37f1cab1f0f706d28e979547a03cc02b60743d132805448d605","77d86a9c0e20a88f9386e95f4c754b53443cc737057f7cfb58288524374d2208","a4fccf69c73d5899798f92b5bdd8597d1b36805caf8753b53ffdb768bbeffa88","0cbc05dd6f2b8b11be8f111e59096fbfdcce502d4619188ec7d09c85eb56506c","1ddb7bdf8c9af2382881985217ba3ba585dd9978907219c53cd19705de190170","5af315a528f20494f4dd5425e62d1ac8189a31174fdd449c44671fdb477ccc10","70e0c3a86a161357b5c38390459030571d94874390aea245058fddf8d86ab9c3","d7421345ab396a5692549f4580d85a1f277ee4d75ab9c0008b126b404aa545dd","8a52a4990f290fc898c6afc7676281fa651ff6b17cb8d910fcd1552372d214c7","123073bfbe7c39fda0472bd94939717cf49bfc1894d36e2577cfab7f5c901753","1106e9715a699ac900135a3ce734be420fcf4b84f9818760b28a57f9cdaeaff4","c26a266aaf6a85e0bef9d41af0d14acb831df4dea8e141a91160c556f94ff719","3020b9e0e69ee23c75e0c11b7e3e705628b7b8a79629728ec42e909f5feb4ee8"],"paragraph_range_zero_based":[20112,20135],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p20112"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The parameter is used only when the PSCell is configured on the frequency indicated by the measObjectNR and the SCG is deactivated, see TS 38.133 [14]. The field may also be configured when the PSCell is not configured on that frequency. The network always configures measCyclePSCell for the measObjectNR associated with the PSCell if bfd-and-RLM is set to true and the SCG is deactivated. Value ms160 corresponds to 160 ms, value ms256 corresponds to 256 ms and so on.","paragraph_zero_based":20136},{"literal_text_all_w_t_and_m_t":"measCycleSCell","paragraph_zero_based":20137},{"literal_text_all_w_t_and_m_t":"The parameter is used only when an SCell is configured on the frequency indicated by the measObjectNR and is in deactivated state, see TS 38.133 [14]. gNB configures the parameter whenever an SCell is configured on the frequency indicated by the measObjectNR, but the field may also be signalled when an SCell is not configured. Value sf160 corresponds to 160 sub-frames, value sf256 corresponds to 256 sub-frames and so on.","paragraph_zero_based":20138},{"literal_text_all_w_t_and_m_t":"nrofCSInrofCSI-RS-ResourcesToAverage","paragraph_zero_based":20139},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of measurement results per beam based on CSI-RS resources to be averaged. The same value applies for each detected cell associated with this MeasObjectNR.","paragraph_zero_based":20140},{"literal_text_all_w_t_and_m_t":"nrofSS-BlocksToAverage","paragraph_zero_based":20141},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of measurement results per beam based on SS/PBCH blocks to be averaged. The same value applies for each detected cell associated with this MeasObject.","paragraph_zero_based":20142},{"literal_text_all_w_t_and_m_t":"ntn-PolarizationDL","paragraph_zero_based":20143},{"literal_text_all_w_t_and_m_t":"If present, this parameter indicates polarization information for downlink transmission on service link: including Right hand, Left hand circular polarizations (RHCP, LHCP) and Linear polarization.","paragraph_zero_based":20144},{"literal_text_all_w_t_and_m_t":"ntn-PolarizationUL","paragraph_zero_based":20145},{"literal_text_all_w_t_and_m_t":"If present, this parameter indicates polarization information for uplink transmission on service link. If not present and ntn-PolarizationDL is present, UE assumes the same polarization for UL and DL.","paragraph_zero_based":20146},{"literal_text_all_w_t_and_m_t":"offsetMO","paragraph_zero_based":20147},{"literal_text_all_w_t_and_m_t":"Offset values applicable to all measured cells with reference signal(s) indicated in this MeasObjectNR.","paragraph_zero_based":20148},{"literal_text_all_w_t_and_m_t":"quantityConfigIndex","paragraph_zero_based":20149},{"literal_text_all_w_t_and_m_t":"Indicates the n-th element of quantityConfigNR-List provided in MeasConfig.","paragraph_zero_based":20150},{"literal_text_all_w_t_and_m_t":"referenceSignalConfig","paragraph_zero_based":20151},{"literal_text_all_w_t_and_m_t":"RS configuration for SS/PBCH block and CSI-RS.","paragraph_zero_based":20152},{"literal_text_all_w_t_and_m_t":"refFreqCSI-RS","paragraph_zero_based":20153},{"literal_text_all_w_t_and_m_t":"Point A which is used for mapping of CSI-RS to physical resources according to TS 38.211 [16] clause 7.4.1.5.3.","paragraph_zero_based":20154},{"literal_text_all_w_t_and_m_t":"smtc1","paragraph_zero_based":20155},{"literal_text_all_w_t_and_m_t":"Primary measurement timing configuration. (see clause 5.5.2.10).","paragraph_zero_based":20156},{"literal_text_all_w_t_and_m_t":"smtc2","paragraph_zero_based":20157},{"literal_text_all_w_t_and_m_t":"Secondary measurement timing configuration for SS corresponding to this MeasObjectNR with PCI listed in pci-List. For these SS, the periodicity is indicated by periodicity in smtc2 and the timing offset is equal to the offset indicated in periodicityAndOffset modulo periodicity. periodicity in smtc2 can only be set to a value strictly shorter than the periodicity indicated by periodicityAndOffset in smtc1 (e.g. if periodicityAndOffset indicates sf10, periodicity can only be set of sf5, if periodicityAndOffset indicates sf5, smtc2 cannot be configured).","paragraph_zero_based":20158},{"literal_text_all_w_t_and_m_t":"smtc3list","paragraph_zero_based":20159}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["3c95f4f256fb92605735d3e89fd7fbf4bab72c94d69aa1daae2f728a2bd26273","8bb02c17250463b57883f488f017af7e91bee154ba01e487f042fab14fc9e979","1e02a129ef351e1d183f22fe64553b0aa53b7555cef4baf29ca2a42183054a3d","39974e59f699e2e944889a5a4dadff04423a3ebb33fa224d781ba2954d451720","fde11eaba077d63ef0ac71db53f1601932cda0759b41770e7e343f008b110d86","e7d6673bd468ef9f3d996b649b0fdb76f3416d500d1a9b1a9cab6995fd71c521","46a8206602e8a82effe20733cc30042e8e900e7fd0654e6a33d283384e67e1bf","b8b348b0965bbbea3b9e032a4e6fd3309597eece60c027695ca47810323499a7","c90642cbb09a9c96bd4785731e680cafd8915ad14ef1fea30ba73f70d6e99287","b6547507a053f2ab910bc86f6e544c96c5a1efef27d1b8fbfaad2d6f041334f8","4c1d07610e4aed45561db55020d8b2608637b5d7dd60ee475407878a6a216c28","5b54f8bb14bef488c835034daeb0367f6d8e5b470e1e675a8fe4f19e56382afb","ef5439f93abc32f7367f7577fc6bc1866d7a8a8da4291e6071505bb56b5d1f27","177196f15ea4929258ecc3961bd75285756eadb1e7cb52c0683fff3a521b1149","712c6a26d95ca410172f9abb410d74cb1b8f8fd9abd04dc28fbbe4d8cf16fb70","c210ad5a0c25510f6731618e27ed0488da2f35940aa672cf60c65d9324af4f91","6876d2d9e59dfa7f2e2fbc63e2d9bd76daa8c35af7638c8dca6e193fe7ee0f18","0f6949c9780ce8062d4d369e647afb085f545e61a0033297d0f55001b0d9e82b","c7a75ad0f4c03e26e76dbd0384a8c417635f56d2450783ae1a58010c83765194","de72f42f2ec5ed46ff0b821e16df3ebf23c68f63cb3a49e5e8c564a8934582f5","d49b614e4dc6ee10226a6a68e1bf368c2cdf7cb6b37160dc0a3e139c6a15fefa","a8ad894ee800a29c07d179343e09d67b93ee0c370ede6633429fb4c2e3e7f6c1","5b1fcc0e2a1de0978ea88d4ee07ac4667aa9fe569d87018eb205737c22551f67","dba3999f55f528e554cf6c68791142911be63702c90d727fd483238c7b8352bf"],"paragraph_range_zero_based":[20136,20159],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p20136"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Measurement timing configuration list for SS corresponding to IAB-MT. This is used for the IAB-node's discovery of other IAB-nodes and the IAB-Donor-DUs.","paragraph_zero_based":20160},{"literal_text_all_w_t_and_m_t":"smtc4list","paragraph_zero_based":20161},{"literal_text_all_w_t_and_m_t":"Measurement timing configuration list for NTN deployments, see clause 5.5.2.10.","paragraph_zero_based":20162},{"literal_text_all_w_t_and_m_t":"ssbFrequencyIndicates the frequency of the SS associated to this MeasObjectNR. For operation with shared spectrum channel access, this field is a k*30 kHz shift from the sync raster where k = 0,1,2, and so on if the reportType within the corresponding ReportConfigNR is set to reportCGI (see TS 38.211 [16], clause 7.4.3.1). Frequencies are considered to be on the sync raster if they are also identifiable with a GSCN value (see TS 38.101-1 [15], or TS 38.101-5 [75]).","paragraph_zero_based":20163},{"literal_text_all_w_t_and_m_t":"ssb-PositionQCL-Common","paragraph_zero_based":20164},{"literal_text_all_w_t_and_m_t":"Indicates the QCL relationship between SS/PBCH blocks for all measured cells as specified in TS 38.213 [13], clause 4.1.","paragraph_zero_based":20165},{"literal_text_all_w_t_and_m_t":"ssbSubcarrierSpacing","paragraph_zero_based":20166},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing of SSB.","paragraph_zero_based":20167},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":20168},{"literal_text_all_w_t_and_m_t":"FR1:    15 or 30 kHz","paragraph_zero_based":20169},{"literal_text_all_w_t_and_m_t":"FR2-1:  120 or 240 kHz","paragraph_zero_based":20170},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":20171},{"literal_text_all_w_t_and_m_t":"t312","paragraph_zero_based":20172},{"literal_text_all_w_t_and_m_t":"The value of timer T312. Value ms0 represents 0 ms, ms50 represents 50 ms and so on.","paragraph_zero_based":20173},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20174},{"literal_text_all_w_t_and_m_t":"ReferenceSignalConfig field descriptions","paragraph_zero_based":20175},{"literal_text_all_w_t_and_m_t":"csi-rs-ResourceConfigMobility","paragraph_zero_based":20176},{"literal_text_all_w_t_and_m_t":"CSI-RS resources to be used for CSI-RS based RRM measurements.","paragraph_zero_based":20177},{"literal_text_all_w_t_and_m_t":"ssb-ConfigMobility","paragraph_zero_based":20178},{"literal_text_all_w_t_and_m_t":"SSB configuration for mobility (nominal SSBs, timing configuration).","paragraph_zero_based":20179},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20180},{"literal_text_all_w_t_and_m_t":"RMTC-Config field descriptions","paragraph_zero_based":20181},{"literal_text_all_w_t_and_m_t":"measDurationSymbols","paragraph_zero_based":20182},{"literal_text_all_w_t_and_m_t":"Number of consecutive symbols for which the Physical Layer reports samples of RSSI (see TS 38.215 [9], clause 5.1.21). Value sym1 corresponds to one symbol, sym14or12 corresponds to 14 symbols of the reference numerology for NCP and 12 symbols for ECP, and so on.","paragraph_zero_based":20183}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["4aa7af2907cb5bb2f3ef7d7cabc5dcf6a28357920789971be3413f9b44c3d703","d6cc2408fa56467e33f00432c444ca8dea062992293418308263adcdf5cd4614","6dc149cd1fa37de604f6adda22113556e1b1495764fd906ae867cf1b8c0fdd3b","b394f0fa509a9d26cd23e3e762c4849e1b3302c9cb7ea2b18ede8c7ab46488c4","70a564ddf0026fa1e961ac63c4038f35c4fe4a0419f5979047f9d70bd6d7446b","97335303981206a1db27be965cafd0aa365f7d9b514a29950cd9df4758593b9d","423b8d0dc42d4d94da5abd0d7e0cf597834fc9975658f916a868c546df478868","b55812b9b86bfd45c3526d18d51207b78164679a282f94bb9cee309de4f82a80","80c6c36970df3ee925718701f4439e922dd0a90fecd22879a2644ee50740ce74","66781bed494acebaf7bd4b0a8b78e09c8018231209eac8fc19bb2d10272b81b8","9d98b427a2fc7f2de26df4508fc15ada9e996ec37558f93f598fcfdbf3d878a8","af59fa7f6c389511cee060b0180cf85197d28e98779bd6da8247f345d19d5ce6","12ae50d945759694116c077bf1746e374ef5456fb68417a0b61860043e769836","1cd138629931648cfd499d21d74aeb6dbda83321e50c85266edd50eeb735589b","a65634a1fc87aa81719f35c8bea77da0c314659f7cce86e6f1383ae1e79b29ea","f1d358705685fe988b2e696f2ef5ac3958395aab21991550292f75af4d0beb03","dbfc7a0d44ca9b4ac88630174f3e862a831e22c3002e06cda6131547623b5902","6fc50719d3d12c4019cdf211f5bee407d50aa93d265e65c40aeac916d5a2dd1f","c77f02eebc0c7d077293716ea2c825f27485911040325bab81114e9d7c0b304f","793db6f12ef3aec885fd18022f062a94dd9905fd8be305e820b466df15880d71","063a4a6877e83557cb865ff0a5fbe5a5223e7434dd3fa54263f5cc4de97f2192","2660e98092c584edbf8f5f185d6549b31893e4544f97656d469bb4f157382045","81fd52f6b6f986ca8cb127533894abbcebecef3b3b0deac5417a57894e520002","c61ddce76819ee2e7bce905730a4e022be04d73a55b3b908d5662c6f8415aa0c"],"paragraph_range_zero_based":[20160,20183],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p20160"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"If measDurationSymbols-v1700 is signalled, the UE ignores measDurationSymbols-r16.","paragraph_zero_based":20184},{"literal_text_all_w_t_and_m_t":"ref-BWPId","paragraph_zero_based":20185},{"literal_text_all_w_t_and_m_t":"Indicates the reference BWP for the TCI state indicated in tci-StateInfo. Network includes this field if tci-StateInfo is present. This field is only applicable for operation with shared spectrum channel access in FR2-2 and network does not configure this if the UE does not have any serving cells in FR2-2.","paragraph_zero_based":20186},{"literal_text_all_w_t_and_m_t":"ref-SCS-CP","paragraph_zero_based":20187},{"literal_text_all_w_t_and_m_t":"Indicates a reference subcarrier spacing and cyclic prefix to be used for RSSI measurements (see TS 38.215 [9]). Value kHz15 corresponds to 15kHz, kHz30 corresponds to 30 kHz, value kHz60-NCP corresponds to 60 kHz using normal cyclic prefix (NCP), and kHz60-ECP corresponds to 60 kHz using extended cyclic prefix (ECP).","paragraph_zero_based":20188},{"literal_text_all_w_t_and_m_t":"If ref-SCS-CP-v1700 is signalled, the UE ignores ref-SCS-CP-r16.","paragraph_zero_based":20189},{"literal_text_all_w_t_and_m_t":"ref-ServCellId","paragraph_zero_based":20190},{"literal_text_all_w_t_and_m_t":"Indicates the FR2-2 reference serving cell index for the TCI state. Network includes this field if tci-StateInfo is present. This field is only applicable for operation with shared spectrum channel access in FR2-2 and network does not configure this if the UE does not have any serving cells in FR2-2.","paragraph_zero_based":20191},{"literal_text_all_w_t_and_m_t":"rmtc-Bandwidth","paragraph_zero_based":20192},{"literal_text_all_w_t_and_m_t":"Indicates the bandwidth for the RSSI measurement (see TS 38. 215 [9], clause 5.1.21).","paragraph_zero_based":20193},{"literal_text_all_w_t_and_m_t":"rmtc-Frequency","paragraph_zero_based":20194},{"literal_text_all_w_t_and_m_t":"Indicates the center frequency of the measured bandwidth for a frequency which operates with shared spectrum channel access (see TS 38. 215 [9], clause 5.1.21).","paragraph_zero_based":20195},{"literal_text_all_w_t_and_m_t":"rmtc-Periodicity","paragraph_zero_based":20196},{"literal_text_all_w_t_and_m_t":"Indicates the RSSI measurement timing configuration (RMTC) periodicity (see TS 38.215 [9], clause 5.1.21).","paragraph_zero_based":20197},{"literal_text_all_w_t_and_m_t":"rmtc-SubframeOffset","paragraph_zero_based":20198},{"literal_text_all_w_t_and_m_t":"Indicates the RSSI measurement timing configuration (RMTC) subframe offset for this frequency (see TS 38.215 [9], clause 5.1.21). For inter-frequency measurements, this field is optional present and if it is not configured, the UE chooses a random value as rmtc-SubframeOffset for measDurationSymbols which shall be selected to be between 0 and the configured rmtc-Periodicity with equal probability.","paragraph_zero_based":20199},{"literal_text_all_w_t_and_m_t":"tci-StateId","paragraph_zero_based":20200},{"literal_text_all_w_t_and_m_t":"Indicates the TCI state to be used for RSSI measurements. This field is only applicable for shared spectrum channel access in FR2-2. Network does not configure this if the UE does not have any serving cells in FR2-2 and in such a case, it is up to UE implementation how to determine the spatial domain filter for the inter-frequency RSSI measurement in FR2-2.","paragraph_zero_based":20201},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20202},{"literal_text_all_w_t_and_m_t":"SSB-ConfigMobility field descriptions","paragraph_zero_based":20203},{"literal_text_all_w_t_and_m_t":"cca-CellsToAddModList, cca-CellsToRemoveList","paragraph_zero_based":20204},{"literal_text_all_w_t_and_m_t":"Lists of cells to be added or removed from the list of neighbor cells that apply channel access mode procedures for operation with shared spectrum channel access in accordance with TS 37.213 [48], clause 4.4 for FR2-2.","paragraph_zero_based":20205},{"literal_text_all_w_t_and_m_t":"deriveSSB-IndexFromCell","paragraph_zero_based":20206},{"literal_text_all_w_t_and_m_t":"If this field is set to true, UE assumes SFN and frame boundary alignment across cells on the same frequency carrier as specified in TS 38.133 [14]. Hence, if the UE is configured with a serving cell for which (absoluteFrequencySSB, subcarrierSpacing) in ServingCellConfigCommon is equal to (ssbFrequency, ssbSubcarrierSpacing) in this MeasObjectNR, this field indicates whether the UE can utilize the timing of this serving cell to derive the index of SS block transmitted by neighbour cell. Otherwise, this field indicates whether the UE may use the timing of any detected cell on that target frequency to derive the SSB index of all neighbour cells on that frequency.","paragraph_zero_based":20207}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["86c3955244cf121809aa8befee10bdae82e676ed9f212854498d72f101dfebf8","fb6979f90e3a1fb4787746666ff2b62ba7f1716564554d6402cdf4b3c4a3b63f","0ca6c6927015acdfa12bc3dbf7d504f4d65397d41350f030d6aba8f24f05eeb9","1747ba8cc6782f00f42b987a20d78a6732d18fcafa68d0e1ebee4d0bf18e1502","a5f1cc5b37da57e460f1a2cfa85de1e9311f090a2258fefa529abb7006227086","707283748493d0c5a8d24a038f97645a23f88269173405290e2a3281720cd933","a9215602dd2ade71a9be4264fe409f0487a7651368537a173d86fe9d38134b83","3a97bf4c748348bb05ca8f2018c147abc5952aa87b226422c5c9ee5483e8aa34","e01b2cdfa6b76498de47a08e2abdaa216fd84693e43093350b52459c59bf8d8c","17dcaadee1b0553690c3c9c3a4159f7abd648fd5c0a98e7a6f23b58453a9e863","ea22555c23a7da94624879e07dd25bb16fcb297bca7a7ea172640be45956f16e","590986aa7f49c7b05726203b7ff3096058dfe864d9b93f41577da90d9fe8f404","27dec79e1aea77dea8fb730b405544a2a16f2ec5af5d3d33c00429ba399dd557","c3c7f12ef1ac3bb22557357f0858faf92965fc2098da6e048ea932f01ddf6ff6","4f4d3dae39b5bb4f9165a28003210f54b0c3ca5849bce950954b7ca46bbdaf2e","0514ee9ebf005bf3b357f321a1cea83a1b3cea5fdf1df540986f2082303f0346","e37612e923328ffdc69f4708319f52292f3927b292f73319aedcb494af1edd4c","96c703dda5c9b9049d327ef3b8a302415c9df65ef467cd8123d441ea4b31e19e","11d8c4a927de81c3c58c3086dbc6f7ddf5a36482284a8150dfa3dcb12c4e4639","146e3db1c55e0cf73077d842f4415e4c110c75d704dd84d4871812b8c065dd84","e2383e61141ebad1d9667498141f3c6e7c2fa87765012bce97f7e48b383a0e16","a3889ea5b6f563ceb9edb4068288ec1c51ff81da5e0f04aeff6de1ec681f0199","503106c8cd3ef54d06c4da86688821721738bdecd42554edd75bc57bc4ef02a0","57f662911ae6c5d0ae3ad28623d8845c86cf03fe6326c4ef9177cd64c2604b33"],"paragraph_range_zero_based":[20184,20207],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p20184"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"deriveSSB-IndexFromCellInter","paragraph_zero_based":20208},{"literal_text_all_w_t_and_m_t":"If this field is present, UE assumes SFN and frame boundary alignment between the reference serving cell indicated by ServCellIndex and all neighbour cells in this MeasObjectNR as specified in TS 38.133 [14]. This field also indicates that the UE can utilize the timing of the reference serving cell indicated by ServCellIndex to derive the index of SS block transmitted by all inter-frequency neighbour cells on the frequency indicated by the MeasObjectNR. When this field is included, the network should set deriveSSB-IndexFromCell to true.","paragraph_zero_based":20209},{"literal_text_all_w_t_and_m_t":"ssb-ToMeasure","paragraph_zero_based":20210},{"literal_text_all_w_t_and_m_t":"The set of SS blocks to be measured within the SMTC measurement duration. The first/leftmost bit corresponds to SS/PBCH block index 0, the second bit corresponds to SS/PBCH block index 1, and so on. Value 0 in the bitmap indicates that the corresponding SS/PBCH block is not to be measured while value 1 indicates that the corresponding SS/PBCH block is to be measured (see TS 38.215 [9]). When the field is not configured the UE measures on all SS blocks. Regardless of the value of this field, SS/PBCH blocks outside of the applicable smtc are not to be measured. See TS 38.215 [9] clause 5.1.1.","paragraph_zero_based":20211},{"literal_text_all_w_t_and_m_t":"ssb-ToMeasureAltitudeBasedList","paragraph_zero_based":20212},{"literal_text_all_w_t_and_m_t":"List of altitude-dependent ssb-ToMeasure. When the UE is within an altitude range indicated by altitudeRange, it ignores the ssb-ToMeasure (without suffix), and applies the corresponding ssb-ToMeasure-r18 if present, otherwise measures on all SS-blocks if ssb-ToMeasure-r18 is absent. When the UE is outside all the altitude ranges indicated by altitudeRange (if any), ssb-ToMeasure (without suffix) applies.","paragraph_zero_based":20213},{"literal_text_all_w_t_and_m_t":"For each altitude range, altitudeMin indicates the minimum altitude in meters, altitudeMax indicates the maximum altitude in meters relative to sea level, and if included, altitudeHyst indicates hysteresis in meters for determination of the altitude range. I.e., when altitudeHyst is configured for an altitude range, the UE considers itself to have entered the range if altitudeMin ≤ UE altitude ≤ altitudeMax and after entering the range considers itself to be in the range while (altitudeMin – altitudeHyst) ≤ UE altitude ≤ (altitudeMax + altitudeHyst). ","paragraph_zero_based":20214},{"literal_text_all_w_t_and_m_t":"For each altitudeRange, if altitudeMin is absent, value minAltitude-r18 is used and if altitudeMax is absent, value maxAltitude-r18 is used.","paragraph_zero_based":20215},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20216},{"literal_text_all_w_t_and_m_t":"SSB-PositionQCL-CellsToAddMod field descriptions","paragraph_zero_based":20217},{"literal_text_all_w_t_and_m_t":"physCellId","paragraph_zero_based":20218},{"literal_text_all_w_t_and_m_t":"Physical cell identity of a cell in the cell list.","paragraph_zero_based":20219},{"literal_text_all_w_t_and_m_t":"ssb-PositionQCL","paragraph_zero_based":20220},{"literal_text_all_w_t_and_m_t":"Indicates the QCL relation between SS/PBCH blocks for a specific cell as specified in TS 38.213 [13], clause 4.1. If provided, the cell specific value overwrites the value signalled by ssb-PositionQCL-Common.","paragraph_zero_based":20221},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20222},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":20223},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":20224},{"literal_text_all_w_t_and_m_t":"AssociatedGapCSIRS","paragraph_zero_based":20225},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R if associatedMeasGapCSIRS is configured, otherwise, it is absent.","paragraph_zero_based":20226},{"literal_text_all_w_t_and_m_t":"AssociatedGapSSB","paragraph_zero_based":20227},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R if associatedMeasGapSSB is configured, otherwise, it is absent.","paragraph_zero_based":20228},{"literal_text_all_w_t_and_m_t":"CSI-RS","paragraph_zero_based":20229},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if csi-rs-ResourceConfigMobility is configured, otherwise, it is absent.","paragraph_zero_based":20230},{"literal_text_all_w_t_and_m_t":"IntraFreqConnected","paragraph_zero_based":20231}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["d80884539e4ba8684ec2cf76dc5668fb11634ce89f3509b900b2b48eb6af0e3b","f7f8cb4dbde78871072ba6f95c2a5327dc7173e0a7c3046f8612c438cce0aa42","bb7b938d7eda72ca3eba2df5f7d206e552115f91fb0481eb4a2dbd22543ee411","c56c89398647ae534dd7b27c1b0cf2cd5e7b6398afd7b7b7c87bddce91994a64","baee236266aa381cb81bbb8c2d5da6f1124d6019c11d07dfa93d8d10693080c6","41c53adfc1eef68f8f008acee2332c577c362bc66c0a05fb87703f5b851fee41","ef41ae35abcd0f8347bfad4f3c923e408e8001e4e531d7487c34e49e00fb51cc","d4ea54f5b8bf56845bf9148482c4ff3a162ffe17550c455bc5518ac90e72f4ac","8fa42f7d5a3d61a0a2d9796d0403349995776875f360d36ddefa1a18bd995115","f7e11e3941aa2d08306f7abc2b885211f0d7ec17f6005150172794bfff2513d7","41033bbdc552a4c246b0909a758ef7dd329f626a9a68ac81775d82229114a2fe","e18164b5d93da82c5ccba200ffccec0b68549803b6b521ae0a7b5f0d370f8255","93eef1b15dddd8b0787c39cbc79be5da27f612d1246af6f0897c2415d4e0c92d","ec7228bb78d9d984e7243f1ddcae4d4b42d24ae2e0f09863f5f28097206b679e","d6dddc44b73fc076afbc1fa5ff994aa4719f1bdb699b049e1e27feb9bd376d1d","7c27f7294ebe577801b23d2562c12e5529e6146a48b39a6077bfe24d2d52eec5","cf1fef22e0e2e34edd97cb134d317a5becd78d3e505dc2ea87b8e1b401cc7b1f","dca38e61f6e58ce29530799ec756b02eacf2680d424048dd476189e2ada88f28","0490dbf1bfc0d1873ed0bb7b59ac8b320c5cba320df2d1e7dfe14e9b9a519e47","020ae180c685c5fbf53cb344b7b8e6e4ad16122d24b05c67f3ca766f4b01c4de","79dd99c147f70ac65e6c8cf4745e76461a2a31029f5bb20390f1261289443876","4e0c3541250da2c3c1e12d2fcf6fb6ad80e5fba9784545c96053d78c583c4303","6549625e0a32beb4dec14b99b3803cb484d1adc8f578132ee12150cd29a4734e","316e63a7f274695b3d606a78c49caff7a7ad324057d1aeea91ecc7b369c374f7"],"paragraph_range_zero_based":[20208,20231],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p20208"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R if the UE is configured with a serving cell for which (absoluteFrequencySSB, subcarrierSpacing) in ServingCellConfigCommon is equal to (ssbFrequency, ssbSubcarrierSpacing) in this MeasObjectNR, otherwise, it is absent.","paragraph_zero_based":20232},{"literal_text_all_w_t_and_m_t":"SCG","paragraph_zero_based":20233},{"literal_text_all_w_t_and_m_t":"This field is optionallly present, Need R, in the measConfig associated with the SCG. It is absent in the measConfig associated with the MCG.","paragraph_zero_based":20234},{"literal_text_all_w_t_and_m_t":"SharedSpectrum","paragraph_zero_based":20235},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if this MeasObject is for a frequency which operates with shared spectrum channel access in FR1. Otherwise, it is absent, Need R.","paragraph_zero_based":20236},{"literal_text_all_w_t_and_m_t":"SharedSpectrum2","paragraph_zero_based":20237},{"literal_text_all_w_t_and_m_t":"This field is optionally present if this MeasObject is for a frequency which operates with shared spectrum channel access in FR2-2, Need R. Otherwise, it is absent, Need R.","paragraph_zero_based":20238},{"literal_text_all_w_t_and_m_t":"SSBorAssociatedSSB","paragraph_zero_based":20239},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if ssb-ConfigMobility is configured or associatedSSB is configured in at least one cell. Otherwise, it is absent, Need R.","paragraph_zero_based":20240},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20241},{"literal_text_all_w_t_and_m_t":"–MeasObjectNR-SL","paragraph_zero_based":20242},{"literal_text_all_w_t_and_m_t":"The IE MeasObjectNR-SL concerns a measurement object including a list of transmission resource pool(s) for which CBR measurement is performed for NR sidelink communication/discovery.","paragraph_zero_based":20243},{"literal_text_all_w_t_and_m_t":"MeasObjectNR-SL information element","paragraph_zero_based":20244},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":20245},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASOBJECTNR-SL-START","paragraph_zero_based":20246},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20247},{"literal_text_all_w_t_and_m_t":"MeasObjectNR-SL-r16 ::=      SEQUENCE {","paragraph_zero_based":20248},{"literal_text_all_w_t_and_m_t":"    tx-PoolMeasToRemoveList-r16  Tx-PoolMeasList-r16                           OPTIONAL,       -- Need N","paragraph_zero_based":20249},{"literal_text_all_w_t_and_m_t":"    tx-PoolMeasToAddModList-r16  Tx-PoolMeasList-r16                           OPTIONAL        -- Need N","paragraph_zero_based":20250},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":20251},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20252},{"literal_text_all_w_t_and_m_t":"Tx-PoolMeasList-r16 ::= SEQUENCE (SIZE (1..maxNrofSL-PoolToMeasureNR-r16)) OF SL-ResourcePoolID-r16","paragraph_zero_based":20253},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20254},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASOBJECTNR-SL-STOP","paragraph_zero_based":20255}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["ebaad764a9f0a72b0de3a1da90bf22873f15a1c3048979d464df1dbda65460ee","90ecc3fcafb74777d2ae735defaf1286687bc4465036a937bcfddd08b66f0490","8e2e765f13a8cb15e50d71dcb9c6d3ab969cb24c790a7160075cf81841947e5b","805719c6c99b023d283108a6b4cc1ca3e5105e56e6166dbebe11e2ee861965a9","7b254280145e88f2bb1249c28960f775c6cf5982806c103316fbdd50930f49b1","0cffc26