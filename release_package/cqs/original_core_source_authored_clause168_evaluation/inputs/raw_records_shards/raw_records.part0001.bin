e48571f8288c5afd07c1922cdaacb55a5e2990d1f2071096cf725bf1b02","3df3f5f0f6aac9d95ac71610d90a5292df159aaadc73f663e1f45f3559c3a456","51a57cddb40332fa001a7cb989fddbd873756716c5243f741af177ff7842eb05","a78a31661da1e10bbaf8a3547aa255e5ebb39fdbc6fe3e374c2783049f35b996","4394954aaaf15b3c9e6c9b10f89b9ffae5a5e5a39b6ab05f7b781461517f60a0","22ae4a7e6aa964ab0090b979c0be543e0263f91033f2be97fd69f893e671936a","5e429ebc33e7db45cacbed85b2043c285585e0514ea87a72392a9d86bf4ac970","90200ac3cb674fde5da1a4e54f3bcd6279f84eb349f86020b76b2514c240633b","9132dcc5863f4d318bfc5adc41247e4a062fbf34f77660e613e581836ec244ef","9f151d0b262ab5351fba71420f77893e4d0478ae329b01212ad105287e401350","65817715cdd7b76c35410eb0bccca994ab98b3dc0513f7d935bf155e3a8c6ceb","7b470cfa13b5afdffe1515e98384018bc5cc7afafefa44ee7a713408b2a9b2bb"],"paragraph_range_zero_based":[23112,23135],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p23112"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":23136},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23137},{"literal_text_all_w_t_and_m_t":"-- TAG-PTRS-DOWNLINKCONFIG-STOP","paragraph_zero_based":23138},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23139},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23140},{"literal_text_all_w_t_and_m_t":"PTRS-DownlinkConfig field descriptions","paragraph_zero_based":23141},{"literal_text_all_w_t_and_m_t":"epre-Ratio","paragraph_zero_based":23142},{"literal_text_all_w_t_and_m_t":"EPRE ratio between PTRS and PDSCH. Value 0 corresponds to the codepoint \"00\" in table 4.1-2. Value 1 corresponds to codepoint \"01\", and so on. If the field is not provided, the UE applies value 0 (see TS 38.214 [19], clause 4.1).","paragraph_zero_based":23143},{"literal_text_all_w_t_and_m_t":"frequencyDensity","paragraph_zero_based":23144},{"literal_text_all_w_t_and_m_t":"Presence and frequency density of DL PT-RS as a function of Scheduled BW. If the field is absent, the UE uses K_PT-RS = 2 (see TS 38.214 [19], clause 5.1.6.3, table 5.1.6.3-2).","paragraph_zero_based":23145},{"literal_text_all_w_t_and_m_t":"maxNrofPorts","paragraph_zero_based":23146},{"literal_text_all_w_t_and_m_t":"The maximum number of DL PTRS ports specified in TS 38.214 [19] (clause 5.1.6.3). 2 PT-RS ports can only be configured for a DL BWP that is configured, as specified in TS 38.214 [19] clause 5.1, with a mode where a single PDSCH has association between the DM-RS ports and the TCI states as defined in TS 38.214 [19] clause 5.1.6.2.","paragraph_zero_based":23147},{"literal_text_all_w_t_and_m_t":"resourceElementOffset","paragraph_zero_based":23148},{"literal_text_all_w_t_and_m_t":"Indicates the subcarrier offset for DL PTRS. If the field is absent, the UE applies the value offset00 (see TS 38.211 [16], clause 7.4.1.2.2).","paragraph_zero_based":23149},{"literal_text_all_w_t_and_m_t":"timeDensity","paragraph_zero_based":23150},{"literal_text_all_w_t_and_m_t":"Presence and time density of DL PT-RS as a function of MCS. The value 29 is only applicable for MCS Table 5.1.3.1-1 (TS 38.214 [19]). If the field is absent, the UE uses L_PT-RS = 1 (see TS 38.214 [19], clause 5.1.6.3, table 5.1.6.3-1).","paragraph_zero_based":23151},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23152},{"literal_text_all_w_t_and_m_t":"–PTRS-UplinkConfig","paragraph_zero_based":23153},{"literal_text_all_w_t_and_m_t":"The IE PTRS-UplinkConfig is used to configure uplink Phase-Tracking-Reference-Signals (PTRS).","paragraph_zero_based":23154},{"literal_text_all_w_t_and_m_t":"PTRS-UplinkConfig information element","paragraph_zero_based":23155},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":23156},{"literal_text_all_w_t_and_m_t":"-- TAG-PTRS-UPLINKCONFIG-START","paragraph_zero_based":23157},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23158},{"literal_text_all_w_t_and_m_t":"PTRS-UplinkConfig ::=                   SEQUENCE {","paragraph_zero_based":23159}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["b87418b12fda54ff4e87574095ca6839150e7a4ad07bf5b8242b527387ff92eb","7975e8d6d786aec33e3b018c5c0156fcbdfc983710697d406a5e2a0f7935cb08","13b4a4e94c3bfbc19707f7dbeafe5ec08622523af8838df1949a2d98d1ee9350","affdbd491e7b2ae47da13fb02af4fd8eee0cfa9405611de20da93440d4afb45e","6dabe15f7580cb91998f583a95eaf4d7c62a9316b086e359b5641aca080c02bf","728ae9408b913cf1aa19f518428acc29546432605092d1fae52858d6a3f36b75","7914