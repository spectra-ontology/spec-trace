{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39552},{"literal_text_all_w_t_and_m_t":"–SL-ServingCellInfo","paragraph_zero_based":39553},{"literal_text_all_w_t_and_m_t":"The IE SL-ServingCellInfo is used to indicate the L2 U2N Relay UE's PCell/camping cell, which is considered as PCell/camping cell by the L2 U2N Remote UEs connecting with this L2 U2N Relay UE.","paragraph_zero_based":39554},{"literal_text_all_w_t_and_m_t":"SL-ServingCellInfo information element","paragraph_zero_based":39555},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39556},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SERVINGCELLINFO-START","paragraph_zero_based":39557},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39558},{"literal_text_all_w_t_and_m_t":"SL-ServingCellInfo-r17 ::=     SEQUENCE {","paragraph_zero_based":39559},{"literal_text_all_w_t_and_m_t":"    sl-PhysCellId-r17              PhysCellId,","paragraph_zero_based":39560},{"literal_text_all_w_t_and_m_t":"    sl-CarrierFreqNR-r17           ARFCN-ValueNR","paragraph_zero_based":39561},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39562},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39563},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SERVINGCELLINFO-STOP","paragraph_zero_based":39564},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39565},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39566},{"literal_text_all_w_t_and_m_t":"SL-ServingCellInfo field descriptions","paragraph_zero_based":39567},{"literal_text_all_w_t_and_m_t":"sl-CarrierFreqNR","paragraph_zero_based":39568},{"literal_text_all_w_t_and_m_t":"Indicates the DL frequency of the cell indicated by sl-PhysCellId.","paragraph_zero_based":39569},{"literal_text_all_w_t_and_m_t":"sl-PhysCellId","paragraph_zero_based":39570},{"literal_text_all_w_t_and_m_t":"Indicates the PCI of the PCell.","paragraph_zero_based":39571},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39572},{"literal_text_all_w_t_and_m_t":"–SL-SourceIdentity","paragraph_zero_based":39573},{"literal_text_all_w_t_and_m_t":"The IE SL-SourceIdentity is used to identify a source of a NR sidelink communication.","paragraph_zero_based":39574},{"literal_text_all_w_t_and_m_t":"SL-SourceIdentity information element","paragraph_zero_based":39575}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["ebb591880d0b8664406370135236e814ae727223d281fcfcd3eba1ccdc676ce4","effba8a59131551dabe43b4ae86ebc90dc4674cef66c9a43b89c72b57f1b4641","9997e1a7a890b011eee3b5808fa9510eedf274ffa336ba2809f61615de4926c5","b2defc242d4ac0f8a71ddc2cc38d40d13dd38daa6d08b324e59739b471e0803d","290a76bdba0706c69caa01540e9fd9d62f74434de0714551fd51bf342b117b16","51e5c4175ba206dad9ad95bfa45932ff1e0d7010a79b5471961846b1d0e6b8bf","7a51ca1579773d0e88c080cb4cb4aa0cb3574456e2c518d37635173e879af177","e2e67f3bbf4d1e839cfa62c2fc29084bb3e61ab33652dd387c3e598448748ce2","789356310619e1af2b8fc82fd03540a94cd284e9aa9dff0ec1807d4ecf229912","d24d4970a20bee635215826023e7d03eb842a1427bc730668fab9afb454a7eec","189b5d1e1d4c827a0ab692169bca837e907446fb3c656094330ab0d20509e50f","690a2da4cc32181bf7c403ee4ac8987834caef2cf3babd56af43b35c7ebfc102","c4748d079c5faf308f6ee0d23bcde4389af4c5f0bd341f44b8e8acfb6bf9df36","2509a549bbb625297fb0f41cc9796c3dba015324e23c173ad6e9eef83802539d","1d676a0ab7b59c93399bca381da379628a8192b86c82e38da47bd0cd494cc5e2","a01c991324d2594abb71f9afccb40b1446d1592f9bbee029fd6fcccf3d605bce","03497d4fbc62d73a5332a4f0ca04656763a376c06d357abce9480c04f03db979","ecb7f7a11e861e