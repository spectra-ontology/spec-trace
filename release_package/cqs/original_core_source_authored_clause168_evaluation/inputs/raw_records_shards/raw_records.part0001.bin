d from the peer UE for the corresponding NR sidelink unicast communication.","paragraph_zero_based":41008},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41009},{"literal_text_all_w_t_and_m_t":"–RRCReconfigurationFailureSidelink","paragraph_zero_based":41010},{"literal_text_all_w_t_and_m_t":"The RRCReconfigurationFailureSidelink message is used to indicate the failure of a PC5 RRC AS reconfiguration. It is only applied to unicast of NR sidelink communication.","paragraph_zero_based":41011},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SL-SRB3","paragraph_zero_based":41012},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":41013},{"literal_text_all_w_t_and_m_t":"Logical channel: SCCH","paragraph_zero_based":41014},{"literal_text_all_w_t_and_m_t":"Direction: UE to UE","paragraph_zero_based":41015}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["b5a58d2c1dfee443b9c52198d6b4c414aa809391dcde2a27784182af93ea0541","51230baaba4354f8a084e6c887b475b292d1eae07e100c8e36c8ef49d9db1d54","4838577df6910bdf948dcc13de6f582c59518e07f2277173bd70745878fcea32","b959206b27f2af3ccb880bc904bc7d5bbadb4813c32b21749e86dfa603cf6b59","21f959f783a48f4ba4d821124c1524cb2616631a2a71dd68e3eed8f5529f60ca","b9707ddb2a30fc4d808bb7472ea499aa02cb615b0f5372b60e3d756a28e43658","f634156a2daf0b6475fde6fd57349636f956d7d6f2ec1c5aec5fdba3e174ea12","af1aba4108a1dc947458ea853d36a0a3af07e71a0f86f0d1bcb1e7332e2426d5","2d9a72fed8a230d98bc88bbd49c8f796d605bfef2bc39d270ef036712ed9a431","db939ecdaa2d260e4a6c9d2f370df2c943e3134a38c98b2c964903a2d371488b","6d1056be131cc37fac89367c9ef9d4b32b1e3e181f3354cafd3f20d8dec2222d","ed1107f23178054808353d3240bc61f78673c939ea80d666b33e34139c8f