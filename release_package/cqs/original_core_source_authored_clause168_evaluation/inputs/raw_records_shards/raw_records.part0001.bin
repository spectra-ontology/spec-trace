{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"dmrs-ScramblingID0","paragraph_zero_based":39672},{"literal_text_all_w_t_and_m_t":"DL DMRS scrambling initialization (see TS 38.211 [16], clause 7.4.1.1.1). When the field is absent the UE applies the value physCellId configured for this serving cell.","paragraph_zero_based":39673},{"literal_text_all_w_t_and_m_t":"pdsch-AggregationFactor","paragraph_zero_based":39674},{"literal_text_all_w_t_and_m_t":"Number of repetitions for dynamic scheduling of MBS broadcast data for MTCH PDSCH (see TS 38.214 [19], clause 5.1.2.1). When the field is absent the UE applies the value 1.","paragraph_zero_based":39675},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39676},{"literal_text_all_w_t_and_m_t":"–TMGI","paragraph_zero_based":39677},{"literal_text_all_w_t_and_m_t":"The IE TMGI is used to identify the MBS session.","paragraph_zero_based":39678},{"literal_text_all_w_t_and_m_t":"TMGI information element","paragraph_zero_based":39679},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39680},{"literal_text_all_w_t_and_m_t":"-- TAG-TMGI-START","paragraph_zero_based":39681},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39682},{"literal_text_all_w_t_and_m_t":"TMGI-r17 ::=                     SEQUENCE {","paragraph_zero_based":39683},{"literal_text_all_w_t_and_m_t":"    plmn-Id-r17                      CHOICE {","paragraph_zero_based":39684},{"literal_text_all_w_t_and_m_t":"        plmn-Index                       INTEGER (1..maxPLMN),","paragraph_zero_based":39685},{"literal_text_all_w_t_and_m_t":"        explicitValue                    PLMN-Identity","paragraph_zero_based":39686},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":39687},{"literal_text_all_w_t_and_m_t":"    serviceId-r17                    OCTET STRING (SIZE (3))","paragraph_zero_based":39688},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39689},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39690},{"literal_text_all_w_t_and_m_t":"-- TAG-TMGI-STOP","paragraph_zero_based":39691},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39692},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39693},{"literal_text_all_w_t_and_m_t":"TMGI field descriptions","paragraph_zero_based":39694},{"literal_text_all_w_t_and_m_t":"plmn-Index","paragraph_zero_based":39695}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["f0ae503e992fb94053680a7f301d56c9a4afbe8f1aca206cb542557bb1cbf194","d31139d5f79d02ca0b6000fca34596e61c1fffaf368d2acc81ff3dc21854942d","7af0c4cf179134bce4eee4e64001615ed909694031b57aeee0a912be814c1101","940a3762e6a2ec6c20d8c6a691f384a4b71209a33184edeed79d82cf477aebc5","309597d051a205429ca7ab0888417636f76b534dcbaecf6b5c2ee0f401bd7c7a","6c917d94ff74529a003fa5725cede1bb0e15e0b9d02b7d4170c18c2e6f85035b","684c01d0ff9eaa1bc686a5ac4bcec3cca02fd84da4ac88b2159f4be699d7ab36","4e0ba08a0d3e51cfe99869ff3a60c3f568f30cccc3e43a155ca7ff1629e3e433","4fa697911f28f601e04092a11e826c5c02ec9694bb982e25d01c46041ade2527","2e9422c701db5e4db28321de3d049a95213ed494fa823016e58e97c91df84869","6563f40b55d9c3a4527d743aaceaef0307555b08d29832845cd00430aba3d778","fd2a7f1ee6a595985efe121b8cba6a0dbe6870179a24e868c3af40ae1115cdfa","3648803275579b1c5f63bf426c8c6592ce9756e80027112932ba15af6abf8ea5","8f3f5768e336ad678d68a5597ee73f4cc1fe7053e22c2d0c01739105fdfe1026","1464d5e83bf42e2f6557b95b06e521d648a7dd70897d7fc570a9b69faf503967","44baf5ffec4714a2c5400a3f61c6dbb8b13733cab0c2ac845fc7e323b1a4c15b","9ffb9b108d5f3d9eec48bc7eae9fea2cca716ef5af74af6cf889963754546e6e","b5a744c5b1cc9c9c3af6b17e53e4e9d1fb64951a097463f11b9390400822d3d6","44b5c9ff94217699a2083671adb06587e5cc1684e287c938ba783e9b58639200","641c57102891587af1bcbb855964e6d013f2bfaf08bea2e91341b875386a667f","a6c4b62735e27548076e1cf7e614bff1f41b34d38d55ea74e9ff1ad9e9aad603","4a01bf23d27ed8b4a3faafbeb4a59c112f78db73c4050a8fa75b28fd14f8f8ff","0f59ff08fc01c9805af8ccf1e7337efe305eabe3b1609c91f469fc0262736078","2946822226e1a705263337bbec536178df99cebbdcacc9c3124821ef23a1f48b"],"paragraph_range_zero_based":[39672,39695],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p39672"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"PLMN index or NPN index according to the plmn-IdentityInfoList and npn-IdentityInfoList fields included in SIB1. If this field is included in the MRB-ToAddMod-r17, the UE translates the plmn-Index into the PLMN Identity or SNPN Identity based on the configuration in SIB1 (which is the SIB1 of the target cell in case of handover). The explicitValue is not used for MBS service(s) of an SNPN.","paragraph_zero_based":39696},{"literal_text_all_w_t_and_m_t":"serviceId","paragraph_zero_based":39697},{"literal_text_all_w_t_and_m_t":"Uniquely identifies the identity of an MBS service within a PLMN. The field contains octet 3- 5 of the IE Temporary Mobile Group Identity (TMGI) as defined in TS 24.008 [38]. The first octet contains the third octet of the TMGI, the second octet contains the fourth octet of the TMGI and so on.","paragraph_zero_based":39698},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39699},{"literal_text_all_w_t_and_m_t":"6.4RRC multiplicity and type constraint values","paragraph_zero_based":39700},{"literal_text_all_w_t_and_m_t":"–Multiplicity and type constraint definitions","paragraph_zero_based":39701},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39702},{"literal_text_all_w_t_and_m_t":"-- TAG-MULTIPLICITY-AND-TYPE-CONSTRAINT-DEFINITIONS-START","paragraph_zero_based":39703},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39704},{"literal_text_all_w_t_and_m_t":"maxAdditionalRACH-r17                   INTEGER ::= 256     -- Maximum number of additional RACH configurations.","paragraph_zero_based":39705},{"literal_text_all_w_t_and_m_t":"maxAI-DCI-PayloadSize-r16               INTEGER ::= 128      --Maximum size of the DCI payload scrambled with ai-RNTI","paragraph_zero_based":39706},{"literal_text_all_w_t_and_m_t":"maxAI-DCI-PayloadSize-1-r16             INTEGER ::= 127      --Maximum size of the DCI payload scrambled with ai-RNTI minus 1","paragraph_zero_based":39707},{"literal_text_all_w_t_and_m_t":"maxBandComb                             INTEGER ::= 65536   -- Maximum number of DL band combinations","paragraph_zero_based":39708},{"literal_text_all_w_t_and_m_t":"maxBandsUTRA-FDD-r16                    INTEGER ::= 64      -- Maximum number of bands listed in UTRA-FDD UE caps","paragraph_zero_based":39709},{"literal_text_all_w_t_and_m_t":"maxBH-RLC-ChannelID-r16                 INTEGER ::= 65536   -- Maximum value of BH RLC Channel ID","paragraph_zero_based":39710},{"literal_text_all_w_t_and_m_t":"maxBT-IdReport-r16                      INTEGER ::= 32      -- Maximum number of Bluetooth IDs to report","paragraph_zero_based":39711},{"literal_text_all_w_t_and_m_t":"maxBT-Name-r16                          INTEGER ::= 4       -- Maximum number of Bluetooth name","paragraph_zero_based":39712},{"literal_text_all_w_t_and_m_t":"maxCAG-Cell-r16                         INTEGER ::= 16      -- Maximum number of NR CAG cell ranges in SIB3, SIB4","paragraph_zero_based":39713},{"literal_text_all_w_t_and_m_t":"maxTwoPUCCH-Grp-ConfigList-r16          INTEGER ::= 32      -- Maximum number of supported configuration(s) of {primary PUCCH group","paragraph_zero_based":39714},{"literal_text_all_w_t_and_m_t":"                                                            -- config, secondary PUCCH group config}","paragraph_zero_based":39715},{"literal_text_all_w_t_and_m_t":"maxTwoPUCCH-Grp-ConfigList-r17          INTEGER ::= 16      -- Maximum number of supported configuration(s) of {primary PUCCH group","paragraph_zero_based":39716},{"literal_text_all_w_t_and_m_t":"                                                            -- config, secondary PUCCH group config} for PUCCH cell switching","paragraph_zero_based":39717},{"literal_text_all_w_t_and_m_t":"maxCBR-Config-r16                       INTEGER ::= 8       -- Maximum number of CBR range configurations for sidelink communication","paragraph_zero_based":39718},{"literal_text_all_w_t_and_m_t":"                                                            -- congestion control","paragraph_zero_based":39719}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["0d991ec5164bc6d50ca9add0aaad57bc69208fc47f048e25513ad47447f85d07","5ed7190a3edb467c40b145f90c28280fe18bac445e222562effadf9fd0bf2edb","7e04d996c0cd729bc57d0c03f4a166ce58e9c0d43b2d0ae3e2935ee881d94835","cb646dc48655f0416f7634ca0627d54b476cc849db41f0041dd5e95eeb90c4a8","251c4432b300900f45c6deeff27e8a3a2658b7554de63aaa8056c679965beb4d","4ca9c99baefc6a89b10473b4d28574d24309f26b5f1a48978a2ee74d9ab424e3","61937313f41a62fde1e676e095858b25d5ce1b424ae14a6c5b990c3517d7a7b0","a95f3a093dab225d9910f5339e2e39c1e90554746b89f84bce82226763f756c5","0a328301112e3b505059ec4ae47a6c0f9c75e5ebaaeec8d5cc15f96449345043","fd3b9206790cb44de731f84da87be45efd66f75c7db2085c6dd1e648c569d80d","cfb05217a161c0a2916a6fc1ad45b5cb1991d681b5eb925f4dd22af682b591d5","6b8b99a9687dba632a3f855fe5ae47e632e7afa68cd5a8955c191566ad29f841","3a4426a215885643359fba83601800e8494e578c0f45d10a969193fa25b12313","44cd15e47693041066be997d8f99d4dd22b18bcba40e5e6ab969e8effeea5eff","3b8a81674ac7b26d70ed4b0057e6ac4ea56d96a12d9f069c437653ef96ceae8c","5f5a281bafada57f2708788537f49e903a600466e66e6fc0b8a086f6d8be314c","df7185a47856985669f3ee8d7cf1a4b77aa39f166e7ff5dba6488a9c24c27e2b","a5340fec5fd7efdd114c41e2e1e8aedd45e322a2db29235efb6a4ad2f93f16bb","fb61573e25d0d5d150a2e598bde56697acea747cdc34e04862632b8728f97193","583125de52fb4bb1464ff83ae2574ecb1076ab51c585bdf4052d120b56ccd471","93d9a9463aa1f301e0544e5929a472eed94dcf8567a