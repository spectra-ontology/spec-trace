{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"FeatureCombination information element","paragraph_zero_based":18480},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18481},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURECOMBINATION-START","paragraph_zero_based":18482},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18483},{"literal_text_all_w_t_and_m_t":"FeatureCombination-r17 ::= SEQUENCE {","paragraph_zero_based":18484},{"literal_text_all_w_t_and_m_t":"    redCap-r17                 ENUMERATED {true}                                    OPTIONAL,  -- Need R","paragraph_zero_based":18485},{"literal_text_all_w_t_and_m_t":"    smallData-r17              ENUMERATED {true}                                    OPTIONAL,  -- Need R","paragraph_zero_based":18486},{"literal_text_all_w_t_and_m_t":"    nsag-r17                   NSAG-List-r17                                        OPTIONAL,  -- Need R","paragraph_zero_based":18487},{"literal_text_all_w_t_and_m_t":"    msg3-Repetitions-r17       ENUMERATED {true}                                    OPTIONAL,  -- Need R","paragraph_zero_based":18488},{"literal_text_all_w_t_and_m_t":"    spare4                     ENUMERATED {true}                                    OPTIONAL,  -- Need R","paragraph_zero_based":18489},{"literal_text_all_w_t_and_m_t":"    spare3                     ENUMERATED {true}                                    OPTIONAL,  -- Need R","paragraph_zero_based":18490},{"literal_text_all_w_t_and_m_t":"    spare2                     ENUMERATED {true}                                    OPTIONAL,  -- Need R","paragraph_zero_based":18491},{"literal_text_all_w_t_and_m_t":"    spare1                     ENUMERATED {true}                                    OPTIONAL   -- Need R","paragraph_zero_based":18492},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18493},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18494},{"literal_text_all_w_t_and_m_t":"NSAG-List-r17 ::= SEQUENCE (SIZE (1.. maxSliceInfo-r17)) OF NSAG-ID-r17","paragraph_zero_based":18495},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18496},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURECOMBINATION-STOP","paragraph_zero_based":18497},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18498},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18499},{"literal_text_all_w_t_and_m_t":"FeatureCombination field descriptions","paragraph_zero_based":18500},{"literal_text_all_w_t_and_m_t":"redCap","paragraph_zero_based":18501},{"literal_text_all_w_t_and_m_t":"If present, this field indicates that RedCap is part of this feature combination.","paragraph_zero_based":18502},{"literal_text_all_w_t_and_m_t":"smallData","paragraph_zero_based":18503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["b80d1c9177708cf6cec2a0c8dd8266b0345dd272b8312781321218d6c3bf92b9","1217a70a9055d130a21ea645908ed5b2c682e7522dc41d509bec3148a1f4cc3f","c432af4f6cea9169080a627b006082610d026753f9e8034a800b1cdffca3f498","5789ad6ba951fea0ac064cf189e67503066dc8e3349c7b85d891e6f06368c1d4","4c608a884def77aa61292c50c0e14ce19d0fbaa3ac63b5077643f011bc56aa18","2fd18e2c4fc85f336066d91d6d0c7e6bd0a9071e1670ccc0fd18fcf8176874ef","fc7a3077b816e568435c2570ed9fc58ef5068a3a15411196a73da27211815fc7","ab90e360d0d595a8f5a1f29f689cebc84117ad1dd9a6d9cc2f5ecc54d2b33eba","d53e9fa9222ee46fcfd642e3d049b3f46942d4c5c71d797bd639f35d3b0203ab","c4d41b4dc4fc05793c59eaac9375fd89603c697d24aa05cb2f7af7c755a73fbc","64727cbb49f171d7cda635ae46b6f97430ee524c9f09161e8f2804cd16e19dcd","60ba706612aefdabf5b0edd2823209d5b1f1fbaf3bf9c1fea0e34a7d9aeed68d","f987ea923cf0a9eb8bfa8f7637e1a58af03cf89077de21b0e06acd24caa3e5ee","6b86a873866f1eac0a98d8ab0e478f2f74a1c9df24ec20334fd9891d8b639d1d","4eeeea31916919369751ee3c5cf2ac09551bcb00c61204b0751944ad164824cb","96c0a3db896e823acb55b3a3c502e8a477e204c8a6ee82bc0af5d93eeb742c80","ab1737cc984e1cb5ed4ff8eb5a4280d64fe83ab2f96116120308d66e76c4bb14","815a9abd752351f5d1479de4206eb07e6e8e88b96802b602daa67dbf2a11ad45","732b4a33934f2bfc829f7ef1aa93cdbfa6a61ef5eff916eb95509ccc35b43a01","bd8a4a4903a81fd0b76bac63abea91497f9fb0cfb9675ce5884d81a61dbd98b3","100e300886eb93844c4d0a4472827619982f328fcd3f79964c13ec4b88d60b53","28eb37aa3213d72cdfa12994cb777971498b998a22d9a5f99097f6bc4a9246b3","5f61506617aab1cb2db33680b6cc3846338ee49c6a56124f638bdf82cbd8c342","5782cd1ef10b95e1e9c1f8bde7dc4466bf3e44fabe7f0e0df2a88926e96c564a"],"paragraph_range_zero_based":[18480,18503],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p18480"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"If present, this field indicates that Small Data is part of this feature combination.","paragraph_zero_based":18504},{"literal_text_all_w_t_and_m_t":"nsag","paragraph_zero_based":18505},{"literal_text_all_w_t_and_m_t":"If present, this field indicates NSAG(s) that are part of this feature combination.","paragraph_zero_based":18506},{"literal_text_all_w_t_and_m_t":"msg3-Repetitions","paragraph_zero_based":18507},{"literal_text_all_w_t_and_m_t":"If present, this field indicates that signalling of msg3 repetition is part of this feature combination. This field is not configured in a set of preambles that is configured with 2-step random-access type.","paragraph_zero_based":18508},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18509},{"literal_text_all_w_t_and_m_t":"–FeatureCombinationPreambles","paragraph_zero_based":18510},{"literal_text_all_w_t_and_m_t":"The IE FeatureCombinationPreambles associates a set of preambles with a feature combination. For parameters which can be provided in this IE, the UE applies this field value when performing Random Access using a preamble in this featureCombinationPreambles, otherwise the UE applies the corresponding value as determined by applicable Need Code, e.g. Need S. On a specific BWP, there can be at most one set of preambles associated with a given feature combination per RA Type (i.e. 4-step RACH or 2-step RACH).","paragraph_zero_based":18511},{"literal_text_all_w_t_and_m_t":"FeatureCombinationPreambles information element","paragraph_zero_based":18512},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18513},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURECOMBINATIONPREAMBLES-START","paragraph_zero_based":18514},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18515},{"literal_text_all_w_t_and_m_t":"FeatureCombinationPreambles-r17 ::=   SEQUENCE {","paragraph_zero_based":18516},{"literal_text_all_w_t_and_m_t":"    featureCombination-r17                FeatureCombination-r17,","paragraph_zero_based":18517},{"literal_text_all_w_t_and_m_t":"    startPreambleForThisPartition-r17     INTEGER (0..63),","paragraph_zero_based":18518},{"literal_text_all_w_t_and_m_t":"    numberOfPreamblesPerSSB-ForThisPartition-r17 INTEGER (1..64),","paragraph_zero_based":18519},{"literal_text_all_w_t_and_m_t":"    ssb-SharedRO-MaskIndex-r17            INTEGER (1..15)                                           OPTIONAL, -- Need S","paragraph_zero_based":18520},{"literal_text_all_w_t_and_m_t":"    groupBconfigured-r17                  SEQUENCE {","paragraph_zero_based":18521},{"literal_text_all_w_t_and_m_t":"        ra-SizeGroupA-r17                     ENUMERATED {b56, b144, b208, b256, b282, b480, b640,","paragraph_zero_based":18522},{"literal_text_all_w_t_and_m_t":"                                                        b800, b1000, b72, spare6, spare5,spare4, spare3, spare2, spare1},","paragraph_zero_based":18523},{"literal_text_all_w_t_and_m_t":"        messagePowerOffsetGroupB-r17          ENUMERATED { minusinfinity, dB0, dB5, dB8, dB10, dB12, dB15, dB18},","paragraph_zero_based":18524},{"literal_text_all_w_t_and_m_t":"        numberOfRA-PreamblesGroupA-r17        INTEGER (1..64)","paragraph_zero_based":18525},{"literal_text_all_w_t_and_m_t":"    }                                                                                               OPTIONAL, -- Need R","paragraph_zero_based":18526},{"literal_text_all_w_t_and_m_t":"    separateMsgA-PUSCH-Config-r17         MsgA-PUSCH-Config-r16                                     OPTIONAL, -- Cond MsgAConfigCommon","paragraph_zero_based":18527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["b40b679a6403fa6e20bcefa3deb5e8298999e892f379613d17053d9f1918bd10","ba526ce5323ed9fd39dc9f02ead0b9267036a36aceebc9b52659e25f0b3597da","ba4996dc9cf3952b11afc3bda05646a505b4c2eec6a4a44ecf37639c1cd144a3","bbd364b496308889abcb290610f792e4cba5d7373f1fa1907481dc88150fee08","e891d916ebfc8d985be9f1c334b773fe27e4e789acf4fe7d0c424b3b536556f8","6c6280fa186d06e0b12406585603e0f1845a406a15129cfd35b5395781b49d73","310a491b90bc823bcf42e6c0c7d03e22bf84f80ec38613f9b9ac34fe0af5d8c9","83a5a561f38a0fa62775d828e46b4f0e08ab9f983584ffeee8ab9e65ea34f791","271c4927b9861b3b44bb5239c8fa762510e7ebf96f22f4b325f8c59d92725a3c","c094b00d3d93b1ca4063b8d06a60d1c08d2dfa2dd9abb3f6cb7e63a669ee26a1","ee7a3b8eb027042673b8edb16ba8f9f58b6a9db570f0b95958090616bb272f5c","350e1ec7d91557e44ffb6fb23ecedb82febbef47f91f676cef07f8e2002cfdb0","2d32490e529932da807016518963f8de9786fd5d31c0dddb6d34fa2510ed8b2d","a6ba6d1a4328edaee539786cfd708b700980f7f510741a1f36758036533a4f48","0e5d4c7cc14b3ad31ddd9e491a4a1c2b4574b8642d0eab8e089a40802cfef2fc","ca853613fa3274a0699f94209befafefe78300c0caf961a15e63bd805589b43d","c2072feb45150eee82ccbef27eb6cf5acaf08bed4f7177b667013fde7da70e25","99896cb4dfd897dc58630fbc2d80c6477c2cba078d40a4ab7b6942b4aa8c0844","5d9f52351a3b1046bd6ba496a846e5f7f7d18af3099d29e09a333a5f2022db2c","af1dd2a102234f77257ca682cda859b844ad149e34ec9ab595d54fee2a7df162","5c2b74b8da5fc3b5cf31c3a73d0d09a6641aab0982d5a0aeffd1ebc7aa3394d6","c8becdb0d962928adb492fb489b4bc7c3f0ca7ac433d3672d0e7f7a8dac656e9","70579fb3c3bc3898a4921e8e67d764e8b275811833915dbc1fd85e0b38de955e","cb08e6a25252e03ef39ed120193131eb177f76f69fe51a143902996307ed05fe"],"paragraph_range_zero_based":[18504,18527],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p18504"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    msgA-RSRP-Threshold-r17               RSRP-Range                                                OPTIONAL, -- Need R","paragraph_zero_based":18528},{"literal_text_all_w_t_and_m_t":"    rsrp-ThresholdSSB-r17                 RSRP-Range                                                OPTIONAL, -- Need R","paragraph_zero_based":18529},{"literal_text_all_w_t_and_m_t":"    deltaPreamble-r17                     INTEGER (-1..6)                                           OPTIONAL, -- Need R","paragraph_zero_based":18530},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":18531},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18532},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18533},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURECOMBINATIONPREAMBLES-STOP","paragraph_zero_based":18534},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18535},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18536},{"literal_text_all_w_t_and_m_t":"FeatureCombinationPreambles field descriptions","paragraph_zero_based":18537},{"literal_text_all_w_t_and_m_t":"deltaPreamble","paragraph_zero_based":18538},{"literal_text_all_w_t_and_m_t":"Power offset between msg3 or msgA-PUSCH and RACH preamble transmission. If configured, this parameter overrides msg3-DeltaPreamble or msgA-DeltaPreamble, Actual value = field value * 2 [dB] (see TS 38.213 [13], clause 7.1). If msgA-DeltaPreamble is configured in separateMsgA-PUSCH-Config-r17, this field is absent.","paragraph_zero_based":18539},{"literal_text_all_w_t_and_m_t":"featureCombination","paragraph_zero_based":18540},{"literal_text_all_w_t_and_m_t":"Indicates which combination of features that the preambles indicated by this IE are associated with. The UE ignores a RACH resource defined by this FeatureCombinationPreambles if any feature within the featureCombination is not supported by the UE or if any of the spare fields within the featureCombination is set to true.","paragraph_zero_based":18541},{"literal_text_all_w_t_and_m_t":"messagePowerOffsetGroupB","paragraph_zero_based":18542},{"literal_text_all_w_t_and_m_t":"Threshold for preamble selection. Value is in dB. Value minusinfinity corresponds to –infinity. Value dB0 corresponds to 0 dB, dB5 corresponds to 5 dB and so on (see TS 38.321 [3], clause 5.1.2).","paragraph_zero_based":18543},{"literal_text_all_w_t_and_m_t":"msgA-RSRP-Threshold","paragraph_zero_based":18544},{"literal_text_all_w_t_and_m_t":"The UE selects 2-step random access type to perform random access based on this threshold (see TS 38.321 [3], clause 5.1.1). This field is only present if both 2-step and 4-step RA type are configured for the concerned feature combination in the BWP. If configured, this parameter overrides msgA-RSRP-Threshold-r16. If absent, the UE applies msgA-RSRP-Threshold-r16, if configured","paragraph_zero_based":18545},{"literal_text_all_w_t_and_m_t":"numberOfPreamblesPerSSB-ForThisPartition","paragraph_zero_based":18546},{"literal_text_all_w_t_and_m_t":"It determines how many consecutive preambles are associated to the Feature Combination starting from the starting preamble(s) per SSB.","paragraph_zero_based":18547},{"literal_text_all_w_t_and_m_t":"numberOfRA-PreamblesGroupA","paragraph_zero_based":18548},{"literal_text_all_w_t_and_m_t":"It determines how many consecutive preambles per SSB are associated to Group A starting from the starting preamble(s). The remaining preambles associated to the Feature Combination are associated to Group B","paragraph_zero_based":18549},{"literal_text_all_w_t_and_m_t":"ra-SizeGroupA","paragraph_zero_based":18550},{"literal_text_all_w_t_and_m_t":"Transport Blocks size threshold in bits below which the UE shall use a contention-based RA preamble of group A. (see TS 38.321 [3], clause 5.1.2). If this feature combination preambles are associated to a RACH-ConfigCommon-twostepRA, this field correspond to ra-MsgA-SizeGroupA, otherwise it corresponds to ra-Msg3SizeGroupA.","paragraph_zero_based":18551}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["f7397b647cf3c414a423c79242fe7a43fe0763a98dc517fb245f74e8d0ef1a39","f6ce51ebda8ec5159e956bea8e607d422cc10e26099563684363bb4ae6257d13","65efa8e771f97403ed17bc84370bd2b55ee3664a3109084ec6ab4e2f5858b1fc","8832659b918f54593431eb47a3001cb9cd3bc9a8d54dfb11f3bfc91483135d92","c9ed38ca7d92253bec5b96f2bee2fd81f52cbb5725a08422c67f2c53bd4b76a8","2ad9740c7b5180e29636b5977baa05dfc7815c5312772b2ec81f070daee71765","65862a1e2c175cc1138e436fc584061cdc0ae17582e1d9fdfe600956b67aef48","08b2dab734e57e07d88c6f39ac3b0634b15803edab34ecf944b388f3fa0ec96b","4b5e834e0f515223f9dcaa444033abe8214f0970886b43af771e77c312e0ad94","885c2c41101bd83f9a26b4163047dbab5d3ca8f79b3e53c644f4e70e388d8b5a","7350378f4e13687438af45f467b8465f82926a87e7f0a500f13b565e74b6a7f1","58f46e759e27e3b846894d603af5c67f13b7de2c0239d45a83e3c43c39afa1bc","ec0e5abd98abdc82c784889b45ec4e808f7e4c7eac11c73e8a1dd0112c8a14f2","f1f156155dea639d5a02ba3849e8ca0989023545d98d304e8dc3ba1dc7cf0d09","28d163f0188023c4d35bfa692c62a0def8f1989a8bcc1661797539519bf7003a","3d6d02266247c1059b10bda27ba5e1be44dfb3c8dc94b90bd790296255e02131","a879de8a9b9f6dc05743954b2584856be12e10cd282d85e832d092cb562064c4","b7e2a2659f2af0ae51cfe680cedc9657d4c6d048f7edf1fcb6cb0e34493b2128","1d1de6466ebfb55a1cd05858e8a3f3438ab129ec62f362a523185641d77f98e1","83718c281633cf0f7ad0353bb3024c9ef2d17cd68c828c58f4570c92f3d48a12","c40b208a9db1b733fc5c1ab2e6537ca08f82a5b67b95e46923c1bf8519105332","423b3a4d78323caea787413dbb852253d09177b195663b69f362a2de5a6859f5","2a379cc53661bd7af71fdfab51418a4c86a32ac4a43f855aea1a8326fe6eebf7","55290a3d6ed9c6366e6e2f7c5ab9a0ad8536f5d2d4ad546a01d9c9384b82f568"],"paragraph_range_zero_based":[18528,18551],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p18528"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"rsrp-ThresholdSSB","paragraph_zero_based":18552},{"literal_text_all_w_t_and_m_t":"L1-RSRP threshold used for determining whether a candidate beam may be used by the UE. If this parameter is included in FeatureCombinationPreambles which is included in RACH-ConfigCommonTwoStepRA, it corresponds to msgA-RSRP-ThresholdSSB, as defined in TS 38.321 [3]. If this parameter is included in FeatureCombinationPreambles which is included in RACH-ConfigCommon, it it corresponds to rsrp-ThresholdSSB, as defined in TS 38.321 [3].","paragraph_zero_based":18553},{"literal_text_all_w_t_and_m_t":"separateMsgA-PUSCH-Config","paragraph_zero_based":18554},{"literal_text_all_w_t_and_m_t":"If present it specifies how the 2-step RACH preambles identified by this FeatureCombinationPreambles are mapped to a PUSCH slot separate from the one defined in MsgA-ConfigCommon-r16. If the field is absent, the UE should apply the corresponding parameter in the RACH-ConfigCommonTwoStepRA of the BWP which includes the FeatureCombinationPreambles IE.","paragraph_zero_based":18555},{"literal_text_all_w_t_and_m_t":"ssb-SharedRO-MaskIndex","paragraph_zero_based":18556},{"literal_text_all_w_t_and_m_t":"Mask index (see TS 38.321 [3]).","paragraph_zero_based":18557},{"literal_text_all_w_t_and_m_t":"Indicates a subset of ROs where preambles are allocated for this feature combination.","paragraph_zero_based":18558},{"literal_text_all_w_t_and_m_t":"If this field is configured within FeatureCombinationPreambles which is included in RACH-ConfigCommonTwoStepRA:","paragraph_zero_based":18559},{"literal_text_all_w_t_and_m_t":"-in case of separate ROs are configured for 4-step and 2-step random access, this field indicates a subset of ROs configured within this RACH-ConfigCommonTwoStepRA;","paragraph_zero_based":18560},{"literal_text_all_w_t_and_m_t":"-in case shared ROs are used for 4-step and 2-step random access, it indicates the subset of ROs configured within RACH-ConfigCommon, which are the subset of ROs configured for 2-step random access.","paragraph_zero_based":18561},{"literal_text_all_w_t_and_m_t":"This field is configured when there is more than one RO per SSB. If the field is absent, all ROs configured in RACH-ConfigCommon or RACH-ConfigCommonTwoStepRA containing this FeatureCombinationPreambles are shared.","paragraph_zero_based":18562},{"literal_text_all_w_t_and_m_t":"startPreambleForThisPartition","paragraph_zero_based":18563},{"literal_text_all_w_t_and_m_t":"It defines the first preamble associated with the Feature Combination. If the UE is provided with a number N of SSB block indexes associated with one PRACH occasion, and N<1, the first preamble in each PRACH occasion is the one having the same index as indicated by this field. If N>=1, N blocks of preambles associated with the Feature Combination are defined, each having start index + startPreambleForThisPartition, where n refers to SSB block index (see TS 38.213 [13], clause 8.1).","paragraph_zero_based":18564},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18565},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":18566},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":18567},{"literal_text_all_w_t_and_m_t":"MsgAConfigCommon","paragraph_zero_based":18568},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need S, if FeatureCombinationPreambles is included in RACH-ConfigCommonTwoStepRA. Otherwise, it is absent. If the field is absent in FeatureCombinationPreambles included in RACH-ConfigCommonTwoStepRA, the UE applies MsgA-PUSCH-Config included in the corresponding MsgA-ConfigCommon.","paragraph_zero_based":18569},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18570},{"literal_text_all_w_t_and_m_t":"–FilterCoefficient","paragraph_zero_based":18571},{"literal_text_all_w_t_and_m_t":"The IE FilterCoefficient specifies the measurement filtering coefficient. Value fc0 corresponds to k = 0, fc1 corresponds to k = 1, and so on.","paragraph_zero_based":18572},{"literal_text_all_w_t_and_m_t":"FilterCoefficient information element","paragraph_zero_based":18573},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18574},{"literal_text_all_w_t_and_m_t":"-- TAG-FILTERCOEFFICIENT-START","paragraph_zero_based":18575}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["d4d5435cad012ab61f8482b137c3d1e6d26240db32dc22eefcac116006132eb6","d98bc090e493d90dfcace892d21feb39465a99db858346f709eae301caf6b97a","8d45055b7bd36dae43baaa02f073f9ddbcf8d004888e515aa0a02eeb66fbcbdc","aed7fb0e2fd2cb09342adfa950f95d50bce42433198ea34e8368b6d844f1d998","e47922f21d5467b0ddf7b9cd5ad25e5fac879ff10173ff05effe7c048b9d3faa","25908a9fe14608387fc737f8ba1dc3a3cc84d13563f2c3602b52821ff81cb20c","d99eef017a51bbd1c87ef3912cc22f159db24531451d435b21f964a23385ca67","3a25e1ed3859d1ca12d5c10f9c05d659f2b0c099817409cabe73be47b2e72756","2a12a17d6f6ef54f8142942854407dbceb35cc5a1aefbb563f9a92f3fbea638a","d5ea2c411c297311e0d102f3daa61d608606aff93b6d985623db24febfa254f3","46167e4af272e9e70f49b8ed82e7868b1a3f5ab02004f7f352d5eea78c60c465","f949dcca061241b5b927abdb31f332c94838a84cd7f95228cd778efcb9b9b000","50cc58f033828eee48e5e3f9352df7d48f94a5a864f5395317f5f730d644e69e","7096863285fc6c67a2164cabe58e1fd6fc80d018db72dca210d7c658db1059e0","fe72b3de4c0a39fe94d152eb4ba81e1e7ce8f30b79694eaf914445d099272080","8c15db43fd3f3a9827973d24c73acdf69de06ab89eeb1f5d96783df757165f32","e10a760eb4ca5238294dacc05f7ba5be3ec3292ccd641ff5149753998e495e45","d11b8c749e724af90c6ac3fa4eccf2202b01e98477a670534dc1ac01edf38ef5","9d1fec2aa1edca6f6ec59b93ea2c149a8bb8c7f92f62de78f5b28919a0c6adac","5f9e7feebe99a0d4b8707dbbf2e98f5ecdd9934a2403801571522accd5e96782","143e1aee2041621fc77d511a8b39c5131100656b2f5f8c397a8f88ef1b07f75a","bb4fb6d1dfc5cb8366babc0a38b7118c86c7cde266fd497af36f06993740affd","34ed18fbd2fbc8d78aa329d78d1a050c668e5b0b44a856f905714dd082fc74bd","2a0cfbf2e72ade8ef002e9e9c4ac0bf7e2846e5f2cb3e07ad9f75d25e8ce193f"],"paragraph_range_zero_based":[18552,18575],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p18552"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18576},{"literal_text_all_w_t_and_m_t":"FilterCoefficient ::=       ENUMERATED { fc0, fc1, fc2, fc3, fc4, fc5, fc6, fc7, fc8, fc9, fc11, fc13, fc15, fc17, fc19, spare1, ...}","paragraph_zero_based":18577},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18578},{"literal_text_all_w_t_and_m_t":"-- TAG-FILTERCOEFFICIENT-STOP","paragraph_zero_based":18579},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18580},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18581},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18582},{"literal_text_all_w_t_and_m_t":"–FreqBandIndicatorNR","paragraph_zero_based":18583},{"literal_text_all_w_t_and_m_t":"The IE FreqBandIndicatorNR is used to convey an NR frequency band number as defined in TS 38.101-1 [15], TS 38.101-2 [39] and TS 38.101-5 [75].","paragraph_zero_based":18584},{"literal_text_all_w_t_and_m_t":"FreqBandIndicatorNR information element","paragraph_zero_based":18585},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18586},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQBANDINDICATORNR-START","paragraph_zero_based":18587},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18588},{"literal_text_all_w_t_and_m_t":"FreqBandIndicatorNR ::=             INTEGER (1..1024)","paragraph_zero_based":18589},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18590},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQBANDINDICATORNR-STOP","paragraph_zero_based":18591},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18592},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18593},{"literal_text_all_w_t_and_m_t":"–FreqPriorityListDedicatedSlicing","paragraph_zero_based":18594},{"literal_text_all_w_t_and_m_t":"The IE FreqPriorityListDedicatedSlicing provides dedicated cell reselection priorities for slicing in RRCRelease.","paragraph_zero_based":18595},{"literal_text_all_w_t_and_m_t":"FreqPriorityListDedicatedSlicing information element","paragraph_zero_based":18596},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18597},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQPRIORITYLISTDEDICATEDSLICING-START","paragraph_zero_based":18598},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18599}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["52a4c3756f67198f887cdf9639b5f5feacf1605f6c1bfd4f5c4d322539726d8f","b0f284df558a1c5884d4e338beb0381d6baab7b0f71a0881064eed5e47d0d9a0","7b25fdad339cc2ac3aefe2dc1353847cac7e7199a20519c08c31aaa2357089bc","aec600320a969f4fd2fd6acfe2cd1a1b7a9b2a9f7c876d7ad1e862115bd7aedb","11fcce45c4b278ad1d77463907230d804185f84838a0dad212dfbf4dfe9080a6","f5a032c54cdcc2c492461366af7721351c7de07d0b4045f5307d44b635135d5b","4a1686390e5b52b86436dd726355b400d0adc53612cad5c8e2dfa5512aa16542","1dd4bd4df3e48f91dac63855c6fd44d296a55ed474b2f7ed3ac6efa37b2c5551","3964f0370fa4d65a749e4b529269a4e86beb2dc55bbeb104e599fbf23f7831ca","12b15dfedd2899da69d15f4753cdce79896d64cb05b84be394e3eb834ee17153","07ee3a09bbbd343e4e2db8cb445d892b5334de8f03c0eef069fc77ffdd8eb1d1","f19a1e4033c1f18cc1004fc5f05244ee194131f276b5360627872de78d1d3575","bacf3cbeda03dc9a738ebcd4cae78bb4afa346069ccb286533bbddc026bbdcaf","50903a509d0597b44dcd3f7e13f87ca8a7a6bbe810b6ee197a3da5e6b7906707","6269356dde1300fc167f2b51612a971c5ea828a2b3ebf00448a306faacf67a32","ee55189fd0da096a5a3449f228e28faecb7eb536db7cfc2e4df8c2c415329e47","fd7d4eef5ac8407465396aacc3c4a26ca5040d112b84d6da90d810f328d2a0c7","c05982ceb40851b76