{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The cag-IdentityList contains one or more CAG IDs. All CAG IDs associated to the same PLMN ID are listed in the same cag-IdentityList entry.","paragraph_zero_based":21192},{"literal_text_all_w_t_and_m_t":"manualCAGselectionAllowed","paragraph_zero_based":21193},{"literal_text_all_w_t_and_m_t":"The manualCAGselectionAllowed indicates that the CAG ID can be selected manually even if it is outside the UE's allowed CAG list.","paragraph_zero_based":21194},{"literal_text_all_w_t_and_m_t":"NID","paragraph_zero_based":21195},{"literal_text_all_w_t_and_m_t":"A NID as specified in TS 23.003 [21]. The PLMN ID and a NID in the NPN-Identity identifies a SNPN.","paragraph_zero_based":21196},{"literal_text_all_w_t_and_m_t":"nid-List","paragraph_zero_based":21197},{"literal_text_all_w_t_and_m_t":"The nid-List contains one or more NID.","paragraph_zero_based":21198},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21199},{"literal_text_all_w_t_and_m_t":"–NPN-IdentityInfoList","paragraph_zero_based":21200},{"literal_text_all_w_t_and_m_t":"The IE NPN-IdentityInfoList includes a list of NPN identity information.","paragraph_zero_based":21201},{"literal_text_all_w_t_and_m_t":"NPN-IdentityInfoList information element","paragraph_zero_based":21202},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21203},{"literal_text_all_w_t_and_m_t":"-- TAG-NPN-IDENTITYINFOLIST-START","paragraph_zero_based":21204},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21205},{"literal_text_all_w_t_and_m_t":"NPN-IdentityInfoList-r16 ::=     SEQUENCE (SIZE (1..maxNPN-r16)) OF NPN-IdentityInfo-r16","paragraph_zero_based":21206},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21207},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21208},{"literal_text_all_w_t_and_m_t":"NPN-IdentityInfo-r16 ::=         SEQUENCE {","paragraph_zero_based":21209},{"literal_text_all_w_t_and_m_t":"    npn-IdentityList-r16             SEQUENCE (SIZE (1..maxNPN-r16)) OF NPN-Identity-r16,","paragraph_zero_based":21210},{"literal_text_all_w_t_and_m_t":"    trackingAreaCode-r16             TrackingAreaCode,","paragraph_zero_based":21211},{"literal_text_all_w_t_and_m_t":"    ranac-r16                        RAN-AreaCode                                                OPTIONAL,       -- Need R","paragraph_zero_based":21212},{"literal_text_all_w_t_and_m_t":"    cellIdentity-r16                 CellIdentity,","paragraph_zero_based":21213},{"literal_text_all_w_t_and_m_t":"    cellReservedForOperatorUse-r16   ENUMERATED {reserved, notReserved},","paragraph_zero_based":21214},{"literal_text_all_w_t_and_m_t":"    iab-Support-r16                  ENUMERATED {true}                                           OPTIONAL,       -- Need S","paragraph_zero_based":21215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["c82cff6e386bd6bba6a3517470353d2d626f6879b5f18898b6d0a77e303429ee","eb3f755c5d69adf04370210510c09d722708ac3c55f1449d1f4b3ff38eba4d08","4a1c0d177af5d725e196c5cbdf18514a9a2b189ef73d9d7eac1d7ee919651e75","32ad59b2aafd01bf5d9fa940053ecc04aeaff35c716aed1480689a0baecf66d8","10c440b7a83d9b16061b089f4e770df7cd2481414319b988d3c380bc64c980a8","6be165236c0d281d12cfddd4a3570218de947b3920dacab3140af20fa43d04cc","afda7db0d6dec5e15b6e418ab201e7a7f2c533d40a62c298614f786b8b62a5eb","bc730e7fe6d60a126ef83f0c1a7ec7c16cb0c68d1f16327e245d71155dd55c29","4216a470c38e03e503780ec795babb7bbf6eb0b871b031c7358b030c1429dbcd","350927c1ccd8d92aeff437e92b95dec8bb0d12053930ce9befad69b140f68369","203329221549ca769488f818cb551657d293fa6422f4e10c23d2614767654225","60abccecffc3e64ce954bea9e057a19bb99ed17696cb6a62248a1618ae913774","ae38c27eeffbe9ad385a7a1dbba7566a1c67aaa87a9864a912de2a3145fcbbd7","9f0b2c6e9039e1afa39d289f83e3390a3118a9c353f05a899ef70241271b2eee","f89b886f7a7a40729583e987578e69df3e0ded9c91c5fe2e1228587333df2364","25e147ccaa437747ce362fe2188a4ae765797a3373c7c32abe45bf94bed39f04","bf53c105924fad0fe56287ce8e80807537fa4726a09ae26344c17f0622f08843","c60f88a7d4a8f84b372f181c4468a2c2aefbb852c98d4130193b69d87835ab01","d2b0b65923a39eca51f394e69c62eaa4fc7d65a23f2574e5cd50d32e0cf0b8ed","b0f7d8ed4de91e7f45c9cb57f0a55959b232f52ff4af839dbeedab2b1b394b7e","08869c6d0a8dbd24dff465786697bc6be247c79107963f9bb044063cb8689a50","b102638884ebf971d7021169df36d65fc64e957416c4bdc18f4215bbc3a02031","8e0c1ef31909a76bfe42207461ee1e14991c480bc73a799d45572d7126b7b6c3","42251f0a2221b2de0597f703f0fd9861cc756d296830d17f2a205b10be9516ca"],"paragraph_range_zero_based":[21192,21215],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p21192"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":21216},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":21217},{"literal_text_all_w_t_and_m_t":"    gNB-ID-Length-r17                INTEGER (22..32)                                            OPTIONAL        -- Need R","paragraph_zero_based":21218},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":21219},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21220},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21221},{"literal_text_all_w_t_and_m_t":"-- TAG-NPN-IDENTITYINFOLIST-STOP","paragraph_zero_based":21222},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21223},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21224},{"literal_text_all_w_t_and_m_t":"NPN-IdentityInfoList field descriptions","paragraph_zero_based":21225},{"literal_text_all_w_t_and_m_t":"iab-Support","paragraph_zero_based":21226},{"literal_text_all_w_t_and_m_t":"This field combines both the support of IAB and the cell status for IAB. If the field is present, the cell supports IAB and the cell is also considered as a candidate for cell (re)selection for IAB-nodes; if the field is absent, the cell does not support IAB and/or the cell is barred for IAB-node.","paragraph_zero_based":21227},{"literal_text_all_w_t_and_m_t":"gNB-ID-Length","paragraph_zero_based":21228},{"literal_text_all_w_t_and_m_t":"Indicates the length of the gNB ID out of the 36-bit long cellIdentity.","paragraph_zero_based":21229},{"literal_text_all_w_t_and_m_t":"NPN-IdentityInfo","paragraph_zero_based":21230},{"literal_text_all_w_t_and_m_t":"The NPN-IdentityInfo contains one or more NPN identities and additional information associated with those NPNs. Only the same type of NPNs (either SNPNs or PNI-NPNs) can be listed in a NPN-IdentityInfo element.","paragraph_zero_based":21231},{"literal_text_all_w_t_and_m_t":"npn-IdentityList","paragraph_zero_based":21232},{"literal_text_all_w_t_and_m_t":"The npn-IdentityList contains one or more NPN Identity elements.","paragraph_zero_based":21233},{"literal_text_all_w_t_and_m_t":"trackingAreaCode","paragraph_zero_based":21234},{"literal_text_all_w_t_and_m_t":"Indicates the Tracking Area Code to which the cell indicated by cellIdentity field belongs. ","paragraph_zero_based":21235},{"literal_text_all_w_t_and_m_t":"ranac","paragraph_zero_based":21236},{"literal_text_all_w_t_and_m_t":"Indicates the RAN Area Code to which the cell indicated by cellIdentity field belongs. ","paragraph_zero_based":21237},{"literal_text_all_w_t_and_m_t":"cellReservedForOperatorUse","paragraph_zero_based":21238},{"literal_text_all_w_t_and_m_t":"Indicates whether the cell is reserved for operator use (for the NPN(s) identified in the npn-IdentityList) as defined in TS 38.304 [20]. This field is ignored by NPN capable IAB-MT.","paragraph_zero_based":21239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["a6e88d8985166efed8d7afa839c9081707b85cdbff515eddee6b5892f2791ede","96e52665418a099b4448dc1deedc8f7054fe0ea44c94c7f8afa58f897eace718","189ea8051d1d9492821e326d801947ac7a424f1c5efe7f400ca22c7c5f23bfef","daeb5d7621a9c0e4c171cabe99003fc7898cb688c074465312ac126e278e820c","eabe6e92407c225245384fe3a3d5b5d4b1d76107b07388ca16464e199da6f180","d27223d6896fc36d9ef3ffda3ff36d763f67b664474504b370c02037780c597e","ac069b2ec09246e2b7bbd3f26beeae8b25c79d9aaf253ef5c38cd1d4939d983b","54dfc345fb49863ccb4099747494ae3acfe3cbbabbea70c8709eaa68284b0dfa","a0e65ca2f9a210366982d4bd85b9c0f674557de2ef1e9eb