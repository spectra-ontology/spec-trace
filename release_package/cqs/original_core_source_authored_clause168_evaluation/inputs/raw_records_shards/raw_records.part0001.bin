42},{"literal_text_all_w_t_and_m_t":"maxRetxThreshold","paragraph_zero_based":26443},{"literal_text_all_w_t_and_m_t":"Parameter for RLC AM in TS 38.322 [4]. Value t1 corresponds to 1 retransmission, value t2 corresponds to 2 retransmissions and so on.","paragraph_zero_based":26444},{"literal_text_all_w_t_and_m_t":"pollByte","paragraph_zero_based":26445},{"literal_text_all_w_t_and_m_t":"Parameter for RLC AM in TS 38.322 [4]. Value kB25 corresponds to 25 kBytes, value kB50 corresponds to 50 kBytes and so on. infinity corresponds to an infinite amount of kBytes.","paragraph_zero_based":26446},{"literal_text_all_w_t_and_m_t":"pollPDU","paragraph_zero_based":26447}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["8262493ac403d80b07d2d9fde2b7fdfd1ed49f3cb349b7be99b55a3de25c864a","faef3df99f80fcf779d1b541154d22c008f88665e69835159f74885dfb332aab","6230d953811eacd0a1c6583078a8e5b2568c91ceca68c8499586529c3540df3d","c47613596c16c4d94e2014cd729b7cb31a0dd796facdccda339b06f5b424ce08","682300b45b7b469122fc838524c1052f9509af5424f080cd8b22045442bd2162","65be052ce6a1d7398c6e25b408a642c7ad035015b99beccb88bf549882ab5522","0108e4877f61c3e779ae3d843644936dd340d58673926302bb34ed86ab487982","f846f729101d9207e3c6e71169984ce56af17b07d7c75ab68c9aebf03629f1f4","ac364c72004b8c858dabfe44080450fa3c7b86e2071d772c744a7c35b5ea74d4","e23bc001d3b7ac0cc616dc37cd104d5a805c6cc7bdf2303c389f81d370fe3b64","4d32c8a6875af4584d37acf9e1c3a523c6978eba5942ed8437bb3c26cd02c2ef","198fcf0ec58d0738fdfaf356992a47006fc7dc3c2383a48b7434262e7726d0cb","d2540536683b65b70457dc80f533246881451a346b2f4bebf575e39ca25c094a","ddb71282e4f188fb3abf64192fa8c600ad3c6de992b1d02751bdec5252654cd7","b2f481ceac01a36b12715abe403c3cb433139fd74853de6f610f91f7d588737d","71f90b5d945494fff9ac0ea7aa3e7f1cc71e5c395951c1ac8f450af5d601753a","bb60cab92cff244bc6b8818a64dea65b61c6583b3273ac6ae38ba5881a43ca83","1bd17c46950d17edb42f78a3014f05c07b005c46e8d6134d5bb122970319f349","a15b736be00018b59e928db2b23c9417d9a56aabf9901e8949cf7b8fc8bc2659","96fd4c4d2f4ae17da9a514d0a947d4609be86936654511296fa83b886040b935","c6521026e170b221b73bc8e22637c449923c5c7f2a958124f87f1ac87febd7fa","6a25a9bdf039fd8b1c23bb30426cf0860dad1f94868f5791abc2a2656a41e379","5031d26f6c294d3ffaee85f417ddc0d90bd7b56362cb1e6c8548969219df2b93","b4b850a7031ce93ffa080899886b4e9c7abd0f8e397668181b09bf390c40e878"],"paragraph_range_zero_based":[26424,26447],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p26424"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Parameter for RLC AM in TS 38.322 [4]. Value p4 corresponds to 4 PDUs, value p8 corresponds to 8 PDUs and so on. infinity corresponds to an infinite number of PDUs.","paragraph_zero_based":26448},{"literal_text_all_w_t_and_m_t":"sn-FieldLength","paragraph_zero_based":26449},{"literal_text_all_w_t_and_m_t":"Indicates the RLC SN field size, see TS 38.322 [4], in bits. Value size6 means 6 bits, value size12 means 12 bits, value size18 means 18 bits. The value of sn-FieldLength of an RLC entity for the DRB/multicast MRB shall be changed only using reconfiguration with sync. The network configures only value size12 in SN-FieldLengthAM for SRB.","paragraph_zero_based":26450},{"literal_text_all_w_t_and_m_t":"t-PollRetransmit","paragraph_zero_based":26451},{"literal_text_all_w_t_and_m_t":"Timer for RLC AM in TS 38.322 [4], in milliseconds. Value ms5 means 5 ms, value ms10 means 10 ms and so on.","paragraph_zero_based":26452},{"literal_text_all_w_t_and_m_t":"t-Reassembly, t-ReassemblyExt","paragraph_zero_based":26453},{"literal_text_all_w_t_and_m_t":"Timer for reassembly in TS 38.322 [4], in milliseconds. Value ms0 means 0 ms, value ms5 means 5 ms and so on. If t-ReassemblyExt-r17 is configured, the UE shall ignore t-Reassembly (without suffix).","paragraph_zero_based":26454},{"literal_text_all_w_t_and_m_t":"t-StatusProhibit","paragraph_zero_based":26455},{"literal_text_all_w_t_and_m_t":"Timer for status reporting in TS 38.322 [4], in milliseconds. Value ms0 means 0 ms, value ms5 means 5 ms and so on. If t-StatusProhibit-v1610 is present, the UE shall ignore t-StatusProhibit (without suffix).","paragraph_zero_based":26456},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26457},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":26458},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":26459},{"literal_text_all_w_t_and_m_t":"Reestab","paragraph_zero_based":26460},{"literal_text_all_w_t_and_m_t":"The field is mandatory present at RLC bearer setup. It is optionally present, need M, at RLC re-establishment. Otherwise it is absent. Need M.","paragraph_zero_based":26461},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26462},{"literal_text_all_w_t_and_m_t":"–RLF-TimersAndConstants","paragraph_zero_based":26463},{"literal_text_all_w_t_and_m_t":"The IE RLF-TimersAndConstants is used to configure UE specific timers and constants.","paragraph_zero_based":26464},{"literal_text_all_w_t_and_m_t":"RLF-TimersAndConstants information element","paragraph_zero_based":26465},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26466},{"literal_text_all_w_t_and_m_t":"-- TAG-RLF-TIMERSANDCONSTANTS-START","paragraph_zero_based":26467},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26468},{"literal_text_all_w_t_and_m_t":"RLF-TimersAndConstants ::=          SEQUENCE {","paragraph_zero_based":26469},{"literal_text_all_w_t_and_m_t":"    t310                                ENUMERATED {ms0, ms50, ms100, ms200, ms500, ms1000, ms2000, ms4000, ms6000},","paragraph_zero_based":26470},{"literal_text_all_w_t_and_m_t":"    n310                                ENUMERATED {n1, n2, n3, n4, n6, n8, n10, n20},","paragraph_zero_based":26471}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["641255c71951d7146ca0f66911e9dfaefea2d30888b62f2bfc0bc591e42ed791","a7c4c384173d581aa95a36481837474e7b92ea59ec30ac20169c4a7b47f64567","1d843845da49374a959b8fc189acb75f014dcff28384ab42b549e5f3a6621d01","