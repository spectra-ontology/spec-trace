{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"- (NG)EN-DC, NR SA, NE-DC or NR-DC without FR2-FR2 band combination, with asynchronous CA involving FR2 carriers.","paragraph_zero_based":30120},{"literal_text_all_w_t_and_m_t":"Otherwise, it is absent.","paragraph_zero_based":30121},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30122},{"literal_text_all_w_t_and_m_t":"–UplinkCancellation","paragraph_zero_based":30123},{"literal_text_all_w_t_and_m_t":"The IE UplinkCancellation is used to configure the UE to monitor PDCCH for the CI-RNTI.","paragraph_zero_based":30124},{"literal_text_all_w_t_and_m_t":"UplinkCancellation information element","paragraph_zero_based":30125},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":30126},{"literal_text_all_w_t_and_m_t":"-- TAG-UPLINKCANCELLATION-START","paragraph_zero_based":30127},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30128},{"literal_text_all_w_t_and_m_t":"UplinkCancellation-r16 ::=           SEQUENCE {","paragraph_zero_based":30129},{"literal_text_all_w_t_and_m_t":"    ci-RNTI-r16                          RNTI-Value,","paragraph_zero_based":30130},{"literal_text_all_w_t_and_m_t":"    dci-PayloadSizeForCI-r16             INTEGER (0..maxCI-DCI-PayloadSize-r16),","paragraph_zero_based":30131},{"literal_text_all_w_t_and_m_t":"    ci-ConfigurationPerServingCell-r16   SEQUENCE (SIZE (1..maxNrofServingCells)) OF CI-ConfigurationPerServingCell-r16,","paragraph_zero_based":30132},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":30133},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30134},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30135},{"literal_text_all_w_t_and_m_t":"CI-ConfigurationPerServingCell-r16 ::=   SEQUENCE {","paragraph_zero_based":30136},{"literal_text_all_w_t_and_m_t":"    servingCellId                            ServCellIndex,","paragraph_zero_based":30137},{"literal_text_all_w_t_and_m_t":"    positionInDCI-r16                        INTEGER (0..maxCI-DCI-PayloadSize-1-r16),","paragraph_zero_based":30138},{"literal_text_all_w_t_and_m_t":"    positionInDCI-ForSUL-r16                 INTEGER (0..maxCI-DCI-PayloadSize-1-r16)                             OPTIONAL,   -- Cond SUL-Only","paragraph_zero_based":30139},{"literal_text_all_w_t_and_m_t":"    ci-PayloadSize-r16                       ENUMERATED {n1, n2, n4, n5, n7, n8, n10, n14, n16, n20, n28, n32, n35, n42, n56, n112},","paragraph_zero_based":30140},{"literal_text_all_w_t_and_m_t":"    timeFrequencyRegion-r16                  SEQUENCE {","paragraph_zero_based":30141},{"literal_text_all_w_t_and_m_t":"        timeDurationForCI-r16                    ENUMERATED {n2, n4, n7, n14}                                      OPTIONAL,   -- Cond SymbolPeriodicity","paragraph_zero_based":30142},{"literal_text_all_w_t_and_m_t":"        timeGranularityForCI-r16                 ENUMERATED {n1, n2, n4, n7, n14, n28},","paragraph_zero_based":30143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["71e35fe633da74c59f15bacb4ac2746403b94de828ac82b67671f8ac6abf34f5","11e58c4e0d8fd46644994c58abad97cfd1a10e035a385bc449af1518fe5c0d45","5468479db2e8f860f0d4c4741b0b3a0bbdf409fe9bc68e1aeefbb03186a2baaa","315ab9d75e9b25ffb02149901542b21086b22230da17892f5449916872f3f2c3","a3e4a445d6fa6dea71fc13978d50753f8a7e59b09e1a4375f8a75cfe2a3efa76","1dc7d79a6d09c1f20de086b74fccf33d6eed201d680e9a910fa113de89679d31","b406270788d62262f8e48f5e0f174d78e451531304e745dbb6720b711914b1c0","5d39cc44b93489e960513323701a35881884013ed46e514952ced4af70f3a