99936583df7b5f2fc9e6371eeb84bd8f0da6691f3585d569b14b9a7605b4ce","73073bf2e9a7ecef313dbe7153d9c15983215494d15cd7b3c36deccdd20152cb","c7c179a91a8e88e57be5c04211c13a779d19819af4ffed2a5a631dc020180fcf"],"paragraph_range_zero_based":[22656,22679],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p22656"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22680},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22681},{"literal_text_all_w_t_and_m_t":"RateMatchPatternGroup ::=               SEQUENCE (SIZE (1..maxNrofRateMatchPatternsPerGroup)) OF CHOICE {","paragraph_zero_based":22682},{"literal_text_all_w_t_and_m_t":"    cellLevel                               RateMatchPatternId,","paragraph_zero_based":22683},{"literal_text_all_w_t_and_m_t":"    bwpLevel                                RateMatchPatternId","paragraph_zero_based":22684},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22685},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22686},{"literal_text_all_w_t_and_m_t":"MinSchedulingOffsetK0-Values-r16 ::=    SEQUENCE (SIZE (1..maxNrOfMinSchedulingOffsetValues-r16)) OF INTEGER (0..maxK0-SchedulingOffset-r16)","paragraph_zero_based":22687},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22688},{"literal_text_all_w_t_and_m_t":"MinSchedulingOffsetK0-Values-r17 ::=    SEQUENCE (SIZE (1..maxNrOfMinSchedulingOffsetValues-r16)) OF INTEGER (0..maxK0-SchedulingOffset-r17)","paragraph_zero_based":22689},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22690},{"literal_text_all_w_t_and_m_t":"MaxMIMO-LayersDL-r16 ::=                INTEGER (1..8)","paragraph_zero_based":22691},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22692},{"literal_text_all_w_t_and_m_t":"-- TAG-PDSCH-CONFIG-STOP","paragraph_zero_based":22693},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":22694},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22695},{"literal_text_all_w_t_and_m_t":"PDSCH-Config field descriptions","paragraph_zero_based":22696},{"literal_text_all_w_t_and_m_t":"antennaPortsFieldPresenceDCI-1-2","paragraph_zero_based":22697},{"literal_text_all_w_t_and_m_t":"Configure the presence of \"Antenna ports\" field in DCI format 1_2. When the field is configured, then the \"Antenna ports\" field is present in DCI format 1_2. Otherwise, the field size is set to 0 for DCI format 1_2 (See TS 38.212 [17], clause 7.3.1.1.3). If neither dmrs-DownlinkForPDSCH-MappingTypeA-DCI-1-2 nor dmrs-DownlinkForPDSCH-MappingTypeB-DCI-1-2 is configured, this field is absent.","paragraph_zero_based":22698},{"literal_text_all_w_t_and_m_t":"aperiodic-ZP-CSI-RS-ResourceSetsToAddModList, aperiodic-ZP-CSI-RS-ResourceSetsToAddModListDCI-1-2","paragraph_zero_based":22699},{"literal_text_all_w_t_and_m_t":"AddMod/Release lists for configuring aperiodically triggered zero-power CSI-RS resource sets. Each set contains a ZP-CSI-RS-ResourceSetId and the IDs of one or more ZP-CSI-RS-Resources (the actual resources are defined in the zp-CSI-RS-ResourceToAddModList). The network configures the UE with at most 3 aperiodic ZP-CSI-RS-ResourceSets and it uses only the ZP-CSI-RS-ResourceSetId 1 to 3. The network triggers a set by indicating its ZP-CSI-RS-ResourceSetId in the DCI payload. The DCI codepoint '01' triggers the resource set with ZP-CSI-RS-ResourceSetId 1, the DCI codepoint '10' triggers the resource set with ZP-CSI-RS-ResourceSetId 2, and the DCI codepoint '11' triggers the resource set with ZP-CSI-RS-ResourceSetId 3 (see TS 38.214 [19], clause 5.1.4.2). The field aperiodic-ZP-CSI-RS-ResourceSetsToAddModList applies to DCI format 1_1 and the field aperiodic-ZP-CSI-RS-ResourceSetsToAddModListDCI-1-2 applies to DCI format 1_2 (see TS 38.214 [19], clause 5.1.4.2 and TS 38.212 [17] clause 7.3.1).","paragraph_zero_based":22700},{"literal_text_all_w_t_and_m_t":"beamAppTime","paragraph_zero_based":22701},{"literal_text_all_w_t_and_m_t":"Indicates the first slot to apply the unified TCI indicated by DCI as specified in TS 38.214 Clause 5.1.5. The value n1 means 1 symbol, n2 two symbols and so on. The first slot is at least Y symbols indicated by beamAppTime parameter after the last symbol of the acknowledgment of the joint or separate DL/UL beam indication. The same value shall be configured for all serving cells in any one of the simultaneousU-TCI-UpdateListN configured in IE CellGroupConfig based on the smallest SCS of the active BWP.","paragraph_zero_based":22702},{"literal_text_all_w_t_and_m_t":"dataScramblingIdentityPDSCH, dataScramblingIdentityPDSCH2","paragraph_zero_based":22703}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["56d9b7fb6b53dc1a5f25d4746a03865689b600c802fea5c30fe3b9d925945b46","56a95e642059d1bcd5a01cac3c63003eca20023e5e6a8c3d4505e6445cbabbef","249dab42b89a738dba891760a0a5f5d328b64d2c4305268b6203d0fdea9d1313","32810331159eda0ffc211878fbb37d793ae1412334bb70f8d648f5ed7bc2a56d","6ffc78a9bd6fedaa9531dc5237d6b34f8d3bde3cc5f6644a667ee5458183b550","2462500f5dc1d4ca36df38bf2a3b7643dba43d76e495d606217058129729bb73","8f704b888786ed2da136de7ce6abdfdfaff2b9ecf6a30673bed38f6169419c48","8820a653a7b6440f3f133d34cc7156068f33ba10ee176822510ecc94809b6861","ce9951ed289c3785909073e87df280fb9a966c2258c700118406d2d4d2d0a0b1","f3f7c69ef838e0541f0fb635d5e001fefc9902a3896dad4c6f53dcedfbf3345e","e0f6cf8baf693ed28db89b228dc371cbcf298456a4345c396350b6c76f5cb2cd","8e9a18d16fcca833f9ec41ef0b5704b8a7a4681579d0dd71fbcaceb7a6cda48e","ee704b92cedd7aa3d6e1ee515aa21fefb01c3f1d418aff87631f0067e0cad54f","d69ae6c6750288167185a2de7159b43ef36f174dd131db51cd00b518c692e269","eb09d2a30f4c83f78705c63f6997bc1da18c1b565ae9f8360f2120f23e7af201","be098c6800b9bb5cd535c6a3fbb24d06a704e79cbbe572ab6266d14cadeaf688","9623fee383444943a0c99f71b4910932c970de91d864696b0e0261b13be9af18","2bc96d5749818a433476d4acbfc2ae72ae7b0020187a219e5446ebd87847eb6e","2bb526836eeec3a9b21af27815f8f4022078da979d0008d863aab138372477de","edf130c900fd0efc918be3a3f744f13e6d803675b7463033d9626a0d5fd1e1b8","b4833dd016fd6c84b10390d450792ac8e6d52709115e8de205ff1ca3404ec956","d1c6ba3741468293d30b793618ac2d8b18aceef2e79473bdedce6609a09da224","00b98500f90dd55fb0ad1a20868aee538d49e3fdcb27ec8968ba1079fa6bb72a","a44ebacc37382f4a72ee9201561725f76ecab91c9fad5e03666ce6fe10d047a1"],"paragraph_range_zero_based":[22680,22703],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p22680"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Identifier(s) used to initialize data scrambling (c_init) for PDSCH as specified in TS 38.211 [16], clause 7.3.1.1. The dataScramblingIdentityPDSCH2 is configured if coresetPoolIndex is configured with 1 for at least one CORESET in the same BWP.","paragraph_zero_based":22704},{"literal_text_all_w_t_and_m_t":"dl-OrJointTCI-StateToAddModList","paragraph_zero_based":22705},{"literal_text_all_w_t_and_m_t":"A list of Transmission Configuration Indicator (TCI) states indicating a transmission configuration which includes QCL-relationships between the DL RSs in one RS set and the PDSCH DMRS ports, PDCCH DMRS ports, and CSI-RS, and in case of join mode, also the PUSCH, PUCCH and SRS (see TS 38.214 [19], clause 5.1.5).","paragraph_zero_based":22706},{"literal_text_all_w_t_and_m_t":"dmrs-DownlinkForPDSCH-MappingTypeA, dmrs-DownlinkForPDSCH-MappingTypeA-DCI-1-2","paragraph_zero_based":22707},{"literal_text_all_w_t_and_m_t":"DMRS configuration for PDSCH transmissions using PDSCH mapping type A (chosen dynamically via PDSCH-TimeDomainResourceAllocation). Only the fields dmrs-Type, dmrs-AdditionalPosition and maxLength may be set differently for mapping type A and B. The field dmrs-DownlinkForPDSCH-MappingTypeA applies to DCI format 1_1 and the field dmrs-DownlinkForPDSCH-MappingTypeA-DCI-1-2 applies to DCI format 1_2 (see TS 38.212 [17], clause 7.3.1).","paragraph_zero_based":22708},{"literal_text_all_w_t_and_m_t":"dmrs-DownlinkForPDSCH-MappingTypeB, dmrs-DownlinkForPDSCH-MappingTypeB-DCI-1-2","paragraph_zero_based":22709},{"literal_text_all_w_t_and_m_t":"DMRS configuration for PDSCH transmissions using PDSCH mapping type B (chosen dynamically via PDSCH-TimeDomainResourceAllocation). Only the fields dmrs-Type, dmrs-AdditionalPosition and maxLength may be set differently for mapping type A and B. The field dmrs-DownlinkForPDSCH-MappingTypeB applies to DCI format 1_1 and the field dmrs-DownlinkForPDSCH-MappingTypeB-DCI-1-2 applies to DCI format 1_2 (see TS 38.212 [17], clause 7.3.1).","paragraph_zero_based":22710},{"literal_text_all_w_t_and_m_t":"dmrs-FD-OCC-DisabledForRank1-PDSCH","paragraph_zero_based":22711},{"literal_text_all_w_t_and_m_t":"If configured, the UE may assume that the set of remaining orthogonal antenna ports, which are within the same code division multiplexing (CDM) group and have different frequency domain orthogonal cover codes (FD-OCC), are not associated with the PDSCH of another UE (see TS 38.214 [19], clause 5.1.6.2). It is applicable for PDSCH SCS of 480 and 960 kHz when rank 1 PDSCH with type-1 or type-2 DMRS is scheduled.","paragraph_zero_based":22712},{"literal_text_all_w_t_and_m_t":"dmrs-SequenceInitializationDCI-1_2","paragraph_zero_based":22713},{"literal_text_all_w_t_and_m_t":"Configure whether the field \"DMRS Sequence Initialization\" is present or not in DCI format 1_2 If the field is absent, then the UE applies the value of 0 bit for the field \"DMRS Sequence Initialization\" in DCI format 1_2. If the field is present, then the UE applies the value of 1 bit as in DCI format 1_2 (see TS 38.212 [17], clause 7.3.1).","paragraph_zero_based":22714},{"literal_text_all_w_t_and_m_t":"dummy","paragraph_zero_based":22715},{"literal_text_all_w_t_and_m_t":"This field is not used in the specification. If received it shall be ignored by the UE.","paragraph_zero_based":22716},{"literal_text_all_w_t_and_m_t":"harq-ProcessNumberSizeDCI-1-2","paragraph_zero_based":22717},{"literal_text_all_w_t_and_m_t":"Configure the number of bits for the field \"HARQ process number\" in DCI format 1_2 (see TS 38.212 [17], clause 7.3.1).","paragraph_zero_based":22718},{"literal_text_all_w_t_and_m_t":"maxMIMO-Layers","paragraph_zero_based":22719},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of MIMO layers to be used for PDSCH in this DL BWP. If not configured, the UE uses the maxMIMO-Layers configuration in IE PDSCH-ServingCellConfig of the serving cell to which this BWP belongs, when the UE operates in this BWP. The value of maxMIMO-Layers for a DL BWP shall be smaller than or equal to the value of maxMIMO-Layers configured in IE PDSCH-ServingCellConfig of the serving cell to which this BWP belongs.","paragraph_zero_based":22720},{"literal_text_all_w_t_and_m_t":"For MBS multicast, indicates the maximum number of MIMO layers to be used for group-common PDSCH of MBS multicast in this CFR. If not configured for CFR, the UE applies value 1. The value of maxMIMO-Layers for a CFR shall be smaller than or equal to the value of maxMIMO-Layers configured in PDSCH-ServingCellConfig IE of the serving cell to which this CFR belongs.","paragraph_zero_based":22721},{"literal_text_all_w_t_and_m_t":"maxNrofCodeWordsScheduledByDCI","paragraph_zero_based":22722},{"literal_text_all_w_t_and_m_t":"Maximum number of code words that a single DCI may schedule. This changes the number of MCS/RV/NDI bits in the DCI message from 1 to 2.","paragraph_zero_based":22723},{"literal_text_all_w_t_and_m_t":"mcs-Table","paragraph_zero_based":22724},{"literal_text_all_w_t_and_m_t":"Indicates which MCS table the UE shall use for PDSCH for DCI formats 1_0 and 1_1 (see TS 38.214 [19], clause 5.1.3.1). If all fields are absent the UE applies the value 64QAM. If the field mcs-Table-r17 is present for DCI format 1_1, the network does not configure the field mcs-Table (without suffix). For a RedCap UE, the 256QAM MCS table for PDSCH is only supported if the UE indicates support of 256QAM for PDSCH.","paragraph_zero_based":22725},{"literal_text_all_w_t_and_m_t":"mcs-TableDCI-1-2","paragraph_zero_based":22726},{"literal_text_all_w_t_and_m_t":"Indicates which MCS table the UE shall use for PDSCH for DCI format 1_2 (see TS 38.214 [19], clause 5.1.3.1). If all fields are absent the UE applies the value 64QAM. If the field mcs-TableDCI-1-2-r17 is present, the network does not configure the field mcs-TableDCI-1-2-r16. For a RedCap UE, the 256QAM MCS table for PDSCH is only supported if the UE indicates support of 256QAM for PDSCH.","paragraph_zero_based":22727}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["a1fe44e591fb9faccb5889ba5aa3cec961e8b2a13b17ab8688073627c060e4ca","3961e6dc116b47b61ae1119a1191ec818d8e0daaed1402c859517bf4fdafd14a","920690fcb4da6218a77ad90480e3abdb6afb54bf7cff6adb5398686bdde8cc58","c52fc6fe756ffa8f24d6bc2644605d46e8897c52e7e796f63258f03334264084","f86e36b3d6d998b0ce60ab01aa0a2207d1a5bc924eecd3ef4146736244dea098","36d9e201c2bbceff69a614229341aafb7226a9735ab1618714085e688a2f6a6d","f9ebf37f933d410515b0efadc4ce46d1c26cab50a2968ae4456ae35e0d00234e","eec2ce2c26679c26edf6fd04e80edbc6b7c0878fd3d7d252db0fac487f8f2887","e8bd9bb06240ea05770ba8b46f5458da618f7ede9ebb6db34833605c3dcc2d58","1b3b92efeb9610f2edc5ddd88b607960c8105506ff6c5a48ca2a0856f50869f4","52e6942252f5cb61387651b8ab721f9d47cbb639a1f919fb56634043ac4072f6","66c617ad4bdf175b82a1fc7acd861632d660f091011448db44f97ebf60b4b3e2","83cf066d9495d503b299b6fd4377b266806f5b56e2c9297a7ef7b4e809fbdf65","d10927d766eef0ad10b3319452e3ce0c8ad85b131d9b078727d05d8d538ed0f4","7d8b4b6eaab9ad21d8c442d3d7645a24544316729ee993bd240e8fd11bbe1d57","34d23250a1eed45e35b92c77af92c1f25ff81fa0818f0c99f84d1966aea7a6b8","4b834164f0128b3d678b61fed75b26298dfb2116f733e6591460d8cd3b6d0305","3966ff6890efbbc04a4f485905f0787bdc58fb0e274f70a16b099a2e780a1070","3a5198a5c25f66126e41c279d9ac8a6b283370d371fedeeda129d124987c83e9","cc30a613a63022dcc0b8010bc89ab2bb70261ab14f3c35995021937089a5a2e4","0a4e3d70a3d7e862a6244e63c9443867e2be26afe92619101f3cecc1ce8ded21","d6da7d7109b41c150b7d1955dd91ca2d47007722e85793682b73975a3f4f164c","cb2282580fa7c3e8f260c5a6f01f105bc5267039411e209896e41db18e00afd4","60889c415d566fc8b5edb7d8800368c692e085abc93ae64ef9ee0a25b0ecc9c5"],"paragraph_range_zero_based":[22704,22727],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p22704"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"minimumSchedulingOffsetK0","paragraph_zero_based":22728},{"literal_text_all_w_t_and_m_t":"List of minimum K0 values. Minimum K0 parameter denotes minimum applicable value(s) for the TDRA table for PDSCH and for A-CSI RS triggering Offset(s) (see TS 38.214 [19], clause 5.3.1).","paragraph_zero_based":22729},{"literal_text_all_w_t_and_m_t":"numberOfBitsForRV-DCI-1-2","paragraph_zero_based":22730},{"literal_text_all_w_t_and_m_t":"Configures the number of bits for \"Redundancy version\" in the DCI format 1_2 (see TS 38.212 [17], clause 7.3.1 and TS 38.214 [19], clause 5.1.2.1).","paragraph_zero_based":22731},{"literal_text_all_w_t_and_m_t":"pdsch-AggregationFactor","paragraph_zero_based":22732},{"literal_text_all_w_t_and_m_t":"Number of repetitions for data (see TS 38.214 [19], clause 5.1.2.1). When the field is absent in PDSCH-Config which is not used for MBS CFR, the UE applies the value 1.","paragraph_zero_based":22733},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-EnhType3DCI-1-2","paragraph_zero_based":22734},{"literal_text_all_w_t_and_m_t":"When configured, enhanced Type 3 HARQ-ACK codebook triggering by DCI format 1_2 is enabled.","paragraph_zero_based":22735},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-EnhType3DCI-Field-1-2","paragraph_zero_based":22736},{"literal_text_all_w_t_and_m_t":"Enables the enhanced Type 3 codebook through a new DCI field to indicate the enhanced Type 3 HARQ-ACK codebook in DCI format 1_2 if the more than one enhanced Type 3 HARQ-ACK codebook is configured for the primary PUCCH cell group.","paragraph_zero_based":22737},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-OneShotFeedbackDCI-1-2","paragraph_zero_based":22738},{"literal_text_all_w_t_and_m_t":"When configured, DCI format 1_2 can request the UE to report A/N for all HARQ processes and all component carriers configured in the PUCCH group (see TS 38.212 [17], clause 7.3.1).","paragraph_zero_based":22739},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-RetxDCI-1-2","paragraph_zero_based":22740},{"literal_text_all_w_t_and_m_t":"When configured, DCI format 1_2 can request the UE to perform a HARQ-ACK re-transmission on a PUCCH resource (see TS 38.213 [13], clause 9.1.5).","paragraph_zero_based":22741},{"literal_text_all_w_t_and_m_t":"pdsch-TimeDomainAllocationList, pdsch-TimeDomainAllocationListDCI-1-2, pdsch-TimeDomainAllocationListForMultiPDSCH","paragraph_zero_based":22742},{"literal_text_all_w_t_and_m_t":"List of time-domain configurations for timing of DL assignment to DL data.","paragraph_zero_based":22743},{"literal_text_all_w_t_and_m_t":"The field pdsch-TimeDomainAllocationList (with or without suffix) applies to DCI format 1_0 and DCI format 1_1 (see table 5.1.2.1.1-1 in TS 38.214 [19]), and if the field pdsch-TimeDomainAllocationListDCI-1-2 is not configured, to DCI format 1_2. If the field pdsch-TimeDomainAllocationListDCI-1-2 is configured, it applies to DCI format 1_2 (see table 5.1.2.1.1-1A in TS 38.214 [19]). The field pdsch-TimeDomainAllocationListForMultiPDSCH applies to DCI format 1_1.","paragraph_zero_based":22744},{"literal_text_all_w_t_and_m_t":"The network does not configure the pdsch-TimeDomainAllocationList-r16 simultaneously with the pdsch-TimeDomainAllocationList (without suffix) in the same PDSCH-Config.","paragraph_zero_based":22745},{"literal_text_all_w_t_and_m_t":"prb-BundlingType, prb-BundlingTypeDCI-1-2","paragraph_zero_based":22746},{"literal_text_all_w_t_and_m_t":"Indicates the PRB bundle type and bundle size(s) (see TS 38.214 [19], clause 5.1.2.3). If dynamic is chosen, the actual bundleSizeSet1 or bundleSizeSet2 to use is indicated via DCI. Constraints on bundleSize(Set) setting depending on vrb-ToPRB-Interleaver and rbg-Size settings are described in TS 38.214 [19], clause 5.1.2.3. If a bundleSize(Set) value is absent, the UE applies the value n2. The field prb-BundlingType applies to DCI format 1_1, and the field prb-BundlingTypeDCI-1-2 applies to DCI format 1_2 (see TS 38.212 [17], clause 7.3.1 and TS 38.214 [19], clause 5.1.2.3).","paragraph_zero_based":22747},{"literal_text_all_w_t_and_m_t":"priorityIndicatorDCI-1-1, priorityIndicatorDCI-1-2, priorityIndicatorDCI-4-2","paragraph_zero_based":22748},{"literal_text_all_w_t_and_m_t":"Configure the presence of \"priority indicator\" in DCI format 1_1/1_2/4_2. When the field is absent in the IE, then 0 bit for \"priority indicator\" in DCI format 1_1/1_2/4_2. The field priorityIndicatorDCI-1-1 applies to DCI format 1_1, the field priorityIndicatorDCI-1-2 applies to DCI format 1_2 and the field priorityIndicatorDCI-4-2 applies to DCI format 4_2, respectively (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13] clause 9).","paragraph_zero_based":22749},{"literal_text_all_w_t_and_m_t":"pucch-sSCellDynDCI-1-2","paragraph_zero_based":22750},{"literal_text_all_w_t_and_m_t":"When configured, PUCCH cell switching based on dynamic indication in DCI format 1_2 is enabled (see TS 38.213 [13], clause 9.A).","paragraph_zero_based":22751}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["499b5511207dc8feacfe8193be33bc642ffe6f05f4b901ecb2bf27cae347260f","72c9d5ddb62011e704c539e289ffa10012566388b491281997420558605cf693","cad96ebc8f34d3d7092e369afe72cdf4450e5044745b6d87e236aef7900dbf2c","70fb3edb896371ee61a8fa0da81dc4333eb7356eb6a79b8724ec7494dc557773","cfc61c207fe54ced75cc553222df6d8b96e1300c4e309882c0bac9378a15132e","a5528ae5306ae2d0c84eb4734217e5e1ef51362857c402c746d73c3129ae77df","f1b3fe156303648f2072dc26b23edb21ad5c734a28729451c68b06f9afd80b1c","8bcaab13beeb15a07c1255f2bbb050789c81cc426037c3d09cbfae9302f8234a","9a1d8aebb9fc1ed7404f4d16473fc28e4f1be0d4dbe05eea048f0d3ce52fca4a","d3b7c5cb6c4afb21e2c7cc94cb49c22ec993d73201a75da2e9ba9def909d39ff","b2f5758a4da9f5da52c71f6ecd320f9742a57a3b18ac5f0bd4eb052062d4baf2","a7ea0009a578083510844a53ead668e062b8b2b8c886563688a84611ea0a114a","01fdd987a0d6270bfdebfc1cba2f72ef0f1a77b3af6c6dba181013884eef250f","1b916ba636e3e5a62601231033dd1cba52e2ae23498b7d6b0d673364958ffdb3","26815f986ed06005fc37f7d22ee84cf552be7b41e5ba7d55371d09fad20ef85b","827d8f4b4d79c7bc3c26ef5c3094c1180ece11ca233c8c46b49d28c87c1be4b7","26797e0dd84e291d0e380bb798423d7188f2daad1495a495dfbc16954fcc4968","263a2de98a62212770bb566de7ba6b31b030d5eead1c57d7e662df0164801558","a692599487889ef9491a6e4c4273ae4242b9391aed2beb6d3258727d69cc4c1a","56a04a2d56c6e58bf6cf803e56d3d67e214df96b4f9690c093d6bed797d7f48a","f7b0c1c4b2b94b1d1b12644270b90c76ce827c35c1e12ae33141ce13ac549eaa","cc1cd6e0b2775ab1c18c947652f586652818ec2b6b0d32ca743cddc78204a7f1","98e3ee9213033f2ca3938f6bbd8338961765b94961e72760e76fd8ecb8f38431","c52c3e118acc702bf5c54c5095b102b36380748e65d17dd26f9a473204450997"],"paragraph_range_zero_based":[22728,22751],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p22728"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"p-ZP-CSI-RS-ResourceSet","paragraph_zero_based":22752},{"literal_text_all_w_t_and_m_t":"A set of periodically occurring ZP-CSI-RS-Resources (the actual resources are defined in the zp-CSI-RS-ResourceToAddModList). The network uses the ZP-CSI-RS-ResourceSetId=0 for this set.","paragraph_zero_based":22753},{"literal_text_all_w_t_and_m_t":"If p-ZP-CSI-RS-ResourceSet is configured in both PDSCH-Config for MBS CFR and PDSCH-Config for the assoicated BWP, it is subject to UE capability whether the p-ZP-CSI-RS-ResourceSet configured in PDSCH-Config for MBS CFR can be different from the p-ZP-CSI-RS-ResourceSet configured in PDSCH-Config for the assoicated BWP.","paragraph_zero_based":22754},{"literal_text_all_w_t_and_m_t":"rateMatchPatternGroup1, rateMatchPatternGroup1DCI-1-2","paragraph_zero_based":22755},{"literal_text_all_w_t_and_m_t":"The IDs of a first group of RateMatchPatterns defined in PDSCH-Config->rateMatchPatternToAddModList (BWP level) or in ServingCellConfig ->rateMatchPatternToAddModList (cell level). These patterns can be activated dynamically by DCI (see TS 38.214 [19], clause 5.1.4.1). The field rateMatchPatternGroup1 applies to DCI format 1_1, and the field rateMatchPatternGroup1DCI-1-2 applies to DCI format 1_2 (see TS 38.214 [19], clause 5.1.4.1).","paragraph_zero_based":22756},{"literal_text_all_w_t_and_m_t":"rateMatchPatternGroup2, rateMatchPatternGroup2DCI-1-2","paragraph_zero_based":22757},{"literal_text_all_w_t_and_m_t":"The IDs of a second group of RateMatchPatterns defined in PDSCH-Config->rateMatchPatternToAddModList (BWP level) or in ServingCellConfig ->rateMatchPatternToAddModList (cell level). These patterns can be activated dynamically by DCI (see TS 38.214 [19], clause 5.1.4.1). The field rateMatchPatternGroup2 applies to DCI format 1_1, and the field rateMatchPatternGroup2DCI-1-2 applies to DCI format 1_2 (see TS 38.214 [19], clause 5.1.4.1).","paragraph_zero_based":22758},{"literal_text_all_w_t_and_m_t":"rateMatchPatternToAddModList","paragraph_zero_based":22759},{"literal_text_all_w_t_and_m_t":"Resources patterns which the UE should rate match PDSCH around. The UE rate matches around the union of all resources indicated in the rate match patterns (see TS 38.214 [19], clause 5.1.4.1). If a RateMatchPattern with the same RateMatchPatternId is configured in both MBS CFR and its associated BWP, the entire RateMatchPattern configuration, including the set of RBs/REs indicated by the patterns for the rate matching around, shall be the same and they are counted as a single rate match pattern in the total configured rate match patterns as defined in TS 38.214 [19].","paragraph_zero_based":22760},{"literal_text_all_w_t_and_m_t":"rbg-Size","paragraph_zero_based":22761},{"literal_text_all_w_t_and_m_t":"Selection between config 1 and config 2 for RBG size for PDSCH. The UE ignores this field if resourceAllocation is set to resourceAllocationType1 (see TS 38.214 [19], clause 5.1.2.2.1).","paragraph_zero_based":22762},{"literal_text_all_w_t_and_m_t":"referenceOfSLIVDCI-1-2","paragraph_zero_based":22763},{"literal_text_all_w_t_and_m_t":"Enable using the starting symbol of the PDCCH monitoring occasion in which the DL assignment is detected as the reference of the SLIV for DCI format 1_2. When the RRC parameter enables the utilization of the new reference, the new reference is applied for TDRA entries with K0=0. For other entries (if any) in the same TDRA table, the reference is slot boundary as in Rel-15. PDSCH mapping type A is not supported with the new reference. The new reference of SLIV is not configured for a serving cell configured to be scheduled by cross-carrier scheduling on a scheduling cell with different numerology (see TS 38.212 [17] clause 7.3.1 and TS 38.214 [19] clause 5.1.2.1).","paragraph_zero_based":22764},{"literal_text_all_w_t_and_m_t":"repetitionSchemeConfig","paragraph_zero_based":22765},{"literal_text_all_w_t_and_m_t":"Configure the UE with repetition schemes. The network does not configure repetitionSchemeConfig-r16 and repetitionSchemeConfig-v1630 simultaneously to setup in the same PDSCH-Config. The network does not configure this parameter and sfnSchemePDSCH in MIMOParam-r17 simultaneously in the same serving cell.","paragraph_zero_based":22766},{"literal_text_all_w_t_and_m_t":"resourceAllocation, resourceAllocationDCI-1-2","paragraph_zero_based":22767},{"literal_text_all_w_t_and_m_t":"Configuration of resource allocation type 0 and resource allocation type 1 for non-fallback DCI (see TS 38.214 [19], clause 5.1.2.2). The field resourceAllocation applies to DCI format 1_1, and the field resourceAllocationDCI-1-2 applies to DCI format 1_2 (see TS 38.214 [19], clause 5.1.2.2).","paragraph_zero_based":22768},{"literal_text_all_w_t_and_m_t":"resourceAllocationType1GranularityDCI-1-2","paragraph_zero_based":22769},{"literal_text_all_w_t_and_m_t":"Configure the scheduling granularity applicable for both the starting point and length indication for resource allocation type 1 in DCI format 1_2. If this field is absent, the granularity is 1 PRB (see TS 38.214 [19], clause 5.1.2.2.2).","paragraph_zero_based":22770},{"literal_text_all_w_t_and_m_t":"sizeDCI-4-2","paragraph_zero_based":22771},{"literal_text_all_w_t_and_m_t":"Indicates the size of DCI format 4-2 (see TS 38.213 [13], clause 10.1).","paragraph_zero_based":22772},{"literal_text_all_w_t_and_m_t":"sp-ZP-CSI-RS-ResourceSetsToAddModList","paragraph_zero_based":22773},{"literal_text_all_w_t_and_m_t":"AddMod/Release lists for configuring semi-persistent zero-power CSI-RS resource sets. Each set contains a ZP-CSI-RS-ResourceSetId and the IDs of one or more ZP-CSI-RS-Resources (the actual resources are defined in the zp-CSI-RS-ResourceToAddModList) (see TS 38.214 [19], clause 5.1.4.2).","paragraph_zero_based":22774},{"literal_text_all_w_t_and_m_t":"tci-StatesToAddModList","paragraph_zero_based":22775}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["fb09af1f53bbfdb4aa5e40df4827898b30bc72040e78e51fc99500008996253a","11519b75621264e6072ffc07c9273d3b4544afa214f5e0ee68928141a09c2d0a","050daf125c979a0edc050d714b4dff5e30fc75296cbffa2010d9ae62adafb550","80ca713ff113127856612985dd5fd4cc9f98376b6325b5652dc6a48649b968dc","539c1f341411acac6664eb2558e6d0a1de129c04608e8577051d4bfdb081bc6e","ba752e955352aab8bde1a71216c508106c5d9935f368e50e8c07ddfe5955b820","2a2a8ce7497c127121448d8d0e94f3746d05e5104a0fad42f444223347f17edb","58627f63805166816878ce9f8e116db572627e95b62150dee221b2e7f78ce918","8fb4c5e8f2659d0992e652fe1cb6bb359f8177455b8952a802119266cad353d9","b7f03b5db2b633045de8e5a3ca3b79fc9867d1be3368964a70a455dcaae44ed9","985cbf3c80bd14a3fe5806b7d31c5ee6d72205ca5eec526ac4ce677ac7fb2325","87a5dc33924400f8dd3950855d78ff8ce7c11a5dea5e0e4ade44640547606250","06560d73ae520aaf04a7b41fc6343552068f5b4ac48598eccd86076b031b8989","033bd47b6c7e9637f41f3821bb0f37a18305ebcfacad0c8c6ad387793f3ad594","c04cec56cb23a9257de24a5ece0364ddb4adfb8457ffa157ce4438fbb55421c9","7e4fbef5a96e944d5799882340f074e923b4e74323c70ac686d75151cbd81674","dbb78d1d3fa1dd94f07e89c7913d00ee6467ee959bdad1d1af56af16815a8877","ef82ecd19601bbd695200d5469e69b58978275e2ec5f4182060c2af502a20570","c4f164aa624466f02df98d055f2a491db960ef495aa4a22026f50f83f158c152","72af95311037600ce29d20632a6f01d1727ef846bab52d96c144f3e7ee83ef82","aae9ff88b292776b0d212cae5ef6bb1400c88ce8140f0450e60bd8e843a394f5","b16f7333242cb017d7317f6d897f6597daceca7c76b56c4940c881569e04e22a","ded7f423e9b7cff3b0ab4828d5f9a6d68187a2e0d2cd4cb4d74220e74ffd162d","fab6e6650afafd3b37b1176968e67b687678a896a6a1bf0af5e980497b32f918"],"paragraph_range_zero_based":[22752,22775],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p22752"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"A list of Transmission Configuration Indicator (TCI) states indicating a transmission configuration which includes QCL-relationships between the DL RSs in one RS set and the PDSCH DMRS ports (see TS 38.214 [19], clause 5.1.5). If unifiedTCI-StateType is configured for the serving cell, no element in this list is configured.","paragraph_zero_based":22776},{"literal_text_all_w_t_and_m_t":"unifiedTCI-StateRef","paragraph_zero_based":22777},{"literal_text_all_w_t_and_m_t":"Provides the serving cell and BWP where the configuration for dl-OrJointTCI-StateToAddModList-r17 are defined. When this field is present, dl-OrJointTCI-StateToAddModList and dl-OrJointTCI-StateToReleaseList are not present. The value of unifiedTCI-StateType of current serving cell is the same in the serving cell indicated by unifiedTCI-StateRef.","paragraph_zero_based":22778},{"literal_text_all_w_t_and_m_t":"vrb-ToPRB-Interleaver, vrb-ToPRB-InterleaverDCI-1-2","paragraph_zero_based":22779},{"literal_text_all_w_t_and_m_t":"Interleaving unit configurable between 2 and 4 PRBs (see TS 38.211 [16], clause 7.3.1.6). When the field is absent, the UE performs non-interleaved VRB-to-PRB mapping.","paragraph_zero_based":22780},{"literal_text_all_w_t_and_m_t":"xOverheadMulticast","paragraph_zero_based":22781},{"literal_text_all_w_t_and_m_t":"Accounts for an overhead from CSI-RS, CORESET etc. If the field is absent, the UE applies value xOh0 (see TS 38.214 [19]).","paragraph_zero_based":22782},{"literal_text_all_w_t_and_m_t":"zp-CSI-RS-ResourceToAddModList","paragraph_zero_based":22783},{"literal_text_all_w_t_and_m_t":"A list of Zero-Power (ZP) CSI-RS resources used for PDSCH rate-matching. Each resource in this list may be referred to from only one type of resource set, i.e., aperiodic, semi-persistent or periodic (see TS 38.214 [19]).","paragraph_zero_based":22784},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22785},{"literal_text_all_w_t_and_m_t":"–PDSCH-ConfigCommon","paragraph_zero_based":22786},{"literal_text_all_w_t_and_m_t":"The IE PDSCH-ConfigCommon is used to configure cell specific PDSCH parameters.","paragraph_zero_based":22787},{"literal_text_all_w_t_and_m_t":"PDSCH-ConfigCommon information element","paragraph_zero_based":22788},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":22789},{"literal_text_all_w_t_and_m_t":"-- TAG-PDSCH-CONFIGCOMMON-START","paragraph_zero_based":22790},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22791},{"literal_text_all_w_t_and_m_t":"PDSCH-ConfigCommon ::=                  SEQUENCE {","paragraph_zero_based":22792},{"literal_text_all_w_t_and_m_t":"    pdsch-TimeDomainAllocationList                  PDSCH-TimeDomainResourceAllocationList          OPTIONAL,   -- Need R","paragraph_zero_based":22793},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":22794},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22795},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22796},{"literal_text_all_w_t_and_m_t":"-- TAG-PDSCH-CONFIGCOMMON-STOP","paragraph_zero_based":22797},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":22798},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22799}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["a2f3b4bb0e719522ea91cc8fd5b9835d401d65e21fe7a8d867fddb20f8f02f6c","b15477f0eac152bb1dc59acfc747c02c9b593f139c42ec76f8645f9eb182be75","f07b33a7c2d27ff4bcadc5ef24808bcffea6aae0bfb1bae974d8d8937cf985d8","1d4901f30d79bf672d85f591683588fd05f776fd7117af826f285e9b0ade1729","59ef3f9569d415cd005441f4b351948b9ec423972eab4df9d02cc78db7855f35","45ceb75a4288d7f15f82700aa57f90d9e5ff65439fbaf89559d55c5d2c3ce581","e4e795804e37dc2c606b91de59b67ba6668a64ff8d38012ea1a4cc30afb820af","58c110c57538250c0f498294761bf6f7dac1ab4013bff7516cf2d92c2db6671f","910a306a4b50f97cd60b813968b9d82925a3099c11aa2e66dc9a29d4d7d2de81","ff412564022ae8b5b70fbacc3f4639f19c51f64aaaccde04f844679d6c29b3c2","03dcb4b4af5cbcbbda5defcc87274a7f4e8c19c9569be97f049693a47693bd26","91e1250caf052843b51845307b016274f3fe3509fbe9324bd5b8b96313f970d4","a7ffc168ba0653682b8fabe407edaa3bbf94068e9a168bcfe98e2c82e90ba4d5","6eb07e6d1eb6aed8b09aa0807f2a86011415dd566126e9e0a56bddb3a8b1fdc3","288696d86e0759346d00ab284b6393e57864b34cb2ecc31c56e7cdcc4f751734","06c3760d69d83be1fb699a79f35975bf14bd95d71b104b4a38504850b336a5d7","ba50f3c2e3503d3be3d7249c93d2b60960bd76465a7980ccfa4242c02fb3ae7a","dea1644562ff8d2a8da86c71e06c296c523bf4b5d403b8bb374a5ff9c8c9eec7","85618368ba4b206e9f7da95244eb1fad286a8dd0df32d0e7cbf8a98f4902f4e4","9ff5a72f3ffadc9c3f1fc8c7e9a3015a11bea399703d419133d6cdc71d7aa477","d0a2b05ec8c8bd10c880606d8c077f681670d192254730b13cd05f6927eb0ee1","a311cc7a71571194f23478a5156997d29b6c6d1cdbb36330e0cb237e01020158","95e9b262be513e24e886e9c7b8fcb4d55a92d2cb3eecbbdee1cb70396abb25cb","540ca187646bb6a21f1db0e7cd5ad9c4ab657ad56d51748222997cd7c94a8b0f"],"paragraph_range_zero_based":[22776,22799],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p22776"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"PDSCH-ConfigCommon field descriptions","paragraph_zero_based":22800},{"literal_text_all_w_t_and_m_t":"pdsch-TimeDomainAllocationList","paragraph_zero_based":22801},{"literal_text_all_w_t_and_m_t":"List of time-domain configurations for timing of DL assignment to DL data (see table 5.1.2.1.1-1 in TS 38.214 [19]).","paragraph_zero_based":22802},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22803},{"literal_text_all_w_t_and_m_t":"–PDSCH-ServingCellConfig","paragraph_zero_based":22804},{"literal_text_all_w_t_and_m_t":"The IE PDSCH-ServingCellConfig is used to configure UE specific PDSCH parameters that are common across the UE's BWPs of one serving cell.","paragraph_zero_based":22805},{"literal_text_all_w_t_and_m_t":"PDSCH-ServingCellConfig information element","paragraph_zero_based":22806},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":22807},{"literal_text_all_w_t_and_m_t":"-- TAG-PDSCH-SERVINGCELLCONFIG-START","paragraph_zero_based":22808},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22809},{"literal_text_all_w_t_and_m_t":"PDSCH-ServingCellConfig ::=             SEQUENCE {","paragraph_zero_based":22810},{"literal_text_all_w_t_and_m_t":"    codeBlockGroupTransmission              SetupRelease { PDSCH-CodeBlockGroupTransmission }              OPTIONAL,   -- Need M","paragraph_zero_based":22811},{"literal_text_all_w_t_and_m_t":"    xOverhead                               ENUMERATED { xOh6, xOh12, xOh18 }                              OPTIONAL,   -- Need S","paragraph_zero_based":22812},{"literal_text_all_w_t_and_m_t":"    nrofHARQ-ProcessesForPDSCH              ENUMERATED {n2, n4, n6, n10, n12, n16}                         OPTIONAL,   -- Need S","paragraph_zero_based":22813},{"literal_text_all_w_t_and_m_t":"    pucch-Cell                              ServCellIndex                                                  OPTIONAL,   -- Cond SCellAddOnly","paragraph_zero_based":22814},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":22815},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":22816},{"literal_text_all_w_t_and_m_t":"    maxMIMO-Layers                          INTEGER (1..8)                                                 OPTIONAL,   -- Need M","paragraph_zero_based":22817},{"literal_text_all_w_t_and_m_t":"    processingType2Enabled                  BOOLEAN                                                        OPTIONAL    -- Need M","paragraph_zero_based":22818},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":22819},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":22820},{"literal_text_all_w_t_and_m_t":"    pdsch-CodeBlockGroupTransmissionList-r16 SetupRelease { PDSCH-CodeBlockGroupTransmissionList-r16 }     OPTIONAL    -- Need M","paragraph_zero_based":22821},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":22822},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":22823}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["5c51b0ad54c9348e88477d51bfc705137000d3e3deb73b5845295cf105c54adc","bdcd5a6d7ae0ef7f199bc422fe29411b4be55775f0b4116dc2aaf41cdf1fa059","f4224fb80f2982696bfe32eafa29d169f38d6ab64e37d4a49cce2a3d971f069d","e8ca1f6a9622c51e8261a4fa691f38d88a378aa891bff70a980cfcde0701f555","1698a2c946df62ef35b6236002ab9fd7a1dee1dfaa6af6b41e755467ede55809","1df063af824c83b1bcc8088d03fdb5d70270ac646a09265271c6f4fb07dbdd8a","f250f2fc47670eb0626b0f51267a164a9f44e0b6806e9e33dd304cce44f825d8","f9b0e32613ab100503426e2f5f9f88d962e3a4f31b668fac8afed036847a238c","ab5f5e3bfac76bff5d6ba067afeb55e013cf4dc271e1b10a2cd194fe57773fb3","532fa4d7e836b5ffb6d33b9b6ae11c15c5a8ccfd8412198749c62b079889c8eb","b55346b97265b7413dc6752750b198305c53887cfb223cfdbc3843f46bb2e8e1","40cf84de3666161f9c36f215b120885ef5ace27b07cadf69b82679e469f6e57d","431cac1b12ae469f057ac7d5c2ed2576e52d9aa5a9acb3be974ba1575a07f711","f9374f9504d5b837d72c51a7f020e1a96af90f3a4a6f4d737abaa7fac9ba532c","847848d99bbf4bee154c3a46b6ac8a1d08cdaa8825774e36fe92e24ff4f0d751","5757185af7531719bab8df597e367adadfdbdb782c323b9c9cec3a88f2bc0cff","cc63e6365b08bb121404f2683af0216ec88b6dc9d6266693fb7095bf6a93cc02","8417ae066c28527b6d88b22f20a15be0b1a2eec963a4998813aedd2a04644d82","84673058684983c46a69c80b7cde154f222f79de4e7a404cc3fd8ee97c51d7ee","b7255af6edbb254857632f819492187627395a7b4771bdc2375df4550362f151","7de87ee2c24a1c507e8e16e4ef2044df527433f0ea9b376db2d4eafde9b8ce97","d87d9652e1c1ad6a041497d10e1f8747be5e120f93fa83529aefeebe780e3688","436449b6c1654c330470bf52a8f2ac0d7a13e3bc978e49e7c10a3c491ad175d9","5ae18a0ecd3cbb4e6d66d451a84bcab4c0dd797f09393b28ebc292ffa6b77dd9"],"paragraph_range_zero_based":[22800,22823],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p22800"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    downlinkHARQ-FeedbackDisabled-r17       SetupRelease { DownlinkHARQ-FeedbackDisabled-r17 }              OPTIONAL,   -- Need M","paragraph_zero_based":22824},{"literal_text_all_w_t_and_m_t":"    nrofHARQ-ProcessesForPDSCH-v1700        ENUMERATED {n32}                                               OPTIONAL    -- Need R","paragraph_zero_based":22825},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":22826},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22827},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22828},{"literal_text_all_w_t_and_m_t":"PDSCH-CodeBlockGroupTransmission ::=    SEQUENCE {","paragraph_zero_based":22829},{"literal_text_all_w_t_and_m_t":"    maxCodeBlockGroupsPerTransportBlock     ENUMERATED {n2, n4, n6, n8},","paragraph_zero_based":22830},{"literal_text_all_w_t_and_m_t":"    codeBlockGroupFlushIndicator            BOOLEAN,","paragraph_zero_based":22831},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":22832},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22833},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22834},{"literal_text_all_w_t_and_m_t":"PDSCH-CodeBlockGroupTransmissionList-r16 ::=    SEQUENCE (SIZE (1..2)) OF PDSCH-CodeBlockGroupTransmission","paragraph_zero_based":22835},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22836},{"literal_text_all_w_t_and_m_t":"DownlinkHARQ-FeedbackDisabled-r17 ::= BIT STRING (SIZE (32))","paragraph_zero_based":22837},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22838},{"literal_text_all_w_t_and_m_t":"-- TAG-PDSCH-SERVINGCELLCONFIG-STOP","paragraph_zero_based":22839},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":22840},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22841},{"literal_text_all_w_t_and_m_t":"PDSCH-CodeBlockGroupTransmission field descriptions","paragraph_zero_based":22842},{"literal_text_all_w_t_and_m_t":"codeBlockGroupFlushIndicator","paragraph_zero_based":22843},{"literal_text_all_w_t_and_m_t":"Indicates whether CBGFI for CBG based (re)transmission in DL is enabled (true). (see TS 38.212 [17], clause 7.3.1.2.2).","paragraph_zero_based":22844},{"literal_text_all_w_t_and_m_t":"maxCodeBlockGroupsPerTransportBlock","paragraph_zero_based":22845},{"literal_text_all_w_t_and_m_t":"Maximum number of code-block-groups (CBGs) per TB. In case of multiple CW, the maximum CBG is 4 (see TS 38.213 [13], clause 9.1.1).","paragraph_zero_based":22846},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22847}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["c581f37dd4c16028e309fe196d253241002be8db05d712f370815454599118cf","ec8d96cec76b532b7fc40f2e6a3b7bc4329936c4d7f263ddfc96b04cf80d1732","2ea6e5036311fe057104a4b8f32977be75d765debb67a6f054beacf506fa308d","23ce0416a84981ab3c819e6622d1ffbe0f70124226a1b936c86b606e32ebef4c","251dd48fbcd86f994a6b32b365fa5346c54dba0d743612d758f913f856ec0652","c494542c8736b456e4c0b25733f652298459cc5a8a0186c9ccbe6a198442aa0b","173b080226597d66a34f994f02884da08ad3a68ed7eb3af271a196a7367725bb","50e866286845b3a9778aee30e1238fe8f190715553bd1f5963b775e170474270","18f357c36caadbc2776181dabff3b1d7aff73797decac047774e26a5606b58d6","611936d9063a40d8856e2af260d7897bb25bf5d0cab899394be42e9568aaaf04","4e73fbbad3597a28e5bdd1b65400ebcb5468692f68eaa627150606729fae8386","a7bdcd16aa3b11be2cadd1abc91857832e8f11c2b7ee247a3184ddb79b7c31ac","d38a271b33d857988e5cc79607f93ae8bbb0d7cbd1e5b40a47633d0c7df5c804","783081ba5990382acce57c538abd26dfebf7e31ed850564e000ef72e4cda2bc4","8fb64baf55db61b98365c149a96b11a83a9b4b0c52ffba46a263e7c248be3f42","75ae5848f11b101ba61c0452551ee5ddd331cf72221e9d65ade4c01dfc431659","d362607eaba9e0bccc739dd488201b87143462181b098c00fb2684400dde8230","8667369dd09ae45684d3fd82444ff644965fab62dac6a7f6ae1ed968fd7f83c4","2e3173d6063223f65d0132b41b356afc1242aca6e012d917fb7250c5a47461bd","c90b1d8496031c38c691df49b7c3b6e547cf6d40036281fdd2d86e2b9a09b089","57295b84c8037408813f3b0480ce22d315e3807215a037375f029861a5a31bed","ab50dd86cc3a637a80334500ea7fa29f514f923e99c46eed4af5c01a440b4d9d","c4ee371827653f800d42eed8a76308cb240631da89654577d323e748fa216f70","dfe0f72b0e24ebebc5b6681f566c6fb721b31f9278eaa36dd0916521957b42a7"],"paragraph_range_zero_based":[22824,22847],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p22824"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"PDSCH-ServingCellConfig field descriptions","paragraph_zero_based":22848},{"literal_text_all_w_t_and_m_t":"codeBlockGroupTransmission","paragraph_zero_based":22849},{"literal_text_all_w_t_and_m_t":"Enables and configures code-block-group (CBG) based transmission (see TS 38.213 [13], clause 9.1.1). Network does not configure for a UE both spatial bundling of HARQ ACKs and codeBlockGroupTransmission within the same cell group.","paragraph_zero_based":22850},{"literal_text_all_w_t_and_m_t":"The network does not configure this field if - the SCS of at least one DL BWP configured in the cell is 480 or 960 kHz - Type-1 HARQ-ACK codebook is configured and pdsch-TimeDomainAllocationListForMultiPDSCH-r17 for this serving cell contains pdsch-AllocationList with multiple entries (multiple PDSCH) - Type-2 HARQ-ACK codebook is configured and pdsch-TimeDomainAllocationListForMultiPDSCH-r17 for any cell in the same PUCCH cell group associated with this serving cell contains pdsch-AllocationList with multiple entries (multiple PDSCH)","paragraph_zero_based":22851},{"literal_text_all_w_t_and_m_t":"downlinkHARQ-FeedbackDisabled","paragraph_zero_based":22852},{"literal_text_all_w_t_and_m_t":"Used to disable the DL HARQ feedback, sent in the uplink, per HARQ process ID. The first/leftmost bit corresponds to HARQ process ID 0, the next bit to HARQ process ID 1 and so on. Bits corresponding to HARQ process IDs that are not configured shall be ignored. The bit(s) set to one identify HARQ processes with disabled DL HARQ feedback and the bit(s) set to zero identify HARQ processes with enabled DL HARQ feedback.","paragraph_zero_based":22853},{"literal_text_all_w_t_and_m_t":"maxMIMO-Layers","paragraph_zero_based":22854},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of MIMO layers to be used for PDSCH in all BWPs of this serving cell. (see TS 38.212 [17], clause 5.4.2.1).","paragraph_zero_based":22855},{"literal_text_all_w_t_and_m_t":"nrofHARQ-ProcessesForPDSCH","paragraph_zero_based":22856},{"literal_text_all_w_t_and_m_t":"The number of HARQ processes to be used on the PDSCH of a serving cell. Value n2 corresponds to 2 HARQ processes, value n4 to 4 HARQ processes, and so on. If both nrofHARQ-ProcessesForPDSCH and nrofHARQ-ProcessesForPDSCH-v1700 are absent, the UE uses 8 HARQ processes (see TS 38.214 [19], clause 5.1).","paragraph_zero_based":22857},{"literal_text_all_w_t_and_m_t":"pdsch-CodeBlockGroupTransmissionList","paragraph_zero_based":22858},{"literal_text_all_w_t_and_m_t":"A list of configurations for up to two simultaneously constructed HARQ-ACK codebooks (see TS 38.213 [13], clause 9.3).","paragraph_zero_based":22859},{"literal_text_all_w_t_and_m_t":"processingType2Enabled","paragraph_zero_based":22860},{"literal_text_all_w_t_and_m_t":"Enables configuration of advanced processing time capability 2 for PDSCH (see 38.214 [19], clause 5.3).","paragraph_zero_based":22861},{"literal_text_all_w_t_and_m_t":"pucch-Cell","paragraph_zero_based":22862},{"literal_text_all_w_t_and_m_t":"The ID of the serving cell (of the same cell group) to use for PUCCH. If the field is absent, the UE sends the HARQ feedback on the PUCCH of the SpCell of this cell group, or on this serving cell if it is a PUCCH SCell.","paragraph_zero_based":22863},{"literal_text_all_w_t_and_m_t":"xOverhead","paragraph_zero_based":22864},{"literal_text_all_w_t_and_m_t":"Accounts for overhead from CSI-RS, CORESET, etc. If the field is absent, the UE applies value xOh0 (see TS 38.214 [19], clause 5.1.3.2).","paragraph_zero_based":22865},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22866},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":22867},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":22868},{"literal_text_all_w_t_and_m_t":"SCellAddOnly","paragraph_zero_based":22869},{"literal_text_all_w_t_and_m_t":"It is optionally present, Need S, for (non-PUCCH) SCells when adding a new SCell. The field is absent, Need M, when reconfiguring SCells. The field is also absent for the SpCells as well as for a PUCCH SCell.","paragraph_zero_based":22870},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22871}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["ec668d1cc2a781e4a1091846714cf4592685241e231f96d490a3fcef03fc2c9f","4cbde21aa557a567bef75089ed37ef12af4df7f23bb06e965abd739ef641ff01","1ddcd8e8346fdfafe2355b60106235ecfdb591b150068e6b8d8e3175646ff996","c2141aeb2f5731fdd039fe82574dc52ceb42f79b631379ad3114ada768ff4fd9","78dcb5e1e0c3cda65b7e53efdc4c1f9d3066d394e7ad28c5c1f7ef3a3242c24d","c701a72a7013c3db851769cd38345df279ff9755cfadc2fc9e6bcd84ef83c108","cbf8bac6d007ccdd719ab6e85076e7ebfffb73c09c6cea0afd4943b96a8803f0","484269a311a8a9fa95d202cbf3c8fe1d7f059ddd68e7d1adc62fefcaf95b8a55","30dfff38d98700b43cf66f099027b2d43daeb58b9a7221e1b35f4dba21e81fed","5d532b234379d192ed0385fcdfaf85a093bd470f199a8cdda0ff79793d97ec94","2b50c7bd7bb56757e83225f77814f4227eb5bbfc471ed2550ca1bdf8b75fe33f","1e4c1b4ff8cd82bd7c4bc7dea29ee6f284fa423a521f4cb43cf9959d1952371c","d78ed53e3bf9ad142cb3109fc9850ccfa4ac9d2708238302aa4b152b5e6762c6","460a58b9ee4d7eba24c8d0dfa0b7b4a55747fef22e03bef3ff112fc25c407c5a","d5b435c548ae921fb299df577efe316e5d4b01ff98f0e05c4e69252f649e979a","4f54fc0594fdd58b05c38cca52923d128db69dc332b3a6ca6f37f815e5f0d3ac","f05b133cf1e1083e8c7ddfd103d7aa8243c0a24d89c4402f7483749086a980b4","2cf79da7cf73fd4c62480829f45f2485ea082969b702f03257a5a9d822cbb8a5","da88b95b808ed78b782ed101303767e4393bfe0e54794be6ec9d7877873f22dd","9b701ffa30ae9bdd45f90b24854ecc7b27042351273c3154d029c4854a83e5ef","a4521571e1b404c64af11e4629446ff61f31943faa981e7ca4312648edf43c98","3d7ac4a491891aa295bf7b19201a4a1f99c6f0bf1b99814205df12498cee3db6","b80d4a936e0a0d997c599416aa9537a020999e20c0694d782ac3dd987e8aee47","0dc1226c790094d706d9d8630d26e798ce737ede0aeb01c539331d7f62effaad"],"paragraph_range_zero_based":[22848,22871],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p22848"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–PDSCH-TimeDomainResourceAllocationList","paragraph_zero_based":22872},{"literal_text_all_w_t_and_m_t":"The IE PDSCH-TimeDomainResourceAllocation is used to configure a time domain relation between PDCCH and PDSCH. The PDSCH-TimeDomainResourceAllocationList contains one or more of such PDSCH-TimeDomainResourceAllocations. The network indicates in the DL assignment which of the configured time domain allocations the UE shall apply for that DL assignment. The UE determines the bit width of the DCI field based on the number of entries in the PDSCH-TimeDomainResourceAllocationList. Value 0 in the DCI field refers to the first element in this list, value 1 in the DCI field refers to the second element in this list, and so on.","paragraph_zero_based":22873},{"literal_text_all_w_t_and_m_t":"PDSCH-TimeDomainResourceAllocationList information element","paragraph_zero_based":22874},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":22875},{"literal_text_all_w_t_and_m_t":"-- TAG-PDSCH-TIMEDOMAINRESOURCEALLOCATIONLIST-START","paragraph_zero_based":22876},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22877},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22878},{"literal_text_all_w_t_and_m_t":"PDSCH-TimeDomainResourceAllocationList ::=  SEQUENCE (SIZE(1..maxNrofDL-Allocations)) OF PDSCH-TimeDomainResourceAllocation","paragraph_zero_based":22879},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22880},{"literal_text_all_w_t_and_m_t":"PDSCH-TimeDomainResourceAllocation ::=   SEQUENCE {","paragraph_zero_based":22881},{"literal_text_all_w_t_and_m_t":"    k0                                      INTEGER(0..32)                                                  OPTIONAL,   -- Need S","paragraph_zero_based":22882},{"literal_text_all_w_t_and_m_t":"    mappingType                             ENUMERATED {typeA, typeB},","paragraph_zero_based":22883},{"literal_text_all_w_t_and_m_t":"    startSymbolAndLength                    INTEGER (0..127)","paragraph_zero_based":22884},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22885},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22886},{"literal_text_all_w_t_and_m_t":"PDSCH-TimeDomainResourceAllocationList-r16 ::=  SEQUENCE (SIZE(1..maxNrofDL-Allocations)) OF PDSCH-TimeDomainResourceAllocation-r16","paragraph_zero_based":22887},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22888},{"literal_text_all_w_t_and_m_t":"PDSCH-TimeDomainResourceAllocation-r16 ::=  SEQUENCE {","paragraph_zero_based":22889},{"literal_text_all_w_t_and_m_t":"    k0-r16                                     INTEGER(0..32)                                              OPTIONAL,   -- Need S","paragraph_zero_based":22890},{"literal_text_all_w_t_and_m_t":"    mappingType-r16                            ENUMERATED {typeA, typeB},","paragraph_zero_based":22891},{"literal_text_all_w_t_and_m_t":"    startSymbolAndLength-r16                   INTEGER (0..127),","paragraph_zero_based":22892},{"literal_text_all_w_t_and_m_t":"    repetitionNumber-r16                       ENUMERATED {n2, n3, n4, n5, n6, n7, n8, n16} OPTIONAL, -- Cond Formats1-0_1-1_4-0_4-1_4-2","paragraph_zero_based":22893},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":22894},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":22895}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["0d17f826ac3217783418dbcef7c14cf2ed2df06d3a81d549f1441b7733e71bd7","8cd4756dea1a09d54949a5162b832fbcbd437d