-RRC-CR.docx:p15048"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    dl-PPW-PreConfigToReleaseList-r17   DL-PPW-PreConfigToReleaseList-r17                                 OPTIONAL,   -- Need N","paragraph_zero_based":15072},{"literal_text_all_w_t_and_m_t":"    nonCellDefiningSSB-r17              NonCellDefiningSSB-r17                                            OPTIONAL,   -- Need R","paragraph_zero_based":15073},{"literal_text_all_w_t_and_m_t":"    servingCellMO-r17                   MeasObjectId                                                  OPTIONAL -- Cond MeasObject-NCD-SSB","paragraph_zero_based":15074},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":15075},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":15076},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15077},{"literal_text_all_w_t_and_m_t":"SPS-ConfigToAddModList-r16 ::=          SEQUENCE (SIZE (1..maxNrofSPS-Config-r16)) OF SPS-Config","paragraph_zero_based":15078},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15079},{"literal_text_all_w_t_and_m_t":"SPS-ConfigToReleaseList-r16 ::=         SEQUENCE (SIZE (1..maxNrofSPS-Config-r16)) OF SPS-ConfigIndex-r16","paragraph_zero_based":15080},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15081},{"literal_text_all_w_t_and_m_t":"SPS-ConfigDeactivationState-r16 ::=     SEQUENCE (SIZE (1..maxNrofSPS-Config-r16)) OF SPS-ConfigIndex-r16","paragraph_zero_based":15082},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15083},{"literal_text_all_w_t_and_m_t":"SPS-ConfigDeactivationStateList-r16 ::= SEQUENCE (SIZE (1..maxNrofSPS-DeactivationState)) OF SPS-ConfigDeactivationState-r16","paragraph_zero_based":15084},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15085},{"literal_text_all_w_t_and_m_t":"DL-PPW-PreConfigToAddModList-r17 ::=    SEQUENCE (SIZE (1..maxNrofPPW-Config-r17)) OF DL-PPW-PreConfig-r17","paragraph_zero_based":15086},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15087},{"literal_text_all_w_t_and_m_t":"DL-PPW-PreConfigToReleaseList-r17 ::=   SEQUENCE (SIZE (1..maxNrofPPW-Config-r17)) OF DL-PPW-ID-r17","paragraph_zero_based":15088},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15089},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-DOWNLINKDEDICATED-STOP","paragraph_zero_based":15090},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":15091},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15092},{"literal_text_all_w_t_and_m_t":"BWP-DownlinkDedicated field descriptions","paragraph_zero_based":15093},{"literal_text_all_w_t_and_m_t":"beamFailureRecoverySCellConfig","paragraph_zero_based":15094},{"literal_text_all_w_t_and_m_t":"Configuration of candidate RS for beam failure recovery on SCells.","paragraph_zero_based":15095}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["2b5a7b780df3abc67a5f813e54710612c48ed44d91bc69a0529b57826386e1ce","f2675d2391076bedbd01f8425b8dc2fb07297128f45a551228535f6e2fa221d4","1f4023ffed25cf84d9c6ba86c71a97a171838ab6a3b5e331611fcc7a6e902e7f","e02ee2c7b023e2904b6030fe35d250d94622878f3d4bcd6e61040f724e608b54","3be621656b3945dbc235525cf5932c68b464bb78c5d289f718d8c893b25ebd03","139a5037501b259bef2c095fafefa4029d63487de886d93f1f6b8567fd325c78","44ed6b024667ba99452e4360adb673ecb03ba31000a45ca4b7f2adfb57e0368d","b8c10884379bf6d34e9daf449a388db14b7fb1f27d7cbc6d4fc80196d57ec46a","54368800c47f75358cb119966464cf1ac44e4a6ee12de76201d2dae303ded233","a1ece7748f38f4319ef96c8d835becb83e1b551b5ffb70876052d0321c960ee1","ff6dc15372db2411efdcd00306ce8730cabe7c9c5103d000e7b9956c1a257875","4cecc9a63acdee0bca340b0e68bd2974b2b47a74127d4254db6dc5da4843bc8f","f09249f8e1e62250fb31097e51828892af3fbd6503f5922eb87a465d1730569a","cc692c57bea58376c779e6e4b118b898557829b6b2d2fde496efb41c0e6cd99d","4185e6fb4095fb2922e4a032e0fd3b33ac926cdfa4f389e96f655c14b7938ffa","db981432bc991e17f485a3de6cecb9687e2590c1d1f87bd6b10f48780369b186","64e07e49b4e3c92f57dc75e67975b965fdb2a0e61ae9aadf2da92d4a277346ab","fbe298fbfa94fb424126133e004703ba17f76f7765d01867b9eceaf851736bd8","789b6cf941595fa27244114b0e11c221c852348ceafa50b2a48467c550289ad8","4f5748f3b90e08bb542eb26a58c87549aba0a2727c2c7dabd169343421c73414","59b57a279f37e0e3d8691ecdcdc2cfed992f4cac7a8e3e418086b0e7a9321799","4ba12b21a72344befeb1f537079f2d12c3fa8857bdf06721ee3e56ac124c7e33","5ffad77b6d5c0b9b2bb952f1d1e4f3262755701d5d149d36ee87d03caf6ac2ca","e6d3cd27c5ec4602967528f5d10b049123e2b6f70e4069222144010b79e7b00a"],"paragraph_range_zero_based":[15072,15095],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p15072"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"beamFailureRecoverySpCellConfig","paragraph_zero_based":15096},{"literal_text_all_w_t_and_m_t":"Configuration of candidate RS for beam failure recovery on the SpCell. This field can only be configured when beamFailure-r17 is configured in RadioLinkMonitoringConfig.","paragraph_zero_based":15097},{"literal_text_all_w_t_and_m_t":"cfr-ConfigMulticast","paragraph_zero_based":15098},{"literal_text_all_w_t_and_m_t":"UE specific common frequency resource configuration for MBS multicast for one dedicated BWP. This field can be configured within at most one serving cell.","paragraph_zero_based":15099},{"literal_text_all_w_t_and_m_t":"dl-PPW-PreConfigToAddModList","paragraph_zero_based":15100},{"literal_text_all_w_t_and_m_t":"Indicates a list of DL-PRS processing window configurations to be added or modified for the dedicated DL BWP.","paragraph_zero_based":15101},{"literal_text_all_w_t_and_m_t":"dl-PPW-PreConfigToReleaseList","paragraph_zero_based":15102},{"literal_text_all_w_t_and_m_t":"Indicates a list of DL-PRS processing window configurations to be released for the dedicated DL BWP.","paragraph_zero_based":15103},{"literal_text_all_w_t_and_m_t":"harq-FeedbackEnablingforSPSactive","paragraph_zero_based":15104},{"literal_text_all_w_t_and_m_t":"If enabled, UE reports ACK/NACK for the first SPS PDSCH after activation, regardless of if HARQ feedback is enabled or disabled corresponding to the first SPS PDSCH after activation. Otherwise, UE follows configuration of HARQ feedback enabled/disabled corresponding to the first SPS PDSCH after activation.","paragraph_zero_based":15105},{"literal_text_all_w_t_and_m_t":"nonCellDefiningSSB","paragraph_zero_based":15106},{"literal_text_all_w_t_and_m_t":"If configured, the RedCap UE operating in this BWP uses this SSB for the purposes for which it would otherwise have used the CD-SSB of the serving cell (e.g. obtaining sync, measurements, RLM). Furthermore, other parts of the BWP configuration that refer to an SSB (e.g. the \"SSB\" configured in the QCL-Info IE; the \"ssb-Index\" configured in the RadioLinkMonitoringRS; CFRA-SSB-Resource; PRACH-ResourceDedicatedBFR) refer implicitily to this NCD-SSB.","paragraph_zero_based":15107},{"literal_text_all_w_t_and_m_t":"The NCD-SSB has the same values for the properties (e.g., ssb-PositionsInBurst, PCI, ssb-PBCH-BlockPower) of the corresponding CD-SSB apart from the values of the properties configured in the NonCellDefiningSSB-r17 IE.","paragraph_zero_based":15108},{"literal_text_all_w_t_and_m_t":"pdcch-Config","paragraph_zero_based":15109},{"literal_text_all_w_t_and_m_t":"UE specific PDCCH configuration for one BWP.","paragraph_zero_based":15110},{"literal_text_all_w_t_and_m_t":"pdsch-Config","paragraph_zero_based":15111},{"literal_text_all_w_t_and_m_t":"UE specific PDSCH configuration for one BWP.","paragraph_zero_based":15112},{"literal_text_all_w_t_and_m_t":"preConfGapStatus","paragraph_zero_based":15113},{"literal_text_all_w_t_and_m_t":"Indicates whether the pre-configured measurement gaps (i.e. the gaps configured with preConfigInd) are activated or deactivated upon the switch to this BWP. If this field is configured, the UE shall apply network-controlled mechanism for activation and deactivation of the pre-configured measurement gaps, otherwise the UE shall apply the autonomous activation/deactivation mechanism, as specified in TS 38.133 [14]. The first/leftmost bit corresponds to the measurement gap with gap ID 1, the second bit corresponds to measurement gap with gap ID 2, and so on. Value 0 indicates that the corresponding pre-configured measurement gap is deactivated while value 1 indicates that the corresponding pre-configured measurement gap is activated. The UE shall ignore the bit if the corresponding measurement gap is not a pre-configured measurement gap.","paragraph_zero_based":15114},{"literal_text_all_w_t_and_m_t":"servingCellMO","paragraph_zero_based":15115},{"literal_text_all_w_t_and_m_t":"measObjectId of the MeasObjectNR in MeasConfig which is associated to the serving cell. For this MeasObjectNR, the following relationship applies between this MeasObjectNR and nonCellDefiningSSB in BWP-DownlinkDedicated of the associated downlink BWP: if ssbFrequency is configured, its value is the same as the absoluteFrequencySSB in the nonCellDefiningSSB. If the field is present in a downlink BWP and the BWP is activated, the RedCap UE uses this measurement object for serving cell measurements (e.g., including those used in measurement report triggering events), otherwise, the RedCap UE uses the servingCellMO in ServingCellConfig IE.","paragraph_zero_based":15116},{"literal_text_all_w_t_and_m_t":"sps-Config","paragraph_zero_based":15117},{"literal_text_all_w_t_and_m_t":"UE specific SPS (Semi-Persistent Scheduling) configuration for one BWP. Except for reconfiguration with sync, the NW does not reconfigure sps-Config when there is an active configured downlink assignment (see TS 38.321 [3]). However, the NW may release the sps-Config at any time. Network can only configure SPS in one BWP using either this field or sps-ConfigToAddModList. Network does not configure SPS in one BWP using this field and sps-ConfigMulticastToAddModList-r17 simultaneously.","paragraph_zero_based":15118},{"literal_text_all_w_t_and_m_t":"sps-ConfigDeactivationStateList","paragraph_zero_based":15119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["4a161897f2f56325f2ac8aa141d60b62f58ce2a5bf6c0c770459a00cc296f428","631329ec5d5f0164ce2d01750588b3272e9522711eb694e2b3dac535fc1a8353","ab27ad349e5bc61201336e17d62ac33bdb80f5dba9091cd026e05bb21af5df08","131946a239f37f41ad696b496c7f1fb84acca7285a1740f30cca796d6c3e27af","39befdfbdc75ad209bea16ad697b6195646286d4b2cbc1006cec111fa744d8fe","a6ab833b3d22a5f3c1bfdde8ae0a4bc60ab9e8b2e9351fb9fc646c3f3c046652","614f64d47706b322b708628a12955ce3af9c8c1deb6261eea5e39eaae118beb6","6422668869b15fa798d2d740cb465ede04ccbe780d27c3aa1c9038817b9a61eb","9ad839c168c1fc8001d65e87cd9cf6ebcd5330d1f53b1c36935828e78b1951f4","02b96fa6e49ef41ade641f222aa676336b310b29bdffdb1d0f21599426f12dff","14dac36922b13ef3a4e653bd3bad281259a2be9c6554ffd997b2562044a71fb2","cf08ea87abd798355c54f53893c8b16c3afaf3391954db35cba1a42950d2df6f","eae1260c4dd62a828b32f7c20249d77bdc7827749876be8d6ec34da5fdc58378","ebf8b63caf1aca3b3aafab9027dfcdd6e5ce3110124013c4d5c65707b4fdf89b","0f85f6632e434fc9120aec036ca69a830cc83f14f1a8551a79c0fd0fbea6996a","8f8d32dcb84c08b6dc733817dc52ccb4687bd79de5913f5fd128d1e57cc122d9","0f7cfb79924805f83baa6904ba80533b68fc81b24bc948f8b426a0389dae8447","f87dd2a1b8f18fde28eaa00563eace98c5e0f316cc55b2b5c57de4ca10fae51a","50b48b496bc4e53bf9ef7c18e48b80898fd2d54dc5b571b461f767561c9138bb","a2fe52a2d0d9775f9ad38803de46b495d7c3f88b8ab503ef774355a1dc46fe92","c73816e5cfcd7df17b6808d49c8c002acbbf44da82205243fec10e94b35bf809","163d8897423dd5d597ee1536d053135f6e72ca00ec3c6d747820e23003107a0c","8887620307db99213701cf14d92fe1b964ef7b850e81fa72a48130f334d963e0","ae25bed1ded8adf131ece7538602b8f1fc5e291a61cb81e020fbe47721e3ce1d"],"paragraph_range_zero_based":[15096,15119],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p15096"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates a list of the deactivation states in which each state can be mapped to a single or multiple SPS configurations to be deactivated, see clause 10.2 in TS 38.213 [13]. If a state is mapped to multiple SPS configurations, each of these SPS configurations is configured with the same harq-CodebookID.","paragraph_zero_based":15120},{"literal_text_all_w_t_and_m_t":"sps-ConfigToAddModList","paragraph_zero_based":15121},{"literal_text_all_w_t_and_m_t":"Indicates a list of one or more DL SPS configurations to be added or modified in one BWP. Except for reconfiguration with sync, the NW does not reconfigure a SPS configuration when it is active (see TS 38.321 [3]).","paragraph_zero_based":15122},{"literal_text_all_w_t_and_m_t":"sps-ConfigToReleaseList","paragraph_zero_based":15123},{"literal_text_all_w_t_and_m_t":"Indicates a list of one or more DL SPS configurations to be released. The NW may release a SPS configuration at any time.","paragraph_zero_based":15124},{"literal_text_all_w_t_and_m_t":"radioLinkMonitoringConfig","paragraph_zero_based":15125},{"literal_text_all_w_t_and_m_t":"UE specific configuration of radio link monitoring for detecting cell- and beam radio link failure occasions. The maximum number of failure detection resources should be limited up to 8 for both cell and beam radio link failure detection. For SCells, only periodic 1-port CSI-RS can be configured in IE RadioLinkMonitoringConfig.","paragraph_zero_based":15126},{"literal_text_all_w_t_and_m_t":"sl-PDCCH-Config","paragraph_zero_based":15127},{"literal_text_all_w_t_and_m_t":"Indicates the UE specific PDCCH configurations for receiving the SL grants (via SL-RNTI or SL-CS-RNTI) for NR sidelink communication/discovery.","paragraph_zero_based":15128},{"literal_text_all_w_t_and_m_t":"sl-V2X-PDCCH-Config","paragraph_zero_based":15129},{"literal_text_all_w_t_and_m_t":"Indicates the UE specific PDCCH configurations for receiving SL grants (i.e. sidelink SPS) for V2X sidelink communication.","paragraph_zero_based":15130},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15131},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":15132},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":15133},{"literal_text_all_w_t_and_m_t":"MeasObject-NCD-SSB","paragraph_zero_based":15134},{"literal_text_all_w_t_and_m_t":"This field is optionally present Need S if the UE is a RedCap UE and nonCellDefiningSSB is configured in this DL BWP. It is absent otherwise.","paragraph_zero_based":15135},{"literal_text_all_w_t_and_m_t":"PreConfigMG","paragraph_zero_based":15136},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if there is at least one per UE gap configured with preConfigInd or there is at least one per FR gap of the same FR which the BWP belongs to and configured with preConfigInd. It is absent, Need R, otherwise.","paragraph_zero_based":15137},{"literal_text_all_w_t_and_m_t":"ScellOnly","paragraph_zero_based":15138},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need M, in the BWP-DownlinkDedicated of an Scell. It is absent otherwise.","paragraph_zero_based":15139},{"literal_text_all_w_t_and_m_t":"SpCellOnly","paragraph_zero_based":15140},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need M, in the BWP-DownlinkDedicated of an Spcell. It is absent otherwise.","paragraph_zero_based":15141},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15142},{"literal_text_all_w_t_and_m_t":"–BWP-Id","paragraph_zero_based":15143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["9457e1cc9c7bc2bfe572741dfc7c02cb2dcfad3ce79ed5ba93bdf793c5fa8e77","53c405084a4401b370fa42e8fdecad4fe6a5f0e66f04036141f2b83a99c41ace","24da890e06cbd1c84e045f06e1375ef927d8e54d043ce252c419418fc2ca93bf","b98c3f22a6b5a45f28feeb2db5276671d5b8efccff2a2a6e7934dd2a2d4e28c2","270a459efe95b96c922a05c9d773f0d53a504e4efb243146cbd3c1fbf1121ec7","d45621bd8913a18a2ca1354c6d288d9c4799a99f742f954558c66a1a3c287a3c","75f543447f7bb138005701f3eceaf47b0a8c4515d0b3b6e0187ea5e9c163be02","a98a29c9c4122402864302be8c6ed01a3df83739685a629f0c2c70bbf814e6c0","e4e2d9183ef3156ee3838b0b36a3381ced9da34e66251af07a21879e51bf5a24","910b2a0f01eb080ec2c9fa07e53368be137e9b6f1826faacc8d46b3a28cae694","f5811a505972e4769706958429667f545db495c0efca31cbd3552c381754d656","b92a945bff6f11df026290f1be234953005f59e3c5eef2e39b9cd2039925462b","c2ae1c8e7d12caedb9b34d9b788392b82177b08972df7c2b8e1fe644032a9a6e","f49af54ab945ccb1b4f951106b8b16e2b94461490666a02aac79cd625c342d90","a5c7a95577f90094cddf0e3650426d4cb543fae08cc59a0a753f2534127fdf0d","24fac047b843dd1a69af0ba0628f4615af39a6ee3028d82451b15c15c0477c28","b69345a4ddee86fe6dcd84d19add75b4cc1f3fdf3bd5be7f8e5de9ea3950311e","f35a6af75bd635bb348dc7946adba4108f8777652641168272c025595c4629cb","fadd03447fd32042caed454fc519de468855d64c5452188f45c298459998623b","6bbefff92a1b7affed8bbe0b5ff5fa91fa6487fbb56c7bfbec334ce7735daf35","afeeddc6c839f1515413a6545f31416878b7387a4c6831078f2caf0ab624e665","e1a0e37547aeb455288ccc17c8cdde4b57b66b4b0a0f14380d1803233d7a32e2","eca601fb5a1834258f75d8f96e356485dde51e98f237eb6b376d17a8ec1f96a1","673435356eed1c8bc0dfa5dd39fdc11976b4e094a302c0adf86ea7df20245485"],"paragraph_range_zero_based":[15120,15143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p15120"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE BWP-Id is used to refer to Bandwidth Parts (BWP). The initial BWP (including RedCap-specific initial BWP, if configured) is referred to by BWP-Id 0. The other BWPs are referred to by BWP-Id 1 to maxNrofBWPs.","paragraph_zero_based":15144},{"literal_text_all_w_t_and_m_t":"BWP-Id information element","paragraph_zero_based":15145},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":15146},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-ID-START","paragraph_zero_based":15147},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15148},{"literal_text_all_w_t_and_m_t":"BWP-Id ::=                          INTEGER (0..maxNrofBWPs)","paragraph_zero_based":15149},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15150},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-ID-STOP","paragraph_zero_based":15151},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":15152},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15153},{"literal_text_all_w_t_and_m_t":"–BWP-Uplink","paragraph_zero_based":15154},{"literal_text_all_w_t_and_m_t":"The IE BWP-Uplink is used to configure an additional uplink bandwidth part (not for the initial BWP).","paragraph_zero_based":15155},{"literal_text_all_w_t_and_m_t":"BWP-Uplink information element","paragraph_zero_based":15156},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":15157},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-UPLINK-START","paragraph_zero_based":15158},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15159},{"literal_text_all_w_t_and_m_t":"BWP-Uplink ::=                      SEQUENCE {","paragraph_zero_based":15160},{"literal_text_all_w_t_and_m_t":"    bwp-Id                              BWP-Id,","paragraph_zero_based":15161},{"literal_text_all_w_t_and_m_t":"    bwp-Common                          BWP-UplinkCommon                                            OPTIONAL,   -- Cond SetupOtherBWP","paragraph_zero_based":15162},{"literal_text_all_w_t_and_m_t":"    bwp-Dedicated                       BWP-UplinkDedicated                                         OPTIONAL,   -- Cond SetupOtherBWP","paragraph_zero_based":15163},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":15164},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":15165},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15166},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-UPLINK-STOP","paragraph_zero_based":15167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["20ef128341f8b6fbf3c5ff96a1b0ffa16bbad9307d55cce99a504f570cc748bb","7c882b7f912fba6e88642591068e48054b845601db98c58cd203d00442bc531d","a1ccb96ef7a1c76f26d40df1c00af528cc562930f07a660156b425d0cdf386fa","53525e622dc83005429e4f5c5b8ec76eb328beabdc9bd26c49b01c2316ca9206","0fd4a139670cb8d88be64cbebd21d6b28a1aeeaf5ccc5c3e92f7540694b51dc0","bdb1e71be5e3ecfc30d3424e77d2489fe6c7a845c87a7918eac9f99d9f31cff5","2834debca6ff2df57424a1b76f3a30da6c84fe5927e16d73775428d7af4cd6c6","7a359c03d825b6fc14bd601bc05c0cb3b0ec6142711f286d1f78c7349d601162","4ed3b86d1a3dea99f1a97af8bbf5d189939ac6e3971399f0dc754bebad2f03ff","78a2430dc5da48dcce6a345e3c1241dbdd9aeb4408f95fa0be8cfd1420d25af2","5e07f3eee7f68a48289174585aa05f6356ec9297f48dc80bd6022ad98351c401","1e36b256008afedc6a95a22ea6363be003ba77dd74a1498a71d3d2a172ff2d7b","ecf6fbc17700b12dc6ae653bfe0a84d671b529dc79b327a93e1814a000590e9a","d6d408aec82d9bd067f8e85e436f678fd7d10241dcf1a94e5950cabaccee62af","59e7ed053078fd54db03bf763863d47f0d79e24ba124f1e04e85e172376b51cf","093361979d5a65a54373839fe98d8f6cd0a6ebb4852c88d797680312bdcb976f","bbe606877dbdff6b69c9e08ee0b3cc6ae94745e1d82d933e18b13773f2b7102b","e33b7240c670830b32f0c86bb3dca72e5fba0a11e97f796b2b8060eafb3942c0","8401105f2adc214802f27b4a6a2b3bb1a7ff4a32fa586561e95163fb579802a5","90867bf6c85edf4886fab9b8fcea430715835389a6c227a3268db06ffa642171","26947e7c18e92ebf827389b8f15224a89238005942489462ae76e95c259b9ea3","c82c02e9cf0d17059bf0eccf58a6a4103ca096f1c6c3991d6081f57feec54c29","8424bd8190451ba03dcfcd4d6b2f200a1dbd3d12780f631df4d9d873a6e8954e","c6aa8b7d108ebbeb02042fd527be2d7a736e8443c9715b476c943a313b6f4cb2"],"paragraph_range_zero_based":[15144,15167],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p15144"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":15168},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15169},{"literal_text_all_w_t_and_m_t":"BWP-Uplink field descriptions","paragraph_zero_based":15170},{"literal_text_all_w_t_and_m_t":"bwp-Id","paragraph_zero_based":15171},{"literal_text_all_w_t_and_m_t":"An identifier for this bandwidth part. Other parts of the RRC configuration use the BWP-Id to associate themselves with a particular bandwidth part.","paragraph_zero_based":15172},{"literal_text_all_w_t_and_m_t":"The network configures the BWPs with consecutive IDs from 1. The Network does not include the value 0, since value 0 is reserved for the initial BWP.","paragraph_zero_based":15173},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15174},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":15175},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":15176},{"literal_text_all_w_t_and_m_t":"SetupOtherBWP","paragraph_zero_based":15177},{"literal_text_all_w_t_and_m_t":"The field is mandatory present upon configuration of a new UL BWP. The field is optionally present, Need M, otherwise. ","paragraph_zero_based":15178},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15179},{"literal_text_all_w_t_and_m_t":"–BWP-UplinkCommon","paragraph_zero_based":15180},{"literal_text_all_w_t_and_m_t":"The IE BWP-UplinkCommon is used to configure the common parameters of an uplink BWP. They are \"cell specific\" and the network ensures the necessary alignment with corresponding parameters of other UEs. The common parameters of the initial bandwidth part of the PCell are also provided via system information. For all other serving cells, the network provides the common parameters via dedicated signalling.","paragraph_zero_based":15181},{"literal_text_all_w_t_and_m_t":"BWP-UplinkCommon information element","paragraph_zero_based":15182},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":15183},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-UPLINKCOMMON-START","paragraph_zero_based":15184},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15185},{"literal_text_all_w_t_and_m_t":"BWP-UplinkCommon ::=                SEQUENCE {","paragraph_zero_based":15186},{"literal_text_all_w_t_and_m_t":"    genericParameters                   BWP,","paragraph_zero_based":15187},{"literal_text_all_w_t_and_m_t":"    rach-ConfigCommon                   SetupRelease { RACH-ConfigCommon }                                      OPTIONAL,   -- Need M","paragraph_zero_based":15188},{"literal_text_all_w_t_and_m_t":"    pusch-ConfigCommon                  SetupRelease { PUSCH-ConfigCommon }                                     OPTIONAL,   -- Need M","paragraph_zero_based":15189},{"literal_text_all_w_t_and_m_t":"    pucch-ConfigCommon                  SetupRelease { PUCCH-ConfigCommon }                                     OPTIONAL,   -- Need M","paragraph_zero_based":15190},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":15191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["8b766b671dec18f5317dca7ba03394d0e2c42305f98a9250672f4ed7947aa4f6","c9a17f995c8514453305c9820f4561a7219568a019df8a75fca1f5280b64483b","97bf465ba2a99bf93aeeafd6be92d33f369b9fa795de35e97041c96753f80835","49a890f16c2c06c6d2f0589ff378974268a01b67c7a8836ddeac95412a63d2f5","7abc9dc74a46cf3ed64bbb0f1be10387c51c10b541af30c37fda1c494bd57dbb","57cd61e399e247eb7ff3a2bcef024a10cc693e0f58ba8a3ad1790fed9a965916","91b74426017650acea