{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"drx-ShortCycle","paragraph_zero_based":18360},{"literal_text_all_w_t_and_m_t":"Value in ms. ms1 corresponds to 1 ms, ms2 corresponds to 2 ms, and so on.","paragraph_zero_based":18361},{"literal_text_all_w_t_and_m_t":"drx-SlotOffset","paragraph_zero_based":18362},{"literal_text_all_w_t_and_m_t":"Value in 1/32 ms. Value 0 corresponds to 0 ms, value 1 corresponds to 1/32 ms, value 2 corresponds to 2/32 ms, and so on.","paragraph_zero_based":18363},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18364},{"literal_text_all_w_t_and_m_t":"–DRX-ConfigSecondaryGroup","paragraph_zero_based":18365},{"literal_text_all_w_t_and_m_t":"The IE DRX-ConfigSecondaryGroup is used to configure DRX related parameters for the second DRX group as specified in TS 38.321 [3].","paragraph_zero_based":18366},{"literal_text_all_w_t_and_m_t":"DRX-ConfigSecondaryGroup information element","paragraph_zero_based":18367},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18368},{"literal_text_all_w_t_and_m_t":"-- TAG-DRX-CONFIGSECONDARYGROUP-START","paragraph_zero_based":18369},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18370},{"literal_text_all_w_t_and_m_t":"DRX-ConfigSecondaryGroup-r16 ::=   SEQUENCE {","paragraph_zero_based":18371},{"literal_text_all_w_t_and_m_t":"    drx-onDurationTimer-r16            CHOICE {","paragraph_zero_based":18372},{"literal_text_all_w_t_and_m_t":"                                           subMilliSeconds INTEGER (1..31),","paragraph_zero_based":18373},{"literal_text_all_w_t_and_m_t":"                                           milliSeconds    ENUMERATED {","paragraph_zero_based":18374},{"literal_text_all_w_t_and_m_t":"                                               ms1, ms2, ms3, ms4, ms5, ms6, ms8, ms10, ms20, ms30, ms40, ms50, ms60,","pa