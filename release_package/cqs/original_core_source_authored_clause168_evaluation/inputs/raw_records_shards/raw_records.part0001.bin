{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"CodebookConfig field descriptions","paragraph_zero_based":16248},{"literal_text_all_w_t_and_m_t":"codebookMode","paragraph_zero_based":16249},{"literal_text_all_w_t_and_m_t":"CodebookMode as specified in TS 38.214 [19], clause 5.2.2.2.2.","paragraph_zero_based":16250},{"literal_text_all_w_t_and_m_t":"codebookType","paragraph_zero_based":16251},{"literal_text_all_w_t_and_m_t":"CodebookType including possibly sub-types and the corresponding parameters for each (see TS 38.214 [19], clause 5.2.2.2).","paragraph_zero_based":16252},{"literal_text_all_w_t_and_m_t":"n1-n2-codebookSubsetRestriction","paragraph_zero_based":16253},{"literal_text_all_w_t_and_m_t":"Number of antenna ports in first (n1) and second (n2) dimension and codebook subset restriction (see TS 38.214 [19] clause 5.2.2.2.3).","paragraph_zero_based":16254},{"literal_text_all_w_t_and_m_t":"Number of bits for codebook subset restriction is CEIL(log2(nchoosek(O1*O2,4)))+8*n1*n2 where nchoosek(a,b) = a!/(b!(a-b)!).","paragraph_zero_based":16255},{"literal_text_all_w_t_and_m_t":"n1-n2","paragraph_zero_based":16256},{"literal_text_all_w_t_and_m_t":"Number of antenna ports in first (n1) and second (n2) dimension and codebook subset restriction (see TS 38.214 [19] clause 5.2.2.2.1).","paragraph_zero_based":16257},{"literal_text_all_w_t_and_m_t":"ng-n1-n2","paragraph_zero_based":16258},{"literal_text_all_w_t_and_m_t":"Codebook subset restriction for Type I Multi-panel codebook (see TS 38.214 [19], clause 5.2.2.2.2).","paragraph_zero_based":16259},{"literal_text_all_w_t_and_m_t":"numberOfBeams","paragraph_zero_based":16260},{"literal_text_all_w_t_and_m_t":"Number of beams, L, used for linear combination.","paragraph_zero_based":16261},{"literal_text_all_w_t_and_m_t":"numberOfPMI-SubbandsPerCQI-Subband","paragraph_zero_based":16262},{"literal_text_all_w_t_and_m_t":"Field indicates how PMI subbands are defined per CQI subband according to TS 38.214 [19], clause 5.2.2.2.5, and 5.2.2.2.7.","paragraph_zero_based":16263},{"literal_text_all_w_t_and_m_t":"paramCombination","paragraph_zero_based":16264},{"literal_text_all_w_t_and_m_t":"Field describes supported parameter combination (M, α, β) as specified in TS 38.214 [19].","paragraph_zero_based":16265},{"literal_text_all_w_t_and_m_t":"phaseAlphabetSize","paragraph_zero_based":16266},{"literal_text_all_w_t_and_m_t":"The size of the PSK alphabet, QPSK or 8-PSK.","paragraph_zero_based":16267},{"literal_text_all_w_t_and_m_t":"portSelectionSamplingSize","paragraph_zero_based":16268},{"literal_text_all_w_t_and_m_t":"The size of the port selection codebook (parameter d), see TS 38.214 [19] clause 5.2.2.2.6.","paragraph_zero_based":16269},{"literal_text_all_w_t_and_m_t":"ri-Restriction","paragraph_zero_based":16270},{"literal_text_all_w_t_and_m_t":"Restriction for RI for TypeI-MultiPanel-RI-Restriction (see TS 38.214 [19], clause 5.2.2.2.2).","paragraph_zero_based":16271}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["85eba43eb75bca769aa388bc4424d52786c66adc174aa27f53c8e3c9d38ac672","17c2b6b7a0e8627a9cbb4cd9a194352b6064af22b61e1546437ed2043f35d39d","37754f7061a0824907c8955756abf19b4513d07534192918e60b4ab6bd7a873f","ba912fec02fd21b2a750b747482db4bf1ba74b6194437411cb198f236cf1de59","e8d2c4b003a26776ed669615dbc949976e013fc532b2e0c9913b6e63d339dac4","0dc7d5099c4539356df573f9ff0756457d02f1171fc7c19063aa2433ccff71aa","12077c1af25936400eae05784f0c46ed3ba082aa5cca1922b8519b7b40b087f5","c22244e3acc2723a89ecd202f0fbbd0c137d9ca7b35de1d667ea8801a3069700","220c626