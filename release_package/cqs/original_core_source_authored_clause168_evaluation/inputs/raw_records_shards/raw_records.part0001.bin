{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25968},{"literal_text_all_w_t_and_m_t":"MeasReportQuantityCLI-r16 ::=               ENUMERATED {srs-rsrp, cli-rssi}","paragraph_zero_based":25969},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25970},{"literal_text_all_w_t_and_m_t":"-- TAG-REPORTCONFIGNR-STOP","paragraph_zero_based":25971},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":25972},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25973},{"literal_text_all_w_t_and_m_t":"CondTriggerConfig field descriptions","paragraph_zero_based":25974},{"literal_text_all_w_t_and_m_t":"a3-Offset","paragraph_zero_based":25975},{"literal_text_all_w_t_and_m_t":"Offset value(s) to be used in NR conditional reconfiguration triggering condition for cond event a3. The actual value is field value * 0.5 dB.","paragraph_zero_based":25976},{"literal_text_all_w_t_and_m_t":"a4-Threshold","paragraph_zero_based":25977},{"literal_text_all_w_t_and_m_t":"Threshold value associated to the selected trigger quantity (e.g. RSRP, RSRQ, SINR) per RS Type (e.g. SS/PBCH block, CSI-RS) to be used in NR conditional reconfiguration triggering condition for cond event a4.","paragraph_zero_based":25978},{"literal_text_all_w_t_and_m_t":"a5-Threshold1/ a5-Threshold2","paragraph_zero_based":25979},{"literal_text_all_w_t_and_m_t":"Threshold value associated to the selected trigger quantity (e.g. RSRP, RSRQ, SINR) per RS Type (e.g. SS/PBCH block, CSI-RS) to be used in NR conditional reconfiguration triggering condition for cond event a5. In the same condeventA5, the network configures the same quantity for the MeasTriggerQuantity of the a5-Threshold1 and for the MeasTriggerQuantity of the a5-Threshold2.","paragraph_zero_based":25980},{"literal_text_all_w_t_and_m_t":"condEventId","paragraph_zero_based":25981},{"literal_text_all_w_t_and_m_t":"Choice of NR conditional reconfiguration event triggered criteria.","paragraph_zero_based":25982},{"literal_text_all_w_t_and_m_t":"distanceThreshFromReference1, distanceThreshFromReference2","paragraph_zero_based":25983},{"literal_text_all_w_t_and_m_t":"Distance from a reference location configured with referenceLocation1 or referenceLocation2. Each step represents 50m.","paragraph_zero_based":25984},{"literal_text_all_w_t_and_m_t":"duration","paragraph_zero_based":25985},{"literal_text_all_w_t_and_m_t":"This field is used for defining the leaving condition T1-2 for conditional HO event condEventT1. Each step represents 100ms.","paragraph_zero_based":25986},{"literal_text_all_w_t_and_m_t":"nesEvent","paragraph_zero_based":25987},{"literal_text_all_w_t_and_m_t":"Indicates the event is an NES-specific CHO event and the CHO execution condition is only considered to be satifisfied if indication from lower layers is received indicating the applicability of NES-specific CHO event. This field can only be configured for event A3, A4 and A5.","paragraph_zero_based":25988},{"literal_text_all_w_t_and_m_t":"referenceLocation1, referenceLocation2","paragraph_zero_based":25989},{"literal_text_all_w_t_and_m_t":"Reference locations used for condEventD1. The referenceLocation1 is associated to serving cell and referenceLocation2 is associated to candidate target cell.","paragraph_zero_based":25990},{"literal_text_all_w_t_and_m_t":"t1-Threshold","paragraph_zero_based":25991}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["e6a1a05ac0e4e968b09ae60b8dea7a0c69647e3b77d319556a16e6eeea1d6385","50ea3c2b37a587af24140dc39610bee428e71eaaa0ab36f310ccb3fdf9355480","6cf616a87f20c20724464c787029df470966d620c291f4c684b77ccfa0f2ea91","116e923b2d0268fa433e2ff9b6456cb91e427feae7f295685dbbeb00ed8cf167","a0698aaf3e3c2908abef34a21965069eafb60e8564df15ee2021b44a150c48df","a46fd1398ad435a0b487911879e29a563d2f2a88a74a8922405560090df53097","aeb7d17e7cdc70cae072648af97cd896f54c2fb5a562a6548ae7e38c6609c9d5","0da63301b95f41ca389c69cdd35353b4893e7cf23c15ab7aa9f309b3734af941","c642396928a355b3975f28ebee994837de2a1aad6d7d5a49361eebe8c30298ec","d79b8b3e58486823539365676e272be66b716508ff6c2bba589c85faff2d437a","e2c66e23baf90047e0133c29e1d557fe184f6e3d5f8830ee07b0477c37a57de1","d69f4b043687722a076a0ef1877eabf9261b4ba53b2b3ad45034a7f4be53259d","b3058711be1fabbd26ab64c3fc5d710a5e1120a717bfba728f4d63ed6868c61a","9e9e9616a350ce0592a9497d3b9d50cb0397d499444ba083d1bd6f0396e42324","e34e24940b4d8db3ba513f866ca2643951cd65ec1e89fe632f6f563a62a29cb5","7c0f0780421d1be1fd4a3f4108d5ebfdf36061c086be6f505ff6f8db8e29a8a8","39855fef1a94812e9e5025f05b271d3528f9d828ac92b36b75acecb74fa24dd2","fdc8a4d7e70d5aeb517de62eb8529ca4d7ed6fc674b461a740c7ba67c5c8686a","df2ba2bbc356e0613ccf215f28755bc38e5843746e10d822fbfbee475e87af9e","c3c083a77179614d26ddd472f318d6b8b28217c0579c9444c10e8541d639fbb9","490f01ce7eb0eb2cbf1850561ca2ebab985e940ba4a1e577483e5cd46a12f38b","f6091e604b6664c2b38ee997644285e2e0830433c80eabf81ad2e8f3624cdfe7","4a6ac3a68c1ec0f261a73ca05722498d6cc085a7331d9a6a13f01cd5d2469e90","120592a4edc8164a5492cf80f7b9004da17ab86cad2fcc0daa318276589d0c25"],"paragraph_range_zero_based":[25968,25991],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p25968"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The field counts the number of UTC seconds in 10 ms units since 00:00:00 on Gregorian calendar date 1 January, 1900 (midnight between Sunday, December 31, 1899 and Monday, January 1, 1900).","paragraph_zero_based":25992},{"literal_text_all_w_t_and_m_t":"timeToTrigger","paragraph_zero_based":25993},{"literal_text_all_w_t_and_m_t":"Time during which specific criteria for the event needs to be met in order to execute the conditional reconfiguration evaluation.","paragraph_zero_based":25994},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25995},{"literal_text_all_w_t_and_m_t":"ReportConfigNR field descriptions","paragraph_zero_based":25996},{"literal_text_all_w_t_and_m_t":"reportType","paragraph_zero_based":25997},{"literal_text_all_w_t_and_m_t":"Type of the configured measurement report. In MR-DC, network does not configure report of type reportCGI using SRB3. The condTriggerConfig is used for CHO, CPA or CPC configuration.","paragraph_zero_based":25998},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25999},{"literal_text_all_w_t_and_m_t":"ReportCGI field descriptions","paragraph_zero_based":26000},{"literal_text_all_w_t_and_m_t":"useAutonomousGaps","paragraph_zero_based":26001},{"literal_text_all_w_t_and_m_t":"Indicates whether or not the UE is allowed to use autonomous gaps in acquiring system information from the NR neighbour cell. When the field is included, the UE applies the corresponding value for T321.","paragraph_zero_based":26002},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26003},{"literal_text_all_w_t_and_m_t":"EventTriggerConfig field descriptions","paragraph_zero_based":26004},{"literal_text_all_w_t_and_m_t":"a3-Offset/a6-Offset","paragraph_zero_based":26005},{"literal_text_all_w_t_and_m_t":"Offset value(s) to be used in NR measurement report triggering condition for event a3/a6. The actual value is field value * 0.5 dB.","paragraph_zero_based":26006},{"literal_text_all_w_t_and_m_t":"aN-ThresholdM","paragraph_zero_based":26007},{"literal_text_all_w_t_and_m_t":"Threshold value associated to the selected trigger quantity (e.g. RSRP, RSRQ, SINR) per RS Type (e.g. SS/PBCH block, CSI-RS) to be used in NR measurement report triggering condition for event number aN. If multiple thresholds are defined for event number aN, the thresholds are differentiated by M. The network configures aN-Threshold1 only for events A1, A2, A4, A5 and a5-Threshold2 only for event A5. In the same eventA5, the network configures the same quantity for the MeasTriggerQuantity of the a5-Threshold1 and for the MeasTriggerQuantity of the a5-Threshold2.","paragraph_zero_based":26008},{"literal_text_all_w_t_and_m_t":"channelOccupancyThreshold","paragraph_zero_based":26009},{"literal_text_all_w_t_and_m_t":"RSSI threshold which is used for channel occupancy evaluation.","paragraph_zero_based":26010},{"literal_text_all_w_t_and_m_t":"coarseLocationRequest","paragraph_zero_based":26011},{"literal_text_all_w_t_and_m_t":"This field is used to request UE to report coarse location information.","paragraph_zero_based":26012},{"literal_text_all_w_t_and_m_t":"distanceThreshFromReference1, distanceThreshFromReference2","paragraph_zero_based":26013},{"literal_text_all_w_t_and_m_t":"Threshold value associated to the distance from a reference location configured with referenceLocation1 or referenceLocation2. Each step represents 50m.","paragraph_zero_based":26014},{"literal_text_all_w_t_and_m_t":"eventId","paragraph_zero_based":26015}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae359