f2ce57d774f6440f","fbb5694cea79c6eda104619d9914ee0082397bd7c5ef47d5d07b9ddcea2f3bc3","1b991fb986b665b60571ec777c13b1bcf5c8b065c521076c99fc36d38dfb33fe","baf652a6af5183c406f05df05227377a3915cb6ba7289f04cafeb059b847c782","9f4ba123e77743e78586ab1852cfb3e19b2bb64d48e0a6c64c1940d4c9de5fcf","b1757b649ff616f84721563fa5dffd13d2d765d7ffc16a6a86c5b2613bbcc6b6","0c561b3ea4976708649ab4cdc833284d5cff16daa017c0b21554b19f5d91ce5f","e2544441c3d300d96488a9c6efb99fc55feceb461f5b3acdfec13a58dff94daa","fe5d9b6b8be28baf5c2448fd1ba6ef3d741be4dd0fea475bacb2cf1cbd046d66","ab3eaf2371e94df3d3cae712f18f11898775d42e4e2cce806f2db28739614975","0567e8a91ac277c368231d54643b9e1dd5c18a2e153baa8adf986bd99dda7395","d0f187e3835b2b963706cf4f9e0d5bf55c3972a3e6041a9ee8ba9e8aa051953b","34ced0bda865c81f3b74e03281205455402dcc194bf6d7b21ea3eb2807d4f69b","77fb443bb4992daa2d39ad0fc91e88afcc89f0b90e29a2cb4e97367cc7a64ab2","6243e4bc79c31550a821773bba838f04bf81413e536f2051616eb2886f6a83f3","3612203d96c0ce751c9a5817fcab12c2c485f9839f5bccf61dd971230ec510d3","0f2c6ff008fc56acaf0c37551c4573bc20a5360258d6abdb11548f767da3da7a","06b37051519724721337296bebad89f75dc7c720130ee954e928ca27a7360a45","1be49963a29b7a2181afe9643f53b8b18c8a0914e63eb1aaaeee6fc272a338c8"],"paragraph_range_zero_based":[12840,12863],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p12840"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"cellEquivalentSize","paragraph_zero_based":12864},{"literal_text_all_w_t_and_m_t":"The number of cell count used for mobility state estimation for this cell as specified in TS 38.304 [20].","paragraph_zero_based":12865},{"literal_text_all_w_t_and_m_t":"cellReselectionInfoCommon","paragraph_zero_based":12866},{"literal_text_all_w_t_and_m_t":"Cell re-selection information common for intra-frequency, inter-frequency and/ or inter-RAT cell re-selection.","paragraph_zero_based":12867},{"literal_text_all_w_t_and_m_t":"cellReselectionServingFreqInfo","paragraph_zero_based":12868},{"literal_text_all_w_t_and_m_t":"Information common for non-intra-frequency cell re-selection i.e. cell re-selection to inter-frequency and inter-RAT cells.","paragraph_zero_based":12869},{"literal_text_all_w_t_and_m_t":"combineRelaxedMeasCondition","paragraph_zero_based":12870},{"literal_text_all_w_t_and_m_t":"When both lowMobilityEvalutation and cellEdgeEvalutation criteria are present in SIB2, this parameter configures the UE to fulfil both criteria in order to relax measurement requirements for cell reselection. If the field is absent, the UE is allowed to relax measurement requirements for cell reselection when either or both of the criteria are met. (See TS 38.304 [20], clause 5.2.4.9.0)","paragraph_zero_based":12871},{"literal_text_all_w_t_and_m_t":"combineRelaxedMeasCondition2","paragraph_zero_based":12872},{"literal_text_all_w_t_and_m_t":"When both stationaryMobilityEvaluation and cellEdgeEvaluationWhileStationary criteria are present in SIB2, this parameter configures the UE to fulfil both criteria in order to relax measurement requirements for cell reselection. If the field is absent, the UE is allowed to relax measurement requirements for cell reselection when only the stationary criteria is met. (See TS 38.304 [20], clause 5.2.4.9.0)","paragraph_zero_based":12873},{"literal_text_all_w_t_and_m_t":"deriveSSB-IndexFromCell","paragraph_zero_based":12874},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE can utilize serving cell timing to derive the index of SS block transmitted by neighbour cell. If this field is set to true, the UE assumes SFN and frame boundary alignment across cells on the serving frequency as specified in TS 38.133 [14].","paragraph_zero_based":12875},{"literal_text_all_w_t_and_m_t":"frequencyBandList","paragraph_zero_based":12876},{"literal_text_all_w_t_and_m_t":"Indicates the list of frequency bands for which the NR cell reselection parameters apply. The UE behaviour in case the field is absent is described in clause 5.2.2.4.3.","paragraph_zero_based":12877},{"literal_text_all_w_t_and_m_t":"highPriorityMeasRelax","paragraph_zero_based":12878},{"literal_text_all_w_t_and_m_t":"Indicates whether measurements can be relaxed on high priority frequencies. If the field is absent, the UE shall not relax measurements on high priority frequencies beyond \"Thigher_priority_search\" unless both low mobility and not at cell edge criteria are fulfilled (see TS 38.133 [14], clauses 4.2.2.7, 4.2.2.10 and 4.2.2.11).","paragraph_zero_based":12879},{"literal_text_all_w_t_and_m_t":"intraFreqCellReselectionInfo","paragraph_zero_based":12880},{"literal_text_all_w_t_and_m_t":"Cell re-selection information common for intra-frequency cells.","paragraph_zero_based":12881},{"literal_text_all_w_t_and_m_t":"lowMobilityEvaluation","paragraph_zero_based":12882},{"literal_text_all_w_t_and_m_t":"Indicates the criteria for a UE to detect low mobility, in order to relax measurement requirements for cell reselection (see TS 38.304 [20], clause 5.2.4.9.1).","paragraph_zero_based":12883},{"literal_text_all_w_t_and_m_t":"nrofSS-BlocksToAverage","paragraph_zero_based":12884},{"literal_text_all_w_t_and_m_t":"Number of SS blocks to average for cell measurement derivation. If the field is absent the UE uses the measurement quantity as specified in TS 38.304 [20].","paragraph_zero_based":12885},{"literal_text_all_w_t_and_m_t":"p-Max","paragraph_zero_based":12886},{"literal_text_all_w_t_and_m_t":"Value in dBm applicable for the intra-frequency neighbouring NR cells. If absent the UE applies the maximum power according to TS 38.101-1 [15] in case of an FR1 cell, TS 38.101-2 [39] in case of an FR2 cell or TS 38.101-5 [75] in case of an NTN cell. In this release of the specification, if p-Max is present on a carrier frequency in FR2, the UE shall ignore the field and applies the maximum power according to TS 38.101-2 [39]. This field is ignored by IAB-MT. The IAB-MT applies output power and emissions requirements, as specified in TS 38.174 [63].","paragraph_zero_based":12887}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["1dd0e6169bb6c8f852fb76254252e42a5cde2c43f3ffe05a2ab9f4d37aa5cbea","086b48349ad2aed6eb29d0bb9ea9f9fc691fc2392f5f53418c624c0e4e4b81a1","a9e79f942e4598bb263cd46d0ee2117945eba3ff9a08826048cf12d2531774ef","ba7e8d8fcca01856621655677a5f9f4b48564021bb716e875419eecda7456276","e33abcb5fb6e710ae884a762b573f9c1ddef13501864512c5318a7d248d395b1","167fbb2bdd16c4c13aef9b0812b05eb661ebadf1ddf8ee432c452baba56d5014","c70c374f2e7e356c2ba925fcbb8df9948ef1910e35d4cc41093f78d4869b84c2","5ef628cd73dcec1318d17f87fa47340f5a0c9e91eb89328e2eddf673a470e864","3dc0d4218b14015342a78224faec8372f1112b09b22f6621344f1405f93c8c3e","16475d21933f5e88ab92362e628ad9dc1d7cf048baaab315ee4f86d39c149516","de098096514d50af9252112ce0ea287666cb1383b4b58d013bde9dbd336fad7d","7be67d5e72882ee5582a7f53d23696f353f2091cff459f88b8eed2946d73300b","9c1e64891dd6828fdd8c7fd1da0de927db5396a8abf7a7e5c7f532052eb76b2c","9942056d2d03146e1df218e4aef6d24df5acea9fea79641405faec5362c6faa1","0b34336fee01b241a57ef8636bb23d0ba1ec586c13b4b854c6930afa75ed4bcf","95cb6846a0fb0dd693b531e347e0e7b56d20a5e6535518fb08015a37a64f1261","e823f826a2eaa7c07d1d423732b32f6302354d952ca2eefe27c16f08ca07436e","402226390ae8a1d028728c346b1b11fabe2b7448f8841cda74e8d5f574082ead","768bf3d49132b90d82ef02910be23d8970395acb8e3f4129f78fe9954a453046","22cc5a70b98d0760e84c898931677b7718b5c462ea276ac91e56cbb227a32210","8a3f9e05c6b5bbe5ac6c1d0d1a6cf7feae6e1df51b96fd139b0f60185b9b6076","413c95e4f40af413766a7caa59ad2acbe9ad911a27d0d4b88c3d5fd2a0d3257d","25c607087d97459f442e53659be15d6353ec1ab6cfb1d386294ccf30081ac4fd","52c2281d0a27a3b0e72b0add5c8a123050ce5c316083cdfc49c6978600866f0d"],"paragraph_range_zero_based":[12864,12887],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p12864"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"q-Hyst","paragraph_zero_based":12888},{"literal_text_all_w_t_and_m_t":"Parameter \"Qhyst\" in TS 38.304 [20], Value in dB. Value dB1 corresponds to 1 dB, dB2 corresponds to 2 dB and so on.","paragraph_zero_based":12889},{"literal_text_all_w_t_and_m_t":"q-HystSF","paragraph_zero_based":12890},{"literal_text_all_w_t_and_m_t":"Parameter \"Speed dependent ScalingFactor for Qhyst\" in TS 38.304 [20]. The sf-Medium and sf-High concern the additional hysteresis to be applied, in Medium and High Mobility state respectively, to Qhyst as defined in TS 38.304 [20]. In dB. Value dB-6 corresponds to -6dB, dB-4 corresponds to -4dB and so on.","paragraph_zero_based":12891},{"literal_text_all_w_t_and_m_t":"q-QualMin","paragraph_zero_based":12892},{"literal_text_all_w_t_and_m_t":"Parameter \"Qqualmin\" in TS 38.304 [20], applicable for intra-frequency neighbour cells. If the field is absent, the UE applies the (default) value of negative infinity for Qqualmin.  ","paragraph_zero_based":12893},{"literal_text_all_w_t_and_m_t":"q-RxLevMin","paragraph_zero_based":12894},{"literal_text_all_w_t_and_m_t":"Parameter \"Qrxlevmin\" in TS 38.304 [20], applicable for intra-frequency neighbour cells.","paragraph_zero_based":12895},{"literal_text_all_w_t_and_m_t":"q-RxLevMinSUL","paragraph_zero_based":12896},{"literal_text_all_w_t_and_m_t":"Parameter \"Qrxlevmin\" in TS 38.304 [20], applicable for intra-frequency neighbour cells.","paragraph_zero_based":12897},{"literal_text_all_w_t_and_m_t":"rangeToBestCell","paragraph_zero_based":12898},{"literal_text_all_w_t_and_m_t":"Parameter \"rangeToBestCell\" in TS 38.304 [20]. The network configures only non-negative (in dB) values.","paragraph_zero_based":12899},{"literal_text_all_w_t_and_m_t":"relaxedMeasurement","paragraph_zero_based":12900},{"literal_text_all_w_t_and_m_t":"Configuration to allow relaxation of RRM measurement requirements for cell reselection (see TS 38.304 [20], clause 5.2.4.9). In NTN, this field is only applicable for GSO neighbour cells.","paragraph_zero_based":12901},{"literal_text_all_w_t_and_m_t":"s-IntraSearchP","paragraph_zero_based":12902},{"literal_text_all_w_t_and_m_t":"Parameter \"SIntraSearchP\" in TS 38.304 [20].","paragraph_zero_based":12903},{"literal_text_all_w_t_and_m_t":"s-IntraSearchQ","paragraph_zero_based":12904},{"literal_text_all_w_t_and_m_t":"Parameter \"SIntraSearchQ\" in TS 38.304 [20]. If the field is absent, the UE applies the (default) value of 0 dB for SIntraSearchQ.","paragraph_zero_based":12905},{"literal_text_all_w_t_and_m_t":"s-NonIntraSearchP","paragraph_zero_based":12906},{"literal_text_all_w_t_and_m_t":"Parameter \"SnonIntraSearchP\" in TS 38.304 [20]. If this field is absent, the UE applies the (default) value of infinity for SnonIntraSearchP.","paragraph_zero_based":12907},{"literal_text_all_w_t_and_m_t":"s-NonIntraSearchQ","paragraph_zero_based":12908},{"literal_text_all_w_t_and_m_t":"Parameter \"SnonIntraSearchQ\" in TS 38.304 [20]. If the field is absent, the UE applies the (default) value of 0 dB for SnonIntraSearchQ.","paragraph_zero_based":12909},{"literal_text_all_w_t_and_m_t":"s-SearchDeltaP","paragraph_zero_based":12910},{"literal_text_all_w_t_and_m_t":"Parameter \"SSearchDeltaP\" in TS 38.304 [20]. Value dB3 corresponds to 3 dB, dB6 corresponds to 6 dB and so on.","paragraph_zero_based":12911}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["6b4c02516e5a2025ecaedf9131b317a2d89727bdd423dcb20917e26be92df731","8442258a5cd21f54837ae0a1e845b843169c3239560fd66943890d77f0234575","32e69ef086a7316deb38249dcadd71e166b0247b44f201272144a95cfcb094dc","d932255e029f77efcd0578df06399ae458b2d590c9879dfe301a3bb94b552517","03f99cb9cad563357bea4830fb6e3daebc907ffe5eb3bce9da7d87cfd1299694","a66e4140f06c2baeb14924f36a1f34fa7d0fa1d3169dbd2fdacef5890a461656","1f4c68e97d48d2711b180f37c05bf88b917af47562518da29d88bf07a4e200b5","011b6db8484836c12af7d990c980032933a324bad07989a0928585782dd53117","1507eb7f8ccf488930442fabf493283f6282299696974cb929e63d67660e1b26","dec615a6efc697e410b7dd96e54c84f9c4e546dd709c1388aeb5e38b40ce1634","164d1a34e746178111e3a87bf44d8a508f38bf97d99af33e8c2fdfca019bc61f","0308bf0930cf3641e451a8f5e9487ec2802451ffbf70f09bbc2c9604c11c00c0","7610c41b391e415b319c4a6f904fab0142238661eb9232a28254b5578388313a","4d256910e7075ba883606727f0030ae979968edbb6d6ef43d9b53d9bf9f627ba","c1874d73dc0dc5ffda906f89e0dfdfcd3dd4b58d9469eeeacaa267525770f2d2","0794bd77465f8d45ea6eea3af51904c7abd6c856ef41e4ef65adc258101e6c3b","f3420bb77947ebbb64549baf13c278509a07ff0b495b943d577dbfd92a9d6086","222a398d8591e50f63af4f1d9ee5848d29d0b170e0ebfbb3b7f57837a306b931","6bd46d819184d84bc71c922b4a99c4c7a81ef60e0d2d64001bba24f3201c9b77","f30bbb41b549ce25c1c0a2f2d50d71427b71c4efdcaf8ca302d00380fdcac377","3d880b305d6a460bd7a4eaefbf4f74a083f9008b0e850b057112dd82c0ed67e9","0ea3502f10d299f95ee529f0f01a16f6f1070ca5cc651a7938d32f76695b28e7","0ab8ae31d9f45ee4943789295d19d99c0fc60a41c7b9a9072b9c6af759e0a27c","647837e4b7a9ff56f38b97733f150ad06f1beb46e741f8c1bd9bac827978a482"],"paragraph_range_zero_based":[12888,12911],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p12888"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"s-SearchDeltaP-Stationary","paragraph_zero_based":12912},{"literal_text_all_w_t_and_m_t":"Parameter \"SSearchDeltaP-Stationary\" in TS 38.304 [20]. Value dB2 corresponds to 2 dB, dB3 corresponds to 3 dB and so on.","paragraph_zero_based":12913},{"literal_text_all_w_t_and_m_t":"s-SearchThresholdP, s-SearchThresholdP2","paragraph_zero_based":12914},{"literal_text_all_w_t_and_m_t":"Parameters \"SSearchThresholdP\" and \"SSearchThresholdP2\" in TS 38.304 [20]. The network configures s-SearchThresholdP and s-SearchThresholdP2 to be less than or equal to s-IntraSearchP and s-NonIntraSearchP.","paragraph_zero_based":12915},{"literal_text_all_w_t_and_m_t":"s-SearchThresholdQ, s-SearchThresholdQ2","paragraph_zero_based":12916},{"literal_text_all_w_t_and_m_t":"Parameters \"SSearchThresholdQ\" and \"SSearchThresholdQ2\" in TS 38.304 [20]. The network configures s-SearchThresholdQ and s-SearchThresholdQ2 to be less than or equal to s-IntraSearchQ and s-NonIntraSearchQ.","paragraph_zero_based":12917},{"literal_text_all_w_t_and_m_t":"smtc","paragraph_zero_based":12918},{"literal_text_all_w_t_and_m_t":"Measurement timing configuration for intra-frequency measurement. If this field is absent, the UE assumes that SSB periodicity is 5 ms for the intra-frequnecy cells. If the field is broadcast by an NTN cell, the offset (derived from parameter periodicityAndOffset) is based on the assumption that the gNB-UE propagation delay difference between the serving cell and neighbour cells equals to 0 ms, and UE can adjust the actual offset based on the actual propagation delay difference.","paragraph_zero_based":12919},{"literal_text_all_w_t_and_m_t":"smtc2-LP","paragraph_zero_based":12920},{"literal_text_all_w_t_and_m_t":"Measurement timing configuration for intra-frequency neighbour cells with a Long Periodicity (LP) indicated by periodicity in smtc2-LP. The timing offset and duration are equal to the offset and duration indicated in smtc in intraFreqCellReselectionInfo. The periodicity in smtc2-LP can only be set to a value strictly larger than the periodicity in smtc in intraFreqCellReselectionInfo (e.g. if smtc indicates sf20 the Long Periodicity can only be set to sf40, sf80 or sf160, if smtc indicates sf160, smtc2-LP cannot be configured). The pci-List, if present, includes the physical cell identities of the intra-frequency neighbour cells with Long Periodicity. If smtc2-LP is absent, the UE assumes that there are no intra-frequency neighbour cells with a Long Periodicity.","paragraph_zero_based":12921},{"literal_text_all_w_t_and_m_t":"smtc4list","paragraph_zero_based":12922},{"literal_text_all_w_t_and_m_t":"Measurement timing configuration list for NTN deployments, see clause 5.5.2.10. The offset of each SSB-MTC4 in smtc4list is based on the assumption that the gNB-UE propagation delay difference between the serving cell and neighbour cells equals to 0 ms, and UE can adjust the actual offset based on the actual propagation delay difference. For a UE that supports less SMTCs than what is included in this list, it is up to the UE to select which SMTCs to consider.","paragraph_zero_based":12923},{"literal_text_all_w_t_and_m_t":"ssb-PositionQCL-Common","paragraph_zero_based":12924},{"literal_text_all_w_t_and_m_t":"Indicates the QCL relation between SS/PBCH blocks for intra-frequency neighbor cells as specified in TS 38.213 [13], clause 4.1.","paragraph_zero_based":12925},{"literal_text_all_w_t_and_m_t":"ssb-ToMeasure","paragraph_zero_based":12926},{"literal_text_all_w_t_and_m_t":"The set of SS blocks to be measured within the SMTC measurement duration (see TS 38.215 [9]). When the field is absent the UE measures on all SS-blocks.","paragraph_zero_based":12927},{"literal_text_all_w_t_and_m_t":"stationaryMobilityEvaluation","paragraph_zero_based":12928},{"literal_text_all_w_t_and_m_t":"Indicates the criteria for a UE to detect stationary mobility, in order to relax measurement requirements for cell reselection (see TS 38.304 [20], clause 5.2.4.9.0).","paragraph_zero_based":12929},{"literal_text_all_w_t_and_m_t":"t-ReselectionNR","paragraph_zero_based":12930},{"literal_text_all_w_t_and_m_t":"Parameter \"TreselectionNR\" in TS 38.304 [20].","paragraph_zero_based":12931},{"literal_text_all_w_t_and_m_t":"t-ReselectionNR-SF","paragraph_zero_based":12932},{"literal_text_all_w_t_and_m_t":"Parameter \"Speed dependent ScalingFactor for TreselectionNR\" in TS 38.304 [20]. If the field is absent, the UE behaviour is specified in TS 38.304 [20].","paragraph_zero_based":12933},{"literal_text_all_w_t_and_m_t":"threshServingLowP","paragraph_zero_based":12934},{"literal_text_all_w_t_and_m_t":"Parameter \"ThreshServing, LowP\" in TS 38.304 [20].","paragraph_zero_based":12935}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["d4f5fa96285530567516ecf47f6fc76f0d4765dfc31f4ad37da1d5b7486dc78b","935624b824d8667d503ddcc17ad9e5cfa922d80024c703adc661b735360e8cad","3c26e0507d08b30a8650df742a28ce6b2e4cdf7bfe5309c268945cbb45907e1b","a873c740bad614058f5c0d6edb4d618dcba4d0a14f757e5bad254b821f3bec5d","0491850511fc8f01aa5108542c4fb8e7070199675539d48b5d59a506cf11f3df","7ae8e3289da9019a51eed616af949b05782bea98420b9c5476df49391b7857b2","57d6883f7880fbd5519e1553e6f51fcd4d3f8c1183c0b7953d28b29a9a73756f","9d493eb0865c5082785743e47f349afaf6148590755d7b3f84fd1b830c382539","3f6764b34016ac747ca53a39c50b1a1604bcd2d660502accf1fd0a48bbb21697","8a7c8317d8fcee9109dacd3a9928b1c489d4414cd2e997c0e49c00db693949bd","c811d19eb9db3629a47ff3af528be0cbea37da722d92c67403d8e3e97382df2c","e9bc787defe0c7b096a6165b7d21040c6b8bc54cb2ca3b19d30d70dfffdca336","889f529b936565d6498bb6078e7779e12efc65571433a02642a8162c19f8b69b","b77cb1a71c3c67cc14625f5f982ce466353813ed2d6c02db1439c15ff7baf663","599c34c6650ae21c18b94c9473f1f188336432ba4c2bc87d1c8862ab76c58364","9063477822c7c4271fb979b46f4f4d8195bccdeb5ddc9c9ab9914c85beedf798","b6c3057f93a6b48af0facbc9722c5f33cc326b583c449a248dd748733bed5488","c1583e8e7469a2344516136e4f40a39965b036349541f99d33cea61d13a49af3","37b7db71e22f7d6a815f0c4844381c2db315eb5a6d237f9f071429e92b579a56","7c2a9a1df5583410ebda6cdcedd7cf7ed923a866f19a7dd6c102e15f7e025baf","e01fd7eb62de39535b35b22dcf0d32eccfb2fee4a54b2e44ee0277243aef862f","0d03724c03e3008dd894635088b8257f32c29022460777708cf65cdce1f7fb57","105743b5e386d011c08e5567705e95d680e979af1f1f305e5c26935a10a4f529","e4ec735a5a6d072da329648fe28556d8f4693459c8803fe356c106c4e19afe1a"],"paragraph_range_zero_based":[12912,12935],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p12912"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"threshServingLowQ","paragraph_zero_based":12936},{"literal_text_all_w_t_and_m_t":"Parameter \"ThreshServing, LowQ\" in TS 38.304 [20].","paragraph_zero_based":12937},{"literal_text_all_w_t_and_m_t":"t-SearchDeltaP","paragraph_zero_based":12938},{"literal_text_all_w_t_and_m_t":"Parameter \"TSearchDeltaP\" in TS 38.304 [20]. Value in seconds. Value s5 means 5 seconds, value s10 means 10 seconds and so on.","paragraph_zero_based":12939},{"literal_text_all_w_t_and_m_t":"t-SearchDeltaP-Stationary","paragraph_zero_based":12940},{"literal_text_all_w_t_and_m_t":"Parameter \"TSearchDeltaP-Stationary\" in TS 38.304 [20]. Value in seconds. Value s5 means 5 seconds, value s10 means 10 seconds and so on.","paragraph_zero_based":12941},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12942},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":12943},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":12944},{"literal_text_all_w_t_and_m_t":"HSDN","paragraph_zero_based":12945},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if speedStateReselectionPars is present; otherwise the field is not present.","paragraph_zero_based":12946},{"literal_text_all_w_t_and_m_t":"SharedSpectrum","paragraph_zero_based":12947},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if this intra-frequency operates with shared spectrum channel access in FR1. Otherwise, it is absent, Need R.","paragraph_zero_based":12948},{"literal_text_all_w_t_and_m_t":"SharedSpectrum2","paragraph_zero_based":12949},{"literal_text_all_w_t_and_m_t":"This field is optionally present if this intra-frequency operates with shared spectrum channel access in FR2-2, Need R. Otherwise, it is absent, Need R.","paragraph_zero_based":12950},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12951},{"literal_text_all_w_t_and_m_t":"–SIB3","paragraph_zero_based":12952},{"literal_text_all_w_t_and_m_t":"SIB3 contains neighbouring cell related information relevant only for intra-frequency cell re-selection. The IE includes cells with specific re-selection parameters as well as exclude-listed cells.","paragraph_zero_based":12953},{"literal_text_all_w_t_and_m_t":"SIB3 information element","paragraph_zero_based":12954},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":12955},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB3-START","paragraph_zero_based":12956},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12957},{"literal_text_all_w_t_and_m_t":"SIB3 ::=                            SEQUENCE {","paragraph_zero_based":12958},{"literal_text_all_w_t_and_m_t":"    intraFreqNeighCellList              IntraFreqNeighCellList                                          OPTIONAL,   -- Need R","paragraph_zero_based":12959}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["fd4cdd3cb0abc60d723913f3f68d0bf08a4ea23414296047c44e1b27cf08add7","abbca1c146de30b1eb27934da83c24bc051150587957f230ad3325a3be7a3b59","947066963b48951af1db8e6615e6366b6d9840be4858b83e90059929296d6880","cafbef31d5fde35b5619c0c3920d746fa3bd572b23e968954a20245b81c94f49","72b5de455f02899bb1c2d8f0153b4d33c4be121b7a36334ed4ce07d833b17390","46b8d3f027ba8ce1e8a2b65b808b51e0dfd4b0435d3f5cdcb326669635cedbe6","276e133433100c25882547e124ab8e94aef70a7757a648a7a7061c73071c2bce","b15441b2cf2e15ec203d725cbf174eebc4a48369f9e07e6c79096c47071473ab","9d777361704e033bc5cc4411943422b7de60c575835e2c37bed3a6c108e35c89","5c2591c5c9c8fe5eb6842a346d7490a1a5164