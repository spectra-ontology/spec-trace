{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":23328},{"literal_text_all_w_t_and_m_t":"MCC","paragraph_zero_based":23329},{"literal_text_all_w_t_and_m_t":"This field is mandatory present when PLMN-Identity is not used in a list or if it is the first entry of PLMN-Identity in a list. Otherwise it is optionally present, Need S.","paragraph_zero_based":23330},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23331},{"literal_text_all_w_t_and_m_t":"–PLMN-IdentityInfoList","paragraph_zero_based":23332},{"literal_text_all_w_t_and_m_t":"The IE PLMN-IdentityInfoList includes a list of PLMN identity information.","paragraph_zero_based":23333},{"literal_text_all_w_t_and_m_t":"PLMN-IdentityInfoList information element","paragraph_zero_based":23334},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":23335},{"literal_text_all_w_t_and_m_t":"-- TAG-PLMN-IDENTITYINFOLIST-START","paragraph_zero_based":23336},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23337},{"literal_text_all_w_t_and_m_t":"PLMN-IdentityInfoList ::=               SEQUENCE (SIZE (1..maxPLMN)) OF PLMN-IdentityInfo","paragraph_zero_based":23338},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23339},{"literal_text_all_w_t_and_m_t":"PLMN-IdentityInfo ::=                   SEQUENCE {","paragraph_zero_based":23340},{"literal_text_all_w_t_and_m_t":"    plmn-IdentityList                       SEQUENCE (SIZE (1..maxPLMN)) OF PLMN-Identity,","paragraph_zero_based":23341},{"literal_text_all_w_t_and_m_t":"    trackingAreaCode                        TrackingAreaCode                                            OPTIONAL,       -- Need R","paragraph_zero_based":23342},{"literal_text_all_w_t_and_m_t":"    ranac                                   RAN-AreaCode                                                OPTIONAL,       -- Need R","paragraph_zero_based":23343},{"literal_text_all_w_t_and_m_t":"    cellIdentity                            CellIdentity,","paragraph_zero_based":23344},{"literal_text_all_w_t_and_m_t":"    cellReservedForOperatorUse              ENUMERATED {reserved, notReserved},","paragraph_zero_based":23345},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":23346},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":23347},{"literal_text_all_w_t_and_m_t":"    iab-Support-r16                     ENUMERATED {true}                                               OPTIONAL       -- Need S","paragraph_zero_based":23348},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":23349},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":23350},{"literal_text_all_w_t_and_m_t":"    trackingAreaList-r17                SEQUENCE (SIZE (1..maxTAC-r17)) OF TrackingAreaCode             OPTIONAL,      -- Need R","paragraph_zero_based":23351}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["ae58d53dc55a2883a63a1cf4eb1c485a1774e25cd211224d28008dd9b4c152b4","7ff57b34a3c120226f641a476d79fb4427d4ec58dc318f41bcb7ea2bc5d33723","66254ade4e5d8b7296bcc70d7c1aa6d502604ee0fa1c50582735a3f6dcafb828","3dd8f1cdd9dcf1443f7d9595cce13c65ce58a2912e1e43a5de3e87a71c274c0c","00f3f4f736031b53cb63da0361fd8be6493f050f9838a7ae4be688a1b5bee8f5","16c1db23cfed40991112afba7d432109499a4ae554ada9c13c14dbbde5854b4f","1a831c40d893e45e6826cddb3ca9b20f3e208d16d393a99f3727f89fdd83d51f","ff42ab533e43d2529358d46c58ac183ecd4128db9b3f5b0d652ff176c960f380","b82ecf93fdb303f38cd3522dcff45b7a748211ffa9c87436b81ddd142526af7f","449ec62709a023f00722e8bd8f77a85f03a921eab17970d