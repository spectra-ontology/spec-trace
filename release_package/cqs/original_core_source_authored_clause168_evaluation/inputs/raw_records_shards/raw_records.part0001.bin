{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SL-ResourcePoolConfig-r16 ::=    SEQUENCE {","paragraph_zero_based":37200},{"literal_text_all_w_t_and_m_t":"    sl-ResourcePoolID-r16            SL-ResourcePoolID-r16,","paragraph_zero_based":37201},{"literal_text_all_w_t_and_m_t":"    sl-ResourcePool-r16              SL-ResourcePool-r16                                                  OPTIONAL    -- Need M","paragraph_zero_based":37202},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37203},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37204},{"literal_text_all_w_t_and_m_t":"SL-ResourcePoolID-r16 ::=        INTEGER (1..maxNrofPoolID-r16)","paragraph_zero_based":37205},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37206},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-BWP-POOLCONFIG-STOP","paragraph_zero_based":37207},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":37208},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37209},{"literal_text_all_w_t_and_m_t":"SL-BWP-PoolConfig field descriptions","paragraph_zero_based":37210},{"literal_text_all_w_t_and_m_t":"sl-RxPool","paragraph_zero_based":37211},{"literal_text_all_w_t_and_m_t":"Indicates the receiving resource pool on the configured BWP. For the PSFCH related configuration, if configured, will be used for PSFCH transmission/reception. If the field is included, it replaces any previous list, i.e. all the entries of the list are replaced and each of the SL-ResourcePool entries is considered to be newly created.","paragraph_zero_based":37212},{"literal_text_all_w_t_and_m_t":"sl-TxPoolExceptional","paragraph_zero_based":37213},{"literal_text_all_w_t_and_m_t":"Indicates the resources by which the UE is allowed to perform NR sidelink transmission in exceptional conditions on the configured BWP. For the PSFCH related configuration, if configured, will be used for PSFCH transmission/reception.","paragraph_zero_based":37214},{"literal_text_all_w_t_and_m_t":"sl-TxPoolScheduling","paragraph_zero_based":37215},{"literal_text_all_w_t_and_m_t":"Indicates the resources by which the UE is allowed to perform NR sidelink transmission based on network scheduling on the configured BWP. For the PSFCH related configuration, if configured, will be used for PSFCH transmission/reception.","paragraph_zero_based":37216},{"literal_text_all_w_t_and_m_t":"sl-TxPoolSelectedNormal","paragraph_zero_based":37217},{"literal_text_all_w_t_and_m_t":"Indicates the resources by which the UE is allowed to perform NR sidelink transmission by UE autonomous resource selection on the configured BWP. For the PSFCH related configuration, if configured, will be used for PSFCH transmission/reception.","paragraph_zero_based":37218},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37219},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":37220},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":37221},{"literal_text_all_w_t_and_m_t":"HO","paragraph_zero_based":37222},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need M, in an RRCReconfiguration message including reconfigurationWithSync; otherwise it is absent, Need M.","paragraph_zero_based":37223}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["3dd0e2a0479052ff9f9e8ca0eeca01ec7c51a4a2339ba27393d6d3873e0ebbac","1572a012b0b64d0f43cdb4c46bd21de5947bd310f8744b34f160a6aacbb0b69a","6ea9503c286f2a2429e68c1d7321d1194174c2631d32fed7ce8e8f5545ace370","75ca5711e689ddfa4daa23dfc4e9f44b66dc1635d3d15c2f4