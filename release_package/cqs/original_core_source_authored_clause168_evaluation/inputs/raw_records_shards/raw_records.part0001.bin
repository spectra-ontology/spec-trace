{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25920},{"literal_text_all_w_t_and_m_t":"ReportCGI-EUTRA field descriptions","paragraph_zero_based":25921},{"literal_text_all_w_t_and_m_t":"useAutonomousGaps","paragraph_zero_based":25922},{"literal_text_all_w_t_and_m_t":"Indicates whether or not the UE is allowed to use autonomous gaps in acquiring system information from the E-UTRAN neighbour cell. When the field is included, the UE applies the corresponding value for T321.","paragraph_zero_based":25923},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25924},{"literal_text_all_w_t_and_m_t":"EventTriggerConfigInterRAT field descriptions","paragraph_zero_based":25925},{"literal_text_all_w_t_and_m_t":"b2-Threshold1","paragraph_zero_based":25926},{"literal_text_all_w_t_and_m_t":"NR threshold to be used in inter RAT measurement report triggering condition for event B2.","paragraph_zero_based":25927},{"literal_text_all_w_t_and_m_t":"bN-ThresholdEUTRA","paragraph_zero_based":25928},{"literal_text_all_w_t_and_m_t":"E-UTRA threshold value associated with the selected trigger quantity (RSRP, RSRQ, SINR) to be used in inter RAT measurement report triggering condition for event number bN. In the same eventB2, the network configures the same CHOICE name (rsrp, rsrq or sinr) for the MeasTriggerQuantity of the b2-Threshold1 and for the MeasTriggerQuantityEUTRA of the b2-Threshold2EUTRA.","paragraph_zero_based":25929},{"literal_text_all_w_t_and_m_t":"eventId","paragraph_zero_based":25930},{"literal_text_all_w_t_and_m_t":"Choice of inter RAT event triggered reporting criteria.","paragraph_zero_based":25931},{"literal_text_all_w_t_and_m_t":"maxReportCells","paragraph_zero_based":25932},{"literal_text_all_w_t_and_m_t":"Max number of non-serving cells/candidate L2 U2N Relay UEs to include in the measurement report.","paragraph_zero_based":25933},{"literal_text_all_w_t_and_m_t":"reportAmount","paragraph_zero_based":25934},{"literal_text_all_w_t_and_m_t":"Number of measurement reports applicable for eventTriggered as well as for periodical report types","paragraph_zero_based":25935},{"literal_text_all_w_t_and_m_t":"reportOnLeave","paragraph_zero_based":25936},{"literal_text_all_w_t_and_m_t":"Indicates whether or not the UE shall initiate the measurement reporting procedure when the leaving condition is met for a cell in cellsTriggeredList, as specified in 5.5.4.1.","paragraph_zero_based":25937},{"literal_text_all_w_t_and_m_t":"reportQuantity, reportQuantityUTRA-FDD","paragraph_zero_based":25938},{"literal_text_all_w_t_and_m_t":"The cell measurement quantities to be included in the measurement report. If the field eventB1-UTRA-FDD or eventB2-UTRA-FDD is present, the UE shall ignore the value(s) provided in reportQuantity.","paragraph_zero_based":25939},{"literal_text_all_w_t_and_m_t":"reportQuantityRelay","paragraph_zero_based":25940},{"literal_text_all_w_t_and_m_t":"The L2 U2N Relay UE measurement quantity to be included in measuremet report.","paragraph_zero_based":25941},{"literal_text_all_w_t_and_m_t":"timeToTrigger","paragraph_zero_based":25942},{"literal_text_all_w_t_and_m_t":"Time during which specific criteria for the event needs to be met in order to trigger a measurement report.","paragraph_zero_based":25943}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["46ccf0cdbe8fdcd8f94be76c1572933dca3e09a63f1085445bd0a309c7685231","a7ec052a19b3d5a358be1bdea11ca1e1646b0e49fe36e67dfe3fd5ecfabcc777","a4fe4795b02be4c8e73e0f23e59279f439dfb68cb610fd006bec4ada8050812b","20923ae6613f47d9040dea093eef71b11004ca8766aaf555089ba11c034ea0c5","82d73eed252d8079d8daaa13c161cbdd5ff7e3aa04ce1473e062f12f249ed227","3d74140ddaf8ccb7086e3d2911faff0199d20ecb94fbb4e8d6b9b7c007bb2850","1a803206788581b013a48b67db6e632265b0b89bc620bec33ce549f22fb24120","8c5214783a49171bb51cbce87f5a32df0b919356e2865eb07505e0e9a0b61734","30d878700977edca4a1058ffd8708c2b84ecdb8cc558e0850dfcdc64a369a713","d1c7d776efbb869184077c202d05dfa2e41fcde84c70eed40a4a2f94d4de570d","d9cc1675960b00a30a8b2e4726e2ce422fd639195d3cb41d56496e652c607aad","b0a6bec1967a0fc2c748874ace230dbd81afe4935e0a44afabc33d2e65969e21","3c35258646f4cb768ba02adebcef25a023bc38016aa0bdd5135061bc52a5b7e5","14072dd1224303713713d79ba8ef0054e35078b70d4d7e3e6d67551cba485f73","4d6767e34fde5accaabda837accdbf3db70f34de588a584f80372a1419accd3d","a6e1d46b075efd55de0b75f317812a6d9b3014dac3ce81c50bb4275a57efb368","cf9ca6142b747f8b284d5e0c4ed00da07813f9a4e15bc2ea8479cb48809f74e8","f171b251ff2301e207d121082d6c8a85e48ad32e7f020d797c3ef0ec00481655","8db2771a512700533cb33887f3dac12760882d414f98711b35af104146e1622c","8c0453b1825635b6549f67c0c4115f76835aea6c2b4ec2ecefbe0947c84d3ed4","0e1acb1a35ffc9131d0642949a1cb46afcbbbba2158ba8ca1431b5bb4e9817be","eaea256dab1df16cf0cff4049f17d1a92d6b9f1236844d7e9078b0f95b9151d1","b84f7ba9c65c933e1100642d80b2164824b59810cc2574107c82591c672f04c8","1aba73c2023047c1ca0d7ed6ceabf7f155de19d5cfb197fe1061c8b8a009dae6"],"paragraph_range_zero_based":[25920,25943],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p25920"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"bN-ThresholdUTRA-FDD","paragraph_zero_based":25944},{"literal_text_all_w_t_and_m_t":"UTRA-FDD threshold value associated with the selected trigger quantity (RSCP, EcN0) to be used in inter RAT measurement report triggering condition for event number bN.","paragraph_zero_based":25945},{"literal_text_all_w_t_and_m_t":"utra-FDD-RSCP corresponds to CPICH_RSCP in TS 25.133 [46] for FDD. utra-FDD-EcN0 corresponds to CPICH_Ec/No in TS 25.133 [46] for FDD.","paragraph_zero_based":25946},{"literal_text_all_w_t_and_m_t":"For utra-FDD-RSCP: The actual value is field value – 115 dBm.","paragraph_zero_based":25947},{"literal_text_all_w_t_and_m_t":"For utra-FDD-EcN0: The actual value is (field value – 49)/2 dB.","paragraph_zero_based":25948},{"literal_text_all_w_t_and_m_t":"y1-Threshold1","paragraph_zero_based":25949},{"literal_text_all_w_t_and_m_t":"NR threshold to be used in measurement report triggering condition for event Y1.","paragraph_zero_based":25950},{"literal_text_all_w_t_and_m_t":"yN-Threshold2-Relay","paragraph_zero_based":25951},{"literal_text_all_w_t_and_m_t":"L2 U2N Relay threshold value associated with the selected trigger quantity (i.e. RSRP) to be used in measurement report triggering condition for event number YN.","paragraph_zero_based":25952},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25953},{"literal_text_all_w_t_and_m_t":"PeriodicalReportConfigInterRAT field descriptions","paragraph_zero_based":25954},{"literal_text_all_w_t_and_m_t":"maxReportCells","paragraph_zero_based":25955},{"literal_text_all_w_t_and_m_t":"Max number of non-serving cells/candidate L2 U2N Relay UEs to include in the measurement report.","paragraph_zero_based":25956},{"literal_text_all_w_t_and_m_t":"reportAmount","paragraph_zero_based":25957},{"literal_text_all_w_t_and_m_t":"Number of measurement reports applicable for eventTriggered as well as for periodical report types","paragraph_zero_based":25958},{"literal_text_all_w_t_and_m_t":"reportQuantity, reportQuantityUTRA-FDD","paragraph_zero_based":25959},{"literal_text_all_w_t_and_m_t":"The cell measurement quantities to be included in the measurement report. If the field reportQuantityUTRA-FDD is present, the UE shall ignore the value(s) provided in reportQuantity.","paragraph_zero_based":25960},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25961},{"literal_text_all_w_t_and_m_t":"–ReportConfigNR","paragraph_zero_based":25962},{"literal_text_all_w_t_and_m_t":"The IE ReportConfigNR specifies criteria for triggering of an NR measurement reporting event or of a CHO, CPA or CPC event or of an L2 U2N relay measurement reporting event. For events labelled AN with N equal to 1, 2 and so on, measurement reporting events and CHO, CPA or CPC events are based on cell measurement results, which can either be derived based on SS/PBCH block or CSI-RS.","paragraph_zero_based":25963},{"literal_text_all_w_t_and_m_t":"Event A1:Serving becomes better than absolute threshold;","paragraph_zero_based":25964},{"literal_text_all_w_t_and_m_t":"Event A2:Serving becomes worse than absolute threshold;","paragraph_zero_based":25965},{"literal_text_all_w_t_and_m_t":"Event A3:Neighbour becomes amount of offset better than PCell/PSCell;","paragraph_zero_based":25966},{"literal_text_all_w_t_and_m_t":"Event A4:Neighbour becomes better than absolute threshold;","paragraph_zero_based":25967}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["d58752be4ac64d3e8eda6adca810987ba3b31c078d99fccb88f00a0293223869","09229e48abe0