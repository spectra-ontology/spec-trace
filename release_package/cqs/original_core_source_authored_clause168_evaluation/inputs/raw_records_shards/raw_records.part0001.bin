{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":17856},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":17857},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17858},{"literal_text_all_w_t_and_m_t":"-- TAG-DL-PPW-PRECONFIG-STOP","paragraph_zero_based":17859},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17860},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17861},{"literal_text_all_w_t_and_m_t":"DL-PPW-PreConfig field descriptions","paragraph_zero_based":17862},{"literal_text_all_w_t_and_m_t":"dl-PPW-ID","paragraph_zero_based":17863},{"literal_text_all_w_t_and_m_t":"Indicates the pre-configured ID for DL-PRS processing window configuration.","paragraph_zero_based":17864},{"literal_text_all_w_t_and_m_t":"dl-PPW-PeriodicityAndStartSlot","paragraph_zero_based":17865},{"literal_text_all_w_t_and_m_t":"Indicates the periodicity in slots and the offset of the starting slot with respect to SFN #0 slot #0 of the serving cell where the DL-PRS processing window is configured.","paragraph_zero_based":17866},{"literal_text_all_w_t_and_m_t":"length","paragraph_zero_based":17867},{"literal_text_all_w_t_and_m_t":"Indicates the length of DL-PRS processing window in slots. Value 1 indicates length of one slot, value 2 indicates length of two slots and so on.","paragraph_zero_based":17868},{"literal_text_all_w_t_and_m_t":"priority","paragraph_zero_based":17869},{"literal_text_all_w_t_and_m_t":"Indicates the priority between PDCCH/PDSCH/CSI-RS and PRS as specified in TS 38.214 [19].","paragraph_zero_based":17870},{"literal_text_all_w_t_and_m_t":"type","paragraph_zero_based":17871},{"literal_text_all_w_t_and_m_t":"Indicates the DL-PRS processing window type as specified in TS 38.214 [19].","paragraph_zero_based":17872},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17873},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":17874},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":17875},{"literal_text_all_w_t_and_m_t":"MultiType","paragraph_zero_based":17876},{"literal_text_all_w_t_and_m_t":"The field is mandatory present when the UE reports its capability on supporting multiple processing types, otherwise it is absent.","paragraph_zero_based":17877},{"literal_text_all_w_t_and_m_t":"MultiState","paragraph_zero_based":17878},{"literal_text_all_w_t_and_m_t":"The field is mandatory present when the UE reports its capability on supporting option 1 or option 2 for the configured type, otherwise it is absent.","paragraph_zero_based":17879}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["41259de68815d33b5a45d471b876646b7291c13bd7713de43442ed54ca2b7ad2","02fcf77ac63b9e07bcecbecace27eec3f71a9070d8a39a99af8e28b3cd13f65b","156d1f51c972d4bac4c8225a77d00b5037473acde9c365a35d193f7dfd81631f","a56cf5c190d510903187c3571136d1eb3164cd1d0cbddd0a25c05402fb3d69a8","a705b88d76520fc62d6db0dcad1c8789cfe6a4a83ad0f2bed34d13b2f0d167ff","f966fb61d0cb9422f1524898fdbe30ccecb4d9f34d49bb173ec43bb42f961a67","4e0caa361fb649552d7952911c67c0ec0ce5e56d3174343d68c3dceef87305a7","257e9ba4f8da396de3cdf5ad4031d0e2319c75cbea82b046dac6c9ca0956775a","e81468c85739620bd21e4965fdcaf96c2298ad9dfcd1d41899d2c50cfa63682f","5f76305869c9ed9d0997ef950609827db710849728857e0ab0b7c8e6f77de301","3afdc4a8414ca6b379d154a6a271ad8ca35c92c221ad325caa45746af762f522","eb516f92d1bcda82e9bc444d5fbe32eac94592315108cf57a65704434dc4311f","17228d429c7f17afc9fa9ecf4155882a34735d0fa14597358d8f85de944e250d","dc12bae8faeaa293f76fe4087087cf3a35da7e92b6a772d6ff215451653c99e6","6763fc4cb118ded85cb5746ab138bc41f37539786a0aa3219608b0b8c13fa4df","f1da04ee170135f11e1700ec5eba190e43c91fa3dbc0105e59e3b1511f013d75","3a6d19a49713e0fea2bcd5068f962ac501a75fe3ef9653b29f9dc91bd27491c8","070aa0b5c2bb357f4dfa02b0d9a338d2f4ddf6ce237bb8e9af7729b4bd41a19c","afb0110098e43b86bf7854248415ff4afa1e2f2bf7c715d11b9dbe6bad930778","5f5df87e5a78839989a4bb6547de7abe6830f2c805202ed6721e402752149e69","9171eab56af08e46171ec6c1789f6e8b08b3058d2607aa23ec5a5afd39fa0607","1d0d0d408c292ffccc92a7e9d9c4f4c6ec8a176e8fabc50be17532ec09b17b4e","44a4df653965f14d3b09b26ffa61ad047eb5888a87d8d07c096b9a39e908d986","b481f8f65a062cb2f55cc48cf258caeb661406e0960ee896976df3e55294fbb1"],"paragraph_range_zero_based":[17856,17879],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p17856"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17880},{"literal_text_all_w_t_and_m_t":"–DMRS-BundlingPUCCH-Config","paragraph_zero_based":17881},{"literal_text_all_w_t_and_m_t":"The IE DMRS-BundlingPUCCH-Config-r17 is used to configure DMRS bundling for PUCCH.","paragraph_zero_based":17882},{"literal_text_all_w_t_and_m_t":"DMRS-BundlingPUCCH-Config information element","paragraph_zero_based":17883},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17884},{"literal_text_all_w_t_and_m_t":"-- TAG-DMRS-BUNDLINGPUCCH-CONFIG-START","paragraph_zero_based":17885},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17886},{"literal_text_all_w_t_and_m_t":"DMRS-BundlingPUCCH-Config-r17 ::=         SEQUENCE {","paragraph_zero_based":17887},{"literal_text_all_w_t_and_m_t":"    pucch-DMRS-Bundling-r17                   ENUMERATED {enabled}                                            OPTIONAL,   -- Need R","paragraph_zero_based":17888},{"literal_text_all_w_t_and_m_t":"    pucch-TimeDomainWindowLength-r17          INTEGER (2..8)                                                  OPTIONAL,   -- Need S","paragraph_zero_based":17889},{"literal_text_all_w_t_and_m_t":"    pucch-WindowRestart-r17                   ENUMERATED {enabled}                                            OPTIONAL,   -- Need R","paragraph_zero_based":17890},{"literal_text_all_w_t_and_m_t":"    pucch-FrequencyHoppingInterval-r17        ENUMERATED {s2, s4, s5, s10}                                    OPTIONAL,   -- Need S","paragraph_zero_based":17891},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":17892},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":17893},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17894},{"literal_text_all_w_t_and_m_t":"-- TAG-DMRS-BUNDLINGPUCCH-CONFIG-STOP","paragraph_zero_based":17895},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17896},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17897},{"literal_text_all_w_t_and_m_t":"DMRS-BundlingPUCCH-Config field descriptions","paragraph_zero_based":17898},{"literal_text_all_w_t_and_m_t":"pucch-DMRS-Bundling","paragraph_zero_based":17899},{"literal_text_all_w_t_and_m_t":"Indicates whether DMRS bundling and time domain window for PUCCH are jointly enabled.","paragraph_zero_based":17900},{"literal_text_all_w_t_and_m_t":"pucch-FrequencyHoppingInterval","paragraph_zero_based":17901},{"literal_text_all_w_t_and_m_t":"Configures the number of consecutive slots for the UE to perform inter-slot frequency hopping with inter-slot bundling for PUCCH. When both inter-frequency hopping and DMRS bundling are enabled for PUCCH repetitions, the UE is expected to be configured with at least one pucch-FrequencyHoppingInterval-r17 and pucch-TimeDomainWindowLength-r17. When DMRS bundling for PUCCH is enabled by pucch-DMRS-Bundling-r17, PUCCH frequency hopping interval is only determined by the configuration of PUCCH hopping interval if PUCCH hopping interval is configured. If the field is absent, the number of consecutive slots for the UE to perform inter-slot PUCCH frequency hopping is indicated by pucch-TimeDomainWindowLength-r17.","paragraph_zero_based":17902},{"literal_text_all_w_t_and_m_t":"pucch-TimeDomainWindowLength","paragraph_zero_based":17903}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["4d4ff644bb8d504ecd7b613278430fedb1334b907456bd5ec4fbda4cee33c1ed","e020864c8c94dbabb95a4aeb4f821fb4ffd277d7662b9d3cac0e82270d95b14e","9047dc1934892eced0fdd77a543eb913ae44c94ab1149c31c9d52ccd944ff8a9","a71576c96d78a5f2e1c1df4cdb6b62d19adc47c119643716852efc23d4cccc78","b1d1c8da8c3bccb66dd27fe924d3114308108319f621ed983f13ae967cbb3c73","dd57da6ae333766b4bb38f83fb61414753ee7d1d5b8bbcd3a2c471dda458e86b","0d5e575d154c0236501c2ca558e0a30d8686869cadb8d1bfeb02ea825544e75e","a7e7f961bcf1c34d23fb86217e76bb8f49d73c5bbeb4bbec02dd9bc9a53b1ef3","ed3f00c83c44f0d505724cdcde2683d5ef026a5318d7b4dca8568db054082335","312809240b130eaa04577df4c24878865f7c79df437cede6440aaae3566d23fb","4227f3fbc5369a5455462d34bcf6cb6a951a30f1003365a4b02a8da984c53430","ae9fdc926ce50f49b09b2061b03ef064eccfe5d8d33d9b88abd3fbae51cdcfc9","ecdd0aa8c52b53efd30863cfbd863358a0d6d278f3463eac055436a3c8baf44c","df8753a889e2cdc0eb7f5cf8fa37b0e8c453df7de9b4a702ceee364484301b2e","8ce360c3b173f602338990eff0910f18a9e97c26a4664d03245b29926002c917","2c3f4e36e0acfe7e879dbad90df344e12f17d59939b9724baaccc238373308d9","db1b894b32287fd81328afe1e99fbcb94eb0e5546ccf69d81a38dc7f5d1ec692","780b1e9efa496ad506804a27ad8e4cffa2f98590c69ad533da9ae212b0795a37","0df825e33a94da9992fa179ff37a29d18d8a85cb07afb2dca50a308dfd90c170","8e25f9d9f9482e12440c08c3875f95d894e5291b303174fdc75d5212883b74f8","8b16d7ee537ff537411c39d0c27455bdddf28a40f6d5011e6951f3311e006aa9","de1f2ff1f57ce19cead7350e7d34d18310d8bc242f8d16eb9f21649ce1cf47be","05c1606e63d4c38975b5decc296264d138686a020fdf7842d0211e85c1c1c7b8","e1af2910548b3a2cab6427899b70a221741b73bfd47419cb6b66eae11b4e6753"],"paragraph_range_zero_based":[17880,17903],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p17880"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Configures the length of a nominal time domain window in slots for DMRS bundling for PUCCH. The value shall not exceed the maximum duration for DMRS bundling for PUCCH as specified in TS 38.306 [26]. If this field is absent, the UE shall apply the default value that is the minimum value in the unit of consecutive slots of the time duration for the transmission of all PUCCH repetitions and the maximum duration for DMRS bundling for PUCCH as specified in TS 38.306 [26].","paragraph_zero_based":17904},{"literal_text_all_w_t_and_m_t":"pucch-WindowRestart","paragraph_zero_based":17905},{"literal_text_all_w_t_and_m_t":"Indicates whether UE bundles PUCCH DMRS remaining in a nominal time domain window after event(s) triggered by DCI or MAC CE that violate power consistency and phase continuity requirements is enabled (see TS 38.214 [19], clause 6.1.7).","paragraph_zero_based":17906},{"literal_text_all_w_t_and_m_t":"NOTE:Events, which are triggered by DCI or MAC CE, but do not require UE capability to resume maintaining power consistency and/or phase continuity as specified in clause 6.1.7 of TS 38.214 [19], are excluded.","paragraph_zero_based":17907},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17908},{"literal_text_all_w_t_and_m_t":"–DMRS-BundlingPUSCH-Config","paragraph_zero_based":17909},{"literal_text_all_w_t_and_m_t":"The IE DMRS-BundlingPUSCH-Config-r17 is used to configure DMRS bundling for PUSCH.","paragraph_zero_based":17910},{"literal_text_all_w_t_and_m_t":"DMRS-BundlingPUSCH-Config information element","paragraph_zero_based":17911},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17912},{"literal_text_all_w_t_and_m_t":"-- TAG-DMRS-BUNDLINGPUSCH-CONFIG-START","paragraph_zero_based":17913},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17914},{"literal_text_all_w_t_and_m_t":"DMRS-BundlingPUSCH-Config-r17 ::=          SEQUENCE {","paragraph_zero_based":17915},{"literal_text_all_w_t_and_m_t":"    pusch-DMRS-Bundling-r17                    ENUMERATED {enabled}                                            OPTIONAL,   -- Need R","paragraph_zero_based":17916},{"literal_text_all_w_t_and_m_t":"    pusch-TimeDomainWindowLength-r17           INTEGER (2..32)                                                 OPTIONAL,   -- Need S","paragraph_zero_based":17917},{"literal_text_all_w_t_and_m_t":"    pusch-WindowRestart-r17                    ENUMERATED {enabled}                                            OPTIONAL,   -- Need R","paragraph_zero_based":17918},{"literal_text_all_w_t_and_m_t":"    pusch-FrequencyHoppingInterval-r17         ENUMERATED {s2, s4, s5, s6, s8, s10, s12, s14, s16, s20}        OPTIONAL,   -- Need S","paragraph_zero_based":17919},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":17920},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":17921},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17922},{"literal_text_all_w_t_and_m_t":"-- TAG-DMRS-BUNDLINGPUSCH-CONFIG-STOP","paragraph_zero_based":17923},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17924},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17925},{"literal_text_all_w_t_and_m_t":"DMRS-BundlingPUSCH-Config field descriptions","paragraph_zero_based":17926},{"literal_text_all_w_t_and_m_t":"pusch-DMRS-Bundling","paragraph_zero_based":17927}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["9fc7190ef77fac6e2054b667bdd5306b99d507883dfdd2acd790b3afe43112d0","403631171e59ae39d3cf5a32f226657d7eaa6a9237ca39be0d25b9baa5278186","0b935463088652e6661db567fed20a1518686cd41d3bb161c2219fede0db814d","e799b07a69615677ccb081168df2741104d13a115547427f1be84493a777d43e","77ed9b241bb77e364c30d5c376908a731c9fce40cd346f3c615c2d981de8ba2d","d70322d69a8321b9713171b40263e6d5e7e0e257600f81084f2d91ea050349eb","cce4086269c36c6c287bd1faf468d8ef2bd94d28bd5e90ed02cd41f652eb393f","dc7ac4a4a627bd2d5d24e66425321a9afe8c00d31621a06d360be9ff247a8630","1457b18ce6af847831993133c70be11442d0e7229c24fcd3a7b6ea9fd8d8070c","683e80256c78bb48ad5df36d5ba0a09b65ce4895a35dcf2aed69497d8e4e081b","e9ae74e10b7b3c5648796785e896815fc042581cb33e3c8411c659122300dbee","0bda145997f2cfdc252b7dcfc05a79d1305aa68fb263ba2fd274e38cabedd962","91e3b672bd865bc931edcbdc55a6ddd652a41428ccc37af9cd9991df582ff88f","6a794e70aad348629b1083fde462523784ad70fc10c61b6098e1c7ba8bddc206","0b691a23a9767b56245a0fdb2f34b1533de006a35895a6d09ba77689de978e32","948d93b92198dfceb5da021ee5f1e0629e8ec03b24ba8c71003d2de3f2ec17f3","f193c32794f471e2ba0dc9541993aaea0a2bdfe7b08249a8c8105c0888f4bca1","4add0752437846da5ebd9cd86b0fea9fded6a189c713c9ee4b80ea3036ca4e7e","e3a527c32c645c5b287e7a683ef5d8d76bd3978de33dacd15256465af3e7bd67","6bbcd83c1e058b18c4ac4faa7798c91ea49aaaea675577997868aa44e8c025eb","94bfc695f3621ef3796c7eb83137d5acfbebdd208e7ca925b93010e0c812ceeb","8c7972e60d41cfeab7b9191614ea50547e3853685d3de6c636db5612b752997c","24f1be5ea76e92c412ad26d118a79a3cca2427a0f2f8cc7c71b58abd03b1b224","5df1a2140a6f7d57f3097b8b7a200fb7a7486d3f5df696f21994ba474498b55c"],"paragraph_range_zero_based":[17904,17927],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p17904"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether DMRS bundling and time domain window for PUSCH are jointly enabled.","paragraph_zero_based":17928},{"literal_text_all_w_t_and_m_t":"pusch-FrequencyHoppingInterval","paragraph_zero_based":17929},{"literal_text_all_w_t_and_m_t":"Configures the number of consecutive slots for the UE to perform inter-slot frequency hopping with inter-slot bundling for PUSCH. When both inter-frequency hopping and DMRS bundling are enabled for PUSCH repetitions, the UE is expected to be configured with at least one pusch-FrequencyHoppingInterval-r17 and pusch-TimeDomainWindowLength-r17. This parameter is shared for both DG-PUSCH and CG-PUSCH. When DMRS bundling for PUSCH is enabled by pusch-DMRS-Bundling-r17, PUSCH frequency hopping interval is only determined by the configuration of PUSCH hopping interval if PUSCH hopping interval is configured. If the field is absent, the number of consecutive slots for the UE to perform inter-slot PUSCH frequency hopping is indicated by pusch-TimeDomainWindowLength-r17.","paragraph_zero_based":17930},{"literal_text_all_w_t_and_m_t":"Note: For unpaired spectrum, the UE is not expected to be configured the value of s6, s8, s12, s14 and s16.","paragraph_zero_based":17931},{"literal_text_all_w_t_and_m_t":"pusch-TimeDomainWindowLength","paragraph_zero_based":17932},{"literal_text_all_w_t_and_m_t":"Configures the length of a nominal time domain window in number of consecutive slots for DMRS bundling for PUSCH. The value shall not exceed the maximum duration for DMRS bundling for PUSCH as specified in TS 38.306 [26]. For PUSCH repetition type A/B, if this field is absent, the UE shall apply the default value that is the minimum value in the unit of consecutive slots of the time duration for the transmission of all PUSCH repetitions and the maximum duration for DMRS bundling for PUSCH as specified in TS 38.306 [26]. For TBoMS, if this field is absent, the UE shall apply the default value that is the minimum value in the unit of consecutive slots of the duration of TBoMS transmission (including repetition of TBoMS) and the maximum duration for DMRS bundling for PUSCH as specified in TS 38.306 [26].","paragraph_zero_based":17933},{"literal_text_all_w_t_and_m_t":"pusch-WindowRestart","paragraph_zero_based":17934},{"literal_text_all_w_t_and_m_t":"Indicates whether UE bundles PUSCH DMRS remaining in a nominal time domain window after event(s) triggered by DCI or MAC CE that violate power consistency and phase continuity requirements is enabled (see TS 38.214 [19], clause 6.1.7).","paragraph_zero_based":17935},{"literal_text_all_w_t_and_m_t":"NOTE:Events, which are triggered by DCI or MAC CE, but do not require UE capability to resume maintaining power consistency and/or phase continuity as specified in clause 6.1.7 of TS 38.214 [19], are excluded.","paragraph_zero_based":17936},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17937},{"literal_text_all_w_t_and_m_t":"–DMRS-DownlinkConfig","paragraph_zero_based":17938},{"literal_text_all_w_t_and_m_t":"The IE DMRS-DownlinkConfig is used to configure downlink demodulation reference signals for PDSCH.","paragraph_zero_based":17939},{"literal_text_all_w_t_and_m_t":"DMRS-DownlinkConfig information element","paragraph_zero_based":17940},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17941},{"literal_text_all_w_t_and_m_t":"-- TAG-DMRS-DOWNLINKCONFIG-START","paragraph_zero_based":17942},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17943},{"literal_text_all_w_t_and_m_t":"DMRS-DownlinkConfig ::=             SEQUENCE {","paragraph_zero_based":17944},{"literal_text_all_w_t_and_m_t":"    dmrs-Type                           ENUMERATED {type2}                                                      OPTIONAL,   -- Need S","paragraph_zero_based":17945},{"literal_text_all_w_t_and_m_t":"    dmrs-AdditionalPosition             ENUMERATED {pos0, pos1, pos3}                                           OPTIONAL,   -- Need S","paragraph_zero_based":17946},{"literal_text_all_w_t_and_m_t":"    maxLength                           ENUMERATED {len2}                                                       OPTIONAL,   -- Need S","paragraph_zero_based":17947},{"literal_text_all_w_t_and_m_t":"    scramblingID0                       INTEGER (0..65535)                                                      OPTIONAL,   -- Need S","paragraph_zero_based":17948},{"literal_text_all_w_t_and_m_t":"    scramblingID1                       INTEGER (0..65535)                                                      OPTIONAL,   -- Need S","paragraph_zero_based":17949},{"literal_text_all_w_t_and_m_t":"    phaseTrackingRS                     SetupRelease { PTRS-DownlinkConfig  }                                   OPTIONAL,   -- Need M","paragraph_zero_based":17950},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":17951}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["6ac68262f32fceecc9a2b7da55417fafdb945d5878e996f93e3d6fb9e26720b5","88113fa83149e4b1da16f2dab9921bcd06aa4dcecda9155111cf2af8bb735ff9","46242a135335c487cb96d76eeb09f582be4a2ea53b58d800d31600c8f9e4ec0b","8b81160827cf7658f5b9ab06c5544dbb231d75ab4dbc621646ddcf39e32a8f89","8f25ef7371aff53e6df04f4c349a6419cb1c057e42db2cc8b1da9ee16ef76838","58f5d73a51e968bd9cb8562e7fcc1b7de1b239a92a4555a024f2f46246cf0f18","04860b0624f8ce78b205c5379fce9efeb1c878ab574433a47af810f0716780c1","9ac589e03360185fc866af3ddf6cc9eee411682c15ee78288f6eefbae648aa93","2bb3663677afd2f9324c50466794d0b291b75eb1dd568340a51de5433d9b0cc7","8ddf1f86c542c6d7b31ae7947d052379d13ac999274bf282cf6ef8e29195cf90","bdaabd15dec9592c2bc58fed29a1b06fa2722de19092aa30cdb2ae44b8a72cc3","5e8335c1804543fbce3c9da6ba219379c5d5a4bbd32d275095548090e596f08a","64b07b257501244f48a98b5b4e4f25d9dba90d87330bc7b120994778cb553cbd","d484ecb26534a0e78bdcc9c16a038e806997d65fe77a6c1de3305b43e0e251a5","8977e573f75d79f619bd0b6e44f1997ba9d36a385c7254e3312b472aed8cc947","03b2fcc930598c6b4c5a2ecfb55dc6149a060b4d3d2e90f92636f1a3bb05f225","2d408c7c63f5530662fd6251b9aa09d21dc671747c42cffbf579c2a662361412","e3e20ca8fb665db552f14345533811c857712a4771d8ecc42bff1421ba877ee6","3c8421efb5c63d589942accb47b22da570e416db81d15f762e9d197c36c35dd3","f6818c58f145c9a360612133fb843553daccfae6229bd13b5841b89803ae76fa","0236ba3513ed5e1d3b27de1656f163c90170385fdff5cc8fbff5b628365755c9","8295a01f51882c3dbdf1f0d189cb90f0c387205ea593cdc95eb57c83cd0aa58c","8bac93dbe95ee9f86846120b97d87912c73767a4846e3e591bf2e5ad42d13a6e","06b53275862a92e2ce859d4690ad9979dd041f91a9a7e8fe1d506fafda8273a2"],"paragraph_range_zero_based":[17928,17951],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p17928"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":17952},{"literal_text_all_w_t_and_m_t":"    dmrs-Downlink-r16               ENUMERATED {enabled}                                                        OPTIONAL    -- Need R","paragraph_zero_based":17953},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":17954},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17955},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":17956},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17957},{"literal_text_all_w_t_and_m_t":"-- TAG-DMRS-DOWNLINKCONFIG-STOP","paragraph_zero_based":17958},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17959},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17960},{"literal_text_all_w_t_and_m_t":"DMRS-DownlinkConfig field descriptions","paragraph_zero_based":17961},{"literal_text_all_w_t_and_m_t":"dmrs-AdditionalPosition","paragraph_zero_based":17962},{"literal_text_all_w_t_and_m_t":"Position for additional DM-RS in DL, see Tables 7.4.1.1.2-3 and 7.4.1.1.2-4 in TS 38.211 [16]. If the field is absent, the UE applies the value pos2. See also clause 7.4.1.1.2 for additional constraints on how the network may set this field depending on the setting of other fields.","paragraph_zero_based":17963},{"literal_text_all_w_t_and_m_t":"dmrs-Downlink","paragraph_zero_based":17964},{"literal_text_all_w_t_and_m_t":"This field indicates whether low PAPR DMRS is used, as specified in TS38.211 [16], clause 7.4.1.1.1.","paragraph_zero_based":17965},{"literal_text_all_w_t_and_m_t":"dmrs-Type","paragraph_zero_based":17966},{"literal_text_all_w_t_and_m_t":"Selection of the DMRS type to be used for DL (see TS 38.211 [16], clause 7.4.1.1.1). If the field is absent, the UE uses DMRS type 1.","paragraph_zero_based":17967},{"literal_text_all_w_t_and_m_t":"maxLength","paragraph_zero_based":17968},{"literal_text_all_w_t_and_m_t":"The maximum number of OFDM symbols for DL front loaded DMRS. len1 corresponds to value 1. len2 corresponds to value 2. If the field is absent, the UE applies value len1. If set to len2, the UE determines the actual number of DM-RS symbols by the associated DCI. (see TS 38.211 [16], clause 7.4.1.1.2).","paragraph_zero_based":17969},{"literal_text_all_w_t_and_m_t":"phaseTrackingRS","paragraph_zero_based":17970},{"literal_text_all_w_t_and_m_t":"Configures downlink PTRS. If the field is not configured, the UE assumes that downlink PTRS are absent. See TS 38.214 [19] clause 5.1.6.3.","paragraph_zero_based":17971},{"literal_text_all_w_t_and_m_t":"scramblingID0","paragraph_zero_based":17972},{"literal_text_all_w_t_and_m_t":"DL DMRS scrambling initialization (see TS 38.211 [16], clause 7.4.1.1.1). When the field is absent the UE applies the value physCellId configured for this serving cell.","paragraph_zero_based":17973},{"literal_text_all_w_t_and_m_t":"scramblingID1","paragraph_zero_based":17974},{"literal_text_all_w_t_and_m_t":"DL DMRS scrambling initialization (see TS 38.211 [16], clause 7.4.1.1.1). When the field is absent the UE applies the value physCellId configured for this serving cell.","paragraph_zero_based":17975}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["4818c298ac5a347016ccebf123be3474f4715fa1d0f4d2ca8b14bcee6ef8bd8f","3b7ea3c888fb7eef8cc7e8732c662f9f4ee0159560bd9a701b36070b511a8ce1","5ab29df24da0da416f287d1b5cd341d6fdea466398b8ad3f3b52f44559204269","472fbf571e3e6f9446d3acffe362d3f1cabe504c0f05a22027989a510acc8982","081cda9e5a02fc0d8417cd7806dc1c1e84898b9eb5962d