"literal_text_all_w_t_and_m_t":"    sl-PeriodCG2-r16               INTEGER (1..99)","paragraph_zero_based":37457},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37458},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37459},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-CONFIGUREDGRANTCONFIG-STOP","paragraph_zero_based":37460},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":37461},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37462},{"literal_text_all_w_t_and_m_t":"SL-ConfiguredGrantConfig field descriptions","paragraph_zero_based":37463}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["9ac7e352123f0c05e1ebdb1e6d667a5c2907e91f199b34dcc193bffa49f9be77","5099f04ee995f1e8d534b99786b66924ca491904f235ecacc3e22fd2e81a6875","2de608b3823a2d6e158e5663c80128aa397a20644752f9226c015b4ca2b37cbb","70d7c9da5f8bd28e0a9e311b17c2693e4de2e6cf95d4c1079de26fd882774581","2d0e8b868b1d0b44e460bdd3fa5dd8ecf95be5143036b85f410b808e176948bf","c6813c5fc3c2bc17c15b7b3f69c8cfa3ed7dc186a2b9ab91f9fca4fda854effb","4cac53dbb5aa53a312a9461b4b4ea3209302e56df0308f07b954947b62e1049f","9476156c9590b55079016c3228318bb8c80b41006643d677bd7576f891c19081","c070f669efe382ff3786bc4f40bb8959219cfd3bd57c5d6458eaf5099380dd05","43f5ea42918a38440306d0bf594d0829cdc5999ce4c10d35685230b9b3ab9b88","3a25a374163e0ecb39e6412c6a46c001c378c8fd79ce79e84ea12f572a3746da","44428036d9b8022a8886ffff0c2759ff9e16839fb2d00e6009e12f70b4fd4aab","8290d3d01f98399890f44fdda94ad9bc1f15aa6dbfef92ba49df403674a8206a","3d77022ed3fcbbab94963ff1a082338456aa0e07442a61f149025b742b361592","a86b4c045c27b9d072e63d2842a3ccccfe22f07fafa3c6f10a139bbd55d0ef6b","37c4724203d6871115c34a54d71079ba16d699f7004568b1faa2d7904d507519","44688efa136a026ebb57fd729caf6a310b4e9602ba6e75e8e9a9255288351a93","398ce884e12c64ecf03ddabdc2d45de7e7bd496b8cbe5942566cfd30c1a4ef70","f9b6ee8f34d7338809f89031d0b310590675a30bd3c5bba734b87e3123ea58f6","808a684c22f510d75edeb35ba92b3d0154ce8bb985d5df497642a595bcd9cf82","e0840bcf91ec7b9189b0d3b88050038390117e501af350c00a766cb7712f37a0","04eca52c6243c7633cc89a8104920418a7df626dcd8d191c12e33588df9b62ac","e39ccbd0cff93265ca56d180047a5f8dd94d0c8ff0c2b5404f99b31d3cdd7e44","1cc58fe60888a8e6003cfb9d587623bc2a46afb20ea81ffd8ec7dc21ca734947"],"paragraph_range_zero_based":[37440,37463],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p37440"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-ConfigIndexCG","paragraph_zero_based":37464},{"literal_text_all_w_t_and_m_t":"This field indicates the ID to identify sidelink configured grant.","paragraph_zero_based":37465},{"literal_text_all_w_t_and_m_t":"sl-CG-MaxTransNumList","paragraph_zero_based":37466},{"literal_text_all_w_t_and_m_t":"This field indicates the maximum number of times that a TB can be transmitted using the resources provided by the sidelink configured grant. sl-Priority corresponds to the logical channel priority.","paragraph_zero_based":37467},{"literal_text_all_w_t_and_m_t":"sl-FreqResourceCG-Type1","paragraph_zero_based":37468},{"literal_text_all_w_t_and_m_t":"Indicates the frequency resource location of sidelink configured grant type 1. An index giving valid combinations of one or two starting sub-channel and length (jointly encoded) as resource indicator value (RIV), as defined in TS 38.214 [19].","paragraph_zero_based":37469},{"literal_text_all_w_t_and_m_t":"sl-HARQ-ProcID-Offset","paragraph_zero_based":37470},{"literal_text_all_w_t_and_m_t":"Indicates the offset used in deriving the HARQ process ID for sidelink configured grant type 1 or sidelink configured grant type 2, see TS 38.321 [3], clause 5.8.3.","paragraph_zero_based":37471},{"literal_text_all_w_t_and_m_t":"sl-N1PUCCH-AN","paragraph_zero_based":37472},{"literal_text_all_w_t_and_m_t":"This field indicates the PUCCH resource for HARQ feedback for sidelink configured grant type 1. The actual PUCCH-Resource is configured in sl-PUCCH-Config and referred to by its ID.","paragraph_zero_based":37473},{"literal_text_all_w_t_and_m_t":"sl-N1PUCCH-AN-Type2","paragraph_zero_based":37474},{"literal_text_all_w_t_and_m_t":"This field indicates the PUCCH resource for HARQ feedback for PSCCH/PSSCH transmissions without a corresponding PDCCH on sidelink configured grant type 2. The actual PUCCH-Resource is configured in sl-PUCCH-Config and referred to by its ID.","paragraph_zero_based":37475},{"literal_text_all_w_t_and_m_t":"sl-NrOfHARQ-Processes","paragraph_zero_based":37476},{"literal_text_all_w_t_and_m_t":"This field indicates the number of HARQ processes configured for a specific sidelink configured grant. It applies for both type 1 and type 2.","paragraph_zero_based":37477},{"literal_text_all_w_t_and_m_t":"sl-PeriodCG","paragraph_zero_based":37478},{"literal_text_all_w_t_and_m_t":"This field indicates the period of sidelink configured grant in the unit of ms.","paragraph_zero_based":37479},{"literal_text_all_w_t_and_m_t":"sl-PSFCH-ToPUCCH-CG-Type1","paragraph_zero_based":37480},{"literal_text_all_w_t_and_m_t":"This field, for sidelink configured grant type 1, indicates slot offset between the PSFCH associated with the last PSSCH resource of each period and the PUCCH occasion used for reporting sidelink HARQ.","paragraph_zero_based":37481},{"literal_text_all_w_t_and_m_t":"sl-ResourcePoolID","paragraph_zero_based":37482},{"literal_text_all_w_t_and_m_t":"Indicates the resource pool in which the sidelink configured grant type 1 is applied.","paragraph_zero_based":37483},{"literal_text_all_w_t_and_m_t":"sl-StartSubchannelCG-Type1","paragraph_zero_based":37484},{"literal_text_all_w_t_and_m_t":"This field indicates the starting sub-channel of sidelink configured grant type 1. An index giving valid sub-channel index.","paragraph_zero_based":37485},{"literal_text_all_w_t_and_m_t":"sl-TimeOffsetCG-Type1","paragraph_zero_based":37486},{"literal_text_all_w_t_and_m_t":"This field indicates the slot offset with respect to logical slot defined by sl-TimeReferenceSFN-Type1, as specified in TS 38.321 [3].","paragraph_zero_based":37487}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["68dd7d6f4cf3bcb2aef6b56b9a353da917016646050b96c862ad1a32de11697f","82c76e083ce1f02b03dd193f0ddbba89b2abe1d10838e4c4d9464a121c876b0a","54bfe65dec6aec81c41f64a54eefd0e1841c6d03ba172819a60627d687f46782","82aa17a8b32d7f4866cf5a29eb47f41b1023187b7555afd9ac2511d1d1ac80d5","aa8fbf2fe78960f60329f025a9c97aad67c4edb2dc5f163497b7eb9cb7254e94","7068bdac32ddaf229e03d9cce95604dc0d1113767938bfeca832e314e075a3e1","5392b0ef5849f93af525472e5ee8045c6eba1de9646d6619045f69680a544da9","eb4a254e11ea587f8a09f365d38cbaccebd4c83d249b97f83f4afd65045e3791","15f3350df22d191466e1af44219474a9f82eba71acf49db4388d4b8df66ad8fb","8687f6d98f78701f8b3ea7a28973a665d61031f6cc6bda8f56984850c2b37da1","13811be49aa6a0f970052e89a9cc2de62e7fd1d1606525b3aa5ba7f0def53f83","7be848f8ad6ce4f4febfc85cfced12645235273d774176e34a8d612befe38c8c","9459b16639ec5d7604010c08e54d08662c0c827d083485b492d5fb3ffba6b0c8","31ddfec8699b178aba001f7958a0c21904f6c72c14f63ba1817d117dd688ad87","5863eb14e0be5d00e4ca6904428f3e3f2749a9b70d9bf71434e09016a50373fa","5c464db4ad7c169e73ea2bc3d5f96ed0f668711166a018bd3993f7c4efaaed75","c49698096df099dbd0f1803cef64d96625a246883a5806a2e89257fe4a85cf80","a36436a4bf002940d4fa5a20bbaf916cb5023c7e088498d042ac86505765081c","4a6beadaa6a726d0add4886c2a4da3a6750e86a10ae475ff86b96e680f9e2247","033a13b8c0ae499b62eba94d4dbdfcb250e8e66bcdf7e69c27244aad969a9cbe","38aa83d0230e4b09d6bf61ea72756bb197eee7a683c035463c449bf74d3add20","f3c1c9c699bc74d152a806130c2c12b401aa3672a8340eeb5cd53eabaacd85f4","368364d6bf6839cb203c5939146500484f6f471c609d032fe8b0b6a0d042aaed","dc5e8fbaa06b7361d7a006a032039373d0d45cd7fca7d6982b63f8ba6f19163b"],"paragraph_range_zero_based":[37464,37487],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 3