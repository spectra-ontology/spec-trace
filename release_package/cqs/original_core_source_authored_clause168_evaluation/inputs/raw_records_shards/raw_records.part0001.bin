"paragraph_zero_based":41364},{"literal_text_all_w_t_and_m_t":"T346e (The UE maintains one instance of this timer per cell group)","paragraph_zero_based":41365},{"literal_text_all_w_t_and_m_t":"Upon transmitting UEAssistanceInformation message with minSchedulingOffsetPreference.","paragraph_zero_based":41366},{"literal_text_all_w_t_and_m_t":"Upon releasing minSchedulingOffsetPreferenceConfig during the connection re-establishment/resume procedures, upon receiving minSchedulingOffsetPreferenceConfig set to release, or upon performing MR-DC release.","paragraph_zero_based":41367},{"literal_text_all_w_t_and_m_t":"No action.","paragraph_zero_based":41368},{"literal_text_all_w_t_and_m_t":"T346f","paragraph_zero_based":41369},{"literal_text_all_w_t_and_m_t":"Upon transmitting UEAssistanceInformation message with releasePreference.","paragraph_zero_based":41370},{"literal_text_all_w_t_and_m_t":"Upon releasing releasePreferenceConfig during the connection re-establishment/resume procedures, or upon receiving releasePreferenceConfig set to release.","paragraph_zero_based":41371},{"literal_text_all_w_t_and_m_t":"No action.","paragraph_zero_based":41372},{"literal_text_all_w_t_and_m_t":"T346g","paragraph_zero_based":41373},{"literal_text_all_w_t_and_m_t":"Upon transmitting UEAssistanceInformation message with musim-PreferredRRC-State.","paragraph_zero_based":41374},{"literal_text_all_w_t_and_m_t":"Upon receiving RRCRelease, or upon receiving musim-LeaveAssistanceConfig set to release.","paragraph_zero_based":41375}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["2a88efc726f7ea247941a1f3dbf4dc05a43e0044a5f839ff48a87d4f07319d50","53e2b83bc1e22da7a6c9cd623495416d9138d1b4a70a8eb19