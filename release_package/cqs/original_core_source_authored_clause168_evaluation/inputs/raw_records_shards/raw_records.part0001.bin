nd_m_t":"","paragraph_zero_based":13503},{"literal_text_all_w_t_and_m_t":"InterFreqExcludedCellList ::=       SEQUENCE (SIZE (1..maxCellExcluded)) OF PCI-Range","paragraph_zero_based":13504},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13505},{"literal_text_all_w_t_and_m_t":"InterFreqAllowedCellList-r16 ::=    SEQUENCE (SIZE (1..maxCellAllowed)) OF PCI-Range","paragraph_zero_based":13506},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13507},{"literal_text_all_w_t_and_m_t":"InterFreqCAG-CellListPerPLMN-r16 ::= SEQUENCE {","paragraph_zero_based":13508},{"literal_text_all_w_t_and_m_t":"    plmn-IdentityIndex-r16              INTEGER (1..maxPLMN),","paragraph_zero_based":13509},{"literal_text_all_w_t_and_m_t":"    cag-CellList-r16                    SEQUENCE (SIZE (1..maxCAG-Cell-r16)) OF PCI-Range","paragraph_zero_based":13510},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":13511}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["95e6fd1e024e42fc2f6cb8eb4ac8fc08ebd9bea27ceb10feb1b2bcbe7c7d6a68","23c0283cb02e3979cd3de5a2efa71544f327d70328d6bcacd546bc0bef2da273","1d273494780c84bda76b5fae80233a87267e86287d170cccb76b99f526af29d3","fb8410c8c58702ed34b0ce9ac3a8e8b439e8a173931dde94d671a957b5a7bc61","a361ef84050be5f4691591c624818c011fa8e0b7693b022b86ed91d3d02624f0","f9d5759bcc376ae5a8594709c397da04f1acb94f83ccdfaa0c8da339134d2ac2","b75dbd5ae99c660ef58879f9ead5eb71b70fe2fed2dde503574c1d296823b721","377530be23c83de2178b1091e8bf93d930175671e608cfb227335eb1fdb79b7d","a218a549579cf4ab81a82d252202584452ea800cee43b72f6ccf0e63cdf4ac1d","2b46af607c5f932ea88495b3c9da8109af0308bae8625939b496f111fb2a8b36","101fc4c8f94da7600412159057e5e97e3cfb37c2d7ebce8106b82fd17a80c9da","9a0367bf89155667c78ae0a0d0ae01d09fce99cba57b873b955320478a5eed76","775d3acecd9ecace715ace13d5710d3cbce5e96fd4f0d035b75b94eec697b1aa","79ebd00f48145341400619e792b977f4e3e73a3b4aca59f3638cdc0c27d974ba","487f314559f1ef023c44770659143774713121b76f1df6108289f03fda5c5044","ea6076cb55a7ea46f1c466b89df145594b3a491d699f235dc87889d5956c9b7c","38fdaf0b2a63c559827a295c8020378c3211f6422f0272b6cddc7f755ebeefe1","852a13ca853831888dfee4f93402da9d1ad399cc28be6ce223d71b9dd93b9cfb","5cb3e651d93e2454ac845f888ec0f2da0962b9e649dae1c5e5e4fdbadca75ab8","74b3ea33159e2faa2a3ea3a76c9897a73e1155ce5124bc7c7e17c20ccde96ba2","438f505c1b309e082fdef3bd61d13328e270c6f8fbe5ba9b4d14621514c382d1","51c5ba6ceaaade8f11df32312bc68076c6088cf8db90fbb9929ede74d2ba32e8","5cd3be724aa27309f6b037a7e526eb5fb54782ebb107fb6cf27cfdbf8c6eb156","ec7f46e08c0ec36124edbfc879429bb671cf84d013af52b8e402659b0f29db09"],"paragraph_range_zero_based":[13488,13511],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p13488"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13512},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB4-STOP","paragraph_zero_based":13513},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":13514},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13515},{"literal_text_all_w_t_and_m_t":"SIB4 field descriptions","paragraph_zero_based":13516},{"literal_text_all_w_t_and_m_t":"absThreshSS-BlocksConsolidation","paragraph_zero_based":13517},{"literal_text_all_w_t_and_m_t":"Threshold for consolidation of L1 measurements per RS index. If the field is absent, the UE uses the measurement quantity as specified in TS 38.304 [20].","paragraph_zero_based":13518},{"literal_text_all_w_t_and_m_t":"channelAccessMode2","paragraph_zero_based":13519},{"literal_text_all_w_t_and_m_t":"If present, this field indicates that the neighbor cells on the inter-frequency apply channel access mode procedures for operation with shared spectrum channel access in accordance with TS 37.213 [48], clause 4.4 for FR2-2. If absent, the neighbor cells on the inter-frequency do not apply any channel access procedure.","paragraph_zero_based":13520},{"literal_text_all_w_t_and_m_t":"deriveSSB-IndexFromCell","paragraph_zero_based":13521},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE may use the timing of any detected cell on that frequency to derive the SSB index of all neighbour cells on that frequency. If this field is set to true, the UE assumes SFN and frame boundary alignment across cells on the neighbor frequency as specified in TS 38.133 [14].","paragraph_zero_based":13522},{"literal_text_all_w_t_and_m_t":"dl-CarrierFreq","paragraph_zero_based":13523},{"literal_text_all_w_t_and_m_t":"This field indicates center frequency of the SS block of the neighbour cells, where the frequency corresponds to a GSCN value as specified in TS 38.101-1 [15] or TS 38.101-5 [75].","paragraph_zero_based":13524},{"literal_text_all_w_t_and_m_t":"frequencyBandList","paragraph_zero_based":13525},{"literal_text_all_w_t_and_m_t":"Indicates the list of frequency bands for which the NR cell reselection parameters apply.","paragraph_zero_based":13526},{"literal_text_all_w_t_and_m_t":"frequencyBandListAerial","paragraph_zero_based":13527},{"literal_text_all_w_t_and_m_t":"Indicates the list of frequency bands for aerial operation for which the NR cell reselection parameters apply. The UE behaviour in case the field is absent is described in clause 5.2.2.4.5.","paragraph_zero_based":13528},{"literal_text_all_w_t_and_m_t":"highSpeedMeasInterFreq","paragraph_zero_based":13529},{"literal_text_all_w_t_and_m_t":"If the field is set to true and UE supports high speed inter-frequency IDLE/INACTIVE measurements, the UE shall apply the enhanced inter-frequency RRM requirements on the inter-frequency carrier to support high speed up to 500 km/h in RRC_IDLE/RRC_INACTIVE as specified in TS 38.133 [14].","paragraph_zero_based":13530},{"literal_text_all_w_t_and_m_t":"interFreqAllowedCellList","paragraph_zero_based":13531},{"literal_text_all_w_t_and_m_t":"List of allow-listed inter-frequency neighbouring cells, see TS 38.304 [20], clause 5.2.4.","paragraph_zero_based":13532},{"literal_text_all_w_t_and_m_t":"interFreqCAG-CellList","paragraph_zero_based":13533},{"literal_text_all_w_t_and_m_t":"List of inter-frequency neighbouring CAG cells (as defined in TS 38.304 [20] per PLMN.","paragraph_zero_based":13534},{"literal_text_all_w_t_and_m_t":"interFreqCarrierFreqList","paragraph_zero_based":13535}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["8a98d3f749cbb8b34ed3818c7658a973a3903f9ebbeb560b644756f6bb083325","28a3d6a3eb24e125967c10245e412f24c9446fcbc0e7c0de9d6e518f02855d74","24d8bdeef1473e5e4a31ce0bcd347582d09301e1df84ce211d21c7a0d45c482c","d53650f923423f5cc5d8509a6e3d9f8273666107b53dfe8fcf272c5ad3795ab6","4bfaf02578bbbfc02c3f1b8a9b984340a1089827c8cb27b42edae626b3010a28","dfd267d7bdb30bb760f5e07f1cc87f77ae06f56f60c5b3aeac078031e85aa003","bf4e771f5400914d382998b0558cad1dd32855a0da4cb130b70c1d4079a7dd9d","98cc6ef60dda53e56570d8b5f8c62996371902ab4548e4115b170e31f4f3b94b","8d46e8e7416448fba5885cd9bd3686b3eac91ed4050af0df1a298a32c301d888","67fd035f3d3172471cc2018bbb452e52d73005dad86655edf875ba4c1a093d2f","2db9cf700d17c637f99de011e6f276b172d25d5c75a351f216a013c104c64eb1","44e8bc16236cff172004c2c7bb73c475aa336b1c64a6e8a4cc26fcce1b9f7201","1fc5d3d5b7e1110d3c8066b3cbf4387693e75a664b8cd35494cdc86ffb5a4111","b581cc56adcad01dada3e1f31e2878e3dad1bb2627a0908cf1f673ab64116f68","40f6c1f0b8dbd4658975cb4ffc3cdf59ca4576e5b7d299ecd62ac9a3f25c6a7f","b05a93b11a5c436457c20ae72befb14d4993bf99b88cea54360a0c4250766c58","7be357254b9421bcfbd5514c03d033668a34a7f2bac96fc808189160fd3b144a","f6974ce23587f3eadbfeb8d8bea4458031a56f423a8bccd77b57cb58ba4e74a9","08ecb33eebdf177943c85ccdc87d3d40f516174c55a627fec238b49ee713b146","6796a8674c33560652295766845af7eb17656de6d9631f61026806787d7d2073","b28a6b05bc8df0582cee3d35932de4dd9675db5cc320b088a7e6565a0becb195","b1f0cb0600ab53140bf7a1da7f7c1eccaae6fdc584fb02ce790565c977d2ba92","6bb79c26ffaed9259dcb5194e24a2e9485124cb7c7342f94dd11995d4a0b65c8","4ba4f5393285c478b81b2169b929b48da537d2d77a426d16113761566b698676"],"paragraph_range_zero_based":[13512,13535],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p13512"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"List of neighbouring carrier frequencies and frequency specific cell re-selection information. If interFreqCarrierFreqList-v1610, interFreqCarrierFreqList-v1700, interFreqCarrierFreqList-v1720, interFreqCarrierFreqList-v1730 or interFreqCarrierFreqList-v1760 are present, they shall contain the same number of entries, listed in the same order as in interFreqCarrierFreqList (without suffix).","paragraph_zero_based":13536},{"literal_text_all_w_t_and_m_t":"interFreqExcludedCellList","paragraph_zero_based":13537},{"literal_text_all_w_t_and_m_t":"List of exclude-listed inter-frequency neighbouring cells.","paragraph_zero_based":13538},{"literal_text_all_w_t_and_m_t":"interFreqNeighCellList","paragraph_zero_based":13539},{"literal_text_all_w_t_and_m_t":"List of inter-frequency neighbouring cells with specific cell re-selection parameters. If interFreqNeighCellList-v1610 is present, it shall contain the same number of entries, listed in the same order as in interFreqNeighCellList (without suffix).","paragraph_zero_based":13540},{"literal_text_all_w_t_and_m_t":"interFreqNeighHSDN-CellList","paragraph_zero_based":13541},{"literal_text_all_w_t_and_m_t":"List of inter-frequency neighbouring HSDN cells as specified in TS 38.304 [20].","paragraph_zero_based":13542},{"literal_text_all_w_t_and_m_t":"nrofSS-BlocksToAverage","paragraph_zero_based":13543},{"literal_text_all_w_t_and_m_t":"Number of SS blocks to average for cell measurement derivation. If the field is absent, the UE uses the measurement quantity as specified in TS 38.304 [20].","paragraph_zero_based":13544},{"literal_text_all_w_t_and_m_t":"p-Max","paragraph_zero_based":13545},{"literal_text_all_w_t_and_m_t":"Value in dBm applicable for the neighbouring NR cells on this carrier frequency. If absent the UE applies the maximum power according to TS 38.101-1 [15] in case of an FR1 cell, TS 38.101-2 [39] in case of an FR2 cell or TS 38.101-5 [75] in case of an NTN cell. In this release of the specification, if p-Max is present on a carrier frequency in FR2, the UE shall ignore the field and applies the maximum power according to TS 38.101-2 [39]. This field is ignored by IAB-MT. The IAB-MT applies output power and emissions requirements, as specified in TS 38.174 [63].","paragraph_zero_based":13546},{"literal_text_all_w_t_and_m_t":"q-OffsetCell","paragraph_zero_based":13547},{"literal_text_all_w_t_and_m_t":"Parameter \"Qoffsets,n\" in TS 38.304 [20].","paragraph_zero_based":13548},{"literal_text_all_w_t_and_m_t":"q-OffsetFreq","paragraph_zero_based":13549},{"literal_text_all_w_t_and_m_t":"Parameter \"Qoffsetfrequency\" in TS 38.304 [20].","paragraph_zero_based":13550},{"literal_text_all_w_t_and_m_t":"q-QualMin","paragraph_zero_based":13551},{"literal_text_all_w_t_and_m_t":"Parameter \"Qqualmin\" in TS 38.304 [20]. If the field is absent, the UE applies the (default) value of negative infinity for Qqualmin.","paragraph_zero_based":13552},{"literal_text_all_w_t_and_m_t":"q-QualMinOffsetCell","paragraph_zero_based":13553},{"literal_text_all_w_t_and_m_t":"Parameter \"Qqualminoffsetcell\" in TS 38.304 [20]. Actual value Qqualminoffsetcell = field value [dB].","paragraph_zero_based":13554},{"literal_text_all_w_t_and_m_t":"q-RxLevMin","paragraph_zero_based":13555},{"literal_text_all_w_t_and_m_t":"Parameter \"Qrxlevmin\" in TS 38.304 [20].","paragraph_zero_based":13556},{"literal_text_all_w_t_and_m_t":"q-RxLevMinOffsetCell","paragraph_zero_based":13557},{"literal_text_all_w_t_and_m_t":"Parameter \"Qrxlevminoffsetcell\" in TS 38.304 [20]. Actual value Qrxlevminoffsetcell = field value * 2 [dB].","paragraph_zero_based":13558},{"literal_text_all_w_t_and_m_t":"q-RxLevMinOffsetCellSUL","paragraph_zero_based":13559}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["f7d40b9d156eab2120948ae46e9b55fdc3aa0ed2c270397be98bbdef1aad4749","90c5c685285e322c81b8d8873813ddc2fe5407415121cc781cc1c589ce38bc37","1407b7e2dc88046096c74dd5e32f4634d08835f820d99ad0063f3c23dc433d22","456bbb412e866e7ee95c5fc903695bd47eabbfe7d388427d22f28b1c06d5293c","74da603b611b9c62be29eb9eac9f5ca8f7fbf891be7842df3e711fa21525a186","2b57f7304671fd9996cf3a2a4d4615d2fc904569db014d58eb69c8ffe953055c","5e208fc8352bee297fe9e179cef45ebc5d89a3dbd394400397b0d7b8f63920a0","058c0460a17e1d3c51c986c9e0fee8d2adbecd6486b441ae063fa6ab94c98cd9","a3a40b2d319319d31cb42139f928237afb1e33b901995ac37fec7928e52bbbc3","c946ea212050a3b1c1ec1b5fda343e74d79231175476d65a59001cc2da4fdbab","a9b4453fd2b5e845d68c94da8e99f7e132139de20744be8f1d72f11c9630ae97","299d37b02c432a169ac1cea5a52d82344739041bba3134d6e9167c8238111397","82500034422b30e125ff12515e52406b52a8b79d8c04440ceb670828384f8bd7","dadbbf999b13b132f39646251d4e5eed6c7fd5bf5b06e7e60a897b1afaa3866a","905ed5231f632702c15907dd2a301c0aed9626739c25c80e63be444e9e672677","4a73c9ea7125da0055e3b24276d3c381680e5db200d02bead52defca278320eb","09a2305f39804ebc43993d71cb316c00e27b1ffba8529f21ac2638826bf83d31","ac780b4e7fbc03bf5f75644e0fc3eda361724b2a65acb0a33a59f1925801383e","2611ab445db49318847bcf71d2f4cee2aa12beac9c7331ac0e01e461373b195a","42e2553b3a33e7fbaa69f84204ea2e899c3dda758c7ef1e2dac2b687bdd46de1","0d127bb4ab8010a8f86fa556c95f159099c7dfe14fbacad3589c0027deedce22","ee92c21c8934248af509248c99c8aa13a5fcd54f16e09cbb3458c1019b0594a7","b28a3eb74486885ac6fc79e32af08ab7035cf583d6a8ee8b1a751bd95cb396c8","86bff0255a16784dc4ffbc40f2a03928e64d900054926f4a9a55a90e93f4a608"],"paragraph_range_zero_based":[13536,13559],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p13536"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Parameter \"QrxlevminoffsetcellSUL\" in TS 38.304 [20]. Actual value QrxlevminoffsetcellSUL = field value * 2 [dB].","paragraph_zero_based":13560},{"literal_text_all_w_t_and_m_t":"q-RxLevMinSUL","paragraph_zero_based":13561},{"literal_text_all_w_t_and_m_t":"Parameter \"Qrxlevmin\" in TS 38.304 [20].","paragraph_zero_based":13562},{"literal_text_all_w_t_and_m_t":"redCapAccessAllowed","paragraph_zero_based":13563},{"literal_text_all_w_t_and_m_t":"Indicates whether RedCap UEs are allowed to access the frequency.","paragraph_zero_based":13564},{"literal_text_all_w_t_and_m_t":"smtc","paragraph_zero_based":13565},{"literal_text_all_w_t_and_m_t":"Measurement timing configuration for inter-frequency measurement. If this field is absent, the UE assumes that SSB periodicity is 5 ms in this frequency. If the field is broadcast by an NTN cell, the offset (derived from parameter periodicityAndOffset) is based on the assumption that the gNB-UE propagation delay difference between the serving cell and neighbour cells equals to 0 ms, and UE can adjust the actual offset based on the actual propagation delay difference.","paragraph_zero_based":13566},{"literal_text_all_w_t_and_m_t":"smtc2-LP","paragraph_zero_based":13567},{"literal_text_all_w_t_and_m_t":"Measurement timing configuration for inter-frequency neighbour cells with a Long Periodicity (LP) indicated by periodicity in smtc2-LP. The timing offset and duration are equal to the offset and duration indicated in smtc in InterFreqCarrierFreqInfo. The periodicity in smtc2-LP can only be set to a value strictly larger than the periodicity in smtc in InterFreqCarrierFreqInfo (e.g. if smtc indicates sf20 the Long Periodicity can only be set to sf40, sf80 or sf160, if smtc indicates sf160, smtc2-LP cannot be configured). The pci-List, if present, includes the physical cell identities of the inter-frequency neighbour cells with Long Periodicity. If smtc2-LP is absent, the UE assumes that there are no inter-frequency neighbour cells with a Long Periodicity.","paragraph_zero_based":13568},{"literal_text_all_w_t_and_m_t":"smtc4list","paragraph_zero_based":13569},{"literal_text_all_w_t_and_m_t":"Measurement timing configuration list for NTN deployments, see clause 5.5.2.10. The offset of each SSB-MTC4 in smtc4list is based on the assumption that the gNB-UE propagation delay difference between the serving cell and neighbour cells equals to 0 ms, and UE can adjust the actual offset based on the actual propagation delay difference. For a UE that supports less SMTCs than what is included in this list, it is up to the UE to select which SMTCs to consider.","paragraph_zero_based":13570},{"literal_text_all_w_t_and_m_t":"ssb-PositionQCL","paragraph_zero_based":13571},{"literal_text_all_w_t_and_m_t":"Indicates the QCL relation between SS/PBCH blocks for a specific neighbor cell as specified in TS 38.213 [13], clause 4.1. If provided, the cell specific value overwrites the common value signalled by ssb-PositionQCL-Common in SIB4 for the indicated cell.","paragraph_zero_based":13572},{"literal_text_all_w_t_and_m_t":"ssb-PositionQCL-Common","paragraph_zero_based":13573},{"literal_text_all_w_t_and_m_t":"Indicates the QCL relation between SS/PBCH blocks for inter-frequency neighbor cells as specified in TS 38.213 [13], clause 4.1.","paragraph_zero_based":13574},{"literal_text_all_w_t_and_m_t":"ssb-ToMeasure","paragraph_zero_based":13575},{"literal_text_all_w_t_and_m_t":"The set of SS blocks to be measured within the SMTC measurement duration (see TS 38.215 [9]). When the field is absent the UE measures on all SS-blocks.","paragraph_zero_based":13576},{"literal_text_all_w_t_and_m_t":"ssbSubcarrierSpacing","paragraph_zero_based":13577},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing of SSB.","paragraph_zero_based":13578},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":13579},{"literal_text_all_w_t_and_m_t":"FR1:    15 or 30 kHz","paragraph_zero_based":13580},{"literal_text_all_w_t_and_m_t":"FR2-1:  120 or 240 kHz","paragraph_zero_based":13581},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":13582},{"literal_text_all_w_t_and_m_t":"threshX-HighP","paragraph_zero_based":13583}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["288c670ecb6ea8576f8c61ee88080cc93f77f854aa3dd475590a436faa1ffc4a","ea883298c074c9e938cd06d1936d37e8b012110daae7ecd341908352dd61b7be","0d24e59e4e42cc498d64de46f5e824cf88743da4fd17ac0d0059ab5a9988c535","bb8aacb8e67564f2136cb452cdd11d6823da4b79bc377e17c1496e0467f9dd01","bed1a18677b8c8feb992c4e08bf56c34476d7df66fe9f006f92ff65d2092e5b2","ac7a4f2c7279d422f770de6053a166c192a1786c8cdeab031720d7528d027469","5487ae229712b4f246d43471ce2c703d30b0d5df4908053e4b3f5662b4e66ee7","a7c7fdd2d94c691d06c83422ef5672a1548c7bdbe23790ab4512fa9b75547bcd","9d534c9759279b8d37e7c5a531c8fe8d17290a905593c85cbba82f57f626c018","fc2e8e28d9640106eae5486839bd7a048f2a36ab15afedd4ff52b9e9e62c9f90","b9a292ef7ff617ce557a91f0e7a2463d864734921334348dc82bfd44bb70aeeb","d3f939b416b0074178fb9013705c2e9a8479e2181080d319771bac2230e30e86","211674a0b4b088e3c769a029edd65f841996d30dde2678fb4ccedef76c2e2a73","3f0041b9ae64213ff9ecc00538af0030a4bc6622f989b7d4b302e2b0294c377e","310bb4cb053ffdae9cb9be828b21f9c07f3799866e823ff3733c3c1d265b2abc","d0bb6e2a42232079c0ed5530dcecbe4a7054505c0e34fcacdb30c2376a8efa81","38cfcb0e649d0373ec77af142c3a6ce6be29f7c6d87573bb286746439acc679f","605ca9512bfe2973d4c00055377550d69f007e95b5683597fd723eddf842c04d","06ccbfb7be321d5183488b231391dcd9de6c8ed37fd6835436eaca6f0cf2bd8d","14310532525354727a9b2309a11acc3f2d1137aa4499f66eb36ae93d4a9f8ff5","e04d3c8623389f6fcdff90d6b802730deaa503a365809e374f356ff5f654c0c6","66e52a5f0d22ef91228840bc805fba4b305946890c9c5b5be58da6d9087afa67","3ba014d8b689fecb12f372246593c4a2f63a32b1d334eee38b11ff76a47b45fb","964d29c97d1ccbcc9f771d67e04bc033db501e0d822102ef943cfed8f4c35c65"],"paragraph_range_zero_based":[13560,13583],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p13560"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Parameter \"ThreshX, HighP\" in TS 38.304 [20].","paragraph_zero_based":13584},{"literal_text_all_w_t_and_m_t":"threshX-HighQ","paragraph_zero_based":13585},{"literal_text_all_w_t_and_m_t":"Parameter \"ThreshX, HighQ\" in TS 38.304 [20].","paragraph_zero_based":13586},{"literal_text_all_w_t_and_m_t":"threshX-LowP","paragraph_zero_based":13587},{"literal_text_all_w_t_and_m_t":"Parameter \"ThreshX, LowP\" in TS 38.304 [20].","paragraph_zero_based":13588},{"literal_text_all_w_t_and_m_t":"threshX-LowQ","paragraph_zero_based":13589},{"literal_text_all_w_t_and_m_t":"Parameter \"ThreshX, LowQ\" in TS 38.304 [20].","paragraph_zero_based":13590},{"literal_text_all_w_t_and_m_t":"t-ReselectionNR","paragraph_zero_based":13591},{"literal_text_all_w_t_and_m_t":"Parameter \"TreselectionNR\" in TS 38.304 [20].","paragraph_zero_based":13592},{"literal_text_all_w_t_and_m_t":"t-ReselectionNR-SF","paragraph_zero_based":13593},{"literal_text_all_w_t_and_m_t":"Parameter \"Speed dependent ScalingFactor for TreselectionNR\" in TS 38.304 [20]. If the field is absent, the UE behaviour is specified in TS 38.304 [20].","paragraph_zero_based":13594},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13595},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":13596},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":13597},{"literal_text_all_w_t_and_m_t":"Mandatory","paragraph_zero_based":13598},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in SIB4.","paragraph_zero_based":13599},{"literal_text_all_w_t_and_m_t":"RSRQ","paragraph_zero_based":13600},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if threshServingLowQ is present in SIB2; otherwise it is absent.","paragraph_zero_based":13601},{"literal_text_all_w_t_and_m_t":"SharedSpectrum","paragraph_zero_based":13602},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if this inter-frequency operates with shared spectrum channel access. Otherwise, it is absent, Need R.","paragraph_zero_based":13603},{"literal_text_all_w_t_and_m_t":"SharedSpectrum2","paragraph_zero_based":13604},{"literal_text_all_w_t_and_m_t":"The field is optional present, Need R, if this inter-frequency or neighbor cell operates with shared spectrum channel access. Otherwise, it is absent, Need R.","paragraph_zero_based":13605},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13606},{"literal_text_all_w_t_and_m_t":"–SIB5","paragraph_zero_based":13607}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["8be0b868a14bf81925cad19ea244b9ef0a2b49568aeac4b642866043b0cc01be","1f0572bfe8d46ae1358ff91aec31be1f93363fab458cf83b8e8bdf2aa1725e02","c0bc067fd552fcd79b4d1eb4e9554849fb6332541ce7cacacb585cadd5f83667","fd3854c59c36f1e39d90d7e73c4cd5317934a03875f6982133aaa13c981a9b92","1f5c80567bcc2033ace29db97906e9055862d33d82a4a601a8ca40943fb8efc9","6ab92961c15eefb94f9136aa71c48d5d5ea3e3d50f7242961c3893fb839975aa","29bf143912483a908f453f8a79e4e089d53d97b67fc4ebf1edfd8a3fa3efe046","e874e67772fc8821c9946fb020fea6f3cc3c50d167bf548a7c3f3b39bca5047e","8199931a8ff1f224eb2e4d3fa1fa24c4fc48158ef8630e75b813880ee9be41ff","11359158337cdbea3b969d028ff44d8b0a322b0f59cf345fa98c9f9fcf733a16","822147606f26ca67378ada51cfa72ba0c5aff5d2f8c9a45c7d8726410742c892","68e4baa3277873392e54524aa0c78f6a9406a2c9fdb810bc5fda327eb0080df4","70da36e3bd122f090c785fa2a46b15829715a3000c414dcfd759cda0739ee7cf","d89eeed0d09b818ae4281cb822709e0d905591cff289fc075ec9ab5c00b3cd61","e716ee21a167741e7a1a650be5