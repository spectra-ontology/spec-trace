{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":22176},{"literal_text_all_w_t_and_m_t":"    firstPDCCH-MonitoringOccasionOfPO   CHOICE {","paragraph_zero_based":22177},{"literal_text_all_w_t_and_m_t":"        sCS15KHZoneT                                                             SEQUENCE (SIZE (1..maxPO-perPF)) OF INTEGER (0..139),","paragraph_zero_based":22178},{"literal_text_all_w_t_and_m_t":"        sCS30KHZoneT-SCS15KHZhalfT                                               SEQUENCE (SIZE (1..maxPO-perPF)) OF INTEGER (0..279),","paragraph_zero_based":22179},{"literal_text_all_w_t_and_m_t":"        sCS60KHZoneT-SCS30KHZhalfT-SCS15KHZquarterT                              SEQUENCE (SIZE (1..maxPO-perPF)) OF INTEGER (0..559),","paragraph_zero_based":22180},{"literal_text_all_w_t_and_m_t":"        sCS120KHZoneT-SCS60KHZhalfT-SCS30KHZquarterT-SCS15KHZoneEighthT          SEQUENCE (SIZE (1..maxPO-perPF)) OF INTEGER (0..1119),","paragraph_zero_based":22181},{"literal_text_all_w_t_and_m_t":"        sCS120KHZhalfT-SCS60KHZquarterT-SCS30KHZoneEighthT-SCS15KHZoneSixteenthT SEQUENCE (SIZE (1..maxPO-perPF)) OF INTEGER (0..2239),","paragraph_zero_based":22182},{"literal_text_all_w_t_and_m_t":"        sCS120KHZquarterT-SCS60KHZoneEighthT-SCS30KHZoneSixteenthT               SEQUENCE (SIZE (1..maxPO-perPF)) OF INTEGER (0..4479),","paragraph_zero_based":22183},{"literal_text_all_w_t_and_m_t":"        sCS120KHZoneEighthT-SCS60KHZoneSixteenthT                                SEQUENCE (SIZE (1..maxPO-perPF)) OF INTEGER (0..8959),","paragraph_zero_based":22184},{"literal_text_all_w_t_and_m_t":"        sCS120KHZoneSixteenthT                                                   SEQUENCE (SIZE (1..maxPO-perPF)) OF INTEGER (0..17919)","paragraph_zero_based":22185},{"literal_text_all_w_t_and_m_t":"    }                                                                                           OPTIONAL    -- Cond OtherBWP","paragraph_zero_based":22186},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":22187},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":22188},{"literal_text_all_w_t_and_m_t":"    commonSearchSpaceListExt-r16                                             SEQUENCE (SIZE(1..4)) OF SearchSpaceExt-r16     OPTIONAL  -- Need R","paragraph_zero_based":22189},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":22190},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":22191},{"literal_text_all_w_t_and_m_t":"    sdt-SearchSpace-r17                 CHOICE {","paragraph_zero_based":22192},{"literal_text_all_w_t_and_m_t":"        newSearchSpace                      SearchSpace,","paragraph_zero_based":22193},{"literal_text_all_w_t_and_m_t":"        existingSearchSpace                 SearchSpaceId","paragraph_zero_based":22194},{"literal_text_all_w_t_and_m_t":"    }                                                                                           OPTIONAL,   -- Need R","paragraph_zero_based":22195},{"literal_text_all_w_t_and_m_t":"    searchSpaceMCCH-r17                 SearchSpaceId                                           OPTIONAL,   -- Need R","paragraph_zero_based":22196},{"literal_text_all_w_t_and_m_t":"    searchSpaceMTCH-r17                 SearchSpaceId                                           OPTIONAL,   -- Need S","paragraph_zero_based":22197},{"literal_text_all_w_t_and_m_t":"    commonSearchSpaceListExt2-r17       SEQUENCE (SIZE(1..4)) OF SearchSpaceExt-v1700           OPTIONAL,   -- Need R","paragraph_zero_based":22198},{"literal_text_all_w_t_and_m_t":"    firstPDCCH-MonitoringOccasionOfPO-v1710 CHOICE {","paragraph_zero_based":22199}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba6