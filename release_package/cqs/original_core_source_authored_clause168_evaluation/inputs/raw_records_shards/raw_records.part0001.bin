{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"maxMIMO-LayerPreferenceConfig","paragraph_zero_based":36816},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preferred number of MIMO layers for power saving.","paragraph_zero_based":36817},{"literal_text_all_w_t_and_m_t":"maxMIMO-LayerPreferenceConfigFR2-2","paragraph_zero_based":36818},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preferred number of MIMO layers for power saving for FR2-2.","paragraph_zero_based":36819},{"literal_text_all_w_t_and_m_t":"maxMIMO-LayerPreferenceProhibitTimer","paragraph_zero_based":36820},{"literal_text_all_w_t_and_m_t":"Prohibit timer for preferred number of number of MIMO layers assistance information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":36821},{"literal_text_all_w_t_and_m_t":"minSchedulingOffsetPreferenceConfig","paragraph_zero_based":36822},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preferred minimumSchedulingOffset value for cross-slot scheduling for power saving.","paragraph_zero_based":36823},{"literal_text_all_w_t_and_m_t":"minSchedulingOffsetPreferenceConfigExt","paragraph_zero_based":36824},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preferred minimumSchedulingOffset value for cross-slot scheduling for power saving for SCS 480 kHz and/or 960 kHz.","paragraph_zero_based":36825},{"literal_text_all_w_t_and_m_t":"minSchedulingOffsetPreferenceProhibitTimer","paragraph_zero_based":36826},{"literal_text_all_w_t_and_m_t":"Prohibit timer for preferred minimumSchedulingOffset assistance information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":36827},{"literal_text_all_w_t_and_m_t":"musim-GapAssistanceConfig","paragraph_zero_based":36828},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information for gap preference.","paragraph_zero_based":36829},{"literal_text_all_w_t_and_m_t":"musim-GapProhibitTimer","paragraph_zero_based":36830},{"literal_text_all_w_t_and_m_t":"Prohibit timer for MUSIM assistance information reporting for gap preference.","paragraph_zero_based":36831},{"literal_text_all_w_t_and_m_t":"musim-LeaveAssistanceConfig","paragraph_zero_based":36832},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information for leaving RRC_CONNECTED for MUSIM purpose.","paragraph_zero_based":36833},{"literal_text_all_w_t_and_m_t":"musim-LeaveWithoutResponseTimer","paragraph_zero_based":36834},{"literal_text_all_w_t_and_m_t":"Indicates the timer for the UE to enter RRC_IDLE for MUSIM purpose as defined in clause 5.3.8.6.","paragraph_zero_based":36835},{"literal_text_all_w_t_and_m_t":"obtainCommonLocation","paragraph_zero_based":36836},{"literal_text_all_w_t_and_m_t":"Requests the UE to attempt to have detailed location information available using GNSS. NR configures the field if includeCommonLocationInfo is configured for one or more measurements.","paragraph_zero_based":36837},{"literal_text_all_w_t_and_m_t":"overheatingAssistanceConfig","paragraph_zero_based":36838},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about UE detected internal overheating.","paragraph_zero_based":36839}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["a84be1ee402d0acc75f3e8121c6bd8cc1f37ccf7bd614eb0bb298cd1d8eac637","5969a24a7c4d71cca884baa71c2ca3cd5e98a426a24821c9e8711c2f800f1914","11e4aa70421a2d151587b1738a978431c7870dc100b8271943de0796239c6858","37c9b818f6a7a5674304a705518e620af1f407f497d17142232c5de9b25edb63","478cded19c3ce0da13c7e797bf452d6ec64d1b8d145343c2c1ce9b8a58ae8405","13381cb2c2c5379307e8c3189e0c268fbb841abd33d3f53efc00ec398387301a","edb4c8b120ad514f18306dd1cb811ab4cc83fcd0d1ad92c31c454a5cc20993d6","e32715f4184bc3b4f081c8f376c76dd49e90273f81054d3363d5f364eb7854e6","086962dafabdf9a6b8955a9a4aa92e5e31084181616d7de2ee5d7af0f7690d34","8f11e01712be3281ee732a24bda509888836abddc5901d0a101900c2f0a59c8f","4c599327e79b33ce0bf231677402a6b515b43fa01a8ac0e315c9c150947c8aac","a35802a3eaaa9cec4063de69511ab0143e617e0db9fb2e2c690a89f7feb3ce68","5eebeef2bed411b56934d8a29dd443598de9a2c1ece6a0a55ed923cc91455e0c","7ee566e4e68cc731e51fe243ea262ee0308e9b379833e6e0f1a697a35d1e79a6","a201be741bddfc636eec1a53b9c73b0a07e06bc381f123d571a5c60fc998f769","3f6908ab58e30e3e790b85b855e8feb383ff69c83f2d26fc61b37f290efe7c8b","366679434ace1fee18e831a78d965311b48685585dd26cf529d814e748ccdadc","7242fcfa04bcff6c6f6a89b4dc1bc378565ffe28c0fdc823e35a195017fc49fe","53524d117ad0feaac611b74cef71806d4e01ce8a5692144ae088436957493abe","f1e18c84640c7879be9fbee4c8308df3bd786605567eb104d1f1e6e9c67cccb7","846705de1abc4356696bfae3cd9d0b23a3707bc6eddc721b6b8b00e29cf50c89","a1f0a0767997ec14ef295dd6aa0a9f98db95669c4286fc30d9a7dce63ac1373c","ccb3ee69f8c517b774b5dfdddf823617f780421b7c0df748d1eb4ef1b04d7317","aec1d3145d033196becedbbfb00076aa29384014a417af853a44a6991d65c683"],"paragraph_range_zero_based":[36816,36839],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p36816"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"overheatingIndicationProhibitTimer","paragraph_zero_based":36840},{"literal_text_all_w_t_and_m_t":"Prohibit timer for overheating assistance information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":36841},{"literal_text_all_w_t_and_m_t":"propDelayDiffReportConfig","paragraph_zero_based":36842},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report service link propagation delay difference between serving cell and neighbour cell(s).","paragraph_zero_based":36843},{"literal_text_all_w_t_and_m_t":"referenceTimePreferenceReporting","paragraph_zero_based":36844},{"literal_text_all_w_t_and_m_t":"If present, the field indicates the UE is configured to provide reference time assistance information.","paragraph_zero_based":36845},{"literal_text_all_w_t_and_m_t":"releasePreferenceConfig","paragraph_zero_based":36846},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preference to leave RRC_CONNECTED state.","paragraph_zero_based":36847},{"literal_text_all_w_t_and_m_t":"rlm-RelaxationReportingConfig","paragraph_zero_based":36848},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report the relaxation state of RLM measurements.","paragraph_zero_based":36849},{"literal_text_all_w_t_and_m_t":"releasePreferenceProhibitTimer","paragraph_zero_based":36850},{"literal_text_all_w_t_and_m_t":"Prohibit timer for release preference assistance information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on. Value infinity means that once a UE has reported a release preference, the UE cannot report a release preference again during the RRC connection.","paragraph_zero_based":36851},{"literal_text_all_w_t_and_m_t":"s-SearchDeltaP-Stationary","paragraph_zero_based":36852},{"literal_text_all_w_t_and_m_t":"Parameter \"SSearchDeltaP-StationaryConnected\" in 5.7.4.4. Value dB2 corresponds to 2 dB, dB3 corresponds to 3 dB and so on.","paragraph_zero_based":36853},{"literal_text_all_w_t_and_m_t":"scg-DeactivationPreferenceConfig","paragraph_zero_based":36854},{"literal_text_all_w_t_and_m_t":"Configuration of the UE to indicate its preference for SCG deactivation.","paragraph_zero_based":36855},{"literal_text_all_w_t_and_m_t":"scg -StatePreferenceProhibitTimer","paragraph_zero_based":36856},{"literal_text_all_w_t_and_m_t":"Prohibit timer for UE indication of its preference for SCG deactivation. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":36857},{"literal_text_all_w_t_and_m_t":"sensorNameList","paragraph_zero_based":36858},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurements from specific sensors. NG-RAN configures the field if includeSensor-Meas is configured for one or more measurements.","paragraph_zero_based":36859},{"literal_text_all_w_t_and_m_t":"sl-AssistanceConfigNR","paragraph_zero_based":36860},{"literal_text_all_w_t_and_m_t":"Indicate whether UE is configured to provide configured grant assistance information for NR sidelink communication.","paragraph_zero_based":36861},{"literal_text_all_w_t_and_m_t":"sourceDAPS-FailureReporting","paragraph_zero_based":36862},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE shall generate the SHR upon successfully completing the DAPS handover to the target cell and if a radio link failure was experienced in the source PCell while executing the DAPS handover. This field is set in the otherConfig configured by the source cell of the DAPS handover.","paragraph_zero_based":36863}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["c00c08e1a748a31250741f5967430c7af9efe2fdf269ff54bf8e7dd1da3fa0f4","61b8bea6c13016c0391e675f06e3df8ec358c52d21b7929e07d920a53f144f22","86b5f210e3d2c49a239ef3c3839272c3018466a5376c923f81027f1daf099b0e","c9f5d0be877e50376a48808a0737b96a9357ec159a6797ef1742c0d2663db6b5","a4e18775219257d77a5681aba99a362010469a40b1b47578c291434a03751407","168e1df27ccdb2c059233c0905a74903fb1ced2d8d8a8f5e99921c0f66be8fff","ae242d41c538cb3339414de903874aa0de21a4c92f62351e77b5913203aec26b","278884a3b2a8fabc414071aef838a3cf44c835ba7ddb1f7a7e45703cf62cf11e","f5839252cb174d4df427652cbb8ea6ba9122f82e3d933382d2577952f5d62f0d","3a3140ab8892a61ac6cd50c54da8649bef2833270478713d9b96b233027b085a","d297270c2cb874b07ed3ea2c5b03c6326e4a3ee12975188af5eff3fb1b1f3489","f829cf67c79f6f9a22cc973b40e407cfa1d9202b6c8616df3ec7804ba2186adf","cc4aa2b62cbd081ab7bdee9168a3ecd1fd0c60d71450bba4ddd34a1083939ebd","ad0f60b9acee5da5a320be164422d5f5937c9654c01a64d3efbcbb0bdeb06e10","6ff342b11c359b328eeaad1bd843e65c7325e3a12202f420204e089604ae3164","6ededa250ae453974d17fbbce28c5a00e4a10f5ef12c5fc36a58695f803e7776","3ca2eb35748869d67ea6036f8fa79bd7f27fb91c8a87f6075b95d8909d65a3d9","4bda17a7bdc29327049a47696423d91b6f7f5a4dfdc49af6ceda7846535e0dfa","cb2709a5566094f4171decf520555bdfee55cd295ef19fa00db2c5fda0760f04","a090462cbc4804aaf83504ebd6e000bdad02ea8a3091ae3ecb8abc7af26fa39c","af005f70ea22300c6b624209b2e6c9628d598a91054c427378cf68f0f2caaa02","dd588159d6eab1ac8ac99061901ed8fe31151cb854b03965d7bafebf2bd48a6f","a705d3b8a4a17e0e35ccd74ffa2e5f1fdead14b05c8a1fb696bd07c901585827","504e0628dc71d950ef57e3f2acbeeeffaab6622926dda25e424d23afd9b9bbd6"],"paragraph_range_zero_based":[36840,36863],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p36840"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"successHO-Config","paragraph_zero_based":36864},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report the successful handover information to the network.","paragraph_zero_based":36865},{"literal_text_all_w_t_and_m_t":"t-SearchDeltaP-Stationary","paragraph_zero_based":36866},{"literal_text_all_w_t_and_m_t":"Parameter \"TSearchDeltaP-StationaryConnected\" in 5.7.4.4. Value in seconds. Value s5 means 5 seconds, value s10 means 10 seconds and so on.","paragraph_zero_based":36867},{"literal_text_all_w_t_and_m_t":"thresholdPercentageT304","paragraph_zero_based":36868},{"literal_text_all_w_t_and_m_t":"This field indicates the threshold for the ratio in percentage between the elapsed T304 timer and the configured value of the T304 timer. Value p40 corresponds to 40%, value p60 corresponds to 60% and so on. This field is set in the otherConfig configured by the target cell of the handover.","paragraph_zero_based":36869},{"literal_text_all_w_t_and_m_t":"thresholdPercentageT310","paragraph_zero_based":36870},{"literal_text_all_w_t_and_m_t":"This field indicates the threshold for the ratio in percentage between the elapsed T310 timer and the configured value of the T310 timer. Value p40 corresponds to 40%, value p60 corresponds to 60% and so on. This field is set in the otherConfig configured by the source cell of the handover.","paragraph_zero_based":36871},{"literal_text_all_w_t_and_m_t":"thresholdPercentageT312","paragraph_zero_based":36872},{"literal_text_all_w_t_and_m_t":"This field indicates the threshold for the ratio in percentage between the elapsed T312 timer and the configured value(s) of the T312 timer. Value p20 corresponds to 20%, value p40 corresponds to 40% and so on. This field is set in the otherConfig configured by the source cell of the handover.","paragraph_zero_based":36873},{"literal_text_all_w_t_and_m_t":"threshPropDelayDiff","paragraph_zero_based":36874},{"literal_text_all_w_t_and_m_t":"Threshold for one-way service link propagation delay difference report as specified in 5.7.4.2.","paragraph_zero_based":36875},{"literal_text_all_w_t_and_m_t":"ul-GapFR2-PreferenceConfig","paragraph_zero_based":36876},{"literal_text_all_w_t_and_m_t":"Indicates whether UE is configured to request for FR2 UL gap activation/deactivation and preferred FR2 UL gap pattern.","paragraph_zero_based":36877},{"literal_text_all_w_t_and_m_t":"wlanNameList","paragraph_zero_based":36878},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurements from specific WLAN APs. NG-RAN configures the field if includeWLAN-Meas is configured for one or more measurements.","paragraph_zero_based":36879},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36880},{"literal_text_all_w_t_and_m_t":"NeighbourCellInfo field descriptions","paragraph_zero_based":36881},{"literal_text_all_w_t_and_m_t":"epochTime","paragraph_zero_based":36882},{"literal_text_all_w_t_and_m_t":"Indicates the epoch time used along with the ephemerisInfo to derive the propagation delay difference for the associated neighbour cell. The UE considers epoch time, indicated by the SFN and sub-frame number in this field, to be the frame nearest to the frame in which the message indicating the epoch time is received. This field is used based on the timing of the serving cell, i.e. the SFN and sub-frame number indicated in this field refers to the SFN and sub-frame of the serving cell.","paragraph_zero_based":36883},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36884},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":36885},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":36886},{"literal_text_all_w_t_and_m_t":"maxBW","paragraph_zero_based":36887}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["3cbcc5cd3a9ae710450ae1c566697dabd440af370bd7e169ccaf3386e89b2a8a","eaab7b4fb791fc03442fdfd0417f14600f047d0c57561278f895781fa858938b","893d110d75b557e4dd322473dbaf605a613e986b6d22a4f1e302ffdd5fa4b1db","55c1b1c2c9c08c1538d4d3606b264eb319792e405695769aaa58ec5b950e7534","1438c395703210f716d9b14a5088aa639dfb445b6602654c60b6aec1ed4c242f","edcac0ab35a6b708faeceaf660822e9472fafbc95d2dcf740883460ceea2ffdb","5a465f0122ffeedaced99868d90586c270aad6be535d1cc2977239e31e7e37c4","ae30cb8fb2eeb6e7de4af374d4d594c21b0969a64bfca8e1802d615329271824","d498c1134d1f8703a8a0fcdf002a9689485e18608350914429c145399241a612","ff449f8cfb84f1c50a1a76e3ff6134f210c8f220818ff7042b1e62f317011267","9504dd50565fb61cd36752d1f4ed207d149c764dd0bf65e0baf05157158d3b38","18a78efab936f867e415fbd7bf350927821d70e3423f008161c7a65c0da291f1","08d3e893a15a50e6b1a41a998fe2213f880f59c9a0cee02f70b6e79907eff2b9","6b95930c585e964fccc16add1702cd67d474ad6f30284244e4b0df32ce09a3df","c5c4b89e98fef9f535eb37cb9177d87840b7014cacfc7d7e86dd50cfccf89edc","c69ddc3cab4471803226c5733b15643986245f134f1107320f694a42aa06310a","41c786ea336957b0a0efe373f797ccdc54fef782c8494bb1d3f6c2e094ad7ab1","584990d7ae2bb001f0fd11b7b578afddc5f05f6b10ba27f163b4c298d4300c8a","0f3711cd03b91195df99feeed03914234f2bed4ebc8488bd134ef07e043e77bf","a524cdba76ca8b089c6707a1ca8ab981d93b7105701a9a6a1b501e3f38fb925c","fa2159bc4e4c808ba7dd4fa9d70f0b565e29979001d35f0112736e8c5728c422","ba8093e6b7ab4405c768fb189d292d63382636238d7920cf1ead2bf9d640c8e8","51b84f7b2323f71b7f9462b2c9e13949df1afae04d73c34577e7b423f345b197","714756b933988329e48ec89402fa9ae3618262dd12ab1a900c5ee9a83d7dd684"],"paragraph_range_zero_based":[36864,36887],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p36864"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is optionally present, need R, if maxBW-PreferenceConfig-r16 is setup; otherwise it is absent, need R.","paragraph_zero_based":36888},{"literal_text_all_w_t_and_m_t":"maxMIMO","paragraph_zero_based":36889},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need R, if maxMIMO-LayerPreferenceConfig-r16 is setup; otherwise it is absent, need R.","paragraph_zero_based":36890},{"literal_text_all_w_t_and_m_t":"minOffset","paragraph_zero_based":36891},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need R, if minSchedulingOffsetPreferenceConfig-r16 is setup; otherwise it is absent, need R.","paragraph_zero_based":36892},{"literal_text_all_w_t_and_m_t":"SCG","paragraph_zero_based":36893},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need M, in an RRCReconfiguration message not within mrdc-SecondaryCellGroup and received, either via SRB3 within DLInformationTransferMRDC or via SRB1. Otherwise, it is absent.","paragraph_zero_based":36894},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36895},{"literal_text_all_w_t_and_m_t":"–PhysCellIdUTRA-FDD","paragraph_zero_based":36896},{"literal_text_all_w_t_and_m_t":"The IE PhysCellIdUTRA-FDD is used to indicate the physical layer identity of the cell, i.e. the primary scrambling code, as defined in TS 25.331 [45].","paragraph_zero_based":36897},{"literal_text_all_w_t_and_m_t":"PhysCellIdUTRA-FDD information element","paragraph_zero_based":36898},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36899},{"literal_text_all_w_t_and_m_t":"-- TAG-PHYSCELLIDUTRA-FDD-START","paragraph_zero_based":36900},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36901},{"literal_text_all_w_t_and_m_t":"PhysCellIdUTRA-FDD-r16 ::=        INTEGER (0..51