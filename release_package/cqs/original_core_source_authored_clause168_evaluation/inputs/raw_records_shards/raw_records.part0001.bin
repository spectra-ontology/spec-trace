{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        rank3-4                             SEQUENCE(SIZE(3)) OF PortIndex4                                 OPTIONAL,   -- Need R","paragraph_zero_based":17352},{"literal_text_all_w_t_and_m_t":"        rank4-4                             SEQUENCE(SIZE(4)) OF PortIndex4                                 OPTIONAL    -- Need R","paragraph_zero_based":17353},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":17354},{"literal_text_all_w_t_and_m_t":"    portIndex2                          SEQUENCE{","paragraph_zero_based":17355},{"literal_text_all_w_t_and_m_t":"        rank1-2                             PortIndex2                                                      OPTIONAL,   -- Need R","paragraph_zero_based":17356},{"literal_text_all_w_t_and_m_t":"        rank2-2                             SEQUENCE(SIZE(2)) OF PortIndex2                                 OPTIONAL    -- Need R","paragraph_zero_based":17357},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":17358},{"literal_text_all_w_t_and_m_t":"    portIndex1                          NULL","paragraph_zero_based":17359},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":17360},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17361},{"literal_text_all_w_t_and_m_t":"PortIndex8::=                       INTEGER (0..7)","paragraph_zero_based":17362},{"literal_text_all_w_t_and_m_t":"PortIndex4::=                       INTEGER (0..3)","paragraph_zero_based":17363},{"literal_text_all_w_t_and_m_t":"PortIndex2::=                       INTEGER (0..1)","paragraph_zero_based":17364},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17365},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-REPORTCONFIG-STOP","paragraph_zero_based":17366},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17367},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17368},{"literal_text_all_w_t_and_m_t":"CSI-ReportConfig field descriptions","paragraph_zero_based":17369},{"literal_text_all_w_t_and_m_t":"carrier","paragraph_zero_based":17370},{"literal_text_all_w_t_and_m_t":"Indicates in which serving cell the CSI-ResourceConfig indicated below are to be found. If the field is absent, the resources are on the same serving cell as this report configuration.","paragraph_zero_based":17371},{"literal_text_all_w_t_and_m_t":"codebookConfig","paragraph_zero_based":17372},{"literal_text_all_w_t_and_m_t":"Codebook configuration for Type-1 or Type-2 including codebook subset restriction. Network can only configure one of codebookConfig, codebookConfig-r16 or codebookConfig-r17 to a UE. The network includes codebookConfig-v1730 only if codebookConfig-r17 is configured.","paragraph_zero_based":17373},{"literal_text_all_w_t_and_m_t":"cqi-BitsPerSubband","paragraph_zero_based":17374},{"literal_text_all_w_t_and_m_t":"This field can only be present if cqi-FormatIndicator is set to subbandCQI. If the field is configured with bits4, the UE uses 4-bit sub-band CQI. If the field is not present and cqi-FormatIndicator is set to subbandCQI, the UE uses 2-bit sub-band differential CQI.","paragraph_zero_based":17375}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["87826f7b975d0419b974095864b56caba31fda1c01faa6ea9591769b4d802c6f","c1164e6520c8c0ddb6b5e2e3b2de483b3702b08e4546feff669894d8a2b1cff7","47d0382817524dbfb7fa576798bf919376ce75ad9f10d7905ff63040ec4e7032","6704a9e007f2b432b866f2a2148af3bddc35a581f330a9ae9ed11ee9dead8d9e","26693584eda861f0bdc6f2c164c2aa2497372152ce1f2ad2af75c25ee53b8661","d81dac98a78e83604bb5b27c8794823d124ffa8ec98c43e11ecd49c7f98e9ea7","847e3a7e2f4079f60deecbbbc31264052d4ab599e99984a88d202b05b483c2f6","51650cade45ff59a2f0dfeb5c615e6bfbbc11ac76fec96c541b43c92e9d2e033","41501eb22493fceccd7e64cce8e5a48aefe2467d5589ce87f45fca775421d937","2138d8679a4af94df9116328d80bb2c2bfcfcfa71e2dc431214c5902139a64ae","802c4651b55ed71789ef80a0a6e3aa2ff9ca6429e4494b093556239547eaae19","5d6ea1aa22fdfc6ed76979c5020def10e6eb94b5280a1bcdad3eb65d3abb1f0b","420dbc994fb2318305c77e21b01580b4de6cd604b163ccf949e81a266b86e1d3","90d429a715f1edbe4d2c6df39452fae1619b4b08a1a677de087e4512ee929f29","18787f2a1448a9b8b2bb330bc16d1fcb051deef2e69bcafc112a5164a9d2a614","7d5e59dc7e6290cb6fe1ee81292f5c407a5fd1469d1dc9cb0f546f3571e21862","4bde8eca5bcc850e192fd0e9792da8cd340d75e8d7e90c9e333594dc3e3244fd","6592db7d31b4893728cb005220100ee2e9b8e668f320217b48263f5366dfaac1","1ecaa8b1495bd5d592f35c4fb49d8f60882bd38eb02814164708a1535d5ba56c","becf94dbc49fea2fedfe2effd1b24a6c28eca8a850b13956648cca7e4f44b002","da189225166211dcf82d6e572e832ca848e98f707001d2471bfb6643acf76b7b","18c8eacd1576a6903830cd5a4c02e5b5d5762c68f57dc5d16a1b292e0d4873c2","ec57e61a7df2620c8f106ab30047db87b49755ad6b84014e791114e11c2a7d51","af9c05a56ff3fe7eb791e90178db8e98700195531f9f3c317cf3a13edefbb447"],"paragraph_range_zero_based":[17352,17375],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p17352"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"cqi-FormatIndicator","paragraph_zero_based":17376},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE shall report a single (wideband) or multiple (subband) CQI (see TS 38.214 [19], clause 5.2.1.4).","paragraph_zero_based":17377},{"literal_text_all_w_t_and_m_t":"cqi-Table","paragraph_zero_based":17378},{"literal_text_all_w_t_and_m_t":"Which CQI table to use for CQI calculation (see TS 38.214 [19], clause 5.2.2.1). For a RedCap UE, CQI table 2 is only supported if the UE indicates support of 256QAM for PDSCH.","paragraph_zero_based":17379},{"literal_text_all_w_t_and_m_t":"csi-IM-ResourcesForInterference","paragraph_zero_based":17380},{"literal_text_all_w_t_and_m_t":"CSI IM resources for interference measurement. csi-ResourceConfigId of a CSI-ResourceConfig included in the configuration of the serving cell indicated with the field \"carrier\" above. The CSI-ResourceConfig indicated here contains only CSI-IM resources. The bwp-Id in that CSI-ResourceConfig is the same value as the bwp-Id in the CSI-ResourceConfig indicated by resourcesForChannelMeasurement.","paragraph_zero_based":17381},{"literal_text_all_w_t_and_m_t":"csi-ReportingBand","paragraph_zero_based":17382},{"literal_text_all_w_t_and_m_t":"Indicates a contiguous or non-contiguous subset of subbands in the bandwidth part which CSI shall be reported for. Each bit in the bit-string represents one subband. The right-most bit in the bit string represents the lowest subband in the BWP. The choice determines the number of subbands (subbands3 for 3 subbands, subbands4 for 4 subbands, and so on) (see TS 38.214 [19], clause 5.2.1.4). This field is absent if there are less than 24 PRBs (no sub band) and present otherwise (see TS 38.214 [19], clause 5.2.1.4).","paragraph_zero_based":17383},{"literal_text_all_w_t_and_m_t":"csi-ReportMode","paragraph_zero_based":17384},{"literal_text_all_w_t_and_m_t":"Configures the CSI report modes Mode1 or Mode 2 (see TS 38.214 [19], clause 5.2.1.4.2)","paragraph_zero_based":17385},{"literal_text_all_w_t_and_m_t":"dummy","paragraph_zero_based":17386},{"literal_text_all_w_t_and_m_t":"This field is not used in the specification. If received it shall be ignored by the UE.","paragraph_zero_based":17387},{"literal_text_all_w_t_and_m_t":"groupBasedBeamReporting","paragraph_zero_based":17388},{"literal_text_all_w_t_and_m_t":"Turning on/off group beam based reporting (see TS 38.214 [19], clause 5.2.1.4). If groupBasedBeamReporting (without suffix) is set to disabled, groupBasedBeamReporting-v1710 is absent.","paragraph_zero_based":17389},{"literal_text_all_w_t_and_m_t":"non-PMI-PortIndication","paragraph_zero_based":17390},{"literal_text_all_w_t_and_m_t":"Port indication for RI/CQI calculation. For each CSI-RS resource in the linked ResourceConfig for channel measurement, a port indication for each rank R, indicating which R ports to use. Applicable only for non-PMI feedback (see TS 38.214 [19], clause 5.2.1.4.2).","paragraph_zero_based":17391},{"literal_text_all_w_t_and_m_t":"The first entry in non-PMI-PortIndication corresponds to the NZP-CSI-RS-Resource indicated by the first entry in nzp-CSI-RS-Resources in the NZP-CSI-RS-ResourceSet indicated in the first entry of nzp-CSI-RS-ResourceSetList of the CSI-ResourceConfig whose CSI-ResourceConfigId is indicated in a CSI-MeasId together with the above CSI-ReportConfigId; the second entry in non-PMI-PortIndication corresponds to the NZP-CSI-RS-Resource indicated by the second entry in nzp-CSI-RS-Resources in the NZP-CSI-RS-ResourceSet indicated in the first entry of nzp-CSI-RS-ResourceSetList of the same CSI-ResourceConfig, and so on until the NZP-CSI-RS-Resource indicated by the last entry in nzp-CSI-RS-Resources in the in the NZP-CSI-RS-ResourceSet indicated in the first entry of nzp-CSI-RS-ResourceSetList of the same CSI-ResourceConfig. Then the next entry corresponds to the NZP-CSI-RS-Resource indicated by the first entry in nzp-CSI-RS-Resources in the NZP-CSI-RS-ResourceSet indicated in the second entry of nzp-CSI-RS-ResourceSetList of the same CSI-ResourceConfig and so on.","paragraph_zero_based":17392},{"literal_text_all_w_t_and_m_t":"nrofReportedGroups","paragraph_zero_based":17393},{"literal_text_all_w_t_and_m_t":"Number of reported resource groups per CSI-report. Value n1 means one resource group, n2 means 2 resource groups, and so on. If nrofReportedGroups is configured, the UE ignores groupBasedBeamReporting (without suffix).","paragraph_zero_based":17394},{"literal_text_all_w_t_and_m_t":"nrofReportedRS","paragraph_zero_based":17395},{"literal_text_all_w_t_and_m_t":"The number (N) of measured RS resources to be reported per report setting in a non-group-based report. N <= N_max, where N_max is either 2 or 4 depending on UE capability.","paragraph_zero_based":17396},{"literal_text_all_w_t_and_m_t":"(see TS 38.214 [19], clause 5.2.1.4) When the field is absent the UE applies the value 1.","paragraph_zero_based":17397},{"literal_text_all_w_t_and_m_t":"numberOfSingleTRP-CSI-Mode1","paragraph_zero_based":17398},{"literal_text_all_w_t_and_m_t":"Configures the number of reported X CSIs when csi-ReportMode is set to 'Mode 1' as described in TS 38.214 [19], clause 5.2.1.4.2. The field is present only if csi-ReportMode configures Mode 1.","paragraph_zero_based":17399}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["a653ca79ec89a65f90cabb3329e14229b9f3021af0df94744a02e31e36ea542e","a169366cb4b08d8e09dc8c15dcc83bccdb056f7eae2f6f938e7669bc812b2b04","71264da4d4c604f4f6189ad9ee23432959faa7e40ba93583fceb1eae0bb74419","21431f9618b4f364f405322ca824ba2a64657efed13292165cf19e338e621945","df2c98d1de3f99616d33cb1a90d36a891a257291bf21ab0f4d7de1219ddd943c","f60515b5f0e6b66e2dc1e3c171dbfe8ec5e70083ebaf57d5d697f4765f30bff4","2eda3842a075cc1881956606ba68f54ec3159f4de04425292985bb8b797db462","555de80e3240d2c92e444d69a8b222600ffbb20ac5c4e29029a20a26cbc2e6dd","b102240c5d3bb50345327f19962fe27371810e0b5d487ddee283245e2d996848","5fa2af7fe157f523612189309cdebac1329beb02e39736c381e0fd7032141272","b29e81f5cea33d28fe1af9ab9f529182bc8a5459709e7c05b0a390220edd124b","6d4bbc03975d489633cf7ac00376e6eb2d6cca044d6d3ea49b2b4639f22d8689","9bb0c4675339776d9e7561ec8eb09b8a9c3d00e40741372f587d179a7177c31d","dc9afe9422d3d018c6e279205d6bac259919e0459c9b5f904379a530476337cd","e7a239fdd6e0cb55f26977eb077db35c9661f444cbdec9f90f4d534fe7b9234b","f62b0f20e244981dc6d28a375a867e5970b93396845fabcb955c213851e75e56","68e1850240d562033b4b4688dfebedfcdbf460e7e036ede8863f994ccf4febfe","73a3bd6bbe41a2ae1776e748db11d83fad4f5d6135ac4245ebbf601993710860","b08a18582ca20935db0c12a05c5b0507c70a5b947b0b6206519d37ecc11a30d3","4c8b525f2abb8eb0c6bff62285ad2df7cd49fc5e5af7b186780c1e0810018466","8d687fc0d1d141e6586b85922ce85d84bfa9320a25fff9dbb332e859abbdaf0e","bf3fad87f873eda356adf0be941de4ce75c3e6b306530e7ef8efdecd5275e153","b4552082190cc2a0eb54e24816c3f675c1120d9a5cb800b2531f396737976f28","e7d4071b009aa241903a6e07ba6e1366fb590309d9e73ac31a5764dfaaf547d0"],"paragraph_range_zero_based":[17376,17399],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p17376"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"nzp-CSI-RS-ResourcesForInterference","paragraph_zero_based":17400},{"literal_text_all_w_t_and_m_t":"NZP CSI RS resources for interference measurement. csi-ResourceConfigId of a CSI-ResourceConfig included in the configuration of the serving cell indicated with the field \"carrier\" above. The CSI-ResourceConfig indicated here contains only NZP-CSI-RS resources. The bwp-Id in that CSI-ResourceConfig is the same value as the bwp-Id in the CSI-ResourceConfig indicated by resourcesForChannelMeasurement.","paragraph_zero_based":17401},{"literal_text_all_w_t_and_m_t":"p0alpha","paragraph_zero_based":17402},{"literal_text_all_w_t_and_m_t":"Index of the p0-alpha set determining the power control for this CSI report transmission (see TS 38.214 [19], clause 6.2.1.2).","paragraph_zero_based":17403},{"literal_text_all_w_t_and_m_t":"pdsch-BundleSizeForCSI","paragraph_zero_based":17404},{"literal_text_all_w_t_and_m_t":"PRB bundling size to assume for CQI calculation when reportQuantity is CRI/RI/i1/CQI. If the field is absent, the UE assumes that no PRB bundling is applied (see TS 38.214 [19], clause 5.2.1.4.2).","paragraph_zero_based":17405},{"literal_text_all_w_t_and_m_t":"pmi-FormatIndicator","paragraph_zero_based":17406},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE shall report a single (wideband) or multiple (subband) PMI. (see TS 38.214 [19], clause 5.2.1.4).","paragraph_zero_based":17407},{"literal_text_all_w_t_and_m_t":"pucch-CSI-ResourceList","paragraph_zero_based":17408},{"literal_text_all_w_t_and_m_t":"Indicates which PUCCH resource to use for reporting on PUCCH.","paragraph_zero_based":17409},{"literal_text_all_w_t_and_m_t":"reportConfigType","paragraph_zero_based":17410},{"literal_text_all_w_t_and_m_t":"Time domain behavior of reporting configuration.","paragraph_zero_based":17411},{"literal_text_all_w_t_and_m_t":"reportFreqConfiguration","paragraph_zero_based":17412},{"literal_text_all_w_t_and_m_t":"Reporting configuration in the frequency domain. (see TS 38.214 [19], clause 5.2.1.4).","paragraph_zero_based":17413},{"literal_text_all_w_t_and_m_t":"reportQuantity","paragraph_zero_based":17414},{"literal_text_all_w_t_and_m_t":"The CSI related quantities to report. see TS 38.214 [19], clause 5.2.1. If the field reportQuantity-r16 or reportQuantity-r17 is present, UE shall ignore reportQuantity (without suffix). Network does not configure reportQuantity-r17 together with reportQuantity-r16.","paragraph_zero_based":17415},{"literal_text_all_w_t_and_m_t":"reportSlotConfig","paragraph_zero_based":17416},{"literal_text_all_w_t_and_m_t":"Periodicity and slot offset (see TS 38.214 [19], clause 5.2.1.4). If the field reportSlotConfig-v1530 is present, the UE shall ignore the value provided in reportSlotConfig (without suffix).","paragraph_zero_based":17417},{"literal_text_all_w_t_and_m_t":"reportSlotOffsetList, reportSlotOffsetListDCI-0-1, reportSlotOffsetListDCI-0-2","paragraph_zero_based":17418},{"literal_text_all_w_t_and_m_t":"Timing offset Y for semi persistent reporting using PUSCH. This field lists the allowed offset values. This list must have the same number of entries as the pusch-TimeDomainAllocationList in PUSCH-Config. A particular value is indicated in DCI. The network indicates in the DCI field of the UL grant, which of the configured report slot offsets the UE shall apply. The DCI value 0 corresponds to the first report slot offset in this list, the DCI value 1 corresponds to the second report slot offset in this list, and so on. The first report is transmitted in slot n+Y, second report in n+Y+P, where P is the configured periodicity.","paragraph_zero_based":17419},{"literal_text_all_w_t_and_m_t":"Timing offset Y for aperiodic reporting using PUSCH. This field lists the allowed offset values. This list must have the same number of entries as the pusch-TimeDomainAllocationList in PUSCH-Config. A particular value is indicated in DCI. The network indicates in the DCI field of the UL grant, which of the configured report slot offsets the UE shall apply. The DCI value 0 corresponds to the first report slot offset in this list, the DCI value 1 corresponds to the second report slot offset in this list, and so on (see TS 38.214 [19], clause 6.1.2.1).","paragraph_zero_based":17420},{"literal_text_all_w_t_and_m_t":"The field reportSlotOffsetListDCI-0-1 applies to DCI format 0_1 and the field reportSlotOffsetListDCI-0-2 applies to DCI format 0_2 (see TS 38.214 [19], clause 6.1.2.1).","paragraph_zero_based":17421},{"literal_text_all_w_t_and_m_t":"The fields reportSlotOffsetList-r17, reportSlotOffsetListDCI-0-1-r17 and reportSlotOffsetListDCI-0-2-r17 are only applicable for SCS 480 kHz and 960 kHz and if they are configured, the UE shall ignore the fields reportSlotOffsetList (without suffix), reportSlotOffsetListDCI-0-1 (without suffix) and reportSlotOffsetListDCI-0-2 (without suffix) for SCS 480 kHz and 960 kHz.","paragraph_zero_based":17422},{"literal_text_all_w_t_and_m_t":"resourcesForChannelMeasurement","paragraph_zero_based":17423}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["6b0b2894e96d675e063ec7726843da8baa46eb0fbfb08129328291955bcc958a","70514bdb5a567df184a3144c6b88477dc6a78ff1141b6f245675864b254325cc","9394672a7f16a46fbf64ab8797deb63e4e99eb15518c5b0dcd91c6195f6c56d8","c8a7c9373af9f10b04d0fb4987e2b4898c8629e5503e25df6bac7114ecd5c8a1","316fcad250fc10fe7096244ebee3d0d1d7d48923d3660b85b02129101f22ec27","63789ad86d5d45ae0d1e5d8152e557e252381b2ca1805bd81652012527f89aaa","683abcab7dd16994269c06d3c606dc3462571a51d9f43b6879f23876ffb5e9e3","38bd314094ec7bf4b0563cf1cc6f4091ed446af88399eb486c4cebc2926da9d0","dc138974039166788abc3394a3dba5caf616b0e19b1f9cd56b12a9fa55ee397c","8a3b555af7f2c44d5c72046e6f89cc5aa03e50259df599fcc609b6db678ce5ce","5460a908f40de4bb656c136105260119c6d5e452b3c1075f0063c59885ddff82","487b35306f2d17d966a4b8926ea14526ed0c3e5b26cae66b94e6821e3dbc2008","ef77c151dfd4148e325a66e884c6b37fae99eeb1f52e433013fd68300c1932cd","9bf26659a77f496fca9ff1fe4fc7a54d4cce2e959b720683f313156a22a46c33","b0f66c5b3c701b41cad3d1d00a74bc47de64729822553453ad05f5259d848d92","a36af85d2322055940fd740b4d03d4470c8e59b48e96bb70c485139d3506189b","219e714d45f06472180aa68d9b8e8c304cab29a381e24ebce118a1db69021551","d6b548e2efb4598c650f4a847e102ffd183d4af5b006ee05dd0e9088ca8bf587","ba4f757cc694a9afa9d066cca87190a688a342f1f0305a38f7538d07a8636b36","97d48ca98243120708775dbafefc9e5ff70d8128a5237aba7fa08f44bf7f29d3","4a42e5af178263e3563658954371db9a19369e08d2e10fca96ce14992cb39b87","54981b14ecef55409ff9d2c9fa7ea23898ce385a70502791689d4392fd634118","72f8f65d6ca95052757e041ed211e472ed4f23b61e52a10477c5923c368320aa","c61aed4434e449563f7609700f08d3da560bec809e30e1e77c6329d6045ab64f"],"paragraph_range_zero_based":[17400,17423],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p17400"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Resources for channel measurement. csi-ResourceConfigId of a CSI-ResourceConfig included in the configuration of the serving cell indicated with the field \"carrier\" above. The CSI-ResourceConfig indicated here contains only NZP-CSI-RS resources and/or SSB resources. This CSI-ReportConfig is associated with the DL BWP indicated by bwp-Id in that CSI-ResourceConfig.","paragraph_zero_based":17424},{"literal_text_all_w_t_and_m_t":"sharedCMR","paragraph_zero_based":17425},{"literal_text_all_w_t_and_m_t":"Enables sharing of channel measurement resources between different CSI measurement hypotheses when (1) csi-ReportMode is set to 'Mode1' and numberOfSingleTRP-CSI-Mode1 is set to 1 or 2; or (2) csi-ReportMode is set to 'Mode2' (see TS 38.214 [19], clause 5.2.1.4.2).","paragraph_zero_based":17426},{"literal_text_all_w_t_and_m_t":"subbandSize","paragraph_zero_based":17427},{"literal_text_all_w_t_and_m_t":"Indicates one out of two possible BWP-dependent values for the subband size as indicated in TS 38.214 [19], table 5.2.1.4-2 . If csi-ReportingBand is absent, the UE shall ignore this field.","paragraph_zero_based":17428},{"literal_text_all_w_t_and_m_t":"timeRestrictionForChannelMeasurements","paragraph_zero_based":17429},{"literal_text_all_w_t_and_m_t":"Time domain measurement restriction for the channel (signal) measurements (see TS 38.214 [19], clause 5.2.1.1).","paragraph_zero_based":17430},{"literal_text_all_w_t_and_m_t":"timeRestrictionForInterferenceMeasurements","paragraph_zero_based":17431},{"literal_text_all_w_t_and_m_t":"Time domain measurement restriction for interference measurements (see TS 38.214 [19], clause 5.2.1.1).","paragraph_zero_based":17432},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17433},{"literal_text_all_w_t_and_m_t":"PortIndexFor8Ranks field descriptions","paragraph_zero_based":17434},{"literal_text_all_w_t_and_m_t":"portIndex8","paragraph_zero_based":17435},{"literal_text_all_w_t_and_m_t":"Port-Index configuration for up to rank 8. If present, the network configures port indexes for at least one of the ranks.","paragraph_zero_based":17436},{"literal_text_all_w_t_and_m_t":"portIndex4","paragraph_zero_based":17437},{"literal_text_all_w_t_and_m_t":"Port-Index configuration for up to rank 4. If present, the network configures port indexes for at least one of the ranks.","paragraph_zero_based":17438},{"literal_text_all_w_t_and_m_t":"portIndex2","paragraph_zero_based":17439},{"literal_text_all_w_t_and_m_t":"Port-Index configuration for up to rank 2. If present, the network configures port indexes for at least one of the ranks.","paragraph_zero_based":17440},{"literal_text_all_w_t_and_m_t":"portIndex1","paragraph_zero_based":17441},{"literal_text_all_w_t_and_m_t":"Port-Index configuration for rank 1.","paragraph_zero_based":17442},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17443},{"literal_text_all_w_t_and_m_t":"PUCCH-CSI-Resource field descriptions","paragraph_zero_based":17444},{"literal_text_all_w_t_and_m_t":"pucch-Resource","paragraph_zero_based":17445},{"literal_text_all_w_t_and_m_t":"PUCCH resource for the associated uplink BWP. Only PUCCH-Resource of format 2, 3 and 4 is supported. The actual PUCCH-Resource is configured in PUCCH-Config and referred to by its ID. When two PUCCH-Config are configured within PUCCH-ConfigurationList, PUCCH-ResourceId in a PUCCH-CSI-Resource refers to a PUCCH-Resource in the PUCCH-Config used for HARQ-ACK with low priority.","paragraph_zero_based":17446},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17447}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["732b5236ab56c966f06805f58c3bf49898978a47ef0db6bb70074923de00a404","c9089a7101a688a35709f01c575a0527a88a6c374fe402d4e7df6e0921fc1e31","da19387488f950d97d7c9724a318145ac0c989602fbed7b820d07ea294acd244","248f4cd640486a2166259615b9ba16a91620f137e421e1dbbc76e069a3cebc1a","6bbefc4df985a5ad1e7680735b84b2d4c5aea038a46f92b626c81882ea319827","11f79eacca749e3031dfbb879f0a47f093199ff2f70620bde8f07d996d85af73","edd53f8e552770f979c26c72979796b66d1c4cdfbb784618ee51d8b306991825","f138ccb05e789f25e47e20bbc26105ee667b44afb1aaf7ceecfca79273bca0b5","d8229dcf75ec89750e81c7e47bbd379f351adb3961a0886784a7512f004bae57","13d73c1a65eb2de9b9d6d19ef55371230f34af5ddcd5639888e335508e51d8ca","30a00d78e12b5adb47005306f4cd328c4926b87e63bda6ed2a95ade6ddcd5984","33888101bbb8e7a07d8ed7de5bc12a021c0e15df117719d49640196f1f48946f","eea3df3d566b55b54a5887a2f7b7e13123c2e41a2d7c86f99ccfee7c1069a0c8","950991c2b70844300a099277ef0a11b7711bd52ea756864f08c3677bb1787f02","5575b5278136ca3ac11c00824466be5e41a7bfca9dd4a138dddf1d29e9b619ee","f8fc097f91b13cd0076c7941c308dc1c593f2091dbf469145ff0a7c4c6ffc5f7","d49e47e1fe5edba989179d36f9ba1fb2b880e2fd0e4513c0d77c631cdf9bccd4","e5eead5c5a855123a2a25d406a14fc6ecaa59ecf62aca7e3880e3f7159b309d8","f05b8522025cfb14d8eeb52d065b7bcf63cdd5f383b903143205246b82fcd58c","b1fa9484048e081be5df292ec94e88be5a3153e806dc3c4c2129797333e4ce7c","a8ef09817e0ad201f60adb1238dd67e2f63787e1d749b0666b06f408596574ae","ff1e88bd0b0b41674fc4d39d590bffb927f05974f6a9efed1a5dcce6122ebb73","b7b6177720eb188f64394516c9a70ee687636cdcac0bee849d14a9acc690e525","52c270f3496dc68b858b101963bb68cf1c639ee572a018bca21a686ed847129a"],"paragraph_range_zero_based":[17424,17447],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p17424"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–CSI-ReportConfigId","paragraph_zero_based":17448},{"literal_text_all_w_t_and_m_t":"The IE CSI-ReportConfigId is used to identify one CSI-ReportConfig.","paragraph_zero_based":17449},{"literal_text_all_w_t_and_m_t":"CSI-ReportConfigId information element","paragraph_zero_based":17450},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17451},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-REPORTCONFIGID-START","paragraph_zero_based":17452},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17453},{"literal_text_all_w_t_and_m_t":"CSI-ReportConfigId ::=              INTEGER (0..maxNrofCSI-ReportConfigurations-1)","paragraph_zero_based":17454},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17455},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-REPORTCONFIGID-STOP","paragraph_zero_based":17456},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17457},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17458},{"literal_text_all_w_t_and_m_t":"–CSI-ResourceConfig","paragraph_zero_based":17459},{"literal_text_all_w_t_and_m_t":"The IE CSI-ResourceConfig defines a group of one or more NZP-CSI-RS-ResourceSet, CSI-IM-ResourceSet and/or CSI-SSB-ResourceSet.","paragraph_zero_based":17460},{"literal_text_all_w_t_and_m_t":"CSI-ResourceConfig information element","paragraph_zero_based":17461},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17462},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-RESOURCECONFIG-START","paragraph_zero_based":17463},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17464},{"literal_text_all_w_t_and_m_t":"CSI-ResourceConfig ::=      SEQUENCE {","paragraph_zero_based":17465},{"literal_text_all_w_t_and_m_t":"    csi-ResourceConfigId        CSI-ResourceConfigId,","paragraph_zero_based":17466},{"literal_text_all_w_t_and_m_t":"    csi-RS-ResourceSetList      CHOICE {","paragraph_zero_based":17467},{"literal_text_all_w_t_and_m_t":"        nzp-CSI-RS-SSB              SEQUENCE {","paragraph_zero_based":17468},{"literal_text_all_w_t_and_m_t":"            nzp-CSI-RS-ResourceSetList  SEQUENCE (SIZE (1..maxNrofNZP-CSI-RS-ResourceSetsPerConfig)) OF NZP-CSI-RS-ResourceSetId","paragraph_zero_based":17469},{"literal_text_all_w_t_and_m_t":"                                                                                                                            OPTIONAL, -- Need R","paragraph_zero_based":17470},{"literal_text_all_w_t_and_m_t":"            csi-SSB-ResourceSetList     SEQUENCE (SIZE (1..maxNrofCSI-SSB-ResourceSetsPerConfig)) OF CSI-SSB-ResourceSetId  OPTIONAL  -- Need R","paragraph_zero_based":17471}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["69b6adec231a1358cf932e3468b6f61ed1d43a7a2216b9e84c12006c7058e265","4bca71170614a1edf1d04770c849d2953f0fdf3d1b580a1772563075c51552be","c511027c173655be8110966005628a4415a6a09ab6cd7f2025950a58e9ea6d5e","fb19d3c0a1017cd6346477f65d12b951aeb55db698a2a37c09a24acec7f7bedc","06361b6f22b86f3813f71e19bdf6e93a6ed0e40784c5a21efdd2fe38cd3f0153","16eb852c5ccd85a600c70c8c7de0e489f4f5e0552773ad61b5b4997db7bd56fa","9cd4dcca9123ca25a7cfb47e22e55eab1514e53902d455f37d2f7e8fc64700a5","7e98b0d2b94cd562a9f33c95f2d55e065a84d8ce10ee9393491c81525e7a98eb","8834c017980fdb589381b4e5cbcad37bf9257dd1902a04ef84f5255e50b4a94c","ea30dc575b7433a80a5cb2abd1d6945ab8e672d761c634e6336f345b72e9a54a","77a1c88fa08bd70ad869a5b7923d8146e5740348eb035fa954659c0f15e02f3a","861871c1f51d73c83f3546dc70dbf96da29c50e6e57e3362084b73a80ba2618d","56b1235faf3b1