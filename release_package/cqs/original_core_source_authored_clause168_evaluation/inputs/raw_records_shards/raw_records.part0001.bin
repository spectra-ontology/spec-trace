{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18144},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18145},{"literal_text_all_w_t_and_m_t":"PEI-Config-r17 ::=                        SEQUENCE {","paragraph_zero_based":18146},{"literal_text_all_w_t_and_m_t":"    po-NumPerPEI-r17                          ENUMERATED {po1, po2, po4, po8},","paragraph_zero_based":18147},{"literal_text_all_w_t_and_m_t":"    payloadSizeDCI-2-7-r17                    INTEGER (1..maxDCI-2-7-Size-r17),","paragraph_zero_based":18148},{"literal_text_all_w_t_and_m_t":"    pei-FrameOffset-r17                       INTEGER (0..16),","paragraph_zero_based":18149},{"literal_text_all_w_t_and_m_t":"    subgroupConfig-r17                        SubgroupConfig-r17,","paragraph_zero_based":18150},{"literal_text_all_w_t_and_m_t":"    lastUsedCellOnly-r17                      ENUMERATED {true}                                                OPTIONAL,  -- Need R","paragraph_zero_based":18151},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":18152},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18153},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18154},{"literal_text_all_w_t_and_m_t":"SubgroupConfig-r17 ::=     SEQUENCE {","paragraph_zero_based":18155},{"literal_text_all_w_t_and_m_t":"    subgroupsNumPerPO-r17      INTEGER (1.. maxNrofPagingSubgroups-r17),","paragraph_zero_based":18156},{"literal_text_all_w_t_and_m_t":"    subgroupsNumForUEID-r17    INTEGER (1.. maxNrofPagingSubgroups-r17)                                        OPTIONAL,  -- Need S","paragraph_zero_based":18157},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":18158},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18159},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18160},{"literal_text_all_w_t_and_m_t":"-- TAG-DOWNLINKCONFIGCOMMONSIB-STOP","paragraph_zero_based":18161},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18162},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18163},{"literal_text_all_w_t_and_m_t":"DownlinkConfigCommonSIB field descriptions","paragraph_zero_based":18164},{"literal_text_all_w_t_and_m_t":"bcch-Config","paragraph_zero_based":18165},{"literal_text_all_w_t_and_m_t":"The modification period related configuration.","paragraph_zero_based":18166},{"literal_text_all_w_t_and_m_t":"frequencyInfoDL-SIB","paragraph_zero_based":18167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["441b51945ec3404a605daacdaaede855b69b439e983452d78c4f17efd6f9c35d","7c0f5fea9d2b0e31856f5d65e249d63e334c08efc218cbdbb9b9320a3d36af8a","06b6d28036ababb16e9187bd52430f58e904b6786cd733d353b4bafc5db3a634","3eeabbe43efa418558dd49bdde1929b7ebf549f2df2bdfc007fc2ce494ae7269","e3755e07575deb9dbc3c6a61872f9c15daea3e6bcecd74400cd3a369f709869a","634092e84c3af50a1ee5189d0ae9830c371ecc972ede84e49688f288d573407c","152df680f8e8b800d1a06031a02db023d70605292dd562c4f94e00d01dcfb01d","d58902e6c0e05b2ebbeefeedbe6643a65fdf3242ec0eaa045a275905d81ddf9a","8344c62d70c454de44fd25f4eacd64981e6fcc3f224e23e2b9af1a927816da5a","7733b948d360637595662e89cd507753db74c903e071deef7374b9632d62d286","7ac820cb8390f8a38e7f49476ac9a310536d581d904d1a7916db73d78a03c29b","50ed94ef268ca43d5dcb9c4e32faa7106310826efe0ff486d79dc9df37addd87","2d7ecd6a6e706a0b88e60d3b636f854753049413bf0b67073cd8a6d4459d8796","74ef481151b2f31f4af4cd7baeb69b2ec678b23ca1f3fe865f7950ba04cebdfa","3184089208ebd3d688dd5662b5798d5a023e3be2650a34abacb1537edd43536d","31d8dcbef8935f57193ec17286708b3722e4ffafd7f2b73cbd437bca284fa967","ca9c4c83c82b0d2a031dc89343318f54bda7bb253e8f61f747e6a3fa4b18d92d","4fa5fbb80cadaad46ec03bbe87cb04f113f00a97ae86a5ab961239fb389d1c0e","e22e82cd3909c469cd3736d309a27607ef8973a7415a3106837e79cec6464ef5","e3042393d9d0b50d7955ef6d7df6600762165879b7f88dc9e46f93fe99d2c5aa","f71e8228e723aca35bafe09ed931ddb5b3f1766dd62876ab8957df0cba8889c8","8e43bcd97cdf5684768444da162f1e877164582f9250154ddfa95fd83d7df517","2af740ab7e232c5de602f41762f44820a3d77c7c9d49bc50e2051c9c02285a66","1b6b786b1885fe64e1d51e4cff668f0884ae6699a3f3480dbba5998849d9633d"],"paragraph_range_zero_based":[18144,18167],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p18144"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Basic parameters of a downlink carrier and transmission thereon.","paragraph_zero_based":18168},{"literal_text_all_w_t_and_m_t":"initialDownlinkBWP","paragraph_zero_based":18169},{"literal_text_all_w_t_and_m_t":"The initial downlink BWP configuration for a PCell. The network configures the locationAndBandwidth so that the initial downlink BWP contains the entire CORESET#0 of this serving cell in the frequency domain. The UE applies the locationAndBandwidth upon reception of this field (e.g. to determine the frequency position of signals described in relation to this locationAndBandwidth) but it keeps CORESET#0 until after reception of RRCSetup/RRCResume/RRCReestablishment.","paragraph_zero_based":18170},{"literal_text_all_w_t_and_m_t":"initialDownlinkBWP-RedCap","paragraph_zero_based":18171},{"literal_text_all_w_t_and_m_t":"If present, RedCap UEs use this DL BWP instead of initialDownlinkBWP. If the locationAndBandwidth of this BWP contains the entire CORESET#0, the UE applies the locationAndBandwidth upon reception of this field (e.g. to determine the frequency position of signals described in relation to this locationAndBandwidth) but it keeps CORESET#0 until after reception of RRCSetup/RRCResume/RRCReestablishment. Otherwise, i.e., if the locationAndBandwidth of this BWP does not contain the entire CORESET#0, the UE uses this BWP for receiving DL messages during initial access (Msg2, MsgB, Msg4) and after initial access.","paragraph_zero_based":18172},{"literal_text_all_w_t_and_m_t":"If absent, RedCap UEs use initialDownlinkBWP provided that it does not exceed the RedCap UE maximum bandwidth (see also clause 5.2.2.4.2).","paragraph_zero_based":18173},{"literal_text_all_w_t_and_m_t":"lastUsedCellOnly","paragraph_zero_based":18174},{"literal_text_all_w_t_and_m_t":"When present, the field indicates that the UE monitors PEI only if the latest received RRCRelease without noLastCellUpdate is from this cell. A PEI-capable UE stores its last used cell information.","paragraph_zero_based":18175},{"literal_text_all_w_t_and_m_t":"nrofPDCCH-MonitoringOccasionPerSSB-InPO","paragraph_zero_based":18176},{"literal_text_all_w_t_and_m_t":"The number of PDCCH monitoring occasions corresponding to an SSB within a Paging Occasion, see TS 38.304 [20], clause 7.1.","paragraph_zero_based":18177},{"literal_text_all_w_t_and_m_t":"pcch-Config","paragraph_zero_based":18178},{"literal_text_all_w_t_and_m_t":"The paging related configuration.","paragraph_zero_based":18179},{"literal_text_all_w_t_and_m_t":"pei-Config","paragraph_zero_based":18180},{"literal_text_all_w_t_and_m_t":"The PEI related configuration.","paragraph_zero_based":18181},{"literal_text_all_w_t_and_m_t":"subgroupConfig","paragraph_zero_based":18182},{"literal_text_all_w_t_and_m_t":"The paging subgroup related configuration.","paragraph_zero_based":18183},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18184},{"literal_text_all_w_t_and_m_t":"BCCH-Config field descriptions","paragraph_zero_based":18185},{"literal_text_all_w_t_and_m_t":"modificationPeriodCoeff","paragraph_zero_based":18186},{"literal_text_all_w_t_and_m_t":"Actual modification period, expressed in number of radio frames m = modificationPeriodCoeff * defaultPagingCycle, see clause 5.2.2.2.2. n2 corresponds to value 2, n4 corresponds to value 4, and so on.","paragraph_zero_based":18187},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18188},{"literal_text_all_w_t_and_m_t":"PCCH-Config field descriptions","paragraph_zero_based":18189},{"literal_text_all_w_t_and_m_t":"defaultPagingCycle","paragraph_zero_based":18190},{"literal_text_all_w_t_and_m_t":"Default paging cycle, used to derive 'T' in TS 38.304 [20]. Value rf32 corresponds to 32 radio frames, value rf64 corresponds to 64 radio frames and so on.","paragraph_zero_based":18191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["11501f11d516fc5fbf322487273701b50a6d39a697625afafa25d907454a114d","131a3ce18aaba114f1ce8c3078742e941bf46d0d01547eb9c3d6513f4d43c03f","0c43ee66dcefd6117c2a17f1484b4f5d7c9cf23c4cb1f1deaaef069db5186b2c","983d03e22eec0aaedb2fc99c19448f4179c1e4e2607f808713f74cf45a1e3659","f543f2cbb485a433e0edb33d188cfc641046c0a27974e09e9b0324eabc2858ab","4712a4841bb95a20e72f078b91f491ed6f75ef434305e94f6549e28f025df00c","82c5aacc7e716e742578b34809b25d08a2822e5522522fa9164828420843de47","390ee405f44ad0d77a205bb5d103485f8fda84c59cf4dcdc4281cc42c508b51c","4e076503b2e562b4e1805ed11b9d133503147e3b09516ca43c1a89cfe6cee119","50f1752079a04e857bc03d3acf027447fa346b3ded90a077e71409390af4313f","df0bd4dd94c4426311a4df24dcdc4384219656becfb83506c59fe04ec592d8a9","944965dd3a45363c879152ad9c3fefe8828fe327d53f07e02479e5f55311511a","1e75d546d493a276da901594992b1e0f1cab534fa49bfd2f224674f8abb58b62","1d01e56132bb941c623a84f2c1c324b3d1c8ad8a9e33be0b4dd6dc24a820aaba","b81c5bdcc54d07ee38523587f98d2753adfd913f4d69b506d2e17140b52defe3","a86e83152a90c6f17cd880d7c3e3a2571b0e239ef2d0634ab1e1bb178f48efb7","05695233d8a23a3db2151a899bf0db803f8221b298ccc3c4426c8b3f4a420cf8","3ac81cbeae97a0c1d6e444e17da77d71d507206b585e06c9ddf144a6f8923c52","8f543e173d0cb36b18c15c0e5aa2a9595096338772bd4a2dc84012cec11a47b0","27b49fcf73a5f57ab28e02ba3279741444cc0ac147fabae11155c8f9d3c89351","6135d093494bc5509b981e58af4c7a40c8096e9b97fea11d822b0c62adadda6e","fb86c8d3f128f427331a2c5fdea4000c93440d020736457a2aff4017a6e5d400","ecf3d4a267d697ab4103531d433d32b18a94a2ffcc2a9e7c89ef9070d66748de","8921b108388446a262989cad2c7493d6fd8e2790cd3586ef3f677262bf2436cb"],"paragraph_range_zero_based":[18168,18191],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p18168"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"firstPDCCH-MonitoringOccasionOfPO","paragraph_zero_based":18192},{"literal_text_all_w_t_and_m_t":"Points out the first PDCCH monitoring occasion for paging of each PO of the PF, see TS 38.304 [20].","paragraph_zero_based":18193},{"literal_text_all_w_t_and_m_t":"nAndPagingFrameOffset","paragraph_zero_based":18194},{"literal_text_all_w_t_and_m_t":"Used to derive the number of total paging frames in T (corresponding to parameter N in TS 38.304 [20]) and paging frame offset (corresponding to parameter PF_offset in TS 38.304 [20]). A value of oneSixteenthT corresponds to T / 16, a value of oneEighthT corresponds to T / 8, and so on.","paragraph_zero_based":18195},{"literal_text_all_w_t_and_m_t":"If pagingSearchSpace is set to zero and if SS/PBCH block and CORESET multiplexing pattern is 2 or 3 (as specified in TS 38.213 [13]):","paragraph_zero_based":18196},{"literal_text_all_w_t_and_m_t":"-for ssb-periodicityServingCell of 5 or 10 ms, N can be set to one of {oneT, halfT, quarterT, oneEighthT, oneSixteenthT}","paragraph_zero_based":18197},{"literal_text_all_w_t_and_m_t":"-for ssb-periodicityServingCell of 20 ms, N can be set to one of {halfT, quarterT, oneEighthT, oneSixteenthT}","paragraph_zero_based":18198},{"literal_text_all_w_t_and_m_t":"-for ssb-periodicityServingCell of 40 ms, N can be set to one of {quarterT, oneEighthT, oneSixteenthT}","paragraph_zero_based":18199},{"literal_text_all_w_t_and_m_t":"-for ssb-periodicityServingCell of 80 ms, N can be set to one of {oneEighthT, oneSixteenthT}","paragraph_zero_based":18200},{"literal_text_all_w_t_and_m_t":"-for ssb-periodicityServingCell of 160 ms, N can be set to oneSixteenthT","paragraph_zero_based":18201},{"literal_text_all_w_t_and_m_t":"If pagingSearchSpace is set to zero and if SS/PBCH block and CORESET multiplexing pattern is 1 (as specified in TS 38.213 [13]), N can be set to one of {halfT, quarterT, oneEighthT, oneSixteenthT}","paragraph_zero_based":18202},{"literal_text_all_w_t_and_m_t":"If pagingSearchSpace is not set to zero, N can be configured to one of {oneT, halfT, quarterT, oneEighthT, oneSixteenthT}","paragraph_zero_based":18203},{"literal_text_all_w_t_and_m_t":"ns","paragraph_zero_based":18204},{"literal_text_all_w_t_and_m_t":"Number of paging occasions per paging frame.","paragraph_zero_based":18205},{"literal_text_all_w_t_and_m_t":"ranPagingInIdlePO","paragraph_zero_based":18206},{"literal_text_all_w_t_and_m_t":"Indicates that the network supports to send RAN paging in PO that corresponds to the i_s as determined by UE in RRC_IDLE state, see TS38.304 [20].","paragraph_zero_based":18207},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18208},{"literal_text_all_w_t_and_m_t":"PEI-Config field descriptions","paragraph_zero_based":18209},{"literal_text_all_w_t_and_m_t":"payloadSizeDCI-2-7","paragraph_zero_based":18210},{"literal_text_all_w_t_and_m_t":"Payload size of PEI DCI, i.e., DCI format 2_7. The size is no larger than the payload size of paging DCI which has maximum of 41 bits and 43 bits for licensed and unlicensed spectrums, respectively.","paragraph_zero_based":18211},{"literal_text_all_w_t_and_m_t":"pei-FrameOffset","paragraph_zero_based":18212},{"literal_text_all_w_t_and_m_t":"Offset, in number of frames from the start of a reference frame for PEI-O to the start of a first paging frame of the paging frames associated with the PEI-O, see TS 38.213 [13], clause 10.4A.","paragraph_zero_based":18213},{"literal_text_all_w_t_and_m_t":"po-NumPerPEI","paragraph_zero_based":18214},{"literal_text_all_w_t_and_m_t":"The number of PO(s) associated with one PEI monitoring occasion. It is a factor of the total PO number in a paging cycle, i.e N x Ns, as specified in TS 38.304 [20]. The maximum number of PF associated with one PEI monitoring occasion is 2. The number of PO mapping to one PEI should be multiple of Ns when po-NumPerPEI is larger than Ns.","paragraph_zero_based":18215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["8584cd59a4df9069fdb429fc2ec78cd75fa34c118b516836010beb5dea5bf70f","a20ec688b446ede9c93ad1d807abb161b87874fce6ddc16018855db7ca754686","80de460385b0e0b88cd8cf1742528a1d433fae94836d874629b9fd9bc1a49ed9","34099608a37939a8f8898880017b3f190d26de33a67793f90c1404dc65388763","d6c4e33d0d7f340b9fc3235ab4be687ca683aca1624797f31a41c6a49da675e6","61a0c1a354f2203b45885202782a4d63ea4c2100e54f239f205f0bbb3b9f4382","b2aa6913caf55a9a35f036046db3cb9fbff6a1d94ed9d3facf6f2306bae2dd09","f555fc6bd26a097e56d0e7dde853166756017a80a74247ea081af33abd98bbb8","52a6233ac78fce906f76d4208c1c397bc2cb98e65b474003da7c62ea5abcaee8","f9eb61e16a353cecedbcdcf450b2c5a3f24efbcffd99602ecb7dd2d454436461","1d03f1d7e3dfb0163922108431b6edb6b79766e41c4b47c346983361f86828f6","11eb6b312cd2ac88ffee8df85782cea03b19a1df52560e370b0421f8eaf76088","cc2c6db6ef4917eba70a2168022fb13ca78882ad6c131f0431408474b57b879e","965ac875e1136ea083ae0146e11c34673aa1ee2c3b1ee97de34542d508451505","9571ca51c2610b5e336d0b658117f499c112e42c90e666a5dd565e78789aa611","35cb654b98915bf7602be22efea7c96927fb5ce2fdd0c70b3836e2a0fadbb73a","2ea49e22bda803910f3fea247a5d752a131cdd26c507b834a431800388c2816f","740efae75b9c497973520e25d4905d54341e8565a7efce88565881e67ff84a94","8fb6b41ab75c11e85cfe512e63af5248f77a1a128724b568bd4de4625f13016b","f673495d63882fdbc8d4554dff0a82263aa8d9fb8bcbec133013340dfe5a7a70","6723249f85fd63d0b1f9dbcf4db5d2cf315f4fda16d47a2ea284e3df10ddba13","032ee375bc6df927527e29379cf782efee231fc74b85648e9ec934eb6114ce96","2d013faa7dfa16f349592e27bda8d2ae195e190a2d391232a359e6d038f7cc57","2fe7be7b05bf46fee114ece3bc4bdb713bc38ec31e331a5aeb1922410ee5b54f"],"paragraph_range_zero_based":[18192,18215],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p18192"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18216},{"literal_text_all_w_t_and_m_t":"SubgroupConfig field descriptions","paragraph_zero_based":18217},{"literal_text_all_w_t_and_m_t":"subgroupsNumPerPO","paragraph_zero_based":18218},{"literal_text_all_w_t_and_m_t":"Total number of subgroups per Paging Occasion (PO) for UE to read subgroups indication from physical-layer signaling. The field represents the sum of CN-assigned and UEID-based subgroups supported by the network. When PEI-Config is configured, there is always at least one subgroup (UEID-based subgroup or CN-assigned subgroup) configured.","paragraph_zero_based":18219},{"literal_text_all_w_t_and_m_t":"subgroupsNumForUEID","paragraph_zero_based":18220},{"literal_text_all_w_t_and_m_t":"Number of subgroups per Paging Occasion (PO) for UE to read subgroups indication from physical-layer signaling, for UEID-based subgrouping method. When present, the field is set to an integer smaller than or equal to subgroupsNumPerPO. subgroupsNumPerPO equals to subgroupsNumForUEID when the network does not configure CN-assigned subgrouping. When pei-Config is configured, the field is absent when the network only configures CN-assigned subgrouping. Both this field and subgroupsNumPerPO are equal to 1 when the network does not configure subgrouping. When pei-Config is configured, if the field is absent, the UE uses subgrouping according to TS 38.304 [20], clause 7.3.0.","paragraph_zero_based":18221},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18222},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":18223},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":18224},{"literal_text_all_w_t_and_m_t":"SharedSpectrum2","paragraph_zero_based":18225},{"literal_text_all_w_t_and_m_t":"The field is optional present, Need R, if this cell operates with shared spectrum channel access. Otherwise, it is absent, Need R.","paragraph_zero_based":18226},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18227},{"literal_text_all_w_t_and_m_t":"–DownlinkPreemption","paragraph_zero_based":18228},{"literal_text_all_w_t_and_m_t":"The IE DownlinkPreemption is used to configure the UE to monitor PDCCH for the INT-RNTI (interruption).","paragraph_zero_based":18229},{"literal_text_all_w_t_and_m_t":"DownlinkPreemption information element","paragraph_zero_based":18230},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18231},{"literal_text_all_w_t_and_m_t":"-- TAG-DOWNLINKPREEMPTION-START","paragraph_zero_based":18232},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18233},{"literal_text_all_w_t_and_m_t":"DownlinkPreemption ::=              SEQUENCE {","paragraph_zero_based":18234},{"literal_text_all_w_t_and_m_t":"    int-RNTI                            RNTI-Value,","paragraph_zero_based":18235},{"literal_text_all_w_t_and_m_t":"    timeFrequencySet                    ENUMERATED {set0, set1},","paragraph_zero_based":18236},{"literal_text_all_w_t_and_m_t":"    dci-PayloadSize                     INTEGER (0..maxINT-DCI-PayloadSize),","paragraph_zero_based":18237},{"literal_text_all_w_t_and_m_t":"    int-ConfigurationPerServingCell     SEQUENCE (SIZE (1..maxNrofServingCells)) OF INT-ConfigurationPerServingCell,","paragraph_zero_based":18238},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":18239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["f4e6d83df1ded7ed81e0cfae8b223790ffe2d812ac57b185ea24aa86ddf544a4","62f146db73a98bd67e9a46128ca43cbb91