{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    frequencyBandList-v1760             MultiFrequencyBandListNR-SIB-v1760","paragraph_zero_based":18720},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18721},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18722},{"literal_text_all_w_t_and_m_t":"FrequencyInfoDL-SIB-v18xy ::=       SEQUENCE {","paragraph_zero_based":18723},{"literal_text_all_w_t_and_m_t":"    frequencyBandListAerial-r18         MultiFrequencyBandListNR-Aerial-SIB-r18","paragraph_zero_based":18724},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18725},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18726},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQUENCYINFODL-SIB-STOP","paragraph_zero_based":18727},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18728},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18729},{"literal_text_all_w_t_and_m_t":"FrequencyInfoDL-SIB field descriptions","paragraph_zero_based":18730},{"literal_text_all_w_t_and_m_t":"offsetToPointA","paragraph_zero_based":18731},{"literal_text_all_w_t_and_m_t":"Represents the offset to Point A as defined in TS 38.211 [16], clause 4.4.4.2.","paragraph_zero_based":18732},{"literal_text_all_w_t_and_m_t":"frequencyBandList","paragraph_zero_based":18733},{"literal_text_all_w_t_and_m_t":"List of one or multiple frequency bands to which this carrier(s) belongs. If frequencyBandList-v1760 is present, it shall contain the same number of entries, listed in the same order as in frequencyBandList (without suffix).","paragraph_zero_based":18734},{"literal_text_all_w_t_and_m_t":"scs-SpecificCarrierList","paragraph_zero_based":18735},{"literal_text_all_w_t_and_m_t":"A set of carriers for different subcarrier spacings (numerologies). Defined in relation to Point A (see TS 38.211 [16], clause 5.3). The network configures this for all SCSs that are used in DL BWPs in this serving cell.","paragraph_zero_based":18736},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18737},{"literal_text_all_w_t_and_m_t":"–FrequencyInfoUL","paragraph_zero_based":18738},{"literal_text_all_w_t_and_m_t":"The IE FrequencyInfoUL provides basic parameters of an uplink carrier and transmission thereon.","paragraph_zero_based":18739},{"literal_text_all_w_t_and_m_t":"FrequencyInfoUL information element","paragraph_zero_based":18740},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18741},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQUENCYINFOUL-START","paragraph_zero_based":18742},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18743}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["6f0bac732f4c024987999e5ec1ac7376a7d6c929e7fef245b7063831e10cbae4","465a33f22dc46415818699809fb407acadf878f44fa7298721907e6fc87a0e13","99a5a54b92978571659872612dc44b1799b38bf884c49b40fe65085b294dcc35","c2da4cd1a2fac6c1b368fdd867afab5ef4649bcd5b45d0e8f8e61195cf712ae7","eaa3d01ba432ab68af49fd246389f706f5244a8bf4730ca56d1e28473f5584b1","e479b58d7e4e30f5c22d19ae926ff00e41582f1bcd3697f4da0789f6e7063612","98e3e7a86b0922b96498769feec94981205dbaa1978173e9e3fef42ae7c697b3","7df81beabe2cdd1fff730d15b2a08d8f52f8e142af4cbf5201bb1e9a77305ac8","72397d979f7cb0f74d2f362e1dafa09d7ad0aba3819b1a682542b146901a3d8e","30863ac2228b15afc725d30cd0285c3c3ee7acd1a4d859fc7cc30df33352fdc9","1fde6a15312907826c30dd894e3234c2730a86766f14022c06abfa48474ef50e","87d268a2b06f3d33fc06b69752b3d3b905c3ce204b11f4b8508955d0a786df39","b500788b2e8061d75a4cab7ba182309f1ff71e0cf5418627f3f1d29f28158568","914a5512728