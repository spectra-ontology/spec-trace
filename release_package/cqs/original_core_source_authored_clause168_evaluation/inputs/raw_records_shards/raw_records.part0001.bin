t_and_m_t":"}","paragraph_zero_based":11461},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11462},{"literal_text_all_w_t_and_m_t":"FeaturePriority-r17 ::= INTEGER (0..7)","paragraph_zero_based":11463},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11464},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB1-STOP","paragraph_zero_based":11465},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":11466},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11467},{"literal_text_all_w_t_and_m_t":"SIB1 field descriptions","paragraph_zero_based":11468},{"literal_text_all_w_t_and_m_t":"cellBarredNTN","paragraph_zero_based":11469},{"literal_text_all_w_t_and_m_t":"Value barred means that the cell is barred for connectivity to NTN, as defined in TS 38.304 [20]. Value notBarred means that the cell is allowed for connectivity to NTN. If not present, the UE considers the cell is not allowed for connectivity to NTN, as defined in TS 38.304 [20]. This field is only applicable to NTN-capable UEs.","paragraph_zero_based":11470},{"literal_text_all_w_t_and_m_t":"cellBarredRedCap1Rx","paragraph_zero_based":11471}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["a794427e6b5e931e1a880d4648b1c035953848e3d75afabcc8a122d33e1959b1","4fa6cf606ea8016b54a745c4e4e89de1ecb7c544e30619a9482571333b0b1411","0b824297c0545a1b32a6223771a517c7fd10ae14ba2f563aa5382e8d6f4e72a9","765b67717a6016633416047255379b1cbb68135e2da8a3abbc01e74fb3d582df","9ea682990e38794332bd3f8c7a7f89eb3c094b75391a7f825200a3bf0cc0eb91","795209b4b79341bc58a99072b71edcdc12905934f63625ebeb3f21ed6e56908a","927d354d2ea1b57643cc8f8444ba81640bdc2d7d456260a89c32b8532c16829a","31d2719d4eb834152635095ef1504538ef7a6e4fed44be470bb9bd07c7e5aa75","edd33d7d5300678aaf56f519dc63b6e392d487e18ce9f2a4817e677e9c663c74","f3b73e2c5def7aa28b7409892c9ebbf7e28dff4c90c02837139129e5c422cb7d","05b01b4bd5703f01bfa65a8507138b7f073fcf1ce40e296f282362aff749e33e","72639a2ec2fe23b6af544ab6a749a0d8caeb698c4935cf99ffed1a1e779fc7ec","f3fcb5ce0489744204c54d3f81e942d4e07db97bdb159a2bf4f388bf883196ac","8a398755042ac25f24ee029e9bb6d60ad35da62c3b7220b97c414c7797fa6b00","92a2bc183b90188c23a648d7143a3f498fe8968be2d46575467b2a76ba052d59","676cd5a1a767090c6c5d582c3500068a056b1cff71a64f7e8515d051d54f7e28","fe2dae099fd324d53699026278e68e33d0be58a1261ac13722f26f21461f1986","808a8667d24ab507ed09e6d8d67ae62043f63e77abdac84c9ebef89ff282540f","2d33025d364ae3d0a4e87220a4d7bd4fd5fe0dd9abea23d670cf4875de9163c5","9f7d711d132684c0417491d4ffbda5c15c9ca22775f894113ab9e3787bdf3f4f","e74cd2268d7ea9986127f8af2be4b2145d204c92538918ee08849ae3425cf46c","897b403129cf5701b7772e752100c6d1f9b7e40b5c027b1406e880c9577d25cd","e01db8f1eec849e3c59b7d1ff7fdc497229ad139cabcc6f31b8f7b0ea012d3dc","02bf8d6ee3dd3b49965f053920aaf9881077ed6082cf599ef6dea79e0ec0845e"],"paragraph_range_zero_based":[11448,11471],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p11448"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Value barred means that the cell is barred for a RedCap UE with 1 Rx branch, as defined in TS 38.304 [20]. This field is ignored by non-RedCap UEs.","paragraph_zero_based":11472},{"literal_text_all_w_t_and_m_t":"cellBarredRedCap2Rx","paragraph_zero_based":11473},{"literal_text_all_w_t_and_m_t":"Value barred means that the cell is barred for a RedCap UE with 2 Rx branches, as defined in TS 38.304 [20]. This field is ignored by non-RedCap UEs.","paragraph_zero_based":11474},{"literal_text_all_w_t_and_m_t":"cellSelectionInfo","paragraph_zero_based":11475},{"literal_text_all_w_t_and_m_t":"Parameters for cell selection related to the serving cell.","paragraph_zero_based":11476},{"literal_text_all_w_t_and_m_t":"eCallOverIMS-Support","paragraph_zero_based":11477},{"literal_text_all_w_t_and_m_t":"Indicates whether the cell supports eCall over IMS services as defined in TS 23.501 [32]. If absent, eCall over IMS is not supported by the network in the cell.","paragraph_zero_based":11478},{"literal_text_all_w_t_and_m_t":"eDRX-AllowedIdle","paragraph_zero_based":11479},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that extended DRX for CN paging is allowed in the cell for UEs in RRC_IDLE or RRC_INACTIVE. The UE shall stop using extended DRX for CN paging in RRC_IDLE or RRC_INACTIVE if eDRX-AllowedIdle is not present.","paragraph_zero_based":11480},{"literal_text_all_w_t_and_m_t":"eDRX-AllowedInactive","paragraph_zero_based":11481},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that extended DRX for RAN paging is allowed in the cell for UEs in RRC_INACTIVE. The UE shall stop using extended DRX for RAN paging in RRC_INACTIVE if eDRX-AllowedInactive is not present.","paragraph_zero_based":11482},{"literal_text_all_w_t_and_m_t":"featurePriorities","paragraph_zero_based":11483},{"literal_text_all_w_t_and_m_t":"Indicates priorities for features, such as RedCap, Slicing, SDT and MSG3-Repetitions for Coverage Enhancements. These priorities are used to determine which FeatureCombinationPreambles the UE shall use when a feature maps to more than one FeatureCombinationPreambles, as specified in TS 38.321 [3]. A lower value means a higher priority. The network does not signal the same priority for more than one feature. The network signals a priority for all feature that map to at least one FeatureCombinationPreambles.","paragraph_zero_based":11484},{"literal_text_all_w_t_and_m_t":"halfDuplexRedCap-Allowed","paragraph_zero_based":11485},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that the cell supports half-duplex FDD RedCap UEs.","paragraph_zero_based":11486},{"literal_text_all_w_t_and_m_t":"hsdn-Cell","paragraph_zero_based":11487},{"literal_text_all_w_t_and_m_t":"This field indicates this is a HSDN cell as specified in TS 38.304 [20].","paragraph_zero_based":11488},{"literal_text_all_w_t_and_m_t":"hyperSFN","paragraph_zero_based":11489},{"literal_text_all_w_t_and_m_t":"Indicates hyper SFN which increments by one when the SFN wraps around. This field is excluded when determining changes in system information, i.e. changes of hyper SFN should not result in system information change notifications.","paragraph_zero_based":11490},{"literal_text_all_w_t_and_m_t":"idleModeMeasurementsEUTRA","paragraph_zero_based":11491},{"literal_text_all_w_t_and_m_t":"This field indicates that a UE that is configured for EUTRA idle/inactive measurements shall perform the measurements while camping in this cell and report availability of these measurements when establishing or resuming a connection in this cell. If absent, a UE is not required to perform EUTRA idle/inactive measurements.","paragraph_zero_based":11492},{"literal_text_all_w_t_and_m_t":"idleModeMeasurementsNR","paragraph_zero_based":11493},{"literal_text_all_w_t_and_m_t":"This field indicates that a UE that is configured for NR idle/inactive measurements shall perform the measurements while camping in this cell and report availability of these measurements when establishing or resuming a connection in this cell. If absent, a UE is not required to perform NR idle/inactive measurements.","paragraph_zero_based":11494},{"literal_text_all_w_t_and_m_t":"ims-EmergencySupport","paragraph_zero_based":11495}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["e270d8d495f3ebdaaeb3ba609ac553f8abb2d55c6535d9e6d447f3869e3487f6","da4174ae79c3d43f42721f10a675334eb06ddf1919330f24eda2cdb3e015d5ce","e47c4a998dc425c80c961a1f2f728e70fffd80715d37f321585fa5cd9f89fcfb","a6b05e960f6ddfcadb6b7977e22d4f8dfc93b6f794f01897690aa87b5fa7cb07","1e660e995dd27867c85db88809af05b18e78afdeeb1f294568e41dc38fc351e0","234da8b5885f75a6199157d3ae575e42311bf8dc28b3c49fbfdcbf75dcdfcf76","58ef052b9fd6fd56855364029805fb46d34fbaa4126fc9706641a770d0851923","45e61db748ebc47b55b1560b494890be7310e59b9d3f93e5f13ce8c82a97756b","e43ed1163562846fe50f2b0e42d96ed2683d42e4229f1246c18976868535540c","4b92ac9d28a6fa5282c5a389e91728d239acdddfce2316c293f2ef89d2eef1ba","164e938c90e0ec9cef47538d9eedb9adb73cd963d8f8aa49409e658451aa9a96","f662330ea77aea2670719b3cbbfb6041c30bb6e5126650c510776693f2df2af5","10fa6926727e5aa0dab063f68a65449b95972e0eb76d0a9d6f558653aca760da","ef113aa81a0a77f669d8297f33b942ef89d18fe1f5ed1b9f62a7e9ca38006999","c14d5cc0526c15ae810ef507f7389b831c41fbcf99b6673d4f3774cc073ed0d7","4b5e74b33360762aa5b7d27b0164d413ddf4394174ca80c8be0a59d9e2e814c8","5eb3d17e5725725dd8ff71f9a605ae93f4e61ac71506c39d6146e799035e7a7f","343fdea04a9afd073861a6bbc539130ee75b47f5cc5a7881f7d5a564c34021e3","6e886af72558d4a86fa75467a9de3eaf410d3f74338433504e518ea9923ff34c","349d02893924819973ae84fb2b8c943c0673fd89c2386529cbd7f6e1d359dbf2","cc3d887f497d644db463264d13124e5add84260ede9a4e12a4d37d08733ff5b0","abe1891fb8057ac18756215d134553ed584b86cbea7bc562f844dedbc2a00ccd","5b12ac6b71b8b152178fb2e6db1509d167698a484c6adefec52048790e0bf2a0","47ca1bbeaffc6771ec47576c479195a55bcff073f6f7af19d9b73669d9ebd4ed"],"paragraph_range_zero_based":[11472,11495],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p11472"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether the cell supports IMS emergency bearer services for UEs in limited service mode. If absent, IMS emergency call is not supported by the network in the cell for UEs in limited service mode.","paragraph_zero_based":11496},{"literal_text_all_w_t_and_m_t":"intraFreqReselectionRedCap","paragraph_zero_based":11497},{"literal_text_all_w_t_and_m_t":"Controls cell selection/reselection to intra-frequency cells for RedCap UEs when this cell is barred, or treated as barred by the RedCap UE, as specified in TS 38.304 [20]. If not present, a RedCap UE treats the cell as barred, i.e.,the UE considers that the cell does not support RedCap.","paragraph_zero_based":11498},{"literal_text_all_w_t_and_m_t":"q-QualMin","paragraph_zero_based":11499},{"literal_text_all_w_t_and_m_t":"Parameter \"Qqualmin\" in TS 38.304 [20], applicable for serving cell. If the field is absent, the UE applies the (default) value of negative infinity for Qqualmin.  ","paragraph_zero_based":11500},{"literal_text_all_w_t_and_m_t":"q-QualMinOffset","paragraph_zero_based":11501},{"literal_text_all_w_t_and_m_t":"Parameter \"Qqualminoffset\" in TS 38.304 [20]. Actual value Qqualminoffset = field value [dB]. If the field is absent, the UE applies the (default) value of 0 dB for Qqualminoffset. Affects the minimum required quality level in the cell.","paragraph_zero_based":11502},{"literal_text_all_w_t_and_m_t":"q-RxLevMin","paragraph_zero_based":11503},{"literal_text_all_w_t_and_m_t":"Parameter \"Qrxlevmin\" in TS 38.304 [20], applicable for serving cell.","paragraph_zero_based":11504},{"literal_text_all_w_t_and_m_t":"q-RxLevMinOffset","paragraph_zero_based":11505},{"literal_text_all_w_t_and_m_t":"Parameter \"Qrxlevminoffset\" in TS 38.304 [20]. Actual value Qrxlevminoffset = field value * 2 [dB]. If absent, the UE applies the (default) value of 0 dB for Qrxlevminoffset. Affects the minimum required Rx level in the cell.","paragraph_zero_based":11506},{"literal_text_all_w_t_and_m_t":"q-RxLevMinSUL","paragraph_zero_based":11507},{"literal_text_all_w_t_and_m_t":"Parameter \"Qrxlevmin\" in TS 38.304 [20], applicable for serving cell.","paragraph_zero_based":11508},{"literal_text_all_w_t_and_m_t":"sdt-RSRP-Threshold","paragraph_zero_based":11509},{"literal_text_all_w_t_and_m_t":"RSRP threshold used to determine whether SDT procedure can be initiated, as specified in TS 38.321 [3].","paragraph_zero_based":11510},{"literal_text_all_w_t_and_m_t":"sdt-DataVolumeThreshold","paragraph_zero_based":11511},{"literal_text_all_w_t_and_m_t":"Data volume threshold used to determine whether SDT can be initiated, as specified in TS 38.321 [3]. Value byte32 corresponds to 32 bytes, value byte100 corresponds to 100 bytes, and so on.","paragraph_zero_based":11512},{"literal_text_all_w_t_and_m_t":"sdt-LogicalChannelSR-DelayTimer","paragraph_zero_based":11513},{"literal_text_all_w_t_and_m_t":"The value of logicalChannelSR-DelayTimer applied during SDT for logical channels configured with SDT, as specified in TS 38.321 [3]. Value in number of subframes. Value sf20 corresponds to 20 subframes, sf40 corresponds to 40 subframes, and so on. If this field is not configured, then logicalChannelSR-DelayTimer is not applied for SDT logical channels.","paragraph_zero_based":11514},{"literal_text_all_w_t_and_m_t":"servingCellConfigCommon","paragraph_zero_based":11515},{"literal_text_all_w_t_and_m_t":"Configuration of the serving cell.","paragraph_zero_based":11516},{"literal_text_all_w_t_and_m_t":"t319a","paragraph_zero_based":11517},{"literal_text_all_w_t_and_m_t":"Initial value of the timer T319a used for detection of SDT failure. Value ms100 corresponds to 100 milliseconds, value ms200 corresponds to 200 milliseconds and so on.","paragraph_zero_based":11518},{"literal_text_all_w_t_and_m_t":"uac-AccessCategory1-SelectionAssistanceInfo","paragraph_zero_based":11519}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["70636717f8f8939ad7039f88a574b546e044b98f4c1ceb1b7f84528fef31a642","68db60e679c05ed9a21351ec00a7aa607270875c1778f960701e9ac3f5322e4e","4866e3507c6ce44ce27489e4d633f7a95e10cf50bb389ce0851f373659a434e9","867eefbe8bcf1c49dbd1f0e809bbfdeaf026a3dc91b32b5e91716b79d68c5d42","cf25c627a0588da90c7c29c50eae6e02ebabc472cf79303416fc5bfa2175126e","0d17bb67ed6a22cec301b1d5f0de7ec4402dcbde657a75ebeabb6cdce923655f","6033284d622ef8d16e657a8def20814b7ce78efe8e8791eae96d7f3f72e29c84","af3afba5704365e0eb61232f253f3c89e581b0fdf84cc94f4c69f558e90b1929","abeb98b17ff2b3542aeaf1626312a7060daa03e873786549ad51440ce2707cb1","f07a86dc0e1de2f4479512533df02765213de24a7ddb7e82b94f63bf2b008964","3e7a740421d7c4faddb6bebf3f2011c9a2f2e10159cea017c7d152817c6643d7","7dd9e352982a088323ba6a55e8550d2576ecd6ed57f7aaccb8a7395e880c9023","5d365e1510e8d8fe9f3faad741ffecff13ba2830947127dfc394b92f7ce4691a","587b0f58932de3e68828501eee06fc42709373fa9a507760337d089ee1665d33","1becaf138aa34e4bc68f4a41bdb3259d8747d591bd256aa43f82e177b6577ee3","26be1cd19337abc3cc70854c087c70c0a5081e1d4cfdd5e21a7bd833b03db6bc","187a13d778711d8752af47b1a1da123b72df68f81f6e579e558748d59728305a","a0ef0bc201b3d612940a7fdf6f507fac3bfcd2d8a60e94d23570ab23025b0a42","f0f6770927f6dd5c494e8200514049e74f85930e50b6cb26e97a0a3e805ac8f6","e87aebc27787a74d3b1203ecf8baed12712f51b75bacdb3308d3182de8c7078d","61cae66d5c8a3575e2182d701d00b81866839bf9e9ca50f3c427e72769f86a04","d365ec241abbdc080bc0c3b9f460f1c47c9caecb6f8e70c8de9e855aefc33b67","49bb385c8f4d9b464066d40e710fb0726428d262b411fde208717b967f7ce903","cae50b3921275cc4f9ecfef0ad17fb59d38cd8de8bd072a479e957c7b5aa940b"],"paragraph_range_zero_based":[11496,11519],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p11496"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Information used to determine whether Access Category 1 applies to the UE, as defined in TS 22.261 [25]. If plmnCommon is chosen, the UAC-AccessCategory1-SelectionAssistanceInfo is applicable to all the PLMNs and SNPNs in plmn-IdentityInfoList and npn-IdentityInfoList. If individualPLMNList is chosen, the 1st entry in the list corresponds to the first network within all of the PLMNs and SNPNs across the plmn-IdentityList and the npn-IdentityInfoList, the 2nd entry in the list corresponds to the second network within all of the PLMNs and SNPNs across the plmn-IdentityList and the npn-IdentityInfoList and so on. If uac-AC1-SelectAssistInfo-r16 is present, the UE shall ignore the uac-AccessCategory1-SelectionAssistanceInfo.","paragraph_zero_based":11520},{"literal_text_all_w_t_and_m_t":"uac-AC1-SelectAssistInfo","paragraph_zero_based":11521},{"literal_text_all_w_t_and_m_t":"Information used to determine whether Access Category 1 applies to the UE, as defined in TS 22.261 [25]. The 1st entry in the list corresponds to the first network within all of the PLMNs and SNPNs across the plmn-IdentityList and npn-IdentityInfoList, the 2nd entry in the list corresponds to the second network within all of the PLMNs and SNPNs across the plmn-IdentityList and the npn-IdentityInfoList and so on. Value notConfigured indicates that Access Category1 is not configured for the corresponding PLMN/SNPN.","paragraph_zero_based":11522},{"literal_text_all_w_t_and_m_t":"uac-BarringForCommon","paragraph_zero_based":11523},{"literal_text_all_w_t_and_m_t":"Common access control parameters for each access category. Common values are used for all PLMNs/SNPNs, unless overwritten by the PLMN/SNPN specific configuration provided in uac-BarringPerPLMN-List. The parameters are specified by providing an index to the set of configurations (uac-BarringInfoSetList). UE behaviour upon absence of this field is specified in clause 5.3.14.2.","paragraph_zero_based":11524},{"literal_text_all_w_t_and_m_t":"ue-TimersAndConstants","paragraph_zero_based":11525},{"literal_text_all_w_t_and_m_t":"Timer and constant values to be used by the UE. The cell operating as PCell always provides this field.","paragraph_zero_based":11526},{"literal_text_all_w_t_and_m_t":"useFullResumeID","paragraph_zero_based":11527},{"literal_text_all_w_t_and_m_t":"Indicates which resume identifier and Resume request message should be used. UE uses fullI-RNTI and RRCResumeRequest1 if the field is present, or shortI-RNTI and RRCResumeRequest if the field is absent.","paragraph_zero_based":11528},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11529},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":11530},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":11531},{"literal_text_all_w_t_and_m_t":"EDRX-RC","paragraph_zero_based":11532},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, in a cell that enables eDRX-AllowedIdle, otherwise it is absent.","paragraph_zero_based":11533},{"literal_text_all_w_t_and_m_t":"MINT","paragraph_zero_based":11534},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, in a cell that provides a configuration for disaster roaming, otherwise it is absent, Need R.","paragraph_zero_based":11535},{"literal_text_all_w_t_and_m_t":"Standalone","paragraph_zero_based":11536},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in a cell that supports standalone operation, otherwise it is absent.","paragraph_zero_based":11537},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11538},{"literal_text_all_w_t_and_m_t":"–SidelinkUEInformationNR","paragraph_zero_based":11539},{"literal_text_all_w_t_and_m_t":"The SidelinkUEinformationNR message is used for the indication of NR sidelink UE information to the network.","paragraph_zero_based":11540},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1","paragraph_zero_based":11541},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":11542},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":11543}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["9edf784de8c0cf405ba5ba61b9afe62fc04ce5e5debe2f85837f20a958fd8db7","baf91f004f61b3f41735b5df3e24779663e705b609da8296ebfc7c0f909dac42","ce0173566053e4c9eb38e08e664aafd000d759b0d832636d813f24aa3f4a9584","b10427c21d4bab30739bdfcc80a42bf43e234ad0096a5cf9c08c97a6db6abf21","df39c02cb421bedaeb01074f0affdb879320d38928a413289a34c07cbbc73fa6","4091c7a76e5d56974ad0e28b845438e4ca4abed2f8f5d7777100cea329a48a2d","b69544e716bdf47b05e92de473653db225e4bafa44ae0d789bb618e7efcea21e","dbd5fced3c7a00b7ceddeee423cad0e417a06ba03239033c755f00351d090273","0e3e4914927e88f59717079985fe16944ddee613cdaeec32dab54be5bd2999e7","0d516689b1a6c5c1b138fd16d1ced8ae060e567eca11f420cd59ba7d990e2370","2581887a56038ff2d792c355dca89716acb98e3c2a943e25d4092530f92a5270","f4688dcb925b7a941bfff5f292478a3e9653837ea4680409198f47fd40f1f167","dcfc6d65e83a5822cea24530604856b04924e0230bd8cf7f8ff362797980e9d9","2f0f06aa06ebe3e0103ccdb901aed1931bf214d42e4ea34730a78a63a3e3b155","db593d76ff45aeca99727d099e8f9edbbcc6ffb36215ae700ebfb1e1e7084200","10aae67ec8b9fa6866f9ab0986fbc623deb338c4aa59f21083b4f78434d388f2","6aad37bfbbc9157d964dfe89035b134fcb36ff598f5db88e776ea59c8af0efe0","d0e2586aef137ab88b1054368a1781736299fec0d3f651df5b07eedbaceed1ab","74583450b62189f431bf906cdc4e6592513511895d2163a545be1e60780805eb","0c41e31d25aae1fe6292e77b448489e4b38b09eabf5ff6cdaff0af819e