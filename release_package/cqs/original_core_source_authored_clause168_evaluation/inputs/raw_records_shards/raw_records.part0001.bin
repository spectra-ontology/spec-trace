{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ran-VisiblePeriodicity-r17           ENUMERATED {ms120, ms240, ms480, ms640, ms1024}                            OPTIONAL, -- Need S","paragraph_zero_based":36624},{"literal_text_all_w_t_and_m_t":"    numberOfBufferLevelEntries-r17       INTEGER (1..8)                                                             OPTIONAL, -- Need R","paragraph_zero_based":36625},{"literal_text_all_w_t_and_m_t":"    reportPlayoutDelayForMediaStartup-r17 BOOLEAN                                                                   OPTIONAL, -- Need M","paragraph_zero_based":36626},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":36627},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":36628},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36629},{"literal_text_all_w_t_and_m_t":"-- TAG-APPLAYERMEASCONFIG-STOP","paragraph_zero_based":36630},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36631},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36632},{"literal_text_all_w_t_and_m_t":"AppLayerMeasConfig field descriptions","paragraph_zero_based":36633},{"literal_text_all_w_t_and_m_t":"measConfigAppLayerContainer","paragraph_zero_based":36634},{"literal_text_all_w_t_and_m_t":"The field contains configuration of application layer measurements, see Annex L (normative) in TS 26.247 [68], clause 16.5 in TS 26.114 [69] and TS 26.118 [70].","paragraph_zero_based":36635},{"literal_text_all_w_t_and_m_t":"pauseReporting","paragraph_zero_based":36636},{"literal_text_all_w_t_and_m_t":"The field indicates whether the transmission of measReportAppLayerContainer is paused or not. Value true indicates the transmission of measReportAppLayerContainer is paused; value false indicates the transmission of measReportAppLayerContainer is not paused.","paragraph_zero_based":36637},{"literal_text_all_w_t_and_m_t":"ran-VisibleParameters","paragraph_zero_based":36638},{"literal_text_all_w_t_and_m_t":"The field indicates whether RAN visible application layer measurements shall be reported or not.","paragraph_zero_based":36639},{"literal_text_all_w_t_and_m_t":"rrc-SegAllowed","paragraph_zero_based":36640},{"literal_text_all_w_t_and_m_t":"This field indicates that RRC segmentation of MeasurementReportAppLayer is enabled. It may be present only if the UE supports RRC segmentation of the MeasurementReportAppLayer message in UL.","paragraph_zero_based":36641},{"literal_text_all_w_t_and_m_t":"serviceType","paragraph_zero_based":36642},{"literal_text_all_w_t_and_m_t":"Indicates the type of application layer measurement. Value streaming indicates Quality of Experience Measurement Collection for streaming services (see TS 26.247 [68]), value mtsi indicates Quality of Experience Measurement Collection for MTSI (see TS 26.114 [69]) and value vr indicates Quality of Experience Measurement Collection for VR service (see TS 26.118 [70]). The network always configures serviceType when application layer measurements are initially configured and at fullConfig.","paragraph_zero_based":36643},{"literal_text_all_w_t_and_m_t":"transmissionOfSessionStartStop","paragraph_zero_based":36644},{"literal_text_all_w_t_and_m_t":"Value true indicates that the UE shall transmit indications when the measurement session in the application layer starts and stops. Value false indicates that the UE shall not transmit any session status indications. The UE transmits a session start indication upon configuration of this field set to value true if a session already has started in the application layer.","paragraph_zero_based":36645},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36646},{"literal_text_all_w_t_and_m_t":"RAN-VisibleParameters field descriptions","paragraph_zero_based":36647}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["4f144cc5f4b9d972d47e429403f39c19936dd27b453d4e018a7c517d1a92400b","a47d375a0ced97cb2287a58ee1a762ceb21d1b484e2e2f5df8a0b723b0ed80f5","fc9c894683b7a4b880f6b7088a602e064fd15146fd247db886500a0be8358670","573233c26750923c18c41015dd100f2aeb1ad031f234ba327e5642bdddb88daa","a0dcb0c09a06871aa28348ba53d975784727caeecbaa1efde0b9b7aff6e1907c","a8ad597aa114d0bcc9fbe039b14e49a7dab5b2c64cb89bb8e567e35e1cbd61eb","c1b1977e85e2b3309d58715d196329c26ca3e5adbc0ab20906fdc73f935e5b5b","781ccaeab8d88a5d9244ac05b4369040e000c5c2f89c83801325a802003ac4e0","2497878bad056ae19da39329ae9ee0dc21ae8f3d7d1b7f79b1f8781b16552a5f","3f32544b58d7d790b8ac3cf6be6cd3a83c91f9add07fc56ca36e0ce72cb66097","94b9c8d44a1075f7bb4b3dee10d77b9026d6e9b405d9872997f3cf8e6c4688de","c56c9f1dcb5563d16a1519cf230a791ac48fa39fdfa5f44bfe30627ffacf68b4","2ebf0f6c3b381ad474fe2a38716e629dc6c9057f2fcdbd28c40d3be98a25265b","0d8b713ad6bb21cbd2069fbc62a9ad68b545e1ebe1cbf75481c124ea5f8f9e6c","adef18fa60122f024396d43c9bd0fef5c64d8cdc6d2c45833ee27e794e7388b7","b324689cd9ed347d0f0ef5702b871e6666ecd599492f733a9a378889f192e36b","56af8cdcf6fb1fb5992207a40ae88446cb017b48a49b293d1b3ff082a5e17a96","1c28c8c79c2f4f2fc52614a5059baec3953f60ca8a025b452fb5360559f9ed55","ed0b0ffcfa7f241e69436268838390a04c37d368fb00cc77aeae84acec094ea9","acb40f5f04a595a55e75a1bf530074575d8fc85a86b4f8d44517d2112ce92604","e6c61ae43108873c1c3e850c3bf424502c5bbb7a1a431ea6ea534e50b8a162cc","606d650805e975b047462fee5c8fb210cec9997e3b6c20dd132a65391a12e9b5","cd01f320a29d62a1cb262efbc6882314a76ef55006580e81b006df167220ce69","ad076d2bc49c2ec308808dac1c977088cc81644de49210a6fa30694a9322ddff"],"paragraph_range_zero_based":[36624,36647],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p36624"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"numberOfBufferLevelEntries","paragraph_zero_based":36648},{"literal_text_all_w_t_and_m_t":"The field contains the maximum number of buffer level entries that can be reported for RAN visible application layer measurements. This field is also used by application layer to calculate the interval of RAN visible buffer level measurement, which is equal to the periodicity of RAN visible application layer measurements reporting divided by numberOfBufferLevelEntries.","paragraph_zero_based":36649},{"literal_text_all_w_t_and_m_t":"ran-VisiblePeriodicity","paragraph_zero_based":36650},{"literal_text_all_w_t_and_m_t":"The field indicates the periodicity of RAN visible application layer measurements reporting. Value ms120 indicates 120 ms, value ms240 indicates 240 ms and so on. If this field is absent, the periodicity of RAN visible application layer measurements reporting is the same as the reporting periodicity indicated in measConfigAppLayerContainer.","paragraph_zero_based":36651},{"literal_text_all_w_t_and_m_t":"reportPlayoutDelayForMediaStartup","paragraph_zero_based":36652},{"literal_text_all_w_t_and_m_t":"The field indicates whether the UE shall report Playout Delay for Media Startup for RAN visible application layer measurements.","paragraph_zero_based":36653},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36654},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36655},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":36656},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":36657},{"literal_text_all_w_t_and_m_t":"ServiceType","paragraph_zero_based":36658},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need M, when serviceType is set to streaming or vr. Otherwise, it is absent.","paragraph_zero_based":36659},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36660},{"literal_text_all_w_t_and_m_t":"–AreaConfiguration","paragraph_zero_based":36661},{"literal_text_all_w_t_and_m_t":"The AreaConfiguration indicates area for which UE is requested to perform measurement logging. If not configured, measurement logging is not restricted to specific cells or tracking areas but applies as long as the RPLMN is contained in plmn-IdentityList stored in VarLogMeasReport.","paragraph_zero_based":36662},{"literal_text_all_w_t_and_m_t":"AreaConfiguration information element","paragraph_zero_based":36663},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36664},{"literal_text_all_w_t_and_m_t":"-- TAG-AREACONFIGURATION-START","paragraph_zero_based":36665},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36666},{"literal_text_all_w_t_and_m_t":"AreaConfiguration-r16 ::=        SEQUENCE {","paragraph_zero_based":36667},{"literal_text_all_w_t_and_m_t":"    areaConfig-r16                   AreaConfig-r16,","paragraph_zero_based":36668},{"literal_text_all_w_t_and_m_t":"    interFreqTargetList-r16          SEQUENCE(SIZE (1..maxFreq)) OF InterFreqTargetInfo-r16              OPTIONAL  -- Need R","paragraph_zero_based":36669},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":36670},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["fe300fd4d64d2372d43b368294487efb88fdbb71080bf3433283c17e626a1147","2028b5165748bf5ee0b1116e24b459dba53a9ca7909bdd07b7c9ecfcec98b84a","1c39bf89720fe00508880caccb828f90d77cb1dd829ce55564aa5eba49022470","5b46c87e8699a9a2d550c6ee209c3375e4578693034f5fdae7ac