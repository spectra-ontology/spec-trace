n first (n1) and second (n2) dimension and codebook subset restriction (see TS 38.214 [19] clause 5.2.2.2.3).","paragraph_zero_based":15954},{"literal_text_all_w_t_and_m_t":"Number of bits for codebook subset restriction is CEIL(log2(nchoosek(O1*O2,4)))+8*n1*n2 where nchoosek(a,b) = a!/(b!(a-b)!).","paragraph_zero_based":15955},{"literal_text_all_w_t_and_m_t":"n1-n2","paragraph_zero_based":15956},{"literal_text_all_w_t_and_m_t":"Number of antenna ports in first (n1) and second (n2) dimension and codebook subset restriction (see TS 38.214 [19] clause 5.2.2.2.1).","paragraph_zero_based":15957},{"literal_text_all_w_t_and_m_t":"ng-n1-n2","paragraph_zero_based":15958},{"literal_text_all_w_t_and_m_t":"Codebook subset restriction for Type I Multi-panel codebook (see TS 38.214 [19], clause 5.2.2.2.2).","paragraph_zero_based":15959}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["94afd8231af792f3cdf4bdb18a47af5aac9e8db7944a72c40cc1e73c1aa11a8c","369a981612944cb36010cd7cfeab10d55fbda2df72b2dfcf5d6f6c8de70d1989","c8077f3b3d6ab877a142db586c75d9d9a169cb88432598492b27cbc769ab7c34","e0037a97430252ea6fe682b7835ba80d90157b3aefc939a4f45d257fcd2613ad","47c7f03ed03d9cd5859e6aaf3ab6e8157f6b190191b58803af31a2ad0d0db589","f6c6233931696fb3e6d4b8b60cd3ae411e316421f9592b2d89d9f086727aaea3","a986ceef6dd6ce6b5c205473f468a6b2faee1a20083ea4692915cae4b65d9b18","f9f3f3939381840d34bebe456cfbec894709f3a0a38918887e82fa4c60a263de","eac4b909d06a33d9f984ea6d5b0e22d8777c2051d8275ce97fe4ec2586f24c77","957e1c580c882712f9072b8b8e1018f5b1630eb1b20ff47f391628742a3f4756","0e518fae4c45c709d366cac83562964315154b545b6fa099201af67f52cf366f","3e69620304dd38cb207c665b834166f23b78f1b6582a4d64571a4de8dbaa58a5","c161cc