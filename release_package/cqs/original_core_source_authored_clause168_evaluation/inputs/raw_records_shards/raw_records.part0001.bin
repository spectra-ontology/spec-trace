{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"dataCodingScheme","paragraph_zero_based":13776},{"literal_text_all_w_t_and_m_t":"Identifies the alphabet/coding and the language applied variations of an ETWS notification.","paragraph_zero_based":13777},{"literal_text_all_w_t_and_m_t":"messageIdentifier","paragraph_zero_based":13778},{"literal_text_all_w_t_and_m_t":"Identifies the source and type of ETWS notification.","paragraph_zero_based":13779},{"literal_text_all_w_t_and_m_t":"serialNumber","paragraph_zero_based":13780},{"literal_text_all_w_t_and_m_t":"Identifies variations of an ETWS notification.","paragraph_zero_based":13781},{"literal_text_all_w_t_and_m_t":"warningMessageSegment","paragraph_zero_based":13782},{"literal_text_all_w_t_and_m_t":"Carries a segment of the Warning Message Contents IE.","paragraph_zero_based":13783},{"literal_text_all_w_t_and_m_t":"warningMessageSegmentNumber","paragraph_zero_based":13784},{"literal_text_all_w_t_and_m_t":"Segment number of the ETWS warning message segment contained in the SIB. A segment number of zero corresponds to the first segment, A segment number of one corresponds to the second segment, and so on.","paragraph_zero_based":13785},{"literal_text_all_w_t_and_m_t":"warningMessageSegmentType","paragraph_zero_based":13786},{"literal_text_all_w_t_and_m_t":"Indicates whether the included ETWS warning message segment is the last segment or not.","paragraph_zero_based":13787},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13788},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":13789},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":13790},{"literal_text_all_w_t_and_m_t":"Segment1","paragraph_zero_based":13791},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in the first segment of SIB7, otherwise it is absent.","paragraph_zero_based":13792},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13793},{"literal_text_all_w_t_and_m_t":"–SIB8","paragraph_zero_based":13794},{"literal_text_all_w_t_and_m_t":"SIB8 contains a CMAS notification.","paragraph_zero_based":13795},{"literal_text_all_w_t_and_m_t":"SIB8 information element","paragraph_zero_based":13796},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":13797},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB8-START","paragraph_zero_based":13798},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13799}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["f278eaa33362b024e0a138b3fc78bd1c72065d411c1e2060c8c2b1ddcc268bfb","306503528f619ae64c517af548dcdb6b005cdb6d3a89919f3fa8b0881e439c01","c8f060deb1f29412fa9451f3ac400f23ae1f600adc161b0a25fbf86ba8c54eb9","add587e64ecf5d76ce23cae97a12a1348cccf24b2b3919a7ec5e0740dc893edc","2918b8d16d89346792d281a241b695eaa60aad1b9e5b1c99c33265d1ce2b474e","2dcc3e4166cf13b83d4052e88f6004ef57ecb560b1d0bd49e32e8f4367084a11","340d25177101fb70ff95b210818e28c5ccc285c0246e346b5c2a8be65b0a4333","e7c1a7f40dcaaf63fad7fbb6c5f6fb56ba60bf20b4c669e11276dbe89d974cc6","20d8135a07779577a7f8f82a85680530b4e76ad1ed0f04c69b606ec2a6dc8b20","13b924668cc49c56cedd3d4858bd53359b34d29a24419defd9dadd5fc68840e1","6b32430841bc378b64af2c259a8e99a330a7d6f72a0185451a511ff1e2fdca56","a01579ee23466e163208dfd2a2a08251ce02fdea698a71ecc759c24c2d19a9b0","c78064036bb14e46ddc2497fa95df4eef8ec3f9b51ca51c249a8757acf1a9785","b24d9cae4d36bec6b974cd589755b9a5bf17fe51054c741f3a99f6939c48e192","f8135fd4d65c6b7759731d68bb2a551a637858a6a186a81722466c0de230846b","8488593eff1df9ffe34cc4550cb5df664de92a17e49d9e68d1d49ac1d