{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":16728},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":16729},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16730},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-FREQUENCYOCCUPATION-STOP","paragraph_zero_based":16731},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":16732},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16733},{"literal_text_all_w_t_and_m_t":"CSI-FrequencyOccupation field descriptions","paragraph_zero_based":16734},{"literal_text_all_w_t_and_m_t":"nrofRBs","paragraph_zero_based":16735},{"literal_text_all_w_t_and_m_t":"Number of PRBs across which this CSI resource spans. Only multiples of 4 are allowed. The smallest configurable number is the minimum of 24 and the width of the associated BWP. If the configured value is larger than the width of the corresponding BWP, the UE shall assume that the actual CSI-RS bandwidth is equal to the width of the BWP.","paragraph_zero_based":16736},{"literal_text_all_w_t_and_m_t":"startingRB","paragraph_zero_based":16737},{"literal_text_all_w_t_and_m_t":"PRB where this CSI resource starts in relation to common resource block #0 (CRB#0) on the common resource block grid. Only multiples of 4 are allowed (0, 4, ...)","paragraph_zero_based":16738},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16739},{"literal_text_all_w_t_and_m_t":"–CSI-IM-Resource","paragraph_zero_based":16740},{"literal_text_all_w_t_and_m_t":"The IE CSI-IM-Resource is used to configure one CSI Interference Management (IM) resource.","paragraph_zero_based":16741},{"literal_text_all_w_t_and_m_t":"CSI-IM-Resource information element","paragraph_zero_based":16742},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":16743},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-IM-RESOURCE-START","paragraph_zero_based":16744},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16745},{"literal_text_all_w_t_and_m_t":"CSI-IM-Resource ::=                 SEQUENCE {","paragraph_zero_based":16746},{"literal_text_all_w_t_and_m_t":"    csi-IM-ResourceId                   CSI-IM-ResourceId,","paragraph_zero_based":16747},{"literal_text_all_w_t_and_m_t":"    csi-IM-ResourceElementPattern           CHOICE {","paragraph_zero_based":16748},{"literal_text_all_w_t_and_m_t":"        pattern0                                SEQUENCE {","paragraph_zero_based":16749},{"literal_text_all_w_t_and_m_t":"            subcarrierLocation-p0                   ENUMERATED { s0, s2, s4, s6, s8, s10 },","paragraph_zero_based":16750},{"literal_text_all_w_t_and_m_t":"            symbolLocation-p0                       INTEGER (0..12)","paragraph_zero_based":16751}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["6f77d1e271305b58cc1d9daf5a7b3d0e966c5882c419eb2bf2ba14f59b79abe6","18398c64a08bd79be6f8837574fdec3e0703f7deb6b30a34545fb20d6a61dd81","c99ef095df31993312119b0e9102d3557670978c5ee3745b91467719b345d91a","4ff9d6b9158ab4ee4fca893bfa1b6da255b26c355f0b53a847df15118e230adf","7e113d611e7a45ddbcc0dfad454cda2c26554d9e432d094df01e1e9d0154c5be","adccb3e49b1e1d435de164409278d27cb32daa89c6335c25805e2f6ae3f84df8","5cd66e2f7c6194998a3402521f60e28acebfa6bb7093dec37b87fc28a345910a","123bfef7df68b5894ec75763dc0ef81a8389d535380c78ca38a5fb77be3f22c1","a97403da4b80c5391d61036062fbdf0566ccc75a19606dedd8d3ea26c76efad1","eabbea6d017e07c1890de90d5709acfc6bd7fe8d5f809ae7a8c26ac91ff57e4e","33da2713044903e8c9cce57afdd13084fec4046020e12238b1ad6356e837b10c","4c1fe9038abac