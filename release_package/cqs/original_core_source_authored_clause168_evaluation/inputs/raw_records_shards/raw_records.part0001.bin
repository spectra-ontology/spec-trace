{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37416},{"literal_text_all_w_t_and_m_t":"–SL-ConfiguredGrantConfig","paragraph_zero_based":37417},{"literal_text_all_w_t_and_m_t":"The IE SL-ConfiguredGrantConfig specifies the configured grant configuration information for NR sidelink communication.","paragraph_zero_based":37418},{"literal_text_all_w_t_and_m_t":"SL-ConfiguredGrantConfig information element","paragraph_zero_based":37419},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":37420},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-CONFIGUREDGRANTCONFIG-START","paragraph_zero_based":37421},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37422},{"literal_text_all_w_t_and_m_t":"SL-ConfiguredGrantConfig-r16 ::=           SEQUENCE {","paragraph_zero_based":37423},{"literal_text_all_w_t_and_m_t":"    sl-ConfigIndexCG-r16                       SL-ConfigIndexCG-r16,","paragraph_zero_based":37424},{"literal_text_all_w_t_and_m_t":"    sl-PeriodCG-r16                            SL-PeriodCG-r16                                                       OPTIONAL, -- Need M","paragraph_zero_based":37425},{"literal_text_all_w_t_and_m_t":"    sl-NrOfHARQ-Processes-r16                  INTEGER (1..16)                                                       OPTIONAL, -- Need M","paragraph_zero_based":37426},{"literal_text_all_w_t_and_m_t":"    sl-HARQ-ProcID-offset-r16                  INTEGER (0..15)                                                       OPTIONAL, -- Need M","paragraph_zero_based":37427},{"literal_text_all_w_t_and_m_t":"    sl-CG-MaxTransNumList-r16                  SL-CG-MaxTransNumList-r16                                             OPTIONAL, -- Need M","paragraph_zero_based":37428},{"literal_text_all_w_t_and_m_t":"    rrc-ConfiguredSidelinkGrant-r16            SEQUENCE {","paragraph_zero_based":37429},{"literal_text_all_w_t_and_m_t":"        sl-TimeResourceCG-Type1-r16                INTEGER (0..496)                                                  OPTIONAL, -- Need M","paragraph_zero_based":37430},{"literal_text_all_w_t_and_m_t":"        sl-StartSubchannelCG-Type1-r16             INTEGER (0..26)                                                   OPTIONAL, -- Need M","paragraph_zero_based":37431},{"literal_text_all_w_t_and_m_t":"        sl-FreqResourceCG-Type1-r16                INTEGER (0..6929)                                                 OPTIONAL, -- Need M","paragraph_zero_based":37432},{"literal_text_all_w_t_and_m_t":"        sl-TimeOffsetCG-Type1-r16                  INTEGER (0..7999)                                                 OPTIONAL, -- Need R","paragraph_zero_based":37433},{"literal_text_all_w_t_and_m_t":"        sl-N1PUCCH-AN-r16                          PUCCH-ResourceId                                                  OPTIONAL, -- Need M","paragraph_zero_based":37434},{"literal_text_all_w_t_and_m_t":"        sl-PSFCH-ToPUCCH-CG-Type1-r16              INTEGER (0..15)                                                   OPTIONAL, -- Need M","paragraph_zero_based":37435},{"literal_text_all_w_t_and_m_t":"        sl-ResourcePoolID-r16                      SL-ResourcePoolID-r16                                             OPTIONAL, -- Need M","paragraph_zero_based":37436},{"literal_text_all_w_t_and_m_t":"        sl-TimeReferenceSFN-Type1-r16              ENUMERATED {sfn512}                                               OPTIONAL  -- Need S","paragraph_zero_based":37437},{"literal_text_all_w_t_and_m_t":"    }                                                                                                                OPTIONAL, -- Need M","paragraph_zero_based":37438},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":37439}],"source":"Whole authentic original CR source member; all unfiltered body and 