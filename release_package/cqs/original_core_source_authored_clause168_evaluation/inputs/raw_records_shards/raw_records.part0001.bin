{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"subbandAmplitude","paragraph_zero_based":16272},{"literal_text_all_w_t_and_m_t":"If subband amplitude reporting is activated (true).","paragraph_zero_based":16273},{"literal_text_all_w_t_and_m_t":"twoTX-CodebookSubsetRestriction","paragraph_zero_based":16274},{"literal_text_all_w_t_and_m_t":"Codebook subset restriction for 2TX codebook (see TS 38.214 [19] clause 5.2.2.2.1).","paragraph_zero_based":16275},{"literal_text_all_w_t_and_m_t":"typeI-SinglePanel-codebookSubsetRestriction-i2","paragraph_zero_based":16276},{"literal_text_all_w_t_and_m_t":"i2 codebook subset restriction for Type I Single-panel codebook used when reportQuantity is CRI/Ri/i1/CQI (see TS 38.214 [19] clause 5.2.2.2.1).","paragraph_zero_based":16277},{"literal_text_all_w_t_and_m_t":"typeI-SinglePanel-ri-Restriction","paragraph_zero_based":16278},{"literal_text_all_w_t_and_m_t":"Restriction for RI for TypeI-SinglePanel-RI-Restriction (see TS 38.214 [19], clause 5.2.2.2.1).","paragraph_zero_based":16279},{"literal_text_all_w_t_and_m_t":"typeI-SinglePanel-Group1, typeI-SinglePanel-Group2","paragraph_zero_based":16280},{"literal_text_all_w_t_and_m_t":"Configures codebooks for CSI calculation when UE is configured with two CMR Groups with CMRGroupingAndPairing in the NZP-CSI-RS-ResourceSet associated with the CSI-ReportConfig. Network configures the same number of ports for both codebooks.","paragraph_zero_based":16281},{"literal_text_all_w_t_and_m_t":"typeI-SinglePanel-ri-RestrictionSDM, typeI-SinglePanel-ri-RestrictionSTRP","paragraph_zero_based":16282},{"literal_text_all_w_t_and_m_t":"Restriction for RI for N Resource Pairs when two CMR Groups are configured with CMRGroupingAndPairing in the NZP-CSI-RS-ResourceSet associated with the CSI-ReportConfig (see TS 38.214 [19], clause 5.2.1.4.2).","paragraph_zero_based":16283},{"literal_text_all_w_t_and_m_t":"typeII-PortSelectionRI-Restriction","paragraph_zero_based":16284},{"literal_text_all_w_t_and_m_t":"Restriction for RI for TypeII-PortSelection-RI-Restriction (see TS 38.214 [19], clauses 5.2.2.2.4 and 5.2.2.2.6).","paragraph_zero_based":16285},{"literal_text_all_w_t_and_m_t":"typeII-RI-Restriction","paragraph_zero_based":16286},{"literal_text_all_w_t_and_m_t":"Restriction for RI for TypeII-RI-Restriction (see TS 38.214 [19], clauses 5.2.2.2.3 and 5.2.2.2.5).","paragraph_zero_based":16287},{"literal_text_all_w_t_and_m_t":"valueOfN","paragraph_zero_based":16288},{"literal_text_all_w_t_and_m_t":"Field provides the value of parameter N as specified in TS 38.214 [19], clause 5.2.2.2.7. The field is present only when M=2 set by paramCombination, see TS 38.214 [19].","paragraph_zero_based":16289},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16290},{"literal_text_all_w_t_and_m_t":"–CommonLocationInfo","paragraph_zero_based":16291},{"literal_text_all_w_t_and_m_t":"The IE CommonLocationInfo is used to transfer detailed location information available at the UE to correlate measurements and UE position information.","paragraph_zero_based":16292},{"literal_text_all_w_t_and_m_t":"CommonLocationInfo information element","paragraph_zero_based":16293},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":16294},{"literal_text_all_w_t_and_m_t":"-- TAG-COMMONLOCATIONINFO-START","paragraph_zero_based":16295}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["61578411d772bbdd2222261fc683beb001d456fda140d1916ef62b6ce6c0f4a7","7c6928ab85c2071959edf27da0f4866771873a9b99008edf8423a80226e73225","017aa97cac97f5574368321f2c6