{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"PCI-List information element","paragraph_zero_based":21720},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21721},{"literal_text_all_w_t_and_m_t":"-- TAG-PCI-LIST-START","paragraph_zero_based":21722},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21723},{"literal_text_all_w_t_and_m_t":"PCI-List ::=                        SEQUENCE (SIZE (1..maxNrofCellMeas)) OF PhysCellId","paragraph_zero_based":21724},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21725},{"literal_text_all_w_t_and_m_t":"-- TAG-PCI-LIST-STOP","paragraph_zero_based":21726},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21727},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21728},{"literal_text_all_w_t_and_m_t":"–PCI-Range","paragraph_zero_based":21729},{"literal_text_all_w_t_and_m_t":"The IE PCI-Range is used to encode either a single or a range of physical cell identities. The range is encoded by using a start value and by indicating the number of consecutive physical cell identities (including start) in the range. For fields comprising multiple occurrences of PCI-Range, the Network may configure overlapping ranges of physical cell identities.","paragraph_zero_based":21730},{"literal_text_all_w_t_and_m_t":"PCI-Range information element","paragraph_zero_based":21731},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21732},{"literal_text_all_w_t_and_m_t":"-- TAG-PCI-RANGE-START","paragraph_zero_based":21733},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21734},{"literal_text_all_w_t_and_m_t":"PCI-Range ::=                       SEQUENCE {","paragraph_zero_based":21735},{"literal_text_all_w_t_and_m_t":"    start                               PhysCellId,","paragraph_zero_based":21736},{"literal_text_all_w_t_and_m_t":"    range                               ENUMERATED {n4, n8, n12, n16, n24, n32, n48, n64, n84,","paragraph_zero_based":21737},{"literal_text_all_w_t_and_m_t":"                                                    n96, n128, n168, n252, n504, n1008,spare1}                  OPTIONAL    -- Need S","paragraph_zero_based":21738},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21739},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21740},{"literal_text_all_w_t_and_m_t":"-- TAG-PCI-RANGE-STOP","paragraph_zero_based":21741},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21742},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21743}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["5140571f381b5771d81ba65616b13153ce2c2355954e12b980d66ea4f4cfd534","a50a02433c7da3218529197025b3830d38d0f8565f527e0f85714c44425d824a","f4189c8637167ac61a08a2dc5176c8d0e2aa0ed4c69e5f4578a98b7f10505fb6","4864a955f35ed4e9cb70bfd0af68502654d5073c86ef3bcb0dfa90cded4b773c","9e3c0af4cad8232b151f9b1b8615239b8a99555ef2778bd84bb5acf22ca40752","8e583b99fde76d503bc0f6f523c8315d73a24eaacd7aa4aa60581050d2e3162f","c19a28156c0b32a4383975e8aa339a4f6a4b0a52876d34043854f70b30951007","3260d6aa0baf9a3d7f016e93d914fab5e09efa4b33024611877724c06da326fd","fbf52cb90636a94164e7c358efd866cba9235c89b1459a0877a762586518085e","04e81f67c18d35800b330341e8c885d067244d359ebb5121ba9718d26f89a874","20ac13a4cb8182d62afccd625d45bb7e2fd35ac3f36c9a1f3e7873a95f9eb692","628697ea4a188f5a6d22b5e6411ced3605164706d0500523a66fe09648c7b11e","7a302f1986341f6b4239c68dca711f139eff40449b8de80999a243a0f70c0ba2","b6f9176e245bfc433f5f0558ea23de55326d65b152a0befc739eea3ce94c5d1a","1fd