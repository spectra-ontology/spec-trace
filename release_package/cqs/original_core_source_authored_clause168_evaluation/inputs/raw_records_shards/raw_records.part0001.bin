{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"phy-PriorityIndex","paragraph_zero_based":26712},{"literal_text_all_w_t_and_m_t":"Indicates whether this scheduling request resource is high or low priority in PHY prioritization/multiplexing handling (see TS 38.213 [13], clause 9.2.4). Value p0 indicates low priority and value p1 indicates high priority.","paragraph_zero_based":26713},{"literal_text_all_w_t_and_m_t":"resource","paragraph_zero_based":26714},{"literal_text_all_w_t_and_m_t":"ID of the PUCCH resource in which the UE shall send the scheduling request. The actual PUCCH-Resource is configured in PUCCH-Config of the same UL BWP and serving cell as this SchedulingRequestResourceConfig. The network configures a PUCCH-Resource of PUCCH-format0 or PUCCH-format1 (other formats not supported) (see TS 38.213 [13], clause 9.2.4)","paragraph_zero_based":26715},{"literal_text_all_w_t_and_m_t":"schedulingRequestID","paragraph_zero_based":26716},{"literal_text_all_w_t_and_m_t":"The ID of the SchedulingRequestConfig that uses this scheduling request resource.","paragraph_zero_based":26717},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26718},{"literal_text_all_w_t_and_m_t":"–SchedulingRequestResourceId","paragraph_zero_based":26719},{"literal_text_all_w_t_and_m_t":"The IE SchedulingRequestResourceId is used to identify scheduling request resources on PUCCH.","paragraph_zero_based":26720},{"literal_text_all_w_t_and_m_t":"SchedulingRequestResourceId information element","paragraph_zero_based":26721},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26722},{"literal_text_all_w_t_and_m_t":"-- TAG-SCHEDULINGREQUESTRESOURCEID-START","paragraph_zero_based":26723},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26724},{"literal_text_all_w_t_and_m_t":"SchedulingRequestResourceId ::=     INTEGER (1..maxNrofSR-Resources)","paragraph_zero_based":26725},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26726},{"literal_text_all_w_t_and_m_t":"-- TAG-SCHEDULINGREQUESTRESOURCEID-STOP","paragraph_zero_based":26727},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26728},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26729},{"literal_text_all_w_t_and_m_t":"–ScramblingId","paragraph_zero_based":26730},{"literal_text_all_w_t_and_m_t":"The IE ScramblingID is used for scrambling channels and reference signals.","paragraph_zero_based":26731},{"literal_text_all_w_t_and_m_t":"ScramblingId information element","paragraph_zero_based":26732},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26733},{"literal_text_all_w_t_and_m_t":"-- TAG-SCRAMBLINGID-START","paragraph_zero_based":26734},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26735}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["b1ce0a251a97a8b4343dc0649eacaa659d027f4f90cc16f7663c132b45bb6bbc","97104edabb7b16c9b25be836131dd0a9ab78dacaec5a954e1f332f16d2c865d1","41e852bd46cbaae5f708fad088cdceeb77f0df580b8087c9b630a49620381e4c","237cdf98282b62fc1168822e8ac6cb640b73714a04bc3b25dd369e1c68253f51","d6c97f3c4a60dccc5dd605c0467fb67e5ebccae810664a047eb65a8f6103de59","06929345ed6ee29f89d1d422cf759a26518e94848fda52dfa784b77ea7d1e23e","882eceafbb4f1f7e866c7c87dec727cb1197b8390d6debebffd1945eb1a38a0f","1ef5e7517917e41450bbab32d5c48a630a84be9432101d1eac6830c3500a13df","b3270f36ce407b94bf92a89ef66f3a738c389d712927701f4a7f537121c9dcdb","3f7d70220941e049c383636792440b7ed5aeafaae681e530e17ef693ef230ee3","3b0984213ef9a85c2cb68f144004b9ca7ad8eb7cf129115f4428efc