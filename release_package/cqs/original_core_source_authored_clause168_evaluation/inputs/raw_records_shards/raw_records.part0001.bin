{"fields":{"filename":"R2-2401569.zip::R2-2401569 RRC corrections for XR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>forward the received warning message, messageIdentifier, serialNumber and dataCodingScheme to upper layers;","paragraph_zero_based":1104},{"literal_text_all_w_t_and_m_t":"3>stop reception of SIB7;","paragraph_zero_based":1105},{"literal_text_all_w_t_and_m_t":"3>discard the current values of messageIdentifier and serialNumber for SIB7;","paragraph_zero_based":1106},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":1107},{"literal_text_all_w_t_and_m_t":"3>store the received warningMessageSegment;","paragraph_zero_based":1108},{"literal_text_all_w_t_and_m_t":"3>continue reception of SIB7;","paragraph_zero_based":1109},{"literal_text_all_w_t_and_m_t":"1>else if all segments of a warning message have been received:","paragraph_zero_based":1110},{"literal_text_all_w_t_and_m_t":"2>assemble the warning message from the received warningMessageSegment(s);","paragraph_zero_based":1111},{"literal_text_all_w_t_and_m_t":"2>forward the received complete warning message, messageIdentifier, serialNumber and dataCodingScheme to upper layers;","paragraph_zero_based":1112},{"literal_text_all_w_t_and_m_t":"2>stop reception of SIB7;","paragraph_zero_based":1113},{"literal_text_all_w_t_and_m_t":"2>discard the current values of messageIdentifier and serialNumber for SIB7;","paragraph_zero_based":1114},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":1115},{"literal_text_all_w_t_and_m_t":"2>store the received warningMessageSegment;","paragraph_zero_based":1116},{"literal_text_all_w_t_and_m_t":"2>continue reception of SIB7;","paragraph_zero_based":1117},{"literal_text_all_w_t_and_m_t":"The UE should discard any stored warningMessageSegment and the current value of messageIdentifier and serialNumber for SIB7 if the complete warning message has not been assembled within a period of 3 hours.","paragraph_zero_based":1118},{"literal_text_all_w_t_and_m_t":"5.2.2.4.9Actions upon reception of SIB8","paragraph_zero_based":1119},{"literal_text_all_w_t_and_m_t":"Upon receiving the SIB8 the UE shall:","paragraph_zero_based":1120},{"literal_text_all_w_t_and_m_t":"1>if the SIB8 contains a complete warning message and the complete geographical area coordinates (if any):","paragraph_zero_based":1121},{"literal_text_all_w_t_and_m_t":"2>forward the received warning message, messageIdentifier, serialNumber, dataCodingScheme and the geographical area coordinates (if any) to upper layers;","paragraph_zero_based":1122},{"literal_text_all_w_t_and_m_t":"2>continue reception of SIB8;","paragraph_zero_based":1123},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":1124},{"literal_text_all_w_t_and_m_t":"2>if the received values of messageIdentifier and serialNumber are the same (each value is the same) as a pair for which a warning message and the geographical area coordinates (if any) are currently being assembled:","paragraph_zero_based":1125},{"literal_text_all_w_t_and_m_t":"3>store the received warningMessageSegment;","paragraph_zero_based":1126},{"literal_text_all_w_t_and_m_t":"3>store the received warningAreaCoordinatesSegment (if any);","paragraph_zero_based":1127}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"b3775a5d14ac021fc4f5f3e8002b92527fa1c052d9b7c535f196b5410b17f720","original_member_sha256":"0b2b1acef7c2981dcae001f9ad768411cade15b8ef16fbb988748fdb44fd8de1","paragraph_ElementTree_utf8_XML_sha256":["0791a3239d705550e42afce2005f4cfbcd99b14dc3798dc6be835f1fc49a4e09","06ee80a097de54e6f0a30a5e4ade8021ceb049c159b22cb32d70673a5f458f68","cfd45c5d6915e7b6b08d9a5c5f8e01c33c8464d89f5842a720cef82281a2100a","72363cdbdd3e7ff0af331b848618e2da8de39c8b2612da5372d547591de2dbca","65ea586bd570b1813a1082aad6ab7d32e70df884972ac75647f16c3f921828dd","e9b57935fdda8c9482adbc3a0bebe334461329cdd284b3332be5cbb6e43449f8","93ef0bbc491933f2648157c7ddb8510970ad7e4aebfb73f3155596060dacace0","ecac77f6b81df8142dffe962be11846fe66a8a57fd8fe571ba56c0e6dff4e94d","d12a92163ab152b894a99b0f85efe5d5b18f06e85f3b9aa9f0f0bf65176a9af6","d14987e8aad7b874bdc647c0517a3e00fa3c6320d8db9baa379b9e068867bde0","6f94ea62df1e02e7fbfbc4bd12be0f989e1a2bb9eb475068635b1712e546621e","dc2207e2fd6f419e34f966da4f2fad1ba2c856322d32b02ffb171194e7e75731","2800b4bb63c0a80fb2fad74663bb6a0bbc2ba04457bf3dd7adc97f158b2e4c0a","ac48b7f659a5ee67806f1dad5fe620c65921083e38386d0729cb23469c33a2d9","af9206aab22d9825f674a58178b5a375e2a8acbef885a1b98c7edffd2a6e811f","4d95912ac299fe52157ebe870af988cb34468e776ad319eb8255ef4ea8e1d33a","197674a59f51f0a49fe4c2f3dc80a8bcff4b5e3baa0898fc5a47f5bb2362c9d7","2bbdac5156b34f83dc02e0ef93ef2eb38a27cc80cc1e8433aa04a74f755b6064","834503f6fe1e51f34db1481b79a2cef695b565eb3133564ddd27e46dd7cd5c59","0b2b0e0425fb7d0f8c10e555ff7bacac9b68997a95f1b26e10ac8881900da7eb","c0fcfd4c7448a96877d3ea64ef47af454614eb14340a7e4961ae582983698c67","6d9d2d14c2311e9e052e6cf14982f019ad04bda66c65db7b419a05b52ccf103e","6ac13d80beaf19bcc4557a73c45896f2c8e484fb62f7d687d60562220ed739ed","83a22385ada31a4e477bb091408c98f8c55d7037d23d17f70e6970ae1f008468"],"paragraph_range_zero_based":[1104,1127],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2401569.zip::R2-2401569 RRC corrections for XR.docx:p1104"}
{"fields":{"filename":"R2-2401569.zip::R2-2401569 RRC corrections for XR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>if all segments of a warning message and geographical area coordinates (if any) have been received:","paragraph_zero_based":1128},{"literal_text_all_w_t_and_m_t":"4>assemble the warning message from the received warningMessageSegment;","paragraph_zero_based":1129},{"literal_text_all_w_t_and_m_t":"4>assemble the geographical area coordinates from the received warningAreaCoordinatesSegment (if any);","paragraph_zero_based":1130},{"literal_text_all_w_t_and_m_t":"4>forward the received warning message, messageIdentifier, serialNumber, dataCodingScheme and geographical area coordinates (if any) to upper layers;","paragraph_zero_based":1131},{"literal_text_all_w_t_and_m_t":"4>stop assembling a warning message and geographical area coordinates (if any) for this messageIdentifier and serialNumber and delete all stored information held for it;","paragraph_zero_based":1132},{"literal_text_all_w_t_and_m_t":"3>continue reception of SIB8;","paragraph_zero_based":1133},{"literal_text_all_w_t_and_m_t":"2>else if the received values of messageIdentifier and/or serialNumber are not the same as any of the pairs for which a warning message is currently being assembled:","paragraph_zero_based":1134},{"literal_text_all_w_t_and_m_t":"3>start assembling a warning message for this messageIdentifier and serialNumber pair;","paragraph_zero_based":1135},{"literal_text_all_w_t_and_m_t":"3>start assembling the geographical area coordinates (if any) for this messageIdentifier and serialNumber pair;","paragraph_zero_based":1136},{"literal_text_all_w_t_and_m_t":"3>store the received warningMessageSegment;","paragraph_zero_based":1137},{"literal_text_all_w_t_and_m_t":"3>store the received warningAreaCoordinatesSegment (if any);","paragraph_zero_based":1138},{"literal_text_all_w_t_and_m_t":"3>continue reception of SIB8;","paragraph_zero_based":1139},{"literal_text_all_w_t_and_m_t":"The UE should discard warningMessageSegment and warningAreaCoordinatesSegment (if any) and the associated values of messageIdentifier and serialNumber for SIB8 if the complete warning message and the geographical area coordinates (if any) have not been assembled within a period of 3 hours.","paragraph_zero_based":1140},{"literal_text_all_w_t_and_m_t":"NOTE:The number of warning messages that a UE can re-assemble simultaneously is a function of UE implementation.","paragraph_zero_based":1141},{"literal_text_all_w_t_and_m_t":"5.2.2.4.10Actions upon reception of SIB9","paragraph_zero_based":1142},{"literal_text_all_w_t_and_m_t":"Upon receiving SIB9 with referenceTimeInfo, the UE may perform the related actions except for the action of ignoring all further referenceTimeInfo received in SIB9 as specified in clause 5.7.1.3.","paragraph_zero_based":1143},{"literal_text_all_w_t_and_m_t":"Upon receiving SIB9 with eventID-TSS, the UE shall perform the related actions if requested by upper layers:","paragraph_zero_based":1144},{"literal_text_all_w_t_and_m_t":"1>if VarEventID has an entry with a storedEventID value:","paragraph_zero_based":1145},{"literal_text_all_w_t_and_m_t":"2>if the storedEventID value within VarEventID is different from the eventID-TSS value received within SIB9:","paragraph_zero_based":1146},{"literal_text_all_w_t_and_m_t":"3>consider that the content of clockQualityDetailsLevel may have changed;","paragraph_zero_based":1147},{"literal_text_all_w_t_and_m_t":"3>notify upper layers that clockQualityDetailsLevel may have changed;","paragraph_zero_based":1148},{"literal_text_all_w_t_and_m_t":"3>replace the storedEventID value within VarEventID with the eventID-TSS value received within SIB9;","paragraph_zero_based":1149},{"literal_text_all_w_t_and_m_t":"3> replace the storedGnbID value within VarGnbID with the gNB identity value received within SIB1;","paragraph_zero_based":1150},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":1151}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"b3775a5d14ac021fc4f5f3e8002b92527fa1c052d9b7c535f196b5410b17f720","original_member_sha256":"0b2b1acef7c2981dcae001f9ad768411cade15b8ef16fbb988748fdb44fd8de1","paragraph_ElementTree_utf8_XML_sha256":["606e2b1a251d243c910186de2df7fdb780165abce9d9ae3f08e8c5308fd59002","1ef8f1fd4d91b915548a867e711a4ae6f333ee18449bc0be583e1a6d296f6193","49d2de94ecfb3c91d57a42f61e3ba862c3bba72215c336508538d6df0fd20f9c","6451d42a9aa69592cc2baf50e3dd28c484fbcb5337d61bdfa4771e253fc1e77a","ecf05d31ff02c20eb2e6757b18e2ab3c5396460b04fee3d41b5b0a3b53cff34c","1482e65cdcd6dd9cc18f3135a4e5b867878010079937b6602e70e6356a38d94e","611e4f63862a0bc119c5e228036d4a3eebdfbb2ff8d3652256fa5cf61fa3edc4","4efbc55816329368898983a4ab940825da641d4027d41b386b9761dc15dec2cf","acdc80f54acefce96816dab32f50cd0c66ec03b9a58fe9b9ccbffad3004acfd2","0a3e94fa4c5cbb5ae44dedb0764d591bd52004e47de95995959ae4d1b1535503","1273a186c10b2e5359c723a3575fbb9c208fd4e18b5eaa693015d808c55ac8d6","358bcf65d9db23499727e97f7f50064d602858c14493f743f2c691b470aa3120","2201dfe8d64d14daeaa77b1d6df8706beeecb78b5eefa07fcacacaec816470c9","32862f135b41672dd86abc651bd11b3096e5b52abe6b4c7e5ef829f92b772e17","36038f34898ffcfcf5ebb6afefee48480e811551a348459a076fdad74422dc91","27d34a991ed513f532efc2b7aecabd76b7941aa2c3f758ace7a32b788bf5bde6","8b7c5d261e83e3f259f59fe6a153f529adde0f3221566ac5acd98872b94aa9ed","e23e33c431512f07c43c4b989f580f6c5a8d043211cc824fe588586f0835f864","083d98f334644c6ac7f4ee86cb65f103898c3cb81273e21969431c635340c0e0","bf5f14b2140d18e65b5c8516251742e4ff59efc397fc1a9c250c5dcb80bd11c9","21d015fb54ea56d68ac4138cffcfea15bbbc886d30c99749549930c58436fa87","43dc4f49242c7952c3cabe364eb7cb6d82aff5205b8d155230f823803374f3bf","38a6c93f0c0f5079ea90684c742b592ec981fffd97ad906df39adcda18770e59","2ed7a0d87659c7394529095feabc930ad2bb49968305e4c51cf597c5747d4cd6"],"paragraph_range_zero_based":[1128,1151],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2401569.zip::R2-2401569 RRC corrections for XR.docx:p1128"}
{"fields":{"filename":"R2-2401569.zip::R2-2401569 RRC corrections for XR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>if the VarGnbID has an entry with a storedGnbID value:","paragraph_zero_based":1152},{"literal_text_all_w_t_and_m_t":"4>if the storedGnbID value within VarGnbID is different from the gNB identity value received within SIB1:","paragraph_zero_based":1153},{"literal_text_all_w_t_and_m_t":"5>consider that the content of clockQualityDetailsLevel may have changed;","paragraph_zero_based":1154},{"literal_text_all_w_t_and_m_t":"5>notify upper layers that clockQualityDetailsLevel may have changed;","paragraph_zero_based":1155},{"literal_text_all_w_t_and_m_t":"5>replace the storedGnbID value within VarGnbID with the gNB identity value received within SIB1;","paragraph_zero_based":1156},{"literal_text_all_w_t_and_m_t":"NOTE:The UE should calculate the value of the gNB identity as the value of gNB-ID-Length leftmost bits of the 36-bit long cellIdentity in the first PLMN-IdentityInfo IE of PLMN-IdentityInfoList in SIB1.","paragraph_zero_based":1157},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":1158},{"literal_text_all_w_t_and_m_t":"2>add a new entry of storedEventID within the VarEventID with the eventID-TSS value received within SIB9;","paragraph_zero_based":1159},{"literal_text_all_w_t_and_m_t":"2>add a new entry of storedGnbID within the VarGnbID with the gNB identity value received within SIB1;","paragraph_zero_based":1160},{"literal_text_all_w_t_and_m_t":"2>notify upper layers that clockQualityDetailsLevel may have changed;","paragraph_zero_based":1161},{"literal_text_all_w_t_and_m_t":"5.2.2.4.11Actions upon reception of SIB10","paragraph_zero_based":1162},{"literal_text_all_w_t_and_m_t":"Upon receiving SIB10, the UE shall:","paragraph_zero_based":1163},{"literal_text_all_w_t_and_m_t":"1>Forward the HRNN-list entries with the corresponding PNI-NPN and SNPN identities to upper layers;","paragraph_zero_based":1164},{"literal_text_all_w_t_and_m_t":"5.2.2.4.12Actions upon reception of SIB11","paragraph_zero_based":1165},{"literal_text_all_w_t_and_m_t":"Upon receiving SIB11, the UE shall:","paragraph_zero_based":1166},{"literal_text_all_w_t_and_m_t":"1>if in RRC_IDLE or RRC_INACTIVE, and T331 is running:","paragraph_zero_based":1167},{"literal_text_all_w_t_and_m_t":"2>perform the actions as specified in 5.7.8.1a;","paragraph_zero_based":1168},{"literal_text_all_w_t_and_m_t":"5.2.2.4.13Actions upon reception of SIB12","paragraph_zero_based":1169},{"literal_text_all_w_t_and_m_t":"Upon receiving SIB12, the UE shall:","paragraph_zero_based":1170},{"literal_text_all_w_t_and_m_t":"1>if the UE has stored at least one segment of SIB12 and the value tag of SIB12 has changed since a previous segment was stored:","paragraph_zero_based":1171},{"literal_text_all_w_t_and_m_t":"2>discard all stored segments;","paragraph_zero_based":1172},{"literal_text_all_w_t_and_m_t":"1>store the segment;","paragraph_zero_based":1173},{"literal_text_all_w_t_and_m_t":"1>if all segments have been received:","paragraph_zero_based":1174},{"literal_text_all_w_t_and_m_t":"2>assemble SIB12-IEs from the received segments;","paragraph_zero_based":1175}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"b3775a5d14ac021fc4f5f3e8002b92527fa1c052d9b7c535f196b5410b17f720","original_member_sha256":"0b2b1acef7c2981dcae001f9ad768411cade15b8ef16fbb988748fdb44fd8de1","paragraph_ElementTree_utf8_XML_sha256":["2345725d848736f315af15fdb5fa36a9d782569ff0d2fc7958d4634875a8ca92","fea5d1b22eb75ab0b8e22168ac75cdcd716f6eacc1c16e38f9eecd460234adee","8d50ddf76013f151df6d234d1b84c3e73c5df3f57472bdb934e2ce6a11923e2d","964a0da94d29260f2600309b2140039c89f2fb2d366863ca77d4db1f1d98d89b","a6bd092291d30c650606b911124fabaf92e3952a6c0e8193d5f6aa9d7ffa4d54","d7af753cfb1c72ad1486e902d79d0