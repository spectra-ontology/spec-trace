{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        sl-PollByte-r16                                  PollByte,","paragraph_zero_based":39432},{"literal_text_all_w_t_and_m_t":"        sl-MaxRetxThreshold-r16                          ENUMERATED { t1, t2, t3, t4, t6, t8, t16, t32 },","paragraph_zero_based":39433},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":39434},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":39435},{"literal_text_all_w_t_and_m_t":"    sl-UM-RLC-r16                                SEQUENCE {","paragraph_zero_based":39436},{"literal_text_all_w_t_and_m_t":"        sl-SN-FieldLengthUM-r16                      SN-FieldLengthUM                               OPTIONAL,    -- Cond SLRBSetup","paragraph_zero_based":39437},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":39438},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":39439},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":39440},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39441},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39442},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RLC-CONFIG-STOP","paragraph_zero_based":39443},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39444},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39445},{"literal_text_all_w_t_and_m_t":"SL-RLC-Config field descriptions","paragraph_zero_based":39446},{"literal_text_all_w_t_and_m_t":"sl-MaxRetxThreshold","paragraph_zero_based":39447},{"literal_text_all_w_t_and_m_t":"Parameter value of maxRetxThreshold for RLC AM for NR sidelink communications, see TS 38.322 [4]. Value t1 corresponds to 1 retransmission, value t2 corresponds to 2 retransmissions and so on.","paragraph_zero_based":39448},{"literal_text_all_w_t_and_m_t":"sl-PollByte","paragraph_zero_based":39449},{"literal_text_all_w_t_and_m_t":"Parameter value of pollByte for RLC AM for NR sidelink communications, see TS 38.322 [4]. Value kB25 corresponds to 25 kBytes, value kB50 corresponds to 50 kBytes and so on. infinity corresponds to an infinite amount of kBytes.","paragraph_zero_based":39450},{"literal_text_all_w_t_and_m_t":"sl-PollPDU","paragraph_zero_based":39451},{"literal_text_all_w_t_and_m_t":"Parameter value of pollPDU for RLC AM for NR sidelink communications, seeTS 38.322 [4]. Value p4 corresponds to 4 PDUs, value p8 corresponds to 8 PDUs and so on. infinity corresponds to an infinite number of PDUs.","paragraph_zero_based":39452},{"literal_text_all_w_t_and_m_t":"sl-SN-FieldLength","paragraph_zero_based":39453},{"literal_text_all_w_t_and_m_t":"This field indicates the RLC SN field size for NR sidelink communication, see TS 38.322 [4]. For groupcast and broadcast, only value size6 (6 bits) is configured for the field sl-SN-FieldLengthUM.","paragraph_zero_based":39454},{"literal_text_all_w_t_and_m_t":"sl-T-PollRetransmit","paragraph_zero_based":39455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["bf5ff4bc6b14ced94361409edf518d1354f986a2c8d4ae78b8ad62430a2a5ff9","c39df04d4d5541a3a1930eaedd9f3e3283d639b2c4f3b4efb8dc984a4b30faba","8c6c9ae5782d50c7d4111fc0be67851f5e67811823ae38ddfd5aa5039e965ce1","f5ea141edfeded07cd4dfbc32f42d4d0b5d144fd9410bc2a1bd0c29658b3ace5","5b5035bcec6445c812f63df3f8cba99694b5a519685ca68dec09e58778c9a656","0575df386c1b5a829ec3f1113c01f1ea84da9db2396693cbd3ea65be96037078","26b336c29927dfc7b0503bc23a330621a9e24c805ca973690c69aed89c97f962","21a8e26c7b15e26dceb1ada91318b37082283445732a887de965151fb4edb718","f634f08ac111e9ef75131b9