{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"RF-ParametersMRDC field descriptions","paragraph_zero_based":35568},{"literal_text_all_w_t_and_m_t":"appliedFreqBandListFilter","paragraph_zero_based":35569},{"literal_text_all_w_t_and_m_t":"In this field the UE mirrors the FreqBandList that the NW provided in the capability enquiry, if any. The UE filtered the band combinations in the supportedBandCombinationList in accordance with this appliedFreqBandListFilter.","paragraph_zero_based":35570},{"literal_text_all_w_t_and_m_t":"supportedBandCombinationList","paragraph_zero_based":35571},{"literal_text_all_w_t_and_m_t":"A list of band combinations that the UE supports for (NG)EN-DC, or both (NG)EN-DC and NE-DC. The FeatureSetCombinationId:s in this list refer to the FeatureSetCombination entries in the featureSetCombinations list in the UE-MRDC-Capability IE.","paragraph_zero_based":35572},{"literal_text_all_w_t_and_m_t":"supportedBandCombinationListNEDC-Only, supportedBandCombinationListNEDC-Only-v1610","paragraph_zero_based":35573},{"literal_text_all_w_t_and_m_t":"A list of band combinations that the UE supports only for NE-DC. The FeatureSetCombinationId:s in this list refer to the FeatureSetCombination entries in the featureSetCombinations list in the UE-MRDC-Capability IE.","paragraph_zero_based":35574},{"literal_text_all_w_t_and_m_t":"supportedBandCombinationList-UplinkTxSwitch","paragraph_zero_based":35575},{"literal_text_all_w_t_and_m_t":"A list of band combinations that the UE supports dynamic UL Tx switching for (NG)EN-DC. The FeatureSetCombinationId:s in this list refer to the FeatureSetCombination entries in the featureSetCombinations list in the UE-MRDC-Capability IE.","paragraph_zero_based":35576},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35577},{"literal_text_all_w_t_and_m_t":"–RLC-Parameters","paragraph_zero_based":35578},{"literal_text_all_w_t_and_m_t":"The IE RLC-Parameters is used to convey capabilities related to RLC.","paragraph_zero_based":35579},{"literal_text_all_w_t_and_m_t":"RLC-Parameters information element","paragraph_zero_based":35580},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":35581},{"literal_text_all_w_t_and_m_t":"-- TAG-RLC-PARAMETERS-START","paragraph_zero_based":35582},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35583},{"literal_text_all_w_t_and_m_t":"RLC-Parameters ::= SEQUENCE {","paragraph_zero_based":35584},{"literal_text_all_w_t_and_m_t":"    am-WithShortSN                  ENUMERATED {supported}  OPTIONAL,","paragraph_zero_based":35585},{"literal_text_all_w_t_and_m_t":"    um-WithShortSN                  ENUMERATED {supported}  OPTIONAL,","paragraph_zero_based":35586},{"literal_text_all_w_t_and_m_t":"    um-WithLongSN                   ENUMERATED {supported}  OPTIONAL,","paragraph_zero_based":35587},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":35588},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":35589},{"literal_text_all_w_t_and_m_t":"    extendedT-PollRetransmit-r16    ENUMERATED {supported}  OPTIONAL,","paragraph_zero_based":35590},{"literal_text_all_w_t_and_m_t":"    extendedT-StatusProhibit-r16    ENUMERATED {supported}  OPTIONAL","paragraph_zero_based":35591}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["f06d9f31408e990c4f4248a2f69a4f23996deed2b423b9a43cc52147f793fffa","abc9870e56237ccb0813d48104210c87023f403fc0cc88cff9525d7192a1e792","2beff61bfd748c8908581fe357f97571d375440de3d87561de2a16ba6542839c","06ebd5ad542051a5a3d9cdba9342fcb9aad68e3d02c65