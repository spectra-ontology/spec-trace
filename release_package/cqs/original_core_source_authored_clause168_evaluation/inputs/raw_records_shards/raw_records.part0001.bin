{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"inclination","paragraph_zero_based":18456},{"literal_text_all_w_t_and_m_t":"Satellite orbital parameter: inclination i, see NIMA TR 8350.2 [71]. Unit is radian.","paragraph_zero_based":18457},{"literal_text_all_w_t_and_m_t":"Step of 2.341* 10-8 rad. Actual value = field value * (2.341* 10-8).","paragraph_zero_based":18458},{"literal_text_all_w_t_and_m_t":"longitude","paragraph_zero_based":18459},{"literal_text_all_w_t_and_m_t":"Satellite orbital parameter: longitude of ascending node , see NIMA TR 8350.2 [71]. Unit is radian.","paragraph_zero_based":18460},{"literal_text_all_w_t_and_m_t":"Step of 2.341* 10-8 rad. Actual value = field value * (2.341* 10-8).","paragraph_zero_based":18461},{"literal_text_all_w_t_and_m_t":"meanAnomaly","paragraph_zero_based":18462},{"literal_text_all_w_t_and_m_t":"Satellite orbital parameter: Mean anomaly M at epoch time, see NIMA TR 8350.2 [71]. Unit is radian.","paragraph_zero_based":18463},{"literal_text_all_w_t_and_m_t":"Step of 2.341* 10-8 rad. Actual value = field value * (2.341* 10-8).","paragraph_zero_based":18464},{"literal_text_all_w_t_and_m_t":"periapsis","paragraph_zero_based":18465},{"literal_text_all_w_t_and_m_t":"Satellite orbital parameter: argument of periapsis , see NIMA TR 8350.2 [71]. Unit is radian.","paragraph_zero_based":18466},{"literal_text_all_w_t_and_m_t":"Step of 2.341* 10-8 rad. Actual value = field value * (2.341* 10-8).","paragraph_zero_based":18467},{"literal_text_all_w_t_and_m_t":"positionX, positionY, positionZ","paragraph_zero_based":18468},{"literal_text_all_w_t_and_m_t":"X, Y, Z coordinate of satellite position state vector in ECEF. Unit is meter.","paragraph_zero_based":18469},{"literal_text_all_w_t_and_m_t":"Step of 1.3 m. Actual value = field value * 1.3.","paragraph_zero_based":18470},{"literal_text_all_w_t_and_m_t":"semiMajorAxis","paragraph_zero_based":18471},{"literal_text_all_w_t_and_m_t":"Satellite orbital parameter: semi major axis , see NIMA TR 8350.2 [71]. Unit is meter.","paragraph_zero_based":18472},{"literal_text_all_w_t_and_m_t":"Step of 4.249 * 10-3 m. Actual value = 6500000 + field value * (4.249 * 10-3).","paragraph_zero_based":18473},{"literal_text_all_w_t_and_m_t":"velocityVX, velocityVY, velocityVZ","paragraph_zero_based":18474},{"literal_text_all_w_t_and_m_t":"X, Y, Z coordinate of satellite velocity state vector in ECEF. Unit is meter/second.","paragraph_zero_based":18475},{"literal_text_all_w_t_and_m_t":"Step of 0.06 m/s. Actual value = field value * 0.06.","paragraph_zero_based":18476},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18477},{"literal_text_all_w_t_and_m_t":"–FeatureCombination","paragraph_zero_based":18478},{"literal_text_all_w_t_and_m_t":"The IE FeatureCombination indicates a feature or a combination of features to be associated with a set of Random Access resources (i.e. an instance of FeatureCombinationPreambles).","paragraph_zero_based":18479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["fa506791f25515385f41f0709d706ea544765c2392a0f4b078ee99ab32f6069f","082c905bec3f303a3a307f0d8640b1289d532aa1b7da33fad2a4dc79480ada53","381cdc2dafc3ffd4b79201e1d44dc217edd73e533292b633f82a65c6b2969a58","4871ab57a4c17c7820b77b563a1afcdf04819078fb1fd449957c688fc32119c4","d52d245d43627f44fb86bad8b48433707aafeb3618ca2208e35f29a83f962fb9","9033924d2acfe3d3711faa81e7cc77ae195ae8b1e972e84406d5bcc42206966f","7f38a238abd897fe3722544009df18f22b633088f06c93d3b29f59e377cdccf5","09f399dd0d5a07e12bd9dddd39ed68e38d905e3da1a239a6ccc1c700ce7aad06","