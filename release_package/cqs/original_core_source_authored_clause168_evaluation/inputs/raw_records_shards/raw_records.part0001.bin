nd_m_t":"","paragraph_zero_based":39378},{"literal_text_all_w_t_and_m_t":"CFR-ConfigMCCH-MTCH-r17 ::= SEQUENCE {","paragraph_zero_based":39379},{"literal_text_all_w_t_and_m_t":"    locationAndBandwidthBroadcast-r17          LocationAndBandwidthBroadcast-r17  OPTIONAL,  -- Need S","paragraph_zero_based":39380},{"literal_text_all_w_t_and_m_t":"    pdsch-ConfigMCCH-r17                       PDSCH-ConfigBroadcast-r17          OPTIONAL,  -- Need S","paragraph_zero_based":39381},{"literal_text_all_w_t_and_m_t":"    commonControlResourceSetExt-r17            ControlResourceSet                 OPTIONAL   -- Cond NotSIB1CommonControlResource","paragraph_zero_based":39382},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39383}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["4f0963ce76fe66f7337bfb6079d8edb37a31b40c390f23e737ea9c41d45907da","2a79cebfaeb0066950be8990c48eba349d6911564272a6d2274ba1eeb0e78421","3144c62a5b5ad6e5e9eedcbefa3de51233d6ca828c046b2f329d64e2844ee455","d4b63e15e9e12a07dcd4bf5522d8aeb59001ea329f14b64895b5930ac2f97f04","8c44a961446f2c34e239ad09f86518565a2c6c3ed4a3be4d86015149bfb49d1e","dc6034b904e85974e140aa14eede87de2c21c14b9888c81b3de65c4b382995c5","ccb03e79209673258e84715f29636a0065ee2e76e1e35f8fe15146340bde8d55","ef40c87a45bd6f49d90fff98125c6b9598dd01b6368855dc7cedf27134b89312","a9d97ed6d873b7d141c1e590e4a96bdc5f2b90a63a98aaf80d22ecf73d7eb661","090b81b2f6b9c2d4e1f9ad2e0823e98900ae469b31601396abe2e2ddb928ff02","31a6a5adfd831aec8a68cdfb1dd43bc450b475b934dff9369f3c5dcffe885ca6","3d96239086be97c81e9119ab826b3a880b5eaa597b7cdd4ea3d47c5fef42930e","74dc4087eb9cd991893d53c3064facca4456dbb1a6cfba2a223bff8c93606d4f","63de4e0165e9e958256711a7ee3b021d15e56