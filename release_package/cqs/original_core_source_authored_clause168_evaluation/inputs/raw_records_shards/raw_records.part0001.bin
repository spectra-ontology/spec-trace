{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-RNTI-VALUE-STOP","paragraph_zero_based":26496},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26497},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26498},{"literal_text_all_w_t_and_m_t":"–RSRP-Range","paragraph_zero_based":26499},{"literal_text_all_w_t_and_m_t":"The IE RSRP-Range specifies the value range used in RSRP measurements and thresholds. For measurements, integer value for RSRP measurements is according to Table 10.1.6.1-1 in TS 38.133 [14]. For thresholds, the actual value is (IE value – 156) dBm, except for the IE value 127, in which case the actual value is infinity.","paragraph_zero_based":26500},{"literal_text_all_w_t_and_m_t":"RSRP-Range information element","paragraph_zero_based":26501},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26502},{"literal_text_all_w_t_and_m_t":"-- TAG-RSRP-RANGE-START","paragraph_zero_based":26503},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26504},{"literal_text_all_w_t_and_m_t":"RSRP-Range ::=                      INTEGER(0..127)","paragraph_zero_based":26505},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26506},{"literal_text_all_w_t_and_m_t":"-- TAG-RSRP-RANGE-STOP","paragraph_zero_based":26507},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26508},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26509},{"literal_text_all_w_t_and_m_t":"–RSRQ-Range","paragraph_zero_based":26510},{"literal_text_all_w_t_and_m_t":"The IE RSRQ-Range specifies the value range used in RSRQ measurements and thresholds. For measurements, integer value for RSRQ measurements is according to Table 10.1.11.1-1 in TS 38.133 [14]. For thresholds, the actual value is (IE value – 87) / 2 dB.","paragraph_zero_based":26511},{"literal_text_all_w_t_and_m_t":"RSRQ-Range information element","paragraph_zero_based":26512},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26513},{"literal_text_all_w_t_and_m_t":"-- TAG-RSRQ-RANGE-START","paragraph_zero_based":26514},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26515},{"literal_text_all_w_t_and_m_t":"RSRQ-Range ::=                      INTEGER(0..127)","paragraph_zero_based":26516},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26517},{"literal_text_all_w_t_and_m_t":"-- TAG-RSRQ-RANGE-STOP","paragraph_zero_based":26518},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26519}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["faebde622181d1cc59f420baae3374e288d5414dc5137895e669a47e75e92903","04788781537c4b8f0b560e0186ca0e456f5ba9a3a510938c462a76e2436d8690","e571f2a598bbb902c720c86256d4244bc6336a6ef6b8d4631b3444f990acd5e4","cb62ae7b39c016357b4d13fcc6ca078fdbae6f94d67440a7832ed31534037bc5","ddbd30d7e806f067eb82844c80acd108452058da6c4e827542edd69336325863","e62bebe7e78588f29c7ae37d167685a572016b379ee4c0c7b6d0897c5fa013cb","78da7b98ec5dc440bcdcd1a109cfc31015d9d0822d648fc35fc2f82a9340f978","4cf12f495d5d665d322e2961af58a8190285feb320e6136993b2fa19a82b4505","d039f13cd126d0c98cb82dc58654846ca4fd2e7bc99ef3f3668982f2dd0d37e2","69a8dfeb3c0f873e858b0b45f28c341fb5dfc8ba8d76cc14af621b27d4afa52d","25b5f58b4244f7e715789513308afe8553f2f8b0347aaca0650431cdfbe4aeba","7abd5c7df00130cf0e785068f81384e725836b4b32fa60c4873db273daa7965d","f1303484762d10593c6f82c08db69a7341ab9dd4b52d79af8b8cdf743fb919bc","242722ce7338d6ea3d3019b47ef4cd4d1b40ae6be63da84e813a4f1dab283552","07f7447e3cfa05247141ea5472cd683da18d9c53e429dc1ebf