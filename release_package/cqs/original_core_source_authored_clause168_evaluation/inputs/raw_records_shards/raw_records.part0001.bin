56b4bb7f3d37ca6e4e051c2a73fd87","daa56f7835d6a45bdce4c6780c8e11455664ad3132bd9f74c39328d5e79e1971","29a77fdee79a1d7df35bd9744983571a68b71c340ce1df2c0fcbe42a0aa6562e","1a9203a761a82ad5c13f1ad8aaaffdf3c0a75e64d495ea7f87cd7f641229b2e9","0ff6b95638dcc59c72f11aced3041f83bbc5093610db9c39d643b3e1de91e18d","bfdced089146a5f3638a8dd989e9e8a79582323f669b83d6dc646af76d3a5de7","6527fa87c9e7ca19335545ac29e08e8dce5290428ae9ad933b2a21f0ee5136ea","f31585f92e80b54b1b3ac7eec53dacef281975c06b5ee7325d7885d62140630d","6294e8deefa6b2c18d74218de345010495f05396bcc6b7ca384d0a39057c4eb5","441590e2bcfd36ee305598b599b6e3b9f252e67af5e88671731a4a2999dc1fac"],"paragraph_range_zero_based":[16320,16343],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p16320"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    condExecutionCond-r16            SEQUENCE (SIZE (1..2)) OF MeasId                      OPTIONAL,    -- Need M","paragraph_zero_based":16344},{"literal_text_all_w_t_and_m_t":"    condRRCReconfig-r16              OCTET STRING (CONTAINING RRCReconfiguration)          OPTIONAL,    -- Cond condReconfigAdd","paragraph_zero_based":16345},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":16346},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":16347},{"literal_text_all_w_t_and_m_t":"    condExecutionCondSCG-r17         OCTET STRING (CONTAINING CondReconfigExecCondSCG-r17) OPTIONAL     -- Need M","paragraph_zero_based":16348},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":16349},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":16350},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16351},{"literal_text_all_w_t_and_m_t":"CondReconfigExecCondSCG-r17 ::=  SEQUENCE (SIZE (1..2)) OF MeasId","paragraph_zero_based":16352},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16353},{"literal_text_all_w_t_and_m_t":"-- TAG-CONDRECONFIGTOADDMODLIST-STOP","paragraph_zero_based":16354},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":16355},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16356},{"literal_text_all_w_t_and_m_t":"CondReconfigToAddMod field descriptions","paragraph_zero_based":16357},{"literal_text_all_w_t_and_m_t":"condExecutionCond","paragraph_zero_based":16358},{"literal_text_all_w_t_and_m_t":"The execution condition that needs to be fulfilled in order to trigger the execution of a conditional reconfiguration for CHO, CPA, intra-SN CPC without MN involvement or MN initiated inter-SN CPC. When configuring 2 triggering events (Meas Ids) for a candidate cell, the network ensures that both refer to the same measObject. For CHO, if the network configures condEventD1 or condEventT1 for a candidate cell, the network configures a second triggering event condEventA3, condEventA4 or condEventA5 for the same candidate cell. The network does not configure both condEventD1 and condEventT1 for the same candidate cell. For CHO in terrestrial networks, the network does not indicate a MeasId associated with condEventA4. For CPA and for MN-initiated inter-SN CPC, the network only indicates MeasId(s) associated with condEventA4. For intra-SN CPC, the network only indicates MeasId(s) associated with condEventA3 or condEventA5.","paragraph_zero_based":16359},{"literal_text_all_w_t_and_m_t":"condExecutionCondSCG","paragraph_zero_based":16360},{"literal_text_all_w_t_and_m_t":"Contains execution condition that needs to be fulfilled in order to trigger the execution of a conditional reconfiguration for SN initiated inter-SN CPC. The Meas Ids refer to the measConfig associated with the SCG. When configuring 2 triggering events (Meas Ids) for a candidate cell, network ensures that both refer to the same measObject. For each condReconfigId, the network always configures either condExecutionCond or condExecutionCondSCG (not both). The network only indicates MeasId(s) associated with condEventA3 or condEventA5.","paragraph_zero_based":16361},{"literal_text_all_w_t_and_m_t":"condRRCReconfig","paragraph_zero_based":16362},{"literal_text_all_w_t_and_m_t":"The RRCReconfiguration message to be applied when the condition(s) are fulfilled. The RRCReconfiguration message contained in condRRCReconfig cannot contain the field conditionalReconfiguration or the field daps-Config.","paragraph_zero_based":16363},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16364},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":16365},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":16366},{"literal_text_all_w_t_and_m_t":"condReconfigAdd","paragraph_zero_based":16367}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["c09a05f5e486a2781cf6ef6d05f1105265f74f29a1fcc0b352a19611e4f70483","4fcbff7d7d9a08a8f0bdfc3c97f4ff5f5e2b9a62ead95ed1014d0519d4e4fe59","6f4b7f2c3fd9307a97885988013cc3c2fde9137e322859ce5b0cef6e2acf7346","9684ead22fcf6ed9579365a9b8bc5e2f3bad60e8fa5faf6b56e1f2b5feb2c63f","5c2989de51fdb75f0041e18d3c8933c10ebb353fc3752a149e1489585916fd66","227025a9aabc696a245ee4bd9dd57ad2746f88915ebc2ee4ddf1af8726c48f94","a3117a94f891416ee704f0a5c7d07791d9cbefbc43657e8a1376d17e3f930785","b5c9cc7e967f0632ec766dc6a40c1a3eca1b6f6d9b38004b17733c8690c5b6e3","ab35e6ae1937ecc97e08069153f2116e9d66657d4dfa1cea55b31504d281ff9d","a11723254db093c9c9a19f9ebbeb28fcd59389709366a6058a0278ec776ccf01","b8af9d5324169b6819382ec3aadd50e6257fb2e6f5f1ce2b4ec4dc751ddf4a2d","52d91fdfae8de0a550c878f511a7b389138837e3ff5cef3b4d4648dcf134af15","931067320c1d1b4493229e54300da7dc42b78b30080152b37b9201790525af43","3a670fefce4067cc8e7ab013ed7fc20f53dfb0465b749409eb402388f53e4f5c","4314b60a999c5afbfc7cc1a5fd49f193278d7f9c119e8a6dc090f9841f8c26c8","361ba90ecd6801f72b0e7ad2a172bcdc290521d06d0afc0852f179296ece9446","8c7c6318fb027237469cb2920fa24b805501fd8459aca1c75899f15214976ffe","cc6f2f71734378ded9271eb4f061f5d1828e4cc559850bdfbc8d41616abb815f","1d942cdbf205fa33efa7fc04d3a93d1528d2b4dbd0548943e936b9ea5bd389ac","6df6f4ffdf3a0df2e692319effc5bbac346bbcb92a364eeb8baa92111391cfad","3be87e765be5079cc3dda236b189f099e0032450c98f7c9afd4a86574bd3ae97","1bcbe40baf38f9ec0a4756ffe4d4ffa4b0fc31d2a11fc1eff4945a2dd97fb136","6a4785ceaf41bd58cf945fadb04f3140828058da4bfdedda4f52cc535acfd6fb","b7a13cf4513e96d0b36c3a1bdb2dd995c295e43b5b284234c9e5979642a61c3b"],"paragraph_range_zero_based":[16344,16367],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p16344"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The field is mandatory present when a condReconfigId is being added. Otherwise the field is optional, need M.","paragraph_zero_based":16368},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16369},{"literal_text_all_w_t_and_m_t":"–ConditionalReconfiguration","paragraph_zero_based":16370},{"literal_text_all_w_t_and_m_t":"The IE ConditionalReconfiguration is used to add, modify and release the configuration of conditional reconfiguration.","paragraph_zero_based":16371},{"literal_text_all_w_t_and_m_t":"ConditionalReconfiguration information element","paragraph_zero_based":16372},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":16373},{"literal_text_all_w_t_and_m_t":"-- TAG-CONDITIONALRECONFIGURATION-START","paragraph_zero_based":16374},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16375},{"literal_text_all_w_t_and_m_t":"ConditionalReconfiguration-r16 ::=   SEQUENCE {","paragraph_zero_based":16376},{"literal_text_all_w_t_and_m_t":"    attemptCondReconfig-r16              ENUMERATED {true}              OPTIONAL,   -- Cond CHO","paragraph_zero_based":16377},{"literal_text_all_w_t_and_m_t":"    condReconfigToRemoveList-r16         CondReconfigToRemoveList-r16   OPTIONAL,   -- Need N","paragraph_zero_based":16378},{"literal_text_all_w_t_and_m_t":"    condReconfigToAddModList-r16         CondReconfigToAddModList-r16   OPTIONAL,   -- Need N","paragraph_zero_based":16379},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":16380},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":16381},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16382},{"literal_text_all_w_t_and_m_t":"CondReconfigToRemoveList-r16 ::=     SEQUENCE (SIZE (1.. maxNrofCondCells-r16)) OF CondReconfigId-r16","paragraph_zero_based":16383},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16384},{"literal_text_all_w_t_and_m_t":"-- TAG-CONDITIONALRECONFIGURATION-STOP","paragraph_zero_based":16385},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":16386},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16387},{"literal_text_all_w_t_and_m_t":"ConditionalReconfiguration field descriptions","paragraph_zero_based":16388},{"literal_text_all_w_t_and_m_t":"attemptCondReconfig","paragraph_zero_based":16389},{"literal_text_all_w_t_and_m_t":"If present, the UE shall perform conditional reconfiguration if selected cell is a target candidate cell and it is the first cell selection after failure as described in clause 5.3.7.3.","paragraph_zero_based":16390},{"literal_text_all_w_t_and_m_t":"condReconfigToAddModList","paragraph_zero_based":16391}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["ec65f2aec33f8b1e2b2cbaee95822f268ce09107e238dea95c5d0819b1ab33e0","bbb5a2a5764b8bd8813f550113b875356caacb79db1479bdfb1c8f62d57b5c0c","cc4cc8e021a9e379ad70ada66947a674eba8d6a2b8eda14515c5b336d6b00e5e","0d905c1ee56bf4fe12b49bb6fdf65f79797d6c1dde85dff61cdcd882226f81fb","29a6a5ee3b7b852158c20ddb53d6f5a68fa14d059376680ecc1d393f24432ac4","a905c87db035be338e0ad5aef06407ba673ba9a70c149dc32a484831a0134cbc","f0234d3555359e7e1a1d1827cad05ce676bcf073ccf8a0ffa5abf87220250c34","67762af89d593f2c0c8799ce720d823b3bed96d8f3a7d86071eb52a239e23110","e3fc26746d6b491a6fdf3ca9f83d0c2b58028462bc63af062cab472acfb1b0ec","72ccac3f3922546e27c9faa4edc1f14a95195b1d877745e382c751ef75a0405c","91ffb47cd01c5ace82d3a44276c2df6a4dc043fbd3e651a698a8069b06730e1c","5f9b6526141525f53f707ec7df983af205626eb3d2cb4341aea711ec9602ac61","e3050e3bfd7769c169570ce098d2b32a5efe1fcb9d89da0cec79abcd10d8c045","a6aaae1a35c6f2f95d40f994b345683d7e62711215215483e115fbe01bb96b32","25a8cea6528f54907180db940471e38a69a491e9bee9d90736ea88009dfdc554","74ba60ff43ae853a2473bd9bdf77429fc9d756974b6470993b6642dfdfea11aa","bda8765714cd562a85afd722faef8ff59d9f0ddfefb16bc5567e54d48a8289df","9deb3d2701ba67b6ff7ff700df44179943f35391102a0e69c52b8fe280b131a6","6ae87b7f991e21de6cf57080e79a543c9960389483d71ccbc7a66a0b41d8b494","ab19bb25265d779a2fce320a3819b6781d9de4924f0e12c88909b6b86b432ca8","57821c9d0eb68496587843e86e4b9075ffd51949dddefce55987cd7bd0a2b8a8","6411f0e55d831d3e8c9a51d1fd5da7a994501bd6556a352b846879f54f32e0a9","3f9a74741855c28b83388c98b1cb855e5e2f01334ff29e86c7ac2cf963925c9f","f930c2265a1ea4f0f2f1ab3277c516dc9a3e1ae1777e782de8b1e7072b18f4d8"],"paragraph_range_zero_based":[16368,16391],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p16368"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"List of the configuration of candidate SpCells to be added or modified for CHO, CPA or CPC.","paragraph_zero_based":16392},{"literal_text_all_w_t_and_m_t":"condReconfigToRemoveList","paragraph_zero_based":16393},{"literal_text_all_w_t_and_m_t":"List of the configuration of candidate SpCells to be removed.","paragraph_zero_based":16394},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16395},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":16396},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":16397},{"literal_text_all_w_t_and_m_t":"CHO","paragraph_zero_based":16398},{"literal_text_all_w_t_and_m_t":"The field is optional present, Need R, if the UE is configured with at least a candidate SpCell for CHO. Otherwise the field is not present.","paragraph_zero_based":16399},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16400},{"literal_text_all_w_t_and_m_t":"–ConfiguredGrantConfig","paragraph_zero_based":16401},{"literal_text_all_w_t_and_m_t":"The IE ConfiguredGrantConfig is used to configure uplink transmission without dynamic grant according to two possible schemes. The actual uplink grant may either be configured via RRC (type1) or provided via the PDCCH (addressed to CS-RNTI) (type2). Multiple Configured Grant configurations may be configured in one BWP of a serving cell.","paragraph_zero_based":16402},{"literal_text_all_w_t_and_m_t":"ConfiguredGrantConfig information element","paragraph_zero_based":16403},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":16404},{"literal_text_all_w_t_and_m_t":"-- TAG-CONFIGUREDGRANTCONFIG-START","paragraph_zero_based":16405},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16406},{"literal_text_all_w_t_and_m_t":"ConfiguredGrantConfig ::=           SEQUENCE {","paragraph_zero_based":16407},{"literal_text_all_w_t_and_m_t":"    frequencyHopping                    ENUMERATED {intraSlot, interSlot}                                       OPTIONAL,   -- Need S","paragraph_zero_based":16408},{"literal_text_all_w_t_and_m_t":"    cg-DMRS-Configuration               DMRS-UplinkConfig,","paragraph_zero_based":16409},{"literal_text_all_w_t_and_m_t":"    mcs-Table                           ENUMERATED {qam256, qam64LowSE}                                         OPTIONAL,   -- Need S","paragraph_zero_based":16410},{"literal_text_all_w_t_and_m_t":"    mcs-TableTransformPrecoder          ENUMERATED {qam256, qam64LowSE}                                         OPTIONAL,   -- Need S","paragraph_zero_based":16411},{"literal_text_all_w_t_and_m_t":"    uci-OnPUSCH                         SetupRelease { CG-UCI-OnPUSCH }                                         OPTIONAL,   -- Need M","paragraph_zero_based":16412},{"literal_text_all_w_t_and_m_t":"    resourceAllocation                  ENUMERATED { resourceAllocationType0, resourceAllocationType1, dynamicSwitch },","paragraph_zero_based":16413},{"literal_text_all_w_t_and_m_t":"    rbg-Size                            ENUMERATED {config2}                                                    OPTIONAL,   -- Need S","paragraph_zero_based":16414},{"literal_text_all_w_t_and_m_t":"    powerControlLoopToUse               ENUMERATED {n0, n1},","paragraph_zero_based":16415}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["87a9b65f1e64ddf064d95a9c093bae46211d78c5deb05b40cd0f755577cf62cd","bebea8c4936b2dc6da927838d382b09a1792ea894300cb2c0cf878e9bffb0ef2","6449c4fd15a8239c02b05afa601d3c2381fb11d9ff4a96