{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"MeasGapId-r17 ::=                       INTEGER (1..maxNrofGapId-r17)","paragraph_zero_based":19560},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19561},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASGAPID-STOP","paragraph_zero_based":19562},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":19563},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19564},{"literal_text_all_w_t_and_m_t":"–MeasGapSharingConfig","paragraph_zero_based":19565},{"literal_text_all_w_t_and_m_t":"The IE MeasGapSharingConfig specifies the measurement gap sharing scheme and controls setup/ release of measurement gap sharing.","paragraph_zero_based":19566},{"literal_text_all_w_t_and_m_t":"MeasGapSharingConfig information element","paragraph_zero_based":19567},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":19568},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASGAPSHARINGCONFIG-START","paragraph_zero_based":19569},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19570},{"literal_text_all_w_t_and_m_t":"MeasGapSharingConfig ::=        SEQUENCE {","paragraph_zero_based":19571},{"literal_text_all_w_t_and_m_t":"    gapSharingFR2                   SetupRelease { MeasGapSharingScheme }       OPTIONAL,   -- Need M","paragraph_zero_based":19572},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":19573},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":19574},{"literal_text_all_w_t_and_m_t":"    gapSharingFR1                   SetupRelease { MeasGapSharingScheme }       OPTIONAL,   --Need M","paragraph_zero_based":19575},{"literal_text_all_w_t_and_m_t":"    gapSharingUE                    SetupRelease { MeasGapSharingScheme }       OPTIONAL    --Need M","paragraph_zero_based":19576},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":19577},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":19578},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19579},{"literal_text_all_w_t_and_m_t":"MeasGapSharingScheme::=         ENUMERATED {scheme00, scheme01, scheme10, scheme11}","paragraph_zero_based":19580},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19581},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASGAPSHARINGCONFIG-STOP","paragraph_zero_based":19582},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":19583}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["62fc364751760a4fe63ef911d6a8fe88189cc190395afd8777a3f7f32539661d","14aee6f25ec9379cf56c8918a92ad2a95ee106373ba03fb4e772628a5870e568","c1aa46844dab7f3a1f631c6c2355cc068fd8581ae30b6892dfd2631ff506560b","d94da951eb339b769074cc256e0ebaecbcf3d4e770724aca62f318ac3614d102","cf2670363a4983eefb6520924594abc03cc38e66779c2d476b167a0b738bd03f","417bc34ae344c8cb8b43f61dd418263005dbb5052cce53e0767a052e60a1ec10","d2df18286324e0b9a992d1d36055d89873a5f6a85dda379770f364e2e85e5b78","5fb11e757c8ec62ef173265f56bd24fdd206719648236da1ccf2febbbb8caa66","d86c1847ef860867f21e16d10314e1f1db16dcb29575d80e5f2ef0e7e10bdd68","926fb7e4ce0ca5f7c55b5cd02db5eeb110d7578ef4d2dfe26022b105afce769a","4f05d5d57cbc6ba6cd4898d0f879bcc984d9799ee6efc813a8b20ec1d9d319f9","4920afe467dcfecfcc2cd6e65a7b8b26dc4d1ba19a135448bfd79577b456a9a2","ee32b42d442295c9588f2b96a896705d026231ff341b65ebc9e1ca0bbdcd211f","390ffb7a2a96f96766a9b29c4691ab78f8dd552274a95bf196856b99812b951b","223da3cbe2c813c229c11f8f1c32415681fa968b8481aa859999f2948d5aa511","b3940d3615a70b41b178a0c8f4d667c997718c2c7b6f86755f6bb42b926bee96","ca9d9ba6a57a6e4c9f9f383cea8b62a8a2905ceec1e2413837cd9bb862f84dd2","a04c11ff277e237479cd60189045a3f965329e95f454783b8960edd9627b22c8","b406a3dcf4ec87b175901a2be887d2d43f84da4f4f8d2ebe077bd10f928197e2","faf064abe6f2964650f44345b1190465de4203ef02ac667a80e56349293097b8","e33c10ce700aba6af2803381fd97b3a4a438eebf420e2378c08c05608e0f9523","5fb057f046648554d3ceb7959e3774cd2b568016ed2ef2d2e76c7c5c8b5d9612","76e9783388abab1fb8733450fef6d0a4913d9f2a0fe8cef93c416a6c15cdb38e","8ac4ac5f3b9e738497c064b21092203926739d3c9701e22f2934576ba021dfd5"],"paragraph_range_zero_based":[19560,19583],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p19560"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19584},{"literal_text_all_w_t_and_m_t":"MeasGapSharingConfig field descriptions","paragraph_zero_based":19585},{"literal_text_all_w_t_and_m_t":"gapSharingFR1","paragraph_zero_based":19586},{"literal_text_all_w_t_and_m_t":"Indicates the measurement gap sharing scheme that applies to the gap set via gapFR1. In (NG)EN-DC, gapSharingFR1 cannot be set up by NR RRC (i.e. only LTE RRC can configure FR1 gap sharing). In NE-DC, gapSharingFR1 can only be set up by NR RRC (i.e. LTE RRC cannot configure FR1 gap sharing). In NR-DC, gapSharingFR1 can only be set up in the measConfig associated with MCG. gapSharingFR1 can not be configured together with gapSharingUE. For the applicability of the different gap sharing schemes, see TS 38.133 [14]. Value scheme00 corresponds to scheme \"00\", value scheme01 corresponds to scheme \"01\", and so on.","paragraph_zero_based":19587},{"literal_text_all_w_t_and_m_t":"gapSharingFR2","paragraph_zero_based":19588},{"literal_text_all_w_t_and_m_t":"Indicates the measurement gap sharing scheme that applies to the gap set via gapFR2. In (NG)EN-DC or NE-DC, gapSharingFR2 can only be set up by NR RRC (i.e. LTE RRC cannot configure FR2 gap sharing). In NR-DC, gapSharingFR2 can only be set up by MCG in the measConfig associated with MCG. gapSharingFR2 cannot be configured together with gapSharingUE. For applicability of the different gap sharing schemes, see TS 38.133 [14]. Value scheme00 corresponds to scheme \"00\", value scheme01 corresponds to scheme \"01\", and so on.","paragraph_zero_based":19589},{"literal_text_all_w_t_and_m_t":"gapSharingUE","paragraph_zero_based":19590},{"literal_text_all_w_t_and_m_t":"Indicates the measurement gap sharing scheme that applies to the gap set via gapUE. In (NG)EN-DC, gapSharingUE cannot be set up by NR RRC (i.e. only LTE RRC can configure per UE gap sharing). In NE-DC, gapSharingUE can only be set up by NR RRC (i.e. LTE RRC cannot configure per UE gap sharing). In NR-DC, gapSharingUE can only be set up in the measConfig associated with MCG. If gapSharingUE is configured, then neither gapSharingFR1 nor gapSharingFR2 can be configured. For the applicability of the different gap sharing schemes, see TS 38.133 [14]. Value scheme00 corresponds to scheme \"00\", value scheme01 corresponds to scheme \"01\", and so on.","paragraph_zero_based":19591},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19592},{"literal_text_all_w_t_and_m_t":"–MeasId","paragraph_zero_based":19593},{"literal_text_all_w_t_and_m_t":"The IE MeasId is used to identify a measurement configuration, i.e., linking of a measurement object and a reporting configuration.","paragraph_zero_based":19594},{"literal_text_all_w_t_and_m_t":"MeasId information element","paragraph_zero_based":19595},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":19596},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASID-START","paragraph_zero_based":19597},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19598},{"literal_text_all_w_t_and_m_t":"MeasId ::=                          INTEGER (1..maxNrofMeasId)","paragraph_zero_based":19599},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19600},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASID-STOP","paragraph_zero_based":19601},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":19602},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19603},{"literal_text_all_w_t_and_m_t":"–MeasIdleConfig","paragraph_zero_based":19604},{"literal_text_all_w_t_and_m_t":"The IE MeasIdleConfig is used to convey information to UE about measurements requested to be done while in RRC_IDLE or RRC_INACTIVE.","paragraph_zero_based":19605},{"literal_text_all_w_t_and_m_t":"MeasIdleConfig information element","paragraph_zero_based":19606},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":19607}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["96db467de3e1bee5e70e77aaee9ebf6ad512551b8a2bfd0080e341136c822571","d11416425965acafdd96df2f9cd34941f447b1fbf38b65d928c001c3c47e1e07","22dddb2f821cb442b29fcb78f9a216e1713b8c2f1b2f065be62d1d5a6a7a1809","247bdfb0957acb652de9597b122d7757cfdb296c7425d8f4f85cd78b5005dadd","fd916cd159f8242ca9cde8b191d50fff237ff79df3a6b295c4d7eab4afead41d","4b4949541d2a3bb079c8a9f0ff9453993d4bf48061a8ae45a57476eb6bd9a791","a23c837d631aecefce3a0c7d468148c6a991fcef8b212c0ccbc8f424dca6e21d","4770a2e9018816f57810260446f8209c9bfc9b90ca824c882210078fe15c12d4","7e9428b5eee72fba49517b16e1d957b7fe4faa7c9c502a3ab53d4459427b82d5","44754e9dae8e13e0bff13a0e7eed025ce3f40a202b4c5a2cce5f84d4376272f2","0d4d82607ace9ba73e4a9f8bda665461b8a15362908ea05046c2e6aa7381de65","81a75d629604267651b96ecc67c507272c803d896aedbfe7843a0a33ca8ba33a","e4262f31518038cdf538084444d23afb45f74d5db8da2ad6ec7dcd6fe0c0f3a7","d2bc66a0c059b16885f9d50653a04f4376eda76117bf688c02c73a953a38bce3","8a7842c667e1d1e5841fc3f4f5462e905f5e4b0dc3125a09a356395a3bfb3dd0","fd8fc942d6ca33f11be2c111b8dd91066f9c153db0326acc463228c0b55a1fd1","640ace539c9a375e8b325ea43ac49979a0cae6fc22491ba03032d07d6bdb36b2","a5978ba21a58b35f7f14ecd24734548205db2a167b9798d4e2ea411e29be7906","f3a5e773dc2bf93334ca3694371c7c1ae3551ee58b813600fb385b4b785607a7","206ec627bc76d8462c6a1e5e46f6441c9be24c25f6779da7764a2ea13ab1c623","36ef86e9634848bb2d2f57b9a6884a6413e8abba547adfb2c2a28fcbeccf9369","85e28fab6aaa5366c08e4afd06630f8e975459e550a53415e8f2b373272799fe","fda8e39cc8503a65afa2d249c3ac7999fbd87b93a6ff601dd9d38ae1f2da01e2","da1485860e873ec3ecbdf64f8277d