{"fields":{"filename":"R2-2313691.zip::R2-2313691_Introduction of support for BWP operation without restriction in TS38.331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":312},{"literal_text_all_w_t_and_m_t":"    reportUplinkTxDirectCurrent                ENUMERATED {true}                                                   OPTIONAL    -- Cond BWP-Reconfig","paragraph_zero_based":313},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":314},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":315},{"literal_text_all_w_t_and_m_t":"    bap-Address-r16                            BIT STRING (SIZE (10))                                                  OPTIONAL,   -- Need M","paragraph_zero_based":316},{"literal_text_all_w_t_and_m_t":"    bh-RLC-ChannelToAddModList-r16             SEQUENCE (SIZE(1..maxBH-RLC-ChannelID-r16)) OF BH-RLC-ChannelConfig-r16 OPTIONAL,   -- Need N","paragraph_zero_based":317},{"literal_text_all_w_t_and_m_t":"    bh-RLC-ChannelToReleaseList-r16            SEQUENCE (SIZE(1..maxBH-RLC-ChannelID-r16)) OF BH-RLC-ChannelID-r16     OPTIONAL,   -- Need N","paragraph_zero_based":318},{"literal_text_all_w_t_and_m_t":"    f1c-TransferPath-r16                       ENUMERATED {lte, nr, both}                                              OPTIONAL,   -- Need M","paragraph_zero_based":319},{"literal_text_all_w_t_and_m_t":"    simultaneousTCI-UpdateList1-r16            SEQUENCE (SIZE (1..maxNrofServingCellsTCI-r16)) OF ServCellIndex        OPTIONAL,   -- Need R","paragraph_zero_based":320},{"literal_text_all_w_t_and_m_t":"    simultaneousTCI-UpdateList2-r16            SEQUENCE (SIZE (1..maxNrofServingCellsTCI-r16)) OF ServCellIndex        OPTIONAL,   -- Need R","paragraph_zero_based":321},{"literal_text_all_w_t_and_m_t":"    simultaneousSpatial-UpdatedList1-r16       SEQUENCE (SIZE (1..maxNrofServingCellsTCI-r16)) OF ServCellIndex        OPTIONAL,   -- Need R","paragraph_zero_based":322},{"literal_text_all_w_t_and_m_t":"    simultaneousSpatial-UpdatedList2-r16       SEQUENCE (SIZE (1..maxNrofServingCellsTCI-r16)) OF ServCellIndex        OPTIONAL,   -- Need R","paragraph_zero_based":323},{"literal_text_all_w_t_and_m_t":"    uplinkTxSwitchingOption-r16                ENUMERATED {switchedUL, dualUL}                                         OPTIONAL,   -- Need R","paragraph_zero_based":324},{"literal_text_all_w_t_and_m_t":"    uplinkTxSwitchingPowerBoosting-r16         ENUMERATED {enabled}                                                    OPTIONAL    -- Need R","paragraph_zero_based":325},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":326},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":327},{"literal_text_all_w_t_and_m_t":"    reportUplinkTxDirectCurrentTwoCarrier-r16  ENUMERATED {true}                                                       OPTIONAL    -- Need N","paragraph_zero_based":328},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":329},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":330},{"literal_text_all_w_t_and_m_t":"    f1c-TransferPathNRDC-r17                   ENUMERATED {mcg, scg, both}                                             OPTIONAL,   -- Need M","paragraph_zero_based":331},{"literal_text_all_w_t_and_m_t":"    uplinkTxSwitching-2T-Mode-r17              ENUMERATED {enabled}                                                    OPTIONAL,   -- Cond 2Tx","paragraph_zero_based":332},{"literal_text_all_w_t_and_m_t":"    uplinkTxSwitching-DualUL-TxState-r17       ENUMERATED {oneT, twoT}                                                 OPTIONAL,   -- Cond 2Tx","paragraph_zero_based":333},{"literal_text_all_w_t_and_m_t":"    uu-RelayRLC-ChannelToAddModList-r17        SEQUENCE (SIZE(1..maxUu-RelayRLC-ChannelID-r17)) OF Uu-RelayRLC-ChannelConfig-r17","paragraph_zero_based":334},{"literal_text_all_w_t_and_m_t":"             