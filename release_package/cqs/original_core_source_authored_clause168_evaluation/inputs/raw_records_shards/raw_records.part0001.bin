NG (SIZE (32))                                       OPTIONAL    -- Cond MRB-Initialization","paragraph_zero_based":22115},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":22116},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22117},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22118},{"literal_text_all_w_t_and_m_t":"EthernetHeaderCompression-r16 ::=  SEQUENCE {","paragraph_zero_based":22119},{"literal_text_all_w_t_and_m_t":"    ehc-Common-r16                     SEQUENCE {","paragraph_zero_based":22120},{"literal_text_all_w_t_and_m_t":"        ehc-CID-Length-r16                 ENUMERATED { bits7, bits15 },","paragraph_zero_based":22121},{"literal_text_all_w_t_and_m_t":"         ...","paragraph_zero_based":22122},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":22123},{"literal_text_all_w_t_and_m_t":"    ehc-Downlink-r16               SEQUENCE {","paragraph_zero_based":22124},{"literal_text_all_w_t_and_m_t":"        drb-ContinueEHC-DL-r16         ENUMERATED { true }                                      OPTIONAL,   -- Need N","paragraph_zero_based":22125},{"literal_text_all_w_t_and_m_t":"        ...","paragraph_zero_based":22126},{"literal_text_all_w_t_and_m_t":"    }                                                                                           OPTIONAL,   -- Need M","paragraph_zero_based":22127}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["f8857dad3cbb30b1ea888b1a9a63623ea5b76cf3782469a62ce26508a3555db9","39c6b9477f9f2cdf958ffe90f71072e525b5aadf0bd02f46eb6d33ff5c11a0b7","586f32ce6e24d4722782764210c84c479ecb01c3f53cb29d25e27e81a909511a","23f6586d903846b54c95d44aacd15eb0e652f2702110caaa6923ae54e28f6