{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sdap-HeaderDL","paragraph_zero_based":26808},{"literal_text_all_w_t_and_m_t":"Indicates whether or not a SDAP header is present for DL data on this DRB. The field cannot be changed after a DRB is established.","paragraph_zero_based":26809},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26810},{"literal_text_all_w_t_and_m_t":"–SearchSpace","paragraph_zero_based":26811},{"literal_text_all_w_t_and_m_t":"The IE SearchSpace defines how/where to search for PDCCH candidates. Each search space is associated with one ControlResourceSet. For a scheduled SCell in the case of cross carrier scheduling, except for nrofCandidates, all the optional fields are absent (regardless of their presence conditions). For a scheduled SpCell in the case of the cross carrier scheduling, if the search space is linked to another search space in the scheduling SCell, all the optional fields of this search space in the scheduled SpCell are absent (regardless of their presence conditions) except for nrofCandidates.","paragraph_zero_based":26812},{"literal_text_all_w_t_and_m_t":"SearchSpace information element","paragraph_zero_based":26813},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26814},{"literal_text_all_w_t_and_m_t":"-- TAG-SEARCHSPACE-START","paragraph_zero_based":26815},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26816},{"literal_text_all_w_t_and_m_t":"SearchSpace ::=                         SEQUENCE {","paragraph_zero_based":26817},{"literal_text_all_w_t_and_m_t":"    searchSpaceId                           SearchSpaceId,","paragraph_zero_based":26818},{"literal_text_all_w_t_and_m_t":"    controlResourceSetId                    ControlResourceSetId                                        OPTIONAL,   -- Cond SetupOnly","paragraph_zero_based":