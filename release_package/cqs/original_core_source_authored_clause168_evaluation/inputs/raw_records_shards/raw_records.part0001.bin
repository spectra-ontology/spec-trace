{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"UTRA-FDD-CellIndexList-r16 ::=              SEQUENCE (SIZE (1..maxCellMeasUTRA-FDD-r16)) OF UTRA-FDD-CellIndex-r16","paragraph_zero_based":20328},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20329},{"literal_text_all_w_t_and_m_t":"UTRA-FDD-CellIndex-r16 ::=                  INTEGER (1..maxCellMeasUTRA-FDD-r16)","paragraph_zero_based":20330},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20331},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASOBJECTUTRA-FDD-STOP","paragraph_zero_based":20332},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":20333},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20334},{"literal_text_all_w_t_and_m_t":"MeasObjectUTRA-FDD field descriptions","paragraph_zero_based":20335},{"literal_text_all_w_t_and_m_t":"carrierFreq","paragraph_zero_based":20336},{"literal_text_all_w_t_and_m_t":"Identifies UTRA-FDD carrier frequency for which this configuration is valid. NR does not configure more than one measurement object for the same physical frequency regardless of the ARFCN used to indicate this.","paragraph_zero_based":20337},{"literal_text_all_w_t_and_m_t":"cellIndexUTRA-FDD","paragraph_zero_based":20338},{"literal_text_all_w_t_and_m_t":"Entry index in the neighbouring cell list.","paragraph_zero_based":20339},{"literal_text_all_w_t_and_m_t":"cellsToAddModList","paragraph_zero_based":20340},{"literal_text_all_w_t_and_m_t":"List of UTRA-FDD cells to add/modify in the neighbouring cell list.","paragraph_zero_based":20341},{"literal_text_all_w_t_and_m_t":"cellsToRemoveList","paragraph_zero_based":20342},{"literal_text_all_w_t_and_m_t":"List of cells to remove from the neighbouring cell list.","paragraph_zero_based":20343},{"literal_text_all_w_t_and_m_t":"utra-FDD-Q-OffsetRange","paragraph_zero_based":20344},{"literal_text_all_w_t_and_m_t":"Used to indicate a frequency specific offset to be applied when evaluating triggering conditions for measurement reporting. The value is in dB.","paragraph_zero_based":20345},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20346},{"literal_text_all_w_t_and_m_t":"–MeasResultCellListSFTD-NR","paragraph_zero_based":20347},{"literal_text_all_w_t_and_m_t":"The IE MeasResultCellListSFTD-NR consists of SFN and radio frame boundary difference between the PCell and an NR cell as specified in TS 38.215 [9] and TS 38.133 [14].","paragraph_zero_based":20348},{"literal_text_all_w_t_and_m_t":"MeasResultCellListSFTD-NR information element","paragraph_zero_based":20349},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":20350},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASRESULTCELLLISTSFTD-NR-START","paragraph_zero_based":20351}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["1e8b2167eba0978d327937fdaad6fe5631e090be3be7ed7249bffd8f5fa4dcd6","8cc425658cecef3301964e90c70ce4787231ca5f3ccebc7af768670ac15560da","dbcdc7e3e2783cfd6b5e65645b6a9c8fe7aee63d662b4d434a01dcf78f505eaf","4fcf9a40bd601798100c001d3096c04e3dd32b0a0cb8547bfe2676346124fa39","70b694ad91eb2b74cb42b869d6f429d8227f425e2d44c93256a7b6aa947de453","98ef0099b1a1e1420e15d1ef4f5fe35686ea7c2c4901070d44599fc20d5bf5c5","f043818703670ed08f008b638fa03eeff58da7f0278160e35708057de4e8c3c2","3d36b7d3c9c22312ab0bbabcffabcc6d60cd7be8ddb446ab3fd17527c596180e","23f0f65beed50f73a1dc4c8be7d9a6464615945b96d80fb1d5ef3b00027ac7dc","11a580e28867df135664266aee84cfd115c7da2ff603ae8b6658b7ffeb8a67d0","d51c0dc8b55b9bc6b325418a30cc53145bacd36559a4e7c3b931e73ba7f0309e","16d62c80c0d74343340526749d