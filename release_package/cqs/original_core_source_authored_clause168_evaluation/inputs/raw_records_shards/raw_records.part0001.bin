{"fields":{"filename":"R2-2313652.zip::R2-2313652 TEI18 SDT_ReleaseEnh 38331 CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"RSRP-ChangeThreshold-r17 ::= ENUMERATED {dB4, dB6, dB8, dB10, dB14, dB18, dB22, dB26, dB30, dB34, spare6, spare5, spare4, spare3, spare2, spare1}","paragraph_zero_based":552},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":553},{"literal_text_all_w_t_and_m_t":"SRS-PosConfig-r17 ::=               SEQUENCE {","paragraph_zero_based":554},{"literal_text_all_w_t_and_m_t":"    srs-PosResourceSetToReleaseList-r17 SEQUENCE (SIZE(1..maxNrofSRS-PosResourceSets-r16)) OF SRS-PosResourceSetId-r16 OPTIONAL,-- Need N","paragraph_zero_based":555},{"literal_text_all_w_t_and_m_t":"    srs-PosResourceSetToAddModList-r17  SEQUENCE (SIZE(1..maxNrofSRS-PosResourceSets-r16)) OF SRS-PosResourceSet-r16  OPTIONAL,-- Need N","paragraph_zero_based":556},{"literal_text_all_w_t_and_m_t":"    srs-PosResourceToReleaseList-r17    SEQUENCE (SIZE(1..maxNrofSRS-PosResources-r16)) OF SRS-PosResourceId-r16      OPTIONAL,-- Need N","paragraph_zero_based":557},{"literal_text_all_w_t_and_m_t":"    srs-PosResourceToAddModList-r17     SEQUENCE (SIZE(1..maxNrofSRS-PosResources-r16)) OF SRS-PosResource-r16        OPTIONAL -- Need N","paragraph_zero_based":558},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":559},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":560},{"literal_text_all_w_t_and_m_t":"-- TAG-RRCRELEASE-STOP","paragraph_zero_based":561},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":562},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":563},{"literal_text_all_w_t_and_m_t":"RRCRelease-IEs field descriptions","paragraph_zero_based":564},{"literal_text_all_w_t_and_m_t":"cellReselectionPriorities","paragraph_zero_based":565},{"literal_text_all_w_t_and_m_t":"Dedicated priorities to be used for cell reselection as specified in TS 38.304 [20]. The maximum number of NR carrier frequencies that the network can configure through FreqPriorityListNR and FreqPriorityListDedicatedSlicing together is eight. If the same frequency is configured in both FreqPriorityListNR and FreqPriorityListDedicatedSlicing, the frequency is only counted once.","paragraph_zero_based":566},{"literal_text_all_w_t_and_m_t":"cnType","paragraph_zero_based":567},{"literal_text_all_w_t_and_m_t":"Indicate that the UE is redirected to EPC or 5GC.","paragraph_zero_based":568},{"literal_text_all_w_t_and_m_t":"deprioritisationReq","paragraph_zero_based":569},{"literal_text_all_w_t_and_m_t":"Indicates whether the current frequency or RAT is to be de-prioritised.","paragraph_zero_based":570},{"literal_text_all_w_t_and_m_t":"deprioritisationTimer","paragraph_zero_based":571},{"literal_text_all_w_t_and_m_t":"Indicates the period for which either the current carrier frequency or NR is deprioritised. Value minN corresponds to N minutes.","paragraph_zero_based":572},{"literal_text_all_w_t_and_m_t":"measIdleConfig","paragraph_zero_based":573},{"literal_text_all_w_t_and_m_t":"Indicates measurement configuration to be stored and used by the UE while in RRC_IDLE or RRC_INACTIVE.","paragraph_zero_based":574},{"literal_text_all_w_t_and_m_t":"mpsPriorityIndication","paragraph_zero_based":575}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"17bfba3da8c3743440a94764df1dd7e80753d504abfaf5e795d5a1c67c51ffac","original_member_sha256":"812d8433d8c47117aecae37ff5db028576123736cb57689623cc95ade6d2faf9","paragraph_ElementTree_utf8_XML_sha256":["23483bb61c6460525171e73c0fb4ed4ff8baf12a5a3ee41010ab9a6f97dabd81","9d8085db1602cda2fdc05005d9e15f6eb261bde493e23a755132e90f30678001","d2a80134ccde79b4cd83ee3814d22152feba9dc59d77c2c7740cbecd318a898e","e1260f34120f7749a9481c569a8854ebe079cf24f03046dcd3b7d5020abc81a6","60adcd654974a0864119b5137c23ec31ae3db404e83642becb684dfa9d578269","a3742dcb955a42493c331f3cda0fb44a05482a4cc863f3a5caaa9021fa7c22af","f5b49d5114a6aabb7fc383d0e0385a410d9244dd12b394e69a982b718a794dbe","f2f9d71646a7ccb9c1e88de87198b2b997ddcf57d7b51fa847b304ebfe2e8a86","72d80d3a92f15c5341acd50627420451619de4a279930969dbf922cf671a9dcb","1b5e868556bff68433426fdeffa70b8408e141501ff80cb94d8177fa88f4d95b","21ff023e80dadab80ce72f6098926ad5250825960ed16d8a8ffc6c564b8dc081","25e6f45ea78ba834ac58c874ac84ef386c9331df2697335529f49ab036299cb1","f304cc582ec22af2dee56e54c58aa267b22ceddfd78900021bd0bd8929380ee7","ea6eba122d61334b83f78ba69f8e03448d72de9fc5e6cae62ca248926d7528e5","bc5a7ad4fd7317621715333617a13d321b53642da37cf027a1f977fe01d432e0","0f80d86d6a035f4f48826d0b4aa7fea0efdd30d6833f69e8296710cccfeb1ab2","558af6abf187a2d3e1cf4494bee7e773e4f1c7e47bfac95b6035b5f131242d20","ed681ed94c59fce0aadfe8a4b4da23054b49b458a58a799fa17e01a8e9c3dbb3","fe8d96b73516f51d9fc254bbf70e8403e562762db22596e8af27b958e9249349","b6ca2e580e928f499ddca6b5ea069b1f4edad8b91806cdc65ba5c7bebd1cd1af","138f1e741a22eed4626b468748fb93c32a17138fead03ae4391bc2f5868a858f","d6d344f564f2fd82ee1ddfa087e3d5e5c89e7b0df10857bd36aa5be51ca007ef","d1fc9fa85f2790c92c78834985957c5d2d6df8646a436ccd351f698da33a7252","1165d4d0f2733c40a1def8937f6113d34e08a75c1d07efea6e417bff4766840e"],"paragraph_range_zero_based":[552,575],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313652.zip::R2-2313652 TEI18 SDT_ReleaseEnh 38331 CR.docx:p552"}
{"fields":{"filename":"R2-2313652.zip::R2-2313652 TEI18 SDT_ReleaseEnh 38331 CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the UE can set the establishment cause to mps-PriorityAccess for a new connection following a redirect to NR or set the resume cause to mps-PriorityAccess for a resume following a redirect to NR. If the target RAT is E-UTRA, see TS 36.331 [10]. The gNB sets the indication only for UEs authorized to receive MPS treatment as indicated by ARP and/or QoS characteristics at the gNB, and it is applicable only for this instance of release with redirection to carrier/RAT included in the redirectedCarrierInfo field in the RRCRelease message.","paragraph_zero_based":576},{"literal_text_all_w_t_and_m_t":"noLastCellUpdate","paragraph_zero_based":577},{"literal_text_all_w_t_and_m_t":"Presence of the field indicates that the last used cell for PEI shall not be updated. When the field is absent, the PEI-capable UE shall update its last used cell with the current cell. The UE shall not update its last used cell with the current cell if the AS security is not activated.","paragraph_zero_based":578},{"literal_text_all_w_t_and_m_t":"srs-PosRRC-InactiveConfig","paragraph_zero_based":579},{"literal_text_all_w_t_and_m_t":"SRS for positioning configuration during RRC_INACTIVE state.","paragraph_zero_based":580},{"literal_text_all_w_t_and_m_t":"suspendConfig","paragraph_zero_based":581},{"literal_text_all_w_t_and_m_t":"Indicates configuration for the RRC_INACTIVE state. The network does not configure suspendConfig when the network redirect the UE to an inter-RAT carrier frequency or if the UE is configured with a DAPS bearer.","paragraph_zero_based":582},{"literal_text_all_w_t_and_m_t":"redirectedCarrierInfo","paragraph_zero_based":583},{"literal_text_all_w_t_and_m_t":"Indicates a carrier frequency (downlink for FDD) and is used to redirect the UE to an NR or an inter-RAT carrier frequency, by means of cell selection at transition to RRC_IDLE or RRC_INACTIVE as specified in TS 38.304 [20]. Based on UE capability, the network may include redirectedCarrierInfo in RRCRelease message with suspendConfig if this message is sent in response to an RRCResumeRequest or an RRCResumeRequest1 which is triggered by the NAS layer (see 5.3.1.4 in TS 24.501 [23]).","paragraph_zero_based":584},{"literal_text_all_w_t_and_m_t":"voiceFallbackIndication","paragraph_zero_based":585},{"literal_text_all_w_t_and_m_t":"Indicates the RRC release is triggered by EPS fallback for IMS voice as specified in TS 23.502 [43].","paragraph_zero_based":586},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":587},{"literal_text_all_w_t_and_m_t":"CarrierInfoNR field descriptions","paragraph_zero_based":588},{"literal_text_all_w_t_and_m_t":"carrierFreq","paragraph_zero_based":589},{"literal_text_all_w_t_and_m_t":"Indicates the redirected NR frequency.","paragraph_zero_based":590},{"literal_text_all_w_t_and_m_t":"ssbSubcarrierSpacing","paragraph_zero_based":591},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing of SSB in the redirected SSB frequency.","paragraph_zero_based":592},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":593},{"literal_text_all_w_t_and_m_t":"FR1:    15 or 30 kHz","paragraph_zero_based":594},{"literal_text_all_w_t_and_m_t":"FR2-1:  120 or 240 kHz","paragraph_zero_based":595},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":596},{"literal_text_all_w_t_and_m_t":"smtc","paragraph_zero_based":597},{"literal_text_all_w_t_and_m_t":"The SSB periodicity/offset/duration configuration for the redirected SSB frequency. It is based on timing reference of PCell. If the field is absent, the UE uses the SMTC configured in the measObjectNR having the same SSB frequency and subcarrier spacing.","paragraph_zero_based":598},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":599}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"17bfba3da8c3743440a94764df1dd7e80753d504abfaf5e795d5a1c67c51ffac","original_member_sha256":"812d8433d8c47117aecae37ff5db028576123736cb57689623cc95ade6d2faf9","paragraph_ElementTree_utf8_XML_sha256":["66c0914537885b8106bf507c05f1de28d239c2f0c4da286deed8dcf666a6125a","5336a07a6014ad22fbe46915c2d283bea27bbb5ae35d69ae81999bc8ea71fb9b","a640be81624f378c6b9f0dbbcbd5b6cd81218d0c4678433decef4dced59303c0","d62a9b8432a199fabf232d8d7a50d993ed272ba519148041aed939397cdf3f88","8ae2563f97b6b2b970fcd09f3f1e9d0631ca264e45f2a7daa13b0a44f2ba776d","1e186c5ae8cfbab67291a5c9689b9cbda5df452d2501df3025947e8d0962f20c","b94e977e8f5d3e13e4fdc6983f7ed5706ce8873c7dde4ddbd0e15963fd611d0c","94b09422311cb48902b9ce428a6ba3e89b2178ac1ab2f7b072ac52ffdc7e2bf3","1a1e308ba3fbdc36d7fc7967d5c83055f32509a10bf0cabc349f8f1a74f21e45","3cb1771a64987eff2ff887a51484dc1e32bdb22b4b298ae1a26827a526deeabe","a92b0eb3d01cf2c43f57df43eef4ff2a3a07e493572d64cfb5c9ae7ecc276d14","dbc545bf039702400a517fb35b52816e3baedc279ffa746a6994f1e37c7b5496","a88cb244f138ebf7379d05587f1bd0537e11046feac8296901b9fbe11a7db17a","60ee2f04176e85f493643799a9e0f15d0adf1df96f08b6d69858dba598137efa","868f418f09a068d512e54016dd574fec74410d602f9e9f848d0bbfd216b8bdf9","131689d75e1d5910349cc779eb365ac2b0e000959cd1cac1073e3d5a3fae4cb2","60855815f363a59c4fbd1ab852e8fcd499f0daed99fc8cd4b3d6766f197a175c","2d3b6b4929873bf630bfed2fe195c31369f72712896cb04ec8e0ed51cfc76ada","ef31fecfd8bff6841877c7b5c5c2ad54e5b740d0676ec145ec0f4090b4c246fa","cc467ab3883a977a0feadf6a5ef6871f6176dc07631b2d90c59f378db842f790","8031c729da0b7be4a0b21fdbecb5026bc8465b2acc222e31a4b494b13614cc2b","29694f74aba2522d5f54fa4467aeb4d7b54de661eefd85b646000e74627fdece","ebc6e2c261e80ed066e0e013f5987946fd3a37adc826cd756db79aec0a35f538","0c6e046a0cded35b99aa779366a990b05e432b39ee4a5bc93a0322a3c20bcd71"],"paragraph_range_zero_based":[576,599],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313652.zip::R2-2313652 TEI18 SDT_ReleaseEnh 38331 CR.docx:p576"}
{"fields":{"filename":"R2-2313652.zip::R2-2313652 TEI18 SDT_ReleaseEnh 38331 CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"RAN-NotificationAreaInfo field descriptions","paragraph_zero_based":600},{"literal_text_all_w_t_and_m_t":"cellList","paragraph_zero_based":601},{"literal_text_all_w_t_and_m_t":"A list of cells configured as RAN area.","paragraph_zero_based":602},{"literal_text_all_w_t_and_m_t":"ran-AreaConfigList","paragraph_zero_based":603},{"literal_text_all_w_t_and_m_t":"A list of RAN area codes or RA code(s) as RAN area.","paragraph_zero_based":604},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":605},{"literal_text_all_w_t_and_m_t":"PLMN-RAN-AreaConfig field descriptions","paragraph_zero_based":606},{"literal_text_all_w_t_and_m_t":"plmn-Identity","paragraph_zero_based":607},{"literal_text_all_w_t_and_m_t":"PLMN Identity to which the cells in ran-Area belong. If the field is absent the UE not in SNPN access mode uses the ID of the registered PLMN. This field is not included for UE in SNPN access mode (for UE in SNPN access mode the ran-Area always belongs to the registered SNPN).","paragraph_zero_based":608},{"literal_text_all_w_t_and_m_t":"ran-AreaCodeList","paragraph_zero_based":609},{"literal_text_all_w_t_and_m_t":"The total number of RAN-AreaCodes of all PLMNs does not exceed 32.","paragraph_zero_based":610},{"literal_text_all_w_t_and_m_t":"ran-Area","paragraph_zero_based":611},{"literal_text_all_w_t_and_m_t":"Indicates whether TA code(s) or RAN area code(s) are used for the RAN notification area. The network uses only TA code(s) or both TA code(s) and RAN area code(s) to configure a UE. The total number of TACs across all PLMNs does not exceed 16.","paragraph_zero_based":612},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":613},{"literal_text_all_w_t_and_m_t":"PLMN-RAN-AreaCell field descriptions","paragraph_zero_based":614},{"literal_text_all_w_t_and_m_t":"plmn-Identity","paragraph_zero_based":615},{"literal_text_all_w_t_and_m_t":"PLMN Identity to which the cells in ran-AreaCells belong. If the field is absent the UE not in SNPN access mode uses the ID of the registered PLMN. This field is not included for UE in SNPN access mode (for UE in SNPN access mode the ran-AreaCells always belongs to the registered SNPN).","paragraph_zero_based":616},{"literal_text_all_w_t_and_m_t":"ran-AreaCells","paragraph_zero_based":617},{"literal_text_all_w_t_and_m_t":"The total number of cells of all PLMNs does not exceed 32.","paragraph_zero_based":618},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":619},{"literal_text_all_w_t_and_m_t":"SDT-Config field descriptions","paragraph_zero_based":620},{"literal_text_all_w_t_and_m_t":"sdt-DRB-ContinueROHC","paragraph_zero_based":621},{"literal_text_all_w_t_and_m_t":"Indicates whether the PDCP entity of the radio bearers configured for SDT continues or resets the ROHC header compression protocol during PDCP re-establishment during SDT procedure, as specified in TS 38.323 [5]. Value cell indicates that ROHC header compression continues when the UE resumes for SDT in the same cell as the PCell when the RRCRelease message was received. Value rna indicates that ROHC header compression continues when the UE resumes for SDT in a cell belonging to the same RNA as the PCell where the RRCRelease message was received. If the field is absent, the UE releases any stored value for this field and the PDCP entity of the radio bearers configured for SDT always resets the ROHC header compression protocol during PDCP re-establishment when SDT procedure is initiated, as specified in TS 38.323 [5].","paragraph_zero_based":622},{"literal_text_all_w_t_and_m_t":"sdt-DRB-List","paragraph_zero_based":623}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"17bfba3da8c3743440a94764df1dd7e80753d504abfaf5e795d5a1c67c51ffac","original_member_sha256":"812d8433d8c47117aecae37ff5db028576123736cb57689623cc95ade6d2faf9","paragraph_ElementTree_utf8_XML_sha256":["ebea6c91c06797bec72cc00b67646d5ea9963db86265025802de74369ed6bc89","f4be9211b62f4adb242d1fa34fc730821f6d0e8dd9d0c9a80d73a9f33d035a61","eb6eb1023cdadad8489cc0508848b50de2e2f7aec7df3c08d6593ff2e1f9f530","d4fd911b7ac3615f77805ccbe3130d7874a6387e37dbfcc9e5c2f76a46255d10","1a0be1b2dcc68ba637ab69f94ddeba93ee7970f45796eb605c4d83960ba729bc","ae7cf7b6a9d40c6dbe3c2809453cba5547c1f2ba4c2ff831a81f2c91a6b68d14","fddc3b7f0585355f69040ae5adb6138ebba38428bff1ff65f0c4528750469083","974d044642740378e4caea2aa6a624d82f0acc6120c5e8ba0a698140cbb871e5","95d95d8b71cec5d853a7f77bbe8f300548e9265c5a5266bb2eb191df0add37de","f797fc3d5b2de30d38383d757810d9924dbdcb5be410fa0d7e83393bb195f12f","9412c1e66d0a02a9b4af0339b0786abd03b5f73f5bed5d5d18bbd4a84feffe3d","a1ec06cb98bca5ab7ff65aa5deccd55ec3116c34b70652199c45b48d09510138","640d36a6365ba198dbc83bcad6e88167e35f1080979fd45040ee1c450dd9b0fe","fce41b18eb1043572c4e080d26dada5a004596717d17f9ae8e229ee1b60d4a2e","a24c81be27da1ec63469fd452d6590dc957dd22482659604f50d3e0d7eed5c80","bdfd297096b1b20a454a8974e8504a6628482047ee737528fd0a3b7a80812409","2fb8284667e5640c1a4b2833388ee86b4cbaecee626aa41bc1ca1b89c6075bd3","92ca44f79b04c4a235d088773925ad9591e39bf3c622bcaaacac6813e8faee54","b75ded31eb496646d91182f46b679c09936a5266527053ce05e6fe4842196266","ea187f0e8721c7ba7448ecc003327b82a5e396b0c1a4d93037f94ce73d066c5a","5c021fa0da699625669c709fef42c6167e27455aa4b6d381c3b74f56731f99ff","64c735c5e24fd279c571fa93303ff682a35a79a9028e3e7184eafe5b51d5a913","e8f465a7de7f40b83fdf8b82583de6e2d563b7d052390846daae48486c436be9","a9fd4ab2a95f77ee1e791c1dd6f613cd60c336f81575c563886a7413c3d6c1d8"],"paragraph_range_zero_based":[600,623],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313652.zip::R2-2313652 TEI18 SDT_ReleaseEnh 38331 CR.docx:p600"}
{"fields":{"filename":"R2-2313652.zip::R2-2313652 TEI18 SDT_ReleaseEnh 38331 CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the ID(s) of the DRB(s) that are configured for SDT. If size of the sequence is zero, then the UE assumes that none of the DRBs are configured for SDT. The network only configures MN terminated MCG bearers for SDT.","paragraph_zero_based":624},{"literal_text_all_w_t_and_m_t":"sdt-SRB2-Indication","paragraph_zero_based":625},{"literal_text_all_w_t_and_m_t":"Indiates whether SRB2 is configured for SDT or not.","paragraph_zero_based":626},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":627},{"literal_text_all_w_t_and_m_t":"SDT-MAC-PHY-CG-Config field descriptions","paragraph_zero_based":628},{"literal_text_all_w_t_and_m_t":"cg-SDT-ConfigInitialBWP-DL","paragraph_zero_based":629},{"literal_text_all_w_t_and_m_t":"Downlink BWP configuration for CG-SDT. If a UE is a RedCap UE and if the initialDownlinkBWP-RedCap is configured in downlinkConfigCommon in SIB1, this field is configured for initialDownlinkBWP-RedCap, otherwise it is configured for initialDownlinkBWP.","paragraph_zero_based":630},{"literal_text_all_w_t_and_m_t":"cg-SDT-ConfigInitialBWP-NUL","paragraph_zero_based":631},{"literal_text_all_w_t_and_m_t":"UL BWP configuration for CG-SDT on NUL carrier. If a UE is a RedCap UE and if the initialUplinkBWP-RedCap is configured in uplinkConfigCommon in SIB1, this field is configured for initialUplinkBWP-RedCap, otherwise it is configured for initialUplinkBWP for NUL.","paragraph_zero_based":632},{"literal_text_all_w_t_and_m_t":"cg-SDT-ConfigInitialBWP-SUL","paragraph_zero_based":633},{"literal_text_all_w_t_and_m_t":"UL BWP configuration for CG-SDT on SUL carrier configured for the initialUplinkBWP for SUL.","paragraph_zero_based":634},{"literal_text_all_w_t_and_m_t":"cg-SDT-CS-RNTI","paragraph_zero_based":635},{"literal_text_all_w_t_and_m_t":"The CS-RNTI value for CG-SDT as specified in TS 38.321 [3].","paragraph_zero_based":636},{"literal_text_all_w_t_and_m_t":"cg-SDT-RSRP-ThresholdSSB","paragraph_zero_based":637},{"literal_text_all_w_t_and_m_t":"An RSRP threshold configured for SSB selection for CG-SDT as specified in TS 38.321 [3].","paragraph_zero_based":638},{"literal_text_all_w_t_and_m_t":"cg-SDT-TA-ValidationConfig","paragraph_zero_based":639},{"literal_text_all_w_t_and_m_t":"Configuration for the RSRP based TA validation. If this field is not configured, then the UE does not perform RSRP based TA validation.","paragraph_zero_based":640},{"literal_text_all_w_t_and_m_t":"cg-SDT-timeAlignmentTimer","paragraph_zero_based":641},{"literal_text_all_w_t_and_m_t":"TAT value for CG-SDT as specified in TS 38.321 [3]. The network always configures this field when sdt-MAC-PHY-CG-Config is configured.","paragraph_zero_based":642},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":643},{"literal_text_all_w_t_and_m_t":"CG-SDT-ConfigLCH-Restriction field descriptions","paragraph_zero_based":644},{"literal_text_all_w_t_and_m_t":"allowedCG-List","paragraph_zero_based":645},{"literal_text_all_w_t_and_m_t":"This restriction applies only when the UL grant is a configured grant for CG-SDT. If present, UL MAC SDUs from this logical channel can only be mapped to the indicated CG-SDT configured grant configuration. If the size of the sequence is zero, then UL MAC SDUs from this logical channel cannot be mapped to any CG-SDT configured grant configurations. If the field is not present, UL MAC SDUs from this logical channel can be mapped to any CG-SDT configured grant configurations. If the field configuredGrantType1Allowed is present, only those CG-SDT configured grant type 1 configurations indicated in this sequence are allowed for use by this logical channel; otherwise, this sequence shall not include any CG-SDT configured grant type 1 configuration. Corresponds to \"allowedCG-List\" as specified in TS 38.321 [3].","paragraph_zero_based":646},{"literal_text_all_w_t_and_m_t":"configuredGrantType1Allowed","paragraph_zero_based":647}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"17bfba3da8c3743440a94764df1dd7e80753d504abfaf5e795d5a1c67c51ffac","original_member_sha256":"812d8433d8c47117aecae37ff5db028576123736cb57689623cc95ade6d2faf9","paragraph_ElementTree_utf8_XML_sha256":["6cfe3d180ddebf1279f540c3e24d6fa457c4efcb9a94bdec17976b2ff8e28c1e","b8165bb9ed965beda1b13f82ab6e10ffcf6c6b8cbf075ce41b43281677badbbf","e54813479b5db873db50db9e45b759b8b7d81dc3cbb5336e4b0fb2f049188459","221d71787ca282ee56d559394974e4553b91fdc75ce0f57dccdd1d9bd6d70a35","17997f62d2e14c3a6f4bf3d076fc37c5ba09f113981bac64ccfd671d269d8545","ee16577fdb4c4a6f300791e619056df489659f355fd7121b0265f8c2e5a60deb","c73f88a6ac8c22e4ede15a81b669aa77c52b557a8d1c30af2bfd902c45a82961","ba8ce1eec665b70857e3f4da650d3fcef59c585f313ff454b5ee26a9379a68ab","524e831852083218a7001f0a543323e93113422979eab282e118f0ff4a330568","b7d5fbf869a6930045822147761fe24625bb5c667fe09ae8ab637e1051f72e1e","5ef512b5f70e73680a272ac1914bfe87f050f0a57350d9feda0a9e02d0e67456","6c316a74281c1d7fd0a54dc57419ab362fdb648974dd2814c722db049fb5f964","5d999e82640c0419cee1810c988a315c3c428f1497b251eb6cf57782136ef071","80d195b518c3216897756c9111088958eb62c93647f9348b57aff6d8b692f1bd","f7df200a64a92a70e2394186f2cf42657ffc0d3cd199836f3c5c794593a1f86a","09981f868f8f1ed38da25ae802a0e7bbc63e90b2eeb88d891323e2fe1a2d3f87","06c189133e4b99d790b873801565d5552e79e9a5b7853a0f8e4567c2c9cc1ae5","644eef85a23b567bd7622aa5eb7cbf702219f7bf4e4abe12a57d801eda4d2e46","d23f92ba1f0b0291f96b6170508f1239a11f613ff46adcb8509c3391df3d329b","7e6b2f27f043d376df6e1511893dbf84c8fe5952b50cd6169ffe865c2132a8cc","6b39f9a01dd21583bfaa9b044cba48aa70b7ae31242fbbb7c196277786691f27","3c0a84a996015034ad76bf09c6568a07302c0eec6a38e554308af8f80fe6a213","5059c235e1c7cab2b6a485b95380a00dd01cd4b0425d0dbcd624e67785ee76e5","5df89ef8e027297848277520b1cb51dd0c1c03a16845795bc455efd56fe0370b"],"paragraph_range_zero_based":[624,647],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313652.zip::R2-2313652 TEI18 SDT_ReleaseEnh 38331 CR.docx:p624"}
{"fields":{"filename":"R2-2313652.zip::R2-2313652 TEI18 SDT_ReleaseEnh 38331 CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"If present, or if the capability lcp-Restriction as specified in TS 38.306 [26] is not supported, UL MAC SDUs from this logical channel can be transmitted on a configured grant type 1 for CG-SDT. Otherwise, UL MAC SDUs from this logical channel cannot be transmitted on a configured grant type 1 for CG-SDT. Corresponds to \"configuredGrantType1Allowed\" in TS 38.321 [3].","paragraph_zero_based":648},{"literal_text_all_w_t_and_m_t":"logicalChannelIdentity","paragraph_zero_based":649},{"literal_text_all_w_t_and_m_t":"ID used commonly for the MAC logical channel and for the RLC bearer associated with a servedRadioBearer configured for SDT.","paragraph_zero_based":650},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":651},{"literal_text_all_w_t_and_m_t":"CG-SDT-TA-ValidationConfig field descriptions","paragraph_zero_based":652},{"literal_text_all_w_t_and_m_t":"cg-SDT-RSRP-ChangeThreshold","paragraph_zero_based":653},{"literal_text_all_w_t_and_m_t":"The RSRP threshold for TA validation for CG-SDT as specified in TS 38.321 [3]. Value dB2 corresponds to 2 dB, value dB4 corresponds to 4 dB and so on.","paragraph_zero_based":654},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":655},{"literal_text_all_w_t_and_m_t":"SRS-PosRRC-InactiveConfig field descriptions","paragraph_zero_based":656},{"literal_text_all_w_t_and_m_t":"bwp-NUL","paragraph_zero_based":657},{"literal_text_all_w_t_and_m_t":"BWP configuration for SRS for Positioning during the RRC_INACTIVE state in Normal Uplink Carrier. If the field is absent UE is configured with an SRS for Positioning associated with the initial UL BWP and transmitted, during the RRC_INACTIVE state, inside the initial UL BWP with the same CP and SCS as configured for initial UL BWP.","paragraph_zero_based":658},{"literal_text_all_w_t_and_m_t":"bwp-SUL","paragraph_zero_based":659},{"literal_text_all_w_t_and_m_t":"BWP configuration for SRS for Positioning during the RRC_INACTIVE state in Supplementary Uplink Carrier. If the field is absent UE is configured with an SRS for Positioning associated with the initial UL BWP and transmitted, during the RRC_INACTIVE state, inside the initial UL BWP with the same CP and SCS as configured for initial UL BWP.","paragraph_zero_based":660},{"literal_text_all_w_t_and_m_t":"inactivePosSRS-RSRP-ChangeThreshold","paragraph_zero_based":661},{"literal_text_all_w_t_and_m_t":"RSRP threshold for the increase/decrease of RSRP for time alignment validation as specified in TS 38.321 [3].","paragraph_zero_based":662},{"literal_text_all_w_t_and_m_t":"inactivePosSRS-TimeAlignmentTimer","paragraph_zero_based":663},{"literal_text_all_w_t_and_m_t":"TAT value for SRS for positioning transmission during RRC_INACTIVE state as specified in TS 38.321 [3]. The network always configures this field when srs-PosRRC-Inactive is configured.","paragraph_zero_based":664},{"literal_text_all_w_t_and_m_t":"srs-PosConfigNUL","paragraph_zero_based":665},{"literal_text_all_w_t_and_m_t":"SRS for Positioning configuration in RRC_INACTIVE state in Normal Uplink Carrier.","paragraph_zero_based":666},{"literal_text_all_w_t_and_m_t":"srs-PosConfigSUL","paragraph_zero_based":667},{"literal_text_all_w_t_and_m_t":"SRS for Positioning configuration in RRC_INACTIVE state in Supplementary Uplink Carrier.","paragraph_zero_based":668},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":669},{"literal_text_all_w_t_and_m_t":"SuspendConfig field descriptions","paragraph_zero_based":670},{"literal_text_all_w_t_and_m_t":"ncd-SSB-RedCapInitialBWP-SDT","paragraph_zero_based":671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"17bfba3da8c3743440a94764df1dd7e80753d504abfaf5e795d5a1c67c51ffac","original_member_sha256":"812d8433d8c47117aecae37ff5db028576123736cb57689623cc95ade6d2faf9","paragraph_ElementTree_utf8_XML_sha256":["5300fb16d4ae3428163455a63be0b7518e35499592c5a1601e56cd263379381d","2f2a5c6a7a57e1152ad7d25349e88bbe9e65894e8f3d30870bdfb35c4786b189","34b7996b1e07b03137fdeada343be84dbe69c190f0e40f53f6c392c6959fa63e","0fedd07d62f90108b69da97a98eedf5068c2168475ab28ae05f994c8e265ba1a","be0e4c8359afc1202c761a1d1b80440e8430447c8695cb874e6f0e47c48b5545","f39b091306de22c5681d970cded605f947507ca887026b04aca6872979366dc6","7693981b5208d7915999f454caa75f595976ef9c3e0cf00cb9ecc5aee0bed956","f2cba173436204d2a7ea1964cf290720272733f24f3cc52e94e69e2a3226898f","4e0ef61c15bd864686fd50b77eb27ab4207c45cc4c00ad958f0d4fa2ea9c7b9f","9f178accc4a12a46da4192ddcd6e79b41e542a1656e82da9247a370a88962560","695feb3aeff18f61d4cbeb4d5db55f58629f511be62451225f44f2adeb7f0371","7b14e5cc7319e397e722a9fcf23efade167e74fba667342f68c0642b43a63d69","dd0d14b6ecbf994dcaa5c4fb80124930a7d3ce5305ff137ca7298daa4696137a","71369588f0758bffffa206a971c046b3bfb34dec60534fd2238acfafde5dcb6e","4fedb1888af00f2017878ee43b6f7da7aa3f54da20240dea3be6e2232b6e0037","a17d59a392a1bb548e22f94e2949ab56b7bd106406fe1d554b93cac12ce893b7","8b42459721286bd21eb58bd6b1988b17a2a0697ee13c2a353cf1d2784a4cae7a","12cdb8f9d48ce9f139e1c86dc1add87b34003d4ee3c88c9fafd06fa9fab4a84a","ea40745f5c8c41b955c0e581ac3edb8f95301ebdc6c660c50afc77d5f689f956","e3904d60de4a8a7c051bed60242d2d53bcf52eca8ce512cc78968ace1d8f1618","d23c46eb472af1c999ab234736eae8ebdd04fb43fe1b5c5ef1e953288ee012a5","0e2325c22b608b33f2aff0d3f34d1eb289e5859a5fcea2daf1e023f1f4de1b92","f7a120d99b3ea086d493e940cf5c3d93907b27fc711d7d62acc6e0da25cf0961","c88dd8c3d3027445dcc43bc469f5ab98546c0355f439069ebaf65bee41264464"],"paragraph_range_zero_based":[648,671],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313652.zip::R2-2313652 TEI18 SDT_ReleaseEnh 38331 CR.docx:p648"}
{"fields":{"filename":"R2-2313652.zip::R2-2313652 TEI18 SDT_ReleaseEnh 38331 CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates that the UE uses the RedCap-specific initial DL BWP associated with the NCD-SSB for SDT. The network configures this field if a RedCap UE is configured with SDT in the RedCap-specific initial DL BWP not associated with CD-SSB. If configured, the NCD-SSB indicated by this field can only be used during the SDT procedure for CG-SDT or RA-SDT.","paragraph_zero_based":672},{"literal_text_all_w_t_and_m_t":"ran-ExtendedPagingCycle","paragraph_zero_based":673},{"literal_text_all_w_t_and_m_t":"The extended DRX (eDRX) cycle for RAN-initiated paging to be applied by the UE. Value rf256 corresponds to 256 radio frames, value rf512 corresponds to 512 radio frames and so on. Value of the field indicates an eDRX cycle which is shorter or equal to the IDLE mode eDRX cycle configured for the UE.","paragraph_zero_based":674},{"literal_text_all_w_t_and_m_t":"ran-NotificationAreaInfo","paragraph_zero_based":675},{"literal_text_all_w_t_and_m_t":"Network ensures that the UE in RRC_INACTIVE always has a valid ran-NotificationAreaInfo.","paragraph_zero_based":676},{"literal_text_all_w_t_and_m_t":"ran-PagingCycle","paragraph_zero_based":677},{"literal_text_all_w_t_and_m_t":"Refers to the UE specific cycle for RAN-initiated paging. Value rf32 corresponds to 32 radio frames, value rf64 corresponds to 64 radio frames and so on.","paragraph_zero_based":678},{"literal_text_all_w_t_and_m_t":"resumeIndication","paragraph_zero_based":679},{"literal_text_all_w_t_and_m_t":"Indicates that the UE shall trigger the RRC connection resume procedure after receiving this RRCRelease message, as specified in section 5.3.8.3. The network only includes this field in the RRCRelease message used to terminate an ongoing SDT procedure.","paragraph_zero_based":680},{"literal_text_all_w_t_and_m_t":"sl-UEIdentityRemote","paragraph_zero_based":681},{"literal_text_all_w_t_and_m_t":"Indicates the C-RNTI to the L2 U2N Remote UE.","paragraph_zero_based":682},{"literal_text_all_w_t_and_m_t":"t380","paragraph_zero_based":683},{"literal_text_all_w_t_and_m_t":"Refers to the timer that triggers the periodic RNAU procedure in UE. Value min5 corresponds to 5 minutes, value min10 corresponds to 10 minutes and so on.","paragraph_zero_based":684},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":685},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":686},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":687},{"literal_text_all_w_t_and_m_t":"L2RemoteUE","paragraph_zero_based":688},{"literal_text_all_w_t_and_m_t":"The field is mandatory present for L2 U2N Remote UE's RNAU; otherwise it is absent.","paragraph_zero_based":689},{"literal_text_all_w_t_and_m_t":"RANPaging","paragraph_zero_based":690},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, if the UE is configured with IDLE eDRX, see TS 24.501 [23]; otherwise the field is not present.","paragraph_zero_based":691},{"literal_text_all_w_t_and_m_t":"Redirection2","paragraph_zero_based":692},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if redirectedCarrierInfo is included; otherwise the field is not present.","paragraph_zero_based":693},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":694}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"17bfba3da8c3743440a94764df1dd7e80753d504abfaf5e795d5a1c67c51ffac","original_member_sha256":"812d8433d8c47117aecae37ff5db028576123736cb57689623cc95ade6d2faf9","paragraph_ElementTree_utf8_XML_sha256":["bd1704cbafa38bc54321f8c502fb4576bc7207afce06f1415d9f544bc74cd3aa","83dcfe109911e16fdfcfcdd336b8f1b52c69280c59fd7866fd46f9abb36b7e37","e7c44c9b52ac19259852012da6f55ba768927b655d9374b