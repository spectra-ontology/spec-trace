{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ScramblingId ::=                    INTEGER(0..1023)","paragraph_zero_based":26736},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26737},{"literal_text_all_w_t_and_m_t":"-- TAG-SCRAMBLINGID-STOP","paragraph_zero_based":26738},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26739},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26740},{"literal_text_all_w_t_and_m_t":"–SCS-SpecificCarrier","paragraph_zero_based":26741},{"literal_text_all_w_t_and_m_t":"The IE SCS-SpecificCarrier provides parameters determining the location and width of the actual carrier or the carrier bandwidth. It is defined specifically for a numerology (subcarrier spacing (SCS)) and in relation (frequency offset) to Point A.","paragraph_zero_based":26742},{"literal_text_all_w_t_and_m_t":"SCS-SpecificCarrier information element","paragraph_zero_based":26743},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26744},{"literal_text_all_w_t_and_m_t":"-- TAG-SCS-SPECIFICCARRIER-START","paragraph_zero_based":26745},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26746},{"literal_text_all_w_t_and_m_t":"SCS-SpecificCarrier ::=             SEQUENCE {","paragraph_zero_based":26747},{"literal_text_all_w_t_and_m_t":"    offsetToCarrier                     INTEGER (0..2199),","paragraph_zero_based":26748},{"literal_text_all_w_t_and_m_t":"    subcarrierSpacing                   SubcarrierSpacing,","paragraph_zero_based":26749},{"literal_text_all_w_t_and_m_t":"    carrierBandwidth                    INTEGER (1..maxNrofPhysicalResourceBlocks),","paragraph_zero_based":26750},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":26751},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":26752},{"literal_text_all_w_t_and_m_t":"    txDirectCurrentLocation         INTEGER (0..4095)                                       OPTIONAL            -- Need S","paragraph_zero_based":26753},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":26754},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":26755},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26756},{"literal_text_all_w_t_and_m_t":"-- TAG-SCS-SPECIFICCARRIER-STOP","paragraph_zero_based":26757},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26758},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26759}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["e879d927d2d5748ebeef2c5ac28bf71af2ca1321a2d1313079da25de0ef28f25","c96e35611d05afcc4532dc31a700c17ed2129c3436a7d1700b470edfc1a76073","b32cb798ae326e4a979596332ece6909d413d1c3f754020a78393de312f790d6","0a2ca292d818bb15405fc4591988e3baee91e8e385cfeb24be4fb71902795625","5bdf3e01224a2b2fa3ea75c4c60d7257b62e97df6ac6f284f030068be87905f1","9546c5086289db14ba6ac53db3ac52f5bfdaff9ad2ebd59c214b0e12f1fac2ce","53936d2370d9d28319d623e4f6de90a59729edae62556eea09b480fd6c69112d","15ffaf52387f7441248c26a226ab8d9f4370afb63767e0c013c087fc8e6c476c","f5f4d141e274f2f4132fa8ccfe288d8307375b066bd999f8b46bfc146ad7c6ee","786f9f54e92b5b65d11b10eb43137b8bfde35f7f2568224d1567361451e43ac1","dacdd6caa182b89c3666f92a6a990456f68492b095bf93b618819c53d08e9822","6125221b9f40fd3a209797b857a45187223fb8fd3790f6544112af527b90d0cd","f347c81f409e602b05abd62fc762230a8af74fccb85dd2829a349d185233551c","8846946bbf8c2c607d10d1c8448f53e55a1c3497ebe9ac5d5608b50b710d7bee","207aa9d46d102c145f21b8fcd1ec21dffe1dd955d3558deb8920e567201bfe89","e4f9b9420e5a79bbb7cb9329d0d987c8c995c342d7a7a341084603fddf06b13c","233b38799446675f0decf55797484ed53ee8406dfa1399b08157e33fe1f5e8e4","0e65277c1c6ce01750022e1838b797d20567d376fab028b27b7f498b783509eb","128ddac9bfc127079fc9500131332c96584db5fbe620efc0f1ed0a498d37f177","0e803f1f833dbdc2800e93b8dfc0ce624ee8c0e87c5e5ebaf7288d9addb4f95d","ada6598ea02cad9504b26cae66ec91ec0cd53e2284936ffb549004592993405d","8c3cc158aafda3152287a5d8c25754243246ce72aa44ba54102087150383068d","d3a3453e81baae5608366037867a7418f732c73874ae70e214e706de2f275af8","497db08d806e759547b5b7108435f63b67edab9b8c40fc3150712b661c69064d"],"paragraph_range_zero_based":[26736,26759],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p26736"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SCS-SpecificCarrier field descriptions","paragraph_zero_based":26760},{"literal_text_all_w_t_and_m_t":"carrierBandwidth","paragraph_zero_based":26761},{"literal_text_all_w_t_and_m_t":"Width of this carrier in number of PRBs (using the subcarrierSpacing defined for this carrier) (see TS 38.211 [16], clause 4.4.2).","paragraph_zero_based":26762},{"literal_text_all_w_t_and_m_t":"offsetToCarrier","paragraph_zero_based":26763},{"literal_text_all_w_t_and_m_t":"Offset in frequency domain between Point A (lowest subcarrier of common RB 0) and the lowest usable subcarrier on this carrier in number of PRBs (using the subcarrierSpacing defined for this carrier). The maximum value corresponds to 275*8-1. See TS 38.211 [16], clause 4.4.2.","paragraph_zero_based":26764},{"literal_text_all_w_t_and_m_t":"txDirectCurrentLocation","paragraph_zero_based":26765},{"literal_text_all_w_t_and_m_t":"Indicates the downlink Tx Direct Current location for the carrier. A value in the range 0..3299 indicates the subcarrier index within the carrier. The values in the value range 3301..4095 are reserved and ignored by the UE. If this field is absent for downlink within ServingCellConfigCommon and ServingCellConfigCommonSIB, the UE assumes the default value of 3300 (i.e. \"Outside the carrier\"). (see TS 38.211 [16], clause 4.4.2). Network does not configure this field via ServingCellConfig or for uplink carriers.","paragraph_zero_based":26766},{"literal_text_all_w_t_and_m_t":"subcarrierSpacing","paragraph_zero_based":26767},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing of this carrier. It is used to convert the offsetToCarrier into an actual frequency.","paragraph_zero_based":26768},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":26769},{"literal_text_all_w_t_and_m_t":"FR1:    15 or 30 kHz","paragraph_zero_based":26770},{"literal_text_all_w_t_and_m_t":"FR2-1:  60 or 120 kHz","paragraph_zero_based":26771},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":26772},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26773},{"literal_text_all_w_t_and_m_t":"–SDAP-Config","paragraph_zero_based":26774},{"literal_text_all_w_t_and_m_t":"The IE SDAP-Config is used to set the configurable SDAP parameters for a data radio bearer. All configured instances of SDAP-Config with the same value of pdu-Session correspond to the same SDAP entity as specified in TS 37.324 [24].","paragraph_zero_based":26775},{"literal_text_all_w_t_and_m_t":"SDAP-Config information element","paragraph_zero_based":26776},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26777},{"literal_text_all_w_t_and_m_t":"-- TAG-SDAP-CONFIG-START","paragraph_zero_based":26778},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26779},{"literal_text_all_w_t_and_m_t":"SDAP-Config ::=                     SEQUENCE {","paragraph_zero_based":26780},{"literal_text_all_w_t_and_m_t":"    pdu-Session                         PDU-SessionID,","paragraph_zero_based":26781},{"literal_text_all_w_t_and_m_t":"    sdap-HeaderDL                       ENUMERATED {present, absent},","paragraph_zero_based":26782},{"literal_text_all_w_t_and_m_t":"    sdap-HeaderUL                       ENUMERATED {present, absent},","paragraph_zero_based":26783}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["d1618af2b26fe35bf9f1eb09b6682a4253b3693bb34ecaa7de026c58c131b7f7","299993a075458074822bc07936aee856c866f874b136fc1d05b25bca12c731f6","59da520123c9eaa06150a7eec484b4d7b7759b8a167865c5dfc310863bd455d6","750e4ac7e798166a4c53aa95f0acae7f79a074278a6a133e3ea47a6723eead61","6bbc3b508cacd6d786d45c23d09422c0c974c390d67942389b8f34ca74b23401","6ad9001106e065de94a752371f61ca785418f8badb0b1f99394a798ff7d83d8c","f21b1265dea5196324cc04c7401ce0ae7d696579677abe51a600047557168c1a","c6212b14e2c08a89c936e96214ea98c00631ed7ce91c9fa35c133856c13c3847","55bad700ba5f05faf5a11d4483a1ad2e546a7edceb2eb24ed7606d61156c6fd9","e68dfa301cfa34c31c97d1bb819549a5b9203b30375c0f8762feb91dbbfe4b7b","d5410bda6327873996dd18d1c55cb5ad2acb0bdcf4671e1fd6a6cd3c2b813c3e","c42ec2b597558192359487f8d618fbe149ff8f047ed0469f447745c7a898df62","5018567c8ef377fdcb43374c298f23b4d23ca2afb1a3927818d73d68b239e643","ce951e9583724bfd52e2b765f381d4409a6c33c0e751add8ed513b664b74a42c","d30bfdbc0467c09ca3f42c240d3ec13d716bd28921fd0f92ac25a31abe75e8ab","46d9aab8f8b99b437e80e5ff276b3a245e12db97e2a9e7d8d15648ebf98fe65e","65853b2c10675a004d1b361a7c6a79b5650e8a9b7577dcdbebe655ce9625af19","1c25963c213202379fba43fbc037f677317348a56cd963153268758c4f4dbc06","a505fe04be2b197f60be235ef1444bb8d2ce08ef3b17573f86726a4ff9034b8f","8be18bd802910afe59547bb448961def8caec50cf8d1ecee8fdab10f17ada0a5","0506038f47b5e56b4e3d76d460b4fed6e05aa7ae5d1c6bbbb8311c79e59b5b2e","d32ea5f29d6b0b66250fcbe703b79ee5a6b531e783195c28420a9e7716b03e32","3965c3cd1981efaaa7c3ee87653302aa90babb0a705657f97fb6b7c0739b536a","ea8b1246b8aed64a04d8b5443a3dd8370f271c9b642b92d83b5ed7068afd4d9a"],"paragraph_range_zero_based":[26760,26783],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p26760"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    defaultDRB                          BOOLEAN,","paragraph_zero_based":26784},{"literal_text_all_w_t_and_m_t":"    mappedQoS-FlowsToAdd                SEQUENCE (SIZE (1..maxNrofQFIs)) OF QFI                                 OPTIONAL, -- Need N","paragraph_zero_based":26785},{"literal_text_all_w_t_and_m_t":"    mappedQoS-FlowsToRelease            SEQUENCE (SIZE (1..maxNrofQFIs)) OF QFI                                 OPTIONAL, -- Need N","paragraph_zero_based":26786},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":26787},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":26788},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26789},{"literal_text_all_w_t_and_m_t":"QFI ::=                             INTEGER (0..maxQFI)","paragraph_zero_based":26790},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26791},{"literal_text_all_w_t_and_m_t":"PDU-SessionID ::=                   INTEGER (0..255)","paragraph_zero_based":26792},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26793},{"literal_text_all_w_t_and_m_t":"-- TAG-SDAP-CONFIG-STOP","paragraph_zero_based":26794},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26795},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26796},{"literal_text_all_w_t_and_m_t":"SDAP-Config field descriptions","paragraph_zero_based":26797},{"literal_text_all_w_t_and_m_t":"defaultDRB","paragraph_zero_based":26798},{"literal_text_all_w_t_and_m_t":"Indicates whether or not this is the default DRB for this PDU session. Among all configured instances of SDAP-Config with the same value of pdu-Session, this field shall be set to true in at most one instance of SDAP-Config and to false in all other instances.","paragraph_zero_based":26799},{"literal_text_all_w_t_and_m_t":"mappedQoS-FlowsToAdd","paragraph_zero_based":26800},{"literal_text_all_w_t_and_m_t":"Indicates the list of QFIs of UL QoS flows of the PDU session to be additionally mapped to this DRB. A QFI value can be included at most once in all configured instances of SDAP-Config with the same value of pdu-Session. For QoS flow remapping, the QFI value of the remapped QoS flow is only included in mappedQoS-FlowsToAdd in sdap-Config corresponding to the new DRB and not included in mappedQoS-FlowsToRelease in sdap-Config corresponding to the old DRB.","paragraph_zero_based":26801},{"literal_text_all_w_t_and_m_t":"mappedQoS-FlowsToRelease","paragraph_zero_based":26802},{"literal_text_all_w_t_and_m_t":"Indicates the list of QFIs of QoS flows of the PDU session to be released from existing QoS flow to DRB mapping of this DRB. ","paragraph_zero_based":26803},{"literal_text_all_w_t_and_m_t":"pdu-Session","paragraph_zero_based":26804},{"literal_text_all_w_t_and_m_t":"Identity of the PDU session whose QoS flows are mapped to the DRB.","paragraph_zero_based":26805},{"literal_text_all_w_t_and_m_t":"sdap-HeaderUL","paragraph_zero_based":26806},{"literal_text_all_w_t_and_m_t":"Indicates whether or not a SDAP header is present for UL data on this DRB. The field cannot be changed after a DRB is established. The network sets this field to present if the field defaultDRB is set to true.","paragraph_zero_based":26807}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["f91332f01d928c0bfb94f462393fe8adb33fe4ac5c02fc8978b05d88f455e2dd","e04e4b4eb783345b2288a4f9e6aa920862bc7143a9104c3d879a240386d44151","90ebf8f4c820598ae78089003c7f333d522aebf89b3fe9de6ca99645faece035","103e432fb83a09ba226d711c20afa