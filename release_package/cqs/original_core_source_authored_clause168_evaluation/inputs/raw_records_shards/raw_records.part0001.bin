{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"musim-Starting-SFN-AndSubframe","paragraph_zero_based":20928},{"literal_text_all_w_t_and_m_t":"Indicates gap starting position for the aperiodic MUSIM gap. This field is optionally present for the aperiodic MUSIM gap preference indication.","paragraph_zero_based":20929},{"literal_text_all_w_t_and_m_t":"starting-SFN","paragraph_zero_based":20930},{"literal_text_all_w_t_and_m_t":"Indicates gap starting SFN number for the aperiodic MUSIM gap.","paragraph_zero_based":20931},{"literal_text_all_w_t_and_m_t":"startingSubframe","paragraph_zero_based":20932},{"literal_text_all_w_t_and_m_t":"Indicates gap starting subframe number for the aperiodic MUSIM gap.","paragraph_zero_based":20933},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20934},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":20935},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":20936},{"literal_text_all_w_t_and_m_t":"aperiodic","paragraph_zero_based":20937},{"literal_text_all_w_t_and_m_t":"This field is mandatory present in case of aperiodic MUSIM gap configuration. Otherwise it is absent.","paragraph_zero_based":20938},{"literal_text_all_w_t_and_m_t":"gapSetup","paragraph_zero_based":20939},{"literal_text_all_w_t_and_m_t":"The field is mandatory present upon configuration of a new MUSIM gap. The field is optionally present, Need M, otherwise.","paragraph_zero_based":20940},{"literal_text_all_w_t_and_m_t":"periodic","paragraph_zero_based":20941},{"literal_text_all_w_t_and_m_t":"This field is mandatory present in case of periodic MUSIM gap configuration. Otherwise it is absent.","paragraph_zero_based":20942},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20943},{"literal_text_all_w_t_and_m_t":"–NeedForGapsConfigNR","paragraph_zero_based":20944},{"literal_text_all_w_t_and_m_t":"The IE NeedForGapsConfigNR contains configuration related to the reporting of measurement gap requirement information.","paragraph_zero_based":20945},{"literal_text_all_w_t_and_m_t":"NeedForGapsConfigNR information element","paragraph_zero_based":20946},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":20947},{"literal_text_all_w_t_and_m_t":"-- TAG-NeedForGapsConfigNR-START","paragraph_zero_based":20948},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20949},{"literal_text_all_w_t_and_m_t":"NeedForGapsConfigNR-r16 ::=        SEQUENCE {","paragraph_zero_based":20950},{"literal_text_all_w_t_and_m_t":"    requestedTargetBandFilterNR-r16       SEQUENCE (SIZE (1..maxBands)) OF FreqBandIndicatorNR               OPTIONAL          -- Need R","paragraph_zero_based":20951}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["935f948d9d102724a3d14acfdcf27fd3ed061d9dcf10c39eca23ec8bcb4c41d4","623401189a2df145c83ae2ed190b13f18d29554855134cb3ecb5e59ffd90cab6","26a152f512b550c54f596a1387e0a5dbfc208b9bf720e90a4e5df289376d3918","a96f807682b0f3f021b8b405ec1cfcb2b50e8cac2459d7a22e429958c3f64b9b","48f81a2d2cba356cfb2e4c5669090775c221646093bd07e46b0ca8fefacd5e2b","956cb2ee4c8ff27d117f97ebd48d6faf57eb901df23fdfcdf66e299771761a42","a16e2b7f7b268df591d78dfad8ebf7428181b28e7ec41cc504eb9489ff38da0b","823774d67cd6ba58ae8f61ca654028750576b11ffe60ab07a03aa0b506acd3d4","5c5dbc2b2f241d5d681ec2aa7c47a853dab82e87cf1d5584a7a35a491c95d3b5","c3d36d59833d699f99409e5ea5494ddead4d562be8c96f6866d1bf4ec94d968b","719a9ce39a3a90b07a41ba5f6d4897e0f199238026f165727a4b38fb825ede13","fa1c88bf73ac2392ac1d8a5eedf806daadbc925c3f92acfb716b2bb41aad29f9","