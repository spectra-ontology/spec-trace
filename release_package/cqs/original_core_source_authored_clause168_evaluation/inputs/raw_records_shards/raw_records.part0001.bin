fa02dddfacfafb20ac526c101ed4a085036c4a3c1493278a708225b","2aa92607367fa9c52e3b504c8d42fbeb26282373c87b32ae728bd91803069d47","b2b02076ab4b7727f79f1e4e00e111438e549fdb5f566925202a7add90346336","35fef6d2665a620d43c5890b37e86e5eab70e68393fa03a7f37d584e068146b1","fff64ee01720ce42a99d20ff8316185417fcc84031333da74cbfb20e992315b7","e650ed9f48072f62f5f68387d15e7e742d47e21b262512c698dd3bcebbada007","4f3441ad78903b25815b100a9a40acd8b42014561c7f1953e92daa919afb974f"],"paragraph_range_zero_based":[23376,23399],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p23376"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    timeDensity                         SEQUENCE (SIZE (3)) OF INTEGER (0..29)                                  OPTIONAL,   -- Need S","paragraph_zero_based":23400},{"literal_text_all_w_t_and_m_t":"    epre-Ratio                          INTEGER (0..3)                                                          OPTIONAL,   -- Need S","paragraph_zero_based":23401},{"literal_text_all_w_t_and_m_t":"    resourceElementOffset               ENUMERATED { offset01, offset10, offset11 }                             OPTIONAL,   -- Need S","paragraph_zero_based":23402},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":23403},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":23404},{"literal_text_all_w_t_and_m_t":"    maxNrofPorts-r16                    ENUMERATED {n1, n2}                                                     OPTIONAL    -- Need R","paragraph_zero_based":23405},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":23406},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23407},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":23408},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23409},{"literal_text_all_w_t_and_m_t":"-- TAG-PTRS-DOWNLINKCONFIG-STOP","paragraph_zero_based":23410},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23411},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23412},{"literal_text_all_w_t_and_m_t":"PTRS-DownlinkConfig field descriptions","paragraph_zero_based":23413},{"literal_text_all_w_t_and_m_t":"epre-Ratio","paragraph_zero_based":23414},{"literal_text_all_w_t_and_m_t":"EPRE ratio between PTRS and PDSCH. Value 0 corresponds to the codepoint \"00\" in table 4.1-2. Value 1 corresponds to codepoint \"01\", and so on. If the field is not provided, the UE applies value 0 (see TS 38.214 [19], clause 4.1).","paragraph_zero_based":23415},{"literal_text_all_w_t_and_m_t":"frequencyDensity","paragraph_zero_based":23416},{"literal_text_all_w_t_and_m_t":"Presence and frequency density of DL PT-RS as a function of Scheduled BW. If the field is absent, the UE uses K_PT-RS = 2 (see TS 38.214 [19], clause 5.1.6.3, table 5.1.6.3-2).","paragraph_zero_based":23417},{"literal_text_all_w_t_and_m_t":"maxNrofPorts","paragraph_zero_based":23418},{"literal_text_all_w_t_and_m_t":"The maximum number of DL PTRS ports specified in TS 38.214 [19] (clause 5.1.6.3). 2 PT-RS ports can only be configured for a DL BWP that is configured, as specified in TS 38.214 [19] clause 5.1, with a mode where a single PDSCH has association between the DM-RS ports and the TCI states as defined in TS 38.214 [19] clause 5.1.6.2.","paragraph_zero_based":23419},{"literal_text_all_w_t_and_m_t":"resourceElementOffset","paragraph_zero_based":23420},{"literal_text_all_w_t_and_m_t":"Indicates the subcarrier offset for DL PTRS. If the field is absent, the UE applies the value offset00 (see TS 38.211 [16], clause 7.4.1.2.2).","paragraph_zero_based":23421},{"literal_text_all_w_t_and_m_t":"timeDensity","paragraph_zero_based":23422},{"literal_text_all_w_t_and_m_t":"Presence and time density of DL PT-RS as a function of MCS. The value 29 is only applicable for MCS Table 5.1.3.1-1 (TS 38.214 [19]). If the field is absent, the UE uses L_PT-RS = 1 (see TS 38.214 [19], clause 5.1.6.3, table 5.1.6.3-1).","paragraph_zero_based":23423}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["7298d1a7921f3cd6b63a5ddc48bc4b082adb115663e2c316556e5186f4bde3ac","a4df4289b8b141782c8838a13b848dd2e7d67