{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"T346a (The UE maintains one instance of this timer per cell group)","paragraph_zero_based":40920},{"literal_text_all_w_t_and_m_t":"Upon transmitting UEAssistanceInformation message with drx-Preference.","paragraph_zero_based":40921},{"literal_text_all_w_t_and_m_t":"Upon releasing drx-PreferenceConfig during the connection re-establishment/resume procedures, upon receiving drx-PreferenceConfig set to release, or upon performing MR-DC release.","paragraph_zero_based":40922},{"literal_text_all_w_t_and_m_t":"No action.","paragraph_zero_based":40923},{"literal_text_all_w_t_and_m_t":"T346b (The UE maintains one instance of this timer per cell group)","paragraph_zero_based":40924},{"literal_text_all_w_t_and_m_t":"Upon transmitting UEAssistanceInformation message with maxBW-Preference.","paragraph_zero_based":40925},{"literal_text_all_w_t_and_m_t":"Upon releasing maxBW-PreferenceConfig during the connection re-establishment/resume procedures, upon receiving maxBW-PreferenceConfig set to release, or upon performing MR-DC release.","paragraph_zero_based":40926},{"literal_text_all_w_t_and_m_t":"No action.","paragraph_zero_based":40927},{"literal_text_all_w_t_and_m_t":"T346c (The UE maintains one instance of this timer per cell group)","paragraph_zero_based":40928},{"literal_text_all_w_t_and_m_t":"Upon transmitting UEAssistanceInformation message with maxCC-Preference.","paragraph_zero_based":40929},{"literal_text_all_w_t_and_m_t":"Upon releasing maxCC-PreferenceConfig during the connection re-establishment/resume procedures, upon receiving maxCC-PreferenceConfig set to release, or upon performing MR-DC release.","paragraph_zero_based":40930},{"literal_text_all_w_t_and_m_t":"No action.","paragraph_zero_based":40931},{"literal_text_all_w_t_and_m_t":"T346d (The UE maintains one instance of this timer per cell group)","paragraph_zero_based":40932},{"literal_text_all_w_t_and_m_t":"Upon transmitting UEAssistanceInformation message with maxMIMO-LayerPreference.","paragraph_zero_based":40933},{"literal_text_all_w_t_and_m_t":"Upon releasing maxMIMO-LayerPreferenceConfig during the connection re-establishment/resume procedures, upon receiving maxMIMO-LayerPreferenceConfig set to release, or upon performing MR-DC release.","paragraph_zero_based":40934},{"literal_text_all_w_t_and_m_t":"No action.","paragraph_zero_based":40935},{"literal_text_all_w_t_and_m_t":"T346e (The UE maintains one instance of this timer per cell group)","paragraph_zero_based":40936},{"literal_text_all_w_t_and_m_t":"Upon transmitting UEAssistanceInformation message with minSchedulingOffsetPreference.","paragraph_zero_based":40937},{"literal_text_all_w_t_and_m_t":"Upon releasing minSchedulingOffsetPreferenceConfig during the connection re-establishment/resume procedures, upon receiving minSchedulingOffsetPreferenceConfig set to release, or upon performing MR-DC release.","paragraph_zero_based":40938},{"literal_text_all_w_t_and_m_t":"No action.","paragraph_zero_based":40939},{"literal_text_all_w_t_and_m_t":"T346f","paragraph_zero_based":40940},{"literal_text_all_w_t_and_m_t":"Upon transmitting UEAssistanceInformation message with releasePreference.","paragraph_zero_based":40941},{"literal_text_all_w_t_and_m_t":"Upon releasing releasePreferenceConfig during the connection re-establishment/resume procedures, or upon receiving releasePreferenceConfig set to release.","paragraph_zero_based":40942},{"literal_text_all_w_t_and_m_t":"No action.","paragraph_zero_based":40943}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","parag