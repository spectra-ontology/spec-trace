{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    sl-DRX-ConfigUC-r17                        SL-DRX-ConfigUC-r17                                                    OPTIONAL,     -- Need N","paragraph_zero_based":37944},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":37945},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37946},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37947},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-DRX-CONFIG-STOP","paragraph_zero_based":37948},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":37949},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37950},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37951},{"literal_text_all_w_t_and_m_t":"SL-DRX-Config field descriptions","paragraph_zero_based":37952},{"literal_text_all_w_t_and_m_t":"sl-DRX-ConfigGC-BC","paragraph_zero_based":37953},{"literal_text_all_w_t_and_m_t":"This field indicates the sidelink DRX configurations for groupcast and broadcast communication, as specified in TS 38.321 [3].","paragraph_zero_based":37954},{"literal_text_all_w_t_and_m_t":"sl-DRX-ConfigUC-ToReleaseList","paragraph_zero_based":37955},{"literal_text_all_w_t_and_m_t":"This field indicates the sidelink DRX configurations for corresponding unicast destinations to remove.","paragraph_zero_based":37956},{"literal_text_all_w_t_and_m_t":"sl-DRX-ConfigUC-ToAddModList","paragraph_zero_based":37957},{"literal_text_all_w_t_and_m_t":"This field indicates the sidelink DRX configurations for corresponding unicast destinations to add and/or modify.","paragraph_zero_based":37958},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37959},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":37960},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":37961},{"literal_text_all_w_t_and_m_t":"HO","paragraph_zero_based":37962},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need M, in an RRCReconfiguration message including reconfigurationWithSync; otherwise it is absent, Need M.","paragraph_zero_based":37963},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37964},{"literal_text_all_w_t_and_m_t":"–SL-DRX-ConfigGC-BC","paragraph_zero_based":37965},{"literal_text_all_w_t_and_m_t":"The IE SL-DRX-ConfigGC-BC is used to configure DRX related parameters for NR sidelink groupcast and broadcast communication, unicast/broadcast based communication of Direct Link Establishment Request (TS 24.587 [57]), and discovery message (TS 24.554 [72]).","paragraph_zero_based":37966},{"literal_text_all_w_t_and_m_t":"SL-DRX-ConfigGC-BC information element","paragraph_zero_based":37967}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["f1b148c08844736c26285e6fce76a89c6af3d66386e9840565ce32953346c90d","0045122dfe6795fdf669bc8b0fe00a895a9afe8d5abdd879888da057d2179302","3db1b0bd83d3360878b1d7d071c758f86328bc16eef53c6e4f107fd6001f58c0","d3e4b8b84e95ba45728031e5a52ed34f92dc712c0b6e61eb494f1bf8cd08d1d7","e4b9f7068080475435ef37cdd71ca2463f957ea52343cf040422bcdd5dec951f","39b6977b2b3a005fbf6c9c6dbd4d3f2b48829fc837a03bc98d6e79a95e04bc16","4df7c991a944d2f5b4a155e5e1cead70da128e24916e259ae629eff7472317d7","0e84f915c2a2c306a553e6ea00e412662c69c999d71b1609962487ebdaaab33a","6722621e618563fba73fcd71f3d5c5974cea69fddf17a05eb780829a59f9e0d3","78e8f0289212ac0132190ee59c4a30eff038515e97a620570eb6e36a918147fe","aee44b8712234a5be44cc56f23b8c32003d3be90775fb5cdb8c2ea13b50374c8","6fd362d472c49be407e83c2a79d448f1ecf7fac8879256edb112d4b0a5d34e1c","