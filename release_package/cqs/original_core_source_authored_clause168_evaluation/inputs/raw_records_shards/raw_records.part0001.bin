{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–CSI-ReportSubConfigId","paragraph_zero_based":17208},{"literal_text_all_w_t_and_m_t":"The IE CSI-ReportSubConfigId is used to indicate the index of one CSI-ReportSubConfig within a CSI report configuration.","paragraph_zero_based":17209},{"literal_text_all_w_t_and_m_t":"CSI-ReportSubConfigId information element","paragraph_zero_based":17210},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17211},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-REPORTSUBCONFIGID-START","paragraph_zero_based":17212},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17213},{"literal_text_all_w_t_and_m_t":"CSI-ReportSubConfigId-r18 ::=              INTEGER (0..maxNrofCSI-ReportSubconfigPerCSI-ReportConfig-1-r18)","paragraph_zero_based":17214},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17215},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-REPORTSUBCONFIGID-STOP","paragraph_zero_based":17216},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17217},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17218},{"literal_text_all_w_t_and_m_t":"–CSI-ReportSubConfigTriggerList","paragraph_zero_based":17219},{"literal_text_all_w_t_and_m_t":"The IE CSI-ReportSubConfigTriggerList is used to configure a list of sub-configuration ID(s) of N sub-configurations out of L configured sub-configurations within a CSI-ReportConfig associated with a triggering state for semi-persistent CSI reporting on PUSCH.","paragraph_zero_based":17220},{"literal_text_all_w_t_and_m_t":"CSI-ReportSubConfigTriggerList information element","paragraph_zero_based":17221},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17222},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-REPORTSUBCONFIGTRIGGERLIST-START","paragraph_zero_based":17223},{"literal_tex