{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-SL-CBR-PRIORITYTXCONFIGLIST-START","paragraph_zero_based":37248},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37249},{"literal_text_all_w_t_and_m_t":"SL-CBR-PriorityTxConfigList-r16 ::= SEQUENCE (SIZE (1..8)) OF SL-PriorityTxConfigIndex-r16","paragraph_zero_based":37250},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37251},{"literal_text_all_w_t_and_m_t":"SL-CBR-PriorityTxConfigList-v1650 ::= SEQUENCE (SIZE (1..8)) OF SL-PriorityTxConfigIndex-v1650","paragraph_zero_based":37252},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37253},{"literal_text_all_w_t_and_m_t":"SL-PriorityTxConfigIndex-r16 ::=    SEQUENCE {","paragraph_zero_based":37254},{"literal_text_all_w_t_and_m_t":"    sl-PriorityThreshold-r16             INTEGER (1..8)                                                   OPTIONAL,    -- Need M","paragraph_zero_based":37255},{"literal_text_all_w_t_and_m_t":"    sl-DefaultTxConfigIndex-r16          INTEGER (0..maxCBR-Level-1-r16)                                  OPTIONAL,    -- Need M","paragraph_zero_based":37256},{"literal_text_all_w_t_and_m_t":"    sl-CBR-ConfigIndex-r16               INTEGER (0..maxCBR-Config-1-r16)                                 OPTIONAL,    -- Need M","paragraph_zero_based":37257},{"literal_text_all_w_t_and_m_t":"    sl-Tx-ConfigIndexList-r16            SEQUENCE (SIZE (1.. maxCBR-Level-r16)) OF SL-TxConfigIndex-r16   OPTIONAL     -- Need M","paragraph_zero_based":37258},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37259},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37260},{"literal_text_all_w_t_and_m_t":"SL-PriorityTxConfigIndex-v1650 ::=  SEQUENCE {","paragraph_zero_based":37261},{"literal_text_all_w_t_and_m_t":"    sl-MCS-RangeList-r16                SEQUENCE (SIZE (1..maxCBR-Level-r16)) OF SL-MinMaxMCS-List-r16    OPTIONAL     -- Need M","paragraph_zero_based":37262},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37263},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37264},{"literal_text_all_w_t_and_m_t":"SL-TxConfigIndex-r16 ::=            INTEGER (0..maxTxConfig-1-r16)","paragraph_zero_based":37265},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37266},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-CBR-PRIORITYTXCONFIGLIST-STOP","paragraph_zero_based":37267},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":37268},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37269},{"literal_text_all_w_t_and_m_t":"SL-CBR-PriorityTxConfigList field descriptions","paragraph_zero_based":37270},{"literal_text_all_w_t_and_m_t":"sl-CBR-ConfigIndex","paragraph_zero_based":37271}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["e0993effa8de5621748abd68255a714780c0932eb65d32d243c46f85a9b7d7dd","fd693fcd71221b657cc3780a0f841b8569f2cde91290c8e67722cf0cbae2c355","2d02da734150e3209b8d1ce1a8e194821453a8c9d82508cd081913bfbad25a68","4899ce8544408c5f7c40480e39fc70139eda2361555af0b726d06ac6b2708c6b","6f1467d15819a0e2469aa53400c38d37ab3e40c69bc4a9b58e27df0de1fb7803","fdff7ac81af1d6508080535f43ccf770b62043d9cbf20cbdc7c8c952fdaa7fbf","f5492cd1533da5dccfe9fbead9c7d22c357561660647646fcbeac0c2fd48a106","6e55e60f075471e64523fc500365794066338fb5ebc6c267acd287c93fe17f4a","ba6a0de24f993d9ffd9fa6c6808ca2b0fbfab170ed908ed0e7958826e900bfbf","82e05cc68a70318076f39ebdb91637beee2fea9b647be8060a7e091142a4b543","c8bc569f290a4b1ddc442a8dd42f7d2053a46e3cda765386875064332096a7bb","94742b069682e61080d1d99c41a9490ce5cf1616ab7d1684511112d5a6e6f095","cc054b18217aca486a8352107b19ca37383f69f973016a04ee5492a3060ca3a6","20a13cd382520c38e482e1f8d41825c4cf580670681a8037f914d572dd05c36f","ad3e87ddb75b7109e8def0cee45490665c9415ed80e08227a31bd5e7874ebc19","e015c287164a22419671897a24a65b72ab4cbc99a4942bccbc9c66870d7f6a76","4b3399b212b9d3a7beaf7762596ffe917928378de3e30a899be32d7d01dd7a7f","7696820a4a2f8c97b1fae587898a975b0443beef318095da903a67272932c008","86689bad27bed5525a5fcf4f4075fcf3226bd894a04e722aa368e8136c0f238e","f3d3a6d89f131ca3e5d7c621049be5b11c28e971a9f06947ff7e4b93bb8f8fc8","875c84a76660e6018771852c8e35076ffc6e8c07897626c1fe913938ed63b9a8","d5cc1b603b9b6b10dbe9e634d8a551ab4caffd8e7930dc1882f106f4e678f526","732c82d5d6d5303e601e73226159e13855262a6f93e6e4b9aae758056dac676a","a8fd6f512fda07bef3f58a039a6b79e294a6249d21fd5de3f7701ff64477acb1"],"paragraph_range_zero_based":[37248,37271],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p37248"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the CBR ranges to be used by an index to the entry of the CBR range configuration in sl-CBR-RangeConfigList.","paragraph_zero_based":37272},{"literal_text_all_w_t_and_m_t":"sl-DefaultTxConfigIndex","paragraph_zero_based":37273},{"literal_text_all_w_t_and_m_t":"Indicates the PSSCH transmission parameters to be used by the UEs which do not have available CBR measurement results, by means of an index to the corresponding entry in sl-Tx-ConfigIndexList. Value 0 indicates the first entry in sl-Tx-ConfigIndexList. The field is ignored if the UE has available CBR measurement results.","paragraph_zero_based":37274},{"literal_text_all_w_t_and_m_t":"sl-MCS-RangeList","paragraph_zero_based":37275},{"literal_text_all_w_t_and_m_t":"Indicates the minimum MCS value and maximum MCS value for the associated MCS table(s). UE shall ignore the minimum MCS value and maximum MCS value used for table of 64QAM indicated in SL-CBR-PriorityTxConfigList-r16 if SL-CBR-PriorityTxConfigList-v1650 is present.","paragraph_zero_based":37276},{"literal_text_all_w_t_and_m_t":"sl-PriorityThreshold","paragraph_zero_based":37277},{"literal_text_all_w_t_and_m_t":"Indicates the upper bound of priority range which is associated with the configurations in sl-CBR-ConfigIndex and in sl-Tx-ConfigIndexList. The upper bounds of the priority ranges are configured in ascending order for consecutive entries of SL-PriorityTxConfigIndex in SL-CBR-PriorityTxConfigList. For the first entry of SL-PriorityTxConfigIndex, the lower bound of the priority range is 1.","paragraph_zero_based":37278},{"literal_text_all_w_t_and_m_t":"SL-CBR-PriorityTxConfigList-v1650","paragraph_zero_based":37279},{"literal_text_all_w_t_and_m_t":"If included, it includes the same number of entries, and listed in the same order, as in SL-CBR-PriorityTxConfigList-r16.","paragraph_zero_based":37280},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37281},{"literal_text_all_w_t_and_m_t":"–SL-CBR-CommonTxConfigList","paragraph_zero_based":37282},{"literal_text_all_w_t_and_m_t":"The IE SL-CBR-CommonTxConfigList indicates the list of PSSCH transmission parameters (such as MCS, sub-channel number, retransmission number, CR limit) in sl-CBR-PSSCH-TxConfigList, and the list of CBR ranges in sl-CBR-RangeConfigList, to configure congestion control to the UE for sidelink communication.","paragraph_zero_based":37283},{"literal_text_all_w_t_and_m_t":"SL-CBR-CommonTxConfigList information element","paragraph_zero_based":37284},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":37285},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-CBR-COMMONTXCONFIGLIST-START","paragraph_zero_based":37286},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37287},{"literal_text_all_w_t_and_m_t":"SL-CBR-CommonTxConfigList-r16 ::=     SEQUENCE {","paragraph_zero_based":37288},{"literal_text_all_w_t_and_m_t":"    sl-CBR-RangeConfigList-r16            SEQUENCE (SIZE (1..maxCBR-Config-r16)) OF SL-CBR-LevelsConfig-r16     OPTIONAL,   -- Need M","paragraph_zero_based":37289},{"literal_text_all_w_t_and_m_t":"    sl-CBR-PSSCH-TxConfigList-r16         SEQUENCE (SIZE (1.. maxTxConfig-r16)) OF SL-CBR-PSSCH-TxConfig-r16    OPTIONAL    -- Need M","paragraph_zero_based":37290},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37291},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37292},{"literal_text_all_w_t_and_m_t":"SL-CBR-LevelsConfig-r16 ::=           SEQUENCE (SIZE (1..maxCBR-Level-r16)) OF SL-CBR-r16","paragraph_zero_based":37293},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37294},{"literal_text_all_w_t_and_m_t":"SL-CBR-PSSCH-TxConfig-r16 ::=         SEQUENCE {","paragraph_zero_based":37295}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["8cb4c826d912751c4138db6839c16fbff30315b66e4f3bbb4cdf6cabe436c0bc","3adfa07ba0476a8af08d6562fdc713b26d4e42b3f9a11337e2d71df3510556b0","e239ee87cd4298bd4a31ae82d3e204353633e6eb54dcb6d04a4122957a78e652","a7e08595507036b3f7c4e93c390b30241017b68cf1456c5c061f7e583ac423b7","e9cdafd4bc6356017f031ffd04bcef46014b5b2833aecb65c497fa72929ada27","6028a3d3662c4cbc3bf03cce9c58ed9e6fe623106924c1a8d22010088bc59bff","dde3d9ef6c917b795de427de8cb4627225fb5e6a9e12740a6d0f0d49e50a16b1","2dc6ed08c85ffc0e2d5438b9e3d76690f63c4ef91162408c6f3825cdd6637b6d","17879adf50c6b20366cf5b58bfb260c5e3dbee8685f3d3f9e0a42097742ce6eb","858cebb815d493a7d5d226506378729dfa691732020cf6ccb38efd12dd40422d","fcac991dbb20945aee38a6ec31d9f7622411870d332077cee07b9df2c5eb065b","0fa2f569f5301ccd5a6afe3e73306e6055a9752c6506d235139d01a7d0c84116","eac69b8b9ac183da1295594034f7644f35b01b686112fc552a355e5c9780decf","43a083560159a87e276292b9917e2733839932577d1938ecbb80b0dc83f74852","7567f09a6d01a2a06175084129a2c3557e0eae923e846db26e12932dbff254ee","4e78c3e271e6e3645c1826e5b71199e0926158e096de27b19a1ad4a8b26201a3","9c4fec68546b396f8b5b0b37d6b85277ff27515f8170a64ec410610ccb7ca7a4","e46d9806aaf84f8c29ac9416c26f53ab8bb2d4e295c64db9682758ce12522a8c","ce386b1db62ab2abb3ec43a4ce71f1f692677517ce94bee565000e67ea64460b","ec9cd95b2b047022dea66fd3c0a40f8c1bb4baac9fc29e2ca4d753fbdb5b6e04","6565c720b6b9d53054d58c18f2761c39c143ebbc4f2fc509d4f3915fa9febace","e8f2857f36fe61323910e191d035ed7da9d484acd2dfdf5aa4116df5b71b189e","64172bd5c085e8fa3649d80519a9646ce7c7e4e3827c2998d6af7f80c27c5a56","f8893631e8bb6963bdc9ed1892e8f2a23b7c9a2d46370d73e0991f38c51333e1"],"paragraph_range_zero_based":[37272,37295],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a 