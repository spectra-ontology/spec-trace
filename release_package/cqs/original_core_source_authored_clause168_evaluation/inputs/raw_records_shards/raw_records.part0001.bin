{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"msgA-PUSCH-ResourceGroupA","paragraph_zero_based":20736},{"literal_text_all_w_t_and_m_t":"MsgA PUSCH resources that the UE shall use when performing MsgA transmission using preambles group A. If field is not configured for the selected UL BWP, the UE shall use the MsgA PUSCH configuration for group A of initial UL BWP or RedCap-specific initial UL BWP (if configured) for RedCap UEs.","paragraph_zero_based":20737},{"literal_text_all_w_t_and_m_t":"msgA-PUSCH-ResourceGroupB","paragraph_zero_based":20738},{"literal_text_all_w_t_and_m_t":"MsgA PUSCH resources that the UE shall use when performing MsgA transmission using preambles group B.","paragraph_zero_based":20739},{"literal_text_all_w_t_and_m_t":"msgA-TransformPrecoder","paragraph_zero_based":20740},{"literal_text_all_w_t_and_m_t":"Enables or disables the transform precoder for MsgA transmission (see clause 6.1.3 of TS 38.214 [19]).","paragraph_zero_based":20741},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20742},{"literal_text_all_w_t_and_m_t":"MsgA-PUSCH-Resource field descriptions ","paragraph_zero_based":20743},{"literal_text_all_w_t_and_m_t":"guardBandMsgA-PUSCH","paragraph_zero_based":20744},{"literal_text_all_w_t_and_m_t":"PRB-level guard band between FDMed PUSCH occasions (see TS 38.213 [13], clause 8.1A). If interlaced PUSCH is configured, value 0 is applied.","paragraph_zero_based":20745},{"literal_text_all_w_t_and_m_t":"guardPeriodMsgA-PUSCH","paragraph_zero_based":20746},{"literal_text_all_w_t_and_m_t":"Guard period between PUSCH occasions in the unit of symbols (see TS 38.213 [13], clause 8.1A).","paragraph_zero_based":20747},{"literal_text_all_w_t_and_m_t":"frequencyStartMsgA-PUSCH","paragraph_zero_based":20748},{"literal_text_all_w_t_and_m_t":"Offset of lowest PUSCH occasion in frequency domain with respect to PRB 0 (see TS 38.213 [13], clause 8.1A).","paragraph_zero_based":20749},{"literal_text_all_w_t_and_m_t":"interlaceIndexFirstPO-MsgA-PUSCH","paragraph_zero_based":20750},{"literal_text_all_w_t_and_m_t":"Interlace index of the first PUSCH occasion in frequency domain if interlaced PUSCH is configured. For 30kHz SCS only the integers 1, 2, 3, 4, 5 are applicable (see TS 38.213 [13], clause 8.1A).","paragraph_zero_based":20751},{"literal_text_all_w_t_and_m_t":"mappingTypeMsgA-PUSCH","paragraph_zero_based":20752},{"literal_text_all_w_t_and_m_t":"PUSCH mapping type A or B. If the field is absent, the UE shall use the parameter msgA-PUSCH-TimeDomainAllocation (see TS 38.213 [13], clause 8.1A).","paragraph_zero_based":20753},{"literal_text_all_w_t_and_m_t":"msgA-Alpha","paragraph_zero_based":20754},{"literal_text_all_w_t_and_m_t":"Dedicated alpha value for MsgA PUSCH. If the field is absent, the UE shall use the value of msg3-Alpha if configured, else UE applies value 1 (see TS 38.213 [13], clause 7.1.1).","paragraph_zero_based":20755},{"literal_text_all_w_t_and_m_t":"msgA-DMRS-Config","paragraph_zero_based":20756},{"literal_text_all_w_t_and_m_t":"DMRS configuration for msgA PUSCH (see TS 38.213 [13], clause 8.1A and TS 38.214 [19] clause 6.2.2).","paragraph_zero_based":20757},{"literal_text_all_w_t_and_m_t":"msgA-HoppingBits","paragraph_zero_based":20758},{"literal_text_all_w_t_and_m_t":"Value of hopping bits to indicate which frequency offset to be used for second hop. See Table 8.3-1 in TS 38.213 [13].","paragraph_zero_based":20759}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["9846ca325d11c3adf1c379c288df6ed4b53ab4e87d60f0b445b7a5e3730b61e6","c57a2101e663023e16ff8e71c5ac8a39a59ca6447ec086156fda71a44c6d5cd3","c0a14af62b2941e3d70d32e3888d04b899359959954d84b82103872c8791ef23","ca8b2a37ec43c7b41ab683f932183b6ee641e04f4a5444a274db37a3b1b24988","d03835e8946a665c3377900bf69f8c6fe43512080bafe317064ef97632c21e33","80e7f2b71c581100affd9db4d9b0b07a2bd95ce9bd262493a9482bb874ab5348","c56551b1a4cc9ddb26a520a8e5c09e02432d1bbb9b6f659123f519d4fbbab267","b33784c517e82b15ddca860f89731a02a0914fe6d839f4513827953993785bcb","02261f7a30c57bd8eb13f7a00555ba688d58675d68027e7f387625ca9acaa03f","07cc111920b29a07fa0e21a6009db76e4caf2870def29b6e76c14944cd32282a","179efe1b228eadb6c53b2dc098b16febf64295f9367d0ee35324c30dfc08b919","d24af7df099585420026c572b0e47cf0cf61dc901516061f9c65d3baa0385793","0ff2150f82b7f907b3c40a09f96c52d6bf7d3cfee451ae390c8023c664b183fe","008991b3f33fa4e77b451a8eab0fde529a5a6c15d3a55ba592aa233d314760fe","7daee516c6a51d5f4b940aec1b84b114e9c7f99a7fd60efebb54deef48468dfa","d9f174e9b09ec77895677a0f94c0d24dbaa3a6117d41c7f98f2472e45f471769","1f974f5ce762accecbd795fa182b7d9b735ac0213b3d31cc1f284e5eed8be56a","b14b2230b2fd55291c51361939f105452bcc0a24b6ab2bb9d2b4911d5706834b","114fad6fd1c313117dda679d9b46f27372b68bd16ed2644c934e580b1c8060d2","518f559a6fc1c0ec8184965eac6fe7cb18906a2fbc625c3b0590ca561e798ecf","a99578878b572549e153ebcd994c07f551987be8344cab689ddf4dbde3b84440","8ccaf9d71c01211646c91f4b344766ce5255ee64d51dab7e234c5d7d47b843ef","bdee35a3a83a59d4f7563f7613501c4c13e4e5499312c226e3e57947b8df8595","22669d5fcdee6ea881f67a3bfeb249d1b86ff9ded33e28e1f0bc6a4d6f015516"],"paragraph_range_zero_based":[20736,20759],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p20736"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"msgA-IntraSlotFrequencyHopping","paragraph_zero_based":20760},{"literal_text_all_w_t_and_m_t":"Intra-slot frequency hopping per PUSCH occasion (see TS 38.213 [13], clause 8.1A).","paragraph_zero_based":20761},{"literal_text_all_w_t_and_m_t":"msgA-MCS","paragraph_zero_based":20762},{"literal_text_all_w_t_and_m_t":"Indicates the MCS index for msgA PUSCH from the Table 6.1.4.1-1 for DFT-s-OFDM and Table 5.1.3.1-1 for CP-OFDM in TS 38.214 [19].","paragraph_zero_based":20763},{"literal_text_all_w_t_and_m_t":"msgA-PUSCH-TimeDomainAllocation","paragraph_zero_based":20764},{"literal_text_all_w_t_and_m_t":"Indicates a combination of start symbol and length and PUSCH mapping type from the TDRA table (PUSCH-TimeDomainResourceAllocationList if provided in PUSCH-ConfigCommon, or else the default Table 6.1.2.1.1-2 in 38.214 [19] is used if pusch-TimeDomainAllocationList is not provided in PUSCH-ConfigCommon). The parameter K2 in the table is not used for msgA PUSCH. The network configures one of msgA-PUSCH-TimeDomainAllocation and startSymbolAndLengthMsgA-PO, but not both. If the field is absent, the UE shall use the value of startSymbolAndLenghtMsgA-PO.","paragraph_zero_based":20765},{"literal_text_all_w_t_and_m_t":"msgA-PUSCH-TimeDomainOffset","paragraph_zero_based":20766},{"literal_text_all_w_t_and_m_t":"A single time offset with respect to the start of each PRACH slot (with at least one valid RO), counted as the number of slots (based on the numerology of active UL BWP). See TS 38.213 [13], clause 8.1A.","paragraph_zero_based":20767},{"literal_text_all_w_t_and_m_t":"nrofDMRS-Sequences","paragraph_zero_based":20768},{"literal_text_all_w_t_and_m_t":"Number of DMRS sequences for MsgA PUSCH for CP-OFDM. In case of single PUSCH configuration or if the DMRS symbols of multiple configurations are not overlapped, if the DMRS resources configured in one PUSCH occasion is no larger than 8 (for len2) or 4 (for len1), then only DMRS port is configured.","paragraph_zero_based":20769},{"literal_text_all_w_t_and_m_t":"nrofInterlacesPerMsgA-PO","paragraph_zero_based":20770},{"literal_text_all_w_t_and_m_t":"Number of consecutive interlaces per PUSCH occasion if interlaced PUSCH is configured. For 30kHz SCS only the integers 1, 2, 3, 4, 5 are applicable (see TS 38.213 [13], clause 8.1A).","paragraph_zero_based":20771},{"literal_text_all_w_t_and_m_t":"nrofMsgA-PO-FDM","paragraph_zero_based":20772},{"literal_text_all_w_t_and_m_t":"The number of msgA PUSCH occasions FDMed in one time instance (see TS 38.213 [13], clause 8.1A).","paragraph_zero_based":20773},{"literal_text_all_w_t_and_m_t":"nrofMsgA-PO-PerSlot","paragraph_zero_based":20774},{"literal_text_all_w_t_and_m_t":"Number of time domain PUSCH occasions in each slot. PUSCH occasions including guard period are contiguous in time domain within a slot (see TS 38.213 [13], clause 8.1A).","paragraph_zero_based":20775},{"literal_text_all_w_t_and_m_t":"nrofPRBs-PerMsgA-PO","paragraph_zero_based":20776},{"literal_text_all_w_t_and_m_t":"Number of PRBs per PUSCH occasion (see TS 38.213 [13], clause 8.1A).","paragraph_zero_based":20777},{"literal_text_all_w_t_and_m_t":"nrofSlotsMsgA-PUSCH","paragraph_zero_based":20778},{"literal_text_all_w_t_and_m_t":"Number of slots (in active UL BWP numerology) containing one or multiple PUSCH occasions, each slot has the same time domain resource allocation (see TS 38.213 [13], clause 8.1A).","paragraph_zero_based":20779},{"literal_text_all_w_t_and_m_t":"startSymbolAndLengthMsgA-PO","paragraph_zero_based":20780},{"literal_text_all_w_t_and_m_t":"An index giving valid combinations of start symbol, length and mapping type as start and length indicator (SLIV) for the first msgA PUSCH occasion, for RRC_CONNECTED UEs in non-initial BWP as described in TS 38.214 [19] clause 6.1.2. The network configures the field so that the allocation does not cross the slot boundary. The number of occupied symbols excludes the guard period. If the field is absent, the UE shall use the value in msgA-PUSCH-TimeDomainAllocation (see TS 38.213 [13], clause 8.1A). The network configures one of msgA-PUSCH-TimeDomainAllocation and startSymbolAndLengthMsgA-PO, but not both. If the field is absent, the UE shall use the value of msgA-PUSCH-TimeDomainAllocation.","paragraph_zero_based":20781},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20782},{"literal_text_all_w_t_and_m_t":"MsgA-DMRS-Config field descriptions ","paragraph_zero_based":20783}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["2f8dec51d08f0c18943c7d75d8dcb5d6274a1ae50bccb15a6f9603406c9544e2","84dec588edf389d5fbcff53e869a4eff16ce33a9c777ed62649ec7503166a8f2","3190b14a2a1540ff139d909d24ec06653a4b82d4f1258f8e614b6c5246dbbf85","89770a7e8cdfc75abee24fcbc985a8abd3095fffa1e57e6bcae1f7e90e964074","4d845b3fb8afc54c530e0e3583e5324879c9c370e98b14164a5bd7c8e7fdc764","2a20f49017dea91f4bff5b6a1c8392f0e13a8dec8894785e1c22a38aa8781542","f73afd93619be9e8a7b9b400acff12e23fdd723b4dc761ff0ed64349fdf5d5bd","52fd19906bd054d036139b1f79aa999f14614f8a33e3400ddcc6f259da8fd256","8fd652e39986427b389772d2c9cf98d145c9a3c46a7fbbfc6e836b625f2020e3","2ee50b0d84333946660c520cd9088101c15eb442d4938804f852b7e73dfc5dce","c76a8478069616ef1dd8e295f080926e3c9fcdb61418a6737ba3bd26d6151821","70ef6e2cd76afe11d352c7c54f696879ffa71fad748d137f330a8477386d2b4e","199fe6ca3013a8f4e61402358068e6bea1645f77a8464d54b753e2838581a569","5faa249117df295189de4bc9ac91a774b6304db11d89567f424a95341cb51624","727c126be25ed873f790d5583f71ffc2a21793107c56dcecccf7591a2126671c","e98af1c9fcca00628cda523496e5f36f64debe1397aaba40293b13417f430bc5","4bf9d37ddb205b5b7a40431e596e85c8e9ad422415c9d0abf337db8d4a7815ff","3f95e912841764664e268aab14e91249546e73d6ef11e72583d59c3ef36d0184","363b17f2085fe7b9eadb2b60184683bbac8ad59a0ee933ec91a9a258b32c5d02","53d2fa591500fe549c5573e3bdabbfb70aa286c5e696fbbe7dc9223054d56bb7","a1e600645f2d10a7d9f34fc19d09e8c48a69fe605cef1334c5d66eb8cdb5ac15","cf767fe48e2896b80ab73e55f4378d07f41ebd2af7479c1388b64f3cff5e5fa4","4ea332a752022439d95af0df63c33db60343f07ffefaa20e8ddf702eda6c7941","7f07798eb56823aa2884b34196c4cc96a9b989d663d5884bdf2fcd4b61b9c2f2"],"paragraph_range_zero_based":[20760,20783],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p20760"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"msgA-DMRS-AdditionalPosition","paragraph_zero_based":20784},{"literal_text_all_w_t_and_m_t":"Indicates the position for additional DM-RS. If the field is absent, the UE applies value pos2.","paragraph_zero_based":20785},{"literal_text_all_w_t_and_m_t":"msgA-MaxLength","paragraph_zero_based":20786},{"literal_text_all_w_t_and_m_t":"indicates single-symbol or double-symbol DMRS. If the field is absent, the UE applies value len1.","paragraph_zero_based":20787},{"literal_text_all_w_t_and_m_t":"msgA-PUSCH-DMRS-CDM-Group","paragraph_zero_based":20788},{"literal_text_all_w_t_and_m_t":"1-bit indication of indices of CDM group(s). If the field is absent, then both CDM groups are used.","paragraph_zero_based":20789},{"literal_text_all_w_t_and_m_t":"msgA-PUSCH-NrofPorts","paragraph_zero_based":20790},{"literal_text_all_w_t_and_m_t":"0 indicates 1 port per CDM group, 1 indicates 2 ports per CDM group. If the field is absent then 4 ports per CDM group are used (see TS 38.213 [13], clause 8.1A).","paragraph_zero_based":20791},{"literal_text_all_w_t_and_m_t":"msgA-ScramblingID0","paragraph_zero_based":20792},{"literal_text_all_w_t_and_m_t":"UL DMRS scrambling initialization for CP-OFDM. If the field is absent the UE applies the value Physical cell ID (physCellID).","paragraph_zero_based":20793},{"literal_text_all_w_t_and_m_t":"msgA-ScramblingID1","paragraph_zero_based":20794},{"literal_text_all_w_t_and_m_t":"UL DMRS scrambling initialization for CP-OFDM. If the field is absent the UE applies the value Physical cell ID (physCellID).","paragraph_zero_based":20795},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20796},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":20797},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":20798},{"literal_text_all_w_t_and_m_t":"FreqHopConfigured","paragraph_zero_based":20799},{"literal_text_all_w_t_and_m_t":"This field is mandatory present when the field msgA-IntraSlotFrequencyHopping is configured. Otherwise, the field is absent.","paragraph_zero_based":20800},{"literal_text_all_w_t_and_m_t":"GroupBConfigured","paragraph_zero_based":20801},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if groupB-ConfiguredTwoStepRA is configured in RACH-ConfigCommonTwoStepRA, otherwise the field is absent.","paragraph_zero_based":20802},{"literal_text_all_w_t_and_m_t":"InitialBWPConfig","paragraph_zero_based":20803},{"literal_text_all_w_t_and_m_t":"The field is mandatory present when MsgA-ConfigCommon is configured for the initial uplink BWP, or when MsgA-ConfigCommon is configured for a non-initial uplink BWP and MsgA-ConfigCommon is not configured for the initial uplink BWP, otherwise the field is optionally present, Need S.","paragraph_zero_based":20804},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20805},{"literal_text_all_w_t_and_m_t":"–MultiFrequencyBandListNR","paragraph_zero_based":20806},{"literal_text_all_w_t_and_m_t":"The IE MultiFrequencyBandListNR is used to configure a list of one or multiple NR frequency bands.","paragraph_zero_based":20807}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["ef640faa63268a73932aab843073c894928bd3357137eac836eb7d6b2521ffc9","95c73306c1396d894f37ff370b478916af1d6875241bab60e7297a466c2e5636","d19ac55969d655241745eed5ed4357770091d0f8ee43519dae8298a97544bf1a","00183d57bc122405531b9cd60b1649956cacd6daa7b6aafe8c111e10dc1753a5","20d0bdc0e9a59da4f35f1db2433baff7fb2d7f8f4cdc0028c50e8a893e2f1757","a7f30eb05c131bcb2ce38b32ee10e3dc080cb0bb227da781ceab2e794a792d9d","4bd46c87d5f9c23de83cd9e07740089963cfe5b3c655ebe82d22e62f23e1fdb3","9ffbf191da48e626f0c34e2dbd342dfed2915d0d24bce1540ba9071f1ee1a21f","eba4a563bedabfac44dc033a40b8fec8fcd4469f430d9f7704363f01b72e638e","0e64d3d602e74982046a8132d8eeed757b81812e2278edea2a8be3706face0cc","5beada368b837e60dba97dff3649fc95af6be9e32ce61c71fa8e8e02ccb47a86","e44b47e9f6962aa8f1535bfcedc15457962f9e1790c5f344a3d28a66921cf60a","f3fb42a6a70329d3ca65256830aa1396bd5223cca6fd98cd3306b5905eae44c6","e803e8382d0ad294344e47085293630115b5b020ad70f5972f9d9aea22ae591a","f01f2a019ceb0b12a378a7b0e1c25d5223792273d3c35fc3c60d59fa58d44317","ec4e5f4ecb1ce78da420d549a1e4f1b09c49ff638bf4268f7feabaf3e6e7be09","5ff285c91a67758e81e2e0d21af7f86327ef08e9e20fd4a9d4abb2081457fed9","3288ca86b97017f95744e8a2ec9a9e24bcedf6758a8e3d34d95513baa5cac421","37afc1d396e120811193480a26cd491e5ea42b9ffa9a769c027ffad7fa98e87b","7f968b08d485a823895acff1e33f0509363f74556a3aad0e51302979afbb2852","13e660a77cdea7cd5a2a85e330a377551208dffd0999ea253ee38fa03e619d69","3797b656bacc6bed251a7716b71af1446f94eca748d1daa0ddabdf49d304d3f0","2fd8858a56c7ec46c25a071c9410d31d84598fb767aacfe9d1ab4a0b751ebb43","66cb7c9d033db3c8185ac083d26f6d977686301917a4f9e8f11e0f83ea20bd85"],"paragraph_range_zero_based":[20784,20807],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p20784"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"MultiFrequencyBandListNR information element","paragraph_zero_based":20808},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":20809},{"literal_text_all_w_t_and_m_t":"-- TAG-MULTIFREQUENCYBANDLISTNR-START","paragraph_zero_based":20810},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20811},{"literal_text_all_w_t_and_m_t":"MultiFrequencyBandListNR ::=        SEQUENCE (SIZE (1..maxNrofMultiBands)) OF FreqBandIndicatorNR","paragraph_zero_based":20812},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20813},{"literal_text_all_w_t_and_m_t":"-- TAG-MULTIFREQUENCYBANDLISTNR-STOP","paragraph_zero_based":20814},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":20815},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20816},{"literal_text_all_w_t_and_m_t":"–MultiFrequencyBandListNR-SIB","paragraph_zero_based":20817},{"literal_text_all_w_t_and_m_t":"The IE MultiFrequencyBandListNR-SIB indicates the list of frequency bands, for which cell (re-)selection parameters are common, and a list of additionalPmax and additionalSpectrumEmission.","paragraph_zero_based":20818},{"literal_text_all_w_t_and_m_t":"MultiFrequencyBandListNR-SIB information element","paragraph_zero_based":20819},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":20820},{"literal_text_all_w_t_and_m_t":"-- TAG-MULTIFREQUENCYBANDLISTNR-SIB-START","paragraph_zero_based":20821},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20822},{"literal_text_all_w_t_and_m_t":"MultiFrequencyBandListNR-SIB ::=            SEQUENCE (SIZE (1.. maxNrofMultiBands)) OF NR-MultiBandInfo","paragraph_zero_based":20823},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20824},{"literal_text_all_w_t_and_m_t":"NR-MultiBandInfo ::=                        SEQUENCE {","paragraph_zero_based":20825},{"literal_text_all_w_t_and_m_t":"    freqBandIndicatorNR                         FreqBandIndicatorNR         OPTIONAL,   -- Cond OptULNotSIB2","paragraph_zero_based":20826},{"literal_text_all_w_t_and_m_t":"    nr-NS-PmaxList                              NR-NS-PmaxList              OPTIONAL    -- Need S","paragraph_zero_based":20827},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":20828},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20829},{"literal_text_all_w_t_and_m_t":"MultiFrequencyBandListNR-SIB-v1760 ::=      SEQUENCE (SIZE (1.. maxNrofMultiBands)) OF NR-MultiBandInfo-v1760","paragraph_zero_based":20830},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20831}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["66dfe16a1b706cc2049447674f0db3b92d8068a62670b7a49c8cea136c229b97","05e5fdd9d39ff78b9f3dbcc8d00e0d136c14f7ec5e0d255fd355bc0e20acce69","53adc9eb9778b66a67aa9cb90ce29af8f75fddb10a3c6a4374dbacd05a75e333","b508a96196ce9b11ad0e1d668b2ee938b6448f2413db151363a36cd2923ad1f3","dea51277386e7466afd55f5950bafeaa2db199bba0279cba846e838ab4c0433c","ad19dae2fa7bb2fed26caddc5fff11144b9cbad10d01cca429964f199bb77587","00faf3a555e54b2223495ea03a3ac5107e5647d5676a7c9d427bebd0500b864d","00859893fc778480faa990bed6f39e7705cc1369ffa00e2459c5827800d631fd","57d03914ab61c8f31feceb6cedc2e3064741610cbaffed511cff7c308368f6e8","97e99bd49637b1bdf3f0b0ffb745df615cf105229bb8aec5a505811031dc45d5","0a217d3516ce358531fc1a5f7824479ce1fca14fb0b06bdc76e2a6f114aeea86","8ba2c1f785ad4218f29726c6ca5ad18aa9671f735dd9757528773fa1eebf1721","c78670a9dd1b6223ccafa71fbd956b58364a782134cdedaa2daf834ecb0bb767","1f38a5409aeaefcd1e90c000bc5babb286ba8501a86bc3253ac29d555e424892","425c284c4c6782d727a085802d344a821f4ca47d2755ccef8b19d37bd4e2f957","725db4a3805aaf5e8810f0fbf7592046fd1e8d77d36206987b56525faaeea63a","94942803f53e96d5867600fb196d37ba971e62b9613fea16011fd5b222cd325e","9e0951627b4669ca92fe49c2c7849e6d69985381e92353c5f5cbc95bcfbea478","552ea48e8e58a9f9296727721e93e762c998eb46a87726051544f6dce636c04b","52f20723d96878821d6d04c6643fb5f769aa59442e55497b04b3d7ff260ccca3","52871cc2c94575a0349d15568be7c96badf216f68692c23f9cb8a10e0bb1c54e","6bb3e796e7c2cde50744dafafaec5f24b99a424638c7dd698119541890a2d3df","fbb6ec0915a8fd62b31aeea8b70747e1158989b64a999edd8749cab561dfc243","975ace895c30a5c2d5e3613d06871fc1ad9e421309f617151823910d141ef494"],"paragraph_range_zero_based":[20808,20831],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p20808"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"NR-MultiBandInfo-v1760 ::=                  SEQUENCE {","paragraph_zero_based":20832},{"literal_text_all_w_t_and_m_t":"    nr-NS-PmaxList-v1760                        NR-NS-PmaxList-v1760        OPTIONAL    -- Need S","paragraph_zero_based":20833},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":20834},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20835},{"literal_text_all_w_t_and_m_t":"-- TAG-MULTIFREQUENCYBANDLISTNR-SIB-STOP","paragraph_zero_based":20836},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":20837},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20838},{"literal_text_all_w_t_and_m_t":"NR-MultiBandInfo field descriptions","paragraph_zero_based":20839},{"literal_text_all_w_t_and_m_t":"freqBandIndicatorNR","paragraph_zero_based":20840},{"literal_text_all_w_t_and_m_t":"Provides an NR frequency band number as defined in TS 38.101-1 [15], TS 38.101-2 [39], table 5.2-1, and TS 38.101-5 [75], table 5.2.2-1.","paragraph_zero_based":20841},{"literal_text_all_w_t_and_m_t":"nr-NS-PmaxList","paragraph_zero_based":20842},{"literal_text_all_w_t_and_m_t":"Provides a list of additionalPmax and additionalSpectrumEmission values. If the field is absent the UE uses value 0 for the additionalSpectrumEmission (see TS 38.101-1 [15] table 6.2.3.1-1A, TS 38.101-2 [39], table 6.2.3.1-2, and TS 38.101-5 [75], table 6.2.3.1-1A). This field is ignored by IAB-MT, the IAB-MT applies output power and emissions requirements, as specified in TS 38.174 [63]. If nr-NS-PmaxList-v1760 is present, it shall contain the same number of entries, listed in the same order as in nr-NS-PmaxList (without suffix).","paragraph_zero_based":20843},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20844},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":20845},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":20846},{"literal_text_all_w_t_and_m_t":"OptULNotSIB2","paragraph_zero_based":20847},{"literal_text_all_w_t_and_m_t":"The field is absent for SIB2 and is mandatory present in SIB4 and frequencyInfoDL-SIB. Otherwise, if the field is absent in frequencyInfoUL-SIB in UplinkConfigCommonSIB, the UE will use the frequency band indicated in frequencyInfoDL-SIB in DownlinkConfigCommonSIB.","paragraph_zero_based":20848},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20849},{"literal_text_all_w_t_and_m_t":"–MUSIM-GapConfig","paragraph_zero_based":20850},{"literal_text_all_w_t_and_m_t":"The IE MUSIM-GapConfig specifies the MUSIM gap configuration and controls setup/release of MUSIM gaps.","paragraph_zero_based":20851},{"literal_text_all_w_t_and_m_t":"MUSIM-GapConfig information element","paragraph_zero_based":20852},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":20853},{"literal_text_all_w_t_and_m_t":"-- TAG-MUSIM-GAPCONFIG-START","paragraph_zero_based":20854},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20855}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["0ec4aa9790d878cba1e8d2ea344f18414f426f966ef189f905420595e84206f2","aabbb3b81100a3094b962cb86df748f933847acc8880c207c6e05f1010769767","87048ef32e355c9e40e7606e301964a2fd5a48a23b7000c490040222b7a9d006","64a652cf9cca1082131ae9b0d886884861a3448c488c41f710d0789730433c06","6516da33bc02fe6514248362ef752dbff03463ed1fe220785c546eaa1abd6115","e4d079f54cb439d2143a7539a7d6bcbc1a197cd7bb65d9fd97ea62f080890d69","fbb035f2eb9d16a6487aac898ecfe482928f2e7dcb122cfa7263459b3ae38fab","b3