{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Number of sidelink measurement reports applicable for sl-EventTriggered report type.","paragraph_zero_based":38592},{"literal_text_all_w_t_and_m_t":"sl-ReportInterval","paragraph_zero_based":38593},{"literal_text_all_w_t_and_m_t":"Indicates the interval between periodical reports (i.e., when sl-ReportAmount exceeds 1) for sl-EventTriggered report type.","paragraph_zero_based":38594},{"literal_text_all_w_t_and_m_t":"sl-ReportOnLeave","paragraph_zero_based":38595},{"literal_text_all_w_t_and_m_t":"indicates whether or not the UE shall initiate the sidelink measurement reporting procedure when the leaving condition is met for a frequency in sl-FrequencyTriggeredList, as specified in 5.8.10.4.1.","paragraph_zero_based":38596},{"literal_text_all_w_t_and_m_t":"sl-ReportQuantity","paragraph_zero_based":38597},{"literal_text_all_w_t_and_m_t":"The sidelink measurement quantities to be included in the sidelink measurement report.","paragraph_zero_based":38598},{"literal_text_all_w_t_and_m_t":"sl-TimeToTrigger","paragraph_zero_based":38599},{"literal_text_all_w_t_and_m_t":"Time during which specific criteria for the event needs to be met in order to trigger a sidelink measurement report.","paragraph_zero_based":38600},{"literal_text_all_w_t_and_m_t":"sN-Threshold","paragraph_zero_based":38601},{"literal_text_all_w_t_and_m_t":"Threshold used for events S1 and S2 specified in clauses 5.8.10.4.2 and 5.8.10.4.3, respectively.","paragraph_zero_based":38602},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38603},{"literal_text_all_w_t_and_m_t":"SL-PeriodicalReportConfig field descriptions","paragraph_zero_based":38604},{"literal_text_all_w_t_and_m_t":"sl-ReportAmount","paragraph_zero_based":38605},{"literal_text_all_w_t_and_m_t":"Number of sidelink measurement reports applicable for sl-Periodical report type.","paragraph_zero_based":38606},{"literal_text_all_w_t_and_m_t":"sl-ReportInterval","paragraph_zero_based":38607},{"literal_text_all_w_t_and_m_t":"Indicates the interval between periodical reports (i.e., when sl-ReportAmount exceeds 1) for sl-Periodical report type.","paragraph_zero_based":38608},{"literal_text_all_w_t_and_m_t":"sl-ReportQuantity","paragraph_zero_based":38609},{"literal_text_all_w_t_and_m_t":"The sidelink measurement quantities to be included in the sidelink measurement report.","paragraph_zero_based":38610},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38611},{"literal_text_all_w_t_and_m_t":"–SL-ResourcePool","paragraph_zero_based":38612},{"literal_text_all_w_t_and_m_t":"The IE SL-ResourcePool specifies the configuration information for NR sidelink communication resource pool.","paragraph_zero_based":38613},{"literal_text_all_w_t_and_m_t":"SL-ResourcePool information element","paragraph_zero_based":38614},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":38615}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["cfbb8ac96aac87996169924b2e42163b8bd5ef2449e8aad69389e9e94170f238","0f2cdbcdeaefe9928f37c5c5f7ef65ceff05eb6e1cc9a9bf72a93653bfa4760d","e950a791d9fa2c02281638910f12faf8eca7d85c4ff8a1b9a31709f4aa0b6121","b11af44d6577e987e430cec49214255b81f8f1ac1cc22e857b0b64e38521d1b6","694e30197f218e8cf0bf5ab2d222d4ea815c3316c9aec84705b0ed09f37b7d22","fc95ff503872ef9e72f26bbac80472cfc0bde1d33e124d11721634cd71b27946","dc44f7fb1203dae9008993d50ff180087fc7f1537e4d9e3b25b168f2953a47d3","14fba15ea2b206f36fedf32de19396a3c48c0f0f22a6acc221633718eafed0e9","13e2ca8978048705d38ba9920d1db488671f80615ef94d41