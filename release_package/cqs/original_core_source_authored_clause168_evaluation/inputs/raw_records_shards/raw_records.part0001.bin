{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is mandatory present, if this serving cell is configured with unifiedTCI-StateType set to 'joint'. It is absent, Need R, otherwise.","paragraph_zero_based":29280},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29281},{"literal_text_all_w_t_and_m_t":"–TCI-StateId","paragraph_zero_based":29282},{"literal_text_all_w_t_and_m_t":"The IE TCI-StateId is used to identify one TCI-State configuration.","paragraph_zero_based":29283},{"literal_text_all_w_t_and_m_t":"TCI-StateId information element","paragraph_zero_based":29284},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29285},{"literal_text_all_w_t_and_m_t":"-- TAG-TCI-STATEID-START","paragraph_zero_based":29286},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29287},{"literal_text_all_w_t_and_m_t":"TCI-StateId ::=                     INTEGER (0..maxNrofTCI-States-1)","paragraph_zero_based":29288},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29289},{"literal_text_all_w_t_and_m_t":"-- TAG-TCI-STATEID-STOP","paragraph_zero_based":29290},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29291},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29292},{"literal_text_all_w_t_and_m_t":"–TCI-UL-State","paragraph_zero_based":29293},{"literal_text_all_w_t_and_m_t":"The IE TCI-UL-State indicates the TCI state information for UL transmission.","paragraph_zero_based":29294},{"literal_text_all_w_t_and_m_t":"TCI-UL-State information element","paragraph_zero_based":29295},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29296},{"literal_text_all_w_t_and_m_t":"-- TAG-TCI-UL-STATE-START","paragraph_zero_based":29297},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29298},{"literal_text_all_w_t_and_m_t":"TCI-UL-State-