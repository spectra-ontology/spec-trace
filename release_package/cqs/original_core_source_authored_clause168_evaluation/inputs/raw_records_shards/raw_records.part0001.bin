{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"pdsch-TimeDomainAllocationList","paragraph_zero_based":22512},{"literal_text_all_w_t_and_m_t":"List of time-domain configurations for timing of DL assignment to DL data (see table 5.1.2.1.1-1 in TS 38.214 [19]).","paragraph_zero_based":22513},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22514},{"literal_text_all_w_t_and_m_t":"–PDSCH-ServingCellConfig","paragraph_zero_based":22515},{"literal_text_all_w_t_and_m_t":"The IE PDSCH-ServingCellConfig is used to configure UE specific PDSCH parameters that are common across the UE's BWPs of one serving cell.","paragraph_zero_based":22516},{"literal_text_all_w_t_and_m_t":"PDSCH-ServingCellConfig information element","paragraph_zero_based":22517},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":22518},{"literal_text_all_w_t_and_m_t":"-- TAG-PDSCH-SERVINGCELLCONFIG-START","paragraph_zero_based":22519},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22520},{"literal_text_all_w_t_and_m_t":"PDSCH-ServingCellConfig ::=             SEQUENCE {","paragraph_zero_based":22521},{"literal_text_all_w_t_and_m_t":"    codeBlockGroupTransmission              SetupRelease { PDSCH-CodeBlockGroupTransmission }              OPTIONAL,   -- Need M","paragraph_zero_based":22522},{"literal_text_all_w_t_and_m_t":"    xOverhead                               ENUMERATED { xOh6, xOh12, xOh18 }                              OPTIONAL,   -- Need S","paragraph_zero_based":22523},{"literal_text_all_w_t_and_m_t":"    nrofHARQ-ProcessesForPDSCH              ENUMERATED {n2, n4, n6, n10, n12, n16}                         OPTIONAL,   -- Need S","paragraph_zero_based":22524},{"literal_text_all_w_t_and_m_t":"    pucch-Cell                              ServCellIndex                                                  OPTIONAL,   -- Cond SCellAddOnly","paragraph_zero_based":22525},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":22526},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":22527},{"literal_text_all_w_t_and_m_t":"    maxMIMO-Layers                          INTEGER (1..8)                                                 OPTIONAL,   -- Need M","paragraph_zero_based":22528},{"literal_text_all_w_t_and_m_t":"    processingType2Enabled                  BOOLEAN                                                        OPTIONAL    -- Need M","paragraph_zero_based":22529},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":22530},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":22531},{"literal_text_all_w_t_and_m_t":"    pdsch-CodeBlockGroupTransmissionList-r16 SetupRelease { PDSCH-CodeBlockGroupTransmissionList-r16 }     OPTIONAL    -- Need M","paragraph_zero_based":22532},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":22533},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":22534},{"literal_text_all_w_t_and_m_t":"    downlinkHARQ-FeedbackDisabled-r17       SetupRelease { DownlinkHARQ-FeedbackDisabled-r17 }              OPTIONAL,   -- Need M","paragraph_zero_based":22535}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["eb7590fd77e6e8b7215f779c972cc1dc2cf56eb386675226fb0ac734f025207f","8cdf99b0b8405715c5ef902330093dfd331409c931a484fa2aab368a01e4b11a","9b28491e166718a91e39277a1da1402ecaf12b8d665b202eee2ec3188669e958","dc6bc0b6695c66e2f659d9472f100d5a2e4e7ebb751fd8535758d6677014999e","251a58e2707f30e34bd66c6e7758a04cbab0e9a4ea367e5a683a3d97820afba6","5818f0343e1d36cb8e93faa29ec8761f15b9357bd9082474967fdde