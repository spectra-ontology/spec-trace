{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"UAC-BarringInfoSetIndex information element","paragraph_zero_based":29520},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29521},{"literal_text_all_w_t_and_m_t":"-- TAG-UAC-BARRINGINFOSETINDEX-START","paragraph_zero_based":29522},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29523},{"literal_text_all_w_t_and_m_t":"UAC-BarringInfoSetIndex ::=                INTEGER (1..maxBarringInfoSet)","paragraph_zero_based":29524},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29525},{"literal_text_all_w_t_and_m_t":"-- TAG-UAC-BARRINGINFOSETINDEX-STOP","paragraph_zero_based":29526},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29527},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29528},{"literal_text_all_w_t_and_m_t":"–UAC-BarringInfoSetList","paragraph_zero_based":29529},{"literal_text_all_w_t_and_m_t":"The IE UAC-BarringInfoSetList provides a list of access control parameter sets. An access category can be configured with access parameters according to one of the sets.","paragraph_zero_based":29530},{"literal_text_all_w_t_and_m_t":"UAC-BarringInfoSetList information element","paragraph_zero_based":29531},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29532},{"literal_text_all_w_t_and_m_t":"-- TAG-UAC-BARRINGINFOSETLIST-START","paragraph_zero_based":29533},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29534},{"literal_text_all_w_t_and_m_t":"UAC-BarringInfoSetList ::=          SEQUENCE (SIZE(1..maxBarringInfoSet)) OF UAC-BarringInfoSet","paragraph_zero_based":29535},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29536},{"literal_text_all_w_t_and_m_t":"UAC-BarringInfoSetList-v1700 ::= SEQUENCE (SIZE(1..maxBarringInfoSet)) OF UAC-BarringInfoSet-v1700","paragraph_zero_based":29537},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29538},{"literal_text_all_w_t_and_m_t":"UAC-BarringInfoSet ::=              SEQUENCE {","paragraph_zero_based":29539},{"literal_text_all_w_t_and_m_t":"    uac-BarringFactor                   ENUMERATED {p00, p05, p10, p15, p20, p25, p30, p40,","paragraph_zero_based":29540},{"literal_text_all_w_t_and_m_t":"                                                    p50, p60, p70, p75, p80, p85, p90, p95},","paragraph_zero_based":29541},{"literal_text_all_w_t_and_m_t":"    uac-BarringTime                     ENUMERATED {s4, s8, s16, s32, s64, s128, s256, s512},","paragraph_zero_based":29542},{"literal_text_all_w_t_and_m_t":"    uac-BarringForAccessIdentity        BIT STRING (SIZE(7))","paragraph_zero_based":29543}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["9bc2d018f8ee3ede68ce8de9c7859f203255a3f6313bf52f50e5bccdfff1e14f","951879ac1e3795dca70f52e64095f0ea125b3d82d277afd82cc606179e67bd6d","613b2e661cbda2811f46d369bcbac958dde6bae4a279cb1e397f620b6b2835f4","d0796e75d838cb5d3b8e5214c5e1e40e2204c6e3266e488a3a95754cc643632d","5040099a8dd673041af951169a5abfa59f6ac203a4d2f87776c02fd4d8e7fa0a","02f5828721fd032432e8e28bf394ceddde30105300858b99c7657832a9f55013","03578311e6241eed221de1263a39c9bd9b1312c39f1134495bb7528536192381","d6176d74abbac1468f40d2976c61f2021aee85bbb79852a519eae737072f9525","fad5622626c2439ff53848f8948be23734a4fb8adbc5871c60e8a56a658b36e2","b845289891bebc25bf78cb6232c28e30ef30ec53c4c2bf7382dac6d93c4fffbc","ac5ae70dd7cd13358d4d7497a1b7c07cb5872eb5c79f06d07390383a9016e170","8b512e7e6e7f63e135dd693d48b620d4add6d7d05028cf38137e387dbc9c1ea8","17ea678e1706c47ed04093bbbba4ad0c5d9c369f197b130bfcddd92ac2003296","41be02033cea6cad80cfad2baafa6cea5370f29d86adfee153ad2f14600c3fae","3f445778b00dfcddfc73633df2117fc42281496b24bdf2cf133cdf117b59e1b3","b6ba2cd26c2fac1b64b0ad055b8f0ef972f97944e10066dcef06019076ff2701","ddc61b963f7362525ee1a7d13adff13c6352c04ce1482d7d50d92c22a54a61bb","d9f5ab2a2d55193f0802e7f6a1997bd211337ee12bc860554f3c7f51bc6c222c","6783dd0908fdc76818aa405164f759eb420a37f5943f8f9e43d39b4db9a3f785","7b29a63df3afcaa579223f83b482cc4448ac18e671b15b40693703de80d4b55c","e8af87a66a0ae1a790fb58c270122149cafa6b599880228d63237d65b8e09741","55ee06b8bb8eec2de795ff4424da0534e8a9e11e05d5133013e0cabe51d61095","b4828de507e72b03c7ac6b04a3f06def08f3167246c373b42cb23d7b5b4320a1","0913fefd6f714a13dd8e6196ae94fc30f2a72f83e4137bd5347a93b6278da164"],"paragraph_range_zero_based":[29520,29543],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p29520"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29544},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29545},{"literal_text_all_w_t_and_m_t":"UAC-BarringInfoSet-v1700 ::= SEQUENCE {","paragraph_zero_based":29546},{"literal_text_all_w_t_and_m_t":"    uac-BarringFactorForAI3-r17  ENUMERATED {p00, p05, p10, p15, p20, p25, p30, p40, p50, p60, p70, p75, p80, p85, p90, p95}","paragraph_zero_based":29547},{"literal_text_all_w_t_and_m_t":"                                                                       OPTIONAL  -- Need S","paragraph_zero_based":29548},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29549},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29550},{"literal_text_all_w_t_and_m_t":"-- TAG-UAC-BARRINGINFOSETLIST-STOP","paragraph_zero_based":29551},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29552},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29553},{"literal_text_all_w_t_and_m_t":"UAC-BarringInfoSetList field descriptions","paragraph_zero_based":29554},{"literal_text_all_w_t_and_m_t":"uac-BarringInfoSetList","paragraph_zero_based":29555},{"literal_text_all_w_t_and_m_t":"List of access control parameter sets. Each access category can be configured with access parameters corresponding to a particular set by uac-barringInfoSetIndex. Association of an access category with an index that has no corresponding entry in the uac-BarringInfoSetList is valid configuration and indicates no barring.","paragraph_zero_based":29556},{"literal_text_all_w_t_and_m_t":"uac-BarringForAccessIdentity","paragraph_zero_based":29557},{"literal_text_all_w_t_and_m_t":"Indicates whether access attempt is allowed for each Access Identity. The leftmost bit, bit 0 in the bit string corresponds to Access Identity 1, bit 1 in the bit string corresponds to Access Identity 2, bit 2 in the bit string corresponds to Access Identity 11, bit 3 in the bit string corresponds to Access Identity 12, bit 4 in the bit string corresponds to Access Identity 13, bit 5 in the bit string corresponds to Access Identity 14, and bit 6 in the bit string corresponds to Access Identity 15. Value 0 means that access attempt is allowed for the corresponding access identity.","paragraph_zero_based":29558},{"literal_text_all_w_t_and_m_t":"uac-BarringFactor","paragraph_zero_based":29559},{"literal_text_all_w_t_and_m_t":"Represents the probability that access attempt would be allowed during access barring check.","paragraph_zero_based":29560},{"literal_text_all_w_t_and_m_t":"uac-BarringFactorForAI3","paragraph_zero_based":29561},{"literal_text_all_w_t_and_m_t":"Barring factor applicable for Access Identity 3. Represents the probability that access attempt would be allowed during access barring check. If absent, the UE considers the access attempt as allowed.","paragraph_zero_based":29562},{"literal_text_all_w_t_and_m_t":"uac-BarringTime","paragraph_zero_based":29563},{"literal_text_all_w_t_and_m_t":"The average time in seconds before a new access attempt is to be performed after an access attempt was barred at access barring check for the same access category, see 5.3.14.5.","paragraph_zero_based":29564},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29565},{"literal_text_all_w_t_and_m_t":"–UAC-BarringPerCatList","paragraph_zero_based":29566},{"literal_text_all_w_t_and_m_t":"The IE UAC-BarringPerCatList provides access control parameters for a list of access categories.","paragraph_zero_based":29567}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_Elemen