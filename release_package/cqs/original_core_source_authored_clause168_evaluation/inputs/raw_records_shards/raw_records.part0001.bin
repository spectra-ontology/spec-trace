{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"UERadioPagingInformation-v1700-IEs ::= SEQUENCE {","paragraph_zero_based":43800},{"literal_text_all_w_t_and_m_t":"    ue-RadioPagingInfo-r17                 OCTET STRING (CONTAINING UE-RadioPagingInfo-r17)     OPTIONAL,","paragraph_zero_based":43801},{"literal_text_all_w_t_and_m_t":"    inactiveStatePO-Determination-r17      ENUMERATED {supported}                               OPTIONAL,","paragraph_zero_based":43802},{"literal_text_all_w_t_and_m_t":"    numberOfRxRedCap-r17                   ENUMERATED {one, two}                                OPTIONAL,","paragraph_zero_based":43803},{"literal_text_all_w_t_and_m_t":"    halfDuplexFDD-TypeA-RedCap-r17         SEQUENCE (SIZE (1..maxBands)) OF FreqBandIndicatorNR OPTIONAL,","paragraph_zero_based":43804},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                   SEQUENCE {}                                          OPTIONAL","paragraph_zero_based":43805},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":43806},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43807},{"literal_text_all_w_t_and_m_t":"-- TAG-UE-RADIO-PAGING-INFORMATION-STOP","paragraph_zero_based":43808},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":43809},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43810},{"literal_text_all_w_t_and_m_t":"UERadioPagingInformation field descriptions","paragraph_zero_based":43811},{"literal_text_all_w_t_and_m_t":"supportedBandListNRForPaging","paragraph_zero_based":43812},{"literal_text_all_w_t_and_m_t":"Indicates the UE supported NR frequency bands which are derived by the gNB from UE-NR-Capability.","paragraph_zero_based":43813},{"literal_text_all_w_t_and_m_t":"dl-SchedulingOffset-PDSCH-TypeA-FDD-FR1","paragraph_zero_based":43814},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports DL scheduling slot offset (K0) greater than 0 for PDSCH mapping type A in FDD FR1.","paragraph_zero_based":43815},{"literal_text_all_w_t_and_m_t":"dl-SchedulingOffset-PDSCH-TypeA-TDD-FR1","paragraph_zero_based":43816},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports DL scheduling slot offset (K0) greater than 0 for PDSCH mapping type A in TDD FR1.","paragraph_zero_based":43817},{"literal_text_all_w_t_and_m_t":"dl-SchedulingOffset-PDSCH-TypeA-TDD-FR2","paragraph_zero_based":43818},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports DL scheduling slot offset (K0) greater than 0 for PDSCH mapping type A in TDD FR2.","paragraph_zero_based":43819},{"literal_text_all_w_t_and_m_t":"dl-SchedulingOffset-PDSCH-TypeB-FDD-FR1","paragraph_zero_based":43820},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports DL scheduling slot offset (K0) greater than 0 for PDSCH mapping type B in FDD FR1.","paragraph_zero_based":43821},{"literal_text_all_w_t_and_m_t":"dl-SchedulingOffset-PDSCH-TypeB-TDD-FR1","paragraph_zero_based":43822},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports DL scheduling slot offset (K0) greater than 0 for PDSCH mapping type B in TDD FR1.","paragraph_zero_based":43823}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["73ddffa238489c47e6d269649e508081d0e2f6ac409b068b7eec58e35cc9e2cc","5c6e47197cbe6ace397cbc1054d24fbcec1bb38f142e35f2abeafe8471f6d8f9","fa1a9176cf949ac91e7216156e18ab8ef518b55196d77f3a8da5534c328b7b55","8323803828c71cc7f6c948567bbd334e4c437a8102077815be069b08711e62b2","81ba9c6f231b65dc75f36d9f1a462b05b73cdb4cdf5301113fe5e08cdf4750c0","8241d418dae4a