{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Barring factor applicable for Access Identity 3. Represents the probability that access attempt would be allowed during access barring check. If absent, the UE considers the access attempt as allowed.","paragraph_zero_based":29928},{"literal_text_all_w_t_and_m_t":"uac-BarringTime","paragraph_zero_based":29929},{"literal_text_all_w_t_and_m_t":"The average time in seconds before a new access attempt is to be performed after an access attempt was barred at access barring check for the same access category, see 5.3.14.5.","paragraph_zero_based":29930},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29931},{"literal_text_all_w_t_and_m_t":"–UAC-BarringPerCatList","paragraph_zero_based":29932},{"literal_text_all_w_t_and_m_t":"The IE UAC-BarringPerCatList provides access control parameters for a list of access categories.","paragraph_zero_based":29933},{"literal_text_all_w_t_and_m_t":"UAC-BarringPerCatList information element","paragraph_zero_based":29934},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29935},{"literal_text_all_w_t_and_m_t":"-- TAG-UAC-BARRINGPERCATLIST-START","paragraph_zero_based":29936},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29937},{"literal_text_all_w_t_and_m_t":"UAC-BarringPerCatList ::=           SEQUENCE (SIZE (1..maxAccessCat-1)) OF UAC-BarringPerCat","paragraph_zero_based":29938},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29939},{"literal_text_all_w_t_and_m_t":"UAC-BarringPerCat ::=               SEQUENCE {","paragraph_zero_based":29940},{"literal_text_all_w_t_and_m_t":"   accessCategory                       INTEGER (1..maxAccessCat-1),","paragraph_zero_based":29941},{"literal_text_all_w_t_and_m_t":"   uac-barringInfoSetIndex              UAC-BarringInfoSetIndex","paragraph_zero_based":29942},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29943},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29944},{"literal_text_all_w_t_and_m_t":"-- TAG-UAC-BARRINGPERCATLIST-STOP","paragraph_zero_based":29945},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29946},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29947},{"literal_text_all_w_t_and_m_t":"UAC-BarringPerCatList field descriptions","paragraph_zero_based":29948},{"literal_text_all_w_t_and_m_t":"accessCategory","paragraph_zero_based":29949},{"literal_text_all_w_t_and_m_t":"The Access Category according to TS 22.261 [25].","paragraph_zero_based":29950},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29951}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["8117cc23431f191e0dac3b2f575aa795b22e24e8f7e8d4bd00aedc85a06f6d0c","55f461107f913f87ffa7d16dfb04a4511ffe9b2e5a345e0e327fcab32d690b43","9560fc1452cff34ee401b24ed1db5a1b7c997898e0ae077991a8257c1442bb79","f486bef5750043d3051c87835e2f07b2a23190c27863f24965f2a92197c1a836","9b39482884abe613bfc46f7517292680f19144fb0bea4143d799d621554f11d3","44f3f9688dd1c035aea5bed9942621a0ae37b903ad5501964296d09b39f52253","982933f7ceb4341f8e0ecc824a690734a6ec1dc7924d097421b8576ed47e1327","98e8700ee8ed6cc20303832aab9b8aa36d74112a82cbfa5c22466641620b2447","606260ba56fd1022cfb64d4ab29dedbdcb1b822100fd102205e993afd01bcb41","4cab9bd2afe90f1c0d6236a18f4bcba8aa399701b2861f64f3c65c1d1197a544","6e04efa5c5e65ba09f8c885f07ee2600db913b9c833185820d48bc570a35819d","9a93a8eb285e7474b3f48e8314c7ad67ba56aca6c12d20ea00d49d56169c0f05","57f40caa0038c2cfa39c306f0f7fb1d01ba22a14393a09825b56cd6f60ebd319","d3bcb423c44d2e7b141b8286de2392076219b411d