{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"                    aggregationLevel4-r17       ENUMERATED {n0, n1, n2, n3, n4}                         OPTIONAL,   -- Need R","paragraph_zero_based":26952},{"literal_text_all_w_t_and_m_t":"                    aggregationLevel8-r17       ENUMERATED {n0, n1, n2}                                 OPTIONAL,   -- Need R","paragraph_zero_based":26953},{"literal_text_all_w_t_and_m_t":"                    aggregationLevel16-r17      ENUMERATED {n0, n1}                                     OPTIONAL    -- Need R","paragraph_zero_based":26954},{"literal_text_all_w_t_and_m_t":"                },","paragraph_zero_based":26955},{"literal_text_all_w_t_and_m_t":"                ...","paragraph_zero_based":26956},{"literal_text_all_w_t_and_m_t":"            }                                                                                           OPTIONAL    -- Need R","paragraph_zero_based":26957},{"literal_text_all_w_t_and_m_t":"        }","paragraph_zero_based":26958},{"literal_text_all_w_t_and_m_t":"    }                                                                                                   OPTIONAL,   -- Need R","paragraph_zero_based":26959},{"literal_text_all_w_t_and_m_t":"    searchSpaceGroupIdList-r17          SEQUENCE (SIZE (1.. 3)) OF INTEGER (0.. maxNrofSearchSpaceGroups-1-r17)  OPTIONAL,  -- Cond DedicatedOnly","paragraph_zero_based":26960},{"literal_text_all_w_t_and_m_t":"    searchSpaceLinkingId-r17            INTEGER (0..maxNrofSearchSpacesLinks-1-r17)                     OPTIONAL    -- Cond DedicatedOnly","paragraph_zero_based":26961},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":26962},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26963},{"literal_text_all_w_t_and_m_t":"-- TAG-SEARCHSPACE-STOP","paragraph_zero_based":26964},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26965},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26966},{"literal_text_all_w_t_and_m_t":"SearchSpace field descriptions","paragraph_zero_based":26967},{"literal_text_all_w_t_and_m_t":"common","paragraph_zero_based":26968},{"literal_text_all_w_t_and_m_t":"Configures this search space as common search space (CSS) and DCI formats to monitor.","paragraph_zero_based":26969},{"literal_text_all_w_t_and_m_t":"controlResourceSetId","paragraph_zero_based":26970},{"literal_text_all_w_t_and_m_t":"The CORESET applicable for this SearchSpace. Value 0 identifies the common CORESET#0 configured in MIB and in ServingCellConfigCommon. Values 1..maxNrofControlResourceSets-1 identify CORESETs configured in System Information or by dedicated signalling. The CORESETs with non-zero controlResourceSetId are configured in the same BWP as this SearchSpace except commonControlResourceSetExt which is configured by SIB20. If the field controlResourceSetId-r16 is present, UE shall ignore the controlResourceSetId (without suffix).","paragraph_zero_based":26971},{"literal_text_all_w_t_and_m_t":"dummy1, dummy2","paragraph_zero_based":26972},{"literal_text_all_w_t_and_m_t":"This field is not used in the specification. If received it shall be ignored by the UE.","paragraph_zero_based":26973},{"literal_text_all_w_t_and_m_t":"dci-Format0-0-AndFormat1-0","paragraph_zero_based":26974},{"literal_text_all_w_t_and_m_t":"If configured, the UE monitors the DCI formats 0_0 and 1_0 according to TS 38.213 [13], clause 10.1.","paragraph_zero_based":26975}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["d721e5caf66a9b38c70ac8339d7670fccc1fcb75ed5f931fa3f914c63e2b820d","78a548c24f2cad0187becc606e09367914ac5f1c29ab227941168c09ea441fee","fc00f26c666a72a8488717416d4fed5794e4a8898678a3671478451a31ffa3dd","6ff041245553905c41fa2cde54a75711a6f7cd2ad7c351fb3bc3db38006cd0d4","38df8674fda408659d85446dddaaec0eaeb9a2aa89001e96b35f56c47cfc0ee7","ff1405e30d428df19a09487a99cee6ac9fff979ac5a4d2d2933a041a3664c782","1ed22cdc74f8681035eef14d371c36dab7d3842e551be79117a30bc43c2df134","419e4541cdc103e5ef7fbb20ee37a31cef300819a59f6bc21f8d547156fed7ff","24da54b300f1460b5e9e1ef949eb25bf351e264cd13f1c970ac92f59d52974f7","5921c34b6206ff57e5fa75c947fc61fbe50b6ed8b4359d20a0e97b023466b66f","c0d61b803818474e8024ea9488bfcb79ad314befc59d37e66b579a5a7049a702","629ca377b51a30ef869a8597fce88f8417aa0bab19d7e70b9aac1831cd0e6c3c","61666ba11e025d89b018b96a8d9180a71f0873112d13378cc08e0230d08ce75f","be25959c1458fe3cd905d1bcbc7e3c6c5aafb8e4036cc56ba07af0c9a3c99496","0d6ae303c686e64ec35da3afd5a759c337529fd992eb887c51228c60be2c9d52","f3529d8c2ea8d2d6a606e68cda2a83b5872b97f98ce788915c91d5d96772fddf","a8bb01f1dc8502b4e6245ab50bd9f015c48ac17b7d840f6ce4f07c6503f23c20","a39cadd718d082ed5652feb5c2275b51a9f754078dac5fc0927e5af02e1b1417","09e4bbc34356be3aaad4ff789c47cf311543425fb04d67f507a79e94bede589a","c83d421d3fd011ecead55f5221d90cbe81b0e46db0da406c560f045d41c8015e","329b7fdd6c744456723329b4c8883ccdeb0eb5e881d07d5e9f10974f44d00b82","8e196b81a1e4034caa8073b8b7d39b58b72d9414815b523bd5ee6d509716e684","d24ecdc676417889436c36cfaed1ee7c42b781b92c836797e652b2cad5af7262","72039283224803ede1d3163d224730f93874fb9f909c6e7ce487c0ab7627d123"],"paragraph_range_zero_based":[26952,26975],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p26952"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"dci-Format2-0","paragraph_zero_based":26976},{"literal_text_all_w_t_and_m_t":"If configured, UE monitors the DCI format 2_0 according to TS 38.213 [13], clause 10.1, 11.1.1.","paragraph_zero_based":26977},{"literal_text_all_w_t_and_m_t":"dci-Format2-1","paragraph_zero_based":26978},{"literal_text_all_w_t_and_m_t":"If configured, UE monitors the DCI format 2_1 according to TS 38.213 [13], clause 10.1, 11.2.","paragraph_zero_based":26979},{"literal_text_all_w_t_and_m_t":"dci-Format2-2","paragraph_zero_based":26980},{"literal_text_all_w_t_and_m_t":"If configured, UE monitors the DCI format 2_2 according to TS 38.213 [13], clause 10.1, 11.3.","paragraph_zero_based":26981},{"literal_text_all_w_t_and_m_t":"dci-Format2-3","paragraph_zero_based":26982},{"literal_text_all_w_t_and_m_t":"If configured, UE monitors the DCI format 2_3 according to TS 38.213 [13], clause 10.1, 11.4","paragraph_zero_based":26983},{"literal_text_all_w_t_and_m_t":"dci-Format2-4","paragraph_zero_based":26984},{"literal_text_all_w_t_and_m_t":"If configured, UE monitors the DCI format 2_4 according to TS 38.213 [13], clause 11.2A.","paragraph_zero_based":26985},{"literal_text_all_w_t_and_m_t":"dci-Format2-5","paragraph_zero_based":26986},{"literal_text_all_w_t_and_m_t":"If configured, IAB-MT monitors the DCI format 2_5 according to TS 38.213 [13], clause 14.","paragraph_zero_based":26987},{"literal_text_all_w_t_and_m_t":"dci-Format2-6","paragraph_zero_based":26988},{"literal_text_all_w_t_and_m_t":"If configured, UE monitors the DCI format 2_6 according to TS 38.213 [13], clause 10.1, 10.3. DCI format 2_6 can only be configured on the SpCell.","paragraph_zero_based":26989},{"literal_text_all_w_t_and_m_t":"dci-Format2-7","paragraph_zero_based":26990},{"literal_text_all_w_t_and_m_t":"If configured, UE monitors the DCI format 2_7 according to TS 38.213 [13], clause 10.1, 10.4A.","paragraph_zero_based":26991},{"literal_text_all_w_t_and_m_t":"dci-Format4-0","paragraph_zero_based":26992},{"literal_text_all_w_t_and_m_t":"If configured, the UE monitors the DCI format 4_0 with CRC scrambled by MCCH-RNTI/G-RNTI according to TS 38.213 [13], clause [10.1].","paragraph_zero_based":26993},{"literal_text_all_w_t_and_m_t":"dci-Format4-1-AndFormat4-2","paragraph_zero_based":26994},{"literal_text_all_w_t_and_m_t":"If configured, the UE monitors the DCI format 4_1 and 4_2 with CRC scrambled by G-RNTI/G-CS-RNTI according to TS 38.213 [13], clause [11.1].","paragraph_zero_based":26995},{"literal_text_all_w_t_and_m_t":"dci-Format4-1","paragraph_zero_based":26996},{"literal_text_all_w_t_and_m_t":"If configured, the UE monitors the DCI format 4_1 with CRC scrambled by G-RNTI/G-CS-RNTI according to TS 38.213 [13], clause [10.1].","paragraph_zero_based":26997},{"literal_text_all_w_t_and_m_t":"dci-Format4-2","paragraph_zero_based":26998},{"literal_text_all_w_t_and_m_t":"If configured, the UE monitors the DCI format 4_2 with CRC scrambled by G-RNTI/G-CS-RNTI according to TS 38.213 [13], clause [10.1].","paragraph_zero_based":26999}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["ddac9688ea75607c5a10192c8617279b1fcf3394892a6ff30646d0ca9ed48c21","a5b58b812a18e4d6e40f85279b79c8f87277a2e6a8590c31e5dc14e901bb4b25","1a269b0e7628b30a1ad3d13f66f4aef1f296cd154036501ace5a4343e0d79a09","53c44468f19067907d089af7835834af474cb93d6406d46619f63f7b04865b55","c25ea43fecdc1c58afd2784a5183b7c7553afc83c614b7f96a027570a4628c2f","44c046911c17f106cdc4ebc958535d007470f757350d4cd75befece3fdab6d78","e78a623c6e72862964bac3c20f76ae73084ebe674b21d6a1771132b9962b07a9","8c92422d98974c658b720eb6f3b250da4f3a8bb1119bb457f3206094f36148d1","4e1b1df85799e2f9b964713be12c5fc5741abc5940fd0d109d741f9f4e0f5f7a","5b3bcd1557149f9e0c5601a89534f10335ec4dee7320418fb420f939c0734772","e4cbf4cd7ec880fc8e41864ce8f5fd598707cd473513edf47714155601afbed3","f7c6da27326b2f5e5fda6e04805a4f9e6eb3f88a0635b40928653bbfafeca648","c51a813f326593bba6bc020252a705d1bdc533368d65e40f65ec7b750945c891","551eac7e27dbce11e59b470307371cdec9b24f01aeabd1a3bfc51f8fc0bacd0c","c3bf0f4b9bf9768d7b64b6b1ee64c64e97080c54120b75ab0cac5f3779a55d9e","5736370ad9f207539b7f98c0fb04bdd1393685af97271bec4dbac8f82d815db7","6ee52dfa59dab8b4d560c55a4986aed1d210ce56c55c80d419172b7e6cc93855","922b579e4a44cb0e4a6ca7dc22137036231c23103c84f267da36f6242f79aa99","495171f576375b49569ba9f3cc2236b208f59263eabf0b72104010ea88ac7e46","460b77b1307bf0a69952b47da34d9e09d72f75b37edcc19d870f29f3b927e00a","23e474f7879a8baad4cb0d336c891f105cdefbe2a2df8dbc453c9e934806258d","47f7f739a76b629b3d84efd69320a381d080411ae3fb8520b4ba3c42a9dc1b34","b5051717a7fda7d912e197868f066a1c9286b04be67e663fad8fa04afe1ea128","9ba1cfa4426af90738bdf0a6210c2742b178c697ce26400de933df8fb2f9f981"],"paragraph_range_zero_based":[26976,26999],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p26976"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"dci-Formats","paragraph_zero_based":27000},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE monitors in this USS for DCI formats 0-0 and 1-0 or for formats 0-1 and 1-1.","paragraph_zero_based":27001},{"literal_text_all_w_t_and_m_t":"dci-FormatsExt","paragraph_zero_based":27002},{"literal_text_all_w_t_and_m_t":"If this field is present, the field dci-Formats is ignored and dci-FormatsExt is used instead to indicate whether the UE monitors in this USS for DCI format 0_2 and 1_2 or formats 0_1 and 1_1 and 0_2 and 1_2 (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13], clause 10.1). This field is not configured for operation with shared spectrum channel access in this release.","paragraph_zero_based":27003},{"literal_text_all_w_t_and_m_t":"dci-Formats-MT","paragraph_zero_based":27004},{"literal_text_all_w_t_and_m_t":"Indicates whether the IAB-MT monitors the DCI formats 2-5 according to TS 38.213 [13], clause 14.","paragraph_zero_based":27005},{"literal_text_all_w_t_and_m_t":"dci-FormatsSL","paragraph_zero_based":27006},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE monitors in this USS for DCI formats 0-0 and 1-0 or for formats 0-1 and 1-1 or for format 3-0 or for format 3-1 or for formats 3-0 and 3-1. If this field is present, the field dci-Formats is ignored and dci-FormatsSL is used.","paragraph_zero_based":27007},{"literal_text_all_w_t_and_m_t":"duration","paragraph_zero_based":27008},{"literal_text_all_w_t_and_m_t":"Number of consecutive slots that a SearchSpace lasts in every occasion, i.e., upon every period as given in the periodicityAndOffset. If the field is absent, the UE applies the value 1 slot, except for DCI format 2_0. The UE ignores this field for DCI format 2_0. The maximum valid duration is periodicity-1 (periodicity as given in the monitoringSlotPeriodicityAndOffset).","paragraph_zero_based":27009},{"literal_text_all_w_t_and_m_t":"For SCS 480 kHz and SCS 960 kHz, duration-r17 is used, and the configured duration is restricted to be an integer multiple of L slots and smaller than periodicity, where L is the configured length of the bitmap monitoringSlotsWithinSlotGroup-r17. If duration-r17 is absent, the UE assumes the duration in slots is equal to L. The maximum valid duration is periodicity-L.","paragraph_zero_based":27010},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27011},{"literal_text_all_w_t_and_m_t":"For IAB-MT, duration indicates number of consecutive slots that a SearchSpace lasts in every occasion, i.e., upon every period as given in the periodicityAndOffset. If the field is absent, the IAB-MT applies the value 1 slot, except for DCI format 2_0 and DCI format 2_5. The IAB-MT ignores this field for DCI format 2_0 and DCI format 2_5. The maximum valid duration is periodicity-1 (periodicity as given in the monitoringSlotPeriodicityAndOffset).","paragraph_zero_based":27012},{"literal_text_all_w_t_and_m_t":"freqMonitorLocations","paragraph_zero_based":27013},{"literal_text_all_w_t_and_m_t":"Defines an association of the search space to multiple monitoring locations in the frequency domain and indicates whether the pattern configured in the associated CORESET is replicated to a specific RB set, see TS 38.213, clause 10.1. Each bit in the bitmap corresponds to one RB set, and the leftmost (most significant) bit corresponds to RB set 0 in the BWP. A bit set to 1 indicates that a frequency domain resource allocation replicated from the pattern configured in the associated CORESET is mapped to the RB set.","paragraph_zero_based":27014},{"literal_text_all_w_t_and_m_t":"monitoringSlotPeriodicityAndOffset","paragraph_zero_based":27015},{"literal_text_all_w_t_and_m_t":"Slots for PDCCH Monitoring configured as periodicity and offset.","paragraph_zero_based":27016},{"literal_text_all_w_t_and_m_t":"For SCS 15, 30, 60, and 120 kHz and if the UE is configured to monitor:","paragraph_zero_based":27017},{"literal_text_all_w_t_and_m_t":"- DCI format 2_1, only the values 'sl1', 'sl2' or 'sl4' are applicable.","paragraph_zero_based":27018},{"literal_text_all_w_t_and_m_t":"- DCI format 2_0, only the values ′sl1′, ′sl2′, ′sl4′, ′sl5′, ′sl8′, ′sl10′, ′sl16′, and ′sl20′ are applicable (see TS 38.213 [13], clause 10).","paragraph_zero_based":27019},{"literal_text_all_w_t_and_m_t":"- DCI format 2_4, only the values 'sl1', 'sl2', 'sl4', 'sl5', 'sl8' and 'sl10' are applicable.","paragraph_zero_based":27020},{"literal_text_all_w_t_and_m_t":"For SCS 480 kHz and if the UE is configured to monitor:","paragraph_zero_based":27021},{"literal_text_all_w_t_and_m_t":"- DCI format 2_0, only the values 'sl4', 'sl8', 'sl16', 'sl20', 'sl32', 'sl40', 'sl64', and 'sl80' are applicable.","paragraph_zero_based":27022},{"literal_text_all_w_t_and_m_t":"- DCI format 2_1, only the values ′sl4′, ′sl8′, and ′sl16′ are applicable.","paragraph_zero_based":27023}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["952c228eb0dd7e12bacf843b9ebecffb1dcb3716295e8bc36eb6297ee9fc1d60","3a689a41be2b8c57aea6fce53becaab3dc372d708b2228f38ababf8e5435d6ef","330716cff8d3c872580dfbcbce8772cfb8334eb3fdcc8f48db8ed7a0bceb3ce7","b8fb9d17f6011e64fe68339d9c2e73f77b9f92d6584a70d61a2ee3c688026962","b7d05ef02291d58d04334293f4f25d90dda909956218fef803ba43c6751c07e1","31d0b720c704a92ac7ee739f540ba0b79c1f586ea15a50806e7e1394f3a63acd","e97a7342e51cb976b7aa0f54ff4a88cdad878d853f50eefcbc98f17e51bb9e87","ca71d2744bac20ce9ad476f2bc5415f2d96bc9e15eb546673d3f02b88d90385c","708a73d0181256f6e4ceafc272f1e3a7b3bd53b33c878fe1b05b8843c7b7a5e8","749037a9d7cafceff7a70b4fb3557145ce0fb2988cb5475217d8612bd9e6bf47","bc61bcfceaf27eb533f45676efaa87ce8593de38e14d0586fed59f83e4fc922c","fb4bcad5d09ec36683b605caf3e878e353459809ee24acf008a4fa379a5cecb5","61270ecc8fe81deaacca1dde81ea58c2071ec693c1860612fd238edcc6c5d7e1","9f2544234cfcc6390d7f69b0dab70b8fec4aec86d01e367e8f30e996883ffb14","27353289d9e9ea0ea6e363846cecc08d01968167f9e13154e12bfda0863bdc6c","6eb8fab1927139e7c8279819ee5e10796d052ab13e4c9fe39d39a37edb1213d1","3c9cbad431a315589958e4ecebd01c7bd75ecdb5e642a851340c939a5e9eb3c7","070bd8e1f963c7882ae00ff794e2b883de84cb718f594171fc5166a8652aceae","8dbb988da51e2f8fb77c1b02e31480b0390c687e7f24606538a8ad655ce1deb7","644c0c370e85c1160eaf6a6bd15a3c73686f73a14c1cadad44378cab8af8612f","5ea7cd0e9a505286707a47dc44b0f1a7588a8cf32d4d219896a91b64816caf54","56d85c05da18699f13d8bde20007d2d5d7f925b6d31b06e9324d76cbfb4282f9","f452a5a410f020305f3b4722f0f4389cc64d7915dac7e221f009f6289e6020a4","c2491cb39c1cb24f3c81f089f99341182c987cc6b21430ee170483b88db7eb1b"],"paragraph_range_zero_based":[27000,27023],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p27000"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"- DCI format 2_4, only the values 'sl4', 'sl8', 'sl16', 'sl20', 'sl32', 'sl40' are applicable.","paragraph_zero_based":27024},{"literal_text_all_w_t_and_m_t":"For SCS 960 kHz and if the UE is configured to monitor:","paragraph_zero_based":27025},{"literal_text_all_w_t_and_m_t":"- DCI format 2_0, only the values 'sl8', 'sl16', 'sl32', 'sl40', 'sl64', 'sl80', 'sl128', and 'sl160' are applicable.","paragraph_zero_based":27026},{"literal_text_all_w_t_and_m_t":"- DCI format 2_1, only the values ′sl8′, ′sl16′, and 'sl32' are applicable.","paragraph_zero_based":27027},{"literal_text_all_w_t_and_m_t":"- DCI format 2_4, only the values 'sl8', 'sl16', 'sl32', 'sl40', 'sl64', 'sl80' are applicable.","paragraph_zero_based":27028},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27029},{"literal_text_all_w_t_and_m_t":"For SCS 480 kHz and SCS 960 kHz, and the configured periodicity and offset are restricted to be an integer multiple of L slots, where L is the configured length of the bitmap provided by monitoringSlotsWithinSlotGroup-r17, i.e. for a given periodicity, the offset has a range of {0, L, 2*L, …, L*FLOOR(1/L*(periodicity-1))}.","paragraph_zero_based":27030},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27031},{"literal_text_all_w_t_and_m_t":"For IAB-MT, If the IAB-MT is configured to monitor DCI format 2_1, only the values 'sl1', 'sl2' or 'sl4' are applicable. If the IAB-MT is configured to monitor DCI format 2_0 or DCI format 2_5, only the values ′sl1′, ′sl2′, ′sl4′, ′sl5′, ′sl8′, ′sl10′, ′sl16′, and ′sl20′ are applicable (see TS 38.213, clause 10).","paragraph_zero_based":27032},{"literal_text_all_w_t_and_m_t":"If monitoringSlotPeriodicityAndOffset-v1710 is present, any previously configured monitoringSlotPeriodicityAndOffset is released, and if monitoringSlotPeriodicityAndOffset is present, any previously configured monitoringSlotPeriodicityAndOffset-v1710 is released.","paragraph_zero_based":27033},{"literal_text_all_w_t_and_m_t":"monitoringSlotsWithinSlotGroup","paragraph_zero_based":27034},{"literal_text_all_w_t_and_m_t":"Indicates which slot(s) within a slot group are configured for multi-slot PDCCH monitoring. The first (leftmost, most significant) bit represents the first slot in the slot group, the second bit represents the second slot in the slot group, and so on. A bit set to '1' indicates that the corresponding slot is configured for multi-slot PDCCH monitoring (see TS 38.213 [13], clause 10). The number of slots for multi-slot PDCCH monitoring is configured according to clause 10 in TS 38.213 [13].","paragraph_zero_based":27035},{"literal_text_all_w_t_and_m_t":"monitoringSymbolsWithinSlot","paragraph_zero_based":27036},{"literal_text_all_w_t_and_m_t":"The first symbol(s) for PDCCH monitoring in the slots configured for (multi-slot) PDCCH monitoring (see monitoringSlotPeriodicityAndOffset and duration). The most significant (left) bit represents the first OFDM in a slot, and the second most significant (left) bit represents the second OFDM symbol in a slot and so on. The bit(s) set to one identify the first OFDM symbol(s) of the control resource set within a slot. If the cyclic prefix of the BWP is set to extended CP, the last two bits within the bit string shall be ignored by the UE or IAB-MT.","paragraph_zero_based":27037},{"literal_text_all_w_t_and_m_t":"For DCI format 2_0, the first one symbol applies if the duration of CORESET (in the IE ControlResourceSet) identified by controlResourceSetId indicates 3 symbols, the first two symbols apply if the duration of CORESET identified by controlResourceSetId indicates 2 symbols, and the first three symbols apply if the duration of CORESET identified by controlResourceSetId indicates 1 symbol.","paragraph_zero_based":27038},{"literal_text_all_w_t_and_m_t":"See TS 38.213 [13], clause 10.","paragraph_zero_based":27039},{"literal_text_all_w_t_and_m_t":"For IAB-MT: For DCI format 2_0 or DCI format 2_5, the first one symbol applies if the duration of CORESET (in the IE ControlResourceSet) identified by controlResourceSetId indicates 3 symbols, the first two symbols apply if the duration of CORESET identified by controlResourceSetId indicates 2 symbols, and the first three symbols apply if the duration of CORESET identified by controlResourceSetId indicates 1 symbol.","paragraph_zero_based":27040},{"literal_text_all_w_t_and_m_t":"See TS 38.213 [13], clause 10.","paragraph_zero_based":27041},{"literal_text_all_w_t_and_m_t":"nrofCandidates-CI","paragraph_zero_based":27042},{"literal_text_all_w_t_and_m_t":"The number of PDCCH candidates specifically for format 2-4 for the configured aggregation level. If an aggregation level is absent, the UE does not search for any candidates with that aggregation level. The network configures only one aggregationLevel and the corresponding number of candidates (see TS 38.213 [13], clause 10.1).","paragraph_zero_based":27043},{"literal_text_all_w_t_and_m_t":"nrofCandidates-PEI","paragraph_zero_based":27044},{"literal_text_all_w_t_and_m_t":"The number of PDCCH candidates specifically for format 2-7 for the configured aggregation level.","paragraph_zero_based":27045},{"literal_text_all_w_t_and_m_t":"nrofCandidates-SFI","paragraph_zero_based":27046},{"literal_text_all_w_t_and_m_t":"The number of PDCCH candidates specifically for format 2-0 for the configured aggregation level. If an aggregation level is absent, the UE does not search for any candidates with that aggregation level. The network configures only one aggregationLevel and the corresponding number of candidates (see TS 38.213 [13], clause 11.1.1). For a search space configured with freqMonitorLocations-r16, only value ′n1′ is valid.","paragraph_zero_based":27047}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["a91edf5ea826ed27e4f581c863020eb7b85176f96e6822a9f25ca08fcdab9603","369fc4cbefda7c4c33874ac11b44a69c72e632ccf818b5b4ec46b38aba78ed1a","465d4673fda2da4a1b229a3224befbc50ab4ebd7cf4115bd5843606db6db765a","e923908482ea42309726322ea32d47a8f3c948166fcdfa96da89130a9a71ce41","ef1a65d0f37b5344a0df29e1a6b7c880eda4bae4eff614489d7c740c955f8ca2","124b2f78531345899e5039e88be5f792f24f43484500910a22974b692e78ec80","ddcd11e6baf03c4401a5d4353b905724eabfc79de136bd8f13e9434a264fb5ea","2852181fdbffdddfd06643828b18509a9f1a53e99f30d762ec0296a8438f4590","24af39607f9c3b1da73b7f294d65d28219cd34aa3f87242d7dde389f806ebcb5","ff0f855972134b40b29e9cda79ad02ba1c5d846cb2e33f3fcbb831b7ce993176","c6d608adcc7cbcfd3104f44c27659ba478a386ca655f8bacbb5d3edcc221cfcd","daf0af37be3375a67c5e0dcad28a3c24b5983ebffe241a3e68721c48267afc92","f1aeb3027053eccf1dca4b615e74490003eef882b196f664acbec44929ef93cf","3fd03ab1de51e43ef15dfffdab1c11ffdf4ac0b314b44ec0c9f368d61e8a18fe","98805a7023630a510771a3898aa2a2bf959874dea1b341e58b1c4388b9e7e246","6fd9b7f9d4719370056109491e4bfd3d47035d1caaee58ede0dbec795fdf80c7","c735838d9d3c916536b1353154aa4a045f08837dcf8001854818c33eeab43bdf","41bf1f55a45b4202138467fd59719593726e8c0df9dd6feb91e5dac2c30bfe42","f2ff924b0ef9526257037b9104542b6dda81f1c7baee3160d7ff578fa863e395","a18dcaa0d4365d0ea88846815bd61a1c7c26e182575121b263c3e33ea80b37c9","c97a5162bae8481e97b9e2e114980ba97422995a24982736460ae5cdbf2cdb6b","50bca4491780ee432480ce51ea9690b868efec1695d496891e2e448da3978872","d080af3314dce2b560fca80204b11beb12e1ed164aa169b8b3ec76ebc1d6888d","449ddf60b1c89d0f274df7d4103bd20ce5cdc4399c0eafec98b6e30e31a7f809"],"paragraph_range_zero_based":[27024,27047],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p27024"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"nrofCandidates","paragraph_zero_based":27048},{"literal_text_all_w_t_and_m_t":"Number of PDCCH candidates per aggregation level. The number of candidates and aggregation levels configured here applies to all formats unless a particular value is specified or a format-specific value is provided (see inside searchSpaceType). If configured in the SearchSpace of a cross carrier scheduled cell, this field determines the number of candidates and aggregation levels to be used on the linked scheduling cell (see TS 38.213 [13], clause 10).","paragraph_zero_based":27049},{"literal_text_all_w_t_and_m_t":"searchSpaceGroupIdList-r16, searchSpaceGroupIdList-r17","paragraph_zero_based":27050},{"literal_text_all_w_t_and_m_t":"List of search space group IDs which the search space is associated with. The network configures at most 2 search space groups per BWP where the group ID is either 0 or 1 if searchSpaceGroupIdList-r16 is included. The network configures at most 3 search space groups per BWP where the group ID is either 0, 1 or 2 if searchSpaceGroupIdList-r17 is included. And if searchSpaceGroupIdList-r17 is included, searchSpaceGroupIdList-r16 is ignored.","paragraph_zero_based":27051},{"literal_text_all_w_t_and_m_t":"searchSpaceId","paragraph_zero_based":27052},{"literal_text_all_w_t_and_m_t":"Identity of the search space. SearchSpaceId = 0 identifies the searchSpaceZero configured via PBCH (MIB) or ServingCellConfigCommon and may hence not be used in the SearchSpace IE. The searchSpaceId is unique among the BWPs of a Serving Cell. In case of cross carrier scheduling, search spaces with the same searchSpaceId in scheduled cell and scheduling cell are linked to each other. The UE applies the search space for the scheduled cell only if the DL BWPs in which the linked search spaces are configured in scheduling cell and scheduled cell are both active.","paragraph_zero_based":27053},{"literal_text_all_w_t_and_m_t":"For an IAB-MT, the search space defines how/where to search for PDCCH candidates for an IAB-MT where each search space is associated with one ControlResearchSet and for a scheduled cell in the case of cross carrier scheduling, except for nrofCandidates, all the optional fields are absent.","paragraph_zero_based":27054},{"literal_text_all_w_t_and_m_t":"SearchSpaceLinkingId","paragraph_zero_based":27055},{"literal_text_all_w_t_and_m_t":"This parameter is used to link two search spaces of same type in the same BWP. If two search spaces have the same SearchSpaceLinkingId UE assumes these search spaces are linked to PDCCH repetition REF. When PDCCH repetition is monitored in two linked search space (SS) sets, the UE does not expect a third monitored SS set to be linked with any of the two linked SS sets. The two linked SS sets have the same SS set type (USS/CSS). The two linked SS sets have the same DCI formats to monitor. For intra-slot PDCCH repetition: The two SS sets should have the same periodicity and offset (monitoringSlotPeriodicityAndOffset), and the same duration. For linking monitoring occasions across the two SS sets that exist in the same slot: The two SS sets have the same number of monitoring occasions within a slot and n-th monitoring occasion of one SS set is linked to n-th monitoring occasion of the other SS set. The following SS sets cannot be linked with another SS set for PDCCH repetition: SS set 0, searchSpaceSIB1, searchSpaceOtherSystemInformation, pagingSearchSpace, ra-SearchSpace, searchSpaceMCCH, searchSpaceMTCH, peiSearchSpace, and sdt-SearchSpace. SS set configured by recoverySearchSpaceId cannot be linked to another SS set for PDCCH repetition. When a scheduled serving cell is configured to be cross-carrier scheduled by a scheduling serving cell, two PDCCH candidates (with the same AL and candidate index associated with the scheduled serving cell) are linked only if the corresponding two SS sets in the scheduling serving cell are linked and two SS sets in the scheduled serving cell with the same SS set IDs are also linked.","paragraph_zero_based":27056},{"literal_text_all_w_t_and_m_t":"This parameter is not applicable to search space configured with dci-FormatsSL for monitoring format 3-0 or format 3-1 or for monitoring formats 3-0 and format 3-1.","paragraph_zero_based":27057},{"literal_text_all_w_t_and_m_t":"searchSpaceType","paragraph_zero_based":27058},{"literal_text_all_w_t_and_m_t":"Indicates whether this is a common search space (present) or a UE specific search space as well as DCI formats to monitor for.","paragraph_zero_based":27059},{"literal_text_all_w_t_and_m_t":"ue-Specific","paragraph_zero_based":27060},{"literal_text_all_w_t_and_m_t":"Configures this search space as UE specific search space (USS). The UE monitors the DCI format with CRC scrambled by C-RNTI, CS-RNTI (if configured), and SP-CSI-RNTI (if configured)","paragraph_zero_based":27061},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27062},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":27063},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":27064},{"literal_text_all_w_t_and_m_t":"DedicatedOnly","paragraph_zero_based":27065},{"literal_text_all_w_t_and_m_t":"In PDCCH-Config, the field is optionally present, Need R. Otherwise it is absent, Need R.","paragraph_zero_based":27066},{"literal_text_all_w_t_and_m_t":"Setup","paragraph_zero_based":27067},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new SearchSpace. It is optionally present, Need M, otherwise.","paragraph_zero_based":27068},{"literal_text_all_w_t_and_m_t":"Setup2","paragraph_zero_based":27069},{"literal_text_all_w_t_and_m_t":"This field is mandatory present when a new SearchSpace is set up, if the same SearchSpace ID is not included in searchSpacesToAddModListExt-r16 of the parent IE with the field searchSpaceType-r16 or searchSpaceType-r17 included. Otherwise it is optionally present, Need M.","paragraph_zero_based":27070},{"literal_text_all_w_t_and_m_t":"Setup3","paragraph_zero_based":27071}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["6e762ce96205a0fd288914db65d769d626070c4dffc9b13296959e5fb5f623ba","248a87072dd22ab19512404e5f09471803f7526c0667798c1785afb255818991","fb2f8aa59e4f2837f15a755b0ca967574bc0a600839730f87011f8359189dfeb","2db08024524d3cf2f8a82a71dca43912ecdecfd8aed9096f1c0bf3fcfaf1eb76","67b23ccec1cae4c6dd745f53334fae210622f2f62bfb4f58c6f5dafa3c82d610","3b099e32c7804aaa0bfbf6d97f97efead3818eb567ce88a46a550ca147011c67","44d177a061e6c3f6115951a5b1c28b612eadc6a8af26abd22216192b0d46b05b","7c71f6d29aae346a0b912ab5007710cfb03c7d6476e954531112ead87437af09","723ec05bf94b94710ddfa5015480c5dfe4809c96a1b8baf97618877df1bd4836","f789cabb472c9efc767c0190b26da64f8043056f928dd17b93aa3e6505b41d4e","d0bf0a9087e1eba203c49b94023b437d54764ab519ec7d6d859543a46808ac0d","80f92373d33a190df0f86925198193b1b0b80e634a92b5b738449fa6077f5c08","1ef9bbabaf6aefd62980c0a8c2f3f4aa4b74b1d4ffd1c229c98b84115f6ad13e","c59a57574cb364c28dda6e517452241c356ff44f3d103979ca4999c237b39736","9910e766d2d7aa17cae749b4c73413c152dee0db9b88749c603c66dc05a1d254","e59c614990a6af9e8dc9516dbcaaf1d31568173cfe73866b7e597eaeff6b9704","07d4cf3b44924411e3f5ccf970009c5708715565814f4cec9e07f025dbb1a6dd","ce801b25974d5af7375cfd29651c10f80ec8badac1e4e1450a01bb60608d90c6","8633d9dc306b840a24ba4cf54f52b1283d7a8892aef121a607576692c5476735","78223ea7ef3aa80abe337a96f935a2aef9ac1c7db22cdb2fbbbfa2934f4e90bd","b5149d9fba473f1c6a1d89f32a7e1a2d69277f179df8dd6cf7d59adf395dbbd2","dbeec3d448fa6691f855df93c6e1ea3e74beec0f81e7eb1c300a0407d659835b","39446a49f96fc32d9a95d5b7b3c3c514a47f38a396f9c7799bd41d2e2fddb928","2f23fe28d9d9f1ad1f814402e38efbfc18d715abf876dae599255de7d3da6d33"],"paragraph_range_zero_based":[27048,27071],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p27048"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is mandatory present when a new SearchSpace is set up, if the same SearchSpace ID is not included in searchSpacesToAddModListExt (without suffix) of the parent IE with the field searchSpaceType (without suffix) included.  Otherwise it is optionally present, Need M.","paragraph_zero_based":27072},{"literal_text_all_w_t_and_m_t":"Setup4","paragraph_zero_based":27073},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new SearchSpace if monitoringSlotPeriodicityAndOffset-v1710 is not included. It is optionally present, Need M, otherwise.","paragraph_zero_based":27074},{"literal_text_all_w_t_and_m_t":"Setup5","paragraph_zero_based":27075},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new SearchSpace if monitoringSlotPeriodicityAndOffset (without suffix) is not included. It is optionally present, Need M, otherwise.","paragraph_zero_based":27076},{"literal_text_all_w_t_and_m_t":"SetupOnly","paragraph_zero_based":27077},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new SearchSpace. It is absent, Need M, otherwise.","paragraph_zero_based":27078},{"literal_text_all_w_t_and_m_t":"SetupOnly2","paragraph_zero_based":27079},{"literal_text_all_w_t_and_m_t":"In PDCCH-Config, the field is optionally present upon creation of a new SearchSpace and absent, Need M upon reconfiguration of an existing SearchSpace.","paragraph_zero_based":27080},{"literal_text_all_w_t_and_m_t":"In PDCCH-ConfigCommon, the field is absent.","paragraph_zero_based":27081},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27082},{"literal_text_all_w_t_and_m_t":"–SearchSpaceId","paragraph_zero_based":27083},{"literal_text_all_w_t_and_m_t":"The IE SearchSpaceId is used to identify Search Spaces. The ID space is used across the BWPs of a Serving Cell. The search space with the SearchSpaceId = 0 identifies the search space configured via PBCH (MIB) and in ServingCellConfigCommon (searchSpaceZero). The number of Search Spaces per BWP is limited to 10 including the common and UE specific Search Spaces.","paragraph_zero_based":27084},{"literal_text_all_w_t_and_m_t":"SearchSpaceId information element","paragraph_zero_based":27085},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27086},{"literal_text_all_w_t_and_m_t":"-- TAG-SEARCHSPACEID-START","paragraph_zero_based":27087},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27088},{"literal_text_all_w_t_and_m_t":"SearchSpaceId ::=                   INTEGER (0..maxNrofSearchSpaces-1)","paragraph_zero_based":27089},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27090},{"literal_text_all_w_t_and_m_t":"-- TAG-SEARCHSPACEID-STOP","paragraph_zero_based":27091},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27092},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27093},{"literal_text_all_w_t_and_m_t":"–SearchSpaceZero","paragraph_zero_based":27094},{"literal_text_all_w_t_and_m_t":"The IE SearchSpaceZero is used to configure SearchSpace#0 of the initial BWP (see TS 38.213 [13], clause 13).","paragraph_zero_based":27095}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["1a4aa54e0c55fbb9707f3a3b471cdbeccd927ae0eb1d0ead7371d4e8369e6350","92601efa605ec751d9c616dad3da014f3b2253b16abf1a23977d7386f97f26fe","c15306ace626c2a9254a39f31c97d5e8e43fbcd7100ad4dd9fec9226b0b2539b","9c7c2f18db2b670608d598452035f043f08f643d90af23345c6d90596cdc7964","620a27c8d53e4bdc7abd31eb35e5f8cd1d56b41270b7e9e470cd5bd35fb70703","8dfa0367c4454995dcc72ea59c627d8a094b1d94d99e0e2f027bb67e3d31699e","19a11c57e75c09d0eac85410f13a0705977b08acfb3455abdd744e3a4a249e4d","576a34d34e855d8292fc58b5bd7147f1c2aa78f8bcf413a8c7f48ff00a2d525c","fe63ee06924e7401fb3b260fefa5b9123cc17095f9d01ca27fb45198ffac71e8","b2952705e44a96c441e125e2000406e8c104012800fe85ccce16f74e27c3ac38","b7cecf1a32f583449ed8f1eaa7e46a99f0850936ac5f95f19a5bbee1d8a9acca","03e47417eedcdacb72e5a42aaa7f7e13926a3df16d5340786d86a62c44679bc9","fe516dbd760394fcb634fc30d9733466473848942a22ee9ed8ca50f098df656b","59d97ac3ee69174c3ff74fb2507705b37f96532fa6e962ae4c7b0f7779cd255e","51bd3301e9cd51cd68b6a2c86c8e934cc9e3875fb5eb31c6c3faec54ac39deed","b48f8dd2160f7bbfbb4e80d26a34b53bdcf47aa80484eb455c17c90b852baa6f","268c6a7373b4031a2f0e933d16e3f9b4187775a8f9fd0314dd298bcfcddc28e1","4ffe1a8f301bc6532c0a58e427ac7042f04c97cdc4662bf3668de20216ca2bbb","c112f610de67d02dabb30f829a12b96007daba9001b8ed94ff9a6c387df31935","5c41560438f9e32f4cf8f63fe6bd210ebe1c37097204424079114e6a7048856f","0e705ca3099657a170b236471188abf99773b226e501d0218bffb11c8de7a43e","76c25610f7a599a61dcf5a9088aed678dd6c5341e624cfd5f929dd58613549f8","d5227026352598693c052291cda3e4f072a498f0ea32ba2d48c960196093f85d","0ff9ec7e7e60a7ff267533990874999dd42b9536afd1c3e2b95dcf69e216f30d"],"paragraph_range_zero_based":[27072,27095],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p27072"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SearchSpaceZero information element","paragraph_zero_based":27096},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27097},{"literal_text_all_w_t_and_m_t":"-- TAG-SEARCHSPACEZERO-START","paragraph_zero_based":27098},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27099},{"literal_text_all_w_t_and_m_t":"SearchSpaceZero ::=                 INTEGER (0..15)","paragraph_zero_based":27100},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27101},{"literal_text_all_w_t_and_m_t":"-- TAG-SEARCHSPACEZERO-STOP","paragraph_zero_based":27102},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27103},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27104},{"literal_text_all_w_t_and_m_t":"–SecurityAlgorithmConfig","paragraph_zero_based":27105},{"literal_text_all_w_t_and_m_t":"The IE SecurityAlgorithmConfig is used to configure AS integrity protection algorithm and AS ciphering algorithm for SRBs and DRBs.","paragraph_zero_based":27106},{"literal_text_all_w_t_and_m_t":"SecurityAlgorithmConfig information element","paragraph_zero_based":27107},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27108},{"literal_text_all_w_t_and_m_t":"-- TAG-SECURITYALGORITHMCONFIG-START","paragraph_zero_based":27109},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27110},{"literal_text_all_w_t_and_m_t":"SecurityAlgorithmConfig ::=         SEQUENCE {","paragraph_zero_based":27111},{"literal_text_all_w_t_and_m_t":"    cipheringAlgorithm                  CipheringAlgorithm,","paragraph_zero_based":27112},{"literal_text_all_w_t_and_m_t":"    integrityProtAlgorithm              IntegrityProtAlgorithm          OPTIONAL,   -- Need R","paragraph_zero_based":27113},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":27114},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27115},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27116},{"literal_text_all_w_t_and_m_t":"IntegrityProtAlgorithm ::=          ENUMERATED {","paragraph_zero_based":27117},{"literal_text_all_w_t_and_m_t":"                                        nia0, nia1, nia2, nia3, spare4, spare3,","paragraph_zero_based":27118},{"literal_text_all_w_t_and_m_t":"                                        spare2, spare1, ...}","paragraph_zero_based":27119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["54ef84ab449715a75c73503b1a1a477d37754f8e520b37a2f940f86d5e522069","b22f659c9df3c86dc72fd83e0d0db22775f602460a77e14945856e866fe16e46","0bddb9cd508f3d5a07c9ac62c94f07957cceeea947f997e9a1e157472b503dae","e593999bbd2fac59c5af3ef84e7994883719f2bc2aa3364fb8cca4d3eaa1bf17","de14d954fc2c309f269864a72bbf6a2952a84daf98b893a5aa02b17e2bf53eec","999468e9cf06ba4b65d04c7a48531459e2affc7dc1b4e7e64e0d165d96a11475","caaa5f57c8c87d970f2be50144b9c8a1042e89b3ce6ec1861c3a9347b2609af5","1a71dee93025fcaaf8d0c3157055cb9ee1cd80f7d277727673c35378a8c9bfc6","a7e4efc96b75231cbbf0756f8dd211453e73f93049a68bffb90242fb16e47526","46985a2218f412c30a328e2a5cdddb42dfafb96f1691283e3de5af0c77bda807","6f1f3b1a4916076eac2e8e5f4b02e0a3ec58bb3b34ab7ef9d31ecec94289407c","f9de4f32c4d7200cd68d450eb5d8fe126f7dbfc44baea6170b3c186c5e5d18ad","47f9a9c7a9d73e68a8a8501bcad7609135a704a88ec64054ce1ab077ac74eae4","6dbc111ee5f7682b71185bc650cf260be99259c9ad81f00b931b9b8bef16c0b4","eb3412c4daa00c813b41b0e115768008c18bdbff5e1cbffbd080b4b1172a4ece","2cc71f268aad92463d8b0e8d4095d7b910c3ccd95b49fdacf2b4c8252017ea04","238464da28cc4a41b07ff71db869c90b332d6eb8b8cc787a04ef8004f4e02940","08dc9f1f994990147f6e82cf780e16142e08ab4b97996ed35ee91d3dc787b4f9","fa3a8a792df1422fb500515187a107ee9e1f8a8bea45c3f608240d86572b3952","eec6e2f4d8c86da88aa5e5b6e959507d117908fa596b717d5bf3da97b52d2a9c","ac5aa3c2f9e155e60d136e7a74849045ea207cf03143c2c35dc158a0fe12cbe9","7358f7291184065b9bb8efa9d3a804c8e2d586d264b8e0e2ab4fabb520b4827a","cb2eae9248f060de25326a76c4b1fb7fb7b81e488d34631cb3594b422f885f17","c09e88088775c1e5fdbf5e18a07905e8de4f4248eab55b1d62d2620d6c877fb2"],"paragraph_range_zero_based":[27096,27119],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p27096"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27120},{"literal_text_all_w_t_and_m_t":"CipheringAlgorithm ::=              ENUMERATED {","paragraph_zero_based":27121},{"literal_text_all_w_t_and_m_t":"                                        nea0, nea1, nea2, nea3, spare4, spare3,","paragraph_zero_based":27122},{"literal_text_all_w_t_and_m_t":"                                        spare2, spare1, ...}","paragraph_zero_based":27123},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27124},{"literal_text_all_w_t_and_m_t":"-- TAG-SECURITYALGORITHMCONFIG-STOP","paragraph_zero_based":27125},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27126},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27127},{"literal_text_all_w_t_and_m_t":"SecurityAlgorithmConfig field descriptions","paragraph_zero_based":27128},{"literal_text_all_w_t_and_m_t":"cipheringAlgorithm","paragraph_zero_based":27129},{"literal_text_all_w_t_and_m_t":"Indicates the ciphering algorithm to be used for SRBs and DRBs, as specified in TS 33.501 [11]. The algorithms nea0-nea3 are identical to the LTE algorithms eea0-3. The algorithms configured for all bearers using master key shall be the same, and the algorithms configured for all bearers using secondary key, if any, shall be the same. If UE is connected to E-UTRA/EPC, this field indicates the ciphering algorithm to be used for RBs configured with NR PDCP, as specified in TS 33.501 [11].","paragraph_zero_based":27130},{"literal_text_all_w_t_and_m_t":"integrityProtAlgorithm","paragraph_zero_based":27131},{"literal_text_all_w_t_and_m_t":"Indicates the integrity protection algorithm to be used for SRBs and DRBs, as specified in TS 33.501 [11]. The algorithms nia0-nia3 are identical to the E-UTRA algorithms eia0-3. The algorithms configured for all bearers using master key shall be the same and the algorithms configured for all bearers using secondary key, if any, shall be the same. The network does not configure nia0 except for unauthenticated emergency sessions for unauthenticated UEs in LSM (limited service mode).","paragraph_zero_based":27132},{"literal_text_all_w_t_and_m_t":"If UE is connected to E-UTRA/EPC, this field indicates the integrity protection algorithm to be used for SRBs configured with NR PDCP as specified in TS 33.501 [11], and DRBs configured with integrity protection as specified in TS 33.401 [30]. The network does not configure nia0 for SRB3.","paragraph_zero_based":27133},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27134},{"literal_text_all_w_t_and_m_t":"–SemiStaticChannelAccessConfig","paragraph_zero_based":27135},{"literal_text_all_w_t_and_m_t":"The IE SemiStaticChannelAccessConfig is used to configure channel access parameters when the network is operating in semi-static channel access mode (see clause 4.3 in TS 37.213 [48].","paragraph_zero_based":27136},{"literal_text_all_w_t_and_m_t":"SemiStaticChannelAccessConfig information element","paragraph_zero_based":27137},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27138},{"literal_text_all_w_t_and_m_t":"-- TAG-SEMISTATICCHANNELACCESSCONFIG-START","paragraph_zero_based":27139},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27140},{"literal_text_all_w_t_and_m_t":"SemiStaticChannelAccessConfig-r16 ::=    SEQUENCE {","paragraph_zero_based":27141},{"literal_text_all_w_t_and_m_t":"    period-r16                               ENUMERATED {ms1, ms2, ms2dot5, ms4, ms5, ms10}","paragraph_zero_based":27142},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["fd43ec3d929c3d3415d89ebd565cea66a519721a1e815fd4fefbf8d83a87c6ce","2e5cbfa7c41d15d8c6992b6a15a2200f3ecd863c4d4ce1cafc1a3841e97c917d","884ec607c768535bd16df688a6ee69e47c6c903a04a63bc9204e8363f34dfc96","ec1cf987b69470ba7c8d17891890746b33e148b584503c69343517551f33c69e","cb41931481a3ac10dba79bb46545880b9f6df1982a8d83ba1bc80c955d257530","122c925ccab443a545fe595dde8b63dbbf3c27acbbebd3bbd9c793bd93220447","4db4c39b6a7bba9bcaf3376095340022a158d08e3ce6a4c359cc2ffb7f2c08d7","7333120635ba4f6035bfc6ceeb2fd450b804f91fb3d2595c032c445c7852a1ba","6f041ce000cddb150bceeb4286bb81a561804b8ae9dedc204ffa11c5e7287f41","4676ed563d3c8f2d73ee2c35d6e88429f26e28e461c1cc44ba608f58806df4b8","f232070ca20201c3a18dbd293c6e9a090032174ee3a47e008f5436c57a6249ba","3be1ae39968a5e71cd28469ad1328023cb2461e33ffd86b4d77edc9afa8c9299","f6121ac764afc1111977ae4ed5a3b25f866827f6d3a260c9970a2dccc1274c3f","8268222a38e184ce16cc78fa1f93a5c17507c423c1febf8a8813be0a9c08e7bd","d444ae191d06ad01d1ca7fab2bd130697dbeeef14627e0c38cd00cd9f80fe38d","c9dd211edb3fe2f7647496d251f14bc2a14542c46549904e3dfefaf53344435c","ab69d25aea2911b3c7d96ea412b66938a3fb96a8373e18cc3b9b48ad885eea42","0cb914bb4d4581b661d8908d5365c927bcc8ba75f0c2ea2fcef923bbf08883f7","41ca8a9080089a2e219530987ff71f7ec472112a5d8a68a85ce8660edc92066b","64d1559c3ffa845cf5089973c189037847cae05590a901bc80aa02b2febe4391","ef7c2ae85f7698491aa13d647f8a6ec0f170edba3a0e9fee91f51171edfa6548","dc09323ea73a488212f6e8044488b033efd02ef87c3ebafb6ab379bc199ffbd5","4ea63ca9d448ac0fc4063211b74d30739a3b4b8788ccddbfce70f603c4e8d35a","1a1130df172ba262f6a698c7f0c2fd170534269e6a90f6314ed5133ff71f46ff"],"paragraph_range_zero_based":[27120,27143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p27120"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27144},{"literal_text_all_w_t_and_m_t":"-- TAG-SEMISTATICCHANNELACCESSCONFIG-STOP","paragraph_zero_based":27145},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27146},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27147},{"literal_text_all_w_t_and_m_t":"SemiStaticChannelAccessConfig field descriptions","paragraph_zero_based":27148},{"literal_text_all_w_t_and_m_t":"period","paragraph_zero_based":27149},{"literal_text_all_w_t_and_m_t":"Indicates the periodicity of the semi-static channel access mode (see TS 37.213 [48], clause 4.3). Value ms1 corresponds to 1 ms, value ms2 corresponds to 2 ms, value ms2dot5 corresponds to 2.5 ms, and so on.","paragraph_zero_based":27150},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27151},{"literal_text_all_w_t_and_m_t":"–SemiStaticChannelAccessConfigUE","paragraph_zero_based":27152},{"literal_text_all_w_t_and_m_t":"The IE SemiStaticChannelAccessConfigUE is used to configure channel access parameters for UE initiated semi-static channel access.","paragraph_zero_based":27153},{"literal_text_all_w_t_and_m_t":"SemiStaticChannelAccessConfigUE information element","paragraph_zero_based":27154},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27155},{"literal_text_all_w_t_and_m_t":"-- TAG-SEMISTATICCHANNELACCESSCONFIGUE-START","paragraph_zero_based":27156},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27157},{"literal_text_all_w_t_and_m_t":"SemiStaticChannelAccessConfigUE-r17 ::=    SEQUENCE {","paragraph_zero_based":27158},{"literal_text_all_w_t_and_m_t":"    periodUE-r17                               ENUMERATED {ms1, ms2, ms2dot5, ms4, ms5, ms10, spare2, spare1},","paragraph_zero_based":27159},{"literal_text_all_w_t_and_m_t":"    offsetUE-r17                               INTEGER (0..559)","paragraph_zero_based":27160},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27161},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27162},{"literal_text_all_w_t_and_m_t":"-- TAG-SEMISTATICCHANNELACCESSCONFIGUE-STOP","paragraph_zero_based":27163},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27164},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27165},{"literal_text_all_w_t_and_m_t":"SemiStaticChannelAccessConfigUE field descriptions","paragraph_zero_based":27166},{"literal_text_all_w_t_and_m_t":"periodUE","paragraph_zero_based":27167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["d5983fe4942498b5b37ceafcf7cdd1aac343ec4127779793bbe7e4704fc3c9a3","86410bbfd78577e90b5876abea7889c2ee7f94edf5f9ec3bfc65bbc01ace7142","fa3f8533c96ca4aa704c14c026ff67f607d460d1a15e17e599ed9213151f2086","73a100fa337bb314ce2fa96daf538fedc42c56e7124fbb36fbe2596484db4903","241ad95c6acf28807054eb00b10e400dff9b8ffb5344ef9969d1a5547e97b1d2","c214765cbc2c74dae324d1804a758680d44ad511507fa6ab188281eee6845b0e","abea99e062a54f2d2821d86caf39fe6d59f40e29fb7a8f042f14c3feb317324f","929764769805abd3d5aad907d78921bb12f006f9749cf5e84a86b9435a3653ea","11bcda51e2ff5a01cfdea2a624e7586becd8dbf727422f5c921492776abde983","7838fae9c811e6a12a59169b72940cfe10004b7aef46c364bce7ae20a5e59ced","27f42f22bcac8fef92739e864be2f6813a167c53baee44defe6021c34f1a9cfa","541bf6b15a8e919b3ae9125148790de67b6786059b9d60c501c2e13f5e1b3997","ecc3246f2c1dc0ed71d89331d1e92f818e41c173821edf07508a55c4994b6c0a","c046828330122f47f60ddfe93b2236a9041a9bb23142c2f12c4a629b7dbd893f","01f355d40cf7cff8ca43da5e8fc01b3e1a41a9ce680651a8b5d80d8e5decee1a","eeac263e68375bc7b901eee30735193fb0d2782c7b5520c4792d480127d2d2ba","2b4afcd65a9a10f10803a93a387b34b1bc42d2a5665cf9992c84450724ffb1ac","56223767295036f8b75190d49b42eee93c2520616219777e987a86e5ba362045","d43962cdcd3318489a51b56695fc3455870ae2adc35d535daf82cb5b2c2043c0","b23169bb2b4f1699bbc3edd4efed0eae449b7bb757673eb3a6c309d2ab8f472d","223147b513a0227428e2a1fa7e5e2f7e656f2e2026d014fd29e248b295a0ee99","1be92502a2d04c6d6c3e82102877e536655ebaa52ca8d499a59f7b325f3fab6e","ab32689fd7b2375e0b48d6d1d28e30effb5daad219203a111ec46e5c03c3f240","a9e23c508f1d22108d5d82e54da9f1ab165dc6fb431f731c66ceae9fb7ed7dcf"],"paragraph_range_zero_based":[27144,27167],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p27144"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the period of a channel occupancy that the UE can initiate as described in TS 37.213 [48], clause 4.3. Value ms1 corresponds to 1 ms, value ms2 corresponds to 2 ms, value ms2dot5 corresponds to 2.5 ms, and so on.","paragraph_zero_based":27168},{"literal_text_all_w_t_and_m_t":"offsetUE","paragraph_zero_based":27169},{"literal_text_all_w_t_and_m_t":"Indicates the number of symbols from the beginning of the even indexed radio frame to the start of the first period within that radio frame that the UE can initiate a channel occupancy (see TS 37.213 [48], clause 4.3), based on the smallest SCS among the configured SCSs in the serving cell. The offset duration indicated by this field is less than the period duration indicated by periodUE. The maximum value is 139, 279 and 559 for 15, 30 and 60 kHz subcarrier spacing, respectively.","paragraph_zero_based":27170},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27171},{"literal_text_all_w_t_and_m_t":"–Sensor-LocationInfo","paragraph_zero_based":27172},{"literal_text_all_w_t_and_m_t":"The IE Sensor-LocationInfo is used by the UE to provide sensor information.","paragraph_zero_based":27173},{"literal_text_all_w_t_and_m_t":"Sensor-LocationInfo information element","paragraph_zero_based":27174},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27175},{"literal_text_all_w_t_and_m_t":"-- TAG-SENSORLOCATIONINFO-START","paragraph_zero_based":27176},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27177},{"literal_text_all_w_t_and_m_t":"Sensor-LocationInfo-r16 ::= SEQUENCE {","paragraph_zero_based":27178},{"literal_text_all_w_t_and_m_t":"    sensor-MeasurementInformation-r16    OCTET STRING    OPTIONAL,","paragraph_zero_based":27179},{"literal_text_all_w_t_and_m_t":"    sensor-MotionInformation-r16         OCTET STRING    OPTIONAL,","paragraph_zero_based":27180},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":27181},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27182},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27183},{"literal_text_all_w_t_and_m_t":"-- TAG-SENSORLOCATIONINFO-STOP","paragraph_zero_based":27184},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27185},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27186},{"literal_text_all_w_t_and_m_t":"Sensor-LocationInfo field descriptions","paragraph_zero_based":27187},{"literal_text_all_w_t_and_m_t":"sensor-MeasurementInformation","paragraph_zero_based":27188},{"literal_text_all_w_t_and_m_t":"This field provides barometric pressure measurements as Sensor-MeasurementInformation defined in TS 37.355 [49]. The first/leftmost bit of the first octet contains the most significant bit.","paragraph_zero_based":27189},{"literal_text_all_w_t_and_m_t":"sensor-MotionInformation","paragraph_zero_based":27190},{"literal_text_all_w_t_and_m_t":"This field provides motion sensor measurements as Sensor-MotionInformation defined in TS 37.355 [49]. The first/leftmost bit of the first octet contains the most significant bit.","paragraph_zero_based":27191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["4cd67fb342c37eb15bb6bdc617740d8b2880a8ade938cf5b1527bc49af95cf77","d6deba39bdc237e5799d0bbd7409a1034e7c4b174f207cbb3c0eb3bc61269a61","6ba67e683be8d02cd953823662ad4a724a70bc10ca37b9eba3db1f42565c5f8a","738ede053cf2700671210afb64220306db5ef95fe85022c8171c901965a81f4d","a54653afe3a428ddab0cda9fca7d4d1f87a5547281b2a800b9a5be694fd59f21","ffa623b5252