ragraph_zero_based":43696},{"literal_text_all_w_t_and_m_t":"            spare3 NULL, spare2 NULL, spare1 NULL","paragraph_zero_based":43697},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":43698},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture        SEQUENCE {}","paragraph_zero_based":43699},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":43700},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":43701},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43702},{"literal_text_all_w_t_and_m_t":"MeasurementTimingConfiguration-IEs ::=  SEQUENCE {","paragraph_zero_based":43703}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["07b315aa97976aee262a2b3cdc9e77507214dde0937da24d46351c53a7d80e77","1ce23e7aa35443699fb82cbc13e5a05ecedbe66a5e01f0df30bbbc54ef179e2b","a9eda536daf7ec25b630ce1e3f4799ce009114aef27213d07f75611317b74f9f","0aa3b91745d85d158faf04d0989b5e2acbea8f1a7dab61a3e62a93d5d10177cb","4ca7771dbf316ae6b5daa2ae601998d1b559324a395c70ffc8bae1c89a7a9e8f","4f9eade2b89e423e5b9cc6b0f89e10c7d4ec9f1ada543318de8b81a8e789a42e","7df9ae5f916d8aceb30a8115bcec5b9404ea0f23a020b174c2384877ad864b78","3c15e91c2fffb6478f7398e5af59577ec60ffc113ac9c8c3df24fa01d863a872","9f0db8114d17d709a4e2be10840f7809e763784d3c772f46f9bb4f3582c10069","ccc268539c8bee5527d4d5d671c4126afc8f4885749fa54ea7227a7471ffe1c2","d82c4469558126d45d34291927bc0dfbeeaa505cc5e4d1a70fc22db2ab70b5c7","e7ea986fe5bf4e16e899c08bf10e4fee71e12944a60321383ae4f10ce5bf4d1d","9b219419d239905fe8fbdecb255d0e7af6acea0d3a0dba5b1e88af4a09488b72","5ad996f3fbb3af9d5e8798350e24de05b6850562c211deda19358112ca94a997","2586cd08c661612d77ba673efe21a8243148e6f5442dbbb9765c05e0fa45