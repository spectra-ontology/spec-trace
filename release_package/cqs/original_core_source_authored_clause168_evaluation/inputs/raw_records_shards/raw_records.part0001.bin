{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        ms80-r17                            INTEGER (0..79),","paragraph_zero_based":20904},{"literal_text_all_w_t_and_m_t":"        ms160-r17                           INTEGER (0..159),","paragraph_zero_based":20905},{"literal_text_all_w_t_and_m_t":"        ms320-r17                           INTEGER (0..319),","paragraph_zero_based":20906},{"literal_text_all_w_t_and_m_t":"        ms640-r17                           INTEGER (0..639),","paragraph_zero_based":20907},{"literal_text_all_w_t_and_m_t":"        ms1280-r17                          INTEGER (0..1279),","paragraph_zero_based":20908},{"literal_text_all_w_t_and_m_t":"        ms2560-r17                          INTEGER (0..2559),","paragraph_zero_based":20909},{"literal_text_all_w_t_and_m_t":"        ms5120-r17                          INTEGER (0..5119),","paragraph_zero_based":20910},{"literal_text_all_w_t_and_m_t":"        ...","paragraph_zero_based":20911},{"literal_text_all_w_t_and_m_t":"    }                                                                                  OPTIONAL -- Cond periodic","paragraph_zero_based":20912},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":20913},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20914},{"literal_text_all_w_t_and_m_t":"MUSIM-Starting-SFN-AndSubframe-r17 ::= SEQUENCE {","paragraph_zero_based":20915},{"literal_text_all_w_t_and_m_t":"    starting-SFN-r17                       INTEGER (0..1023),","paragraph_zero_based":20916},{"literal_text_all_w_t_and_m_t":"    startingSubframe-r17                   INTEGER (0..9)","paragraph_zero_based":20917},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":20918},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20919},{"literal_text_all_w_t_and_m_t":"-- TAG-MUSIM-GAPINFO-STOP","paragraph_zero_based":20920},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":20921},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20922},{"literal_text_all_w_t_and_m_t":"MUSIM-GapInfo field descriptions","paragraph_zero_based":20923},{"literal_text_all_w_t_and_m_t":"musim-GapLength","paragraph_zero_based":20924},{"literal_text_all_w_t_and_m_t":"Indicates the length of the UE's MUSIM gap as specified in TS 38.133 [14] clause 9.1.10. This field is mandatory present for both periodic gap and aperiodic gap preference indication.","paragraph_zero_based":20925},{"literal_text_all_w_t_and_m_t":"musim-GapRepetitionAndOffset","paragraph_zero_based":20926},{"literal_text_all_w_t_and_m_t":"Indicates the gap repetition period in ms and gap offset in number of subframes for the periodic MUSIM gap as specified in TS 38.133 [14] clause 9.1.10. This field is mandatory present for the periodic MUSIM gap preference indication.","paragraph_zero_based":20927}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["83f33dd6a973e89e3e31ef7725b85eaff360a32a7bba5d51fc268987ccf7fc8f","7bd55832e4bc59a8de9002b90c3d806e04bf634738e0225102ae2a1533da7b20","1ed98a45323f488f7034b8c1b4c5313b00629d9d85000d123ab387872b134beb","75b55ccd49cdb8a2dd60681f58bd9b9958a18ef6a88e312f871367ddeb427b4f","0b2c003063dc3f872494d0bb6678570ddc536ff3f2e288e49a029de8affa2102","55478981d066a99926a34bdc180e7c57e8fe6ca07781295448e6b701e06cd2a2","ca9d20d328e5257c1207f58d82614b3df814d19b11c60c285bca59ac7c8d0ecc","dafdb60650ad08a61db57a40cadd40d1d240d20dcf010c46ee2ec671dd430daf","d0f7145bc262b94a06c775bad73a0f058f016337730a3ef484f85319834982bc","cbbd1d32fc48e4c47e9d3b809dfcc44eabcacf15d23a7e50acc40c8c6fab722