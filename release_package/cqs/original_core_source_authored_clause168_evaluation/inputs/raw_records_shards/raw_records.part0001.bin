{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11208},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11209},{"literal_text_all_w_t_and_m_t":"-- TAG-SCGFAILUREINFORMATION-STOP","paragraph_zero_based":11210},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":11211},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11212},{"literal_text_all_w_t_and_m_t":"SCGFailureInformation field descriptions","paragraph_zero_based":11213},{"literal_text_all_w_t_and_m_t":"measResultFreqList","paragraph_zero_based":11214},{"literal_text_all_w_t_and_m_t":"The field contains available results of measurements on NR frequencies the UE is configured to measure by measConfig.","paragraph_zero_based":11215},{"literal_text_all_w_t_and_m_t":"measResultSCG-Failure","paragraph_zero_based":11216},{"literal_text_all_w_t_and_m_t":"The field contains the MeasResultSCG-Failure IE which includes available results of measurements on NR frequencies the UE is configured to measure by the NR SCG RRCReconfiguration message. ","paragraph_zero_based":11217},{"literal_text_all_w_t_and_m_t":"previousPSCellId","paragraph_zero_based":11218},{"literal_text_all_w_t_and_m_t":"This field indicates the physical cell id and carrier frequency of the cell that is the source PSCell of the last PSCell change.","paragraph_zero_based":11219},{"literal_text_all_w_t_and_m_t":"failedPSCellId","paragraph_zero_based":11220},{"literal_text_all_w_t_and_m_t":"This field indicates the physical cell id and carrier frequency of the cell in which SCG failure is detected or the target PSCell of the failed PSCell change or failed PSCell addition.","paragraph_zero_based":11221},{"literal_text_all_w_t_and_m_t":"timeSCGFailure","paragraph_zero_based":11222},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the time elapsed since the last execution of RRCReconfiguration with reconfigurationWithSync for the SCG until the SCG failure. Actual value = field value * 100ms. The maximum value 1023 means 102.3s or longer.","paragraph_zero_based":11223},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11224},{"literal_text_all_w_t_and_m_t":"–SCGFailureInformationEUTRA","paragraph_zero_based":11225},{"literal_text_all_w_t_and_m_t":"The SCGFailureInformationEUTRA message is used to provide information regarding E-UTRA SCG failures detected by the UE.","paragraph_zero_based":11226},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1","paragraph_zero_based":11227},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":11228},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":11229},{"literal_text_all_w_t_and_m_t":"Direction: UE to Network","paragraph_zero_based":11230},{"literal_text_all_w_t_and_m_t":"SCGFailureInformationEUTRA message","paragraph_zero_based":11231}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["52fbae87ba0eafffecf4440792f685ebfc4651e3e620cb142c142ba71034a33f","b1ab6e8e00fb9fd47a2ad91dd1a21835cfe0827252a281e751f6bea59bac6ddd","88e5de9ea3a275e294ff23c12401b60ae2a4eabf816be8bc67662aa557e45b61","5a6169db01760f9ec36b92e10d34b95a76b8a895093fd4e3d6fa62126ae70701","7da6e59360e5bdd8d669ad36cfdcaee556862af35c8ac65437ea5d3d33ec1c85","fdd690a5de687fc9f187eb3851b42666e637959e42a41e03dd8e25e158785a59","71c3f1ddbcf24e2ed980222eff191e8f405893f756109c5d05625a6d8bf0cdb5","672c7ce70dd68bc7b57da2def59f4358cb0ccab62cf96dfc3c70d6a2718e712a","712afc2ada8f2867295d4b3ec2d54680ff2dd5113bdeb63fadd118b1042f06c5","091a75ddc9078e184d661f8052829db