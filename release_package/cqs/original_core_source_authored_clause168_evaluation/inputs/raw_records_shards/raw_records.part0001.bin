{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39480},{"literal_text_all_w_t_and_m_t":"MAC-MainConfigSL-r16 ::=                     SEQUENCE {","paragraph_zero_based":39481},{"literal_text_all_w_t_and_m_t":"    sl-BSR-Config-r16                            BSR-Config                                           OPTIONAL,    -- Need M","paragraph_zero_based":39482},{"literal_text_all_w_t_and_m_t":"    ul-PrioritizationThres-r16                   INTEGER (1..16)                                      OPTIONAL,    -- Need M","paragraph_zero_based":39483},{"literal_text_all_w_t_and_m_t":"    sl-PrioritizationThres-r16                   INTEGER (1..8)                                       OPTIONAL,    -- Need M","paragraph_zero_based":39484},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":39485},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39486},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39487},{"literal_text_all_w_t_and_m_t":"SL-ConfiguredGrantConfigList-r16 ::=       SEQUENCE {","paragraph_zero_based":39488},{"literal_text_all_w_t_and_m_t":"    sl-ConfiguredGrantConfigToReleaseList-r16  SEQUENCE (SIZE (1..maxNrofCG-SL-r16)) OF SL-ConfigIndexCG-r16         OPTIONAL, -- Need N","paragraph_zero_based":39489},{"literal_text_all_w_t_and_m_t":"    sl-ConfiguredGrantConfigToAddModList-r16   SEQUENCE (SIZE (1..maxNrofCG-SL-r16)) OF SL-ConfiguredGrantConfig-r16 OPTIONAL  -- Need N","paragraph_zero_based":39490},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39491},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39492},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SCHEDULEDCONFIG-STOP","paragraph_zero_based":39493},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39494},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39495},{"literal_text_all_w_t_and_m_t":"SL-ScheduledConfig field descriptions","paragraph_zero_based":39496},{"literal_text_all_w_t_and_m_t":"sl-CS-RNTI","paragraph_zero_based":39497},{"literal_text_all_w_t_and_m_t":"Indicate the RNTI used to scramble CRC of DCI format 3_0, see TS 38.321 [3].","paragraph_zero_based":39498},{"literal_text_all_w_t_and_m_t":"sl-DCI-ToSL-Trans","paragraph_zero_based":39499},{"literal_text_all_w_t_and_m_t":"Indicate the time gap between DCI reception and the first sidelink transmission scheduled by the DCI (see TS 38.214 [19], clause 8.1.2.1). Value 1 included in this field corresponds to 1 slot, value 2 corresponds to 2 slots and so on, based on the numerology of sidelink BWP.","paragraph_zero_based":39500},{"literal_text_all_w_t_and_m_t":"sl-PSFCH-ToPUCCH","paragraph_zero_based":39501},{"literal_text_all_w_t_and_m_t":"For dynamic grant and configured grant type 2, this field configures the values (in number of slot lengths) of the PSFCH to PUCCH gap. The field PSFCH-to-HARQ_feedback timing indicator in DCI format 3_0 selects one of the configured values of the PSFCH to PUCCH gap.","paragraph_zero_based":39502},{"literal_text_all_w_t_and_m_t":"sl-RNTI","paragraph_zero_based":39503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["77ddbb409486faea510070072f783d7e2f0e026b0e3066f6f578dac6791d940c","1d9d2d89f17f5972e5bf9045e714e810c84a8ec2936b286a0d838d1802e5f647","cc20b76f20815e544948f844b0e6d314c46c216645acca3842d210e2aabfeaca","66e7bd2cb89bedbaa8c24b41933f038b83064ea199903671ead09e059c8b895b","b6c8dd7ea4228f30cbd3b731e023f5f71f447ea125f0e96d041810b917eb3991","c7afb8a49019b318d6567a82292e1e213db5d03986ee9239168923542d07586f","9d3194e22b4843b0c05fd68aa7a7d590e1127da0e9ccae57cbf648c44b6cc42a","532f557070f67edf84b6992732dad1c6ff5f2b4f05165fed4ea21f7ea2cd1bf6","949796cf48af211f19e0767cc1ac25f8f9aca55ed0e8643dc19006cd7b261e1f","628f08311ac8b21d30aaf4874e37abf545b874061bde8e957e1a51899b5cd6fb","62595cae6c4e1e6ab7ca022811d7f9c513b2309cf18d29d7e2c5dae9ccff7087","2925bbb9cdc969e511d87a900d5f2d9899f6b2ab76033aa677e33d377046ca72","50c7b7c21710d3c935c0386af5d5aa137b283e4a982fb034869a2241cc2fa54b","464b850a9867a2e8a5dea728ac9cb10ea0543e75a3d3171c701a6bfc88ebb816","3eb7d2dd1f4b990fd7f6a070e8b11af99681d355382317a48b16bc3ee258426d","af1041323a29c5f1841366bca2cc2ac7ae80e0422de7dbfa9dd055cd5f4fdd47","37e07b664a9a3c2cb9ad13cbebe73350269473e9eabe5a49a010e2f149f3c424","d5f9902e7607dc5e47ffbac1138c6ff62eff508ad17cd8194bcb8b3ffbdf4f6a","43f6a293ba97f2aa81615b622922a08224a9eb966ab1a33f64d098dd6d36fbee","7cb653149a38227398f3caa3e38b47a1540c7ffd35bb330c8b1ffd23566be2c2","69b0925803aecf8b50e77ca07d3fbfaf9bd05ab8b51f9e0551f63a99fb780253","646961e554fd1ad349917b3679db576cb414c6c774b0cbcb4726596b52489804","c438b7264c83ffe8526711fac8750273ae868c44487ca9e264f9335547ea47a4","037836f45d02995da4927e4551046b129f69573a55d048cc2fdb61bb8cc8b5a8"],"paragraph_range_zero_based":[39480,39503],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p39480"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicate the SL-RNTI used for monitoring the network scheduling to transmit NR sidelink communication (i.e. the mode 1).","paragraph_zero_based":39504},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39505},{"literal_text_all_w_t_and_m_t":"MAC-MainConfigSL field descriptions","paragraph_zero_based":39506},{"literal_text_all_w_t_and_m_t":"sl-BSR-Config","paragraph_zero_based":39507},{"literal_text_all_w_t_and_m_t":"This field is to configure the sidelink buffer status report.","paragraph_zero_based":39508},{"literal_text_all_w_t_and_m_t":"sl-PrioritizationThres","paragraph_zero_based":39509},{"literal_text_all_w_t_and_m_t":"Indicates the SL priority threshold, which is used to determine whether SL TX is prioritized over UL TX, as specified in TS 38.321 [3]. Network does not configure the sl-PrioritizationThres and the ul-PrioritizationThres to the UE separately.","paragraph_zero_based":39510},{"literal_text_all_w_t_and_m_t":"ul-PrioritizationThres","paragraph_zero_based":39511},{"literal_text_all_w_t_and_m_t":"Indicates the UL priority threshold, which is used to determine whether SL TX is prioritized over UL TX, as specified in TS 38.321 [3]. Network does not configure the sl-PrioritizationThres and the ul-PrioritizationThres to the UE separately.","paragraph_zero_based":39512},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39513},{"literal_text_all_w_t_and_m_t":"–SL-SDAP-Config","paragraph_zero_based":39514},{"literal_text_all_w_t_and_m_t":"The IE SL-SDAP-Config is used to set the configurable SDAP parameters for a Sidelink DRB.","paragraph_zero_based":39515},{"literal_text_all_w_t_and_m_t":"SL-SDAP-Config information element","paragraph_zero_based":39516},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39517},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SDAP-CONFIG-START","paragraph_zero_based":39518},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39519},{"literal_text_all_w_t_and_m_t":"SL-SDAP-Config-r16 ::=                  SEQUENCE {","paragraph_zero_based":39520},{"literal_text_all_w_t_and_m_t":"    sl-SDAP-Header-r16                      ENUMERATED {present, absent},","paragraph_zero_based":39521},{"literal_text_all_w_t_and_m_t":"    sl-DefaultRB-r16                        BOOLEAN,","paragraph_zero_based":39522},{"literal_text_all_w_t_and_m_t":"    sl-MappedQoS-Flows-r16                  CHOICE {","paragraph_zero_based":39523},{"literal_text_all_w_t_and_m_t":"        sl-MappedQoS-FlowsList-r16              SEQUENCE (SIZE (1..maxNrofSL-QFIs-r16)) OF SL-QoS-Profile-r16,","paragraph_zero_based":39524},{"literal_text_all_w_t_and_m_t":"        sl-MappedQoS-FlowsListDedicated-r16     SL-MappedQoS-FlowsListDedicated-r16","paragraph_zero_based":39525},{"literal_text_all_w_t_and_m_t":"    }                                                                                                           OPTIONAL,   -- Need M","paragraph_zero_based":39526},{"literal_text_all_w_t_and_m_t":"    sl-CastType-r16                        ENUMERATED {broadcast, groupcast, unicast, spare1}                   OPTIONAL,   -- Need M","paragraph_zero_based":39527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["8cec3cbb7efd5047ae00b70829fec739d89ae3e6ab1c8d0bf27611dea7eed722","4ef4bfb99e4cf11b9ca83a0efebf9c1b09baa63969edd0fa8a68a894e78147da","8dd4ee4bc5ac8199a21ecbfa02dbe0e2ee03f8e5de4ad245c8b508223699ced1","a912ccc35f1953d5e0668807f73abcf6418fbf5b6658a895285584d3d1eeb620","e561b4b5ebda9f20b4e7ae6613f04a1753b8a