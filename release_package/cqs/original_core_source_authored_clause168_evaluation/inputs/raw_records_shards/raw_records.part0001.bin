{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5112},{"literal_text_all_w_t_and_m_t":"1>consider the entering condition for this event to be satisfied when condition C1-1, as specified below, is fulfilled;","paragraph_zero_based":5113},{"literal_text_all_w_t_and_m_t":"1>consider the leaving condition for this event to be satisfied when condition C1-2, as specified below, is fulfilled;","paragraph_zero_based":5114},{"literal_text_all_w_t_and_m_t":"Inequality C1-1 (Entering condition)","paragraph_zero_based":5115},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5116},{"literal_text_all_w_t_and_m_t":"Inequality C1-2 (Leaving condition)","paragraph_zero_based":5117},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5118},{"literal_text_all_w_t_and_m_t":"The variables in the formula are defined as follows:","paragraph_zero_based":5119},{"literal_text_all_w_t_and_m_t":"Ms is the measurement result of channel busy ratio of the transmission resource pool, not taking into account any offsets.","paragraph_zero_based":5120},{"literal_text_all_w_t_and_m_t":"Hys is the hysteresis parameter for this event (i.e. hysteresis as defined within reportConfigNR-SL for this event).","paragraph_zero_based":5121},{"literal_text_all_w_t_and_m_t":"Thresh is the threshold parameter for this event (i.e. c1-Threshold as defined within reportConfigNR-SL for this event).","paragraph_zero_based":5122},{"literal_text_all_w_t_and_m_t":"Ms is expressed in decimal from 0 to 1 in steps of 0.01.","paragraph_zero_based":5123},{"literal_text_all_w_t_and_m_t":"Hys is expressed is in the same unit as Ms.","paragraph_zero_based":5124},{"literal_text_all_w_t_and_m_t":"Thresh is expressed in the same unit as Ms.","paragraph_zero_based":5125},{"literal_text_all_w_t_and_m_t":"5.5.4.12Event C2 (The NR sidelink channel busy ratio is below a threshold)","paragraph_zero_based":5126},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5127},{"literal_text_all_w_t_and_m_t":"1>consider the entering condition for this event to be satisfied when condition C2-1, as specified below, is fulfilled;","paragraph_zero_based":5128},{"literal_text_all_w_t_and_m_t":"1>consider the leaving condition for this event to be satisfied when condition C2-2, as specified below, is fulfilled;","paragraph_zero_based":5129},{"literal_text_all_w_t_and_m_t":"Inequality C2-1 (Entering condition)","paragraph_zero_based":5130},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5131},{"literal_text_all_w_t_and_m_t":"Inequality C2-2 (Leaving condition)","paragraph_zero_based":5132},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5133},{"literal_text_all_w_t_and_m_t":"The variables in the formula are defined as follows:","paragraph_zero_based":5134},{"literal_text_all_w_t_and_m_t":"Ms is the measurement result of channel busy ratio of the transmission resource pool, not taking into account any offsets.","paragraph_zero_based":5135}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["32797da5266eb4676f1ed2b85b8cfb4f01e8ec3c2e6370fff613017aef797f52","4063abcfea412e924c8166e88df768b378da4a60f6a3bac7dafccb8fd25b80ef","a85e37e66afc290d388a00c7e747244460ea87de50ba8cc08e76c58fd2ecad07","df19084cbb6a6f12cb8def8f24299fab2716028346b0dfa24802e6be53b0761a","10c1657dd12fe6bcec40931737154157248df14ee8b3502fb9edfb40508a9e82","b5c6876422ab8e7d54d6bc05f8a57d371d2f658799fd570a1562bc54dc4ce574","5dcf6f6be59b4df6bd8017e87a9c5d1cb83d4dfdc9970b2f6466945720e575a3","d8cbf38ebd08a55e6f480d45b027a7144ae319d82101ba0df820ce6e5ecaf400","bb1e15d1084100eadf8b9ea713063ef4b45e5cbc163a6f0d20c20d43f3bf9566","fd6a0275676251b11b4e108ea806234ebee2639eae75e549f35825a0673e90a6","c4fe637651645b581ec077ff7552c38ba367a6d5994cfc52b6f6f1ba7284ce81","67a4c9902c8072bdccf5ba4a845be22fc3b5856492925aa7bb48f9712e6321dc","2ac1416a8f51a47a6d036c1b193a9aafed0806d8c651ac49adf892fec1a7f59a","5c9ac4b0c329d9d48aff0ee48e4a3e8d6a4bf8d5a55ab7ec7a1051d0160fb76d","27b1c4dfe1f915d730ad78d41b16d7af29f0e20fd41f2209df2a72c9ba606775","0790714fe9ca0e7a29250fe8d49ca71a583f754b44985048feb3431ee60b0590","d930eb6832af07b36c70b8fe19b05e07387b8439529640f0ba986f18adf542a7","f4fb7adb191416c89a039c78c8e99cded5fb508ed8f733c6ebc58da5e5fd3cad","6c7a636018bc6771f52ede3a94196005fc8a8057455341a9e83dea1a657764ac","a2fc81f08bbeea699493ad418dd8ceffca85c2dfd6694cb3b4555abf50cb3197","dd0606bb1a93169ce739f187cf2242f4b244b140d3b6764dc55cb35e1a6d627e","6d9a3e93dbedbb20ccd83212ad0920dbc0872474ad17aa898af06403c4b029b3","0ea6ae077c708e373677396f775b863660c33c541995f7a2abc8ea33190b661e","1bcbc9b4dad474b26f3baaeb18779281de6d65b5463cdb886e5da65bd746bb73"],"paragraph_range_zero_based":[5112,5135],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p5112"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Hys is the hysteresis parameter for this event (i.e. hysteresis as defined within reportConfigNR-SL for this event).","paragraph_zero_based":5136},{"literal_text_all_w_t_and_m_t":"Thresh is the threshold parameter for this event (i.e. c2-Threshold as defined within reportConfigNR-SL for this event).","paragraph_zero_based":5137},{"literal_text_all_w_t_and_m_t":"Ms is expressed in decimal from 0 to 1 in steps of 0.01.","paragraph_zero_based":5138},{"literal_text_all_w_t_and_m_t":"Hys is expressed is in the same unit as Ms.","paragraph_zero_based":5139},{"literal_text_all_w_t_and_m_t":"Thresh is expressed in the same unit as Ms.","paragraph_zero_based":5140},{"literal_text_all_w_t_and_m_t":"5.5.4.13Void","paragraph_zero_based":5141},{"literal_text_all_w_t_and_m_t":"5.5.4.14Void","paragraph_zero_based":5142},{"literal_text_all_w_t_and_m_t":"5.5.4.15Event D1 (Distance between UE and referenceLocation1 is above threshold1 and distance between UE and referenceLocation2 is below threshold2)","paragraph_zero_based":5143},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5144},{"literal_text_all_w_t_and_m_t":"1>consider the entering condition for this event to be satisfied when both condition D1-1 and condition D1-2, as specified below, are fulfilled;","paragraph_zero_based":5145},{"literal_text_all_w_t_and_m_t":"1>consider the leaving condition for this event to be satisfied when condition D1-3 or condition D1-4, i.e. at least one of the two, as specified below, are fulfilled;","paragraph_zero_based":5146},{"literal_text_all_w_t_and_m_t":"Inequality D1-1 (Entering condition 1)","paragraph_zero_based":5147},{"literal_text_all_w_t_and_m_t":"Ml1-Hys>Thresh1","paragraph_zero_based":5148},{"literal_text_all_w_t_and_m_t":"Inequality D1-2 (Entering condition 2)","paragraph_zero_based":5149},{"literal_text_all_w_t_and_m_t":"Ml2+Hys<Thresh2","paragraph_zero_based":5150},{"literal_text_all_w_t_and_m_t":"Inequality D1-3 (Leaving condition 1)","paragraph_zero_based":5151},{"literal_text_all_w_t_and_m_t":"Ml1+Hys<Thresh1","paragraph_zero_based":5152},{"literal_text_all_w_t_and_m_t":"Inequality D1-4 (Leaving condition 2)","paragraph_zero_based":5153},{"literal_text_all_w_t_and_m_t":"Ml2-Hys>Thresh2","paragraph_zero_based":5154},{"literal_text_all_w_t_and_m_t":"The variables in the formula are defined as follows:","paragraph_zero_based":5155},{"literal_text_all_w_t_and_m_t":"Ml1 is the distance between UE and a reference location for this event (i.e. referenceLocation1 as defined within reportConfigNR for this event), not taking into account any offsets.","paragraph_zero_based":5156},{"literal_text_all_w_t_and_m_t":"Ml2 is the distance between UE and a reference location for this event (i.e. referenceLocation2 as defined within reportConfigNR for this event), not taking into account any offsets.","paragraph_zero_based":5157},{"literal_text_all_w_t_and_m_t":"Hys is the hysteresis parameter for this event (i.e. hysteresisLocation as defined within reportConfigNR for this event).","paragraph_zero_based":5158},{"literal_text_all_w_t_and_m_t":"Thresh1 is the threshold for this event defined as a distance, configured with parameter distanceThreshFromReference1, from a reference location configured with parameter referenceLocation1 within reportConfigNR for this event.","paragraph_zero_based":5159}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["ccf93c8ea1d00ec43fa07a2223b0b9deabfb7884bd99f58f736e48b31e8e5467","6c017b60da170fcbda2e074ff306fa7ef980f57a8ebcd9213ffcabc72d7d4fa4","be8e2a2d50444eade3fb17141367362220ee02a88dd20f6eb0719e28e881cae1","9b7a6c15cbe15e100be280a4c16ddb2763f328d50a809adfafe7cd976c1cc5f3","57b9f6ddb3191704dcc75b435f842d7cfb5af89e9819f4e0cd837888c4ab2ef4","174f257595faad0e3b053b94809d19f1ad351cdd1ca68d22fc40461da0f2ece1","c79e176bfdf3d72aec1efe1a843ca72d2adbfe7be08d025c3bd9735f1ae02f39","a381a25938fae02786c4dcbbfe9590a77af3ed43d524a5aa5e47b5d46e4e2569","3461716fceaab6b12206498292f7f8568f12a46618cbd1810902423487b6de33","8e9568ab5712d56db81fd5d6130d908d022f9d1a8e7dd7538d5fdfb2d2f8a839","cfcb9afbcc96073cd6a8c8e9933415b71fc0493f41862d654528939a1b1c5074","a1dc21da7db8074700d52aeff1525f36d4077f0825096767a0ad59fec396906c","115e4f1ca47de808760f92983951424a17edbe1b1ee73efab72e466b7f9a02a1","466a530745021d48a09773b4f54e0de22db975b6d3d47bfdbf9567c3d5e37eab","6e5a2e9fd57517a3d0b249a1d23d327697750d09438e034e23825228851d544f","18d317a0a4314c40346148f7090021daf6f7484389c781a81eb85a72148592b0","c8b5316a468411aafa9494c2dcde84bdb27d253dee31d47a52c7041b06c5b991","3e404c511a888cbc8a1a1a8c5539b58017a2fbf684bd08c4cd1fdcd8229bd050","3eea42cdaf8ffe4ca159779bca0eaee12c8897f4f666461851f992fbe27673ef","669adcef8b03783a327ea5128bac3d6ae9acac38ad8b27cf1e12f01296e7de25","3ff28f7a649f0889675971cf4e238253eb79891380fa824bef6ba2b02a8d900c","953cb744f5c3c8e180a7baf68a87ea1a22654ab599de1adfb3c82af4d7583632","5ac7181ea7eec74e40a9634f0a59a9be03656bfa7d1029fe117cf352f0f7df0b","765bf66cab0b349aa4f959611515069ef20e836dd6740dce4a1c5d9ea4d5f7ef"],"paragraph_range_zero_based":[5136,5159],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p5136"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Thresh2 is the threshold for this event defined as a distance, configured with parameter distanceThreshFromReference2, from a reference location configured with parameter referenceLocation2 within reportConfigNR for this event.","paragraph_zero_based":5160},{"literal_text_all_w_t_and_m_t":"Ml1 is expressed in meters.","paragraph_zero_based":5161},{"literal_text_all_w_t_and_m_t":"Ml2 is expressed in the same unit as Ml1.","paragraph_zero_based":5162},{"literal_text_all_w_t_and_m_t":"Hys is expressed in the same unit as Ml1.","paragraph_zero_based":5163},{"literal_text_all_w_t_and_m_t":"Thresh1 is expressed in the same unit as Ml1.","paragraph_zero_based":5164},{"literal_text_all_w_t_and_m_t":"Thresh2 is expressed in the same unit as Ml1.","paragraph_zero_based":5165},{"literal_text_all_w_t_and_m_t":"NOTE:The definition of Event D1 also applies to CondEvent D1.","paragraph_zero_based":5166},{"literal_text_all_w_t_and_m_t":"5.5.4.16CondEvent T1 (Time measured at UE is within a duration from threshold)","paragraph_zero_based":5167},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5168},{"literal_text_all_w_t_and_m_t":"1>consider the entering condition for this event to be satisfied when condition T1-1, as specified below, is fulfilled;","paragraph_zero_based":5169},{"literal_text_all_w_t_and_m_t":"1>consider the leaving condition for this event to be satisfied when condition T1-2, as specified below, is fulfilled;","paragraph_zero_based":5170},{"literal_text_all_w_t_and_m_t":"Inequality T1-1 (Entering condition)","paragraph_zero_based":5171},{"literal_text_all_w_t_and_m_t":"Mt>Thresh1","paragraph_zero_based":5172},{"literal_text_all_w_t_and_m_t":"Inequality T1-2 (Leaving condition)","paragraph_zero_based":5173},{"literal_text_all_w_t_and_m_t":"Mt>Thresh1+Duration","paragraph_zero_based":5174},{"literal_text_all_w_t_and_m_t":"The variables in the formula are defined as follows:","paragraph_zero_based":5175},{"literal_text_all_w_t_and_m_t":"Mt is the time measured at UE.","paragraph_zero_based":5176},{"literal_text_all_w_t_and_m_t":"Thresh1 is the threshold parameter for this event (i.e. t1-Threshold as defined within reportConfigNR for this event).","paragraph_zero_based":5177},{"literal_text_all_w_t_and_m_t":"Duration is the duration parameter for this event (i.e. duration as defined within reportConfigNR for this event).","paragraph_zero_based":5178},{"literal_text_all_w_t_and_m_t":"Mt is expressed in ms.","paragraph_zero_based":5179},{"literal_text_all_w_t_and_m_t":"Thresh1 is expressed in the same unit as Mt.","paragraph_zero_based":5180},{"literal_text_all_w_t_and_m_t":"Duration is expressed in the same unit as Mt.","paragraph_zero_based":5181},{"literal_text_all_w_t_and_m_t":"5.5.4.17Event X1 (Serving L2 U2N Relay UE becomes worse than threshold1 and NR Cell becomes better than threshold2)","paragraph_zero_based":5182},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5183}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["71143aa9e75bf9ea71c47362324b1283bcbb4748a193975a9219da4e215e2bab","dd8f24a0e256c75ebbf9e10e74fb9b5ed5bedbf34419921c9df7c0a30e4303e2","3f559eac4baa263110f416660f1068c943bafbefe2e902e07a40051ed831671c","2a57d5c39c29907eab99410d43395d857f4788fe593c1af8ff1123ab00f5296e","268c9af138271adba3ad16df5249224054d9e8284015d6b8cff5eba83aaafafb","8ed33d50f34237b4e06500b8345baf333ef266f12db0ed9c78c29d0bdbc93019","1d365b57f3af1105d2464b33c642c66493d377296a1f959f53db7601f336c4bf","857237ff71a9e10440746fad8d33f833d519a15a50e1f778917f6c16e30db683","f8a307f4f42cd22b0deb499c0994cd58580dff6c669195e5d2afccacdbbf9ed0","b03363154017460f6a859a910a129feccbfe89c155ae65e3134acf7434a12ece","4903e1607c162330b5d0e43b34fe3c74f1e20263198e6cfa17a49c18d58a94e2","e9ec5491098db5277e6c7bcd01655e2af58636766afa9dd0d296559af7b8d220","420fc517c3e1ba5e65290586fc0e3eba525680d5dd05e12b111c94ec8014dba3","2b009a631300338e0b44e54dd078da9264757f89ae01cc4b387b59273e159e62","6997992ca75d0e41392e774d62525f5727a50d9a8e765120f1cbc23ccda845ce","8f5a560f784a5de30e9d2f9576ccfdd4ea47b19870adaa8f6b499b85a420fe85","407554509d09d16cac8cd18afb04a56547844c36b0d0e3297103be672a24a700","feb7354ca6012ec02c39872a21100764cd317eb9ba49725efc3f554fc55d3b4e","e2c79a98cb8e89ca55a690177519d69ced637cfac3641263d9e77c4295a4f481","e75a1de1c7ea031a5bf3b1b7f3863235fd87253e972ab3d21642956fb1246339","1fbdd9787c2ca87c05526026ed97cd5286b69836180a4f3e5476571dd365cb22","72350f2381281d4843735f30f24831a4edb1f54fa865bb0b17a3c03fd10db5d6","ee150c503fa62bccaf69cbb82e8035dd8d907a9c13c549b518fbcd9ccf3fa641","da6e021da87e737e50443a834f6db7f8c3d3ba3e5255acb106cd0f365e11a545"],"paragraph_range_zero_based":[5160,5183],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p5160"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>consider the entering condition for this event to be satisfied when both condition X1-1 and condition X1-2, as specified below, are fulfilled;","paragraph_zero_based":5184},{"literal_text_all_w_t_and_m_t":"1>consider the leaving condition for this event to be satisfied when condition X1-3 or condition X1-4, i.e. at least one of the two, as specified below, is fulfilled;","paragraph_zero_based":5185},{"literal_text_all_w_t_and_m_t":"Inequality X1-1 (Entering condition 1)","paragraph_zero_based":5186},{"literal_text_all_w_t_and_m_t":"Mr + Hys < Thresh1","paragraph_zero_based":5187},{"literal_text_all_w_t_and_m_t":"Inequality X1-2 (Entering condition 2)","paragraph_zero_based":5188},{"literal_text_all_w_t_and_m_t":"Mn + Ofn + Ocn – Hys > Thresh2","paragraph_zero_based":5189},{"literal_text_all_w_t_and_m_t":"Inequality X1-3 (Leaving condition 1)","paragraph_zero_based":5190},{"literal_text_all_w_t_and_m_t":"Mr – Hys > Thresh1","paragraph_zero_based":5191},{"literal_text_all_w_t_and_m_t":"Inequality X1-4 (Leaving condition 2)","paragraph_zero_based":5192},{"literal_text_all_w_t_and_m_t":"Mn + Ofn + Ocn + Hys < Thresh2","paragraph_zero_based":5193},{"literal_text_all_w_t_and_m_t":"The variables in the formula are defined as follows:","paragraph_zero_based":5194},{"literal_text_all_w_t_and_m_t":"Mr is the measurement result of the serving L2 U2N Relay UE, not taking into account any offsets.","paragraph_zero_based":5195},{"literal_text_all_w_t_and_m_t":"Mn is the measurement result of the NR cell, not taking into account any offsets.","paragraph_zero_based":5196},{"literal_text_all_w_t_and_m_t":"Ofn is the measurement object specific offset of the reference signal of the NR cell (i.e. offsetMO as defined within measObjectNR corresponding to the NR cell).","paragraph_zero_based":5197},{"literal_text_all_w_t_and_m_t":"Ocn is the cell specific offset of the NR cell (i.e. cellIndividualOffset as defined within measObjectNR corresponding to the frequency of the NR cell), and set to zero if not configured for the cell.","paragraph_zero_based":5198},{"literal_text_all_w_t_and_m_t":"Hys is the hysteresis parameter for this event.","paragraph_zero_based":5199},{"literal_text_all_w_t_and_m_t":"Thresh1 is the threshold parameter for this event (i.e. x1-Threshold1-Relay as defined within reportConfigNR for this event).","paragraph_zero_based":5200},{"literal_text_all_w_t_and_m_t":"Thresh2 is the threshold parameter for this event (i.e. x1-Threshold2 as defined within reportConfigNR for this event).","paragraph_zero_based":5201},{"literal_text_all_w_t_and_m_t":"Mr is expressed in dBm.","paragraph_zero_based":5202},{"literal_text_all_w_t_and_m_t":"Mn is expressed in dBm in case of RSRP, or in dB in case of RSRQ and RS-SINR.","paragraph_zero_based":5203},{"literal_text_all_w_t_and_m_t":"Ofn, Ocn, Hys are expressed in dB.","paragraph_zero_based":5204},{"literal_text_all_w_t_and_m_t":"Thresh1 is expressed in the same unit as Mr.","paragraph_zero_based":5205},{"literal_text_all_w_t_and_m_t":"Thresh2 is expressed in the same unit as Mn.","paragraph_zero_based":5206},{"literal_text_all_w_t_and_m_t":"5.5.4.18Event X2 (Serving L2 U2N Relay UE becomes worse than threshold)","paragraph_zero_based":5207}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["ccd7703272da4a4d5136fdeab52ee3e69b082ba339a19f56637a6339054b328a","9a4020ac07d15f03132c85c3e789a09c9f4897c9b215683b605868867bd32a58","44453235ad5961372e1132a203368792c954927e84496c4135129d5062be2cb0","24499db5344825724