8efc3d483016c76e61769877501fe8286cfaa72","7d0041cedafe24ae90d35465ef388c21614b6c10a08bafcb02ecb8f01d465fdc","c115b84ecda2323aa4e3da095d45d2eb97a0596b8b334fe26ba765fe8e5ddba0","2c6e4ec9c1572730e03dec9a740ad28c892559e2241fb11c7f0d845c57fbb1cd","aefcf81dc9e551900d39eabf7812eabadd6862dd02f1178873ea4a0aa928aff3","e1eccd5de327ced19e4a66645d394015f7a45e56119721f8b23bd9cedaec3490","2e5a27274dc8020dfe6e2107cab7a2e92dc6bdd648e913caa598ef4a63d6b0fe","13790f89072bccd721f1d96dca5a875f3487942d0370641201007e61dcaa09e6","7d5c030ddc1cca3cfdb5e0b08ab601974c9d0d4e5d115d9c229101987b1e9e19","37ca85422b3f69add8d1aa3b854f2aa1cddd82f02f9ea4e8dff36c94d2973544","ddb6bf153f17895086600b0617f13788993afa2d1bc106fe19958daa0e5b2db5","b4012cbb8f33d378765107429bde625e919916bf927d3b83b3e356885d158cf6","675fbbf503b9a6b0902de9d23804ffdcb2aca4c31dcf4f78e27ad802f25e1172"],"paragraph_range_zero_based":[29592,29615],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p29592"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29616},{"literal_text_all_w_t_and_m_t":"QCL-Info field descriptions","paragraph_zero_based":29617},{"literal_text_all_w_t_and_m_t":"bwp-Id","paragraph_zero_based":29618},{"literal_text_all_w_t_and_m_t":"The DL BWP which the RS is located in. If the field is absent, the RS is located in the DL BWP in which the TCI-State is applied by the UE.","paragraph_zero_based":29619},{"literal_text_all_w_t_and_m_t":"cell","paragraph_zero_based":29620},{"literal_text_all_w_t_and_m_t":"The UE's serving cell in which the referenceSignal is configured. If the field is absent, the referenceSignal is configured in the serving cell in which the TCI-State is applied by the UE. The RS can be located on a serving cell other than the serving cell for which the TCI-State is applied by the UE only if the qcl-Type is configured as typeC or typeD. If the referenceSignal is set to csi-rs and unifiedTCI-StateType is configured, either both cell and bwp-Id are present or both cell and bwp-Id are absent. See TS 38.214 [19] clause 5.1.5.","paragraph_zero_based":29621},{"literal_text_all_w_t_and_m_t":"referenceSignal","paragraph_zero_based":29622},{"literal_text_all_w_t_and_m_t":"Reference signal with which quasi-collocation information is provided as specified in TS 38.214 [19] clause 5.1.5.","paragraph_zero_based":29623},{"literal_text_all_w_t_and_m_t":"qcl-Type","paragraph_zero_based":29624},{"literal_text_all_w_t_and_m_t":"QCL type as specified in TS 38.214 [19] clause 5.1.5.","paragraph_zero_based":29625},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29626},{"literal_text_all_w_t_and_m_t":"TCI-State field descriptions","paragraph_zero_based":29627},{"literal_text_all_w_t_and_m_t":"additionalPCI","paragraph_zero_based":29628},{"literal_text_all_w_t_and_m_t":"Indicates the physical cell IDs (PCI) of the SSBs when referenceSignal is configured as SSB for both QCL-Type1 and QCL-Type2. In case the cell is present, the additionalPCI refers to a PCI value configured in the list configured using additionalPCI-ToAddModList in the serving cell indicated by the field cell. Otherwise, it refers to a PCI value configured in a list additionalPCI-ToAddModList configured in the serving cell where the TCI-State is applied by the UE. When this field is present the cell for qcl-Type1 and qcl-Type2 is configured with same value, if present.","paragraph_zero_based":29629},{"literal_text_all_w_t_and_m_t":"pathlossReferenceRS-Id","paragraph_zero_based":29630},{"literal_text_all_w_t_and_m_t":"The ID of the reference signal (e.g. a CSI-RS or an SS block) used for PUSCH, PUCCH and SRS path loss estimation. This field refers to an element in the list configured using pathlossReferenceRSToAddModList in the serving cell and UL BWP where the TCI State is applied by the UE.","paragraph_zero_based":29631},{"literal_text_all_w_t_and_m_t":"qcl-Type1, qcl-Type2","paragraph_zero_based":29632},{"literal_text_all_w_t_and_m_t":"QCL information for the TCI state as specified in TS 38.214 [19] clause 5.1.5.","paragraph_zero_based":29633},{"literal_text_all_w_t_and_m_t":"tci-StateId","paragraph_zero_based":29634},{"literal_text_all_w_t_and_m_t":"ID number of the TCI state.","paragraph_zero_based":29635},{"literal_text_all_w_t_and_m_t":"ul-PowerControl","paragraph_zero_based":29636},{"literal_text_all_w_t_and_m_t":"Configures power control parameters for PUCCH, PUSCH and SRS for this TCI state. The field is present here only if ul-powerControl is not configured in any BWP-Uplink-Dedicated of this serving cell. This field refers to an element in the list configured using uplink-PowerControlToAddModList in the serving cell where the dl-OrJointTCI-StateToAddModList is configured.","paragraph_zero_based":29637},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29638},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":29639}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["e26e18de1272c5a0a6d7f353a996f43f9d863b9fb15528951e86df81d794bae1","bc424f581d522a50380ca3b71a4ccb111f8693891e90d459efc0599617e57cb6","28ab97d87c9811314ac22c92a972c9fa47cbbbde9d1439e62bdb3d77864e3a38","b3e1fcb28d31d3f7da8ee5922ec360e3fa6cbf97fbca8738e49c64446c49779c","a7f4f56124d8125b39b96849667e7cdb99238ba5baba4fd63e359970c59c55bd","8a4f4681f7e477e2f7f376bf27bc9824522431a9e25b227ecd38f51faa19550a","f357809b72fd3d84bdabe283922f3cdb322ed1d0951e63915f66c35f11807cbf","b0cd9eb477d6b66a73eb2be9dcfda5cb9cac0a4d77f84321b6ec856ffb2321ea","dc771892f80061c52b72d9d2af4822b0bb899903551aadd1abc2e1f12d9ffe78","1758fca25ca519bc0f3d0da102fa3587fc0394908e9acb03bdf7ae4b515cb3bd","f6a88cf0104baa40fc9d952767e028b9889ff044e4f903172091a06a57024c31","bccbc2e126279f69f4481378cefef06a79797e7145515a7afdee7dc932a4585b","8adbe9056e18d13fbc247d0d61c64441c8a1d43456b18d577ab2437dbea17e86","118c9e8a87b8167239efa14f595ef9f088f201bb43e543b4ec4eb8e3fa3d22ef","adebb3dee9d1d93e0ebc8d9c79f65efae1df6218468418a741922ce8b63ae09a","32a117e957d2ebf80c2e28b9f1f33c5d573f15359a61de3b12a1c72b7542251b","66623490cf68253fb1eb9fc8d802a8635fdabed60b7190a90cb9c623964f2091","06dd41c9532bc232b9487a53a9f1bc38a6348a70aeca617f9332f9364bead834","5e04a9d7bf78555da5e3c36ee45eded08ab0ec09984d0cea331807af0ef765a0","f45c9cbfa5d4d6ff210e53f4a3b5c7d56052dea9ba8821f410555bbd25200094","b4df6980b0c98a8b04ebc8e133477daa78c9d7263cc1bd2134ce50c570139089","3f0e4b98fb8b15ce418ebdf6c27645d9c3a3e0e9a21c120ddd1d679ea8e8d5e9","d1d06d3e10154899b06c4b70ce6f022a322eaa830fb012e2d6366bfe8cd5f4b6","a45d3e9e18a8f79977b60e30bab7149d054e7eec75bee39abe37a77fe3ce67f1"],"paragraph_range_zero_based":[29616,29639],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p29616"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":29640},{"literal_text_all_w_t_and_m_t":"CSI-RS-Indicated","paragraph_zero_based":29641},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if csi-rs is included and unifiedTCI-StateType is not configured. This field is optionally present, Need R, if csi-rs is included and unifiedTCI-StateType is configured. Otherwise, it is absent, Need R.","paragraph_zero_based":29642},{"literal_text_all_w_t_and_m_t":"JointTCI","paragraph_zero_based":29643},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, if this serving cell is configured with unifiedTCI-StateType set to 'joint'. It is absent, Need R, otherwise.","paragraph_zero_based":29644},{"literal_text_all_w_t_and_m_t":"JointTCI1","paragraph_zero_based":29645},{"literal_text_all_w_t_and_m_t":"This field is mandatory present, if this serving cell is configured with unifiedTCI-StateType set to 'joint'. It is absent, Need R, otherwise.","paragraph_zero_based":29646},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29647},{"literal_text_all_w_t_and_m_t":"–TCI-StateId","paragraph_zero_based":29648},{"literal_text_all_w_t_and_m_t":"The IE TCI-StateId is used to identify one TCI-State configuration.","paragraph_zero_based":29649},{"literal_text_all_w_t_and_m_t":"TCI-StateId information element","paragraph_zero_based":29650},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29651},{"literal_text_all_w_t_and_m_t":"-- TAG-TCI-STATEID-START","paragraph_zero_based":29652},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29653},{"literal_text_all_w_t_and_m_t":"TCI-StateId ::=                     INTEGER (0..maxNrofTCI-States-1)","paragraph_zero_based":29654},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29655},{"literal_text_all_w_t_and_m_t":"-- TAG-TCI-STATEID-STOP","paragraph_zero_based":29656},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29657},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29658},{"literal_text_all_w_t_and_m_t":"–TCI-UL-State","paragraph_zero_based":29659},{"literal_text_all_w_t_and_m_t":"The IE TCI-UL-State indicates the TCI state information for UL transmission.","paragraph_zero_based":29660},{"literal_text_all_w_t_and_m_t":"TCI-UL-State information element","paragraph_zero_based":29661},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29662},{"literal_text_all_w_t_and_m_t":"-- TAG-TCI-UL-STATE-START","paragraph_zero_based":29663}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["1bf46bdf219b84b94a065cb4b815a444a447e52f2bae93c346f086fbfcf0fba4","0ed47d83517fbc9794b679eb015a1b53aea40c3c6b9dbb282b59fbb353c322f9","f474182213e527c42d0c9f91606206e385fa4c6998c8c11dc64d76fbfce5ab2e","da0da433aedabd342c711fe0095301bfb723411c9ba1ffc4c94c28f7c76bd637","d6d490f411f8d287cfe49379818ed74c58e6fdf351241b0e79619d3ef1ec683d","a1299e63d46d3f192a8326807c70813ca50bb9cf29e7db6a4e9c82bf670e3a7e","306628c486cc7e554c44d7ea276102ce5f063b26c77806564bcab1d275633167","14bf77a9ce7cff764df33bb0767377c0c03e1304dc9d50532a5daae763462cc8","d36354934f9df7203a13750e259b890b6ef94e1f654c3e66656b54a3e1c3277a","e821fa579cf1b6ae189d7f67f6542402d1017c1f5a05768147d42cf5b70660dd","a7515810a6640d1d85138fbad426e875d6f2f84365c1406553a9a196462416b2","ff6e9c55dd14cd27608b7cf7945fd6523eddce3e57ff5d85d3333510140bd566","bfc49122a34c18c968682c91a7e99dc38dee93e3b486179a62557636750a918c","5b5ef7871de184b1187efa7883fe08e61d8320ed190f19eaf9f25b5c44b4c43c","962e8cd528