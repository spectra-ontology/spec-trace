{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SRS-PosConfig-r17 ::=               SEQUENCE {","paragraph_zero_based":10536},{"literal_text_all_w_t_and_m_t":"    srs-PosResourceSetToReleaseList-r17 SEQUENCE (SIZE(1..maxNrofSRS-PosResourceSets-r16)) OF SRS-PosResourceSetId-r16 OPTIONAL,-- Need N","paragraph_zero_based":10537},{"literal_text_all_w_t_and_m_t":"    srs-PosResourceSetToAddModList-r17  SEQUENCE (SIZE(1..maxNrofSRS-PosResourceSets-r16)) OF SRS-PosResourceSet-r16  OPTIONAL,-- Need N","paragraph_zero_based":10538},{"literal_text_all_w_t_and_m_t":"    srs-PosResourceToReleaseList-r17    SEQUENCE (SIZE(1..maxNrofSRS-PosResources-r16)) OF SRS-PosResourceId-r16      OPTIONAL,-- Need N","paragraph_zero_based":10539},{"literal_text_all_w_t_and_m_t":"    srs-PosResourceToAddModList-r17     SEQUENCE (SIZE(1..maxNrofSRS-PosResources-r16)) OF SRS-PosResource-r16        OPTIONAL -- Need N","paragraph_zero_based":10540},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":10541},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10542},{"literal_text_all_w_t_and_m_t":"-- TAG-RRCRELEASE-STOP","paragraph_zero_based":10543},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":10544},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10545},{"literal_text_all_w_t_and_m_t":"RRCRelease-IEs field descriptions","paragraph_zero_based":10546},{"literal_text_all_w_t_and_m_t":"cellReselectionPriorities","paragraph_zero_based":10547},{"literal_text_all_w_t_and_m_t":"Dedicated priorities to be used for cell reselection as specified in TS 38.304 [20]. The maximum number of NR carrier frequencies that the network can configure through FreqPriorityListNR and FreqPriorityListDedicatedSlicing together is eight. If the same frequency is configured in both FreqPriorityListNR and FreqPriorityListDedicatedSlicing, the frequency is only counted once.","paragraph_zero_based":10548},{"literal_text_all_w_t_and_m_t":"cnType","paragraph_zero_based":10549},{"literal_text_all_w_t_and_m_t":"Indicate that the UE is redirected to EPC or 5GC.","paragraph_zero_based":10550},{"literal_text_all_w_t_and_m_t":"deprioritisationReq","paragraph_zero_based":10551},{"literal_text_all_w_t_and_m_t":"Indicates whether the current frequency or RAT is to be de-prioritised.","paragraph_zero_based":10552},{"literal_text_all_w_t_and_m_t":"deprioritisationTimer","paragraph_zero_based":10553},{"literal_text_all_w_t_and_m_t":"Indicates the period for which either the current carrier frequency or NR is deprioritised. Value minN corresponds to N minutes.","paragraph_zero_based":10554},{"literal_text_all_w_t_and_m_t":"measIdleConfig","paragraph_zero_based":10555},{"literal_text_all_w_t_and_m_t":"Indicates measurement configuration to be stored and used by the UE while in RRC_IDLE or RRC_INACTIVE.","paragraph_zero_based":10556},{"literal_text_all_w_t_and_m_t":"mpsPriorityIndication","paragraph_zero_based":10557},{"literal_text_all_w_t_and_m_t":"Indicates the UE can set the establishment cause to mps-PriorityAccess for a new connection following a redirect to NR or set the resume cause to mps-PriorityAccess for a resume following a redirect to NR. If the target RAT is E-UTRA, see TS 36.331 [10]. The gNB sets the indication only for UEs authorized to receive MPS treatment as indicated by ARP and/or QoS characteristics at the gNB, and it is applicable only for this instance of release with redirection to carrier/RAT included in the redirectedCarrierInfo field in the RRCRelease message.","paragraph_zero_based":10558},{"literal_text_all_w_t_and_m_t":"noLastCellUpdate","paragraph_zero_based":10559}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["ad761f31e9b788bb7a42f4119cb9374809c57edf77a89133a35380ed9a9a1f71","7f5144046cc74e0c5e13a73d843cce60fa473e4572ea80cb22431b09903a3834","b973d219616fae7b63f0f20bda40d41be706648eba261a0e5a037fcafa82c116","021669caa86ff2d52db1bac4019777a3e1e34d9516fec44e31021dcae97f712f","d945f3a7534c263ae4685fce8b84580e573238644d0283d6b684d067fea4c188","018029df6e30c72a98475b393bd345a0e4e13caa9bf7680117cccce6e5cb0cb6","7831c3344d272d9c9c18fceb8459ccaa90074ffa0ca7315e9d0b6ab73bc2dd79","671f9c7b072ebe09b84da3a4311b03399790d5f294fdfc3c093380b79cda13e6","009dbbdd21ba6f99b663d1038b4af9b8c6cda5e0ced35ffc8b60029dba86e8e1","f1f10738bbdaa6e676d6dd6d67fce99ab435ab0f56000be2150e8f1031204ae2","7b82b7c16410a53cac9e2b6b329adfe18fe1aa7bf088f667842ec3d7289b6b57","0aacb10746560cfd574dcb0d2607c5be31c1d25468b72dc45592bc809e897fa3","9ef5bdd241b91260469e7b0c88981e0cf7a3051332cb25f7bbe0f083d1f13521","af5e90b5d41d3072981a84d65acb7f483e9295deda7d86110302dc432df8965f","54d0124d9169ce86bcc77ff91641519d352307ab49cc2a62eb768ca9c148f9cb","0be54639748a38fb88f9b7294f34105c2e58b66ad5e6111e1d824ecd29b57197","973494cadf66268407db1973f1a6295a775395032ff0b681a3f50ae39484fa8c","06a7b031f228f8d4da023d7a45ea7802036b2b1accac0063487c40975487ae54","8181c971dfe8ac12e391224415e7faaf329ae633f010fea789fa3306e07644a0","cf916252a2cd4805dae6b98f2ba32f4b612644624a53a3a5324fb5e0642189b4","30c0295fa25a96197a55483ad9f7971b32f76ff51027d973086d9f987c2e2b25","fe539b832db368eb283c55ed7ade0818c07c5fdf4296b943ae93c44b59e8869e","479b8e996a478516b2cf6ef8cc8f304cb6e367ff96e312d031705cd6c1d295d4","9bc16b20be23f06ddba284b89b3852b81ab0cef1f108a8c2af3e3d2b919e1aa1"],"paragraph_range_zero_based":[10536,10559],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p10536"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Presence of the field indicates that the last used cell for PEI shall not be updated. When the field is absent, the PEI-capable UE shall update its last used cell with the current cell. The UE shall not update its last used cell with the current cell if the AS security is not activated.","paragraph_zero_based":10560},{"literal_text_all_w_t_and_m_t":"srs-PosRRC-InactiveConfig","paragraph_zero_based":10561},{"literal_text_all_w_t_and_m_t":"SRS for positioning configuration during RRC_INACTIVE state.","paragraph_zero_based":10562},{"literal_text_all_w_t_and_m_t":"suspendConfig","paragraph_zero_based":10563},{"literal_text_all_w_t_and_m_t":"Indicates configuration for the RRC_INACTIVE state. The network does not configure suspendConfig when the network redirect the UE to an inter-RAT carrier frequency or if the UE is configured with a DAPS bearer.","paragraph_zero_based":10564},{"literal_text_all_w_t_and_m_t":"redirectedCarrierInfo","paragraph_zero_based":10565},{"literal_text_all_w_t_and_m_t":"Indicates a carrier frequency (downlink for FDD) and is used to redirect the UE to an NR or an inter-RAT carrier frequency, by means of cell selection at transition to RRC_IDLE or RRC_INACTIVE as specified in TS 38.304 [20]. Based on UE capability, the network may include redirectedCarrierInfo in RRCRelease message with suspendConfig if this message is sent in response to an RRCResumeRequest or an RRCResumeRequest1 which is triggered by the NAS layer (see 5.3.1.4 in TS 24.501 [23]).","paragraph_zero_based":10566},{"literal_text_all_w_t_and_m_t":"voiceFallbackIndication","paragraph_zero_based":10567},{"literal_text_all_w_t_and_m_t":"Indicates the RRC release is triggered by EPS fallback for IMS voice as specified in TS 23.502 [43].","paragraph_zero_based":10568},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10569},{"literal_text_all_w_t_and_m_t":"CarrierInfoNR field descriptions","paragraph_zero_based":10570},{"literal_text_all_w_t_and_m_t":"carrierFreq","paragraph_zero_based":10571},{"literal_text_all_w_t_and_m_t":"Indicates the redirected NR frequency.","paragraph_zero_based":10572},{"literal_text_all_w_t_and_m_t":"ssbSubcarrierSpacing","paragraph_zero_based":10573},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing of SSB in the redirected SSB frequency.","paragraph_zero_based":10574},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":10575},{"literal_text_all_w_t_and_m_t":"FR1:    15 or 30 kHz","paragraph_zero_based":10576},{"literal_text_all_w_t_and_m_t":"FR2-1:  120 or 240 kHz","paragraph_zero_based":10577},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":10578},{"literal_text_all_w_t_and_m_t":"smtc","paragraph_zero_based":10579},{"literal_text_all_w_t_and_m_t":"The SSB periodicity/offset/duration configuration for the redirected SSB frequency. It is based on timing reference of PCell. If the field is absent, the UE uses the SMTC configured in the measObjectNR having the same SSB frequency and subcarrier spacing.","paragraph_zero_based":10580},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10581},{"literal_text_all_w_t_and_m_t":"RAN-NotificationAreaInfo field descriptions","paragraph_zero_based":10582},{"literal_text_all_w_t_and_m_t":"cellList","paragraph_zero_based":10583}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["a041cd6cd754c3472e21744ed3e89b401ecf91b1bef8a2d01f65bedbad0bbbc1","27d157abe6d723367e8e84edd8462d744cb0819baf23ec327ebfdf8f4a28b46a","d1dd2d699f7930e0516cb6da2dc08dd4e265fa501cc6a5ecf0f65e1959509018","3db8ce32fecea8459e83c8cd81892feb8f7a8794ef12d1c7b9ca57330f8eab02","6f5ccd338ff2d86a37c470098610f92b90d64c400bf277be4cd4536a146ef84b","fd7a7f0ac14dbed0d6f53d83250fba4bc31d63c4caf0ba7cdcf99e40fc30e899","dbdd93cb05b64df28ae045936f493f936cf60b213ac066869bc9034227e7d890","4ec7c7cbd2f5be33ca01d1ac25996d978a56db3efc1b777f6848723480b8ef06","d3e26c8b490095b1f23540d08b401d3ac4226c377ab569c54b40e71e13534f84","fa8c990d4ca18a30e2483fd2e9b2a2255f8b8587616344d0febed73c00866160","0b099cf055d3adacf35065ce9825b50133735ee1bd62c4260b3262ef2c532e4b","ea981ad336bf15e12c717be5a2972081cfbb297d47c0f0f8619270b2c1655377","18cb26038a473c19bf19fe49ec131710d85b880f21719a1f91c81b8552c98895","aa08dcd6dfcc4bfac1ef4ff4f4482cc8ec7fc33aade45404092aa97fd2aa9969","e5d2c0ce3c2a296c78064fa9444d7152bf3ded3fa14511c6a1a53de69ea8fffe","dd44abd82dd7d27a1733ce528b157b4c86d3262f0a27e4b6d35b9c0d0446c57d","117d00f3ccd5d32c1506b5ee0a70712389bba39ddee6a186835a9e043471c536","449f416be2eb78356ee0f85a2ba255327a8c6428850f75a8cb3c91b050b1b736","d1c8b5268044b12fcd96ebca58bb9650d58276bfd08048e7a6fe12ea6dfe55d6","7339100452082812fc21a811a9583ab0a41e381d6377be1057ea7f69dd77c2c5","430c78830ae37c7e5bac09df912a350dfced3c48a4c8c1b2247b1cd9f4e369b7","e862a5b0753d563f845afef4410b5ac4a56f2733de8fe4f7f52b8a6e8a5ac4fd","dc2affd5b3bac801b8debb5516f79a3761589360fa71168f669d6291946c24cc","43acd95c1acba7f9a0459c552c50aea03f3973962661aa6a07fcf602db87b877"],"paragraph_range_zero_based":[10560,10583],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p10560"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"A list of cells configured as RAN area.","paragraph_zero_based":10584},{"literal_text_all_w_t_and_m_t":"ran-AreaConfigList","paragraph_zero_based":10585},{"literal_text_all_w_t_and_m_t":"A list of RAN area codes or RA code(s) as RAN area.","paragraph_zero_based":10586},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10587},{"literal_text_all_w_t_and_m_t":"PLMN-RAN-AreaConfig field descriptions","paragraph_zero_based":10588},{"literal_text_all_w_t_and_m_t":"plmn-Identity","paragraph_zero_based":10589},{"literal_text_all_w_t_and_m_t":"PLMN Identity to which the cells in ran-Area belong. If the field is absent the UE not in SNPN access mode uses the ID of the registered PLMN. This field is not included for UE in SNPN access mode (for UE in SNPN access mode the ran-Area always belongs to the registered SNPN).","paragraph_zero_based":10590},{"literal_text_all_w_t_and_m_t":"ran-AreaCodeList","paragraph_zero_based":10591},{"literal_text_all_w_t_and_m_t":"The total number of RAN-AreaCodes of all PLMNs does not exceed 32.","paragraph_zero_based":10592},{"literal_text_all_w_t_and_m_t":"ran-Area","paragraph_zero_based":10593},{"literal_text_all_w_t_and_m_t":"Indicates whether TA code(s) or RAN area code(s) are used for the RAN notification area. The network uses only TA code(s) or both TA code(s) and RAN area code(s) to configure a UE. The total number of TACs across all PLMNs does not exceed 16.","paragraph_zero_based":10594},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10595},{"literal_text_all_w_t_and_m_t":"PLMN-RAN-AreaCell field descriptions","paragraph_zero_based":10596},{"literal_text_all_w_t_and_m_t":"plmn-Identity","paragraph_zero_based":10597},{"literal_text_all_w_t_and_m_t":"PLMN Identity to which the cells in ran-AreaCells belong. If the field is absent the UE not in SNPN access mode uses the ID of the registered PLMN. This field is not included for UE in SNPN access mode (for UE in SNPN access mode the ran-AreaCells always belongs to the registered SNPN).","paragraph_zero_based":10598},{"literal_text_all_w_t_and_m_t":"ran-AreaCells","paragraph_zero_based":10599},{"literal_text_all_w_t_and_m_t":"The total number of cells of all PLMNs does not exceed 32.","paragraph_zero_based":10600},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10601},{"literal_text_all_w_t_and_m_t":"SDT-Config field descriptions","paragraph_zero_based":10602},{"literal_text_all_w_t_and_m_t":"sdt-DRB-ContinueROHC","paragraph_zero_based":10603},{"literal_text_all_w_t_and_m_t":"Indicates whether the PDCP entity of the radio bearers configured for SDT continues or resets the ROHC header compression protocol during PDCP re-establishment during SDT procedure, as specified in TS 38.323 [5]. Value cell indicates that ROHC header compression continues when the UE resumes for SDT in the same cell as the PCell when the RRCRelease message was received. Value rna indicates that ROHC header compression continues when the UE resumes for SDT in a cell belonging to the same RNA as the PCell where the RRCRelease message was received. If the field is absent, the UE releases any stored value for this field and the PDCP entity of the radio bearers configured for SDT always resets the ROHC header compression protocol during PDCP re-establishment when SDT procedure is initiated, as specified in TS 38.323 [5].","paragraph_zero_based":10604},{"literal_text_all_w_t_and_m_t":"sdt-DRB-List","paragraph_zero_based":10605},{"literal_text_all_w_t_and_m_t":"Indicates the ID(s) of the DRB(s) that are configured for SDT. If size of the sequence is zero, then the UE assumes that none of the DRBs are configured for SDT. The network only configures MN terminated MCG bearers for SDT.","paragraph_zero_based":10606},{"literal_text_all_w_t_and_m_t":"sdt-SRB2-Indication","paragraph_zero_based":10607}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["d0f8a6f808aeaea03d8e009cc1d24d76002e5a7946ae2e61d7bba0e570e8a30f","d3c1a60d2d6c6cb1536f64de4716413b49f1f973356c0db8df5e8cf59b4a4c95","f3766039db0a7252a72613c0c7a1b3ec17398f16990af70d147ad2d661f22d06","9dbbebe2176b15ed58f95aec0de279410c6cd6ff7309336036db56eda7bbf387","d6f2dae5f94220ff7e624892607d10c0791344062b4e636ad6d55621f5ead2ad","55957ff4b5541e1260163027fc610fc968b16bd0d757173937eda3fa02d3f28b","605e96abddc2751e4ea1f1479f3276cb54e8ac6c39849ea157016a432ab6adee","7ee6ce0046b637a12b6c3c758d632ae0895532a0c47b1e68e05efd2d1732ad28","cac93e727e60e7573689413fe5d9f95b4784bfce6b544b4beffe0c2ca47dedf0","1b075e8fd03d015ed2001e9f76c29248e891a3cc23bd4b8b920d8fa41a623fdd","eff1e422fb98bea98225df8cf75f87ee25ad0b7b4acf719508e0bd669ed53339","1ec978cb966fa3d4f9e3fd8f4e44be21b0fd5ca45c49fd542500c3b7871b7e6f","0e3249d65d566bd6b17c3568ea876f899357b95b9b4b6ce95c40389fcc45a047","ca5cf33a3d492784f7f5231ff627e6f9f6e6da3e78716a5c6a5f46bc0c6bc53d","8dbf673e383efe6b0f1dfb23bf5217d148ebe917a5f9c47ee0b7858067e84726","fe71ecbead90f7f41bb354368745e806f7c7cb993c8817cba8e5d431265c73d2","4326e52a0ccbe5116aa2550ddd87208ea2e159cc5553eb0d82fff3847bb0647f","2ae010026dae89b7a858324b37b8837505792b9d7f75263a9fd75a66e775a266","05a49af5c3618b7ac911d5d92c2ddab61ed397a82b58ca15be93fbaa6e0fbb24","75a3a74ca2cbe9809bdbcc5e1dfd8b22cc096ceda1332a515a95999b3629d1e1","315617a73ecac8682110cf5b6d275f515b7659739c101d24508931f52a134544","2d02f31d2693d19496e76ae21ff92eba5da3f05a80e7dc342a05e29c7cddf274","faa09b5c1d4ec61f0d179d72bde646afbe9fb29a335b90e87e590c532ec2cbee","496194bac762641a66e0d0cf2fb87a2979b0bed523a1724f72d3659d00b6b203"],"paragraph_range_zero_based":[10584,10607],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p10584"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indiates whether SRB2 is configured for SDT or not.","paragraph_zero_based":10608},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10609},{"literal_text_all_w_t_and_m_t":"SDT-MAC-PHY-CG-Config field descriptions","paragraph_zero_based":10610},{"literal_text_all_w_t_and_m_t":"cg-SDT-ConfigInitialBWP-DL","paragraph_zero_based":10611},{"literal_text_all_w_t_and_m_t":"Downlink BWP configuration for CG-SDT. If a UE is a RedCap UE and if the initialDownlinkBWP-RedCap is configured in downlinkConfigCommon in SIB1, this field is configured for initialDownlinkBWP-RedCap, otherwise it is configured for initialDownlinkBWP.","paragraph_zero_based":10612},{"literal_text_all_w_t_and_m_t":"cg-SDT-ConfigInitialBWP-NUL","paragraph_zero_based":10613},{"literal_text_all_w_t_and_m_t":"UL BWP configuration for CG-SDT on NUL carrier. If a UE is a RedCap UE and if the initialUplinkBWP-RedCap is configured in uplinkConfigCommon in SIB1, this field is configured for initialUplinkBWP-RedCap, otherwise it is configured for initialUplinkBWP for NUL.","paragraph_zero_based":10614},{"literal_text_all_w_t_and_m_t":"cg-SDT-ConfigInitialBWP-SUL","paragraph_zero_based":10615},{"literal_text_all_w_t_and_m_t":"UL BWP configuration for CG-SDT on SUL carrier configured for the initialUplinkBWP for SUL.","paragraph_zero_based":10616},{"literal_text_all_w_t_and_m_t":"cg-SDT-CS-RNTI","paragraph_zero_based":10617},{"literal_text_all_w_t_and_m_t":"The CS-RNTI value for CG-SDT as specified in TS 38.321 [3].","paragraph_zero_based":10618},{"literal_text_all_w_t_and_m_t":"cg-SDT-RSRP-ThresholdSSB","paragraph_zero_based":10619},{"literal_text_all_w_t_and_m_t":"An RSRP threshold configured for SSB selection for CG-SDT as specified in TS 38.321 [3].","paragraph_zero_based":10620},{"literal_text_all_w_t_and_m_t":"cg-SDT-TA-ValidationConfig","paragraph_zero_based":10621},{"literal_text_all_w_t_and_m_t":"Configuration for the RSRP based TA validation. If this field is not configured, then the UE does not perform RSRP based TA validation.","paragraph_zero_based":10622},{"literal_text_all_w_t_and_m_t":"cg-SDT-timeAlignmentTimer","paragraph_zero_based":10623},{"literal_text_all_w_t_and_m_t":"TAT value for CG-SDT as specified in TS 38.321 [3]. The network always configures this field when sdt-MAC-PHY-CG-Config is configured.","paragraph_zero_based":10624},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10625},{"literal_text_all_w_t_and_m_t":"CG-SDT-ConfigLCH-Restriction field descriptions","paragraph_zero_based":10626},{"literal_text_all_w_t_and_m_t":"allowedCG-List","paragraph_zero_based":10627},{"literal_text_all_w_t_and_m_t":"This restriction applies only when the UL grant is a configured grant for CG-SDT. If present, UL MAC SDUs from this logical channel can only be mapped to the indicated CG-SDT configured grant configuration. If the size of the sequence is zero, then UL MAC SDUs from this logical channel cannot be mapped to any CG-SDT configured grant configurations. If the field is not present, UL MAC SDUs from this logical channel can be mapped to any CG-SDT configured grant configurations. If the field configuredGrantType1Allowed is present, only those CG-SDT configured grant type 1 configurations indicated in this sequence are allowed for use by this logical channel; otherwise, this sequence shall not include any CG-SDT configured grant type 1 configuration. Corresponds to \"allowedCG-List\" as specified in TS 38.321 [3].","paragraph_zero_based":10628},{"literal_text_all_w_t_and_m_t":"configuredGrantType1Allowed","paragraph_zero_based":10629},{"literal_text_all_w_t_and_m_t":"If present, or if the capability lcp-Restriction as specified in TS 38.306 [26] is not supported, UL MAC SDUs from this logical channel can be transmitted on a configured grant type 1 for CG-SDT. Otherwise, UL MAC SDUs from this logical channel cannot be transmitted on a configured grant type 1 for CG-SDT. Corresponds to \"configuredGrantType1Allowed\" in TS 38.321 [3].","paragraph_zero_based":10630},{"literal_text_all_w_t_and_m_t":"logicalChannelIdentity","paragraph_zero_based":10631}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["131a11ca6fc04644e802e0b624ddb1e18fe9a788b4e117d6a442704e6004e303","02cd4b643757b7fc7e2d850fe6baa5d84c8973ed2d949f886b46d4dca9d0e0e6","701280a9d9c7b999d4940b67640b960c30cdf29255d265345623175b852b2f1e","28c07314b21fa2c38312eb1d3e5164f5bb81ba8172bdaa3eaf161991996e384f","2552bb8aff044ed4aba3301ba54efc76ec92410c76e9cc3a60db8bd08ea76772","4f1b867e892245bd70006bda1e9c926a7a0545bed5ec5800424f73a9b3b8aefe","8b08568f1079a9ed2ae5af916e90b3ad6eb4db3c849c734a458c0c1333c5fbaf","f520dcc2038a8ab1bdf579b1b58194d277bb01074d19ae5c3c6a117da2aa2ea8","adbeedb6c37f614ff4e0b62f4b64cf40c92486617e033f2193e0b16e973bf575","a16eab7d0d7b4fb6fdc46d9801ff22ffc5cc701637026f0ad14718b6c3e4d661","66e04c9c3c28b7785fb4593cd8208db77d8a7cc9d2473796b0d798101b286b4b","9d9ae68e8b376bbbb1db998ce5f943788d65582264639d98762fbf47c27e159a","a1c3b0c8b4c2c185ac53ac7ee256829c8cd596beafe02960325d06f219a7f150","3e0bd83a29734754ca92892f947fe930f33bed49c3e9ab33b8b753be21eac395","2fa1158f6979acf4337763d33e40962168380b9be9b32a3bdb40bbac89750f9e","991c3d23b0e3b95129d188ddcf0a41cab08cf8af5b48d6baf858bafa72ab6404","be800c983ad699b5dcbe7dd900ed78dac3029d79e5dbe6d4fdd47c5e3e5632cb","d3559bc83e79da3f4c19e422087c6c798c00391dc462edd6ec7de5dead38e821","77d79671f6cffc911a26e7b75fccaa88aae7626dd6bd69dcfbd1339e48aff98f","da15c23be829968e9cc656abb3c958dd447a392e70fbfe010d241b31f18429f3","78b1b36780716e3bfdb165f00e3f42cb5f2e85c7986c0e579b5bac5930410e4c","56bba8182dee619e7e78cbad29cd177bba799fd39a9b00dac0c533cb8afa7dc1","c9e709a3a1ec60b1a0e79df24eaea9fa3e7046262d51c1bb5fdbf1bed59a56a0","cac3fd0a4fbdc25c40ec795dcda23db311c214f45db46617e703cdc856c7aca7"],"paragraph_range_zero_based":[10608,10631],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p10608"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ID used commonly for the MAC logical channel and for the RLC bearer associated with a servedRadioBearer configured for SDT.","paragraph_zero_based":10632},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10633},{"literal_text_all_w_t_and_m_t":"CG-SDT-TA-ValidationConfig field descriptions","paragraph_zero_based":10634},{"literal_text_all_w_t_and_m_t":"cg-SDT-RSRP-ChangeThreshold","paragraph_zero_based":10635},{"literal_text_all_w_t_and_m_t":"The RSRP threshold for TA validation for CG-SDT as specified in TS 38.321 [3]. Value dB2 corresponds to 2 dB, value dB4 corresponds to 4 dB and so on.","paragraph_zero_based":10636},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10637},{"literal_text_all_w_t_and_m_t":"SRS-PosRRC-InactiveConfig field descriptions","paragraph_zero_based":10638},{"literal_text_all_w_t_and_m_t":"bwp-NUL","paragraph_zero_based":10639},{"literal_text_all_w_t_and_m_t":"BWP configuration for SRS for Positioning during the RRC_INACTIVE state in Normal Uplink Carrier. If the field is absent UE is configured with an SRS for Positioning associated with the initial UL BWP and transmitted, during the RRC_INACTIVE state, inside the initial UL BWP with the same CP and SCS as configured for initial UL BWP.","paragraph_zero_based":10640},{"literal_text_all_w_t_and_m_t":"bwp-SUL","paragraph_zero_based":10641},{"literal_text_all_w_t_and_m_t":"BWP configuration for SRS for Positioning during the RRC_INACTIVE state in Supplementary Uplink Carrier. If the field is absent UE is configured with an SRS for Positioning associated with the initial UL BWP and transmitted, during the RRC_INACTIVE state, inside the initial UL BWP with the same CP and SCS as configured for initial UL BWP.","paragraph_zero_based":10642},{"literal_text_all_w_t_and_m_t":"inactivePosSRS-RSRP-ChangeThreshold","paragraph_zero_based":10643},{"literal_text_all_w_t_and_m_t":"RSRP threshold for the increase/decrease of RSRP for time alignment validation as specified in TS 38.321 [3].","paragraph_zero_based":10644},{"literal_text_all_w_t_and_m_t":"inactivePosSRS-TimeAlignmentTimer","paragraph_zero_based":10645},{"literal_text_all_w_t_and_m_t":"TAT value for SRS for positioning transmission during RRC_INACTIVE state as specified in TS 38.321 [3]. The network always configures this field when srs-PosRRC-Inactive is configured.","paragraph_zero_based":10646},{"literal_text_all_w_t_and_m_t":"srs-PosConfigNUL","paragraph_zero_based":10647},{"literal_text_all_w_t_and_m_t":"SRS for Positioning configuration in RRC_INACTIVE state in Normal Uplink Carrier.","paragraph_zero_based":10648},{"literal_text_all_w_t_and_m_t":"srs-PosConfigSUL","paragraph_zero_based":10649},{"literal_text_all_w_t_and_m_t":"SRS for Positioning configuration in RRC_INACTIVE state in Supplementary Uplink Carrier.","paragraph_zero_based":10650},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10651},{"literal_text_all_w_t_and_m_t":"SuspendConfig field descriptions","paragraph_zero_based":10652},{"literal_text_all_w_t_and_m_t":"ncd-SSB-RedCapInitialBWP-SDT","paragraph_zero_based":10653},{"literal_text_all_w_t_and_m_t":"Indicates that the UE uses the RedCap-specific initial DL BWP associated with the NCD-SSB for SDT. The network configures this field if a RedCap UE is configured with SDT in the RedCap-specific initial DL BWP not associated with CD-SSB. If configured, the NCD-SSB indicated by this field can only be used during the SDT procedure for CG-SDT or RA-SDT.","paragraph_zero_based":10654},{"literal_text_all_w_t_and_m_t":"ran-ExtendedPagingCycle","paragraph_zero_based":10655}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["2728b0f5febb65b563a3b544a9b3557173d1236514ebfc6391e697a1774c4bf8","41c15ccef90a80da5cb03925f2f1f143aaa6c912890931232fd10e43fc92167f","eff3e4ed3354179ad10a3c31cee7c6f3747bca771062fbc619c74a1ab8cbd1d4","d71051a337cb3608b6b2dc9c19385c0a1b39582b089a04a0b3283053da0abcbd","579623c9f144d90bbf54da67c5661d2b65e12773ed68c7f5ed0418f87b35532d","ab1ef1382a1c6ee62caa740b634a3bed42ed17d50879897f77728cb091fc22ef","7f20416593e43af7dd8b64ce9fa6fdee5de51710280146295c9255319397ff86","f6c1af9d478f52a6eb15518c650057b64290769b5e1628202aa3c974d0eba6a9","4f5a771bbb451bba85cd3e939b7f5d897c8d8b0648762992151a6cff5fbe2fae","43f8767e582301e732fd69f47d20c3a202934095fc16f429878611db16112d0f","e66a91bafe5fceee45e729b09f75b27ef4ab56b6b94dc53dd294df2b3d65e351","071f2faf848a8df60460381fb48b806d70f7de8b905330ccdcb6b44dd40ff8e0","7bbeb847e6a68b68fab4c062517a74d38f5da3f2b8322d0425335894ea0e9bfd","bce76828cd1110d081ce68bfee62923af41d44cb5693414ace00f7fe744da7d8","ad1e6965bf75fe4db471ed0a5deb9ed9541cbd99855ba2a6948af0f47d9a0bdd","6b98b05c169831b7baed0d2e2ccdf4e88427f5be2f4644eda542c4c4ffa6f31c","adffb7e2a82288f763277a993ba9f59fd0fcfee69f0f09a43e27a062a72edbd8","407a0ef393ea6184719d9d99014b7a747cf5178ecda1d3cb9086c8d7865abf0b","b72cec9e40cbf3c066e35c9a9a67181a89501042159c75432246a506f5942033","20b912e4a8d2c5d1b254ecb18fe7f03fe279637b633829dde1e17f6218ce7807","a7209161f1668bb08ae5b80e0b5576c7718eafb60a41a975e9e6dbcb1ce50d3e","962d601e7666a41b4d2b0e75a79225b2273ce86f9f71b62fe175482735f40375","240716e3e558d93cb0a8bd27b6100eae6bde97939956af3e6e21ef53b2d7f30c","5b58af5378d11442ce61da9712bf76b66694abdcb3b1d575f1b192af448db892"],"paragraph_range_zero_based":[10632,10655],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p10632"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The extended DRX (eDRX) cycle for RAN-initiated paging to be applied by the UE. Value rf256 corresponds to 256 radio frames, value rf512 corresponds to 512 radio frames and so on. Value of the field indicates an eDRX cycle which is shorter or equal to the IDLE mode eDRX cycle configured for the UE.","paragraph_zero_based":10656},{"literal_text_all_w_t_and_m_t":"ran-NotificationAreaInfo","paragraph_zero_based":10657},{"literal_text_all_w_t_and_m_t":"Network ensures that the UE in RRC_INACTIVE always has a valid ran-NotificationAreaInfo.","paragraph_zero_based":10658},{"literal_text_all_w_t_and_m_t":"ran-PagingCycle","paragraph_zero_based":10659},{"literal_text_all_w_t_and_m_t":"Refers to the UE specific cycle for RAN-initiated paging. Value rf32 corresponds to 32 radio frames, value rf64 corresponds to 64 radio frames and so on.","paragraph_zero_based":10660},{"literal_text_all_w_t_and_m_t":"sl-UEIdentityRemote","paragraph_zero_based":10661},{"literal_text_all_w_t_and_m_t":"Indicates the C-RNTI to the L2 U2N Remote UE.","paragraph_zero_based":10662},{"literal_text_all_w_t_and_m_t":"t380","paragraph_zero_based":10663},{"literal_text_all_w_t_and_m_t":"Refers to the timer that triggers the periodic RNAU procedure in UE. Value min5 corresponds to 5 minutes, value min10 corresponds to 10 minutes and so on.","paragraph_zero_based":10664},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10665},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":10666},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":10667},{"literal_text_all_w_t_and_m_t":"L2RemoteUE","paragraph_zero_based":10668},{"literal_text_all_w_t_and_m_t":"The field is mandatory present for L2 U2N Remote UE's RNAU; otherwise it is absent.","paragraph_zero_based":10669},{"literal_text_all_w_t_and_m_t":"RANPaging","paragraph_zero_based":10670},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, if the UE is configured with IDLE eDRX, see TS 24.501 [23]; otherwise the field is not present.","paragraph_zero_based":10671},{"literal_text_all_w_t_and_m_t":"Redirection2","paragraph_zero_based":10672},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if redirectedCarrierInfo is included; otherwise the field is not present.","paragraph_zero_based":10673},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10674},{"literal_text_all_w_t_and_m_t":"–RRCResume","paragraph_zero_based":10675},{"literal_text_all_w_t_and_m_t":"The RRCResume message is used to resume the suspended RRC connection.","paragraph_zero_based":10676},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1","paragraph_zero_based":10677},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":10678},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":10679}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["f4bf7c5fefbabf9afb4316e32fafd806f6320f1382263948c43334fb26ce04a6","89381adaafae1313a48c4e97746b3f5f26f47549a5742c9d4b0a60fe9b2771be","fec7702e7d98dc2261b50a61fbfd21f829b0c4413221dd3c88f15be8958237e2","e21a4ca13b60d4f2ea506ef39038c7056eb138a22e4aa76d699f6d414039a905","7c9c5e962cc21b187e8fef559ee1fc7bd7bb0f6d6e0d7d3134692bc166750269","fa803597ce948a1405d9294a04e83e7825008d56f9feaee491d381b2fe55dc6d","dc54e58a6641e01c383881abb1fa49bc81620a53fd0222f8b11c5ec2fd5203e0","72b3e2cf3c33cb8b9e10041ed02aaab9687495a28346097e50467262809cd2c0","9fa42c875a1d83780851b9dcc2b3a12a6176481f5fbf607003f9