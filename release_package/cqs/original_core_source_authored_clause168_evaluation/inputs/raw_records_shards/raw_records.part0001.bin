{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9168},{"literal_text_all_w_t_and_m_t":"DLInformationTransferMRDC field descriptions","paragraph_zero_based":9169},{"literal_text_all_w_t_and_m_t":"dl-DCCH-MessageNR","paragraph_zero_based":9170},{"literal_text_all_w_t_and_m_t":"Includes the DL-DCCH-Message. In this version of the specification, the field is only used to transfer the NR RRCReconfiguration, RRCRelease, and MobilityFromNRCommand messages.","paragraph_zero_based":9171},{"literal_text_all_w_t_and_m_t":"dl-DCCH-MessageEUTRA","paragraph_zero_based":9172},{"literal_text_all_w_t_and_m_t":"Includes the DL-DCCH-Message. In this version of the specification, the field is only used to transfer the E-UTRA RRCConnectionReconfiguration, RRCConnectionRelease, and MobilityFromEUTRACommand messages as specified in TS 36.331 [10].","paragraph_zero_based":9173},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9174},{"literal_text_all_w_t_and_m_t":"–FailureInformation","paragraph_zero_based":9175},{"literal_text_all_w_t_and_m_t":"The FailureInformation message is used to inform the network about a failure detected by the UE.","paragraph_zero_based":9176},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1 or SRB3","paragraph_zero_based":9177},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":9178},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":9179},{"literal_text_all_w_t_and_m_t":"Direction: UE to network","paragraph_zero_based":9180},{"literal_text_all_w_t_and_m_t":"FailureInformation message","paragraph_zero_based":9181},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":9182},{"literal_text_all_w_t_and_m_t":"-- TAG-FAILUREINFORMATION-START","paragraph_zero_based":9183},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9184},{"literal_text_all_w_t_and_m_t":"FailureInformation ::=         SEQUENCE {","paragraph_zero_based":9185},{"literal_text_all_w_t_and_m_t":"    criticalExtensions             CHOICE {","paragraph_zero_based":9186},{"literal_text_all_w_t_and_m_t":"        failureInformation             FailureInformation-IEs,","paragraph_zero_based":9187},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture       SEQUENCE {}","paragraph_zero_based":9188},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":9189},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":9190},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["d8cb249d526131547199b81306770fdbe20ab5b37862fbad2938135f9ad543c2","b57abaab5484ba195765286d3e41568c84675b8d68a40b5009b379f814d058fc","b650504fc436c1c9b0b21c5309859cc202a5973e0e11417f7d1e46dd100e2edd","e1cd3eb7e1dd7fb7db12e22c407156ecdd67578ce905c55495328d356724c6c9","c894bfdc4f96c3946fa67cb3dba10697f14ed54a23ec0cabd6c19b1a7a2a195c","3e364ce54ea4a488117485c60b34283536c1222a61319fd2f09a2223281dba82","1d2c1085faccd44149b9616943f3b886326ea462ece1805bb29c3c51bfb05193","286eb9857ea9dcba9da99cbf1cb261afd98f67d7a76ac7296f3627b589b7608b","d404939c7e2e21b1fd527472b6e55e4b8beea2c2643cedb1c246625f46fdc1d7","e460ef02a803cff53164d49119f87d81ca9d09b00509723d57906d4b14f4a2e9","3416bcd6136c72330ddd5e5c2c2e2f6a96530fc87383c8e7d6ed07f00d4b7167","440f66fed35b5add45afdfc814577a19e9531dec4762c09ac5aec01b0cf35039","0701b8004ad6626a8429fd2179dda68599afc6a4c5c2f54f1ee31860d61a8c6e","87667817757864ce5cdca4a8a487b132cb91abf0d74381ba7070834ec1538586","896d38eb83782898f4ebb1e9b2e4c10afffb62a