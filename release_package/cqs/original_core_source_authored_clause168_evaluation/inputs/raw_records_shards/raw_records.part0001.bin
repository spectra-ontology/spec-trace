{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–CG-ConfigInfo","paragraph_zero_based":43632},{"literal_text_all_w_t_and_m_t":"This message is used by master eNB or gNB to request the SgNB or SeNB to perform certain actions e.g. to establish, modify or release an SCG. The message may include additional information e.g. to assist the SgNB or SeNB to set the SCG configuration. It can also be used by a CU to request a DU to perform certain actions, e.g. to establish, or modify an MCG or SCG.","paragraph_zero_based":43633},{"literal_text_all_w_t_and_m_t":"Direction: Master eNB or gNB to secondary gNB or eNB, alternatively CU to DU.","paragraph_zero_based":43634},{"literal_text_all_w_t_and_m_t":"CG-ConfigInfo message","paragraph_zero_based":43635},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":43636},{"literal_text_all_w_t_and_m_t":"-- TAG-CG-CONFIG-INFO-START","paragraph_zero_based":43637},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43638},{"literal_text_all_w_t_and_m_t":"CG-ConfigInfo ::=               SEQUENCE {","paragraph_zero_based":43639},{"literal_text_all_w_t_and_m_t":"    criticalExtensions              CHOICE {","paragraph_zero_based":43640},{"literal_text_all_w_t_and_m_t":"        c1                              CHOICE{","paragraph_zero_based":43641},{"literal_text_all_w_t_and_m_t":"            cg-ConfigInfo               CG-ConfigInfo-IEs,","paragraph_zero_based":43642},{"literal_text_all_w_t_and_m_t":"            spare3 NULL, spare2 NULL, spare1 NULL","paragraph_zero_based":43643},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":43644},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture        SEQUENCE {}","paragraph_zero_based":43645},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":43646},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":43647},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43648},{"literal_text_all_w_t_and_m_t":"CG-ConfigInfo-IEs ::=           SEQUENCE {","paragraph_zero_based":43649},{"literal_text_all_w_t_and_m_t":"    ue-CapabilityInfo               OCTET STRING (CONTAINING UE-CapabilityRAT-ContainerList)          OPTIONAL,-- Cond SN-AddMod","paragraph_zero_based":43650},{"literal_text_all_w_t_and_m_t":"    candidateCellInfoListMN         MeasResultList2NR                                                 OPTIONAL,","paragraph_zero_based":43651},{"literal_text_all_w_t_and_m_t":"    candidateCellInfoListSN         OCTET STRING (CONTAINING MeasResultList2NR)                       OPTIONAL,","paragraph_zero_based":43652},{"literal_text_all_w_t_and_m_t":"    measResultCellListSFTD-NR       MeasResultCellListSFTD-NR                                         OPTIONAL,","paragraph_zero_based":43653},{"literal_text_all_w_t_and_m_t":"    scgFailureInfo                  SEQUENCE {","paragraph_zero_based":43654},{"literal_text_all_w_t_and_m_t":"        failureType                     ENUMERATED { t310-Expiry, randomAccessProblem,","paragraph_zero_based":43655}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["23da2a020888342c1429eb02f9b82e56e4f57ea933ae49f4ab1f8462a82a18f0","4436f12faf9805968ff6d3d28090ccbf07c251217e439235bd4157da4811c784","a1fcd47a2738b969320ed6cea9f740cec0b5dd5c453bbf2ab029b3469f410ce3","7b9f7753a0225678bac758eb9290d60e8a4d012ddc014985d2be329bde5728ec","29123b20850dee59422cdda396b0b4706bb88b001bf3375567bfe2112dbc626c","0ac00000b590a400203e13324d1c0be0b08af3ccf64716b2428742b7c3fde2a6","e7a36d344cd4d8a23dcb66b3e6c923ef49e0daf96726fc7db377b45969fb43d8