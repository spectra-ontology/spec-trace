{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the number of PDSCH transmission occasions for slot-based repetition scheme in IE RepetitionSchemeConfig. The parameter is used as specified in 38.214 [19].","paragraph_zero_based":22632},{"literal_text_all_w_t_and_m_t":"startSymbolAndLength","paragraph_zero_based":22633},{"literal_text_all_w_t_and_m_t":"An index giving valid combinations of start symbol and length (jointly encoded) as start and length indicator (SLIV). The network configures the field so that the allocation does not cross the slot boundary (see TS 38.214 [19], clause 5.1.2.1).","paragraph_zero_based":22634},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22635},{"literal_text_all_w_t_and_m_t":"MultiPDSCH-TimeDomainResourceAllocation field descriptions","paragraph_zero_based":22636},{"literal_text_all_w_t_and_m_t":"pdsch-TDRA-List","paragraph_zero_based":22637},{"literal_text_all_w_t_and_m_t":"One or multiple PDSCHs which can be in consecutive or non-consecutive slots (see TS 38.214 [19], clause 5.1.2.1). ","paragraph_zero_based":22638},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22639},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":22640},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":22641},{"literal_text_all_w_t_and_m_t":"Format1-2","paragraph_zero_based":22642},{"literal_text_all_w_t_and_m_t":"In pdsch-TimeDomainAllocationListDCI-1-2, this field is optionally present, Need R. It is absent, Need R, otherwise.","paragraph_zero_based":22643},{"literal_text_all_w_t_and_m_t":"Formats1-0_1-1_4-0_4-1_4-2","paragraph_zero_based":22644},{"literal_text_all_w_t_and_m_t":"In pdsch-TimeDomainAllocationListDCI-1-2, pdsch-TimeDomainAllocationListForMultiPDSCH, and SIB20, this field is absent.","paragraph_zero_based":22645},{"literal_text_all_w_t_and_m_t":"Otherwise, in pdsch-TimeDomainResourceAllocationList-r16, this field is optionally present, Need R.","paragraph_zero_based":22646},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22647},{"literal_text_all_w_t_and_m_t":"–PHR-Config","paragraph_zero_based":22648},{"literal_text_all_w_t_and_m_t":"The IE PHR-Config is used to configure parameters for power headroom reporting.","paragraph_zero_based":22649},{"literal_text_all_w_t_and_m_t":"PHR-Config information element","paragraph_zero_based":22650},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":22651},{"literal_text_all_w_t_and_m_t":"-- TAG-PHR-CONFIG-START","paragraph_zero_based":22652},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22653},{"literal_text_all_w_t_and_m_t":"PHR-Config ::=                      SEQUENCE {","paragraph_zero_based":22654},{"literal_text_all_w_t_and_m_t":"    phr-PeriodicTimer                   ENUMERATED {sf10, sf20, sf50, sf100, sf200,sf500, sf1000, infinity},","paragraph_zero_based":22655}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["4c25c850fdebecdcec74cfa022b2b5d885901b54c79dff596e9d35b9accbdd93","8db965e31e98080f05160ae2ebdd3efeb32d82084cc35519a7ecac1da7e86e3d","de01cdd2f8da8fdef7dbbdd1be42ab84d8895475f5da6485917e1c9def5dd5eb","d7c6d7da99ac894b8828991306ed21bf5f7457c31184b6e9d83632c10383ff64","4e7004591444f60d289324d7125aaa6324b14d3bc0f40408eab5ad79fb121f20","ef0289e10dfec110fb4e5f944c86ac1c94c95897c9bc4c0d65e853d60f20256e","07097d908b18ff59ea12af4faad1ee591e70e5b758ff13c3cf99c80d30e48a16","07ea78a7787b54949b7f6a3b08dbabfc2f2ae44e3e4839fabf858c36c1488a3e","116f9041a139691629b6cb0453c8f750eff1cfaec0e7036185c11