{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22032},{"literal_text_all_w_t_and_m_t":"PCI-Range field descriptions","paragraph_zero_based":22033},{"literal_text_all_w_t_and_m_t":"range","paragraph_zero_based":22034},{"literal_text_all_w_t_and_m_t":"Indicates the number of physical cell identities in the range (including start). Value n4 corresponds with 4, value n8 corresponds with 8 and so on. The UE shall apply value 1 in case the field is absent, in which case only the physical cell identity value indicated by start applies.","paragraph_zero_based":22035},{"literal_text_all_w_t_and_m_t":"start","paragraph_zero_based":22036},{"literal_text_all_w_t_and_m_t":"Indicates the lowest physical cell identity in the range.","paragraph_zero_based":22037},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22038},{"literal_text_all_w_t_and_m_t":"–PCI-RangeElement","paragraph_zero_based":22039},{"literal_text_all_w_t_and_m_t":"The IE PCI-RangeElement is used to define a PCI-Range as part of a list (e.g. AddMod list).","paragraph_zero_based":22040},{"literal_text_all_w_t_and_m_t":"PCI-RangeElement information element","paragraph_zero_based":22041},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":22042},{"literal_text_all_w_t_and_m_t":"-- TAG-PCI-RANGEELEMENT-START","paragraph_zero_based":22043},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22044},{"literal_text_all_w_t_and_m_t":"PCI-RangeElement ::=                SEQUENCE {","paragraph_zero_based":22045},{"literal_text_all_w_t_and_m_t":"    pci-RangeIndex                      PCI-RangeIndex,","paragraph_zero_based":22046},{"literal_text_all_w_t_and_m_t":"    pci-Range                           PCI-Range","paragraph_zero_based":22047},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22048},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22049},{"literal_text_all_w_t_and_m_t":"-- TAG-PCI-RANGEELEMENT-STOP","paragraph_zero_based":22050},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":22051},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22052},{"literal_text_all_w_t_and_m_t":"PCI-RangeElement field descriptions","paragraph_zero_based":22053},{"literal_text_all_w_t_and_m_t":"pci-Range","paragraph_zero_based":22054},{"literal_text_all_w_t_and_m_t":"Physical cell identity or a range of physical cell identities.","paragraph_zero_based":22055}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["2ea7d9614141e6acbb40e41045f318dfe0293145122603ec8094978fb252ecb6","793bf70e86d4d1e1accc9fc2430ee5e9da25b8fd6b77f46eb0d9f5686ff6546e","f28788736f32ed183a8bc504c87d19a67fb39094ed461e211de09f3e84190298","a72519ec31e198bd66d76fc845f1bb070ba90555e494fdc430a520eb011eddfa","1d155027ee251fbb8bb1e5747abea15e0925ada6f427b1ab6bcebbd1b2ac661d","aef40baf51b1e3e363848bb81dbabd997f24d247e36be5c38a47ee0316d98913","d17e5aae0a2e25ede35af510a1a0656cc8d69623b29607fb7e3cb849cc67ec59","b3d9c94e9d8558bf38f599b896d72911a630cb2c60964290e074c35651a17aa6","3c3b1edc770ca4d78b3ed30a8ffb5ef9b476ff2ab6dee78d19aac28592caff22","97f4bfcf77f1d44c505d7a4ac4a1708e4bd24494ba522b97b28d9a908e5cc7ab","47e9e7a2727e1b7a7c66e338839e3a90ae3171cdc7ffe084ccabf5324f1a5240","6c2133407cbd88c3b6884e0bf460a021894ac9b428ab83401a3a570978607311","bb926853ebfe602a6753fb4f9af32a0931aa4dea94675193e599a631c39033a8","3787c411a2809ffea66858f5fa90fdeefcc2a26470a4e2fc4a95dc11e254cc92","7bc7deb2d29f3e389a15faa003a3260a1ce2454f6b502d6b39ed42c2ff88b464","cac3c1e03b145b5239d8d9a7aa0984417c8bd5a2ab9e6ceb510bd70044c2