{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28656},{"literal_text_all_w_t_and_m_t":"-- TAG-SPS-CONFIGINDEX-STOP","paragraph_zero_based":28657},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28658},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28659},{"literal_text_all_w_t_and_m_t":"–SPS-PUCCH-AN","paragraph_zero_based":28660},{"literal_text_all_w_t_and_m_t":"The IE SPS-PUCCH-AN is used to indicate a PUCCH resource for HARQ ACK and configure the corresponding maximum payload size for the PUCCH resource.","paragraph_zero_based":28661},{"literal_text_all_w_t_and_m_t":"SPS-PUCCH-AN information element","paragraph_zero_based":28662},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28663},{"literal_text_all_w_t_and_m_t":"-- TAG-SPS-PUCCH-AN-START","paragraph_zero_based":28664},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28665},{"literal_text_all_w_t_and_m_t":"SPS-PUCCH-AN-r16  ::=           SEQUENCE {","paragraph_zero_based":28666},{"literal_text_all_w_t_and_m_t":"    sps-PUCCH-AN-ResourceID-r16     PUCCH-ResourceId,","paragraph_zero_based":28667},{"literal_text_all_w_t_and_m_t":"    maxPayloadSize-r16              INTEGER (4..256)                     OPTIONAL    -- Need R","paragraph_zero_based":28668},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28669},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28670},{"literal_text_all_w_t_and_m_t":"-- TAG-SPS-PUCCH-AN-STOP","paragraph_zero_based":28671},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28672},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28673},{"literal_text_all_w_t_and_m_t":"SPS-PUCCH-AN field descriptions","paragraph_zero_based":28674},{"literal_text_all_w_t_and_m_t":"maxPayloadSize","paragraph_zero_based":28675},{"l