fc242241459b","dca87bbc6e0659b40a5d02aaa0c9409f92373fb1bf23e6b453084863dcaaaa6d","3b92e669035cb171032f1b2c3edd002c6dd802446af9751059782c676a0940ad","8203a822d05726bb046c32c17349f80b36239624a98a10d8479db05b6712489b","7a966564ec27aaede8141815311b4efef75f166293d85829ac5de20dbe518d7b","4358dd403db9929203223d68d02fa6cf872806c83445b8ee937935aefd2cdb0d","250e1aa08949bcc8e387d86a1aa87cda4fa559735526b6f9f0e87e0db51fd793","5d49758318382feac30f38f08fb3ee45b74b5408c8a6e9c063d58201bb6aa6ae"],"paragraph_range_zero_based":[11112,11135],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p11112"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"RRCSystemInfoRequest-IEs field descriptions","paragraph_zero_based":11136},{"literal_text_all_w_t_and_m_t":"requested-SI-List","paragraph_zero_based":11137},{"literal_text_all_w_t_and_m_t":"Contains a list of requested SI messages which are configured by schedulingInfoList in si-SchedulingInfo and schedulingInfoList2 in si-SchedulingInfo-v1700 (if present) in SIB1.","paragraph_zero_based":11138},{"literal_text_all_w_t_and_m_t":"If si-SchedulingInfo-v1700 is not present:","paragraph_zero_based":11139},{"literal_text_all_w_t_and_m_t":"-According to the order of entry in the list of SI messages configured by schedulingInfoList in si-SchedulingInfo in SIB1, first bit corresponds to first/leftmost listed SI message, second bit corresponds to second listed SI message, and so on.","paragraph_zero_based":11140},{"literal_text_all_w_t_and_m_t":"If si-SchedulingInfo-v1700 is present:","paragraph_zero_based":11141},{"literal_text_all_w_t_and_m_t":"-The UE generates a list of concatenated SI messages by appending the SI messages containing type1 SIB configured by schedulingInfoList2 in si-SchedulingInfo-v1700 to the SI messages configured by schedulingInfoList in si-SchedulingInfo.","paragraph_zero_based":11142},{"literal_text_all_w_t_and_m_t":"-According to the order of entry in the list of concatenated SI messages, first bit corresponds to first/leftmost listed SI message, second bit corresponds to second listed SI message, and so on.","paragraph_zero_based":11143},{"literal_text_all_w_t_and_m_t":"requestedPosSI-List","paragraph_zero_based":11144},{"literal_text_all_w_t_and_m_t":"Contains a list of requested SI messages which are configured by posSchedulingInfoList in posSI-SchedulingInfo and schedulingInfoList2 in si-SchedulingInfo-v1700 (if present) in SIB1.","paragraph_zero_based":11145},{"literal_text_all_w_t_and_m_t":"If si-SchedulingInfo-v1700 is not present:","paragraph_zero_based":11146},{"literal_text_all_w_t_and_m_t":"-According to the order of entry in the list of SI messages configured by posSchedulingInfoList in posSI-SchedulingInfo in SIB1, first bit corresponds to first/leftmost listed SI message, second bit corresponds to second listed SI message, and so on.","paragraph_zero_based":11147},{"literal_text_all_w_t_and_m_t":"If si-SchedulingInfo-v1700 is present:","paragraph_zero_based":11148},{"literal_text_all_w_t_and_m_t":"-The UE creates a list of concatenated SI messages by appending the SI messages containing type2 SIB configured by schedulingInfoList2 in si-SchedulingInfo-v1700 to the SI messages configured by posSchedulingInfoList in posSI-SchedulingInfo.","paragraph_zero_based":11149},{"literal_text_all_w_t_and_m_t":"-According to the order of entry in the list of concatenated SI messages, first bit corresponds to first/leftmost listed SI message, second bit corresponds to second listed SI message, and so on.","paragraph_zero_based":11150},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11151},{"literal_text_all_w_t_and_m_t":"–SCGFailureInformation","paragraph_zero_based":11152},{"literal_text_all_w_t_and_m_t":"The SCGFailureInformation message is used to provide information regarding NR SCG failures detected by the UE.","paragraph_zero_based":11153},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1","paragraph_zero_based":11154},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":11155},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":11156},{"literal_text_all_w_t_and_m_t":"Direction: UE to Network","paragraph_zero_based":11157},{"literal_text_all_w_t_and_m_t":"SCGFailureInformation message","paragraph_zero_based":11158},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":11159}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["c59e05ba2e15501a449a9918023c45a024145f6f8bb99033e4b7abf535c70f46","b390c4413a51cb0ab43b7d033bcdfd98e324117e9152d49e2e9b4f6cb892083c","b763222dcf13cfb6f2e579414ef2c42bb68e4d9f8fe21d49a2c537282eba1765","463d3e18017a9bb89a0b6bced8f3a88850050bc4f198147eafc1877332f8e2a5","123f3802789ad8edbae4f2a9b9043ca9e7ff3df9066ccaab595b5d9b94ca37bd","c6f42aa36713f05d58b02768b6d5b4a927c481e3dc3e80aa2a2ca80482d63eaf","31f6a03e4ebb645cad995ade1bc385111701708d9ae1388de8a985b96b5489c4","c6dad1c1b56b7e91b9f7dd4d11359f32e71239101e3e49017a1516ceeb7a8383","49ee26ea770a91cd5cf4503f7d52171274eec276778d50b1fad3d5402b51979c","f7fd292e5530ea86c220f56a25c55d24378dd3ea75c6c52bbd92d7b19f58226f","2d7149121e3eee9e5543b41b0ba007966cfdf49bbdf4a7c30d1c3d31a7f46272","4d4f97c8667f6d3d9e447595208c5b66e907cad14e2a4264b9fd9e244477da5a","f64584428471f4af6d3ac4b6c67079945cc4e0bffb7bdedb69bafbd6ca9bbd6f","3bb3c605d432c3ca81d1a0e44369bc605f4f0ebe4ea7bdea47b99c9dfe3af9d6","e953148f77c598ea1595309a01e661119142d47bdbe45241eb6dd68618e13a93","30b87ca6bed7aa50db78035c42d3f07e6ffa422a16a737c7cae51dc179928c0f","8a27650a118e117dea1cc3e201ff58e721203e82072aafecc7fbbc7c47e61be9","375beb2cbe436c7e3b906cba49708eba2d5071efec2aaf2fb865fb9ae7e99652","d881e49d18903eb01b4c281c6bf1cf46b178536047c38022253b80380f3d6adb","182ddfd5268b46124e4fc0c9102d0cbcd75db5893dd6374a2ec80584735fe83c","82f7933d536f224906683331f9f040f060cc4a15e40ff429225df9641bc9c5ec","5a7c1cc99868d6327b20f3cd16a56c53aebc2485d1936fa36b2a3c2308dc785b","3b845dc260150c08e4d18aea01f28fa216403e4c9cf1f024decae37e5e0277e4","976f2796cc263ab0c9883460383e803d558f2141e79b55fefbac5711a4080c00"],"paragraph_range_zero_based":[11136,11159],"projection":"All w:t and m:t including tracked inserti