{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"If set to 1: indication that the UE may stop monitoring PDCCH occasion(s) for paging in this Paging Occasion as specified in TS 38.304 [20], clause 7.1.","paragraph_zero_based":40560},{"literal_text_all_w_t_and_m_t":"4","paragraph_zero_based":40561},{"literal_text_all_w_t_and_m_t":"systemInfoModification-eDRX","paragraph_zero_based":40562},{"literal_text_all_w_t_and_m_t":"If set to 1: indication of a BCCH modification other than SIB6, SIB7, SIB8 and posSIBs. This indication applies only to UEs using IDLE eDRX cycle longer than the BCCH modification period.","paragraph_zero_based":40563},{"literal_text_all_w_t_and_m_t":"5 – 8","paragraph_zero_based":40564},{"literal_text_all_w_t_and_m_t":"Not used in this release of the specification, and shall be ignored by UE if received.","paragraph_zero_based":40565},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40566},{"literal_text_all_w_t_and_m_t":"6.6PC5 RRC messages","paragraph_zero_based":40567},{"literal_text_all_w_t_and_m_t":"6.6.1General message structure","paragraph_zero_based":40568},{"literal_text_all_w_t_and_m_t":"–PC5-RRC-Definitions","paragraph_zero_based":40569},{"literal_text_all_w_t_and_m_t":"This ASN.1 segment is the start of the PC5 RRC PDU definitions.","paragraph_zero_based":40570},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":40571},{"literal_text_all_w_t_and_m_t":"-- TAG-PC5-RRC-DEFINITIONS-START","paragraph_zero_based":40572},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40573},{"literal_text_all_w_t_and_m_t":"PC5-RRC-Definitions DEFINITIONS AUTOMATIC TAGS ::=","paragraph_zero_based":40574},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40575},{"literal_text_all_w_t_and_m_t":"BEGIN","paragraph_zero_based":40576},{"literal_text_all_w_t_and_m_t":"","paragraph