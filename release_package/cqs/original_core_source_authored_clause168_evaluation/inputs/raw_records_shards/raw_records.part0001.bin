{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":25704},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":25705},{"literal_text_all_w_t_and_m_t":"RefTime","paragraph_zero_based":25706},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if referenceTimeInfo is included in DLInformationTransfer message; otherwise the field is absent.","paragraph_zero_based":25707},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25708},{"literal_text_all_w_t_and_m_t":"–RejectWaitTime","paragraph_zero_based":25709},{"literal_text_all_w_t_and_m_t":"The IE RejectWaitTime is used to provide the value in seconds for timer T302.","paragraph_zero_based":25710},{"literal_text_all_w_t_and_m_t":"RejectWaitTime information element","paragraph_zero_based":25711},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25712},{"literal_text_all_w_t_and_m_t":"-- TAG-REJECTWAITTIME-START","paragraph_zero_based":25713},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25714},{"literal_text_all_w_t_and_m_t":"RejectWaitTime ::=                  INTEGER (1..16)","paragraph_zero_based":25715},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25716},{"literal_text_all_w_t_and_m_t":"-- TAG-REJECTWAITTIME-STOP","paragraph_zero_based":25717},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":25718},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25719},{"literal_text_all_w_t_and_m_t":"–RepetitionSchemeConfig","paragraph_zero_based":25720},{"literal_text_all_w_t_and_m_t":"The IE RepetitionSchemeConfig is used to configure the UE with repetition schemes as specified in TS 38.214 [19] clause 5.1.","paragraph_zero_based":25721},{"literal_text_all_w_t_and_m_t":"RepetitionSchemeConfig information element","paragraph_zero_based":25722},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25723},{"literal_text_all_w_t_and_m_t":"-- TAG-REPETITIONSCHEMECONFIG-START","paragraph_zero_based":25724},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25725},{"literal_text_all_w_t_and_m_t":"RepetitionSchemeConfig-r16 ::= CHOICE {","paragraph_zero_based":25726},{"literal_text_all_w_t_and_m_t":"    fdm-TDM-r16                        SetupRelease { FDM-TDM-r16 },","paragraph_zero_based":25727}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["446965703670bc9e464ef0aa8d01773b970273072f8803bb4c45ae1a90eb16d5","e15023090b7324d92d07066420f636e5fb9ca6d2a19484ae2ee603a1b606f9f4","2d1874e13cea4ddee530fed3b9caa2630eceead5c403f678c350f4e870562a41","5816fe20d8e81f0a6b447d5a920a02dd67f6d0457977fd911b5be29cf91ddb57","f03ea5e535a84c184ece0a6b80f24627b1613272105337d401eb16907e3a5bfb","bfa2f9800b4e1835f57099c9404350d0197bd51cbe0ea44ab096ae8a0cec5f22","06c88e9add3ab3580d42e410a5fc3b6251eda25a019de2da7d7de67b4d1aea2b","d2e6683164703dda6e3f140a436587e891e996d72cb6168da6f63c152d9dba4c","109ffa134e3a66e26bb73ea46b37419aac58cc28c216a7eab31869dc5ef33be9","7a099f6faa175afa6cffe3132b40531801a66cd0795ef4dc962814a67dd65932","75fdfb005315ff485e3fbc9fe1db8443d8905aaa75f7ea5aa7e084ab17ec76e3","b66c3dba3ac68966f0583b962fb7ab9e6f3b8f97680ec607178bb5a7c3207375","eaf38ff596fdcde72dcfb0159ba185276d409ef097f54ec94a9386a62fbf8483","d9f57eb189e937ebfd464e01e4103147b8c8638714cf1999decfa06469d16be9","ccaf47499f6bdf5474b916f7633195b2a0c953eac644475a9987961f416cc743","03d634a4cec2167cd8be57623fd5aa8b19388a986ea153c5d45b0ee19c7cd6a2","cf780c5fe30a6e0291ee849259047b36125387e45b670b91c09feb473c258d5b","4165abf723379ef44b3ab8f6