{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE RxTxTimeDiff contains the Rx-Tx time difference measurement at either the UE or the gNB.","paragraph_zero_based":26904},{"literal_text_all_w_t_and_m_t":"RxTxTimeDiff information element","paragraph_zero_based":26905},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26906},{"literal_text_all_w_t_and_m_t":"-- TAG-RXTXTIMEDIFF-START","paragraph_zero_based":26907},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26908},{"literal_text_all_w_t_and_m_t":"RxTxTimeDiff-r17  ::= SEQUENCE {","paragraph_zero_based":26909},{"literal_text_all_w_t_and_m_t":"    result-k5-r17         INTEGER (0..61565)                 OPTIONAL, -- Need N","paragraph_zero_based":26910},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":26911},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":26912},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26913},{"literal_text_all_w_t_and_m_t":"-- TAG-RXTXTIMEDIFF-STOP","paragraph_zero_based":26914},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26915},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26916},{"literal_text_all_w_t_and_m_t":"RxTxTimeDiff field descriptions","paragraph_zero_based":26917},{"literal_text_all_w_t_and_m_t":"result-k5","paragraph_zero_based":26918},{"literal_text_all_w_t_and_m_t":"This field indicates the Rx-Tx time difference measurement, see TS 38.215 [9], clause 10.1.25.3.1 of TS 38.133 [14] for UE Rx-Tx time difference and clause 13.2.1 of TS 38.133 [14] for gNB Rx-Tx time difference.","paragraph_zero_based":26919},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26920},{"literal_text_all_w_t_and_m_t":"–SCellActivationRS-Config","paragraph_zero_based":26921},{"literal_text_all_w_t_and_m_t":"The IE SCellActivationRS-Config is used to configure a Reference Signal for fast activation of the SCell where the IE is included (see TS 38.214 [19], clause 5.2.1.5.3. Usage of an SCellActivationRS-Config is indicated by including its scellActivationRS-Id in the Enhanced SCell activation MAC CE (see TS 38.321 [3] clause 6.1.3.55).","paragraph_zero_based":26922},{"literal_text_all_w_t_and_m_t":"SCellActivationRS-Config information element","paragraph_zero_based":26923},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26924},{"literal_text_all_w_t_and_m_t":"-- TAG-SCELLACTIVATIONRS-CONFIG-START","paragraph_zero_based":26925},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26926},{"literal_text_all_w_t_and_m_t":"SCellActivationRS-Config-r17 ::= SEQUENCE {","paragraph_zero_based":26927}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["596d3e29c67b65da05448e7acab203546066c8480a03fd5425d6370a509ed3d3","8ffaa1f5c880749e211373f94ef9dad7158dd5c2ad0fd56b8247ae25befc9737","d8206c982dfecf6b472b6057736344b5a1eab5232b5208010fc4f7a77b7045d4","4e4dc09bba4fd7b565fa00b2facc97939a01841b01d5ce4b377cd85f9c8c0d1b","253da9b188e94a087e89804418c420e90fd42e0127f3a8935665a1ecedb5054a","ba67799774207d0b281b5d4a09f80c7fea11679ce25990a0a1ad04eec906f178","6227496c20a8c3b9607d3f5c5d637dcec69fabc2cfc7dfd72835a1ff7f40e9f2","54d02e5922e5cb92195f83c752a82fbdccc60a3798fb5364cc80f37a289dc098","7c1197fa30b8d4e8ada1e069615999b025deba88c4ca9890f9173497e539b41f","3c2446cad421f7bc4349cf995b858142472881b7c2e083efdd94d0531dec2500","422e912192f7cefdc83a1a414da1def27a448c8488dc93c8fdcf0f7f145113b5","f303d4a8eaa8d5502b07be2b8bd189722d3cec3297b3c9c957c4054eb108cc7b","de29f212a6c5022f770ed4c488c0efbea5d4a326476d062ab5b05e79f