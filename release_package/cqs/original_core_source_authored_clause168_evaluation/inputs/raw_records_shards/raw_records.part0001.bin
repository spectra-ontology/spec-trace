{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        redCapPriority-r17                  FeaturePriority-r17                                             OPTIONAL, -- Need R","paragraph_zero_based":27648},{"literal_text_all_w_t_and_m_t":"        slicingPriority-r17                 FeaturePriority-r17                                             OPTIONAL, -- Need R","paragraph_zero_based":27649},{"literal_text_all_w_t_and_m_t":"        msg3-Repetitions-Priority-r17       FeaturePriority-r17                                             OPTIONAL, -- Need R","paragraph_zero_based":27650},{"literal_text_all_w_t_and_m_t":"        sdt-Priority-r17                    FeaturePriority-r17                                             OPTIONAL  -- Need R","paragraph_zero_based":27651},{"literal_text_all_w_t_and_m_t":"    }                                                                                                       OPTIONAL  -- Need R","paragraph_zero_based":27652},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":27653},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":27654},{"literal_text_all_w_t_and_m_t":"    ra-ChannelAccess-r17            ENUMERATED {enabled}                                                OPTIONAL -- Cond SharedSpectrum2","paragraph_zero_based":27655},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":27656},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27657},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27658},{"literal_text_all_w_t_and_m_t":"-- TAG-SERVINGCELLCONFIGCOMMON-STOP","paragraph_zero_based":27659},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27660},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27661},{"literal_text_all_w_t_and_m_t":"ServingCellConfigCommon field descriptions","paragraph_zero_based":27662},{"literal_text_all_w_t_and_m_t":"channelAccessMode","paragraph_zero_based":27663},{"literal_text_all_w_t_and_m_t":"If present, this field indicates which channel access procedures to apply for operation with shared spectrum channel access as defined in TS 37.213 [48]. If the field is configured as \"semiStatic\", the UE shall apply the channel access procedures for semi-static channel occupancy as described in clause 4.3 in TS 37.213. If the field is configured as \"dynamic\", the UE shall apply the channel access procedures as defined in TS 37.213, clause 4.1 and 4.2.","paragraph_zero_based":27664},{"literal_text_all_w_t_and_m_t":"channelAccessMode2","paragraph_zero_based":27665},{"literal_text_all_w_t_and_m_t":"If present, the UE shall apply channel access procedures for operation with shared spectrum channel access in accordance with TS 37.213 [48], clause 4.4 for FR2-2. If absent, the UE shall not apply any channel access procedure. The network always configures this field if channel access procedures are required for the serving cell within this region by regulations.","paragraph_zero_based":27666},{"literal_text_all_w_t_and_m_t":"dmrs-TypeA-Position","paragraph_zero_based":27667},{"literal_text_all_w_t_and_m_t":"Position of (first) DM-RS for downlink (see TS 38.211 [16], clause 7.4.1.1.1) and uplink (TS 38.211 [16], clause 6.4.1.1.3).","paragraph_zero_based":27668},{"literal_text_all_w_t_and_m_t":"downlinkConfigCommon","paragraph_zero_based":27669},{"literal_text_all_w_t_and_m_t":"The common downlink configuration of the serving cell, including the frequency information configuration and the initial downlink BWP common configuration. The parameters provided herein should match the parameters configured by MIB and SIB1 (if provided) of the serving cell, with the exception of controlResourceSetZero and searchSpaceZero which can be configured in ServingCellConfigCommon even if MIB indicates that they are absent.","paragraph_zero_based":27670},{"literal_text_all_w_t_and_m_t":"discoveryBurstWindowLength","paragraph_zero_based":27671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["78c0076f096c487dba5f380018f51462116ee26efc99d1c39bbcb1d390105799","37fd8533b1c61188a65e2300f3cc4e42fdc39cbeff12c2db49861a8adddcd7b4","e273f90d46cae2ffa00573d21249c60b154e5fd22844ebc5fb975f43eed1b93d","6e847767a6a4e7b256978604e210120491e01a16ef28e1bab9a01f9564a28521","ff4a6fc6eaad7fa0c5f843e44f8df408ac4ce9f3d702149cc6f6fa1b46ad64c4","61c72df3b214b6dd39444fc47f72d1e22d4e4c1d2cff9bb7cb7aba3cea68b961","5cc6f0d5f962d5f68b7ed8c2aaca80412143b9594b97d393c9fa77b79a545f59","165226d4921c47461f517b203e2a1be68e879bcbe4cdc9ca4feb95a15aafa96d","afeee6ff0f6cf8a2f6b0f19bbe1000d1b1caca2170c8ec8bf00fc4eba66cadd7","6901d4402bc9c8b426fc130d44a7a97ca2fed97d2992d8e9a964a5cef0c4be88","b570b2befe330c0d90f72b37374f26c572c2dbca05efc2f1c871575497661e8e","ad1e0068e219628ad565dcde97b7c991d7997ae2fa2c7c2cdf4a3e77e92dd871","b00191be6ed73c92e5649f0b855b40cffa7a970d5517878a155faa1996d6fff1","bae4ccf6be72a1b4bbb776156afd0f16659156de5c2e49be8dfd033ca45d6f95","c837e4c8ae2c6dcd4b3a0ad1dc32b794208322cfcf317b6bd87e83d8d95a9a81","cf0792ecafbf238cb2ce6ac6f13561b11299deccb3f64ff2999243828672e230","aa214f8b77f3cfa8c5092604674cb20442e59c3146d8c5ae1aa86a97b064c3d1","8488ebf60ffdbc2ee02ef458c93d5a0ac02ee0948e5468f920add9bf9ac32b93","2d013593bdbee56344ec415d2633dc8c7525b43f51248bd0f3d0c54f2bd7994a","9d1b4b67c13262b71e37b918ca782f5bcb437dd95ceb322acd461d0113d340c2","638791ae9df64ab165e7da6aa5fa8e70198f90c745a925060f730864317b0222","1175e7240b3eb3ea6924e773edf5e5e8b0b125f22624863ea826253b9abb76f4","67f0b694262443621aa761dcc14dc94111cfd70a7b72aa02c9137ade01f89101","53b83d3b441bb2e19f426b25e38f374b769661c60586cbd8dfe9e16ed9f36f30"],"paragraph_range_zero_based":[27648,27671],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p27648"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the window length of the discovery burst in ms (see TS 37.213 [48]). The field discoveryBurstWindowLength-r17 is applicable to SCS 480 kHz and SCS 960 kHz.","paragraph_zero_based":27672},{"literal_text_all_w_t_and_m_t":"featurePriorities","paragraph_zero_based":27673},{"literal_text_all_w_t_and_m_t":"Indicates priorities for features, such as RedCap, Slicing, SDT and MSG3-Repetitions for Coverage Enhancements. These priorities are used to determine which FeatureCombinationPreambles the UE shall use when a feature maps to more than one FeatureCombinationPreambles, as specified in TS 38.321 [3]. A lower value means a higher priority. The network does not signal the same priority for more than one feature. The network signals a priority for all feature that map to at least one FeatureCombinationPreambles.","paragraph_zero_based":27674},{"literal_text_all_w_t_and_m_t":"longBitmap","paragraph_zero_based":27675},{"literal_text_all_w_t_and_m_t":"Bitmap when maximum number of SS/PBCH blocks per half frame equals to 64 as defined in TS 38.213 [13], clause 4.1.","paragraph_zero_based":27676},{"literal_text_all_w_t_and_m_t":"lte-CRS-ToMatchAround","paragraph_zero_based":27677},{"literal_text_all_w_t_and_m_t":"Parameters to determine an LTE CRS pattern that the UE shall rate match around.","paragraph_zero_based":27678},{"literal_text_all_w_t_and_m_t":"mediumBitmap","paragraph_zero_based":27679},{"literal_text_all_w_t_and_m_t":"Bitmap when maximum number of SS/PBCH blocks per half frame equals to 8 as defined in TS 38.213 [13], clause 4.1.","paragraph_zero_based":27680},{"literal_text_all_w_t_and_m_t":"n-TimingAdvanceOffset","paragraph_zero_based":27681},{"literal_text_all_w_t_and_m_t":"The N_TA-Offset to be applied for all uplink transmissions on this serving cell. If the field is absent, the UE applies the value defined for the duplex mode and frequency range of this serving cell. See TS 38.133 [14], table 7.1.2-2.","paragraph_zero_based":27682},{"literal_text_all_w_t_and_m_t":"ra-ChannelAccess","paragraph_zero_based":27683},{"literal_text_all_w_t_and_m_t":"If present, this field indicates that the UE shall apply channel access procedures before msg1/msgA transmission for operation with shared spectrum channel access in accordance with TS 37.213 [48], clause 4.4.5 for FR2-2.","paragraph_zero_based":27684},{"literal_text_all_w_t_and_m_t":"rateMatchPatternToAddModList","paragraph_zero_based":27685},{"literal_text_all_w_t_and_m_t":"Resources patterns which the UE should rate match PDSCH around. The UE rate matches around the union of all resources indicated in the rate match patterns. Rate match patterns defined here on cell level apply only to PDSCH of the same numerology (see TS 38.214 [19], clause 5.1.4.1). If a RateMatchPattern with the same RateMatchPatternId is configured in both ServingCellConfig/ServingCellConfigCommon and in SIB20/MCCH, the entire RateMatchPattern configuration, including the set of RBs/REs indicated by the patterns for the rate matching around, shall be the same and they are counted as a single rate match pattern in the total configured rate match patterns as defined in TS 38.214 [19].","paragraph_zero_based":27686},{"literal_text_all_w_t_and_m_t":"shortBitmap","paragraph_zero_based":27687},{"literal_text_all_w_t_and_m_t":"Bitmap when maximum number of SS/PBCH blocks per half frame equals to 4 as defined in TS 38.213 [13], clause 4.1.","paragraph_zero_based":27688},{"literal_text_all_w_t_and_m_t":"ss-PBCH-BlockPower","paragraph_zero_based":27689},{"literal_text_all_w_t_and_m_t":"Average EPRE of the resources elements that carry secondary synchronization signals in dBm that the NW used for SSB transmission, see TS 38.213 [13], clause 7.","paragraph_zero_based":27690},{"literal_text_all_w_t_and_m_t":"ssb-periodicityServingCell","paragraph_zero_based":27691},{"literal_text_all_w_t_and_m_t":"The SSB periodicity in ms for the rate matching purpose. If the field is absent, the UE applies the value ms5. (see TS 38.213 [13], clause 4.1)","paragraph_zero_based":27692},{"literal_text_all_w_t_and_m_t":"ssb-PositionQCL","paragraph_zero_based":27693},{"literal_text_all_w_t_and_m_t":"Indicates the QCL relation between SSB positions for this serving cell as specified in TS 38.213 [13], clause 4.1.","paragraph_zero_based":27694},{"literal_text_all_w_t_and_m_t":"ssb-PositionsInBurst","paragraph_zero_based":27695}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["49178fd570ba2c784ff08f655ada339e4a3cbbb0ad9665f5ecd6ae8ff07f82bf","c47525287e944eb5f469e1e4adcf957151f640762fc4af6b6e49d16ea915851b","5851110516767496d3c51be1239491e17e295ce85c53be9e5ab20407a6709c2a","7b4d72a5bb5c7d7b2749e22a0506df7314831827a316dae1a1f3898a26092ab1","55e5735cd7ac886643a5e8bdd52b80510afcd625ee62887d03fadccaf8b2c3a1","bbea2bdb82ecd891d7f108c644ac45a408ecdc524b19ed11ef1ba34d1d868fbe","74c47454d6518ed0f6cac6a3a363781560ee8ee4178d8eeed47d0b627f1ec88b","e787beaba036f83d3981087bd90c15cd0261118f63a22ad8c070e90774c2311c","aa7155d570909f6aed872f95d9d780546ce17d7104ecb5ed6d7add95b39caf7f","c83bc5f662ee648fbf7dec40a232b910af1865f00a3b1e00dfb55dff4e28bec2","b497db60ed7466c1ef155c11e9fff05c78d924b511c1cbb3c329400c749e17c9","7acd9d44a2c92b050f76a9bf826da79d16e2cbb460757f6bede4ccf8e729aa93","ce994696d0bac3ee6e088cb363c3069951310eeb149c1c31fade99737e9f8417","5f9db2ef0427898fd0cb840a5d487a4bebd913edbdd78428d4ac0f259b4a6249","e35491501c71166ecfb4e909da39b7f9779023690b5cbc66b70c6c95cfd7fcd0","d34152fcca01424505d0baf5009fd4f2cc1a1389c8f0f5c35b1a5dc4de3e6c6a","09cc9c50ff27226b7b7b8a659e348ad5d41099ccf982ef78ae04c2b0fa6e7575","6cd67b48a51635c96897c213781c1a687d32f0793ccee13f787b9eb82c6bb9d2","9a1b984581f3cacd7ba320d23e11288588b8193eba33bf3c75d9af658147a7d5","096868592664cb6928f060b35f760e67dbebfad110d87fd7ad455b5704dc2cd3","7cf96d902186f44ffeb18017e2b773d02f5dc918816b4c0550bba919239a1ee0","a72ef5bf061092fd1c861a9ebccb96c46e8978f372a6805038c0e3550d766577","66e3c9375b5744fe085df4ae400e85158410c3790a6b11fd401737d0ee36dda4","67149e9d6889bf8f02c414f1226a81a7a7d0bc8f727dca3483c65adf5345f9c6"],"paragraph_range_zero_based":[27672,27695],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p27672"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"For operation in licensed spectrum, indicates the time domain positions of the transmitted SS-blocks in a half frame with SS/PBCH blocks as defined in TS 38.213 [13], clause 4.1. The first/leftmost bit corresponds to SS/PBCH block index 0, the second bit corresponds to SS/PBCH block index 1, and so on. Value 0 in the bitmap indicates that the corresponding SS/PBCH block is not transmitted while value 1 indicates that the corresponding SS/PBCH block is transmitted. The network configures the same pattern in this field as in the corresponding field in ServingCellConfigCommonSIB.","paragraph_zero_based":27696},{"literal_text_all_w_t_and_m_t":"For operation with shared spectrum channel access, the UE assumes that one or more SS/PBCH blocks indicated by ssb-PositionsInBurst may be transmitted within the discovery burst transmission window and have candidate SS/PBCH blocks indexes corresponding to SS/PBCH block indexes provided by ssb-PositionsInBurst (see TS 38.213 [13], clause 4.1). If the k-th bit of ssb-PositionsInBurst is set to 1, the UE assumes that one or more SS/PBCH blocks within the discovery burst transmission window with candidate SS/PBCH block indexes corresponding to SS/PBCH block index equal to k – 1 may be transmitted; if the kt-th bit is set to 0, the UE assumes that the corresponding SS/PBCH block(s) are not transmitted. The k-th bit is set to 0, where k > ssb-PositionQCL and the number of actually transmitted SS/PBCH blocks is not larger than the number of 1's in the bitmap. The network configures the same pattern in this field as in the corresponding field in ServingCellConfigCommonSIB. For operation with shared spectrum channel access in FR1, only mediumBitmap is used, and for FR2-2, longBitmap is used.","paragraph_zero_based":27697},{"literal_text_all_w_t_and_m_t":"ssbSubcarrierSpacing","paragraph_zero_based":27698},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing of SSB.","paragraph_zero_based":27699},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":27700},{"literal_text_all_w_t_and_m_t":"FR1:   15 or 30 kHz","paragraph_zero_based":27701},{"literal_text_all_w_t_and_m_t":"FR2-1:  120 or 240 kHz","paragraph_zero_based":27702},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":27703},{"literal_text_all_w_t_and_m_t":"supplementaryUplinkConfig","paragraph_zero_based":27704},{"literal_text_all_w_t_and_m_t":"The network configures this field only if uplinkConfigCommon is configured. If this field is absent, the UE shall release the supplementaryUplinkConfig and the supplementaryUplink configured in ServingCellConfig of this serving cell, if configured.","paragraph_zero_based":27705},{"literal_text_all_w_t_and_m_t":"tdd-UL-DL-ConfigurationCommon","paragraph_zero_based":27706},{"literal_text_all_w_t_and_m_t":"A cell-specific TDD UL/DL configuration, see TS 38.213 [13], clause 11.1.","paragraph_zero_based":27707},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27708},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":27709},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":27710},{"literal_text_all_w_t_and_m_t":"AbsFreqSSB","paragraph_zero_based":27711},{"literal_text_all_w_t_and_m_t":"The field is absent when absoluteFrequencySSB in frequencyInfoDL is absent, otherwise the field is mandatory present.","paragraph_zero_based":27712},{"literal_text_all_w_t_and_m_t":"HOAndServCellAdd","paragraph_zero_based":27713},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon SpCell change (including path switch between a serving cell and a L2 U2N Relay UE) and upon serving cell (PSCell/SCell) addition. Otherwise, the field is absent.","paragraph_zero_based":27714},{"literal_text_all_w_t_and_m_t":"HOAndServCellWithSSB","paragraph_zero_based":27715},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon SpCell change and upon serving cell (SCell with SSB or PSCell) addition. Otherwise, the field is absent.","paragraph_zero_based":27716},{"literal_text_all_w_t_and_m_t":"SharedSpectrum","paragraph_zero_based":27717},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if this cell operates with shared spectrum channel access in FR1. Otherwise, it is absent, Need R.","paragraph_zero_based":27718},{"literal_text_all_w_t_and_m_t":"SharedSpectrum2","paragraph_zero_based":27719}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["55a3d369159eaadcd7ff056405f52cfe76e329f6bc7e18450683049642eead48","465b602e2cffa07672af3f5b6ef1c151e40b125f5caf5d4d593e0e64dc7959b1","9338cf9d75baf91bc106130d010c153bfa0d5e2d0508059609ac7828a7717ea4","3d0efa30726924ee112019a11fa0ef6d932e8a5ea6d1f5ca9d65aab927c9f69b","8b12f3476ce0fec24e8d8be70dc0b1917d9802de6a78213a26c80dabd020436e","adcf0f357b1317226c4f1e395ea5c779056a703f61af15675148de1f2496239d","a17a898158667a6c4f5515e0b3043294eb5da38e6dc4526ec3b485601204cfd5","ffc815747026174826ae617f3ad51b6a93e13ae6d99d8b91c5dfed6973b67807","299707a42639cc712d04f8ab8e439f8608f87910f49af0c43f479dedf3474b78","928d2c07bdc03e3536e8962f436f507e67070fb152f065dd9aa4c707e073f280","faf5c954e555bac35092a191c79337077da595c57bfd1eec5336f65f1d290dd0","141b62865e38dd3d8eb04aa2b9aa3222f7bc1ea7903c25e458931ed4b06cda6d","04cc75304efa75b2f75adcfa601646282decd4986273ccbcac06e0933f5191c0","72e1d46ef642e85289222e5f0edce633643b47fdbb29a71026b48a857da9e1cb","6ba7585dc99e98ea9e9b1bf6c7c873be35024917552fc37313149f7a9b89464d","ca6a26c52bab8073838224879137473657404ff404914b07e91557a6413e5322","92588b6fabd1afa0e4014a4d552f8713a75d9dc08cf6db2713bb04db375cdb6e","257d96425d8eb479e7eb6075a5ac9178b5c7f0b16b523206b47d1fa58f2f830b","4c5cfed390a698097ac49f0263d47a3c5a0682b89b79c9699c0f3ba3b2c800bb","b1dd45e5d5d01cbe491dbee1c2e1d55b7ae61d585bb8177727aac39a634dc7d8","fe66a1f6ff09405b3e7685ef559d280b114aee71802a9841caf9e31f7ba1292d","deca697fc766e5abf7b9c161847d2b2347b1134dc18a6670adbdb109e0247070","2db3b02ae2787d0ac09c39037296a562262c2471927a82329b41e97b335274ad","9788f10f8110b6c447e58452e8deeed9fdc456fac82299060cecaade3b7565c7"],"paragraph_range_zero_based":[27696,27719],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p27696"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is optionally present if this cell operates with shared spectrum channel access in FR2-2, Need R. Otherwise, it is absent, Need R.","paragraph_zero_based":27720},{"literal_text_all_w_t_and_m_t":"TDD","paragraph_zero_based":27721},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, for TDD cells; otherwise it is absent.","paragraph_zero_based":27722},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27723},{"literal_text_all_w_t_and_m_t":"–ServingCellConfigCommonSIB","paragraph_zero_based":27724},{"literal_text_all_w_t_and_m_t":"The IE ServingCellConfigCommonSIB is used to configure cell specific parameters of a UE's serving cell in SIB1.","paragraph_zero_based":27725},{"literal_text_all_w_t_and_m_t":"ServingCellConfigCommonSIB information element","paragraph_zero_based":27726},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27727},{"literal_text_all_w_t_and_m_t":"-- TAG-SERVINGCELLCONFIGCOMMONSIB-START","paragraph_zero_based":27728},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27729},{"literal_text_all_w_t_and_m_t":"ServingCellConfigCommonSIB ::=      SEQUENCE {","paragraph_zero_based":27730},{"literal_text_all_w_t_and_m_t":"    downlinkConfigCommon                DownlinkConfigCommonSIB,","paragraph_zero_based":27731},{"literal_text_all_w_t_and_m_t":"    uplinkConfigCommon                  UplinkConfigCommonSIB                                       OPTIONAL, -- Need R","paragraph_zero_based":27732},{"literal_text_all_w_t_and_m_t":"    supplementaryUplink                 UplinkConfigCommonSIB                                       OPTIONAL, -- Need R","paragraph_zero_based":27733},{"literal_text_all_w_t_and_m_t":"    n-TimingAdvanceOffset               ENUMERATED { n0, n25600, n39936 }                           OPTIONAL, -- Need S","paragraph_zero_based":27734},{"literal_text_all_w_t_and_m_t":"    ssb-PositionsInBurst                SEQUENCE {","paragraph_zero_based":27735},{"literal_text_all_w_t_and_m_t":"        inOneGroup                          BIT STRING (SIZE (8)),","paragraph_zero_based":27736},{"literal_text_all_w_t_and_m_t":"        groupPresence                       BIT STRING (SIZE (8))                                   OPTIONAL  -- Cond FR2-Only","paragraph_zero_based":27737},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":27738},{"literal_text_all_w_t_and_m_t":"    ssb-PeriodicityServingCell          ENUMERATED {ms5, ms10, ms20, ms40, ms80, ms160},","paragraph_zero_based":27739},{"literal_text_all_w_t_and_m_t":"    tdd-UL-DL-ConfigurationCommon       TDD-UL-DL-ConfigCommon                                      OPTIONAL, -- Cond TDD","paragraph_zero_based":27740},{"literal_text_all_w_t_and_m_t":"    ss-PBCH-BlockPower                  INTEGER (-60..50),","paragraph_zero_based":27741},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":27742},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":27743}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["f8c6d58e8aa9630cd960a27f3ab6274e879fd131c7397a45718771372eb73a8c","bf432ee1dc1caafc3854da4867b4c4e528cdf210a6c09529ec1ba8cea78b5a8a","2466d1c7973c7810934de03609cdbe6d22edb114f72e1f3a25c1c29f4c2c2762","4185c9f011235711eec54514ff7bee057c9a78b81f87674f9007327e78f339c9","db261bf92188ea67204281c30152c320b135c32bf86a4aa84f23bbbbcf3d679e","e752a794701f3a386acefac6c690fd9ab183d330a718825d762b60283be2e440","d58db3222cbb07f743d7fc3a3d9614a46994412642ff055b53e6119aa38