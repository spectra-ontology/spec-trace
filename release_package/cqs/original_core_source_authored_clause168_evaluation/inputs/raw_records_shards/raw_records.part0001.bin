{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"dl-PRS-PointA","paragraph_zero_based":18816},{"literal_text_all_w_t_and_m_t":"The ARFCN value of the carrier received from upper layers for which the UE needs to perform the NR DL-PRS measurements.","paragraph_zero_based":18817},{"literal_text_all_w_t_and_m_t":"nr-MeasPRS-RepetitionAndOffset","paragraph_zero_based":18818},{"literal_text_all_w_t_and_m_t":"Indicates the gap periodicity in ms and offset in number of subframes of the requested measurement gap for performing NR DL-PRS measurements.","paragraph_zero_based":18819},{"literal_text_all_w_t_and_m_t":"nr-MeasPRS-length","paragraph_zero_based":18820},{"literal_text_all_w_t_and_m_t":"Indicates measurement gap length in ms of the requested measurement gap for performing NR DL-PRS measurements. The measurement gap length is according to in Table 9.1.2-1 in TS 38.133 [14].","paragraph_zero_based":18821},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18822},{"literal_text_all_w_t_and_m_t":"–LogicalChannelConfig","paragraph_zero_based":18823},{"literal_text_all_w_t_and_m_t":"The IE LogicalChannelConfig is used to configure the logical channel parameters.","paragraph_zero_based":18824},{"literal_text_all_w_t_and_m_t":"LogicalChannelConfig information element","paragraph_zero_based":18825},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18826},{"literal_text_all_w_t_and_m_t":"-- TAG-LOGICALCHANNELCONFIG-START","paragraph_zero_based":18827},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18828},{"literal_text_all_w_t_and_m_t":"LogicalChannelConfig ::=            SEQUENCE {","paragraph_zero_based":18829},{"literal_text_all_w_t_and_m_t":"    ul-SpecificParameters               SEQUENCE {","paragraph_zero_based":18830},{"literal_text_all_w_t_and_m_t":"        priority                            INTEGER (1..16),","paragraph_zero_based":18831},{"literal_text_all_w_t_and_m_t":"        prioritisedBitRate                  ENUMERATED {kBps0, kBps8, kBps16, kBps32, kBps64, kBps128, kBps256, kBps512,","paragraph_zero_based":18832},{"literal_text_all_w_t_and_m_t":"                                            kBps1024, kBps2048, kBps4096, kBps8192, kBps16384, kBps32768, kBps65536, infinity},","paragraph_zero_based":18833},{"literal_text_all_w_t_and_m_t":"        bucketSizeDuration                  ENUMERATED {ms5, ms10, ms20, ms50, ms100, ms150, ms300, ms500, ms1000,","paragraph_zero_based":18834},{"literal_text_all_w_t_and_m_t":"                                                            spare7, spare6, spare5, spare4, spare3,spare2, spare1},","paragraph_zero_based":18835},{"literal_text_all_w_t_and_m_t":"        allowedServingCells                 SEQUENCE (SIZE (1..maxNrofServingCells-1)) OF ServCellIndex","paragraph_zero_based":18836},{"literal_text_all_w_t_and_m_t":"                                                                                                            OPTIONAL,   -- Cond PDCP-CADuplication","paragraph_zero_based":18837},{"literal_text_all_w_t_and_m_t":"        allowedSCS-List                     SEQUENCE (SIZE (1..maxSCSs)) OF SubcarrierSpacing                   OPTIONAL,   -- Need R","paragraph_zero_based":18838},{"literal_text_all_w_t_and_m_t":"        maxPUSCH-Duration                   ENUMERATED {ms0p02, ms0p04, ms0p0625, ms0p125, ms0p25, ms0p5, ms0p01-v1700, spare1}","paragraph_zero_based":18839}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["1e2f85e00b4e6c077ec4dbc6d7fe28e5a3e9529ba11c286c4e8911ced82bc2b8","0ea1a8847933