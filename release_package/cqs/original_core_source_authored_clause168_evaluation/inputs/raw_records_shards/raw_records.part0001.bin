g-v1630 ::=   SEQUENCE {","paragraph_zero_based":25459},{"literal_text_all_w_t_and_m_t":"    slotBased-v1630                    SetupRelease { SlotBased-v1630 }","paragraph_zero_based":25460},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25461},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25462},{"literal_text_all_w_t_and_m_t":"FDM-TDM-r16 ::=                SEQUENCE {","paragraph_zero_based":25463}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["228e8ca70b53b957c8be27d8aa438497ff87301a37667abd85ef0fb3207c2e1b","9e73258933f4741c069c191fcc4cc06dc564075eb4b9c2e6ad0385be5ebbeb49","e8b5221c5f90e844e27b49140ed0e18c31468019974c953142607ab80683b85b","1f2a9cf9e546d3cec0085f2a9237493b6986496f7757169581fff03067d9084e","5744cd351f2d35dde658cf641072fab3e962f8c408dda2a178e246f7a08bd92e","969b0d8fcbe1916c7874d1533d987befc5afd16f0e06e143c19e8cc96e206eeb","bcd230e3d66359918aaf6ac66d395ae9b03a947d9d108f56e4fa363d1d424e95","a66f2f644273c1cb6cbfc2bd2b7ef1a7ce36fd369d3a8873ce4b9bed23df6095","c5e688a7fd26e4f23edbd4c3afe84a9b4105816d5e8ff38873e400960a536472","68e393225638979dd934b3fb667195c45aa75fd6658872bdc11629f205c29b13","0a80814b93ba223069c5f1f8295c35d779043664568a4bf009b2caf062ad19b3","68005f5b6b7cd31fe653cf6a0191a463dbd7b1d6d5e43ac0d8aff8c6b56b3929","b9ccf623b148a1e07eb35adad43929a86be779041bb77c79aee839d4de7a153a","b0658fedd6acd999e388858b72c8e7532688d8165316e7ed8adbc71ddaea2e1a","724912672b8e1fd32f535c66115b4b623c511794eac40b8c061d07b35f9ba693","e1d00072db27f9e1ea5da9a19db0b26c25b735ac2dee1cc8f2b0737273c3af97","41f94776c7c50853c62ebfb77b872a6dec937d81835bbd7cf8c093bab4c00dc3","92f01b1b5c87da8a48cdffcd662032aa6ddb64409a7135b1730f1210e164e62c","ea1230974135a19097f5f6b14970cc2d0ad62e865a5bcedbcc56edb9d79c421e","ab0e17b4118584bb8988e83d9674d796dab1618a4a39117f4dc2d5ff42308f04","3e0bb8cb4940b7d2247b7a1dd57563dec6bfbcf7a1f5f231c715682bff504560","3c24563594234167b243bbccced4daa01aa516fb9dba782b7f18a9974c1aad74","75b5c23b58fcf6d617c6238e58c40695d2e73514f3c7f7a80248f03dfde691d1","3ef08f5d6b0eb6318372776b51299a72ffb91b853aa339b1e3e8928db0df7e83"],"paragraph_range_zero_based":[25440,25463],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p25440"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    repetitionScheme-r16           ENUMERATED {fdmSchemeA, fdmSchemeB,tdmSchemeA },","paragraph_zero_based":25464},{"literal_text_all_w_t_and_m_t":"    startingSymbolOffsetK-r16      INTEGER (0..7)                                    OPTIONAL  -- Need R","paragraph_zero_based":25465},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25466},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25467},{"literal_text_all_w_t_and_m_t":"SlotBased-r16 ::=              SEQUENCE {","paragraph_zero_based":25468},{"literal_text_all_w_t_and_m_t":"    tciMapping-r16                 ENUMERATED {cyclicMapping, sequentialMapping},","paragraph_zero_based":25469},{"literal_text_all_w_t_and_m_t":"    sequenceOffsetForRV-r16        INTEGER (1..3)","paragraph_zero_based":25470},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25471},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25472},{"literal_text_all_w_t_and_m_t":"SlotBased-v1630 ::=            SEQUENCE {","paragraph_zero_based":25473},{"literal_text_all_w_t_and_m_t":"    tciMapping-r16                 ENUMERATED {cyclicMapping, sequentialMapping},","paragraph_zero_based":25474},{"literal_text_all_w_t_and_m_t":"    sequenceOffsetForRV-r16        INTEGER (0)","paragraph_zero_based":25475},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25476},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25477},{"literal_text_all_w_t_and_m_t":"-- TAG-REPETITIONSCHEMECONFIG-STOP","paragraph_zero_based":25478},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":25479},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25480},{"literal_text_all_w_t_and_m_t":"RepetitionSchemeConfig field descriptions","paragraph_zero_based":25481},{"literal_text_all_w_t_and_m_t":"fdm-TDM","paragraph_zero_based":25482},{"literal_text_all_w_t_and_m_t":"Configures UE with a repetition scheme among fdmSchemeA, fdmSchemeB and tdmSchemeA as specified in clause 5.1 of TS 38.214 [19]. The network does not set this field to release. Upon reception of this field in RepetitionSchemeConfig-r16, the UE shall release slotBased if previously configured in the same instance of RepetitionSchemeConfig-r16.","paragraph_zero_based":25483},{"literal_text_all_w_t_and_m_t":"sequenceOffsetForRV","paragraph_zero_based":25484},{"literal_text_all_w_t_and_m_t":"For slot-based repetition scheme, selected RV sequence is applied to transmission occasions associated to the first TCI state. The RV sequence associated to the second TCI state is determined by a RV offset from that selected RV sequence.","paragraph_zero_based":25485},{"literal_text_all_w_t_and_m_t":"slotBased","paragraph_zero_based":25486},{"literal_text_all_w_t_and_m_t":"Configures UE with slot-based repetition scheme. Network always configures this field when the parameter repetitionNumber is present in IE PDSCH-TimeDomainResourceAllocationList. The network does not set this field to release. Upon reception of this field in RepetitionSchemeConfig-r16, the UE shall release fdm-TDM if previously configured in the same instance of RepetitionSchemeConfig-r16.","paragraph_zero_based":25487}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["1f32b62bbaa3abd65717eecb0abd3addcee15d8224232a264de99953911c0fee","eaf969677b4f514fc1a6e79527de6d25096e274d6a1fcefb274c0a4254c6a324","67628d082516050e70cf9000d7dcd853edbc936b8b377de0be8794a6045f8aef","443b11a0516c6aecd30f79d08bd793cd52f8b1a6158bdbda02b8aca1f8ffb510","f7b2de67f4f423b37da15e2