{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"E-UTRA/5GC","paragraph_zero_based":43320},{"literal_text_all_w_t_and_m_t":"May be included, but only radioBearerConfig is included in the RRCReconfiguration.","paragraph_zero_based":43321},{"literal_text_all_w_t_and_m_t":"May be included","paragraph_zero_based":43322},{"literal_text_all_w_t_and_m_t":"Not included","paragraph_zero_based":43323},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43324},{"literal_text_all_w_t_and_m_t":"–CG-Config","paragraph_zero_based":43325},{"literal_text_all_w_t_and_m_t":"This message is used to transfer the SCG radio configuration as generated by the SgNB or SeNB. It can also be used by a CU to request a DU to perform certain actions, e.g. to request the DU to perform a new lower layer configuration.","paragraph_zero_based":43326},{"literal_text_all_w_t_and_m_t":"Direction: Secondary gNB or eNB to master gNB or eNB, alternatively CU to DU.","paragraph_zero_based":43327},{"literal_text_all_w_t_and_m_t":"CG-Config message","paragraph_zero_based":43328},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":43329},{"literal_text_all_w_t_and_m_t":"-- TAG-CG-CONFIG-START","paragraph_zero_based":43330},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43331},{"literal_text_all_w_t_and_m_t":"CG-Config ::=                   SEQUENCE {","paragraph_zero_based":43332},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                  CHOICE {","paragraph_zero_based":43333},{"literal_text_all_w_t_and_m_t":"        c1                                  CHOICE{","paragraph_zero_based":43334},{"literal_text_all_w_t_and_m_t":"            cg-Config                           CG-Config-IEs,","paragraph_zero_based":43335},{"literal_text_all_w_t_and_m_t":"            spare3 NULL, spare2 NULL, spare1 NULL","paragraph_zero_based"