{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SPS-PUCCH-AN-List-r16 ::=      SEQUENCE (SIZE(1..4)) OF SPS-PUCCH-AN-r16","paragraph_zero_based":28320},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28321},{"literal_text_all_w_t_and_m_t":"-- TAG-SPS-PUCCH-AN-LIST-STOP","paragraph_zero_based":28322},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28323},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28324},{"literal_text_all_w_t_and_m_t":"–SRB-Identity","paragraph_zero_based":28325},{"literal_text_all_w_t_and_m_t":"The IE SRB-Identity is used to identify a Signalling Radio Bearer (SRB) used by a UE.","paragraph_zero_based":28326},{"literal_text_all_w_t_and_m_t":"SRB-Identity information element","paragraph_zero_based":28327},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28328},{"literal_text_all_w_t_and_m_t":"-- TAG-SRB-IDENTITY-START","paragraph_zero_based":28329},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28330},{"literal_text_all_w_t_and_m_t":"SRB-Identity ::=                    INTEGER (1..3)","paragraph_zero_based":28331},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28332},{"literal_text_all_w_t_and_m_t":"SRB-Identity-v1700 ::=              INTEGER (4)","paragraph_zero_based":28333},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28334},{"literal_text_all_w_t_and_m_t":"-- TAG-SRB-IDENTITY-STOP","paragraph_zero_based":28335},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28336},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28337},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28338},{"literal_text_all_w_t_and_m_t":"–SRS-CarrierSwitching","paragraph_zero_based":28339},{"literal_text_all_w_t_and_m_t":"The IE SRS-CarrierSwitching is used to configure for SRS carrier switching when PUSCH is not configured and independent SRS power control from that of PUSCH.","paragraph_zero_based":28340},{"literal_text_all_w_t_and_m_t":"SRS-CarrierSwitching information element","paragraph_zero_based":28341},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28342},{"literal_text_all_w_t_and_m_t":"-- TAG-SRS-CARRIERSWITCHING-START","paragraph_zero_based":28343}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["38cae80b26a6c1538bd9620da36e385f6f7dd50651daff1999cfd25fcfb43975","37b856cca3a6bebbaa7a047bee01a09029a7790c6ecf137c6a3a85f88126fa7e","91984de6fe3867a853a231b38ad9616cf4fd4f36433c1a7eb855cde4063f43c9","0bec8d924627f7dc57a48728e1ada7f2c01b869677e1fc0893d01f9f18ce9b48","e4a2ce940765534d95ee8ca7d49908e85ba0d14a8d1babc2034acb70ed4ea794","5a661a852cf6eb90a4d05cbe786bf409b434224de4d324c338cd71e871793b8c","e26b3f75cc6b5296aab7543b547ec35da0047f23f6edc1f6f1949c0e4b2445aa","bec77d49f6bfa13f1021830a46f8915bb10c7146f4877ff4a1a253d3d0731166","abb83cee3192a3ecae097a37a08c349ab3274ec126c9415810e417b1c77d4ddc","02aa5871f2d52e0d6518b45d6c854b95ca51584c6aa108e559c91babf09d5eaa","faaaaba7f1747e61cd1efe13c39d87e3e4525705795c8afff5b91a2918ff3687","1ed309f535fe2101880cb186812797f4f772f71c81cce491304147f4e74761f6","5005c8df8fa2aed865d781ed1020f89b0f86750ea9502884848d6fc1a0db9a1b","26fb7d00ee7c20a486fc4b81531f73f360ad99e9876564d508dc65c9c74c3787","d554366c5bc8b47f59fc72a5327fc410b639485bb123b4663c78d5302492ff76","f975265651b90a3c45cdfe513eb3e374907f11bd7c054d3ddabcb78278b8b888","512faccca91475a293d5b6757a675bceb20a10de081dcc42e779546e9dc39c3b","9e07ae3da7e3e726957ba94bf9c16bbb4faf9021fe756c7464cbdf866c810a71","62d0485929fb979a5b498ccead8d3e81a64