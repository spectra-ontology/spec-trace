agraphs"},"source_cell_coordinates":{"document_XML_sha256":"9006a5e4d405d2bab4da8adbe85c8c54348a814c5ca98f37bc600850b83d6866","original_member_sha256":"d5d414423b1048f375344cb48c2ef975c9c8e9f4329d79a9fea35e05ea08452c","paragraph_ElementTree_utf8_XML_sha256":["f90bfdd9a8cb5492c1002b3087ef050f2dc96ecdb946735c8440fae89bc0cca2","5c5193353a0e220586faf4089b1117f5050f71eda93498644103840397df534d","a5facce0009a2f4d4efc0fd44d0b8f2d835a1f14b79c6574be93ee61babb1e00","d0127e2c96ef8bbf47cdb918132c8939f92db22842cf1b314d285a8bc84e696c","2b5f23dd78d46e1c3535d3f4d25761ba9fbe3eb86a081a93e6451219015f2e87","2ff1f7ecdd043b128a2f189ac0df632264f95504adbcd28d057ee1bf618ea059","b696d1ca8911328327996083da173b8dbf58f096bb33c155c820768723353dfc","dc622bb17db78545d0fd52780051db5ccc41f31184f031b0be1590cedba61bbb","0390706e978213e08b35272dc769990d6ddddc489e2393cc15f16ca5325ea146","6fd18055b47df6cd01971f5bc172f5e2639ae52072921f41b49873391c6de8f8","4d2d51c198d53286a5023e9b6b3136853b816d0ed1ab4dadcddfabf1ecfcc496","6324d2f18dbaf37becd346d641b6483b2965dee33a95901ae6f50bc546d69228","da09617954da8c7183ef73384cd8124bc0900e3e9e1a14efc4980909ea254749","7132d77fbd8694c695479a025cd053447977666dd923f3ac6d2a673ddf171422","fac960e97617be876923fcd8ab851dd90a84ac0bccef789a98bc1f0ad824ae48","b6c0af846935ee4e42eada3943b86ab68e679e04d96da3ce306e3d9ad7a823c1","cd5de30b36830de834fa7ebb006b56b82b4fefe6382cd0495b848ed067aa391a","2ab3c06072284848b7efb37ceacda914dac62f658c9efe043d53781bb0920c41","3ee19476e920c47043c556c44a16a16bfa956c03b3159a8b1ceec984248974d1","7d26baf3c9dbd59a562b696ffecbef1bd23aeaecdcaff7bbb49a4ef4c829a12b","1a6cf48c9b8160e3b2ef72c5e3e5044f27bd1f5e4b9ecea45181ad8d38e338c6","891d6c77c0e67af4b5fad76e45a7a62686060e00ac28cbc9e46cc99f9a1ea525","71d8ce5686334e69931de84f64b9013aa875d11a859a4de613ff14ffe9b91955","06bf45c3e8c24769ae9132a67608aaf725d4f18591dca730116204cd63ddc9f4"],"paragraph_range_zero_based":[24,47],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state