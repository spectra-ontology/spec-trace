{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the frequency domain position for sidelink CSI-RS.","paragraph_zero_based":40512},{"literal_text_all_w_t_and_m_t":"sl-CSI-RS-FirstSymbol","paragraph_zero_based":40513},{"literal_text_all_w_t_and_m_t":"Indicates the position of first symbol of sidelink CSI-RS.","paragraph_zero_based":40514},{"literal_text_all_w_t_and_m_t":"sl-DRX-ConfigUC-PC5","paragraph_zero_based":40515},{"literal_text_all_w_t_and_m_t":"Indicates the NR sidelink DRX configuration for unicast communication, as specified in TS 38.321 [3]","paragraph_zero_based":40516},{"literal_text_all_w_t_and_m_t":"sl-LatencyBoundCSI-Report","paragraph_zero_based":40517},{"literal_text_all_w_t_and_m_t":"Indicates the latency bound of SL CSI report from the associated SL CSI triggering in terms of number of slots.","paragraph_zero_based":40518},{"literal_text_all_w_t_and_m_t":"sl-LatencyBoundIUC-Report","paragraph_zero_based":40519},{"literal_text_all_w_t_and_m_t":"Indicates the latency bound of SL Inter-UE coordination report from the associated SL Inter-UE coordination explicit request triggering in terms of number of slots.","paragraph_zero_based":40520},{"literal_text_all_w_t_and_m_t":"sl-LogicalChannelIdentity","paragraph_zero_based":40521},{"literal_text_all_w_t_and_m_t":"Indicates the identity of the sidelink logical channel.","paragraph_zero_based":40522},{"literal_text_all_w_t_and_m_t":"sl-MappedQoS-FlowsToAddList","paragraph_zero_based":40523},{"literal_text_all_w_t_and_m_t":"Indicate the QoS flows to be mapped to the configured sidelink DRB. Each entry is indicated by the SL-PQFI, which is used between UEs, as defined in TS 23.287 [55].","paragraph_zero_based":40524},{"literal_text_all_w_t_and_m_t":"sl-MappedQoS-FlowsToReleaseList","paragraph_zero_based":40525},{"literal_text_all_w_t_and_m_t":"Indicate the QoS flows to be released from the configured sidelink DRB. Each entry is indicated by the SL-PQFI, which is used between UEs, as defined in TS 23.287 [55].","paragraph_zero_based":40526},{"literal_text_all_w_t_and_m_t":"sl-MeasConfig","paragraph_zero_based":40527},{"literal_text_all_w_t_and_m_t":"Indicates the sidelink measurement configuration for the unicast destination.","paragraph_zero_based":40528},{"literal_text_all_w_t_and_m_t":"sl-OutOfOrderDelivery","paragraph_zero_based":40529},{"literal_text_all_w_t_and_m_t":"Indicates whether or not outOfOrderDelivery specified in TS 38.323 [5] is configured. This field should be either always present or always absent, after the sidelink radio bearer is established.","paragraph_zero_based":40530},{"literal_text_all_w_t_and_m_t":"sl-PDCP-SN-Size","paragraph_zero_based":40531},{"literal_text_all_w_t_and_m_t":"Indicates the PDCP SN size of the configured sidelink DRB.","paragraph_zero_based":40532},{"literal_text_all_w_t_and_m_t":"sl-Resetconfig","paragraph_zero_based":40533},{"literal_text_all_w_t_and_m_t":"Indicates that the full configuration should be applicable for the RRCReconfigurationSidelink message.","paragraph_zero_based":40534},{"literal_text_all_w_t_and_m_t":"sl-SDAP-Header","paragraph_zero_based":40535}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["63b288b3544d87d0b139033824f756ebf90ee6f8e224f02682ad960ab4639ef7","9b55d7dd6739f1618ebc82078ddb79da90687abcde2b85571b89c6a90a4b94d1","af556d9a79abdca1bbcedc8bd437179298ba9c09cf8bdbebc551a11d74e0526d","d686a6de372e3d31abbec6fb8767d8b72cb4711b7829c0b64a7848b5d7f3edc7","dfb385b6ccd0a2d1ff6b3b66a9e66b31a74251974d150faad5c1e933e9ca3e6a","93998be70a0faafed1e