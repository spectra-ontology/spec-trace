{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34752},{"literal_text_all_w_t_and_m_t":"PHY-ParametersMRDC field descriptions","paragraph_zero_based":34753},{"literal_text_all_w_t_and_m_t":"naics-Capability-List","paragraph_zero_based":34754},{"literal_text_all_w_t_and_m_t":"Indicates that UE in MR-DC supports NAICS as defined in TS 36.331 [10].","paragraph_zero_based":34755},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34756},{"literal_text_all_w_t_and_m_t":"–Phy-ParametersSharedSpectrumChAccess","paragraph_zero_based":34757},{"literal_text_all_w_t_and_m_t":"The IE Phy-ParametersSharedSpectrumChAccess is used to convey the physical layer capabilities specific for shared spectrum channel access.","paragraph_zero_based":34758},{"literal_text_all_w_t_and_m_t":"Phy-ParametersSharedSpectrumChAccess information element","paragraph_zero_based":34759},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":34760},{"literal_text_all_w_t_and_m_t":"-- TAG-PHY-PARAMETERSSHAREDSPECTRUMCHACCESS-START","paragraph_zero_based":34761},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34762},{"literal_text_all_w_t_and_m_t":"Phy-ParametersSharedSpectrumChAccess-r16 ::=    SEQUENCE {","paragraph_zero_based":34763},{"literal_text_all_w_t_and_m_t":"    -- 10-32 (1-2): SS block based SINR measurement (SS-SINR) for unlicensed spectrum","paragraph_zero_based":34764},{"literal_text_all_w_t_and_m_t":"    ss-SINR-Meas-r16                                ENUMERATED {supported}                      OPTIONAL,","paragraph_zero_based":34765},{"literal_text_all_w_t_and_m_t":"    -- 10-33 (2-32a): Semi-persistent CSI report on PUCCH for unlicensed spectrum","paragraph_zero_based":34766},{"literal_text_all_w_t_and_m_t":"    sp-CSI-ReportPUCCH-r16                          ENUMERATED {supported}                      OPTIONAL,","paragraph_zero_based":34767},{"literal_text_all_w_t_and_m_t":"    -- 10-33a (2-32b): Semi-persistent CSI report on PUSCH for unlicensed spectrum","paragraph_zero_based":34768},{"literal_text_all_w_t_and_m_t":"    sp-CSI-ReportPUSCH-r16                          ENUMERATED {supported}                      OPTIONAL,","paragraph_zero_based":34769},{"literal_text_all_w_t_and_m_t":"    -- 10-34 (3-6): Dynamic SFI monitoring for unlicensed spectrum","paragraph_zero_based":34770},{"literal_text_all_w_t_and_m_t":"    dynamicSFI-r16                                  ENUMERATED {supported}                      OPTIONAL,","paragraph_zero_based":34771},{"literal_text_all_w_t_and_m_t":"    -- 10-35c (4-19c): SR/HARQ-ACK/CSI multiplexing once per slot using a PUCCH (or HARQ-ACK/CSI piggybacked on a PUSCH) when SR/HARQ-","paragraph_zero_based":34772},{"literal_text_all_w_t_and_m_t":"    -- ACK/CSI are supposed to be sent with different starting symbols in a slot for unlicensed spectrum","paragraph_zero_based":34773},{"literal_text_all_w_t_and_m_t":"    -- 10-35 (4-19): SR/HARQ-ACK/CSI multiplexing once per slot using a PUCCH (or HARQ-ACK/CSI piggybacked on a PUSCH) when SR/HARQ-","paragraph_zero_based":34774},{"literal_text_all_w_t_and_m_t":"    -- ACK/CSI are supposed to be sent with the same starting symbol on the PUCCH resources in a slot for unlicensed spectrum","paragraph_zero_based":34775}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["19884ad7b27c886ebdea4751ec8b3fece2eb6d17f6b26e6fd19bb9c544f90847","aeac74fd8b8a3ae6eef23e3934f90061b7a1db152e4e6eb13883ba388785fa89","9bb2b28484087baa97a59b55a524449a8ab7be70d7d102ff2640165016a6d849","3d4155d202cc2719