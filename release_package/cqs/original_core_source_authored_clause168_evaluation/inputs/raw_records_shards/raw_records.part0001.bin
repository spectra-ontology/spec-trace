parameter. ","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"Impact Analysis","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"Impacted 5G architecture options: NR SA ","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"Impacted functionality:","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"RA-SDT for MO-SDT and MT-SDT (performed over RACH).","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"f3779c4942e4132bf14e54630a3f2f0b8893eece19e5dc42691f294b0354bcd0","original_member_sha256":"ace666b0db14934649204ad805e520e6a36388be5b1f344a61b8b24664d23898","paragraph_ElementTree_utf8_XML_sha256":["e4ea5591218aa96d0cd407936b651eb165fb4c75e229dab64ec9de6be991cb96","2d00e3b1a82065155328ddd802c3d4a8ebff11f4a0d6da9ecf9b1e34dc8ebfc8","eec4e426f2e337da239190010d5aed80b7d827d4b5831fbf179aad6efcc5e13b","761fa4d36b282591b5f5bb5ee554c6086f6eb9d5925f257d405f142f9e3a17e1","9ee3a8ef1b4d8b5d23ae68c79878f83d9a7ffdf02ec93cff53f7b1de6029f4d6","649b970322dd1089b5cf632a2a91a62d1b22b6ee828c08dad7a6190e0193921a","b08252b53f111fda758564f01d6aeb287a86ceee9730eba0ca5fcf7c7dadb00e","5397ebe3cc2afa3393b897343a62f60e5b485315d8236802a715ec930f5cc336","e03f75fce7c5cd64c9b8620af07bd45750b787d80cf501db97a5d9d8c165d6c1","34212fc6f04370a4e535ce9cc41d8546dd1f377420e476f0306c144fd63998ef","16c8d70f7d429c511b56c375317337c5d5c75b5a185ec91bf088b77069963fb7","acd6206245de4b9556a4853ff1b8b41875944834aa76df6c7d72af763f365262","3c4c80e1e11044a4d07c2d065ab1badcf74a3b84af6435503a27154aade28f9b","153eb375246b8c069eb4f6dc521063dfb941f05dcbeb31aa6e90bebc9cb983a6","8b24573e0133d1c5ee95e1377545628b16380b4d3d980bde5296376e8173041e","7423559940944ed0cc1fe176b76253cf9035dcdbfc0fac2f3e385feb311a2329","288cc60197c635a28716a1c3a91330851