SEQUENCE {","paragraph_zero_based":27735},{"literal_text_all_w_t_and_m_t":"   firstOutsideActiveTimeBWP-Id-r16        BWP-Id                                                           OPTIONAL,   -- Need M","paragraph_zero_based":27736},{"literal_text_all_w_t_and_m_t":"   dormancyGroupOutsideActiveTime-r16      DormancyGroupID-r16                                              OPTIONAL    -- Need R","paragraph_zero_based":27737},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27738},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27739},{"literal_text_all_w_t_and_m_t":"UplinkTxSwitching-r16 ::=              SEQUENCE {","paragraph_zero_based":27740},{"literal_text_all_w_t_and_m_t":"    uplinkTxSwitchingPeriodLocation-r16    BOOLEAN,","paragraph_zero_based":27741},{"literal_text_all_w_t_and_m_t":"    uplinkTxSwitchingCarrier-r16           ENUMERATED {carrier1, carrier2}","paragraph_zero_based":27742},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27743}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["2e456711bdfd27fbcb536229ca8b962ac70bff0ae3b299bfeacdbf005b9c4045","b40afd9ba1fe55a648b23d8b5f263fb886b5b23c6583fe4dd7197cc3dba1c734","9258f3830b9595ffe737ef68415b91ba08cf179eb6f075096bdd236e68a9d55f","26337ca51a81df3eb42aa7ded519572c204a5c0f0d3b4f32595fdcb72a24a952","8a4f28243ce340fc38755ff2a12834a100b1d7bdb59bf730278f83ddd5d8060d","40e07e962030e258c9c5e258029d16ea63ee44345cc2adbb0f698e429373bdb2","ad335e201786bf5805c3838e60fbd97ed9bf96d8cd8be37884756dd35441cf0a","db093fd2b8ee8f37515bf807f1f7f27d3da9965a86d38dac7a0ab871e7629225","805f51aa5c93142697b2bd4152269020b823ef550510c7550113822cf969fe4a","705519a3a89264a9f58d5b782612d81fc2cb15cf2e762ff