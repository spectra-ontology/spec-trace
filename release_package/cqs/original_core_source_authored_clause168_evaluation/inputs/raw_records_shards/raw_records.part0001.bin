               BWP-Id,","paragraph_zero_based":17247},{"literal_text_all_w_t_and_m_t":"    resourceType                ENUMERATED { aperiodic, semiPersistent, periodic },","paragraph_zero_based":17248},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":17249},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":17250},{"literal_text_all_w_t_and_m_t":"    csi-SSB-ResourceSetListExt-r17      CSI-SSB-ResourceSetId                                                  OPTIONAL  -- Need R","paragraph_zero_based":17251},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":17252},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":17253},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17254},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-RESOURCECONFIG-STOP","paragraph_zero_based":17255}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["10420d3d418ac1b24a5b925ce4e2892da0c0514b8b5b242a0010c486d17eaf0f","67893f4d1f6a7fedf04348778f7500bae26e07c757d85c588081acbcc02b104c","b5930577b430a5004e9f71f63eadc7c4c2760a09837ae088e26c553f1c47e31d","29fe3c987be533fc307ba6f8b3916658fdee3ea6a470a78d59251dec92821b47","13b74858bcd78756a00cfa966373e70ffabda3d89b17be33154318d25a622427","9542438fed52b80a4e918a5867a4e6fb657003d674a26f8ce4d73943c3a717fc","ca8a937164ac4c46a4326b01a62c2a90a53130ee10d2d2f010954f8746f638c2","ace5e135fc1a8f079a100e6d300a250838c994f9cefafa445ff9499a8038166e","7a2c39cdffbff41d31718bfa6abaccb8a39191366b000fa0eeb70c732aaa59df","259ad55c5c7a20d77b13d054355b7f0649d61624285e98c19d472652cb23b221","e39f60bc8afc696eda45bf77c151e801aa6a4cbef99487bfdeb0db8de73e45f3","5677eb47d4b494c4b7057899635704fdbc42542416c53f91be9676e5d921e448","1998f87e4bad0798387acfe27271d2a09d4f2f7567f996ca074e96d72d5274b1","533f1e8a28f85fabc1a874900fa79655d7498f6bcc0dccfea13d8a21a4f94e6f","bb4dd08393a20ba2369043226f5cd92dbc432599cf2659fc95673017ed9d281f","6fd3d59616452f85c7b07d2b16dde4c674ec5ef659eb206926acd4c633676420","32c8a595300949d127858942c4100a15ec39c4b65b7af64d6f43153f1fac980f","c2a8545307c58720471168442b200338f280f6293b94749e993688c97b51c421","d8c8abeaba578441ef56ce3fde8b3ec4a2a2846855749d1ef481756987a366af","e39833203bf7d1494f125f7030b572420c0d6ffb1e3c092370be3b78cca1f454","fb29ecb9bc0cca57bfaf9ca996c30453e7fd45b4453a963469514a12c4449066","ebd44385208701af6105adf45a1240c421845df9c16113ccf9e930680e42cea0","c0b94f3e9861cd12ae7ec180ac67c840a5cbcb02589c0599ded5fbbcca5365e4","beb81bd327bfe9a1f6993f8bbf51707ed37a0213e0ceef98985406881fd80041"],"paragraph_range_zero_based":[17232,17255],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p17232"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17256},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17257},{"literal_text_all_w_t_and_m_t":"CSI-ResourceConfig field descriptions","paragraph_zero_based":17258},{"literal_text_all_w_t_and_m_t":"bwp-Id","paragraph_zero_based":17259},{"literal_text_all_w_t_and_m_t":"The DL BWP which the CSI-RS associated with this CSI-ResourceConfig are located in (see TS 38.214 [19], clause 5.2.1.2.","paragraph_zero_based":17260},{"literal_text_all_w_t_and_m_t":"csi-IM-ResourceSetList","paragraph_zero_based":17261},{"literal_text_all_w_t_and_m_t":"List of references to CSI-IM resources used for CSI measurement and reporting in a CSI-RS resource set. Contains up to maxNrofCSI-IM-ResourceSetsPerConfig resource sets if resourceType is 'aperiodic' and 1 otherwise (see TS 38.214 [19], clause 5.2.1.2).","paragraph_zero_based":17262},{"literal_text_all_w_t_and_m_t":"csi-ResourceConfigId","paragraph_zero_based":17263},{"literal_text_all_w_t_and_m_t":"Used in CSI-ReportConfig to refer to an instance of CSI-ResourceConfig.","paragraph_zero_based":17264},{"literal_text_all_w_t_and_m_t":"csi-SSB-ResourceSetList, csi-SSB-ResourceSetListExt","paragraph_zero_based":17265},{"literal_text_all_w_t_and_m_t":"List of references to SSB resources used for CSI measurement and reporting in a CSI-RS resource set (see TS 38.214 [19], clause 5.2.1.2). The csi-SSB-ResourceSetListExt provides additional references and can only be configured if csi-SSB-ResourceSetList is configured and groupBasedBeamReporting-v1710 is configured in the CSI-ReportConfig that indicates this CSI-ResourceConfig as resourcesForChannelMeasurement. If groupBasedBeamReporting-v1710 is configured in the IE CSI-ReportConfig that indicates this CSI-ResourceConfig as resourceForChannelMeasurement, the network configures 2 resource sets, which may be two CSI SSB resource sets (see TS 38.214 [19], clause 5.2.1.2 and 5.2.1.4.2). In this case, in TS 38.212 [17] Table 6.3.1.1.2-8B, the first resource set is indicated by a resource set indicator set to 0 and the second resource set by a resource set indicator set to 1.","paragraph_zero_based":17266},{"literal_text_all_w_t_and_m_t":"nzp-CSI-RS-ResourceSetList","paragraph_zero_based":17267},{"literal_text_all_w_t_and_m_t":"List of references to NZP CSI-RS resources used for beam measurement and reporting in a CSI-RS resource set.","paragraph_zero_based":17268},{"literal_text_all_w_t_and_m_t":"If resourceType is set to 'aperiodic', the network configures up to maxNrofNZP-CSI-RS-ResourceSetsPerConfig resource sets. If resourceType is is set to 'periodic' or 'semiPersistent' and groupBasedBeamReporting-v1710 is not configured in IE CSI-ReportConfig, the network configures 1 resource set. If resourceType is set to 'periodic' or 'semiPersistent' and groupBasedBeamReporting-v1710 is configured, the network configures 2 resource sets, which may be two NZP CSI-RS resource sets (see TS 38.214 [19], clause 5.2.1.2 and 5.2.1.4.2). In this case, in TS 38.212 [17] Table 6.3.1.1.2-8B, the first resource set is indicated by a resource set indicator set to 0 and the second resource set by a resource set indicator set to 1.","paragraph_zero_based":17269},{"literal_text_all_w_t_and_m_t":"resourceType","paragraph_zero_based":17270},{"literal_text_all_w_t_and_m_t":"Time domain behavior of resource configuration (see TS 38.214 [19], clause 5.2.1.2). It does not apply to resources provided in the csi-SSB-ResourceSetList.","paragraph_zero_based":17271},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17272},{"literal_text_all_w_t_and_m_t":"–CSI-ResourceConfigId","paragraph_zero_based":17273},{"literal_text_all_w_t_and_m_t":"The IE CSI-ResourceConfigId is used to identify a CSI-ResourceConfig.","paragraph_zero_based":17274},{"literal_text_all_w_t_and_m_t":"CSI-ResourceConfigId information element","paragraph_zero_based":17275},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17276},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-RESOURCECONFIGID-START","paragraph_zero_based":17277},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17278},{"literal_text_all_w_t_and_m_t":"CSI-ResourceConfigId ::=            INTEGER (0..maxNrofCSI-ResourceConfigurations-1)","paragraph_zero_based":17279}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["ea0e6fbfcaf165b31e0b888aec518bab380468bf1a477082ed4c9043954da381","00cd0dc0ff0321a1b55634f5f2816da573ed79379eab39b5a6649277d393a6c3","c1cd74eb8e655fb3a05200b4a0d07e71633435255807416b206ec1e71ca3ae8b","511a1fd0086070f491aab8ceec36bf621842242a0e822e305ae1b18a82ab3867","3123fc54af0390b54c24b0e6efeb0ef02d994e4719374ca462acfc20aebf9f54","e1478d63808469e489b40245e385e7e36dbce9df962e50ac4e24f9e7e1f5ff2a","c8293638125086350bee3cb3aecfa909e665079017d8b9b597b96dc43ddd73b5","424cc27575129756c79e2554eb98e563fc096e09621762aecdab3611c7896b48","27be1ecac0e95b7dbb7203b4078acc23b00dcc778ffda7e6e4044b29a04f7242","f9ca29daf7c9bc191ede282e09323376bec584c89998451087022f330922f397","a859e4103bdd7b0a5c83a4697941bf0a1894cbac9d49b382dcc78b3d02a76125","f8d4afd87f7766e0a6090d6e9a56588c054bc52d2c79a023d1cedecbcd162eeb","fdc59378bc5e98acd1065ec7390c6d645f7659c298331f87ad3ca34f2ca00157","d324ad7039b892cb735523f8eb5ecac83b080f29f330aead05da24af54175a4f","51bf1b309a467b52fff993ee8061e501c21fa35ce00f27c1c0ea8c48c2a25fb4","df8253863f684b2ebdc86f129646e4e1ccdaeda5276934c17fe84076f8f2fa13","aae4487922985f756830095f5a5310efbb454ce6ce63f2b0ea143a358b0b9f82","445209c3316b67b