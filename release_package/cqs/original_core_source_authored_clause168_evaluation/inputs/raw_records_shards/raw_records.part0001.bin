ll_w_t_and_m_t":"–ConnEstFailureControl","paragraph_zero_based":16459},{"literal_text_all_w_t_and_m_t":"The IE ConnEstFailureControl is used to configure parameters for connection establishment failure control.","paragraph_zero_based":16460},{"literal_text_all_w_t_and_m_t":"ConnEstFailureControl information element","paragraph_zero_based":16461},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":16462},{"literal_text_all_w_t_and_m_t":"-- TAG-CONNESTFAILURECONTROL-START","paragraph_zero_based":16463}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["407a79c3719c8301caadae6517f81e052d1dcae7aaad5e7e8bdeeef8e2a2433a","d9d9ba52a124fe5cee7f716be22f15c5af6faa6ae9177d4b5f30a329e408a623","5cbb22b434364b81879cd0b6913a97864479ab46ff3a0007e5f5f7934cf04bea","e146d100fe4e57baf5c9b5b312865f2e1909bfecbeece7cf2e6c8f0859559a08","9ceb935459df7339e996b004debb0d7edfdf9f07976543e3ca5f4a222ab76b83","a227b3aa9cb525e07cf022c1afa0dd1be2ea560cfdd27add05e812d2e158acdd","f30978801f804fdddba23c9ba599a56e64b6acb4645f1baf838eea833ae4acf6","ba00f19fc7462a3afd39f4160f0552c33ecfe28e13011b366b46c736df11a758","999631b93a7df44dd18c30c449f6e252b2a001f26a99260300a9e99d90b72912","902e2af3917d21437569e655b5d63dde068c11670bb35296ff1284c3d9ed6c19","c841805ddd64a96d1e3bb080e8987b6f36bdb1ec178959204b14f2356ee694b2","7443afb8537531e152e315f06666e9e22558edf1eb27e02e58abe003b7964230","9f3ef6a58b51abe6e8c50c715139289db16dc553fc42da6cbe6b2621af792fe6","9d21599f7963e7f387c5f0a206a5bbe42e82423ee35d18689ec30713d007eca8","e2c2c50a7107b24973ba40111b23f0d7ac4fbc5ae1f343523d14de690ec61cad","f4f14c4caffe14d46f339dd7f220c25c4a6615677d1b4854ce6d6206ca8e5456","b811d81854d47200c1ae7acacc12b89a374911cffa8a0e94be32c9da8d4aa903","61af5a9be07c6d7cbf3a75238b81f0db19c54dd47e5de907a17d44c01129ed3d","5b6e181791a1a88f52d70c06d989dc208a63e271597d927716fd7488380c2478","a8ef83f2e0ca7237de94a503551fcd949a404abaebfde5d9c924b2ad8dbb80ef","8ea799066c29fb12e3b32985ce8cb6ba3a5657abdfca7e0c62cd4a57d9842491","c1c4582a387dd34f6a29a7106e6dc17b2853d55ed050cc791235e47b6fc71977","c4770c47611edb4409d1906c6c3678b675fb62855ec746259f5861e3f16cc55e","d1e4153d028685582fe711aeb6cb3f079d85af7fb37e96c0b0dca8ee5c2c2fbf"],"paragraph_range_zero_based":[16440,16463],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p16440"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16464},{"literal_text_all_w_t_and_m_t":"ConnEstFailureControl ::=   SEQUENCE {","paragraph_zero_based":16465},{"literal_text_all_w_t_and_m_t":"    connEstFailCount                    ENUMERATED {n1, n2, n3, n4},","paragraph_zero_based":16466},{"literal_text_all_w_t_and_m_t":"    connEstFailOffsetValidity           ENUMERATED {s30, s60, s120, s240, s300, s420, s600, s900},","paragraph_zero_based":16467},{"literal_text_all_w_t_and_m_t":"    connEstFailOffset                   INTEGER (0..15)                                                         OPTIONAL    -- Need S","paragraph_zero_based":16468},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":16469},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16470},{"literal_text_all_w_t_and_m_t":"-- TAG-CONNESTFAILURECONTROL-STOP","paragraph_zero_based":16471},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":16472},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16473},{"literal_text_all_w_t_and_m_t":"ConnEstFailureControl field descriptions","paragraph_zero_based":16474},{"literal_text_all_w_t_and_m_t":"connEstFailCount","paragraph_zero_based":16475},{"literal_text_all_w_t_and_m_t":"Number of times that the UE detects T300 expiry on the same cell before applying connEstFailOffset.","paragraph_zero_based":16476},{"literal_text_all_w_t_and_m_t":"connEstFailOffset","paragraph_zero_based":16477},{"literal_text_all_w_t_and_m_t":"Parameter \"Qoffsettemp\" in TS 38.304 [20]. If the field is absent, the value of infinity shall be used for \"Qoffsettemp\".","paragraph_zero_based":16478},{"literal_text_all_w_t_and_m_t":"connEstFailOffsetValidity","paragraph_zero_based":16479},{"literal_text_all_w_t_and_m_t":"Amount of time that the UE applies connEstFailOffset before removing the offset from evaluation of the cell. Value s30 corresponds to 30 seconds, value s60 corresponds to 60 seconds, and so on.","paragraph_zero_based":16480},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16481},{"literal_text_all_w_t_and_m_t":"–ControlResourceSet","paragraph_zero_based":16482},{"literal_text_all_w_t_and_m_t":"The IE ControlResourceSet is used to configure a time/frequency control resource set (CORESET) in which to search for downlink control information (see TS 38.213 [13], clause 10.1). For the UE not supporting multipleCORESET in FR1, in order to receive MBS multicast in CFR within the UE's active BWP, if a CORESET is not configured within the PDCCH-ConfigMulticast, the CORESET other than CORESET#0 configured within the UE's active BWP for scheduling unicast can be used for scheduling MBS multicast, and the CORESET is expected to be included completely within the CFR and the parameters configured in the CORESET are expected to be supported by the UE for MBS multicast.","paragraph_zero_based":16483},{"literal_text_all_w_t_and_m_t":"ControlResourceSet information element","paragraph_zero_based":16484},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":16485},{"literal_text_all_w_t_and_m_t":"-- TAG-CONTROLRESOURCESET-START","paragraph_zero_based":16486},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16487}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["1ddc2427c36f04cffda961c0dcc66426efeb6c219f65837cbc8ea10935e8b32a","cd5d1a3cb5f396abc92efc4556574fddc82eba5aace043b2eb996808f2a78e9b","e9d4377424e8d3142951886a9aaf6f8a3ce7549f65bae7f35bd3dad8229953d0","eaea6640c09f1dc24cf4f926a2bd59aaa5cfe6fb7ac0