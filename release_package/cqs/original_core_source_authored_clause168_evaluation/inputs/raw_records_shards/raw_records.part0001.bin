ofDUCells-r16)) OF AvailabilityCombinationsPerCellIndex-r16     OPTIONAL, -- Need N","paragraph_zero_based":14295},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":14296},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14297},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14298},{"literal_text_all_w_t_and_m_t":"AI-RNTI-r16 ::=                      RNTI-Value","paragraph_zero_based":14299},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14300},{"literal_text_all_w_t_and_m_t":"-- TAG-AVAILABILITYINDICATOR-STOP","paragraph_zero_based":14301},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":14302},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14303}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["63fff48ede778e70c80c1c574b5639b64d869bdd1f7468adbfbbca04bb13fac9","44bdd55e26f19e6aba492f844e0fa69f59de596c094e9775bc6c2fd5d5d5bfd9","e2e1b3b25dac5df60f3fdc1a5a3fa9682265b14c6b84f69a16a12a53cf4f7fd5","bbf85f432473d18711e4ff7ed350156d8acd53128933c1f53e23d566e7b09705","164a3c456d52088ea69452f98880ccbdf6d65b4da3604d9f10db9dd752e8ea31","036e19e3611fdc918fd0516f9e704861850ec59ca77222bafd4b5c47810d59fc","283c63e246fc1b7501735d2d7d2eec2752043d123f47b565c759bfe8ef70ef98","bbc76d38b49aabe1a75c03a33fea71f38593be419d9b01a370e6001d78711faa","a8006a931e9a5f93de1b0f7165d5ae9c9d8a8cefc55531ae2ec90d6d0dfcb7ed","d4e09342ae82f8b840e1330241701dc2bb7d0807e692176bc0f6895b5dd8f021","95bae6b14571718a0f2c78782cd936658fb7b7b98f6ec5bb55684a65227e6a56","af7735dd586818c6d75087dfd14f8f4a70d25b56b33d0d2c895b70e9c4199400","37916237da757697ee8e2ed3962bb126ced17ee593ac8815c6621f7706f888ef","1d8ef1f2bd8bbc96944201ec65ee3522db9fdbd25