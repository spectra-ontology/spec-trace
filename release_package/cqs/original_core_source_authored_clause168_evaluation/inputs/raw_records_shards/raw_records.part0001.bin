t_and_m_t":"}","paragraph_zero_based":30064},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30065},{"literal_text_all_w_t_and_m_t":"-- TAG-UPLINKTXDIRECTCURRENTTWOCARRIERLIST-STOP","paragraph_zero_based":30066},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":30067},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30068},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentTwoCarrierInfo field descriptions","paragraph_zero_based":30069},{"literal_text_all_w_t_and_m_t":"referenceCarrierIndex","paragraph_zero_based":30070},{"literal_text_all_w_t_and_m_t":"The serving cell ID of the carrier which is to be used as the reference for interpreting the Tx Direction Current location as reported using txDirectCurrentLocation-r16. The numerology of the uplink BWP ID reported with bwp-Id-r16 for this serving cell is the numerology used for interpreting the reported subcarrier location. ","paragraph_zero_based":30071}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["00436a4be9d76d5bd9c377a72ee7866fe1597abd9b255f5f531d75ce55f3aa14","a1f99cc68d3a1d71e354aba7441f918b2e4747ed62746538cb6d8b44889e99db","752534e25ed9e24c367b0319038cd8d773ed9f35af56a32420d2e9673988c483","cef8b7f4d0c8904acf8e4eb8f33cf59732094ca6a33d2f750a561d888c30e21f","dd17397b2a4a0f7831ad4ccf6baf0b5419b9e777db02beabb57fe88e32bae614","8a959fcaa7c906fd3ad472ccf17fe447692ab5ff25c32404c4b04ee7bb0b5b97","2950103d9ba622a977b4842035d410f061bbff8e631287951631850c66f0186e","0be2f298a5305ea11547fe8452b746d8b97523aef40217428fcefc174c127068","f7affd28862a2923dc62cfde8aef5dcd2ea46822ef4b04e9766b5e2639bf5b77","5e19b044f205cab014d178d5f5806344215f0c536b9a71323e1b3467bb900347","987ea71ad2f3f7a1c6de17e7474d492f4d5eea2e582069a8a721dae27bf34ee0","a04cf618120142d2bf33dee84197629630f1b3fea9d71e78be68765d1a23bda4","dcc49f2626d4cb197b16a1a252d82818e465bc2cb9e81885cc71dfed39e13ffe","a124ae0e546abe91092bc72f9f9b98dccd90e0a9e1a48e2ce1c9b58bd2bf44e3","97cc7f67abb8e492e4ac6e86ae11f73a4ef10e542c422d7ebaf80eef12e9dfc3","e8023e70c785d4e8d733f6bf7d9987e7665a617f3957adb61bd2b188d0a06103","eebcdddce89e9398d830143d61d40783bb03ed103bd8df7bb637153ecba0ea21","9a5760db02c253b4d2f117a1fe5e0ed699c57337b75c7b8a19709d717a9c34e9","a567d09b96aa4f83097137afc8edf7497df250347eab2d474effc1ee7581b1c3","09b53747b1fb8c1a7ddd84363ec81b2bf99cf5b736822f1615644057a9ee3964","b9061e255a72130c23fe1128d3e396b7c814245f38f5bd2027b5236c2564e994","deeb2afa212803e9c4268b894197ca621cc92157830bb3b2cced08cad02d3d34","df0e77b152378815dcd0d8380f5e04c85202051a364756d308cec055de242816","fa3364fcc2386918a139aab747920aa2d3b9d70f94f992199b31313e4df53931"],"paragraph_range_zero_based":[30048,30071],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p30048"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"shift7dot5kHz","paragraph_zero_based":30072},{"literal_text_all_w_t_and_m_t":"Indicates whether there is 7.5 kHz shift or not. 7.5 kHz shift is applied if the field is set to true. Otherwise 7.5 kHz shift is not applied.","paragraph_zero_based":30073},{"literal_text_all_w_t_and_m_t":"txDirectCurrentLocation","paragraph_zero_based":30074},{"literal_text_all_w_t_and_m_t":"The uplink Tx Direct Current location for the two carrier uplink CA with the serving cells reported using carrierOneInfo-r16 and carrierTwoInfo-r16. Values in the range of this field between 0 and 3299 indicate the subcarrier index of the uplink Tx Direct Current location with the subcarrier taken from the serving cell with ID referenceCarrierIndex and the numerology of the corresponding uplink BWP reported for this serving cell. Value 3300 indicates \"Outside the carrier\" and value 3301 indicates \"Undetermined position within the carrier\".","paragraph_zero_based":30075},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30076},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentCarrierInfo field descriptions","paragraph_zero_based":30077},{"literal_text_all_w_t_and_m_t":"bwp-Id","paragraph_zero_based":30078},{"literal_text_all_w_t_and_m_t":"The BWP ID of the serving cell which is part of the two carrier uplink carrier aggregation. The UE shall not report this field if the serving cell is reported as deactivated using deactivatedCarrier-r16.","paragraph_zero_based":30079},{"literal_text_all_w_t_and_m_t":"deactivatedCarrier","paragraph_zero_based":30080},{"literal_text_all_w_t_and_m_t":"For the reported uplink Tx Direct Current location(s) corresponding to singlePA-TxDirectCurrent-r16, indicates whether the carrier is deactivated or not for this serving cell. If the carrier refers to the PCell, the UE shall not set this field to deactivated.","paragraph_zero_based":30081},{"literal_text_all_w_t_and_m_t":"servCellIndex","paragraph_zero_based":30082},{"literal_text_all_w_t_and_m_t":"The serving cell ID of the serving cell which is part of the two carrier uplink carrier aggregation.","paragraph_zero_based":30083},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30084},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentTwoCarrier field descriptions","paragraph_zero_based":30085},{"literal_text_all_w_t_and_m_t":"carrierOneInfo","paragraph_zero_based":30086},{"literal_text_all_w_t_and_m_t":"The serving cell ID and BWP ID of the first carrier of the uplink carrier aggregation for which the uplink Tx Direct Current location(s) are being reported. ","paragraph_zero_based":30087},{"literal_text_all_w_t_and_m_t":"carrierTwoInfo","paragraph_zero_based":30088},{"literal_text_all_w_t_and_m_t":"The serving cell ID and BWP ID of the second carrier of the uplink carrier aggregation for which the uplink Tx Direct Current location(s) are being reported.","paragraph_zero_based":30089},{"literal_text_all_w_t_and_m_t":"singlePA-TxDirectCurrent","paragraph_zero_based":30090},{"literal_text_all_w_t_and_m_t":"The uplink Tx Direct Current location for the UE which support single PA for this uplink carrier aggregation. For the UEs which support dual PA for this uplink carrier aggregation, this field is for reporting the uplink Tx Direct Current location of the first PA.  ","paragraph_zero_based":30091},{"literal_text_all_w_t_and_m_t":"secondPA-TxDirectCurrent","paragraph_zero_based":30092},{"literal_text_all_w_t_and_m_t":"The uplink Tx Direct Current location used by the UE with the second PA for the UEs which support dual PA for this uplink carrier aggregation. This field shall be absent for the UplinkTxDirectCurrentTwoCarrier entity where deactivatedCarrier of carrierOneInfo or carrierTwoInfo is set to deactivated.","paragraph_zero_based":30093},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30094},{"literal_text_all_w_t_and_m_t":"–ZP-CSI-RS-Resource","paragraph_zero_based":30095}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["86ef5da33e7e374a6bdad58cf6eeb5175becfbd5e2fd5e9a743480bd4557763b","e0015f928e12ce6c5b3a096f0a32ff65f8aeeb8b57d43c9b0b047be8f318130c","bda6905435efdaa0bfe486d79b55a37ad58d3cc86a6102fee7e0027c873a1cfe","7b819dad53197f23e014c0468419182afb5412e143fcfed0814efddc23566889","3f72f94df1d11dafe6d235bbf4e71de89cd865776bde2e9561149417d97ff7f6","0e4a798aa4c4405fad964e06dda00f6dfd1f70608fc224f41261497c718356c2","e4875d32ff7901fa1cab6469c812496c901695250f18d70406050ef1096d1afd","677558cad80fc0e00dd5ea012d666139833e34eafb720f6c07b88f1964faa4c1","0bcb207da25e24efbb7012b44df16cf7f9694f9b4e17c8b3f8273ef95dd92184","1e3c90dd1db0f61600d320423f04582db44ad69ab9cf815d64d05f6354ab3970","7fb80d0b95fc6fbb24c15a5e10e1cf50a18abd3206dc5b87b0dea88e6dfd7bef","9e444feee89f5867d404ffb69911d96cb23393fa2cfb8599312fa33667415218","632384aec934a9575bbafa8ec1ecfd0dd9a7cc6f2ac4fc59a9f63053f819b54a","52f6d50b02fe1deb8d80392f51ad08c82574d197ca821a2cc3c3720339d350ad","9118e933115a6bfd02c11c90865a63c97c3fd6dedcd3f36146314161994da917","898a1b1eafc98186f99d4e2d4ff0ec460417cd7a0295eac04b1e50ba0dff8702","665494f02b668ccdf28283566fcf254d6c671672947ca9c98c2405d66fdf3d48","4d6bd70000a0aa9e22aaa04bbd5e6d9c1ba753209b8a6a75e9ee56e9eac255ab","0ae0a0a5cd4a41bf7325362d9d769e5c7f1718df4689d037da83d57c5717b91b","fcfff98c67e8761aa22087c8fbc125b73a36ccf2ffa3a801fb291e698fd372ee","b1fbce14d2dd835df230cf2a8013c58bbfa82bd304d696f256060201b7217a56","531c818de6e3ea694f4f3f13fb2b4a2d1c2a8874cacd17846cf5109c7c7c0735","53772336bb513be9f03622ebb963bac0831886d2