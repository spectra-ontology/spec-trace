{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":28392},{"literal_text_all_w_t_and_m_t":"    enableConfiguredUL-r16              ENUMERATED {enabled}                                                      OPTIONAL  -- Need R","paragraph_zero_based":28393},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":28394},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28395},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28396},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28397},{"literal_text_all_w_t_and_m_t":"SlotFormatCombination ::=           SEQUENCE {","paragraph_zero_based":28398},{"literal_text_all_w_t_and_m_t":"    slotFormatCombinationId             SlotFormatCombinationId,","paragraph_zero_based":28399},{"literal_text_all_w_t_and_m_t":"    slotFormats                         SEQUENCE (SIZE (1..maxNrofSlotFormatsPerCombination)) OF INTEGER (0..255)","paragraph_zero_based":28400},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28401},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28402},{"literal_text_all_w_t_and_m_t":"SlotFormatCombinationId ::=         INTEGER (0..maxNrofSlotFormatCombinationsPerSet-1)","paragraph_zero_based":28403},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28404},{"literal_text_all_w_t_and_m_t":"-- TAG-SLOTFORMATCOMBINATIONSPERCELL-STOP","paragraph_zero_based":28405},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28406},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28407},{"literal_text_all_w_t_and_m_t":"SlotFormatCombination field descriptions","paragraph_zero_based":28408},{"literal_text_all_w_t_and_m_t":"slotFormatCombinationId","paragraph_zero_based":28409},{"literal_text_all_w_t_and_m_t":"This ID is used in the DCI payload to dynamically select this SlotFormatCombination (see TS 38.213 [13], clause 11.1.1).","paragraph_zero_based":28410},{"literal_text_all_w_t_and_m_t":"slotFormats","paragraph_zero_based":28411},{"literal_text_all_w_t_and_m_t":"Slot formats that occur in consecutive slots in time domain order as listed here (see TS 38.213 [13], clause 11.1.1 and TS 38.213 [13], clause 14 for IAB-MT).","paragraph_zero_based":28412},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28413},{"literal_text_all_w_t_and_m_t":"SlotFormatCombinationsPerCell field descriptions","paragraph_zero_based":28414},{"literal_text_all_w_t_and_m_t":"enableConfiguredUL","paragraph_zero_based":28415}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["6c7e8a230afcdc9d88a7e04474bbad8a92b049c8ee0899971368e83e474359c1","ce6145b8d90a2801a6dfc55e2b0832148c0856b8927c02aae87c2a0a0738c980","d6b226fe8f226ea5930ac6190be08d0234a730516ceb9d3033b66dc281896883","9741de2ece37e0838de464149995120b6671f0ab620a3792f757cefa142c1875","a3320869f7570f0798b96e97d3af19dca11da6dc4209235b667ce1aef931f81d","768566a59c59d616710d69425e48e71ca7d3bee04c6e366ee750eb6945f72fd5","ec5488eaa7b77a200e20b9f729e02b6e6be17094fab0d9da9afcd79b4b6d0428","a19924c9c8f634d4ed774bf49e9dfbb955980c8377e488bc19515a8172d7a0da","9a01b35452ddf4959d8f94e72b1a3f62a7aae25d9978d1beb71bef44e0486174","5a23bc9e9f96165351dceaebfbab55b0f47149c8076c57fcb5eac79db03f6ee2","19c1ffbccab5457a4e74feeeeeee9822da2cb7b9ed2b78cf5b8e3237df3a54e6","f0f0b80e9228d4f56933016fb180a94d954337ee958be049ce0adbddf7654b40","7cff3baa3280c8b1448e23941712475153eea6224846d4d35bde327152d3c4b7","c7dfa57806a5f9bc8b5d69ef0698310a09dfbc3a9936a755c0090ba4750d785d","fb9434f716e7ad835131cee17232106844b610ebb1c638469317e8e5e403676f","918b828251f008790fa9385fe489bab6ef07f477b5b2123b4491269d77bd9f16","27417607231725ea72a153b92b173ed78c001434e552f6b3c8db0caf76a1968a","8be6322fc7ae1e9a0246e3f44e96ab58c821dcc8b05055010fa46b307dc9e116","f38a3e4e7186ca6d4447955bb4f7e8aaedeb2444097ce34aafd597ce52028c68","05623897534a9181fc1073945e2aeda085b6eeaed870f1da030794779d104275","9a3d01ae0823454a815a98f13f59254a447e5b142859bb430e4858f119ae8044","70a7f500543ab145899f73edb4149d64e20c0cf2264a544ad77dce4f182b1e1d","6cfc0835f5e0863ba940aa7d21dddd8f11bac5f5e01653a2cbfff742e9f891d0","5e086f8c3c150031efb3b020b0b81adf4e66791adbab3598546c2b66cbd8f6e7"],"paragraph_range_zero_based":[28392,28415],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p28392"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"If configured, the UE is allowed to transmit uplink signals/channels (SRS, PUCCH, CG-PUSCH) in the set of symbols of the slot when the UE does not detect a DCI format 2_0 providing a slot format for the set of symbols (see TS 38.213 [13], 11.1.1). This field is applicable only if cg-RetransmissionTimer-r16 is configured.","paragraph_zero_based":28416},{"literal_text_all_w_t_and_m_t":"positionInDCI","paragraph_zero_based":28417},{"literal_text_all_w_t_and_m_t":"The (starting) position (bit) of the slotFormatCombinationId (SFI-Index) for this serving cell (servingCellId) within the DCI payload (see TS 38.213 [13], clause 11.1.1).","paragraph_zero_based":28418},{"literal_text_all_w_t_and_m_t":"servingCellId","paragraph_zero_based":28419},{"literal_text_all_w_t_and_m_t":"The ID of the serving cell for which the slotFormatCombinations are applicable.","paragraph_zero_based":28420},{"literal_text_all_w_t_and_m_t":"slotFormatCombinations","paragraph_zero_based":28421},{"literal_text_all_w_t_and_m_t":"A list with SlotFormatCombinations. Each SlotFormatCombination comprises of one or more SlotFormats (see TS 38.211 [16], clause 4.3.2). The total number of slotFormats in the slotFormatCombinations list does not exceed 512. ","paragraph_zero_based":28422},{"literal_text_all_w_t_and_m_t":"subcarrierSpacing2","paragraph_zero_based":28423},{"literal_text_all_w_t_and_m_t":"Reference subcarrier spacing for a Slot Format Combination on an FDD or SUL cell (see TS 38.213 [13], clause 11.1.1). For FDD, subcarrierSpacing (SFI-scs) is the reference SCS for DL BWP and subcarrierSpacing2 (SFI-scs2) is the reference SCS for UL BWP. For SUL, subcarrierSpacing (SFI-scs) is the reference SCS for non-SUL carrier and subcarrierSpacing2 (SFI-scs2) is the reference SCS for SUL carrier. The network configures a value that is smaller than or equal to any SCS of configured BWPs of the serving cell that the command applies to. And the network configures a value that is smaller than or equal to the SCS of the serving cell which the UE monitors for SFI indications.","paragraph_zero_based":28424},{"literal_text_all_w_t_and_m_t":"subcarrierSpacing","paragraph_zero_based":28425},{"literal_text_all_w_t_and_m_t":"Reference subcarrier spacing for this Slot Format Combination. The network configures a value that is smaller than or equal to any SCS of configured BWPs of the serving cell that the command applies to. And the network configures a value that is smaller than or equal to the SCS of the serving cell which the UE monitors for SFI indications (see TS 38.213 [13], clause 11.1.1).","paragraph_zero_based":28426},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28427},{"literal_text_all_w_t_and_m_t":"–SlotFormatIndicator","paragraph_zero_based":28428},{"literal_text_all_w_t_and_m_t":"The IE SlotFormatIndicator is used to configure monitoring a Group-Common-PDCCH for Slot-Format-Indicators (SFI).","paragraph_zero_based":28429},{"literal_text_all_w_t_and_m_t":"SlotFormatIndicator information element","paragraph_zero_based":28430},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28431},{"literal_text_all_w_t_and_m_t":"-- TAG-SLOTFORMATINDICATOR-START","paragraph_zero_based":28432},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28433},{"literal_text_all_w_t_and_m_t":"SlotFormatIndicator ::=     SEQUENCE {","paragraph_zero_based":28434},{"literal_text_all_w_t_and_m_t":"    sfi-RNTI                    RNTI-Value,","paragraph_zero_based":28435},{"literal_text_all_w_t_and_m_t":"    dci-PayloadSize             INTEGER (1..maxSFI-DCI-PayloadSize),","paragraph_zero_based":28436},{"literal_text_all_w_t_and_m_t":"    slotFormatCombToAddModList  SEQUENCE (SIZE(1..maxNrofAggregatedCellsPerCellGroup)) OF SlotFormatCombinationsPerCell","paragraph_zero_based":28437},{"literal_text_all_w_t_and_m_t":"                                                                                                                              OPTIONAL, -- Need N","paragraph_zero_based":28438},{"literal_text_all_w_t_and_m_t":"    slotFormatCombToReleaseList SEQUENCE (SIZE(1..maxNrofAggregatedCellsPerCellGroup)) OF ServCellIndex                       OPTIONAL, -- Need N","paragraph_zero_based":28439}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["46dd20b95500641b8ca956b33dbc070fae3e08359d97962e2cee2be184049222","4c2e9ddcc3c480287792124fe13ba4cb11d5c713eb2de1ab8a2a9c917c5d7fa9","38d6c0f33c815c44573298513f767d4b270d63222a2016c78a6b9d9e54993568","d019b2b7ebcb90cfc1bcc03434fa368d2c71dd952d423af285d9df05a1d6f0aa","1f994cc58931e29d1b6e6b9ba4cb5bf6c1de92c135b10555a5abd60903547200","32370e192a5037b83d1eba8f166e61dd60afaf33bcbbd46f217e1bee8487587b","d5c188d1422dae76832882b1ee9b75d99e0297926b85008f84d41a574dd90f28","e81880f4b632a7f2913f907f467df81dc3a59bc98e6081ff4d7192b9b2d2c03f","143615fd77ef3c8370649811f69c395c22c0766d9d607297239a21519ba49c47","5c1bf762cf4c5303603d0684111880cc23d5273bc33a1ea4803a8810795cbf5a","1854a021cd272a048b621cccec9212f29dd8e6535fbd007ac62e0a5c87daca23","1fbb97d7a961a35e8d3a6a8eb033739cb08245123c4b78c1d090368f6f2cc545","06ff77c5813d0235baa5a58fd778c24d7fd03307e536a294e96629f45fcb91a6","5dfcb77772f6ca1b826c03371f9db0a9a45209b1700565c485adb820503e77a2","3817bdfbb4dc10fce38a7bc2b301e629464b912646bf1d3a9ac30a161175e4ca","1c2b7066f5c397ab616f246e3e99c96dafb02e8a638948b9da1c6df1554f216b","75762bcbcbee84e9317c14bcb393f2eb56810b745173ebc44236643571483ac8","e9768e8e1150a1102a99525409b2e54dbe14eebc4b377b75dd163097ab3bd877","d5f73593