{"fields":{"filename":"R2-2401316.zip::R2-2401316 BLE.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":768},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":769},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":770},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":771},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":772},{"literal_text_all_w_t_and_m_t":"BT-RequestAssistanceData field descriptions","paragraph_zero_based":773},{"literal_text_all_w_t_and_m_t":"requestedADThis field specifies the Bluetooth assistance data requested. This is represented by a bit string, with a one-value at the bit position means the particular assistance data is requested; a zero-value means not requested. The following assistance data types are included:","paragraph_zero_based":774},{"literal_text_all_w_t_and_m_t":"-beacon-location: Bluetooth beacon location information","paragraph_zero_based":775},{"literal_text_all_w_t_and_m_t":"-beacon-antConfig: Bluetooth beacon antenna orientation, array configuration information and antenna switching pattern for AoD estimation","paragraph_zero_based":776},{"literal_text_all_w_t_and_m_t":"-beacon-transmConfig: Bluetooth beacon advertisement and CTE configuration information","paragraph_zero_based":777},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":778},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":779}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"038bee5e08277a518e210695a9ad796eb7669167fb359201516fcfc3784430d8","original_member_sha256":"e32d7846969fb9d73f3e6db306c1eaae26983884f0f33261ecdad12458f09ea1","paragraph_ElementTree_utf8_XML_sha256":["47248a5db0aae210435c92d5a8a1fe919fb3e49a28169dc3446f16912d535b13","0ed47e41c88e63522ae165b43956636db8478b47d657011947cf050