{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–SubcarrierSpacing","paragraph_zero_based":29136},{"literal_text_all_w_t_and_m_t":"The IE SubcarrierSpacing determines the subcarrier spacing. Restrictions applicable for certain frequencies, channels or signals are clarified in the fields that use this IE.","paragraph_zero_based":29137},{"literal_text_all_w_t_and_m_t":"SubcarrierSpacing information element","paragraph_zero_based":29138},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29139},{"literal_text_all_w_t_and_m_t":"-- TAG-SUBCARRIERSPACING-START","paragraph_zero_based":29140},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29141},{"literal_text_all_w_t_and_m_t":"SubcarrierSpacing ::=               ENUMERATED {kHz15, kHz30, kHz60, kHz120, kHz240, kHz480-v1700, kHz960-v1700, spare1}","paragraph_zero_based":29142},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29143},{"literal_text_all_w_t_and_m_t":"-- TAG-SUBCARRIERSPACING-STOP","paragraph_zero_based":29144},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29145},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29146},{"literal_text_all_w_t_and_m_t":"–TAG-Config","paragraph_zero_based":29147},{"literal_text_all_w_t_and_m_t":"The IE TAG-Config is used to configure parameters for a time-alignment group.","paragraph_zero_based":29148},{"literal_text_all_w_t_and_m_t":"TAG-Config information element","paragraph_zero_based":29149},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29150},{"literal_text_all_w_t_and_m_t":"-- TAG-TAG-CONFIG-START","paragraph_zero_based":29151},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29152},{"literal_text_all_w_t_and_m_t":"TAG-Config ::=                      SEQUENCE {","paragraph_zero_based":29153},{"literal_text_all_w_t_and_m_