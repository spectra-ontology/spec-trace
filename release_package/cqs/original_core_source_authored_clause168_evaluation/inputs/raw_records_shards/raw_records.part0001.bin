illed for the associated VarMeasReport within the VarMeasReportList for this measId during timeToTrigger defined within the VarMeasConfig for this event:","paragraph_zero_based":4865},{"literal_text_all_w_t_and_m_t":"3>if reportOnLeave is set to true for the corresponding reporting configuration:","paragraph_zero_based":4866},{"literal_text_all_w_t_and_m_t":"4>initiate the measurement reporting procedure, as specified in 5.5.5;","paragraph_zero_based":4867},{"literal_text_all_w_t_and_m_t":"3>remove the measurement reporting entry within the VarMeasReportList for this measId;","paragraph_zero_based":4868},{"literal_text_all_w_t_and_m_t":"3>stop the periodical reporting timer for this measId, if running;","paragraph_zero_based":4869},{"literal_text_all_w_t_and_m_t":"NOTE 1:Void.","paragraph_zero_based":4870},{"literal_text_all_w_t_and_m_t":"2>if reportType is set to periodical and if a (first) measurement result is available:","paragraph_zero_based":4871}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["59f5f11892b793cdf1860f2c978a29cf2ce27136bdbe884f18ff77d5454b1160","52003cf487c4569ec8360776caa18a2bc214772a3a3e38ebcae5d5bd77764c66","722a1931997e26b314f541faf46a4c8d8f14463c13af06629d29e4c86b140f10","69bce08ab1886316b470d412dfdc970ec6f90bd6eacb4c37eed9d2d258d147d5","2eaf302689e612c5d2550506ccba7f56d607e8fad75ad99506234ed77671129f","3f213d0576e7506438777df8ad642900540b8eea151e660c02d077a4947ee589","762b7c33b61a04ef794b35d5f0ad5e678e4868a1da25bc8fe5539bb9084aa0ba","bd1de472aeb25fa95e6e4abbc13d7a2aa606ee25bf7faec2200ac974ad0c9283","5125d24e3ad7d9b173b7a2aa7df90ffcc16ffd1a29679cb5dae6e15092985fb1","b8979d03ab3314366c3ee5506dfa3cb090d7a10e57cb96dfb055a3b071a24bbc","e153a508