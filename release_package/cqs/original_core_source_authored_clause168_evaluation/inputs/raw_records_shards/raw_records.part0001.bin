{"fields":{"filename":"R2-2313652.zip::R2-2313652 TEI18 SDT_ReleaseEnh 38331 CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":" O&M Specifications","paragraph_zero_based":96},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":97},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":98},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":99},{"literal_text_all_w_t_and_m_t":"Other comments:","paragraph_zero_based":100},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":101},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":102},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":103},{"literal_text_all_w_t_and_m_t":"This CR's revision history:","paragraph_zero_based":104},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":105},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":106},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":107},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":108},{"literal_text_all_w_t_and_m_t":"5.3.8.3Reception of the RRCRelease by the UE","paragraph_zero_based":109},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":110},{"literal_text_all_w_t_and_m_t":"1>delay the following actions defined in this clause 60 ms from the moment the RRCRelease message was received or optionally when lower layers indicate that the receipt of the RRCRelease message has been successfully acknowledged, whichever is earlier;","paragraph_zero_based":111},{"literal_text_all_w_t_and_m_t":"1>stop timer T380, if running;","paragraph_zero_based":112},{"literal_text_all_w_t_and_m_t":"1>stop timer T320, if running;","paragraph_zero_based":113},{"literal_text_all_w_t_and_m_t":"1>if timer T316 is running;","paragraph_zero_based":114},{"literal_text_all_w_t_and_m_t":"2>stop timer T316;","paragraph_zero_based":115},{"literal_text_all_w_t_and_m_t":"2>clear the information included in VarRLF-Report, if any;","paragraph_zero_based":116},{"literal_text_all_w_t_and_m_t":"1>stop timer T350, if running;","paragraph_zero_based":117},{"literal_text_all_w_t_and_m_t":"1>stop timer T346g, if running;","paragraph_zero_based":118},{"literal_text_all_w_t_and_m_t":"1>if the AS security is not activated:","paragraph_zero_based":119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"17bfba3da8c3743440a94764df1dd7e80753d504abfaf5e795d5a1c67c51ffac","original_member_sha256":"812d8433d8c47117aecae37ff5db028576123736cb57689623cc95ade6d2faf9","paragraph_ElementTree_utf8_XML_sha256":["4f90f43bc82590d80c63f5d6d77be40b437292e114740a3cdda1b7e9a9d06d19","8d88bdd967fffd6c00c759d575ae4874f4bb7732d9c64eebbcdb3533e823c3bd","4de6e74286aeec4afefa4fa33906edc4888074db453d3603a5d7aea1c25436a1","f0cc0df1a6f0e4f4d4c9f974f7a03bb2ce0e094db264f9a073670355e0bd5ffd","aaf212b87b85424c348830b9623485b440041d78ddc5e78ee7b95e2e334c51a0","19a964c08460ffea6f4704dc76f8d92e4810c482d458abc4c946dd767cecb093","df5bdfb8ec00efb3726a64d08d071a45723e97ca9bd91e086cdda2064a3a3d6e","4f6b7210fbe1cf9dcffe7cfc884d201f3f49c6d0f9f5505afa072d160cdeffbc","10d4c7dbc1f63503a036dcacbea4aa6697293efd0eacba7d8cd837490e20ec05","2f0e8bee3855678556cab8aae02e278e12679b7de08b9b090743dcf49466ee40","f3537de2917ddbaf7430fe5b50e6660cf97cb5de4296d63f920bcd16dc94c94f","4badbdf6f719dcd293fd772ddbcf639742d2daffe6ff8504a1a5fee6087db72c","a8b872676f9870e3238d147619f9579ddfb53f995e4d9a3fae0abdb8bcdb3573","c5830824149899a25ec4b4221c29ba1027552822172507716f6a4b087f4de76f","c25ad5a685c6a8136147801b13138942b46824e33bbd6d3ec4d4899d0561e11e","d110fdf65b2162779823a050b99aceda0f0bfedcc4a6f9db9ede5cfb8ba4f0d1","4e6c3f357e54795b3eccd4ca4988d66a92bc1596c21da6ed2209a839f4c7e2e3","f344f04b50e7daa53d9c390c3cc1613a53011ecaf5964ac669a93bc1ff664874","1db14cb6a6082fa55310f322e30d0c2ad79734f6a7557f2b3b035c128c0a6b0c","41e4442904b42c831892b021a1f3b943eec21ec3ff058db10a2d6f41861d1e24","39ae8f6d2969773fafac2e7aa381185b14d8d0129929289f7009fadaf948f5ed","900c17ff76119b08ceb9f9d39e691edcf89a41e0af9977705f9e54b4187616f5","2f70b13ecad447f52699f96d8c883e85f8435f8fcc9decc01ba2ab686ec239af","1086e16039442f99d8410454e8b91e7decef9ca1581b7aad934775a0aacc2d13"],"paragraph_range_zero_based":[96,119],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313652.zip::R2-2313652 TEI18 SDT_ReleaseEnh 38331 CR.docx:p96"}
{"fields":{"filename":"R2-2313652.zip::R2-2313652 TEI18 SDT_ReleaseEnh 38331 CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>ignore any field included in RRCRelease message except waitTime;","paragraph_zero_based":120},{"literal_text_all_w_t_and_m_t":"2>perform the actions upon going to RRC_IDLE as specified in 5.3.11 with the release cause 'other' upon which the procedure ends;","paragraph_zero_based":121},{"literal_text_all_w_t_and_m_t":"1>if the RRCRelease message includes redirectedCarrierInfo indicating redirection to eutra:","paragraph_zero_based":122},{"literal_text_all_w_t_and_m_t":"2>if cnType is included:","paragraph_zero_based":123},{"literal_text_all_w_t_and_m_t":"3>after the cell selection, indicate the available CN Type(s) and the received cnType to upper layers;","paragraph_zero_based":124},{"literal_text_all_w_t_and_m_t":"NOTE 1:Handling the case if the E-UTRA cell selected after the redirection does not support the core network type specified by the cnType, is up to UE implementation.","paragraph_zero_based":125},{"literal_text_all_w_t_and_m_t":"2>if voiceFallbackIndication is included:","paragraph_zero_based":126},{"literal_text_all_w_t_and_m_t":"3>consider the RRC connection release was for EPS fallback for IMS voice (see TS 23.502 [43]);","paragraph_zero_based":127},{"literal_text_all_w_t_and_m_t":"1>if the RRCRelease message includes the cellReselectionPriorities:","paragraph_zero_based":128},{"literal_text_all_w_t_and_m_t":"2>store the cell reselection priority information provided by the cellReselectionPriorities;","paragraph_zero_based":129},{"literal_text_all_w_t_and_m_t":"2>if the t320 is included:","paragraph_zero_based":130},{"literal_text_all_w_t_and_m_t":"3>start timer T320, with the timer value set according to the value of t320;","paragraph_zero_based":131},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":132},{"literal_text_all_w_t_and_m_t":"2>apply the cell reselection priority information broadcast in the system information;","paragraph_zero_based":133},{"literal_text_all_w_t_and_m_t":"1>if deprioritisationReq is included and the UE supports RRC connection release with deprioritisation:","paragraph_zero_based":134},{"literal_text_all_w_t_and_m_t":"2>start or restart timer T325 with the timer value set to the deprioritisationTimer signalled;","paragraph_zero_based":135},{"literal_text_all_w_t_and_m_t":"2>store the deprioritisationReq until T325 expiry;","paragraph_zero_based":136},{"literal_text_all_w_t_and_m_t":"NOTE 1a:The UE stores the deprioritisation request irrespective of any cell reselection absolute priority assignments (by dedicated or common signalling) and regardless of RRC connections in NR or other RATs unless specified otherwise.","paragraph_zero_based":137},{"literal_text_all_w_t_and_m_t":"1>if the RRCRelease includes the measIdleConfig:","paragraph_zero_based":138},{"literal_text_all_w_t_and_m_t":"2>if T331 is running:","paragraph_zero_based":139},{"literal_text_all_w_t_and_m_t":"3> stop timer T331;","paragraph_zero_based":140},{"literal_text_all_w_t_and_m_t":"3>perform the actions as specified in 5.7.8.3;","paragraph_zero_based":141},{"literal_text_all_w_t_and_m_t":"2>if the measIdleConfig is set to setup:","paragraph_zero_based":142},{"literal_text_all_w_t_and_m_t":"3>store the received measIdleDuration in VarMeasIdleConfig;","paragraph_zero_based":143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"17bfba3da8c3743440a94764df1dd7e80753d504abfaf5e795d5a1c67c51ffac","original_member_sha256":"812d8433d8c47117aecae37ff5db028576123736cb57689623cc95ade6d2faf9","paragraph_ElementTree_utf8_XML_sha256":["234ee8c3e169c8b9496ef59ceffb95f69b6df9297f3a79f326f47f73cddd3854","58a15c451067df5e91fcf88d7566236cbaad447fed7bdcf123f71dd30657d548","7b3a3d1f65117dfb2b9d8a5a81656b61f8c5c9916dc5ffb86fad718fa6a4cba0","2ce3db939bbf3dabcca1a7c83c9a9b7672bfa32e7b0d984da9382137afe2325f","247cc77bc1cd97e8ecc7e6ce22e2f249042f12d36819cf58c3b0228e5abf0447","018601745be25073e0b7741d181760009768112c678b1499c1de7947953deb07","6bdc9657807c208b8d74466a9877e8c14927a0a443c2085f9bb2f04184682cc6","3f6a3586368c89966e6d6a33a5634462232c042edd30baa8e3738b9e5a1a8a94","5171198d63cb090962db60ce9aa3a5e80b15d7b4c29204b63637754110cb628f","2fb279ab7c104c9cca147834385bab1d256f44322a448f2517613840422b6d10","a606e99643f614d09e7cdb766cc8a69ce9dbf5dfe91a46677383ac96b918b6a5","4c370ca9080381536c66f46f4a51242961c9eb4778347468251b5b6a2b3e79f8","a068ce58f3bb0593d985e6516011fdccaa100dc4b6476f3633320f6321a1e75f","648249c42dccda698d10d6be0aa83b2e3f061b1abcab91a6036540226883b049","749db00ae8bd05d582f36a3bcc6caefa9b50e8138259b9cb9403bcf7c08178d0","123a070987035e0884b7c6cf24df4ebc50e99e2481c76eefbde01c60e9d99947","b26f085d862c74fdec8f8ca44b414db139659ae78d48c6d71a170f2251ba27ad","719ceba76601ecf9346bd874a3d3748df5d8dea6c2af293e53d64153be131c0a","94e4ed9647f58e7d8eedf594a562dff09da9eb17a8f7739c7cb4e3630053ca90","8abaed59646a5df55dc69a714ae3a2fcbaf14cde108a7f3d0097778621ce9b78","44306e9f56c591bbf4b62eb455e363830363c750041166d1dc14144c545a5f57","c7e93c2001bec37e03f37d39bd4558ff4f1c0dd91a9f1044545bab24bc12ab8c","2badb677526ab14db54c814b42261e33f6620662d0cbe196d9350a4d354e6ef6","724528bc101c3cebabe1547027ef9ffeafe5c8ef245a07b1a95f2f5214b76363"],"paragraph_range_zero_based":[120,143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313652.zip::R2-2313652 TEI18 SDT_ReleaseEnh 38331 CR.docx:p120"}
{"fields":{"filename":"R2-2313652.zip::R2-2313652 TEI18 SDT_ReleaseEnh 38331 CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>start timer T331 with the value set to measIdleDuration;","paragraph_zero_based":144},{"literal_text_all_w_t_and_m_t":"3>if the measIdleConfig contains measIdleCarrierListNR:","paragraph_zero_based":145},{"literal_text_all_w_t_and_m_t":"4>store the received measIdleCarrierListNR in VarMeasIdleConfig;","paragraph_zero_based":146},{"literal_text_all_w_t_and_m_t":"3>if the measIdleConfig contains measIdleCarrierListEUTRA:","paragraph_zero_based":147},{"literal_text_all_w_t_and_m_t":"4>store the received measIdleCarrierListEUTRA in VarMeasIdleConfig;","paragraph_zero_based":148},{"literal_text_all_w_t_and_m_t":"3>if the measIdleConfig contains validityAreaList:","paragraph_zero_based":149},{"literal_text_all_w_t_and_m_t":"4>store the received validityAreaList in VarMeasIdleConfig;","paragraph_zero_based":150},{"literal_text_all_w_t_and_m_t":"1>if the RRCRelease includes suspendConfig:","paragraph_zero_based":151},{"literal_text_all_w_t_and_m_t":"2>reset MAC and release the default MAC Cell Group configuration, if any;","paragraph_zero_based":152},{"literal_text_all_w_t_and_m_t":"2>apply the received suspendConfig except the received nextHopChainingCount;","paragraph_zero_based":153},{"literal_text_all_w_t_and_m_t":"2>if the sdt-Config is configured:","paragraph_zero_based":154},{"literal_text_all_w_t_and_m_t":"3>for each of the DRB in the sdt-DRB-List:","paragraph_zero_based":155},{"literal_text_all_w_t_and_m_t":"4>consider the DRB to be configured for SDT;","paragraph_zero_based":156},{"literal_text_all_w_t_and_m_t":"3>if sdt-SRB2-Indication is configured:","paragraph_zero_based":157},{"literal_text_all_w_t_and_m_t":"4>consider the SRB2 to be configured for SDT;","paragraph_zero_based":158},{"literal_text_all_w_t_and_m_t":"3>for each RLC bearer (except those associated with broadcast MRBs) that is not suspended:","paragraph_zero_based":159},{"literal_text_all_w_t_and_m_t":"4>re-establish the RLC entity as specified in TS 38.322 [4];","paragraph_zero_based":160},{"literal_text_all_w_t_and_m_t":"3>for SRB2 (if it is resumed) and for SRB1:","paragraph_zero_based":161},{"literal_text_all_w_t_and_m_t":"4>trigger the PDCP entity to perform SDU discard as specified in TS 38.323 [5];","paragraph_zero_based":162},{"literal_text_all_w_t_and_m_t":"3>if sdt-MAC-PHY-CG-Config is configured:","paragraph_zero_based":163},{"literal_text_all_w_t_and_m_t":"4>configure the PCell with the configured grant resources for SDT and instruct the MAC entity to start the cg-SDT-TimeAlignmentTimer;","paragraph_zero_based":164},{"literal_text_all_w_t_and_m_t":"2>if srs-PosRRC-Inactive is configured:","paragraph_zero_based":165},{"literal_text_all_w_t_and_m_t":"3>apply the configuration and instruct MAC to start the inactivePosSRS-TimeAlignmentTimer;","paragraph_zero_based":166},{"literal_text_all_w_t_and_m_t":"NOTE 1b:The Network should provide full configuration to UE for SRS for Positioning in RRC_INACTIVE.","paragraph_zero_based":167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"17bfba3da8c3743440a94764df1dd7e80753d504abfaf5e795d5a1c67c51ffac","original_member_sha256":"812d8433d8c47117aecae37ff5db028576123736cb57689623cc95ade6d2faf9","paragraph_ElementTree_utf8_XML_sha256":["ef2126447844987270244004e45f8804e0157c13fbe9c6db7f388e5ce9a66cb4","3441fb85b6ac13f8f57e793f09b48ab7f857631bd9a11d49435c9d7dc7aeda2e","6d7ba50157eb0299498e472474a66565491e83fb942bea61f95d468a8dda3fdb","662d9084546e0fac7b949d92fa23724d110149af7e818a189b4afad75cdd231d","2f26384788a9d911f023484fe26ad24ef358e90360ae6ab5afb5ff2c2c4a59d0","73e60467d8e05b1af27d575130ae7c5f53e3a1b6aeee95161ec726f497f428a4","1f303dcc3a507d9b66d3a19101c33ca919bb4f4ce350521e26a4c3d40e6997e7","71f1075f7c0418c78c9d99c3627c040e5c70cae77609dd8baab73600d2c213af","06e95f269da83d152b8096d454e961f65093172507097ea3c5e24d05472a0efd","c87418057adb51bfa528ddb8de57237da577dc5fa05971d2ec2509dfe55ef73c","11f564b022f3b2c3a585a81af15c1c29d7663afd3c3de4b011abb9abe5d8aa19","6852a2fc6504f793521d7295f00151172c0873014a001dc65292f45290d8eea4","c586165d5d80a51a7252df3754bf18b951b37167f25802197556277c4e668cea","91c07aa45a3d1d54babafeebefd4c85046a09466784bd1b360e118308adf3895","a0f489132d05b443c112df6ff5771992cb7ec413487e9ee6afb11da968a4f2fe","77684081574c437032f4d2da03f82aa16522f3cf382463ca6288ccc6ad2a46c7","51e7002188ffaaf2f1a5ab2ad744dc8c20ad4c2bccb56f76b5d93a2b78c86bce","f60a0d41033b3d6d739e579b401443d241d579161ed580201a5b5f4ddc29f1fd","dbcb7f9ff845bca39177b08adb2795e52d34a351251d170a39e9ccd4228a32a5","0c4aa180d2f0b288d162724e3af0e6673c38a9ef14db00ecaa7716bf7762c44d","2994fbba2d83afa7139872ccb5983ba240bf97b8e9896b054f13c34698c1162c","1826cb35845f1952da7dfed19a8c422d1d77ac40e5d1db8c2bbb16d063c92976","84c26c0d78a00985ad0b1af71a18591be021365a880d5df9fb8d4d896d2a9c6c","5102ca31e712d45b7125363739e9ac7d15abaec8f5678c67c0a3cea8687403b4"],"paragraph_range_zero_based":[144,167],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313652.zip::R2-2313652 TEI18 SDT_ReleaseEnh 38331 CR.docx:p144"}
{"fields":{"filename":"R2-2313652.zip::R2-2313652 TEI18 SDT_ReleaseEnh 38331 CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>remove all the entries within the MCG and the SCG VarConditionalReconfig, if any;","paragraph_zero_based":168},{"literal_text_all_w_t_and_m_t":"2>for each measId of the MCG measConfig and for each measId of the SCG measConfig, if configured, if the associated reportConfig has a reportType set to condTriggerConfig:","paragraph_zero_based":169},{"literal_text_all_w_t_and_m_t":"3>for the associated reportConfigId:","paragraph_zero_based":170},{"literal_text_all_w_t_and_m_t":"4>remove the entry with the matching reportConfigId from the reportConfigList within the VarMeasConfig;","paragraph_zero_based":171},{"literal_text_all_w_t_and_m_t":"3>if the associated measObjectId is only associated to a reportConfig with reportType set to condTriggerConfig:","paragraph_zero_based":172},{"literal_text_all_w_t_and_m_t":"4>remove the entry with the matching measObjectId from the measObjectList within the VarMeasConfig;","paragraph_zero_based":173},{"literal_text_all_w_t_and_m_t":"3>remove the entry with the matching measId from the measIdList within the VarMeasConfig;","paragraph_zero_based":174},{"literal_text_all_w_t_and_m_t":"2>if the UE is acting as L2 U2N Remote UE:","paragraph_zero_based":175},{"literal_text_all_w_t_and_m_t":"3>if the PC5-RRC connection with the U2N Relay UE is determined to be released:","paragraph_zero_based":176},{"literal_text_all_w_t_and_m_t":"4>indicate upper layers to trigger PC5 unicast link release;","paragraph_zero_based":177},{"literal_text_all_w_t_and_m_t":"3>else (i.e., maintain the PC5 RRC connection):","paragraph_zero_based":178},{"literal_text_all_w_t_and_m_t":"4>establish or re-establish (e.g. via release and add) SL RLC entity for SRB1;","paragraph_zero_based":179},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":180},{"literal_text_all_w_t_and_m_t":"3>re-establish RLC entities for SRB1;","paragraph_zero_based":181},{"literal_text_all_w_t_and_m_t":"2>if the RRCRelease message with suspendConfig was received in response to an RRCResumeRequest or an RRCResumeRequest1:","paragraph_zero_based":182},{"literal_text_all_w_t_and_m_t":"3>stop the timer T319 if running;","paragraph_zero_based":183},{"literal_text_all_w_t_and_m_t":"3>in the stored UE Inactive AS context:","paragraph_zero_based":184},{"literal_text_all_w_t_and_m_t":"4>replace the KgNB and KRRCint keys with the current KgNB and KRRCint keys;","paragraph_zero_based":185},{"literal_text_all_w_t_and_m_t":"4>replace the nextHopChainingCount with the value of nextHopChainingCount received in the RRCRelease message;","paragraph_zero_based":186},{"literal_text_all_w_t_and_m_t":"4>replace the cellIdentity with the cellIdentity of the cell the UE has received the RRCRelease message;","paragraph_zero_based":187},{"literal_text_all_w_t_and_m_t":"4>if the suspendConfig contains the sl-UEIdentityRemote (i.e. the UE is a L2 U2N Remote UE):","paragraph_zero_based":188},{"literal_text_all_w_t_and_m_t":"5>replace the C-RNTI with the value of the sl-UEIdentityRemote;","paragraph_zero_based":189},{"literal_text_all_w_t_and_m_t":"5>replace the physical cell identity with the value of the sl-PhysCellId in sl-ServingCellInfo contained in the discovery message received from the connected L2 U2N Relay UE;","paragraph_zero_based":190},{"literal_text_all_w_t_and_m_t":"4> else:","paragraph_zero_based":191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"17bfba3da8c3743440a94764df1dd7e80753d504abfaf5e795d5a1c67c51ffac","original_member_sha256":"812d8433d8c47117aecae37ff5db028576123736cb57689623cc95ade6d2faf9","paragraph_ElementTree_utf8_XML_sha256":["555025f13a5e7e0fe5055917e31c14962cfbfafd84454281321cc0f2aa9b38c0","fbecc54b8a54cd214691794a85ea5a66a93f40ef8a29263876cfe3cceb0b6694","b869816f366bfd924db25327b8e81ef8d8deae7542327574ba33a3fc42e58d9a","d4039077c4278247fcbcc3183ddc083020c4ff07265176bde96b960451bbc940","39f3966cce1d3c7c0e1413715607c0cfdad6893d211146895ed650f7f7451c94","7d7d9b9f6818dd975711e67a561489abc0c9c967cda58542d557a416806ed1fd","a7d948a19e361a187930795e09c775c9d239a87f4c84dbcd3c3c1aaeded12e4e","db70de6bbff840869f249fe0cc02e0311a5ee280b5d18f330071d0abd631e3fe","98fd9ec4c72a39d15a21626c1eb884bc0384ecf4c25fcba5b73b3f80df8b2f19","b7dfc86e944215aa2a7e8f8fb4cfeac37292f0687c7798141abe7a08dc52ba9e","fa59f70b39ca9cab117eda46f952d740944189e60f0df683376da08a52decf68","b79daab2e853105cc9c85b7f49d44c991d3e66554f1c4bb3e2d73ed4f07a508c","e77e2eb736fdbb387a99d0d6c8186ffcaf4e5004409d15ad5488012d597d3bd4","a63b5fd195b1291f54e95dfd434e8379d4e2056ac25af3555f76a36b51c9badf","9b7e50fc618f56ac8921e55b36749182c54cc94759336f37dcb55f8187a8c0dc","659318bcb4d2ed106e0929038598ba210352bb3291381526c8c272104b1f7593","408be8c46bd68b8168b7be32d42d442136aad658319f058bbec3d6a73cfab780","ca65e4beaa7ea743b8991b565efcc2e046c9b87defcc2166682d028f86da60e1","7b12d4aff6458ddbda1a52f3441bad04e51287649187becf83cd8582142bcd07","28400d1078e7198c85d682d053934866205eb4aa0e5dd7a0a0c406617520bc2f","311fa37c9035f2acd715c2ba37ee9df7cf9288a72776f7ea26c03283e104ff35","97c59ec64827ebfc96d0493c0ab405a069fa7c7983511c63421bf39d073bb6a2","0104a58a4b32a04d3f6c8b47ef61e7e23eeea8d5867ba22b944cae9a5909b0f6","8e59f1f1212c4266f08edfce6e60424d5b9a373edcea1fa616592b7b9e395bc3"],"paragraph_range_zero_based":[168,191],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313652.zip::R2-2313652 TEI18 SDT_ReleaseEnh 38331 CR.docx:p168"}
{"fields":{"filename":"R2-2313652.zip::R2-2313652 TEI18 SDT_ReleaseEnh 38331 CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5>replace the C-RNTI with the C-RNTI used in the cell (see TS 38.321 [3]) the UE has received the RRCRelease message;","paragraph_zero_based":192},{"literal_text_all_w_t_and_m_t":"5>replace the physical cell identity with the physical cell identity of the cell the UE has received the RRCRelease message;","paragraph_zero_based":193},{"literal_text_all_w_t_and_m_t":"3>replace the nextHopChainingCount with the value associated with the current KgNB;","paragraph_zero_based":194},{"literal_text_all_w_t_and_m_t":"3>stop the timer T319a if running and consider SDT procedure is not ongoing;","paragraph_zero_based":195},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":196},{"literal_text_all_w_t_and_m_t":"3>store in the UE Inactive AS Context the nextHopChainingCount received in the RRCRelease message, the current KgNB and KRRCint keys, the ROHC state, the EHC context(s), the UDC state, the stored QoS flow to DRB mapping rules, the application layer measurement configuration, the C-RNTI used in the source PCell, the cellIdentity and the physical cell identity of the source PCell, the spCellConfigCommon within ReconfigurationWithSync of the NR PSCell (if configured) and all other parameters configured except for:","paragraph_zero_based":197},{"literal_text_all_w_t_and_m_t":"-parameters within ReconfigurationWithSync of the PCell;","paragraph_zero_based":198},{"literal_text_all_w_t_and_m_t":"-parameters within ReconfigurationWithSync of the NR PSCell, if configured;","paragraph_zero_based":199},{"literal_text_all_w_t_and_m_t":"-parameters within MobilityControlInfoSCG of the E-UTRA PSCell, if configured;","paragraph_zero_based":200},{"literal_text_all_w_t_and_m_t":"-servingCellConfigCommonSIB;","paragraph_zero_based":201},{"literal_text_all_w_t_and_m_t":"-sl-L2RelayUE-Config, if configured;","paragraph_zero_based":202},{"literal_text_all_w_t_and_m_t":"-sl-L2RemoteUE-Config, if configured;","paragraph_zero_based":203},{"literal_text_all_w_t_and_m_t":"NOTE 1c:suspendConfig is not stored as part of UE Inactive AS Context, except for the fields explicitly specified.","paragraph_zero_based":204},{"literal_text_all_w_t_and_m_t":"3>store any previously or subsequently received application layer measurement report containers for which no segment, or full message, has been submitted to lower layers for transmission;","paragraph_zero_based":205},{"literal_text_all_w_t_and_m_t":"NOTE 2:NR sidelink communication/discovery related configurations and logged measurement configuration are not stored as UE Inactive AS Context, when UE enters RRC_INACTIVE.","paragraph_zero_based":206},{"literal_text_all_w_t_and_m_t":"2>suspend all SRB(s) and DRB(s) and multicast MRB(s), except SRB0 and broadcast MRBs;","paragraph_zero_based":207},{"literal_text_all_w_t_and_m_t":"2>indicate PDCP suspend to lower layers of all DRBs and multicast MRBs;","paragraph_zero_based":208},{"literal_text_all_w_t_and_m_t":"2>release Uu Relay RLC channel(s), if configured;","paragraph_zero_based":209},{"literal_text_all_w_t_and_m_t":"2>release PC5 Relay RLC channel(s), if configured;","paragraph_zero_based":210},{"literal_text_all_w_t_and_m_t":"2>release the SRAP entity, if configured;","paragraph_zero_based":211},{"literal_text_all_w_t_and_m_t":"NOTE 2a:A L2 U2N Relay UE may re-establish the SL-RLC0, SL-RLC1 and SRAP entity after release.","paragraph_zero_based":212},{"literal_text_all_w_t_and_m_t":"2>if the t380 is included:","paragraph_zero_based":213},{"literal_text_all_w_t_and_m_t":"3>start timer T380, with the timer value set to t380;","paragraph_zero_based":214},{"literal_text_all_w_t_and_m_t":"2>if the RRCRelease message is including the waitTime:","paragraph_zero_based":215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"17bfba3da8c3743440a94764df1dd7e80753d504abfaf5e795d5a1c67c51ffac","original_member_sha256":"812d8433d8c47117aecae37ff5db028576123736cb57689623cc95ade6d2faf9","paragraph_ElementTree_utf8_XML_sha256":["679797dbb9af6624ad62a31a3e780229813d092dc7bcc8bbddd7602fe78c9a32","7ef8f6fa70d5489569fbaedb235bfa97a62ff6625beb5e711a9df58b0b6ac105","8ad643d9dcc115a7453924a9c5ee97b0cb106ecc2fc057e39ec105354e13919e","310b083fe6b96becc93627e7798a99eeddadb7028b190ddf74527b9a7c042fcd","3fe6a3242c3871e264cd7235e07814ffd2d90a50ef157febf10496397b1a52a2","c677344893d3665e60b57a4d7b6dbaa3626591fb83dfc236e48b284b4e2c08cb","99e5d4ab2695c726ee608dd4a3d1d988cfccd09d922fb83064a7019177893e18","7854db6b540946ffd15a8e3cb6b0b993618c29d385478cf12de13f6a2d758e67","1dbe8ffee5560069f7f9ac1f36c54525aa1a8bd974020c8953277fbcd997a5f0","e254115ee0237f77f27e3270b6c70c7d5a95c855bc8a2802a81e195f1b4c067a","3dba5e048bbb8c1529addfb3c2f1d3bf95a55e68e8c3935b7ed99b7fcf5332dd","0a6d2cd454da168fd7c3e575c8118afc77af4cdf94a806e96def5b03314f8707","d825a899e9c68882ddb224757dc3a337c642570de172d2dd6fe2acf1ca95b847","b8005d8cdbb8d5131bdbec722c3c81b8496aeae01f90b3a8e12eb13bb86c989b","8d9d68f0bb786ca3deca23cd3782c7404d0a57338c12f3f0bbdafefa78c17db7","c4925ab3bf34a1f77b02863312ea905ae0931383dc037064c21faae53b409ba6","a103fcc42442c5f6f490a3724c6e898a2f4134074973e1650b43e5aa4fcc77bb","4462f5fd064827c4b37f7a5c3730610c6d15332fb7b3ba9ca4d4e3bddc58a962","129abcc25edeed30a5f02734ec09bd0fbe26b97bd9750f7021184b8e69d9f5d6","6fed5d221b67ad1a013c049c58f01333d28bd2d605d3a98bf6ed11608ad89c8f","6f492f99d8ddb72dc2aef45b3388e2ac12096f7368e55ebaf10583f59f22d592","39d9ba95fcb13662e54c9733c89a27aab7f27683682e593a8a1a2fb388893470","21354a94fc44136eae46a962179041e9f357f838814c7e3353644073c791f872","cb1ce40f59df33033361ac697900eefb2c11db2d2862ece0734b485ae499b52a"],"paragraph_range_zero_based":[192,215],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313652.zip::R2-2313652 TEI18 SDT_ReleaseEnh 38331 CR.docx:p192"}
{"fields":{"filename":"R2-2313652.zip::R2-2313652 TEI18 SDT_ReleaseEnh 38331 CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>start timer T302 with the value set to the waitTime;","paragraph_zero_based":216},{"literal_text_all_w_t_and_m_t":"3>inform upper layers that access barring is applicable for all access categories except categories '0' and '2';","paragraph_zero_based":217},{"literal_text_all_w_t_and_m_t":"2>if T390 is running:","paragraph_zero_based":218},{"literal_text_all_w_t_and_m_t":"3>stop timer T390 for all access categories;","paragraph_zero_based":219},{"literal_text_all_w_t_and_m_t":"3>perform the actions as specified in 5.3.14.4;","paragraph_zero_based":220},{"literal_text_all_w_t_and_m_t":"2>indicate the suspension of the RRC connection to upper layers;","paragraph_zero_based":221},{"literal_text_all_w_t_and_m_t":"2>if the UE is capable of L2 U2N Remote UE:","paragraph_zero_based":222},{"literal_text_all_w_t_and_m_t":"3>enter RRC_INACTIVE, and perform either cell selection as specified in TS 38.304 [20], or relay selection as specified in clause 5.8.15.3, or both;","paragraph_zero_based":223},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":224},{"literal_text_all_w_t_and_m_t":"3>enter RRC_INACTIVE and perform cell selection as specified in TS 38.304 [20];","paragraph_zero_based":225},{"literal_text_all_w_t_and_m_t":"2>if the suspendConfig includes resumeIndication:","paragraph_zero_based":226},{"literal_text_all_w_t_and_m_t":"3> perform the actions as if the UE received Paging message with the ue-Identity included in the PagingRecord matching the UE's stored fullI-RNTI, as specified in clause 5.3.2.3;","paragraph_zero_based":227},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":228},{"literal_text_all_w_t_and_m_t":"2>perform the actions upon going to RRC_IDLE as specified in 5.3.11, with the release cause 'other'.","paragraph_zero_based":229},{"literal_text_all_w_t_and_m_t":"NOTE 3:Whether to release the PC5 unicast link is left to L2 U2N Remote UE's implementation.","paragraph_zero_based":230},{"literal_text_all_w_t_and_m_t":"NOTE 4:It is left to UE implementation whether to stop T430, if running, when going to RRC_INACTIVE.","paragraph_zero_based":231},{"literal_text_all_w_t_and_m_t":"<TEXT OMITTED>","paragraph_zero_based":232},{"literal_text_all_w_t_and_m_t":"5.3.13RRC connection resume","paragraph_zero_based":233},{"literal_text_all_w_t_and_m_t":"<TEXT OMITTED>","paragraph_zero_based":234},{"literal_text_all_w_t_and_m_t":"5.3.13.2Initiation","paragraph_zero_based":235},{"literal_text_all_w_t_and_m_t":"The UE initiates the procedure when upper layers or AS (when responding to RAN paging, upon triggering RNA updates while the UE is in RRC_INACTIVE, for NR sidelink communication/discovery/V2X sidelink communication as specified in clause 5.3.13.1a, upon receiving RRCRelease message including resumeIndication) requests the resume of a suspended RRC connection or requests the resume for initiating SDT as specified in clause 5.3.13.1b.","paragraph_zero_based":236},{"literal_text_all_w_t_and_m_t":"The UE shall ensure having valid and up to date essential system information as specified in clause 5.2.2.2 before initiating this procedure.","paragraph_zero_based":237},{"literal_text_all_w_t_and_m_t":"Upon initiation of the procedure, the UE shall:","paragraph_zero_based":238},{"literal_text_all_w_t_and_m_t":"1>if the resumption of the RRC connection is triggered by response to NG-RAN paging; or","paragraph_zero_based":239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"17bfba3da8c3743440a94764df1dd7e80753d504abfaf5e795d5a1c67c51ffac","original_member_sha256":"812d8433d8c47117aecae37ff5db028576123736cb57689623cc95ade6d2faf9","paragraph_ElementTree_utf8_XML_sha256":["011e5f82f8fa787b6a28100f57ab15272f7d232434a7be836f8f52f72eb3f50f","d30212c2cb37e0f1302874750b7028d959fd7ac9a4ccecd095ceb2778a92a9ab","b6d771cbc160f54420ad576a7cbf76f69c967b07fbf3c29c6aa6462cec008105","7e534db94e23ac36c8d767853a745dc38c4495aed6dafa0ff675296862ab5fc8","7058db018bb9594cf24328fe48134dc785d6f50dd7b7603a22ccfc5226b32173","a28c6af529787347700a1088f37bcbd7e2fbaf679f68cee04e3a67cb306ab419","31ab02ba27c53eb0edc34e553a266877babecb5a84c1123c47e8ab894fa539d2","1767b04d77557762115371d68b01c5530bc2517e15db54ed5a64ba1adaee11a1","aff13d6d4dbbb1e6792746a68be9e0d45cf8eb0c48a39e18f00d829306c5fd7d","a02fab01f6297a7357b096a9e2c379e01a2746925f8e7b25f097a7c9cd51016a","1e0594f5a8b24386382667b9a25d1a070e03f477fc57739519a1f0c96bd51014","7c806e12cc4df4c09b2672d89fd260e499e44e2936a7cb4a966fe1cf80bbe441","468a258888f17074184ae5d098df920b72df972e5c36fc0f1969e02c976ca20d","38484a6c900af9f5ee41d3dd6500d4631b877ff7ca1bed782a000901b6ae22fe","1e91d009fd050f5050ce4e9ecea0764ed3be58e3f455550765450ff238abb532","4a32eba1b1b2fe3c51cccf455059a244a9a7065d56388ce30053267501ee022f","24f3dd9dd8e8b2e0c2c43bcc5afb1aecb36418c59ac2ecbbe1297552dfec5eb1","167bd74d79198e50461129710d60efc1e67cdc2c26bbeb4b8a35a115aacc8275","d5a363432540cdbcc75c17840cb4eb1a20b2628dae51f3030431f6978898bae4","cebce533651ebd79e9efb126c8741ff77eb397faf8c14c374cbcfb77396d8bed","15fab5197335328088f35d59c19fceaa05365e8e21f33fc788b971cfb96102f2","5af0ecbd0c91cf0925c9126072a20b17a917361de2469da3a9c72661b76e149c","c9f52180df08903a3bb52949d5eba8ba9021402bfec744176622fb5278d3b6e4","5fb970e6ccc285cdef9a188e4626ba1e9c8e5d4639ab5d5a336b8444fca9020d"],"paragraph_range_zero_based":[216,239],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313652.zip::R2-2313652 TEI18 SDT_ReleaseEnh 38331 CR.docx:p216"}
{"fields":{"filename":"R2-2313652.zip::R2-2313652 TEI18 SDT_ReleaseEnh 38331 CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1> if the resumption of the RRC connection is triggered by receiving RRCRelease message including resumeIndication:","paragraph_zero_based":240},{"literal_text_all_w_t_and_m_t":"2>select '0' as the Access Category;","paragraph_zero_based":241},{"literal_text_all_w_t_and_m_t":"2>perform the unified access control procedure as specified in 5.3.14 using the selected Access Category and one or more Access Identities provided by upper layers;","paragraph_zero_based":242},{"literal_text_all_w_t_and_m_t":"3>if the access attempt is barred, the procedure ends;","paragraph_zero_based":243},{"literal_text_all_w_t_and_m_t":"1>else if the resumption of the RRC connection is triggered by upper layers:","paragraph_zero_based":244},{"literal_text_all_w_t_and_m_t":"2>if the upper layers provide an Access Category and one or more Access Identities:","paragraph_zero_based":245},{"literal_text_all_w_t_and_m_t":"3>perform the unified access control procedure as specified in 5.3.14 using the Access Category and Access Identities provided by upper layers;","paragraph_zero_based":246},{"literal_text_all_w_t_and_m_t":"4>if the access attempt is barred, the procedure ends;","paragraph_zero_based":247},{"literal_text_all_w_t_and_m_t":"2>if the upper layers provide NSAG information and one or more S-NSSAI(s) triggering the access attempt (TS 23.501 [32] and TS 24.501 [23]):","paragraph_zero_based":248},{"literal_text_all_w_t_and_m_t":"3>apply the NSAG with highest NSAG priority among the NSAGs that are included in SIB1 (i.e., in FeatureCombination and/or in RA-PrioritizationSliceInfo), and that are associated with the S-NSSAI(s) triggering the access attempt, in the Random Access procedure (TS 38.321 [3], clause 5.1);","paragraph_zero_based":249},{"literal_text_all_w_t_and_m_t":"NOTE:If there are multiple NSAGs with the same highest NAS-provided NSAG priority identified for access attempt as above, it is left to UE implementation to select the NSAG to be applied in the Random Access procedure.","paragraph_zero_based":250},{"literal_text_all_w_t_and_m_t":"2>if the resumption occurs after release with redirect with mpsPriorityIndication:","paragraph_zero_based":251},{"literal_text_all_w_t_and_m_t":"3>set the resumeCause to mps-PriorityAccess;","paragraph_zero_based":252},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":253},{"literal_text_all_w_t_and_m_t":"3>set the resumeCause in accordance with the information received from upper layers;","paragraph_zero_based":254},{"literal_text_all_w_t_and_m_t":"1>else if the resumption of the RRC connection is triggered due to an RNA update as specified in 5.3.13.8:","paragraph_zero_based":255},{"literal_text_all_w_t_and_m_t":"2>if an emergency service is ongoing:","paragraph_zero_based":256},{"literal_text_all_w_t_and_m_t":"NOTE 1:How the RRC layer in the UE is aware of an ongoing emergency service is up to UE implementation.","paragraph_zero_based":257},{"literal_text_all_w_t_and_m_t":"3>select '2' as the Access Category;","paragraph_zero_based":258},{"literal_text_all_w_t_and_m_t":"3>set the resumeCause to emergency;","paragraph_zero_based":259},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":260},{"literal_text_all_w_t_and_m_t":"3>select '8' as the Access Category;","paragraph_zero_based":261},{"literal_text_all_w_t_and_m_t":"2>perform the unified access control procedure as specified in 5.3.14 using the selected Access Category and one or more Access Identities to be applied as specified in TS 24.501 [23];","paragraph_zero_based":262},{"literal_text_all_w_t_and_m_t":"3>if the access attempt is barred:","paragraph_zero_based":263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"17bfba3da8c3743440a94764df1dd7e80753d504abfaf5e795d5a1c67c51ffac","original_member_sha256":"812d8433d8c47117aecae37ff5db028576123736cb57689623cc95ade6d2faf9","paragraph_ElementTree_utf8_XML_sha256":["528b7e642998bb0d7ce575623367fcfc5ec2312514c9f2f046f91510d02c4dab","d175d3e545174628b8f6eee845d8ece32fc738a19352f24cd49c6bba154bf11f","41ef72a5539ce92d8382c3180c6739c395b08c6637dfbabf2c8757457eec7a65","ea4c1a57b31987c0a75c89f7eb4a6d5cb9060159c15a7a230aa898fd9946d97b","31a1230ef119d4275df8f6f9e92e2525e48a3e603ba7e6e0efd1e3c24fcd298f","ee6094fa93710c7695e2e506518c7f2d6023787fd2c674d655ad21efd1a8c7b1","bcf50e137658df16787db58b772c52ece0dd3889d081fbcb9f88d56518754545","8350c6b41532ac1af981e44606fb8c28e0f5dbede019f6a9926ae8d841e75e08","63f83f8e27a5094d552759fff64967b468950d8785591634fee48609afd116da","c56251b44ffbf8de74b52b02e1a891699a8f9d8f579caaede83e145b291f79ac","de6ce26833e243cff67e7a2e7cdbc47a9ccb8746b8b26284941240caf7954d05","3a5fb2541c4c9a57f42956d7414be56310bc619e7a0ed08d1eca0226a3606089","dabedef113c078d772d9028a54ca0e505d8a042fe3aaf4b3d5fef5a047aff313","73ea5f38eb2aabe77d8a1b916907fc9795b7ad34c0cf4ed0b8a23b325fe8e587","9cdc4d1fe00e971bef211a32e190c3bec85079c145dd39c7693e5c211cd64faa","bdbf68f1e89fee5227a3dafd829377ed91532b7a7f3c5ac3904313e903e1ec5a","765aaccdb4479d9026a58b222aec1d7b91471694e72c748dddbfe671fc0c7396","e73bad4dec481e17b3a9df143d21b7088158fb8a97a0b75b56a16dfc6bae3e9c","9ff381762ad8892af515de9d3cea5a0321684b775607151a67f1e3d3c58f0807","2e2d01f2a120338369f415ac4114e3b5bb582d53753b6ddd7a507949365fd52d","a3c8f6e649be4970d53e7397fb349929f801e721fa60a686db42aaeed63ae6f5","a781575cb7dd890174b98f7ca1cc0a05b30b0ca2942952a91f02bf1fb5510482","a9803c2b2fea04977b6ec3b40405c5703aa5ad8bfd7cbb82cfe74449318097da","4091bc6dff1d1d5aeee2631224e9770fbe56b6918d5eb1b85057e858b8a7c58c"],"paragraph_range_zero_based":[240,263],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313652.zip::R2-2313652 TEI18 SDT_ReleaseEnh 38331 CR.docx:p240"}
{"fields":{"filename":"R2-2313652.zip::R2-2313652 TEI18 SDT_ReleaseEnh 38331 CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>set the variable pendingRNA-Update to true;","paragraph_zero_based":264},{"literal_text_all_w_t_and_m_t":"4>the procedure ends;","paragraph_zero_based":265},{"literal_text_all_w_t_and_m_t":"NOTE 2:In case the L2 U2N Relay UE initiates RRC connection resume triggered by reception of message from a L2 U2N Remote UE via SL-RLC0 or SL-RLC1 as specified in 5.3.13.1a, the L2 U2N Relay UE sets the resumeCause by implementation, but it can only set the emergency, mps-PriorityAccess, or mcs-PriorityAccess as resumeCause, if the same cause value in the message received from the L2 U2N Remote UE via SL-RLC0.","paragraph_zero_based":266},{"literal_text_all_w_t_and_m_t":"1>if the UE is in NE-DC or NR-DC:","paragraph_zero_based":267},{"literal_text_all_w_t_and_m_t":"2>if the UE does not support maintaining SCG configuration upon connection resumption:","paragraph_zero_based":268},{"literal_text_all_w_t_and_m_t":"3>release the MR-DC related configurations (i.e., as specified in 5.3.5.10) from the UE Inactive AS context, if stored;","paragraph_zero_based":269},{"literal_text_all_w_t_and_m_t":"1>if the UE does not support maintaining the MCG SCell configurations upon connection resumption:","paragraph_zero_based":270},{"literal_text_all_w_t_and_m_t":"2>release the MCG SCell(s) from the UE Inactive AS context, if stored;","paragraph_zero_based":271},{"literal_text_all_w_t_and_m_t":"1>if the UE is acting as L2 U2N Remote UE:","paragraph_zero_based":272},{"literal_text_all_w_t_and_m_t":"2>establish a SRAP entity as specified in TS 38.351 [66], if no SRAP entity has been established;","paragraph_zero_based":273},{"literal_text_all_w_t_and_m_t":"2>apply the default configuration of SL-RLC1 as defined in 9.2.4 for SRB1;","paragraph_zero_based":274},{"literal_text_all_w_t_and_m_t":"2>apply the default PDCP configuration as defined in 9.2.1 for SRB1;","paragraph_zero_based":275},{"literal_text_all_w_t_and_m_t":"2>apply the default configuration of SRAP as defined in 9.2.5 for SRB1;","paragraph_zero_based":276},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":277},{"literal_text_all_w_t_and_m_t":"2>apply the default L1 parameter values as specified in corresponding physical layer specifications, except for the parameters for which values are provided in SIB1;","paragraph_zero_based":278},{"literal_text_all_w_t_and_m_t":"2>apply the default SRB1 configuration as specified in 9.2.1;","paragraph_zero_based":279},{"literal_text_all_w_t_and_m_t":"2>apply the default MAC Cell Group configuration as specified in 9.2.2;","paragraph_zero_based":280},{"literal_text_all_w_t_and_m_t":"1>release delayBudgetReportingConfig from the UE Inactive AS context, if stored;","paragraph_zero_based":281},{"literal_text_all_w_t_and_m_t":"1>stop timer T342, if running;","paragraph_zero_based":282},{"literal_text_all_w_t_and_m_t":"1>release overheatingAssistanceConfig from the UE Inactive AS context, if stored;","paragraph_zero_based":283},{"literal_text_all_w_t_and_m_t":"1>stop timer T345, if running;","paragraph_zero_based":284},{"literal_text_all_w_t_and_m_t":"1>release idc-AssistanceConfig from the UE Inactive AS context, if stored;","paragraph_zero_based":285},{"literal_text_all_w_t_and_m_t":"1>release drx-PreferenceConfig for all configured cell groups from the UE Inactive AS context, if stored;","paragraph_zero_based":286},{"literal_text_all_w_t_and_m_t":"1>stop all instances of timer T346a, if running;","paragraph_zero_based":287}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"17bfba3da8c3743440a94764df1dd7e80753d504abfaf5e795d5a1c67c51ffac","original_member_sha256":"812d8433d8c47117aecae37ff5db028576123736cb57689623cc95ade6d2faf9","paragraph