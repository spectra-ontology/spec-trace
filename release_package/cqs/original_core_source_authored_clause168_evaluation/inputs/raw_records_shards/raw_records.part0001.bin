{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-SIB4-STOP","paragraph_zero_based":13176},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":13177},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13178},{"literal_text_all_w_t_and_m_t":"SIB4 field descriptions","paragraph_zero_based":13179},{"literal_text_all_w_t_and_m_t":"absThreshSS-BlocksConsolidation","paragraph_zero_based":13180},{"literal_text_all_w_t_and_m_t":"Threshold for consolidation of L1 measurements per RS index. If the field is absent, the UE uses the measurement quantity as specified in TS 38.304 [20].","paragraph_zero_based":13181},{"literal_text_all_w_t_and_m_t":"channelAccessMode2","paragraph_zero_based":13182},{"literal_text_all_w_t_and_m_t":"If present, this field indicates that the neighbor cells on the inter-frequency apply channel access mode procedures for operation with shared spectrum channel access in accordance with TS 37.213 [48], clause 4.4 for FR2-2. If absent, the neighbor cells on the inter-frequency do not apply any channel access procedure.","paragraph_zero_based":13183},{"literal_text_all_w_t_and_m_t":"deriveSSB-IndexFromCell","paragraph_zero_based":13184},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE may use the timing of any detected cell on that frequency to derive the SSB index of all neighbour cells on that frequency. If this field is set to true, the UE assumes SFN and frame boundary alignment across cells on the neighbor frequency as specified in TS 38.133 [14].","paragraph_zero_based":13185},{"literal_text_all_w_t_and_m_t":"dl-CarrierFreq","paragraph_zero_based":13186},{"literal_text_all_w_t_and_m_t":"This field indicates center frequency of the SS block of the neighbour cells, where the frequency corresponds to a GSCN value as specified in TS 38.101-1 [15] or TS 38.101-5 [75].","paragraph_zero_based":13187},{"literal_text_all_w_t_and_m_t":"frequencyBandList","paragraph_zero_based":13188},{"literal_text_all_w_t_and_m_t":"Indicates the list of frequency bands for which the NR cell reselection parameters apply.","paragraph_zero_based":13189},{"literal_text_all_w_t_and_m_t":"highSpeedMeasInterFreq","paragraph_zero_based":13190},{"literal_text_all_w_t_and_m_t":"If the field is set to true and UE supports high speed inter-frequency IDLE/INACTIVE measurements, the UE shall apply the enhanced inter-frequency RRM requirements on the inter-frequency carrier to support high speed up to 500 km/h in RRC_IDLE/RRC_INACTIVE as specified in TS 38.133 [14].","paragraph_zero_based":13191},{"literal_text_all_w_t_and_m_t":"interFreqAllowedCellList","paragraph_zero_based":13192},{"literal_text_all_w_t_and_m_t":"List of allow-listed inter-frequency neighbouring cells, see TS 38.304 [20], clause 5.2.4.","paragraph_zero_based":13193},{"literal_text_all_w_t_and_m_t":"interFreqCAG-CellList","paragraph_zero_based":13194},{"literal_text_all_w_t_and_m_t":"List of inter-frequency neighbouring CAG cells (as defined in TS 38.304 [20] per PLMN.","paragraph_zero_based":13195},{"literal_text_all_w_t_and_m_t":"interFreqCarrierFreqList","paragraph_zero_based":13196},{"literal_text_all_w_t_and_m_t":"List of neighbouring carrier frequencies and frequency specific cell re-selection information. If interFreqCarrierFreqList-v1610, interFreqCarrierFreqList-v1700, interFreqCarrierFreqList-v1720, interFreqCarrierFreqList-v1730 or interFreqCarrierFreqList-v1760 are present, they shall contain the same number of entries, listed in the same order as in interFreqCarrierFreqList (without suffix).","paragraph_zero_based":13197},{"literal_text_all_w_t_and_m_t":"interFreqExcludedCellList","paragraph_zero_based":13198},{"literal_text_all_w_t_and_m_t":"List of exclude-listed inter-frequency neighbouring cells.","paragraph_zero_based":13199}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["cbf10bd894491497484f71ec267152b664595650fbd0f68d2abb1114cbbda3bd","af1e8542dca6e36bc8be2d011ae302c5b5939c3889dd2178cb05410b9a1ab08d","bcdf9ddc7f5aa24aa71394af65e8c7e187d5acb1fd5361a25a0a9f71c962b6bd","725ddd2a408ce01b61c730c762db86ad3b0f0acad937578d984bdfda7489042d","7a526a0894d2042207a17154232b4b964744acd580a5ac935252161b19185a81","0112d6f20f8d780cc0c95f92dafc53373b85b0616328954b4dc4e699ee727e1b","22e4a147873af0176c4025b7ce4d3681cb956654be9324ec9dd4f2b8dea35f3e","83fc70c14d18f5b5aa8b5ac5bfe0cc903df5ace295bdceb4e13d777037938b3b","ca83d769497ad9ee1a1887a9ddd62d9cc2a522b42e656e9586d3a5c623f223f8","7eef4b6a1eb6d482d3d363d7159c9fdb6e480fa9acd8ae1784e6a9f3020db256","3b0cdcd7d9374d3b2fce923ab771eb71f0deeba90c6193e8431e37da76f48657","df33548c276500d50e05d2b0c752debfb9fda6123fa7b9c5da1a749fc816b019","7483f1dc3c06ccde45577017bd27df2407df749a6595db5c3808b22d29b51ffc","55303192af897b9ddfe12f250aca6e52d8d35274d16ff32056af61cfaea7756b","c0e37f6aac8e086856424762a2b2a2b8a7e0471f1c1a4f4eb1ee6aaad315912e","0dcbaed60403494eb4db877724ed2e5f599c82682b3eac8861c1af3fa2dd14e5","4b10b760e50e810014f361cdea2f1b8e2376ea03e15d867a19d8092f5a2d1bf8","ca8ad345150d17fd92a1dad961cff66fe214a2849202bf36585f1c2da5fb6646","a804bf43605b91223abfaae495100720b4accade87dade87146cc6a8c0b46665","2d1fd07783a61eefdf6da7a06c78d9207a2ce9408811202813097cc13a2b4772","05099046693cfaebcb864f9313102c0966a3052eebbbf1e57b7d229ed789994e","05ca6b41c27bc97714e65af014fda1024cf9f1372d7dac435c3fda3ca387e89e","6640529eb2f2262f4818faa1f08bd5937f2fe55d9a6c377104ea247dd1c05622","faa718a9235584847011480618af2b655cabc2a3713230898582f8df654d8631"],"paragraph_range_zero_based":[13176,13199],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p13176"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"interFreqNeighCellList","paragraph_zero_based":13200},{"literal_text_all_w_t_and_m_t":"List of inter-frequency neighbouring cells with specific cell re-selection parameters. If interFreqNeighCellList-v1610 is present, it shall contain the same number of entries, listed in the same order as in interFreqNeighCellList (without suffix).","paragraph_zero_based":13201},{"literal_text_all_w_t_and_m_t":"interFreqNeighHSDN-CellList","paragraph_zero_based":13202},{"literal_text_all_w_t_and_m_t":"List of inter-frequency neighbouring HSDN cells as specified in TS 38.304 [20].","paragraph_zero_based":13203},{"literal_text_all_w_t_and_m_t":"nrofSS-BlocksToAverage","paragraph_zero_based":13204},{"literal_text_all_w_t_and_m_t":"Number of SS blocks to average for cell measurement derivation. If the field is absent, the UE uses the measurement quantity as specified in TS 38.304 [20].","paragraph_zero_based":13205},{"literal_text_all_w_t_and_m_t":"p-Max","paragraph_zero_based":13206},{"literal_text_all_w_t_and_m_t":"Value in dBm applicable for the neighbouring NR cells on this carrier frequency. If absent the UE applies the maximum power according to TS 38.101-1 [15] in case of an FR1 cell, TS 38.101-2 [39] in case of an FR2 cell or TS 38.101-5 [75] in case of an NTN cell. In this release of the specification, if p-Max is present on a carrier frequency in FR2, the UE shall ignore the field and applies the maximum power according to TS 38.101-2 [39]. This field is ignored by IAB-MT. The IAB-MT applies output power and emissions requirements, as specified in TS 38.174 [63].","paragraph_zero_based":13207},{"literal_text_all_w_t_and_m_t":"q-OffsetCell","paragraph_zero_based":13208},{"literal_text_all_w_t_and_m_t":"Parameter \"Qoffsets,n\" in TS 38.304 [20].","paragraph_zero_based":13209},{"literal_text_all_w_t_and_m_t":"q-OffsetFreq","paragraph_zero_based":13210},{"literal_text_all_w_t_and_m_t":"Parameter \"Qoffsetfrequency\" in TS 38.304 [20].","paragraph_zero_based":13211},{"literal_text_all_w_t_and_m_t":"q-QualMin","paragraph_zero_based":13212},{"literal_text_all_w_t_and_m_t":"Parameter \"Qqualmin\" in TS 38.304 [20]. If the field is absent, the UE applies the (default) value of negative infinity for Qqualmin.","paragraph_zero_based":13213},{"literal_text_all_w_t_and_m_t":"q-QualMinOffsetCell","paragraph_zero_based":13214},{"literal_text_all_w_t_and_m_t":"Parameter \"Qqualminoffsetcell\" in TS 38.304 [20]. Actual value Qqualminoffsetcell = field value [dB].","paragraph_zero_based":13215},{"literal_text_all_w_t_and_m_t":"q-RxLevMin","paragraph_zero_based":13216},{"literal_text_all_w_t_and_m_t":"Parameter \"Qrxlevmin\" in TS 38.304 [20].","paragraph_zero_based":13217},{"literal_text_all_w_t_and_m_t":"q-RxLevMinOffsetCell","paragraph_zero_based":13218},{"literal_text_all_w_t_and_m_t":"Parameter \"Qrxlevminoffsetcell\" in TS 38.304 [20]. Actual value Qrxlevminoffsetcell = field value * 2 [dB].","paragraph_zero_based":13219},{"literal_text_all_w_t_and_m_t":"q-RxLevMinOffsetCellSUL","paragraph_zero_based":13220},{"literal_text_all_w_t_and_m_t":"Parameter \"QrxlevminoffsetcellSUL\" in TS 38.304 [20]. Actual value QrxlevminoffsetcellSUL = field value * 2 [dB].","paragraph_zero_based":13221},{"literal_text_all_w_t_and_m_t":"q-RxLevMinSUL","paragraph_zero_based":13222},{"literal_text_all_w_t_and_m_t":"Parameter \"Qrxlevmin\" in TS 38.304 [20].","paragraph_zero_based":13223}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["c107c3cd6c63d76ce95156065ce561492bd13562a2d4980d348f2a80d0afc12d","34b1d724146db6d5b6dcdaba16971245e9c4b8ec5ef11e976ef66958f0d9d471","1eec0bb57365eb5be50fb4fd95445f6d5a730837a8c5cd9419e767f33a70c76c","196e8e1d8dd2a8b25b8d846fce1941b6b307e9aae154432bb24267af98a1d2e7","d3da857bfaeef2dec5ef675de181362e17789326177c180ee89efb99ac13be83","5c83cf98c5e27def5c210b015284dcc1cf27c353b7d26fe36cafbfce06123168","6f236ef31241979fcbde0d7b43bbdec808c749cb8fe0965a00da4f1c76275e54","6ae4ffa4c05bb07ddb1fe6c4aaa7bcf4b312167c2c64e47a311e4851dcca8f3e","5035adddafcac5a05cf27689de7e0d403169e0a70ad257243076656cbd42a90f","7b12914fdcad321815e90b3e97dcfb63c52d1ccd1ea659201c9dfb742c35d04b","e8e7e4b14307d076a3e74307f524de88fb5aaa646e0bf00695c1415576cffbd0","4056745f59971811db7c921017d4c9a48c28cfdc430cb2993a00648971d35d85","e8ff24e1f9e4ff5a02b6616a7999e6a1c6bb32fbd3eb3bd59ada687ece9c8961","852cd84eb9149cb6bfc107db9d7c24507d001b18f60d8236322d9ae74ec95d5b","3f5639b244dbc0b7be28bddb31911c941d3bd7e9fe59bd68a03be9aef8e5b97b","a3d064ad02405c1438c5ddb1de0b964d19d6699094a3acb208833d8496f659f4","61bba508fef69b9144edfbf281efd5ee61c213d09fdba5efce597cc582731d70","dfd7e0fce9f53454a00467f86a4476d8a7725c01bbe2e2c0d5ac4f365e758aac","d5c5241c5c0b9c2a3016b6eba2400785f38e7258b371ec016a3dec3fc53bc4f7","bf02b705aff185f94e86b0e9473c975a040c7d4e6fed0707bcdaa5afd44eb694","a8aca073d10dbe90c99bc26ff2cded52e33853dde7b73008bcfc8e6bfbba2b75","42ac4ae042da67ffbfe64a81bfa346b8c4a7291848e7c057734789ba92f14eb4","245996701b91141d78c952e711905fdfd77a4bcde0a2f90ef256c30c543b078e","611bce155945efdef7a687843492e19202c88fadba9b70e7d2e7a4790e0db662"],"paragraph_range_zero_based":[13200,13223],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p13200"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"redCapAccessAllowed","paragraph_zero_based":13224},{"literal_text_all_w_t_and_m_t":"Indicates whether RedCap UEs are allowed to access the frequency.","paragraph_zero_based":13225},{"literal_text_all_w_t_and_m_t":"smtc","paragraph_zero_based":13226},{"literal_text_all_w_t_and_m_t":"Measurement timing configuration for inter-frequency measurement. If this field is absent, the UE assumes that SSB periodicity is 5 ms in this frequency. If the field is broadcast by an NTN cell, the offset (derived from parameter periodicityAndOffset) is based on the assumption that the gNB-UE propagation delay difference between the serving cell and neighbour cells equals to 0 ms, and UE can adjust the actual offset based on the actual propagation delay difference.","paragraph_zero_based":13227},{"literal_text_all_w_t_and_m_t":"smtc2-LP","paragraph_zero_based":13228},{"literal_text_all_w_t_and_m_t":"Measurement timing configuration for inter-frequency neighbour cells with a Long Periodicity (LP) indicated by periodicity in smtc2-LP. The timing offset and duration are equal to the offset and duration indicated in smtc in InterFreqCarrierFreqInfo. The periodicity in smtc2-LP can only be set to a value strictly larger than the periodicity in smtc in InterFreqCarrierFreqInfo (e.g. if smtc indicates sf20 the Long Periodicity can only be set to sf40, sf80 or sf160, if smtc indicates sf160, smtc2-LP cannot be configured). The pci-List, if present, includes the physical cell identities of the inter-frequency neighbour cells with Long Periodicity. If smtc2-LP is absent, the UE assumes that there are no inter-frequency neighbour cells with a Long Periodicity.","paragraph_zero_based":13229},{"literal_text_all_w_t_and_m_t":"smtc4list","paragraph_zero_based":13230},{"literal_text_all_w_t_and_m_t":"Measurement timing configuration list for NTN deployments, see clause 5.5.2.10. The offset of each SSB-MTC4 in smtc4list is based on the assumption that the gNB-UE propagation delay difference between the serving cell and neighbour cells equals to 0 ms, and UE can adjust the actual offset based on the actual propagation delay difference. For a UE that supports less SMTCs than what is included in this list, it is up to the UE to select which SMTCs to consider.","paragraph_zero_based":13231},{"literal_text_all_w_t_and_m_t":"ssb-PositionQCL","paragraph_zero_based":13232},{"literal_text_all_w_t_and_m_t":"Indicates the QCL relation between SS/PBCH blocks for a specific neighbor cell as specified in TS 38.213 [13], clause 4.1. If provided, the cell specific value overwrites the common value signalled by ssb-PositionQCL-Common in SIB4 for the indicated cell.","paragraph_zero_based":13233},{"literal_text_all_w_t_and_m_t":"ssb-PositionQCL-Common","paragraph_zero_based":13234},{"literal_text_all_w_t_and_m_t":"Indicates the QCL relation between SS/PBCH blocks for inter-frequency neighbor cells as specified in TS 38.213 [13], clause 4.1.","paragraph_zero_based":13235},{"literal_text_all_w_t_and_m_t":"ssb-ToMeasure","paragraph_zero_based":13236},{"literal_text_all_w_t_and_m_t":"The set of SS blocks to be measured within the SMTC measurement duration (see TS 38.215 [9]). When the field is absent the UE measures on all SS-blocks.","paragraph_zero_based":13237},{"literal_text_all_w_t_and_m_t":"ssbSubcarrierSpacing","paragraph_zero_based":13238},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing of SSB.","paragraph_zero_based":13239},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":13240},{"literal_text_all_w_t_and_m_t":"FR1:    15 or 30 kHz","paragraph_zero_based":13241},{"literal_text_all_w_t_and_m_t":"FR2-1:  120 or 240 kHz","paragraph_zero_based":13242},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":13243},{"literal_text_all_w_t_and_m_t":"threshX-HighP","paragraph_zero_based":13244},{"literal_text_all_w_t_and_m_t":"Parameter \"ThreshX, HighP\" in TS 38.304 [20].","paragraph_zero_based":13245},{"literal_text_all_w_t_and_m_t":"threshX-HighQ","paragraph_zero_based":13246},{"literal_text_all_w_t_and_m_t":"Parameter \"ThreshX, HighQ\" in TS 38.304 [20].","paragraph_zero_based":13247}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["84c690394295be50288e2bcc3ba5adb932fb3ab78c35e64931d0f72c8b42f13a","22c71a0494aa1b51867429c45a49dbc8b207fc35a62a12f4285a9ae8d7dabea4","d9b59097ade9b27c5011035a3f4c43e80bd20b1f64a7b4bbe20ef2f395ee6178","fd4e3dc876df24b3b3f76cae25cb9f7be834aec56b33fff49f5104d5791f493f","8a142a40cbe34fec1051d3c4f975b5d05ffcdf62435e87695cc11f8856752933","1215d7bb331689ae184c93f50df1e4a9e0929424074cda4e1d6d200da4db8152","fd8f07c095cb82d3dfaa43c8afbdb833fe3b883acdb0315fd16e2af0e742bf2c","8791f76cc44c53cffb7a563c59a7422af7e8f4275609b8b42764410fa14736f5","c7915e5c9323cbeab5248125b35fb962f382e2dde46a7db29b9b49b080bdf9e6","88c48555a09ae90169ca1b7bfa008bd7b09f300219f1121ddeda17a37b3fa840","a32d2ad32c44ec06558d93c53b4b7c78712cea1b58498a2c187bd49b20b67d50","da1898c371e6916268d68e89514c720c4857db60fdb88295088973afc7e354c3","d4bca1701aae6aa0b8b85ee228e0c8ca7038bc06194e63902349ceb6b07e54cc","c96b109275dd543168e7785a3ed455613f3e2891fc6a60a6687485d1943ff84c","9507679b632de6c9a299c60974f9ceb5a906e697030984fed9494975f14ab156","a5be4be737faf5ef4ad6057f2ce657a7059fb9b53d1417a851b1d4b57e5bb3f0","a0e4fcf424f6ad51d26ee7bb526a55878acfd11c7a3c459c103d45e08a34c2b8","b60b2a15d2a2f75baabfddaf91c763fc8897046f3fee8be3a474459baceef463","4479cb79a6a5ee98dba6777df5c8fd117470bad52f35fdaaa130405cbc1faeea","90163d862cc95841199c3dadd11e9119d4afc1be87ae41b2183368b7c346cd30","c319b8a4c34c8ca278d9112b3d9402731191296065eb62b8da47c9e6475882db","cbc6050da39bd857866b44742f3d0f05b2b0f07d719f469534948ce686d8826d","e65f1d1d471397563f6db43713773818fb4455e57f78a03a5dd582653563ffdf","88f6e050ab83dd50739b1a8091138e608936359af8ad8536ca534c3bf770eb24"],"paragraph_range_zero_based":[13224,13247],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p13224"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"threshX-LowP","paragraph_zero_based":13248},{"literal_text_all_w_t_and_m_t":"Parameter \"ThreshX, LowP\" in TS 38.304 [20].","paragraph_zero_based":13249},{"literal_text_all_w_t_and_m_t":"threshX-LowQ","paragraph_zero_based":13250},{"literal_text_all_w_t_and_m_t":"Parameter \"ThreshX, LowQ\" in TS 38.304 [20].","paragraph_zero_based":13251},{"literal_text_all_w_t_and_m_t":"t-ReselectionNR","paragraph_zero_based":13252},{"literal_text_all_w_t_and_m_t":"Parameter \"TreselectionNR\" in TS 38.304 [20].","paragraph_zero_based":13253},{"literal_text_all_w_t_and_m_t":"t-ReselectionNR-SF","paragraph_zero_based":13254},{"literal_text_all_w_t_and_m_t":"Parameter \"Speed dependent ScalingFactor for TreselectionNR\" in TS 38.304 [20]. If the field is absent, the UE behaviour is specified in TS 38.304 [20].","paragraph_zero_based":13255},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13256},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":13257},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":13258},{"literal_text_all_w_t_and_m_t":"Mandatory","paragraph_zero_based":13259},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in SIB4.","paragraph_zero_based":13260},{"literal_text_all_w_t_and_m_t":"RSRQ","paragraph_zero_based":13261},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if threshServingLowQ is present in SIB2; otherwise it is absent.","paragraph_zero_based":13262},{"literal_text_all_w_t_and_m_t":"SharedSpectrum","paragraph_zero_based":13263},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if this inter-frequency operates with shared spectrum channel access. Otherwise, it is absent, Need R.","paragraph_zero_based":13264},{"literal_text_all_w_t_and_m_t":"SharedSpectrum2","paragraph_zero_based":13265},{"literal_text_all_w_t_and_m_t":"The field is optional present, Need R, if this inter-frequency or neighbor cell operates with shared spectrum channel access. Otherwise, it is absent, Need R.","paragraph_zero_based":13266},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13267},{"literal_text_all_w_t_and_m_t":"–SIB5","paragraph_zero_based":13268},{"literal_text_all_w_t_and_m_t":"SIB5 contains information relevant only for inter-RAT cell re-selection i.e. information about E-UTRA frequencies and E-UTRAs neighbouring cells relevant for cell re-selection. The IE includes cell re-selection parameters common for a frequency.","paragraph_zero_based":13269},{"literal_text_all_w_t_and_m_t":"SIB5 information element","paragraph_zero_based":13270},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":13271}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["a092b4c9071bd586453ed5783aa34ffdb5a86861a2ccb29d441ecdb1476f8ae7","e6272ed6fcbdbbdc87df7b8b82ebe54d72bb2e3e8fe59d9f979a9c3a2661ff9c","6b5892760d2d8af82eb5976e19b824835d208b962a2abd3409a5ebe644d7360b","86605d67bbaac7c254b52aa97eeb8b20c306805a386f5e4ee6fac5847f9083a2","82f4e09cda07790c12b0c9f7c9f64b20e5c8d587ba8944974acf605b3634850e","e4f220a4e8d77a782bd2f274362f3685b10330ef3a5f2c54c6e9d2ac5e801654","31bf5586884f9cb451c68b0a8d1590d95787593debdcd672074f0142ed63dfa7","a15fede35940454e30196ffe1b87282d69af495ecc7241b9c9e8cf510c05642d","e6fbb3d9ae7a7c4a8b803099818fc820bde02d145c49a3d9c08dc10d9066e8bb","9fffada0200e36ef9e1149f7d4c00c0f9093c06f41b98462a5a0e4222ee4ede8","9bf0289e4a8cb1f8b61e1137eea7d53c915092709bac92673cfe2606aca9a927","190a579751abd18bdca0be0c7bd8cc4870a2b2c4a64