{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29712},{"literal_text_all_w_t_and_m_t":"–TDD-UL-DL-ConfigCommon","paragraph_zero_based":29713},{"literal_text_all_w_t_and_m_t":"The IE TDD-UL-DL-ConfigCommon determines the cell specific Uplink/Downlink TDD configuration.","paragraph_zero_based":29714},{"literal_text_all_w_t_and_m_t":"TDD-UL-DL-ConfigCommon information element","paragraph_zero_based":29715},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29716},{"literal_text_all_w_t_and_m_t":"-- TAG-TDD-UL-DL-CONFIGCOMMON-START","paragraph_zero_based":29717},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29718},{"literal_text_all_w_t_and_m_t":"TDD-UL-DL-ConfigCommon ::=          SEQUENCE {","paragraph_zero_based":29719},{"literal_text_all_w_t_and_m_t":"    referenceSubcarrierSpacing          SubcarrierSpacing,","paragraph_zero_based":29720},{"literal_text_all_w_t_and_m_t":"    pattern1                            TDD-UL-DL-Pattern,","paragraph_zero_based":29721},{"literal_text_all_w_t_and_m_t":"    pattern2                            TDD-UL-DL-Pattern                                                       OPTIONAL, -- Need R","paragraph_zero_based":29722},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":29723},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29724},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29725},{"literal_text_all_w_t_and_m_t":"TDD-UL-DL-Pattern ::=               SEQUENCE {","paragraph_zero_based":29726},{"literal_text_all_w_t_and_m_t":"    dl-UL-TransmissionPeriodicity       ENUMERATED {ms0p5, ms0p625, ms1, ms1p25, ms2, ms2p5, ms5, ms10},","paragraph_zero_based":29727},{"literal_text_all_w_t_and_m_t":"    nrofDownlinkSlots                   INTEGER (0..maxNrofSlots),","paragraph_zero_based":29728},{"literal_text_all_w_t_and_m_t":"    nrofDownlinkSymbols                 INTEGER (0..maxNrofSymbols-1),","paragraph_zero_based":29729},{"literal_text_all_w_t_and_m_t":"    nrofUplinkSlots                     INTEGER (0..maxNrofSlots),","paragraph_zero_based":29730},{"literal_text_all_w_t_and_m_t":"    nrofUplinkSymbols                   INTEGER (0..maxNrofSymbols-1),","paragraph_zero_based":29731},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":29732},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":29733},{"literal_text_all_w_t_and_m_t":"    dl-UL-TransmissionPeriodicity-v1530     ENUMERATED {ms3, ms4}                                               OPTIONAL -- Need R","paragraph_zero_based":29734},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":29735}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["5d953e1e30026d0adbc3149e6b5760a183725ee20650996e6f8522810f1dee4c","93feb1a650cde3ea4f6a68464464219cc790b34d2dcee9b7089b97da2af02737","71142c2d9e076d54085c6650484e7820dd7aa44f2d7b17c27a344948ce7f3253","44f9956bb5066775d42f1825e176d7331ef763bb7a62db05110c55883127067f","ca2cfb470ec200d5209cbb76a406bdf468abd76b2036b4ebed60994f3e1ca0ac","dac926ed885755828283bccfb2ea97f016191200b885e6b6fd8dea26c87e9118","a99d392f5346474c84327f95d78bcf18b5627636f63f271653840469652f72cf","0b0f4a787d1f136fc1de9a3b86c86da8eb179867c48004dd96f0ccbe99e60eab","42b2e6739f646e4907f11c3ad6b88006dd8136c108c61670d0160ad7971183fb","5f78bcb79f9a9c40aaba0c866d75140c1dcba9a23955749531638a984e621483","f21f0eec51d34e02fd066b2d2fce2b6046f5f6573cad8e1c2b46885c97f556ee","568d9ecf65d0bff0784768c92190c736a39cdb9096a4ecbad579da4080357217","981a724df5aad406e40e1eee0c011cad2bc1d36d22ee410ab638aa75277f526f","40bdecdd7f83de5865d99010cfba3ccccaec4850ac6672ad63f86c42d31f59e8","92d61fd5ffe91b95b4458533d295786d8fc2250e2a5a96095080cfb460542e52","13b8c552ff378b7aa27f3b9397fc22fdc5b6f0c95cd83266eb428e9b67862153","909b8fefad2e0a361c00e387225670378ad349d866bd3d94909cae8af82fc56b","2bf012e59aef64b7cdd3a12305459794a2a2429a0d7192ae377c35a1c0c2f296","9bd5788c7a9ba0d6c557469af019c35ddaa1f5b43277fa996e8f45a6c70f7928","4c7e5b6a26574f477cbe5b26db5e2bbb211b6d93d7e91b09f78786c7e26c4a36","d9d6403799faec94a130b8c56b4117747952012d974f427511536d68ee84d06b","e56deaf413b973f5f15159ad3428bf4585437f4931d765db410d591f9aa53d20","c389e165c7f2321c988e9683fc308bdd8f5baedf0ec7842476d320655c1dd523","710d3f31aed3bf32b0987c6ac3c1547745a8a8fc5be1e39bc4b4fcfcd6609d07"],"paragraph_range_zero_based":[29712,29735],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p29712"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29736},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29737},{"literal_text_all_w_t_and_m_t":"-- TAG-TDD-UL-DL-CONFIGCOMMON-STOP","paragraph_zero_based":29738},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29739},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29740},{"literal_text_all_w_t_and_m_t":"TDD-UL-DL-ConfigCommon field descriptions","paragraph_zero_based":29741},{"literal_text_all_w_t_and_m_t":"referenceSubcarrierSpacing","paragraph_zero_based":29742},{"literal_text_all_w_t_and_m_t":"Reference SCS used to determine the time domain boundaries in the UL-DL pattern which must be common across all subcarrier specific carriers, i.e., independent of the actual subcarrier spacing using for data transmission.","paragraph_zero_based":29743},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":29744},{"literal_text_all_w_t_and_m_t":"FR1:    15, 30, or 60 kHz","paragraph_zero_based":29745},{"literal_text_all_w_t_and_m_t":"FR2-1:  60 or 120 kHz","paragraph_zero_based":29746},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":29747},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29748},{"literal_text_all_w_t_and_m_t":"The network configures a not larger than any SCS of configured BWPs for the serving cell. The network or SL-PreconfigGeneral configures a not larger than the SCS of (pre-)configured SL BWP.See TS 38.213 [13], clause 11.1.","paragraph_zero_based":29749},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29750},{"literal_text_all_w_t_and_m_t":"TDD-UL-DL-Pattern field descriptions","paragraph_zero_based":29751},{"literal_text_all_w_t_and_m_t":"dl-UL-TransmissionPeriodicity","paragraph_zero_based":29752},{"literal_text_all_w_t_and_m_t":"Periodicity of the DL-UL pattern, see TS 38.213 [13], clause 11.1. If the dl-UL-TransmissionPeriodicity-v1530 is signalled, UE shall ignore the dl-UL-TransmissionPeriodicity (without suffix).","paragraph_zero_based":29753},{"literal_text_all_w_t_and_m_t":"nrofDownlinkSlots","paragraph_zero_based":29754},{"literal_text_all_w_t_and_m_t":"Number of consecutive full DL slots at the beginning of each DL-UL pattern, see TS 38.213 [13], clause 11.1. In this release, the maximum value for this field is 320.","paragraph_zero_based":29755},{"literal_text_all_w_t_and_m_t":"nrofDownlinkSymbols","paragraph_zero_based":29756},{"literal_text_all_w_t_and_m_t":"Number of consecutive DL symbols in the beginning of the slot following the last full DL slot (as derived from nrofDownlinkSlots). The value 0 indicates that there is no partial-downlink slot. (see TS 38.213 [13], clause 11.1).","paragraph_zero_based":29757},{"literal_text_all_w_t_and_m_t":"nrofUplinkSlots","paragraph_zero_based":29758},{"literal_text_all_w_t_and_m_t":"Number of consecutive full UL slots at the end of each DL-UL pattern, see TS 38.213 [13], clause 11.1. In this release, the maximum value for this field is 320.","paragraph_zero_based":29759}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["f9e2fc1b5fe71c49c4a5f704f264656c98482ede80e649a0c176df863d1373a1","aa4ce5cf8c858a6ffb6de092c5a6f8040adde1acbd2068ec71d2b8f3457bdc80","3aa830e93d06852aa360443e35838b7746c6a6e7b4a4ee7f693b42ab83fc80cd","907c5ca0e263b6e0b818522bdc4be4a774310e950da021e2cec85b3fc3016c82","b1bd829fcda1a9e64c498cf3c259306f7e93f6adb945a3e57e95fafdb3b14f9e","840c8be163f408cd5e07a56e4a47