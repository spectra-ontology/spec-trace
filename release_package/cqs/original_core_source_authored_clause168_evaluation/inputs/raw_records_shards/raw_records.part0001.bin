{"fields":{"filename":"R2-2314047.zip::R2-2314047.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":240},{"literal_text_all_w_t_and_m_t":"END OF CHANGE","paragraph_zero_based":241},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":242},{"literal_text_all_w_t_and_m_t":"START OF CHANGE","paragraph_zero_based":243},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":244},{"literal_text_all_w_t_and_m_t":"5.3.3.4bReception of the RRCEarlyDataComplete by the UE","paragraph_zero_based":245},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":246},{"literal_text_all_w_t_and_m_t":"1>indicate to upper layers that the RRC connection has been established;","paragraph_zero_based":247},{"literal_text_all_w_t_and_m_t":"1>if stored, discard the cell reselection priority information provided by the idleModeMobilityControlInfo or inherited from another RAT;","paragraph_zero_based":248},{"literal_text_all_w_t_and_m_t":"1>if stored, discard the altFreqPriorities provided by the RRCConnectionRelease;","paragraph_zero_based":249},{"literal_text_all_w_t_and_m_t":"1>if stored, discard the dedicated offset provided by the redirectedCarrierOffsetDedicated;","paragraph_zero_based":250},{"literal_text_all_w_t_and_m_t":"1>stop timer T300;","paragraph_zero_based":251},{"literal_text_all_w_t_and_m_t":"1>stop timer T302, if running;","paragraph_zero_based":252},{"literal_text_all_w_t_and_m_t":"1>stop timer T303, if running;","paragraph_zero_based":253},{"literal_text_all_w_t_and_m_t":"1>stop timer T305, if running;","paragraph_zero_based":254},{"literal_text_all_w_t_and_m_t":"1>stop timer T306, if running;","paragraph_zero_based":255},{"literal_text_all_w_t_and_m_t":"1>stop timer T308, if running;","paragraph_zero_based":256},{"literal_text_all_w_t_and_m_t":"1>perform the actions as specified in 5.3.3.7;","paragraph_zero_based":257},{"literal_text_all_w_t_and_m_t":"1>stop timer T320, if running;","paragraph_zero_based":258},{"literal_text_all_w_t_and_m_t":"1>stop timer T322, if running;","paragraph_zero_based":259},{"literal_text_all_w_t_and_m_t":"1>stop timer T323, if running;","paragraph_zero_based":260},{"literal_text_all_w_t_and_m_t":"1>forward the dedicatedInfoNAS, if received, to the upper layers;","paragraph_zero_based":261},{"literal_text_all_w_t_and_m_t":"1>reset MAC and release the MAC configuration;","paragraph_zero_based":262},{"literal_text_all_w_t_and_m_t":"1>if the RRCEarlyDataComplete message includes redirectedCarrierInfo indicating redirection to geran, utra-FDD or utra-TDD and","paragraph_zero_based":263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"30bab297e2c1559150f28c715187cd2b042427217032b939c40fbda0b98d5d22","original_member_sha256":"cb272e610fd9cd8910cfd70983738fb68760b249a2966dd09d1d153b23cfa274","paragraph_ElementTree_utf8_XML_sha256":["305e553b5bd3ad693392f2cf24c9cc00a0fa0694d643755925aef66e0921608e","99d46b41e261d2aabf0905eaa1ebd5f1a30a9350b251b65eff558866875cc381","e312b4114eb64dce5a5bf5749c771dc14bc3a945573b2bb2174755e550a22d13","fd42dcc480ff33b2979b45b28a9e5ca1f1724e52f879793a9f150449c45eaf93","4b70e882a0655ce9282ff87959ca7e6140968f0033874b952bf951f7e351fd97","bd5838f94ee9d8a4ff1c0ca8c70b8c6dc7c70083f9e0b0e751d1ee5f787bad33","da41c51e91148b33b4001dc054af479cc7bb5647b69534e9f00bf22fb4a5f87a","eac71b225ce7b648e704367be0a947ca45df3a6aed98fa3411a2436729399c08","1fa56a0e9e5ebc33cb260b040dd76499fb273fbedd1c8b1299494fe9d1d47386","c22ba3146661af31fca6a12c7cbb868a39e64190cffedd2ddba3f9735ffd074f","60b3ac3197819f1447a3d1beef4b153ac25838e42ffe5fd2f705f3c2e207d3bd","e5c794cdd54ba7c24b4e3ea926f73ca768653d2d4a802032f179bd2870278d9d","96ace93d257163d0867221b188c9bd2846c89115177b2f6511dc2b8c7dcbb5d8","0b1d13b1a98bf1473eb6fa2835aa3e88ee7054f23077f8a446d00d8adbf8d1cc","5382b438188187fc42eecfb5c5ff4cc0d5ac3fa3d0432046117f388ce2392868","0e8a31839f8954299ea758931efa8521e92d42bf1d2b3753b286d163aa37c77a","8478fbbdd9b1554127f9a74404ac32518738c4ea93084b5c0026ba3493c7c96a","28d4ea662cfaf891f3c2399b0e4522d55a2c9fe6e6810456d7a8ccb73765dc30","98e4514fb0ccfdd1d421f40c136f90822cfdcf4c430cfe47a9822a397ff39c17","10bf65cca21d84676097fd34055081b4479ab5ffa2996d6888e98de20e16b02e","99cd5e1facb1ce02335402812d36205e664149ba92aceb3298578f74311ad290","03fff19f98788cbeedd0274c8604623d732b2c4b17a3901a8228948f97f45e0f","ab7183f18d04f84c2a2c0c6a808c5528da64d2e577f5cf975908abb1e74d457b","277441909338e43851f2a542d92d41c5dc484c87318ee31d3349ca2f84156a7d"],"paragraph_range_zero_based":[240,263],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2314047.zip::R2-2314047.docx:p240"}
{"fields":{"filename":"R2-2314047.zip::R2-2314047.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>if upper layers indicate that redirect to GERAN or UTRAN without AS security is not allowed:","paragraph_zero_based":264},{"literal_text_all_w_t_and_m_t":"2>perform the actions upon leaving RRC_CONNECTED as specified in 5.3.12, with release cause 'other', upon which the procedure ends;","paragraph_zero_based":265},{"literal_text_all_w_t_and_m_t":"1>if the RRCEarlyDataComplete message includes idleModeMobilityControlInfo:","paragraph_zero_based":266},{"literal_text_all_w_t_and_m_t":"2>store the cell reselection priority information provided by the idleModeMobilityControlInfo;","paragraph_zero_based":267},{"literal_text_all_w_t_and_m_t":"2>if the t320 is included:","paragraph_zero_based":268},{"literal_text_all_w_t_and_m_t":"3>start timer T320, with the timer value set according to the value of t320;","paragraph_zero_based":269},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":270},{"literal_text_all_w_t_and_m_t":"2>apply the cell reselection priority information broadcast in the system information;","paragraph_zero_based":271},{"literal_text_all_w_t_and_m_t":"1>for NB-IoT, if the RRCEarlyDataComplete message includes redirectedCarrierInfo:","paragraph_zero_based":272},{"literal_text_all_w_t_and_m_t":"2>if the redirectedCarrierOffsetDedicated is included in the redirectedCarrierInfo:","paragraph_zero_based":273},{"literal_text_all_w_t_and_m_t":"3>store the dedicated offset for the frequency in redirectedCarrierInfo;","paragraph_zero_based":274},{"literal_text_all_w_t_and_m_t":"3>start timer T322, with the timer value set according to the value of T322 in redirectedCarrierInfo;","paragraph_zero_based":275},{"literal_text_all_w_t_and_m_t":"1>if the extendedWaitTime is present; and","paragraph_zero_based":276},{"literal_text_all_w_t_and_m_t":"1>if the UE supports delay tolerant access or the UE is a NB-IoT UE:","paragraph_zero_based":277},{"literal_text_all_w_t_and_m_t":"2>forward the extendedWaitTime to upper layers;","paragraph_zero_based":278},{"literal_text_all_w_t_and_m_t":"1>indicate the release of the RRC connection to upper layers together with the release cause 'other', upon which the procedure ends;","paragraph_zero_based":279},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":280}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"30bab297e2c1559150f28c715187cd2b042427217032b939c40fbda0b98d5d22","original_member_sha256":"cb272e610fd9cd8910cfd70983738fb68760b249a2966dd09d1d153b23cfa274","paragraph_ElementTree_utf8_XML_sha256":["1c0860f260b2b398ca6fdd9ed6b58f9eba5f6cf56cdd65fdbe629e41534f0ec1","1e6678919d82958478d2c27de5bbc301dd151a0d557d589310848a6b2e24cd38","9cd58da64e9dc48878061bc1ca8ae46c7069623dbad6e4640603e150d8c35417","3bcc1d115b13dcc812bf711322801cef12f41dac55a29e4bdb15cf6b24514bf3","c94b73d44e0263b19862fcf929621d179d798d6ee1176edb77f185e28c9113e7","34fcbf74cb0fe474edebd9ab511e0cec9f37b26d950d3d7348192519300e4e1b","ca21d16bc22b11c8b1c64221f44c85bd76cf8311f8b99943ee7899adaf54b0fd","59063775a472bcd8141bae2068ca53f2dc2bf19fd089c76d52fd885fa267daca","29a627a0bbfe56d3d2b287eb704e6707abf69cd9ec75a38144f98ad8729c5b5f","c26f811bee4d766b872132b023247877522067004173768ce6a3648ddb586fec","36a7f60c386820f866f6c40f1ca23b471cdc209f4ae204a47425343b45884d02","7a65d96b5f772ad4235c29d6c3c4ee5f33ea018dec07a3560b613926b6c31e60","061dd56390adeccde51fed720df88b482e203a15f7a8b197064cc19e49419754","c6343397f8f53e118adbf00a3782559413573a5f9b8787ae4ef8316e3b168d97","0c2929a10d808ef3684eb70e9b7c1fd2be36d8d14fe9cfaa740340016b539d92","a052d52d213fc87970260c8d0a5b358ebb6ad606da33f0ab44221e914c96482a","0493bfc7203fc3c7058d71a1e6d20fee13487db17f0710d13a3fc23da6573bcd"],"paragraph_range_zero_based":[264,280],"projection":"All w:t and m:t includ