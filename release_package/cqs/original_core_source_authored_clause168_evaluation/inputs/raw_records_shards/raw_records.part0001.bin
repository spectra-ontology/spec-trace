{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The cell measurement quantities to be included in the measurement report.","paragraph_zero_based":26448},{"literal_text_all_w_t_and_m_t":"reportQuantityRS-Indexes","paragraph_zero_based":26449},{"literal_text_all_w_t_and_m_t":"Indicates which measurement information per RS index the UE shall include in the measurement report.","paragraph_zero_based":26450},{"literal_text_all_w_t_and_m_t":"ul-DelayValueConfig","paragraph_zero_based":26451},{"literal_text_all_w_t_and_m_t":"If the field is present, the UE shall perform the actual UL PDCP Packet Average Delay measurement per DRB as specified in TS 38.314 [53] and the UE shall ignore the fields reportQuantityCell and maxReportCells. The applicable values for the corresponding reportInterval are (one of the) {ms120, ms240, ms480, ms640, ms1024, ms2048, ms5120, ms10240, ms20480, ms40960, min1,min6, min12, min30}. The reportInterval indicates the periodicity for performing and reporting of UL PDCP Packet Average Delay per DRB measurement as specified in TS 38.314 [53].","paragraph_zero_based":26452},{"literal_text_all_w_t_and_m_t":"ul-ExcessDelayConfig","paragraph_zero_based":26453},{"literal_text_all_w_t_and_m_t":"If the field is present, the UE shall perform the actual UL PDCP Excess Packet Delay per DRB measurement as specified in TS 38.314 [53] and the UE shall ignore the fields reportQuantityCell and maxReportCells. The applicable values for the corresponding reportInterval are (one of the) {ms120, ms240, ms480, ms640, ms1024, ms2048, ms5120, ms10240, ms20480, ms40960, min1,min6, min12, min30}. The reportInterval indicates the periodicity for performing and reporting of UL PDCP Excess Packet Delay per DRB measurement as specified in TS 38.314 [53].","paragraph_zero_based":26454},{"literal_text_all_w_t_and_m_t":"useAllowedCellList","paragraph_zero_based":26455},{"literal_text_all_w_t_and_m_t":"Indicates whether only the cells included in the allow-list of the associated measObject are applicable as specified in 5.5.4.1.","paragraph_zero_based":26456},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26457},{"literal_text_all_w_t_and_m_t":"ReportSFTD-NR field descriptions","paragraph_zero_based":26458},{"literal_text_all_w_t_and_m_t":"cellForWhichToReportSFTD","paragraph_zero_based":26459},{"literal_text_all_w_t_and_m_t":"Indicates the target NR neighbour cells for SFTD measurement between PCell and NR neighbour cells.","paragraph_zero_based":26460},{"literal_text_all_w_t_and_m_t":"drx-SFTD-NeighMeas","paragraph_zero_based":26461},{"literal_text_all_w_t_and_m_t":"Indicates that the UE shall use available idle periods (i.e. DRX off periods) for the SFTD measurement in NR standalone. The network only includes drx-SFTD-NeighMeas field when reprtSFTD-NeighMeas is set to true.","paragraph_zero_based":26462},{"literal_text_all_w_t_and_m_t":"reportSFTD-Meas","paragraph_zero_based":26463},{"literal_text_all_w_t_and_m_t":"Indicates whether UE is required to perform SFTD measurement between PCell and NR PSCell in NR-DC.","paragraph_zero_based":26464},{"literal_text_all_w_t_and_m_t":"reportSFTD-NeighMeas","paragraph_zero_based":26465},{"literal_text_all_w_t_and_m_t":"Indicates whether UE is required to perform SFTD measurement between PCell and NR neighbour cells in NR standalone. The network does not include this field if reportSFTD-Meas is set to true.","paragraph_zero_based":26466},{"literal_text_all_w_t_and_m_t":"reportRSRP","paragraph_zero_based":26467},{"literal_text_all_w_t_and_m_t":"Indicates whether UE is required to include RSRP result of NR PSCell or NR neighbour cells in SFTD measurement result, derived based on SSB. If it is set to true, the network should ensure that ssb-ConfigMobility is included in the measurement object for NR PSCell or NR neighbour cells.","paragraph_zero_based":26468},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26469},{"literal_text_all_w_t_and_m_t":"RxTxPeriodical field descriptions","paragraph_zero_based":26470},{"literal_text_all_w_t_and_m_t":"reportAmount","paragraph_zero_based":26471}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["d622df03598f1cf435dee4c07a5dec62c68969f5bfb4ca271c7a66a5a2116081","6eb33470c8cd49a6481d1c74638f18a4750f0ecd454bc0662c6d948beda75e4b","b76d14f891ffed5b829e69747817bd5f39dc0c2b412e4256784dfcb0332caa20","3f2133c62d157aeb13efaa866fe17412603072ef0286a23ee2fe232c28624cc7","fd690777071ba15533c3fbbad0b3a8e9f1c979696b0abbea971180750ac2f471","ab4988056522c7083847fd165313d080737994a088e24e1b02d8bdd4fcb8472c","89fa1ef651ca03e6ec8fd05c0b427e5da6babca164b23ddb6cd910ff4f5d1ae7","453d90ad32d107986e703812a3b07665eb05f2c743615e24512844a8e07d6030","3c2dce4ad05239111319b043a618b53a939773866b0d0ee9021f8854ff248e41","1569d6c56577ced8d1a8c1f6d6cb7a04303de6c8a662cb38f332ff501620f775","3ddc674f469900f02303688f64d45387fa2b289d085220611a39d94389b9d0a2","db139adef6d818d4621949829599945c4732d54980f19af85bcbe852680d7d62","4652d6c30bfe37dca026094146bf78003f35cfca427465d812092fa670d14d9b","9b03a717213a3a95040a78de4ffafad71a9aa9694b5d139dc719135776a41728","b7942d307b095ca5f0f69c15c2b3a32665e3dfc666ab05187aaa2a8e99bdee6b","497e02eaa47a4e6452652b588e8d03c02ab1e3b9e0ef7996d78712fd79450aee","0f5ccce4fa0b0cb9f7ff0e4230b2f65a8f993c96b6ca741173f9313a24ae8b4b","d3c62ceaae8c2ebf4feacb94de7b54dcee453df046937cea07cee33b483db964","11e1acc27d0d23730ee40e4bb6f419f373d1f90285d375626f2bd4a210ac56a5","db45ef6872177c7f42067595c2f8cbaf2dbc5ed9c92d04c27ba9644aa706c58d","cb36db2b02b8edd1a652e8879dede542db5730da2f771087d648925ea3e7db39","819de6ead0c3d2e27dc50c5756621de9f96ed17eee7cf50978ee1fb54398c849","4e83e04dd3f33d4043ef52ca181623287f861abce41430908d29918bb48d3ee9","d9105d5a98f7a6e03f071d82e14083876a062c217510d686afee50a1e9c20333"],"paragraph_range_zero_based":[26448,26471],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p26448"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field indicates the number of UE Rx-Tx time difference measurement reports. If configured to r1, the network does not configure rxTxReportInterval and only one measurement is reported. If configured to infinity, UE periodically reports measurements according to the periodicity configured by rxTxReportInterval.","paragraph_zero_based":26472},{"literal_text_all_w_t_and_m_t":"rxTxReportInterval","paragraph_zero_based":26473},{"literal_text_all_w_t_and_m_t":"This field indicates the measurement reporting periodicity of UE Rx-Tx time difference.","paragraph_zero_based":26474},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26475},{"literal_text_all_w_t_and_m_t":"other field descriptions","paragraph_zero_based":26476},{"literal_text_all_w_t_and_m_t":"MeasTriggerQuantity","paragraph_zero_based":26477},{"literal_text_all_w_t_and_m_t":"SINR is applicable only for CONNECTED mode events.","paragraph_zero_based":26478},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26479},{"literal_text_all_w_t_and_m_t":"–ReportConfigNR-SL","paragraph_zero_based":26480},{"literal_text_all_w_t_and_m_t":"The IE ReportConfigNR-SL specifies criteria for triggering of a CBR measurement reporting event for NR sidelink communication/discovery. Measurement reporting events are based on CBR measurement results on the corresponding transmission resource pools. These events are labelled CN with N equal to 1 and 2.","paragraph_zero_based":26481},{"literal_text_all_w_t_and_m_t":"Event C1:CBR of NR sidelink communication/discovery is above a threshold;","paragraph_zero_based":26482},{"literal_text_all_w_t_and_m_t":"Event C2:CBR of NR sidelink communication/discovery is below a threshold;","paragraph_zero_based":26483},{"literal_text_all_w_t_and_m_t":"ReportConfigNR-SL information element","paragraph_zero_based":26484},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26485},{"literal_text_all_w_t_and_m_t":"-- TAG-REPORTCONFIGNR-SL-START","paragraph_zero_based":26486},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26487},{"literal_text_all_w_t_and_m_t":"ReportConfigNR-SL-r16 ::=            SEQUENCE {","paragraph_zero_based":26488},{"literal_text_all_w_t_and_m_t":"    reportType-r16                       CHOICE {","paragraph_zero_based":26489},{"literal_text_all_w_t_and_m_t":"        periodical-r16                       PeriodicalReportConfigNR-SL-r16,","paragraph_zero_based":26490},{"literal_text_all_w_t_and_m_t":"        eventTriggered-r16                   EventTriggerConfigNR-SL-r16","paragraph_zero_based":26491},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":26492},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":26493},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26494},{"literal_text_all_w_t_and_m_t":"EventTriggerConfigNR-SL-r16::=       SEQUENCE {","paragraph_zero_based":26495}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["faaf68ab43a52b9e9cab7b22c5d0a7b3538fa238706a439929f3065dc9c41c27","f726d27781ba46f36b7f617ae2580076f22c861209249e85d3e45d4f29abf48e","31e70667d5dbe3db4c0b290bccfc4c74c7f7728e77f56191243b315406ab79e6","145de44396a1a5f1926119367b79223eb70059689ee5f44421b0a45dad7da789","15626ba1cc7e887de1dc6778c53a5248d9ee2114637c0e4298ddbc6dcc8f82dc","1b78d785cb35aab61885b64f4c80f0ece1ee43559a837c49a1b04ef3951c842d","6f473d0e75032bb17fd6524451e17bcfb72614d5aa5cf01922cd91d2cdd25ca4","0f1e61eb3234b6912cfa3e020341efc0cb5120fb5e5d87058ab4393af022681c","75d740a7b7e54a10a2de38492d4e