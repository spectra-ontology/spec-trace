{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE CellAccessRelatedInfo-EUTRA-EPC indicates cell access related information for an LTE cell connected to EPC.","paragraph_zero_based":15480},{"literal_text_all_w_t_and_m_t":"CellAccessRelatedInfo-EUTRA-EPC information element","paragraph_zero_based":15481},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":15482},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLACCESSRELATEDINFOEUTRA-EPC-START","paragraph_zero_based":15483},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15484},{"literal_text_all_w_t_and_m_t":"CellAccessRelatedInfo-EUTRA-EPC  ::=    SEQUENCE {","paragraph_zero_based":15485},{"literal_text_all_w_t_and_m_t":"    plmn-IdentityList-eutra-epc             PLMN-IdentityList-EUTRA-EPC,","paragraph_zero_based":15486},{"literal_text_all_w_t_and_m_t":"    trackingAreaCode-eutra-epc              BIT STRING (SIZE (16)),","paragraph_zero_based":15487},{"literal_text_all_w_t_and_m_t":"    cellIdentity-eutra-epc                  BIT STRING (SIZE (28))","paragraph_zero_based":15488},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":15489},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15490},{"literal_text_all_w_t_and_m_t":"PLMN-IdentityList-EUTRA-EPC::=          SEQUENCE (SIZE (1..maxPLMN)) OF PLMN-Identity","paragraph_zero_based":15491},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15492},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLACCESSRELATEDINFOEUTRA-EPC-STOP","paragraph_zero_based":15493},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":15494},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15495},{"literal_text_all_w_t_and_m_t":"–CellGroupConfig","paragraph_zero_based":15496},{"literal_text_all_w_t_and_m_t":"The CellGroupConfig IE is used to configure a master cell group (MCG) or secondary cell group (SCG). A cell group comprises of one MAC entity, a set of logical channels with associated RLC entities and of a primary cell (SpCell) and one or more secondary cells (SCells).","paragraph_zero_based":15497},{"literal_text_all_w_t_and_m_t":"CellGroupConfig information element","paragraph_zero_based":15498},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":15499},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLGROUPCONFIG-START","paragraph_zero_based":15500},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15501},{"literal_text_all_w_t_and_m_t":"-- Configuration of one Cell-Group:","paragraph_zero_based":15502},{"literal_text_all_w_t_and_m_t":"CellGroupConfig ::=                        SEQUENCE {","paragraph_zero_based":15503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["295424a0d052ce054038c239519942a2a5f23f1ff76e8e6bef44f4221519617e","9d1479bd2d74f6230bae97d94768fe231748f1dd6cb95394650b0ee7d1fcc625","713abe5227c7004cd6fbfac3a58f0178385171bc0f67f64c3b3a0dc0d1a4fc78","fdafcb013efa971125d2015ed6c65871b2b4e2a5f105342b3c69ba3cb1d53267","6d26d1f1d9252199e894c3aeb783ebb21f37bb9cae7c0cefa7ad52cf9e5c7680","aa25b285b32c41f77380cd76674632a7eb3ae572bea64e9767be5e19d6886925","dd1e2ef540619110a9410260bb42fd87354ea66b46460bb1c96b5e3904cc677b","b6029962c4fe33dc59872fc0416c3616c193860fc70e752ee6e72cda13c8fa75","bd8e1b9098d6e31390e523766d963d73818aca094826d918478b28d1c01bee9c","13f6c187e445b35d375a3ed09d2c26a8706e4f1ebc6f2e8a1992da1b4995cdbc","f7638c344d618f6a808bc9f6b4d6fd900b415a87e2be794b6aa05032e341cc51","cddd864729b9dd43b1defb2da92f04c6d077afa62b61abbebfb1da582b00bb14","20178128fe2b48e85719b68d60ff74ae2713579cf60c0c30af6f21257c