{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21336},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21337},{"literal_text_all_w_t_and_m_t":"-- TAG-NEEDFORGAPNCSG-INFOEUTRA-STOP","paragraph_zero_based":21338},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21339},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21340},{"literal_text_all_w_t_and_m_t":"NeedForGapNCSG-InfoEUTRA field descriptions","paragraph_zero_based":21341},{"literal_text_all_w_t_and_m_t":"needForNCSG-EUTRA","paragraph_zero_based":21342},{"literal_text_all_w_t_and_m_t":"Indicates the measurement gap and NCSG requirement information for E-UTRA measurement.","paragraph_zero_based":21343},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21344},{"literal_text_all_w_t_and_m_t":"NeedForNCSG-EUTRA field descriptions","paragraph_zero_based":21345},{"literal_text_all_w_t_and_m_t":"bandEUTRA","paragraph_zero_based":21346},{"literal_text_all_w_t_and_m_t":"Indicates the EUTRA target band to be measured.","paragraph_zero_based":21347},{"literal_text_all_w_t_and_m_t":"gapIndication","paragraph_zero_based":21348},{"literal_text_all_w_t_and_m_t":"Indicates whether measurement gap or NCSG is required for the UE to perform measurements on the concerned EUTRA target band while NR-DC or NE-DC is not configured. The UE determines this information based on the resultant configuration of the RRCReconfiguration message or RRCResume message that triggers this response. Value gap indicates that a measurement gap is needed, value ncsg indicates that NCSG is needed, value nogap-noncsg indicates neither a measurement gap nor a NCSG is needed.","paragraph_zero_based":21349},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21350},{"literal_text_all_w_t_and_m_t":"–NeedForGapNCSG-InfoNR","paragraph_zero_based":21351},{"literal_text_all_w_t_and_m_t":"The IE NeedForGapNCSG-InfoNR indicates whether measurement gap or NCSG is required for the UE to perform SSB based measurements on an NR target band while NR-DC or NE-DC is not configured.","paragraph_zero_based":21352},{"literal_text_all_w_t_and_m_t":"NeedForGapNCSG-InfoNR information element","paragraph_zero_based":21353},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21354},{"literal_text_all_w_t_and_m_t":"-- TAG-NEEDFORGAPNCSG-INFONR-START","paragraph_zero_based":21355},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21356},{"literal_text_all_w_t_and_m_t":"NeedForGapNCSG-InfoNR-r17 ::=     SEQUENCE {","paragraph_zero_based":21357},{"literal_text_all_w_t_and_m_t":"    intraFreq-needForNCSG-r17         NeedForNCSG-IntraFreqList-r17,","paragraph_zero_based":21358},{"literal_text_all_w_t_and_m_t":"    interFreq-needForNCSG-r17         NeedForNCSG-BandListNR-r17","paragraph_zero_based":21359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["c33a64af94b1977c2eef7d9e5de858c3f40c22aff22bb6e0727309de77112c66","2d7c36dd8b2969be0bcf1adbbedaa3f02a83cdc9d45f530243f577fa2a101baa","69de392cdb2aaa1355df7f8d463359a47f36f1e74ff9a11a48a901ea5cdd49e3","2748d9ec5c71c6df5a020200a56150d3c093446ad369d6b479b4ebf2ca805869","1075aae9bfdc8cfa8145ed6f57419847adf451f5d4b6a688baca84917518946e","5056d8e4e3540eee73d1396a939d49aa1940af7055cc39a6ced02dff4dae2bd4","9b6c267bd5b446268c271a374e629dca9ecde691a787a3efd02fee947089617d","7649723ee46336bc93c1c270067fa7c50c8112c093d6bba33a5c4fdf78c43b19","7b1b639357d91c59fe42c5eb736fdaa970c4c638c33e35a77cb3790d19795093","3abe6da91b4d9379517447d913c13ad181744e393ed800b7a0634272a7