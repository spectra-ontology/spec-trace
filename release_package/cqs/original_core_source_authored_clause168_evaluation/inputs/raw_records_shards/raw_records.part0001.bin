{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29856},{"literal_text_all_w_t_and_m_t":"-- TAG-TRESELECTION-STOP","paragraph_zero_based":29857},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29858},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29859},{"literal_text_all_w_t_and_m_t":"–TimeAlignmentTimer","paragraph_zero_based":29860},{"literal_text_all_w_t_and_m_t":"The IE TimeAlignmentTimer is used to configure the time alignment timer as specified in TS 38.321 [3]. The values are in ms.","paragraph_zero_based":29861},{"literal_text_all_w_t_and_m_t":"TimeAlignmentTimer information element","paragraph_zero_based":29862},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29863},{"literal_text_all_w_t_and_m_t":"-- TAG-TIMEALIGNMENTTIMER-START","paragraph_zero_based":29864},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29865},{"literal_text_all_w_t_and_m_t":"TimeAlignmentTimer ::=              ENUMERATED {ms500, ms750, ms1280, ms1920, ms2560, ms5120, ms10240, infinity}","paragraph_zero_based":29866},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29867},{"literal_text_all_w_t_and_m_t":"-- TAG-TIMEALIGNMENTTIMER-STOP","paragraph_zero_based":29868},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29869},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29870},{"literal_text_all_w_t_and_m_t":"–TimeToTrigger","paragraph_zero_based":29871},{"literal_text_all_w_t_and_m_t":"The IE TimeToTrigger specifies the value range used for time to trigger parameter, which concerns the time during which specific criteria for the event needs to be met in order to trigger a measurement report. Value ms0 corresponds to 0 ms and behaviour as specified in 7.1.2 applies, value ms40 corresponds to 40 ms, and so on.","paragraph_zero_based":29872},{"literal_text_all_w_t_and_m_t":"TimeToTrigger information element","paragraph_zero_based":29873},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29874},{"literal_text_all_w_t_and_m_t":"-- TAG-TIMETOTRIGGER-START","paragraph_zero_based":29875},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29876},{"literal_text_all_w_t_and_m_t":"TimeToTrigger ::=                   ENUMERATED {","paragraph_zero_based":29877},{"literal_text_all_w_t_and_m_t":"                                        ms0, ms40, ms64, ms80, ms100, ms128, ms160, ms256,","paragraph_zero_based":29878},{"literal_text_all_w_t_and_m_t":"                                        ms320, ms480, ms512, ms640, ms1024, ms1280, ms2560,","paragraph_zero_based":29879}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["1037251d249286e4c64a63b999ec15c1c179865bbb317566d5e9cf76d8b3841b","dbc0f7c224c2b20d9ac17f96515f77325c3086a3a6e55bf1c3b3b9faf0307f2d","7266201313d96d00039f5e25837e1cda75539a5df3f927a9f8da8510d762b123","29add3cab57ef3240e211b86a20fed5fe07cccae3d631b8362f610c1a3450e5f","400ac8cd7994bbe3adb21fef5d704834169d623e39b84b51f3e3cb07c778bdd9","d2d2f4a286dc84754d156e6dd4a44307967178709e47b884b3c57c9c1f7f01f8","ebfdd404a6f8fdb0d9e56f369d2274047bec159e0e07ec5c8228bcfc45faf25e","02d6e6f37bf91edb3510fd86ff2ee2b0c87dcb1e91c4a0a59848e0ba15cac496","73c6ca06acd68fe7725e15deaa562a6956c773ec58b81b831d246bb6693b1296","5bcc6afde17d1d7bd3ab57cc01f1c1cb2fcda7ae20e3a561c8511d9d9f2b003d","b190f6ad156009dbd1209ecef9f5d5cce7ab35d636f45ff9f5ecf713cd190616","5d7930f79a25410df2dc154fca599e0f99ff8ab5927b81c3b0adb5d226561dcc","7bea281cb5b2dc8ddafdfd9b4aff490fcd6d0a8577ca0c59b784209eba7a8d8c","