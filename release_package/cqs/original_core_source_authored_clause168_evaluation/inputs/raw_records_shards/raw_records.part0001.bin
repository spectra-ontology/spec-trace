{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"BWP-Id information element","paragraph_zero_based":14784},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":14785},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-ID-START","paragraph_zero_based":14786},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14787},{"literal_text_all_w_t_and_m_t":"BWP-Id ::=                          INTEGER (0..maxNrofBWPs)","paragraph_zero_based":14788},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14789},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-ID-STOP","paragraph_zero_based":14790},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":14791},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14792},{"literal_text_all_w_t_and_m_t":"–BWP-Uplink","paragraph_zero_based":14793},{"literal_text_all_w_t_and_m_t":"The IE BWP-Uplink is used to configure an additional uplink bandwidth part (not for the initial BWP).","paragraph_zero_based":14794},{"literal_text_all_w_t_and_m_t":"BWP-Uplink information element","paragraph_zero_based":14795},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":14796},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-UPLINK-START","paragraph_zero_based":14797},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14798},{"literal_text_all_w_t_and_m_t":"BWP-Uplink ::=                      SEQUENCE {","paragraph_zero_based":14799},{"literal_text_all_w_t_and_m_t":"    bwp-Id                              BWP-Id,","paragraph_zero_based":14800},{"literal_text_all_w_t_and_m_t":"    bwp-Common                          BWP-UplinkCommon                                            OPTIONAL,   -- Cond SetupOtherBWP","paragraph_zero_based":14801},{"literal_text_all_w_t_and_m_t":"    bwp-Dedicated                       BWP-UplinkDedicated                  