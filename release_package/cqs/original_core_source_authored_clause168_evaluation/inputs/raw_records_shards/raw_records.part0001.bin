{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    resourcePerGroupList-r16                   SEQUENCE (SIZE (1..maxNrofPUCCH-ResourcesPerGroup-r16)) OF PUCCH-ResourceId","paragraph_zero_based":23376},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":23377},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23378},{"literal_text_all_w_t_and_m_t":"PUCCH-ResourceGroupId-r16 ::=              INTEGER (0..maxNrofPUCCH-ResourceGroups-1-r16)","paragraph_zero_based":23379},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23380},{"literal_text_all_w_t_and_m_t":"DL-DataToUL-ACK-r16 ::=                    SEQUENCE (SIZE (1..8)) OF INTEGER (-1..15)","paragraph_zero_based":23381},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23382},{"literal_text_all_w_t_and_m_t":"DL-DataToUL-ACK-r17 ::=                    SEQUENCE (SIZE (1..8)) OF INTEGER (-1..127)","paragraph_zero_based":23383},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23384},{"literal_text_all_w_t_and_m_t":"DL-DataToUL-ACK-v1700 ::=                  SEQUENCE (SIZE (1..8)) OF INTEGER (16..31)","paragraph_zero_based":23385},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23386},{"literal_text_all_w_t_and_m_t":"DL-DataToUL-ACK-DCI-1-2-r16 ::=            SEQUENCE (SIZE (1..8)) OF INTEGER (0..15)","paragraph_zero_based":23387},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23388},{"literal_text_all_w_t_and_m_t":"DL-DataToUL-ACK-DCI-1-2-r17 ::=            SEQUENCE (SIZE (1..8)) OF INTEGER (0..127)","paragraph_zero_based":23389},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23390},{"literal_text_all_w_t_and_m_t":"UL-AccessConfigListDCI-1-1-r16 ::=         SEQUENCE (SIZE (1..16)) OF INTEGER (0..15)","paragraph_zero_based":23391},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23392},{"literal_text_all_w_t_and_m_t":"UL-AccessConfigListDCI-1-2-r17 ::=         SEQUENCE (SIZE (1..16)) OF INTEGER (0..15)","paragraph_zero_based":23393},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23394},{"literal_text_all_w_t_and_m_t":"UL-AccessConfigListDCI-1-1-r17 ::=         SEQUENCE (SIZE (1..3)) OF INTEGER (0..2)","paragraph_zero_based":23395},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23396},{"literal_text_all_w_t_and_m_t":"DL-DataToUL-ACK-MulticastDCI-Format4-1-r17 ::= SEQUENCE (SIZE (1..8)) OF INTEGER (0..15)","paragraph_zero_based":23397},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23398},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-CONFIG-STOP","paragraph_zero_based":23399}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["12bcddb0d640e3785f4d0c4976002bd98ba40217bfa13ad5b2dbcf77cec580c2","1feb0028c11e9b4fd64ee5acfec51c3a91d233a77e040fff3235dea6ec66cda9","a959ab1ff829f5c969535a1355f840310efa1d0dd3fa6e71579f7136be03a8d4","d744ce94c095cb484d354ee69947e3879995f785ee05f705b34475159d7deb1f","f1805deb8a8b14668a8b1a1fc4f671c4b87bae8371deacf3d1e2ebb6cec04c20","5223e097b11909aa72d5672d45d687007baec85d477951eede052973c43ef2eb","78e2c89b21d4f1bab801a5b93be70403afa2ede965d1e1a8cc87811ad068d272","6a395daca5dc9fc4c70ecf7fc8fb98fbf70df4f3994ff8ef2145c812a5113337","55a2fb71ef1d1934ab0042c8972f7f5ddfeb8d6e592ff726cf77a2f3e5af7a03","247c4fdf15be7b9f548435de09bc9cd0539ac24ef85450433fa0ac5276dc6ab8","0df1914960b5bf1bb79d82a4cc76e7d38178aff5e5679d929670fedb6da8cec1","d9d6e291af05ff98c1471d2e7930bf1b90e3fe5117e984d0055d41bcc8e01051","e23a1657a6cc8e87c8758a363eb8d36688d888ab48b61ce570b256a8794b27fe","a8d083aa9f7c08e56c5a16fd57c3718eed2280f49e7a7979fb7d2ac2164669a9","39ac4244117617b13cac8510db526c91525cad530c199a1fe4dda02104905095","7c4d91d6253d7bcaff894b9150cf1080b30ee6b9af958a5a25900baf104add1c","00c7a755e3f26f550e96e4d115a0f82bb363f2bc1df0a2a4cb800369a9f9a06e","02b23e3bdcf26a7677a9dda5a3a51af0d14c3244d8f74407246316e4d6551e64","867d01f55e061500cbf116212505620264da5f3ab8a1b0ec24274427fde70278","aa5165e1d2ec8772f425499c02ac8d021f192956db848db6186882c13979f7ee","35f70bdcf5d3b14e0edddd65f14dfe28be96fdccc15a319619e970bdb77869a6","065a77ac7635c8a960a60e17fd74cb2a9824cbef430feaa85ece7af11b9e2993","4c705aaee86e15b817a1a2303c540e2b6d2fdb6b4f0b5130860065985dd78386","e78a8b7f0564662c91401a69391158139883cafd31f4ceeb66cc2a72c5d93dc0"],"paragraph_range_zero_based":[23376,23399],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p23376"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23400},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23401},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23402},{"literal_text_all_w_t_and_m_t":"PUCCH-Config field descriptions","paragraph_zero_based":23403},{"literal_text_all_w_t_and_m_t":"dl-DataToUL-ACK, dl-DataToUL-ACK-DCI-1-2","paragraph_zero_based":23404},{"literal_text_all_w_t_and_m_t":"List of timing for given PDSCH to the DL ACK (see TS 38.213 [13], clause 9.1.2). The field dl-DataToUL-ACK applies to DCI format 1_1 and the field dl-DataToUL-ACK-DCI-1-2 applies to DCI format 1_2 (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13], clause 9.2.3). The dl-DataToUL-ACK-v1700 is applicable for NTN and dl-DataToUL-ACK-r17 is applicable for up to 71 GHz. If dl-DataToUL-ACK-r16 or dl-DataToUL-ACK-r17 or dl-DataToUL-ACK-v1700 is signalled, UE shall ignore the dl-DataToUL-ACK (without suffix). The value -1 corresponds to \"inapplicable value\" for the case where the A/N feedback timing is not explicitly included at the time of scheduling PDSCH. The fields dl-DataToUL-ACK-r17 and dl-DataToUL-ACK-DCI-1-2-r17 are only applicable for SCS of 480 kHz or 960 kHz.","paragraph_zero_based":23405},{"literal_text_all_w_t_and_m_t":"dl-DataToUL-ACK-MulticastDCI-Format4-1","paragraph_zero_based":23406},{"literal_text_all_w_t_and_m_t":"List of timing for given group-common PDSCH to the DL ACK (see TS 38.213 [13], clause 9.1.2). The field dl-DataToUL-ACK-MulticastDciFormat4-1 applies to DCI format 4_1 for MBS multicast (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13], clause 9.2.3).","paragraph_zero_based":23407},{"literal_text_all_w_t_and_m_t":"dmrs-BundlingPUCCH-Config","paragraph_zero_based":23408},{"literal_text_all_w_t_and_m_t":"Configuration of the parameters for DMRS bundling for PUCCH (see TS 38.214 [19], clause 6.1.7). DMRS bundling for PUCCH is not supported for PUCCH format 0/2. In this release, this is not applicable to FR2-2.","paragraph_zero_based":23409},{"literal_text_all_w_t_and_m_t":"dmrs-UplinkTransformPrecodingPUCCH","paragraph_zero_based":23410},{"literal_text_all_w_t_and_m_t":"This field is used for PUCCH formats 3 and 4 according to TS 38.211, Clause 6.4.1.3.3.1.","paragraph_zero_based":23411},{"literal_text_all_w_t_and_m_t":"format0","paragraph_zero_based":23412},{"literal_text_all_w_t_and_m_t":"Parameters that are common for all PUCCH resources of format 0.","paragraph_zero_based":23413},{"literal_text_all_w_t_and_m_t":"format1","paragraph_zero_based":23414},{"literal_text_all_w_t_and_m_t":"Parameters that are common for all PUCCH resources of format 1.","paragraph_zero_based":23415},{"literal_text_all_w_t_and_m_t":"format2","paragraph_zero_based":23416},{"literal_text_all_w_t_and_m_t":"Parameters that are common for all PUCCH resources of format 2.","paragraph_zero_based":23417},{"literal_text_all_w_t_and_m_t":"format3","paragraph_zero_based":23418},{"literal_text_all_w_t_and_m_t":"Parameters that are common for all PUCCH resources of format 3.","paragraph_zero_based":23419},{"literal_text_all_w_t_and_m_t":"format4","paragraph_zero_based":23420},{"literal_text_all_w_t_and_m_t":"Parameters that are common for all PUCCH resources of format 4.","paragraph_zero_based":23421},{"literal_text_all_w_t_and_m_t":"mappingPattern","paragraph_zero_based":23422},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE should follow Cyclical mapping pattern or Sequential mapping pattern for when a PUCCH resource used for repetitions of a PUCCH transmission includes first and second spatial settings for FR2, or first and second sets of power control parameters for FR1 (see TS 38.213 [13], clause 9.2.6).","paragraph_zero_based":23423}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["1eb97ca9858afe2ad38028553735ad61ceefde5e65adf0e9667360552fd21c42","00fba7f7191f7d9747ae0f95cfe7c174be63a8ba70e44eb88c0456c882eea369","ca86dbf5bad9147699d2d218a41d39d09a49ed3dcf86faf878ff5b126553670f","8fa20fc35243a869cf8d795a5dd7a98819c7a506688a21449eea9680e63a755b","c3396e8227c4fe51380b4a9046f3fc6ee21ad4605bf936a4c654dca5f0627499","58418c1f833c8d5c93c11515fc540de69b00369d762b85006a629efa14180594","e02defb0356fed67b5bb72a71e58cddd7dd7ff2b35e3b44ddbeff3ce50473b62","9830fffdebe5e35a2327fc990dc7934e66760baede7dc4ab5c490a905b830783","047d8b695f40c65375025e7c19c651ecc81bea53c0840f7fc9ffa8b3775d351c","a457198d8421dfa7f3662063fe556f3106b6d9b81623b230dc97f91d4e6ae55c","31e394a08ebe16035bc3335395fae54c5c5048719091afdcafecd5d07e133d9e","487cfe568976f46f1f60e375c29d887d52b1b5f8c538fabda559964cac31fd6f","eda6870042c59d17416a7277df460e0bfe7ef5839870527c1a7a69d593e41c81","0490d56598dab82d7a0d239d08d2b0e524587f57bde2a5f2cdbfd4051b01e8e6","647dcd075209c314453d6bef33e6b1955f8a96bce8fa067557e164e83f685f2c","bad1efff3a63de2bffb89256030904be81a4026edd3ec9f7961f7d05b0fa3990","5c5f86a9881e9e7df016147f42b51c8f8571d533fe1c9f6f2d7a72438b27ee03","13cdc024640849fcdff17c2e47293d081d021caa0f841fd25aef3745ec11246c","d422e99949ee7ac2d0063c3fea40cb9aa88585227ceb9f47b70c3070066f1905","052b0259564ae6cb6e85903364a7b0e74dc52288b13389771163140dc280af81","059a77f9cc216ea0318cbce9c441d2ace72525e91debcef229afd9088c9dc837","54cffbddd21fbc46342e57c06c0255cb81c776ad569867618dff4955a46accad","948b20edc5433e83e25d0e29b17eaec4c7724dd3fd7f375c28a864fa927c2b76","291887ed94896724a0421185c65e350c9a76dd28c1065854ba30d07b0986935a"],"paragraph_range_zero_based":[23400,23423],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p23400"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"numberOfBitsForPUCCH-ResourceIndicatorDCI-1-2","paragraph_zero_based":23424},{"literal_text_all_w_t_and_m_t":"Configuration of the number of bits for \"PUCCH resource indicator\" in DCI format 1_2 (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13], clause 9.2.3).","paragraph_zero_based":23425},{"literal_text_all_w_t_and_m_t":"powerControlSetInfoToAddModList","paragraph_zero_based":23426},{"literal_text_all_w_t_and_m_t":"Configures power control sets for repetition of a PUCCH transmission in FR1. This field is not configured if ul-powerControl is configured in the BWP-UplinkDedicated in which the PUCCH-Config is included.","paragraph_zero_based":23427},{"literal_text_all_w_t_and_m_t":"pucch-PowerControl","paragraph_zero_based":23428},{"literal_text_all_w_t_and_m_t":"Configures power control parameters PUCCH transmission. This field is not configured if unifiedTCI-StateType is configured for the serving cell.","paragraph_zero_based":23429},{"literal_text_all_w_t_and_m_t":"resourceGroupToAddModList, resourceGroupToReleaseList","paragraph_zero_based":23430},{"literal_text_all_w_t_and_m_t":"Lists for adding and releasing groups of PUCCH resources that can be updated simultaneously for spatial relations with a MAC CE.","paragraph_zero_based":23431},{"literal_text_all_w_t_and_m_t":"resourceSetToAddModList, resourceSetToReleaseList","paragraph_zero_based":23432},{"literal_text_all_w_t_and_m_t":"Lists for adding and releasing PUCCH resource sets (see TS 38.213 [13], clause 9.2).","paragraph_zero_based":23433},{"literal_text_all_w_t_and_m_t":"resourceToAddModList, resourceToAddModListExt, resourceToReleaseList","paragraph_zero_based":23434},{"literal_text_all_w_t_and_m_t":"Lists for adding and releasing PUCCH resources applicable for the UL BWP and serving cell in which the PUCCH-Config is defined. The resources defined herein are referred to from other parts of the configuration to determine which resource the UE shall use for which report. If the network includes of resourceToAddModListExt, it includes the same number of entries, and listed in the same order, as in resourceToAddModList.","paragraph_zero_based":23435},{"literal_text_all_w_t_and_m_t":"secondTPCFieldDCI-1-1, secondTPCFieldDCI-1-2","paragraph_zero_based":23436},{"literal_text_all_w_t_and_m_t":"A second TPC field can be configured via RRC for DCI-1-1 and DCI-1-2. Each TPC field is for each closed-loop index value respectively (i.e., 1st /2nd TPC fields correspond to \"closedLoopIndex\" value = 0 and 1.","paragraph_zero_based":23437},{"literal_text_all_w_t_and_m_t":"spatialRelationInfoToAddModList, spatialRelationInfoToAddModListSizeExt , spatialRelationInfoToAddModListExt","paragraph_zero_based":23438},{"literal_text_all_w_t_and_m_t":"Configuration of the spatial relation between a reference RS and PUCCH. Reference RS can be SSB/CSI-RS/SRS. If the list has more than one element, MAC-CE selects a single element (see TS 38.321 [3], clause 5.18.8 and TS 38.213 [13], clause 9.2.2). The UE shall consider entries in spatialRelationInfoToAddModList and in spatialRelationInfoToAddModListSizeExt as a single list, i.e. an entry created using spatialRelationInfoToAddModList can be modified using spatialRelationInfoToAddModListSizeExt (or deleted using spatialRelationInfoToReleaseListSizeExt) and vice-versa. If the network includes spatialRelationInfoToAddModListExt, it includes the same number of entries, and listed in the same order, as in the concatenation of spatialRelationInfoToAddModList and of spatialRelationInfoToAddModListSizeExt. If unifiedTCI-StateType is configured for the serving cell, no element in this list is configured.","paragraph_zero_based":23439},{"literal_text_all_w_t_and_m_t":"spatialRelationInfoToReleaseList, spatialRelationInfoToReleaseListSizeExt, spatialRelationInfoToReleaseListExt","paragraph_zero_based":23440},{"literal_text_all_w_t_and_m_t":"Lists of spatial relation configurations between a reference RS and PUCCH to be released by the UE.","paragraph_zero_based":23441},{"literal_text_all_w_t_and_m_t":"sps-PUCCH-AN-List","paragraph_zero_based":23442},{"literal_text_all_w_t_and_m_t":"Indicates a list of PUCCH resources for DL SPS HARQ ACK. The field maxPayloadSize is absent for the first and the last SPS-PUCCH-AN in the list. If configured, this overrides n1PUCCH-AN in SPS-config.","paragraph_zero_based":23443},{"literal_text_all_w_t_and_m_t":"sps-PUCCH-AN-ListMulticast","paragraph_zero_based":23444},{"literal_text_all_w_t_and_m_t":"The field is used to configure the list of PUCCH resources per HARQ ACK codebook for MBS multicast.","paragraph_zero_based":23445},{"literal_text_all_w_t_and_m_t":"subslotLengthForPUCCH","paragraph_zero_based":23446},{"literal_text_all_w_t_and_m_t":"Indicates the sub-slot length for sub-slot based PUCCH feedback in number of symbols (see TS 38.213 [13], clause 9). Value n2 corresponds to 2 symbols, value n6 corresponds to 6 symbols, value n7 corresponds to 7 symbols. For normal CP, the value is either n2 or n7. For extended CP, the value is either n2 or n6.","paragraph_zero_based":23447}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["896d3a6886907fa3cdebc3abca64a596fd9c72d50f7f6cc4c6b612103f081323","58e475f2b0f774fe629c842070966ec50ec4b8427777ccbd662fce56ff12211c","c529d1cde2870b43a6c1fe237ee9ba6a89dbad2a30425d912adae8e55a6eeabe","e6dd40cc164342162b3619e8790fbb98dc3bad45a04826921a43efb391044dec","441c0ae896e10f5d18150666c5b10191481897e96e2d50d521b15b730ecf1b49","c866e54212317033a355dec7b02f770fd27581196237ce29cab241e7e730f895","2e9be45dc975c4ed51928a4cd07f74d0a66cf20dcb7fe59ffc1febcfe1c98422","db408b788a8905d49e9e770c1f59c1a91124b36a3c91a9368b42450780c4943a","88fc8c9b2e7b594f51fadc09d9a9c70945adebcbf9a48c309584c621c19fcc6a","4094658c3f38ff3ae308beaafe4d157b23c113a60db3b3e3b5f00d3f21b25f6c","c9b77f0a60d4e051c4e255a03019eeecc0809484c1daa177b1b92f37f6be6f67","0be89419fef147140ad77bc36cf5b257fa5b7b30f448e7fa7c5e2ec9ae19075a","ad45f03f8a02081856bd24cdca79644346ceb155ed7bedb639c92f079d14f9f9","59fd936b5d09fe42405ed12a40799f60bb458387b1112290b2162b63ec03c8bb","63ed2878796839733c9eb933f386a30467fc51a887a4ce9237d89ae9ac9a54ef","5f52c256042f098c3f541fdc75acd8b34953d4c8b9a2d55ea710782bf0c1d651","6f94a7459398bd168943c0c7dc77ed5f2ba15376197c6021892eb79d6a6953a4","91a6e6291365e56b3ebe4b76fcae75e1944cb3cf59bdb37c2a2b7d297443e5ea","309cf9bac5a5927e12bb70dcae9fdd3fd42763d5ea4d8e46b5570ea67a638105","3b2e6e1cc5275b95bfd10c7cb7b61d65f1b9d9b7630a2a47b7f89b0202abc4d5","ba868f1045988d4a1aa141ab412eccbb701e801783b8c10c311dfcae0fc32613","ec54ec2316293c2014f336dfe4f9dc3682ea7d44bb44799200542cebc1b11cd5","81642a3c8cd90a168ef477433cca23854c1983041f534e3e564c1b61ddd02869","f389547599c0f12f895c3f0e155c9f137e7bfaf4b5593180944355786b871d7b"],"paragraph_range_zero_based":[23424,23447],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p23424"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ul-AccessConfigListDCI-1-1, ul-AccessConfigListDCI-1-2","paragraph_zero_based":23448},{"literal_text_all_w_t_and_m_t":"List of the combinations of cyclic prefix extension and UL channel access type (see TS 38.212 [17], clause 7.3.1) applicable, respectively, to DCI format 1_1 and DCI format 1_2. The fields ul-AccessConfigListDCI-1-1-r16 and ul-AccessConfigListDCI-1-2-r17 are only applicable for FR1 (see TS 38.212 [17], Table 7.3.1.2.2-6). The field ul-AccessConfigListDCI-1-1-r17 indicates a list which only contains UL channel access types and is only applicable for FR2-2 (see TS 38.212 [17], Table 7.3.1.2.2-6A).","paragraph_zero_based":23449},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23450},{"literal_text_all_w_t_and_m_t":"PUCCH-format3 field descriptions","paragraph_zero_based":23451},{"literal_text_all_w_t_and_m_t":"nrofPRBs","paragraph_zero_based":23452},{"literal_text_all_w_t_and_m_t":"The supported values are 1,2,3,4,5,6,8,9,10,12,15 and 16. The UE shall ignore this field when format-v1610 is configured.","paragraph_zero_based":23453},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23454},{"literal_text_all_w_t_and_m_t":"PUCCH-FormatConfig, PUCCH-FormatConfigExt field descriptions","paragraph_zero_based":23455},{"literal_text_all_w_t_and_m_t":"additionalDMRS","paragraph_zero_based":23456},{"literal_text_all_w_t_and_m_t":"If the field is present, the UE enables 2 DMRS symbols per hop of a PUCCH Format 3 or 4 if both hops are more than X symbols when FH is enabled (X=4). And it enables 4 DMRS symbols for a PUCCH Format 3 or 4 with more than 2X+1 symbols when FH is disabled (X=4). The field is not applicable for format 0, 1 and 2. See TS 38.213 [13], clause 9.2.2.","paragraph_zero_based":23457},{"literal_text_all_w_t_and_m_t":"interslotFrequencyHopping","paragraph_zero_based":23458},{"literal_text_all_w_t_and_m_t":"If the field is present, the UE enables inter-slot frequency hopping when PUCCH Format 0, 1, 2, 3 or 4 is repeated over multiple slots. For a PUCCH over multiple slots, the intra and inter slot frequency hopping cannot be enabled at the same time for a UE. See TS 38.213 [13], clause 9.2.6.","paragraph_zero_based":23459},{"literal_text_all_w_t_and_m_t":"maxCodeRate","paragraph_zero_based":23460},{"literal_text_all_w_t_and_m_t":"Max coding rate to determine how to feedback UCI on PUCCH for format 2, 3 or 4. The field is not applicable for format 0 and 1. See TS 38.213 [13], clause 9.2.5.","paragraph_zero_based":23461},{"literal_text_all_w_t_and_m_t":"maxCodeRateLP","paragraph_zero_based":23462},{"literal_text_all_w_t_and_m_t":"Max coding rate to determine how to feedback UCI on PUCCH for format 2, 3 or 4. The field is not applicable for format 0 and 1. This field configures additional max code rate in the second entry of PUCCH-ConfigurationList-r16 for multiplexing low-priority (LP) HARQ-ACK and high-priority (HP) UCI in a PUCCH as described Clause 9.2.5.3 of TS 38.213 [13]. The field is absent for the first entry of PUCCH-ConfigurationList-r16.","paragraph_zero_based":23463},{"literal_text_all_w_t_and_m_t":"nrofSlots","paragraph_zero_based":23464},{"literal_text_all_w_t_and_m_t":"Number of slots with the same PUCCH. When the field is absent the UE applies the value n1. See TS 38.213 [13], clause 9.2.6.","paragraph_zero_based":23465},{"literal_text_all_w_t_and_m_t":"pi2BPSK","paragraph_zero_based":23466},{"literal_text_all_w_t_and_m_t":"If the field is present, the UE uses pi/2 BPSK for UCI symbols instead of QPSK for PUCCH. The field is not applicable for format 0, 1 and 2. See TS 38.213 [13], clause 9.2.5.","paragraph_zero_based":23467},{"literal_text_all_w_t_and_m_t":"rb-SetIndex","paragraph_zero_based":23468},{"literal_text_all_w_t_and_m_t":"Indicates the RB set where PUCCH resource is allocated.","paragraph_zero_based":23469},{"literal_text_all_w_t_and_m_t":"simultaneousHARQ-ACK-CSI","paragraph_zero_based":23470},{"literal_text_all_w_t_and_m_t":"If the field is present, the UE uses simultaneous transmission of CSI and HARQ-ACK feedback with or without SR with PUCCH Format 2, 3 or 4. See TS 38.213 [13], clause 9.2.5. When the field is absent the UE applies the value off. The field is not applicable for format 0 and 1.","paragraph_zero_based":23471}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["fafbb09634a9d8121a70b6c98c24d58d3427f61bdacad868eb41b88638f00bab","44c8cf45255dc62c4eec8f982cbae8c590aa132a32aa340793186a63eb035a39","59a33e856427b2a7849aee196d7186ad9634c748166239ad0f358ec644f93362","cd5a71fc46d61ef4eb6b8871d7646abd909ed74dfa54dc19fed4205d7ac0ab12","206eb124d48f8710b98b9f905287e0d5f1ffb82000f5d56e74150b54a691eab0","4d60fd53bbf656543dfdb0113241963663ee4e04595126caf02cff58d0134a99","ed8bd11e2d0b6b49757ea5d06206cbad4c367c40aad69754731466aae9bc7a25","10a3dafe3c8d1fe2d40888c3e642666a489a43988f3c83c2a0bb59cb248aa005","4e323349a5790a9200a29fcd68390b772d53d85ab2f4b1a9654c528ab5d6b3e0","7cfc41ead6bbc269671328d5771f75fd5fa36e115b5b5e6b97ce3c8098921e8f","4889f95979daafbf158958695e515a0901670a0460924a8f4ed4dc9bf0bde005","b82b5c902e94dd426a57580449b60b91abee5555dce691657ab67b69109790f2","71f98d8127e1a76669921cc8b35151b6c297fe1c0ba6b152482d1d27dd8b6b76","1eae7b598fde4cfc6f2407bfcbe0fb63a4f996951afbbf3107c998685a1264b7","9ab7bfb7ccffbf4a500fe3f0b035d6ea804eb41f31bdb34a2bbdf40bae9dd3b2","0cbae6674cfb7284202731a567ee8876b72d5a936f5e619cea4f4f1ee15d7e21","4cb1c7fb58c6c6bc7b5566371e1f7ffd3b52c5e883b80fcfb1a24712a9db09f4","d6dd23a146ae6ba31f3c1f98d3bfa0947c19d7206a33d52346549186de7d47b8","36a32c50fc5f8a839a9d019aaa27c39f95b998e6b5ee276cc8d92f794a5599fe","1bf8ec69a5f058ff0ff3693d4f0f5e89278b280460eb8b652cc9c0d36c4ddb0f","5e9abe2c7732fbaee750cabb0c4d5fa968d57b4d73179988db1a051647604459","2ba3dff53895e228f708efae3f15bebd397069c032e230293c3ef499e9f4247b","3c30173259cd072b378f8e2ffe3ac1838a63fe7880f68dc88870ee49fa521c67","9d0c1102ca0aec38aea06e9af51cc8195569222aba977d3a79bbcccb3573aa4a"],"paragraph_range_zero_based":[23448,23471],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p23448"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23472},{"literal_text_all_w_t_and_m_t":"PUCCH-Resource, PUCCH-ResourceExt field descriptions","paragraph_zero_based":23473},{"literal_text_all_w_t_and_m_t":"format","paragraph_zero_based":23474},{"literal_text_all_w_t_and_m_t":"Selection of the PUCCH format (format 0 – 4) and format-specific parameters, see TS 38.213 [13], clause 9.2. format0 and format1 are only allowed for a resource in a first PUCCH resource set. format2, format3 and format4 are only allowed for a resource in non-first PUCCH resource set. The network can only configure format-v1610 when format is set to format2 or format3. The network only configures format-v1700 when format is set to format0, format1 or format4.","paragraph_zero_based":23475},{"literal_text_all_w_t_and_m_t":"interlace0","paragraph_zero_based":23476},{"literal_text_all_w_t_and_m_t":"This is the only interlace of interlaced PUCCH Format 0 and 1 and the first interlace for interlaced PUCCH Format 2 and 3.","paragraph_zero_based":23477},{"literal_text_all_w_t_and_m_t":"interlace1","paragraph_zero_based":23478},{"literal_text_all_w_t_and_m_t":"A second interlace, in addition to interlace 0, as specified in TS 38.213 [13], clause 9.2.1. For 15kHz SCS, values {0..9} are applicable; for 30kHz SCS, values {0..4} are applicable. For 15kHz SCS, the values of interlace1 shall satisfy interlace1=mod(interlace0+X,10) where X=1, -1, or 5.","paragraph_zero_based":23479},{"literal_text_all_w_t_and_m_t":"intraSlotFrequencyHopping","paragraph_zero_based":23480},{"literal_text_all_w_t_and_m_t":"Enabling intra-slot frequency hopping, applicable for all types of PUCCH formats. For long PUCCH over multiple slots, the intra and inter slot frequency hopping cannot be enabled at the same time for a UE. See TS 38.213 [13], clause 9.2.1.","paragraph_zero_based":23481},{"literal_text_all_w_t_and_m_t":"nrofPRBs","paragraph_zero_based":23482},{"literal_text_all_w_t_and_m_t":"Indicates the number of PRBs used per PUCCH resource for the PUCCH format, see TS 38.213 [13], clause 9.2.1. This field is applicable for PUCCH format0, format1, and format4 in FR2-2. The supported values for format4 are 1,2,3,4,5,6,8,9,10,12,15 and 16.","paragraph_zero_based":23483},{"literal_text_all_w_t_and_m_t":"occ-Index","paragraph_zero_based":23484},{"literal_text_all_w_t_and_m_t":"Indicates the orthogonal cover code index (see TS 38.213 [13], clause 9.2.1). This field is applicable when useInterlacePUCCH-PUSCH-16 is configured.","paragraph_zero_based":23485},{"literal_text_all_w_t_and_m_t":"occ-Length","paragraph_zero_based":23486},{"literal_text_all_w_t_and_m_t":"Indicates the orthogonal cover code length (see TS 38.213 [13], clause 9.2.1). This field is applicable when useInterlacePUCCH-PUSCH-16 is configured.","paragraph_zero_based":23487},{"literal_text_all_w_t_and_m_t":"pucch-RepetitionNrofSlots","paragraph_zero_based":23488},{"literal_text_all_w_t_and_m_t":"Configuration of PUCCH repetition factor per PUCCH resource with associated scheduling DCI corresponding to Rel-17 dynamic PUCCH repetition. For a PUCCH resource, if both the field pucch-RepetitionNrofSlots and the field nrofSlots are present, the field nrofSlots is ignored and apply the value of pucch-RepetitionNrofSlots corresponding to Rel-17 dynamic PUCCH repetition. If this field is absent in a PUCCH resource with associated scheduling DCI, the UE applies the value of field nrofSlots.","paragraph_zero_based":23489},{"literal_text_all_w_t_and_m_t":"pucch-ResourceId","paragraph_zero_based":23490},{"literal_text_all_w_t_and_m_t":"Identifier of the PUCCH resource.","paragraph_zero_based":23491},{"literal_text_all_w_t_and_m_t":"secondHopPRB","paragraph_zero_based":23492},{"literal_text_all_w_t_and_m_t":"Index of first PRB after frequency hopping of PUCCH. This value is applicable for intra-slot frequency hopping (see TS 38.213 [13], clause 9.2.1) or inter-slot frequency hopping (see TS 38.213 [13], clause 9.2.6).","paragraph_zero_based":23493},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23494},{"literal_text_all_w_t_and_m_t":"PUCCH-ResourceSet field descriptions","paragraph_zero_based":23495}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["9be1441c26992a40c2eade7a42a303266c89653b70df4bbd12c091220fd04666","9dd39ebd38a3c9428fe137501fb4221446c00504aa5d728aaacbd41547f1c8fa","483506e3e711a5c57f298b6636d7de34a204cc6ba4ffbf10029acf9e79882f50","34b2d7e845247de1275e069bd5a0021d56a443ee994b12aa9e941811c541bf2d","27b0c60bf53204b31f31e6685a118a0e8426d508e4690335f1ceea261477265d","25a8c6120c72ff2dbfac7652df992163c5000c7398dc6fb014252f42b8daf8fa","3bf55bd810bc54e1aae97f762557f7df066780509448f1f80e6e4a503287a76c","828d8ca11be0a7e513e8b72f7f59f11eddc17b27a8bb2bd3eb13e1643e4643a0","abd35cd4fba58d3b51e6008a7966d7e95ca29795fedd188db60ee3fb3c845258","6cc51f4f61edd74ece0a5a84ca0472213e4427c0f863192f4fb2ce0991b1c576","53bab610260a836667d9e4bc0c95f902539d3b240ff592dd4dff4ebaf37bb4fa","2bfb658674c9b2a1b414e92d2871fd293b40b3aa23efe25aee255e49fadd4454","4447cc90f0091cdc24d6f4adeb962966c4861c9baa285c61e367703914c36b66","050e5dffc098fec4e7aa3a9ef9cf8d3ecfcdd5f426c232d398f2a43208b54c44","7ff14114d21e568046f24dac530c2b54a94da655380820594d0aa7b67df352ba","8032f1ad08c29ae43b00382793e0cfe4c475c9d20ddcf918a4cd4f0a5742ab53","c5a1fd26104dafa0f138bf006386701cceb81305b359e34fd6c49c1978367c96","051515ae9cb9e6a60789a423b182b42ded645753a35739c93c743a1017e1d40c","30366d0dac3dd0354500ff5929642f4ddc478a17fbe3244b6f810a72bfa630b5","45c8f230c346f6c8c2d1be8a7d17ea3feb8a2dbbeca1d5ea954158049b06460d","556850de797085362d1df159aacf0baba86019feaa218a96c2efde3d1db1e059","642eae51150b6bd560dbc2a3710989a5bcb03173b1c5d6b6f2773ad4c84d00a7","598f2f60a936b4d5cc0e5076e026d40d1a9e158b9d2c133bb0add098b13e2d95","242c4f53225a4ec881a81ced8254bb742ca5dd3acc409fcb9733c21571ff4df2"],"paragraph_range_zero_based":[23472,23495],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p23472"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"maxPayloadSize","paragraph_zero_based":23496},{"literal_text_all_w_t_and_m_t":"Maximum number of UCI information bits that the UE may transmit using this PUCCH resource set (see TS 38.213 [13], clause 9.2.1). In a PUCCH occurrence, the UE chooses the first of its PUCCH-ResourceSet which supports the number of bits that the UE wants to transmit. The field is absent in the first set (Set0) and in the last configured set since the UE derives the maximum number of UCI information bits as specified in TS 38.213 [13], clause 9.2.1. This field can take integer values that are multiples of 4.","paragraph_zero_based":23497},{"literal_text_all_w_t_and_m_t":"resourceList","paragraph_zero_based":23498},{"literal_text_all_w_t_and_m_t":"PUCCH resources of format0 and format1 are only allowed in the first PUCCH resource set, i.e., in a PUCCH-ResourceSet with pucch-ResourceSetId = 0. This set may contain between 1 and 32 resources. PUCCH resources of format2, format3 and format4 are only allowed in a PUCCH-ResourceSet with pucch-ResourceSetId > 0. If present, these sets contain between 1 and 8 resources each. The UE chooses a PUCCH-Resource from this list as specified in TS 38.213 [13], clause 9.2.3. Note that this list contains only a list of resource IDs. The actual resources are configured in PUCCH-Config.","paragraph_zero_based":23499},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23500},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":23501},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":23502},{"literal_text_all_w_t_and_m_t":"PI2-BPSK","paragraph_zero_based":23503},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if format3 and/or format4 are configured and pi2BPSK is configured in each of them. It is absent, Need R otherwise.","paragraph_zero_based":23504},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23505},{"literal_text_all_w_t_and_m_t":"–PUCCH-ConfigCommon","paragraph_zero_based":23506},{"literal_text_all_w_t_and_m_t":"The IE PUCCH-ConfigCommon is used to configure the cell specific PUCCH parameters.","paragraph_zero_based":23507},{"literal_text_all_w_t_and_m_t":"PUCCH-ConfigCommon information element","paragraph_zero_based":23508},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":23509},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-CONFIGCOMMON-START","paragraph_zero_based":23510},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23511},{"literal_text_all_w_t_and_m_t":"PUCCH-ConfigCommon ::=              SEQUENCE {","paragraph_zero_based":23512},{"literal_text_all_w_t_and_m_t":"    pucch-ResourceCommon                INTEGER (0..15)                                      OPTIONAL,   -- Cond InitialBWP-Only","paragraph_zero_based":23513},{"literal_text_all_w_t_and_m_t":"    pucch-GroupHopping                  ENUMERATED { neither, enable, disable },","paragraph_zero_based":23514},{"literal_text_all_w_t_and_m_t":"    hoppingId                           INTEGER (0..1023)                                    OPTIONAL,   -- Need R","paragraph_zero_based":23515},{"literal_text_all_w_t_and_m_t":"    p0-nominal                          INTEGER (-202..24)                                   OPTIONAL,   -- Need R","paragraph_zero_based":23516},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":23517},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":23518},{"literal_text_all_w_t_and_m_t":"    nrofPRBs                            INTEGER (1..16)                                      OPTIONAL,   -- Need R","paragraph_zero_based":23519}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["23f55a40f58a70e24bbe395d558e7fa6281978476bdf438756ab4ed8b6404d44","191c2c3e4462c01871fe0cb8443520bb8021d4bc13cee190c4f8508a64210f6f","7a6f79973d1baf95dd358aaafa56d7ed33c2601cf9a75fa342a631971f512bb9","c4295bf336475e54c407efa749403a02ff3fe53ca68be24b03dfc09a30ca2580","dc098d84b8bbaad8ee0a0437be38cc6399e9909a15c240d4f6fcdd182590b62f","0174c58b4215f725cc5b2ce35a4eb5b34213fb26ad3add3323e8924b56d2a75e","c7bffc1df0f26089fbe9b0a7f0b592e1599d31fa4bb44e51c3862026da128a99","182a4176d1fe487a009d877423e1fbee101c1ab8ae0ba27e485cc06582f6b1ad","b7dadc8d92c21739a61a53327523987189c24a184826b8392df1035e73d10249","11cc09e423608e01df5dbec9305d85e1a92c9aec406ee73b5cfc1b0653ecd3ec","a54102af3b658a5102dc4e150eff927963914df635b42e8c8262f476285b418e","3483473a0cc9594f8332ba00bfbc31fb71e62e4f6192fb69abc24cbe6cfb0694","58a7c129346f098058583b95c457ce349a269c7c128c543cc01587b0fb01dec0","0b202d5b3390434ad0f002f5670e55d346ac58069d360d35ddab33d74c33cc3b","c0e2f2fa80d7c751bdb0b92747640d27472a9bc134d9dd53aba67bc32091c7a0","d14bc1ba858f0a23051beb06929b45cf7d9434a270a048b817d5d82605b05a6e","ee67cbcf1afb91cfee05072f3717b32eb7af81952ca81aa4dc9356feaad5ca4a","1c12b9a8b4dd5e2d2f2fad0596e806ef4cc20dddc82d89c0e9cc922edbf67d3b","31185ca4561600ca71a27fc27028f01b2b3ce2dd58dd3697dfc8cae8be50d7f2","a721cae91a741b4e15b115787f19c3defaa5dad7dd56411e6267d9aedabb22d0","9ff79124075f991b68b9991cdc890d40344109c8f503457188fe2f090350dff9","2aeff610fd85ed8ca85c0954159243046adc32141c967931e272c5adbb4b4992","3162313140b6c75d61d2fa5d288ebad1a12b06a0d48ac336e31eb95a682ad9a6","dc31630f3ac6912e704cbb9e1a675b9994ae3ec3fbd0b59eeffd80b170df2641"],"paragraph_range_zero_based":[23496,23519],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p23496"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    intra-SlotFH-r17                    ENUMERATED {fromLowerEdge, fromUpperEdge}            OPTIONAL,   -- Cond InitialBWP-RedCapOnly","paragraph_zero_based":23520},{"literal_text_all_w_t_and_m_t":"    pucch-ResourceCommonRedCap-r17     INTEGER (0..15)                                      OPTIONAL,   -- Cond InitialBWP-RedCap","paragraph_zero_based":23521},{"literal_text_all_w_t_and_m_t":"    additionalPRBOffset-r17                 ENUMERATED {n2, n3, n4, n6, n8, n9, n10, n12}        OPTIONAL    -- Cond InitialBWP-RedCapOnly","paragraph_zero_based":23522},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":23523},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":23524},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23525},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-CONFIGCOMMON-STOP","paragraph_zero_based":23526},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23527},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23528},{"literal_text_all_w_t_and_m_t":"PUCCH-ConfigCommon field descriptions","paragraph_zero_based":23529},{"literal_text_all_w_t_and_m_t":"additionalPRBOffset","paragraph_zero_based":23530},{"literal_text_all_w_t_and_m_t":"When intra-slot PUCCH frequency hopping within RedCap-specific initial UL BWP is disabled, each common PUCCH resource is mapped to a single PRB on one side of the UL BWP. This parameter determines an additional PRB offset in the PRB mapping for the PUCCH resource. If the field is not configured, the UE shall assume an additional PRB offset of zero.","paragraph_zero_based":23531},{"literal_text_all_w_t_and_m_t":"hoppingId","paragraph_zero_based":23532},{"literal_text_all_w_t_and_m_t":"Cell-specific scrambling ID for group hopping and sequence hopping if enabled, see TS 38.211 [16], clause 6.3.2.2.","paragraph_zero_based":23533},{"literal_text_all_w_t_and_m_t":"intra-SlotFH-r17","paragraph_zero_based":23534},{"literal_text_all_w_t_and_m_t":"In case a separate initial UL BWP is configured for RedCap UEs, the presence of this parameter indicates whether intra-slot PUCCH frequency hopping within the separate initial UL BWP in the common PUCCH resource is enabled for RedCap UEs. If this field is absent, intra-slot PUCCH frequency hopping within RedCap-specific initial UL BWP is enabled. If this field is present, intra-slot PUCCH frequency hopping within RedCap-specific initial UL BWP is disabled and each PUCCH resource is mapped to a single PRB on one side of the UL BWP and this parameter determines whether the PRB index in the PRB mapping is counted in increasing order from the lower edge or in decreasing order from the upper edge of the UL BWP.","paragraph_zero_based":23535},{"literal_text_all_w_t_and_m_t":"nrofPRBs","paragraph_zero_based":23536},{"literal_text_all_w_t_and_m_t":"Indicates the number of PRBs used per PUCCH resource for PUCCH format 0 and format 1 in FR2-2, see TS 38.213 [13], clause 9.2.1.","paragraph_zero_based":23537},{"literal_text_all_w_t_and_m_t":"p0-nominal","paragraph_zero_based":23538},{"literal_text_all_w_t_and_m_t":"Power control parameter P0 for PUCCH transmissions. Value in dBm. Only even values (step size 2) allowed (see TS 38.213 [13], clause 7.2).","paragraph_zero_based":23539},{"literal_text_all_w_t_and_m_t":"pucch-GroupHopping","paragraph_zero_based":23540},{"literal_text_all_w_t_and_m_t":"Configuration of group- and sequence hopping for all the PUCCH formats 0, 1, 3 and 4. Value neither implies neither group or sequence hopping is enabled. Value enable enables group hopping and disables sequence hopping. Value disable disables group hopping and enables sequence hopping (see TS 38.211 [16], clause 6.3.2.2).","paragraph_zero_based":23541},{"literal_text_all_w_t_and_m_t":"pucch-ResourceCommon","paragraph_zero_based":23542},{"literal_text_all_w_t_and_m_t":"An entry into a 16-row table where each row configures a set of cell-specific PUCCH resources/parameters. The UE uses those PUCCH resources until it is provided with a dedicated PUCCH-Config (e.g. during initial access) on the initial uplink BWP. Once the network provides a dedicated PUCCH-Config for that bandwidth part the UE applies that one instead of the one provided in this field (see TS 38.213 [13], clause 9.2).","paragraph_zero_based":23543}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["bf0fe60d4638d5ebe89504200d0525ccbd787d0ff7a9ac881c715e8200419c78","7b3d15df3769b23d83fddc2caf60ccd35ab4895289d311469c30f8850fa010bc","1fc67d046c684b4df9b17dc3b812d612fd8354a08481d0d6f9ff3107ee30898b","ef4cf1e9d7fb1d2beb1258e26109fa9b95c8cdc7b0e8f34b6a8348b42310d8df","04e46b269b4c5e1233b6a58af2b09faea60aee0e8e4866c21b55c4e6f395fd3d","6f041e48cb4d45842e35333a1f0d2b97f65f5a466329844e67e21b3e4829cd5f","c29fa1214975f1277cce7d34c9d6dc59e5c629b16ed9d2a1472d3b830920aa5a","9cf2253c0177cfc41d041a9af059222eb89f531143268e77f717fe29a461858d","9327f940643ee092def2668b6f1bd739d4d5b15ff11db3cd495f6a3d28bdeaeb","88e236ccc7dafe70501fbbdfd2c709a6512f1f91aad815aa81ae4cfe1faa7561","e0d911d624b441b5714949e4dce27ba92da051511f0ae5d526c45537031f1896","bf23c26c810cd1471040980e9d81a30e85e51ec92e714f736bd8209d22419c28","1347c621f646668348809cac84dae0051155c1e4b0b49145939e349644b4518e","08ed1fde0f7d48f8f58b22da62d617126c0423319e6a8436e1b66bf52d2266d8","66de67f6df3eb3ddfae5011730e627daefb7862ef0b70276fa48285ad41eae76","d78b81d92af08b96d78590bb6ab26b939a2a4622f82567b951d152aa5f8fd162","d0c8692f85aeb378c7b2a07a8428f5d977e7e062acb499c469f64a915e19228b","ac58780be12684047a2b7daa0f933ec971c760848472c7791dd6c447a2e45ca7","8d539443dcf7d6c13f2f04a88561cbadb3b60e2e1f6c0990b4cd9e3b2d28bb80","868bc427a008b4bff289da0fba8ebda56d8aaae8ffb65116b25c488ceb6cdd90","da4e60c541f9ff7e6e2eb5e57aee799f5b421c8ade708242f8ab62487a975d76","4455c37dfbe12918df15fc13a6452e0375978ce79accfa3e162abc5be81f4181","a1feebe21c9fd7b731c32902c9dfa784f9b6470e55b3d86cf6a114fba3c3e84e","2dea63b1a19e14e0da9bcac5c90b6c9f7e3475c2bc34c9aac00139c6f4406207"],"paragraph_range_zero_based":[23520,23543],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p23520"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"pucch-ResourceCommonRedCap","paragraph_zero_based":23544},{"literal_text_all_w_t_and_m_t":"An entry into a 16-row table where each row configures a set of cell-specific PUCCH resources/parameters for RedCap UEs. The UE uses those PUCCH resources until it is provided with a dedicated PUCCH-Config (e.g. during initial access) on the initial uplink BWP. Once the network provides a dedicated PUCCH-Config for that bandwidth part the UE applies that one instead of the one provided in this field (see TS 38.213 [13], clause 9.2).","paragraph_zero_based":23545},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23546},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":23547},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":23548},{"literal_text_all_w_t_and_m_t":"InitialBWP-Only","paragraph_zero_based":23549},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in the PUCCH-ConfigCommon of the initial BWP (BWP#0) in SIB1. It is absent in other BWPs including the RedCap-specific initial uplink BWP, if configured.","paragraph_zero_based":23550},{"literal_text_all_w_t_and_m_t":"InitialBWP-RedCap","paragraph_zero_based":23551},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in the PUCCH-ConfigCommon of the RedCap-specific initial BWP. It is optional present, Need R, in the PUCCH-ConfigCommon of the initial BWP configured by initialUplinkBWP. It is absent in other BWPs.","paragraph_zero_based":23552},{"literal_text_all_w_t_and_m_t":"InitialBWP-RedCapOnly","paragraph_zero_based":23553},{"literal_text_all_w_t_and_m_t":"The field is optional present, Need S, in the PUCCH-ConfigCommon of the RedCap-specific initial BWP. It is absent in other BWPs.","paragraph_zero_based":23554},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23555},{"literal_text_all_w_t_and_m_t":"–PUCCH-ConfigurationList","paragraph_zero_based":23556},{"literal_text_all_w_t_and_m_t":"The IE PUCCH-ConfigurationList is used to configure UE specific PUCCH parameters (per BWP) for two simultaneously constructed HARQ-ACK codebooks. See TS 38.213 [13], clause 9.1.","paragraph_zero_based":23557},{"literal_text_all_w_t_and_m_t":"PUCCH-ConfigurationList information element","paragraph_zero_based":23558},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":23559},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-CONFIGURATIONLIST-START","paragraph_zero_based":23560},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23561},{"literal_text_all_w_t_and_m_t":"PUCCH-ConfigurationList-r16  ::=     SEQUENCE (SIZE (1..2)) OF PUCCH-Config","paragraph_zero_based":23562},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23563},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-CONFIGURATIONLIST-STOP","paragraph_zero_based":23564},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23565},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23566},{"literal_text_all_w_t_and_m_t":"–PUCCH-PathlossReferenceRS-Id","paragraph_zero_based":23567}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["efba8016f6d6caa45c8aa75a404e76b2cb618bea38a9f3632baf101509881509","f0582022d3d12bb279441133c82b3c36bd9d54f459e611ac488f950014424454","cc6de0bb1da4f985618e46f1e2f0a0ff7ea267972885d774e5071c063af2f1ef","0f899c9f8e59083b2fec2c2f720ba7e04b06cd15203c503260f033fc919ca6eb","080ede4f727c194e917c114799279b9c54e25896ffa4a86f158628f0c18fc727","0d01d97b973b28657ab42a734f19dcf01bb6ca0747316107801