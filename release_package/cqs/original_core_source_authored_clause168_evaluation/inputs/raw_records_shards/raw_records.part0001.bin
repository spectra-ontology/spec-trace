{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":24792},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24793},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":24794},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24795},{"literal_text_all_w_t_and_m_t":"CFRA-CSIRS-Resource ::=         SEQUENCE {","paragraph_zero_based":24796},{"literal_text_all_w_t_and_m_t":"    csi-RS                          CSI-RS-Index,","paragraph_zero_based":24797},{"literal_text_all_w_t_and_m_t":"    ra-OccasionList                 SEQUENCE (SIZE(1..maxRA-OccasionsPerCSIRS)) OF INTEGER (0..maxRA-Occasions-1),","paragraph_zero_based":24798},{"literal_text_all_w_t_and_m_t":"    ra-PreambleIndex                INTEGER (0..63),","paragraph_zero_based":24799},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":24800},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":24801},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24802},{"literal_text_all_w_t_and_m_t":"-- TAG-RACH-CONFIGDEDICATED-STOP","paragraph_zero_based":24803},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":24804},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24805},{"literal_text_all_w_t_and_m_t":"CFRA-CSIRS-Resource field descriptions","paragraph_zero_based":24806},{"literal_text_all_w_t_and_m_t":"csi-RS","paragraph_zero_based":24807},{"literal_text_all_w_t_and_m_t":"The ID of a CSI-RS resource defined in the measurement object associated with this serving cell.","paragraph_zero_based":24808},{"literal_text_all_w_t_and_m_t":"ra-OccasionList","paragraph_zero_based":24809},{"literal_text_all_w_t_and_m_t":"RA occasions that the UE shall use when performing CF-RA upon selecting the candidate beam identified by this CSI-RS. The network ensures that the RA occasion indexes provided herein are also configured by prach-ConfigurationIndex and msg1-FDM. Each RACH occasion is sequentially numbered, first, in increasing order of frequency resource indexes for frequency multiplexed PRACH occasions; second, in increasing order of time resource indexes for time multiplexed PRACH occasions within a PRACH slot and Third, in increasing order of indexes for PRACH slots.","paragraph_zero_based":24810},{"literal_text_all_w_t_and_m_t":"ra-PreambleIndex","paragraph_zero_based":24811},{"literal_text_all_w_t_and_m_t":"The RA preamble index to use in the RA occasions associated with this CSI-RS.","paragraph_zero_based":24812},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24813},{"literal_text_all_w_t_and_m_t":"CFRA field descriptions","paragraph_zero_based":24814},{"literal_text_all_w_t_and_m_t":"occasions","paragraph_zero_based":24815}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["a9c1b093a7a5572742bc77da6f594196f5b924d07150730cf97dc99d67a365e4","421d4bec23fe595adcc780528234fe71167cc291ee558e8c77a564309510bb0b","b3aeb8ca9948407d81334a9d6f2476edbc84df8a612595135298992ee3c9d2b0","5756bde1390dc3f74cad63b27e5c5b19e69260db606db733cb79a38d808681dc","f59a121e5bb76e0f99a2a0cb5bfc02ddde1c5b22e2558139fbbbdf0f1ca0b638","ac340f8b952b63c49d3bd6405ea96c040e96b4f2cafa1954e9e487f309bca4df","fdd07c9f234481f6c7db09c7ba4526b4bbfdbf738e63b6fb443e04b4c6e2b2e1","cc611d7f88ba28ba9cb03810c0e4ca152849a6b3e9aac18d33cdd8337767a381","9bfdec0aecd406aaf57d4bd7136c11a12231a88ddef1dd784e35370f1a020395","a3447d74b1aaddc4c4cff26bc3e481e97fddce51eee9dcebca7176c0743cd67b","3504a9585267561f4eea4e54570d802680277c065089b0c08f1c697d29e0a9e8","5a8e3bffba27b5b7c413650f7700b28b04b66bcba9e5b9d706cb9ecd408960a8","66b47ae9850e5db9354b04278e70cddd88ac6cf11529c19a43b469f1a2cb8c38","0ad2eb1580f64cc36531c2252beea939e779e8dc7bfe761d04e4936ceb15c771","b0192a1a7a5a28fdcfd39edefddf502b6099edf35bd66ed840bbbc7de63ab809","e73e7226773532dab0c4418e666c041b78e2e98452096f3f4eec9cc0eda2f7c5","18b20c0064a0765b09d90b06c4b099510192a9eada44bf11fe8d8d95d1f86eb4","8d51c822f3fd1121057ce2b3ca96d9ea15cf6a30fe5dc1cd0485c386f9a1b2e8","eaab16c79efedb0dee61e5fd3961a0f6b8765aad3ff6333c8b50e5eb72eaa782","52e557cbe37eff3d8fe1da1a66a070719f81b5ffccd536685ea24088f4cd6f65","aa478c4c0088ca2e528a7c2d136cc7b0d352a2810b6f930ae225358ffa85cb05","26107772eaa44e6facd5d12cfc292147a568666cdc86bcdc09e2abb04762e35f","a7921a5aa8be55d961fd876255be6012c64d0dd6b66e85a206d0c2113d865d61","b93723a6a93313aceb3bfb1be5c8f82b3298f96ac0d76a3d307fe04c1b997a8d"],"paragraph_range_zero_based":[24792,24815],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p24792"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"RA occasions for contention free random access. If the field is absent, the UE uses the RA occasions configured in RACH-ConfigCommon in the first active UL BWP.","paragraph_zero_based":24816},{"literal_text_all_w_t_and_m_t":"ra-ssb-OccasionMaskIndex","paragraph_zero_based":24817},{"literal_text_all_w_t_and_m_t":"Explicitly signalled PRACH Mask Index for RA Resource selection in TS 38.321 [3]. The mask is valid for all SSB resources signalled in ssb-ResourceList.","paragraph_zero_based":24818},{"literal_text_all_w_t_and_m_t":"rach-ConfigGeneric","paragraph_zero_based":24819},{"literal_text_all_w_t_and_m_t":"Configuration of contention free random access occasions for CFRA. The UE shall ignore preambleReceivedTargetPower, preambleTransMax, powerRampingStep, ra-ResponseWindow signaled within this field and use the corresponding values provided in RACH-ConfigCommon.","paragraph_zero_based":24820},{"literal_text_all_w_t_and_m_t":"ssb-perRACH-Occasion","paragraph_zero_based":24821},{"literal_text_all_w_t_and_m_t":"Number of SSBs per RACH occasion.","paragraph_zero_based":24822},{"literal_text_all_w_t_and_m_t":"totalNumberOfRA-Preambles","paragraph_zero_based":24823},{"literal_text_all_w_t_and_m_t":"Total number of preambles used for contention free random access in the RACH resources defined in CFRA, excluding preambles used for other purposes (e.g. for SI request). If the field is absent but the field occasions is present, the UE may assume all the 64 preambles are for RA. The setting should be consistent with the setting of ssb-perRACH-Occasion, if present, i.e. it should be a multiple of the number of SSBs per RACH occasion.","paragraph_zero_based":24824},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24825},{"literal_text_all_w_t_and_m_t":"CFRA-SSB-Resource field descriptions","paragraph_zero_based":24826},{"literal_text_all_w_t_and_m_t":"msgA-PUSCH-Resource-Index","paragraph_zero_based":24827},{"literal_text_all_w_t_and_m_t":"Identifies the index of the PUSCH resource used for MSGA CFRA. The PUSCH resource index indicates a valid PUSCH occasion (as specified in TS 38.213 [13], clause 8.1A) and the associated DMRS resources corresponding to a PRACH slot. The PUSCH resource indexes are sequentially numbered and are mapped to valid PUSCH occasions corresponding to a PRACH slot which are ordered, first, in increasing order of frequency resource indexes for frequency multiplexed PUSCH occasions; second, in increasing order of DMRS resource indexes within a PUSCH occasion, where a DMRS resource index DMRSid is determined first in an ascending order of a DMRS port index and then in an ascending order of a DMRS sequence index, third in increasing order of time resource indexes for time multiplexed PUSCH occasions within a PUSCH slot and fourth, in increasing order of indexes for PUSCH slots. For the case of contention free 2-step random access type, if this field is absent, the UE shall use the value 0.","paragraph_zero_based":24828},{"literal_text_all_w_t_and_m_t":"ra-PreambleIndex","paragraph_zero_based":24829},{"literal_text_all_w_t_and_m_t":"The preamble index that the UE shall use when performing CF-RA upon selecting the candidate beams identified by this SSB.","paragraph_zero_based":24830},{"literal_text_all_w_t_and_m_t":"ssb","paragraph_zero_based":24831},{"literal_text_all_w_t_and_m_t":"The ID of an SSB transmitted by this serving cell.","paragraph_zero_based":24832},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24833},{"literal_text_all_w_t_and_m_t":"CFRA-TwoStep field descriptions","paragraph_zero_based":24834},{"literal_text_all_w_t_and_m_t":"msgA-CFRA-PUSCH","paragraph_zero_based":24835},{"literal_text_all_w_t_and_m_t":"PUSCH resource configuration(s) for msgA CFRA.","paragraph_zero_based":24836},{"literal_text_all_w_t_and_m_t":"msgA-TransMax","paragraph_zero_based":24837},{"literal_text_all_w_t_and_m_t":"Max number of MsgA preamble transmissions performed before switching to 4-step type random access (see TS 38.321 [3], clauses 5.1.1). This field is only applicable when 2-step and 4-step RA type are configured and switching to 4-step type RA is supported. If the field is absent in cfra-TwoStep, switching from 2-step RA type to 4-step RA type is not allowed.","paragraph_zero_based":24838},{"literal_text_all_w_t_and_m_t":"occasionsTwoStepRA","paragraph_zero_based":24839}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["7a6556e7fa83fcd31a96bdc7d8d66642a69be28d11b103ca9c54b9ef083dae84","97478393bd8a90ebaac5cece316c4c77e7b288f9ca5ad599c03b7b58b0bf22d4","f43c0ba09a7bf88996c1f899886368a5c25fb2a93a6410e1fdbe68fef3f3fb1c","43ac86dc5b2c95d23a3d3741fcbb578b73687af357fc50fb7a721df56c7709aa","961fc145ab8b5957c6a1d75c9317e180bc5567c42a411a3cccd1299053abbbaa","9fbc8095684d728edf26b3f5de6a3b53f6579e671a3f5cc55372187c511d987b","6eb2171efba31cf7741599a4be645a36dd4acaf527e6f814485110c6fa78834b","5480847e4c2e677f23e044ce5a4396cd01815a1a27c55a3b702388aed272c9f8","ce4d93f9c09a6312306ca16de9d31db46df42856b42c5c3a7792cae5546a6b2b","9aff8fc7dbfdb2de5dfa760abe4c86b58cdfb4859ababbb186f86fe01ac38be8","e549d4aa2b015d2cbccbb3bcd68aae8464ad95a76c8c2a30f39680dc6babfad0","fd1c4233b685c1325087bbf4f0df54f8bbd14cb5dfd45a07a8550188ea1eb552","706594c74bc8bfb82f0e8c9eda36ae7dc41367d7871343e91903885dfe58171f","fb4c44c9d02c8cf678eb585a996205cbd72a1f870c5bd2268a2602c7b2958ead","dab84c60640fdabfa6218016ed4b179ee8748c4a91d7580e7c9e15f0747fc7f3","7050245abd09200ca1b34bd08b24def705e74253540d04282bb8483190cdd1d7","caf2382d292266eaa0bc8951189fb0bd090f7772bf6f4d50b0d91b3ef3165fb1","c1a2d823a8423454362d16b9e65b7c445e272e482bc9123ebfa7dc75bfa10aa0","a5bc237f64e221334a5fb6351b46d419c2b9a2923311e3842c910665d7eb6156","d835e8671553c5282abe645cbe6520fe39cd3c5525491e2a37dbbdca41e02514","2aeefa2893722abd86c57438a39fd8a61aea41274f7e10b827bcfd4f4bb2b8e7","1aab6956d7b150adf0974f4c6075cb8c3ed3026cad486a9df00c4d925f65d845","e4aab95d7b6974015685b5abed1cbeb9df3b70a5974d6c292ef59dec4807604a","420760919c5a87f34d42afb791dd85f949b6f65745e08d09f5b413bcaad9b22b"],"paragraph_range_zero_based":[24816,24839],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p24816"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"RA occasions for contention free random access. If the field is absent, the UE uses the RA occasions configured in RACH-ConfigCommonTwoStepRA in the first active UL BWP.","paragraph_zero_based":24840},{"literal_text_all_w_t_and_m_t":"ra-SSB-OccasionMaskIndex","paragraph_zero_based":24841},{"literal_text_all_w_t_and_m_t":"Explicitly signalled PRACH Mask Index for RA Resource selection in TS 38.321 [3]. The mask is valid for all SSB resources signalled in ssb-ResourceList.","paragraph_zero_based":24842},{"literal_text_all_w_t_and_m_t":"rach-ConfigGenericTwoStepRA","paragraph_zero_based":24843},{"literal_text_all_w_t_and_m_t":"Configuration of contention free random access occasions for CFRA 2-step random access type.","paragraph_zero_based":24844},{"literal_text_all_w_t_and_m_t":"ssb-PerRACH-OccasionTwoStep","paragraph_zero_based":24845},{"literal_text_all_w_t_and_m_t":"Number of SSBs per RACH occasion for 2-step random access type.","paragraph_zero_based":24846},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24847},{"literal_text_all_w_t_and_m_t":"RACH-ConfigDedicated field descriptions","paragraph_zero_based":24848},{"literal_text_all_w_t_and_m_t":"cfra","paragraph_zero_based":24849},{"literal_text_all_w_t_and_m_t":"Parameters for contention free random access to a given target cell. If this field and cfra-TwoStep are absent, the UE performs contention based random access.","paragraph_zero_based":24850},{"literal_text_all_w_t_and_m_t":"cfra-TwoStep","paragraph_zero_based":24851},{"literal_text_all_w_t_and_m_t":"Parameters for contention free 2-step random access type to a given target cell. Network ensures that cfra and cfra-TwoStep are not configured at the same time. If this field and cfra are absent, the UE performs contention based random access. This field may only be present if msgA-ConfigCommon is configured on the BWP.","paragraph_zero_based":24852},{"literal_text_all_w_t_and_m_t":"ra-prioritization","paragraph_zero_based":24853},{"literal_text_all_w_t_and_m_t":"Parameters which apply for prioritized random access procedure to a given target cell (see TS 38.321 [3], clause 5.1.1).","paragraph_zero_based":24854},{"literal_text_all_w_t_and_m_t":"ra-PrioritizationTwoStep","paragraph_zero_based":24855},{"literal_text_all_w_t_and_m_t":"Parameters which apply for prioritized 2-step random access type procedure to a given target cell (see TS 38.321 [3], clause 5.1.1).","paragraph_zero_based":24856},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24857},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":24858},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":24859},{"literal_text_all_w_t_and_m_t":"Mandatory","paragraph_zero_based":24860},{"literal_text_all_w_t_and_m_t":"The field is mandatory present.","paragraph_zero_based":24861},{"literal_text_all_w_t_and_m_t":"Occasions","paragraph_zero_based":24862},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need S, if the field occasions is present, otherwise it is absent.","paragraph_zero_based":24863}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["736e90fa47822633ec4004e4b9c87f127c8d728d7736a7beaa20c3ebc736cc9b","d411835285b7f3db692d0680f43a46fabb7ba9c6ed57cc096f82e546628cd8dc","d4003ae0e6aefa3f2384b09a54cfc67e534869ddb0938eeea9d8fc5a6741f5c6","6a4ccfd88aea9149fc95f8284064c58209cbfe8db6b7785c4a45c4d35962eaea","462ff2206ee52af3e4e1d666170c4bb33b2adfb3093265352f9b328056417fb7","376fec13ac3e87f9ccb88bd4e9c2bab688ca55e505050930f520dcf7839fedd6","866e3effed5a9db6423e4567aa923a831fbe8d7abbb81231a2bea0fde92e724d","4592b6bb3a51fb4149d6aff1e246de2bc30d10ea149fd3bf59727f424eae1dd8","1aa2eec416c9d451b8ee24d1c300806f8039ecd63f0afffe65d42b0bf51c35f3","6530cf638cd1d557e31f449ecb27361cacbe651b83643c01b8b70dbe0829747e","17295f0c9a68b5d2d90d228cb2e56b931fb74e5394f84e7eb6429139118cf34c","331ac961d3fbcc9cf2f8b911aa83ee4f44d3074c0f67f18d6168e313ea0684ff","183ad57e5d4ded356e621e2be45b7fd0e6569c8b23bf1cee2b5a843e92b6c60c","e3d0672bc5d8c6cf8ce0d3f96eed942d5437d2a69f25226498d7b0346ce01386","645eb9aec230d2e2c72706a8049e4bd88e6fd9bd96dde6ad9215d49a41dd04f2","572257ca78489f918b37c778ea423a8da89a70dc4394aaeebda884072b57757a","73ebef6ce319dcb02df5d4d1bd57dddb41494fc676e3fb93709cbeb15f2cacd5","611c02a57c2188b86a37fd9cbca9ae6dbca0a743c5d93b0b33a145831deae2cc","6acab494e7b61ae660eae4531ce5fbb7f8c5389a5a2dc9147565dd77a16607ea","060698e2758b86474f0a9335e7cf0525ac50fe6b98c555f1a15752b74928d933","5dbf089ae4635d5771f1efd8b0eafc71e2ce5facabb91e06da2c9e4a98a02d45","1fcd259da33a80adb4b220b88253cec4bd20873f0410be67e48a1e02322afdeb","fc6b661cbd90d780366df7aa266b764f519619688cbbd76b632e0b4bcdd8fefd","cc9af346f1a2e3273a41e444c37379fec1008684bbec95251d02f15e7f913f2c"],"paragraph_range_zero_based":[24840,24863],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p24840"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2StepCFRA","paragraph_zero_based":24864},{"literal_text_all_w_t_and_m_t":"The field is optionally present for the case of 2-step RA type contention free random access, Need S, otherwise it is absent.","paragraph_zero_based":24865},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24866},{"literal_text_all_w_t_and_m_t":"–RACH-ConfigGeneric","paragraph_zero_based":24867},{"literal_text_all_w_t_and_m_t":"The IE RACH-ConfigGeneric is used to specify the random-access parameters both for regular random access as well as for beam failure recovery.","paragraph_zero_based":24868},{"literal_text_all_w_t_and_m_t":"RACH-ConfigGeneric information element","paragraph_zero_based":24869},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":24870},{"literal_text_all_w_t_and_m_t":"-- TAG-RACH-CONFIGGENERIC-START","paragraph_zero_based":24871},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24872},{"literal_text_all_w_t_and_m_t":"RACH-ConfigGeneric ::=              SEQUENCE {","paragraph_zero_based":24873},{"literal_text_all_w_t_and_m_t":"    prach-ConfigurationIndex            INTEGER (0..255),","paragraph_zero_based":24874},{"literal_text_all_w_t_and_m_t":"    msg1-FDM                            ENUMERATED {one, two, four, eight},","paragraph_zero_based":24875},{"literal_text_all_w_t_and_m_t":"    msg1-FrequencyStart                 INTEGER (0..maxNrofPhysicalResourceBlocks-1),","paragraph_zero_based":24876},{"literal_text_all_w_t_and_m_t":"    zeroCorrelationZoneConfig           INTEGER(0..15),","paragraph_zero_based":24877},{"literal_text_all_w_t_and_m_t":"    preambleReceivedTargetPower         INTEGER (-202..-60),","paragraph_zero_based":24878},{"literal_text_all_w_t_and_m_t":"    preambleTransMax                    ENUMERATED {n3, n4, n5, n6, n7, n8, n10, n20, n50, n100, n200},","paragraph_zero_based":24879},{"literal_text_all_w_t_and_m_t":"    powerRampingStep                    ENUMERATED {dB0, dB2, dB4, dB6},","paragraph_zero_based":24880},{"literal_text_all_w_t_and_m_t":"    ra-ResponseWindow                   ENUMERATED {sl1, sl2, sl4, sl8, sl10, sl20, sl40, sl80},","paragraph_zero_based":24881},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":24882},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":24883},{"literal_text_all_w_t_and_m_t":"    prach-ConfigurationPeriodScaling-IAB-r16    ENUMERATED {scf1,scf2,scf4,scf8,scf16,scf32,scf64}              OPTIONAL,   -- Need R","paragraph_zero_based":24884},{"literal_text_all_w_t_and_m_t":"    prach-ConfigurationFrameOffset-IAB-r16      INTEGER (0..63)                                                 OPTIONAL,   -- Need R","paragraph_zero_based":24885},{"literal_text_all_w_t_and_m_t":"    prach-ConfigurationSOffset-IAB-r16          INTEGER (0..39)                                                 OPTIONAL,   -- Need R","paragraph_zero_based":24886},{"literal_text_all_w_t_and_m_t":"    ra-ResponseWindow-v1610                     ENUMERATED { sl60, sl160}                                       OPTIONAL,   -- Need R","paragraph_zero_based":24887}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["10263d15e7c56773723df61cb2774aaff6f0ddf59957f03a4b191cdd51fc8b48","ed7367b0e43993fba6fd9b594ce754a55c58c248b3da99b7c6b385856ef21a84","6f67ecffec86834b84447fb4b5b2fb86ef556237b5f261b80d611aa17d5b5898","3d3846b8fec9b5bfc2c8a55b26c953081bc95cf79cab2f20798c16aee4bdee9a","1367fe0da39f8b6fb737e406bdef50ac99b2ed013498aa7f4378cea83e407964","a03646c79