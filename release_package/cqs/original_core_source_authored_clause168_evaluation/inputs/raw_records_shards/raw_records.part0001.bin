{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    nrofPorts                           ENUMERATED {p1,p2,p4,p8,p12,p16,p24,p32},","paragraph_zero_based":17424},{"literal_text_all_w_t_and_m_t":"    firstOFDMSymbolInTimeDomain         INTEGER (0..13),","paragraph_zero_based":17425},{"literal_text_all_w_t_and_m_t":"    firstOFDMSymbolInTimeDomain2        INTEGER (2..12)                                                         OPTIONAL,   -- Need R","paragraph_zero_based":17426},{"literal_text_all_w_t_and_m_t":"    cdm-Type                            ENUMERATED {noCDM, fd-CDM2, cdm4-FD2-TD2, cdm8-FD2-TD4},","paragraph_zero_based":17427},{"literal_text_all_w_t_and_m_t":"    density                             CHOICE {","paragraph_zero_based":17428},{"literal_text_all_w_t_and_m_t":"        dot5                                ENUMERATED {evenPRBs, oddPRBs},","paragraph_zero_based":17429},{"literal_text_all_w_t_and_m_t":"        one                                 NULL,","paragraph_zero_based":17430},{"literal_text_all_w_t_and_m_t":"        three                               NULL,","paragraph_zero_based":17431},{"literal_text_all_w_t_and_m_t":"        spare                               NULL","paragraph_zero_based":17432},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":17433},{"literal_text_all_w_t_and_m_t":"    freqBand                            CSI-FrequencyOccupation,","paragraph_zero_based":17434},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":17435},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":17436},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17437},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-RS-RESOURCEMAPPING-STOP","paragraph_zero_based":17438},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17439},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17440},{"literal_text_all_w_t_and_m_t":"CSI-RS-ResourceMapping field descriptions","paragraph_zero_based":17441},{"literal_text_all_w_t_and_m_t":"cdm-Type","paragraph_zero_based":17442},{"literal_text_all_w_t_and_m_t":"CDM type (see TS 38.214 [19], clause 5.2.2.3.1).","paragraph_zero_based":17443},{"literal_text_all_w_t_and_m_t":"density","paragraph_zero_based":17444},{"literal_text_all_w_t_and_m_t":"Density of CSI-RS resource measured in RE/port/PRB (see TS 38.211 [16], clause 7.4.1.5.3).","paragraph_zero_based":17445},{"literal_text_all_w_t_and_m_t":"Values 0.5 (dot5), 1 (one) and 3 (three) are allowed for X=1, values 0.5 (dot5) and 1 (one) are allowed for X=2, 16, 24 and 32, value 1 (one) is allowed for X=4, 8, 12.","paragraph_zero_based":17446},{"literal_text_all_w_t_and_m_t":"For density = 1/2, includes 1-bit indication for RB level comb offset indicating whether odd or even RBs are occupied by CSI-RS.","paragraph_zero_based":17447}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["49dad75c7ad79ef006d16bb012f52c31a03f800920ffebf373e048992a7f702f","1a3b31dedd46e05b5110096d8f9f405534e2030f024852fd908d21075d69de4a","207160e0c8bb3367a4504048bcd4134b54cf63ac7b289e6707b4a53979d5f48d","bd3395edcdde7c2985a4bc201bf640df3ad9dcaed0fa5ed5e8f5cfad2fdf31ea","cc57c6f39540b5ad61c55854e8ca51b819397ecb337a8be2e3c64ae93a66e9e1","1d614f06a4d95d71fe0703c2cababfacbd0873e40ad60481ba3ce862c7846250","61a0cca1b590b4829437acf2a0585fbc9e651432b0ab2fff8298c82b25ca7bd3","a6bfe4b51db704186e8b6a43918f177c6a2f7a45c70bc5ff4cb6b0a94184a6d1","2d78c376e1c96ea08703b64616ab759ac3d6f37008ec1c6146e2b23000137224","4851b366c55bc05379002758a8116ad97e4563a19823e39e1e56a42505be6b15","fccd98f6777ae07dd77ac2255b00440571423bdf9acb43570f0f97e978086dfd","d22c574c6075413dc0cef27e84346724d56627f7b2e680eae7eb469b4fbe844e","46698b9b8435204f433c58e7fb59929ebcc2cef98e02c90cd5a5f8c5645380d2","dec41035cc72541b90cbbf73eaeaf105574d9e83cf6d7b7efd2b3612c885d3ee","853a16128a89c8c29c6486530542fdf3d775ed3728a23df1a4bd40e66ecf99f5","fd5f1dc57b1a00019ebcb35d6456e905b7bc3abf2da30fae02a68b7e06396458","32a3c6bcbbdb772fc55a74b11b908260e3b918ea262b0aa362c414ab2f23ef10","fa1334cf3a6be395d641f14addc7c4a5635342586af7cf2b80516eb200b53791","a2171a758927358a7697615f4441065b01e3cb96e53f277c77c8b5b88dcd4742","dea828fabdbc01e7a84690037d7e9f83e499e7e42b7a95f12af9c420a33a48f4","30dcb0e1b090a1435195d0e01bdf2e2c1d37087cd90c108c1a51626107559ebf","2d6f3e60a76a3d19851c8717703de7b126861c9203e6e35a3da22e3d49560fdb","0c9c4de7c22713fd0c63231cd40e3110cebbc9aa43d023de2ab0365546ae8d88","4b4bf1c2a72e4bd528906fdbc37916c7fd037cffa1ebeac0660b7adbd3874c86"],"paragraph_range_zero_based":[17424,17447],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p17424"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"firstOFDMSymbolInTimeDomain2","paragraph_zero_based":17448},{"literal_text_all_w_t_and_m_t":"Time domain allocation within a physical resource block. See TS 38.211 [16], clause 7.4.1.5.3.","paragraph_zero_based":17449},{"literal_text_all_w_t_and_m_t":"firstOFDMSymbolInTimeDomain","paragraph_zero_based":17450},{"literal_text_all_w_t_and_m_t":"Time domain allocation within a physical resource block. The field indicates the first OFDM symbol in the PRB used for CSI-RS. See TS 38.211 [16], clause 7.4.1.5.3.","paragraph_zero_based":17451},{"literal_text_all_w_t_and_m_t":"freqBand","paragraph_zero_based":17452},{"literal_text_all_w_t_and_m_t":"Wideband or partial band CSI-RS, (see TS 38.214 [19], clause 5.2.2.3.1).","paragraph_zero_based":17453},{"literal_text_all_w_t_and_m_t":"frequencyDomainAllocation","paragraph_zero_based":17454},{"literal_text_all_w_t_and_m_t":"Frequency domain allocation within a physical resource block in accordance with TS 38.211 [16], clause 7.4.1.5.3. The applicable row number in table 7.4.1.5.3-1 is determined by the frequencyDomainAllocation for rows 1, 2 and 4, and for other rows by matching the values in the column Ports, Density and CDMtype in table 7.4.1.5.3-1 with the values of nrofPorts, cdm-Type and density below and, when more than one row has the 3 values matching, by selecting the row where the column (k bar, l bar) in table 7.4.1.5.3-1 has indexes for k ranging from 0 to 2*n-1 where n is the number of bits set to 1 in frequencyDomainAllocation.","paragraph_zero_based":17455},{"literal_text_all_w_t_and_m_t":"nrofPorts","paragraph_zero_based":17456},{"literal_text_all_w_t_and_m_t":"Number of ports (see TS 38.214 [19], clause 5.2.2.3.1).","paragraph_zero_based":17457},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17458},{"literal_text_all_w_t_and_m_t":"–CSI-SemiPersistentOnPUSCH-TriggerStateList","paragraph_zero_based":17459},{"literal_text_all_w_t_and_m_t":"The CSI-SemiPersistentOnPUSCH-TriggerStateList IE is used to configure the UE with list of trigger states for semi-persistent reporting of channel state information on L1. See also TS 38.214 [19], clause 5.2.","paragraph_zero_based":17460},{"literal_text_all_w_t_and_m_t":"CSI-SemiPersistentOnPUSCH-TriggerStateList information element","paragraph_zero_based":17461},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17462},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-SEMIPERSISTENTONPUSCHTRIGGERSTATELIST-START","paragraph_zero_based":17463},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17464},{"literal_text_all_w_t_and_m_t":"CSI-SemiPersistentOnPUSCH-TriggerStateList ::= SEQUENCE(SIZE (1..maxNrOfSemiPersistentPUSCH-Triggers)) OF CSI-SemiPersistentOnPUSCH-TriggerState","paragraph_zero_based":17465},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17466},{"literal_text_all_w_t_and_m_t":"CSI-SemiPersistentOnPUSCH-TriggerState ::=     SEQUENCE {","paragraph_zero_based":17467},{"literal_text_all_w_t_and_m_t":"    associatedReportConfigInfo                     CSI-ReportConfigId,","paragraph_zero_based":17468},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":17469},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":17470},{"literal_text_all_w_t_and_m_t":"    sp-CSI-MultiplexingMode-r17                ENUMERATED {enabled}                                           OPTIONAL   -- Need R","paragraph_zero_based":17471}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["83d8b4cf68