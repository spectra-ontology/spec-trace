{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"T-Offset-r16 ::= ENUMERATED {ms0dot5, ms0dot75, ms1, ms1dot5, ms2, ms2dot5, ms3, spare1}","paragraph_zero_based":43512},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43513},{"literal_text_all_w_t_and_m_t":"CandidateCellInfoListCPC-r17 ::= SEQUENCE (SIZE (1..maxFreq)) OF CandidateCellInfo-r17","paragraph_zero_based":43514},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43515},{"literal_text_all_w_t_and_m_t":"CandidateCellInfo-r17 ::=        SEQUENCE {","paragraph_zero_based":43516},{"literal_text_all_w_t_and_m_t":"    ssbFrequency-r17                 ARFCN-ValueNR,","paragraph_zero_based":43517},{"literal_text_all_w_t_and_m_t":"    candidateList-r17                SEQUENCE (SIZE (1..maxNrofCondCells-r16)) OF CandidateCell-r17","paragraph_zero_based":43518},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":43519},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43520},{"literal_text_all_w_t_and_m_t":"CandidateCell-r17 ::=            SEQUENCE {","paragraph_zero_based":43521},{"literal_text_all_w_t_and_m_t":"    physCellId-r17                   PhysCellId,","paragraph_zero_based":43522},{"literal_text_all_w_t_and_m_t":"    condExecutionCondSCG-r17         OCTET STRING (CONTAINING CondReconfigExecCondSCG-r17)               OPTIONAL","paragraph_zero_based":43523},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":43524},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43525},{"literal_text_all_w_t_and_m_t":"-- TAG-CG-CONFIG-STOP","paragraph_zero_based":43526},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":43527},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43528},{"literal_text_all_w_t_and_m_t":"CG-Config field descriptions","paragraph_zero_based":43529},{"literal_text_all_w_t_and_m_t":"candidateCellInfoListCPC","paragraph_zero_based":43530},{"literal_text_all_w_t_and_m_t":"Contains information regarding candidate target cells for Conditional PSCell Change (CPC) that the source secondary gNB suggests the target secondary gNB to consider configuring for CPC.","paragraph_zero_based":43531},{"literal_text_all_w_t_and_m_t":"candidateCellInfoListSN","paragraph_zero_based":43532},{"literal_text_all_w_t_and_m_t":"Contains information regarding cells that the source secondary node suggests the target secondary gNB to consider configuring.","paragraph_zero_based":43533},{"literal_text_all_w_t_and_m_t":"candidateCellInfoListSN-EUTRA","paragraph_zero_based":43534},{"literal_text_all_w_t_and_m_t":"Includes the MeasResultList3EUTRA as specified in TS 36.331 [10]. Contains information regarding cells that the source secondary node suggests the target secondary eNB to consider configuring. This field is only used in NE-DC.","paragraph_zero_based":43535}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["331ad1fb6e6676dcea90288787c908be6d5ea3028647c07c557b62ca2c46938a","6dc3a8c2f01b76e791680b20776002b15979fdbc309ed1c2b51a2bbe4cb9318d","e2f1561a1f955dac809f9f6914c783aa7a821361cd9817c156d4e2c93a30682c","d47099914e82cc86db8b694f243930cd36b081f5242e732cee86ea74ba11643d","c3e00834a9b60bb280c32c11054722cfefb6644fff3d354af2fa7d4ca8840809","fdff9fa42271713639b7489a916c54896ab214b61f9af3d2bc2558c8f2f8037f","d68d413a610d9f8191582c3323bb9b8885a42ede346ae1e51ff2f564b97a3607","c37324e03ae829d60e141563cd1edd737dc2206d2854f99c170efaa6a6c483c7","808040fcf5a6616fe47501357a3ffb1d2c24ea09942fe168c1facde60b4e2f27","8011e8d197e91f5015756caa9288fe8c99be44448c912e1cd9e951ebbae41e2d","a015355d