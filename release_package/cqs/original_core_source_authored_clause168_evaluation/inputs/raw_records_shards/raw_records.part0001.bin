4036e388d907b6f49d3ed8ddb92ef7688cbb7d3a1372065ca5540be03a1","d88b3b839f075aafa9e7f479fb6f04aaddea46e3051b16ac370b2d289ad374e0","32ad2f0392ee2d1c00feadb0e1122533e03e4e60d7e3d5c02a4c53b139775397","bf154555b130c0672a47d85a30a787d6c16712a1af336a7bf4ef20c8649112ef","4a79b4bc6ca8239cd22348ea0944358dbd1a95155b70d8d197af051d89373e5c","9e7c37be01e96c5eca92d57d054ed450c939dc446dae728679e4a69710218795","5df794c60ad482e1ee2686dcb9f90a569501fcb61f47b31f945738900ab1b906","b52b4296e5879c66ed7110666c637eee65e179e5c39b35debe9cf31e2d4079fb","ab828961c5eeb4b249a2de84f8607108d5589c63ce5e537c46f15b44e2603b38"],"paragraph_range_zero_based":[672,695],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313691.zip::R2-2313691_Introduction of support for BWP operation without restriction in TS38.331.docx:p672"}
{"fields":{"filename":"R2-2313691.zip::R2-2313691_Introduction of support for BWP operation without restriction in TS38.331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"interFreq-needForGap","paragraph_zero_based":696},{"literal_text_all_w_t_and_m_t":"Indicates the measurement gap requirement information for NR inter-frequency measurement.","paragraph_zero_based":697},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":698},{"literal_text_all_w_t_and_m_t":"NeedForGapsIntraFreq field descriptions","paragraph_zero_based":699},{"literal_text_all_w_t_and_m_t":"servCellId","paragraph_zero_based":700},{"literal_text_all_w_t_and_m_t":"Indicates the serving cell which contains the target SSB (associated with the initial DL BWP) to be measured. ","paragraph_zero_based":701},{"literal_text_all_w_t_and_m_t":"gapIndicationIntra","paragraph_zero_based":702},{"literal_text_all_w_t_and_m_t":"Indicates whether measurement gap is required for the UE to perform intra-frequency SSB based measurements on the concerned serving cell. Value gap indicates that a measurement gap is needed if any of the UE configured BWPs (except the BWP(s) configured with servingCellMO associated with NCD-SSB) do not contain the frequency domain resources of the SSB associated to the initial DL BWP (CD-SSB). Value no-gap indicates a measurement gap is not needed to measure the SSB associated to the initial DL BWP (CD-SSB) for all configured BWPs (except the BWP(s) configured with servingCellMO associated with NCD-SSB), no matter the SSB is within the configured BWP or not. This field shall be set to ‘no-gap’ for the corresponding band(s) where bwpOperationMeasWithoutInterrupt-r18 is supported by the UE.","paragraph_zero_based":703},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":704},{"literal_text_all_w_t_and_m_t":"NeedForGapsNR field descriptions","paragraph_zero_based":705},{"literal_text_all_w_t_and_m_t":"bandNR","paragraph_zero_based":706},{"literal_text_all_w_t_and_m_t":"Indicates the NR target band to be measured.","paragraph_zero_based":707},{"literal_text_all_w_t_and_m_t":"gapIndication","paragraph_zero_based":708},{"literal_text_all_w_t_and_m_t":"Indicates whether measurement gap is required for the UE to perform SSB based measurements on the concerned NR target band while NR-DC or NE-DC is not configured. The UE determines this information based on the resultant configuration of the RRCReconfiguration or RRCResume message that triggers this response. Value gap indicates that a measurement gap is needed, value no-gap indicates a measurement gap is not needed. ","paragraph_zero_based":709},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":710},{"literal_text_all_w_t_and_m_t":"Next change ","paragraph_zero_based":711},{"literal_text_all_w_t_and_m_t":"–NeedForGapNCSG-InfoNR","paragraph_zero_based":712},{"literal_text_all_w_t_and_m_t":"The IE NeedForGapNCSG-InfoNR indicates whether measurement gap or NCSG is required for the UE to perform SSB based measurements on an NR target band while NR-DC or NE-DC is not configured.","paragraph_zero_based":713},{"literal_text_all_w_t_and_m_t":"NeedForGapNCSG-InfoNR information element","paragraph_zero_based":714},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":715},{"literal_text_all_w_t_and_m_t":"-- TAG-NEEDFORGAPNCSG-INFONR-START","paragraph_zero_based":716},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":717},{"literal_text_all_w_t_and_m_t":"NeedForGapNCSG-InfoNR-r17 ::=     SEQUENCE {","paragraph_zero_based":718},{"literal_text_all_w_t_and_m_t":"    intraFreq-needForNCSG-r17         NeedForNCSG-IntraFreqList-r17,","paragraph_zero_based":719}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"61f02ceef1d524906560f8f1a482d15e83f76eb00023609c334c63ed8d6c34a9","original_member_sha256"