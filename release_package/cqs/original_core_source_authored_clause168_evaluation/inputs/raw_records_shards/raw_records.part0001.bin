{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25248},{"literal_text_all_w_t_and_m_t":"–RA-Prioritization","paragraph_zero_based":25249},{"literal_text_all_w_t_and_m_t":"The IE RA-Prioritization is used to configure prioritized random access.","paragraph_zero_based":25250},{"literal_text_all_w_t_and_m_t":"RA-Prioritization information element","paragraph_zero_based":25251},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25252},{"literal_text_all_w_t_and_m_t":"-- TAG-RA-PRIORITIZATION-START","paragraph_zero_based":25253},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25254},{"literal_text_all_w_t_and_m_t":"RA-Prioritization ::=           SEQUENCE {","paragraph_zero_based":25255},{"literal_text_all_w_t_and_m_t":"    powerRampingStepHighPriority    ENUMERATED {dB0, dB2, dB4, dB6},","paragraph_zero_based":25256},{"literal_text_all_w_t_and_m_t":"    scalingFactorBI                 ENUMERATED {zero, dot25, dot5, dot75}                               OPTIONAL,   -- Need R","paragraph_zero_based":25257},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":25258},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25259},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25260},{"literal_text_all_w_t_and_m_t":"-- TAG-RA-PRIORITIZATION-STOP","paragraph_zero_based":25261},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":25262},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25263},{"literal_text_all_w_t_and_m_t":"RA-Prioritization field descriptions","paragraph_zero_based":25264},{"literal_text_all_w_t_and_m_t":"powerRampingStepHighPrioritiy","paragraph_zero_based":25265},{"literal_text_all_w_t_and_m_t":"Power ramping step applied for prioritized random access procedure.","paragraph_zero_based":25266},{"literal_text_all_w_t_and_m_t":"scalingFactorBI","paragraph_zero_based":25267},{"literal_text_all_w_t_and_m_t":"Scaling factor for the backoff indicator (BI) for the prioritized random access procedure. (see TS 38.321 [3], clause 5.1.4). Value zero corresponds to 0, value dot25 corresponds to 0.25 and so on.","paragraph_zero_based":25268},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25269},{"literal_text_all_w_t_and_m_t":"–RA-PrioritizationForSlicing","paragraph_zero_based":25270},{"literal_text_all_w_t_and_m_t":"The IE RA-PrioritizationForSlicing is used to configure prioritized random access for slicing.","paragraph_zero_based":25271}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["fcf48e6d5b400eeb69129d054c2cd4059d5fa0546f5e1a99072a1e84332b9559","8106ea64bd1e4989a0983903359f08b9a3067c00dff593c3d433423ba9532985","05d9f33fb03036c1d2903879140f38ea647013391d7834091020db94fd21a680","3041ba2e4812111ead0ec5bb4660e2e8c43dcc8c4cebb7e27ce96efd17e77fb5","9998fb90f460c211163225e773c364f91778ca04f64c7e99c7c7dcb3588c2280","d0d288e9c96c8f2c946609a173e77fb47870c2d5336d3b10d4279af2b773960f","2ebb0d14da3eb30ab5d6c6dc6fab059598129d3e323d7fa5f457105ef41d4468","3f5cc5bea6f7a97ddd072528e7260574e6a34ed69f1c3fada56671f9e31be47b","283fb9e7d70fa74febd6f0c964c1a30580f419bdd1b31a590250babeed4764c4","84059e03efc1620464bf1fac4ffa52254559837d12920de38bfc2ca39997bbfd","6bce97a15403bbd9c00edebf3cb6c5cc53ff9f773bd7b9653dd07272351230cf","d3a32377effaf6f25fa541ae8cfa5e0626ea0a13c58f4fb9326f3a864523e9e8","3a63ad454499732da4b9e942b095e2aba0ed6e3cbceac6e1509d8d5ec590e610","4391ef7ef589120ec96738feaccfa064251ae65d414bc6f2cf3912b886cf1ca7","c4a3e52e32dd6ccf0d4c6a7818f2861802a7042d0a1fdd0cc127b48e9e8a7dbe","19