{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"NTN-Config information element","paragraph_zero_based":21456},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21457},{"literal_text_all_w_t_and_m_t":"-- TAG-NTN-CONFIG-START","paragraph_zero_based":21458},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21459},{"literal_text_all_w_t_and_m_t":"NTN-Config-r17 ::=             SEQUENCE {","paragraph_zero_based":21460},{"literal_text_all_w_t_and_m_t":"    epochTime-r17                  EpochTime-r17                                                            OPTIONAL,  -- Need R","paragraph_zero_based":21461},{"literal_text_all_w_t_and_m_t":"    ntn-UlSyncValidityDuration-r17 ENUMERATED{ s5, s10, s15, s20, s25, s30, s35,","paragraph_zero_based":21462},{"literal_text_all_w_t_and_m_t":"                                              s40, s45, s50, s55, s60, s120, s180, s240, s900}              OPTIONAL,  -- Cond SIB19","paragraph_zero_based":21463},{"literal_text_all_w_t_and_m_t":"    cellSpecificKoffset-r17        INTEGER(1..1023)                                                         OPTIONAL,  -- Need R","paragraph_zero_based":21464},{"literal_text_all_w_t_and_m_t":"    kmac-r17                       INTEGER(1..512)                                                          OPTIONAL,  -- Need R","paragraph_zero_based":21465},{"literal_text_all_w_t_and_m_t":"    ta-Info-r17                    TA-Info-r17                                                              OPTIONAL,  -- Need R","paragraph_zero_based":21466},{"literal_text_all_w_t_and_m_t":"    ntn-PolarizationDL-r17         ENUMERATED {rhcp,lhcp,linear}                                            OPTIONAL,  -- Need R","paragraph_zero_based":21467},{"literal_text_all_w_t_and_m_t":"    ntn-PolarizationUL-r17         ENUMERATED {rhcp,lhcp,linear}                                            OPTIONAL,  -- Need R","paragraph_zero_based":21468},{"literal_text_all_w_t_and_m_t":"    ephemerisInfo-r17              EphemerisInfo-r17                                                        OPTIONAL,  -- Need R","paragraph_zero_based":21469},{"literal_text_all_w_t_and_m_t":"    ta-Report-r17                  ENUMERATED {enabled}                                                     OPTIONAL,  -- Need R","paragraph_zero_based":21470},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":21471},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21472},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21473},{"literal_text_all_w_t_and_m_t":"EpochTime-r17 ::=              SEQUENCE {","paragraph_zero_based":21474},{"literal_text_all_w_t_and_m_t":"    sfn-r17                        INTEGER(0..1023),","paragraph_zero_based":21475},{"literal_text_all_w_t_and_m_t":"    subFrameNR-r17                 INTEGER(0..9)","paragraph_zero_based":21476},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21477},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21478},{"literal_text_all_w_t_and_m_t":"TA-Info-r17 ::=                 SEQUENCE  {","paragraph_zero_based":21479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["0459e492ad6b5ef7d9af50f613d258472e064e3862c59b743d084bc2a19b8846","67c83ea5bfdb1608dc8ad93c50d091bd17d69f309616cf802cb99ea6aee511e3","dd99ffdc75a339f516479ebd782aa0e7ab4b0b4d5671a167755eaf9b7e10838b","b98d17f66bb2b49b7f53086791e062691b3434451f7580cf203fd36ad175d04d","43fb011e36df18594d0b32b751d3ca0e93baa944d3bae6500a8e5f1dac5cbd9b","4847f7d6c1ee4692fd0e0603690660981e39847549d406d1ed0875c4d4146822","dee654fc4290148c0a7cb75110916a0623e36b3fb48f1490c35c19f5b8bfc7aa","63ab1b0f497b7d4e163bda67a997897c8941d38fe36ec681c090a37798b8a518","ffdb5545d16754400d72d0994cf0e9a97e453e4279f329f57224b56b24ec0d3c","7441dd5d3ebbc119c1b4ff8efb991aa3fc3ae4f8e9b3ab264e78f19888211383","925764e57567da82d4546ee8f4322c424dda7a37bb06f0339e4a015bdb0a3f21","0f20c4ec50148274971d2f318d7aa854fd97d480b0da598199b8a5ab7a9a9606","8a20b2e9153eeefa4624f2dfea4264d5e2707718d2f66f44b3f642bff1ba0d90","0d9c390c4f60a002b3e54904ef7c10b0864737e808ccae690d4b51e27c89d710","12ddd5c1a2214f510ddbf12528f7c0a3380151dc8611727d224ae0da256d9509","d248ad5a24d081d5f1f52db1fa560bc1dcf2c4ec66a7cf53113ed3a958c7362e","201c450f99021b4753703916de287a0a31cd39ebbe3541ea0583fc90f962702f","f67d00306a5bd5d558bd44b6a440df2836d9ffb96814d2d20947150c6c833578","95e6b342d3fedc3227d5872f4647c7b456402cda7b5536ad06f2f544687e3b28","d282729878b42fae9e7868b1630047e1af87cc2e001574db504cd1669ec641cd","2ef3f1e0f732f46c2aebf723e5ff91a62fc7059328f4e43d57183bb7a0623aa6","53d922145f24dbaeaf59f2cca026f8495e6189f0a45305628dad89a9331cb946","0be02387bf20e7a29250a242d7eef49af90b452f4c74b4506e957b77d0daa506","cf65b207197a49502a0baa22af0a794ef5619f33de4068892342e3bd19a03d6e"],"paragraph_range_zero_based":[21456,21479],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p21456"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ta-Common-r17                  INTEGER(0..66485757),","paragraph_zero_based":21480},{"literal_text_all_w_t_and_m_t":"    ta-CommonDrift-r17             INTEGER(-257303..257303)                                                 OPTIONAL,  -- Need R","paragraph_zero_based":21481},{"literal_text_all_w_t_and_m_t":"    ta-CommonDriftVariant-r17      INTEGER(0..28949)                                                        OPTIONAL   -- Need R","paragraph_zero_based":21482},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21483},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21484},{"literal_text_all_w_t_and_m_t":"-- TAG-NTN-CONFIG-STOP","paragraph_zero_based":21485},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21486},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21487},{"literal_text_all_w_t_and_m_t":"NTN-Config field descriptions","paragraph_zero_based":21488},{"literal_text_all_w_t_and_m_t":"EphemerisInfo","paragraph_zero_based":21489},{"literal_text_all_w_t_and_m_t":"This field provides satellite ephemeris either in format of position and velocity state vector or in format of orbital parameters. This field is excluded when determining changes in system information, i.e. changes to ephemerisInfo should neither result in system information change notifications nor in a modification of valueTag in SIB1.","paragraph_zero_based":21490},{"literal_text_all_w_t_and_m_t":"epochTime","paragraph_zero_based":21491},{"literal_text_all_w_t_and_m_t":"Indicate the epoch time for the NTN assistance information. When explicitly provided through SIB, or through dedicated signaling, the EpochTime is the starting time of a DL sub-frame, indicated by a SFN and a sub-frame number signaled together with the assistance information. For serving cell, the field sfn indicates the current SFN or the next upcoming SFN after the frame where the message indicating the epochTime is received. For neighbour cell, the sfn indicates the SFN nearest to the frame where the message indicating the epochTime is received. The reference point for epoch time of the serving or neighbour NTN payload ephemeris and Common TA parameters is the uplink time synchronization reference point. If this field is absent, the epoch time is the end of SI window where this SIB19 is scheduled. This field is mandatory present when ntn-Config is provided in dedicated configuration. If this field is absent in ntn-Config provided via NTN-NeighCellConfig the UE uses epoch time of the serving cell, otherwise the field is based on the timing of the serving cell, i.e. the SFN and sub-frame number indicated in this field refers to the SFN and sub-frame of the serving cell. In case of handover or conditional handover, this field is based on the timing of the target cell, i.e. the SFN and sub-frame number indicated in this field refers to the SFN and sub-frame of the target cell. For the target cell the UE considers epoch time, indicated by the SFN and sub-frame number in this field, to be the frame nearest to the frame in which the message indicating the epoch time is received. This field is excluded when determining changes in system information, i.e. changes to epochTime should neither result in system information change notifications nor in a modification of valueTag in SIB1.","paragraph_zero_based":21492},{"literal_text_all_w_t_and_m_t":"cellSpecificKoffset","paragraph_zero_based":21493},{"literal_text_all_w_t_and_m_t":"Scheduling offset used for the timing relationships that are modified for NTN (see TS 38.213 [13]). The unit of the field K_offset is number of slots for a given subcarrier spacing of 15 kHz. If the field is absent UE assumes value 0.","paragraph_zero_based":21494},{"literal_text_all_w_t_and_m_t":"kmac","paragraph_zero_based":21495},{"literal_text_all_w_t_and_m_t":"Scheduling offset provided by network if downlink and uplink frame timing are not aligned at gNB. If the field is absent UE assumes value 0. In FR1, the unit of kmac is number of slots for a given subcarrier spacing of 15 kHz.","paragraph_zero_based":21496},{"literal_text_all_w_t_and_m_t":"ntn-PolarizationDL","paragraph_zero_based":21497},{"literal_text_all_w_t_and_m_t":"If present, this parameter indicates polarization information for downlink transmission on service link: including Right hand, Left hand circular polarizations (RHCP, LHCP) and Linear polarization.","paragraph_zero_based":21498},{"literal_text_all_w_t_and_m_t":"ntn-PolarizationUL","paragraph_zero_based":21499},{"literal_text_all_w_t_and_m_t":"If present, this parameter indicates Polarization information for uplink service link.","paragraph_zero_based":21500},{"literal_text_all_w_t_and_m_t":"If not present and ntn-PolarizationDL is present, UE assumes the same polarization for UL and DL.","paragraph_zero_based":21501},{"literal_text_all_w_t_and_m_t":"ntn-UlSyncValidityDuration","paragraph_zero_based":21502},{"literal_text_all_w_t_and_m_t":"A validity duration configured by the network for assistance information (i.e. Serving and/or neighbour satellite ephemeris and Common TA parameters) which indicates the maximum time duration (from epochTime) during which the UE can apply assistance information without having acquired new assistance information.","paragraph_zero_based":21503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["324c7e70986327a1613e51aeae0dd3b60a4e2604266851a52ed163b50e3af055","9fa1fe7e30ba6ce942d6d6317a36d91cd2f9f8629452ea9880b3f392d44ef1da","742534883face2add61bee27f241b03dba6f66839dae4d7ef8ff625e91f3343b","6269422273e34d85e40eea35d5a8aa52475a646e34d01a008c28f5d84d4287c9","abbe7fc660c16848017581f697dd7bb20adf8fa8e310807a1b5a0093f878df68","09473fabddabf203cef61c13537655b81b81449127a3b909eb332c92b35fc151","425d5ad9ce532f927a100a6ac0aa39f8fd2975107009f020c8bb86fde049c4ef","3667e9e10d5d9a771d0fdf5269d26faa454ee26ed2ff9299a4cf2654eeec426d","0497e06893ff68fa4aa9981856a2b56e6448adf54829c69e2ec1cca00734225e","c6bfe9dbf57243681ea997964fce953577006c7d25d72191eb514c27bd805a10","ce8e41ccded355d909f4d373250206ed3aa0e2f0d0278cd08191fbf5c18d7bbc","abe776bcea31476c8fcac578490bc6cf8eba0e830ecf0a321b56d75cd6d6e46c","e7a261ad96aab1236e07b676da068ec100eb6e251f22c5007ba8b6b710a7fa39","9bd561e267b62a06d86e7c3e54621976cd9fd3bec5097459742204c75c1993a9","48b328c7eba813ba23707a8ea0bcbcde3dd0ebca88ada6fc77e0d503c0aaa12a","c308c693cab82d7a9185df59e476252e460f79fccbaf1830ce463b3d1c22dbd2","6d8ae03798c152cc2c6e0076d3a4e2fe78ee97497432e3fa0cbeaab3a2e0d835","41ddf195e30fc4be7440e051a1c3fc7b090c67154ad265cc914cc2db3e2eadbe","33fa4d5eae4648dd6554f5c95e4884bcc1db86fa183afbfec8798c0afaccf239","a5b9e757a1ca73be2d2971c778e3ceea78754ff3dc573f6ee13544c2fee56a9f","c639165f75b9d888a6a7393c7b82890e9fcc31a85bab96bf308ee2c31c857ac0","5de6336d0b876cc0f81206b1ee9a733b4a86fb6a5c76964491d4eefc918358f7","1d68d7594bf259fb413d760463b1e4fe522db51368a7b970ad1e6b47d37f0de9","4eb5c240f3e73627bca42be5a6c63ad851f0f91751b4a2c8ab748dbe32df923e"],"paragraph_range_zero_based":[21480,21503],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p21480"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The unit of ntn-UlSyncValidityDuration is second. Value s5 corresponds to 5 s, value s10 indicate 10 s and so on. This parameter applies to both connected and idle mode UEs. If this field is absent in ntn-Config provided via NTN-NeighCellConfig, the UE uses validity duration from the serving cell assistance information. This field is excluded when determining changes in system information, i.e. changes of ntn-UlSyncValidityDuration should neither result in system information change notifications nor in a modification of valueTag in SIB1. ntn-UlSyncValidityDuration is only updated when at least one of epochTime, ta-Info, ephemerisInfo is updated.","paragraph_zero_based":21504},{"literal_text_all_w_t_and_m_t":"ta-Common","paragraph_zero_based":21505},{"literal_text_all_w_t_and_m_t":"Network-controlled common timing advanced value and it may include any timing offset considered necessary by the network. ta-Common with value of 0 is supported. The granularity of ta-Common is 4.072 × 10^(-3) μs. Values are given in unit of corresponding granularity. This field is excluded when determining changes in system information, i.e. changes of ta-Common should neither result in system information change notifications nor in a modification of valueTag in SIB1.","paragraph_zero_based":21506},{"literal_text_all_w_t_and_m_t":"ta-CommonDrift","paragraph_zero_based":21507},{"literal_text_all_w_t_and_m_t":"Indicate drift rate of the common TA. The granularity of ta-CommonDrift is 0.2 × 10^(-3) μs⁄s. Values are given in unit of corresponding granularity. This field is excluded when determining changes in system information, i.e. changes of ta-CommonDrift should neither result in system information change notifications nor in a modification of valueTag in SIB1.","paragraph_zero_based":21508},{"literal_text_all_w_t_and_m_t":"ta-CommonDriftVariant","paragraph_zero_based":21509},{"literal_text_all_w_t_and_m_t":"Indicate drift rate variation of the common TA. The granularity of ta-CommonDriftVariant is 0.2×10^(-4) μs⁄s^2. Values are given in unit of corresponding granularity. This field is excluded when determining changes in system information, i.e. changes of ta-CommonDriftVariant should neither result in system information change notifications nor in a modification of valueTag in SIB1.","paragraph_zero_based":21510},{"literal_text_all_w_t_and_m_t":"ta-Report","paragraph_zero_based":21511},{"literal_text_all_w_t_and_m_t":"When this field is included in SIB19, it indicates reporting of timing advanced is enabled during Random Access due to RRC connection establishment or RRC connection resume, and during RRC connection reestablishment. When this field is included in ServingCellConfigCommon within dedicated signalling, it indicates TA reporting is enabled during Random Access due to reconfiguration with sync (see TS 38.321 [3], clause 5.4.8).","paragraph_zero_based":21512},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21513},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":21514},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":21515},{"literal_text_all_w_t_and_m_t":"SIB19","paragraph_zero_based":21516},{"literal_text_all_w_t_and_m_t":"The field is mandatory present for the serving cell in SIB19. The field is optionally present, Need R, otherwise.","paragraph_zero_based":21517},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21518},{"literal_text_all_w_t_and_m_t":"–NZP-CSI-RS-Resource","paragraph_zero_based":21519},{"literal_text_all_w_t_and_m_t":"The IE NZP-CSI-RS-Resource is used to configure Non-Zero-Power (NZP) CSI-RS transmitted in the cell where the IE is included, which the UE may be configured to measure on (see TS 38.214 [19], clause 5.2.2.3.1). A change of configuration between periodic, semi-persistent or aperiodic for an NZP-CSI-RS-Resource is not supported without a release and add.","paragraph_zero_based":21520},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-Resource information element","paragraph_zero_based":21521},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21522},{"literal_text_all_w_t_and_m_t":"-- TAG-NZP-CSI-RS-RESOURCE-START","paragraph_zero_based":21523},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21524},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-Resource ::=             SEQUENCE {","paragraph_zero_based":21525},{"literal_text_all_w_t_and_m_t":"    nzp-CSI-RS-ResourceId               NZP-CSI-RS-ResourceId,","paragraph_zero_based":21526},{"literal_text_all_w_t_and_m_t":"    resourceMapping                     CSI-RS-ResourceMapping,","paragraph_zero_based":21527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["db921a7d9a1da1d5cc9856186dc067639c6e4ce1858f9777c3a44064dd979747","2ffddc2c0cf6462a170fc60f7c944a1816db3c93aa379ecff58104f6898e0e63","2164a68c67121f8e586c7678efbce485cc6035e11bd22d9317a3f71cc3cafdaa","afbbf6540f7645b9de7d43c5965c3373b3ef614bed92649d3321573f1cc83a7e","7b2081965fbe4122128d06c99dbbec02e598ec7014ff900fce3d36fc8adc08e1","cf32095587f0d5afa271e055456eac00c913a892d6336d8fe6c0b5cd485b7f6a","aa7f23a3f79c944a582f326bf30c78cf14fe351c552bd675977b90df9429157d","e4095dcd858c8b0d82b8b85a250902493489a3d33c0530b2ae99e10432b68bee","ca136b0d3c54672e318a6c5542e09c9d17299b1e12ff6bc06f0c9c7fc4f6b644","c6b68313ccaab864dbe29480bc7ec99a42b7036d0482b3d5b084a7d6ac6fcf17","5b93765852c226b0cfb5635c00ad99a1cdd849b187ba9868051c8a235e86c9d1","c12ff41bcca1819015260e2d23e31b695546a40cfb120ac55f22b55fe94620fa","53e1ac617d061719afed60e41c67a8d503f0f0385c080949fc6b6d09f8456db7","1d462559716c661d183bbb373a40d6621243b792f242921a650c074cb965c569","24d3defaa10c04f2180bc3b6dbff3509c9cc003b2eb11e34fe46150a782eec18","da711d977e720173c7dd1c4be27bf6d11441f6c85db94a9c37ee19f44d3712f5","fdfb2b8fd57ab5886a0c4841245e4ec155b506deb4b78b5382393199e19cfb26","febf3e8c26b13322f0d0317bf925fe9f56d60d521718584c486317cbe1595112","f50ac9c59bb10a30fdbe15d76cc3bb7643e7bdc2c846221b5c01038057406eac","1bc602320db626c5bb923ced7120e2012d74cdcb4700a3bd93a6966d2ccc671d","2bb24a500984c921829efe7ef5d7564a4b18d5b5400898beec04032f89e569f3","b63f5e9c4ef5b258dcf9835c4b963dd1324c1070d4b28251f85ee3851f4bc8eb","d73f2284cf4bcd59c676acf2cdf8d34bade2b956cbd017841e7352d1db250eb6","7ae68e3637a21bb97147c84a77db8ace65d28ffdc7fa4a584309e27ab308526e"],"paragraph_range_zero_based":[21504,21527],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p21504"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    powerControlOffset                  INTEGER (-8..15),","paragraph_zero_based":21528},{"literal_text_all_w_t_and_m_t":"    powerControlOffsetSS                ENUMERATED{db-3, db0, db3, db6}                 OPTIONAL,   -- Need R","paragraph_zero_based":21529},{"literal_text_all_w_t_and_m_t":"    scramblingID                        ScramblingId,","paragraph_zero_based":21530},{"literal_text_all_w_t_and_m_t":"    periodicityAndOffset                CSI-ResourcePeriodicityAndOffset                OPTIONAL,   -- Cond PeriodicOrSemiPersistent","paragraph_zero_based":21531},{"literal_text_all_w_t_and_m_t":"    qcl-InfoPeriodicCSI-RS              TCI-StateId                                     OPTIONAL,   -- Cond Periodic","paragraph_zero_based":21532},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":21533},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21534},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21535},{"literal_text_all_w_t_and_m_t":"-- TAG-NZP-CSI-RS-RESOURCE-STOP","paragraph_zero_based":21536},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21537},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21538},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-Resource field descriptions","paragraph_zero_based":21539},{"literal_text_all_w_t_and_m_t":"periodicityAndOffset","paragraph_zero_based":21540},{"literal_text_all_w_t_and_m_t":"Periodicity and slot offset sl1 corresponds to a periodicity of 1 slot, sl2 to a periodicity of two slots, and so on. The corresponding offset is also given in number of slots (see TS 38.214 [19], clause 5.2.2.3.1). Network always configures the UE with a value for this field for periodic and semi-persistent NZP-CSI-RS-Resource (as indicated in CSI-ResourceConfig).","paragraph_zero_based":21541},{"literal_text_all_w_t_and_m_t":"powerControlOffset","paragraph_zero_based":21542},{"literal_text_all_w_t_and_m_t":"Power offset of PDSCH RE to NZP CSI-RS RE. Value in dB (see TS 38.214 [19], clauses 5.2.2.3.1 and 4.1).","paragraph_zero_based":21543},{"literal_text_all_w_t_and_m_t":"powerControlOffsetSS","paragraph_zero_based":21544},{"literal_text_all_w_t_and_m_t":"Power offset of NZP CSI-RS RE to SSS RE. Value in dB (see TS 38.214 [19], clause 5.2.2.3.1).","paragraph_zero_based":21545},{"literal_text_all_w_t_and_m_t":"qcl-InfoPeriodicCSI-RS","paragraph_zero_based":21546},{"literal_text_all_w_t_and_m_t":"For a target periodic CSI-RS, contains a reference to one TCI-State in TCI-States for providing the QCL source and QCL type. For periodic CSI-RS, the source can be SSB or another periodic-CSI-RS. Refers to the TCI-State or dl-OrJoint-TCI-State which has this value for tci-StateId and is defined in tci-StatesToAddModList or in dl-OrJointTCI-StateList in the PDSCH-Config included in the BWP-Downlink corresponding to the serving cell and to the DL BWP to which the resource belongs to (see TS 38.214 [19], clause 5.2.2.3.1).","paragraph_zero_based":21547},{"literal_text_all_w_t_and_m_t":"resourceMapping","paragraph_zero_based":21548},{"literal_text_all_w_t_and_m_t":"OFDM symbol location(s) in a slot and subcarrier occupancy in a PRB of the CSI-RS resource.","paragraph_zero_based":21549},{"literal_text_all_w_t_and_m_t":"scramblingID","paragraph_zero_based":21550},{"literal_text_all_w_t_and_m_t":"Scrambling ID (see TS 38.214 [19], clause 5.2.2.3.1).","paragraph_zero_based":21551}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["a21aa64e8af1e5bed5fc00