iteral_text_all_w_t_and_m_t":"Upon transmission of RRCReestabilshmentRequest","paragraph_zero_based":40845},{"literal_text_all_w_t_and_m_t":"Upon reception of RRCReestablishment or RRCSetup message as well as when the selected cell becomes unsuitable or the (re)selected L2 U2N Relay UE becomes unsuitable, upon reception of notificationMessageSidelink indicating relayUE-HO or relayUE-CellReselection.","paragraph_zero_based":40846},{"literal_text_all_w_t_and_m_t":"Go to RRC_IDLE","paragraph_zero_based":40847}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["f6a5a7037cf91ca314a7aa11f6620e50d68f8ffc613c4c5fae107f79e78897d1","8237fd9e35d1ae5b9f3e7ae5ce53770244275818175fdc76ff1c779d015887f8","d701aa98cf337a5fa41c1e41c2f081792fbcc3c3927eaac4011398127b811914","09375baa4d1eea5bebbdb697ea5d15a2cd837302386646f806ca9746c6f9f298","cbacae30e6e977498f91e5ff77d21f542fac39ec7e23d514c94894241dffb2a8","989102a29b8810b4195de6cdf280b5e97e576eee3a2d1809ad7b97cf90529611","e21050d18346b442895dd2de03600c96ddaf5c87f4b4778ae455b7bad229f839","96f5fb2914a236f5048ebb11d5fc90cc5f0d8e827f49e145a7bb0162d30b1b40","b09c7d68f09a9a01aa87c3b383c6df1072b021ebb208d28d47dde5ab71e51332","52695069d3934376bd9164ec2792b561e86555ebfcd98c18de8e0e8f5f35f096","51a4f866686d5296f12abc8e5ad69151b71bef914f97cc022706a8a8f4a16c61","baedb8bea24c71086a4e0a608189c31e9264bd9ae4d74b3cb3e266c5a32072e9","14831b3255d24d13184d1efd28b1cc8f077876f5a77f162ce8b71d254a9e15f6","d0b3db03ec38ca0ed759fbcb6480ade651edf317d30a0ec553515e6fb317dcca","dae131c3f060027d9b510e6652ae913e97360e3923624d51f08c19f8bffc8f7a","5319996a2ce099c647ff1db312782b07b7fd9e5420e3a919027d8211101899bc","fbd91f9f42108250aeaf14fe17771af6b3913cdfc15e72f3afbc5d91362c3