","paragraph_zero_based":44247},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports DL scheduling slot offset (K0) greater than 0 for PDSCH mapping type A in FDD FR1.","paragraph_zero_based":44248},{"literal_text_all_w_t_and_m_t":"dl-SchedulingOffset-PDSCH-TypeA-TDD-FR1","paragraph_zero_based":44249},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports DL scheduling slot offset (K0) greater than 0 for PDSCH mapping type A in TDD FR1.","paragraph_zero_based":44250},{"literal_text_all_w_t_and_m_t":"dl-SchedulingOffset-PDSCH-TypeA-TDD-FR2","paragraph_zero_based":44251},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports DL scheduling slot offset (K0) greater than 0 for PDSCH mapping type A in TDD FR2.","paragraph_zero_based":44252},{"literal_text_all_w_t_and_m_t":"dl-SchedulingOffset-PDSCH-TypeB-FDD-FR1","paragraph_zero_based":44253},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports DL scheduling slot offset (K0) greater than 0 for PDSCH mapping type B in FDD FR1.","paragraph_zero_based":44254},{"literal_text_all_w_t_and_m_t":"dl-SchedulingOffset-PDSCH-TypeB-TDD-FR1","paragraph_zero_based":44255}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["8a6ec549f7cfb4e65b500016843bb3d4d670d9845214ca615e68dd9447ed70c4","3163ad8eff6c065b4657546da910a35eb4a4f48deb96b2e871c0da4dde39dbd3","43a7f882b523c56d2221f43f04d486cbb3a77796436336e1de88ff4c2095e339","b1ea8f1bce64e9ccd54bae7815fb7c2c18526171ea78728ed5c3107333e4dccf","df183ef337548f0423dcd77a19180c5b1bced769bb59fd79dd09c3007b92a565","7fc523fa2f4a83dc41079ccc7b7f32018ccee58ec487434fc01cd4f5167ea292","fcfb01e4643b9d124f7ea546db8092f3f028b273d7112fa133cb970a048ee108","e1058