{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"t3xy","paragraph_zero_based":26856},{"literal_text_all_w_t_and_m_t":"Timers are described in clause 7.1. Value ms0 corresponds to 0 ms, value ms50 corresponds to 50 ms and so on.","paragraph_zero_based":26857},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26858},{"literal_text_all_w_t_and_m_t":"–RNTI-Value","paragraph_zero_based":26859},{"literal_text_all_w_t_and_m_t":"The IE RNTI-Value represents a Radio Network Temporary Identity.","paragraph_zero_based":26860},{"literal_text_all_w_t_and_m_t":"RNTI-Value information element","paragraph_zero_based":26861},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26862},{"literal_text_all_w_t_and_m_t":"-- TAG-RNTI-VALUE-START","paragraph_zero_based":26863},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26864},{"literal_text_all_w_t_and_m_t":"RNTI-Value ::=                      INTEGER (0..65535)","paragraph_zero_based":26865},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26866},{"literal_text_all_w_t_and_m_t":"-- TAG-RNTI-VALUE-STOP","paragraph_zero_based":26867},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26868},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26869},{"literal_text_all_w_t_and_m_t":"–RSRP-Range","paragraph_zero_based":26870},{"literal_text_all_w_t_and_m_t":"The IE RSRP-Range specifies the value range used in RSRP measurements and thresholds. For measurements, integer value for RSRP measurements is according to Table 10.1.6.1-1 in TS 38.133 [14]. For thresholds, the actual value is (IE value – 156) dBm, except for the IE value 127, in which case the actual value is infinity.","paragraph_zero_based":26871},{"literal_text_all_w_t_and_m_t":"RSRP-Range information element","paragraph_zero_based":26872},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26873},{"literal_text_all_w_t_and_m_t":"-- TAG-RSRP-RANGE-START","paragraph_zero_based":26874},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26875},{"literal_text_all_w_t_and_m_t":"RSRP-Range ::=                      INTEGER(0..127)","paragraph_zero_based":26876},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26877},{"literal_text_all_w_t_and_m_t":"-- TAG-RSRP-RANGE-STOP","paragraph_zero_based":26878},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26879}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["8a0c3bb04d20b992a57312310ca6d751216169db2a59c8cd695cb59c1c531252","1dd1ed6556b07f1a79760f1d03193310be1347734e80a328025613f9d15e2e6b","9f1fe52960dacf4a58aeb4ec8d291fd12df14dab67e3b70d008650414ec8533f","da63e0fa9516caf117f41dcab59724457c06727b9b3267775927b9acab255e27","cee0a9a49d951c67d06122f8f2f5768feab05908e2836d3a6a6b6770d2f0ef91","a3c24fcbccecf69147ddce9c116ad3cc6ebd5fb3c837fc7f9929fb560c5372f9","1603544fef26c6b73b26c75514a6aaa25c59d372c4b71996e89244040e3e23e1","1ab837fef66f6216f5436030bc5d5afa34a6cc9c727ee3a0ed1fd3e1f12a9a9a","3ac7098639573c148a770a0e32be0e8aa151cd4ac92e1f80747f317b1593a2e0","9f73555e7e044d1adb1cc1f797e1ba5783deb1864dfa7e9e0943f19734b53e7f","936773c09b247a9aadfca5a4fc70efb3cc41057eea535a5de3248297749fa976","245296c231372ff6e7f7911512e4ff61cb2a7189bcdee84db65bf3c3337d0c38","deaec24ed288f4b1f13c70cec4e175e79fad6ddff0640ad011208ea984d3af87","1d738de4eb433b1c71bcdfa7ca8210bfe0493b74c3ff38f01998e4f2b0680648","763491e45b464cc99bb1ceb70d60d28f5d8b2f53a652392fc24d5be5837319c9","27a0c6b5f6c3a031e970e8ecfc1f519f832e2ac647d49124f5c0900f345d5c82","3e962057a679605c210ed89a6f1cbc5