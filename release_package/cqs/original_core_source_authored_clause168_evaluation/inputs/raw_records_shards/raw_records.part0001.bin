{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-SL-BWP-POOLCONFIG-STOP","paragraph_zero_based":37632},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":37633},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37634},{"literal_text_all_w_t_and_m_t":"SL-BWP-PoolConfig field descriptions","paragraph_zero_based":37635},{"literal_text_all_w_t_and_m_t":"sl-RxPool","paragraph_zero_based":37636},{"literal_text_all_w_t_and_m_t":"Indicates the receiving resource pool on the configured BWP. For the PSFCH related configuration, if configured, will be used for PSFCH transmission/reception. If the field is included, it replaces any previous list, i.e. all the entries of the list are replaced and each of the SL-ResourcePool entries is considered to be newly created.","paragraph_zero_based":37637},{"literal_text_all_w_t_and_m_t":"sl-TxPoolExceptional","paragraph_zero_based":37638},{"literal_text_all_w_t_and_m_t":"Indicates the resources by which the UE is allowed to perform NR sidelink transmission in exceptional conditions on the configured BWP. For the PSFCH related configuration, if configured, will be used for PSFCH transmission/reception.","paragraph_zero_based":37639},{"literal_text_all_w_t_and_m_t":"sl-TxPoolScheduling","paragraph_zero_based":37640},{"literal_text_all_w_t_and_m_t":"Indicates the resources by which the UE is allowed to perform NR sidelink transmission based on network scheduling on the configured BWP. For the PSFCH related configuration, if configured, will be used for PSFCH transmission/reception.","paragraph_zero_based":37641},{"literal_text_all_w_t_and_m_t":"sl-TxPoolSelectedNormal","paragraph_zero_based":37642},{"literal_text_all_w_t_and_m_t":"Indicates the resources by which the UE is allowed to perform NR sidelink transmission by UE autonomous resource selection on the configured BWP. For the PSFCH related configuration, if configured, will be used for PSFCH transmission/reception.","paragraph_zero_based":37643},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37644},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":37645},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":37646},{"literal_text_all_w_t_and_m_t":"HO","paragraph_zero_based":37647},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need M, in an RRCReconfiguration message including reconfigurationWithSync; otherwise it is absent, Need M.","paragraph_zero_based":37648},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37649},{"literal_text_all_w_t_and_m_t":"–SL-BWP-PoolConfigCommon","paragraph_zero_based":37650},{"literal_text_all_w_t_and_m_t":"The IE SL-BWP-PoolConfigCommon is used to configure the cell-specific NR sidelink communication resource pool.","paragraph_zero_based":37651},{"literal_text_all_w_t_and_m_t":"SL-BWP-PoolConfigCommon information element","paragraph_zero_based":37652},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":37653},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-BWP-POOLCONFIGCOMMON-START","paragraph_zero_based":37654},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37655}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["612b24ec0efabe393f62fd305dd0f7e4b646512ec50d597c2318e27e30446350","74d4caea01f0b7d864376334e0946b74ecd1d7028906134eb2faa7858853ed9a","9634112fec53f8930ef6dbe1f2a6f8f5f8bb299520970b1ff897a073757080e2","19b9a0765946d43c1e9bdc6e5b8ab997f100d84832ff16dd8972b1782330ea82","09a53f624b8b6bb6dcb26492fcffbdfa29a38949e8f37b30302f7b2ccdca