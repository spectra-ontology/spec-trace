{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13008},{"literal_text_all_w_t_and_m_t":"IntraFreqNeighHSDN-CellList-r17 ::= SEQUENCE (SIZE (1..maxCellIntra)) OF PCI-Range","paragraph_zero_based":13009},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13010},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB3-STOP","paragraph_zero_based":13011},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":13012},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13013},{"literal_text_all_w_t_and_m_t":"SIB3 field descriptions","paragraph_zero_based":13014},{"literal_text_all_w_t_and_m_t":"channelAccessMode2","paragraph_zero_based":13015},{"literal_text_all_w_t_and_m_t":"If present, this field indicates that intra-frequency neighbor cells apply channel access mode procedures for operation with shared spectrum channel access in accordance with TS 37.213 [48], clause 4.4 for FR2-2. If absent, the intra-frequency neighbor cells do not apply any channel access procedure.","paragraph_zero_based":13016},{"literal_text_all_w_t_and_m_t":"intraFreqAllowedCellList","paragraph_zero_based":13017},{"literal_text_all_w_t_and_m_t":"List of allow-listed intra-frequency neighbouring cells, see TS 38.304 [20], clause 5.2.4.","paragraph_zero_based":13018},{"literal_text_all_w_t_and_m_t":"intraFreqCAG-CellList","paragraph_zero_based":13019},{"literal_text_all_w_t_and_m_t":"List of intra-frequency neighbouring CAG cells (as defined in TS 38.304 [20]) per PLMN.","paragraph_zero_based":13020},{"literal_text_all_w_t_and_m_t":"intraFreqExcludedCellList","paragraph_zero_based":13021},{"literal_text_all_w_t_and_m_t":"List of exclude-listed intra-frequency neighbouring cells.","paragraph_zero_based":13022},{"literal_text_all_w_t_and_m_t":"intraFreqNeighCellList","paragraph_zero_based":13023},{"literal_text_all_w_t_and_m_t":"List of intra-frequency neighbouring cells with specific cell re-selection parameters. If intraFreqNeighCellList-v1610 is present, it shall contain the same number of entries, listed in the same order as in intraFreqNeighCellList (without suffix).","paragraph_zero_based":13024},{"literal_text_all_w_t_and_m_t":"intraFreqNeighHSDN-CellList","paragraph_zero_based":13025},{"literal_text_all_w_t_and_m_t":"List of intra-frequency neighbouring HSDN cells as specified in TS 38.304 [20].","paragraph_zero_based":13026},{"literal_text_all_w_t_and_m_t":"q-OffsetCell","paragraph_zero_based":13027},{"literal_text_all_w_t_and_m_t":"Parameter \"Qoffsets,n\" in TS 38.304 [20].","paragraph_zero_based":13028},{"literal_text_all_w_t_and_m_t":"q-QualMinOffsetCell","paragraph_zero_based":13029},{"literal_text_all_w_t_and_m_t":"Parameter \"Qqualminoffsetcell\" in TS 38.304 [20]. Actual value Qqualminoffsetcell = field value [dB].","paragraph_zero_based":13030},{"literal_text_all_w_t_and_m_t":"q-RxLevMinOffsetCell","paragraph_zero_based":13031}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["9f79893a7c10e5caefc39e2101e1a6fc343f6475a373b9b3eae97516af850917","3f7735377579f43d1bb504cb6a66b3184c9e811eb17fd31fda00c49d46587e11","dfb8327159d7e6815efa13d508976c422ac16f2ba91fbca4039744ced1f34dda","8a23ce82d09090fe45554314314a882c503dcd2ae1aee4584744de6f118b6cb1","c2aa78dd459d0a5fe42de490dab2846a325ec8d7507846ce5d84d3b9f6c828a3","26ad4e9174152a5ac8d82fe352a6f796dcf4a7340be4ba57c407355e8ec33590","3ed05c2e7042d6cd9e5ccec019ed78b0c1e6cdb84a3894c0c842f4f48e790659","7b4d36d900046daaec3bb6d4594f83ad649a80aeea9e19bbfd048f27ca433831","d35b2af783328624f1b60c707cdb579c7d1a293718eccfae378