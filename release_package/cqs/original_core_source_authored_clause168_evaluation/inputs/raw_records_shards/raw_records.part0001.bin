{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                        UE-CapabilityRequestFilterNR-v1540    OPTIONAL","paragraph_zero_based":35712},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":35713},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35714},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRequestFilterNR-v1540 ::=      SEQUENCE {","paragraph_zero_based":35715},{"literal_text_all_w_t_and_m_t":"    srs-SwitchingTimeRequest                    ENUMERATED {true}                     OPTIONAL,  -- Need N","paragraph_zero_based":35716},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                        UE-CapabilityRequestFilterNR-v1710    OPTIONAL","paragraph_zero_based":35717},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":35718},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35719},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRequestFilterNR-v1710 ::=      SEQUENCE {","paragraph_zero_based":35720},{"literal_text_all_w_t_and_m_t":"    sidelinkRequest-r17                         ENUMERATED {true}                     OPTIONAL,  -- Need N","paragraph_zero_based":35721},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                        SEQUENCE {}                           OPTIONAL","paragraph_zero_based":35722},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":35723},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35724},{"literal_text_all_w_t_and_m_t":"-- TAG-UE-CAPABILITYREQUESTFILTERNR-STOP","paragraph_zero_based":35725},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":35726},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35727},{"literal_text_all_w_t_and_m_t":"–UE-MRDC-Capability","paragraph_zero_based":35728},{"literal_text_all_w_t_and_m_t":"The IE UE-MRDC-C