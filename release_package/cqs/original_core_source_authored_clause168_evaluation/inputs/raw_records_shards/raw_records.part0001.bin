{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18672},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18673},{"literal_text_all_w_t_and_m_t":"–HysteresisLocation","paragraph_zero_based":18674},{"literal_text_all_w_t_and_m_t":"The IE HysteresisLocation is a parameter used within entry and leave condition of a location based event triggered reporting condition. The actual value is field value * 10 meters.","paragraph_zero_based":18675},{"literal_text_all_w_t_and_m_t":"HysteresisLocation information element","paragraph_zero_based":18676},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18677},{"literal_text_all_w_t_and_m_t":"-- TAG-HYSTERESISLOCATION-START","paragraph_zero_based":18678},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18679},{"literal_text_all_w_t_and_m_t":"HysteresisLocation-r17 ::=          INTEGER (0..32768)","paragraph_zero_based":18680},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18681},{"literal_text_all_w_t_and_m_t":"-- TAG-HYSTERESISLOCATION-STOP","paragraph_zero_based":18682},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18683},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18684},{"literal_text_all_w_t_and_m_t":"–InvalidSymbolPattern","paragraph_zero_based":18685},{"literal_text_all_w_t_and_m_t":"The IE InvalidSymbolPattern is used to configure one invalid symbol pattern for PUSCH transmission repetition type B applicable for both DCI format 0_1 and 0_2, see TS 38.214 [19], clause 6.1.","paragraph_zero_based":18686},{"literal_text_all_w_t_and_m_t":"InvalidSymbolPattern information element","paragraph_zero_based":18687},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18688},{"literal_text_all_w_t_and_m_t":"-- TAG-INVALIDSYMBOLPATTERN-START","paragraph_zero_based":18689},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18690},{"literal_text_all_w_t_and_m_t":"InvalidSymbolPattern-r16 ::=     SEQUENCE {","paragraph_zero_based":18691},{"literal_text_all_w_t_and_m_t":"    symbols-r16                      CHOICE {","paragraph_zero_based":18692},{"literal_text_all_w_t_and_m_t":"        oneSlot                          BIT STRING (SIZE (14)),","paragraph_zero_based":18693},{"literal_text_all_w_t_and_m_t":"        twoSlots                         BIT STRING (SIZE (28))","paragraph_zero_based":18694},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":18695}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["e94f464ac6d87349ace4a9a85a70b5361e844c15ce04dc6031087072f896482b","53f4e1b3ae49f4dffcd7dca4c7dade30f3b0ebd8b1d00535a63c4230593da858","140cdf00b5a129d002ae4033948169c6c67c16176d93246f5db9df49aadb978b","d5fabaaec8e6d6236f29f30143e74b693a6d90d18e4b04fad4d0a7a8618bbca6","2c6d303066e31246e795ec55d514ae3f7a1e4eaa0398ad3ecac9ad66a52a934c","4a4d5ca9abfbedea8a485bde26a6d551512cff0c0a89ec2baba60425571412e3","cf948e07d2d7fc2135cc667d920d88a004c99c2373e146971645e21aa488ef65","94d267843c8a5fa6ef5c1b6193c92c6cd53adbc18a8bfb75047c188914b8af07","4b68a87c43791bb1f87e6ab1a42d04461e8b99f46199cfd14bf7b5a11cc5cd8a","95a18df5d68ef34a9669b4b2442a8431d8ebc41739ac4423d4973e21a4f4be5d","0b9c1f51b014b22d9a340dbc4fac02510ad7ad424f2722cdd660cb1bb889834d","92dff76ebd275298f4da2ac8beacf80d3bdbb7c58f35d3d7dec310d13d347828","9a16e7f5a8653522e1d82e0c4dfad9a29ead292bc90154d75e3b07ed1873af3b","7649a739b89b03670949d230e56e87eb2298c57ffd4083c3125d6ccfa551e3c6","b2270e96d12c15a848cf6f8b42b657447d7e86cd72ba0a8908b4b2989396f0cd","ea7c8