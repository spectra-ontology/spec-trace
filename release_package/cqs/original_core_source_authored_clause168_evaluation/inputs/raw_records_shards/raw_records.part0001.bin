{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"NR capabilities","paragraph_zero_based":43296},{"literal_text_all_w_t_and_m_t":"E-UTRA capabilities","paragraph_zero_based":43297},{"literal_text_all_w_t_and_m_t":"MR-DC capabilities","paragraph_zero_based":43298},{"literal_text_all_w_t_and_m_t":"UTRA capabilities","paragraph_zero_based":43299},{"literal_text_all_w_t_and_m_t":"NR","paragraph_zero_based":43300},{"literal_text_all_w_t_and_m_t":"May be included if UE Radio Capability ID as specified in 23.502 [43] is used for the UE. Included otherwise.","paragraph_zero_based":43301},{"literal_text_all_w_t_and_m_t":"May be included","paragraph_zero_based":43302},{"literal_text_all_w_t_and_m_t":"May be included","paragraph_zero_based":43303},{"literal_text_all_w_t_and_m_t":"May be included, ignored by gNB if received","paragraph_zero_based":43304},{"literal_text_all_w_t_and_m_t":"E-UTRAN","paragraph_zero_based":43305},{"literal_text_all_w_t_and_m_t":"May be included if UE Radio Capability ID as specified in 23.502 [43] is used for the UE. Included otherwise.","paragraph_zero_based":43306},{"literal_text_all_w_t_and_m_t":"May be included","paragraph_zero_based":43307},{"literal_text_all_w_t_and_m_t":"May be included","paragraph_zero_based":43308},{"literal_text_all_w_t_and_m_t":"May be included, ignored by gNB if received","paragraph_zero_based":43309},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43310},{"literal_text_all_w_t_and_m_t":"NOTE 2:The following table indicates, in case of inter-RAT handover from E-UTRA, which additional IEs are included or not:","paragraph_zero_based":43311},{"literal_text_all_w_t_and_m_t":"Source system","paragraph_zero_based":43312},{"literal_text_all_w_t_and_m_t":"sourceConfig","paragraph_zero_based":43313},{"literal_text_all_w_t_and_m_t":"rrm-Config","paragraph_zero_based":43314},{"lit