{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the physical cell ID (PCI) of the SSB for the referenceSignal.","paragraph_zero_based":21672},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21673},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":21674},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":21675},{"literal_text_all_w_t_and_m_t":"RS-SSB","paragraph_zero_based":21676},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if ssb-Index is configured for referenceSignal. Otherwise it is absent, Need R.","paragraph_zero_based":21677},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21678},{"literal_text_all_w_t_and_m_t":"–PathlossReferenceRS-Id","paragraph_zero_based":21679},{"literal_text_all_w_t_and_m_t":"The IE PathlossReferenceRS-Id is an ID for a reference signal (RS) configured as PUSCH, PUCCH and SRS pathloss reference RS for unified TCI state operation.","paragraph_zero_based":21680},{"literal_text_all_w_t_and_m_t":"PathlossReferenceRS-Id information element","paragraph_zero_based":21681},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21682},{"literal_text_all_w_t_and_m_t":"-- TAG-PATHLOSSREFERENCERS-ID-START","paragraph_zero_based":21683},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21684},{"literal_text_all_w_t_and_m_t":"PathlossReferenceRS-Id-r17 ::= INTEGER (0..maxNrofPathlossReferenceRSs-1-r17)","paragraph_zero_based":21685},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21686},{"literal_text_all_w_t_and_m_t":"-- TAG-PATHLOSSREFERENCERS-ID-STOP","paragraph_zero_based":21687},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21688},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21689},{"literal_text_all_w_t_and_m_t":"–PCI-AR