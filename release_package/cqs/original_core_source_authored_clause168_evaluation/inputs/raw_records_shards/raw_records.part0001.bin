                                                spare7, spare6, spare5, spare4, spare3, spare2, spare1}","paragraph_zero_based":38004},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":38005},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38006},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-DRX-CONFIGGC-BC-STOP","paragraph_zero_based":38007},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":38008},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38009},{"literal_text_all_w_t_and_m_t":"SL-DRX-ConfigGC-BC field descriptions","paragraph_zero_based":38010},{"literal_text_all_w_t_and_m_t":"sl-DefaultDRX-GC-BC","paragraph_zero_based":38011},{"literal_text_all_w_t_and_m_t":"Indicates the default sidelink DRX configuration for groupcast and broadcast communications, which is used for QoS profile(s) that cannot be mapped into DRX configuration(s) configured for dedicated QoS profile(s). This field can be applied for the broadcast based or unicast based communication of Direct Link Establishment Request as described in TS 24.587 [57], ProSe Direct Link Establishment Request message and discovery message as described in TS 24.554 [72].","paragraph_zero_based":38012},{"literal_text_all_w_t_and_m_t":"sl-DRX-GC-BC-PerQoS-List","paragraph_zero_based":38013},{"literal_text_all_w_t_and_m_t":"List of one or multiple sidelink DRX configurations for groupcast and broadcast communication, which are mapped from QoS profile(s).","paragraph_zero_based":38014},{"literal_text_all_w_t_and_m_t":"sl-DRX-GC-BC-Cycle","paragraph_zero_based":38015}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["fff1a6a5c8c2a6f745f294b29d4ae77ea89d3c5614570a6f5d5083b31f