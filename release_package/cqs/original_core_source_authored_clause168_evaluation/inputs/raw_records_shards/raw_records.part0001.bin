{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"pdsch-ConfigMulticast","paragraph_zero_based":15936},{"literal_text_all_w_t_and_m_t":"UE specific group-common PDSCH configuration for MBS multicast for one CFR.","paragraph_zero_based":15937},{"literal_text_all_w_t_and_m_t":"sps-ConfigMulticastToAddModList","paragraph_zero_based":15938},{"literal_text_all_w_t_and_m_t":"Indicates a list of one or more DL SPS configurations for MBS multicast.","paragraph_zero_based":15939},{"literal_text_all_w_t_and_m_t":"sps-ConfigMulticastToReleaseList","paragraph_zero_based":15940},{"literal_text_all_w_t_and_m_t":"Indicates a list of one or more DL SPS configurations to be released. The NW may release a SPS configuration at any time.","paragraph_zero_based":15941},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15942},{"literal_text_all_w_t_and_m_t":"–CGI-InfoEUTRA","paragraph_zero_based":15943},{"literal_text_all_w_t_and_m_t":"The IE CGI-InfoEUTRA indicates EUTRA cell access related information, which is reported by the UE as part of E-UTRA report CGI procedure.","paragraph_zero_based":15944},{"literal_text_all_w_t_and_m_t":"CGI-InfoEUTRA information element","paragraph_zero_based":15945},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":15946},{"literal_text_all_w_t_and_m_t":"-- TAG-CGI-INFOEUTRA-START","paragraph_zero_based":15947},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15948},{"literal_text_all_w_t_and_m_t":"CGI-InfoEUTRA ::=                        SEQUENCE {","paragraph_zero_based":15949},{"literal_text_all_w_t_and_m_t":"    cgi-info-EPC                            SEQUENCE {","paragraph_zero_based":15950},{"literal_text_all_w_t_and_m_t":"            cgi-info-EPC-legacy                 CellAccessRelatedInfo-EUTRA-EPC,","paragraph_zero_based":15951},{"literal_text_all_w_t_and_m_t":"       