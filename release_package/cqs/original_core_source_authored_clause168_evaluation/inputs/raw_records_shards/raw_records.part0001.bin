{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE InvalidSymbolPattern is used to configure one invalid symbol pattern for PUSCH transmission repetition type B applicable for both DCI format 0_1 and 0_2, see TS 38.214 [19], clause 6.1.","paragraph_zero_based":18936},{"literal_text_all_w_t_and_m_t":"InvalidSymbolPattern information element","paragraph_zero_based":18937},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18938},{"literal_text_all_w_t_and_m_t":"-- TAG-INVALIDSYMBOLPATTERN-START","paragraph_zero_based":18939},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18940},{"literal_text_all_w_t_and_m_t":"InvalidSymbolPattern-r16 ::=     SEQUENCE {","paragraph_zero_based":18941},{"literal_text_all_w_t_and_m_t":"    symbols-r16                      CHOICE {","paragraph_zero_based":18942},{"literal_text_all_w_t_and_m_t":"        oneSlot                          BIT STRING (SIZE (14)),","paragraph_zero_based":18943},{"literal_text_all_w_t_and_m_t":"        twoSlots                         BIT STRING (SIZE (28))","paragraph_zero_based":18944},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":18945},{"literal_text_all_w_t_and_m_t":"    periodicityAndPattern-r16        CHOICE {","paragraph_zero_based":18946},{"literal_text_all_w_t_and_m_t":"        n2                               BIT STRING (SIZE (2)),","paragraph_zero_based":18947},{"literal_text_all_w_t_and_m_t":"        n4                               BIT STRING (SIZE (4)),","paragraph_zero_based":18948},{"literal_text_all_w_t_and_m_t":"        n5                               BIT STRING (SIZE (5)),","paragraph_zero_based":18949},{"literal_text_all_w_t_and_m_t":"        n8                               BIT STRING (SIZE (8)),","paragraph_zero_based":18950},{"literal_text_all_w_t_and_m_t":"        n10                              BIT STRING (SIZE (10)),","paragraph_zero_based":18951},{"literal_text_all_w_t_and_m_t":"        n20                              BIT STRING (SIZE (20)),","paragraph_zero_based":18952},{"literal_text_all_w_t_and_m_t":"        n40                              BIT STRING (SIZE (40))","paragraph_zero_based":18953},{"literal_text_all_w_t_and_m_t":"    }                                                                OPTIONAL,   -- Need M","paragraph_zero_based":18954},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":18955},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18956},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18957},{"literal_text_all_w_t_and_m_t":"-- TAG-INVALIDSYMBOLPATTERN-STOP","paragraph_zero_based":18958},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18959}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["26afd99c35bf4db3055d859578fc93fafa539873c99d78fe0ed9bd552678accd","c147814201b468dfa9cbf9f7c95af3a24aea6c3eaaba519b5d44bd514321a6f8","fc0a5588aadc6577f1f83f2ec6f4bf1fdb72d987bff303c8acd423dc8f7fc0d3","f7c402e66efbc578048b15867990e70aa788c51fed2a2e283b368e4a1972eda2","3edc616cc475919d42c0736c19d18245dbc23e4b5f9739e56373a19ebfa82e50","1a8f4e420d78c3ba4af242b6214daf35e8acd3cbb17296b3b85542159e61a442","914100287fecdb07a25071a517975b35cc8efa638c586ce7d516e143cf18b297","b2c7864518d1071494c2c3739533dbf444fcb9718625692c0184c99f62151e28","78fac9a0a1a3f74900cb366b5b3a312247f157321b84e978e73e5e088a114689","9a9624e98c6577d7c31fe81f10446c0ebaf78bf53545974861b140eb758b794c","ef9c42b2866f2adcb3c0c615be4d609f03903f9d7647dcb9e037c136822acecf","7b5e538f5df3c027b9590c4cddb583489b01c94a15419168b04df283d7fd0c6d","46d2536857dd58947a9f86f23bc7c3b7877a74793ede181c4280d5440a7e4f54","2a63ad4da20c7d561c54b6726c73ca5720ea35ea595393a5e8313b948267bf85","306085da074a749f5ddefc0ef568497a1616b036c418329c6a4046e9b0d1cad0","69fc905548ce5603f67a39391344229130622241e68f03d047ecf805d6980e58","3a388105d0f970ff410c07ab373f5a7e69746caeb7ec1bdd55973bc8eaac4824","a0e91fd0471120a79b807820d05bafe4ece8b40e2aa211e4e8460c7e66622df9","2137c1916f03fa181e6c5dfc1c899a6e7111346bd0a13bc982ca4250075f469f","f0126d23465ba3520a5d46acbf4f4e4a5d5fe6138ad56320749cc7d7f59b2da3","785e7e3969ffef55b6bacac800b2a94ab4fe93a41fab0118ec2f8726e5385697","b6601b458f02ca26f848d6ee9d28771483f61c208a435317ee3b947e9dcf8da2","7e673787ca7595f720902a42e7da42ca048af9dc3cc708cbb03151ef6ce6002d","ac682f353744fe55eb777c9013533e74f63f4d20a7c7d4ea8da848b6e09a324c"],"paragraph_range_zero_based":[18936,18959],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p18936"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18960},{"literal_text_all_w_t_and_m_t":"InvalidSymbolPattern field descriptions","paragraph_zero_based":18961},{"literal_text_all_w_t_and_m_t":"periodicityAndPattern","paragraph_zero_based":18962},{"literal_text_all_w_t_and_m_t":"A time domain repetition pattern at which the pattern defined by symbols recurs. This slot pattern repeats itself continuously. When the field is not configured, the UE uses the value n1 (see TS 38.214 [19], clause 6.1).","paragraph_zero_based":18963},{"literal_text_all_w_t_and_m_t":"symbols","paragraph_zero_based":18964},{"literal_text_all_w_t_and_m_t":"A symbol level bitmap in time domain (see TS 38.214[19], clause 6.1).","paragraph_zero_based":18965},{"literal_text_all_w_t_and_m_t":"For oneSlot, if ECP is configured, the first 12 bits represent the symbols within the slot and the last two bits within the bitstring are ignored by the UE; Otherwise, the 14 bits represent the symbols within the slot.","paragraph_zero_based":18966},{"literal_text_all_w_t_and_m_t":"For twoSlots, if ECP is configured, the first 12 bits represent the symbols within the first slot and the next 12 bits represent the symbols in the second slot and the last four bits within the bit string are ignored by the UE; Otherwise, the first 14 bits represent the symbols within the first slot and the next 14 bits represent the symbols in the second slot.","paragraph_zero_based":18967},{"literal_text_all_w_t_and_m_t":"For the bits representing symbols in a slot, the most significant bit of the bit string represents the first symbol in the slot and the second most significant bit represents the second symbol in the slot and so on.","paragraph_zero_based":18968},{"literal_text_all_w_t_and_m_t":"This pattern recurs (in time domain) with the configured periodicityAndPattern.","paragraph_zero_based":18969},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18970},{"literal_text_all_w_t_and_m_t":"–I-RNTI-Value","paragraph_zero_based":18971},{"literal_text_all_w_t_and_m_t":"The IE I-RNTI-Value is used to identify the suspended UE context of a UE in RRC_INACTIVE.","paragraph_zero_based":18972},{"literal_text_all_w_t_and_m_t":"I-RNTI-Value information element","paragraph_zero_based":18973},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18974},{"literal_text_all_w_t_and_m_t":"-- TAG-I-RNTI-VALUE-START","paragraph_zero_based":18975},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18976},{"literal_text_all_w_t_and_m_t":"I-RNTI-Value ::=                        BIT STRING (SIZE(40))","paragraph_zero_based":18977},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18978},{"literal_text_all_w_t_and_m_t":"-- TAG-I-RNTI-VALUE-STOP","paragraph_zero_based":18979},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18980},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18981},{"literal_text_all_w_t_and_m_t":"–LBT-FailureRecoveryConfig","paragraph_zero_based":18982},{"literal_text_all_w_t_and_m_t":"The IE LBT-FailureRecoveryConfig-r16 is used to configure the parameters used for detection of consistent uplink LBT failures for operation with shared spectrum channel access, as specified in TS 38.321 [3].","paragraph_zero_based":18983}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["ba2f12d4fb9f8775525f640f614d32ae6657630feb9a35861eefaf18416e5314","092ad57997a677b2be718666c105cf182a45fc811cbbf0404224bafe0c0b9139","e860cb606c1a950b165583f9586bbc3d874f3ef832aee8339368f54762e8