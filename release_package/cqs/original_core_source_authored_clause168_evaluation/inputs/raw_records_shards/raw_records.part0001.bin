{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–SL-RLC-ChannelConfig","paragraph_zero_based":39384},{"literal_text_all_w_t_and_m_t":"The IE SL-RLC-ChannelConfig specifies the configuration information for PC5 Relay RLC channel between L2 U2N Relay UE and L2 U2N Remote UE.","paragraph_zero_based":39385},{"literal_text_all_w_t_and_m_t":"SL-RLC-ChannelConfig information element","paragraph_zero_based":39386},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39387},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RLC-RLC-CHANNEL-CONFIG-START","paragraph_zero_based":39388},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39389},{"literal_text_all_w_t_and_m_t":"SL-RLC-ChannelConfig-r17 ::=                  SEQUENCE {","paragraph_zero_based":39390},{"literal_text_all_w_t_and_m_t":"    sl-RLC-ChannelID-r17                          SL-RLC-ChannelID-r17,","paragraph_zero_based":39391},{"literal_text_all_w_t_and_m_t":"    sl-RLC-Config-r17                             SL-RLC-Config-r16                                 OPTIONAL,   -- Need M","paragraph_zero_based":39392},{"literal_text_all_w_t_and_m_t":"    sl-MAC-LogicalChannelConfig-r17               SL-LogicalChannelConfig-r16                       OPTIONAL,   -- Need M","paragraph_zero_based":39393},{"literal_text_all_w_t_and_m_t":"    sl-PacketDelayBudget-r17                      INTEGER (0..1023)                                 OPTIONAL,   -- Need M","paragraph_zero_based":39394},{"literal_text_all_w_t_and_m_t":"    ...}","paragraph_zero_based":39395},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39396},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RLC-CHANNEL-CONFIG-STOP","paragraph_zero_based":39397},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39398},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39399},{"liter