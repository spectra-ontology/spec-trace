7}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["e44c7fa7134ab4271d1659184baa42a4a87f3514f46608d48f255fd6a17b8215","122dacd6f667fee5b3527d274ee6906c09917cdf706774f32f1da19e1460fba4","9c6e04ee5c44ebbc833eb6f4bef7fac6347f7e7935aca4109a80af0a970e6241","9b2d8f6415cea122646e3610dd9cd1daeb8a92e6a655939f407f4fa5e8a79fc1","94da83aaa541ad09a0f28469ffc308d06e82fd84b5662e67a8f0436c24ec0c4b","d543d8f44b76ccfb5e6d69418d48338d73fa2b7bbb1e7e54b07de02dfcf9cee3","5e3f71891b77d81d8cc3d5840976bbec3dce8b394987ebd473b6dd9aa4ad9673","71e6eb38457f11ae2a13e06182e33cfd3c367cb3a2c07e01903eb78d1dceedc9","05189979068c0f1d373719dc75b659cc1f3775ee5158238c3078e2ccc841bdba","f665c1ba464bcfeac7c0b44d09afb193ddee2abaf7acc1eeab20de954eb9f930","ef9c02d00589436d91fcd799f9793a6b4b08ccf37a87c6940b23945158f09954","8f6293cf390d72367e8e76897cae1578fea2989dce50a906470edc8e6c0ebab1","17c7a00ea6317cf3e5f2093bd21455eecff29bb6988f5a4ab9870d88253187b4","d6ec5d7bad2117f699dc3014b8a89c696d0db33a1d522305f3ce1c098f277874","98cc6bf5db529fa18ca548e41ea6685eed65983497ff7ec402d2ee4f56406c33","bca6b9cee689b9ef817b7aa2f041a45d2c7c8fab3adb39e9f4efb3e52d23d0f1","db61e6f8bfeebc2c5f916313a473f77a772a132075ca01c0c69487941a835825","d74e0cbabbf200ace0a87acd081316b45402e5e73674d141a6d9072c5eef19dd","0a2659c020d0d0a79df35ff89b3a9f311abeca3638b1bd966e788831ff7e0206","03e47283e8ad00c08fea26d3649afa7a53dd80cd8c29ad509532014cc10bfe34","3dd8ceef10d6c86ffcf8124678f02451518cb1c3007768bd2d9576ba625483ae","6f2ea3dd516663217de4ed66c21014ea3b448f58d6aade4162e298723663b00c","f8167f9e326fbeb7ad90f8e09220b6c6291672ad2b2b1a81a962e1f62a08ebb5","3c2c4fc22ed12db76c3552ee31a3d8fe1f5837bc74fdae062bce0601e04cbd44"],"paragraph_range_zero_based":[41904