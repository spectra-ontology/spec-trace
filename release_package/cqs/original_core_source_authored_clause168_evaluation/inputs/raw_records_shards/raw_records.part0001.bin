f65536}","paragraph_zero_based":14272},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14273},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14274},{"literal_text_all_w_t_and_m_t":"MCCH-RepetitionPeriodAndOffset-r17 ::= CHOICE {","paragraph_zero_based":14275},{"literal_text_all_w_t_and_m_t":"    rf1-r17                                INTEGER(0),","paragraph_zero_based":14276},{"literal_text_all_w_t_and_m_t":"    rf2-r17                                INTEGER(0..1),","paragraph_zero_based":14277},{"literal_text_all_w_t_and_m_t":"    rf4-r17                                INTEGER(0..3),","paragraph_zero_based":14278},{"literal_text_all_w_t_and_m_t":"    rf8-r17                                INTEGER(0..7),","paragraph_zero_based":14279}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["715538e4149bfd12adb5039be09fc6ff9ac616b4bdfb2b47674c002859479962","da5e827de6a407815ce820c852ee9708938f5396d2824ed5e00a21b2a90b11d9","9b4271c6f9b79a6eaec33dec302562b25444568ab1fecd8c61076861234a932e","21e65ef0d8d42e5e2b1caa0ae53f69079710ae82c444fcdb70b2b36c04290a61","7e8e0dac1150aa7d40369f429742938cc2067df8fd6148f0b7da2a62e5de4bb0","e8c8592ffd287b99cff3cf15e1b23688e5893d994fc3d0cf05d1fb88423ce32f","ed1c51489416ba490163e0a9671a234fd358d715234dcc12270b1faa3091c0c7","6ceff541d7d18f1f5307c2f1a45fefebb3f15add51d711e85df1e82035f911fa","21b6ab06486721cd7ed123b5a526d65b6837dca84aa27b3e39dcc5d932fddc07","f7e2aa9401283e1a99e8ffca3f9c0a3c9ebdfbd71fba2c3f23ccc4eecf14902a","c40b01ae7d1151157b847f8daef060cf0027e2160e5b72da244b164cc6daa9dd","3a45a0a07245b8eefbbb35ad8b80830aaea43999eaaeaeca40e4899ad40dd82c","30e6336199a44c3d16f3b0d7ab55aed286444ac25c3a0cb5febf6854eb4dcddd","8385215e2bd3de65781a5e3781378a9ea9be6fdf42a9c3a3468e9d77f4e6f27b","9ffdb25de97b7fbac50b6db303ac06e91735bbb6ef03e865d3947ffd54e31527","4df19e7519c54c5e4bc527ecee92f5a95cdbe6a7c0badea7050db3442c071af9","67e5c1d64b395d20f330f54b8529fb547c11eb58dcfb212a5e07d412e5cfd675","a4def514961c26d2a5db2ce92286b240bc6407129dd561d8c083c59b4232d95e","053144758ba420aae535795095003022435cfc670b934d5f5fe3e4b274acc2d6","5c6eacceddb207272d01ae3f55f425a0af279720c2ca8238a9ad22583eedd3d4","098cbc6824d5cdd5da9fe05369b36c3fe34239e1d4b77f6878b00d3dd0d6c270","3c5010cc08cbb521f2e71d8faf6256742f30af8dae0d147cf6e6f775848dd5f1","9dd4cee010d8aa38d14f3009e38a229c57e127c23cc7ffc2b61712fe7e79040b","236618e73376ba06897d51715b9a7f092f509af762994a7986bd5380635ab023"],"paragraph_range_zero_based":[14256,14279],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p14256"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    rf16-r17                               INTEGER(0..15),","paragraph_zero_based":14280},{"literal_text_all_w_t_and_m_t":"    rf32-r17                               INTEGER(0..31),","paragraph_zero_based":14281},{"literal_text_all_w_t_and_m_t":"    rf64-r17                               INTEGER(0..63),","paragraph_zero_based":14282},{"literal_text_all_w_t_and_m_t":"    rf128-r17                              INTEGER(0..127),","paragraph_zero_based":14283},{"literal_text_all_w_t_and_m_t":"    rf256-r17                              INTEGER(0..255)","paragraph_zero_based":14284},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14285},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14286},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB20-STOP","paragraph_zero_based":14287},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":14288},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14289},{"literal_text_all_w_t_and_m_t":"SIB20 field descriptions","paragraph_zero_based":14290},{"literal_text_all_w_t_and_m_t":"cfr-ConfigMCCH-MTCH","paragraph_zero_based":14291},{"literal_text_all_w_t_and_m_t":"Common frequency resource used for MCCH and MTCH reception. If the field is absent, the CFR for broadcast has the same location and size as CORESET#0 and PDSCH configuration of MCCH is the same as PDSCH configuration provided in initialDownlinkBWP in SIB1.","paragraph_zero_based":14292},{"literal_text_all_w_t_and_m_t":"mcch-WindowDuration","paragraph_zero_based":14293},{"literal_text_all_w_t_and_m_t":"Indicates, starting from the slot indicated by mcch-WindowStartSlot, the duration in slots during which MCCH may be scheduled. Absence of this field means that MCCH is only scheduled in the slot indicated by mcch-WindowStartSlot. The network always configures mcch-WindowDuration to be shorter or equal to the length of MCCH repetition period.","paragraph_zero_based":14294},{"literal_text_all_w_t_and_m_t":"mcch-ModificationPeriod","paragraph_zero_based":14295},{"literal_text_all_w_t_and_m_t":"Defines periodically appearing boundaries, i.e. radio frames for which SFN mod mcch-ModificationPeriod = 0. The contents of different transmissions of MCCH information can only be different if there is at least one such boundary in-between them. Value rf2 corresponds to two radio frames, value rf4 corresponds to four radio frames and so on.","paragraph_zero_based":14296},{"literal_text_all_w_t_and_m_t":"mcch-RepetitionPeriodAndOffset","paragraph_zero_based":14297},{"literal_text_all_w_t_and_m_t":"Defines the length and the offset of the MCCH repetition period. rf1 corresponds to a repetition period length of one radio frame, rf2 corresponds to a repetition period length of two radio frames and so on. The corresponding integer value indicates the offset of the repetition period in the number of radio frames. MCCH is scheduled in the MCCH transmission window starting from each radio frame for which: SFN mod repetition period length = offset of the repetition period.","paragraph_zero_based":14298},{"literal_text_all_w_t_and_m_t":"mcch-WindowStartSlot","paragraph_zero_based":14299},{"literal_text_all_w_t_and_m_t":"Indicates the slot in which MCCH transmission window starts.","paragraph_zero_based":14300},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14301},{"literal_text_all_w_t_and_m_t":"–SIB21","paragraph_zero_based":14302},{"literal_text_all_w_t_and_m_t":"SIB21 contains the mapping between the current and/or neighbouring carrier frequencies and MBS Frequency Selection Area Identities (FSAI).","paragraph_zero_based":14303}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256ea