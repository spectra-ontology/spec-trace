{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–SL-TypeTxSync","paragraph_zero_based":39720},{"literal_text_all_w_t_and_m_t":"The IE SL-TypeTxSync indicates the synchronization reference type.","paragraph_zero_based":39721},{"literal_text_all_w_t_and_m_t":"SL-TypeTxSync information element","paragraph_zero_based":39722},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39723},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-TYPETXSYNC-START","paragraph_zero_based":39724},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39725},{"literal_text_all_w_t_and_m_t":"SL-TypeTxSync-r16 ::=                     ENUMERATED {gnss, gnbEnb, ue}","paragraph_zero_based":39726},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39727},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-TYPETXSYNC-STOP","paragraph_zero_based":39728},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39729},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39730},{"literal_text_all_w_t_and_m_t":"–SL-UE-SelectedConfig","paragraph_zero_based":39731},{"literal_text_all_w_t_and_m_t":"IE SL-UE-SelectedConfig specifies sidelink communication configurations used for UE autonomous resource selection.","paragraph_zero_based":39732},{"literal_text_all_w_t_and_m_t":"SL-UE-SelectedConfig information element","paragraph_zero_based":39733},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39734},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-UE-SELECTEDCONFIG-START","paragraph_zero_based":39735},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39736},{"literal_text_all_w_t_and_m_t":"SL-UE-SelectedConfig-r16 ::=                 SEQUENCE {","paragraph_zero_based":39737},{"literal_text_all_w_t_and_m_t":"    sl-PSSCH-TxConfigList-r16                    SL-PSSCH-TxConfigList-r16                                   OPTIONAL,    -- Need R","paragraph_zero_based":39738},{"literal_text_all_w_t_and_m_t":"    sl-ProbResourceKeep-r16                      ENUMERATED {v0, v0dot2, v0dot4, v0dot6, v0dot8}             OPTIONAL,    -- Need R","paragraph_zero_based":39739},{"literal_text_all_w_t_and_m_t":"    sl-ReselectAfter-r16                         ENUMERATED {n1, n2, n3, n4, n5, n6, n7, n8, n9}             OPTIONAL,    -- Need R","paragraph_zero_based":39740},{"literal_text_all_w_t_and_m_t":"    sl-CBR-CommonTxConfigList-r16                SL-CBR-CommonTxConfigList-r16                               OPTIONAL,    -- Need R","paragraph_zero_based":39741},{"literal_text_all_w_t_and_m_t":"    ul-PrioritizationThres-r16                   INTEGER (1..16)                                             OPTIONAL,    -- Need R","paragraph_zero_based":39742},{"literal_text_all_w_t_and_m_t":"    sl-PrioritizationThres-r16                   INTEGER (1..8)                                              OPTIONAL,    -- Need R","paragraph_zero_based":39743}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["0d369cc2af5636b8057596db68b1fa6d0fade7b0797daa7371a0c40a87611493","6f3aa1e740f2477a5156ab7c443564b476103d67fb3475524cc7db06a37d3a52","63d600f0f2c272c70da2f7abd824a6f47882078c212be1aef3e9097c912260c5","5bea9f56d51a2661669839c51ea1024aee70c56d58f73596838eb2fb8c97acd3","374525da82b6192acc15c45e3699e0eeaf7524d98d0f23e84112ca15f54a74e8","da6d0856b3ca4fd1071abaa9df3b073f7c3ffd8d50af91c572ad8f09f98f9427","d44a3fba226a81abf2df2d875a0251ea0afdf5ff41ae3f4be9c427734bedea67","b8b225f9e940bc570fb7a34fef698b98d7f159959bf1ce77988b2406064c5f9c","baa72dd18e2b4993f511f186b8a1be1ba834ea8a37f310eb5022ed2860041f5c","715