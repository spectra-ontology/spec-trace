{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":6648},{"literal_text_all_w_t_and_m_t":"3>submit the UEAssistanceInformation message via SRB1 to lower layers for transmission;","paragraph_zero_based":6649},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":6650},{"literal_text_all_w_t_and_m_t":"2>submit the UEAssistanceInformation message to lower layers for transmission.","paragraph_zero_based":6651},{"literal_text_all_w_t_and_m_t":"5.7.4.3aSetting the contents of OverheatingAssistance IE","paragraph_zero_based":6652},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of OverheatingAssistance IE if initiated to provide overheating assistance indication for SCG in (NG)EN-DC according to clause 5.6.10.3 as specified in TS 36.331 [10]:","paragraph_zero_based":6653},{"literal_text_all_w_t_and_m_t":"1>if the UE prefers to temporarily reduce the number of maximum secondary component carriers for SCG:","paragraph_zero_based":6654},{"literal_text_all_w_t_and_m_t":"2>include reducedMaxCCs in the OverheatingAssistance IE;","paragraph_zero_based":6655},{"literal_text_all_w_t_and_m_t":"2>set reducedCCsDL to the number of maximum SCells of the SCG the UE prefers to be temporarily configured in downlink;","paragraph_zero_based":6656},{"literal_text_all_w_t_and_m_t":"2>set reducedCCsUL to the number of maximum SCells of the SCG the UE prefers to be temporarily configured in uplink;","paragraph_zero_based":6657},{"literal_text_all_w_t_and_m_t":"1>if the UE prefers to temporarily reduce maximum aggregated bandwidth of FR1 for SCG:","paragraph_zero_based":6658},{"literal_text_all_w_t_and_m_t":"2>include reducedMaxBW-FR1 in the OverheatingAssistance IE;","paragraph_zero_based":6659},{"literal_text_all_w_t_and_m_t":"2>set reducedBW-FR1-DL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all downlink carriers of FR1 of the SCG;","paragraph_zero_based":6660},{"literal_text_all_w_t_and_m_t":"2>set reducedBW-FR1-UL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all uplink carriers of FR1 of the SCG;","paragraph_zero_based":6661},{"literal_text_all_w_t_and_m_t":"1>if the UE prefers to temporarily reduce maximum aggregated bandwidth of FR2-1 for SCG:","paragraph_zero_based":6662},{"literal_text_all_w_t_and_m_t":"2>include reducedMaxBW-FR2 in the OverheatingAssistance IE;","paragraph_zero_based":6663},{"literal_text_all_w_t_and_m_t":"2>set reducedBW-FR2-DL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all downlink carriers of FR2-1 of the SCG;","paragraph_zero_based":6664},{"literal_text_all_w_t_and_m_t":"2>set reducedBW-FR2-UL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all uplink carriers of FR2-1 of the SCG;","paragraph_zero_based":6665},{"literal_text_all_w_t_and_m_t":"1>if the UE prefers to temporarily reduce maximum aggregated bandwidth of FR2-2 for SCG:","paragraph_zero_based":6666},{"literal_text_all_w_t_and_m_t":"2>include reducedMaxBW-FR2-2 in the OverheatingAssistance IE;","paragraph_zero_based":6667},{"literal_text_all_w_t_and_m_t":"2>set reducedBW-FR2-2-DL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all downlink carriers of FR2-2 of the SCG;","paragraph_zero_based":6668},{"literal_text_all_w_t_and_m_t":"2>set reducedBW-FR2-2-UL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all uplink carriers of FR2-2 of the SCG;","paragraph_zero_based":6669},{"literal_text_all_w_t_and_m_t":"1>if the UE prefers to temporarily reduce the number of maximum MIMO layers of each serving cell operating on FR1 for SCG:","paragraph_zero_based":6670},{"literal_text_all_w_t_and_m_t":"2>include reducedMaxMIMO-LayersFR1 in the OverheatingAssistance IE;","paragraph_zero_based":6671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["33e6e0c7e6cd6c624b1c5834c0e42be34fe7bf347183992954f58a9b000d920f","86d1a2c18f575774e60fbc32761125293c37eaae7aab84d6607eb915d1435c66","4cbb41360371b022815e380747011b5973bf6a036cb75451b3c49a0bef69b801","8b3ede319a98e5be55ccb1f85e31dfa4c093d63c2dcae60d8f231cdf2e43bf03","48aa3c6f62fa642c0558285e911600e9e02a313def4a0fbf856a8fbddddd71e7","d15aa8c58f3cd46eeb6a442f2bc7a9ed3b2015c9f75e88d57a590de9fdddbe18","74478336e6223d1c2031f32374cc832e949beb15bb989711ba25a46557e22b33","9e0e4f56926287ca1404bd51f275ab7e1176cb1f5311a1f0db4b70793cc498fb","2992642bbca42536f4a5591af509b28a413608ccc32d7d39d8e03c6cb74e8941","6dc769f6d910dc4991d5f77ae36fc01d10e2d1d14f2e0364f8e58d4e5f898626","a8c2ed308279d1d50288fb9ebda9b919bb28cd1bdbcb29c59f216b63a4756c12","49bbb70760ee72ca869fd357b0dfb7657b54692a3e5f5a87ce55852157412ec4","6a8b0479a295805726ad1fdcf2e5ecab6ac6d2a275ed73a765725e8c3d855bdc","e9f6a4001489a9cbadab7e741630c6f023ae4dcb8231dff1c05c6bf6adf1a1f0","8e2e590f394965a8b41b21c503bce91e419ecf25b4a6b1f2a8cd38774dd53680","dab0ffd228743029ff67024895289d3fb28a4f5ff7cece7fd9f6fa6741f1aec9","e00d28ead6853e261d9431bf7db836c6538fdc2ca7eef5479fe1342e033856cb","3a33dee49181733f7d30e6d29577c58d8f13a415fe8894797ad1ac1dc524463f","d850a4eba115f2d353e4a803f849e8a0f202d11a800dfcc8e4f049dcdb7136b3","8e0e22280510fc15e13f122484265f4694a9d62c9b4bb3e28bb67045081bed78","69baaf72a556018af4f6ecf0a7e139592b14952bf3ebd14506ab0d0b98e4c3a4","a877407788fbed378f3a76a63f711e4e10872ad1d2e06196eedd67535b28d49f","b81851824a3c7cd8e94d88f7cc4f0adfb26595c56cae18c765f77da0a1a5139c","7d330019169a0835b08a6ab7c97671c89beb533bca7bcc7dc902fa2e2193496c"],"paragraph_range_zero_based":[6648,6671],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p6648"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>set reducedMIMO-LayersFR1-DL to the number of maximum MIMO layers of each serving cell operating on FR1 of the SCG the UE prefers to be temporarily configured in downlink;","paragraph_zero_based":6672},{"literal_text_all_w_t_and_m_t":"2>set reducedMIMO-LayersFR1-UL to the number of maximum MIMO layers of each serving cell operating on FR1 of the SCG the UE prefers to be temporarily configured in uplink;","paragraph_zero_based":6673},{"literal_text_all_w_t_and_m_t":"1>if the UE prefers to temporarily reduce the number of maximum MIMO layers of each serving cell operating on FR2-1 for SCG:","paragraph_zero_based":6674},{"literal_text_all_w_t_and_m_t":"2>include reducedMaxMIMO-LayersFR2 in the OverheatingAssistance IE;","paragraph_zero_based":6675},{"literal_text_all_w_t_and_m_t":"2>set reducedMIMO-LayersFR2-DL to the number of maximum MIMO layers of each serving cell operating on FR2-1 of the SCG the UE prefers to be temporarily configured in downlink;","paragraph_zero_based":6676},{"literal_text_all_w_t_and_m_t":"2>set reducedMIMO-LayersFR2-UL to the number of maximum MIMO layers of each serving cell operating on FR2-1 of the SCG the UE prefers to be temporarily configured in uplink;","paragraph_zero_based":6677},{"literal_text_all_w_t_and_m_t":"1>if the UE prefers to temporarily reduce the number of maximum MIMO layers of each serving cell operating on FR2-2 for SCG:","paragraph_zero_based":6678},{"literal_text_all_w_t_and_m_t":"2>include reducedMaxMIMO-LayersFR2-2 in the OverheatingAssistance IE;","paragraph_zero_based":6679},{"literal_text_all_w_t_and_m_t":"2>set reducedMIMO-LayersFR2-2-DL to the number of maximum MIMO layers of each serving cell operating on FR2-2 of the SCG the UE prefers to be temporarily configured in downlink;","paragraph_zero_based":6680},{"literal_text_all_w_t_and_m_t":"2>set reducedMIMO-LayersFR2-2-UL to the number of maximum MIMO layers of each serving cell operating on FR2-2 of the SCG the UE prefers to be temporarily configured in uplink;","paragraph_zero_based":6681},{"literal_text_all_w_t_and_m_t":"5.7.4.4Relaxed measurement criterion for a stationary RedCap UE","paragraph_zero_based":6682},{"literal_text_all_w_t_and_m_t":"The relaxed measurement criterion for a stationary UE is met when:","paragraph_zero_based":6683},{"literal_text_all_w_t_and_m_t":"-(SS-RSRPRefStationaryConnected – SS-RSRP) < SSearchDeltaP-StationaryConnected,","paragraph_zero_based":6684},{"literal_text_all_w_t_and_m_t":"Where:","paragraph_zero_based":6685},{"literal_text_all_w_t_and_m_t":"-SS-RSRP = current L3 RSRP measurement of the PCell based on SSB (dB).","paragraph_zero_based":6686},{"literal_text_all_w_t_and_m_t":"-SS-RSRPRefStationaryConnected = reference SS-RSRP value of the PCell (dB), set as follows:","paragraph_zero_based":6687},{"literal_text_all_w_t_and_m_t":"-at the end of RRC reconfiguration procedure as specified in 5.3.5.3, when rrm-MeasRelaxationReportingConfig is included in the RRCReconfiguration message; or","paragraph_zero_based":6688},{"literal_text_all_w_t_and_m_t":"-after MAC successfully completes a Random Access procedure after applying a reconfigurationWithSync in spCellConfig while stationary criterion is configured; or","paragraph_zero_based":6689},{"literal_text_all_w_t_and_m_t":"-if (SS-RSRP – SS-RSRPRefStationaryConnected) > 0; or","paragraph_zero_based":6690},{"literal_text_all_w_t_and_m_t":"-if the relaxed measurement criterion has not been met for TSearchDeltaP-StationaryConnected:","paragraph_zero_based":6691},{"literal_text_all_w_t_and_m_t":"-UE shall set the value of SS-RSRPRefStationaryConnected to the current SS-RSRP value of the serving cell.","paragraph_zero_based":6692},{"literal_text_all_w_t_and_m_t":"5.7.4aVoid","paragraph_zero_based":6693},{"literal_text_all_w_t_and_m_t":"5.7.5Failure information","paragraph_zero_based":6694},{"literal_text_all_w_t_and_m_t":"5.7.5.1General","paragraph_zero_based":6695}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["ff919ffbae53cc5fdeb93735ee22368d3c501c6bb2a9ee52a53db431737e4d8f","83c4b9882f742312431527fef46741d1e7dbc7b7d39cb24177905ef9eba9ffaa","03c278ad78ef7a9d0abfda43c6d60f00484d0ee618229124ab19fae9a70a7e8c","ffa591f561bd4899891ff41feb793f68f6582ec2ea9c3bf4693452f604734ebd","96c41b1b178623f0871780e48450cb7b85254ddfb4d226ad9f5cdc78cac37f7b","4619a9db78689edc2e844453579f5a3bec034f0990af6ffd2247f1ab70535a7c","21bfd53bfd9c2bff9cfb0065ef877b789ec91b9aaa8b00dd49a17629792a498c","82a6dc9c842df77306ae9b03a53f6df21521218c6ed429e621afe9cb5f62df5b","38371482bf4e993eaf17cfa5bc5ef0c0c89db3d51456627b68d7406c954013ae","c5f3c01cf37781e72e4d7561b2e394929f544aa31b9c51eb260f3b6eb368e46b","c29e267dfb3500816aacc3fdf66e12ee51e6e58bc13b9f4cae43ab0ea55e46db","1498fd09b5b21dc689ef4828492f2d4ea1de6b4cc673d009e0636d21c9315c91","a02879e943817b161353c5ecf9befefbdbd80e9f63005cf874a3f771f577991b","966ab4964c4ae781210a75bb1aa357ae6a9a4c3d4d6487a9a0d397b8f4449baf","1ddc1988a769d9aa4d4cca66f8041ba570f0fb088fd22b309bc023494e5c9979","86b11979d4bf2c7b2a52d31529497161d692236dde9179544f973d6014cadac3","e7e939468f87454209026d13c75524c4d0f66243b320899b8912b73d780e08f5","ca32978e20070e73f80b55a4778e351e14c943a2951fd476df9d05f01e86d5b8","ef887281603929fca50dce56439daf9c00899838b3875fd67f2550d53f3ce53e","b006fe8ec7a369220549d3e0242c61327083030148a1eedb523897e99b490566","81a9afd43d25e723555cdbde12702df2520777b1865e88fdd2c2fb6cbc815a96","40e948be6e435dab4466bbd7fe3f211c252d8cb83f1d6531fdbf5b2a64a121d1","63004077802bd8cd08e1b8d5edf69a707bf0f5a8ab8350fde30051e1d2e9e623","8236069b4b1ec832634d783dfc869ca82c0d494291b49db4e718b31ce9f5e2ba"],"paragraph_range_zero_based":[6672,6695],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p6672"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":6696},{"literal_text_all_w_t_and_m_t":"Figure 5.7.5.1-1: Failure information","paragraph_zero_based":6697},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to inform the network about a failure detected by the UE.","paragraph_zero_based":6698},{"literal_text_all_w_t_and_m_t":"5.7.5.2Initiation","paragraph_zero_based":6699},{"literal_text_all_w_t_and_m_t":"A UE initiates the procedure when there is a need inform the network about a failure detected by the UE. In particular, the UE initiates the procedure when the following condition is met:","paragraph_zero_based":6700},{"literal_text_all_w_t_and_m_t":"1>upon detecting failure for an RLC bearer, in accordance with 5.3.10.3;","paragraph_zero_based":6701},{"literal_text_all_w_t_and_m_t":"1>upon detecting DAPS handover failure, in accordance with 5.3.5.8.3;","paragraph_zero_based":6702},{"literal_text_all_w_t_and_m_t":"Upon initiating the procedure, the UE shall:","paragraph_zero_based":6703},{"literal_text_all_w_t_and_m_t":"1>initiate transmission of the FailureInformation message as specified in 5.7.5.3;","paragraph_zero_based":6704},{"literal_text_all_w_t_and_m_t":"5.7.5.3Actions related to transmission of FailureInformation message","paragraph_zero_based":6705},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":6706},{"literal_text_all_w_t_and_m_t":"1>if initiated to provide RLC failure information, set FailureInfoRLC-Bearer as follows:","paragraph_zero_based":6707},{"literal_text_all_w_t_and_m_t":"2>set logicalChannelIdentity to the logical channel identity of the failing RLC bearer;","paragraph_zero_based":6708},{"literal_text_all_w_t_and_m_t":"2>set cellGroupId to the cell group identity of the failing RLC bearer;","paragraph_zero_based":6709},{"literal_text_all_w_t_and_m_t":"2>set the failureType as rlc-failure;","paragraph_zero_based":6710},{"literal_text_all_w_t_and_m_t":"1>if initiated to provide DAPS failure information, set FailureInfoDAPS as follows:","paragraph_zero_based":6711},{"literal_text_all_w_t_and_m_t":"2>set the failureType as daps-failure;","paragraph_zero_based":6712},{"literal_text_all_w_t_and_m_t":"1>if used to inform the network about a failure for an MCG RLC bearer or DAPS failure information:","paragraph_zero_based":6713},{"literal_text_all_w_t_and_m_t":"2>submit the FailureInformation message to lower layers for transmission via SRB1;","paragraph_zero_based":6714},{"literal_text_all_w_t_and_m_t":"1>else if used to inform the network about a failure for an SCG RLC bearer:","paragraph_zero_based":6715},{"literal_text_all_w_t_and_m_t":"2>if SRB3 is configured;","paragraph_zero_based":6716},{"literal_text_all_w_t_and_m_t":"3>submit the FailureInformation message to lower layers for transmission via SRB3;","paragraph_zero_based":6717},{"literal_text_all_w_t_and_m_t":"2>else;","paragraph_zero_based":6718},{"literal_text_all_w_t_and_m_t":"3>if the UE is in (NG)EN-DC:","paragraph_zero_based":6719}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["5967fcd020d4695d92c43863348ac815f4ecf886a8da40d326d02b7a09d08298","c00fa5e64472b58f2d6d8d15d88104aa54c3644af2abab7bd1387aef2cdbfbdb","9bdd99dc6e0a08e159466dbf4a2a23a021727d8cb5ed7ccf671ea00b1e6840ae","772f4d57e30d55715870da607b29f5016c33d1fa359fbf27816a4e67bd74a807","bb08456e2315977e4e8d541ac131ad72482e2116416331bd55705856cb340bb4","4ad40c40fcfa65a86387c994ab103605e7975d4767ba80418c8cce5f400c1ea3","a98c8f699363800d36ec9e9cb2adc8a627d0d7f0f92f2c5ac6e25a2926076941","743fdc821ab36083e558027eba68877fa079b3aaf618f3270668b278506378ad","22f43ee11461b6e62124cb56196c845a3b5b56b2bb0abf50e7faa3e1ea28b3d6","4c000db28a027502d771b01356330efa1e51c1b97314fc56e6075908207ca6e8","8f2222b9aaa3da4e5b53dc22902491442d090c9fd01525810a45b946b23b59f2","a30c33ee58b50499800633d049970e3e316e859c9e48f8c5498a9ed15df2ab2d","bf7d47293bf0f726211963290bacbe3538a7f36f1f0f2a81c755797c3640f578","97f66ca6a8c091854dec17edb7ebceef70fc3d6f11e2d3ad77fc83bea18e6aaa","7be138ec063991b40f27c98943294fbcf2e90f1e13dfe3497f0e0de090f4630d","d717f304262429a247119242f2401be373ef7f043fc17a298d04aa1504966735","551b1817524145f28d6c60ed176aec099d92e4b019a858a9abd7d4f2429f5188","970b1b9813801ecd9f31ffa9c0760088457d7ccf68c4d853ef405271d6aae68f","4deb85a3cd5b2376aec9f69a2d671b6a17fe6607fd596a49d5afd66fd4d21a87","774cf517d1db61e3dd88f3ccac977a463ba2a0731bf1b743b8e4cc2943ff023f","8021de96e8a1b4ffaf152b98747bc4904103dd476d61d1e487857e5b4158b3ce","fe6e5246e943512c1855526cedab9c593fe302d045bb9633a9d8d1ca1906e9e8","aa0bb32d10209c3dd7ee1c1d07e60bb0e8617366ed6ee8f217aae08ab55794ff","2d04852b928958eac85569c2cd30941bc480883449b0369189d3c6677637eb3e"],"paragraph_range_zero_based":[6696,6719],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p6696"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>submit the FailureInformation message via E-UTRA SRB1 embedded in E-UTRA RRC message ULInformationTransferMRDC as specified in TS 36.331 [10].","paragraph_zero_based":6720},{"literal_text_all_w_t_and_m_t":"3>else if the UE is in NR-DC:","paragraph_zero_based":6721},{"literal_text_all_w_t_and_m_t":"4>submit the FailureInformation message via SRB1 embedded in NR RRC message ULInformationTransferMRDC as specified in clause 5.7.2a.3.","paragraph_zero_based":6722},{"literal_text_all_w_t_and_m_t":"5.7.6DL message segment transfer","paragraph_zero_based":6723},{"literal_text_all_w_t_and_m_t":"5.7.6.1General","paragraph_zero_based":6724},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":6725},{"literal_text_all_w_t_and_m_t":"Figure 5.7.6.1-1: DL message segment transfer","paragraph_zero_based":6726},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to transfer segments of DL DCCH messages from the network to the UE.","paragraph_zero_based":6727},{"literal_text_all_w_t_and_m_t":"NOTE:The segmentation of DL DCCH message is only applicable to RRCReconfiguration and RRCResume messages in this release.","paragraph_zero_based":6728},{"literal_text_all_w_t_and_m_t":"5.7.6.2Initiation","paragraph_zero_based":6729},{"literal_text_all_w_t_and_m_t":"The network initiates the DL Dedicated Message Segment transfer procedure whenever the encoded RRC message PDU exceeds the maximum PDCP SDU size. The network initiates the DL Dedicated Message Segment transfer procedure by sending the DLDedicatedMessageSegment message.","paragraph_zero_based":6730},{"literal_text_all_w_t_and_m_t":"5.7.6.3Reception of DLDedicatedMessageSegment by the UE","paragraph_zero_based":6731},{"literal_text_all_w_t_and_m_t":"Upon receiving DLDedicatedMessageSegment message, the UE shall:","paragraph_zero_based":6732},{"literal_text_all_w_t_and_m_t":"1>store the segment included in rrc-MessageSegmentContainer;","paragraph_zero_based":6733},{"literal_text_all_w_t_and_m_t":"1>if all segments of the message have been received:","paragraph_zero_based":6734},{"literal_text_all_w_t_and_m_t":"2>assemble the message from the received segments and process the message according to 5.3.5.3 for the RRCReconfiguration message or 5.3.13.4 for the RRCResume message;","paragraph_zero_based":6735},{"literal_text_all_w_t_and_m_t":"2>discard all segments.","paragraph_zero_based":6736},{"literal_text_all_w_t_and_m_t":"5.7.7UL message segment transfer","paragraph_zero_based":6737},{"literal_text_all_w_t_and_m_t":"5.7.7.1General","paragraph_zero_based":6738},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":6739},{"literal_text_all_w_t_and_m_t":"Figure 5.7.7.1-1: UL message segment transfer","paragraph_zero_based":6740},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to transfer segments of UL DCCH messages from UE to a NG-RAN in RRC_CONNECTED.","paragraph_zero_based":6741},{"literal_text_all_w_t_and_m_t":"NOTE:The segmentation of UL DCCH message is only applicable to UECapabilityInformation and MeasurementReportAppLayer in this release.","paragraph_zero_based":6742},{"literal_text_all_w_t_and_m_t":"5.7.7.2Initiation","paragraph_zero_based":6743}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["8720163b46ed105ef58a4c0f9440ba7f64e2f153d56aedb670343ceec79492e9","674dbe555fb0b35311672f18e2671d824f22267ff3560f38cc7265dcbea32588","a6457f80b42ea90c5cbdd36e8b5b5a80835c5ad860b2189544da296d766dafe4","649a8c383d357042d16d6630de20b60e6d0ba17de9a1aec0e2f9d330494541b7","307fa6a02f02be3ba0dc08874d9e0d5f8cbd366b0bf9b755aa4b778484f8ca57","b424f4316b35bdb70b71c13b0e5eadfb85c9fc0d55a38493848b4d6d6b4ce7ed","eda7ebb5f1021f39a6cf4e651c3ce365bf9981c3295266c2ef493f6be49d754f","00168e481dd716c9a9a0409fbbd61a6cc6047688fe90a63c2d5b6e1fa435ccc7","8c94d28e9ee743ae794916a13a86cbe7d028bb64051424ccdf77e2fbc7488393","389918b924797391358b95248c4f43ef73a6fc4cff49790716d3be6a2951573f","c497812ae9addaf41d8328bd691a1a260f16ca899fbc5f6392ff577ae83454db","4e01622f04c4fa900c72c0738b0a009d71b0ee38b75c416901a9333f0cf081f9","4e7c3557e3a5a2f19f6a825c8a5ced3f47f8c878817ea26bea7e8455ba5519c2","747d3b198a881caeafd8a0d08ca3635102b1dae36b00015819e0dd301200006e","3015596c390f673ba3292af4a8c72cd2d76b6919e0a977eb9c94a857f47d9877","c63fec58233462f1dd2e9978e7502790b9ec8bc24754e2fd1588974e09660f4a","49b1632ab1920fca0cb9c483e5fe4b263f0f4401e66db6b25064d4cbb7cf3695","578b2fd7e143bad67fc56cb48d8d909435d682acb85e22e196a651fbe083cbf1","b2b76810621f90c975e7aa169f3864de14d79a0196b0d87215927ff2d592a540","5b4c032a8c427d6b244b01d1238d10eea73d1915c55127cccd260eedb790ca0b","12d6345ed00190ac61713c2303c0ebae158fd023f78223690e7442e2ccafa536","11ed6708a39a2e5f76cde3c1baff8c544fe11e0b151a772445f3a94201183979","866025a0e51daf5d89ca12b82183927d60432d237bf0a1c5797c8b8ea6d3db15","c8ceddbb664249073a8de49c3970e988b4a458e74b801331be5e4c5ff17fb390"],"paragraph_range_zero_based":[6720,6743],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p6720"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"A UE capable of UL RRC message segmentation in RRC_CONNECTED will initiate the procedure when the following conditions are met:","paragraph_zero_based":6744},{"literal_text_all_w_t_and_m_t":"1>if the RRC message segmentation is enabled based on the field rrc-SegAllowed received, and","paragraph_zero_based":6745},{"literal_text_all_w_t_and_m_t":"1>if the encoded RRC message is larger than the maximum supported size of a PDCP SDU specified in TS 38.323 [5];","paragraph_zero_based":6746},{"literal_text_all_w_t_and_m_t":"Upon initiating the procedure, the UE shall:","paragraph_zero_based":6747},{"literal_text_all_w_t_and_m_t":"1>initiate transmission of the ULDedicatedMessageSegment message as specified in 5.7.7.3;","paragraph_zero_based":6748},{"literal_text_all_w_t_and_m_t":"5.7.7.3Actions related to transmission of ULDedicatedMessageSegment message","paragraph_zero_based":6749},{"literal_text_all_w_t_and_m_t":"The UE shall segment the encoded RRC PDU based on the maximum supported size of a PDCP SDU specified in TS 38.323 [5]. UE shall minimize the number of segments and set the contents of the ULDedicatedMessageSegment messages as follows:","paragraph_zero_based":6750},{"literal_text_all_w_t_and_m_t":"1>For each new UL DCCH message, set the segmentNumber to 0 for the first message segment and increment the segmentNumber for each subsequent RRC message segment;","paragraph_zero_based":6751},{"literal_text_all_w_t_and_m_t":"1>set rrc-MessageSegmentContainer to include the segment of the UL DCCH message corresponding to the segmentNumber;","paragraph_zero_based":6752},{"literal_text_all_w_t_and_m_t":"1>if the segment included in the rrc-MessageSegmentContainer is the last segment of the UL DCCH message:","paragraph_zero_based":6753},{"literal_text_all_w_t_and_m_t":"2>set the rrc-MessageSegmentType to lastSegment;","paragraph_zero_based":6754},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":6755},{"literal_text_all_w_t_and_m_t":"2>set the rrc-MessageSegmentType to notLastSegment;","paragraph_zero_based":6756},{"literal_text_all_w_t_and_m_t":"1>submit all the ULDedicatedMessageSegment messages generated for the segmented RRC message to lower layers for transmission in ascending order based on the segmentNumber, upon which the procedure ends.","paragraph_zero_based":6757},{"literal_text_all_w_t_and_m_t":"5.7.8Idle/inactive Measurements","paragraph_zero_based":6758},{"literal_text_all_w_t_and_m_t":"5.7.8.1General","paragraph_zero_based":6759},{"literal_text_all_w_t_and_m_t":"This procedure specifies the measurements to be performed and stored by a UE in RRC_IDLE and RRC_INACTIVE when it has an idle/inactive measurement configuration.","paragraph_zero_based":6760},{"literal_text_all_w_t_and_m_t":"5.7.8.1aMeasurement configuration","paragraph_zero_based":6761},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to update the idle/inactive measurement configuration.","paragraph_zero_based":6762},{"literal_text_all_w_t_and_m_t":"The UE initiates this procedure while T331 is running and SDT procedure is not ongoing and one of the following conditions is met:","paragraph_zero_based":6763},{"literal_text_all_w_t_and_m_t":"1>upon selecting a cell when entering RRC_IDLE or RRC-INACTIVE from RRC_CONNECTED or RRC_INACTIVE; or","paragraph_zero_based":6764},{"literal_text_all_w_t_and_m_t":"1>upon update of system information (SIB4, or SIB11), e.g. due to intra-RAT cell (re)selection;","paragraph_zero_based":6765},{"literal_text_all_w_t_and_m_t":"While in RRC_IDLE or RRC_INACTIVE, and T331 is running, the UE shall:","paragraph_zero_based":6766},{"literal_text_all_w_t_and_m_t":"1>if VarMeasIdleConfig includes neither a measIdleCarrierListEUTRA nor a measIdleCarrierListNR received from the RRCRelease message:","paragraph_zero_based":6767}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["66eea5da9cfadcd69ec8e67f6aed58bae341edd0ef1f4cb3542c263c2841dd7e","c61b13acdfe908df8e69796bcb6c279095bfaae3ca99b9eecbc3d14aadb5f6fe","1df353c791c454ce2289ade85f9fbbb05c7468c79d627345272aa62ba52c35d4","845c87df0fc2024e76b4cca50b98680a00ed9f8e1e28ed85ea86337573aab0ed","8e25e2a9fa87f901fadceeb8a1ffbdc53ab682e586a350b1907fcdd86bd2cdd0","0957729fdf52ec3dce76be44c6e527112aeb46bd8be1eaeb170e7a8de6181598","cd5f72637b19eb81f894f812662b0635f4670196414b99e96fdc766faba23b07","7d7f573d6469bca884e1b188ad855f80d8c3a38ad051b09ace30c6eae68510b1","7641fecdb976a5655c780c861b76935bc5b37cc0c10541fc72d808e530918392","7c8f6eb26e592cf129694a3c29ddf228624cd893b06f47ca18bd519b1ed4aca1","2b138efb2a22fd06e115ef14486420cf93a41339ab8afba112bc7a021f2c9ca3","9fe32154153c87de2fc425ee98e5b92ad16b449f1ca18699498a38af2127bf3b","c14bf7dcb13fbc5213e456986da7e4fffdd88bb13a934d7d4bef735add73f022","40c01e739ab166f6deab11f30d80b384e1b7c7d693a159ad2cd582f609d0c8da","dbaaa5fb07767fc1eb4c16d0c26aabca9335a5edd28c8ea8b8ba16a036482cec","af20c452c5ec6539668b3edc9a80c654e15fbaf00458a47673eabe6e302f4ad3","f4088152d11d0f93909ab51edadd3900d8dbfd56f139191d6e8c1026fe312c9f","cf94ffab21708e7f5f37a798eac621097df059b4f115e53001e460af1cf0a9ab","cf7a2468b2e218f3049ae8603442116ab7cdf604b447ccad1f439345f80ecf82","ef30d2f4eb8063d3a84a7fb8665bb150d4710b5e1588c0ef5bcfe7cb810111a6","31d8626cf65f5f6365448c09b56dce2cb1fdeb1a7f2a64882b5bd1278834cace","efdae2548db739a511970ec0f4e40365071503a5bb01146fb1d1aaca141a1052","fe5166e8189c746be6162a4ad1017f78422eec154072708c3205f846cb928da9","b459c086c8f56e0a1e504035c635cd6283528b7642a035d66e02ff85c9b87484"],"paragraph_range_zero_based":[6744,6767],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p6744"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if the UE supports idleInactiveEUTRA-MeasReport:","paragraph_zero_based":6768},{"literal_text_all_w_t_and_m_t":"3>if the SIB11 includes the measIdleConfigSIB and contains measIdleCarrierListEUTRA:","paragraph_zero_based":6769},{"literal_text_all_w_t_and_m_t":"4>store or replace the measIdleCarrierListEUTRA of measIdleConfigSIB of SIB11 within VarMeasIdleConfig;","paragraph_zero_based":6770},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":6771},{"literal_text_all_w_t_and_m_t":"4>remove the measIdleCarrierListEUTRA in VarMeasIdleConfig, if stored;","paragraph_zero_based":6772},{"literal_text_all_w_t_and_m_t":"2>if the UE supports idleInactiveNR-MeasReport:","paragraph_zero_based":6773},{"literal_text_all_w_t_and_m_t":"3>if SIB11 includes the measIdleConfigSIB and contains measIdleCarrierListNR:","paragraph_zero_based":6774},{"literal_text_all_w_t_and_m_t":"4>store or replace the measIdleCarrierListNR of measIdleConfigSIB of SIB11 within VarMeasIdleConfig;","paragraph_zero_based":6775},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":6776},{"literal_text_all_w_t_and_m_t":"4>remove the measIdleCarrierListNR in VarMeasIdleConfig, if stored;","paragraph_zero_based":6777},{"literal_text_all_w_t_and_m_t":"1>for each entry in the measIdleCarrierListNR within VarMeasIdleConfig that does not contain an ssb-MeasConfig received from the RRCRelease message:","paragraph_zero_based":6778},{"literal_text_all_w_t_and_m_t":"2>if there is an entry in measIdleCarrierListNR in measIdleConfigSIB of SIB11 that has the same carrier frequency and subcarrier spacing as the entry in the measIdleCarrierListNR within VarMeasIdleConfig and that contains ssb-MeasConfig:","paragraph_zero_based":6779},{"literal_text_all_w_t_and_m_t":"3>delete the ssb-MeasConfig of the corresponding entry in the measIdleCarrierListNR within VarMeasIdleConfig;","paragraph_zero_based":6780},{"literal_text_all_w_t_and_m_t":"3>store the SSB measurement configuration from SIB11 into nrofSS-BlocksToAverage, absThreshSS-BlocksConsolidation, smtc, ssb-ToMeasure, deriveSSB-IndexFromCell, and ss-RSSI-Measurement within ssb-MeasConfig of the corresponding entry in the measIdleCarrierListNR within VarMeasIdleConfig;","paragraph_zero_based":6781},{"literal_text_all_w_t_and_m_t":"2>else if there is an entry in interFreqCarrierFreqList of SIB4 with the same carrier frequency and subcarrier spacing as the entry in measIdleCarrierListNR within VarMeasIdleConfig:","paragraph_zero_based":6782},{"literal_text_all_w_t_and_m_t":"3>delete the ssb-MeasConfig of the corresponding entry in the measIdleCarrierListNR within VarMeasIdleConfig;","paragraph_zero_based":6783},{"literal_text_all_w_t_and_m_t":"3>store the SSB measurement configuration from SIB4 into nrofSS-BlocksToAverage, absThreshSS-BlocksConsolidation, smtc, ssb-ToMeasure, deriveSSB-IndexFromCell, and ss-RSSI-Measurement within ssb-MeasConfig of the corresponding entry in the measIdleCarrierListNR within VarMeasIdleConfig;","paragraph_zero_based":6784},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":6785},{"literal_text_all_w_t_and_m_t":"3>remove the ssb-MeasConfig of the corresponding entry in the measIdleCarrierListNR within VarMeasIdleConfig, if stored;","paragraph_zero_based":6786},{"literal_text_all_w_t_and_m_t":"1>perform measurements according to 5.7.8.2a.","paragraph_zero_based":6787},{"literal_text_all_w_t_and_m_t":"5.7.8.2Void","paragraph_zero_based":6788},{"literal_text_all_w_t_and_m_t":"5.7.8.2aPerforming measurements","paragraph_zero_based":6789},{"literal_text_all_w_t_and_m_t":"When performing measurements on NR carriers according to this clause, the UE shall derive the cell quality as specified in 5.5.3.3 and consider the beam quality to be the value of the measurement results of the concerned beam, where each result is averaged as described in TS 38.215 [9].","paragraph_zero_based":6790},{"literal_text_all_w_t_and_m_t":"While in RRC_IDLE or RRC_INACTIVE, and T331 is running and SDT procedure is not ongoing, the UE shall:","paragraph_zero_based":6791}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["fce235439e748de3c5d06072e2606ccb65914b2ccdb0d33cbebafc82862847a2","cbf1d0c11690487a7967f84a0593972ea638b9eff865e68783fc41c57b8c3712","fad4a6974024456faea69e3b7e0e2b1f7a69828aaae27e35930cbd4369033515","1f6f660adc850721e405e9138c9ff49952761c09a5cd09a6f02039d32a2043ab","e901882de8313992d7b509faeb7430b4ea59f59523f8ee10b2adfb57ae45d9b1","9b80d044610decb487ca3d0af8d9c015e6150c71e153d53aefd11643cdee3a54","478afd6ea52822841b608d1f6b480fe9d253c747338dac48f25866297ff9592f","80e1d0a34a73aefd6c31788af874faafdeafbd7d0b8524f72155b8653521db20","3b2010f5caaf8410c25479ed96f94a9a9eb2a7597dbafb6abb38d06185198cc7","6311751df403d2e801f8a66094dec14288eb0c1e8e43606c595a3236cf0759b6","014d436db65775b2854880bf1e8ea8667e9cdab8d39ef1f8acdd0ea567d182d6","c8c5ee63e6c64f9af0ef5cc56eece9e070e3d06bc57e9211fdc063791655600e","b9de53845b7c31d454f2b6d30e99487eba0c97570666595b83865b6482a721e0","f7c0899d83bfbb8c666a0edcf3300540f418abd7a7320155a9c097be243e9567","d623af70313af0ec8113033213a6fecd1277e9aaa90be1f7d179fc9123918a0a","119b090d643953098169a1f5e34ec4bc496ace573f9548e8f5d50cf1c90bfe76","9503748fa2025ceaa03e3350c1f1c152d0b9a323c747aabf60d97459e4e03641","6d579adc2a30321241cbaef86034c01afd764c8feaecd339812472a938a64bad","9ab4ec44b187ff62038dece21b55f1d4c856f17a9624dfa461c91692ac6c1127","96072c440e0806b869a91e4c305a51e9d4bd49cc92720f46e43341f830c01f69","e361300fd6cfafc21f9ae539cae50f765d82f14a2c7c0a0136ea62b599226430","da1685dddf92deafbd81e9a6f6336ee272f214b1afba15c39c580789c489c057","146b63798bf59fd905b63b43ff8ce3d19867853098ce4b8ced3a3f43c7058158","891fe15bd98c66128198caef18823eadb4d589a5d18b663052784c9f1a343dab"],"paragraph_range_zero_based":[6768,6791],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p6768"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>perform the measurements in accordance with the following:","paragraph_zero_based":6792},{"literal_text_all_w_t_and_m_t":"2>if the VarMeasIdleConfig includes the measIdleCarrierListEUTRA and the SIB1 contains idleModeMeasurementsEUTRA:","paragraph_zero_based":6793},{"literal_text_all_w_t_and_m_t":"3>for each entry in measIdleCarrierListEUTRA within VarMeasIdleConfig:","paragraph_zero_based":6794},{"literal_text_all_w_t_and_m_t":"4>if UE supports NE-DC between the serving carrier and the carrier frequency indicated by carrierFreqEUTRA within the corresponding entry:","paragraph_zero_based":6795},{"literal_text_all_w_t_and_m_t":"5>perform measurements in the carrier frequency and bandwidth indicated by carrierFreqEUTRA and allowedMeasBandwidth within the corresponding entry;","paragraph_zero_based":6796},{"literal_text_all_w_t_and_m_t":"5>if the reportQuantitiesEUTRA is set to rsrq:","paragraph_zero_based":6797},{"literal_text_all_w_t_and_m_t":"6>consider RSRQ as the sorting quantity;","paragraph_zero_based":6798},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":6799},{"literal_text_all_w_t_and_m_t":"6>consider RSRP as the sorting quantity;","paragraph_zero_based":6800},{"literal_text_all_w_t_and_m_t":"5>if the measCellListEUTRA is included:","paragraph_zero_based":6801},{"literal_text_all_w_t_and_m_t":"6>consider cells identified by each entry within the measCellListEUTRA to be applicable for idle/inactive mode measurement reporting;","paragraph_zero_based":6802},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":6803},{"literal_text_all_w_t_and_m_t":"6>consider up to maxCellMeasIdle strongest identified cells, according to the sorting quantity, to be applicable for idle/inactive measurement reporting;","paragraph_zero_based":6804},{"literal_text_all_w_t_and_m_t":"5>for all cells applicable for idle/inactive measurement reporting, derive measurement results for the measurement quantities indicated by reportQuantitiesEUTRA;","paragraph_zero_based":6805},{"literal_text_all_w_t_and_m_t":"5>store the derived measurement results as indicated by reportQuantitiesEUTRA within the measReportIdleEUTRA in VarMeasIdleReport in decreasing order of the sorting quantity, i.e. the best cell is included first, as follows:","paragraph_zero_based":6806},{"literal_text_all_w_t_and_m_t":"6>if qualityThresholdEUTRA is configured:","paragraph_zero_based":6807},{"literal_text_all_w_t_and_m_t":"7>include the measurement results from the cells applicable for idle/inactive measurement reporting whose RSRP/RSRQ measurement results are above the value(s) provided in qualityThresholdEUTRA;","paragraph_zero_based":6808},{"literal_text_all_w_t_and_m_t":"6>else:","paragraph_zero_based":6809},{"literal_text_all_w_t_and_m_t":"7>include the measurement results from all cells applicable for idle/inactive measurement reporting;","paragraph_zero_based":6810},{"literal_text_all_w_t_and_m_t":"2>if the VarMeasIdleConfig includes the measIdleCarrierListNR and the SIB1 contains idleModeMeasurementsNR:","paragraph_zero_based":6811},{"literal_text_all_w_t_and_m_t":"3>for each entry in measIdleCarrierListNR within VarMeasIdleConfig that contains ssb-MeasConfig:","paragraph_zero_based":6812},{"literal_text_all_w_t_and_m_t":"4>if UE supports carrier aggregation or NR-DC between serving carrier and the carrier frequency and subcarrier spacing indicated by carrierFreq and ssbSubCarrierSpacing within the corresponding entry:","paragraph_zero_based":6813},{"literal_text_all_w_t_and_m_t":"5>perform measurements in the carrier frequency and subcarrier spacing indicated by carrierFreq and ssbSubCarrierSpacing within the corresponding entry;","paragraph_zero_based":6814},{"literal_text_all_w_t_and_m_t":"5>if the reportQuantities is set to rsrq:","paragraph_zero_based":6815}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["851cad8c672ea487279564bc799789a26a97cddf80d08da42b8e3a0c683fef7e","8fc30122af79aef8a0942a23d863f8306228351b08d2b889cc3fa02826bb8cd2","2e97938099aee2f6bf48978c18df83b0cee99e078f1c4e036a9e13ee7f21d83e","504a4c7900d84e527b1511f67b0f41db4102f0913bffc3f030d434d0820ee849","01c9c19e25628f313b1fafebb55601a318bab560330922d6da206f9958fe24a2","56b8816a1ad4a15ed9b8ddf08e24e881f50a1a72acb566d82332fc1ebf14842c","5e9ff8d207d8554233627e0d17d8aa529c3ab9c3cd8c74af31e1fe659186d8ee","ae56204249f6fd235c11e92b7436a523d7fcfafebb6b84845ab4b3e1763578a6","a510b0ee3b9027fca64c8bdc45a738eb9513b95c9da064f42ee5559183ca997d","5d9bd3d7519628325154e3d4768c9ecdd2d8f980eeaa30059b025cbe59e4cb70","299907f1ff8c4e0ffc896c3261f77a01ead9d46e89b9acf2278998e3fc7a8b28","b0fc1e83c452f438c35fa9638d16c2e9ecb50a76829c5247bd7d61ecb5cb8366","3d893d702514c52c178044694df7ed4c8b0512ecb2341a818e2e8fe32ce067e6","ee4e44f99387e63509989aedcec0e8f807a78f5930ae58012587cc1131aa6772","b555ba7f6200cb1923e3fbafbd4bdb955589d596b526893664b02bb5fdb53dfe","9db95492bbbf99be491eda4cb96877a87555be670713347cc94eb3d7cc3c883e","53d71f08dfd52d9d081c9a76b98f6b1d57da609c5f2b7809949b2346f25953bc","308419695e8edf34b0e64342c7e88a664e44b715425f5bd4b065c2fdebc24bf3","10aa6429ee0e31afca8d8801c2f0d65677d57841910c38880b1ca9b544b7bb13","0fb8f5a7c55b2ffbcf7d9914e7c50c98a9aa12db5db36120ade505460213e958","3b0052d8df13edc04edaa5b4cc4e51845b7c661747facb2c22e9b0004d2b2de6","5bf457ce5364794594b4ef819d5896d4b35f6287c0e234b5a6b5f4a9d7221a46","e95128ee4e2787f0532ad340d339a65055dcd8cb79e10e8256f4999098bab526","fb38ae909e6b143960680ec74e492be65a9408ce563b65ea9034dfff2044ac6a"],"paragraph_range_zero_bas