{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17976},{"literal_text_all_w_t_and_m_t":"–DMRS-UplinkConfig","paragraph_zero_based":17977},{"literal_text_all_w_t_and_m_t":"The IE DMRS-UplinkConfig is used to configure uplink demodulation reference signals for PUSCH.","paragraph_zero_based":17978},{"literal_text_all_w_t_and_m_t":"DMRS-UplinkConfig information element","paragraph_zero_based":17979},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17980},{"literal_text_all_w_t_and_m_t":"-- TAG-DMRS-UPLINKCONFIG-START","paragraph_zero_based":17981},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17982},{"literal_text_all_w_t_and_m_t":"DMRS-UplinkConfig ::=               SEQUENCE {","paragraph_zero_based":17983},{"literal_text_all_w_t_and_m_t":"    dmrs-Type                           ENUMERATED {type2}                                                  OPTIONAL,   -- Need S","paragraph_zero_based":17984},{"literal_text_all_w_t_and_m_t":"    dmrs-AdditionalPosition             ENUMERATED {pos0, pos1, pos3}                                       OPTIONAL,   -- Need S","paragraph_zero_based":17985},{"literal_text_all_w_t_and_m_t":"    phaseTrackingRS                     SetupRelease { PTRS-UplinkConfig }                                  OPTIONAL,   -- Need M","paragraph_zero_based":17986},{"literal_text_all_w_t_and_m_t":"    maxLength                           ENUMERATED {len2}                                                   OPTIONAL,   -- Need S","paragraph_zero_based":17987},{"literal_text_all_w_t_and_m_t":"    transformPrecodingDisabled          SEQUENCE {","paragraph_zero_based":17988},{"literal_text_all_w_t_and_m_t":"        scramblingID0                       INTEGER (0..65535)                                              OPTIONAL,   -- Need S","paragraph_zero_based":1798