{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    sk-Counter                          SK-Counter                                                      OPTIONAL, -- Need N","paragraph_zero_based":10704},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                RRCResume-v1610-IEs                                             OPTIONAL","paragraph_zero_based":10705},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":10706},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10707},{"literal_text_all_w_t_and_m_t":"RRCResume-v1610-IEs ::=             SEQUENCE {","paragraph_zero_based":10708},{"literal_text_all_w_t_and_m_t":"    idleModeMeasurementReq-r16          ENUMERATED {true}                                               OPTIONAL, -- Need N","paragraph_zero_based":10709},{"literal_text_all_w_t_and_m_t":"    restoreMCG-SCells-r16               ENUMERATED {true}                                               OPTIONAL, -- Need N","paragraph_zero_based":10710},{"literal_text_all_w_t_and_m_t":"    restoreSCG-r16                      ENUMERATED {true}                                               OPTIONAL, -- Need N","paragraph_zero_based":10711},{"literal_text_all_w_t_and_m_t":"    mrdc-SecondaryCellGroup-r16         CHOICE {","paragraph_zero_based":10712},{"literal_text_all_w_t_and_m_t":"        nr-SCG-r16                          OCTET STRING (CONTAINING RRCReconfiguration),","paragraph_zero_based":10713},{"literal_text_all_w_t_and_m_t":"        eutra-SCG-r16                       OCTET STRING","paragraph_zero_based":10714},{"literal_text_all_w_t_and_m_t":"    }                                                                                                   OPTIONAL, -- Cond RestoreSCG","paragraph_zero_based":10715},{"literal_text_all_w_t_and_m_t":"    needForGapsConfigNR-r16             SetupRelease {NeedForGapsConfigNR-r16}                          OPTIONAL, -- Need M","paragraph_zero_based":10716},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                RRCResume-v1700-IEs                                             OPTIONAL","paragraph_zero_based":10717},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":10718},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10719},{"literal_text_all_w_t_and_m_t":"RRCResume-v1700-IEs ::=             SEQUENCE {","paragraph_zero_based":10720},{"literal_text_all_w_t_and_m_t":"    sl-ConfigDedicatedNR-r17            SetupRelease {SL-ConfigDedicatedNR-r16}                         OPTIONAL, -- Cond L2RemoteUE","paragraph_zero_based":10721},{"literal_text_all_w_t_and_m_t":"    sl-L2RemoteUE-Config-r17            SetupRelease {SL-L2RemoteUE-Config-r17}                         OPTIONAL, -- Cond L2RemoteUE","paragraph_zero_based":10722},{"literal_text_all_w_t_and_m_t":"    needForGapNCSG-ConfigNR-r17         SetupRelease {NeedForGapNCSG-ConfigNR-r17}                      OPTIONAL, -- Need M","paragraph_zero_based":10723},{"literal_text_all_w_t_and_m_t":"    needForGapNCSG-ConfigEUTRA-r17      SetupRelease {NeedForGapNCSG-ConfigEUTRA-r17}                   OPTIONAL, -- Need M","paragraph_zero_based":10724},{"literal_text_all_w_t_and_m_t":"    scg-State-r17                       ENUMERATED {deactivated}                                        OPTIONAL, -- Need N","paragraph_zero_based":10725},{"literal_text_all_w_t_and_m_t":"    appLayerMeasConfig-r17              AppLayerMeasConfig-r17                                          OPTIONAL, -- Need M","paragraph_zero_based":10726},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                SEQUENCE {}                                                     OPTIONAL","paragraph_zero_based":10727}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":