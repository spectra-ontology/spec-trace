{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SpatialRelationInfo-PDC-r17 ::=   SEQUENCE {","paragraph_zero_based":29112},{"literal_text_all_w_t_and_m_t":"    referenceSignal                   CHOICE {","paragraph_zero_based":29113},{"literal_text_all_w_t_and_m_t":"        ssb-Index                         SSB-Index,","paragraph_zero_based":29114},{"literal_text_all_w_t_and_m_t":"        csi-RS-Index                      NZP-CSI-RS-ResourceId,","paragraph_zero_based":29115},{"literal_text_all_w_t_and_m_t":"        dl-PRS-PDC                        NR-DL-PRS-ResourceID-r17,","paragraph_zero_based":29116},{"literal_text_all_w_t_and_m_t":"        srs                               SEQUENCE {","paragraph_zero_based":29117},{"literal_text_all_w_t_and_m_t":"            resourceId                        SRS-ResourceId,","paragraph_zero_based":29118},{"literal_text_all_w_t_and_m_t":"            uplinkBWP                         BWP-Id","paragraph_zero_based":29119},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":29120},{"literal_text_all_w_t_and_m_t":"        ...","paragraph_zero_based":29121},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":29122},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":29123},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29124},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29125},{"literal_text_all_w_t_and_m_t":"-- TAG-SRS-CONFIG-STOP","paragraph_zero_based":29126},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29127},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29128},{"literal_text_all_w_t_and_m_t":"SRS-Config field descriptions","paragraph_zero_based":29129},{"literal_text_all_w_t_and_m_t":"tpc-Accumulation","paragraph_zero_based":29130},{"literal_text_all_w_t_and_m_t":"If the field is absent, UE applies TPC commands via accumulation. If disabled, UE applies the TPC command without accumulation (this applies to SRS when a separate closed loop is configured for SRS) (see TS 38.213 [13], clause 7.3).","paragraph_zero_based":29131},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29132},{"literal_text_all_w_t_and_m_t":"SRS-Resource, SRS-PosResource field descriptions","paragraph_zero_based":29133},{"literal_text_all_w_t_and_m_t":"cyclicShift-n2","paragraph_zero_based":29134},{"literal_text_all_w_t_and_m_t":"Cyclic shift configuration (see TS 38.214 [19], clause 6.2.1).","paragraph_zero_based":29135}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["9330cdc9715015a31093af366d4e000d94aa16c293f56ce18e023716c8d5d54f","896b53a2c741ef41778b267d6b09ebf99ae53f840a1e6d85918ad9e563597a55","2d8cf883c5fdf6bf320204ef68fcb88f5ae9de93d034f57a36db3584723743fe","19b2cacd0676c42befee2d59898f09385ecd9d0bb05425d79ae801e01f86d1fd","0b6356506743bb04bd3d317dcf7cc4c1113277a64070cf9d060f66b56ee8d40d","ffe0cbbfcc687506e0d02c89ac941cf211b6bc9df8e16f685d6598f22d9c9b9c","387cf62fe76d1ea1b60bed1b4db0989e39e00871d652d272f8872072252e9497","2814f527add5bb114c9c87583973fdd36c48aeab8907ab8df2358e3bee60a219","e55b09d6df497c353657df0da47952c25ed7810ed2a7ec9d0250c9745d0330d6","4286d942387f5667c85b29fb5c76fbc4c95aac780a0f60765ef27c935bf93739","3861323d1489096022d6e1507333b5b05d6a1f00c6388817e57daee0fbc2adee","88f72417ea4ca0c56ca7652f28142abb57a4418c9916ac9fcb4e2a7b39132db9","c94875d310eaf21810c25499bb1959750a9e7c20a7fe5d670b19448a2233feec","9be7c5b0f3f756f0a587dbdf74146fd20db5a176b8e688c0df78a249c900401a","a34b2ca9ef6bc58a9516984d4ecce198372db3895c46cd8abaaa22157a348819","379d571f20c057ffba0f644a406dcb80cffaeac958e42f4af1d5dad57beaa618","8a0db2b777c9e5b6a42e1ce8bac62738c03abf7d7bb2236ead0e5f654488cb72","3350fc3d142176cac92a2e01c4b5044447ec73f40ed0e58df93f2715e79012aa","e2bb86af897eba7e5485029bca04a8eb8de75cd9a53eac251f777117af123b80","705a85ef344432ca19097bd8822aa3a350b7f2d98768166f0f75a258998451b4","017d3639c2ec413080ffbf957439be6149cfdd627ca2124fa97e4957d709501a","e33e30fcd0417f0b079e49d3d0901d11b858ef5d95702185dc45e92d480bdfd6","f132cbca4ec79c6c81e801dfb623b4232a266afad588a02222b576fad0a5f9ad","5fc1deb1fa3e2d1f1e6c5dd4d92423cbbe03a3ec5940a5f843fc9af4f00d9653"],"paragraph_range_zero_based":[29112,29135],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p29112"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"cyclicShift-n4","paragraph_zero_based":29136},{"literal_text_all_w_t_and_m_t":"Cyclic shift configuration (see TS 38.214 [19], clause 6.2.1).","paragraph_zero_based":29137},{"literal_text_all_w_t_and_m_t":"cyclicShift-n8","paragraph_zero_based":29138},{"literal_text_all_w_t_and_m_t":"Cyclic shift configuration (see TS 38.214 [19], clause 6.2.1).","paragraph_zero_based":29139},{"literal_text_all_w_t_and_m_t":"enableStartRBHopping","paragraph_zero_based":29140},{"literal_text_all_w_t_and_m_t":"When this RRC parameter is configured, start RB location hopping is enabled for partial frequency sounding in different SRS frequency hopping periods for periodic/semi-persistent/aperiodic SRS as described in Clause 6.4.1.4 in TS 38.211.","paragraph_zero_based":29141},{"literal_text_all_w_t_and_m_t":"freqHopping","paragraph_zero_based":29142},{"literal_text_all_w_t_and_m_t":"Includes parameters capturing SRS frequency hopping (see TS 38.214 [19], clause 6.2.1). For CLI SRS-RSRP measurement, the network always configures this field such that b-hop > b-SRS.","paragraph_zero_based":29143},{"literal_text_all_w_t_and_m_t":"groupOrSequenceHopping","paragraph_zero_based":29144},{"literal_text_all_w_t_and_m_t":"Parameter(s) for configuring group or sequence hopping (see TS 38.211 [16], clause  6.4.1.4.2). For CLI SRS-RSRP measurement, the network always configures this parameter to 'neither'.","paragraph_zero_based":29145},{"literal_text_all_w_t_and_m_t":"nrofSRS-Ports","paragraph_zero_based":29146},{"literal_text_all_w_t_and_m_t":"Number of ports. For CLI SRS-RSRP measurement, the network always configures this parameter to 'port1'.","paragraph_zero_based":29147},{"literal_text_all_w_t_and_m_t":"periodicityAndOffset-p, periodicityAndOffset-p-Ext","paragraph_zero_based":29148},{"literal_text_all_w_t_and_m_t":"Periodicity and slot offset for this SRS resource. All values are in \"number of slots\". Value sl1 corresponds to a periodicity of 1 slot, value sl2 corresponds to a periodicity of 2 slots, and so on. For each periodicity the corresponding offset is given in number of slots. For periodicity sl1 the offset is 0 slots (see TS 38.214 [19], clause 6.2.1). For CLI SRS-RSRP measurement, sl1280 and sl2560 cannot be configured. For SRS-PosResource, values sl20480, sl40960 and sl81920 cannot be configured for SCS=15kHz, values sl40960 and sl81920 cannot be configured for SCS=30kHz, and value sl81920 cannot be configured for SCS=60kHz.","paragraph_zero_based":29149},{"literal_text_all_w_t_and_m_t":"When periodicityAndOffset-p-Ext is present, periodicityAndOffset-p shall be ignored by the UE.","paragraph_zero_based":29150},{"literal_text_all_w_t_and_m_t":"periodicityAndOffset-sp, periodicityAndOffset-sp-Ext","paragraph_zero_based":29151},{"literal_text_all_w_t_and_m_t":"Periodicity and slot offset for this SRS resource. All values are in \"number of slots\". Value sl1 corresponds to a periodicity of 1 slot, value sl2 corresponds to a periodicity of 2 slots, and so on. For each periodicity the corresponding offset is given in number of slots. For periodicity sl1 the offset is 0 slots (see TS 38.214 [19], clause 6.2.1). For SRS-PosResource, values sl20480, sl40960 and sl81920 cannot be configured for SCS=15kHz, values sl40960 and sl81920 cannot be configured for SCS=30kHz, and value sl81920 cannot be configured for SCS=60kHz.","paragraph_zero_based":29152},{"literal_text_all_w_t_and_m_t":"When periodicityAndOffset-sp-Ext is present, periodicityAndOffset-sp shall be ignored by the UE.","paragraph_zero_based":29153},{"literal_text_all_w_t_and_m_t":"ptrs-PortIndex","paragraph_zero_based":29154},{"literal_text_all_w_t_and_m_t":"The PTRS port index for this SRS resource for non-codebook based UL MIMO. This is only applicable when the corresponding PTRS-UplinkConfig is set to CP-OFDM. The ptrs-PortIndex configured here must be smaller than the maxNrofPorts configured in the PTRS-UplinkConfig (see TS 38.214 [19], clause 6.2.3.1). This parameter is not applicable to CLI SRS-RSRP measurement.","paragraph_zero_based":29155},{"literal_text_all_w_t_and_m_t":"resourceMapping","paragraph_zero_based":29156},{"literal_text_all_w_t_and_m_t":"OFDM symbol location of the SRS resource within a slot including nrofSymbols (number of OFDM symbols), startPosition (value 0 refers to the last symbol, value 1 refers to the second last symbol, and so on) and repetitionFactor (see TS 38.214 [19], clause 6.2.1 and TS 38.211 [16], clause 6.4.1.4). The configured SRS resource does not exceed the slot boundary. If resourceMapping-r16 is signalled, UE shall ignore the resourceMapping (without suffix). If resourceMapping-r17 is signalled, resourceMapping-r16 is not signalled and the UE shall ignore the resourceMapping (without suffix) and only the values of nrofSymbols which are integer multiples of the configured repetitionFactor can be configured. The network can only signal repetitionFactor-v1730 if resourceMapping-r17 is signalled. When repetitionFactor-v1730 is signalled, the UE shall ignore repetitionFactor-r17. For CLI SRS-RSRP measurement, the network always configures nrofSymbols and repetitionFactor to 'n1'.","paragraph_zero_based":29157},{"literal_text_all_w_t_and_m_t":"resourceType","paragraph_zero_based":29158},{"literal_text_all_w_t_and_m_t":"Periodicity and offset for semi-persistent and periodic SRS resource, or slot offset for aperiodic SRS resource for positioning (see TS 38.214 [19], clause 6.2.1). For CLI SRS-RSRP measurement, only 'periodic' is applicable for resourceType.","paragraph_zero_based":29159}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["b2df8bfd0b89bb67358564358389351e3db34cf28e838244607de1949fd0e2bb","a9dec1f37be1dc7e6859ef17f709471ae95ac5be97d8bf365c9632b0770a9d16","78c079d34db06780aea01597817f2c7d710f8bb45048d0f1805ed085d7ae498b","b5103d537bc3b9a5844919fad53500b3b59f0f05107ce1b76797b8f65ed3d506","75fa83f9d7824ec7cbdb0edfa60749c31ac1e039a564c5131bee281f28fce6fc","1e9503439c421901474edc4d2c3123f816af37220afedb4cf5b268707c196b93","134fdb4e0691fe6fe6a1d1d7b5b764166a4c5e4be23b5aa97959a00f9711928e","178aa20edc82a56208199c85e3425a46560ecc42f23c7309b77c03a61b1cbe5e","baf8bc41c169180e0f608a5bf3e27e6c2225463ed9c34ac0aecdb01c8aba5d42","654cb6d42d668b2e74e0bd6c8ef02594910442a40c4f9fb2cf9fd9ddc06d9e13","234e2823a27ea6e699a58085a4f69465309203a0e55ed57f26ffafc0d402b006","4fd38cb149c4373c1d8b247351afbeff7814f7ddbacec3bac03646b941a9cae5","b86e76eb7e48238bd1c7ce8c3dbaf1899bf6f13a48c20e0a66b720e7dd2f2467","234edb67f82dcf86bcca67f61fc22bffc28d79af153e60e94ee44279270bfd3e","41c78b7fa2ee336c9895d9aec56af8758fb3c3fb346e4f7047bbeb37c40cc9fc","3ada0cd00217d1883c1ad7ab16161500e4d26e5f08a829a2f6d1deefdd2c007a","fc5ba38dad7ae817f50cafd2873528d69b3e7749b8e347f5ae1faa8f921f67d6","3f3cc2799b68e3e67b3ec41b6d8786580b294ec04ddbb8d231a4538a6c1f28eb","256134449af5977a819c866872c9334fda051fa5ed3e07ed1a2e40dfd1599e34","6986ebf561e850db3aa211dc06511be427aa0b918d3833faea2600eca7845e0c","e97e4f18583f06cfe60f5ff37e864e78290a4f6d16a1aea4953fc742f67e7629","d68c1006f2618328a93952b9b3aa6690631a0827276dadbe1d4e7b624934bae2","ca1499e6887b8c9dfc3c6a9cd08fdc738068a3da3f899d9aa4a4ab5488be1e32","5bb2dc74c16e806c9411bdf9b747c9a5cee93132ce284bcccb7b286779b4f07a"],"paragraph_range_zero_based":[29136,29159],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p29136"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sequenceId","paragraph_zero_based":29160},{"literal_text_all_w_t_and_m_t":"Sequence ID used to initialize pseudo random group and sequence hopping (see TS 38.214 [19], clause 6.2.1).","paragraph_zero_based":29161},{"literal_text_all_w_t_and_m_t":"spatialRelationInfo","paragraph_zero_based":29162},{"literal_text_all_w_t_and_m_t":"Configuration of the spatial relation between a reference RS and the target SRS. Reference RS can be SSB/CSI-RS/SRS (see TS 38.214 [19], clause 6.2.1). This parameter is not applicable to CLI SRS-RSRP measurement. This field is not configured if unifiedTCI-StateType is configured for the serving cell.","paragraph_zero_based":29163},{"literal_text_all_w_t_and_m_t":"spatialRelationInfo-PDC","paragraph_zero_based":29164},{"literal_text_all_w_t_and_m_t":"Configuration of the spatial relation between a reference RS and the target SRS. Reference RS can be SSB/CSI-RS/SRS/DL-PRS-PDC (see TS 38.214 [19], clause 6.2.1). The field is present in case of resourceType=periodic and usagePDC-r17=true in the SRS-ResourceSet, otherwise the field is absent.","paragraph_zero_based":29165},{"literal_text_all_w_t_and_m_t":"spatialRelationInfoPos","paragraph_zero_based":29166},{"literal_text_all_w_t_and_m_t":"Configuration of the spatial relation between a reference RS and the target SRS. Reference RS can be SSB/CSI-RS/SRS/DL-PRS (see TS 38.214 [19], clause 6.2.1).","paragraph_zero_based":29167},{"literal_text_all_w_t_and_m_t":"If the IE srs-ResourceId-Ext is present, the IE srs-ResourceId in spatialRelationInfoPos represents the index from 0 to 63. Otherwise the IE srs-ResourceId in spatialRelationInfoPos represents the index from 0 to 31.","paragraph_zero_based":29168},{"literal_text_all_w_t_and_m_t":"srs-RequestDCI-0-2","paragraph_zero_based":29169},{"literal_text_all_w_t_and_m_t":"Indicate the number of bits for \"SRS request\"in DCI format 0_2. When the field is absent, then the value of 0 bit for \"SRS request\" in DCI format 0_2 is applied. If the parameter srs-RequestDCI-0-2 is configured to value 1, 1 bit is used to indicate one of the first two rows of Table 7.3.1.1.2-24 in TS 38.212 [17] for triggered aperiodic SRS resource set. If the value 2 is configured, 2 bits are used to indicate one of the rows of Table 7.3.1.1.2-24 in TS 38.212 [17]. When UE is configured with supplementaryUplink, an extra bit (the first bit of the SRS request field) is used for the non-SUL/SUL indication.","paragraph_zero_based":29170},{"literal_text_all_w_t_and_m_t":"srs-RequestDCI-1-2","paragraph_zero_based":29171},{"literal_text_all_w_t_and_m_t":"Indicate the number of bits for \"SRS request\" in DCI format 1_2. When the field is absent, then the value of 0 bit for \"SRS request\" in DCI format 1_2 is applied. When the UE is configured with supplementaryUplink, an extra bit (the first bit of the SRS request field) is used for the non-SUL/SUL indication (see TS 38.214 [19], clause 6.1.1.2).","paragraph_zero_based":29172},{"literal_text_all_w_t_and_m_t":"srs-ResourceSetToAddModListDCI-0-2","paragraph_zero_based":29173},{"literal_text_all_w_t_and_m_t":"List of SRS resource set to be added or modified for DCI format 0_2 (see TS 38.212 [17], clause 7.3.1).","paragraph_zero_based":29174},{"literal_text_all_w_t_and_m_t":"srs-ResourceSetToReleaseListDCI-0-2","paragraph_zero_based":29175},{"literal_text_all_w_t_and_m_t":"List of SRS resource set to be released for DCI format 0_2 (see TS 38.212 [17], clause 7.3.1).","paragraph_zero_based":29176},{"literal_text_all_w_t_and_m_t":"srs-TCI-State","paragraph_zero_based":29177},{"literal_text_all_w_t_and_m_t":"Configuration of either a UL TCI state or a joint TCI state for the SRS resource. In case of UL TCI-State, refers to the TCI state defined in ul-TCI-StateList in the BWP-UplinkDedicated where the SRS-Config is configured. In case of joint TCI state, refers to a TCI state defined in dl-OrJointTCI-StateList in pdsch-Config of the BWP-DownlinkDedicated and serving cell indicated by cellAndBWP. This field is absent when the SRS resource is in an SRS-ResourceSet configured with followUnifiedTCI-StateSRS-r17 or when the field unifiedTCI-StateType is not configured to the serving cell which the SRS resource is located in.","paragraph_zero_based":29178},{"literal_text_all_w_t_and_m_t":"startRBIndexAndFreqScalingFactor","paragraph_zero_based":29179},{"literal_text_all_w_t_and_m_t":"Configures the UE with the startRBIndex and freqScalingFactor for partial frequency sounding as described in Clause 6.4.1.4 in TS 38.211. The startRBIndexForFScaling2 gives the startRBIndex when freqScalingFactor is 2 and the startRBIndexForFScaling4 gives the startRBIndex when FreqScalingFactor is 4 ","paragraph_zero_based":29180},{"literal_text_all_w_t_and_m_t":"transmissionComb, transmissionComb-n8","paragraph_zero_based":29181},{"literal_text_all_w_t_and_m_t":"Comb value (2 or 4 or 8) and comb offset (0..combValue-1) (see TS 38.214 [19], clause 6.2.1).","paragraph_zero_based":29182},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29183}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["8817d3518c0af80058affd5dd5ad2ebf003d31a51a42936fad36c61ff0c68834","f14b2f775e993ec98f2902137ac1905984b01c0a4123b783ceb6d862b4dc4ede","1b852e61c2fff3f604652434a547eec0439fc9ebfa49f805ba8e8f9a4b69f7a9","246d0a23911a71bf7ec77acb7e2ac03ce78dc1cbf4cc1073e057bb8f3142c1b0","047ce890ceab70adb7f5880350828c17379d9ff53d69dc2ba9d302de358e7477","431cc68372b51fbc31243995881d25ae7042b740267268497e59bb56d3405bba","99db25ddc91f74742d7fe3c734905ae5f445afe642dcb8f7cc5f199160b4eade","c8380dff0900ff69a4b8f6ad0c8459f542e18eda11970a26e7e76cea68ef0f2b","57ef2dd0dc9d226f2482431ec1326f3e5718390e6bc877792fb5009ec8e16df1","dac39dfe93b35e3db7668c5e86e92d49535ea6da5f1e4473a6504f87a2799a17","1e5937798c22d0d585c3ed58bf475f1adddc9c337c126567fc222344059ecd7c","2b897f16525a05d9aef8804bf9d8abef2a7f3f6799173720ce2d14714a732c9a","24caf5a0a4a2e98ce6ebdc04e98f7df525ff68bd56f42dc45ff8fe9dbb7f9867","9d1a102b562e194b4091417dec28ea16a2256249bb641918ee98a7de9832a55a","5581f7c4d3dcebf07cee22187b06aa0d3c081c2b8f9b468d1726230e954b233a","bfefc2179eb41a4064aad96d9f3ea8c3e5320020963a85dffa73d4a66679a736","7e1d61994fcf872a50a486f4ef28eeea745c4f6fd91e4163266355a1c7091925","1249bd8e4e8aa6257a3c05addd1b280e8fc0c00888f616512e72e5787ce87e38","942e6cb134257e74468eb9575b8bbd0abacf0ff292b785c718414864b2fb693d","482f48578baef7c83ad5c7abbdc5d292e1b47e34567a0306dbc57b8d2121aa9e","0606098993c89c273932532cc5c2b2b085b916e7234a6c51ec905c480921b75b","c40674ca48f4c5c3a70dd3c31e16c7ebb0931306c101029a7540de3f27fb03da","a866b34bcc7b1fd9e96c9f187386c61119544673e667a1a3cbc02fdbce52f5c9","43725c3ad9d211a17e6a9a3719947e2837d34bf76a98a6600aa70999d54bd7fd"],"paragraph_range_zero_based":[29160,29183],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p29160"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SRS-ResourceSet, SRS-PosResourceSet field descriptions","paragraph_zero_based":29184},{"literal_text_all_w_t_and_m_t":"alpha","paragraph_zero_based":29185},{"literal_text_all_w_t_and_m_t":"alpha value for SRS power control (see TS 38.213 [13], clause 7.3). When the field is absent the UE applies the value 1.","paragraph_zero_based":29186},{"literal_text_all_w_t_and_m_t":"aperiodicSRS-ResourceTriggerList","paragraph_zero_based":29187},{"literal_text_all_w_t_and_m_t":"An additional list of DCI \"code points\" upon which the UE shall transmit SRS according to this SRS resource set configuration (see TS 38.214 [19], clause 6). When the field is not included during a reconfiguration of SRS-ResourceSet of resourceType set to aperiodic, UE maintains this value based on the Need M; that is, this list is not considered as an extension of aperiodicSRS-ResourceTrigger for purpose of applying the general rule for extended list in clause 6.1.3.","paragraph_zero_based":29188},{"literal_text_all_w_t_and_m_t":"aperiodicSRS-ResourceTrigger","paragraph_zero_based":29189},{"literal_text_all_w_t_and_m_t":"The DCI \"code point\" upon which the UE shall transmit SRS according to this SRS resource set configuration (see TS 38.214 [19], clause 6).","paragraph_zero_based":29190},{"literal_text_all_w_t_and_m_t":"associatedCSI-RS","paragraph_zero_based":29191},{"literal_text_all_w_t_and_m_t":"ID of CSI-RS resource associated with this SRS resource set in non-codebook based operation (see TS 38.214 [19], clause 6.1.1.2).","paragraph_zero_based":29192},{"literal_text_all_w_t_and_m_t":"availableSlotOffset","paragraph_zero_based":29193},{"literal_text_all_w_t_and_m_t":"Indicates the number of available slots from slot n+k to the slot where the aperiodic SRS resource set is transmitted, where slot n is the slot with the triggering DCI, and k is the legacy triggering offset (slotOffset, not based on available slot) as described in clause 6.2.1 of TS 38.214 [19].","paragraph_zero_based":29194},{"literal_text_all_w_t_and_m_t":"csi-RS","paragraph_zero_based":29195},{"literal_text_all_w_t_and_m_t":"ID of CSI-RS resource associated with this SRS resource set (see TS 38.214 [19], clause 6.1.1.2).","paragraph_zero_based":29196},{"literal_text_all_w_t_and_m_t":"dl-PRS","paragraph_zero_based":29197},{"literal_text_all_w_t_and_m_t":"This field indicates a PRS configuration.","paragraph_zero_based":29198},{"literal_text_all_w_t_and_m_t":"followUnifiedTCI-StateSRS","paragraph_zero_based":29199},{"literal_text_all_w_t_and_m_t":"When set to enabled, for SRS resource Set, the UE applies the \"indicated\" UL only TCI or joint TCI as specified in TS 38.214 [19], clause 5.1.5. This parameter may be configured for aperiodic SRS for BM or SRS of any time-domain behavior for codebook, non-codebook, and antenna switching.","paragraph_zero_based":29200},{"literal_text_all_w_t_and_m_t":"p0","paragraph_zero_based":29201},{"literal_text_all_w_t_and_m_t":"P0 value for SRS power control. The value is in dBm. Only even values (step size 2) are allowed (see TS 38.213 [13], clause 7.3).","paragraph_zero_based":29202},{"literal_text_all_w_t_and_m_t":"pathlossReferenceRS","paragraph_zero_based":29203},{"literal_text_all_w_t_and_m_t":"A reference signal (e.g. a CSI-RS config or a SS block) to be used for SRS path loss estimation (see TS 38.213 [13], clause 7.3).","paragraph_zero_based":29204},{"literal_text_all_w_t_and_m_t":"pathlossReferenceRS-Pos","paragraph_zero_based":29205},{"literal_text_all_w_t_and_m_t":"A reference signal (e.g. a SS block or a DL-PRS config) to be used for SRS path loss estimation (see TS 38.213 [13], clause 7.3).","paragraph_zero_based":29206},{"literal_text_all_w_t_and_m_t":"pathlossReferenceRSList","paragraph_zero_based":29207}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["af7b1e9d947e074f43869df231f5d782bfd80f3d49a6dbe099d880516cb047cf","c377f68a628a83065d187390a893e5fdd9e4d5b41d3b533387d9eb65722a1961","39b8fd1dfcf6cec9c475cca4c340f739f7a40d73edf557f45ca7868d00945325","489619f913bf97ffb16c486d7605c3d354d9a44b55982c7bcd39bdb3c9388936","b77dd819df2dc98d6578d20945e160fbe825a25f7ffe6cad8c34ed30f8bc2234","0ee55b904fbd7971fe2106093d53f5e1af271022ebc46a2e3593fb046263f654","1b84b9a147185edf842a5f983f5bff70556f32e235d4b486ba4c1e6d2cf1fc92","841f1b39fc4591b16912c84a6d40a447f8b4b73695656378a828ef79f0f9bfc9","3953a6ef799345de007281b1d5a4752d8c383f7b37af96eae1d8f097bc8cb578","3522561a496064aef793d10822fdb15701f9a02fbd9fd29a6c7503e354129b3c","0fe0d0a2da3a311df1c3ad38d9b4382efbc3e8cce9f87c30ac2fabb362e19c48","1e828867be0ba4f0a537e4ca1a8b8e857646625f8b96a0a111125feadd0dee48","4bbeef89a23a91d875d2aa99c2239ac44ecc8ac992b730a04f347e294ba41455","e3286f58ccc4f2764898c2307a3d2d1f18216f48be75cc1a2cc5ff088699105b","2eb8ba15cbb6930d5406a08473066885e2ae7722dc6629ae97ffb1e047dae38f","cee415e387c505af591cf0de0846deb9360487b6f89083a25f1f74ff688d7e39","37a23cfe7f12868107b4d30535b6297e5efbf0b91a208305f1edbc83ee89892f","a7f2a2244b5945f8ce93efb90a161ac06f733330ab2a30952c33dd733c936ee5","237e84ffcd1bf47fcdc838b4ebbc8e9bf7d18558457b7819c9dc98347b83f6ff","3c334ecdecbbbc9aac396116213850daa1513c16ab55a1d8e88155a2983a92d4","313d042090eb3dfe9d9d726283c65d016fe71dcdb3f2643819f0099df1dc7e3e","db504cbc5804dba1fc64973e003e90ee1c53c23f5f0aa50107ad7dbeb2a0feb4","c623a597e88922caf7bc0f4bdbacfb008cf66d4453d9f424b8f28f9204739a1e","9213259c5283fb56eb238548b729a90e0f533a276ece9e9c251006406910ea4f"],"paragraph_range_zero_based":[29184,29207],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p29184"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Multiple candidate pathloss reference RS(s) for SRS power control, where one candidate RS can be mapped to SRS Resource Set via MAC CE (clause 6.1.3.27 in TS 38.321 [3]). The network can only configure this field if pathlossReferenceRS is not configured in the same SRS-ResourceSet.","paragraph_zero_based":29208},{"literal_text_all_w_t_and_m_t":"resourceType","paragraph_zero_based":29209},{"literal_text_all_w_t_and_m_t":"Time domain behavior of SRS resource configuration, see TS 38.214 [19], clause 6.2.1. The network configures SRS resources in the same resource set with the same time domain behavior on periodic, aperiodic and semi-persistent SRS. The aperiodic SRS is not applicable for the UE in RRC_INACTIVE.","paragraph_zero_based":29210},{"literal_text_all_w_t_and_m_t":"slotOffset","paragraph_zero_based":29211},{"literal_text_all_w_t_and_m_t":"An offset in number of slots between the triggering DCI and the actual transmission of this SRS-ResourceSet. If the field is absent the UE applies no offset (value 0).","paragraph_zero_based":29212},{"literal_text_all_w_t_and_m_t":"srs-PowerControlAdjustmentStates","paragraph_zero_based":29213},{"literal_text_all_w_t_and_m_t":"Indicates whether hsrs,c(i) = fc(i,1) or hsrs,c(i) = fc(i,2) (if twoPUSCH-PC-AdjustmentStates are configured) or separate close loop is configured for SRS. This parameter is applicable only for Uls on which UE also transmits PUSCH. If absent or release, the UE applies the value sameAs-Fci1 (see TS 38.213 [13], clause 7.3).","paragraph_zero_based":29214},{"literal_text_all_w_t_and_m_t":"srs-ResourceIdList, srs-PosResourceIdList","paragraph_zero_based":29215},{"literal_text_all_w_t_and_m_t":"The IDs of the SRS-Resources/SRS-PosResource used in this SRS-ResourceSet/SRS-PosResourceSet. If this SRS-ResourceSet is configured with usage set to codebook, the srs-ResourceIdList contains at most 2 entries. If this SRS-ResourceSet is configured with usage set to nonCodebook, the srs-ResourceIdList contains at most 4 entries.","paragraph_zero_based":29216},{"literal_text_all_w_t_and_m_t":"srs-ResourceSetId, srs-PosResourceSetId","paragraph_zero_based":29217},{"literal_text_all_w_t_and_m_t":"The ID of this resource set. It is unique in the context of the BWP in which the parent SRS-Config is defined.","paragraph_zero_based":29218},{"literal_text_all_w_t_and_m_t":"ssb-IndexServing","paragraph_zero_based":29219},{"literal_text_all_w_t_and_m_t":"Indicates SSB index belonging to a serving cell where the SRS is configured.","paragraph_zero_based":29220},{"literal_text_all_w_t_and_m_t":"ssb-Ncell","paragraph_zero_based":29221},{"literal_text_all_w_t_and_m_t":"This field indicates a SSB configuration from neighboring cell.","paragraph_zero_based":29222},{"literal_text_all_w_t_and_m_t":"usage","paragraph_zero_based":29223},{"literal_text_all_w_t_and_m_t":"Indicates if the SRS resource set is used for beam management, codebook based or non-codebook based transmission or antenna switching. See TS 38.214 [19], clause 6.2.1. Reconfiguration between codebook based and non-codebook based transmission is not supported.","paragraph_zero_based":29224},{"literal_text_all_w_t_and_m_t":"usagePDC","paragraph_zero_based":29225},{"literal_text_all_w_t_and_m_t":"If configured, it indicates that this SRS resource set is used for propagation delay compensation. The field can be present in only one SRS-ResourceSet.","paragraph_zero_based":29226},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29227},{"literal_text_all_w_t_and_m_t":"SRS-SpatialRelationInfoPos field descriptions","paragraph_zero_based":29228},{"literal_text_all_w_t_and_m_t":"csi-RS-IndexServing","paragraph_zero_based":29229},{"literal_text_all_w_t_and_m_t":"Indicates CSI-RS index belonging to a serving cell.","paragraph_zero_based":29230},{"literal_text_all_w_t_and_m_t":"dl-PRS","paragraph_zero_based":29231}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["3235f016447c9149ae8e963b8e8bbd9740d05f27029032fb0842d60deb7ec83f","1a3613cda678b079c0f2f020562cb9cd04622ef09641a475eb54112a87135090","851512f9acf435700095d2a0a64c41fb39f2a672da440bcd2253ded8f7beda91","7ca4d8080234f464f097522645fc3ea41bcbf492afb3bcb7e6c1cc5084decf99","57f68cf3a2f57869f428d9d9fa1b4225210b3bffe6a7090b8502c94c0c92a3e3","4ad3777bf20c3f0d79f03f6d09de468570e4537ea4b5bacfd4f47c437fc3c455","1975d9934f6d3f45b7989eca291f8165281decfb0d22f673d45b68efacf3f62a","b505c2fb29de4e87ee13144b9c6117e99d201073d336d3627a2da95894661a0e","84bbca44f07671e2ea33f99857453dbd46e653c3dac50f5db4d6cdec739b0b2c","1f1131f567e0d15a9de92fb83dd6f60766fb44926381a0db0f4ae60747346309","74e8d4ea988fc898570f3bc32ae129f0fa412f27697d654d175e6edd6511f44d","a6fd9e64874e6b9cf2ac65b57cb9f237a7cc88f64d4a8c5d789ef9bdc6269930","4dcac1ef596ec1dfd8c01482e33baa3afe6f45ad5aa924d765beae8c7876db98","e75ffdc39f9b21a14782fc015e7be9611f07b8003a58c9ac7f15275da2ebb66b","61ab7dbea7973603c7b4a9182534caf41ac9b01c6d0574c4b314e90b23d84dd1","d2f4ec0b19beeccb42492969f3296b349fdc4ae810be153b3f757176c44cae5a","392e5b1af8051edb5115a7bd3375ebb0104a93a619669a8a2567827aa4425384","4598f4c52190fbda16de6f7e91579e3ea2b32faa4707fffc608038dbf66ef31d","5ffadd9a10a0c66abc2643e0d814463a8c176155b28c1822ee024250cc5af5c2","83e4f656ad49aa03740b635ca8fe6c5050da3c119c2ec44ce73eaf7f931c60b8","da0e54daa685c354f7c63d00516346e2211c605b806f324baa6c1b5f7f102b27","02fc4849778fe98e3684bdc061d0cf322a1b388798a464a17794d18f85fff776","9cf549470bbf8b9359d9afb656d7ecf1dc53128444793a53c70f12cd9b4d14ca","1c10b25b060e4bcbf15deb4c7166e3d471daf12c77ae959b80660858dda77b71"],"paragraph_range_zero_based":[29208,29231],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p29208"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field indicates a PRS configuration.","paragraph_zero_based":29232},{"literal_text_all_w_t_and_m_t":"resourceSelection","paragraph_zero_based":29233},{"literal_text_all_w_t_and_m_t":"Indicates whether the configured SRS spatial relation resource is a SRS-Resource or SRS-PosResource.","paragraph_zero_based":29234},{"literal_text_all_w_t_and_m_t":"servingCellId","paragraph_zero_based":29235},{"literal_text_all_w_t_and_m_t":"The serving Cell ID of the source SSB, CSI-RS, or SRS for the spatial relation of the target SRS resource. If this field is absent the SSB, the CSI-RS, or the SRS is from the same serving cell where the SRS is configured.","paragraph_zero_based":29236},{"literal_text_all_w_t_and_m_t":"ssb-IndexServing","paragraph_zero_based":29237},{"literal_text_all_w_t_and_m_t":"Indicates SSB index belonging to a serving cell.","paragraph_zero_based":29238},{"literal_text_all_w_t_and_m_t":"ssb-Ncell","paragraph_zero_based":29239},{"literal_text_all_w_t_and_m_t":"This field indicates a SSB configuration from neighboring cell.","paragraph_zero_based":29240},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29241},{"literal_text_all_w_t_and_m_t":"SSB-InfoNCell field descriptions","paragraph_zero_based":29242},{"literal_text_all_w_t_and_m_t":"physicalCellId","paragraph_zero_based":29243},{"literal_text_all_w_t_and_m_t":"This field specifies the physical cell ID of the neighbour cell for which SSB configuration is provided.","paragraph_zero_based":29244},{"literal_text_all_w_t_and_m_t":"ssb-IndexNcell","paragraph_zero_based":29245},{"literal_text_all_w_t_and_m_t":"This field specifies the index of the SSB for a neighbour cell. See TS 38.213 [13]. If this field is absent, the UE determines the ssb-IndexNcell of the physicalCellId","paragraph_zero_based":29246},{"literal_text_all_w_t_and_m_t":"based on its SSB measurement from the cell.","paragraph_zero_based":29247},{"literal_text_all_w_t_and_m_t":"ssb-Configuration","paragraph_zero_based":29248},{"literal_text_all_w_t_and_m_t":"This field specifies the full configuration of the SSB. If this field is absent, the UE obtains the configuration for the SSB from nr-SSB-Config received as part of DL-PRS assistance data in LPP, see TS 37.355 [49], by looking up the corresponding SSB configuration using the field physicalCellId.","paragraph_zero_based":29249},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29250},{"literal_text_all_w_t_and_m_t":"DL-PRS-Info field descriptions","paragraph_zero_based":29251},{"literal_text_all_w_t_and_m_t":"dl-PRS-ID","paragraph_zero_based":29252},{"literal_text_all_w_t_and_m_t":"This field specifies the UE specific TRP ID (see TS 37.355 [49]) for which PRS configuration is provided. ","paragraph_zero_based":29253},{"literal_text_all_w_t_and_m_t":"dl-PRS-ResourceSetId","paragraph_zero_based":29254},{"literal_text_all_w_t_and_m_t":"This field specifies the PRS-ResourceSet ID of a PRS resourceSet.","paragraph_zero_based":29255}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["541b207814a3b908e08f363f780bb69e6887be859af4cafe023c28e7fc1e0cc2","9c52989517b6415f16baa11849d1023bf1932016594e9f18ddea91f68a0b1702","c5883f4568e5b98f8f945234ff477bdb66c5a78fca20e28caa90b5f476bc1812","5ab2cbbeb38b3311103d00126aaf113cea90f8cf85db3d3e7561bd54af4a3212","fd71fd32d95e0e15f242e4c62133a38e4423d53b1a385cd1f063b40d8d2e3f3e","546b64368d828b79d451c5123083cd7f312a333d351bc1a29ac8d37317e94bea","f57762596468ce736ef26060c7462bf3d6218a3c231edac519ae344f7f72a851","99becba1e3c775d89313b8ba5a5439dcd79992ffc030b01cd381201dad49c3a2","4dfbe7f102975558319cbab0c2f1148b1251a3b19bcc8153e5e97ffe230bf113","ae19062b51d1a1dd88ff45d53886a226b53f75691e39b250b5969cf3d5998afe","e618beeb8dfd68269d057e767d24cdd9a6c02a2de414a8abd9f13d03fa238ffc","aa3ad25206dddc971245fe75079a27139242f3ff671ab2712779179320e55351","cb0ffbd07eefb9bf3a6e738af10badcda952f96c742d5023264094421dc518b0","4ea58a9244b03a60c25ff5254d4417d31de3f74829b0da63a32aaea48cd605bb","ece0165b725040df462224e8d499be6ff6c71af0fee15a28977096c50cf84fad","e3f15d402e196a0e1a5eb0aa0b0d8155afa9ebf3678446892b5a62ac05213a98","aa1e9ee9794eaff0ea334d388a8fbf1ec3ea8080b2d6c1d70be8b95566a4f001","95cc0765e64ce585fd77b187ae04f12b9697b3db33ae6988d0fbdb2ab59b9a60","a8051b4aace1f51abb4764dfd542330c3ba8899d611ca947e7e0bba5a8e5fdf0","978aff1d2f38acc21ebd6d0ccc38b73215f513a37200cbbcb3d7a93e207f4daa","998e80ed9e160e0b6f80f715755dafb643345fe858b99c3a6b3be27c4d0b8fe5","b48ff0dce63fbfb8dbd56dd49273d19018322c417080ed0761d6077011ac2475","4be3a4f9f402b6bc72a39c04f112d601c4a1d13a7cd4b9b8756b63148e667c29","da323dbc52dd5fbb49849bbb6cbe38a87468d2fa71231850d592ef32a916ccd4"],"paragraph_range_zero_based":[29232,29255],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p29232"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"dl-PRS-ResourceId","paragraph_zero_based":29256},{"literal_text_all_w_t_and_m_t":"This field specifies the PRS-Resource ID of a PRS resource. If this field is absent, the UE determines the dl-PRS-ResourceID based on its PRS measurement from the TRP (see TS 37.355 [49]) and DL-PRS Resource Set.","paragraph_zero_based":29257},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29258},{"literal_text_all_w_t_and_m_t":"SSB-Configuration field descriptions","paragraph_zero_based":29259},{"literal_text_all_w_t_and_m_t":"halfFrameIndex","paragraph_zero_based":29260},{"literal_text_all_w_t_and_m_t":"Indicates whether SSB is in the first half or the second half of the frame. Value zero indicates the first half and value 1 indicates the second half.","paragraph_zero_based":29261},{"literal_text_all_w_t_and_m_t":"integerSubframeOffset","paragraph_zero_based":29262},{"literal_text_all_w_t_and_m_t":"Indicates the subframe boundary offset of the cell in which SSB is transmited.","paragraph_zero_based":29263},{"literal_text_all_w_t_and_m_t":"sfn0-Offset","paragraph_zero_based":29264},{"literal_text_all_w_t_and_m_t":"Indiactes the time offset of the SFN0 slot 0 for the cell with respect to SFN0 slot 0 of serving cell.","paragraph_zero_based":29265},{"literal_text_all_w_t_and_m_t":"sfn-Offset","paragraph_zero_based":29266},{"literal_text_all_w_t_and_m_t":"Specifies the SFN offset between the cell in which SSB is transmited and serving cell. The offset corresponds to the number of full radio frames counted from the beginning of a radio frame #0 of serving cell to the beginning of the closest subsequent radio frame #0 of the cell in which SSB is transmitted.","paragraph_zero_based":29267},{"literal_text_all_w_t_and_m_t":"sfn-SSB-Offset","paragraph_zero_based":29268},{"literal_text_all_w_t_and_m_t":"Indicates the SFN offset of the transmitted SSB relative to the start of the SSB period. Value 0 indicates that the SSB is transmitted in the first system frame, value 1 indicates that SSB is transmitted in the second system frame and so on. The network configures this field according to the field ssb-Periodicity such that the indicated system frame does not exceed the configured SSB periodicity.","paragraph_zero_based":29269},{"literal_text_all_w_t_and_m_t":"ssb-Freq","paragraph_zero_based":29270},{"literal_text_all_w_t_and_m_t":"Indicates the frequency of the SSB.","paragraph_zero_based":29271},{"literal_text_all_w_t_and_m_t":"ss-PBCH-BlockPower","paragraph_zero_based":29272},{"literal_text_all_w_t_and_m_t":"Average EPRE of the resources elements that carry secondary synchronization signals in dBm that the NW used for SSB transmission, see TS 38.213 [13], clause 7.","paragraph_zero_based":29273},{"literal_text_all_w_t_and_m_t":"ssb-Periodicity","paragraph_zero_based":29274},{"literal_text_all_w_t_and_m_t":"Indicates the periodicity of the SSB. If the field is absent, the UE applies the value ms5. (see TS 38.213 [13], clause 4.1)","paragraph_zero_based":29275},{"literal_text_all_w_t_and_m_t":"ssbSubcarrierSpacing","paragraph_zero_based":29276},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing of SSB.","paragraph_zero_based":29277},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":29278},{"literal_text_all_w_t_and_m_t":"FR1:    15 or 30 kHz","paragraph_zero_based":29279}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["f600553bad51d0c783b1d8d654926bfe65e880c1e6c34892a7018edab65125f5","09900c929b70029949a015e32a35d1743bcbaaa0e0a0df944b911b6317e11f45","e5ffde8f4b441876cb6d51b5af6c3a064160740992e22ef4a2d5261aba5f5afe","1179977a9a6fca2d3ebc8ef64860a3de9aacfd61bd7d9f6aa960ad9f13ba30a3","cfa7504e5ebdef63dc5cc8b1d17456c92f825b32652e4fa0f64887bae76739e7","444a0cf6d4628fbc37804d9a035c00fda9fe33169d57e9e0c99b56295368a6b6","9b3872c994826c24fd699a515c78ec30da60db35615e1c33562f64e931b99095","9d3a3ff1e1b564f5031efddf37c8950abaff500e53a4ffaf65217ead87e66ce2","5349ff25618bd534d1968b001a1371792a57929429c064d5f50e5daa0b34e96a","6d5c83907e5bf12fa8b1bc749bc7a896d60c0386ed2cff23e6b64b165f065697","bbe52c94079d65e314c4e6ac5ab7f42d76da6b30aee79764daadd3e89f5357cd","801e91ddf2aa1a537c105786a78f881a1dc2450208eb07739c480dc0bf3b2f7e","975aa6c54258c4567ba857c6dce97ccd34bd093c6302bb378438b53b574ac73e","f73ba71186fcd5451c7677f541122bb7913e8eef8235227e6bab78c65de1cfb9","2ed9d614e493a62056c9bb77cc7f60d713f13f0d997268ff11389d75fef58ddd","a4bd506443e7f1bb34151c290960ffc8e1e3b3a7caea37c7c00a588f6723d222","09761a53445a56ba11685071441839722020ca92b658b6a44af964d8f092a875","8896805866ff9d1ad63d74207c22c0eb7a1c7d892b72638ec080693d91393003","1bf5e17d568584869193991e269966e08b021a21f9cea8abef98749b599a5ecf","4ee7dc73b7b97594f258bf55c0aeda042b1312e47eac232806d8f473f45191fe","e5922317345ceb1b92c9fdc10f65191619e72525bca4b7e4fb2f114f197286b9","df49ed7f1b341564ac36866c9dea6dbb6acdd82f421998a3cfc4868b582fa50e","f6d09d2a30975bb0da0db9b24a8ab91a3ac3f495267d4de46b198efc2bff8c9e","e2b97a868b47db42efee43d20c057bada3e4c4835cf32433db4ce3979fbfefa6"],"paragraph_range_zero_based":[29256,29279],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p29256"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"FR2-1:  120 or 240 kHz","paragraph_zero_based":29280},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":29281},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29282},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":29283},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":29284},{"literal_text_all_w_t_and_m_t":"Setup","paragraph_zero_based":29285},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon configuration of SRS-ResourceSet or SRS-Resource and optionally present, Need M, otherwise.","paragraph_zero_based":29286},{"literal_text_all_w_t_and_m_t":"NonCodebook","paragraph_zero_based":29287},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need M, in case of non-codebook based transmission, otherwise the field is absent.","paragraph_zero_based":29288},{"literal_text_all_w_t_and_m_t":"Pathloss","paragraph_zero_based":29289},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the IE SSB-InfoNcell is included in pathlossReferenceRS-Pos; otherwise it is optionally present, Need R","paragraph_zero_based":29290},{"literal_text_all_w_t_and_m_t":"DLorJointTCI-SRS","paragraph_zero_based":29291},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if srs-DLorJointTCI-State is configured, otherwise it is absent Need R.","paragraph_zero_based":29292},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29293},{"literal_text_all_w_t_and_m_t":"–SRS-RSRP-Range","paragraph_zero_based":29294},{"literal_text_all_w_t_and_m_t":"The IE SRS-RSRP-Range specifies the value range used in SRS-RSRP measurements and thresholds. The integer value for SRS-RSRP measurements is according to Table 10.1.22.1.2-1 in TS 38.133 [14]. For thresholds, the actual value is (IE value –140) dBm, except for the IE value 98, in which case the actual value is infinity.","paragraph_zero_based":29295},{"literal_text_all_w_t_and_m_t":"SRS-RSRP-Range information element","paragraph_zero_based":29296},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29297},{"literal_text_all_w_t_and_m_t":"-- TAG-SRS-RSRP-RANGE-START","paragraph_zero_based":29298},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29299},{"literal_text_all_w_t_and_m_t":"SRS-RSRP-Range-r16 ::=                      INTEGER(0..98)","paragraph_zero_based":29300},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29301},{"literal_text_all_w_t_and_m_t":"-- TAG-SRS-RSRP-RANGE-STOP","paragraph_zero_based":29302},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29303}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["5c02499741ff581e7db46dacaddc0b32e86829aa02870770d3de37b21dc3fb82","9f8aa1f3df43c90f502fe563e2f0109d6cf700d2e3117cd6d30a29d7e31c8b22","8eaf74804b29ec13ff00c66b25e17e3ee4a08a6e7862cbc4efe6e0c9f10da2cb","83fe55821715aeb6dd6b5d44f86af33c65d48d8572aedff1b4a6e9741f7b143f","2eddc3812104ac9c844c533835ab8d034fc78bfaf7c0f233b4d3a29ab593c538","49e3025bea378648e09696a6554c2ccb15e9913fefb4c9459852836332cc48bc","fc35916f0e625a9309ffcf9efba4b18bb986b2bd60f5f2e6aed9ec97bca13761","1bfb1e146824ea133997077cfca23f2ecec50d8beb027e5fb6d33392ae060c02","c1dd32d92e9370f0814069e94b506b7f77d71bf6b6eadb6e4cae4946b2c78fd7","95608a9957f35881a0afbd864cd0fa90ffd4eeea70867d2bc8bd32016d7111ac","93b9eee5fb6fd3a2d30b38960f269b4f79cce822f32e1a103265466b72bf7bdc","04c1be399d98ba517e986f9157f5e1103140c6a488b396aacba6e8301b3fa101","a3a61431fa202