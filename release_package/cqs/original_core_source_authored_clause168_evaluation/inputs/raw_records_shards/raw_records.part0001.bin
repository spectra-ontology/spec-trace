{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36408},{"literal_text_all_w_t_and_m_t":"EUTRA-NS-PmaxList ::=               SEQUENCE (SIZE (1..maxEUTRA-NS-Pmax)) OF EUTRA-NS-PmaxValue","paragraph_zero_based":36409},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36410},{"literal_text_all_w_t_and_m_t":"EUTRA-NS-PmaxValue ::=              SEQUENCE {","paragraph_zero_based":36411},{"literal_text_all_w_t_and_m_t":"    additionalPmax                      INTEGER (-30..33)                       OPTIONAL,   -- Need R","paragraph_zero_based":36412},{"literal_text_all_w_t_and_m_t":"    additionalSpectrumEmission          INTEGER (1..288)                        OPTIONAL    -- Need R","paragraph_zero_based":36413},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":36414},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36415},{"literal_text_all_w_t_and_m_t":"-- TAG-EUTRA-NS-PMAXLIST-STOP","paragraph_zero_based":36416},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36417},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36418},{"literal_text_all_w_t_and_m_t":"–EUTRA-PhysCellId","paragraph_zero_based":36419},{"literal_text_all_w_t_and_m_t":"The IE EUTRA-PhysCellId is used to indicate the physical layer identity of the cell, as defined in TS 36.211 [31].","paragraph_zero_based":36420},{"literal_text_all_w_t_and_m_t":"EUTRA-PhysCellId information element","paragraph_zero_based":36421},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36422},{"literal_text_all_w_t_and_m_t":"-- TAG-EUTRA-PHYSCELLID-START","paragraph_zero_based":36423},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36424},{"literal_text_all_w_t_and_m_t":"EUTRA-PhysCellId ::=                        INTEGER (0..503)","paragraph_zero_based":36425},{"liter