{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32472},{"literal_text_all_w_t_and_m_t":"–FeatureSetDownlinkPerCC-Id","paragraph_zero_based":32473},{"literal_text_all_w_t_and_m_t":"The IE FeatureSetDownlinkPerCC-Id identifies a set of features applicable to one carrier of a feature set. The FeatureSetDownlinkPerCC-Id of a FeatureSetDownlinkPerCC is the index position of the FeatureSetDownlinkPerCC in the featureSetsDownlinkPerCC. The first element in the list is referred to by FeatureSetDownlinkPerCC-Id = 1, and so on.","paragraph_zero_based":32474},{"literal_text_all_w_t_and_m_t":"FeatureSetDownlinkPerCC-Id information element","paragraph_zero_based":32475},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32476},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETDOWNLINKPERCC-ID-START","paragraph_zero_based":32477},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32478},{"literal_text_all_w_t_and_m_t":"FeatureSetDownlinkPerCC-Id ::=      INTEGER (1..maxPerCC-FeatureSets)","paragraph_zero_based":32479},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32480},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETDOWNLINKPERCC-ID-STOP","paragraph_zero_based":32481},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32482},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32483},{"literal_text_all_w_t_and_m_t":"–FeatureSetEUTRA-DownlinkId","paragraph_zero_based":32484},{"literal_text_all_w_t_and_m_t":"The IE FeatureSetEUTRA-DownlinkId identifies a downlink feature set in E-UTRA list (see TS 36.331 [10]. The first element in that list is referred to by FeatureSetEUTRA-DownlinkId = 1. The FeatureSetEUTRA-DownlinkId=0 is used when the UE does not support a carrier in this band of a band combination.","paragraph_zero_based":32485},{"literal_text_all_w_t_and_m_t":"FeatureSetEUTRA-DownlinkId information element","paragraph_zero_based":32486},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32487},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETEUTRADOWNLINKID-START","paragraph_zero_based":32488},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32489},{"literal_text_all_w_t_and_m_t":"FeatureSetEUTRA-DownlinkId ::=      INTEGER (0..maxEUTRA-DL-FeatureSets)","paragraph_zero_based":32490},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32491},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETEUTRADOWNLINKID-STOP","paragraph_zero_based":32492},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32493},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32494},{"literal_text_all_w_t_and_m_t":"–FeatureSetEUTRA-UplinkId","paragraph_zero_based":32495}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["7f2223dbf1a43eb0c7f93dd24b8547bbef6e10d6d77ee0d644eb168389ddf767","fa0670d9010197e2e9161cf327906373732a62902f7aafcffbcfa0fd371450bd","ac6e9dadc4a2b159e1098a34893f9ec5a52e51a3ded47fb26befebcb68295996","1bf69d03e21899eaa0920fcff969a88c139f627f8fff6992a1e8040532407c61","567d4ccc4c302935f9aac251c2391874bed34778e972418dcd20fa02258dca1e","b1a5866c8828b25c372f8fa3af3b934554c818f12efb6af682f00ca24e418f06","3c9f48a51d8fef5e45103913d63b2d1e2ca24b0d838d4c9a8f4702c9005de6f8","23fa22b0fa91cf6ef503ab87e155ba666e6eaecf013ad90d23452a47748370a8","69a4adc2954a2fe9595a24308f77b8de2e22b991af64558b0fd4e9e9f63d513c","0e7a2b95c8f4177040efc7befc7653254b004d32bbe66dd1dacc4c7c1dfa81fd","7397fd0cc03924c0dfbcfc23d15704d39383d9632cedcacda5ac51c74adf7596","a6e90a984eb8b311a451a9d79cfebee522a008494d6ae0710969c6bb350b7543","b15bb5db28c7a3a69b24f557fe83e44c5b5e0e34b22361d41cc5dec4ba8bc993","88a784826c8e11ab9226eaa8525b8c928fe2f7d45da49ea6d1ceebc41a139e3a","169f4e4c07247a80e6f46ce059a8710f87161f1c04144378cb0f635f429f27a4","09e69b53ecf4ee5e47b9c446f2cd3cb5446af651e7c429fa07915b35d09677b9","7e7b8322145f4763ee9c8722c991c08ce6f9415eea9e3f2e63d2ffa15e6999bd","2a79750f4f5687d7de56e6dc404d0f5d2c9e58e4538efd4cecec3d2f170217dc","50385ac4a2bc676ad997481d10fee83765e3e233557d7449bf019946f222cb4c","8b7aa59974b2fe8a6cc73004374cf4eff44f0d276ac80c84d9a61a86739208d3","0fffe21d4cdd0a1b04a961460bd3426b6afb18f479bd98168316624c45b15326","731eaf08b751893fb12163ea12c81ee17fece7b35ad7d6df77c76d43a3363aed","3f33f8baed9fa3818bdc61df858f079b8031a7ab3e8e4f94a650a7df5099e955","02040aedc9d6aa99295492f3db31caf1af45a82670478934fcda6875c525ecc0"],"paragraph_range_zero_based":[32472,32495],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p32472"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE FeatureSetEUTRA-UplinkId identifies an uplink feature set in E-UTRA list (see TS 36.331 [10]. The first element in that list is referred to by FeatureSetEUTRA-UplinkId = 1. The FeatureSetEUTRA-UplinkId =0 is used when the UE does not support a carrier in this band of a band combination.","paragraph_zero_based":32496},{"literal_text_all_w_t_and_m_t":"FeatureSetEUTRA-UplinkId information element","paragraph_zero_based":32497},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32498},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETEUTRAUPLINKID-START","paragraph_zero_based":32499},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32500},{"literal_text_all_w_t_and_m_t":"FeatureSetEUTRA-UplinkId ::=                    INTEGER (0..maxEUTRA-UL-FeatureSets)","paragraph_zero_based":32501},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32502},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETEUTRAUPLINKID-STOP","paragraph_zero_based":32503},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32504},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32505},{"literal_text_all_w_t_and_m_t":"–FeatureSets","paragraph_zero_based":32506},{"literal_text_all_w_t_and_m_t":"The IE FeatureSets is used to provide pools of downlink and uplink features sets. A FeatureSetCombination refers to the IDs of the feature set(s) that the UE supports in that FeatureSetCombination. The BandCombination entries in the BandCombinationList then indicate the ID of the FeatureSetCombination that the UE supports for that band combination.","paragraph_zero_based":32507},{"literal_text_all_w_t_and_m_t":"The entries in the lists in this IE are identified by their index position. For example, the FeatureSetUplinkPerCC-Id = 4 identifies the 4th element in the featureSetsUplinkPerCC list.","paragraph_zero_based":32508},{"literal_text_all_w_t_and_m_t":"NOTE:When feature sets (per CC) IEs require extension in future versions of the specification, new versions of the FeatureSetDownlink, FeatureSetUplink, FeatureSets, FeatureSetDownlinkPerCC and/or FeatureSetUplinkPerCC will be created and instantiated in corresponding new lists in the FeatureSets IE. For example, if new capability bits are to be added to the FeatureSetDownlink, they will instead be defined in a new FeatureSetDownlink-rxy which will be instantiated in a new featureSetDownlinkList-rxy list. If a UE indicates in a FeatureSetCombination that it supports the FeatureSetDownlink with ID #5, it implies that it supports both the features in FeatureSetDownlink #5 and FeatureSetDownlink-rxy #5 (if present). The number of entries in the new list(s) shall be the same as in the original list(s).","paragraph_zero_based":32509},{"literal_text_all_w_t_and_m_t":"FeatureSets information element","paragraph_zero_based":32510},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32511},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETS-START","paragraph_zero_based":32512},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32513},{"literal_text_all_w_t_and_m_t":"FeatureSets ::=    SEQUENCE {","paragraph_zero_based":32514},{"literal_text_all_w_t_and_m_t":"    featureSetsDownlink                 SEQUENCE (SIZE (1..maxDownlinkFeatureSets)) OF FeatureSetDownlink               OPTIONAL,","paragraph_zero_based":32515},{"literal_text_all_w_t_and_m_t":"    featureSetsDownlinkPerCC            SEQUENCE (SIZE (1..maxPerCC-FeatureSets)) OF FeatureSetDownlinkPerCC            OPTIONAL,","paragraph_zero_based":32516},{"literal_text_all_w_t_and_m_t":"    featureSetsUplink                   SEQUENCE (SIZE (1..maxUplinkFeatureSets)) OF FeatureSetUplink                   OPTIONAL,","paragraph_zero_based":32517},{"literal_text_all_w_t_and_m_t":"    featureSetsUplinkPerCC              SEQUENCE (SIZE (1..maxPerCC-FeatureSets)) OF FeatureSetUplinkPerCC              OPTIONAL,","paragraph_zero_based":32518},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":32519}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["e1c2af50a8258671f157f3265daa32c980de5e06d56276d51b3ba47a407af3e2","618da2e0c50ca3d7cadd4e9d0c39ab2a961caabb53126a6e533288e08008ddcd","a17c0edce538b62e09ff8ec10247801e8946b6b8b313551bb3d058d2cbae9909","dab83e034977bf9431de2631da67a4d0d2f91e176e6985e21c0be0f41f99a2e7","7f33648664cff1d3f0a5ae392e149b11a44b0e2348072c9a364a44b075042e35","ef86fdac97417b0b3bdec645cf73bd19629afd99502e47b8f22d5da5d785111a","571370a40180bfe35ebdbba4e8d12691f8656120f0c1f37d9f5cb295e4c32615","4130e8e6831d17c132bc4fb75914715ec4849b65083ade4bfd82759367739be1","d3d5c2e5dcc39db5d4c19f46f526591bb1d30d3d9fb8bdb01ee25e6a239cfbe3","ff96b8b785ad8ff4df52b8ab1ba8951fbc447b35972a2bbf08aed3809b235174","64aca3f672aeb8c45536ba743b6b31dff9af21a1b12b04b084818354f641524f","e03afbcbe23d0d4c0a20f9681bb5fff4728af2a0f7da1cdc7af759725e0f9d97","8ad05dac6ce5b3c4a4b7ce480134962fcf33d54e0fcf77bf3f394ab6faa96fc1","646da5c73706a987d624efab73857fb08b6696834bce1f8b3526ce547f4ef906","70687906ed6eded1edfe7da5586de4130f489eecdcbf5e3db4785d1710874973","c0d27422a2d90224d4a1877dc659876d5dd2625830c9e274ce3182cd1428cec0","5e4237b95cb6e243d64ef11980d346de4f0427739597404734de8d12f5d1384d","f783a3c4e86bbcce8fe5eb92fb74f24f99c5bf6a3ade1dc453759abba43befc3","fc4d24ed2dc5c30274aba6b25604684e9cdb7d94c7e9a4e25c9bc516d3ca72a5","c9682a37e95e8ef20395b2409f47532f85e0cf7609c47087f05e12a100595ed6","14f68a5690c96126c3cd8d1d31e58adcb481bb86620b089f3ea03cc494602652","70c2d24d3e7964a987c8ceaf55f