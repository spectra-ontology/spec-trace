{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":4440},{"literal_text_all_w_t_and_m_t":"1>for each reportConfigId included in the received reportConfigToRemoveList that is part of the current UE configuration in VarMeasConfig:","paragraph_zero_based":4441},{"literal_text_all_w_t_and_m_t":"2>remove the entry with the matching reportConfigId from the reportConfigList within the VarMeasConfig;","paragraph_zero_based":4442},{"literal_text_all_w_t_and_m_t":"2>remove all measId associated with the reportConfigId from the measIdList within the VarMeasConfig, if any;","paragraph_zero_based":4443},{"literal_text_all_w_t_and_m_t":"2>if a measId is removed from the measIdList:","paragraph_zero_based":4444},{"literal_text_all_w_t_and_m_t":"3>remove the measurement reporting entry for this measId from the VarMeasReportList, if included;","paragraph_zero_based":4445},{"literal_text_all_w_t_and_m_t":"3>stop the periodical reporting timer or timer T321 or timer T322, whichever one is running, and reset the associated information (e.g. timeToTrigger) for this measId.","paragraph_zero_based":4446},{"literal_text_all_w_t_and_m_t":"NOTE:The UE does not consider the message as erroneous if the reportConfigToRemoveList includes any reportConfigId value that is not part of the current UE configuration.","paragraph_zero_based":4447},{"literal_text_all_w_t_and_m_t":"5.5.2.7Reporting configuration addition/modification","paragraph_zero_based":4448},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":4449},{"literal_text_all_w_t_and_m_t":"1>for each reportConfigId included in the received reportConfigToAddModList:","paragraph_zero_based":4450},{"literal_text_all_w_t_and_m_t":"2>if an entry with the matching reportConfigId exists in the reportConfigList within the VarMeasConfig, for this entry:","paragraph_zero_based":4451},{"literal_text_all_w_t_and_m_t":"3>reconfigure the entry with the value received for this reportConfig;","paragraph_zero_based":4452},{"literal_text_all_w_t_and_m_t":"3>for each measId associated with this reportConfigId included in the measIdList within the VarMeasConfig, if any:","paragraph_zero_based":4453},{"literal_text_all_w_t_and_m_t":"4>remove the measurement reporting entry for this measId from the VarMeasReportList, if included;","paragraph_zero_based":4454},{"literal_text_all_w_t_and_m_t":"4>stop the periodical reporting timer or timer T321 or timer T322, whichever one is running, and reset the associated information (e.g. timeToTrigger) for this measId;","paragraph_zero_based":4455},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":4456},{"literal_text_all_w_t_and_m_t":"3>add a new entry for the received reportConfig to the reportConfigList within the VarMeasConfig.","paragraph_zero_based":4457},{"literal_text_all_w_t_and_m_t":"5.5.2.8Quantity configuration","paragraph_zero_based":4458},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":4459},{"literal_text_all_w_t_and_m_t":"1>for each RAT for which the received quantityConfig includes parameter(s):","paragraph_zero_based":4460},{"literal_text_all_w_t_and_m_t":"2>set the corresponding parameter(s) in quantityConfig within VarMeasConfig to the value of the received quantityConfig parameter(s);","paragraph_zero_based":4461},{"literal_text_all_w_t_and_m_t":"1>for each measId included in the measIdList within VarMeasConfig:","paragraph_zero_based":4462},{"literal_text_all_w_t_and_m_t":"2>remove the measurement reporting entry for this measId from the VarMeasReportList, if included;","paragraph_zero_based":4463}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_