{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":10728},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10729},{"literal_text_all_w_t_and_m_t":"-- TAG-RRCRESUME-STOP","paragraph_zero_based":10730},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":10731},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10732},{"literal_text_all_w_t_and_m_t":"RRCResume-IEs field descriptions","paragraph_zero_based":10733},{"literal_text_all_w_t_and_m_t":"appLayerMeasConfig","paragraph_zero_based":10734},{"literal_text_all_w_t_and_m_t":"This field is used to configure application layer measurements. This field is absent when the UE is configured to operate with shared spectrum channel access.","paragraph_zero_based":10735},{"literal_text_all_w_t_and_m_t":"idleModeMeasurementReq","paragraph_zero_based":10736},{"literal_text_all_w_t_and_m_t":"This field indicates that the UE shall report the idle/inactive measurements, if available, to the network in the RRCResumeComplete message","paragraph_zero_based":10737},{"literal_text_all_w_t_and_m_t":"masterCellGroup","paragraph_zero_based":10738},{"literal_text_all_w_t_and_m_t":"Configuration of the master cell group.","paragraph_zero_based":10739},{"literal_text_all_w_t_and_m_t":"mrdc-SecondaryCellGroup","paragraph_zero_based":10740},{"literal_text_all_w_t_and_m_t":"Includes an RRC message for SCG configuration in NR-DC or NE-DC.","paragraph_zero_based":10741},{"literal_text_all_w_t_and_m_t":"For NR-DC (nr-SCG), mrdc-SecondaryCellGroup contains the RRCReconfiguration message as generated (entirely) by SN gNB. In this version of the specification, the RRC message can only include fields secondaryCellGroup (with at least reconfigurationWithSync), otherConfig and measConfig.","paragraph_zero_based":10742},{"literal_text_all_w_t_and_m_t":"For NE-DC (eutra-SCG), mrdc-SecondaryCellGroup includes the E-UTRA RRCConnectionReconfiguration message as specified in TS 36.331 [10]. In this version of the specification, the E-UTRA RRC message only include the field scg-Configuration with at least mobilityControlInfoSCG.","paragraph_zero_based":10743},{"literal_text_all_w_t_and_m_t":"needForGapsConfigNR","paragraph_zero_based":10744},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurement gap requirement information of NR target bands in the RRCReconfigurationComplete and RRCResumeComplete message.","paragraph_zero_based":10745},{"literal_text_all_w_t_and_m_t":"needForGapNCSG-ConfigEUTRA","paragraph_zero_based":10746},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurement gap and NCSG requirement information of EUTRA target bands in the RRCReconfigurationComplete and RRCResumeComplete message.","paragraph_zero_based":10747},{"literal_text_all_w_t_and_m_t":"needForGapNCSG-ConfigNR","paragraph_zero_based":10748},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurement gap and NCSG requirement information of NR target bands in the RRCReconfigurationComplete and RRCResumeComplete message.","paragraph_zero_based":10749},{"literal_text_all_w_t_and_m_t":"radioBearerConfig","paragraph_zero_based":10750},{"literal_text_all_w_t_and_m_t":"Configuration of Radio Bearers (DRBs, SRBs, multicast MRBs) including SDAP/PDCP.","paragraph_zero_based":10751}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["13efa0177a82ebc90ec8e41d747c324c6657d95873e78cd551b4a2c1acd4283b","e6081f96c8bae2b423830abbd11315ac4dd1da320fca24f5e8f9be4ea7479e98","c1984689d25cb03f7d4eae52664dd9385a423a5b35ef6310db5ffcb33ccd0344","5d5952e470d907b7d64a99a16ad2e0b7abef5fb394b049c6aa97b7845c51fd25","edf6b6f87e40a7d20a6a73131d32df664aa7249cef9096bfe10bc3c04c6334d3","9a2e50c7d5ce1a3caffd8a1506b69c5b1d7b0150714217effc4d51e524ed6d2f","ccdd5e750be63307354ded96f9e4634259da42cd55003a062d091605a6fe48d0","9a48f094f651d14bcaf2307415159e8bf9fcefe3b74bca5bce3ecebbf927e0cc","27b68f9fed4c4c63be23db8c9b2b776ec0a7590d03f93d44a3d0bd9b7744753e","abee6a1fac3ef57ae375d66c30d05c78e1546b694a3464b2cd419334b6b66d19","88eab00ee249766b2c9672e026e83077bc1671ac5e5eb2a652c5923f9e85b7c9","ccba4a77bb006f9900595500746736dfe9ff960bc6a74165040924de6e12fb58","0f955f502c61e75a8c101844bd4e1b657e98b8bb39c218ad2caa0b72f07ba2fa","3060e001f2bbb8f30bd3ea24c123f0d1534a910658c7cfcfc0b808a30de32f2d","61c3a131d7588100cf27ea58de18ceceaddb2bddbeb685430bece9158b2c9cef","9f262a543ab95cbeac14c0a7889f7e8b228a56e30949ae06e431d925d8bd0961","0ba3e4aa7e0f1d6f3c5cb0debf9a2d318677d27df924a358ef27c4487e2dffa1","a5ddee58b7ed44f0b7b6281adcba0c3a8994b06945d27d44cd128dcbb928900c","a6c792c4665f3e730798a16d4d7d7eb04853358eee85032c2137780ab880db5d","e179d3d93ce4ac756c362c35aefd4266afb219272153ab8a6ba2a978ed2d93b0","2fb1536be18f2b12a152decfb72e3047882ee9fe457d735d5ff076aba7b1afa6","9609efd6f0665dcad14fe7ffec2ce4fd400bb468e0d422a3e7b3361e8528c451","2661c934a460771244c322d91e96bc443d8d24ed5d793044655ac4f20463ee45","fd9844e8666c1c458d2a329667e775cc6908e09ea08d8f178b3d6e674ab0a97c"],"paragraph_range_zero_based":[10728,10751],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p10728"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"radioBearerConfig2","paragraph_zero_based":10752},{"literal_text_all_w_t_and_m_t":"Configuration of Radio Bearers (DRBs, SRBs) including SDAP/PDCP. This field can only be used if the UE supports NR-DC or NE-DC.","paragraph_zero_based":10753},{"literal_text_all_w_t_and_m_t":"restoreMCG-SCells","paragraph_zero_based":10754},{"literal_text_all_w_t_and_m_t":"Indicates that the UE shall restore the MCG SCells from the UE Inactive AS Context, if stored.","paragraph_zero_based":10755},{"literal_text_all_w_t_and_m_t":"restoreSCG","paragraph_zero_based":10756},{"literal_text_all_w_t_and_m_t":"Indicates that the UE shall restore the SCG configurations from the UE Inactive AS Context, if stored.","paragraph_zero_based":10757},{"literal_text_all_w_t_and_m_t":"scg-State","paragraph_zero_based":10758},{"literal_text_all_w_t_and_m_t":"Indicates that the SCG is in deactivated state.","paragraph_zero_based":10759},{"literal_text_all_w_t_and_m_t":"sk-Counter","paragraph_zero_based":10760},{"literal_text_all_w_t_and_m_t":"A counter used to derive S-KgNB or S-KeNB based on the newly derived KgNB during RRC Resume. The field is only included when there is one or more RB with keyToUse set to secondary or mrdc-SecondaryCellGroup is included.","paragraph_zero_based":10761},{"literal_text_all_w_t_and_m_t":"sl-ConfigDedicatedNR","paragraph_zero_based":10762},{"literal_text_all_w_t_and_m_t":"This field is used to provide the dedicated configurations for NR sidelink communication/discovery used by L2 U2N Remote UE.","paragraph_zero_based":10763},{"literal_text_all_w_t_and_m_t":"sl-L2RemoteUE-Config","paragraph_zero_based":10764},{"literal_text_all_w_t_and_m_t":"Contains L2 U2N relay operation related configurations used by L2 U2N Remote UE. The field is absent if appLayerMeasConfig or SRB4 is configured/not released.","paragraph_zero_based":10765},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10766},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":10767},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":10768},{"literal_text_all_w_t_and_m_t":"L2RemoteUE","paragraph_zero_based":10769},{"literal_text_all_w_t_and_m_t":"The field is mandatory present for L2 U2N Remote UE; otherwise it is absent.","paragraph_zero_based":10770},{"literal_text_all_w_t_and_m_t":"RestoreSCG","paragraph_zero_based":10771},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if restoreSCG is included. It is optionally present, Need M, otherwise.","paragraph_zero_based":10772},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10773},{"literal_text_all_w_t_and_m_t":"–RRCResumeComplete","paragraph_zero_based":10774},{"literal_text_all_w_t_and_m_t":"The RRCResumeComplete message is used to confirm the successful completion of an RRC connection resumption.","paragraph_zero_based":10775}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["e964e987bc056f862d4696cc05f16a1b779c589da006c57071b701a8478f07d1","0e22bd3c69f8c4c5a72a59854d2ef9dc8386e0cd5ffb77ba63326483c158be2e","67bf2c29f3064ee764ecb471a3e6688a401ea427615e29b85b0b272e47518ccb","085b5c65b272a99f8769b7d46a91002edf4cb94106dfc085f06ebb5621b32042","ec59804801f973f440e5358efcb6f24cda129f570b9fd78e59d61037ba77dbd0","671d3ae06a139972a95d3bd4569ac06e39952b3e4d6d0e62c80f175db9778d9e","4788efbac42fe5c507fb4c9dc44392b2fb3867c36607f1ef90660730dab405fb","f4629baec87dd5e5acc3f11f2d8beebdc17a3dabe9d4e5214563b8294764281a","d8a0a581b3301e0c02c62e8ae7580f30e32f976215c885e69d8463e8e763