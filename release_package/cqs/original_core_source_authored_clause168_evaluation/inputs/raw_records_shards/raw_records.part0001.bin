{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29808},{"literal_text_all_w_t_and_m_t":"TDD-UL-DL-SlotIndex ::=             INTEGER (0..maxNrofSlots-1)","paragraph_zero_based":29809},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29810},{"literal_text_all_w_t_and_m_t":"-- TAG-TDD-UL-DL-CONFIGDEDICATED-STOP","paragraph_zero_based":29811},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29812},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29813},{"literal_text_all_w_t_and_m_t":"TDD-UL-DL-ConfigDedicated field descriptions","paragraph_zero_based":29814},{"literal_text_all_w_t_and_m_t":"slotSpecificConfigurationsToAddModList","paragraph_zero_based":29815},{"literal_text_all_w_t_and_m_t":"The slotSpecificConfigurationToAddModList allows overriding UL/DL allocations provided in tdd-UL-DL-configurationCommon, see TS 38.213 [13], clause 11.1. ","paragraph_zero_based":29816},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29817},{"literal_text_all_w_t_and_m_t":"TDD-UL-DL-ConfigDedicated-IAB-MT field descriptions","paragraph_zero_based":29818},{"literal_text_all_w_t_and_m_t":"slotSpecificConfigurationsToAddModList-IAB-MT","paragraph_zero_based":29819},{"literal_text_all_w_t_and_m_t":"The slotSpecificConfigurationToAddModList-IAB-MT allows overriding UL/DL allocations provided in tdd-UL-DL-configurationCommon with a limitation that effectively only flexible symbols can be overwritten in Rel-16.","paragraph_zero_based":29820},{"literal_text_all_w_t_and_m_t":"slotSpecificConfigurationsToReleaseList-IAB-MT","paragraph_zero_based":29821},{"literal_text_all_w_t_and_m_t":"The slotSpecificConfigurationsToReleaseList-IAB-MT allows release of a set of slot configuration previously add with slotSpecificConfigurationToAddModList-IAB-MT.","paragraph_zero_based":29822},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29823},{"literal_text_all_w_t_and_m_t":"TDD-UL-DL-SlotConfig field descriptions","paragraph_zero_based":29824},{"literal_text_all_w_t_and_m_t":"nrofDownlinkSymbols","paragraph_zero_based":29825},{"literal_text_all_w_t_and_m_t":"Number of consecutive DL symbols in the beginning of the slot identified by slotIndex. If the field is absent the UE assumes that there are no leading DL symbols. (see TS 38.213 [13], clause 11.1).","paragraph_zero_based":29826},{"literal_text_all_w_t_and_m_t":"nrofUplinkSymbols","paragraph_zero_based":29827},{"literal_text_all_w_t_and_m_t":"Number of consecutive UL symbols in the end of the slot identified by slotIndex. If the field is absent the UE assumes that there are no trailing UL symbols. (see TS 38.213 [13], clause 11.1).","paragraph_zero_based":29828},{"literal_text_all_w_t_and_m_t":"slotIndex","paragraph_zero_based":29829},{"literal_text_all_w_t_and_m_t":"Identifies a slot within a slot configuration period given in tdd-UL-DL-configurationCommon, see TS 38.213 [13], clause 11.1.","paragraph_zero_based":29830},{"literal_text_all_w_t_and_m_t":"symbols","paragraph_zero_based":29831}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["1939bf5de62d1075fa2fb64e734bdd7e460a6510fbf46fdf73554282bd29cb4c","b649e28c094996d019df6fef0d4241d4310b875a1e1eab6d796989f860d70b0d","b7a28a22a085a7250b2b8e79985f1ec4e1361d9c47f2066147e5f52ebf036488","23dc6d640d7a2eca6548fdb85c3b9ab5cb32ce4b0a71114c8a55344675c82fb4","728c7ecc323dadb71d719a86a3abd9cebb99fbe3a092b7afd478bb24c302f1a6","6bcf07e55e1e8a4d8fec493b84e71926640c30349037411598b827bc0079483f","9949bb25425669320b2b35da3eec460fdbd826a0703dc0f8ba9e2db543aa82e2","0d9c4548fa7f2994f92e549146950eadcd05d846f7e32e3784ce73e7a710c5a6","cc4f3e97098f653e9852bb8fe3ecab520b36a2704361b9eb325c33719efe151f","98b1fa3ee89830852b76b71de2cc05a68b11d84247ba5d996c0146a2b8c7670e","a11bd338104f6e2fa26744acfc24926ccda4368f7c030208dfadd65abb60c8aa","7b744a7a44533fc5b953d126bee14c6a13d672dac1af9350d7bd142209716eca","2baa00bc2b9c94a36f18154dbbd58fa7ee9bdbe5d3a070faf85bb40e686f9e25","1fc23c952308c35ffe7642e951bb313230522684d7448b1e138161f995d2f172","b44597e2ee37c19ad95912792395fc5f88e0ff417e9449b7c1b71d0a800c4859","542b6d905c815ea8c7ed70e8dedb9c9761827bf453143bd8a604f607a9738fa5","0e04a1eefcdef2fd7b90b9dab483a22d84cd41e02ae0fc3db4549c1b1e048af9","5bad4c46f751eddc2a996c885e8dc97b0e4c78778212296245f5070fac75bf47","8c2442d9dcb44e26ff17ae4dccb21e452a5c1cd67700e3e3efe6c987a628cc61","6c7f18eaee0b6532731b1b83ffed4f4454cad23717a0b433120ee7f08473807b","629009da4ee34e2ae4ee2133d6d1f745cff136a02dabf7db639a7dc0cbc75e79","44a49620a47b63d7e52b474d3422746009884d3043dde27fe6663b41a834673d","7399e3ce19a713f0dbddf7fa05b9db3dc4f8c38b7ee1519655b1885d8f2d782f","e261d393c120529e5aafa7978901ef7bfa9b7d13d1d71d1e5d8dd7830db61f93"],"paragraph_range_zero_based":[29808,29831],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p29808"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The direction (downlink or uplink) for the symbols in this slot. Value allDownlink indicates that all symbols in this slot are used for downlink; value allUplink indicates that all symbols in this slot are used for uplink; value explicit indicates explicitly how many symbols in the beginning and end of this slot are allocated to downlink and uplink, respectively.","paragraph_zero_based":29832},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29833},{"literal_text_all_w_t_and_m_t":"TDD-UL-DL-SlotConfig-IAB-MT field descriptions","paragraph_zero_based":29834},{"literal_text_all_w_t_and_m_t":"symbols-IAB-MT","paragraph_zero_based":29835},{"literal_text_all_w_t_and_m_t":"The symbols-IAB-MT is used to configure an IAB-MT with the SlotConfig applicable for one serving cell. Value allDownlink indicates that all symbols in this slot are used for downlink; value allUplink indicates that all symbols in this slot are used for uplink; value explicit indicates explicitly how many symbols in the beginning and end of this slot are allocated to downlink and uplink, respectively; value explicit-IAB-MT indicates explicitly how many symbols in the beginning and end of this slot are allocated to uplink and downlink, respectively.","paragraph_zero_based":29836},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29837},{"literal_text_all_w_t_and_m_t":"–TrackingAreaCode","paragraph_zero_based":29838},{"literal_text_all_w_t_and_m_t":"The IE TrackingAreaCode is used to identify a tracking area within the scope of a PLMN/SNPN, see TS 24.501 [23].","paragraph_zero_based":29839},{"literal_text_all_w_t_and_m_t":"TrackingAreaCode information element","paragraph_zero_based":29840},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29841},{"literal_text_all_w_t_and_m_t":"-- TAG-TRACKINGAREACODE-START","paragraph_zero_based":29842},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29843},{"literal_text_all_w_t_and_m_t":"TrackingAreaCode ::= BIT STRING (SIZE (24))","paragraph_zero_based":29844},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29845},{"literal_text_all_w_t_and_m_t":"-- TAG-TRACKINGAREACODE-STOP","paragraph_zero_based":29846},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29847},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29848},{"literal_text_all_w_t_and_m_t":"–T-Reselection","paragraph_zero_based":29849},{"literal_text_all_w_t_and_m_t":"The IE T-Reselection concerns the cell reselection timer TreselectionRAT for NR and E-UTRA. Value in seconds. For value 0, behaviour as specified in 7.1.2 applies.","paragraph_zero_based":29850},{"literal_text_all_w_t_and_m_t":"T-Reselection information element","paragraph_zero_based":29851},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29852},{"literal_text_all_w_t_and_m_t":"-- TAG-TRESELECTION-START","paragraph_zero_based":29853},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29854},{"literal_text_all_w_t_and_m_t":"T-Reselection ::=                   INTEGER (0..7)","paragraph_zero_based":29855}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["ba6a9c4e36358f2056fee13d7dbb246a20874b5ad1576254c76ddfa6bab171ae","8ec672b83c05f0d2a0bb4a310d428feb42d9bdd7daa7565589d45bdaced212ce","5118fa6c92235c1bc7a8952da28169cee146e21c9b267184540237fcd4c5d374","82720e99284edc454349234f01f16070354f50f9b6e59f3ab70af07b2c8a7e4c","cfb5c343ffe2db047cdf62caa77e846e390787385ae898421386623c37c4be36","70297f9a37e863ae31ab332601d