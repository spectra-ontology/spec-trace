{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–PCI-RangeIndex","paragraph_zero_based":21768},{"literal_text_all_w_t_and_m_t":"The IE PCI-RangeIndex identifies a physical cell id range, which may be used for different purposes.","paragraph_zero_based":21769},{"literal_text_all_w_t_and_m_t":"PCI-RangeIndex information element","paragraph_zero_based":21770},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21771},{"literal_text_all_w_t_and_m_t":"-- TAG-PCI-RANGEINDEX-START","paragraph_zero_based":21772},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21773},{"literal_text_all_w_t_and_m_t":"PCI-RangeIndex ::=                  INTEGER (1..maxNrofPCI-Ranges)","paragraph_zero_based":21774},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21775},{"literal_text_all_w_t_and_m_t":"-- TAG-PCI-RANGEINDEX-STOP","paragraph_zero_based":21776},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21777},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21778},{"literal_text_all_w_t_and_m_t":"–PCI-RangeIndexList","paragraph_zero_based":21779},{"literal_text_all_w_t_and_m_t":"The IE PCI-RangeIndexList concerns a list of indexes of physical cell id ranges, which may be used for different purposes.","paragraph_zero_based":21780},{"literal_text_all_w_t_and_m_t":"PCI-RangeIndexList information element","paragraph_zero_based":21781},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21782},{"literal_text_all_w_t_and_m_t":"-- TAG-PCI-RANGEINDEXLIST-START","paragraph_zero_based":21783},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21784},{"literal_text_all_w_t_and_m_t":"PCI-RangeIndexList ::=              SEQUENCE (SIZE (1..maxNrofPCI-Ranges)) OF PCI-RangeIndex","paragraph_zero_based":21785},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21786},{"literal_text_all_w_t_and_m_t":"-- TAG-PCI-RANGEINDEXLIST-STOP","paragraph_zero_based":21787},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21788},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21789},{"literal_text_all_w_t_and_m_t":"–PDCCH-Config","paragraph_zero_based":21790},{"literal_text_all_w_t_and_m_t":"The IE PDCCH-Config is used to configure UE specific PDCCH parameters or MBS multicast PDCCH parameters such as control resource sets (CORESET), search spaces and additional parameters for acquiring the PDCCH. If this IE is used for the scheduled SCell in case of cross carrier scheduling, the fields other than searchSpacesToAddModList and searchSpacesToReleaseList are absent. If the IE is used for a dormant BWP, the fields other than controlResourceSetToAddModList and controlResourceSetToReleaseList are absent. If this IE is used for MBS CFR, the field downlinkPreemptiom,tpc-PUSCH, tpc-SRS, uplinkCancellation, monitoringCapabilityConfig, and searchSpaceSwitchConfig are absent.","paragraph_zero_based":21791}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["3eee2bd33eeb63fdd06cc06a194fdd90dea053627faaa50b015afa09aeac2fa4","341437063d0b340b55645a5ba0933018695c3836ca780cd56f7f90368010e0ef","dcfe6dbe4600b8ca85d5d1f47aed74648f7de7404f4626ed7ae51e01b762f86e","8ad4f42f6cb961be8392582c676e00e0f093e6c621587bcf0f10eea5ef1d14da","58993d23181f304f6f8a72646be4d1ada6ddfc7850dc4fdccfde982325d4b1f3","a4954775e5f44c0edc86b886bf7d7fb47526c52ffc5411fa7a0ef09bf675ea1b","acef97eeef309d2811e72eb998cf98e85fd19f49ed6274a3929aff7a73b6e02d","8ed3c0307852a68f928615bf248786717721a273de8b28f0ea2af6ceb6b36546","f92eb02a83e11533e03cf7f7667bb2f7584dba81fabc4259bb9f1099443f504f","654ad875a783dc41c7904fe09b02732da30994c2d866d17bc9dcd100557fdc83","5d50ead669718c4fe7172a72d91f90fd5fc02210a692b95d82a7999b04459c94","6bebf0d4ea87b5ed13306b2966604143db646b88b4e0597c6327355a408b55a1","6f4c958b35ca132f2485ab9a71e0c9e24cc1a4d12a0560796cb9245a9b793944","79d7f746f1e02f95a555923d73e2abe3a9ef8ca7c3bdd1b70255a569e6dbeb64","4c38c275c71a801059c43dbe33265482acf6a9a7b658425ee4bc65c6c8ccc420","241db7b36de6fdb764f6c57ed0145a4e28367d8330101698d5cf2baf6120b352","31616a2ba3f64f6ad04114dcd21ea5a2ac18fd3fb58cf9d9a7500ee5ff08ff28","af3d5c354640a4234e9979072bae908c89cb63044a5c8832cf591636e584da7b","7bf9a795a5ff39f73772c13088d43b4cce90ebb80ed09782b4026db110565654","23cab45b3780d6208767a97cd8de28c5668e516608a9afb29de90cda106adac6","0c1a59834039ecdee175819c74c7f67b99b55e92ae6b50658dc20643975494dc","daaf9d0bb875f76359113a2afd107a9191d879ea0084d9df742926dc09deb3dc","9a77e10cfcf935b006f408d89a04c32d6cc195094b3766298cdacf43ce872b21","0ba7c286bed9919091ef7dd0dd25f29d16b5806354688625091dcc170b67188c"],"paragraph_range_zero_based":[21768,21791],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p21768"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"PDCCH-Config information element","paragraph_zero_based":21792},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21793},{"literal_text_all_w_t_and_m_t":"-- TAG-PDCCH-CONFIG-START","paragraph_zero_based":21794},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21795},{"literal_text_all_w_t_and_m_t":"PDCCH-Config ::=                    SEQUENCE {","paragraph_zero_based":21796},{"literal_text_all_w_t_and_m_t":"    controlResourceSetToAddModList      SEQUENCE(SIZE (1..3)) OF ControlResourceSet                      OPTIONAL,   -- Need N","paragraph_zero_based":21797},{"literal_text_all_w_t_and_m_t":"    controlResourceSetToReleaseList     SEQUENCE(SIZE (1..3)) OF ControlResourceSetId                    OPTIONAL,   -- Need N","paragraph_zero_based":21798},{"literal_text_all_w_t_and_m_t":"    searchSpacesToAddModList            SEQUENCE(SIZE (1..10)) OF SearchSpace                            OPTIONAL,   -- Need N","paragraph_zero_based":21799},{"literal_text_all_w_t_and_m_t":"    searchSpacesToReleaseList           SEQUENCE(SIZE (1..10)) OF SearchSpaceId                          OPTIONAL,   -- Need N","paragraph_zero_based":21800},{"literal_text_all_w_t_and_m_t":"    downlinkPreemption                  SetupRelease { DownlinkPreemption }                              OPTIONAL,   -- Need M","paragraph_zero_based":21801},{"literal_text_all_w_t_and_m_t":"    tpc-PUSCH                           SetupRelease { PUSCH-TPC-CommandConfig }                         OPTIONAL,   -- Need M","paragraph_zero_based":21802},{"literal_text_all_w_t_and_m_t":"    tpc-PUCCH                           SetupRelease { PUCCH-TPC-CommandConfig }                         OPTIONAL,   -- Need M","paragraph_zero_based":21803},{"literal_text_all_w_t_and_m_t":"    tpc-SRS                             SetupRelease { SRS-TPC-CommandConfig}                            OPTIONAL,   -- Need M","paragraph_zero_based":21804},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":21805},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":21806},{"literal_text_all_w_t_and_m_t":"    controlResourceSetToAddModListSizeExt-v1610 SEQUENCE (SIZE (1..2)) OF ControlResourceSet             OPTIONAL,   -- Need N","paragraph_zero_based":21807},{"literal_text_all_w_t_and_m_t":"    controlResourceSetToReleaseListSizeExt-r16 SEQUENCE (SIZE (1..5)) OF ControlResourceSetId-r16        OPTIONAL,   -- Need N","paragraph_zero_based":21808},{"literal_text_all_w_t_and_m_t":"    searchSpacesToAddModListExt-r16     SEQUENCE(SIZE (1..10)) OF SearchSpaceExt-r16                     OPTIONAL,   -- Need N","paragraph_zero_based":21809},{"literal_text_all_w_t_and_m_t":"    uplinkCancellation-r16              SetupRelease { UplinkCancellation-r16 }                          OPTIONAL,   -- Need M","paragraph_zero_based":21810},{"literal_text_all_w_t_and_m_t":"    monitoringCapabilityConfig-r16      ENUMERATED { r15monitoringcapability,r16monitoringcapability }   OPTIONAL,   -- Need M","paragraph_zero_based":21811},{"literal_text_all_w_t_and_m_t":"    searchSpaceSwitchConfig-r16         SearchSpaceSwitchConfig-r16                                      OPTIONAL    -- Need R","paragraph_zero_based":21812},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":21813},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":21814},{"literal_text_all_w_t_and_m_t":"    searchSpacesToAddModListExt-v1700   SEQUENCE(SIZE (1..10)) OF SearchSpaceExt-v1700                   OPTIONAL,   -- Need N","paragraph_zero_based":21815}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_