{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SL-CG-MaxTransNumList-r16 ::=     SEQUENCE (SIZE (1..8)) OF SL-CG-MaxTransNum-r16","paragraph_zero_based":37872},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37873},{"literal_text_all_w_t_and_m_t":"SL-CG-MaxTransNum-r16 ::=                  SEQUENCE {","paragraph_zero_based":37874},{"literal_text_all_w_t_and_m_t":"    sl-Priority-r16                            INTEGER (1..8),","paragraph_zero_based":37875},{"literal_text_all_w_t_and_m_t":"    sl-MaxTransNum-r16                         INTEGER (1..32)","paragraph_zero_based":37876},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37877},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37878},{"literal_text_all_w_t_and_m_t":"SL-PeriodCG-r16 ::=            CHOICE{","paragraph_zero_based":37879},{"literal_text_all_w_t_and_m_t":"    sl-PeriodCG1-r16               ENUMERATED {ms100, ms200, ms300, ms400, ms500, ms600, ms700, ms800, ms900, ms1000, spare6,","paragraph_zero_based":37880},{"literal_text_all_w_t_and_m_t":"                                               spare5, spare4, spare3, spare2, spare1},","paragraph_zero_based":37881},{"literal_text_all_w_t_and_m_t":"    sl-PeriodCG2-r16               INTEGER (1..99)","paragraph_zero_based":37882},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37883},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37884},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-CONFIGUREDGRANTCONFIG-STOP","paragraph_zero_based":37885},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":37886},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37887},{"literal_text_all_w_t_and_m_t":"SL-ConfiguredGrantConfig field descriptions","paragraph_zero_based":37888},{"literal_text_all_w_t_and_m_t":"sl-ConfigIndexCG","paragraph_zero_based":37889},{"literal_text_all_w_t_and_m_t":"This field indicates the ID to identify sidelink configured grant.","paragraph_zero_based":37890},{"literal_text_all_w_t_and_m_t":"sl-CG-MaxTransNumList","paragraph_zero_based":37891},{"literal_text_all_w_t_and_m_t":"This field indicates the maximum number of times that a TB can be transmitted using the resources provided by the sidelink configured grant. sl-Priority corresponds to the logical channel priority.","paragraph_zero_based":37892},{"literal_text_all_w_t_and_m_t":"sl-FreqResourceCG-Type1","paragraph_zero_based":37893},{"literal_text_all_w_t_and_m_t":"Indicates the frequency resource location of sidelink configured grant type 1. An index giving valid combinations of one or two starting sub-channel and length (jointly encoded) as resource indicator value (RIV), as defined in TS 38.214 [19].","paragraph_zero_based":37894},{"literal_text_all_w_t_and_m_t":"sl-HARQ-ProcID-Offset","paragraph_zero_based":37895}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["d44ee0ef20aeb6f58658683b64837e2e18650eb4435019df628123110cdab71d","fab6f79d4cc04a04875fbdb3bc8afb6602ecb85e73fc366443319b6d2e3c2766","5dc6e080e07a48ead4241184ba7abd926ba247c25c2fbcd1440e3562a06691a1","fcff2e7b8830446a55d72d4ce460df01b904042462bf2e53ba5d100def4d4373","8a35c25ea14d98018a4d04ee43b0f8436a57a0270cb121c6c22b36f4ee7ec884","490e00975e0a8c10293996c0639829c91a707b6c2d20dc95d0c8f04da7dbdded","d6f393b4ff815ab07c5f7755bc44ed9cf8610c5b8181880e23f99de5d25dcea3","c635c4f6fbdd457384aaf71810dd0880299d9f0a3d0e5036cc1b6149d935f272","c01476d6dbd41217f4ae1fe333d8965ffbede0a615b74191f17b7f0d6c3b7ee3","582d831ee3fbb459825828d96b3f3feedac9dccd25d6802ecde7079b16025431","29f878e5d88ffbb5b34