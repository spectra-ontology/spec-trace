{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–AppLayerMeasConfig","paragraph_zero_based":36600},{"literal_text_all_w_t_and_m_t":"The IE AppLayerMeasConfig indicates configuration of application layer measurements.","paragraph_zero_based":36601},{"literal_text_all_w_t_and_m_t":"AppLayerMeasConfig information element","paragraph_zero_based":36602},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36603},{"literal_text_all_w_t_and_m_t":"-- TAG-APPLAYERMEASCONFIG-START","paragraph_zero_based":36604},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36605},{"literal_text_all_w_t_and_m_t":"AppLayerMeasConfig-r17 ::=           SEQUENCE {","paragraph_zero_based":36606},{"literal_text_all_w_t_and_m_t":"    measConfigAppLayerToAddModList-r17   SEQUENCE (SIZE (1..maxNrofAppLayerMeas-r17)) OF MeasConfigAppLayer-r17     OPTIONAL, -- Need N","paragraph_zero_based":36607},{"literal_text_all_w_t_and_m_t":"    measConfigAppLayerToReleaseList-r17  SEQUENCE (SIZE (1..maxNrofAppLayerMeas-r17)) OF MeasConfigAppLayerId-r17   OPTIONAL, -- Need N","paragraph_zero_based":36608},{"literal_text_all_w_t_and_m_t":"    rrc-SegAllowed-r17                   ENUMERATED {enabled}                                                       OPTIONAL, -- Need R","paragraph_zero_based":36609},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":36610},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":36611},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36612},{"literal_text_all_w_t_and_m_t":"MeasConfigAppLayer-r17 ::=           SEQUENCE {","paragraph_zero_based":36613},{"literal_text_all_w_t_and_m_t":"    measConfigAppLayerId-r17             MeasConfigAppLayerId-r17,","paragraph_zero_based":36614},{"literal_text_all_w_t_and_m_t":"    measConfigAppLayerContainer-r17      OCTET STRING (SIZE (1..8000))                                              OPTIONAL, -- Need N","paragraph_zero_based":36615},{"literal_text_all_w_t_and_m_t":"    serviceType-r17                      ENUMERATED {streaming, mtsi, vr, spare5, spare4, spare3, spare2, spare1}   OPTIONAL, -- Need M","paragraph_zero_based":36616},{"literal_text_all_w_t_and_m_t":"    pauseReporting-r17                   BOOLEAN                                                                    OPTIONAL, -- Need M","paragraph_zero_based":36617},{"literal_text_all_w_t_and_m_t":"    transmissionOfSessionStartStop-r17   BOOLEAN                                                                    OPTIONAL, -- Need M","paragraph_zero_based":36618},{"literal_text_all_w_t_and_m_t":"    ran-VisibleParameters-r17            SetupRelease {RAN-VisibleParameters-r17}                                   OPTIONAL, -- Cond ServiceType","paragraph_zero_based":36619},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":36620},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":36621},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36622},{"literal_text_all_w_t_and_m_t":"RAN-VisibleParameters-r17 ::=        SEQUENCE {","paragraph_zero_based":36623}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["a72805d8cdb4b66d2a9d4f4a17b9ee406c36ca4ab4bc9d6cd0919f60896505cb","c0e92e422d33131d17a70036e6e66bc2d96ea59be0a47f4bcf288e86740065c5","8cb59911dd3dc6becbd53f42033b5a0786d535bcfe6a43c6c4759a394c4e0b96","66ee4fe2e86ca22f2d2000b40b8729c5b5100f09e7a879ed5a7b93f07f089dd5","5c9c9d851ff0877c8ee2c9c863ea7e5d9a40ec94986f68ef6e2fc79d58d50cb9","6e7787b76e7f063f2fc933fa9571346ad5b8c1bfea17dea38acb4082ea002c4b","c9ffadf21e70604a5715705dc4