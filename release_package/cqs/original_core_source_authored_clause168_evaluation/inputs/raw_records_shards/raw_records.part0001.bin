{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"uplinkDirectCurrentBWP-SUL","paragraph_zero_based":29976},{"literal_text_all_w_t_and_m_t":"The Tx Direct Current locations for all the supplementary uplink BWPs configured at the corresponding serving cell.","paragraph_zero_based":29977},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29978},{"literal_text_all_w_t_and_m_t":"–UplinkTxDirectCurrentMoreCarrierList","paragraph_zero_based":29979},{"literal_text_all_w_t_and_m_t":"The IE UplinkTxDirectCurrentMoreCarrierList indicates the Tx Direct Current locations for intra-band CA including one, two or more uplink carriers. The UE does not report the uplink Direct Current location information for SUL carrier(s).","paragraph_zero_based":29980},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentMoreCarrierList information element","paragraph_zero_based":29981},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29982},{"literal_text_all_w_t_and_m_t":"-- TAG-UPLINKTXDIRECTCURRENTMORECARRIERLIST-START","paragraph_zero_based":29983},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29984},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentMoreCarrierList-r17 ::=   SEQUENCE (SIZE (1..maxNrofCC-Group-r17)) OF CC-Group-r17","paragraph_zero_based":29985},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29986},{"literal_text_all_w_t_and_m_t":"CC-Group-r17 ::=           SEQUENCE {","paragraph_zero_based":29987},{"literal_text_all_w_t_and_m_t":"    servCellIndexLower-r17     ServCellIndex,","paragraph_zero_based":29988},{"literal_text_all_w_t_and_m_t":"    servCellIndexHigher-r17    ServCellIndex              OPTIONAL,","paragraph_zero_based":29989},{"literal_text_all_w_t_and_m_t":"    defaultDC-Location-r17     DefaultDC-Location-r17,","paragraph_zero_based":29990},{"literal_text_a