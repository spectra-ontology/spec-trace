7635},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":27636},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":27637},{"literal_text_all_w_t_and_m_t":"    highSpeedConfig-v1700               HighSpeedConfig-v1700                                               OPTIONAL, -- Need R","paragraph_zero_based":27638},{"literal_text_all_w_t_and_m_t":"    channelAccessMode2-r17              ENUMERATED {enabled}                                                OPTIONAL, -- Cond SharedSpectrum2","paragraph_zero_based":27639},{"literal_text_all_w_t_and_m_t":"    discoveryBurstWindowLength-r17      ENUMERATED {ms0dot125, ms0dot25, ms0dot5, ms0dot75, ms1, ms1dot25}  OPTIONAL, -- Need R","paragraph_zero_based":27640},{"literal_text_all_w_t_and_m_t":"    ssb-PositionQCL-r17                 SSB-PositionQCL-Relation-r17                                        OPTIONAL, -- Cond SharedSpectrum2","paragraph_zero_based":27641},{"literal_text_all_w_t_and_m_t":"    highSpeedConfigFR2-r17              HighSpeedConfigFR2-r17                                              OPTIONAL, -- Need R","paragraph_zero_based":27642},{"literal_text_all_w_t_and_m_t":"    uplinkConfigCommon-v1700            UplinkConfigCommon-v1700                                            OPTIONAL, -- Need R","paragraph_zero_based":27643},{"literal_text_all_w_t_and_m_t":"    ntn-Config-r17                      NTN-Config-r17                                                      OPTIONAL  -- Need R","paragraph_zero_based":27644},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":27645},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":27646},{"literal_text_all_w_t_and_m_t":"    featurePriorities-r17               SEQUENCE {","paragraph_zero_based":27647}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","