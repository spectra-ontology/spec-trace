{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates supported SRS resources for SRS carrier switching to the band associated with this FeatureSetDownlink. The UE is only allowed to set this field for a band with associated FeatureSetUplinkId set to 0.","paragraph_zero_based":31992},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31993},{"literal_text_all_w_t_and_m_t":"–FeatureSetDownlinkId","paragraph_zero_based":31994},{"literal_text_all_w_t_and_m_t":"The IE FeatureSetDownlinkId identifies a downlink feature set. The FeatureSetDownlinkId of a FeatureSetDownlink is the index position of the FeatureSetDownlink in the featureSetsDownlink list in the FeatureSets IE. The first element in that list is referred to by FeatureSetDownlinkId = 1. The FeatureSetDownlinkId=0 is not used by an actual FeatureSetDownlink but means that the UE does not support a carrier in this band of a band combination.","paragraph_zero_based":31995},{"literal_text_all_w_t_and_m_t":"FeatureSetDownlinkId information element","paragraph_zero_based":31996},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":31997},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETDOWNLINKID-START","paragraph_zero_based":31998},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31999},{"literal_text_all_w_t_and_m_t":"FeatureSetDownlinkId ::=            INTEGER (0..maxDownlinkFeatureSets)","paragraph_zero_based":32000},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32001},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETDOWNLINKID-STOP","paragraph_zero_based":32002},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32003},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32004},{"literal_text_all_w_t_and_m_t":"–FeatureSetDownlinkPerCC","paragraph_zero_based":32005},{"literal_text_all_w_t_and_m_t":"The IE FeatureSetDownlinkPerCC indicates a set of features that the UE supports on the corresponding carrier of one band entry of a band combination.","paragraph_zero_based":32006},{"literal_text_all_w_t_and_m_t":"FeatureSetDownlinkPerCC information element","paragraph_zero_based":32007},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32008},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETDOWNLINKPERCC-START","paragraph_zero_based":32009},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32010},{"literal_text_all_w_t_and_m_t":"FeatureSetDownlinkPerCC ::=         SEQUENCE {","paragraph_zero_based":32011},{"literal_text_all_w_t_and_m_t":"    supportedSubcarrierSpacingDL        SubcarrierSpacing,","paragraph_zero_based":32012},{"literal_text_all_w_t_and_m_t":"    supportedBandwidthDL                SupportedBandwidth,","paragraph_zero_based":32013},{"literal_text_all_w_t_and_m_t":"    channelBW-90mhz                     ENUMERATED {supported}                                                  OPTIONAL,","paragraph_zero_based":32014},{"literal_text_all_w_t_and_m_t":"    maxNumberMIMO-LayersPDSCH           MIMO-LayersDL                                                           OPTIONAL,","paragraph_zero_based":32015}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["48c56fb93d94c4f0c2f0a69d832102cdfd55522debd569dcbc422f208de2bca0","d01d9cef6015f83d39daf02bb1a387bc4090ffa3023408c1fd6cc9fb83984124","399a4ac89c3203f4c3c98ff5cca281a56c863dc12c2e3c6905e27239d0ba5d3f","cf55ca7331e7c114e042ec4acaa09ea32329f1ff515f36d41df3c5162b0dca8f","c29c9a7d90c2b199f00b6ca433dff9f3351a2558167fd8fcfe8106d28e58558f","852c6a562a6e3ba95e622e68388c0eb82ef41