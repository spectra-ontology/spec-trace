{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Hysteresis when evaluating a SyncRef UE using absolute comparison.","paragraph_zero_based":39672},{"literal_text_all_w_t_and_m_t":"sl-SyncRefDiffHyst","paragraph_zero_based":39673},{"literal_text_all_w_t_and_m_t":"Hysteresis when evaluating a SyncRef UE using relative comparison.","paragraph_zero_based":39674},{"literal_text_all_w_t_and_m_t":"sl-NumSSB-WithinPeriod","paragraph_zero_based":39675},{"literal_text_all_w_t_and_m_t":"Indicates the number of sidelink SSB transmissions within one sidelink SSB period. The applicable values are related to the subcarrier spacing and frequency as follows:","paragraph_zero_based":39676},{"literal_text_all_w_t_and_m_t":"FR1, SCS = 15 kHz: 1","paragraph_zero_based":39677},{"literal_text_all_w_t_and_m_t":"FR1, SCS = 30 kHz: 1, 2","paragraph_zero_based":39678},{"literal_text_all_w_t_and_m_t":"FR1, SCS = 60 kHz: 1, 2, 4","paragraph_zero_based":39679},{"literal_text_all_w_t_and_m_t":"FR2, SCS = 60 kHz: 1, 2, 4, 8, 16, 32","paragraph_zero_based":39680},{"literal_text_all_w_t_and_m_t":"FR2, SCS = 120 kHz: 1, 2, 4, 8, 16, 32, 64","paragraph_zero_based":39681},{"literal_text_all_w_t_and_m_t":"sl-TimeOffsetSSB","paragraph_zero_based":39682},{"literal_text_all_w_t_and_m_t":"Indicates the slot offset from the start of sidelink SSB period to the first sidelink SSB.","paragraph_zero_based":39683},{"literal_text_all_w_t_and_m_t":"sl-TimeInterval","paragraph_zero_based":39684},{"literal_text_all_w_t_and_m_t":"Indicates the slot interval between neighboring sidelink SSBs. This value is applicable when there are more than one sidelink SSBs within one sidelink SSB period.","paragraph_zero_based":39685},{"literal_text_all_w_t_and_m_t":"sl-SSID","paragraph_zero_based":39686},{"literal_text_all_w_t_and_m_t":"Indicates the ID of sidelink synchronization signal associated with different synchronization priorities.","paragraph_zero_based":39687},{"literal_text_all_w_t_and_m_t":"syncInfoReserved","paragraph_zero_based":39688},{"literal_text_all_w_t_and_m_t":"Reserved for future use.","paragraph_zero_based":39689},{"literal_text_all_w_t_and_m_t":"syncTxThreshIC, syncTxThreshOoC","paragraph_zero_based":39690},{"literal_text_all_w_t_and_m_t":"Indicates the thresholds used while in coverage and out of coverage, respectively. Value 0 corresponds to -infinity, value 1 to -115 dBm, value 2 to -110 dBm, and so on (i.e. in steps of 5 dBm) until value 12, which corresponds to -60 dBm, while value 13 corresponds to +infinity.","paragraph_zero_based":39691},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39692},{"literal_text_all_w_t_and_m_t":"–SL-Thres-RSRP-List","paragraph_zero_based":39693},{"literal_text_all_w_t_and_m_t":"IE SL-Thres-RSRP-List indicates a threshold used for sensing based UE autonomous resource selection (see TS 38.215 [9]). A resource is excluded if it is indicated or reserved by a decoded SCI and PSSCH/PSCCH RSRP in the associated data resource is above the threshold defined by IE SL-Thres-RSRP-List. Value 0 corresponds to minus infinity dBm, value 1 corresponds to -128dBm, value 2 corresponds to -126dBm, value n corresponds to (-128 + (n-1)*2) dBm and so on, value 66 corresponds to infinity dBm.","paragraph_zero_based":39694},{"literal_text_all_w_t_and_m_t":"SL-Thres-RSRP-List information element","paragraph_zero_based":39695}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["1b00b1d4d4919299fb9a3c130dae67a745d26433612ceef1707e282f6bb6cd60","6378051ac394c21ba0c9b15afbab6c55e983cf632465713ccad7357050c2cd43","99aac196f70b84259cebd11c5e8afd43701ef105e1dfafe10df03e59c5efdc07","1ecc06e6a5864452d365978f772535c8d90be15f760041a2a41d1f314e77cd75","a6a0e6af4aac2bb4aa54dc8ab40838dd7b98d46ef3c33a3d6f6fd53b18047769","2fda953a391dd7c240669d9b02f77135123829571686f3fe987f34aef01c0eb0","8ca581ad1c1e447a15e15953e4f55b08616599a93270f8080a9ff76502373353","6d605249ca39234021cca68f79cd71ad272d66831ad652be93bec332fcf9084f","b018c3755a76bbc5059a9e0cb27375a3781b5fc6566393f1e3e4be8192bb2b25","437f9e5d757097e73cb7c84c8ff5751cac87d274489bbe7ceac086f61aef7187","cdf75a40c0edaa7a5e4db19cbd783d70f553c4b77f23e68bf75cc76daecc4160","b8cb098e06171ab72eb68364dd92d98bb7859e81c2c9f95f22f5eba29a7250a4","2df59e3314fc4d7241c2f2a4b1a8a24bf8dffe8d6646e1ef98cd914742c4de03","fe001332e76bdd0e8b0746a7001fe3422820d4c804d434eca03dec386e856ab0","4f358fabc65df75fdbf0bda4c03677d7bb28997f7b75fe6b4fb0c869644cf529","88317889b917a13c6e88268b81e4e2a30fd5d36fb0617e06214b2aa048da2cde","ce1c6231d67aa1f4ff2ec98d6977d67b8f261195dd66fae7cd720f5f8625f70d","074fa655256158b1cde0c2a59b8b9ce687240a2f6a1489a8c3f78e7d7941432a","5025ef53943119c19e8dc377331e3079d2497facd8d3cbfcff80236054729ed5","519ff1325569aae1e7fa71e34902dc53f23a2c6a4e37401d6bada8aa720ac66c","b73ed0a52612186c6666dfdb67dfd8e9e0d96969039f039daf6c8f9796d43813","fa9540bde7a133b9802842f3e659c1d628276ab0695856d11fd6b9524814619b","d96166e3c95683051f973fca4fddc2d954b53cff0ef33ab67d908111d7c7f14d","bec42c97dcb39fd4beaa3d2fd115a7f3a535ec89b9eab89b3967c33f86de1a07"],"paragraph_range_zero_based":[39672,39695],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p39672"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39696},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-THRES-RSRP-LIST-START","paragraph_zero_based":39697},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39698},{"literal_text_all_w_t_and_m_t":"SL-Thres-RSRP-List-r16 ::=    SEQUENCE (SIZE (64)) OF SL-Thres-RSRP-r16","paragraph_zero_based":39699},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39700},{"literal_text_all_w_t_and_m_t":"SL-Thres-RSRP-r16 ::=         INTEGER (0..66)","paragraph_zero_based":39701},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39702},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-THRES-RSRP-LIST-STOP","paragraph_zero_based":39703},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39704},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39705},{"literal_text_all_w_t_and_m_t":"–SL-TxPower","paragraph_zero_based":39706},{"literal_text_all_w_t_and_m_t":"The IE SL-TxPower is used to limit the UE's sidelink transmission power on a carrier frequency. The unit is dBm. Value minusinfinity corresponds to –infinity.","paragraph_zero_based":39707},{"literal_text_all_w_t_and_m_t":"SL-TxPower information element","paragraph_zero_based":39708},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39709},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-TXPOWER-START","paragraph_zero_based":39710},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39711},{"literal_text_all_w_t_and_m_t":"SL-TxPower-r16 ::=                    CHOICE{","paragraph_zero_based":39712},{"literal_text_all_w_t_and_m_t":"    minusinfinity-r16                     NULL,","paragraph_zero_based":39713},{"literal_text_all_w_t_and_m_t":"    txPower-r16                           INTEGER (-30..33)","paragraph_zero_based":39714},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39715},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39716},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-TXPOWER-STOP","paragraph_zero_based":39717},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39718},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39719}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["3fea1b3c268f2184005dcc44ce5087ac2ded30d2d2a1172042e1b943c417def0","237903d985c78930d02a067f8f3ab800d07304573486ace5fc1ac42cc979a3d0","43d8d213a45ae47dfd5b4093f9d4494517b9268337b0bbe0b5a78de17c4e6c53","c48d3b5365e1b091a751fe17db10bbf40c4697ead9df8445193223150387a58c","8c9531d70c60edf6a26f5b1887f941f06995e9fe2b473c97ccce48783c81fbb6","cca0ff7caf049ee81f7b4d3b1638a3affaf7d921b7cc143865214f53e06dc912","e08efe0a50dfe5a775477e48223e41b061b15657c35f3c4557787132e8b42573","a47c8d074633eece2d0c0b970ef773c0d997e835d3c8fd89b2ff9bfba4160eeb","2ce72cd2cd02c64b28025ddda8b5366c7777ca5a085712aa9c60dd409639398e","b72a764f292652e484f16aefe2543ae876700fa8b16d90d754376d610959aee2","0f5e9ecb53cf863fc9b3a04919f12605c7f7ad5123c11576baaf4e98463cf3f5","c9acedd6800956c564938c14684375adca673ae9aeeaf3a1e3142d737a6be877","24ff1af784f29c087e9ac3a14d8fd404bc2ea8e9b207e6da214a134dd01f687c","66005d69b2223362a3dd7ddca74e3b69cdc04c8ad0aa7dbe6dc7e5dbc9c620a5","ebcc8ebb52960facb90c13b870ec451fec993800a37060ad89daba88cad8fbcb","3e6053bd77cb2849c6ba5c99f9e02d78d1f70c8da5a0cf98c621a822efd6af03","0f7871225924cf721a75ffec2a0a2549cf3e3a6dc65308928800fe1bf1cb3ce8","37652a28338a22cc5579e2bc9b8333b5dc87c513264e83fa5467e1903425e901","be1b0feb46b11e0d42c41d2a3904023f2a60ed410047c5c80d578803db3685d1","5657f96195d5933155e2f0308830515c9