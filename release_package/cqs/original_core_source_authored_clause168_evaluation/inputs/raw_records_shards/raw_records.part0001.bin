{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    dlCarrier-r17                       CarrierState-r17                             OPTIONAL, -- Need N","paragraph_zero_based":15360},{"literal_text_all_w_t_and_m_t":"    ulCarrier-r17                       CarrierState-r17                             OPTIONAL  -- Need N","paragraph_zero_based":15361},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":15362},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15363},{"literal_text_all_w_t_and_m_t":"CarrierState-r17::=                 CHOICE {","paragraph_zero_based":15364},{"literal_text_all_w_t_and_m_t":"    deActivated-r17                     NULL,","paragraph_zero_based":15365},{"literal_text_all_w_t_and_m_t":"    activeBWP-r17                       INTEGER (0..maxNrofBWPs)","paragraph_zero_based":15366},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":15367},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15368},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLGROUPCONFIG-STOP","paragraph_zero_based":15369},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":15370},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15371},{"literal_text_all_w_t_and_m_t":"CC-State field descriptions","paragraph_zero_based":15372},{"literal_text_all_w_t_and_m_t":"dlCarrier","paragraph_zero_based":15373},{"literal_text_all_w_t_and_m_t":"Indicates DL carrier activation state for this carrier and the related active BWP Index, if activated.","paragraph_zero_based":15374},{"literal_text_all_w_t_and_m_t":"ulCarrier","paragraph_zero_based":15375},{"literal_text_all_w_t_and_m_t":"Indicates UL carrier activation state for this carrier and the related active BWP Index, if activated.","paragraph_zero_based":15376},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15377},{"literal_text_all_w_t_and_m_t":"CellGroupConfig field descriptions","paragraph_zero_based":15378},{"literal_text_all_w_t_and_m_t":"bap-Address","paragraph_zero_based":15379},{"literal_text_all_w_t_and_m_t":"BAP address of the parent node in cell group.","paragraph_zero_based":15380},{"literal_text_all_w_t_and_m_t":"bh-RLC-ChannelToAddModList","paragraph_zero_based":15381},{"literal_text_all_w_t_and_m_t":"Configuration of the backhaul RLC entities and the corresponding MAC Logical Channels to be added and modified.","paragraph_zero_based":15382},{"literal_text_all_w_t_and_m_t":"bh-RLC-ChannelToReleaseList","paragraph_zero_based":15383}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["9af90317e9d2d31ff4112e944093d4a5318e4ab7012a1d106f4722d322346e05","81eec4601090ad18a4959991ee6fba184935faf39dc422902fca80a3ed6f7b65","8816e789a172eb00083d1bb2b5b881f0e6b2a5704ac4d2b58fadf82e9b9421d4","aae27a9df62a242d970cb6a0cd47bf6fd910b562d0bb1a243552ff2e4516625a","3994463a6307664bf090a4182e7817aed4c09231d3f6c0a2e12d06897b4f9be4","f8ac791302c8b5a63eb6bb36fa5743061f6d27033cc5187c0ae0521287bdeb61","ff2b4849856aada0e8e81b22ee2d9abc6dec56dd5776d5f152fb6ea73d2d98fa","383152c47644922efb141fd82ea853a09efc369c21d692e86c82759c663a4708","d3007ac5b5dd7bcdc71f4e407ec34542143b73dc857f6006e65d89da65bd3e7d","f7389811a38c267d837296f09cbe26c2461a8d9fb2c5d4a09c0131890d4494f3","20c5ff2290a95a8a470dc5d731ca877a72c63e31899fa5fe371b1aa6b84d2ae8","2aafa6e6b276c8cd52bc66261ce2e9eea81529b010277c10b084052a88962dc1","059406d953c583e148c3260423d575a3d77894603843d12dfb569b6f70cfd3e7","855fda5a54bc72055c537a31607cafcd8c146e7a706920642ed2bd15f7f9fc65","5d94cc0de1e4465e2d547d6ae6f6c58fd4ec3f45e99ed23c87f08ca8eb190d4a","8acd85c65c2a31b28aeca4b822b814065f5e2c491c4e5070628c5a80ea5ec360","7178200f7a09df3a37998572ea53861c64947505e88e0f60396bc43f62c2a123","97daa0a203920d4c6e7ac80b9ab863844d4ff4c0976c0afe33d49e80dde528da","4e3ccde824bafa9aa62c927a60161ced609d7a0f8c8dd3ff2cb78cc0e464bd8b","2796624098602d2ca06fa5dd202d2f172f71b09defc2644c27f1cbe997e58f84","2020d6e8de53a4c7986899e52c980b43f4a35716bb485a7ec1a05d5ada4386ef","548af10a2bd2dd651e29b93efb5d60db217df06bcdd77a565756b081a856ee9d","decc054fb3b5c3bc742bcee246c7fa90f7ae8a9263000f3dde2e021edd8e9211","82acc9756df49b1b0f88fd7b46c720afdf3b22e830c48d1bdee51eeb03e63f27"],"paragraph_range_zero_based":[15360,15383],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p15360"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"List of the backhaul RLC entities and the corresponding MAC Logical Channels to be released.","paragraph_zero_based":15384},{"literal_text_all_w_t_and_m_t":"f1c-TransferPath","paragraph_zero_based":15385},{"literal_text_all_w_t_and_m_t":"The F1-C transfer path that an EN-DC IAB-MT should use for transferring F1-C packets to the IAB-donor-CU. If IAB-MT is configured with lte, IAB-MT can only use LTE leg for F1-C transfer. If IAB-MT is configured with nr, IAB-MT can only use NR leg for F1-C transfer. If IAB-MT is configured with both, it is up to IAB-MT to select an LTE leg or a NR leg for F1-C transfer. If the field is not configured, the IAB node uses the NR leg as the default one.","paragraph_zero_based":15386},{"literal_text_all_w_t_and_m_t":"f1c-TransferPathNRDC","paragraph_zero_based":15387},{"literal_text_all_w_t_and_m_t":"The F1-C transfer path that an NR-DC IAB-MT should use for transferring F1-C packets to the IAB-donor-CU. If IAB-MT is configured with mcg, IAB-MT can only use the MCG for F1-C transfer. If IAB-MT is configured with scg, IAB-MT can only use the SCG for F1-C transfer. If IAB-MT is configured with both, it is up to IAB-MT to select the MCG or the SCG for F1-C transfer.","paragraph_zero_based":15388},{"literal_text_all_w_t_and_m_t":"mac-CellGroupConfig","paragraph_zero_based":15389},{"literal_text_all_w_t_and_m_t":"MAC parameters applicable for the entire cell group.","paragraph_zero_based":15390},{"literal_text_all_w_t_and_m_t":"npn-IdentityInfoList","paragraph_zero_based":15391},{"literal_text_all_w_t_and_m_t":"This field is used to transfer npn-IdentityInfoList in SIB1 of the SCell. The UE uses this field to translate the plmn-Index in MCCH of SCell to SNPN Identity. If this field and plmn-IdentityInfoList are both absent, the UE uses the npn-IdentityInfoList in SIB1 of the PCell.","paragraph_zero_based":15392},{"literal_text_all_w_t_and_m_t":"plmn-IdentityInfoList","paragraph_zero_based":15393},{"literal_text_all_w_t_and_m_t":"This field is used to transfer plmn-IdentityInfoList in SIB1 of the SCell. The UE uses this field to translate the plmn-Index in MCCH of SCell to PLMN Identity. If this field and npn-IdentityInfoList are both absent, the UE uses the plmn-IdentityInfoList in SIB1 of the PCell.","paragraph_zero_based":15394},{"literal_text_all_w_t_and_m_t":"prioSCellPRACH-OverSP-PeriodicSRS","paragraph_zero_based":15395},{"literal_text_all_w_t_and_m_t":"When configured, the UE applies UL power control prioritization by prioritizing PRACH transmission on SCell over semi-persistent and/or periodic SRS transmission as defined in subclause 7.5 of TS 38.213 [13].","paragraph_zero_based":15396},{"literal_text_all_w_t_and_m_t":"rlc-BearerToAddModList","paragraph_zero_based":15397},{"literal_text_all_w_t_and_m_t":"Configuration of the MAC Logical Channel, the corresponding RLC entities and association with radio bearers.","paragraph_zero_based":15398},{"literal_text_all_w_t_and_m_t":"reportUplinkTxDirectCurrent","paragraph_zero_based":15399},{"literal_text_all_w_t_and_m_t":"Enables reporting of uplink and supplementary uplink Direct Current location information upon BWP configuration and reconfiguration. This field is only present when the BWP configuration is modified or any serving cell is added or removed. This field is absent in the IE CellGroupConfig when provided as part of RRCSetup message. If UE is configured with SUL carrier, UE reports both UL and SUL Direct Current locations.","paragraph_zero_based":15400},{"literal_text_all_w_t_and_m_t":"reportUplinkTxDirectCurrentMoreCarrier","paragraph_zero_based":15401},{"literal_text_all_w_t_and_m_t":"Enables reporting of uplink Direct Current location information when the UE is configured with intra-band CA. This field is absent in the IE CellGroupConfig when provided as part of RRCSetup message. The UE only reports the uplink Direct Current location information that are related to the indicated cc-CombinationList. The network does not include carriers which locate in DL only spectrum described in TS 38.101-2 [39], clause 5.3A.4 and defined by Fsd according to Table 5.3A.4-3 in FR2 in the IntraBandCC-CombinationReqList. I.e. DL-only carrier in FR2 frequency spectrum is not used to calculate the default DC location.","paragraph_zero_based":15402},{"literal_text_all_w_t_and_m_t":"reportUplinkTxDirectCurrentTwoCarrier","paragraph_zero_based":15403},{"literal_text_all_w_t_and_m_t":"Enables reporting of uplink Direct Current location information when the UE is configured with uplink intra-band CA with two carriers. This field is absent in the IE CellGroupConfig when provided as part of RRCSetup message.","paragraph_zero_based":15404},{"literal_text_all_w_t_and_m_t":"rlc-BearerToReleaseListExt","paragraph_zero_based":15405},{"literal_text_all_w_t_and_m_t":"List of the RLC entities and the corresponding MAC Logical Channels to be released for multicast MRBs.","paragraph_zero_based":15406},{"literal_text_all_w_t_and_m_t":"rlmInSyncOutOfSyncThreshold","paragraph_zero_based":15407}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["0650fc3a9bc03bcf1681be856ee3b21312dda5a552f4fdd029434051f3eada7a","c036ef6be061ea91c20d7e92827c670b4c676bd7f8319b9a780045032e733d17","382c8fafea9f2f8c06985956b614e1a833ab85947a991a42ea40277fc09cd12a","14a21febc21151936eb106902790dbce2121cd6f3d1662b1645b4888e7869b58","5fa4eb04be8f348dbf1d38f32faddf438c794e81666c3480ba7b62b5da605bce","057daeda22b30d93993039d79345ecb6d44c5d86deaee9f12798bd75c6f8011f","6addad6b2f7dd0042c589fdbe1d472df86c616d4e955adaab532fe0e4eb80486","79f27d2ae9a5716fafe0ec3e47fe873c498660ab4601d8e9e348b557745e42ea","f285ccf7ac0f9a1d60b576a6ed95b5dda9ecf200553393a5a314b156e64774d6","5f9d8575abe4631e7fb24f673c974d519bd0d3f9d1d87605a20567e90df5ce5c","a429d0300d0e0072b7e017acb346c4e8a4976726bf95d5afa4d04912300e25b6","2d4f3b1e25720955d793b6f7e60e968adf40dd5b4cce426af25baa312228a4e3","23cf915359841740cabf6df3dffe1d8573dc101f93d14f67a8ad2bf39b2d5315","f2d3184080585b08d3f989f8274c202e87c2fbad376273ea664aa39f78c28703","ce1726b05ff9a338fc1be85879e132a6e1da0f89a9f9ae8a318f26c562fe07ba","c0ba5bde3bdc3110df741aba0dcc41174b31aa1b9e45e4d8943c47c307c62c5c","7ecf7ac461ba47db97c1ab1a6aef7d2e762ebd32a6d51ccf5b44fbb512835083","6c44d603369563669a603564f74fd7c68858cd86a50231656feb7903398e84a8","5339e8bec834f165da4a7d528bbc8f93a981aab4cf2fb6984e54fab355eebb76","71ae9458c15dc0aaf8190371607add2dece67bc131519ea3c458e0be9031430c","f540303e8a0b69fca7c95e569702657259e08d5ceae2fa64c8b422d7a72ed6a7","e28ebdd21324fc91c60ff5f442df369b8ff1ca3ef3e56956cb249ac46daca174","380974be03d30469e41e507ee141b223239f8a83b208618c29715830eda48ab6","4f9818996f65fd53953f64bfacc7f655a6337b599ff99a9d76fdf8bbf9973ef6"],"paragraph_range_zero_based":[15384,15407],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p15384"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"BLER threshold pair index for IS/OOS indication generation, see TS 38.133 [14], table 8.1.1-1. n1 corresponds to the value 1. When the field is absent, the UE applies the value 0. Whenever this is reconfigured, UE resets N310 and N311, and stops T310, if running. Network does not include this field.","paragraph_zero_based":15408},{"literal_text_all_w_t_and_m_t":"sCellSIB20","paragraph_zero_based":15409},{"literal_text_all_w_t_and_m_t":"This field is used to transfer SIB20 of the SCell in order to allow the UE for MBS broadcast reception on SCell. The network configures this field only for a single SCell at a time.","paragraph_zero_based":15410},{"literal_text_all_w_t_and_m_t":"sCellState","paragraph_zero_based":15411},{"literal_text_all_w_t_and_m_t":"Indicates whether the SCell shall be considered to be in activated state upon SCell configuration. If the field is included for an SCell configured with TRS for fast activation of the SCell, such TRS is not used for the corresponding SCell.","paragraph_zero_based":15412},{"literal_text_all_w_t_and_m_t":"sCellToAddModList","paragraph_zero_based":15413},{"literal_text_all_w_t_and_m_t":"List of secondary serving cells (SCells) to be added or modified.","paragraph_zero_based":15414},{"literal_text_all_w_t_and_m_t":"sCellToReleaseList","paragraph_zero_based":15415},{"literal_text_all_w_t_and_m_t":"List of secondary serving cells (SCells) to be released.","paragraph_zero_based":15416},{"literal_text_all_w_t_and_m_t":"simultaneousSpatial-UpdatedList1, simultaneousSpatial-UpdatedList2","paragraph_zero_based":15417},{"literal_text_all_w_t_and_m_t":"List of serving cells which can be updated simultaneously for spatial relation with a MAC CE. The simultaneousSpatial-UpdatedList1 and simultaneousSpatial-UpdatedList2 shall not contain same serving cells. Network should not configure serving cells that are configured with a BWP with two different values for the coresetPoolIndex in these lists.","paragraph_zero_based":15418},{"literal_text_all_w_t_and_m_t":"simultaneousTCI-UpdateList1, simultaneousTCI-UpdateList2","paragraph_zero_based":15419},{"literal_text_all_w_t_and_m_t":"List of serving cells which can be updated simultaneously for TCI relation with a MAC CE. The simultaneousTCI-UpdateList1 and simultaneousTCI-UpdateList2 shall not contain same serving cells. Network should not configure serving cells that are configured with a BWP with two different values for the coresetPoolIndex in these lists.","paragraph_zero_based":15420},{"literal_text_all_w_t_and_m_t":"simultaneousU-TCI-UpdateList1, simultaneousU-TCI-UpdateList2, simultaneousU-TCI-UpdateList3, simultaneousU-TCI-UpdateList4","paragraph_zero_based":15421},{"literal_text_all_w_t_and_m_t":"List of serving cells for which the Unified TCI States Activation/Deactivation MAC CE applies simultaneously, as specified in TS 38.321 [3] clause 6.1.3.47. The different lists shall not contain same serving cells. Network only configures in these lists serving cells that are configured with unifiedTCI-StateType.","paragraph_zero_based":15422},{"literal_text_all_w_t_and_m_t":"spCellConfig","paragraph_zero_based":15423},{"literal_text_all_w_t_and_m_t":"Parameters for the SpCell of this cell group (PCell of MCG or PSCell of SCG). ","paragraph_zero_based":15424},{"literal_text_all_w_t_and_m_t":"uplinkTxSwitchingOption","paragraph_zero_based":15425},{"literal_text_all_w_t_and_m_t":"Indicates which option is configured for dynamic UL Tx switching for inter-band UL CA or (NG)EN-DC. The field is set to switchedUL if network configures option 1 as specified in TS 38.214 [19], or dualUL if network configures option 2 as specified in TS 38.214 [19]. Network always configures UE with a value for this field in inter-band UL CA case and (NG)EN-DC case where UE supports dynamic UL Tx switching.","paragraph_zero_based":15426},{"literal_text_all_w_t_and_m_t":"uplinkTxSwitchingPowerBoosting","paragraph_zero_based":15427},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE is allowed to enable 3dB boosting on the maximum output power for transmission on carrier2 under the operation state in which 2-port transmission can be supported on carrier2 for inter-band UL CA case with dynamic UL Tx switching as defined in TS 38.101-1 [15]. Network can only configure this field for dynamic UL Tx switching in inter-band UL CA case with power Class 3 as defined in TS 38.101-1 [15].","paragraph_zero_based":15428},{"literal_text_all_w_t_and_m_t":"uplinkTxSwitching-2T-Mode","paragraph_zero_based":15429},{"literal_text_all_w_t_and_m_t":"Indicates 2Tx-2Tx switching mode is configured for inter-band UL CA or SUL, in which the switching gap duration for a triggered uplink switching (as specified in TS 38.214 [19]) is equal to the switching time capability value reported for the switching mode.","paragraph_zero_based":15430},{"literal_text_all_w_t_and_m_t":"If this field is absent and uplinkTxSwitching is configured, it is interpreted that 1Tx-2Tx UL Tx switching is configured as specified in TS 38.214 [19]. In this case, there is one uplink (or one uplink band in case of intra-band) configured with uplinkTxSwitching, on which the maximum number of antenna ports among all configured P-SRS/A-SRS and activated SP-SRS resources should be 1 and non-codebook based UL MIMO is not configured.","paragraph_zero_based":15431}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["0b8f7810c15230215ce9ba97e3b754b1bd69fd8632760cbe015b9549c5bdbbf9","e9090176e047bb94754ae7971cf47e82daf3abe16b076418caa9a4fa34778320","77e660b95774a0ce07fe9530014fcbec8ba914e5627f7a1ca96cd92ba055c8dc","92e68e553fec3ac4e4b5e375eed42fd3453a17f346642fe56e08e59387444413","dc0c6990892eb6ba00547292194eeade3f6e3fa1d716fd88c4c58d2a19290552","9cbc167d7358b40d60ca1e12d3cfb8af8c63984dd57405248c91c69eb134f006","4151fb7531633189e3f8eedc1bafa56019f6a4dfda733a722289f8664324aa82","784243f6fbd87b5077acb0326d14515a722c23bb6d9b29d13c15280735073e06","d7f4fb6b3d8860337f1871b0217a6c3b264f1f251e4b2ff120a344a1db893612","ac8abc0ece88ce61e8dc29293e193ca088ec4f0112cfffd861e56d971d9103a9","be561d78e0f8106b63b2121a0a49e76a5a85288e4e374287f5d875bc60dac4b2","dab556cc48955829b97049fd803c20992dcc5280e898955e6ff001ee73457a2b","f19ad67fcbbc6c121bafa075f57593ac3d4a8c6d2629f3f09762860462b075fb","8c78ad9053a8247300e93bf3862cc28c2defbf07b323019d23dcc242d853be56","df96f6bb3900c421ffecffddd13e6e80d73cd7b2c390153072b737c3cc59ef2d","d1727de76400950d411758fee0185078366a80c6aaa74669672795598846a0c9","214306b007c368962be1a29195ee79c03b6f582d5dc59941978f710d8db6e20e","1e027e921247540e0f74f351b9ddc3c3c844d838044486d30d612ef4124c3fb3","9019c7eab1e204d7e7af3caf31019c66e6fe1de113149d32db13ce7a74343a4e","46bdc7c2a19e7ba95f5a5972ffac19c26920da6969eae6f5eee11efaab2e614e","8d6a57524762fb7c0e3924443004e78b5d14a6038980bf77b93c147a26212197","62d78df5d1380bfe103a68526f5f8f81fe5753be378764176e38e096ef328510","94615772f4d5f2bf207f15086e6aebfecd1a4910cc155432876b870833c8dee4","bbe0bdce68fea64ad92fef1d5570388f6ffe06a90223a9a7c2a74c22d35dc835"],"paragraph_range_zero_based":[15408,15431],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p15408"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"uplinkTxSwitching-DualUL-TxState","paragraph_zero_based":15432},{"literal_text_all_w_t_and_m_t":"Indicates the state of Tx chains if the state of Tx chains after the UL Tx switching is not unique (as specified in TS 38.214 [19]) in case of 2Tx-2Tx switching is configured and uplinkTxSwitchingOption is set to dualUL. Value oneT indicates 1Tx is assumed to be supported on the carriers on each band, value twoT indicates 2Tx is assumed to be supported on that carrier.","paragraph_zero_based":15433},{"literal_text_all_w_t_and_m_t":"uu-RelayRLC-ChannelToAddModList","paragraph_zero_based":15434},{"literal_text_all_w_t_and_m_t":"List of the Uu RLC entities and the corresponding MAC Logical Channels to be added or modified.","paragraph_zero_based":15435},{"literal_text_all_w_t_and_m_t":"uu-RelayRLC-ChannelToReleaseList","paragraph_zero_based":15436},{"literal_text_all_w_t_and_m_t":"List of the Uu RLC entities and the corresponding MAC Logical Channels to be released.","paragraph_zero_based":15437},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15438},{"literal_text_all_w_t_and_m_t":"DeactivatedSCG-Config field descriptions","paragraph_zero_based":15439},{"literal_text_all_w_t_and_m_t":"bfd-and-RLM","paragraph_zero_based":15440},{"literal_text_all_w_t_and_m_t":"If the field is set to true, the UE shall perform RLM and BFD on the PSCell when the SCG is deactivated and the network ensures that beamFailure-r17 is not configured in the radioLinkMonitoringConfig of the DL BWP of the PSCell in which the UE performs BFD. If set to false, the UE is not required to perform RLM and BFD on the PSCell when the SCG is deactivated.","paragraph_zero_based":15441},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15442},{"literal_text_all_w_t_and_m_t":"DAPS-UplinkPowerConfig field descriptions","paragraph_zero_based":15443},{"literal_text_all_w_t_and_m_t":"p-DAPS-Source","paragraph_zero_based":15444},{"literal_text_all_w_t_and_m_t":"The maximum total transmit power to be used by the UE in the source cell group during DAPS handover.","paragraph_zero_based":15445},{"literal_text_all_w_t_and_m_t":"p-DAPS-Target","paragraph_zero_based":15446},{"literal_text_all_w_t_and_m_t":"The maximum total transmit power to be used by the UE in the target cell group during DAPS handover.","paragraph_zero_based":15447},{"literal_text_all_w_t_and_m_t":"uplinkPowerSharingDAPS-Mode","paragraph_zero_based":15448},{"literal_text_all_w_t_and_m_t":"Indicates the uplink power sharing mode that the UE uses in DAPS handover (see TS 38.213 [13]).","paragraph_zero_based":15449},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15450},{"literal_text_all_w_t_and_m_t":"GoodServingCellEvaluation field descriptions","paragraph_zero_based":15451},{"literal_text_all_w_t_and_m_t":"offset","paragraph_zero_based":15452},{"literal_text_all_w_t_and_m_t":"The parameter \"X\" (dB) for the good serving cell quality criterion in RRC_CONNECTED, for a cell operating in FR1 and FR2, respectively. If this field is absent, the UE applies the (default) value of 0 dB for \"X\".","paragraph_zero_based":15453},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15454},{"literal_text_all_w_t_and_m_t":"IAB-ResourceConfig field descriptions","paragraph_zero_based":15455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["8950a2e97f2a31a243e71c4a1a9c2df27894d95a69d2244504bb8e10f81ea9bc","8bb3a39ffc14593b534b0072f8ffe707e6de39f44989a1aec571f115bb546484","c11cc8919227a67ca95ffd1756782993d5d28cee9f3264642fc063210c026daf","00cb6c698d0814076baf3e503e0d1c2c0ae580738ecd7a13000ed4d7a735651d","cab4cd12e50e52baeaf4e662db98f345ea102e28a31d0b5e77e205a7ec267e74","2a4ae17a96a431ca382d60bb5f17e6e606a42eb313fa820b36ad503b18d74555","a9599b725fe42e82672b468096fa2df7475d741962d4b73b58d4657a906b9ec8","6e91d931a725d8c79efa2e3589fce0b87b3c878dd649a491ed2d4aaf6230e77b","1c669b3106fc670fd5fd7b9738c30e16d2f94faa9dfbc4a83aeaa9e551c16bb7","d917ae3a7efe8eda1d52633638c82056bf3e28dd1c79af955aa2db1549c8968d","1e7cf0a5e7db5fea8921637074fb5d71b63887c843de53daa11bf4b504d91451","31f0093162ee8862808f57d7b302976a867be30f2c5d826d213400890decf545","1b7564464792157e030e6e9f0493852df8e6cb14aa8cb68c20301a741553ba54","cf14264a38595e62ab69ab290bae4d7b5256d9d9532f55205f6167e5adb8586c","61399172b2bbdeec148d9d3abf9977ca8f867724763e5f812b0f4b531deb4160","609e495305c426c2445d268f64c9ce0fe52658560bf9d50cf8c623c4e47633f1","2bd9a13d70daee6c62da47eab59894d97ddcf4198625dac8925150fa2621359f","c87f5c7395b67b1ad07759bfce23018c663f1141d0c4789d46c4dab8f51b7995","ae114ebe13b493f03d8c90bd486406072aa6ddbf0b72aa7e723a3105cd12c5d4","4ce39e2060f14b426fa5cd777a8dac887bcd511d1d886beb128db6c7f9ce5842","7bc6b26e8d73f1ad8199cfcc1355d550640549c142765665372250c4f617701c","0f3540c66eaa42de62195bf6ff1c59df5bdb5cc9ba7028866affb03f9011d734","257b928821ee151734fb6867a364b2c47a50c0a8725536d1713d4fae09821c92","9fa9a0e55f64b3d6c456bae518f6589b53c0febfee23ed232970cd55c11dae5c"],"paragraph_range_zero_based":[15432,15455],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p15432"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"iab-ResourceConfigID","paragraph_zero_based":15456},{"literal_text_all_w_t_and_m_t":"This ID is used to indicate the specific resource configuration addressed by the MAC CEs specified in TS 38.321 [3].","paragraph_zero_based":15457},{"literal_text_all_w_t_and_m_t":"periodicitySlotList","paragraph_zero_based":15458},{"literal_text_all_w_t_and_m_t":"Indicates the periodicity in ms of the list of slot indexes indicated in slotList.","paragraph_zero_based":15459},{"literal_text_all_w_t_and_m_t":"slotList","paragraph_zero_based":15460},{"literal_text_all_w_t_and_m_t":"Indicates the list of slot indexes to which the information indicated in the specific MAC CE applies to, as specified in TS 38.321 [3]. The values of the entries in the slotList are strictly less than the value of the periodicitySlotList.","paragraph_zero_based":15461},{"literal_text_all_w_t_and_m_t":"slotListSubcarrierSpacing","paragraph_zero_based":15462},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing used as reference for the slotList configuration.","paragraph_zero_based":15463},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":15464},{"literal_text_all_w_t_and_m_t":"FR1:    15 or 30 kHz","paragraph_zero_based":15465},{"literal_text_all_w_t_and_m_t":"FR2-1:  60 or 120 kHz","paragraph_zero_based":15466},{"literal_text_all_w_t_and_m_t":"FR2-2:  120 or 480 kHz","paragraph_zero_based":15467},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15468},{"literal_text_all_w_t_and_m_t":"ReconfigurationWithSync field descriptions","paragraph_zero_based":15469},{"literal_text_all_w_t_and_m_t":"rach-ConfigDedicated","paragraph_zero_based":15470},{"literal_text_all_w_t_and_m_t":"Random access configuration to be used for the reconfiguration with sync (e.g. handover). The UE performs the RA according to these parameters in the firstActiveUplinkBWP (see UplinkConfig).","paragraph_zero_based":15471},{"literal_text_all_w_t_and_m_t":"smtc","paragraph_zero_based":15472},{"literal_text_all_w_t_and_m_t":"The SSB periodicity/offset/duration configuration of target cell for NR PSCell change and NR PCell change. The network sets the periodicityAndOffset to indicate the same periodicity as ssb-periodicityServingCell in spCellConfigCommon or sets to the same periodicity as ssb-Periodicity-r17 in nonCellDefiningSSB-r17 if the first active DL BWP included in this RRC message is configured with nonCellDefiningSSB-r17 for RedCap.","paragraph_zero_based":15473},{"literal_text_all_w_t_and_m_t":"For case of NR PCell change, the smtc is based on the timing reference of (source) PCell. For case of NR PSCell change, it is based on the timing reference of source PSCell.","paragraph_zero_based":15474},{"literal_text_all_w_t_and_m_t":"If both this field and targetCellSMTC-SCG are absent, the UE uses the SMTC in the measObjectNR having the same SSB frequency and subcarrier spacing, as configured before the reception of the RRC message. For a RedCap UE, if the first active DL BWP included in this RRC message is configured with nonCellDefiningSSB-r17, this field corresponds to the NCD-SSB indicated by nonCellDefiningSSB-r17, otherwise, this field corresponds to the CD-SSB indicated by absoluteFrequencySSB in frequencyInfoDL.","paragraph_zero_based":15475},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15476},{"literal_text_all_w_t_and_m_t":"ReportUplinkTxDirectCurrentMoreCarrier field descriptions","paragraph_zero_based":15477},{"literal_text_all_w_t_and_m_t":"IntraBandCC-Combination","paragraph_zero_based":15478},{"literal_text_all_w_t_and_m_t":"Indicates the state of the carriers and BWPs indexes of the carriers in a CC combination, each carrier in this combination corresponds to an entry in servCellIndexList with same order. This IE shall have the same size as servCellIndexList.","paragraph_zero_based":15479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["a8a4d867d770ee93867e1c4d422ecf25e08efc6e0ac7b1374f643ea7ea3c30c8","189b14e10f332b395af286a3322d93430f33ac5cc7cd05d257756d7ee2051939","d8daa2edf786e9435f15577c030a91640f0ac98dcb0b6866bcce54632c719d79","43376cedb1da4893adf79a8a64e2057dd44ea0b03e36144efaa2a0280a1f2dfb","23cc545de643b2c90c4b3125d602ff986524c8e6932bf0148bb227be59d32e53","967afda6095a1d99875f6c6e4c955147873e62317227cbb2d70684119dec2a95","38ce6fd9400fc7e03f194eacabeef0aeb6afdc2046c3a489778e54c96bf8a5b0","4c28e1ae7844535560cd3dd22028b05733a0ab827cc32d5847d9dcfb63fd2ca5","339b26146b315dd25dfca59fe11cd3907c48ffe6c6f02603693ae1b9bb1d37c1","029c3faa4fd94b5e88d3165e3049bbfa744b663be817c2ad528acccbbe9d44ae","abbe0b51a18a434cc375920c7aff26d6b3ca5302c9f4f9eee4872f20346651ed","aabc3a2366154e3f047069487e79779c468aa08ff7a26e41a29a90250768f0fc","268a03d22af4c20f609ebde287b2b57a44d1117632dad0308cfec082ebd34110","cab465884dc9b5f20344a7288c281b09fe9abfcce7e66f5367cf0a49a122acb1","28284d18b9b0c28a8e6cc210e8803d04f8b63b080e3d4c7bff7bc585ebe1a31b","d9b0e01ce893c6d41edbfb1e63a43bbc4a5f3f84c55cd64498378ce1d80b6a98","98f8786a606b866807f61d286330cf8a7806a46f0a8dc59ab5e164c93e4f0392","9a3da6fc00a5dae2253b00bdc718b739e67fa9f708cc04a852f9f6671385515a","2487580e2a9f750938d4c06b1e5e11f05ab0d2e53e3b1581eaca53f34eb09ffb","4a99a92d9d5569d5ea067eab396564cad9000e2efc92e65e8c0be808bfbeb58a","505e3e57c9ada160f15fc54df620fecfbd5877daeaf01f69a9332cbdfd765bb3","a6ebc22ed422ea6bf2b36be8229147a2a69f1cf7b4ef2892534d801744479059","ad8688fc492213e6b3c594d6eda6adf93bf18220c943bdb31c7568392e65d27b","09bf9cfde535649d956f03d00fbe1aae8aa6b4fe048dcbf79de09b51b84c3312"],"paragraph_range_zero_based":[15456,15479],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p15456"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"IntraBandCC-CombinationReqList","paragraph_zero_based":15480},{"literal_text_all_w_t_and_m_t":"Indicates the list of the requested carriers/BWPs combinations for an intra-band CA component.","paragraph_zero_based":15481},{"literal_text_all_w_t_and_m_t":"servCellIndexList","paragraph_zero_based":15482},{"literal_text_all_w_t_and_m_t":"indicates the list of cell index for an intra-band CA component.","paragraph_zero_based":15483},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15484},{"literal_text_all_w_t_and_m_t":"SCellConfig field descriptions","paragraph_zero_based":15485},{"literal_text_all_w_t_and_m_t":"goodServingCellEvaluationBFD","paragraph_zero_based":15486},{"literal_text_all_w_t_and_m_t":"Indicates the criterion for a UE to detect the good serving cell quality for BFD relaxation in an SCell in RRC_CONNECTED. This field is always configured when the network enables BFD relaxation for the UE in this SCell. This field is absent if failureDetectionSetN is present for the SCell.","paragraph_zero_based":15487},{"literal_text_all_w_t_and_m_t":"preConfGapStatus","paragraph_zero_based":15488},{"literal_text_all_w_t_and_m_t":"Indicates whether the pre-configured measurement gaps (i.e. the gaps configured with preConfigInd) are activated or deactivated while this SCell is deactivated. If this field is configured, the UE shall apply network-controlled mechanism for activation and deactivation of the pre-configured measurement gaps, otherwise the UE shall apply the autonomous activation/deactivation mechanism, as specified in TS 38.133 [14]. The first/leftmost bit corresponds to the measurement gap with gap ID 1, the second bit corresponds to measurement gap with gap ID 2, and so on. Value 0 indicates that the corresponding pre-configured measurement gap is deactivated while value 1 indicates that the corresponding pre-configured measurement gap is activated. The UE shall ignore the bit if the corresponding measurement gap is not a pre-configured measurement gap.","paragraph_zero_based":15489},{"literal_text_all_w_t_and_m_t":"secondaryDRX-GroupConfig","paragraph_zero_based":15490},{"literal_text_all_w_t_and_m_t":"The field is used to indicate whether the SCell belongs to the secondary DRX group. All serving cells in the secondary DRX group shall belong to one Frequency Range and all serving cells in the legacy DRX group shall belong to another Frequency Range. If drx-ConfigSecondaryGroup is configured, the field is optionally present. The network always includes the field if the field was previously configured for this SCell and the SCell remains in the secondary DRX group. Removal of an individual SCell from the secondary DRX group is supported by using an SCell release and addition. Otherwise, if drx-ConfigSecondaryGroup is not configured, the field is absent and the UE shall release the field. The UE shall also release the field if drx-ConfigSecondaryGroup is released without including sCellToAddModList.","paragraph_zero_based":15491},{"literal_text_all_w_t_and_m_t":"smtc","paragraph_zero_based":15492},{"literal_text_all_w_t_and_m_t":"The SSB periodicity/offset/duration configuration of target cell for NR SCell addition. The network sets the periodicityAndOffset to indicate the same periodicity as ssb-periodicityServingCell in sCellConfigCommon. The smtc is based on the timing of the SpCell of associated cell group. In case of inter-RAT handover to NR, the timing reference is the NR PCell. In case of intra-NR PCell change (standalone NR) or NR PSCell change (EN-DC), the timing reference is the target SpCell. If the field is absent, the UE uses the SMTC in the measObjectNR having the same SSB frequency and subcarrier spacing, as configured before the reception of the RRC message.","paragraph_zero_based":15493},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15494},{"literal_text_all_w_t_and_m_t":"SpCellConfig field descriptions","paragraph_zero_based":15495},{"literal_text_all_w_t_and_m_t":"deactivatedSCG-Config","paragraph_zero_based":15496},{"literal_text_all_w_t_and_m_t":"Configuration applicable when the SCG is deactivated. The network always configures this field before or when indicating that the SCG is deactivated in an RRCReconfiguration, RRCResume, E-UTRA RRCConnectionReconfiguration or E-UTRA RRCConnectionResume message.","paragraph_zero_based":15497},{"literal_text_all_w_t_and_m_t":"goodServingCellEvaluationBFD","paragraph_zero_based":15498},{"literal_text_all_w_t_and_m_t":"Indicates the criterion for a UE to detect the good serving cell quality for BFD relaxation in the SpCell in RRC_CONNECTED. The field is always configured when the network enables BFD relaxation for the UE in this SpCell. This field is absent if failureDetectionSetN is present for the SpCell.","paragraph_zero_based":15499},{"literal_text_all_w_t_and_m_t":"goodServingCellEvaluationRLM","paragraph_zero_based":15500},{"literal_text_all_w_t_and_m_t":"Indicates the criterion for a UE to detect the good serving cell quality for RLM relaxation in the SpCell in RRC_CONNECTED. The field is always configured when the network enables RLM relaxation for the UE in this SpCell.","paragraph_zero_based":15501},{"literal_text_all_w_t_and_m_t":"lowMobilityEvaluationConnected","paragraph_zero_based":15502},{"literal_text_all_w_t_and_m_t":"Indicates the criterion for a UE to detect low mobility in RRC_CONNECTED in an SpCell. The s-SearchDeltaP-Connected is the parameter \"SSearchDeltaP-connected\". Value dB3 corresponds to 3 dB, dB6 corresponds to 6 dB and so on. The t-SearchDeltaP-Connected is the parameter \"TSearchDeltaP-Connected\". Value s5 means 5 seconds, value s10 means 10 seconds and so on. Low mobility criterion is configured in NR PCell for the case of NR SA/ NR CA/ NE-DC/NR-DC, and in the NR PSCell for the case of EN-DC.","paragraph_zero_based":15503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["c37470f1474e0b7d080c786d2f7e19bd4cbdde123076412ad1a0c7e67a753ba5","ffa5b6f66e4d113443257eefdb6863f48c6e6ac68843150cc89522aecb817879","fbcfbd3de2291eab5860b846e1985308bcdae9287d2c563edb429b802db58d1a","88877b71f48202d164f1999f6cf8aa95bdaa64a28a3e8d05ecf188e11c7ef05e","7e8a2968a82cb8658ce94d7626e9307009fd9f6f200845356ba89a237b87ff6f","3462427c149e5f846a85409c78f07564ee20a491fc76878bfdd8e0ab1c7b5566","0d3ccfec15c04bf36f50284c4730e71b2178bcfcbca8d35cbd272dcf471f0d69","a5b6adec459bc6fcedff8201b261c6c220f18863f50ebbc35fe95db579f84c2f","4f6165ba5a933d9f3fa34f4e9ff8c0c011c700da5202421241a111f88c3abd51","fcaf9aee1f7769fee7840fb2ecfbb0cc9214208f5b352fe425bfcd0ce9d26ad4","dd8f8b3ff61d5d0ce34e823b57e4d3f6d14625695b7f6e2ffe54a6c3c7e5fd49","c69ca73d9a1ba58f027c8799c4c95e4a42fe2189f9d120bafdfde22f45606a29","b1d323998f4a7a46a714e7fdd8d5dbc4e06b2efbfde48910f702cf6eda4ebfc0","ad9a1f0ec0af944047d4404fa80396d1ab82e7b4661c79e5bcbdca598d0fa8ec","48d856ace98de19f28d2834920f160ff35036f8863a714a0e232aa561ddaaa90","b28000dbb9a413e89a1aafa0490322deb9e3ec74ff49991f52e5dda3e363169b","2cb941b038d2e985df0ea1ee08ea50f01362dd46b651c352507870d5b6cc32de","aa46077f7dae407c8c700ebb0597e3f59b0f77995e5e29441a479bec8f38fb64","079f406fb5b80109205180a1af85c97713efd5e9d125f2fea645ea0206a9d485","232a740a2d8ad1c3708f162b500bcc85db0ccd4af5f9d53047478066623269fa","bda621242b38b8a571db47d644571a0b4275c3f5e65df780010fc8d71d5f7f67","f6ff2815d20e70ce21086c21c9109d52b42904ae76724c9d1a15f63101d52ace","fd467fa2741446d20e605de505c7f5c53866d5b1a25154b38e2bcaaaa28cdd13","9a5d5cb7674ecdf741a8991688d5b4d781ebfe06e24cb8f03163ea598c6762c8"],"paragraph_range_zero_based":[15480,15503],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p15480"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"reconfigurationWithSync","paragraph_zero_based":15504},{"literal_text_all_w_t_and_m_t":"Parameters for the synchronous reconfiguration to the target SpCell.","paragraph_zero_based":15505},{"literal_text_all_w_t_and_m_t":"rlf-TimersAndConstants","paragraph_zero_based":15506},{"literal_text_all_w_t_and_m_t":"Timers and constants for detecting and triggering cell-level radio link failure. For the SCG, rlf-TimersAndConstants can only be set to setup and is always included at SCG addition.","paragraph_zero_based":15507},{"literal_text_all_w_t_and_m_t":"servCellIndex","paragraph_zero_based":15508},{"literal_text_all_w_t_and_m_t":"Serving cell ID of a PSCell. The PCell of the Master Cell Group uses ID = 0.","paragraph_zero_based":15509},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15510},{"literal_text_all_w_t_and_m_t":"SL-PathSwitchConfig field descriptions","paragraph_zero_based":15511},{"literal_text_all_w_t_and_m_t":"targetRelayUE-Identity","paragraph_zero_based":15512},{"literal_text_all_w_t_and_m_t":"Indicates the L2 source ID of the target L2 U2N Relay UE during path switch.","paragraph_zero_based":15513},{"literal_text_all_w_t_and_m_t":"T420","paragraph_zero_based":15514},{"literal_text_all_w_t_and_m_t":"Indicates the timer value of T420 to be used during path switch.","paragraph_zero_based":15515},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15516},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":15517},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":15518},{"literal_text_all_w_t_and_m_t":"2Tx","paragraph_zero_based":15519},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if uplinkTxSwitching is configured; otherwise it is absent, Need R.","paragraph_zero_based":15520},{"literal_text_all_w_t_and_m_t":"BWP-Reconfig","paragraph_zero_based":15521},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need N, if the BWPs are reconfigured or if serving cells are added or removed. Otherwise it is absent. ","paragraph_zero_based":15522},{"literal_text_all_w_t_and_m_t":"DirectToIndirect-PathSwitch","paragraph_zero_based":15523},{"literal_text_all_w_t_and_m_t":"The field is mandatory present for the L2 U2N remote UE at path switch to the target L2 U2N Relay UE. It is absent otherwise.","paragraph_zero_based":15524},{"literal_text_all_w_t_and_m_t":"PreConfigMG","paragraph_zero_based":15525},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if there is at least one per UE gap configured with preConfigInd or there is at least one per FR gap of the same FR which the SCell belongs to and configured with preConfigInd. It is absent, Need R, otherwise.","paragraph_zero_based":15526},{"literal_text_all_w_t_and_m_t":"ReconfWithSync","paragraph_zero_based":15527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["440bb2b48feeb99507106f2c744b96e5413ee8d633f2f220305476655605ae1d","16ea0119c68ff047605dc3ebf7074384fe3b575d8bdca22a004857e624722d00","996da4fbfe1a5953e2e96ae89dac3a5e46800b8598c8b8a5200f620dd1105cde","3fdf03d7cb967f1c83a445e477dfb472f6a077b6cd4160f0631bc0b810287cea","957c13c81cddf3b028f05a9fb0dfd46409d2c0e348e2e22d75be41033e3c0953","0b20ad6b05ff11c53bfd3ff4d0c0d06d6770c039d2c0a1973b94bd254f596cfd","c29012260ed9b955a975147aa8487394ccb7c941d44aef58f361fb1dcc9a1b9a","23178ae0e8e9acd9a55a1e311891e24d206a1778aefbce28d3374bedae08dfb4","246661205f1f65a65d881679c86c5e1d40edfe3242382e39d2af63f0fddc7442","59561ea644a471d0ab00f3d72b2e079b2ded47df0499679a51c2c53ddc4240a1","b019e0896377738401d44d6cefc36f7a228cfff6503a87e1f62a6db905c23bdf","3c846fa67a3245f9dee80a9eec25155a11b6f7ed00b8e4288ac62b24e3ec1265","40fd010fe20f9d03fc14b56e96f1850b22b2663286a7998766e30488547d2eaf","f35a9cbb58a4fa6261f5d7d34c020811446745e9350131695da5c0c827b13aa6","41a25b7eafca5bb52951143a010401ee3bf440e473a7e3534d6c8ac2a2dbc2a3","0649a35cd2a67c28d9b666e60fe8be16fcf366d8acbb2840f8324b404b5d175b","9e2a1768d2c27e818149fa2199db54668f142fc49dddd125a4cb0be2732a6e88","9f8213bc2a677ccb0635deb194c5df222ad3c54380302dc1951253a232ee6ae5","55ccc2979e1f3fc0a6392faa330ae4a2cc2c2839eb9715e16794042f14ec2e7b","723759919a3c4f29a9119e3a917c15d9df4173f1e7007655b90e9416fcae6bd2","34744babc09a1669f7cfd5fc68db9295b9f855a867a2397dbe27882be58e3c6a","147f8b6a69ef0feac7e1264751d9f09f125b8b4f5c103bf516006dae0fc4b722","0036f2a8cda83075c93d19df750021f26e7e2350e7cbdb76ceeac6f39b799548","aeb748cd1589ed0100161dd76cf2406978661a3ac51b31a503b8d437bff7d267"],"paragraph_range_zero_based":[15504,15527],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p15504"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The field is mandatory present in the RRCReconfiguration message:","paragraph_zero_based":15528},{"literal_text_all_w_t_and_m_t":"-in each configured CellGroupConfig for which the SpCell changes,","paragraph_zero_based":15529},{"literal_text_all_w_t_and_m_t":"-in the masterCellGroup:","paragraph_zero_based":15530},{"literal_text_all_w_t_and_m_t":"-at change of AS security key derived from KgNB,","paragraph_zero_based":15531},{"literal_text_all_w_t_and_m_t":"-in an RRCReconfiguration message contained in a DLInformationTransferMRDC message,","paragraph_zero_based":15532},{"literal_text_all_w_t_and_m_t":"-path switch of L2 U2N remote UE to the target PCell,","paragraph_zero_based":15533},{"literal_text_all_w_t_and_m_t":"-path switch of L2 U2N remote UE to the target L2 U2N Relay UE,","paragraph_zero_based":15534},{"literal_text_all_w_t_and_m_t":"-in the secondaryCellGroup at:","paragraph_zero_based":15535},{"literal_text_all_w_t_and_m_t":"-PSCell addition,","paragraph_zero_based":15536},{"literal_text_all_w_t_and_m_t":"-SCG resume with NR-DC or (NG)EN-DC,","paragraph_zero_based":15537},{"literal_text_all_w_t_and_m_t":"-update of required SI for PSCell,","paragraph_zero_based":15538},{"literal_text_all_w_t_and_m_t":"-change of AS security key derived from S-KgNB in NR-DC while the UE is configured with at least one radio bearer with keyToUse set to secondary and that is not released by this RRCReconfiguration message,","paragraph_zero_based":15539},{"literal_text_all_w_t_and_m_t":"-MN handover in (NG)EN-DC.","paragraph_zero_based":15540},{"literal_text_all_w_t_and_m_t":"Otherwise, it is optionally present, need M. The field is absent in the masterCellGroup in RRCResume and RRCSetup messages and is absent in the masterCellGroup in RRCReconfiguration messages if source configuration is not released during DAPS handover.","paragraph_zero_based":15541},{"literal_text_all_w_t_and_m_t":"SCellAdd","paragraph_zero_based":15542},{"literal_text_all_w_t_and_m_t":"The field is mandatory present upon SCell addition; otherwise it is absent, Need M.","paragraph_zero_based":15543},{"literal_text_all_w_t_and_m_t":"SCellAddMod","paragraph_zero_based":15544},{"literal_text_all_w_t_and_m_t":"The field is mandatory present upon SCell addition; otherwise it is optionally present, need M.","paragraph_zero_based":15545},{"literal_text_all_w_t_and_m_t":"SCellAddSync","paragraph_zero_based":15546},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need N:","paragraph_zero_based":15547},{"literal_text_all_w_t_and_m_t":"-in the masterCellGroup at","paragraph_zero_based":15548},{"literal_text_all_w_t_and_m_t":"-SCell addition,","paragraph_zero_based":15549},{"literal_text_all_w_t_and_m_t":"-reconfiguration with sync,","paragraph_zero_based":15550},{"literal_text_all_w_t_and_m_t":"-resume of an RRC connection.","paragraph_zero_based":15551}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["be571cdf133e5985c83047665b39e350ba992bb558abfc3c4fce47091b339f21","627c04d921e6d6f189a6bbe88379639ed2f9aaeca27ece2da075ff796f2305f7","94d984377698f5a63770ade8331e6b4c6692f8a84ec4bcf712d23f61e562eebb","030009c7c98ce93ca3d074fd14758658b523727854da8ad767987462e6144c81","5183935186121f064c0ee762a6a0b13587674cfead364077afd67d7b0944b195","8f61d684abc790f30cee7a65e092a32e5bb7621e8e12143f52fd647aa4e54b2a","65b69547fce9a74207bb414b561d1654289008d1202339895d1cedd7228fc73d","9e34b4045bdf7dda04b00985bfcbaff2d9c16a6d0f111ef31b32935b2ea67307","4f6e218cf5d15b0fcf12074a520fd9a80d6b099bf52088240ad6d46d34be633e","6cfa512f7996e024a2dc21e401bf73be0d28e4236a46be83e82c1cff9a3eb4f3","db08d86ddd74ebba9f4bf36b2344c6dab64ae5f60b574e003b58b8aa689a7cbc","c611d9cf8bc169cb3f77e2a0295d88823959574000454a5cfb530def8b58fb19","53befecf55632fe4a2f68e1991ee1b6a129d95078aa5d740222bfaae60341b0a","a3eb407492af4fb2a5ebe4f27cf74b37f4b7b278c90a10fee0fb1490ef20c9b8","14d89646f143b38b057cce79e625da0d9bffa5a86b944817a34ec67f2c55ff31","a3d766b7a020272a359766bd9fa1fae022daab950c4b37c546eb46ef0e6f990d","b64458043ef6c1e6bddaea073c1130f80f65d866ae7bce24c78904023fcc7711","d32255dbb8da6e2b73958e0da8d69853d26cebb256822b58d22fc178a0fa7284","1842cbddf7af11cc0119b583afce9b392a034edb727a5a3dfe9b9804c32ba88f","cf1558adefe7a23780846208357576c9bc898259b61015ecffc49bf5698e8e94","ae35ae920bdc6506730790dc17ae67f2ec08f7d09582c3a088ffa4724d140347","70e0bf82b655599a1e0b931ad295cd83c2418f28b03df1125ec593cea9db8e29","907e4ea7963d88618ef879c5ff973385ba97580dc7a8ddbb21b8fafc9e05b570","06c2297051551efc750d8245554bfbbf7332d0b20840a434b179ffbe1fe235b9"],"paragraph_range_zero_based":[15528,15551],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p15528"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-in the secondaryCellGroup, when the SCG is not indicated as deactivated at:","paragraph_zero_based":15552},{"literal_text_all_w_t_and_m_t":"-SCG activation while the SCG was previously deactivated,","paragraph_zero_based":15553},{"literal_text_all_w_t_and_m_t":"-SCell addition,","paragraph_zero_based":15554},{"literal_text_all_w_t_and_m_t":"-reconfiguration with sync.","paragraph_zero_based":15555},{"literal_text_all_w_t_and_m_t":"It is absent otherwise.","paragraph_zero_based":15556},{"literal_text_all_w_t_and_m_t":"SCG","paragraph_zero_based":15557},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in an SpCellConfig for the PSCell. It is absent otherwise. ","paragraph_zero_based":15558},{"literal_text_all_w_t_and_m_t":"SCellSIB20-Opt","paragraph_zero_based":15559},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need M, if the field sCellSIB20 is configured. It is absent otherwise.","paragraph_zero_based":15560},{"literal_text_all_w_t_and_m_t":"SCG-Opt","paragraph_zero_based":15561},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need M, in an SpCellConfig for the PSCell. It is absent otherwise.","paragraph_zero_based":15562},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15563},{"literal_text_all_w_t_and_m_t":"NOTE:In case of change of AS security key derived from S-KgNB/S-KeNB, if reconfigurationWithSync is not included in the masterCellGroup, the network releases all existing MCG RLC bearers associated with a radio bearer with keyToUse set to secondary. In case of change of AS security key derived from KgNB/KeNB, if reconfigurationWithSync is not included in the secondaryCellGroup, the network releases all existing SCG RLC bearers associated with a radio bearer with keyToUse set to primary.","paragraph_zero_based":15564},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15565},{"literal_text_all_w_t_and_m_t":"–CellGroupId","paragraph_zero_based":15566},{"literal_text_all_w_t_and_m_t":"The IE CellGroupId is used to identify a cell group. Value 0 identifies the master cell group. Other values identify secondary cell groups. In this version of the specification only values 0 and 1 are supported.","paragraph_zero_based":15567},{"literal_text_all_w_t_and_m_t":"CellGroupId information element","paragraph_zero_based":15568},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":15569},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLGROUPID-START","paragraph_zero_based":15570},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15571},{"literal_text_all_w_t_and_m_t":"CellGroupId ::=                             INTEGER (0.. maxSecondaryCellGroups)","paragraph_zero_based":15572},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15573},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLGROUPID-STOP","paragraph_zero_based":15574},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":15575}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["60c3594d312187413c98055922282f228c76a238c07e4ca1f202907425581000","343877c9b8f79135869b0b177b007cf6b4936c41b48ccb6aaaefb37516370e6e","c1e210fcbc160859b74ffb11701591523fef90cec7c302d9d038d23a4ef8891e","45ac70a91490b03319751f1adac3753cf002847d0dfda32a5db9fa54e4449596","428a1cd3186814b89f740a755b46cd2b6c32f47c8838db2e6f1249b2abb269f0","57140f7e6f6adae83bd246bacafe82833adc69aa89f45fc72ce73c8df46de5a3","bb439c6a8fed5acaf3955466c8d71918e0297f9036798b08106191dbdb5719b9","35b046f9644a03ddaae45860a686c943c46