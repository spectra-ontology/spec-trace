{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–RateMatchPattern","paragraph_zero_based":25272},{"literal_text_all_w_t_and_m_t":"The IE RateMatchPattern is used to configure one rate matching pattern for PDSCH, see TS 38.214 [19], clause 5.1.4.1.","paragraph_zero_based":25273},{"literal_text_all_w_t_and_m_t":"RateMatchPattern information element","paragraph_zero_based":25274},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25275},{"literal_text_all_w_t_and_m_t":"-- TAG-RATEMATCHPATTERN-START","paragraph_zero_based":25276},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25277},{"literal_text_all_w_t_and_m_t":"RateMatchPattern ::=                SEQUENCE {","paragraph_zero_based":25278},{"literal_text_all_w_t_and_m_t":"    rateMatchPatternId                  RateMatchPatternId,","paragraph_zero_based":25279},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25280},{"literal_text_all_w_t_and_m_t":"    patternType                         CHOICE {","paragraph_zero_based":25281},{"literal_text_all_w_t_and_m_t":"        bitmaps                             SEQUENCE {","paragraph_zero_based":25282},{"literal_text_all_w_t_and_m_t":"            resourceBlocks                      BIT STRING (SIZE (275)),","paragraph_zero_based":25283},{"literal_text_all_w_t_and_m_t":"            symbolsInResourceBlock              CHOICE {","paragraph_zero_based":25284},{"literal_text_all_w_t_and_m_t":"                oneSlot                             BIT STRING (SIZE (14)),","paragraph_zero_based":25285},{"literal_text_all_w_t_and_m_t":"                twoSlots                            BIT STRING (SIZE (28))","paragraph_zero_based":25286},{"literal_text_all_w_t_and_m_t":"            },","paragraph_zero_based":25287},{"literal_text_all_w_t_and_m_t":"            periodicityAndPattern               CHOICE {","paragraph_zero_based":25288},{"literal_text_all_w_t_and_m_t":"                n2                                  BIT STRING (SIZE (2)),","paragraph_zero_based":25289},{"literal_text_all_w_t_and_m_t":"                n4                                  BIT STRING (SIZE (4)),","paragraph_zero_based":25290},{"literal_text_all_w_t_and_m_t":"                n5                                  BIT STRING (SIZE (5)),","paragraph_zero_based":25291},{"literal_text_all_w_t_and_m_t":"                n8                                  BIT STRING (SIZE (8)),","paragraph_zero_based":25292},{"literal_text_all_w_t_and_m_t":"                n10                                 BIT STRING (SIZE (10)),","paragraph_zero_based":25293},{"literal_text_all_w_t_and_m_t":"                n20                                 BIT STRING (SIZE (20)),","paragraph_zero_based":25294},{"literal_text_all_w_t_and_m_t":"                n40                                 BIT STRING (SIZE (40))","paragraph_zero_based":25295}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["4964e112569522c30263945d0ddde590921cfc0c91c4ffb01baba3bfeb37577a","a81f3d62b161dfda869572c70e7fde6d16c3d753bd2d7748f0764b65377df001","b2a5933edb48ce339b6afc0bd1f3f4161b5a7a1ff46d06a6e3ff881a093a26dd","8e3986659aae9af56c08def8a8bf8e3e83a0b5fd002583fb0f1df58265ec3089","3f6d230cfc6ccf88f94fd98ba6677f999b8b9aeee025bc55dd13d09d34b58fc1","cdd4d1a91cb016edecfbd9dc3d690ca8132816280988680a3d03786cced56896","1a4641ee160750c6d318d54802f24b830333393c7beff64a070c881417cbb8fe","4ab6ed4661d0e812ccff626ce746c59030095b3443c9b7bd8f0b4ff67f6d2a7a","7ab93117adbd8191cb9131981f2570a62cb86f3ec0c43b4e7c154fae1fd28133","8ce9bba65b1052c3b7a0cdc6d60