{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18000},{"literal_text_all_w_t_and_m_t":"–DownlinkPreemption","paragraph_zero_based":18001},{"literal_text_all_w_t_and_m_t":"The IE DownlinkPreemption is used to configure the UE to monitor PDCCH for the INT-RNTI (interruption).","paragraph_zero_based":18002},{"literal_text_all_w_t_and_m_t":"DownlinkPreemption information element","paragraph_zero_based":18003},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18004},{"literal_text_all_w_t_and_m_t":"-- TAG-DOWNLINKPREEMPTION-START","paragraph_zero_based":18005},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18006},{"literal_text_all_w_t_and_m_t":"DownlinkPreemption ::=              SEQUENCE {","paragraph_zero_based":18007},{"literal_text_all_w_t_and_m_t":"    int-RNTI                            RNTI-Value,","paragraph_zero_based":18008},{"literal_text_all_w_t_and_m_t":"    timeFrequencySet                    ENUMERATED {set0, set1},","paragraph_zero_based":18009},{"literal_text_all_w_t_and_m_t":"    dci-PayloadSize                     INTEGER (0..maxINT-DCI-PayloadSize),","paragraph_zero_based":18010},{"literal_text_all_w_t_and_m_t":"    int-ConfigurationPerServingCell     SEQUENCE (SIZE (1..maxNrofServingCells)) OF INT-ConfigurationPerServingCell,","paragraph_zero_based":18011},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":18012},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18013},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18014},{"literal_text_all_w_t_and_m_t":"INT-ConfigurationPerServingCell ::= SEQUENCE {","paragraph_zero_based":18015},{"literal_text_all_w_t_and_m_t":"    servingCellId                       ServCellIndex,","paragraph_zero_based":18016},{"literal_text_all_w_t_and_m_t":"    positionInDCI                       INTEGER (0..maxINT-DCI-PayloadSize-1)","paragraph_zero_based":18017},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18018},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18019},{"literal_text_all_w_t_and_m_t":"-- TAG-DOWNLINKPREEMPTION-STOP","paragraph_zero_based":18020},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18021},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18022},{"literal_text_all_w_t_and_m_t":"DownlinkPreemption field descriptions","paragraph_zero_based":18023}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["67c13711145f4e4292ddf92046313538cb4729c7a5ec2372524b3a5d9583fb05","21699f634b36d38281f9a34b1442f2b0f54db4fcd07bcdfcc61636bd57b40818","26b816541dd1e767562dbd401c44a6715658b2515861f297eb7bc06de9a3d71c","4d262d6907ec3b9a7050a2ffe6b5b95b8001e53c8379462b2c3e8601de31248f","06c550335417eb7bce62196a8a55699ef794e418e6f32bdc9b2c16e7b1445a7d","925cdb7b2485be480e4e149558e5cad0a6c00836540ff0205e519b166db142c1","35b7174f2326023f1844b33ef6c182412de5eff93083bb161136a53900da8d95","f1c4e7a846f3090bb833961a17499d688d5177195dd0dd54df5b92f88c8fd6b0","814f44a7991d5733c3b895ddbbb072327c711de8fcf0f84232752bac31abdd99","349bbd974953e4b1a785256399a940d1de75da342f4ee7299a217bb05f4f7abc","77dd6eadbdd7e15f21f65dd7f5ea227398d03cf6fcb89e4c3126a118a1a28547","fefdb99eedded119b10a6b11e9c17dd5a41ff3990da552b2d8c6f5294b3eb201","c0392fc7144d5784a67913cdad24ec617b99bc1aaad1ad62659726119860d579","2be762d17eab3b746125bfe77ea2c9d4fb99a9eca833f451af2cb0a0d1d2aaf5","c9ba697e023a72c775bce1703ad7e9073669a1994f8ce8f01843b564f78b0359","6ceba90066bc50a25bfd43f58a1d962820b7ae8a96a459e5aaf109cd8f408b28","74097adfdc8a5d2f030773e