{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-RadioBearerToReleaseList","paragraph_zero_based":37800},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple sidelink radio bearer configurations to remove. This field is not configured to the PC5 connection used for L2 U2N relay operation.","paragraph_zero_based":37801},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37802},{"literal_text_all_w_t_and_m_t":"SL-PHY-MAC-RLC-Config field descriptions","paragraph_zero_based":37803},{"literal_text_all_w_t_and_m_t":"networkControlledSyncTx","paragraph_zero_based":37804},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE shall transmit synchronisation information (i.e. become synchronisation source). Value on indicates the UE to transmit synchronisation information while value off indicates the UE to not transmit such information.","paragraph_zero_based":37805},{"literal_text_all_w_t_and_m_t":"sl-DRX-Config","paragraph_zero_based":37806},{"literal_text_all_w_t_and_m_t":"This field indicates the sidelink DRX configuration(s) for unicast, groupcast and/or broadcast communication, as specified in TS 38.321 [3].","paragraph_zero_based":37807},{"literal_text_all_w_t_and_m_t":"sl-MaxNumConsecutiveDTX","paragraph_zero_based":37808},{"literal_text_all_w_t_and_m_t":"This field indicates the maximum number of consecutive HARQ DTX before triggering sidelink RLF. Value n1 corresponds to 1, value n2 corresponds to 2, and so on.","paragraph_zero_based":37809},{"literal_text_all_w_t_and_m_t":"sl-FreqInfoToAddModList","paragraph_zero_based":37810},{"literal_text_all_w_t_and_m_t":"This field indicates the NR sidelink communication configuration on some carrier frequency (ies) to add and/or modify. In this release, only one entry can be configured in the list.","paragraph_zero_based":37811},{"literal_text_all_w_t_and_m_t":"sl-FreqInfoToReleaseList","paragraph_zero_based":37812},{"literal_text_all_w_t_and_m_t":"This field indicates the NR sidelink communication configuration on some carrier frequency (ies) to remove. In this release, only one entry can be configured in the list.","paragraph_zero_based":37813},{"literal_text_all_w_t_and_m_t":"sl-RLC-BearerToAddModList","paragraph_zero_based":37814},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple sidelink RLC bearer configurations to add and/or modify.","paragraph_zero_based":37815},{"literal_text_all_w_t_and_m_t":"sl-RLC-BearerToReleaseList","paragraph_zero_based":37816},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple sidelink RLC bearer configurations to remove.","paragraph_zero_based":37817},{"literal_text_all_w_t_and_m_t":"sl-RLC-ChannelToAddModList","paragraph_zero_based":37818},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple PC5 Relay RLC Channel configurations to add and/or modify. Each PC5 Relay RLC channel configuration provided by network to L2 U2N Relay UE is uniquely associated with one L2 U2N Remote UE.","paragraph_zero_based":37819},{"literal_text_all_w_t_and_m_t":"sl-RLC-ChannelToReleaseList","paragraph_zero_based":37820},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple PC5 Relay RLC Channel configurations to remove.","paragraph_zero_based":37821},{"literal_text_all_w_t_and_m_t":"sl-ScheduledConfig","paragraph_zero_based":37822},{"literal_text_all_w_t_and_m_t":"Indicates the configuration for UE to transmit NR sidelink communication based on network scheduling. This field is not configured simultaneously with sl-UE-SelectedConfig. This field is not configured to a L2 U2N Remote UE.","paragraph_zero_based":37823}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa4