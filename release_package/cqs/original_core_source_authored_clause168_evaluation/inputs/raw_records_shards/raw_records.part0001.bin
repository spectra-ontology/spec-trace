{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The position of the bit within DCI payload containing a search space switching flag (see TS 38.213 [13], clause 11.1.1).","paragraph_zero_based":28536},{"literal_text_all_w_t_and_m_t":"servingCellId","paragraph_zero_based":28537},{"literal_text_all_w_t_and_m_t":"The ID of the serving cell for which the configuration is applicable or the group of serving cells as indicated by CellGroupsForSwitch-r16 containing this servingCellId.","paragraph_zero_based":28538},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28539},{"literal_text_all_w_t_and_m_t":"–S-NSSAI","paragraph_zero_based":28540},{"literal_text_all_w_t_and_m_t":"The IE S-NSSAI (Single Network Slice Selection Assistance Information) identifies a Network Slice end to end and comprises a slice/service type and a slice differentiator, see TS 23.003 [21].","paragraph_zero_based":28541},{"literal_text_all_w_t_and_m_t":"S-NSSAI information element","paragraph_zero_based":28542},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28543},{"literal_text_all_w_t_and_m_t":"-- TAG-S-NSSAI-START","paragraph_zero_based":28544},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28545},{"literal_text_all_w_t_and_m_t":"S-NSSAI  ::=                        CHOICE{","paragraph_zero_based":28546},{"literal_text_all_w_t_and_m_t":"    sst                                 BIT STRING (SIZE (8)),","paragraph_zero_based":28547},{"literal_text_all_w_t_and_m_t":"    sst-SD                              BIT STRING (SIZE (32))","paragraph_zero_based":28548},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28549},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28550},{"literal_text_all_w_t_and_m_t":"-- TAG-S-NSSAI-STOP","paragraph_zero_based":28551},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28552},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28553},{"literal_text_all_w_t_and_m_t":"S-NSSAI field descriptions","paragraph_zero_based":28554},{"literal_text_all_w_t_and_m_t":"sst","paragraph_zero_based":28555},{"literal_text_all_w_t_and_m_t":"Indicates the S-NSSAI consisting of Slice/Service Type, see TS 23.003 [21].","paragraph_zero_based":28556},{"literal_text_all_w_t_and_m_t":"sst-SD","paragraph_zero_based":28557},{"literal_text_all_w_t_and_m_t":"Indicates the S-NSSAI consisting of Slice/Service Type and Slice Differentiator, see TS 23.003 [21].","paragraph_zero_based":28558},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28559}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["3d5a887824220f5575f5a17ebbfd38ecd2c17f5c70007521edfc971ae0d449d8","f7ff27c8dc3b736fe0f58383bfe36deecadb81be330f1a1d620ea29e7ee12c37","f80c1489c3cd08d30412baca60a30153c4a726c1bf0dec7e5d42e372d404ba77","1f09e76d6b5b71704c443fe6f07faa49763ee0e65ca7523736de80165426267b","63b00d76ab470f80dd7451cb9cbef1452ca1fc509fe3f3a4fc93acf4f8312cb7","9e335e6eab2764449650147cd9d23c1de4bd97b0b03fbe0b7c9188af3caa9dca","c514553b30f5cf5a3a0a54987251491ebbcda720867bb145312577a8ea3d7bb1","96dcc5294856a0974f4e8e21784eecf6a6b9a66f3cd0479cbd502a11047cf9be","14497efc41c7d5978ec90cac514127f7ac3acafddd527aeda037980dc5547e3e","2d0c822e1bff03c7c570480f6356fca7a88ffafc8301f12b1f34da5572081489","0b3503c216d549ddaa57a496b25a52e802c23638a8c621ca34542195fb3d7166","0d1e9d7a972725f83791ad0d61772ad2322f3ca85654b6a643d145cbd6ff646d","793df342bcb912442d6defb1cdf72e919ee43680d7ef9d87486ec4708b6c43e6","ff3825d672e709296b0e37b05bbbbca9e5dc2808b3d608fc735206ac1c948047","cd4ae30903891b1ac3a