{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–FeatureSetCombinationId","paragraph_zero_based":31728},{"literal_text_all_w_t_and_m_t":"The IE FeatureSetCombinationId identifies a FeatureSetCombination. The FeatureSetCombinationId of a FeatureSetCombination is the position of the FeatureSetCombination in the featureSetCombinations list (in UE-NR-Capability or UE-MRDC-Capability). The FeatureSetCombinationId = 0 refers to the first entry in the featureSetCombinations list (in UE-NR-Capability or UE-MRDC-Capability).","paragraph_zero_based":31729},{"literal_text_all_w_t_and_m_t":"NOTE:The FeatureSetCombinationId = 1024 is not used due to the maximum entry number of featureSetCombinations.","paragraph_zero_based":31730},{"literal_text_all_w_t_and_m_t":"FeatureSetCombinationId information element","paragraph_zero_based":31731},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":31732},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETCOMBINATIONID-START","paragraph_zero_based":31733},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31734},{"literal_text_all_w_t_and_m_t":"FeatureSetCombinationId ::=         INTEGER (0.. maxFeatureSetCombinations)","paragraph_zero_based":31735},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31736},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETCOMBINATIONID-STOP","paragraph_zero_based":31737},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":31738},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31739},{"literal_text_all_w_t_and_m_t":"–FeatureSetDownlink","paragraph_zero_based":31740},{"literal_text_all_w_t_and_m_t":"The IE FeatureSetDownlink indicates a set of features that the UE supports on the carriers corresponding to one band entry in a band combination.","paragraph_zero_based":31741},{"literal_text_all_w_t_and_m_t":"FeatureSetDownlink information element","paragraph_zero_based":31742},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":31743},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETDOWNLINK-START","paragraph_zero_based":31744},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31745},{"literal_text_all_w_t_and_m_t":"FeatureSetDownlink ::=                  SEQUENCE {","paragraph_zero_based":31746},{"literal_text_all_w_t_and_m_t":"    featureSetListPerDownlinkCC             SEQUENCE (SIZE (1..maxNrofServingCells)) OF FeatureSetDownlinkPerCC-Id,","paragraph_zero_based":31747},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31748},{"literal_text_all_w_t_and_m_t":"    intraBandFreqSeparationDL               FreqSeparationClass                                                     OPTIONAL,","paragraph_zero_based":31749},{"literal_text_all_w_t_and_m_t":"    scalingFactor                           ENUMERATED {f0p4, f0p75, f0p8}                                          OPTIONAL,","paragraph_zero_based":31750},{"literal_text_all_w_t_and_m_t":"    dummy8                                  ENUMERATED {supported}                                                  OPTIONAL,","paragraph_zero_based":31751}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["b088ad4ed154883fd3eec524476f1d17e3d99396179d2cde2666d3c4a84a8dd5","13ced0ec85f49d449a6e0bbcf1b6c19a4e16dd1d4732dc9c06d20e370ee97ba5","1f9f2c97ab695b25e25f62e99f56bb861a86712d3f3831890156ad8068d0859a","23ad6db0ec415d1989de7f6c4d4bf9c70dc2914de5cd6a4dc41374b1a6a2361e","039847b373329803fc1358132560917a9aa7f001458bedf787e34846f375baad","09c1b52fa5cf1dd991a2af1759d99a9ece7271942bd0dcb4323fcee415d46266"