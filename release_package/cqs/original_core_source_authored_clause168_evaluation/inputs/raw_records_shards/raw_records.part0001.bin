{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Uniquely identifies the identity of an MBS service within a PLMN. The field contains octet 3- 5 of the IE Temporary Mobile Group Identity (TMGI) as defined in TS 24.008 [38]. The first octet contains the third octet of the TMGI, the second octet contains the fourth octet of the TMGI and so on.","paragraph_zero_based":40128},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40129},{"literal_text_all_w_t_and_m_t":"6.4RRC multiplicity and type constraint values","paragraph_zero_based":40130},{"literal_text_all_w_t_and_m_t":"–Multiplicity and type constraint definitions","paragraph_zero_based":40131},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":40132},{"literal_text_all_w_t_and_m_t":"-- TAG-MULTIPLICITY-AND-TYPE-CONSTRAINT-DEFINITIONS-START","paragraph_zero_based":40133},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40134},{"literal_text_all_w_t_and_m_t":"maxAdditionalRACH-r17                   INTEGER ::= 256     -- Maximum number of additional RACH configurations.","paragraph_zero_based":40135},{"literal_text_all_w_t_and_m_t":"maxAI-DCI-PayloadSize-r16               INTEGER ::= 128      --Maximum size of the DCI payload scrambled with ai-RNTI","paragraph_zero_based":40136},{"literal_text_all_w_t_and_m_t":"maxAI-DCI-PayloadSize-1-r16             INTEGER ::= 127      --Maximum size of the DCI payload scrambled with ai-RNTI minus 1","paragraph_zero_based":40137},{"literal_text_all_w_t_and_m_t":"maxBandComb                             INTEGER ::= 65536   -- Maximum number of DL band combinations","paragraph_zero_based":40138},{"literal_text_all_w_t_and_m_t":"maxBandsUTRA-FDD-r16                    INTEGER ::= 64      -- Maximum number of bands listed in UTRA-FDD UE caps","paragraph_zero_based":40139},{"literal_text_all_w_t_and_m_t":"maxBH-RLC-ChannelID-r16                 INTEGER ::= 65536   -- Maximum value of BH RLC Channel ID","paragraph_zero_based":40140},{"literal_text_all_w_t_and_m_t":"maxBT-IdReport-r16                      INTEGER ::= 32      -- Maximum number of Bluetooth IDs to report","paragraph_zero_based":40141},{"literal_text_all_w_t_and_m_t":"maxBT-Name-r16                          INTEGER ::= 4       -- Maximum number of Bluetooth name","paragraph_zero_based":40142},{"literal_text_all_w_t_and_m_t":"maxCAG-Cell-r16                         INTEGER ::= 16      -- Maximum number of NR CAG cell ranges in SIB3, SIB4","paragraph_zero_based":40143},{"literal_text_all_w_t_and_m_t":"maxTwoPUCCH-Grp-ConfigList-r16          INTEGER ::= 32      -- Maximum number of supported configuration(s) of {primary PUCCH group","paragraph_zero_based":40144},{"literal_text_all_w_t_and_m_t":"                                                            -- config, secondary PUCCH group config}","paragraph_zero_based":40145},{"literal_text_all_w_t_and_m_t":"maxTwoPUCCH-Grp-ConfigList-r17          INTEGER ::= 16      -- Maximum number of supported configuration(s) of {primary PUCCH group","paragraph_zero_based":40146},{"literal_text_all_w_t_and_m_t":"                                                            -- config, secondary PUCCH group config} for PUCCH cell switching","paragraph_zero_based":40147},{"literal_text_all_w_t_and_m_t":"maxCBR-Config-r16                       INTEGER ::= 8       -- Maximum number of CBR range configurations for sidelink communication","paragraph_zero_based":40148},{"literal_text_all_w_t_and_m_t":"                                                            -- congestion control","paragraph_zero_based":40149},{"literal_text_all_w_t_and_m_t":"maxCBR-Config-1-r16                     INTEGER ::= 7       -- Maximum number of CBR range configurations for sidelink communication","paragraph_zero_based":40150},{"literal_text_all_w_t_and_m_t":"                                                            -- congestion control minus 1","paragraph_zero_based":40151}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["5bac78ea538abaf8cbe64a6ed54914ae57e6b78df6affbe531046c41714be6b9","f7bd5ea35b40b0ab89259ecf18fd03cc5d17a9a265d6a4ef0dfb53c9a20ab338","911bd1c71220a177be397891f1667320ec48e3b216f4c1e42e3130415b7b141f","e7f6eb3a4af2544ed3ad018229232910a0eadd94f24e3ec4fc32ea5cb51fb89f","396c21c3bcd3b578ffddde85e161a36e03e4e06100f50c6913cd32d4a389ad04","803b0077ab982072561b409a27055e7924eedcb45a8fe881f9dee418f7835c77","ad973290c60ce4f626cb7f945362bbd64492d32926414b62ffddec6f4041f0c0","3dadc9ee1b5065c38d735397da879e17380f59a9e8b4c98e69d4e642a99ee211","cdf5f76b6296ee8c1f4490c2bde7b7818c3519e17dc251604f03fae05ccd1e7b","61898a8953058fc1d7815b2c9dfb127ae6c85b2994b5b94ba01dbc1cbb8121ef","1ed1132b5bddd02dda94e8ba116be0938438b4077c790f6243943ea5afcc60a2","f7680b374c38269c7d3950a45a6f2a978c1c391357d739153707d5f61a74c8b6","fdc6a001b91ef72f1ac528adeb9c6f07475f68f56750fd7ba53e1c2869e51281","29d3fa5cb0d90cb6d7f3e8bdebc093c543215e468ec0f41a869ab7c84526669d","fb182df62a5b63d14d496054efb09d0efab2ca332a5f318b6fa0b4d8d194ef17","68fd3b8ab7fb6e5f44138adf6893c205b614545851a51f7faba288b58977f2f4","8df06223780d680f7b57715a32b07c7fb8059af66c3dfb6199ebeaaf9cb45bb0","12a4437fe0a82578d39f8f636435f270d382b6fc15ff18194de637213cbc3f13","5db5dba7b1e171450c33f3ee717962e542613c764e3a4a2565bc3b0adf5d5751","374c015ac05fb4baced9e5da00bc8e8f053892df66f85c5fe4bc41998a4c1a52","66b736aab32d5cf5114d07595136ea62045fb07eac1ef3fb04ca6e32a6e0848e","ac62b37b24a56696afd03518f321abcee240fdd71615c70fca419ddbf5ebacb7","b6d05a88d2a3da1609739758ce40e213643421f2d077b002a5b47b24caddf2ab","4d054b6f6cf956ecd701046df2d57dff