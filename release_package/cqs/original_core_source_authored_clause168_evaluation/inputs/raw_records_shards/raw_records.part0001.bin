{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37128},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-BWP-CONFIGCOMMON-STOP","paragraph_zero_based":37129},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":37130},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37131},{"literal_text_all_w_t_and_m_t":"SL-BWP-ConfigCommon field descriptions","paragraph_zero_based":37132},{"literal_text_all_w_t_and_m_t":"sl-BWP-DiscPoolConfigCommon","paragraph_zero_based":37133},{"literal_text_all_w_t_and_m_t":"This field indicates the NR sidelink discovery dedicated resource pool configurations on the configured sidelink BWP. The total number of Rx/Tx resource pools configured for communication and discovery does not exceed the maximum number of Rx/Tx resource pool for NR sidelink communication (i.e. maxNrofRXPool-r16/maxNrofTXPool-r16).","paragraph_zero_based":37134},{"literal_text_all_w_t_and_m_t":"sl-BWP-Generic","paragraph_zero_based":37135},{"literal_text_all_w_t_and_m_t":"This field indicates the generic parameters on the configured sidelink BWP.","paragraph_zero_based":37136},{"literal_text_all_w_t_and_m_t":"sl-BWP-PoolConfigCommon","paragraph_zero_based":37137},{"literal_text_all_w_t_and_m_t":"This field indicates the resource pool configurations on the configured sidelink BWP.","paragraph_zero_based":37138},{"literal_text_all_w_t_and_m_t":"sl-BWP-PoolConfigCommonPS","paragraph_zero_based":37139},{"literal_text_all_w_t_and_m_t":"This field indicates the resource pool configurations for power saving on the configured sidelink BWP. This field does not include sl-TxPoolExceptional.","paragraph_zero_based":37140},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37141},{"literal_text_all_w_t_and_m_t":"–SL-BWP-DiscPoolConfig","paragraph_zero_based":37142},{"literal_text_all_w_t_and_m_t":"The IE SL-BWP-DiscPoolConfig is used to configure UE specific NR sidelink discovery dedicated resource pool.","paragraph_zero_based":37143},{"literal_text_all_w_t_and_m_t":"SL-BWP-DiscPoolConfig information element","paragraph_zero_based":37144},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":37145},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-BWP-DISCPOOLCONFIG-START","paragraph_zero_based":37146},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37147},{"literal_text_all_w_t_and_m_t":"SL-BWP-DiscPoolConfig-r17 ::=        SEQUENCE {","paragraph_zero_based":37148},{"literal_text_all_w_t_and_m_t":"    sl-DiscRxPool-r17                    SEQUENCE (SIZE (1..maxNrofRXPool-r16)) OF SL-ResourcePool-r16        OPTIONAL,    -- Cond HO","paragraph_zero_based":37149},{"literal_text_all_w_t_and_m_t":"    sl-DiscTxPoolSelected-r17            SL-TxPoolDedicated-r16                                               OPTIONAL,    -- Need M","paragraph_zero_based":37150},{"literal_text_all_w_t_and_m_t":"    sl-DiscTxPoolScheduling-r17          SL-TxPoolDedicated-r16                                               OPTIONAL     -- Need N","paragraph_zero_based":37151}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["2436318b4688ccbab151bde9f5cff2e0d9f5d13851e7df1cada2988708472844","f3e8978603572da234a467a15bfb654783810beb540d53569ac80a73d8bc11ca","6f2f1838d8eb50e020f85a790c7904c3e589edeca4d69e9fa06ea5cb8d8c78b4","6992bc2e73e971f99d000617f25d1a60921d961957902ca3f8a7a03d1a941d9a","1381ee5b6c78dd653f6dc16850e26c38a41da10b153bfe00c020ba2656780ce9","53446b4bb169e10d4dca306b292eb8e353448b8ede3cec0808a25b07fdcae166","169a4fce1a109ae701e7933deed83d580f4f4d