{"fields":{"filename":"R2-2401316.zip::R2-2401316 BLE.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"F","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Rel-18","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-15(Release 15)Rel-16(Release 16)Rel-17(Release 17)Rel-18(Release 18)","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"  Rel-19(Release 19)","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"Reason for change:","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"Corrections identified during RIL review","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"The following RILs have been addressed:","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"B007: BT assistance data has been introduced in clause 6.5.7.7 and should be supported to be broadcasted. If the new posSIB is agreed, then it needs to be added in 36.331/38.331.","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"This change needs to be discussed and approved.","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"038bee5e08277a518e210695a9ad796eb7669167fb359201516fcfc3784430d8","original_member_sha256":"e32d7846969fb9d73f3e6db306c1eaae26983884f0f33261ecdad12458f09ea1","paragraph_ElementTree_utf8_XML_sha256":["a466ebf9dd5d0d05335e6b4eb2f7e28bd9a3a02dfb4f6c042feacb73b471566f","5698b39a56161bdb993cc11ba39d5f8bf33085022be554f3ba7baa438a1a1e2c","62ea355df821d791e68db94a061cd37d59afb3accc4233282f7d08484f0202f9","b8b2bce22e6037610e726895644b2cd3e19de582ba3e159130ce8a1174bfb028","1e6f78ada7b0c3ddd857099631aa8a0a89ad7596995f46d7552de71d31af2632","ee7a7ca72f051967c6df320505d819b45ba9b6d3fe2c0143d02061a290663e86","4e1a3eaa989ea4bed68a8897d1ffaf0209f60dc5383243483630f5591f91f3f2","5a5c6f2c46e823cb7b672ea9bdd5f0918e3c48c2b05aa8e2131a60ae901ede3f","5b0e71f558bb6b5d6777a3719453db0708eb2b8d07057c4c972338c598351b01","f6666c52085839e92a0d3fcf6ecb2bd43b9f65e1e606b7db09004c18393734fb","4b64ee94481252872614ade0bbb38e6808840e611ea5712b42401377ec44eb05","e901f7accf6ef308530e99be482d9bfe553bacf3cb4f2e096462331b6d6356aa","da1d00847c0634dee3ad46164d8a55d712791b8b01da5f78ac4a0a9f5afed0df","61051a0226384ef4a064f181e9715f657e64b2d101932f82ceaef8462bd4c157","4fc948e05b3c9ac799dbcd944453477b6e823baa58e2dce397e88616eca4138f","9a07dbf54031c8db36576164536bd89cfd860c55277e998c489acb939f00bbba","ec31d9953bd4f3c156514b3b7758bd932af994e77203130ba0620297ca8216f9","2dc700c980db8b519aa320f556e2b43