{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17280},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-RESOURCECONFIGID-STOP","paragraph_zero_based":17281},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17282},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17283},{"literal_text_all_w_t_and_m_t":"–CSI-ResourcePeriodicityAndOffset","paragraph_zero_based":17284},{"literal_text_all_w_t_and_m_t":"The IE CSI-ResourcePeriodicityAndOffset is used to configure a periodicity and a corresponding offset for periodic and semi-persistent CSI resources, and for periodic and semi-persistent reporting on PUCCH. both, the periodicity and the offset are given in number of slots. The periodicity value slots4 corresponds to 4 slots, value slots5 corresponds to 5 slots, and so on.","paragraph_zero_based":17285},{"literal_text_all_w_t_and_m_t":"CSI-ResourcePeriodicityAndOffset information element","paragraph_zero_based":17286},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17287},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-RESOURCEPERIODICITYANDOFFSET-START","paragraph_zero_based":17288},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17289},{"literal_text_all_w_t_and_m_t":"CSI-ResourcePeriodicityAndOffset ::=    CHOICE {","paragraph_zero_based":17290},{"literal_text_all_w_t_and_m_t":"    slots4                                  INTEGER (0..3),","paragraph_zero_based":17291},{"literal_text_all_w_t_and_m_t":"    slots5                                  INTEGER (0..4),","paragraph_zero_based":17292},{"literal_text_all_w_t_and_m_t":"    slots8                                  INTEGER (0..7),","paragraph_zero_based":17293},{"literal_text_all_w_t_and_m_t":"    slots10                                 INTEGER (0..9),","paragraph_zero_based":17294},{"literal_t