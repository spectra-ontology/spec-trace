{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    firstPDCCH-MonitoringOccasionOfPO   CHOICE {","paragraph_zero_based":21888},{"literal_text_all_w_t_and_m_t":"        sCS15KHZoneT                                                             SEQUENCE (SIZE (1..maxPO-perPF)) OF INTEGER (0..139),","paragraph_zero_based":21889},{"literal_text_all_w_t_and_m_t":"        sCS30KHZoneT-SCS15KHZhalfT                                               SEQUENCE (SIZE (1..maxPO-perPF)) OF INTEGER (0..279),","paragraph_zero_based":21890},{"literal_text_all_w_t_and_m_t":"        sCS60KHZoneT-SCS30KHZhalfT-SCS15KHZquarterT                              SEQUENCE (SIZE (1..maxPO-perPF)) OF INTEGER (0..559),","paragraph_zero_based":21891},{"literal_text_all_w_t_and_m_t":"        sCS120KHZoneT-SCS60KHZhalfT-SCS30KHZquarterT-SCS15KHZoneEighthT          SEQUENCE (SIZE (1..maxPO-perPF)) OF INTEGER (0..1119),","paragraph_zero_based":21892},{"literal_text_all_w_t_and_m_t":"        sCS120KHZhalfT-SCS60KHZquarterT-SCS30KHZoneEighthT-SCS15KHZoneSixteenthT SEQUENCE (SIZE (1..maxPO-perPF)) OF INTEGER (0..2239),","paragraph_zero_based":21893},{"literal_text_all_w_t_and_m_t":"        sCS120KHZquarterT-SCS60KHZoneEighthT-SCS30KHZoneSixteenthT               SEQUENCE (SIZE (1..maxPO-perPF)) OF INTEGER (0..4479),","paragraph_zero_based":21894},{"literal_text_all_w_t_and_m_t":"        sCS120KHZoneEighthT-SCS60KHZoneSixteenthT                                SEQUENCE (SIZE (1..maxPO-perPF)) OF INTEGER (0..8959),","paragraph_zero_based":21895},{"literal_text_all_w_t_and_m_t":"        sCS120KHZoneSixteenthT                                                   SEQUENCE (SIZE (1..maxPO-perPF)) OF INTEGER (0..17919)","paragraph_zero_based":21896},{"literal_text_all_w_t_and_m_t":"    }                                                                                           OPTIONAL    -- Cond OtherBWP","paragraph_zero_based":21897},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":21898},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":21899},{"literal_text_all_w_t_and_m_t":"    commonSearchSpaceListExt-r16                                             SEQUENCE (SIZE(1..4)) OF SearchSpaceExt-r16     OPTIONAL  -- Need R","paragraph_zero_based":21900},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":21901},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":21902},{"literal_text_all_w_t_and_m_t":"    sdt-SearchSpace-r17                 CHOICE {","paragraph_zero_based":21903},{"literal_text_all_w_t_and_m_t":"        newSearchSpace                      SearchSpace,","paragraph_zero_based":21904},{"literal_text_all_w_t_and_m_t":"        existingSearchSpace                 SearchSpaceId","paragraph_zero_based":21905},{"literal_text_all_w_t_and_m_t":"    }                                                                                           OPTIONAL,   -- Need R","paragraph_zero_based":21906},{"literal_text_all_w_t_and_m_t":"    searchSpaceMCCH-r17                 SearchSpaceId                                           OPTIONAL,   -- Need R","paragraph_zero_based":21907},{"literal_text_all_w_t_and_m_t":"    searchSpaceMTCH-r17                 SearchSpaceId                                           OPTIONAL,   -- Need S","paragraph_zero_based":21908},{"literal_text_all_w_t_and_m_t":"    commonSearchSpaceListExt2-r17       SEQUENCE (SIZE(1..4)) OF SearchSpaceExt-v1700           OPTIONAL,   -- Need R","paragraph_zero_based":21909},{"literal_text_all_w_t_and_m_t":"    firstPDCCH-MonitoringOccasionOfPO-v1710 CHOICE {","paragraph_zero_based":21910},{"literal_text_all_w_t_and_m_t":"       sCS480KHZoneEighthT                      SEQUENCE (SIZE (1..maxPO-perPF)) OF INTEGER (0..35839),","paragraph_zero_based":21911}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["cfa41d5d91db98243be095cdf004844272b7a969ef8c039e72dd86626f8b7e73","9bdadbe7d2c3a7dcfcbe33e9a82073bc11b4abbd368e1388d0165509b48754b4","83e56251de81bcba8a002881939eb49c4003e1c96ea0021c91ecff72d191527d","a802166952879c8a1f7184e19a610d0b9d4d39e67680e8ccff22f986ce22c7c1","0cf1efd00b75eb5e721047ee0f177804a031db7f1718d04e16dcf2b25fbb6e94","65738b8609aaf9d443a0a32775276250ef371e48f8d4d8ba84816cf82b706fcd","08b464651fa1df6a085fd5eeb0508c46eaff023029370d1fbb644f4e6d8d42e2","19ab6b97c03275eacc9fa830f9298bf01db43f9661d5eabed3733bb4aa983556","0dbedfca00a17b270b6be2ba03deb0d20234a660546c44a7e9aa09bb5d0f158e","e88e59000f6348d256a587ce0f0a8a5f8bcc76a41be619c883fd310fe084bb08","021a3bd8c547911e3a16a78891151b8ade010629806c5a22be17e4a433d19857","5a6c0f59acf318ad843531232d85f01b6de63bceb34b337c077a0415a7cb87e8","5db607ff7429d94ea6e0d84ca50591bedd4da78e7b8a9874228127d26213e42c","45c90920b0ae16d5a8a1a5170fb91b16b27409c4d6dfdc72bba81186ab18f126","ce51cce35af45f1f51d5a742ead22700d72ecb43e1fc2e51b601f7557af77824","15f3fcc1e414cf22f78c0c70251c81c64cf59e92a2df23d9830b341336830c9f","bb7063836de06d15c90a2f805807d206cef3f6e43b29e3f2d61c2f720e2378dd","8634dde511b13cc54470d8d882ff10fbf0f8d986407ad9d005d245555a8427f8","d985162f57acbe6208a198f2634ab446ffd41123c44b623121f80a639bdbb5d7","c291776957257a5fe9743337d1fc65a08825b55f13dbcaa8b8241c0202c2c268","b1647c390b7c92da6efcb62d0b91359b3d1155eeb7ea8a6f9458cd208fae2e0f","ebaa47aae39dab074536a3be6e7789888ebe72f3051381af191d13cf8d90b939","9c74d462abac33c03e21c6254f8b66454819c47490471aab5427b942867150ce","919d1824e0fccfa2c43a32eb0bc3e18fe9001be72f761c95012d5d7457767582"],"paragraph_range_zero_based":[21888,21911],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p21888"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"       sCS480KHZoneSixteenthT                   SEQUENCE (SIZE (1..maxPO-perPF)) OF INTEGER (0..71679)","paragraph_zero_based":21912},{"literal_text_all_w_t_and_m_t":"    }                                                                                           OPTIONAL,   -- Need R","paragraph_zero_based":21913},{"literal_text_all_w_t_and_m_t":"    pei-ConfigBWP-r17      SEQUENCE {","paragraph_zero_based":21914},{"literal_text_all_w_t_and_m_t":"        pei-SearchSpace-r17                 SearchSpaceId,","paragraph_zero_based":21915},{"literal_text_all_w_t_and_m_t":"        firstPDCCH-MonitoringOccasionOfPEI-O-r17  CHOICE {","paragraph_zero_based":21916},{"literal_text_all_w_t_and_m_t":"            sCS15KHZoneT                                                     SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..139),","paragraph_zero_based":21917},{"literal_text_all_w_t_and_m_t":"            sCS30KHZoneT-SCS15KHZhalfT                                       SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..279),","paragraph_zero_based":21918},{"literal_text_all_w_t_and_m_t":"            sCS60KHZoneT-SCS30KHZhalfT-SCS15KHZquarterT                      SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..559),","paragraph_zero_based":21919},{"literal_text_all_w_t_and_m_t":"            sCS120KHZoneT-SCS60KHZhalfT-SCS30KHZquarterT-SCS15KHZoneEighthT  SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..1119),","paragraph_zero_based":21920},{"literal_text_all_w_t_and_m_t":"            sCS120KHZhalfT-SCS60KHZquarterT-SCS30KHZoneEighthT-SCS15KHZoneSixteenthT SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..2239),","paragraph_zero_based":21921},{"literal_text_all_w_t_and_m_t":"            sCS480KHZoneT-SCS120KHZquarterT-SCS60KHZoneEighthT-SCS30KHZoneSixteenthT SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..4479),","paragraph_zero_based":21922},{"literal_text_all_w_t_and_m_t":"            sCS480KHZhalfT-SCS120KHZoneEighthT-SCS60KHZoneSixteenthT         SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..8959),","paragraph_zero_based":21923},{"literal_text_all_w_t_and_m_t":"            sCS480KHZquarterT-SCS120KHZoneSixteenthT                         SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..17919),","paragraph_zero_based":21924},{"literal_text_all_w_t_and_m_t":"            sCS480KHZoneEighthT                                           SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..35839),","paragraph_zero_based":21925},{"literal_text_all_w_t_and_m_t":"            sCS480KHZoneSixteenthT                                        SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..71679)","paragraph_zero_based":21926},{"literal_text_all_w_t_and_m_t":"        }","paragraph_zero_based":21927},{"literal_text_all_w_t_and_m_t":"    }                                                                                           OPTIONAL     -- Cond InitialBWP-Paging","paragraph_zero_based":21928},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":21929},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":21930},{"literal_text_all_w_t_and_m_t":"    followUnifiedTCI-State-v1720           ENUMERATED {enabled}                                  OPTIONAL     -- Need R","paragraph_zero_based":21931},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":21932},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21933},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21934},{"literal_text_all_w_t_and_m_t":"-- TAG-PDCCH-CONFIGCOMMON-STOP","paragraph_zero_based":21935}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["c0357b03b6b107b27844f1ac5eb110454dc6ddede5c06f9f54a0b1364cbc307c","da557fb7bb89dc7a9d984816e14e94c9853b032efd07c7166a74ef94da1202bc","1d80becd2c5a1be1c134a72e2d15fb0debc4a3662038121bd58eb4355680b293","f5e38d7608640fcf3b2315b637b168cb8a10b0f72ca985fb4b1aa8b9d54e8c2b","4000cf3bc2e2e95b04cc7bc628157c8bb73716c5307f774484e0946b5536d75a","10f91edaeaa0d386c7e5bd16feb197cb2472b286d982fbbe2c07606c1f7f69dd","6a5d77cffa631a4ac610f65ecadc3417df88e912190ccebd499e76fae1df9ac1","6157a5a77c6db375edbb6ec3256fda46a829db8d198077c37574396f41e5064a","eb09428ff8ca9302f665294951bc80ee32e7cc82205baacfb2356ff1f0db637a","9900b012c3a8d1518fa2f7df83d3300ab62bb418e7ff9326665ab51867972a37","ff88ff695f5a40fc12d006fc72235b77116a61b29258512d4034e4091d0465dc","6ac37f0d19fefb3a90a323cbf3d7d58c29843d7dcc7919a3152b864fc6a68c8c","d39ff15f2b3b0ca7d95821e9c76953f783e9d19677feb2c3952cf32ec95d832d","4443a796a743b3e386d66435cdb6d0c105d30aed667cd18a0042d6b38b66e7ea","993f824db4f9163baf55aec268508e32f569f04b172280557049a186cfcfd307","045bce920d6f75ff13bf9d642203c2920d4b3cd48706f5676daefaced0e179bf","e9c29ecea8c421cdab812b0d18f5d9b67b192d1972b703852e6c6cb5b70782bf","139b0bafed01cbe05e13388a139ff56d8b0b77e75da19b173557c5bbb3c93774","176c6e62c21ce83ed20693f9664da29d3c9a831e7cd9e0cc20d29261ded1979e","15fffa78f3bbf7a8cf74067d6709c31f60bebe48bc6a4a01320676f78bcf0653","1d3c7509ff75143237c40919536c6c896716b6c88684f7db9413b50aa2422ee9","133e33754c759b347524975000baa52b2938aacba2251a96b71bac76a27c1999","68e11e7d4f2c6800d650e14aec853c6466d7980e165c550fb78d96fe398f877d","9d2c601ec74288d82a0719d2fc66679eb9b86829f91ea71e5d36a1f94ebd57c8"],"paragraph_range_zero_based":[21912,21935],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p21912"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21936},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21937},{"literal_text_all_w_t_and_m_t":"PDCCH-ConfigCommon field descriptions","paragraph_zero_based":21938},{"literal_text_all_w_t_and_m_t":"commonControlResourceSet","paragraph_zero_based":21939},{"literal_text_all_w_t_and_m_t":"An additional common control resource set which may be configured and used for any common or UE-specific search space. If the network configures this field, it uses a ControlResourceSetId other than 0 for this ControlResourceSet. The network configures the commonControlResourceSet in SIB1 so that it is contained in the bandwidth of CORESET#0. If the RedCap-specific initial downlink BWP does not contain the entire CORESET#0, the network configures the commonControlResourceSet in the RedCap-specific initial downlink BWP in SIB1 for RedCap such that it does not have to be contained in the bandwidth of CORESET#0.","paragraph_zero_based":21940},{"literal_text_all_w_t_and_m_t":"commonSearchSpaceList, commonSearchSpaceListExt, commonSearchSpaceListExt2","paragraph_zero_based":21941},{"literal_text_all_w_t_and_m_t":"A list of additional common search spaces. If the network configures this field, it uses the SearchSpaceIds other than 0. If the field is included, it replaces any previous list, i.e. all the entries of the list are replaced and each of the SearchSpace entries is considered to be newly created and the conditions and Need codes for setup of the entry apply. If the network includes commonSearchSpaceListExt/commonSearchSpaceListExt2, it includes the same number of entries, and listed in the same order, as in commonSearchSpaceList.","paragraph_zero_based":21942},{"literal_text_all_w_t_and_m_t":"controlResourceSetZero","paragraph_zero_based":21943},{"literal_text_all_w_t_and_m_t":"Parameters of the common CORESET#0 which can be used in any common or UE-specific search spaces. The values are interpreted like the corresponding bits in MIB pdcch-ConfigSIB1. Even though this field is only configured in the initial BWP (BWP#0) controlResourceSetZero can be used in search spaces configured in other DL BWP(s) than the initial DL BWP if the conditions defined in TS 38.213 [13], clause 10 are satisfied.","paragraph_zero_based":21944},{"literal_text_all_w_t_and_m_t":"firstPDCCH-MonitoringOccasionOfPEI-O","paragraph_zero_based":21945},{"literal_text_all_w_t_and_m_t":"Offset, in number of symbols, from the start of the reference frame for PEI-O to the start of the first PDCCH monitoring occasion of PEI-O on this BWP, see TS 38.213 [13], clause 10.4A. For the case po-NumPerPEI is smaller than Ns, UE applies the (floor(i_s/po-NumPerPEI)+1)-th value out of (N_s/po-NumPerPEI) configured values in firstPDCCH-MonitoringOccasionOfPEI-O for the symbol-level offset. When po-NumPerPEI is one or multiple of Ns, UE applies the first configured value in firstPDCCH-MonitoringOccasionOfPEI-O for the symbol-level offset.","paragraph_zero_based":21946},{"literal_text_all_w_t_and_m_t":"firstPDCCH-MonitoringOccasionOfPO","paragraph_zero_based":21947},{"literal_text_all_w_t_and_m_t":"Indicates the first PDCCH monitoring occasion of each PO of the PF on this BWP, see TS 38.304 [20]. The field sCS120KHZquarterT-SCS60KHZoneEighthT-SCS30KHZoneSixteenthT, sCS120KHZoneEighthT-SCS60KHZoneSixteenthT and sCS120KHZoneSixteenthT can be applied for SCS 480kHz, corresponding to sCS480KHZoneT-SCS120KHZquarterT-SCS60KHZoneEighthT-SCS30KHZoneSixteenthT, sCS480KHZhalfT-SCS120KHZoneEighthT-SCS60KHZoneSixteenthT and sCS480KHZquarterT-SCS120KHZoneSixteenthT in IE DownlinkConfigCommonSIB respectively.","paragraph_zero_based":21948},{"literal_text_all_w_t_and_m_t":"followUnifiedTCI-State","paragraph_zero_based":21949},{"literal_text_all_w_t_and_m_t":"When set to enabled, for PDCCH reception in CORESET #0, the UE applies the \"indicated\" DL only TCI or joint TCI as specified in TS 38.214 [19], clause 5.1.5.","paragraph_zero_based":21950},{"literal_text_all_w_t_and_m_t":"pagingSearchSpace","paragraph_zero_based":21951},{"literal_text_all_w_t_and_m_t":"ID of the search space for paging (see TS 38.213 [13], clause 10.1). If the field is absent, the UE does not receive paging in this BWP (see TS 38.213 [13], clause 10). This field is absent for the RedCap-specific initial downlink BWP, if it does not include CD-SSB and the entire CORESET#0. In that case, a RedCap UE in RRC_IDLE or RRC_INACTIVE while SDT procedure is not ongoing, shall monitor paging in the initial DL BWP that includes CORESET#0.","paragraph_zero_based":21952},{"literal_text_all_w_t_and_m_t":"pei-ConfigBWP","paragraph_zero_based":21953},{"literal_text_all_w_t_and_m_t":"Provides the configuration for PEI reception in this BWP. If the field is absent, the UE does not receive PEI in this BWP.","paragraph_zero_based":21954},{"literal_text_all_w_t_and_m_t":"pei-SearchSpace","paragraph_zero_based":21955},{"literal_text_all_w_t_and_m_t":"ID of dedicated search space for PEI. It can be configured to one of up to 4 common SS sets configured by commonSearchSpaceList with SearchSpaceId > 0. The CCE aggregation levels and maximum number of PDCCH candidates per CCE aggregation level follows Table 10.1-1 of TS38.213 [13]. SearchSpaceId = 0 can be configured for the case of SS/PBCH block and CORESET multiplexing pattern 2 or 3.","paragraph_zero_based":21956},{"literal_text_all_w_t_and_m_t":"ra-SearchSpace","paragraph_zero_based":21957},{"literal_text_all_w_t_and_m_t":"ID of the Search space for random access procedure (see TS 38.213 [13], clause 10.1). If the field is absent, the UE does not receive RAR in this BWP. This field is mandatory present in the DL BWP(s) if the conditions described in TS 38.321 [3], clause 5.15 are met.","paragraph_zero_based":21958},{"literal_text_all_w_t_and_m_t":"sdt-SearchSpace","paragraph_zero_based":21959}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["856b97cd474c72aeeeb97ab21b53bbc44d0f89a6b402505f784aa7ecfaba34c6","5b44511e48a87f5a1f240e898d05b36ded5c34e269f917098ce20960d45b5a3c","0e28551e323641457750f423be494d9b501e03c09c1ea10e103fdc145abfdaba","e2cef74dcec3cea322724a7073f0ae2afb0db95eebb3ca4d28a83c95c0f8989d","ecbb9829c0aa669b28b6f98a04b47ce1234158eb77c45a9e8647b85c711ed707","2f29efafc33ed8133de9d460e5cb59f4556d1a0d8ce5333cc7dcd8d9a62d2cde","f96ec900c92dcd8369915c080df701dad416d8610f154bfa333a5b05db882960","4b2969374922baea4449ba7545f2e81dbc9d7bbb08f46525fe540cf3a860cd0b","7b4ebad2f89df616942a470df8e9af0607ba839991507a99b91dfd0256aff55f","3f95a3b2852ff05258949df963f9e22682b6119dcd3137ad57c5f1064ece7025","5e3b787cac80ab626a0a855f0d35c3dfd104bd4054774192481cbaef81645f7a","33edb5913baae1c99341ce0571b91c779cbda9f7f149354798f3b36d9553fb44","e901662fc2a8c583fcd8b75569e9ee92d9f4b90c5901305046778607351fb130","f40909daa422c60efe3664865eede50b076b8aac594b58915aec449dd79aee82","3942bed099586a0eff9e92edb40d5dfe11c0f24e5ee2bf716556ae22bde345da","aec3d7f144788b78fdf74caf50e0b9c02b37a0b20f36e6e5ab6ed90028221c5e","5626217a2d8bfec945677f73faa03505b95eac8060e2f0b2ad4c78c7aede95c1","deb3c35f2c79d95f5ba148b210865ee58175aa95fd72e974cd55bc099072c11e","17be44bcdab903dd11b9b21bb412e271fee8383aa34a60541dc487f7b9656522","c16110a99f8bdfe310181652603516be477b1eb35b396f307373586128829501","a50e50bd2d61fb50473f5f529d8ad83e879bb24682da8932528896e4a5b9bb9b","7d8bbb3a323a97e4f1241d9f10f6b2cefd76233e4a9c897948887e462cd6e6db","4210b95facb33e53b0b8002e0ab2c4d6d2a6a1e1342f4e2da50e0b6bc9e13b6a","56e02d07523765c39c1f9959bd1eb7ff73227fe13f8631ac21e129d319033d21"],"paragraph_range_zero_based":[21936,21959],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p21936"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Common search space for CG-SDT and RA-SDT (see TS 38.213 [13]). If an existingSearchSpace is used, the network only signals the search space ID of the ra-SearchSpace.","paragraph_zero_based":21960},{"literal_text_all_w_t_and_m_t":"searchSpaceMCCH","paragraph_zero_based":21961},{"literal_text_all_w_t_and_m_t":"ID of the search space for MCCH. If the field is absent, the UE does not receive MCCH in this BWP (see TS 38.213 [13], clause 10). This field is absent for the RedCap-specific initial downlink BWP, if it does not include CD-SSB and the entire CORESET#0.","paragraph_zero_based":21962},{"literal_text_all_w_t_and_m_t":"searchSpaceMTCH","paragraph_zero_based":21963},{"literal_text_all_w_t_and_m_t":"ID of the search space for MTCH of MBS broadcast. If the field is absent, the UE applies searchSpaceMCCH also for MTCH, (see TS 38.213 [13], clause 10). This field is absent for the RedCap-specific initial downlink BWP, if it does not include CD-SSB and the entire CORESET#0.","paragraph_zero_based":21964},{"literal_text_all_w_t_and_m_t":"searchSpaceOtherSystemInformation","paragraph_zero_based":21965},{"literal_text_all_w_t_and_m_t":"ID of the Search space for other system information, i.e., SIB2 and beyond (see TS 38.213 [13], clause 10.1). If the field is absent, the UE does not receive other system information in this BWP. This field is absent for the RedCap-specific initial DL BWP, if it does not include CD-SSB and the entire CORESET#0. In that case, a RedCap UE in RRC_IDLE or RRC_INACTIVE shall monitor PDCCH to receive other system information using searchSpaceOtherSystemInformation in the initial DL BWP that includes CD-SSB and the entire CORESET#0.","paragraph_zero_based":21966},{"literal_text_all_w_t_and_m_t":"searchSpaceSIB1","paragraph_zero_based":21967},{"literal_text_all_w_t_and_m_t":"ID of the search space for SIB1 message. In the initial DL BWP of the UE′s PCell, the network sets this field to 0. If the field is absent, the UE does not receive SIB1 in this BWP. (see TS 38.213 [13], clause 10). This field is absent for the RedCap-specific initial DL BWP, if it does not include CD-SSB and the entire CORESET#0. In that case, a RedCap UE in RRC_IDLE or RRC_INACTIVE shall monitor PDCCH to receive SIB1 using searchSpaceSIB1 in the initial DL BWP that includes CD-SSB and the entire CORESET#0.","paragraph_zero_based":21968},{"literal_text_all_w_t_and_m_t":"searchSpaceZero","paragraph_zero_based":21969},{"literal_text_all_w_t_and_m_t":"Parameters of the common SearchSpace#0. The values are interpreted like the corresponding bits in MIB pdcch-ConfigSIB1. Even though this field is only configured in the initial BWP (BWP#0), searchSpaceZero can be used in search spaces configured in other DL BWP(s) than the initial DL BWP if the conditions described in TS 38.213 [13], clause 10, are satisfied.","paragraph_zero_based":21970},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21971},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":21972},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":21973},{"literal_text_all_w_t_and_m_t":"InitialBWP-Only","paragraph_zero_based":21974},{"literal_text_all_w_t_and_m_t":"If SIB1 is broadcast the field is mandatory present in the PDCCH-ConfigCommon of the initial BWP (BWP#0) in ServingCellConfigCommon except it is the RedCap-specific initial BWP not including CD-SSB and the entire CORESET#0; it is absent in other BWPs and when sent in system information. If SIB1 is not broadcast and there is an SSB associated to the cell, the field is optionally present, Need M, in the PDCCH-ConfigCommon of the initial BWP (BWP#0) in ServingCellConfigCommon (still with the same setting for all UEs). In other cases, the field is absent.","paragraph_zero_based":21975},{"literal_text_all_w_t_and_m_t":"OtherBWP","paragraph_zero_based":21976},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, if this BWP is not the initialDownlinkBWP and pagingSearchSpace is configured in this BWP. Otherwise this field is absent.","paragraph_zero_based":21977},{"literal_text_all_w_t_and_m_t":"InitialBWP-Paging","paragraph_zero_based":21978},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, if this BWP is the initialDownlinkBWP or initialDownlinkBWP-RedCap including CD-SSB and the entire CORESET#0, and pei-Config is configured in DownlinkConfigCommonSIB. Otherwise, this field is absent.","paragraph_zero_based":21979},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21980},{"literal_text_all_w_t_and_m_t":"–PDCCH-ConfigSIB1","paragraph_zero_based":21981},{"literal_text_all_w_t_and_m_t":"The IE PDCCH-ConfigSIB1 is used to configure CORESET#0 and search space#0.","paragraph_zero_based":21982},{"literal_text_all_w_t_and_m_t":"PDCCH-ConfigSIB1 information element","paragraph_zero_based":21983}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["bc3688cf7ef961e2cb08f23109f1f61d3cc2f7d428075b753e0aee5c043e0704","d08fa5c434cf04963f834a77a1ac1588e3fcd87407e1e81e4c120a24e5c40634","c3aef354c463798cb76c3fdbd34b2e37ab0b1eabcd87ffb6fc02811ea9bd1eaa","58e10b1b7f82eb114bbd47ccd7263c9fdfb8b4fe32a11bbc3993997ea5ecafc4","b337491f543512397c29cecc4479f23353ba672fece9e4d64390c14545c1ca67","02e98fa3a0ccfde8efbb6b3e8615c08426239fa0049293112c770368ee298e63","496832a8cab4427b4fb5439a338bac5d3cb44a12e0eaefb45175baa178c631ef","b0931fc7f9d0c2d632d581eaa33041f41c1b2cc97c58c71404560842bab58351","e5cb3125db36639cb3fd2d990171