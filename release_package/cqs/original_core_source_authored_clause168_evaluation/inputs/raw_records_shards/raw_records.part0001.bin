                                    OPTIONAL,   -- Need M","paragraph_zero_based":38267},{"literal_text_all_w_t_and_m_t":"    sl-TypeUE-A-r17                           ENUMERATED {enabled}                                                 OPTIONAL,   -- Need R","paragraph_zero_based":38268},{"literal_text_all_w_t_and_m_t":"    sl-PSFCH-Occasion-r17                     INTEGER (0..1)                                                       OPTIONAL,   -- Need M","paragraph_zero_based":38269},{"literal_text_all_w_t_and_m_t":"    sl-SlotLevelResourceExclusion-r17         ENUMERATED {enabled}                                                 OPTIONAL,   -- Need R","paragraph_zero_based":38270},{"literal_text_all_w_t_and_m_t":"    sl-OptionForCondition2-A-1-r17            INTEGER (0..1)                                                       OPTIONAL,   -- Need M","paragraph_zero_based":38271},{"literal_text_all_w_t_and_m_t":"    sl-IndicationUE-B-r17                     ENUMERATED {enabled, disabled}                                       OPTIONAL,   -- Need M","paragraph_zero_based":38272},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":38273},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":38274},{"literal_text_all_w_t_and_m_t":"    sl-DeltaRSRP-Thresh-v1720                 INTEGER (-30..30)                                                    OPTIONAL    -- Need M","paragraph_zero_based":38275},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":38276},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":38277},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38278},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38279}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256