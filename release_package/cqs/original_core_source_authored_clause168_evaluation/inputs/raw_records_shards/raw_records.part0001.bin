ecific but partly also cell specific (e.g. in additionally configured bandwidth parts). Reconfiguration between a PUCCH and PUCCHless SCell is only supported using an SCell release and add.","paragraph_zero_based":117},{"literal_text_all_w_t_and_m_t":"ServingCellConfig information element","paragraph_zero_based":118},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"50a2095effc85e514ac663582703f19bf6444f9ef77a91fd6ee3c360eef6c5bc","original_member_sha256":"71155dffe6c62c6d21bde43469a3470586b534266998f5593f9b07930513ab47","paragraph_ElementTree_utf8_XML_sha256":["de5c3f75db28dfc4fe13938afc025d87b5e4f8a0ac790fc8f6462952b82ef4c6","3409b5c475ffa70c256282dcc066fb40cdee0095886474016ae63aae50c0834a","cdbe60743b8fc2131bf19604c256641631d158fcc3c071560c5050e8ee229e6e","f7f229131434d3884f830133eea9205dbdf3468dc42f1c353cdd00bfb58be9d8","3bd7a0464cee8f7a6a1bd8d02b54c5b2828b9af09029b856151401000fd66604","6437207a5122ab5256940fe8bdf549ff98f36de54be000228247fda221775b21","186ef145efa2d9a6dee18fd7151d25ed8728c15b3eca518a406bdfd79d3b2990","e643017531a6bd07595f15f7bbd4d051283e184abc3081684cc494fbd6e64a4e","21e5753946e72b3d539c31b503fb7d0cbc5443ada2b529dd17e07cdc6f600c4a","29a78b004d8b570fa46b28b27b7738289871e1b564630d6404fdd7296a12c1b5","73d0fc0a6b0d70882454dc31532a697cc7072109e0b22f2db347367ec9537d9d","d8ffb12596886897d846c19ed31afb5e160c52b555f6467c647d207c59aeaa72","a9fbf5d250c3c7d6a0dcf66aa9b0b11f7df70c4eb3f2ce2569620f7430898819","b5d427c67113adf658be89d24c32d0218a528f0e84f59d818349a841e34e0d32","dd4b9307e7a641eb4a42990f4e5207a77a22740164a6313e1a83b4fad00d7569","a9157f48bdd36331f61b74a3e45251165fb35ba7756f959ae4609d7f1e0824ae","a4a7c9d3e84e0717b848e2a1d6427683e8cec44e47cdee7c0c6e9481b0e04da9","4961118f8a0b62c481e8c1dc4799f3ce765e7aa1d02695796653e99b7e8fff63","fed96686ba409c90300456f7c02fb3fefcec2855da1144