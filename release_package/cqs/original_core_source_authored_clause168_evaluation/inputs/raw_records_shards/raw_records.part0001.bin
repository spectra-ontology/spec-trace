{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29544},{"literal_text_all_w_t_and_m_t":"-- TAG-TAR-CONFIG-START","paragraph_zero_based":29545},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29546},{"literal_text_all_w_t_and_m_t":"TAR-Config-r17 ::=                      SEQUENCE {","paragraph_zero_based":29547},{"literal_text_all_w_t_and_m_t":"    offsetThresholdTA-r17               ENUMERATED {ms0dot5, ms1, ms2, ms3, ms4, ms5, ms6 ,ms7, ms8, ms9, ms10, ms11, ms12,","paragraph_zero_based":29548},{"literal_text_all_w_t_and_m_t":"                                                   ms13, ms14, ms15, spare13, spare12, spare11, spare10, spare9, spare8, spare7,","paragraph_zero_based":29549},{"literal_text_all_w_t_and_m_t":"                                                   spare6, spare5, spare4, spare3, spare2, spare1}          OPTIONAL,    -- Need R","paragraph_zero_based":29550},{"literal_text_all_w_t_and_m_t":"    timingAdvanceSR-r17                 ENUMERATED {enabled}                                                OPTIONAL,    -- Need R","paragraph_zero_based":29551},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":29552},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29553},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29554},{"literal_text_all_w_t_and_m_t":"-- TAG-TAR-CONFIG-STOP","paragraph_zero_based":29555},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29556},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29557},{"literal_text_all_w_t_and_m_t":"TAR-Config field descriptions","paragraph_zero_based":29558},{"literal_text_all_w_t_and_m_t":"offsetThresholdTA","paragraph_zero_based":29559},{"literal_text_all_w_t_and_m_t":"Offset for TA reporting as specified in TS 38.321 [3]. Network only configures this parameter for MCG.","paragraph_zero_based":29560},{"literal_text_all_w_t_and_m_t":"timingAdvanceSR","paragraph_zero_based":29561},{"literal_text_all_w_t_and_m_t":"Used to configure whether a Timing Advance report may trigger a Scheduling Request as specified in TS 38.321 [3].","paragraph_zero_based":29562},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29563},{"literal_text_all_w_t_and_m_t":"–TCI-ActivatedConfig","paragraph_zero_based":29564},{"literal_text_all_w_t_and_m_t":"The IE TCI-ActivatedConfig is used to provide activated TCI states for PDSCH and/or PDCCH of the PSCell or of an SCell.","paragraph_zero_based":29565},{"literal_text_all_w_t_and_m_t":"TCI-ActivatedConfig information element","paragraph_zero_based":29566},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29567}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["7702add5201e757c092667c3d2f650b93b9078e4c4c27423af8e5101d712aa75","86702e530ab1375537ae5bec780065756df30d3639200635fdf0194d9b05cfa0","995b39c0256e766e9eb3a590227249b7643a4c43de3b5d2fef8820111865a428","5e78bc04b948771590a461bc9bec89d14c97ed1e031c44b2f25c6845e384d826","1ddcc35d2b36599f43ece414bccf18594b41ca27d9b1cb36f5c019f809fd6e6d","09bbda5d9d229499d90636faa8577784ad8bc087c1f9f1f2fa8ce0f723d43f12","a547c66eabc40a4d82f2f590e862d1de0b2c5a269b6ecd9e14348536587bdad9","0e34ebbfa4d9092c2b08c47436ae1157fed2347548d8deebe3bd68b54826757a","3c545967e44c0b669040bee8565d6fa382800f445b75ccc2049f4f3e3670d203","ccce4178145694d4bc99f3f5c51fda8e3fc277ffac09cc27bd19fab6a4b96b57","d5869ef3413913688697d97d7acc396a31adbf4d66444e789946b0cdf8002b34","65f39e8d1ff54cd3d424e4a43045a238c1fa7118c235823cb0df5c250fe7605b","978bacde7978d5ce2457ee21946e46ea355f9f028aaa7359caf01707e88a3459","538a60b46ca957618dbeb72ed4c507da53e2379e01d8d7d30798f4f1167f47ec","0f43880911e974853b5692c48ee0dea4c96b6c733a977244531569357b6514a3","dcebc9d4738373fc1883715673aedbabdb57ff8b2178d36023c8c2b8d3261319","a01a066982cd5272b3ffff305ac448787d8b110f6b7bd6a3509331b26c3ddbeb","2247a137d371787dccac6822389f31a4224179da28c8ae09eb76f413546b836e","2eba28024c407721e4a400aac2cc1145f76c79dde9cb01ac8bc374ccd4c66480","242eba6fdb73107551e985dedca4d34fe084825474ad89607586b54588162dca","88f9147c619208418588315a9f36608f39c74ebe5eefdd450357176bc745625c","1ec4b19199ee3d3fd93f961d6fc3422f800568bc4aca3c88bb9b90dd1a66597c","c45256e4167bb53cb129175ffae23e2e6014389025d1fff42884f28047add1d6","408fb3d068e2372f29b1a019eb7c9c742ecafed3803ccf9256d950c89625fed4"],"paragraph_range_zero_based":[29544,29567],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p29544"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-TCI-ACTIVATEDCONFIG-START","paragraph_zero_based":29568},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29569},{"literal_text_all_w_t_and_m_t":"TCI-ActivatedConfig-r17 ::= SEQUENCE {","paragraph_zero_based":29570},{"literal_text_all_w_t_and_m_t":"    pdcch-TCI-r17               SEQUENCE (SIZE (1..5)) OF TCI-StateId,","paragraph_zero_based":29571},{"literal_text_all_w_t_and_m_t":"    pdsch-TCI-r17               BIT STRING (SIZE (1..maxNrofTCI-States))","paragraph_zero_based":29572},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29573},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29574},{"literal_text_all_w_t_and_m_t":"-- TAG-TCI-ACTIVATEDCONFIG-STOP","paragraph_zero_based":29575},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29576},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29577},{"literal_text_all_w_t_and_m_t":"TCI-ActivatedConfig field descriptions","paragraph_zero_based":29578},{"literal_text_all_w_t_and_m_t":"pdcch-TCI","paragraph_zero_based":29579},{"literal_text_all_w_t_and_m_t":"Indicates the TCI state for PDCCH for each configured CORESET of the DL BWP to be activated at SCell activation, to be activated for the PSCell at SCG activation and/or to be used for BFD, RLM and measurements while the SCG is deactivated. The list includes exactly as many entries as CORESETs configured in this BWP, ordered by increasing values of ControlResourceSet-Id, i.e. the first entry indicates the TCI state for the configured CORESET with the lowest ControlResourceset-Id value, the second value indicates the TCI states for the configured CORESET with the second lowest ControlResourceset-Id value, and so on.","paragraph_zero_based":29580},{"literal_text_all_w_t_and_m_t":"pdsch-TCI","paragraph_zero_based":29581},{"literal_text_all_w_t_and_m_t":"Indicates TCI states for PDSCH reception at SCell addition/activation or of the PSCell at SCG activation. This field indicates activated TCI state(s) for this BWP ordered by increasing values of TCI-StateId, i.e. the first bit indicates the activation state of the TCI state with the lowest TCI-StateId value, the second value indicates the activation status of the TCI state with the second lowest TCI-State-Id value, and so on. A bit set to 0 indicates that the corresponding TCI state is deactivated, a bit set to 1 indicates that the TCI state is activated.","paragraph_zero_based":29582},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29583},{"literal_text_all_w_t_and_m_t":"–TCI-State","paragraph_zero_based":29584},{"literal_text_all_w_t_and_m_t":"The IE TCI-State associates one or two DL reference signals with a corresponding quasi-colocation (QCL) type.","paragraph_zero_based":29585},{"literal_text_all_w_t_and_m_t":"TCI-State information element","paragraph_zero_based":29586},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29587},{"literal_text_all_w_t_and_m_t":"-- TAG-TCI-STATE-START","paragraph_zero_based":29588},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29589},{"literal_text_all_w_t_and_m_t":"TCI-State ::=                       SEQUENCE {","paragraph_zero_based":29590},{"literal_text_all_w_t_and_m_t":"    tci-StateId                         TCI-StateId,","paragraph_zero_based":29591}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["8e167b09591397096b453a7f0157f390c6b93f8da8766e70ece764985c59ad75","2243a889ff2f4cbff9568193c23e3f58bb9cb548efc4da31c2f921e8f596ab22","60ae40e1b044d4a6d2