{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–TrackingAreaCode","paragraph_zero_based":29472},{"literal_text_all_w_t_and_m_t":"The IE TrackingAreaCode is used to identify a tracking area within the scope of a PLMN/SNPN, see TS 24.501 [23].","paragraph_zero_based":29473},{"literal_text_all_w_t_and_m_t":"TrackingAreaCode information element","paragraph_zero_based":29474},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29475},{"literal_text_all_w_t_and_m_t":"-- TAG-TRACKINGAREACODE-START","paragraph_zero_based":29476},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29477},{"literal_text_all_w_t_and_m_t":"TrackingAreaCode ::= BIT STRING (SIZE (24))","paragraph_zero_based":29478},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29479},{"literal_text_all_w_t_and_m_t":"-- TAG-TRACKINGAREACODE-STOP","paragraph_zero_based":29480},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29481},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29482},{"literal_text_all_w_t_and_m_t":"–T-Reselection","paragraph_zero_based":29483},{"literal_text_all_w_t_and_m_t":"The IE T-Reselection concerns the cell reselection timer TreselectionRAT for NR and E-UTRA. Value in seconds. For value 0, behaviour as specified in 7.1.2 applies.","paragraph_zero_based":29484},{"literal_text_all_w_t_and_m_t":"T-Reselection information element","paragraph_zero_based":29485},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29486},{"literal_text_all_w_t_and_m_t":"-- TAG-TRESELECTION-START","paragraph_zero_based":29487},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29488},{"literal_text_all_w_t_and_m_t":"T-Reselection ::=                   INTEGER (0..7)","paragraph_zero_based":29489},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29490},{"literal_text_all_w_t_and_m_t":"-- TAG-TRESELECTION-STOP","paragraph_zero_based":29491},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29492},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29493},{"literal_text_all_w_t_and_m_t":"–TimeAlignmentTimer","paragraph_zero_based":29494},{"literal_text_all_w_t_and_m_t":"The IE TimeAlignmentTimer is used to configure the time alignment timer as specified in TS 38.321 [3]. The values are in ms.","paragraph_zero_based":29495}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["3e33ecc918d0ed4d8ad959956b32b6b14e3c965464547dde242e218c320ae715","8f4a4edbf26ac6b1a287e047469f1746f8a1ee92272f6ae09ff08385c13e5e04","48e2e25e1a96ee13582931c92511400a6943c764471e8c140cf0dbc8cceb1264","766b8a9f8d68b727c8c3d24c4e5ab63afa175da0c05f5e33f30400ea9960c04d","aab34b96df085a377439aadb6d42bc4cd2db78a3ae90a1390cd8027740525e4b","1c8f8789829e4ff483bdf6c6656728401bbf4abdf473adbcb8b90c24da69160b","2798f1b26a5058bd68336d9c86c827314fefcd43a75fc279e2e079aa640b967a","1206e3f13b35f0f603c7de3f8ce9ddeffa0fd9c0c5b091b4b22fed339e9cc60b","8cc6ec4526e6dc095ada5b90cae788f4adb4777a8ab7b953f0ab493c2aa60e18","13a67471fe3cb1bf6a97d3dd1a896d15c6702034734faf4786bb61ff660a948b","e896007d360018f0d21d6bc7d0394e40c327500535500a0f86ba9c337530b628","3591f54a11b30dd72e6b3a0fd0552e1b19cdd7c6341f94d3f06f0613b2ea3ec2","8ec00f1bfad268792d08f887463b554af73711df65dbdcb84d2adf71fab107a1","39de52d9466ffaf384ba2af9606b5734bb5b38b4fe0a18e4ef2e1de433ef31a7","7f2195fa2131a476b55554a51bbf9ab463a48e7479aaebdfcd039f1a680c4f0c","126578bd06c7cffeccd574993a463ef1cd190ad9cb710e4090e33dfbb73f3e27","603bee1a1eb6441064d53774559105e3a9ed2b0fa27eae3776d84e0f03c6bca0","cc4f32c98c425