3cf8541b590038be16ef52091039d5324fdd760ed46c378d876","3a0fccbddcdd2aeba4821bb496d58d59d98aaadc0bc1cf5832649d7f01fea4d8","326e98e09f77b78497811eb641460c4f0c2bf51c626664beb36dc6815fb9801c","65eef9cf3e8286774b7d20d33ad5375139552267d919060302c02d0cb0aee440","b6b29b07e63cf1e51ddf032efe4356431e5481ea23b8358ab3e4ecce30a80abf","7dc2173af099f726ffbefeb55d2c9820c8394847052618135e5ef09e7375c119","60d72c6fc96a95fcab5cc6b511174f30988a24cb40f575f6e64676d3c52d52b5","9ba1cf992db58d1b73ab870171e4a1034b7009d1194b470048f21b1aaac51f41","987c59c0c90d2fbe3aef67654c3c91712355715cb4ac85e8ce9d066a6c9f3176","0f92e42144cfa88738332a2de4410b62f7f17b289f9903b23438c61f4c1bddb7","845c009aa970b391bfcfb7ba7871f44646abb36dae19f09352838bfe4638f8ea","f744e80d4ad0a92cf0526a47adcf119f575a4aa140da12702ac11e8ed2970302","aad6a883a1cfe0ae69fc4d5eb0d4b5588b386aebd14e8760c4f0cb8ee325aac5","b40f370a4da6b054d597012e1fc664cf1cce989621f460469fd19b8768677ef3","5f2c9ca8711273d5a8472224eecd354e84c64f3ae9ea827cbb891728c7c6e4a4","6c006eecd9b7537b3b82d75136cbc25aa866c00d1e788c6c1183f70e6586dff9","7b4cdadc600cfa76582a44b3c82cd40b0daf3757ced551a858c773ce5767cb07","db9035afe8a95c66ecdfcaf45025e3d0e2d18573dd172a9cd0f5a23cbafda810","7094b1a651589f7b5f131165896c2cafa6991449d4d941cba04d90ba88925e4b"],"paragraph_range_zero_based":[24792,24815],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p24792"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24816},{"literal_text_all_w_t_and_m_t":"-- TAG-RACH-CONFIGCOMMON-STOP","paragraph_zero_based":24817},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":24818},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24819},{"literal_text_all_w_t_and_m_t":"RACH-ConfigCommon field descriptions","paragraph_zero_based":24820},{"literal_text_all_w_t_and_m_t":"featureCombinationPreamblesList","paragraph_zero_based":24821},{"literal_text_all_w_t_and_m_t":"Specifies a series of preamble partitions each associated to a combination of features and 4-step RA. The network does not configure this list to have more than 16 entries.","paragraph_zero_based":24822},{"literal_text_all_w_t_and_m_t":"messagePowerOffsetGroupB","paragraph_zero_based":24823},{"literal_text_all_w_t_and_m_t":"Threshold for preamble selection. Value is in dB. Value minusinfinity corresponds to –infinity. Value dB0 corresponds to 0 dB, dB5 corresponds to 5 dB and so on. (see TS 38.321 [3], clause 5.1.2)","paragraph_zero_based":24824},{"literal_text_all_w_t_and_m_t":"msg1-SubcarrierSpacing","paragraph_zero_based":24825},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing of PRACH (see TS 38.211 [16], clause 5.3.2).","paragraph_zero_based":24826},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":24827},{"literal_text_all_w_t_and_m_t":"FR1:    15 or 30 kHz","paragraph_zero_based":24828},{"literal_text_all_w_t_and_m_t":"FR2-1:  60 or 120 kHz","paragraph_zero_based":24829},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":24830},{"literal_text_all_w_t_and_m_t":"If absent, the UE applies the SCS as derived from the prach-ConfigurationIndex in RACH-ConfigGeneric (see tables Table 6.3.3.1-1, Table 6.3.3.1-2, Table 6.3.3.2-2 and Table 6.3.3.2-3, TS 38.211 [16]). The value also applies to contention free random access (RACH-ConfigDedicated), to SI-request and to contention-based beam failure recovery (CB-BFR). But it does not apply for contention free beam failure recovery (CF-BFR) (see BeamFailureRecoveryConfig).","paragraph_zero_based":24831},{"literal_text_all_w_t_and_m_t":"msg3-transformPrecoder","paragraph_zero_based":24832},{"literal_text_all_w_t_and_m_t":"Enables the transform precoder for Msg3 transmission according to clause 6.1.3 of TS 38.214 [19]. If the field is absent, the UE disables the transformer precoder (see TS 38.213 [13], clause 8.3).","paragraph_zero_based":24833},{"literal_text_all_w_t_and_m_t":"numberOfRA-PreamblesGroupA","paragraph_zero_based":24834},{"literal_text_all_w_t_and_m_t":"The number of CB preambles per SSB in group A. This determines implicitly the number of CB preambles per SSB available in group B. (see TS 38.321 [3], clause 5.1.1). The setting should be consistent with the setting of ssb-perRACH-OccasionAndCB-PreamblesPerSSB.","paragraph_zero_based":24835},{"literal_text_all_w_t_and_m_t":"prach-RootSequenceIndex","paragraph_zero_based":24836},{"literal_text_all_w_t_and_m_t":"PRACH root sequence index (see TS 38.211 [16], clause 6.3.3.1). The value range depends on whether L=839 or L=139 or L=571 or L=1151. The length of the root sequence corresponding with the index indicated in this IE should be consistent with the one indicated in prach-ConfigurationIndex in the RACH-ConfigDedicated (if configured). If prach-RootSequenceIndex-r16 is signalled, UE shall ignore the prach-RootSequenceIndex (without suffix).","paragraph_zero_based":24837},{"literal_text_all_w_t_and_m_t":"For FR2-2, only the following values are applicable depending on the used subcarrier spacing:","paragraph_zero_based":24838},{"literal_text_all_w_t_and_m_t":"120 kHz:  L=139, L=571, and L=1151","paragraph_zero_based":24839}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["5d07b9c0aecc66d1d41395ddd5dc7f2878f147f5982977ec8e2d76c7b43db7eb","2e56927b7694b57a51680d647bf7343cd0448cb735bcc74ac370337a7bc3233f","048e1d3f3a2e17adad7402925b217218ce7f1f99edc61d68184679c06e3a6e39","ebf0d03f227ac39ac649edbc3c631e7229717bc2b8b314b9f032c15e2ae155b7","85bf831d0800e81668734a2c03cf5573fead0c793ddf6fa588fcea1c64536db8","f02ba82315c88765cb33c6f3b5fc920160bba30d76ae7abe6240db42ffa556dd","3ff1f0311457c66efabb52f7aa6ef15d7398f54eaa646f43914961787bd6d172","6d3064b22dd569ae0becf4f72962140daca25155623bf43f82c05939cdb3f577","2f168424218671f4f6fbdcf77271f4c536bf9d2ba6c967b62c73ad05de507669","75d433fbef26b3e94cc7c715a10a5af08cd8bb6e8cc52866e0a920d49275ebeb","4dd0b8c5da5dd2c0039e56ff8cb22eb07a58b8eb660cdd928ce0544350019911","2a5d11b6073369a028796885e4bb78b8c03b3b4f5b6f19d51added6f0030443a","bbbcdd725ca598773310c7947cf5ace21b1e9523ca9058013ebea5af25f2782c","eae2f613783acf722aa15686ae9cc86616d0c109ef12a0dba7f36285a6f04c41","eb06e7e0056f7aaea1d541c10cd22b6a24b82c594462695719dec350b11b1e8b","013bfcfa968ecaf350ba0b13a397d7ce5ca3b2e5bc7a3de21a233ddbc31a0ef7","f434f6505b39091630b6516c3526f46a116cd5e3e145ec17ac3ff606d0f0c25b","462be2b25c889d3ef4832a22a3cac526a43b8c4ba0c5a14a0184e9a9169a3b9f","6ec1137cd5266287ae215c9f802437c3e2d8d498f3cd615850c4a8f373489287","7501ab99c9190ff450f635770321c06f8885011fd1a2933299234600a44a7728","f2570c34fc2fb63e80a17039c7092c2575d188420adb5af6cb7aad5508482e11","649a38eec2d27fc5af4de4629c34842aefea393da9062e6cd1fad5d68e9c96a9","5d0762e7e567b802cc053853c999f32932ee4db0ca92bee7d77e79392aec43d7","e28fc941b1f41a466522459fcf1e8286a471a9424e56fb0f7931e09919c50117"],"paragraph_range_zero_based":[24816,24839],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p24816"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"480 kHz:  L=139, and L=571","paragraph_zero_based":24840},{"literal_text_all_w_t_and_m_t":"960 kHz:  L=139","paragraph_zero_based":24841},{"literal_text_all_w_t_and_m_t":"ra-ContentionResolutionTimer","paragraph_zero_based":24842},{"literal_text_all_w_t_and_m_t":"The initial value for the contention resolution timer (see TS 38.321 [3], clause 5.1.5). Value sf8 corresponds to 8 subframes, value sf16 corresponds to 16 subframes, and so on.","paragraph_zero_based":24843},{"literal_text_all_w_t_and_m_t":"ra-Msg3SizeGroupA","paragraph_zero_based":24844},{"literal_text_all_w_t_and_m_t":"Transport Blocks size threshold in bits below which the UE shall use a contention-based RA preamble of group A. (see TS 38.321 [3], clause 5.1.2).","paragraph_zero_based":24845},{"literal_text_all_w_t_and_m_t":"ra-Prioritization","paragraph_zero_based":24846},{"literal_text_all_w_t_and_m_t":"Parameters which apply for prioritized random access procedure on any UL BWP of SpCell for specific Access Identities (see TS 38.321 [3], clause 5.1.1a).","paragraph_zero_based":24847},{"literal_text_all_w_t_and_m_t":"ra-PrioritizationForAI","paragraph_zero_based":24848},{"literal_text_all_w_t_and_m_t":"Indicates whether the field ra-Prioritization-r16 applies for Access Identities. The first/leftmost bit corresponds to Access Identity 1, the next bit corresponds to Access Identity 2. Value 1 indicates that the field ra-Prioritization-r16 applies otherwise the field does not apply (see TS 23.501 [32]).","paragraph_zero_based":24849},{"literal_text_all_w_t_and_m_t":"ra-PrioritizationForSlicing","paragraph_zero_based":24850},{"literal_text_all_w_t_and_m_t":"Parameters which apply to configure prioritized CBRA 4-step random access type for slicing.","paragraph_zero_based":24851},{"literal_text_all_w_t_and_m_t":"rach-ConfigGeneric","paragraph_zero_based":24852},{"literal_text_all_w_t_and_m_t":"RACH parameters for both regular random access and beam failure recovery.","paragraph_zero_based":24853},{"literal_text_all_w_t_and_m_t":"restrictedSetConfig","paragraph_zero_based":24854},{"literal_text_all_w_t_and_m_t":"Configuration of an unrestricted set or one of two types of restricted sets, see TS 38.211 [16], clause 6.3.3.1.","paragraph_zero_based":24855},{"literal_text_all_w_t_and_m_t":"rsrp-ThresholdSSB","paragraph_zero_based":24856},{"literal_text_all_w_t_and_m_t":"UE may select the SS block and corresponding PRACH resource for path-loss estimation and (re)transmission based on SS blocks that satisfy the threshold (see TS 38.213 [13]).","paragraph_zero_based":24857},{"literal_text_all_w_t_and_m_t":"rsrp-ThresholdSSB-SUL","paragraph_zero_based":24858},{"literal_text_all_w_t_and_m_t":"The UE selects SUL carrier to perform random access based on this threshold (see TS 38.321 [3], clause 5.1.1). The value applies to all the BWPs and all RACH configurations.","paragraph_zero_based":24859},{"literal_text_all_w_t_and_m_t":"ssb-perRACH-OccasionAndCB-PreamblesPerSSB","paragraph_zero_based":24860},{"literal_text_all_w_t_and_m_t":"The meaning of this field is twofold: the CHOICE conveys the information about the number of SSBs per RACH occasion. Value oneEighth corresponds to one SSB associated with 8 RACH occasions, value oneFourth corresponds to one SSB associated with 4 RACH occasions, and so on. The ENUMERATED part indicates the number of Contention Based preambles per SSB. Value n4 corresponds to 4 Contention Based preambles per SSB, value n8 corresponds to 8 Contention Based preambles per SSB, and so on. The total number of CB preambles in a RACH occasion is given by CB-preambles-per-SSB * max(1, SSB-per-rach-occasion). See TS 38.213 [13].","paragraph_zero_based":24861},{"literal_text_all_w_t_and_m_t":"totalNumberOfRA-Preambles","paragraph_zero_based":24862},{"literal_text_all_w_t_and_m_t":"Total number of preambles used for contention based and contention free 4-step or 2-step random access in the RACH resources defined in RACH-ConfigCommon, excluding preambles used for other purposes (e.g. for SI request). If the field is absent, all 64 preambles are available for RA. The setting should be consistent with the setting of ssb-perRACH-OccasionAndCB-PreamblesPerSSB, i.e. it should be a multiple of the number of SSBs per RACH occasion.","paragraph_zero_based":24863}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["29089e62b3ead8647c37a326962ac2ecdaede7efc150286660b385cbd7dcf887","7df29752f5144f0972fcf11cafc1b9352b9eeada1441984bc6730fa7c586f653","8997df9eff198610382a18f839084ee6bff2365b88a0f7fbed1adc3ac3fb1bae","2d6ff5c6894875271241b5cb21d9793048419994945d624d9ba08d6652c2bee7","f0975798ea8b3b202ec57770ef3ec01a1fda6a919a2c324c206bf87e4273b6c9","d3e18dcf291ffdab17ebcad7a950250263b5276e55afcee66856320667af4a06","7227c45650e39defdba464ff6c6427ec730dc614fffdee96840d7d172e2d1c97","768bef661b878d13378df98c4bbaf5fb748d8bd7194b997a3e9e3d37a214b63a","c03412a15c1dae42694352f980beb09fd4642c9436818ec99179f63f813709fc","c71a4aa2dd9742cec76f0dcc00709ac02c991249a970a70456d2c14b0fae2227","b511e33bdf380e25eff0e98eca8fc4cb08584dc96d03361b62e74e1597ff1362","ea1f6c6334f5a5c20fb7396cac6b12ec1efa97533fe4ef4502c2290194fbab6a","ea17a54ab933fd0d5be997f054b60c5af118e84f7308c90d7274b1f61ef441d6","7ee717d57a1a2832a46319d93c4b4d5abd7ed623ec49489203e3a941569242b5","7577a54603517c8effdccd80668a110d8c3678f96740711e9a0d7273a3649f97","a8e07500c8578349fd3c9e829030e6d3890cc6b0edbdde46545d9304c8f3cb87","beb8615b9c62b93dbaa8da344aa0fe3bc37e11edf120bbd3b6957604ae76d437","9397fa18b0c297787a8918b418f9aa87d9ef1aeb241b4c6a4de73ceb740a8c5b","6bf5e2144f257301944153c7f23e7958b9eba05fb1f76ede71614572edfaa3d2","d9e5a3a4e5f4e2a1c8c3a213639446065a05353e966d915dc0e2bc51e07b6532","b9a04c9f47140fc27c2933130cb5cce60e6aff302e0b30ab0d9d2fc27dec5d9e","3bcc1cca29e2023ca910c2d4290464c5e6bec43e1ba3ea5fa721e6afd3e0ec7b","0e55e927de31ae6cd6400ec7628cb3225be7ea85943beaade03fc06918bc1fad","4a6950c757f47ea21b79a470a8a219ac445ba28a912f8d844cf8aec8d8afca8a"],"paragraph_range_zero_based":[24840,24863],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p24840"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24864},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":24865},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":24866},{"literal_text_all_w_t_and_m_t":"AdditionalRACH","paragraph_zero_based":24867},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the RACH-ConfigCommon is included in an AdditionalRACH-Config. When included in initialUplinkBWP-RedCap to indicate other feature(s) than redcap, this field is mandatory present with at least two FeatureCombinationPreambles list entries: one list entry indicating only redcap and the other(s) indicating both redcap and one or multiple other feature(s) (e.g. smallData, nsag or msg3-Repetitions).","paragraph_zero_based":24868},{"literal_text_all_w_t_and_m_t":"Otherwise, it is optional, Need R.","paragraph_zero_based":24869},{"literal_text_all_w_t_and_m_t":"InitialBWP-Only","paragraph_zero_based":24870},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, if this BWP is the initial BWP of SpCell. Otherwise, the field is absent.","paragraph_zero_based":24871},{"literal_text_all_w_t_and_m_t":"L139","paragraph_zero_based":24872},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if prach-RootSequenceIndex L=139, otherwise the field is absent, Need S.","paragraph_zero_based":24873},{"literal_text_all_w_t_and_m_t":"SUL","paragraph_zero_based":24874},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in rach-ConfigCommon in initialUplinkBWP if supplementaryUplink is configured in ServingCellConfigCommonSIB or if supplementaryUplinkConfig is configured in ServingCellConfigCommon; otherwise, the field is absent. This field is not configured in additionalRACH-Config.","paragraph_zero_based":24875},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24876},{"literal_text_all_w_t_and_m_t":"–RACH-ConfigCommonTwoStepRA","paragraph_zero_based":24877},{"literal_text_all_w_t_and_m_t":"The IE RACH-ConfigCommonTwoStepRA is used to specify cell specific 2-step random-access type parameters.","paragraph_zero_based":24878},{"literal_text_all_w_t_and_m_t":"RACH-ConfigCommonTwoStepRA information element","paragraph_zero_based":24879},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":24880},{"literal_text_all_w_t_and_m_t":"-- TAG-RACH-CONFIGCOMMONTWOSTEPRA-START","paragraph_zero_based":24881},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24882},{"literal_text_all_w_t_and_m_t":"RACH-ConfigCommonTwoStepRA-r16 ::=                   SEQUENCE {","paragraph_zero_based":24883},{"literal_text_all_w_t_and_m_t":"    rach-ConfigGenericTwoStepRA-r16                      RACH-ConfigGenericTwoStepRA-r16,","paragraph_zero_based":24884},{"literal_text_all_w_t_and_m_t":"    msgA-TotalNumberOfRA-Preambles-r16                   INTEGER (1..63)                                    OPTIONAL, -- Need S","paragraph_zero_based":24885},{"literal_text_all_w_t_and_m_t":"    msgA-SSB-PerRACH-OccasionAndCB-PreamblesPerSSB-r16   CHOICE {","paragraph_zero_based":24886},{"literal_text_all_w_t_and_m_t":"        oneEighth                                            ENUMERATED {n4,n8,n12,n16,n20,n24,n28,n32,n36,n40,n44,n48,n52,n56,n60,n64},","paragraph_zero_based":24887}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["ee30ed7b6f9e32dcb23644dc4f5b1a322e1ae95cbbaf68f5b9b99b0cbe41b3d8","939978bc53ca9569f0462e99c0f16e1f190042a382b0994288c13a4a9bb13e22","cb2d809796fb4426bdd27f565284edf3fb6