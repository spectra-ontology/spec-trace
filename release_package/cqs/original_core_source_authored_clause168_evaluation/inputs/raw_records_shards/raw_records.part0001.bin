{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18912},{"literal_text_all_w_t_and_m_t":"–HysteresisAltitude","paragraph_zero_based":18913},{"literal_text_all_w_t_and_m_t":"The IE HysteresisAltitude is a parameter used within the entry and leave condition of an altitude-based event triggered reporting condition and within altitude range based parameter configuration. The actual value is field value in meters.","paragraph_zero_based":18914},{"literal_text_all_w_t_and_m_t":"HysteresisAltitude information element","paragraph_zero_based":18915},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18916},{"literal_text_all_w_t_and_m_t":"-- TAG-HYSTERESISALTITUDE-START","paragraph_zero_based":18917},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18918},{"literal_text_all_w_t_and_m_t":"HysteresisAltitude-r18 ::=                      INTEGER (0..64)","paragraph_zero_based":18919},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18920},{"literal_text_all_w_t_and_m_t":"-- TAG-HYSTERESISALTITUDE-STOP","paragraph_zero_based":18921},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18922},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18923},{"literal_text_all_w_t_and_m_t":"–HysteresisLocation","paragraph_zero_based":18924},{"literal_text_all_w_t_and_m_t":"The IE HysteresisLocation is a parameter used within entry and leave condition of a location based event triggered reporting condition. The actual value is field value * 10 meters.","paragraph_zero_based":18925},{"literal_text_all_w_t_and_m_t":"HysteresisLocation information element","paragraph_zero_based":18926},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18927},{"literal_text_all_w_t_and_m_t":"-- TAG-HYSTERESISLOCATION-START","paragraph_zero_based":18928},{"literal_t