{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"E-UTRA capabilities","paragraph_zero_based":42864},{"literal_text_all_w_t_and_m_t":"MR-DC capabilities","paragraph_zero_based":42865},{"literal_text_all_w_t_and_m_t":"UTRA capabilities","paragraph_zero_based":42866},{"literal_text_all_w_t_and_m_t":"NR","paragraph_zero_based":42867},{"literal_text_all_w_t_and_m_t":"May be included if UE Radio Capability ID as specified in 23.502 [43] is used for the UE. Included otherwise.","paragraph_zero_based":42868},{"literal_text_all_w_t_and_m_t":"May be included","paragraph_zero_based":42869},{"literal_text_all_w_t_and_m_t":"May be included","paragraph_zero_based":42870},{"literal_text_all_w_t_and_m_t":"May be included, ignored by gNB if received","paragraph_zero_based":42871},{"literal_text_all_w_t_and_m_t":"E-UTRAN","paragraph_zero_based":42872},{"literal_text_all_w_t_and_m_t":"May be included if UE Radio Capability ID as specified in 23.502 [43] is used for the UE. Included otherwise.","paragraph_zero_based":42873},{"literal_text_all_w_t_and_m_t":"May be included","paragraph_zero_based":42874},{"literal_text_all_w_t_and_m_t":"May be included","paragraph_zero_based":42875},{"literal_text_all_w_t_and_m_t":"May be included, ignored by gNB if received","paragraph_zero_based":42876},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42877},{"literal_text_all_w_t_and_m_t":"NOTE 2:The following table indicates, in case of inter-RAT handover from E-UTRA, which additional IEs are included or not:","paragraph_zero_based":42878},{"literal_text_all_w_t_and_m_t":"Source system","paragraph_zero_based":42879},{"literal_text_all_w_t_and_m_t":"sourceConfig","paragraph_zero_based":42880},{"literal_text_all_w_t_and_m_t":"rrm-Config","paragraph_zero_based":42881},{"literal_text_all_w_t_and_m_t":"as-Context","paragraph_zero_based":42882},