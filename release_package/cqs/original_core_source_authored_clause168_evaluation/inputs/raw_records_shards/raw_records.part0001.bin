{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"DownlinkConfigCommon information element","paragraph_zero_based":18048},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18049},{"literal_text_all_w_t_and_m_t":"-- TAG-DOWNLINKCONFIGCOMMON-START","paragraph_zero_based":18050},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18051},{"literal_text_all_w_t_and_m_t":"DownlinkConfigCommon ::=        SEQUENCE {","paragraph_zero_based":18052},{"literal_text_all_w_t_and_m_t":"    frequencyInfoDL                 FrequencyInfoDL                                 OPTIONAL,   -- Cond InterFreqHOAndServCellAdd","paragraph_zero_based":18053},{"literal_text_all_w_t_and_m_t":"    initialDownlinkBWP              BWP-DownlinkCommon                              OPTIONAL,   -- Cond ServCellAdd","paragraph_zero_based":18054},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":18055},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":18056},{"literal_text_all_w_t_and_m_t":"    initialDownlinkBWP-RedCap-r17   BWP-DownlinkCommon                              OPTIONAL    -- Need R","paragraph_zero_based":18057},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18058},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":18059},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18060},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18061},{"literal_text_all_w_t_and_m_t":"-- TAG-DOWNLINKCONFIGCOMMON-STOP","paragraph_zero_based":18062},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18063},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18064},{"literal_text_all_w_t_and_m_t":"DownlinkConfigCommon field descriptions","paragraph_zero_based":18065},{"literal_text_all_w_t_and_m_t":"frequencyInfoDL","paragraph_zero_based":18066},{"literal_text_all_w_t_and_m_t":"Basic parameters of a downlink carrier and transmission thereon.","paragraph_zero_based":18067},{"literal_text_all_w_t_and_m_t":"initialDownlinkBWP","paragraph_zero_based":18068},{"literal_text_all_w_t_and_m_t":"The initial downlink BWP configuration for a serving cell. The network configures the locationAndBandwidth so that the initial downlink BWP contains the entire CORESET#0 of this serving cell in the frequency domain.","paragraph_zero_based":18069},{"literal_text_all_w_t_and_m_t":"initialDownlinkBWP-RedCap","paragraph_zero_based":18070},{"literal_text_all_w_t_and_m_t":"If present, RedCap UEs use this DL BWP instead of initialDownlinkBWP.","paragraph_zero_based":18071}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["33da2eb7915fdc01c8715d34c8d000460bd28583e70c61943cbe8df868842af4","ecd5f0e0dac3314fbb21813ee0c96b34b632e3e3b0667b49228e2ac2e570c4ce","8a4f9c0105653dc9523534b5db15b5f9f10538a29aeadaa9d640a2dbd594032e","397b9e65995eb0f84aa56893d211c9e56894dbc5216bf85ef0dec84a7bcb86c3","f7e0df04fca56c3d47f75c5da9bc8053b9404860206e02d6805455952a0f9487","508c4d20d7c777308bdac7ecafb87177a54c8151f62a6c47b5ec456a8337d4f8","3c2fe8e7f87952bef7397ba619de595392198e48eb7294d8e803f2a150eb2424","ab3de737a513884bf8cff635c19bc5d27feb03806c935162d3ef2c87abf114b6","856f17e5518a0b41ab45de58370eba20666762e8e9ceb902d751b041d55d6ecd","0683b54b3a227b464ad4b2bb350a1274c493106db5955ff20f8bfa8aef6d5564","c4a2ed3d7a1f17d1b9000064cbd02e518d986dfc1175c8a94040c55291fdb78c","9b3578ce91f6e69aae689d32eefbd6b56cf468e87ebbbfb769e630e1bc3528c4","43f2cd3bf8efb122b86c613d7673d84383dadcdfc1652dd7aba79fbf1313d8f4","fa1c1b73b4c50d76ad68cfea86171180e2daf7ee186418be1cca79b578229377","cd