{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":17472},{"literal_text_all_w_t_and_m_t":"        csi-IM-ResourceSetList      SEQUENCE (SIZE (1..maxNrofCSI-IM-ResourceSetsPerConfig)) OF CSI-IM-ResourceSetId","paragraph_zero_based":17473},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":17474},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17475},{"literal_text_all_w_t_and_m_t":"    bwp-Id                      BWP-Id,","paragraph_zero_based":17476},{"literal_text_all_w_t_and_m_t":"    resourceType                ENUMERATED { aperiodic, semiPersistent, periodic },","paragraph_zero_based":17477},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":17478},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":17479},{"literal_text_all_w_t_and_m_t":"    csi-SSB-ResourceSetListExt-r17      CSI-SSB-ResourceSetId                                                  OPTIONAL  -- Need R","paragraph_zero_based":17480},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":17481},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":17482},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17483},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-RESOURCECONFIG-STOP","paragraph_zero_based":17484},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17485},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17486},{"literal_text_all_w_t_and_m_t":"CSI-ResourceConfig field descriptions","paragraph_zero_based":17487},{"literal_text_all_w_t_and_m_t":"bwp-Id","paragraph_zero_based":17488},{"literal_text_all_w_t_and_m_t":"The DL BWP which the CSI-RS associated with this CSI-ResourceConfig are located in (see TS 38.214 [19], clause 5.2.1.2.","paragraph_zero_based":17489},{"literal_text_all_w_t_and_m_t":"csi-IM-ResourceSetList","paragraph_zero_based":17490},{"literal_text_all_w_t_and_m_t":"List of references to CSI-IM resources used for CSI measurement and reporting in a CSI-RS resource set. Contains up to maxNrofCSI-IM-ResourceSetsPerConfig resource sets if resourceType is 'aperiodic' and 1 otherwise (see TS 38.214 [19], clause 5.2.1.2).","paragraph_zero_based":17491},{"literal_text_all_w_t_and_m_t":"csi-ResourceConfigId","paragraph_zero_based":17492},{"literal_text_all_w_t_and_m_t":"Used in CSI-ReportConfig to refer to an instance of CSI-ResourceConfig.","paragraph_zero_based":17493},{"literal_text_all_w_t_and_m_t":"csi-SSB-ResourceSetList, csi-SSB-ResourceSetListExt","paragraph_zero_based":17494},{"literal_text_all_w_t_and_m_t":"List of references to SSB resources used for CSI measurement and reporting in a CSI-RS resource set (see TS 38.214 [19], clause 5.2.1.2). The csi-SSB-ResourceSetListExt provides additional references and can only be configured if csi-SSB-ResourceSetList is configured and groupBasedBeamReporting-v1710 is configured in the CSI-ReportConfig that indicates this CSI-ResourceConfig as resourcesForChannelMeasurement. If groupBasedBeamReporting-v1710 is configured in the IE CSI-ReportConfig that indicates this CSI-ResourceConfig as resourceForChannelMeasurement, the network configures 2 resource sets, which may be two CSI SSB resource sets (see TS 38.214 [19], clause 5.2.1.2 and 5.2.1.4.2). In this case, in TS 38.212 [17] Table 6.3.1.1.2-8B, the first resource set is indicated by a resource set indicator set to 0 and the second resource set by a resource set indicator set to 1.","paragraph_zero_based":17495}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["d49789f0c8785644383e3cf6162a9b1e9173c57201f45e05dd7e257b6ba2b63c","10350bca80ec9e50b1da42c4172c0c34e5b39d7d0022e0807ba78eee6af988a5","3be0fd4263274555bb558f256c04df747118cfb77fa3f4a128ebf85101e70caa","b11e81c88dca9616611227fab08e1aeb636d746641132a61b78da6d309cee2c4","79180ecd5cc256a84de6b62bfa0e4ae5179168c295be9cd2e6753e78a76a1fd2","3da0884ee89394a2cabdd407ef7e6a3422492fbfa3d41b9cfb55c575ce379761","cd7da97752a75bd619333f85d3570a2fe951e3ea8736f9b98f553c6e82841474","d080f9909ea54152f8ef7885200e7d4780bfb691afcf96b782ea4b92942a273f","1d135658efa155982d0070768a2ecbe5e1954c0ee4fc28b919eeb21fe41f5e02","be65a0be7f28b9dcebba5c40884853ccfe39678919fc04277b3a09b86679ee71","0dd896aeefaee596d8bcb00b0b7b8b87dc974889d21968fcec18f28c9de48e67","8a92976c177001cbb097bc27ee1a44c73f08b853d072ccb45e3d62098ff1907f","5aa45fdb4e5f1b970ea5078664911b90d06a31fdf07aa319941da70ea1c5aca5","b2996b86e8f23fd0b461e239a36366ce3aae391f94e4dec6fbf73f78da37e664","c33db94644f4a0a5efcd0125d411cc6159d0bf340c98ebbc4afad1f68f02467f","eb4e68e188105e4822100a0472c99113ae1171f134078f8fc397faa9d90d7784","c8491f56c21608f65757af165fb205b602846124e33c83568d834699dbe2d6fa","62394c7e6ffe0bcf976e6e76939afad89fbda44f62921a1fac15844bbdfbf33a","ead64df69c2b3676d9974e03b64586632cbe353c712bc65e16189bd1bfafc1d8","57dea269855e416669537c2cb88df3856a3c30176b2748b291b68e9cb0d32c5a","ba86880e0eda7b280219cc0daa48d15859c544de086b6e03a84c2747d487d2f7","a8ac414ea8b5db83aa35cf357c59b8ff05e403bfcc07d6df47866517d2867d78","5ae22a0f95abebc9d3754c232fdc5321109adc6f7531d6733e0f54c3a68fce34","472498940ca883a252e27846e14d79ffee8e1e6f080ec5ff256eece359bf81ae"],"paragraph_range_zero_based":[17472,17495],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p17472"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"nzp-CSI-RS-ResourceSetList","paragraph_zero_based":17496},{"literal_text_all_w_t_and_m_t":"List of references to NZP CSI-RS resources used for beam measurement and reporting in a CSI-RS resource set.","paragraph_zero_based":17497},{"literal_text_all_w_t_and_m_t":"If resourceType is set to 'aperiodic', the network configures up to maxNrofNZP-CSI-RS-ResourceSetsPerConfig resource sets. If resourceType is is set to 'periodic' or 'semiPersistent' and groupBasedBeamReporting-v1710 is not configured in IE CSI-ReportConfig, the network configures 1 resource set. If resourceType is set to 'periodic' or 'semiPersistent' and groupBasedBeamReporting-v1710 is configured, the network configures 2 resource sets, which may be two NZP CSI-RS resource sets (see TS 38.214 [19], clause 5.2.1.2 and 5.2.1.4.2). In this case, in TS 38.212 [17] Table 6.3.1.1.2-8B, the first resource set is indicated by a resource set indicator set to 0 and the second resource set by a resource set indicator set to 1.","paragraph_zero_based":17498},{"literal_text_all_w_t_and_m_t":"resourceType","paragraph_zero_based":17499},{"literal_text_all_w_t_and_m_t":"Time domain behavior of resource configuration (see TS 38.214 [19], clause 5.2.1.2). It does not apply to resources provided in the csi-SSB-ResourceSetList.","paragraph_zero_based":17500},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17501},{"literal_text_all_w_t_and_m_t":"–CSI-ResourceConfigId","paragraph_zero_based":17502},{"literal_text_all_w_t_and_m_t":"The IE CSI-ResourceConfigId is used to identify a CSI-ResourceConfig.","paragraph_zero_based":17503},{"literal_text_all_w_t_and_m_t":"CSI-ResourceConfigId information element","paragraph_zero_based":17504},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17505},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-RESOURCECONFIGID-START","paragraph_zero_based":17506},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17507},{"literal_text_all_w_t_and_m_t":"CSI-ResourceConfigId ::=            INTEGER (0..maxNrofCSI-ResourceConfigurations-1)","paragraph_zero_based":17508},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17509},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-RESOURCECONFIGID-STOP","paragraph_zero_based":17510},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17511},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17512},{"literal_text_all_w_t_and_m_t":"–CSI-ResourcePeriodicityAndOffset","paragraph_zero_based":17513},{"literal_text_all_w_t_and_m_t":"The IE CSI-ResourcePeriodicityAndOffset is used to configure a periodicity and a corresponding offset for periodic and semi-persistent CSI resources, and for periodic and semi-persistent reporting on PUCCH. both, the periodicity and the offset are given in number of slots. The periodicity value slots4 corresponds to 4 slots, value slots5 corresponds to 5 slots, and so on.","paragraph_zero_based":17514},{"literal_text_all_w_t_and_m_t":"CSI-ResourcePeriodicityAndOffset information element","paragraph_zero_based":17515},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17516},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-RESOURCEPERIODICITYANDOFFSET-START","paragraph_zero_based":17517},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17518},{"literal_text_all_w_t_and_m_t":"CSI-ResourcePeriodicityAndOffset ::=    CHOICE {","paragraph_zero_based":17519}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["b2f837cec377f517681f4eac7e0d4