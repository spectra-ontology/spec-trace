{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43080},{"literal_text_all_w_t_and_m_t":"CandidateCellInfoListCPC-r17 ::= SEQUENCE (SIZE (1..maxFreq)) OF CandidateCellInfo-r17","paragraph_zero_based":43081},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43082},{"literal_text_all_w_t_and_m_t":"CandidateCellInfo-r17 ::=        SEQUENCE {","paragraph_zero_based":43083},{"literal_text_all_w_t_and_m_t":"    ssbFrequency-r17                 ARFCN-ValueNR,","paragraph_zero_based":43084},{"literal_text_all_w_t_and_m_t":"    candidateList-r17                SEQUENCE (SIZE (1..maxNrofCondCells-r16)) OF CandidateCell-r17","paragraph_zero_based":43085},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":43086},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43087},{"literal_text_all_w_t_and_m_t":"CandidateCell-r17 ::=            SEQUENCE {","paragraph_zero_based":43088},{"literal_text_all_w_t_and_m_t":"    physCellId-r17                   PhysCellId,","paragraph_zero_based":43089},{"literal_text_all_w_t_and_m_t":"    condExecutionCondSCG-r17         OCTET STRING (CONTAINING CondReconfigExecCondSCG-r17)               OPTIONAL","paragraph_zero_based":43090},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":43091},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43092},{"literal_text_all_w_t_and_m_t":"-- TAG-CG-CONFIG-STOP","paragraph_zero_based":43093},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":43094},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43095},{"literal_text_all_w_t_and_m_t":"CG-Config field descriptions","paragraph_zero_based":43096},{"literal_text_all_w_t_and_m_t":"candidateCellInfoListCPC","paragraph_zero_based":43097},{"literal_text_all_w_t_and_m_t":"Contains information regarding candidate target cells for Conditional PSCell Change (CPC) that the source secondary gNB suggests the target secondary gNB to consider configuring for CPC.","paragraph_zero_based":43098},{"literal_text_all_w_t_and_m_t":"candidateCellInfoListSN","paragraph_zero_based":43099},{"literal_text_all_w_t_and_m_t":"Contains information regarding cells that the source secondary node suggests the target secondary gNB to consider configuring.","paragraph_zero_based":43100},{"literal_text_all_w_t_and_m_t":"candidateCellInfoListSN-EUTRA","paragraph_zero_based":43101},{"literal_text_all_w_t_and_m_t":"Includes the MeasResultList3EUTRA as specified in TS 36.331 [10]. Contains information regarding cells that the source secondary node suggests the target secondary eNB to consider configuring. This field is only used in NE-DC.","paragraph_zero_based":43102},{"literal_text_all_w_t_and_m_t":"candidateServingFreqListNR, candidateServingFreqListEUTRA","paragraph_zero_based":43103}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["b06016c902246d3d1d423da04ccc229c126f243985b25ff4f0f307b9c3950538","b9d07c1c706f3aaae6026949741666e42600025ca0185417c19e8618d0441654","30f9e40b6189a1c30b178ce68db52f6452ecb6717dd1dd412eabb175781547f9","7d420dc3d68fe08e5063bd806005fc8272b0010571a939b482102f7edf794a7d","96530c138240d19968ced40f8ad9698fd4193b74a99ca2ba659de5dddab9ec66","157660ca5b212ae559f339fee76dfeb83b3acf2d58fb7904168d965b5f984d3d","7f2203715df7f585920a42494934a011f8043a67a12c7e51fbb6f2c804def939","1957fc430625113c15a7148b310d018d4a95f14297ca4ab3586c62cb64a42492","45e4f97450caa449af7acf7580c7e5557c1bd70bb2ecb3f90e528b30c358beca","7c7f4fc8df4fd2d31302e45a6cd6be5af9d1bbd8ce01b564f74a6b3906e9fb38","77d6a6f7cae1210a665c454d3c8781c350ad9428c57f79c3c3069c77c43b796b","4ce8230385625b5b722a3c8e042d7867244f0c08e40a91a02332fadda92999a6","82ba494e3f74c2fcf6b9ead1cffcb7f873b86f9bbd80833d141f70b277470ae8","80d61e57c46669887aaf92d42f116f1b62b00f3ca739c7c3f4ed9d45426931a4","f0c203871a21b313109089bfcb838068155ef68f03d41884c873f6b590181ba0","2779ed7be5e3124049028a73b4f03af05849ca0665ee54750f015bf64df5bbe9","96a6472483b8bce1eeeaac18163d7530499333721d726f46f44874f394931325","cb81aab89c7e2f07554221e5423dd8dfd4f47ebc665a96db7b69a627c5f624fc","6a498633b8de63134049270789d59ec08aef80a29d175b3d074080b63dbcfae1","8f8738373f684fd579733a788c7cbb93e632bd1b43bbf6486c2887183035e521","94501dff6f97828a3ed3df81704bbdcaeb55f00a73494052a37406352903c08c","11924076dba9f8656132019a3c840f1e5d8d8950eecf08d1500cdbd5b7134527","a6dcbe8d5adb7028ebb68943231c1967bab01a7466e8d7004c1bb1b338c6aae1","8ef84265bf718b360e601cde7303b0efcafb06c771f50a60bf4aa90a01289260"],"paragraph_range_zero_based":[43080,43103],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p43080"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates frequencies of candidate serving cells for In-Device Co-existence Indication (see TS 36.331 [10]).","paragraph_zero_based":43104},{"literal_text_all_w_t_and_m_t":"configRestrictModReq","paragraph_zero_based":43105},{"literal_text_all_w_t_and_m_t":"Used by SN to request changes to SCG configuration restrictions previously set by MN to ensure UE capabilities are respected. E.g. can be used to request configuring an NR band combination whose use MN has previously forbidden. SN only includes this field in SN-initiated procedures.","paragraph_zero_based":43106},{"literal_text_all_w_t_and_m_t":"drx-ConfigSCG","paragraph_zero_based":43107},{"literal_text_all_w_t_and_m_t":"This field contains the complete DRX configuration of the SCG. This field is only used in NR-DC.","paragraph_zero_based":43108},{"literal_text_all_w_t_and_m_t":"drx-InfoSCG","paragraph_zero_based":43109},{"literal_text_all_w_t_and_m_t":"This field contains the DRX long and short cycle configuration of the SCG. This field is used in (NG)EN-DC and NE-DC.","paragraph_zero_based":43110},{"literal_text_all_w_t_and_m_t":"drx-InfoSCG2","paragraph_zero_based":43111},{"literal_text_all_w_t_and_m_t":"This field contains the drx-onDurationTimer configuration of the SCG. This field is only used in (NG)EN-DC.","paragraph_zero_based":43112},{"literal_text_all_w_t_and_m_t":"fr-InfoListSCG","paragraph_zero_based":43113},{"literal_text_all_w_t_and_m_t":"Contains information of FR information of serving cells that include PScell and SCells configured in SCG.","paragraph_zero_based":43114},{"literal_text_all_w_t_and_m_t":"fr1-Carriers-SCG, fr2-Carriers-SCG","paragraph_zero_based":43115},{"literal_text_all_w_t_and_m_t":"Indicates the number of FR1 or FR2 serving cells configured in SCG.","paragraph_zero_based":43116},{"literal_text_all_w_t_and_m_t":"measuredFrequenciesSN","paragraph_zero_based":43117},{"literal_text_all_w_t_and_m_t":"Used by SN to indicate a list of frequencies measured by the UE.","paragraph_zero_based":43118},{"literal_text_all_w_t_and_m_t":"needForGaps","paragraph_zero_based":43119},{"literal_text_all_w_t_and_m_t":"In NE-DC, indicates whether the SN requests gNB to configure measurements gaps.","paragraph_zero_based":43120},{"literal_text_all_w_t_and_m_t":"ph-InfoSCG","paragraph_zero_based":43121},{"literal_text_all_w_t_and_m_t":"Power headroom information in SCG that is needed in the reception of PHR MAC CE of MCG","paragraph_zero_based":43122},{"literal_text_all_w_t_and_m_t":"ph-SupplementaryUplink","paragraph_zero_based":43123},{"literal_text_all_w_t_and_m_t":"Power headroom information for supplementary uplink. In the case of (NG)EN-DC and NR-DC, this field is only present when two UL carriers are configured for a serving cell and one UL carrier reports type1 PH while the other reports type 3 PH.","paragraph_zero_based":43124},{"literal_text_all_w_t_and_m_t":"ph-Type1or3","paragraph_zero_based":43125},{"literal_text_all_w_t_and_m_t":"Type of power headroom for a certain serving cell in SCG (PSCell and activated SCells). Value type1 refers to type 1 power headroom, value type3 refers to type 3 power headroom. (See TS 38.321 [3]).","paragraph_zero_based":43126},{"literal_text_all_w_t_and_m_t":"ph-Uplink","paragraph_zero_based":43127}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["c8b3b52f7d26873573a7df30641af011df0a00164a683a74a4984c5262b92429","4a18b52534b9a514eb3ce1f47427ebc93db7884dba346aebc7d18f4ff710a022","3bf94b620705029f862f85663afd977124f7ea2270ccd9282ce8a0cec7dbc021","20f91438ba7540ec6454bfdb5daa5baa6237b09dc3a8a2eada38b9c7b50737b5","4399db65f09185e3d355d7d49093eb1fdb118a05016dbb749fdf7b4c71c489de","bf547cfbd4b7c6c23ea0ed0660214f9ca4503b1e88f21fb51b11aa63e8dac57e","27b3658d102a3b83ab70b238d4e1b60091a0db1f63bbec9f633ade6a98cc664d","b0e13be0fd33324ed0670832195d69aa073969912362f4378fc94b191db6119f","a6261fa6a38ca009ec1eeac849b4b130379910cb21813cb96425e4afc81c1eb1","dec56f3b232811529b1bb41a96a15fec9f6233bd899e452fa87df1b958ef1f6d","fd1f6c84316e2c82c97bd8586612805b36ba27c378fd7e1461fc580546e33af0","b1a6ded5baebbff5c92f2e4adccfea6f4ddb4aafbbb354c047f3d56b752b83ac","cdaa34dfffb542f2b0e733b5c4ada5278b3638cf1befe7182544b5659c77d538","5574a3675d18b315410dc8b31384524df8b15418ef599a477f065de5511faeae","518542151f8f3b559ecf3d54ff30342859efc9a93064c8409edb412d610e7eb3","91007fe91f2997b0f445d4ae7f14987e8e0333724886f5c93ce1880778ab418e","a870eb709a48a57ed342ab16400568ff2e6dcc0918f610a8d74bd79e66680708","4dea6bc37ee144909131a4aa33643d7e4a44e81edbf7eb22dae87bb736889d35","99adbf715bc5e4584807135b3be30b2ebac7c9488eb4b7b7c21ac0e0320a8f6f","d1c3be82a0cc939dca599a20bf4dc3873de9706102c81f90680382444622cdb5","8cc7528e92cea7dd71131608c242a9a58bacd104d860ccba96c483f56f7a5c4c","338a76a683ea060565b0674d03f21d56df6072d86fb978d348d094cfd9e6a366","8e6e4875b10e739957ac7a0fe321e7baeb4c46a79c255fa986abd79a61336142","89f21ec143a63167ac586cfaecff4af8e153731b29b5b9c06027644ac4043da2"],"paragraph_range_zero_based":[43104,43127],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p43104"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Power headroom information for uplink.","paragraph_zero_based":43128},{"literal_text_all_w_t_and_m_t":"pSCellFrequency, pSCellFrequencyEUTRA","paragraph_zero_based":43129},{"literal_text_all_w_t_and_m_t":"Indicates the frequency of PSCell in NR (i.e., pSCellFrequency) or E-UTRA (i.e., pSCellFrequencyEUTRA). In this version of the specification, pSCellFrequency is not used in NE-DC whereas pSCellFrequencyEUTRA is only used in NE-DC. pSCellFrequency indicates the absoluteFrequencySSB.","paragraph_zero_based":43130},{"literal_text_all_w_t_and_m_t":"reportCGI-RequestNR, reportCGI-RequestEUTRA","paragraph_zero_based":43131},{"literal_text_all_w_t_and_m_t":"Used by SN to indicate to MN about configuring reportCGI procedure. The request may optionally contain information about the cell for which SN intends to configure reportCGI procedure. In this version of the specification, the reportCGI-RequestNR is used in (NG)EN-DC and NR-DC whereas reportCGI-RequestEUTRA is used only for NE-DC.","paragraph_zero_based":43132},{"literal_text_all_w_t_and_m_t":"requestedBC-MRDC","paragraph_zero_based":43133},{"literal_text_all_w_t_and_m_t":"Used to request configuring a band combination and corresponding feature sets which are forbidden to use by MN (i.e. outside of the allowedBC-ListMRDC) to allow re-negotiation of the UE capabilities for SCG configuration.","paragraph_zero_based":43134},{"literal_text_all_w_t_and_m_t":"reservedResourceConfigNRDC","paragraph_zero_based":43135},{"literal_text_all_w_t_and_m_t":"Used to request or indicate the maximum number of resources reserved for the SCG. This field is only used in NR-DC.","paragraph_zero_based":43136},{"literal_text_all_w_t_and_m_t":"requestedMaxInterFreqMeasIdSCG","paragraph_zero_based":43137},{"literal_text_all_w_t_and_m_t":"Used to request the maximum number of allowed measurement identities to configure for inter-frequency measurement. This field is only used in NR-DC.","paragraph_zero_based":43138},{"literal_text_all_w_t_and_m_t":"requestedMaxIntraFreqMeasIdSCG","paragraph_zero_based":43139},{"literal_text_all_w_t_and_m_t":"Used to request the maximum number of allowed measurement identities to configure for intra-frequency measurement on each serving frequency.","paragraph_zero_based":43140},{"literal_text_all_w_t_and_m_t":"requestedPDCCH-BlindDetectionSCG","paragraph_zero_based":43141},{"literal_text_all_w_t_and_m_t":"Requested value of the reference number of cells for PDCCH blind detection allowed to be configured for the SCG.","paragraph_zero_based":43142},{"literal_text_all_w_t_and_m_t":"requestedP-MaxEUTRA","paragraph_zero_based":43143},{"literal_text_all_w_t_and_m_t":"Requested value for the maximum power for the serving cells the UE can use in E-UTRA SCG. This field is only used in NE-DC.","paragraph_zero_based":43144},{"literal_text_all_w_t_and_m_t":"requestedP-MaxFR1","paragraph_zero_based":43145},{"literal_text_all_w_t_and_m_t":"Requested value for the maximum power for the serving cells on frequency range 1 (FR1) in this secondary cell group (see TS 38.104 [12]) the UE can use in NR SCG.","paragraph_zero_based":43146},{"literal_text_all_w_t_and_m_t":"requestedP-MaxFR2","paragraph_zero_based":43147},{"literal_text_all_w_t_and_m_t":"Requested value for the maximum power for the serving cells on frequency range 2 (FR2) in this secondary cell group the UE can use in NR SCG. This field is only used in NR-DC.","paragraph_zero_based":43148},{"literal_text_all_w_t_and_m_t":"requestedToffset","paragraph_zero_based":43149},{"literal_text_all_w_t_and_m_t":"Requests the new value for the time offset restriction used by the SN for scheduling SCG transmissions (i.e. Tproc,SCGmax,  see TS 38.213 [13]). This field is used in NR-DC only when the fields nrdc-PC-mode-FR1-r16 or nrdc-PC-mode-FR2-r16 are set to dynamic. Value ms0dot5 corresponds to 0.5 ms, value ms0dot75 corresponds to 0.75 ms, value ms1 corresponds to 1ms and so on.","paragraph_zero_based":43150},{"literal_text_all_w_t_and_m_t":"scellFrequenciesSN-EUTRA, scellFrequenciesSN-NR","paragraph_zero_based":43151}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["3d849d6b16397fcd76ab775fdb4c320659d55a5015905354d7be6a5b5fabdcb0","5f741aa7f1601ec599340fc85bc898da591e34433c4f2137f0b10d45fcd13584","164e1f20a4cc97933eab3eed715a08edb27d36d4f8b8c015495e39013363a315","518d001baebd91003920e6a19e6f0193953f7d4965ec10aeae25be8781542dca","edf621c25a8ac73b8944a928e390b5bc819de0a99b7ea3e77b258ea5bf5d64e7","98e126e54797c4f4d45e45549c4ebfc0ad92c953c41602be27526415c22ee155","16ec2e21d1e3e5e3f70c6e241ac8403b88c9b6ef5de46c073bbc8e3148636b2b","bd58f93e62588ea9e0c374d201d6ccf246b786f54f95802b042213b575070566","d12b188db56e9d6504aaca405b17eef463418664ab12dc035ab46df7a25e533c","3e0da19d0ab27ad2f3d212db87902df991b23e4ceeab44fa2a9fe5bf3a66d4ed","6f8f4845ab49418eb890b052089d61e4729b31a66ab1ad51a65812ead264ddb4","1511aad454adeafa3f87693bcaef82382cd8f5d981942d9c7d12afb61c797590","325a6c90b9a1e3d6ad3bf76f905dbeb33033c824bd7423de624e247005faa5ff","a442d589c90086484901bfb779bcb71f6d035e2f16ead2895ad0ba8d43724514","46d038eee36e1090f0cc66dadaf426bbc72842ca09a4638bcb6173fe6a6b3896","aed18b3e7d407143aae119f15f2808ca5f8544bf140d52ff1e411cf241ce8081","0e1cabce7fe0caa8efdf11ef56c07ecd6fdd1114d127d2473a3d0bb08c69ea61","1b15ffd4713c6b3298ea728190c1ce4de79140ef0575d49f7e1f8e00c7e5a6e2","60cd2ecd1fd83cfa92693db9ab2141558f673b578610ba1452c980dabb9e543e","c5e35d7b7e929188aaa7373f5334fed5d59b10a0d006cc5770e7b7e81b58afd8","9b8503d05c21e6416c40c5b96dd35930c907f709504721731319b500052972ae","8836f7b50516cec78b9404e290b1010c34406e412eb8cd42c3c338e50975ed6a","3ad9100e52f40286daaaceb98c0ee7893ae416389eb67feb283d6145478115fb","9ea83488ccb035d9e4fc3c486b19f3651f502c85a2c57effc62ba9df160d36d7"],"paragraph_range_zero_based":[43128,43151],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p43128"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the frequency of all SCells with SSB configured in SCG. The field scellFrequenciesSN-EUTRA is used in NE-DC; the field scellFrequenciesSN-NR is used in (NG)EN-DC and NR-DC. In (NG)EN-DC, the field is optionally provided to the MN. scellFrequenciesSN-NR indicates absoluteFrequencySSB.","paragraph_zero_based":43152},{"literal_text_all_w_t_and_m_t":"scg-CellGroupConfig","paragraph_zero_based":43153},{"literal_text_all_w_t_and_m_t":"Contains the RRCReconfiguration message (containing only secondaryCellGroup and/or measConfig and/or otherConfig and/or conditionalReconfiguration and/or bap-Config and/or iab-IP-AddressConfigurationList):","paragraph_zero_based":43154},{"literal_text_all_w_t_and_m_t":"-to be sent to the UE, used upon SCG establishment or modification (only when the SCG is not released by the SN), as generated (entirely) by the (target) SgNB. In this case, the SN sets the RRCReconfiguration message in accordance with clause 6 e.g. regarding the \"Need\" or \"Cond\" statements.","paragraph_zero_based":43155},{"literal_text_all_w_t_and_m_t":" or","paragraph_zero_based":43156},{"literal_text_all_w_t_and_m_t":"-including the current SCG configuration of the UE, when provided in response to a query from MN, or in SN triggered SN change in order to enable delta signaling by the target SN, or in SN triggered modification procedure in order to coordinate CHO or MN-initiated CPC with SCG reconfigurations (see TS 38.423 [35]). In this case, the SN sets the RRCReconfiguration message in accordance with clause 11.2.3.","paragraph_zero_based":43157},{"literal_text_all_w_t_and_m_t":"The field is absent if neither SCG (re)configuration nor SCG configuration query nor SN triggered modification procedure in order to coordinate CHO or MN-initiated CPC with SCG reconfigurations (see TS 38.423 [35]) nor SN triggered SN change is performed, e.g. at inter-node capability/configuration coordination which does not result in SCG (re)configuration towards the UE. The field is also absent upon an SCG release triggered by the SN. This field is not applicable in NE-DC.","paragraph_zero_based":43158},{"literal_text_all_w_t_and_m_t":"scg-CellGroupConfigEUTRA","paragraph_zero_based":43159},{"literal_text_all_w_t_and_m_t":"Includes the E-UTRA RRCConnectionReconfiguration message as specified in TS 36.331 [10]. In this version of the specification, the E-UTRA RRC message can only include the field scg-Configuration:","paragraph_zero_based":43160},{"literal_text_all_w_t_and_m_t":"-to be sent to the UE, used to (re-)configure the SCG configuration upon SCG establishment or modification (only when the SCG is not released by the SN), as generated (entirely) by the (target) SeNB. In this case, the SN sets the scg-Configuration within the EUTRA RRCConnectionReconfiguration message in accordance with clause 6 in TS 36.331 [10] e.g. regarding the \"Need\" or \"Cond\" statements.","paragraph_zero_based":43161},{"literal_text_all_w_t_and_m_t":"or","paragraph_zero_based":43162},{"literal_text_all_w_t_and_m_t":"-including the current SCG configuration of the UE, when provided in response to a query from MN, or in SN triggered SN change in order to enable delta signalling by the target SN.","paragraph_zero_based":43163},{"literal_text_all_w_t_and_m_t":"The field is absent if neither SCG (re)configuration nor SCG configuration query nor SN triggered SN change is performed, e.g. at inter-node capability/configuration coordination which does not result in SCG (re)configuration towards the UE. The field is also absent upon an SCG release triggered by the SN. This field is only used in NE-DC.","paragraph_zero_based":43164},{"literal_text_all_w_t_and_m_t":"scg-RB-Config","paragraph_zero_based":43165},{"literal_text_all_w_t_and_m_t":"Contains the IE RadioBearerConfig:","paragraph_zero_based":43166},{"literal_text_all_w_t_and_m_t":"-to be sent to the UE, used to (re-)configure the SCG RB configuration upon SCG establishment or modification, as generated (entirely) by the (target) SgNB or SeNB. In this case, the SN sets the RadioBearerConfig in accordance with clause 6, e.g. regarding the \"Need\" or \"Cond\" statements.","paragraph_zero_based":43167},{"literal_text_all_w_t_and_m_t":" or","paragraph_zero_based":43168},{"literal_text_all_w_t_and_m_t":"-including the current SCG RB configuration of the UE, when provided in response to a query from MN or in SN triggered SN change or in SN triggered SN release or bearer type change between SN terminated bearer to MN terminated bearer in order to enable delta signaling by the MN or target SN. In this case, the SN sets the RadioBearerConfig in accordance with clause 11.2.3.","paragraph_zero_based":43169},{"literal_text_all_w_t_and_m_t":"The field is absent if neither SCG (re)configuration nor SCG configuration query nor SN triggered SN change nor SN triggered SN release is performed, e.g. at inter-node capability/configuration coordination which does not result in SCG RB (re)configuration.","paragraph_zero_based":43170},{"literal_text_all_w_t_and_m_t":"selectedBandCombination","paragraph_zero_based":43171},{"literal_text_all_w_t_and_m_t":"Indicates the band combination selected by SN in (NG)EN-DC, NE-DC, and NR-DC. The SN should inform the MN with this field whenever the band combination and/or feature set it selected for the SCG changes (i.e. even if the new selection concerns a band combination and/or feature set that is allowed by the allowedBC-ListMRDC)","paragraph_zero_based":43172},{"literal_text_all_w_t_and_m_t":"selectedToffset","paragraph_zero_based":43173},{"literal_text_all_w_t_and_m_t":"Indicates the value used by the SN for scheduling SCG transmissions (i.e. Tproc,SCGmax,  see TS 38.213 [13]). This field is used in NR-DC only when the fields nrdc-PC-mode-FR1-r16 or nrdc-PC-mode-FR2-r16 are set to dynamic. The SN can only indicate a value that is less than or equal to maxToffset received from MN. This field is used in NR-DC only when MN has included the field maxToffset in CG-ConfigInfo. Value ms0dot5 corresponds to 0.5 ms, value ms0dot75 corresponds to 0.75 ms, value ms1 corresponds to 1ms and so on.","paragraph_zero_based":43174},{"literal_text_all_w_t_and_m_t":"servCellInfoListSCG-EUTRA","paragraph_zero_based":43175}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["3b15b2728fd0873c3a067152dc0c71e941764634c7f13f850968e69cbeaf3756","8ba218af0bf286b52e74717dda76852283e1f61b21c3881c6480536091ff389b","6c491fa6685cd9083813cf106f336025a4441127459a7dc6cd6c74fa1c21d74c","dc86490f2b6b1c514b82e044319cf0a8507123d6092b2ba6ef6380d27fd7deef","ac038b806171f0c123df8df72d62bdae105f66bf4d4e7b16f3ef5539da637474","7e215cb12ddf465f530a7bc7ddafd35afffeffa122e5ce5dff50a25d02136c44","63bb074e3dac8d2604606f6932847253e2c8692b9ec84aefb12fa707478f14a1","6ff99c250bfec78c8594338cb0464a77227041c4785f9706b3ad3e96305ef028","aba573a8f206a313231fd5fe9c3d1cacdbaef65d59083c790076fd03cb1ec848","df61f8c7f20bb0456743cfcb8a87eb754abbe1370a5bdeca9e7e3f04f39f14af","fa05265f989d7f815499089ac871d109f64b9998437dca84a6b573721679efe2","082cb3bbb7432dcafe2f05c39a4f3780c173bac1978682f996bc3ce76955e02d","2024d5925ba1ff85aa7880e1aa9e1fc727928f6a8786581cbc351a180241b13a","78e015910f517616cfb903e6e54b6f7436e823946eb1d26097ff1c19a7bd9834","2eb29bf639a15275bed5aa9be4da3a12c22f1f34b68941a5519aef180ea44c94","7b095223b731425b63f64feda6a5040446431d7b07216c3a25df05bb070f4b19","a50d853c9c747e29a094344617c07f07385980dc31309fa17ba301157ebf06d6","d8eacc36e851615ea931cbd6d4e952aa1ba4ab986d00ca913459f88837bf5216","c8106a8cf79ac58eddb18b4973d4dcb78c64dd3c35dab29b8fdd19302bf383b5","f41524f9f72bd8b691124cb651c8a829f09c357c3f58878009510662020ec60d","00e621de10dd20a6d0329ea3ed846cd0b42c3065465e0d4ed516d206500e61d5","c62588b5e7ecb24425b2e9ea479a7a27a1430b1559afc88908b60c766d66e11d","54ee53829bc38de5b42c5d44533ed3848dbe3920bd8ee9880c62045f7e6f7851","f0de6d53a4d8c318581c6d5567e95e6e33bca44d543fd75515731df49eaea794"],"paragraph_range_zero_based":[43152,43175],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p43152"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the carrier frequency and the transmission bandwidth of the serving cell(s) in the SCG in intra-band NE-DC. The field is needed when MN and SN operate serving cells in the same band for either contiguous or non-contiguous intra-band band combination or LTE NR inter-band band combinations where the frequency range of the E-UTRA band is a subset of the frequency range of the NR band (as specified in Table 5.5B.4.1-1 of TS 38.101-3 [34]) in NE-DC.","paragraph_zero_based":43176},{"literal_text_all_w_t_and_m_t":"servCellInfoListSCG-NR","paragraph_zero_based":43177},{"literal_text_all_w_t_and_m_t":"Indicates the frequency band indicator, carrier center frequency, UE specific channel bandwidth and SCS of the serving cell(s) in the SCG in intra-band (NG)EN-DC. The field is needed when MN and SN operate serving cells in the same band for either contiguous or non-contiguous intra-band band combination or LTE NR inter-band band combinations where the frequency range of the E-UTRA band is a subset of the frequency range of the NR band (as specified in Table 5.5B.4.1-1 of TS 38.101-3 [34]) in (NG)EN-DC.","paragraph_zero_based":43178},{"literal_text_all_w_t_and_m_t":"twoPHRModeSCG","paragraph_zero_based":43179},{"literal_text_all_w_t_and_m_t":"Indicates if the power headroom for SCG shall be reported as two PHRs (each PHR associated with a SRS resource set) is enabled or not.","paragraph_zero_based":43180},{"literal_text_all_w_t_and_m_t":"twoSRS-PUSCH-Repetition","paragraph_zero_based":43181},{"literal_text_all_w_t_and_m_t":"Indicates whether the indicated serving cell is configured for PUSCH repetition corresponding to two SRS resource sets configured in either srs-ResourceSetToAddModList or srs-ResourceSetToAddModListDCI-0-2 with usage 'codebook' or 'noncodebook'.","paragraph_zero_based":43182},{"literal_text_all_w_t_and_m_t":"transmissionBandwidth-EUTRA","paragraph_zero_based":43183},{"literal_text_all_w_t_and_m_t":"Indicates the transmission bandwidth on an E-UTRA carrier frequency as defined by the parameter Transmission Bandwidth Configuration \"NRB\" TS 36.104 [33]. The values rb6, rb15, rb25, rb50, rb75, rb100 indicate 6, 15, 25, 50, 75 and 100 resource blocks respectively.","paragraph_zero_based":43184},{"literal_text_all_w_t_and_m_t":"ueAssistanceInformationSCG","paragraph_zero_based":43185},{"literal_text_all_w_t_and_m_t":"Includes for each UE assistance feature associated with the SCG, the information last reported by the UE in the NR UEAssistanceInformation message for the SCG, if any.","paragraph_zero_based":43186},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43187},{"literal_text_all_w_t_and_m_t":"BandCombinationInfoSN field descriptions","paragraph_zero_based":43188},{"literal_text_all_w_t_and_m_t":"bandCombinationIndex","paragraph_zero_based":43189},{"literal_text_all_w_t_and_m_t":"In case of NR-DC, this field indicates the position of a band combination in the supportedBandCombinationList. In case of NE-DC, this field indicates the position of a band combination in the supportedBandCombinationList and/or supportedBandCombinationListNEDC-Only. In case of (NG)EN-DC, this field indicates the position of a band combination in the supportedBandCombinationList and/or supportedBandCombinationList-UplinkTxSwitch. Band combination entries in supportedBandCombinationList are referred by an index which corresponds to the position of a band combination in the supportedBandCombinationList. Band combination entries in supportedBandCombinationListNEDC-Only are referred by an index which corresponds to the position of a band combination in the supportedBandCombinationListNEDC-Only increased by the number of entries in supportedBandCombinationList. Band combination entries in supportedBandCombinationList-UplinkTxSwitch are referred by an index which corresponds to the position of a band combination in the supportedBandCombinationList-UplinkTxSwitch increased by the number of entries in supportedBandCombinationList.","paragraph_zero_based":43190},{"literal_text_all_w_t_and_m_t":"requestedFeatureSets","paragraph_zero_based":43191},{"literal_text_all_w_t_and_m_t":"The position in the FeatureSetCombination which identifies one FeatureSetUplink/Downlink for each band entry in the associated band combination","paragraph_zero_based":43192},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43193},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":43194},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":43195},{"literal_text_all_w_t_and_m_t":"FDD","paragraph_zero_based":43196},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if dl-FreqInfo-NR is included and concerns an FDD carrier; otherwise the field is absent.","paragraph_zero_based":43197},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43198},{"literal_text_all_w_t_and_m_t":"–CG-ConfigInfo","paragraph_zero_based":43199}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["32893dac1ff74adb2cdb9ddc4b8d24566f825b4315fd80e7c84af9cb930f7a01","963e6173635cea074e1ab488cc792f57f18645914e7f61fb16fd770a626aad4e","68e4f7cb601b0cc330e3ed6060ba7e1ca0c93a7a7e9ef51a81cba7abcb24c706","03e682ff4d80b5a77d14f0a7a8ae92f427b907994d187783979b4e7e50b45a97","a178187e762253fac72b0efda55a0767f17ec0162ba9168d6f8c4fdef3d311c4","b211951d5176b45547f8ea750d458bef706405c3231beee35996676a2b11d4a3","92a7d73b5446d8f6914a4dc7da6b15f932f81cadd0178b3cec30a16caaf43b3d","a1bd868cc6fdeee0d5a4d6790f