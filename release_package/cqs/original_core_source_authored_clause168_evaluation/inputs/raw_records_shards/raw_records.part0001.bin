{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-SHORTI-RNTI-VALUE-START","paragraph_zero_based":28176},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28177},{"literal_text_all_w_t_and_m_t":"ShortI-RNTI-Value ::=   BIT STRING (SIZE(24))","paragraph_zero_based":28178},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28179},{"literal_text_all_w_t_and_m_t":"-- TAG-SHORTI-RNTI-VALUE-STOP","paragraph_zero_based":28180},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28181},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28182},{"literal_text_all_w_t_and_m_t":"–ShortMAC-I","paragraph_zero_based":28183},{"literal_text_all_w_t_and_m_t":"The IE ShortMAC-I is used to identify and verify the UE at RRC connection re-establishment. The 16 least significant bits of the MAC-I calculated using the AS security configuration of the source PCell, as specified in 5.3.7.4.","paragraph_zero_based":28184},{"literal_text_all_w_t_and_m_t":"ShortMAC-I information element","paragraph_zero_based":28185},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28186},{"literal_text_all_w_t_and_m_t":"-- TAG-SHORTMAC-I-START","paragraph_zero_based":28187},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28188},{"literal_text_all_w_t_and_m_t":"ShortMAC-I ::=                      BIT STRING (SIZE (16))","paragraph_zero_based":28189},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28190},{"literal_text_all_w_t_and_m_t":"-- TAG-SHORTMAC-I-STOP","paragraph_zero_based":28191},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28192},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28193},{"literal_text_all_w_t_and_m_t":"–SINR-Range","paragraph_zero_based":28194},{"literal_text_all_w_t_and_m_t":"The IE SINR-Range specifies the value range used in SINR measurements and thresholds. For measurements, integer value for SINR measurements is according to Table 10.1.16.1-1 in TS 38.133 [14]. For thresholds, the actual value is (IE value – 46) / 2 dB.","paragraph_zero_based":28195},{"literal_text_all_w_t_and_m_t":"SINR-Range information element","paragraph_zero_based":28196},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28197},{"literal_text_all_w_t_and_m_t":"-- TAG-SINR-RANGE-START","paragraph_zero_based":28198},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28199}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["2bfd4c353a0ca6ca74bfae04ee558159192da12dd134c1c4c339611c6dc14aed","b658559ac708762935f000d6ad55f78bd06438fafc89918110928cfd54140276","1f95f7877d2fa462f0caf94b747ba0d3d2ac946e2f185903b04bdbc8177b0902","4f3497f260c75e384aa4c6b50e17997b52244e37b9ab8a815fac2e64ebea49e8","2230204de5a19f9a45c4d79e9178b353bd24d27fce5da35904b8e150cb8af9f9","bf1de33b6f2cca1dc516b20b73924c439146fd99ea998efde7d2077c2b25a434","9f9b39cd6d844dc77d040018e2494c54287c0b866c298af68193374d7ca9ee96","75494b22e10090593257ef5bb7fcf5b0063ab73d1b2b93053643796a96a0d34e","403dbab0e3f4e936367ff3a103fc1ebe9a43cc21fcbf1c49ab059fb75d45dabe","4349be75c9182d4c8081170640f1f551dab3d05780c6d580649c1ba1504f088f","4d13f2c0d37d442796c967f33159b570df948216f8f46b9f5fe4df2f038619da","8bb1fdaf43cc9111604c557ab70bf16e5159be4c14e69db1f5a3e0493124a534","5fd42f34a5cdc5cc3f6b9ccffcebfdc96d6701ecd79837dd143bf7791af142a5","1182602893799a0b433f3e578b34015e8577a73c37b1fbb1d446007ebc589588","7dad1b1e674e898888e60638dc28f0c2bc1759a49059a95721dcabb0e2f4b48a","9702e18018fb5f53a1de6f8b054fdb543670389282eee8aa9bcb93fcdc396389","47a4026ebe601c23184dd3dffaf5d90c11c133cf99237dc3a304dcbaaa853100","faeb3f41253dcd84655fec1bdb9adba6063db1f38f87fd96e1ed1815c09989f4","942c545a2c6726020318ca72b75a74ded7fc727686d67030acea9fb1e22a33fb","d07f78eaaee3100bba89b5a008b2077b34505b02363c70b4497a5e9e15255874","b79cc1ea9fd5f76075bf44c89044d0c45bfea18b34c97bf98a63fbfa1f64e487","96d89f74a45c63cc24d04d0d3691279a4ea3aecc02cb0e8d256c60ac39670b2f","090b1b9eebdcadb5dc11a8afe145adc202146c767987c776d5ffafbd6d7b9fa1","70dd6aad6ac8c7d55a033877201851dbab4cec6b8505d5ec29a0c791deadc410"],"paragraph_range_zero_based":[28176,28199],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p28176"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SINR-Range ::=                      INTEGER(0..127)","paragraph_zero_based":28200},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28201},{"literal_text_all_w_t_and_m_t":"-- TAG-SINR-RANGE-STOP","paragraph_zero_based":28202},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28203},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28204},{"literal_text_all_w_t_and_m_t":"–SI-RequestConfig","paragraph_zero_based":28205},{"literal_text_all_w_t_and_m_t":"The IE SI-RequestConfig contains configuration for Msg1 based SI request.","paragraph_zero_based":28206},{"literal_text_all_w_t_and_m_t":"SI-RequestConfig information element","paragraph_zero_based":28207},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28208},{"literal_text_all_w_t_and_m_t":"-- TAG-SI-REQUESTCONFIG-START","paragraph_zero_based":28209},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28210},{"literal_text_all_w_t_and_m_t":"SI-RequestConfig ::=                SEQUENCE {","paragraph_zero_based":28211},{"literal_text_all_w_t_and_m_t":"    rach-OccasionsSI                    SEQUENCE {","paragraph_zero_based":28212},{"literal_text_all_w_t_and_m_t":"        rach-ConfigSI                       RACH-ConfigGeneric,","paragraph_zero_based":28213},{"literal_text_all_w_t_and_m_t":"        ssb-perRACH-Occasion                ENUMERATED {oneEighth, oneFourth, oneHalf, one, two, four, eight, sixteen}","paragraph_zero_based":28214},{"literal_text_all_w_t_and_m_t":"    }                                                                                                       OPTIONAL,   -- Need R","paragraph_zero_based":28215},{"literal_text_all_w_t_and_m_t":"    si-RequestPeriod                    ENUMERATED {one, two, four, six, eight, ten, twelve, sixteen}       OPTIONAL,   -- Need R","paragraph_zero_based":28216},{"literal_text_all_w_t_and_m_t":"    si-RequestResources                 SEQUENCE (SIZE (1..maxSI-Message)) OF SI-RequestResources","paragraph_zero_based":28217},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28218},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28219},{"literal_text_all_w_t_and_m_t":"SI-RequestResources ::=             SEQUENCE {","paragraph_zero_based":28220},{"literal_text_all_w_t_and_m_t":"    ra-PreambleStartIndex               INTEGER (0..63),","paragraph_zero_based":28221},{"literal_text_all_w_t_and_m_t":"    ra-AssociationPeriodIndex           INTEGER (0..15)                                                     OPTIONAL,   -- Need R","paragraph_zero_based":28222},{"literal_text_all_w_t_and_m_t":"    ra-ssb-OccasionMaskIndex            INTEGER (0..15)                                                     OPTIONAL    -- Need R","paragraph_zero_based":28223}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["454f06d5bd73d91ef7edc4bc663a1fbc24ce0ad1e770b5f224a217e9697e7de6","4598e91a7b763121d43ef53b24f655b2c8dea5b361855595f02b0f4879698347","e4b5672ec246706ee2cd5f2453414e086adf26bdea72b261770d985f1f0ea6ba","ab651e538bf727992f1e0d46bd2e53e92fecb9a61c7e094878de873f91db46df","65cd961dd9d3673f6dfe24b99010ea72a89849eca6f9359c17e330f40e8b389a","95a58f8d07e8e87c19bd3c42a3878905aedf1f7c5dce5ad6393bb78ee15006a1","92dd4112e9d6e20e1709abe5109255427076c0a01cd52d9bbcadd50558816bdd","be64d0f666a5b25cf1049401fec16111b15e796a68d225c715b96e33babb0f9f","c087f3ce9a98d7dfa413de0a8484642a8445b8d785ccb93f0406b77ab5b85f65","bb1aaa8d5496956996b0eceb5d1ee617e8de7efa38e76c5a3801be6d28ca93f7","49139e1f7210223b0f6b7d80a9241b88df7eac293bd41714b6805f2501cb69bb","66c9b7fd0a0623043e8034ad47d652294cb2281994d5772ce16c79b171218d3c","726714a71bcdcefe6f1791fb5cb4f799bea460cd9b2ef28ffbfb4e7737b44ca2","873d3f8d2671c320d7c02480c7b25f1946e94fffd58e25899a5fbdcc25b7cd59","88b19f456d91cf23b7338d070f6b1fe7133df2088c3cfa8f25e10d1d805ae288","830ac33de439547274c7abe4e2f4028cb4f3e4d1c174ebf39dbc687b6965b2ae","bf4ce7442bf9de7c3f3683caf78a8a6b16d2d2dfc5c5a6a5f115567fc8a9e93f","cd63b1589ab2bd16b8d93e253610e28795be29c4ce9067c095dbbea570983b42","9fb9ac3abb3ffb3d7f736257ef7fb23d18e46b7fd98ff4f8c1df0b57c9f3f928","284887d0d9cb125e9b44d73786933c93695e833a955bc46841e0814a98c102bf","221f8aab854515450b8252bad0c0dc6717afaa326fc9b533d6e32a043cb66846","1ff485d11659e2f57b0e835391ee4fe6fdf4a8466054da5ad4f9c547a9c98f83","d485f57ba9d2fbab1e9c41cc3028219f1deb0c8a98866dd3053ffeeac8aa6a34","2bdc3a63b21b1fbf8e541b1a0f5d2918229bc719a51a5f18f38f01ed35f0841a"],"paragraph_range_zero_based":[28200,28223],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p28200"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28224},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28225},{"literal_text_all_w_t_and_m_t":"-- TAG-SI-REQUESTCONFIG-STOP","paragraph_zero_based":28226},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28227},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28228},{"literal_text_all_w_t_and_m_t":"SI-RequestConfig field descriptions","paragraph_zero_based":28229},{"literal_text_all_w_t_and_m_t":"rach-OccasionsSI","paragraph_zero_based":28230},{"literal_text_all_w_t_and_m_t":"Configuration of dedicated RACH Occasions for SI. If the field is absent, the UE uses the corresponding parameters configured in rach-ConfigCommon of the initial uplink BWP.","paragraph_zero_based":28231},{"literal_text_all_w_t_and_m_t":"si-RequestPeriod","paragraph_zero_based":28232},{"literal_text_all_w_t_and_m_t":"Periodicity of the SI-Request configuration in number of association periods.","paragraph_zero_based":28233},{"literal_text_all_w_t_and_m_t":"si-RequestResources","paragraph_zero_based":28234},{"literal_text_all_w_t_and_m_t":"If there is only one entry in the list, the configuration is used for all SI messages for which si-BroadcastStatus or posSI-BroadcastStatus is set to notBroadcasting. Otherwise:","paragraph_zero_based":28235},{"literal_text_all_w_t_and_m_t":"-If si-SchedulingInfo-v1700 is not present and the SI-RequestConfig is used for on-demand SI request in SI-SchedulingInfo or PosSI-SchedulingInfo, the 1st entry in the list corresponds to the first SI message in schedulingInfoList or posSchedulingInfoList for which si-BroadcastStatus or posSI-BroadcastStatus is set to notBroadcasting, 2nd entry in the list corresponds to the second SI message in schedulingInfoList or posSchedulingInfoList for which si-BroadcastStatus or posSI-BroadcastStatus is set to notBroadcasting and so on.","paragraph_zero_based":28236},{"literal_text_all_w_t_and_m_t":"-If si-SchedulingInfo-v1700 is present and SI-RequestConfig is configured in SI-SchedulingInfo for on-demand SI request, the UE generates a list of concatenated SI messages by appending the SI messages containing type1 SIB configured by schedulingInfoList2 in si-SchedulingInfo-v1700 to the SI messages configured by schedulingInfoList in si-SchedulingInfo. The 1st entry in the list corresponds to the first SI message for which si-BroadcastStatus is set to notBroadcasting, 2nd entry in the list corresponds to the second SI message for which si-BroadcastStatus is set to notBroadcasting and so on.","paragraph_zero_based":28237},{"literal_text_all_w_t_and_m_t":"-If si-SchedulingInfo-v1700 is present and SI-RequestConfig is configured in PosSI-SchedulingInfo for on-demand SI request, the UE generates a list of concatenated SI messages by appending the SI messages containing type2 SIB configured by schedulingInfoList2 in si-SchedulingInfo-v1700 to the SI messages configured by posSchedulingInfoList in posSI-SchedulingInfo. The 1st entry in the list corresponds to the first SI message for which posSI-BroadcastStatus or si-BroadcastStatus is set to notBroadcasting, 2nd entry in the list corresponds to the second SI message for which posSI-BroadcastStatus or si-BroadcastStatus is set to notBroadcasting and so on.","paragraph_zero_based":28238},{"literal_text_all_w_t_and_m_t":"Change of si-RequestResources should not result in system information change notification.","paragraph_zero_based":28239},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28240},{"literal_text_all_w_t_and_m_t":"SI-RequestResources field descriptions","paragraph_zero_based":28241},{"literal_text_all_w_t_and_m_t":"ra-AssociationPeriodIndex","paragraph_zero_based":28242},{"literal_text_all_w_t_and_m_t":"Index of the association period in the si-RequestPeriod in which the UE can send the SI request for SI message(s) corresponding to this SI-RequestResources, using the preambles indicated by ra-PreambleStartIndex and rach occasions indicated by ra-ssb-OccasionMaskIndex.","paragraph_zero_based":28243},{"literal_text_all_w_t_and_m_t":"ra-PreambleStartIndex","paragraph_zero_based":28244},{"literal_text_all_w_t_and_m_t":"If N SSBs are associated with a RACH occasion, where N > = 1, for the i-th SSB (i=0, …, N-1) the preamble with preamble index = ra-PreambleStartIndex + i is used for SI request; For N < 1, the preamble with preamble index = ra-PreambleStartIndex is used for SI request.","paragraph_zero_based":28245},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28246},{"literal_text_all_w_t_and_m_t":"–SI-SchedulingInfo","paragraph_zero_based":28247}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["58b9d66ea99279a2d15d2a21ddb465475eeb4ff12ecf8bd164ca69cfeb7b5f66","6c9ef178d252d460ee6bbb1df2052c5814a5fe003d86e525c5d7fb19d644df1b","712c7a16c82e9dfcd0679ef92fed1df875dc9e199c28ee5253ba4aa829ed98aa","b410e2f0d5efda7cf14faf2ab210ca52b779eba94760c40e816122a5b922fa69","7b79efe8b87c2dacea9b5ba37cec408bf8e2e73a15426c4b36ca302398ff069e","596a92c957cc186975a22ad4e4b0e3bb8a3dc50cfdeae4b3b76c426c30863e79","46d5fbce3cc2aea355e80e47ab38f62198ae2f0e595700ad23404392c191c0ff","a05af70dae381e920007deddb4b2fab9d25c9acd4ba69be644255ea1507e454d","375020f161f331dcca1d4ed30e9a6ee2cf331e638eeb887da978671637aa95fe","43bae06c4659ef49a449be0c5230bc5bc98fea0856ef348c7777d950c29f53c8","0dce4e9086e079e5a7fe52a2816fd7528961f4e2b3bfd116bcbfdfd5986a5a52","ce43548d9c1c848dec89a1bd92c08fafaf7ddef5e1b317bf9a792d16a523e482","8c7ff2a16fb975cde0432ebcd18b1ba27a6380572ef45c