{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"csi-IM-ResourceSetToAddModList","paragraph_zero_based":16872},{"literal_text_all_w_t_and_m_t":"Pool of CSI-IM-ResourceSet which can be referred to from CSI-ResourceConfig or from MAC CEs.","paragraph_zero_based":16873},{"literal_text_all_w_t_and_m_t":"csi-IM-ResourceToAddModList","paragraph_zero_based":16874},{"literal_text_all_w_t_and_m_t":"Pool of CSI-IM-Resource which can be referred to from CSI-IM-ResourceSet.","paragraph_zero_based":16875},{"literal_text_all_w_t_and_m_t":"csi-ReportConfigToAddModList","paragraph_zero_based":16876},{"literal_text_all_w_t_and_m_t":"Configured CSI report settings as specified in TS 38.214 [19] clause 5.2.1.1.","paragraph_zero_based":16877},{"literal_text_all_w_t_and_m_t":"csi-ResourceConfigToAddModList","paragraph_zero_based":16878},{"literal_text_all_w_t_and_m_t":"Configured CSI resource settings as specified in TS 38.214 [19] clause 5.2.1.2.","paragraph_zero_based":16879},{"literal_text_all_w_t_and_m_t":"csi-SSB-ResourceSetToAddModList","paragraph_zero_based":16880},{"literal_text_all_w_t_and_m_t":"Pool of CSI-SSB-ResourceSet which can be referred to from CSI-ResourceConfig.","paragraph_zero_based":16881},{"literal_text_all_w_t_and_m_t":"nzp-CSI-RS-ResourceSetToAddModList","paragraph_zero_based":16882},{"literal_text_all_w_t_and_m_t":"Pool of NZP-CSI-RS-ResourceSet which can be referred to from CSI-ResourceConfig or from MAC CEs.","paragraph_zero_based":16883},{"literal_text_all_w_t_and_m_t":"nzp-CSI-RS-ResourceToAddModList","paragraph_zero_based":16884},{"literal_text_all_w_t_and_m_t":"Pool of NZP-CSI-RS-Resource which can be referred to from NZP-CSI-RS-ResourceSet.","paragraph_zero_based":16885},{"literal_text_all_w_t_and_m_t":"reportTriggerSize, reportTriggerSizeDCI-0-2","paragraph_zero_based":16886},{"literal_text_all_w_t_and_m_t":"Size of CSI request field in DCI (bits) (see TS 38.214 [19], clause 5.2.1.5.1). The field reportTriggerSize applies to DCI format 0_1 and the field reportTriggerSizeDCI-0-2 applies to DCI format 0_2 (see TS 38.214 [19], clause 5.2.1.5.1).","paragraph_zero_based":16887},{"literal_text_all_w_t_and_m_t":"scellActivationRS-ConfigToAddModList","paragraph_zero_based":16888},{"literal_text_all_w_t_and_m_t":"Configured RS for fast SCell activation as specified in TS 38.214 [19] clause 5.2.1.5.3.","paragraph_zero_based":16889},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16890},{"literal_text_all_w_t_and_m_t":"–CSI-ReportConfig","paragraph_zero_based":16891},{"literal_text_all_w_t_and_m_t":"The IE CSI-ReportConfig is used to configure a periodic or semi-persistent report sent on PUCCH on the cell in which the CSI-ReportConfig is included, or to configure a semi-persistent or aperiodic report sent on PUSCH triggered by DCI received on the cell in which the CSI-ReportConfig is included (in this case, the cell on which the report is sent is determined by the received DCI). See TS 38.214 [19], clause 5.2.1.","paragraph_zero_based":16892},{"literal_text_all_w_t_and_m_t":"CSI-ReportConfig information element","paragraph_zero_based":16893},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":16894},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-REPORTCONFIG-START","paragraph_zero_based":16895}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["6fc8967c0602eef691c2ccdc684ed60f5ef759cf27a401f1687a9cf24cfdb422","8622e1f1bd36e472e8837b5def12a8f7d9fe4429c6a286515f618bafb50f4a80","938591ec259f8b9600c1b08e6c44895cbc52934455db3990673652b3cf6d26a9","147d1cc48