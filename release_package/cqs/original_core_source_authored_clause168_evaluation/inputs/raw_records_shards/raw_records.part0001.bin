{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    highSpeedConfigFR2-r17              HighSpeedConfigFR2-r17                                              OPTIONAL, -- Need R","paragraph_zero_based":28008},{"literal_text_all_w_t_and_m_t":"    uplinkConfigCommon-v1700            UplinkConfigCommon-v1700                                            OPTIONAL, -- Need R","paragraph_zero_based":28009},{"literal_text_all_w_t_and_m_t":"    ntn-Config-r17                      NTN-Config-r17                                                      OPTIONAL  -- Need R","paragraph_zero_based":28010},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":28011},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":28012},{"literal_text_all_w_t_and_m_t":"    featurePriorities-r17               SEQUENCE {","paragraph_zero_based":28013},{"literal_text_all_w_t_and_m_t":"        redCapPriority-r17                  FeaturePriority-r17                                             OPTIONAL, -- Need R","paragraph_zero_based":28014},{"literal_text_all_w_t_and_m_t":"        slicingPriority-r17                 FeaturePriority-r17                                             OPTIONAL, -- Need R","paragraph_zero_based":28015},{"literal_text_all_w_t_and_m_t":"        msg3-Repetitions-Priority-r17       FeaturePriority-r17                                             OPTIONAL, -- Need R","paragraph_zero_based":28016},{"literal_text_all_w_t_and_m_t":"        sdt-Priority-r17                    FeaturePriority-r17                                             OPTIONAL  -- Need R","paragraph_zero_based":28017},{"literal_text_all_w_t_and_m_t":"    }                                                                                                       OPTIONAL  -- Need R","paragraph_zero_based":28018},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":28019},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":28020},{"literal_text_all_w_t_and_m_t":"    ra-ChannelAccess-r17            ENUMERATED {enabled}                                                OPTIONAL -- Cond SharedSpectrum2","paragraph_zero_based":28021},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":28022},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28023},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28024},{"literal_text_all_w_t_and_m_t":"-- TAG-SERVINGCELLCONFIGCOMMON-STOP","paragraph_zero_based":28025},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28026},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28027},{"literal_text_all_w_t_and_m_t":"ServingCellConfigCommon field descriptions","paragraph_zero_based":28028},{"literal_text_all_w_t_and_m_t":"channelAccessMode","paragraph_zero_based":28029},{"literal_text_all_w_t_and_m_t":"If present, this field indicates which channel access procedures to apply for operation with shared spectrum channel access as defined in TS 37.213 [48]. If the field is configured as \"semiStatic\", the UE shall apply the channel access procedures for semi-static channel occupancy as described in clause 4.3 in TS 37.213. If the field is configured as \"dynamic\", the UE shall apply the channel access procedures as defined in TS 37.213, clause 4.1 and 4.2.","paragraph_zero_based":28030},{"literal_text_all_w_t_and_m_t":"channelAccessMode2","paragraph_zero_based":28031}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["0173b38adb2f4e522d7ddc5a1414db873646fe448c3aafa99a36d656c76547fa","9d4b4b7054aa54a2d6f221d824e0c91f3f0b7bf196e27694e49554c7ab2a34cb","e805a4cc0238824325f1c2f83fb99322046934994d376b69e30d3570dd932efa","031a1f0414f0d6ba559f1263794067e796dc39495fd2fcc1cc554e16b90adb3b","7f8ea0159d79536e985990f70cc7fc2ad18e380dbf0b9acd3eaf954ea64c537b","b6a8028953fd41fbc8acea93e2740040b2a2e46ac1c67ff2c9cd002d4d3405d4","e740c4d5693222742b06cecd680820891cc7df6f10d9591bd930fc1c5da453f6","7ec77af974f11445607ac6e6a6738caf7df420c24134b2ce5e6cab8d043afe09","98d257ee6449ba7699b0a97952824064f945799c7173236f93d7a3afec76ca2d","f52661215b35ed20aaec40b9b9fc6e8a6489da898bdd2bc0e1d3ea61ef9b1cb4","c9c03de422ff852cbde08056b453eb35b14e0311a91f6bda2ab8c1400117f6f9","38994181b3fb0a642e58e34d7ab106d05e7a2e437f23377b6f7d54f1e21fc986","8ced9b231155bfc77d9cc492808df96b6bcb00a72cdd1c86778aded524c8de68","afffef2159757d0beabfef78bad4005b8671fea003c5a6d4802c09696b9c7f53","97b5163b6e16f14ebe45af6bef4bed3c172e999a05921d5b3c0a59bbb8b93021","d2f63363133ee78faa7dfd470b2c223799e5315018c2a7a4a4188ddaaa3ad387","2609bfdb3dca4208e917ce9723aeb7547b24c0c2312641faec34908bc67a5905","89e16fc6f9852a102568f02be58908c1e78aa2879b00bf28639394dec93acd1b","3275851c875821d4d761b5eb203af5328f07040d7f4d4dc58071daaec0e29370","10afe49faa7e7129b7b15c914a048c6bc57cfe2c35f505b962f7d63d8bee7f92","814f125a1b574dc29d53bdbbacc08f285f9fb329a222d8a9385bdd1ffa675184","2e8ffef0ee358b3c74a73a594863299d972005ed02262ffb34bf6ab90704d093","a6cd797230a5aca15db3b2f867ee3aa89fd3304a305772d6489d98d13fe7d1e7","78e89e4d281505a2789e020bb2dd1678b013262d32232f7cc9a967a1f8d5ca50"],"paragraph_range_zero_based":[28008,28031],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p28008"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"If present, the UE shall apply channel access procedures for operation with shared spectrum channel access in accordance with TS 37.213 [48], clause 4.4 for FR2-2. If absent, the UE shall not apply any channel access procedure. The network always configures this field if channel access procedures are required for the serving cell within this region by regulations.","paragraph_zero_based":28032},{"literal_text_all_w_t_and_m_t":"dmrs-TypeA-Position","paragraph_zero_based":28033},{"literal_text_all_w_t_and_m_t":"Position of (first) DM-RS for downlink (see TS 38.211 [16], clause 7.4.1.1.1) and uplink (TS 38.211 [16], clause 6.4.1.1.3).","paragraph_zero_based":28034},{"literal_text_all_w_t_and_m_t":"downlinkConfigCommon","paragraph_zero_based":28035},{"literal_text_all_w_t_and_m_t":"The common downlink configuration of the serving cell, including the frequency information configuration and the initial downlink BWP common configuration. The parameters provided herein should match the parameters configured by MIB and SIB1 (if provided) of the serving cell, with the exception of controlResourceSetZero and searchSpaceZero which can be configured in ServingCellConfigCommon even if MIB indicates that they are absent.","paragraph_zero_based":28036},{"literal_text_all_w_t_and_m_t":"discoveryBurstWindowLength","paragraph_zero_based":28037},{"literal_text_all_w_t_and_m_t":"Indicates the window length of the discovery burst in ms (see TS 37.213 [48]). The field discoveryBurstWindowLength-r17 is applicable to SCS 480 kHz and SCS 960 kHz.","paragraph_zero_based":28038},{"literal_text_all_w_t_and_m_t":"featurePriorities","paragraph_zero_based":28039},{"literal_text_all_w_t_and_m_t":"Indicates priorities for features, such as RedCap, Slicing, SDT and MSG3-Repetitions for Coverage Enhancements. These priorities are used to determine which FeatureCombinationPreambles the UE shall use when a feature maps to more than one FeatureCombinationPreambles, as specified in TS 38.321 [3]. A lower value means a higher priority. The network does not signal the same priority for more than one feature. The network signals a priority for all feature that map to at least one FeatureCombinationPreambles.","paragraph_zero_based":28040},{"literal_text_all_w_t_and_m_t":"longBitmap","paragraph_zero_based":28041},{"literal_text_all_w_t_and_m_t":"Bitmap when maximum number of SS/PBCH blocks per half frame equals to 64 as defined in TS 38.213 [13], clause 4.1.","paragraph_zero_based":28042},{"literal_text_all_w_t_and_m_t":"lte-CRS-ToMatchAround","paragraph_zero_based":28043},{"literal_text_all_w_t_and_m_t":"Parameters to determine an LTE CRS pattern that the UE shall rate match around.","paragraph_zero_based":28044},{"literal_text_all_w_t_and_m_t":"mediumBitmap","paragraph_zero_based":28045},{"literal_text_all_w_t_and_m_t":"Bitmap when maximum number of SS/PBCH blocks per half frame equals to 8 as defined in TS 38.213 [13], clause 4.1.","paragraph_zero_based":28046},{"literal_text_all_w_t_and_m_t":"n-TimingAdvanceOffset","paragraph_zero_based":28047},{"literal_text_all_w_t_and_m_t":"The N_TA-Offset to be applied for all uplink transmissions on this serving cell. If the field is absent, the UE applies the value defined for the duplex mode and frequency range of this serving cell. See TS 38.133 [14], table 7.1.2-2.","paragraph_zero_based":28048},{"literal_text_all_w_t_and_m_t":"ra-ChannelAccess","paragraph_zero_based":28049},{"literal_text_all_w_t_and_m_t":"If present, this field indicates that the UE shall apply channel access procedures before msg1/msgA transmission for operation with shared spectrum channel access in accordance with TS 37.213 [48], clause 4.4.5 for FR2-2.","paragraph_zero_based":28050},{"literal_text_all_w_t_and_m_t":"rateMatchPatternToAddModList","paragraph_zero_based":28051},{"literal_text_all_w_t_and_m_t":"Resources patterns which the UE should rate match PDSCH around. The UE rate matches around the union of all resources indicated in the rate match patterns. Rate match patterns defined here on cell level apply only to PDSCH of the same numerology (see TS 38.214 [19], clause 5.1.4.1). If a RateMatchPattern with the same RateMatchPatternId is configured in both ServingCellConfig/ServingCellConfigCommon and in SIB20/MCCH, the entire RateMatchPattern configuration, including the set of RBs/REs indicated by the patterns for the rate matching around, shall be the same and they are counted as a single rate match pattern in the total configured rate match patterns as defined in TS 38.214 [19].","paragraph_zero_based":28052},{"literal_text_all_w_t_and_m_t":"shortBitmap","paragraph_zero_based":28053},{"literal_text_all_w_t_and_m_t":"Bitmap when maximum number of SS/PBCH blocks per half frame equals to 4 as defined in TS 38.213 [13], clause 4.1.","paragraph_zero_based":28054},{"literal_text_all_w_t_and_m_t":"ss-PBCH-BlockPower","paragraph_zero_based":28055}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["23789709b8119dc8ef15372979de50dcac21f892eab0beed0855d279133c06f4","5d22366903293f57c84d6548338bb282f8a6db972968918ebc5bdb18d8613183","d4be4c1501aa932fd8decfa32220579415f3c04c5c196e815907ff7f4ede799c","6d79b528770d1cc79a206cd0c19eab54a010b99e105f7f7db87f7c2e137d1f30","a2f02b68abebbf8a9a717d281d87026ef38b00484200349bd8e391cb3f636b03","a2cf6af549c390c133802a23d1fd2f37b0408545b6e9a10f9ebaeba01a9473b5","dc39744e23d49655b515a2df81b936b5e2aa529d496c73ce7fa5c6846574e309","47759228b43a8be0f85ce54fec47122ad13bf8dbc93ccf31ff02fce243030276","f859029284a4c08ac06e90ab8bcf9d9c9e81848ea89eb0898ad76a4d05685610","8699add1ae5bf0faace7358784ee87f81e61d0a95d91e0aae4c88e400b654bf6","e4504f5edd729fb0387d395c01d0a8c471d480e0e1fdbc428b20233ae256e4db","0fbdcb95007208d01439a9a829c43d6b4dfca958b239c354b45ac49949ed4015","f172791f84a7303560cbe469e2beb7dede52bcb3ae2a1c049ca733b57fceb186","1b66388fc999c802c755cd72cec76f77efc6d6d56b2db5ebad40780e6303d8a3","b4a7dbbb45bd1a3771ab73e0025feed53cacaabb725d8935deea0a709bbda23f","38e12098f90c6e4c5ae74bee4caa6fce5dccc97f28d6145b02f7b14b624a8dac","89ff258a3f6d53b214105e51bdfe56e1c6a31fda32d64c2a8bb815c30168e026","8bc71ded35d92f0397d9c9f9b94a75aecea782cf318725af4ebd1eddb24bceac","ca2e73d25d3c5ddec0c099faa2f092a1ff426f2bbd2e10d27941fc766ad8c3eb","e7970ae7a8eace370ea09d35702578d3c381796aa500352e9096d137f6378002","57c960e7ed087f84f10d888c747bfaa67584806cc15f983d3a1f9298eb637745","febf61dde2198992d18bf8ff2b11fdcd23e0ce2c8a72cc9745261417c58ce04e","762ed4a6cc5bef0fa8eda34e9a0e3935d09d34c64ac14fe9d7d0ea10d5db764f","93ad7f7a370aaebde83eac61da7eb96619198a4243a797abd68ebe49135b5b95"],"paragraph_range_zero_based":[28032,28055],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p28032"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Average EPRE of the resources elements that carry secondary synchronization signals in dBm that the NW used for SSB transmission, see TS 38.213 [13], clause 7.","paragraph_zero_based":28056},{"literal_text_all_w_t_and_m_t":"ssb-periodicityServingCell","paragraph_zero_based":28057},{"literal_text_all_w_t_and_m_t":"The SSB periodicity in ms for the rate matching purpose. If the field is absent, the UE applies the value ms5. (see TS 38.213 [13], clause 4.1)","paragraph_zero_based":28058},{"literal_text_all_w_t_and_m_t":"ssb-PositionQCL","paragraph_zero_based":28059},{"literal_text_all_w_t_and_m_t":"Indicates the QCL relation between SSB positions for this serving cell as specified in TS 38.213 [13], clause 4.1.","paragraph_zero_based":28060},{"literal_text_all_w_t_and_m_t":"ssb-PositionsInBurst","paragraph_zero_based":28061},{"literal_text_all_w_t_and_m_t":"For operation in licensed spectrum, indicates the time domain positions of the transmitted SS-blocks in a half frame with SS/PBCH blocks as defined in TS 38.213 [13], clause 4.1. The first/leftmost bit corresponds to SS/PBCH block index 0, the second bit corresponds to SS/PBCH block index 1, and so on. Value 0 in the bitmap indicates that the corresponding SS/PBCH block is not transmitted while value 1 indicates that the corresponding SS/PBCH block is transmitted. The network configures the same pattern in this field as in the corresponding field in ServingCellConfigCommonSIB.","paragraph_zero_based":28062},{"literal_text_all_w_t_and_m_t":"For operation with shared spectrum channel access, the UE assumes that one or more SS/PBCH blocks indicated by ssb-PositionsInBurst may be transmitted within the discovery burst transmission window and have candidate SS/PBCH blocks indexes corresponding to SS/PBCH block indexes provided by ssb-PositionsInBurst (see TS 38.213 [13], clause 4.1). If the k-th bit of ssb-PositionsInBurst is set to 1, the UE assumes that one or more SS/PBCH blocks within the discovery burst transmission window with candidate SS/PBCH block indexes corresponding to SS/PBCH block index equal to k – 1 may be transmitted; if the kt-th bit is set to 0, the UE assumes that the corresponding SS/PBCH block(s) are not transmitted. The k-th bit is set to 0, where k > ssb-PositionQCL and the number of actually transmitted SS/PBCH blocks is not larger than the number of 1's in the bitmap. The network configures the same pattern in this field as in the corresponding field in ServingCellConfigCommonSIB. For operation with shared spectrum channel access in FR1, only mediumBitmap is used, and for FR2-2, longBitmap is used.","paragraph_zero_based":28063},{"literal_text_all_w_t_and_m_t":"ssbSubcarrierSpacing","paragraph_zero_based":28064},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing of SSB.","paragraph_zero_based":28065},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":28066},{"literal_text_all_w_t_and_m_t":"FR1:   15 or 30 kHz","paragraph_zero_based":28067},{"literal_text_all_w_t_and_m_t":"FR2-1:  120 or 240 kHz","paragraph_zero_based":28068},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":28069},{"literal_text_all_w_t_and_m_t":"supplementaryUplinkConfig","paragraph_zero_based":28070},{"literal_text_all_w_t_and_m_t":"The network configures this field only if uplinkConfigCommon is configured. If this field is absent, the UE shall release the supplementaryUplinkConfig and the supplementaryUplink configured in ServingCellConfig of this serving cell, if configured.","paragraph_zero_based":28071},{"literal_text_all_w_t_and_m_t":"tdd-UL-DL-ConfigurationCommon","paragraph_zero_based":28072},{"literal_text_all_w_t_and_m_t":"A cell-specific TDD UL/DL configuration, see TS 38.213 [13], clause 11.1.","paragraph_zero_based":28073},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28074},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":28075},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":28076},{"literal_text_all_w_t_and_m_t":"AbsFreqSSB","paragraph_zero_based":28077},{"literal_text_all_w_t_and_m_t":"The field is absent when absoluteFrequencySSB in frequencyInfoDL is absent, otherwise the field is mandatory present.","paragraph_zero_based":28078},{"literal_text_all_w_t_and_m_t":"HOAndServCellAdd","paragraph_zero_based":28079}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["f320ac2a2e60b320bfbb8ce2a898f943b3b67c49e83facc83f4f2465714d14e9","b95c5a3e6f9d5fffa52dde7693fed473c584e7f8bc7b82c0b9781507351fa2f4","7b2123996307459d055be2a76ac50ae4761a1f7d647229bfe5928621953ebc0a","b9902f972bd5dad36bd650b0dac49af4c75ceebeaea505ef679c3930c2f09441","df1cfae7fba0b05a857cd4647b82bf82582dccb2dd13ae35fa28c7947020ddc5","b7a4f88196117718fe4f0f59daec436da2e2690a03b767d63ce0aaf765091e27","2df07579e2e6840b6334ad8b703ef6d92322a08b2d42a05c57c820db664feaf6","e7cb27cc695e09be1b59c6ec593458a961826825c76545500a0fa11ab35d375a","faaeb65b2c9169c88c214cc053acd6907adb383cbc03adabdc0fc4a154249496","fad3122097ce65afdaf1a62549be907a2578d4c13a86edcd70ddc90eff6e57ff","ff64fa33a71efa9cecba6aa3c5426065c8eb7b7fa3e584c9685abbc6b2016124","e0b7d1639e1e2fadd9cf93a96c949af8ca869e76838bf01fe30091e614442a20","7be8118d0dd7d4655af3f4fda1dadb7bf7c94937a409b06f2c636f78831cb0ca","e6ba4ec4e97e7e7cacee56e48fad5f06fccf93c99d6f0984709192ff48e73c0a","98859caa7dedf31e2ef4aa6e26cb5dd6ddbcdc5e80e4fcdd10c3b130ba4e383f","21cbef486af3f5f51f30072c8cd59a1476bcb86fd0393c934365b48199c6c4b9","d5ab26b785bd9fe83c887c364bb2f58bb22cb53101103fe7e56e525227d0a8e7","22dbd8d685f274abf7609939ec24168dc86920fda9da40487cbacff5abd2a1b4","7e5e38219e53b30246a2e168959eb647e5859b94394ca188ff778bc406e5f672","26688999e94b5d172f27e37c387e38b5e5dc36303f0bbae6185dd243f0ef8823","f31997cb13cd42bed334e8ebde12b7585de6d55c293eebf31c0a234b774eb6cb","908698f97f84e6c3623eadb5f639d51df1680bb79d9c3089487aaa45049c5ac7","04f868ddc0f5c868549682723b8589908c13e9e190f2b2035840856d0cdb5f42","38a931674318661c6c70c37f1f5d5ff6eaf57a20c0bb22e8caa4b832e24e98cf"],"paragraph_range_zero_based":[28056,28079],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p28056"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon SpCell change (including path switch between a serving cell and a L2 U2N Relay UE) and upon serving cell (PSCell/SCell) addition. Otherwise, the field is absent.","paragraph_zero_based":28080},{"literal_text_all_w_t_and_m_t":"HOAndServCellWithSSB","paragraph_zero_based":28081},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon SpCell change and upon serving cell (SCell with SSB or PSCell) addition. Otherwise, the field is absent.","paragraph_zero_based":28082},{"literal_text_all_w_t_and_m_t":"SharedSpectrum","paragraph_zero_based":28083},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if this cell operates with shared spectrum channel access in FR1. Otherwise, it is absent, Need R.","paragraph_zero_based":28084},{"literal_text_all_w_t_and_m_t":"SharedSpectrum2","paragraph_zero_based":28085},{"literal_text_all_w_t_and_m_t":"This field is optionally present if this cell operates with shared spectrum channel access in FR2-2, Need R. Otherwise, it is absent, Need R.","paragraph_zero_based":28086},{"literal_text_all_w_t_and_m_t":"TDD","paragraph_zero_based":28087},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, for TDD cells; otherwise it is absent.","paragraph_zero_based":28088},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28089},{"literal_text_all_w_t_and_m_t":"–ServingCellConfigCommonSIB","paragraph_zero_based":28090},{"literal_text_all_w_t_and_m_t":"The IE ServingCellConfigCommonSIB is used to configure cell specific parameters of a UE's serving cell in SIB1.","paragraph_zero_based":28091},{"literal_text_all_w_t_and_m_t":"ServingCellConfigCommonSIB information element","paragraph_zero_based":28092},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28093},{"literal_text_all_w_t_and_m_t":"-- TAG-SERVINGCELLCONFIGCOMMONSIB-START","paragraph_zero_based":28094},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28095},{"literal_text_all_w_t_and_m_t":"ServingCellConfigCommonSIB ::=      SEQUENCE {","paragraph_zero_based":28096},{"literal_text_all_w_t_and_m_t":"    downlinkConfigCommon                DownlinkConfigCommonSIB,","paragraph_zero_based":28097},{"literal_text_all_w_t_and_m_t":"    uplinkConfigCommon                  UplinkConfigCommonSIB                                       OPTIONAL, -- Need R","paragraph_zero_based":28098},{"literal_text_all_w_t_and_m_t":"    supplementaryUplink                 UplinkConfigCommonSIB                                       OPTIONAL, -- Need R","paragraph_zero_based":28099},{"literal_text_all_w_t_and_m_t":"    n-TimingAdvanceOffset               ENUMERATED { n0, n25600, n39936 }                           OPTIONAL, -- Need S","paragraph_zero_based":28100},{"literal_text_all_w_t_and_m_t":"    ssb-PositionsInBurst                SEQUENCE {","paragraph_zero_based":28101},{"literal_text_all_w_t_and_m_t":"        inOneGroup                          BIT STRING (SIZE (8)),","paragraph_zero_based":28102},{"literal_text_all_w_t_and_m_t":"        groupPresence                       BIT STRING (SIZE (8))                                   OPTIONAL  -- Cond FR2-Only","paragraph_zero_based":28103}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["f746a30be26aca1433f38d3af96103749ddeb9d5079a118e18afd4c5da7d68f9","50069ead32c23e15f2e9edd609d5c5c376a90aa466836320ce278619f130188e","b10a45d2c94fd32d21a46bc9777f28680fb35011270f1257062e44eea366e755","a77162dbbc8e533e735cbdf935ac1376fb144932945c58c2e45ca800a196ee25","5b80192d49cd4470dbcddabef5f272174dc7cc135c1b7c41899830931bfbfa12","166248e032aff0d7d67e143b7f7367e052de83478b85d9e03f089bc8c8ea7201","e41e8195cacbe93a4865a2d12087261853ac2674425c0b82d1bcdf2028463913","ea7b301aedd9329b2d7784b482dd388393ec2004687cb601b6364ead6af01f89","6fe6682c7acb237afb94b1656505dc4249af87dcddd46d8e9f13af8b77f7f0a3","c9e115526d45fb3d479d5031ab69a0018a35494ec7d9d2cbe4fec2d383a7ead2","262de6df02047e947232a1f9976d8e8b655ac5a5f244e7accc239c215067017a","40947eff115c5f53835b1e89c14eb0779003ba09643df07cc7e2641b5e0da78d","d6d27595beb78215719b0ee46ab684798ec9324dfd424e6397ce157287c0d642","3fbc0ccc65207f5acf13f7b4aecb9695416508fcd42f467bc093c9335dadca3c","0ad6b63949cb534b996ca64546d9ba788b833ab053c09912e1685d5902cddbe3","23041424cdccd66a253ce2adbcbb1f8d805c66fe224fe6bdb20051cfeef86b89","d80910cac4800a6224073663d2b789c7014da08c5ad281060a5890941121efc2","b2817c0bc9b75dccca28d7d13d2c01b6a61e577e2afed4b49af4fafcefe67487","59d568c6e4fcb2da55f25f4332da87cc4e227d3ecc801d1ea5fff6cd9d2f899b","b6964f58eb77d84e596f10339e7bc00ff275ee467645c24a602eb97da0a0e218","e083d7f976fc7a92f8f9fc8861461025c412b38053ce7f3b4513f63fecff7503","9add87ee3eaf7a4e6b8c4a39dc6afc20dad01a9ef4e59141e8fdde5ecb353b7f","ab009ad72f32c05747e493de4afa411196d8c4b26b16c416649900dff060e4dc","664ff3b1489058955801bcba0b1eed80b19e3609a22d17546bac3b98eb0455c3"],"paragraph_range_zero_based":[28080,28103],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p28080"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":28104},{"literal_text_all_w_t_and_m_t":"    ssb-PeriodicityServingCell          ENUMERATED {ms5, ms10, ms20, ms40, ms80, ms160},","paragraph_zero_based":28105},{"literal_text_all_w_t_and_m_t":"    tdd-UL-DL-ConfigurationCommon       TDD-UL-DL-ConfigCommon                                      OPTIONAL, -- Cond TDD","paragraph_zero_based":28106},{"literal_text_all_w_t_and_m_t":"    ss-PBCH-BlockPower                  INTEGER (-60..50),","paragraph_zero_based":28107},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":28108},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":28109},{"literal_text_all_w_t_and_m_t":"    channelAccessMode-r16               CHOICE {","paragraph_zero_based":28110},{"literal_text_all_w_t_and_m_t":"        dynamic                             NULL,","paragraph_zero_based":28111},{"literal_text_all_w_t_and_m_t":"        semiStatic                          SemiStaticChannelAccessConfig-r16","paragraph_zero_based":28112},{"literal_text_all_w_t_and_m_t":"    }                                                                                               OPTIONAL, -- Cond SharedSpectrum","paragraph_zero_based":28113},{"literal_text_all_w_t_and_m_t":"    discoveryBurstWindowLength-r16      ENUMERATED {ms0dot5, ms1, ms2, ms3, ms4, ms5}               OPTIONAL, -- Need R","paragraph_zero_based":28114},{"literal_text_all_w_t_and_m_t":"    highSpeedConfig-r16                 HighSpeedConfig-r16                                         OPTIONAL  -- Need R","paragraph_zero_based":28115},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":28116},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":28117},{"literal_text_all_w_t_and_m_t":"    channelAccessMode2-r17              ENUMERATED {enabled}                                        OPTIONAL, -- Cond SharedSpectrum2","paragraph_zero_based":28118},{"literal_text_all_w_t_and_m_t":"    discoveryBurstWindowLength-v1700    ENUMERATED {ms0dot125, ms0dot25, ms0dot5, ms0dot75, ms1, ms1dot25} OPTIONAL,  -- Need R","paragraph_zero_based":28119},{"literal_text_all_w_t_and_m_t":"    highSpeedConfigFR2-r17              HighSpeedConfigFR2-r17                                      OPTIONAL, -- Need R","paragraph_zero_based":28120},{"literal_text_all_w_t_and_m_t":"    uplinkConfigCommon-v1700            UplinkConfigCommonSIB-v1700                                 OPTIONAL  -- Need R","paragraph_zero_based":28121},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":28122},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":28123},{"literal_text_all_w_t_and_m_t":"    enhancedMeasurementLEO-r17          ENUMERATED {true}                                           OPTIONAL  -- Need R","paragraph_zero_based":28124},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":28125},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":28126},{"literal_text_all_w_t_and_m_t":"    ra-ChannelAccess-r17                ENUMERATED {enabled}                                        OPTIONAL  -- Cond SharedSpectrum2","paragraph_zero_based":28127}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["dcb096fcac505cbe40edafd432fb4c0b72246f6b81553ccb3f6cf1666ec5c775","8f812f09390a6f5b9fab73759cac4c50551a96a977cf810b512d9d2f60f5d7f4","fc1d4afea4e6fe5d5d7a8a45c3baf52368b46da6a141d69071a55824275185d0","2abf82380c90f369f9aef4b7665a1042898c070bb60fd9cae9e6aeb2414a09f5","7ce530aebdc57743072824e4b0797408edfb718e8162c5b99a9c95331eec35f0","f74ea3230f66148ac8f0d9f7f977f17f72f346938b034643311ae67d4bcb9a8e","a2fa04a6fa551017a561f9168137a025115e063522426bba365a1525bf70ec57","231b298c962c1cc150cc12d6b27a6a4cd37f86d881059a39ec04ce7d6444fe08","cbad7f3fdc1e6642194f37b2e90fd3b0258087a3f61f41435f0a00370faba311","bff4bf603a0b872528e5ce46b5a197f9b02e0014593ffc0dc3cdaca391436a79","adad67dba69aba0b520c727f6d51715fee67a0de9bb0a593e03b6a532b985ea3","0d4416a659a05dcf6912d44005da99eb5b0425a54e6e3e172d3914a125703dd1","1fbf3b6c9ff55cf1131304e2ac2cf61096676c8453715dd9957a2364f0557589","de8fa79a9e7051cb157f9c0a5ad332b7057f1d93c8ce8d3f44498822fb99ebfa","f08636fe3d817692faa91a2fc485797daf8f02eeab049cc41de5d0fb683d5d39","677846693cf52ac1756bfd95379a28a808d2a87dcd8c06a3a7ce154e15b7b31b","1bcd5a2d5423fecc563b5a9dee0fb8bfbd66c492864d83437e7c85869e153742","fd8e15b136e1f4f3bc969f8eabead89d0ac2bf84ba09d77acf1ddd72a171afd3","4d62ae34f24c5048bf04037ab9017bd7dcaa25af39e6940c3be8a6786fa97493","232ea96079a8f22e4f4f09d981db2ca19991e18b6b7ad6adae8924bd0a2e975c","8cd43324c0960d06d4288d3821c005ec86c200bf026b20a35cd8305051f8dade","2e613923802a9b031ec18f0bfeecf4d496cd5e7e1c1e51c05cd3434747acbed8","2c514c9991a6bfd03c9f75bf9da5644a65140a66cfb2e509726fab542e7154ec","285d432d3ab617e825d5c81e9a4de611b17a36f6499d11aada621132df92e4be"],"paragraph_range_zero_based":[28104,28127],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p28104"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":28128},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":28129},{"literal_text_all_w_t_and_m_t":"    downlinkConfigCommon-v1760          DownlinkConfigCommonSIB-v1760                               OPTIONAL, -- Need R","paragraph_zero_based":28130},{"literal_text_all_w_t_and_m_t":"    uplinkConfigCommon-v1760            UplinkConfigCommonSIB-v1760                                 OPTIONAL  -- Need R","paragraph_zero_based":28131},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":28132},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28133},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28134},{"literal_text_all_w_t_and_m_t":"-- TAG-SERVINGCELLCONFIGCOMMONSIB-STOP","paragraph_zero_based":28135},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28136},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28137},{"literal_text_all_w_t_and_m_t":"ServingCellConfigCommonSIB field descriptions","paragraph_zero_based":28138},{"literal_text_all_w_t_and_m_t":"channelAccessMode","paragraph_zero_based":28139},{"literal_text_all_w_t_and_m_t":"If present, this field indicates which channel access procedures to apply for operation with shared spectrum channel access as defined in TS 37.213 [48]. If the field is configured as \"semiStatic\", the UE shall apply the channel access procedures for semi-static channel occupancy as described in clause 4.3 in TS 37.213. If the field is configured as \"dynamic\", the UE shall apply the channel access procedures as defined in TS 37.213, clause 4.1 and 4.2.","paragraph_zero_based":28140},{"literal_text_all_w_t_and_m_t":"channelAccessMode2","paragraph_zero_based":28141},{"literal_text_all_w_t_and_m_t":"If present, this field indicates that the UE shall apply channel access procedures for operation with shared spectrum channel access in accordance with TS 37.213 [48], clause 4.4 for FR2-2. If absent, the UE shall not apply any channel access procedure. The network always configures this field if channel access procedures are required for the serving cell within this region by regulations.","paragraph_zero_based":28142},{"literal_text_all_w_t_and_m_t":"discoveryBurstWindowLength","paragraph_zero_based":28143},{"literal_text_all_w_t_and_m_t":"Indicates the window length of the discovery burst in ms (see TS 37.213 [48]). The field discoveryBurstWindowLength-v1700 is applicable to SCS 480 kHz and SCS 960 kHz.","paragraph_zero_based":28144},{"literal_text_all_w_t_and_m_t":"enhancedMeasurementLEO","paragraph_zero_based":28145},{"literal_text_all_w_t_and_m_t":"If the field is present and UE supports the enhanced cell reselection requirements for NTN LEO in RRC_IDLE/RRC_INACTIVE, the UE shall apply the enhanced cell reselection requirements for NTN LEO as specified in TS 38.133 [14], clauses 4.2C.2.3 and 4.2C.2.4.","paragraph_zero_based":28146},{"literal_text_all_w_t_and_m_t":"groupPresence","paragraph_zero_based":28147},{"literal_text_all_w_t_and_m_t":"This field is present when maximum number of SS/PBCH blocks per half frame equals to 64 as defined in TS 38.213 [13], clause 4.1. The first/leftmost bit corresponds to the SS/PBCH index 0-7, the second bit corresponds to SS/PBCH block 8-15, and so on. Value 0 in the bitmap indicates that the SSBs according to inOneGroup are absent. Value 1 indicates that the SS/PBCH blocks are transmitted in accordance with inOneGroup.","paragraph_zero_based":28148},{"literal_text_all_w_t_and_m_t":"inOneGroup","paragraph_zero_based":28149},{"literal_text_all_w_t_and_m_t":"When maximum number of SS/PBCH blocks per half frame equals to 4 as defined in TS 38.213 [13], clause 4.1, only the 4 leftmost bits are valid; the UE ignores the 4 rightmost bits. When maximum number of SS/PBCH blocks per half frame equals to 8 as defined in TS 38.213 [13], clause 4.1, all 8 bits are valid. The first/ leftmost bit corresponds to SS/PBCH block index 0, the second bit corresponds to SS/PBCH block index 1, and so on. When maximum number of SS/PBCH blocks per half frame equals to 64 as defined in TS 38.213 [13], clause 4.1, all 8 bit are valid; The first/ leftmost bit corresponds to the first SS/PBCH block index in the group (i.e., to SSB index 0, 8, and so on); the second bit corresponds to the second SS/PBCH block index in the group (i.e., to SSB index 1, 9, and so on), and so on. Value 0 in the bitmap indicates that the corresponding SS/PBCH block is not transmitted while value 1 indicates that the corresponding SS/PBCH block is transmitted.","paragraph_zero_based":28150},{"literal_text_all_w_t_and_m_t":"n-TimingAdvanceOffset","paragraph_zero_based":28151}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["c7c2a624762a6e8de3ec2b5c42756eeb81ef030efb02544f5c437ef254c99c4e","8836f29d5acb66f839aba1849b6b1287f3d5647d738c8c26b8ca9b9803f12835","8d678d4bed6110b16475b726db722cd5485c36024046b75c797dbc59e92e3d70","77535e6d6863f8fc55add2839b7b0a56d115829e2b996324936082fb3d8ab916","bee5e218b5d534dc51d300b3ddc552663e94f543ba9d8e2b8d7126b1c6d5aa7b","9438a44dbbf7585c58314c060509b3bf576d168c702613b3729159886f00b8c7","cecd6bac4ccdac21b589a6212759ef2a9b4bdec87f858da98caed18fb5b70ee9","afd86e965a034b4517924b58a71effe112c8a3191f4bd32f7bfc68979c398f8f","5650ae386bd1c58c027996a26b59dee9c00cce35b7bc0f4d6dd0d9d31327d1a5","f0e942461274fcb43b52a9c04e3e56ffed19935ac58a2b305a6bab0a50c4e563","540d75481bc20c505764e7877355916155da309603182fd955d6d78b726cef56","090c7fa6104aeeb7b4b7f2cb930b67992400063d6f4276e5fbf320a77e2c2814","6ec43b3e5a4a1ad0ca8023e67b380c7c093fa4b4509e517b71a8a23969b563a2","fb78d29040338ec363384d1c7d4551bbb2cd9dbf713a11009b011ff4e42748bd","f78686cb7ca5567d1876210cabd2933442ed7c263c555e51cde44cc39b6d61c1","c999c7c10df6f1692d1df025384177f63f4fec5df46360e996371566f7fc0f39","2a677c5c549aff589e862ee03ac6c9d2f61c9f3e41a6588f892fa75b0822edd0","6e1b04c9474981e857ff3519aca2123160c2f75ef86a43eabf12f46cfba95ee7","755c0fdeab063d41ae6023ccb41a03d15b4951f66252acfc12b6ec36a04cbb8b","95f31445f8eef2320a871c2750c839f1ce867244e8538c5c606c0a673b9fa163","854de17fc7ed1e07bb615b191b63e5828ae0fddd5bcce1442518d4a2d74d36ca","6848818315b7e74fdcd695188280924951838c0df3a48e323f8bcba5d4adca94","dccdbc6d73eda69a3d357e6efb319603242218bd415369107d6992b35640f212","8f5c94846721532f8b037e021026c8c71c49e634dd76646a2826162858970543"],"paragraph_range_zero_based":[28128,28151],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p28128"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The N_TA-Offset to be applied for random access on this serving cell. If the field is absent, the UE applies the value defined for the duplex mode and frequency range of this serving cell. See TS 38.133 [14], table 7.1.2-2.","paragraph_zero_based":28152},{"literal_text_all_w_t_and_m_t":"ra-ChannelAccess","paragraph_zero_based":28153},{"literal_text_all_w_t_and_m_t":"If present, this field indicates that the UE shall apply channel access procedures before msg1/msgA transmission for operation with shared spectrum channel access in accordance with TS 37.213 [48], clause 4.4.5 for FR2-2.","paragraph_zero_based":28154},{"literal_text_all_w_t_and_m_t":"ssb-PositionsInBurst","paragraph_zero_based":28155},{"literal_text_all_w_t_and_m_t":"Time domain positions of the transmitted SS-blocks in an SS-burst as defined in TS 38.213 [13], clause 4.1.","paragraph_zero_based":28156},{"literal_text_all_w_t_and_m_t":"For operation with shared spectrum channel access in FR1, only inOneGroup is used and the UE interprets this field same as mediumBitmap in ServingCellConfigCommon. The UE assumes that a bit in inOneGroup at position k > NSSBQCL is 0, where NSSBQCL is obtained from MIB as specified in TS 38.213 [13], clause 4.1. For operation with shared spectrum channel access in FR2-2, the m-th bit in groupPresence is set to 0 for m > NSSBQCL/8, where NSSBQCL is obtained from MIB as specified in TS 38.213 [13], clause 4.1.","paragraph_zero_based":28157},{"literal_text_all_w_t_and_m_t":"ss-PBCH-BlockPower","paragraph_zero_based":28158},{"literal_text_all_w_t_and_m_t":"Average EPRE of the resources elements that carry secondary synchronization signals in dBm that the NW used for SSB transmission, see TS 38.213 [13], clause 7.","paragraph_zero_based":28159},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28160},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":28161},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":28162},{"literal_text_all_w_t_and_m_t":"FR2-Only","paragraph_zero_based":28163},{"literal_text_all_w_t_and_m_t":"This field is mandatory present for an FR2 carrier frequency. It is absent otherwise and UE releases any configured value.","paragraph_zero_based":28164},{"literal_text_all_w_t_and_m_t":"SharedSpectrum","paragraph_zero_based":28165},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if this cell operates with shared spectrum channel access in FR1. Otherwise, it is absent, Need R.","paragraph_zero_based":28166},{"literal_text_all_w_t_and_m_t":"SharedSpectrum2","paragraph_zero_based":28167},{"literal_text_all_w_t_and_m_t":"This field is optionally present if this cell operates with shared spectrum channel access in FR2-2, Need R. Otherwise, it is absent, Need R.","paragraph_zero_based":28168},{"literal_text_all_w_t_and_m_t":"TDD","paragraph_zero_based":28169},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, for TDD cells; otherwise it is absent.","paragraph_zero_based":28170},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28171},{"literal_text_all_w_t_and_m_t":"–ShortI-RNTI-Value","paragraph_zero_based":28172},{"literal_text_all_w_t_and_m_t":"The IE ShortI-RNTI-Value is used to identify the suspended UE context of a UE in RRC_INACTIVE using fewer bits compared to I-RNTI-Value.","paragraph_zero_based":28173},{"literal_text_all_w_t_and_m_t":"ShortI-RNTI-Value information element","paragraph_zero_based":28174},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28175}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec882