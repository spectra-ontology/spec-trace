{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ra-PreambleIndex","paragraph_zero_based":14784},{"literal_text_all_w_t_and_m_t":"The RA preamble index to use in the RA occasions associated with this CSI-RS. If the field is absent, the UE uses the preamble index associated with the SSB that is QCLed with this CSI-RS.","paragraph_zero_based":14785},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14786},{"literal_text_all_w_t_and_m_t":"BFR-SSB-Resource field descriptions","paragraph_zero_based":14787},{"literal_text_all_w_t_and_m_t":"ra-PreambleIndex","paragraph_zero_based":14788},{"literal_text_all_w_t_and_m_t":"The preamble index that the UE shall use when performing BFR upon selecting the candidate beams identified by this SSB.","paragraph_zero_based":14789},{"literal_text_all_w_t_and_m_t":"ssb","paragraph_zero_based":14790},{"literal_text_all_w_t_and_m_t":"The ID of an SSB transmitted by this serving cell. It determines a candidate beam for beam failure recovery (BFR).","paragraph_zero_based":14791},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14792},{"literal_text_all_w_t_and_m_t":"–BeamFailureRecoveryRSConfig","paragraph_zero_based":14793},{"literal_text_all_w_t_and_m_t":"The IE BeamFailureRecoveryRSConfig is used to configure the UE with candidate beams for beam failure recovery in case of beam failure detection. See also TS 38.321 [3], clause 5.17.","paragraph_zero_based":14794},{"literal_text_all_w_t_and_m_t":"BeamFailureRecoveryRSConfig information element","paragraph_zero_based":14795},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":14796},{"literal_text_all_w_t_and_m_t":"-- TAG-BEAMFAILURERECOVERYRSCONFIG-START","paragraph_zero_based":14797},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14798},{"literal_text_all_w_t_and_m_t":"BeamFailureRecoveryRSConfig-r16 ::= SEQUENCE {","paragraph_zero_based":14799},{"literal_text_all_w_t_and_m_t":"    rsrp-ThresholdBFR-r16               RSRP-Range                                                               OPTIONAL, -- Need M","paragraph_zero_based":14800},{"literal_text_all_w_t_and_m_t":"    candidateBeamRS-List-r16            SEQUENCE (SIZE(1..maxNrofCandidateBeams-r16)) OF CandidateBeamRS-r16     OPTIONAL, -- Need M","paragraph_zero_based":14801},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":14802},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":14803},{"literal_text_all_w_t_and_m_t":"    candidateBeamRS-List2-r17            SEQUENCE (SIZE(1..maxNrofCandidateBeams-r16)) OF CandidateBeamRS-r16     OPTIONAL  -- Need R","paragraph_zero_based":14804},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":14805},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14806},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14807}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["27c4ce00cac06cadd32df072d6b67ec47c46c7b4666b7738177159e892ffe912","1d13158b0ad1499cec9e26fe4563e7f9321ae65df1ba83f5709b29594e9fe239","e04137898d93b14d5c90157e948da3ec3bc17663e79521e3672264059682574d","021896e9ec4cfa0c3f246b1b010858e89e1fa7236cf6003c2a69a09b801c27c6","6592039d9611714cec7b86caad8a64138fa355e797890190bd073524d0162ac8","e5652dc41d99be010b3cb0cb347d6693b763b642f2c5fce78179ffc99427c002","b4eea2636f5a0df9e4e451d2bb2656d4b82db3d8e7a1c25eefa370374ba9012b","b2c9522666bea7df12ed785c58990a0c41423ef5c1e7b769238b1f9bfde0de22","5f69b61e3922fe19d900724e3596cc4a26095bf8111d509ab381b8193769c1d4","3259959bf32f63376e95ecaff9c8f9c2b7e1bed2a57adaf67d9daeef5cf