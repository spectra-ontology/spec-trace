information element","paragraph_zero_based":14585},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":14586},{"literal_text_all_w_t_and_m_t":"-- TAG-AVAILABILITYCOMBINATIONSPERCELL-START","paragraph_zero_based":14587},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14588},{"literal_text_all_w_t_and_m_t":"AvailabilityCombinationsPerCell-r16 ::=     SEQUENCE {","paragraph_zero_based":14589},{"literal_text_all_w_t_and_m_t":"    availabilityCombinationsPerCellIndex-r16     AvailabilityCombinationsPerCellIndex-r16,","paragraph_zero_based":14590},{"literal_text_all_w_t_and_m_t":"    iab-DU-CellIdentity-r16                      CellIdentity,","paragraph_zero_based":14591}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["265a2bd577595314d4d53d3ccf15265463e78bdea91a24988946d9fb2c150461","b65b83b7c7f2b881aa46e10d0234e1ddbd7632ef8113ce1512da91cbb0a9f83b","f412f396371456c1fff44a5a489b1c1080aa28c1b738a22f9bb9a4e79ffe27ff","3d71ba18e179634a766968135a4ff75dba1a63d1252c21536cb2aacdb01806d4","52d8c0216aa8241eaf818c27161fe083016243cee3dfd008d2ba82349a279644","0de39b734213e7df80d5c966f1dbac02c3b7a5f0f07f026ccc49ba0c30e8f3ac","243948a587c149d7eb47e36fd4e35f8636f1f9bae8725205db488afc52dab788","f685a2da8f509206279b2607445a8d5cd72be4412901d37d3b9d9f9dc64dde8b","70da17e62da6fddff3a8a99fd6105b98b3aadf89d89ae8e636fa6a2a369a67e8","e2f4d42d97d8dbdd5c3a278f79274d95dc41997d9ec589b59055e116a00980b5","815d627099bb82459e0c07b66df45a18cd0fedbb4611f69767b3018a06246a01","3563e01aab85a06b1959d7464c5a899c6db8d589856383118a350d4f3f0847e1","9931247a83fc2d5ad366c4f8dd80feb8361deaf47bf1d0663937e384a6f360f3","3193cdd2a3af23d246922dfb57c6be268fdf4a7a94ddec28d914cfbfb5e83d34","8607a