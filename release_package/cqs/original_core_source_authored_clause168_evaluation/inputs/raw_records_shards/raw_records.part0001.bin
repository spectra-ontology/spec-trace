{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36744},{"literal_text_all_w_t_and_m_t":"–EUTRA-MBSFN-SubframeConfigList","paragraph_zero_based":36745},{"literal_text_all_w_t_and_m_t":"The IE EUTRA-MBSFN-SubframeConfigList is used to define an E-UTRA MBSFN subframe pattern (for the purpose of NR rate matching).","paragraph_zero_based":36746},{"literal_text_all_w_t_and_m_t":"EUTRA-MBSFN-SubframeConfigList information element","paragraph_zero_based":36747},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36748},{"literal_text_all_w_t_and_m_t":"-- TAG-EUTRA-MBSFN-SUBFRAMECONFIGLIST-START","paragraph_zero_based":36749},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36750},{"literal_text_all_w_t_and_m_t":"EUTRA-MBSFN-SubframeConfigList ::= SEQUENCE (SIZE (1..maxMBSFN-Allocations)) OF EUTRA-MBSFN-SubframeConfig","paragraph_zero_based":36751},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36752},{"literal_text_all_w_t_and_m_t":"EUTRA-MBSFN-SubframeConfig ::=      SEQUENCE {","paragraph_zero_based":36753},{"literal_text_all_w_t_and_m_t":"    radioframeAllocationPeriod          ENUMERATED {n1, n2, n4, n8, n16, n32},","paragraph_zero_based":36754},{"literal_text_all_w_t_and_m_t":"    radioframeAllocationOffset          INTEGER (0..7),","paragraph_zero_based":36755},{"literal_text_all_w_t_and_m_t":"    subframeAllocation1                 CHOICE {","paragraph_zero_based":36756},{"literal_text_all_w_t_and_m_t":"        oneFrame                            BIT STRING (SIZE(6)),","paragraph_zero_based":36757},{"literal_text_all_w_t_and_m_t":"        fourFrames                          BIT STRING (SIZE(24))","paragraph_zero_based":36758},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":36759},{"literal_text_all_w_t_and_m_t":"    subframeAllocation2                 CHOICE {","paragraph_zero_based":36760},{"literal_text_all_w_t_and_m_t":"        oneFrame                            BIT STRING (SIZE(2)),","paragraph_zero_based":36761},{"literal_text_all_w_t_and_m_t":"        fourFrames                          BIT STRING (SIZE(8))","paragraph_zero_based":36762},{"literal_text_all_w_t_and_m_t":"    }                                                                                                       OPTIONAL,   -- Need R","paragraph_zero_based":36763},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":36764},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":36765},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36766},{"literal_text_all_w_t_and_m_t":"-- TAG-EUTRA-MBSFN-SUBFRAMECONFIGLIST-STOP","paragraph_zero_based":36767}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["e1383528068039e32adc9e65086fb823627e6f019e0dd67c38c59b9593d82199","760d4bb6b2c23bb79474339d2e80ba0e39a108a6bf9cab87606cbb2b4269b496","45101fdc994344c11fd7eb863163982a7a44790a24955ef4a245a02a3805c82c","df73c5506dfcc0279a440903935746b6206b1a775c61f8495d20ca337ebd5848","cdfb18140c3633b4e1db81c40f24630b2430c1c37e871210e32f40224b2cb03d","5a35ce46b8fbded3223f6168188f9845c07a4431c5c3bd8c6144425ec0f9d2ec","531499be25d70aa6a55c6ada0d180b6ab975e13dc5d7f114106854ad3d75f72b","510f43e9df253c3bcd6e8eabedde66c0ec5b50948428c8557310c6ecab3a69fb","b5e1e91b042a64826a9516ef8227c81cebdcc1cac1c686075f4643e2c7ae0a10","266cdcca5bf75af57d0f86372189b39bbefed6cd4bae707c055f1624c8b86308","b1d2f27e7ff4192ab75c877c9c948f0137374874ee9bf7ff8a292b9e3dffc60d","d500ec81fd36c76d565fe213382d2c3bb8580fb237c1347c5402c5f6d9474d93","0cac1eeecccbce0cfdf4012047cb863cf