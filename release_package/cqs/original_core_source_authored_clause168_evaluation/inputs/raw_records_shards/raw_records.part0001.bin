naryMobilityEvaluation-r17        SEQUENCE {","paragraph_zero_based":13164},{"literal_text_all_w_t_and_m_t":"            s-SearchDeltaP-Stationary-r17           ENUMERATED {dB2, dB3, dB6, dB9, dB12, dB15, spare2, spare1},","paragraph_zero_based":13165},{"literal_text_all_w_t_and_m_t":"            t-SearchDeltaP-Stationary-r17           ENUMERATED {s5, s10, s20, s30, s60, s120, s180, s240, s300, spare7, spare6, spare5,","paragraph_zero_based":13166},{"literal_text_all_w_t_and_m_t":"                                                                spare4, spare3, spare2, spare1}","paragraph_zero_based":13167},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":13168},{"literal_text_all_w_t_and_m_t":"        cellEdgeEvaluationWhileStationary-r17   SEQUENCE {","paragraph_zero_based":13169},{"literal_text_all_w_t_and_m_t":"            s-SearchThresholdP2-r17                 ReselectionThreshold,","paragraph_zero_based":13170},{"literal_text_all_w_t_and_m_t":"            s-SearchThresholdQ2-r17                 ReselectionThresholdQ                   OPTIONAL        -- Need R","paragraph_zero_based":13171},{"literal_text_all_w_t_and_m_t":"        }                                                                                   OPTIONAL,       -- Need R","paragraph_zero_based":13172},{"literal_text_all_w_t_and_m_t":"        combineRelaxedMeasCondition2-r17        ENUMERATED {true}                           OPTIONAL        -- Need R","paragraph_zero_based":13173},{"literal_text_all_w_t_and_m_t":"    }                                                                                       OPTIONAL        -- Need R","paragraph_zero_based":13174},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":13175}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["d5a87421ff9bfb173c740de10f0efd7f7cd3edf29e7b7c2a31131e2244cf0484","8746f0d3135aeef9675f4ddfe99dc967a1fc1ca0bfdded469e2a9920c1ff3366","6ab125eaf710cb62bbc8aba58fec2d5bf8297d5e498afc8e394be054778c3be5","8a4dca7ec279a3d118deab1a8db201e178c39c1d8214a88e1a0cb01bfe43b2bf","80ffbed6316c357971462fb46a82a19db83541de046d0093e5391176165605bb","bc97dafe5afedfd5150e2b047ec4d198eff03d315649e93ff90ea3173405a09b","fac8b945645084d0323619a383e7877597f72f82261f1f0c8b4a93e573c4c0c1","ab43430e5e3eb9250b1001f9c4e8197f3dc02df1e91307cf045b3b80832041c5","f2e135f9b26ec35bb340f900be49f6929eceeb20ef36de1fd75f98d51af35a16","d066cd2cabd4f5be2e9ea0c1dce9fb7f4b5aed824bd280f67779675f24f2f526","3ede5c5e535fda24c26bcecbc41cc5531921e68e95915cbd8521a9b3fdea8300","5bdf1eccbf15e599bb0e20162857340533e3198c3467b3180bd8c8925a391ac0","9ab932514cf3884223c23523d5876a5e0b32da797196f089f9a405b144ae75f1","9476f59de821c2a5cc8f230cc253616973e028de05a37612a880e0708e9bbb08","dc727c1ba843b80e9ea99b0b56a56a0e65126c7f3337e54528e15686fd590b73","beeef5e432cc0a5fbb7e21fb8685967819877135672acbfc99323bd6d6549b80","4f9b8200e115fba86ea200d51c973d22d99355610b9a0bb09d12c214aa4cf92a","221a9889c2b7334e1b7648d9b5da7a53f4be7231e1ad72817e4aea20a03a9143","860361e54f22eccea72522bc5c8b5da117407aa015e63e997da9d819978544e7","2f52a721cf7d80ecb68c77f72c1da9b33e1f528a29d9533d0511ce42ccc6f545","c497f06372094d866916df9796926d6fef23d6befacd018c38886e6988ec31d4","f0c7b095113229c042a10177f2644bbc0b3227a38ebe13382a6abcb5726a5760","3f9973d47e397a3c9fc0b1c2663f15ac8f71e973920d7e98f7111c0e4b054f61","aa3687f17004e0f941eb7bafcfa6180f54349ce20215ff783ccad94f0bb0887a"],"paragraph_range_zero_based":[13152,13175],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p13152"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":13176},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13177},{"literal_text_all_w_t_and_m_t":"RangeToBestCell    ::= Q-OffsetRange","paragraph_zero_based":13178},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13179},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB2-STOP","paragraph_zero_based":13180},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":13181},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13182},{"literal_text_all_w_t_and_m_t":"SIB2 field descriptions","paragraph_zero_based":13183},{"literal_text_all_w_t_and_m_t":"absThreshSS-BlocksConsolidation","paragraph_zero_based":13184},{"literal_text_all_w_t_and_m_t":"Threshold for consolidation of L1 measurements per RS index. If the field is absent, the UE uses the measurement quantity as specified in TS 38.304 [20].","paragraph_zero_based":13185},{"literal_text_all_w_t_and_m_t":"cellEdgeEvaluation","paragraph_zero_based":13186},{"literal_text_all_w_t_and_m_t":"Indicates the criteria for a UE to detect that it is not at cell edge, in order to relax measurement requirements for cell reselection (see TS 38.304 [20], clause 5.2.4.9.2).","paragraph_zero_based":13187},{"literal_text_all_w_t_and_m_t":"cellEdgeEvaluationWhileStationary","paragraph_zero_based":13188},{"literal_text_all_w_t_and_m_t":"Indicates the criteria for a UE to detect that it is not at cell edge while stationary, in order to relax measurement requirements for cell reselection (see TS 38.304 [20], clause 5.2.4.9.4).","paragraph_zero_based":13189},{"literal_text_all_w_t_and_m_t":"cellEquivalentSize","paragraph_zero_based":13190},{"literal_text_all_w_t_and_m_t":"The number of cell count used for mobility state estimation for this cell as specified in TS 38.304 [20].","paragraph_zero_based":13191},{"literal_text_all_w_t_and_m_t":"cellReselectionInfoCommon","paragraph_zero_based":13192},{"literal_text_all_w_t_and_m_t":"Cell re-selection information common for intra-frequency, inter-frequency and/ or inter-RAT cell re-selection.","paragraph_zero_based":13193},{"literal_text_all_w_t_and_m_t":"cellReselectionServingFreqInfo","paragraph_zero_based":13194},{"literal_text_all_w_t_and_m_t":"Information common for non-intra-frequency cell re-selection i.e. cell re-selection to inter-frequency and inter-RAT cells.","paragraph_zero_based":13195},{"literal_text_all_w_t_and_m_t":"combineRelaxedMeasCondition","paragraph_zero_based":13196},{"literal_text_all_w_t_and_m_t":"When both lowMobilityEvalutation and cellEdgeEvalutation criteria are present in SIB2, this parameter configures the UE to fulfil both criteria in order to relax measurement requirements for cell reselection. If the field is absent, the UE is allowed to relax measurement requirements for cell reselection when either or both of the criteria are met. (See TS 38.304 [20], clause 5.2.4.9.0)","paragraph_zero_based":13197},{"literal_text_all_w_t_and_m_t":"combineRelaxedMeasCondition2","paragraph_zero_based":13198},{"literal_text_all_w_t_and_m_t":"When both stationaryMobilityEvaluation and cellEdgeEvaluationWhileStationary criteria are present in SIB2, this parameter configures the UE to fulfil both criteria in order to relax measurement requirements for cell reselection. If the field is absent, the UE is allowed to relax measurement requirements for cell reselection when only the stationary criteria is met. (See TS 38.304 [20], clause 5.2.4.9.0)","paragraph_zero_based":13199}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["588d94d824b3f618e5251e231b0fac8dc87e5a636eb7bd5b94bf85c836631594","bd13188cf60b0e67bbdfdde3b0dc7cf684c29cb4a0d0bb07f7d437a9536d47c8","6e8894e5ab5ff9cbba739e4899edb98229311d0d664467d92af732695678b604","41ee6b4923264f066ef9a4e8bb25c726b1b3ed2cd7a3e8ff866afe8fb0f39e8c","68fe628d6a392ff782956b14d11a3fcc8036cc7739b48c46b231f690d1e02c08","f01070b59d648e91dc8d85bb5d3d40112b7ec77319751c46a0da460fd3c0276e","948b6d8f726997ea1a108d23618fdb4b6048f8311d328352a0887a57c691d3d5","fc3eefb14d9e07546c9bf3837f0d0fad187f4457faa78abe27cebe8b40c5c45f","b1e6fb1bb904bce1b9fba6a607ba7427d84913518550d511e72c4f263d457a77","b18ac7db5367c7b5173e1fd3ebbb7f4953aafba0f9994cedc2baab4d0e64222a","a18978793cdb3dc7d2544efa246056aa1fd8c6e0150e3cd8c24ea51c3eb82a8e","df84984241e56561b7b537a9f7d7e693369f82b5628d322e33f6cd17f7c65bab","5a1676246c7c50e12cc9195a7415cbb0e22ab968f0ccf1b01915c0c30bee92d1","de8aa9f7f2886bdb367876a5b072f9c8aa8f95c4c87797acc5dcc9032144d5b8","0d2b9c98c6843a785c2c931204eb897c9739619db2ad0a189a219cdc198ce7f1","2723b1ee631b90e37410c3e4df5719892f434f85f8527eafd85d664fd1e654c5","9fee037151ce1b18efbd0b21d43fd5f6943f628fcddfe733761d2e165ff9f90a","3bd030c63535e98e52069a46b46baa7b4e1cf0bae54b9f736a5d713f3903cd94","41afff7b7f1e458cd8fe8a858defd6df200c1817bbcfc83fc1fb33db9998b4d9","f6b91e6731f118cce31b4f4cedaa5ee4faf49832de6ec5e7d8d0ec23560ae731","4d83e63d2d56922737e10e2abbdb325c5c9dbdd0d6141240568499c96fca612c","6aca2d9846a116efe06223f214c3671fe20c6e83a8a8f2b6b38ecf1ddd6e12b7","d21b6e08c664e4b2cebbe63a5ec61462cbfab661ce02a47e4c70849c5213389c","9d0410485abe354f74cc73cd47aad313de93d7cb59587ccaf1fb4d82163497fb"],"paragraph_range_zero_based":[13176,13199],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p13176"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"deriveSSB-IndexFromCell","paragraph_zero_based":13200},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE can utilize serving cell timing to derive the index of SS block transmitted by neighbour cell. If this field is set to true, the UE assumes SFN and frame boundary alignment across cells on the serving frequency as specified in TS 38.133 [14].","paragraph_zero_based":13201},{"literal_text_all_w_t_and_m_t":"frequencyBandList","paragraph_zero_based":13202},{"literal_text_all_w_t_and_m_t":"Indicates the list of frequency bands for which the NR cell reselection parameters apply. The UE behaviour in case the field is absent is described in clause 5.2.2.4.3.","paragraph_zero_based":13203},{"literal_text_all_w_t_and_m_t":"frequencyBandListAerial","paragraph_zero_based":13204},{"literal_text_all_w_t_and_m_t":"Indicates the list of frequency bands for aerial operation for which the NR cell reselection parameters apply. The UE behaviour in case the field is absent is described in clause 5.2.2.4.3.","paragraph_zero_based":13205},{"literal_text_all_w_t_and_m_t":"highPriorityMeasRelax","paragraph_zero_based":13206},{"literal_text_all_w_t_and_m_t":"Indicates whether measurements can be relaxed on high priority frequencies. If the field is absent, the UE shall not relax measurements on high priority frequencies beyond \"Thigher_priority_search\" unless both low mobility and not at cell edge criteria are fulfilled (see TS 38.133 [14], clauses 4.2.2.7, 4.2.2.10 and 4.2.2.11).","paragraph_zero_based":13207},{"literal_text_all_w_t_and_m_t":"intraFreqCellReselectionInfo","paragraph_zero_based":13208},{"literal_text_all_w_t_and_m_t":"Cell re-selection information common for intra-frequency cells.","paragraph_zero_based":13209},{"literal_text_all_w_t_and_m_t":"lowMobilityEvaluation","paragraph_zero_based":13210},{"literal_text_all_w_t_and_m_t":"Indicates the criteria for a UE to detect low mobility, in order to relax measurement requirements for cell reselection (see TS 38.304 [20], clause 5.2.4.9.1).","paragraph_zero_based":13211},{"literal_text_all_w_t_and_m_t":"nrofSS-BlocksToAverage","paragraph_zero_based":13212},{"literal_text_all_w_t_and_m_t":"Number of SS blocks to average for cell measurement derivation. If the field is absent the UE uses the measurement quantity as specified in TS 38.304 [20].","paragraph_zero_based":13213},{"literal_text_all_w_t_and_m_t":"p-Max","paragraph_zero_based":13214},{"literal_text_all_w_t_and_m_t":"Value in dBm applicable for the intra-frequency neighbouring NR cells. If absent the UE applies the maximum power according to TS 38.101-1 [15] in case of an FR1 cell, TS 38.101-2 [39] in case of an FR2 cell or TS 38.101-5 [75] in case of an NTN cell. In this release of the specification, if p-Max is present on a carrier frequency in FR2, the UE shall ignore the field and applies the maximum power according to TS 38.101-2 [39]. This field is ignored by IAB-MT. The IAB-MT applies output power and emissions requirements, as specified in TS 38.174 [63].","paragraph_zero_based":13215},{"literal_text_all_w_t_and_m_t":"q-Hyst","paragraph_zero_based":13216},{"literal_text_all_w_t_and_m_t":"Parameter \"Qhyst\" in TS 38.304 [20], Value in dB. Value dB1 corresponds to 1 dB, dB2 corresponds to 2 dB and so on.","paragraph_zero_based":13217},{"literal_text_all_w_t_and_m_t":"q-HystSF","paragraph_zero_based":13218},{"literal_text_all_w_t_and_m_t":"Parameter \"Speed dependent ScalingFactor for Qhyst\" in TS 38.304 [20]. The sf-Medium and sf-High concern the additional hysteresis to be applied, in Medium and High Mobility state respectively, to Qhyst as defined in TS 38.304 [20]. In dB. Value dB-6 corresponds to -6dB, dB-4 corresponds to -4dB and so on.","paragraph_zero_based":13219},{"literal_text_all_w_t_and_m_t":"q-QualMin","paragraph_zero_based":13220},{"literal_text_all_w_t_and_m_t":"Parameter \"Qqualmin\" in TS 38.304 [20], applicable for intra-frequency neighbour cells. If the field is absent, the UE applies the (default) value of negative infinity for Qqualmin.  ","paragraph_zero_based":13221},{"literal_text_all_w_t_and_m_t":"q-RxLevMin","paragraph_zero_based":13222},{"literal_text_all_w_t_and_m_t":"Parameter \"Qrxlevmin\" in TS 38.304 [20], applicable for intra-frequency neighbour cells.","paragraph_zero_based":13223}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["fe42f97a5691c8d766846425f36e70315db55ebc441a491440807ac2282d58b9","89907a82e9275be8a62d6c634d3dd0243897e5a1f6060e6d96be8d3b6f20fac8","ee82bf32c6caa70f353d5bada61e2164a938a7103d23bff4167b5a1b0d849e2a","8d922880ce83177add1f5c29738cb11211329a90e01ebf797fe1108c77e3420b","eacdc03a9b4fd05fca22918de1d6eb00e401314315fd5d5f50cca91014651c80","320ae3ca78039da798bce266f338758c57c04b2343e58c2bbcb9505f3bdb77cb","94c93a8544e9515ea2f1245c8f18de71def8c3ec37c52cb580d6d9aab81ca784","983c8871bbd44c9aafdeb0c5684806732d3a80600ce11a9bfd56b16faed530e4","ffcc91ca7f2b3c18d6462eaf33c7b0f31d96ebb2ca30297d05053c0c0d2d8cd7","71d37fd072b7d1f312fc77277d4daec9fe487db78af0a4f895c51c1e7ce21167","43d1a736d0a27e789d79a2cacb2008ee08040c80daaffcd2c3be2ea1718ddb0c","a28507b81c432a12e6bb895c05c959543635f3d5860a500f5732e3f423b6116c","de5104c11b0891abecbf0fc2accd62599839b5074d6e646e4e2f355156c28d46","f1a5746668d1955f88415f87a147aa53afe5ecdc50054341674f03d1b78f2f98","ea5be6648cb79299f50c56a9ab6f48db1245ab38aad0aca106e4fdcfae2f8edb","f60502b40da1530ddbb4c59d7ff03e9f9de141b906513b8afaed3d5969e08ba2","610b91a5fe555ab4a1f020d2434dc5527c3ad7f321c6eb97e99d66b6ac9c0d2f","69efe32ed3d3f140886ad257b206c89ca40d6c95716658727b94077c4c3c7f18","4266100018011aeb5e25cb3a2c3f5e9475baedc5099a7cd03810211d061041f0","e360077c8db4fbb633c961dfc2d854ca04287939775b571b1eed85e89945a1d9","6da0df6cc29f99f8abfd6cf9f60d1088553732c7f6483aba65ec366301c1b811","453f17fd8006b22b9405d99b5a3b8fc60c2e4a10a87845afcb09ffb7fbcaee3a","4a84c620aa4f4dba0e06fadb5bd823908c30c0132ee76fd6555e55d23f21f176","64e956e1049d6f65f871afcbb621f606e0efcd5264e2006e7c0bc3521ac346d0"],"paragraph_range_zero_based":[13200,13223],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p13200"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"q-RxLevMinSUL","paragraph_zero_based":13224},{"literal_text_all_w_t_and_m_t":"Parameter \"Qrxlevmin\" in TS 38.304 [20], applicable for intra-frequency neighbour cells.","paragraph_zero_based":13225},{"literal_text_all_w_t_and_m_t":"rangeToBestCell","paragraph_zero_based":13226},{"literal_text_all_w_t_and_m_t":"Parameter \"rangeToBestCell\" in TS 38.304 [20]. The network configures only non-negative (in dB) values.","paragraph_zero_based":13227},{"literal_text_all_w_t_and_m_t":"relaxedMeasurement","paragraph_zero_based":13228},{"literal_text_all_w_t_and_m_t":"Configuration to allow relaxation of RRM measurement requirements for cell reselection (see TS 38.304 [20], clause 5.2.4.9). In NTN, this field is only applicable for GSO neighbour cells.","paragraph_zero_based":13229},{"literal_text_all_w_t_and_m_t":"s-IntraSearchP","paragraph_zero_based":13230},{"literal_text_all_w_t_and_m_t":"Parameter \"SIntraSearchP\" in TS 38.304 [20].","paragraph_zero_based":13231},{"literal_text_all_w_t_and_m_t":"s-IntraSearchQ","paragraph_zero_based":13232},{"literal_text_all_w_t_and_m_t":"Parameter \"SIntraSearchQ\" in TS 38.304 [20]. If the field is absent, the UE applies the (default) value of 0 dB for SIntraSearchQ.","paragraph_zero_based":13233},{"literal_text_all_w_t_and_m_t":"s-NonIntraSearchP","paragraph_zero_based":13234},{"literal_text_all_w_t_and_m_t":"Parameter \"SnonIntraSearchP\" in TS 38.304 [20]. If this field is absent, the UE applies the (default) value of infinity for SnonIntraSearchP.","paragraph_zero_based":13235},{"literal_text_all_w_t_and_m_t":"s-NonIntraSearchQ","paragraph_zero_based":13236},{"literal_text_all_w_t_and_m_t":"Parameter \"SnonIntraSearchQ\" in TS 38.304 [20]. If the field is absent, the UE applies the (default) value of 0 dB for SnonIntraSearchQ.","paragraph_zero_based":13237},{"literal_text_all_w_t_and_m_t":"s-SearchDeltaP","paragraph_zero_based":13238},{"literal_text_all_w_t_and_m_t":"Parameter \"SSearchDeltaP\" in TS 38.304 [20]. Value dB3 corresponds to 3 dB, dB6 corresponds to 6 dB and so on.","paragraph_zero_based":13239},{"literal_text_all_w_t_and_m_t":"s-SearchDeltaP-Stationary","paragraph_zero_based":13240},{"literal_text_all_w_t_and_m_t":"Parameter \"SSearchDeltaP-Stationary\" in TS 38.304 [20]. Value dB2 corresponds to 2 dB, dB3 corresponds to 3 dB and so on.","paragraph_zero_based":13241},{"literal_text_all_w_t_and_m_t":"s-SearchThresholdP, s-SearchThresholdP2","paragraph_zero_based":13242},{"literal_text_all_w_t_and_m_t":"Parameters \"SSearchThresholdP\" and \"SSearchThresholdP2\" in TS 38.304 [20]. The network configures s-SearchThresholdP and s-SearchThresholdP2 to be less than or equal to s-IntraSearchP and s-NonIntraSearchP.","paragraph_zero_based":13243},{"literal_text_all_w_t_and_m_t":"s-SearchThresholdQ, s-SearchThresholdQ2","paragraph_zero_based":13244},{"literal_text_all_w_t_and_m_t":"Parameters \"SSearchThresholdQ\" and \"SSearchThresholdQ2\" in TS 38.304 [20]. The network configures s-SearchThresholdQ and s-SearchThresholdQ2 to be less than or equal to s-IntraSearchQ and s-NonIntraSearchQ.","paragraph_zero_based":13245},{"literal_text_all_w_t_and_m_t":"smtc","paragraph_zero_based":13246},{"literal_text_all_w_t_and_m_t":"Measurement timing configuration for intra-frequency measurement. If this field is absent, the UE assumes that SSB periodicity is 5 ms for the intra-frequnecy cells. If the field is broadcast by an NTN cell, the offset (derived from parameter periodicityAndOffset) is based on the assumption that the gNB-UE propagation delay difference between the serving cell and neighbour cells equals to 0 ms, and UE can adjust the actual offset based on the actual propagation delay difference.","paragraph_zero_based":13247}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["bf4844322aea732a9904424ddbc0357d061ae2aac45beabda6593a9b4d69da08","9b2fe45727b82a749383826cc3de275d5796293076327d52aeab08d09b7a5aad","e53ce6040abe268006e8beeb96159439a565212825e292df09006085cdcb0d8e","2bc6b6e5633ffa6ad9c117b1bbc4c10d6889d238b1ee7b56c77665f2c6dee59c","7d64345ad8447b2378d4a50fdaf6be9fa6fdae6a655f2ab24e7bd1a9c86f991a","2b8095e3dbd1f42627528f08457979a6da78011d6e0eddb1b91c12e105bd214e","3fdc153b4969946117e752b9b6c65dee0fd664039bf1161f477a314b4b509ced","a76adfac785cef59a97a5cf7cd2c2e88819a100c64bb31c6efa590ef01bbb8ce","cace97e42fbce724696a38018805ded93d825f60021d5fbd5f37bd3bd3bb7b80","be68e4e70178f66c825234bb69f25b9426b5138e00389ed8b193de25e81a5271","950629508b74a597d084315de449e43a8ee7f2dd8a0e9c61ee328cae63197b38","0be6603ec0ddc7893a6bf2c7016cbc71158799ed6c83d71df3c21dee14958ad7","c8b4dffa54f9a395235fb6b99b5187af09772fea368559b5b90e854d2176555e","7881ba887905655a485f34d9ddc4a4d14c0bbd4904954fab51749750fbd4a325","f9ecb417a0d140fd8c82f33ce9ebe79785488b3db2289a597b614f327528c361","51ccaa6e4419c600bfdcc79703bd7f39208a4ca70a86cf8da8718a5b8adead7a","734053d776c5f429974c317769aa71ae53afdf355ed7e7c7c155bc16606eb4bd","a3f8fe0f01a79153465963ddb605cd74940bccfa114e1c4218c47d21df987af9","3b8f6b5d58b1e87f7c1676e53c595343fdf93715113d303f245b23edc48484b7","103c161ce3050eb2e2dbf63a081e49b509caa9260b399f427ec868a7a0428b82","ddd150e9c9e7f6023979c2340238e4ed184e671a15957cbf609f757ea9b20ea5","c9d014d9fac9003870157c4dee16f4fd2ba3a15b170382bfa2df6b5f84e6c4c0","d2eec8b466c5630df02ff68026475733285e489544255758da9c10f643252cb7","d20ba5ea5cac1474c92d66915839befafaf94933794f472d29c38c5bd49098d0"],"paragraph_range_zero_based":[13224,13247],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p13224"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"smtc2-LP","paragraph_zero_based":13248},{"literal_text_all_w_t_and_m_t":"Measurement timing configuration for intra-frequency neighbour cells with a Long Periodicity (LP) indicated by periodicity in smtc2-LP. The timing offset and duration are equal to the offset and duration indicated in smtc in intraFreqCellReselectionInfo. The periodicity in smtc2-LP can only be set to a value strictly larger than the periodicity in smtc in intraFreqCellReselectionInfo (e.g. if smtc indicates sf20 the Long Periodicity can only be set to sf40, sf80 or sf160, if smtc indicates sf160, smtc2-LP cannot be configured). The pci-List, if present, includes the physical cell identities of the intra-frequency neighbour cells with Long Periodicity. If smtc2-LP is absent, the UE assumes that there are no intra-frequency neighbour cells with a Long Periodicity.","paragraph_zero_based":13249},{"literal_text_all_w_t_and_m_t":"smtc4list","paragraph_zero_based":13250},{"literal_text_all_w_t_and_m_t":"Measurement timing configuration list for NTN deployments, see clause 5.5.2.10. The offset of each SSB-MTC4 in smtc4list is based on the assumption that the gNB-UE propagation delay difference between the serving cell and neighbour cells equals to 0 ms, and UE can adjust the actual offset based on the actual propagation delay difference. For a UE that supports less SMTCs than what is included in this list, it is up to the UE to select which SMTCs to consider.","paragraph_zero_based":13251},{"literal_text_all_w_t_and_m_t":"ssb-PositionQCL-Common","paragraph_zero_based":13252},{"literal_text_all_w_t_and_m_t":"Indicates the QCL relation between SS/PBCH blocks for intra-frequency neighbor cells as specified in TS 38.213 [13], clause 4.1.","paragraph_zero_based":13253},{"literal_text_all_w_t_and_m_t":"ssb-ToMeasure","paragraph_zero_based":13254},{"literal_text_all_w_t_and_m_t":"The set of SS blocks to be measured within the SMTC measurement duration (see TS 38.215 [9]). When the field is absent the UE measures on all SS-blocks.","paragraph_zero_based":13255},{"literal_text_all_w_t_and_m_t":"stationaryMobilityEvaluation","paragraph_zero_based":13256},{"literal_text_all_w_t_and_m_t":"Indicates the criteria for a UE to detect stationary mobility, in order to relax measurement requirements for cell reselection (see TS 38.304 [20], clause 5.2.4.9.0).","paragraph_zero_based":13257},{"literal_text_all_w_t_and_m_t":"t-ReselectionNR","paragraph_zero_based":13258},{"literal_text_all_w_t_and_m_t":"Parameter \"TreselectionNR\" in TS 38.304 [20].","paragraph_zero_based":13259},{"literal_text_all_w_t_and_m_t":"t-ReselectionNR-SF","paragraph_zero_based":13260},{"literal_text_all_w_t_and_m_t":"Parameter \"Speed dependent ScalingFactor for TreselectionNR\" in TS 38.304 [20]. If the field is absent, the UE behaviour is specified in TS 38.304 [20].","paragraph_zero_based":13261},{"literal_text_all_w_t_and_m_t":"threshServingLowP","paragraph_zero_based":13262},{"literal_text_all_w_t_and_m_t":"Parameter \"ThreshServing, LowP\" in TS 38.304 [20].","paragraph_zero_based":13263},{"literal_text_all_w_t_and_m_t":"threshServingLowQ","paragraph_zero_based":13264},{"literal_text_all_w_t_and_m_t":"Parameter \"ThreshServing, LowQ\" in TS 38.304 [20].","paragraph_zero_based":13265},{"literal_text_all_w_t_and_m_t":"t-SearchDeltaP","paragraph_zero_based":13266},{"literal_text_all_w_t_and_m_t":"Parameter \"TSearchDeltaP\" in TS 38.304 [20]. Value in seconds. Value s5 means 5 seconds, value s10 means 10 seconds and so on.","paragraph_zero_based":13267},{"literal_text_all_w_t_and_m_t":"t-SearchDeltaP-Stationary","paragraph_zero_based":13268},{"literal_text_all_w_t_and_m_t":"Parameter \"TSearchDeltaP-Stationary\" in TS 38.304 [20]. Value in seconds. Value s5 means 5 seconds, value s10 means 10 seconds and so on.","paragraph_zero_based":13269},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13270},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":13271}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["2736702c4f62c18a6898a47aba36833fcb62e575219bef9229a429707e89c0a8","0087d0899b1fa7ddfc2be5a7cd1cf0657a72bf5c9964181d8fbd2af46770953c","a1dad6810808b97fb024b165fa5d52bf3370b05ef1a1108def04abbd29da2411","b1e61fb93c9c1b9275faedd3397240e2c7af294131fc7effe4f9abef22904749","89fc4f00ee154aa93d6d05166f4302206bca3483ca79d8d01774bab5903e7edd","b97a03a88a24bbe5b865da20af8d42d9976e4c22b5d2dd2308bade900ac10120","ce6764b2906e3c4208209b1fb9fe59ea0c3071f884e58fdb079c2e699dbfc06a","77bcbce647f87205e8d8e89b8f782e8f8dabdc1cf56d43593dcf882a090c1fa0","d87bd60e4fc7e04fe3adbda9afd5735d5bfde8aefe786a7e9d460c655821c352","48f4157aa870c64ea63e6495941d6040ecfe9a17b091d56951869cdbc044409a","46366e06c14674126707aae8d5117aae1e91ae4bfdb9137132bf485ae94a4bb1","1e8442b909fd6a96a013c1ef3d295e215ecf31e4569c061d0011f33476195c0d","918c9a7f61fae08836c8aa24dd82e61bce92e296ab4f6347412ed21651e29099","32628a68250f40a836ff1bb9d69cb580698ad3d1abb845596ff29f9315b50411","914761dfc8c90c1ecbdf04071c8dea0204e9997c415769c31d07aae5d1478c87","9d9bff3a4161843aa4abdeca8d31f54a35687898cebb8a9b0c6292aaf1cf50e9","e07d11b6c5160a8556153a26330bd46acc6161741c3b7d01e84c012914ac8896","0c55618d25023f5a96809a5aacac6989f12e93ae1beb13bacdcd678cbfce1b7b","66ca304c825f969d54f181640514224367d8ab7762dcb281bce4cf975cd48f78","78f1a26b48a6192ed3303b2a15a8e6b09ff1c575d42762faf6f4729e9988d446","1bd691c5b91c6df72d384bbdcacf04a9d469aa6bb0204517063ab3fca52f4920","2046cfa18e039dc4a0983c7d561b43a28ae67b9dbfb1408777f7f82ca9c489d9","b7c6035da933b9f084dbff17efe565776d76b2667e40ee9a428667cfa3ff2d98","03a3b22a2a6a03468a41fc1b199f26d47f4e07a73ebe8381e291225cef266cb5"],"paragraph_range_zero_based":[13248,13271],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p13248"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":13272},{"literal_text_all_w_t_and_m_t":"HSDN","paragraph_zero_based":13273},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if speedStateReselectionPars is present; otherwise the field is not present.","paragraph_zero_based":13274},{"literal_text_all_w_t_and_m_t":"SharedSpectrum","paragraph_zero_based":13275},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if this intra-frequency operates with shared spectrum channel access in FR1. Otherwise, it is absent, Need R.","paragraph_zero_based":13276},{"literal_text_all_w_t_and_m_t":"SharedSpectrum2","paragraph_zero_based":13277},{"literal_text_all_w_t_and_m_t":"This field is optionally present if this intra-frequency operates with shared spectrum channel access in FR2-2, Need R. Otherwise, it is absent, Need R.","paragraph_zero_based":13278},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13279},{"literal_text_all_w_t_and_m_t":"–SIB3","paragraph_zero_based":13280},{"literal_text_all_w_t_and_m_t":"SIB3 contains neighbouring cell related information relevant only for intra-frequency cell re-selection. The IE includes cells with specific re-selection parameters as well as exclude-listed cells.","paragraph_zero_based":13281},{"literal_text_all_w_t_and_m_t":"SIB3 information element","paragraph_zero_based":13282},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":13283},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB3-START","paragraph_zero_based":13284},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13285},{"literal_text_all_w_t_and_m_t":"SIB3 ::=                            SEQUENCE {","paragraph_zero_based":13286},{"literal_text_all_w_t_and_m_t":"    intraFreqNeighCellList              IntraFreqNeighCellList                                          OPTIONAL,   -- Need R","paragraph_zero_based":13287},{"literal_text_all_w_t_and_m_t":"    intraFreqExcludedCellList           IntraFreqExcludedCellList                                       OPTIONAL,   -- Need R","paragraph_zero_based":13288},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension            OCTET STRING                                                    OPTIONAL,","paragraph_zero_based":13289},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":13290},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":13291},{"literal_text_all_w_t_and_m_t":"    intraFreqNeighCellList-v1610        IntraFreqNeighCellList-v1610                                    OPTIONAL,   -- Need R","paragraph_zero_based":13292},{"literal_text_all_w_t_and_m_t":"    intraFreqAllowedCellList-r16        IntraFreqAllowedCellList-r16                                    OPTIONAL,   -- Cond SharedSpectrum2","paragraph_zero_based":13293},{"literal_text_all_w_t_and_m_t":"    intraFreqCAG-CellList-r16           SEQUENCE (SIZE (1..maxPLMN)) OF IntraFreqCAG-CellListPerPLMN-r16    OPTIONAL    -- Need R","paragraph_zero_based":13294},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":13295}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["7b63cd05b125ce0ef9fe35635fd7d42cf7cbd263454f613bb3303831fa68c09e","dd13d540705d7142991dc9ae9001019d73b5f2d5a0f0c4d97cc2bff3a48679cf","d46a0be471e1e947cea152c094465ee8efdfdf69ca1fd45508f956f174c7dd41","a310ec38775b6069331a17cc89da0fe9e8c00f4c3ba16d29d96ff5c69b4399c5","08237a26ed2e24932a2861cd4dac3eb0b8b53d3aab7f1c02ece7cb6874594a74","51531f13f10d16e0ce57ea718021e5db01f64ce9ee16b66d090afce7a9