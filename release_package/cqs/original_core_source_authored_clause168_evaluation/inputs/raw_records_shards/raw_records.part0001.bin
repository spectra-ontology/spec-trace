,"paragraph_zero_based":29418},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29419},{"literal_text_all_w_t_and_m_t":"SSB-MTC3 field descriptions","paragraph_zero_based":29420},{"literal_text_all_w_t_and_m_t":"duration","paragraph_zero_based":29421},{"literal_text_all_w_t_and_m_t":"Duration of the measurement window in which to receive SS/PBCH blocks. It is given in number of subframes (see TS 38.213 [13], clause 4.1).","paragraph_zero_based":29422},{"literal_text_all_w_t_and_m_t":"pci-List","paragraph_zero_based":29423}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["7163f2a3d155bc490f4ebcf4bd6e60fbef1ef9283646c7415a54b5fc82bcd30e","91f0e31763d9884e9c1c8b06899979be15677761bed8159809d69d9a7e0358e3","97ca7e9ea801afa31283007ebaaef97df9d038dd5bab2e61a825dd680a72910a","bf2bfd2fad27b72b6ff28817fa3dae4767421d0b131b172aa9be9ca64c1fca25","dbe271ecf0cef6527cd4bfb64abfbe44238ea917b2b5b4e0379afb07f0beb305","fab6856779dc3a6ba271215f5ffb7839cee1cee392c5ee21aa854b439f6183bd","a8d4a2bb781881dde86e4925d16ab1a9bd44704ba3470cf212cf5caf14ff9e6b","373400493c7ba57bb585cbd7f10c6f14028ebde82c899156ffbe49e925728c43","823d20cb37a7875dce8a02930cfcc874cd1a425bceb49fd18e152f87b0e6ba48","71a2cd51a4d23a9db71e651ab8868b8ca2f47faa9a8d18d6ed7cc45539a414b3","b4566004ba2ab1a96c589b5600c6a068a6d6b27bf62db8fc2c0a1a1d00460e94","68013ec321af69357121aafc9eb25f1d02977d53f338f7418862a83378b8d5d1","e883fb5fb11ddff8be1c00797f031e5a262eb444dd2f5654a607cb963eb6087f","4767c08fda1db3882381e9ca6da595a37992e9694caa7d536adab51d0e5a9b2e","adf56d1191be36113acf525f2345c8a9346e0cc53fb27752802b5cc5af3923d6","2bae32b4becc3a85bad977737b31ae62ecf788ccbe6dd76662a1e54ed6ab2911","661a4577ef16509e34c9aa2f4d1cd698a91ce911057f596692e49cab6fb23658","7432c23873dbf227c0235365427e41a4f24e3265868f8a0e999f0295ba270b05","7cf3fd5a6627e06a948fd8249b2eaf2fb17fadba94f7217137320b3b91b2094d","885bbdf54f9d48de85f1588092c5cf3fe35c051f04b53a359ba11c2aec62cadc","10ba3c12f0eaf1fc1b0206f6ed6b8439bc7574ff4922fa728c5698031814638f","e0c652d69647cda6568d883474aebaee23a57d1f403c6915c9242ec854c7aa4c","f3df0664a823bab42587f7b4f2ca9216bdc21726e15d62ec8f8bd8a7049e81fb","2e83a29e74b48a47d2cb13076978463703dd2860b96acef07b7ae499a9b4a6ae"],"paragraph_range_zero_based":[29400,29423],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p29400"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"PCIs that follow this SMTC, used for IAB-node discovery.","paragraph_zero_based":29424},{"literal_text_all_w_t_and_m_t":"periodicityAndOffset","paragraph_zero_based":29425},{"literal_text_all_w_t_and_m_t":"Periodicity and offset of the measurement window in which to receive SS/PBCH blocks, see 5.5.2.10. Periodicity and offset are given in number of subframes.","paragraph_zero_based":29426},{"literal_text_all_w_t_and_m_t":"ssb-ToMeasure","paragraph_zero_based":29427},{"literal_text_all_w_t_and_m_t":"The set of SS blocks to be measured within the SMTC measurement duration. The first/leftmost bit corresponds to SS block index 0, the second bit corresponds to SS block index 1, and so on. Value 0 in the bitmap indicates that the corresponding SS block is not to be measured while value 1 indicates that the corresponding SS block is to be measured (see TS 38.215 [9]). When the field is not configured the IAB-MT measures on all SS blocks. Regardless of the value of this field, SS blocks outside of the applicable smtc are not to be measured. See TS 38.215 [9] clause 5.1.1.","paragraph_zero_based":29428},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29429},{"literal_text_all_w_t_and_m_t":"SSB-MTC4 field descriptions","paragraph_zero_based":29430},{"literal_text_all_w_t_and_m_t":"pci-List","paragraph_zero_based":29431},{"literal_text_all_w_t_and_m_t":"PCIs that follow this SMTC.","paragraph_zero_based":29432},{"literal_text_all_w_t_and_m_t":"offset","paragraph_zero_based":29433},{"literal_text_all_w_t_and_m_t":"Offset of the measurement window in which to receive SS/PBCH blocks, see 5.5.2.10. Offset is given in number of subframes.","paragraph_zero_based":29434},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29435},{"literal_text_all_w_t_and_m_t":"SSB-MTC-AdditionalPCI field descriptions","paragraph_zero_based":29436},{"literal_text_all_w_t_and_m_t":"additionalPCI","paragraph_zero_based":29437},{"literal_text_all_w_t_and_m_t":"PCI of the additional SSB different from serving cell PCI.","paragraph_zero_based":29438},{"literal_text_all_w_t_and_m_t":"periodicity","paragraph_zero_based":29439},{"literal_text_all_w_t_and_m_t":"Periodicity of the SS/PBCH blocks, see 5.5.2.10. Periodicity is given in number of subframes.","paragraph_zero_based":29440},{"literal_text_all_w_t_and_m_t":"ssb-PositionsInBurst","paragraph_zero_based":29441},{"literal_text_all_w_t_and_m_t":"Indicates the time domain positions of the transmitted SS-blocks in a half frame with SS/PBCH blocks as defined in TS 38.213 [13], clause 4.1. The first/leftmost bit corresponds to SS/PBCH block index 0, the second bit corresponds to SS/PBCH block index 1, and so on. Value 0 in the bitmap indicates that the corresponding SS/PBCH block is not transmitted while value 1 indicates that the corresponding SS/PBCH block is transmitted.","paragraph_zero_based":29442},{"literal_text_all_w_t_and_m_t":"ss-PBCH-BlockPower","paragraph_zero_based":29443},{"literal_text_all_w_t_and_m_t":"Average EPRE of the resources elements that carry secondary synchronization signals in dBm that the NW used for SSB transmission, see TS 38.213 [13], clause 7.","paragraph_zero_based":29444},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29445},{"literal_text_all_w_t_and_m_t":"–SSB-PositionQCL-Relation","paragraph_zero_based":29446},{"literal_text_all_w_t_and_m_t":"The IE SSB-PositionQCL-Relation is used to indicate the QCL relationship between SSB positions on the frequency indicated by ssbFrequency (see TS 38.213 [13], clause 4.1) for operation with shared spectrum channel access. Value n1 corresponds to 1, value n2 corresponds to 2 and so on.","paragraph_zero_based":29447}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["df1605ad6fe987798198c5e6e77f2b5d9422482968a3bc087c291d13f7bc5eb0","81312d4a596bcfec172853d9520ccbc77467c5e9aa22dda945d4163ccf46eb1d","16c2c562639588c40001649338fcb28e1c76729e5dc90ae57d272107b0b7445d","fa15e7c3493fabb3716b95f91a174dac33cdfb1e60237f0cbd559ada37883b6a","b943dd26d6e8c37f5dc62ef0707fd996e243fe949ef51d9eadcc6c4bb61c6afa","e37e43ce5f41c8b3fd7dffaa03771e1e6130d891ec301d95a7fdba1e2fab2849","8eee78c64baa887b50806863a1580f01ef120defc13a3855f26566d423873d50","966ba4a07e43e5f589f9272be856a8c2c9b9e9e0a3c14abe0c834c49b460e5e3","3791e003b2058a08f97f82d9e190b886522a7c33f1c2432e345a1b5ae53504f8","fe41a9980ac8ec8acecf03038bf75e4588ca0788242f6fd41a951263cb74e80a","a82d53d42751ac09c2363d7cab237c3dafa53d0704fb0c69e13f6dd27cd699a6","1de6d7e0ba8f5be5919250f9b348366fca2b52d69bc7493702e059c585a15823","60d59f588f94c74bb03e877c2368103457cf165c9e1139535378e65568d462ca","6aa95d8a6395b3369ff866763e758cdf82367cf15a216b49a82bc02365c9c92a","2140c0bfdcc8107d625f0d739ec138fa497791f1ba6e458fdbca25075c69adbc","b15ffa5caba466f91116a7bbda888d48d84367d2ba9c71bc96388c345e329d54","655c1331049af7795753b4702b1ace073f3d00a485a0ed7877170be3f2a9739b","b4f9fa4c5893f6cf24a4fb93d873bc3353a5a9ecf70925f2b8c76d9c49dd619f","f4733192aabd0a250261741e039fb0c17e373f96a9107ded4683e1ef251cdc32","c9248ad41e743891cf8c8d4acde115870c0a73aab2d7df6346d9788091fd2728","bbeba9b30c0eb79c2478e7bd4396cf83c932e6bdf5e99fcbb9d9e12703776eb2","1e5b15c979a96f083f44511c4bce1eb318959f95230beca219e1e5aa28ebf2f5","5fc2372d1deafccbd4043db980f48fcf89c3382fc3a3f8c6ed9a4a5c7f755eb3","816b5a7edc188fd5029f5ef2efa8489207ed11a27098f05efa2c77a3db7fc0cc"],"paragraph_range_zero_based":[29424,29447],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p29424"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SSB-PositionQCL-Relation information element","paragraph_zero_based":29448},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29449},{"literal_text_all_w_t_and_m_t":"-- TAG-SSB-POSITIONQCL-RELATION-START","paragraph_zero_based":29450},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29451},{"literal_text_all_w_t_and_m_t":"SSB-PositionQCL-Relation-r16 ::=  ENUMERATED {n1,n2,n4,n8}","paragraph_zero_based":29452},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29453},{"literal_text_all_w_t_and_m_t":"SSB-PositionQCL-Relation-r17 ::=  ENUMERATED {n32, n64}","paragraph_zero_based":29454},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29455},{"literal_text_all_w_t_and_m_t":"-- TAG-SSB-POSITIONQCL-RELATION-STOP","paragraph_zero_based":29456},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29457},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29458},{"literal_text_all_w_t_and_m_t":"–SSB-ToMeasure","paragraph_zero_based":29459},{"literal_text_all_w_t_and_m_t":"The IE SSB-ToMeasure is used to configure a pattern of SSBs. For operation with shared spectrum channel access in FR1, only mediumBitmap is used, and for FR2-2, longBitmap is used.","paragraph_zero_based":29460},{"literal_text_all_w_t_and_m_t":"SSB-ToMeasure information element","paragraph_zero_based":29461},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29462},{"literal_text_all_w_t_and_m_t":"-- TAG-SSB-TOMEASURE-START","paragraph_zero_based":29463},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29464},{"literal_text_all_w_t_and_m_t":"SSB-ToMeasure ::=                   CHOICE {","paragraph_zero_based":29465},{"literal_text_all_w_t_and_m_t":"    shortBitmap                         BIT STRING (SIZE (4)),","paragraph_zero_based":29466},{"literal_text_all_w_t_and_m_t":"    mediumBitmap                        BIT STRING (SIZE (8)),","paragraph_zero_based":29467},{"literal_text_all_w_t_and_m_t":"    longBitmap                          BIT STRING (SIZE (64))","paragraph_zero_based":29468},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29469},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29470},{"literal_text_all_w_t_and_m_t":"-- TAG-SSB-TOMEASURE-STOP","paragraph_zero_based":29471}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["b69384b5701764a98b178be94c59d05be9f0ae9fe55761ee59b4a56b1b872b4a","7d4a0e5506e15e405dae65ba7245ed712dafc4e2458bf43390363f1bc09c7067","0dffa3fdbde66bc328440f99d47a280a3fc726762ddd3fe29c28f5b741f0f14c","cf6e74a741b7308742a2d6301a2914ccea37970079a5a85a31489e2e5ed86b77","f15ae168ef9af2dc78fb1fb09e42b0aac967252a527bf2d0ae61f4ffbdfa2db7","fed96faf377c3905a9d97a85928cefdcba7c82571d9a13a6e3ef794f0ef89fe8","c5978e1b57f642ff5778af38f39a615cafae024cb3144943a9cd05b34507069b","852a841996166afd14e8fec6458c5f6f3f534fef4c208e9f06b5bf381eef254b","281e9886d37ab5d6fcdec2e5687270348cdcad2578abc770b128d57445078bab","e56d93ae3146da0c5e3304a5010e4b4a58312cb26841e62be978fe9755df455e","7f97002ca8be1a54e079b668f488e649d87e1a3aa39848e170dba69bccba3909","96de43ffe2b222e9bc55e1fcc7811167fb9ce69fa55cacbb516b1c92f54d84ea","37a0aafe139c55bb46354d77854a563db55dc596b990f88bbfb509a54d95a8fa","6c0262d37bc8032c4915795d0b6298c1c2ed8aacb0885db0807fa5b5921ce750","ca2a244717854ab92121d525454352034fd5e4e4e655c6f6e03ea440023a0e42","e14e6e74cdf575843e067837b0193b41759119612a6e614692fb57706e00efc3","66fc6b46d0a865eb031118267823717ef548e98e6f93aa9686040b64d95c5fc7","9a35060ea498ae232ea1796ce9483a530e7b88eb7f906c8adbc377c05def9b2a","a64b261fc3c5f07cab2526356388dfe698e271b7a5a167b4f66cbe5ecd9b998f","54dc74e1b4d607f0a9e4c4cb39bb0dd6407ce0f4dcfc1bed87c5d8b007f2eaf8","50135a8468e549b399ef932b288cf189f6ff47a1bd8f5ee1cf7e875363198688","c2c0fe991366fe022edca4bebab29fab195b37933351bd59af2901cad8060e7f","f4e111ad810f0d75a1ea27e8349de1588a5af0ed91e036d659a361806656e77f","80fe60d800d5797c11bf7030e93179a51f9db11b168fc47b3595dba36f847045"],"paragraph_range_zero_based":[29448,29471],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p29448"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29472},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29473},{"literal_text_all_w_t_and_m_t":"SSB-ToMeasure field descriptions","paragraph_zero_based":29474},{"literal_text_all_w_t_and_m_t":"longBitmap","paragraph_zero_based":29475},{"literal_text_all_w_t_and_m_t":"Bitmap when maximum number of SS/PBCH blocks per half frame equals to 64 as defined in TS 38.213 [13], clause 4.1. For operation with shared spectrum channel access in FR2-2, if the k-th bit is set to 1, the UE assumes that one or more SS/PBCH blocks within the SMTC measurement duration with candidate SS/PBCH block indexes corresponding to SS/PBCH block index equal to (k– 1) may be transmitted; if the k-th bit is set to 0, the UE assumes that the corresponding SS/PBCH block(s) are not transmitted.","paragraph_zero_based":29476},{"literal_text_all_w_t_and_m_t":"mediumBitmap","paragraph_zero_based":29477},{"literal_text_all_w_t_and_m_t":"Bitmap when maximum number of SS/PBCH blocks per half frame equals to 8 as defined in TS 38.213 [13], clause 4.1. For operation with shared spectrum channel access, if the k-th bit is set to 1, the UE assumes that one or more SS/PBCH blocks within the SMTC measurement duration with candidate SS/PBCH block indexes corresponding to SS/PBCH block index equal to k – 1 may be transmitted; if the kt-th bit is set to 0, the UE assumes that the corresponding SS/PBCH block(s) are not transmitted. The k-th bit is set to 0, where k > ssb-PositionQCL-Common and the number of actually transmitted SS/PBCH blocks is not larger than the number of 1's in the bitmap. If ssb-PositionQCL is configured with a value smaller than ssb-PositionQCL-Common, only the leftmost K bits (K = ssb-PositionQCL) are applicable for the corresponding cell.","paragraph_zero_based":29478},{"literal_text_all_w_t_and_m_t":"shortBitmap","paragraph_zero_based":29479},{"literal_text_all_w_t_and_m_t":"Bitmap when maximum number of SS/PBCH blocks per half frame equals to 4 as defined in TS 38.213 [13], clause 4.1.","paragraph_zero_based":29480},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29481},{"literal_text_all_w_t_and_m_t":"–SS-RSSI-Measurement","paragraph_zero_based":29482},{"literal_text_all_w_t_and_m_t":"The IE SS-RSSI-Measurement is used to configure RSSI measurements based on synchronization reference signals.","paragraph_zero_based":29483},{"literal_text_all_w_t_and_m_t":"SS-RSSI-Measurement information element","paragraph_zero_based":29484},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29485},{"literal_text_all_w_t_and_m_t":"-- TAG-SS-RSSI-MEASUREMENT-START","paragraph_zero_based":29486},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29487},{"literal_text_all_w_t_and_m_t":"SS-RSSI-Measurement ::=             SEQUENCE {","paragraph_zero_based":29488},{"literal_text_all_w_t_and_m_t":"    measurementSlots                    BIT STRING (SIZE (1..80)),","paragraph_zero_based":29489},{"literal_text_all_w_t_and_m_t":"    endSymbol                           INTEGER(0..3)","paragraph_zero_based":29490},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29491},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29492},{"literal_text_all_w_t_and_m_t":"-- TAG-SS-RSSI-MEASUREMENT-STOP","paragraph_zero_based":29493},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29494},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29495}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["5a4195880ed8116b3f776210677bb6bf0908a57d3cf2cf5cc06f5fdfc3187210","4ab92b590af4f63a8e26cbd4f5545035d0c583728a9549eeb0a80bbb73654c2b","62ce15175e481683018b6a15439a0250488617b83abf013ce98288b3111a15aa","c85edaded325b2e262838e5037d2742c0d4620aabe815ebca1e49b6a821139fa","e41be62340f59b57665ec673251955c89687cb298ae3107038fba026e1a52a16","b954089cc89b03bc3cf1202f144bdf9fa072c415fb90357144126beae22a3b2d","89a9a91e148cc6a4b708b0d9bb32fb6681ddf56e1cb3bb72cf4d87808d20e81d","3d006efaa15ab017e5a74271545d9aa15121de6eb53476d48e2432870971a898","c7d562d78d8cbe0dbd66b81f79ed7016ff1274c96e4ffb1e01ab8d432fcbfa64","4aa5e24628881186dd78a944b0483e2f2c69aea666956acc8bdaef33c6c2119c","773b9218594ce7401ba214d76dbed0e053ec899f66506807bd5c9f938ff508bd","d2562d56606d58a5e6ed89548a5a12a9fa4fb25fa7d4d9376777be1fe0347c08","33272e5b3a1d09f1549f4955043ba16f39b376d27706a4bc6546704d0db4a6e4","2bb3f71d79006e42223e5dabb33ab548c0e2dd3b4df5444f2ee876b46870dfd6","5383151e18e4e4069998ccd508700402941790cab0ebe7c6f5d9498d027cc25e","8b37fb87ca7fa1ab6e718105305f73ef9cabcdda890f714684f977d90f0b72e9","6f1162918e0a492064053485771729b7c232948d619af689d7c2ea6c5a9c5775","b9ff3a173d42540c9c65781e151a1b47dfacc3ed1086c38bd6a9857469147217","1694b2ef3392b7c5e0eb2d76cde43b4cb67a4160fb1536c9f1546c4e17a43701","1efb81b282c38d375cddf5e01d27e76e0cc1230e89c8d40c1eda22797499f793","2656a4850364ce64b2af5e02ba0c11a429e3139a034746a61c8958ae4c29ea05","aeef5c657c66fca7e2d28a33e9ecd1b89a480082f6f0520bc5614d569e279d2e","13c50ccbb2006619282689c700b3f669245f37e2c4f09979efb03421f7cf7315","b1587259a65316b97339ce90cd3476df130fc9f4eede6204872779f88f3866f4"],"paragraph_range_zero_based":[29472,29495],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p29472"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SS-RSSI-Measurement field descriptions","paragraph_zero_based":29496},{"literal_text_all_w_t_and_m_t":"endSymbol","paragraph_zero_based":29497},{"literal_text_all_w_t_and_m_t":"Within a slot that is configured for RSSI measurements (see measurementSlots) the UE measures the RSSI from symbol 0 to symbol endSymbol. This field identifies the entry in Table 5.1.3-1 in TS 38.215 [9], which determines the actual end symbol.","paragraph_zero_based":29498},{"literal_text_all_w_t_and_m_t":"measurementSlots","paragraph_zero_based":29499},{"literal_text_all_w_t_and_m_t":"Indicates the slots in which the UE can perform RSSI measurements. The length of the BIT STRING is equal to the number of slots in the configured SMTC window (determined by the duration and by the subcarrierSpacing). The first (left-most / most significant) bit in the bitmap corresponds to the first slot in the SMTC window, the second bit in the bitmap corresponds to the second slot in the SMTC window, and so on. The UE measures in slots for which the corresponding bit in the bitmap is set to 1. In case this field is configured for a SCell with ca-SlotOffset-r16, the bits in the bitmap corresponds to the slots that are fully contained in the SMTC window.","paragraph_zero_based":29500},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29501},{"literal_text_all_w_t_and_m_t":"–SubcarrierSpacing","paragraph_zero_based":29502},{"literal_text_all_w_t_and_m_t":"The IE SubcarrierSpacing determines the subcarrier spacing. Restrictions applicable for certain frequencies, channels or signals are clarified in the fields that use this IE.","paragraph_zero_based":29503},{"literal_text_all_w_t_and_m_t":"SubcarrierSpacing information element","paragraph_zero_based":29504},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29505},{"literal_text_all_w_t_and_m_t":"-- TAG-SUBCARRIERSPACING-START","paragraph_zero_based":29506},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29507},{"literal_text_all_w_t_and_m_t":"SubcarrierSpacing ::=               ENUMERATED {kHz15, kHz30, kHz60, kHz120, kHz240, kHz480-v1700, kHz960-v1700, spare1}","paragraph_zero_based":29508},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29509},{"literal_text_all_w_t_and_m_t":"-- TAG-SUBCARRIERSPACING-STOP","paragraph_zero_based":29510},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29511},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29512},{"literal_text_all_w_t_and_m_t":"–TAG-Config","paragraph_zero_based":29513},{"literal_text_all_w_t_and_m_t":"The IE TAG-Config is used to configure parameters for a time-alignment group.","paragraph_zero_based":29514},{"literal_text_all_w_t_and_m_t":"TAG-Config information element","paragraph_zero_based":29515},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29516},{"literal_text_all_w_t_and_m_t":"-- TAG-TAG-CONFIG-START","paragraph_zero_based":29517},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29518},{"literal_text_all_w_t_and_m_t":"TAG-Config ::=                      SEQUENCE {","paragraph_zero_based":29519}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["8e0df936b9cad518e6e16e1a1a26da5737c5e1a363d2f90b8fbe96e0dd9f31ef","bcf066da14ada06f8217db11f0f09f8765eca0215a99bbbdd60097fd5e6a29c2","2a725fe8e10281e9b462234b09394e82d6568ad87a02e9e2722ae3ae13d27b7e","d337f9936ee3cadbdc995386989838ac3f4d8831acea007da009919025e19938","8cbc17499565f4b09bc157b65aab4fe3b85ed4585a2cfe3b583e4f30df