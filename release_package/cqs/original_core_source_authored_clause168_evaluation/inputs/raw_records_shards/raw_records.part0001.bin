{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–CarrierFreqListMBS","paragraph_zero_based":39792},{"literal_text_all_w_t_and_m_t":"The IE CarrierFreqListMBS is used to inform network of the frequencies on which the UE is receiving or interested to receive MBS broadcast service via a broadcast MRB.","paragraph_zero_based":39793},{"literal_text_all_w_t_and_m_t":"CarrierFreqListMBS information element","paragraph_zero_based":39794},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39795},{"literal_text_all_w_t_and_m_t":"-- TAG-CARRIERFREQLISTMBS-START","paragraph_zero_based":39796},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39797},{"literal_text_all_w_t_and_m_t":"CarrierFreqListMBS-r17 ::=      SEQUENCE (SIZE (1..maxFreqMBS-r17)) OF ARFCN-ValueNR","paragraph_zero_based":39798},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39799},{"literal_text_all_w_t_and_m_t":"-- TAG-CARRIERFREQLISTMBS-STOP","paragraph_zero_based":39800},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39801},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39802},{"literal_text_all_w_t_and_m_t":"–CFR-ConfigMCCH-MTCH","paragraph_zero_based":39803},{"literal_text_all_w_t_and_m_t":"The IE CFR-ConfigMCCH-MTCH is used to configure the common frequency resource used for MCCH and MTCH reception.","paragraph_zero_based":39804},{"literal_text_all_w_t_and_m_t":"CFR-ConfigMCCH-MTCH information element","paragraph_zero_based":39805},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39806},{"literal_text_all_w_t_and_m_t":"-- TAG-CFR-CONFIGMCCH-MTCH-START","paragraph_zero_based":39807},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39808},{"literal_text_all_w_t_and_m_t":"CFR-ConfigMCCH-MTCH-r17 ::= SEQUENCE {","paragraph_zero_based":39809},{"literal_text_all_w_t_and_m_t":"    locationAndBandwidthBroadcast-r17          LocationAndBandwidthBroadcast-r17  OPTIONAL,  -- Need S","paragraph_zero_based":39810},{"literal_text_all_w_t_and_m_t":"    pdsch-ConfigMCCH-r17                       PDSCH-ConfigBroadcast-r17          OPTIONAL,  -- Need S","paragraph_zero_based":39811},{"literal_text_all_w_t_and_m_t":"    commonControlResourceSetExt-r17            ControlResourceSet                 OPTIONAL   -- Cond NotSIB1CommonControlResource","paragraph_zero_based":39812},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39813},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39814},{"literal_text_all_w_t_and_m_t":"LocationAndBandwidthBroadcast-r17 ::= CHOICE {","paragraph_zero_based":39815}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["ffd4555bb86aac37466bb1ca06d59a6d1e304e91e0c1b69462fa81895758ab29","28ad23c284a5b909b3a0d55be2503259163066f9693611aeb8db00b3929b92f5","dfa2529a77fa423a47e53dcee17ad0712fcbccb15cbe29dfd0d8c2829b59b496","54a3975ee57f5ed23db43375f1b28944a00302e2ff9d170fd4d119572e72c066","1769236e0afd26da1fc6e385f3b17241b9a54f4435884337d7a6e5ce75948914","ff245e1d34c248ce3430448581f6f06ab105c362550d425717f2df1444120eca","f10f64e47c99ec2310a98fc2c862a4eaaf64d024d05089b1961cedfbdf658f4f","e5677d51e7b54be975a1d1cc1e0a773707f3e7ecfcf43f07bc9e2cb3bd1a2c5e","a0707fb29307d6995d826fee8fdf0f52e1c8e4f76c96ee0a78abad336383dd9b","e0e866414999f6bc95a6bd87384fa4e7519d492bebea85b6223ede97565cdde4","18eba242369ccf2b90b9a0ed3ec1b500523e6438afb88afa034227e09c7107f7","3f57453ab46375749f17083c47a83b05f0e0530df357068cda7ae65bc6a91d9f","04d0e670070099c4c63a9ab83e2856282961192f93d100bb246bb7d82cc6f3ec","35cb27cf940e8f3c40e717a8af6410