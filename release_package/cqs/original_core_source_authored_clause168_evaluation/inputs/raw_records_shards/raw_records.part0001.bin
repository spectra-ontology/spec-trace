25722b1a6e60e7173e64ea3713b6f8ba3","09c87830acccc6c6e07e6279da2190eff861ea50b5a7761fd6e775f38b032612","6452e5bea7070ff49d84c65f02f133e7ae48bed633a08fab4e4a0ebfa28d1c3b","62d2f37287bb22899104ab2c25536584b11af872ee7f55d51b6afbbafed712fa","dae3e88125580694c1997d67c91fcf3f12e5e46e80e17767da9c076f28d0c648","112a159f8125411c07c1fcc15853613557274c65dc371ac61fbc1070eaaa5607","6fd8a658e483df4d39bf0d49d0c9bfb4d89b214b9c76f01d805c1264777fe52f"],"paragraph_range_zero_based":[18600,18623],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p18600"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    highSpeedMeasFlagFR2-r17                    ENUMERATED {set1, set2}                       OPTIONAL,   -- Need R","paragraph_zero_based":18624},{"literal_text_all_w_t_and_m_t":"    highSpeedDeploymentTypeFR2-r17              ENUMERATED {unidirectional, bidirectional}    OPTIONAL,   -- Need R","paragraph_zero_based":18625},{"literal_text_all_w_t_and_m_t":"    highSpeedLargeOneStepUL-TimingFR2-r17       ENUMERATED {true}                             OPTIONAL,   -- Need R","paragraph_zero_based":18626},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":18627},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18628},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18629},{"literal_text_all_w_t_and_m_t":"-- TAG-HIGHSPEEDCONFIG-STOP","paragraph_zero_based":18630},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18631},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18632},{"literal_text_all_w_t_and_m_t":"HighSpeedConfig field descriptions","paragraph_zero_based":18633},{"literal_text_all_w_t_and_m_t":"HighSpeedDemodCA-Scell","paragraph_zero_based":18634},{"literal_text_all_w_t_and_m_t":"If the field is present and UE supports demodulationEnhancementCA-r17, the UE shall apply the enhanced demodulation processing for HST-SFN joint transmission scheme with velocity up to 500km/h as specified in TS 38.101-4 [59]. This parameter only applies to SCell.","paragraph_zero_based":18635},{"literal_text_all_w_t_and_m_t":"highSpeedDemodFlag","paragraph_zero_based":18636},{"literal_text_all_w_t_and_m_t":"If the field is present and UE supports demodulationEnhancement-r16, the UE shall apply the enhanced demodulation processing for HST-SFN joint transmission scheme with velocity up to 500km/h as specified in TS 38.101-4 [59]. This parameter only applies to SpCell.","paragraph_zero_based":18637},{"literal_text_all_w_t_and_m_t":"highSpeedDeploymentTypeFR2","paragraph_zero_based":18638},{"literal_text_all_w_t_and_m_t":"If the field is present, and field value is unidirectional, the UE shall assume uni-directional deployment or if field value is birectional the UE shall assume bidirectional deployment for FR2 up to 350km/h as specified in TS 38.133 [14].","paragraph_zero_based":18639},{"literal_text_all_w_t_and_m_t":"highSpeedLargeOneSteptUL-TimingFR2","paragraph_zero_based":18640},{"literal_text_all_w_t_and_m_t":"If the field is present, large one step UE autonomous uplink transmit timing adjustment for FR2 up to 350km/h as specified in TS 38.133 [14] is enabled.","paragraph_zero_based":18641},{"literal_text_all_w_t_and_m_t":"highSpeedMeasCA-Scell","paragraph_zero_based":18642},{"literal_text_all_w_t_and_m_t":"If the field is present and UE supports measurementEnhancementCA-r17, the UE shall apply the enhanced RRM requirements to the serving frequency of SCell for carrier aggregation to support high speed up to 500 km/h as specified in TS 38.133 [14].","paragraph_zero_based":18643},{"literal_text_all_w_t_and_m_t":"highSpeedMeasFlag","paragraph_zero_based":18644},{"literal_text_all_w_t_and_m_t":"If the field is present and UE supports measurementEnhancement-r16, the UE shall apply the enhanced intra-NR and inter-RAT EUTRAN RRM requirements to support high speed up to 500 km/h as specified in TS 38.133 [14].","paragraph_zero_based":18645},{"literal_text_all_w_t_and_m_t":"If the field is present and UE supports intraNR-MeasurementEnhancement-r16, the UE shall apply enhanced intra-NR RRM requirement to support high speed up to 500 km/h as specified in TS 38.133 [14].","paragraph_zero_based":18646},{"literal_text_all_w_t_and_m_t":"If the field is present and UE supports interRAT-MeasurementEnhancement-r16, the UE shall apply enhanced inter-RAT EUTRAN RRM requirement to support high speed up to 500 km/h as specified in TS 38.133 [14].","paragraph_zero_based":18647}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["18404da3fb265a910462c5d4e1444a9e838f0db18b89ee026a0d7bccd5021ac9","7ae15263754b6daea0f5b6fef5cb2ca33922ff0c4da31f5981e232941e01ccfb","0d549e479d3416c628eaba6947b9efd6cc960a4460157b68c1a9465569bc4b5b","cc6ae1e7e25a0b9af0c1235c4f99baf9372990535cf11b1f095bf226c021bb54","40844f73079254857e03efb7512e4306721932ea76d86bcb89adebb4392d01f2","dabcda479857e4d86f44d9e5d54a5d8660213cafe4fc2bd8aa1fb2fcb1c528f7","8782cb0d4c5f88fa4506f78a609af923d53c435c08312b32be024b40094e7d1a","f64fe369e77fa5d04fb6600f505522de3ff13c788a4b8fdc5e366184cdf50905","cbeac5d7c771a88ca7a0b0dbf91169356a26d800aab29ecbef0d15e51b9e315a","66f66d99bc2dcab72a5d70749ad9d3b83a8361cc541147525ded14c47de0265a","aff5922cb4b64fa06d0ea9ee64425bc2be2da97945df8b5df42a0662cb71a2bc","bc1f7751da3ce3c7ab9a19d2e753662a1f25152175e5ea926f932663837a9ca3","0245cddf834daa89e16accf3575f7a5177b620005fec582cf288188936fb7ab6","7bc5b5419cca8a54d496aa28c5d16b1af47a5332b2230b26df4836ee89410658","9d69eecd0a8e2659cfa89328ed56349f238b017bf269f01790cdb805a053817b","994659b40ad99fdc5872d39ca4c5dd03d8c275abe0bdc75884359cd147d5ceb8","7f5434071c632a41a83bb97859e64b7e568bd30501b5b6ff7bb38c32b6e5e7a9","542b8183e9934a6b749e3bec2a8538939c24dc2de202d90bb0a0e28f6991d221","1c03c73fe780222edb2b200cec4eb39aabeda11ac3c7cc25743cee0a65a4a626","f918974e01597534a1ba4cf1f489021a906add6cbc18f57d4be7910c36d38efe","aea5522f6162989a582258c53d5cd2e1e968089ba3e4b6115b1cc48aa2e75abe","d72da237b28d3d7b110de0236d7216bf92713d54504bba620cc5751ae830590b","a50773a1d2da00bd36adc97a0bf8ba55554c3e1abfb03b97f7036ce265aa68e8","9f5a636be42b54911cd4bcf5e06f533c842cda454e04cda8c8fe3b1e11e6ef83"],"paragraph_range_zero_based":[18624,18647],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p18624"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This parameter only applies to the serving frequency of SpCell.","paragraph_zero_based":18648},{"literal_text_all_w_t_and_m_t":"highSpeedMeasFlagFR2","paragraph_zero_based":18649},{"literal_text_all_w_t_and_m_t":"If the field is present, the UE shall apply enhanced intra-NR RRM requirement set one to support high speed up to 350 km/h for FR2 as specified in TS 38.133 [14], if the field value is set1 or RRM requirement set two if the field value is set2.","paragraph_zero_based":18650},{"literal_text_all_w_t_and_m_t":"highSpeedMeasInterFreq","paragraph_zero_based":18651},{"literal_text_all_w_t_and_m_t":"If the field is present and UE supports measurementEnhancementInterFreq-r17, the UE shall apply the enhanced RRM requirements for inter-frequency measurement in RRC_CONNECTED to support high speed up to 500 km/h as specified in TS 38.133 [14].","paragraph_zero_based":18652},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18653},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":18654},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":18655},{"literal_text_all_w_t_and_m_t":"SCellOnly","paragraph_zero_based":18656},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, in ServingCellConfigCommon of an SCell. It is absent otherwise.","paragraph_zero_based":18657},{"literal_text_all_w_t_and_m_t":"SpCellOnly","paragraph_zero_based":18658},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, in ServingCellConfigCommonSIB or in the ServingCellConfigCommon of an SpCell. It is absent otherwise.","paragraph_zero_based":18659},{"literal_text_all_w_t_and_m_t":"SpCellOnly2","paragraph_zero_based":18660},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, in ServingCellConfigCommon of an SpCell. It is absent otherwise.","paragraph_zero_based":18661},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18662},{"literal_text_all_w_t_and_m_t":"–Hysteresis","paragraph_zero_based":18663},{"literal_text_all_w_t_and_m_t":"The IE Hysteresis is a parameter used within the entry and leave condition of an event triggered reporting condition. The actual value is field value * 0.5 dB.","paragraph_zero_based":18664},{"literal_text_all_w_t_and_m_t":"Hysteresis information element","paragraph_zero_based":18665},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18666},{"literal_text_all_w_t_and_m_t":"-- TAG-HYSTERESIS-START","paragraph_zero_based":18667},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18668},{"literal_text_all_w_t_and_m_t":"Hysteresis ::=                      INTEGER (0..30)","paragraph_zero_based":18669},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18670},{"literal_text_all_w_t_and_m_t":"-- TAG-HYSTERESIS-STOP","paragraph_zero_based":18671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["85cdf8c9149381f39e6d8685499cc92988b7966f57a63107108865be171158e6","41aab9181c9d8caa25bcabcebdacc189bf105f0805ed5f79a128209235ea8faa","ea672105aba457a7b8b32f66d73f36ef6e06b288317b8a88662fe14cb0e7e085","edd2542a51316e01cb46881c7121e887955df7c498a489bd6e7c5c7d8dc470c7","f2a0900d8a35a86483b06f5bc43ee126632d2533ba5fbd0973419e29ec4a97d1","6ac4205a077cdbef58b1ab5a966c84ce848a5194544851eda4d2414ae996050c","226623c8cc084fdcff0313243560f68e6157b3b88cebca057b25b0b2128eae13","f77767f32ae8b8b2b4f379b957f37d77383c044cd56c946779bacbe96baf7c7f","961e56b7547061afaff6f22f1d2018c73c738770399a07f657758dd809a969a0","