{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":15192},{"literal_text_all_w_t_and_m_t":"    rach-ConfigCommonIAB-r16            SetupRelease { RACH-ConfigCommon }                                      OPTIONAL,   -- Need M","paragraph_zero_based":15193},{"literal_text_all_w_t_and_m_t":"    useInterlacePUCCH-PUSCH-r16         ENUMERATED {enabled}                                                    OPTIONAL,   -- Need R","paragraph_zero_based":15194},{"literal_text_all_w_t_and_m_t":"    msgA-ConfigCommon-r16               SetupRelease { MsgA-ConfigCommon-r16 }                                  OPTIONAL    -- Cond SpCellOnly2","paragraph_zero_based":15195},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":15196},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":15197},{"literal_text_all_w_t_and_m_t":"    enableRA-PrioritizationForSlicing-r17 BOOLEAN                                                    OPTIONAL, -- Cond RA-PrioSliceAI","paragraph_zero_based":15198},{"literal_text_all_w_t_and_m_t":"    additionalRACH-ConfigList-r17       SetupRelease { AdditionalRACH-ConfigList-r17 }               OPTIONAL, -- Cond SpCellOnly2","paragraph_zero_based":15199},{"literal_text_all_w_t_and_m_t":"    rsrp-ThresholdMsg3-r17              RSRP-Range                                                   OPTIONAL, -- Need R","paragraph_zero_based":15200},{"literal_text_all_w_t_and_m_t":"    numberOfMsg3-RepetitionsList-r17    SEQUENCE (SIZE (4)) OF NumberOfMsg3-Repetitions-r17                  OPTIONAL,  -- Cond Msg3Rep","paragraph_zero_based":15201},{"literal_text_all_w_t_and_m_t":"    mcs-Msg3-Repetitions-r17            SEQUENCE (SIZE (8)) OF INTEGER (0..31)                               OPTIONAL   -- Cond Msg3Rep","paragraph_zero_based":15202},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":15203},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":15204},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15205},{"literal_text_all_w_t_and_m_t":"AdditionalRACH-ConfigList-r17 ::=       SEQUENCE (SIZE(1..maxAdditionalRACH-r17)) OF AdditionalRACH-Config-r17","paragraph_zero_based":15206},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15207},{"literal_text_all_w_t_and_m_t":"AdditionalRACH-Config-r17 ::=       SEQUENCE {","paragraph_zero_based":15208},{"literal_text_all_w_t_and_m_t":"    rach-ConfigCommon-r17               RACH-ConfigCommon                                                   OPTIONAL,  -- Need R","paragraph_zero_based":15209},{"literal_text_all_w_t_and_m_t":"    msgA-ConfigCommon-r17               MsgA-ConfigCommon-r16                                               OPTIONAL,  -- Need R","paragraph_zero_based":15210},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":15211},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":15212},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15213},{"literal_text_all_w_t_and_m_t":"NumberOfMsg3-Repetitions-r17::=         ENUMERATED {n1, n2, n3, n4, n7, n8, n12, n16}","paragraph_zero_based":15214},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["03dd9ff51c6db4524a4699df20e3871a756a37388dabad8ccd243136a390cd40","8ef3f88de227ed855e490acd134092371b47899029635b2c3b37d19c34c761db","f2312fc6c5978d5268f5a8db28cf57c0dd6baf6eb8274540a00543e541363db0","8ae83789b470c6162a6491c0cd13e16539c51ba3bc8f319b326dfca857e7a0dc","c1382bf025fa425a7169d80f3c3898f9371560c82f8afc2d33f36c5c1a765351","9bea19ece68a144dae880f28d38c22b14dcbd8a5dc1bdf28a2422579a366a035","afbd0a52af4c49d374e141f110e83109fcbe03a458367cf6f774174e6044541e","97f5c03f7261cd287550db6f236cf9dc36102328aea7831469c1ec4dd76cfff8","f3d0e07ed66f364ae7a23c138177b2dfcad4c4fb8069a1525dd62dec75d03ec4","f40457c24ae87c12da1e801e135327452a37f31aeba27da772da9cef5f6df9b2","adcc49ee84fd4221ee5506699032b0d5726b220ff3307d520ebf86f248b5d742","c51e9c8fb49586ff639506b6d41323b689a0b640b3e4f1a7de51ae939739ee38","b5fbb4338afbc14e37f1d3bee84ee555b2996c9d1047085f1fd277606a8570be","c04e7572d6de9beae0b5b05721d2c39638c9ccaa257e1cb53174eb96dccdd976","3ecb8f621c4d38da0731ea898e83f817eb1a4f79e14152893fdd366c2896fdd8","729128c90bf108827452459d0f676554aa48f2e2a6baf5c1159d0d9fb1455919","e22719c2945b4cc3c9c76e220a37792b0dc2efccd14f7d2751bbdd0711f1f1cc","c98c9efac7be9d3b3d7b7e4a630037f09584f6994d4d05d6b2dab4c3145ed91b","3ce2b93fc583a74391bf600bec9e050b5bb5aacb0c1a0362fcf35979d0224a5f","6222509ef286de2118a05b470cc62d0c5a6b6f69d3516232cd8d76f862bb3afb","991e4f85f7e22e5f5da9df2c3969b0d31c08f78f5af5416f1827e64e92789ef6","102f2f1fed6d8d2efc788f8a2ab12a1015d7a01212ef6555b853c96e7b92e6f3","d7934ecb80654f18a6ca7f3177860138a738d2fa4f0ae46b5a602a2d0518b24f","04a6aa4cec30ba9ed135e03f0874639f044927b3a2602d62452b64c5ba40d4c3"],"paragraph_range_zero_based":[15192,15215],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p15192"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-UPLINKCOMMON-STOP","paragraph_zero_based":15216},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":15217},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15218},{"literal_text_all_w_t_and_m_t":"BWP-UplinkCommon field descriptions","paragraph_zero_based":15219},{"literal_text_all_w_t_and_m_t":"additionalRACH-ConfigList","paragraph_zero_based":15220},{"literal_text_all_w_t_and_m_t":"List of feature or feature combination-specific RACH configurations, i.e. the RACH configurations configured in addition to the one configured by rach-ConfigCommon and by msgA-ConfigCommon. The network associates all possible preambles of an additional RACH configuration to one or more feature(s) or feature combination(s). The network does not configure this list to have more than 16 entries. If both rach-ConfigCommon and msgA-ConfigCommon are configured for a specific FeatureCombination, the network always provides them in the same additionalRACH-Config.","paragraph_zero_based":15221},{"literal_text_all_w_t_and_m_t":"enableRA-PrioritizationForSlicing","paragraph_zero_based":15222},{"literal_text_all_w_t_and_m_t":"Indicates whether or not the ra-PrioritizationForSlicing/ra-PrioritizationForSlicingTwoStep should override the ra-PrioritizationForAccessIdentity. The field is applicable only when the UE is configured by upper layers with both NSAG and Access Identity 1 or 2. If value TRUE is configured, the UE should only apply the ra-PrioritizationForSlicing/ra-PrioritizationForSlicingTwoStep. If value FALSE is configured, the UE should only apply ra-PrioritizationForAccessIdentity. If the field is absent, whether to use ra-PrioritizationForSlicing/ra-PrioritizationForSlicingTwoStep or ra-PrioritizationForAccessIdentity is up to UE implementation.","paragraph_zero_based":15223},{"literal_text_all_w_t_and_m_t":"mcs-Msg3-Repetitions","paragraph_zero_based":15224},{"literal_text_all_w_t_and_m_t":"Configuration of eight candidate MCS indexes for PUSCH transmission scheduled by RAR UL grant and DCI format 0_0 with CRC scrambled by TC-RNTI. Only the first 4 configured or default MCS indexes are used for PUSCH transmission scheduled by RAR UL grant. This field is only applicable when the UE selects Random Access resources indicating Msg3 repetition in this BWP. If this field is absent when the set(s) of Random Access resources with MSG3 repetition indication are configured in the BWP-UplinkCommon, the UE shall apply the values {0, 1, 2, 3, 4, 5, 6, 7} (see TS 38.214 [19], clause 6.1.4).","paragraph_zero_based":15225},{"literal_text_all_w_t_and_m_t":"msgA-ConfigCommon","paragraph_zero_based":15226},{"literal_text_all_w_t_and_m_t":"Configuration of the cell specific PRACH and PUSCH resource parameters for transmission of MsgA in 2-step random access type procedure. The NW can configure msgA-ConfigCommon only for UL BWPs if the linked DL BWPs (same bwp-Id as UL-BWP) are the initial DL BWPs or DL BWPs containing the SSB associated to the initial DL BWP or for RedCap UEs DL BWPs associated with nonCellDefiningSSB or the RedCap-specific initial downlink BWP.","paragraph_zero_based":15227},{"literal_text_all_w_t_and_m_t":"numberOfMsg3-RepetitionsList","paragraph_zero_based":15228},{"literal_text_all_w_t_and_m_t":"The number of repetitions for PUSCH transmission scheduled by RAR UL grant and DCI format 0_0 with CRC scrambled by TC-RNTI. This field is only applicable when the UE selects Random Access resources indicating Msg3 repetition in this BWP. If this field is absent when the set(s) of Random Access resources with MSG3 repetition indication are configured in the BWP-UplinkCommon, the UE shall apply the values {n1, n2, n3, n4} (see TS 38.214 [19], clause 6.1.2.1).","paragraph_zero_based":15229},{"literal_text_all_w_t_and_m_t":"pucch-ConfigCommon","paragraph_zero_based":15230},{"literal_text_all_w_t_and_m_t":"Cell specific parameters for the PUCCH of this BWP. ","paragraph_zero_based":15231},{"literal_text_all_w_t_and_m_t":"pusch-ConfigCommon","paragraph_zero_based":15232},{"literal_text_all_w_t_and_m_t":"Cell specific parameters for the PUSCH of this BWP.","paragraph_zero_based":15233},{"literal_text_all_w_t_and_m_t":"rach-ConfigCommon","paragraph_zero_based":15234},{"literal_text_all_w_t_and_m_t":"Configuration of cell specific random access parameters which the UE uses for contention based and contention free random access as well as for contention based beam failure recovery in this BWP. The NW configures SSB-based RA (and hence RACH-ConfigCommon) only for UL BWPs if the linked DL BWPs (same bwp-Id as UL-BWP) are the initial DL BWPs or DL BWPs containing the SSB associated to the initial DL BWP or for RedCap UEs DL BWPs associated with nonCellDefiningSSB or the RedCap-specific initial downlink BWP. The network configures rach-ConfigCommon, whenever it configures contention free random access (for reconfiguration with sync or for beam failure recovery). For RedCap-specific initial uplink BWP, rach-ConfigCommon is always configured when msgA-ConfigCommon is configured in this BWP.","paragraph_zero_based":15235},{"literal_text_all_w_t_and_m_t":"rach-ConfigCommonIAB","paragraph_zero_based":15236},{"literal_text_all_w_t_and_m_t":"Configuration of cell specific random access parameters for the IAB-MT. The IAB specific IAB RACH configuration is used by IAB-MT, if configured.","paragraph_zero_based":15237},{"literal_text_all_w_t_and_m_t":"rsrp-ThresholdMsg3","paragraph_zero_based":15238},{"literal_text_all_w_t_and_m_t":"Threshold used by the UE for determining whether to select resources indicating Msg3 repetition in this BWP, as specified in TS 38.321 [3]. The field is mandatory if both set(s) of Random Access resources with MSG3 repetition indication and set(s) of Random Access resources without MSG3 repetition indication are configured in the BWP. It is absent otherwise.","paragraph_zero_based":15239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["4f61c07bd6d3d695c109bcc3439b63d4c7bb1d3961802782e45b47fe3316f8c7","6e543231de37aef19f67c78a4a6837b2b08d1d20728c370321ca59d48557de60","8f8789272de8c2f7b05550131304cbec01434a49b6c6cfe115a31739e5117fa0","d2f504d30a483093db19df65b675b5b5674b9504097723e2ca4b8bb68e069a0f","517a5d3d16afa67609f516ff157f048bc1f984d2daee4ccfc718676ddb07937f","d58448ea122c7e51c8dee43eaad876a5c9f816ef5cf4343dd00358edf6458b92","1a8fdeaf1766fff74bde4933369d6c9817e35ebdcf054e493115758754a46a5b","0eb8ce9d866b8861e9db313f890b022379a9054cd56d8e35c37ad66c61d9b94d","2f284fe39a304d9d31699bac3ad1b5fe0fdac49e64f3a62b46f0faf525f0ab34","34fa232b33a0016af9ef6eeb7bf665bf40ce073af576dcf36f6e24ca9608235e","f7a18cf7905ebe3e82d53d6d7a8147c50117de09f83069b5e80318984b25736a","5afdc2b0b8b339bfeb8d40502fe299a4bb43bbc68cc5c8d56569bcd400555675","d230e1b58f8dba6857570b7d644dbb8d7449b303836e337966879c9538a0c44c","8a518aa064a7f798162d717af4d943e0ad8c26065f348ab4d4ac3013058089fa","0b10125c38c063ad5f10378f7a38487e55412aaae3a692f4b3fc1bf70b48fd0c","344027e9d02a9a98108c5f1d474f09543a88b19e80425f78e8a71dcfb3aa9599","1313cddf1907336ef23ac6207d860709e568613a4944cf18d2099deb048437e5","6debcbb49fbd53ce37012545d4afb2eda621e0d503ee5d02264a6c63e2d7c9f0","e2cbfe62954aebbed288645bc810564354d65b2f8e82a823adef5c85ff4c3ce0","a71f3c1bf1d395c27bc54bc0f760ba2ee372b9d264b3342596b22fcdfdbd211f","e02e184c533de5192a5f8c52fbb50d54579cf0a16296b6c1116167c2bce4b45a","ac5e548258ebab1286de5f6e1a5ee24b3f72d097cf95dc5ce4e0d75e9f413df8","fa9f6e601d8733ebfb02cf7dd4452c268a2e5ac5e33c237737382e28e2c3031f","af1061c1da148a39afef6430b60513d6cdc1d5581960d9701fa0389e9858ca41"],"paragraph_range_zero_based":[15216,15239],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p15216"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"useInterlacePUCCH-PUSCH","paragraph_zero_based":15240},{"literal_text_all_w_t_and_m_t":"If the field is present, the UE uses uplink frequency domain resource allocation Type 2 for cell-specific PUSCH, e.g., PUSCH scheduled by RAR UL grant (see TS 38.213 [13] clause 8.3 and TS 38.214 [19], clause 6.1.2.2) and uses interlaced PUCCH Format 0 and 1 for cell-specific PUCCH (see TS 38.213 [13], clause 9.2.1).","paragraph_zero_based":15241},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15242},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":15243},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":15244},{"literal_text_all_w_t_and_m_t":"Msg3Rep","paragraph_zero_based":15245},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need S, if the set(s) of Random Access resources with MSG3 repetition indication are configured in the BWP-UplinkCommon. It is absent otherwise.","paragraph_zero_based":15246},{"literal_text_all_w_t_and_m_t":"RA-PrioSliceAI","paragraph_zero_based":15247},{"literal_text_all_w_t_and_m_t":"The field is optionally present in SIB1, Need R, if both parameters ra-PrioritizationForAccessIdentity and the ra-PrioritizationForSlicing/ra-PrioritizationForSlicingTwoStep are present in SIB1. It is absent otherwise.","paragraph_zero_based":15248},{"literal_text_all_w_t_and_m_t":"SpCellOnly2","paragraph_zero_based":15249},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need M, in the BWP-UplinkCommon of an SpCell. It is absent otherwise.","paragraph_zero_based":15250},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15251},{"literal_text_all_w_t_and_m_t":"–BWP-UplinkDedicated","paragraph_zero_based":15252},{"literal_text_all_w_t_and_m_t":"The IE BWP-UplinkDedicated is used to configure the dedicated (UE specific) parameters of an uplink BWP.","paragraph_zero_based":15253},{"literal_text_all_w_t_and_m_t":"BWP-UplinkDedicated information element","paragraph_zero_based":15254},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":15255},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-UPLINKDEDICATED-START","paragraph_zero_based":15256},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15257},{"literal_text_all_w_t_and_m_t":"BWP-UplinkDedicated ::=             SEQUENCE {","paragraph_zero_based":15258},{"literal_text_all_w_t_and_m_t":"    pucch-Config                        SetupRelease { PUCCH-Config }                                           OPTIONAL,   -- Need M","paragraph_zero_based":15259},{"literal_text_all_w_t_and_m_t":"    pusch-Config                        SetupRelease { PUSCH-Config }                                           OPTIONAL,   -- Need M","paragraph_zero_based":15260},{"literal_text_all_w_t_and_m_t":"    configuredGrantConfig               SetupRelease { ConfiguredGrantConfig }                                  OPTIONAL,   -- Need M","paragraph_zero_based":15261},{"literal_text_all_w_t_and_m_t":"    srs-Config                          SetupRelease { SRS-Config }                                             OPTIONAL,   -- Need M","paragraph_zero_based":15262},{"literal_text_all_w_t_and_m_t":"    beamFailureRecoveryConfig           SetupRelease { BeamFailureRecoveryConfig }                              OPTIONAL,   -- Cond SpCellOnly","paragraph_zero_based":15263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["d88a84cf241e7ff6eb7c470957dbb2ceba3908bfbcaa7dd6cac27af6a7b96491","d0cba4abb47d49349ff141a6453ad