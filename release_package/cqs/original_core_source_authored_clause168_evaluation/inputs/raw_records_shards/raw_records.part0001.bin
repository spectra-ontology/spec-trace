}","paragraph_zero_based":14843},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14844},{"literal_text_all_w_t_and_m_t":"AdditionalRACH-ConfigList-r17 ::=       SEQUENCE (SIZE(1..maxAdditionalRACH-r17)) OF AdditionalRACH-Config-r17","paragraph_zero_based":14845},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14846},{"literal_text_all_w_t_and_m_t":"AdditionalRACH-Config-r17 ::=       SEQUENCE {","paragraph_zero_based":14847},{"literal_text_all_w_t_and_m_t":"    rach-ConfigCommon-r17               RACH-ConfigCommon                                                   OPTIONAL,  -- Need R","paragraph_zero_based":14848},{"literal_text_all_w_t_and_m_t":"    msgA-ConfigCommon-r17               MsgA-ConfigCommon-r16                                               OPTIONAL,  -- Need R","paragraph_zero_based":14849},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":14850},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14851},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14852},{"literal_text_all_w_t_and_m_t":"NumberOfMsg3-Repetitions-r17::=         ENUMERATED {n1, n2, n3, n4, n7, n8, n12, n16}","paragraph_zero_based":14853},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14854},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-UPLINKCOMMON-STOP","paragraph_zero_based":14855}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["bf2524909d9f9ae06d158ae5cf341eb7c80411c19c014b0de3fb78656efb4e39","c14f1e4f562b7dfbcb891fecbc6c0894aa835638c03a0736ecd33f24a71955ac","667ba25403e088cf186aff2077b7bb7a13cb4d14781f18e22bd67b535cfc171f","5aafeab0981b6d6422da279d69b4c9b3d4258f65bd7de6d38911af3badfde02c","3bc9d9eb1fc4bd691fd7eeb7396d5ed4