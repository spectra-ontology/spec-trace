{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if added IP address is iPv4-Address:","paragraph_zero_based":2616},{"literal_text_all_w_t_and_m_t":"3>if iab-IP-Usage is set to f1-C:","paragraph_zero_based":2617},{"literal_text_all_w_t_and_m_t":"4>store the received IPv4 address for F1-C traffic together with the IAB-donor-DU BAP address corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2618},{"literal_text_all_w_t_and_m_t":"3>else if iab-IP-Usage is set to f1-U:","paragraph_zero_based":2619},{"literal_text_all_w_t_and_m_t":"4>store the received IPv4 address for F1-U traffic together with the IAB-donor-DU BAP address corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2620},{"literal_text_all_w_t_and_m_t":"3>else if iab-IP-Usage is set to non-F1:","paragraph_zero_based":2621},{"literal_text_all_w_t_and_m_t":"4>store the received IPv4 address for non-F1 traffic together with the IAB-donor-DU BAP address corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2622},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":2623},{"literal_text_all_w_t_and_m_t":"4>store the received IPv4 address for all traffic together with the IAB-donor-DU BAP address corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2624},{"literal_text_all_w_t_and_m_t":"2>else if iPv6-Address is included:","paragraph_zero_based":2625},{"literal_text_all_w_t_and_m_t":"3>if iab-IP-Usage is set to f1-C:","paragraph_zero_based":2626},{"literal_text_all_w_t_and_m_t":"4>store the received IPv6 address for F1-C traffic together with the IAB-donor-DU BAP address corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2627},{"literal_text_all_w_t_and_m_t":"3>else if iab-IP-Usage is set to f1-U:","paragraph_zero_based":2628},{"literal_text_all_w_t_and_m_t":"4>store the received IPv6 address for F1-U traffic together with the IAB-donor-DU BAP address corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2629},{"literal_text_all_w_t_and_m_t":"3>else if iab-IP-Usage is set to non-F1:","paragraph_zero_based":2630},{"literal_text_all_w_t_and_m_t":"4>store the received IPv6 address for non-F1 traffic together with the IAB-donor-DU BAP address corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2631},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":2632},{"literal_text_all_w_t_and_m_t":"4>store the received IPv6 address for all traffic together with the IAB-donor-DU BAP address corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2633},{"literal_text_all_w_t_and_m_t":"2>else if iPv6-Prefix is included in iab-IP-AddressToAddModList:","paragraph_zero_based":2634},{"literal_text_all_w_t_and_m_t":"3>if iab-IP-Usage is set to f1-C:","paragraph_zero_based":2635},{"literal_text_all_w_t_and_m_t":"4>store the received IPv6 address prefix for F1-C traffic together with the IAB-donor-DU BAP address corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2636},{"literal_text_all_w_t_and_m_t":"3>else if iab-IP-Usage is set to f1-U:","paragraph_zero_based":2637},{"literal_text_all_w_t_and_m_t":"4>store the received IPv6 address prefix for F1-U traffic together with the IAB-donor-DU BAP address corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2638},{"literal_text_all_w_t_and_m_t":"3>else if iab-IP-Usage is set to non-F1:","paragraph_zero_based":2639}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["4a97640715b494d07727c3aa20f6404dfcfa2177269c04f489becfe54beebcea","dfe4498cf79d9de660868b32e8844c6fbf778adb81c9bf88783ed85f836e1aca","80064aeed88b3d1e18dd03dccf6e477499342d5342a3ce66efc0d12044b6bbd3","087385a11669c82b4e704c083a69a8e0b56af485bec28e61f9f99044b8b29bce","3d0ad25d3d1bc21518770b86a948097ad4d88b144a8ba823bd7c93c238b10e2d","738daf1c1e46c1ecf67ade1c58ebbacc9def748e6f0901d344e44c46dc5b74c8","8cad4b04cd2e6be627470d4c1c4d72444d65f4e2c4a787ce5bf43bd794d9e385","852cbad2a98c0ff04919994807b36ecd46bc424ae1c02584cf420bd29b8f3c91","6f543b23b47bb20eb6019dbbf38113003d4b8ffe69bdfc4838dd18cb98253e68","1e35238149831eeeda302f9c9ec699d298447779ae21681050eeb131c0f804b0","1e3a32b640afd8591fd6e8e76f7d3c69118c16893178f847a4d0fe8ce051274c","1e5bd8aab96ed74a0b710dc75a5c7dcf8ed26f1ec470690caa680d7ad9fe7705","458f50c75970a6a05284ed6cf38f708b0aa0be1e137916f8692506dd8f1de3f9","beece8b4f10c6b206cb7f1c452d3a0f4862954f2ad6d9dad3ce8d4df4c0e6fd1","d33861c2817991041d9859a155c06e1df11b5b31ba18df8fb48a01d7253336c3","34eed21b9dadba872fa77fd85950fe0fd7eaf5ad644296f86e04ca8fc1e7abb1","f682f28deb0f314177550611f0d763281956c2cd84da15d2994993b3912fd166","b3e9636fbdb59bbf8df1dd6f0bf9567351981702970a65b148141e3e4a39cf4d","de02e13c8bc457481ae2265c465b3df67bd36eea420b4f0af7d0760f732b3c54","0d388b0e191f148da8f95b78a91700af4376dbfbfaaf42de3e749ad78fdce7d9","01b5ac0e36e91e9f6733275e8401343d7c7344df7bf63e44d47888b0129e2516","3d8b9365d24bb9585a02bb30ade14cef75c590aa382b5cc3e18ce8a3cd136098","37bef8198e32bc4f3bc14ef459e870cb34afdb068c67976d750a851b4851e326","903bde8469bcd9737b52eb28cebbf8a108f7a11035f88f04c269fa76576408fb"],"paragraph_range_zero_based":[2616,2639],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p2616"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>store the received IPv6 address prefix for non-F1 traffic together with the IAB-donor-DU BAP address corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2640},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":2641},{"literal_text_all_w_t_and_m_t":"4>store the received IPv6 address prefix for all traffic together with the IAB-donor-DU BAP address corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2642},{"literal_text_all_w_t_and_m_t":"1>for each iab-IP-AddressIndex value included in the iab-IP-AddressToAddModList that is part of the current IAB-MT configuration:","paragraph_zero_based":2643},{"literal_text_all_w_t_and_m_t":"2>modify the IP address configuration(s) in accordance with the IAB-IP-AddressConfiguration corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2644},{"literal_text_all_w_t_and_m_t":"5.3.5.13Conditional Reconfiguration","paragraph_zero_based":2645},{"literal_text_all_w_t_and_m_t":"5.3.5.13.1General","paragraph_zero_based":2646},{"literal_text_all_w_t_and_m_t":"The network configures the UE with one or more candidate target SpCells in the conditional reconfiguration. The UE evaluates the condition of each configured candidate target SpCell. The UE applies the conditional reconfiguration associated with one of the target SpCells which fulfils associated execution condition. The network provides the configuration parameters for the target SpCell in the condRRCReconfig.","paragraph_zero_based":2647},{"literal_text_all_w_t_and_m_t":"In NR-DC, the UE may receive two independent conditionalReconfiguration:","paragraph_zero_based":2648},{"literal_text_all_w_t_and_m_t":"-a conditionalReconfiguration associated with MCG, that is included in the RRCReconfiguration message received via SRB1; and","paragraph_zero_based":2649},{"literal_text_all_w_t_and_m_t":"-a conditionalReconfiguration, associated with SCG, that is included in the RRCReconfiguration message received via SRB3, or, alternatively, included within a RRCReconfiguration message embedded in a RRCReconfiguration message received via SRB1.","paragraph_zero_based":2650},{"literal_text_all_w_t_and_m_t":"In this case:","paragraph_zero_based":2651},{"literal_text_all_w_t_and_m_t":"-the UE maintains two independent VarConditionalReconfig, one associated with each conditionalReconfiguration;","paragraph_zero_based":2652},{"literal_text_all_w_t_and_m_t":"-the UE independently performs all the procedures in clause 5.3.5.13 for each conditionalReconfiguration and the associated VarConditionalReconfig, unless explicitly stated otherwise;","paragraph_zero_based":2653},{"literal_text_all_w_t_and_m_t":"-the UE performs the procedures in clause 5.5 for the VarConditionalReconfig associated with the same cell group like the measConfig.","paragraph_zero_based":2654},{"literal_text_all_w_t_and_m_t":"In EN-DC, the VarConditionalReconfig is associated with the SCG.","paragraph_zero_based":2655},{"literal_text_all_w_t_and_m_t":"In NE-DC and when no SCG is configured, the VarConditionalReconfig is associated with the MCG.","paragraph_zero_based":2656},{"literal_text_all_w_t_and_m_t":"The UE performs the following actions based on a received ConditionalReconfiguration IE:","paragraph_zero_based":2657},{"literal_text_all_w_t_and_m_t":"1>if the ConditionalReconfiguration contains the condReconfigToRemoveList:","paragraph_zero_based":2658},{"literal_text_all_w_t_and_m_t":"2>perform conditional reconfiguration removal procedure as specified in 5.3.5.13.2;","paragraph_zero_based":2659},{"literal_text_all_w_t_and_m_t":"1>if the ConditionalReconfiguration contains the condReconfigToAddModList:","paragraph_zero_based":2660},{"literal_text_all_w_t_and_m_t":"2>perform conditional reconfiguration addition/modification as specified in 5.3.5.13.3;","paragraph_zero_based":2661},{"literal_text_all_w_t_and_m_t":"5.3.5.13.2Conditional reconfiguration removal","paragraph_zero_based":2662},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":2663}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["5d0eddf72e966ba383f1e012d8e31199e49de714aca69e5f1b892e820cb88e92","48920cecf1ea3f6d47c8876928532b29c7cfb9b411e130f47ce17cf891e589c0","4ca6f1be236ffc5d5db238609fd7182c8589df14b893136637a567790d2e0b9a","18c3b8dc512aef06ee1ed358382b5dad9c103a1dacae9be7897190e1fd516b78","948b06c353a68f03fd3aa1f9ca0b6abed36e82b8045a30e5b30bb74b03a158b5","cde3bcbe4440bf52bbf0dd239eef95a27baa0cbf1b84cd845a6cbbad1c1c42ed","5f9c36271a0a2a4b30ec7688a33fe9f5b58808de9fd4320242b74a8d83696669","e5ab28f247f6d7ba7cd348dee336ca9127573f6ef4a08520b7a75992a31749f3","87cb74e578033ddfccbc37763a1e447130d4887f58d7788a1d39ac5991fa86d4","8890596c693e89d42b359302e3ac38a85dda46c399e5c8e10c7dc4dda2eeb972","ee01448d7c7310a48b9016b2b2009e96a5f6be57313150a277e0981603415794","86c763ff8bea244cf4cda335395db8ac60b12382679970830bc0030791bceca1","e2c2f0857a2937d19a94cf73ec226e77d5fd7ff04aae974130487290cdf17071","745ae30c0fea79a26eb1af3e109debf754c8dd46640e7b863a86af98b49b66d9","ee99c447b09670785b168e4ecba34e2012ab9caf76abb98b81e44ff56347f47e","758feff77fbb3c4e1157fe27373c6ae1d1cdc49aff874ff176d3b94cc55bada6","de3ce6a8d94523c64711475b4a5813a52b082d64f8337602ca0d7bc16ec21cb1","dcd2b5e05a37df4f0c25dc8d5e2088caccce0c2ecf0afe8cac2cf13c01813e27","c292f2de7e03385a7a24e6a1959a93cf4af7e550ed484eb9aece078470ecf078","1dcf3351d00c3a998cf60029ed33054765ebf83b20df914d5b9c6f2bf6f0dc65","8dddb5f8912b4e175b0539a7f762e8f19b54d6baa95f46c587d06540a9b884ce","af8c0cb14dda507a8a74515a952a469afdebabd86e88fcaa9ccd94276c621048","e4e1151fc9cc4bf8b72b7a77d5e5280b2d9f95c981b8c90f210fc8c913768ec0","a85f512a09e3eb775c0ca4090586995e0e8dcee0932f051c21711e52ba4f941f"],"paragraph_range_zero_based":[2640,2663],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p2640"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>for each condReconfigId value included in the condReconfigToRemoveList that is part of the current UE conditional reconfiguration in VarConditionalReconfig:","paragraph_zero_based":2664},{"literal_text_all_w_t_and_m_t":"2>remove the entry with the matching condReconfigId from the VarConditionalReconfig;","paragraph_zero_based":2665},{"literal_text_all_w_t_and_m_t":"NOTE:The UE does not consider the message as erroneous if the condReconfigToRemoveList includes any condReconfigId value that is not part of the current UE configuration.","paragraph_zero_based":2666},{"literal_text_all_w_t_and_m_t":"5.3.5.13.3Conditional reconfiguration addition/modification","paragraph_zero_based":2667},{"literal_text_all_w_t_and_m_t":"For each condReconfigId received in the condReconfigToAddModList IE the UE shall:","paragraph_zero_based":2668},{"literal_text_all_w_t_and_m_t":"1>if an entry with the matching condReconfigId exists in the condReconfigToAddModList within the VarConditionalReconfig:","paragraph_zero_based":2669},{"literal_text_all_w_t_and_m_t":"2>if the entry in condReconfigToAddModList includes an condExecutionCond or condExecutionCondSCG;","paragraph_zero_based":2670},{"literal_text_all_w_t_and_m_t":"3>replace condExecutionCond or condExecutionCondSCG within the VarConditionalReconfig with the value received for this condReconfigId;","paragraph_zero_based":2671},{"literal_text_all_w_t_and_m_t":"2>if the entry in condReconfigToAddModList includes an condRRCReconfig;","paragraph_zero_based":2672},{"literal_text_all_w_t_and_m_t":"3>replace condRRCReconfig within the VarConditionalReconfig with the value received for this condReconfigId;","paragraph_zero_based":2673},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":2674},{"literal_text_all_w_t_and_m_t":"2>add a new entry for this condReconfigId within the VarConditionalReconfig;","paragraph_zero_based":2675},{"literal_text_all_w_t_and_m_t":"1>perform conditional reconfiguration evaluation as specified in 5.3.5.13.4;","paragraph_zero_based":2676},{"literal_text_all_w_t_and_m_t":"5.3.5.13.4Conditional reconfiguration evaluation","paragraph_zero_based":2677},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":2678},{"literal_text_all_w_t_and_m_t":"1>for each condReconfigId within the VarConditionalReconfig:","paragraph_zero_based":2679},{"literal_text_all_w_t_and_m_t":"2>if the RRCReconfiguration within condRRCReconfig includes the masterCellGroup including the reconfigurationWithSync:","paragraph_zero_based":2680},{"literal_text_all_w_t_and_m_t":"3>consider the cell which has a physical cell identity matching the value indicated in the ServingCellConfigCommon included in the reconfigurationWithSync within the masterCellGroup in the received condRRCReconfig to be applicable cell;","paragraph_zero_based":2681},{"literal_text_all_w_t_and_m_t":"2>else if the RRCReconfiguration within condRRCReconfig includes the secondaryCellGroup including the reconfigurationWithSync:","paragraph_zero_based":2682},{"literal_text_all_w_t_and_m_t":"3>consider the cell which has a physical cell identity matching the value indicated in the ServingCellConfigCommon included in the reconfigurationWithSync within the secondaryCellGroup within the received condRRCReconfig to be applicable cell;","paragraph_zero_based":2683},{"literal_text_all_w_t_and_m_t":"2>if condExecutionCondSCG is configured:","paragraph_zero_based":2684},{"literal_text_all_w_t_and_m_t":"3>in the remainder of the procedure, consider each measId indicated in the condExecutionCondSCG as a measId in the VarMeasConfig associated with the SCG measConfig;","paragraph_zero_based":2685},{"literal_text_all_w_t_and_m_t":"2>if condExecutionCond is configured:","paragraph_zero_based":2686},{"literal_text_all_w_t_and_m_t":"3>if it is configured via SRB3 or configured within nr-SCG or within nr-SecondaryCellGroupConfig (specified in TS 36.331[10]) via SRB1:","paragraph_zero_based":2687}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["030fc2e22004bf33189de38d27e3ace3b95ada60fecd63be2f76956703903c76","92240c46fa073eb89ff69f910e6c9f08cd25112742fccb74ed58bc35029038b6","ce6dae1783fcbe922e3c06d484ceff07916ee830e5b87717087efb192f70a048","b7b2dffec28e1b22f474745556abe75145f37df4a155a73a2acf3c45dd812b32","dc48a3beb54ee6c83867dbf0668c47f5107a131f6d63732de9e799303a0f4817","4a8e97a83fa8c89d7c009f49136c4a7cff6b4de0892f36aca02e828c858bf968","26bfa72b6b5457881b7479727be663a9054bd33d39a06b4a1f0e2c3311965b92","5bc6081aadba705f5296aabeb7e74d360f8a25d1e4481336856b81f6893d6162","8f961f8474542b3e7ebc5d98484d370c24caea8f856baad49c02b1e1c07de7e2","fb28ed85456d340b78e149788c2adf1f084b6c191a036d5967d188ff9e2fc52f","7cd0d122cd8398da8ca12106b4bda0fe76bc6667aede63f8b781a127030235a1","9cbdc234b4598c10df4cceb95de6deb4c5452c7e51d6b0df0d98eb427c38b4d2","a0005959516eef556c9144f935e613a745261442cc7aa0507de50c6bc139734d","a155bc41bdc14da63ac43fdd38e43fbb5f3323e9f397ded41d91b84f4d740677","8f0422cd5c23fb5be08a56676bc4681a98226c01320072ed81a03f38f2a7cc57","de35393d08d0dfb60ac808f04dc42dc2dbc1358b05a94dcc4b1ed3c5517d1ced","c1a2bc0a4206d32135d827aef5fad196e95bfb0e1268527a302abfc40b37c0ed","2a64b81990b4c507c85e4ea3d0c80623ea7839be491dba650094654537880ed2","798e3c83b723ecf019b86e00879c03372c21d0806f34a5eba7727c8fadf8d1be","5c0e1f2ac9eb0d4d4ea17a232af7bd12401f96539c08699389bc1d20f2520151","f2a3756c7419139167eb3f5f25d0870810625eacc332694afe17a515ed8e12f0","3cd354d8a374c893022644128539a874f41c24f4d527a0df3543027abcfd92f9","d4026293b876c0da1c3cd76926c230f61b6a551cf4c04136e6808ecab88cf01a","d3f271bd31db60b7ed5b48963af353a53a997f0c3df40ada4c55f66ea52f2c0f"],"paragraph_range_zero_based":[2664,2687],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p2664"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>in the remainder of the procedure, consider each measId indicated in the condExecutionCond as a measId in the VarMeasConfig associated with the SCG measConfig;","paragraph_zero_based":2688},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":2689},{"literal_text_all_w_t_and_m_t":"4>in the remainder of the procedure, consider each measId indicated in the condExecutionCond as a measId in the VarMeasConfig associated with the MCG measConfig;","paragraph_zero_based":2690},{"literal_text_all_w_t_and_m_t":"2>for each measId included in the measIdList within VarMeasConfig indicated in the condExecutionCond or condExecutionCondSCG associated to condReconfigId:","paragraph_zero_based":2691},{"literal_text_all_w_t_and_m_t":"3>if the condEventId is associated with condEventT1, and if the entry condition applicable for this event associated with the condReconfigId, i.e. the event corresponding with the condEventId(s) of the corresponding condTriggerConfig within VarConditionalReconfig, is fulfilled for the applicable cell; or","paragraph_zero_based":2692},{"literal_text_all_w_t_and_m_t":"3> if the condEventId is associated with condEventD1, and if the entry conditions applicable for this event associated with the condReconfigId, i.e. the event corresponding with the condEventId(s) of the corresponding condTriggerConfig within VarConditionalReconfig, is fulfilled for the applicable cell during the corresponding timeToTrigger defined for this event within the VarConditionalReconfig; or","paragraph_zero_based":2693},{"literal_text_all_w_t_and_m_t":"3>if the condEventId is associated with condEventA3, condEventA4 or condEventA5, and if the entry condition(s) applicable for this event associated with the condReconfigId, i.e. the event corresponding with the condEventId(s) of the corresponding condTriggerConfig within VarConditionalReconfig, is fulfilled for the applicable cells for all measurements after layer 3 filtering taken during the corresponding timeToTrigger defined for this event within the VarConditionalReconfig:","paragraph_zero_based":2694},{"literal_text_all_w_t_and_m_t":"4>consider the event associated to that measId to be fulfilled;","paragraph_zero_based":2695},{"literal_text_all_w_t_and_m_t":"3>if the measId for this event associated with the condReconfigId has been modified; or","paragraph_zero_based":2696},{"literal_text_all_w_t_and_m_t":"3>if the condEventId is associated with condEventT1, and if the leaving condition applicable for this event associated with the condReconfigId, i.e. the event corresponding with the condEventId(s) of the corresponding condTriggerConfig within VarConditionalReconfig, is fulfilled for the applicable cell; or","paragraph_zero_based":2697},{"literal_text_all_w_t_and_m_t":"3> if the condEventId is associated with condEventD1, and if the leaving condition(s) applicable for this event associated with the condReconfigId, i.e. the event corresponding with the condEventId(s) of the corresponding condTriggerConfig within VarConditionalReconfig, is fulfilled for the applicable cell during the corresponding timeToTrigger defined for this event within the VarConditionalReconfig; or","paragraph_zero_based":2698},{"literal_text_all_w_t_and_m_t":"3>if the condEventId is associated with condEventA3, condEventA4 or condEventA5, and if the leaving condition(s) applicable for this event associated with the condReconfigId, i.e. the event corresponding with the condEventId(s) of the corresponding condTriggerConfig within VarConditionalReconfig, is fulfilled for the applicable cells for all measurements after layer 3 filtering taken during the corresponding timeToTrigger defined for this event within the VarConditionalReconfig:","paragraph_zero_based":2699},{"literal_text_all_w_t_and_m_t":"4>consider the event associated to that measId to be not fulfilled;","paragraph_zero_based":2700},{"literal_text_all_w_t_and_m_t":"2>if event(s) associated to all measId(s) within condTriggerConfig for the applicable cell are fulfilled:","paragraph_zero_based":2701},{"literal_text_all_w_t_and_m_t":"3>consider the applicable cell, associated to that condReconfigId, as a triggered cell;","paragraph_zero_based":2702},{"literal_text_all_w_t_and_m_t":"3>initiate the conditional reconfiguration execution, as specified in 5.3.5.13.5;","paragraph_zero_based":2703},{"literal_text_all_w_t_and_m_t":"NOTE 1:Up to 2 MeasId can be configured for each condReconfigId. The conditional reconfiguration event of the 2 MeasId may have the same or different event conditions, triggering quantity, time to trigger, and triggering threshold.","paragraph_zero_based":2704},{"literal_text_all_w_t_and_m_t":"NOTE 2:Void.","paragraph_zero_based":2705},{"literal_text_all_w_t_and_m_t":"5.3.5.13.4aConditional reconfiguration evaluation of SN initiated inter-SN CPC for EN-DC","paragraph_zero_based":2706},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":2707},{"literal_text_all_w_t_and_m_t":"1>for each condReconfigurationId within the VarConditionalReconfiguration specified in TS 36.331[10]:","paragraph_zero_based":2708},{"literal_text_all_w_t_and_m_t":"2>for each measId included in the measIdList within VarMeasConfig indicated in the CondReconfigExecCondSCG contained in the triggerConditionSN associated to the condReconfigurationId as specified in TS 36.331[10]:","paragraph_zero_based":2709},{"literal_text_all_w_t_and_m_t":"3>if the entry condition(s) applicable for the event associated with that measId, is fulfilled for the applicable cells for all measurements after layer 3 filtering taken during the corresponding timeToTrigger defined for this event associated with that measId:","paragraph_zero_based":2710},{"literal_text_all_w_t_and_m_t":"4>consider this event to be fulfilled;","paragraph_zero_based":2711}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["f840661eb08f906245566c371c059421f4612ac9dc79e55272284e0ced17e41c","62b718dd52848cff756096a8c61786ce409abdb69e96007399b2e60beb835bf7","b9ac563c3ee8dc37fbe6effe5448aec68faad2db1c3777a041ce94f75f542d1c","21ae4ea974e17c0ef564dd8c58993552ce2247f6eb72986f0f43d5c8f99cb4f3","bf7e714ebf6ce8e722f933b5d883c82c12d7b05bbc65a8d57470ff2d57799ce4","93008c556778e56199bb75bb458bc5175ebd4f0894a5065783a6c0fd285f1087","68be12901fcf272608bfaa18882a8a1b73de4f9611537b8c0cb6e43fdbfb36fa","c3585e8718044539ea6aa5fae47b30d0e1fe62059a9ca4a35b7b95e9442a4a8e","f4f846a1024ca8c02e8253065e464ed1930adf05e50eeb828a48b116faa45d5b","86cf68f46fbeeaaa3cf4b67cdb8d88513c4dbd9f070741e08f7397e8829bade4","e2d165ead9bee5726e081fd6260ed758e495c48f7329cce8cda6386eec334cf7","7d980b194cb220991d970ebb16603f24e1c98abd9bdbaef5f38fc1ec96d82e3f","2ab16d3dbf51fb60423b404e776b21bb56903d7eacc558afd1e3742032d75d3d","66d5eb7b26bb6115b91d5b5bfb10276034fda8e171dc54ab86ae949931de097f","55f55119618668e54d35743362c304246f1144c6b90f0b25e0a6d4c2bc2512bb","24ed93f913ca54860ed9bc2012015b9e27945dbf57a5abe896b223935ccb8d62","13972b2c314395086502e7092facc26d2bd1a5db9825c0d1e09b68c9648cd58f","47daeb26bd2642b313c01f1ae5580f877e9238eb0497338601fa8d5ae55a398b","a65c8ed04bdcfcfc3fa99acd5e1006973bf4a125c19c21d8dbb30c4ed8e8bf7c","b45340a23229accf7f89461925fe892e505c9ff2758619910235479a9a4b69c7","3a70f2986751cf5a9a3520924063a8e03256ef52163448b02a9a5cff478b8062","0f942dc4079183a06eb4c79d58a8f99a4d767f14280af129af841f46cce63e53","71592bb2e463c83cf5e45e5f40487877f7daaa1c0d558465ae2d57d056a6c430","cfd92d7533027c5da169031c5dad6bc3269ff7392d6e72ff310159b2c21279ff"],"paragraph_range_zero_based":[2688,2711],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p2688"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>if the measId for this event has been modified; or","paragraph_zero_based":2712},{"literal_text_all_w_t_and_m_t":"3>if the leaving condition(s) applicable for this event associated with that measId, is fulfilled for the applicable cells for all measurements after layer 3 filtering taken during the corresponding timeToTrigger defined for this event associated with that measId:","paragraph_zero_based":2713},{"literal_text_all_w_t_and_m_t":"4>consider this event associated to that measId to be not fulfilled;","paragraph_zero_based":2714},{"literal_text_all_w_t_and_m_t":"2>if trigger conditions for all events associated with the measId(s) indicated in the CondReconfigExecCondSCG contained in the triggerConditionSN as specified in TS 36.331[10]), are fulfilled:","paragraph_zero_based":2715},{"literal_text_all_w_t_and_m_t":"3>consider the target cell candidate within the RRCReconfiguration message contained in nr-SecondaryCellGroupConfig in the RRCConnectionReconfiguration message, as specified in TS 36.331[10], contained in the stored condReconfigurationToApply, associated to that condReconfigurationId as specified in TS 36.331[10]), clause 5.3.5.9.4, as a triggered cell;","paragraph_zero_based":2716},{"literal_text_all_w_t_and_m_t":"3>initiate the conditional reconfiguration execution, as specified in TS 36.331[10]), clause 5.3.5.9.5;","paragraph_zero_based":2717},{"literal_text_all_w_t_and_m_t":"NOTE:Void.","paragraph_zero_based":2718},{"literal_text_all_w_t_and_m_t":"5.3.5.13.5Conditional reconfiguration execution","paragraph_zero_based":2719},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":2720},{"literal_text_all_w_t_and_m_t":"1>if more than one triggered cell exists:","paragraph_zero_based":2721},{"literal_text_all_w_t_and_m_t":"2>select one of the triggered cells as the selected cell for conditional reconfiguration execution;","paragraph_zero_based":2722},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":2723},{"literal_text_all_w_t_and_m_t":"2>consider the triggered cell as the selected cell for conditional reconfiguration execution;","paragraph_zero_based":2724},{"literal_text_all_w_t_and_m_t":"1>for the selected cell of conditional reconfiguration execution:","paragraph_zero_based":2725},{"literal_text_all_w_t_and_m_t":"2>apply the stored condRRCReconfig of the selected cell and perform the actions as specified in 5.3.5.3;","paragraph_zero_based":2726},{"literal_text_all_w_t_and_m_t":"NOTE:If multiple NR cells are triggered in conditional reconfiguration execution, it is up to UE implementation which one to select, e.g. the UE considers beams and beam quality to select one of the triggered cells for execution.","paragraph_zero_based":2727},{"literal_text_all_w_t_and_m_t":"5.3.5.13aSCG activation","paragraph_zero_based":2728},{"literal_text_all_w_t_and_m_t":"Upon initiating the procedure, the UE shall:","paragraph_zero_based":2729},{"literal_text_all_w_t_and_m_t":"1>if the UE is configured with an SCG after receiving the message for which this procedure is initiated:","paragraph_zero_based":2730},{"literal_text_all_w_t_and_m_t":"2>if the UE was configured with a deactivated SCG before receiving the message for which this procedure is initiated:","paragraph_zero_based":2731},{"literal_text_all_w_t_and_m_t":"3>consider the SCG to be activated;","paragraph_zero_based":2732},{"literal_text_all_w_t_and_m_t":"3>resume performing radio link monitoring on the SCG, if previously stopped;","paragraph_zero_based":2733},{"literal_text_all_w_t_and_m_t":"3>indicate to lower layers to resume beam failure detection on the PSCell, if previously stopped;","paragraph_zero_based":2734},{"literal_text_all_w_t_and_m_t":"3>indicate to lower layers that the SCG is activated.","paragraph_zero_based":2735}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["6f0b3eb42e5a5c1696df9df6412fdb305d5743ec72e30f848ac6fe6c46c30d40","8438429782b574402c4e2216c7f5e4110b501020c2e492a62395ee3dde8a2965","9baba6eecffa1c16b7d75f2e8a693d10acfa88346c9dea1ed377452a7d40c786","455967f56e398c76d7975a0b12632727b48caecddae983a8bd349cdcc76e65eb","dfa7ed67e56680a59a98764b7d2be03fb042d899cf3895c309f2d2665e5435ef","baa3fe25617b654f39a62d9f66fa18a30dc216db97b621d4ae104974801bc2bb","acb2d19524b7e35f7dc2b62b8c5a35e5cb98c7a78918afd63b91632cfe1d7703","301b4c04cecc54b597b11918b95d4bc96095b0a41630eb54305ab21ad13fce0f","3bde737244490f76e917685d4baf5558ff1bd904121ab17a714b6f020f21d61f","dc11903067ad3cde06df49c1d2102f9ea28c71c1e02f9e4969d22934142affd0","0b0ba0be2b774177caffcbcfa53b5870c5e248aad986cc19079f3c9ec9d84b6f","d93c25b4eca1f08feeea6594dd260beb5a3aadeb1fc0b6db313a3beb3586024b","148cc541bad4fd78e3fde8026212ae49ee2a132009ce664b58c269e1e7ccef58","b46798cdc87beae19969159263adb7f266189c26a1344c7ec5d5a07ed25053c7","3a37f0332c147dcf3d0285228cf9e330d97d48fe4a03e5752301ae1f29233621","94cb627dd7b2d33b4637ef7ee8c471e4d136d5066ad7c4d6620401ad7efe8963","cb9b4327b18f13a426388ccb45d01a69d652283fb48f367b4df2c1c485be7d46","8f4a966182d9eab4a50b39099b69627d0b4ac092d1f51f1beff960e6cce9190c","e5d688c401928b7bc3cf7908ebbc6b6d37c996fe5804a3bb0a0bfcac80ce9e11","5f0535cd2007bbcca51c5967943465e2a7d84f1847a5ae240eecb5fa9e110e27","baf8d6082a5c6de0b7f0e59e656e647282df8fff29736ba0fb5140d5e49f492a","3ae7f06b0f3757eec8de61af91199e8a1ad0a18dd76c784afe50a0b3251b8bea","205461665761cc2cbdc9dd917e9de83cfb3cfef6e5769a7313b9c395c0337cab","640efe9ae9ae497b476830c3aabd21e494395fdef6b9e7144d61ae80dd59ef5f"],"paragraph_range_zero_based":[2712,2735],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p2712"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.3.5.13bSCG deactivation","paragraph_zero_based":2736},{"literal_text_all_w_t_and_m_t":"Upon initiating the procedure, the UE shall:","paragraph_zero_based":2737},{"literal_text_all_w_t_and_m_t":"1>consider the SCG to be deactivated;","paragraph_zero_based":2738},{"literal_text_all_w_t_and_m_t":"1>indicate to lower layers that the SCG is deactivated;","paragraph_zero_based":2739},{"literal_text_all_w_t_and_m_t":"1>if bfd-and-RLM is configured to true:","paragraph_zero_based":2740},{"literal_text_all_w_t_and_m_t":"2>perform radio link monitoring on the SCG;","paragraph_zero_based":2741},{"literal_text_all_w_t_and_m_t":"2>indicate to lower layers to perform beam failure detection on the PSCell;","paragraph_zero_based":2742},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":2743},{"literal_text_all_w_t_and_m_t":"2>stop radio link monitoring on the SCG;","paragraph_zero_based":2744},{"literal_text_all_w_t_and_m_t":"2>indicate to lower layers to stop beam failure detection on the PSCell;","paragraph_zero_based":2745},{"literal_text_all_w_t_and_m_t":"2>stop timer T310 for this cell group, if running;","paragraph_zero_based":2746},{"literal_text_all_w_t_and_m_t":"2>stop timer T312 for this cell group, if running;","paragraph_zero_based":2747},{"literal_text_all_w_t_and_m_t":"2>reset the counters N310 and N311;","paragraph_zero_based":2748},{"literal_text_all_w_t_and_m_t":"1>if the UE was in RRC_CONNECTED and the SCG was activated before receiving the message for which this procedure is initiated:","paragraph_zero_based":2749},{"literal_text_all_w_t_and_m_t":"2>if SRB3 was configured before the reception of the RRCReconfiguration or of the RRCConnectionReconfiguration and SRB3 is not to be released according to any RadioBearerConfig included in the RRCReconfiguration or in the RRCConnectionReconfiguration as specified in TS 36.331[10]:","paragraph_zero_based":2750},{"literal_text_all_w_t_and_m_t":"3>trigger the PDCP entity of SRB3 to perform SDU discard as specified in TS 38.323 [5];","paragraph_zero_based":2751},{"literal_text_all_w_t_and_m_t":"3>re-establish the RLC entity of SRB3 as specified in TS 38.322 [4].","paragraph_zero_based":2752},{"literal_text_all_w_t_and_m_t":"5.3.5.13b1SCG activation without SN message","paragraph_zero_based":2753},{"literal_text_all_w_t_and_m_t":"Upon initiating the procedure, the UE shall:","paragraph_zero_based":2754},{"literal_text_all_w_t_and_m_t":"1>if the SCG was deactivated before the reception of the RRCReconfiguration message or the E-UTRA RRCConnectionReconfiguration message for which the procedure invoking this clause is executed:","paragraph_zero_based":2755},{"literal_text_all_w_t_and_m_t":"2>consider the SCG to be activated;","paragraph_zero_based":2756},{"literal_text_all_w_t_and_m_t":"2>indicate to lower layers that the SCG is activated;","paragraph_zero_based":2757},{"literal_text_all_w_t_and_m_t":"2>resume performing radio link monitoring on the SCG, if previously stopped;","paragraph_zero_based":2758},{"literal_text_all_w_t_and_m_t":"2>indicate to lower layers to resume beam failure detection on the PSCell, if previously stopped;","paragraph_zero_based":2759}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["97ded9f2b40667a0afc28bcf000a48574ef67280faa4800a4e5361c34fb4f09d","ccdb324cdb626625352ab185000978073a8cf37c88b72eef190c66b41dc67044","b41a26fa08fff922e9f87e6ac6ea2f4faacb535f462396d0849ea8aef0352af1","d39801ceddd017a5b43117026c7b2f5c3e7c9bbc2d5801bdb78bfea007e5dd7c","82e97f5955bc4670a933d86d797b08c3431ecbc9a06e3ca6233f0117fd148e85","3bd3c9a68c874cd5ed1d4b644b7281242b548fc8c6d959b681fba2c43c154a30","37d0f439bee35446f5ddff81d493b99713bd7330a612809ec20ee1d4dcce0eb9","ebeb1f3f651fec24e809c9697af4dc0738c608a72639b386c3d35236e43f4a62","58f74a032041ff883f0a5597dd419d4e853129caa38c52a5d7f81acf9fb30a7d","b4344ebcd4811f9667fa1b8b5b11dedfbbe015cc7bec14a2c60918643031805d","497666cec8b1a71b2def54ef71eb60ef71f6232b3f79bea7e603417e48b9ab4c","945d9fae70d8bfe9771a191b5e7c9f7878d93d5906128a23796e33cfedd26e10","a7e1d20079dcb41cca70cd2791c9195390ed36791fcb9a1ed100277fa27909e5","522b8a46b72ef34f674b60107bd2f90ee44534077c1ed50f0ea80cefaef37637","dbedda0453ebc379bac06f20179c27d5a32c8a83370c9b26f5abf4c49321f87a","0c377b4db82a77633800068fd4a1c66997f8312c7325182b7f8f8380d3d8c1ab","07ae218e547ea0601e70851e08d0ab50296ff72855509f5bc3eb487e9cf3bf42","b6548e6125892d3dc9901815efae4d8baf1ecf220b8ca36562782199a8a0eca0","f91c8f6b61230b1a0783621a5b27354c5e182123556b4e641d0ce409dde87ae4","d0aeaaf52c96a49b02b06806b47fb9b3195c2bb796101afe32f6ee99396a6edf","58c669362f5f8d8016b2772529af1925a6f5fafaee0923e879c6699906913abe","6c3d113529d0e582390d7f29f81fbc2c659cc56d5add1b2d2e53c80b79fb450c","911dfa9e3fb32898c53f2a99ae6b8bc6dc437a599b86696a6423999d4a7bfc53","5421adc749c13d4e186f9385c51accfaf58bd196fb35e6e549e52218b1c37921"],"paragraph_range_zero_based":[2736,2759],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p2736"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if bfd-and-RLM was not configured to true before the reception of the RRCReconfiguration message or the E-UTRA RRCConnectionReconfiguration message for which the procedure invoking this clause is executed; or","paragraph_zero_based":2760},{"literal_text_all_w_t_and_m_t":"2>if lower layers indicate that a Random Access procedure is needed for SCG activation:","paragraph_zero_based":2761},{"literal_text_all_w_t_and_m_t":"3>initiate the Random Access procedure on the PSCell, as specified in TS 38.321 [3].","paragraph_zero_based":2762},{"literal_text_all_w_t_and_m_t":"5.3.5.13cFR2 UL gap configuration","paragraph_zero_based":2763},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":2764},{"literal_text_all_w_t_and_m_t":"1>if ul-GapFR2-Config is set to setup:","paragraph_zero_based":2765},{"literal_text_all_w_t_and_m_t":"2>if an FR2 UL gap configuration is already setup, release the FR2 UL gap configuration;","paragraph_zero_based":2766},{"literal_text_all_w_t_and_m_t":"2>setup the FR2 UL gap configuration indicated by the ul-GapFR2-Config in accordance with the received gapOffset, i.e., the first subframe of each gap occurs at an SFN and subframe meeting the following condition:","paragraph_zero_based":2767},{"literal_text_all_w_t_and_m_t":"SFN mod T = FLOOR (gapOffset/10);","paragraph_zero_based":2768},{"literal_text_all_w_t_and_m_t":"if the UGRP is larger than 5ms:","paragraph_zero_based":2769},{"literal_text_all_w_t_and_m_t":"subframe = gapOffset mod 10;","paragraph_zero_based":2770},{"literal_text_all_w_t_and_m_t":"else:","paragraph_zero_based":2771},{"literal_text_all_w_t_and_m_t":"subframe = gapOffset or (gapOffset +5);","paragraph_zero_based":2772},{"literal_text_all_w_t_and_m_t":"with T = CEIL(UGRP/10).","paragraph_zero_based":2773},{"literal_text_all_w_t_and_m_t":"1>else if ul-GapFR2-Config is set to release:","paragraph_zero_based":2774},{"literal_text_all_w_t_and_m_t":"2>release the FR2 UL gap configuration.","paragraph_zero_based":2775},{"literal_text_all_w_t_and_m_t":"NOTE 1:For ul-GapFR2-Config configuration with synchronous CA, the SFN and subframe of a serving cell on FR2 frequency is used in the gap calculation. For ul-GapFR2-Config configuration with asynchronous CA, the SFN and subframe of a serving cell on FR2 frequency indicated by the refFR2-ServCellAsyncCA in ul-GapFR2-Config is used in the gap calculation.","paragraph_zero_based":2776},{"literal_text_all_w_t_and_m_t":"5.3.5.13dApplication layer measurement configuration","paragraph_zero_based":2777},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":2778},{"literal_text_all_w_t_and_m_t":"1>if measConfigAppLayerToReleaseList is included in appLayerMeasConfig within RRCReconfiguration or RRCResume:","paragraph_zero_based":2779},{"literal_text_all_w_t_and_m_t":"2>for each measConfigAppLayerId value included in the measConfigAppLayerToReleaseList:","paragraph_zero_based":2780},{"literal_text_all_w_t_and_m_t":"3>forward the measConfigAppLayerId and inform upper layers about the release of the application layer measurement configuration including any RAN visible application layer measurement configuration;","paragraph_zero_based":2781},{"literal_text_all_w_t_and_m_t":"3>discard any application layer measurement report received from upper layers;","paragraph_zero_based":2782},{"literal_text_all_w_t_and_m_t":"3>consider itself not to be configured to send application layer measurement report for the measConfigAppLayerId.","paragraph_zero_based":2783}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["614cb2f6a97bfed65ae5c6c66ab1833db84ca52510d786fb29a3ec1d7c7482b9","094b186d639057be9d415136982793175f538ad115d19e1ad75bfde0c9cc5919","e330f517cd836a747f074e8d693432fcb2c6be9bced46525b11f00c76a5f67e6","067d1e187d6be304920120b24401650bf61579f2d03a90ddf9b8979500a8b32c","624b63b51a84f3b98ee8b8ff092a1edfb5d75af27df77105bbfb26b772448396","ad69f1e9e51f256755670717e34f48795c7f72009f77502c0e58bf8e9f17118f","fde18b2e550424506cb2bd357a66090bce2b40c6441e06205d1ed09f60d3cdca","17bf12bce9ec5b2f07f9c01d17d49a0aeb5df66199045df43f9770b4e803b4f3","548f9f4b9c483b9f49cf51597c679baf6df000811fd7239e160271b1535a3c4b","5b22eaad70e5874b3ac710e76a64dd5dcff8bf27e4aabb9990ba430eb98cffc1","b52736c10a2e5bc6d51951a4ac69b726e6983a373736ec3da4dfdbd522194d83","eef78f61dffd004ac8acfdf67fa29d5aa68a2abe396550cdee9419cbbd1c85bd","57566485f829c2983df4f4930b1ce78d7c26f4fc456b0abb8b0f9998ec518fc2","b3208a9e30fd7822153f7ce49ee208dfe797708cf24010bd2e59f55d7ad347d5","f041a2570d25d660fb7482357ae49591d0cdd320ad26aac9f2d01893d3f0c2be","9708e77682c07f9d7d87396e143115653fe56f731ea526c290247e62d52cb611","21858ab24eda3c6f081825d463913d8ebf74cd899931a7891604d8262f83884c","ffecbf1eefda5dddc244aae85f938b21a7bf4c8ab0c48b7718ba6b30deb63473","486ac40daf4d8bfa942462d38c0858f2c7871531c3a389fc4f06407e866e3486","77d7192741cac9b326bf494a0127a472bca7bd33413c226cd6261f88ce7591ae","8c16c3afb0557b1e39c4c595fbc1b9648dd1d732a6b62c2a305a26dc35bc067f","a30462eb233cbf8d1f101caa2ccee85caf4fd70849698f928af8d33a6f76f363","cd8256f4a68e592099585aec5f2b6c66645a71e628e808ef90ddc97588212917","52efc8608d7d8063ded56b6f1f5246de194392f126fbadcb1f7481cb9dd80487"],"paragraph_range_zero_based":[2760,2783],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p2760"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>if measConfigAppLayerToAddModList is included in appLayerMeasConfig within RRCReconfiguration or RRCResume:","paragraph_zero_based":2784},{"literal_text_all_w_t_and_m_t":"2>for each measConfigAppLayerId value included in the measConfigAppLayerToAddModList:","paragraph_zero_based":2785},{"literal_text_all_w_t_and_m_t":"3>if measConfigAppLayerContainer is included for the corresponding MeasConfigAppLayer configuration:","paragraph_zero_based":2786},{"literal_text_all_w_t_and_m_t":"4>forward the measConfigAppLayerContainer, the measConfigAppLayerId and the serviceType to upper layers considering the serviceType;","paragraph_zero_based":2787},{"literal_text_all_w_t_and_m_t":"3>consider itself to be configured to send application layer measurement report for the measConfigAppLayerId in accordance with 5.7.16;","paragraph_zero_based":2788},{"literal_text_all_w_t_and_m_t":"3>forward the transmissionOfSessionStartStop, if configured, and measConfigAppLayerId to upper layers considering the serviceType;","paragraph_zero_based":2789},{"literal_text_all_w_t_and_m_t":"3>if ran-VisibleParameters is set to setup and the parameters have been received:","paragraph_zero_based":2790},{"literal_text_all_w_t_and_m_t":"4>forward the measConfigAppLayerId, the ran-VisiblePeriodicity, if configured, the numberOfBufferLevelEntries, if configured, and the reportPlayoutDelayForMediaStartup, if configured, to upper layers considering the serviceType;","paragraph_zero_based":2791},{"literal_text_all_w_t_and_m_t":"3>else if ran-VisibleParameters is set to release:","paragraph_zero_based":2792},{"literal_text_all_w_t_and_m_t":"4>forward the measConfigAppLayerId and inform upper layers about the release of the RAN visible application layer measurement configuration;","paragraph_zero_based":2793},{"literal_text_all_w_t_and_m_t":"3>if pauseReporting is set to true:","paragraph_zero_based":2794},{"literal_text_all_w_t_and_m_t":"4>if at least one segment, but not all segments, of a segmented MeasurementReportAppLayer message containing an application layer measurement report associated with the measConfigAppLayerId has been submitted to lower layers for transmission:","paragraph_zero_based":2795},{"literal_text_all_w_t_and_m_t":"5>submit the remaining segments of the MeasurementReportAppLayer message to lower layers for transmission;","paragraph_zero_based":2796},{"literal_text_all_w_t_and_m_t":"4>suspend submitting application layer measurement report containers to lower layers for the application layer measurement configuration associated with the measConfigAppLayerId;","paragraph_zero_based":2797},{"literal_text_all_w_t_and_m_t":"4>store any previously or subsequently received application layer measurement report containers associated with the measConfigAppLayerId for which no segment, or full message, has been submitted to lower layers for transmission;","paragraph_zero_based":2798},{"literal_text_all_w_t_and_m_t":"3>else if pauseReporting is set to false and if transmission of application layer measurement report containers has previously been suspended for the application layer measurement configuration associated with the measConfigAppLayerId:","paragraph_zero_based":2799},{"literal_text_all_w_t_and_m_t":"4>submit stored application layer measurement report containers to lower layers, if any, for the application layer measurements configuration associated with the measConfigAppLayerId;","paragraph_zero_based":2800},{"literal_text_all_w_t_and_m_t":"4>resume submitting application layer measurement report containers to lower layers for the application layer measurement configuration associated with the measConfigAppLayerId;","paragraph_zero_based":2801},{"literal_text_all_w_t_and_m_t":"NOTE 1:The UE may discard reports when the memory reserved for storing application layer measurement report containers becomes full.","paragraph_zero_based":2802},{"literal_text_all_w_t_and_m_t":"NOTE 2:The transmission of RAN visible application layer measurement reports and appLayerSessionStatus is not paused when pauseReporting is set to true.","paragraph_zero_based":2803},{"literal_text_all_w_t_and_m_t":"5.3.5.14Sidelink dedicated configuration","paragraph_zero_based":2804},{"literal_text_all_w_t_and_m_t":"Upon initiating the procedure, the UE shall:","paragraph_zero_based":2805},{"literal_text_all_w_t_and_m_t":"1>if sl-FreqInfoToReleaseList is included in sl-ConfigDedicatedNR within RRCReconfiguration:","paragraph_zero_based":2806},{"literal_text_all_w_t_and_m_t":"2>for each entry included in the received sl-FreqInfoToReleaseList that is part of the current UE configuration:","paragraph_zero_based":2807}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["807188807cfa4cda700227ea8aad6eef07c2eebca0ccd47af91748ecaca507ad","b172bb18e19a6e23818d156ba42abf88d75f10ff9f973b355294d47827db86e2","1cc3931393767be1850991c0e74a91a75b0f51bb1ca2be65f39b03cd28824095","fce1cb377823630d4898cb3ed6c93b33d870d898788cdc3cc7b41925f3f58d55","5885ccaec6a5d8354e3df0fb8f9921f80b3698472b892b163f99efda459ae6d4","65af75c3e1aadb21a129ff4517c9ecb40ddeac0100399711bb0c215990a2cd13","dc34c01daf857e4da39d28a399a8c9cd4f9692016493ec033ec1f0a77574e92e","2eb427a2ca0bfbb6906aae405fd7ed7d6899731fa0bc86a49e9f7c95f788e0ba","291bf4de77755317c35d9f18522246cb60b58a73d8604856694b63d93de6280b","1104a548c7ff0c3381e205494eda0fe1fe222dbf290e934aa8b3a57d802f49da","e47e755ed54202b421678bff87126307c2795512097a6ed30466e348c5ddd8d1","2b60dcda7c3569bad9da3040c04183fc0b557c32d6bfa1fcbfbb91ced90d50ac","2ad359a6bbffb53fd467e8c7a6f4e5fc3b9b370b688894c6001d1170c728381e","5a3a3ef2184c8f98a93102b221f9052b607a213a88ab52f7c53122076f9bbad0","9e76b29a1b6a0f0a7e4ff9186520b66d6806ab3f7dbd1efb83f5a90930d1c851","3d2efe9f9c72930f50f701d0746de47c5eae92b432f893037f06c89a86e74aa0","fc7234572f2d3e0a859541216a37965893e0a9479357fce553b2d5800023df06","42dab14d58b5ac8a93ece671ba512177217102dd42f0fbab66702a165a5f8f1c","567a54e257858e28b9a843e17014ecd677006058efa71909993bfbf977002e3e","6d91e982e2517d93b697a09c1c86bb0087ec54aea775d94cc1af758bdc7825aa","71500015393964698ccc7bf1f34ef724dec2db2eb531f6e77578729ac0414190","7ce941e64ef8a1de58e9a0b65505674dfe85a7b8d2aaedaf88e9098366de5e0b","fb5f94de2eb0a37ee5ad65869ddd585cb8bf0d8912f91e933af7fffaf54199d5","bbd3390dd6bd3bda55859195c14fa82de8fef17303631a35bd089fcc72cca963"],"paragraph_range_zero_based":[2784,2807],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p2784"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>release the related configurations from the stored NR sidelink communication/discovery configurations;","paragraph_zero_based":2808},{"literal_text_all_w_t_and_m_t":"1>if sl-FreqInfoToAddModList is included in sl-ConfigDedicatedNR within RRCReconfiguration:","paragraph_zero_based":2809},{"literal_text_all_w_t_and_m_t":"2>if configured to receive NR sidelink communication:","paragraph_zero_based":2810},{"literal_text_all_w_t_and_m_t":"3>use the resource pool(s) indicated by sl-RxPool for NR sidelink communication reception, as specified in 5.8.7;","paragraph_zero_based":2811},{"literal_text_all_w_t_and_m_t":"2>if configured to transmit NR sidelink communication:","paragraph_zero_based":2812},{"literal_text_all_w_t_and_m_t":"3>use the resource pool(s) indicated by sl-TxPoolSelectedNormal, sl-TxPoolScheduling or sl-TxPoolExceptional for NR sidelink communication transmission, as specified in 5.8.8;","paragraph_zero_based":2813},{"literal_text_all_w_t_and_m_t":"2>if configured to receive NR sidelink discovery:","paragraph_zero_based":2814},{"literal_text_all_w_t_and_m_t":"3>use the resource pool(s) indicated by sl-DiscRxPool or sl-RxPool for NR sidelink discovery reception, as specified in 5.8.13.2;","paragraph_zero_based":2815},{"literal_text_all_w_t_and_m_t":"2>if configured to transmit NR sidelink discovery:","paragraph_zero_based":2816},{"literal_text_all_w_t_and_m_t":"3>use the resource pool(s) indicated by sl-DiscTxPoolSelected, sl-DiscTxPoolScheduling, sl-TxPoolSelectedNormal, sl-TxPoolScheduling or sl-TxPoolExceptional for NR sidelink discovery transmission, as specified in 5.8.13.3;","paragraph_zero_based":2817},{"literal_text_all_w_t_and_m_t":"2>perform CBR measurement on the transmission resource pool(s) indicated by sl-TxPoolSelectedNormal, sl-TxPoolScheduling, sl-DiscTxPoolSelected, sl-DiscTxPoolScheduling or sl-TxPoolExceptional for NR sidelink communication/discovery transmission, as specified in 5.5.3;","paragraph_zero_based":2818},{"literal_text_all_w_t_and_m_t":"2>use the synchronization configuration parameters for NR sidelink communication/discovery on frequencies included in sl-FreqInfoToAddModList, as specified in 5.8.5;","paragraph_zero_based":2819},{"literal_text_all_w_t_and_m_t":"1>if sl-RadioBearerToReleaseList or sl-RLC-BearerToReleaseList is included in sl-ConfigDedicatedNR within RRCReconfiguration:","paragraph_zero_based":2820},{"literal_text_all_w_t_and_m_t":"2>perform sidelink DRB release as specified in 5.8.9.1a.1;","paragraph_zero_based":2821},{"literal_text_all_w_t_and_m_t":"1>if sl-RadioBearerToAddModList or sl-RLC-BearerToAddModList is included in sl-ConfigDedicatedNR within RRCReconfiguration:","paragraph_zero_based":2822},{"literal_text_all_w_t_and_m_t":"2>perform sidelink DRB addition/modification as specified in 5.8.9.1a.2;","paragraph_zero_based":2823},{"literal_text_all_w_t_and_m_t":"1>if sl-ScheduledConfig is included in sl-ConfigDedicatedNR within RRCReconfiguration:","paragraph_zero_based":2824},{"literal_text_all_w_t_and_m_t":"2>configure the MAC entity parameters, which are to be used for NR sidelink communication/discovery, in accordance with the received sl-ScheduledConfig;","paragraph_zero_based":2825},{"literal_text_all_w_t_and_m_t":"1>if sl-UE-SelectedConfig is included in sl-ConfigDedicatedNR within RRCReconfiguration:","paragraph_zero_based":2826},{"literal_text_all_w_t_and_m_t":"2>configure the parameters, which are to be used for NR sidelink communication/discovery, in accordance with the received sl-UE-SelectedConfig;","paragraph_zero_based":2827},{"literal_text_all_w_t_and_m_t":"1>if sl-MeasConfigInfoToReleaseList is included in sl-ConfigDedicatedNR within RRCReconfiguration:","paragraph_zero_based":2828},{"literal_text_all_w_t_and_m_t":"2>for each SL-DestinationIndex included in the received sl-MeasConfigInfoToReleaseList that is part of the current UE configuration:","paragraph_zero_based":2829},{"literal_text_all_w_t_and_m_t":"3>remove the entry with the matching SL-DestinationIndex from the stored NR sidelink measurement configuration information;","paragraph_zero_based":2830},{"literal_text_all_w_t_and_m_t":"1>if sl-MeasConfigInfoToAddModList is included in sl-ConfigDedicatedNR within RRCReconfiguration:","paragraph_zero_based":2831}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["3bc73524c2ce53ff0d38a62b8be8c2daff73b81d429ff5b66f33373f0436815a","35c7b7c0a6082ccaed7dba1ee3b2a5846702554ded35b7c14953cdc1b6833015","d3a8568cc9f60aea43e7c7e1f55b0b0484ebf4ec414325186f86a26cbec01079","a74b4c787cd7d33a3c972bd48d9f8b1999b05414896fc9f8b3af609444a29125","7e632cce4ac7ab834b22ce31df5a95eeaa315fee39dea8ea393052a4f3b088b6","3805b65041874f9369baf198e0cdbc9ad9cd7665873e887a5188f7f8940cf97b","c040c266a9a929c218f956b85cabe6675fe6bd91673ae439b279931ede1c1473","b8283528201227f7807e1e0ae668e448a4f01d8637b27ebd8a6e12c6dceb9db2","029de63928bb1935b96386470f5809bd91634696a556e6440d75b804544d7cdd","32cd9cfaeb189d5b36f6322eab9b1045007e0d1c3e7f77cb195cf68d41f7f74b","a1211a33df859258ae8b15b8324a0bc6d6f2ae31ab50c7831c93b8a608b9faeb","6e21e1a511edf2d5317b52b13554948ecbd34104bf48992711841ca60c083f32","82ba2f9914f471650ebffb7a915fc8596b4197f341a0a10f13e326be5b669489","fdd0365bc6d1e81dd2610691a665bc9a6cadb38583de5bbae38df9e4e662bfc7","36d8679167b36fa47516858efa1b50cc8ebe5f7afa6ea8afb4e4c2e96039b2be","52973e69a3f57dc0eba501549e5cf5bf1152e87728907ffcab2546883e4149fe","514e54e3597fa2798e6459f2565345885757bf03282d96357fab7c84de4a6c92","e0b00c10a79d9a35d3d9fa0c7f9cd56e8d81287bbf871e792f27e31104fe6fd4","2b52300b1531ba077b3d0cd2a433eaff356bd62b4a6d17a0ffbe6433e9deec10","3d72cbbf9c53a75de519bd802be6d8ec6038e17a4aecf9adbc57a57391437752","a747eaad3674fa43472c259816b30683f8527a018722cb0aa07412067a785a52","49f30e19554f46ef21cb0ef22c87407490b69bfd20d0065f077e90dd802c5b18","40e1f100aa9bc89a1ef17352bbfab51973cd2a460767b8da76b11bbf2dc73e55","9e79da42d3c2966d89344322f3340c644e2a0f2faa3972413961dd53557468bc"],"paragraph_range_zero_based":[2808,2831],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p2808"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>for each sl-DestinationIndex included in the received sl-MeasConfigInfoToAddModList that is part of the current stored NR sidelink measurement configuration:","paragraph_zero_based":2832},{"literal_text_all_w_t_and_m_t":"3>reconfigure the entry according to the value received for this sl-DestinationIndex from the stored NR sidelink measurement configuration information;","paragraph_zero_based":2833},{"literal_text_all_w_t_and_m_t":"2>for each sl-DestinationIndex included in the received sl-MeasConfigInfoToAddModList that is not part of the current stored NR sidelink measurement configuration:","paragraph_zero_based":2834},{"literal_text_all_w_t_and_m_t":"3>add a new entry for this sl-DestinationIndex to the stored NR sidelink measurement configuration.","paragraph_zero_based":2835},{"literal_text_all_w_t_and_m_t":"NOTE 1:The UE is expected to update the mapping between the Destination Layer-2 ID and the destination index for the stored NR sidelink measurement configuration after the UE updates the destination list and reports to the gNB.","paragraph_zero_based":2836},{"literal_text_all_w_t_and_m_t":"1>if sl-DRX-ConfigUC-ToReleaseList is included in sl-ConfigDedicatedNR within RRCReconfiguration:","paragraph_zero_based":2837},{"literal_text_all_w_t_and_m_t":"2>for each SL-DestinationIndex included in the received sl-DRX-ConfigUC-ToReleaseList that is part of the current UE configuration:","paragraph_zero_based":2838},{"literal_text_all_w_t_and_m_t":"3>remove the entry with the matching SL-DestinationIndex from the stored NR sidelink DRX configuration information;","paragraph_zero_based":2839},{"literal_text_all_w_t_and_m_t":"1>if sl-DRX-ConfigUC-ToAddModList is included in sl-ConfigDedicatedNR within RRCReconfiguration:","paragraph_zero_based":2840},{"literal_text_all_w_t_and_m_t":"2>for each sl-DestinationIndex included in the received sl-DRX-ConfigUC-ToAddModList that is part of the current stored NR sidelink DRX configuration:","paragraph_zero_based":2841},{"literal_text_all_w_t_and_m_t":"3>reconfigure the entry according to the value received for this sl-DestinationIndex from the stored NR sidelink DRX configuration information;","paragraph_zero_based":2842},{"literal_text_all_w_t_and_m_t":"2>for each sl-DestinationIndex included in the received sl-DRX-ConfigUC-ToAddModList that is not part of the current stored NR sidelink DRX configuration:","paragraph_zero_based":2843},{"literal_text_all_w_t_and_m_t":"3>add a new entry for this sl-DestinationIndex to the stored NR sidelink DRX configuration.","paragraph_zero_based":2844},{"literal_text_all_w_t_and_m_t":"NOTE 2:The UE is expected to update the mapping between the Destination Layer-2 ID and the destination index for the stored NR sidelink DRX configuration after the UE updates the destination list and reports to the gNB.","paragraph_zero_based":2845},{"literal_text_all_w_t_and_m_t":"1>if sl-RLC-ChannelToReleaseList is included in sl-ConfigDedicatedNR within RRCReconfiguration:","paragraph_zero_based":2846},{"literal_text_all_w_t_and_m_t":"2>perform PC5 Relay RLC channel release as specified in 5.8.9.7.1;","paragraph_zero_based":2847},{"literal_text_all_w_t_and_m_t":"1>if sl-RLC-ChannelToAddModList is included in sl-ConfigDedicatedNR within RRCReconfiguration or RRCSetup:","paragraph_zero_based":2848},{"literal_text_all_w_t_and_m_t":"2>perform PC5 Relay RLC channel addition/modification as specified in 5.8.9.7.2;","paragraph_zero_based":2849},{"literal_text_all_w_t_and_m_t":"5.3.5.15L2 U2N Relay UE configuration","paragraph_zero_based":2850},{"literal_text_all_w_t_and_m_t":"5.3.5.15.1General","paragraph_zero_based":2851},{"literal_text_all_w_t_and_m_t":"The network configures the L2 U2N Relay UE with relay operation related configurations. For each connected L2 U2N Remote UE indicated in sl-L2IdentityRemote, the network provides the configuration parameters used for relaying.","paragraph_zero_based":2852},{"literal_text_all_w_t_and_m_t":"The L2 U2N Relay UE shall:","paragraph_zero_based":2853},{"literal_text_all_w_t_and_m_t":"1>if sl-L2RelayUE-Config is set to setup:","paragraph_zero_based":2854},{"literal_text_all_w_t_and_m_t":"2>if the sl-L2RelayUE-Config contains the sl-RemoteUE-ToReleaseList:","paragraph_zero_based":2855}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["6a1c05be48792d2d1f41b0256b7674a0f88fee1ad369c81089d42a0fb2d1dec8","128d4c87d927aaa6af97ae0b6e4c9347bfc49f924432ba23a63db9630c7f6b44","fefe47589a62774854978b994185fc42a537fbc1fc025198416985bdde7a6277","eb35d2b92a6bed8364db069de42bcde0235169dae7815ca03b1c8b7f9797c6a8","921ef69a9363f517e780da4e025021969237dc64829ab15d950493c19ba56ecd","316b3513261f38bb32abde36bd9e13ec2fe1c6fc1d5c6f1be49108ad3277bd80","c886aca972c0ecb75cc519dac76c8db529fc2c514c6b825fab891a6e28237ae9","e1a63bac097317d08423edc2eec39e9dcda7fda7dc7165c964ecc717309e6dd2","78a1e350cbc3d94d430e5ae432f4558dd119275fcfaa7dccbd7f591551f94e84","cb04671c2005b017ab08f42b4747cebdb69fc2643d13c4c704f048af460dafbc","dc027cd8a4169eacaed37754a6cdaa44ca7ff25fdb9e298a6b63e668808cd04f","93faa506f84c6cf4884bc2ec922d4583c484cff393f9bc277d56d344db6967dc","a214ddce943cd206af0cfb02ed693d5644b130871cd9d1c726ac3f9d46e2fc6d","8cfb854c09f78cf41006a468ed573f7383bebeb299278de015d44d7e5b2e06ef","7f1ac7c93d47e71a636c0a77dc4bbfbda9e935dd20f40326b39c3169d156b1cd","6b27fd58775bd77f1d01cfa06bd61a7d71034b77fff2b16625e39024e694186a","2a5adfe95d326aa2495ebc301cf2954462621bd7f56cb8d60d0efca31f2dda3b","cada08e5be06bcc71c247e5e36b5e7c1502da178c4a6952953d028df3d982115","ea1cf0e2c853b4484d28e1d6bfdffafb07aa289a93ef203383dbb8895d54cdca","c7919b40a29636dee028efee2da1c5cbf8598f1317f823ab3fd45db41b082361","629119bfc8fb86c1069c8734b7f65613b1ff2753d26a28948931561ff0a789a8","9310ffab9902f2a20bed29d030b4ff47a6bfe503e650b7b23ad3a133fa8e4a33","a8c983ad93d0982d19cb0939ee7d4c6bfdf49c1cd602307569b9f0f962b4e1a8","af592b925b30f07d7c237bf6ed9ed7dfae227cf95888c7816f9055a3c264deea"],"paragraph_range_zero_based":[2832,2855],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p2832"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>perform the L2 U2N Remote UE release as specified in 5.3.5.15.2;","paragraph_zero_based":2856},{"literal_text_all_w_t_and_m_t":"2>if the sl-L2RelayUE-Config contains the sl-RemoteUE-ToAddModList:","paragraph_zero_based":2857},{"literal_text_all_w_t_and_m_t":"3>perform the L2 U2N Remote UE addition/modification as specified in 5.3.5.15.3;","paragraph_zero_based":2858},{"literal_text_all_w_t_and_m_t":"1>else if sl-L2RelayUE-Config is set to release:","paragraph_zero_based":2859},{"literal_text_all_w_t_and_m_t":"2>release the relay operation related configurations.","paragraph_zero_based":2860},{"literal_text_all_w_t_and_m_t":"5.3.5.15.2L2 U2N Remote UE Release","paragraph_zero_based":2861},{"literal_text_all_w_t_and_m_t":"The L2 U2N Relay UE shall:","paragraph_zero_based":2862},{"literal_text_all_w_t_and_m_t":"1>if the release is triggered by reception of the sl-RemoteUE-ToReleaseList:","paragraph_zero_based":2863},{"literal_text_all_w_t_and_m_t":"2>for each SL-DestinationIdentity value included in the sl-RemoteUE-ToReleaseList:","paragraph_zero_based":2864},{"literal_text_all_w_t_and_m_t":"3>if the current UE has a PC5 RRC connection to a L2 U2N Remote UE with SL-DestinationIdentity:","paragraph_zero_based":2865},{"literal_text_all_w_t_and_m_t":"4>indicate upper layers to trigger PC5 unicast link release.","paragraph_zero_based":2866},{"literal_text_all_w_t_and_m_t":"5.3.5.15.3L2 U2N Remote UE Addition/Modification","paragraph_zero_based":2867},{"literal_text_all_w_t_and_m_t":"The L2 U2N Relay UE shall:","paragraph_zero_based":2868},{"literal_text_all_w_t_and_m_t":"1>if no SRAP entity has been established:","paragraph_zero_based":2869},{"literal_text_all_w_t_and_m_t":"2>establish a SRAP entity as specified in TS 38.351 [66];","paragraph_zero_based":2870},{"literal_text_all_w_t_and_m_t":"1>for each sl-L2IdentityRemote value included in the sl-RemoteUE-ToAddModList that is not part of the current UE configuration (L2 U2N Remote UE Addition):","paragraph_zero_based":2871},{"literal_text_all_w_t_and_m_t":"2>configure the parameters to SRAP entity in accordance with the sl-SRAP-ConfigRelay;","paragraph_zero_based":2872},{"literal_text_all_w_t_and_m_t":"2>if SRB1 is included in sl-MappingToAddModList, and sl-EgressRLC-ChannelPC5 is configured:","paragraph_zero_based":2873},{"literal_text_all_w_t_and_m_t":"3>release SL-RLC1, if established;","paragraph_zero_based":2874},{"literal_text_all_w_t_and_m_t":"3>associate the PC5 Relay RLC channel as indicated by sl-EgressRLC-ChannelPC5 with SRB1;","paragraph_zero_based":2875},{"literal_text_all_w_t_and_m_t":"2>else: (i.e. SRB1 is not included in sl-MappingToAddModList, or SRB1 is included in sl-MappingToAddModList, but sl-EgressRLC-ChannelPC5 is not configured)","paragraph_zero_based":2876},{"literal_text_all_w_t_and_m_t":"3>if SL-RLC1 is not established:","paragraph_zero_based":2877},{"literal_text_all_w_t_and_m_t":"4>apply the default configuration of SL-RLC1 as specified in clause 9.2.4 and associate it with the SRB1;","paragraph_zero_based":2878},{"literal_text_all_w_t_and_m_t":"1>for each sl-L2IdentityRemote value included in the sl-RemoteUE-ToAddModList that is part of the current UE configuration (L2 U2N Remote UE modification):","paragraph_zero_based":2879}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["9317836dc764904a1d0c98c7a6495cce4f7776a796a554f72b585b0a711a21a1","d9ecf65c6c5dfd6f948ead1c36f60eaf5ae31adb340a4b51583d443404a5a9c9","174129570cbd7d99e4f21c50e215483b76894627978800ba179333b6