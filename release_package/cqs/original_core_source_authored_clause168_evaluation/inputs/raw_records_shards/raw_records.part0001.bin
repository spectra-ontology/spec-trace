{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":20568},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20569},{"literal_text_all_w_t_and_m_t":"TimeBetweenEvent-r17 ::= INTEGER (0..1023)","paragraph_zero_based":20570},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20571},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASRESULTS-STOP","paragraph_zero_based":20572},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":20573},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20574},{"literal_text_all_w_t_and_m_t":"MeasResultEUTRA field descriptions","paragraph_zero_based":20575},{"literal_text_all_w_t_and_m_t":"eutra-PhysCellId","paragraph_zero_based":20576},{"literal_text_all_w_t_and_m_t":"Identifies the physical cell identity of the E-UTRA cell for which the reporting is being performed. The UE reports a value in the range 0..503, other values are reserved.","paragraph_zero_based":20577},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20578},{"literal_text_all_w_t_and_m_t":"MeasResultNR field descriptions","paragraph_zero_based":20579},{"literal_text_all_w_t_and_m_t":"averageDelay","paragraph_zero_based":20580},{"literal_text_all_w_t_and_m_t":"Indicates average delay for the packets during the reporting period, as specified in TS 38.314 [53]. Value 0 corresponds to 0 millisecond, value 1 corresponds to 0.1 millisecond, value 2 corresponds to 0.2 millisecond, and so on.","paragraph_zero_based":20581},{"literal_text_all_w_t_and_m_t":"cellResults","paragraph_zero_based":20582},{"literal_text_all_w_t_and_m_t":"Cell level measurement results.","paragraph_zero_based":20583},{"literal_text_all_w_t_and_m_t":"choCandidate","paragraph_zero_based":20584},{"literal_text_all_w_t_and_m_t":"This field indicates whether the associated cell is a candidate target cell for conditional handover. This field may be included only in the SuccessHO-Report within UEInformationResponse message.","paragraph_zero_based":20585},{"literal_text_all_w_t_and_m_t":"choConfig","paragraph_zero_based":20586},{"literal_text_all_w_t_and_m_t":"If the associated cell is a candidate target cell for conditional handover, this field indicates the conditional handover execution condition for each measId within condTriggerConfig associated to the cell. This field may be included only in the rlf-report within UEInformationResponse message.","paragraph_zero_based":20587},{"literal_text_all_w_t_and_m_t":"drb-Id","paragraph_zero_based":20588},{"literal_text_all_w_t_and_m_t":"Indicates DRB value for which uplink PDCP delay ratio or value is provided, according to TS 38.314 [53].","paragraph_zero_based":20589},{"literal_text_all_w_t_and_m_t":"firstTriggeredEvent","paragraph_zero_based":20590},{"literal_text_all_w_t_and_m_t":"This field is set to condFirstEvent if the execution condition associated to the first entry of choConfig was fulfilled first in time. This field is set to condSecondEvent if the execution condition associated to the second entry of choConfig was fulfilled first in time. This field may be included only in rlf-report within UEInformationResponse message.","paragraph_zero_based":20591}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["e0c795ebda67919a3af8fe653e146acada2ef47b5507a0ee0f8dd4daebeeef8b","0fde7892b7d3a0994c652bd065203f7da39df2c123b9d4b959b2a3d38adefa28","7d0210ec514cad9dbf0173f39806b83e65e065f4fd980d34a8d75021903673c5","27da08f09037b06fb21102d44b4be8cdbcdbc4b0b79565c733b79e5d28af6273","ac5aecea9a2487a4d424c62f92a9c5536c756c7d13b23589016