{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37080},{"literal_text_all_w_t_and_m_t":"SL-BWP-Generic-r16 ::=                   SEQUENCE {","paragraph_zero_based":37081},{"literal_text_all_w_t_and_m_t":"    sl-BWP-r16                               BWP                                                                OPTIONAL,    -- Need M","paragraph_zero_based":37082},{"literal_text_all_w_t_and_m_t":"    sl-LengthSymbols-r16                     ENUMERATED {sym7, sym8, sym9, sym10, sym11, sym12, sym13, sym14}   OPTIONAL,    -- Need M","paragraph_zero_based":37083},{"literal_text_all_w_t_and_m_t":"    sl-StartSymbol-r16                       ENUMERATED {sym0, sym1, sym2, sym3, sym4, sym5, sym6, sym7}        OPTIONAL,    -- Need M","paragraph_zero_based":37084},{"literal_text_all_w_t_and_m_t":"    sl-PSBCH-Config-r16                      SetupRelease {SL-PSBCH-Config-r16}                                 OPTIONAL,    -- Need M","paragraph_zero_based":37085},{"literal_text_all_w_t_and_m_t":"    sl-TxDirectCurrentLocation-r16           INTEGER (0..3301)                                                  OPTIONAL,    -- Need M","paragraph_zero_based":37086},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":37087},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37088},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37089},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-BWP-CONFIG-STOP","paragraph_zero_based":37090},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":37091},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37092},{"literal_text_all_w_t_and_m_t":"SL-BWP-Config field descriptions","paragraph_zero_based":37093},{"literal_text_all_w_t_and_m_t":"sl-BWP-DiscPoolConfig","paragraph_zero_based":37094},{"literal_text_all_w_t_and_m_t":"This field indicates the NR sidelink discovery dedicated resource pool configurations on the configured sidelink BWP. The total number of Rx/Tx resource pools configured for communication and discovery does not exceed the maximum number of Rx/Tx resource pool for NR sidelink communication (i.e. maxNrofRXPool-r16/maxNrofTXPool-r16).","paragraph_zero_based":37095},{"literal_text_all_w_t_and_m_t":"sl-BWP-Generic","paragraph_zero_based":37096},{"literal_text_all_w_t_and_m_t":"This field indicates the generic parameters on the configured sidelink BWP.","paragraph_zero_based":37097},{"literal_text_all_w_t_and_m_t":"sl-BWP-PoolConfig","paragraph_zero_based":37098},{"literal_text_all_w_t_and_m_t":"This field indicates the resource pool configurations on the configured sidelink BWP.","paragraph_zero_based":37099},{"literal_text_all_w_t_and_m_t":"sl-BWP-Id","paragraph_zero_based":37100},{"literal_text_all_w_t_and_m_t":"An identifier for this sidelink bandwidth part.","paragraph_zero_based":37101},{"literal_text_all_w_t_and_m_t":"sl-BWP-PoolConfigPS","paragraph_zero_based":37102},{"literal_text_all_w_t_and_m_t":"This field indicates the resource pool configurations for power saving on the configured sidelink BWP. This field does not include sl-TxPoolExceptional.","paragraph_zero_based":37103}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["41f437945502d139459f037d145f0e23c9ead066c62f44c1156c2d04fdd9188c","b1a251f4c815e9143d3bba7d64d772325d4d7e530d4232f456d26df7e8331e06","83cf8bd849c440bb153362399f0401adfff9cff4ee3e6d20225bc42d5a5a8746","1c1ca50eb632c78d599da60f08ba0266347cb97e9d337400b0081099efe9fca4","919ab460ec54d3d9363202cf1a39c046e1eaa1f49970ff970d899615cc030ec4","90f146a7f9f