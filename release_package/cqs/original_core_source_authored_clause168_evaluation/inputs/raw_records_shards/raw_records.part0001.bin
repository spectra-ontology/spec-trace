{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36312},{"literal_text_all_w_t_and_m_t":"–BT-NameList","paragraph_zero_based":36313},{"literal_text_all_w_t_and_m_t":"The IE BT-NameList is used to indicate the names of the Bluetooth beacon which the UE is configured to measure.","paragraph_zero_based":36314},{"literal_text_all_w_t_and_m_t":"BT-NameList information element","paragraph_zero_based":36315},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36316},{"literal_text_all_w_t_and_m_t":"-- TAG-BTNAMELIST-START","paragraph_zero_based":36317},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36318},{"literal_text_all_w_t_and_m_t":"BT-NameList-r16 ::=                SEQUENCE (SIZE (1..maxBT-Name-r16)) OF BT-Name-r16","paragraph_zero_based":36319},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36320},{"literal_text_all_w_t_and_m_t":"BT-Name-r16 ::=                    OCTET STRING (SIZE (1..248))","paragraph_zero_based":36321},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36322},{"literal_text_all_w_t_and_m_t":"-- TAG-BTNAMELIST-STOP","paragraph_zero_based":36323},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36324},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36325},{"literal_text_all_w_t_and_m_t":"BT-NameList field descriptions","paragraph_zero_based":36326},{"literal_text_all_w_t_and_m_t":"bt-Name","paragraph_zero_based":36327},{"literal_text_all_w_t_and_m_t":"If configured, the UE only performs Bluetooth measurements according to the names identified. For each name, it refers to LOCAL NAME defined in Bluetooth specification [51].","paragraph_zero_based":36328},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36329},{"literal_text_all_w_t_and_m_t":"–DedicatedInfoF1c","paragraph_zero_based":36330},{"literal_text_all_w_t_and_m_t":"The IE DedicatedInfoF1c is used to transfer IAB-DU specific F1-C related information between the network and the IAB node. The carried information consists of F1AP message encapsulated in SCTP/IP or F1-C related (SCTP)/IP packet, see TS 38.472 [64]. The RRC layer is transparent for this information.","paragraph_zero_based":36331},{"literal_text_all_w_t_and_m_t":"DedicatedInfoF1c information element","paragraph_zero_based":36332},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36333},{"literal_text_all_w_t_and_m_t":"-- TAG-DEDICATEDINFOF1C-START","paragraph_zero_based":36334},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["3884856a5a45006074aaf498270703fec53b714e189f8e74d446177d87462cd5","158c7faa7ff026254c7b901c6cf2eb5c9387b3cb22184e8f54404d3d8953f116","77f5c1c05976b3109c673e1c8f97abea16438ecb5145100917e8c2f1cac22d0e","b8025a6e9331e130e2d989fa6b3ac7bd8b72e3bbfa9b5c95940ac935b1fa3446","80efb4618898b63c4108a413b8e919c4110f267fe5f3a4c1618bfa48d62a61bb","1cc8a51a7a4456400f49f5e8d2e8784758be31005fd206cfc34241949efbbded","fb8ad4bf45d00f875dd0c2fced109a57db9cef2919a2a79ed9d65e1cc6329d41","ba49a4911983b49fb254f6e4e767e26638e94746a61b26d83007314c061b096e","e03e4b5408bc989f86dfae9426f9cc46e0f90918a7826be40181a6812e18fd86","23c25683fda01d3d0386ee076dde67c21baceee28c0f6210ce36c2891058b25d","39864b9d2a52f48f30d5a3f0c1546276e8a2803ddc3d10b8ee149f4d45b77300","dab197fa5fda38df4fe59037d636dea1e8550238bc4fdd70a256f154e64b9d42","d310dc2c6648cf96c672182e874ba47df314cedce1956bec487a6d8aba151aaf","c529bd5d51c628d0eb7d8d774137e8839edc2575a776807ee38265036aa10fc6","359