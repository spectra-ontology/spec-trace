{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    precoderGranularity                 ENUMERATED {sameAsREG-bundle, allContiguousRBs},","paragraph_zero_based":16800},{"literal_text_all_w_t_and_m_t":"    tci-StatesPDCCH-ToAddList           SEQUENCE(SIZE (1..maxNrofTCI-StatesPDCCH)) OF TCI-StateId OPTIONAL, -- Cond NotSIB-initialBWP","paragraph_zero_based":16801},{"literal_text_all_w_t_and_m_t":"    tci-StatesPDCCH-ToReleaseList       SEQUENCE(SIZE (1..maxNrofTCI-StatesPDCCH)) OF TCI-StateId OPTIONAL, -- Cond NotSIB-initialBWP","paragraph_zero_based":16802},{"literal_text_all_w_t_and_m_t":"    tci-PresentInDCI                        ENUMERATED {enabled}                                  OPTIONAL, -- Need S","paragraph_zero_based":16803},{"literal_text_all_w_t_and_m_t":"    pdcch-DMRS-ScramblingID                 INTEGER (0..65535)                                    OPTIONAL, -- Need S","paragraph_zero_based":16804},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":16805},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":16806},{"literal_text_all_w_t_and_m_t":"    rb-Offset-r16                       INTEGER (0..5)                                            OPTIONAL, -- Need S","paragraph_zero_based":16807},{"literal_text_all_w_t_and_m_t":"    tci-PresentDCI-1-2-r16              INTEGER (1..3)                                            OPTIONAL, -- Need S","paragraph_zero_based":16808},{"literal_text_all_w_t_and_m_t":"    coresetPoolIndex-r16                INTEGER (0..1)                                            OPTIONAL, -- Need S","paragraph_zero_based":16809},{"literal_text_all_w_t_and_m_t":"    controlResourceSetId-v1610          ControlResourceSetId-v1610                                OPTIONAL  -- Need S","paragraph_zero_based":16810},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":16811},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":16812},{"literal_text_all_w_t_and_m_t":"    followUnifiedTCI-State-r17           ENUMERATED {enabled}                                      OPTIONAL  -- Need R","paragraph_zero_based":16813},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":16814},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":16815},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16816},{"literal_text_all_w_t_and_m_t":"-- TAG-CONTROLRESOURCESET-STOP","paragraph_zero_based":16817},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":16818},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16819},{"literal_text_all_w_t_and_m_t":"ControlResourceSet field descriptions","paragraph_zero_based":16820},{"literal_text_all_w_t_and_m_t":"cce-REG-MappingType","paragraph_zero_based":16821},{"literal_text_all_w_t_and_m_t":"Mapping of Control Channel Elements (CCE) to Resource Element Groups (REG) (see TS 38.211 [16], clauses 7.3.2.2 and 7.4.1.3.2).","paragraph_zero_based":16822},{"literal_text_all_w_t_and_m_t":"controlResourceSetId","paragraph_zero_based":16823}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["6e127ac9b4626b20e019271b092616eb7ab939196c1246e6f3fac65dafee5c29","be1be54dda826b52ec9fe7cf4ca51b86c08c4489040c42cd3a6567722c4a56de","1b12d83f8c81b2ec98b6d0c53895e30c0ac376b9cf03d02dfc97936fcd87dde1","df0e1d2c632a935894f33658bc541e8d5b16f2d903d013a06028d5de7df81bec","c669d27b440caaf0eb7996f9f0ca0b93464d3634c77fb00559acfc7bfef75bd3","7c5c48ccd9c062093a33e5dfcd3155220dcdec35800e08659c4a3756f0d3e747","dbf5f432b4ef93aa61eac72d0af43b039ade0d2af7c178551f6be384e271a1f0","21d469188dec0ef3e7175de8409612070ec65e644c9726ff3dbcbe576dd89acd","dba87f061506be0ff768cb13544d62f30278e65348dc01fe11121034ce31478b","58702214b21eea17011aadad15f3ab3f02ba5180c43fb85e667ad2c5b6b7a87f","00f81ca71e5c26d599b8a2ce540132ac314ac5e61136289717edb9d7e2f40b62","74ea11400474db3a0a17eda408ee1cccaf2ff01591e8117b2c37fb30ff94657d","3e89b5d3405ce5f2d74702b87f9535aa9b930f5fb75c2b1bae5131969842a130","76acd3390663b88a6a2831b3130281fcdc8502d7b87e51e152fed23ce9b5b68c","6503716eed67df146cd36185eca171bc752bbdbebe29ce8673dc29ab092f1b1c","efda939b3198e3f7ba89d5183f26d7788fadfa4663fdae9bbd076b847fcacd4e","51c7c0853db1d97170edf794b2c8a5c50a64380a3dbdcce7255949fb2be7cca8","b97c7d856e27b356a438e1145643fc91dfad6e00cbf50b5dd98f5a32073c9150","29fb7cc87ee4079fd4de22feeec3afa6b619ab38ce5f063cb23bf0ff6b2dc798","da707771a44b4453ec04b9add3f3825923b74a689a352aefed35e5121335c697","7302844f80dac72f80ba2a0b1ac0baa3dc455a8d3ffdc52166e8f4fadfd0750c","e1eca98213efe0f77ae2ed2ddefb6375d09214d62a6fae0e056d08dc14970522","29a2b440ced0acd6b9a7296eb5d37ad12bd9d3999b2607749d17c7cbf9b17c59","e6fef974668b2c5461bc18f3c1ffa5e465f2d49623ac340c8cc52764230f99e6"],"paragraph_range_zero_based":[16800,16823],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p16800"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Identifies the instance of the ControlResourceSet IE. Value 0 identifies the common CORESET configured in MIB and in ServingCellConfigCommon (controlResourceSetZero) and is hence not used here in the ControlResourceSet IE. Other values identify CORESETs configured by dedicated signalling or in SIB1 or SIB20. The controlResourceSetId is unique among the BWPs of a serving cell.","paragraph_zero_based":16824},{"literal_text_all_w_t_and_m_t":"If the field controlResourceSetId-v1610 is present, the UE shall ignore the controlResourceSetId field (without suffix).","paragraph_zero_based":16825},{"literal_text_all_w_t_and_m_t":"coresetPoolIndex","paragraph_zero_based":16826},{"literal_text_all_w_t_and_m_t":"The index of the CORESET pool for this CORESET as specified in TS 38.213 [13] (clauses 9 and 10) and TS 38.214 [19] (clauses 5.1 and 6.1). If the field is absent, the UE applies the value 0.","paragraph_zero_based":16827},{"literal_text_all_w_t_and_m_t":"duration","paragraph_zero_based":16828},{"literal_text_all_w_t_and_m_t":"Contiguous time duration of the CORESET in number of symbols (see TS 38.211 [16], clause 7.3.2.2).","paragraph_zero_based":16829},{"literal_text_all_w_t_and_m_t":"followUnifiedTCI-State","paragraph_zero_based":16830},{"literal_text_all_w_t_and_m_t":"When set to enabled, for PDCCH reception on this CORESET, the UE applies the \"indicated\" DL only TCI or joint TCI as specified in TS 38.214 [19], clause 5.1.5.","paragraph_zero_based":16831},{"literal_text_all_w_t_and_m_t":"frequencyDomainResources","paragraph_zero_based":16832},{"literal_text_all_w_t_and_m_t":"Frequency domain resources for the CORESET. Each bit corresponds a group of 6 RBs, with grouping starting from the first RB group in the BWP or MBS CFR where the CORESET is configured. When at least one search space is configured with freqMonitorLocation-r16, only the first NRBG,set0size bits are valid (see TS 38.213 [13], clause 10.1). The first (left-most / most significant) bit corresponds to the first RB group in the BWP or MBS CFR where the CORESET is configured, and so on. A bit that is set to 1 indicates that this RB group belongs to the frequency domain resource of this CORESET. Bits corresponding to a group of RBs not fully contained in the bandwidth part within which the CORESET is configured are set to zero (see TS 38.211 [16], clause 7.3.2.2).","paragraph_zero_based":16833},{"literal_text_all_w_t_and_m_t":"interleaverSize","paragraph_zero_based":16834},{"literal_text_all_w_t_and_m_t":"Interleaver-size (see TS 38.211 [16], clause 7.3.2.2).","paragraph_zero_based":16835},{"literal_text_all_w_t_and_m_t":"pdcch-DMRS-ScramblingID","paragraph_zero_based":16836},{"literal_text_all_w_t_and_m_t":"PDCCH DMRS scrambling initialization (see TS 38.211 [16], clause 7.4.1.3.1). When the field is absent the UE applies the value of the physCellId configured for this serving cell.","paragraph_zero_based":16837},{"literal_text_all_w_t_and_m_t":"precoderGranularity","paragraph_zero_based":16838},{"literal_text_all_w_t_and_m_t":"Precoder granularity in frequency domain (see TS 38.211 [16], clauses 7.3.2.2 and 7.4.1.3.2).","paragraph_zero_based":16839},{"literal_text_all_w_t_and_m_t":"rb-Offset","paragraph_zero_based":16840},{"literal_text_all_w_t_and_m_t":"Indicates the RB level offset in units of RB from the first RB of the first 6RB group to the first RB of BWP (see 38.213 [13], clause 10.1).","paragraph_zero_based":16841},{"literal_text_all_w_t_and_m_t":"reg-BundleSize","paragraph_zero_based":16842},{"literal_text_all_w_t_and_m_t":"Resource Element Groups (REGs) can be bundled to create REG bundles. This parameter defines the size of such bundles (see TS 38.211 [16], clause 7.3.2.2).","paragraph_zero_based":16843},{"literal_text_all_w_t_and_m_t":"shiftIndex","paragraph_zero_based":16844},{"literal_text_all_w_t_and_m_t":"When the field is absent the UE applies the value of the physCellIdconfigured for this serving cell (see TS 38.211 [16], clause 7.3.2.2).","paragraph_zero_based":16845},{"literal_text_all_w_t_and_m_t":"tci-PresentInDCI","paragraph_zero_based":16846},{"literal_text_all_w_t_and_m_t":"This field indicates if TCI field is present or absent in DCI format 1_1 and DCI format 4_2. When the field is absent the UE considers the TCI to be absent/disabled. In case of cross carrier scheduling, the network sets this field to enabled for the ControlResourceSet used for cross carrier scheduling in DCI format 1_1 in the scheduling cell if enableDefaultBeamForCCS is not configured (see TS 38.214 [19], clause 5.1.5).","paragraph_zero_based":16847}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["cd9ffe36a8ac47f32ffe69ae10ef6c9a7b9bdbbf6016d9c71a45799e593858c5","ab32a402ef687bd89447573d95f0e7359e77adbbbb5a7c18dbe647ce34eb4485","6cda68e17c8b3e408aa4e0beeb9fbbcd996b22a8c526a35734783d3fee34af3f","989a675520358542354d273aa361e0dbf9747e8cb8ce6ae276967467bf7a964e","52e322a35c5b696d5047e464f3f40a6e189faa53d3347cdcdea497724aeacc38","3b486614be9264f2f3c15fda5130ed79078d3bec0141542a04123413c36d5beb","bc0c44a36e954cf3eecd866dc27483a740ad24fae329e5caa20803d4f1dd896c","79ef580f545ae2c40621f402bb63015782e7bdaf0083af68f2772e5b2acca157","0bbd7e2613e8d8bafa4e21e67c38c9a18b7bdaa6bcfb8332d98ee90d9a3fc542","57b2dbe9fba79ccdec824237345f1324c9fb0279b69bdaf84f74b38ee6fc35bc","87ac406825c017650712b4aa9f746b87bcf5e9985d10c3b09b30b66dff53037a","3453b71855b5273832c36411ce1eb8ac7f29f53fc41b32b08c2f72886626d7ab","ce5551306e7d3e9ad7a525acd00bf5d8b4f8466d9512c76fdf191237a6372138","50f7f8808d4ea65866e061de0eb95b48ff1a69c3b8a0df94530c34316b6d8b30","3824afa9604e270104cf4fbbf02739d5cd94f72ff75cc72bcf977afac2866cd8","f3bb7a585813d0e8db8e5580dd04862bb67dd5e4ba3573ad5d8a97dcbd61ce66","b50800a12b808d707a70a0a434f40305f211cef94b9decb4ee013c5f51e36a86","e1006249c646872aeb5b8d640b0307993b8d06031f92eed4585f986249f3da5c","a7a1c85214c3190ced1114cb81b7a0675cef4aa7fc1bbe7468b5ff1bf50f7d01","2997c03375141244c69bf2d30deb0504c9ab2c37dc3f46a298e44b36289db8a5","5454d03d367e52b573d89ec333c5371bd43578002a625411c21d01f617b4ffe1","47a3d16aeef7dd4f4923b7439d1f9d8ed2bbf69e5d9b1b9e1ef71e14ff6558f7","d40aa1b2360677bab3980641761384501d2b88c0958c71b3c7d59e166dc80f37","63c3577251965dddca699ac198980389f2cbe528ed78368d12e87864e2ceb428"],"paragraph_range_zero_based":[16824,16847],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p16824"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"tci-PresentDCI-1-2","paragraph_zero_based":16848},{"literal_text_all_w_t_and_m_t":"Configures the number of bits for \"Transmission configuration indicator\" in DCI format 1_2. When the field is absent the UE applies the value of 0 bit for the \"Transmission configuration indicator\" in DCI format 1_2 (see TS 38.212 [17], clause 7.3.1 and TS 38.214 [19], clause 5.1.5). In case of cross carrier scheduling, the network configures this field for the ControlResourceSet used for cross carrier scheduling in DCI format 1_2 in the scheduling cell if enableDefaultBeamForCCS is not configured (see TS 38.214 [19], clause 5.1.5).","paragraph_zero_based":16849},{"literal_text_all_w_t_and_m_t":"tci-StatesPDCCH-ToAddList","paragraph_zero_based":16850},{"literal_text_all_w_t_and_m_t":"A subset of the TCI states defined in pdsch-Config, either with tci-StatesToAddModList or dl-OrJointTCI-StateList, included in the BWP-DownlinkDedicated corresponding to the serving cell and to the DL BWP to which the ControlResourceSet belong to. They are used for providing QCL relationships between the DL RS(s) in one RS Set (TCI-State) and the PDCCH DMRS ports (see TS 38.213 [13], clause 6.). The network configures at most maxNrofTCI-StatesPDCCH entries. The QCL relationships defined herein do not apply to MBS broadcast.","paragraph_zero_based":16851},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16852},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":16853},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":16854},{"literal_text_all_w_t_and_m_t":"NotSIB-initialBWP","paragraph_zero_based":16855},{"literal_text_all_w_t_and_m_t":"The field is absent in SIB1/SIB20 and in the PDCCH-ConfigCommon of the initial BWP in ServingCellConfigCommon, if SIB1/SIB20 is broadcasted. Otherwise, it is optionally present, Need N.","paragraph_zero_based":16856},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16857},{"literal_text_all_w_t_and_m_t":"–ControlResourceSetId","paragraph_zero_based":16858},{"literal_text_all_w_t_and_m_t":"The ControlResourceSetId IE concerns a short identity, used to identify a control resource set within a serving cell. The ControlResourceSetId = 0 identifies the ControlResourceSet#0 configured via PBCH (MIB) and in controlResourceSetZero (ServingCellConfigCommon). The ID space is used across the BWPs and MBS CFRs of a Serving Cell.","paragraph_zero_based":16859},{"literal_text_all_w_t_and_m_t":"ControlResourceSetId information element","paragraph_zero_based":16860},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":16861},{"literal_text_all_w_t_and_m_t":"-- TAG-CONTROLRESOURCESETID-START","paragraph_zero_based":16862},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16863},{"literal_text_all_w_t_and_m_t":"ControlResourceSetId ::=                INTEGER (0..maxNrofControlResourceSets-1)","paragraph_zero_based":16864},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16865},{"literal_text_all_w_t_and_m_t":"ControlResourceSetId-r16 ::=            INTEGER (0..maxNrofControlResourceSets-1-r16)","paragraph_zero_based":16866},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16867},{"literal_text_all_w_t_and_m_t":"ControlResourceSetId-v1610 ::=          INTEGER (maxNrofControlResourceSets..maxNrofControlResourceSets-1-r16)","paragraph_zero_based":16868},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16869},{"literal_text_all_w_t_and_m_t":"-- TAG-CONTROLRESOURCESETID-STOP","paragraph_zero_based":16870},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":16871}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["82ae2ae922191adb6d350188cef8280d76fdddaef9de8a221ae2523dccdec2b5","a440436cb08970bf3d01b4b17d3577066ff0984741c11c166c428f507dbe9a43","e80f8a46023b94dd7296f2e178e7d0220e78f8ccb359eb23e0498ae2407db78b","cd84ffcdb9836c70ccc9057fea3659e42e4d500e928efedea70a82adff2525f1","ce935470b6a4c816c324f4c2c47306b1d82e993608ab9845db3fd2172e751c99","36af0c8511f725f1efa27c2a87b02a6d056c0ccda2f8776480395c3b67848165","d7c2f0195f98076f251fef75251d6a84091082d7164932be5735ddad6add7dcd","fd979eb20e6dfa13ce804a04f69366d2f1f2c667ce19672829ae6871db278c0e","63d6fe4d9f23c0647f231e29dea66c59013509cff89749452fa5dc7a6211cf07","1e7df073cc5cc09eb5e968cb2ad3ba85a3dcdc142074b969120ce003650d61e5","ce5b2a2184b8635a2033ccc14302e4e617b4a49f0d05e81bd99d886cd454cdc1","ad645b34447dd75cf982974996f7155a855c8e1bceb61273bdf2d8722389bdbc","3b33b1c046ab34d38ed7fded80bd2b36081f8631591c640143feb24eabdebb40","2d37dbc5f34d8fe70eab9d36df4dd284ac28164e21f25d286cac0fa0739f8d97","aaef2c7f70630b08a56b9e007fa98d08163a99fa30226725a96c3bead138cec7","07467dae177e2f117cec315c06f6c3372612140208048451f4e9e614537b0f1b","76ec8691d50ac78f031154f47bb18abf05ecbb864b6f3e7fe3af461299994e6b","f2f76bd9a967961b72b8fea0e41a5b947cae7fda2ea54d42926a10f582b4bfb5","7aa6b3a2a3691bccd3b12bb91b49fa334e9f44da79911689411678f31f4678df","b136b04cb4c18c56b21ea1449a2abe1027c9f3bc787b6d7463ce2ed2ba531dcf","a44ed7e4859245d96334e39ba5fb4bfd6343a8a35f119dcec3793efc16e2412d","8f94b214f9edc578689b2bbfdd8a7a5a7286a4266a72456c37508b2b0a62f1ed","e2fa50a8cca24c3abb95e79dd64f0c499bf971e4c90ddc4f29b08fd2df08530a","a89aaaf5c4c04ed0aee5f5f907026a201481a6bcb83154d2ae78bb237efab6a1"],"paragraph_range_zero_based":[16848,16871],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p16848"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16872},{"literal_text_all_w_t_and_m_t":"–ControlResourceSetZero","paragraph_zero_based":16873},{"literal_text_all_w_t_and_m_t":"The IE ControlResourceSetZero is used to configure CORESET#0 of the initial BWP (see TS 38.213 [13], clause 13).","paragraph_zero_based":16874},{"literal_text_all_w_t_and_m_t":"ControlResourceSetZero information element","paragraph_zero_based":16875},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":16876},{"literal_text_all_w_t_and_m_t":"-- TAG-CONTROLRESOURCESETZERO-START","paragraph_zero_based":16877},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16878},{"literal_text_all_w_t_and_m_t":"ControlResourceSetZero ::=                  INTEGER (0..15)","paragraph_zero_based":16879},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16880},{"literal_text_all_w_t_and_m_t":"-- TAG-CONTROLRESOURCESETZERO-STOP","paragraph_zero_based":16881},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":16882},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16883},{"literal_text_all_w_t_and_m_t":"–CrossCarrierSchedulingConfig","paragraph_zero_based":16884},{"literal_text_all_w_t_and_m_t":"The IE CrossCarrierSchedulingConfig is used to specify the configuration when the cross-carrier scheduling is used in a cell.","paragraph_zero_based":16885},{"literal_text_all_w_t_and_m_t":"CrossCarrierSchedulingConfig information element","paragraph_zero_based":16886},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":16887},{"literal_text_all_w_t_and_m_t":"-- TAG-CROSSCARRIERSCHEDULINGCONFIG-START","paragraph_zero_based":16888},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16889},{"literal_text_all_w_t_and_m_t":"CrossCarrierSchedulingConfig ::=        SEQUENCE {","paragraph_zero_based":16890},{"literal_text_all_w_t_and_m_t":"    schedulingCellInfo                      CHOICE {","paragraph_zero_based":16891},{"literal_text_all_w_t_and_m_t":"        own                                     SEQUENCE {                  -- Cross carrier scheduling: scheduling cell","paragraph_zero_based":16892},{"literal_text_all_w_t_and_m_t":"            cif-Presence                            BOOLEAN","paragraph_zero_based":16893},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":16894},{"literal_text_all_w_t_and_m_t":"        other                                   SEQUENCE {                  -- Cross carrier scheduling: scheduled cell","paragraph_zero_based":16895}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["9daede3053cfa7ef328a413bbd4a7ffd69221885af1c1c1ce90aed7768464390","8c37c317fc6384a1fa8d398dabf79f4c89603691d1ea87ee9edeca507dc995a1","d30689e0a556eace4f215389e1df92891474e83b3bb72cef78a42a92d1119ce5","44b5a9739e55f39ead9129b20b9aa9010b07ca40c5905b47214e66bf98a6ad99","c3292c7d7e0783a2f4c0288e02af5f900a97c1fecdc2190d26b5659f5c983360","7dec9f2faba458bd294706002f2b44a9a1009b46db9404ce30076c80300c62a9","9e2ce53d633aa18821749df4657eb777e1095e28bd361523e698b9fdc7edb2a8","e09d37e621ecee8a531f43f4b2cebc711b2946419bb470c8096fd7c0419f3a64","f1fee91496ca59298175d3d057a738dce69b57815dda38b35a840af3c78e9ce7","4ef753c55426ba1e066d96fd2ed883a60356146d6c57da49aaa28cc69f624adc","1f5566eda28a490098e61283d9d9381869a94e1aa42cc49b1ebbb4f1c0a096d1","99759be9d32c2252c43ace41c05cbf10823da81e5fd8be7de6ba0bc076b20661","4d4b5b6e1f6200143f70c9dfb7a8d3d55e40ea843832b98d9a6015dbf3f25d2c","e0a0c7a4c3d1948bf96cc3693567d66fc99f0acb8e6945e01cbfa1f469c23f25","ab34ceb1ca68b950bd20ebca5c8d7f83952878a76449f981938395906638fdea","e09b6fb7dee16d0df99a43bb0490f817d3ecdea36eabfa8d17783511f9fdbc32","8f5d5ba9102dce406410a6b233b5430643e8ef95957755b895f084c700995601","1536b0408c0a6ab2a1843cd35da78d93e7b03f2f33d20e8709aab03b991f6eb1","f549a02a009f6c299f8923d894d2c7484a55986e2e373e1d8453a2e4c0fabec4","5519cc862ce392c81e3c0e2c54d14309d37fd892ce46dd4a3d5c6c9b9b5bb44c","550c0bf1c73176377d86215b1791f9e3796c469498de064b7f34b755c14fe3a9","46fdd6535b61de3c53d87dc6db2ff8bf3798c98ace435362b11e857067bd9b12","8ca290ead9e440a4441a647df2725cf912b3200e8d07b514fe5ea4826299ff27","5c01a0def1e39ecf8d4d3723e6fd244053bf1113bc0c1dcf0f23589094760881"],"paragraph_range_zero_based":[16872,16895],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p16872"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"            schedulingCellId                        ServCellIndex,","paragraph_zero_based":16896},{"literal_text_all_w_t_and_m_t":"            cif-InSchedulingCell                    INTEGER (1..7)","paragraph_zero_based":16897},{"literal_text_all_w_t_and_m_t":"        }","paragraph_zero_based":16898},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":16899},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":16900},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":16901},{"literal_text_all_w_t_and_m_t":"    carrierIndicatorSize-r16            SEQUENCE {","paragraph_zero_based":16902},{"literal_text_all_w_t_and_m_t":"        carrierIndicatorSizeDCI-1-2-r16        INTEGER (0..3),","paragraph_zero_based":16903},{"literal_text_all_w_t_and_m_t":"        carrierIndicatorSizeDCI-0-2-r16        INTEGER (0..3)","paragraph_zero_based":16904},{"literal_text_all_w_t_and_m_t":"    }                                                                                       OPTIONAL,  -- Cond CIF-PRESENCE","paragraph_zero_based":16905},{"literal_text_all_w_t_and_m_t":"    enableDefaultBeamForCCS-r16         ENUMERATED {enabled}                                OPTIONAL  -- Need S","paragraph_zero_based":16906},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":16907},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":16908},{"literal_text_all_w_t_and_m_t":"    ccs-BlindDetectionSplit-r17         ENUMERATED {oneSeventh, threeFourteenth, twoSeventh, threeSeventh,","paragraph_zero_based":16909},{"literal_text_all_w_t_and_m_t":"                                            oneHalf, fourSeventh, fiveSeventh, spare1}      OPTIONAL  -- Need R","paragraph_zero_based":16910},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":16911},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":16912},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16913},{"literal_text_all_w_t_and_m_t":"-- TAG-CROSSCARRIERSCHEDULINGCONFIG-STOP","paragraph_zero_based":16914},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":16915},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16916},{"literal_text_all_w_t_and_m_t":"CrossCarrierSchedulingConfig field descriptions","paragraph_zero_based":16917},{"literal_text_all_w_t_and_m_t":"carrierIndicatorSizeDCI-0-2, carrierIndicatorSizeDCI-1-2","paragraph_zero_based":16918},{"literal_text_all_w_t_and_m_t":"Configures the number of bits for the field of carrier indicator in PDCCH DCI format 0_2/1_2. The field carrierIndicatorSizeDCI-0-2 refers to DCI format 0_2 and the field carrierIndicatorSizeDCI-1-2 refers to DCI format 1_2, respectively (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13], clause 10.1).","paragraph_zero_based":16919}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["36135734c09ae5f1ae5b6b552e20d17241bab44da0060c6553e5d11ef0626cc1","39454b29b5cdda0a7d7810e4903434cb3da76dd9ea54485082a38c9226834547","e8ed55a4df80c2f8170a4c9338f5e10cc2f7dcf6a71e555f66df46d5135d6fbb","227a5ea6e909e30eab6faf9c98885570f6cb79e143f61ca86afcc79f206c098f","47e5ff2662d95fdf44b95604f98202426566a8200a02d3cb3aa18d14ea3302b9","df7970407b8eca92786ae38ae4bf7ba72f93ed52f88d4648a9faebf4b175557e","ff30938b528c5e8efa292a75c5465150186458262b2a5eca26428da384fc58e3","03d4abf23341798b4b50fb8c8db34da313cb4ba24e126ea4d75594280207fc59","c2b3c2274081a3aa9ecdc4087de332731e77f7e7a7d6f61b5d7d0c3c084f6d24","40fe69727158c8ef3ecc53555f8f411dd078916f4f7b1f99c67c3a9633c11b65","c2c551ee43f0d060c3a6e0968d452ca327325e24831f7d70a4c41cb9dc2b47a3","fa3a1963864e84273b0b72c70715e4a102860fa53010687c99edf7bec21e4156","02923c6af1e7ece3b947dc66fc537dd4a30793288ceae521dbebea35a1d8d473","7ed949e667a50b8e3292253413eebce0e52ce39d2027fd9460a521ace281aff7","d40a4ffcea55eb2cb91c11151296598b891e82dc2e1a7475527950397183f398","ec801710547c3639c886fd2d80086c0ed54bb5ea6bd047fd6c8ddbddfc67d142","1bdd36a22d5e3c40fd527e0f343ac1c585d72f79f500c9b756f219d1205b5697","a55a02727a055285952f98468b4572397c7cd4944bb3d9e5a84a91d6f1490af1","e2482e46d013fc372f369b8d8c7211b4fffe3b8af80eb82c4f0559b8e96b681c","a3153a5699abfe3bca16900a89c29421a4d05ff3e74ffe58bf8aec3ab987e365","ea18a86e7f62c685ef5f6737f81d2242fa19984cc64145b4eb3b208bb0e6733d","6a72ba85656d4af445fa3a71f2cd6477ec784762a513834059e4feeeec944ad0","11c59a159e72982a49f4ad047a1f7dac4aee8d2e504cdddf0cb48745fbd15116","a0398022e17543d4f6d71960f1a126a2b69d0d054ab46e2f72e54d4c62bf0ad4"],"paragraph_range_zero_based":[16896,16919],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p16896"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ccs-BlindDetectionSplit","paragraph_zero_based":16920},{"literal_text_all_w_t_and_m_t":"Indicates the share of blind detection candidates and non-overlapping CCEs for PDCCH monitoring on an SpCell and an SCell when cross-carrier scheduling is configured from the SCell for the SpCell (see TS 38.213 [13], clause 10.1.1). The network only configures this field when it sets the field other for an SpCell, i.e., when it configures cross-carrier scheduling of the SpCell by a PDCCH on an Scell.","paragraph_zero_based":16921},{"literal_text_all_w_t_and_m_t":"cif-Presence","paragraph_zero_based":16922},{"literal_text_all_w_t_and_m_t":"The field is used to indicate whether carrier indicator field is present (value true) or not (value false) in PDCCH DCI formats, see TS 38.213 [13]. If cif-Presence is set to true, the CIF value indicating a grant or assignment for this cell is 0.","paragraph_zero_based":16923},{"literal_text_all_w_t_and_m_t":"cif-InSchedulingCell","paragraph_zero_based":16924},{"literal_text_all_w_t_and_m_t":"The field indicates the CIF value used in the scheduling cell to indicate a grant or assignment applicable for this cell, see TS 38.213 [13]. If configured for an SpCell, the non-fallback DCI formats on the SpCell include same number of CIF bits as the corresponding non-fallback DCI formats on the scheduling cell, and the CIF bits are considered reserved.","paragraph_zero_based":16925},{"literal_text_all_w_t_and_m_t":"enableDefaultBeamForCCS","paragraph_zero_based":16926},{"literal_text_all_w_t_and_m_t":"This field indicates whether default beam selection for cross-carrier scheduled PDSCH is enabled, see TS 38.214 [19]. If not present, the default beam selection behaviour is not applied, i.e. Rel-15 behaviour is applied. This field can only be configured in the cross-scheduled SCell or SpCell.","paragraph_zero_based":16927},{"literal_text_all_w_t_and_m_t":"other","paragraph_zero_based":16928},{"literal_text_all_w_t_and_m_t":"Parameters for cross-carrier scheduling. If configured for an SpCell, the SpCell can be scheduled by the PDCCH on another SCell as well as by the PDCCH on the SpCell. If configured for an SCell, the SCell is scheduled by a PDDCH on another cell.","paragraph_zero_based":16929},{"literal_text_all_w_t_and_m_t":"own","paragraph_zero_based":16930},{"literal_text_all_w_t_and_m_t":"Parameters for self-scheduling, i.e., a serving cell is scheduled by its own PDCCH.","paragraph_zero_based":16931},{"literal_text_all_w_t_and_m_t":"schedulingCellId","paragraph_zero_based":16932},{"literal_text_all_w_t_and_m_t":"If configured for an SpCell, this field indicates which SCell, in addition to the SpCell, signals the downlink allocations and uplink grants, if applicable, for the concerned SpCell. If configured for an Scell, this field indicates which cell signals the downlink allocations and uplink grants, if applicable, for the concerned SCell. In case the UE is configured with DC, the scheduling cell is part of the same cell group (i.e. MCG or SCG) as the scheduled cell. In case the UE is configured with two PUCCH groups, the scheduling cell and the scheduled cell are within the same PUCCH group. If drx-ConfigSecondaryGroup is configured in the MAC-CellGroupConfig associated with this serving cell, the scheduling cell and the scheduled cell belong to the same Frequency Range. In addition, the serving cell with an aperiodic CSI trigger and the PUSCH resource scheduled for the report are on the same carrier and serving cell, but the cell for which CSI is reported may belong to the same or a different Frequency Range. The network should not trigger a CSI request for a serving cell in the other Frequency Range when that serving cell is outside Active Time.","paragraph_zero_based":16933},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16934},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":16935},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":16936},{"literal_text_all_w_t_and_m_t":"CIF-PRESENCE","paragraph_zero_based":16937},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the cif-Presence is set to true. The field is absent otherwise.","paragraph_zero_based":16938},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16939},{"literal_text_all_w_t_and_m_t":"–CSI-AperiodicTriggerStateList","paragraph_zero_based":16940},{"literal_text_all_w_t_and_m_t":"The CSI-AperiodicTriggerStateList IE is used to configure the UE with a list of aperiodic trigger states. Each codepoint of the DCI field \"CSI request\" is associated with one trigger state (see TS 38.321 [3], clause 6.1.3.13). Upon reception of the value associated with a trigger state, the UE will perform measurement of CSI-RS, CSI-IM and/or SSB (reference signals) and aperiodic reporting on L1 according to all entries in the associatedReportConfigInfoList for that trigger state.","paragraph_zero_based":16941},{"literal_text_all_w_t_and_m_t":"CSI-AperiodicTriggerStateList information element","paragraph_zero_based":16942},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":16943}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["dbc12e6cf8205fb42d9dc659549c918f8a0b8a786bfcbfc2727e25b21489cc3e","1f63e4e54c7ff2ed22ae0bd70f95f3bc57b27d5cbe4a33040b1564e090152342","2c6bac1e51cc9c604d06a9bb6cf218fe32fa7ba631e46525d859b72120b4888d","1764acefdae44c2efa818ef7d11391bfbe78f56e795a7ccec91d9d1dd882d7cd","2b1bda3d97bedd1820c41fbe3370890e8f361aba33a0ece38