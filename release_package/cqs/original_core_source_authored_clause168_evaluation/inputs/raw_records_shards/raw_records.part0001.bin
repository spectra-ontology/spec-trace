          OPTIONAL    -- Need R","paragraph_zero_based":21829},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21830},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21831},{"literal_text_all_w_t_and_m_t":"CellGroupForSwitch-r16 ::=          SEQUENCE(SIZE (1..16)) OF ServCellIndex","paragraph_zero_based":21832},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21833},{"literal_text_all_w_t_and_m_t":"SCS-SpecificDuration-r17   ::=      INTEGER (1..166)","paragraph_zero_based":21834},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21835},{"literal_text_all_w_t_and_m_t":"-- TAG-PDCCH-CONFIG-STOP","paragraph_zero_based":21836},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21837},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21838},{"literal_text_all_w_t_and_m_t":"PDCCH-Config field descriptions","paragraph_zero_based":21839}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["95b4c9b756f3bf51b168d483dd86b74548aae27e63596b88a8716c52d96ac7b2","93f94160540075014b2f7eb7354ed1c23977d4f1bb468314b0e355b1a22e2b10","58cfc20d30398e899f340661f87d6b4d73ea7c6b0f3d8f9f64bb1e1fbb888c57","e8176b087e83ef3b0e6bc99e801679d08d904efb5dc08f9421eeda3ad548d150","7684b7d2ad693ff747f77b339630dbca769baaaecebeadaad9aaad7911f389d9","d3bd5966242d8bfd393e85dbbe4fa47bc7d5b77fb196168d49b2b48fbf7dc599","5b5e107f3310568bc5f6552a877ddd5c4541b965369d86c691f3db7d19b50caa","176560eae67cd02779e4a3912bfe2e169231a8d7b7b07372d8aa87d6bfdb6503","0b1a1dc031fd4fbb5af25dd222e7745a4fd6cb084a3cb1a3a8a5831654f249e4","cd1b6ec66bc2c345ea826fc5711f60251fad9c8f4f11caa35f3382f3168a02f5","a230209e30b447ed2359567f7f46e996435d4f420df559f593ff36d189ec9a91","a7e1322bbcdba7b215d0653f70ca72a6efdcf8408f9363e99b76603065767a59","679911cf8439c7716ca51d497693285032200566436a6ddaece6a3dd9b8fbab0","a9c49c24d467dc32ece5f2c891461cae11a1c1ddaae99d04f9b301eee4e0be72","7669802c140ce2efb0c54aa00351e7bbe97033d331f63510dcc9c4cfde0eb8bf","68d6ae9d388ab6665a94f3e86a5086dd5acd22333644af5a2ca8f57673a5cf85","ce262595e06074a5261321c5d1ac983d06d4642247206074e54828e9a9692401","e2212760ce4a8e4b6010603bcf15882f65e5b5c7666c70d28a17cd03c531e7f2","c124d2a9ea2fcaf50b366457b77befcd77fbe6c58a5777902c12917d11e9153f","a6d9b12f970d39bbe78d704a24cc02f4ef2f9192d60ca2315149629211b78fb6","8c8936d69979ff96d03c738f4bf4e336e3c1ba59671d5b1de92183bae6b8e484","1c595c1630f47cb9fc6e9de4499d628937ade0a010f5db85377e7b53d6c3d02a","f97313cb8d02cc1d38ff423bc5576b9d2aa0515bfcd7615d36aa1db911980030","7f8a76de353c925533a78d313d2905add2eae7a58aae6e56d3e6777ffbc6020e"],"paragraph_range_zero_based":[21816,21839],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p21816"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"controlResourceSetToAddModList, controlResourceSetToAddModListSizeExt","paragraph_zero_based":21840},{"literal_text_all_w_t_and_m_t":"List of UE specifically configured Control Resource Sets (CORESETs) to be used by the UE. The network restrictions on configuration of CORESETs per DL BWP are specified in TS 38.213 [13], clause 10.1 and TS 38.306 [26]. The UE shall consider entries in controlResourceSetToAddModList and in controlResourceSetToAddModListSizeExt as a single list, i.e. an entry created using controlResourceSetToAddModList can be modified using controlResourceSetToAddModListSizeExt (or deleted using controlResourceSetToReleaseListSizeExt) and vice-versa. In case network reconfigures control resource set with the same ControlResourceSetId as used for commonControlResourceSet or commonControlResourceSetExt configured via PDCCH-ConfigCommon or via SIB20, the configuration from PDCCH-Config always takes precedence and should not be updated by the UE based on servingCellConfigCommon or based on SIB20.","paragraph_zero_based":21841},{"literal_text_all_w_t_and_m_t":"controlResourceSetToReleaseList, controlResourceSetToReleaseListSizeExt","paragraph_zero_based":21842},{"literal_text_all_w_t_and_m_t":"List of UE specifically configured Control Resource Sets (CORESETs) to be released by the UE. This field only applies to CORESETs configured by controlResourceSetToAddModList or controlResourceSetToAddModListSizeExt and does not release the field commonControlResourceSet configured by PDCCH-ConfigCommon and commonControlResourceSetExt configured by SIB20.","paragraph_zero_based":21843},{"literal_text_all_w_t_and_m_t":"downlinkPreemption","paragraph_zero_based":21844},{"literal_text_all_w_t_and_m_t":"Configuration of downlink preemption indications to be monitored in this cell (see TS 38.213 [13], clause 11.2).","paragraph_zero_based":21845},{"literal_text_all_w_t_and_m_t":"monitoringCapabilityConfig","paragraph_zero_based":21846},{"literal_text_all_w_t_and_m_t":"Configures either Rel-15 PDCCH monitoring capability, Rel-16 PDCCH monitoring capability or Rel-17 PDCCH monitoring capability for PDCCH monitoring on a serving cell (see TS 38.213 [13], clause 10.1). Value r15monitoringcapability enables the Rel-15 monitoring capability, and value r16monitoringcapability enables the Rel-16 PDCCH monitoring capability. r17monitoringcapability enables the Rel-17 PDCCH multi-slot monitoring capability. For 480 and 960 kHz SCS, only value r17monitoringcapability is applicable.","paragraph_zero_based":21847},{"literal_text_all_w_t_and_m_t":"pdcch-SkippingDurationList","paragraph_zero_based":21848},{"literal_text_all_w_t_and_m_t":"Provides one or more values to derive the skipping duration in unit of slots, as specified in TS 38.213 [13], clause 10.4. The DCI which schedules data indicates which of the values is to be applied (see TS 38.213 [13], clause 10.4). For the 15kHz SCS, for each entry, only the first 26 values are valid and correspond to {1, 2, 3, …, 20, 30, 40, 50, 60, 80, 100}. For the 30kHz SCS, for each entry, only the first 46 values are valid and correspond to {1, 2, 3, …, 40, 60, 80, 100, 120, 160, 200}. For the 60kHz SCS, for each entry, only the first 86 values are valid and correspond to {1, 2, 3, …, 80, 120, 160, 200, 240, 320, 400}. For the 120kHz SCS, for each entry, the 166 values correspond to {1, 2, 3, …, 160, 240, 320, 400, 480, 640, 800}. For the 480kHz SCS, for each entry, the 166 values correspond to {4, 8, 12, …, 640, 960, 1280, 1600, 1920, 2560, 3200}. For the 960kHz SCS, for each entry, the 166 values correspond to {8, 16, 24, …, 1280, 1920, 2560, 3200, 3840, 5120, 6400}.","paragraph_zero_based":21849},{"literal_text_all_w_t_and_m_t":"searchSpacesToAddModList, searchSpacesToAddModListExt","paragraph_zero_based":21850},{"literal_text_all_w_t_and_m_t":"List of UE specifically configured Search Spaces or MBS multicast Search Spaces. The network configures at most 10 Search Spaces per BWP per cell (including UE-specific and common Search Spaces). If the network includes searchSpacesToAddModListExt, it includes the same number of entries, and listed in the same order, as in searchSpacesToAddModList in each of them.","paragraph_zero_based":21851},{"literal_text_all_w_t_and_m_t":"searchSpaceSwitchConfig","paragraph_zero_based":21852},{"literal_text_all_w_t_and_m_t":"Configuration to control the UE behavior to switch from search space group X back to search space group 0, as specified in clause 10 of TS 38.213 [13]. The network only configures either searchSpaceSwitchConfig-r16 or searchSpaceSwitchConfig-r17 for a UE.","paragraph_zero_based":21853},{"literal_text_all_w_t_and_m_t":"tpc-PUCCH","paragraph_zero_based":21854},{"literal_text_all_w_t_and_m_t":"Enable and configure reception of group TPC commands for PUCCH.","paragraph_zero_based":21855},{"literal_text_all_w_t_and_m_t":"tpc-PUSCH","paragraph_zero_based":21856},{"literal_text_all_w_t_and_m_t":"Enable and configure reception of group TPC commands for PUSCH.","paragraph_zero_based":21857},{"literal_text_all_w_t_and_m_t":"tpc-SRS","paragraph_zero_based":21858},{"literal_text_all_w_t_and_m_t":"Enable and configure reception of group TPC commands for SRS.","paragraph_zero_based":21859},{"literal_text_all_w_t_and_m_t":"uplinkCancellation","paragraph_zero_based":21860},{"literal_text_all_w_t_and_m_t":"Configuration of uplink cancellation indications to be monitored in this cell (see TS 38.213 [13], clause 11.2A).","paragraph_zero_based":21861},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21862},{"literal_text_all_w_t_and_m_t":"SearchSpaceSwitchConfig field descriptions","paragraph_zero_based":21863}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["187ec6cfa1bbd6294be169c61cf30c721a85cb887cfd8d44db70cd12c3e252d9","202013557afe5b77b7b7aa1e2d2c8a4c260311f5cd38e1ba1e71a0ea6f405206","50e863bf4fbc9b3521339a04a407b1e3f590e5ce26be5c26ec8aa407ac6c1141","c3bae64c819e01a1595c1d5ddd15786ee8a5bf2dfe4b298e885a093f3d5c0a1b","230bd5a33272eec38b10c0783076064014eba422fba05346c3aa71b07054e72d","4fc004ee3052f23a692998b4a7dd2c63ac1acb07c49b0184a3b9c4cfdbbd08b9","0ca4165228a820972c2ef4182e4ecd5fa3fd5a78066797f21d8b9d4c40fec94c","e161f164fbf6fffb2d4ffca2631991e820d3a50a3af15b22e7b889dbc91fcf9c","658cc0443c29e545e3ad8374905c073c47af6b53d05e79a7b2584462887d0e7b","81c3d48761a88faf236aa048498a52f1fa402fbb255d7c5fc094c2e5ebf98d79","941760a6825a767b6939837543a94c8eafa164cc93406a22a9b79ad8ca93660c","0238997ef63eb7d4c2fb3a717eeb02a6ca6d74eb14919e1534fd53f5105c90ea","48a6039f547dffbb724f370c340a76e5451f9f6820cf13efb51eec1443a0e7ab","8625341a042d65bd9021e50484fc099926102502c922573e4ca1c2151f74d1ba","75759b1dc12087d09ada86dbced02e211b45118c8bdbaaa2ca9ee13e463ab2fb","4ba1436e0c3203e290e3d14bf9645c594ed6d01e9293d4734a781c9b344df4e6","0bda39fa6731f047ab97af91fdd91b0caaffad1e74425c12bbc424e140503a65","6b35c5b3e765154c5e0a191c9dd2d3cb88fc3048bcf546b68bad608abcfb7fe7","d6d46d5f396070f5ea8fc432a6df5dca13e7fc8829e5f942369202af26b3a0d5","af58dbf452cffc3b034767295643b6ddbd17bbe7fe2085aca6a3f00ec2a03657","590a4f99aaa9b972216684990b227deddc46b36dfafba8da95c7fa998e4e39c5","3549494b7433b90c4e95c389330b64157e1b27c649103f89aa08d5ba218cb56d","9de9968e765b9f54799ee517bf18bd9c95064dd65117f5b5074e7faf840eadab","cf61aa0ecfaaa3ef0c51277a2cc994d8a321c18b337762c218989df4b70560ad"],"paragraph_range_zero_based":[21840,21863],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p21840"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"cellGroupsForSwitchList","paragraph_zero_based":21864},{"literal_text_all_w_t_and_m_t":"The list of serving cells which are bundled for the search space group switching purpose (see TS 38.213 [13], clause 10.4). A serving cell can belong to only one CellGroupForSwitch. The network configures the same list for all BWPs of serving cells in the same CellGroupForSwitch.","paragraph_zero_based":21865},{"literal_text_all_w_t_and_m_t":"searchSpaceSwitchDelay","paragraph_zero_based":21866},{"literal_text_all_w_t_and_m_t":"Indicates the value to be applied by a UE for Search Space Set Group switching; corresponds to the P value in TS 38.213 [13], clause 10.4. The network configures the same value for all BWPs of serving cells in the same CellGroupForSwitch. For 120/480/960 kHz SCS, only values 40,41, ... 52 are valid and the actual value = field value  * SCS/120 kHz i.e. field value 40 corresponds to 40 with 120 kHz SCS, 160 with 480 kHz SCS and 320 with 960 kHz SCS, and so on.","paragraph_zero_based":21867},{"literal_text_all_w_t_and_m_t":"searchSpaceSwitchTimer","paragraph_zero_based":21868},{"literal_text_all_w_t_and_m_t":"Timer (in unit of slots) to control the UE behavior to switch from search space group X back to search space group 0, as specified in clause 10 of TS 38.213 [13]. For the 15kHz SCS, only the first 26 values are valid and correspond to {1, 2, 3, …, 20, 30, 40, 50, 60, 80, 100}. For the 30kHz SCS, only the first 46 values are valid and correspond to {1, 2, 3, …, 40, 60, 80, 100, 120, 160, 200}. For the 60kHz SCS, only the first 86 values are valid and correspond to {1, 2, 3, …, 80, 120, 160, 200, 240, 320, 400}. For the 120kHz SCS, the 166 values correspond to {1, 2, 3, …, 160, 240, 320, 400, 480, 640, 800}. For the 480kHz SCS, the 166 values correspond to {4, 8, 12, …, 640, 960, 1280, 1600, 1920, 2560, 3200}. For the 960kHz SCS, the 166 values correspond to {8, 16, 24, …, 1280, 1920, 2560, 3200, 3840, 5120, 6400}.","paragraph_zero_based":21869},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21870},{"literal_text_all_w_t_and_m_t":"–PDCCH-ConfigCommon","paragraph_zero_based":21871},{"literal_text_all_w_t_and_m_t":"The IE PDCCH-ConfigCommon is used to configure cell specific PDCCH parameters provided in SIB as well as in dedicated signalling.","paragraph_zero_based":21872},{"literal_text_all_w_t_and_m_t":"PDCCH-ConfigCommon information element","paragraph_zero_based":21873},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21874},{"literal_text_all_w_t_and_m_t":"-- TAG-PDCCH-CONFIGCOMMON-START","paragraph_zero_based":21875},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21876},{"literal_text_all_w_t_and_m_t":"PDCCH-ConfigCommon ::=              SEQUENCE {","paragraph_zero_based":21877},{"literal_text_all_w_t_and_m_t":"    controlResourceSetZero              ControlResourceSetZero                                  OPTIONAL,   -- Cond InitialBWP-Only","paragraph_zero_based":21878},{"literal_text_all_w_t_and_m_t":"    commonControlResourceSet            ControlResourceSet                                      OPTIONAL,   -- Need R","paragraph_zero_based":21879},{"literal_text_all_w_t_and_m_t":"    searchSpaceZero                     SearchSpaceZero                                         OPTIONAL,   -- Cond InitialBWP-Only","paragraph_zero_based":21880},{"literal_text_all_w_t_and_m_t":"    commonSearchSpaceList               SEQUENCE (SIZE(1..4)) OF SearchSpace                    OPTIONAL,   -- Need R","paragraph_zero_based":21881},{"literal_text_all_w_t_and_m_t":"    searchSpaceSIB1                     SearchSpaceId                                           OPTIONAL,   -- Need S","paragraph_zero_based":21882},{"literal_text_all_w_t_and_m_t":"    searchSpaceOtherSystemInformation   SearchSpaceId                                           OPTIONAL,   -- Need S","paragraph_zero_based":21883},{"literal_text_all_w_t_and_m_t":"    pagingSearchSpace                   SearchSpaceId                                           OPTIONAL,   -- Need S","paragraph_zero_based":21884},{"literal_text_all_w_t_and_m_t":"    ra-SearchSpace                      SearchSpaceId                                           OPTIONAL,   -- Need S","paragraph_zero_based":21885},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":21886},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":21887}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["49612f69a07261ea64f52b828d7ae788f3da0d4e6f2d7239caf0de6cce3325c2","7eb327417cb8c609af4f415164d68e294847bf3e94d9af8ad094406bc9cd7ed8","61d724891e322af26e3d95f7cab5b90a1e5820b2ef63e28999be5b21fa37e4dd","963704475d99b82bd4ea5ef8714c87273c06530ff2b7b67fcc55ff649bf2c8e9","5b1d487ce0cfe46233deaf7f345082456a0428d1bfba40e9fc48ae10f2c6b11c","64e4a560e591b7864542bad9def766900655f95a4c23e614d8cfae09879636b5","1b61224ba4c0ce8c124f21e6a4a1a9e1cfe6377801f633d0e57921a632b36595","745a84be39cda3300565705e52aaafa75625b5dcffe104e246503f607623c89f","5e0264d46ff9d6ae0bfa90e305501ab44b239b735ba842953d14c4d2b298c139","6a31f2d218d602367a951d165c003ad85acc040b07461a501b0eeb2b7575f554","b5ded38472934d7785a1571444407b414c235de71e14d356ae68cee7944c3338","2b97620a2ee8f65c2981c722c4fb4ee253179d8af5d1c87b311447af36286cc4","f98eb4aeb657bedc2041946767bd47d74fb0c97e11b640bb16eacb25c97c01be","a7f43814597c40821926d1de533b33394a1e7e30b59e6fc38992d6a5de85faea","e181b925d5367a87e8f829a2e35f7271f5edae570992dbd4351e66604ca49243","c77dea9753327df9eb48e7a