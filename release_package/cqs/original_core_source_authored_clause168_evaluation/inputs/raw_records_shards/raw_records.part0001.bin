{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"repetitionNumber","paragraph_zero_based":22920},{"literal_text_all_w_t_and_m_t":"Indicates the number of PDSCH transmission occasions for slot-based repetition scheme in IE RepetitionSchemeConfig. The parameter is used as specified in 38.214 [19].","paragraph_zero_based":22921},{"literal_text_all_w_t_and_m_t":"startSymbolAndLength","paragraph_zero_based":22922},{"literal_text_all_w_t_and_m_t":"An index giving valid combinations of start symbol and length (jointly encoded) as start and length indicator (SLIV). The network configures the field so that the allocation does not cross the slot boundary (see TS 38.214 [19], clause 5.1.2.1).","paragraph_zero_based":22923},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22924},{"literal_text_all_w_t_and_m_t":"MultiPDSCH-TimeDomainResourceAllocation field descriptions","paragraph_zero_based":22925},{"literal_text_all_w_t_and_m_t":"pdsch-TDRA-List","paragraph_zero_based":22926},{"literal_text_all_w_t_and_m_t":"One or multiple PDSCHs which can be in consecutive or non-consecutive slots (see TS 38.214 [19], clause 5.1.2.1). ","paragraph_zero_based":22927},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22928},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":22929},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":22930},{"literal_text_all_w_t_and_m_t":"Format1-2","paragraph_zero_based":22931},{"literal_text_all_w_t_and_m_t":"In pdsch-TimeDomainAllocationListDCI-1-2, this field is optionally present, Need R. It is absent, Need R, otherwise.","paragraph_zero_based":22932},{"literal_text_all_w_t_and_m_t":"Formats1-0_1-1_4-0_4-1_4-2","paragraph_zero_based":22933},{"literal_text_all_w_t_and_m_t":"In pdsch-TimeDomainAllocationListDCI-1-2, pdsch-TimeDomainAllocationListForMultiPDSCH, and SIB20, this field is absent.","paragraph_zero_based":22934},{"literal_text_all_w_t_and_m_t":"Otherwise, in pdsch-TimeDomainResourceAllocationList-r16, this field is optionally present, Need R.","paragraph_zero_based":22935},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22936},{"literal_text_all_w_t_and_m_t":"–PHR-Config","paragraph_zero_based":22937},{"literal_text_all_w_t_and_m_t":"The IE PHR-Config is used to configure parameters for power headroom reporting.","paragraph_zero_based":22938},{"literal_text_all_w_t_and_m_t":"PHR-Config information element","paragraph_zero_based":22939},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":22940},{"literal_text_all_w_t_and_m_t":"-- TAG-PHR-CONFIG-START","paragraph_zero_based":22941},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22942},{"literal_text_all_w_t_and_m_t":"PHR-Config ::=                      SEQUENCE {","paragraph_zero_based":22943}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["4303665302e44b0c5b67c91573d45bc69d7e1e14127fea9f69fbb75d531b9c79","a3f32c6d3be83d47330a3e69a4631175220e1ec2cd6f22764e4d999f29e16849","6ea2c8db99392a7667a2dffd096ebee4d93c8ac65beb33081842ad1ac0627f41","4b448b6c491d7edf741716ed5e7b9a12f9400dbd2cce614f433384205aa59d86","3e03a03452d9abeaccf9ef831398d319a5b4277874f6d23d9a6790ef9e1258ca","2a82706f891255c69bbef28bef36f49c93c83dd80b676ededc55123e4c2e4e8c","5ea4eb21b091065b71df9533acacb7de3c986509248311982062ce067de80d3d","9637c5b094321525d6e9518f902742c615ff79a640abed622579993b9cbeedad","897c478b7068f790f6d7e177aa139205b7ecbd9380db69f5c42317b802cd90fb","98feb0fd12d0d6b205cbd337290299d461aaa31e53bed2e716de7fde0f4e075b","254dd6892f710ea711b58