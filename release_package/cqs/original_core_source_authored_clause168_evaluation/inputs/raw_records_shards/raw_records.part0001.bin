set in number of subframes for the periodic MUSIM gap as specified in TS 38.133 [14] clause 9.1.10. This field is mandatory present for the periodic MUSIM gap preference indication.","paragraph_zero_based":21209},{"literal_text_all_w_t_and_m_t":"musim-Starting-SFN-AndSubframe","paragraph_zero_based":21210},{"literal_text_all_w_t_and_m_t":"Indicates gap starting position for the aperiodic MUSIM gap. This field is optionally present for the aperiodic MUSIM gap preference indication.","paragraph_zero_based":21211},{"literal_text_all_w_t_and_m_t":"starting-SFN","paragraph_zero_based":21212},{"literal_text_all_w_t_and_m_t":"Indicates gap starting SFN number for the aperiodic MUSIM gap.","paragraph_zero_based":21213},{"literal_text_all_w_t_and_m_t":"startingSubframe","paragraph_zero_based":21214},{"literal_text_all_w_t_and_m_t":"Indicates gap starting subframe number for the aperiodic MUSIM gap.","paragraph_zero_based":21215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["6d50dac7c455c86a59fd925dad0b1610774c6af1264a402a377ce744ac97ba87","021145fb8c4e1deb932e450b2645b22745a9c5aec8a14cd3daaa050c47f33c60","4055f2fd4a78fca4bd71846ef64b05affd0ab325c4af779fe42b94a7237ab123","86e47c2052ebc9a9b1518d46d35aab92100ccbe7802d41fbfeac7372dabd19eb","4fe43a98dda2c2b25243ae8761ff5712aef0c6134ca6689ce9e55190e86ed632","ede4cf7bcea5009987975e0d37fe0bd4cde48c85977c5ab2f124c17b8e95f4a7","3e1cb59a56284795e8dcfecd6082662368922fe7e0a1b0aa8d36cf8f12002936","94a2224f181ddc33681bde1540418296ed8996d78cad21a471c49b821696cda4","e49d757508e21727982ff1ee8b3c6e8c126008041d6216f7a65a48fc59e9c6d5","f9174510e23abd265d44b73b73fc3d7c77b6056e3eb77b3f9625f1654af602ff","87c1ad4b534706a64ee93710deb5cfb25d9da21319