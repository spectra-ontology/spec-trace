{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SL-PHY-MAC-RLC-Config-v1700 ::=      SEQUENCE {","paragraph_zero_based":37776},{"literal_text_all_w_t_and_m_t":"    sl-DRX-Config-r17                    SL-DRX-Config-r17                                                      OPTIONAL,    -- Need M","paragraph_zero_based":37777},{"literal_text_all_w_t_and_m_t":"    sl-RLC-ChannelToReleaseList-r17      SEQUENCE (SIZE (1..maxSL-LCID-r16)) OF SL-RLC-ChannelID-r17            OPTIONAL, -- Cond L2U2N","paragraph_zero_based":37778},{"literal_text_all_w_t_and_m_t":"    sl-RLC-ChannelToAddModList-r17       SEQUENCE (SIZE (1..maxSL-LCID-r16)) OF SL-RLC-ChannelConfig-r17        OPTIONAL, -- Cond L2U2N","paragraph_zero_based":37779},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":37780},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37781},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37782},{"literal_text_all_w_t_and_m_t":"SL-DiscConfig-r17::=                 SEQUENCE {","paragraph_zero_based":37783},{"literal_text_all_w_t_and_m_t":"    sl-RelayUE-Config-r17                SetupRelease { SL-RelayUE-Config-r17}                                  OPTIONAL, -- Cond L2RelayUE","paragraph_zero_based":37784},{"literal_text_all_w_t_and_m_t":"    sl-RemoteUE-Config-r17               SetupRelease { SL-RemoteUE-Config-r17}                                 OPTIONAL  -- Cond L2RemoteUE","paragraph_zero_based":37785},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37786},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37787},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-CONFIGDEDICATEDNR-STOP","paragraph_zero_based":37788},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":37789},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37790},{"literal_text_all_w_t_and_m_t":"SL-ConfigDedicatedNR field descriptions","paragraph_zero_based":37791},{"literal_text_all_w_t_and_m_t":"sl-MeasConfigInfoToAddModList","paragraph_zero_based":37792},{"literal_text_all_w_t_and_m_t":"This field indicates the RSRP measurement configurations for unicast destinations to add and/or modify.","paragraph_zero_based":37793},{"literal_text_all_w_t_and_m_t":"sl-MeasConfigInfoToReleaseList","paragraph_zero_based":37794},{"literal_text_all_w_t_and_m_t":"This field indicates the RSRP measurement configurations for unicast destinations to remove.","paragraph_zero_based":37795},{"literal_text_all_w_t_and_m_t":"sl-PHY-MAC-RLC-Config","paragraph_zero_based":37796},{"literal_text_all_w_t_and_m_t":"This field indicates the lower layer sidelink radio bearer configurations.","paragraph_zero_based":37797},{"literal_text_all_w_t_and_m_t":"sl-RadioBearerToAddModList","paragraph_zero_based":37798},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple sidelink radio bearer configurations to add and/or modify. This field is not configured to the PC5 connection used for L2 U2N relay operation.","paragraph_zero_based":37799}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["74f3bdb9b8fe464d82f787eb113d3256eac6b16ba11bab63f91dac39f95a1852","76263f8c42d14c1811a99d126e5f6142754cb6ea2eca0ba129d3a5be783904cd","f48df7548c9e2a3e161beaec5272d9d220b56fcee99af62269287a758cb9b63b","da211f5571bdb789aabfc4b04349141808a1ca5b247dc06fcf5e57788d6852ff","527e3de8180311d750dc14587c00440d5e5b8d28b3bce347652586573f895a54","2d0a69c9cd99ea9050efb570bf09072aba0c8b93aaf34d17d1884a632b77e3ed","bfd0583d181b2a878ce2dba15efd77795ce6d9ae4efaa862ebae46984e6c09bb","5fbd258ca22cab1a944a71187a41f760cc