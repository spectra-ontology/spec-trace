{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SFN mod T = FLOOR(gapOffset/10);","paragraph_zero_based":4488},{"literal_text_all_w_t_and_m_t":"subframe = gapOffset mod 10;","paragraph_zero_based":4489},{"literal_text_all_w_t_and_m_t":"with T = MGRP/10 as defined in TS 38.133 [14];","paragraph_zero_based":4490},{"literal_text_all_w_t_and_m_t":"2>apply the specified timing advance mgta to the gap occurrences calculated above (i.e. the UE starts the measurement mgta ms before the gap subframe occurrences);","paragraph_zero_based":4491},{"literal_text_all_w_t_and_m_t":"1>else if gapUE is set to release:","paragraph_zero_based":4492},{"literal_text_all_w_t_and_m_t":"2>release the per UE measurement gap configuration configured by gapUE.","paragraph_zero_based":4493},{"literal_text_all_w_t_and_m_t":"1>for each measGapId included in the received gapToReleaseList:","paragraph_zero_based":4494},{"literal_text_all_w_t_and_m_t":"2>release the measurement gap configuration associated with the measGapId;","paragraph_zero_based":4495},{"literal_text_all_w_t_and_m_t":"1>for each measPosPreConfigGapId included in the received posMeasGapPreConfigToReleaseList:","paragraph_zero_based":4496},{"literal_text_all_w_t_and_m_t":"2>release the measurement gap configuration associated with the measPosPreConfigGapId;","paragraph_zero_based":4497},{"literal_text_all_w_t_and_m_t":"1>for each GapConfig received in gapToAddModList:","paragraph_zero_based":4498},{"literal_text_all_w_t_and_m_t":"2>setup measurement gap configuration indicated by the GapConfig in accordance with the received gapOffset, i.e., the first subframe of each gap occurs at an SFN and subframe meeting the following condition:","paragraph_zero_based":4499},{"literal_text_all_w_t_and_m_t":"SFN mod T = FLOOR(gapOffset/10);","paragraph_zero_based":4500},{"literal_text_all_w_t_and_m_t":"subframe = gapOffset mod 10;","paragraph_zero_based":4501},{"literal_text_all_w_t_and_m_t":"with T = MGRP/10 as defined in TS 38.133 [14];","paragraph_zero_based":4502},{"literal_text_all_w_t_and_m_t":"2>apply the specified timing advance mgta to the gap occurrences calculated above (i.e. the UE starts the measurement mgta ms before the gap subframe occurrences);","paragraph_zero_based":4503},{"literal_text_all_w_t_and_m_t":"2>apply the measurement gap as per UE measurement gap, FR1 measurement gap, or FR2 measurement gap according to the gapType indicated by the GapConfig;","paragraph_zero_based":4504},{"literal_text_all_w_t_and_m_t":"2>associate the measurement gap with the measGapId indicated by the GapConfig;","paragraph_zero_based":4505},{"literal_text_all_w_t_and_m_t":"2>if gapSharing in the GapConfig is present:","paragraph_zero_based":4506},{"literal_text_all_w_t_and_m_t":"3>setup the gap sharing configuration for the measurement gap in accordance with the received gapSharing as defined in TS 38.133 [14];","paragraph_zero_based":4507},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":4508},{"literal_text_all_w_t_and_m_t":"3>release the gap sharing configuration (if configured) for the measurement gap;","paragraph_zero_based":4509},{"literal_text_all_w_t_and_m_t":"1>for each PosGapConfig received in PosMeasGapPreConfigToAddModList:","paragraph_zero_based":4510},{"literal_text_all_w_t_and_m_t":"2>if a measurement gap configuration associated with the measPosPreConfigGapId indicated by the PosGapConfig is already setup:","paragraph_zero_based":4511}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["e6bed38117f88d069cc363a7a950f5aba3379146ef3dad7fa6a1609456f4abed","e6300bc2b92ac3d2f28c6f44d1b95a2d20c608a0c179cf1c06fe56d332dabccf","3a725cd996b70f8cc57333bb93edc56850ee10e41666c6cc1b89bebdef90c61d","a396c8a8e1f287a155b7a92758c73912ba1d91699bd8788ac939508a0527188d","76ffd21b5cd5073943462a4d97938c3bb08ca713eff868113d2fb347e5ebfa17","b5a10dd9436f1e86c7f06a50f33b300c7a2a1c4c78b3daed6b48c3474ca344b0","de5da4b60d14ac796bd411a234b77d95da2abd49398e5812c3afa56e0f6d2a6d","b817aa41875dc8797245e28037d8e760c375a65fa03f66e325f62c2358d470a6","4da5c802a16525b9ec0bff351556bcb2b88c724fd0e7e4db9246add418c8e6a6","3efd18aafac5e844a00fcf8f693e8245052c551ec12c3e116898d2e560e5fff9","bb301b0817511ba6cfe3dc62b828a43e38c4ac78f04ebc03b4684a89f4f98bdd","ab64136b9a1378c42490555822078ad59f44883cb7b33f24dedd3a51f4f7732d","80d5fcadc61acc12977ef3d7c0567ef75c6f19a2d0bfff7f6142e9c9140b3050","3d10c33eaac8791715dc50690876fe6721787900b408a665e3035ddd8f295c95","9abc1a1516f0e2f1b960440b6c7bd85597c1f5ba6d8787ffb3afe22dba9f0e2f","5b9fc47d85c557247dbbfd1822a8d2fc975eaac1515287208506b310ac339a53","04fdf765e5079f1221a85620d2c94e34628c2d6f7eaf78f9701944caddb17fa7","8e7605f12a3eae2f058ab4689586e75d4c8458f91aeddf98216aea35e14cebb9","8f3758171a1c44e5c77f8e8d34206adf3397c65bad95bd4a1991e4b3d01f48bd","ca10623a50d3d5a069de9d98e09fedfe4ce4eaf4be0097529fdffef839a3f978","316df00dada13dcecf473b0e5fe1992d4a4448ed610826aa6de518784d2c09f0","e70801c5f5e3f9c77f8fbf6c7e031d8441a0e24fa33b27c56c7690ba42e51856","8ac0c8d0bfcf29b275720a77049f28d1607ee6837d4b40298623b0aa4dec855a","03af2f2398192e6a1ef1f27db4fcf8786869a186954f96241a5e9b272b034c1b"],"paragraph_range_zero_based":[4488,4511],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p4488"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>release the measurement gap configuration;","paragraph_zero_based":4512},{"literal_text_all_w_t_and_m_t":"2>setup measurement gap configuration indicated by the PosGapConfig in accordance with the received gapOffset, i.e., the first subframe of each gap occurs at an SFN and subframe meeting the following condition:","paragraph_zero_based":4513},{"literal_text_all_w_t_and_m_t":"SFN mod T = FLOOR(gapOffset/10);","paragraph_zero_based":4514},{"literal_text_all_w_t_and_m_t":"subframe = gapOffset mod 10;","paragraph_zero_based":4515},{"literal_text_all_w_t_and_m_t":"with T = MGRP/10 as defined in TS 38.133 [14];","paragraph_zero_based":4516},{"literal_text_all_w_t_and_m_t":"2>apply the specified timing advance mgta to the gap occurrences calculated above (i.e. the UE starts the measurement mgta ms before the gap subframe occurrences);","paragraph_zero_based":4517},{"literal_text_all_w_t_and_m_t":"2>configure the measurement gap as indicated by gapType;","paragraph_zero_based":4518},{"literal_text_all_w_t_and_m_t":"1>for each FR1, FR2, and per UE measurement gap that is setup:","paragraph_zero_based":4519},{"literal_text_all_w_t_and_m_t":"2>if the measurement gap is configured by GapConfig and preConfigInd-r17 in the corresponding GapConfig is present:","paragraph_zero_based":4520},{"literal_text_all_w_t_and_m_t":"3>determine whether the measurement gap is activated or not according to TS 38.133 [14];","paragraph_zero_based":4521},{"literal_text_all_w_t_and_m_t":"2>else if the measurement gap is configured by PosGapConfig:","paragraph_zero_based":4522},{"literal_text_all_w_t_and_m_t":"3>consider the measurement gap to be deactivated;","paragraph_zero_based":4523},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":4524},{"literal_text_all_w_t_and_m_t":"3>consider the measurement gap to be activated.","paragraph_zero_based":4525},{"literal_text_all_w_t_and_m_t":"NOTE 1:For FR2 gap configuration with synchronous CA, for the UE in NE-DC or NR-DC, the SFN and subframe of the serving cell indicated by the refServCellIndicator is used in the gap calculation. Otherwise, the SFN and subframe of a serving cell on FR2 frequency is used in the gap calculation","paragraph_zero_based":4526},{"literal_text_all_w_t_and_m_t":"NOTE 2:For FR1 gap or per UE gap configuration, for the UE in NE-DC or NR-DC, the SFN and subframe of the serving cell indicated by the refServCellIndicator in is used in the gap calculation. Otherwise, the SFN and subframe of the PCell is used in the gap calculation.","paragraph_zero_based":4527},{"literal_text_all_w_t_and_m_t":"NOTE 3:For FR2 gap configuration with asynchronous CA, for the UE in NE-DC or NR-DC, the SFN and subframe of the serving cell indicated by the refServCellIndicator and refFR2ServCellAsyncCA is used in the gap calculation. Otherwise, the SFN and subframe of a serving cell on FR2 frequency indicated by the refFR2ServCellAsyncCA is used in the gap calculation","paragraph_zero_based":4528},{"literal_text_all_w_t_and_m_t":"5.5.2.10Reference signal measurement timing configuration","paragraph_zero_based":4529},{"literal_text_all_w_t_and_m_t":"The UE shall setup the first SS/PBCH block measurement timing configuration (SMTC) in accordance with the received periodicityAndOffset parameter (providing Periodicity and Offset value for the following condition) in the smtc1 configuration. The first subframe of each SMTC occasion occurs at an SFN and subframe of the NR SpCell meeting the following condition:","paragraph_zero_based":4530},{"literal_text_all_w_t_and_m_t":"SFN mod T = (FLOOR (Offset/10));","paragraph_zero_based":4531},{"literal_text_all_w_t_and_m_t":"if the Periodicity is larger than sf5:","paragraph_zero_based":4532},{"literal_text_all_w_t_and_m_t":"subframe = Offset mod 10;","paragraph_zero_based":4533},{"literal_text_all_w_t_and_m_t":"else:","paragraph_zero_based":4534},{"literal_text_all_w_t_and_m_t":"subframe = Offset or (Offset +5);","paragraph_zero_based":4535}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["9802048f50bacd01ed8f06c7e28e4559f672a4c68e5374e2f6460c00aaefd55e","9809e100ad24ceeb17b044686f0e0b9583e4ebafebda264b219d445f8f539ae0","705293247cfc14e2a426da956ef0770c62a45aec6eb3d563c194ad862e2be970","282a2c354c7e288b9db2db299290c573b393782caf2668127fa325dcedace22d","1aecfb5b8eb4ee5a0b2122758451bc4d1d40a17eaebcd4e0160263f64a035ae5","b1e04bb25e656e775e155a747d167243cd6d5cea3ce063c6522b84c9ba2075e5","c5574e07acefe29c1ac629142e9e815e3ffd6b5ce7e12aa788d1845e6d7edef6","bf40cdf860b34219a73ff2413412084fa896ad41932cee6bb9202271517d9f49","f9c58e590d7f78beba906df695e527d97a25dd75af3f7044dd3040ee835b4d15","298fce4e656070e5415e8abe24013debc619eda5e5754b165e78954b43ba7a9e","4bffba1672f995204e9537521158622db06e0e69bb5e3bba7fc5f0ad36b71b4c","4404e011886bf3e215ff8f6969b01ca97c93de9f9d524117ca1c7ee74e45772e","abc9053fe61c7b6368aa1dcfb81a21cbe8cc9bf42ab168cacdd247c31fb21c1f","48d22ff279538a2c7282df068f507b0c4263193958985e6e30ff40ab5c1edba3","c5d903b1b676cfdff77f0835a391763eaf02aaa1d64d0aa119770b44f5d9d186","400924be9311b137693f066b52c3bb67b4ba230536257a5ce579b8309852e447","656793eb64a6a23973a87cca6c6a10b9ac787b3a3ab372abb6eba602b1c86daa","e3c6cfcd5f56dd90eade735dc3cc416ab786a1e2619c64925147f891d361351c","2ece60750952e38adc94d669aa32083d2f8c7620413c38c39a0a776f048fcea4","5eecba447fa1b8134b8fbc317913b84dd46a37e894549525e81f36ea36b47a07","15ba54a82cdf0770190eee85bb046e6b45614afa4e95cff4c965809cc09c2061","cf119c812ad77a227d417888150a4506ad137c04441b926ee4e7b6c73d7f2b91","8ca263f0fb6824014fd12b22ed64e1c5981a00674bcf81f518ba6ccb6aa97482","497d577bb394faa55f8ab2df2478749aed18f5bdda1b91ee9030e5eac1b10fe8"],"paragraph_range_zero_based":[4512,4535],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p4512"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"with T = CEIL(Periodicity/10).","paragraph_zero_based":4536},{"literal_text_all_w_t_and_m_t":"If smtc2 is present, for cells indicated in the pci-List parameter in smtc2 in the same MeasObjectNR, the UE shall setup an additional SS/PBCH block measurement timing configuration (SMTC) in accordance with the received periodicity parameter in the smtc2 configuration and use the Offset (derived from parameter periodicityAndOffset) and duration parameter from the smtc1 configuration. The first subframe of each SMTC occasion occurs at an SFN and subframe of the NR SpCell meeting the above condition.","paragraph_zero_based":4537},{"literal_text_all_w_t_and_m_t":"If smtc2-LP is present, for cells indicated in the pci-List parameter in smtc2-LP in the same frequency (for intra frequency cell reselection) or different frequency (for inter frequency cell reselection), the UE shall setup an additional SS/PBCH block measurement timing configuration (SMTC) in accordance with the received periodicity parameter in the smtc2-LP configuration and use the Offset (derived from parameter periodicityAndOffset) and duration parameter from the smtc configuration for that frequency. The first subframe of each SMTC occasion occurs at an SFN and subframe of the NR SpCell or serving cell (for cell reselection) meeting the above condition.","paragraph_zero_based":4538},{"literal_text_all_w_t_and_m_t":"If smtc3list is present, for cells indicated in the pci-List parameter in each SSB-MTC3 element of the list in the same MeasObjectNR, the IAB-MT shall setup an additional SS block measurement timing configuration in accordance with the received periodicityAndOffset parameter (using same condition as smtc1 to identify the SFN and the subframe for SMTC occasion) in each SSB-MTC3 configuration and use the duration and ssb-ToMeasure parameters from each SSB-MTC3 configuration.","paragraph_zero_based":4539},{"literal_text_all_w_t_and_m_t":"If smtc4list is present, for cells indicated in the pci-List parameter in each SSB-MTC4 element of the list in the same MeasObjectNR, the UE shall setup an additional SS/PBCH block measurement timing configuration (SMTC) in accordance with the received offset parameter in each SSB-MTC4 configuration and use the duration parameter and periodicity (derived from parameter periodicityAndOffset) from the smtc1 configuration. The first subframe of each SMTC occasion occurs at an SFN and subframe of the NR SpCell meeting the above condition.","paragraph_zero_based":4540},{"literal_text_all_w_t_and_m_t":"On the indicated ssbFrequency, the UE shall not consider SS/PBCH block transmission in subframes outside the SMTC occasion for RRM measurements based on SS/PBCH blocks and for RRM measurements based on CSI-RS except for SFTD measurement (see TS 38.133 [14], clause 9.3.8).","paragraph_zero_based":4541},{"literal_text_all_w_t_and_m_t":"5.5.2.10aRSSI measurement timing configuration","paragraph_zero_based":4542},{"literal_text_all_w_t_and_m_t":"The UE shall setup the RSSI measurement timing configuration (RMTC) in accordance with the received rmtc-Periodicity and, if configured, with rmtc-SubframeOffset i.e. the first symbol of each RMTC occasion occurs at first symbol of an SFN and subframe of the NR SpCell meeting the following condition:","paragraph_zero_based":4543},{"literal_text_all_w_t_and_m_t":"SFN mod T = FLOOR(rmtc-SubframeOffset/10);","paragraph_zero_based":4544},{"literal_text_all_w_t_and_m_t":"subframe = rmtc-SubframeOffset mod 10;","paragraph_zero_based":4545},{"literal_text_all_w_t_and_m_t":"with T = rmtc-Periodicity/10;","paragraph_zero_based":4546},{"literal_text_all_w_t_and_m_t":"On the frequency configured by rmtc-Frequency, the UE shall not consider RSSI measurements outside the configured RMTC occasion which lasts for measDurationSymbols for RSSI and channel occupancy measurements.","paragraph_zero_based":4547},{"literal_text_all_w_t_and_m_t":"The UE derives the RSSI measurement duration from a combination of measDurationSymbols and ref-SCS-CP. At least for RSSI measurement confined within the active DL BWP, the UE performs RSSI measurement using the numerology of the active DL BWP during the derived measurement duration. Otherwise, the numerology used by the UE for measurements is up to UE implementation. If configured, the UE performs RSSI measurements on a bandwidth in accordance with the received rmtc-Bandwidth. If configured, the UE performs RSSI measurements according to the TCI state configured by tci-StateId in the reference BWP configured by ref-BWPId of the reference serving cell configured by ref-ServCellId (see TS 38.133 [14], clause 9.2A.7 and clause 9.3A.8).If the UE has no serving cell in FR2-2 and configured with inter-frequency RSSI measurement in FR2-2, it is up to the UE implementation how to determine the spatial domain filter for the inter-frequency RSSI measurement in FR2-2.","paragraph_zero_based":4548},{"literal_text_all_w_t_and_m_t":"5.5.2.11Measurement gap sharing configuration","paragraph_zero_based":4549},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":4550},{"literal_text_all_w_t_and_m_t":"1>if gapSharingFR1 is set to setup:","paragraph_zero_based":4551},{"literal_text_all_w_t_and_m_t":"2>if an FR1 measurement gap sharing configuration configured by gapSharingFR1 is already setup:","paragraph_zero_based":4552},{"literal_text_all_w_t_and_m_t":"3>release the FR1 measurement gap sharing configuration configured by gapSharingFR1;","paragraph_zero_based":4553},{"literal_text_all_w_t_and_m_t":"2>setup the FR1 measurement gap sharing configuration indicated by the measGapSharingConfig in accordance with the received gapSharingFR1 as defined in TS 38.133 [14];","paragraph_zero_based":4554},{"literal_text_all_w_t_and_m_t":"1>else if gapSharingFR1 is set to release:","paragraph_zero_based":4555},{"literal_text_all_w_t_and_m_t":"2>release the FR1 measurement gap sharing configuration configured by gapSharingFR1;","paragraph_zero_based":4556},{"literal_text_all_w_t_and_m_t":"1>if gapSharingFR2 is set to setup:","paragraph_zero_based":4557},{"literal_text_all_w_t_and_m_t":"2>if an FR2 measurement gap sharing configuration configured by gapSharingFR2 is already setup:","paragraph_zero_based":4558},{"literal_text_all_w_t_and_m_t":"3>release the FR2 measurement gap sharing configuration configured by gapSharingFR2;","paragraph_zero_based":4559}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["d2a718f2b04e572b79d6b3e6ca85b65f9fb9b9ff256c37e06f44903a0986be46","6c23bc68ab95da3a6106b9b4a5cbb1416256e080e271cf5d6437273a75da83d1","0d40538a003c920395bbd90b4cf6f84844902eb7d7b3916a77424103ffcfb7ab","025ad1a4daf218ed1503d296e78769c24aa502054be3e905fd82742967571bf7","76302aa9f04dd5206bc4b492a48cb4141ae80e28107050f444bac6af0b5cb9a5","57d93a273233c081071bd7481e222c102c9ce6b4f52b715ef5dd36750520a68e","f9c3b9a7296c5da7e0815337145788fcbf0f8f0fbd4afee4ccf2ef5c7610c956","e4c5978c3983165f588a3281d8e674473be83978adb0039911956b45f23832ee","fa4e4a6bc7a9e9a79360683e5ecf339ad4c37b211707fe494dd2de3739d94bb3","a5f8a94d346c5a950c8fdb243db98711d52d48a10215325f358822cacdb726b3","283f24c74d127613334aea507d4277d8641b43e4dc568d567526dda38c067b56","5ba03bad5482c3dfe2afbbbd0f914c1f78609ea4205df652dfe0ef6c8a018f22","1d028e7ad6edf50768a650eff9b95ae647e96685dcc45a0fae0805b4bf7a5126","ccfcbe3fef8eedbb78384a7874f30770ae823849aaff280bae903324c13b747f","b7ca07ab055834d17daf57a64959bab7c2dcba0b96f310ad6ac57355f6073900","92a7762f25e1142a5849f4c69ad8ebf0e803f90c5c42c24a6b23a4e12d52ca14","78747efee6a868702fc895816fb1d4253a549349bc3788628e4fe19a07eb9037","db5608232e6c86d54e28afecceda8c4cd53b199e66f9ff9858468ff827ac29cb","e193bf925779174053d6d48e31203f5d33a5f6600b94227cdcf6609feb7933e3","e715f42e8400cd4ec46bde9b745a0236cc226c122dc5b89254cc09ff34aa98b5","3a25fe1661db2f7a6c879079d5e35da22ad0bc71759329a129851c3f31c5613a","54c0ab8d2acf9c1aaeba3fef06c39571b68567db001e856978d3b2dc33d8025f","a4a8321970714354e6a04eacf59c5bffae50877a9573f60d6cfa036efcf42252","681b3d4982aa37b58d33120ac5597c628b0aa251aeca57cef271571c7ad5558a"],"paragraph_range_zero_based":[4536,4559],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p4536"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>setup the FR2 measurement gap sharing configuration indicated by the measGapSharingConfig in accordance with the received gapSharingFR2 as defined in TS 38.133 [14];","paragraph_zero_based":4560},{"literal_text_all_w_t_and_m_t":"1>else if gapSharingFR2 is set to release:","paragraph_zero_based":4561},{"literal_text_all_w_t_and_m_t":"2>release the FR2 measurement gap sharing configuration configured by gapSharingFR2.","paragraph_zero_based":4562},{"literal_text_all_w_t_and_m_t":"1>if gapSharingUE is set to setup:","paragraph_zero_based":4563},{"literal_text_all_w_t_and_m_t":"2>if a per UE measurement gap sharing configuration configured by gapSharingUE is already setup:","paragraph_zero_based":4564},{"literal_text_all_w_t_and_m_t":"3>release the per UE measurement gap sharing configuration configured by gapSharingUE;","paragraph_zero_based":4565},{"literal_text_all_w_t_and_m_t":"2>setup the per UE measurement gap sharing configuration indicated by the measGapSharingConfig in accordance with the received gapSharingUE as defined in TS 38.133 [14];","paragraph_zero_based":4566},{"literal_text_all_w_t_and_m_t":"1>else if gapSharingUE is set to release:","paragraph_zero_based":4567},{"literal_text_all_w_t_and_m_t":"2>release the per UE measurement gap sharing configuration configured by gapSharingUE.","paragraph_zero_based":4568},{"literal_text_all_w_t_and_m_t":"5.5.3Performing measurements","paragraph_zero_based":4569},{"literal_text_all_w_t_and_m_t":"5.5.3.1General","paragraph_zero_based":4570},{"literal_text_all_w_t_and_m_t":"An RRC_CONNECTED UE shall derive cell measurement results by measuring one or multiple beams associated per cell as configured by the network, as described in 5.5.3.3. For all cell measurement results, except for RSSI, and CLI measurement results in RRC_CONNECTED, the UE applies the layer 3 filtering as specified in 5.5.3.2, before using the measured results for evaluation of reporting criteria, measurement reporting or the criteria to trigger conditional reconfiguration execution. For cell measurements, the network can configure RSRP, RSRQ, SINR, RSCP or EcN0 as trigger quantity. For CLI measurements, the network can configure SRS-RSRP or CLI-RSSI as trigger quantity. For cell and beam measurements, reporting quantities can be any combination of quantities (i.e. only RSRP; only RSRQ; only SINR; RSRP and RSRQ; RSRP and SINR; RSRQ and SINR; RSRP, RSRQ and SINR; only RSCP; only EcN0; RSCP and EcN0), irrespective of the trigger quantity, and for CLI measurements, reporting quantities can be either SRS-RSRP or CLI-RSSI. For conditional reconfiguration execution, the network can configure up to 2 quantities, both using same RS type. The UE does not apply the layer 3 filtering as specified in 5.5.3.2 to derive the CBR measurements. The UE does not apply the layer 3 filtering as specified in 5.5.3.2 to derive the Rx-Tx time difference measurements.","paragraph_zero_based":4571},{"literal_text_all_w_t_and_m_t":"The network may also configure the UE to report measurement information per beam (which can either be measurement results per beam with respective beam identifier(s) or only beam identifier(s)), derived as described in 5.5.3.3a. If beam measurement information is configured to be included in measurement reports, the UE applies the layer 3 beam filtering as specified in 5.5.3.2. On the other hand, the exact L1 filtering of beam measurements used to derive cell measurement results is implementation dependent.","paragraph_zero_based":4572},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":4573},{"literal_text_all_w_t_and_m_t":"1>whenever the UE has a measConfig, perform RSRP and RSRQ measurements for each serving cell for which servingCellMO is configured as follows:","paragraph_zero_based":4574},{"literal_text_all_w_t_and_m_t":"2>if the reportConfig associated with at least one measId included in the measIdList within VarMeasConfig contains an rsType set to ssb and ssb-ConfigMobility is configured in the measObject indicated by the servingCellMO:","paragraph_zero_based":4575},{"literal_text_all_w_t_and_m_t":"3>if the reportConfig associated with at least one measId included in the measIdList within VarMeasConfig contains a reportQuantityRS-Indexes and maxNrofRS-IndexesToReport and contains an rsType set to ssb:","paragraph_zero_based":4576},{"literal_text_all_w_t_and_m_t":"4>derive layer 3 filtered RSRP and RSRQ per beam for the serving cell based on SS/PBCH block, as described in 5.5.3.3a;","paragraph_zero_based":4577},{"literal_text_all_w_t_and_m_t":"3>derive serving cell measurement results based on SS/PBCH block, as described in 5.5.3.3;","paragraph_zero_based":4578},{"literal_text_all_w_t_and_m_t":"2>if the reportConfig associated with at least one measId included in the measIdList within VarMeasConfig contains an rsType set to csi-rs and CSI-RS-ResourceConfigMobility is configured in the measObject indicated by the servingCellMO:","paragraph_zero_based":4579},{"literal_text_all_w_t_and_m_t":"3>if the reportConfig associated with at least one measId included in the measIdList within VarMeasConfig contains a reportQuantityRS-Indexes and maxNrofRS-IndexesToReport and contains an rsType set to csi-rs:","paragraph_zero_based":4580},{"literal_text_all_w_t_and_m_t":"4>derive layer 3 filtered RSRP and RSRQ per beam for the serving cell based on CSI-RS, as described in 5.5.3.3a;","paragraph_zero_based":4581},{"literal_text_all_w_t_and_m_t":"3>derive serving cell measurement results based on CSI-RS, as described in 5.5.3.3;","paragraph_zero_based":4582},{"literal_text_all_w_t_and_m_t":"1>for each serving cell for which servingCellMO is configured, if the reportConfig associated with at least one measId included in the measIdList within VarMeasConfig contains SINR as trigger quantity and/or reporting quantity:","paragraph_zero_based":4583}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["a48c5e5cfd851f60e9c678ee88f246f6c9a7a3e3d8d36ec0044804896e49f653","12ae5c012068c9fb020596c1ee6300a79a552a04a459cfd95da8766ad041ff1c","444f4d8a223c91ae1f176ac531c2a35c5b6ed96c8cf7bcaec1f0e23ff7451125","d9389ac0b6ec8d24ea03d85658355ede8dab818eea44d664c912f8ab40b27cd6","bee92630244e273131d1bc9ff94b3656f3d41b7fde91ffc156c25a409fe61691","48e10730718698b939987de861acc80d579cb1cab58cb61c4365540167a0721a","4b6ebaf447c0c6caa7e0972c811822e467d9e81a6f16abeb0aeb606b65f4d517","a2c5ff52d020c404d9aa222d78f8a3055b3e18626c5302bd0c503e2195013535","01539114918921c1290f35b90db9c691ea23511a9a0d93c112fc5bf6d820b991","621af3002837f7788e3f9ede3d43fe96a40bf4b2e513ee626421462bf4848a64","c1867f9558958934bf622828527124232fdaf39b4b36994aaf49e58474b361fb","4739fdd5d4ecd460e41d705a6b6f2a847ea9ec7e5a313e006172ea4da3462132","817d8b7af8ec84f0f8f92801202b0ae93bd185419814b79152d005919cbd05cc","324b41a965b5a7e1285f4beef36e7bf521fcfd2b330b3aa2f9e539f667493a23","f947326cf9c05ba2346dd910e76e2800b2f1be64e35601a68e5f3482f22af78d","7c3b415cfb2871299ec0cac5c8d8875ba2a5f42b5e0529156509eaa18c0c3431","9dd54daa4aafe6cb224454b3c80786c50a5a8755bbb5e0345c4d5f765aa67821","ae2f3a7098b6958e0e439f1d687d776fb7ddec8dc9163c08923a4720b5c133dd","599b2a45cfa27279a8697b351c3388b66cd73297a69e6a6b89307d5a511388c5","408526dfa43b12a5bc2e3e2fd52ac5f9092b725332f7685932a21abe813f0243","7d58bc9c123e105ff840abb3718b75acbddce29aa4b38bfbe53d48645114b5e6","04264ca2e51347539cca0dc116c53f9c6b046440afc9d58fcbae939ef8101133","7f6e609966e7f76b81ea16d7fbb60a4a9728f0497d69d16217d08daaabd766ff","97d57665c2d31c3b1e404b026156995b6e7f2a3794fd024e09bcfd4a0421b12f"],"paragraph_range_zero_based":[4560,4583],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p4560"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if the reportConfig contains rsType set to ssb and ssb-ConfigMobility is configured in the servingCellMO:","paragraph_zero_based":4584},{"literal_text_all_w_t_and_m_t":"3>if the reportConfigcontains a reportQuantityRS-Indexes and maxNrofRS-IndexesToReport:","paragraph_zero_based":4585},{"literal_text_all_w_t_and_m_t":"4>derive layer 3 filtered SINR per beam for the serving cell based on SS/PBCH block, as described in 5.5.3.3a;","paragraph_zero_based":4586},{"literal_text_all_w_t_and_m_t":"3>derive serving cell SINR based on SS/PBCH block, as described in 5.5.3.3;","paragraph_zero_based":4587},{"literal_text_all_w_t_and_m_t":"2>if the reportConfig contains rsType set to csi-rs and CSI-RS-ResourceConfigMobility is configured in the servingCellMO:","paragraph_zero_based":4588},{"literal_text_all_w_t_and_m_t":"3>if the reportConfigcontains a reportQuantityRS-Indexes and maxNrofRS-IndexesToReport:","paragraph_zero_based":4589},{"literal_text_all_w_t_and_m_t":"4>derive layer 3 filtered SINR per beam for the serving cell based on CSI-RS, as described in 5.5.3.3a;","paragraph_zero_based":4590},{"literal_text_all_w_t_and_m_t":"3>derive serving cell SINR based on CSI-RS, as described in 5.5.3.3;","paragraph_zero_based":4591},{"literal_text_all_w_t_and_m_t":"1>for each measId included in the measIdList within VarMeasConfig:","paragraph_zero_based":4592},{"literal_text_all_w_t_and_m_t":"2>if the reportType for the associated reportConfig is set to reportCGI and timer T321 is running:","paragraph_zero_based":4593},{"literal_text_all_w_t_and_m_t":"3>if useAutonomousGaps is configured for the associated reportConfig:","paragraph_zero_based":4594},{"literal_text_all_w_t_and_m_t":"4>perform the corresponding measurements on the frequency and RAT indicated in the associated measObject using autonomous gaps as necessary;","paragraph_zero_based":4595},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":4596},{"literal_text_all_w_t_and_m_t":"4>perform the corresponding measurements on the frequency and RAT indicated in the associated measObject using available idle periods;","paragraph_zero_based":4597},{"literal_text_all_w_t_and_m_t":"3>if the cell indicated by reportCGI field for the associated measObject is an NR cell and that indicated cell is broadcasting SIB1 (see TS 38.213 [13], clause 13):","paragraph_zero_based":4598},{"literal_text_all_w_t_and_m_t":"4>try to acquire SIB1 in the concerned cell;","paragraph_zero_based":4599},{"literal_text_all_w_t_and_m_t":"3>if the cell indicated by reportCGI field is an E-UTRA cell:","paragraph_zero_based":4600},{"literal_text_all_w_t_and_m_t":"4>try to acquire SystemInformationBlockType1 in the concerned cell;","paragraph_zero_based":4601},{"literal_text_all_w_t_and_m_t":"2>if the ul-DelayValueConfig is configured for the associated reportConfig:","paragraph_zero_based":4602},{"literal_text_all_w_t_and_m_t":"3>ignore the measObject;","paragraph_zero_based":4603},{"literal_text_all_w_t_and_m_t":"3>for each of the configured DRBs, configure the PDCP layer to perform corresponding average UL PDCP packet delay measurement per DRB;","paragraph_zero_based":4604},{"literal_text_all_w_t_and_m_t":"2>if the ul-ExcessDelayConfig is configured for the associated reportConfig:","paragraph_zero_based":4605},{"literal_text_all_w_t_and_m_t":"3>ignore the measObject;","paragraph_zero_based":4606},{"literal_text_all_w_t_and_m_t":"3>for each of the configured DRBs, configure the PDCP layer to perform corresponding UL PDCP Excess Packet Delay delay measurement according to the configured threshold per DRB;","paragraph_zero_based":4607}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["67e444add28d5babe6a0e9e2bf0e17e1c0ac5cbf66cfb4fa54a1310a813f542f","e3dc2bfe1e43f1a78c2388f84ec47a6584484da9aceffee991b9bdf86d5305ab","a63950e07f34641b86bdb38869a3815b2567d9ede3f2a9218837019944a982b1","b8a9a7489a4d800cd356ed37466d8073e26637a1f1cbc2c07a096f96d5aa85aa","6f4ce931f5e4b9ed79684f5a984d0f40cbd0484568a9c51f583c1f0cf262e3b9","dcd76f1132e993383728fdc5c4d1a0d8ae3a265c79fcd81632bfba48b58cbfec","461ac26f0063929fdfde9a02cf58d3886b50278a70cf7dc9d2c769246482e03a","6873320218688f838bd6d4559d616160c64cde1c784ab2ff0e9ca956d59aff22","031da6f4f57c73cbb6cb05722798a1199d9d9ccf44b06fff77651b4b2ef874e4","63340a4678f09ea46e38ddafea9a9b9a61683d3345b2540b0a06db3aebef7ae2","adebfd9409d0c0247f3bd59093a611a9f47dddcb950b4e5de64524e962525e66","ce6c6722cd3a782432022639fd946761906d4167de360000402fe370bbdfd284","21064c41bfdc3243f25e8eba7e2a70d25b9028032ff5ca1ec2b3633bea8e2706","4b4a131cf3796fa01a3aa20d6b9a6eb73e8383b321012e9c6a7f4ac3c4dc1f14","80a984a79649906b1172fba2ecd371c66fd5f942fe2a96c95811ea59b8435063","30018c8fcc07481936b1e9cf854413f020423b7392799bfefedf0808b83fadd6","bfcd711c3cfd11df6be66e206843e1e18506f789f7ee1ae551bfb8573b8c2873","0cc12dd235bd8784a52fbd037e58546c69d165575baa208a39ec3119fc93f309","f70d5b23cd9ecf694dc7d25853ba33a35c0c5cfe15114bb7391c92dcb66b1c50","1845b98f89d68abc57047a2e611787d8dc975e3d2c4323af51ec80fba7711266","0a51d5e9948e1feb6966ca5432469155051b526d29ecf8aa760eba8ed379c7bc","1fc0341b82e2c6c5b0283705c368cd28fb473134104c213514dce2c7acd3eed5","b4f8e4956587b5782c2d4b92abe83de2bf995ed6a1a4ee2c63dd84020d93c3ad","4a43556ba7618274aa8680b6c59e72c3921c4ff2179d1fe4be5047182dec7fc6"],"paragraph_range_zero_based":[4584,4607],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p4584"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if the reportType for the associated reportConfig is periodical, eventTriggered; or","paragraph_zero_based":4608},{"literal_text_all_w_t_and_m_t":"2>if the reportType for the associated reportConfig is condTriggerConfig, the measId is within the MCG VarMeasConfig and is indicated in the condExecutionCond associated to a condReconfigId in the MCG VarConditionalReconfig (for CHO, CPA or MN-initiated inter-SN CPC in NR-DC); or","paragraph_zero_based":4609},{"literal_text_all_w_t_and_m_t":"2>if the reportType for the associated reportConfig is condTriggerConfig, the measId is within the SCG VarMeasConfig and is indicated in the condExecutionCond associated to a condReconfigId in the SCG VarConditionalReconfig (for intra-SN CPC); or","paragraph_zero_based":4610},{"literal_text_all_w_t_and_m_t":"2>if the reportType for the associated reportConfig is condTriggerConfig, the measId is within the SCG VarMeasConfig and is indicated in the condExecutionCondSCG associated to a condReconfigId in the MCG VarConditionalReconfig (for SN-initiated inter-SN CPC in NR-DC); or","paragraph_zero_based":4611},{"literal_text_all_w_t_and_m_t":"2>if the reportType for the associated reportConfig is condTriggerConfig, the measId is within the SCG VarMeasConfig and is indicated in the triggerConditionSN associated to a condReconfigurationId in VarConditionalReconfiguration as specified in TS 36.331 [10] (for SN-initiated inter-SN CPC in EN-DC):","paragraph_zero_based":4612},{"literal_text_all_w_t_and_m_t":"3>if a measurement gap configuration is setup, or","paragraph_zero_based":4613},{"literal_text_all_w_t_and_m_t":"3>if the UE does not require measurement gaps to perform the concerned measurements:","paragraph_zero_based":4614},{"literal_text_all_w_t_and_m_t":"4>if s-MeasureConfig is not configured, or","paragraph_zero_based":4615},{"literal_text_all_w_t_and_m_t":"4>if s-MeasureConfig is set to ssb-RSRP and the NR SpCell RSRP based on SS/PBCH block, after layer 3 filtering, is lower than ssb-RSRP, or","paragraph_zero_based":4616},{"literal_text_all_w_t_and_m_t":"4>if s-MeasureConfig is set to csi-RSRP and the NR SpCell RSRP based on CSI-RS, after layer 3 filtering, is lower than csi-RSRP:","paragraph_zero_based":4617},{"literal_text_all_w_t_and_m_t":"5>if the measObject is associated to NR and the rsType is set to csi-rs:","paragraph_zero_based":4618},{"literal_text_all_w_t_and_m_t":"6>if reportQuantityRS-Indexes and maxNrofRS-IndexesToReport for the associated reportConfig are configured:","paragraph_zero_based":4619},{"literal_text_all_w_t_and_m_t":"7>derive layer 3 filtered beam measurements only based on CSI-RS for each measurement quantity indicated in reportQuantityRS-Indexes, as described in 5.5.3.3a;","paragraph_zero_based":4620},{"literal_text_all_w_t_and_m_t":"6>derive cell measurement results based on CSI-RS for the trigger quantity and each measurement quantity indicated in reportQuantityCell using parameters from the associated measObject, as described in 5.5.3.3;","paragraph_zero_based":4621},{"literal_text_all_w_t_and_m_t":"5>if the measObject is associated to NR and the rsType is set to ssb:","paragraph_zero_based":4622},{"literal_text_all_w_t_and_m_t":"6>if reportQuantityRS-Indexes and maxNrofRS-IndexesToReport for the associated reportConfig are configured:","paragraph_zero_based":4623},{"literal_text_all_w_t_and_m_t":"7>derive layer 3 beam measurements only based on SS/PBCH block for each measurement quantity indicated in reportQuantityRS-Indexes, as described in 5.5.3.3a;","paragraph_zero_based":4624},{"literal_text_all_w_t_and_m_t":"6>derive cell measurement results based on SS/PBCH block for the trigger quantity and each measurement quantity indicated in reportQuantityCell using parameters from the associated measObject, as described in 5.5.3.3;","paragraph_zero_based":4625},{"literal_text_all_w_t_and_m_t":"5>if the measObject is associated to E-UTRA:","paragraph_zero_based":4626},{"literal_text_all_w_t_and_m_t":"6>perform the corresponding measurements associated to neighbouring cells on the frequencies indicated in the concerned measObject, as described in 5.5.3.2;","paragraph_zero_based":4627},{"literal_text_all_w_t_and_m_t":"5>if the measObject is associated to UTRA-FDD:","paragraph_zero_based":4628},{"literal_text_all_w_t_and_m_t":"6>perform the corresponding measurements associated to neighbouring cells on the frequencies indicated in the concerned measObject, as described in 5.5.3.2;","paragraph_zero_based":4629},{"literal_text_all_w_t_and_m_t":"5>if the measObject is associated to L2 U2N Relay UE:","paragraph_zero_based":4630},{"literal_text_all_w_t_and_m_t":"6>perform the corresponding measurements associated to candidate Relay UEs on the frequencies indicated in the concerned measObject, as described in 5.5.3.4;","paragraph_zero_based":4631}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["3d0b66759222c402dd52d7dc55ff95124393c922674193db878c2f7026f3aeb8","a7dcd03757d46b2b9fcc603d0dfd0e5f94da783789e5678e60ba311d9c18a8f1","28335373b3d40bd3bf74bbaa2c2c063e12e1f4cd33645608118ca81a8e54b815","9cfe1293ff3a3a6b1a0a91305b20941a90708ccbeb0ff08a8ad6bcfc2a42a448","fe83618d5021b7c5d611298dec93aa7223a2f6c27647b5de9f200624007d305c","ac7609444e4940aa077f8e6fe05a54db2517a419ceaf5554bfaef9228684933c","4b3d523e48b6b3098fe07b9dc3a2e986a5754b8ae6932329e26229174bde90a8","8c4dd40ef638808c12332f96c166f3ecb5c56471d667e910cd4022f37d4436b3","dafbcde718648099acdd203dc49b1a6294218422aab25b7004c24a0c48b9899e","fa47ca6b8a9fcf500960d27b2b45bea58d4a898c7b2034cbe2ad75c0d257a416","9778b6bf3afaa712924235cf6f58e0f55404c162341d5fb3936f6dc6d070f552","11ff17c204524454caf40b9b64bff72024f072968049cb0ad2fd7317a2b2cb3a","c6ef51d07b36e16bc9e819ef29c68ce7eea7e1990d745f6c15b91828fdbe7251","4f7df234dd27bb0dd40b75b265df2f608ec64888c9ae8c498768dbd7415af8cd","3808a1f30b80afc3bc6aed87f4cbafb09dbc8f12682a7f24375cf5783bed362b","94f47765fe8c16dac4d7599e4994ebfda588e348c7674e9b1af80e47ac77e382","21bb7350ac73fa8cf3b12f4792624ed3ee21cb01d7aecbb5b7fd61b2e013ff47","020b399927c13d72187cc92872373485ccdf35b7c29de3f5dd5e6ca29f55abfd","3bdd28cde6de43614fe5949bae19d83907fd25f405e4d31a03b7ca16ff1d3326","d00aa4cc3eb38ddea020617a0c20867a536dc743d739e838e7f062244ce33122","a1d9a12732d31f2788ffe3bb12a46c0f7a0f4fcf31c8f9d70d744390a0b9b910","a24b2ee951593ed672f3c7ad3399e0baeed7531b397d6e4037f69cf0e20394c9","beae3e41532a90ff443e5208609786f1f21080c14aac3488632328bbb9969f89","04ae2918d98ac53e3501434ca722fbec16d6086ea73854cc177af33ba18a94e4"],"paragraph_range_zero_based":[4608,4631],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p4608"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>if the measRSSI-ReportConfig is configured in the associated reportConfig:","paragraph_zero_based":4632},{"literal_text_all_w_t_and_m_t":"5>perform the RSSI and channel occupancy measurements on the frequency configured by rmtc-Frequency in the associated measObject;","paragraph_zero_based":4633},{"literal_text_all_w_t_and_m_t":"NOTE 0:The network avoids configuring UEs supporting only CHO and/or Rel-16 CPC with measurements not referred to by any execution condition.","paragraph_zero_based":4634},{"literal_text_all_w_t_and_m_t":"2>if the reportType for the associated reportConfig is set to reportSFTD and the numberOfReportsSent as defined within the VarMeasReportList for this measId is less than one:","paragraph_zero_based":4635},{"literal_text_all_w_t_and_m_t":"3>if the reportSFTD-Meas is set to true:","paragraph_zero_based":4636},{"literal_text_all_w_t_and_m_t":"4>if the measObject is associated to E-UTRA:","paragraph_zero_based":4637},{"literal_text_all_w_t_and_m_t":"5>perform SFTD measurements between the PCell and the E-UTRA PSCell;","paragraph_zero_based":4638},{"literal_text_all_w_t_and_m_t":"5>if the reportRSRP is set to true;","paragraph_zero_based":4639},{"literal_text_all_w_t_and_m_t":"6>perform RSRP measurements for the E-UTRA PSCell;","paragraph_zero_based":4640},{"literal_text_all_w_t_and_m_t":"4>else if the measObject is associated to NR:","paragraph_zero_based":4641},{"literal_text_all_w_t_and_m_t":"5>perform SFTD measurements between the PCell and the NR PSCell;","paragraph_zero_based":4642},{"literal_text_all_w_t_and_m_t":"5>if the reportRSRP is set to true;","paragraph_zero_based":4643},{"literal_text_all_w_t_and_m_t":"6>perform RSRP measurements for the NR PSCell based on SSB;","paragraph_zero_based":4644},{"literal_text_all_w_t_and_m_t":"3>else if the reportSFTD-NeighMeas is included:","paragraph_zero_based":4645},{"literal_text_all_w_t_and_m_t":"4>if the measObject is associated to NR:","paragraph_zero_based":4646},{"literal_text_all_w_t_and_m_t":"5>if the drx-SFTD-NeighMeas is included:","paragraph_zero_based":4647},{"literal_text_all_w_t_and_m_t":"6>perform SFTD measurements between the PCell and the NR neighbouring cell(s) detected based on parameters in the associated measObject using available idle periods;","paragraph_zero_based":4648},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":4649},{"literal_text_all_w_t_and_m_t":"6>perform SFTD measurements between the PCell and the NR neighbouring cell(s) detected based on parameters in the associated measObject;","paragraph_zero_based":4650},{"literal_text_all_w_t_and_m_t":"5>if the reportRSRP is set to true:","paragraph_zero_based":4651},{"literal_text_all_w_t_and_m_t":"6>perform RSRP measurements based on SSB for the NR neighbouring cell(s) detected based on parameters in the associated measObject;","paragraph_zero_based":4652},{"literal_text_all_w_t_and_m_t":"2>if the reportType for the associated reportConfig is cli-Periodical or cli-EventTriggered:","paragraph_zero_based":4653},{"literal_text_all_w_t_and_m_t":"3>perform the corresponding measurements associated to CLI measurement resources indicated in the concerned measObjectCLI;","paragraph_zero_based":4654},{"literal_text_all_w_t_and_m_t":"2>perform the evaluation of reporting criteria as specified in 5.5.4, except if reportConfig is condTriggerConfig.","paragraph_zero_based":4655}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["a447861f606496a2c786c7d0d6e08d8b991ad6d1386ce0f7f03e0d52c69b976c","e80c4f3be922060050ba082faa9be99ebc4a330887bd510c4dee64937f11b983","a59f084a179a5dbd138f2cffb8dbd0b5e6744909ee5223288f2dafde34b0b43d","b81279af650482f9e05bf9464d9878613888c7029db9cb7cbac5f1b677626204","824f292ea794897b6d456079ec40372cff686b604fe4240e5da51c19482cb53b","a1c0fe20ec4b8d07a9f5ff6555700a694e585da5d53ade72589e67378bd3dfba","b05fda51b7369aa96c50f2575feecca5cc37b01302cb9d1eefbf2240afe86501","bbaa2d6358434c55f76875d1ca15b7e7003088232327961dd36a95208339bd9a","3991f9d82345db4d0036253fd570b32f192a648757ac6043dfdb1e91a75eca89","8ac4635e5829b3aaa541fbccfc8a54e1209d46f29d8e0a06a96096666f9cd769","860c6cffa3bb9839507ef914c5ee466669d6b71743d40ccbc26d9fb616e5180d","01a894e0b8a76c8a1131ee3597769d067341e1a9a5a88e82e892b72ad5b00432","7932d32698967730c0bb76f25f245081a5c9f9744064c44b4e4bcae8e18e7500","18c5c04d91d78970fbaa4c4de8b83dc26c29d4b25ffdca1f428e36e4542f6b27","8d8f992e608e94bac77df6cade143c558062b1125f2b9403a8c9140a3ac9a202","adad8210487f362cc72008316b9e4b0217e9562930b7479be26777279b8ab21e","f0503578363db5df60109dccb4130c9d2f9db8d3add8cfa7924c4dd0c785da6a","f9a8c82859cf1f6023ca75f26249d827788b3519334d691daf0c8ee018c82fb5","09d9c9f0afe7ca898eef5f13fc6646bdae16383738df9880909959e173bbe13c","414b960775361a9f4fc4876e483d18b5bea6ee47a34d2ad1fc094dd9aafa6d7f","b9540d0d626619b22e8ecee9284104b7f2b1a6bbabd66e8e2650b1a5228edba9","a153e751046d377f1c02a73bef464ac712de0564d7d63b57c1a05aa89ae3f962","9f93337d765bce2dcc7258af94ee30b7bf1eff423aff11d210d551fa603df5ec","501e36a45239bf2d823dd83fecba03948c4b46ee8bbef17b63e23aa6f0eb606e"],"paragraph_range_zero_based":[4632,4655],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p4632"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The UE acting as a L2 U2N Remote UE whenever configured with measConfig shall:","paragraph_zero_based":4656},{"literal_text_all_w_t_and_m_t":"1>perform the corresponding measurements associated to the serving L2 U2N Relay UE, as described in 5.5.3.4;","paragraph_zero_based":4657},{"literal_text_all_w_t_and_m_t":"NOTE 1:The evaluation of conditional reconfiguration execution criteria is specified in 5.3.5.13.","paragraph_zero_based":4658},{"literal_text_all_w_t_and_m_t":"The UE capable of Rx-Tx time difference measurement when configured with measObjectRxTxDiff shall:","paragraph_zero_based":4659},{"literal_text_all_w_t_and_m_t":"1>perform the corresponding Rx-Tx time difference measurements associated with downlink reference signals indicated in the concerned measObjectRxTxDiff.","paragraph_zero_based":4660},{"literal_text_all_w_t_and_m_t":"The UE capable of CBR measurement when configured to transmit NR sidelink communication/discovery shall:","paragraph_zero_based":4661},{"literal_text_all_w_t_and_m_t":"1>If the frequency used for NR sidelink communication/discovery is included in sl-FreqInfoToAddModList in sl-ConfigDedicatedNR within RRCReconfiguration message or included in sl-ConfigCommonNR within SIB12:","paragraph_zero_based":4662},{"literal_text_all_w_t_and_m_t":"2>if the UE is in RRC_IDLE or in RRC_INACTIVE:","paragraph_zero_based":4663},{"literal_text_all_w_t_and_m_t":"3>if configured with NR sidelink communication and the cell chosen for NR sidelink communication provides SIB12 which includes sl-TxPoolSelectedNormal or sl-TxPoolExceptional for the concerned frequency; or","paragraph_zero_based":4664},{"literal_text_all_w_t_and_m_t":"3>if configured with NR sidelink discovery and the cell chosen for NR sidelink discovery provides SIB12 which includes sl-TxPoolSelectedNormal or sl-TxPoolExceptional but does not include sl-DiscTxPoolSelected for the concerned frequency:","paragraph_zero_based":4665},{"literal_text_all_w_t_and_m_t":"4>perform CBR measurement on pool(s) in sl-TxPoolSelectedNormal or sl-TxPoolExceptional for the concerned frequency in SIB12;","paragraph_zero_based":4666},{"literal_text_all_w_t_and_m_t":"3>if configured with NR sidelink discovery and the cell chosen for NR sidelink discovery provides SIB12 which includes sl-DiscTxPoolSelected for the concerned frequency:","paragraph_zero_based":4667},{"literal_text_all_w_t_and_m_t":"4>perform CBR measurement on pools in sl-DiscTxPoolSelected and sl-TxPoolExceptional for the concerned frequency in SIB12;","paragraph_zero_based":4668},{"literal_text_all_w_t_and_m_t":"2>if the UE is in RRC_CONNECTED:","paragraph_zero_based":4669},{"literal_text_all_w_t_and_m_t":"3>if tx-PoolMeasToAddModList is included in VarMeasConfig:","paragraph_zero_based":4670},{"literal_text_all_w_t_and_m_t":"4>perform CBR measurements on each transmission resource pool indicated in the tx-PoolMeasToAddModList;","paragraph_zero_based":4671},{"literal_text_all_w_t_and_m_t":"3>if sl-DiscTxPoolSelected, sl-TxPoolSelectedNormal, sl-TxPoolScheduling or sl-TxPoolExceptional is included in sl-ConfigDedicatedNR for the concerned frequency within RRCReconfiguration:","paragraph_zero_based":4672},{"literal_text_all_w_t_and_m_t":"4>perform CBR measurement on pool(s) in sl-DiscTxPoolSelected, sl-TxPoolSelectedNormal, sl-TxPoolScheduling and sl-TxPoolExceptional if included in sl-ConfigDedicatedNR for the concerned frequency within RRCReconfiguration;","paragraph_zero_based":4673},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":4674},{"literal_text_all_w_t_and_m_t":"4>if configured with NR sidelink communication and the cell chosen for NR sidelink communication provides SIB12 which includes sl-TxPoolSelectedNormal or sl-TxPoolExceptional for the concerned frequency; or","paragraph_zero_based":4675},{"literal_text_all_w_t_and_m_t":"4>if configured with NR sidelink discovery and the cell chosen for NR sidelink discovery provides SIB12 which includes sl-TxPoolSelectedNormal or sl-TxPoolExceptional but does not provide sl-DiscTxPoolSelected for the concerned frequency:","paragraph_zero_based":4676},{"literal_text_all_w_t_and_m_t":"5>perform CBR measurement on pool(s) in sl-TxPoolSelectedNormal or sl-TxPoolExceptional for the concerned frequency in SIB12;","paragraph_zero_based":4677},{"literal_text_all_w_t_and_m_t":"4>if configured with NR sidelink discovery and the cell chosen for NR sidelink discovery provides SIB12 which includes sl-DiscTxPoolSelected for the concerned frequency:","paragraph_zero_based":4678},{"literal_text_all_w_t_and_m_t":"5>perform CBR measurement on pools in sl-DiscTxPoolSelected and sl-TxPoolExceptional for the concerned frequency in SIB12;","paragraph_zero_based":4679}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["49a0d709ea8bb7921eba887f5f7621b4817246eef7150d5c0aa44821c0a735bd","5b073e5beca22be438e1dbdf9e1fbeec86d1f62446827709ddeddee252fc2b52","e3d91fe76b9d94d30651fc3723b902cca5cc93ac5368ee486c08377dcdb21cbc","94ec112ecf815283f507e9849dba61bf61fe8ffe48b3184066a792e9fcfdebdd","136de6ae0c2d939b7a06f2ba95a8ba0bdd0db7fd049daa53cdad365649843cfa","fdb19379d600d440b81228529449b9ddf20eef43e2e075373560bab228d3f717","d4de81c92979193876c732b0211906d637d8d8b8da4c18fac49082a1fe5bbd04","26388dc1c27a659edfe6d3d258531192e5e34dae5752b74b08099ea667c11c07","aa290487a9aee520a5fcd6fa78ffcc711f6b0adf2d9a37cb9cdfa1986f871d11","ee6e3b0ed62eb4e87e74cbc7cd83349e6357dc443d24aa8d9345179f3e13fb51","1205cda88af44c240bb75717e0e908e36e34f1b1a39a529ef29de884e18a5735","4082acd5768ffad52437cb63972d263f7e62d265b8489106865c59ddb47e0f35","d5d7c0288521063ee52338f3d90338825a267eec969e08faf967650f3fe90ce4","ed898d72ab5814e9d88d0bc04c2883bb207ebc5874470f413eb52eb8c35a2e4c","10da0191ee9c3a0b4bbc3caa4264f496ab933cb9e902eb1d6ce5e6d9296a7dcd","b791e91600423ea5465cdce3354888691d8c91a8a9b53bdf513c9be8e4372631","6ff38422ddff4c0ae48a944be4bd9c627f3b95444888d33bd6b66324179841de","221a768497a36b15290d854111f17419f68d8bbdca94ed01ab1c97cd5f451630","e79d9c54ce4f4e8d8dd6b31f9529ef2bdc2995247a26cfcd966a7e308931b79c","3fa5d021d8111896442e0708d073f165ea90b930c222e895372e2219307f0f01","6c37113b0c3c2a737fe1caabd38457dc637912b7b661c327345029b93f79aee6","205603d41c101ac133c7747535114ac316a285a71e286d78138efd66919f7f80","a30162974d8b3b97d9e12d044a32d50ccc8fc5a724f898e22f96d9449ef8fce4","6d8471e3fba4d72f408cb8bd7fb4f134e4305c3705655fcb132a2d4e999a6038"],"paragraph_range_zero_based":[4656,4679],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p4656"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":4680},{"literal_text_all_w_t_and_m_t":"2>if configured with NR sidelink communication and sl-TxPoolSelectedNormal is included in SidelinkPreconfigNR for the concerned frequency; or","paragraph_zero_based":4681},{"literal_text_all_w_t_and_m_t":"2>if configured with NR sidelink discovery and sl-TxPoolSelectedNormal is included in SidelinkPreconfigNR but sl-DiscTxPoolSelected is not included in SidelinkPreconfigNR for the concerned frequency:","paragraph_zero_based":4682},{"literal_text_all_w_t_and_m_t":"3>perform CBR measurement on pool(s) in sl-TxPoolSelectedNormal in SidelinkPreconfigNR for the concerned frequency.","paragraph_zero_based":4683},{"literal_text_all_w_t_and_m_t":"2>if configured with NR sidelink discovery and sl-DiscTxPoolSelected is included in SidelinkPreconfigNR for the concerned frequency:","paragraph_zero_based":4684},{"literal_text_all_w_t_and_m_t":"3>perform CBR measurement on pools in sl-DiscTxPoolSelected if included in SidelinkPreconfigNR.","paragraph_zero_based":4685},{"literal_text_all_w_t_and_m_t":"NOTE 2:In case the configurations for NR sidelink communication and CBR measurement are acquired via the E-UTRA, configurations for NR sidelink communication in SIB12, sl-ConfigDedicatedNR within RRCReconfiguration used in this clause are provided by the configurations in SystemInformationBlockType28, sl-ConfigDedicatedForNR within RRCConnectionReconfiguration as specified in TS 36.331[10], respectively.","paragraph_zero_based":4686},{"literal_text_all_w_t_and_m_t":"NOTE 3:If a UE that is configured by upper layers to transmit V2X sidelink communication is configured by NR with transmission resource pool(s) and the measurement objects concerning V2X sidelink communication (i.e. by sl-ConfigDedicatedEUTRA-Info), it shall perform CBR measurement as specified in clause 5.5.3 of TS 36.331 [10], based on the transmission resource pool(s) and the measurement object(s) concerning V2X sidelink communication configured by NR.","paragraph_zero_based":4687},{"literal_text_all_w_t_and_m_t":"NOTE 4:For V2X sidelink communication, each of the CBR measurement results is associated with a resource pool, as indicated by the poolReportId (see TS 36.331 [10]), that refers to a pool as included in sl-ConfigDedicatedEUTRA-Info or SIB13.","paragraph_zero_based":4688},{"literal_text_all_w_t_and_m_t":"5.5.3.2Layer 3 filtering","paragraph_zero_based":4689},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":4690},{"literal_text_all_w_t_and_m_t":"1>for each cell measurement quantity, each beam measurement quantity, each sidelink measurement quantity as needed in clause 5.8.10, for each CLI measurement quantity that the UE performs measurements according to 5.5.3.1, for each candidate L2 U2N Relay UE measurement quantity according to 5.5.3.4, and for evaluating the detected NR sidelink U2N Relay UEs according to 5.8.15.3:","paragraph_zero_based":4691},{"literal_text_all_w_t_and_m_t":"2>filter the measured result, before using for evaluation of reporting criteria, for measurement reporting or for U2N Relay (re)selection evaluation, by the following formula:","paragraph_zero_based":4692},{"literal_text_all_w_t_and_m_t":"Fn = (1 – a)*Fn-1 + a*Mn","paragraph_zero_based":4693},{"literal_text_all_w_t_and_m_t":"where","paragraph_zero_based":4694},{"literal_text_all_w_t_and_m_t":"Mn is the latest received measurement result from the physical layer;","paragraph_zero_based":4695},{"literal_text_all_w_t_and_m_t":"Fn is the updated filtered measurement result, that is used for evaluation of reporting criteria, for measurement reporting or for U2N Relay (re)selection evaluation;","paragraph_zero_based":4696},{"literal_text_all_w_t_and_m_t":"Fn-1 is the old filtered measurement result, where F0 is set to M1 when the first measurement result from the physical layer is received; and for MeasObjectNR, a = 1/2(ki/4), where ki is the filterCoefficient for the corresponding measurement quantity of the i:th QuantityConfigNR in quantityConfigNR-List, and i is indicated by quantityConfigIndex in MeasObjectNR; for other measurements, a = 1/2(k/4), where k is the filterCoefficient for the corresponding measurement quantity received by the quantityConfig; for UTRA-FDD, a = 1/2(k/4), where k is the filterCoefficient for the corresponding measurement quantity received by quantityConfigUTRA-FDD in the QuantityConfig;","paragraph_zero_based":4697},{"literal_text_all_w_t_and_m_t":"2>adapt the filter such that the time characteristics of the filter are preserved at different input rates, observing that the filterCoefficient k assumes a sample rate equal to X ms; The value of X is equivalent to one intra-frequency L1 measurement period as defined in TS 38.133 [14] assuming non-DRX operation, and depends on frequency range.","paragraph_zero_based":4698},{"literal_text_all_w_t_and_m_t":"NOTE 1:If k is set to 0, no layer 3 filtering is applicable.","paragraph_zero_based":4699},{"literal_text_all_w_t_and_m_t":"NOTE 2:The filtering is performed in the same domain as used for evaluation of reporting criteria, for measurement reporting or for U2N Relay (re)selection evaluation, i.e., logarithmic filtering for logarithmic measurements.","paragraph_zero_based":4700},{"literal_text_all_w_t_and_m_t":"NOTE 3:The filter input rate is implementation dependent, to fulfil the performance requirements set in TS 38.133 [14]. For further details about the physical layer measurements, see TS 38.133 [14].","paragraph_zero_based":4701},{"literal_text_all_w_t_and_m_t":"NOTE 4:For CLI-RSSI measurement, it is up to UE implementation whether to reset filtering upon BWP switch.","paragraph_zero_based":4702},{"literal_text_all_w_t_and_m_t":"NOTE x:For SSB measurements when multiple altitude range-based ssb-ToMeasure are configured, it is up to UE implementation whether to reset filtering upon entering a different altitude range.","paragraph_zero_based":4703}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["eb051a4340404f7c0f6c26cc7d04fd997d6765f374fe7c33700bcf8f7f6aec8d","f2e02ea618239d5e2ab5271248e92f81e2078c840ac90850a39f149647e9aef4","5c1a7141c454d016555c12829ccc842b297229431ffdf412a6278facf99dc2aa","7b37f09a44349258e141525750573b2e42f9fe329f3640b013dfe2ac3ce70524","6ca02a9ee70654867140e2b32b5c17a30455288d11ccfec27f41febf9a2c896a","701d934abe72b2186a89ad26f8234b4afdc4caff85f3e2b9bb904490805a7f5c","73956b0b42bad3406587556f9fde5a490f7c2165c21580e8eccb7a70dd104cf0","4e805de840e758a9a405ce986e907347fcd2bef26b4ad1c551bbf10f06ec3bf1","a8a37b207e22c28c490b44f3bdf6e830a0fef42f4baf8f265dcfebdd8c5a8bac","737e65361c663e1c3cae0095fd81034e620e54ef1810ee264b573f1e4fa512ed","0983102e1884cc6b4b8af0c02ecb5fd35bdae4990cff4f1bc442c778241d139b","a450c9dde3c6d91fca5b512452910d5eb7ea999bc171a947160cdde6c755d09c","638195c08984ad53ca83c7c9780f68ae5bb4580341f7a9bde9cd2eddace60926","03e0eb5c56b6c41a7c3cb0b8d276bf686ee42ac1d1dbf8de7f61b349fff3b25e","060f498f89fa5947d1244cd8ad2b5479d70ae79a119fa91fa4afec07bee602f3","a117975fa47cdaca1e3f4d98e037685170dff66406e5a9f78700df1dd3271bc5","a55aec47b6f8fa417466f2a6f212439bf0f12a8dc0643c88b9b770e7879c3130","800b49bbc58d8896c0d33c1dba39ac666f15da901af1a0cee2f1a212269e4d95","82eddbf80a102da96e61c2b0f6740ed21fc8753f11936521a5651d7056bff529","5f06926dedb2075062d1690b4fde73127de5dae6c5a7ba89c1f3176b4af5f8ed","e085b56c0b96936441211de8653f8bc643aab55ac2e324ba952f704baeb86ccc","ade19b234b5dd8b6d29923637dbb280cb3f551e6cdbee2911943bb22148f4bc6","77334108c6c580d604b3538725130844080156f17de44e76f81c0cb5902de196","9005595e6e88a6383045ee83ae55d099728e38217f095d27c1a90a792f64d34a"],"paragraph_range_zero_based":[4680,4703],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p4680"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.5.3.3Derivation of cell measurement results","paragraph_zero_based":4704},{"literal_text_all_w_t_and_m_t":"The network may configure the UE in RRC_CONNECTED to derive RSRP, RSRQ and SINR measurement results per cell associated to NR measurement objects based on parameters configured in the measObject (e.g. maximum number of beams to be averaged and beam consolidation thresholds) and in the reportConfig (rsType to be measured, SS/PBCH block or CSI-RS).","paragraph_zero_based":4705},{"literal_text_all_w_t_and_m_t":"The network may configure the UE in RRC_IDLE or in RRC_INACTIVE to derive RSRP and RSRQ measurement results per cell associated to NR carriers based on parameters configured in measIdleCarrierListNR within VarMeasIdleConfig for measurements performed according to 5.7.8.2a.","paragraph_zero_based":4706},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":4707},{"literal_text_all_w_t_and_m_t":"1>for each cell measurement quantity to be derived based on SS/PBCH block:","paragraph_zero_based":4708},{"literal_text_all_w_t_and_m_t":"2>if nrofSS-BlocksToAverage is not configured in the associated measObject in RRC_CONNECTED or in the associated entry in measIdleCarrierListNR within VarMeasIdleConfig in RRC_IDLE/RRC_INACTIVE; or","paragraph_zero_based":4709},{"literal_text_all_w_t_and_m_t":"2>if absThreshSS-BlocksConsolidation is not configured in the associated measObject in RRC_CONNECTED or in the associated entry in measIdleCarrierListNR within VarMeasIdleConfig in RRC_IDLE/RRC_INACTIVE; or","paragraph_zero_based":4710},{"literal_text_all_w_t_and_m_t":"2>if the highest beam measurement quantity value is below or equal to absThreshSS-BlocksConsolidation:","paragraph_zero_based":4711},{"literal_text_all_w_t_and_m_t":"3>derive each cell measurement quantity based on SS/PBCH block as the highest beam measurement quantity value, where each beam measurement quantity is described in TS 38.215 [9];","paragraph_zero_based":4712},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":4713},{"literal_text_all_w_t_and_m_t":"3>derive each cell measurement quantity based on SS/PBCH block as the linear power scale average of the highest beam measurement quantity values above absThreshSS-BlocksConsolidation where the total number of averaged beams shall not exceed nrofSS-BlocksToAverage, and where each beam measurement quantity is described in TS 38.215 [9];","paragraph_zero_based":4714},{"literal_text_all_w_t_and_m_t":"2>if in RRC_CONNECTED, apply layer 3 cell filtering as described in 5.5.3.2;","paragraph_zero_based":4715},{"literal_text_all_w_t_and_m_t":"1>for each cell measurement quantity to be derived based on CSI-RS:","paragraph_zero_based":4716},{"literal_text_all_w_t_and_m_t":"2>consider a CSI-RS resource to be applicable for deriving cell measurements when the concerned CSI-RS resource is included in the csi-rs-CellMobility including the physCellId of the cell in theCSI-RS-ResourceConfigMobility in the associated measObject;","paragraph_zero_based":4717},{"literal_text_all_w_t_and_m_t":"2>if nrofCSI-RS-ResourcesToAverage in the associated measObject is not configured; or","paragraph_zero_based":4718},{"literal_text_all_w_t_and_m_t":"2>if absThreshCSI-RS-Consolidation in the associated measObject is not configured; or","paragraph_zero_based":4719},{"literal_text_all_w_t_and_m_t":"2>if the highest beam measurement quantity value is below or equal to absThreshCSI-RS-Consolidation:","paragraph_zero_based":4720},{"literal_text_all_w_t_and_m_t":"3>derive each cell measurement quantity based on applicable CSI-RS resources for the cell as the highest beam measurement quantity value, where each beam measurement quantity is described in TS 38.215 [9];","paragraph_zero_based":4721},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":4722},{"literal_text_all_w_t_and_m_t":"3>derive each cell measurement quantity based on CSI-RS as the linear power scale average of the highest beam measurement quantity values above absThreshCSI-RS-Consolidation where the total number of averaged beams shall not exceed nrofCSI-RS-ResourcesToAverage;","paragraph_zero_based":4723},{"literal_text_all_w_t_and_m_t":"2>apply layer 3 cell filtering as described in 5.5.3.2.","paragraph_zero_based":4724},{"literal_text_all_w_t_and_m_t":"5.5.3.3aDerivation of layer 3 beam filtered measurement","paragraph_zero_based":4725},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":4726},{"literal_text_all_w_t_and_m_t":"1>for each layer 3 beam filtered measurement quantity to be derived based on SS/PBCH block;","paragraph_zero_based":4727}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["84e491b4e23f0e5a45242a095b8ce0f671adcb9034a4d2b5698767ec86c4c98b","af26be8b4f2b370efc83879c58745232c8caa05879aaef77de934416607936ee","9b08ffd9079410cc7b4d3a37225b46e145b3321b3e51257f72536fb7093edb07","b9924648c4294225904f0bfe7d7ba91b78ba0ca86ad9f933c4e0cefcbe3caa47","530cc7b2a2e747d0299b562a01046cae64662f686186c3009ca5f37ea6eed57c","d157c8856b512cb19fd47970ba29c77c75fbc39b6f1a3fa3d0330b20078d1f92","7575906c7b05cd97b95e82e80f5abfaa984e8a362cdcd46eaa762307742ef42d","c6c93aac6e60eea7ac2f487c9bf53e8cc81e452e56894049d91b3d8d9fedfe95","328ba09b89444d8b55b3c6c0a3c5ffabc795ee182c7067466d81f92ccb046349","f08f091558ce7f3cad59a88f252081681e6f2947a42b7a3fab169ce1b388adb3","ce5ad2c6c0db7ce0f3570b624cbde691a57d34c4a56b46aa05b80a540a778f28","3e1bf4c80527353a50d224ef3cd245900edb985eea05ad8c0ab6f063b571c466","0b526dd048d31a1501210789b74ce67ec7fd6db1f103b62d4a4b919a38535852","a291c7ce15d0ab99e09b280e934bf1df09fac7d5a83f89c3f90c76ef5d0c7db5","b128ddadd474024c9edddbf884379f48d1541e9f5515e8f3d4624cb198080522","110bf6c8e9f46e8a1f18ccf7b0be4202cc74751c2cf66326655421727f7e8bbb","db864b7c20df77f6e240ee2575dab621074441b063dce294527309acb850af9a","50dbbc2e3bd7ddf2c60b57b6909b30c9dbad98a7abf5432cf2aa773de32baa4f","f6b9c2b919a61d2e68e8849cacd6f70a4531f3338b3b52f541bf820e773da8cc","9c31ecd2d95a96f334f435ca9b79d525274d0754a5e03945a68aa1f1a6c17788","6e5a271ddf49b77b0150d86b2dc38d80724d138ab4263eedeaaccd69103f276b","e1b1b95814c1aae4e5ed8644c768bc78471eeb2fe329d67528cf17102b36315b","2f1811172d1fdb1ae7ea69fda26d15e0615554b6600ec0e8ba438c77dd1b70f9","fd176e2afb021cbe7b2a8fbe20a619d63756076eb1984d945e513dd5d36233a6"],"paragraph_range_zero_based":[4704,4727],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p4704"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>derive each configured beam measurement quantity based on SS/PBCH block as described in TS 38.215[9], and apply layer 3 beam filtering as described in 5.5.3.2;","paragraph_zero_based":4728},{"literal_text_all_w_t_and_m_t":"1>for each layer 3 beam filtered measurement quantity to be derived based on CSI-RS;","paragraph_zero_based":4729},{"literal_text_all_w_t_and_m_t":"2>derive each configured beam measurement quantity based on CSI-RS as described in TS 38.215 [9], and apply layer 3 beam filtering as described in 5.5.3.2.","paragraph_zero_based":4730},{"literal_text_all_w_t_and_m_t":"5.5.3.4Derivation of L2 U2N Relay UE measurement results","paragraph_zero_based":4731},{"literal_text_all_w_t_and_m_t":"A UE may be configured by network to derive NR sidelink measurement results of serving L2 U2N Relay UE or candidate L2 U2N Relay UEs associated to the measurement objects configured in the measObjectRelay.","paragraph_zero_based":4732},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":4733},{"literal_text_all_w_t_and_m_t":"1>for each L2 U2N Relay UE measurement quantity to be derived:","paragraph_zero_based":4734},{"literal_text_all_w_t_and_m_t":"2>derive the corresponding measurement quantity based on DMRS as described in TS 38.215 [9];","paragraph_zero_based":4735},{"literal_text_all_w_t_and_m_t":"2>apply layer 3 filtering as described in 5.5.3.2;","paragraph_zero_based":4736},{"literal_text_all_w_t_and_m_t":"5.5.4Measurement report triggering","paragraph_zero_based":4737},{"literal_text_all_w_t_and_m_t":"5.5.4.1General","paragraph_zero_based":4738},{"literal_text_all_w_t_and_m_t":"If AS security has been activated successfully, the UE shall:","paragraph_zero_based":4739},{"literal_text_all_w_t_and_m_t":"1>for each measId included in the measIdList within VarMeasConfig:","paragraph_zero_based":4740},{"literal_text_all_w_t_and_m_t":"2>if the corresponding reportConfig includes a reportType set to eventTriggered or periodical:","paragraph_zero_based":4741},{"literal_text_all_w_t_and_m_t":"3>if the corresponding measObject concerns NR:","paragraph_zero_based":4742},{"literal_text_all_w_t_and_m_t":"4>if the corresponding reportConfig includes measRSSI-ReportConfig:","paragraph_zero_based":4743},{"literal_text_all_w_t_and_m_t":"5>consider the resource indicated by the rmtc-Config on the associated frequency to be applicable;","paragraph_zero_based":4744},{"literal_text_all_w_t_and_m_t":"4>if the eventA1 or eventA2 is configured in the corresponding reportConfig:","paragraph_zero_based":4745},{"literal_text_all_w_t_and_m_t":"5>consider only the serving cell to be applicable;","paragraph_zero_based":4746},{"literal_text_all_w_t_and_m_t":"4>if the eventA3 or eventA5 or eventA3H1 or eventA3H2 or eventA5H1 or eventA5H2 is configured in the corresponding reportConfig:","paragraph_zero_based":4747},{"literal_text_all_w_t_and_m_t":"5>if a serving cell is associated with a measObjectNR and neighbours are associated with another measObjectNR, consider any serving cell associated with the other measObjectNR to be a neighbouring cell as well;","paragraph_zero_based":4748},{"literal_text_all_w_t_and_m_t":"4>if the eventX2 is configured in the corresponding reportConfig:","paragraph_zero_based":4749},{"literal_text_all_w_t_and_m_t":"5>consider only the serving L2 U2N Relay UE to be applicable;","paragraph_zero_based":4750},{"literal_text_all_w_t_and_m_t":"4>if corresponding reportConfig includes reportType set to periodical; or","paragraph_zero_based":4751}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["298c2b33120de2a0e13d95091961c4463cb91b78f01b1bf0e3aba72d9c84045f","7fad0a093f093267cdf6dd8f2d655a59436daf4c121b3bf831929dba19c54551","3a5346e49be602e4384bc0268c4b4f8f8cfe2bd7184f5b0ca1503fe9176c4b33","c8ef3fc356a5a08d353a531bf31594eeca63af5d02176acd13a1f5fe1254e800","8d2a1b61398af50353fd2e98536193a40c38c747c341c3a694d9e54d7e19f7dc","565bee091bb746501148e3fd1b34443e1c2b75ff1dc1e2e2dedee151596b5899","e08f80700f2f3458a98dab74525d398d79b6c069180c601b34f1a0b500beb4f6","3c64854ee5ee46dda3131e616958d58a924ca92d7cbe798fdfdf7a2247a64ddb","ef8a2578eccd65e18a7bf6670d7dc0f940aa92bbd71e58246bdd33988e5fc54e","a68fa1e87e407be8f3a6b75b14bd80ee7be96d809203e468c7b30b9307b6c7b7","6a55dd631514de8b296491e48ad15ebadbff453aa3b8995afd9ebc948e12b35c","d116c1689d639bb1e17962c83ad9628429d15b401820c9f979f95b8f8bb156f7","8def7f405a168d3e3be9d9017ad18391e832da90e2a06384d7f2e75da07a1342","34c440fb012496c8ef071428bc9300b23c77423f34941242be2eeb5bebf0ff10","75c0a63a2be0b74f72d75b1f5e2009341dc034387145514b92f6b4b322d9792f","e6f4535a9d7737a74fa362090292b0c9932c9ac2e58df4218acb6655758b159a","cda61447d74e1b6cead28171be9d2b70f51b9113c19cee82b83ee35157d066e8","d96c49bc2db8ec58b9556e7ec77cabe0a56f9c7cb7d7a68a30799ec6c7435f8c","f261eacef6ce9ea1ebc4b5d488f794977b11f546ef31d38d6ee2036f559a19c8","434e3b16a93cc42e53bddf9c0971a0376fb61d2a1242267f3d664eb376356663","1c285d2fcf76207b8b40535dc8cfab14773f99982760e5fb7da29527a17044f7","aac7723a3f34c5f0918f146d89bfd5606f0029f2480bfa7902c498af2a1bf9fe","043c99c15bd1b9edae9f21d6cfdd38890d40bbee770a4b4a7a761dd3a4bb2221","da679600ba3478c1d5f2dc690e20a14fb414546437c91a024d277d358c1c6f21"],"paragraph_range_zero_based":[4728,4751],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p4728"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>for measurement events other than eventA1, eventA2, eventD1, eventX2, eventH1 or eventH2:","paragraph_zero_based":4752},{"literal_text_all_w_t_and_m_t":"5>if useAllowedCellList is set to true:","paragraph_zero_based":4753},{"literal_text_all_w_t_and_m_t":"6>consider any neighbouring cell detected based on parameters in the associated measObjectNR to be applicable when the concerned cell is included in the allowedCellsToAddModList defined within the VarMeasConfig for this measId;","paragraph_zero_based":4754},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":4755},{"literal_text_all_w_t_and_m_t":"6>consider any neighbouring cell detected based on parameters in the associated measObjectNR to be applicable when the concerned cell is not included in the excludedCellsToAddModList defined within the VarMeasConfig for this measId;","paragraph_zero_based":4756},{"literal_text_all_w_t_and_m_t":"4>if the eventH1 or eventH2 is configured in the corresponding reportConfig:","paragraph_zero_based":4757},{"literal_text_all_w_t_and_m_t":"5>for all the events of the same type for which simulMultiTriggerSingleMeasReport is set to true and the entry condition applicable for the event has been satisfied:","paragraph_zero_based":4758},{"literal_text_all_w_t_and_m_t":"6>consider only the event with the smallest value between the altitude of the UE and the corresponding altitude threshold to be applicable;","paragraph_zero_based":4759},{"literal_text_all_w_t_and_m_t":"4>else if the eventA3H1 or eventA3H2 or eventA4H1 or eventA4H2 or eventA5H1 or eventA5H2 is configured in the corresponding reportConfig:","paragraph_zero_based":4760},{"literal_text_all_w_t_and_m_t":"5>for all the events of the same type associated with the same measObjectNR for which simulMultiTriggerSingleMeasReport is set to true and the entry conditions applicable for the event has been satisfied:","paragraph_zero_based":4761},{"literal_text_all_w_t_and_m_t":"6>consider only the event with the smallest value between the altitude of the UE and the corresponding altitude threshold to be applicable;","paragraph_zero_based":4762},{"literal_text_all_w_t_and_m_t":"3>else if the corresponding measObject concerns E-UTRA:","paragraph_zero_based":4763},{"literal_text_all_w_t_and_m_t":"4>if eventB1 or eventB2 is configured in the corresponding reportConfig:","paragraph_zero_based":4764},{"literal_text_all_w_t_and_m_t":"5>consider a serving cell, if any, on the associated E-UTRA frequency as neighbour cell;","paragraph_zero_based":4765},{"literal_text_all_w_t_and_m_t":"4>consider any neighbouring cell detected on the associated frequency to be applicable when the concerned cell is not included in the excludedCellsToAddModListEUTRAN defined within the VarMeasConfig for this measId;","paragraph_zero_based":4766},{"literal_text_all_w_t_and_m_t":"3>else if the corresponding measObject concerns UTRA-FDD:","paragraph_zero_based":4767},{"literal_text_all_w_t_and_m_t":"4>if eventB1-UTRA-FDD or eventB2-UTRA-FDD is configured in the corresponding reportConfig; or","paragraph_zero_based":4768},{"literal_text_all_w_t_and_m_t":"4>if corresponding reportConfig includes reportType set to periodical:","paragraph_zero_based":4769},{"literal_text_all_w_t_and_m_t":"5>consider a neighbouring cell on the associated frequency to be applicable when the concerned cell is included in the cellsToAddModList defined within the VarMeasConfig for this measId;","paragraph_zero_based":4770},{"literal_text_all_w_t_and_m_t":"3>else if the corresponding measObject concerns L2 U2N Relay UE:","paragraph_zero_based":4771},{"literal_text_all_w_t_and_m_t":"4>if eventY1-Relay or eventY2-Relay is configured in the corresponding reportConfig; or","paragraph_zero_based":4772},{"literal_text_all_w_t_and_m_t":"4>if corresponding reportConfig includes reportType set to periodical:","paragraph_zero_based":4773},{"literal_text_all_w_t_and_m_t":"5>consider any L2 U2N Relay UE fulfilling upper layer criteria detected on the associated frequency to be applicable for this measId;","paragraph_zero_based":4774},{"literal_text_all_w_t_and_m_t":"2>else if the corresponding reportConfig includes a reportType set to reportCGI:","paragraph_zero_based":4775}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["fcd2502bc95a319245959a299b9f611f11e4db6472b36a2e2e4265623093c436","0deea783d15baae5b9a72bf1a55f70017c78cddedcff68ef4a40076409895db4","15fcbaf74afd059b5562077a49ebc8e490510d8cd68ff16eec764892c6bde904","04b3b06b24fdc5b426fbf5c118705c709941532e58c929bf01d1d67753bb99ec","ece6ced17d47e6f17decbdf167c07b661fe729db5749f09f22452ffc9cc32706","e49ca12624eed4cd41fea18c77a8fcd67860f3405bec746aa6b9e9a4582b1117","af0787219b5c78cefbf6f576b8adf8a2cfc2ce6be301a8354722d482b4d96b4a","0d3f62ff96447312ad701d34d7df1554547c1192427ecca8263706b172b0d626","3c675bbc67e87e09f4127c5d7d92ce1c35d3547340005110bf7ddb0253e0a626","be0054f8a45bd3ec269a4138cbb82a3068d31fa9be6238b9563f9c9e55a82c72","3e1f5b1ba49424de5407ee72107acfb63d50ce55bd0aaad2e7887827b3a72e19","816f90c68c445eecd8112eb8948e77c17726c1c732d3aa5e3b72bfb8d81e903d","7a0347dc82cb7a33e640f543a2037755666859e2930e434241301719de2320c1","f67fe90fbf7c2526744df4abc6f080a2e6717e0e9fb25fd7cff2128cc0baf90c","f1602c2064a4404b3fae70786e4a0409303537acff336412971a494e6f62f151","732c6beccfeb88239fcfada608e1caf4169a3215d099a20bff43af45bad92be5","ddd7609f76a91675bcf1f5250ffa6d09c43138f21825b790fe47a07c2cf30f9f","9fa7eb9b2b31fffaf8715116bc3ad1365139f7b105fec43940474456740ecc43","8e3f3951941672b6676edc4155a46bae2394b0db952b03ddcccea7dde432e3d8","b4181906b990187a149360ead52792c184e66c8b0cd57b9c8a8f90e644524808","4fdeb9beb053744c4f584ee139077553d686df603e3f762b8454833928ddfe6e","c1cf21deb807bfcaa39f304ed4bbbd4d3501563e53584fa1659b9a0f0d914563","826b27236cc5369e97185733ad59546bcbf03512018a01203c2fa6d00e6622fb","6d706479f833826e90501c9e6441494a7bf8aa9de89eef7f433ce216ff55e76e"],"paragraph_range_zero_based":[4752,4775],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p4752"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>consider the cell detected on the associated measObject which has a physical cell identity matching the value of the cellForWhichToReportCGI included in the corresponding reportConfig within the VarMeasConfig to be applicable;","paragraph_zero_based":4776},{"literal_text_all_w_t_and_m_t":"2>else if the corresponding reportConfig includes a reportType set to reportSFTD:","paragraph_zero_based":4777},{"literal_text_all_w_t_and_m_t":"3>if the corresponding measObject concerns NR:","paragraph_zero_based":4778},{"literal_text_all_w_t_and_m_t":"4>if the reportSFTD-Meas is set to true:","paragraph_zero_based":4779},{"literal_text_all_w_t_and_m_t":"5>consider the NR PSCell to be applicable;","paragraph_zero_based":4780},{"literal_text_all_w_t_and_m_t":"4>else if the reportSFTD-NeighMeas is included:","paragraph_zero_based":4781},{"literal_text_all_w_t_and_m_t":"5>if cellsForWhichToReportSFTD is configured in the corresponding reportConfig:","paragraph_zero_based":4782},{"literal_text_all_w_t_and_m_t":"6>consider any NR neighbouring cell detected on the associated measObjectNR which has a physical cell identity that is included in the cellsForWhichToReportSFTD to be applicable;","paragraph_zero_based":4783},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":4784},{"literal_text_all_w_t_and_m_t":"6>consider up to 3 strongest NR neighbouring cells detected based on parameters in the associated measObjectNR to be applicable when the concerned cells are not included in the excludedCellsToAddModList defined within the VarMeasConfig for this measId;","paragraph_zero_based":4785},{"literal_text_all_w_t_and_m_t":"3>else if the corresponding measObject concerns E-UTRA:","paragraph_zero_based":4786},{"literal_text_all_w_t_and_m_t":"4>if the reportSFTD-Meas is set to true:","paragraph_zero_based":4787},{"literal_text_all_w_t_and_m_t":"5>consider the E-UTRA PSCell to be applicable;","paragraph_zero_based":4788},{"literal_text_all_w_t_and_m_t":"2>else if the corresponding reportConfig includes a reportType set to cli-Periodical or cli-EventTriggered:","paragraph_zero_based":4789},{"literal_text_all_w_t_and_m_t":"3>consider all CLI measurement resources included in the corresponding measObject to be applicable;","paragraph_zero_based":4790},{"literal_text_all_w_t_and_m_t":"2>else if the corresponding reportConfig includes a reportType set to rxTxPeriodical:","paragraph_zero_based":4791},{"literal_text_all_w_t_and_m_t":"3>consider all Rx-Tx time difference measurement resources included in the corresponding measObject to be applicable;","paragraph_zero_based":4792},{"literal_text_all_w_t_and_m_t":"2>if the corresponding reportConfig concerns the reporting for NR sidelink communication/discovery (i.e. reportConfigNR-SL):","paragraph_zero_based":4793},{"literal_text_all_w_t_and_m_t":"3>consider the transmission resource pools indicated by the tx-PoolMeasToAddModList defined within the VarMeasConfig for this measId to be applicable;","paragraph_zero_based":4794},{"literal_text_all_w_t_and_m_t":"2>if the reportType is set to eventTriggered, and if the corresponding reportConfig does not include numberOfTriggeringCells, and if the entry condition applicable for this event, i.e. the event corresponding with the eventId of the corresponding reportConfig within VarMeasConfig, is fulfilled for one or more applicable cells for all measurements after layer 3 filtering taken during timeToTrigger defined for this event within the VarMeasConfig, while the VarMeasReportList does not include a measurement reporting entry for this measId (a first cell triggers the event):","paragraph_zero_based":4795},{"literal_text_all_w_t_and_m_t":"3>include a measurement reporting entry within the VarMeasReportList for this measId;","paragraph_zero_based":4796},{"literal_text_all_w_t_and_m_t":"3>set the numberOfReportsSent defined within the VarMeasReportList for this measId to 0;","paragraph_zero_based":4797},{"literal_text_all_w_t_and_m_t":"3>include the concerned cell(s) in the cellsTriggeredList defined within the VarMeasReportList for this measId;","paragraph_zero_based":4798},{"literal_text_all_w_t_and_m_t":"3>if useT312 is set to true in reportConfig for this event:","paragraph_zero_based":4799}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["2db859c1e2a4794829fa73ed15b6ae02340d411447e2b3490c60359bdf78f221","6738c396aaafc8c4a5cf0ad4c2c63eaf80a31577c760643ab4e1256949b9e11e","5453b6814bd0ceee3ece9838706369684188fb618cbf6d5f6295886040719834","1680fd14f688aa42ff3b7a5e28fdb4a2bffb4fb1604bf7a42f90a1fdf219e618","d51820c318246ac6e76f2410baf8926f4c06f52b93cc82b2ae661c513efa668a","08f3ca6dd9801c79f914b1193141c51d55e8bf0de491ccde5e030eb52a02adf8","b9ad17ef8f8489322f836b85819b2836f5f594e78a9142fbba1accdd3d7a573a","7fd284c3567be3aec8d9fc277cf03f49c74dd7792301884fcf6a922671c1934e","59003df111cc72615f9189f64462420f0fde7d2b3f7eb30fa7704de12bf499e7","2803cc426df770d576195e5f5f9e71c803e088ab1455557d5f1a1be5920450ea","4e5ad0dd72e62f8afb0b3135d1b493728ce35fea5e9cc5b8898c268f8d375e11","0aefb2d987b895261196579f20d4a5a4fb0cc2c4c4e0bc44075910c662ea4430","1fa2ad8c0c919dd083e81740b7ad24ddcda50279af0f49c76a65d0dcf91b5a9d","e7d7c54aeb6d57be3a8a38ecb623774762d79227c25125febe89fed11ce4edbf","a4865a9a14dcc154e382fec9ee44e1bfea3cc16192565c8221dc730d5412a9bb","2df27261d7f8611c8f7c175f39d1e6ced6a315873866faad1d18ab6c06473816","07689fb4fcbb228a06e2fc03525d5fc93e75a95f85f8760d141e57777e5ad883","423eaac2a2a2f8cc48d0741f80d5951bc7698413a7b484a73dc10399bf1ecb61","04c