{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-IABOTHERINFORMATION-STOP","paragraph_zero_based":9288},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":9289},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9290},{"literal_text_all_w_t_and_m_t":"IABOtherInformation-IEs field descriptions","paragraph_zero_based":9291},{"literal_text_all_w_t_and_m_t":"iab-IPv4-AddressNumReq","paragraph_zero_based":9292},{"literal_text_all_w_t_and_m_t":"This field is used to request the numbers of IPv4 address per specific usage. The specific usages include F1-C traffic, F1-U traffic, non-F1 traffic and all traffic.","paragraph_zero_based":9293},{"literal_text_all_w_t_and_m_t":"iab-IPv4-AddressReport","paragraph_zero_based":9294},{"literal_text_all_w_t_and_m_t":"This field is used to report the IPv4 address per specific usage assigned by OAM for IAB-DU. The specific usages include F1-C traffic, F1-U traffic, non-F1 traffic and all traffic.","paragraph_zero_based":9295},{"literal_text_all_w_t_and_m_t":"iab-IPv6-AddressNumReq","paragraph_zero_based":9296},{"literal_text_all_w_t_and_m_t":"This field is used to request the numbers of IPv6 address per specific usage. The specific usages include F1-C traffic, F1-U traffic, non-F1 traffic and all traffic.","paragraph_zero_based":9297},{"literal_text_all_w_t_and_m_t":"iab-IPv6-AddressPrefixReq","paragraph_zero_based":9298},{"literal_text_all_w_t_and_m_t":"This field is used to request the prefix of IPv6 address per specific usage. The specific usages include F1-C traffic, F1-U traffic, non-F1 traffic and all traffic.","paragraph_zero_based":9299},{"literal_text_all_w_t_and_m_t":"iab-IPv6-AddressReport","paragraph_zero_based":9300},{"literal_text_all_w_t_and_m_t":"This field is used to report the IPv6 address per specific usage assigned by OAM for IAB-DU. The specific usages include F1-C traffic, F1-U traffic, non-F1 traffic and all traffic.","paragraph_zero_based":9301},{"literal_text_all_w_t_and_m_t":"iab-IPv6-PrefixReport","paragraph_zero_based":9302},{"literal_text_all_w_t_and_m_t":"This field is used to report the prefix of IPv6 address per specific usage assigned by OAM for IAB-DU. The specific usages include F1-C traffic, F1-U traffic, non-F1 traffic and all traffic.","paragraph_zero_based":9303},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9304},{"literal_text_all_w_t_and_m_t":"IAB-IP-AddressNumReq-IEs field descriptions","paragraph_zero_based":9305},{"literal_text_all_w_t_and_m_t":"all-Traffic-NumReq","paragraph_zero_based":9306},{"literal_text_all_w_t_and_m_t":"This field is used to request the numbers of IP address for all traffic.","paragraph_zero_based":9307},{"literal_text_all_w_t_and_m_t":"f1-C-Traffic-NumReq","paragraph_zero_based":9308},{"literal_text_all_w_t_and_m_t":"This field is used to request the numbers of IP address for F1-C traffic.","paragraph_zero_based":9309},{"literal_text_all_w_t_and_m_t":"f1-U-Traffic-NumReq","paragraph_zero_based":9310},{"literal_text_all_w_t_and_m_t":"This field is used to request the numbers of IP address for F1-U traffic.","paragraph_zero_based":9311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["0cf9910d79c807a585a606b36f189fc30b85b9428e150082b0cfa3318d8901e3","a6d60476de2dfb55f20f717f44d7101bb3cc965fa7a96326f14d16d77c5a475f","15615d721be951831048812aa3100c2041b7202ba0da30e9de635d6db7b04f1a","7cbec6711dc4739f72299e079441ca23b9adf1686e4c5c6d31e61851613ab5ca","5f44fcbfb5338896e3707a026bbb282af32df87a25e441a05ef45e8b94ac377b","b031126718ae3bb3ed87bd3d00fb755915e