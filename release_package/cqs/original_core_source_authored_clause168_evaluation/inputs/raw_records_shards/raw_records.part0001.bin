{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    carrierBandwidthDL                  ENUMERATED {n6, n15, n25, n50, n75, n100, spare2, spare1},","paragraph_zero_based":25632},{"literal_text_all_w_t_and_m_t":"    mbsfn-SubframeConfigList            EUTRA-MBSFN-SubframeConfigList                                          OPTIONAL,   -- Need M","paragraph_zero_based":25633},{"literal_text_all_w_t_and_m_t":"    nrofCRS-Ports                       ENUMERATED {n1, n2, n4},","paragraph_zero_based":25634},{"literal_text_all_w_t_and_m_t":"    v-Shift                             ENUMERATED {n0, n1, n2, n3, n4, n5}","paragraph_zero_based":25635},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25636},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25637},{"literal_text_all_w_t_and_m_t":"LTE-CRS-PatternList-r16 ::=         SEQUENCE (SIZE (1..maxLTE-CRS-Patterns-r16)) OF RateMatchPatternLTE-CRS","paragraph_zero_based":25638},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25639},{"literal_text_all_w_t_and_m_t":"-- TAG-RATEMATCHPATTERNLTE-CRS-STOP","paragraph_zero_based":25640},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":25641},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25642},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25643},{"literal_text_all_w_t_and_m_t":"RateMatchPatternLTE-CRS field descriptions","paragraph_zero_based":25644},{"literal_text_all_w_t_and_m_t":"carrierBandwidthDL","paragraph_zero_based":25645},{"literal_text_all_w_t_and_m_t":"BW of the LTE carrier in number of PRBs (see TS 38.214 [19], clause 5.1.4.2).","paragraph_zero_based":25646},{"literal_text_all_w_t_and_m_t":"carrierFreqDL","paragraph_zero_based":25647},{"literal_text_all_w_t_and_m_t":"Center of the LTE carrier (see TS 38.214 [19], clause 5.1.4.2).","paragraph_zero_based":25648},{"literal_text_all_w_t_and_m_t":"mbsfn-SubframeConfigList","paragraph_zero_based":25649},{"literal_text_all_w_t_and_m_t":"LTE MBSFN subframe configuration (see TS 38.214 [19], clause 5.1.4.2).","paragraph_zero_based":25650},{"literal_text_all_w_t_and_m_t":"nrofCRS-Ports","paragraph_zero_based":25651},{"literal_text_all_w_t_and_m_t":"Number of LTE CRS antenna port to rate-match around (see TS 38.214 [19], clause 5.1.4.2).","paragraph_zero_based":25652},{"literal_text_all_w_t_and_m_t":"v-Shift","paragraph_zero_based":25653},{"literal_text_all_w_t_and_m_t":"Shifting value v-shift in LTE to rate match around LTE CRS (see TS 38.214 [19], clause 5.1.4.2).","paragraph_zero_based":25654},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25655}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["d3741c11a2800dd0b3710080fc994468d1abef17b2761316748fcc5951624a3f","ec04682aacf87296fae9952fb74f42bac360a500208ce9812c79d0f2616edf1a","4b212568b9a7a9db7971b4a184f3f87385c9bfdb251622fae3b1f35d5a1ea78c","7bc07ff3125ade4a0bc88b872d28f049e626b4f2daacd94b88c9cf3511cc4185","bcfad23e7f243ef81663fbca1942bd65fc1a64cf23cc324ba35f36bc5ee0875a","4b29ffbee9b340802b3577040b3653af2fb4c851474e5a0d661521d04fd1aaf0","ac0ffbd113c3c104cc1a61c1756591cfe34d9291b6cf283da6ba2b1ba698ce1f","6aa3fa711af3366ebcbf541a1b98e4f058e8f0794d30c9bb82e66f0f3b980a34","89c5f598e11ccdb2256f1338b52584026b1ca4ff00a37d2766c5afe312b0b33c","1777e7e9a1c8e8d41ed09f867e9a9c520007d9382216a2bec6b82cd9d5e19539","4bdd2537b364eee3a03743428e001e40705bea329d23c442f905d290ec878100","3da2785ce1d81877efcb47052f9b0c7b8fef7f0275fc43acb07a7f944ae0bf37","59ce0790740ac873f9ce5796b468d6b2560adaef149c6686882281fe4023cbf3","99ed0332dcad79904a