{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the value for timer T400 as described in clause 7.1. Value ms100 corresponds to 100 ms, value ms200 corresponds to 200 ms and so on.","paragraph_zero_based":13656},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13657},{"literal_text_all_w_t_and_m_t":"–SIB13","paragraph_zero_based":13658},{"literal_text_all_w_t_and_m_t":"SIB13 contains configurations of V2X sidelink communication defined in TS 36.331 [10].","paragraph_zero_based":13659},{"literal_text_all_w_t_and_m_t":"SIB13 information element","paragraph_zero_based":13660},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":13661},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB13-START","paragraph_zero_based":13662},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13663},{"literal_text_all_w_t_and_m_t":"SIB13-r16 ::=                       SEQUENCE {","paragraph_zero_based":13664},{"literal_text_all_w_t_and_m_t":"    sl-V2X-ConfigCommon-r16             OCTET STRING,","paragraph_zero_based":13665},{"literal_text_all_w_t_and_m_t":"    dummy                               OCTET STRING,","paragraph_zero_based":13666},{"literal_text_all_w_t_and_m_t":"    tdd-Config-r16                      OCTET STRING,","paragraph_zero_based":13667},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension            OCTET STRING                          OPTIONAL,","paragraph_zero_based":13668},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":13669},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":13670},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13671},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB13-STOP","paragraph_zero_based":13672},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":13673},{"literal_text_all_w_t_and_m_t":"","paragr