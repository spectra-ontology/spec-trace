E and RRC_CONNECTED states for NR and RRC_IDLE and RRC_CONNECTED for E-UTRA.","paragraph_zero_based":36995},{"literal_text_all_w_t_and_m_t":"VisitedCellInfoList information element","paragraph_zero_based":36996},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36997},{"literal_text_all_w_t_and_m_t":"-- TAG-VISITEDCELLINFOLIST-START","paragraph_zero_based":36998},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36999},{"literal_text_all_w_t_and_m_t":"VisitedCellInfoList-r16 ::= SEQUENCE (SIZE (1..maxCellHistory-r16)) OF VisitedCellInfo-r16","paragraph_zero_based":37000},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37001},{"literal_text_all_w_t_and_m_t":"VisitedCellInfo-r16 ::=  SEQUENCE {","paragraph_zero_based":37002},{"literal_text_all_w_t_and_m_t":"    visitedCellId-r16        CHOICE {","paragraph_zero_based":37003},{"literal_text_all_w_t_and_m_t":"        nr-CellId-r16            CHOICE {","paragraph_zero_based":37004},{"literal_text_all_w_t_and_m_t":"            cgi-Info                 CGI-Info-Logging-r16,","paragraph_zero_based":37005},{"literal_text_all_w_t_and_m_t":"            pci-arfcn-r16            PCI-ARFCN-NR-r16","paragraph_zero_based":37006},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":37007}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["d03d0dc78fa82a38002202a65bf363eb70b37b40c870a235ffb87f549874c324","58f270b39b9e0951770777b25e5a528e3e6f6ed3648882cc936d0cbe66fc2afe","ea234690e5cd7ace4147400ab7760e4825f508cddf9d1a291f225a891a962116","d1128d4515b2f04e3d7fff369d17ac3325e1747f874cc880a03f75909b23a0b9","dafb5214f486dea5ae09ea79b4101f14b82ffd8d8ffe70bf78ff13bcb0ffdecb","69f52ff4b3f40c2a