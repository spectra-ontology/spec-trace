{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"plmn-Identity-eutra-epc, plmn-Identity-eutra-5GC","paragraph_zero_based":15984},{"literal_text_all_w_t_and_m_t":"Identifies the PLMN of the cell for the reported cellIdentity: the first PLMN entry of plmn-IdentityList (when connected to EPC) or of plmn-IdentityList-r15 (when connected to 5GC) in SystemInformationBlockType1 that contained the reported cellIdentity.","paragraph_zero_based":15985},{"literal_text_all_w_t_and_m_t":"trackingAreaCode-eutra-epc, trackingAreaCode-eutra-5gc","paragraph_zero_based":15986},{"literal_text_all_w_t_and_m_t":"Indicates Tracking Area Code to which the cell indicated by cellIdentity-eutra-epc, cellIdentity-eutra-5GC belongs.","paragraph_zero_based":15987},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15988},{"literal_text_all_w_t_and_m_t":"–CGI-InfoNR","paragraph_zero_based":15989},{"literal_text_all_w_t_and_m_t":"The IE CGI-InfoNR indicates cell access related information, which is reported by the UE as part of report CGI procedure.","paragraph_zero_based":15990},{"literal_text_all_w_t_and_m_t":"CGI-InfoNR information element","paragraph_zero_based":15991},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":15992},{"literal_text_all_w_t_and_m_t":"-- TAG-CGI-INFO-NR-START","paragraph_zero_based":15993},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15994},{"literal_text_all_w_t_and_m_t":"CGI-InfoNR ::=                    SEQUENCE {","paragraph_zero_based":15995},{"literal_text_all_w_t_and_m_t":"    plmn-IdentityInfoList               PLMN-IdentityInfoList               OPTIONAL,","paragraph_zero_based":15996},{"literal_text_all_w_t_and_m_t":"    frequencyBandList                   MultiFrequencyBandListNR            OPTIONAL,","paragraph_zero_based":15997},{"literal_text_all_w_t_and_m_t":"    noSIB1    