{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"OFDM symbol location of the CLI-RSSI resource within a slot.","paragraph_zero_based":19848},{"literal_text_all_w_t_and_m_t":"startPRB","paragraph_zero_based":19849},{"literal_text_all_w_t_and_m_t":"Starting PRB index of the measurement bandwidth. For the case where the reference subcarrier spacing is smaller than subcarrier spacing of active DL BWP(s), network configures startPRB and nrofPRBs are as a multiple of active BW SCS divided by reference SCS.","paragraph_zero_based":19850},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19851},{"literal_text_all_w_t_and_m_t":"–MeasObjectEUTRA","paragraph_zero_based":19852},{"literal_text_all_w_t_and_m_t":"The IE MeasObjectEUTRA specifies information applicable for EUTRA cells.","paragraph_zero_based":19853},{"literal_text_all_w_t_and_m_t":"MeasObjectEUTRA information element","paragraph_zero_based":19854},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":19855},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASOBJECTEUTRA-START","paragraph_zero_based":19856},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19857},{"literal_text_all_w_t_and_m_t":"MeasObjectEUTRA::=                          SEQUENCE {","paragraph_zero_based":19858},{"literal_text_all_w_t_and_m_t":"    carrierFreq                                 ARFCN-ValueEUTRA,","paragraph_zero_based":19859},{"literal_text_all_w_t_and_m_t":"    allowedMeasBandwidth                        EUTRA-AllowedMeasBandwidth,","paragraph_zero_based":19860},{"literal_text_all_w_t_and_m_t":"    cellsToRemoveListEUTRAN                     EUTRA-CellIndexList                                         OPTIONAL,    -- Need N","paragraph_zero_based":19861},{"literal_text_all_w_t_and_m_t":"    cellsToAddModListEUTRAN                     SEQUENCE (SIZE (1..maxCellMeasEUTRA)) OF EUTRA-Cell         OPTIONAL,    -- Need N","paragraph_zero_based":19862},{"literal_text_all_w_t_and_m_t":"    excludedCellsToRemoveListEUTRAN             EUTRA-CellIndexList                                         OPTIONAL,    -- Need N","paragraph_zero_based":19863},{"literal_text_all_w_t_and_m_t":"    excludedCellsToAddModListEUTRAN             SEQUENCE (SIZE (1..maxCellMeasEUTRA)) OF EUTRA-ExcludedCell    OPTIONAL,    -- Need N","paragraph_zero_based":19864},{"literal_text_all_w_t_and_m_t":"    eutra-PresenceAntennaPort1                  EUTRA-PresenceAntennaPort1,","paragraph_zero_based":19865},{"literal_text_all_w_t_and_m_t":"    eutra-Q-OffsetRange                         EUTRA-Q-OffsetRange                                         OPTIONAL,    -- Need R","paragraph_zero_based":19866},{"literal_text_all_w_t_and_m_t":"    widebandRSRQ-Meas                           BOOLEAN,","paragraph_zero_based":19867},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":19868},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":19869},{"literal_text_all_w_t_and_m_t":"    associatedMeasGap-r17                       MeasGapId-r17                                               OPTIONAL     -- Need R","paragraph_zero_based":19870},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":19871}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["f46d386611587ae91cf51084460a13281ddddabe041d203e0b4fa9ff917887fa","abd987965d29dd1daa19c2d7f52556ee80fa7877a3f426a6292ecf91a2c78a83","cdacf5d130c71b35a52d61f9eed6c117de9da842b7881a08f3229d73f5643f57","79f933e3c40d9ccee8221ef7a11c6e43b4c9e020f1c47d5cd8d538b6bd7aeee2","145c2a733e4b48008861142ebab1db6be3af9b8e