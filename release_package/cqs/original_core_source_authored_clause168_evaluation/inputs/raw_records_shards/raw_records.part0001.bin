{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-SL-DRX-CONFIGUCSEMISTATIC-STOP","paragraph_zero_based":38136},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":38137},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38138},{"literal_text_all_w_t_and_m_t":"–SL-FreqConfig","paragraph_zero_based":38139},{"literal_text_all_w_t_and_m_t":"The IE SL-FreqConfig specifies the dedicated configuration information on one particular carrier frequency for NR sidelink communication.","paragraph_zero_based":38140},{"literal_text_all_w_t_and_m_t":"SL-FreqConfig information element","paragraph_zero_based":38141},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":38142},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-FREQCONFIG-START","paragraph_zero_based":38143},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38144},{"literal_text_all_w_t_and_m_t":"SL-FreqConfig-r16 ::=              SEQUENCE {","paragraph_zero_based":38145},{"literal_text_all_w_t_and_m_t":"    sl-Freq-Id-r16                     SL-Freq-Id-r16,","paragraph_zero_based":38146},{"literal_text_all_w_t_and_m_t":"    sl-SCS-SpecificCarrierList-r16     SEQUENCE (SIZE (1..maxSCSs)) OF SCS-SpecificCarrier,","paragraph_zero_based":38147},{"literal_text_all_w_t_and_m_t":"    sl-AbsoluteFrequencyPointA-r16     ARFCN-ValueNR                                                   OPTIONAL,  -- Need M","paragraph_zero_based":38148},{"literal_text_all_w_t_and_m_t":"    sl-AbsoluteFrequencySSB-r16        ARFCN-ValueNR                                                   OPTIONAL,  -- Need R","paragraph_zero_based":38149},{"literal_text_all_w_t_and_m_t":"    frequencyShift7p5khzSL-r16         ENUMERATED {true}                                               OPTIONAL,  -- Cond V2X-SL-Shared","paragraph_zero_based":38150},{"literal_text_all_w_t_and_m_t":"    valueN-r16                         INTEGER (-1..1),","paragraph_zero_based":38151},{"literal_text_all_w_t_and_m_t":"    sl-BWP-ToReleaseList-r16           SEQUENCE (SIZE (1..maxNrofSL-BWPs-r16)) OF BWP-Id               OPTIONAL,  -- Need N","paragraph_zero_based":38152},{"literal_text_all_w_t_and_m_t":"    sl-BWP-ToAddModList-r16            SEQUENCE (SIZE (1..maxNrofSL-BWPs-r16)) OF SL-BWP-Config-r16    OPTIONAL,  -- Need N","paragraph_zero_based":38153},{"literal_text_all_w_t_and_m_t":"    sl-SyncConfigList-r16              SL-SyncConfigList-r16                                           OPTIONAL,  -- Need M","paragraph_zero_based":38154},{"literal_text_all_w_t_and_m_t":"    sl-SyncPriority-r16                ENUMERATED {gnss, gnbEnb}                                       OPTIONAL   -- Need M","paragraph_zero_based":38155},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":38156},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38157},{"literal_text_all_w_t_and_m_t":"SL-Freq-Id-r16 ::=                     INTEGER (1.. maxNrofFreqSL-r16)","paragraph_zero_based":38158},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38159}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["42f26f348a8011ba9db205f3ab74c489fc249a74be1bd5f5c1ddb3d58f73ff64","543219b89ced2b956f6612045ee71c73d49dc4b2da3ad34abc367e2bea1b5967","610eb6edd8fa01d08371ea98321e80005c209952733f0724f7a27929bd920f35","3133cf96e33f2970782d1ee6e940dcee03fa1510dadc4d8985b9e18004e01479","ef802c28745df4f14bffd45becf1da7d18c9dcc057f3aedf6c3cda6bdbd38da8","222a7a64abddd0e99e86aab65066316202a2a4ce320650d95f867d804c27cdb4","89e18734db54aad0c459943f5f50737d909c4ba1b473ebc5faa2df7d8c0e2a88