{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    tag-ToReleaseList                   SEQUENCE (SIZE (1..maxNrofTAGs)) OF TAG-Id                          OPTIONAL,   -- Need N","paragraph_zero_based":29520},{"literal_text_all_w_t_and_m_t":"    tag-ToAddModList                    SEQUENCE (SIZE (1..maxNrofTAGs)) OF TAG                             OPTIONAL    -- Need N","paragraph_zero_based":29521},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29522},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29523},{"literal_text_all_w_t_and_m_t":"TAG ::=                             SEQUENCE {","paragraph_zero_based":29524},{"literal_text_all_w_t_and_m_t":"    tag-Id                              TAG-Id,","paragraph_zero_based":29525},{"literal_text_all_w_t_and_m_t":"    timeAlignmentTimer                  TimeAlignmentTimer,","paragraph_zero_based":29526},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":29527},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29528},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29529},{"literal_text_all_w_t_and_m_t":"TAG-Id ::=                          INTEGER (0..maxNrofTAGs-1)","paragraph_zero_based":29530},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29531},{"literal_text_all_w_t_and_m_t":"-- TAG-TAG-CONFIG-STOP","paragraph_zero_based":29532},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29533},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29534},{"literal_text_all_w_t_and_m_t":"TAG field descriptions","paragraph_zero_based":29535},{"literal_text_all_w_t_and_m_t":"tag-Id","paragraph_zero_based":29536},{"literal_text_all_w_t_and_m_t":"Indicates the TAG of the SpCell or an SCell, see TS 38.321 [3]. Uniquely identifies the TAG within the scope of a Cell Group (i.e. MCG or SCG).","paragraph_zero_based":29537},{"literal_text_all_w_t_and_m_t":"timeAlignmentTimer","paragraph_zero_based":29538},{"literal_text_all_w_t_and_m_t":"The timeAlignmentTimer for TAG with ID tag-Id, as specified in TS 38.321 [3].","paragraph_zero_based":29539},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29540},{"literal_text_all_w_t_and_m_t":"–TAR-Config","paragraph_zero_based":29541},{"literal_text_all_w_t_and_m_t":"The IE TAR-Config is used to configure Timing Advance reporting in non-terrestrial networks.","paragraph_zero_based":29542},{"literal_text_all_w_t_and_m_t":"TAR-Config information element","paragraph_zero_based":29543}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["65e90688f21612d8b50bf7f0a8b6a51606ba0a3d43fb601763e50b397991e30d","d5e6928ca8aa7b8f7d81c13d55daec48616ea7c8df48c9aede06b436f90a865f","487ab2d7d1274cdacc697f104c5dbf61b3a32dee1d1a2105b129294f9d278daf","05a6aafef3ca76be8ec5edfddb68dea69ebe4f1789d8ee0acfe7bda30f7169dc","a5cd963e9dca33f93bf253c121ff8656f823fb66f02d8655c0482ddae710e041","ab208c16b2990ff6fb8eb721d958663cb373fca8354d91575fffc23eec0dc402","78b91e33e45e83a5b4fb817d9bbba7ae364e5ab816ee0407d2ad6fe9b9668c8c","40910f6a38db841c4af2e45db3e8f27f7d6677c3f5dd4b77e1dd2563c6818f2b","65fcf94ce742e04bb14f3d589a878112ce8d7e437390aacea3b01c58a6131868","ef32caf2c6d21f1debb171f49aca54f55177f1d048399bf5426e8fc30306bb69","551bb93f3d4ac7655b8344ca4604a1842db0c66b196f111d73957849b9a4847a","c0f8549381b25e521b0db48ebf83ac5f901d15a2f3a02a2e44c2aa2c67c38a49","b8b308a5d0f9efceb56ad8a0d7f6c53541d89e3320fcf04044ff80f9e7981a65","3fa96580e6040cd3c33aa6599dec0ca9b241e4d312ff8e8d87e48cf1090bf052","ea2558a4b16b4ace8ca451f960dc7da2c76d835fdba86383181bc7ad02551526","dba5d1e