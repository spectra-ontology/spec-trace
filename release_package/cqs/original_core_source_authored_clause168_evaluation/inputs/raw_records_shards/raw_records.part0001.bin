{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-MEASOBJECTUTRA-FDD-STOP","paragraph_zero_based":20064},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":20065},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20066},{"literal_text_all_w_t_and_m_t":"MeasObjectUTRA-FDD field descriptions","paragraph_zero_based":20067},{"literal_text_all_w_t_and_m_t":"carrierFreq","paragraph_zero_based":20068},{"literal_text_all_w_t_and_m_t":"Identifies UTRA-FDD carrier frequency for which this configuration is valid. NR does not configure more than one measurement object for the same physical frequency regardless of the ARFCN used to indicate this.","paragraph_zero_based":20069},{"literal_text_all_w_t_and_m_t":"cellIndexUTRA-FDD","paragraph_zero_based":20070},{"literal_text_all_w_t_and_m_t":"Entry index in the neighbouring cell list.","paragraph_zero_based":20071},{"literal_text_all_w_t_and_m_t":"cellsToAddModList","paragraph_zero_based":20072},{"literal_text_all_w_t_and_m_t":"List of UTRA-FDD cells to add/modify in the neighbouring cell list.","paragraph_zero_based":20073},{"literal_text_all_w_t_and_m_t":"cellsToRemoveList","paragraph_zero_based":20074},{"literal_text_all_w_t_and_m_t":"List of cells to remove from the neighbouring cell list.","paragraph_zero_based":20075},{"literal_text_all_w_t_and_m_t":"utra-FDD-Q-OffsetRange","paragraph_zero_based":20076},{"literal_text_all_w_t_and_m_t":"Used to indicate a frequency specific offset to be applied when evaluating triggering conditions for measurement reporting. The value is in dB.","paragraph_zero_based":20077},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20078},{"literal_text_all_w_t_and_m_t":"–MeasResultCellListSFTD-NR","paragraph_zero_based":20079},{"literal_text_all_w_t_and_m_t":"The IE MeasResultCellListSFTD-NR consists of SFN a