{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        ...,","paragraph_zero_based":18000},{"literal_text_all_w_t_and_m_t":"        [[","paragraph_zero_based":18001},{"literal_text_all_w_t_and_m_t":"        dmrs-UplinkTransformPrecoding-r16   SetupRelease {DMRS-UplinkTransformPrecoding-r16}                OPTIONAL    -- Need M","paragraph_zero_based":18002},{"literal_text_all_w_t_and_m_t":"        ]]","paragraph_zero_based":18003},{"literal_text_all_w_t_and_m_t":"    }                                                                                                       OPTIONAL,   -- Need R","paragraph_zero_based":18004},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":18005},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18006},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18007},{"literal_text_all_w_t_and_m_t":"DMRS-UplinkTransformPrecoding-r16  ::=  SEQUENCE {","paragraph_zero_based":18008},{"literal_text_all_w_t_and_m_t":"    pi2BPSK-ScramblingID0                   INTEGER(0..65535)                                               OPTIONAL,   -- Need S","paragraph_zero_based":18009},{"literal_text_all_w_t_and_m_t":"    pi2BPSK-ScramblingID1                   INTEGER(0..65535)                                               OPTIONAL    -- Need S","paragraph_zero_based":18010},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18011},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18012},{"literal_text_all_w_t_and_m_t":"-- TAG-DMRS-UPLINKCONFIG-STOP","paragraph_zero_based":18013},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18014},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18015},{"literal_text_all_w_t_and_m_t":"DMRS-UplinkConfig field descriptions","paragraph_zero_based":18016},{"literal_text_all_w_t_and_m_t":"dmrs-AdditionalPosition","paragraph_zero_based":18017},{"literal_text_all_w_t_and_m_t":"Position for additional DM-RS in UL (see TS 38.211 [16], clause 6.4.1.1.3). If the field is absent, the UE applies the value pos2. See also clause 6.4.1.1.3 for additional constraints on how the network may set this field depending on the setting of other fields.","paragraph_zero_based":18018},{"literal_text_all_w_t_and_m_t":"dmrs-Type","paragraph_zero_based":18019},{"literal_text_all_w_t_and_m_t":"Selection of the DMRS type to be used for UL (see TS 38.211 [16], clause 6.4.1.1.3) If the field is absent, the UE uses DMRS type 1.","paragraph_zero_based":18020},{"literal_text_all_w_t_and_m_t":"dmrs-Uplink","paragraph_zero_based":18021},{"literal_text_all_w_t_and_m_t":"This field indicates whether low PAPR DMRS is used, as specified in TS38.211 [16], clause 6.4.1.1.1.1.","paragraph_zero_based":18022},{"literal_text_all_w_t_and_m_t":"dmrs-UplinkTransformPrecoding","paragraph_zero_based":18023}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["3f5bb3b72d09490f3a1efadec6f1bf0f8b87aceb50e85e0dfc14595920a42214","7a7b0f7b3af1b32552b16be99352cd966ada3adcfe497dd61385ea3654d18356","61ec1a68e8c3f72e01322c7c998299611cc3ac4f7b9e87dedfbbc6b258275605","45eb2a122f561faf92401593b339d21e22354b86010d940c8277113ef889822b","8b2de12b4cd3b003688da9ca70a1e0790e4e85c29838800a8c67a5fd337037f7","66fce703a2fdc8ccbd1ae26b45ce1ff9f938a41464983153d443b73458360487","9d804b0db47fe372664e22bbba922d0dc188d5808f1892ac3b9b401386a1de45","02d287f84cc182c66bafd67f550ed7cf09bff93123cf89e9ec945f4a1b999843","2965a44c845e1234fa31e35fcdba3cc3c9730a756a195b28ca19364325bd5dc3","a28260442116422028b51e0ec3917dcf139e8a4399a7a15ada858f9ceb3bf969","e6116b4aa07915f2f68ac4c01d8d266ed8328e33cecb5591d92681e9bd18dc7d","f77737337799f9362bca138bad6bb0406f539b2980730c1cf8056b0130920491","128b79746da554936f32fd109cd1198d97b386894c4c5fafe968017619336a7a","80cb46060a79f181117e439136cb8e4cc9836b2ea12de7302424c44b1a006648","6a294fcf1f1719324f2ff1477d07327c1480815f43055a52c967237095dcca8b","1aafcdc6e269844716d57bc83232370b5510445bc85a287e2d9099017132513b","4cd365b9f22a13ef587b1836e31db143378c1b03faffdbadd3bec9aecbd56eff","0949e4a56d0b02db64efc2c7c1cef3d883bdbed718bd1617f8e70532e1661db5","93fa233f0749d332d6c204dda42e918598d77701c7898e6eb2a4c35209b7af2f","97cf18e27db45bc416271c5b0b7a91b58b4bc9b85d065c21ea3e7bd0499bc219","92d1ddb4be1d3737b54791fc6161480a3649288eeb8dab2910519dad0c56f82c","f0677be7772afb2d994fb933f6f3dd0c90afedb9ca21b935bf4c50aa7b57a7ac","a5e6154399b4e0b9c939511cc59349e578bc989e41a2d83d4436335b53bcd508","2b800d9150ee71b47f139cb4d2b82f63bd4970f4680e4223455a68a20a02733e"],"paragraph_range_zero_based":[18000,18023],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p18000"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field indicates whether low PAPR DMRS is used for PUSCH with pi/2 BPSK modulation, as specified in TS38.211 [16], clause 6.4.1.1.1.2. The network configures this field only if tp-pi2BPSK is configured in PUSCH-Config.","paragraph_zero_based":18024},{"literal_text_all_w_t_and_m_t":"maxLength","paragraph_zero_based":18025},{"literal_text_all_w_t_and_m_t":"The maximum number of OFDM symbols for UL front loaded DMRS. len1 corresponds to value 1. len2 corresponds to value 2. If the field is absent, the UE applies value len1. If set to len2, the UE determines the actual number of DM-RS symbols by the associated DCI. (see TS 38.211 [16], clause 6.4.1.1.3).","paragraph_zero_based":18026},{"literal_text_all_w_t_and_m_t":"nPUSCH-Identity","paragraph_zero_based":18027},{"literal_text_all_w_t_and_m_t":"Parameter: N_ID^(PUSCH) for DFT-s-OFDM DMRS. If the value is absent or released, the UE uses the value Physical cell ID (physCellId). See TS 38.211 [16].","paragraph_zero_based":18028},{"literal_text_all_w_t_and_m_t":"phaseTrackingRS","paragraph_zero_based":18029},{"literal_text_all_w_t_and_m_t":"Configures uplink PTRS (see TS 38.211 [16]).","paragraph_zero_based":18030},{"literal_text_all_w_t_and_m_t":"pi2BPSK-ScramblingID0, pi2BPSK-ScramblingID1","paragraph_zero_based":18031},{"literal_text_all_w_t_and_m_t":"UL DMRS scrambling initialization for pi/2 BPSK DMRS for PUSCH (see TS 38.211 [16], Clause 6.4.1.1.2). When the field is absent the UE applies the value Physical cell ID (physCellId) of the serving cell.","paragraph_zero_based":18032},{"literal_text_all_w_t_and_m_t":"scramblingID0","paragraph_zero_based":18033},{"literal_text_all_w_t_and_m_t":"UL DMRS scrambling initialization for CP-OFDM (see TS 38.211 [16], clause 6.4.1.1.1.1). When the field is absent the UE applies the value Physical cell ID (physCellId).","paragraph_zero_based":18034},{"literal_text_all_w_t_and_m_t":"scramblingID1","paragraph_zero_based":18035},{"literal_text_all_w_t_and_m_t":"UL DMRS scrambling initialization for CP-OFDM. (see TS 38.211 [16], clause 6.4.1.1.1.1). When the field is absent the UE applies the value Physical cell ID (physCellId).","paragraph_zero_based":18036},{"literal_text_all_w_t_and_m_t":"sequenceGroupHopping","paragraph_zero_based":18037},{"literal_text_all_w_t_and_m_t":"For DMRS transmission with transform precoder the NW may configure group hopping by the cell-specific parameter groupHoppingEnabledTransformPrecoding in PUSCH-ConfigCommon. In this case, the NW may include this UE specific field to disable group hopping for PUSCH transmission except for Msg3, i.e., to override the configuration in PUSCH-ConfigCommon (see TS 38.211 [16]). If the field is absent, the UE uses the same hopping mode as for Msg3.","paragraph_zero_based":18038},{"literal_text_all_w_t_and_m_t":"sequenceHopping","paragraph_zero_based":18039},{"literal_text_all_w_t_and_m_t":"Determines if sequence hopping is enabled for DMRS transmission with transform precoder for PUSCH transmission other than Msg3 (sequence hopping is always disabled for Msg3). If the field is absent, the UE uses the same hopping mode as for msg3. The network does not configure simultaneous group hopping and sequence hopping. See TS 38.211 [16], clause 6.4.1.1.1.2.","paragraph_zero_based":18040},{"literal_text_all_w_t_and_m_t":"transformPrecodingDisabled","paragraph_zero_based":18041},{"literal_text_all_w_t_and_m_t":"DMRS related parameters for Cyclic Prefix OFDM.","paragraph_zero_based":18042},{"literal_text_all_w_t_and_m_t":"transformPrecodingEnabled","paragraph_zero_based":18043},{"literal_text_all_w_t_and_m_t":"DMRS related parameters for DFT-s-OFDM (Transform Precoding).","paragraph_zero_based":18044},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18045},{"literal_text_all_w_t_and_m_t":"–DownlinkConfigCommon","paragraph_zero_based":18046},{"literal_text_all_w_t_and_m_t":"The IE DownlinkConfigCommon provides common downlink parameters of a cell.","paragraph_zero_based":18047}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["5bb22b087a7be1e22dc50d447be0f597996ed3f94c0428c63e9a310897b3d083","c88de6cf74ea771a9eb627d2b9443cf8ad4e4c800403444db6237ced1b3b33f8","a8b2cced664e272cc581244b6ccd17b91a390ee67a55b4589bd936fb1a77f379","4cd896810950294b445586f83fbb084a573fd1ed6982904da74e1af4571fbba1","561de003bbb2a7124bfa5980835329c65eed87caf8b74f530fd2b22927faaa55","56b95c2547579c444c5c0cdd97d09af734fef00cb957912af9af88ec27077a1a","cab4c15a2765cf1aca97522f308134b281b4c97b79a60bcb043b5a98524aa74b","c3072d73ae8e20a3b158eafeb7b702cecf57de22e9a20d14531db13153879b5c","55f8b112bec069583d60c5bf33bd6778be9e5af8fd45c8386badbb51120bc891","bf4b70c40b64833eb8eef481d7ee75180ff57d40d7016ab9fc44b2e9761ca84a","4a2128004a3940d2b13a6e1729becf59715a3ab94bab1c74a7b06078d0a8a611","9049bb7869edd755f80242a35b967d4b4c1e2bc59b81334413914ad34198ddfa","e316ea0569f8d613099cec6c74945d7faf0f68f50cf6f7ec8a6b9ba7c6e1767f","ef5c188625c6503ab9d6929141069e22815d6bbe23adad65a73a4044a67ff653","f1f16aa9acd5cd0152dfe370ab5a89f506d73bb91e029a4dbd7f96ebc5c3f283","9238f57975e8de52f227595e53a8b23427794c80e4d59ed73a0079a5fe251f77","faedf128c765792137eda8fb1c794df2981dabc2a44a9727a00772c634b52007","f9d8fc41b3dc47bba9db688cd8e19c7e352b5fb16ff9e763af891e6e3e257388","316ee4e3254aaddcfabd1f6ab1b8116cf9700e149424a78f449a6757e8f12628","b1b4ddae8de8ff82b687aa155d42711fe785fec36e5028e0268bc1e453f60c07","2e597db9228d7de8c1efcb743476e5077478a819ffd3d69fc62a14c48cb36c3b","a90086c056598b9dc2709cf41d787475acb9af117fe05198223