{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-EUTRA-NS-PMAXLIST-START","paragraph_zero_based":36816},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36817},{"literal_text_all_w_t_and_m_t":"EUTRA-NS-PmaxList ::=               SEQUENCE (SIZE (1..maxEUTRA-NS-Pmax)) OF EUTRA-NS-PmaxValue","paragraph_zero_based":36818},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36819},{"literal_text_all_w_t_and_m_t":"EUTRA-NS-PmaxValue ::=              SEQUENCE {","paragraph_zero_based":36820},{"literal_text_all_w_t_and_m_t":"    additionalPmax                      INTEGER (-30..33)                       OPTIONAL,   -- Need R","paragraph_zero_based":36821},{"literal_text_all_w_t_and_m_t":"    additionalSpectrumEmission          INTEGER (1..288)                        OPTIONAL    -- Need R","paragraph_zero_based":36822},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":36823},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36824},{"literal_text_all_w_t_and_m_t":"-- TAG-EUTRA-NS-PMAXLIST-STOP","paragraph_zero_based":36825},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36826},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36827},{"literal_text_all_w_t_and_m_t":"–EUTRA-PhysCellId","paragraph_zero_based":36828},{"literal_text_all_w_t_and_m_t":"The IE EUTRA-PhysCellId is used to indicate the physical layer identity of the cell, as defined in TS 36.211 [31].","paragraph_zero_based":36829},{"literal_text_all_w_t_and_m_t":"EUTRA-PhysCellId information element","paragraph_zero_based":36830},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36831},{"literal_text_all_w_t_and_m_t":"-- TAG-EUTRA-PHYSCELLID-START","paragraph_zero_based":36832},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36833},{"literal_text_all_w_t_and_m_t":"EUTRA-PhysCellId ::=                        INTEGER (0..503)","paragraph_zero_based":36834},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36835},{"literal_text_all_w_t_and_m_t":"-- TAG-EUTRA-PHYSCELLID-STOP","paragraph_zero_based":36836},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36837},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36838},{"literal_text_all_w_t_and_m_t":"–EUTRA-PhysCellIdRange","paragraph_zero_based":36839}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["d7f25ac6dd24be3890aacfad8b202de1cef35201e63edf145b07af31cdaa9eea","2a16a0a83943b7847d75cc48dd60632bedd73473c7600de8ab84402dea6810fa","89bc207d6a332d56a9b6ba8c7b83e261b974ccbdf9a14f112fb9670494b4b214","c814e5964e17d43d776c2c667d0d372e9885decc8c2462314f643718fdc47bc0","7a79ddbb860711d33b802128c155d797e28c25d61c888358b448703fcf1f10ed","a33e823555cde1763dbcaafe5e2f703762e686439e2b29ca27bb7eac596df6aa","9ef9216128eecaa790109689113703980d36dba494412be9bd290b36a788ef2e","8af6723eb2b22417ff1c108e27ae966b68b97e2b81bbf3e08eb74867e51b2e9b","e1719953a6866c0b14b6c2577415853ad1cda024dc3d15eec71fe2464004e10a","97c99e390f736b7e2a5675771ac919484687c653e72d3acb69ec38c1e25ed5dc","61f9258862511889df74cc44ae7d39e03fe26e230cf48f59ab485c393bf94a3f","e8f70ecedbb2de95aba6ffebab1d4332445918eab961471b50cf1ad45581db14","5c398e9c4ecc2fff05413ea8044689521a4ec0c03b29a5f2bc0b18b1c600980b","3ea5c52ff2f933175f47fe60ebb4a64d5585105d045289b9eed4c2e061728216","e615eb1792578236d4b826e497c19f0c95d05c574926355f09f4068af134735a","2bc392b49256147c6379765ba0af844535e9f3addc466a8e1cf09ca445a0d3b0","fdf9547c039a6ae9e599cbe1dde4e3aafa5ef2e1c75f6553a6df9618940ccd82","e17bf3c1c7c9b6fe88095650bd7b882109d3ece09bb