{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29952},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29953},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentBWP ::=            SEQUENCE {","paragraph_zero_based":29954},{"literal_text_all_w_t_and_m_t":"    bwp-Id                                  BWP-Id,","paragraph_zero_based":29955},{"literal_text_all_w_t_and_m_t":"    shift7dot5kHz                           BOOLEAN,","paragraph_zero_based":29956},{"literal_text_all_w_t_and_m_t":"    txDirectCurrentLocation                 INTEGER (0..3301)","paragraph_zero_based":29957},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29958},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29959},{"literal_text_all_w_t_and_m_t":"-- TAG-UPLINKTXDIRECTCURRENTLIST-STOP","paragraph_zero_based":29960},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29961},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29962},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentBWP field descriptions","paragraph_zero_based":29963},{"literal_text_all_w_t_and_m_t":"bwp-Id","paragraph_zero_based":29964},{"literal_text_all_w_t_and_m_t":"The BWP-Id of the corresponding uplink BWP.","paragraph_zero_based":29965},{"literal_text_all_w_t_and_m_t":"shift7dot5kHz","paragraph_zero_based":29966},{"literal_text_all_w_t_and_m_t":"Indicates whether there is 7.5 kHz shift or not. 7.5 kHz shift is applied if the field is set to true. Otherwise 7.5 kHz shift is not applied.","paragraph_zero_based":29967},{"literal_text_all_w_t_and_m_t":"txDirectCurrentLocation","paragraph_zero_based":29968},{"literal_text_all_w_t_and_m_t":"The uplink Tx Direct Current location for the carrier. Only values in the value range of this field between 0 and 3299, which indicate the subcarrier index within the carrier corresponding to the numerology of the corresponding uplink BWP and value 3300, which indicates \"Outside the carrier\" and value 3301, which indicates \"Undetermined position within the carrier\" are used in this version of the specification.","paragraph_zero_based":29969},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29970},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentCell field descriptions","paragraph_zero_based":29971},{"literal_text_all_w_t_and_m_t":"servCellIndex","paragraph_zero_based":29972},{"literal_text_all_w_t_and_m_t":"The serving cell ID of the serving cell corresponding to the uplinkDirectCurrentBWP.","paragraph_zero_based":29973},{"literal_text_all_w_t_and_m_t":"uplinkDirectCurrentBWP","paragraph_zero_based":29974},{"literal_text_all_w_t_and_m_t":"The Tx Direct Current locations for all the uplink BWPs configured at the corresponding serving cell.","paragraph_zero_based":29975}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["a7486914ea048fca3bac94cf270728ec22975000e2d3b84be5e8ae7fc8292156","829c7168ef5721c4d01f2f3560db1458c0246ad60a1098eeb43f222072cdb3e1","8b629f8915b46648c23abe9832ce3466c6cf5e8b4fa5118b5c0afefab33e4949","1655a937d0069e4185d42910b81b3294e4137d7bd6319d8af354859330f25da2","a6675bed321f8331108a7ce2d9a7cb7e429b6712510aa889e713adaf8760bb27","fbbdea6fa829fc214acc1343cf9516487d151eaef3af64cf2a30ff3d4f8ba711","b62dffd2b7b0598bddc49487cddcc11fd1cc62929e4a78596ec5abb4a0827947","c43e174000dade741b2e9a14e189b637482c41fafc64a63135e23c39850d1ae1","786e682c7e5c675c62fef524718dd2471975dd77325dcae18118b397a169b739","e77fad4b5177ff86cb448e235e448b97d9ab57ed4e1867781e554b1f3463fc87","6da9bbd8fb6fdf165a060e539e56f