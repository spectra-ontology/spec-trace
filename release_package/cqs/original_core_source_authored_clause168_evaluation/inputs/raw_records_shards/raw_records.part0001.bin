{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":30312},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":30313},{"literal_text_all_w_t_and_m_t":"RelayLCH-Setup","paragraph_zero_based":30314},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new logical channel for a Uu Relay RLC channel. It is optionally present, Need M, otherwise.","paragraph_zero_based":30315},{"literal_text_all_w_t_and_m_t":"RelayLCH-SetupOnly","paragraph_zero_based":30316},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new logical channel for a Uu Relay RLC channel. It is absent otherwise.","paragraph_zero_based":30317},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30318},{"literal_text_all_w_t_and_m_t":"–Uu-RelayRLC-ChannelID","paragraph_zero_based":30319},{"literal_text_all_w_t_and_m_t":"The IE Uu-RelayRLC-ChannelID is used to identify a Uu Relay RLC channel in the link between L2 U2N Relay UE and network.","paragraph_zero_based":30320},{"literal_text_all_w_t_and_m_t":"Uu-RelayRLC-ChannelID information element","paragraph_zero_based":30321},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":30322},{"literal_text_all_w_t_and_m_t":"-- TAG-UURELAYRLCCHANNELID-START","paragraph_zero_based":30323},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30324},{"literal_text_all_w_t_and_m_t":"Uu-RelayRLC-ChannelID-r17 ::= INTEGER (1..maxLC-ID)","paragraph_zero_based":30325},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30326},{"literal_text_all_w_t_and_m_t":"-- TAG-UURELAYRLCCHANNELID-STOP","paragraph_zero_based":30327},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":30328},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30329},{"literal_text_all_w_