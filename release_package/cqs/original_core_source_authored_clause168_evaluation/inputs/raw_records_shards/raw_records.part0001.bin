{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    msgA-PUSCH-Config-r16               MsgA-PUSCH-Config-r16                                      OPTIONAL --Cond InitialBWPConfig","paragraph_zero_based":20664},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":20665},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20666},{"literal_text_all_w_t_and_m_t":"-- TAG-MSGACONFIGCOMMON-STOP","paragraph_zero_based":20667},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":20668},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20669},{"literal_text_all_w_t_and_m_t":"MsgA-ConfigCommon field descriptions","paragraph_zero_based":20670},{"literal_text_all_w_t_and_m_t":"msgA-PUSCH-Config","paragraph_zero_based":20671},{"literal_text_all_w_t_and_m_t":"Configuration of cell-specific MsgA PUSCH parameters which the UE uses for contention-based MsgA PUSCH transmission of this BWP. If the field is not configured for the selected UL BWP, the UE shall use the MsgA PUSCH configuration of initial UL BWP.","paragraph_zero_based":20672},{"literal_text_all_w_t_and_m_t":"rach-ConfigCommonTwoStepRA","paragraph_zero_based":20673},{"literal_text_all_w_t_and_m_t":"Configuration of cell specific random access parameters which the UE uses for contention based and contention free 2-step random access type procedure as well as for 2-step RA type contention based beam failure recovery in this BWP.","paragraph_zero_based":20674},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20675},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":20676},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":20677},{"literal_text_all_w_t_and_m_t":"InitialBWPConfig","paragraph_zero_based":20678},{"literal_text_all_w_t_and_m_t":"The field is mandatory present when MsgA-ConfigCommon is configured for the initial uplink BWP, or when MsgA-ConfigCommon is configured for a non-initial uplink BWP and MsgA-ConfigCommon is not configured for the initial uplink BWP, otherwise the field is optionally present, Need S.","paragraph_zero_based":20679},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20680},{"literal_text_all_w_t_and_m_t":"–MsgA-PUSCH-Config","paragraph_zero_based":20681},{"literal_text_all_w_t_and_m_t":"The IE MsgA-PUSCH-Config is used to specify the PUSCH allocation for MsgA in 2-step random access type procedure.","paragraph_zero_based":20682},{"literal_text_all_w_t_and_m_t":"MsgA-PUSCH-Config information element","paragraph_zero_based":20683},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":20684},{"literal_text_all_w_t_and_m_t":"-- TAG-MSGA-PUSCH-CONFIG-START","paragraph_zero_based":20685},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20686},{"literal_text_all_w_t_and_m_t":"MsgA-PUSCH-Config-r16 ::=                      SEQUENCE {","paragraph_zero_based":20687}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["8741f228c8f81c81d429a5163ebe4705517fa18f0968841c56c66c2aacda313d","65dc60169f5747b66bca20cbe6f1849ef6ca36faa01c486047247c14b318a84c","85c1750e50c0e19787637a3ded6467f40fd6193702dde5a37c93f11226fcfc4a","eafd481c8475c41a29a0641b8fcfcb1533904f2b08dc0592685403bcb2422f5c","ed4cd32e2f26b3f4c7d9763cc8fd0ed5aa3aaec239713f662e8e6e47ff52ab7f","135a80b451465b00d8069391f21f0a67259ae7b9df619383666a1b15df6248ba","ff3e925b92b51c2c1b6b96a557d1ad33c44662a15814dc587c25d221121e0456","5539dafb0b7feb740e10779758a012db49c2ed16b173a46d4f99dcf5ab4ce5c7","d3afdd61dfbe2e9ab79b7e3a13eff0ad16db70eb12078912018