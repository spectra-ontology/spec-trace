aragraph_zero_based":23897},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":23898},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23899},{"literal_text_all_w_t_and_m_t":"MPE-Resource-r17 ::=        SEQUENCE {","paragraph_zero_based":23900},{"literal_text_all_w_t_and_m_t":"    mpe-ResourceId-r17          MPE-ResourceId-r17,","paragraph_zero_based":23901},{"literal_text_all_w_t_and_m_t":"    cell-r17                    ServCellIndex                                                         OPTIONAL,    -- Need R","paragraph_zero_based":23902},{"literal_text_all_w_t_and_m_t":"    additionalPCI-r17           AdditionalPCIIndex-r17                                                OPTIONAL,    -- Need R","paragraph_zero_based":23903}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["26d3fc14f16c1063fd194529927f6837062636688acaf18c211057d4dd1597ec","04d1a474000080fc43802fc64c8ced0dbcfbe5c08c0d36b4578a3d0a33279daa","1033a32339ff9d14c1e19823246db6e8604ea32848daa820ddcd3b8d4f1d22e5","3e1875b434db24e4119a901d422f44b836c652fdfa5cba3f92980f10120cae6a","e8f1d6f201c8fcf00ad225ed169e1389413485a30b1b78caa26009a75aa28a75","b5436fa02efbd0595b86a9716ba0bb80d5aebebdc042a7be18070abfa683e0e8","21e932d69c5cfdf5f959313868b06f5fbbda135496bff6a12fe1b2341831d592","00707b54de0c0563a3972d0ed7959570d2f8e04838737e52e3f4f849e49b4eb5","51a6e878511eed1d15a99c0d9d2ddfddd1b64f2df4dedeb30369dd4ff549a80a","bf4ad5a0308ecd775a56e8b199a0d31801cfc1f90a95d1d46da8334973f7c673","9737f5d84985d4ec536c2755634e17146f48fae387cf0b905fdeda6cf3a662e5","f3e157c70fca35f2cc82342d954b629f391892a4a9a3088352ddb696ff9d2668","eeb5e8aadf913b15fe8ac162c25480a718c822a2360956d04881269b3332c17e","c57e40f2245ac61064ef31452b0840d3ba37ff2cc8747ad9cd1fbc982d034ad9","501c2d0b8a12a84a75177b9b7d764225a358120065ce97ef6faac9bffb9f6c65","7e61b8e79d1bf028235f8f78ae521d3beeac10630f649dd7329b15baa7a9551a","81e82b8f3af5c275f31567411171cd8a85477e2838635783105ccce18c9a3852","79f9187db7aa9efa9448e69561b7bbe8a3dd34f577e7470db51d92e588b83858","3ced8bd4dcebdc7836d18368763b0a4465f127b0919f77eb188d1f31fe1cac00","6b98d43b12bce595f271cea7d626caaeab16326cb1b1c66836df25b76c723806","18d90b7d518de6e62c0df1163e48cb466e633cc13e350b78e0dd1a4990362ca0","497bf0f197b1e4a41740cfbf8a9f19c7de411164fc42345eee355f0cb4d94194","36a375b2230b4a2d99458b6871c8de7d2623b43dc89165084024cdc996f66478","78be537709e9c2d4616d0215d5f5579c6daf23f0a2571e452c5476fb64535c21"],"paragraph_range_zero_based":[23880,23903],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p23880"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    mpe-ReferenceSignal-r17     CHOICE {","paragraph_zero_based":23904},{"literal_text_all_w_t_and_m_t":"        csi-RS-Resource-r17         NZP-CSI-RS-ResourceId,","paragraph_zero_based":23905},{"literal_text_all_w_t_and_m_t":"        ssb-Resource-r17            SSB-Index","paragraph_zero_based":23906},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":23907},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":23908},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23909},{"literal_text_all_w_t_and_m_t":"MPE-ResourceId-r17 ::=      INTEGER (1..maxMPE-Resources-r17)","paragraph_zero_based":23910},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23911},{"literal_text_all_w_t_and_m_t":"-- TAG-PUSCH-CONFIG-STOP","paragraph_zero_based":23912},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23913},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23914},{"literal_text_all_w_t_and_m_t":"PUSCH-Config field descriptions","paragraph_zero_based":23915},{"literal_text_all_w_t_and_m_t":"antennaPortsFieldPresenceDCI-0-2","paragraph_zero_based":23916},{"literal_text_all_w_t_and_m_t":"Configure the presence of \"Antenna ports\" field in DCI format 0_2. When the field is configured, then the \"Antenna ports\" field is present in DCI format 0_2. Otherwise, the field size is set to 0 for DCI format 0_2 (See TS 38.212 [17], clause 7.3.1.1.3). If neither dmrs-UplinkForPUSCH-MappingTypeA-DCI-0-2 nor dmrs-UplinkForPUSCH-MappingTypeB-DCI-0-2 is configured, this field is absent.","paragraph_zero_based":23917},{"literal_text_all_w_t_and_m_t":"availableSlotCounting","paragraph_zero_based":23918},{"literal_text_all_w_t_and_m_t":"Indicate whether PUSCH repetitions counted on the basis of available slots is enabled. If the field is absent, PUSCH repetitions counted on the basis of available slots is disabled.","paragraph_zero_based":23919},{"literal_text_all_w_t_and_m_t":"betaOffsetsCrossPri0, betaOffsetsCrossPri1, betaOffsetsCrossPri0DCI-0-2, betaOffsetsCrossPri1DCI-0-2","paragraph_zero_based":23920},{"literal_text_all_w_t_and_m_t":"Selection between and configuration of dynamic and semi-static beta-offset for multiplexing HARQ-ACK on dynamically scheduled PUSCH with different priorities, see TS 38.213 [13], clause 9.3.","paragraph_zero_based":23921},{"literal_text_all_w_t_and_m_t":"The field betaOffsetsCrossPrio0 indicates multiplexing low priority (LP) HARQ-ACK on dynamically scheduled high priority (HP) PUSCH.","paragraph_zero_based":23922},{"literal_text_all_w_t_and_m_t":"The field betaOffsetsCrossPrio1 indicates multiplexing HP HARQ-ACK on dynamically scheduled LP PUSCH.","paragraph_zero_based":23923},{"literal_text_all_w_t_and_m_t":"The field betaOffsetsCrossPrio0DCI-0-2 indicates multiplexing LP HARQ-ACK on dynamically scheduled HP PUSCH by DCI format 0_2.","paragraph_zero_based":23924},{"literal_text_all_w_t_and_m_t":"The field betaOffsetsCrossPrio1DCI-0-2 indicates multiplexing HP HARQ-ACK on dynamically scheduled LP PUSCH by DCI format 0_2.","paragraph_zero_based":23925},{"literal_text_all_w_t_and_m_t":"codebookSubset, codebookSubsetDCI-0-2","paragraph_zero_based":23926},{"literal_text_all_w_t_and_m_t":"Subset of PMIs addressed by TPMI, where PMIs are those supported by UEs with maximum coherence capabilities (see TS 38.214 [19], clause 6.1.1.1). The field codebookSubset applies to DCI format 0_1 and the field codebookSubsetDCI-0-2 applies to DCI format 0_2 (see TS 38.214 [19], clause 6.1.1.1).","paragraph_zero_based":23927}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["33c3e5d235a8bc3f1a392ee78748223940f624a39678c7426e17fcb7b0d5a31f","62627c5e9ef3b5351446a371b472e4e2acd4c7680e8aca4b11ca68700dfba478","308acf57103f97fda37737bdc4a3a935524d64dfd17caa39d2e1c410163aa8bc","c1cebea9070cbfd72129c634c3488e4b5263812e434135aae855eacb7afbec81","9709c8afe88745585f7deb9c7ddd2b89c88749d0363460872ac3579c969ce836","8ee7319193629a744cca89c550a0072d1e9590225cf28e549cab4f81c2a2a55e","b267c39b1ec21689ed1e13b9735268f0429f954f8ff3e7587fc9513a244fe3ae","55756e1cf89dacea15644b9b82e49ec2946a6358a5e3670858a50cc8b071c760","435f58643ec52494df6bcea5a83683cc510528f030b14666e8182394ad70928c","13eab704dc23e8b913560d000313e78aadc23cfc7ee3d6a2cec816867f3b4bdd","a7247abdd3607a6bdb3623c8d5a40904ec8677733dc77b898fdb5ef1b8f4590f","3f96b7907ae1b8fa9c54733c1b0b89593ec697c09d7ab32469a145c28c3550c9","9814e4bd0ca22fcb5ff8503eb3e9be3ae3cc06811f2b380745d79b75f93f4c3d","e32c619c19cecbd322e275ac8a02d73564fd3a9edab30570b6fc566b958c5101","b9271e3c63b730af4b200cae0bbaaa2f668ba144f1ec3fe88793d2d6957733c9","8ebffc7e2b148ab522ef7ec5cfbedaadf51606bca32f412ca3933932d441b7a1","d8e209dcdeb143ad4152151096d224ff93e9196167dce5ae3f8e4adbe970d994","09106428adced5f88c79c043c3e5b84a29a6d10becb07891d6b262da74dd2b9e","9fe7ec85c80cba8491b481f6895cb42211c816cbb8265af1dc1aa9c4fdeb2a26","316dd045f6f33185d7ef7921e435bc697b71f8812e4650b5dedb3bfd7d1fef55","5bf7c0e383587314874ad1f0f305b6f34596d389857381162e2fa03f51228c8c","3ccb269b48b847102041f032ca9edff9e613147af7c2e0b4f23daf7b06360dcb","49d9f2ab59c465f80130100fd001f4fcaa4bebb97418ceda7119d74f6f2799ec","5003012ebe77b71ed5a193fc5e31eb26f34d5f7f3762b4fe10fccc55ba4970eb"],"paragraph_range_zero_based":[23904,23927],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p23904"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"dataScramblingIdentityPUSCH","paragraph_zero_based":23928},{"literal_text_all_w_t_and_m_t":"Identifier used to initialise data scrambling (c_init) for PUSCH. If the field is absent, the UE applies the physical cell ID. (see TS 38.211 [16], clause 6.3.1.1).","paragraph_zero_based":23929},{"literal_text_all_w_t_and_m_t":"dmrs-BundlingPUSCH-Config","paragraph_zero_based":23930},{"literal_text_all_w_t_and_m_t":"Configure the parameters for DMRS bundling for PUSCH (see TS 38.214 [19], clause 6.1.7). In this release, this is not applicable to FR2-2.","paragraph_zero_based":23931},{"literal_text_all_w_t_and_m_t":"dmrs-SequenceInitializationDCI-0-2","paragraph_zero_based":23932},{"literal_text_all_w_t_and_m_t":"Configure whether the field \"DMRS Sequence Initialization\" is present or not in DCI format 0_2. If the field is absent, then 0 bit for the field \"DMRS Sequence Initialization\" in DCI format 0_2. If the field is present, then the number of bits is determined in the same way as DCI format 0_1 (see TS 38.212 [17], clause 7.3.1).  ","paragraph_zero_based":23933},{"literal_text_all_w_t_and_m_t":"dmrs-UplinkForPUSCH-MappingTypeA, dmrs-UplinkForPUSCH-MappingTypeA-DCI-0-2","paragraph_zero_based":23934},{"literal_text_all_w_t_and_m_t":"DMRS configuration for PUSCH transmissions using PUSCH mapping type A (chosen dynamically via PUSCH-TimeDomainResourceAllocation). Only the fields dmrs-Type, dmrs-AdditionalPosition and maxLength may be set differently for mapping type A and B. The field dmrs-UplinkForPUSCH-MappingTypeA applies to DCI format 0_1 and the field dmrs-UplinkForPUSCH-MappingTypeA-DCI-0-2 applies to DCI format 0_2 (see TS 38.212 [17], clause 7.3.1).","paragraph_zero_based":23935},{"literal_text_all_w_t_and_m_t":"dmrs-UplinkForPUSCH-MappingTypeB, dmrs-UplinkForPUSCH-MappingTypeB-DCI-0-2","paragraph_zero_based":23936},{"literal_text_all_w_t_and_m_t":"DMRS configuration for PUSCH transmissions using PUSCH mapping type B (chosen dynamically via PUSCH-TimeDomainResourceAllocation). Only the fields dmrs-Type, dmrs-AdditionalPosition and maxLength may be set differently for mapping type A and B. The field dmrs-UplinkForPUSCH-MappingTypeB applies to DCI format 0_1 and the field dmrs-UplinkForPUSCH-MappingTypeB-DCI-0-2 applies to DCI format 0_2 (see TS 38.212 [17], clause 7.3.1).","paragraph_zero_based":23937},{"literal_text_all_w_t_and_m_t":"frequencyHopping","paragraph_zero_based":23938},{"literal_text_all_w_t_and_m_t":"The value intraSlot enables 'Intra-slot frequency hopping' and the value interSlot enables 'Inter-slot frequency hopping'. If the field is absent, frequency hopping is not configured for 'pusch-RepTypeA' (see TS 38.214 [19], clause 6.3). The field frequencyHopping applies to DCI format 0_0 and 0_1 for 'pusch-RepTypeA'.","paragraph_zero_based":23939},{"literal_text_all_w_t_and_m_t":"frequencyHoppingDCI-0-1","paragraph_zero_based":23940},{"literal_text_all_w_t_and_m_t":"Indicates the frequency hopping scheme for DCI format 0_1 when pusch-RepTypeIndicatorDCI-0-1 is set to 'pusch-RepTypeB', The value interRepetition enables 'Inter-repetition frequency hopping', and the value interSlot enables 'Inter-slot frequency hopping'. If the field is absent, frequency hopping is not configured for DCI format 0_1 for 'pusch-RepTypeB' (see TS 38.214 [19], clause 6.1).","paragraph_zero_based":23941},{"literal_text_all_w_t_and_m_t":"frequencyHoppingDCI-0-2","paragraph_zero_based":23942},{"literal_text_all_w_t_and_m_t":"Indicate the frequency hopping scheme for DCI format 0_2. The value intraSlot enables 'intra-slot frequency hopping', and the value interRepetition enables 'Inter-repetition frequency hopping', and the value interSlot enables 'Inter-slot frequency hopping'. When pusch-RepTypeIndicatorDCI-0-2 is not set to 'pusch-RepTypeB', the frequency hopping scheme can be chosen between 'intra-slot frequency hopping and 'inter-slot frequency hopping' if enabled. When pusch-RepTypeIndicatorDCI-0-2 is set to 'pusch-RepTypeB', the frequency hopping scheme can be chosen between 'inter-repetition frequency hopping' and 'inter-slot frequency hopping' if enabled. If the field is absent, frequency hopping is not configured for DCI format 0_2 (see TS 38.214 [19], clause 6.3).","paragraph_zero_based":23943},{"literal_text_all_w_t_and_m_t":"frequencyHoppingOffsetLists, frequencyHoppingOffsetListsDCI-0-2","paragraph_zero_based":23944},{"literal_text_all_w_t_and_m_t":"Set of frequency hopping offsets used when frequency hopping is enabled for granted transmission (not msg3) and type 2 configured grant activation (see TS 38.214 [19], clause 6.3). The field frequencyHoppingOffsetLists applies to DCI format 0_0 and DCI format 0_1 and the field frequencyHoppingOffsetListsDCI-0-2 applies to DCI format 0_2 (see TS 38.214 [19], clause 6.3).","paragraph_zero_based":23945},{"literal_text_all_w_t_and_m_t":"harq-ProcessNumberSizeDCI-0-2","paragraph_zero_based":23946},{"literal_text_all_w_t_and_m_t":"Configure the number of bits for the field \"HARQ process number\" in DCI format 0_2 (see TS 38.212 [17], clause 7.3.1).","paragraph_zero_based":23947},{"literal_text_all_w_t_and_m_t":"invalidSymbolPattern","paragraph_zero_based":23948},{"literal_text_all_w_t_and_m_t":"Indicates one pattern for invalid symbols for PUSCH transmission repetition type B applicable to both DCI format 0_1 and 0_2. If InvalidSymbolPattern is not configured, semi-static flexible symbols are used for PUSCH. Segmentation occurs only around semi-static DL symbols (see TS 38.214 [19] clause 6.1).","paragraph_zero_based":23949},{"literal_text_all_w_t_and_m_t":"invalidSymbolPatternIndicatorDCI-0-1, invalidSymbolPatternIndicatorDCI-0-2","paragraph_zero_based":23950},{"literal_text_all_w_t_and_m_t":"Indicates the presence of an additional bit in the DCI format 0_1/0_2. If invalidSymbolPattern is absent, then both invalidSymbolPatternIndicatorDCI-0-1 and invalidSymbolPatternIndicatorDCI-0-2 are absent. The field invalidSymbolPatternIndicatorDCI-0-1 applies to the DCI format 0_1 and the field invalidSymbolPatternIndicatorDCI-0-2 applies to DCI format 0_2 (see TS 38.214 [19] clause 6.1). If the field is absent, the UE behaviour is specified in TS 38.214 [19], clause 6.1.2.1.","paragraph_zero_based":23951}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["ec35e294f7150d018d7a494750e5e1e138f1b74af00a982849bcb7cf898320f6","adae0fe3b352077bc0370e04aa45587d4b3af133065d67c613fb2595404778e9","7d3efa852fe02fa9c60270c7e3731eb7edc681d3f23a5040b79851d95c52cd62","318d2c09a0ec4ef3cf80baf084bae80afc2c3ec87ad2805a3cbb7f6b90914548","787c85f1cfeee18ca8ae56313f2660753eee5cd4ec54717889fa009e6dc558a8","11f8e08f4a7d85f0b6fa1aa99533dea89b35558fea06816349aad6ed8e275d52","e998dc092ce94c5639ecbebc9f91752550e4846f2df89b7425d59a2bfd5aa249","3c17aeb5da7cc6a4755de399e3fba9f6171440fd94efb0bcb8bc3bbb2dc37d8e","a9bd545a4edd1899d292cae6fcf6de55a155b2299b3db84e437b30eba1db9c76","03e9747d0fed7819eadbeccca1250052d359daad18fe580cd1079e47618f1375","3b7d53793d11299eb401205dc95b763c224cecea4d967813847563ab96d61f36","ba8f76a9e600a334d6381d78d0202a7212985463b523ff60b32c38f26696e669","244a5fe0ccb001787e99c604fe812274236474af2f764c83109e15db8d4f4142","2cbb8205e0703f8ab86a5a0a896cc8535068e089f293817fbebe894c98a9950b","903cc239b514c064b118f5d411a689ea2242009eb0eaac4a6ef8f7830e706369","23910ccb0dede1d36e2e002be34a5bf1ec25a36cef6c5ba991f2e5ee536723dc","730821abee200c98ec66931882a7e9347c9538f72eceb977a0e43498e9e5b988","23aee461c1b4d11897008af23ae89949e7379155b0f30ef35f00d21951e32b34","36ed363e7a897c4b0929b3502e22d50d08712e7735fb6ba5838ffb604ea3ff4c","3983819097adeed9087312ea37f0d63c4e17667c41ae467db8cb6bf1f8a72c1c","2c865b0355617efa3e624ea817e715e045931d24af0d139986e5aff5a7a4aae0","9296d31e826f438bf1666b43b3adf9b5ccd5c3194410abc945c98b95f5c0e0d6","8cf39b9c5b3cb24f937d4d2c53ecd6f8b9bbcf323c5c1cf5d7b5629c49864b2a","eb97cc32b313904a2b12d5fb4144a540aca9778dac6e149279667cd36acdd1e1"],"paragraph_range_zero_based":[23928,23951],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p23928"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"mappingPattern","paragraph_zero_based":23952},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE should follow Cyclical mapping pattern or Sequential mapping pattern for when two SRS resource sets are configured in srs-ResourceSetToAddModList or srs-ResourceSetToAddModListDCI-0-2 with usage 'codebook' or 'noncodebook' for PUSCH transmission and the PUSCH transmission occasions are associated with both SRS resource sets.","paragraph_zero_based":23953},{"literal_text_all_w_t_and_m_t":"maxRank, maxRankDCI-0-2","paragraph_zero_based":23954},{"literal_text_all_w_t_and_m_t":"Subset of PMIs addressed by TRIs from 1 to ULmaxRank (see TS 38.214 [19], clause 6.1.1.1). The field maxRank applies to DCI format 0_1 and the field maxRankDCI-0-2 applies to DCI format 0_2 (see TS 38.214 [19], clause 6.1.1.1).","paragraph_zero_based":23955},{"literal_text_all_w_t_and_m_t":"mcs-Table, mcs-TableFormat0-2","paragraph_zero_based":23956},{"literal_text_all_w_t_and_m_t":"Indicates which MCS table the UE shall use for PUSCH without transform precoder (see TS 38.214 [19], clause 6.1.4.1). If the field is absent the UE applies the value 64QAM. The field mcs-Table applies to DCI format 0_0 and DCI format 0_1 and the field mcs-TableDCI-0-2 applies to DCI format 0_2 (see TS 38.214 [19], clause 6.1.4.1).","paragraph_zero_based":23957},{"literal_text_all_w_t_and_m_t":"mcs-TableTransformPrecoder, mcs-TableTransformPrecoderDCI-0-2","paragraph_zero_based":23958},{"literal_text_all_w_t_and_m_t":"Indicates which MCS table the UE shall use for PUSCH with transform precoding (see TS 38.214 [19], clause 6.1.4.1) If the field is absent the UE applies the value 64QAM. The field mcs-TableTransformPrecoder applies to DCI format 0_0 and DCI format 0_1 and the field mcs-TableTransformPrecoderDCI-0-2 applies to DCI format 0_2 (see TS 38.214 [19], clause 6.1.4.1).","paragraph_zero_based":23959},{"literal_text_all_w_t_and_m_t":"minimumSchedulingOffsetK2","paragraph_zero_based":23960},{"literal_text_all_w_t_and_m_t":"List of minimum K2 values. Minimum K2 parameter denotes minimum applicable value(s) for the Time domain resource assignment table for PUSCH (see TS 38.214 [19], clause 6.1.2.1).","paragraph_zero_based":23961},{"literal_text_all_w_t_and_m_t":"mpe-ResourcePoolToAddModList","paragraph_zero_based":23962},{"literal_text_all_w_t_and_m_t":"List of SSB/CSI-RS resources for P-MPR reporting. Each resource is configured with serving cell index where the resource is configured for the UE. The additionalPCI is configured only if the resource is SSB. For each resource, if neither cell nor additionalPCI is present, the SSB/CSI-RS resource is from the serving cell where the PUSCH-Config is configured.","paragraph_zero_based":23963},{"literal_text_all_w_t_and_m_t":"numberOfBitsForRV-DCI-0-2","paragraph_zero_based":23964},{"literal_text_all_w_t_and_m_t":"Configures the number of bits for \"Redundancy version\" in the DCI format 0_2 (see TS 38.212 [17], clause 7.3.1 and TS 38.214 [19], clause 6.1.2.1).","paragraph_zero_based":23965},{"literal_text_all_w_t_and_m_t":"numberOfInvalidSymbolsForDL-UL-Switching","paragraph_zero_based":23966},{"literal_text_all_w_t_and_m_t":"Indicates the number of symbols after the last semi-static DL symbol that are invalid symbols for PUSCH repetition Type B. If it is absent, no symbol is explicitly defined for DL-to-UL switching (see TS 38.214 [19], clause 6.1).","paragraph_zero_based":23967},{"literal_text_all_w_t_and_m_t":"priorityIndicatorDCI-0-1, priorityIndicatorDCI-0-2","paragraph_zero_based":23968},{"literal_text_all_w_t_and_m_t":"Configures the presence of \"priority indicator\" in DCI format 0_1/0_2. When the field is absent in the IE, then the UE shall apply 0 bit for \"Priority indicator\" in DCI format 0_1/0_2. The field priorityIndicatorDCI-0-1 applies to DCI format 0_1 and the field priorityIndicatorDCI-0-2 applies to DCI format 0_2 (see TS 38.212 [17] clause 7.3.1 and TS 38.213 [13] clause 9).","paragraph_zero_based":23969},{"literal_text_all_w_t_and_m_t":"pusch-AggregationFactor","paragraph_zero_based":23970},{"literal_text_all_w_t_and_m_t":"Number of repetitions for data (see TS 38.214 [19], clause 6.1.2.1). If the field is absent the UE applies the value 1.","paragraph_zero_based":23971},{"literal_text_all_w_t_and_m_t":"pusch-PowerControl","paragraph_zero_based":23972},{"literal_text_all_w_t_and_m_t":"Configures power control parameters PUSCH transmission. This field is not configured if unifiedTCI-StateType is configured for the serving cell.","paragraph_zero_based":23973},{"literal_text_all_w_t_and_m_t":"pusch-RepTypeIndicatorDCI-0-1, pusch-RepTypeIndicatorDCI-0-2","paragraph_zero_based":23974},{"literal_text_all_w_t_and_m_t":"Indicates whether UE follows the behavior for \"PUSCH repetition type A\" or the behavior for \"PUSCH repetition type B\" for the PUSCH scheduled by DCI format 0_1/0_2 and for Type 2 CG associated with the activating DCI format 0_1/0_2.The value pusch-RepTypeA enables the 'PUSCH repetition type A' and the value pusch-RepTypeB enables the 'PUSCH repetition type B'. The field pusch-RepTypeIndicatorDCI-0-1 applies to DCI format 0_1 and the field pusch-RepTypeIndicatorDCI-0-2 applies to DCI format 0_2 (see TS 38.214 [19], clause 6.1.2.1).","paragraph_zero_based":23975}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["9a7e2a6c14db19815c538739491250367bef53575faf0d85e2e38000a2fb5b06","c833a00a74ebd30f76ae438149043c1702ddb7c827f6835dec300399073d5f0a","36b8e46d3bdc8f9a6f36f4054b527e7cca024c5ab1cae037446ee756775a9592","dbf4d00e3b01bff519989f32b80b0ad0c59c227e2c690202bceb78f1823cb1d9","31fd57139b0c787f5482b65c230b67d73ef1fb8c4a1a8f6827ce61d10db3bf04","dcd68a604e9bb2f66d0654d12f3ef95a4e11314890d1a398f1aff5d255cb9123","6608df451e1da2df852000ddcb92d1fe66a95f19c2d0d33da89acbdd16857aad","5462c034f7498c7a18cbf6faf27795bf1c4c9a448ef842362c8edd12a3f9a492","fe6b92af2df6b3fe95ed17da01cc93ca3ee54fb3e62523a54a19cb9a14f0b65e","478eadd658c1632b74275979b278360ba45c6df313c07598c48fb249dd8e7021","ebdfedaf95f5f0a0bf45ffddd05f2169b4d26f76a054149ba78326cca5144838","6b1ccfba858228b04a164338dc23160cf9676a5cb184ac24a3aa69fcc985cedf","d08742d73cc40b4f0b37b9d03d1e536dbf24b8833293fbdc530894efc5700a08","c3c1ef71314ac999ad55cceed0a1211166ebb08faf976d758085827e469bb72f","b3cb00106b915898e78ad2eb69bd785f66edffaaa052f28d18f25340e807e507","766eea20bafd87e0c1ca28aacd9872b3d670a3337ded349de1d7ba636103dd65","6391e45beaf795c8df00498ef31886ee7be932ddbd1b965d413250aef8b93be2","2167227e32682a1c47b5d3faa1075a88c847aa07f54c9ac277b047361d6a50df","1dc6ab04c17f76b56b31497e22dead99786af59f96d28e3b77e48aa0db91cbfd","b2ee2fca003f58c59ba812740a8e7d607bdc717446b50906369a8e00c099f08e","7c7b7f8cc06753640fe9e7a1034f761b2351d9bf09e949419785c32efb7c6399","ea40b8b9887bbaaf1a89406e87a95905ea5251ee4cb010d2a39818870c671e8b","9a408670d2691dead34622d65d15c0da90ccb24a510c97d13016113aee86a9d9","f2e7eec6aa51dc7c780e11d6ed53e384f83ce3eeecc9eb6c2198790da6c84315"],"paragraph_range_zero_based":[23952,23975],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p23952"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"pusch-TimeDomainAllocationList","paragraph_zero_based":23976},{"literal_text_all_w_t_and_m_t":"List of time domain allocations for timing of UL assignment to UL data (see TS 38.214 [19], table 6.1.2.1.1-1). The field pusch-TimeDomainAllocationList applies to DCI formats 0_0 or DCI format 0_1 when the field pusch-TimeDomainAllocationListDCI-0-1 is not configured (see TS 38.214 [19], table 6.1.2.1.1-1 and table 6.1.2.1.1-1A). The network does not configure the pusch-TimeDomainAllocationList (without suffix) simultaneously with the pusch-TimeDomainAllocationListDCI-0-2-r16 or pusch-TimeDomainAllocationListDCI-0-1-r16 or pusch-TimeDomainAllocationListForMultiPUSCH-r16.","paragraph_zero_based":23977},{"literal_text_all_w_t_and_m_t":"pusch-TimeDomainAllocationListDCI-0-1","paragraph_zero_based":23978},{"literal_text_all_w_t_and_m_t":"Configuration of the time domain resource allocation (TDRA) table for DCI format 0_1 (see TS 38.214 [19], clause 6.1, table 6.1.2.1.1-1A).","paragraph_zero_based":23979},{"literal_text_all_w_t_and_m_t":"pusch-TimeDomainAllocationListDCI-0-2","paragraph_zero_based":23980},{"literal_text_all_w_t_and_m_t":"Configuration of the time domain resource allocation (TDRA) table for DCI format 0_2 (see TS 38.214 [19], clause 6.1.2, table 6.1.2.1.1-1B).","paragraph_zero_based":23981},{"literal_text_all_w_t_and_m_t":"pusch-TimeDomainAllocationListForMultiPUSCH","paragraph_zero_based":23982},{"literal_text_all_w_t_and_m_t":"Configuration of the time domain resource allocation (TDRA) table for multiple PUSCH (see TS 38.214 [19], clause 6.1.2). The network configures at most 64 rows in this TDRA table in PUSCH-TimeDomainResourceAllocationList-r16 configured by this field. This field is not configured simultaneously with pusch-AggregationFactor. The network does not configure the pusch-TimeDomainAllocationListForMultiPUSCH-r16 simultaneously with the pusch-TimeDomainAllocationListDCI-0-1-r16. The network does not configure the pusch-TimeDomainAllocationListForMultiPUSCH-r16 simultaneously with the numberOfSlotsTBoMS-r17.","paragraph_zero_based":23983},{"literal_text_all_w_t_and_m_t":"rbg-Size","paragraph_zero_based":23984},{"literal_text_all_w_t_and_m_t":"Selection between configuration 1 and configuration 2 for RBG size for PUSCH. The UE does not apply this field if resourceAllocation is set to resourceAllocationType1. Otherwise, the UE applies the value config1 when the field is absent (see TS 38.214 [19], clause 6.1.2.2.1).","paragraph_zero_based":23985},{"literal_text_all_w_t_and_m_t":"resourceAllocation, resourceAllocationDCI-0-2","paragraph_zero_based":23986},{"literal_text_all_w_t_and_m_t":"Configuration of resource allocation type 0 and resource allocation type 1 for non-fallback DCI (see TS 38.214 [19], clause 6.1.2). The field resourceAllocation applies to DCI format 0_1 and the field resourceAllocationDCI-0-2 applies to DCI format 0_2 (see TS 38.214 [19], clause 6.1.2).","paragraph_zero_based":23987},{"literal_text_all_w_t_and_m_t":"resourceAllocationType1GranularityDCI-0-2","paragraph_zero_based":23988},{"literal_text_all_w_t_and_m_t":"Configures the scheduling granularity applicable for both the starting point and length indication for resource allocation type 1 in DCI format 0_2. If this field is absent, the granularity is 1 PRB (see TS 38.214 [19], clause 6.1.2.2.2).","paragraph_zero_based":23989},{"literal_text_all_w_t_and_m_t":"secondTPCFieldDCI-0-1, secondTPCFieldDCI-0-2","paragraph_zero_based":23990},{"literal_text_all_w_t_and_m_t":"A second TPC field can be configured via RRC for DCI-0-1 and DCI-0-2. Each TPC field is for each closed-loop index value respectively (i.e., 1st /2nd TPC fields correspond to \"closedLoopIndex\" value = 0 and 1,","paragraph_zero_based":23991},{"literal_text_all_w_t_and_m_t":"sequenceOffsetForRV","paragraph_zero_based":23992},{"literal_text_all_w_t_and_m_t":"Configures the RV offset for the starting RV for the first repetition (first actual repetition in PUSCH repetition Type B) towards the second 'SRS resource set' for PUSCH configured in either srs-ResourceSetToAddModList or srs-ResourceSetToAddModListDCI-0-2 with usage 'codebook' or 'noncodebook'.","paragraph_zero_based":23993},{"literal_text_all_w_t_and_m_t":"tp-pi2BPSK","paragraph_zero_based":23994},{"literal_text_all_w_t_and_m_t":"Enables pi/2-BPSK modulation with transform precoding if the field is present and disables it otherwise. ","paragraph_zero_based":23995},{"literal_text_all_w_t_and_m_t":"transformPrecoder","paragraph_zero_based":23996},{"literal_text_all_w_t_and_m_t":"The UE specific selection of transformer precoder for PUSCH (see TS 38.214 [19], clause 6.1.3). When the field is absent the UE applies the value of the field msg3-transformPrecoder from rach-ConfigCommon included directly within BWP configuration (i.e., not included in additionalRACH-ConfigList).","paragraph_zero_based":23997},{"literal_text_all_w_t_and_m_t":"txConfig","paragraph_zero_based":23998},{"literal_text_all_w_t_and_m_t":"Whether UE uses codebook based or non-codebook based transmission (see TS 38.214 [19], clause 6.1.1). If the field is absent, the UE transmits PUSCH on one antenna port, see TS 38.214 [19], clause 6.1.1.","paragraph_zero_based":23999}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["62aed0c7629795d221e085874ad9f7f6b192b50967f8ae506d6b31cd4f8c1292","9d6f6739420562ca5eac5b46c8c800a958ca6f56b266fc8137fd9afaa7ab935a","e03af099a6b94b6ad28da4ffccbcc4afe6b2e2d9a5830a06dd56308b916818ac","ec81db2aad81b653b962eda8b096433a09be20fc9df21050f854d61b408d1332","9eff1dee1ddbc29e8fd5676a395a14edb67c63c86b51e1528d7d5fec8100c499","7bab28b766ab9274a045a29d50f77570aa0eed405f39bb58bf97baf7d734379d","1123cf65d658a3a5e169b74907f362773fe06bbdf754194dfc166333d6bd9054","7884ab1a018ba3203cab0a9addd3079a7475ab2f8da4caed1b35d9fdcf5096ee","3ff7562fd288969a224ab2a4b0489380bc2bb1a013088dcb91bc6755d2eff94b","5763e66cf73e6c9f8ab015a7dead589a7b25cd2da71f2da75eef8756a621cab7","b234a595dd2564efe841520703c1ef4a2fedd4c81db0db0e501fb30c4fd51136","14e5c4ccf8e8703f2bdd16343251768d8eac65a4b786e40869ba4c9d3d686731","929e176ccf322bb84c808b4441f90289b1d424e4962136ee8179c767cbaa13d6","253c1c4e83eb95cfef8669d5129859ec127a2d993620136838038ee778917994","b20f360ed74c081bad6ccb43c4a0fe732821779136196cc14acd9e3d2f9648e3","555d2979fc82b661385c23af0722badded744f3f176d892160cd2ee59b9ec98b","461a005169d92b23774f2d3aa4b645be06f14a59d7e2afe27c8b230bb94c51bf","c71d6eb56b8399d3d4b0a42f07e43f409f7a0060442ed12539570ade7f99c6ea","f4c9a9b31c307b5f348111db56f5bb2df1c50a422389ff94515428d55f29ce17","ae55c7445a74ce0a3fb1b295da28d1562e7e14d03ad6db48e99a795672a88595","de905381392f5e1edb0e213494665ee2aab492adb1b4100ab2b317fb4f044f36","0a57397a921a4162153215d48d2a2930d6088ea4e93b6e70461a7a3c4bd2a411","e6d8c1e4840b3d17b35e9f04dab31508c70e48bb1aa7a4b5f07e274896aafe29","b0d0813fa3d55c762d64c96b9dda18c15cca3638b36b7138cecebb8b2fe89a91"],"paragraph_range_zero_based":[23976,23999],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p23976"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"uci-OnPUSCH-ListDCI-0-1, uci-OnPUSCH-ListDCI-0-2","paragraph_zero_based":24000},{"literal_text_all_w_t_and_m_t":"Configuration for up to 2 HARQ-ACK codebooks specific to DCI format 0_1/0_2. The field uci-OnPUSCH-ListDCI-0-1 applies to DCI format 0_1 and the field uci-OnPUSCH-ListDCI-0-2 applies to DCI format 0_2 (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13] clause 9.3).","paragraph_zero_based":24001},{"literal_text_all_w_t_and_m_t":"ul-AccessConfigListDCI-0-1, ul-AccessConfigListDCI-0-2","paragraph_zero_based":24002},{"literal_text_all_w_t_and_m_t":"List of the combinations of cyclic prefix extension, channel access priority class (CAPC), and UL channel access type (see TS 38.212 [17], clause 7.3.1) applicable for DCI format 0_1 and DCI format 0_2, respectively. The fields ul-AccessConfigListDCI-0-1-r16 and ul-AccessConfigListDCI-0-2-r17 are only applicable for FR1 (see TS 38.212 [17], Table 7.3.1.1.2-35). The field ul-AccessConfigListDCI-0-1-r17 only contains a list of UL channel access types and is only applicable for FR2-2 (see TS 38.212 [17], Table 7.3.1.1.2-35A).","paragraph_zero_based":24003},{"literal_text_all_w_t_and_m_t":"ul-FullPowerTransmission","paragraph_zero_based":24004},{"literal_text_all_w_t_and_m_t":"Configures the UE with UL full power transmission mode as specified in TS 38.213 [13]. This field is not configured if ul-powerControl is configured in the BWP-UplinkDedicated in which the PUCCH-Config is included.","paragraph_zero_based":24005},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24006},{"literal_text_all_w_t_and_m_t":"UCI-OnPUSCH field descriptions","paragraph_zero_based":24007},{"literal_text_all_w_t_and_m_t":"betaOffsets","paragraph_zero_based":24008},{"literal_text_all_w_t_and_m_t":"Selection between and configuration of dynamic and semi-static beta-offset for DCI formats other than DCI format 0_2. If the field is not configured, the UE applies the value 'semiStatic' (see TS 38.213 [13], clause 9.3).","paragraph_zero_based":24009},{"literal_text_all_w_t_and_m_t":"scaling","paragraph_zero_based":24010},{"literal_text_all_w_t_and_m_t":"Indicates a scaling factor to limit the number of resource elements assigned to UCI on PUSCH for DCI formats other than DCI format 0_2. Value f0p5 corresponds to 0.5, value f0p65 corresponds to 0.65, and so on. The value configured herein is applicable for PUSCH with configured grant (see TS 38.212 [17], clause 6.3).","paragraph_zero_based":24011},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24012},{"literal_text_all_w_t_and_m_t":"UCI-OnPUSCH-DCI-0-2 field descriptions","paragraph_zero_based":24013},{"literal_text_all_w_t_and_m_t":"betaOffsetsDCI-0-2","paragraph_zero_based":24014},{"literal_text_all_w_t_and_m_t":"Configuration of beta-offset for DCI format 0_2. If semiStaticDCI-0-2 is chosen, the UE shall apply the value of 0 bit for the field of beta offset indicator in DCI format 0_2. If dynamicDCI-0-2 is chosen, the UE shall apply the value of 1 bit or 2 bits for the field of beta offset indicator in DCI format 0_2 (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13] clause 9.3).","paragraph_zero_based":24015},{"literal_text_all_w_t_and_m_t":"dynamicDCI-0-2","paragraph_zero_based":24016},{"literal_text_all_w_t_and_m_t":"Indicates the UE applies the value 'dynamic' for DCI format 0_2 (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13], clause 9.3).","paragraph_zero_based":24017},{"literal_text_all_w_t_and_m_t":"semiStaticDCI-0-2","paragraph_zero_based":24018},{"literal_text_all_w_t_and_m_t":"Indicates the UE applies the value 'semiStatic' for DCI format 0_2. (see TS 38.212 [17], clause 7.3.1 and see TS 38.213 [13], clause 9.3).","paragraph_zero_based":24019},{"literal_text_all_w_t_and_m_t":"scalingDCI-0-2","paragraph_zero_based":24020},{"literal_text_all_w_t_and_m_t":"Indicates a scaling factor to limit the number of resource elements assigned to UCI on PUSCH for DCI format 0_2. Value f0p5 corresponds to 0.5, value f0p65 corresponds to 0.65, and so on (see TS 38.212 [17], clause 6.3).","paragraph_zero_based":24021},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24022},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":24023}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["2b5ccab59957b05bc7173244e08cc4274edffa71163e5d8c7d907b8254a457b9","8d9edbe48469ed131286a4c931dcbe1fb36e5760e29ee21df6e4c6ba63b54645","0a889a06e8f1928973c3d82882ee63d412390d0e5d9474a5f46cccfe4c3231cc","d76c4cd49321214d5b85810a6f268ae607a1b02eb07e84bc2a7fc286c530bde9","cdac49445d110fb23f0e584d1215c32819c8176db56582570c02d0d5777826fa","5f8cb7199db6667b4e4c5bc976b9ad7e69603faf6bb4b65f09109309bfdcb6c0","426a7c848ee4bcfb7ba943259640313893b7c59a5645ab190a05c8016e2d413d","dc1d2c5939e957b27b61ba98ced2d84c1a16713df45983a1ac749a6718ce71f2","e82f8af5b1f32f06fb88adcce0014e3f817451d5ef02392645b221b03224e296","35174370dc72a39e7b5595872ddfaaf50ac470a38e0a6df95cf75f17d01d4f60","c9a4d5666052a105bccd8e2b4b782c64922831597d73912eb1f855bdaf8ee2c0","8ccf335b9418f561cc6cff8203fdca9a098187c92e13e29ed713ddb9e0148f91","bbe2e02911d7ae3c0dde903eae7cae6c2977449dc34fed4aea9de2dfecf079ce","37b0f78d685dc3455f8a5fafe322d8015d25a14043cc05dbcd0c01d78ecb5c55","013768cfbd94e76b47cdbc0189dcfd0619444918c55c7aea6920fe5227f8526c","23a549dad4012a9dd1820bf2ff1c55a3e63166e26160dabe1b5ae16b5cf405af","53ba328359aefcbeace18b4054a9232a89b0e498c41e0e3f16a5536214dc4c6a","7c8aa581accf86536fe2a908dc904e796f1e27f7cf90c691652f817423fd55f9","1f2fa9024fbc0f243d5657762b99b33e3f573c761d9f822ba8bb93da54ad26f3","779aec5179a99152498127657994f0a1c9d27b8818fe4c75398f4d3689e8b586","aa7bc44369a177c04ce8cba8617a61949b1060c832f432365be5a5b9f5e9eb9c","e3431a783fca952d5370b9970932017f243eeae1a809efb04bac070f6f10fda1","ba60679fbcc5d74c1e4d485f1d5870a834e3afc371c59dbf34e09ecfd50f5d82","12bec157f542137014abded99126c8d98ffa621f9ef1ee86ea30fa361cf99833"],"paragraph_range_zero_based":[24000,24023],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p24000"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":24024},{"literal_text_all_w_t_and_m_t":"codebookBased","paragraph_zero_based":24025},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if txConfig is set to codebook and absent otherwise.","paragraph_zero_based":24026},{"literal_text_all_w_t_and_m_t":"RepTypeB","paragraph_zero_based":24027},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need S, if pusch-RepTypeIndicatorDCI-0-1 is set to pusch-RepTypeB. It is absent otherwise.","paragraph_zero_based":24028},{"literal_text_all_w_t_and_m_t":"RepTypeB2","paragraph_zero_based":24029},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need S, if pusch-RepTypeIndicatorDCI-0-1 or pusch-RepTypeIndicatorDCI-0-2 is set to pusch-RepTypeB. It is absent otherwise.","paragraph_zero_based":24030},{"literal_text_all_w_t_and_m_t":"SRSsets","paragraph_zero_based":24031},{"literal_text_all_w_t_and_m_t":"This field is mandatory present when UE is configured with two SRS sets in either srs-ResourceSetToAddModList or srs-ResourceSetToAddModListDCI-0-2 with usage codebook or non-codebook.","paragraph_zero_based":24032},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24033},{"literal_text_all_w_t_and_m_t":"–PUSCH-ConfigCommon","paragraph_zero_based":24034},{"literal_text_all_w_t_and_m_t":"The IE PUSCH-ConfigCommon is used to configure the cell specific PUSCH parameters.","paragraph_zero_based":24035},{"literal_text_all_w_t_and_m_t":"PUSCH-ConfigCommon information element","paragraph_zero_based":24036},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":24037},{"literal_text_all_w_t_and_m_t":"-- TAG-PUSCH-CONFIGCOMMON-START","paragraph_zero_based":24038},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24039},{"literal_text_all_w_t_and_m_t":"PUSCH-ConfigCommon ::=                  SEQUENCE {","paragraph_zero_based":24040},{"literal_text_all_w_t_and_m_t":"    groupHoppingEnabledTransformPrecoding   ENUMERATED {enabled}                                                OPTIONAL,   -- Need R","paragraph_zero_based":24041},{"literal_text_all_w_t_and_m_t":"    pusch-TimeDomainAllocationList          PUSCH-TimeDomainResourceAllocationList                              OPTIONAL,   -- Need R","paragraph_zero_based":24042},{"literal_text_all_w_t_and_m_t":"    msg3-DeltaPreamble                      INTEGER (-1..6)                                                     OPTIONAL,   -- Need R","paragraph_zero_based":24043},{"literal_text_all_w_t_and_m_t":"    p0-NominalWithGrant                     INTEGER (-202..24)                                                  OPTIONAL,   -- Need R","paragraph_zero_based":24044},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":24045},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":24046},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24047}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["4f6eb578f2fc803131e7c213e88540363348d9b10743c38394d51260712c0525","e46597f7a058f142713532a27c989971d21e90d56410d7f30322192bd34eaafa","05a6e8cfcf50f1d06431ca5b26ebd688fe3c0c5c68587e04efa973d664cc7346","224b6472cd5501c32a9524767138f895fa61fababcb27707cde97c6ec1badda5","bf3be6cec620fc40f4140843f89da17c102eac5a919bb2bb4391fdc13e9ee267","a277c9a5f0b8c9598bb847b61d0e8e5e5d3274eb3e2e3fb4d4e86469bccc28ac","e1fcdf963bd992aa7cdaed530b533014166b4dc690580a8217c2a763b907be62","71f1e2617b60bc217f76ddb792fbe1340ceee36f95113ea8928909debdc9d447","6febc309a8f82