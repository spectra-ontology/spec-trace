{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21552},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":21553},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":21554},{"literal_text_all_w_t_and_m_t":"Periodic","paragraph_zero_based":21555},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need M, for periodic NZP-CSI-RS-Resources (as indicated in CSI-ResourceConfig). The field is absent otherwise.","paragraph_zero_based":21556},{"literal_text_all_w_t_and_m_t":"PeriodicOrSemiPersistent","paragraph_zero_based":21557},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need M, for periodic and semi-persistent NZP-CSI-RS-Resources (as indicated in CSI-ResourceConfig). The field is absent otherwise.","paragraph_zero_based":21558},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21559},{"literal_text_all_w_t_and_m_t":"–NZP-CSI-RS-ResourceId","paragraph_zero_based":21560},{"literal_text_all_w_t_and_m_t":"The IE NZP-CSI-RS-ResourceId is used to identify one NZP-CSI-RS-Resource.","paragraph_zero_based":21561},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-ResourceId information element","paragraph_zero_based":21562},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21563},{"literal_text_all_w_t_and_m_t":"-- TAG-NZP-CSI-RS-RESOURCEID-START","paragraph_zero_based":21564},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21565},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-ResourceId ::=           INTEGER (0..maxNrofNZP-CSI-RS-Resources-1)","paragraph_zero_based":21566},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21567},{"literal_text_all_w_t_and_m_t":"-- TAG-NZP-CSI-RS-RESOURCEID-STOP","paragraph_zero_based":21568},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21569},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21570},{"literal_text_all_w_t_and_m_t":"–NZP-CSI-RS-ResourceSet","paragraph_zero_based":21571},{"literal_text_all_w_t_and_m_t":"The IE NZP-CSI-RS-ResourceSet is a set of Non-Zero-Power (NZP) CSI-RS resources (their IDs) and set-specific parameters.","paragraph_zero_based":21572},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-ResourceSet information element","paragraph_zero_based":21573},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21574},{"literal_text_all_w_t_and_m_t":"-- TAG-NZP-CSI-RS-RESOURCESET-START","paragraph_zero_based":21575}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["bb7eea374fd858f724a120eeba3b3782f299b3f8bf05b2fb76d2116f26e0d5ed","bac63e86c186fa6b86c128d1e27885bfdff5aa0b5f1c7b60e3d7b34cc42941ff","f3583640acc6095677fb8ee74303218999472ca85f5b532c959f99a74f1b2f55","c1102245cba93d6d3fb05eba3c8473ef2850ea4ef1eac603648ebf5f9e041693","1426a0a4855b6e7d6ffe465c35c79c2cff444615aeb6ce9435a9a3cac6cfd42c","6200ffd160317ec338bd82ac0deca2bb85031e416af2afa8abcfca09e3d79e06","67f85e79602a8c9c018900ac1d780199da2687635abc55927b9a244af64ff5d2","adada4301f0630b11227b88ccf62990fa529febbc0b4f4a4885bb364eda5f64a","0dacfa1465310abf04f274af627b7ab56b34ff82fa0c3d1e54eb4482ad965dc8","564d8a71a35a4efb55aa9c8c95dd9f7b7db1d854fcf6b9aa3d08027d90d48656","9947a04fa5444bfb7cba0903bb106bf15b6ccaeb9918dc1eac146814baa0e020","ff6cfac6079a9a3d2687cfc6a4328676f5e104c19a8f98b0a3ff3dc0130fe926","83b9f8fee7be0adc3d53e1702057a71fa9d6b62c2f34f117a7444d284cb4bbe0","d7f205afd8233366bd6034b15e19975932382e69db437490fcb433f617a9e993","b22bf25041ab940132ff01c2f0c37e86ef05ded05b7e6e9e3cd2bf6a3e223511","7784e