{"fields":{"filename":"R2-2401458.zip::R2-2401458.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"F","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"Rel-18","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-16(Release 16)Rel-17(Release 17)Rel-18(Release 18)Rel-19(Release 19)","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"Reason for change:","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"[I001] Field remoteUE-IndicationReq in CommonIEsRequestCapabilities can only be set when in NR access, and a condition should be added to reflect this restriction.","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"[I002] Need code on condition for field remoteUE-Indication to be removed from CommonIEsProvideCapabilities (used in ProvideCapabilities message in uplink direction).","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"Replace Need ON with Cond NR on remoteUE-IndicationReq and define the condition as optional, need ON, for NR access and not present otherwise.","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"Remove Need OR on remoteUE-Indication.","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"d8b33d63fa1306a290dfb1d41f0e061f60eb9bc61338ba8f51a0b2ece58785e5","original_member_sha256":"f2c0c6f90bae1678a978a16529e8b69f70957939d0d2a5d48a0840e1efb74554","paragraph_ElementTree_utf8_XML_sha256":["1cef444d894cdacbe559bb45e53c3b2ef7f77da82c45f0f24d784d4541645307","e4ea5591218aa96d0cd407936b651eb165fb4c75e229dab64ec9de6be991cb96","2d00e3b1a82065155328ddd802c3d4a8ebff11f4a0d6da9ecf9b1e34dc8ebfc8","b00948c4d2252b42c80a95f3b9f4aed3c5c59e171196e51e605ca35158e05eda","761fa4d36b282591b5f5bb5ee554c6086f6eb9d5925f257d405f142f9e3a17e1","9ee3a8ef1b4d8b5d23ae68c79878f83d9a7ffdf02ec93cff53f7b1de6029f4d6","7ad403764e5300f8af204048a1af011f51684b36aa15ae85191a2e3cb0a84eb2","b08252b53f111fda758564f01d6aeb287a86ceee9730eba0ca5fcf7c7dadb00e","5397ebe3cc2afa3393b897343a62f60e5b485315d8236802a715ec930f5cc336","c7f154badb51090dd578312419bcf46f1ff9111557a952165c0ca920b2e5af4d","1257bef6de0d6fbcb35da4ad9e5d1d2efb40539d216438a199be822d1e60e855","16c8d70f7d429c511b56c375317337c5d5c75b5a185ec91bf088b77069963fb7","acd6206245de4b9556a4853ff1b8b41875944834aa76df6c7d72af763f365262","3c4c80e1e11044a4d07c2d065ab1badcf74a3b84af6435503a27154aade28f9b","823808f9117aaf92d6c31d