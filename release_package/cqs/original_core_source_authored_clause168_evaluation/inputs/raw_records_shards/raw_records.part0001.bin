{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The ID of the serving cell for which the configuration is applicable.","paragraph_zero_based":28512},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28513},{"literal_text_all_w_t_and_m_t":"CO-DurationsPerCell field descriptions","paragraph_zero_based":28514},{"literal_text_all_w_t_and_m_t":"co-DurationList","paragraph_zero_based":28515},{"literal_text_all_w_t_and_m_t":"A list of Channel Occupancy duration in symbols.","paragraph_zero_based":28516},{"literal_text_all_w_t_and_m_t":"The maximum duration that can be configured for the following SCS:","paragraph_zero_based":28517},{"literal_text_all_w_t_and_m_t":"-15 kHz: 280.","paragraph_zero_based":28518},{"literal_text_all_w_t_and_m_t":"-30 kHz: 560.","paragraph_zero_based":28519},{"literal_text_all_w_t_and_m_t":"-60 kHz: 1120.","paragraph_zero_based":28520},{"literal_text_all_w_t_and_m_t":"-120 kHz: 560.","paragraph_zero_based":28521},{"literal_text_all_w_t_and_m_t":"-480 kHz: 2240.","paragraph_zero_based":28522},{"literal_text_all_w_t_and_m_t":"-960 kHz: 4480.","paragraph_zero_based":28523},{"literal_text_all_w_t_and_m_t":"positionInDCI","paragraph_zero_based":28524},{"literal_text_all_w_t_and_m_t":"Position in DCI of the bit field indicating Channel Occupancy duration for UE's serving cells (see TS 38.213 [13], clause 11.1.1).","paragraph_zero_based":28525},{"literal_text_all_w_t_and_m_t":"servingCelIId","paragraph_zero_based":28526},{"literal_text_all_w_t_and_m_t":"The ID of the serving cell for which the configuration is applicable.","paragraph_zero_based":28527},{"literal_text_all_w_t_and_m_t":"subcarrierSpacing","paragraph_zero_based":28528},{"literal_text_all_w_t_and_m_t":"Reference subcarrier spacing for the list of Channel Occupancy durations (see TS 38.213 [13], clause 11.1.1).","paragraph_zero_based":28529},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency range:","paragraph_zero_based":28530},{"literal_text_all_w_t_and_m_t":"FR1:    15, 30, or 60 kHz","paragraph_zero_based":28531},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":28532},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28533},{"literal_text_all_w_t_and_m_t":"SearchSpaceSwitchTrigger field descriptions","paragraph_zero_based":28534},{"literal_text_all_w_t_and_m_t":"positionInDCI","paragraph_zero_based":28535}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["db7117cb4174b4b4d2c9f0d752e9c20795225442eab415d33d6a01b40b1379b4","9cae7c001e998477578b196cee1f8c5624ceeb178a15e4280b88ec4899b0443c","2c006230ea02a81fd387d78c2c2eec9a4531ea08eb15b5fb76320cc0fdbd3fd2","690d8fe1f2908ec1ada1834a4ec62c75f51a21d0fa487f3050faeddf7544672b","f5c4d85397561e774a6d8a89cac974fcb5181f05cd48421d89c8fcfd0644ffdd","18d8c6aa4ebe4c472961b6d53050db5891209b18ec3b84da5a5f7ce11f9b9473","380037f6950db1fb18691fd068c84982df7ff8f0af3c73fecfad7bc222353b38","bd8cf5d1a796d8dacc70e3da8a39bbb94f21900e98d50d107f1298a3d199c969","ff1e0cacce3b807bde39225f880d5729c3bb8df1ede910ad8eb93c828ab92a48","aebe825f78cf689210dee25914cf48d38145c77810948b409c7ebda2077903f0","9c184bd707825c77470ee32eb95661e6cb7f403a190d1d9d94c72eaa92d53fd6","b46d4ec2eb9ddc1ce75c941c47cf957aaaa3cefd6471aa273cf2dad209879f87","57c11c70787a64df0b0fc260e6492b71e300b04ec3de3643a58afe89523ce46b","9457c9d0776c6d65edc686c3f5c0d405b9fad361f504d8dc169567e9d6d1d849","a799c0371cc054d34d638f46287965ec4cb520965a208f85d534892abf510686","f74229ccdd99517000d790027272213249d43351509eac6775e64699ab20d