{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–ReportConfigInterRAT","paragraph_zero_based":25776},{"literal_text_all_w_t_and_m_t":"The IE ReportConfigInterRAT specifies criteria for triggering of an inter-RAT measurement reporting event, or an L2 U2N relay measurement reporting event. The inter-RAT measurement reporting events for E-UTRA and UTRA-FDD are labelled BN with N equal to 1, 2 and so on. The measurement reporting events for L2 U2N relay UE are labelled YN with N equal to 1, 2 and so on.","paragraph_zero_based":25777},{"literal_text_all_w_t_and_m_t":"Event B1:Neighbour becomes better than absolute threshold;","paragraph_zero_based":25778},{"literal_text_all_w_t_and_m_t":"Event B2:PCell becomes worse than absolute threshold1 AND Neighbour becomes better than another absolute threshold2;","paragraph_zero_based":25779},{"literal_text_all_w_t_and_m_t":"Event Y1: PCell becomes worse than absolute threshold1 AND candidate L2 U2N Relay UE becomes better than another absolute threshold2;","paragraph_zero_based":25780},{"literal_text_all_w_t_and_m_t":"Event Y2: Candidate L2 U2N Relay UE becomes better than absolute threshold;","paragraph_zero_based":25781},{"literal_text_all_w_t_and_m_t":"ReportConfigInterRAT information element","paragraph_zero_based":25782},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25783},{"literal_text_all_w_t_and_m_t":"-- TAG-REPORTCONFIGINTERRAT-START","paragraph_zero_based":25784},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25785},{"literal_text_all_w_t_and_m_t":"ReportConfigInterRAT ::=                    SEQUENCE {","paragraph_zero_based":25786},{"literal_text_all_w_t_and_m_t":"    reportType                                  CHOICE {","paragraph_zero_based":25787},{"literal_text_all_w_t_and_m_t":"        periodical                                  PeriodicalReportConfigInterRAT,","paragraph_zero_based":25788},{"literal_text_all_w_t_and_m_t":"        eventTriggered                              EventTriggerConfigInterRAT,","paragraph_zero_based":25789},{"literal_text_all_w_t_and_m_t":"        reportCGI                                   ReportCGI-EUTRA,","paragraph_zero_based":25790},{"literal_text_all_w_t_and_m_t":"        ...,","paragraph_zero_based":25791},{"literal_text_all_w_t_and_m_t":"        reportSFTD                                  ReportSFTD-EUTRA","paragraph_zero_based":25792},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":25793},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25794},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25795},{"literal_text_all_w_t_and_m_t":"ReportCGI-EUTRA ::=                         SEQUENCE {","paragraph_zero_based":25796},{"literal_text_all_w_t_and_m_t":"    cellForWhichToReportCGI         EUTRA-PhysCellId,","paragraph_zero_based":25797},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":25798},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":25799}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["269302898f98c5cd81e05fe028ae6dc48fd37e8e665f4023fa6115a55872dd9b","d62b390c3f4296cee584dccdbdb92ba688f844ce47efcbd9ba96a7c43e7ff4c4","6ef48d0bb40fd1a7f759da988a0351d399890018f94e6fe1f6453dc7390c782e","e74df46ca3b32670104afd1cf1877a64c4a61ecbe51709dd80bfbcd68a964b14","149eb01ee2cb51bc10411250f62f6f685136c71bc957abecac57b3f027c71db6","be73827cdec9f9387a2d06fb72aea1a6f9b9eb742e0a9dc758b25c8d1ba60f56","77274044153a6d86a0d840bfcc40dcac52eea4233cd99b55d04e4141e8aa9d4d","74c33f73d10d60bb44c8a4c0febf3f71f0d32de76d6ea45d0c2