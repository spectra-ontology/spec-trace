{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"CSI-AssociatedReportConfigInfo ::=  SEQUENCE {","paragraph_zero_based":16656},{"literal_text_all_w_t_and_m_t":"    reportConfigId                      CSI-ReportConfigId,","paragraph_zero_based":16657},{"literal_text_all_w_t_and_m_t":"    resourcesForChannel                 CHOICE {","paragraph_zero_based":16658},{"literal_text_all_w_t_and_m_t":"        nzp-CSI-RS                          SEQUENCE {","paragraph_zero_based":16659},{"literal_text_all_w_t_and_m_t":"            resourceSet                         INTEGER (1..maxNrofNZP-CSI-RS-ResourceSetsPerConfig),","paragraph_zero_based":16660},{"literal_text_all_w_t_and_m_t":"            qcl-info                            SEQUENCE (SIZE(1..maxNrofAP-CSI-RS-ResourcesPerSet)) OF TCI-StateId","paragraph_zero_based":16661},{"literal_text_all_w_t_and_m_t":"                                                                                                      OPTIONAL  -- Cond Aperiodic","paragraph_zero_based":16662},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":16663},{"literal_text_all_w_t_and_m_t":"        csi-SSB-ResourceSet                 INTEGER (1..maxNrofCSI-SSB-ResourceSetsPerConfig)","paragraph_zero_based":16664},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":16665},{"literal_text_all_w_t_and_m_t":"    csi-IM-ResourcesForInterference     INTEGER(1..maxNrofCSI-IM-ResourceSetsPerConfig)               OPTIONAL, -- Cond CSI-IM-ForInterference","paragraph_zero_based":16666},{"literal_text_all_w_t_and_m_t":"    nzp-CSI-RS-ResourcesForInterference INTEGER (1..maxNrofNZP-CSI-RS-ResourceSetsPerConfig)          OPTIONAL, -- Cond NZP-CSI-RS-ForInterference","paragraph_zero_based":16667},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":16668},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":16669},{"literal_text_all_w_t_and_m_t":"    resourcesForChannel2-r17        CHOICE {","paragraph_zero_based":16670},{"literal_text_all_w_t_and_m_t":"        nzp-CSI-RS2-r17                 SEQUENCE {","paragraph_zero_based":16671},{"literal_text_all_w_t_and_m_t":"            resourceSet2-r17                INTEGER (1..maxNrofNZP-CSI-RS-ResourceSetsPerConfig),","paragraph_zero_based":16672},{"literal_text_all_w_t_and_m_t":"            qcl-info2-r17                   SEQUENCE (SIZE(1..maxNrofAP-CSI-RS-ResourcesPerSet)) OF TCI-StateId","paragraph_zero_based":16673},{"literal_text_all_w_t_and_m_t":"                                                                                                  OPTIONAL   -- Cond Aperiodic","paragraph_zero_based":16674},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":16675},{"literal_text_all_w_t_and_m_t":"        csi-SSB-ResourceSet2-r17        INTEGER (1..maxNrofCSI-SSB-ResourceSetsPerConfigExt)","paragraph_zero_based":16676},{"literal_text_all_w_t_and_m_t":"    }                                                                                             OPTIONAL,  -- Cond NoUnifiedTCI","paragraph_zero_based":16677},{"literal_text_all_w_t_and_m_t":"    csi-SSB-ResourceSetExt          INTEGER (1..maxNrofCSI-SSB-ResourceSetsPerConfigExt)          OPTIONAL   -- Need R","paragraph_zero_based":16678},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":16679}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["83c626657fc4e12d0cd935a9f4e4158d27cc5f5c0b176185db7b4a8894313915","85e6d462542e6e454022be9c5eddc0533067e5883249bd80f72a26dc51d32eb9","b822398e0c956db4f534000ba4ecec6420b03be7e79c51609542c9e39168318e","c2b5cc9e0a540ffe1c2f5a4c1147d7cc2dbec4d9cf629fc833ec7a231840abc0","f9a060aa1040402439d47ee52f85777803967f3ae04e292ac8142e03ef17dc86","7837098c060d0bbacca95763e8db48870442b6d2cc08e0c7662384468a9b1612","3faed2c2862bf9e1ce85d605da1b468281c00e5ea25feaf8a948457623dcab82","baf1bfb7edcaf1908939bae5c74ae57e5dfbfad195591b4576008457b7adf173","86d3f2bf94d8b627d69415c59f121fda48ff87f9fe446fda78b536e0cd952e4b","40e4a39d38e9e20df7beac5ae5d4318af4f83669f4477c2d1b8c3bf9098948b7","0edeea24cfbf8abb388b9fc90fea70550941d2e86610c559837e67c76e5d0fe0","4e1ac478abbab7a243539526eb3e80a11e4220002bacb077fc44dc3430caf350","9ea2ef39afafe36f4a33a21f829682df4a28a696b088a53831a3158a62e4c2d5","13c16494d8a076e0e17e8febe039b85671620f52585e332a0625f3ee5517c98c","000d78b451fece7b1a3874b61317ac1bfd722494155ed38358d6fe1764a52808","78c7dc1607906fe25a48aa3ce3ac77d59b81bc88d8c41a187758b993f21a809f","c82320095668553a7962b33730fe658910fa042b2db08e8d5a698dece384962e","80ef63a67579caa16c5514b73b27114875a5c3234230ae15d04b090262bd85a2","0ebea11acec0e8d88c5b71b92b8cfba6f3d8172c8ea09c0bacf7c61b579efa08","2129244a7e261487daf983096b2204dd1489630be5843ec4e54cec14ced3ec79","5542232f51ee03e897713c26e4f37220ec5546eaf81073bda2b9e1f1ea0003fb","3885927fee51e403a0f3ae3b434c82b9902d04e442ed59f98c7c6d08e049fe86","34e1e08fb38d443c4d5db246432828007637d37a615599c9bc6daa14d9399c76","ff07d27f663961ecd0d9cd881274e278ed2a681a98cad589a493e3a3ff494e93"],"paragraph_range_zero_based":[16656,16679],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p16656"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":16680},{"literal_text_all_w_t_and_m_t":"    csi-ReportSubConfigTriggerList-r18      CSI-ReportSubConfigTriggerList-r18                    OPTIONAL   -- Need R","paragraph_zero_based":16681},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":16682},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":16683},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16684},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-APERIODICTRIGGERSTATELIST-STOP","paragraph_zero_based":16685},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":16686},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16687},{"literal_text_all_w_t_and_m_t":"CSI-AssociatedReportConfigInfo field descriptions","paragraph_zero_based":16688},{"literal_text_all_w_t_and_m_t":"ap-CSI-MultiplexingMode","paragraph_zero_based":16689},{"literal_text_all_w_t_and_m_t":"Indicates if the behavior of transmitting aperiodic CSI on the first PUSCH repetitions corresponding to two SRS resource sets configured in srs-ResourceSetToAddModList or srs-ResourceSetToAddModListDCI-0-2 with usage 'codebook' or 'noncodebook' is enabled or not.","paragraph_zero_based":16690},{"literal_text_all_w_t_and_m_t":"csi-IM-ResourcesForInterference","paragraph_zero_based":16691},{"literal_text_all_w_t_and_m_t":"CSI-IM-ResourceSet for interference measurement. Entry number in csi-IM-ResourceSetList in the CSI-ResourceConfig indicated by csi-IM-ResourcesForInterference in the CSI-ReportConfig indicated by reportConfigId above (value 1 corresponds to the first entry, value 2 to the second entry, and so on). The indicated CSI-IM-ResourceSet should have exactly the same number of resources like the NZP-CSI-RS-ResourceSet indicated in resourceSet within nzp-CSI-RS.","paragraph_zero_based":16692},{"literal_text_all_w_t_and_m_t":"csi-ReportSubConfigTriggerList","paragraph_zero_based":16693},{"literal_text_all_w_t_and_m_t":"A list of sub-configuration ID(s) of N sub-configurations out of L configured sub-configurations within a CSI-ReportConfig associated with a triggering state for semi-persistent CSI reporting on PUSCH.","paragraph_zero_based":16694},{"literal_text_all_w_t_and_m_t":"csi-SSB-ResourceSet, csi-SSB-ResourceSet2","paragraph_zero_based":16695},{"literal_text_all_w_t_and_m_t":"CSI-SSB-ResourceSet for channel measurements. Entry number in csi-SSB-ResourceSetList in the CSI-ResourceConfig indicated by resourcesForChannelMeasurement in the CSI-ReportConfig indicated by reportConfigId above (value 1 corresponds to the first entry, value 2 to the second entry, and so on).","paragraph_zero_based":16696},{"literal_text_all_w_t_and_m_t":"nzp-CSI-RS-ResourcesForInterference","paragraph_zero_based":16697},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-ResourceSet for interference measurement. Entry number in nzp-CSI-RS-ResourceSetList in the CSI-ResourceConfig indicated by nzp-CSI-RS-ResourcesForInterference in the CSI-ReportConfig indicated by reportConfigId above (value 1 corresponds to the first entry, value 2 to the second entry, and so on). ","paragraph_zero_based":16698},{"literal_text_all_w_t_and_m_t":"qcl-info, qcl-info2","paragraph_zero_based":16699},{"literal_text_all_w_t_and_m_t":"List of references to TCI-States for providing the QCL source and QCL type for each NZP-CSI-RS-Resource listed in nzp-CSI-RS-Resources of the NZP-CSI-RS-ResourceSet indicated by resourceSet within nzp-CSI-RS. Each TCI-StateId refers to the TCI-State which has this value for tci-StateId and is defined in tci-StatesToAddModList or in dl-OrJointTCI-StateList in the PDSCH-Config included in the BWP-Downlink corresponding to the serving cell and to the DL BWP to which the resourcesForChannelMeasurement (in the CSI-ReportConfig indicated by reportConfigId above) belong to. First entry in qcl-info corresponds to first entry in nzp-CSI-RS-Resources of that NZP-CSI-RS-ResourceSet, second entry in qcl-info corresponds to second entry in nzp-CSI-RS-Resources, and so on (see TS 38.214 [19], clause 5.2.1.5.1). When this field is absent for aperiodic CSI RS, the UE shall use QCL information included in the  \"indicated\" DL only/Joint TCI state as specified in TS 38.214","paragraph_zero_based":16700},{"literal_text_all_w_t_and_m_t":"reportConfigId","paragraph_zero_based":16701},{"literal_text_all_w_t_and_m_t":"The reportConfigId of one of the CSI-ReportConfigToAddMod configured in CSI-MeasConfig","paragraph_zero_based":16702},{"literal_text_all_w_t_and_m_t":"resourcesForChannel2","paragraph_zero_based":16703}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["f878266a07343d70154ae9419e805fd1ad483aa8da8be63aeeafa84c77ded3c1","af230fad727eff93a38516948d85998d64a00e7252a9b2de7200189fe70eeb14","aac98f9ae2374c17c1bce505325f702183f7e3d40b1615b2e76890976861bf89","c27463ec5545735bc67b93f37b611701783949e8ecf1b41b0183ad93ebcfb7a3","f16ef3e00b9c04c2ba51e743c61c59cbc3a0a9b46aed344f7ac40dd543d5ad7b","3df4e414e023b0a22d3f6ac775b94fd7eae692ff0e8f845aa28476953c3085cc","d3d0c4a999ee8904357d937343eef1b1e600bc348c83a6c102f8c0c357d634fe","9510b9e9ea44cbafe63cf6566e22e24745ce5dabf6a870a452081841ba567943","6b21fc477b03715cface11521d44cf1b8dc14c644b11ff6adc0b79b45dc7dc3a","c293f86e97b6faef101014cc42dc9c5670f5d3ee8c9be487763f8191aee88b7f","d52f53017b73a43fe41ab93795a087dcbba57476277060adb62bdbc4c5a39fbb","00b1a59d8070a8019fbaa5967c9b74783516b4ce34aba184cc7dd5f7f60b6cce","eddd741a6f151a230b2a689384a2764082df9d9254131431759c1ef93a09d8ff","ede81463f8a216a96c16088ff355eaa5731f6415c0256bab5cc289358e57d60a","179ba74eb48cf14207f0ea5648a9fb79523bb003c212d8ed80836271d203c11d","c4e21020650545a9f156591a70399f7294851df81432785f8005a0b5f9a88cee","707fdf49190450c2896f37546fa928b4ab4a64c3486715346a0665addc5a0e88","6cbdc0631b7ed7fe7743015febeaadeb65d0e4dfd91b820e0a2d2a8fa45683f5","e6bd2479fef2407f5eb59f2132084f819cae5cde556187a86faf30099c0c2b33","5618a0da5bf94bb0aa5eb44486f7671ef430372a1499a42563afa88bfa55dc60","140b1b54418eaf1d3213c4c16d2ff7db2fe81baf90e4b68bdcc9f5dff72dd456","e35e8f5780b3dca9c2662b528d8c5777194eafdb3fcf7ba15db62f6bb0b9b0ae","15cf64dbe37c4802f7f0de841056156d88b4e2af14349dab393b700278de16e9","b6575351e5f7d381d516e815a0d2e3e94128c26fccb4410a04d7418672bb2177"],"paragraph_range_zero_based":[16680,16703],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p16680"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Configures reference signals for channel measurement corresponding to the second resource set for L1-RSRP measurement as configured in IE CSI-ResourceConfig when nrofReportedGroups-r17 is configured in IE CSI-ReportConfig. If this is present, network configures csi-SSB-ResourceSetExt instead of csi-SSB-ResourceSet and the UE ignores csi-SSB-ResourceSet in resourcesForChannel, and the resourcesForChannel configures the reference signals for channel measurement corresponding to the first resource set for L1-RSRP measurement (see TS 38.214 [19], clause 5.2.1.4).","paragraph_zero_based":16704},{"literal_text_all_w_t_and_m_t":"resourceSet","paragraph_zero_based":16705},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-ResourceSet for channel measurements. Entry number in nzp-CSI-RS-ResourceSetList in the CSI-ResourceConfig indicated by resourcesForChannelMeasurement in the CSI-ReportConfig indicated by reportConfigId above (value 1 corresponds to the first entry, value 2 to the second entry, and so on).","paragraph_zero_based":16706},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16707},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":16708},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":16709},{"literal_text_all_w_t_and_m_t":"Aperiodic","paragraph_zero_based":16710},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the NZP-CSI-RS-Resources in the associated resourceSet have the resourceType aperiodic and unifiedTCI-StateType is not configured. The field is optionally present, Need R, if the NZP-CSI-RS-Resources in the associated resourceSet have the resourceType aperiodic and unifiedTCI-StateType is configured. The field is absent otherwise.","paragraph_zero_based":16711},{"literal_text_all_w_t_and_m_t":"CSI-IM-ForInterference","paragraph_zero_based":16712},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if the CSI-ReportConfig identified by reportConfigId is configured with csi-IM-ResourcesForInterference; otherwise it is absent.","paragraph_zero_based":16713},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-ForInterference","paragraph_zero_based":16714},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if the CSI-ReportConfig identified by reportConfigId is configured with nzp-CSI-RS-ResourcesForInterference; otherwise it is absent.","paragraph_zero_based":16715},{"literal_text_all_w_t_and_m_t":"NoUnifiedTCI","paragraph_zero_based":16716},{"literal_text_all_w_t_and_m_t":"This field is absent, Need R, if unifiedTCI-StateType is configured for the serving cell in which the CSI-AperiodicTriggerStateList is included. It is optionally present, Need R, otherwise.","paragraph_zero_based":16717},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16718},{"literal_text_all_w_t_and_m_t":"–CSI-FrequencyOccupation","paragraph_zero_based":16719},{"literal_text_all_w_t_and_m_t":"The IE CSI-FrequencyOccupation is used to configure the frequency domain occupation of a channel state information measurement resource (e.g. NZP-CSI-RS-Resource, CSI-IM-Resource).","paragraph_zero_based":16720},{"literal_text_all_w_t_and_m_t":"CSI-FrequencyOccupation information element","paragraph_zero_based":16721},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":16722},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-FREQUENCYOCCUPATION-START","paragraph_zero_based":16723},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16724},{"literal_text_all_w_t_and_m_t":"CSI-FrequencyOccupation ::=         SEQUENCE {","paragraph_zero_based":16725},{"literal_text_all_w_t_and_m_t":"    startingRB                          INTEGER (0..maxNrofPhysicalResourceBlocks-1),","paragraph_zero_based":16726},{"literal_text_all_w_t_and_m_t":"    nrofRBs                             INTEGER (24..maxNrofPhysicalResourceBlocksPlus1),","paragraph_zero_based":16727}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["cd735b8af3bcf105e9e3fe69073ad28df2964afb1b9221d4f07c630b8f9e78df","e96f56ea3da2fb38063421b4b92f0c98632e4f4c9acb9fda34bd3bb28693a462","2ae0e0c689fd1036d08d06acb310089daedb60c86d443cabb4143d942bc26513","b38c064aacedb2002e2a57b5f222b694243aa8d1ec271093a090389dd0253c28","a47d0092383f66389f3f1e8cbe123fe28b4a1b5b2e1bf8cede643554eb06b500","711408eb3752beb02891c47d3a0b7cdc61d985ad0d888dff60ce8a03172df3ec","8922d5e24c41e414eafaf85f5abab3294e3739ab67932ab564062ae25883954b","14965dcf60ea61707e176d9895a9bdb4ac868ee4cd44482fa6e79454783992d7","939afc6c3e40c196e085fe9b8a47e48be6f06ab1799f8c966c2e78ac8fb979ce","ec9d7009109ec07c20e3654403973e68074199be4985d0f9b1a52ce377e99567","cf25b7c678a7034564de35e0aa039046465c35c6cc8e1dc14f7fbba298592ce5","1abd86d283ddddcc966d5db39d4549ad3a7702e20ad90f4888df4859acc44e9c","79f95b2b386ebcc5bb75184233fe86f05303f7751bb5982b6acc2f64cb2a5e2e","f170cc4fb51624af969129c9a18dfd9621182c804536066adf04284b2a08fa68","5e44eb997b3b34443eace72c619dfe1d3873acc774288d226186ec9d1c6bdb05","17e7aa8ecd8c997e0d833675fdfbf130bf80537a806a3d9e7ecf88f8a1bcac06","f3d0098f2b170c28ae45884a8d08c99e8a3ac367fd1bb8b06c883ff1cac2abeb","9ee04a5bd0726077772eb4f1838cd9ab2725d7829ea35389a148e81e77367e04","ccea87bdec82afbbe298281f5f9223822c50c95ce6eb80b9a64432ac097e9c14","51caa61fd78dd5e52390a9fecee71e898389f628c80a986b82686804f8560f4a","91f04d9ef07dbdd9c4c0bf5bc809d87e94848c6c52e7c783807478fd46004795","7813178c17b8e96daea439d42fb43fec789a05529706bbdea3e6482e4e8af3fc","d81ee1783def5a45c08bbd74a0a21c8aec3451a39f8ff534f6462025c4251bf4","781