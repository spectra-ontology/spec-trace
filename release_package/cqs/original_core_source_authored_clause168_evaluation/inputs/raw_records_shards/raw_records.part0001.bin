{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-REFERENCELOCATION-STOP","paragraph_zero_based":25392},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":25393},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25394},{"literal_text_all_w_t_and_m_t":"–ReferenceTimeInfo","paragraph_zero_based":25395},{"literal_text_all_w_t_and_m_t":"The IE ReferenceTimeInfo contains timing information for 5G internal system clock used for, e.g., time stamping, see TS 23.501 [32], clause 5.27.1.2.","paragraph_zero_based":25396},{"literal_text_all_w_t_and_m_t":"ReferenceTimeInfo information element","paragraph_zero_based":25397},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25398},{"literal_text_all_w_t_and_m_t":"-- TAG-REFERENCETIMEINFO-START","paragraph_zero_based":25399},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25400},{"literal_text_all_w_t_and_m_t":"ReferenceTimeInfo-r16 ::= SEQUENCE {","paragraph_zero_based":25401},{"literal_text_all_w_t_and_m_t":"    time-r16                            ReferenceTime-r16,","paragraph_zero_based":25402},{"literal_text_all_w_t_and_m_t":"    uncertainty-r16                     INTEGER (0..32767)          OPTIONAL,   -- Need S","paragraph_zero_based":25403},{"literal_text_all_w_t_and_m_t":"    timeInfoType-r16                    ENUMERATED {localClock}     OPTIONAL,   -- Need S","paragraph_zero_based":25404},{"literal_text_all_w_t_and_m_t":"    referenceSFN-r16                    INTEGER (0..1023)           OPTIONAL    -- Cond RefTime","paragraph_zero_based":25405},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25406},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25407},{"literal_text_all_w_t_and_m_t":"ReferenceTime-r16 ::=           SEQUENCE {","paragraph_zero_based":25408},{"literal_text_all_w_t_and_m_t":"    refDays-r16                         INTEGER (0..72999),","paragraph_zero_based":25409},{"literal_text_all_w_t_and_m_t":"    refSeconds-r16                      INTEGER (0..86399),","paragraph_zero_based":25410},{"literal_text_all_w_t_and_m_t":"    refMilliSeconds-r16                 INTEGER (0..999),","paragraph_zero_based":25411},{"literal_text_all_w_t_and_m_t":"    refTenNanoSeconds-r16               INTEGER (0..99999)","paragraph_zero_based":25412},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25413},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25414},{"literal_text_all_w_t_and_m_t":"-- TAG-REFERENCETIMEINFO-STOP","paragraph_zero_based":25415}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["a58947d5d3eaa78942454b583b9a1fa268426fff187846b0dfdc7a79d115c373","e6d9ca849db0a29ee25e8c6ae53d2f06addb758217d12bc4f1d48d93ed089420","19a77f2bb7099c6c29ee024dd7113a016e1f22dd609709d529adb4bcf139295d","c6ab17167577e3c6bfcdb04310823abe7a0ca9d9516b5af2b98a1418720c6ba5","7c57ab582c44e5fa783ac5a94a1f0a651b2b7fc6518637e9d35ba56a27fc919f","add8ac1499c7cdc9657ac0032d35d5922fbb98d1876bd9c8f793a2b4329b4061","9033c30f9ad5deb2c58c3348d012d814dc29716b449110a5fcc3aa30584b2acf","7df51d08d54e6ed14b6359add9b8756fafdd63be348ddffb851f6026801a3422","bc0122433d3439494402b9b17343b9df4c2a5912982e4a4c9ff3b558c6d83107","a2c94ec052908a6c1fe5e7343208aa80563c962545d151feb2b69a1e81e5fc4f","cc7d12b289ed29a66e5ca809a567d046b4c388cda3f308bf981a5c0d5d1a9034","05232f62544a36c94da00ca474ba346cc47c3267f20f1d48921fb49b72c032eb","629ddbb15d09507228bf32d4de3cb7a0effb9a305e66ed61cef74a2e3953a374","80e10ad8281dfa8ae0c6c55d0a6e6e690a4ca757911d7f2cd5bcc345a9ddd077","9bc7d4bc35d3cb0df9557d3c5d4c92cb039c0b3b2b213a88d3391f32126e1595","8ea4b6ab4c925b88487f83fb3a91afca4face2dfad881a41bc2de411a33cc473","a216ca89b39f67052de6e6cb4280b99922cd4b8a129ff279c5a375b9df903ee8","7e5a1c0c1a1123b85b795565d802f1c5a322c42469b41a9274ce855c6ffc9df1","672e3ecf774f3abba039fd091a1a5a1d91eaa646c92985c390c64800f194c94c","862883e0a1d76ea336e5481673617eec17d6c8167eb50d94bbf30589135238b3","9c608301b56ca3f8569e7a0dfba42691fdc172463f399e35c2126bebb040c09f","067aacd826de05b622e4e27415cd08e818af53284818889fa5a05654a3180bc8","5c7b73d44f7bf4bb67b15beba6287b56be5a2a47bca6db7215b349abd7a6a9fc","f2e28b31debd16e8300619892e276a02177116a9cd688620d70a3f0e9e10e309"],"paragraph_range_zero_based":[25392,25415],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p25392"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":25416},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25417},{"literal_text_all_w_t_and_m_t":"ReferenceTimeInfo field descriptions","paragraph_zero_based":25418},{"literal_text_all_w_t_and_m_t":"referenceSFN","paragraph_zero_based":25419},{"literal_text_all_w_t_and_m_t":"This field indicates the reference SFN corresponding to the reference time information. If referenceTimeInfo field is received in DLInformationTransfer message, this field indicates the SFN of PCell.","paragraph_zero_based":25420},{"literal_text_all_w_t_and_m_t":"time","paragraph_zero_based":25421},{"literal_text_all_w_t_and_m_t":"This field indicates time reference with 10ns granularity. If included in DLInformationTransfer and if UE-side TA PDC is de-activated, the indicated time may not be referenced at the network, i.e., gNB may pre-compensate for RF propagation delay. If included in DLInformationTransfer and if UE is requested to transmit UE Rx-Tx time difference measurement, the indicated time may not be referenced at the network, i.e., gNB may pre-compensate for RF propagation delay. Otherwise, the indicated time is referenced at the network, i.e., without compensating for RF propagation delay.","paragraph_zero_based":25422},{"literal_text_all_w_t_and_m_t":"The indicated time in 10ns unit from the origin is refDays*86400*1000*100000 + refSeconds*1000*100000 + refMilliSeconds*100000 + refTenNanoSeconds. The refDays field specifies the sequential number of days (with day count starting at 0) from the origin of the time field.","paragraph_zero_based":25423},{"literal_text_all_w_t_and_m_t":"If the referenceTimeInfo field is received in DLInformationTransfer message, the time field indicates the time at the ending boundary of the system frame indicated by referenceSFN. The UE considers this frame (indicated by referenceSFN) to be the frame which is nearest to the frame where the message is received (which can be either in the past or in the future).","paragraph_zero_based":25424},{"literal_text_all_w_t_and_m_t":"If the referenceTimeInfo field is received in SIB9, the time field indicates the time at the SFN boundary at or immediately after the ending boundary of the SI-window in which SIB9 is transmitted.","paragraph_zero_based":25425},{"literal_text_all_w_t_and_m_t":"If referenceTimeInfo field is received in SIB9, this field is excluded when determining changes in system information, i.e. changes of time should neither result in system information change notifications nor in a modification of valueTag in SIB1.","paragraph_zero_based":25426},{"literal_text_all_w_t_and_m_t":"timeInfoType","paragraph_zero_based":25427},{"literal_text_all_w_t_and_m_t":"If timeInfoType is not included, the time indicates the GPS time and the origin of the time field is 00:00:00 on Gregorian calendar date 6 January, 1980 (start of GPS time). If timeInfoType is set to localClock, the origin of the time is unspecified.","paragraph_zero_based":25428},{"literal_text_all_w_t_and_m_t":"uncertainty","paragraph_zero_based":25429},{"literal_text_all_w_t_and_m_t":"This field indicates the uncertainty of the reference time information provided by the time field. The uncertainty is 25ns multiplied by this field. If this field is absent, the uncertainty is unspecified.","paragraph_zero_based":25430},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25431},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":25432},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":25433},{"literal_text_all_w_t_and_m_t":"RefTime","paragraph_zero_based":25434},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if referenceTimeInfo is included in DLInformationTransfer message; otherwise the field is absent.","paragraph_zero_based":25435},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25436},{"literal_text_all_w_t_and_m_t":"–RejectWaitTime","paragraph_zero_based":25437},{"literal_text_all_w_t_and_m_t":"The IE RejectWaitTime is used to provide the value in seconds for timer T302.","paragraph_zero_based":25438},{"literal_text_all_w_t_and_m_t":"RejectWaitTime information element","paragraph_zero_based":25439}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["255838cdbc1170bf9773060cc881896b1d70dae3dc22dab326ef0c85f6aa6e70","ee57ae54298db0a973b2e8f626a4f7a3da49422992b1cfeb1eaf5bfa1669cc7d","c0d0bf84db9ac7007eaf96b1644e5607604e6982ae012a2ed7760cbc049fc7ef","12498237331b44c481698749ea227e33d7295a253c56758d102743983e7ca1b9","dc477ab9c63b2d367de0bea42079724292d0685c1a7cfe5a054286281e57990a","44a2e2a53b85f841481f28a53fdd548e6eec107bbf35de389d04ecb43c838db2","37806a9cdb23a891fc1435dccbed95f0aab458fde2ecb0e9f168c3a8582ccbcc","c4cf24002ad005f970962ba00114c8f6a9457ef6bc8a4ba5264183f9dd08ed73","5f7fd9afa6dfc0bd5a75bd0349821edbdd6b69a3848825512941269552a0cd39","bc52acd571920856fcb1895c92f9f7f67e8b5db5b9095ce93a37ff89419aa8a7","84e54482a6f6f5fdc19f81a3edc1b1e603509d7d335a40a5392c21615e22706b","74c7d3972b73fe3fdea9fb7aa155c469c31d9098b554151790e429db24b071dc","8a4888bcb5ef8d3a754478064c5e5717ae66ccbedee3da48aa6f20f33368f30a","3889c87a6bad502019262c9f2a9cf35c49a823116d8efc984f53e5b813eea081","3f6a7fbaf4fb82b1bf60bdbfee2d9c5d5e8adc002cab50df87a7a483fc2dabcb","1307864cf122d412ff837d84d729643109585673bcbdd6393d2112969547635f","0615ca1975df6b3a14e7c8612a50d13db7d4f50a987fd831e820a2f3cd4fa6e4","eca6d77696f2b14128bdf4bd40f853ce74adb1d10fb922a8998b405f3e30d76d","d334c135b4f18caf2a