{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SPS-PUCCH-AN information element","paragraph_zero_based":28296},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28297},{"literal_text_all_w_t_and_m_t":"-- TAG-SPS-PUCCH-AN-START","paragraph_zero_based":28298},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28299},{"literal_text_all_w_t_and_m_t":"SPS-PUCCH-AN-r16  ::=           SEQUENCE {","paragraph_zero_based":28300},{"literal_text_all_w_t_and_m_t":"    sps-PUCCH-AN-ResourceID-r16     PUCCH-ResourceId,","paragraph_zero_based":28301},{"literal_text_all_w_t_and_m_t":"    maxPayloadSize-r16              INTEGER (4..256)                     OPTIONAL    -- Need R","paragraph_zero_based":28302},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28303},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28304},{"literal_text_all_w_t_and_m_t":"-- TAG-SPS-PUCCH-AN-STOP","paragraph_zero_based":28305},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28306},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28307},{"literal_text_all_w_t_and_m_t":"SPS-PUCCH-AN field descriptions","paragraph_zero_based":28308},{"literal_text_all_w_t_and_m_t":"maxPayloadSize","paragraph_zero_based":28309},{"literal_text_all_w_t_and_m_t":"Indicates the maximum payload size for the corresponding PUCCH resource ID.","paragraph_zero_based":28310},{"literal_text_all_w_t_and_m_t":"sps-PUCCH-AN-ResourceID","paragraph_zero_based":28311},{"literal_text_all_w_t_and_m_t":"Indicates the PUCCH resource ID","paragraph_zero_based":28312},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28313},{"literal_text_all_w_t_and_m_t":"–SPS-PUCCH-AN-List","paragraph_zero_based":28314},{"literal_text_all_w_t_and_m_t":"The IE SPS-PUCCH-AN-List is used to configure the list of PUCCH resources per HARQ ACK codebook","paragraph_zero_based":28315},{"literal_text_all_w_t_and_m_t":"SPS-PUCCH-AN-List information element","paragraph_zero_based":28316},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28317},{"literal_text_all_w_t_and_m_t":"-- TAG-SPS-PUCCH-AN-LIST-START","paragraph_zero_based":28318},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28319}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["3f2a6ea17e9c8cdccfde7c6ef29ad16572fb13c1c2b0f912113e0eed4ebb1e39","00159cdc0be7b70fbe93604a33656d3c2fea85f6109e9ae16e67f95cb3412c49","8f19963f9517c4ea69dc7c1c7e5b3b9ecbc9b26e56f182e40aea92a18b08053b","2600e7e001212d2379cb29290d7e28ac50a2fe3c204a68712d7fd0f435242eea","8d45f2447b445a9695a286737d7614ab48254036cb2677807de792aaf2ebafc7","81e068318f03f32b7b0b7a0a7bb252a6e108968b011b989a8da2efd734c29833","09405885b04da88800b6dddc10fa61e1f9bbef2cdd689c03b06b454d19039b6f","98eefcfe1b629445ec636b21daa4c20a75484435b374670a9511f8591e64c8ef","550c93deb4e2336b1782c794d872a3fbf0407ceec9ba48a60e5f203527a00889","605b38f8e8d5aaa2d8bfdc979e96637ba0cd47ebf7c7145656a3ebd5255f308d","27bb2f55e69371a8952391c4c04c77dd49920f044b1636891782ba70f7b8a5f9","b803ca3ab63fa68dadb5af15168dbd9ef70e727fd57ed959bbe73c081710d4ce","4f33b63de38a20b20c6655107fac44ec23ba8c63a2e8e50c1ffa1c0a58eb6cee","1b07559757486e23f9fb7ebec35656ff46b4f392c12b69aca7605cf91d5a5043","b01b911ffbda8e7430d7f24db11b6b2a7bfb84dab791c426e3e2a0daa6c10d98","9be89c8761b40ab707ac749cf81fba8e893205cc151d93a5e5cd8ba4c0c2e67d","7dbd75f79d59781a6bc0dc689db6af7bda1de1bc8366b72a9f30b4a5f37ae9d8","3841bd82cff583d8eb974641ea2e9b4a2cf30c796b537f926daa7e94a9782676","4d5ae14572de2a6ce6980859540a5f46b334d9036f52e6c29