f8cd9d4561fabb577cacb0559d00bba50a88554ad5a6a4c34b92a","437f7de48c0676780aef2fcec21288c02b054792ef31a169cdef7e285630bbeb","ec18467c79aefcd61aff6caf8a3e55be0f722e6f0d08e9f0de0821820cf63870","b9792531b0b2d1268159a04509041d0b7aaef0bc927df6c26de7d2b61f96620c","949e8708f65fb2e153b3fb47e7bf1e565ada13eae1022b7d7c324d20f3362558","07f49a0bfb6b04c3ae4d6c15b7297a4bc6d164684238aa38ef10293268ddf918","dffa432ff50bde81634ee9c26b546a086e6d2cabc5153b8fe7c412656bd8f3c6","5b93992cf9b5aadfb43eb9be1d6be2f160e48ea965ba134d47c9c6e95f51fd16","2f6fe204839c0a10757e0dcbd74ed7a5c29ffc156ce88829b9d2fe5f2be3b377","ede8947e622ed960f104f3e348443c43661d0a0aeb9d99825c4cf10797d050b4"],"paragraph_range_zero_based":[11016,11039],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p11016"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is used to indicate whether the GUAMI included is native (derived from native 5G-GUTI) or mapped (from EPS, derived from EPS GUTI) as specified in TS 24.501 [23].","paragraph_zero_based":11040},{"literal_text_all_w_t_and_m_t":"iab-NodeIndication","paragraph_zero_based":11041},{"literal_text_all_w_t_and_m_t":"This field is used to indicate that the connection is being established by an IAB-node as specified in TS 38.300 [2].","paragraph_zero_based":11042},{"literal_text_all_w_t_and_m_t":"idleMeasAvailable","paragraph_zero_based":11043},{"literal_text_all_w_t_and_m_t":"Indication that the UE has idle/inactive measurement report available.","paragraph_zero_based":11044},{"literal_text_all_w_t_and_m_t":"mobilityState","paragraph_zero_based":11045},{"literal_text_all_w_t_and_m_t":"This field indicates the UE mobility state (as defined in TS 38.304 [20], clause 5.2.4.3) just prior to UE going into RRC_CONNECTED state. The UE indicates the value of medium and high when being in Medium-mobility and High-mobility states respectively. Otherwise the UE indicates the value normal.","paragraph_zero_based":11046},{"literal_text_all_w_t_and_m_t":"ng-5G-S-TMSI-Part2","paragraph_zero_based":11047},{"literal_text_all_w_t_and_m_t":"The leftmost 9 bits of 5G-S-TMSI.","paragraph_zero_based":11048},{"literal_text_all_w_t_and_m_t":"onboardingRequest","paragraph_zero_based":11049},{"literal_text_all_w_t_and_m_t":"This field indicates that the connection is being established for UE onboarding in the selected onboarding SNPN, see TS 23.501 [32].","paragraph_zero_based":11050},{"literal_text_all_w_t_and_m_t":"registeredAMF","paragraph_zero_based":11051},{"literal_text_all_w_t_and_m_t":"This field is used to transfer the GUAMI of the AMF where the UE is registered, as provided by upper layers, see TS 23.003 [21].","paragraph_zero_based":11052},{"literal_text_all_w_t_and_m_t":"selectedPLMN-Identity","paragraph_zero_based":11053},{"literal_text_all_w_t_and_m_t":"Index of the PLMN or SNPN selected by the UE from the plmn-IdentityInfoList or npn-IdentityInfoList fields included in SIB1.","paragraph_zero_based":11054},{"literal_text_all_w_t_and_m_t":"ul-RRC-Segmentation","paragraph_zero_based":11055},{"literal_text_all_w_t_and_m_t":"This field indicates the UE supports uplink RRC segmentation of UECapabilityInformation.","paragraph_zero_based":11056},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11057},{"literal_text_all_w_t_and_m_t":"–RRCSetupRequest","paragraph_zero_based":11058},{"literal_text_all_w_t_and_m_t":"The RRCSetupRequest message is used to request the establishment of an RRC connection.","paragraph_zero_based":11059},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB0","paragraph_zero_based":11060},{"literal_text_all_w_t_and_m_t":"RLC-SAP: TM","paragraph_zero_based":11061},{"literal_text_all_w_t_and_m_t":"Logical channel: CCCH","paragraph_zero_based":11062},{"literal_text_all_w_t_and_m_t":"Direction: UE to Network","paragraph_zero_based":11063}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["03c9c7bbc5bf92af0e9eaa59120ab91aa1e6cf0a2ee40f706a5a1c09869aa292","0ddb5d45ec600820f210d21ebceb649cc82c8fa3f5f6acd5bd1238f0c44507b4","59d5d0e292e49fb26c64a7d58b6a6a19a94fe8276b040a5e09601530a8f7d540","2d668f05a45cfe9ca38fa0194b3279eed5ed3cc809dd0fcf35969f7958132169","096bf546847622e1912df705b9096c1fbde9ad12f5ef6fd97d2bdcb88c2dd455","9ad21b31cffb4f9e3502dd06e04f3b44a305e637afeefad89fd190286a0c9853","c7f19f534f2b289efcbf89ff899f0c637d5b5