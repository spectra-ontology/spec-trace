{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SIBSystem Information Block","paragraph_zero_based":384},{"literal_text_all_w_t_and_m_t":"SLSidelink","paragraph_zero_based":385},{"literal_text_all_w_t_and_m_t":"SLSSSidelink Synchronisation Signal","paragraph_zero_based":386},{"literal_text_all_w_t_and_m_t":"SNPNStand-alone Non-Public Network","paragraph_zero_based":387},{"literal_text_all_w_t_and_m_t":"SpCellSpecial Cell","paragraph_zero_based":388},{"literal_text_all_w_t_and_m_t":"SRAPSidelink Relay Adaptation Protocol","paragraph_zero_based":389},{"literal_text_all_w_t_and_m_t":"SRBSignalling Radio Bearer","paragraph_zero_based":390},{"literal_text_all_w_t_and_m_t":"SRSSounding Reference Signal","paragraph_zero_based":391},{"literal_text_all_w_t_and_m_t":"SSBSynchronization Signal Block","paragraph_zero_based":392},{"literal_text_all_w_t_and_m_t":"TAGTiming Advance Group","paragraph_zero_based":393},{"literal_text_all_w_t_and_m_t":"TDDTime Division Duplex","paragraph_zero_based":394},{"literal_text_all_w_t_and_m_t":"TEGTiming Error Group","paragraph_zero_based":395},{"literal_text_all_w_t_and_m_t":"TMTransparent Mode","paragraph_zero_based":396},{"literal_text_all_w_t_and_m_t":"TMGITemporary Mobile Group Identity","paragraph_zero_based":397},{"literal_text_all_w_t_and_m_t":"U2NUE-to-Network","paragraph_zero_based":398},{"literal_text_all_w_t_and_m_t":"UDCUplink Data Compression","paragraph_zero_based":399},{"literal_text_all_w_t_and_m_t":"UEUser Equipment","paragraph_zero_based":400},{"literal_text_all_w_t_and_m_t":"ULUplink","paragraph_zero_based":401},{"literal_text_all_w_t_and_m_t":"UMUnacknowledged Mode","paragraph_zero_based":402},{"literal_text_all_w_t_and_m_t":"UPUser Plane","paragraph_zero_based":403},{"literal_text_all_w_t_and_m_t":"VRVirtual Reality","paragraph_zero_based":404},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":405},{"literal_text_all_w_t_and_m_t":"In the ASN.1, lower case may be used for some (parts) of the above abbreviations e.g. c-RNTI.","paragraph_zero_based":406},{"literal_text_all_w_t_and_m_t":"4General","paragraph_zero_based":407}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["c51d2696b5184a19142df89bb7250681521290c91e3f0610979edf6db9d7d784","025f6cbb3317e8bc37c64f03ed276b1f8fc8b5d3fdc26ca2829f9069c046bf12","34df1c407a99a9cc0d597d748b34fa9d4e5d3594531f2b324c66ea9ae4dcc1e0","b24e6da2f6ff91f3488e834fc3131ec88ce9c50552dda207deef438cebce49f3","5ee367f782b663dba8d204362cd3c93ac8757d9a745a6a485656a5a08703b76f","3cfab3da860abddbd577ba3cd24b0715e1f035abfd0f02eea0e917a8ec33a924","39d832c3203a1ea31fc8fa8636fd349e5c46dbcb26816038759403ad41d130a3","5c27744084c0ca1a89b2c820f0ce9b5b3353a5473b9c3e0edcd84d7d16b60feb","066907a35078be062e9f4553f47b1fe9aa313c29f6a2ace2fd2d3b75f63a9abe","5cec38942692c4ed6486a70ac2527b02c4fc0cdb7a7446f2401f59e0d400a5af","c46bde9a44861390bffb76ee9a952a2a396a0e36e0c51975e5b24281fbd493a5","46a3928dd851ae831354c1912d6c49ed3299a7a34990067d001d8987a0cbf24b","701e686435009be408b613da8000e726e5f8165e8982b68ff63c6857d77d0aa8","0670cc1071b548e282bf8833d8c166bafa3beabf2cf73eb02ed60fcb1de9df1c","45574609d30b0acb4fdd07b96850912c60187e7853b1fadcab302894e338b496","efc51a2fe8b2c77d5eb23fc09c206c54b5b25a7eeb070a82a8fd6596acfdbf2f","9b2e0cdc6aab759c3d9705916f79c2d1263a523b64beb0b7d03f0a64d98ccf85","a4ba0958ac04641fef79b3777e8af5b604004729a7a2d5c3c48ca75f110f119e","6319480ea525335cbbefb8b3f95ffb2591d743b901c2f0044a02a126376f9135","2c4071cd3eee8a9c31df89081e3b6df28b7341d43a0b52d01763ee305b9fac12","2e9940b4ef8578f26390bff61aadad443cf255b57af3f7d2edc90f5c127b04c4","e6a7fd8ff340039ade1f0bb8334b76de7f52ecd04b11f9bf8dcb718f6497963a","1b4199b24a52dceec51cc61331ad00167dfd0f0624a63abe366bbf4967e2e1ed","65eb237b8bc109823267b2c9d6fc66370b432874a22f3ea4359067ee94f93dc5"],"paragraph_range_zero_based":[384,407],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p384"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4.1Introduction","paragraph_zero_based":408},{"literal_text_all_w_t_and_m_t":"This specification is organised as follows:","paragraph_zero_based":409},{"literal_text_all_w_t_and_m_t":"-clause 4.2 describes the RRC protocol model;","paragraph_zero_based":410},{"literal_text_all_w_t_and_m_t":"-clause 4.3 specifies the services provided to upper layers as well as the services expected from lower layers;","paragraph_zero_based":411},{"literal_text_all_w_t_and_m_t":"-clause 4.4 lists the RRC functions;","paragraph_zero_based":412},{"literal_text_all_w_t_and_m_t":"-clause 5 specifies RRC procedures, including UE state transitions;","paragraph_zero_based":413},{"literal_text_all_w_t_and_m_t":"-clause 6 specifies the RRC messages in ASN.1 and description;","paragraph_zero_based":414},{"literal_text_all_w_t_and_m_t":"-clause 7 specifies the variables (including protocol timers and constants) and counters to be used by the UE;","paragraph_zero_based":415},{"literal_text_all_w_t_and_m_t":"-clause 8 specifies the encoding of the RRC messages;","paragraph_zero_based":416},{"literal_text_all_w_t_and_m_t":"-clause 9 specifies the specified and default radio configurations;","paragraph_zero_based":417},{"literal_text_all_w_t_and_m_t":"-clause 10 specifies generic error handling;","paragraph_zero_based":418},{"literal_text_all_w_t_and_m_t":"-clause 11 specifies the RRC messages transferred across network nodes;","paragraph_zero_based":419},{"literal_text_all_w_t_and_m_t":"-clause 12 specifies the UE capability related constraints and performance requirements.","paragraph_zero_based":420},{"literal_text_all_w_t_and_m_t":"4.2Architecture","paragraph_zero_based":421},{"literal_text_all_w_t_and_m_t":"4.2.1UE states and state transitions including inter RAT","paragraph_zero_based":422},{"literal_text_all_w_t_and_m_t":"A UE is either in RRC_CONNECTED state or in RRC_INACTIVE state when an RRC connection has been established. If this is not the case, i.e. no RRC connection is established, the UE is in RRC_IDLE state. The RRC states can further be characterised as follows:","paragraph_zero_based":423},{"literal_text_all_w_t_and_m_t":"-RRC_IDLE:","paragraph_zero_based":424},{"literal_text_all_w_t_and_m_t":"-A UE specific DRX may be configured by upper layers;","paragraph_zero_based":425},{"literal_text_all_w_t_and_m_t":"-At lower layers, the UE may be configured with a DRX for PTM transmission of MBS broadcast;","paragraph_zero_based":426},{"literal_text_all_w_t_and_m_t":"-UE controlled mobility based on network configuration;","paragraph_zero_based":427},{"literal_text_all_w_t_and_m_t":"-The UE:","paragraph_zero_based":428},{"literal_text_all_w_t_and_m_t":"-Monitors Short Messages transmitted with P-RNTI over DCI (see clause 6.5);","paragraph_zero_based":429},{"literal_text_all_w_t_and_m_t":"-Monitors a Paging channel for CN paging using 5G-S-TMSI, except if the UE is acting as a L2 U2N Remote UE;","paragraph_zero_based":430},{"literal_text_all_w_t_and_m_t":"-If configured by upper layers for MBS multicast reception, monitors a Paging channel for CN paging using TMGI;","paragraph_zero_based":431}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["ff44fab43164203abe6c09838ee392da3d672826cae625e98321b8ee28a8bf5a","52c174c45701bf96cc590bf9d01adf33a8dfe3fe522b0a4eeace71ed0c46b927","0f82abcef866cccc3e2aca5ff58d0c152d6ea12aa826003dcb137a9f96779895","d8265f6457a2e57c166666d343d1de1be3548e5d374641c03148072e63951b97","9bca27ef80db05203799eb3c66747618f1a48349927147bae331ac3e4677e07f","dc01ea35f2731d9dcd2205eaacf9b1219c1b76476c86412797d927c078fbfd6d","fd5f5d4efb35d0591ea7b3a7abac57e729fa0cc0bd4a2b9c93fb5ad4836c6706","de78e0bcb2271b9ee7f58a9dedda6e64e7e6f17828b5a6f307384f023d800d6a","081757f4fb05703b69465ef440001b579e83bcbdea93ec170fd30a953fa76f7f","261dbb2a01afa1095b115eeb023a8f4062bdf6eaba3a3507caa1d7200830b91c","5275720be010fafc26d3351179cb56a33ee7ee3512d8abc28c433ca101bdda6f","fcb37d2b7985cafccae266f60ce6bc4d6ed4a67fab9693f12f79bca9b5bbf70f","ffe38c5f34c83216768dcf7de2d73621b65eb4f01aaa26858e990d787bc4e03f","54208cc8105fae580c2e52a3df869ebfb00c58d0cc5fb90bf685e156469f15be","facc116edc4264106b281e4d3f67ba13d4513e2748cc3626d8dfc6d405ae003e","fb69b0f372a13785a463b6cc3a4de5e5765b9118f1c2e46c8c2a8f8296f068e2","ab19d4d877ee90c0857c596f30bf42336f5ef540f4aa64574e49d7dc4b57d216","07d428b96431d4b94ac4e6de9c79047435b12970ee1ce5fda3cd15fdfdd53fe2","d6455fc69ba3d83b5d7230a34d798e12f802356303c3663ed374d24ba02c338c","0e23117e92fff9a64ad7e15a9c01141b3d8aa4eea6476e4eb6f99f57b404c151","438ec05588e573d1d8fbfd9bceb72c63f592a74b4bdf756e024d99b762e33063","0a52822344ffd76e936029ae5c837c1ef3f477dafff850f9761f668c218296ac","706a3eff57b512aba895042cbb2feb06289ad53a0f1c27fcad5a1cdb269e5acf","5ec99d4731a5b9c3ec1ca9f56a7501fbdbc7bdee6eb679498da087f5908d1858"],"paragraph_range_zero_based":[408,431],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p408"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-Performs neighbouring cell measurements and cell (re-)selection;","paragraph_zero_based":432},{"literal_text_all_w_t_and_m_t":"-Acquires system information and can send SI request (if configured);","paragraph_zero_based":433},{"literal_text_all_w_t_and_m_t":"-Performs logging of available measurements together with location and time for logged measurement configured UEs;","paragraph_zero_based":434},{"literal_text_all_w_t_and_m_t":"-Performs idle/inactive measurements for idle/inactive measurement configured UEs;","paragraph_zero_based":435},{"literal_text_all_w_t_and_m_t":"-If configured by upper layers for MBS broadcast reception, acquires MCCH change notification and MBS broadcast control information and data.","paragraph_zero_based":436},{"literal_text_all_w_t_and_m_t":"-RRC_INACTIVE:","paragraph_zero_based":437},{"literal_text_all_w_t_and_m_t":"-A UE specific DRX may be configured by upper layers or by RRC layer;","paragraph_zero_based":438},{"literal_text_all_w_t_and_m_t":"-At lower layers, the UE may be configured with a DRX for PTM transmission of MBS broadcast;","paragraph_zero_based":439},{"literal_text_all_w_t_and_m_t":"-UE controlled mobility based on network configuration;","paragraph_zero_based":440},{"literal_text_all_w_t_and_m_t":"-The UE stores the UE Inactive AS context;","paragraph_zero_based":441},{"literal_text_all_w_t_and_m_t":"-A RAN-based notification area is configured by RRC layer;","paragraph_zero_based":442},{"literal_text_all_w_t_and_m_t":"-Transfer of unicast data and/or signalling to/from UE over radio bearers configured for SDT.","paragraph_zero_based":443},{"literal_text_all_w_t_and_m_t":"-The UE:","paragraph_zero_based":444},{"literal_text_all_w_t_and_m_t":"-Monitors Short Messages transmitted with P-RNTI over DCI (see clause 6.5);","paragraph_zero_based":445},{"literal_text_all_w_t_and_m_t":"-During SDT procedure, monitors control channels associated with the shared data channel to determine if data is scheduled for it;","paragraph_zero_based":446},{"literal_text_all_w_t_and_m_t":"-While SDT procedure is not ongoing, monitors a Paging channel for CN paging using 5G-S-TMSI and RAN paging using fullI-RNTI, except if the UE is acting as a L2 U2N Remote UE;","paragraph_zero_based":447},{"literal_text_all_w_t_and_m_t":"-If configured by upper layers for MBS multicast reception, while SDT procedure is not ongoing, monitors a Paging channel for paging using TMGI;","paragraph_zero_based":448},{"literal_text_all_w_t_and_m_t":"-Performs neighbouring cell measurements and cell (re-)selection;","paragraph_zero_based":449},{"literal_text_all_w_t_and_m_t":"-Performs RAN-based notification area updates periodically and when moving outside the configured RAN-based notification area;","paragraph_zero_based":450},{"literal_text_all_w_t_and_m_t":"-Acquires system information and, while SDT procedure is not ongoing, can send SI request (if configured);","paragraph_zero_based":451},{"literal_text_all_w_t_and_m_t":"-While SDT procedure is not ongoing, performs logging of available measurements together with location and time for logged measurement configured UEs;","paragraph_zero_based":452},{"literal_text_all_w_t_and_m_t":"-While SDT procedure is not ongoing, performs idle/inactive measurements for idle/inactive measurement configured UEs;","paragraph_zero_based":453},{"literal_text_all_w_t_and_m_t":"-If configured by upper layers for MBS broadcast reception, acquires MCCH change notification and MBS broadcast control information and data;","paragraph_zero_based":454},{"literal_text_all_w_t_and_m_t":"-Transmits SRS for Positioning.","paragraph_zero_based":455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["1ef790d712319663e75e4e3166faddc3a7c1275031abdc6128bd3e5383a37a9f","7102ab13ab10c970fe1c2a677587ee3cc96e665600ad789441465803b34ac69e","91431af18ff06482182b79af78473de31f19a883120a13eb3d208603651c5e6e","bf75fa193eb906fdf32ad7c1a836e8e89c62e48e01085ea80b96e7290d32f4eb","086f5c1ae33bba04ef812d0920d7bd1b3ed6339e7a25f51beda83e53040e978e","f4994c1edd408807cae9ea8acc0f939690a2bf91e42b005f02ec2cb373ee8f72","b5a4450fa00a399891c2cdc6c24f546e83807a6bf93d62c62e8eb60c2d9a4d55","e07bac0246e9afde9985094606390d3789dbebc524d0b62d5013ab7c039f1b6f","7e41db1b850974f931ac25da95cbfb8f9131bd6c08806a4c2baecb6e3d378ffe","ac46272469cbda40e4ecb6443b5dacb116d0a1b681b0d06585af17937e985840","030fa2fa6bf0346520b593e38866536ede16ff4d6cd1aa4731ddd11db64235d7","d01a96a1ef55c65358de5813607d4f33fef3b900b05bb46cb9ca33181928f6d2","9bcb5a43e83f42b23a7d9574788f01d71728e35512b02b25ed885bec1bec7e1d","dbaac7ea09c71b7be5f35727fc9a3a15aa7934efd2c83cd4ff603cb33f0713fe","5fa7cb04f48e7a26b0c24bbb92d0efd42c043c0ea43d56f1cc54ae9ea8a0c45c","40043787e03872da16c72e48e4c70fbf687dc0e1078ecfe2fba7b6ed42fd557c","a64eaac86a88707a22d3e46440fb0efb73942e8af2ee43c01bc245988d3fca55","4fbe281a75f1fc1d67f5cb184787cf4703d3a7f0250430c3850dd06bf74d600a","276f0bae1ca3ccb7c35c0a9430eca16cdd9132de39f28dadd5e7d0d600e3cf57","dc5c016e0c95879227f6a118e756a054390357263a67c44296af7c0b0ea0d571","256d04e763cdc6407578c2ec532682112cb2151f85f5754a886c7805ed030860","3733671e70d34744b799ff792534ac06e25e74508b900e1dd736f8aa27f0003f","b8327603d60c40cd0c85e61e619f235f52e84ec4e3f2252f97ca27a0874e8375","7f27e4cfedd72b7df19ae848cec95fb5e832a953430f07c935ca17ef41bf3132"],"paragraph_range_zero_based":[432,455],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p432"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-RRC_CONNECTED:","paragraph_zero_based":456},{"literal_text_all_w_t_and_m_t":"-The UE stores the AS context;","paragraph_zero_based":457},{"literal_text_all_w_t_and_m_t":"-Transfer of unicast data to/from UE;","paragraph_zero_based":458},{"literal_text_all_w_t_and_m_t":"-Transfer of MBS multicast data to UE;","paragraph_zero_based":459},{"literal_text_all_w_t_and_m_t":"-At lower layers, the UE may be configured with a UE specific DRX;","paragraph_zero_based":460},{"literal_text_all_w_t_and_m_t":"-At lower layers, the UE may be configured with a DRX for PTM transmission of MBS broadcast and/or a DRX for MBS multicast;","paragraph_zero_based":461},{"literal_text_all_w_t_and_m_t":"-For UEs supporting CA, use of one or more SCells, aggregated with the SpCell, for increased bandwidth;","paragraph_zero_based":462},{"literal_text_all_w_t_and_m_t":"-For UEs supporting DC, use of one SCG, aggregated with the MCG, for increased bandwidth;","paragraph_zero_based":463},{"literal_text_all_w_t_and_m_t":"-Network controlled mobility within NR, to/from E-UTRA, and to UTRA-FDD;","paragraph_zero_based":464},{"literal_text_all_w_t_and_m_t":"-Network controlled mobility (path switch) between a serving cell and a L2 U2N Relay UE, or vice versa.","paragraph_zero_based":465},{"literal_text_all_w_t_and_m_t":"-The UE:","paragraph_zero_based":466},{"literal_text_all_w_t_and_m_t":"-Monitors Short Messages transmitted with P-RNTI over DCI (see clause 6.5), if configured;","paragraph_zero_based":467},{"literal_text_all_w_t_and_m_t":"-Monitors control channels associated with the shared data channel to determine if data is scheduled for it;","paragraph_zero_based":468},{"literal_text_all_w_t_and_m_t":"-Provides channel quality and feedback information;","paragraph_zero_based":469},{"literal_text_all_w_t_and_m_t":"-Performs neighbouring cell measurements and measurement reporting;","paragraph_zero_based":470},{"literal_text_all_w_t_and_m_t":"-Acquires system information;","paragraph_zero_based":471},{"literal_text_all_w_t_and_m_t":"-Performs immediate MDT measurement together with available location reporting;","paragraph_zero_based":472},{"literal_text_all_w_t_and_m_t":"-If configured by upper layers for MBS broadcast reception, acquires MCCH change notification and MBS broadcast control information and data.","paragraph_zero_based":473},{"literal_text_all_w_t_and_m_t":"Figure 4.2.1-1 illustrates an overview of UE RRC state machine and state transitions in NR. A UE has only one RRC state in NR at one time.","paragraph_zero_based":474},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":475},{"literal_text_all_w_t_and_m_t":"Figure 4.2.1-1:UE state machine and state transitions in NR","paragraph_zero_based":476},{"literal_text_all_w_t_and_m_t":"Figure 4.2.1-2 illustrates an overview of UE state machine and state transitions in NR as well as the mobility procedures supported between NR/5GC, E-UTRA/EPC and E-UTRA/5GC.","paragraph_zero_based":477},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":478},{"literal_text_all_w_t_and_m_t":"Figure 4.2.1-2:UE state machine and state transitions between NR/5GC, E-UTRA/EPC and E-UTRA/5GC","paragraph_zero_based":479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["083686e0fc11c22543be5de596b4ab5cd3d9d2e8359daa97e945c36dafd75bca","97fe4d90a4aa44e14a4e356d75ac0d18efe6439a2d308e0734973f7e06c8d5b8","af7d3c89ff912a01fd00ed212d766440ea4c3312d5d66de1ea8cda78e17859be","358290fa5656e7d1844975430c7f65d574908fab3dc678d8c0ffff0cacb0c09b","a45343ef7f298e589247a08e5a2a7fd666b4d397b81f6e39eee9a2010799aede","539c13c8665f5edd592ea45ebe643eccfad7e7646d9c7cd01633208fa4146f25","18aabba9e422d8efaca91635f137e7b88eb8e19b4e87764208417b17909c7da9","b7656f193c54ba1dc2372834eabd9f081bc56caccea781fda47006050209c3bb","6bf84f7174e44f49a152e1b4f8842499e8af6ddc12cf94d49716264580c4fafd","c80c18a93e45c74c2da8b1d84eebb0db48b1e59acda0157bb5c76ae090d8880f","6d3edea533eb1871826d06a4495b0e3a9c8bb930b95ec9cfb38a7bb294c92a8a","fcf9f48db9d069af66dbe61c6dbe71a88e3ea9024082e08b91ff78855cc89489","ce3604a7474244dd9c7628642fdf1ae8fb787ed999a2994a30cf5acd06a564f2","29afe922463b8542912306ee6b73d3765c90f326aeb1732c222b52a0a7db4069","11bf652c512943d7ce5c7e2bb6666fbb7e513224d14ffb4cda89bf63969140e2","ec9275159998cc7568f8983d23780cb1a2cae4f46d09afcaa629e8b20275d1aa","5e80fa7cb655b92af62023634d0784b4af5c71aad4098b5d8ba16aa94d9aef33","2ac45a56641df1202385d1e7ddf086b456c6afb81145a61f8b6d6c0bd595cb26","cc5c2869a0b8bc793c0f20e85f13ee4ec5bfacba61ab5ee86e56e2339ed249f2","cdbae205f9e096d4c486c5e491b4c15e07680c47b231a215b3acce1a1feef602","98ea2e9013cb927346f02d473183927cb4cee3674a6643958249c1f84184ed85","b785a174be42fa4f86eaa2dc34c1e960ac3d9698b1ecf39cba664585d139ffb4","fab3aa9bc5f7b3b1ffc841df27de0ad6f28180c2eea1e7979de0c6ce9127ae06","3bb0500c85207f8887b3eba5beb91988eb25a2dc968f184337848bb4e7d1d286"],"paragraph_range_zero_based":[456,479],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p456"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Figure 4.2.1-3 illustrates the mobility procedure supported between NR/5GC and UTRA-FDD.","paragraph_zero_based":480},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":481},{"literal_text_all_w_t_and_m_t":"Figure 4.2.1-3:Mobility procedure supported between NR/5GC and UTRA-FDD","paragraph_zero_based":482},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":483},{"literal_text_all_w_t_and_m_t":"4.2.2Signalling radio bearers","paragraph_zero_based":484},{"literal_text_all_w_t_and_m_t":"\"Signalling Radio Bearers\" (SRBs) are defined as Radio Bearers (RBs) that are used only for the transmission of RRC and NAS messages. More specifically, the following SRBs are defined:","paragraph_zero_based":485},{"literal_text_all_w_t_and_m_t":"-SRB0 is for RRC messages using the CCCH logical channel;","paragraph_zero_based":486},{"literal_text_all_w_t_and_m_t":"-SRB1 is for RRC messages (which may include a piggybacked NAS message) as well as for NAS messages prior to the establishment of SRB2, all using DCCH logical channel;","paragraph_zero_based":487},{"literal_text_all_w_t_and_m_t":"-SRB2 is for NAS messages and for RRC messages which include logged measurement information, all using DCCH logical channel. SRB2 has a lower priority than SRB1 and may be configured by the network after AS security activation;","paragraph_zero_based":488},{"literal_text_all_w_t_and_m_t":"-SRB3 is for specific RRC messages when UE is in (NG)EN-DC or NR-DC, all using DCCH logical channel;","paragraph_zero_based":489},{"literal_text_all_w_t_and_m_t":"-SRB4 is for RRC messages which include application layer measurement report information, all using DCCH logical channel. SRB4 has a lower priority than SRB1 and can only be configured by the network after AS security activation.","paragraph_zero_based":490},{"literal_text_all_w_t_and_m_t":"In downlink, piggybacking of NAS messages is used only for one dependant (i.e. with joint success/failure) procedure: bearer establishment/modification/release. In uplink piggybacking of NAS message is used only for transferring the initial NAS message during connection setup and connection resume.","paragraph_zero_based":491},{"literal_text_all_w_t_and_m_t":"NOTE 1:The NAS messages transferred via SRB2 are also contained in RRC messages, which however do not include any RRC protocol control information.","paragraph_zero_based":492},{"literal_text_all_w_t_and_m_t":"Once AS security is activated, all RRC messages on SRB1, SRB2, SRB3 and SRB4, including those containing NAS messages, are integrity protected and ciphered by PDCP. NAS independently applies integrity protection and ciphering to the NAS messages, see TS 24.501 [23].","paragraph_zero_based":493},{"literal_text_all_w_t_and_m_t":"Split SRB is supported for all the MR-DC options in both SRB1 and SRB2 (split SRB is not supported for SRB0, SRB3 and SRB4).","paragraph_zero_based":494},{"literal_text_all_w_t_and_m_t":"For operation with shared spectrum channel access in FR1, SRB0, SRB1 and SRB3 are assigned with the highest priority Channel Access Priority Class (CAPC), (i.e. CAPC = 1) while CAPC for SRB2 is configurable.","paragraph_zero_based":495},{"literal_text_all_w_t_and_m_t":"4.3Services","paragraph_zero_based":496},{"literal_text_all_w_t_and_m_t":"4.3.1Services provided to upper layers","paragraph_zero_based":497},{"literal_text_all_w_t_and_m_t":"The RRC protocol offers the following services to upper layers:","paragraph_zero_based":498},{"literal_text_all_w_t_and_m_t":"-Broadcast of common control information;","paragraph_zero_based":499},{"literal_text_all_w_t_and_m_t":"-Notification of UEs in RRC_IDLE, e.g. about a mobile terminating call;","paragraph_zero_based":500},{"literal_text_all_w_t_and_m_t":"-Notification of UEs about ETWS and/or CMAS;","paragraph_zero_based":501},{"literal_text_all_w_t_and_m_t":"-Transfer of dedicated signalling;","paragraph_zero_based":502},{"literal_text_all_w_t_and_m_t":"-Broadcast of positioning assistance data;","paragraph_zero_based":503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["2846370befd9a430738205742e1c1668c8a0d5b05d67863705cde674ee427a76","aca8b116d8245c5aeb6f3f2ef7dce6814f8b24c3174ac223d0873f43fc69ebc3","2127075af4778a893353aa5def934e5ae2ef10025e7d7c448c645fd25e08b7bf","83be2048fc5504f7648b9db0fc08f08fa3760734ab0328025229265a67af579e","584d40e721d27b0481706c76ac33b694bd41f054315be90280bfc628e3458aba","abc919255515eb40926d09b9fe0af5d5b705d82bb6a9e78b33d60f6ffdd080ec","aa1fd1ec8ebbbf6bc4eaa29e4f3608527b40b5dd7857aa5b8339b2d7a0bc0fb3","05433a76baf32677119abbc5ca1c1ca3fde5ac7d74b5e3765a97bea4d669be7a","6b24291595e3af0491061c89ac0a8ef912e1e561de79d67285cfc48677ed30c4","ea6cf794beb5b645e468d44fe180f179e1c8de90d69589251f20fa2685892d50","416e60e175557bf53639ce6c128ae58736775736352863bf3359caed719cf5ee","c519ef0d49cdba6f5954c2fb2bdcd650cf5dd4b0cded714e397fa75eb0336ae3","41994e03268e7fc489b668985b0dd862e45cfa47cce70259c06a3931d5566109","8d0b06282d63e00b8aadf04247f3652e8ce13ec4140067e15525ac508bd86011","894832b2ba0b12a8f2f3cca539070b3bb19fa67782f7f767435c3c937e1524d3","610fe0e22f1fdac3e1ec916016925572e370ec4d27c6a5dc23fe178ce9c45699","5e8337cb308c303dba9becf018aec43c5eedd12710b0bc6a438424f521734e18","6228c270e94faa3db80c0704ba344f0e73cd9cf0f0837e364b49ebf40d66e61b","6db96753bfb0d120474a36002c78088a9b934a9c3f66c3e593e380e9ca5a67e9","5eafc2a6394e579d6160eee2e67db154c0021ce7aeecce8e7e3a35565da5fdc6","cc344b5affb3b91412decbad7b4b3a39467f81311c220147e1113020ecb8f105","0a57a588113529bd0861ea3ce35299bf819875537d4097bb1c5ee8868924f5f6","0de2c3fa8bfd85786b5873e5be6b65a6b0bf6bc77a9ed3fabc229e45c2eb6669","df9ff796a0e033978a979b93f979d8b3a4ebcf63611c906fb1862d3c97571e6a"],"paragraph_range_zero_based":[480,503],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p480"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-Transfer of application layer measurement configuration and reporting.","paragraph_zero_based":504},{"literal_text_all_w_t_and_m_t":"4.3.2Services expected from lower layers","paragraph_zero_based":505},{"literal_text_all_w_t_and_m_t":"In brief, the following are the main services that RRC expects from lower layers:","paragraph_zero_based":506},{"literal_text_all_w_t_and_m_t":"-Integrity protection, ciphering and loss-less in-sequence delivery of information without duplication;","paragraph_zero_based":507},{"literal_text_all_w_t_and_m_t":"4.4Functions","paragraph_zero_based":508},{"literal_text_all_w_t_and_m_t":"The RRC protocol includes the following main functions:","paragraph_zero_based":509},{"literal_text_all_w_t_and_m_t":"-Broadcast of system information:","paragraph_zero_based":510},{"literal_text_all_w_t_and_m_t":"-Including NAS common information;","paragraph_zero_based":511},{"literal_text_all_w_t_and_m_t":"-Information applicable for UEs in RRC_IDLE and RRC_INACTIVE (e.g. cell (re-)selection parameters, neighbouring cell information) and information (also) applicable for UEs in RRC_CONNECTED (e.g. common channel configuration information);","paragraph_zero_based":512},{"literal_text_all_w_t_and_m_t":"-Including ETWS notification, CMAS notification;","paragraph_zero_based":513},{"literal_text_all_w_t_and_m_t":"-Including positioning assistance data.","paragraph_zero_based":514},{"literal_text_all_w_t_and_m_t":"-RRC connection control:","paragraph_zero_based":515},{"literal_text_all_w_t_and_m_t":"-Paging;","paragraph_zero_based":516},{"literal_text_all_w_t_and_m_t":"-Establishment/modification/suspension/resumption/release of RRC connection, including e.g. assignment/modification of UE identity (C-RNTI, fullI-RNTI, etc.), establishment/modification/suspension/resumption/release of SRBs (except for SRB0);","paragraph_zero_based":517},{"literal_text_all_w_t_and_m_t":"-Access barring;","paragraph_zero_based":518},{"literal_text_all_w_t_and_m_t":"-Initial AS security activation, i.e. initial configuration of AS integrity protection (SRBs, DRBs) and AS ciphering (SRBs, DRBs);","paragraph_zero_based":519},{"literal_text_all_w_t_and_m_t":"-RRC connection mobility including e.g. intra-frequency and inter-frequency handover, path switch from a PCell to a target L2 U2N Relay UE or from a L2 U2N Relay UE to a target PCell, associated AS security handling, i.e. key/algorithm change, specification of RRC context information transferred between network nodes;","paragraph_zero_based":520},{"literal_text_all_w_t_and_m_t":"-Establishment/modification/suspension/resumption/release of RBs carrying user data (DRBs/MRBs);","paragraph_zero_based":521},{"literal_text_all_w_t_and_m_t":"-Radio configuration control including e.g. assignment/modification of ARQ configuration, HARQ configuration, DRX configuration;","paragraph_zero_based":522},{"literal_text_all_w_t_and_m_t":"-In case of DC, cell management including e.g. change of PSCell, addition/modification/release of SCG cell(s);","paragraph_zero_based":523},{"literal_text_all_w_t_and_m_t":"-In case of CA, cell management including e.g. addition/modification/release of SCell(s);","paragraph_zero_based":524},{"literal_text_all_w_t_and_m_t":"-QoS control including assignment/ modification of semi-persistent scheduling (SPS) configuration and configured grant configuration for DL and UL respectively, assignment/ modification of parameters for UL rate control in the UE, i.e. allocation of a priority and a prioritised bit rate (PBR) for each RB of UE and logical channel of IAB-MT.","paragraph_zero_based":525},{"literal_text_all_w_t_and_m_t":"-Recovery from radio link failure.","paragraph_zero_based":526},{"literal_text_all_w_t_and_m_t":"-Inter-RAT mobility including e.g. AS security activation, transfer of RRC context information;","paragraph_zero_based":527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["55a4825aeb3d881c7433c25aab4c1d329a075b3bc1c0d06db4b3c3e3feb1e7f1","f1551df7bf2e0d46de31fd6ed3afd9ffa8a8eeff55a7f81668579ebfbf20304e","1cd76d5c596330a6ae95aa87ca71d9377e85d422846a45fafe6ebc63706a5629","1f4ce520cfe08dabc2c5bb7aee588033cd23342d97b5691705a6195b552df0cd","2b6400e2147ec166b45968eff07ea6a84bec7f30b9cf50302d776e36d478597c","78e3c0d29a3acbcd6908c6bd38c3e67ac23123c792d7d3ede7f624cf431f3d05","94cb792233de4601dc1743a221bd88523c2ac53a07d2cf27cd04e799ca35965a","f1beb28848766c352f90dadf6e7d48585d4a19e9736ed863ad3c49debd0b86b4","ed45e6e4c16a2c59b1f4a1247e8915281e47090a73d1ad3f09bc7e10d6d0c46b","556e2dc7489e920d098bc7a732521a18d956271f6490593b40146412856e6175","229becaa1e03259d1922534940090dccf2bfba7bfe01c19a2c7f201e18ddafe5","e96427b897ce69a28cbf4d881357e9c03347f3c160a52c1b0ed45f25152e7006","07853abd8bcd082f7285f5b2cf500cc2b3f37158c0e8297e8373b7a684d997b2","7ad5d38e1bca54dd32261f1cbf094e3343411cf7674d602d1ec6e18535d01fd2","dc05894f99b044aee4199c294705aefdf57e8c313c4f06679aee438bb5c8a58f","5d2a8c60ae78b263fb5961301e9043398e24ea29d108d19abe6473d0c38bc92c","0cbb9a58d82a5a64ee3141d1607beaac9dee3490a598d49c54a807bd3480bc81","2468df65dec86feb7534a459e245b757c24cd7746c29d334cf65408775648b28","37333180a3e54021482a0ff3327bb24c7ce2bd30d6d2ef90c9a575d3f9b98ef2","37e6e42bdaf239cf1648ae03d175a745db71647d3ac1f404802c42567f53b957","2fd25bc44bfb96881ed26dcefbdf155d2e4159694d6254c7b4a6e99b623b0cec","409675f96e3dc8ad68daf555b01cf0c632d73eb63e7e182cf397dc85bc0d7a9e","68e3519f1151b1cfbeecdc744e4d301c4bbba697770dd2420adbe22fe6cf8635","61e2d8d46964a03fc50f7257c25ec1414f9e2384e04c1c866136dbf34658f8df"],"paragraph_range_zero_based":[504,527],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p504"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-Measurement configuration and reporting:","paragraph_zero_based":528},{"literal_text_all_w_t_and_m_t":"-Establishment/modification/release of measurement configuration (e.g. intra-frequency, inter-frequency and inter- RAT measurements);","paragraph_zero_based":529},{"literal_text_all_w_t_and_m_t":"-Setup and release of measurement gaps;","paragraph_zero_based":530},{"literal_text_all_w_t_and_m_t":"-Measurement reporting.","paragraph_zero_based":531},{"literal_text_all_w_t_and_m_t":"-Configuration of BAP entity and BH RLC channels for the support of IAB-node.","paragraph_zero_based":532},{"literal_text_all_w_t_and_m_t":"-Configuration of SRAP entity and Uu/PC5 Relay RLC channels for the support of L2 U2N relay.","paragraph_zero_based":533},{"literal_text_all_w_t_and_m_t":"-Other functions including e.g. generic protocol error handling, transfer of dedicated NAS information, transfer of UE radio access capability information.","paragraph_zero_based":534},{"literal_text_all_w_t_and_m_t":"-Support of self-configuration and self-optimisation.","paragraph_zero_based":535},{"literal_text_all_w_t_and_m_t":"-Support of measurement logging and reporting for network performance optimisation, as specified in TS 37.320 [61];","paragraph_zero_based":536},{"literal_text_all_w_t_and_m_t":"-Support of transfer of application layer measurement configuration and reporting.","paragraph_zero_based":537},{"literal_text_all_w_t_and_m_t":"5Procedures","paragraph_zero_based":538},{"literal_text_all_w_t_and_m_t":"5.1General","paragraph_zero_based":539},{"literal_text_all_w_t_and_m_t":"5.1.1Introduction","paragraph_zero_based":540},{"literal_text_all_w_t_and_m_t":"This clause covers the general requirements.","paragraph_zero_based":541},{"literal_text_all_w_t_and_m_t":"5.1.2General requirements","paragraph_zero_based":542},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":543},{"literal_text_all_w_t_and_m_t":"1>process the received messages in order of reception by RRC, i.e. the processing of a message shall be completed before starting the processing of a subsequent message;","paragraph_zero_based":544},{"literal_text_all_w_t_and_m_t":"NOTE:Network may initiate a subsequent procedure prior to receiving the UE's response of a previously initiated procedure.","paragraph_zero_based":545},{"literal_text_all_w_t_and_m_t":"1>within a clause execute the steps according to the order specified in the procedural description;","paragraph_zero_based":546},{"literal_text_all_w_t_and_m_t":"1>consider the term 'radio bearer' (RB) to cover SRBs, DRBs and MRBs unless explicitly stated otherwise;","paragraph_zero_based":547},{"literal_text_all_w_t_and_m_t":"1>set the rrc-TransactionIdentifier in the response message, if included, to the same value as included in the message received from the network that triggered the response message;","paragraph_zero_based":548},{"literal_text_all_w_t_and_m_t":"1>upon receiving a choice value set to setup:","paragraph_zero_based":549},{"literal_text_all_w_t_and_m_t":"2>apply the corresponding received configuration and start using the associated resources, unless explicitly specified otherwise;","paragraph_zero_based":550},{"literal_text_all_w_t_and_m_t":"1>upon receiving a choice value set to release:","paragraph_zero_based":551}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["1489c8c21b541e6df8a2a22d726eab1cf14aed77f0349a7405a8db1a60331e6d","a6bd6718be9db78f9ded3d67e70af43524269694b5787674680685b16bfb8c7b","3dd802be9dbb40921cf4e22753d8f82208f2b4e1e642dea7147d8bdf11930a9d","61992d21a685df8ae703da9f238fc0b7de07671c0cad1d01862592f7be4d152b","83aaee1309a136ba4a76d910ab2fab0fae26f75e2d6328c81e7501600e48b914","7e92aa9580217608810d4b6515cc9be41d7fa3e6aace89d68a46a3c6afa8758e","da66a7c5fec7e67295b27afcc40d3b554b796fcb9fef6d8e21bd00efdffc5bb8","bce1b2ff126b7e1a3e5dc9f05125d562055f52fa39c3cae8dc4712cde4bd1675","4833374e18c77f2cc420d8e73a11318f7f145493d005fffe37c6bd8da97d88ef","114aa81b90d8cebc14c9f4fac45e4758ba8699bad2187bca505acd45cd99c611","22a551755ca2fa120fc806773ff6b8fe500ec157fbf01d13e62a5c767265916b","e51749fb847e5f88bce416286dbdc62fb17b9680942773341e4ba3cb6986d18d","1200f4fef58ae3cb893b49c8a6edfece9824ca0b044af4ea4d03817d2b1b0044","1fe587bb0cb56a76b2387a1096175a9aa733063944ebc384a787d7b27e2d211c","804409bbe0eddacb0549c7c81b6cecc2f9469af180f741f2d634ac550a973506","98a3ae34106deb118c86df003402a160145cb0761b4e9ef21c5e1ce8970c6d23","f322209fe188efb127cb4ae23315e4480fa3da995b542e7d4f355fd98cfc7e7b","3f94ec45b29600c94d114dd3cfb14dd7c324416c75fbd89d68aa692547412703","0430d9d107478b3283d7b2cef7141e8de4949dfb58456613419e65e3a3f380a2","fe93f11513dd08df2648c3727c21973aabe6adf2aa39ef677e125f097ca9b2c9","dbe4c283a8a326de032a3c7d44bfe843aa373472e037d4b25087b3371361ab40","3627bd2caac514dbe51b92c4dcece91793d862e48c0ff9091393675909c77e22","4bbee82756db2942d336d9303d6dce73b82bb344d4a15f9b7e593c05d6527df6","80535791395eebd758edd207573c6e0203cb72edeb7f29c1f85b4c1acee2931e"],"paragraph_range_zero_based":[528,551],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p528"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>clear the corresponding configuration and stop using the associated resources;","paragraph_zero_based":552},{"literal_text_all_w_t_and_m_t":"1>in case the size of a list is extended, upon receiving an extension field comprising the entries in addition to the ones carried by the original field (regardless of whether the network signals more entries in total); apply the following generic behaviour unless explicitly stated otherwise:","paragraph_zero_based":553},{"literal_text_all_w_t_and_m_t":"2>create a combined list by concatenating the additional entries included in the extension field to the original field while maintaining the order among both the original and the additional entries;","paragraph_zero_based":554},{"literal_text_all_w_t_and_m_t":"2>for the combined list, created according to the previous, apply the same behaviour as defined for the original field.","paragraph_zero_based":555},{"literal_text_all_w_t_and_m_t":"5.1.3Requirements for UE in MR-DC","paragraph_zero_based":556},{"literal_text_all_w_t_and_m_t":"In this specification, the UE considers itself to be in:","paragraph_zero_based":557},{"literal_text_all_w_t_and_m_t":"-EN-DC, if and only if it is configured with nr-SecondaryCellGroupConfig according to TS 36.331[10], and it is connected to EPC,","paragraph_zero_based":558},{"literal_text_all_w_t_and_m_t":"-NGEN-DC, if and only if it is configured with nr-SecondaryCellGroupConfig according to TS 36.331[10], and it is connected to 5GC,","paragraph_zero_based":559},{"literal_text_all_w_t_and_m_t":"-NE-DC, if and only if it is configured with mrdc-SecondaryCellGroup set to eutra-SCG,","paragraph_zero_based":560},{"literal_text_all_w_t_and_m_t":"-NR-DC, if and only if it is configured with mrdc-SecondaryCellGroup set to nr-SCG,","paragraph_zero_based":561},{"literal_text_all_w_t_and_m_t":"-MR-DC, if and only if it is in (NG)EN-DC, NE-DC or NR-DC.","paragraph_zero_based":562},{"literal_text_all_w_t_and_m_t":"NOTE:This use of these terms deviates from the definition in TS 37.340 [41] and other specifications. In TS 37.340, these terms include also the case where the UE is configured with E-UTRA or NR MCG only (i.e. no NR or E-UTRA SCG) but with one or more bearers terminated in a secondary node (i.e. using NR PDCP).","paragraph_zero_based":563},{"literal_text_all_w_t_and_m_t":"The UE in (NG)EN-DC only executes a subclause of clause 5 in this specification when the subclause:","paragraph_zero_based":564},{"literal_text_all_w_t_and_m_t":"-is referred to from a subclause under execution, either in this specification or in TS 36.331 [10]; or","paragraph_zero_based":565},{"literal_text_all_w_t_and_m_t":"-applies to a message received on SRB3 (if SRB3 is established); or","paragraph_zero_based":566},{"literal_text_all_w_t_and_m_t":"-applies to field(s), IE(s), UE variable(s) or timer(s) in this specification that the UE is configured with.","paragraph_zero_based":567},{"literal_text_all_w_t_and_m_t":"When executing a subclause of clause 5 in this specification, the UE follows the requirements in clause 5.1.2 and in all subclauses of this specification applicable to the messages (including processing time requirements), fields, IEs, timers and UE variables indicated in the subclause under execution.","paragraph_zero_based":568},{"literal_text_all_w_t_and_m_t":"Next Change","paragraph_zero_based":569},{"literal_text_all_w_t_and_m_t":"5.2System information","paragraph_zero_based":570},{"literal_text_all_w_t_and_m_t":"5.2.1Introduction","paragraph_zero_based":571},{"literal_text_all_w_t_and_m_t":"System Information (SI) is divided into the MIB and a number of SIBs and posSIBs where:","paragraph_zero_based":572},{"literal_text_all_w_t_and_m_t":"-the MIB is always transmitted on the BCH with a periodicity of 80 ms and repetitions made within 80 ms (TS 38.212 [17], clause 7.1) and it includes parameters that are needed to acquire SIB1 from the cell. The first transmission of the MIB is scheduled in subframes as defined in TS 38.213 [13], clause 4.1 and repetitions are scheduled according to the period of SSB;","paragraph_zero_based":573},{"literal_text_all_w_t_and_m_t":"NOTE 1:If the period of SSB is larger than 80 ms, the MIB is transmitted with the same periodicity as that of SSB.","paragraph_zero_based":574},{"literal_text_all_w_t_and_m_t":"-the SIB1 is transmitted on the DL-SCH with a periodicity of 160 ms and variable transmission repetition periodicity within 160 ms as specified in TS 38.213 [13], clause 13. The default transmission repetition periodicity of SIB1 is 20 ms but the actual transmission repetition periodicity is up to network implementation. For SSB and CORESET multiplexing pattern 1, SIB1 repetition transmission period is 20 ms. For SSB and CORESET multiplexing pattern 2/3, SIB1 transmission repetition period is the same as the SSB period (TS 38.213 [13], clause 13). SIB1 includes information regarding the availability and scheduling (e.g. mapping of SIBs to SI message, periodicity, SI-window size) of other SIBs with an indication whether one or more SIBs are only provided on-demand and, in that case, the configuration needed by the UE to perform the SI request. SIB1 is cell-specific SIB;","paragraph_zero_based":575}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["5582e51f4200ab047bd8d65d7ec03aec510baad076fb4eec99fa76459dbcf45e","6bc4497e9baa2d4669aefcce377e3bada58415e915486595f2ac66b2c385c75e","382858cc668c64bdb17e9f90e64692329e740e9df5f495ecd0df8dcb97e15b28","867b86b7b534c1a9322c06ed85c4a386236b72394b64600d845b336d5071815f","4ba3bb2e71a7a7c061669ce32a4aa5db47260a9f0fb5d0c8774b879f008145b9","11b23c6a03f5168e97e667446c727937454a24378d0e46a05808086a6cf28566","c021ca0c4588040f6b8f44a8e9ca375735cea3f32b203ae00649f32f8e49b526","30a891a006f1642c5e0684a1083fdb3ad9f371f33346f71d272c635bb35f0af1","8f60b9e79963678f351b2291230fe65b1b22830c697165ac7a707aac8d907461","ee9b6b7039c93f861ff93ad33564712ea67fb51f5dcc6ec7ee2a3a6aef1ad117","e59acc246417e801c32655699b0e443e865b60f9ab7d575c20c8cc1c12a15a53","bb4664ad2079d10ebdfa79240c4b0a306909246e27eee0b830faa2a1f265d1c4","40ac2b4bb39204f0f5e696620711e6fba45d233ea2f9a28d1c07cf7effc45394","2673f116f97dc8f7bc0de94a0b6a8deefe4dfef2302d79e6c8d81b4f1ae584f4","69fb49137b871ee2ff1740efb7cee4d8e95a549fa31bf217ec915347d5b8dd2c","72260ead06e90a6582c62026249cc2005593d2764f8d02bba54cc5d1428ad9c6","83de163c95eee93612a5e84fd95c1e3e978ec1f69909aac516c48b7810ecc310","cd7e603a41fa2a9cd971ec24cf2f3b1016200f86a9968cef7d27cd291da87316","1f9b4837bc43214236f8f4c50b058c90fd1133d844ee283f666a01c7976c1982","84658cde07cb946e51664e304cc14ff926ccf4f3db094a1f633ace923de9115e","4b4cf5554309a56c2494816c3bb387a8f01d03e42d93bb06d4ec7940a0356a72","6d50a0d8856e6a2c9ea2d88087da13cd80d5bc3c41910aa09da509123e3cf3fc","068afd3f7649f008f00e084435ebfdbb4a7e6306d0ee25a30e333a9adfb6895e","ddd4fea902dfc29c8f0b9cf7238165af85e492c7a986d0e5349376cf2d37288c"],"paragraph_range_zero_based":[552,575],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p552"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-SIBs other than SIB1 and posSIBs are carried in SystemInformation (SI) messages, which are transmitted on the DL-SCH. Only SIBs or posSIBs having the same periodicity can be mapped to the same SI message. SIBs and posSIBs are mapped to different SI messages, i.e. an SI message contains either only SIBs or only posSIBs. Each SI message is transmitted within periodically occurring time domain windows (referred to as SI-windows with same length for all SI messages). Each SI message is associated with an SI-window and the SI-windows of different SI messages do not overlap. That is, within one SI-window only the corresponding SI message is transmitted. An SI message may be repeated with the same content a number of times within the SI-window. Any SIB or posSIB except SIB1 can be configured to be cell specific or area specific, using an indication in SIB1. The cell specific SIB is applicable only within a cell that provides the SIB while the area specific SIB is applicable within an area referred to as SI area, which consists of one or several cells and is identified by systemInformationAreaID;","paragraph_zero_based":576},{"literal_text_all_w_t_and_m_t":"-The mapping of SIBs to SI messages is configured in schedulingInfoList and schedulingInfoList2, while the mapping of posSIBs to SI messages is configured in posSchedulingInfoList and schedulingInfoList2.Each SIB and each posSIB is mapped to a single SI message. posSIBs of the same posSibType carrying GNSS Generic Assistance Data for different GNSS/SBAS (identified by gnss-id/sbas-id, see TS 37.355 [49]) are mapped to different SI messages.Each SIB and posSIB is contained at most once in an SI message.For SIBs and posSIBs with segments, the segments contained in SI messages are transmitted according to the SI message periodicity, with one segment of a particular sibType/posSibType in each SI message;","paragraph_zero_based":577},{"literal_text_all_w_t_and_m_t":"-For a UE in RRC_CONNECTED, the network can provide system information through dedicated signalling using the RRCReconfiguration message, e.g. if the UE has an active BWP with no common search space configured to monitor system information, paging, or upon request from the UE.","paragraph_zero_based":578},{"literal_text_all_w_t_and_m_t":"-For PSCell and SCells, the network provides the required SI by dedicated signalling, i.e. within an RRCReconfiguration message. Nevertheless, the UE shall acquire MIB of the PSCell to get SFN timing of the SCG (which may be different from MCG). Upon change of relevant SI for SCell, the network releases and adds the concerned SCell. For PSCell, the required SI can only be changed with Reconfiguration with Sync.","paragraph_zero_based":579},{"literal_text_all_w_t_and_m_t":"NOTE 2:The physical layer imposes a limit to the maximum size a SIB can take. The maximum SIB1 or SI message size is 2976 bits.","paragraph_zero_based":580},{"literal_text_all_w_t_and_m_t":"5.2.2System information acquisition","paragraph_zero_based":581},{"literal_text_all_w_t_and_m_t":"5.2.2.1General UE requirements","paragraph_zero_based":582},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":583},{"literal_text_all_w_t_and_m_t":"Figure 5.2.2.1-1: System information acquisition","paragraph_zero_based":584},{"literal_text_all_w_t_and_m_t":"The UE applies the SI acquisition procedure to acquire the AS, NAS- and positioning assistance data information. The procedure applies to UEs in RRC_IDLE, in RRC_INACTIVE and in RRC_CONNECTED.","paragraph_zero_based":585},{"literal_text_all_w_t_and_m_t":"The UE in RRC_IDLE and RRC_INACTIVE shall ensure having a valid version of (at least) the MIB, SIB1 through SIB4, SIB5 (if the UE supports E-UTRA), SIB11 (if the UE is configured for idle/inactive measurements), SIB12 (if UE is capable of NR sidelink communication/discovery and is configured by upper layers to receive or transmit NR sidelink communication/discovery), and SIB13, SIB14 (if UE is capable of V2X sidelink communication and is configured by upper layers to receive or transmit V2X sidelink communication), SIB15 (if UE is configured by upper layers to report disaster roaming related information), SIB16 (if the UE is capable of slice-based cell reselection and the UE receives NSAG information for cell reselection from upper layer), SIB17 (if the UE is using TRS resources for power saving in RRC_IDLE and RRC_INACTIVE) and SIB19 (if UE is accessing NR via NTN access).","paragraph_zero_based":586},{"literal_text_all_w_t_and_m_t":"The UE capable of MBS broadcast which is receiving or interested to receive MBS broadcast service(s) via a broadcast MRB shall ensure having a valid version of SIB20, regardless of the RRC state the UE is in.","paragraph_zero_based":587},{"literal_text_all_w_t_and_m_t":"The UE shall ensure having a valid version of the posSIB requested by upper layers.","paragraph_zero_based":588},{"literal_text_all_w_t_and_m_t":"5.2.2.2SIB validity and need to (re)-acquire SIB","paragraph_zero_based":589},{"literal_text_all_w_t_and_m_t":"5.2.2.2.1SIB validity","paragraph_zero_based":590},{"literal_text_all_w_t_and_m_t":"The UE shall apply the SI acquisition procedure as defined in clause 5.2.2.3 upon cell selection (e.g. upon power on), cell-reselection, return from out of coverage, after reconfiguration with sync completion, after entering the network from another RAT, upon receiving an indication that the system information has changed, upon receiving a PWS notification, upon receiving request (e.g., a positioning request) from upper layers; and whenever the UE does not have a valid version of a stored SIB or posSIB or a valid version of a requested SIB.","paragraph_zero_based":591},{"literal_text_all_w_t_and_m_t":"When the UE acquires a MIB or a SIB1 or an SI message in a serving cell as described in clause 5.2.2.3, and if the UE stores the acquired SIB, then the UE shall store the associated areaScope, if present, the first PLMN-Identity in the PLMN-IdentityInfoList for non-NPN-only cells or the first NPN identity (SNPN identity in case of SNPN, or PNI-NPN identity in case of PNI-NPN) in the NPN-IdentityInfoList for NPN-only cells, the cellIdentity, the systemInformationAreaID, if present, and the valueTag, if present, as indicated in the si-SchedulingInfo for the SIB. If the UE stores the acquired posSIB, then the UE shall store the associated areaScope, if present, the cellIdentity, the systemInformationAreaID, if present, the valueTag, if provided in assistanceDataSIB-Element, and the expirationTime if provided in assistanceDataSIB-Element. The UE may use a valid stored version of the SI except MIB, SIB1, SIB6, SIB7 or SIB8 e.g. after cell re-selection, upon return from out of coverage or after the reception of SI change indication. The valueTag and expirationTime for posSIB is optionally provided in assistanceDataSIB-Element, as specified in TS 37.355 [49].","paragraph_zero_based":592},{"literal_text_all_w_t_and_m_t":"A L2 U2N Remote UE in RRC_IDLE or RRC_INACTIVE can inform the interested SIB(s) to the connected L2 U2N Relay UE as defined in clause 5.8.9.8.2 and receive the SIB(s) from the L2 U2N Relay UE as defined in clause 5.8.9.9.3. A L2 U2N Remote UE in RRC_CONNECTED receives SIB1 and other SIB(s) in RRCReconfiguration message and performs on-demand SI request if required, as defined in clause 5.2.2.3.5 and 5.2.2.3.6. The L2 U2N Remote UE in RRC_IDLE or RRC_INACTIVE or RRC_CONNECTED is not required to obtain SI over Uu interface, but it may decide to perform the SI acquisition procedure over Uu interface as defined in clause 5.2.2.3 by UE implementation.","paragraph_zero_based":593},{"literal_text_all_w_t_and_m_t":"NOTE:The storage and management of the stored SIBs in addition to the SIBs valid for the current serving cell is left to UE implementation.","paragraph_zero_based":594},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":595},{"literal_text_all_w_t_and_m_t":"1>delete any stored version of a SIB after 3 hours from the moment it was successfully confirmed as valid;","paragraph_zero_based":596},{"literal_text_all_w_t_and_m_t":"1>for each stored version of a SIB:","paragraph_zero_based":597},{"literal_text_all_w_t_and_m_t":"2>if the areaScope is associated and its value for the stored version of the SIB is the same as the value received in the si-SchedulingInfo for that SIB from the serving cell:","paragraph_zero_based":598},{"literal_text_all_w_t_and_m_t":"3>if the UE is NPN capable and the cell is an NPN-only cell:","paragraph_zero_based":599}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["96645357b38c1b28b5193d0f8fe4a43a5febd9553efdd20519df8285dde9cf69","00fce7829f2e1850c9a4382e6aa4967b8004cc2cbfc84d4e7f83a4d3d80ed098","a4fa1b65e618e567b75ca000799fabccb5a98cc1bd9efa42eec61bb8fab84526","142c36196137f8793c0e63dd32189bf445e7d6ce5414cfdbac2c2c6f76902846","be3a6e2a5760038ea124374f5db494524de7705ea976a54cb5c626bff0d16c17","f87fd6cb3d74d74b12ae932d628ffc6cd6475d328067d5ce763d0ae700ec9ca0","1bb5d9a98f93d8a16b25c298c6f47c328b4886c9bda31d3d777d5f95b1ce9440","96058d62fff8478c7e091e465df53802b371e78eca01e4186dfb024bb0ec0341","f1cf9115d05c3ff5d4fa342aa1e0577e2a3416c4022b30d313a5bd29787e74a2","880729275799a25a2ead2babf30a400e600840112a1c987f96dd0dbbb409e7a7","65b53190f01c6447450eaee0f3e87879d54a221d4adb4281d50f6db30be2ef63","832b9cbbdbbcc03c38bf3ff202f867992b686c41c0b0bdfb6445f497ecfce385","5daf90c563f255e4ad8a79d51a901256359cb94aae8e79ba6687135d4ea67152","3e9d1d5b5bfd39d04eef61e29303223ec0896ebab511013f0a29894a71e05459","852695477234dd230981dede1e23088b70aa36789d3b751e9a48174a2bb14db9","63b2001a8703662a8e073d5dc4497642f7c9d79a0abbbff7a36c964b0d8d6083","9cd5aea355ca1beeaa13e0058d02458b44f497dbbb3d9fbc8481c436c652ffb2","e9dfd239898c27875c17f6927f017abb528c1aab4908c9673ec14cdcd787c847","3bdb75b99f33a4fd9ee807029d62dd7e862bacbc1c867e967960b1cf752bc637","d5b511467bb3900fe7f3827f456eab3c207a4e3c78de81e90369ca64f8b44d26","3ddea7a7f2582aa09c4680693e67f1c946de7d3967e657480f3efb0a95ae0e8d","7126c586de9c5ed6c1fe9fd3f474c8d10a2e460a514cced502693e42327d5bc2","31d050b3ae304ebdfad4b9e3d54f3fa26a88f2f0c144e37a5ff339c912b6c533","e0b7011220a908301a0120f98cd941d3c416926321aa70e282dee65249091c6c"],"paragraph_range_zero_based":[576,599],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p576"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>if the first NPN identity included in the NPN-IdentityInfoList, the systemInformationAreaID and the valueTag that are included in the si-SchedulingInfo for the SIB received from the serving cell are identical to the NPN identity, the systemInformationAreaID and the valueTag associated with the stored version of that SIB:","paragraph_zero_based":600},{"literal_text_all_w_t_and_m_t":"5>consider the stored SIB as valid for the cell;","paragraph_zero_based":601},{"literal_text_all_w_t_and_m_t":"3>else if the first PLMN-Identity included in the PLMN-IdentityInfoList, the systemInformationAreaID and the valueTag that are included in the si-SchedulingInfo for the SIB received from the serving cell are identical to the PLMN-Identity, the systemInformationAreaID and the valueTag associated with the stored version of that SIB:","paragraph_zero_based":602},{"literal_text_all_w_t_and_m_t":"4>consider the stored SIB as valid for the cell;","paragraph_zero_based":603},{"literal_text_all_w_t_and_m_t":"2>if the areaScope is not present for the stored version of the SIB and the areaScope value is not included in the si-SchedulingInfo for that SIB from the serving cell:","paragraph_zero_based":604},{"literal_text_all_w_t_and_m_t":"3>if the UE is NPN capable and the cell is an NPN-only cell:","paragraph_zero_based":605},{"literal_text_all_w_t_and_m_t":"4>if the first NPN identity in the NPN-IdentityInfoList, the cellIdentity and valueTag that are included in the si-SchedulingInfo for the SIB received from the serving cell are identical to the NPN identity, the cellIdentity and the valueTag associated with the stored version of that SIB:","paragraph_zero_based":606},{"literal_text_all_w_t_and_m_t":"5>consider the stored SIB as valid for the cell;","paragraph_zero_based":607},{"literal_text_all_w_t_and_m_t":"3>else if the first PLMN-Identity in the PLMN-IdentityInfoList, the cellIdentity and valueTag that are included in the si-SchedulingInfo for the SIB received from the serving cell are identical to the PLMN-Identity, the cellIdentity and the valueTag associated with the stored version of that SIB:","paragraph_zero_based":608},{"literal_text_all_w_t_and_m_t":"4>consider the stored SIB as valid for the cell;","paragraph_zero_based":609},{"literal_text_all_w_t_and_m_t":"1>for each stored version of a posSIB:","paragraph_zero_based":610},{"literal_text_all_w_t_and_m_t":"2>if the areaScope is associated and its value for the stored version of the posSIB is the same as the value received in the posSIB-MappingInfo for that posSIB from the serving cell and the systemInformationAreaID included in the si-SchedulingInfo is identical to the systemInformationAreaID associated with the stored version of that posSIB:","paragraph_zero_based":611},{"literal_text_all_w_t_and_m_t":"3>if the valueTag (see TS 37.355 [49]) for the posSIB received from the serving cell is identical to the valueTag associated with the stored version of that posSIB; or if the expirationTime (see TS 37.355 [49]) associated with the stored posSIB has not been expired:","paragraph_zero_based":612},{"literal_text_all_w_t_and_m_t":"4>consider the stored posSIB as valid for the cell;","paragraph_zero_based":613},{"literal_text_all_w_t_and_m_t":"2>if the areaScope is not present for the stored version of the posSIB and the areaScope value is not included in the posSIB-MappingInfo for that posSIB from the serving cell and the cellIdentity for the posSIB received from the serving cell is identical to the cellIdentity associated with the stored version of that posSIB:","paragraph_zero_based":614},{"literal_text_all_w_t_and_m_t":"3>if the valueTag (see TS 37.355 [49]) for the posSIB received from the serving cell is identical to the valueTag associated with the stored version of that posSIB; or if the expirationTime (see TS 37.355 [49]) associated with the stored posSIB has not been expired:","paragraph_zero_based":615},{"literal_text_all_w_t_and_m_t":"4>consider the stored posSIB as valid for the cell;","paragraph_zero_based":616},{"literal_text_all_w_t_and_m_t":"5.2.2.2.2SI change indication and PWS notification","paragraph_zero_based":617},{"literal_text_all_w_t_and_m_t":"A modification period is used, i.e. updated SI message (other than SI message for ETWS, CMAS, positioning assistance data, and some NTN-specific information as specified in the field descriptions ) is broadcasted in the modification period following the one where SI change indication is transmitted. The modification period boundaries are defined by SFN values for which SFN mod m = 0, where m is the number of radio frames comprising the modification period. The modification period is configured by system information. If H-SFN is provided in SIB1, and UE is configured with eDRX, modification period boundaries are defined by SFN values for which (H-SFN * 1024 + SFN) mod m = 0.","paragraph_zero_based":618},{"literal_text_all_w_t_and_m_t":"For UEs in RRC_IDLE or RRC_INACTIVE configured to use an IDLE eDRX cycle longer than the modification period, an eDRX acquisition period is defined. The boundaries of the eDRX acquisition period are determined by H-SFN values for which H-SFN mod 1024 = 0.","paragraph_zero_based":619},{"literal_text_all_w_t_and_m_t":"The UE receives indications about SI modifications and/or PWS notifications using Short Message transmitted with P-RNTI over DCI (see clause 6.5). Repetitions of SI change indication may occur within preceding modification period or within preceding eDRX acquisition period. SI change indication is not applicable for SI messages containing posSIBs.","paragraph_zero_based":620},{"literal_text_all_w_t_and_m_t":"UEs in RRC_IDLE or in RRC_INACTIVE while SDT procedure is not ongoing shall monitor for SI change indication in its own paging occasion(s) that the UE monitors as specified in TS 38.304 [20]. UEs in RRC_CONNECTED shall monitor for SI change indication in any paging occasion at least once per modification period if the UE is provided with common search space, including pagingSearchSpace, searchSpaceSIB1 and searchSpaceOtherSystemInformation, on the active BWP to monitor paging, as specified in TS 38.213 [13], clause 13.","paragraph_zero_based":621},{"literal_text_all_w_t_and_m_t":"UEs in RRC_INACTIVE while SDT procedure is ongoing shall monitor for SI change indication in any paging occasion at least once per modification period, if the initial downlink BWP on which the SDT procedure is ongoing is associated with a CD-SSB.","paragraph_zero_based":622},{"literal_text_all_w_t_and_m_t":"During a modification period where ETWS or CMAS transmission is started or stopped, the SI messages carrying the posSIBs scheduled in posSchedulingInfoList may change, so the UE might not be able to successfully receive those posSIBs in the remainder of the current modification period and next modification period according to the scheduling information received prior to the change.","paragraph_zero_based":623}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["985e4a2ed297c1bcb262b0bb0ce6673f324238deec006045843b7f312b603f0a","94b01aacf4ce8fc01cb4233be57b88edb9053ebc42aba09b5d4db07b81d78099","304940970cb1b35ec9e928b0b0bea30bd02cdb3af07cde607e3528c81ca6e277","4389937b911130e8a8241eb6abe0a7e126f8140142fad88a5b3c471a2eda2642","4d35b21c714f35d07df6ab3ab10d1c2c38131c97f15d89363ce4d1677a3ba145","27aa066a7a8e038acc1fd84040a4f12f9b5153b408d1307a19258e947cb9ea03","34e05e784fb353ccd8b6b51cf820730072d403a6d36b4903bdb16f9f1c787ad4","3b646449fb7992324838bf1313036137ce7cfbef2df720f3cd4c6a85f7d654f2","05393530b8fc3f21c15d58eb158f73615b48e7f75cfa09b92758e30817acf82a","9e4e9522acfe1980b13e3d7fe66e61d0792ebf3d755d87d33f2b45aa3513634b","be31e0dac5f1eeb5f411ede026255ba431761e94c501c987deaa6161ff641f2c","5894490e8f356b12d4b0123d6127f254d020e892ca2a26d37f779c2ea1b1e861","989aa440bebadc59d2c54e6d83ad141eeebc58bf5b76804b5adf4d7eb204ac5b","936ea59a45d30add675ed069a342df7ba9515641d605c4f0f0ccfde3de301f3e","00e69a73f1b819a4716b40ba8e64e4388b7341efa1bf5e8e97f386017340854b","eaba47d8829dbee7f0036b42ac3b0110329de510a954146a0b28fffec86b72a9","cd4c888a37dd1ec0cce44b106e8172e1df71e6fe48f52e013519e60f0c00bbfe","fc1174d1a33d70cc5feaf0c9722aed54d5e0f6550ddcb0fab9530651f7bd6c03","423562109d347f90e9417876103438a9c8e1bceebda66adc8b8f55dd61017b33","9d44fc1252cd403384bc783ff2f005e3d0c8ef49812712dfa195d02934498bfe","8db9d76e3123ba2f55cff6c146d987c784500e05aaaa3db626df860f11e9b6ac","7d7e380620e228c550c0b1426dae370d0aac3fd264e93a3e74067e63060d8bf6","dec711b41c0d04adfb23d4cd8042b4ae503d529332d1a894b1927af8b5b303aa","f45937f7bd2504de22853eaf2d0053029a5dd911be940343d23fc22cb19d9577"],"paragraph_range_zero_based":[600,623],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p600"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ETWS or CMAS capable UEs in RRC_IDLE or in RRC_INACTIVE while SDT procedure is not ongoing shall monitor for indications about PWS notification in its own paging occasion(s) that the UE monitors as specified in TS 38.304 [20]. ETWS or CMAS capable UEs in RRC_CONNECTED shall monitor for indication about PWS notification in any paging occasion at least once every defaultPagingCycle if the UE is provided with common search space, including pagingSearchSpace, searchSpaceSIB1 and searchSpaceOtherSystemInformation, on the active BWP to monitor paging.","paragraph_zero_based":624},{"literal_text_all_w_t_and_m_t":"ETWS or CMAS capable UEs in RRC_INACTIVE while SDT procedure is ongoing shall monitor for indication about PWS notification in any paging occasion at least once every defaultPagingCycle, if the initial downlink BWP on which the SDT procedure is ongoing is associated with a CD-SSB.","paragraph_zero_based":625},{"literal_text_all_w_t_and_m_t":"For Short Message reception in a paging occasion, the UE monitors the PDCCH monitoring occasion(s) for paging as specified in TS 38.304 [20] and TS 38.213 [13].","paragraph_zero_based":626},{"literal_text_all_w_t_and_m_t":"A L2 U2N Remote UE is not required to monitor paging occasion for SI modifications and/or PWS notifications. It obtains the updated system information and SIB6/7/8 from the connected L2 U2N Relay UE as defined in clause 5.8.9.9.3.","paragraph_zero_based":627},{"literal_text_all_w_t_and_m_t":"If the UE receives a Short Message, the UE shall:","paragraph_zero_based":628},{"literal_text_all_w_t_and_m_t":"1>if the UE is ETWS capable or CMAS capable, the etwsAndCmasIndication bit of Short Message is set, and the UE is provided with searchSpaceSIB1 and searchSpaceOtherSystemInformation on the active BWP or the initial BWP:","paragraph_zero_based":629},{"literal_text_all_w_t_and_m_t":"2> immediately re-acquire the SIB1;","paragraph_zero_based":630},{"literal_text_all_w_t_and_m_t":"2>if the UE is ETWS capable and si-SchedulingInfo includes scheduling information for SIB6:","paragraph_zero_based":631},{"literal_text_all_w_t_and_m_t":"3>acquire SIB6, as specified in clause 5.2.2.3.2, immediately;","paragraph_zero_based":632},{"literal_text_all_w_t_and_m_t":"2>if the UE is ETWS capable and si-SchedulingInfo includes scheduling information for SIB7:","paragraph_zero_based":633},{"literal_text_all_w_t_and_m_t":"3>acquire SIB7, as specified in clause 5.2.2.3.2, immediately;","paragraph_zero_based":634},{"literal_text_all_w_t_and_m_t":"2>if the UE is CMAS capable and si-SchedulingInfo includes scheduling information for SIB8:","paragraph_zero_based":635},{"literal_text_all_w_t_and_m_t":"3>acquire SIB8, as specified in clause 5.2.2.3.2, immediately;","paragraph_zero_based":636},{"literal_text_all_w_t_and_m_t":"NOTE:In case SIB6, SIB7, or SIB8 overlap with a measurement gap it is left to UE implementation how to immediately acquire SIB6, SIB7, or SIB8.","paragraph_zero_based":637},{"literal_text_all_w_t_and_m_t":"1>if the UE does not operate an IDLE eDRX cycle longer than the modification period and the systemInfoModification bit of Short Message is set:","paragraph_zero_based":638},{"literal_text_all_w_t_and_m_t":"2>apply the SI acquisition procedure as defined in clause 5.2.2.3 from the start of the next modification period;","paragraph_zero_based":639},{"literal_text_all_w_t_and_m_t":"1>if the UE operates an IDLE eDRX cycle longer than the modification period and the systemInfoModification-eDRX bit of Short Message is set:","paragraph_zero_based":640},{"literal_text_all_w_t_and_m_t":"2>apply the SI acquisition procedure as defined in clause 5.2.2.3 from the start of the next eDRX acquisition period boundary.","paragraph_zero_based":641},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":642},{"literal_text_all_w_t_and_m_t":"5.2.2.3Acquisition of System Information","paragraph_zero_based":643},{"literal_text_all_w_t_and_m_t":"5.2.2.3.1Acquisition of MIB and SIB1","paragraph_zero_based":644},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":645},{"literal_text_all_w_t_and_m_t":"1>apply the specified BCCH configuration defined in 9.1.1.1;","paragraph_zero_based":646},{"literal_text_all_w_t_and_m_t":"1>if the UE is in RRC_IDLE or in RRC_INACTIVE; or","paragraph_zero_based":647}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["f2f92bad502afc0ba8d70fac7efa0b328b1c8be2847d95b92b8c1cf181e963d2","529a87fe4ec75aa458f1febd6adcb9fee338922f51444666a25764e7697eacbb","54e00485fa6e14085f2ff6f40df6b88590e9656971f2d7af88092972a88090dd","f8da70cd7131c35731f690454772ac8be593a1ee92ddc228c3d105df80c49c61","b6ca56e5c7b15e88cff223552cf7ba687de0819a8e1d698367ef1db064a26da0","e5489d3b8699a69fbee2930a51afeacdfa627ea261d8ba2b3a08fc91eaeb8907","beb3e4d2fc4f55c626f212699d593f352daafc83c4e150a7bae1999262e4f36f","61ec0ed49a5c5249f18d7618cdbcf575c3c029f4e9541f3ea463b5d44111fb5a","b5d9ba95cafa468f9ac4c7e925e229aa09b1cf3cf097a007a23273966240b659","35b48d14cf34aa3246edbfd383e933048ed06315daf6b5a8051cdedc9a618386","0edfd4043038389b313e552ea5c3137cf4f643cec480522cf3892e20a4467c65","40c70853cc1db1eeea7d7408b6dff2b08b28166c004af854114f2639cc2c48c4","ac0f26c96822152f8c818e3d76e223a2379d7f19ffb26ccb43db7b5887e53fef","fbc18775a04721f0bc80dfa66a38157c92e3b314cdd19afe61a4f89c5668b115","d53d1afe6183ea24c9edfc316de2eb543941e6758e393cfb60d87b7340da339c","6b45771b0199aa6cd97eb04fa051d74a7737e90176ab35829d5811e89be449b6","61978e9df2a319b0442fac57e0727d785b500070c6c55fbbd7d8f59e4c6b8043","91769f6b53117f6baa82f998faa250b87248d36e3caa870dbbdc79e11f7170e8","86cd56dd394271baf728963f0e28717866687b2a533fa442fb2dd84636f3c926","638e351079f346335524f0b9e873ebb9ccd99beed9dcb5ee10cd68faf89d6274","105f42774755295a71659eecd3ff2d0d19effcc13911fce78f67a62fa99bb0b5","912504a87b99f87bef936e8dc30cd6f8ef57cf04417ad77aa4b21011798a4880","e80b3ef038d63edad5c2074612bb0dd50e4a6639589fd4405b4627d7b01d93f9","97b26dbe01ff69e542e17f9e4783cb049eedc99c4c046aca49cb1fd5b017c182"],"paragraph_range_zero_based":[624,647],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p624"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>if the UE is in RRC_CONNECTED while T311 is running:","paragraph_zero_based":648},{"literal_text_all_w_t_and_m_t":"2>acquire the MIB, which is scheduled as specified in TS 38.213 [13];","paragraph_zero_based":649},{"literal_text_all_w_t_and_m_t":"2>if the UE is unable to acquire the MIB;","paragraph_zero_based":650},{"literal_text_all_w_t_and_m_t":"3>perform the actions as specified in clause 5.2.2.5;","paragraph_zero_based":651},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":652},{"literal_text_all_w_t_and_m_t":"3>perform the actions specified in clause 5.2.2.4.1.","paragraph_zero_based":653},{"literal_text_all_w_t_and_m_t":"1>if the UE is in RRC_CONNECTED with an active BWP with common search space configured by searchSpaceSIB1 and pagingSearchSpace and has received an indication about change of system information; or","paragraph_zero_based":654},{"literal_text_all_w_t_and_m_t":"1>if the UE is in RRC_CONNECTED with an active BWP with common search space configured by searchSpaceSIB1 and the UE has not stored a valid version of a SIB or posSIB, in accordance with clause 5.2.2.2.1, of one or several required SIB(s) or posSIB(s) in accordance with clause 5.2.2.1, and, UE has not acquired SIB1 in current modification period; or","paragraph_zero_based":655},{"literal_text_all_w_t_and_m_t":"1> if the UE is in RRC_CONNECTED with an active BWP with common search space configured by searchSpaceSIB1, and, the UE has not stored a valid version of a SIB or posSIB, in accordance with clause 5.2.2.2.1, of one or several required SIB(s) or posSIB(s) in accordance with clause 5.2.2.1, and, si-BroadcastStatus for the required SIB(s) or posSI-BroadcastStatus for the required posSIB(s) is set to notbroadcasting in acquired SIB1 in current modification period; or","paragraph_zero_based":656},{"literal_text_all_w_t_and_m_t":"1>if the UE is in RRC_IDLE or in RRC_INACTIVE; or","paragraph_zero_based":657},{"literal_text_all_w_t_and_m_t":"1>if the UE is in RRC_CONNECTED while T311 is running:","paragraph_zero_based":658},{"literal_text_all_w_t_and_m_t":"2>if ssb-SubcarrierOffset indicates SIB1 is transmitted in the cell (TS 38.213 [13]) and if SIB1 acquisition is required for the UE:","paragraph_zero_based":659},{"literal_text_all_w_t_and_m_t":"3>acquire the SIB1, which is scheduled as specified in TS 38.213 [13];","paragraph_zero_based":660},{"literal_text_all_w_t_and_m_t":"3>if the UE is unable to acquire the SIB1:","paragraph_zero_based":661},{"literal_text_all_w_t_and_m_t":"4>perform the actions as specified in clause 5.2.2.5;","paragraph_zero_based":662},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":663},{"literal_text_all_w_t_and_m_t":"4>upon acquiring SIB1, perform the actions specified in clause 5.2.2.4.2.","paragraph_zero_based":664},{"literal_text_all_w_t_and_m_t":"2>else if SIB1 acquisition is required for the UE and ssb-SubcarrierOffset indicates that SIB1 is not scheduled in the cell:","paragraph_zero_based":665},{"literal_text_all_w_t_and_m_t":"3>perform the actions as specified in clause 5.2.2.5.","paragraph_zero_based":666},{"literal_text_all_w_t_and_m_t":"NOTE 1:The UE in RRC_CONNECTED is only required to acquire broadcasted SIB1 and MBS broadcast if the UE can acquire it without disrupting unicast or MBS multicast data reception, i.e., the broadcast and unicast/MBS multicast beams are quasi co-located. The UE in RRC_INACTIVE state while SDT procedure is ongoing, is only required to acquire broadcasted SIB1 and MIB if the UE can acquire them without disrupting unicast data reception, i.e. the broadcast and unicast beams are quasi co-located.","paragraph_zero_based":667},{"literal_text_all_w_t_and_m_t":"NOTE 2:UE in RRC_INACTIVE that does not support inactiveStateNTN-r17 enters RRC_IDLE upon cell reselection between TN cell and NTN cell, and initiates the NAS signalling connection recovery (see TS 24.501 [23]).","paragraph_zero_based":668},{"literal_text_all_w_t_and_m_t":"5.2.2.3.2Acquisition of an SI message","paragraph_zero_based":669},{"literal_text_all_w_t_and_m_t":"For SI message acquisition PDCCH monitoring occasion(s) are determined according to searchSpaceOtherSystemInformation. If searchSpaceOtherSystemInformation is set to zero, PDCCH monitoring occasions for SI message reception in SI-window are same as PDCCH monitoring occasions for SIB1 where the mapping between PDCCH monitoring occasions and SSBs is specified in TS 38.213[13]. If searchSpaceOtherSystemInformation is not set to zero, PDCCH monitoring occasions for SI message are determined based on search space indicated by searchSpaceOtherSystemInformation. PDCCH monitoring occasions for SI message which are not overlapping with UL symbols (determined according to tdd-UL-DL-ConfigurationCommon) are sequentially numbered from one in the SI window. The [x×N+K]th PDCCH monitoring occasion (s) for SI message in SI-window corresponds to the Kth transmitted SSB, where x = 0, 1, ...X-1, K = 1, 2, …N, N is the number of actual transmitted SSBs determined according to ssb-PositionsInBurst in SIB1 and X is equal to CEIL(number of PDCCH monitoring occasions in SI-window/N). The actual transmitted SSBs are sequentially numbered from one in ascending order of their SSB indexes. The UE assumes that, in the SI window, PDCCH for an SI message is transmitted in at least one PDCCH monitoring occasion corresponding to each transmitted SSB and thus the selection of SSB for the reception SI messages is up to UE implementation.","paragraph_zero_based":670},{"literal_text_all_w_t_and_m_t":"When acquiring an SI message, the UE shall:","paragraph_zero_based":671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["8befcbd34867db289e3ae204ef63c0395ad798dfc5874e3c847e60a3655da35f","10ec07b6fd4bad2fb6af41a80386685a65943a106217b2de237649775c53c809","ab27ac9bd85035650c0aaaabb55e0051bf367e71d0e1160f4e8662efe67b1f3d","699ebf00910e86e0cbf59165cd281c478aa4fd09b9008614b63820d47bfb6ab8","da2d46ae6bdbe86f6e77329927bd8c74511476500f074f371b946c90909d110d","7d976224ad070d97afe159bcc3274dcfe55743d263f1467b4341caa3b89a9cea","9d6287e9446d68e6f20cca4ea51e68f7e733c293275f1e55a6b233f90f21319b","a46e85883d66b63e6bb54e39787d6ad15e3f1df4f2990c834880193e8c661822","0785e4d7997b3a17c07c2eb9dfe860fa7723749c5ba16a202c82b9c3b0031bcd","ec36e61808c6abf5b73b5d9fb354309a9b8caa1bd390a2a816b2d76cdaf56f2b","e5fe91b9dc9e1548cc14112d5e0a3a30db1c4d2ad14d355d19200824ac3e8bef","0d668c99f25092d37469b3089b65d6b4024c7a9bb73540189c997e73ccd4c099","ea9d83870ff814ebda79ba47714dd60d078cac4af870c549a8c5aee1286f6bef","d73946caf68571a98bdb352a3d2d434dfeebafbc4164fc5c63b466b30d7d5405","58efa4f04a4c59f980ec96a01584a34b95afebec93a03b2d8cca4b3c4a18a735","cae6c078c0c48baf914e8ed0d4df2ba713b0a71a864bda34bf34bf1451377ee6","1d6ee1459b243ee61cb9d25cebd71f0f4a1ba3abbe5857ca1ba9faf15f21a7b5","a84354e09e46e2a466df33fc36c884a29426765b5146cd003d91013e57aa81f4","75ce4e0106af4387a87c6db612d8608a6da02404e12e7dcfb52cb62597001562","f72f2c732ced49f46b7f57afba5b9d29df54361f546e9600fcf0b5abe85e1d08","4a2c5cd8361dbdbfcd36d7ccaa2d0a1da1da62e64f0f92cfbbdddae4730c928d","8bff108bb81726452cb9c97c1dced526834c4b01a0526469a71356b1f37d41e4","a9c64d510c4ffd8c48b04ce59661bd7e8eb2d02ca4eebb4d4ec80014522cb47a","76ea586749483a822d4e842ccda3b32a527b158cc0d9a3a9e2976436dfbccfd7"],"paragraph_range_zero_based":[648,671],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p648"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>determine the start of the SI-window for the concerned SI message as follows:","paragraph_zero_based":672},{"literal_text_all_w_t_and_m_t":"2>if the concerned SI message is configured in the schedulingInfoList:","paragraph_zero_based":673},{"literal_text_all_w_t_and_m_t":"3>for the concerned SI message, determine the number n which corresponds to the order of entry in the list of SI messages configured by schedulingInfoList in si-SchedulingInfo in SIB1;","paragraph_zero_based":674},{"literal_text_all_w_t_and_m_t":"3>determine the integer value x = (n – 1) × w, where w is the si-WindowLength;","paragraph_zero_based":675},{"literal_text_all_w_t_and_m_t":"3>the SI-window starts at the slot #a, where a = x mod N, in the radio frame for which SFN mod T = FLOOR(x/N), where T is the si-Periodicity of the concerned SI message and N is the number of slots in a radio frame as specified in TS 38.213 [13];","paragraph_zero_based":676},{"literal_text_all_w_t_and_m_t":"2>else if the concerned SI message is configured in the schedulingInfoList2;","paragraph_zero_based":677},{"literal_text_all_w_t_and_m_t":"3>determine the integer value x = (si-WindowPosition -1) × w, where w is the si-WindowLength;","paragraph_zero_based":678},{"literal_text_all_w_t_and_m_t":"3>the SI-window starts at the slot #a, where a = x mod N, in the radio frame for which SFN mod T = FLOOR(x/N), where T is the si-Periodicity of the concerned SI message and N is the number of slots in a radio frame as specified in TS 38.213 [13];","paragraph_zero_based":679},{"literal_text_all_w_t_and_m_t":"2>else if the concerned SI message is configured in the posSchedulingInfoList and offsetToSI-Used is not configured:","paragraph_zero_based":680},{"literal_text_all_w_t_and_m_t":"3>create a concatenated list of SI messages by appending the posSchedulingInfoList in posSI-SchedulingInfo in SIB1 to schedulingInfoList in si-SchedulingInfo in SIB1;","paragraph_zero_based":681},{"literal_text_all_w_t_and_m_t":"3>for the concerned SI message, determine the number n which corresponds to the order of entry in the concatenated list;","paragraph_zero_based":682},{"literal_text_all_w_t_and_m_t":"3>determine the integer value x = (n – 1) × w, where w is the si-WindowLength;","paragraph_zero_based":683},{"literal_text_all_w_t_and_m_t":"3>the SI-window starts at the slot #a, where a = x mod N, in the radio frame for which SFN mod T = FLOOR(x/N), where T is the posSI-Periodicity of the concerned SI message and N is the number of slots in a radio frame as specified in TS 38.213 [13];","paragraph_zero_based":684},{"literal_text_all_w_t_and_m_t":"2>else if the concerned SI message is configured by the posSchedulingInfoList and offsetToSI-Used is configured:","paragraph_zero_based":685},{"literal_text_all_w_t_and_m_t":"3>determine the number m which corresponds to the number of SI messages with an associated si-Periodicity of 8 radio frames (80 ms), configured by schedulingInfoList in SIB1;","paragraph_zero_based":686},{"literal_text_all_w_t_and_m_t":"3>for the concerned SI message, determine the number n which corresponds to the order of entry in the list of SI messages configured by posSchedulingInfoList in SIB1;","paragraph_zero_based":687},{"literal_text_all_w_t_and_m_t":"3>determine the integer value x = m × w + (n – 1) × w, where w is the si-WindowLength;","paragraph_zero_based":688},{"literal_text_all_w_t_and_m_t":"3>the SI-window starts at the slot #a, where a = x mod N, in the radio frame for which SFN mod T = FLOOR(x/N) +8, where T is the posSI-Periodicity of the concerned SI message and N is the number of slots in a radio frame as specified in TS 38.213 [13];","paragraph_zero_based":689},{"literal_text_all_w_t_and_m_t":"1>receive the PDCCH containing the scheduling RNTI, i.e. SI-RNTI in the PDCCH monitoring occasion(s) for SI message acquisition, from the start of the SI-window and continue until the end of the SI-window whose absolute length in time is given by si-WindowLength, or until the SI message was received;","paragraph_zero_based":690},{"literal_text_all_w_t_and_m_t":"1>if the SI message was not received by the end of the SI-window, repeat reception at the next SI-window occasion for the concerned SI message in the current modification period;","paragraph_zero_based":691},{"literal_text_all_w_t_and_m_t":"1>if all the SIB(s) and/or posSIB(s) requested in DedicatedSIBRequest message have been acquired:","paragraph_zero_based":692},{"literal_text_all_w_t_and_m_t":"2>stop timer T350, if running;","paragraph_zero_based":693},{"literal_text_all_w_t_and_m_t":"NOTE 1:The UE is only required to acquire broadcasted SI message if the UE can acquire it without disrupting unicast or MBS multicast data reception, i.e. the broadcast and unicast/MBS multicast beams are quasi co-located.","paragraph_zero_based":694},{"literal_text_all_w_t_and_m_t":"NOTE 2:The UE is not required to monitor PDCCH monitoring occasion(s) corresponding to each transmitted SSB in SI-window.","paragraph_zero_based":695}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["234f3dc6989f74e16b2d1db1115884fcc7907d7cb2af27cd0818c2f0b36ba254","0f39625d4738c5f1b67069a9f4b94ced4260a0fe5e9c39ad319ace2f94610ff1","b1f92f8f30992c4ca54eb27e98cedb037ebcb432985fc39ed35e9d954a25c99b","d8f8a1e4c94195f5170160b5cae21b717f1b761acdb4900e96bca125a47cfb1f","9581a2c8f5cb44f8c5c0f0ab2ee417d322494643cacd5301f0e17dec9200ce32","f1cd19bd056a55669c2436c3c6e0a72e5e044e71c10ae609e9b78f47714bd082","1118f973bd24f31287111c750884e101b86bafbfd05510999f8f9fb4b0596892","9e495624bf2e899312313ae521ee2a2017978821c9be7691943f3c35cae38948","36345ca9e92227c01ae538866e08ae447c183ad04192c3a49fc1d98a271a63fe","21a1e11f41ec3c85bc4df1a746683e60f6b7af772b5fa4f64b1a944d88f17160","222ac1549885f0747422b2a13924c68bd17c9a44c7db253bbff42acf723c42f4","05e189a9158306cb6aeb56ee8c88eb91e7fa6e4e2c657d0ce8dc6d5b7782d08d","4b5af4f65f1c8683c11da91f043ef9164a9da75947740dd227f64cfab9588424","a2c2c255614b0873b20d0e494b698f5a1940353a1416c32387023ed61b036b5d","c9c884dc8fd50c29c69002dbc39465aa1f3f68738637d64538e5b34a913f177a","e870bfe17d37df620a75863ea1f137432ad9114e35cbe32d858646686d600782","ebbd2751a1c6365150ee90db6469d732e81a32b0006035707a6f89eb276b4745","cfaaecfeda035f134e4870eb05b2dfd8fa60dfc39dc151fce1aa271a65f4e45a","5e1248a35abae906eaafbbac0998ec3defdab7cef15a1eed397260fe6875ab6f","6d9804ae543b61a77c8dfdc7efbb34ad7da19f7542bcfe1ef49a24a561737b2e","84b7b1ec1e2e0192b6049ebd02e446254109ad2ec5edb2b247bdbcb57f9092cc","257e06246799f298b848408a26fda3d2607e48ebd70e82fe6f84e142f88275ba","bb1b28302b7607279bfc2f302e75c1010076ce7cf3262eb74f128ba8899a91c3","a0d4ce3486b59fb2b6decf4ede8b80ec8b899d16f0f204ab4f13862dbf5bd11c"],"paragraph_range_zero_based":[672,695],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p672"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"NOTE 3:If the concerned SI message was not received in the current modification period, handling of SI message acquisition is left to UE implementation.","paragraph_zero_based":696},{"literal_text_all_w_t_and_m_t":"NOTE 4:A UE in RRC_CONNECTED may stop the PDCCH monitoring during the SI window for the concerned SI message when the requested SIB(s) are acquired.","paragraph_zero_based":697},{"literal_text_all_w_t_and_m_t":"NOTE 5:A UE capable of NR sidelink communication/discovery and configured by upper layers to perform NR sidelink communication/discovery on a frequency, may acquire SIB12 or SystemInformationBlockType28 from a cell other than current serving cell (for RRC_INACTIVE or RRC_IDLE) or current PCell (for RRC_CONNECTED), if SIB12 of current serving cell (for RRC_INACTIVE or RRC_IDLE) or current PCell (for RRC_CONNECTED) does not provide configuration for NR sidelink communication/discovery for the frequency, and if the other cell providing configuration for NR sidelink communication/discovery for the frequency meets the S-criteria as defined in TS 38.304 [20] or TS 36.304 [27].","paragraph_zero_based":698},{"literal_text_all_w_t_and_m_t":"1>perform the actions for the acquired SI message as specified in clause 5.2.2.4.","paragraph_zero_based":699},{"literal_text_all_w_t_and_m_t":"5.2.2.3.3Request for on demand system information","paragraph_zero_based":700},{"literal_text_all_w_t_and_m_t":"The UE shall, while SDT procedure is not ongoing:","paragraph_zero_based":701},{"literal_text_all_w_t_and_m_t":"1>if SIB1 includes si-SchedulingInfo containing si-RequestConfigSUL and criteria to select supplementary uplink as defined in TS 38.321[3], clause 5.1.1 is met:","paragraph_zero_based":702},{"literal_text_all_w_t_and_m_t":"2>trigger the lower layer to initiate the Random Access procedure on supplementary uplink in accordance with TS 38.321 [3] using the PRACH preamble(s) and PRACH resource(s) in si-RequestConfigSUL corresponding to the SI message(s) that the UE requires to operate within the cell, and for which si-BroadcastStatus is set to notBroadcasting;","paragraph_zero_based":703},{"literal_text_all_w_t_and_m_t":"2>if acknowledgement for SI request is received from lower layers:","paragraph_zero_based":704},{"literal_text_all_w_t_and_m_t":"3>acquire the requested SI message(s) as defined in clause 5.2.2.3.2, immediately;","paragraph_zero_based":705},{"literal_text_all_w_t_and_m_t":"1>else if the UE is a RedCap UE and if initialUplinkBWP-RedCap is configured in UplinkConfigCommonSIB and if SIB1 includes si-SchedulingInfo containing si-RequestConfigRedCap and criteria to select normal uplink as defined in TS 38.321[3], clause 5.1.1 is met:","paragraph_zero_based":706},{"literal_text_all_w_t_and_m_t":"2>trigger the lower layer to initiate the Random Access procedure on normal uplink in accordance with TS 38.321 [3] using the PRACH preamble(s) and PRACH resource(s) in si-RequestConfigRedcap corresponding to the SI message(s) that the UE requires to operate within the cell, and for which si-BroadcastStatus is set to notBroadcasting;","paragraph_zero_based":707},{"literal_text_all_w_t_and_m_t":"2>if acknowledgement for SI request is received from lower layers:","paragraph_zero_based":708},{"literal_text_all_w_t_and_m_t":"3>acquire the requested SI message(s) as defined in clause 5.2.2.3.2, immediately;","paragraph_zero_based":709},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":710},{"literal_text_all_w_t_and_m_t":"2>if the UE is not a RedCap UE and if SIB1 includes si-SchedulingInfo containing si-RequestConfig and criteria to select normal uplink as defined in TS 38.321[3], clause 5.1.1 is met; or","paragraph_zero_based":711},{"literal_text_all_w_t_and_m_t":"2>if the UE is a RedCap UE and if initialUplinkBWP-RedCap is not configured in UplinkConfigCommonSIB and if SIB1 includes si-SchedulingInfo containing si-RequestConfig and criteria to select normal uplink as defined in TS 38.321[3], clause 5.1.1 is met:","paragraph_zero_based":712},{"literal_text_all_w_t_and_m_t":"3>trigger the lower layer to initiate the Random Access procedure on normal uplink in accordance with TS 38.321 [3] using the PRACH preamble(s) and PRACH resource(s) in si-RequestConfig corresponding to the SI message(s) that the UE requires to operate within the cell, and for which si-BroadcastStatus is set to notBroadcasting;","paragraph_zero_based":713},{"literal_text_all_w_t_and_m_t":"3>if acknowledgement for SI request is received from lower layers:","paragraph_zero_based":714},{"literal_text_all_w_t_and_m_t":"4>acquire the requested SI message(s) as defined in clause 5.2.2.3.2, immediately;","paragraph_zero_based":715},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":716},{"literal_text_all_w_t_and_m_t":"3>apply the default L1 parameter values as specified in corresponding physical layer specifications except for the parameters for which values are provided in SIB1;","paragraph_zero_based":717},{"literal_text_all_w_t_and_m_t":"3>apply the default MAC Cell Group configuration as specified in 9.2.2;","paragraph_zero_based":718},{"literal_text_all_w_t_and_m_t":"3>apply the timeAlignmentTimerCommon included in SIB1;","paragraph_zero_based":719}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["77ac9520e70bcde03eef15d4eb43b4394b812a08d4e7b0e622994cd00ec877d5","4ff4fbe107d343895ef881e6e45aefbcbce7a34adc27cb209545708a4ced8dad","cf9e357dfc387b4709d8a9088bc64ad15225d474e20f28eb4aeb8c9f3e7d5338","eab36915faaf2104b6ab52dbfbef51648abc3f370f470ab2200f6122d3984289","bfa9597bda425f43b3ab6728575630c7a709601ad9cd170e92b6d4dc598f3ee7","ac27c65c5d09b6a54f74af6c61de8c066ca996331ecd19633435583f577745fc","0ea7829b6837f7e0a0ce4340ae8955a5b81f31f62deded3873b4c7148034e93a","9dda216b0af3d88d43862e7032a761cf461b9b4a38ac5dc2639415430df273ba","02b3b11e0c253aa4e6a26212cb56502e1d738fefeb09fd2e641fcf22eb20a8f9","428612b1a073c9bd6890b5b620b0d6edd5410a34a2b47c4b42213bcd810bea0f","0594c4ea3afa163a7839ff2ab33f279e7fa7af85f91badae7605308a14950031","a623eb82695c6236b3355635e6a6dd2cfc5221b422029f79a2328e6fd0e6cc90","e6abcf5475391913c34cad38cd6d67834572921399c20885ce7cf00376a8cfcc","5b472626ea6d9fbf0b0f430944c83f03d5174ecb552b0a591784d04597ddc920","2b5ddb27ca44e16f73d99a9b10330def9fc5bc93c6593335ff20adb3a0c49a8f","f7d04d0dfeb3765b9b6aeb6cb6c69a8316c0f760e83eb69b903e23088d6dd1d9","f571bbd19ae6b32876cda256fe143cabb305d0db201b001944a802cde512a759","1144e10265ed82653f94b5556c65d944900b341c3717371ebe03bfd67490323a","04733aa6231d1062d98ec84e98c8607feb670e666546adb1026ded48d4291452","57f75e7bd9169391be13229496ff9fcbc25d15728ed33dd3fa5ee71dc56d58b7","1b39dbd4f64a4a58596e2e522844f4117d64e2121d17aa6fd5ba9df148f48a8a","b97113c1aaa9f16d24d271ef9d36afadcd52b72516923285e6ce69f848f560f7","007dc56be20af7814a0295568332544b3ba36091c1ba43e6a60cc7368cf20e55","d8d342767a6b9a72fa3ecc3a4ccd76af9a383baa4961030a37fa3168ae5dadf3"],"paragraph_range_zero_based":[696,719],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p696"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>apply the CCCH configuration as specified in 9.1.1.2;","paragraph_zero_based":720},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the RRCSystemInfoRequest message with rrcSystemInfoRequest in accordance with 5.2.2.3.4;","paragraph_zero_based":721},{"literal_text_all_w_t_and_m_t":"3>if acknowledgement for RRCSystemInfoRequest message with rrcSystemInfoRequest is received from lower layers:","paragraph_zero_based":722},{"literal_text_all_w_t_and_m_t":"4>acquire the requested SI message(s) as defined in clause 5.2.2.3.2, immediately;","paragraph_zero_based":723},{"literal_text_all_w_t_and_m_t":"1>if cell reselection occurs while waiting for the acknowledgment for SI request from lower layers:","paragraph_zero_based":724},{"literal_text_all_w_t_and_m_t":"2>reset MAC;","paragraph_zero_based":725},{"literal_text_all_w_t_and_m_t":"2>if SI request is based on RRCSystemInfoRequest message with rrcSystemInfoRequest:","paragraph_zero_based":726},{"literal_text_all_w_t_and_m_t":"3>release RLC entity for SRB0.","paragraph_zero_based":727},{"literal_text_all_w_t_and_m_t":"NOTE:After RACH failure for SI request it is up to UE implementation when to retry the SI request.","paragraph_zero_based":728},{"literal_text_all_w_t_and_m_t":"5.2.2.3.3aRequest for on demand positioning system information","paragraph_zero_based":729},{"literal_text_all_w_t_and_m_t":"The UE shall, while SDT procedure is not ongoing:","paragraph_zero_based":730},{"literal_text_all_w_t_and_m_t":"1>if SIB1 includes posSI-SchedulingInfo containing posSI-RequestConfigSUL and criteria to select supplementary uplink as defined in TS 38.321[3], clause 5.1.1 is met:","paragraph_zero_based":731},{"literal_text_all_w_t_and_m_t":"2>trigger the lower layer to initiate the Random Access procedure on supplementary uplink in accordance with TS 38.321 [3] using the PRACH preamble(s) and PRACH resource(s) in posSI-RequestConfigSUL corresponding to the SI message(s) that the UE upper layers require for positioning operations, and for which posSI-BroadcastStatus is set to notBroadcasting;","paragraph_zero_based":732},{"literal_text_all_w_t_and_m_t":"2>if acknowledgement for SI request is received from lower layers:","paragraph_zero_based":733},{"literal_text_all_w_t_and_m_t":"3>acquire the requested SI message(s) as defined in clause 5.2.2.3.2, immediately;","paragraph_zero_based":734},{"literal_text_all_w_t_and_m_t":"1>else if the UE is a RedCap UE and if initialUplinkBWP-RedCap is configured in UplinkConfigCommonSIB and if SIB1 includes posSI-SchedulingInfo containing posSI-RequestConfigRedCap and criteria to select normal uplink as defined in TS 38.321[3], clause 5.1.1 is met:","paragraph_zero_based":735},{"literal_text_all_w_t_and_m_t":"2>trigger the lower layer to initiate the Random Access procedure on normal uplink in accordance with TS 38.321 [3] using the PRACH preamble(s) and PRACH resource(s) in posSI-RequestConfigRedCap corresponding to the SI message(s) that the UE upper layers require for positioning operations, and for which posSI-BroadcastStatus is set to notBroadcasting;","paragraph_zero_based":736},{"literal_text_all_w_t_and_m_t":"2>if acknowledgement for SI request is received from lower layers:","paragraph_zero_based":737},{"literal_text_all_w_t_and_m_t":"3>acquire the requested SI message(s) as defined in clause 5.2.2.3.2, immediately;","paragraph_zero_based":738},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":739},{"literal_text_all_w_t_and_m_t":"2>if the UE is not a RedCap UE and if SIB1 includes posSI-SchedulingInfo containing posSI-RequestConfig and criteria to select normal uplink as defined in TS 38.321[3], clause 5.1.1 is met; or","paragraph_zero_based":740},{"literal_text_all_w_t_and_m_t":"2>if the UE is a RedCap UE and if initialUplinkBWP-RedCap is not configured in UplinkConfigCommonSIB and if SIB1 includes posSI-SchedulingInfo containing posSI-RequestConfig and criteria to select normal uplink as defined in TS 38.321[3], clause 5.1.1 is met:","paragraph_zero_based":741},{"literal_text_all_w_t_and_m_t":"3>trigger the lower layer to initiate the Random Access procedure on normal uplink in accordance with TS 38.321 [3] using the PRACH preamble(s) and PRACH resource(s) in posSI-RequestConfig corresponding to the SI message(s) that the UE upper layers require for positioning operations , and for which posSI-BroadcastStatus is set to notBroadcasting;","paragraph_zero_based":742},{"literal_text_all_w_t_and_m_t":"3>if acknowledgement for SI request is received from lower layers:","paragraph_zero_based":743}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["6b6a2b52eda58cff0225f2c453c634a8df5bb18270f6e7b1ad6d0a3a3e39e143","295883a6dbac949e7ddc65ea853877b4a048128caaa1ea7165920a5dbc6f2c08","7e8ddcab6f1124c6ef19dd492c8f313d6b680922a32b5fe38b0ef37d1469a43e","9b56fcdf889384af5a4108e5c1721f644fa49e83320736df77a88dc60c1395fa","9ceb36a2ef7a8e0829410065beb31cfd740e5b9140a3561c628f2885a91f6627","c4f4bd97100ffb31514f100b510713d808166bf946eb0f5e2b3128d85185f672","36d194b31f0b894049ab3b3a236d67788fd01af8553f6c0c8abd27fc2293b8b1","698ea0d4ab9b6b63fc537987c01ec3c006b5fe36c1572cfb4680c570a1addaa1","19c4e962b83c01e929e20263da79d81fb6d77928f1746044b6499f8a5a7be2af","fa3dcc78a2ee9f560f1408716451d8e97ced5a51e737d72a36d03a4766e18df0","11be7eebea7e55c4835b681a185f5193d86d4785cafaa6922d3e8466a6199563","725519cf0bde2093cf1b1cabe17919cacc6e02f93cbcc5de8edc693e07f53990","4d189236e794ae8fa8375d06134d7ce23f4a7407e7ecdd6300169b145ec8330a","d8b43b45b2774b3eada91d25f32b76e86d3ea1fee124800a3a658339fcefc183","f99a9270c3f541e79bce4cf7a179165a307a44192fd3a8bc245a5b9642217aeb","dfbfc30f642d9901e2708c09611311fdc1b65e25dfbf7d0b20ce79cad0fadf3b","4400e0c12c0c7d0a7926ff70f148d1713341c63b7ce06b0488612d4ab720e01a","7009a9c6ef77ce96ed7326aa637c3000aa2b652e1ffd4a69b9113f809638b998","9e8cf86a4f4cf6e41b67fdb860d5ec3ff46f7a826fadef0b7aca7c2bd64f920a","70b49b288281463d9a99e3bd49cb7fb0c67691a2be297ee58a430d5d5374eafa","3f08bf2145b9cba305b9c13410737a89a8602a7bf614e4779cadf87f6e280057","da247e8baf3160710d54a0425575e97aed21a369bc3e2b2eb9afd7103601501e","5f898bcbf85bb8591cfc52409e4f819b50c50e2a5e589e4e6481a749371e590b","a6a8c9a5047efe4ae0f23b2498397c9686fc94eb1ee8d8ced60c582933632833"],"paragraph_range_zero_based":[720,743],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p720"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>acquire the requested SI message(s) as defined in clause 5.2.2.3.2, immediately;","paragraph_zero_based":744},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":745},{"literal_text_all_w_t_and_m_t":"3>apply the default L1 parameter values as specified in corresponding physical layer specifications except for the parameters for which values are provided in SIB1;","paragraph_zero_based":746},{"literal_text_all_w_t_and_m_t":"3>apply the default MAC Cell Group configuration as specified in 9.2.2;","paragraph_zero_based":747},{"literal_text_all_w_t_and_m_t":"3>apply the timeAlignmentTimerCommon included in SIB1;","paragraph_zero_based":748},{"literal_text_all_w_t_and_m_t":"3>apply the CCCH configuration as specified in 9.1.1.2;","paragraph_zero_based":749},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the RRCSystemInfoRequest message with rrcPosSystemInfoRequest in accordance with 5.2.2.3.4;","paragraph_zero_based":750},{"literal_text_all_w_t_and_m_t":"3>if acknowledgement for RRCSystemInfoRequest message with rrcPosSystemInfoRequest is received from lower layers:","paragraph_zero_based":751},{"literal_text_all_w_t_and_m_t":"4>acquire the requested SI message(s) as defined in clause 5.2.2.3.2, immediately;","paragraph_zero_based":752},{"literal_text_all_w_t_and_m_t":"1>if cell reselection occurs while waiting for the acknowledgment for SI request from lower layers:","paragraph_zero_based":753},{"literal_text_all_w_t_and_m_t":"2>reset MAC;","paragraph_zero_based":754},{"literal_text_all_w_t_and_m_t":"2>if SI request is based on RRCSystemInfoRequest message with rrcPosSystemInfoRequest:","paragraph_zero_based":755},{"literal_text_all_w_t_and_m_t":"3>release RLC entity for SRB0.","paragraph_zero_based":756},{"literal_text_all_w_t_and_m_t":"NOTE:After RACH failure for SI request it is up to UE implementation when to retry the SI request.","paragraph_zero_based":757},{"literal_text_all_w_t_and_m_t":"5.2.2.3.4Actions related to transmission of RRCSystemInfoRequest message","paragraph_zero_based":758},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of RRCSystemInfoRequest message as follows:","paragraph_zero_based":759},{"literal_text_all_w_t_and_m_t":"1>if the procedure is triggered to request the required SI message(s) other than positioning:","paragraph_zero_based":760},{"literal_text_all_w_t_and_m_t":"2>set the requested-SI-List to indicate the SI message(s) that the UE requires to operate within the cell, and for which si-BroadcastStatus is set to notBroadcasting;","paragraph_zero_based":761},{"literal_text_all_w_t_and_m_t":"1>else if the procedure is triggered to request the required SI message(s) for positioning:","paragraph_zero_based":762},{"literal_text_all_w_t_and_m_t":"2>set the requestedPosSI-List to indicate the SI message(s) that the UE upper layers require for positioning operations, and for which posSI-BroadcastStatus is set to notBroadcasting.","paragraph_zero_based":763},{"literal_text_all_w_t_and_m_t":"The UE shall submit the RRCSystemInfoRequest message to lower layers for transmission.","paragraph_zero_based":764},{"literal_text_all_w_t_and_m_t":"5.2.2.3.5Acquisition of SIB(s) or posSIB(s) in RRC_CONNECTED","paragraph_zero_based":765},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":766},{"literal_text_all_w_t_and_m_t":"1>if the UE is in RRC_CONNECTED with an active BWP not configured with common search space with the field searchSpaceOtherSystemInformation and the UE has not stored a valid version of a SIB or posSIB, in accordance with clause 5.2.2.2.1, of one or several required SIB(s) or posSIB(s) in accordance with clause 5.2.2.1, or","paragraph_zero_based":767}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["3b8ce19a09aa890268b174bbe59dfb711f52eed3eece685e3d89db52c2c2d104","fb56319841d81dce544bba0bbaf4f0009c00e92d8c0cc3fe395a1bd524b27ad0","add609e1acff0d1f4cea89e7cc2472e6cb168266167deb15737248603932472a","41977f136f728fb004fa377d6c2391a0d34a4b2d5fb31c3eec4ca7852cd540ec","7525b661aa01ed5173e0c8dc4c82d94645cf2f7bbb8502e5cdd32eb1dc219167","6c146ebbc31944adf9db6364c23b39898209f4cb5a6000b52d03780a5e4370d5","be58387de325134e433b94fbfb1bb99e873cfbdf778ef5d82f44c7d07970dad4","abb8202f4a3df1d910093fb5a1486d3b76c8f4bbbb2fdacf6898c38f558d3eca","7efa94089c39961d0654e6c71dfabf98fc96f5680aeadc871365d5e784bb73ad","50aec394c149eae6949f3a5cba357096e0b4c57178b47406073804aae58f7bee","a5d09ec2feee6fdf4c23a189727bdd8f1c6e65c13ac83a3833bdcf5a95ca7093","efeb8f3f5d4c14c159cae33c54a682d2c8387998d1005e459303de3040b96f2d","7276b42d932a1b998ede6fd1b6f3b74a57d6fa7a46dbe2b40e9ead9b0227a51e","56574b22fba2f820692915f7fefb934bc7f6c6a58c2b8e063f0f33b1550fbaf4","01fb7dcc9ec65f220939c9dbb075bb461c57e9fabd0b0dfe4164ba93929dc5c5","751d3a969e50128447d9cee7090d2bcda0ca26caf6937f3fd4fc40282b6981a3","ae0a7269bf669cd4760dfc441eeb6fcdd9456224a0f17ff8c87ca48b14e486bc","e5574cc6e3a5526f1c61c0e0b93272b360deb68691902caceb75ed05deec3f00","314d5227168393e739827e8abd00ca9fa048796a476b1f699c5a50e31c4aaf57","3af2cc6c285d1c885872175548b02e861d07e57aad2820612f83e177f392e994","a36f6ea6d23ae00954b2ef482140c98275bfb437db1d83b85c443f4008a609ad","0003e447222c163e00d50682e2b4204615b1cfdc36c20ff37f42fbd02b3cace4","b73b6d1763df6f9b44283139d3abe9d5a34c50c0a253b3b92a9911db95fd1fb0","9e43572eae621608f29d3f9af32bda77337058268b15ce38a7b80871a9b6af54"],"paragraph_range_zero_based":[744,767],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p744"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>if the UE is in RRC_CONNECTED and acting as a L2 U2N Remote UE and the UE has not stored a valid version of a SIB, in accordance with clause 5.2.2.2.1, of one or several required SIB(s) in accordance with clause 5.2.2.1:","paragraph_zero_based":768},{"literal_text_all_w_t_and_m_t":"2>for the SI message(s) that, according to the si-SchedulingInfo or posSI-SchedulingInfo in the stored SIB1, contain at least one required SIB or requested posSIB:","paragraph_zero_based":769},{"literal_text_all_w_t_and_m_t":"3>if onDemandSIB-Request is configured and timer T350 is not running:","paragraph_zero_based":770},{"literal_text_all_w_t_and_m_t":"4>initiate transmission of the DedicatedSIBRequest message in accordance with 5.2.2.3.6;","paragraph_zero_based":771},{"literal_text_all_w_t_and_m_t":"4>start timer T350 with the timer value set to the onDemandSIB-RequestProhibitTimer;","paragraph_zero_based":772},{"literal_text_all_w_t_and_m_t":"1>else if the UE is in RRC_CONNECTED with an active BWP configured with common search space with the field searchSpaceOtherSystemInformation and the UE has not stored a valid version of a SIB or posSIB, in accordance with clause 5.2.2.2.1, of one or several required SIB(s) or posSIB(s) in accordance with clause 5.2.2.1:","paragraph_zero_based":773},{"literal_text_all_w_t_and_m_t":"2>for the SI message(s) that, according to the si-SchedulingInfo in the stored SIB1, contain at least one required SIB and for which si-BroadcastStatus is set to broadcasting:","paragraph_zero_based":774},{"literal_text_all_w_t_and_m_t":"3>acquire the SI message(s) as defined in clause 5.2.2.3.2;","paragraph_zero_based":775},{"literal_text_all_w_t_and_m_t":"2>for the SI message(s) that, according to the si-SchedulingInfo in the stored SIB1, contain at least one required SIB and for which si-BroadcastStatus is set to notBroadcasting:","paragraph_zero_based":776},{"literal_text_all_w_t_and_m_t":"3>if onDemandSIB-Request is configured and timer T350 is not running:","paragraph_zero_based":777},{"literal_text_all_w_t_and_m_t":"4>initiate transmission of the DedicatedSIBRequest message in accordance with 5.2.2.3.6;","paragraph_zero_based":778},{"literal_text_all_w_t_and_m_t":"4>start timer T350 with the timer value set to the onDemandSIB-RequestProhibitTimer;","paragraph_zero_based":779},{"literal_text_all_w_t_and_m_t":"4>acquire the requested SI message(s) corresponding to the requested SIB(s) as defined in clause 5.2.2.3.2.","paragraph_zero_based":780},{"literal_text_all_w_t_and_m_t":"2>for the SI message(s) that, according to the posSI-SchedulingInfo in the stored SIB1, contain at least one requested posSIB and for which posSI-BroadcastStatus is set to broadcasting:","paragraph_zero_based":781},{"literal_text_all_w_t_and_m_t":"3>acquire the SI message(s) as defined in clause 5.2.2.3.2;","paragraph_zero_based":782},{"literal_text_all_w_t_and_m_t":"2>for the SI message(s) that, according to the posSI-SchedulingInfo in the stored SIB1, contain at least one requested posSIB and for which posSI-BroadcastStatus is set to notBroadcasting:","paragraph_zero_based":783},{"literal_text_all_w_t_and_m_t":"3>if onDemandSIB-Request is configured and timer T350 is not running:","paragraph_zero_based":784},{"literal_text_all_w_t_and_m_t":"4>initiate transmission of the DedicatedSIBRequest message in accordance with 5.2.2.3.6;","paragraph_zero_based":785},{"literal_text_all_w_t_and_m_t":"4>start timer T350 with the timer value set to the onDemandSIB-RequestProhibitTimer;","paragraph_zero_based":786},{"literal_text_all_w_t_and_m_t":"4>acquire the requested SI message(s) corresponding to the requested posSIB(s) as defined in clause 5.2.2.3.2.","paragraph_zero_based":787},{"literal_text_all_w_t_and_m_t":"NOTE:UE may include on demand request for SIB and/or posSIB(s) in the same DedicatedSIBRequest message.","paragraph_zero_based":788},{"literal_text_all_w_t_and_m_t":"5.2.2.3.6Actions related to transmission of DedicatedSIBRequest message","paragraph_zero_based":789},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of DedicatedSIBRequest message as follows:","paragraph_zero_based":790},{"literal_text_all_w_t_and_m_t":"1>if the procedure is triggered to request the required SIB(s):","paragraph_zero_based":791}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["059ff840779e40c7c1731431f84e4cce9837be05005ab158d8498ac233f5e534","c20cae30c94ea97aeedf600883da027926da4528c3629b57155c4c8013492c71","484c384be6cace4cefc99598aa9385cf32053bae2f4803d3cd77117c7311d232","0d83262d77a41ffaf3caba6f41c8ab7a009460117d68807039add5e5c6d5f9c1","786bec0af0e4ff8b0adfb2c8a44f61acb85e4994a23ead3fddaeb0bb34072500","632abf90817aa861cf0b7ea83a07b0688c8d9cac82be18826faa665a5f71a706","f72d4593b339d0de73d31c559d81229ed562d833cfa1778f983a1bdea0e5b404","93be22de10f1d6808c0f89418de7a5c4ed720b6c29d12581fe005937167f80e8","a03b82f2f2b668e6fd93038d3fbfb48a774bc2e7a0b2a05f7f1d8156d6768737","d991a9a75df32e2f8e0fc25aedc4c4ea2a137a5305b6685ed93be3bfc2a85166","b4e466412885286a0bb3222e93ef4fe5b8e629f59665342ed5d0f38fa54a0c4c","b8b10319634f47b16142b465a7d8391ee45f0755536312b1ff54e40ba8edbc77","987d14a20531d9eadc090a0e5c8d6742a578e3e45a6e770a88bae3d89650d6df","852a8a5d6330bacaac813bfcb19d8283e4ccbace1f2a46b325c8512a3f5fecf2","7371fb709b0d96d65d7fb8fab9b5887aa1da8c1e53e2c9f333474f53915ebc8e","8c4a23233d05a4f53c64de9ec14b16099ae7c3b5e41e211bbf0c7ee43f46629b","a6368ab4f95a771d92419e600b68cd63bd7ecdaff8ed545a97e1e5ffb6098537","1c081fff3a51a90e7509a185dcbee89650c1e090ba2db95053c1de9639ba827a","6bea2cbe0d1fabbd37d436d1f37daa6d5ba942996c01713d36fb87bca1318794","aaaba9b4d32dba225c1a3b6ccf25a23e60357b6701848a2fc6b0b0a7110c92d0","2f0e28b094dbe5ed7858cdf69aac43216bb32b125d7bd71252185d67b37f22c9","c3239404916fb925a13f2272e4c60a8d00b0576ccf5ec42247271701497acdce","b36ca898c9025532adfbfad91254bb30dd4f5e2acc63702f9cc5a4fc7d674806","74d1614f597a21b84ac3ba7d0b1da5884aea953f2f410f32c152a4ac481164fd"],"paragraph_range_zero_based":[768,791],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p768"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>include requestedSIB-List in the onDemandSIB-RequestList to indicate the requested SIB(s);","paragraph_zero_based":792},{"literal_text_all_w_t_and_m_t":"1>if the procedure is triggered to request the required posSIB(s):","paragraph_zero_based":793},{"literal_text_all_w_t_and_m_t":"2>include requestedPosSIB-List in the onDemandSIB-RequestList to indicate the requested posSIB(s).","paragraph_zero_based":794},{"literal_text_all_w_t_and_m_t":"The UE shall submit the DedicatedSIBRequest message to lower layers for transmission.","paragraph_zero_based":795},{"literal_text_all_w_t_and_m_t":"5.2.2.4Actions upon receipt of System Information","paragraph_zero_based":796},{"literal_text_all_w_t_and_m_t":"5.2.2.4.1Actions upon reception of the MIB","paragraph_zero_based":797},{"literal_text_all_w_t_and_m_t":"Upon receiving the MIB the UE shall:","paragraph_zero_based":798},{"literal_text_all_w_t_and_m_t":"1>store the acquired MIB;","paragraph_zero_based":799},{"literal_text_all_w_t_and_m_t":"1>if the UE is in RRC_IDLE or in RRC_INACTIVE, or if the UE is in RRC_CONNECTED while T311 is running:","paragraph_zero_based":800},{"literal_text_all_w_t_and_m_t":"2>if the access is not for NTN or the UE is not capable of NTN; and","paragraph_zero_based":801},{"literal_text_all_w_t_and_m_t":"2>if the cellBarred in the acquired MIB is set to barred:","paragraph_zero_based":802},{"literal_text_all_w_t_and_m_t":"3>if the UE is a RedCap UE and ssb-SubcarrierOffset indicates SIB1 is transmitted in the cell (TS 38.213 [13]):","paragraph_zero_based":803},{"literal_text_all_w_t_and_m_t":"4>acquire the SIB1, which is scheduled as specified in TS 38.213 [13];","paragraph_zero_based":804},{"literal_text_all_w_t_and_m_t":"3>consider the cell as barred in accordance with TS 38.304 [20];","paragraph_zero_based":805},{"literal_text_all_w_t_and_m_t":"3>perform cell re-selection to other cells on the same frequency as the barred cell as specified in TS 38.304 [20];","paragraph_zero_based":806},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":807},{"literal_text_all_w_t_and_m_t":"3>apply the received systemFrameNumber, pdcch-ConfigSIB1, subCarrierSpacingCommon, ssb-SubcarrierOffset and dmrs-TypeA-Position.","paragraph_zero_based":808},{"literal_text_all_w_t_and_m_t":"NOTE:A UE capable of NTN access should acquire SIB1 to determine whether the cell is an NTN cell.","paragraph_zero_based":809},{"literal_text_all_w_t_and_m_t":"5.2.2.4.2Actions upon reception of the SIB1","paragraph_zero_based":810},{"literal_text_all_w_t_and_m_t":"Upon receiving the SIB1 the UE shall:","paragraph_zero_based":811},{"literal_text_all_w_t_and_m_t":"1>store the acquired SIB1;","paragraph_zero_based":812},{"literal_text_all_w_t_and_m_t":"1>if the access is for NTN, and the cellBarredNTN in the acquired SIB1 is set to barred or the cellBarredNTN is not included in the acquired SIB1:","paragraph_zero_based":813},{"literal_text_all_w_t_and_m_t":"2>consider the cell as barred in accordance with TS 38.304 [20];","paragraph_zero_based":814},{"literal_text_all_w_t_and_m_t":"2>perform cell re-selection to other cells on the same frequency as the barred cell as specified in TS 38.304 [20];","paragraph_zero_based":815}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["166c80eae8dfc3fcfe4f8cd620e564bb03594317615f63cfa94dce6c7733a692","538e5de4a87f92daa77af3bfcca01bf247b56dc30fa5e9de6e377b4d26172609","cf5d19d0212c9f017b4d616db53c391f0d4705dd0948761a4e4cc6420208695b","99a20cdd4e9b1578356d60aa4485fe7ca37e9983d8f35eeba4ee318ec67d1cea","66b37126ba9529848ec0d427de165b6865702487a242111eda6bcbbf9fde035b","905524c52a014bc5595c9c828390bdead59ab8481bd45f6464ced03860e2057a","88dfd7c4c1afd30617622a4c5d2c698739e6ff8b1294b7a3c3c804682c2983c5","436e0aa9c4aa958c835a48bb0f78bf51260f981efd9eeab86c7bad756dea43cb","343d90520a74be61d50d48aff7138d8a797c04d8005a2573f7b37c5247734ef2","0729fe74e628c99865f2f53eb19604bdaf577b72db652c5497b84b769399263a","166ac9359a3ba1c38c9ab61a8ab47f7f4c9f1c94559f63933e9f48da962f49eb","8deb5b6f8fa6425d77eb596482ad883cb37f3ef0159fe6a3c3c0603ebd7b4674","b333c3ebf0144a4ece577b37940f5112ec14d7b03effe2d6a2288304d51cbb0b","88204e51e01998f542fe889410689b7f2e07c745a85ed396c62d04220833c31f","6d4f6e761ba8eea19b08b85bbfa1b91a200eb9a51101a38a76e19b2a3f5bf441","6ae6436c043158fa39d6e43b2f09d619d242cbe36a4ff411a8888fb06121e02d","238207b645b130e95133a3314be0030d105c45f0887b04f87ab8d9373d3202b3","13c8c522b22fce67b0b4de5a6bfe54d4e02b0ae601170da312fffa7c507cd8fd","ae5dfee238fb61e0b59cb3bbbf1e99ccfb887169eab6c18037ebd4e2b5f237f4","0d03a73a36e02ddbe67c5934608d5f93810c545a32718a490d9fddc5cb748579","61c226c0da63931ed35061444fd453ce9d55d2e1eb6acf98f0ad2874581e2b79","68cabf3887e4492df6eb995e2febf81cfd19db29761d98c7554a5fb4ffbfbc76","403cb5e82170cf6c3b02fde06f8ec2fc895ef7eabbcb821677c62d889ac9580a","4b666a15c5dfc056d05d75860f5012afe0bdac3f9eeb76d3ef18a49fb4bbbbe7"],"paragraph_range_zero_based":[792,815],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p792"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>if the UE is a RedCap UE and it is in RRC_IDLE or in RRC_INACTIVE, or if the RedCap UE is in RRC_CONNECTED while T311 is running:","paragraph_zero_based":816},{"literal_text_all_w_t_and_m_t":"2>if intraFreqReselectionRedCap is not present in SIB1:","paragraph_zero_based":817},{"literal_text_all_w_t_and_m_t":"3>consider the cell as barred in accordance with TS 38.304 [20];","paragraph_zero_based":818},{"literal_text_all_w_t_and_m_t":"3>perform barring as if intraFreqReselectionRedCap is set to allowed;","paragraph_zero_based":819},{"literal_text_all_w_t_and_m_t":"2> else:","paragraph_zero_based":820},{"literal_text_all_w_t_and_m_t":"3>if the cellBarredRedCap1Rx is present in the acquired SIB1 and is set to barred and the UE is equipped with 1 Rx branch; or","paragraph_zero_based":821},{"literal_text_all_w_t_and_m_t":"3>if the cellBarredRedCap2Rx is present in the acquired SIB1 and is set to barred and the UE is equipped with 2 Rx branches; or","paragraph_zero_based":822},{"literal_text_all_w_t_and_m_t":"3>if the halfDuplexRedCapAllowed is not present in the acquired SIB1 and the UE supports only half-duplex FDD operation:","paragraph_zero_based":823},{"literal_text_all_w_t_and_m_t":"4>consider the cell as barred in accordance with TS 38.304 [20];","paragraph_zero_based":824},{"literal_text_all_w_t_and_m_t":"4>perform barring based on intraFreqReselectionRedCap as specified in TS 38.304 [20];","paragraph_zero_based":825},{"literal_text_all_w_t_and_m_t":"1>if the cellAccessRelatedInfo contains an entry of a selected SNPN or PLMN and in case of PLMN the UE is either allowed or instructed to access the PLMN via a cell for which at least one CAG ID is broadcast:","paragraph_zero_based":826},{"literal_text_all_w_t_and_m_t":"2>in the remainder of the procedures use npn-IdentityList, trackingAreaCode, and cellIdentity for the cell as received in the corresponding entry of npn-IdentityInfoList containing the selected PLMN or SNPN;","paragraph_zero_based":827},{"literal_text_all_w_t_and_m_t":"1>else if the cellAccessRelatedInfo contains an entry with the PLMN-Identity of the selected PLMN:","paragraph_zero_based":828},{"literal_text_all_w_t_and_m_t":"2>in the remainder of the procedures use plmn-IdentityList, trackingAreaCode, trackingAreaList, and cellIdentity for the cell as received in the corresponding PLMN-IdentityInfo containing the selected PLMN;","paragraph_zero_based":829},{"literal_text_all_w_t_and_m_t":"1>if the UE in RRC_INACTIVE is configured for feature(s) that it does not support in current serving cell:","paragraph_zero_based":830},{"literal_text_all_w_t_and_m_t":"2>the corresponding configuration is not used in current serving cell;","paragraph_zero_based":831},{"literal_text_all_w_t_and_m_t":"1>if in RRC_CONNECTED while T311 is not running:","paragraph_zero_based":832},{"literal_text_all_w_t_and_m_t":"2>disregard the frequencyBandList, if received, while in RRC_CONNECTED;","paragraph_zero_based":833},{"literal_text_all_w_t_and_m_t":"2>forward the cellIdentity to upper layers;","paragraph_zero_based":834},{"literal_text_all_w_t_and_m_t":"2>forward the trackingAreaCode to upper layers, if included;","paragraph_zero_based":835},{"literal_text_all_w_t_and_m_t":"2>forward the trackingAreaList to upper layers, if included;","paragraph_zero_based":836},{"literal_text_all_w_t_and_m_t":"2>forward the received posSIB-MappingInfo to upper layers, if included;","paragraph_zero_based":837},{"literal_text_all_w_t_and_m_t":"2>apply the configuration included in the servingCellConfigCommon;","paragraph_zero_based":838},{"literal_text_all_w_t_and_m_t":"2>if the UE has a stored valid version of a SIB or posSIB, in accordance with clause 5.2.2.2.1, that the UE requires to operate within the cell in accordance with clause 5.2.2.1:","paragraph_zero_based":839}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["aac0192df6d3b16806cc011c2937f6cd1c25e235dd1bfd1837a469a9deb51d5e","b67a7f60f3a2d60eb4f0057c2bdc5c32b1255e2c39cb7783847dc7921d653011","31e33b8295ffe773d3428cd0d87195dc7e7a5bd8915f6dabc985828defc7d9f8","5e47bc8fea2f8bd9e72e46d0d34e83c57334e099ffb9d25e03f6e81bf53f2153","463a690ef814f584d278db9fe71ebb17ab0ac5e744f57c301bf8ea7dfb391839","bfc55fcbd2f7c2b152efa0dd062db675f7df79c8e07847bda99446a98481327f","2b1c39d97902c941be349a203c1a574c4cc57b05015d6aca1da1308a105b7726","dd46405fafe63ead063f3a7d2e3fb17fd1503abd53e3ca25c09218a045ab84ce","883df1270d6b818f8265b199dfdf58673a22843fcf6905f3fa8c1a70b82b7d81","a76ae62b11983a0d012f643a7d67f51d5d917f15dceff95768ab9203acb56d0d","bcf87c828f9ae53d7e01e3ed16299fcd45d538b2fccfa9bfc4dada846d5a0285","ff9eb92f78edffe0df263bc7d8e6b7eb607e2fe245b750c9cfcb1d3007822bba","31af0e294d395fff38dc3705f8cb818c051f01ea5c0f8503f1309576a5f5fa68","673068bb131e9fceb3cd595d2f219a18124884cd5195078547badb8f0341c090","a4e0b313bd860a37f8278a71dd7205f38d557bc007969254bffd84882a125965","9e27d2877dd97c7f9c903cdcda17f78a50bd34cb8889518c21f5847d3fd0d98b","b50f38d973ef7a0e083dba9785ffd4529e65adf52968f83e52bddfe895240602","69a8367f46ecbbbee97c99514c04703b3d7dd3c60c85144cab1597f7a6050202","b2afcbccd42052db5b4c8fb2792fb12347dd575fa2b472593a1770b07136c54f","07bb28d598019ee8230a37b64efc538dae7b9e136395769b260e775ffc0598ef","65a6cf52b1904b6eee3b9f7db0ceee74cb69a7310ca579404f9e0e22a3cf8353","d36fddb958a4a4c882864154df00de05942c0a9b495c07a59e29120c34638881","d2580dac17a89dece5d8a4133b941f04458e388c8d947e36bb8dfa221d364906","134270b93b85d25f73265aa2ab99cacea9a3d3bb16d52297de837ab444e40913"],"paragraph_range_zero_based":[816,839],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p816"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>use the stored version of the required SIB or posSIB;","paragraph_zero_based":840},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":841},{"literal_text_all_w_t_and_m_t":"3>acquire the required SIB or posSIB requested by upper layer as defined in clause 5.2.2.3.5;","paragraph_zero_based":842},{"literal_text_all_w_t_and_m_t":"NOTE 1:Void.","paragraph_zero_based":843},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":844},{"literal_text_all_w_t_and_m_t":"2>if the UE supports one or more of the frequency bands indicated in the frequencyBandList or frequencyBandListAerial for downlink for TDD, or one or more of the frequency bands indicated in the frequencyBandList or frequencyBandListAerial for uplink for FDD, and they are not downlink only bands, and","paragraph_zero_based":845},{"literal_text_all_w_t_and_m_t":"2>if the UE is IAB-MT or supports at least one additionalSpectrumEmission in the NR-NS-PmaxList or nr-NS-PmaxListAerial for a supported band in the downlink for TDD, or a supported band in uplink for FDD, and","paragraph_zero_based":846},{"literal_text_all_w_t_and_m_t":"2>if the UE supports an uplink channel bandwidth with a maximum transmission bandwidth configuration (see TS 38.101-1 [15], TS 38.101-2 [39], and TS 38.101-5 [75]) which","paragraph_zero_based":847},{"literal_text_all_w_t_and_m_t":"-is smaller than or equal to the carrierBandwidth (indicated in uplinkConfigCommon for the SCS of the initial uplink BWP or, for RedCap UE, of the RedCap-specific initial uplink BWP if configured), and which","paragraph_zero_based":848},{"literal_text_all_w_t_and_m_t":"-is wider than or equal to the bandwidth of the initial uplink BWP or, for RedCap UE, of the RedCap-specific initial uplink BWP if configured, and","paragraph_zero_based":849},{"literal_text_all_w_t_and_m_t":"2>if the UE supports a downlink channel bandwidth with a maximum transmission bandwidth configuration (see TS 38.101-1 [15], TS 38.101-2 [39], and TS 38.101-5 [75]) which","paragraph_zero_based":850},{"literal_text_all_w_t_and_m_t":"-is smaller than or equal to the carrierBandwidth (indicated in downlinkConfigCommon for the SCS of the initial downlink BWP or, for RedCap UE, of the RedCap-specific initial downlink BWP if configured), and which","paragraph_zero_based":851},{"literal_text_all_w_t_and_m_t":"-is wider than or equal to the bandwidth of the initial downlink BWP or, for RedCap UE, of the RedCap-specific initial downlink BWP if configured, and","paragraph_zero_based":852},{"literal_text_all_w_t_and_m_t":"2>if frequencyShift7p5khz is present and the UE supports corresponding 7.5kHz frequency shift on this band; or frequencyShift7p5khz is not present:","paragraph_zero_based":853},{"literal_text_all_w_t_and_m_t":"3>if neither trackingAreaCode nor trackingAreaList is provided for the selected PLMN nor the registered PLMN nor PLMN of the equivalent PLMN list:","paragraph_zero_based":854},{"literal_text_all_w_t_and_m_t":"4>consider the cell as barred in accordance with TS 38.304 [20];","paragraph_zero_based":855},{"literal_text_all_w_t_and_m_t":"4>perform cell re-selection to other cells on the same frequency as the barred cell as specified in TS 38.304 [20];","paragraph_zero_based":856},{"literal_text_all_w_t_and_m_t":"3>else if UE is IAB-MT and if iab-Support is not provided for the selected PLMN nor the registered PLMN nor PLMN of the equivalent PLMN list nor the selected SNPN nor the registered SNPN:","paragraph_zero_based":857},{"literal_text_all_w_t_and_m_t":"4>consider the cell as barred in accordance with TS 38.304 [20];","paragraph_zero_based":858},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":859},{"literal_text_all_w_t_and_m_t":"4>apply a supported uplink channel bandwidth with a maximum transmission bandwidth which","paragraph_zero_based":860},{"literal_text_all_w_t_and_m_t":"-is contained within the carrierBandwidth indicated in uplinkConfigCommon for the SCS of the initial uplink BWP or, for RedCap UEs, RedCap-specific initial uplink BWP, if configured, and which","paragraph_zero_based":861},{"literal_text_all_w_t_and_m_t":"-is wider than or equal to the bandwidth of the initial BWP for the uplink or, for a RedCap UE, of the RedCap-specific initial uplink BWP if configured;","paragraph_zero_based":862},{"literal_text_all_w_t_and_m_t":"4>apply a supported downlink channel bandwidth with a maximum transmission bandwidth which","paragraph_zero_based":863}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["220c25f57e533baaa285a5dfdf0c5222dec1c7b5d8d3dc80ad5b3b9b053e893a","a91d2c9fd733abed2e2a79c3521afcd58922bd315b5b5f4834ecff64e37588b8","3d7949d0a279124090c5970829b12f3b274ad6e6d898766813b3d77c4c7d767d","49cc05c036a8f43c08807a8f0aecf510d06f68a138b3898bc4e498dd600eeabd","4020a3f58a6cc15b209fdf35e2dffd8a8ec7afa40ce8477295fceabeb6c24bde","b4891d53cd4a1bf003e5b393c9a4bbc87c6867ed8448784939d6e26d2d08eaae","4be396a786ac2edd64f286b840e31bf0b92fda3fe4309e1f4c76b3a8ab0af98a","ad2e2aaa5e0c3c4ed99a4d90103073b8477661666d39d3a9e4405c428254d7b0","3439ee9d85e85caa9b7828fbabf9d0311ee47ddc26ed8d318aadd62f4d3239bd","abc9e1c9671fda83377d482059b9b7fd46e7fae8a3926568e2895b3f49c1f2f3","fe795cb0e0801189ede97b3d2564771bd83689f5e1763086801d341523e0a5f9","ae6df82460f17cef431ec9697ca55ad25f58ae3d717793dbb8fbc736d87316fd","9fa40af971dc4ec22ba05ee0631a7fe7695668ff410cfcb9a0220bf74add6264","70d768468712cbc31238b357a6c67b7b5974fd8804caf90b2a1b598d1b7aa770","0837b1650190b4e57345ae575ceb6740804f085a10135d73cbd239d779581bf9","4957cabf50ff5b57dfbbf8bfd6ee2077f369335128387f50be33bb0f8581b0b3","6ad19d9140624f57eba12d9f89f3c88d091b0e094faad57760d0589d934f1def","a062b9961b82e32fa2d147d19c3c588922c739a2a1d68b0f7ca25f870b4431c8","fa16eb5df50b2f581b2e40f0dccbeb9e9fd6db3c2aa03f894875945bdfac9f51","61534b6959f32b6007a81ecf942b7829c838fcc8e0451becd3b6a38ff25a31d7","3755ec9d7e486e20825a235628ad293dd9e31a0c9c6f5118dc7d5eb00f49b066","de7d00de4877458757358738e3da18818caa2fa0a98925893f7517af12b8242e","606f32af5b806e7ceb275e0bf6f2c1c13688b832b115d969ed691324f87b5200","5020af7d059c5d5bd423d6abb218485a274a122fc6e398b101c04b4a70d0d92f"],"paragraph_range_zero_based":[840,863],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p840"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"- is contained within the carrierBandwidth indicated in downlinkConfigCommon for the SCS of the initial downlink BWP or, for RedCap UEs, RedCap-specific initial downlink BWP, if configured, and which","paragraph_zero_based":864},{"literal_text_all_w_t_and_m_t":"- is wider than or equal to the bandwidth of the initial BWP for the downlink or, for a RedCap UE, of the RedCap-specific initial downlink BWP if configured;","paragraph_zero_based":865},{"literal_text_all_w_t_and_m_t":"4>if the UE is aerial UE and it supports at least one frequency band in the frequencyBandListAerial, for FDD from frequencyBandListAerial for uplink, or for TDD from frequencyBandListAerial for downlink, for which the UE supports at least one of the additionalSpectrumEmission values in nr-NS-PmaxListAerial, if present:","paragraph_zero_based":866},{"literal_text_all_w_t_and_m_t":"5>select the first frequency band in the frequencyBandListAerial, for FDD from frequencyBandListAerial for uplink, or for TDD from frequencyBandListAerial for downlink, which the UE supports and for which the UE supports at least one of the additionalSpectrumEmission values in nr-NS-PmaxListAerial;","paragraph_zero_based":867},{"literal_text_all_w_t_and_m_t":"4>else:","paragraph_zero_based":868},{"literal_text_all_w_t_and_m_t":"5>select the first frequency band in the frequencyBandList, for FDD from frequencyBandList for uplink, or for TDD from frequencyBandList for downlink, which the UE supports and for which the UE supports at least one of the additionalSpectrumEmission values in nr-NS-PmaxList, if present;","paragraph_zero_based":869},{"literal_text_all_w_t_and_m_t":"4>forward the cellIdentity to upper layers;","paragraph_zero_based":870},{"literal_text_all_w_t_and_m_t":"4>forward the trackingAreaCode to upper layers;","paragraph_zero_based":871},{"literal_text_all_w_t_and_m_t":"4>forward the trackingAreaList to upper layers, if included;","paragraph_zero_based":872},{"literal_text_all_w_t_and_m_t":"4>forward the received posSIB-MappingInfo to upper layers, if included;","paragraph_zero_based":873},{"literal_text_all_w_t_and_m_t":"4>forward the PLMN identity or SNPN identity or PNI-NPN identity to upper layers;","paragraph_zero_based":874},{"literal_text_all_w_t_and_m_t":"4>if in RRC_INACTIVE and the forwarded information does not trigger message transmission by upper layers:","paragraph_zero_based":875},{"literal_text_all_w_t_and_m_t":"5>if the serving cell does not belong to the configured ran-NotificationAreaInfo:","paragraph_zero_based":876},{"literal_text_all_w_t_and_m_t":"6>initiate an RNA update as specified in 5.3.13.8;","paragraph_zero_based":877},{"literal_text_all_w_t_and_m_t":"4>forward the ims-EmergencySupport to upper layers, if present;","paragraph_zero_based":878},{"literal_text_all_w_t_and_m_t":"4>forward the eCallOverIMS-Support to upper layers, if present;","paragraph_zero_based":879},{"literal_text_all_w_t_and_m_t":"4>forward the UAC-AccessCategory1-SelectionAssistanceInfo or UAC-AC1-SelectAssistInfo for the selected PLMN/SNPN to upper layers, if present and set to a, b or c;","paragraph_zero_based":880},{"literal_text_all_w_t_and_m_t":"4>if the UE is in SNPN access mode:","paragraph_zero_based":881},{"literal_text_all_w_t_and_m_t":"5>forward the imsEmergencySupportForSNPN indicators with the corresponding SNPN identities to upper layers, if present;","paragraph_zero_based":882},{"literal_text_all_w_t_and_m_t":"4>apply the configuration included in the servingCellConfigCommon;","paragraph_zero_based":883},{"literal_text_all_w_t_and_m_t":"4>apply the specified PCCH configuration defined in 9.1.1.3;","paragraph_zero_based":884},{"literal_text_all_w_t_and_m_t":"4>if the UE has a stored valid version of a SIB, in accordance with clause 5.2.2.2.1, that the UE requires to operate within the cell in accordance with clause 5.2.2.1:","paragraph_zero_based":885},{"literal_text_all_w_t_and_m_t":"5>use the stored version of the required SIB;","paragraph_zero_based":886},{"literal_text_all_w_t_and_m_t":"4>if the UE has not stored a valid version of a SIB, in accordance with clause 5.2.2.2.1, of one or several required SIB(s), in accordance with clause 5.2.2.1:","paragraph_zero_based":887}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["e7af64e737120ea362e7358ea4cf1484a26e9806b4c0bfcfca1e75dfa455d5a1","b7bff188013f4faca30be1abbf9d03bea5ca5c24375764a5c0fba80b1b07fd3c","046defdbbea711ff7ee8c3e6afa429a09a4bf903fdaa852e58ec92b6a3685e5a","4cbc5c3e737c55facdb0ac9963bf321b4b597c1e9c61c84deaf797ed90cdd996","003e33a62907d2081bd1dbbef23eadf048c2492039157ee9e7d86656d39222e7","827df4ababbc0602e9e86b823d3ecdc640cb701eecfb5f3ca55e553ad53402b9","bca2c9fe29495df0cc5f87ddae27755f8b049b7466409d2c164bc2787ef1d186","97af87a853c81317d3d2477cf414f9208129188affbce8d9effe9825e73666fd","962cc2bd2b5ba02476383b2b09fac699c80c46d66ea3c9abddb6104769c8fdc7","9fae3e4f793f0d515d3d7e5d66326c7dd143d2c0633e6924cce789d862aad519","b74c49287585984fb45bc0345ebf69d426a56f12f2fd7727d7d93e636a102a6e","552fb1d430c03ff69d50e11712488b8f4f4b182d796c1e2ae215208721c992c2","eca4a770d625bb30cb44e7db72564e8299f69cb90a83b630097c93b218636619","eb7b6e9d8a1c5de4f72e57884dd9ddeb34dfbc2e482962eb657c6570de287404","6ae95b5f0bf660c2e88a7c5d71a01648cbd33334451a864c0ff5025e84fa1076","815156901b9d511feca3bb092a7afe7abb24b8553f93370a329a8f07b8104257","123a489b275e3f937c2d4746a452bf6c7dbb8193437ac444c0559d937c2157d6","f5ef992ce8b310af33c46a422cc8abe984c47056990d48707674733fa7b13da1","f9c1aee15b756de34d21