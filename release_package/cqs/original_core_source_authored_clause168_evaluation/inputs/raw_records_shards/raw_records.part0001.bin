{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21936},{"literal_text_all_w_t_and_m_t":"-- TAG-P-MAX-STOP","paragraph_zero_based":21937},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21938},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21939},{"literal_text_all_w_t_and_m_t":"–PathlossReferenceRS","paragraph_zero_based":21940},{"literal_text_all_w_t_and_m_t":"The IE PathlossReferenceRS is used to configure a Reference Signal (e.g. a CSI-RS config or a SS block) to be used for path loss estimation for PUSCH, PUCCH and SRS for unified TCI state operation.","paragraph_zero_based":21941},{"literal_text_all_w_t_and_m_t":"PathlossReferenceRS information element","paragraph_zero_based":21942},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21943},{"literal_text_all_w_t_and_m_t":"-- TAG-PATHLOSSREFERENCERS-START","paragraph_zero_based":21944},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21945},{"literal_text_all_w_t_and_m_t":"PathlossReferenceRS-r17 ::=   SEQUENCE {","paragraph_zero_based":21946},{"literal_text_all_w_t_and_m_t":"    pathlossReferenceRS-Id-r17          PathlossReferenceRS-Id-r17,","paragraph_zero_based":21947},{"literal_text_all_w_t_and_m_t":"    referenceSignal-r17                 CHOICE {","paragraph_zero_based":21948},{"literal_text_all_w_t_and_m_t":"        ssb-Index                           SSB-Index,","paragraph_zero_based":21949},{"literal_text_all_w_t_and_m_t":"        csi-RS-Index                        NZP-CSI-RS-ResourceId","paragraph_zero_based":21950},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":21951},{"literal_text_all_w_t_and_m_t":"    additionalPCI-r17                   AdditionalPCIIndex-r17                                         OPTIONAL  -- Cond RS-SSB","paragraph_zero_based":21952},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21953},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21954},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21955},{"literal_text_all_w_t_and_m_t":"-- TAG-PATHLOSSREFERENCERS-STOP","paragraph_zero_based":21956},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21957},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21958},{"literal_text_all_w_t_and_m_t":"PathlossReferenceRS field descriptions","paragraph_zero_based":21959}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["7ee864ec6617786844acabaf13aa6521206b76ec472808ce4efd52da17135a82","efbc63e72a474d8413e5637f5a8cedda633764e442fedddeae7456b41bc05caf","e00fb5cfa39a30b0de8d99c03cda130c61d79a4593bc436ae8033461d3124b71","b20072a225d8b08ca638d270ba5bc0e86f4f2899b5ee125d67fc2eb368641ecd","851dc4baaaa0a3f5ea263a74a0f854a7e3fee5f451eae6e985063d63dd490c9e","a27b386513d188f5ef80e4275e56243cc6322636067cd4caa031a24fbae12af3","bfff34c02dc4759b772748cd0840c25a3904a0c0b2b3a61a930f7250d632354d","8ad08fd0330ec29a6a2dbf30c23b075d0bbd5f7caded0c3da00f288ca8b3e7a4","ed57af387f3ec162fbaf2311919d1fa06fdddd6ac764ea1e3727114cc21d253c","fc717e744aa0306e9db1a0327923e4ec110d0090e1b019b8b9035ebfdb545bc2","ac1e195b732cd1a9e5ed07d393d22862b236b6e064752fa78eef52161127a8f5","56d52701637b127f9789c31d17ab7e551fe72e537fb3ad8b46df2bda93118b93","61946d3de65330ff8c8de5a5e2115b20ce6eb0003a23f4ae25b8b7e958b894e9","6450edaafcbb137c77def6b005c6bde5e99ff37ef5d2ed353892aceab9475a65","befd2bcdb5ed70ba582e53f1e8c6576a9c03d4c5cebed61459e6235e85a6717d","d77f81b4093e083c8bad849754f14cfb1ceab99daf496bb12a0cc2f15bb4aac8","28498dcc66e6f21e7987c66d7065b096ef04b