},{"literal_text_all_w_t_and_m_t":"    mgl-r17                             ENUMERATED {ms1dot5, ms3, ms3dot5, ms4, ms5dot5, ms6, ms10, ms20},","paragraph_zero_based":19238},{"literal_text_all_w_t_and_m_t":"    mgrp-r17                            ENUMERATED {ms20, ms40, ms80, ms160},","paragraph_zero_based":19239},{"literal_text_all_w_t_and_m_t":"    mgta-r17                            ENUMERATED {ms0, ms0dot25, ms0dot5},","paragraph_zero_based":19240},{"literal_text_all_w_t_and_m_t":"    gapType-r17                         ENUMERATED {perUE, perFR1, perFR2},","paragraph_zero_based":19241},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":19242},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":19243},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19244},{"literal_text_all_w_t_and_m_t":"MeasPosPreConfigGapId-r17 ::= INTEGER (1..maxNrofPreConfigPosGapId-r17)","paragraph_zero_based":19245},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19246},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASGAPCONFIG-STOP","paragraph_zero_based":19247}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["4665d177ead690a595365cc34c14cbc24fae97117b5230a600d35e85977230c1","b4e53a3d732ef25b2fa42f7dc0cce3f9b318ece17d4f4d337abb5c7ed6f32f8c","a796cafba6b213839d536b19284e33f44557e76ad674ef7561f8525dcaf073bd","c16082e636063977b5d1f35f92e542a79b5b7a52714ccbd2bb931058c98143c5","5e97daf9c3a0d1b18a334221211c84f2e26b226aa5f616fc3900c27b85dc0639","8281fb81cae892b4fd74e4fcccecc2577d42e283a9507a51da2ec0f2605c9aca","8310fd8624db2798bde5a3c0fbe966efb282a37f7df6d1c1ec46cc0350f2b55e","d30ec6e159d326e6105087c57f67fe88c49691e7981d3b5a6c8961e1d48e0230","242e9b1e454f012468fd246374414b37f07151d7114d3a57b8ab93908ff21fda","1c787cdd1edf4d13689c55d1e1bc798137c48934e5c58c1c53a2804459fdbe2d","db36a263fb297faeee142c593714b14fc5065708d645fdce293665ae1bbc4b3a","100f8ad36593271f9454c5c513637b62f66eca864b721ee2570acf4513e9d229","eca5d5777f35ecac362cdaf10358e1e263075ab914e4b2d6b7501485294e65e9","9a8ea0013f1f47087edaebe7bb38906bc711f68d637cc13d7704747ed02a68aa","c74fadb7ca9c68306ebc2d56a6468de65cf95796bfa7d6a9a09438facf009137","c62d881d251b7404fbefa7589a58da891e6b7329b74fba4af2238a9746a9a5ca","4827feb6cc574718c58f15ceac4a76f8392f13317d80a52db96d788d21206502","562c7075ab0d395b5154f217bca94859dd0d4f35a700cae5295776b0b8b3a076","f67d80fad2a8fd20ccb7afe7ec6e98264f5780a48d301192624f980780f1a621","2b7199d1c577722a1edab8beb63c66d6e5a032f15891be8617dc1c561af221d6","cf65c18022e4ef54557ad115831c82992b7d62aafaf604585bce6539355de293","5b18555b57156eaee67f5fc5b58087a8b5ebd870b445b655acb236f759b43794","807d971dc5dafbb265f7887290c57a3e6fd91b06f4e2e054bdc34437db85f8fb","89e2b9379499a0ac9b383121b1be633a5bcf93b358e08da5da6e46c7d31d1328"],"paragraph_range_zero_based":[19224,19247],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p19224"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":19248},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19249},{"literal_text_all_w_t_and_m_t":"MeasGapConfig field descriptions","paragraph_zero_based":19250},{"literal_text_all_w_t_and_m_t":"gapAssociationPRS","paragraph_zero_based":19251},{"literal_text_all_w_t_and_m_t":"Indicates that PRS measurement is associated with this measurement gap. The network only includes this field for one per-UE gap or for one per-FR gap. If concurrent gap (i.e. one of the gap combination as defined in Table 9.1.8-1 in TS 38.133 [14]) is configured and no gap is configured with this field, the PRS measurement is associated with the gap configured via GapConfig (without suffix), if available. If both per-UE gap and per-FR gap are configured via GapConfig and/or GapConfig-r17, the PRS measurement is always associated with the per-UE gap.","paragraph_zero_based":19252},{"literal_text_all_w_t_and_m_t":"gapFR1","paragraph_zero_based":19253},{"literal_text_all_w_t_and_m_t":"Indicates measurement gap configuration that applies to FR1 only. In (NG)EN-DC, gapFR1 cannot be set up by NR RRC (i.e. only LTE RRC can configure FR1 measurement gap). In NE-DC, gapFR1 can only be set up by NR RRC (i.e. LTE RRC cannot configure FR1 gap). In NR-DC, gapFR1 can only be set up in the measConfig associated with MCG. gapFR1 can not be configured together with gapUE. The applicability of the FR1 measurement gap is according to Table 9.1.2-2 and Table 9.1.2-3 in TS 38.133 [14].","paragraph_zero_based":19254},{"literal_text_all_w_t_and_m_t":"gapFR2","paragraph_zero_based":19255},{"literal_text_all_w_t_and_m_t":"Indicates measurement gap configuration applies to FR2 only. In (NG)EN-DC or NE-DC, gapFR2 can only be set up by NR RRC (i.e. LTE RRC cannot configure FR2 gap). In NR-DC, gapFR2 can only be set up in the measConfig associated with MCG. gapFR2 cannot be configured together with gapUE. The applicability of the FR2 measurement gap is according to Table 9.1.2-2 and Table 9.1.2-3 in TS 38.133 [14].","paragraph_zero_based":19256},{"literal_text_all_w_t_and_m_t":"gapOffset","paragraph_zero_based":19257},{"literal_text_all_w_t_and_m_t":"Value gapOffset is the gap offset of the gap pattern with MGRP indicated in the field mgrp. The value range is from 0 to mgrp-1. If ncsgInd-r17 is present, this offset value refers to the starting point of VIL1 (the visible interruption length before the ML).","paragraph_zero_based":19258},{"literal_text_all_w_t_and_m_t":"gapPriority","paragraph_zero_based":19259},{"literal_text_all_w_t_and_m_t":"Indicates the priority of this measurement gap (see TS 38.133 [14], clause 9.1.8.3). Value 1 indicates highest priority, value 2 indicates second level priority, and so on.","paragraph_zero_based":19260},{"literal_text_all_w_t_and_m_t":"gapSharing","paragraph_zero_based":19261},{"literal_text_all_w_t_and_m_t":"Indicates the measurement gap sharing scheme that applies to this GapConfig. For applicability of the different gap sharing schemes, see TS 38.133 [14]. Value scheme00 corresponds to scheme \"00\", value scheme01 corresponds to scheme \"01\", and so on.","paragraph_zero_based":19262},{"literal_text_all_w_t_and_m_t":"gapToAddModList","paragraph_zero_based":19263},{"literal_text_all_w_t_and_m_t":"A list of of measurement gap configuration to be added or modified. If more than one measurement gap is configured (i.e. concurrent measurement gap as specified in TS 38.133[14], clause 9.1.8), the maximum number of configured measurement gap is limited by the gap combinations defined in Table 9.1.8-1 in TS 38.133 [14]. The network configures at most one NCSG or pre-configured measurement gap for a given gap type. In this version of the specification, the network configures this field only in NR standalone. This field is used only for a UE that supports pre-configured measurement gap, concurrent measurement gap, or NCSG. In this version of the specification, the network does not configure concurrent measurement gap together with MUSIM gap or preconfigured measurement gap for positioning.","paragraph_zero_based":19264},{"literal_text_all_w_t_and_m_t":"gapToReleaseList","paragraph_zero_based":19265},{"literal_text_all_w_t_and_m_t":"A list of measurement gap configuration to be released.","paragraph_zero_based":19266},{"literal_text_all_w_t_and_m_t":"gapType","paragraph_zero_based":19267},{"literal_text_all_w_t_and_m_t":"Indicates the type of this measurement gap. Value perUE indicates that it is a per UE measurement gap, value perFR1 indicates that it is an FR1 measurement gap, and value perFR2 indicates that it is an FR2 measurement gap.","paragraph_zero_based":19268},{"literal_text_all_w_t_and_m_t":"gapUE","paragraph_zero_based":19269},{"literal_text_all_w_t_and_m_t":"Indicates measurement gap configuration that applies to all frequencies (FR1 and FR2). In (NG)EN-DC, gapUE cannot be set up by NR RRC (i.e. only LTE RRC can configure per UE measurement gap). In NE-DC, gapUE can only be set up by NR RRC (i.e. LTE RRC cannot configure per UE gap). In NR-DC, gapUE can only be set up in the measConfig associated with MCG. If gapUE is configured, then neither gapFR1 nor gapFR2 can be configured. The applicability of the per UE measurement gap is according to Table 9.1.2-2 and Table 9.1.2-3 in TS 38.133 [14].","paragraph_zero_based":19270},{"literal_text_all_w_t_and_m_t":"measGapId","paragraph_zero_based":19271}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["62c194fb215bfa342f9be122c88faebb757b5e1e03e8f3277b59e97271319033","7e46423326ee70561ca549b73d0e0597c95089e80b1ac28dd73d0b87ebb70254","edef4fe6ae4a4aad7ae355fd310decf3ab852d45aa6e298fffa6dcee226b3037","42cdf862632f6959affb16cd9820a8a54bc34f7a7099778341d4ef7a116000d8","15cdc9bb094f1ed5a209eeb24865473479c397b8e8040db7d0f254c7a3275f88","3a3deaf5e40f86c4024034f06d4f63af68e45b6c8b20b8a9b5783cc7a391e332","dae87235629cffcc3fb203c16b5d4e35ffac45022b22df22646f48413c6e8466","e3e8df92704a22b1e8c4c029db52e833bd09b52c96c34907dea0d0c03369c8d1","ee59d29fed4c65d812bd8ac36bd68a8ae9cbb2abb1484d82e6b70cbb144f399d","2e4ebee400f2b192a19f59c685dd1a414bce1ce0025c879fc1b0130b20518603","0d175b3c2caed26495aa2cffe4dd9718c39149279ad6e66859fa37472b0aa0ef","4c0ca8b3a04af2cbded900090a1eb959db6c810d1130d70aa770736e2eeec244","ea540319a34a4fb483e0c3d0331a95fe0df88524b065c31af4ec28ebfa42c815","ea0a6d4d1a5b7ec7e4719fc70f70a88911ea543a75e54d70841f129610d0a2f9","cc766da78a4605eca22ca086c6e4883cffbb0ec6f14ba9a6ae3c31e51531ec87","2ae05bfc3fe3798bc91590e08f2ca8c03ea5a5ff770346aa3c10e08e4b50ceb6","bc0dd0176c5fb8c06bb6da006e940f673558bf25723aba5262b05c6b4d4b190a","07665151e43e8bd687e62f5e9c916323db2c390f662332cbef00cf7c3c5f33c4","792a81efe511eccb1a78809ad65d85654c371236f17e87f7c1c0e251c212219d","30ea8b5fa1c27ce9498ccfdd89bee42b48fcd5fcf6326d6d86f94a905cb57c2a","d99fb0825718ee9c85a3ecdf56c63aeddbe17265d60f924bda3bead8f6d4f3cb","0a2e4699b7fc5b13e97b6e93109eb83df740addcdc5ada0ea0c2558f7a335526","839fabb6ae1826c9097ee51ac390e41977532680c9c808386bcc7419eecafe21","189e67ab1c871c5115c3a261becbcb93fc135a8ce0a7d0505039e8a67d72f884"],"paragraph_range_zero_based":[19248,19271],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p19248"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The ID of this measurement gap configuration.","paragraph_zero_based":19272},{"literal_text_all_w_t_and_m_t":"mgl","paragraph_zero_based":19273},{"literal_text_all_w_t_and_m_t":"Value mgl is the measurement gap length in ms of the measurement gap. If ncsgInd-r17 is not present, the measurement gap length is according to in Table 9.1.2-1 in TS 38.133 [14]. If ncsgInd-r17 is present, this field indicates the measurement length (ML) in NCSG pattern and is configured according to Table 9.1.9.3-1 in TS 38.133 [14]. Value ms1dot5 corresponds to 1.5 ms, ms3 corresponds to 3 ms and so on. If mgl-r16 is present, UE shall ignore the mgl (without suffix). Value ms1, ms2, and ms5 can only be configured if ncsgInd is present.","paragraph_zero_based":19274},{"literal_text_all_w_t_and_m_t":"mgrp","paragraph_zero_based":19275},{"literal_text_all_w_t_and_m_t":"If ncsgInd-r17 is not present, the mgrp field indicates the measurement gap repetition period in (ms) of the measurement gap according to Table 9.1.2-1 in TS 38.133 [14]. If ncsgInd-r17 is present, the mgrp field indicates the Visible Interruption Repetition Period (VIRP) of NCSG pattern and is configured according to Table 9.1.9.3-1 in TS 38.133 [14].","paragraph_zero_based":19276},{"literal_text_all_w_t_and_m_t":"mgta","paragraph_zero_based":19277},{"literal_text_all_w_t_and_m_t":"Value mgta is the measurement gap timing advance in ms. The applicability of the measurement gap timing advance is according to clause 9.1.2 of TS 38.133 [14], or according to clause 9.1.9 of TS 38.133 [14] if ncsgInd is present. Value ms0 corresponds to 0 ms, ms0dot25 corresponds to 0.25 ms, ms0dot5 corresponds to 0.5 ms and ms0dot75 corresponds to 0.75 ms. For FR2, the network only configures 0 ms and 0.25 ms if ncsgInd is not present. If ncsgInd is present, the network only configures 0ms for per-UE NCSG and FR1 NCSG and only configures 0ms or 0.75ms for FR2 NCSG. Value ms0dot75 can only be configured if ncsgInd is present.","paragraph_zero_based":19278},{"literal_text_all_w_t_and_m_t":"ncsgInd","paragraph_zero_based":19279},{"literal_text_all_w_t_and_m_t":"Indicates that the measurement gap is a NCSG as specified in 38.133 [14].","paragraph_zero_based":19280},{"literal_text_all_w_t_and_m_t":"posMeasGapPreConfigToAddModList","paragraph_zero_based":19281},{"literal_text_all_w_t_and_m_t":"List of preconfigured measurement gap for positioning to add and/or modify. All the gaps configured are associated with the measurement of PRS for RSTD, UE-RxTx Time Difference, PRS-RSRP and PRS-RSRPP as defined in TS 38.215 [9]. In this version of the specification, the network does not configure preconfigured measurement gap for positioning together with concurrent measurement gap or MUSIM gap.","paragraph_zero_based":19282},{"literal_text_all_w_t_and_m_t":"posMeasGapPreConfigToReleaseList","paragraph_zero_based":19283},{"literal_text_all_w_t_and_m_t":"List of preconfigured measurement gap for positioning to release.","paragraph_zero_based":19284},{"literal_text_all_w_t_and_m_t":"preConfigInd","paragraph_zero_based":19285},{"literal_text_all_w_t_and_m_t":"Indicates whether the measurement gap is a pre-configured measurement gap.","paragraph_zero_based":19286},{"literal_text_all_w_t_and_m_t":"refFR2ServCellAsyncCA","paragraph_zero_based":19287},{"literal_text_all_w_t_and_m_t":"Indicates the FR2 serving cell identifier whose SFN and subframe is used for FR2 gap calculation for this gap pattern with asynchronous CA involving FR2 carrier(s).","paragraph_zero_based":19288},{"literal_text_all_w_t_and_m_t":"refServCellIndicator","paragraph_zero_based":19289},{"literal_text_all_w_t_and_m_t":"Indicates the serving cell whose SFN and subframe are used for gap calculation for this gap pattern. Value pCell corresponds to the PCell, pSCell corresponds to the PSCell, and mcg-FR2 corresponds to a serving cell on FR2 frequency in MCG.","paragraph_zero_based":19290},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19291},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":19292},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":19293},{"literal_text_all_w_t_and_m_t":"AsyncCA","paragraph_zero_based":19294},{"literal_text_all_w_t_and_m_t":"This field is mandatory present when configuring and reconfiguring FR2 gap pattern to UE in:","paragraph_zero_based":19295}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["97715bf6cadd58d65119973d4bc0fb0b05e40b669ebd93ddc44b075fcd8ece26","d37fca5282a6631f08ce019b18f242c644a94228edd8f8913a852fa0a35737ca","3cc8e50d7248e2ce2669e591700c4c629d6e9daaba575214ee30947b608795f8","bb543589083542780b4e75737f7148cfe5213892c5b45cb0d9dbc462ac1ded6e","26221d3e0380509bfe9a4f2bff64ae007e4467a5adf1b2b4f0ee9dab25abf873","55561f9d18aaca5cadfe18010f0a315b776a85c88e1eef997c5334d46add6a04","561462b24f08b4bd20df289fc019bdd564dc0f9e3596414c028f3825039dc1f8","602fca069ebea0c05b8661d364eeeffa97495f323796e50299999972f38dcec7","1ecb655b4492cf790ffda66401d040ddd7ba5963714bd8d4cd745c6d1c8b4540","1dbda454b0ffaac01c98624dee97869096a178b1517b6ba55b37edd799e82559","afdfdf5080458c3d823bac9410aa12a083b8c02e08b750dafc8d1076fb998cfa","73194c64b22063e2cc6c29fbd6a01150c4b423e5e026bd8eeafe5f9361bf6206","a5b214a516c5f80eab46ff9d22cbe85265bd8dbbe138f25d07e17475d1a4ed7e","00242876cb74e63f3b92ba4b0fa7b04ef2038c2c3678099e6420a762ff96e6c5","78e102f5230dc8a95a9847dea4399a652989a4621c11f4a7fe0fbc9469d0937d","d384dbd47bdb773a1b84bc48b6a6633e38821e35159d57806f48182215dd5315","11ae684b110484d0d33460df27adbd68bf7b7bd1f21450ea53f32e1e5c46a6eb","81e658a62d2d883aec6cd3a9aead5a08c857b1ba7d7597307b4db252fd89eda2","26fa04d6f3e8b3be23808a85f22fbd1d233447e127baeaa32ba1bd3029a78f67","66fca0b0618c8069d5a39f1bef1395215c58c58484215cf6a97e6641db7080fc","89114b8e26d35a335b697009c03adec15c0c42a1174e0d730213461809f0032c","27e3a81f3388357dfac859b2e3b4badad76178c135465d3517646eb956902424","3d42d7ba1be86318db5cc83698e8a3f1bd3f49659d0bdc8a2515735aeed891cc","46a9aa924e8a46e22dbcffa76ac668c732607770ba1453ddb9af76641fcf4add"],"paragraph_range_zero_based":[19272,19295],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p19272"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"- (NG)EN-DC or NR SA with asynchronous CA involving FR2 carrier(s);","paragraph_zero_based":19296},{"literal_text_all_w_t_and_m_t":"- NE-DC or NR-DC with asynchronous CA involving FR2 carrier(s), if the field refServCellIndicator is set to mcg-FR2.","paragraph_zero_based":19297},{"literal_text_all_w_t_and_m_t":"Otherwise, it is absent, Need R.","paragraph_zero_based":19298},{"literal_text_all_w_t_and_m_t":"NEDCorNRDC","paragraph_zero_based":19299},{"literal_text_all_w_t_and_m_t":"This field is mandatory present when configuring and reconfiguring gap pattern to UE in NE-DC or NR-DC. Otherwise, it is absent, Need R.","paragraph_zero_based":19300},{"literal_text_all_w_t_and_m_t":"PRS","paragraph_zero_based":19301},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, when configuring gap pattern to UE for measurements of DL-PRS configured via LPP (TS 37.355 [49]). Otherwise, it is absent.","paragraph_zero_based":19302},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19303},{"literal_text_all_w_t_and_m_t":"–MeasGapId","paragraph_zero_based":19304},{"literal_text_all_w_t_and_m_t":"The IE MeasGapId used to identify a per UE or per FR measurement gap configuration.","paragraph_zero_based":19305},{"literal_text_all_w_t_and_m_t":"MeasGapId information element","paragraph_zero_based":19306},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":19307},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASGAPID-START","paragraph_zero_based":19308},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19309},{"literal_text_all_w_t_and_m_t":"MeasGapId-r17 ::=                       INTEGER (1..maxNrofGapId-r17)","paragraph_zero_based":19310},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19311},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASGAPID-STOP","paragraph_zero_based":19312},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":19313},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19314},{"literal_text_all_w_t_and_m_t":"–MeasGapSharingConfig","paragraph_zero_based":19315},{"literal_text_all_w_t_and_m_t":"The IE MeasGapSharingConfig specifies the measurement gap sharing scheme and controls setup/ release of measurement gap sharing.","paragraph_zero_based":19316},{"literal_text_all_w_t_and_m_t":"MeasGapSharingConfig information element","paragraph_zero_based":19317},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":19318},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASGAPSHARINGCONFIG-START","paragraph_zero_based":19319}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["5592d558f201b3aa6362d599a0b4fca25ba65d2ef5772e22482a9e9d6f97927c","50296db89aba726699f949a7831f6d19e06c77d737ac8ae05133112c3b09ad8d","2a22e102150a676e60bea2e92db27d4001471224e1adb0ede41b0de3a2ed0446","d317c4be822011c242cd47a314d55d461d016a83e799d946e68973ceb1b40b8f","5fe99423a7218101f52f43ff51aa44f83f5146227ca8b72df101efbb317c8f70","8b1ed628feaa5124dc8c612df3a9162fd9e2a2874da01d0e0d6e7e56734027e1","b1dd06d94b3aac94b5bcb393498797f37a667ef215ff645546b81d10ff338334","0fe3e94f534a5f5307037e00c0db538759355a30acf62417570182799a5cc9fe","cad612b62de999664cb48d9a2a521c8a8039b0802062c7ce6476697658b33f24","c84d45e750127497fbe28adea9c2914476de157665a66ffaf51a25edf3eb955b","500bad8c839de3a84107f897df9a9d87bfc69997d7ddd20a920bc6c8f2321f53","f1d9247dc92aa3c04cb6d3f41689cedc9fcb1608c394b3fb32a8f337886f4e42","fa62fc96505ed9c38ff6c550452235d38045dac8a0e49771506dae859eeb1299","626f102285e5be1f7fd20f7b1d45d2eba2909965638a1103867c0e3f337d4eda","f395797015d1c36ce80a51b6b4ca66ccdca591702af6423f382bae81ede16480","176c0e4d054be6896778287a8e7c0c3ab88828954e7ffce5cc194ffb23065783","5fbea1c7f73c67e54509bf8f317ab35900a3703d28291b027a121d6f6e3661f3","e25e4e5af216e7f893ca4c49b625717472f01e45ccc752536474a57b04d7b2e2","9e1d63db595d0e9a626165022228f92a9fa365f949af4f3d5b83acea78b40636","77419486d5d11cedb39475c25d0411db11bb24b8cf6f714994132839ff6e8656","95a7d49e686cea36d6560783d7b92e7ec1fa1f4ac4a0ad802ec232b48da2dea0","d703dc1b449f147139de0d86ceb713f843e9972f3b75fe9846d540f74c29e458","ccddc58eb0df00e2cbd589de0ebf2db3af9b6b2a01d4364c992ca541c7cd8d89","a07ad65196134997e5f96f3d779e3310e934005e42d676ec24eb6b6ead367edb"],"paragraph_range_zero_based":[19296,19319],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p19296"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19320},{"literal_text_all_w_t_and_m_t":"MeasGapSharingConfig ::=        SEQUENCE {","paragraph_zero_based":19321},{"literal_text_all_w_t_and_m_t":"    gapSharingFR2                   SetupRelease { MeasGapSharingScheme }       OPTIONAL,   -- Need M","paragraph_zero_based":19322},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":19323},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":19324},{"literal_text_all_w_t_and_m_t":"    gapSharingFR1                   SetupRelease { MeasGapSharingScheme }       OPTIONAL,   --Need M","paragraph_zero_based":19325},{"literal_text_all_w_t_and_m_t":"    gapSharingUE                    SetupRelease { MeasGapSharingScheme }       OPTIONAL    --Need M","paragraph_zero_based":19326},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":19327},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":19328},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19329},{"literal_text_all_w_t_and_m_t":"MeasGapSharingScheme::=         ENUMERATED {scheme00, scheme01, scheme10, scheme11}","paragraph_zero_based":19330},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19331},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASGAPSHARINGCONFIG-STOP","paragraph_zero_based":19332},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":19333},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19334},{"literal_text_all_w_t_and_m_t":"MeasGapSharingConfig field descriptions","paragraph_zero_based":19335},{"literal_text_all_w_t_and_m_t":"gapSharingFR1","paragraph_zero_based":19336},{"literal_text_all_w_t_and_m_t":"Indicates the measurement gap sharing scheme that applies to the gap set via gapFR1. In (NG)EN-DC, gapSharingFR1 cannot be set up by NR RRC (i.e. only LTE RRC can configure FR1 gap sharing). In NE-DC, gapSharingFR1 can only be set up by NR RRC (i.e. LTE RRC cannot configure FR1 gap sharing). In NR-DC, gapSharingFR1 can only be set up in the measConfig associated with MCG. gapSharingFR1 can not be configured together with gapSharingUE. For the applicability of the different gap sharing schemes, see TS 38.133 [14]. Value scheme00 corresponds to scheme \"00\", value scheme01 corresponds to scheme \"01\", and so on.","paragraph_zero_based":19337},{"literal_text_all_w_t_and_m_t":"gapSharingFR2","paragraph_zero_based":19338},{"literal_text_all_w_t_and_m_t":"Indicates the measurement gap sharing scheme that applies to the gap set via gapFR2. In (NG)EN-DC or NE-DC, gapSharingFR2 can only be set up by NR RRC (i.e. LTE RRC cannot configure FR2 gap sharing). In NR-DC, gapSharingFR2 can only be set up by MCG in the measConfig associated with MCG. gapSharingFR2 cannot be configured together with gapSharingUE. For applicability of the different gap sharing schemes, see TS 38.133 [14]. Value scheme00 corresponds to scheme \"00\", value scheme01 corresponds to scheme \"01\", and so on.","paragraph_zero_based":19339},{"literal_text_all_w_t_and_m_t":"gapSharingUE","paragraph_zero_based":19340},{"literal_text_all_w_t_and_m_t":"Indicates the measurement gap sharing scheme that applies to the gap set via gapUE. In (NG)EN-DC, gapSharingUE cannot be set up by NR RRC (i.e. only LTE RRC can configure per UE gap sharing). In NE-DC, gapSharingUE can only be set up by NR RRC (i.e. LTE RRC cannot configure per UE gap sharing). In NR-DC, gapSharingUE can only be set up in the measConfig associated with MCG. If gapSharingUE is configured, then neither gapSharingFR1 nor gapSharingFR2 can be configured. For the applicability of the different gap sharing schemes, see TS 38.133 [14]. Value scheme00 corresponds to scheme \"00\", value scheme01 corresponds to scheme \"01\", and so on.","paragraph_zero_based":19341},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19342},{"literal_text_all_w_t_and_m_t":"–MeasId","paragraph_zero_based":19343}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["d49313af79ede8925431edbaf6b0544eb330086957d900edbf7cd066e248f2cd","4e314a5a9e7ce6be7ae131e836c4ca566cdf8baf395a903d2ec21a1cd6a63838","187aa8007f9943128f1d2359b7730bd59fc6054dd2dbc3b880d7860bc4c260d8","4adffdeec9be9eb7d1c9e13bcd96151540d613d02a14d9661237ba36df9e1602","1d5f73386403b6e3587af0a66b69b24ff1b09863a4d9ff9e37d90a2638bdfb9a","aa2aef41a5bc8620795072c2dd679b9f2857e317beb2fc636ab89f0a10e4c1da","12020c0cd515f4d823d0cdbe7fb129da09bf0f1a9937384f85601fcf1f79a389","ff5d5265ec7f43cab006682468abf77866726c976cc026256e3c2ab48e055d36","4806a2dd52aee2d90b51631df6d5761a1a2da29e287cf3bbe267068282abf922","95aba327fb7c9b064466330f4ac62848f5891658ab2e55807b8828072946a36d","26c32a27f8dbbb1584a7e594037a3daa262f5d5ba71821f53f48566d6bfc823f","9402eaa583944f645ec8f600a0648be0c06e5fda5d91f40235be2e02bed16483","9daba67071d5d5ade90a3dbbfce5815d6f7ea7bb2c45575f7c20a0dadc4d9df9","75e2d6a41e8b4337125a09b39d5784f017360c66c64f1c3ae33b23595d06aea6","02da03755be9e30c265ca3944550a1b52d83f83a920efd95f980c11d822b632c","f8f74257be4d4c001dd7d8c680ef6035744169ad991f6ebbcdb50d7d89a41396","feb183de43d3b25db476592412f3650ac7bee0a261172cfbaf2e8a5c1dad4ff4","cae5841bb4464ec06e6380180ad176863380f5f93ade5ff5436b0a5d5145fee6","bf16f7d671d64e6fcbcd88bf5d9806b2caa4aaf43e778bdbef9e1b951a92c179","fb62b1e9197025c3729e6d13c1e4a96aebb5277ab7ca9cd86b26d034d4df8c55","820dd44c877c07da3ad46d33cf1a0b24b93a2aea59b6ca24a48ab5c2e2dfcd19","2c3ca4a0c2ce7d276952d41681ec817c20004923d5730d1db7e62f374d56783b","32ad6f9fc8591a2da8558d205b706029a5964e6f64bdd2aa44c2c5c810e8b460","3