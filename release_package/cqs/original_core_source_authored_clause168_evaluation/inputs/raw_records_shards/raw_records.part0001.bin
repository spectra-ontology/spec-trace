{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26520},{"literal_text_all_w_t_and_m_t":"–RSSI-Range","paragraph_zero_based":26521},{"literal_text_all_w_t_and_m_t":"The IE RSSI-Range specifies the value range used in RSSI measurements and thresholds for NR operation with shared spectrum channel access. The integer value for RSSI measurements is according to Table 10.1.34.3-1 in TS 38.133 [14].","paragraph_zero_based":26522},{"literal_text_all_w_t_and_m_t":"RSSI-Range information element","paragraph_zero_based":26523},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26524},{"literal_text_all_w_t_and_m_t":"-- TAG-RSSI-RANGE-START","paragraph_zero_based":26525},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26526},{"literal_text_all_w_t_and_m_t":"RSSI-Range-r16 ::=                  INTEGER(0..76)","paragraph_zero_based":26527},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26528},{"literal_text_all_w_t_and_m_t":"-- TAG-RSSI-RANGE-STOP","paragraph_zero_based":26529},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26530},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26531},{"literal_text_all_w_t_and_m_t":"–RxTxTimeDiff","paragraph_zero_based":26532},{"literal_text_all_w_t_and_m_t":"The IE RxTxTimeDiff contains the Rx-Tx time difference measurement at either the UE or the gNB.","paragraph_zero_based":26533},{"literal_text_all_w_t_and_m_t":"RxTxTimeDiff information element","paragraph_zero_based":26534},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26535},{"literal_text_all_w_t_and_m_t":"-- TAG-RXTXTIMEDIFF-START","paragraph_zero_based":26536},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26537},{"literal_text_all_w_t_and_m_t":"RxTxTimeDiff-r17  ::= SEQUENCE {","paragraph_zero_based":26538},{"literal_text_all_w_t_and_m_t":"    result-k5-r17         INTEGER (0..61565)                 OPTIONAL, -- Need N","paragraph_zero_based":26539},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":26540},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":26541},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26542},{"literal_text_all_w_t_and_m_t":"-- TAG-RXTXTIMEDIFF-STOP","paragraph_zero_based":26543}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["34b4278a8c491bbbe556354566c303d5e5642fb09a5ab3f0cbc449bdcb7edbc5","441634f0e4e895ff3c835471f158e0cd695708aec9d14b40380a3cc9be52218b","85de602553258880b393d48199d36e625862c405d589e03c446f1c1d948a0db9","8d51fb206fbccd61a2fcc31f2baa2bb7d2ddfde63be2af48461605a07761d00d","6bf7ccefd1b45352163b7bbe2afb040d19c43e566141ec8b9e272b534f71e4aa","9bc9e65f60fea80f27a6aaf00bb1ae83dffeb28cc62b1f5b3e9fd6251711d81c","d9a13cf8259e4ecdc45099fe0bea612bbefc964ca5ff58b03cfa774361acaff1","fae955ae61edb13f88aee5b3edd2ac1774bef06334070afbac3c8fa606c7f7cf","e0bca45c20dcf25a7201542168b81e75c2dc9689a5be8903bfc93752e62c6eb3","547f03edcb34723dd115dae71e8dcd981f099f81dd6c4dee037a9e352afb2885","e51ee0a2a6f5e4ffbac194170a5df26fb42779d4d58d129539675cbd43e71c70","37deff205d4ec439264805c9ef0cccd0c598de8b33c44b64d65386f96c882a6d","c2a2c4cb2fcf2be339a7f2cf505ea6c3043628ba785eb8f1fd6d5e904ca441b0","eb33ed6ed251313bc9a71920061076fa2d564fe96e8cc58196003066142d9526","0002a5b1eadc8bb7acb33ae4ed69aaf42406a72df7f4103a11854dbff9dd6915","85f245459d8eb41166cfd61d660e8e77c460d165ab384d9ae64dda26e00718be","d3081aebf54d1b06ccad1dbef38d911036f90c4a38906e0bbdba5bdcb8fd243e","0adb2102c1b5c164b8abd04a399464913f3715001c945ee94dde145adf230096"