{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12024},{"literal_text_all_w_t_and_m_t":"SL-TrafficPatternInfo-r16::=          SEQUENCE {","paragraph_zero_based":12025},{"literal_text_all_w_t_and_m_t":"    trafficPeriodicity-r16                ENUMERATED {ms20, ms50, ms100, ms200, ms300, ms400, ms500, ms600, ms700, ms800, ms900, ms1000},","paragraph_zero_based":12026},{"literal_text_all_w_t_and_m_t":"    timingOffset-r16                      INTEGER (0..10239),","paragraph_zero_based":12027},{"literal_text_all_w_t_and_m_t":"    messageSize-r16                       BIT STRING (SIZE (8)),","paragraph_zero_based":12028},{"literal_text_all_w_t_and_m_t":"    sl-QoS-FlowIdentity-r16               SL-QoS-FlowIdentity-r16","paragraph_zero_based":12029},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":12030},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12031},{"literal_text_all_w_t_and_m_t":"UL-GapFR2-Preference-r17::=           SEQUENCE {","paragraph_zero_based":12032},{"literal_text_all_w_t_and_m_t":"    ul-GapFR2-PatternPreference-r17       INTEGER (0..3)                     OPTIONAL","paragraph_zero_based":12033},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":12034},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12035},{"literal_text_all_w_t_and_m_t":"PropagationDelayDifference-r17 ::=  SEQUENCE (SIZE (1..4)) OF INTEGER (-270..270)","paragraph_zero_based":12036},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12037},{"literal_text_all_w_t_and_m_t":"-- TAG-UEASSISTANCEINFORMATION-STOP","paragraph_zero_based":12038},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":12039},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12040},{"literal_text_all_w_t_and_m_t":"UEAssistanceInformation field descriptions","paragraph_zero_based":12041},{"literal_text_all_w_t_and_m_t":"affectedCarrierFreqList","paragraph_zero_based":12042},{"literal_text_all_w_t_and_m_t":"Indicates a list of NR carrier frequencies that are affected by IDC problem.","paragraph_zero_based":12043},{"literal_text_all_w_t_and_m_t":"affectedCarrierFreqCombList","paragraph_zero_based":12044},{"literal_text_all_w_t_and_m_t":"Indicates a list of NR carrier frequencie combinations that are affected by IDC problems due to Inter-Modulation Distortion and harmonics from NR when configured with UL CA.","paragraph_zero_based":12045},{"literal_text_all_w_t_and_m_t":"bfd-MeasRelaxationState","paragraph_zero_based":12046},{"literal_text_all_w_t_and_m_t":"Indicates the relaxation state of BFD measurements. Each bit corresponds to a serving cell of the cell group. A serving cell is mapped to the (servCellIndex+1)-th bit, starting from MSB. A bit that is set to 1 indicates that the UE is performing BFD measurements relaxation on the serving cell mapped on the bit. A bit that is set to 0 indicates that the UE is not performing BFD measurements relaxation on the serving cell mapped on the bit. If a serving cell is not configured to the UE, the corresponding bit is set to 0.","paragraph_zero_based":12047}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["f2dd008ad18275b89fd0000b3d5b58134ea84f816390db866e7f0bfe6e11e06c","bcf4910ddb8793d713f909f43dd0fbb696d46c98d1b84f141b59d44f91247148","2558ba72cadd2a537160e050edb2284dec168619503dae1dd837bb053df53c39","aed30f1c07ccf69f5f460b4abf3cb93f242158cddf4da8c4b6f94f31f479a1a5","a1c89262d90315a72657de9ebd05cdb8e02dc1e79b9f7a9084e75dbb92bb50f5","d8c6e462ccd18db312605fba0190a139ee2ed0ff7356834db79d097d41b45f61","84400493230276cc3d7c31993ed57e298692fa7e1dc1a8540b83e16f5d0de31f","f733c69129ae27319147199ef9b8e75430e602e4f24821cd615354a46e1e49d0","d0174025fce41112fa4a1fb9c72295cf25239f0461e277c489eee2bcd776c242","34f0dbf4d6e1549abe30cf4c5853d78b401b343c1103bea58454956aade73427","729b2380be92e8f96eb40d742ebf0fe77bc40e33cb28675939e5b1edd118bf4a","72da0f6c7e92388ceb5548b55523de0eb8ab4afca4e90ba85ca2b9043736a5a1","8941745dc3d4eec09d9b0ea92824af16f8487b7a7f37508170fd99611f23eb2f","3e1aa14660168d365a4ad6b08a75f499bc9af7ed5a37adedb2cb356d32658e26","41d9c471ca5a1a8f9aeb43a299ddab6b96b9abae317f9395486dfa9ee57c3903","a507c3f3fc22cd3a0f3a0bf7cdfd2cf96a262fbb6bf00a28a4400a3a07564cff","a79d11e2890a5e0286d511fb98c7bb3ad09fadcc863cce86ce719703f3648a4b","3d9bf4ee4de95f3c82c19c49dff42a1affab7a805f6ea4a82e45d268161c1265","282ad825236f3b348b18710b8b0eccac8ae711d99f1fa0810e99387f2a0cbc3a","85cd0262d05cb0f72bdc2b8423f425f9b34a1a8e6b4f641d997bd379888832f7","2d88f703eb1ede88e9e59a14f8c1bd7981b7463abf07015136a5fd92d6c1d129","2717c8d48b72eb3bd6a960c99517c60fda9ffd1e99572bccd2eca05dca7d3c94","10acc627fde2da9f3574e82d3777f4ec1efb98a7af7cab79c609befeb63d37cf","a629217da423ea2402dab85097c5b9583715b30a8310c9bba44988d6cb19a94a"],"paragraph_range_zero_based":[12024,12047],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p12024"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"delayBudgetReport","paragraph_zero_based":12048},{"literal_text_all_w_t_and_m_t":"Indicates the UE-preferred adjustment to connected mode DRX.","paragraph_zero_based":12049},{"literal_text_all_w_t_and_m_t":"interferenceDirection","paragraph_zero_based":12050},{"literal_text_all_w_t_and_m_t":"Indicates the direction of IDC interference. Value nr indicates that only NR is victim of IDC interference, value other indicates that only another radio is victim of IDC interference and value both indicates that both NR and another radio are victims of IDC interference. The other radio refers to either the ISM radio or GNSS (see TR 36.816 [44]).","paragraph_zero_based":12051},{"literal_text_all_w_t_and_m_t":"minSchedulingOffsetPreference","paragraph_zero_based":12052},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferences on minimumSchedulingOffset of cross-slot scheduling for power saving.","paragraph_zero_based":12053},{"literal_text_all_w_t_and_m_t":"minSchedulingOffsetPreferenceExt","paragraph_zero_based":12054},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferences on minimumSchedulingOffset of cross-slot scheduling for power saving for SCS 480 kHz and/or 960 kHz.","paragraph_zero_based":12055},{"literal_text_all_w_t_and_m_t":"musim-GapPreferenceList","paragraph_zero_based":12056},{"literal_text_all_w_t_and_m_t":"Indicates the UE's MUSIM gap preference and related MUSIM gap configuration, as defined in TS 38.133 [14] clause 9.1.10.","paragraph_zero_based":12057},{"literal_text_all_w_t_and_m_t":"musim-PreferredRRC-State","paragraph_zero_based":12058},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred RRC state when leaving RRC_CONNECTED.","paragraph_zero_based":12059},{"literal_text_all_w_t_and_m_t":"nonSDT-DataIndication","paragraph_zero_based":12060},{"literal_text_all_w_t_and_m_t":"Informs the network about the arrival of data and/or signaling mapped to radio bearers not configured for SDT while SDT procedure is ongoing.","paragraph_zero_based":12061},{"literal_text_all_w_t_and_m_t":"preferredDRX-InactivityTimer","paragraph_zero_based":12062},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred DRX inactivity timer length for power saving. Value in ms (milliSecond). ms0 corresponds to 0, ms1 corresponds to 1 ms, ms2 corresponds to 2 ms, and so on. If the field is absent from the DRX-Preference IE, it is interpreted as the UE having no preference for the DRX inactivity timer. If secondary DRX group is configured, the preferredDRX-InactivityTimer only applies to the default DRX group.","paragraph_zero_based":12063},{"literal_text_all_w_t_and_m_t":"preferredDRX-LongCycle","paragraph_zero_based":12064},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred long DRX cycle length for power saving. Value in ms. ms10 corresponds to 10ms, ms20 corresponds to 20 ms, ms32 corresponds to 32 ms, and so on. If preferredDRX-ShortCycle is provided, the value of preferredDRX-LongCycle shall be a multiple of the preferredDRX-ShortCycle value. If the field is absent from the DRX-Preference IE, it is interpreted as the UE having no preference for the long DRX cycle.","paragraph_zero_based":12065},{"literal_text_all_w_t_and_m_t":"preferredDRX-ShortCycle","paragraph_zero_based":12066},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred short DRX cycle length for power saving. Value in ms. ms2 corresponds to 2ms, ms3 corresponds to 3 ms, ms4 corresponds to 4 ms, and so on. If the field is absent from the DRX-Preference IE, it is interpreted as the UE having no preference for the short DRX cycle.","paragraph_zero_based":12067},{"literal_text_all_w_t_and_m_t":"preferredDRX-ShortCycleTimer","paragraph_zero_based":12068},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred short DRX cycle timer for power saving. Value in multiples of preferredDRX-ShortCycle. A value of 1 corresponds to preferredDRX-ShortCycle, a value of 2 corresponds to 2 * preferredDRX-ShortCycle and so on. If the field is absent from the DRX-Preference IE, it is interpreted as the UE having no preference for the short DRX cycle timer. A preference for the short DRX cycle is indicated when a preference for the short DRX cycle timer is indicated.","paragraph_zero_based":12069},{"literal_text_all_w_t_and_m_t":"preferredK0","paragraph_zero_based":12070},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred value of k0 (slot offset between DCI and its scheduled PDSCH - see TS 38.214 [19], clause 5.1.2.1) for cross-slot scheduling for power saving. Value is defined for each subcarrier spacing (numerology) in units of slots. sl1 corresponds to 1 slot, sl2 corresponds to 2 slots, sl4 corresponds to 4 slots, and so on. If a value for a subcarrier spacing is absent, it is interpreted as the UE having no preference on k0 for cross-slot scheduling for that subcarrier spacing. If the field is absent from the MinSchedulingOffsetPreference IE, it is interpreted as the UE having no preference on k0 for cross-slot scheduling.","paragraph_zero_based":12071}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["86a5df61c6b02c22b890bd055e6593094b1c16e72fd8cb9fa61ac6bcf871bd23","6e510454ae033dc0c6cb02080faa10eba9fcf809ad2eb3321b3fa8a539329434","53e0ca665cb4d254a1658e8b7bf13542cc3159655d37be4d21728c1860a87b5e","df6f737f643adcf276614c500aa8d4431244febed5b031dc63a18a12aa464951","c35cff0ca0f4d400c5f4b740eca3682d3a14b1245db03f36987cbab7db0206fc","51bf53b07c62c25f7e0bc8e4becccb39072799e0232d80f7378111b5eeb5bcb1","29d881cfab965d28a05087c00077c9e08aa4758a5f61ea3537179e8a3806ed7a","aa5bcdd96f61f9f7be24a50370590fe6b54d1eacfb1ec60ef40977a4ac9220ee","0625e09abf8ba2167079e0ca0f09a3aca66bc267abc23fe6b1a9d07cbf215a1e","09d179afd27cba165e4b23fe5f1d91efa41728b12c57a73ab286d7522f5a2ef1","ceea405f472e8b47b58558d8e4f365ad3c65b307af99943df9cbc8a2e2db2e1e","12fe1e66710fc15274ab0cd77977a73e1cf352d0b26bb2957fa15280b60fa991","612d96c5867f285422ef722d821ed5ce8158326695f3fc15cfaefc70b0fcd7db","ef503193c3601f5bdb5483c4dd22d9213c5a4bf8f4ee634fd986821be69f7c08","5ba5dae7ecedee7d3cb2552d4a0d2b15b7d22bdd83c5c12fbe80d3d60cdf4868","98493da792ffabd9a79df04423220ff928be3b7f19b4272a198f75fe640349b5","9727e8e4ace21a8b9f33199297fdd84e8ddce57bfc54f20de201a5aff40a01c8","66538d3d6e7f0ff1f1efef0cbb02dc33b82c6de8dc2320bb07a809fe675a9de8","181e53aff264ed3a02f322bd0792db1d56978a81366240bb5468ecdbdf35bb09","0bd5dfe30c627217876c30cc55c82ea9850d833ffe5cbb7141fc6f47df7fff37","3b46b1ca844d9458803657129d108f5394e0b149148992995768fa797cbaf2f9","d6ff13e62e9267ecfa05d7026ede70f592a42815a5520e4818d11050f49fa2c8","dd4a4975a0f6ffe878db8633557fa53906c1293bbabfd54c0259c5b1bbc05b33","b8b8ff928af037020a98ad20570d71239de4bb602aa5cd98ad3ef66538efcae0"],"paragraph_range_zero_based":[12048,12071],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p12048"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"preferredK2","paragraph_zero_based":12072},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred value of k2 (slot offset between DCI and its scheduled PUSCH - see TS 38.214 [19], clause 6.1.2.1) for cross-slot scheduling for power saving. Value is defined for each subcarrier spacing (numerology) in units of slots. sl1 corresponds to 1 slot, sl2 corresponds to 2 slots, sl4 corresponds to 4 slots, and so on. If a value for a subcarrier spacing is absent, it is interpreted as the UE having no preference on k2 for cross-slot scheduling for that subcarrier spacing. If the field is absent from the MinSchedulingOffsetPreference IE, it is interpreted as the UE having no preference on k2 for cross-slot scheduling.","paragraph_zero_based":12073},{"literal_text_all_w_t_and_m_t":"preferredRRC-State","paragraph_zero_based":12074},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred RRC state. The value idle is indicated if the UE prefers to be released from RRC_CONNECTED and transition to RRC_IDLE. The value inactive is indicated if the UE prefers to be released from RRC_CONNECTED and transition to RRC_INACTIVE. The value connected is indicated if the UE prefers to revert an earlier indication to leave RRC_CONNECTED state. The value outOfConnected is indicated if the UE prefers to be released from RRC_CONNECTED and has no preferred RRC state to transition to. The value connected can only be indicated if the UE is configured with connectedReporting.","paragraph_zero_based":12075},{"literal_text_all_w_t_and_m_t":"propagationDelayDifference","paragraph_zero_based":12076},{"literal_text_all_w_t_and_m_t":"Indicates the one-way service link propagation delay difference between serving cell and each neighbour cell included in neighCellInfoList, defined as neighbour cell's service link propagation delay minus serving cell's service link propagation delay, in number of ms. First entry in propagationDelayDifference corresponds to first entry in neighCellInfoList, second entry in propagationDelayDifference corresponds to second entry in neighCellInfoList, and so on.","paragraph_zero_based":12077},{"literal_text_all_w_t_and_m_t":"reducedMaxBW-FR1","paragraph_zero_based":12078},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum aggregated bandwidth across all downlink carrier(s) and across all uplink carrier(s) of FR1, to address overheating or power saving. This field is allowed to be reported only when UE is configured with serving cell(s) operating on FR1. The aggregated bandwidth across all downlink carrier(s) of FR1 is the sum of bandwidth of active downlink BWP(s) across all activated downlink carrier(s) of FR1. The aggregated bandwidth across all uplink carrier(s) of FR1 is the sum of bandwidth of active uplink BWP(s) across all activated uplink carrier(s) of FR1. If the field is absent from the MaxBW-Preference IE or the OverheatingAssistance IE, it is interpreted as the UE having no preference on the maximum aggregated bandwidth of FR1.","paragraph_zero_based":12079},{"literal_text_all_w_t_and_m_t":"When indicated to address overheating, this maximum aggregated bandwidth includes carrier(s) of FR1 of both the NR MCG and the SCG. This maximum aggregated bandwidth only includes carriers of FR1 of the SCG in (NG)EN-DC. Value mhz0 is not used when indicated to address overheating.","paragraph_zero_based":12080},{"literal_text_all_w_t_and_m_t":"When indicated to address power saving, this maximum aggregated bandwidth includes carrier(s) of FR1 of the cell group that this UE assistance information is associated with. The aggregated bandwidth can only range up to the current active configuration when indicated to address power savings.","paragraph_zero_based":12081},{"literal_text_all_w_t_and_m_t":"reducedMaxBW-FR2","paragraph_zero_based":12082},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum aggregated bandwidth across all downlink carrier(s) and across all uplink carrier(s) of FR2-1, to address overheating or power saving. This field is allowed to be reported only when UE is configured with serving cell(s) operating on FR2-1. The aggregated bandwidth across all downlink carrier(s) of FR2-1 is the sum of bandwidth of active downlink BWP(s) across all activated downlink carrier(s) of FR2-1. The aggregated bandwidth across all uplink carrier(s) of FR2-1 is the sum of bandwidth of active uplink BWP(s) across all activated uplink carrier(s) of FR2-1. If the field is absent from the MaxBW-Preference IE or the OverheatingAssistance IE, it is interpreted as the UE having no preference on the maximum aggregated bandwidth of FR2-1.","paragraph_zero_based":12083},{"literal_text_all_w_t_and_m_t":"When indicated to address overheating, this maximum aggregated bandwidth includes carrier(s) of FR2-1 of both the NR MCG and the NR SCG. This maximum aggregated bandwidth only includes carriers of FR2-1 of the SCG in (NG)EN-DC.","paragraph_zero_based":12084},{"literal_text_all_w_t_and_m_t":"When indicated to address power saving, this maximum aggregated bandwidth includes carrier(s) of FR2-1 of the cell group that this UE assistance information is associated with. The aggregated bandwidth can only range up to the current active configuration when indicated to address power savings.","paragraph_zero_based":12085},{"literal_text_all_w_t_and_m_t":"reducedMaxBW-FR2-2","paragraph_zero_based":12086},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum aggregated bandwidth across all downlink carrier(s) and across all uplink carrier(s) of FR2-2, to address overheating or power saving. This field is allowed to be reported only when UE is configured with serving cell(s) operating on FR2-2. The aggregated bandwidth across all downlink carrier(s) of FR2-2 is the sum of bandwidth of active downlink BWP(s) across all activated downlink carrier(s) of FR2-2. The aggregated bandwidth across all uplink carrier(s) of FR2-2 is the sum of bandwidth of active uplink BWP(s) across all activated uplink carrier(s) of FR2-2. If the field is absent from the MaxBW-PreferenceFR2-2 IE or the OverheatingAssistance IE, it is interpreted as the UE having no preference on the maximum aggregated bandwidth of FR2-2.","paragraph_zero_based":12087},{"literal_text_all_w_t_and_m_t":"When indicated to address overheating, this maximum aggregated bandwidth includes carrier(s) of FR2-2 of both the NR MCG and the NR SCG. This maximum aggregated bandwidth only includes carriers of FR2-2 of the SCG in (NG)EN-DC.","paragraph_zero_based":12088},{"literal_text_all_w_t_and_m_t":"When indicated to address power saving, this maximum aggregated bandwidth includes carrier(s) of FR2-2 of the cell group that this UE assistance information is associated with. The aggregated bandwidth can only range up to the current active configuration when indicated to address power savings.","paragraph_zero_based":12089},{"literal_text_all_w_t_and_m_t":"reducedCCsDL","paragraph_zero_based":12090},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum number of downlink SCells indicated by the field, to address overheating or power saving.","paragraph_zero_based":12091},{"literal_text_all_w_t_and_m_t":"When indicated to address overheating, this maximum number includes both SCells of the NR MCG and PSCell/SCells of the SCG. This maximum number only includes PSCell/SCells of the SCG in (NG)EN-DC.","paragraph_zero_based":12092},{"literal_text_all_w_t_and_m_t":"When indicated to address power saving, this maximum number includes PSCell/SCells of the cell group that this UE assistance information is associated with. The maximum number of downlink SCells can only range up to the current active configuration when indicated to address power savings.","paragraph_zero_based":12093},{"literal_text_all_w_t_and_m_t":"reducedCCsUL","paragraph_zero_based":12094},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum number of uplink SCells indicated by the field, to address overheating or power saving.","paragraph_zero_based":12095}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["697ba6ab4b432bf0f115fdb0587fb7128a6455beae92371fc0b33786db6ab80a","b6ddab0f1fc865c9378b00d1a07d24a0681ddd9657f1fba260ab8e125d3dd93d","c3bf7518110fbb6dc69f737359b7db23f3d15ab41c05adad0e177e1fd131bd0d","4a9852568844bcc4254a78f0a11906e4bf0e7f85425a51fdd4a6bd503ec06b83","19f9e94bc514106823bded016c1430a31da1f0fedc50792ee59d4802453cce3d","ccbe68806b2055af6e40a8ac99faf385718c27c5c00f8cc650130f2f9afa0204","c5b3fe9e4cb7e356fcab9005db8209e6ed01b98bd93e6cb63d48b4361ea5a0a4","61550237db4b7e0e94cd995a8fab622e51d052e4cb0c72787c28f69940fd9c74","5164f0cb235c2aab9e65640d4da3a86aacc8e4749ee8f37196a8f4f32a59b339","17d56cbd56ceeee56a13006ab25fb34e9a053f3ae037e82c69c425f1e2e0ff34","1e3449d40383393a1defbe29be1ef43dc6f79269f8fbaa3f80fc67138929269e","c424b9d190918d274a56556155e4da3bec816a4bf670e55aad760d939530312b","a8dd8a2de6557df6071e78ec760e95b5a437f4554b4d6aa049b9c2f0cfb6afe3","51998da0d8a703bbc07686dc51e0b5ed9cc2d31fabc7fa3d6531db478623fcab","7d348a5c4d252fea0dd149cb1bce6357fb07e3e162e8b0b4994daca6df1c75d0","cf5a139651616798f6690f3ac9662ce1439ecb88d82986957a8cbde69c6f0a97","bd4a62b05c1503af8a721dbab8c4d56afb478d463f32c9f92bf81ec4198a2c45","12421e3952463bbda586348daeb04670416f4b68502390eea461a5f1a217d7df","4238d8db4ae905b66c2281adcca33423cac5eeaf90cbf97b0bb8466def585c69","866f09e5c41741b6b461baa0b547e386d8fc6ac488c73ed2513de359ffd681d0","939679bef61540d890ace61ba4e8633cc260d3942458c55aed7710478e145885","6275668cce21c119fb784c3fb85650bd9fce7dab06cf40a883ca2bddd0975e46","edc17c4c82e4eb1f139a16dc671e023e815157294c11ec036e67cb9fe0dfb90b","4013453f632d571722b9900ca19f98b614574f7d8d78c5b918cccc0b25ebad5a"],"paragraph_range_zero_based":[12072,12095],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p12072"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"When indicated to address overheating, this maximum number includes both SCells of the NR MCG and PSCell/SCells of the SCG. This maximum number only includes PSCell/SCells of the SCG in (NG)EN-DC.","paragraph_zero_based":12096},{"literal_text_all_w_t_and_m_t":"When indicated to address power saving, this maximum number includes PSCell/SCells of the cell group that this UE assistance information is associated with. The maximum number of uplink SCells can only range up to the current active configuration when indicated to address power savings.","paragraph_zero_based":12097},{"literal_text_all_w_t_and_m_t":"reducedMIMO-LayersFR1-DL","paragraph_zero_based":12098},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum number of downlink MIMO layers of each serving cell operating on FR1 indicated by the field, to address overheating or power saving. This field is allowed to be reported only when UE is configured with serving cells operating on FR1. The maximum number of downlink MIMO layers can only range up to the maximum number of MIMO layers configured across all activated downlink carrier(s) of FR1 in the cell group when indicated to address power savings.","paragraph_zero_based":12099},{"literal_text_all_w_t_and_m_t":"reducedMIMO-LayersFR1-UL","paragraph_zero_based":12100},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum number of uplink MIMO layers of each serving cell operating on FR1 indicated by the field, to address overheating or power saving (see NOTE 1). This field is allowed to be reported only when UE is configured with serving cells operating on FR1. The maximum number of uplink MIMO layers can only range up to the maximum number of MIMO layers configured across all activated uplink carrier(s) of FR1 in the cell group when indicated to address power savings.","paragraph_zero_based":12101},{"literal_text_all_w_t_and_m_t":"reducedMIMO-LayersFR2-DL","paragraph_zero_based":12102},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum number of downlink MIMO layers of each serving cell operating on FR2-1 indicated by the field, to address overheating or power saving. This field is allowed to be reported only when UE is configured with serving cells operating on FR2-1. The maximum number of downlink MIMO layers can only range up to the maximum number of MIMO layers configured across all activated downlink carrier(s) of FR2-1 in the cell group when indicated to address power savings.","paragraph_zero_based":12103},{"literal_text_all_w_t_and_m_t":"reducedMIMO-LayersFR2-UL","paragraph_zero_based":12104},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum number of uplink MIMO layers of each serving cell operating on FR2-1 indicated by the field, to address overheating or power saving (see NOTE 1). This field is allowed to be reported only when UE is configured with serving cells operating on FR2-1. The maximum number of uplink MIMO layers can only range up to the maximum number of MIMO layers configured across all activated uplink carrier(s) of FR2-1 in the cell group when indicated to address power savings.","paragraph_zero_based":12105},{"literal_text_all_w_t_and_m_t":"reducedMIMO-LayersFR2-2-DL","paragraph_zero_based":12106},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum number of downlink MIMO layers of each serving cell operating on FR2-2 indicated by the field, to address overheating or power saving. This field is allowed to be reported only when UE is configured with serving cells operating on FR2-2. The maximum number of downlink MIMO layers can only range up to the maximum number of MIMO layers configured across all activated downlink carrier(s) of FR2-2 in the cell group when indicated to address power savings.","paragraph_zero_based":12107},{"literal_text_all_w_t_and_m_t":"reducedMIMO-LayersFR2-2-UL","paragraph_zero_based":12108},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum number of uplink MIMO layers of each serving cell operating on FR2-2 indicated by the field, to address overheating or power saving (see NOTE 1). This field is allowed to be reported only when UE is configured with serving cells operating on FR2-2. The maximum number of uplink MIMO layers can only range up to the maximum number of MIMO layers configured across all activated uplink carrier(s) of FR2-2 in the cell group when indicated to address power savings.","paragraph_zero_based":12109},{"literal_text_all_w_t_and_m_t":"referenceTimeInfoPreference","paragraph_zero_based":12110},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE prefers being provisioned with the timing information specified in the IE ReferenceTimeInfo.","paragraph_zero_based":12111},{"literal_text_all_w_t_and_m_t":"resumeCause","paragraph_zero_based":12112},{"literal_text_all_w_t_and_m_t":"Provides the resume cause based on the information received from the upper layers.","paragraph_zero_based":12113},{"literal_text_all_w_t_and_m_t":"rlm-MeasRelaxationState","paragraph_zero_based":12114},{"literal_text_all_w_t_and_m_t":"Indicates the relaxation state of RLM measurements. Value true indicates that the UE is performing relaxation of RLM measurements, and value false indicates that the UE is not performing relaxation of RLM measurements.","paragraph_zero_based":12115},{"literal_text_all_w_t_and_m_t":"rrm-MeasRelaxationFulfilment","paragraph_zero_based":12116},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE fulfils the relaxed measurement criterion for stationary UE in 5.7.4.4. Value true indicates that the UE fulfils the criterion, and value false indicates that the UE does not fulfil the criterion.","paragraph_zero_based":12117},{"literal_text_all_w_t_and_m_t":"sl-QoS-FlowIdentity","paragraph_zero_based":12118},{"literal_text_all_w_t_and_m_t":"This identity uniquely identifies one sidelink QoS flow between the UE and the network in the scope of UE, which is unique for different destination and cast type.","paragraph_zero_based":12119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["e1cda8c2e61c39836ab8f9fbf50c4a4b4abe66a587d573b9e13b4b03772025a5","ef1d06473e8529e5bfd920cb5cbac9a49edf610284f07485ef0fd5e9c2c9bf6f","999890e0a715db715b62482b71820c9b56a316ecf3297c22e2575acb2c3fbba1","adf3dc4d311b19899d8ac4286679a94604e10e95e4d25ccefafd87d9e9fbfe6b","b0a817a5c8a642b588c6236880678263aa55e496c4c64bd76bb3826041994aa1","78d06dd2c5b92bd9b81ecdbc71744091f8ff09d48acc71b61d178b6fe212f94d","bc78bf722b4bf99f0bc760daf6794bcfd918d367866ed92e97b44173e526e4f6","864134c4ac99c6cd1c17ef5d1c2753a6399b10bf4a0b8962b460563469530afd","6e8af2d0641c7fc2f7db11fb4cf66a5a77b05ca1bbfb52d61c83ab0559b6aa36","cbbfd7a030983fa2eed860395e9b4e416fdfc02f290013eb7c9c309dffc97e3d","75d9d36b84aad110bf63e521e7a0cfcf3b8e971a3d861bb8ecde687d2802438c","a61d87f831c04cde9c45de69d5cc6e13633551443806e2a03650dfcb25b630ad","1be776e1f3f924f43b119cc64d5e9289d38a20c4424b9fdb55c4b998dd0c4c9a","07a2b1422aeedba9a390026da075e21a0dc6bcedb74121bfcf74b2d07f222ff0","3ff85ca4d6ed28b5bc5e3c913c4257e4ebe3d70b44c5ade74d3c94e5624423fe","a2f3cf4d78658109cae5e07e2772d4da7b068c156d41b2d385e66e879821ccee","8bcf3808571e5e357450cdfda97a867d8146b7cf2797b9bb6c13e06bf7e4fbcf","cb0655a884222f7b7b486280aa22b975dfe11442e32e4c985e8eaf1917d14896","80221693ba91f57fbe7c3305ffab85befd9bf7424d9c1df89bc24639aa7f7428","7037b21697d6d2c01664e19a06aab3e6543defb45acec2d5b3a636b96930c97a","989f684a7d8b0c5a25aaa87a602197728522bba1642eef3c04a57616535a4b72","bd77d6ca91e73e87f301839ea19520f37dee8acc3f74af47a1532ec3c1ed5563","00a0400d2d76cb2c205da490d756a767c3e2983553b7e60c975081dbde06c433","31cd14a773067751f444da04114834423a97673eff5be1ebab6c2fc1de844007"],"paragraph_range_zero_based":[12096,12119],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p12096"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-UE-AssistanceInformationNR","paragraph_zero_based":12120},{"literal_text_all_w_t_and_m_t":"Indicates the traffic characteristic of sidelink logical channel(s), specified in the IE SL-TrafficPatternInfo, that are setup for NR sidelink communication.","paragraph_zero_based":12121},{"literal_text_all_w_t_and_m_t":"type1","paragraph_zero_based":12122},{"literal_text_all_w_t_and_m_t":"Indicates the preferred amount of increment/decrement to the long DRX cycle length with respect to the current configuration. Value in number of milliseconds. Value ms40 corresponds to 40 milliseconds, msMinus40 corresponds to -40 milliseconds and so on.","paragraph_zero_based":12123},{"literal_text_all_w_t_and_m_t":"ul-GapFR2-PatternPreference","paragraph_zero_based":12124},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on FR2 UL gap pattern as defined in TS 38.133 [14].","paragraph_zero_based":12125},{"literal_text_all_w_t_and_m_t":"victimSystemType","paragraph_zero_based":12126},{"literal_text_all_w_t_and_m_t":"Indicate the list of victim system types to which IDC interference is caused from NR when configured with UL CA. Value gps, glonass, bds, galileo and navIC indicates the type of GNSS. Value wlan indicates WLAN and value bluetooth indicates Bluetooth.","paragraph_zero_based":12127},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12128},{"literal_text_all_w_t_and_m_t":"NOTE 1:The field may also indicate the UE's preference on reduced configuration corresponding to the maximum number of SRS ports (i.e. nrofSRS-Ports) of each serving cell operating on the associated frequency range.","paragraph_zero_based":12129},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12130},{"literal_text_all_w_t_and_m_t":"SL-TrafficPatternInfo field descriptions","paragraph_zero_based":12131},{"literal_text_all_w_t_and_m_t":"messageSize","paragraph_zero_based":12132},{"literal_text_all_w_t_and_m_t":"Indicates the maximum TB size based on the observed traffic pattern. The value refers to the index of TS 38.321 [3], table 6.1.3.1-2.","paragraph_zero_based":12133},{"literal_text_all_w_t_and_m_t":"timingOffset","paragraph_zero_based":12134},{"literal_text_all_w_t_and_m_t":"This field indicates the estimated timing for a packet arrival in a sidelink logical channel. Specifically, the value indicates the timing offset with respect to subframe#0 of SFN#0 in milliseconds.","paragraph_zero_based":12135},{"literal_text_all_w_t_and_m_t":"trafficPeriodicity","paragraph_zero_based":12136},{"literal_text_all_w_t_and_m_t":"This field indicates the estimated data arrival periodicity in a sidelink logical channel. Value ms20 corresponds to 20 ms, ms50 corresponds to 50 ms and so on.","paragraph_zero_based":12137},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12138},{"literal_text_all_w_t_and_m_t":"–UECapabilityEnquiry","paragraph_zero_based":12139},{"literal_text_all_w_t_and_m_t":"The UECapabilityEnquiry message is used to request UE radio access capabilities for NR as well as for other RATs.","paragraph_zero_based":12140},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1","paragraph_zero_based":12141},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":12142},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":12143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["cd8cd5effaa8d4d9e1c00bf39829a3f16604a42e1f6948143d2a2387740a6d61","736522566e54624450713f94f0a48c23b381964513718138116af92d20