{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Parameter \"Qrxlevminoffsetcell\" in TS 38.304 [20]. Actual value Qrxlevminoffsetcell = field value * 2 [dB].","paragraph_zero_based":13032},{"literal_text_all_w_t_and_m_t":"q-RxLevMinOffsetCellSUL","paragraph_zero_based":13033},{"literal_text_all_w_t_and_m_t":"Parameter \"QrxlevminoffsetcellSUL\" in TS 38.304 [20]. Actual value QrxlevminoffsetcellSUL = field value * 2 [dB].","paragraph_zero_based":13034},{"literal_text_all_w_t_and_m_t":"ssb-PositionQCL","paragraph_zero_based":13035},{"literal_text_all_w_t_and_m_t":"Indicates the QCL relation between SS/PBCH blocks for a specific intra-frequency neighbor cell as specified in TS 38.213 [13], clause 4.1. If provided, the cell specific value overwrites the value signalled by ssb-PositionQCL-Common in SIB2 for the indicated cell.","paragraph_zero_based":13036},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13037},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":13038},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":13039},{"literal_text_all_w_t_and_m_t":"SharedSpectrum2","paragraph_zero_based":13040},{"literal_text_all_w_t_and_m_t":"The field is optional present, Need R, if this intra-frequency or neighbor cell operates with shared spectrum channel access. Otherwise, it is absent, Need R.","paragraph_zero_based":13041},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13042},{"literal_text_all_w_t_and_m_t":"–SIB4","paragraph_zero_based":13043},{"literal_text_all_w_t_and_m_t":"SIB4 contains information relevant for inter-frequency cell re-selection (i.e. information about other NR frequencies and inter-frequency neighbouring cells relevant for cell re-selection), which can also be used for NR idle/inactive measurements. The IE includes cell re-selection parameters common for a frequency as well as cell specific re-selection parameters.","paragraph_zero_based":13044},{"literal_text_all_w_t_and_m_t":"SIB4 information element","paragraph_zero_based":13045},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":13046},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB4-START","paragraph_zero_based":13047},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13048},{"literal_text_all_w_t_and_m_t":"SIB4 ::=                            SEQUENCE {","paragraph_zero_based":13049},{"literal_text_all_w_t_and_m_t":"    interFreqCarrierFreqList            InterFreqCarrierFreqList,","paragraph_zero_based":13050},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension            OCTET STRING                                OPTIONAL,","paragraph_zero_based":13051},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":13052},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":13053},{"literal_text_all_w_t_and_m_t":"    interFreqCarrierFreqList-v1610      InterFreqCarrierFreqList-v1610              OPTIONAL   -- Need R","paragraph_zero_based":13054},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":13055}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["4a2c0c68456056018aed8d3993b1f6b53d4ac098de749e3db8416b06e3d3cb4f","d82017f331f4560e6752cd88298e5b29acefe81f21f70c98638f74f5cb9508bb","971d2a6d49d1803186c221428fab2fbb80bc55a72fc24ed44f4a230e820315b9","6f822a286969a25c550247dbb85828873e9e3d7537a9e0fbff22402f5ff89e87","f016719f250f23f130149786317271ee19e2a381f607ebd0028dff3da3799beb","5636ff440b8d8f40eff048d84dec6ed060c723f68a05a61293fc7c44261e1a54","6573a703c9f20dd78e2bf0ff6f9266b