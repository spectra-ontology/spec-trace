{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    rlc-Config-v1700                            RLC-Config-v1700                                    OPTIONAL,   -- Need R","paragraph_zero_based":26640},{"literal_text_all_w_t_and_m_t":"    logicalChannelIdentityExt-r17               LogicalChannelIdentityExt-r17                       OPTIONAL,   -- Cond LCH-SetupModMRB","paragraph_zero_based":26641},{"literal_text_all_w_t_and_m_t":"    multicastRLC-BearerConfig-r17               MulticastRLC-BearerConfig-r17                       OPTIONAL,   -- Cond LCH-SetupOnlyMRB","paragraph_zero_based":26642},{"literal_text_all_w_t_and_m_t":"    servedRadioBearerSRB4-r17                   SRB-Identity-v1700                                  OPTIONAL    -- Need N","paragraph_zero_based":26643},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":26644},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":26645},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26646},{"literal_text_all_w_t_and_m_t":"MulticastRLC-BearerConfig-r17 ::=           SEQUENCE {","paragraph_zero_based":26647},{"literal_text_all_w_t_and_m_t":"    servedMBS-RadioBearer-r17                   MRB-Identity-r17,","paragraph_zero_based":26648},{"literal_text_all_w_t_and_m_t":"    isPTM-Entity-r17                            ENUMERATED {true}                                   OPTIONAL    -- Need S","paragraph_zero_based":26649},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":26650},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26651},{"literal_text_all_w_t_and_m_t":"LogicalChannelIdentityExt-r17 ::=           INTEGER (320..65855)","paragraph_zero_based":26652},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26653},{"literal_text_all_w_t_and_m_t":"-- TAG-RLC-BEARERCONFIG-STOP","paragraph_zero_based":26654},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26655},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26656},{"literal_text_all_w_t_and_m_t":"RLC-BearerConfig field descriptions","paragraph_zero_based":26657},{"literal_text_all_w_t_and_m_t":"isPTM-Entity","paragraph_zero_based":26658},{"literal_text_all_w_t_and_m_t":"If configured, indicates that the RLC entity is used for PTM reception. When the field is absent the RLC entity is used for PTP transmission/reception.","paragraph_zero_based":26659},{"literal_text_all_w_t_and_m_t":"logicalChannelIdentity","paragraph_zero_based":26660},{"literal_text_all_w_t_and_m_t":"ID used commonly for the MAC logical channel and for the RLC bearer. Value 4 is not configured for DRBs if SRB4 is configured.","paragraph_zero_based":26661},{"literal_text_all_w_t_and_m_t":"logicalChannelIdentityExt","paragraph_zero_based":26662},{"literal_text_all_w_t_and_m_t":"Extended logical channel ID used commonly for the MAC logical channel and for the RLC bearer for PTM reception. If this field is configured, the UE shall ignore logicalChannelIdentity.","paragraph_zero_based":26663}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["6c9aea2bc20dc3cddc43cd47bdb208a786de56d84908acb4456c8f5f590ac45f","215ef2ff561636466eb8ff61a7c3cff0d44101dcd561acb63cbb5f8a20193e2d","cdf5f1addf529fc097e0ce58219935056a0d9a652dd805bbbbd9c3382bdd5433","b70afcc08583610d2f070a6bb0fb2e21983da1130e4174f35db2110cab413496","b635599acdf4085fc7554e2206e40720a445c4605e6d00442e023d188e9142ec","33865dad2d2788d31a3c8bb0e7210e50af036d6225c20d8d733ce426274d9548","a0a9792aa2291e2d4df66483b6f370663686f210478258e7ae1353df55349cd1","c0c5e15e638c5f069f1e764be0c3a25c0ee322674ae3db5117651418fb410b63","b6c1db7bd0af7175790065fd43d0fcffdb99dc8c1d70d9693c253b4e690a598d","7533ae8c5b17bd9111c971e6099d7dfceac46e274c6029eafb314471e093477b","aba3c801a9ddef4625d7286deec42b866a3f5b32fa7d5ffc7a4426248a9455a1","55f808dd568acce8a2e1895e9b36277c8f51c4d3903ec8e184ae4b8aac25fb8c","18cb9a5b8fd585e9dc7c9af7067debcb2054ebf109fefa926434d0800a1b065c","85668f2692b9736dccdad6f5b088a92bd44f8902e3354947d002475e6d2cc81e","30554d467454034afa550efb7987317ba836c07974a6318fb46b19ddcae5f475","f5439fbcc21e1363ad4dbfc9b8c1da6f77b20f6e818db1e1788e39326b715835","b3794fcf8020bc575b603296948a357b9ad2ea2d3620782e63a20324168aac74","9f386e17400073fe93be2671af4c424ac449b1d5cb1ad3f103a114a4bbf2c319","d16a35b4fda5d0ea4453fa05d6295001248b45864bc1ac912c394b641d758ddb","5796712be54c50572b53e836263eacaa2fed6f4dc9677259cc667d762670c23b","7e0fbc88fba02e8fc660f8b16c71ca334e94a8b0b50f8125a4616fbcbc032762","ce1f861a122364745bfab39b402ca8b2e9ad958421e9004f2db4a85593405c7b","4c1a438c09df2bbeb945ce45bb33217e793cf646ef7eec565ff926052206825b","8d19e66f21d0a507a22a65bc8416003fce304da883292328d5ff7b978a97b0c8"],"paragraph_range_zero_based":[26640,26663],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p26640"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"reestablishRLC","paragraph_zero_based":26664},{"literal_text_all_w_t_and_m_t":"Indicates that RLC should be re-established. Network sets this to true at least whenever the security key used for the radio bearer associated with this RLC entity changes. For SRB2, multicast MRBs and DRBs, unless full configuration is used, it is also set to true during the resumption of the RRC connection or the first reconfiguration after reestablishment. For SRB1, when resuming an RRC connection, or at the first reconfiguration after RRC connection reestablishment, the network does not set this field to true.","paragraph_zero_based":26665},{"literal_text_all_w_t_and_m_t":"rlc-Config","paragraph_zero_based":26666},{"literal_text_all_w_t_and_m_t":"Determines the RLC mode (UM, AM) and provides corresponding parameters. RLC mode reconfiguration can only be performed by DRB/multicast MRB release/addition or full configuration. The network may configure rlc-Config-v1610 only when rlc-Config (without suffix) is set to am.","paragraph_zero_based":26667},{"literal_text_all_w_t_and_m_t":"servedMBS-RadioBearer","paragraph_zero_based":26668},{"literal_text_all_w_t_and_m_t":"Associates the RLC Bearer with a multicast MRB. The UE shall deliver DL RLC SDUs received via the RLC entity of this RLC bearer to the PDCP entity of the servedMBS-RadioBearer.","paragraph_zero_based":26669},{"literal_text_all_w_t_and_m_t":"servedRadioBearer, servedRadioBearerSRB4","paragraph_zero_based":26670},{"literal_text_all_w_t_and_m_t":"Associates the RLC Bearer with an SRB or a DRB. The UE shall deliver DL RLC SDUs received via the RLC entity of this RLC bearer to the PDCP entity of the servedRadioBearer. Furthermore, the UE shall advertise and deliver uplink PDCP PDUs of the uplink PDCP entity of the servedRadioBearer to the uplink RLC entity of this RLC bearer unless the uplink scheduling restrictions (moreThanOneRLC in PDCP-Config and the restrictions in LogicalChannelConfig) forbid it to do so.","paragraph_zero_based":26671},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26672},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":26673},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":26674},{"literal_text_all_w_t_and_m_t":"LCH-Setup","paragraph_zero_based":26675},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new logical channel for a DRB or a multicast MRB or SRB4. This field is optionally present, Need S, upon creation of a new logical channel for an SRB except SRB4. It is optionally present, Need M, otherwise.","paragraph_zero_based":26676},{"literal_text_all_w_t_and_m_t":"LCH-SetupModMRB","paragraph_zero_based":26677},{"literal_text_all_w_t_and_m_t":"This field is optionally present upon creation of a new logical channel for PTM reception for a multicast MRB. If this field is included upon creation of a new logical channel for PTM reception for a multicast MRB, it shall be present when modifying this logical channel. The field is absent for logical channels configured for an SRB and a DRB.","paragraph_zero_based":26678},{"literal_text_all_w_t_and_m_t":"LCH-SetupOnly","paragraph_zero_based":26679},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new logical channel for a DRB or an SRB (servedRadioBearer). It is absent, Need M otherwise.","paragraph_zero_based":26680},{"literal_text_all_w_t_and_m_t":"LCH-SetupOnlyMRB","paragraph_zero_based":26681},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new logical channel for a multicast MRB and upon modification of MRB-Identity of the served MRB. It is absent, Need M otherwise.","paragraph_zero_based":26682},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26683},{"literal_text_all_w_t_and_m_t":"–RLC-Config","paragraph_zero_based":26684},{"literal_text_all_w_t_and_m_t":"The IE RLC-Config is used to specify the RLC configuration of SRBs, multicast MRBs and DRBs.","paragraph_zero_based":26685},{"literal_text_all_w_t_and_m_t":"RLC-Config information element","paragraph_zero_based":26686},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26687}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["91fb354abb258bef35df2f485dc22696212ccf4afaa16b020dfce0122d881a2e","407f2b42db1dbd873f15b570d1b81c47162e59ff09179bcffcda28cd926624fb","546e88a481818227087bf0b3498ed4c2cf62d61afec32c7f1f5c3f934912094d","0f9c178b2fbaff4429b4db3c7a77d6c4f00dc7d400f2c66cdc3e556131fa7187","010a560c837c9e27108fb845fc6c3b4648e9eb15dd89b2991eb5311e7d011038","17b2ebc782a9d30c026e73f48e57f9e48493ce0a81a79b7a5ddfdff51d0d9fa5","66228b7789957012cc4dd16c67875a89e2289e97dbbe12130ba508a2f8ff1285","ccf9a0a17587518aaa542b652974c7ea76bd18b097ad4b996202e891d5232f80","66fc65371552abd4175424268b783385c824dcaa36f0be50e5f025498c9570d1","84d4ac1e3b2875b68f41bfa6af34db7d880d7b9d20d7f2ec909b24fb00829459","9db35488175c7b147b695db6cb668d4b381bb273baba9f611402aec948fd680b","0e9fd67181f3665d5bfeeb58ac05b601d573cf386b19e972b8d2d11ab78ca659","8b4f72b35f0633691670a400f99dbe4e77d141667502b25ff73c817a6c1effc4","c30a4a7f80c5da92740336573b4e08bbce143b275ad9e22612d04244bc162153","c2c0dbebd955d1a0279cc39778e633e93419141b7c6bc745306b2a37dadacc93","f2448bb9b06b3dbd05e0ec530a5d317f7c3ff69e505391e905a3606775042419","1dfb1b7cf7c7592ff70d82063c97b8c550967b13d80e6c605e8a562be51a81a4","7490d3805a77abfe8e95e09cf455050814885575b0aa874ec52248aa01e1f1d6","4f021b28688679e58baa732ffad68b7d21d9a76d