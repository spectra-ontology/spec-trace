{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27192},{"literal_text_all_w_t_and_m_t":"–ServingCellAndBWP-Id","paragraph_zero_based":27193},{"literal_text_all_w_t_and_m_t":"The IE ServingCellAndBWP-Id is used to indicate a serving cell and an uplink or a downlink BWP.","paragraph_zero_based":27194},{"literal_text_all_w_t_and_m_t":"ServingCellAndBWP-Id information element","paragraph_zero_based":27195},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27196},{"literal_text_all_w_t_and_m_t":"-- TAG-SERVINGCELLANDBWP-ID-START","paragraph_zero_based":27197},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27198},{"literal_text_all_w_t_and_m_t":"ServingCellAndBWP-Id-r17 ::= SEQUENCE {","paragraph_zero_based":27199},{"literal_text_all_w_t_and_m_t":"    servingcell-r17              ServCellIndex,","paragraph_zero_based":27200},{"literal_text_all_w_t_and_m_t":"    bwp-r17                      BWP-Id","paragraph_zero_based":27201},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27202},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27203},{"literal_text_all_w_t_and_m_t":"-- TAG-SERVINGCELLANDBWP-ID-STOP","paragraph_zero_based":27204},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27205},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27206},{"literal_text_all_w_t_and_m_t":"–ServCellIndex","paragraph_zero_based":27207},{"literal_text_all_w_t_and_m_t":"The IE ServCellIndex concerns a short identity, used to uniquely identify a serving cell (i.e. the PCell, the PSCell or an SCell) across the cell groups. Value 0 applies for the PCell, while the SCellIndex that has previously been assigned applies for SCells.","paragraph_zero_based":27208},{"literal_text_all_w_t_and_m_t":"ServCellIndex information element","paragraph_zero_based":27209},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27210},{"literal_text_all_w_t_and_m_t":"-- TAG-SERVCELLINDEX-START","paragraph_zero_based":27211},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27212},{"literal_text_all_w_t_and_m_t":"ServCellIndex ::=                   INTEGER (0..maxNrofServingCells-1)","paragraph_zero_based":27213},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27214},{"literal_text_all_w_t_and_m_t":"-- TAG-SERVCELLINDEX-STOP","paragraph_zero_based":27215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["11f981101cbd6d06a1ed456ac134f59a105f7fd049a7fa0fec72e910f79b5564","5152dc2d60030e3c6814a0e09d5eb75641dd0035c0393591adb4afacb14d64de","953139f6f983b5646b12bd92ae72dd4efc6f01129deece1d69edf60499dd8f80","5e9eb964d06fea288369c6e9a270ece0e91935232154898fe47e565d59bc3b49","ab163a2dff7bc7003d9537657f028e7203126ad1713a0c3075fda057d282d3c8","7c18ccd00007d62f29b7e9eb76540f4758348b0eaceb77a8ac2f49d2b5e4cdee","da5a945ff9ae6ca6903514500034491bb5c583641440a5f2fb3f53b445745ec9","4f69342ae915a1dc1e6b8a54ce6befdde6181fabec2c92688168ce9464ed7287","a8e0c37b66d11e209a5496804fca5fefd990e8bbe4f96a6b23a96cda58877bc8","ebdd0f39ab640e2f7895807dd28366c75e586c9c996d364699a16e5215ce31b8","30c97862e1092167e9d0157c8e9d01fbc4b6d566aaa84162964f5e99f3a86285","bceb75a138887596435c7cc89e1900c3bfe18c71c49578c5496cdb4a7d02eca6","4d2bf1d4c2a6925f57e4963485b052fd73b56234e5a09311451e71960f63df19","93647f9be96e30765c91f99251a4c7919f2508e1acc6239b307d2179313ab46c","8bc9e7b512221b0a1d52eac3e225279b0ca11bcdbdd5d43d065b3469374077df","11b61e06706dc32feaca3d3b67368c63fc0fc220eb3b78d065abc42d21b7323a","67f1b30ec72d2d20f6f8641f60a5958e24