{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29040},{"literal_text_all_w_t_and_m_t":"-- TAG-SSB-MTC-STOP","paragraph_zero_based":29041},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29042},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29043},{"literal_text_all_w_t_and_m_t":"SSB-MTC field descriptions","paragraph_zero_based":29044},{"literal_text_all_w_t_and_m_t":"duration","paragraph_zero_based":29045},{"literal_text_all_w_t_and_m_t":"Duration of the measurement window in which to receive SS/PBCH blocks. It is given in number of subframes (see TS 38.213 [13], clause 4.1).","paragraph_zero_based":29046},{"literal_text_all_w_t_and_m_t":"periodicityAndOffset","paragraph_zero_based":29047},{"literal_text_all_w_t_and_m_t":"Periodicity and offset of the measurement window in which to receive SS/PBCH blocks, see 5.5.2.10. Periodicity and offset are given in number of subframes.","paragraph_zero_based":29048},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29049},{"literal_text_all_w_t_and_m_t":"SSB-MTC2 field descriptions","paragraph_zero_based":29050},{"literal_text_all_w_t_and_m_t":"pci-List","paragraph_zero_based":29051},{"literal_text_all_w_t_and_m_t":"PCIs that follow this SMTC.","paragraph_zero_based":29052},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29053},{"literal_text_all_w_t_and_m_t":"SSB-MTC3 field descriptions","paragraph_zero_based":29054},{"literal_text_all_w_t_and_m_t":"duration","paragraph_zero_based":29055},{"literal_text_all_w_t_and_m_t":"Duration of the measurement window in which to receive SS/PBCH blocks. It is given in number of subframes (see TS 38.213 [13], clause 4.1).","paragraph_zero_based":29056},{"literal_text_all_w_t_and_m_t":"pci-List","paragraph_zero_based":29057},{"literal_text_all_w_t_and_m_t":"PCIs that follow this SMTC, used for IAB-node discovery.","paragraph_zero_based":29058},{"literal_text_all_w_t_and_m_t":"periodicityAndOffset","paragraph_zero_based":29059},{"literal_text_all_w_t_and_m_t":"Periodicity and offset of the measurement window in which to receive SS/PBCH blocks, see 5.5.2.10. Periodicity and offset are given in number of subframes.","paragraph_zero_based":29060},{"literal_text_all_w_t_and_m_t":"ssb-ToMeasure","paragraph_zero_based":29061},{"literal_text_all_w_t_and_m_t":"The set of SS blocks to be measured within the SMTC measurement duration. The first/leftmost bit corresponds to SS block index 0, the second bit corresponds to SS block index 1, and so on. Value 0 in the bitmap indicates that the corresponding SS block is not to be measured while value 1 indicates that the corresponding SS block is to be measured (see TS 38.215 [9]). When the field is not configured the IAB-MT measures on all SS blocks. Regardless of the value of this field, SS blocks outside of the applicable smtc are not to be measured. See TS 38.215 [9] clause 5.1.1.","paragraph_zero_based":29062},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29063}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["8c3a672dd1b131e83b8c74993a3458a7584f4e7f1e8d0a3c792b36644e303235","1927d08eaa7b928be7bcf1829b3c7f81c63c54c4b60dc021e337ba4e9c0bb667","dfa287610106d5d8b3777c0a894c374be4ffd82af05c9976837884d7930fd9f5","c13c978d531220ded3a0ee00e53d4fc8e26d904f763b240943e01737d2adc199","21664132f015d810594df479addf9726f755a4feb5977d1d0830f3b132a826ae","c26bf3c683d438649d1ab32045a921cd4e3f06a02b6af900b537b7793707615b","9d733c6552859d46b7d370fa3645c56a69c5b850db8feef75a9239be65a64096","5c9fe3cebf924e2a99871cfdec6879cbe2fff9dfa5cfa3970c09aba464e1374b","edd56acc85f623533261ab59b5611e0758f975f054fcff96e1a259e163995252","85b3489da7b0ecc1d223c1bee4607e124b3060d0c331f2738141f54439d00405","78d3fcc0526b065b3ba4c8b49ee53fb5ec8e928fb9ad0fe059bc96c716d23ab1","c4f8e93146b8f03d9c7df3bd66cc8452e511bfe9a6b8d886860d43a5891a9915","91b3cdb967015a44f69ed56552be576264158ff034fbba8d290ad8e384646596","d237895c7ad3f112591c645ce458f0782e61473251f0bf1856bcaf743c113926","f7d932503e1e6af4355911a315feb23d5a909c175f1437643f53b314141862b3","14dd19d5951d3ed089c8c286cd82b8d28edd72b3aae493192b32ecce3fca93f3","0d595ee565aff1fbb5b7c8c1da47bb670527f5d252f610ffe5e4ccba6711eb5c","38a31e17120c1c855e79177482e804cd081c74e82015e322fe8030f915749464","b7b504447385aabc147e24208c61ba4aad094dcbf090b6cd3fd4d784c96a8114","3f349da400469ebb5d6cd14829584f554ff8e5ab0ccfb6e42d1d2317723f4c50","2fb1e599c4f774c5dd7a492d1db1a82d65c1b4bec4be16fa3c6b060c44f19489","9f9f951ec15b9d09c64b5f915d6d3cc8893f56601a7a1c43e757bd3d0b44db00","0f3ffc9a9fc37e6e0c569de4cdec800465bbed2288d4a060a53cdf408f8d36aa","c4794142345d3e3aa13f71da04a5c828a3a20f2d066ad80d27e15278409c5a11"],"paragraph_range_zero_based":[29040,29063],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p29040"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SSB-MTC4 field descriptions","paragraph_zero_based":29064},{"literal_text_all_w_t_and_m_t":"pci-List","paragraph_zero_based":29065},{"literal_text_all_w_t_and_m_t":"PCIs that follow this SMTC.","paragraph_zero_based":29066},{"literal_text_all_w_t_and_m_t":"offset","paragraph_zero_based":29067},{"literal_text_all_w_t_and_m_t":"Offset of the measurement window in which to receive SS/PBCH blocks, see 5.5.2.10. Offset is given in number of subframes.","paragraph_zero_based":29068},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29069},{"literal_text_all_w_t_and_m_t":"SSB-MTC-AdditionalPCI field descriptions","paragraph_zero_based":29070},{"literal_text_all_w_t_and_m_t":"additionalPCI","paragraph_zero_based":29071},{"literal_text_all_w_t_and_m_t":"PCI of the additional SSB different from serving cell PCI.","paragraph_zero_based":29072},{"literal_text_all_w_t_and_m_t":"periodicity","paragraph_zero_based":29073},{"literal_text_all_w_t_and_m_t":"Periodicity of the SS/PBCH blocks, see 5.5.2.10. Periodicity is given in number of subframes.","paragraph_zero_based":29074},{"literal_text_all_w_t_and_m_t":"ssb-PositionsInBurst","paragraph_zero_based":29075},{"literal_text_all_w_t_and_m_t":"Indicates the time domain positions of the transmitted SS-blocks in a half frame with SS/PBCH blocks as defined in TS 38.213 [13], clause 4.1. The first/leftmost bit corresponds to SS/PBCH block index 0, the second bit corresponds to SS/PBCH block index 1, and so on. Value 0 in the bitmap indicates that the corresponding SS/PBCH block is not transmitted while value 1 indicates that the corresponding SS/PBCH block is transmitted.","paragraph_zero_based":29076},{"literal_text_all_w_t_and_m_t":"ss-PBCH-BlockPower","paragraph_zero_based":29077},{"literal_text_all_w_t_and_m_t":"Average EPRE of the resources elements that carry secondary synchronization signals in dBm that the NW used for SSB transmission, see TS 38.213 [13], clause 7.","paragraph_zero_based":29078},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29079},{"literal_text_all_w_t_and_m_t":"–SSB-PositionQCL-Relation","paragraph_zero_based":29080},{"literal_text_all_w_t_and_m_t":"The IE SSB-PositionQCL-Relation is used to indicate the QCL relationship between SSB positions on the frequency indicated by ssbFrequency (see TS 38.213 [13], clause 4.1) for operation with shared spectrum channel access. Value n1 corresponds to 1, value n2 corresponds to 2 and so on.","paragraph_zero_based":29081},{"literal_text_all_w_t_and_m_t":"SSB-PositionQCL-Relation information element","paragraph_zero_based":29082},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29083},{"literal_text_all_w_t_and_m_t":"-- TAG-SSB-POSITIONQCL-RELATION-START","paragraph_zero_based":29084},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29085},{"literal_text_all_w_t_and_m_t":"SSB-PositionQCL-Relation-r16 ::=  ENUMERATED {n1,n2,n4,n8}","paragraph_zero_based":29086},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29087}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["28b44537d6078ac842d3571ffca0c4fd1c2d0f14d3209d5d7670f2a958f7495f","4569ef8c162630d99f371d7fda14d9446ba4502b758aed5bbd0c231c9da92b15","7083469ee2d7f278694f46c8f9fe626774cb6d2a01cf7e87c3a2c034dc2fdb50","83445671d3dda9aab0a33d5ec590ade201621621a98d554a4d66dde5d5d829cb","24d853c480ae6b2be805da342b05d20effbe72a1b1d7a0168f4443ec83e712cf","e49e65dbb1e74e1c27754356b40b7a9f334a04d528453063afe8b3691262ac2b","72f8ee7875b7b94bba