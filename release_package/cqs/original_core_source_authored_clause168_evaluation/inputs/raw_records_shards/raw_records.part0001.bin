{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15384},{"literal_text_all_w_t_and_m_t":"-- TAG-CANDIDATEBEAMRS-STOP","paragraph_zero_based":15385},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":15386},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15387},{"literal_text_all_w_t_and_m_t":"CandidateBeamRS field descriptions","paragraph_zero_based":15388},{"literal_text_all_w_t_and_m_t":"candidateBeamConfig","paragraph_zero_based":15389},{"literal_text_all_w_t_and_m_t":"Indicates the resource (i.e. SSB or CSI-RS) defining this beam resource.","paragraph_zero_based":15390},{"literal_text_all_w_t_and_m_t":"servingCellId","paragraph_zero_based":15391},{"literal_text_all_w_t_and_m_t":"If the field is absent, the RS belongs to the serving cell in which BeamFailureRecoveryRSConfig is configured.","paragraph_zero_based":15392},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15393},{"literal_text_all_w_t_and_m_t":"–CellAccessRelatedInfo","paragraph_zero_based":15394},{"literal_text_all_w_t_and_m_t":"The IE CellAccessRelatedInfo indicates cell access related information for this cell.","paragraph_zero_based":15395},{"literal_text_all_w_t_and_m_t":"CellAccessRelatedInfo information element","paragraph_zero_based":15396},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":15397},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLACCESSRELATEDINFO-START","paragraph_zero_based":15398},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15399},{"literal_text_all_w_t_and_m_t":"CellAccessRelatedInfo   ::=         SEQUENCE {","paragraph_zero_based":15400},{"literal_text_all_w_t_and_m_t":"    plmn-IdentityInfoList               PLMN-IdentityInfoList,","paragraph_zero_based":15401},{"literal_text_all_w_t_and_m_t":"    cellReservedForOtherUse             ENUMERATED {true}             OPTIONAL,   -- Need R","paragraph_zero_based":15402},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":15403},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":15404},{"literal_text_all_w_t_and_m_t":"    cellReservedForFutureUse-r16        ENUMERATED {true}             OPTIONAL,   -- Need R","paragraph_zero_based":15405},{"literal_text_all_w_t_and_m_t":"    npn-IdentityInfoList-r16            NPN-IdentityInfoList-r16      OPTIONAL    -- Need R","paragraph_zero_based":15406},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":15407}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["21cab2130b070b0f3a1498fb1fd0dec8a1b870bac459810e20079ea58a9b84ff","b90b1962c40a4ab736aa1098be08f900ef82c6f0a4f73e830f557a9eee88e562","1a1f1858b7816d824936c2f911a5811a6ac4775550569d399cce35094c2ec144","86723df010fd294df5554b7099490d7986ad720a241e65298c78ad157a7702de","901f04ad4e6a409daf2bbb9f5b2995bcd539a7edd1bf6da9841c92747db5be45","70f71ac74770309216321cd2932fbe1997bc5c5ea6769fab1266eab4c3b0db20","42e1a745f6c3936a6c86ef30ee0db5bd4c9e3f922444ba2e9a0955b6871c6b3d","baa3a36556857deae4944089ba38fbb03df0fd63478658d357081cd7b1c9e45f","eb8daf6121b315244b5476d966bc4bf0603bb15366881c2bc63d6c0a90e151d2","8c6b84ec38c4e9568f710bcca336455cadf197118ba8f6ba1c51b84bc6dc7200","22d66e204dda48c27ad805973978bc5bea02204195243c43d0ee9a7a88e3ac54","fdb489776d0143e2bcd4e821249aca656a8e472d4b6e1a436c50c610f896b51a","a335949d44468ba44810b713ac6b69635cdd583463c2b80b9c37e0b45a1e4b0d","f6e7f763d9d986a1bcf89f5a43816bc1d2337b5a62821710c22d802508db9eeb","9c55ef22de00255f9fffe4e3de36a3fade5288e431f1b900622d26a9d1c2e0ee","20f74337e84ba6a686faab669716cfbfeb64f5c7d9d3cd9766526ff465f86635","0cd86eb20d32a509fe445579d02aff4183c36a95b8faf0c1a8c7eb72cd8df2eb","777802e545d72e8963a23daa00016635bcdf9def65bf0831a7d69a3aaeb3852f","670c3862ad0a3b7c8a37463282f429ddbb97c0a79039a143a23e8ee6ca9c51c1","5588d4b0a9a54e7e6164fa0272d833fb5e3c839cae54040861ed6698cc9cc5af","85fc1fc21d0b03d9efa2808f6c214174a13b8fe05481594f36c719b2ad4568b7","e5f29c122a56291021929f1abecee59f6c116b41f08a61a458774fb98468de27","69d516fdc25bbef87689f2ceb3c54c586e0aafe0c4a1b81fd31571cf81c66fb7","9c3a0aa74526484c9594290789988d28abfa919ce3ec1c83edfb6a9e8d6af92d"],"paragraph_range_zero_based":[15384,15407],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p15384"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":15408},{"literal_text_all_w_t_and_m_t":"    snpn-AccessInfoList-r17             SEQUENCE (SIZE (1..maxNPN-r16)) OF SNPN-AccessInfo-r17    OPTIONAL    -- Need R","paragraph_zero_based":15409},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":15410},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":15411},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15412},{"literal_text_all_w_t_and_m_t":"SNPN-AccessInfo-r17 ::=         SEQUENCE {","paragraph_zero_based":15413},{"literal_text_all_w_t_and_m_t":"    extCH-Supported-r17                 ENUMERATED {true}             OPTIONAL,   -- Need R","paragraph_zero_based":15414},{"literal_text_all_w_t_and_m_t":"    extCH-WithoutConfigAllowed-r17      ENUMERATED {true}             OPTIONAL,   -- Need R","paragraph_zero_based":15415},{"literal_text_all_w_t_and_m_t":"    onboardingEnabled-r17               ENUMERATED {true}             OPTIONAL,   -- Need R","paragraph_zero_based":15416},{"literal_text_all_w_t_and_m_t":"    imsEmergencySupportForSNPN-r17      ENUMERATED {true}             OPTIONAL    -- Need R","paragraph_zero_based":15417},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":15418},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15419},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLACCESSRELATEDINFO-STOP","paragraph_zero_based":15420},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":15421},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15422},{"literal_text_all_w_t_and_m_t":"CellAccessRelatedInfo field descriptions","paragraph_zero_based":15423},{"literal_text_all_w_t_and_m_t":"cellReservedForFutureUse","paragraph_zero_based":15424},{"literal_text_all_w_t_and_m_t":"Indicates whether the cell is reserved, as defined in 38.304 [20] for future use. The field is applicable to all PLMNs and NPNs. This field is ignored by IAB-MT.","paragraph_zero_based":15425},{"literal_text_all_w_t_and_m_t":"cellReservedForOtherUse","paragraph_zero_based":15426},{"literal_text_all_w_t_and_m_t":"Indicates whether the cell is reserved, as defined in 38.304 [20]. The field is applicable to all PLMNs. This field is ignored by IAB-MT for cell barring determination, but still considered by NPN capable IAB-MT for determination of an NPN-only cell.","paragraph_zero_based":15427},{"literal_text_all_w_t_and_m_t":"npn-IdentityInfoList","paragraph_zero_based":15428},{"literal_text_all_w_t_and_m_t":"The npn-IdentityInfoList is used to configure a set of NPN-IdentityInfo elements. Each of those elements contains a list of one or more NPN Identities and additional information associated with those NPNs. The total number of PLMNs (identified by a PLMN identity in plmn -IdentityList), PNI-NPNs (identified by a PLMN identity and a CAG-ID), and SNPNs (identified by a PLMN identity and a NID) together in the PLMN-IdentityInfoList and NPN-IdentityInfoList does not exceed 12, except for the NPN-only cells. A PNI-NPN and SNPN can be included only once, and in only one entry of the NPN-IdentityInfoList. In case of NPN-only cells the PLMN-IdentityList contains a single element that does not count to the limit of 12 and the cellIdentity of the first entry of the PLMN-IdentityInfoList is set to the same value as the cellIdentity-r16 of the first entry of the NPN-IdentityInfoList. The NPN index is defined as B+c1+c2+…+c(n-1)+d1+d2+…+d(m-1)+e(i) for the NPN identity included in the n-th entry of NPN-IdentityInfoList and in the m-th entry of npn-Identitylist within that NPN-IdentityInfoList entry, and the i-th entry of its corresponding NPN-Identity, where","paragraph_zero_based":15429},{"literal_text_all_w_t_and_m_t":"- B is the index used for the last PLMN in the PLMN-IdentittyInfoList; in NPN-only cells B is considered 0;","paragraph_zero_based":15430},{"literal_text_all_w_t_and_m_t":"- c(j) is the number of NPN index values used in the j-th NPN-IdentityInfoList entry;","paragraph_zero_based":15431}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["122cf3f9a8729e0047d9a3aaa3b7717a026305e09b4bb454b5cb884bf687db6c","072c0870564fb1e5479a565b9720c23e6734fd990bc1e5c9d03f4594c8fd080a","9a2213a0f5de7c9978a0670ca7bc948bb6c7e864e7f1b7789a5be27dbbad5d77","6f52c051517c9f1dc9a4af04e666522d0916e5a4bbe1834784a2c0b2fc8a3517","8c4a0cdfff1725c5640b12f6174c6d5216886474b9552280aa7ad8aa397865b5","5a83cc596cfd9a0aed90777e073016a810fd1b9b9006416f40a519c2f6f31006","fe9f07da7769304e119caa537328291a2901d42bc97e33b5ccc5e28288cf6b2b","952d95ed51c8da3b04dcf583dc3028d84e8275efb0922ea3e77ad343cbaf8bfb","b833718c99d411355d7fc30d2752eb2db86f90d62f95ab1eee0b8516adb26667","e71440dae6b547da6055d0aa9e33e62b260694af461267864ed37abe4c4a7bd2","0b30ffdcca9603cd5ad4abfd9d3c6887b778816160309c9126b66729269615b7","c2f530652eec17a9cd956465c99f618fc7f92a36f121561c18dad5a81faa501f","0b1c4e8181e8607bfaf6ce03f8ffabe10eb498446c06570ef647eea97d413ebe","bacc73b1192add4668c7b39d1e84597ede59f1b014e2187a0adb7db601a68c68","d49784ebbed72fc56117aade07c6334647b009f02f4ee2a607a8a4c200b3b612","516da5417a169a6d32f9e618f4e8f37f443236eef2891942b9adefb093f0e82f","6bc451ab227e90c54c29c211b14c3ebd892c29c837bc02f3276b05a9796cf350","212c881f1d3b3bbf05729311e6fd90e7bae62df6d1e53d7680d4b7d21370b03c","6665e96a87c48de1475dffc7f1ef48c720ba6f685e43748f479e6911e3a0ae07","52dcdcabbc3f3f5d64df9ec9600aed2616585a21a22e942e307ecfc69b9554df","9946572277aa746830048bd1d79d191765dbf6d42b41ebf1e835f39234918a32","d085e19b2e4ff07431bddc3250a7b2098e2a26c52ad20b4a4f0652f2b928a927","2311776858890e7712d9ed12dcc35c90a67957cf4eeec035feb30a64c54e42c1","e80c4b7270b1761d03e18e0b74ec27e8f72a5b305178c73e64e91b2f51ace329"],"paragraph_range_zero_based":[15408,15431],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p15408"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"- d(k) is the number of NPN index values used in the k-th npn-IdentityList entry within the n-th NPN-IdentityInfoList entry;","paragraph_zero_based":15432},{"literal_text_all_w_t_and_m_t":"- e(i) is","paragraph_zero_based":15433},{"literal_text_all_w_t_and_m_t":"    - i if the n-th entry of NPN-IdentityInfoList entry is for SNPN(s);","paragraph_zero_based":15434},{"literal_text_all_w_t_and_m_t":"    - 1 if the n-th entry of NPN-IdentityInfoList entry is for PNI-NPN(s).","paragraph_zero_based":15435},{"literal_text_all_w_t_and_m_t":"plmn-IdentityInfoList","paragraph_zero_based":15436},{"literal_text_all_w_t_and_m_t":"The plmn-IdentityInfoList is used to configure a set of PLMN-IdentityInfo elements. Each of those elements contains a list of one or more PLMN Identities and additional information associated with those PLMNs. A PLMN-identity can be included only once, and in only one entry of the PLMN-IdentityInfoList. The PLMN index is defined as b1+b2+…+b(n-1)+i for the PLMN included at the n-th entry of PLMN-IdentityInfoList and the i-th entry of its corresponding PLMN-IdentityInfo, where b(j) is the number of PLMN-Identity entries in each PLMN-IdentityInfo, respectively.","paragraph_zero_based":15437},{"literal_text_all_w_t_and_m_t":"snpn-AccessInfoList","paragraph_zero_based":15438},{"literal_text_all_w_t_and_m_t":"This list provides access related information for each SNPN in npn-IdentityInfoList, see TS 23.501 [32]. The n-th entry of the list contains the access related information of the n-th SNPN in npn-IdentityInfoList. ","paragraph_zero_based":15439},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15440},{"literal_text_all_w_t_and_m_t":"SNPN-AccessInfo field descriptions","paragraph_zero_based":15441},{"literal_text_all_w_t_and_m_t":"extCH-Supported","paragraph_zero_based":15442},{"literal_text_all_w_t_and_m_t":"Indicates whether the SNPN supports access using credentials from a Credentials Holder as specified in TS 23.501 [32].","paragraph_zero_based":15443},{"literal_text_all_w_t_and_m_t":"extCH-WithoutConfigAllowed","paragraph_zero_based":15444},{"literal_text_all_w_t_and_m_t":"Indicates whether the SNPN allows registration attempts with credentials from a Credentials Holder from UEs that are not explicitly configured to select the SNPN as specified in TS 23.501 [32].","paragraph_zero_based":15445},{"literal_text_all_w_t_and_m_t":"imsEmergencySupportForSNPN","paragraph_zero_based":15446},{"literal_text_all_w_t_and_m_t":"Indicates whether the SNPN supports IMS emergency bearer services for UEs in limited service mode in the cell. If absent, IMS emergency call is not supported by the SNPN in the cell for UEs in limited service mode.","paragraph_zero_based":15447},{"literal_text_all_w_t_and_m_t":"onboardingEnabled","paragraph_zero_based":15448},{"literal_text_all_w_t_and_m_t":"Indicates whether the onboarding SNPN allows registration for onboarding in the cell as specified in TS 23.501 [32].","paragraph_zero_based":15449},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15450},{"literal_text_all_w_t_and_m_t":"–CellAccessRelatedInfo-EUTRA-5GC","paragraph_zero_based":15451},{"literal_text_all_w_t_and_m_t":"The IE CellAccessRelatedInfo-EUTRA-5GC indicates cell access related information for an LTE cell connected to 5GC.","paragraph_zero_based":15452},{"literal_text_all_w_t_and_m_t":"CellAccessRelatedInfo-EUTRA-5GC information element","paragraph_zero_based":15453},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":15454},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLACCESSRELATEDINFOEUTRA-5GC-START","paragraph_zero_based":15455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3ab