{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":30504},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30505},{"literal_text_all_w_t_and_m_t":"ZP-CSI-RS-Resource field descriptions","paragraph_zero_based":30506},{"literal_text_all_w_t_and_m_t":"periodicityAndOffset","paragraph_zero_based":30507},{"literal_text_all_w_t_and_m_t":"Periodicity and slot offset for periodic/semi-persistent ZP-CSI-RS (see TS 38.214 [19], clause 5.1.4.2). Network always configures the UE with a value for this field for periodic and semi-persistent ZP-CSI-RS resource (as indicated in PDSCH-Config).","paragraph_zero_based":30508},{"literal_text_all_w_t_and_m_t":"resourceMapping","paragraph_zero_based":30509},{"literal_text_all_w_t_and_m_t":"OFDM symbol and subcarrier occupancy of the ZP-CSI-RS resource within a slot.","paragraph_zero_based":30510},{"literal_text_all_w_t_and_m_t":"zp-CSI-RS-ResourceId","paragraph_zero_based":30511},{"literal_text_all_w_t_and_m_t":"ZP CSI-RS resource configuration ID (see TS 38.214 [19], clause 5.1.4.2).","paragraph_zero_based":30512},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30513},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":30514},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":30515},{"literal_text_all_w_t_and_m_t":"PeriodicOrSemiPersistent","paragraph_zero_based":30516},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need M, for periodic and semi-persistent ZP-CSI-RS-Resources (as indicated in PDSCH-Config). The field is absent otherwise.","paragraph_zero_based":30517},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30518},{"literal_text_all_w_t_and_m_t":"–ZP-CSI-RS-ResourceSet","paragraph_zero_based":30519},{"literal_text_all_w_t_and_m_t":"The IE ZP-CSI-RS-ResourceSet refers to a set of ZP-CSI-RS-Resources using their ZP-CSI-RS-ResourceIds.","paragraph_zero_based":30520},{"literal_text_all_w_t_and_m_t":"ZP-CSI-RS-ResourceSet information element","paragraph_zero_based":30521},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":30522},{"literal_text_all_w_t_and_m_t":"-- TAG-ZP-CSI-RS-RESOURCESET-START","paragraph_zero_based":30523},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30524},{"literal_text_all_w_t_and_m_t":"ZP-CSI-RS-ResourceSet ::=           SEQUENCE {","paragraph_zero_based":30525},{"literal_text_all_w_t_and_m_t":"    zp-CSI-RS-ResourceSetId             ZP-CSI-RS-ResourceSetId,","paragraph_zero_based":30526},{"literal_text_all_w_t_and_m_t":"    zp-CSI-RS-ResourceIdList            SEQUENCE (SIZE(1..maxNrofZP-CSI-RS-ResourcesPerSet)) OF ZP-CSI-RS-ResourceId,","paragraph_zero_based":30527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["bb5ab70d9d8121931a41058e00317a879e2ae20d966854e9dff7a0c288fa47bf","3d4c3369b6a2fa6b56a5902d52ff0f2521cea21f7ef59e8dad4925634a4633af","57609aeba579d58951ce1c637b49eaf06e69f99939b031745e25f4a5dbc6c25d","9e6742e98e2fa943111bc7c55076eaa3f0e38934abcc2c86f16de5e3f71c4805","bfb1ae75d99864b1a66fdde3a076f493176a8d878b47986409c5af0a9a0dd706","e486bef45b05173bddcb7717ea8c9c6d036b6e679161aabd3c0b1dc3e73eb281","1e0aac1b308795833e2005808ce62844d2d598a26e0c7450d2f712ce5ac334b1","5e8c809ec20bcf0fddfbfdd6ea550cec95d96bfe7461b230e05a754f1cab7f01","c91826a4124c9e74f73f7e4b3cc9a9c16ac5f89b4428a0242998e8ae704b97b1","23471767432e5406851f79093a9677ce6173d3044718bd49cc0e8e5d4d81da37","b7fc1e37b6f764bac748bf0a80057f63d0ad20c757161de6bc999239e0e9b569","8cd7162f0a4b64e9c28a699e39867eb8791f9