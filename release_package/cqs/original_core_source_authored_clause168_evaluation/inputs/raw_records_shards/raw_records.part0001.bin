{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27528},{"literal_text_all_w_t_and_m_t":"SemiStaticChannelAccessConfigUE-r17 ::=    SEQUENCE {","paragraph_zero_based":27529},{"literal_text_all_w_t_and_m_t":"    periodUE-r17                               ENUMERATED {ms1, ms2, ms2dot5, ms4, ms5, ms10, spare2, spare1},","paragraph_zero_based":27530},{"literal_text_all_w_t_and_m_t":"    offsetUE-r17                               INTEGER (0..559)","paragraph_zero_based":27531},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27532},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27533},{"literal_text_all_w_t_and_m_t":"-- TAG-SEMISTATICCHANNELACCESSCONFIGUE-STOP","paragraph_zero_based":27534},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27535},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27536},{"literal_text_all_w_t_and_m_t":"SemiStaticChannelAccessConfigUE field descriptions","paragraph_zero_based":27537},{"literal_text_all_w_t_and_m_t":"periodUE","paragraph_zero_based":27538},{"literal_text_all_w_t_and_m_t":"Indicates the period of a channel occupancy that the UE can initiate as described in TS 37.213 [48], clause 4.3. Value ms1 corresponds to 1 ms, value ms2 corresponds to 2 ms, value ms2dot5 corresponds to 2.5 ms, and so on.","paragraph_zero_based":27539},{"literal_text_all_w_t_and_m_t":"offsetUE","paragraph_zero_based":27540},{"literal_text_all_w_t_and_m_t":"Indicates the number of symbols from the beginning of the even indexed radio frame to the start of the first period within that radio frame that the UE can initiate a channel occupancy (see TS 37.213 [48], clause 4.3), based on the smallest SCS among the configured SCSs in the serving cell. The offset duration indicated by this field is less than the period duration indicated by periodUE. The maximum value is 139, 279 and 559 for 15, 30 and 60 kHz subcarrier spacing, respectively.","paragraph_zero_based":27541},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27542},{"literal_text_all_w_t_and_m_t":"–Sensor-LocationInfo","paragraph_zero_based":27543},{"literal_text_all_w_t_and_m_t":"The IE Sensor-LocationInfo is used by the UE to provide sensor information.","paragraph_zero_based":27544},{"literal_text_all_w_t_and_m_t":"Sensor-LocationInfo information element","paragraph_zero_based":27545},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27546},{"literal_text_all_w_t_and_m_t":"-- TAG-SENSORLOCATIONINFO-START","paragraph_zero_based":27547},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27548},{"literal_text_all_w_t_and_m_t":"Sensor-LocationInfo-r16 ::= SEQUENCE {","paragraph_zero_based":27549},{"literal_text_all_w_t_and_m_t":"    sensor-MeasurementInformation-r16    OCTET STRING    OPTIONAL,","paragraph_zero_based":27550},{"literal_text_all_w_t_and_m_t":"    sensor-MotionInformation-r16         OCTET STRING    OPTIONAL,","paragraph_zero_based":27551}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["b20e985fb392476f74fcbb0c2be9ae8375ba4b6bf5af352dc0fd951d386361b1","a9a5cdb77baaad1a4949339b2fdd9652122b805acfc34c29ee1d526a82f44f8f","371ecf235ae70c1870868b39a67b2ab9cf5baa5d05579a0797c23ea7b41f38c4","36b267cce94eea01e5a6cfcd8badbe9d9dd1d05512b34ceb689c9436db85df9a","adcaeff09079d38d01e4926aacddd2ceee9a846b0f270ae02062e8919c160f6d","29e0e782d96136f95e2d347fa3b7a2c6d4c18af3438cb750706b19c9fda5bcf6","c6ac850c3f59cfcebb7a65d9a701c80d3e655158945b4c07706c8bf0312d4b61","0089c313947a24161d9f1210f1ca62aaa8bcee5d8f9a85c1e9d76d2