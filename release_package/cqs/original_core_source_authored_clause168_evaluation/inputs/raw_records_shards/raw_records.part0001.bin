{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-SDAP-Header","paragraph_zero_based":39120},{"literal_text_all_w_t_and_m_t":"Indicates whether or not a SDAP header is present on this sidelink DRB. The field cannot be changed after a sidelink DRB is established. This field is set to present if the field sl-DefaultRB is set to true.","paragraph_zero_based":39121},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39122},{"literal_text_all_w_t_and_m_t":"–SL-ServingCellInfo","paragraph_zero_based":39123},{"literal_text_all_w_t_and_m_t":"The IE SL-ServingCellInfo is used to indicate the L2 U2N Relay UE's PCell/camping cell, which is considered as PCell/camping cell by the L2 U2N Remote UEs connecting with this L2 U2N Relay UE.","paragraph_zero_based":39124},{"literal_text_all_w_t_and_m_t":"SL-ServingCellInfo information element","paragraph_zero_based":39125},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39126},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SERVINGCELLINFO-START","paragraph_zero_based":39127},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39128},{"literal_text_all_w_t_and_m_t":"SL-ServingCellInfo-r17 ::=     SEQUENCE {","paragraph_zero_based":39129},{"literal_text_all_w_t_and_m_t":"    sl-PhysCellId-r17              PhysCellId,","paragraph_zero_based":39130},{"literal_text_all_w_t_and_m_t":"    sl-CarrierFreqNR-r17           ARFCN-ValueNR","paragraph_zero_based":39131},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39132},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39133},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SERVINGCELLINFO-STOP","paragraph_zero_based":39134},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39135},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39136},{"literal_text_all_w_t_and_m_t":"SL-ServingCellInfo field descriptions","paragraph_zero_based":39137},{"literal_text_all_w_t_and_m_t":"sl-CarrierFreqNR","paragraph_zero_based":39138},{"literal_text_all_w_t_and_m_t":"Indicates the DL frequency of the cell indicated by sl-PhysCellId.","paragraph_zero_based":39139},{"literal_text_all_w_t_and_m_t":"sl-PhysCellId","paragraph_zero_based":39140},{"literal_text_all_w_t_and_m_t":"Indicates the PCI of the PCell.","paragraph_zero_based":39141},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39142},{"literal_text_all_w_t_and_m_t":"–SL-SourceIdentity","paragraph_zero_based":39143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["fd03ae126db3ddb411b20764c9bbecdc54ea9945aefffa16b59246cc33f324e2","9cf5addede4dd61661aa9e5435b5514cd43550116ca3b59308c6371caab8cc92","1b0d427a0da51f40086679576500f459db8a1af3fcd7c8039b28b1fc70422a66","83962f9aa6ca38e78a36467b9e90282569cdf59d5d624ed8278f0673a36a8264","a3df733ec395040540738a5bc3acb6ba49f3f2dc2e6c2ac5c00ae2c362db239e","e61a892a1d11b4d3cafe130759aedb4cea207c72c46ecec98eb1a12efafecee8","e78316f90dc6dee95129cbfac4336be1694575c4eb47d23e525bc8097d318163","47ca0a24b3378f685ca64ddc6d63861b1fca8c7c2b70b6d0cd23a476740c7541","600cf6c5355c5f34c1126eeab36c1b94495c993be994d0da0a2768fe2bd0a94d","05f76263ae5221164b2e97920e1e9c26ae310aec18dc57ff68e0b9b3b1e2b5bd","6ea1851a651a3efeca338004401c7eb6be771da2ec16ec6f63d27f8dc9f265a2","935483354fdfa17b7a1f97c56bc5ae1f577813794548fb51cfbca2b2c314ad0d","e826bcd716b5f2aefd88abd4ea31d696dd2a571355f036473995198477b7a5ef","eccb2082297876e272c7176ab84483f3023d3d674a90e5d6cdb1712f8a495eeb","342e68230a57ae80c162564979491b36f9235c7f8eca3d1bf154890e8392e762","ab03f5ed8eb989e9722901795a406f33123c57e