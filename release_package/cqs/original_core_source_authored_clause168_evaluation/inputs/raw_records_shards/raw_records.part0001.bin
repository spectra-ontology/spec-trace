6ed7dcf586819644ffce9db5a08ecf","e326b93cdee4fa1bf7f528ad1e95d63fdaf22a0a86e1b87c7f081e86fac5f066","a4bc8df93132f194693eedd775c5629792225f2a98879b99092ac51c0dbd7338","f77fd050962caf60afc2f43b682dd15f6df5abd6348faa232d2959e1fb7c1dde","5337c4c65372912090084b5b4f97951282a16df5429611b69e7aa58386bf2d6f","34f1e2bae37eb53a14c85890e85ccba9001b5e61c9f91f92b9fc7baf8b36fa99","24a5e38d803523d39db5225da69716a5a0b4203c039f1745dc5f7507a1344158","cc1bb6762fa4727810bdc10490396cc54cab53ca7b79f8f5547e96198c2b89ee","b673f4d58cc8345298cc4837a52c8630b06c6e2b318c6dc7ed7bc1974423b863","b5ee4ef95b89a0e51b1d1675b97afa35db21cc6667286f701b9a781741ab2304","85d0b633e02a6254df485b23db738637904d5aaa95c86aa57f9e8f9c24c8e4e2","413127c4bb150d22afd8fea2b838f738647c8c239989e0622685e710a1381e74","24927bfcd37405c4e8a0808b93ad62936ed3c2707ae13d7a86a8ff639d9c7cd4","5952a2255a5e1b69cde0ae035833515c7a8770e64edab828cff953a83db4b45b","fe4d89c8d0ac44da60f4fb50d81550100282ad08ba9c6f27549e9117cdb3b046"],"paragraph_range_zero_based":[23136,23159],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p23136"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23160},{"literal_text_all_w_t_and_m_t":"PDCCH-BlindDetectionCA-CombIndicator-r17 ::= SEQUENCE {","paragraph_zero_based":23161},{"literal_text_all_w_t_and_m_t":"    pdcch-BlindDetectionCA1-r17                  INTEGER (1..15)                                        OPTIONAL,   -- Need R","paragraph_zero_based":23162},{"literal_text_all_w_t_and_m_t":"    pdcch-BlindDetectionCA2-r17                  INTEGER (1..15)                                        OPTIONAL,   -- Need R","paragraph_zero_based":23163},{"literal_text_all_w_t_and_m_t":"    pdcch-BlindDetectionCA3-r17                  INTEGER (1..15)","paragraph_zero_based":23164},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":23165},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23166},{"literal_text_all_w_t_and_m_t":"-- TAG-PHYSICALCELLGROUPCONFIG-STOP","paragraph_zero_based":23167},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23168},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23169},{"literal_text_all_w_t_and_m_t":"PhysicalCellGroupConfig field descriptions","paragraph_zero_based":23170},{"literal_text_all_w_t_and_m_t":"ackNackFeedbackMode","paragraph_zero_based":23171},{"literal_text_all_w_t_and_m_t":"Indicates which among the joint and separate ACK/NACK feedback modes to use within a slot as specified in TS 38.213 [13] (clause 9).","paragraph_zero_based":23172},{"literal_text_all_w_t_and_m_t":"bdFactorR","paragraph_zero_based":23173},{"literal_text_all_w_t_and_m_t":"Parameter for determining and distributing the maximum numbers of BD/CCE for mPDCCH based mPDSCH transmission as specified in TS 38.213 [13] Clause 10.1.","paragraph_zero_based":23174},{"literal_text_all_w_t_and_m_t":"cs-RNTI","paragraph_zero_based":23175},{"literal_text_all_w_t_and_m_t":"RNTI value for downlink SPS (see SPS-Config) and uplink configured grant (see ConfiguredGrantConfig).","paragraph_zero_based":23176},{"literal_text_all_w_t_and_m_t":"downlinkAssignmentIndexDCI-0-2","paragraph_zero_based":23177},{"literal_text_all_w_t_and_m_t":"Indicates if \"Downlink assignment index\" is present or absent in DCI format 0_2. If the field \"downlinkAssignmentIndexDCI-0-2\" is absent, then 0 bit for \"Downlink assignment index\" in DCI format 0_2. If the field \"downlinkAssignmentIndexDCI-0-2\" is present, then the bitwidth of \"Downlink assignment index\" in DCI format 0_2 is defined in the same was as that in DCI format 0_1 (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13], clause 9.1).","paragraph_zero_based":23178},{"literal_text_all_w_t_and_m_t":"downlinkAssignmentIndexDCI-1-2","paragraph_zero_based":23179},{"literal_text_all_w_t_and_m_t":"Configures the number of bits for \"Downlink assignment index\" in DCI format 1_2. If the field is absent, then 0 bit is applied for \"Downlink assignment index\" in DCI format 1_2. Note that 1 bit and 2 bits are applied if only one serving cell is configured in the DL and pdsch-HARQ-ACK-Codebook is set to dynamic. 4 bits is applied if more than one serving cell are configured in the DL and pdsch-HARQ-ACK-Codebook is set to dynamic (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13], clause 9.1).","paragraph_zero_based":23180},{"literal_text_all_w_t_and_m_t":"harq-ACK-SpatialBundlingPUCCH","paragraph_zero_based":23181},{"literal_text_all_w_t_and_m_t":"Enables spatial bundling of HARQ ACKs. It is configured per cell group (i.e. for all the cells within the cell group) for PUCCH reporting of HARQ-ACK. It is only applicable when more than 4 layers are possible to schedule. When the field is absent, the spatial bundling of PUCCH HARQ ACKs for the primary PUCCH group is disabled (see TS 38.213 [13], clause 9.1.2.1). If the field harq-ACK SpatialBundlingPUCCH-secondaryPUCCHgroup is present, harq-ACK-SpatialBundlingPUCCH is only applied to primary PUCCH group. Network does not configure for a UE both spatial bundling of HARQ ACKs and codeBlockGroupTransmission within the same cell group.","paragraph_zero_based":23182},{"literal_text_all_w_t_and_m_t":"harq-ACK-SpatialBundlingPUCCH-secondaryPUCCHgroup","paragraph_zero_based":23183}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["2ba50e560ced239d7fc056249976174175e4237ae01d751f182566304c134685","c567043413a1edb23516e43eeffe21bcf021abfa08e2355e04a68e60857d2306","6f941b061ba192f467c841327039122636cffda27571b69865ffff086a2d9c06","75df4623ad11f26c843eda2f55c371325362f8e043ec66577e4f0d1d864068e6","58f61d60327bd7bd7fde4ef4e6adf23ae838b39e55884c258495708befae6b49","5a91d207a4c5cf20f5fe3ccf89c398984862350e3343b79ad431562bc7f4d2cc","a411339539e08c6ced2aec3116373e4fea9ad20ca87063a47b499de7c1cf255a","2f77eabaaa4a0518be2a4477876122674961ce4871e1a0ff279909e193acf647","bcdefa6c0b08c8df4da834414e8cc797cebbff93b8f3c3e78d2b33e11eb73980","1ef75afddd919cf509655df2ab5d2ef78a12c08f5013dd6f3b9214f61c6e6aa4","dc04215703e58487a4e8d8782ef3853004042e4fa25388108d49ff4543f720ff","19e78baa896e3d69e172d87de88eaf9136cfb30c0b4463925044e38507ebcbae","33326f3e6b5ce4941415eabab3a125e7343a546183f22a3c59f07dabe0f71d5f","5631d427e6617dbcd621c74fca7b102af9a5ca8194909d48cbafb0286ccc69c8","6d8b987eaac399689dd6d0bfd2e8713c0305b3a43dbe4c7c878ed7c0f4757b39","b5f8ba3acecdefd1ca7e20849411481864ec929a6185f5ad6304b3e2250c86a7","f1c3576755db0580342d8b16c28ee7977586059ce09a43d78d37ff0fff6c1fa3","fd095e4892df6b1ff129d774a477af69fb42b18aa6e5a6b098e03e6dd08aee7f","0efc75b5ea06294a6a46a0425132979bb1d69cca3f0789defa27bb8f2d63c035","fb070b35870e3db727d4455390c43f54a57fb6ee1e3560470aa3c16de7f2158c","4f97dd0d0985375d9fc8c6dcd3e5cfc174dd8dcd2bb3307e93d5ba8f5476cca0","68507d54afdead1afcbdea1d563f13b9740321f221051405f9bf39b3263b1247","a5944ec817671e5c8a4dcb372b6731a7eed5a802bd57e79b7a7daac81cc448ad","004653f28ab3b59237707b91023b67f5d691a70219cf7baed560a83019ee7ef7"],"paragraph_range_zero_based":[23160,23183],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p23160"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether spatial bundling of PUCCH HARQ ACKs for the secondary PUCCH group is enabled or disabled. The field is only applicable when more than 4 layers are possible to schedule (see TS 38.213 [13], clause 9.1.2.1). When the field is absent, the use of spatial bundling of PUCCH HARQ ACKs for the secondary PUCCH group is indicated by harq-ACK-SpatialBundlingPUCCH. See TS 38.213 [13], clause 9.1.2.1. Network does not configure for a UE both spatial bundling of HARQ ACKs and codeBlockGroupTransmission within the same cell group.","paragraph_zero_based":23184},{"literal_text_all_w_t_and_m_t":"harq-ACK-SpatialBundlingPUSCH","paragraph_zero_based":23185},{"literal_text_all_w_t_and_m_t":"Enables spatial bundling of HARQ ACKs. It is configured per cell group (i.e. for all the cells within the cell group) for PUSCH reporting of HARQ-ACK. It is only applicable when more than 4 layers are possible to schedule. When the field is absent, the spatial bundling of PUSCH HARQ ACKs for the primary PUCCH group is disabled (see TS 38.213 [13], clauses 9.1.2.2 and 9.1.3.2). If the field harq-ACK SpatialBundlingPUSCH-secondaryPUCCHgroup is present, harq-ACK-SpatialBundlingPUSCH is only applied to primary PUCCH group. Network does not configure for a UE both spatial bundling of HARQ ACKs and codeBlockGroupTransmission within the same cell group.","paragraph_zero_based":23186},{"literal_text_all_w_t_and_m_t":"harq-ACK-SpatialBundlingPUSCH-secondaryPUCCHgroup","paragraph_zero_based":23187},{"literal_text_all_w_t_and_m_t":"Indicates whether spatial bundling of PUSCH HARQ ACKs for the secondary PUCCH group is enabled or disabled. The field is only applicable when more than 4 layers are possible to schedule (see TS 38.213 [13], clauses 9.1.2.2 and 9.1.3.2). When the field is absent, the use of spatial bundling of PUSCH HARQ ACKs for the secondary PUCCH group is indicated by harq-ACK-SpatialBundlingPUSCH. See TS 38.213 [13], clauses 9.1.2.2 and 9.1.3.2. Network does not configure for a UE both spatial bundling of HARQ ACKs and codeBlockGroupTransmission within the same cell group.","paragraph_zero_based":23188},{"literal_text_all_w_t_and_m_t":"intraBandNC-PRACH-simulTx","paragraph_zero_based":23189},{"literal_text_all_w_t_and_m_t":"Enables parallel PRACH and SRS/PUCCH/PUSCH transmissions across CCs in intra-band non-contiguous CA (see TS 38.213 [13], clause 8.1 and TS 38.214 [19], clause 6.2.1). This field is absent in the IE CellGroupConfig when provided as part of RRCSetup message.","paragraph_zero_based":23190},{"literal_text_all_w_t_and_m_t":"mcs-C-RNTI","paragraph_zero_based":23191},{"literal_text_all_w_t_and_m_t":"RNTI to indicate use of qam64LowSE for grant-based transmissions. When the mcs-C-RNTI is configured, RNTI scrambling of DCI CRC is used to choose the corresponding MCS table.","paragraph_zero_based":23192},{"literal_text_all_w_t_and_m_t":"nfi-TotalDAI-Included","paragraph_zero_based":23193},{"literal_text_all_w_t_and_m_t":"Indicates whether the NFI and total DAI fields of the non-scheduled PDSCH group is included in the non-fallback DL grant DCI (see TS 38.212 [17], clause 7.3.1). The network configures this only when enhanced dynamic codebook is configured (pdsch-HARQ-ACK-Codebook is set to enhancedDynamic).","paragraph_zero_based":23194},{"literal_text_all_w_t_and_m_t":"nrdc-PCmode-FR1","paragraph_zero_based":23195},{"literal_text_all_w_t_and_m_t":"Indicates the uplink power sharing mode that the UE uses in NR-DC in frequency range 1 (FR1) (see TS 38.213 [13], clause 7.6).","paragraph_zero_based":23196},{"literal_text_all_w_t_and_m_t":"nrdc-PCmode-FR2","paragraph_zero_based":23197},{"literal_text_all_w_t_and_m_t":"Indicates the uplink power sharing mode that the UE uses in NR-DC in frequency range 2 (FR2) (see TS 38.213 [13], clause 7.6).","paragraph_zero_based":23198},{"literal_text_all_w_t_and_m_t":"pdcch-BlindDetection, pdcch-BlindDetection2, pdcch-BlindDetection3, pdcch-BlindDetection4","paragraph_zero_based":23199},{"literal_text_all_w_t_and_m_t":"Indicates the reference number of cells for PDCCH blind detection for the CG. Network configures the field for each CG when the UE is in NR DC and sets the value in accordance with the constraints specified in TS 38.213 [13]. The network configures pdcch-BlindDetection only if the UE is in NR-DC. The network configures pdcch-BlindDetection2 only if the UE is in NR-DC with at least one downlink cell using Rel-16 PDCCH monitoring capability. The network configures pdcch-BlindDetection3 only if the UE is in NR-DC with at least one downlink cell using Rel-15 PDCCH monitoring capability. The network configures pdcch-BlindDetection4 only if the UE is in NR-DC with at least one downlink cell using Rel-17 PDCCH monitoring capability.","paragraph_zero_based":23200},{"literal_text_all_w_t_and_m_t":"pdcch-BlindDetectionCA-CombIndicator","paragraph_zero_based":23201},{"literal_text_all_w_t_and_m_t":"Configure one combination of pdcch-BlindDetectionCA1 (for R15) and pdcch-BlindDetectionCA2 (for R16) for UE to use for scaling PDCCH monitoring capability if the number of serving cells configured to a UE is larger than the reported capability, and if UE reports more than one combination of pdcch-BlindDetectionCA1 and pdcch-BlindDetectionCA2 as UE capability. The combination of pdcch-BlindDetectionCA1 and pdcch-BlindDetectionCA2 configured by pdcch-BlindDetectionCA-CombIndicator is from the more than one combination of pdcch-BlindDetectionCA1 and pdcch-BlindDetectionCA2 reported by UE (see TS 38.213 [13], clause 10).","paragraph_zero_based":23202},{"literal_text_all_w_t_and_m_t":"pdcch-BlindDetectionCA-CombIndicator-r17 is used to configure one combination of pdcch-BlindDetectionCA1 (for R15), pdcch-BlindDetectionCA2 (for R16) and pdcch-BlindDetectionCA3 (for R17) for UE to use for scaling PDCCH monitoring capability if the number of serving cells configured to a UE is larger than the reported capability, and if UE reports more than one combination of pdcch-BlindDetectionCA1, pdcch-BlindDetectionCA2 and pdcch-BlindDetectionCA3 as UE capability. The combination of pdcch-BlindDetectionCA1, pdcch-BlindDetectionCA2 and pdcch-BlindDetectionCA3 configured by pdcch-BlindDetectionCA-CombIndicator-r17 is from the more than one combination of pdcch-BlindDetectionCA1, pdcch-BlindDetectionCA2 and pdcch-BlindDetectionCA3 reported by UE (see TS 38.213 [13], clause 10).","paragraph_zero_based":23203},{"literal_text_all_w_t_and_m_t":"pdcch-BlindDetectionCA-CombIndicator-r16 and pdcch-BlindDetectionCA-CombIndicator-r17 are not configured simultaneously.","paragraph_zero_based":23204},{"literal_text_all_w_t_and_m_t":"p-NR-FR1","paragraph_zero_based":23205},{"literal_text_all_w_t_and_m_t":"The maximum total transmit power to be used by the UE in this NR cell group across all serving cells in frequency range 1 (FR1). The maximum transmit power that the UE may use may be additionally limited by p-Max (configured in FrequencyInfoUL) and by p-UE-FR1 (configured total for all serving cells operating on FR1).","paragraph_zero_based":23206},{"literal_text_all_w_t_and_m_t":"p-NR-FR2","paragraph_zero_based":23207}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["ebe2b3319d147d05c2457ea8ec39a17af8a6cbdaed0370884221b853fa461b8d","3f6671b7cb325d575b30c1a8de0c949738f70fabf1308905048297f242c7e6f1","7cd32067760fa67951d7ca51ae7853f8d6cc9cdc6c69f90bddf7dba5ccc6a637","4fd2da951de0f21538cfdf2925554ae01a5ff6f8a440f602ba7fe39870404f9d","51212225d96768ced7df3352a212c46c526a083690c09dfaf91f94169b7f4a87","a754e10498985f1e80888ccacb902803df8a85908eef15797a1a904915c0a0b7","ab8a2337e9f3e944ef2eff708764faf00a1bdf11ff3d5590c68ff8e1823adf04","6faefa9688124660f1b4872e9d030ac505b11044d04ecb58896861cddb75816f","8937bea94574b70eeb72ca6bf6ac91e24a486484184c7c20f2938e33009c3aa3","677836feb0c81a4506eaf3ed793caad3d1ec3f9cdac017bbee5514e25a741f70","8cb9cb56ee225e72bd750254e89c7f1889ee00e683a025ed6f2922f5bb29604e","167eea5225f5e7915d9f41802cf286d4f441ac59431b41d7eb4fcd6385595c83","ab469eaa38748d85986c89c85a3545b3e2fd86b53977c5852502532b138655f7","1da993c1bfe86eba65ac34d6aa4d840105e8e08f88a2e9e22f87cf0e40fb2237","3212371bc2a6aa412e382a819ff22204459c0d0074f5fe32a452917cb2919406","61f731ed175f08412e8d5446632b87fb2948b87c895719348e9e865f041494c7","64eb76f463b190b0c41e4c1feda997fd3789e6777f43e94ba71fa8033b65a434","b8a819427e3b97211aa63b4f10708e251aa034c2975544730d637f13c1d2be28","96f87b4e2d940e8be88f9c85a65c7821b7bfbe95e17efc6a9fdf1209863a8a2d","72ba4a509cde18685efa4fb4a8a8e6662b1e9c40df5e2b529aa9ad595771b91a","18c7fe4bfb02acbf1e4a17970d2bc133da743c698db19235158a3508f93e16d8","471968630f1b052872538bc78b021123e1924c58a31dbf52db54a28743655197","1c2a6c7b6876975cd5ccd4a6a4437d119f56edad4ad1feeafeff65d648dc6ff8","a70a3973e432273af307bd02a6f7987a197ec772c53ef321aa4c2d4a9f4971da"],"paragraph_range_zero_based":[23184,23207],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p23184"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The maximum total transmit power to be used by the UE in this NR cell group across all serving cells in frequency range 2 (FR2). The maximum transmit power that the UE may use may be additionally limited by p-Max (configured in FrequencyInfoUL) and by p-UE-FR2 (configured total for all serving cells operating on FR2). This field is only used in NR-DC. A UE does not expect to be configured with this parameter in this release of the specification.","paragraph_zero_based":23208},{"literal_text_all_w_t_and_m_t":"prioLowDG-HighCG","paragraph_zero_based":23209},{"literal_text_all_w_t_and_m_t":"Enable PHY prioritization for the case where low-priority dynamic grant-PUSCH collides with high-priority configured grant-PUSCH on a BWP of a serving cell (see TS 38.213 [13], clause 9), when the UE has generated transport blocks for both DG-PUSCH and CG-PUSCH as described in TS 38.321 [3].","paragraph_zero_based":23210},{"literal_text_all_w_t_and_m_t":"prioHighDG-LowCG","paragraph_zero_based":23211},{"literal_text_all_w_t_and_m_t":"Enable PHY prioritization for the case where high-priority dynamic grant PUSCH collides with low-priority configured grant PUSCH on a BWP of a serving cell (see TS 38.213 [13], clause 9), when the UE has generated transport blocks for both DG-PUSCH and CG-PUSCH as described in TS 38.321 [3].","paragraph_zero_based":23212},{"literal_text_all_w_t_and_m_t":"ps-RNTI","paragraph_zero_based":23213},{"literal_text_all_w_t_and_m_t":"RNTI value for scrambling CRC of DCI format 2-6 used for power saving (see TS 38.213 [13], clause 10.1).","paragraph_zero_based":23214},{"literal_text_all_w_t_and_m_t":"ps-Offset","paragraph_zero_based":23215},{"literal_text_all_w_t_and_m_t":"The start of the search-time of DCI format 2-6 with CRC scrambled by PS-RNTI relative to the start of the drx-onDurationTimer of Long DRX (see TS 38.213 [13], clause 10.3). Value in multiples of 0.125ms (milliseconds). 1 corresponds to 0.125 ms, 2 corresponds to 0.25 ms, 3 corresponds to 0.375 ms and so on.","paragraph_zero_based":23216},{"literal_text_all_w_t_and_m_t":"ps-WakeUp","paragraph_zero_based":23217},{"literal_text_all_w_t_and_m_t":"Indicates the UE to wake-up if DCI format 2-6 is not detected outside active time (see TS 38.321 [3], clause 5.7). If the field is absent, the UE does not wake-up if DCI format 2-6 is not detected outside active time.","paragraph_zero_based":23218},{"literal_text_all_w_t_and_m_t":"ps-PositionDCI-2-6","paragraph_zero_based":23219},{"literal_text_all_w_t_and_m_t":"Starting position of UE wakeup and SCell dormancy indication in DCI format 2-6 (see TS 38.213 [13], clause 10.3).","paragraph_zero_based":23220},{"literal_text_all_w_t_and_m_t":"ps-TransmitPeriodicL1-RSRP","paragraph_zero_based":23221},{"literal_text_all_w_t_and_m_t":"Indicates the UE to transmit periodic L1-RSRP report(s) when the drx-onDurationTimer does not start (see TS 38.321 [3], clause 5.7). If the field is absent, the UE does not transmit periodic L1-RSRP report(s) when the drx-onDurationTimer does not start.","paragraph_zero_based":23222},{"literal_text_all_w_t_and_m_t":"ps-TransmitOtherPeriodicCSI","paragraph_zero_based":23223},{"literal_text_all_w_t_and_m_t":"Indicates the UE to transmit periodic CSI report(s) other than L1-RSRP reports when the drx-onDurationTimer does not start (see TS 38.321 [3], clause 5.7). If the field is absent, the UE does not transmit periodic CSI report(s) other than L1-RSRP reports when the drx-onDurationTimer does not start.","paragraph_zero_based":23224},{"literal_text_all_w_t_and_m_t":"p-UE-FR1","paragraph_zero_based":23225},{"literal_text_all_w_t_and_m_t":"The maximum total transmit power to be used by the UE across all serving cells in frequency range 1 (FR1) across all cell groups. The maximum transmit power that the UE may use may be additionally limited by p-Max (configured in FrequencyInfoUL) and by p-NR-FR1 (configured for the cell group).","paragraph_zero_based":23226},{"literal_text_all_w_t_and_m_t":"p-UE-FR2","paragraph_zero_based":23227},{"literal_text_all_w_t_and_m_t":"The maximum total transmit power to be used by the UE across all serving cells in frequency range 2 (FR2) across all cell groups. The maximum transmit power that the UE may use may be additionally limited by p-Max (configured in FrequencyInfoUL) and by p-NR-FR2 (configured for the cell group). A UE does not expect to be configured with this parameter in this release of the specification.","paragraph_zero_based":23228},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-Codebook","paragraph_zero_based":23229},{"literal_text_all_w_t_and_m_t":"The PDSCH HARQ-ACK codebook is either semi-static or dynamic. This is applicable to both CA and non-CA operation (see TS 38.213 [13], clauses 9.1.2 and 9.1.3). If pdsch-HARQ-ACK-Codebook-r16 is signalled, UE shall ignore the pdsch-HARQ-ACK-Codebook (without suffix). For the HARQ-ACK for sidelink, if pdsch-HARQ-ACK-Codebook-r16 is signalled, the UE uses pdsch-HARQ-ACK-Codebook (without suffix) and ignores pdsch-HARQ-ACK-Codebook-r16. If the field pdsch-HARQ-ACK-Codebook-secondaryPUCCHgroup is present, pdsch-HARQ-ACK-Codebook is applied to primary PUCCH group. Otherwise, this field is applied to the cell group (i.e. for all the cells within the cell group). For the HARQ-ACK for sidelink, if the field pdsch-HARQ-ACK-Codebook-secondaryPUCCHgroup is present, pdsch-HARQ-ACK-Codebook is applied to primary and secondary PUCCH group and the UE ignores pdsch-HARQ-ACK-Codebook-secondaryPUCCHgroup.","paragraph_zero_based":23230},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-CodebookList","paragraph_zero_based":23231}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["37bef8f97d0524056fbea1c1ab98b9bf610592efec209da62d191f0fbe529e68","5462ceac7bf9b6744cdb0deea6aadc29d681900134a3a0a91e9ed5cdbbe53de1","666d67a44ba58d875ad3cb9b58c86a32a048c485915acdbb8bcccee783c7c45d","bb9ae2d21dd672bf3a4a8a890d533cf088f123f37de87a865050df90431a2b0d","d961b97771d3f9f7b21a463ce6c8bce60e1d027acd3e2bd218b0c49cb15dc0d5","1bcd7319a313417e41999c838682c03e3a6e52340f1c9f37daa4d656193519b7","d51ffac1e25eb97a591d7aa6a2eb4d50812a00d94db4088747cb5ccc2d9e6577","df1f0602c0de7e0b1d9cf17865274fba9711395ae7e6a2f7308b716955b810e4","ef1ff94cd37a2443780b00bbd1f6d506cc6812eb92e8fd6e07fd3b500316890e","868b75d52a52be18744a509fe7bfe28398a1412664fab028e3992f48315429d7","d9f7cb3ef276fb097e1815926a7a0f3ccc4ff2b6ab4845d5030b1093a69ee212","a3d5eccb3d1eba926040df31a0512daed2943f780428aa604fbbc79bf3610d5b","39f299a68df4f5107730e1cb96b2bddc4d6645ed11866286cf8222abbd52e377","c5dc8ca1dfdfc136f54598f3be84554a138233b46cbca25d023a987d55a014d0","99fcd8f6f8312061ad1c7803f42c6c330443c2fc35d7e3bd960294a6b4b17e07","b3d448ed2a6f54a620fd4764c3385ddac2bcdcefa9f18002989c0d0100610f0b","3dc22ace228bcfb7ac84257f1667a3227b026fa9b8dccdc4065ac34b4bd10ad3","358e6ec25aee4c9811f6153ed26f4cbf817258a840d1ae726adc005f2dea66a7","0ac0d9eaa3ce770256cf0bc364bfdb93b7ce06f812ab7c4ac9db3bc1940c0118","0e47ff476be6da75c0fea997db9e3d3d12e4c4d67bb39cd81e37e9141a9e79b5","c1852971a477f0ff97c0fdb448deb3478fa48e3a3705ea6c4a01341524cd27eb","3d64f027e9113f69ce5546f7495465f6316e42d6907da4627fed96bcb9ac39ba","79cf43bcac23a6badda2ea2511ef1caa34b3f398dce6a844704cefb0ca549f09","3b98103664b66476ff25390e85ffcb307265fc1194e8faa44f6af957faa3f615"],"paragraph_range_zero_based":[23208,23231],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p23208"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"A list of configurations for one or two HARQ-ACK codebooks. Each configuration in the list is defined in the same way as pdsch-HARQ-ACK-Codebook (see TS 38.212 [17], clause 7.3.1.2.2 and TS 38.213 [13], clauses 7.2.1, 9.1.2, 9.1.3 and 9.2.1). If this field is present, the field pdsch-HARQ-ACK-Codebook is ignored. If this field is present, the value of this field is applied for primary PUCCH group and for secondary PUCCH group (if configured). For the HARQ-ACK for sidelink, the UE uses pdsch-HARQ-ACK-Codebook and ignores pdsch-HARQ-ACK-CodebookList if this field is present.","paragraph_zero_based":23232},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-Codebook-secondaryPUCCHgroup","paragraph_zero_based":23233},{"literal_text_all_w_t_and_m_t":"The PDSCH HARQ-ACK codebook is either semi-static or dynamic. This is applicable to CA operation (see TS 38.213 [13], clauses 9.1.2 and 9.1.3). It is configured for secondary PUCCH group.","paragraph_zero_based":23234},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-EnhType3DCI-Field, pdsch-HARQ-ACK-EnhType3DCI-FieldSecondaryPUCCHgroup","paragraph_zero_based":23235},{"literal_text_all_w_t_and_m_t":"Indicates the enhanced Type 3 codebook through a new DCI field to indicate the enhanced Type 3 HARQ-ACK codebook in the primary PUCCH group if the more than one enhanced Type 3 HARQ-ACK codebook is configured for the primary PUCCH group, or in the secondary PUCCH group if the more than one enhanced Type 3 HARQ-ACK code is configured for the secondary PUCCH group, respectively.","paragraph_zero_based":23236},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-EnhType3ToAddModList, pdsch-HARQ-ACK-EnhType3SecondaryToAddModList","paragraph_zero_based":23237},{"literal_text_all_w_t_and_m_t":"Configure the list of enhanced Type 3 HARQ-ACK codebooks for the primary PUCCH group and the secondary PUCCH group, respectively. When configured, DCI format 1_1 can request the UE to report A/N for one of the configured enhanced Type 3 HARQ-ACK codebooks in the corresponding PUCCH group (see TS 38.213 [13], clause 9.1.4). The network can configure pdsch-HARQ-ACK-EnhType3SecondaryToAddModList only if secondary PUCCH group is configured.","paragraph_zero_based":23238},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-OneShotFeedback","paragraph_zero_based":23239},{"literal_text_all_w_t_and_m_t":"When configured, the DCI format 1_1 can request the UE to report A/N for all HARQ processes and all CCs configured in the PUCCH group (see TS 38.212 [17], clause 7.3.1).","paragraph_zero_based":23240},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-OneShotFeedbackCBG","paragraph_zero_based":23241},{"literal_text_all_w_t_and_m_t":"When configured, the DCI format 1_1 can request the UE to include CBG level A/N for each CC with CBG level transmission configured. When not configured, the UE will report TB level A/N even if CBG level transmission is configured for a CC. The network configures this only when pdsch-HARQ-ACK-OneShotFeedback is configured.","paragraph_zero_based":23242},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-OneShotFeedbackNDI","paragraph_zero_based":23243},{"literal_text_all_w_t_and_m_t":"When configured, the DCI format 1_1 can request the UE to include NDI for each A/N reported. The network configures this only when pdsch-HARQ-ACK-OneShotFeedback is configured.","paragraph_zero_based":23244},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-Retx, pdsch-HARQ-ACK-RetxSecondaryPUCCHgroup","paragraph_zero_based":23245},{"literal_text_all_w_t_and_m_t":"When configured, the DCI format 1_1 can request the UE to perform a HARQ-ACK re-transmission on a PUCCH resource in the primary PUCCH group and the secondary PUCCH group, respectively (see TS 38.213 [13], clause 9.1.5).","paragraph_zero_based":23246},{"literal_text_all_w_t_and_m_t":"pucch-sSCell, pucch-sSCellSecondaryPUCCHgroup","paragraph_zero_based":23247},{"literal_text_all_w_t_and_m_t":"indictates the alternative PUCCH cells for PUCCH cell switching in the primary and the secondary PUCCH group, respectively. For the primary PUCCH group, it is configured for cells on top of SpCell. For the secondary PUCCH group, it is configured for cell on top of the PUCCH SCell.","paragraph_zero_based":23248},{"literal_text_all_w_t_and_m_t":"pucch-sSCellDyn, pucch-sSCellDynsecondaryPUCCHgroup","paragraph_zero_based":23249},{"literal_text_all_w_t_and_m_t":"When configured, PUCCH cell switching based on dynamic indication in DCI format 1_1 is enabled (see TS 38.213 [13], clause 9.A, clause 9.1.5), respectively for the primary PUCCH group and the secondary PUCCH group.","paragraph_zero_based":23250},{"literal_text_all_w_t_and_m_t":"pucch-sSCellPattern, pucch-sSCellPatternSecondaryPUCCHgroup","paragraph_zero_based":23251},{"literal_text_all_w_t_and_m_t":"When configured, the UE applies the semi-static PUCCH cell switching (see TS 38.213 [13], clause 9.A) using the time domain pattern of applicable PUCCH cells indicated by this field, respectively for the primary PUCCH group and the secondary PUCCH group.","paragraph_zero_based":23252},{"literal_text_all_w_t_and_m_t":"simultaneousPUCCH-PUSCH, simultaneousPUCCH-PUSCH-SecondaryPUCCHgroup","paragraph_zero_based":23253},{"literal_text_all_w_t_and_m_t":"Enables simultaneous PUCCH and PUSCH transmissions with different priorities for the primary PUCCH group and the secondary PUCCH group, respectively.","paragraph_zero_based":23254},{"literal_text_all_w_t_and_m_t":"simultaneousSR-PUSCH-diffPUCCH-Groups","paragraph_zero_based":23255}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["57a3f8e125112aed7b084f8885048b805909e67635f8f85ecbab669befe34a06","1151d6f3c929b923c36797d2285eeddfde3632c32d344a8e0fda91ba7da15c3b","30ae94d82c0f7c9f560aacd9a7609e077ee0bfcd3b746acff84e4f0530c064dd","a47371e3b36da13dcbc688a80ad0caa89792b6fd3f8c9223e99f3322442edb36","6abb1dc34b064cd14c595196dde25da825d0a187f6efeead76fb2acf8b6de469","407fef4ec95a9eba1f4c8ae8a6cfe8e9db00a6d5976250e853022a428eef975f","194b426a8e64efc6ecc1a1608caa50fa8594cdd296d76ba657801fc8eac03dfa","c0142ee42ebbc20aceb053a23517efb4c5e7ecd1fa0105efae3986967d3f7f50","651fe882431ed1b103c090913076749a0c2625c0c1dcbf6ceca8f584b89a0506","407b9cfb038a4c08d2d2fb28b25f64a57de05e763b101969a3c9b0b579820464","949ff38313aadd51ff8d0fa46a0b087e9f9f3d1f9d8dd2cf644dc612490b8827","4f22b3f3f623ed7ecc4c5321db916f8e5d7d2d8361dc97f17c84ec2ffeab937b","b446a4a0a05dcaebe57ae81bf8d2707ef6ee1c433e21525e55d4d770f12b90e4","808f5000ef16c3a9ebbef0e4839a66b4ae68c58cc9032fc815b23aa77e080be9","019619971bdd6bf299dad52c19146c551b64880d7494416a93963d5a4d2b365c","244c08033964980e2cfc24c33bfa2bd74c6db27158e9f029be0c8527924a705e","6ff40ba8b0e1c08542eb5475b976ca6b4b9392c0cccac089cb99e955a8d0f0ba","8efadf38d0177cd9d0df7febfe33c48028bd15e5023a2f5699e49e02d3f4c825","1c063a0a23900522dfb3bd1a203c0635c40b19646a272b2058ab1fe8805dee74","63d8f6e98d8e6460d464ef93a65e372928cc8fc796ff85de28ec48a140368b2d","bfd11cc15403bfeefbee8a5b9dfcf297fe2dbf8d0b05790f05b4bfb8eb2edcc0","a3d1893299459482e3554d1235d3c9685638cf1d714d5b2f97f5493c47151ce8","fdf4bc2764e425f6f793cdad90a6e7bd365b9f5e19d67c07be8eb1427dc5b2d4","adaa52dff510284475061f9eac2d4c2cbbed8df6ef776e7edaeb8bbda4677020"],"paragraph_range_zero_based":[23232,23255],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p23232"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Enables simultaneous SR and PUSCH transmissions in different PUCCH groups (see TS 38.321 [3], clause 5.4.1, clause 5.4.4).","paragraph_zero_based":23256},{"literal_text_all_w_t_and_m_t":"sizeDCI-2-6","paragraph_zero_based":23257},{"literal_text_all_w_t_and_m_t":"Size of DCI format 2-6 (see TS 38.213 [13], clause 10.3).","paragraph_zero_based":23258},{"literal_text_all_w_t_and_m_t":"sp-CSI-RNTI","paragraph_zero_based":23259},{"literal_text_all_w_t_and_m_t":"RNTI for Semi-Persistent CSI reporting on PUSCH (see CSI-ReportConfig) (see TS 38.214 [19], clause 5.2.1.5.2). Network always configures the UE with a value for this field when at least one CSI-ReportConfig with reportConfigType set to semiPersistentOnPUSCH is configured.","paragraph_zero_based":23260},{"literal_text_all_w_t_and_m_t":"tpc-PUCCH-RNTI","paragraph_zero_based":23261},{"literal_text_all_w_t_and_m_t":"RNTI used for PUCCH TPC commands on DCI (see TS 38.213 [13], clause 10.1).","paragraph_zero_based":23262},{"literal_text_all_w_t_and_m_t":"tpc-PUSCH-RNTI","paragraph_zero_based":23263},{"literal_text_all_w_t_and_m_t":"RNTI used for PUSCH TPC commands on DCI (see TS 38.213 [13], clause 10.1).","paragraph_zero_based":23264},{"literal_text_all_w_t_and_m_t":"tpc-SRS-RNTI","paragraph_zero_based":23265},{"literal_text_all_w_t_and_m_t":"RNTI used for SRS TPC commands on DCI (see TS 38.213 [13], clause 10.1).","paragraph_zero_based":23266},{"literal_text_all_w_t_and_m_t":"twoQCLTypeDforPDCCHRepetition","paragraph_zero_based":23267},{"literal_text_all_w_t_and_m_t":"Indicates whether a UE is expected UE to identify and monitor two QCL-TypeD properties for multiple overlapping CORESETs in the case of PDCCH repetition.","paragraph_zero_based":23268},{"literal_text_all_w_t_and_m_t":"uci-MuxWithDiffPrio, uci-MuxWithDiffPrio-secondaryPUCCHgroup","paragraph_zero_based":23269},{"literal_text_all_w_t_and_m_t":"When configured, enables multiplexing a high-priority (HP) HARQ-ACK UCI and a low-priority (LP) HARQ-ACK UCI into a PUCCH or PUSCH for the primary PUCCH group and the secondary PUCCH group, respectively.","paragraph_zero_based":23270},{"literal_text_all_w_t_and_m_t":"ul-TotalDAI-Included","paragraph_zero_based":23271},{"literal_text_all_w_t_and_m_t":"Indicates whether the total DAI fields of the additional PDSCH group is included in the non-fallback UL grant DCI (see TS 38.212 [17], clause 7.3.1). The network configures this only when enhanced dynamic codebook is configured (pdsch-HARQ-ACK-Codebook is set to enhancedDynamic).","paragraph_zero_based":23272},{"literal_text_all_w_t_and_m_t":"xScale","paragraph_zero_based":23273},{"literal_text_all_w_t_and_m_t":"The UE is allowed to drop NR only if the power scaling applied to NR results in a difference between scaled and unscaled NR UL of more than xScale dB (see TS 38.213 [13]). If the value is not configured for dynamic power sharing, the UE assumes default value of 6 dB.","paragraph_zero_based":23274},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23275},{"literal_text_all_w_t_and_m_t":"MulticastConfig field descriptions","paragraph_zero_based":23276},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-CodebookListMulticast","paragraph_zero_based":23277},{"literal_text_all_w_t_and_m_t":"A list of configurations for one or two HARQ-ACK codebooks for MBS multicast. Each configuration in the list is defined in the same way as pdsch-HARQ-ACK-Codebook (see TS 38.212 [17], clause 7.3.1.2.2 and TS 38.213 [13], clauses 7.2.1, 9.1.2, 9.1.3 and 9.2.1). If this field is present, the field pdsch-HARQ-ACK-Codebook is ignored. If this field is present, the value of this field is applied for primary PUCCH group and for secondary PUCCH group (if configured).","paragraph_zero_based":23278},{"literal_text_all_w_t_and_m_t":"type1CodebookGenerationMode","paragraph_zero_based":23279}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["1a5ee6530996ebd03074e6e40b73cf7fba367d962b15bae3243ea210ea4b689b","ddfa4e7989886766140ae11895b19a4ff4ee3967aa1d6ff2755b1fc96a95aebf","996945633ba0dee62cc3dc45bdbd9c916339055f54608f2f5619f78e219f657a","779b1a492867ca40e074dde8514bf98b9b7f1e7ecb06373adadec365ff513b40","11a3cf08b8593107eac5d1796339be6dc0e900dc3a513560af21ec959eac9313","792dedbf21e1ba40d695583160b700cf234dcbfb57da6d005e4655bb6bee5307","ed2e89ece6f896c409d4675fcdfec7bb74ce3072cfd1b6e52a822906247a78cd","bf7a59a75070f3d914c119ff216118acdd321afb57b16f7e8e452d47b2ea44ec","277d5eab93dba966d246265c7c83c97c3fe3ea4b5d11b8dea083653bfe2fc1bd","a46d4b47464417505fb63a4ebbb6767e3ef62fdaf2644b39b6a8f4495d6e5abb","5fc1cb8d8cf161c23da080039fcfb0a58f002b5566abb1ce0d77f6b8acba3e57","e64cc05e30a2607e5c207ddce285f36fea06b8ae1404aa2656f141502cb46ef3","95988be39749f5dd92e2ba6dceea6bfa1b9131aabfb3770c215f17396e3b7203","1868b3eaf8372dadb9c8faaf090ce29f088089e1f02dfe64449e240542a5000e","ff573a7cafa53011e6308039ffc98775c25d3b3043e14db1c14e93fa7f459697","20310fdc8b902c82bbd3ef92cb8e3f6bde96557f9da9568e46bbef2ac1046ebe","78c800e57640b2aa90dbcd2fd51b58a325aada7f9c186616b208b41df3b1bb8a","707d366b6195b24115f623fd2d914601581efd3ed810cc4b42c2a73f433f6fb8","8521c9f9e01df02e6b9b2a6f118db48ed1f597a1c683a338f5bfbb599666678d","9661c71d7c0455964d0d0c5ebae1e8abf8a4dbffb419e4933cc6a4ad291e4806","7c3394068b0994d19a958e7b817b98662b13ac44e83a5998b8b24bc20571996d","b2faefc9c93b013bb9ba25d85c0f056c1d5be3f36cb445072f6dd197427d4591","4a0120437f7c4d356bee1593858b8e3064556407f3d35dc39cfb887082b07de0","76bb4d41d14515d06d67a36951e1bd8942aea8da0b11a9c1cd92e491559e795e"],"paragraph_range_zero_based":[23256,23279],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p23256"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the mode of Type-1 HARQ-ACK codebook generation, as specified in TS 38.213 [13]. Mode 1 is based on the k1 values that are in the intersection of K1 set for unicast and K1 set for multicast. Mode 2 is based on the k1 values that are in the union of K1 set for unicast and K1 set for multicast.","paragraph_zero_based":23280},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23281},{"literal_text_all_w_t_and_m_t":"PDSCH-HARQ-ACK-EnhType3 field descriptions","paragraph_zero_based":23282},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-EnhType3CBG","paragraph_zero_based":23283},{"literal_text_all_w_t_and_m_t":"When configured, the DCI format 1_1 or DCI format 1_2 can request the UE to include CBG level A/N for each CC with CBG level transmission configured of the enhanced Type 3 HARQ-ACK codebook. When not configured, the UE will report TB level A/N even if CBG level transmission is configured for a CC.","paragraph_zero_based":23284},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-EnhType3NDI","paragraph_zero_based":23285},{"literal_text_all_w_t_and_m_t":"When configured, the DCI format 1_1 or DCI format 1_2 can request the UE to include NDI for each A/N reported of the enhanced Type 3 HARQ-ACK codebook.","paragraph_zero_based":23286},{"literal_text_all_w_t_and_m_t":"perCC","paragraph_zero_based":23287},{"literal_text_all_w_t_and_m_t":"Configures enhanced Type 3 HARQ-ACK codebook using per CC configuration.","paragraph_zero_based":23288},{"literal_text_all_w_t_and_m_t":"perHARQ, perHARQ-Ext","paragraph_zero_based":23289},{"literal_text_all_w_t_and_m_t":"Configures enhanced Type 3 HARQ-ACK codebook using per HARQ process and CC configuration. perHARQ-Ext is present only when nrofHARQ-ProcessesForPDSCH-v1700 is present in pdsch-ServingCellConfig of at least one serving cell in the PUCCH group. If perHARQ-Ext is present, the UE ignores perHARQ.","paragraph_zero_based":23290},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23291},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":23292},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":23293},{"literal_text_all_w_t_and_m_t":"MCG-Only","paragraph_zero_based":23294},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, in the PhysicalCellGroupConfig of the MCG. It is absent otherwise. ","paragraph_zero_based":23295},{"literal_text_all_w_t_and_m_t":"SCG-Only","paragraph_zero_based":23296},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need S, in the PhysicalCellGroupConfig of the SCG in (NG)EN-DC as defined in TS 38.213 [13]. It is absent otherwise.","paragraph_zero_based":23297},{"literal_text_all_w_t_and_m_t":"twoPUCCHgroup","paragraph_zero_based":23298},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, if secondary PUCCH group is configured. It is absent otherwise, Need R. ","paragraph_zero_based":23299},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23300},{"literal_text_all_w_t_and_m_t":"–PLMN-Identity","paragraph_zero_based":23301},{"literal_text_all_w_t_and_m_t":"The IE PLMN-Identity identifies a Public Land Mobile Network. Further information regarding how to set the IE is specified in TS 23.003 [21].","paragraph_zero_based":23302},{"literal_text_all_w_t_and_m_t":"PLMN-Identity information element","paragraph_zero_based":23303}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["ef69847d5f86cf35b3c7ce685b8e3af97c97bee9f144307171d80d0318a71621","9fcf11bde60a67d540cbd3bc23b11d09c4e7ca362f3b844aa5defe567fd5afda","83ee7df8abad66c12d27529631150761439249a440539befe253588dce331e97","c7e55a9452c9f391680cf56bbef745af9c79778f83ecaa1f660b8f4540b672fa","5dc31a74f3693aa480b9089de1f2eca5d8b6e3d26cd6951eb15002c12c31c3a3","e69ec70814f6d26e1d8db1389a28080f13719ae1e610bf0b7e29f1e47dd3c671","6e14870f5f85699ee2bd635d732fdc3ed9346ce0e7b17c66d560b1e191feeea7","4e7e5875ebd6745612a3cd80dd658fcf84650f50aed3df4efe7e6c7166805a95","e4e7ed262d4222ce253a6034acfbbb35c7250dedabad795f78c1ed9510ad6e9d","60e4c0b01b3e9057b92aa8dc8aa1e3702c6385b7ccb510864d917b14ee84206b","7b76f7ea42298081bc0704c99780d0bca54f7daf5de897c7f0dc66ab33280eeb","f2adc2c69af22d823cf616302a92e7e38dc5c800ca1b17d56dcd94b97a8c126d","996afe4aee26c195dc17873069f8fd86d37f5b2d77293bca21f43abc3a8eeb50","1a0bf335315b85be521d7bc6552c63cbd097341e18777fac9c6308625fc2e425","72fe0cddf5ccd3f1447c57da1312cd892127101ebb57bcc32544d9b90b15a292","b68d1ff9b19eed92b5005802c6e369ced51ff2ccc042f715a79488d68a628b9b","6c2da33bb07a27474662752d2e8d7e7b2ba735798cc1d59c5181767d352982b2","d344178853f10900d8614ee2a8920b73a78480e569d393e5a1fa72196fa6aa1c","956da2413c2fc3ee89c24f2b3315b534f74d03e4540bc11915d37ac1d5274ebf","41016ce7f29851d7ef3796752185de19615b0b23290a7474883c75739c12f011","85bec18ee546604e7a76089f79a98e5bc1cd1982e3034d4841bfded01153c291","eb5cddbc65e247b6129a4dea05932063bd82a5d5df7b84f1462b6b8458f5b41f","96bb2aec54bb59e702a31c59228c71a7afb49b7e69e08f8a49f39d751c739049","d5e4b2d0af36ea749c58a6cbc60b29ad65b0aef5007f267e829d792c3bed6bbc"],"paragraph_range_zero_based":[23280,23303],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p23280"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":23304},{"literal_text_all_w_t_and_m_t":"-- TAG-PLMN-IDENTITY-START","paragraph_zero_based":23305},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23306},{"literal_text_all_w_t_and_m_t":"PLMN-Identity ::=                   SEQUENCE {","paragraph_zero_based":23307},{"literal_text_all_w_t_and_m_t":"    mcc                                 MCC                 OPTIONAL,                   -- Cond MCC","paragraph_zero_based":23308},{"literal_text_all_w_t_and_m_t":"    mnc                                 MNC","paragraph_zero_based":23309},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":23310},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23311},{"literal_text_all_w_t_and_m_t":"MCC ::=                             SEQUENCE (SIZE (3)) OF MCC-MNC-Digit","paragraph_zero_based":23312},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23313},{"literal_text_all_w_t_and_m_t":"MNC ::=                             SEQUENCE (SIZE (2..3)) OF MCC-MNC-Digit","paragraph_zero_based":23314},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23315},{"literal_text_all_w_t_and_m_t":"MCC-MNC-Digit ::=                   INTEGER (0..9)","paragraph_zero_based":23316},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23317},{"literal_text_all_w_t_and_m_t":"-- TAG-PLMN-IDENTITY-STOP","paragraph_zero_based":23318},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23319},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23320},{"literal_text_all_w_t_and_m_t":"PLMN-Identity field descriptions","paragraph_zero_based":23321},{"literal_text_all_w_t_and_m_t":"mcc","paragraph_zero_based":23322},{"literal_text_all_w_t_and_m_t":"The first element contains the first MCC digit, the second element the second MCC digit and so on. If the field is absent, it takes the same value as the mcc of the immediately preceding IE PLMN-Identity. See TS 23.003 [21].","paragraph_zero_based":23323},{"literal_text_all_w_t_and_m_t":"mnc","paragraph_zero_based":23324},{"literal_text_all_w_t_and_m_t":"The first element contains the first MNC digit, the second element the second MNC digit and so on. See TS 23.003 [21].","paragraph_zero_based":23325},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23326},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":23327}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["410e686e55e9d30deeaa4ffb07dd2eaf1b7c2dfc3303aef64975b74ff7b55a0b","75fa4a1bb83d843dc17cccdbccaaacfd4f31aae6b2201f3b42c0099c6052e639","0ecfe65483a3bf4a9d1803b859b4c50203d17f3725021b4a8e20f5f9f0a815b1","a0339311998d8c5990230793271690afbccca43a402f6b9248f8c89320ed89a4","d482791e1b9ba45f2c5ae85b8645d7b520278c88c842fbd7c8e47d8267a7cf9b","f3910931c8620faf6a9f3c5d8159c0cb3e2b764f908e0e1dee9182f6c856d686","92a414439ac271da0510a10baec9741f23fdf27e185bc7215872a75b43a5cf6c","431d06d7965ba2dc8e36de63db3dbef7dea0eba4a266dfae228cf5bee295a1d2","f2a0c882cc12d3a298bbecf8b4aa6ace9de5b82f8f2bfcf1a475c67a29109eee","e5843d90d7e1729e86c3fa211f12e47689ebd7acb785d6c832ab8ff529097385","75b8e5731fb9750c3196070839545319fd1391cd038c17b5d857f91ca66dede3","cb7ab04321c6c97ec2d42dd181e05e83b776aba25d9816f94ba672d796956e77","9e1cf818ab2f9c7a67d34a677f495e171ae8472cbf1df65ecbffc3057f84291a","d0bd6f90e3600bab2c03a80b17293d7f5ba4ac49906e5ebb1a75e57bc192b553","e64431ac3c6a45d0f1d6ca11a9d9f79f801bd4ddd64afe6be80f74d86a6f4c08","953813df1171509d3f801cb64887cfdf2b7a2317dd73458c168e67d718dd