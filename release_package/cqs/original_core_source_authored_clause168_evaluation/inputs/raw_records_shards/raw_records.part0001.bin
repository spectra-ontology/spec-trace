{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26328},{"literal_text_all_w_t_and_m_t":"RxTxReportInterval-r17 ::= ENUMERATED {ms80,ms120,ms160,ms240,ms320,ms480,ms640,ms1024,ms1280,ms2048,ms2560,ms5120,spare4,spare3,spare2,spare1}","paragraph_zero_based":26329},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26330},{"literal_text_all_w_t_and_m_t":"MeasTriggerQuantityCLI-r16 ::=              CHOICE {","paragraph_zero_based":26331},{"literal_text_all_w_t_and_m_t":"    srs-RSRP-r16                                SRS-RSRP-Range-r16,","paragraph_zero_based":26332},{"literal_text_all_w_t_and_m_t":"    cli-RSSI-r16                                CLI-RSSI-Range-r16","paragraph_zero_based":26333},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":26334},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26335},{"literal_text_all_w_t_and_m_t":"MeasReportQuantityCLI-r16 ::=               ENUMERATED {srs-rsrp, cli-rssi}","paragraph_zero_based":26336},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26337},{"literal_text_all_w_t_and_m_t":"-- TAG-REPORTCONFIGNR-STOP","paragraph_zero_based":26338},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26339},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26340},{"literal_text_all_w_t_and_m_t":"CondTriggerConfig field descriptions","paragraph_zero_based":26341},{"literal_text_all_w_t_and_m_t":"a3-Offset","paragraph_zero_based":26342},{"literal_text_all_w_t_and_m_t":"Offset value(s) to be used in NR conditional reconfiguration triggering condition for cond event a3. The actual value is field value * 0.5 dB.","paragraph_zero_based":26343},{"literal_text_all_w_t_and_m_t":"a4-Threshold","paragraph_zero_based":26344},{"literal_text_all_w_t_and_m_t":"Threshold value associated to the selected trigger quantity (e.g. RSRP, RSRQ, SINR) per RS Type (e.g. SS/PBCH block, CSI-RS) to be used in NR conditional reconfiguration triggering condition for cond event a4.","paragraph_zero_based":26345},{"literal_text_all_w_t_and_m_t":"a5-Threshold1/ a5-Threshold2","paragraph_zero_based":26346},{"literal_text_all_w_t_and_m_t":"Threshold value associated to the selected trigger quantity (e.g. RSRP, RSRQ, SINR) per RS Type (e.g. SS/PBCH block, CSI-RS) to be used in NR conditional reconfiguration triggering condition for cond event a5. In the same condeventA5, the network configures the same quantity for the MeasTriggerQuantity of the a5-Threshold1 and for the MeasTriggerQuantity of the a5-Threshold2.","paragraph_zero_based":26347},{"literal_text_all_w_t_and_m_t":"condEventId","paragraph_zero_based":26348},{"literal_text_all_w_t_and_m_t":"Choice of NR conditional reconfiguration event triggered criteria.","paragraph_zero_based":26349},{"literal_text_all_w_t_and_m_t":"distanceThreshFromReference1, distanceThreshFromReference2","paragraph_zero_based":26350},{"literal_text_all_w_t_and_m_t":"Distance from a reference location configured with referenceLocation1 or referenceLocation2. Each step represents 50m.","paragraph_zero_based":26351}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["b1394f37eea14e5ebb6f6b50815c6908b0583815dfa0d54a77299f7e1c827384","95584a621fb9fee08104fa35eedb784616faa34cd962250aa36f8ff4012c62c7","0d5a452b94531ba52c64aab7d6320aac2770fb6d07f994921d9c80645cfa0428","14f3a34f7e05c5f4821d97cfa502fea8ab70a908498be3f80a58915ae26dbf00","f13d704fb27ae628ccb9451632c9c16f52461ad91d2058889c3896864a28d961","38a710dbed4cd93e421a6f1c8cef345e5ab8a77d700555d80462ec1a72f43d4c","d6de24dd74805a3