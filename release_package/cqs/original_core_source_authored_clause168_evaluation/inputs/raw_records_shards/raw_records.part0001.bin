{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    pni-npn-r16                      SEQUENCE {","paragraph_zero_based":21168},{"literal_text_all_w_t_and_m_t":"        plmn-Identity-r16                PLMN-Identity,","paragraph_zero_based":21169},{"literal_text_all_w_t_and_m_t":"        cag-IdentityList-r16             SEQUENCE (SIZE (1..maxNPN-r16)) OF CAG-IdentityInfo-r16","paragraph_zero_based":21170},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":21171},{"literal_text_all_w_t_and_m_t":"    snpn-r16                         SEQUENCE {","paragraph_zero_based":21172},{"literal_text_all_w_t_and_m_t":"        plmn-Identity-r16                PLMN-Identity,","paragraph_zero_based":21173},{"literal_text_all_w_t_and_m_t":"        nid-List-r16                     SEQUENCE (SIZE (1..maxNPN-r16)) OF NID-r16","paragraph_zero_based":21174},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":21175},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21176},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21177},{"literal_text_all_w_t_and_m_t":"CAG-IdentityInfo-r16 ::=         SEQUENCE {","paragraph_zero_based":21178},{"literal_text_all_w_t_and_m_t":"    cag-Identity-r16                 BIT STRING (SIZE (32)),","paragraph_zero_based":21179},{"literal_text_all_w_t_and_m_t":"    manualCAGselectionAllowed-r16    ENUMERATED {true}                         OPTIONAL   -- Need R","paragraph_zero_based":21180},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21181},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21182},{"literal_text_all_w_t_and_m_t":"NID-r16 ::=                      BIT STRING (SIZE (44))","paragraph_zero_based":21183},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21184},{"literal_text_all_w_t_and_m_t":"-- TAG-NPN-IDENTITY-STOP","paragraph_zero_based":21185},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21186},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21187},{"literal_text_all_w_t_and_m_t":"NPN-Identity field descriptions","paragraph_zero_based":21188},{"literal_text_all_w_t_and_m_t":"cag-Identity","paragraph_zero_based":21189},{"literal_text_all_w_t_and_m_t":"A CAG-ID as specified in TS 23.003 [21]. The PLMN ID and a CAG ID in the NPN-Identity identifies a PNI-NPN.","paragraph_zero_based":21190},{"literal_text_all_w_t_and_m_t":"cag-IdentityList","paragraph_zero_based":21191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["7ee097b4f089ca68240aab4e47f87c1500d704c6de5c6ffe850659ac1184367e","352493f16c1c2bff008b72886473bfbb3c70b8f1bdd4217f00f2655b911dd6f3","c5c5310a7fe91d6f001d70bd130a97a9a553c27eac5d7add56bb0aa1bb3c488b","1d439bcf21978b74dd1694abbb685b0c13d41dbd713239cbfbdd6d6d08ae0bec","c0b065f759da2c8a29b8b829a9ceefbea6d96b1e3b23c256f816ead59974a126","d8d965b5ec1260c205f829e79948e575caa7f29532a82da43f0ab5a78a0a59a6","ac34d8195852ceb19c9cd6555735bd973e75e3a2c0a39d6ea08198f85321963f","9ad4ba26fc9835d44a48ef252993f9699995e6bc393fdabc2849e9f3ea092678","4defc7ad1776b4e968c60c494d3dbaa327d04eee8a635596eccde940f92fb2cb","20ca6b6e8c0f4666cc2bd3c81b40fb852c06c20b74ffd972f6460bb83e87cdd4","26c0c60f9028db3f2554ffbc418796e0b695ac0f5a267b6c97d0716705003bad","20ebc420135067646f6d5bfbbb1b3054260cc6f4170522d117d97cdb863fb57d","aabcbb426b45c1fed0f241a375d1f7312fc4da1961ed1c7bdb9ecd229156b266","94f4be7bbbf420557869cde469a8a164a6516cdc6dea31e307e91261a9ea21ed","c776ce5992a1b62d540360560dbd914356e38405618c609d2ada2769c892a054","b94f7cab8deda7156d26fab0893ae0382a2f6bfabedbe33e204883d9