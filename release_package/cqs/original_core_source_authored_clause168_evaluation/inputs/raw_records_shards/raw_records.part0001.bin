{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    dedicatedInfoF1c-r17                DedicatedInfoF1c-r17                OPTIONAL,   -- Need N","paragraph_zero_based":9120},{"literal_text_all_w_t_and_m_t":"    rxTxTimeDiff-gNB-r17                RxTxTimeDiff-r17                    OPTIONAL,   -- Need N","paragraph_zero_based":9121},{"literal_text_all_w_t_and_m_t":"    ta-PDC-r17                          ENUMERATED {activate,deactivate}    OPTIONAL,   -- Need N","paragraph_zero_based":9122},{"literal_text_all_w_t_and_m_t":"    sib9Fallback-r17                    ENUMERATED {true}                   OPTIONAL,   -- Need N","paragraph_zero_based":9123},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                SEQUENCE {}                         OPTIONAL","paragraph_zero_based":9124},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":9125},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9126},{"literal_text_all_w_t_and_m_t":"-- TAG-DLINFORMATIONTRANSFER-STOP","paragraph_zero_based":9127},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":9128},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9129},{"literal_text_all_w_t_and_m_t":"DLInformationTransfer field descriptions","paragraph_zero_based":9130},{"literal_text_all_w_t_and_m_t":"rxTxTimeDiff-gNB","paragraph_zero_based":9131},{"literal_text_all_w_t_and_m_t":"Indicates the Rx-Tx time difference measurement at the gNB (see clause 5.2.3, TS 38.215 [9]). Upon receiving this field, the UE calculates the propagation delay based on the RTT-based PDC mechanism method as described in TS 38.300 [2]. The network does not configure this field, if the UE is configured with ta-PDC with value activate.","paragraph_zero_based":9132},{"literal_text_all_w_t_and_m_t":"sib9Fallback","paragraph_zero_based":9133},{"literal_text_all_w_t_and_m_t":"Indicates that the UE fallbacks to receive referenceTimeInfo in SIB9.","paragraph_zero_based":9134},{"literal_text_all_w_t_and_m_t":"ta-PDC","paragraph_zero_based":9135},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE-side TA-based propagation delay compensation (PDC) is activated or de-activated. The network does not configure this field with activate, if the field rxTxTimeDiff-gNB is configured.","paragraph_zero_based":9136},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9137},{"literal_text_all_w_t_and_m_t":"–DLInformationTransferMRDC","paragraph_zero_based":9138},{"literal_text_all_w_t_and_m_t":"The DLInformationTransferMRDC message is used for the downlink transfer of RRC messages during fast MCG link recovery.","paragraph_zero_based":9139},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB3","paragraph_zero_based":9140},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":9141},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":9142},{"literal_text_all_w_t_and_m_t":"Direction: Network to UE","paragraph_zero_based":9143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["e5549b972eb8c135fc2615b7976e5915340fac0815d2b9d61b68e6d964cf6a09","cce16984f7c4ebd3e5df586ffd60ed4489c6bc6034895778d6765ef97ec04a12","531b32f429baaa248af5ea0d500525576d1abbc6847384da452a40a68da45305","120d68e2e8c3c9ab5cc9ec3266c43895db72991b6c53fd1227d326dda06a9b74","e925f1908a6ee945b64d2da9d14e8297be49a32cd0deecb83cd63b38c0ae431b","793c5d419ee5acce34e22a33e20135480212cc92cfd64aeac1daff23f9edb919","23c7a933c555adb9da0865f639e5abdb757e7b60eb21e99ef8d1aa0215802ddd","ae5b2bb3cf5ad34a0449413f4eb532d2c34f895bd9d6b5121