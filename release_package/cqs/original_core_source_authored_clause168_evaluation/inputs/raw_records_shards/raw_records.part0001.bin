{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        sliceExcludedCellListNR-r17       SliceCellListNR-r17","paragraph_zero_based":18648},{"literal_text_all_w_t_and_m_t":"    }                                                                                                     OPTIONAL  -- Need R","paragraph_zero_based":18649},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18650},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18651},{"literal_text_all_w_t_and_m_t":"SliceCellListNR-r17 ::=           SEQUENCE (SIZE (1..maxCellSlice-r17)) OF PCI-Range","paragraph_zero_based":18652},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18653},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQPRIORITYLISTSLICING-STOP","paragraph_zero_based":18654},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18655},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18656},{"literal_text_all_w_t_and_m_t":"FreqPriorityListSlicing field descriptions","paragraph_zero_based":18657},{"literal_text_all_w_t_and_m_t":"dl-ImplicitCarrierFreq","paragraph_zero_based":18658},{"literal_text_all_w_t_and_m_t":"Indicates the downlink carrier frequency to which sliceInfoList is associated with. The frequency is signalled implicitly, value 0 corresponds to the serving frequency, value 1 corresponds to the first frequency indicated by the InterFreqCarrierFreqList in SIB4, and value 2 corresponds to the second frequency indicated by the InterFreqCarrierFreqList in SIB4, and so on.","paragraph_zero_based":18659},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18660},{"literal_text_all_w_t_and_m_t":"SliceInfo field descriptions","paragraph_zero_based":18661},{"literal_text_all_w_t_and_m_t":"sliceAllowedCellListNR","paragraph_zero_based":18662},{"literal_text_all_w_t_and_m_t":"List of allow-listed cells for slicing. If present, the cells listed in this list support the corresponding nsag-frequency pair, and the cells not listed in this list do not support the corresponding nsag-frequency pair, according to TS 38.304 [20], clause 5.2.4.11.","paragraph_zero_based":18663},{"literal_text_all_w_t_and_m_t":"sliceCellListNR","paragraph_zero_based":18664},{"literal_text_all_w_t_and_m_t":"Contains either the list of allow-listed or exclude-listed cells for slicing. If absent, it implies all the cells support the corresponding nsag-frequency pair, according to 38.304 [20], clause 5.2.4.11.","paragraph_zero_based":18665},{"literal_text_all_w_t_and_m_t":"sliceExcludedCellListNR","paragraph_zero_based":18666},{"literal_text_all_w_t_and_m_t":"List of exclude-listed cells for slicing. If present, the cells listed in this list do not support the corresponding nsag-frequency pair, and the cells not listed in this list support the corresponding nsag-frequency pair, according to TS 38.304 [20], clause 5.2.4.11.","paragraph_zero_based":18667},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18668},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":18669},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":18670},{"literal_text_all_w_t_and_m_t":"Mandatory","paragraph_zero_based":18671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["e76ba3d2a589d6d2b84f61d784b98a45c64c6cbd4db3035a73da240fe66e6ad6","1f497c2a181a05f5f21256b47713853fdbc930aa5e7abc6dd671a40e17839be5","8984ab1c892f9ed255e2f4dc4a356d16e432349f901198405aac00e062f21fbd","3e55a905bd031e968ec65593c8987f6aeb9051bfcad5abdc6da64466b568fd86","ff8029b752efdfe374816bc80abb4c0ecc96290e646d978027969dd3a0510262","d831fd249b5ecf4e93bfc2fed47efd0a2cd072196495158e0a483efcb7ef4cc3","cbae4b43a0e3f5ca6239b505f755680075e3a6e39e54157965144803ae66fa0e","81af89bc3546e724df6dd81c557ffcd588c7d3d4513abe4b347d2544b4b77f01","ef4c575f664b0a35b5ee019fc5dc552a2966e9794449588fc89244df170f5b23","703b7ca6ec9d734734cab987cfc37565a42d6b6800b1cb1c337ad48b289fd741","d04a725f4f61f13a4b6bcd8123a317073fe7057aa35756b294daa057198ffa4f","40e5c1e5daaf26a7033f160783456871ed5ad472cf9d060c4a77c16c8a363c04","0a1659d3611e567d493a2b80a6e638ddd2091a399e311b15a43ecce61a6e448e","f3e874c7f628ab9d0fa361f4bde4268e5cc2dad648d8fc134e11e30dbd651fac","1ed6c549b2d948ee70dd478d32a7dcfb2459fa923d4b167635e18ffdcac8829e","a098a087d588a423deb30b9bb6b8e296bb0f897244e97c343547b03702ee6e7e","88b814ba0a9e31985384657c34a7164667b7a4db084f14f288e3efe52cde96dc","bb8328641120f3686e8b6a528e4fb72e5e242bdac5feaa0f9be336b6f0498f66","f9724c239c61c5e6e7a1f8588ffa5e51d1835043f1006f89293c82b714ab1c86","ab6fe70d899224741c29896c2272c3427b261a5844e7032928d632770587f3a9","5076143ddd63abe5009c2578a939d0d96a25daac32eea4f3695052e4a83dd7dd","fc9910d7fe5042c0302bdbed366e420d1f4ba11923483036d813b4fa3258da77","96bc7e40d12fca21fd98e22c3974e3e6f3bc83a8de21e13ae6d6b9d77566541c","1c05efcbfe8cb351a59148265592df0bb3a4bbd9bcc80619458fa878cd20101f"],"paragraph_range_zero_based":[18648,18671],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p18648"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The field is mandatory present.","paragraph_zero_based":18672},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18673},{"literal_text_all_w_t_and_m_t":"–FrequencyInfoDL","paragraph_zero_based":18674},{"literal_text_all_w_t_and_m_t":"The IE FrequencyInfoDL provides basic parameters of a downlink carrier and transmission thereon.","paragraph_zero_based":18675},{"literal_text_all_w_t_and_m_t":"FrequencyInfoDL information element","paragraph_zero_based":18676},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18677},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQUENCYINFODL-START","paragraph_zero_based":18678},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18679},{"literal_text_all_w_t_and_m_t":"FrequencyInfoDL ::=                 SEQUENCE {","paragraph_zero_based":18680},{"literal_text_all_w_t_and_m_t":"    absoluteFrequencySSB                ARFCN-ValueNR                                                   OPTIONAL,   -- Cond SpCellAdd","paragraph_zero_based":18681},{"literal_text_all_w_t_and_m_t":"    frequencyBandList                   MultiFrequencyBandListNR,","paragraph_zero_based":18682},{"literal_text_all_w_t_and_m_t":"    absoluteFrequencyPointA             ARFCN-ValueNR,","paragraph_zero_based":18683},{"literal_text_all_w_t_and_m_t":"    scs-SpecificCarrierList             SEQUENCE (SIZE (1..maxSCSs)) OF SCS-SpecificCarrier,","paragraph_zero_based":18684},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":18685},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18686},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18687},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQUENCYINFODL-STOP","paragraph_zero_based":18688},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18689},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18690},{"literal_text_all_w_t_and_m_t":"FrequencyInfoDL field descriptions","paragraph_zero_based":18691},{"literal_text_all_w_t_and_m_t":"absoluteFrequencyPointA","paragraph_zero_based":18692},{"literal_text_all_w_t_and_m_t":"Absolute frequency position of the reference resource block (Common RB 0). Its lowest subcarrier is also known as Point A (see TS 38.211 [16], clause 4.4.4.2). Note that the lower edge of the actual carrier is not defined by this field but rather in the scs-SpecificCarrierList.","paragraph_zero_based":18693},{"literal_text_all_w_t_and_m_t":"absoluteFrequencySSB","paragraph_zero_based":18694},{"literal_text_all_w_t_and_m_t":"Frequency of the SSB to be used for this serving cell. SSB related parameters (e.g. SSB index) provided for a serving cell refer to this SSB frequency unless mentioned otherwise. The CD-SSB of the PCell is always on the sync raster. Frequencies are considered to be on the sync raster if they are also identifiable with a GSCN value (see TS 38.101-1 [15] or TS 38.101-5 [75]). If the field is absent, the SSB related parameters should be absent, e.g. ssb-PositionsInBurst, ssb-periodicityServingCell and subcarrierSpacing in ServingCellConfigCommon IE. If the field is absent, the UE obtains timing reference from the SpCell or an SCell if applicable as described in TS 38.213 [13], clause 4.1. This is only supported in case the SCell for which the UE obtains the timing reference is in the same frequency band as the cell (i.e. the SpCell or the SCell, respectively) from which the UE obtains the timing reference.","paragraph_zero_based":18695}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["83df4299468d46d22a9294a3b2ae2cd5a094fc310c4bb2794c6983cbc78944e5","abb2a6b505bc169db26e1436ba91f5a160a513233125380267c90e6258692eb8","62e4ebc24d1c5f189d2d89b2655f6644d938229f54eb622147fe0c097d922d76","0bc08b50b59d1ff44c3db8190c0473b0ad8f7d33827b6453781110a7aa3fefab","ba001715b24ca98f66e6fa40a742cd9bd4fc48042bd846b3205d3851b78b64bd","b1d44298055af7a3b3f5a2d322c56ce49ba4acbcf2fc9b23ab21b3bd4950f0dd","6dfc87d9475fc803ee08fdd9144287a7eba70e92c57492a31dff9abb45c5c146","d6a503e9a3e83a3e112d5949f03bf0d57dfe00936e1d30a5ddd83f073537ebe5","77b98fe54d0306632dbec2704cfce5f5c64c7cf354f4538ab8f8e09635494847","8940fd41142ceb353943d27f9491d87404cee21f9d43a537b72cb06c00529c41","7cc7130cf649c6fdb26c7655ab3d66aac7ca85501d3903e095611c987d60faa1","7d2d063823f5a68a5ab1fe9f2ee75f48523f718f34171a0338bcdeac604ac9b1","45522b895ef2879d06a73e26414c591f2babe1b2d78234335c7e04a27123beeb","c20a19d1bffde8e08f5e86f5bfa933ede6b24fe509528bd81c3452eb17221be9","a614a752fa0fe357dde9786f870430ec1725c8f0577cb3dcb5c1abc9528cf061","49a726afb3076978a2da31325c70a8f433a80f5ed9b482201fd618f973480f00","2d045d0e43613c5714b00bd05f4dd17257952c56bbc43c116bef76daa8a49d30","af457edfd37f3ab8d16ca9a084f73026716c3a61dbfd05e2a8661401754daa02","830ea8c1b387fe4051258a7e76ddada4ea2b9c32cf259244060517fd2c09a1bd","ba5e5bbdd13915b872cde99c96f0d1dbd0ccb96365027e4d19b21426bff8383d","63b3679828c145c103e5444ba24063db873150c53d2fd1de5e5af21a1733686a","c777edc57953ea308d7733bb140d5028a43299ac714714f409bdb7269d7aca6e","a37b2ee7da9c6a97dbf5bc0700e2f67f40d2b803038374115685add637581386","798bce5522ca1f0b552391414792d7a9885773e166c29635f4f98d8dd8eea3de"],"paragraph_range_zero_based":[18672,18695],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p18672"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"For cells supporting RedCap, this field corresponds to the CD-SSB.","paragraph_zero_based":18696},{"literal_text_all_w_t_and_m_t":"frequencyBandList","paragraph_zero_based":18697},{"literal_text_all_w_t_and_m_t":"List containing only one frequency band to which this carrier(s) belongs. Multiple values are not supported.","paragraph_zero_based":18698},{"literal_text_all_w_t_and_m_t":"scs-SpecificCarrierList","paragraph_zero_based":18699},{"literal_text_all_w_t_and_m_t":"A set of carriers for different subcarrier spacings (numerologies). Defined in relation to Point A. The network configures a scs-SpecificCarrier at least for each numerology (SCS) that is used e.g. in a BWP (see TS 38.211 [16], clause 5.3).","paragraph_zero_based":18700},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18701},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":18702},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":18703},{"literal_text_all_w_t_and_m_t":"SpCellAdd","paragraph_zero_based":18704},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if this FrequencyInfoDL is for SpCell. Otherwise the field is optionally present, Need S.","paragraph_zero_based":18705},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18706},{"literal_text_all_w_t_and_m_t":"–FrequencyInfoDL-SIB","paragraph_zero_based":18707},{"literal_text_all_w_t_and_m_t":"The IE FrequencyInfoDL-SIB provides basic parameters of a downlink carrier and transmission thereon.","paragraph_zero_based":18708},{"literal_text_all_w_t_and_m_t":"FrequencyInfoDL-SIB information element","paragraph_zero_based":18709},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18710},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQUENCYINFODL-SIB-START","paragraph_zero_based":18711},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18712},{"literal_text_all_w_t_and_m_t":"FrequencyInfoDL-SIB ::=             SEQUENCE {","paragraph_zero_based":18713},{"literal_text_all_w_t_and_m_t":"    frequencyBandList                   MultiFrequencyBandListNR-SIB,","paragraph_zero_based":18714},{"literal_text_all_w_t_and_m_t":"    offsetToPointA                      INTEGER (0..2199),","paragraph_zero_based":18715},{"literal_text_all_w_t_and_m_t":"    scs-SpecificCarrierList             SEQUENCE (SIZE (1..maxSCSs)) OF SCS-SpecificCarrier","paragraph_zero_based":18716},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18717},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18718},{"literal_text_all_w_t_and_m_t":"FrequencyInfoDL-SIB-v1760 ::=       SEQUENCE {","paragraph_zero_based":18719}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["9906dfb7e15695223db504e54723017ddce44100c7b7a3f2c3d5180a45fcad05","3fe8cdb061beabce9b18a96d7ef4b41d3d6ca46a00e14ddbf813c0387aa916ea","cf9c6a1f5200ceba9ece5557eaeaa683a61f059c56d1988909faec56ad80e06d","959dba0dbd6102001779385276b750f2ae2fe8d1917f9741170d4f9f4b194c19","e148573292d8d39294d4e3a61b4e6b0414bbcd3cad5b484564df07bc02ce8d13","b2409e5ec6c7a164ab56c644fa92646204b59be427741b2e264a462fc703a2d1","05f4a48a39f29a0c9562fb6cb480d584064459c50c3c39963065f35db8d0594e","58b3a58fa603c2e0ea2692d8084b95101511e7bc343ebe1e680444501cd55ffb","a56120d6914224bdb17d0c4f561742892f0f78e657c9398bb7e373bc919aa457","59f2f718def9cbb79d72ff1bbcea0d4e88a770fc2e8e411a18fd3c002eb40653","c272417da5e75d21b0a86ee2fcd08cf391436f70ef4315857d357541c12e9dd6","44d92936492f1d604904b433066c7200c75c9c4ce5fd53a7afa5029526b5