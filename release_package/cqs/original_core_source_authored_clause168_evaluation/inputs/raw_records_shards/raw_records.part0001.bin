{"fields":{"filename":"R2-2401316.zip::R2-2401316 BLE.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field provides the UTC time when the Bluetooth measurements are performed and should take the form of YYMMDDhhmmssZ.","paragraph_zero_based":384},{"literal_text_all_w_t_and_m_t":"bt-MeasurementList","paragraph_zero_based":385},{"literal_text_all_w_t_and_m_t":"This field provides the Bluetooth measurements for up to 32 Bluetooth beacons.","paragraph_zero_based":386},{"literal_text_all_w_t_and_m_t":"btAddr","paragraph_zero_based":387},{"literal_text_all_w_t_and_m_t":"This field specifies the Bluetooth public address of the Bluetooth beacon [25].","paragraph_zero_based":388},{"literal_text_all_w_t_and_m_t":"rssi","paragraph_zero_based":389},{"literal_text_all_w_t_and_m_t":"This field provides the beacon received signal strength indicator (RSSI) in dBm.","paragraph_zero_based":390},{"literal_text_all_w_t_and_m_t":"bt-azimuth","paragraph_zero_based":391},{"literal_text_all_w_t_and_m_t":"This field represents the estimated AoD azimuth in GCD relative the Bluetooth beacon reference position.","paragraph_zero_based":392},{"literal_text_all_w_t_and_m_t":"bt-elevation","paragraph_zero_based":393},{"literal_text_all_w_t_and_m_t":"This field represents the estimated AoD elevation in GCD relative the Bluetooth beacon reference position.","paragraph_zero_based":394},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":395},{"literal_text_all_w_t_and_m_t":"6.5.7.3Bluetooth Location Information Request","paragraph_zero_based":396},{"literal_text_all_w_t_and_m_t":"–BT-RequestLocationInformation","paragraph_zero_based":397},{"literal_text_all_w_t_and_m_t":"The IE BT-RequestLocationInformation is used by the location server to request Bluetooth measurements from a target device.","paragraph_zero_based":398},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":399},{"literal_tex