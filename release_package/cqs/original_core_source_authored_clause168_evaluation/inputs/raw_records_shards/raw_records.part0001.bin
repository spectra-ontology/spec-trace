ragraph_zero_based":14414},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14415},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14416},{"literal_text_all_w_t_and_m_t":"PosSIB-MappingInfo-r16 ::=   SEQUENCE (SIZE (1..maxSIB)) OF PosSIB-Type-r16","paragraph_zero_based":14417},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14418},{"literal_text_all_w_t_and_m_t":"PosSIB-Type-r16 ::=          SEQUENCE {","paragraph_zero_based":14419},{"literal_text_all_w_t_and_m_t":"    encrypted-r16                ENUMERATED { true }                                            OPTIONAL,  -- Need R","paragraph_zero_based":14420},{"literal_text_all_w_t_and_m_t":"    gnss-id-r16                  GNSS-ID-r16                                                    OPTIONAL,  -- Need R","paragraph_zero_based":14421},{"literal_text_all_w_t_and_m_t":"    sbas-id-r16                  SBAS-ID-r16                                                    OPTIONAL,  -- Cond GNSS-ID-SBAS","paragraph_zero_based":14422},{"literal_text_all_w_t_and_m_t":"    posSibType-r16               ENUMERATED { posSibType1-1, posSibType1-2, posSibType1-3, posSibType1-4, posSibType1-5, posSibType1-6,","paragraph_zero_based":14423}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["21c2282613c412ce4c93480327c818bdd1a3eb3caa023caf54374619fbf112ab","f96e46072eeaf7ee341857ad4eea82ed3a948382e450e6abfbf01a4dd58ca4c5","0c7556323e484c602c399e036f328c548de75f4fed70569f286e2896f7b2f3e3","8bccb674756ef315e24604bfa3213fcb298dbe1b17aa191a82ab32947b1ff152","645d033da3e462270d3ecdc94a491e44a284c1499c02da75cef5eabe8bdb5648","ec43a67d9303e4e44fd8a3b4863c291b90ba06e6bbfc5f50dea10b9bb778db73","5b5f7eaeefa7e73724b76f6