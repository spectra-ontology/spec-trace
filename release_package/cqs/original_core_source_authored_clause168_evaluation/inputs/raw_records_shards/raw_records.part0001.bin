{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        rank4-4                             SEQUENCE(SIZE(4)) OF PortIndex4                                 OPTIONAL    -- Need R","paragraph_zero_based":17064},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":17065},{"literal_text_all_w_t_and_m_t":"    portIndex2                          SEQUENCE{","paragraph_zero_based":17066},{"literal_text_all_w_t_and_m_t":"        rank1-2                             PortIndex2                                                      OPTIONAL,   -- Need R","paragraph_zero_based":17067},{"literal_text_all_w_t_and_m_t":"        rank2-2                             SEQUENCE(SIZE(2)) OF PortIndex2                                 OPTIONAL    -- Need R","paragraph_zero_based":17068},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":17069},{"literal_text_all_w_t_and_m_t":"    portIndex1                          NULL","paragraph_zero_based":17070},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":17071},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17072},{"literal_text_all_w_t_and_m_t":"PortIndex8::=                       INTEGER (0..7)","paragraph_zero_based":17073},{"literal_text_all_w_t_and_m_t":"PortIndex4::=                       INTEGER (0..3)","paragraph_zero_based":17074},{"literal_text_all_w_t_and_m_t":"PortIndex2::=                       INTEGER (0..1)","paragraph_zero_based":17075},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17076},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-REPORTCONFIG-STOP","paragraph_zero_based":17077},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17078},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17079},{"literal_text_all_w_t_and_m_t":"CSI-ReportConfig field descriptions","paragraph_zero_based":17080},{"literal_text_all_w_t_and_m_t":"carrier","paragraph_zero_based":17081},{"literal_text_all_w_t_and_m_t":"Indicates in which serving cell the CSI-ResourceConfig indicated below are to be found. If the field is absent, the resources are on the same serving cell as this report configuration.","paragraph_zero_based":17082},{"literal_text_all_w_t_and_m_t":"codebookConfig","paragraph_zero_based":17083},{"literal_text_all_w_t_and_m_t":"Codebook configuration for Type-1 or Type-2 including codebook subset restriction. Network can only configure one of codebookConfig, codebookConfig-r16 or codebookConfig-r17 to a UE. The network includes codebookConfig-v1730 only if codebookConfig-r17 is configured.","paragraph_zero_based":17084},{"literal_text_all_w_t_and_m_t":"cqi-BitsPerSubband","paragraph_zero_based":17085},{"literal_text_all_w_t_and_m_t":"This field can only be present if cqi-FormatIndicator is set to subbandCQI. If the field is configured with bits4, the UE uses 4-bit sub-band CQI. If the field is not present and cqi-FormatIndicator is set to subbandCQI, the UE uses 2-bit sub-band differential CQI.","paragraph_zero_based":17086},{"literal_text_all_w_t_and_m_t":"cqi-FormatIndicator","paragraph_zero_based":17087}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["cfe4701ddb96dfea211067ea6dad980744e095dc14b33fcd1fbf03b99929f650","8fb841ece6ac92f97454bd37e1dc2d64e8d81166451f2f0d7522d5d6eddee6c4","e366ad8a71fa8f20c6fbb62557487cf5effbea3fc2bb3309cee4afb6425feae4","ab1b19f4bff6f13cc013b976d4cc2e53c93eacd9123c1d0ebc71c88e89e6875a","d234138149e85ac2dbcbbe99faaa99e5151efd1da59b00e6e4574d5bd9ab0097","aa7cd0c69e4075078d342a74b31d246b9e1251bca26bc9cd7e8522b2d215b3ac","aced4bd7f72e0e9e74f33c2651a0644f04b3b3e949cfd2b7e09c08e994c68351","62fd3d465e964490d85a3a9c3e751070177e0113787cc53b9dc12d51904dca39","ba5e99719c2872c7858cb3456a54414c7de135bf693a82775634a8f06f1a8131","1b44eacaf9871e244d6d87008b4d7a74bda7ad09769598841965fbf406e02917","36dcf8a04c2cfd056a4dc5be220d731e764067561c638d54b27dd474dd8f6249","5cbd552a091f7004377fbfa3b87a0e77d98970dbd3d3a04472093c34f941c483","af190050f2db210471fd88739bd7bd9cc25519e572f6cdb8c8c493d579c71872","5c7e1b7f9bf475828519891009c61f4f08d1c44d33196d10737d0bc2ca9760ab","957fb7c9d17034bc3b9999556f5ce7819c1be7ded79da9281ac420c9c2bf57ed","bc0c38acbccc786758d32d063b296f9522ae1775d8bd4faa6a012a499b3ec373","baf3241c9ace2648d79399d8dbf4980827fb1cc8a252817628f3fb168a568af2","63131c09c8b6fe90a4ed8734b966e011e1bf70385ed22e2ae4141e7a105211b9","04feec536444a713acccefbda440fe63e24c481d9102b80dd03127e1321da2f6","7dc1e080b69ec5e978b68c2bf57912055f44af8a425283f8baa75c61912fad03","6209273d9fdf6d0a8e896f3ee5fecf5fe1363e2c7f7a5f7becd6fd068f8a6106","3dd338b34146550d8639aa60c1fe4a041b41c24e01c0cb090bb5ee9fe57f6a92","a54e111f6c65a2be11f7eacdf3d37cf78054e8e0a4fd61446581db149669fcc9","533e4f8ab9b07ec26c9db09afa5d45235f03d9fd27d19ce2cabec22b7b4bf4c3"],"paragraph_range_zero_based":[17064,17087],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p17064"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether the UE shall report a single (wideband) or multiple (subband) CQI (see TS 38.214 [19], clause 5.2.1.4).","paragraph_zero_based":17088},{"literal_text_all_w_t_and_m_t":"cqi-Table","paragraph_zero_based":17089},{"literal_text_all_w_t_and_m_t":"Which CQI table to use for CQI calculation (see TS 38.214 [19], clause 5.2.2.1). For a RedCap UE, CQI table 2 is only supported if the UE indicates support of 256QAM for PDSCH.","paragraph_zero_based":17090},{"literal_text_all_w_t_and_m_t":"csi-IM-ResourcesForInterference","paragraph_zero_based":17091},{"literal_text_all_w_t_and_m_t":"CSI IM resources for interference measurement. csi-ResourceConfigId of a CSI-ResourceConfig included in the configuration of the serving cell indicated with the field \"carrier\" above. The CSI-ResourceConfig indicated here contains only CSI-IM resources. The bwp-Id in that CSI-ResourceConfig is the same value as the bwp-Id in the CSI-ResourceConfig indicated by resourcesForChannelMeasurement.","paragraph_zero_based":17092},{"literal_text_all_w_t_and_m_t":"csi-ReportingBand","paragraph_zero_based":17093},{"literal_text_all_w_t_and_m_t":"Indicates a contiguous or non-contiguous subset of subbands in the bandwidth part which CSI shall be reported for. Each bit in the bit-string represents one subband. The right-most bit in the bit string represents the lowest subband in the BWP. The choice determines the number of subbands (subbands3 for 3 subbands, subbands4 for 4 subbands, and so on) (see TS 38.214 [19], clause 5.2.1.4). This field is absent if there are less than 24 PRBs (no sub band) and present otherwise (see TS 38.214 [19], clause 5.2.1.4).","paragraph_zero_based":17094},{"literal_text_all_w_t_and_m_t":"csi-ReportMode","paragraph_zero_based":17095},{"literal_text_all_w_t_and_m_t":"Configures the CSI report modes Mode1 or Mode 2 (see TS 38.214 [19], clause 5.2.1.4.2)","paragraph_zero_based":17096},{"literal_text_all_w_t_and_m_t":"csi-ReportSubConfigToAddModList","paragraph_zero_based":17097},{"literal_text_all_w_t_and_m_t":"List of CSI-ReportSubConfiguration(s) in a CSI report configuration to add or modify.","paragraph_zero_based":17098},{"literal_text_all_w_t_and_m_t":"csi-ReportSubConfigToReleaseList","paragraph_zero_based":17099},{"literal_text_all_w_t_and_m_t":"List of CSI-ReportSubConfiguration(s) in a CSI report configuration to release.","paragraph_zero_based":17100},{"literal_text_all_w_t_and_m_t":"dummy","paragraph_zero_based":17101},{"literal_text_all_w_t_and_m_t":"This field is not used in the specification. If received it shall be ignored by the UE.","paragraph_zero_based":17102},{"literal_text_all_w_t_and_m_t":"groupBasedBeamReporting","paragraph_zero_based":17103},{"literal_text_all_w_t_and_m_t":"Turning on/off group beam based reporting (see TS 38.214 [19], clause 5.2.1.4). If groupBasedBeamReporting (without suffix) is set to disabled, groupBasedBeamReporting-v1710 is absent.","paragraph_zero_based":17104},{"literal_text_all_w_t_and_m_t":"non-PMI-PortIndication","paragraph_zero_based":17105},{"literal_text_all_w_t_and_m_t":"Port indication for RI/CQI calculation. For each CSI-RS resource in the linked ResourceConfig for channel measurement, a port indication for each rank R, indicating which R ports to use. Applicable only for non-PMI feedback (see TS 38.214 [19], clause 5.2.1.4.2).","paragraph_zero_based":17106},{"literal_text_all_w_t_and_m_t":"The first entry in non-PMI-PortIndication corresponds to the NZP-CSI-RS-Resource indicated by the first entry in nzp-CSI-RS-Resources in the NZP-CSI-RS-ResourceSet indicated in the first entry of nzp-CSI-RS-ResourceSetList of the CSI-ResourceConfig whose CSI-ResourceConfigId is indicated in a CSI-MeasId together with the above CSI-ReportConfigId; the second entry in non-PMI-PortIndication corresponds to the NZP-CSI-RS-Resource indicated by the second entry in nzp-CSI-RS-Resources in the NZP-CSI-RS-ResourceSet indicated in the first entry of nzp-CSI-RS-ResourceSetList of the same CSI-ResourceConfig, and so on until the NZP-CSI-RS-Resource indicated by the last entry in nzp-CSI-RS-Resources in the in the NZP-CSI-RS-ResourceSet indicated in the first entry of nzp-CSI-RS-ResourceSetList of the same CSI-ResourceConfig. Then the next entry corresponds to the NZP-CSI-RS-Resource indicated by the first entry in nzp-CSI-RS-Resources in the NZP-CSI-RS-ResourceSet indicated in the second entry of nzp-CSI-RS-ResourceSetList of the same CSI-ResourceConfig and so on.","paragraph_zero_based":17107},{"literal_text_all_w_t_and_m_t":"nrofReportedGroups","paragraph_zero_based":17108},{"literal_text_all_w_t_and_m_t":"Number of reported resource groups per CSI-report. Value n1 means one resource group, n2 means 2 resource groups, and so on. If nrofReportedGroups is configured, the UE ignores groupBasedBeamReporting (without suffix).","paragraph_zero_based":17109},{"literal_text_all_w_t_and_m_t":"nrofReportedRS","paragraph_zero_based":17110},{"literal_text_all_w_t_and_m_t":"The number (N) of measured RS resources to be reported per report setting in a non-group-based report. N <= N_max, where N_max is either 2 or 4 depending on UE capability.","paragraph_zero_based":17111}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["5ee32cb241e5e7b93c0db1eea4b0e047477009009b6145863245eb6112b9ffec","937081e8e90c11f508fcb9c9489917c0d77b633c997c382f6e5837ab245d7d97","4e02200dcb37d9587f6b27e671425e570a1868d81eae83e8aeb1ea01ccd837c3","06f8a592563b093fd07c53c4a8efa1c99f8be4ce724e25b908ee60467befa2a2","e7a36415440295183fcbd6e5ae026b392aafaefbf2c7f6a6ae7d337a4cc327aa","0eeaf44ed645fcf7408d36d4f5f2a1f99790fe50666f2a43582224df54567873","2464423eca2392f72f62055f041f76b3cc6150b19a4baf0701bbe1092856b412","310b4071977938099b12c818b472a7e88680af5d0a4840c6befa2084ac0aab3f","54473d0ec0830c266a45067966786baa6505da4b8d699e3caf2a3cd2cc6fe10d","6b69b4cc7e2dc61928802a36359e23e3cb80b6946dbcaa4c5f60ca74eede6e40","e7133cd4b07ecd71d1eee02fd2d03000358d971d2f550143690e0210cc13ec92","e4855611409bd2685f9869a9fa8500597e6e8f905d7ebca26529a8244f725502","1c1326154b0da7b87551fb7b6a696d9849f14a5dbf98944d33ac6938bb16162f","18c37e74313bde8a826f81fb538750b833f1858659e0b43afe9649cc98e6b183","f0e7886c156d3ebca45fedfe50436149c96d0e3f236883de8019d20cea01c347","f0c29706574014a952c52ac160d73e3335a56828702becae01e08018b5f56a1a","ad2e7265ebfd39228cc4ceaf23ab6ea3854c0316dc6a4c72f809108b7b454bfd","45e8ccfc5596f72bca377c166ab2f8798a00ebc6b98827c9c7d2a2f1204939f0","d331336133b3fdddb1306cf2334078be90364ea7de18e218e2105b9ea50a0f14","457e55ff76a83829e3ead5b32273d810254dc13bf0356fc6707578f10323ea34","db6564229ed4c870a4d32d15ead8fe45965e4d89ddebc07df8d6fd5d13feccb6","b154f6ff6c500d2da6476ab6cf3a4433ad2973a84091a7a00b025bdf676a2692","3a1fdc7447239f15a370a2c2f87796084ef8b62dafe8bdbc3b987fe919f2cf57","8f8a513027b68ba6b8fa82761e5be6d7cb9dd3af7724e622bd933642f864bd40"],"paragraph_range_zero_based":[17088,17111],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p17088"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"(see TS 38.214 [19], clause 5.2.1.4) When the field is absent the UE applies the value 1.","paragraph_zero_based":17112},{"literal_text_all_w_t_and_m_t":"numberOfSingleTRP-CSI-Mode1","paragraph_zero_based":17113},{"literal_text_all_w_t_and_m_t":"Configures the number of reported X CSIs when csi-ReportMode is set to 'Mode 1' as described in TS 38.214 [19], clause 5.2.1.4.2. The field is present only if csi-ReportMode configures Mode 1.","paragraph_zero_based":17114},{"literal_text_all_w_t_and_m_t":"nzp-CSI-RS-ResourcesForInterference","paragraph_zero_based":17115},{"literal_text_all_w_t_and_m_t":"NZP CSI RS resources for interference measurement. csi-ResourceConfigId of a CSI-ResourceConfig included in the configuration of the serving cell indicated with the field \"carrier\" above. The CSI-ResourceConfig indicated here contains only NZP-CSI-RS resources. The bwp-Id in that CSI-ResourceConfig is the same value as the bwp-Id in the CSI-ResourceConfig indicated by resourcesForChannelMeasurement.","paragraph_zero_based":17116},{"literal_text_all_w_t_and_m_t":"p0alpha","paragraph_zero_based":17117},{"literal_text_all_w_t_and_m_t":"Index of the p0-alpha set determining the power control for this CSI report transmission (see TS 38.214 [19], clause 6.2.1.2).","paragraph_zero_based":17118},{"literal_text_all_w_t_and_m_t":"pdsch-BundleSizeForCSI","paragraph_zero_based":17119},{"literal_text_all_w_t_and_m_t":"PRB bundling size to assume for CQI calculation when reportQuantity is CRI/RI/i1/CQI. If the field is absent, the UE assumes that no PRB bundling is applied (see TS 38.214 [19], clause 5.2.1.4.2).","paragraph_zero_based":17120},{"literal_text_all_w_t_and_m_t":"pmi-FormatIndicator","paragraph_zero_based":17121},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE shall report a single (wideband) or multiple (subband) PMI. (see TS 38.214 [19], clause 5.2.1.4).","paragraph_zero_based":17122},{"literal_text_all_w_t_and_m_t":"pucch-CSI-ResourceList","paragraph_zero_based":17123},{"literal_text_all_w_t_and_m_t":"Indicates which PUCCH resource to use for reporting on PUCCH.","paragraph_zero_based":17124},{"literal_text_all_w_t_and_m_t":"reportConfigType","paragraph_zero_based":17125},{"literal_text_all_w_t_and_m_t":"Time domain behavior of reporting configuration.","paragraph_zero_based":17126},{"literal_text_all_w_t_and_m_t":"reportFreqConfiguration","paragraph_zero_based":17127},{"literal_text_all_w_t_and_m_t":"Reporting configuration in the frequency domain. (see TS 38.214 [19], clause 5.2.1.4).","paragraph_zero_based":17128},{"literal_text_all_w_t_and_m_t":"reportQuantity","paragraph_zero_based":17129},{"literal_text_all_w_t_and_m_t":"The CSI related quantities to report. see TS 38.214 [19], clause 5.2.1. If the field reportQuantity-r16 or reportQuantity-r17 is present, UE shall ignore reportQuantity (without suffix). Network does not configure reportQuantity-r17 together with reportQuantity-r16.","paragraph_zero_based":17130},{"literal_text_all_w_t_and_m_t":"reportSlotConfig","paragraph_zero_based":17131},{"literal_text_all_w_t_and_m_t":"Periodicity and slot offset (see TS 38.214 [19], clause 5.2.1.4). If the field reportSlotConfig-v1530 is present, the UE shall ignore the value provided in reportSlotConfig (without suffix).","paragraph_zero_based":17132},{"literal_text_all_w_t_and_m_t":"reportSlotOffsetList, reportSlotOffsetListDCI-0-1, reportSlotOffsetListDCI-0-2","paragraph_zero_based":17133},{"literal_text_all_w_t_and_m_t":"Timing offset Y for semi persistent reporting using PUSCH. This field lists the allowed offset values. This list must have the same number of entries as the pusch-TimeDomainAllocationList in PUSCH-Config. A particular value is indicated in DCI. The network indicates in the DCI field of the UL grant, which of the configured report slot offsets the UE shall apply. The DCI value 0 corresponds to the first report slot offset in this list, the DCI value 1 corresponds to the second report slot offset in this list, and so on. The first report is transmitted in slot n+Y, second report in n+Y+P, where P is the configured periodicity.","paragraph_zero_based":17134},{"literal_text_all_w_t_and_m_t":"Timing offset Y for aperiodic reporting using PUSCH. This field lists the allowed offset values. This list must have the same number of entries as the pusch-TimeDomainAllocationList in PUSCH-Config. A particular value is indicated in DCI. The network indicates in the DCI field of the UL grant, which of the configured report slot offsets the UE shall apply. The DCI value 0 corresponds to the first report slot offset in this list, the DCI value 1 corresponds to the second report slot offset in this list, and so on (see TS 38.214 [19], clause 6.1.2.1).","paragraph_zero_based":17135}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["2469d4fc7f1e42090f1bc18a220297d40431980ce94a92651b9cc2a5a63065ff","4a0009c85f6e20cafa635cbccb91f53806932c714b8f4f2cb12031b5fa156e00","2ae2cf4305df3dbb829846305e2283fc0661b63cb007f3c659d3945c8a0a9959","c92d994b7043a479aed1d409f6d3122d583592fe7f6499ca632cbfdff7ff643d","9163afbe295c6cc9086de28a9595829873d1af5f03d12a9bd12be15d461d9b95","afa0a9427a96e6f83677a6047481924b56d966d4d28122b203a55a26623903b1","ef0966f57a176d146b172641fb7cf488efef6a38ffba25104d48851b47c1a2fe","30181fffa1b9dc32c209cd908842d72120b5693a077d9d5908a1fb8015070bde","f033b3b81a3b6a02621292a7efcae4a96b30e34f1f5c2ff1c73ee0561fde6f25","3de7b0b44bc0fdbf89e959402be0215a1392880079f53efa4378df7fe3c285a3","097766e7ad547d7a554fd7639418ad0e528bc2c659a7ba4f937804db6a4761fa","d537535ed5d89a15dd5a5e70123e302f39ecf3450b7a04e5c8acdfd687599def","a78831e142a0fb990ab46b36817ca6ca3f8de710f8b489c50fad41f8b385a523","f1c7ac2adb9843fe200b9d9f2cb505af252f023c1d55386fe67665bd7432042d","4d474ea07a0dc9baf05657a76d5ba2f378737c7f73ec702417bc8b6deb50f454","46d9bb8c2c23ab7b05dc43f4842556b56c233daa5e07d1d8ce0d73cc87850d3c","c34d66fd10f3de8a359499c234d13bb7a14b34f38445bb49c15e7a27c145f0c8","e0d844dce6d8035ec8bd8aef2bc8871374cc4670772a6e6454d3f5dcad7e017b","551b0074727f1c2bd2aca9cbf70c4ae0faf6e74077a0a5f184c51f16d7999251","eb7ba0ea6c15d596684fb79d0c739e818ef3e58c7ffb70db7cbdda61bc98cc16","89c74fcae065f56117e83309ede841759d025e403c7e8dd6464c58c5cc8d5d90","8fefbb7c3e31276c38f32d467038de6053a6f191e8807b50a881217e362ae1c7","3e7dd5d012581d96fb3ba30217d5c654a2f8d3be8cbdf84084206a3272ebe9b3","1114607e651de0a5fd93954becf3890f3016ccdbd1813346f3551c557d7e414d"],"paragraph_range_zero_based":[17112,17135],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p17112"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The field reportSlotOffsetListDCI-0-1 applies to DCI format 0_1 and the field reportSlotOffsetListDCI-0-2 applies to DCI format 0_2 (see TS 38.214 [19], clause 6.1.2.1).","paragraph_zero_based":17136},{"literal_text_all_w_t_and_m_t":"The fields reportSlotOffsetList-r17, reportSlotOffsetListDCI-0-1-r17 and reportSlotOffsetListDCI-0-2-r17 are only applicable for SCS 480 kHz and 960 kHz and if they are configured, the UE shall ignore the fields reportSlotOffsetList (without suffix), reportSlotOffsetListDCI-0-1 (without suffix) and reportSlotOffsetListDCI-0-2 (without suffix) for SCS 480 kHz and 960 kHz.","paragraph_zero_based":17137},{"literal_text_all_w_t_and_m_t":"resourcesForChannelMeasurement","paragraph_zero_based":17138},{"literal_text_all_w_t_and_m_t":"Resources for channel measurement. csi-ResourceConfigId of a CSI-ResourceConfig included in the configuration of the serving cell indicated with the field \"carrier\" above. The CSI-ResourceConfig indicated here contains only NZP-CSI-RS resources and/or SSB resources. This CSI-ReportConfig is associated with the DL BWP indicated by bwp-Id in that CSI-ResourceConfig.","paragraph_zero_based":17139},{"literal_text_all_w_t_and_m_t":"sharedCMR","paragraph_zero_based":17140},{"literal_text_all_w_t_and_m_t":"Enables sharing of channel measurement resources between different CSI measurement hypotheses when (1) csi-ReportMode is set to 'Mode1' and numberOfSingleTRP-CSI-Mode1 is set to 1 or 2; or (2) csi-ReportMode is set to 'Mode2' (see TS 38.214 [19], clause 5.2.1.4.2).","paragraph_zero_based":17141},{"literal_text_all_w_t_and_m_t":"subbandSize","paragraph_zero_based":17142},{"literal_text_all_w_t_and_m_t":"Indicates one out of two possible BWP-dependent values for the subband size as indicated in TS 38.214 [19], table 5.2.1.4-2 . If csi-ReportingBand is absent, the UE shall ignore this field.","paragraph_zero_based":17143},{"literal_text_all_w_t_and_m_t":"timeRestrictionForChannelMeasurements","paragraph_zero_based":17144},{"literal_text_all_w_t_and_m_t":"Time domain measurement restriction for the channel (signal) measurements (see TS 38.214 [19], clause 5.2.1.1).","paragraph_zero_based":17145},{"literal_text_all_w_t_and_m_t":"timeRestrictionForInterferenceMeasurements","paragraph_zero_based":17146},{"literal_text_all_w_t_and_m_t":"Time domain measurement restriction for interference measurements (see TS 38.214 [19], clause 5.2.1.1).","paragraph_zero_based":17147},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17148},{"literal_text_all_w_t_and_m_t":"PortIndexFor8Ranks field descriptions","paragraph_zero_based":17149},{"literal_text_all_w_t_and_m_t":"portIndex8","paragraph_zero_based":17150},{"literal_text_all_w_t_and_m_t":"Port-Index configuration for up to rank 8. If present, the network configures port indexes for at least one of the ranks.","paragraph_zero_based":17151},{"literal_text_all_w_t_and_m_t":"portIndex4","paragraph_zero_based":17152},{"literal_text_all_w_t_and_m_t":"Port-Index configuration for up to rank 4. If present, the network configures port indexes for at least one of the ranks.","paragraph_zero_based":17153},{"literal_text_all_w_t_and_m_t":"portIndex2","paragraph_zero_based":17154},{"literal_text_all_w_t_and_m_t":"Port-Index configuration for up to rank 2. If present, the network configures port indexes for at least one of the ranks.","paragraph_zero_based":17155},{"literal_text_all_w_t_and_m_t":"portIndex1","paragraph_zero_based":17156},{"literal_text_all_w_t_and_m_t":"Port-Index configuration for rank 1.","paragraph_zero_based":17157},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17158},{"literal_text_all_w_t_and_m_t":"PUCCH-CSI-Resource field descriptions","paragraph_zero_based":17159}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["9764ba90169353ec6699a278cee8dfab4036b521a037160fcc6076be21ed6b8d","e6e0af5efc5196d5e9317b9b354dcf7c51eb5e14ae927470bc3f2a7a0c5410fd","fa05615c856f28014d8d1236212e8c7175ae23f4e8c4f1ea0616bf5acc1e55c3","4467f9fd2bc8fd098ea8f4efa1baa6ee86ed139446ffe59a3998d2ee41db88ce","3eae49de426425ae234047dd876d1babdca63512598cdb4fa96564af71431ab7","639139e1d365ca77b20c549dc5963bac0096e780c34ee6c070620a5e760b0e53","5e93597a9744064ade08a6a6ca363451697b3b29b73c14fe49b7354ff1ca6e14","71ce2efa34933b099ae0a0d392f797c3971453980c9292993eb140a8438460ea","0561dacf54ca61eabf0d842c2a6b55469088238343c857a2dc45ce1602305bdc","bde3555f3bc53d2a7ea27dccc0b1f535c67211b5dd918761ea8335abaa2629a3","b0f2865148dbb0de124a6e9e317e0b17c2c8d1e9dc0758f272a038e0bcb9aa5e","2a636af9f088579df091fc9a1a3060a0a70e3b0b76771e0da9c5deaf0b39265f","452797aea851da042fb7f7a37c4f3629e43fb2278dcc0bc157d19e5a15775240","05c29052581719d1bef830078790b197c9d4c975686a0999a4974e11c908b125","21081696877606e53b2d120f47f7fb36cb7d77864c92b6d030fbe12b25deae65","66b05506aead6bf72dbc499246dfdd7c50ccf55ab68a17d0f9e5186a40d76118","425874b0650c1cc50895b8ec874f4fe8c6c16e831fba592bc92601d426ba40e7","a267b1709fb8447af4a09011b0f077ac93eee8fa80be3794854ea714d43dd1d1","c900728b626006db8f23d7d4ac3b792244ee301a648e600300a80022dd534c2d","be010ead68801e0b821260c963d7ea2f1c053ae866ad648ff9a6396708c3021a","75d2dea1c31971325436ada6722b25319bf55c95c877609b4495a2d98a69deb4","0ac756cf51e3d51e7bd996e5114613d7058a34e9d1ed324cbb3f2a4e4c8c3073","e6953234d9f4c605ff82ea067b5c87831f06f7d9fc0915b9f19044eda0cad894","42af404a816d8564500edaffaf26f5d74c4b9cef6513612469c8d5d30246c4ac"],"paragraph_range_zero_based":[17136,17159],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p17136"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"pucch-Resource","paragraph_zero_based":17160},{"literal_text_all_w_t_and_m_t":"PUCCH resource for the associated uplink BWP. Only PUCCH-Resource of format 2, 3 and 4 is supported. The actual PUCCH-Resource is configured in PUCCH-Config and referred to by its ID. When two PUCCH-Config are configured within PUCCH-ConfigurationList, PUCCH-ResourceId in a PUCCH-CSI-Resource refers to a PUCCH-Resource in the PUCCH-Config used for HARQ-ACK with low priority.","paragraph_zero_based":17161},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17162},{"literal_text_all_w_t_and_m_t":"–CSI-ReportConfigId","paragraph_zero_based":17163},{"literal_text_all_w_t_and_m_t":"The IE CSI-ReportConfigId is used to identify one CSI-ReportConfig.","paragraph_zero_based":17164},{"literal_text_all_w_t_and_m_t":"CSI-ReportConfigId information element","paragraph_zero_based":17165},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17166},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-REPORTCONFIGID-START","paragraph_zero_based":17167},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17168},{"literal_text_all_w_t_and_m_t":"CSI-ReportConfigId ::=              INTEGER (0..maxNrofCSI-ReportConfigurations-1)","paragraph_zero_based":17169},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17170},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-REPORTCONFIGID-STOP","paragraph_zero_based":17171},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17172},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17173},{"literal_text_all_w_t_and_m_t":"–CSI-ReportSubConfig","paragraph_zero_based":17174},{"literal_text_all_w_t_and_m_t":"The IE CSI-ReportSubConfig is used to configure parameters in one sub-configuration within a CSI report configuration.","paragraph_zero_based":17175},{"literal_text_all_w_t_and_m_t":"CSI-ReportSubConfig information element","paragraph_zero_based":17176},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17177},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-REPORTSUBCONFIG-START","paragraph_zero_based":17178},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17179},{"literal_text_all_w_t_and_m_t":"CSI-ReportSubConfig-r18 ::=             SEQUENCE {","paragraph_zero_based":17180},{"literal_text_all_w_t_and_m_t":"    reportSubConfigId-r18                  CSI-ReportSubConfigId-r18,","paragraph_zero_based":17181},{"literal_text_all_w_t_and_m_t":"    portSubsetIndicator-r18               CHOICE {","paragraph_zero_based":17182},{"literal_text_all_w_t_and_m_t":"                p2                                  BIT STRING (SIZE (2)),","paragraph_zero_based":17183}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["53322e3ced7f7e9def4876bf1bf0a172f3d19e9d68a70ec700ac50db3bd7b0b8","af528c9e3244d24b5a8c5ad51cedbf42b07f31a23bc7684a1fe690b99870c720","0b4224bd63b59faa5b744dfd0391e1614a0f2d0c808e4ba74c05c4e7a84941b5","0c1eab622d8904d8b0833f2271787be695d0985fb36cd6cbf6fe4d15e918e9b1","55b1a6f5d8e14c760569a8c2a9c770227293a74a318afe5daec051cbf1a6c034","22cc3663285148252f13ad13770f4d527932942770019d1fe664948a7b00f438","ba9b731777def4fe3cfd8b5a66e48f10738efa6729f2f5b421f9cf4b3de1913b","6867e5b2f094f1dde387f35038e56304f0ce0b25910e34404cd0b85e546069f4","c0071c83165b832c8a9ce2a068d94b3c259a0b8a951e0bc59c9da6c0a7b7a62b","2c41bdd012528c6e8ffa743c07c676e0842dee17cc1bc699c1290e9bdd6aa540","8035773cc7618d2221bbb3d23aab71c6774eaff687dfd105a51ff49245e64431","dcc96fdea6534b799601ad781dec8ec30