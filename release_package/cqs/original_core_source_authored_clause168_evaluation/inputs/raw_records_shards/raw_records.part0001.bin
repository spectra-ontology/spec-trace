{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42408},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":42409},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42410},{"literal_text_all_w_t_and_m_t":"9.4Radio Information Related to Discovery Message","paragraph_zero_based":42411},{"literal_text_all_w_t_and_m_t":"This clause specifies RRC information elements that are transferred in Discovery Message.","paragraph_zero_based":42412},{"literal_text_all_w_t_and_m_t":"–SL-AccessInfo-L2U2N","paragraph_zero_based":42413},{"literal_text_all_w_t_and_m_t":"The IE SL-AccessInfo-L2U2N includes the radio information included in Discovery Message used for L2 U2N relay operation.","paragraph_zero_based":42414},{"literal_text_all_w_t_and_m_t":"SL-AccessInfo-L2U2N information elements","paragraph_zero_based":42415},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":42416},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-ACCESSINFO-L2U2N-START","paragraph_zero_based":42417},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42418},{"literal_text_all_w_t_and_m_t":"NR-Sidelink-DiscoveryMessage DEFINITIONS AUTOMATIC TAGS ::=","paragraph_zero_based":42419},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42420},{"literal_text_all_w_t_and_m_t":"BEGIN","paragraph_zero_based":42421},{"literal_text_all_w_t_and_m_t":"IMPORTS","paragraph_zero_based":42422},{"literal_text_all_w_t_and_m_t":"    CellAccessRelatedInfo,","paragraph_zero_based":42423},{"literal_text_all_w_t_and_m_t":"    SL-ServingCellInfo-r17","paragraph_zero_based":42424},{"literal_text_all_w_t_and_m_t":"FROM NR-RRC-Definitions;","paragraph_zero_based":42425},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42426},{"literal_text_all_w_t_and_m_t":"SL-AccessInfo-L2U2N-r17 ::=             SEQUENCE {","paragraph_zero_based":42427},{"literal_text_all_w_t_and_m_t":"    cellAccessRelatedInfo-r17               CellAccessRelatedInfo,","paragraph_zero_based":42428},{"literal_text_all_w_t_and_m_t":"    sl-ServingCellInfo-r17                  SL-ServingCellInfo-r17,","paragraph_zero_based":42429},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":42430},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":42431}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["c1dd6d351e21562b7edb20fc5cc26fab34008e4136f5b183503f261ce004f272","e5abe7f5cc96cfe2459327a03034c3883bff8afa496abd1d30764a04b48df477","83deddde61cd64dcaa2f94d9f2599a16d4d879c12ad9c42ad3f97c44c96fbff8","989cdb3c49ee06d2f386372e90adf1080f500401627dcadaa30c0516d663d78e","b16092fe70cfb0a4b35dff7ef3e3ba4d587c32a3e4fbf97df399f07db4945c8b","d62ffd6087a6d7580ed0947858db644567172c37e73a72af5dc53682ede71249","e99ccf310b8d007c018d1beebd685b0d7c66eb93bd41a726549d25265d08233e","5a90c53dcbf59e7c8607807c24f47b78c03d5c7a7e5a5f2fe2a4afdf34273f9b","b193851defca1dc1f0eaac89b8ce6bf6e1c5784e45a5ff4acc7c5d8f8d855d1f","158356f4c7c4e3859b8175ed2f55abfa743b0f5428edc590b289067ceb762c43","0113f0ca3d90239c770fb48b4972adc20df1fa40a782b16179c3d02b77a41644","3a75969048fd881fe1a517933a28de4645f77e598f0a6df5e28c77bc4a649eee","3cd0b6b0ba9946f4ae08d4c567b182448a93af6f221bc8d1acdcb046d9c3364a","ef7e6378bb26fd5942d812a3a6296f774c5416648fd495e71c14f9fce06ad06e","2e3d4675e2ebb64bfe1d3b1095eebe588e2ad3730e394e75a7155f33bca763cc","49d266ad723f69e2a66cb4c1bf9e2f5e1953bb2b183f379ff5d9f713e1eaa843","18c36cfdabb40eb33922dc59566644cc99ca58488c92480ee01c1bc0124c9fc1","3035477102098c987c5d0ed96d79e8a469131802f4c82daa1734f3af310e295b","875ad8d413ec52beb6d1d73ab201cdf416007a13929f61efe265837ab5f0de41","89f19eb9fb55855884bc235731ffc0644ec3e9941c94550e0f3632ab2a873bc1","3598ca5b938f3a827156285373139e64d9297054a1125dbf4f2f668b01d84471","98276ec391d0835c8c67e2acd4f2c7d543ebfa2da2bc068baeb94c8a3729b9e2","11f91816d067c34dda4f75a61935b608a2d61874ba05d5f0c3e508a20acb7da0","f0e7697b0b5958917b1d148dde66d493a15c45ab5c42572f7c7d253ba5805417"],"paragraph_range_zero_based":[42408,42431],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p42408"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42432},{"literal_text_all_w_t_and_m_t":"END","paragraph_zero_based":42433},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42434},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-ACCESSINFO-L2U2N-STOP","paragraph_zero_based":42435},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":42436},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42437},{"literal_text_all_w_t_and_m_t":"10Generic error handling","paragraph_zero_based":42438},{"literal_text_all_w_t_and_m_t":"10.1General","paragraph_zero_based":42439},{"literal_text_all_w_t_and_m_t":"The generic error handling defined in the subsequent clauses applies unless explicitly specified otherwise e.g. within the procedure specific error handling.","paragraph_zero_based":42440},{"literal_text_all_w_t_and_m_t":"The UE shall consider a value as not comprehended when it is set:","paragraph_zero_based":42441},{"literal_text_all_w_t_and_m_t":"-to an extended value that is not defined in the version of the transfer syntax supported by the UE;","paragraph_zero_based":42442},{"literal_text_all_w_t_and_m_t":"-to a spare or reserved value unless the specification defines specific behaviour that the UE shall apply upon receiving the concerned spare/reserved value.","paragraph_zero_based":42443},{"literal_text_all_w_t_and_m_t":"The UE shall consider a field as not comprehended when it is defined:","paragraph_zero_based":42444},{"literal_text_all_w_t_and_m_t":"-as spare or reserved unless the specification defines specific behaviour that the UE shall apply upon receiving the concerned spare/reserved field.","paragraph_zero_based":42445},{"literal_text_all_w_t_and_m_t":"10.2ASN.1 violation or encoding error","paragraph_zero_based":42446},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":42447},{"literal_text_all_w_t_and_m_t":"1>when receiving an RRC message on the BCCH, CCCH, PCCH, MCCH or a PC5 RRC message on SBCCH for which the abstract syntax is invalid [6]:","paragraph_zero_based":42448},{"literal_text_all_w_t_and_m_t":"2>ignore the message.","paragraph_zero_based":42449},{"literal_text_all_w_t_and_m_t":"NOTE:This clause applies in case one or more fields is set to a value, other than a spare, reserved or extended value, not defined in this version of the transfer syntax. E.g. in the case the UE receives value 12 for a field defined as INTEGER (1..11). In cases like this, it may not be possible to reliably detect which field is in the error hence the error handling is at the message level.","paragraph_zero_based":42450},{"literal_text_all_w_t_and_m_t":"10.3Field set to a not comprehended value","paragraph_zero_based":42451},{"literal_text_all_w_t_and_m_t":"The UE shall, when receiving an RRC message or PC5 RRC message on any logical channel:","paragraph_zero_based":42452},{"literal_text_all_w_t_and_m_t":"1>if the message includes a field that has a value that the UE does not comprehend:","paragraph_zero_based":42453},{"literal_text_all_w_t_and_m_t":"2>if a default value is defined for this field:","paragraph_zero_based":42454},{"literal_text_all_w_t_and_m_t":"3>treat the message while using the default value defined for this field;","paragraph_zero_based":42455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["62e7a324f8add610f641149af89c16903aefe2b78f2c65f2d696fd901cfaf04f","3da1cffba95f89e967746e0854b3ed792cf20a4c2bda777de620b664e174afbe","29a8a41de403f3868d4ca8390abcf1780a83a52465a58953e520e33e55cc5f22","5db2695b56e1158f6ce8c9ec2257bae11f6a0e42b301127947c3705f7d71e733","4d33f455a368a909fa08c2ea835c6bbfa3a57318ed8e97ae7536995b7546bf90","ff7fdb0d1f9dd9a5f49cb1e0243a2eea4b68d06a6d89947496edcd296e7792ce","3f1e83f8bfda7393c24783f4b0303c91871fa2b5534d453f60c8d2da80a4af26","3b9df0fb8a3d08ca1f7b51874e03adbea82c5b8946d8f84be8daa3699c0c6e79","579677aa5af1859c86013ced58e04e013ee6ae0e7cea61922c0d4a7165d78e78","4a7573a1869d897fe321ada9f4c0c0e506dd3f902c1277bdda38917f36479818","d76d4b922caa2a331a67cc01f291dc13dcb51fa79afc7b70a802e2c1fddf7744","05c40dd1683656b6159eed50da74e4753a2e854e219bdd321967248b80d6fb5e","5516a19020b7e852242aa2d52caf39e6eb77a4a56269625073b5ad10bd48d570","57ee4df829cde71f7733a686e7331cbb7a526bb0f010f5988dd520b6896da642","77ce0f57eff2e031558bfe8091e22229f222592fb211a8b7928113de0f3e8874","e37bd18a314eea954d6316732e5d34adfeb8b1a88cbcd833158fc61fb2b307f2","ada7c5b5a7c0958e319e0bd6bce01a6b8fbce91658bab0100c3019f00e43e3d1","6c1be55ad5b112e06d7f767d2c3f05bb192d212f6f842993941013e416583e7c","c2cbb183f856da447707d5e470ab226aa10169e2f8c0f2e7da526f54af7b0958","8936e0d18d27349e607c3f2d7691bc165f725878ae4334dd96d00aff67fb7005","ccf5842916b9d021beadaed0347e5b245665c8df4c58eb0953c5fb51480f5129","d5e378aee3005217b358a501fee2e4c5d4648335f75c34c60a31e6a1464bfc7c","34f8dcd661c8071c953a314d7ed0484294ea0de87c457556eb5aa34e59f4c837","93c09179621938e75fe1ef4167b272d4974ce6856cc6a7b92f6332c3b0106c00"],"paragraph_range_zero_based":[42432,42455],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p42432"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>else if the concerned field is optional:","paragraph_zero_based":42456},{"literal_text_all_w_t_and_m_t":"3>treat the message as if the field were absent and in accordance with the need code for absence of the concerned field;","paragraph_zero_based":42457},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":42458},{"literal_text_all_w_t_and_m_t":"3>treat the message as if the field were absent and in accordance with clause 10.4.","paragraph_zero_based":42459},{"literal_text_all_w_t_and_m_t":"10.4Mandatory field missing","paragraph_zero_based":42460},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":42461},{"literal_text_all_w_t_and_m_t":"1>if the message includes a field that is mandatory to include in the message (e.g. because conditions for mandatory presence are fulfilled) and that field is absent or treated as absent:","paragraph_zero_based":42462},{"literal_text_all_w_t_and_m_t":"2>if the RRC message was not received on DCCH or CCCH; or","paragraph_zero_based":42463},{"literal_text_all_w_t_and_m_t":"2>if the PC5 RRC message was not received on SCCH:","paragraph_zero_based":42464},{"literal_text_all_w_t_and_m_t":"3>if the field concerns a (sub-field of) an entry of a list (i.e. a SEQUENCE OF):","paragraph_zero_based":42465},{"literal_text_all_w_t_and_m_t":"4>treat the list as if the entry including the missing or not comprehended field was absent;","paragraph_zero_based":42466},{"literal_text_all_w_t_and_m_t":"3>else if the field concerns a sub-field of another field, referred to as the 'parent' field i.e. the field that is one nesting level up compared to the erroneous field:","paragraph_zero_based":42467},{"literal_text_all_w_t_and_m_t":"4>consider the 'parent' field to be set to a not comprehended value;","paragraph_zero_based":42468},{"literal_text_all_w_t_and_m_t":"4>apply the generic error handling to the subsequent 'parent' field(s), until reaching the top nesting level i.e. the message level;","paragraph_zero_based":42469},{"literal_text_all_w_t_and_m_t":"3>else (field at message level):","paragraph_zero_based":42470},{"literal_text_all_w_t_and_m_t":"4>ignore the message.","paragraph_zero_based":42471},{"literal_text_all_w_t_and_m_t":"NOTE 1:The error handling defined in these clauses implies that the UE ignores a message with the message type or version set to a not comprehended value.","paragraph_zero_based":42472},{"literal_text_all_w_t_and_m_t":"NOTE 2:The nested error handling for messages received on logical channels other than DCCH, CCCH and SCCH applies for errors in extensions also, even for errors that can be regarded as invalid network operation e.g. the network not observing conditional presence.","paragraph_zero_based":42473},{"literal_text_all_w_t_and_m_t":"NOTE 3:UE behaviour on receipt of an RRC message on DCCH or CCCH or a PC5 RRC message on SCCH that does not include a field that is mandatory (e.g. because conditions for mandatory presence are fulfilled) is unspecified.","paragraph_zero_based":42474},{"literal_text_all_w_t_and_m_t":"The following ASN.1 further clarifies the levels applicable in case of nested error handling for errors in extension fields.","paragraph_zero_based":42475},{"literal_text_all_w_t_and_m_t":"-- /example/ ASN1START","paragraph_zero_based":42476},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42477},{"literal_text_all_w_t_and_m_t":"-- Example with extension addition group","paragraph_zero_based":42478},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["72e8a049131c3110042e91d8fe27925bd1b26f7de1e7fbbd6f6b89788813e426","8c1f59b772cb85aedbeec6c9fdf8b7db87829427e5b9279c825adbf4a630e303","f0297ab50644900cc71d4dd5bda9058bd9c16b3d8e8ef64955290fc781a92e76","c96cce48c4bcfc6cc8ea4f51a162b19a4410b68131a5cc4da4edcbcde02c56f2","d549d041d58362841d5c7c57fea5de65f8708ab16b228ca2478c8c1626252a37","e982f49de84e48a14feda2ea89632a66eacef3cba14dadb80fc4639fb8632d7c","514a1ab8bfe1f3742d47ebfdc34209768fae561e9586b47b1b3ce508b7519d6a","678c8cc39854438ae7853ba5c97706211e986c42d3be2321c5549a3e030760c9","5138ebee517321ce1511e720673889d415f0688ac70567efeacfe8ac9c18e873","9759cee9274b26244ae6ad11fa62f2845d2fccfd07cb88d52111904778780c6c","66c1c2d7b54f8a40441a3875b56d1f69028ad6381256082a47379163bec7ae54","24a6250e24fee69833a209930e913d869ed5af96458ddfcfc94faa07c144a267","141fc27eb84efc9e9952f9ec837efb753e64df71b179a8c5b1369bc777d65877","c558b66a54f5344bcfd536eab74cc0a0048b0ad652eb75941111c06ee9dc5cb2","6f7809ccaa393ebf94e3c2c8cc7ef51dd0a1dfa1478a90f9039442d3ccf3fb1d","2a8d0117a8c08b4061e0d388a7ed77ef9d257e7974489bf3965c10b5e55a014b","7e455d23429dfa64b4727b74ab9ad30d8e259f397ba056622bd59db6915f62dd","b530a3fe46bd17c13596e4669826b4398ccc23a7a522e2654db3c34139566eff","1f1e7cf0f4671078bfd409468227061e394c38869073fe0e7121471f072b7712","c047f56550e4315907dade83fda8b806ac2a820dff9ce5ae58b9bd54b4b48c93","f8c78cdfa9cf9acc45f7e290c0e9afc587a70e5445c620868dd144f2f52e70fc","122da8251e96fcc07c55dc3d8a145c4e8e5963c1a187c48af0a4231f4f5b2397","be8db35d8ddfd4cf31a98321886ca52d9819ab6248b2d8a85f678ac33bb5241c","9de62bf3c5c4026c5c5a0915ebc51db1cda06553d079e5ddda057140f8cb503e"],"paragraph_range_zero_based":[42456,42479],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p42456"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ItemInfoList ::=                    SEQUENCE (SIZE (1..max)) OFItemInfo","paragraph_zero_based":42480},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42481},{"literal_text_all_w_t_and_m_t":"ItemInfo ::=                        SEQUENCE {","paragraph_zero_based":42482},{"literal_text_all_w_t_and_m_t":"    itemIdentity                        INTEGER (1..max),","paragraph_zero_based":42483},{"literal_text_all_w_t_and_m_t":"    field1                              Field1,","paragraph_zero_based":42484},{"literal_text_all_w_t_and_m_t":"    field2                              Field2                  OPTIONAL,           -- Need N","paragraph_zero_based":42485},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":42486},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":42487},{"literal_text_all_w_t_and_m_t":"    field3-r9                       Field3-r9               OPTIONAL,              -- Cond Cond1","paragraph_zero_based":42488},{"literal_text_all_w_t_and_m_t":"    field4-r9                       Field4-r9               OPTIONAL               -- Need N","paragraph_zero_based":42489},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":42490},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":42491},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42492},{"literal_text_all_w_t_and_m_t":"-- Example with traditional non-critical extension (empty sequence)","paragraph_zero_based":42493},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42494},{"literal_text_all_w_t_and_m_t":"BroadcastInfoBlock1 ::=             SEQUENCE {","paragraph_zero_based":42495},{"literal_text_all_w_t_and_m_t":"    itemIdentity                        INTEGER (1..max),","paragraph_zero_based":42496},{"literal_text_all_w_t_and_m_t":"    field1                              Field1,","paragraph_zero_based":42497},{"literal_text_all_w_t_and_m_t":"    field2                              Field2                  OPTIONAL,           -- Need N","paragraph_zero_based":42498},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                BroadcastInfoBlock1-v940-IEs    OPTIONAL","paragraph_zero_based":42499},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":42500},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42501},{"literal_text_all_w_t_and_m_t":"BroadcastInfoBlock1-v940-IEs::=SEQUENCE {","paragraph_zero_based":42502},{"literal_text_all_w_t_and_m_t":"    field3-r9                           Field3-r9               OPTIONAL,           -- Cond Cond1","paragraph_zero_based":42503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["c058daa8374fe4846101be311dbfe0f47446357eab7171a848afcb68f29c744f","937f5265837a327c5ac14f3a0a5a99da78c960cd9c67ac0e7c902209bdb50d96","8cd2f3ed0617682649eca8179108eb952f77349f001d877a3b11b657667ddd86","1fc513d88e4c2d4aa28d154eb84a96ad4657297ae5b8fca55b8d76c8e8c5074e","ee2a1bc5771c8c0908626c5ebce2a521976cf61fda0989e60fdfd9559c41db6f","3e04153b0989adf2c4f0ddc1827917b2cf14860bd2669b2c0e1a2664b868dfd0","0d2836b4a0ad116f9c4bb5677cc3f4b5318d6c20c13f794fd6e523bc98213778","0e4379938fe5607d899695c69b1a1b1f55ab7b43ba1d8f583b9cb6816eba1c58","f3035c1b21914e2b8df5ff03d63d474a915889f84c3a1b45759c6634d525120a","7e23d18e7b268111276bb5fe29a49131e91111cda1e47465192094486fc22e69","ca145212bfefdbdd00a7b78a8249abf979a96a3bf68993fd1bcdbbc2d72cf495","8292cbc3a9a99146620a8f35099e3695e2264972343c3776e6ca4dfb1047ed43","06d57b2de25d993d83ab38ad9eefdd3244a0672d53c875b78f6f94ee252924e5","d42b17ffbdd974c417c8c41923c2d1bf3e46a8db5280a079d122a3370a7e1718","4d16f4d0bb68ac1df8d1af46f3f1373a957e0e7385c2ccbe8591d801718c471a","ef1ec6ad36f3361caeafabcacf5724acdf5e302fcbd9b191ff46981263edfd33","6fccc49d3a2c923e0d51375386f654a9a83ccc4f205c3f1c7bbba3dab51c0608","751fe80fca622ef506d8bfbdcc57e4f2b20222511cc8565d7c3d36bb26f5fcdd","1d618f75265e6260b99b71de02c1074c2e00535c84607f3e7df38cb9854c2ca2","5b1db3349c92267b75d36c9e0ea8b70f8d49a174c2796817019624e26b1623dc","99de1429cbb9c033c8dce312a9d8269bdaa815b037f4d2e8cda5a8f863b3ff3e","d3b8e832f0cfa28597631a87123b177c6e8b1426d25d679678610c3b15215cbf","8c74087d4111f7f8b184b3026952c5382ce1e13b6b4ca95f29bcf597c0a0ab21","908ee54b6ec08f07c2f867ea047b0017ef686e6c64b39a9708c0fa7c62a90e11"],"paragraph_range_zero_based":[42480,42503],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p42480"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    field4-r9                           Field4-r9               OPTIONAL,           -- Need N","paragraph_zero_based":42504},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                SEQUENCE {}             OPTIONAL            -- Need S","paragraph_zero_based":42505},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":42506},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42507},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":42508},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42509},{"literal_text_all_w_t_and_m_t":"The UE shall, apply the following principles regarding the levels applicable in case of nested error handling:","paragraph_zero_based":42510},{"literal_text_all_w_t_and_m_t":"-an extension addition group is not regarded as a level on its own. E.g. in the ASN.1 extract in the previous, a error regarding the conditionality of field3 would result in the entire itemInfo entry to be ignored (rather than just the extension addition group containing field3 and field4);","paragraph_zero_based":42511},{"literal_text_all_w_t_and_m_t":"-a traditional nonCriticalExtension is not regarded as a level on its own. E.g. in the ASN.1 extract in the previous, an error regarding the conditionality of field3 would result in the entire BroadcastInfoBlock1 to be ignored (rather than just the non-critical extension containing field3 and field4).","paragraph_zero_based":42512},{"literal_text_all_w_t_and_m_t":"10.5Not comprehended field","paragraph_zero_based":42513},{"literal_text_all_w_t_and_m_t":"The UE shall, when receiving an RRC message on any logical channel:","paragraph_zero_based":42514},{"literal_text_all_w_t_and_m_t":"1>if the message includes a field that the UE does not comprehend:","paragraph_zero_based":42515},{"literal_text_all_w_t_and_m_t":"2>treat the rest of the message as if the field was absent.","paragraph_zero_based":42516},{"literal_text_all_w_t_and_m_t":"NOTE:This clause does not apply to the case of an extension to the value range of a field. Such cases are addressed instead by the requirements in clause 10.3.","paragraph_zero_based":42517},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42518},{"literal_text_all_w_t_and_m_t":"11Radio information related interactions between network nodes","paragraph_zero_based":42519},{"literal_text_all_w_t_and_m_t":"11.1General","paragraph_zero_based":42520},{"literal_text_all_w_t_and_m_t":"This clause specifies RRC messages that are transferred between network nodes. These RRC messages may be transferred to or from the UE via another Radio Access Technology. Consequently, these messages have similar characteristics as the RRC messages that are transferred across the NR radio interface, i.e. the same transfer syntax and protocol extension mechanisms apply.","paragraph_zero_based":42521},{"literal_text_all_w_t_and_m_t":"11.2Inter-node RRC messages","paragraph_zero_based":42522},{"literal_text_all_w_t_and_m_t":"11.2.1General","paragraph_zero_based":42523},{"literal_text_all_w_t_and_m_t":"This clause specifies RRC messages that are sent either across the X2-, Xn- or the NG-interface, either to or from the gNB, i.e. a single 'logical channel' is used for all RRC messages transferred across network nodes. The information could originate from or be destined for another RAT.","paragraph_zero_based":42524},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":42525},{"literal_text_all_w_t_and_m_t":"-- TAG-NR-INTER-NODE-DEFINITIONS-START","paragraph_zero_based":42526},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316