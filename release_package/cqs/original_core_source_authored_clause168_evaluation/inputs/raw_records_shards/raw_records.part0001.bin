{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is mandatory present if this MeasObject is for a frequency which operates with shared spectrum channel access in FR1. Otherwise, it is absent, Need R.","paragraph_zero_based":19968},{"literal_text_all_w_t_and_m_t":"SharedSpectrum2","paragraph_zero_based":19969},{"literal_text_all_w_t_and_m_t":"This field is optionally present if this MeasObject is for a frequency which operates with shared spectrum channel access in FR2-2, Need R. Otherwise, it is absent, Need R.","paragraph_zero_based":19970},{"literal_text_all_w_t_and_m_t":"SSBorAssociatedSSB","paragraph_zero_based":19971},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if ssb-ConfigMobility is configured or associatedSSB is configured in at least one cell. Otherwise, it is absent, Need R.","paragraph_zero_based":19972},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19973},{"literal_text_all_w_t_and_m_t":"–MeasObjectNR-SL","paragraph_zero_based":19974},{"literal_text_all_w_t_and_m_t":"The IE MeasObjectNR-SL concerns a measurement object including a list of transmission resource pool(s) for which CBR measurement is performed for NR sidelink communication/discovery.","paragraph_zero_based":19975},{"literal_text_all_w_t_and_m_t":"MeasObjectNR-SL information element","paragraph_zero_based":19976},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":19977},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASOBJECTNR-SL-START","paragraph_zero_based":19978},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19979},{"literal_text_all_w_t_and_m_t":"MeasObjectNR-SL-r16 ::=      SEQUENCE {","paragraph_zero_based":19980},{"literal_text_all_w_t_and_m_t":"    tx-PoolMeasToRemoveList-r16  Tx-PoolMeasList-r16                           OPTIONAL,       -- Need N","paragraph_zero_based":19981},{"literal_text_all_w_t_and_m_t":"    tx-PoolMeasToAddModList-r16  Tx-PoolMeasList-r16                           OPTIONAL        -- Need N","paragraph_zero_based":19982},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":19983},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19984},{"literal_text_all_w_t_and_m_t":"Tx-PoolMeasList-r16 ::= SEQUENCE (SIZE (1..maxNrofSL-PoolToMeasureNR-r16)) OF SL-ResourcePoolID-r16","paragraph_zero_based":19985},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19986},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASOBJECTNR-SL-STOP","paragraph_zero_based":19987},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":19988},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19989},{"literal_text_all_w_t_and_m_t":"–MeasObjectRxTxDiff","paragraph_zero_based":19990},{"literal_text_all_w_t_and_m_t":"The IE MeasObjectRxTxDiff is used to configure the measurement object for UE Rx-Tx time difference measurement.","paragraph_zero_based":19991}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["e9ae08009f47202377b762902808750e9b1c09f36512d482bbc1a86668ab392f","77d4350aca84575fb7f61053b8078817489ee03e2e5d17156cb997e696084ac5","2d7b7928798fb08ee4daedbbd08d71ede786a6bd8469125cf7c17ba5d95269fa","4dcaa63cce28ff6911726fd4620f2a754ede0f92e324dd6b08f68875319ff131","3c59b9b0b8445b66bba8c9309052f030cbf2d1519a3ce931bc1b3fce8107ec1b","fb5394834e5f700f17ac762f61e6b8e6b0d1d6135fa03882612702efa4bf9e77","2b9f88671c10dcd935b5f0813ae72782497b365dc3b0185f5bc30517ee891649","f8298fe7d8dfb33c787876e56363beb8dbaa738cc90ce27b65a825bd62e88e12","fae9a91530bfab20c728a963328f9c51b151b80eeeb09dc8e5f5d80fe6fdd608","5beec