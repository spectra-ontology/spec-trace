{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17736},{"literal_text_all_w_t_and_m_t":"–CSI-SSB-ResourceSetId","paragraph_zero_based":17737},{"literal_text_all_w_t_and_m_t":"The IE CSI-SSB-ResourceSetId is used to identify one SS/PBCH block resource set.","paragraph_zero_based":17738},{"literal_text_all_w_t_and_m_t":"CSI-SSB-ResourceId information element","paragraph_zero_based":17739},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17740},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-SSB-RESOURCESETID-START","paragraph_zero_based":17741},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17742},{"literal_text_all_w_t_and_m_t":"CSI-SSB-ResourceSetId ::=           INTEGER (0..maxNrofCSI-SSB-ResourceSets-1)","paragraph_zero_based":17743},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17744},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-SSB-RESOURCESETID-STOP","paragraph_zero_based":17745},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17746},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17747},{"literal_text_all_w_t_and_m_t":"–DedicatedNAS-Message","paragraph_zero_based":17748},{"literal_text_all_w_t_and_m_t":"The IE DedicatedNAS-Message is used to transfer UE specific NAS layer information between the 5GC CN and the UE. The RRC layer is transparent for this information.","paragraph_zero_based":17749},{"literal_text_all_w_t_and_m_t":"DedicatedNAS-Message information element","paragraph_zero_based":17750},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17751},{"literal_text_all_w_t_and_m_t":"-- TAG-DEDICATED-NAS-MESSAGE-START","paragraph_zero_based":17752},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17753},{"literal_text_all_w_t_and_m_t":"DedicatedNAS-Message ::=        OCTET STRING","paragraph_zero_based":17754},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17755},{"literal_text_all_w_t_and_m_t":"-- TAG-DEDICATED-NAS-MESSAGE-STOP","paragraph_zero_based":17756},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17757},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17758},{"literal_text_all_w_t_and_m_t":"–DL-PPW-PreConfig","paragraph_zero_based":17759}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["4a65456bd0220566d4aad8773c0e9285de6b16b0c86d7e313bf4a3fd74caaa97","7ca76fcf1b8fb606fbb8730335eea0733760659791824f05114e0dfd83579b51","5fdcf1d037cdc851f785ecc426bada2c3e5ed0f85cd164ea697d928e56f243d0","f28f008226d2bfb17143abbef748a823bd480bc9f079e4fe6c2c34a36066d232","ee3b4618ece0fcaf0cf59f63360b9389ae361157878c9d23d7bb1fb8e1c04757","6e0c423930d506596b4d1bed2d21ca5274583c42d3412a81403c7418047b5151","fcc4db935b019123ee3ba82ce1f7bebc532b87cff85766b83b75c5157282772b","0cc59308df7dc1673adad71bed757ee277b522175d6fded6acb820e740f4fbdc","9ab6d94c7739329893748e4a66380e91b16d73c4ab5c98b6db8bc86d44cfc20c","dc7d6f31c2ef9512033bda6ed984057b0751585a9b806b8a9eb46f0c3afa1359","a31b316c5fea25f948ea7e065b86287b4b4f9b551fc1b8639768a15ab8b4f07e","a31e82647b5e19820d45466909ff55afbc350f612d48618807c329b98c441a69","23c989d8c87a967a73c6850852f7a75c0f1deb9a6d76a7eb9a5b5d057be39a13","6c49a916a73bcb5cf85774296fcddb53e3950aa123e1277ff6e6904ed5fc9b4e","5a3522235cf03161389a12824431aea5c645672eff53f9887a62296ac0ac6c6c","89a5a656f93a39a87838ac6b85b1559b8ae90305622f0242fec0fd57875ba8ce","4d9fa2f201ffb57ef60e4f771c3ae69adde44805faf52b9f68fc7ebc251b4deb","837cba2a2cd35fea5bea904a572b192b22736c0e3b1963dc37e36b5e7cf6b8f3","28f49407ac3ea67ecc8d87ee7ebda7e27d51