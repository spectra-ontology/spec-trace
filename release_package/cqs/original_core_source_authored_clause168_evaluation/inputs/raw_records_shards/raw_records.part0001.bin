{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"LBT-FailureRecoveryConfig information element","paragraph_zero_based":18984},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18985},{"literal_text_all_w_t_and_m_t":"-- TAG-LBT-FAILURERECOVERYCONFIG-START","paragraph_zero_based":18986},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18987},{"literal_text_all_w_t_and_m_t":"LBT-FailureRecoveryConfig-r16 ::=    SEQUENCE {","paragraph_zero_based":18988},{"literal_text_all_w_t_and_m_t":"    lbt-FailureInstanceMaxCount-r16      ENUMERATED {n4, n8, n16, n32, n64, n128},","paragraph_zero_based":18989},{"literal_text_all_w_t_and_m_t":"    lbt-FailureDetectionTimer-r16        ENUMERATED {ms10, ms20, ms40, ms80, ms160, ms320},","paragraph_zero_based":18990},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":18991},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18992},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18993},{"literal_text_all_w_t_and_m_t":"-- TAG-LBT-FAILURERECOVERYCONFIG-STOP","paragraph_zero_based":18994},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18995},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18996},{"literal_text_all_w_t_and_m_t":"LBT-FailureRecoveryConfig field descriptions","paragraph_zero_based":18997},{"literal_text_all_w_t_and_m_t":"lbt-FailureDetectionTimer","paragraph_zero_based":18998},{"literal_text_all_w_t_and_m_t":"Timer for consistent uplink LBT failure detection (see TS 38.321 [3]). Value ms10 corresponds to 10 ms, value ms20 corresponds to 20 ms, and so on.","paragraph_zero_based":18999},{"literal_text_all_w_t_and_m_t":"lbt-FailureInstanceMaxCount","paragraph_zero_based":19000},{"literal_text_all_w_t_and_m_t":"This field determines after how many LBT failure indications received from the physical layer the UE triggers uplink LBT failure recovery (see TS 38.321 [3]). Value n4 corresponds to 4, value n8 corresponds to 8, and so on.","paragraph_zero_based":19001},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19002},{"literal_text_all_w_t_and_m_t":"–LocationInfo","paragraph_zero_based":19003},{"literal_text_all_w_t_and_m_t":"The IE LocationInfo is used to transfer available detailed location information, Bluetooth, WLAN and sensor available measurement results at the UE.","paragraph_zero_based":19004},{"literal_text_all_w_t_and_m_t":"LocationInfo information element","paragraph_zero_based":19005},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":19006},{"literal_text_all_w_t_and_m_t":"-- TAG-LOCATIONINFO-START","paragraph_zero_based":19007}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["1223be856633fbc5a4dd32a1a747e2cbefcc2d11bd0a517091941779e8d64142","280a089ad69c1ca1f020e8dbba0b66efce5bf1070e56d9e76f9befa1b0d7bdf8","ae04c91d56ba8c90dc34292d99688a95c26938ded4d7285004f813b7c4d16828","77c0fc4bf0bb8007509cbd8971c4057b5f211fc8b5a11e2569c5adb01e8d0402","933f36ff1c040f37dc4530a931124f8b646a5b21004af486e937ecd0a52e32d7","520e95534a9cdfbdd6cda98862038365f50bc00e30f385048ba83b5d0d418de5","81a1ebf2123846b6f434679cdb38f1d7521fc22ae3d33f51f7d33d43c3cad796","1fb510cab87d22eac7ffa351c6d9a1824652f5a80c40820a9ed33b1bc80791c7","075154a441e74d204e7b2f5d02519eaa63729b7ef389dc8a5816d09b0a24b719","88fded78ed053e732624bbedcd7d28bb5345b2a4108f74ed156b21a199ae14c4","b5bc83172b5067f426767ae457938249bc97cec842ed45a0a194989233ee46b8","647d52e3938eca6d38bb95fe5fc45c41bd76d07cc8141c9eed5796fafea72f7e","ac46c514c719b669662eece991d8a46824947c9cc294d1fb368421