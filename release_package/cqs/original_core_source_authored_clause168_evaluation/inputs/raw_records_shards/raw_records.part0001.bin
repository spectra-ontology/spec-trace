  srs-RequestDCI-0-2-r16                  INTEGER (1..2)                                                          OPTIONAL, -- Need S","paragraph_zero_based":28405},{"literal_text_all_w_t_and_m_t":"    srs-ResourceSetToAddModListDCI-0-2-r16  SEQUENCE (SIZE(1..maxNrofSRS-ResourceSets)) OF SRS-ResourceSet          OPTIONAL, -- Need N","paragraph_zero_based":28406},{"literal_text_all_w_t_and_m_t":"    srs-ResourceSetToReleaseListDCI-0-2-r16 SEQUENCE (SIZE(1..maxNrofSRS-ResourceSets)) OF SRS-ResourceSetId        OPTIONAL, -- Need N","paragraph_zero_based":28407},{"literal_text_all_w_t_and_m_t":"    srs-PosResourceSetToReleaseList-r16     SEQUENCE (SIZE(1..maxNrofSRS-PosResourceSets-r16)) OF SRS-PosResourceSetId-r16","paragraph_zero_based":28408},{"literal_text_all_w_t_and_m_t":"                                                                                                                    OPTIONAL, -- Need N","paragraph_zero_based":28409},{"literal_text_all_w_t_and_m_t":"    srs-PosResourceSetToAddModList-r16      SEQUENCE (SIZE(1..maxNrofSRS-PosResourceSets-r16)) OF SRS-PosResourceSet-r16        OPTIONAL,-- Need N","paragraph_zero_based":28410},{"literal_text_all_w_t_and_m_t":"    srs-PosResourceToReleaseList-r16        SEQUENCE (SIZE(1..maxNrofSRS-PosResources-r16)) OF SRS-PosResourceId-r16            OPTIONAL,-- Need N","paragraph_zero_based":28411},{"literal_text_all_w_t_and_m_t":"    srs-PosResourceToAddModList-r16         SEQUENCE (SIZE(1..maxNrofSRS-PosResources-r16)) OF SRS-PosResource-r16              OPTIONAL -- Need N","paragraph_zero_based":28412},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":28413},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28414},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28415}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca