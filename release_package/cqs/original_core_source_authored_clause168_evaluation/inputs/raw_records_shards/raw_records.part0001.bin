{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"BFR-CSIRS-Resource ::=              SEQUENCE {","paragraph_zero_based":14736},{"literal_text_all_w_t_and_m_t":"    csi-RS                              NZP-CSI-RS-ResourceId,","paragraph_zero_based":14737},{"literal_text_all_w_t_and_m_t":"    ra-OccasionList                     SEQUENCE (SIZE(1..maxRA-OccasionsPerCSIRS)) OF INTEGER (0..maxRA-Occasions-1)   OPTIONAL,   -- Need R","paragraph_zero_based":14738},{"literal_text_all_w_t_and_m_t":"    ra-PreambleIndex                    INTEGER (0..63)                                                                 OPTIONAL,   -- Need R","paragraph_zero_based":14739},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":14740},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14741},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14742},{"literal_text_all_w_t_and_m_t":"CandidateBeamRSListExt-r16::=       SEQUENCE (SIZE(1.. maxNrofCandidateBeamsExt-r16)) OF PRACH-ResourceDedicatedBFR","paragraph_zero_based":14743},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14744},{"literal_text_all_w_t_and_m_t":"-- TAG-BEAMFAILURERECOVERYCONFIG-STOP","paragraph_zero_based":14745},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":14746},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14747},{"literal_text_all_w_t_and_m_t":"BeamFailureRecoveryConfig field descriptions","paragraph_zero_based":14748},{"literal_text_all_w_t_and_m_t":"beamFailureRecoveryTimer","paragraph_zero_based":14749},{"literal_text_all_w_t_and_m_t":"Timer for beam failure recovery timer. Upon expiration of the timer the UE does not use CFRA for BFR. Value in ms. Value ms10 corresponds to 10 ms, value ms20 corresponds to 20 ms, and so on.","paragraph_zero_based":14750},{"literal_text_all_w_t_and_m_t":"candidateBeamRSList, candidateBeamRSListExt-v1610","paragraph_zero_based":14751},{"literal_text_all_w_t_and_m_t":"Set of reference signals (CSI-RS and/or SSB) identifying the candidate beams for recovery and the associated RA parameters. This set includes all elements of candidateBeamRSList (without suffix) and all elements of candidateBeamRSListExt-v1610. The UE maintains candidateBeamRSList and candidateBeamRSListExt-v1610 separately: Receiving candidateBeamRSListExt-v1610 set to release releases only the entries that were configured by candidateBeamRSListExt-v1610, and receiving candidateBeamRSListExt-v1610 set to setup replaces only the entries that were configured by candidateBeamRSListExt-v1610 with the newly signalled entries. The network configures these reference signals to be within the linked DL BWP (i.e., within the DL BWP with the same bwp-Id) of the UL BWP in which the BeamFailureRecoveryConfig is provided. ","paragraph_zero_based":14752},{"literal_text_all_w_t_and_m_t":"msg1-SubcarrierSpacing","paragraph_zero_based":14753},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing for contention free beam failure recovery (see TS 38.211 [16], clause 5.3.2).","paragraph_zero_based":14754},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":14755},{"literal_text_all_w_t_and_m_t":"FR1:    15 or 30 kHz","paragraph_zero_based":14756},{"literal_text_all_w_t_and_m_t":"FR2-1:  60 or 120 kHz","paragraph_zero_based":14757},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":14758},{"literal_text_all_w_t_and_m_t":"rsrp-ThresholdSSB","paragraph_zero_based":14759}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["41ef5224285eff004d86cd3d0e079c2fe56fc4184b4dd86361a1cfd78e026ef6","0e9eaf8b4343b08015b3506112b046dfb140b4a7a29f9ac61d469df4b86c4649","2c4eb5195350e06b0cc2fd1a037945dbd87160027d14df2a4f5cfbba9227a588","f481f5dcf91b83101a685251f499b1c2382a1de79bb5dcfd2c0c1d8fdb069581","6e5606f77191e5dd40832fdf1ab4be2072d26a2bd976d2e3bacead505419aca3","fa32bd0fc461cff53568839ddf5151755bb9b65e53f5b0a0faf746f40e691ae7","0de2d7bae27242792473463facff9ff8a137873e3b3795488ee8048a2a5bf644","b77f184783e6b1fecfc0bd53699a862ae05a5005f4bd8b0f0cb3d7817cb4150c","b89832a3e1f462bd12994591faaa3ec26d432edf7d51b20787340dea71b932d6","6cf406158eaaffe1c80befacbdb52d49c8054f1c6c718e47a76f59accd3e5c4c","e08ad58e8ef311d2444a980fd03655e74d4fef95f05cec7d6a755fa62a14a77e","c120ee31afe0e604c34272c40d044dda38536b069b71f3aaa7f9c4ffa682602b","a662b47d6f77387d1b6a720e2a5b720c2f57feda420e2c61fcd3aba569af9284","a9b4f46c92cc9b4f9448e6aaf22568f10ce01422ea705f02957e5ef5ecb96392","8ca49a31ee07203cb419573723dc3ab931cccc3d9c30ff8c2ffac10a0b2660b6","cde563e43c8730d8aa1b36b4bf007e4c0219cf8a98b9146cfbb1642e5740c1b8","75700a7943ef8ba6f6dfcffbc4cd6a71768cd3cd13bc60b45402eb462c3a1b06","cdaa439fc060244210ebd51cafc6ce45c692261383e8a7f82b848153d4b3f928","65567fb02ee80abf718a72bd3fc7144f4ba54a60ebb396a4e028cc64a158bfd6","edfb3b795a075cff2cf50c6e431fb801a508ae0481a1dcc27b0ed9a5863b8e73","f46b9b98515f7106812dc99ac48a91d288265bf570ef051da497f74489c7c789","273e17589e2e097b6b28888fbdb4358bfe88d8aa120361c774b3f463c82ac51d","97009261a1e30f9858f7bd7f93084ccaf10031b7b7eb1af5647a11fea02fdd6c","30b08276d6725b837f9368cd13c9f0dcf2dcea5d7a8b0e49afb7d6921770c154"],"paragraph_range_zero_based":[14736,14759],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p14736"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"L1-RSRP threshold used for determining whether a candidate beam may be used by the UE to attempt contention free random access to recover from beam failure (see TS 38.213 [13], clause 6).","paragraph_zero_based":14760},{"literal_text_all_w_t_and_m_t":"ra-prioritization","paragraph_zero_based":14761},{"literal_text_all_w_t_and_m_t":"Parameters which apply for prioritized random access procedure for BFR (see TS 38.321 [3], clause 5.1.1).","paragraph_zero_based":14762},{"literal_text_all_w_t_and_m_t":"ra-PrioritizationTwoStep","paragraph_zero_based":14763},{"literal_text_all_w_t_and_m_t":"Parameters which apply for prioritized 2-step random access procedure for BFR (see TS 38.321 [3], clause 5.1.1).","paragraph_zero_based":14764},{"literal_text_all_w_t_and_m_t":"ra-ssb-OccasionMaskIndex","paragraph_zero_based":14765},{"literal_text_all_w_t_and_m_t":"Explicitly signalled PRACH Mask Index for RA Resource selection in TS 38.321 [3]. The mask is valid for all SSB resources.","paragraph_zero_based":14766},{"literal_text_all_w_t_and_m_t":"rach-ConfigBFR","paragraph_zero_based":14767},{"literal_text_all_w_t_and_m_t":"Configuration of random access parameters for BFR.","paragraph_zero_based":14768},{"literal_text_all_w_t_and_m_t":"recoverySearchSpaceId","paragraph_zero_based":14769},{"literal_text_all_w_t_and_m_t":"Search space to use for BFR RAR. The network configures this search space to be within the linked DL BWP (i.e., within the DL BWP with the same bwp-Id) of the UL BWP in which the BeamFailureRecoveryConfig is provided. The CORESET associated with the recovery search space cannot be associated with another search space. Network always configures the UE with a value for this field when contention free random access resources for BFR are configured.","paragraph_zero_based":14770},{"literal_text_all_w_t_and_m_t":"rootSequenceIndex-BFR","paragraph_zero_based":14771},{"literal_text_all_w_t_and_m_t":"PRACH root sequence index (see TS 38.211 [16], clause 6.3.3.1) for beam failure recovery.","paragraph_zero_based":14772},{"literal_text_all_w_t_and_m_t":"spCell-BFR-CBRA","paragraph_zero_based":14773},{"literal_text_all_w_t_and_m_t":"Indicates that UE is configured to send MAC CE for SpCell BFR as specified in TS38.321 [3].","paragraph_zero_based":14774},{"literal_text_all_w_t_and_m_t":"ssb-perRACH-Occasion","paragraph_zero_based":14775},{"literal_text_all_w_t_and_m_t":"Number of SSBs per RACH occasion for CF-BFR, see TS 38.213 [13], clause 8.1.","paragraph_zero_based":14776},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14777},{"literal_text_all_w_t_and_m_t":"BFR-CSIRS-Resource field descriptions","paragraph_zero_based":14778},{"literal_text_all_w_t_and_m_t":"csi-RS","paragraph_zero_based":14779},{"literal_text_all_w_t_and_m_t":"The ID of a NZP-CSI-RS-Resource configured in the CSI-MeasConfig of this serving cell. This reference signal determines a candidate beam for beam failure recovery (BFR).","paragraph_zero_based":14780},{"literal_text_all_w_t_and_m_t":"ra-OccasionList","paragraph_zero_based":14781},{"literal_text_all_w_t_and_m_t":"RA occasions that the UE shall use when performing BFR upon selecting the candidate beam identified by this CSI-RS. The network ensures that the RA occasion indexes provided herein are also configured by prach-ConfigurationIndex and msg1-FDM. Each RACH occasion is sequentially numbered, first, in increasing order of frequency resource indexes for frequency multiplexed PRACH occasions; second, in increasing order of time resource indexes for time multiplexed PRACH occasions within a PRACH slot and Third, in increasing order of indexes for PRACH slots.","paragraph_zero_based":14782},{"literal_text_all_w_t_and_m_t":"If the field is absent the UE uses the RA occasion associated with the SSB that is QCLed with this CSI-RS.","paragraph_zero_based":14783}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["1059d432f7684b97e1ddc5848773003b54dc44e6d3480ec3034ee981e2581ab9","e3b292aedb3a8d32237d011fdeef43790667a1105cfb60872b21b711094e99a8","af0dcc8ef3243e51026214efbdba44346124d14bb688fab1bf416685181e447e","6927084133d61128405217fd38d9c9de1eaeec8ab7d3630f6db17619ac47d965","cfc0eab61ebf2af3fd708ceb8521625d8c27eb2c0877c4d7fd1d69063ad41938","c8fc0a5f1cf5ab5b6d8deef4a875433f93029b17a868b2e5bd863f165084600a","08d2c5dbac271adb1f719113ee083992b8d56acdcbf07558d8b5d7109a0c58bb","8bf7235e9610bec8f8a6c5b5a14e23fdf16a0b4874775facd88312b90165025a","b5842a69d82cb490756071438ab633cd391221883b78313be14ce53b09866864","7600ac0918db87131813a8be48a2407d1b91773c6f1d26ad9c819a015bf15af6","adc05c2812b1a1d50894fe48e0abf9550489afd7670d64f9ef61e847d4858137","89632de37e51d2ab4d610481727c503a979c9cd57446f56a21312a77e5d343a2","fb38128654d9d3a5afc998d44614768eadf27bdc3be4cf08ab2f9465463d1f01","a07f89ae78bfc24944345f60a235298fb87bef8e797efec61f690086f48c367c","f84766a136b3a2289aa6d5393226e7a9f01632085441b71c0502b88a54509291","a0865651b4695e45f1680d04c026a0bf0280aa76b207a44eab19226f7c857fce","1f518b47d51cc79504f92daa1a18d41bcb40af6784cae15829f804d33e1a71f2","d07b524318cca6c7358c023328001515884e1e3e33d9d2b9852e641e69fc1f08","f14313ae73fd63f22ff31cb433b4cf7408ef82d17382c6ced458ca349a5a8bb9","10a3b3f7eb2a84dcdce591fa86d35a767ad5ad8eaf75e0302b98257399e2ebf1","5e0336a67370393f15c3da9a0ea1b254208cb76643e8c7d41fb21028c92d598f","e63e991180c885f1acdfdf9492031d24c3274f6bf5cc7ae6f4e20d0cb547d80b","8228acf5c8a539ff7cf18accc3d53e45065e37de6626de171256b6dd30e4cee8","cad584254cf3e24bb49b0c0d31b165977388aa78995b2af44a83ab8869