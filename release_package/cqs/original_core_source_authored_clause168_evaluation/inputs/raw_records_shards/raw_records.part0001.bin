{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18240},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18241},{"literal_text_all_w_t_and_m_t":"INT-ConfigurationPerServingCell ::= SEQUENCE {","paragraph_zero_based":18242},{"literal_text_all_w_t_and_m_t":"    servingCellId                       ServCellIndex,","paragraph_zero_based":18243},{"literal_text_all_w_t_and_m_t":"    positionInDCI                       INTEGER (0..maxINT-DCI-PayloadSize-1)","paragraph_zero_based":18244},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18245},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18246},{"literal_text_all_w_t_and_m_t":"-- TAG-DOWNLINKPREEMPTION-STOP","paragraph_zero_based":18247},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18248},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18249},{"literal_text_all_w_t_and_m_t":"DownlinkPreemption field descriptions","paragraph_zero_based":18250},{"literal_text_all_w_t_and_m_t":"dci-PayloadSize","paragraph_zero_based":18251},{"literal_text_all_w_t_and_m_t":"Total length of the DCI payload scrambled with INT-RNTI (see TS 38.213 [13], clause 11.2).","paragraph_zero_based":18252},{"literal_text_all_w_t_and_m_t":"int-ConfigurationPerServingCell","paragraph_zero_based":18253},{"literal_text_all_w_t_and_m_t":"Indicates (per serving cell) the position of the 14 bit INT values inside the DCI payload (see TS 38.213 [13], clause 11.2).","paragraph_zero_based":18254},{"literal_text_all_w_t_and_m_t":"int-RNTI","paragraph_zero_based":18255},{"literal_text_all_w_t_and_m_t":"RNTI used for indication pre-emption in DL (see TS 38.213 [13], clause 10).","paragraph_zero_based":18256},{"literal_text_all_w_t_and_m_t":"timeFrequencySet","paragraph_zero_based":18257},{"literal_text_all_w_t_and_m_t":"Set selection for DL-preemption indication (see TS 38.213 [13], clause 11.2) The set determines how the UE interprets the DL preemption DCI payload.","paragraph_zero_based":18258},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18259},{"literal_text_all_w_t_and_m_t":"INT-ConfigurationPerServingCell field descriptions","paragraph_zero_based":18260},{"literal_text_all_w_t_and_m_t":"positionInDCI","paragraph_zero_based":18261},{"literal_text_all_w_t_and_m_t":"Starting position (in number of bit) of the 14 bit INT value applicable for this serving cell (servingCellId) within the DCI payload (see TS 38.213 [13], clause 11.2). Must be multiples of 14 (bit).","paragraph_zero_based":18262},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["97766d0f386618837db0e508424a85e97787e962d460839e460ffed81cbd23b6","2dafe3eee0d0bd887014fc95417738a35100beb582078d8968b72cf16e5fc12b","b93e4f2920509d5d34419402a7e73115e5c9a571b665200c844db71917d3044a","0fbaa6cb289f7bcb571a8551016415405e3c572d18d67c527e2f479ea493591f","dcd7bc8f0b1f05c70e74d60dae2dfe69a09dbceb4a20b1926a62405fab9fe877","a7cc012ac4537c090451622b22c9b1ef7e3a2b10b714c00b49a3510c67b885ed","5232479cf58a09a41b746ec21ae6522a2f7368547ca330d11064370beedc94a0","c7272af9ffebf1ab499c7a641d473545123e5724f8ca63664606a9105c248ec4","2c61e2c6b1ec8c42db46f57abb35b602ba878d602f7ef8d929902f762fa55fac","58dd9db90b7cf760d17ec71436f7f72cec3a0e5aaa3df8e98d785ee454153c6e","1f5dca606139550b726353220a5c856fd1adb1f54c9baa6f9b09b0ca06169509","1d6c23f131c8f22774f24e5e34584113c9a0e79671eafe4f5d5625d1dae488ed","18731387a3fad86e33ba74ae0bd51907c28d5227b985bc72bda204bfd9e49489","a056c37a20549c3eca14a94515914