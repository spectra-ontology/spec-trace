{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SL-ThresholdRSRP-Condition1-B-1-r17 ::=   SEQUENCE {","paragraph_zero_based":38280},{"literal_text_all_w_t_and_m_t":"    sl-Priority-r17                           INTEGER (1..8),","paragraph_zero_based":38281},{"literal_text_all_w_t_and_m_t":"    sl-ThresholdRSRP-Condition1-B-1-r17       INTEGER (0..66)","paragraph_zero_based":38282},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":38283},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38284},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-INTERUE-COORDINATIONCONFIG-STOP","paragraph_zero_based":38285},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":38286},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38287},{"literal_text_all_w_t_and_m_t":"SL-InterUE-CoordinationScheme1 field descriptions","paragraph_zero_based":38288},{"literal_text_all_w_t_and_m_t":"sl-Condition1-A-2","paragraph_zero_based":38289},{"literal_text_all_w_t_and_m_t":"Indicates disabling the use of condition of excluding from preferred resource set resource(s) in slot(s) where UE-A, when it is intended receiver of UE-B, does not expect to perform SL reception from UE-B due to half duplex operation.","paragraph_zero_based":38290},{"literal_text_all_w_t_and_m_t":"sl-ContainerCoordInfo","paragraph_zero_based":38291},{"literal_text_all_w_t_and_m_t":"Indicates whether a SCI format 2-C can be used as the container of inter-UE coordination information transmission from UE-A to UE-B in Scheme 1 in addition to using MAC CE.","paragraph_zero_based":38292},{"literal_text_all_w_t_and_m_t":"sl-ContainerRequest","paragraph_zero_based":38293},{"literal_text_all_w_t_and_m_t":"Indicates whether a SCI format 2-C can be used as the container of an explicit request for inter-UE coordination information transmission from UE-B to UE-A in Scheme 1 in addition to using MAC CE.","paragraph_zero_based":38294},{"literal_text_all_w_t_and_m_t":"sl-DetermineResourceType","paragraph_zero_based":38295},{"literal_text_all_w_t_and_m_t":"Indicates how to determine the resource set type to be provided by inter-UE coordination information transmission. Value \"uea\" means the resource set type is determined by UE-A's implementation. Value \"ueb\" means the resource set type is determined by UE-B's request.","paragraph_zero_based":38296},{"literal_text_all_w_t_and_m_t":"sl-IUC-Condition","paragraph_zero_based":38297},{"literal_text_all_w_t_and_m_t":"Indicates whether inter-UE coordination information triggered by a condition is enabled or not other than explicit request reception.","paragraph_zero_based":38298},{"literal_text_all_w_t_and_m_t":"sl-IUC-Explicit","paragraph_zero_based":38299},{"literal_text_all_w_t_and_m_t":"Indicates whether inter-UE coordination information triggered by an explicit request is enabled or not. ","paragraph_zero_based":38300},{"literal_text_all_w_t_and_m_t":"sl-MaxSlotOffsetTRIV","paragraph_zero_based":38301},{"literal_text_all_w_t_and_m_t":"Indicates the maximum value of logical slot offset with respect to a reference slot that is used for representing the first resource location of each TRIV to indicate the set of resources in Scheme 1 as specified in TS 38.214 [19].","paragraph_zero_based":38302},{"literal_text_all_w_t_and_m_t":"sl-NumSubCH-PreferredResousrceSet","paragraph_zero_based":38303}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["bcef1d920fed91eaa9b65a4184f7f0caca02a3ccb235eb28af7f64bb39b7e155","e4a5a344c2b5656e3a79d2393b30a8927e2b1d1404af5d2f512310f6d6a3fe4b","1854397af780310715a7a8acaad1145645c7e13933cbc218a3bc153bf328c25b","f603b380b74e734972d65f216fcf35450f606769cb2e5674a52a6a0499b94119","942aeda3fdc0664cd89cb4373b5614a5b9725590da0f7e3aca3d8f90e1a4cf67","7cb9be15b8e5053ea3c9109b75b5ac786b6354463030c9beed0bf909aea7bdda","5617232e0da8e60d90df6e882550535bd77dedb9765c68739d15e2c04d5276a4","dbeee84c25a59c76771391a63e94f126789144dbf5257547e46f51c5f29a2446","e6520641b9d712c30fcad5419ad408dcc884e2a9678a78a046f215ac7c8c1a3e","fe82f2a36ee0b7d5de8581d442685cf91186f1cb37a251c996d3b402e95f1b48","625026826d8daf0a271dde0b6580a02e34683d5344b78dcc77447da9cc415cb6","145722233fe2d65d49164eceb87a57de633bb5c7a144300db72320b1cd29b296","c515f1b7515f5335135951abde3a824cbb29aeb45a3ad579a009357d8955641b","442ad888bd1dac40956bee0ae271cb6d97a04801846dac64ae1cc649047357ee","66fa98e811155c34a41e18f73cc4148e193033b84fde00f5ec7a3a99afd99eb8","93b734ee2dfd819cf4bc4e87eb8ec294c2752cffe2412a1da8a2252ccb8d83ba","bed8302464c105cb02978f7d4b0aef7f7e3b0e0701b568f1fd48f6a6ee555694","56f5058330909210aa3dcac22b641a28952946886c26a0057176000901999012","36fe23fba914d8176624c7e81bd19f0e729ca6a6ab463b4b5a9fde4d6e44ab1f","8820c1aebcd1ef30aacab958eab9abb105daa2e198eb42796f8b71d3d4bd9569","99aaaf96e5b1bf0fccd76856782655140cd3739a06bdb12479cf101cb31f616c","b635a6d878021fec4d425e3b38b8de7dcc7ed98442b8190997751f965ec1683b","d1a2e72b9849d38e71517f238b5aed1df7bbf26c077a4a7788f00117e4c95f77","c379d4c59bcd88df6a65d9c8e5574c310073a825db7d57af9bcce622a14d605a"],"paragraph_range_zero_based":[38280,38303],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p38280"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the number of sub-channels used for determining the preferred resource set in Scheme 1 when the inter-UE coordination information transmission is triggered by a condition other than explicit request reception.","paragraph_zero_based":38304},{"literal_text_all_w_t_and_m_t":"sl-PriorityCoordInfoCondition","paragraph_zero_based":38305},{"literal_text_all_w_t_and_m_t":"Parameter used to determine the priority values for the purpose defined in TS 38.213 [13] and TS 38.214 [19] including, the priority value for sensing and candidate resource (re-)selection for transmitting the TB carrying the IUC MAC CE and the priority value in the SCI Format 1-A corresponding to the TB carrying the IUC MAC CE, triggered by a condition other than explicit request reception in Scheme 1. The priority value of IUC MAC CE used in LCP procedure (see TS 38.321 [3]) is fixed as \"1\".","paragraph_zero_based":38306},{"literal_text_all_w_t_and_m_t":"sl-PriorityCoordInfoExplicit","paragraph_zero_based":38307},{"literal_text_all_w_t_and_m_t":"Parameter used to determine the priority values for the purpose defined in TS 38.213 [13] and TS 38.214 [19] including, the priority value for sensing and candidate resource (re-)selection for transmitting the TB carrying the IUC MAC CE and the priority value in the SCI Format 1-A corresponding to the TB carrying the IUC MAC CE, triggered by an explicit request in Scheme 1. The priority value of IUC MAC CE used in LCP procedure (see TS 38.321 [3]) is fixed as \"1\".","paragraph_zero_based":38308},{"literal_text_all_w_t_and_m_t":"sl-PriorityPreferredResourceSet","paragraph_zero_based":38309},{"literal_text_all_w_t_and_m_t":"Indicates the priority value used for determining the preferred resource set in Scheme 1 when the inter-UE coordination information transmission is triggered by a condition other than explicit request reception.","paragraph_zero_based":38310},{"literal_text_all_w_t_and_m_t":"sl-PriorityRequest","paragraph_zero_based":38311},{"literal_text_all_w_t_and_m_t":"Parameter used to determine the priority values for the purpose defined in TS 38.213 [13] and TS 38.214 [19] including, the priority value for sensing and candidate resource (re-)selection for transmitting the TB carrying the IUC request MAC CE and the priority value in the SCI Format 1-A corresponding to the TB carrying the IUC request MAC CE, in an explicit request for inter-UE coordination information in Scheme 1. The priority value of IUC request MAC CE used in LCP procedure (see TS 38.321 [3]) is fixed as \"1\".","paragraph_zero_based":38312},{"literal_text_all_w_t_and_m_t":"sl-ReservedPeriodPreferredResourceSet","paragraph_zero_based":38313},{"literal_text_all_w_t_and_m_t":"Indicates the resource reservation interval used for determining the preferred resource set in Scheme 1 when the inter-UE coordination information transmission is triggered by a condition, by means of an index to the corresponding entry of sl-ResourceReservePeriodList-r16. ","paragraph_zero_based":38314},{"literal_text_all_w_t_and_m_t":"sl-TriggerConditionCoordInfo","paragraph_zero_based":38315},{"literal_text_all_w_t_and_m_t":"Indicates the additional alternative trigger condition of inter-UE coordination information triggered by a condition rather than request reception in Scheme-1 from UE-A to UE-B. Value 0 means inter-UE coordination information is triggered by UE-A's implementation. Value 1 means inter-UE coordination information can be triggered only when UE-A has data to be transmitted together with the inter-UE coordination information to UE-B.","paragraph_zero_based":38316},{"literal_text_all_w_t_and_m_t":"sl-TriggerConditionRequest","paragraph_zero_based":38317},{"literal_text_all_w_t_and_m_t":"Indicates the trigger condition of an explicit request from UE-B to UE-A. Value 0 means the explicit request is triggered by UE-B's implementation. Value 1 means the explicit request can be triggered only when UE-B has data to be transmitted to UE-A.","paragraph_zero_based":38318},{"literal_text_all_w_t_and_m_t":"sl-ThresholdRSRP-Condition1-B-1-Option1List","paragraph_zero_based":38319},{"literal_text_all_w_t_and_m_t":"Indicates the RSRP threshold used to determine reserved resource(s) of other UE(s) whose RSRP measurement is larger than it as the set of resource(s) non-preferred for UE-B's transmission for Condition 1-B-1 of Scheme 1, as specified in TS 38.214 [19]. Value 0 corresponds to minus infinity dBm, value 1 corresponds to -128dBm, value 2 corresponds to -126dBm, value n corresponds to (-128 + (n-1)*2) dBm and so on, value 66 corresponds to infinity dBm.","paragraph_zero_based":38320},{"literal_text_all_w_t_and_m_t":"sl-ThresholdRSRP-Condition1-B-1-Option2List","paragraph_zero_based":38321},{"literal_text_all_w_t_and_m_t":"Indicates the RSRP threshold used to determine reserved resource(s) of other UE(s) whose RSRP measurement is smaller than it as the set of resource(s) non-preferred for UE-B's transmission for Condition 1-B-1 of Scheme 1, as specified in TS 38.214 [19]. Value 0 corresponds to minus infinity dBm, value 1 corresponds to -128dBm, value 2 corresponds to -126dBm, value n corresponds to (-128 + (n-1)*2) dBm and so on, value 66 corresponds to infinity dBm.","paragraph_zero_based":38322},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38323},{"literal_text_all_w_t_and_m_t":"SL-InterUE-CoordinationScheme2 field descriptions","paragraph_zero_based":38324},{"literal_text_all_w_t_and_m_t":"sl-DeltaRSRP-Thresh","paragraph_zero_based":38325},{"literal_text_all_w_t_and_m_t":"Indicates the RSRP threshold delta value corresponding to deltaRSRPThresh specified in clause 16.3.0 of TS 38.213 [13] and used to determine reserved resource(s) of other UE(s). Value in dB. Only even values (step size 2) allowed.","paragraph_zero_based":38326},{"literal_text_all_w_t_and_m_t":"sl-IndicationUE-B","paragraph_zero_based":38327}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["bc6931ccd685e94dc9186be7dcb846ad43ccc318ab11bcc4500299f9196c1c5b","323dbb2334cfa1436eae4865d1bd4976fd1cbd07ceccd68ff5e3d8a101e6bce5","34692a908716391b3d9e9af83991015a54928646f49acc74b43f6fe0f387dc3f","b4ad129420887635f3bc12132c9b69c0ba8919e484e6b1b400d32ff1001324ac","65d8d9d365b468ced7da0ff515d842e6288d4e14c1d1d0821c239a14c5169830","55a35442eb0bdd1555c25f75dfaa2c7b3ab59b6fdc1dc390808c91cc135fc387","a8364fdc770b4b1ba0608f7511d4f34c70241d9a2e46ff860fac7d812ab5e2e7","23822419f4c430a4d5163da6f6434df97649a13e935080b0b827fe2625260cb0","e4ac275532fe1f3bef31f97ed4ab5b02c1b452238fd40dabb085a167032bc691","7ed779a0ba30ac2dfb2389d7dfcbb48e6546e24d91706fd7d816dcdff9abc046","9be83b215148c1633098e875b32686a55c9c36c671fa982f8ffe5a7ee91d4ab3","a96d135eebf522cae049bd7d3a48cdaadc4527ea0d9a35ffb0fa0b913a4ea0aa","69b8a9e8e6a2b41cee6b692eaf06637137cbe7eb890ad840c9652a81ac2b2397","619600aad7f3f7157cba56d52b2ceb8440e39d9e54ab9d40b7894d27e0922cfb","f517478ff8df66528476da92f4a4fb870cd7ffbea02537483927a7652a1b7863","7c68c150f033245c9ec889a536148b4a73a0bf73804d474d08e865f99dc62ab9","026ddcfc5808789cb86edff8ba3b82fd84f6d318e95bda8f682ba59af470fb4d","ef6f4f5fbf4e334095e933c01f5626513e2adcf48add1326416f2e700c726763","61c56815d6822530f1cc1c3c1a2367f21a9098c6eac32c966b7c760e05a72579","3e9e64d43c9d57fd9149460a7da7cd38dad6791dd8cdd357a3811d80703e8450","31852a92c3feefe0432a38c3f5467340e2bb8e154f621b5657bd89dab6439321","e1f384003c5a818ffc1aa05c6d6369ed1ade59e051fc1ac2c1b731b3b6c62239","ed35682ed79a539e6a92558a220fa3df19340a54d0dd8c2840ff7837ace3899f","c3d503d1966a45e8ebcbd6679e0bec08673ac7587125d076b46c9df42e56e23d"],"paragraph_range_zero_based":[38304,38327],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p38304"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether to enable or disable the usage of 1 LSB of reserved bits of a SCI format 1-A to indicate of whether UE scheduling a conflict TB can be UE-B or not.","paragraph_zero_based":38328},{"literal_text_all_w_t_and_m_t":"sl-IUC-Scheme2","paragraph_zero_based":38329},{"literal_text_all_w_t_and_m_t":"Indicates whether inter-UE coordination Scheme 2 is enabled or not.","paragraph_zero_based":38330},{"literal_text_all_w_t_and_m_t":"sl-OptionForCondition2-A-1","paragraph_zero_based":38331},{"literal_text_all_w_t_and_m_t":"Indicates the RSRP threshold used to consider additional criteria for condition 2-A-1. Value 0 corresponds to using the RSRP threshold according to the priorities included in the SCI, UE uses thresholds sl-Thres-RSRP-List, in its resource pool configuration sl-UE-SelectedConfigRP, corresponding to ThresPSSCH-RSRP-List specified in clause 16.3.0 of TS 38.213 [13]. Value 1 corresponds to using a (pre)configured RSRP threshold delta value sl-DeltaRSRP-Thresh, corresponding to deltaRSRPThresh specified in clause 16.3.0 of TS 38.213 [13].","paragraph_zero_based":38332},{"literal_text_all_w_t_and_m_t":"sl-PSFCH-Occasion","paragraph_zero_based":38333},{"literal_text_all_w_t_and_m_t":"Indicates the reference slot from which a PSFCH occasion for inter-UE coordination information transmission is derived. Value 0 corresponds to the slot where UE-B's SCI is transmitted and value 1 corresponds to the slot where expected/potential resource conflict occurs on PSSCH resource indicated by UE-B's SCI.","paragraph_zero_based":38334},{"literal_text_all_w_t_and_m_t":"sl-RB-SetPSFCH","paragraph_zero_based":38335},{"literal_text_all_w_t_and_m_t":"Indicates the set of PRBs that are actually used for inter-UE coordination information transmission and reception in Scheme 2. The leftmost bit of the bitmap refers to the lowest RB index in the resource pool, and so on.","paragraph_zero_based":38336},{"literal_text_all_w_t_and_m_t":"sl-SlotLevelResourceExclusion","paragraph_zero_based":38337},{"literal_text_all_w_t_and_m_t":"Indicates that physical layer of UE-B reports resources in a slot including the next reserved resource indicated by the corresponding UE-B's SCI to higher layer.","paragraph_zero_based":38338},{"literal_text_all_w_t_and_m_t":"sl-TypeUE-A","paragraph_zero_based":38339},{"literal_text_all_w_t_and_m_t":"Indicates that a non-destination UE of a TB transmitted by UE-B can be UE-A which sends inter-UE coordination information to UE-B, when UE-A is a destination UE of another TB conflicting with the TB transmitted by UE-B.","paragraph_zero_based":38340},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38341},{"literal_text_all_w_t_and_m_t":"–SL-LogicalChannelConfig","paragraph_zero_based":38342},{"literal_text_all_w_t_and_m_t":"The IE SL-LogicalChannelConfig is used to configure the sidelink logical channel parameters.","paragraph_zero_based":38343},{"literal_text_all_w_t_and_m_t":"SL-LogicalChannelConfig information element","paragraph_zero_based":38344},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":38345},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-LOGICALCHANNELCONFIG-START","paragraph_zero_based":38346},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38347},{"literal_text_all_w_t_and_m_t":"SL-LogicalChannelConfig-r16 ::=            SEQUENCE {","paragraph_zero_based":38348},{"literal_text_all_w_t_and_m_t":"    sl-Priority-r16                            INTEGER (1..8),","paragraph_zero_based":38349},{"literal_text_all_w_t_and_m_t":"    sl-PrioritisedBitRate-r16                  ENUMERATED {kBps0, kBps8, kBps16, kBps32, kBps64, kBps128, kBps256, kBps512,","paragraph_zero_based":38350},{"literal_text_all_w_t_and_m_t":"                                               kBps1024, kBps2048, kBps4096, kBps8192, kBps16384, kBps32768, kBps65536, infinity},","paragraph_zero_based":38351}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["f58dff1c9011dafe807d8046cdd0fce5593c368ab4d744c8f974794c6b05c1b6","68c196a3de91e52cb48621ea702834dc1a24d324ee0782c34c72632f6e5f3bb1","a033cb0252634d65a82140b4c9e7bceca3d8204f12df62c9c5b670add1789b23","a8082ad998353f795624ad0a12f7f3b79a2c0fde70a195c73a865fe911755344","4db321ab9b950efc273e6331955d147451d10388814eb38b79bf8b54f48752d2","1843b665685af12521e531a11875b85421ba16d7cb74f5566afa97cbc9fa85c1","04bbd2dd1c3d90925fc8171ba53c534c94f1735a4b7b71f88ea00c1ef7aec4fa","fe9389b2f869eb7f7343459d0543eaee380756666de27d16576b024d2f618c90","c4d56b36e0832bea546c51ac7aa242b41925a135ebf87faeb4f1be1e76de043d","45dbff35976bee81a8717e40d7ee6dc0c936f46ee6870b286f107afd10139ed6","ccd50527876f9ee9640f58d6b2288b7b1dbea0d3bd862843dfdfb5cc3d268156","da6307c529cfbc5d2b205281b567d6cd3336c71119b3cf285732c3c0b5d1ec69","c0c9e68f34e9538f5b47a274f8f204586964dd982a012935aaedde703974ce10","a7aa1b814b8061fa9bfc6e55a9e338976fd7eca28c2ec9c2394dadfa8292eba0","d25f67841d9c9e82bee1a576fd77f9bd076e9c90f9af957593ae964458f0e0b6","db4283892d515740e920eaed93c8933b1711dab71a1b8f51b7bc0da955c0df34","034637cc1a9a0772c17d938be906c96263eb9a393ef7378159427d25ce196e71","89830ca57b9dd91f250e5f056f6b3c0a618790145cc22d8ba77e5de8bb73c94d","20d65734daee4e667209ddc2f3900869c58ae10678e66e54755a3729b0a1be2b","845b7ec968a3286412d61661e76c8255b375e5316a9d0b6f348bce7da3d1fb7a","57234cd073177372de33c165c3ce16678e991bb69b7ae8631bd5d7a076fc9d4b","2c7508c501dfd942d47e421cbfa25ecd93292e797a7adcd29573f30f7894e01a","8aa40806745d20da290bc3c5dec9876ff2c13811cb31160a7a6a4e414d97c71c","668c29a943b2b24