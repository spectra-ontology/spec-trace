{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"                                        ms5120}","paragraph_zero_based":29880},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29881},{"literal_text_all_w_t_and_m_t":"-- TAG-TIMETOTRIGGER-STOP","paragraph_zero_based":29882},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29883},{"literal_text_all_w_t_and_m_t":"–UAC-BarringInfoSetIndex","paragraph_zero_based":29884},{"literal_text_all_w_t_and_m_t":"The IE UAC-BarringInfoSetIndex provides the index of the entry in uac-BarringInfoSetList. Value 1 corresponds to the first entry in uac-BarringInfoSetList, value 2 corresponds to the second entry in this list and so on. An index value referring to an entry not included in uac-BarringInfoSetList indicates no barring.","paragraph_zero_based":29885},{"literal_text_all_w_t_and_m_t":"UAC-BarringInfoSetIndex information element","paragraph_zero_based":29886},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29887},{"literal_text_all_w_t_and_m_t":"-- TAG-UAC-BARRINGINFOSETINDEX-START","paragraph_zero_based":29888},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29889},{"literal_text_all_w_t_and_m_t":"UAC-BarringInfoSetIndex ::=                INTEGER (1..maxBarringInfoSet)","paragraph_zero_based":29890},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29891},{"literal_text_all_w_t_and_m_t":"-- TAG-UAC-BARRINGINFOSETINDEX-STOP","paragraph_zero_based":29892},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29893},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29894},{"literal_text_all_w_t_and_m_t":"–UAC-BarringInfoSetList","paragraph_zero_based":29895},{"literal_text_all_w_t_and_m_t":"The IE UAC-BarringInfoSetList provides a list of access control parameter sets. An access category can be configured with access parameters according to one of the sets.","paragraph_zero_based":29896},{"literal_text_all_w_t_and_m_t":"UAC-BarringInfoSetList information element","paragraph_zero_based":29897},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29898},{"literal_text_all_w_t_and_m_t":"-- TAG-UAC-BARRINGINFOSETLIST-START","paragraph_zero_based":29899},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29900},{"literal_text_all_w_t_and_m_t":"UAC-BarringInfoSetList ::=          SEQUENCE (SIZE(1..maxBarringInfoSet)) OF UAC-BarringInfoSet","paragraph_zero_based":29901},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29902},{"literal_text_all_w_t_and_m_t":"UAC-BarringInfoSetList-v1700 ::= SEQUENCE (SIZE(1..maxBarringInfoSet)) OF UAC-BarringInfoSet-v1700","paragraph_zero_based":29903}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["76864143e9d53f32733bdb935c49c452a37d7ab9cc53a1a673b813fd252c1015","afb8b62681e80a9e8c769c4a1cd8cc4fa7ef262ff6bc82f5fc6673a554e01760","68445e6bd139e213f37dfafbfe41e7af3183e9e787fdb4088e61bca1e59d34e5","066844be43b24205c4ba2cf3779532f3cb25128f2012fac245e24a0811d7a818","4a775cc37c54ddfbe341764c47b32ab430456c122004c2ff0bf4ad63ac599161","8a1b39fac1368c5a3db3e2d874ca3dd34314e21b7f17c3282aa34af75d73f672","621665d355af8051582f9a32582d6c3e0ad29cc5c814af3b5681e2822eb8289a","e0ad9e1b61840bb53996f9332cd400ff680d8fef039645615442e181b41f4bd8","a9acc2009c3c03d79fb58ab61ae5f7e8b9bd5583b7048a5c5c2cd2b057bcc3ca","91c59cb87cdfeb3c2678a8d8ab7b143882c50a30342e06a6b5b15ea3858ad082","1cba55f9380d991bae857716305e990bd6c2ad7af414c814f85e9116c965ed55","c95927742e6959c33883aedc6ec3f1049aca1a4d74254f0634a9940a110b8b1d","7775740d50fbb