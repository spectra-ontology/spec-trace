{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-SIPOS-STOP","paragraph_zero_based":14496},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":14497},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14498},{"literal_text_all_w_t_and_m_t":"SIBpos field descriptions","paragraph_zero_based":14499},{"literal_text_all_w_t_and_m_t":"assistanceDataSIB-Element","paragraph_zero_based":14500},{"literal_text_all_w_t_and_m_t":"Parameter AssistanceDataSIBelement defined in TS 37.355 [49]. The first/leftmost bit of the first octet contains the most significant bit.","paragraph_zero_based":14501},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14502},{"literal_text_all_w_t_and_m_t":"6.3.2Radio resource control information elements","paragraph_zero_based":14503},{"literal_text_all_w_t_and_m_t":"–AdditionalSpectrumEmission","paragraph_zero_based":14504},{"literal_text_all_w_t_and_m_t":"The IEs AdditionalSpectrumEmission and AdditionalSpectrumEmission-v1760 are used to indicate emission requirements to be fulfilled by the UE (see TS 38.101-1 [15], clause 6.2.3/6.2A.3, TS 38.101-2 [39], clause 6.2.3/6.2A.3, and TS 38.101-5 [75], clause 6.2.3). If an extension is signalled using the extended value range (as defined by the IE AdditionalSpectrumEmission-v1760), the corresponding original field, using the value range as defined by the IE AdditionalSpectrumEmission (without suffix) shall be set to value 7.","paragraph_zero_based":14505},{"literal_text_all_w_t_and_m_t":"AdditionalSpectrumEmission information element","paragraph_zero_based":14506},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":14507},{"literal_text_all_w_t_and_m_t":"-- TAG-ADDITIONALSPECTRUMEMISSION-START","paragraph_zero_based":14508},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14509},{"literal_text_all_w_t_and_m_t":"AdditionalSpectrumEmission ::=              INTEGER (0..7)","paragraph_zero_based":14510},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14511},{"literal_text_all_w_t_and_m_t":"AdditionalSpectrumEmission-v1760 ::=        INTEGER (8..39)","paragraph_zero_based":14512},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14513},{"literal_text_all_w_t_and_m_t":"AdditionalSpectrumEmission-r18 ::=          INTEGER (0..39)","paragraph_zero_based":14514},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14515},{"literal_text_all_w_t_and_m_t":"-- TAG-ADDITIONALSPECTRUMEMISSION-STOP","paragraph_zero_based":14516},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":14517},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14518},{"literal_text_all_w_t_and_m_t":"–Alpha","paragraph_zero_based":14519}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["4e8a4ea97a9cc840126cd31512d377ed8b9de10b634615d89b3e5570886ec41d","11765951b94a08f18324c85da0b99e3ec5dcb7f9984d257455b466822fa99ede","86d3e3ee5d81b638ab72d955dd222201954b48da92c6de7153f15308a5df4621","e15c0b7d3b5e3ba66359aecb1a262c6f9f0c72fd82505f6c4a17384def295e80","b9aa83e2bd6dc4769b5b7ee501d3069f6da857978c6232eeeffd2e2fb155366a","c20d9150a9f75d43ecf23a174871bcfc5a36b85601a1cec38b39cf314ccc22f2","eeca5a7a85eebf5ed92e81b846bf96a69d375f6a5e0da17c57adbc1d2a0960fc","14e34d696e14610a860874a933c423ce56e656a6ce2dac6ea91c5465bababc08","a4c99f437079f9aa47f233c13579638e98653507ac1bb43f2fcd10813c788467","1d9b7e307052a51c2fd2912a3dfdd279bb545835e701cf6662b381cd0ad59a32","662253ee9342ab00d9f3f3e6a2fdf7aaacf7302da293561aae28c54d01b59904","2a27f6b5101d1221fb86a1aa9ab037404281f5420b1b0347509c8ecc1d1cc414","f813d2b9b59d43e3fd9bcd6cc969c609979ad0f746296691f98dd914f881fa84","1f95a24b587d2b80f9656178edfddf9d1f79eaee6bcd4060d61471a05f8287c0","9cee853e86e07e7b9c8453907b5ef3e3e0aa4a88d73f79c9fab62ef2f54bf1da","a40a38c02c05a2507b89f943f9ee643cd400385739814607333e21a28fe0cebe","b8dd4cead5dc8f6d728ca562da622c448eb034a8a305352cf5ed4b9ecd6ca53f","25a0f940a46031509569ead44bab9ae82809837f9730564f315540e51af706e7","cb747343b80fbac8ab13d8a934622ed41c856cb4ca24f2b01fff1611f39459df","f9fe6ad5a3b286c4fee1fb8ee4e6f90981559ecc419794ff24a5fd90c137bd5e","6bd83704c24c415a35f56b9ea7688c15751e98a1aa81d1da850976ca92132ba5","176a8a66ed0b840401e11cb73179f598a037efbeee4f3e149c7bd6cddc514dcd","8ffe4140d8a3d853689b97826c2244975b71426d3874ef83c42cee538ef3143a","17cb3934f0aa3bad4fb45ede62e0dbb9eefa3e6b20ddc0deaea15547fcbe551d"],"paragraph_range_zero_based":[14496,14519],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p14496"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE Alpha defines possible values of a the pathloss compensation coefficient for uplink power control. Value alpha0 corresponds to the value 0, Value alpha04 corresponds to the value 0.4, Value alpha05 corresponds to the value 0.5 and so on. Value alpha1 corresponds to value 1. See also clause 7.1 of TS 38.213 [13].","paragraph_zero_based":14520},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":14521},{"literal_text_all_w_t_and_m_t":"-- TAG-ALPHA-START","paragraph_zero_based":14522},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14523},{"literal_text_all_w_t_and_m_t":"Alpha ::=                       ENUMERATED {alpha0, alpha04, alpha05, alpha06, alpha07, alpha08, alpha09, alpha1}","paragraph_zero_based":14524},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14525},{"literal_text_all_w_t_and_m_t":"-- TAG-ALPHA-STOP","paragraph_zero_based":14526},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":14527},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14528},{"literal_text_all_w_t_and_m_t":"–Altitude","paragraph_zero_based":14529},{"literal_text_all_w_t_and_m_t":"The IE Altitude is used to indicate altitude relative to sea level. The actual value is the field value in meters.","paragraph_zero_based":14530},{"literal_text_all_w_t_and_m_t":"Altitude information element","paragraph_zero_based":14531},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":14532},{"literal_text_all_w_t_and_m_t":"-- TAG-ALTITUDE-START","paragraph_zero_based":14533},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14534},{"literal_text_all_w_t_and_m_t":"Altitude-r18 ::=              INTEGER (minAltitude-r18..maxAltitude-r18)","paragraph_zero_based":14535},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14536},{"literal_text_all_w_t_and_m_t":"-- TAG-ALTITUDE-STOP","paragraph_zero_based":14537},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":14538},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14539},{"literal_text_all_w_t_and_m_t":"–AMF-Identifier","paragraph_zero_based":14540},{"literal_text_all_w_t_and_m_t":"The IE AMF-Identifier (AMFI) comprises of an AMF Region ID, an AMF Set ID and an AMF Pointer as specified in TS 23.003 [21], clause 2.10.1.","paragraph_zero_based":14541},{"literal_text_all_w_t_and_m_t":"AMF-Identifier information element","paragraph_zero_based":14542},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":14543}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["96f0634a803ce4964feb94c9d6279feb93f1f525b56dc05e83aa5998f057178f","d57e90e318d605418963173ed305877b8b97a8320c06949551a732b9aef03c8f","16f87dbd1b700be43ed74e4cde6d76169e4929894810528af981c039f62969ee","55d29a02641196a68e076957712a091cd682d48483d66de9fa71ab1228295a40","a400c167f74608e021b5e7d39d255d094b6c60d63da6b7c2a327d670c703585e","dac3453d1d149c186920bb81d9a466d6b40aba676e83159cd67d6531c6952239","95897d3ee17422d0d97cafb3d9852534b0ff768cf5b9f2c633d9d71612b16cfc","ea43442c96d57934c6c0d8cab5d5db1c0d0189f207aaff18db2e0b4b906f4b69","f2d1cbdb8a97dcd601006518d4dc43e603d1679bb277beb0e116dbcbd70ba59a","2f3f2cef2bbff487d581b1ef70b43fbceb7413238f19db8298bac71657403df2","6098eacf8f55ad991beac1b6415ad48915b6c33f062255275f77975339e00322","aae4832e4e234807436358a9f7e823dd5f5f5e25584f250b6bd0c8cff3cdcc03","670ea77649f95cea32b28d1c02afa07f9f9ce382737acfd7ea19908de6059c21","2aa2185bc72d846a16da8c87c2a3fbca3794dff8207dbe02ce6153bc6c383a06","cae3d9e10