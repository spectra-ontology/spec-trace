8adc7747b32a3b5ae0d77d3e92180c13d3219fe9","7a8e6dc4ff6e6314b1cd753d130e15947428db899614a6714ae01a3e735a0ebf","d5d724a8d3e0ed4b3af6c03d88267a7b0c1e2046161848e55d26e2bb03b7f9f9","ada01aec276818b2a71315d61b610fd1803b1bff5e1901fe546de8c73bdd0970","3a1c56a86821539470170986802006f673db19f4c46198adfeafbae0f1876f5e","1767e18849b4544f17ab6c6086aad642dc753f493be862dfaa2563c72409aff8","9b4d45cb8319c3ef0a5559033265cd0e27e55023fd582fd09a8e7a364ad28598","465603dfa9cecf42741fc86a852aa8c81931015ad26a9a34b1d1651ae5dae66d","9a5f76493d93f513a4e7a888d77e5f93dfc7d16048b7650f0a5c6c204c9ed295","68da9b670e19ffd0906dabe0c3371c2f16ba40055d43143b15689ba56b2538c6","a16aef60096c7959ac64e3a0e9de997f140d7d53b54a661deba461561ba6064e","ca853f6d7b290bc746b59d588138bde9d975acb57770592768a7b1df6510db1f","16a044c8bc05586d8960603f32d5aab3bcd7da1f5294c5734cd4967cf9e13a81","af299bb6d32957cca0719b41d17ea921e083dbc62eb2342613167a8b2440aa16","672ff0c9284afa2fb75469b6929ebc9507ebbb80b896ccf45fbe6d8aba92fac5"],"paragraph_range_zero_based":[13872,13895],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p13872"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Distance from the serving cell reference location and is used in location-based measurement initiation in RRC_IDLE and RRC_INACTIVE, as defined in TS 38.304 [20]. Each step represents 50m.","paragraph_zero_based":13896},{"literal_text_all_w_t_and_m_t":"ntn-Config","paragraph_zero_based":13897},{"literal_text_all_w_t_and_m_t":"Provides parameters needed for the UE to access NR via NTN access such as Ephemeris data, common TA parameters, k_offset, validity duration for UL sync information and epoch.","paragraph_zero_based":13898},{"literal_text_all_w_t_and_m_t":"ntn-NeighCellConfigList, ntn-NeighCellConfigListExt","paragraph_zero_based":13899},{"literal_text_all_w_t_and_m_t":"Provides a list of NTN neighbour cells including their ntn-Config, carrier frequency and PhysCellId. This set includes all elements of ntn-NeighCellConfigList and all elements of ntn-NeighCellConfigListExt. If ntn-Config is absent for an entry in ntn-NeighCellConfigListExt, the ntn-Config provided in the entry at the same position in ntn-NeighCellConfigList applies. Network provides ntn-Config for the first entry of ntn-NeighCellConfigList. If the ntn-Config is absent for any other entry in ntn-NeighCellConfigList, the ntn-Config provided in the previous entry in ntn-NeighCellConfigList applies.","paragraph_zero_based":13900},{"literal_text_all_w_t_and_m_t":"referenceLocation","paragraph_zero_based":13901},{"literal_text_all_w_t_and_m_t":"Reference location of the serving cell provided via NTN quasi-Earth fixed system and is used in location-based measurement initiation in RRC_IDLE and RRC_INACTIVE, as defined in TS 38.304 [20].","paragraph_zero_based":13902},{"literal_text_all_w_t_and_m_t":"t-Service","paragraph_zero_based":13903},{"literal_text_all_w_t_and_m_t":"Indicates the time information on when a cell provided via NTN quasi-Earth fixed system is going to stop serving the area it is currently covering. The field indicates a time in multiples of 10 ms after 00:00:00 on Gregorian calendar date 1 January, 1900 (midnight between Sunday, December 31, 1899 and Monday, January 1, 1900). The exact stop time is between the time indicated by the value of this field minus 1 and the time indicated by the value of this field.","paragraph_zero_based":13904},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13905},{"literal_text_all_w_t_and_m_t":"–SIB20","paragraph_zero_based":13906},{"literal_text_all_w_t_and_m_t":"SIB20 contains the information required to acquire the MCCH/MTCH configuration for MBS broadcast.","paragraph_zero_based":13907},{"literal_text_all_w_t_and_m_t":"SIB20 information element","paragraph_zero_based":13908},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":13909},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB20-START","paragraph_zero_based":13910},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13911},{"literal_text_all_w_t_and_m_t":"SIB20-r17 ::=SEQUENCE {","paragraph_zero_based":13912},{"literal_text_all_w_t_and_m_t":"    mcch-Config-r17                MCCH-Config-r17,","paragraph_zero_based":13913},{"literal_text_all_w_t_and_m_t":"    cfr-ConfigMCCH-MTCH-r17        CFR-ConfigMCCH-MTCH-r17 OPTIONAL,  -- Need S","paragraph_zero_based":13914},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension       OCTET STRING            OPTIONAL,","paragraph_zero_based":13915},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":13916},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":13917},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13918},{"literal_text_all_w_t_and_m_t":"MCCH-Config-r17 ::= SEQUENCE {","paragraph_zero_based":13919}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML