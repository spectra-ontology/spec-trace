{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"highSpeedMeasFlagFR2","paragraph_zero_based":18888},{"literal_text_all_w_t_and_m_t":"If the field is present, the UE shall apply enhanced intra-NR RRM requirement set one to support high speed up to 350 km/h for FR2 as specified in TS 38.133 [14], if the field value is set1 or RRM requirement set two if the field value is set2.","paragraph_zero_based":18889},{"literal_text_all_w_t_and_m_t":"highSpeedMeasInterFreq","paragraph_zero_based":18890},{"literal_text_all_w_t_and_m_t":"If the field is present and UE supports measurementEnhancementInterFreq-r17, the UE shall apply the enhanced RRM requirements for inter-frequency measurement in RRC_CONNECTED to support high speed up to 500 km/h as specified in TS 38.133 [14].","paragraph_zero_based":18891},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18892},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":18893},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":18894},{"literal_text_all_w_t_and_m_t":"SCellOnly","paragraph_zero_based":18895},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, in ServingCellConfigCommon of an SCell. It is absent otherwise.","paragraph_zero_based":18896},{"literal_text_all_w_t_and_m_t":"SpCellOnly","paragraph_zero_based":18897},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, in ServingCellConfigCommonSIB or in the ServingCellConfigCommon of an SpCell. It is absent otherwise.","paragraph_zero_based":18898},{"literal_text_all_w_t_and_m_t":"SpCellOnly2","paragraph_zero_based":18899},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, in ServingCellConfigCommon of an SpCell. It is absent otherwise.","paragraph_zero_based":18900},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18901},{"literal_text_all_w_t_and_m_t":"–Hysteresis","paragraph_zero_based":18902},{"literal_text_all_w_t_and_m_t":"The IE Hysteresis is a parameter used within the entry and leave condition of an event triggered reporting condition. The actual value is field value * 0.5 dB.","paragraph_zero_based":18903},{"literal_text_all_w_t_and_m_t":"Hysteresis information element","paragraph_zero_based":18904},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18905},{"literal_text_all_w_t_and_m_t":"-- TAG-HYSTERESIS-START","paragraph_zero_based":18906},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18907},{"literal_text_all_w_t_and_m_t":"Hysteresis ::=                      INTEGER (0..30)","paragraph_zero_based":18908},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18909},{"literal_text_all_w_t_and_m_t":"-- TAG-HYSTERESIS-STOP","paragraph_zero_based":18910},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18911}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["a62cb9132e2af1f4c33b6558a31427596f5efc64c8c913256a2f9877afe66c08","5ee1bdd72306a145af33690c2837ce54e4510fb95dcc433d6d0affa7da503be8","4804097bb94edd2f69a5d3f235360a1af223ee0354aaf089c75a1d1a69587c3f","1685b8f0de45990511ad2847fb958ac5ea8981b5169397587619b87ca26c6bb7","99eace582708b4e4523399e2483b6db9d17ee8eaac5c66a74e5e71f956b9152c","a2f05285d9a12414c51abc98013cb11c1105362114e4330d385cad26e2afc9b2","4df7b39e96ffe3515d3be57802c7f25006c8ac77f716298a8b7550f2614fbd9c","755d4270f15176856dd70b34a4c701d02dd6144dc681cb289a71c525999bd48b","30630a3c18ca082daafe9b54e852c19b54f002fea5e2dd32132c9a91f757ceee","d1818db019d653e51605c0d1dc92ceb4478aa3fea5538c18ea9a3c73bf5ef3