{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":15264},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":15265},{"literal_text_all_w_t_and_m_t":"    sl-PUCCH-Config-r16                 SetupRelease { PUCCH-Config }                                           OPTIONAL,   -- Need M","paragraph_zero_based":15266},{"literal_text_all_w_t_and_m_t":"    cp-ExtensionC2-r16                  INTEGER (1..28)                                                         OPTIONAL,   -- Need R","paragraph_zero_based":15267},{"literal_text_all_w_t_and_m_t":"    cp-ExtensionC3-r16                  INTEGER (1..28)                                                         OPTIONAL,   -- Need R","paragraph_zero_based":15268},{"literal_text_all_w_t_and_m_t":"    useInterlacePUCCH-PUSCH-r16         ENUMERATED {enabled}                                                    OPTIONAL,   -- Need R","paragraph_zero_based":15269},{"literal_text_all_w_t_and_m_t":"    pucch-ConfigurationList-r16         SetupRelease { PUCCH-ConfigurationList-r16 }                            OPTIONAL,   -- Need M","paragraph_zero_based":15270},{"literal_text_all_w_t_and_m_t":"    lbt-FailureRecoveryConfig-r16       SetupRelease { LBT-FailureRecoveryConfig-r16 }                          OPTIONAL,   -- Need M","paragraph_zero_based":15271},{"literal_text_all_w_t_and_m_t":"    configuredGrantConfigToAddModList-r16                 ConfiguredGrantConfigToAddModList-r16                 OPTIONAL,   -- Need N","paragraph_zero_based":15272},{"literal_text_all_w_t_and_m_t":"    configuredGrantConfigToReleaseList-r16                ConfiguredGrantConfigToReleaseList-r16                OPTIONAL,   -- Need N","paragraph_zero_based":15273},{"literal_text_all_w_t_and_m_t":"    configuredGrantConfigType2DeactivationStateList-r16   ConfiguredGrantConfigType2DeactivationStateList-r16   OPTIONAL    -- Need R","paragraph_zero_based":15274},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":15275},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":15276},{"literal_text_all_w_t_and_m_t":"    ul-TCI-StateList-r17                CHOICE {","paragraph_zero_based":15277},{"literal_text_all_w_t_and_m_t":"        explicitlist                        SEQUENCE {","paragraph_zero_based":15278},{"literal_text_all_w_t_and_m_t":"            ul-TCI-ToAddModList-r17             SEQUENCE (SIZE (1..maxUL-TCI-r17)) OF TCI-UL-State-r17          OPTIONAL,   -- Need N","paragraph_zero_based":15279},{"literal_text_all_w_t_and_m_t":"            ul-TCI-ToReleaseList-r17            SEQUENCE (SIZE (1..maxUL-TCI-r17)) OF TCI-UL-StateId-r17        OPTIONAL    -- Need N","paragraph_zero_based":15280},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":15281},{"literal_text_all_w_t_and_m_t":"        unifiedTCI-StateRef-r17         ServingCellAndBWP-Id-r17","paragraph_zero_based":15282},{"literal_text_all_w_t_and_m_t":"    }                                                                                                           OPTIONAL,  -- Need R","paragraph_zero_based":15283},{"literal_text_all_w_t_and_m_t":"    ul-powerControl-r17                Uplink-powerControlId-r17                                                OPTIONAL,  -- Cond NoTCI-PC","paragraph_zero_based":15284},{"literal_text_all_w_t_and_m_t":"    pucch-ConfigurationListMulticast1-r17  SetupRelease { PUCCH-ConfigurationList-r16 }                         OPTIONAL,  -- Need M","paragraph_zero_based":15285},{"literal_text_all_w_t_and_m_t":"    pucch-ConfigurationListMulticast2-r17  SetupRelease { PUCCH-ConfigurationList-r16 }                         OPTIONAL   -- Need M","paragraph_zero_based":15286},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":15287}],"source":"Whole authentic original CR source member; all unfiltered bo