{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-CONFIGURATIONLIST-START","paragraph_zero_based":23832},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23833},{"literal_text_all_w_t_and_m_t":"PUCCH-ConfigurationList-r16  ::=     SEQUENCE (SIZE (1..2)) OF PUCCH-Config","paragraph_zero_based":23834},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23835},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-CONFIGURATIONLIST-STOP","paragraph_zero_based":23836},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23837},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23838},{"literal_text_all_w_t_and_m_t":"–PUCCH-PathlossReferenceRS-Id","paragraph_zero_based":23839},{"literal_text_all_w_t_and_m_t":"The IE PUCCH-PathlossReferenceRS-Id is an ID for a reference signal (RS) configured as PUCCH pathloss reference (see TS 38.213 [13], clause 7.2).","paragraph_zero_based":23840},{"literal_text_all_w_t_and_m_t":"PUCCH-PathlossReferenceRS-Id information element","paragraph_zero_based":23841},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":23842},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-PATHLOSSREFERENCERS-ID-START","paragraph_zero_based":23843},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23844},{"literal_text_all_w_t_and_m_t":"PUCCH-PathlossReferenceRS-Id ::=            INTEGER (0..maxNrofPUCCH-PathlossReferenceRSs-1)","paragraph_zero_based":23845},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23846},{"literal_text_all_w_t_and_m_t":"PUCCH-PathlossReferenceRS-Id-v1610 ::=      INTEGER (maxNrofPUCCH-PathlossReferenceRSs..maxNrofPUCCH-PathlossReferenceRSs-1-r16)","paragraph_zero_based":23847},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23848},{"literal_text_all_w_t_and_m_t":"PUCCH-PathlossReferenceRS-Id-r17 ::=        INTEG