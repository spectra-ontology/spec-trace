{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13536},{"literal_text_all_w_t_and_m_t":"HRNN-r16 ::=                SEQUENCE {","paragraph_zero_based":13537},{"literal_text_all_w_t_and_m_t":"    hrnn-r16                    OCTET STRING (SIZE(1.. maxHRNN-Len-r16))        OPTIONAL   -- Need R","paragraph_zero_based":13538},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":13539},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13540},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB10-STOP","paragraph_zero_based":13541},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":13542},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13543},{"literal_text_all_w_t_and_m_t":"SIB10 field descriptions","paragraph_zero_based":13544},{"literal_text_all_w_t_and_m_t":"HRNN-List","paragraph_zero_based":13545},{"literal_text_all_w_t_and_m_t":"The same amount of HRNN (see TS 23.003 [21]) elements as the number of NPNs in SIB 1 are included. The n-th entry of HRNN-List contains the human readable network name of the n-th NPN of SIB1. The hrnn in the corresponding entry in HRNN-List is absent if there is no HRNN associated with the given NPN.","paragraph_zero_based":13546},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13547},{"literal_text_all_w_t_and_m_t":"–SIB11","paragraph_zero_based":13548},{"literal_text_all_w_t_and_m_t":"SIB11 contains information related to idle/inactive measurements.","paragraph_zero_based":13549},{"literal_text_all_w_t_and_m_t":"SIB11 information element","paragraph_zero_based":13550},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":13551},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB11-START","paragraph_zero_based":13552},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13553},{"literal_text_all_w_t_and_m_t"