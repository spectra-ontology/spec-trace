{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"            cgi-Info-r17                 CGI-Info-Logging-r16,","paragraph_zero_based":37440},{"literal_text_all_w_t_and_m_t":"            pci-arfcn-r17                PCI-ARFCN-NR-r16","paragraph_zero_based":37441},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":37442},{"literal_text_all_w_t_and_m_t":"        eutra-CellId-r17         CHOICE {","paragraph_zero_based":37443},{"literal_text_all_w_t_and_m_t":"            cellGlobalId-r17         CGI-InfoEUTRALogging,","paragraph_zero_based":37444},{"literal_text_all_w_t_and_m_t":"            pci-arfcn-r17            PCI-ARFCN-EUTRA-r16","paragraph_zero_based":37445},{"literal_text_all_w_t_and_m_t":"        }","paragraph_zero_based":37446},{"literal_text_all_w_t_and_m_t":"    }                                                 OPTIONAL,","paragraph_zero_based":37447},{"literal_text_all_w_t_and_m_t":"    timeSpent-r17            INTEGER (0..4095),","paragraph_zero_based":37448},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":37449},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37450},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37451},{"literal_text_all_w_t_and_m_t":"-- TAG-VISITEDCELLINFOLIST-STOP","paragraph_zero_based":37452},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":37453},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37454},{"literal_text_all_w_t_and_m_t":"VisitedCellInfoList field descriptions","paragraph_zero_based":37455},{"literal_text_all_w_t_and_m_t":"timeSpent","paragraph_zero_based":37456},{"literal_text_all_w_t_and_m_t":"This field indicates the duration of stay in the cell or in any cell selection state and/or camped on any cell state in NR or E-UTRA approximated to the closest second. If included in VisitedPSCellInfo, it indicates the duration of stay in the PSCell or without any PSCell. If the duration of stay exceeds 4095s, the UE shall set it to 4095s.","paragraph_zero_based":37457},{"literal_text_all_w_t_and_m_t":"visitedCellId","paragraph_zero_based":37458},{"literal_text_all_w_t_and_m_t":"This field indicates the visited cell id including NR and E-UTRA cells.","paragraph_zero_based":37459},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37460},{"literal_text_all_w_t_and_m_t":"–WLAN-NameList","paragraph_zero_based":37461},{"literal_text_all_w_t_and_m_t":"The IE WLAN-NameList is used to indicate the names of the WLAN AP for which the UE is configured to measure.","paragraph_zero_based":37462},{"literal_text_all_w_t_and_m_t":"WLAN-NameList information element","paragraph_zero_based":37463}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["57eb5bd9587ef34a39c1fde3da44fc4d2de89f575c73fa4519c6a5c6f0f9b51b","df00d6d2e2368dde182b2c99a1027e426b9eee2316800883e7f1b1c3ee470a82","338846f655cee63c773fa27a6c02345df7eb9dadba6b6720cd577f351d384267","6cb3f1916988f1820f81f223c2d168a92957eb6bed6474809e8a705dababcbe7","cc6b0f20f0b75298d87c67c4c93fc78df67c6646140aaae435eebfe50f1a8d52","9257ad0a0cc713c30d0f7a1373a314768fbff380352321f2d7a599556b1c3280","79f79b78fb2d2a0e115b55133a7c8501bf5298e9b44d7ff80483a987ea7567ee","f88a8ed8cfcc2f5664996e0adbfce5b6a83a609b5314cdc3307a44458397b453","9ce1ea45a251e124bcdd6fa3796ae8a932c47511145d6f42f714289a385137ad","6e28238682ad9de0679438a426207b1ef1039abd114dc68ba9aa94dd19b26d60","181952f43e48a73eb51e7a0bf585332e52edac510a21b0f9d197b2bfc30cbda4","1296fe0bdda0f3454bc7ad84330a44461e64a469c1322e5e32651984cbec143d","8ecd51b6ffca11ca97d5edfbd41862c589903f19