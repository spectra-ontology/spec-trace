{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE PCI-List concerns a list of physical cell identities, which may be used for different purposes.","paragraph_zero_based":22008},{"literal_text_all_w_t_and_m_t":"PCI-List information element","paragraph_zero_based":22009},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":22010},{"literal_text_all_w_t_and_m_t":"-- TAG-PCI-LIST-START","paragraph_zero_based":22011},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22012},{"literal_text_all_w_t_and_m_t":"PCI-List ::=                        SEQUENCE (SIZE (1..maxNrofCellMeas)) OF PhysCellId","paragraph_zero_based":22013},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22014},{"literal_text_all_w_t_and_m_t":"-- TAG-PCI-LIST-STOP","paragraph_zero_based":22015},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":22016},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22017},{"literal_text_all_w_t_and_m_t":"–PCI-Range","paragraph_zero_based":22018},{"literal_text_all_w_t_and_m_t":"The IE PCI-Range is used to encode either a single or a range of physical cell identities. The range is encoded by using a start value and by indicating the number of consecutive physical cell identities (including start) in the range. For fields comprising multiple occurrences of PCI-Range, the Network may configure overlapping ranges of physical cell identities.","paragraph_zero_based":22019},{"literal_text_all_w_t_and_m_t":"PCI-Range information element","paragraph_zero_based":22020},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":22021},{"literal_text_all_w_t_and_m_t":"-- TAG-PCI-RANGE-START","paragraph_zero_based":22022},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22023},{"literal_text_all_w_t_and_m_t":"PCI-Range ::=                       SEQUENCE {","paragraph_zero_based":22024},{"literal_text_all_w_t_and_m_t":"    start                               PhysCellId,","paragraph_zero_based":22025},{"literal_text_all_w_t_and_m_t":"    range                               ENUMERATED {n4, n8, n12, n16, n24, n32, n48, n64, n84,","paragraph_zero_based":22026},{"literal_text_all_w_t_and_m_t":"                                                    n96, n128, n168, n252, n504, n1008,spare1}                  OPTIONAL    -- Need S","paragraph_zero_based":22027},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22028},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22029},{"literal_text_all_w_t_and_m_t":"-- TAG-PCI-RANGE-STOP","paragraph_zero_based":22030},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":22031}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["9761616b90201923aff02ac05116c46b3ca12fffe6142f0359d60d0dd5d3850b","693d110685179097baaa7ab0e746ddcab2286dc6a0d090f4b619be00c63009ee","3f688f39a18eb71f7c085ff0dbec9ce1751253c6a9e0505024eac18da4fea27c","c77d4ab182f972853abab9978426b4a9a9a6af240933cb46d609cd6410eac357","eaaa93c3edd7a34b576391814cf163429f91a8fc56cd126421e75f90824daa20","d4fb2b0470f1d9c7f1e5ea32e4afe7e71ac5b5b4b0ae69918db4c7712627bf8a","d0a838fce73a092e3580c328875fd8c3ba711b7985c7eaa499e836858735c44f","ec81b05732208e75377032deeaab10ee64e27368d2c4dc0cc961490288133e3b","e0616087f1b070b3881b59e51ea53fe7f62c877f20b2b207980709d8871a7f13","93af4d7cd6dcdfc6ca395be370dca5639a6eee973ca3a1aa49753a4cf5d6b705","2582269bdecc7559ad31a0dc8afe6cba859ae61a9711bf56e7469149b52bb550","b0b4f9726329bef801b8c2823841ce65d7194091f936942bfcc9e11539b937c9","839e46ae44b86465c7caf954f78289f74e22f9d3ff05a