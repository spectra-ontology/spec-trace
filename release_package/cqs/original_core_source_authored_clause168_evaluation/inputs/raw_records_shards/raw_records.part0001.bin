{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SIB10 contains the HRNNs of the NPNs listed in SIB1.","paragraph_zero_based":13872},{"literal_text_all_w_t_and_m_t":"SIB10 information element","paragraph_zero_based":13873},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":13874},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB10-START","paragraph_zero_based":13875},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13876},{"literal_text_all_w_t_and_m_t":"SIB10-r16 ::=               SEQUENCE {","paragraph_zero_based":13877},{"literal_text_all_w_t_and_m_t":"    hrnn-List-r16               HRNN-List-r16                                   OPTIONAL,   -- Need R","paragraph_zero_based":13878},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension    OCTET STRING                                    OPTIONAL,","paragraph_zero_based":13879},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":13880},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":13881},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13882},{"literal_text_all_w_t_and_m_t":"HRNN-List-r16 ::=           SEQUENCE (SIZE (1..maxNPN-r16)) OF HRNN-r16","paragraph_zero_based":13883},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13884},{"literal_text_all_w_t_and_m_t":"HRNN-r16 ::=                SEQUENCE {","paragraph_zero_based":13885},{"literal_text_all_w_t_and_m_t":"    hrnn-r16                    OCTET STRING (SIZE(1.. maxHRNN-Len-r16))        OPTIONAL   -- Need R","paragraph_zero_based":13886},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":13887},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13888},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB10-STOP","paragraph_zero_based":13889},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":13890},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13891},{"literal_text_all_w_t_and_m_t":"SIB10 field descriptions","paragraph_zero_based":13892},{"literal_text_all_w_t_and_m_t":"HRNN-List","paragraph_zero_based":13893},{"literal_text_all_w_t_and_m_t":"The same amount of HRNN (see TS 23.003 [21]) elements as the number of NPNs in SIB 1 are included. The n-th entry of HRNN-List contains the human readable network name of the n-th NPN of SIB1. The hrnn in the corresponding entry in HRNN-List is absent if there is no HRNN associated with the given NPN.","paragraph_zero_based":13894},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13895}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["7e2ef2d5521e62529a115fa15d3e6a00e71aaeca625415c41aa570939d65a7e5","3c8174b85ff4a2d610fabc79651b7a9070a76b0933e9c1b909bc7b7760db97e1","8d31701f106bff536ad221bee4d7072fa32dddfc07f73eec1658747bddf9e1ea","dc085af927ed52e8a41ccb834b8d1f604abb985e40504b7cef1ee42b82019794","718963940e2f70ff2fc52008bfc62f29d02205bc1629160288a265340130984b","dba319cd0d2c25b0f7defd63ead917f1b5ba71ff40a83a14c60ff12fadd45c52","6eff6e73206ccc14d65e3e27379ff0ad1ca9b9723081af16f2ba7d99e9fef0cb","fceeb620c08dd5b4d3e42fbd30b48f5bf8e054e279f1ee94216af57419ac2793","4aa83b74f3c69a3bcd3642b33b9e3ad266eac48a6dbc9e95cdd20784e7a76b51","7feb465a7ddaa946bfd6bcf4fbb5a351b6f6662d175b7d34262fc8fe6e33d37b","3c37c2a42ba27947f36ae389843f46611d5ad316dba6364da11af69c7df9e220","73c627b7634c2a7003ebc70cd164cdc0a0d0028501254435109937d7bff11f2a","6adcc343e7258c3d8af1f2c82d6aeff32302749728ecc05db96ccca4ba97c54a","8ced0f27a69ee89f902c03ecbc1203a2d07be733debe5b360bfc0e0423fa0485","316bf5b83944ee8e2bf2eff027dc9b1ce4a2df61770605bbd24a3eb6da38d902","db33