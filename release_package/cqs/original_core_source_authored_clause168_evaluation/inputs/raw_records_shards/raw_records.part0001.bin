{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28344},{"literal_text_all_w_t_and_m_t":"SRS-CarrierSwitching ::=            SEQUENCE {","paragraph_zero_based":28345},{"literal_text_all_w_t_and_m_t":"    srs-SwitchFromServCellIndex         INTEGER (0..31)                                                         OPTIONAL,   -- Need M","paragraph_zero_based":28346},{"literal_text_all_w_t_and_m_t":"    srs-SwitchFromCarrier               ENUMERATED {sUL, nUL},","paragraph_zero_based":28347},{"literal_text_all_w_t_and_m_t":"    srs-TPC-PDCCH-Group                 CHOICE {","paragraph_zero_based":28348},{"literal_text_all_w_t_and_m_t":"        typeA                               SEQUENCE (SIZE (1..32)) OF SRS-TPC-PDCCH-Config,","paragraph_zero_based":28349},{"literal_text_all_w_t_and_m_t":"        typeB                               SRS-TPC-PDCCH-Config","paragraph_zero_based":28350},{"literal_text_all_w_t_and_m_t":"    }                                                                                                           OPTIONAL,   -- Need M","paragraph_zero_based":28351},{"literal_text_all_w_t_and_m_t":"    monitoringCells                     SEQUENCE (SIZE (1..maxNrofServingCells)) OF ServCellIndex               OPTIONAL,   -- Need M","paragraph_zero_based":28352},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":28353},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28354},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28355},{"literal_text_all_w_t_and_m_t":"SRS-TPC-PDCCH-Config ::=            SEQUENCE {","paragraph_zero_based":28356},{"literal_text_all_w_t_and_m_t":"    srs-CC-SetIndexlist                 SEQUENCE (SIZE(1..4)) OF SRS-CC-SetIndex                                OPTIONAL    -- Need M","paragraph_zero_based":28357},{"literal_text_all_w_