{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14232},{"literal_text_all_w_t_and_m_t":"NTN-NeighCellConfig-r17 ::=              SEQUENCE {","paragraph_zero_based":14233},{"literal_text_all_w_t_and_m_t":"    ntn-Config-r17                           NTN-Config-r17                                  OPTIONAL,       -- Need R","paragraph_zero_based":14234},{"literal_text_all_w_t_and_m_t":"    carrierFreq-r17                          ARFCN-ValueNR                                   OPTIONAL,       -- Need R","paragraph_zero_based":14235},{"literal_text_all_w_t_and_m_t":"    physCellId-r17                           PhysCellId                                      OPTIONAL        -- Need R","paragraph_zero_based":14236},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14237},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14238},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB19-STOP","paragraph_zero_based":14239},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":14240},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14241},{"literal_text_all_w_t_and_m_t":"SIB19 field descriptions","paragraph_zero_based":14242},{"literal_text_all_w_t_and_m_t":"distanceThresh","paragraph_zero_based":14243},{"literal_text_all_w_t_and_m_t":"Distance from the serving cell reference location and is used in location-based measurement initiation in RRC_IDLE and RRC_INACTIVE, as defined in TS 38.304 [20]. Each step represents 50m.","paragraph_zero_based":14244},{"literal_text_all_w_t_and_m_t":"ntn-Config","paragraph_zero_based":14245},{"literal_text_all_w_t_and_m_t":"Provides parameters needed for the UE to access NR via NTN access such as Ephemeris data, common TA parameters, k_offset, validity duration for UL sync information and epoch.","paragraph_zero_based":14246},{"literal_text_all_w_t_and_m_t":"ntn-NeighCellConfigList, ntn-NeighCellConfigListExt","paragraph_zero_based":14247},{"literal_text_all_w_t_and_m_t":"Provides a list of NTN neighbour cells including their ntn-Config, carrier frequency and PhysCellId. This set includes all elements of ntn-NeighCellConfigList and all elements of ntn-NeighCellConfigListExt. If ntn-Config is absent for an entry in ntn-NeighCellConfigListExt, the ntn-Config provided in the entry at the same position in ntn-NeighCellConfigList applies. Network provides ntn-Config for the first entry of ntn-NeighCellConfigList. If the ntn-Config is absent for any other entry in ntn-NeighCellConfigList, the ntn-Config provided in the previous entry in ntn-NeighCellConfigList applies.","paragraph_zero_based":14248},{"literal_text_all_w_t_and_m_t":"referenceLocation","paragraph_zero_based":14249},{"literal_text_all_w_t_and_m_t":"Reference location of the serving cell provided via NTN quasi-Earth fixed system and is used in location-based measurement initiation in RRC_IDLE and RRC_INACTIVE, as defined in TS 38.304 [20].","paragraph_zero_based":14250},{"literal_text_all_w_t_and_m_t":"t-Service","paragraph_zero_based":14251},{"literal_text_all_w_t_and_m_t":"Indicates the time information on when a cell provided via NTN quasi-Earth fixed system is going to stop serving the area it is currently covering. The field indicates a time in multiples of 10 ms after 00:00:00 on Gregorian calendar date 1 January, 1900 (midnight between Sunday, December 31, 1899 and Monday, January 1, 1900). The exact stop time is between the time indicated by the value of this field minus 1 and the time indicated by the value of this field.","paragraph_zero_based":14252},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14253},{"literal_text_all_w_t_and_m_t":"–SIB20","paragraph_zero_based":14254},{"literal_text_all_w_t_and_m_t":"SIB20 contains the information required to acquire the MCCH/MTCH configuration for MBS broadcast.","paragraph_zero_based":14255}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["04b46f40eb311bf20a9232e0441342d49b3861fcdb0afef3d2846a2ea0cdf6fa","0dc2a589fd821b394cb1251b803b2717d48990ea6c6d5b5c397289d04aac6c06","8a58c15a1947ae627740d8acdab9f54d9c3020f218e28d8da1b057d11fff4799","2080548f7b2cabebee8f1da6cfbf248ff2d45c6406c8cb133f3450240e3c3d8e","1322f3173f1af5eb3fbdf51f03ee90e41800eb6fa7f2996adecfc568c1e1f7fa","872d2a60ff8bc511a47ff697401e9b934b31eda7c811d7997ff0dc38f3e2552a","63b811bfded8859787da0569fdc072457679cf0d84b160bbf8c4a95b8eb70a86","0ab5a6aaa974c800571133af2a3e1bcea82606eb504ebc2bf1016884feb7b20a","ca61418f371afc480484badfe706d7b329e284006dc6168ec31d24130e77db23","4e75bdcd30114b75c9f70f33128df3ff56085bf7b22a7550186d60a675d06b6f","b9da51facb60c7bef28c03ab460d40dedbaeeb0764b5fda5bfbffa5e2936de93","b42d2c620b39dda0fb400908e41fe1f4fbe99490ceab361ee2b47a6bec002a93","a64a43983ee7d99b4308e54267558c93150068bc4bb785234772da066f1af9a7","e1cb280b624cd864d0d69a02352b1e77d4c644baa29bc119a0991c90fee64817","68a6a5dd2e908e307bbea873f2ea2f317af93fcf3156e47a981a6c32d0084ad1","4966b1fce2de36414f424f0ee52a199be030bc330ddbdcf094a624c3405450ed","fde3cfbce4592d39249a68802c1cc08990493c650e324d9bc28b558a5dcd0395","2b104d2f63c396ac0c1a12c3fd9ce6a37842904276e6b8461226db78546a5adc","9f2edfa4249ed5ac1617def984e915994a0cb72d08bd1b235a70fdee8ad13070","d51eef3abe2cfd538d0ef0c71b2992537c26888f6c02f23e5504ac0ac234104a","399108faee73e9a2c3a2fc2fde69918eb58cb26efb8658c78ed7ee94ec6f7e10","34774cd3d40ccd54359aa26991986e2eb4e0fec7fc0b7d61b24aa09c7648ae5e","9fc48583ec78328d0973e7fd6c93e2d74578065b93b8d5e08df86273d26a5ecc","50fbcce17027b25167a4a621cd363a2246bec89be9c6d0352b734864698ccec6"],"paragraph_range_zero_based":[14232,14255],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p14232"}
