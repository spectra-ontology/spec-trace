{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"resourceElementOffset","paragraph_zero_based":23184},{"literal_text_all_w_t_and_m_t":"Indicates the subcarrier offset for UL PTRS for CP-OFDM. If the field is absent, the UE applies the value offset00 (see TS 38.211 [16], clause 6.4.1.2.2).","paragraph_zero_based":23185},{"literal_text_all_w_t_and_m_t":"sampleDensity","paragraph_zero_based":23186},{"literal_text_all_w_t_and_m_t":"Sample density of PT-RS for DFT-s-OFDM, pre-DFT, indicating a set of thresholds T={NRBn, n=0,1,2,3,4}, that indicates dependency between presence of PT-RS and scheduled BW and the values of X and K the UE should use depending on the scheduled BW, see TS 38.214 [19], clause 6.1, table 6.2.3.2-1.","paragraph_zero_based":23187},{"literal_text_all_w_t_and_m_t":"timeDensity","paragraph_zero_based":23188},{"literal_text_all_w_t_and_m_t":"Presence and time density of UL PT-RS for CP-OFDM waveform as a function of MCS If the field is absent, the UE uses L_PT-RS = 1 (see TS 38.214 [19], clause 6.1).","paragraph_zero_based":23189},{"literal_text_all_w_t_and_m_t":"timeDensityTransformPrecoding","paragraph_zero_based":23190},{"literal_text_all_w_t_and_m_t":"Time density (OFDM symbol level) of PT-RS for DFT-s-OFDM. If the field is absent, the UE applies value d1 (see TS 38.214 [19], clause 6.1).","paragraph_zero_based":23191},{"literal_text_all_w_t_and_m_t":"transformPrecoderDisabled","paragraph_zero_based":23192},{"literal_text_all_w_t_and_m_t":"Configuration of UL PTRS without transform precoder (with CP-OFDM).","paragraph_zero_based":23193},{"literal_text_all_w_t_and_m_t":"transformPrecoderEnabled","paragraph_zero_based":23194},{"literal_text_all_w_t_and_m_t":"Configuration of UL PTRS with transform precoder (DFT-S-OFDM).","paragraph_zero_based":23195},{"literal_text_all_w_t_and_m_t":"","paragraph_ze