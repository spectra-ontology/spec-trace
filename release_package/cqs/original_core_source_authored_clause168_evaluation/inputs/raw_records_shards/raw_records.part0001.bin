{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":39456},{"literal_text_all_w_t_and_m_t":"    drx-SlotOffsetPTM-r17                 INTEGER (0..31)","paragraph_zero_based":39457},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39458},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39459},{"literal_text_all_w_t_and_m_t":"-- TAG-DRX-CONFIGPTM-STOP","paragraph_zero_based":39460},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39461},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39462},{"literal_text_all_w_t_and_m_t":"DRX-Config-PTM field descriptions","paragraph_zero_based":39463},{"literal_text_all_w_t_and_m_t":"drx-HARQ-RTT-Timer-DL-PTM","paragraph_zero_based":39464},{"literal_text_all_w_t_and_m_t":"Value in number of symbols of the CFR where the transport block was received.","paragraph_zero_based":39465},{"literal_text_all_w_t_and_m_t":"drx-InactivityTimerPTM","paragraph_zero_based":39466},{"literal_text_all_w_t_and_m_t":"Value in multiple integers of 1 ms. ms0 corresponds to 0, ms1 corresponds to 1 ms, ms2 corresponds to 2 ms, and so on.","paragraph_zero_based":39467},{"literal_text_all_w_t_and_m_t":"drx-LongCycleStartOffsetPTM","paragraph_zero_based":39468},{"literal_text_all_w_t_and_m_t":"drx-LongCycle-PTM in ms and drx-StartOffset-PTM in multiples of 1 ms.","paragraph_zero_based":39469},{"literal_text_all_w_t_and_m_t":"drx-onDurationTimerPTM","paragraph_zero_based":39470},{"literal_text_all_w_t_and_m_t":"Value in multiples of 1/32 ms (subMilliSeconds) or in ms (milliSecond). For the latter, value ms1 corresponds to 1 ms, value ms2 corresponds to 2 ms, and so on.","paragraph_zero_based":39471},{"literal_text_all_w_t_and_m_t":"drx-RetransmissionTimer-DL-PTM","paragraph_zero_based":39472},{"literal_text_all_w_t_and_m_t":"Value in number of slot lengths of the CFR where the transport block was received. value sl0 corresponds to 0 slots, sl1 corresponds to 1 slot, sl2 corresponds to 2 slots, and so on.","paragraph_zero_based":39473},{"literal_text_all_w_t_and_m_t":"drx-SlotOffsetPTM","paragraph_zero_based":39474},{"literal_text_all_w_t_and_m_t":"Value in 1/32 ms. Value 0 corresponds to 0 ms, value 1 corresponds to 1/32 ms, value 2 corresponds to 2/32 ms, and so on.","paragraph_zero_based":39475},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39476},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":39477},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":39478},{"literal_text_all_w_t_and_m_t":"HARQFeedback","paragraph_zero_based":39479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["c0b0ea160c59ead235e6b4eee818e26a7827303b4c55dfce570ee58c3c058ab4","487688f0519ba4ea2afee30dc7398e223c8f1a697422be785ac4d53a429189aa","7b2c85325f7f005729e97b54b1597f7177146dab80687c5c8652d119c4ca9f74","8944b2f1ab66a69a039a77d9d3e284f84d82741c9e83e0561f9d8577ea2f5db3","b996770538362f5fd459c24010b20b14acfd845121425bccebedf44e14abe027","2a4f1b93764f061882de25a7d789923061a7edf4ae634ec85b3dbd7a67d5b2c7","0bc2e8d0b48738fe84a8bd6f3e082138b8312538ca61f817e2923cdc181ec29b","563297bef91f664be62dbc484fa8fda223248ff34142db463c51a486941f65fe","acab5c95314c1f06745f993b2e0a431f593175c8e220d44a3ed396e3a559ed5d","ee94b6e239698d1f4059ab134738c94e12dd631fdf14d662cb3f63caf57a2802","fabf5fe2f9529dd3d2d71a02dc47d1a16f197965ade265b5707da2fd84d23288","f6cc987cde548761c494b46735b7b0ae82179739bfb6c4bbcabe20be48bc2dd3","b64409e6228043846f3a47f207b4d45b82211089eb76d04e6d6590cc6cec1f52"