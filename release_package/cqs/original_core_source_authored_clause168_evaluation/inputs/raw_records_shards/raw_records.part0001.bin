{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22056},{"literal_text_all_w_t_and_m_t":"–PCI-RangeIndex","paragraph_zero_based":22057},{"literal_text_all_w_t_and_m_t":"The IE PCI-RangeIndex identifies a physical cell id range, which may be used for different purposes.","paragraph_zero_based":22058},{"literal_text_all_w_t_and_m_t":"PCI-RangeIndex information element","paragraph_zero_based":22059},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":22060},{"literal_text_all_w_t_and_m_t":"-- TAG-PCI-RANGEINDEX-START","paragraph_zero_based":22061},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22062},{"literal_text_all_w_t_and_m_t":"PCI-RangeIndex ::=                  INTEGER (1..maxNrofPCI-Ranges)","paragraph_zero_based":22063},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22064},{"literal_text_all_w_t_and_m_t":"-- TAG-PCI-RANGEINDEX-STOP","paragraph_zero_based":22065},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":22066},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22067},{"literal_text_all_w_t_and_m_t":"–PCI-RangeIndexList","paragraph_zero_based":22068},{"literal_text_all_w_t_and_m_t":"The IE PCI-RangeIndexList concerns a list of indexes of physical cell id ranges, which may be used for different purposes.","paragraph_zero_based":22069},{"literal_text_all_w_t_and_m_t":"PCI-RangeIndexList information element","paragraph_zero_based":22070},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":22071},{"literal_text_all_w_t_and_m_t":"-- TAG-PCI-RANGEINDEXLIST-START","paragraph_zero_based":22072},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22073},{"literal_text_all_w_t_and_m_t":"PCI-RangeIndexList ::=              SEQUENCE (SIZE (1..maxNrofPCI-Ranges)) OF PCI-RangeIndex","paragraph_zero_based":22074},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22075},{"literal_text_all_w_t_and_m_t":"-- TAG-PCI-RANGEINDEXLIST-STOP","paragraph_zero_based":22076},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":22077},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22078},{"literal_text_all_w_t_and_m_t":"–PDCCH-Config","paragraph_zero_based":22079}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["f379f6db9cb9292a409219c1fe475a092d334a9249118ec2de71069809bc3a21","72886fe50ae7e6cdfcf00133aac3a1b538c48d9b19eba972bf16e56ae9a91425","a4212287ce3798f93fab8c651d04243850dd74e95ab797c3dad676e362eac133","17cadff5689dfb0f4c6cd13403301ad652bf0c9f40c230377b1d6c7ea545e917","e8585e67dd782109e08dfe675e2fc759514f48ee850b5a901180e15e6c90b08c","b0eda4109d5227bc67e1214291711c0062dc5ad3564b8af64c78b09d88bdc64f","fca5ed487780e8b57c254179c210d69fa55999fa9ae94e725af63a0c2e59b570","c10413179ac1e8800d32c61b97d23934a24f8f9dbad679f3505102044209587c","b9db7fb14f1cbf7f2ef2bc22b973673bf6c4a41280307d6cbfd3712f1dc5b38f","2dbfa778dde302c097507be3f1a7b0c301615727f547562c1ceabeb43783553c","32450a704bbbdd681b9a06d745a0c113456c2c845e3437e3d44058a310eb6c8d","189d23c5247f9697c1429fd44439e263fbdcf9a07abe020a3d3b0206c6d5d00e","b03b0cfe4911b1f3b4064711e6241c95771a35588b9e10b209183f1d1b4dce30","a337aace17525626f3d752fc8fd3770aa46d7deb438405d4617aa845c4dc42b4","7db2a5f77d0e73f1acdeb78560ea3b27484beb5f1cbf777b160a1f07464bbd69","39a2b430ae475e6bf5f8ec45689241b96a6bd0fbada5164ca504f58451c59f52","35011452f6c9a8ef53f02a47d056f34072f1c81bc7fc1a08de9663f8aae8a90c","dc901827aeafcf70362708045e941970c427e4c451408ebfb430a20283ff4059","fda58493d32a9c0582ef01bc4886f478710bf7228792315cb6401bbbc6fae630","abca7f1707e5b2a5fc1fb6a3e113696e1aefa2e453a6a409b0e0fee1524c822a","250ba845f1dabc49c71e9aeed734cabe3d5c72f97801a8499e52c164718e8cd0","1908f9144a4175463de0bb5b8f54721195882fa8f4fa8659866faffa78312f46","ed4f164a13bfccd513326678882bd24f2a965f209920e6afee5c0b581575de96","d1c41ed3af4925c07602229604bde6e9ba5178971925081a1baa0af4f1952989"],"paragraph_range_zero_based":[22056,22079],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p22056"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE PDCCH-Config is used to configure UE specific PDCCH parameters or MBS multicast PDCCH parameters such as control resource sets (CORESET), search spaces and additional parameters for acquiring the PDCCH. If this IE is used for the scheduled SCell in case of cross carrier scheduling, the fields other than searchSpacesToAddModList and searchSpacesToReleaseList are absent. If the IE is used for a dormant BWP, the fields other than controlResourceSetToAddModList and controlResourceSetToReleaseList are absent. If this IE is used for MBS CFR, the field downlinkPreemptiom,tpc-PUSCH, tpc-SRS, uplinkCancellation, monitoringCapabilityConfig, and searchSpaceSwitchConfig are absent.","paragraph_zero_based":22080},{"literal_text_all_w_t_and_m_t":"PDCCH-Config information element","paragraph_zero_based":22081},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":22082},{"literal_text_all_w_t_and_m_t":"-- TAG-PDCCH-CONFIG-START","paragraph_zero_based":22083},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22084},{"literal_text_all_w_t_and_m_t":"PDCCH-Config ::=                    SEQUENCE {","paragraph_zero_based":22085},{"literal_text_all_w_t_and_m_t":"    controlResourceSetToAddModList      SEQUENCE(SIZE (1..3)) OF ControlResourceSet                      OPTIONAL,   -- Need N","paragraph_zero_based":22086},{"literal_text_all_w_t_and_m_t":"    controlResourceSetToReleaseList     SEQUENCE(SIZE (1..3)) OF ControlResourceSetId                    OPTIONAL,   -- Need N","paragraph_zero_based":22087},{"literal_text_all_w_t_and_m_t":"    searchSpacesToAddModList            SEQUENCE(SIZE (1..10)) OF SearchSpace                            OPTIONAL,   -- Need N","paragraph_zero_based":22088},{"literal_text_all_w_t_and_m_t":"    searchSpacesToReleaseList           SEQUENCE(SIZE (1..10)) OF SearchSpaceId                          OPTIONAL,   -- Need N","paragraph_zero_based":22089},{"literal_text_all_w_t_and_m_t":"    downlinkPreemption                  SetupRelease { DownlinkPreemption }                              OPTIONAL,   -- Need M","paragraph_zero_based":22090},{"literal_text_all_w_t_and_m_t":"    tpc-PUSCH                           SetupRelease { PUSCH-TPC-CommandConfig }                         OPTIONAL,   -- Need M","paragraph_zero_based":22091},{"literal_text_all_w_t_and_m_t":"    tpc-PUCCH                           SetupRelease { PUCCH-TPC-CommandConfig }                         OPTIONAL,   -- Need M","paragraph_zero_based":22092},{"literal_text_all_w_t_and_m_t":"    tpc-SRS                             SetupRelease { SRS-TPC-CommandConfig}                            OPTIONAL,   -- Need M","paragraph_zero_based":22093},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":22094},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":22095},{"literal_text_all_w_t_and_m_t":"    controlResourceSetToAddModListSizeExt-v1610 SEQUENCE (SIZE (1..2)) OF ControlResourceSet             OPTIONAL,   -- Need N","paragraph_zero_based":22096},{"literal_text_all_w_t_and_m_t":"    controlResourceSetToReleaseListSizeExt-r16 SEQUENCE (SIZE (1..5)) OF ControlResourceSetId-r16        OPTIONAL,   -- Need N","paragraph_zero_based":22097},{"literal_text_all_w_t_and_m_t":"    searchSpacesToAddModListExt-r16     SEQUENCE(SIZE (1..10)) OF SearchSpaceExt-r16                     OPTIONAL,   -- Need N","paragraph_zero_based":22098},{"literal_text_all_w_t_and_m_t":"    uplinkCancellation-r16              SetupRelease { UplinkCancellation-r16 }                          OPTIONAL,   -- Need M","paragraph_zero_based":22099},{"literal_text_all_w_t_and_m_t":"    monitoringCapabilityConfig-r16      ENUMERATED { r15monitoringcapability,r16monitoringcapability }   OPTIONAL,   -- Need M","paragraph_zero_based":22100},{"literal_text_all_w_t_and_m_t":"    searchSpaceSwitchConfig-r16         SearchSpaceSwitchConfig-r16                                      OPTIONAL    -- Need R","paragraph_zero_based":22101},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":22102},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":22103}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["d1f859b97313f8894868dea7821d13cbe9c1d9e1870a252d41657343a00962a8","1970b5745e9f6d244587d353c5995e9beb2daf1a3a83943e25f92c3a38301a14","cc195bc567b6a5a95ecdbb70abab16f4be4a9ca7abd23719ff8c57c6074f94a4","8c33e8199050322e8a0893e956ad067b14f02bdf41bd82e09e932b76b2bb439d","34a7cbb5558386e031d3098a61663ee66fd1b0c2efa2b622ce86e24e5beb7e39","e8a4d077c1aa5d28181068b1daf1368cfb88ef3b0c865b4daa93b0692bb405ac","b87124794e571462af98b96ee9453017e6fd094ff8a034d9aa4e2367cf0d2d0b","1e6373346985ad241490323bc735af7a1c1ae1692b2277036898c06a8d82a186","b87ac956e638f858c6c83fd17c38e0f2450fb271b677f5547ef4847a8d7e81c0","26f80faf9d2064ae2efb9f1b01721e24edf20ddf072c6930a3f0416eeddc1405","46a1c7462b3d8f5d8ce31814e2f4858d13bac2581b77cb989cff2789321e1934","f44bdc4f872d7e157553f772bbf03485f397c3d44dd9d89b50a1061295e93395","bae8ecfa0ed8c56b6303a35081825c20ba17d7b2170fac7aef36e96dd4890e2d","dc668dcdf238f6146b189942ff702ea289656fe45da4f5692ec663c363dfde71","bfa3b786b3cbc5a5037c4d4589148a322064d57e8c361cfc730088b8a8d4ed80","2bdd50f8ac3220368edf613fd324f25f1aa02b16dbbf220f21ee2434ce78a92c","796a58a013dfbc0f61c17a8af4d63bfdb754cf21129e1f39ef0ea8f6d4e9b2ff","11aca5b77ab2f101a95fab520a3b6b060361b4987c95c8a172c7ad9f2a558c28","c8ca76d691ab4c121885da192c712449728bee199a45117cf582bca149014365","7a374157ef3418b67426c2436a1af7651a4e1557910635d291773a3c4e107