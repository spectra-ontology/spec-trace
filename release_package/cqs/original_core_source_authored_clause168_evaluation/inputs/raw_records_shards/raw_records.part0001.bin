{"fields":{"filename":"R2-2313652.zip::R2-2313652 TEI18 SDT_ReleaseEnh 38331 CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>release maxBW-PreferenceConfig and maxBW-PreferenceConfigFR2-2 for all configured cell groups from the UE Inactive AS context, if stored;","paragraph_zero_based":288},{"literal_text_all_w_t_and_m_t":"1>stop all instances of timer T346b, if running;","paragraph_zero_based":289},{"literal_text_all_w_t_and_m_t":"1>release maxCC-PreferenceConfig for all configured cell groups from the UE Inactive AS context, if stored;","paragraph_zero_based":290},{"literal_text_all_w_t_and_m_t":"1>stop all instances of timer T346c, if running;","paragraph_zero_based":291},{"literal_text_all_w_t_and_m_t":"1>release maxMIMO-LayerPreferenceConfig and maxMIMO-LayerPreferenceConfigFR2-2 for all configured cell groups from the UE Inactive AS context, if stored;","paragraph_zero_based":292},{"literal_text_all_w_t_and_m_t":"1>stop all instances of timer T346d, if running;","paragraph_zero_based":293},{"literal_text_all_w_t_and_m_t":"1>release minSchedulingOffsetPreferenceConfig and minSchedulingOffsetPreferenceConfigExt for all configured cell groups from the UE Inactive AS context, if stored;","paragraph_zero_based":294},{"literal_text_all_w_t_and_m_t":"1>stop all instances of timer T346e, if running;","paragraph_zero_based":295},{"literal_text_all_w_t_and_m_t":"1>release rlm-RelaxationReportingConfig for all configured cell groups from the UE Inactive AS context, if stored;","paragraph_zero_based":296},{"literal_text_all_w_t_and_m_t":"1>stop all instances of timer T346j, if running;","paragraph_zero_based":297},{"literal_text_all_w_t_and_m_t":"1>release bfd-RelaxationReportingConfig for all configured cell groups from the UE Inactive AS context, if stored;","paragraph_zero_based":298},{"literal_text_all_w_t_and_m_t":"1>stop all instances of timer T346k, if running;","paragraph_zero_b