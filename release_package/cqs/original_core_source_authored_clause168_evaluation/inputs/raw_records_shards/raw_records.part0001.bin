{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    sfnSchemePDSCH-r17                 ENUMERATED {sfnSchemeA,sfnSchemeB}                                   OPTIONAL    -- Need R","paragraph_zero_based":27384},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27385},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27386},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27387},{"literal_text_all_w_t_and_m_t":"-- TAG-SERVINGCELLCONFIG-STOP","paragraph_zero_based":27388},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27389},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27390},{"literal_text_all_w_t_and_m_t":"ChannelAccessConfig field descriptions","paragraph_zero_based":27391},{"literal_text_all_w_t_and_m_t":"absenceOfAnyOtherTechnology","paragraph_zero_based":27392},{"literal_text_all_w_t_and_m_t":"Presence of this field indicates absence on a long term basis (e.g. by level of regulation) of any other technology sharing the carrier; absence of this field indicates the potential presence of any other technology sharing the carrier, as specified in TS 37.213 [48] clauses 4.2.1 and 4.2.3.","paragraph_zero_based":27393},{"literal_text_all_w_t_and_m_t":"energyDetectionConfig","paragraph_zero_based":27394},{"literal_text_all_w_t_and_m_t":"Indicates whether to use the maxEnergyDetectionThreshold or the energyDetectionThresholdOffset (see TS 37.213 [48], clause 4.2.3).","paragraph_zero_based":27395},{"literal_text_all_w_t_and_m_t":"energyDetectionThresholdOffset","paragraph_zero_based":27396},{"literal_text_all_w_t_and_m_t":"Indicates the offset to the default maximum energy detection threshold value. Unit in dB. Value -13 corresponds to -13dB, value -12 corresponds to -12dB, and so on (i.e. in steps of 1dB) as specified in TS 37.213 [48], clause 4.2.3.","paragraph_zero_based":27397},{"literal_text_all_w_t_and_m_t":"maxEnergyDetectionThreshold","paragraph_zero_based":27398},{"literal_text_all_w_t_and_m_t":"Indicates the absolute maximum energy detection threshold value. Unit in dBm. Value -85 corresponds to -85 dBm, value -84 corresponds to -84 dBm, and so on (i.e. in steps of 1dBm) as specified in TS 37.213 [48], clause 4.2.3.","paragraph_zero_based":27399},{"literal_text_all_w_t_and_m_t":"ul-toDL-COT-SharingED-Threshold","paragraph_zero_based":27400},{"literal_text_all_w_t_and_m_t":"Maximum energy detection threshold that the UE should use to share channel occupancy with gNB for DL transmission as specified in TS 37.213 [48], clause 4.1.3 for downlink channel access and clause 4.2.3 for uplink channel access. This field is not applicable in semi-static channel access mode.","paragraph_zero_based":27401},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27402},{"literal_text_all_w_t_and_m_t":"ServingCellConfig field descriptions","paragraph_zero_based":27403},{"literal_text_all_w_t_and_m_t":"additionalPCI-ToAddModList","paragraph_zero_based":27404},{"literal_text_all_w_t_and_m_t":"List of information for the additional SSB with different PCI than the serving cell PCI. The additional SSBs with different PCIs are not used for serving cell quality derivation.","paragraph_zero_based":27405},{"literal_text_all_w_t_and_m_t":"bwp-InactivityTimer","paragraph_zero_based":27406},{"literal_text_all_w_t_and_m_t":"The duration in ms after which the UE falls back to the default Bandwidth Part (see TS 38.321 [3], clause 5.15). When the network releases the timer configuration, the UE stops the timer without switching to the default BWP.","paragraph_zero_based":27407}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["fc16cd91afc77cf3d1c2527bdd66dbd49cad3a8662713b250f18081aa2fcdf26","9559a1be2c156c4de37e2099e10b9daa85f409087f8f0b5ae4cc26828c7a1961","a6e27314ee9e791ffd222240674a91b2bed0302714721866075537f7bae9d1a8","c2b80a89bb91e2bb552eddceea781d67a14c4149bf8aa31384ff5d50a5f238e7","1c17003640b50f9619a3b0bae2903dde218bc035c2256ed6e501c86413a70515","83f205673273a2fbdeade5221d5d44a2fdd58d3c9976cc344dbd1aec46995ef6","6076bd5f49e0e88f7afe899473f53308203d064e25bcc013233281814ea4cd58","eeb0fa855f8d929b02d13b84b462731fd9b0d0bd0f4ceacaac88fd0e649287a3","67332bde59f5e83874560f5be02ef3b2ee3eb36738e7f6fbe57b2ea08533bcf6","05ee363a54c7288981623c7a5a3f698285b5d1102af3bc627a5d5e7e34080c2e","c7f5bf3fd47daa523e72050360abdf04d7b9a1e7a1517dc93b771c116b109468","c3b3002b69dae598657b250f810997d3d081d1859df1427ef4d0e734d6a934e9","6ab5386d631068598e896b29189d5c05fd8ba8e4213387e82dc59e76fc9c1e4d","05ba84afb49af71502f1543ae338af82416787518f3e5ad6071c06b2d91528dc","ee19a8543426289b41df62d9c74be80f83dfed4eb6e795f61a76f345ee93222d","869beea6c0379b9b2e77c7b6d5672447a768ee4cb422941b77fd6474202c09d0","258e11936fedc668229e78224d8d9f5538d52a23c60376f9faf3005c77bffa73","eefc7a8d87664a5c9c842410c820454125bb088b9c3aa13c1501586ac311e057","170cacc3f76be5fe1cea907219601788b25ce169e1f3ff8c74f14e8e30ef157a","ad75a086144a4dd4b3ca1bff7733e4a1a3b61880d65f4b6fea4a5a41761e9a4d","ad530c82b6a4712980bbf26e49fb143fce9909186b0bda87642f6174abfc255d","e39a29e573153e7cd8ebb704ea6cf9b90bc103908add4f014d4826fd6018887e","6cf22d2bdbc04c0e0d3e7d1b94ffa680a0670a38d5543f711622521c20f727c1","4f58c9f013c853f37286e9cf84b4f0a06f6614eac7bf32770c91425c8d13b4f4"],"paragraph_range_zero_based":[27384,27407],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p27384"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ca-SlotOffset","paragraph_zero_based":27408},{"literal_text_all_w_t_and_m_t":"Slot offset between the primary cell (PCell/PSCell) and the SCell in unaligned frame boundary with slot alignment and partial SFN alignment inter-band CA. Based on this field, the UE determines the time offset of the SCell as specified in clause 4.5 of TS 38.211 [16]. The granularity of this field is determined by the reference SCS for the slot offset (i.e. the maximum of PCell/PSCell lowest SCS among all the configured SCSs in DL/UL SCS-SpecificCarrierList in ServingCellConfigCommon or ServingCellConfigCommonSIB and this serving cell's lowest SCS among all the configured SCSs in DL/UL SCS-SpecificCarrierList in ServingCellConfigCommon or ServingCellConfigCommonSIB).","paragraph_zero_based":27409},{"literal_text_all_w_t_and_m_t":"The Network configures at most single non-zero offset duration in ms (independent on SCS) among CCs in the unaligned CA configuration. If the field is absent, the UE applies the value of 0. The slot offset value can only be changed with SCell release and add.","paragraph_zero_based":27410},{"literal_text_all_w_t_and_m_t":"cbg-TxDiffTBsProcessingType1, cbg-TxDiffTBsProcessingType2","paragraph_zero_based":27411},{"literal_text_all_w_t_and_m_t":"Indicates whether processing types 1 and 2 based CBG based operation is enabled according to Rel-16 UE capabilities.","paragraph_zero_based":27412},{"literal_text_all_w_t_and_m_t":"cellDTXDRX-Config","paragraph_zero_based":27413},{"literal_text_all_w_t_and_m_t":"Used to configure cell DTX/DRX for the serving cell, as specified in TS 38.321 [3]. A maximum of two cell DTX/DRX patterns can be configured per MAC entity for different serving cells. The two configured patterns are aligned, that the start and slot offset are common and the periodicity of one pattern is an integer multiple of the other.","paragraph_zero_based":27414},{"literal_text_all_w_t_and_m_t":"channelAccessConfig","paragraph_zero_based":27415},{"literal_text_all_w_t_and_m_t":"List of parameters used for access procedures of operation with shared spectrum channel access (see TS 37.213 [48).","paragraph_zero_based":27416},{"literal_text_all_w_t_and_m_t":"channelAccessMode2","paragraph_zero_based":27417},{"literal_text_all_w_t_and_m_t":"If present, this field indicates that the UE shall apply channel access procedures for operation with shared spectrum channel access in accordance with TS 37.213 [48], clause 4.4 for FR2-2. If absent, the UE does not apply these channel access procedures. The network always configures this field if channel access procedures are required for the serving cell within this region by regulations.","paragraph_zero_based":27418},{"literal_text_all_w_t_and_m_t":"Overwrites the corresponding field in ServingCellConfigCommon or ServingCellConfigCommonSIB for this serving cell.","paragraph_zero_based":27419},{"literal_text_all_w_t_and_m_t":"crossCarrierSchedulingConfig","paragraph_zero_based":27420},{"literal_text_all_w_t_and_m_t":"Indicates whether this serving cell is cross-carrier scheduled by another serving cell or whether it cross-carrier schedules another serving cell. If the field other is configured for an SpCell (i.e., the SpCell is cross-carrier scheduled by another serving cell), the SpCell can be additionally scheduled by the PDCCH on the SpCell.","paragraph_zero_based":27421},{"literal_text_all_w_t_and_m_t":"crossCarrierSchedulingConfigRelease","paragraph_zero_based":27422},{"literal_text_all_w_t_and_m_t":"If this field is included, the UE shall release the cross carrier scheduling configuration configured by crossCarrierSchedulingConfig. The network may only include either crossCarrierSchedulingConfigRelease or crossCarrierSchedulingConfig at a time.","paragraph_zero_based":27423},{"literal_text_all_w_t_and_m_t":"crs-RateMatch-PerCORESETPoolIndex","paragraph_zero_based":27424},{"literal_text_all_w_t_and_m_t":"Indicates how UE performs rate matching when both lte-CRS-PatternList1-r16 and lte-CRS-PatternList2-r16 are configured as specified in TS 38.214 [19], clause 5.1.4.2.","paragraph_zero_based":27425},{"literal_text_all_w_t_and_m_t":"csi-RS-ValidationWithDCI","paragraph_zero_based":27426},{"literal_text_all_w_t_and_m_t":"Indicates how the UE performs periodic and semi-persistent CSI-RS reception in a slot. The presence of this field indicates that the UE uses DCI detection to validate whether to receive CSI-RS (see TS 38.213 [13], clause 11.1).","paragraph_zero_based":27427},{"literal_text_all_w_t_and_m_t":"defaultDownlinkBWP-Id","paragraph_zero_based":27428},{"literal_text_all_w_t_and_m_t":"The initial bandwidth part is referred to by BWP-Id = 0. ID of the downlink bandwidth part to be used upon expiry of the BWP inactivity timer. This field is UE specific. When the field is absent the UE uses the initial BWP as default BWP. (see TS 38.213 [13], clause 12 and TS 38.321 [3], clause 5.15).","paragraph_zero_based":27429},{"literal_text_all_w_t_and_m_t":"directionalCollisionHandling","paragraph_zero_based":27430},{"literal_text_all_w_t_and_m_t":"Indicates that this serving cell is using directional collision handling between a reference and other cell(s) for half-duplex operation in TDD CA with same SCS as specified in TS 38.213 [13], clause 11.1. The half-duplex operation only applies within the same frequency range and cell group.The network only configures this field for TDD serving cells that are using the same SCS.","paragraph_zero_based":27431}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["6f0b242d5f49c432d839b42e1574c962e190f38ec5bda8a2d7ec623f4f0e4546","9b856a1033e05cbf5157984d7a3c21db5b8a7a95daf9bf68a5eed32f2cd2461c","35578a819693915ca42ac6c72c08e757d9260a79650b5d57e66bf8767edd9a53","8a4252ffdffdbd912ce11289498b9a96721330c010fe5099e35f11a73948ff93","450defac6d2a0e3b93c80786d69b738d591960e5e352a99022474dd1745d79d0","9f4629efc57e6ce19c4a9bd4270e8e4fcf20bb676684cb200450a9e103d1537b","18d115485bc4a32cbc0621a39471001148e98231dcf6c621d2cb9173a5f32d1f","e732435eeb86866bca622103d42ec03b02d2318d7d172fee69abaa119f3eadd7","1b3a64ffa734daf12730dde847a485a684e75d2887a9b632d4563beff3d2b6dd","9ceb2e11a603369657109895afd85353671fbb5096bc662435fcbb9c84f92b0c","4183a33997ed98f582d845307426e7a9833b77a8e94329e56426d59d746b5c6b","9213fa664e6e4d016aaf6619d6e2756cf33ebb3e04aa4f40da9cdfcdc3a9c805","086106358232704754924d612a64c20f06bf52dd22b8e0e59ec15fe2be5ceab8","b2d79be5aea01bae8ac77e3df5ba5c10a684755f85c0c550c13f1fa26e92f1c5","fa46855ec17776b6d2b29e2a7a95555523983e0fde0821386df209151ef2c340","633dd06654ebe64e6a71da8fb1ea738854904297877629388bc96e094d4ba5f3","145d7979df813328fbdf4cadeaba0d6989a418b7719da207629e1937374cc6a4","4db76b7a757d04ba935479cae533e537c25cdd938f61370491dbd05cff4eefee","7aa7515502426bccb8b0b011109298855b0c98efd0e287d3ef09a6b66f252824","3b0ebd00cfeb1935d15aae724ab2dd301de3b2a8387e3617bccc214d22ebeebc","bd1835ed6d0d0a22dc47f211935f1345f82103142aa3ed1e05760dbcfff7e129","acc454dd21e2e3db01d6765eeaf2004cce5ed395f1b6e5a8be2895eff8c78cd7","78c9631a24c0166f79ca9e9be5b87acffd88a152819be6450e9c4c69014f6079","746f30ba26cc426d3bec6e7671a068064ed8d1ae7f3794d5db944eb65c069b81"],"paragraph_range_zero_based":[27408,27431],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p27408"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"directionalCollisionHandling-DC","paragraph_zero_based":27432},{"literal_text_all_w_t_and_m_t":"For the IAB-MT, it indicates that this serving cell is using directional collision handling between a reference and other cell(s) for half-duplex operation in TDD NR-DC with same SCS within same cell group or cross different cell groups.","paragraph_zero_based":27433},{"literal_text_all_w_t_and_m_t":"dormantBWP-Config","paragraph_zero_based":27434},{"literal_text_all_w_t_and_m_t":"The dormant BWP configuration for an SCell. This field can be configured only for a (non-PUCCH) SCell.","paragraph_zero_based":27435},{"literal_text_all_w_t_and_m_t":"downlinkBWP-ToAddModList","paragraph_zero_based":27436},{"literal_text_all_w_t_and_m_t":"List of additional downlink bandwidth parts to be added or modified. (see TS 38.213 [13], clause 12).","paragraph_zero_based":27437},{"literal_text_all_w_t_and_m_t":"downlinkBWP-ToReleaseList","paragraph_zero_based":27438},{"literal_text_all_w_t_and_m_t":"List of additional downlink bandwidth parts to be released. (see TS 38.213 [13], clause 12).","paragraph_zero_based":27439},{"literal_text_all_w_t_and_m_t":"downlinkChannelBW-PerSCS-List","paragraph_zero_based":27440},{"literal_text_all_w_t_and_m_t":"A set of UE specific channel bandwidth and location configurations for different subcarrier spacings (numerologies). Defined in relation to Point A. The UE uses the configuration provided in this field only for the purpose of channel bandwidth and location determination. If absent, UE uses the configuration indicated in scs-SpecificCarrierList in DownlinkConfigCommon / DownlinkConfigCommonSIB. Network only configures channel bandwidth that corresponds to the channel bandwidth values defined in TS 38.101-1 [15], TS 38.101-2 [39], and TS 38.101-5 [75].","paragraph_zero_based":27441},{"literal_text_all_w_t_and_m_t":"dummy1, dummy 2","paragraph_zero_based":27442},{"literal_text_all_w_t_and_m_t":"This field is not used in the specification. If received it shall be ignored by the UE.","paragraph_zero_based":27443},{"literal_text_all_w_t_and_m_t":"enableBeamSwitchTiming","paragraph_zero_based":27444},{"literal_text_all_w_t_and_m_t":"Indicates the aperiodic CSI-RS triggering with beam switching triggering behaviour as defined in clause 5.2.1.5.1 of TS 38.214 [19].","paragraph_zero_based":27445},{"literal_text_all_w_t_and_m_t":"enableDefaultTCI-StatePerCoresetPoolIndex","paragraph_zero_based":27446},{"literal_text_all_w_t_and_m_t":"Presence of this field indicates the UE shall follow the release 16 behavior of default TCI state per CORESETPoolindex when the UE is configured by higher layer parameter PDCCH-Config that contains two different values of CORESETPoolIndex in ControlResourceSet is enabled.","paragraph_zero_based":27447},{"literal_text_all_w_t_and_m_t":"enableTwoDefaultTCI-States","paragraph_zero_based":27448},{"literal_text_all_w_t_and_m_t":"Presence of this field indicates the UE shall follow the release 16 behavior of two default TCI states for PDSCH when at least one TCI codepoint is mapped to two TCI states is enabled","paragraph_zero_based":27449},{"literal_text_all_w_t_and_m_t":"fdmed-ReceptionMulticast","paragraph_zero_based":27450},{"literal_text_all_w_t_and_m_t":"Indicates the Type-1 HARQ codebook generation as specified in TS 38.213 [13], clause 9.1.2.1.","paragraph_zero_based":27451},{"literal_text_all_w_t_and_m_t":"firstActiveDownlinkBWP-Id","paragraph_zero_based":27452},{"literal_text_all_w_t_and_m_t":"If configured for an SpCell, this field contains the ID of the DL BWP to be activated or to be used for RLM, BFD and measurements if included in an RRCReconfiguration message contained in an NR or E-UTRA RRC message indicating that the SCG is deactivated, upon performing the RRC (re-)configuration. If the field is absent, the RRC (re-)configuration does not impose a BWP switch. If the field is absent for the PSCell at SCG deactivation, the UE considers the previously activated DL BWP as the BWP to be used for RLM, BFD and measurements. If the field is absent for the PSCell at SCG activation, the DL BWP to be activated is the DL BWP previously to be used for RLM, BFD and measurements.","paragraph_zero_based":27453},{"literal_text_all_w_t_and_m_t":"If configured for an SCell, this field contains the ID of the downlink bandwidth part to be used upon activation of an SCell. The initial bandwidth part is referred to by BWP-Id = 0.","paragraph_zero_based":27454},{"literal_text_all_w_t_and_m_t":"Upon reconfiguration with reconfigurationWithSync, the network sets the firstActiveDownlinkBWP-Id and firstActiveUplinkBWP-Id to the same value.","paragraph_zero_based":27455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["0c5b4b1e700dc8ab0284cf27055be18a74fa473117a39bab64f21e8ef17241df","8a51fd345cee39680c8926b050d59c2e95d042d6f333233aa77f75df0e0ab6dc","eeeb9224881c54153c1316e1c28e5e52b76bebc3c46d7682462c5f117c0e5ef1","2640cbb3eb3567a4f548d397d797f55107deb51821a43fc0b603ecf8f6eb1e25","49ac8f3194a4009407f7b1ee718f3908eb4f72dc12d27364d31aa28f200d9648","d0bf5ae3d67c246cd68a283c0f8448457b434d90b80f3a3bf3c35a482e39d104","43e172bd7b0151f991bb032a78211f837863f2697b49c7357e6055c5f4aff947","b42a314a0e8df44e3d07a7a5821d7530a9ece33fd5952bad06fd1351d630b406","759dfc53ab63c0aad8347cdea24196af202dee48f30ac2b5c9364a0d8d4fdba9","fd3993c49f2d8645d2fee317e881e7092a3a0e14af0f6931c7b42527e448d342","b7beb3e9a628dbafa20beb6cc21b0b5c8517c763a348e8afd86782f87fe031d8","7ddae17a6236612b986ad2ccb96267837c57877146ba5699ab82ee767be31ce7","ee4d0abdaf46712afbc256a37a93b2df9b2b549f9e8f7007ff168478ab0e486c","9ac61f764ac6361949a1db9a0b0153146211fea589aaa45ca70e49259d153695","57187d4a1eebd3ec4b982f4fa03edd925363c4ac4978e086ccd7970fff55e9ce","19821187559e5212a53bc007e5e0e2d30e573c900cbcb70375f490668d3ccd60","33f7dc4af4b287aa98000af1bc99a706cf78c8a30aa6f993043be31c1a1943c6","fbcce2e8dfbb5e8967b943e6580a7cdbe96c27e7c72edd9bce2eb20eabd59e4f","ba95e2f290d0d1d81d0b72b77afb53267220785fbdb0f6bc87c6cdad7727267b","00e6b937594a5450ee61eba7f7dd6c2863a78288f4e97ed6351cfab1589e5165","cfa48c89ee0b73531247f230b351fec80b641c1619015efbe975c89682875138","616482fb35e6cf02f010c83e7310b2af0fc4a8724b874108309cb4fd16a1ece8","e817a608cec4236aeb61ba61fe58fa3a65be36068e860cd88cc1ad0d618cc6cc","4aec0575a51398da16c552a66ea2cb7b83ef76cb43006796be9d1970535f735f"],"paragraph_range_zero_based":[27432,27455],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p27432"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"initialDownlinkBWP","paragraph_zero_based":27456},{"literal_text_all_w_t_and_m_t":"The dedicated (UE-specific) configuration for the initial downlink bandwidth-part (i.e., DL BWP#0). If any of the optional IEs are configured within this IE, the UE considers the BWP#0 to be an RRC configured BWP (from UE capability viewpoint). Otherwise, the UE does not consider the BWP#0 as an RRC configured BWP (from UE capability viewpoint). Network always configures the UE with a value for this field if no other BWPs are configured. NOTE1","paragraph_zero_based":27457},{"literal_text_all_w_t_and_m_t":"intraCellGuardBandsDL-List, intraCellGuardBandsUL-List","paragraph_zero_based":27458},{"literal_text_all_w_t_and_m_t":"List of intra-cell guard bands in a serving cell for operation with shared spectrum channel access in FR1. If not configured, the guard bands are defined according to 38.101-1 [15], see TS 38.214 [19], clause 7. For operation in licensed spectrum, this field is absent, and no UE action is required.","paragraph_zero_based":27459},{"literal_text_all_w_t_and_m_t":"lte-CRS-PatternList1","paragraph_zero_based":27460},{"literal_text_all_w_t_and_m_t":"A list of LTE CRS patterns around which the UE shall do rate matching for PDSCH. The LTE CRS patterns in this list shall be non-overlapping in frequency. The network does not configure this field and lte-CRS-ToMatchAround simultaneously.","paragraph_zero_based":27461},{"literal_text_all_w_t_and_m_t":"lte-CRS-PatternList2","paragraph_zero_based":27462},{"literal_text_all_w_t_and_m_t":"A list of LTE CRS patterns around which the UE shall do rate matching for PDSCH scheduled with a DCI detected on a CORESET with CORESETPoolIndex configured with 1. This list is configured only if CORESETPoolIndex configured with 1. The first LTE CRS pattern in this list shall be fully overlapping in frequency with the first LTE CRS pattern in lte-CRS-PatternList1, The second LTE CRS pattern in this list shall be fully overlapping in frequency with the second LTE CRS pattern in lte-CRS-PatternList1, and so on. Network configures this field only if the field lte-CRS-ToMatchAround is not configured and there is at least one ControlResourceSet in one DL BWP of this serving cell with coresetPoolIndex set to 1.","paragraph_zero_based":27463},{"literal_text_all_w_t_and_m_t":"lte-CRS-ToMatchAround","paragraph_zero_based":27464},{"literal_text_all_w_t_and_m_t":"Parameters to determine an LTE CRS pattern that the UE shall rate match around.","paragraph_zero_based":27465},{"literal_text_all_w_t_and_m_t":"lte-NeighCellsCRS-AssistInfoList","paragraph_zero_based":27466},{"literal_text_all_w_t_and_m_t":"A list of LTE neighbour cells configuration information which is used to assist the UE to perform CRS interference mitigation (CRS-IM) in scenarios with overlapping spectrum for LTE and NR (see TS 38.101-4 [59]). If the field is included, it replaces any previous list, i.e. all the entries of the list are replaced and each of the LTE-NeighCellsCRS-AssistInfo entries is considered to be newly created and the conditions and Need codes for setup of the entry apply.","paragraph_zero_based":27467},{"literal_text_all_w_t_and_m_t":"lte-NeighCellsCRS-Assumptions","paragraph_zero_based":27468},{"literal_text_all_w_t_and_m_t":"If the field is not configured, the following default network configuration assumptions are valid for all LTE neighbour cells for the purpose of CRS interference mitigation (CRS-IM) in scenarios with overlapping spectrum for LTE and NR (see TS 38.101-4 [59]).","paragraph_zero_based":27469},{"literal_text_all_w_t_and_m_t":"-The CRS port number is the same as the one indicated in RateMatchPatternLTE-CRS if configured for the serving cell.","paragraph_zero_based":27470},{"literal_text_all_w_t_and_m_t":"-The CRS port number is 4 if RateMatchPatternLTE-CRS is not configured for the serving cell.","paragraph_zero_based":27471},{"literal_text_all_w_t_and_m_t":"-The channel bandwidth and centre frequency are the same as the ones indicated in RateMatchPatternLTE-CRS if configured for the serving cell.","paragraph_zero_based":27472},{"literal_text_all_w_t_and_m_t":"-The MBSFN configuration is the same as the one indicated in RateMatchPatternLTE-CRS if configured for the serving cell. If RateMatchPatternLTE-CRS is not configured for the serving cell, MBSFN subframe is not configured.","paragraph_zero_based":27473},{"literal_text_all_w_t_and_m_t":"-Network-based CRS interference mitigation (i.e., CRS muting), as in crs-IntfMitigConfig specified in TS 36.331 [10], is not enabled.","paragraph_zero_based":27474},{"literal_text_all_w_t_and_m_t":"If the field is configured (i.e. false) and LTE-NeighCellsCRS-AssistInfoList is configured, the configuration provided in LTE-NeighCellsCRS-AssistInfoList overrides the default network configuration assumptions.","paragraph_zero_based":27475},{"literal_text_all_w_t_and_m_t":"If the field is configured (i.e. false) and LTE-NeighCellsCRS-AssistInfoList is not configured, it is up to the UE implementation whether to apply CRS-IM operation.","paragraph_zero_based":27476},{"literal_text_all_w_t_and_m_t":"nr-dl-PRS-PDC-Info","paragraph_zero_based":27477},{"literal_text_all_w_t_and_m_t":"Configures the DL PRS for propagation delay compensation. When configured, the UE measures the UE Rx-Tx time difference based on the reference signals configured in this field.","paragraph_zero_based":27478},{"literal_text_all_w_t_and_m_t":"nrofHARQ-BundlingGroups","paragraph_zero_based":27479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["3db443465754d6276dcea4a4afb7033bb9e5b98c2bf1125b12249ce2ba28f1ee","3ec64280361d55f78f26aa0360a47d8e8388d96d0661ac3a8d57676353c1ed1e","1b27522c53c0e2455752f8d08a8c17e138c4039fdbd84cfa9f5b33bd467b9016","3ee5114b7422d6b42e837ee9ae084758e841f41e234ac8f24a0c93e17736cb21","1b4e7715108e7439f7417dc0852601c44cc77abe4be7bfda8f194af1919c5162","698b41ba8eb43ebf146c450485a365ea45ccf068f0037f67ca3a8af8106b947e","9a1304fe44b67374d2653fb388e05f1e8ddb0b0e442d7511ee5e9b8804d753c2","0738df93cfadee93a61d622285be63d0e768610144cca3e34cf42ae26cc27a41","237dd4b17c0c1d84baf0693024f5deb46836f25dacb0c1eab77c779c448fe0c1","a22552722e8abd0825c9d2c0943b51870f382a54849f449c70bcf7dda0d3e569","42104196210b85ccfd3e4f296f5b548379dd80ecd473ce6a7d216633016f5d5f","c7766ca0b3f35c16460cbdaed5db0e51dc68f1cb2fe5e82fa286a4a43064b182","d4fe5f829dca6f5d9eb930a5d7c4b763341ac8ef66027ff35d3eab98bcf60276","bcc71afda279def4d652273cedc01fd2cd01d9cc029adf1fa82293058384d939","b50fc67c08b83eb4e8ea83bcf1f79ca1f651cbd676c42b9d22778ea3f2dd320c","bf73b42bb684f774133051fc51208de43d0905c86e7e6057ecdb549c672611d4","584ab8c8d01503a467c207a333ac0baaed6c2ea8cf2b54181df48f0f95527211","c8da11ad5d7254345eac07f10a0fb12b804fd80507e9c6bc0b2f107427cceae5","31f86c809340773446acc69a5a98adb0446431761cffd53c83bb7993a3f62ea8","9c4fb92d4b7894ead880150b90573ec787db5af4b595b5ad3fbadfe6f9a244d5","2f47215c47c2f4a773679e2886d7658c91e4f39378f4923206f8b337834e6362","7cf786b6d6e9774221a39c99dcead2e5139209650acd1a5d127421798b5c6d41","abae1d302c3deb494cbe251dcba6c3b71e40428e091c8c86506696aca2e02db5","e43fb2bb0f0a35a2899a448d8d26860eb65a9e9d15152a6595a9f33d4eb3a426"],"paragraph_range_zero_based":[27456,27479],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p27456"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the number of HARQ bundling groups for type2 HARQ-ACK codebook.","paragraph_zero_based":27480},{"literal_text_all_w_t_and_m_t":"pathlossReferenceLinking","paragraph_zero_based":27481},{"literal_text_all_w_t_and_m_t":"Indicates whether UE shall apply as pathloss reference either the downlink of SpCell (PCell for MCG or PSCell for SCG) or of SCell that corresponds with this uplink (see TS 38.213 [13], clause 7).","paragraph_zero_based":27482},{"literal_text_all_w_t_and_m_t":"pdsch-ServingCellConfig","paragraph_zero_based":27483},{"literal_text_all_w_t_and_m_t":"PDSCH related parameters that are not BWP-specific.","paragraph_zero_based":27484},{"literal_text_all_w_t_and_m_t":"rateMatchPatternToAddModList","paragraph_zero_based":27485},{"literal_text_all_w_t_and_m_t":"Resources patterns which the UE should rate match PDSCH around. The UE rate matches around the union of all resources indicated in the rate match patterns. Rate match patterns defined here on cell level apply only to PDSCH of the same numerology. See TS 38.214 [19], clause 5.1.4.1. If a RateMatchPattern with the same RateMatchPatternId is configured in both ServingCellConfig/ServingCellConfigCommon and in SIB20/MCCH, the entire RateMatchPattern configuration shall be the same, including the set of RBs/REs indicated by the patterns for the rate matching around, and they are counted as a single rate match pattern in the total configured rate match patterns as defined in TS 38.214 [19].","paragraph_zero_based":27486},{"literal_text_all_w_t_and_m_t":"sCellDeactivationTimer","paragraph_zero_based":27487},{"literal_text_all_w_t_and_m_t":"SCell deactivation timer in TS 38.321 [3]. If the field is absent, the UE applies the value infinity.","paragraph_zero_based":27488},{"literal_text_all_w_t_and_m_t":"sfnSchemePDCCH","paragraph_zero_based":27489},{"literal_text_all_w_t_and_m_t":"This parameter is used to configure SFN scheme for PDCCH: sfnSchemeA or sfnSchemeB as specified (see TS 38.214 [19], clause 5.1). If network includes both sfnSchemePDCCH and sfnSchemePDSCH, same value shall be configured.","paragraph_zero_based":27490},{"literal_text_all_w_t_and_m_t":"sfnSchemePDSCH","paragraph_zero_based":27491},{"literal_text_all_w_t_and_m_t":"This parameter is used to configure SFN scheme for PDSCH: sfnSchemeA or sfnSchemeB as specified (see TS 38.214 [19], clause 5.1). If network includes both sfnSchemePDCCH and sfnSchemePDSCH, same value shall be configured. The network does not configure this parameter and repetitionSchemeConfig in PDSCH-Config simultaneously in the same serving cell.","paragraph_zero_based":27492},{"literal_text_all_w_t_and_m_t":"semiStaticChannelAccessConfigUE","paragraph_zero_based":27493},{"literal_text_all_w_t_and_m_t":"When this field is configured and when channelAccessMode-r16 (see IE ServingCellConfigCommon and IE ServingCellConfigCommonSIB) is configured to semiStatic, the UE operates in semi-static channel access mode and can initiate a channel occupancy periodically (see TS 37.213 [48], Clause 4.3).","paragraph_zero_based":27494},{"literal_text_all_w_t_and_m_t":"The period can be configured independently from period configured in SemiStaticChannelAccessConfig-r16 if the UE indicates the corresponding capability. Otherwise, the periodicity configured by periodUE-r17 is an integer multiple of or an integer factor of the periodicity indicated by period in SemiStaticChannelAccessConfig-r16.","paragraph_zero_based":27495},{"literal_text_all_w_t_and_m_t":"servingCellMO","paragraph_zero_based":27496},{"literal_text_all_w_t_and_m_t":"measObjectId of the MeasObjectNR in MeasConfig which is associated to the serving cell. For this MeasObjectNR, the following relationship applies between this MeasObjectNR and frequencyInfoDL in ServingCellConfigCommon of the serving cell: if ssbFrequency is configured, its value is the same as the absoluteFrequencySSB and if csi-rs-ResourceConfigMobility is configured, the value of its subcarrierSpacing is present in one entry of the scs-SpecificCarrierList, csi-RS-CellListMobility includes an entry corresponding to the serving cell (with cellId equal to physCellId in ServingCellConfigCommon) and the frequency range indicated by the csi-rs-MeasurementBW of the entry in csi-RS-CellListMobility is included in the frequency range indicated by in the entry of the scs-SpecificCarrierList.","paragraph_zero_based":27497},{"literal_text_all_w_t_and_m_t":"supplementaryUplink","paragraph_zero_based":27498},{"literal_text_all_w_t_and_m_t":"Network may configure this field only when supplementaryUplinkConfig is configured in ServingCellConfigCommon or supplementaryUplink is configured in ServingCellConfigCommonSIB.","paragraph_zero_based":27499},{"literal_text_all_w_t_and_m_t":"supplementaryUplinkRelease","paragraph_zero_based":27500},{"literal_text_all_w_t_and_m_t":"If this field is included, the UE shall release the uplink configuration configured by supplementaryUplink. The network only includes either supplementaryUplinkRelease or supplementaryUplink at a time.","paragraph_zero_based":27501},{"literal_text_all_w_t_and_m_t":"tag-Id","paragraph_zero_based":27502},{"literal_text_all_w_t_and_m_t":"Timing Advance Group ID, as specified in TS 38.321 [3], which this cell belongs to.","paragraph_zero_based":27503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["ec8c185d2b467f96c7fb129320cc07493c62db070c94bf62e371a3fd3ac979f8","4c7a08ead794444118e167e2431335deb7f147b524b5bf12e9565bceaabb1be0","8fce708eb6d53d520944fc0cb4b8ef9dc8e2a56b1f50cd6ce5fe99496f9ed470","10264aef0c3d925f8e38233871248afaeea46b2f20934ae00a50840a032f4405","cce832068808cf81d406147db661a8ea65316744c769ca37a300f8ed38cfff65","d4cd97017ef7e5e2a045d1367685f0822a25408919d2fc1d271b97154084b88f","b28cf2ebdcc74973a90372e53bb46f79ac0040acc028625690fe99a4ff029b84","08d3fcee49608efbefb3fad068da56fdf9f043746a7ab9f678ab14e89182b9f4","724d0a9b134253d8c330c23d4d2bd3659ee3f1a89831024b88bfc5f1448216c1","bb2dfeafb13e01cddcc79ee71d3afeea3b487e581f6fa6a3a5a26d169c403d5e","48a535d70c75a8e745928d92002d4514c1faa5ea177f047044f74312ccb25c10","5993d0481529c880abf9fa74b1583ede3401e38bb9318ebbdd6bf8e7e6a5f84d","9a967e0f314693ed20797a70289ee6fe660357d27be6ca3fa9bca7207dbd0395","2263861271770fc8332b1f6ceea28434318e2d0e81242206eee95dce541d7e1b","ba0af1b046359bafb75ec1aece291fcdac8b695f989a13629abcbb52dbc631a0","43365d9dc2d7fc54f80a54873b93bc5d3ff214b44733233fed0fab2ba65b9164","79929914ba8a9e7dbd42356631e10abcea0b22e97130a5dd5e2ef924e19b284b","5295282cf193726facc24ccd68d4543417ed422f9fd2e0d61652482d24ac3f93","7c034bb97aa41ba4e5c2fc4a3114222e00d142f7a2f808cd89ae8990d88aeb2e","ceed91a2b09499fec1363d57cadd1ae77a394c587dd173ea67246b455d6176ff","cd79c9dbfd358fffd13c9b84c7dc8fb5c16208aa6a87dec7349fc695bad2c280","057283db240b434b592a265947208616df6bf5251ab71f8cb289e94d8b2d97b2","9615c327072ee78521314f2d4ff06d65b385f61f5ab58cff9625470384439ab5","ed4ca39a82a6a1795825e13d5a8fec1289a948a5cd76370513558dade7aca871"],"paragraph_range_zero_based":[27480,27503],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p27480"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"tci-ActivatedConfig","paragraph_zero_based":27504},{"literal_text_all_w_t_and_m_t":"If configured for an SCell, or if configured for the PSCell when the SCG is being activated upon the reception of the containing message, the UE shall consider the TCI states provided in this field as the activated TCI states for PDCCH/PDSCH reception on this serving cell.","paragraph_zero_based":27505},{"literal_text_all_w_t_and_m_t":"If configured for the PSCell when the SCG is indicated as deactivated in the containing message:","paragraph_zero_based":27506},{"literal_text_all_w_t_and_m_t":"- the UE shall consider the TCI states provided in this field as the TCI states to be activated for PDCCH/PDSCH reception upon a later SCG activation in which tci-ActivatedConfig is absent","paragraph_zero_based":27507},{"literal_text_all_w_t_and_m_t":"- if bfd-and-RLM is configured and no RS is configured in RadioLinkMonitoringConfig for RLM, respectively for BFD, the UE shall use the TCI states provided in this field for PDCCH as RS for RLM, respectively for BFD.","paragraph_zero_based":27508},{"literal_text_all_w_t_and_m_t":"When this field is absent for the PSCell and the SCG is being deactivated:","paragraph_zero_based":27509},{"literal_text_all_w_t_and_m_t":"- the UE shall consider the previously activated TCI states as the TCI states to be activated for PDCCH/PDSCH reception upon a later SCG activation in which tci-ActivatedConfig is absent","paragraph_zero_based":27510},{"literal_text_all_w_t_and_m_t":"- if bfd-and-RLM is configured and no RS is configured in RadioLinkMonitoringConfig for RLM, respectively for BFD, the UE shall use the previously activated TCI states for PDCCH as RS for RLM, respectively for BFD.","paragraph_zero_based":27511},{"literal_text_all_w_t_and_m_t":"tdd-UL-DL-ConfigurationDedicated-IAB-MT","paragraph_zero_based":27512},{"literal_text_all_w_t_and_m_t":"Resource configuration per IAB-MT D/U/F overrides all symbols (with a limitation that effectively only flexible symbols can be overwritten in Rel-16) per slot over the number of slots as provided by TDD-UL-DL ConfigurationCommon.","paragraph_zero_based":27513},{"literal_text_all_w_t_and_m_t":"unifiedTCI-StateType","paragraph_zero_based":27514},{"literal_text_all_w_t_and_m_t":"Indicates the unified TCI state type the UE is configured for this serving cell. The value separate means this serving cell is configured with dl-OrJointTCI-StateList for DL TCI state and ul-TCI-ToAddModList for UL TCI state. The value joint means this serving cell is configured with dl-OrJointTCI-StateList for joint TCI state for UL and DL operation. The network does not configure the field in a serving cell that is configured with more than one value for the coresetPoolIndex.","paragraph_zero_based":27515},{"literal_text_all_w_t_and_m_t":"uplinkConfig","paragraph_zero_based":27516},{"literal_text_all_w_t_and_m_t":"Network may configure this field only when uplinkConfigCommon is configured in ServingCellConfigCommon or ServingCellConfigCommonSIB. Addition or release of this field can only be done upon SCell addition or release (respectively).","paragraph_zero_based":27517},{"literal_text_all_w_t_and_m_t":"uplink-PowerControlToAddModList","paragraph_zero_based":27518},{"literal_text_all_w_t_and_m_t":"Configures UL power control parameters for PUSCH, PUCCH and SRS when field unifiedTCI-StateType is configured for this serving cell.","paragraph_zero_based":27519},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27520},{"literal_text_all_w_t_and_m_t":"UplinkConfig field descriptions","paragraph_zero_based":27521},{"literal_text_all_w_t_and_m_t":"carrierSwitching","paragraph_zero_based":27522},{"literal_text_all_w_t_and_m_t":"Includes parameters for configuration of carrier based SRS switching (see TS 38.214 [19], clause 6.2.1.3.","paragraph_zero_based":27523},{"literal_text_all_w_t_and_m_t":"enableDefaultBeamPL-ForPUSCH0-0, enableDefaultBeamPL-ForPUCCH, enableDefaultBeamPL-ForSRS","paragraph_zero_based":27524},{"literal_text_all_w_t_and_m_t":"When the parameter is present, UE derives the spatial relation and the corresponding pathloss reference Rs as specified in 38.213, clauses 7.1.1, 7.2.1, 7.3.1 and 9.2.2. The network only configures these parameters for FR2.","paragraph_zero_based":27525},{"literal_text_all_w_t_and_m_t":"enablePL-RS-UpdateForPUSCH-SRS","paragraph_zero_based":27526},{"literal_text_all_w_t_and_m_t":"When this parameter is present, the Rel-16 feature of MAC CE based pathloss RS updates for PUSCH/SRS is enabled. Network only configures this parameter when the UE is configured with sri-PUSCH-PowerControl. If this field is not configured, network configures at most 4 pathloss RS resources for PUSCH/PUCCH/SRS transmissions per BWP, not including pathloss RS resources for SRS transmissions for positioning. (See TS 38.213 [13], clause 7).","paragraph_zero_based":27527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["59174cf7b3aa0daef9c3e469d47f1d7e862563f5065928d68f8256808bc8ab11","6c2e48136f4c92ee0fd35f806a683425fd5f254d5aab0d50a2820d0dff8aec28","f96a19cf8926570501e5a1b1c7dbcc5ee0465ced2e5708b3e28500aa77b7e491","58029487569558e1783be8c06e572a81c2d04bc5f53e1557a60e7e930cc53b86","fd647c00ab9a8dd71c5a672e905a44d851db4ff113187872fb8e5af2a238347a","0cfc72405a5721a1d5d6f8c46e64afa8b4b50b293522f6c66125d987b4520e6c","d70ab41d0f1c641d9865785fd0f5ab9e3016c3c3b4591bb5aafb8ee4345e07e7","650094a2d1219fd8d4c37b0828475dd040ca9f52aad0ecef56a1db0636a37253","6b26c8d47e9883a2304cd25443ecacee18f931c4b94eebf3ec26ef03627ec7a7","32518f80b02bfab15634147f8b8159737678fd37279dfa21af483bacd24dc71e","c4475d9544b519e1f50aa3c24023ffb2b3cbab4a1e5e13fa9f344518f9858886","c23712961c50ec2e5329bae16a2d9c533a148d581f4eed84dfeed8c6b775b333","a9c02e8b1f3e230fb2f707a727e43ff7ef57b7e325144c5d2187b2db1fd84572","1dcd252a56bccac1ffb6aaadc9ec17b30000efec6d507b55fe33c9062c3e0abf","eb92a77236f7d359dab304ae2770ab38e064ed2940539bfd45ae0acfb2e66464","47c158fc860dcb6f724b4602225db82ffae0b4e372be0d17251b673c14c43c6b","2bd61b43dc6f79334e34b8b19b61a1b02b7ec3a24e12b239e4f2e0c68e7f8738","b3eba5da2799622d2ce8a80c6ca2a1d3ba715851be87962220d793fdb5f62034","230c87695cc3a5dfcc221530109b5debdbd5ff3b8f4985c9c7b81dfe615d7212","5af9b881466a5fb1c99fa996a935a2be45e2956ba498ff8953b244e3b2b2f8aa","5a6caa2ddf43a243581951603ea0c9ffe1be32d211bb9d8f782cc4857e9b2ab5","0f3d9a7e1ca5320fa6c62e0a7355881a8b4c0bdb0bea76dbed4d7f71344bcce7","94d18b4a36b1a6a60d9ecf7b0a8817e7d50b2cd65b74c5be434b99bc7b13cb99","074f5ef8ec18b0949ca4526a7ce8a083062d98c0f33e911b8d7ed1034958a8e7"],"paragraph_range_zero_based":[27504,27527],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p27504"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"firstActiveUplinkBWP-Id","paragraph_zero_based":27528},{"literal_text_all_w_t_and_m_t":"If configured for an SpCell, this field contains the ID of the UL BWP to be activated upon performing the RRC (re-)configuration. If the field is absent, the RRC (re-)configuration does not impose a BWP switch.","paragraph_zero_based":27529},{"literal_text_all_w_t_and_m_t":"If configured for an SCell, this field contains the ID of the uplink bandwidth part to be used upon activation of an SCell. The initial bandwidth part is referred to by BandiwdthPartId = 0.","paragraph_zero_based":27530},{"literal_text_all_w_t_and_m_t":"initialUplinkBWP","paragraph_zero_based":27531},{"literal_text_all_w_t_and_m_t":"The dedicated (UE-specific) configuration for the initial uplink bandwidth-part (i.e. UL BWP#0). If any of the optional IEs are configured within this IE as part of the IE uplinkConfig, the UE considers the BWP#0 to be an RRC configured BWP (from UE capability viewpoint). Otherwise, the UE does not consider the BWP#0 as an RRC configured BWP (from UE capability viewpoint). Network always configures the UE with a value for this field if no other BWPs are configured. NOTE1","paragraph_zero_based":27532},{"literal_text_all_w_t_and_m_t":"moreThanOneNackOnlyMode","paragraph_zero_based":27533},{"literal_text_all_w_t_and_m_t":"Indicates the mode of NACK-only feedback in the PUCCH transmission, as specified in TS 38.213 [13], clause 18. If multicast CFR is not configured, this field is not included. Otherwise, if the field is absent, UE uses mode 1 for multicast CFR.","paragraph_zero_based":27534},{"literal_text_all_w_t_and_m_t":"mpr-PowerBoost-FR2","paragraph_zero_based":27535},{"literal_text_all_w_t_and_m_t":"Indicates whether UE is allowed to boost uplink transmission power by suspending in-band emission (IBE) requirements as specified in TS 38.101-2 [39]. Network only configures this field for FR2 serving cells.","paragraph_zero_based":27536},{"literal_text_all_w_t_and_m_t":"powerBoostPi2BPSK","paragraph_zero_based":27537},{"literal_text_all_w_t_and_m_t":"If this field is set to true, the UE determines the maximum output power for PUCCH/PUSCH transmissions that use pi/2 BPSK modulation according to TS 38.101-1 [15], clause 6.2.4.","paragraph_zero_based":27538},{"literal_text_all_w_t_and_m_t":"pusch-ServingCellConfig","paragraph_zero_based":27539},{"literal_text_all_w_t_and_m_t":"PUSCH related parameters that are not BWP-specific.","paragraph_zero_based":27540},{"literal_text_all_w_t_and_m_t":"uplinkBWP-ToAddModList","paragraph_zero_based":27541},{"literal_text_all_w_t_and_m_t":"The additional bandwidth parts for uplink to be added or modified. In case of TDD uplink- and downlink BWP with the same bandwidthPartId are considered as a BWP pair and must have the same center frequency.","paragraph_zero_based":27542},{"literal_text_all_w_t_and_m_t":"uplinkBWP-ToReleaseList","paragraph_zero_based":27543},{"literal_text_all_w_t_and_m_t":"The additional bandwidth parts for uplink to be released.","paragraph_zero_based":27544},{"literal_text_all_w_t_and_m_t":"uplinkChannelBW-PerSCS-List","paragraph_zero_based":27545},{"literal_text_all_w_t_and_m_t":"A set of UE specific channel bandwidth and location configurations for different subcarrier spacings (numerologies). Defined in relation to Point A. The UE uses the configuration provided in this field only for the purpose of channel bandwidth and location determination. If absent, UE uses the configuration indicated in scs-SpecificCarrierList in UplinkConfigCommon / UplinkConfigCommonSIB. Network only configures channel bandwidth that corresponds to the channel bandwidth values defined in TS 38.101-1 [15], TS 38.101-2 [39], and TS 38.101-5 [75].","paragraph_zero_based":27546},{"literal_text_all_w_t_and_m_t":"uplinkTxSwitchingPeriodLocation","paragraph_zero_based":27547},{"literal_text_all_w_t_and_m_t":"Indicates whether the location of UL Tx switching period is configured in this uplink carrier in case of inter-band UL CA, SUL, or (NG)EN-DC, as specified in TS 38.101-1 [15] and TS 38.101-3 [34].","paragraph_zero_based":27548},{"literal_text_all_w_t_and_m_t":"In case of (NG)EN-DC, network always configures this field to TRUE for NR carrier (i.e. with (NG)EN-DC, the UL switching period always occurs on the NR carrier).","paragraph_zero_based":27549},{"literal_text_all_w_t_and_m_t":"In case of inter-band UL CA or SUL, for dynamic uplink Tx switching between 2 bands with 2 uplink carriers or 3 uplink carriers as defined in TS 38.101-1 [15], network configures this field to TRUE for the uplink carrier(s) on one band and configures this field to FALSE for the uplink carrier(s) on the other band. This field is set to the same value for the carriers on the same band.","paragraph_zero_based":27550},{"literal_text_all_w_t_and_m_t":"uplinkTxSwitchingCarrier","paragraph_zero_based":27551}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["7c4b4deac572a9e1b3bc1bb01e7da1db98fd9ee0c0acb6124b5f2980f53ef4a5","968dd0cc32a03fabeeb4642c01979d4d353d188b9b0520d38203f95c340d0a2a","97f28110b7fcf1a2439d594acdf5c435edc69aa183dc1c3247df503a65b4fd3e","d82d37734435c88430f8bad325e44192fcf4f1f7c13d3464a81c0cf5da9cc4da","9f76d2dfc1f27b638a83324c42539c82a46cdb04d5ea2cc80ba46c522c2f795a","a2b4f0b8be73cef2ed1122ec71a9d125b823c20ed1839c376f0af449ddf32b76","ef4292f89720b501338f96ebd5e26561a7d7805da3de56d5a85d80d41a63104c","afdee8921744caacf69290cd85654d3963e6529f2cd8445f1d381bd3a545db74","abf9a67e462095074532022cde37dd3b076227c6c6e036ea63755624830c84ea","a9be4510d4bdc7955a87214ad58b98213f2783e2ff970161c8cd56067e06c785","d180df08caeb69917d0978d3193d098f4ab12b773bf203b63735485be5a5115d","d8e6a1e369bdf1b9d1d0e73a7600e84ade10f811b9bc1c166fc90b8382508e46","4cb6a5b61227a12165c4ce834414a3398469034b567588f3d69a61a4a600c436","2bdc8ea3c2c143a68a00f88e19ab4f75704d6945d67465e4cd2da0cc7e43987a","dc751ffc5901f221bc514835a0bf584f9683c4558e72be529d9c31eb1ce5783a","feaa94dfd52dd5883d15e1f1265698a23ca7447317cccdae60e7b235c0b79dd8","61e343659178d13ee6e72eb3646022ba23ba43cb9464635d07cd2bcb583de8c4","b651e52c34fc809d1d6e72865d625a8d52c0aed796e4b3c5bedf76ec71540b2b","acd45da2d6a84b1795cd303673f6a95523545e6777d664f5e9b8e93f1dda11af","eb9453e8b59caa66c371fb2190efb04c2bf326995f1d2dbc44a9935f984575ce","d60fc688e42d2cfb34bffeada5574a2100d007284b00a6db003e3bb23f777897","224e5766319ec3313531e02a83ea2851f4a6b07b9b4e47055985351d65e78c40","5ca443391f616c73f65c2751eced54604a9a81a52fc7b284549104c6eab79b3a","cb521bb688dc8be5522d548854b89a9bd4395d304df5421896b7be7f4db4254d"],"paragraph_range_zero_based":[27528,27551],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p27528"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates that the configured carrier is carrier1 or carrier2 for dynamic uplink Tx switching, as defined in TS 38.101-1 [15] and TS 38.101-3 [34]. In case of (NG)EN-DC, network always configures the NR carrier as carrier 2.","paragraph_zero_based":27552},{"literal_text_all_w_t_and_m_t":"In case of inter-band UL CA or SUL, for dynamic uplink Tx switching between 2 bands with 2 uplink carriers or 3 uplink carriers as defined in TS 38.101-1 [15], network configures the uplink carrier(s) on one band as carrier1 and the uplink carrier(s) on the other band as carrier2. This field is set to the same value for the carriers on the same band.","paragraph_zero_based":27553},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27554},{"literal_text_all_w_t_and_m_t":"DormantBWP-Config field descriptions","paragraph_zero_based":27555},{"literal_text_all_w_t_and_m_t":"dormancyGroupWithinActiveTime","paragraph_zero_based":27556},{"literal_text_all_w_t_and_m_t":"This field contains the ID of an SCell group for Dormancy within active time, to which this SCell belongs. The use of the Dormancy within active time for SCell groups is specified in TS 38.213 [13].","paragraph_zero_based":27557},{"literal_text_all_w_t_and_m_t":"dormancyGroupOutsideActiveTime","paragraph_zero_based":27558},{"literal_text_all_w_t_and_m_t":"This field contains the ID of an SCell group for Dormancy outside active time, to which this SCell belongs. The use of the Dormancy outside active time for SCell groups is specified in TS 38.213 [13].","paragraph_zero_based":27559},{"literal_text_all_w_t_and_m_t":"dormantBWP-Id","paragraph_zero_based":27560},{"literal_text_all_w_t_and_m_t":"This field contains the ID of the downlink bandwidth part to be used as dormant BWP. If this field is configured, its value is different from defaultDownlinkBWP-Id, and at least one of the withinActiveTimeConfig and outsideActiveTimeConfig should be configured.","paragraph_zero_based":27561},{"literal_text_all_w_t_and_m_t":"firstOutsideActiveTimeBWP-Id","paragraph_zero_based":27562},{"literal_text_all_w_t_and_m_t":"This field contains the ID of the downlink bandwidth part to be activated when receiving a DCI indication for SCell dormancy outside active time.","paragraph_zero_based":27563},{"literal_text_all_w_t_and_m_t":"firstWithinActiveTimeBWP-Id","paragraph_zero_based":27564},{"literal_text_all_w_t_and_m_t":"This field contains the ID of the downlink bandwidth part to be activated when receiving a DCI indication for SCell dormancy within active time.","paragraph_zero_based":27565},{"literal_text_all_w_t_and_m_t":"outsideActiveTimeConfig","paragraph_zero_based":27566},{"literal_text_all_w_t_and_m_t":"This field contains the configuration to be used for SCell dormancy outside active time, as specified in TS 38.213 [13]. The field can only be configured when the cell group the SCell belongs to is configured with dcp-Config.","paragraph_zero_based":27567},{"literal_text_all_w_t_and_m_t":"withinActiveTimeConfig","paragraph_zero_based":27568},{"literal_text_all_w_t_and_m_t":"This field contains the configuration to be used for SCell dormancy within active time, as specified in TS 38.213 [13]. ","paragraph_zero_based":27569},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27570},{"literal_text_all_w_t_and_m_t":"GuardBand field descriptions","paragraph_zero_based":27571},{"literal_text_all_w_t_and_m_t":"startCRB","paragraph_zero_based":27572},{"literal_text_all_w_t_and_m_t":"Indicates the starting RB of the guard band.","paragraph_zero_based":27573},{"literal_text_all_w_t_and_m_t":"nrofCRB","paragraph_zero_based":27574},{"literal_text_all_w_t_and_m_t":"Indicates the length of the guard band in RBs. When set to 0, zero-size guard band is used.","paragraph_zero_based":27575}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["70b5a204c56809389e45458b76b8d35896833a71493546a2373b60cc30d897c0","ec024f969cafed3f4b1e98e5a582b3ecea405172bbfc3678c11355d2db9d2815","5056cb05191367aea2dab7b1f17e4870ab5d3a015e84046d345f1646d8dbe929","801cfa73e5f59f7def57bcb3787420cb377913323a2cdfc277627c721d1fef70","e302a8f2fb75fad84181a295128e01d0cbd3658e8e3d3bca587b734d7cb25e6e","e7b9d73ede20c7c99d8345f31eda948eac6b68196dacb5453d0be68d9174abe7","4a31c002c71386acb00e368cd0d2645f527abeabcd40999fcd889d56bc913130","e46a03144584f1a4a4ddf69fa5070fa5058da9c6ba25e3f85d82eeeaa3eb1d45","f9e90b3e4aa1f917533282c2fd390e3ea798c54e3615a388bd7926aec2bba73d","cc3916ac0b4faf1229ccb59b27783e277483561ca24a765434349b206f7c0649","ad414f3763e7a99d9689b4ff0502e44c3fec90d17ba31972934672f228ebf89a","8d71fdd8ed171175e88c0adfc71764ea9bfbe60d94307fd3c0564168345b2c30","eb12a7eacfdd3b55280c9cb33e4824875b08b8a0a801970737c3a703cb604f27","3c4b0d0acbb58a28349be5f167407da4eb873c96eec70f4987661d6d897a91bb","2a2ebce31ddd2fe45283c2705fea2034f4071e37487c069202bb839082ccaa47","e808339e4c556230c26076c00fdc286a1f261c0f9c0773ae8c3305280a55b477","14f701db26dc84c915fc1b290e8fb2efbdb9fa781b348678860b9191513b5e1e","4417f96b67c45d1f77ee5c515de8d6f87e3e54feb03b45e5f650f535d573b727","1ce5dc2e729b68eebfd2d22017c54406cd23e71af39e22edd6a4039f4e87d626","32328e7a22da0a8300fa3d60b7f6670d1bebd9ac8bbd8fff2b297adad1597923","2e23b9f68413cbb180f25b3679b61a8d727d6a9a5676b62ccfeb6594efde87d6","4516e1b1b141b067228a14d06bc698b3b798d951396ebfd4ff3d1f0fd3a07c7c","bb3b24de17ad77bded3ca1668dcc1083d0a9429ee1fa4900dd0df8ca8d68f3a9","743fa6567f06e3d9d155a9ebd7eb20720fd23d8dc3ba9d9fa03182f7b09d93bb"],"paragraph_range_zero_based":[27552,27575],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p27552"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27576},{"literal_text_all_w_t_and_m_t":"NOTE 1:If the dedicated part of initial UL/DL BWP configuration is absent, the initial BWP can be used but with some limitations. For example, changing to another BWP requires RRCReconfiguration since DCI format 1_0 doesn't support DCI-based switching.","paragraph_zero_based":27577},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27578},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":27579},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":27580},{"literal_text_all_w_t_and_m_t":"AsyncCA","paragraph_zero_based":27581},{"literal_text_all_w_t_and_m_t":"This field is mandatory present for SCells whose slot offset between the SpCell is not 0. Otherwise it is absent, Need S.","paragraph_zero_based":27582},{"literal_text_all_w_t_and_m_t":"MeasObject","paragraph_zero_based":27583},{"literal_text_all_w_t_and_m_t":"This field is mandatory present for the SpCell if the UE has a measConfig, and it is optionally present, Need M, for SCells. For RedCap UEs, this field is optionally present, Need M.","paragraph_zero_based":27584},{"literal_text_all_w_t_and_m_t":"SCellOnly","paragraph_zero_based":27585},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, for SCells. It is absent otherwise. ","paragraph_zero_based":27586},{"literal_text_all_w_t_and_m_t":"ServingCellWithoutPUCCH","paragraph_zero_based":27587},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need S, for SCells except PUCCH SCells. It is absent otherwise.","paragraph_zero_based":27588},{"literal_text_all_w_t_and_m_t":"SyncAndCellAdd","paragraph_zero_based":27589},{"literal_text_all_w_t_and_m_t":"This field is mandatory present for a SpCell upon reconfiguration with reconfigurationWithSync and upon RRCSetup/RRCResume.","paragraph_zero_based":27590},{"literal_text_all_w_t_and_m_t":"The field is optionally present for an SpCell, Need N, upon reconfiguration without reconfigurationWithSync.","paragraph_zero_based":27591},{"literal_text_all_w_t_and_m_t":"The field is mandatory present for an SCell upon addition, and absent for SCell in other cases, Need M.","paragraph_zero_based":27592},{"literal_text_all_w_t_and_m_t":"TCI_ActivatedConfig","paragraph_zero_based":27593},{"literal_text_all_w_t_and_m_t":"This field is optional Need N for SCells if sCellState is configured, otherwise it is absent.","paragraph_zero_based":27594},{"literal_text_all_w_t_and_m_t":"This field is optional Need S for the PSCell when the SCG is indicated as deactivated or is being activated, otherwise it is absent.","paragraph_zero_based":27595},{"literal_text_all_w_t_and_m_t":"This field is absent for the PCell.","paragraph_zero_based":27596},{"literal_text_all_w_t_and_m_t":"TDD","paragraph_zero_based":27597},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, for TDD cells. It is absent otherwise.","paragraph_zero_based":27598},{"literal_text_all_w_t_and_m_t":"TDD_IAB","paragraph_zero_based":27599}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["b67d49fe93f168fffd6bdc8874ce31a605725383602dd6688c68986fd37f908c","f2b2686a22e666288ca2a6e036c57dccfbda6a7fddd1c9cf4c4e45c76fb1b516","2067f5a2f877e4f0963559cfbacde447b4da6dc2c09a64fa5dbd35961863186d","508d95342f0f240a2ed9db65b6435756945b6dbf9fdfb85a488363e70f3dc065","317f0bafdda387d18254b34a9cf11fba5f6f00645ab7d7df9196e354b80bafeb","83ee5283900f04242f5a573d6ae3e9d63a27147690805c0145d94