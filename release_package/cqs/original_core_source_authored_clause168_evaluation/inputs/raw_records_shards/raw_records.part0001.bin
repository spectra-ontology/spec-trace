f2f10f47d9f0632b3b23be1f5f90148c8756c5deb1e6b2bfdfe4455cbe78d","23a7642206113904d7dd0e3c744c0335f045cddb5476c4ae46cbf54c7238d381","17ea160cc3d0d2e82e3e5c8b309979af8de9af370ea8cd7655e629c38af73818","d6bf782e0cac9a3f05bbac8142ad358ed7990a5e1bedfa187badf1db9c61499c","773a79f7eb6f0de1ca49fe5f2cadbbb9807d88e3e67d16b55f2cdf12d036382a","021767807e20bf02105057899a75e3ac1ebc9ad1062f9f11d826585384ec8a16","baf6a33b0b2934278aba17f6c2f5556496cf2b93af9f3583cbc09742791c5f2b","16fee2d4ee11cf1eba3ee542a94ef579c17d1046ead818158272e1f320e3e08a"],"paragraph_range_zero_based":[26784,26807],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p26784"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"T-ReassemblyExt-r17 ::=             ENUMERATED {ms210, ms220, ms340, ms350, ms550, ms1100, ms1650, ms2200}","paragraph_zero_based":26808},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26809},{"literal_text_all_w_t_and_m_t":"-- TAG-RLC-CONFIG-STOP","paragraph_zero_based":26810},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26811},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26812},{"literal_text_all_w_t_and_m_t":"RLC-Config field descriptions","paragraph_zero_based":26813},{"literal_text_all_w_t_and_m_t":"maxRetxThreshold","paragraph_zero_based":26814},{"literal_text_all_w_t_and_m_t":"Parameter for RLC AM in TS 38.322 [4]. Value t1 corresponds to 1 retransmission, value t2 corresponds to 2 retransmissions and so on.","paragraph_zero_based":26815},{"literal_text_all_w_t_and_m_t":"pollByte","paragraph_zero_based":26816},{"literal_text_all_w_t_and_m_t":"Parameter for RLC AM in TS 38.322 [4]. Value kB25 corresponds to 25 kBytes, value kB50 corresponds to 50 kBytes and so on. infinity corresponds to an infinite amount of kBytes.","paragraph_zero_based":26817},{"literal_text_all_w_t_and_m_t":"pollPDU","paragraph_zero_based":26818},{"literal_text_all_w_t_and_m_t":"Parameter for RLC AM in TS 38.322 [4]. Value p4 corresponds to 4 PDUs, value p8 corresponds to 8 PDUs and so on. infinity corresponds to an infinite number of PDUs.","paragraph_zero_based":26819},{"literal_text_all_w_t_and_m_t":"sn-FieldLength","paragraph_zero_based":26820},{"literal_text_all_w_t_and_m_t":"Indicates the RLC SN field size, see TS 38.322 [4], in bits. Value size6 means 6 bits, value size12 means 12 bits, value size18 means 18 bits. The value of sn-FieldLength of an RLC entity for the DRB/multicast MRB shall be changed only using reconfiguration with sync. The network configures only value size12 in SN-FieldLengthAM for SRB.","paragraph_zero_based":26821},{"literal_text_all_w_t_and_m_t":"t-PollRetransmit","paragraph_zero_based":26822},{"literal_text_all_w_t_and_m_t":"Timer for RLC AM in TS 38.322 [4], in milliseconds. Value ms5 means 5 ms, value ms10 means 10 ms and so on.","paragraph_zero_based":26823},{"literal_text_all_w_t_and_m_t":"t-Reassembly, t-ReassemblyExt","paragraph_zero_based":26824},{"literal_text_all_w_t_and_m_t":"Timer for reassembly in TS 38.322 [4], in milliseconds. Value ms0 means 0 ms, value ms5 means 5 ms and so on. If t-ReassemblyExt-r17 is configured, the UE shall ignore t-Reassembly (without suffix).","paragraph_zero_based":26825},{"literal_text_all_w_t_and_m_t":"t-StatusProhibit","paragraph_zero_based":26826},{"literal_text_all_w_t_and_m_t":"Timer for status reporting in TS 38.322 [4], in milliseconds. Value ms0 means 0 ms, value ms5 means 5 ms and so on. If t-StatusProhibit-v1610 is present, the UE shall ignore t-StatusProhibit (without suffix).","paragraph_zero_based":26827},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26828},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":26829},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":26830},{"literal_text_all_w_t_and_m_t":"Reestab","paragraph_zero_based":26831}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["0792fd321d9131a600c57de05a3d356f7688caed591abf1b3640c4fb6843a716","dda32f1f432b660b5c558ec9ae176a1fabc4493a690434d875f04b02bb395bd3","530a6066c3ffa19a9bba869542e04caeccc4ba39d7fdd2d69c65c107994f92ab","797ec0e618c8c18f7221d076518b72a2c3d4c55e86c61794120b1b531a43d249","fc3843577a3450412d78c