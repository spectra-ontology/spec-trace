915},{"literal_text_all_w_t_and_m_t":"SIB12 contains NR sidelink communication/discovery configuration.","paragraph_zero_based":13916},{"literal_text_all_w_t_and_m_t":"SIB12 information element","paragraph_zero_based":13917},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":13918},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB12-START","paragraph_zero_based":13919}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["61e08b968d440d38b7f665e96eec19e1e30f67e3b0053c48012fa4e946146835","feb712dfc3ba349bfe2ade92a3092b755a9bf704a97ee905f29cc6aab0269fa3","402de63c5a84eb6aec77878f88c5e46a3c72fe5f1a4514e86832dad6c5da61bd","dfc4086a27791121656f00ca1119618438770f9458d6fc9f11012200cfd23330","9e951df9281745f05497ff2008d30e021cdd9cacd0212bce5cc81dc599bc1425","2c79ea4c36c5672c9cae021ba2598bd202a1ed00a80a7ac1170c890711417432","a56e2eac1e5b30abc89b49eae3436d070a05f399dc44604e7e91782df34083ad","58537e0eeddd34d95125f597739a78e53774165eca553ebc4b8bedd1652705f9","82a829f5081f9b5cdf29c14b5b9d992339712eba323bc731e00e7c1d62fb2c68","3f2d60f3cb7a34447ae47e5bd49a5f4e55eeac09bb1366e4e6523b06864ebb88","574f6dd392d470f12ee16034880b99bc622dbbd3b5bf90ff39025adc7a901807","ae5b7eb1b1cd308bef1357e8113e91e03b5c54b0e13e5580de3a88d0838d6040","a075984d7a1b3551736046018fb2d896c72e3445eaed73b5fa5a29d0d0bbbce5","9b751ecae352a3432448a22c6a5b6ab5f8634ba4a672904f625c16bb5172497a","420e32114d3f0bb0fdd34d22b5c9e235d40b5d2c9a2ae3b67a4f12aedfa6d6e0","3bcdf6f9541cc1bbaf6398ff691a9f472a1ff38dcb6ec510bb6d7dbaf4fd9734","88f08cd457f8e89dea8c6d73577bce5139fe2ed6144144a84589a541ea80cf1d","5cfe0d5c6af461cd79cd91684f57cf8f167f4ac2af17f81b13799f12128ca3f5","c8e2ec0a5943deb8fadded3aaa5050854cd19b7587aff7d688efd67