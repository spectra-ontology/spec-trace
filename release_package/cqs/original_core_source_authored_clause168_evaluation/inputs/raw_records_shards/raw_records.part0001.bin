{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–MBS-NeighbourCellList","paragraph_zero_based":39912},{"literal_text_all_w_t_and_m_t":"The IE MBS-NeighbourCellList indicates a list of neighbour cells where ongoing MBS sessions provided via broadcast MRB in the current cell may also be provided, as indicated in the mtch-NeighbourCell.","paragraph_zero_based":39913},{"literal_text_all_w_t_and_m_t":"MBS-NeighbourCellList information element","paragraph_zero_based":39914},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39915},{"literal_text_all_w_t_and_m_t":"-- TAG-MBS-NEIGHBOURCELLLIST-START","paragraph_zero_based":39916},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39917},{"literal_text_all_w_t_and_m_t":"MBS-NeighbourCellList-r17 ::=     SEQUENCE (SIZE (0..maxNeighCellMBS-r17)) OF MBS-NeighbourCell-r17","paragraph_zero_based":39918},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39919},{"literal_text_all_w_t_and_m_t":"MBS-NeighbourCell-r17 ::=         SEQUENCE {","paragraph_zero_based":39920},{"literal_text_all_w_t_and_m_t":"    physCellId-r17                    PhysCellId,","paragraph_zero_based":39921},{"literal_text_all_w_t_and_m_t":"    carrierFreq-r17                   ARFCN-ValueNR                                  OPTIONAL  -- Need S","paragraph_zero_based":39922},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39923},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39924},{"literal_text_all_w_t_and_m_t":"-- TAG-MBS-NEIGHBOURCELLLIST-STOP","paragraph_zero_based":39925},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39926},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39927},{"literal_text_all_w_t_and_m_t":"MBS-NeighbourCellList field descriptions","paragraph_zero_based":39928},{"literal_text_all_w_t_and_m_t":"carrierFreq","paragraph_zero_based":39929},{"literal_text_all_w_t_and_m_t":"Indicates the frequency of the neighbour cell indicated by physCellId. Absence of the IE means that the neighbour cell is on the same frequency as the current cell.","paragraph_zero_based":39930},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39931},{"literal_text_all_w_t_and_m_t":"–MBS-ServiceList","paragraph_zero_based":39932},{"literal_text_all_w_t_and_m_t":"The IE MBS- ServiceList is used to inform the network of the MBS services that the UE is receiving or interested to receive.","paragraph_zero_based":39933},{"literal_text_all_w_t_and_m_t":"MBS-ServiceList information element","paragraph_zero_based":39934},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39935}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["0033334e3b0223496696b282cfe995a97e662abc386f62e6d01ae0000d976f2d","0ad7ecf3d674f500e6f5afa0f05bc481c4218cc68b7784144f84f5e8cad0fa3b","cc6ac77838a8a3e52e292c87bf6307e82bf322a9db65295588b17bc2ac5ac2be","dc5c80a2fa38d64d7830423b6774d16e9ebb69a59c7e1e1ba5cddc1be01ef436","b4b488137951aec92a48c74e63ad054594a3f1050519eefc088f63a3136fb0e7","b3d3f51d49321fe796fdea5ceb2349cb8c6265a340587cb39292011ae52ce138","38e08091aaca68f019980ede31dd545f64e8bf13ef07da25998122e755143baf","272f0dac7e64431fb6d4407d7a5522755b88df5daaaaa930ecc1d08b11473559","70c9320c5add86883677a7eacd9ee7993c7dfa01aaeaafc1ef5f3b74ead4f455","1e3765865b85717b6716b9a1018044df1a4ab235b3b8918bb4040dc89d94a309","fe801a398c93e525664217b966610851a7defa76d5ceb8565e309133f3ff95cd","923cfbe89c2dff958c0715c4b4f275b8af70626e66c78c95448f97e7d8405e9f","610a871483c5559b34c142967c03dc6ef3ef028e96a3423684cd68085524f4d9","d9