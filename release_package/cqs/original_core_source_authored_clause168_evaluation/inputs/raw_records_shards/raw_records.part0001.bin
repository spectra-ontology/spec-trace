OPTIONAL,   -- Need R","paragraph_zero_based":22117},{"literal_text_all_w_t_and_m_t":"    searchSpaceSwitchDelay-r17          INTEGER (10..52)                                                 OPTIONAL    -- Need R","paragraph_zero_based":22118},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22119},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22120},{"literal_text_all_w_t_and_m_t":"CellGroupForSwitch-r16 ::=          SEQUENCE(SIZE (1..16)) OF ServCellIndex","paragraph_zero_based":22121},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22122},{"literal_text_all_w_t_and_m_t":"SCS-SpecificDuration-r17   ::=      INTEGER (1..166)","paragraph_zero_based":22123},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22124},{"literal_text_all_w_t_and_m_t":"-- TAG-PDCCH-CONFIG-STOP","paragraph_zero_based":22125},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":22126},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22127}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["27f99ab23e5a0b6a0b3aa80ab128a184d0d6cb5637b69951c7ed2f7dc71f8e35","9f382ca575044a9c9d7084fbd6150b8d1ad81927a9a9a728e7b99a7a35f974a1","f9379df3b31a63e66817cffd0dd9dcdf2f72db3d6e26164a98fb18e45fde011f","f1b2633af9011ed22dd256c1c45abd7a630fcfcb8a5d4d884982d2012192dd7d","e2f1312dfa019c8a25ba36a466c82c511d9b5b6d239e437d9f564ba86f0b1a75","7dc26cc69a4d0b12f05942bd75645adb52c96ac8b7da000c7ed77443e7c6e5d2","3aeb930d46f404c694bb4572134c71b968b82e531eff8c817028752efac33e05","14b16d2085ec2a9f845a6a9b5003fb56c7d755b8aa90c123decbd980736b9288","64e44e798c78ff612eda607c2151ff86ec4260be8115241b4488b1da0304dac0","28b822bb5c3164d3b2ba6a3a420bbdb19e0a034060cddefb2ae827e87b1de699","a14fcb5c566dcc38bb19dca8a22e15c3bf59f7e3dc2f544b3f4e09da8db2a0ad","f5b8fcb1fcf79058d109cf03c4b05a189f772e99ac7fc1b4d74516c95a1c8df8","3383983c429b45cc6e5b7f7552d5dab2c05895e2266429144c0a7713db97a7e9","5a96bba4b41c83aee43382bead2962733cad6c05e5c7fada5d277aa2a42b19b7","19126b810f1d3f32a1c660b0a8b8f9281f80a6a54efae5df8755ca6076dfde83","ce60193d1bd68fd852bec4edc5514a2d59e6eca54e952b3099aabe6ec71d2682","14c339e17ed2e9ab28bec30953a7bdbae96e27fd9251ff3724d0e88f2bc23e0a","57db8991b6a72605a8bce966274a79179419746ba6c2af342e3c40b653195115","b2f8d56be63a49e7570c9d05f3519d24cbef5fd9a23c602f5b6ea638b8635c77","75b6c26219a3a9a5b62d0af4f4e00ed8405ba2902f05e4da475f4859bf99ba6d","22865498c91c5fdec5684d5368a9cbfd629b98223c6df06647c892b601084595","e49976bcc02f4c570c3fe3450560cd95f27ab9b970bfe59967af168d191b5b0e","43a2be065935a8e52410a1a41cbab3e345d45d5fc9cf0039240f19695967e02c","d62b6f89059fd22b5739716ca0132cb92c765ff91ce7c2995001dcb370a3d1cc"],"paragraph_range_zero_based":[22104,22127],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p22104"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"PDCCH-Config field descriptions","paragraph_zero_based":22128},{"literal_text_all_w_t_and_m_t":"controlResourceSetToAddModList, controlResourceSetToAddModListSizeExt","paragraph_zero_based":22129},{"literal_text_all_w_t_and_m_t":"List of UE specifically configured Control Resource Sets (CORESETs) to be used by the UE. The network restrictions on configuration of CORESETs per DL BWP are specified in TS 38.213 [13], clause 10.1 and TS 38.306 [26]. The UE shall consider entries in controlResourceSetToAddModList and in controlResourceSetToAddModListSizeExt as a single list, i.e. an entry created using controlResourceSetToAddModList can be modified using controlResourceSetToAddModListSizeExt (or deleted using controlResourceSetToReleaseListSizeExt) and vice-versa. In case network reconfigures control resource set with the same ControlResourceSetId as used for commonControlResourceSet or commonControlResourceSetExt configured via PDCCH-ConfigCommon or via SIB20, the configuration from PDCCH-Config always takes precedence and should not be updated by the UE based on servingCellConfigCommon or based on SIB20.","paragraph_zero_based":22130},{"literal_text_all_w_t_and_m_t":"controlResourceSetToReleaseList, controlResourceSetToReleaseListSizeExt","paragraph_zero_based":22131},{"literal_text_all_w_t_and_m_t":"List of UE specifically configured Control Resource Sets (CORESETs) to be released by the UE. This field only applies to CORESETs configured by controlResourceSetToAddModList or controlResourceSetToAddModListSizeExt and does not release the field commonControlResourceSet configured by PDCCH-ConfigCommon and commonControlResourceSetExt configured by SIB20.","paragraph_zero_based":22132},{"literal_text_all_w_t_and_m_t":"downlinkPreemption","paragraph_zero_based":22133},{"literal_text_all_w_t_and_m_t":"Configuration of downlink preemption indications to be monitored in this cell (see TS 38.213 [13], clause 11.2).","paragraph_zero_based":22134},{"literal_text_all_w_t_and_m_t":"monitoringCapabilityConfig","paragraph_zero_based":22135},{"literal_text_all_w_t_and_m_t":"Configures either Rel-15 PDCCH monitoring capability, Rel-16 PDCCH monitoring capability or Rel-17 PDCCH monitoring capability for PDCCH monitoring on a serving cell (see TS 38.213 [13], clause 10.1). Value r15monitoringcapability enables the Rel-15 monitoring capability, and value r16monitoringcapability enables the Rel-16 PDCCH monitoring capability. r17monitoringcapability enables the Rel-17 PDCCH multi-slot monitoring capability. For 480 and 960 kHz SCS, only value r17monitoringcapability is applicable.","paragraph_zero_based":22136},{"literal_text_all_w_t_and_m_t":"pdcch-SkippingDurationList","paragraph_zero_based":22137},{"literal_text_all_w_t_and_m_t":"Provides one or more values to derive the skipping duration in unit of slots, as specified in TS 38.213 [13], clause 10.4. The DCI which schedules data indicates which of the values is to be applied (see TS 38.213 [13], clause 10.4). For the 15kHz SCS, for each entry, only the first 26 values are valid and correspond to {1, 2, 3, …, 20, 30, 40, 50, 60, 80, 100}. For the 30kHz SCS, for each entry, only the first 46 values are valid and correspond to {1, 2, 3, …, 40, 60, 80, 100, 120, 160, 200}. For the 60kHz SCS, for each entry, only the first 86 values are valid and correspond to {1, 2, 3, …, 80, 120, 160, 200, 240, 320, 400}. For the 120kHz SCS, for each entry, the 166 values correspond to {1, 2, 3, …, 160, 240, 320, 400, 480, 640, 800}. For the 480kHz SCS, for each entry, the 166 values correspond to {4, 8, 12, …, 640, 960, 1280, 1600, 1920, 2560, 3200}. For the 960kHz SCS, for each entry, the 166 values correspond to {8, 16, 24, …, 1280, 1920, 2560, 3200, 3840, 5120, 6400}.","paragraph_zero_based":22138},{"literal_text_all_w_t_and_m_t":"searchSpacesToAddModList, searchSpacesToAddModListExt","paragraph_zero_based":22139},{"literal_text_all_w_t_and_m_t":"List of UE specifically configured Search Spaces or MBS multicast Search Spaces. The network configures at most 10 Search Spaces per BWP per cell (including UE-specific and common Search Spaces). If the network includes searchSpacesToAddModListExt, it includes the same number of entries, and listed in the same order, as in searchSpacesToAddModList in each of them.","paragraph_zero_based":22140},{"literal_text_all_w_t_and_m_t":"searchSpaceSwitchConfig","paragraph_zero_based":22141},{"literal_text_all_w_t_and_m_t":"Configuration to control the UE behavior to switch from search space group X back to search space group 0, as specified in clause 10 of TS 38.213 [13]. The network only configures either searchSpaceSwitchConfig-r16 or searchSpaceSwitchConfig-r17 for a UE.","paragraph_zero_based":22142},{"literal_text_all_w_t_and_m_t":"tpc-PUCCH","paragraph_zero_based":22143},{"literal_text_all_w_t_and_m_t":"Enable and configure reception of group TPC commands for PUCCH.","paragraph_zero_based":22144},{"literal_text_all_w_t_and_m_t":"tpc-PUSCH","paragraph_zero_based":22145},{"literal_text_all_w_t_and_m_t":"Enable and configure reception of group TPC commands for PUSCH.","paragraph_zero_based":22146},{"literal_text_all_w_t_and_m_t":"tpc-SRS","paragraph_zero_based":22147},{"literal_text_all_w_t_and_m_t":"Enable and configure reception of group TPC commands for SRS.","paragraph_zero_based":22148},{"literal_text_all_w_t_and_m_t":"uplinkCancellation","paragraph_zero_based":22149},{"literal_text_all_w_t_and_m_t":"Configuration of uplink cancellation indications to be monitored in this cell (see TS 38.213 [13], clause 11.2A).","paragraph_zero_based":22150},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22151}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["450ee95b23b4c5c502f35e76812cbe40d18554fc88b63f188925c7f1aac5e17d","6d180eee60c22760a25462b11f031fd4677c347f6a557e7211aee79e77888b46","555b6f3ff94ff26c96bff4c2ddc4e06b03f97b406f338a3656a3a365fa52aa36","23b81dbc70cbb169f79c0b95b91fe9a5603d65f245c192e509f6a850e3fbab78","9e0bf6952fd4fa92653dac70f35e0954da2524477355f48fa29bc7240f0516e9","aefa32d32f07f4bd3d36103149ad2fd76291422fbbb4424a93a75903bf78c9c5","d4e434c32b0897c6bb32dfd0c08e22ef0607de401e69db284f2f727b36cf46c4","b75c76f7da4edb45924cec265e8cfe9832b751b7c20f081eb600220bda481a99","1a22aa357928f65b5dac416333a34032a50a1c8d1fd6aacf89da025c6c37bb52","e356943968ac84f531f77af67198177091752f4146b8f447e45e042861c727bb","8d464e7fbbfa0087efa54dd9c5135c260567b4d4b8693537dd9380365b5d6fcb","ec1f3dd811d76a1895891f9e3c52d4952cbe751d2d3485943e0c2296cf62b5a7","2b95a41684c3a58e1b7b871cc30e87bda799db46223bbe49cc06d96bb74b5358","33cca3c96c43a72fbe83b093228700d775b6d36b14a2a55e5f62b8c2eb80cb96","fa57dca3ccfebe44989c29fb46139ded3377b0fc328566e8e05f813ef57fa482","250f2e4f10fd2ccb5d4d1dd742f03390e0a932ef7409e14ee1b4d30c941ef9ae","7cf3a6ee6049d5c1ba3e5b3ccd9351101f14e059576ae59afd96c9a8c7789e1d","0b6fc8cd3bb56800ed8d7fb856ed69657e8723e0983632e5350bb4af522863f9","6c01fea2eb6382123fa3a93a5dac25f092b3a365a79ea9a67ed2d09c4d5bc34a","3d7bfc374cdccc4487fe65d404a8819f8407d61f7fde5505bd7d422305594724","4310db30e9a37840435a039027bb2edebf3885450c4c15661510e5e49f43f07f","0a4180f6b1271938b8b1b3b35643ab4ea70b51de39704cbdda7ff5c31186d82e","72252ec348f8e266069e2a01d5104162f7cecb332f72c2d462ab000b09b67cab","c05747f42c5307dd31efc27df9a561aa39e22329c9f8a5b2cf9f5e002062c4f5"],"paragraph_range_zero_based":[22128,22151],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p22128"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SearchSpaceSwitchConfig field descriptions","paragraph_zero_based":22152},{"literal_text_all_w_t_and_m_t":"cellGroupsForSwitchList","paragraph_zero_based":22153},{"literal_text_all_w_t_and_m_t":"The list of serving cells which are bundled for the search space group switching purpose (see TS 38.213 [13], clause 10.4). A serving cell can belong to only one CellGroupForSwitch. The network configures the same list for all BWPs of serving cells in the same CellGroupForSwitch.","paragraph_zero_based":22154},{"literal_text_all_w_t_and_m_t":"searchSpaceSwitchDelay","paragraph_zero_based":22155},{"literal_text_all_w_t_and_m_t":"Indicates the value to be applied by a UE for Search Space Set Group switching; corresponds to the P value in TS 38.213 [13], clause 10.4. The network configures the same value for all BWPs of serving cells in the same CellGroupForSwitch. For 120/480/960 kHz SCS, only values 40,41, ... 52 are valid and the actual value = field value  * SCS/120 kHz i.e. field value 40 corresponds to 40 with 120 kHz SCS, 160 with 480 kHz SCS and 320 with 960 kHz SCS, and so on.","paragraph_zero_based":22156},{"literal_text_all_w_t_and_m_t":"searchSpaceSwitchTimer","paragraph_zero_based":22157},{"literal_text_all_w_t_and_m_t":"Timer (in unit of slots) to control the UE behavior to switch from search space group X back to search space group 0, as specified in clause 10 of TS 38.213 [13]. For the 15kHz SCS, only the first 26 values are valid and correspond to {1, 2, 3, …, 20, 30, 40, 50, 60, 80, 100}. For the 30kHz SCS, only the first 46 values are valid and correspond to {1, 2, 3, …, 40, 60, 80, 100, 120, 160, 200}. For the 60kHz SCS, only the first 86 values are valid and correspond to {1, 2, 3, …, 80, 120, 160, 200, 240, 320, 400}. For the 120kHz SCS, the 166 values correspond to {1, 2, 3, …, 160, 240, 320, 400, 480, 640, 800}. For the 480kHz SCS, the 166 values correspond to {4, 8, 12, …, 640, 960, 1280, 1600, 1920, 2560, 3200}. For the 960kHz SCS, the 166 values correspond to {8, 16, 24, …, 1280, 1920, 2560, 3200, 3840, 5120, 6400}.","paragraph_zero_based":22158},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22159},{"literal_text_all_w_t_and_m_t":"–PDCCH-ConfigCommon","paragraph_zero_based":22160},{"literal_text_all_w_t_and_m_t":"The IE PDCCH-ConfigCommon is used to configure cell specific PDCCH parameters provided in SIB as well as in dedicated signalling.","paragraph_zero_based":22161},{"literal_text_all_w_t_and_m_t":"PDCCH-ConfigCommon information element","paragraph_zero_based":22162},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":22163},{"literal_text_all_w_t_and_m_t":"-- TAG-PDCCH-CONFIGCOMMON-START","paragraph_zero_based":22164},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22165},{"literal_text_all_w_t_and_m_t":"PDCCH-ConfigCommon ::=              SEQUENCE {","paragraph_zero_based":22166},{"literal_text_all_w_t_and_m_t":"    controlResourceSetZero              ControlResourceSetZero                                  OPTIONAL,   -- Cond InitialBWP-Only","paragraph_zero_based":22167},{"literal_text_all_w_t_and_m_t":"    commonControlResourceSet            ControlResourceSet                                      OPTIONAL,   -- Need R","paragraph_zero_based":22168},{"literal_text_all_w_t_and_m_t":"    searchSpaceZero                     SearchSpaceZero                                         OPTIONAL,   -- Cond InitialBWP-Only","paragraph_zero_based":22169},{"literal_text_all_w_t_and_m_t":"    commonSearchSpaceList               SEQUENCE (SIZE(1..4)) OF SearchSpace                    OPTIONAL,   -- Need R","paragraph_zero_based":22170},{"literal_text_all_w_t_and_m_t":"    searchSpaceSIB1                     SearchSpaceId                                           OPTIONAL,   -- Need S","paragraph_zero_based":22171},{"literal_text_all_w_t_and_m_t":"    searchSpaceOtherSystemInformation   SearchSpaceId                                           OPTIONAL,   -- Need S","paragraph_zero_based":22172},{"literal_text_all_w_t_and_m_t":"    pagingSearchSpace                   SearchSpaceId                                           OPTIONAL,   -- Need S","paragraph_zero_based":22173},{"literal_text_all_w_t_and_m_t":"    ra-SearchSpace                      SearchSpaceId                                           OPTIONAL,   -- Need S","paragraph_zero_based":22174},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":22175}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["57102bb60302835486fbd6132b83cc3c62fc207b2f18348ce291152787146695","19ec29bf33d9d2dd54eae3874881b34aad15e516cd279c616b85ebac19bd7788","5fb686c7acba72bdaeacccf5bdd6f4228ed30999ba7d2a5a73fc516507af7260","a0d96d2c5260fa527cd79762ee18b8949a793f8e9a083f56b47dbaa9fc4fe060","2b11b6eb839fd4372b41f414ae8b850b4df7ab0ba65bafca3b5a7d37245411ac","6f371c52590ed116892f2dde08ba7629dc05cae1f6b523680a8e2a1c05b18ffb","0dec91dcd0db860fa41f79835cff038af8065957c5fd650ae622f3921f308748","1972ef3c44215c63517203d9001684f333fd40369319c4da3d24de6a731bd4e4","dd632526d78b4cafa701d31529082483d51dacc698258c9a3cbb7ba38fe89762","4e665b43f7afc08dc571c92299fbf18a6f30acae83dbd95ba181430825a29a82","0be78f5a36d7b9a026666cce2ade075f71fec30944b080730a93276bb3b36563","41de4de8b08f8d95eff522db7786dc54e9845c361440262254bedfa3916fa066","c11b16171d7bf41be4eaa4ce943c7f82c71fbee5a659fdaacae72b72dc44fed7","9a5f3530e7b2b8b2a15d7f59dd542bdc83494d383a4635640ed76a83c4ad8892","8a733fa890bca45165b0f52f622e5fa9a4b8a67c8e6e96cb0f10a4533d6678b4