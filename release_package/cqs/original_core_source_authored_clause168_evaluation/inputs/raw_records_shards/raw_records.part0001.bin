70860f835d9038c47a1505397a4d028ca137ae0fa283b50bee18b2e83b295","original_member_sha256":"59b1d22b48df6067ac54d71b650dbe3cbd5d4468742f5ada8121a61670aac922","paragraph_ElementTree_utf8_XML_sha256":["be8b07206f6207320ae4e39e5d07ac18ed45149de25881487fc4c594e8a6ec66","571549a0346dc3a10320700938e9332a1da6214eaf1122bc0810f5ef61721e40","b28a96e14082419e0acfdd6feca42ec8c7fff166f7bc19d37ad6760c565d1063","9e6e7c92e9e8e3fb9a85956f5685d07367c6760f50f2b61e1d03452b3fe73afc","28f126f29a556431d6f5e12d6071ef5f0e4862e85a2d2c0360d460111f3c92b2","86d2113863c56ec21813623aab519b8d331d7c4e0d63c9dbae6a1db0bed89591","4b112f78c0a77e17e2a0ae4a7f9cbd1923af240517f4830ef6abee3435c8c380","2ddcd2fdf60266f2359b03b91fc66a35b59d32c88dabd5136c4460beb1d1ee02","796107fc4b3b562d57db5e3ab9ed339afd635571f694fc29bc5e33ffac9802e6","e3e5641279ba6c0cf2099f4af12aac460fff38095e4536b75814ef68b3f99af2","56f7dd4cccf92933fe1948fb41bf6c74ab20faefdf0fb8669cb22608171dceec","011cddde97686555b5af04233ce69020c5ea38ca79588deca4a92786ce6a87bf","e7fa9015d8dbb36482a8f9a901842945bebfe356d0867f39750cb137dd5a143a","93b39050c53d38843439a9081eca88dd0b88e9337ef610c746ede1500512f75d","489e82c2130109c70821c506c2b0b1f9a5baf8acc3ab836899702ba2ba04cc7d","04a00fd3f5dbb684dea67d34ab71d49c1fd0aec71665e6ea0bed4b858e8fd704","d952d6a452525b9b3780fd921b133dba9ae42b2a61093ea0772fdd4054f90e29","46d335024f3d589430cc7e586ca20b69b7b8bedd3815d15b633e67fde27ebe2e","9f3263367e2583af35336e617f1bbccf60fab85dfc2f566b8b366d56ddfa7ea2","7eb7d227178e72b722ae29f0d4850982ea3de43b1083625367546775caaa71a0","6f5b108998d9900c6c421ea13b44bd9a8c5ac21bb429b3e67c892e52153a6624","cd01dcd4c877f2a0d17d8a557814b9540a9f3e5ff216f46346913567eb2263f8","9c4347937bf1cfb55686e00b86627d5ca9ecda8b4dca0f34ebb6b6950e957010","3b07479baef3376c97d31a988d242ae30355d5bd32a9f7bd5a242b1d029b91ab"],"paragraph_range_zero_based":[120,143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313675.zip::R2-2313675 38.321 CR for UAV.docx:p120"}
{"fields":{"filename":"R2-2313675.zip::R2-2313675 38.321 CR for UAV.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"[25]3GPP TS 38.306: \"NR; User Equipment (UE) radio access capabilities\".","paragraph_zero_based":144},{"literal_text_all_w_t_and_m_t":"[26]3GPP TS 23.304: \"Proximity based Services (ProSe) in the 5G System (5GS)\".","paragraph_zero_based":145},{"literal_text_all_w_t_and_m_t":"[27]3GPP TS 38.473: \"NG-RAN; F1 Application Protocol (F1AP)\".","paragraph_zero_based":146},{"literal_text_all_w_t_and_m_t":"[28]3GPP TS 24.587: \" Technical Specification Group Core Network and Terminals; Vehicle-to-Everything (V2X) services in 5G System (5GS)\".","paragraph_zero_based":147},{"literal_text_all_w_t_and_m_t":"[29]3GPP TS 24.554: \"Technical Specification Group Core Network and Terminals; Proximity-services (ProSe) in 5G System (5GS) protocol\".","paragraph_zero_based":148},{"literal_text_all_w_t_and_m_t":"[XX]3GPP TS 23.256: \"Support of Uncrewed Aerial Systems (UAS) connectivity, identification and tracking; Stage 2\".","paragraph_zero_based":149},{"literal_text_all_w_t_and_m_t":"NEXT CHANGE","paragraph_zero_based":150},{"literal_text_all_w_t_and_m_t":"3Definitions, symbols and abbreviations","paragraph_zero_based":151},{"literal_text_all_w_t_and_m_t":"3.1Definitions","paragraph_zero_based":152},{"literal_text_all_w_t_and_m_t":"For the purposes of the present document, the terms and definitions given in TR 21.905 [1] and the following apply. A term defined in the present document takes precedence over the definition of the same term, if any, in TR 21.905 [1].","paragraph_zero_based":153},{"literal_text_all_w_t_and_m_t":"A2X communication: A communication to support A2X services leveraging PC5 reference points, as defined in TS 23.256 [XX]. A2X services are realized by various types of A2X applications, e.g., BRID or DAA.","paragraph_zero_based":154},{"literal_text_all_w_t_and_m_t":"Dormant BWP: The dormant BWP is one of downlink BWPs configured by the network via dedicated RRC signaling. In the dormant BWP, the UE stop monitoring PDCCH on/for the SCell, but continues performing CSI measurements, Automatic Gain Control (AGC) and beam management, if configured.","paragraph_zero_based":155},{"literal_text_all_w_t_and_m_t":"DRX group: A group of Serving Cells that is configured by RRC and that have the same DRX Active Time.","paragraph_zero_based":156},{"literal_text_all_w_t_and_m_t":"HARQ information: HARQ information for DL-SCH, for UL-SCH, or for SL-SCH transmissions consists of New Data Indicator (NDI), Transport Block Size (TBS), Redundancy Version (RV), and HARQ process ID.","paragraph_zero_based":157},{"literal_text_all_w_t_and_m_t":"IAB-donor: gNB that provides network access to UEs via a network of backhaul and access links.","paragraph_zero_based":158},{"literal_text_all_w_t_and_m_t":"IAB-node: RAN node that supports NR access links to UEs and NR backhaul links to parent nodes and child nodes.","paragraph_zero_based":159},{"literal_text_all_w_t_and_m_t":"Listen Before Talk: A procedure according to which transmissions are not performed if the channel is identified as being occupied, see TS 37.213 [18].","paragraph_zero_based":160},{"literal_text_all_w_t_and_m_t":"Msg3: Message transmitted on UL-SCH containing a C-RNTI MAC CE or CCCH SDU, submitted from upper layer and associated with the UE Contention Resolution Identity, as part of a Random Access procedure.","paragraph_zero_based":161},{"literal_text_all_w_t_and_m_t":"Non-terrestrial network: An NG-RAN consisting of gNBs, which provide non-terrestrial NR access to UEs by means of an NTN payload embarked on an airborne or space-borne NTN vehicle and an NTN Gateway.","paragraph_zero_based":162},{"literal_text_all_w_t_and_m_t":"NR backhaul link: NR link used for backhauling between an IAB-node and an IAB-donor, and between IAB-nodes in case of a multi-hop backhauling.","paragraph_zero_based":163},{"literal_text_all_w_t_and_m_t":"NR sidelink communication: AS functionality enabling at least V2X Communication as defined in TS 23.287 [19] and ProSe communication (including ProSe non-Relay and UE-to-Network Relay communication) as defined in TS 23.304 [26], between two or more nearby UEs, using NR technology but not traversing any network node.","paragraph_zero_based":164},{"literal_text_all_w_t_and_m_t":"NR sidelink discovery: AS functionality enabling ProSe non-Relay discovery and ProSe UE-to-Network Relay discovery for Proximity based Services as defined in TS 23.304 [26], between two or more nearby UEs, using NR technology but not traversing any network node.","paragraph_zero_based":165},{"literal_text_all_w_t_and_m_t":"NR sidelink transmission: Any NR Sidelink-based transmission, including transmission for NR sidelink discovery, transmission for NR sidelink communication, and transmission for A2X communication.","paragraph_zero_based":166},{"literal_text_all_w_t_and_m_t":"PDCCH occasion: A time duration (i.e. one or a consecutive number of symbols) during which the MAC entity is configured to monitor the PDCCH.","paragraph_zero_based":167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"fba70860f835d9038c47a1505397a4d028ca137ae0fa283b50bee18b2e83b295","original_member_sha256":"59b1d22b48df6067ac54d71b650dbe3cbd5d4468742f5ada8121a61670aac922","paragraph_ElementTree_utf8_XML_sha256":["373cd541f9f420838dacf5d0eb15fbd421b69458381170e1d6b37907a37a67cc","0e900d90575836050c42a67e0da4ed09329320056d9466c6fc1f2fd60ff4e0a9","aedf94239f2e3791a37e1d915084baee9ebefead9cc0dae5db72ea703045d81b","0e36e15a8c9f1115bcfc8aae3be13aec063b09deda4277550da1563c388ea3d5","0283409698e1812c01d04cf0f325cf5422d22b360e4da42d66a5464c7726ca53","1936fb87ab46d89e04c03ebf4ff3c431958cd9ec115cac1f1f4525079a626129","470bfd8a69c44999db3ea9261ad3118d6ad457e307d8efe4a6c97613fdf07b29","64c9233a0170385240608f5569fab1dffa0a2ee6a8525ee1cb232ea45e21d179","f00db04d174cd5f5d3d3841e1b969bdbb168c644f47e1e55a2c68da951d96927","ec405faab43cc6df45f956c24772ceb4b89d972939d57045d45d5e53426ccd5c","90536f4af3493180d98921769281a31120af2e8999cf1925c961f4363f95c983","f39889e8b8764fa1350d814a3ebc4730c7fb141a95423bdf8edd3f54b82fe020","b91834fc7d82bd731e60ea196a3431107eac3c944846354aa9b7362a123f2e12","9a80f582b2e43a09efff5ec03e43c9f67c10644e7eada50eaedcd37dfac28a98","eed64ad6655bcfba534e4fe0e9834fffada887868bc8b637e33453e58219a3d9","323457ae4e69e1383ff2f17a3ce487cae25d1d9455f223a0dbf1cb500008301a","b0f45d2355cf872dd420663df4e9ca105c30d94fd2bcb50b966983349a9d7b48","22a7a413b675f427bd17db92cb9ee151343da11541c02fb30e12a38daa46cc97","623ab2220a2e0a8af2bd486d279498feaac7102cc9cb2ff8a6f2ad1d92ac7ec5","a3d921a105ed64f6c1ca15f1e8a50d937ed4779e435bc8d862c75b39fcc7df9f","769cb0bfd0cb626d4d32b857995bc60eb3f32c6bdc5bb83fc4baf96e083f0350","63d789de8a97374b6297141ab69d139316753d3e24b3a2cec2472331e5bd2445","117feb077c05b74eef80ef7d74b911e0a8506513db8f17ab3b6efd9f055336e0","21437a372d84f2adb4d888240639e12eb0e1fc3f0360d89af2626d4d11a640d2"],"paragraph_range_zero_based":[144,167],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313675.zip::R2-2313675 38.321 CR for UAV.docx:p144"}
{"fields":{"filename":"R2-2313675.zip::R2-2313675 38.321 CR for UAV.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"PRS Processing Window: A time window during which UE may perform PRS measurement inside the active DL BWP with the same numerology as the active DL BWP without measurement gap.","paragraph_zero_based":168},{"literal_text_all_w_t_and_m_t":"RedCap UE: A UE with reduced capabilities as specified in clause 4.2.21.1 in TS 38.306 [25].","paragraph_zero_based":169},{"literal_text_all_w_t_and_m_t":"Serving Cell: A PCell, a PSCell, or an SCell in TS 38.331 [5].","paragraph_zero_based":170},{"literal_text_all_w_t_and_m_t":"Sidelink transmission information: Sidelink transmission information included in an SCI for an SL-SCH transmission as specified in clause 8.3 and 8.4 of TS 38.212 [9] consists of Sidelink HARQ information including NDI, RV, Sidelink process ID, HARQ feedback enabled/disabled indicator, Sidelink identification information including cast type indicator, Source Layer-1 ID and Destination Layer-1 ID, and Sidelink other information including CSI request, a priority, a communication range requirement and Zone ID.","paragraph_zero_based":171},{"literal_text_all_w_t_and_m_t":"Special Cell: For Dual Connectivity operation the term Special Cell refers to the PCell of the MCG or the PSCell of the SCG depending on if the MAC entity is associated to the MCG or the SCG, respectively. Otherwise the term Special Cell refers to the PCell. A Special Cell supports PUCCH transmission and contention-based Random Access, and is always activated.","paragraph_zero_based":172},{"literal_text_all_w_t_and_m_t":"Timing Advance Group: A group of Serving Cells that is configured by RRC and that, for the cells with a UL configured, using the same timing reference cell and the same Timing Advance value. A Timing Advance Group containing the SpCell of a MAC entity is referred to as Primary Timing Advance Group (PTAG), whereas the term Secondary Timing Advance Group (STAG) refers to other TAGs.","paragraph_zero_based":173},{"literal_text_all_w_t_and_m_t":"UE-gNB RTT: For non-terrestrial networks, the sum of the UE's Timing Advance value (see TS 38.211 [8] clause 4.3.1) and kmac.","paragraph_zero_based":174},{"literal_text_all_w_t_and_m_t":"V2X sidelink communication: AS functionality enabling V2X Communication as defined in TS 23.285 [20], between nearby UEs, using E-UTRA technology but not traversing any network node.","paragraph_zero_based":175},{"literal_text_all_w_t_and_m_t":"NOTE 1:A timer is running once it is started, until it is stopped or until it expires; otherwise it is not running. A timer can be started if it is not running or restarted if it is running. A Timer is always started or restarted from its initial value. The duration of a timer is not updated until it is stopped or expires (e.g. due to BWP switching). When the MAC entity applies zero value for a timer, the timer shall be started and immediately expire unless explicitly stated otherwise.","paragraph_zero_based":176},{"literal_text_all_w_t_and_m_t":"NOTE 2:In this version of the specification, the SRS in the procedural description includes Positioning SRS except for the Positioning SRS for transmission in RRC_INACTIVE as in clause 5.26. Positioning SRS except for the Positioning SRS for transmission in RRC_INACTIVE is treated the same as SRS by the UE unless explicitly stated otherwise.","paragraph_zero_based":177},{"literal_text_all_w_t_and_m_t":"3.2Abbreviations","paragraph_zero_based":178},{"literal_text_all_w_t_and_m_t":"For the purposes of the present document, the abbreviations given in TR 21.905 [1] and the following apply. An abbreviation defined in the present document takes precedence over the definition of the same abbreviation, if any, in TR 21.905 [1].","paragraph_zero_based":179},{"literal_text_all_w_t_and_m_t":"APAperiodic","paragraph_zero_based":180},{"literal_text_all_w_t_and_m_t":"A2XAircraft-to-Everything","paragraph_zero_based":181},{"literal_text_all_w_t_and_m_t":"BFRBeam Failure Recovery","paragraph_zero_based":182},{"literal_text_all_w_t_and_m_t":"BRIDBroadcast Remote Identification","paragraph_zero_based":183},{"literal_text_all_w_t_and_m_t":"BSRBuffer Status Report","paragraph_zero_based":184},{"literal_text_all_w_t_and_m_t":"BWPBandwidth Part","paragraph_zero_based":185},{"literal_text_all_w_t_and_m_t":"CEControl Element","paragraph_zero_based":186},{"literal_text_all_w_t_and_m_t":"CGCell Group","paragraph_zero_based":187},{"literal_text_all_w_t_and_m_t":"CG-SDTConfigured Grant-based SDT","paragraph_zero_based":188},{"literal_text_all_w_t_and_m_t":"CI-RNTICancellation Indication RNTI","paragraph_zero_based":189},{"literal_text_all_w_t_and_m_t":"CSIChannel State Information","paragraph_zero_based":190},{"literal_text_all_w_t_and_m_t":"CSI-IMCSI Interference Measurement","paragraph_zero_based":191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"fba70860f835d9038c47a1505397a4d028ca137ae0fa283b50bee18b2e83b295","original_member_sha256":"59b1d22b48df6067ac54d71b650dbe3cbd5d4468742f5ada8121a61670aac922","paragraph_ElementTree_utf8_XML_sha256":["9dc64b13a75295b0d6b26cedabd64e666dee169cdfedb730db0b61a52dd8028a","d475b3203cc187d07605fcd2dd07e0c4c3dc928d5ea6715362eee3dcd45dc222","ab3d47d309ace11dbf4fa4af8f02cc58c7933236c8767a6533bf08cb50a490e1","f248278ce43b1aa73908626a2a16030f8c4549cb4dd36a11fae18c2d50789a01","921e4706609560e1586514ee67782c4fd5fabc52de17fb602de19556db8fdc58","7b19ed9bd9026ee1f6bae895ec0ae7d6d47bf42cbd1cbba8d324015bc5ea5a37","a05d773c99a9959558b46ece2ab1637adbbe24171ee32492b9027191836bbf0e","2228320a27a02473bf859311d621c25c61d17f0b889d040006d6d26d227edcb7","1d35cd8b6916906c9ca18d1ef6dc1f606f6051918d30e5c1d27e70dc30557b31","56795e2c7f50a87565439815557be9163c56ff06647f72e9200f7626ab97b9ee","47d81f3d11ab0c4678a