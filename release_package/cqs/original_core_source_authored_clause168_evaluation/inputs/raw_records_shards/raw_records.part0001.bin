90},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25291},{"literal_text_all_w_t_and_m_t":"–RadioBearerConfig","paragraph_zero_based":25292},{"literal_text_all_w_t_and_m_t":"The IE RadioBearerConfig is used to add, modify and release signalling, multicast MRBs and/or data radio bearers. Specifically, this IE carries the parameters for PDCP and, if applicable, SDAP entities for the radio bearers.","paragraph_zero_based":25293},{"literal_text_all_w_t_and_m_t":"RadioBearerConfig information element","paragraph_zero_based":25294},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25295}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["e7263438c1635bdde339e67126ae5ca59366a2b53998f73af09467d75094ff2f","11abd47c5ae29c0ec7dd94c4956f9bd5a645ee7c3ac17c41b16a166e54051db8","44ac1a5b7eccb7b097559a169c31a8c2c5804e99f8c3b4de3cdeeffd43376db5","8f92745714565646f673b31fd6c626338453a52224712e422df1320b81bc0595","dbc27a73863fb1efaf21431cffa8c02d322c0c33882731d18d633d7d16351212","5710f2c91bde0fcd53eebe9861966444736bb6daa6033eef616f308a77379271","99f58ca53617bb7fdc2f3c043fdb44299403013ea8e6ab0102d44bbd2f032c89","6695764bbf0117e4d80011055516f0e9777dbe49d53d97f98e0182816fec5e43","a412aba40b40090ad2b7821a71e159aa1fbf5bcac463835995e1ea079e021080","fdf571d1e7881daadf8f340a18b6dd103df4856de6d57766294678629bd961ad","12de4efb8d11e88a7567eec7b8761cffc1ee016e39368822c0f292ec4cd3d509","d169aa32ec7e3fdc2d33b5a2deea86d4ef410e72bd37244309c809720e95f9a9","25252b28f77fba59461e4387908efef6cf7fc4d6e359d4d4dd85d737a935b122","ae575fa7761f3eac349fcfacea3b7c98297880f3483722f09687ffa68c810ce5","8a0b31b9a9a4a614c7106682cb036be418f46fef5efd6797aec21686e5be3e2e","a3443ee378082313d0691