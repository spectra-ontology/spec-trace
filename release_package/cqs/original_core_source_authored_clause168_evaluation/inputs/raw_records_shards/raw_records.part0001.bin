{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":12000},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12001},{"literal_text_all_w_t_and_m_t":"MUSIM-Assistance-r17 ::=              SEQUENCE {","paragraph_zero_based":12002},{"literal_text_all_w_t_and_m_t":"    musim-PreferredRRC-State-r17          ENUMERATED {idle, inactive, outOfConnected}     OPTIONAL,","paragraph_zero_based":12003},{"literal_text_all_w_t_and_m_t":"    musim-GapPreferenceList-r17           MUSIM-GapPreferenceList-r17                     OPTIONAL","paragraph_zero_based":12004},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":12005},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12006},{"literal_text_all_w_t_and_m_t":"MUSIM-GapPreferenceList-r17 ::= SEQUENCE (SIZE (1..4)) OF MUSIM-GapInfo-r17","paragraph_zero_based":12007},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12008},{"literal_text_all_w_t_and_m_t":"ReleasePreference-r16 ::=           SEQUENCE {","paragraph_zero_based":12009},{"literal_text_all_w_t_and_m_t":"    preferredRRC-State-r16              ENUMERATED {idle, inactive, connected, outOfConnected}","paragraph_zero_based":12010},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":12011},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12012},{"literal_text_all_w_t_and_m_t":"ReducedMaxBW-FRx-r16 ::=            SEQUENCE {","paragraph_zero_based":12013},{"literal_text_all_w_t_and_m_t":"    reducedBW-DL-r16                    ReducedAggregatedBandwidth,","paragraph_zero_based":12014},{"literal_text_all_w_t_and_m_t":"    reducedBW-UL-r16                    ReducedAggregatedBandwidth","paragraph_zero_based":12015},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":12016},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12017},{"literal_text_all_w_t_and_m_t":"ReducedMaxCCs-r16 ::=               SEQUENCE {","paragraph_zero_based":12018},{"literal_text_all_w_t_and_m_t":"    reducedCCsDL-r16                    INTEGER (0..31),","paragraph_zero_based":12019},{"literal_text_all_w_t_and_m_t":"    reducedCCsUL-r16                    INTEGER (0..31)","paragraph_zero_based":12020},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":12021},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12022},{"literal_text_all_w_t_and_m_t":"SL-UE-AssistanceInformationNR-r16 ::= SEQUENCE (SIZE (1..maxNrofTrafficPattern-r16)) OF SL-TrafficPatternInfo-r16","paragraph_zero_based":12023}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["b6a24831b57689f437e8e4376c9ffd320598c721d6b14175d7efcd671d22a0b2","f1dee03f03d691e720c356e76bee6672e5970a48e6dfae566cc5edba3cb53f31","ded3d71aef797ce1b0ed14b41efd5289a7748aa2ec5feb7e5e4004b5bb17cabc","e440750a452b34a66a151210aaf7776f4b246a7f0b2cf145a60108c54921f2d6","5edaec39930f8f8faa468bb25d7daaf3d00e9ba87f6918b6b4fce9f0b4281c5c","57d4942ff3b9fcc4d192adc0f34813e7556caadf028d028b64ee35d5aa2f7e42","0c04e84af6a4794f40870ae7ef1b2f0c4ad805f18550e57bad7453ce5880e39e","e87e3867de93230188dc6aeed468ef5ed0682c363d5cd47ba148eea09f7ce668","2722fdb200fba53bfd2026036977e5fb0ca87051ea9821d250e91688175285c1","aa2c1bdf2d1aca58533c924b5616ecc7861d60ee479a9391b38083c350edf926","f8b4b0cecbc306ec5308fff991857e70ec25396f9384817579e71a3b388e2cbd","322d73baf53392a996174e95eb845b9cc43e8644d4e98dbd313cba4795a09c4e","bb7d94eff907510c4a4209abd16d10fa93cf72790500fc6a100e9fdca2501e11","ee1f90dbc3101acaef54e756e528dd84e0f954d97646a5ba55d83996551d2ac2","99b7a4a4b68f8faa4268f6ad3be8f10b7bf51d8cf2d8a4ae601484e459f0f0cb","9576d3