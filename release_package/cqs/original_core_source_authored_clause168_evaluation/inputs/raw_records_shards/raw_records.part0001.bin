{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        sl-ResourceType-r16           ENUMERATED {gbr, non-GBR, delayCriticalGBR, spare1}     OPTIONAL,   -- Need R","paragraph_zero_based":38352},{"literal_text_all_w_t_and_m_t":"        sl-PriorityLevel-r16          INTEGER (1..8)                                          OPTIONAL,   -- Need R","paragraph_zero_based":38353},{"literal_text_all_w_t_and_m_t":"        sl-PacketDelayBudget-r16      INTEGER (0..1023)                                       OPTIONAL,   -- Need R","paragraph_zero_based":38354},{"literal_text_all_w_t_and_m_t":"        sl-PacketErrorRate-r16        INTEGER (0..9)                                          OPTIONAL,   -- Need R","paragraph_zero_based":38355},{"literal_text_all_w_t_and_m_t":"        sl-AveragingWindow-r16        INTEGER (0..4095)                                       OPTIONAL,   -- Need R","paragraph_zero_based":38356},{"literal_text_all_w_t_and_m_t":"        sl-MaxDataBurstVolume-r16     INTEGER (0..4095)                                       OPTIONAL,   -- Need R","paragraph_zero_based":38357},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":38358},{"literal_text_all_w_t_and_m_t":"   }","paragraph_zero_based":38359},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":38360},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38361},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-QOS-PROFILE-STOP","paragraph_zero_based":38362},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":38363},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38364},{"literal_text_all_w_t_and_m_t":"SL-QoS-Profile field descriptions","paragraph_zero_based":38365},{"literal_text_all_w_t_and_m_t":"sl-GFBR","paragraph_zero_based":38366},{"literal_text_all_w_t_and_m_t":"Indicate the guaranteed bit rate for a GBR QoS flow. The unit is: Kbit/s","paragraph_zero_based":38367},{"literal_text_all_w_t_and_m_t":"sl-MFBR","paragraph_zero_based":38368},{"literal_text_all_w_t_and_m_t":"Indicate the maximum bit rate for a GBR QoS flow. The unit is: Kbit/s","paragraph_zero_based":38369},{"literal_text_all_w_t_and_m_t":"sl-PQI","paragraph_zero_based":38370},{"literal_text_all_w_t_and_m_t":"This field indicates either the PQI for standardized PQI or non-standardized QoS parameters.","paragraph_zero_based":38371},{"literal_text_all_w_t_and_m_t":"sl-Range","paragraph_zero_based":38372},{"literal_text_all_w_t_and_m_t":"This field indicates the range parameter of the Qos flow, as defined in clause 5.4.1.1.1, TS 23.287 [55]. It is present only for groupcast. The unit is meter.","paragraph_zero_based":38373},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38374},{"literal_text_all_w_t_and_m_t":"SL-PQI field descriptions","paragraph_zero_based":38375}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["a4e9d84e642b7387393bf84903cb6498d3371615c936064b6424fb8b4084a18e","4f531ba588b756c0a812b832ab5a2c19713951701216d098b29ece2678da82e1","10c4c67c6b4b9738bad9b94b7c3ef8f2019392ce6878fe92f7890ac13fcdc638","d77b3485af80f3a95b50e17deec9d5da6dbee603a066ba0bb04c43b45341b55f","769c854e6522aa54132d6573bc3dd2774763fa9c789d2ba2e60e7384294bb58f","7da229abe11c0082ac06e281eb3486bfcd2e47daa5f07a3cb6c3ccfe339315ab","d5a1b08c20cecbf52cfee23dad395cbd4c78e173959ee9efeb8fccecbe79756e","5f4feb882a31f2de21d39faee593552c4dd434fd065992f8e116a06e4aed440a","b2d6a5a667106861e0d411fb3a8ca5b1ec45aaf8c05d1e41a5f2eb056c762ae1","d92e38cca9e5146530563536e42ab972b4e21945fbf19f1344ce47d0470677fa","66490ad5a57ea451b0088e00875c8691f5135540e2f397d00867c7a806713ebe","bdeff86d39c22c3e2714292ec1583894c5475fbd1e8f6531a9d04758fc58552c","8860976c519ba88a6095fdd2e52327422fbd44e32139f79daa0100f767a253f7","367c8009abba85cfde8bd8955fa0d1bdd55cf025d697b7d315a731e7dfd5d4fb","7f6f8e56d5283bdb10b216e1cc98548b4b9c4e21b9c4cdaae59a1c90a0fa4593","a289d15b9284469821e2d584e2dc288badb9f27034073ce9c61e1aedc9d097c0","a2ba95985d6db8216ba9347563ecba2c4aee20a7a783c0d5be113d7c32b7e532","a7e1b98d0ef46dfa7eb0474d3ac6f08ddfdba99d06cf3f515811b8a4ce11ee3b","2201200c337f5996f56928705b2bcb7a211b471a0a6d173f7ebe7b2972e84824","8ae120c516173ca9500287bbe59adc4137324d469429d1c98b23059468b3f2e7","a0de5c970618b1946a84117b44ed2e360d042483905fe14a6105b117243b2d88","91c5a53822caae05ab2b26790738eab70279e38c769442a9dc5d79469383febf","f848b91180fa71011345e6111efc0f06fbc78132396c1b3caa8836f39bcffb8f","74f0046369e845038c9e7147ba1120159f5977b4f4a1fb9d961265776308d6c3"],"paragraph_range_zero_based":[38352,38375],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p38352"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-AveragingWindow","paragraph_zero_based":38376},{"literal_text_all_w_t_and_m_t":"Indicates the Averaging Window for a QoS flow, and applies to GBR QoS flows only. Unit: ms. The default value of the IE is 2000ms.","paragraph_zero_based":38377},{"literal_text_all_w_t_and_m_t":"sl-MaxDataBurstVolume","paragraph_zero_based":38378},{"literal_text_all_w_t_and_m_t":"Indicates the Maximum Data Burst Volume for a QoS flow, and applies to delay critical GBR QoS flows only. Unit: byte.","paragraph_zero_based":38379},{"literal_text_all_w_t_and_m_t":"sl-PacketDelayBudget","paragraph_zero_based":38380},{"literal_text_all_w_t_and_m_t":"Indicates the Packet Delay Budget for a QoS flow. Upper bound value for the delay that a packet may experience expressed in unit of 0.5ms.","paragraph_zero_based":38381},{"literal_text_all_w_t_and_m_t":"sl-PacketErrorRate","paragraph_zero_based":38382},{"literal_text_all_w_t_and_m_t":"Indicates the Packet Error Rate for a QoS flow. The packet error rate is expressed as Scalar x 10-k where k is the Exponent.","paragraph_zero_based":38383},{"literal_text_all_w_t_and_m_t":"sl-PriorityLevel","paragraph_zero_based":38384},{"literal_text_all_w_t_and_m_t":"Indicates the Priority Level for a QoS flow. Values ordered in decreasing order of priority, i.e. with 1 as the highest priority and 8 as the lowest priority.","paragraph_zero_based":38385},{"literal_text_all_w_t_and_m_t":"sl-StandardizedPQI","paragraph_zero_based":38386},{"literal_text_all_w_t_and_m_t":"Indicate the PQI for standardized PQI.","paragraph_zero_based":38387},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38388},{"literal_text_all_w_t_and_m_t":"–SL-QuantityConfig","paragraph_zero_based":38389},{"literal_text_all_w_t_and_m_t":"The IE SL-QuantityConfig specifies the layer 3 filtering coefficients for NR SL RSRP measurement for a destination.","paragraph_zero_based":38390},{"literal_text_all_w_t_and_m_t":"SL-QuantityConfig information element","paragraph_zero_based":38391},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":38392},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-QUANTITYCONFIG-START","paragraph_zero_based":38393},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38394},{"literal_text_all_w_t_and_m_t":"SL-QuantityConfig-r16 ::=               SEQUENCE {","paragraph_zero_based":38395},{"literal_text_all_w_t_and_m_t":"    sl-FilterCoefficientDMRS-r16            FilterCoefficient                             DEFAULT fc4,","paragraph_zero_based":38396},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":38397},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":38398},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38399}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["264c530261770b7b59bf8e106fe506e1880569e31f701bff7c23bdb21fefb4e7","2fc23055769e4c271182357c6f9acf912013756823ab9b79b4bdf96b242db07e","a8e72f29750db82679c0f1489df99e6d4392d8cdd43f2d42114762399dc7f05f","8bd9b265c1106f9fab71cdda11ab2c4d4a9d80f0c5b553d519ff563d8a39a6cb","82fa31b86c7d5b87b1279a345c7697a0adbc99f342a80c1116d70c01751fc6ac","883337f8c7910e677294f88770748a7b62033391ea3dc68b739a3fa71dbf7de6","93590ebbae03aa5df4471c3c4462b96e236ac1004268e6f1bc0df7ca2282708f","ac1f52be7879a25dc97bf6e32da8a267e61a8f8e55c3cc568478c9de4589493b","833196b5be410431faf5a2ae26d98bccf7331d9bfa4a7955ff1643f64e1c97d6","fc2678696f543c75a17b3c2321beb401f8d510b83d9594cf0991439e49681855","ec74d2f019458c7829a99ab0947c5cca7f7825740d8d15d3a43725002