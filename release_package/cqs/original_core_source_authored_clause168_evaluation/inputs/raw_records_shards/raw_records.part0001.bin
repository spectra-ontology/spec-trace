"57965282429fcec078290d91f1b2c0281aa535c7950b14c0e9a1317565b8deb8","original_member_sha256":"577a1f518de64ebe3a6c6351d0f0a98ca239abb29975716027e83b13c667d881","paragraph_ElementTree_utf8_XML_sha256":["20e285f077227d22dd3b5981c8976f9d56ea5d88ffd7f790036b30e5d2c0b4a9","4328dbc2e9ed59984edad9da9f918a037222a8bc1d4a7f801e449d0bf4e71fd0","1b57abbb250ccf0e7dbcfaad8666dd22e39df29408dc1d6e61b3298df1a31533","dca27312d7a1517d19ed558671871fab25e9b549c607883b97a78f9f3628f08a","6d3fba1314de1001e3753ed4f16b9c74cdf0271805f61b17dcc5b42bd590842f","617785343afc34ff86d7085e070e5171c849cf65b766df069d11ae4921b43535","9322f7a09be521bc1d3a1b154b90bdf8ea046a329525a5e489e01fb7900d07e3","cb9646e53a961acadd8b9d1cbe9977f71385aded0c0dd84e225defb7e8545ad8","a2f067725ab572fcc4bc1fef5b1bafc2fb55dfbfe071c00200782d1efc3b2bd5","48f27d1f338f2e6cabf1ff384625f9d1a5e67ab8190bf0af224f5e9fd5a2044d","15ecd4a38075d09c3da7ecf21afa01e15add08a022f57a31101b9568e50f37b9","731cd85286f824ffc8ab15b3e076faaf16231b040ec58d5b982eb0b04411f518","dbdb483ae70663bdb1eccb45d242089c3f44c5868a8c16e2a059a01b2decbafe","15446e336e26f8e8542354aaa67cefc1b9b0d8b4af76558f1b7e96594ab3e72b","032e9f858d3d59ab048f1c6847f25e5b233bb6ba0c88c96eee40690f328745ca","1ac810a1cab11c95a1df934fbe11d17d0c7b90f828c877e62a98a07ed58b7dfa","97f66b4e8afecb72d2dc1d9533944b31e1a14918cceacde8f9dcc481f816b51a","b3f8ba76ec829a0eac6003bc8cbccaed17d41a62756dd1214cc8a7fa8c87c76d","ebb18e058d1fac3e0efc9941e530e6c9327f91af82e47a50969e70a111afea2a","21c91c0905cd6025a211f64667d2ac0a4e2335405138b0ef81a59ae90e8df477","dcb00a9e6c6c316c0088d2dc5f1b8ad2617b4424352762cd9029642ce44b55be","adf91afec1ef44a2388772bd7103ea6e4f36004e933a3b58dc00af5209fde022","500ae1e95311986e752b9be027e0c22a78d267c2f0de2c686523828721158b14","1cef444d894cdacbe559bb45e53c3b2ef7f77da82c45f0f24d784d4541645307"],"paragraph_range_zero_based":[24,47],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2401498.zip::R2-2401498_Correction on CG-SDT initial transmission (R17).docx:p24"}
{"fields":{"filename":"R2-2401498.zip::R2-2401498_Correction on CG-SDT initial transmission (R17).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"F","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Rel-17","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-16(Release 16)Rel-17(Release 17)Rel-18(Release 18)Rel-19(Release 19)","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":"Reason for change:","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"Currently, the initial CG-SDT transmission with CCCH message is controled by cg-SDT-RetransmissionTimer.","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"For each CG, if cg-SDT-RetransmissionTimer is configured and is not running, the MAC entity considers NDI toggled and delivers CG and HARQ information to the HARQ entity, so the UE is allowed to perfrom the new transmission/retransmission of the initial CG-SDT transmission with CCCH message. ","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"However, if cg-SDT-RetransmissionTimer is NOT configured, the condition for  the initial CG-SDT transmission with CCCH message is not considered, i.e. the UE is not allowed to perform  the initial CG-SDT transmission with CCCH message. This is not a intended behaviouir.","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"Add the condition for the initial CG-SDT transmission with CCCH message if ","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"cg-SDT-RetransmissionTimer is not configured.","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"57965282429fcec078290d91f1b2c0281aa535c7950b14c0e9a1317565b8deb8","original_member_sha256":"577a1f518de64ebe3a6c6351d0f0a98ca239abb29975716027e83b13c667d881","paragraph_ElementTree_utf8_XML_sha256":["e4ea5591218aa96d0cd407936b651eb165fb4c75e229dab64ec9de6be991cb96","2d00e3b1a82065155328ddd802c3d4a8ebff11f4a0d6da9ecf9b1e34dc8ebfc8","b2195adbe70ca5cb94db0851a1c7188180333a1db8560ccfde4e852ae0ca0b70","761fa4d36b282591b5f5bb5ee554c6086f6eb9d5925f257d405f142f9e3a17e1","9ee3a8ef1b4d8b5d23ae68c79878f83d9a7ffdf02ec93cff53f7b1de6029f4d6","af6773f550ebfdeceb0d561e20d09cf95ce29110a5c49f9b22e946a08251026f","b08252b53f111fda758564f01d6aeb287a86ceee9730eba0ca5fcf7c7dadb00e","5397ebe3cc2afa3393b897343a62f60e5b485315d8236802a715ec930f5cc336","9179ba236853e4a73f15d3d408619f0f62540850e6daa878c17cdc8a8f26dbb9","34212fc6f04370a4e535ce9cc41d8546dd1f377420e476f0306c144fd63998ef","16c8d70f7d429c511b56c375317337c5d5c75b5a185ec91bf088b77069963fb7","acd6206245de4b9556a4853ff1b8b41875944834aa76df6c7d72af763f365262","3c4c80e1e11044a4d07c2d065ab1badcf74a3b84af6435503a27154aade28f9b","aec593d3e5c5c829f31916b36740488639994c0cb75a60993277d1b98846450a","c03902c784002737bf8a3da99dca4ecfe3975cfa7ace93a620b6cbe418433dd4","fbd10fdc705e8db8129d14fc181b6e1eb52f6061044dadf8c46fdafaa18e9d6e","9af9c4a5e9854e247d79b37bc1f85f317241898b133907bde981b888c7ead11b","94c3786ed799e11f0344b837bc3ce3758fef53e189d5c0751d19c3bc62e91cd8","8b24573e0133d1c5ee95e1377545628b16380b4d3d980bde5296376e8173041e","7423559940944ed0cc1fe176b76253cf9035dcdbfc0fac2f3e385feb311a2329","288cc60197c635a28716a1c3a9133085106b36b1009fb0a2849670c1b99dfd9f","ca6ca78335b75a20597401652d8d7ab0f4e04745bdc7b0f058f4c32e0f7f35aa","71996fd73a626bfa4b8447754c399473fb5f92cdb1287a5e67df7ea28006cc4b","37feec4d7f23d9f3257c04956ed1327ed737a2abe75bbbc96e94d20ed825f6de"],"paragraph_range_zero_based":[48,71],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2401498.zip::R2-2401498_Correction on CG-SDT initial transmission (R17).docx:p48"}
{"fields":{"filename":"R2-2401498.zip::R2-2401498_Correction on CG-SDT initial transmission (R17).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Impact analysis","paragraph_zero_based":72},{"literal_text_all_w_t_and_m_t":"Impacted functionality: Small Data Transmission.","paragraph_zero_based":73},{"literal_text_all_w_t_and_m_t":"Inter-operability: ","paragraph_zero_based":74},{"literal_text_all_w_t_and_m_t":"If the network is implemented according to the CR and the UE is not, no inter-operability issues.","paragraph_zero_based":75},{"literal_text_all_w_t_and_m_t":"If the UE is implemented according to the CR and the network is not, the network may not receive the initial CG-SDT transmission with CCCH message.","paragraph_zero_based":76},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":77},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":78},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":79},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":80},{"literal_text_all_w_t_and_m_t":"Even if CG-SDT is initiated, the UE cannot transmit the initial CG-SDT transmission with CCCH message if cg-SDT-RetransmissionTimer is not configured. Thus, since configuredGrantTimer and T319a timer is not started, there is no mechanism to declare the failure of SDT procedure, so SDT procedure is stuck.","paragraph_zero_based":81},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":82},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":83},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":84},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":85},{"literal_text_all_w_t_and_m_t":"5.4.1","paragraph_zero_based":86},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":87},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":88},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":89},{"literal_text_all_w_t_and_m_t":"Y","paragraph_zero_based":90},{"literal_text_all_w_t_and_m_t":"N","paragraph_zero_based":91},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":92},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":93},{"literal_text_all_w_t_and_m_t":"Other specs","paragraph_zero_based":94},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":95}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"57965282429fcec078290d91f1b2c0281aa535c7950b14c0e9a1317565b8deb8","original_member_sha256":"577a1f518de64ebe3a6c6351d0f0a98ca239abb29975716027e83b13c667d881","paragraph_ElementTree_utf8_XML_sha256":["5668e4db075e45d0c77370e434527ee6523ce2ab8ae7ed7dec35d29456f5a128","9de6616e42db145867fa2eb1dddf60109f594134814cc2aedcacf089f218a088","cef53aa47fef6ff1f40e054e4b20f3d9ebc91b80eba724c7ab8dadafcc1f1b91","6c7d5a40353d4519520d28da6bc7917f6726c3b212af4eb5e3f15cdb5ab35974","60989ba9ea19f8c93102f437edf6f8ffb5215ae99af3195433e6ac5d3092302a","77404f754528ecd121ddb5d065d838df070695de43ce2d4165fe2b3af4e5ade7","23da18bbbcbc650fad7a07ef8006251a7a06ae59113986d1a2b8d37f6d71a8d1","85f9fe225bf206da5b28016fbb39c62cb1368eb1244f4f20547ea6629294dc69","378adf0aa423995360841de5b3ff121413a3320bd55a44c2044b1a4823324310","10c51661e99bf3bb957cb49fdabb0fb67f664cedbdea4b562499ed079f886d25","caf6276610bbbdcc28ba63126f6f3a3c6b1028a259eef250ab8a421d446cd1eb","d3098623b4dfc23a1a4b383cc6c305d01a4c1c56ac54d5853c2f6542bbe0ad3e","d88bc81b05cdcb5373fcefe52e78f5e5b7ea4e37e19c0d9ebb00bb2abbe8ad2d","61cf31ccb32ca743f815831546a63f3d4f37ea5f4ff7e02e623d0e686dc91277","c5b191a51ea0019f9a94a2afe6cccd7b1b7b141f172bd9fd57f1bb13447614d0","d3262b1816fab55992cffb02c05a6ffa91b6523e243fbbc95fea56d1d4a60b90","c3683d587e9395b4366df402366a37ae834beabe3792a5a1f587771601d39ee1","ed998830d31c45491e1e0440155b1f04906345d5cf11cf124da3b8514b084b6e","906013edb57524be9364140bb342f747d25cd914a658ac9688cc0e1c36c48a