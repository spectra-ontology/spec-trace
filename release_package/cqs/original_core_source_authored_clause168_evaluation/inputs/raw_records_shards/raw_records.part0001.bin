{"fields":{"filename":"R2-2314047.zip::R2-2314047.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"B","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Rel-18","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-16(Release 16)Rel-17(Release 17)Rel-18(Release 18)Rel-19(Release 19)","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":"Reason for change:","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"Currently the redirection from 4G to 2G is prohibited if AS security has not been activated if upper layers indicate that redirection without security is not allowed, however the same redirection is allowed from 4G to 3G. This CR provides needed changes to RRC specification in order to adapt the behaviour according to the NAS redefinition of the redir-policy bit as highlighted in CR#3924 to TS 24.301 (C1-236303) as highlighted in LS from CT1 in R2-2309405 and prohibit the UE redirection from 4G to 3G if AS security has not been activated if upper layers indicate that redirection without security is not allowed. ","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"The UE behavior at reception of RRCConnectionRelease as described in 5.3.8.3 or RRCEarlyDataComplete as described in 5.3.3.4b is modified such that the UE, conditional on indication by higher layers, rejects redirection to UTRAN unless AS security is activated.","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"Impact analysis","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"Impacted functionality: Redirection to UTRAN without AS security","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"30bab297e2c1559150f28c715187cd2b042427217032b939c40fbda0b98d5d22","original_member_sha256":"cb272e610fd9cd8910cfd70983738fb68760b249a2966dd09d1d153b23cfa274","paragraph_ElementTree_utf8_XML_sha256":["e4ea5591218aa96d0cd407936b651eb165fb4c75e229dab64ec9de6be991cb96","2d00e3b1a82065155328ddd802c3d4a8ebff11f4a0d6da9ecf9b1e34dc8ebfc8","d134ce64a5e82141499bd0d45bf77353656182783196a949fcece343ae4bba72","761fa4d36b282591b5f5bb5ee554c6086f6eb9d5925f257d405f142f9e3a17e1","9ee3a8ef1b4d8b5d23ae68c79878f83d9a7ffdf02ec93cff53f7b1de6029f4d6","fff172002ab8ba4ede07b7e2ba028d5fccc22b554d51006b1629a400eb7c49a4","b08252b53f111fda758564f01d6aeb287a86ceee9730eba0ca5fcf7c7dadb00e","5397ebe3cc2afa3393b897343a62f60e5b485315d8236802a715ec930f5cc336","aeb7dbfe4f652fa68f641332bcd8175ba022780894ddf7905379f7d1842433d8","1257bef6de0d6fbcb35da4ad9e5d1d2efb40539d216438a199be822d1e60e855","16c8d70f7d429c511b56c375317337c5d5c75b5a185ec91bf088b77069963fb7","acd6206245de4b9556a4853ff1b8b41875944834aa76df6c7d72af763f365262","3c4c80e1e11044a4d07c2d065ab1badcf74a3b84af6435503a27154aade28f9b","2593249dfdda20e137fc2f32d1af88c695a59a84154779e7720b2a453428e446","c0a342146919dccb3176d64380852bc10c512bc1b04d11a8fd9904d974412841","8b24573e0133d1c5ee95e1377545628b16380b4d3d980bde5296376e8173041e","7423559940944ed0cc1fe176b76253cf9035dcdbfc0fac2f3e385feb311a2329","54e0e099475004c583843767bede64e48269c6c147ff91bdb24c3cf8a0445eb1","8b7cff9dc71455e151b725c323798ea6b27dff14ebb79db900a79ed445bee6df","0d2bcc46f7709fea421322c0555a8d13cdf3731751c671dddc5bc59da5aa99d5","ae23f230761a3b8bd5805698360f5fa8b38a7a294887bf9c71923fc146de74b1","4bec562d5d6b62d0c95e63cdda89f19e18765cf2a5a987b23a9a0845211e1e11","ec4d2dd7b5c29949f55c24b80ea89f6e304a5cb96de7ab77c4a386f865889bca","e7441a34f9e6615a6d87bcab13fdc44cfba3aba7d28dd1735245c5f6e0ceda2c"],"paragraph_range_zero_based":[48,71],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2314047.zip::R2-2314047.docx:p48"}
{"fields":{"filename":"R2-2314047.zip::R2-2314047.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Inter-operability:","paragraph_zero_based":72},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":73},{"literal_text_all_w_t_and_m_t":"If the network is implemented according to the CR and the UE is not, there are no inter-operability problems (but the UE accepts redirection to UTRAN without AS security).","paragraph_zero_based":74},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":75},{"literal_text_all_w_t_and_m_t":"If the UE is implemented according to the CR and the network is not the redirection to UTRAN without AS security is not performed. ","paragraph_zero_based":76},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":77},{"literal_text_all_w_t_and_m_t":"             Hence, if the network policy configured by NAS signalling prohibits  ","paragraph_zero_based":78},{"literal_text_all_w_t_and_m_t":"             unsecured redirection to GERAN or UTRAN, eNB shall activate AS  ","paragraph_zero_based":79},{"literal_text_all_w_t_and_m_t":"             security before redirection to GERAN or UTRAN.","paragraph_zero_based":80},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":81},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":82},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":83},{"literal_text_all_w_t_and_m_t":"Unsecured redirections to UTRAN are possible","paragraph_zero_based":84},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":85},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":86},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":87},{"literal_text_all_w_t_and_m_t":"5.3.8.3, 5.3.3.4b","paragraph_zero_based":88},{"literal_text_all_w_t_and_m_t":" ","paragraph_zero_based":89},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":90},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":91},{"literal_text_all_w_t_and_m_t":"Y","paragraph_zero_based":92},{"literal_text_all_w_t_and_m_t":"N","paragraph_zero_based":93},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":94},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":95}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"30bab297e2c1559150f28c715187cd2b042427217032b939c40fbda0b98d5d22","original_member_sha256":"cb272e610fd9cd8910cfd70983738fb68760b249a2966dd09d1d153b23cfa274","paragraph_ElementTree_utf8_XML_sha256":["6678b998d220b96b066deb1807e7b7501c0cf572810f88307c124baf4793f91a","ea7e6335d3ee3fcf1ea4ec66d15c5d1100a59b4bf05c1d0cce526ca60050bf8f","028bdba6b873bf22a73ba532a011859056c564d9632816dbea1a81a3320f83c8","4f0ef0f6938fc7a4f9434f8f37446363ed5cc144602ef429e84aa1801755214b","a342cbac68e09b70ad86b1d0dce586cfa0e8d0511fbf60e97a922b23c1a6fdb4","ebfa9bff4b6ade34b2da293ec1c48eec366c4f15da3069242555f3d6034cad8f","b10e2d4954598dd6172f67e041eee4db6e4ad97a4b9271195ea15552a8942a0d","4b3b2ebd084c099bc36b227612f231c4db99b4a42a22fa36b32be9e2c1779b0d","2abe985ba3ce38d79d5dd7c2c0093f835ca37b62f352900f683f34364a2be07f","d3e56d6e6713a2957e1b84b0744cea3bb0ee67db768ffe0afea0119b08f938e0","a5851dc4b3083a3f48882cd40d95f475d1edbba1fb0b8fb0b55a9f36f9dee36c","3e73730c9e2ba0f67937bd3ef8f68ea4bb3f8827ef437bfda7c9063bbc7adf3a","8860c5bca23ad9a364cfe13abac068a93db55a0dc93184b39a190ab5c892888b","d0fb75b33edf5153a0e1ac9e8a6abba3fc086429bf95f04012aa12ccc5050b5c","f0b6c426c4dded86d8573a25b236bc9b2273ab9063aad19163c282cf115cda80","637cb361db5949ccbaab5e19ce45785328658feac2ae787ed0b28b3321d2e00f","c43f9123dbb210134cefcbd4117c515463e0ff4420cc71e59993035609af6748","cc4a3388d87f67f5cb6572f951fcea90496c61dea0caaba0f1be0a93c518d249","3326ef8ce94fb4fd5f411c32faff38ef5b3b746a9c4091baf11a17e06a66e937","189c32e55428f8e16dc54eeb9cc3c7ecc8646250c025be592328f23acf982063","33274658f5d21d5e12430ae