aa2b91e375dc6004146f8b8383c1972b901e2cb59a46640f33","02abb547847aaa28ae96a5d1dc76543195e0d930cef1b1197a4981b694284714","575e8d5af2ecdb1ec0b3a4aa2549c2badefd66a3f09485e3973d7093001756b3","737117578a4c216572178437ef230e692b1803bbb0bedac9bc7815ad51c3cf28","1630130d863c32006c4b4b9d516a3b0778f4303e2aac9c131a80ebc37cf35247","4b9d18dbecebad04aa17763e7467b8c5d715b6fd7ad847b39aafcc2fb0a9b6a5","263297f081e838b39c7f280bf3a9a914726d36332f65cd7040df49d7b35909e1","273e1bc5566be307576db5058e07edae726bc19b961063d52ea14b3cd94c521f","48e9b3f2523fec68dd7a741e066ddf03a64129f0f37cf890d2af60d8809e6e32","499dd956d2c4971739cc529defe78e0f0cdeae2250bd5202d955a1359ef63915","24488c455116784b59d42c67219e36ae115d28cfb41880568dd4e981183d261b","4cee0449956c3ecad67754cf1dd65613203d4e51585fe67a0ceb7bbc7f5e3142","008f0899d49180cde5381063344097dfc901f39097680e2c37d0ab85d7e43b66"],"paragraph_range_zero_based":[27048,27071],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p27048"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SR periodicity and offset in number of symbols or slots (see TS 38.213 [13], clause 9.2.4) The following periodicities may be configured depending on the chosen subcarrier spacing:","paragraph_zero_based":27072},{"literal_text_all_w_t_and_m_t":"SCS =  15 kHz: 2sym, 7sym, 1sl, 2sl, 4sl, 5sl, 8sl, 10sl, 16sl, 20sl, 40sl, 80sl","paragraph_zero_based":27073},{"literal_text_all_w_t_and_m_t":"SCS =  30 kHz: 2sym, 7sym, 1sl, 2sl, 4sl, 8sl, 10sl, 16sl, 20sl, 40sl, 80sl, 160sl","paragraph_zero_based":27074},{"literal_text_all_w_t_and_m_t":"SCS =  60 kHz: 2sym, 7sym/6sym, 1sl, 2sl, 4sl, 8sl, 16sl, 20sl, 40sl, 80sl, 160sl, 320sl","paragraph_zero_based":27075},{"literal_text_all_w_t_and_m_t":"SCS = 120 kHz: 2sym, 7sym, 1sl, 2sl, 4sl, 8sl, 16sl, 40sl, 80sl, 160sl, 320sl, 640sl","paragraph_zero_based":27076},{"literal_text_all_w_t_and_m_t":"SCS = 480 kHz: 1sl, 2sl, 4sl, 8sl, 16sl, 40sl, 80sl, 160sl, 320sl, 640sl, 1280sl, 2560sl","paragraph_zero_based":27077},{"literal_text_all_w_t_and_m_t":"SCS = 960 kHz: 1sl, 2sl, 4sl, 8sl, 16sl, 40sl, 80sl, 160sl, 320sl, 640sl, 1280sl, 2560sl, 5120sl","paragraph_zero_based":27078},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27079},{"literal_text_all_w_t_and_m_t":"sym6or7 corresponds to 6 symbols if extended cyclic prefix and a SCS of 60 kHz are configured, otherwise it corresponds to 7 symbols.","paragraph_zero_based":27080},{"literal_text_all_w_t_and_m_t":"For periodicities 2sym, 7sym and sl1 the UE assumes an offset of 0 slots.","paragraph_zero_based":27081},{"literal_text_all_w_t_and_m_t":"If periodicityAndOffset-r17 is present, any previously configured periodicityAndOffset (without suffix) is released, and vice versa.","paragraph_zero_based":27082},{"literal_text_all_w_t_and_m_t":"phy-PriorityIndex","paragraph_zero_based":27083},{"literal_text_all_w_t_and_m_t":"Indicates whether this scheduling request resource is high or low priority in PHY prioritization/multiplexing handling (see TS 38.213 [13], clause 9.2.4). Value p0 indicates low priority and value p1 indicates high priority.","paragraph_zero_based":27084},{"literal_text_all_w_t_and_m_t":"resource","paragraph_zero_based":27085},{"literal_text_all_w_t_and_m_t":"ID of the PUCCH resource in which the UE shall send the scheduling request. The actual PUCCH-Resource is configured in PUCCH-Config of the same UL BWP and serving cell as this SchedulingRequestResourceConfig. The network configures a PUCCH-Resource of PUCCH-format0 or PUCCH-format1 (other formats not supported) (see TS 38.213 [13], clause 9.2.4)","paragraph_zero_based":27086},{"literal_text_all_w_t_and_m_t":"schedulingRequestID","paragraph_zero_based":27087},{"literal_text_all_w_t_and_m_t":"The ID of the SchedulingRequestConfig that uses this scheduling request resource.","paragraph_zero_based":27088},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27089},{"literal_text_all_w_t_and_m_t":"–SchedulingRequestResourceId","paragraph_zero_based":27090},{"literal_text_all_w_t_and_m_t":"The IE SchedulingRequestResourceId is used to identify scheduling request resources on PUCCH.","paragraph_zero_based":27091},{"literal_text_all_w_t_and_m_t":"SchedulingRequestResourceId information element","paragraph_zero_based":27092},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27093},{"literal_text_all_w_t_and_m_t":"-- TAG-SCHEDULINGREQUESTRESOURCEID-START","paragraph_zero_based":27094},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27095}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_Elem