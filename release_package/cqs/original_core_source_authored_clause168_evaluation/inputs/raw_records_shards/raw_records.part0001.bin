{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    q-RxLevMinOffsetCell                INTEGER (1..8)                              OPTIONAL,       -- Need R","paragraph_zero_based":13680},{"literal_text_all_w_t_and_m_t":"    q-QualMinOffsetCell                 INTEGER (1..8)                              OPTIONAL        -- Need R","paragraph_zero_based":13681},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":13682},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13683},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB5-STOP","paragraph_zero_based":13684},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":13685},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13686},{"literal_text_all_w_t_and_m_t":"SIB5 field descriptions","paragraph_zero_based":13687},{"literal_text_all_w_t_and_m_t":"carrierFreqListEUTRA","paragraph_zero_based":13688},{"literal_text_all_w_t_and_m_t":"List of carrier frequencies of E-UTRA. If the carrierFreqListEUTRA-v1610/ carrierFreqListEUTRA-v1700 is present, it shall contain the same number of entries, listed in the same order as in the carrierFreqListEUTRA (without suffix).","paragraph_zero_based":13689},{"literal_text_all_w_t_and_m_t":"dummy","paragraph_zero_based":13690},{"literal_text_all_w_t_and_m_t":"This field is not used in the specification. If received it shall be ignored by the UE.","paragraph_zero_based":13691},{"literal_text_all_w_t_and_m_t":"eutra-ExcludedCellList","paragraph_zero_based":13692},{"literal_text_all_w_t_and_m_t":"List of exclude-listed E-UTRA neighbouring cells.","paragraph_zero_based":13693},{"literal_text_all_w_t_and_m_t":"eutra-FreqNeighHSDN-CellList","paragraph_zero_based":13694},{"literal_text_all_w_t_and_m_t":"List of neighbouring EUTRA HSDN cells as specified in TS 36.304 [27].","paragraph_zero_based":13695},{"literal_text_all_w_t_and_m_t":"eutra-multiBandInfoList","paragraph_zero_based":13696},{"literal_text_all_w_t_and_m_t":"Indicates the list of frequency bands in addition to the band represented by carrierFreq for which cell reselection parameters are common, and a list of additionalPmax and additionalSpectrumEmission values, as defined in TS 36.101 [22], table 6.2.4-1, for the frequency bands in eutra-multiBandInfoList","paragraph_zero_based":13697},{"literal_text_all_w_t_and_m_t":"highSpeedEUTRACarrier","paragraph_zero_based":13698},{"literal_text_all_w_t_and_m_t":"If the field is present, the UE shall apply the enhanced NR-EUTRA inter-RAT measurement requirements to support high speed up to 500 km/h as specified in TS 38.133 [14] to the E-UTRA carrier.","paragraph_zero_based":13699},{"literal_text_all_w_t_and_m_t":"idleModeMeasVoiceFallback","paragraph_zero_based":13700},{"literal_text_all_w_t_and_m_t":"Indicates whether E-UTRA idle/inactive measurements and reporting for EPS fallback can be used.","paragraph_zero_based":13701},{"literal_text_all_w_t_and_m_t":"p-MaxEUTRA","paragraph_zero_based":13702},{"literal_text_all_w_t_and_m_t":"The maximum allowed transmission power in dBm on the (uplink) carrier frequency, see TS 36.304 [27].","paragraph_zero_based":13703}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["6b98fb5dd3535b9bb16dc56561c211a382525ce0f51cbc3b8feabddb719a8ae8","dde890ee1446c1ac9cc938a8933927b42570c3e56f298d9a28583e92b8a6ae6e","6dfb9db91a02cc195e54d9679f2fc04929a8557d5482a813d2e1c4758346e3a8","c797602654fb146990e256b5d8717f133db51a698abdbf58b816c14ea0365cfa","bc0c68d58525d76cd1f6a7908217ee80e9f14a2469632eb6451aaffead0f145d","b04d088d015437eae8180f2ca8ff672b6cf4f820eec