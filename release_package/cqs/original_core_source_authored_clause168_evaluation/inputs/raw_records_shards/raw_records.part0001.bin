{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE UE-CapabilityRAT-ContainerList contains a list of radio access technology specific capability containers.","paragraph_zero_based":35592},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRAT-ContainerList information element","paragraph_zero_based":35593},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":35594},{"literal_text_all_w_t_and_m_t":"-- TAG-UE-CAPABILITYRAT-CONTAINERLIST-START","paragraph_zero_based":35595},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35596},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRAT-ContainerList ::=    SEQUENCE (SIZE (0..maxRAT-CapabilityContainers)) OF UE-CapabilityRAT-Container","paragraph_zero_based":35597},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35598},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRAT-Container ::=        SEQUENCE {","paragraph_zero_based":35599},{"literal_text_all_w_t_and_m_t":"    rat-Type                              RAT-Type,","paragraph_zero_based":35600},{"literal_text_all_w_t_and_m_t":"    ue-CapabilityRAT-Container            OCTET STRING","paragraph_zero_based":35601},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":35602},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35603},{"literal_text_all_w_t_and_m_t":"-- TAG-UE-CAPABILITYRAT-CONTAINERLIST-STOP","paragraph_zero_based":35604},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":35605},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35606},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRAT-ContainerList field descriptions","paragraph_zero_based":35607},{"literal_text_all_w_t_and_m_t":"ue-CapabilityRAT-Container","paragraph_zero_based":35608},{"literal_text_all_w_t_and_m_t":"Container for the UE capabilities of the indicated RAT. The encoding is defined in the specification of each RAT:","paragraph_zero_based":35609},{"literal_text_all_w_t_and_m_t":"For rat-Type set to nr: the encoding of UE capabilities is defined in UE-NR-Capability.","paragraph_zero_based":35610},{"literal_text_all_w_t_and_m_t":"For rat-Type set to eutra-nr: the encoding of UE capabilities is defined in UE-MRDC-Capability.","paragraph_zero_based":35611},{"literal_text_all_w_t_and_m_t":"For rat-Type set to eutra: the encoding of UE capabilities is defined in UE-EUTRA-Capability specified in TS 36.331 [10].","paragraph_zero_based":35612},{"literal_text_all_w_t_and_m_t":"For rat-Type set to utra-fdd: the octet string contains the INTER RAT HANDOVER INFO message defined in TS 25.331 [45].","paragraph_zero_based":35613},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35614},{"literal_text_all_w_t_and_m_t":"–UE-CapabilityRAT-RequestList","paragraph_zero_based":35615}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["384fcb0b10f984e5c0869f00914d1c48b8e4d18b5db2cd3e332c1e862a3a806c","9c0ad19e91bc729aae439afd291b0d1f597bd3875acf2fc09cb7184ee34ff230","3dfd7c97830851cffb9ee1101951a0a88d662c928bff3985d5f864cfa80982a3","9bead2c2c2712f69b80c02e87d1fa5078eda6d988f7230b0cafbb676be52e4f4","28f05d757a18afc37185b3c13c0ecbd2a6415678b3424176f92f7edd1da9f102","263c672dd0a8e575ae4b657f1e8f7b939f8407982251be0fd85e011e477e30c3","42e7232fedff0d7ba2aee8c3408e8dccf198f61c62eab638cfa91945e3b758ae","0bb6a373f60c190562c887ffb0af43b1ae72ef8fac13b0f5d571405c93fcedbd","74a3c5144ec9c43089d365d1a8012dd1ea44e61c2aa6da54752e7f154d91a9f6","e3e089a6a84c200fb4eeb5317df406f080684b4b7917c92486e4861f57b18556","8f9ddc5142d7491716582233fb5805e639bc95c611ae64c893229b7d22f5b010","