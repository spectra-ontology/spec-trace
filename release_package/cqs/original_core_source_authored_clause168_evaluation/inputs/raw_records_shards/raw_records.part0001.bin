{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"DedicatedInfoF1c-r17 ::=        OCTET STRING","paragraph_zero_based":36336},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36337},{"literal_text_all_w_t_and_m_t":"-- TAG-DEDICATEDINFOF1C-STOP","paragraph_zero_based":36338},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36339},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36340},{"literal_text_all_w_t_and_m_t":"–EUTRA-AllowedMeasBandwidth","paragraph_zero_based":36341},{"literal_text_all_w_t_and_m_t":"The IE EUTRA-AllowedMeasBandwidth is used to indicate the maximum allowed measurement bandwidth on a carrier frequency as defined by the parameter Transmission Bandwidth Configuration \"NRB\" in TS 36.104 [33]. The values mbw6, mbw15, mbw25, mbw50, mbw75, mbw100 indicate 6, 15, 25, 50, 75 and 100 resource blocks, respectively.","paragraph_zero_based":36342},{"literal_text_all_w_t_and_m_t":"EUTRA-AllowedMeasBandwidth information element","paragraph_zero_based":36343},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36344},{"literal_text_all_w_t_and_m_t":"-- TAG-EUTRA-ALLOWEDMEASBANDWIDTH-START","paragraph_zero_based":36345},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36346},{"literal_text_all_w_t_and_m_t":"EUTRA-AllowedMeasBandwidth ::=              ENUMERATED {mbw6, mbw15, mbw25, mbw50, mbw75, mbw100}","paragraph_zero_based":36347},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36348},{"literal_text_all_w_t_and_m_t":"-- TAG-EUTRA-ALLOWEDMEASBANDWIDTH-STOP","paragraph_zero_based":36349},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36350},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36351},{"literal_text_all_w_t_and_m_t":"–EUTRA-MBSFN-SubframeConfigList","paragraph_zero_based":36352},{"literal_text_all_w_t_and_m_t":"The IE EUTRA-MBSFN-SubframeConfigList is used to define an E-UTRA MBSFN subframe pattern (for the purpose of NR rate matching).","paragraph_zero_based":36353},{"literal_text_all_w_t_and_m_t":"EUTRA-MBSFN-SubframeConfigList information element","paragraph_zero_based":36354},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36355},{"literal_text_all_w_t_and_m_t":"-- TAG-EUTRA-MBSFN-SUBFRAMECONFIGLIST-START","paragraph_zero_based":36356},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36357},{"literal_text_all_w_t_and_m_t":"EUTRA-MBSFN-SubframeConfigList ::= SEQUENCE (SIZE (1..maxMBSFN-Allocations)) OF EUTRA-MBSFN-SubframeConfig","paragraph_zero_based":36358},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["031c1583981b3189f094f51b26622b03cf3413f4a0452d3abe9640c5ff023903","068757b2dae124e11a7d8cd1c2feed3a4e3540c243a40ce2a619e9dcf0459991","6bd41b2560aa41cb42c8a0b2859770af6fd1bcf2c529ea389e87dcaa6f8aaa5c","ca0ff4dd13222a4b63a13bc0a0730f2463d5e6c803554a334fc0c2f5b63dacb6","1dd0e7298f4f2f22a8c898bbb915b7c191919c30cb63251f82e78602442c3fd6","47f9d3d54c5eedfc19fda29d01232c920451c0461981730928e5640a9f627456","984516afd1c38a31acc83a46d6acbe3b3191649dcfffa36dcab1cafaa701c9ab","f76ac97a0549812ed58140b7fcdfc19bc4459caefe1c281018abd991e05bfcf6","340dbe019e15031d8547f4ff7d9d0a8f98f51c80f1c3c0e93d101e041b68fba3","ec531753348c0537fa9d49cef1cea81b0ebdd4a9b1566b8ccc633cd904bfa2be","518f300ce6d91eec54802e6602681a33fe136027ba0e3885c7ea8d94720eb0bb","42223b21d31614e9298fec030f084993447cb3e94055c8c38e300315a9e636cf","5564c2ba1f34ed8bbde2131f924f827d45defa73e8022aa175c375573aaf6