{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"CFR-ConfigMulticast information element","paragraph_zero_based":15912},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":15913},{"literal_text_all_w_t_and_m_t":"-- TAG-CFR-CONFIGMULTICAST-START","paragraph_zero_based":15914},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15915},{"literal_text_all_w_t_and_m_t":"CFR-ConfigMulticast-r17::= SEQUENCE {","paragraph_zero_based":15916},{"literal_text_all_w_t_and_m_t":"    locationAndBandwidthMulticast-r17              INTEGER (0..37949)                       OPTIONAL,    -- Need S","paragraph_zero_based":15917},{"literal_text_all_w_t_and_m_t":"    pdcch-ConfigMulticast-r17                      PDCCH-Config                             OPTIONAL,    -- Need M","paragraph_zero_based":15918},{"literal_text_all_w_t_and_m_t":"    pdsch-ConfigMulticast-r17                      PDSCH-Config                             OPTIONAL,    -- Need M","paragraph_zero_based":15919},{"literal_text_all_w_t_and_m_t":"    sps-ConfigMulticastToAddModList-r17            SPS-ConfigMulticastToAddModList-r17      OPTIONAL,    -- Need N","paragraph_zero_based":15920},{"literal_text_all_w_t_and_m_t":"    sps-ConfigMulticastToReleaseList-r17           SPS-ConfigMulticastToReleaseList-r17     OPTIONAL     -- Need N","paragraph_zero_based":15921},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":15922},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15923},{"literal_text_all_w_t_and_m_t":"SPS-ConfigMulticastToAddModList-r17 ::=SEQUENCE (SIZE (1..8)) OF SPS-Config","paragraph_zero_based":15924},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15925},{"literal_text_all_w_t_and_m_t":"SPS-ConfigMulticastToReleaseList-r17 ::= SEQUENCE (SIZE (1..8)) OF SPS-ConfigIndex-r16","paragraph_zero_based":15926},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15927},{"literal_text_all_w_t_and_m_t":"-- TAG-CFR-CONFIGMULTICAST-STOP","paragraph_zero_based":15928},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":15929},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15930},{"literal_text_all_w_t_and_m_t":"CFR-ConfigMulticast field descriptions","paragraph_zero_based":15931},{"literal_text_all_w_t_and_m_t":"locationAndBandwidthMulticast","paragraph_zero_based":15932},{"literal_text_all_w_t_and_m_t":"Frequency domain location and bandwidth for MBS multicast. The value of the field shall be interpreted as resource indicator value (RIV) as defined in TS 38.214 [19] with assumptions as described in TS 38.213 [13], clause 12, i.e. setting  N^size_BWP=275. The first PRB is a PRB determined by subcarrierSpacing of the associated BWP and offsetToCarrier corresponding to this subcarrier spacing. If not configured, the UE applies the value of locationAndBandwidth of the DL BWP in which the cfr-ConfigMulticast is configured.","paragraph_zero_based":15933},{"literal_text_all_w_t_and_m_t":"pdcch-ConfigMulticast","paragraph_zero_based":15934},{"literal_text_all_w_t_and_m_t":"UE specific group-common PDCCH configuration for MBS multicast for one CFR.","paragraph_zero_based":15935}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["cdff0c647f5a96dd7ec8c21780b590c86435998b99177954eabcd64f5920e74c","e5d0b6422248c63233ad963ae2db7167ce7b628b7f51d2d799eabd08aee786df","0d6cd1270fce76e55739aa70bdecad40461f046254d4fbf55e76d36ddb111956","ff69dc11bea06eb71b9d27c2b7833bf372d3cf5e2457b4b6212f58dc629fd899","95714c1f096d55dc2af0496ed42a27ae3bb855e8fcd098ccd22b948f188400ea","654ba9f48