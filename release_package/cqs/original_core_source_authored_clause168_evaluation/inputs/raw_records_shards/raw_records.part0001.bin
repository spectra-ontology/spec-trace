8","ff3763e197fa697ee7ac129a02d436c92f587b9125e364e98c13bcdb19c73353","d6df0b6a83d10531f1e299e300a2671bab6911229765b2ede4d0c92c02dc4a92","b199548dcd749c94fffbe64214416ba216b9f370f556022de992291e2980f0c8","8ca2000c25d5c5f9202a398036a619b3bc9c9710ae2659bbf7e2a0bfa6b3d4e2","d884977fbe4922565914194bd6b27b7a743e7c8464a61ae6b980aefcb823c5ef","ecdb4b2a4d93b949f5ab23086516a68afe1704ae924a52cfaa2b2e5d129f27b1","2b68f5bb1a5050c29195db433f04f5c6434541d5e92007769de091592d9f88dd","26b75ba68c39856917a8f2fd2d1cc9fad914bfd3467d9fe4cc60b4bb77144d6f","f8fda33de2dd9720d15ce0a317a677d2ffd787e0e6738a4e7b93ac625e3d9626","7ad9502c9bb665106cd16c8c7fae6ade7150557c5f06afc1c7503193893245a8","43049eb950f6f05b9d68f77873b987c8867100f6d0fe236fb9f5f0bd1595d45f","dea0587c3f3fd19ee0e00f6fc9eb5823a691c7530528d445e810724a7907326a","1fa4b96827fc5d72e64f02a781ad21174ea8998bb8564cc4c2f5b6fda2c102e0","5d2782eaa867e2e1864305981d7499190e06f8bc2530d1c20cfe2cb1c99a33bc","d72a23fbc1346fbffdefed3f5c68f43b9c743ae5c0f887325ebad7e8c75113cd","15cc5988a78b64bf5fce67ec567b94c0cf6d0d74756548c00e99bfd65b3ae4aa","17c2ea3d7653185c8d076b9e3571a9ac0c73c39c49b8804a491b5be13bebb6b3"],"paragraph_range_zero_based":[36216,36239],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p36216"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"AppLayerMeasConfig field descriptions","paragraph_zero_based":36240},{"literal_text_all_w_t_and_m_t":"measConfigAppLayerContainer","paragraph_zero_based":36241},{"literal_text_all_w_t_and_m_t":"The field contains configuration of application layer measurements, see Annex L (normative) in TS 26.247 [68], clause 16.5 in TS 26.114 [69] and TS 26.118 [70].","paragraph_zero_based":36242},{"literal_text_all_w_t_and_m_t":"pauseReporting","paragraph_zero_based":36243},{"literal_text_all_w_t_and_m_t":"The field indicates whether the transmission of measReportAppLayerContainer is paused or not. Value true indicates the transmission of measReportAppLayerContainer is paused; value false indicates the transmission of measReportAppLayerContainer is not paused.","paragraph_zero_based":36244},{"literal_text_all_w_t_and_m_t":"ran-VisibleParameters","paragraph_zero_based":36245},{"literal_text_all_w_t_and_m_t":"The field indicates whether RAN visible application layer measurements shall be reported or not.","paragraph_zero_based":36246},{"literal_text_all_w_t_and_m_t":"rrc-SegAllowed","paragraph_zero_based":36247},{"literal_text_all_w_t_and_m_t":"This field indicates that RRC segmentation of MeasurementReportAppLayer is enabled. It may be present only if the UE supports RRC segmentation of the MeasurementReportAppLayer message in UL.","paragraph_zero_based":36248},{"literal_text_all_w_t_and_m_t":"serviceType","paragraph_zero_based":36249},{"literal_text_all_w_t_and_m_t":"Indicates the type of application layer measurement. Value streaming indicates Quality of Experience Measurement Collection for streaming services (see TS 26.247 [68]), value mtsi indicates Quality of Experience Measurement Collection for MTSI (see TS 26.114 [69]) and value vr indicates Quality of Experience Measurement Collection for VR service (see TS 26.118 [70]). The network always configures serviceType when application layer measurements are initially configured and at fullConfig.","paragraph_zero_based":36250},{"literal_text_all_w_t_and_m_t":"transmissionOfSessionStartStop","paragraph_zero_based":36251},{"literal_text_all_w_t_and_m_t":"Value true indicates that the UE shall transmit indications when the measurement session in the application layer starts and stops. Value false indicates that the UE shall not transmit any session status indications. The UE transmits a session start indication upon configuration of this field set to value true if a session already has started in the application layer.","paragraph_zero_based":36252},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36253},{"literal_text_all_w_t_and_m_t":"RAN-VisibleParameters field descriptions","paragraph_zero_based":36254},{"literal_text_all_w_t_and_m_t":"numberOfBufferLevelEntries","paragraph_zero_based":36255},{"literal_text_all_w_t_and_m_t":"The field contains the maximum number of buffer level entries that can be reported for RAN visible application layer measurements. This field is also used by application layer to calculate the interval of RAN visible buffer level measurement, which is equal to the periodicity of RAN visible application layer measurements reporting divided by numberOfBufferLevelEntries.","paragraph_zero_based":36256},{"literal_text_all_w_t_and_m_t":"ran-VisiblePeriodicity","paragraph_zero_based":36257},{"literal_text_all_w_t_and_m_t":"The field indicates the periodicity of RAN visible application layer measurements reporting. Value ms120 indicates 120 ms, value ms240 indicates 240 ms and so on. If this field is absent, the periodicity of RAN visible application layer measurements reporting is the same as the reporting periodicity indicated in measConfigAppLayerContainer.","paragraph_zero_based":36258},{"literal_text_all_w_t_and_m_t":"reportPlayoutDelayForMediaStartup","paragraph_zero_based":36259},{"literal_text_all_w_t_and_m_t":"The field indicates whether the UE shall report Playout Delay for Media Startup for RAN visible application layer measurements.","paragraph_zero_based":36260},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36261},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36262},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":36263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["1aa37394ff02f192f76e9d3d237be9d4cac1b3e91339c990c5b86b5915843fb5","e5382290ba49f146d2f9eca83fcaf4e4874300eeb2dd96588e19abc62cfc25ca","c7efba0bada7ca3104eb2324258a61fe2a241f59bf0e97b7a1c5a69c2bd9dca1","e8bea6187819f7487da8ead317b9e3c172436af40fcbb21aaf1f004480bcf61e","c9f4e97edd95cef08a53cdf86147f9f040c8591fb5936be64210084acbdfc0a0","58e2aa9fde9de386dd9339ba310ab8be43e2a7a23351a67e763cef083c7615e9","703b459c0f826319e4b450582b8eae14dfa3b465d9a6b68bf391190a7540e427","56394fd1063df6d97ad62482f7156dc0e33e598d1d44116fc73d81a85fa60da3","409d8e4d9a0e0dfda01269c5628b4f93b4d521903c837ba20d78ff9972279e3c","cdfb8b62eb275b98f260e7e8649aa8cc89f215eaa7869bad6a09ba037ec85f1f","73cdb18c2e8b3da356ad89db6d9773a696f28c812e599cd2a7d64bd78e39fdca","394a9e47be81e31cad9e65a23e2fe26153a5f1fa24bd091a553aec48177fe272","5ce8721378015ae0e723f4b4b4c19efc441e3473438be6bcc072b47b9a9cd5bf","f39f3a032871a0a10027234d83bcc904a7a24f7e267eecbd3927ead7e5447ac7","3d86674b57d77f62b44b28f1affffa201b9b52496dcb653e231c1f04dbfdbdfc","53c0f432c413d46ef0dedc81d56bc92766e738c0b555e14fb19cae75d60714a2","b538da3ec5ac0288a55adbed3389f0de3f6e178b27e86a24c642aec571e8b696","f3fea918107a82f096818934eb68c65399bbb33e834937e8f1e69e522b5e0ea8","ac939cc07