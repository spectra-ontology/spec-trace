{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32904},{"literal_text_all_w_t_and_m_t":"FreqBandIndicatorEUTRA ::=  INTEGER (1..maxBandsEUTRA)","paragraph_zero_based":32905},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32906},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQBANDINDICATOREUTRA-STOP","paragraph_zero_based":32907},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32908},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32909},{"literal_text_all_w_t_and_m_t":"–FreqBandList","paragraph_zero_based":32910},{"literal_text_all_w_t_and_m_t":"The IE FreqBandList is used by the network to request NR CA, NR non-CA and/or MR-DC band combinations for specific NR and/or E-UTRA frequency bands and/or up to a specific number of carriers and/or up to specific aggregated bandwidth. This is also used to request feature sets (for NR) and feature set combinations (for NR and MR-DC). For NR sidelink communication, this is used by the initiating UE to request sidelink UE radio access capabilities from the peer UE.","paragraph_zero_based":32911},{"literal_text_all_w_t_and_m_t":"FreqBandList information element","paragraph_zero_based":32912},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32913},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQBANDLIST-START","paragraph_zero_based":32914},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32915},{"literal_text_all_w_t_and_m_t":"FreqBandList ::=                SEQUENCE (SIZE (1..maxBandsMRDC)) OF FreqBandInformation","paragraph_zero_based":32916},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32917},{"literal_text_all_w_t_and_m_t":"FreqBandInformation ::=         CHOICE {","paragraph_zero_based":32918},{"literal_text_all_w_t_and_m_t":"    bandInformationEUTRA            FreqBandInformationE