{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–UAC-BarringPerPLMN-List","paragraph_zero_based":29952},{"literal_text_all_w_t_and_m_t":"The IE UAC-BarringPerPLMN-List provides access category specific access control parameters, which are configured per PLMN/SNPN.","paragraph_zero_based":29953},{"literal_text_all_w_t_and_m_t":"UAC-BarringPerPLMN-List information element","paragraph_zero_based":29954},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29955},{"literal_text_all_w_t_and_m_t":"-- TAG-UAC-BARRINGPERPLMN-LIST-START","paragraph_zero_based":29956},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29957},{"literal_text_all_w_t_and_m_t":"UAC-BarringPerPLMN-List ::=         SEQUENCE (SIZE (1.. maxPLMN)) OF UAC-BarringPerPLMN","paragraph_zero_based":29958},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29959},{"literal_text_all_w_t_and_m_t":"UAC-BarringPerPLMN ::=              SEQUENCE {","paragraph_zero_based":29960},{"literal_text_all_w_t_and_m_t":"    plmn-IdentityIndex                  INTEGER (1..maxPLMN),","paragraph_zero_based":29961},{"literal_text_all_w_t_and_m_t":"    uac-ACBarringListType               CHOICE{","paragraph_zero_based":29962},{"literal_text_all_w_t_and_m_t":"        uac-ImplicitACBarringList           SEQUENCE (SIZE(maxAccessCat-1)) OF UAC-BarringInfoSetIndex,","paragraph_zero_based":29963},{"literal_text_all_w_t_and_m_t":"        uac-ExplicitACBarringList           UAC-BarringPerCatList","paragraph_zero_based":29964},{"literal_text_all_w_t_and_m_t":"    }                                                                                                     OPTIONAL     -- Need S","paragraph_zero_based":29965},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29966},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29967},{"literal_text_all_