{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is used to indicate the destination L2 ID for which the TX resource request and allocation from the network are concerned for the established PC5 link for relay by L2 U2N Relay UE, or L3 U2N Relay UE.","paragraph_zero_based":11736},{"literal_text_all_w_t_and_m_t":"sl-LocalID-Request","paragraph_zero_based":11737},{"literal_text_all_w_t_and_m_t":"This field is used to request local UE ID for the corresponding destination by the L2 U2N Relay UE.","paragraph_zero_based":11738},{"literal_text_all_w_t_and_m_t":"sl-TxInterestedFreqListL2U2N","paragraph_zero_based":11739},{"literal_text_all_w_t_and_m_t":"Each entry of this field indicates the index of frequency on which the UE is interested to transmit NR sidelink communication for established PC5 link for relay. The value 1 corresponds to the frequency of first entry in sl-FreqInfoList broadcast in SIB12, the value 2 corresponds to the frequency of second entry in sl-FreqInfoList broadcast in SIB12 and so on. In this release, only value 1 can be included in the interested frequency list. In this release, only one entry can be included in the list.","paragraph_zero_based":11740},{"literal_text_all_w_t_and_m_t":"sl-PagingIdentityRemoteUE","paragraph_zero_based":11741},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the paging UE ID(s) for the corresponding destination(s) by the L2 U2N Relay UE.","paragraph_zero_based":11742},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11743},{"literal_text_all_w_t_and_m_t":"–SystemInformation","paragraph_zero_based":11744},{"literal_text_all_w_t_and_m_t":"The SystemInformation message is used to convey one or more System Information Blocks or Positioning System Information Blocks. All the SIBs or posSIBs included are transmitted with the same periodicity.","paragraph_zero_based":11745},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: N/A","paragraph_zero_based":11746},{"literal_text_all_w_t_and_m_t":"RLC-SAP: TM","paragraph_zero_based":11747},{"literal_text_all_w_t_and_m_t":"Logical channels: BCCH","paragraph_zero_based":11748},{"literal_text_all_w_t_and_m_t":"Direction: Network to UE","paragraph_zero_based":11749},{"literal_text_all_w_t_and_m_t":"SystemInformation message","paragraph_zero_based":11750},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":11751},{"literal_text_all_w_t_and_m_t":"-- TAG-SYSTEMINFORMATION-START","paragraph_zero_based":11752},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11753},{"literal_text_all_w_t_and_m_t":"SystemInformation ::=               SEQUENCE {","paragraph_zero_based":11754},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                  CHOICE {","paragraph_zero_based":11755},{"literal_text_all_w_t_and_m_t":"        systemInformation                   SystemInformation-IEs,","paragraph_zero_based":11756},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture-r16    CHOICE {","paragraph_zero_based":11757},{"literal_text_all_w_t_and_m_t":"            posSystemInformation-r16        PosSystemInformation-r16-IEs,","paragraph_zero_based":11758},{"literal_text_all_w_t_and_m_t":"            criticalExtensionsFuture        SEQUENCE {}","paragraph_zero_based":11759}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["d379adedcf4948dde9ea31339127403aa724a2f6b344847720914c8ce28b5fe1","f243a352819255dfbd1396b8187e905cc5935dd7e0b57b64c23eb88449802cd1","e7899ed4461fb38d341aa6072b1632bebe605ac67252416101fcc49f912b8768","f9da4c11bc1fa9ea70a9