literal_text_all_w_t_and_m_t":"If set to 1: indication of a BCCH modification other than SIB6, SIB7, SIB8 and posSIBs.","paragraph_zero_based":40124},{"literal_text_all_w_t_and_m_t":"2","paragraph_zero_based":40125},{"literal_text_all_w_t_and_m_t":"etwsAndCmasIndication","paragraph_zero_based":40126},{"literal_text_all_w_t_and_m_t":"If set to 1: indication of an ETWS primary notification and/or an ETWS secondary notification and/or a CMAS notification.","paragraph_zero_based":40127}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["69b9d2033358021e9bca268b95f6127973bddc397e46ee1dcbe323bc1cec0876","774140a0cc1b771eb711a57196023107c44c4cceb93ce2bd63923430ff6bd847","7c5d3bf41896fd4abe680245d84fd9eaa6b0bc0a603102cbb9ff05f8a496817e","06936e9e4497486ea4db90d715dd39946f311a7bee55f553294857bc1fe2d1b2","3dffd8de7b370ed18d9d533f86360f1a98f00cc5692e7acc7084f7bf0317f461","ab0a349e31233eb5c953e8cc025f20cef62b57fab3da6ca906e25525b93f1dc4","1f278fb1622713e116d61d6c5e99be9fba29928b429ba0f7fb2318ad9fe11738","a0c6505d65588bd0a531965e81fda26cb6174165938d358f371f36f5c133e64b","560f425203b1ea576e2e54a763d289fab08c18c789524d1014bbe19fdfd83fe4","2cad86a8f8555d8d0ec4c3bdee4d3ec0aa4acbce4bb1bba27d9bc26696d87d59","d2cc79410905bf3c405ba008782aa6c1e38924e72e71fffab2eed7d66544ca81","1b0a48d0ccbc70068dd9fac6f394e40ade8527f767c4eb5625b4f3505430b9df","0ae0f9f84ffb3e63f4cca16c6597e7b515ad67de453146a716d808d8a3018737","85afeb197d52feca8ff717a4ce966671ffc3a4404327056824eaaeec54fd3cb4","71372d4448104acec6b8732d1aa7b46afa362368034cb715a6fdeec1e3c17c9c","1d76c2e1c40ede9469e84e4a50b0f500a811e5895ed3fc37f5d62eb9cf02c8ba","fc18febbe52e93623227adb26edd55e7f9275e01e32a279b10f7665162bc393f","fba8a1b37c3144e0d89