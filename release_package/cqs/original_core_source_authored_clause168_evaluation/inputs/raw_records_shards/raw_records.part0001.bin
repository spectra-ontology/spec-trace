{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"LCH-SetupOnly","paragraph_zero_based":14928},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new logical channel for a BH RLC channel. It is absent, Need M otherwise.","paragraph_zero_based":14929},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14930},{"literal_text_all_w_t_and_m_t":"–BH-RLC-ChannelID","paragraph_zero_based":14931},{"literal_text_all_w_t_and_m_t":"The IE BH-RLC-ChannelID is used to identify a BH RLC channel in the link between IAB-MT of the IAB-node and IAB-DU of the parent IAB-node or IAB-donor-DU.","paragraph_zero_based":14932},{"literal_text_all_w_t_and_m_t":"BH-RLC-ChannelID information element","paragraph_zero_based":14933},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":14934},{"literal_text_all_w_t_and_m_t":"-- TAG-BHRLCCHANNELID-START","paragraph_zero_based":14935},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14936},{"literal_text_all_w_t_and_m_t":"BH-RLC-ChannelID-r16 ::=    BIT STRING (SIZE (16))","paragraph_zero_based":14937},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14938},{"literal_text_all_w_t_and_m_t":"-- TAG-BHRLCCHANNELID-STOP","paragraph_zero_based":14939},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":14940},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14941},{"literal_text_all_w_t_and_m_t":"–BSR-Config","paragraph_zero_based":14942},{"literal_text_all_w_t_and_m_t":"The IE BSR-Config is used to configure buffer status reporting.","paragraph_zero_based":14943},{"literal_text_all_w_t_and_m_t":"BSR-Config information element","paragraph_zero_based":14944},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":14945},{"literal_text_all_w_t_and_m_t":"-- TAG-BSR-CONFIG-START","paragraph_zero_based":14946},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14947},{"literal_text_all_w_t_and_m_t":"BSR-Config ::=                      SEQUENCE {","paragraph_zero_based":14948},{"literal_text_all_w_t_and_m_t":"    periodicBSR-Timer                   ENUMERATED { sf1, sf5, sf10, sf16, sf20, sf32, sf40, sf64,","paragraph_zero_based":14949},{"literal_text_all_w_t_and_m_t":"                                                        sf80, sf128, sf160, sf320, sf640, sf1280, sf2560, infinity },","paragraph_zero_based":14950},{"literal_text_all_w_t_and_m_t":"    retxBSR-Timer                       ENUMERATED { sf10, sf20, sf40, sf80, sf160, sf320, sf640, sf1280, sf2560,","paragraph_zero_based":14951}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["38a2bfb99b0508538731f7e80ac110e36bb0a021e282a53245127fadefc1feba","651c9238dedeb3a5aac1c2b70504722ef8b29ec17e0f872ee80a683b0a473c7e","7e45442b6d7fba054c2d05a186e2655f111fafaf7c7ebe3c2d9297b9233305e1","d6e6fb6cf8bd7447c0a71815e8afee175024499241c22e8066fb70eabe640b89","5b807e820580d8ea244c2f35fa1ce5b4dad894d394d302bc6fd02f403c7d067e","e5ddfa5ce2f816baba2bd8d36d12708927975734b6fd1babb984577379fe272d","45503e1840dca7797c5ba7d1f33bb9de73d6740edec05f3e79e8262267b0c6f2","7382dbafcd02903929290012f9d5c65aac3480e0677c5c5494d598f8ea4e6793","4ffbc7d38b7ca4c0dd1a086d210856afa7d179a73e91be004fd16e7cbb0db306","07e1139ec215e9629464b6acce3b0114424dc72b264212e325f55168dcafc148","9738b1934b80326490905b76531377670ae1fc7410344dd11a10f8fd73cd417d","ccfa01ca23165c022466e6d90755e9afd99eeb501712bc3734f242c95f3a0196","62b25f417d93ff2f22d11e2508981f2fba4b6fa8b9014855a7c7805a860cd616","022196ba221c86986577c7779e6116afd34c753e9bde0332b7704476f0881d2c","dd21