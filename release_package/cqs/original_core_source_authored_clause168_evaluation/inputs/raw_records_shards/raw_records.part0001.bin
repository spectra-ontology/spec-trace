{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-Additional-PBPS-Occasion","paragraph_zero_based":38184},{"literal_text_all_w_t_and_m_t":"Indicates that UE additionally monitors periodic sensing occasions that correspond to a set of values. (see TS 38.214 [19], clause 8.1.4).","paragraph_zero_based":38185},{"literal_text_all_w_t_and_m_t":"sl-AllowedResourceSelectionConfig","paragraph_zero_based":38186},{"literal_text_all_w_t_and_m_t":"Indicates the allowed resource selection mechanism(s), i.e. full sensing only, partial sensing only, random resource selection only, or any combination(s) thereof. (see TS 38.214 [19], clause 8.1.4). Only c1, c4 , c5 or c7 can be configured for a Rel-16 resource pool. If this field is not configured for a resource pool included in sl-TxPoolSelectedNormal, only full sensing is allowed in the corresponding resource pool.","paragraph_zero_based":38187},{"literal_text_all_w_t_and_m_t":"c1: only full sensing allowed","paragraph_zero_based":38188},{"literal_text_all_w_t_and_m_t":"c2: only partial sensing allowed","paragraph_zero_based":38189},{"literal_text_all_w_t_and_m_t":"c3: only random selection allowed","paragraph_zero_based":38190},{"literal_text_all_w_t_and_m_t":"c4: full sensing+random selection allowed","paragraph_zero_based":38191},{"literal_text_all_w_t_and_m_t":"c5: full sensing+ partial sensing allowed","paragraph_zero_based":38192},{"literal_text_all_w_t_and_m_t":"c6: partial sensing + random selection allowed","paragraph_zero_based":38193},{"literal_text_all_w_t_and_m_t":"c7: full sensing+ partial sensing + random selection allowed.","paragraph_zero_based":38194},{"literal_text_all_w_t_and_m_t":"sl-CPS-WindowAperiodic","paragraph_zero_based":38195},{"literal_text_all_w_t_and_m_t":"Parameter that indicates the minimum size of contiguous partial sensing window in logical slot units for a resource (re)selection procedure and re-evaluation/pre-emption checking triggered by aperiodic transmission. (see TS 38.214 [19], clause 8.1.4). If not configured, the size of contiguous partial sensing window in logical slot units is 31.","paragraph_zero_based":38196},{"literal_text_all_w_t_and_m_t":"sl-CPS-WindowPeriodic","paragraph_zero_based":38197},{"literal_text_all_w_t_and_m_t":"Indicates the size of contiguous partial sensing window in logical slot units when UE performs periodic-based and contiguous partial sensing for a resource (re)selection procedure triggered by periodic transmission. If not configured, the size of contiguous partial sensing window in logical slot units is 31.","paragraph_zero_based":38198},{"literal_text_all_w_t_and_m_t":"sl-DefaultCBR-PartialSensing","paragraph_zero_based":38199},{"literal_text_all_w_t_and_m_t":"Indicates default value of SL CBR measurement for a UE that is configured to perform partial sensing by its higher layer (including when SL DRX is configured) if the number of SL RSSI measurement slots over CBR measurement window is below sl-MinNumRssiMeasurementSlots, (see TS 38.214 [19], clause 8.1.6). Value 0 corresponds to 0, value 1 to 0.01, value 2 to 0.02, and so on.","paragraph_zero_based":38200},{"literal_text_all_w_t_and_m_t":"sl-DefaultCBR-RandomSelection","paragraph_zero_based":38201},{"literal_text_all_w_t_and_m_t":"Indicates default value of CBR measurement for a UE that performs random resource selection if no SL CBR measurement result over SL CBR measurement window, (see TS 38.214 [19], clause 8.1.6). Value 0 corresponds to 0, value 1 to 0.01, value 2 to 0.02, and so on.","paragraph_zero_based":38202},{"literal_text_all_w_t_and_m_t":"sl-MinNumCandidateSlotsAperiodic","paragraph_zero_based":38203},{"literal_text_all_w_t_and_m_t":"Indicates the minimum number of Y' slots that are included in the possible candidate resources corresponding to periodic-based partial sensing and/or contiguous partial sensing for resource (re)selection triggered by aperiodic transmission. (see TS 38.214 [19], clause 8.1.4).","paragraph_zero_based":38204},{"literal_text_all_w_t_and_m_t":"sl-MinNumCandidateSlotsPeriodic","paragraph_zero_based":38205},{"literal_text_all_w_t_and_m_t":"Indicates the minimum number of Y slots that are included in the possible candidate resources corresponding to periodic-based partial sensing for resource (re)selection triggered by periodic transmission. (see TS 38.214 [19], clause 8.1.4).","paragraph_zero_based":38206},{"literal_text_all_w_t_and_m_t":"sl-MinNumRssiMeasurementSlots","paragraph_zero_based":38207}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["10c0979da24c19d841a502d4b456be860b3d61b78167a9701ca440a4c78c6956","b7ce4d29a659178d2fe3d3f4ae4e45b9ef260ef69c9e1f83e9dba6366c1df22b","192526043966a489265ff7aeac50b6bede38205643402d60776259dd3e4f21d0","d7bc27be72b91a28901f5bed064f0009a0fee0020f45748c4cc2d119b636ee28","5e410b17dbe02117229b700ff038b4145f65777b20de901e47d557e2912463fa","c49b86c4c24206031830d01584451b0a06f51433ff2bb69efb2bbdf7d15f10e8","35f360ba3b27047bd8e0553b0b86da85c94d4e48f6e74fafb27be8ea4076e9a1","184674582cdb3f822a1b2946edb74bac5701d6d5d3a8078191de1052a9f37ac9","d7718de0be18ba36dc477d74ebdcab5e704657b010970e7d4c8609c57126cfc9","5724bfa18c92dfa0f501db63a100b0740de7a9d547f1d988b0cfa3f90ce26716","379c116f38da3a7728d737a8d281e05e8ac69ecf747757cf2e41da9fe5a42642","f06070af6ca2d8ee2e7dbb94695be3f0e8fedb5e5e3d388bf4c75060f7e0ef3b","87a16140de05293c5ca0aacb0a38fed627fdf50749a2059c5bdb759d8cc2bc3c","127ec92c0814401063b2627820e4ec56ace3d41bbf60f1ab503ce65c8f73883f","d0b445d01ff665ac0269b433b46f8c919a12c98231e929d6594f248f1aae0b71","b7aa102016cebb9a6b3510524630254c869847e7223d3d307e32f359e662ed8d","a341e8581dc494d9bfb00b9f366b331d25754dc2e541aa3fd8e81992d506214c","bcb2a55cf505c74d14c3df5fe1ef885f89f00a1fa8380caa1c3ea52a55a5c706","373c9c0cf9217c65164441e8c8e7375b155e681281753e5becc0d83d5d4dc848","6eef442862c35577a092490d3a55980c69ce8a53b42e60a6afdd742e863ad264","78ac3e910e1c5b0511fbff378e545583be70446c2cacf7bb1da9b517069f9f2a","a38f8e785ac9c8ee2fe40375927b86b17a96e3929ea3d1415572fa2b89f2531f","2a356cf7453adc175fab1975643bc090e930331e37ce06410722c3ab0124e95c","e2f8e953e5c1efc57b0354b2a644a658a02f86bb17a529fff156ba122a3857f3"],"paragraph_range_zero_based":[38184,38207],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p38184"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates a threshold for a minimum number of SL RSSI measurement slots over CBR measurement window for which the SL RSSI is measured for a UE that is configured to perform partial sensing by its higher layer (including when SL DRX is configured). (see TS 38.214 [19], clause 8.1.6).","paragraph_zero_based":38208},{"literal_text_all_w_t_and_m_t":"sl-PartialSensingInactiveTime","paragraph_zero_based":38209},{"literal_text_all_w_t_and_m_t":"Indicates whether or not UE is required to perform SL reception of PSCCH and RSRP measurement for partial sensing on slots in SL DRX inactive time when partial sensing is configured by its higher layer. (see TS 38.214 [19], clause 8.1.4).","paragraph_zero_based":38210},{"literal_text_all_w_t_and_m_t":"sl-PBPS-OccasionReservePeriodList","paragraph_zero_based":38211},{"literal_text_all_w_t_and_m_t":"Indicates the subset of periodicity values from sl-ResourceReservePeriodList used to determine periodic sensing occasions in periodic-based partial sensing, by means of an index to the corresponding entry in sl-ResourceReservePeriodList-r16. If not configured, all periodicity values from sl-ResourceReservePeriodList are used to determine periodic sensing occasions in periodic-based partial sensing (see TS 38.214 [19], clause 8.1.4).","paragraph_zero_based":38212},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38213},{"literal_text_all_w_t_and_m_t":"–SL-PDCP-Config","paragraph_zero_based":38214},{"literal_text_all_w_t_and_m_t":"The IE SL-PDCP-Config is used to set the configurable PDCP parameters for a sidelink radio bearer.","paragraph_zero_based":38215},{"literal_text_all_w_t_and_m_t":"SL-PDCP-Config information element","paragraph_zero_based":38216},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":38217},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-PDCP-CONFIG-START","paragraph_zero_based":38218},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38219},{"literal_text_all_w_t_and_m_t":"SL-PDCP-Config-r16 ::=       SEQUENCE {","paragraph_zero_based":38220},{"literal_text_all_w_t_and_m_t":"    sl-DiscardTimer-r16          ENUMERATED {ms3, ms10, ms20, ms25, ms30, ms40, ms50, ms60, ms75, ms100, ms150, ms200,","paragraph_zero_based":38221},{"literal_text_all_w_t_and_m_t":"                                 ms250, ms300, ms500, ms750, ms1500, infinity}                                   OPTIONAL, -- Cond Setup","paragraph_zero_based":38222},{"literal_text_all_w_t_and_m_t":"    sl-PDCP-SN-Size-r16          ENUMERATED {len12bits, len18bits}                                               OPTIONAL, -- Cond Setup2","paragraph_zero_based":38223},{"literal_text_all_w_t_and_m_t":"    sl-OutOfOrderDelivery        ENUMERATED { true }                                                             OPTIONAL,    -- Need R","paragraph_zero_based":38224},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":38225},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":38226},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38227},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-PDCP-CONFIG-STOP","paragraph_zero_based":38228},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":38229},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38230},{"literal_text_all_w_t_and_m_t":"SL-PDCP-Config field descriptions","paragraph_zero_based":38231}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["8d413bda8c5210b94c5fa2c1cca9f8996b7873562321b438b67f6c8231079127","