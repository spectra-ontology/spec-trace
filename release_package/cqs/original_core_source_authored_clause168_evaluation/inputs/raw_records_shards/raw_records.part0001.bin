,"paragraph_zero_based":29200},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29201},{"literal_text_all_w_t_and_m_t":"-- TAG-TCI-ACTIVATEDCONFIG-START","paragraph_zero_based":29202},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29203},{"literal_text_all_w_t_and_m_t":"TCI-ActivatedConfig-r17 ::= SEQUENCE {","paragraph_zero_based":29204},{"literal_text_all_w_t_and_m_t":"    pdcch-TCI-r17               SEQUENCE (SIZE (1..5)) OF TCI-StateId,","paragraph_zero_based":29205},{"literal_text_all_w_t_and_m_t":"    pdsch-TCI-r17               BIT STRING (SIZE (1..maxNrofTCI-States))","paragraph_zero_based":29206},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29207}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["2870e22029d6cd17d97105a6fd7463818a3d86ccab0de80fcef2bb77849ea613","baa9fd1322f1c12b64ed1eea5675d4ae30267909e3d443123443420f5546b1ae","3c296dc38ef0813ffe32ccc47b6e9b8b2b2d49f960ea6f2c7a6186df7d6c27c4","3f7da51827dacf20688bfce955c902c1893809c5a03a04b455043694a07d03b5","fcc162939220f25ac20143bed60c0b30d4e90e076fc086326a794017cbac1eb1","52c038f9b3f7b82229da9c9e70e21a8d82f8608fc506f5946e26081dad608d12","6e081fbd178e2da7b9dd9b3887ace408412ca86bf37b0b3746235a4dc63a9dde","f7a437ba33b4b1396f49f8512db0a19d7563e34c924bf96711e8ee36d015ed2d","c8824f198e00dd288d9350629538585d9b655cea0654b8f46ff24e9a35b6aafe","3c8df4e624fafd56f5864710de761da00a07992a8e0e900505ec554418b0b351","b5a31c28a96c424d4edb2d7414d3e88658537fa11192949bfaa88b9688116c58","b2150c05fd1698954957fa703cc221da967bf0a7ce7370c9bc473ecb574472fc","986fa0490d57d6e5925129cf62d02ff34b7e31a8e05ea17e1303a72261e1ec52","91fe94675b02e7f577c270c79febd09f731f7c9193a60a736eafde97b18552a0","480c623eea2886858dbb5857542ff1d5ad4864521200c8f6f41b9694a9d8be3c","e6cdff458b9757df4742ab3528876b3d02807c310738118460f80e03989ea130","3ddba18b9a1ab22181c9acc190b0b8a3b91908df2ea318a7442887def9f5b8d0","7ce1e7da692add10cc14a3e6d01877c8902654725821a797503f79b9c090aa26","fc93a8cb8dce1abf7bc44114efc454e1159e559e25ebfd1a4d7aab120ab7d539","ddd4e7214aa977fd4782d01a8860b9fe7c187a9e34117fa8ecf2402f41a78785","2e2ffcdd9dd990a67b4d132c0094ec5576fb7df5e1686f7883eb98866329fffd","cd3e432130f3bb40cb8bbed5bd12514629152f82d18469de0a5a4c9bad2494a2","aff1ff45008136a0d0f39a499b5c3771214b8b9cebaf5ee64ba971f4ed79bbba","9ae5046e1d7ca7917095e4f5ef71d8cd436603adcef3dbdc18f34c114d6e509d"],"paragraph_range_zero_based":[29184,29207],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p29184"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29208},{"literal_text_all_w_t_and_m_t":"-- TAG-TCI-ACTIVATEDCONFIG-STOP","paragraph_zero_based":29209},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29210},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29211},{"literal_text_all_w_t_and_m_t":"TCI-ActivatedConfig field descriptions","paragraph_zero_based":29212},{"literal_text_all_w_t_and_m_t":"pdcch-TCI","paragraph_zero_based":29213},{"literal_text_all_w_t_and_m_t":"Indicates the TCI state for PDCCH for each configured CORESET of the DL BWP to be activated at SCell activation, to be activated for the PSCell at SCG activation and/or to be used for BFD, RLM and measurements while the SCG is deactivated. The list includes exactly as many entries as CORESETs configured in this BWP, ordered by increasing values of ControlResourceSet-Id, i.e. the first entry indicates the TCI state for the configured CORESET with the lowest ControlResourceset-Id value, the second value indicates the TCI states for the configured CORESET with the second lowest ControlResourceset-Id value, and so on.","paragraph_zero_based":29214},{"literal_text_all_w_t_and_m_t":"pdsch-TCI","paragraph_zero_based":29215},{"literal_text_all_w_t_and_m_t":"Indicates TCI states for PDSCH reception at SCell addition/activation or of the PSCell at SCG activation. This field indicates activated TCI state(s) for this BWP ordered by increasing values of TCI-StateId, i.e. the first bit indicates the activation state of the TCI state with the lowest TCI-StateId value, the second value indicates the activation status of the TCI state with the second lowest TCI-State-Id value, and so on. A bit set to 0 indicates that the corresponding TCI state is deactivated, a bit set to 1 indicates that the TCI state is activated.","paragraph_zero_based":29216},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29217},{"literal_text_all_w_t_and_m_t":"–TCI-State","paragraph_zero_based":29218},{"literal_text_all_w_t_and_m_t":"The IE TCI-State associates one or two DL reference signals with a corresponding quasi-colocation (QCL) type.","paragraph_zero_based":29219},{"literal_text_all_w_t_and_m_t":"TCI-State information element","paragraph_zero_based":29220},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29221},{"literal_text_all_w_t_and_m_t":"-- TAG-TCI-STATE-START","paragraph_zero_based":29222},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29223},{"literal_text_all_w_t_and_m_t":"TCI-State ::=                       SEQUENCE {","paragraph_zero_based":29224},{"literal_text_all_w_t_and_m_t":"    tci-StateId                         TCI-StateId,","paragraph_zero_based":29225},{"literal_text_all_w_t_and_m_t":"    qcl-Type1                           QCL-Info,","paragraph_zero_based":29226},{"literal_text_all_w_t_and_m_t":"    qcl-Type2                           QCL-Info                                                    OPTIONAL,   -- Need R","paragraph_zero_based":29227},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":29228},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":29229},{"literal_text_all_w_t_and_m_t":"    additionalPCI-r17                   AdditionalPCIIndex-r17                                      OPTIONAL,   -- Need R","paragraph_zero_based":29230},{"literal_text_all_w_t_and_m_t":"    pathlossReferenceRS-Id-r17          PathlossReferenceRS-Id-r17                                  OPTIONAL,   -- Cond JointTCI1","paragraph_zero_based":29231}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["b40dc11e5c183c0d1f7f68bc5424984f453faa11e4ef2d5ca0d5bc35682b70e9","033f7ee9670c8a3cbe4a77a234b8d61e202ed0144a7305b070daf67eaa4e5f56","c295b7c15c468fb1aadb32fc13b99bd5dbdf45644e17cbf8bd3a2c6e90c9861c","9cf13723f2c2af673558ce5a24a9425cbc52ce1ff55d8e4a104afce956c8c074","be1f2c6abdb88b76739b0d99ab91fdbba6d3eb99c34d18ba34fb2ee956e295fc","2c74618878c34c0eb2eb94f74a8aea760ae864038b913d6886793c93d0b3b8a5","408d2261d42718b9e19509a453c7278abd28a03860268ca1252b0c3ad0a23736","8a5b0b659b1293293daeca454af16a590c4f8783e99c88b278b56ebc332a0674","6fd2e744758775bc8c2eeab45e52099da3ce37b8a8e052ef3586fceb642273f7","6727de24fca5a765826c71d98a31525d9d045ead8e4b6c8bcd2197af0d63f680","317e78a82fd249a03a6b4d57b14cde9d396813ced41b7f14d1923b56aa9fa578","93ef2ea41776ef517af1c2968de2604107365ffe404de92445d4bdcf09ce5073","d3823181b5c3c56f810242e60dd5a9b021176aeeee88c16bba39442f313f61b6","39acafd110d7a2eeace176d9309d980a3710da59a389e5f3ab9b7d08f05d4a2e","9fc8f755eab8ede185e919c4671c7c3d7878ff45bf66a869381121e29e92de37","a27b6f90a977e95fc08024fa042fd4880f44611d7bb88223764f7ea05f0917d2","d335b67f1c6f57c23d2ab4fc4643b73591ceb7d7540366fe73192ca6defa6517","6d14181ae1dbf15013d4969938c2ff492ba1b475e880907735b7b4ec6a003cbf","f10906f008a4babdaf1d17bbed8f0a8f607fc9a1788eefd9acd45b7d3e86063b","e1b7700ca3f2b537a5c2fd29a59b6f58ea6d38705b816c7a5345f335f377e7e4","25cad66777db4fc77119f51aadbec7e5dc198b70793b321b8d064eb7f5ed2421","e16cd3a3057e9869676c388f5b557c5a85c75856ba99ac776acf780573015421","bdc07d4d4c1cca8c270feb45bc8e5a391a044b4374aa4b217eff759f489fe491","7c4ebc92900a03da69b78dd5731f04847113b32622614eedec8b7013b2f990a4"],"paragraph_range_zero_based":[29208,29231],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p29208"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ul-powerControl-r17                 Uplink-powerControlId-r17                                   OPTIONAL    -- Cond JointTCI","paragraph_zero_based":29232},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":29233},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29234},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29235},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29236},{"literal_text_all_w_t_and_m_t":"QCL-Info ::=                        SEQUENCE {","paragraph_zero_based":29237},{"literal_text_all_w_t_and_m_t":"    cell                                ServCellIndex                                               OPTIONAL,   -- Need R","paragraph_zero_based":29238},{"literal_text_all_w_t_and_m_t":"    bwp-Id                              BWP-Id                                                      OPTIONAL, -- Cond CSI-RS-Indicated","paragraph_zero_based":29239},{"literal_text_all_w_t_and_m_t":"    referenceSignal                     CHOICE {","paragraph_zero_based":29240},{"literal_text_all_w_t_and_m_t":"        csi-rs                              NZP-CSI-RS-ResourceId,","paragraph_zero_based":29241},{"literal_text_all_w_t_and_m_t":"        ssb                                 SSB-Index","paragraph_zero_based":29242},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":29243},{"literal_text_all_w_t_and_m_t":"    qcl-Type                            ENUMERATED {typeA, typeB, typeC, typeD},","paragraph_zero_based":29244},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":29245},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29246},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29247},{"literal_text_all_w_t_and_m_t":"-- TAG-TCI-STATE-STOP","paragraph_zero_based":29248},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29249},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29250},{"literal_text_all_w_t_and_m_t":"QCL-Info field descriptions","paragraph_zero_based":29251},{"literal_text_all_w_t_and_m_t":"bwp-Id","paragraph_zero_based":29252},{"literal_text_all_w_t_and_m_t":"The DL BWP which the RS is located in. If the field is absent, the RS is located in the DL BWP in which the TCI-State is applied by the UE.","paragraph_zero_based":29253},{"literal_text_all_w_t_and_m_t":"cell","paragraph_zero_based":29254},{"literal_text_all_w_t_and_m_t":"The UE's serving cell in which the referenceSignal is configured. If the field is absent, the referenceSignal is configured in the serving cell in which the TCI-State is applied by the UE. The RS can be located on a serving cell other than the serving cell for which the TCI-State is applied by the UE only if the qcl-Type is configured as typeC or typeD. If the referenceSignal is set to csi-rs and unifiedTCI-StateType is configured, either both cell and bwp-Id are present or both cell and bwp-Id are absent. See TS 38.214 [19] clause 5.1.5.","paragraph_zero_based":29255}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["22b57865b41956d634c462efdac22c94a3965b99f633886d58e0886ab4590575","60f481595b892d0f0c850fb4baf3ebc94f46ec2ec8130b1f3ac3c62a0c9cffe1","dd39bfec05267794ebb19d82412d95a0e690a9d7d6ce3f13f93023afc0612288","5777406d3dd6a42d7f0eca23481b573fe0c82eee640ea11cc8ad416ac3c28519","b407c47a3d36deb3bb0d63b963f7adde42671a04d941a8e9410a2c34c073751f","d36d3ec7c89bda554a33c87b04a4d1e11be4c6f4e8a0e1dd7ae3a13fd6b92fb2","6336b47a94f6be324ce51b1ab98b77f7e0304c2458ba2669ecb5fc6b79f0d0fd","aef47bd4b517c1cf6b585d025ef932f15a9968baef2419412cc2b7fbf539c029","240233a9b61746aec9929b10df10881e75a00e97e0e5c5f5255695a421248c7d","c11180ed45abf88896acd53ca9342aaceca5089876908687c0461570c7b99db0","81427be910c0c686288a549cb65d7bf5c0721a577111b62a35f3d767321c06f1","570e25c537e21fd7eacc4d263beca6f0090621edc174ad211712da3f3f5d48e1","23d8c011e19afc97ed5bb281f51af36eac0e0b275ccdb43fbf1c1431c42bd519","d3e0a6a4771ef1a61768b4938efe03687aca693c586977d84596f2841d3adccf","3972f20f30880320353674ed57f0c8fa46e305033986c3aa9cb364d3fe2f1471","8a428e60fd6a90089fe3702a54c0875699278df416ce611038c3976ed34443ec","cd25050e0c3129a1388fe87b67be676af16f137d2c21a1f7e2f26f7274643ce1","ecd0383298f92541604332ec24e8d63ed1cb3e69083b629cf3d36b6a5b5d02c4","62e118d6ae6c05d33a8b2f6eb3f0cdac73a0b611f0fe4eabdb7d1dbc731ad874","bf3ee341d6838d6974b1cfffef80941e369abe92313dd70344d7fb8c65ab3f25","9d18df7a02a4cc14db5f3c4f307ee153a66d33ace4c495cca7962839e05a7d9f","61ea10953f453c09b46ac9f91e67823b0383bf6ce3d076acc9ceee9a81071454","002670cbec6f150c7baf115460c826b6c10cb67e9026bbdafaeadf9e6ad636dd","e8124ae96bcc5430486903e16e07dfde395ba9e597ebdf4c11b4499fed2f880b"],"paragraph_range_zero_based":[29232,29255],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p29232"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"referenceSignal","paragraph_zero_based":29256},{"literal_text_all_w_t_and_m_t":"Reference signal with which quasi-collocation information is provided as specified in TS 38.214 [19] clause 5.1.5.","paragraph_zero_based":29257},{"literal_text_all_w_t_and_m_t":"qcl-Type","paragraph_zero_based":29258},{"literal_text_all_w_t_and_m_t":"QCL type as specified in TS 38.214 [19] clause 5.1.5.","paragraph_zero_based":29259},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29260},{"literal_text_all_w_t_and_m_t":"TCI-State field descriptions","paragraph_zero_based":29261},{"literal_text_all_w_t_and_m_t":"additionalPCI","paragraph_zero_based":29262},{"literal_text_all_w_t_and_m_t":"Indicates the physical cell IDs (PCI) of the SSBs when referenceSignal is configured as SSB for both QCL-Type1 and QCL-Type2. In case the cell is present, the additionalPCI refers to a PCI value configured in the list configured using additionalPCI-ToAddModList in the serving cell indicated by the field cell. Otherwise, it refers to a PCI value configured in a list additionalPCI-ToAddModList configured in the serving cell where the TCI-State is applied by the UE. When this field is present the cell for qcl-Type1 and qcl-Type2 is configured with same value, if present.","paragraph_zero_based":29263},{"literal_text_all_w_t_and_m_t":"pathlossReferenceRS-Id","paragraph_zero_based":29264},{"literal_text_all_w_t_and_m_t":"The ID of the reference signal (e.g. a CSI-RS or an SS block) used for PUSCH, PUCCH and SRS path loss estimation. This field refers to an element in the list configured using pathlossReferenceRSToAddModList in the serving cell and UL BWP where the TCI State is applied by the UE.","paragraph_zero_based":29265},{"literal_text_all_w_t_and_m_t":"qcl-Type1, qcl-Type2","paragraph_zero_based":29266},{"literal_text_all_w_t_and_m_t":"QCL information for the TCI state as specified in TS 38.214 [19] clause 5.1.5.","paragraph_zero_based":29267},{"literal_text_all_w_t_and_m_t":"tci-StateId","paragraph_zero_based":29268},{"literal_text_all_w_t_and_m_t":"ID number of the TCI state.","paragraph_zero_based":29269},{"literal_text_all_w_t_and_m_t":"ul-PowerControl","paragraph_zero_based":29270},{"literal_text_all_w_t_and_m_t":"Configures power control parameters for PUCCH, PUSCH and SRS for this TCI state. The field is present here only if ul-powerControl is not configured in any BWP-Uplink-Dedicated of this serving cell. This field refers to an element in the list configured using uplink-PowerControlToAddModList in the serving cell where the dl-OrJointTCI-StateToAddModList is configured.","paragraph_zero_based":29271},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29272},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":29273},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":29274},{"literal_text_all_w_t_and_m_t":"CSI-RS-Indicated","paragraph_zero_based":29275},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if csi-rs is included and unifiedTCI-StateType is not configured. This field is optionally present, Need R, if csi-rs is included and unifiedTCI-StateType is configured. Otherwise, it is absent, Need R.","paragraph_zero_based":29276},{"literal_text_all_w_t_and_m_t":"JointTCI","paragraph_zero_based":29277},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, if this serving cell is configured with unifiedTCI-StateType set to 'joint'. It is absent, Need R, otherwise.","paragraph_zero_based":29278},{"literal_text_all_w_t_and_m_t":"JointTCI1","paragraph_zero_based":29279}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc