{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"targetCellIdentity","paragraph_zero_based":41832},{"literal_text_all_w_t_and_m_t":"An input variable used to calculate the shortMAC-I. Set to the cellIdentity of the first PLMN-Identity in the PLMN-IdentityInfoList broadcasted in SIB1 of the target cell i.e. the cell the UE is trying to reestablish the connection.","paragraph_zero_based":41833},{"literal_text_all_w_t_and_m_t":"source-c-RNTI","paragraph_zero_based":41834},{"literal_text_all_w_t_and_m_t":"Set to C-RNTI that the UE had in the PCell it was connected to prior to the reestablishment.","paragraph_zero_based":41835},{"literal_text_all_w_t_and_m_t":"sourcePhysCellId","paragraph_zero_based":41836},{"literal_text_all_w_t_and_m_t":"Set to the physical cell identity of the PCell the UE was connected to prior to the reestablishment.","paragraph_zero_based":41837},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41838},{"literal_text_all_w_t_and_m_t":"–VarSuccessHO-Report","paragraph_zero_based":41839},{"literal_text_all_w_t_and_m_t":"The UE variable VarSuccessHO-Report includes the successful handover information.","paragraph_zero_based":41840},{"literal_text_all_w_t_and_m_t":"VarSccessHO-Report variable","paragraph_zero_based":41841},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":41842},{"literal_text_all_w_t_and_m_t":"-- TAG-VARSUCCESSHO-Report-START","paragraph_zero_based":41843},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41844},{"literal_text_all_w_t_and_m_t":"VarSuccessHO-Report-r17-IEs ::= SEQUENCE {","paragraph_zero_based":41845},{"literal_text_all_w_t_and_m_t":"    successHO-Report-r17            SuccessHO-Report-r17,","paragraph_zero_based":41846},{"literal_text_all_w_t_and_m_t":"    plmn-IdentityList-r17           PLMN-IdentityList2-r16","paragraph_zero_based":41847},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":41848},{"literal_text_all_w_t_and_m_t":"-- TAG-VARSUCCESSHO-Report-STOP","paragraph_zero_based":41849},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":41850},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41851},{"literal_text_all_w_t_and_m_t":"–End of NR-UE-Variables","paragraph_zero_based":41852},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":41853},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41854},{"literal_text_all_w_t_and_m_t":"END","paragraph_zero_based":41855}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["b5ab2f255fe72f7e8ff46048dc3196268e483462ea7ddf16bcd3d795f3a8520e","e95a767da0467e66a1abf241a96f65c621b2889fa9a1332c1bdc6d6bcf2386f9","a9b3790445153ce31414c63d32ca89c689a3a140e57d3b4e1c6551b741012a05","0a402dfba7c939539a9680d321d370974b884ec841c980b2d9657570a7e80e6d","f6b1f4fc8178106f19866c6ae053dcabc9c42bd4f8d6ad4429563c5fdc3b9a58","30d3f664d0b9c558a8cc06ee4ff00202dbc46ef3349b962fdb8baa253208d3c0","e19511b68e3f4498a3deb339855ad172a9a7e5cdda6887cb89fe7feee27899d8","f93e8657429b04069429cc8d688e2546818cfbfc97f2e720447045fce3ccb6a0","33882b08a3c4bacbedf20101bba1422b6058e342ae8ebd2a8567459747a27811","17695622ab7c9a8af460db4016973cea0dafc9ed30404ca73b68b99a50e6d131","6ecd3328c2612d46a0956318e25f76f36cee3ec8591c43ff2043567b90cd4c9b","b53ff387ffb2adef8e3eea4d47e3af8339749922cc5b966311489756008a4bfe","372482339c37254e8aaff3b67cb7467b5e5d0a3c14cf896983fcefee861a8bfb","66bfe3c96273073d53ced1a39cdff1b857c4e0079f215264541978f8f690102d","2dd59b7e519086d7da7a51f15f1465cb1476b890b174d377028632e4aa7c52c5","7d0c2372735c0f734077485df1c0ad45d1b287c1b2ae82416238d21866ecf720","f2b4944dc90ebd2b06ba6f735006306d5daead9218119fb42dab13136131ad79","7592152747db299a90c7b76d1427fb966ccef7a218037ebcb67fa36067a40cab","2de9d453a8a2d39832fae15fcc3b815e51a2eb207ad36c790bd933d203a8d9c5","c01b1f08d5a1d42ecb3677502092feeb18040334f34d3be2faf5277d8b0768c3","ba2bc14b3d909ab075a85565707c52a3a835d3c6675ff1a82718b5a7f17edbff","a20059b52713a833dd96fdc405bc95d5561dcc5611c65eb5786f6195c38071ea","7d17c07ec55c453c0a4ab14860d40e1bb683c65caf7ebd7efd2a60a921ac784c","c260232354ba982581e4271e2b421ff77594120466ebe1b22df5e99dc6af5f60"],"paragraph_range_zero_based":[41832,41855],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p41832"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41856},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":41857},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41858},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41859},{"literal_text_all_w_t_and_m_t":"8Protocol data unit abstract syntax","paragraph_zero_based":41860},{"literal_text_all_w_t_and_m_t":"8.1General","paragraph_zero_based":41861},{"literal_text_all_w_t_and_m_t":"The RRC PDU contents in clause 6 and clause 10 are described using abstract syntax notation one (ASN.1) as specified in ITU-T Rec. X.680 [6] and X.681 [7]. Transfer syntax for RRC PDUs is derived from their ASN.1 definitions by use of Packed Encoding Rules, unaligned as specified in ITU-T Rec. X.691 [8].","paragraph_zero_based":41862},{"literal_text_all_w_t_and_m_t":"The following encoding rules apply in addition to what has been specified in X.691:","paragraph_zero_based":41863},{"literal_text_all_w_t_and_m_t":"-When a bit string value is placed in a bit-field as specified in 15.6 to 15.11 in X.691, the leading bit of the bit string value shall be placed in the leading bit of the bit-field, and the trailing bit of the bit string value shall be placed in the trailing bit of the bit-field;","paragraph_zero_based":41864},{"literal_text_all_w_t_and_m_t":"NOTE:The terms 'leading bit' and 'trailing bit' are defined in ITU-T Rec. X.680. When using the 'bstring' notation, the leading bit of the bit string value is on the left, and the trailing bit of the bit string value is on the right.","paragraph_zero_based":41865},{"literal_text_all_w_t_and_m_t":"-When decoding types constrained with the ASN.1 Contents Constraint (\"CONTAINING\"), automatic decoding of the contained type should not be performed because errors in the decoding of the contained type should not cause the decoding of the entire RRC message PDU to fail. It is recommended that the decoder first decodes the outer PDU type that contains the OCTET STRING or BIT STRING with the Contents Constraint, and then decodes the contained type that is nested within the OCTET STRING or BIT STRING as a separate step;","paragraph_zero_based":41866},{"literal_text_all_w_t_and_m_t":"-When decoding a) RRC message PDUs, b) BIT STRING constrained with a Contents Constraint, or c) OCTET STRING constrained with a Contents Constraint, PER decoders are required to never report an error if there are extraneous zero or non-zero bits at the end of the encoded RRC message PDU, BIT STRING or OCTET STRING.","paragraph_zero_based":41867},{"literal_text_all_w_t_and_m_t":"8.2Structure of encoded RRC messages","paragraph_zero_based":41868},{"literal_text_all_w_t_and_m_t":"An RRC PDU, which is the bit string that is exchanged between peer entities/across the radio interface contains the basic production as defined in X.691.","paragraph_zero_based":41869},{"literal_text_all_w_t_and_m_t":"RRC PDUs shall be mapped to and from PDCP SDUs (in case of DCCH) or RLC SDUs (in case of PCCH, BCCH or CCCH) upon transmission and reception as follows:","paragraph_zero_based":41870},{"literal_text_all_w_t_and_m_t":"-when delivering an RRC PDU as an PDCP SDU to the PDCP layer for transmission, the first bit of the RRC PDU shall be represented as the first bit in the PDCP SDU and onwards; and","paragraph_zero_based":41871},{"literal_text_all_w_t_and_m_t":"-when delivering an RRC PDU as an RLC SDU to the RLC layer for transmission, the first bit of the RRC PDU shall be represented as the first bit in the RLC SDU and onwards; and","paragraph_zero_based":41872},{"literal_text_all_w_t_and_m_t":"-upon reception of an PDCP SDU from the PDCP layer, the first bit of the PDCP SDU shall represent the first bit of the RRC PDU and onwards; and","paragraph_zero_based":41873},{"literal_text_all_w_t_and_m_t":"-upon reception of an RLC SDU from the RLC layer, the first bit of the RLC SDU shall represent the first bit of the RRC PDU and onwards.","paragraph_zero_based":41874},{"literal_text_all_w_t_and_m_t":"8.3Basic production","paragraph_zero_based":41875},{"literal_text_all_w_t_and_m_t":"The 'basic production' is obtained by applying UNALIGNED PER to the abstract syntax value (the ASN.1 description) as specified in X.691. It always contains a multiple of 8 bits.","paragraph_zero_based":41876},{"literal_text_all_w_t_and_m_t":"8.4Extension","paragraph_zero_based":41877},{"literal_text_all_w_t_and_m_t":"The following rules apply with respect to the use of protocol extensions:","paragraph_zero_based":41878},{"literal_text_all_w_t_and_m_t":"-A transmitter compliant with this version of the specification shall, unless explicitly indicated otherwise on a PDU type basis, set the extension part empty. Transmitters compliant with a later version may send non-empty extensions;","paragraph_zero_based":41879}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["f5bc9871953f5a5bfd91b61d70845f35d6133beb70cdfaccf90510461bad4fe2","1e6a3bc9be978f77c3fe076ed7ca481f8deb9bf496ac5e51c924b3bcae8e718c","ebe18f802013fe79382697f446b943ad10d4eb8512c5591af8d733cda050d34a","e73437af2832013e8cae5f4ee34015c37b52a1aabffb47f4d0d5c743618fead7","d87f016cae6c62cc7207e53b1ef03a1e901ebf03343a5230e24774fe501a4c6c","01843f833845955a8e3ad478b90b55017042c6e50535b43fb5e0a5316f5d4788","f7c171eae2596aa40ea81673b17b2969b843308564c0e7f2e40058a50a1baca7","6bba34a59fe132b9d7484f8e7e2da0c525a714932064e8556441f86cead928c4","f33b8e1451500b04314cea1131e525a761e807240f1efb9d36629da927226f55","6616a865be71c0699cb1645cecb4421affeea825d6f9416e8c492c2c332ba5e2","c93c2de39f6a20c337d0e0a8b03f825568aaafd9a8d7f69d5cd843ba42f37157","25fc1ddabbdc9c5f054dd0699e3c5021ed2094e096a5f41defee77d2cae5ca3d","ff6c78cf9b5035da0c4c83bcfa54cb43dd40b631bf0c566bb3306336f8944d2b","1bea2fa64ebc44cb041bc4d9e397a15e9751cc6a7b2eca66de3200ba7592fb73","b9fbb0c39e41e4a75177b4d5d8476cfa9125f26f50a98eea6b8946feb834c2ad","dbd103a98856964364c9f6de8f946dddb4f8c890e1ae93d31200efbb10f98d28","0b16ee371c05d554643e77fa4f89a7b07a2b43675d339925039124447113118b","c883af7e33c2a9eebe7412b44f72805174e080ecfb3423d453214e2d0ac74836","3eeefe208cbdcee0c66992c77b20dadb159fef10783b881a3e7f57fd8e62e781","e1af2e0cf1d765e97ab92194ffc8941a4c472c3d7dd31cf75e4c17e12cde46ad","12423361527c7b89a7d589fd1e1bbf5bc1ae8d1d999448528aab66ce00d591ff","db02109ed00cbcb9079d097d21fa6b14cab90a15fd988dfd21baa91443195696","4d636fcbaf2948460a792337aec7b1049bc2325b5cacaca788184fa47471fb61","f99455b2951c22e17e69ab255c50584f9be3fa689e1cf7b5fff5478062f81119"],"paragraph_range_zero_based":[41856,41879],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p41856"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-A transmitter compliant with this version of the specification shall set spare bits to zero.","paragraph_zero_based":41880},{"literal_text_all_w_t_and_m_t":"8.5Padding","paragraph_zero_based":41881},{"literal_text_all_w_t_and_m_t":"If the encoded RRC message does not fill a transport block, the RRC layer shall add padding bits. This applies to PCCH and BCCH.","paragraph_zero_based":41882},{"literal_text_all_w_t_and_m_t":"Padding bits shall be set to 0 and the number of padding bits is a multiple of 8.","paragraph_zero_based":41883},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41884},{"literal_text_all_w_t_and_m_t":"Figure 8.5-1: RRC level padding","paragraph_zero_based":41885},{"literal_text_all_w_t_and_m_t":"9Specified and default radio configurations","paragraph_zero_based":41886},{"literal_text_all_w_t_and_m_t":"Specified and default configurations are configurations of which the details are specified in the standard. Specified configurations are fixed while default configurations can be modified using dedicated signalling. The default value for the parameters not listed in following clauses shall be set such as the corresponding features are not configured, i.e. release or false unless explicitly stated otherwise.","paragraph_zero_based":41887},{"literal_text_all_w_t_and_m_t":"NOTE:The UE applies the default values specified in the field description of ASN.1 parameters only when the parent IE is present. Hence, the UE does not apply all default values in field descriptions when it applies the \"default radio configuration\" in accordance with this clause.","paragraph_zero_based":41888},{"literal_text_all_w_t_and_m_t":"9.1Specified configurations","paragraph_zero_based":41889},{"literal_text_all_w_t_and_m_t":"9.1.1Logical channel configurations","paragraph_zero_based":41890},{"literal_text_all_w_t_and_m_t":"9.1.1.1BCCH configuration","paragraph_zero_based":41891},{"literal_text_all_w_t_and_m_t":"Parameters","paragraph_zero_based":41892},{"literal_text_all_w_t_and_m_t":"Name","paragraph_zero_based":41893},{"literal_text_all_w_t_and_m_t":"Value","paragraph_zero_based":41894},{"literal_text_all_w_t_and_m_t":"Semantics description","paragraph_zero_based":41895},{"literal_text_all_w_t_and_m_t":"Ver","paragraph_zero_based":41896},{"literal_text_all_w_t_and_m_t":"SDAP configuration","paragraph_zero_based":41897},{"literal_text_all_w_t_and_m_t":"Not used","paragraph_zero_based":41898},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41899},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41900},{"literal_text_all_w_t_and_m_t":"PDCP configuration","paragraph_zero_based":41901},{"literal_text_all_w_t_and_m_t":"Not used","paragraph_zero_based":41902},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41903}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["9f1decf305a036b626b216b301aeed2f38a2420e43c43f4a04779825f21534d9","83cb79c9469b40b68a41897e75daedc2fbcba0ba66ca261aee583a940537ad17","3e121d7f2203740c832304f0af87d0e7b217b005ef94ad05ff2803098c583e00","e3e3301fdff57e81b960b0eafaf3a987a13710e2a89349479fc3894a479abf79","65ce50d7ec54dc436fd2c513fc4de498852434f9118c3aac6da342a916f4c3f1","6fb61f505bb233829ae6bb34474ea8b2971d9f6b129860f43c32628ff7ed7913","73e09df5c4c60ff102be6a4a2aae405d4b734df2564aa90758d2462673b82075","734cc2217fa7f9eec5b112afebd293a1fcae84c2bbfc3efc298a69dc46326b28","3cdfc907b5beed5cc59f6988c71d189c6abd3cfdd8b2708d1b1d8cd7b0a4765b","28ec7a41c90f807b5451f05ec788a3c977f7e6f61dd774499bb1718dab42b