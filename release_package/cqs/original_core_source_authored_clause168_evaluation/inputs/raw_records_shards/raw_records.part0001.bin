{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    dl-P0-PSFCH-r17            INTEGER (-202..24)                                                                 OPTIONAL    -- Need M","paragraph_zero_based":38760},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":38761},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":38762},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38763},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RESOURCEPOOL-STOP","paragraph_zero_based":38764},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":38765},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38766},{"literal_text_all_w_t_and_m_t":"SL-ZoneConfigMCR field descriptions","paragraph_zero_based":38767},{"literal_text_all_w_t_and_m_t":"sl-TransRange","paragraph_zero_based":38768},{"literal_text_all_w_t_and_m_t":"Indicates the communication range requirement for the corresponding sl-ZoneConfigMCR-Index. The unit is meter.","paragraph_zero_based":38769},{"literal_text_all_w_t_and_m_t":"sl-ZoneConfig","paragraph_zero_based":38770},{"literal_text_all_w_t_and_m_t":"Indicates the zone configuration for the corresponding sl-ZoneConfigMCR-Index.","paragraph_zero_based":38771},{"literal_text_all_w_t_and_m_t":"sl-ZoneConfigMCR-Index","paragraph_zero_based":38772},{"literal_text_all_w_t_and_m_t":"Indicates the codepoint of the communication range requirement field in SCI.","paragraph_zero_based":38773},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38774},{"literal_text_all_w_t_and_m_t":"SL-ResourcePool field descriptions","paragraph_zero_based":38775},{"literal_text_all_w_t_and_m_t":"dummy","paragraph_zero_based":38776},{"literal_text_all_w_t_and_m_t":"This field is not used in the specification. If received it shall be ignored by the UE.","paragraph_zero_based":38777},{"literal_text_all_w_t_and_m_t":"sl-Additional-MCS-Table","paragraph_zero_based":38778},{"literal_text_all_w_t_and_m_t":"Indicates the MCS table(s) additionally used in the resource pool. 64QAM table is (pre-)configured as default. Zero, one or two can be additionally (pre-)configured using the 256QAM and/or low-SE MCS tables. If two MCS tables are indicated, 256QAM MCS table is the 1st table and qam64lowSE MCS table is the 2nd table as specified in TS 38.214 [19], clause 8.1.3.1.","paragraph_zero_based":38779},{"literal_text_all_w_t_and_m_t":"sl-FilterCoefficient","paragraph_zero_based":38780},{"literal_text_all_w_t_and_m_t":"This field indicates the filtering coefficient for long-term measurement and reference signal power derivation used for sidelink open-loop power control.","paragraph_zero_based":38781},{"literal_text_all_w_t_and_m_t":"sl-InterUE-CoordinationConfig","paragraph_zero_based":38782},{"literal_text_all_w_t_and_m_t":"Indicates the configured sidelink inter-UE coordination parameters.","paragraph_zero_based":38783}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["7b9bc9416b83cfc3292e3ba7d8197e36858930763f50caf07ff75b59140d60b9","4381279f4f8faa3a7b1d5b9eca8fb6c3acffe11e1a5cf4d350089a242efbe899","a0fd7d6b8780c5a069b4926515e5410f0e7fede1bd0d2132c573f0c2be7f6a73","f699d2ed33d9a7998d2f2e634d9e1f43623aced47e05092b74263db9c9b9515b","dd399a23759ea19bab8163931f60077e2d8596fecf2a93aeef018b2cec333f65","25dcb51fc7c49fb26abfe1dbacd1588db4c39bc47eef5385144ea62e62e7a224","11b670a46dab660b76caf8aba2c18b9b7fc624bd703e8bba91e121c82c112f45","4e519a6e220df1d2b3673a501de1b3a1bfe6240523c193acf9f27be4f2f51fca","60b3304256f19852d4d97a5b3cebe54a15794a1bb814100a78c60b5e223683aa","75129b2b543ae821d61c1c1a212ec8538c30adf9182027cd7781b2c9579a3fa6","d6e1f645c7d036f910dd56c25dc5056a1ea3de03f8e8cedae6a5ed21cae62d49","2366ed04f9665176656c08ac768308814e1bd4950d0595d6f9e8dd924483a3a2","d19522bea12823b7ea56a204de2ebe4a113ce3f3950a278fad2aae156cf80bd7","a3d88ceb9497269d7255db342cae2101f21db6e6e87b5b865657abfe42687e5e","3dde5ea68961b6317456dd7740317a983b84b6e00c35152c063a80d862da7ee9","37c201f90fd2fb4cff72e88b59319f870fca68d3e29c3d7b0ba0c1dbd25751a3","f39c6a8aa0090384a9f7e88d31d997ccc909467103cfb3342cf83c36290cc9d5","ca0b0d6710093b0d49241fd201b54dc0c9e0499020ba1a9b2010a62423f8823f","ea66123db7d3290c59966815180373b6cd1daec03967c2cc29a49defedcad64a","67cd77dc196983df0393a9a75302139d41d204a356f4f96d567285c4b8ba4c45","d2a76689773ffb4e42b26ada8b6032bbe42d3717529ee8481e6cb0be5dd048a5","6eb5b775596132b5ff0c4ce1fe6d447a7afc8953fa274d1e0c638e9005f3a4be","a9f485ec704f8e2d4bc4517271a229f9d542f24ca7a93f1516bd43029e0a5bc7","9d57bd504f6ecef65f5a5e72034823a5e633dedc2f9065681d7e42e3b40e7f36"],"paragraph_range_zero_based":[38760,38783],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p38760"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-NumSubchannel","paragraph_zero_based":38784},{"literal_text_all_w_t_and_m_t":"Indicates the number of subchannels in the corresponding resource pool, which consists of contiguous PRBs only.","paragraph_zero_based":38785},{"literal_text_all_w_t_and_m_t":"sl-PBPS-CPS-Config","paragraph_zero_based":38786},{"literal_text_all_w_t_and_m_t":"Indicates the allowed resource allocation schemes of full sensing only, partial sensing only, random resource selection only, or any combination(s), and the related configuration for power saving resource allocation schemes. This field is absent for sl-TxPoolExceptional.","paragraph_zero_based":38787},{"literal_text_all_w_t_and_m_t":"sl-PreemptionEnable","paragraph_zero_based":38788},{"literal_text_all_w_t_and_m_t":"Indicates whether pre-emption is disabled or enabled in a resource pool. If the field is present and the value is pl1, pl2, and so on (but not enabled), it means that pre-emption is enabled and a priority level p_preemption is configured. If the field is present and the value is enabled, the pre-emption is enabled (but p_preemption is not configured) and pre-emption is applicable to all levels.","paragraph_zero_based":38789},{"literal_text_all_w_t_and_m_t":"sl-PriorityThreshold-UL-URLLC","paragraph_zero_based":38790},{"literal_text_all_w_t_and_m_t":"Indicates the threshold used to determine whether NR sidelink transmission is prioritized over uplink transmission of priority index 1 as specified in TS 38.213[13], clause 16.2.4.3, or whether PUCCH transmission carrying SL HARQ is prioritized over PUCCH transmission carrying UCI of priority index 1 if they overlap in time as specified in TS 38.213 [13], clause 9.2.5.0.","paragraph_zero_based":38791},{"literal_text_all_w_t_and_m_t":"sl-PriorityThreshold","paragraph_zero_based":38792},{"literal_text_all_w_t_and_m_t":"Indicates the threshold used to determine whether NR sidelink transmission is prioritized over uplink transmission of priority index 0 as specified in TS 38.213[13], clause 16.2.4.3, or whether PUCCH transmission carrying SL HARQ is prioritized over PUCCH transmission carrying UCI of priority index 0 if they overlap in time as specified in TS 38.213 [13], clause 9.2.5.0.","paragraph_zero_based":38793},{"literal_text_all_w_t_and_m_t":"sl-RB-Number","paragraph_zero_based":38794},{"literal_text_all_w_t_and_m_t":"Indicates the number of PRBs in the corresponding resource pool, which consists of contiguous PRBs only. The remaining RB cannot be used (See TS 38.214[19], clause 8).","paragraph_zero_based":38795},{"literal_text_all_w_t_and_m_t":"sl-StartRB-Subchannel","paragraph_zero_based":38796},{"literal_text_all_w_t_and_m_t":"Indicates the lowest RB index of the subchannel with the lowest index in the resource pool with respect to the lowest RB index of a SL BWP.","paragraph_zero_based":38797},{"literal_text_all_w_t_and_m_t":"sl-SubchannelSize","paragraph_zero_based":38798},{"literal_text_all_w_t_and_m_t":"Indicates the minimum granularity in frequency domain for the sensing for PSSCH resource selection in the unit of PRB.","paragraph_zero_based":38799},{"literal_text_all_w_t_and_m_t":"sl-SyncAllowed","paragraph_zero_based":38800},{"literal_text_all_w_t_and_m_t":"Indicates the allowed synchronization reference(s) which is (are) allowed to use the configured resource pool.","paragraph_zero_based":38801},{"literal_text_all_w_t_and_m_t":"sl-SyncConfigIndex","paragraph_zero_based":38802},{"literal_text_all_w_t_and_m_t":"Indicates the synchronisation configuration that is associated with a reception pool, by means of an index to the corresponding entry SL-SyncConfigList of in SIB12 for NR sidelink communication.","paragraph_zero_based":38803},{"literal_text_all_w_t_and_m_t":"sl-TDD-Configuration","paragraph_zero_based":38804},{"literal_text_all_w_t_and_m_t":"Indicates the TDD configuration associated with the reception pool of the cell indicated by sl-SyncConfigIndex.","paragraph_zero_based":38805},{"literal_text_all_w_t_and_m_t":"sl-ThreshS-RSSI-CBR","paragraph_zero_based":38806},{"literal_text_all_w_t_and_m_t":"Indicates the S-RSSI threshold for determining the contribution of a sub-channel to the CBR measurement. Value 0 corresponds to -112 dBm, value 1 to -110 dBm, value n to (-112 + n*2) dBm, and so on.","paragraph_zero_based":38807}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["3f7cc52847cdff139b413ab08f8d0f15b22bab5f44cf81162aaaee1da5bde21a","b0cddcd9086fd1b2e76a0c04b54ed1abb0731fad42905be4c80f6e271a76e234","623cc37e64617bd1fcb603a3af6d9d9175d966a9b1a2a1b6dc2cfcbefd71633d","513453af8e8f319a62d1dcd90c822f80490c7919ee429eed053630592eb749fd","20d300dc0a3ee58f74afc86d8a9b73153ad260cee272afc9af943562c6a4a81a","9a5ef2011211b1b817142e01788b690a5a7dadbd29521e6d58f78eb8f074ff6c","8f7ad7edee6583f7ec80289f1a8e07fe326a05ff0397503bfcc672d0b9084e35","fa09e3b38ea7444d9707251b3c5478078a0eb41bfc4651f3cda8a622e0201ff6","815eb65585f16d1fc23c345cde7e93a29c3a90370e16a63a25b3fc567b084710","b759eefb7d33a89a2c2d1d4e0b184de0983529cf88294eadc787ccc530d58ff2","1d7f202fb43dd68515f933d486c1c02392d9289b1e0c3a24578863bebda8655e","15552cef8797edec6f9e5dba751a05ea92c5af943e0cdc6f626255433c3a8db4","c6c7bbf9c206049fc1ebb004ea147ab1d3e297263d33a99aa7f415dabb0f3bb0","a62a29dac64d761e8279ea3f50829e45f14412a080f0cfc17d0b672542408f83","9fa810f9d8ded435ef14805eefeec5a2457199dd233c73b3570807e82ed669c9","b65c223651351abc9aed620c748ad51df4a40ec32305bed77262aa49767341cc","2dc1b720f536090d7a8c23de3fdbdf332205d7b88fa7aa0323cd31d71e4a27a4","248327018ae52be88a8e1cb0783112473548ff2810f1a2ecfd0069d161a67d84","91562cc3c6145cc075e0c205d86ad63d4272737a69a38c73ed1dc6ecb2c67100","0f4726baff7b2edc9c85d271098becb2c542f6ad2d5376de2d3c078f0f8ac227","85e98328294569eed3205a00615ecf0f66b22fa97c08a639cedf9115df9963db","99219764c87657715f757bd10cc4fb6fbdef8ad8f0ae2c1cfba2549c288278c8","2ba71746021805a93217933e58b28d93348125decff35dd9a607497529d37102","0b9ed2fc536c9b34e6a291002c201de89d509b08c2fb85f5a3594ad3ee93047c"],"paragraph_range_zero_based":[38784,38807],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p38784"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-TimeResource","paragraph_zero_based":38808},{"literal_text_all_w_t_and_m_t":"Indicates the bitmap of the resource pool, which is defined by repeating the bitmap with a periodicity during a SFN or DFN cycle.","paragraph_zero_based":38809},{"literal_text_all_w_t_and_m_t":"sl-TimeWindowSizeCBR","paragraph_zero_based":38810},{"literal_text_all_w_t_and_m_t":"Indicates the time window size for CBR measurement.","paragraph_zero_based":38811},{"literal_text_all_w_t_and_m_t":"sl-TimeWindowSizeCR","paragraph_zero_based":38812},{"literal_text_all_w_t_and_m_t":"Indicates the time window size for CR evaluation.","paragraph_zero_based":38813},{"literal_text_all_w_t_and_m_t":"sl-TxPercentageList","paragraph_zero_based":38814},{"literal_text_all_w_t_and_m_t":"Indicates the portion of candidate single-slot PSSCH resources over the total resources. Value p20 corresponds to 20%, and so on.","paragraph_zero_based":38815},{"literal_text_all_w_t_and_m_t":"sl-X-Overhead","paragraph_zero_based":38816},{"literal_text_all_w_t_and_m_t":"Accounts for overhead from CSI-RS, PT-RS. If the field is absent, the UE applies value n0 (see TS 38.214 [19], clause 5.1.3.2).","paragraph_zero_based":38817},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38818},{"literal_text_all_w_t_and_m_t":"SL-SyncAllowed field descriptions","paragraph_zero_based":38819},{"literal_text_all_w_t_and_m_t":"gnbEnb-Sync","paragraph_zero_based":38820},{"literal_text_all_w_t_and_m_t":"If configured, the (pre-) configured resources can be used if the UE is directly or indirectly synchronized to eNB or gNB (i.e., synchronized to a reference UE which is directly synchronized to eNB or gNB).","paragraph_zero_based":38821},{"literal_text_all_w_t_and_m_t":"gnss-Sync","paragraph_zero_based":38822},{"literal_text_all_w_t_and_m_t":"If configured, the (pre-) configured resources can be used if the UE is directly or indirectly synchronized to GNSS (i.e., synchronized to a reference UE which is directly synchronized to GNSS).","paragraph_zero_based":38823},{"literal_text_all_w_t_and_m_t":"ue-Sync","paragraph_zero_based":38824},{"literal_text_all_w_t_and_m_t":"If configured, the (pre-) configured resources can be used if the UE is synchronized to a reference UE which is not synchronized to eNB, gNB and GNSS directly or indirectly.","paragraph_zero_based":38825},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38826},{"literal_text_all_w_t_and_m_t":"SL-PSCCH-Config field descriptions","paragraph_zero_based":38827},{"literal_text_all_w_t_and_m_t":"sl-FreqResourcePSCCH","paragraph_zero_based":38828},{"literal_text_all_w_t_and_m_t":"Indicates the number of PRBs for PSCCH in a resource pool where it is not greater than the number PRBs of the subchannel.","paragraph_zero_based":38829},{"literal_text_all_w_t_and_m_t":"sl-DMRS-ScrambleID","paragraph_zero_based":38830},{"literal_text_all_w_t_and_m_t":"Indicates the initialization value for PSCCH DMRS scrambling.","paragraph_zero_based":38831}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["026bf6eefd39ffd610e972a2ed02a14dd5f5899ff4edb79c3336b7cc833c560d","b88e943dd54b555b7d90e7290b2e1b0ae9f782cd96d7cbac750ff9de64ca98d2","cd138e2726965b9b24620b9bb69f2bb25e8529ffc8c160d73729e086121dceff","9354db2237c99e0b7aee698ed580a91b99045695ad6878e422a569bd0a242092","0ffc06c442f3cf51136b0383cd0273c13fe642f75a1fcc812197484fcf989c32","dd099cea714bf7815dd2b4ce6d35f742062e76849236dff16d64c7da319e5549","4d6db8ddcc42fa1b04dd6744170407eb6eac9287f8264178074643f