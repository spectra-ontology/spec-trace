":19434},{"literal_text_all_w_t_and_m_t":"beamMeasConfigIdle","paragraph_zero_based":19435},{"literal_text_all_w_t_and_m_t":"Indicates the beam level measurement configuration.","paragraph_zero_based":19436},{"literal_text_all_w_t_and_m_t":"carrierFreq","paragraph_zero_based":19437},{"literal_text_all_w_t_and_m_t":"Indicates the NR carrier frequency to be used for measurements during RRC_IDLE or RRC_INACTIVE.","paragraph_zero_based":19438},{"literal_text_all_w_t_and_m_t":"carrierFreqEUTRA","paragraph_zero_based":19439}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["813b12bcfade8c61c7a49f77862c5a175c668a52c9f3380d1035df0d3c1d27ae","419e61f295b43b9a65ca08aa551da22ebd1de2ae44175400a30affecc6577dd2","2f9f9953e994e98f5343ec69e0c93ceb9364c3074f9846a715a779967b119b27","63140aafe74de6b88af8a7565389a26db413388900965fd879a2bdbfb6d84a0b","c9848c82d25aaca294db6a7508b2b9c18fef025b387fb015c1f54ba87a1bbfa0","0ce6bc28db6a0cff95a1bbeef14bc878015d052c2a66a685a35594199cd802b5","2ca1aa87b9a91ddf39045ca4cab31bfe5aeda15f5914ac98de17185a662cff1d","2a61486da89aab18daf3b21532f9c78a451ac6ca5d0e0669c80679523322e892","ad0fcde5bbde2285ffbed8fa1eeb3e75d2507375664e1f3903c88da86ec009a1","561da72733c8d06bc25ad08d9d197c68d3c9f8666c07fac30f58552e921ee7ff","e8f88b4ce9e7d90625abef1f0164cf9b8ecc4e541b1919b3078cf15d07189a0d","00ec38992bcd2bb3c70ca51a2605f3eb302cde98960e624a89b37ffd50dd15f3","1e8e4a2bff1c3cca158b7fb84df0b7b56bd78fa8e7c6d5ccfdf23ba5ffab0f61","a472b37e839a373711248abe038c6afb9821c718127ebd034c38413dcc442763","a6cdafebbaabf5b4abd4709a9be7bc0d1482b5276d3010e4a37223a7f2d44d25","dc098254807f99a92049051d600cf608ec1385ea7fa2b8fe8becec3605ea5f99","a6d9aa6db5ab87d58f370b7e128394881074f6e03b854991e0ff9f9a1a481433","2b4e0fd9ef69af574800744a6ba19150f7a9f3468dcd0badb6c94748af537238","20245a3d2ab6111b90be65ff729d4a8ccdc7562f6aea17ae89622889e4e485fb","4b56205ad86f7a08eceacb55cc617f892e05e1fe36a352416ffca2041ad9e6ed","4f14e6e24333e52601c46b51a43958de903e2d199872a6b48c8023fd0f4e51ed","b6c6bbf4707fdea85e6209cc7dd704cd6197db204f3a726e489352d4daa75aed","fb2370f3fab54d339d7820405aed17bb6be99acf6c3603633b67fedd6367ae78","7f891416736892d85bb5c5a8118444284fa72f55ce83ef229b5e242ef888c119"],"paragraph_range_zero_based":[19416,19439],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p19416"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the E-UTRA carrier frequency to be used for measurements during RRC_IDLE or RRC_INACTIVE.","paragraph_zero_based":19440},{"literal_text_all_w_t_and_m_t":"deriveSSB-IndexFromCell","paragraph_zero_based":19441},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE may use the timing of any detected cell on that frequency to derive the SSB index of all neighbour cells on that frequency. If this field is set to true, the UE assumes SFN and frame boundary alignment across cells on the neighbor frequency as specified in TS 38.133 [14].","paragraph_zero_based":19442},{"literal_text_all_w_t_and_m_t":"frequencyBandList","paragraph_zero_based":19443},{"literal_text_all_w_t_and_m_t":"Indicates the list of frequency bands for which the NR idle/inactive measurement parameters apply. The UE shall select the first listed band which it supports in the frequencyBandList field to represent the NR neighbour carrier frequency.","paragraph_zero_based":19444},{"literal_text_all_w_t_and_m_t":"includeBeamMeasurements","paragraph_zero_based":19445},{"literal_text_all_w_t_and_m_t":"Indicates whether or not the UE shall include beam measurements in the NR idle/inactive measurement results.","paragraph_zero_based":19446},{"literal_text_all_w_t_and_m_t":"maxNrofRS-IndexesToReport","paragraph_zero_based":19447},{"literal_text_all_w_t_and_m_t":"Max number of beam indices to include in the idle/inactive measurement result.","paragraph_zero_based":19448},{"literal_text_all_w_t_and_m_t":"measCellListEUTRA","paragraph_zero_based":19449},{"literal_text_all_w_t_and_m_t":"Indicates the list of E-UTRA cells which the UE is requested to measure and report for idle/inactive measurements.","paragraph_zero_based":19450},{"literal_text_all_w_t_and_m_t":"measCellListNR","paragraph_zero_based":19451},{"literal_text_all_w_t_and_m_t":"Indicates the list of NR cells which the UE is requested to measure and report for idle/inactive measurements.","paragraph_zero_based":19452},{"literal_text_all_w_t_and_m_t":"measIdleCarrierListEUTRA","paragraph_zero_based":19453},{"literal_text_all_w_t_and_m_t":"Indicates the E-UTRA carriers to be measured during RRC_IDLE or RRC_INACTIVE.","paragraph_zero_based":19454},{"literal_text_all_w_t_and_m_t":"measIdleCarrierListNR","paragraph_zero_based":19455},{"literal_text_all_w_t_and_m_t":"Indicates the NR carriers to be measured during RRC_IDLE or RRC_INACTIVE.","paragraph_zero_based":19456},{"literal_text_all_w_t_and_m_t":"measIdleDuration","paragraph_zero_based":19457},{"literal_text_all_w_t_and_m_t":"Indicates the duration for performing idle/inactive measurements while in RRC_IDLE or RRC_INACTIVE. Value sec10 correspond to 10 seconds, value sec30 to 30 seconds and so on.","paragraph_zero_based":19458},{"literal_text_all_w_t_and_m_t":"nrofSS-BlocksToAverage","paragraph_zero_based":19459},{"literal_text_all_w_t_and_m_t":"Number of SS blocks to average for cell measurement derivation.","paragraph_zero_based":19460},{"literal_text_all_w_t_and_m_t":"qualityThreshold","paragraph_zero_based":19461},{"literal_text_all_w_t_and_m_t":"Indicates the quality thresholds for reporting the measured cells for idle/inactive NR measurements.","paragraph_zero_based":19462},{"literal_text_all_w_t_and_m_t":"qualityThresholdEUTRA","paragraph_zero_based":19463}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["df4b72faa0598d5fef65ad2f1c259491865933ff84d7a1aac1fb8a6b5a8feb13","983e4aa6415bb7c7ef75bac7f8ea234dd2707ee50d1803d62c2cf7eb1f9960f1","