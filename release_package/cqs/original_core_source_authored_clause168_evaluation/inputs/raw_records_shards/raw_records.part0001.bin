{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":23952},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23953},{"literal_text_all_w_t_and_m_t":"PUCCH-SpatialRelationInfoExt-r16 ::=       SEQUENCE {","paragraph_zero_based":23954},{"literal_text_all_w_t_and_m_t":"    pucch-SpatialRelationInfoId-v1610         PUCCH-SpatialRelationInfoId-v1610                              OPTIONAL,   -- Need S","paragraph_zero_based":23955},{"literal_text_all_w_t_and_m_t":"    pucch-PathlossReferenceRS-Id-v1610        PUCCH-PathlossReferenceRS-Id-v1610                             OPTIONAL,    --Need R","paragraph_zero_based":23956},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":23957},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":23958},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23959},{"literal_text_all_w_t_and_m_t":"PUCCH-SRS ::=                       SEQUENCE {","paragraph_zero_based":23960},{"literal_text_all_w_t_and_m_t":"    resource                            SRS-ResourceId,","paragraph_zero_based":23961},{"literal_text_all_w_t_and_m_t":"    uplinkBWP                           BWP-Id","paragraph_zero_based":23962},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":23963},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23964},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-SPATIALRELATIONINFO-STOP","paragraph_zero_based":23965},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23966},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23967},{"literal_text_all_w_t_and_m_t":"PUCCH-SpatialRelationInfo field descriptions","paragraph_zero_based":23968},{"literal_text_all_w_t_and_m_t":"pucch-PathLossReferenceRS-Id","paragraph_zero_based":23969},{"literal_text_all_w_t_and_m_t":"When pucch-PathLossReferenceRS-Id-v1610 is configured, the UE shall ignore pucch-PathLossReferenceRS-Id (without suffix).","paragraph_zero_based":23970},{"literal_text_all_w_t_and_m_t":"pucch-SpatialRelationInfoId","paragraph_zero_based":23971},{"literal_text_all_w_t_and_m_t":"When pucch-SpatialRelationInfoId-v1610 is configured, the UE shall ignore pucch-SpatialRelationInfoId (without suffix). If pucch-SpatialRelationInfoId-v1610 is absent, the UE shall use the pucch-SpatialRelationInfoId (without suffix).","paragraph_zero_based":23972},{"literal_text_all_w_t_and_m_t":"servingCellId","paragraph_zero_based":23973},{"literal_text_all_w_t_and_m_t":"If the field is absent, the UE applies the ServCellId of the serving cell in which this PUCCH-SpatialRelationInfo is configured","paragraph_zero_based":23974},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23975}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["a0abb09b8c9e3d36bda32596ef0cd3089280554873402ef157e1cb6bb2b0fc5b","82fc3314d600ed522b049dc6c11e8f056192b6778637b4d0bdee0bc912a54a38","eee588c6f0e59522af02f98a687ad81b9ec11f3ecc54a57c1d224149df0e7c36","886003faf814ab514aa4c3a228431bf9f4b0acbf04413173275060e16ba38ee3","41c6f1835c412dcb406783b4fc83bdb1995628ef97e29394a0ebde9db498778f","46109f1add9533246ce154749a5918ad90f7fdb04c80bdd2a910191c33341299","b38bb8dd453ead5b5a1370388e99a4a61d65b25a103c0b21b45e7393849f18ce","06d817f875cc1978bed9c3b9b53eeb2effd33931792d3438538e4019090a4a85","bccc05656d5298d6f361d6df7ec50f1fdcd2eae49622e295c03fe3015863555e","e45378d532b354815147c993ff2f01269f3382ee74c8d3e496fda2b8f6942db9","8c923757a7218fd65e21a753ee233e307b23400cf13a0a9d43a18b4dcd8187db","f71bee4fd1e0ee923757214fef11cdd4917714105917ec4f34a3a1d86762157b","3af165af2