{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>release musim-GapConfig from the UE Inactive AS context, if stored;","paragraph_zero_based":3696},{"literal_text_all_w_t_and_m_t":"1>release musim-LeaveAssistanceConfig from the UE Inactive AS context, if stored;","paragraph_zero_based":3697},{"literal_text_all_w_t_and_m_t":"1>release propDelayDiffReportConfig from the UE Inactive AS context, if stored;","paragraph_zero_based":3698},{"literal_text_all_w_t_and_m_t":"1>release ul-GapFR2-PreferenceConfig, if configured;","paragraph_zero_based":3699},{"literal_text_all_w_t_and_m_t":"1>release rrm-MeasRelaxationReportingConfig from the UE Inactive AS context, if stored;","paragraph_zero_based":3700},{"literal_text_all_w_t_and_m_t":"1>release uav-FlightPathAvailabilityConfig from the UE Inactive AS context, if stored;","paragraph_zero_based":3701},{"literal_text_all_w_t_and_m_t":"1>if the UE is acting as L2 U2N Remote UE:","paragraph_zero_based":3702},{"literal_text_all_w_t_and_m_t":"2>apply the specified configuration of SL-RLC0 used for the delivery of RRC message over SRB0 as specified in 9.1.1.4;","paragraph_zero_based":3703},{"literal_text_all_w_t_and_m_t":"2>apply the SDAP configuration and PDCP configuration as specified in 9.1.1.2 for SRB0;","paragraph_zero_based":3704},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":3705},{"literal_text_all_w_t_and_m_t":"2>apply the CCCH configuration as specified in 9.1.1.2;","paragraph_zero_based":3706},{"literal_text_all_w_t_and_m_t":"2>apply the timeAlignmentTimerCommon included in SIB1;","paragraph_zero_based":3707},{"literal_text_all_w_t_and_m_t":"1>if sdt-MAC-PHY-CG-Config is configured:","paragraph_zero_based":3708},{"literal_text_all_w_t_and_m_t":"2>if the resume procedure is initiated in a cell that is different to the PCell in which the UE received the stored sdt-MAC-PHY-CG-Config:","paragraph_zero_based":3709},{"literal_text_all_w_t_and_m_t":"3>release the stored sdt-MAC-PHY-CG-Config;","paragraph_zero_based":3710},{"literal_text_all_w_t_and_m_t":"3>instruct the MAC entity to stop the cg-SDT-TimeAlignmentTimer, if it is running;","paragraph_zero_based":3711},{"literal_text_all_w_t_and_m_t":"1>if ncd-SSB-RedCapInitialBWP-SDT is configured:","paragraph_zero_based":3712},{"literal_text_all_w_t_and_m_t":"2>if the resume procedure is initiated in a cell that is different to the PCell in which the UE received the stored ncd-SSB-RedCapInitialBWP-SDT:","paragraph_zero_based":3713},{"literal_text_all_w_t_and_m_t":"3>release the stored ncd-SSB-RedCapInitialBWP-SDT;","paragraph_zero_based":3714},{"literal_text_all_w_t_and_m_t":"1>if conditions for initiating SDT in accordance with 5.3.13.1b are fulfilled:","paragraph_zero_based":3715},{"literal_text_all_w_t_and_m_t":"2>consider the resume procedure is initiated for SDT;","paragraph_zero_based":3716},{"literal_text_all_w_t_and_m_t":"2>start timer T319a when the lower layers first transmit the CCCH message;","paragraph_zero_based":3717},{"literal_text_all_w_t_and_m_t":"2>consider SDT procedure is ongoing;","paragraph_zero_based":3718},{"literal_text_all_w_t_and_m_t":"1> else:","paragraph_zero_based":3719}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["e4aa795d6466dad4d395cec4632c293f4189451c6f5717cef180e6f0faf58c45","feaf772b6356118b27577f4e40a904577a37bd2e139f337a32a025f50f855499","83be6459f6bc94bdd638a5aab3dc311faf8b63dae5d43e7f4be2d238e65d570d","ab10661b19cc4ba3a79e0e462f050d058ec18c9558a2a8ce66be90b074c0e6a6","fb7659029586b2559cd5baca762ff6bff22f49b740192449dcc72a430dcb74e5","71a1c496507011641a474aaf4bfd1491393018d299dce62a60d2cac5bac8b5d5","60bd5b261a5e07b45b7166928441164f16c28bca09986ff2fc606d05a390bcea","9bc100b70d52bbf8e60cf215ba16e3f9844d9d732ae98608875e5bbfdbc9a7a5","297b377bf01c6d1ef0d5802d3007c01beda98ce1859aebb48daec3e9aefc9a8b","d788466b23162e4bc3b09404d9988bd9298ceb2abf7cce24c004bab16ee9933f","cf6e149aa55fe0ee62670e2e8f4b0446befea37a9dbf546837961debc922b460","8ea16c171468a946ad26f4d2028dbb4738d63f2589429813464634683108e029","fc99d2dd5fc99d3897e634c0ff8d24faf0314a816d920f6099b90bcbfe927fe1","8b1d5b8e545872eaa76f492ce9dc86edc65169f90f6043e61da30acfbfde5838","c6b93a54c2e5bc8c7b2c84fee5c6863687cbee1cd17b55a9e8f86e8edab06c6f","71e8060ed3fdd127b3e0a280ba14a695f5dda8d942230d4ad7de9df9bb2fb6c7","f1d293c9ea531a7d3d32bd9bc14c725f16d4c6c28dd7ec7814fc9ea8453ce425","ca0ed649bda350a1614b0a67f29c678ce748d764feeff48e38fb62869cfde290","8bb5cd38fef6e411ca6b04097f47601a2bab7caa542a8df2bd9a29da69d7d6dd","0befb215b40c2158cd31a353ab51641bcaf2fda7d5f9448111c55077ec5b9371","563e4be7a06a890ff614a2f6efc0f22a9f650d98a7d847b9a02f534dcf55648b","f4a42d9434a9e051134a46a1f6452204ddc65e9d90e733e0cae788095c174931","c2bb0bf23f66ecf576e4888966724488b85a1dc42d146afb1ce985531515f7a5","edd7ef43085e643ded5cbc03ae80046a4b2225ff1c4226eb9f44fb35422b27e5"],"paragraph_range_zero_based":[3696,3719],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p3696"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>start timer T319;","paragraph_zero_based":3720},{"literal_text_all_w_t_and_m_t":"2>instruct the MAC entity to stop the cg-SDT-TimeAlignmentTimer, if it is running;","paragraph_zero_based":3721},{"literal_text_all_w_t_and_m_t":"1>if ta-Report is configured with value enabled and the UE supports TA reporting:","paragraph_zero_based":3722},{"literal_text_all_w_t_and_m_t":"2>indicate TA report initiation to lower layers;","paragraph_zero_based":3723},{"literal_text_all_w_t_and_m_t":"1>set the variable pendingRNA-Update to false;","paragraph_zero_based":3724},{"literal_text_all_w_t_and_m_t":"1>release successHO-Config from the UE Inactive AS context, if stored;","paragraph_zero_based":3725},{"literal_text_all_w_t_and_m_t":"1>initiate transmission of the RRCResumeRequest message or RRCResumeRequest1 in accordance with 5.3.13.3.","paragraph_zero_based":3726},{"literal_text_all_w_t_and_m_t":"5.3.13.3Actions related to transmission of RRCResumeRequest or RRCResumeRequest1 message","paragraph_zero_based":3727},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of RRCResumeRequest or RRCResumeRequest1 message as follows:","paragraph_zero_based":3728},{"literal_text_all_w_t_and_m_t":"1>if field useFullResumeID is signalled in SIB1:","paragraph_zero_based":3729},{"literal_text_all_w_t_and_m_t":"2>select RRCResumeRequest1 as the message to use;","paragraph_zero_based":3730},{"literal_text_all_w_t_and_m_t":"2>set the resumeIdentity to the stored fullI-RNTI value;","paragraph_zero_based":3731},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":3732},{"literal_text_all_w_t_and_m_t":"2>select RRCResumeRequest as the message to use;","paragraph_zero_based":3733},{"literal_text_all_w_t_and_m_t":"2>set the resumeIdentity to the stored shortI-RNTI value;","paragraph_zero_based":3734},{"literal_text_all_w_t_and_m_t":"1>restore the RRC configuration, RoHC state, the EHC context(s), the UDC state, the stored QoS flow to DRB mapping rules and the KgNB and KRRCint keys from the stored UE Inactive AS context except for the following:","paragraph_zero_based":3735},{"literal_text_all_w_t_and_m_t":"-masterCellGroup;","paragraph_zero_based":3736},{"literal_text_all_w_t_and_m_t":"-mrdc-SecondaryCellGroup, if stored; and","paragraph_zero_based":3737},{"literal_text_all_w_t_and_m_t":"-pdcp-Config;","paragraph_zero_based":3738},{"literal_text_all_w_t_and_m_t":"1>set the resumeMAC-I to the 16 least significant bits of the MAC-I calculated:","paragraph_zero_based":3739},{"literal_text_all_w_t_and_m_t":"2>over the ASN.1 encoded as per clause 8 (i.e., a multiple of 8 bits) VarResumeMAC-Input;","paragraph_zero_based":3740},{"literal_text_all_w_t_and_m_t":"2>with the KRRCint key in the UE Inactive AS Context and the previously configured integrity protection algorithm; and","paragraph_zero_based":3741},{"literal_text_all_w_t_and_m_t":"2>with all input bits for COUNT, BEARER and DIRECTION set to binary ones;","paragraph_zero_based":3742},{"literal_text_all_w_t_and_m_t":"1>derive the KgNB key based on the current KgNB key or the NH, using the nextHopChainingCount value received in the previous RRCRelease message and stored in the UE Inactive AS Context, as specified in TS 33.501 [11];","paragraph_zero_based":3743}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["6d96b510631c4f013e86f08d9d3887558773419796bc06584f445c4c3a138d93","9a9d55b3b0ab160735963c0f44afd21bf291eb8ba277b030fb1e174cc85704b6","901f19736564b9856bd0bf14c000ff82e994fc6c0de52f9f81ba958ee548d60a","c7a830a059e088801903dc9907de49dec1b9abd770708d35a5dee8029acbe1b2","a6723d5ea1c6dfed7ad791c1e171034fed1d43cd51a826b1b1e64a3326f426b7","3f179acb3fd8bcefac9b36815edf596c9dc19ec4de547b370b6143cf785a8f1e","b54cbde1f69c858344c7aba6d1c907d1f3c4ddac7267df2f89fd4393f830a362","d60eb330b87a95abfbfcd90a80197ea0d8cd26b0d709475fde8097da9e0cd33f","3662027ed3b7406b7bbcc6471ce3a0831e876f3ac38de67ac294c08ff2b55a11","d994a8754fdcb0ae3db4993f9d51bed492e61a612b351fb4525966e17f463376","4ccdaa694e52d513a6d7648e6bed206820d09265584342730f6ba5986715084f","ff7baa2d66a5eeb201610752d8b284929fd9cbd2ff0b31277a64c64617c67791","a8fb127fe2f402da69dbd292c74a202858fdef5cd4fb7749773c917bd73af11f","39f4722e0ffdee736a2ffd51fe91cbf47affb3ce06b1bedb05be218d41340412","e9cdececb1a396a830f72ec71eeb9a85671c9a235ed11c29194d4484c508b71d","dd672e45fd4867e43e2f58ecbd2cf0105dec817c81670fb5b44787cae91cfebc","922f4bfcca7430e41f571b9cf848507204e03b22db98f1b8c7e33b76d07cab4a","be29fefe4206c8855c2dd369f42af5e24d642134e1bc3aec4c5547456fa55cd7","77536873a3df621e6e5476a26416298558fa0e29e4dfb05c6d8585ed1566db45","fce240f2ab362b800a155559e2c76186b98f5a263f217cc33138f0f9af5cbcc9","996bae8d2ce482d345a083bbc1a01ee0072080d2b8fb1767c716f7542c3e0b2a","c0a79ffb90d33136282705ee7ecc94f6c9f60682fc9dea91bf33e8087d0da6f2","244bdc323f1ba1bc430a555fc6be570bcff7537deb2d740400c40787e63ff414","cdc7738d459e61a57db478e6d7a10aa32d2190aeb9d7255705f32dd5f8716cee"],"paragraph_range_zero_based":[3720,3743],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p3720"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>derive the KRRCenc key, the KRRCint key, the KUPint key and the KUPenc key;","paragraph_zero_based":3744},{"literal_text_all_w_t_and_m_t":"1>configure lower layers to apply integrity protection for all radio bearers except SRB0 and MRBs using the configured algorithm and the KRRCint key and KUPint key derived in this clause immediately, i.e., integrity protection shall be applied to all subsequent messages received and sent by the UE;","paragraph_zero_based":3745},{"literal_text_all_w_t_and_m_t":"NOTE 1:Only DRBs with previously configured UP integrity protection shall resume integrity protection.","paragraph_zero_based":3746},{"literal_text_all_w_t_and_m_t":"1>configure lower layers to apply ciphering for all radio bearers except SRB0 and MRBs and to apply the configured ciphering algorithm, the KRRCenc key and the KUPenc key derived in this clause, i.e. the ciphering configuration shall be applied to all subsequent messages received and sent by the UE;","paragraph_zero_based":3747},{"literal_text_all_w_t_and_m_t":"1>re-establish PDCP entities for SRB1;","paragraph_zero_based":3748},{"literal_text_all_w_t_and_m_t":"1>resume SRB1;","paragraph_zero_based":3749},{"literal_text_all_w_t_and_m_t":"1>if the resume procedure is initiated for SDT:","paragraph_zero_based":3750},{"literal_text_all_w_t_and_m_t":"2>for each radio bearer that is configured for SDT and for SRB1:","paragraph_zero_based":3751},{"literal_text_all_w_t_and_m_t":"3>restore the RLC-BearerConfig associated with the RLC bearers of masterCellGroup and pdcp-Config from the UE Inactive AS context;","paragraph_zero_based":3752},{"literal_text_all_w_t_and_m_t":"3>if the radio bearer is a DRB configured with Ethernet Header Compression:","paragraph_zero_based":3753},{"literal_text_all_w_t_and_m_t":"4>indicate to lower layer that ethernetHeaderCompression is not configured;","paragraph_zero_based":3754},{"literal_text_all_w_t_and_m_t":"3>if the radio bearer is a DRB configured with UDC:","paragraph_zero_based":3755},{"literal_text_all_w_t_and_m_t":"4>indicate to lower layer that uplinkDataCompression is not configured;","paragraph_zero_based":3756},{"literal_text_all_w_t_and_m_t":"3>if the radio bearer is a DRB configured with ROHC function:","paragraph_zero_based":3757},{"literal_text_all_w_t_and_m_t":"4>if sdt-DRB-ContinueROHC is set to cell and the resume procedure is initiated in a cell that is the same as the PCell in which the UE received the previous RRCRelease message; or","paragraph_zero_based":3758},{"literal_text_all_w_t_and_m_t":"4>if sdt-DRB-ContinueROHC is set to rna and the resume procedure is initiated in a cell belonging to the same RNA as the PCell in which the UE received the previous RRCRelease message:","paragraph_zero_based":3759},{"literal_text_all_w_t_and_m_t":"5>indicate to lower layer that drb-continueROHC is configured;","paragraph_zero_based":3760},{"literal_text_all_w_t_and_m_t":"4>else:","paragraph_zero_based":3761},{"literal_text_all_w_t_and_m_t":"5>indicate to lower layer that drb-continueROHC is not configured;","paragraph_zero_based":3762},{"literal_text_all_w_t_and_m_t":"3>re-establish PDCP entity for the radio bearer that is configured for SDT without triggering PDCP status report;","paragraph_zero_based":3763},{"literal_text_all_w_t_and_m_t":"2>resume all the radio bearers that are configured for SDT;","paragraph_zero_based":3764},{"literal_text_all_w_t_and_m_t":"1>submit the selected message RRCResumeRequest or RRCResumeRequest1 for transmission to lower layers.","paragraph_zero_based":3765},{"literal_text_all_w_t_and_m_t":"NOTE 2:Only DRBs with previously configured UP ciphering shall resume ciphering.","paragraph_zero_based":3766},{"literal_text_all_w_t_and_m_t":"If lower layers indicate an integrity check failure while T319 is running or SDT procedure is ongoing, perform actions specified in 5.3.13.5.","paragraph_zero_based":3767}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["011f0bb3710b9ccae98f638d2851d4bf927fe500e40619448dd833c71c127e2e","85a620cc7af5d060a55644b249d4437aa39f7e8ce6f6c90fa91bbed0a713d1b9","eae748f547536a6135fd6abc2afcf9cbaf53a8c0b33c435b0029c95d3278f811","25823a99e67ae212338765c6209ea956b48399687bb926866e740250a767e56a","a78d51617e9dc46dca70450a850aa7f4bce8b6c1eb655e0c449bc89596e9f263","6e8f9e9f438199dd501ebff06db7e9af8b6b0d04fdd6423c3e529d41f58f8ecb","4dc95bef6db34f53d9da997a86cd54871dadac400a9fc3bcfea7649dc66b9545","88913b60f66389d77375050a57f5b57554640043a8a61367f39a23ce483ef506","0d044ccdc4362b744db87b036b264a0fd99e265b4755a98c2b192ab82f0ff371","f3a222a62fbaa43883a444f8c738701f8655b29696ff65d5370b88bc9b14eba1","6dc332a36f5f55586c1496df17113c0168ba233f954ae62ed24e921749adb46a","3aeaa68f8511bc6b232e06f0939e0ed5441c9b69e13c72d569a3a21ca04c0592","56524cd6083b8d29ae5bd3a90b4c7e34e7018fc719c2f5c1759009a160ab431a","b548763830fa4f4748fca066800c21050a9beff189a86e48d6cd3e2068019402","d9fdd1d108c7ea48e1e9ae2d6b502e2968e9c16ba560c58ef21a434cf2189f98","61a57a634df0691e9134c66548a4c90f686fe9aae752e6a180d1ca9701e7a6b1","78e2c091e9ec3179c4162b3f010c8495ddcb76cb9b30e97feb7c45d68755c927","00499db77754a840c7ebaf2f4fab287300d834e7699ffca896c6dfac06799300","18c134160026483670df6a57c3c40f8cd3b7c45f5123cde1ebdf1d82ad778f74","965d222a67fd0f69672a5b6b34fa737f70d83fbb3ac913d99d521471b25b8610","b2b08a884b7f6712263c5ffcd3594595439d20829b09c5d1a5d74aed71177e21","7ce0797c43c6076b7fdffb2cbfa2c8063a38218008e2f589beb957e38a2c14d1","c34a99b9ea6a0e38b6e6e4b83a7ce10fe33ffd0433ad2e53cbdd1a7eb34503a1","d15d08866620c02b435bd034a5b5981d9af030f5db2051f9d2887b448d05b09b"],"paragraph_range_zero_based":[3744,3767],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p3744"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"If the UE is a RedCap UE and the RedCap-specific initial downlink BWP is not associated with CD-SSB, the UE may continue cell re-selection related measurements as well as cell re-selection evaluation, otherwise the UE shall continue cell re-selection related measurements as well as cell re-selection evaluation. If the conditions for cell re-selection are fulfilled, the UE shall perform cell re-selection as specified in 5.3.13.6.","paragraph_zero_based":3768},{"literal_text_all_w_t_and_m_t":"NOTE 3:For L2 U2N Remote UE in RRC_INACTIVE, the cell (re)selection procedure as specified in TS 38.304 [20] and relay (re)selection procedure as specified in 5.8.15.3 are performed independently and it is up to UE implementation to select either a cell or a L2 U2N Relay UE.","paragraph_zero_based":3769},{"literal_text_all_w_t_and_m_t":"5.3.13.4Reception of the RRCResume by the UE","paragraph_zero_based":3770},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":3771},{"literal_text_all_w_t_and_m_t":"1>stop timer T319, if running;","paragraph_zero_based":3772},{"literal_text_all_w_t_and_m_t":"1>stop timer T319a, if running and consider SDT procedure is not ongoing;","paragraph_zero_based":3773},{"literal_text_all_w_t_and_m_t":"1>stop timer T380, if running;","paragraph_zero_based":3774},{"literal_text_all_w_t_and_m_t":"1>if T331 is running:","paragraph_zero_based":3775},{"literal_text_all_w_t_and_m_t":"2>stop timer T331;","paragraph_zero_based":3776},{"literal_text_all_w_t_and_m_t":"2>perform the actions as specified in 5.7.8.3;","paragraph_zero_based":3777},{"literal_text_all_w_t_and_m_t":"1>if the RRCResume includes the fullConfig:","paragraph_zero_based":3778},{"literal_text_all_w_t_and_m_t":"2>perform the full configuration procedure as specified in 5.3.5.11;","paragraph_zero_based":3779},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":3780},{"literal_text_all_w_t_and_m_t":"2>if the RRCResume does not include the restoreMCG-SCells:","paragraph_zero_based":3781},{"literal_text_all_w_t_and_m_t":"3>release the MCG SCell(s) from the UE Inactive AS context, if stored;","paragraph_zero_based":3782},{"literal_text_all_w_t_and_m_t":"2>if the RRCResume does not include the restoreSCG:","paragraph_zero_based":3783},{"literal_text_all_w_t_and_m_t":"3>release the MR-DC related configurations (i.e., as specified in 5.3.5.10) from the UE Inactive AS context, if stored;","paragraph_zero_based":3784},{"literal_text_all_w_t_and_m_t":"2>restore the masterCellGroup, mrdc-SecondaryCellGroup, if stored, and pdcp-Config from the UE Inactive AS context;","paragraph_zero_based":3785},{"literal_text_all_w_t_and_m_t":"2>configure lower layers to consider the restored MCG and SCG SCell(s) (if any) to be in deactivated state;","paragraph_zero_based":3786},{"literal_text_all_w_t_and_m_t":"1>discard the UE Inactive AS context;","paragraph_zero_based":3787},{"literal_text_all_w_t_and_m_t":"1>store the used nextHopChainingCount value associated to the current KgNB;","paragraph_zero_based":3788},{"literal_text_all_w_t_and_m_t":"1>if sdt-MAC-PHY-CG-Config is configured:","paragraph_zero_based":3789},{"literal_text_all_w_t_and_m_t":"2>instruct the MAC entity to stop the cg-SDT-TimeAlignmentTimer, if it is running;","paragraph_zero_based":3790},{"literal_text_all_w_t_and_m_t":"2>instruct the MAC entity to start the timeAlignmentTimer associated with the PTAG, if it is not running;","paragraph_zero_based":3791}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML