aph_zero_based":3059},{"literal_text_all_w_t_and_m_t":"3>release onDemandSIB-Request if configured, and stop timer T350, if running;","paragraph_zero_based":3060},{"literal_text_all_w_t_and_m_t":"3>release referenceTimePreferenceReporting, if configured;","paragraph_zero_based":3061},{"literal_text_all_w_t_and_m_t":"3>release sl-AssistanceConfigNR, if configured;","paragraph_zero_based":3062},{"literal_text_all_w_t_and_m_t":"3>release obtainCommonLocation, if configured;","paragraph_zero_based":3063},{"literal_text_all_w_t_and_m_t":"3>release scg-DeactivationPreferenceConfig, if configured, and stop timer T346i, if running;","paragraph_zero_based":3064},{"literal_text_all_w_t_and_m_t":"3>release musim-GapAssistanceConfig, if configured and stop timer T346h, if running;","paragraph_zero_based":3065},{"literal_text_all_w_t_and_m_t":"3>release musim-LeaveAssistanceConfig, if configured;","paragraph_zero_based":3066},{"literal_text_all_w_t_and_m_t":"3>release propDelayDiffReportConfig, if configured;","paragraph_zero_based":3067},{"literal_text_all_w_t_and_m_t":"3>release ul-GapFR2-PreferenceConfig, if configured;","paragraph_zero_based":3068},{"literal_text_all_w_t_and_m_t":"3>release rrm-MeasRelaxationReportingConfig, if configured;","paragraph_zero_based":3069},{"literal_text_all_w_t_and_m_t":"3>release maxBW-PreferenceConfigFR2-2, if configured;","paragraph_zero_based":3070},{"literal_text_all_w_t_and_m_t":"3>release maxMIMO-LayerPreferenceConfigFR2-2, if configured;","paragraph_zero_based":3071}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["d4d3a8b06cfc6e3af5e50f65e557f8d5ec77afb662412548fef36eecfa2cc4b2","a389895d2183d97d9a865dd3d8d7f4eefaa955b22d3308da4bf1b0e40