{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        carrierFreq                             ARFCN-ValueNR,","paragraph_zero_based":44160},{"literal_text_all_w_t_and_m_t":"        ssbSubcarrierSpacing                    SubcarrierSpacing,","paragraph_zero_based":44161},{"literal_text_all_w_t_and_m_t":"        ssb-MeasurementTimingConfiguration      SSB-MTC,","paragraph_zero_based":44162},{"literal_text_all_w_t_and_m_t":"        ss-RSSI-Measurement                     SS-RSSI-Measurement                             OPTIONAL","paragraph_zero_based":44163},{"literal_text_all_w_t_and_m_t":"    }                                                                                           OPTIONAL,","paragraph_zero_based":44164},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":44165},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":44166},{"literal_text_all_w_t_and_m_t":"    ssb-ToMeasure                           SSB-ToMeasure                                       OPTIONAL,","paragraph_zero_based":44167},{"literal_text_all_w_t_and_m_t":"    physCellId                              PhysCellId                                          OPTIONAL","paragraph_zero_based":44168},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":44169},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44170},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44171},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASUREMENT-TIMING-CONFIGURATION-STOP","paragraph_zero_based":44172},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44173},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44174},{"literal_text_all_w_t_and_m_t":"MeasTiming field descriptions","paragraph_zero_based":44175},{"literal_text_all_w_t_and_m_t":"carrierFreq, ssbSubcarrierSpacing","paragraph_zero_based":44176},{"literal_text_all_w_t_and_m_t":"Indicates the frequency and subcarrier spacing of the SS block of the cell for which this message is included, or of other SS blocks within the same carrier.","paragraph_zero_based":44177},{"literal_text_all_w_t_and_m_t":"ssb-MeasurementTimingConfiguration","paragraph_zero_based":44178},{"literal_text_all_w_t_and_m_t":"Indicates the SMTC which can be used to search for SSB of the cell for which the message is included. When the message is included in \"Served NR Cell Information\" (see TS 36.423 [37]), \"Served Cell Information NR\" (see TS 38.423 [35]), or \"Served Cell Information\" (see TS 38.473 [36]), the timing is based on the cell for which the message is included. When the message is included in \"NR Neighbour Information\" (see TS 36.423 [37]), or \"Served Cell Information\" (see TS 38.423 [35]), the timing is based on the cell indicated in the \"Served NR Cell Information\" or \"Served Cell Information NR\" with which the \"NR Neighbour Information\" or \"Neighbour Information NR\" is provided. When the message is included in \"CU to DU RRC Information\", the timing is based on the cell indicated by SpCell ID with which the message is included. If the field is provided by an NTN cell, the offset (derived from parameter periodicityAndOffset) is based on the assumption that the NTN payload to gNB propagation delay of the cell for which the message is included equals to 0 ms.","paragraph_zero_based":44179},{"literal_text_all_w_t_and_m_t":"ss-RSSI-Measurement","paragraph_zero_based":44180},{"literal_text_all_w_t_and_m_t":"Provides the configuration which can be used for RSSI measurements of the cell for which the message is included.","paragraph_zero_based":44181},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44182},{"literal_text_all_w_t_and_m_t":"MeasurementTimingConfiguration field descriptions","paragraph_zero_based":44183}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["7c0d2492a8872b1f98695c1206b81519d2b72ecfaa7c5343b1cf961d2fbc39fe","990c82e7bec43b273cb6bd30a868f7b06abacda896efbd2e05f3cac2ab68f5f1","273bd7c26d0a5f211af95c17df9c5860ae8bc9ee2dfdb3684e80e31e8e758099","98dedaa8514beaba88c6012c19c36f105462868ed94c98eef2698111dcda8e4d","715a4c606c03aacbfe18e7620a742eeccb7baf3444fb823398ca36ebb8865ca6","64d7db7bb9448a236e358cfe3c9548f8648126b5b75d0ebdf064f9f2950df142","5c45009e6ca486ebef9640d383106b42b08d78caf2cb8ed3eb251ce72158be88","623ee8ece7a4c2dd9fa5d5ed4e63486050556f1efe47931ba4924e5f53458bfd","16e2f1e167e009b14b2c347facefda77d12457b663cc92fe0472e57583236581","946c2195fef2702feab8147e8cf2cf556607898fce7a375500299bf811d01dc9","97afd39d700f0d385b258d45802b4ea3ec06faa3741bdd5024685121132116b4","45075339d3f79ebc1371a7fef33888442417c9348b7c1c8360cf70153ff75bb8","669f467174032e3ea086f37b881a43479d2bfbbc3a9bbb23ba50f3b468a8ef33","565eb92ed1eea9315fd0fc704672228081f2b2f890aaaee5124084ab247a9cf8","a8f784f3dde064a740d4428127eee4aab42ad45e45d3377dd17ef4fd5bd90f57","e8d472c121ec94f03e70dda419700f6ac370d1f7ef264ddd34b879afd180946c","3eb9e05f9ab1c5672538f671de4fe1399ce8d4903ee05d42fbdd6c6b5bf56675","8007f6a28edfbdde9404e9789f6143586a48895da0c2287717d29155ab56b25b","8fc38fc9abdcdf793620cafbb7af2e0369bff2ce4e7272de9c7da325bd2a65e7","9715efb4af0edad2827d7348f49e112866159ae9a7d7dc8e9023be51e8b5cbff","eb3569534c47be547d7667a542cfaa3cf64633c47a7bc6a732c2789f6633cc3a","0f941c31ff5244f4b6f4045cd10460e0468ad614ce3a4a9b75b075697bccb607","a0b5ee9833d17442dae4a1f167ee7a03cafd8612b0a1e2bb27d400a1e7b26de5","beb7d98af7efd2b770c1c7e15f588a2d3568052de0e5dabac9e686f5bdef6f68"],"paragraph_range_zero_based":[44160,44183],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a