{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ReestabUE-Identity field descriptions","paragraph_zero_based":9936},{"literal_text_all_w_t_and_m_t":"physCellId","paragraph_zero_based":9937},{"literal_text_all_w_t_and_m_t":"The Physical Cell Identity of the PCell the UE was connected to prior to the failure.","paragraph_zero_based":9938},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9939},{"literal_text_all_w_t_and_m_t":"RRCReestablishmentRequest-IEs field descriptions","paragraph_zero_based":9940},{"literal_text_all_w_t_and_m_t":"reestablishmentCause","paragraph_zero_based":9941},{"literal_text_all_w_t_and_m_t":"Indicates the failure cause that triggered the re-establishment procedure. gNB is not expected to reject a RRCReestablishmentRequest due to unknown cause value being used by the UE.","paragraph_zero_based":9942},{"literal_text_all_w_t_and_m_t":"ue-Identity","paragraph_zero_based":9943},{"literal_text_all_w_t_and_m_t":"UE identity included to retrieve UE context and to facilitate contention resolution by lower layers.","paragraph_zero_based":9944},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9945},{"literal_text_all_w_t_and_m_t":"–RRCReconfiguration","paragraph_zero_based":9946},{"literal_text_all_w_t_and_m_t":"The RRCReconfiguration message is the command to modify an RRC connection. It may convey information for measurement configuration, mobility control, radio resource configuration (including RBs, MAC main configuration and physical channel configuration) and AS security configuration.","paragraph_zero_based":9947},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1 or SRB3","paragraph_zero_based":9948},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":9949},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":9950},{"literal_text_