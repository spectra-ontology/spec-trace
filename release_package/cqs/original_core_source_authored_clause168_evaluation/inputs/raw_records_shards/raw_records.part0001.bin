{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>else if the uac-ACBarringListType indicates that uac-ImplicitACBarringList is used:","paragraph_zero_based":4032},{"literal_text_all_w_t_and_m_t":"4>select the uac-BarringInfoSetIndex corresponding to the Access Category in the uac-ImplicitACBarringList;","paragraph_zero_based":4033},{"literal_text_all_w_t_and_m_t":"4>if the uac-BarringInfoSetList contains the UAC-BarringInfoSet entry corresponding to the selected uac-BarringInfoSetIndex:","paragraph_zero_based":4034},{"literal_text_all_w_t_and_m_t":"5>select the UAC-BarringInfoSet entry;","paragraph_zero_based":4035},{"literal_text_all_w_t_and_m_t":"5>perform access barring check for the Access Category as specified in 5.3.14.5, using the selected UAC-BarringInfoSet as \"UAC barring parameter\";","paragraph_zero_based":4036},{"literal_text_all_w_t_and_m_t":"4>else:","paragraph_zero_based":4037},{"literal_text_all_w_t_and_m_t":"5>consider the access attempt as allowed;","paragraph_zero_based":4038},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":4039},{"literal_text_all_w_t_and_m_t":"4>consider the access attempt as allowed;","paragraph_zero_based":4040},{"literal_text_all_w_t_and_m_t":"1>if the access barring check was requested by upper layers:","paragraph_zero_based":4041},{"literal_text_all_w_t_and_m_t":"2>if the access attempt is considered as barred:","paragraph_zero_based":4042},{"literal_text_all_w_t_and_m_t":"3>if timer T302 is running:","paragraph_zero_based":4043},{"literal_text_all_w_t_and_m_t":"4>if timer T390 is running for Access Category '2':","paragraph_zero_based":4044},{"literal_text_all_w_t_and_m_t":"5>inform the upper layer that access barring is applicable for all access categories except categories '0', upon which the procedure ends;","paragraph_zero_based":4045},{"literal_text_all_w_t_and_m_t":"4>else","paragraph_zero_based":4046},{"literal_text_all_w_t_and_m_t":"5>inform the upper layer that access barring is applicable for all access categories except categories '0' and '2', upon which the procedure ends;","paragraph_zero_based":4047},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":4048},{"literal_text_all_w_t_and_m_t":"4>inform upper layers that the access attempt for the Access Category is barred, upon which the procedure ends;","paragraph_zero_based":4049},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":4050},{"literal_text_all_w_t_and_m_t":"3>inform upper layers that the access attempt for the Access Category is allowed, upon which the procedure ends;","paragraph_zero_based":4051},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":4052},{"literal_text_all_w_t_and_m_t":"2>the procedure ends.","paragraph_zero_based":4053},{"literal_text_all_w_t_and_m_t":"5.3.14.3Void","paragraph_zero_based":4054},{"literal_text_all_w_t_and_m_t":"5.3.14.4T302, T390 expiry or stop (Barring alleviation)","paragraph_zero_based":4055}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["634c9792cf7b4cbf29ebb662ae46a6bb4eb30259ebbb27705b2b0d3cb9d82814","fb86ebdbfb0f125e01e4c0ec6c05813c00af4ec3aefc43960ce9bcd547e9700d","afd9c84bd8c494b8b653dcf8699b804593514ae057a1e6df96d49481e9320388","2348ef60caeb581ca406b63729d812a217c3b80e88b135864424dff849389dd6","a83f10f60100030089cde28bf4c4647e40ff2da38db99ae56ab9e0e0ffcde712","6bdd1e439c2ad9b0d5d990f20934dc5a0539a99da2024d886ad8ffcde4da36e8","f2dd7ea1f0794cc61c213023ed4d6b8ec28fd84f67cce79f14d0dae3df15762f","49b5a3a33224b2888a03185070cf6f274102aec37c1972202991ef272fdd3837","55c17f86d25ddd13e7f5882a5936d7437f9f0763c4990b196b981b90b608300b","51ea58842ba835c9bfb55a34383262734e2f607271bd734d16adaa119607c188","e1b4cf409b06ca0a61f7d25ade3732548ce149973e2692cfec2a42d931d4bc45","365ffbba088efe1c898400b4e63aa329023ffe9b5c71a25426859616ceae1910","a2ce05ba750fe9058cda3143008b9d3ee1cf718472bf8ef4fafe5720e71ba4e6","b26203a65a8fe92aa2102377cf0dea6a5e0fc44102993a40f2517f92d4c3a01b","8196a2d110a4fe4737d6c1872a7894bb5bed47bff5da63fcd0e49da13cf2f1ef","4bbb3f934038207d62654e015537ccacaa3457eb10df1ed9ced4adeab4147344","1152c21d6711ee9ce7437d8b9fd03d64511050eb08d38c032275895f57abb0d7","6ee7a0e6f6a3b889091a44c9b74b1e984b8896951df6cc8d5c1e75cc6cf36380","6df4ede1852b23e081dce3925bf4f637ce7c9a30868b754c3f68e3828755b99e","c9ee1f160954fa76965b22a850649f9dd855b3305f7c8e3ca3778fa2ffe361f4","d3a52867546203993663c5b33594bac7b8e73caa63fb87a2059f0ebb9cb42462","4d700c7fb3c820927c2128be765fdd824913415ea0456ea4bce40c460b021799","19f9573488cd42d05a5a2021385deb8409fa1dfdf010e70f97767dfe86ce1e9f","9cf544d65a198171d4265d8f73772df612661be5b7ae6cf1b70f75330ae58292"],"paragraph_range_zero_based":[4032,4055],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p4032"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":4056},{"literal_text_all_w_t_and_m_t":"1>if timer T302 expires or is stopped:","paragraph_zero_based":4057},{"literal_text_all_w_t_and_m_t":"2>for each Access Category for which T390 is not running:","paragraph_zero_based":4058},{"literal_text_all_w_t_and_m_t":"3>consider the barring for this Access Category to be alleviated:","paragraph_zero_based":4059},{"literal_text_all_w_t_and_m_t":"1>else if timer T390 corresponding to an Access Category other than '2' expires or is stopped, and if timer T302 is not running:","paragraph_zero_based":4060},{"literal_text_all_w_t_and_m_t":"2>consider the barring for this Access Category to be alleviated;","paragraph_zero_based":4061},{"literal_text_all_w_t_and_m_t":"1>else if timer T390 corresponding to the Access Category '2' expires or is stopped:","paragraph_zero_based":4062},{"literal_text_all_w_t_and_m_t":"2>consider the barring for this Access Category to be alleviated;","paragraph_zero_based":4063},{"literal_text_all_w_t_and_m_t":"1>when barring for an Access Category is considered being alleviated:","paragraph_zero_based":4064},{"literal_text_all_w_t_and_m_t":"2>if the Access Category was informed to upper layers as barred:","paragraph_zero_based":4065},{"literal_text_all_w_t_and_m_t":"3>inform upper layers about barring alleviation for the Access Category.","paragraph_zero_based":4066},{"literal_text_all_w_t_and_m_t":"2>if barring is alleviated for Access Category '8'; or","paragraph_zero_based":4067},{"literal_text_all_w_t_and_m_t":"2>if barring is alleviated for Access Category '2':","paragraph_zero_based":4068},{"literal_text_all_w_t_and_m_t":"3>perform actions specified in 5.3.13.8;","paragraph_zero_based":4069},{"literal_text_all_w_t_and_m_t":"5.3.14.5Access barring check","paragraph_zero_based":4070},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":4071},{"literal_text_all_w_t_and_m_t":"1>if one or more Access Identities equal to 1, 2, 11, 12, 13, 14, or 15 are indicated according to TS 24.501 [23], and","paragraph_zero_based":4072},{"literal_text_all_w_t_and_m_t":"1>if for at least one of these Access Identities the corresponding bit in the uac-BarringForAccessIdentity contained in \"UAC barring parameter\" is set to zero:","paragraph_zero_based":4073},{"literal_text_all_w_t_and_m_t":"2>consider the access attempt as allowed;","paragraph_zero_based":4074},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":4075},{"literal_text_all_w_t_and_m_t":"2>if the establishment of the RRC connection is the result of release with redirect with mpsPriorityIndication (either in NR or E-UTRAN); and","paragraph_zero_based":4076},{"literal_text_all_w_t_and_m_t":"2>if the bit corresponding to Access Identity 1 in the uac-BarringForAccessIdentity contained in the \"UAC barring parameter\" is set to zero:","paragraph_zero_based":4077},{"literal_text_all_w_t_and_m_t":"3>consider the access attempt as allowed;","paragraph_zero_based":4078},{"literal_text_all_w_t_and_m_t":"2>else if Access Identity 3 is indicated:","paragraph_zero_based":4079}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["c29fbdfe3dbf0b8e82b7e196739d186ed966c19796c7c582203dfb410d07cd20","6e206b82d951ddc9ba0ba7f35d14cfff0ddb2c4a4e9397b78542580c5272ba97","c35405aafdf4fc1e49eadbc011866ab7acb39742218500ce52820d5eb08c10a2","bb1cc26edacbb918eeb45935c73612f2d24531ed14935f09bc1b4438c90238e7","b0ce2cde146eca934edc1d682b2d87cf69e14114456cf40b56f26048f4f63eff","367f7fd98e0ba059073f88a9f80588f6a6b355a3df3bb71b62f026e5628dbccf","afe98f5514b4b9b46d15eca25a821f0dbe279463a8f1dd5c4c6275aafce6e116","b5ee0ef6cbf2a9c53c603fb0330903d519e55fbff6747fd2a56a9bed365f8e80","1cf068a640d479c0ff85d22f1b109eb4078cc6a14edadfd0ba98ad311f97faf7","23948f36db6d6cbbf697241315bf4804707842eb21a7451542ee01e8b3ba754e","9d866f9bb8ebda4c4d34c7c7410c35cce5794c6fcd313f2d5f3433e0d73e7909","fba0fd2deefacd4d02c825115e21d7fe017b6544e6735a3b5eeee9a080895a64","0e78e2d99ffd5bfa50c0f7ad69755ea7db8fbf48af9717f2bf3b8f33fcaea550","a2bc7b7e3afa6e15717a9314614d4582fcd7da109c8a403ed3957ce114c99f4b","5d535c3ebf423f2ef66fc531a13652d4b3f9c889d9e478b772159ed006a957ce","60d5b6aaa40a229241d49a6c8ab54be04d88b28182061892ab0c242c52253579","b5fd4fcfb0aac70bcd800225530db168cf6432fb0abf3d2af2037793730c1076","fd7b85cbe4eb9d5a59b9551fb96ab77ef4709a87c2302c2b3d65b79452ed6000","37dd34c8fe794683fcde76148ed8300c53b18a8553c717b4dd5d93024c038ac4","aefaffc82257cd7d837847c51aaeb628561e48d14cf90a5877ee5fadb918268c","421372d4d5c3eee1ed4339e63fc967c82100ef7601a7803a88789dc60bb9e113","b1157c8133792cc8e47c0de6fe32ac33dc8b839713b9f3061bb9b220681896aa","cb06ad0717b1aed3339320ea77693d557010309cb6221fd41d0b502c0e960935","37853aaaada4b15dcf6727453b42de577e12fa01ee072cb2db0dd7e793ac3c60"],"paragraph_range_zero_based":[4056,4079],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p4056"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>draw a random number 'rand' uniformly distributed in the range: 0 ≤ rand < 1;","paragraph_zero_based":4080},{"literal_text_all_w_t_and_m_t":"3>if 'rand' is lower than the value indicated by uac-BarringFactorForAI3 included in \"UAC barring parameter\":","paragraph_zero_based":4081},{"literal_text_all_w_t_and_m_t":"4>consider the access attempt as allowed;","paragraph_zero_based":4082},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":4083},{"literal_text_all_w_t_and_m_t":"4>consider the access attempt as barred;","paragraph_zero_based":4084},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":4085},{"literal_text_all_w_t_and_m_t":"3>draw a random number 'rand' uniformly distributed in the range: 0 ≤ rand < 1;","paragraph_zero_based":4086},{"literal_text_all_w_t_and_m_t":"3>if 'rand' is lower than the value indicated by uac-BarringFactor included in \"UAC barring parameter\":","paragraph_zero_based":4087},{"literal_text_all_w_t_and_m_t":"4>consider the access attempt as allowed;","paragraph_zero_based":4088},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":4089},{"literal_text_all_w_t_and_m_t":"4>consider the access attempt as barred;","paragraph_zero_based":4090},{"literal_text_all_w_t_and_m_t":"1>if the access attempt is considered as barred:","paragraph_zero_based":4091},{"literal_text_all_w_t_and_m_t":"2>draw a random number 'rand' that is uniformly distributed in the range 0 ≤ rand < 1;","paragraph_zero_based":4092},{"literal_text_all_w_t_and_m_t":"2>start timer T390 for the Access Category with the timer value calculated as follows, using the uac-BarringTime included in \"UAC barring parameter\":","paragraph_zero_based":4093},{"literal_text_all_w_t_and_m_t":"T390 = (0.7+ 0.6 * rand) * uac-BarringTime.","paragraph_zero_based":4094},{"literal_text_all_w_t_and_m_t":"5.3.15RRC connection reject","paragraph_zero_based":4095},{"literal_text_all_w_t_and_m_t":"5.3.15.1Initiation","paragraph_zero_based":4096},{"literal_text_all_w_t_and_m_t":"The UE initiates the procedure upon the reception of RRCReject when the UE tries to establish or resume an RRC connection.","paragraph_zero_based":4097},{"literal_text_all_w_t_and_m_t":"5.3.15.2Reception of the RRCReject by the UE","paragraph_zero_based":4098},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":4099},{"literal_text_all_w_t_and_m_t":"1>stop timer T300, if running;","paragraph_zero_based":4100},{"literal_text_all_w_t_and_m_t":"1>stop timer T319, if running;","paragraph_zero_based":4101},{"literal_text_all_w_t_and_m_t":"1>stop timer T319a, if running and consider SDT procedure is not ongoing;","paragraph_zero_based":4102},{"literal_text_all_w_t_and_m_t":"1>stop timer T302, if running;","paragraph_zero_based":4103}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["888168a7eb0f5907d38ec46c182e945eb7363a37ef5c9a265d2cb4de2b4b9794","be440b720ee8ced08a7d03b6b32ac461e55431e21aa4579c307f381af5f19e75","e4cf5f99ba23a14bc294be6b290397f073644e783f19d32fe0df4e4822f30134","b52bc81287cb4861d1c1c38e16b042497cdbfec1d918c384e5f831b755a18511","ebf224890eecfad2863333b694b438c4872c733328bacafa9fb7a42ea024a168","91d1e8e4f711af9fb10e3bceffd28b76a97a71970e509117d78ea76cba184be1","de2099746604e6da48ed3ff79d247603ef87030e9645cb69edb4926f5c8ecb7b","381aff35c6ef452740508f50e9a1bc5715330e44210c1ded80008608be7dab0b","2ff3ca48fac0d198482acd03bca0a9745b2b419af3fdb522db8801ca45040741","19c96aa5eec56f20a8b95ed3813b2ae29f53b70e3072f5eb79e8b881f2f55b1c","a76fe6096471531b65990aa83e29a58f84df190ca321da280edff1d20d471337","792ea939894a40184da59f5be4179129ce371520a850161df70ee208d19d172f","94f04dfad326ecc4f6793847f97e56f0ab957e3ddfaf7036699e173e40b20713","41fe9a09233c96700a412642408d865b8d65eb223c3573e347715b0421775f34","62f9f5479b6e8f3a866380d1e0a9adc0e7189fb1923eb59b45d8453aefe0c4e9","051d03bc07692ca3ad8e3c1393a38ce870b80a080b041704fa1294f7f1199999","b04f842c4501fb83a36a73400d87a45ef5f77f72decaade6f494cac0d255093f","7fbf063ad5d900cef3847e38924a1cf1b5e3fc8c4e00b96b07b03bc6cf92dd0f","a048f5ead80f514f1fd37cab91b9a2b7c2a9f171bd9c454a6e95fb92d91040a3","082566043e88057d4e04f4d1814a2020c5b3064c233338a2b877bd79448cd413","9449c1769f069027cbbc00136a96037b2534525d000ae28eba43bc9793ac1d3d","c5793288217d712f5b15f50dfd5f8e72c6479f14e0711150b9c20975a0320d76","c780d25e1f67bd2ccedabc009ea166baaf48fa8db3ac9dff44961266730192e3","e78d1699699a1e366101727e7340e1a6c71ef5bb7d151fd7909e02e84ad55cbf"],"paragraph_range_zero_based":[4080,4103],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p4080"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>reset MAC and release the default MAC Cell Group configuration;","paragraph_zero_based":4104},{"literal_text_all_w_t_and_m_t":"1>if waitTime is configured in the RRCReject:","paragraph_zero_based":4105},{"literal_text_all_w_t_and_m_t":"2>start timer T302, with the timer value set to the waitTime;","paragraph_zero_based":4106},{"literal_text_all_w_t_and_m_t":"1>if RRCReject is received in response to a request from upper layers:","paragraph_zero_based":4107},{"literal_text_all_w_t_and_m_t":"2>inform the upper layer that access barring is applicable for all access categories except categories '0' and '2';","paragraph_zero_based":4108},{"literal_text_all_w_t_and_m_t":"1>if RRCReject is received in response to an RRCSetupRequest:","paragraph_zero_based":4109},{"literal_text_all_w_t_and_m_t":"2>inform upper layers about the failure to setup the RRC connection, upon which the procedure ends;","paragraph_zero_based":4110},{"literal_text_all_w_t_and_m_t":"1>else if RRCReject is received in response to an RRCResumeRequest or an RRCResumeRequest1:","paragraph_zero_based":4111},{"literal_text_all_w_t_and_m_t":"2>if resume is triggered by upper layers:","paragraph_zero_based":4112},{"literal_text_all_w_t_and_m_t":"3>inform upper layers about the failure to resume the RRC connection;","paragraph_zero_based":4113},{"literal_text_all_w_t_and_m_t":"2>if resume is triggered due to an RNA update; or","paragraph_zero_based":4114},{"literal_text_all_w_t_and_m_t":"2>if resume is triggered for SDT and T380 has expired:","paragraph_zero_based":4115},{"literal_text_all_w_t_and_m_t":"3>set the variable pendingRNA-Update to true;","paragraph_zero_based":4116},{"literal_text_all_w_t_and_m_t":"2>discard the current KgNB key, the KRRCenc key, the KRRCint key, the KUPint key and the KUPenc key derived in accordance with 5.3.13.3;","paragraph_zero_based":4117},{"literal_text_all_w_t_and_m_t":"2>if resume is triggered for SDT:","paragraph_zero_based":4118},{"literal_text_all_w_t_and_m_t":"3>for SRB2, if it is resumed and for SRB1:","paragraph_zero_based":4119},{"literal_text_all_w_t_and_m_t":"4>trigger the PDCP entity to perform SDU discard as specified in TS 38.323 [5];","paragraph_zero_based":4120},{"literal_text_all_w_t_and_m_t":"4>re-establish the RLC entity as specified in TS 38.322 [4];","paragraph_zero_based":4121},{"literal_text_all_w_t_and_m_t":"3>for each DRB that is not suspended:","paragraph_zero_based":4122},{"literal_text_all_w_t_and_m_t":"4>indicate PDCP suspend to lower layers;","paragraph_zero_based":4123},{"literal_text_all_w_t_and_m_t":"4>re-establish the RLC entity as specified in TS 38.322 [4];","paragraph_zero_based":4124},{"literal_text_all_w_t_and_m_t":"2>suspend SRB1 and the radio bearers configured for SDT, if any;","paragraph_zero_based":4125},{"literal_text_all_w_t_and_m_t":"2>the procedure ends.","paragraph_zero_based":4126},{"literal_text_all_w_t_and_m_t":"Upon L2 U2N Relay UE receives RRCReject, it either indicates to upper layers (to trigger PC5 unicast link release) or sends NotificationMessageSidelink message to the connected L2 U2N Remote UE(s) in accordance with 5.8.9.10.","paragraph_zero_based":4127}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["8e97e24b77f86fb4e5469420beb10ab3f78bfb84ce80d96834158f2a1477a166","c9a04a27601d91e9bc557f3cf73518b35cde029768a3de1eb9e779435e900b1d","139df2d116e3324825574f344dd08e6ef01b175fff87593ab5a868c2e3f9cdd6","4b90321865196012e2a5646d6f2815a280e30b744b4d61a6727b31e6341dae2a","c2b5d4f2cbdac4576713fa5905ed7de22e1d8171d58b5ca35f103bc37ca46f50","9262c3f24083e384f4a0bfad56de0fdc554d7dfdf8e0fbcb7f78b22eb0be9f8a","5405185ffca277e304c61b14ac5f498be72f8ef054d38b3ca793d5491ecec2c3","5c5286f64d99beae0a0b3c338064d34719781ee781c7a8401b76a6ed54936fb4","89c89055e710a73d5c2101a272816c750d01924769b40aa1387ad55ccafaf8ff","fdfad994a6d9eb1c938631a269fd964475866c6d57ede109ff244530348ca34e","961594bfa462c0e2e6a791eb9270b4e0f1d1794b5af3bf93933b542ca4bbe950","d067a110a5c1b978deea0d24aa72de2073f207bd40cdb20f614d7afa668a9673","8cdc25cd9234b83c616b0b3da57450c618c1753abbe6528edcb67bf244361d28","9e085f1d3b3eccd9cb1c47c92d7e187c06f352ecfcbe0789781b221247bd34e4","1474574e132419044db6bf8ba0e0ec31d2fbbbd97ca0eae63b8c9c900ccf4767","55196ce19817b4d91fc2ce43783ec71ad8a5d95ef79a37725d8d594a0c2f7da1","fbb5337d815198b491e854daf0e525010c2474034742d0d8b6aabfd63ad315f5","3b5ca894cb373aa8bfce9d910fd62911758efa4ae05be74480464a7fac41e941","46d7b7a9d7b7a0cee3748418514ab90bdf545f53eacf1584941648e79a1515c9","175c4787cb9b7a00b9484a1026d377ab90eb07d79a329ba319322da4a473bde8","0a87e4cdddecbf8d3f5e97952b2e28f84df1463e2e994834ebdbba7fdde84316","f033b28192dda8d72566d74ea81fdf4b7dcb42243af3d2847b0e930951c1d2bd","e17375744857698125920f0777848f6745f73b32be7b3acc30a7152fce08184f","3f5880a3dbc495bbb826d949c0ecc6247aa138d751c2ab37dc3e7072652f7210"],"paragraph_range_zero_based":[4104,4127],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p4104"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The RRC_INACTIVE UE shall continue to monitor paging while the timer T302 is running.","paragraph_zero_based":4128},{"literal_text_all_w_t_and_m_t":"NOTE:If timer T331 is running, the UE continues to perform idle/inactive measurements according to 5.7.8.","paragraph_zero_based":4129},{"literal_text_all_w_t_and_m_t":"5.4Inter-RAT mobility","paragraph_zero_based":4130},{"literal_text_all_w_t_and_m_t":"5.4.1Introduction","paragraph_zero_based":4131},{"literal_text_all_w_t_and_m_t":"Network controlled inter-RAT mobility between NR and E-UTRA, where E-UTRA can be connected to either EPC or 5GC, and from NR to UTRA-FDD is supported.","paragraph_zero_based":4132},{"literal_text_all_w_t_and_m_t":"5.4.2Handover to NR","paragraph_zero_based":4133},{"literal_text_all_w_t_and_m_t":"5.4.2.1General","paragraph_zero_based":4134},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4135},{"literal_text_all_w_t_and_m_t":"Figure 5.4.2.1-1: Handover to NR, successful","paragraph_zero_based":4136},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to, under the control of the network, transfer a connection between the UE and another Radio Access Network (e.g. E-UTRAN) to NR.","paragraph_zero_based":4137},{"literal_text_all_w_t_and_m_t":"The handover to NR procedure applies when SRBs, possibly in combination with DRBs, are established in another RAT. Handover from E-UTRA to NR applies only after integrity has been activated in E-UTRA.","paragraph_zero_based":4138},{"literal_text_all_w_t_and_m_t":"5.4.2.2Initiation","paragraph_zero_based":4139},{"literal_text_all_w_t_and_m_t":"The RAN using another RAT initiates the handover to NR procedure, in accordance with the specifications applicable for the other RAT, by sending the RRCReconfiguration message via the radio access technology from which the inter-RAT handover is performed.","paragraph_zero_based":4140},{"literal_text_all_w_t_and_m_t":"The network applies the procedure as follows:","paragraph_zero_based":4141},{"literal_text_all_w_t_and_m_t":"-to activate ciphering, possibly using NULL algorithm, if not yet activated in the other RAT;","paragraph_zero_based":4142},{"literal_text_all_w_t_and_m_t":"-to re-establish SRBs and one or more DRBs;","paragraph_zero_based":4143},{"literal_text_all_w_t_and_m_t":"5.4.2.3Reception of the RRCReconfiguration by the UE","paragraph_zero_based":4144},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":4145},{"literal_text_all_w_t_and_m_t":"1>apply the default L1 parameter values as specified in corresponding physical layer specifications except for the parameters for which values are provided in SIB1;","paragraph_zero_based":4146},{"literal_text_all_w_t_and_m_t":"1>apply the default MAC Cell Group configuration as specified in 9.2.2;","paragraph_zero_based":4147},{"literal_text_all_w_t_and_m_t":"1>perform RRC reconfiguration procedure as specified in 5.3.5;","paragraph_zero_based":4148},{"literal_text_all_w_t_and_m_t":"NOTE:If the UE is connected to 5GC of the source E-UTRA cell, the delta configuration for PDCP and SDAP can be used for intra-system inter-RAT handover. For other cases, source RAT configuration is not considered when the UE applies the reconfiguration message of target RAT.","paragraph_zero_based":4149},{"literal_text_all_w_t_and_m_t":"5.4.3Mobility from NR","paragraph_zero_based":4150},{"literal_text_all_w_t_and_m_t":"5.4.3.1General","paragraph_zero_based":4151}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["e307c887f5ea727b9a33a9bfec86b24e321126516b601e63d830fd5bf5bdcced","4589b98a29fcc635d611c30bf977d2e91641bac46d21941f14f22d35402ea930","5257a3f00d8aa7da4bc73b2a95ab59820a828020c90b5a0dde8061b325f54a2c","86b16ba95408c08225d9bf6ade09e43e04f5c6db28ac7f31a7f246ca5356a5fb","1c8d534f685919eb702febbbe140184db99e18df5c327fde559ff9055c5eb67e","d659d506440cd801f92c6bd9993450d626632d309ee17ba7f554928dd31d598d","e7e42e12376f7c9b39b0038f89c6f54903dd84683a41b35decb69c4299c7f6aa","aa4dd94384133f22f24ee76dd7ec6da44f345b0226a232b9b9e3da3b01896aa8","5c0465422ded8c3304c27c99010665aad1ed2c560c02e24c89e417103cd8da24","a0c27163366b2d52091c37191237c3650a51fba7a474d4bc80fc542b344671f1","de08ed7690d589a05fee49936cb1404294ec70630818d5829584379e481aa854","1c12bb7b6e1d4f5983199d0c4697d0393cee403f611e7a0a032ac25fada8c707","d15c60d25fabc46bd715d6107e3a5c86335fba3228f9dbedf12080c1d35b5984","96d1efd3cc70e2d8e4c019eba2944e01a395fa4a03336b61d4200aeb7e5f35a3","8ab27446c66073fbc8868646a9c8ac3d6bb3a5a4f04eecc0e770c4ffcb40d357","b37fceb9a77d5480a12dc62ee659a70ee5806ef577ca8c7d0b2b25f07167ca09","48c1caeae1f9d0b58ad6cffef84b19b5632b2f4a2b4dcc154924a25f0ff03562","b7aa19310c959083ef455feffbeb233a5c411866b7445231d0eb330fc78492bc","7ab970a8535342a726db3e71ba70133b3270c727811a12842d8b257bb150ec9d","14ecd4cd5a5e7e7b46bca4ae83d422012a5cc82c46d241bf9da5026ea33f6cdc","f44bb873183eb206740404b9adee8942646ed2597fe8b1fb6131e1626c3e9c00","126bb9dc337666fab514e719c133a78442fbd1de17750426900c6c9274ecc40e","c7fd8b3c81c9110797d85e8a72e40f67718473977443f5e9e1a986d067b7bed3","115487378b348b4427b1be748f1617e68017f66300b134a9dcd2b504cee11455"],"paragraph_range_zero_based":[4128,4151],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p4128"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4152},{"literal_text_all_w_t_and_m_t":"Figure 5.4.3.1-1: Mobility from NR, successful","paragraph_zero_based":4153},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4154},{"literal_text_all_w_t_and_m_t":"Figure 5.4.3.1-2: Mobility from NR, failure","paragraph_zero_based":4155},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to move a UE in RRC_CONNECTED to a cell using other RAT, e.g. E-UTRA, UTRA-FDD. The mobility from NR procedure covers the following type of mobility:","paragraph_zero_based":4156},{"literal_text_all_w_t_and_m_t":"-handover, i.e. the MobilityFromNRCommand message includes radio resources that have been allocated for the UE in the target cell;","paragraph_zero_based":4157},{"literal_text_all_w_t_and_m_t":"5.4.3.2Initiation","paragraph_zero_based":4158},{"literal_text_all_w_t_and_m_t":"The network initiates the mobility from NR procedure to a UE in RRC_CONNECTED, possibly in response to a MeasurementReport or an MCGFailureInformation message, by sending a MobilityFromNRCommand message. The network applies the procedure as follows:","paragraph_zero_based":4159},{"literal_text_all_w_t_and_m_t":"-the procedure is initiated only when AS security has been activated, and SRB2 with at least one DRB or multicast MRB are setup and not suspended;","paragraph_zero_based":4160},{"literal_text_all_w_t_and_m_t":"-the procedure is not initiated if any DAPS bearer is configured;","paragraph_zero_based":4161},{"literal_text_all_w_t_and_m_t":"5.4.3.3Reception of the MobilityFromNRCommand by the UE","paragraph_zero_based":4162},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":4163},{"literal_text_all_w_t_and_m_t":"1>stop timer T310, if running;","paragraph_zero_based":4164},{"literal_text_all_w_t_and_m_t":"1>stop timer T312, if running;","paragraph_zero_based":4165},{"literal_text_all_w_t_and_m_t":"1>if T316 is running:","paragraph_zero_based":4166},{"literal_text_all_w_t_and_m_t":"2>stop timer T316;","paragraph_zero_based":4167},{"literal_text_all_w_t_and_m_t":"2>clear the information included in VarRLF-Report, if any;","paragraph_zero_based":4168},{"literal_text_all_w_t_and_m_t":"1>if T390 is running:","paragraph_zero_based":4169},{"literal_text_all_w_t_and_m_t":"2>stop timer T390 for all access categories;","paragraph_zero_based":4170},{"literal_text_all_w_t_and_m_t":"2>perform the actions as specified in 5.3.14.4;","paragraph_zero_based":4171},{"literal_text_all_w_t_and_m_t":"1>if the targetRAT-Type is set to eutra:","paragraph_zero_based":4172},{"literal_text_all_w_t_and_m_t":"2>consider inter-RAT mobility as initiated towards E-UTRA;","paragraph_zero_based":4173},{"literal_text_all_w_t_and_m_t":"2>forward the nas-SecurityParamFromNR to the upper layers, if included;","paragraph_zero_based":4174},{"literal_text_all_w_t_and_m_t":"1>else if the targetRAT-Type is set to utra-fdd:","paragraph_zero_based":4175}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["49c3dd7d80f2997a138392954a007777e5b03a6b1fae4b48785d57f5ec37afcd","3f61e0c4956a34886094b6dbbd842c27eedf20381a8530ebfffc96d26186d2a3","356309f8a9103a68bb995733dc0aa2bc2a07c83e79af237acc58efaddce2f849","fee2530c763d2c366c78e28fc2db74cdf321bb92e1915aa1fe3b65c2e31fed1d","799129c7573c395b4fb6d362e59c200e9cdc749aa53a86b5cf10c30d79604a66","9af869d63c5a9440f4dfb84651e1b7dfb48c4f7e0396a690810d06f3255afaca","6d557d6cf67c21c37d7dca73c6a214cad36554bc85c6a4ad456a23f7773c038e","3ce3e7dbf3f708814dc6e961fd27c7a64aa86c0cb737d598ef4ac04f161a714d","d4d31df9a4307d33fa2858d8d3822e6287ce03e66c80c04ba8cc6428954543b4","1c410cee9a36d47135715a7ca6eb4cea3b08c284d73920c0eac8880d3616c661","ae93679c993b51b3dd6bb2c66530a82e318bf554795f02b5f6487fc2614f1aea","3d2de7e3a0dedd5ac7323bb6f908953fdcbb1aa09e5fe5e76a60b4b13108701e","fa35a6b13a0e7590145cac1e50da5107e38203fa11fd08d86a6bdcf223de8afa","014946aa4b760c1c96c433bc4e81df8f12f8f42d2ffdbabdc7b7a52445c249cd","b080c7282d7ec6046e2e5cb9fae4ad5dcfd829f1f5b39792ed6d7a66fccc385f","c1860d4e83dc824dc4dae9ad015bfbb9172cb136f6b78eff6787dc2ff87aae7e","dfa0fc1c864664f405a11486dcff113434de6915bbd0dde47382232898e03c83","7e9ffdfabba49da6dfbe65385861646299d38856b53ad1b75594c8d57e4b99ef","ef0deb58557fc1b9b9e9dda3d675ad8aa0739098f6abda241ce36c1d7a89c876","126b199189b63bc08efa53f15e648f631f79b9e031ef3ae2ed19db035ec1923f","e9970dfdb82e1d2577d13f8646b71fcabf36ec2b334cbfaf310b6dba98f275c7","b9652c0ba9969f28f4ce9ccea80166f575d7f6498cb7adcc283d34fd01e89c99","3e9b4c79aae3ee9308468fd6719806846529216fb57ccc5ce44bda06da82ade0","1df3f6734ea638ab252b91558fb41edcdab4788a56116f7e37696f38fe8eba84"],"paragraph_range_zero_based":[4152,4175],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p4152"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>consider inter-RAT mobility as initiated towards UTRA-FDD;","paragraph_zero_based":4176},{"literal_text_all_w_t_and_m_t":"2>forward the nas-SecurityParamFromNR to the upper layers, if included;","paragraph_zero_based":4177},{"literal_text_all_w_t_and_m_t":"1>access the target cell indicated in the inter-RAT message in accordance with the specifications of the target RAT.","paragraph_zero_based":4178},{"literal_text_all_w_t_and_m_t":"5.4.3.4Successful completion of the mobility from NR","paragraph_zero_based":4179},{"literal_text_all_w_t_and_m_t":"Upon successfully completing the handover, at the source side the UE shall:","paragraph_zero_based":4180},{"literal_text_all_w_t_and_m_t":"1>reset MAC;","paragraph_zero_based":4181},{"literal_text_all_w_t_and_m_t":"1>stop all timers that are running except T325, T330 and T400;","paragraph_zero_based":4182},{"literal_text_all_w_t_and_m_t":"1>release ran-NotificationAreaInfo, if stored;","paragraph_zero_based":4183},{"literal_text_all_w_t_and_m_t":"1>release the AS security context including the KRRCenc key, the KRRCint key, the KUPint key and the KUPenc key, if stored;","paragraph_zero_based":4184},{"literal_text_all_w_t_and_m_t":"1>release all radio resources, including release of the RLC entity and the MAC configuration;","paragraph_zero_based":4185},{"literal_text_all_w_t_and_m_t":"1>release the associated PDCP entity and SDAP entity for all established RBs;","paragraph_zero_based":4186},{"literal_text_all_w_t_and_m_t":"NOTE :PDCP and SDAP configured by the source RAT prior to the handover that are reconfigured and re-used by target RAT when delta signalling (i.e., during inter-RAT intra-system handover when fullConfig is not present) is used, are not released as part of this procedure.","paragraph_zero_based":4187},{"literal_text_all_w_t_and_m_t":"1>if the targetRAT-Type is set to eutra and the nas-SecurityParamFromNR is included: or","paragraph_zero_based":4188},{"literal_text_all_w_t_and_m_t":"1>if the targetRAT-Type is set to utra-fdd:","paragraph_zero_based":4189},{"literal_text_all_w_t_and_m_t":"2>indicate the release of the RRC connection to upper layers together with the release cause 'other'.","paragraph_zero_based":4190},{"literal_text_all_w_t_and_m_t":"5.4.3.5Mobility from NR failure","paragraph_zero_based":4191},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":4192},{"literal_text_all_w_t_and_m_t":"1>if the UE does not succeed in establishing the connection to the target radio access technology:","paragraph_zero_based":4193},{"literal_text_all_w_t_and_m_t":"2>if the targetRAT-Type in the received MobilityFromNRCommand is set to eutra and the UE supports Radio Link Failure Report for Inter-RAT MRO EUTRA:","paragraph_zero_based":4194},{"literal_text_all_w_t_and_m_t":"3>store handover failure information in VarRLF-Report according to 5.3.10.5;","paragraph_zero_based":4195},{"literal_text_all_w_t_and_m_t":"2>if voiceFallbackIndication is included in the MobilityFromNRCommand message; or","paragraph_zero_based":4196},{"literal_text_all_w_t_and_m_t":"2>if the mobility from NR procedure is for emergency services fallback as specified in TS 23.502 [43]:","paragraph_zero_based":4197},{"literal_text_all_w_t_and_m_t":"3>attempt to select an E-UTRA cell:","paragraph_zero_based":4198},{"literal_text_all_w_t_and_m_t":"4>if a suitable E-UTRA cell is selected; or","paragraph_zero_based":4199}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["6528056cc504ca30fe0dfba121bcb1dbfaba95bf772079af7f7c3c3cb2488e46","57d025bccbcfe39bb9f16f2167906c694e8214efeedebfc5cac04f29567bf91d","105ac2a72da39a7164895c504ef35f56d6b8a2b56d9992c600a11765e5b3887d","a031d192ab33eb83fa8e742bebb2916bd01ef36d935085e74d058e20858b1931","49e4968792b384ff06d75ea82d74c769164a9b26f9465d8fe582d78f5dd83d0d","754e9493d5eef0966921e98cf41c43b22655a4b0e2a6f216db50c2c7473b41b9","3bce358b5993fe0686522aab688632f21cf868bbd8c867b5efdabb984cabc791","9deb98424279fcd0eb628e95c368d5438249740a3d87beb8ae101e754f260cdf","c2d77c592ac370c933e7587dd418578da1a18b5778465904a1c6506e298f5bfb","6303bc845a891e61c296ccded3508902a883f6c3ceca3bd4a4094388b98bac50","0a54aaa8efb6c7b8c4e426ed3938202011561d2c7853aee63e675b1ee10a1613","7f9f65e65924669c5461524b3355c4d839dfa38d94fd0b94c77dac98622b01ee","3fd88f3af60f0b319d3061651587b522570ae64faea1020b62006420778022dc","41f18de2311543f5e66d857a4972df6a1c444b433cd9cd021e86a040bb030156","8994013aa08f904aafdb15f92ff364f2d6f505933694221ec6f46d933844632b","9794061cac8f9478a4ea34a26e644a93639c9c5a9583776498b42fa5adf2b424","fd8ed4c33bdfb3b84ae3222d4bbc5dee0471cc35e4155f43133238f9c769ff5b","7bbc1661eb68419a42c091db148bd4b77823ae67e3576f5f6bacf313a3b1af01","61b14e1ef07ac06d42e298b4df78b704c2e5c89ba777509c3a9921a27588f86d","d899ac6d37b1b7f42c36c8265a60a11ea0605448c5ee9e159497fd3787955aa7","9ce38b317c7735708bc8a7b1e1ee1eb733482648e8fb0908b27a2e747d015799","dcb9a85caa64984d2a309b4175a264bb360523ab74f6e57baaf81e1ca8fe34d4","d91406c5abe340deed6fe0e4f6fc31f20756da4a1f86f0bd8ae6b07917535001","b906cbe022d2b53322d519d9e49d2e492c7847a4af9efef79dafe6f830ffdfb5"],"paragraph_range_zero_based":[4176,4199],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p4176"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>if no suitable E-UTRA cell is available and an acceptable E-UTRA cell supporting emergency call is selected when the UE has an ongoing emergency call:","paragraph_zero_based":4200},{"literal_text_all_w_t_and_m_t":"5>perform the actions upon going to RRC_IDLE as specified in 5.3.11, with release cause 'RRC connection failure';","paragraph_zero_based":4201},{"literal_text_all_w_t_and_m_t":"4>else:","paragraph_zero_based":4202},{"literal_text_all_w_t_and_m_t":"5>revert back to the configuration used in the source PCell;","paragraph_zero_based":4203},{"literal_text_all_w_t_and_m_t":"5>initiate the connection re-establishment procedure as specified in clause 5.3.7;","paragraph_zero_based":4204},{"literal_text_all_w_t_and_m_t":"NOTE:It is left to UE implementation to determine whether the mobility from NR procedure is for emergency services fallback as specified in TS 23.502 [43].","paragraph_zero_based":4205},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":4206},{"literal_text_all_w_t_and_m_t":"3>revert back to the configuration used in the source PCell;","paragraph_zero_based":4207},{"literal_text_all_w_t_and_m_t":"3>initiate the connection re-establishment procedure as specified in clause 5.3.7;","paragraph_zero_based":4208},{"literal_text_all_w_t_and_m_t":"1>else if the UE is unable to comply with any part of the configuration included in the MobilityFromNRCommand message; or","paragraph_zero_based":4209},{"literal_text_all_w_t_and_m_t":"1>if there is a protocol error in the inter RAT information included in the MobilityFromNRCommand message, causing the UE to fail the procedure according to the specifications applicable for the target RAT:","paragraph_zero_based":4210},{"literal_text_all_w_t_and_m_t":"2>if the targetRAT-Type in the received MobilityFromNRCommand is set to eutra and the UE supports Radio Link Failure Report for Inter-RAT MRO EUTRA:","paragraph_zero_based":4211},{"literal_text_all_w_t_and_m_t":"3>store handover failure information in VarRLF-Report according to 5.3.10.5;","paragraph_zero_based":4212},{"literal_text_all_w_t_and_m_t":"2>revert back to the configuration used in the source PCell;","paragraph_zero_based":4213},{"literal_text_all_w_t_and_m_t":"2>initiate the connection re-establishment procedure as specified in clause 5.3.7.","paragraph_zero_based":4214},{"literal_text_all_w_t_and_m_t":"5.5Measurements","paragraph_zero_based":4215},{"literal_text_all_w_t_and_m_t":"5.5.1Introduction","paragraph_zero_based":4216},{"literal_text_all_w_t_and_m_t":"The network may configure an RRC_CONNECTED UE to perform measurements. The network may configure the UE to report them in accordance with the measurement configuration or perform conditional reconfiguration evaluation in accordance with the conditional reconfiguration. The measurement configuration is provided by means of dedicated signalling i.e. using the RRCReconfiguration or RRCResume.","paragraph_zero_based":4217},{"literal_text_all_w_t_and_m_t":"The network may configure the UE to perform the following types of measurements:","paragraph_zero_based":4218},{"literal_text_all_w_t_and_m_t":"-NR measurements;","paragraph_zero_based":4219},{"literal_text_all_w_t_and_m_t":"-Inter-RAT measurements of E-UTRA frequencies;","paragraph_zero_based":4220},{"literal_text_all_w_t_and_m_t":"-Inter-RAT measurements of UTRA-FDD frequencies;","paragraph_zero_based":4221},{"literal_text_all_w_t_and_m_t":"-NR sidelink measurements of L2 U2N Relay UEs.","paragraph_zero_based":4222},{"literal_text_all_w_t_and_m_t":"The network may configure the UE to report the following measurement information based on SS/PBCH block(s):","paragraph_zero_based":4223}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["896737217c8c38f9b7094011f87f948cfbd037d22d527866132b0755a341760b","50d36a3f3b50eb29bd24e5bf91925de9b902d1910155320d68fafc29819738a8","148d75038c03bd4d0121414801455e53d9702cde9a8ba4bc8f649fbaf585da26","fe3875e60257bb75eb5db31ca050eea39f88ee20d9c4e6474e81f32fb427bafa","4c4cc5d6ef4243f32751c2f8b85b5c230e6b5386ee8abcf8d87e88a30333915f","50526f033e76da5945619ec90522d02a52414e28f41beb1e54a03d09863f4a48","7db3f1ff528dde4777082890113bb5cd4a49f94f42d7277f529a28e489a1e04d","eea0240318e398f1d61134530d88dd4ab9a448879a550521253f26f3c3c610a2","9600b6c07ae2ff6811008243cdf37567ae38993b33506a57d192faa3b3c13ee5","3959cf5072bd9db0a66d1176ea37147242ab3db300b7b01ef62188203bcce94a","44815f9d4a7188c3d8c733efb016bec9d1adaa6018b203c15ebdbd0869962f06","98a77605cb4f4d56982f452df67cf15cacb799dbbdcbb9e99ebd5dd64e3213bb","f474fb800bd0101e9a375e05b57e0f318d96b9251fc0458a7bf2c70f2963a118","ac0296007c414ecf5053daf8285ba68556d02a7c5ee709ed3c5653372937d663","b7fd6d3111f433e2067ad09dffb0d2c267c5fdddc64658f7118bd48550d5881e","dc119ac9753b03352b5c254b6532e936439a02fcc1668fe2960f7135bfcfba7c","b8eae88502cd70b857ba27a2e5ae36b87744f68ee3c63ed2cae1c05c8294987c","5c9f5479d2ea4b2501ce51576eda40f8c01f18a482276412796877d403f0bb32","c4a962c0769a0c06c068d8d4e787e47f785eccc9ed0aa23be6b815f31b01cec7","732de3fa84e1db0c70518e72c94555f7e35ee60c9db78230673d5d5a286f61ed","065f137847a9e9ebcb4924926a5d05e5980b283c06040494631e6529bb49affe","b252ccc88214714ab269e052c62afccbfdf4a8a9070dcbd7fb853668ea3b3313","8871d21f0bde40235a30547eef453f0d7ba533fc72a44ff31ebcd589c247f6fc","bfad95270d2e71e152f282572a3ce556e10918d3b881425b2c882e4506940b23"],"paragraph_range_zero_based":[4200,4223],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p4200"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-Measurement results per SS/PBCH block;","paragraph_zero_based":4224},{"literal_text_all_w_t_and_m_t":"-Measurement results per cell based on SS/PBCH block(s);","paragraph_zero_based":4225},{"literal_text_all_w_t_and_m_t":"-SS/PBCH block(s) indexes.","paragraph_zero_based":4226},{"literal_text_all_w_t_and_m_t":"The network may configure the UE to report the following measurement information based on CSI-RS resources:","paragraph_zero_based":4227},{"literal_text_all_w_t_and_m_t":"-Measurement results per CSI-RS resource;","paragraph_zero_based":4228},{"literal_text_all_w_t_and_m_t":"-Measurement results per cell based on CSI-RS resource(s);","paragraph_zero_based":4229},{"literal_text_all_w_t_and_m_t":"-CSI-RS resource measurement identifiers.","paragraph_zero_based":4230},{"literal_text_all_w_t_and_m_t":"The network may configure the UE to perform the following types of measurements for NR sidelink and V2X sidelink:","paragraph_zero_based":4231},{"literal_text_all_w_t_and_m_t":"-CBR measurements.","paragraph_zero_based":4232},{"literal_text_all_w_t_and_m_t":"The network may configure the UE to report the following CLI measurement information based on SRS resources:","paragraph_zero_based":4233},{"literal_text_all_w_t_and_m_t":"-Measurement results per SRS resource;","paragraph_zero_based":4234},{"literal_text_all_w_t_and_m_t":"-SRS resource(s) indexes.","paragraph_zero_based":4235},{"literal_text_all_w_t_and_m_t":"The network may configure the UE to report the following CLI measurement information based on CLI-RSSI resources:","paragraph_zero_based":4236},{"literal_text_all_w_t_and_m_t":"-Measurement results per CLI-RSSI resource;","paragraph_zero_based":4237},{"literal_text_all_w_t_and_m_t":"-CLI-RSSI resource(s) indexes.","paragraph_zero_based":4238},{"literal_text_all_w_t_and_m_t":"The network may configure the UE to report the following Rx-Tx time difference measurement information based on CSI-RS for tracking or PRS:","paragraph_zero_based":4239},{"literal_text_all_w_t_and_m_t":"-UE Rx-Tx time difference measurement result.","paragraph_zero_based":4240},{"literal_text_all_w_t_and_m_t":"The measurement configuration includes the following parameters:","paragraph_zero_based":4241},{"literal_text_all_w_t_and_m_t":"1.Measurement objects: A list of objects on which the UE shall perform the measurements.","paragraph_zero_based":4242},{"literal_text_all_w_t_and_m_t":"-For intra-frequency and inter-frequency measurements a measurement object indicates the frequency/time location and subcarrier spacing of reference signals to be measured. Associated with this measurement object, the network may configure a list of cell specific offsets, a list of 'exclude-listed' cells and a list of 'allow-listed' cells. Exclude-listed cells are not applicable in event evaluation or measurement reporting. Allow-listed cells are the only ones applicable in event evaluation or measurement reporting.","paragraph_zero_based":4243},{"literal_text_all_w_t_and_m_t":"-The measObjectId of the MO which corresponds to each serving cell is indicated by servingCellMO within the serving cell configuration.","paragraph_zero_based":4244},{"literal_text_all_w_t_and_m_t":"-For inter-RAT E-UTRA measurements a measurement object is a single E-UTRA carrier frequency. Associated with this E-UTRA carrier frequency, the network can configure a list of cell specific offsets and a list of 'exclude-listed' cells. Exclude-listed cells are not applicable in event evaluation or measurement reporting.","paragraph_zero_based":4245},{"literal_text_all_w_t_and_m_t":"-For inter-RAT UTRA-FDD measurements a measurement object is a set of cells on a single UTRA-FDD carrier frequency.","paragraph_zero_based":4246},{"literal_text_all_w_t_and_m_t":"-For NR sidelink measurements of L2 U2N Relay UEs, a measurement object is a single NR sidelink frequency to be measured.","paragraph_zero_based":4247}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["a4d69341e7880f37c68fd554c19dcdb4587472bbfea2b3aa8b78bff75d1eda21","c8a97fd8ed1e321d79a5da4ffed375ea20892613dabe1f5765f6fa36f68b22cc","a49f476ee61b70f58cb52139bb2208afd91c1535e1ce51df8a8334a3dd990d34","945a296081485fdf93b6f9dac8155bcdc4e548eb3343e7cb8a87700b03a95593","f01ea9445c3d4453fb4a608e42b76f412b928f3153f2305e16beb064efc5b0de","7ccb629a78fb59037ab0cfeaaa26e3e4c1d64844cab2a583dbb3223d6602a4ed","2085d86ae4235f6f324ca08a3e2b4e501048a0b288aab5967c8a8d88f0a2b852","b889ab22ff50af3cf9f788711d8ea0be69e2ea2588564eb3fa15bce14f3550be","7220171e2422e661ebff284e62a1961e3368fbbab34a906dc2b75afb9f1b2d4f","ace06e5271e1b5867783c37bed19ae7b8c511830d69f992a419f45af66e26cec","cf4c2f13c86062dbbbb3b469ec2e641b0c306f3efe97b407afe8ca31a3012736","57d967901f66e3d3b1a2882bc5955d92f05356da07003c46d4793fdfc16a644c","2a984d535ba6571e69636791d86e42a61a6efcc288d37c31890cdc5c1fb73df3","040d171cfcf634ec423e17742b97b1f6bcb941cdd788fff413f8f690defa7f62","988e3192b5bc9505bf956d377cc9238edd9f83e80779f0d5ff32ba226c3c1184","8b1cdbff139c37e2140ae91755115043ad3b5c8ca87f61251af6a6cbd7fc2378","de82d714d6ba9ee5066116b28a10bee81d34fdb162aba146027000280bd2ba06","01463b0c1887a78b907ca74e7a4c1f15d491791da12d5c3ee050198c0f706e42","4b4110ecc02c17b6802320f78988b7d181bce12b8c8e439b50d6be9d7eab5d6c","19a0fc8a577f2099adab9f7d9495de4b11076c64d41da4d0082553dafded497a","689ef148ad14c7951d792e786f218c39e8ee44317d22f5a36d84fe6db9787d7a","4c6e0709309b7729f9565f65517648508aaca00cb743d1e2a02b0045b8aaa65e","37aed4ce3520669dfeed613f480470082f3dc3aea0afe9cb33abd0544ee7c473","bf5904d72bc9c3221d2db995d0c7d036013c5f1564c25727ad6aabed0ac27060"],"paragraph_range_zero_based":[4224,4247],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p4224"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-For CBR measurement of NR sidelink communication, a measurement object is a set of transmission resource pool(s) on a single carrier frequency for NR sidelink communication.","paragraph_zero_based":4248},{"literal_text_all_w_t_and_m_t":"-For CBR measurement of NR sidelink discovery, a measurement object is a set of discovery dedicated resource pool(s) or transmission resource pool(s) also used for NR sidelink discovery on a single carrier frequency for NR sidelink discovery.","paragraph_zero_based":4249},{"literal_text_all_w_t_and_m_t":"-For CLI measurements a measurement object indicates the frequency/time location of SRS resources and/or CLI-RSSI resources, and subcarrier spacing of SRS resources to be measured.","paragraph_zero_based":4250},{"literal_text_all_w_t_and_m_t":"2.Reporting configurations: A list of reporting configurations where there can be one or multiple reporting configurations per measurement object. Each measurement reporting configuration consists of the following:","paragraph_zero_based":4251},{"literal_text_all_w_t_and_m_t":"-Reporting criterion: The criterion that triggers the UE to send a measurement report. This can either be periodical or a single event description.","paragraph_zero_based":4252},{"literal_text_all_w_t_and_m_t":"-RS type: The RS that the UE uses for beam and cell measurement results (SS/PBCH block or CSI-RS).","paragraph_zero_based":4253},{"literal_text_all_w_t_and_m_t":"-Reporting format: The quantities per cell and per beam that the UE includes in the measurement report (e.g. RSRP) and other associated information such as the maximum number of cells and the maximum number beams per cell to report.","paragraph_zero_based":4254},{"literal_text_all_w_t_and_m_t":"In case of conditional reconfiguration, each configuration consists of the following:","paragraph_zero_based":4255},{"literal_text_all_w_t_and_m_t":"-Execution criteria: The criteria the UE uses for conditional reconfiguration execution.","paragraph_zero_based":4256},{"literal_text_all_w_t_and_m_t":"-RS type: The RS that the UE uses for obtaining beam and cell measurement results (SS/PBCH block-based or CSI-RS-based), used for evaluating conditional reconfiguration execution condition.","paragraph_zero_based":4257},{"literal_text_all_w_t_and_m_t":"3.Measurement identities: For measurement reporting, a list of measurement identities where each measurement identity links one measurement object with one reporting configuration. By configuring multiple measurement identities, it is possible to link more than one measurement object to the same reporting configuration, as well as to link more than one reporting configuration to the same measurement object. The measurement identity is also included in the measurement report that triggered the reporting, serving as a reference to the network. For conditional reconfiguration triggering, one measurement identity links to exactly one conditional reconfiguration trigger configuration. And up to 2 measurement identities can be linked to one conditional reconfiguration execution condition.","paragraph_zero_based":4258},{"literal_text_all_w_t_and_m_t":"4.Quantity configurations: The quantity configuration defines the measurement filtering configuration used for all event evaluation and related reporting, and for periodical reporting of that measurement. For NR measurements, the network may configure up to 2 quantity configurations with a reference in the NR measurement object to the configuration that is to be used. In each configuration, different filter coefficients can be configured for different measurement quantities, for different RS types, and for measurements per cell and per beam.","paragraph_zero_based":4259},{"literal_text_all_w_t_and_m_t":"5.Measurement gaps: Periods that the UE may use to perform measurements.","paragraph_zero_based":4260},{"literal_text_all_w_t_and_m_t":"A UE in RRC_CONNECTED maintains a measurement object list, a reporting configuration list, and a measurement identities list according to signalling and procedures in this specification. The measurement object list possibly includes NR measurement object(s), CLI measurement object(s), inter-RAT objects, and L2 U2N Relay objects. Similarly, the reporting configuration list includes NR, inter-RAT, and L2 U2N Relay reporting configurations. Any measurement object can be linked to any reporting configuration of the same RAT type. Some reporting configurations may not be linked to a measurement object. Likewise, some measurement objects may not be linked to a reporting configuration.","paragraph_zero_based":4261},{"literal_text_all_w_t_and_m_t":"The measurement procedures distinguish the following types of cells:","paragraph_zero_based":4262},{"literal_text_all_w_t_and_m_t":"1.The NR serving cell(s) – these are the SpCell and one or more SCells.","paragraph_zero_based":4263},{"literal_text_all_w_t_and_m_t":"2.Listed cells – these are cells listed within the measurement object(s).","paragraph_zero_based":4264},{"literal_text_all_w_t_and_m_t":"3.Detected cells – these are cells that are not listed within the measurement object(s) but are detected by the UE on the SSB frequency(ies) and subcarrier spacing(s) indicated by the measurement object(s).","paragraph_zero_based":4265},{"literal_text_all_w_t_and_m_t":"For NR measurement object(s), the UE measures and reports on the serving cell(s)/serving Relay UE (for L2 U2N Remote UE), listed cells and/or detected cells. For inter-RAT measurements object(s) of E-UTRA, the UE measures and reports on listed cells and detected cells and, for RSSI and channel occupancy measurements, the UE measures and reports on the configured resources on the indicated frequency. For inter-RAT measurements object(s) of UTRA-FDD, the UE measures and reports on listed cells. For CLI measurement object(s), the UE measures and reports on configured measurement resources (i.e. SRS resources and/or CLI-RSSI resources). For L2 U2N Relay object(s), the UE measures and reports on the serving NR cell(s), as well as the discovered L2 U2N Relay UEs.","paragraph_zero_based":4266},{"literal_text_all_w_t_and_m_t":"Whenever the procedural specification, other than contained in clause 5.5.2, refers to a field it concerns a field included in the VarMeasConfig unless explicitly stated otherwise i.e. only the measurement configuration procedure covers the direct UE action related to the received measConfig.","paragraph_zero_based":4267},{"literal_text_all_w_t_and_m_t":"In NR-DC, the UE may receive two independent measConfig:","paragraph_zero_based":4268},{"literal_text_all_w_t_and_m_t":"-a measConfig, associated with MCG, that is included in the RRCReconfiguration message received via SRB1; and","paragraph_zero_based":4269},{"literal_text_all_w_t_and_m_t":"-a measConfig, associated with SCG, that is included in the RRCReconfiguration message received via SRB3, or, alternatively, included within a RRCReconfiguration message embedded in a RRCReconfiguration message received via SRB1.","paragraph_zero_based":4270},{"literal_text_all_w_t_and_m_t":"In this case, the UE maintains two independent VarMeasConfig and VarMeasReportList, one associated with each measConfig, and independently performs all the procedures in clause 5.5 for each measConfig and the associated VarMeasConfig and VarMeasReportList, unless explicitly stated otherwise.","paragraph_zero_based":4271}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["64876840a78748dcf97646e82772841e2c73ea7d0b46da806214de382c985827","aeb906d923676674c43318296be68dcc4cfbfbce10dc41f953168ca64cdd7f27","93b0f7f97a969040508ffaebe7bb1e4162cd8d4421555da21eac187ed7f7f1e1","da3d104098173ae20a82c5928f74180290d785c15a0bc3134f11730a6efa7df6","a43fb061c8f6af4d91322bbb45b7ed42717738eebe6d51c226fcaaad10f5de20","1f5859c04a298e0f2e76a9522c3f5bf317b830fc731c2970e54da488757cc6ac","42126922e8ccc0205a68d0b24e86a7c5ab9fe2f2fe0c3bed63a257ef6eb11f2f","bcad473b106b0430602315df68e7e2cb13382f34c5cbfb5b743c9cc1bf8ef2b0","9fa2c49893c3c19a8f9526b4ce655b245ec824ba0499e80d2d033584343aec62","afa3c0735c7e5b8b550c6d79af9a383335a50d61c45b6cf7a5ac18daf457ad2e","44b291be4ad7bc7258baa36c7d19935f89450cdea0af93c62377bfa1824c701d","c88e45f3836c11f012231a0b2a7ef7c4ff2aab5331646474e56bc1355c09895a","6600a0776444a3d6844f5cd81ffb90417d2840908aabd6981437a9dde57a6b69","b0f6cfbb32c9300c673d257494c235166f49536d00f7b55d7bac80f1aff3a054","f8dce2e9e92b58739db4c70bf7c7de490a31af9422a6f9f53cc97e0aa37a3a12","4fd90c7eabd6e57fc8defc9bf1176c04608fbd84dd6291ac60c6f3d3659b44c6","a8098bd01bd004d9a811dcfe0464c16349be403d3dbedaf37698029e7cacd295","dacdc7af9643b6a787305bf94f3e99f1558492472a2aa3aad6b4c1662611522b","cda62f9aac9191ddd0c84c320fed0c0bf7f460e2cd80e8f5d35b02757e560ad7","aa6d4b2a5dae545e15222f309dd92bf6c570af09910a6855d612e4f5d7d1053e","03817e6f6f8264306cf8c579ecca9b1ef21d2ac7d0952aa32b41421be47d037e","b47782139ec12a7eb9130c54183107f4d1dbfe8484458b34f671e2cb1afa578b","234c8910bbcfbebd02f226e3f96a3cefa50415be57862a4104de4835e19bf77e","fe3c493de4b94b04867af70573e97675d26a4fc665636594d5835f1d414db2cd"],"paragraph_range_zero_based":[4248,4271],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p4248"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The configurations related to CBR measurements are only included in the measConfig associated with MCG.","paragraph_zero_based":4272},{"literal_text_all_w_t_and_m_t":"The configurations related to Rx-Tx time difference measurement are only included in the measConfig associated with MCG.","paragraph_zero_based":4273},{"literal_text_all_w_t_and_m_t":"5.5.2Measurement configuration","paragraph_zero_based":4274},{"literal_text_all_w_t_and_m_t":"5.5.2.1General","paragraph_zero_based":4275},{"literal_text_all_w_t_and_m_t":"The network applies the procedure as follows:","paragraph_zero_based":4276},{"literal_text_all_w_t_and_m_t":"-to ensure that, whenever the UE has a measConfig associated with a CG, it includes a measObject for the SpCell and for each NR SCell of the CG to be measured;","paragraph_zero_based":4277},{"literal_text_all_w_t_and_m_t":"-to configure at most one measurement identity across all CGs using a reporting configuration with the reportType set to reportCGI;","paragraph_zero_based":4278},{"literal_text_all_w_t_and_m_t":"-to configure at most one measurement identity per the node hosting PDCP entity using a reporting configuration with the ul-DelayValueConfig;","paragraph_zero_based":4279},{"literal_text_all_w_t_and_m_t":"-to configure at most one measurement identity per the node hosting PDCP entity using a reporting configuration with the ul-ExcessDelayConfig;","paragraph_zero_based":4280},{"literal_text_all_w_t_and_m_t":"-to ensure that, in the measConfig associated with a CG:","paragraph_zero_based":4281},{"literal_text_all_w_t_and_m_t":"-for all SSB based measurements there is at most one measurement object with the same ssbFrequency;","paragraph_zero_based":4282},{"literal_text_all_w_t_and_m_t":"-an smtc1 included in any measurement object with the same ssbFrequency has the same value and that an smtc2 included in any measurement object with the same ssbFrequency has the same value and that an smtc3list included in any measurement object with the same ssbFrequency has the same value and that an smtc4list included in any measurement object with the same ssbFrequency has the same value;","paragraph_zero_based":4283},{"literal_text_all_w_t_and_m_t":"-to ensure that all measurement objects configured in this specification and in TS 36.331 [10] with the same ssbFrequency have the same ssbSubcarrierSpacing;","paragraph_zero_based":4284},{"literal_text_all_w_t_and_m_t":"-to ensure that, if a measurement object associated with the MCG has the same ssbFrequency as a measurement object associated with the SCG:","paragraph_zero_based":4285},{"literal_text_all_w_t_and_m_t":"-for that ssbFrequency, the measurement window according to the smtc1 configured by the MCG includes the measurement window according to the smtc1 configured by the SCG, or vice-versa, with an accuracy of the maximum receive timing difference specified in TS 38.133 [14].","paragraph_zero_based":4286},{"literal_text_all_w_t_and_m_t":"-if both measurement objects are used for RSSI measurements, bits in measurementSlots in both objects corresponding to the same slot are set to the same value. Also, the endSymbol is the same in both objects.","paragraph_zero_based":4287},{"literal_text_all_w_t_and_m_t":"-to ensure that, if a measurement object has the same ssbFrequency as a measurement object configured in TS 36.331 [10]:","paragraph_zero_based":4288},{"literal_text_all_w_t_and_m_t":"-for that ssbFrequency, the measurement window according to the smtc configured in TS 36.331 [10] includes the measurement window according to the smtc1 configured in TS 38.331, or vice-versa, with an accuracy of the maximum receive timing difference specified in TS 38.133 [14].","paragraph_zero_based":4289},{"literal_text_all_w_t_and_m_t":"-if both measurement objects are used for RSSI measurements, bits in measurementSlots in both objects corresponding to the same slot are set to the same value. Also, the endSymbol is the same in both objects.","paragraph_zero_based":4290},{"literal_text_all_w_t_and_m_t":"-when the UE is in NE-DC, NR-DC, or NR standalone, to configure at most one measurement identity across all CGs using a reporting configuration with the reportType set to reportSFTD;","paragraph_zero_based":4291},{"literal_text_all_w_t_and_m_t":"For CSI-RS resources, the network applies the procedure as follows:","paragraph_zero_based":4292},{"literal_text_all_w_t_and_m_t":"-to ensure that all CSI-RS resources configured in each measurement object have the same center frequency, (startPRB+floor(nrofPRBs/2))","paragraph_zero_based":4293},{"literal_text_all_w_t_and_m_t":"-to ensure that the total number of CSI-RS resources configured in each measurement object does not exceed the maximum number specified in TS 38.214 [19].","paragraph_zero_based":4294},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":4295}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["75da5d9c8a4e4090751b90f13aa4727375bd875535afd3b97969f8f174e21a35","03b303a638a07a9cc1b706b797c77c28393875be92274478d1c14bea9969a4ef","182a6dd3d3660d374b685e16fb2d2c7145306b18fe12177d5eda8736f09dd979","98d4288e3d8e5e1bdcde43b43efb1c6690572c6db7c74f4f2a31553a749fc678","ee1b709058f6cb096c6bff347d2ead4f6ec9e7d823a6ad384b7091febb99798a","64b3c5b2341e2e52742802ab2e08d91f241dd0667418c29344420a7f7bf2a8ba","3ae61a5cdeb25644f284cd98dde14d2ead3c6bb8a974116b1652fc877ae3fb27","533b84b97c78ec319803d1699227a88fbf3eb7c4ef6b9a07f9e0817277b85ce6","e569103755f0f5e9f3506b7b1cc8b4fb88646ca712c3f42b4618a6535684f6db","3d82e6741c5aa622544bad8ccebde3147e0601929b4c4023140b5d3a512a89e4","96b4d81b941f72340549190c6f06f3afa2431a2b2d7926e1e1274b62fb36227d","372dc2795af5472b3b79630696a78bbb430e3152d80f957bd8fd3fcc217268df","01a345b41854f6feee61453c254c45a02d210f338877aaa087f19e29a40579e0","b9e7b6a75b953861a61c8bca81165afb78abb633552aa350f1bf2d4ca68aacf7","fa5a6c9cdac517f80d74daa71553b29f4553f0389714e92b28a071b03f8292c6","a92ab1a6b4aee49bac09518df87537ffae0b31737c46f8223977d0c4ad729a59","e64d357faf6b1390d5f38c210c894c1546b13bf0cf6f6b84e57f4b5cc50ee76e","f1650f44de49efd6a7461bc112954b482c03356855ed7e2de044620dc516884d","19d1854ae5b9611531d56634a6ed937acf1241c69e04446e8f91c30176bd9d2a","e78f090e3f137cd31534edd78fc1a053e906a8f3237c0ac67097c5a6b09a63b7","c06579bfceb6142c05d00b42822c507fba03b4437138ba407602a83a1a32449c","42f2d2376b9e7c8a93e6c41bdf526f9fe4138ff8954d02a408d18bc4e40b583e","fc63101fa705f2e76f98707e1c9799699a02c48faffa605f8fa7cea68490d9d4","5fedaaaa766681a9c5bfd05d9df3c6be0df097f9859f714cd95dbe3f25f3dafe"],"paragraph_range_zero_based":[4272,4295],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p4272"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>if the received measConfig includes the measObjectToRemoveList:","paragraph_zero_based":4296},{"literal_text_all_w_t_and_m_t":"2>perform the measurement object removal procedure as specified in 5.5.2.4;","paragraph_zero_based":4297},{"literal_text_all_w_t_and_m_t":"1>if the received measConfig includes the measObjectToAddModList:","paragraph_zero_based":4298},{"literal_text_all_w_t_and_m_t":"2>perform the measurement object addition/modification procedure as specified in 5.5.2.5;","paragraph_zero_based":4299},{"literal_text_all_w_t_and_m_t":"1>if the received measConfig includes the reportConfigToRemoveList:","paragraph_zero_based":4300},{"literal_text_all_w_t_and_m_t":"2>perform the reporting configuration removal procedure as specified in 5.5.2.6;","paragraph_zero_based":4301},{"literal_text_all_w_t_and_m_t":"1>if the received measConfig includes the reportConfigToAddModList:","paragraph_zero_based":4302},{"literal_text_all_w_t_and_m_t":"2>perform the reporting configuration addition/modification procedure as specified in 5.5.2.7;","paragraph_zero_based":4303},{"literal_text_all_w_t_and_m_t":"1>if the received measConfig includes the quantityConfig:","paragraph_zero_based":4304},{"literal_text_all_w_t_and_m_t":"2>perform the quantity configuration procedure as specified in 5.5.2.8;","paragraph_zero_based":4305},{"literal_text_all_w_t_and_m_t":"1>if the received measConfig includes the measIdToRemoveList:","paragraph_zero_based":4306},{"literal_text_all_w_t_and_m_t":"2>perform the measurement identity removal procedure as specified in 5.5.2.2;","paragraph_zero_based":4307},{"literal_text_all_w_t_and_m_t":"1>if the received measConfig includes the measIdToAddModList:","paragraph_zero_based":4308},{"literal_text_all_w_t_and_m_t":"2>perform the measurement identity addition/modification procedure as specified in 5.5.2.3;","paragraph_zero_based":4309},{"literal_text_all_w_t_and_m_t":"1>if the received measConfig includes the measGapConfig:","paragraph_zero_based":4310},{"literal_text_all_w_t_and_m_t":"2>perform the measurement gap configuration procedure as specified in 5.5.2.9;","paragraph_zero_based":4311},{"literal_text_all_w_t_and_m_t":"1>if the received measConfig includes the measGapSharingConfig:","paragraph_zero_based":4312},{"literal_text_all_w_t_and_m_t":"2>perform the measurement gap sharing configuration procedure as specified in 5.5.2.11;","paragraph_zero_based":4313},{"literal_text_all_w_t_and_m_t":"1>if the received measConfig includes the s-MeasureConfig:","paragraph_zero_based":4314},{"literal_text_all_w_t_and_m_t":"2>if s-MeasureConfig is set to ssb-RSRP, set parameter ssb-RSRP of s-MeasureConfig within VarMeasConfig to the threshold value of the RSRP indicated by the received value of s-MeasureConfig which is derived as specified in 6.3.2;","paragraph_zero_based":4315},{"literal_text_all_w_t_and_m_t":"2>else, set parameter csi-RSRP of s-MeasureConfig within VarMeasConfig to the threshold value of the RSRP indicated by the received value of s-MeasureConfig which is derived as specified in 6.3.2.","paragraph_zero_based":4316},{"literal_text_all_w_t_and_m_t":"5.5.2.2Measurement identity removal","paragraph_zero_based":4317},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":4318},{"literal_text_all_w_t_and_m_t":"1>for each measId included in the received measIdToRemoveList that is part of the current UE configuration in VarMeasConfig:","paragraph_zero_based":4319}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["c3eb1b0227f70cb4f643f6b3651c30253269e0e4c6c926781e3bbca1592ccf91","4ac3d11a395bd4c12a1d9693032db740bbb55ed8942e96e556d0266b5e3f601c","2590d702daaa27c778062eb65e70fc0b70558f0e8b4f530f72cc9a6e66ad0153","7450b2e3e8a7cc2da892a84f6d80833820e891ea95520a3b9ad4d2e8bf8834fa","b6dc7c9d7f63b3beaa7b4aee27f6efa40013c9315df4a16a04f07ff07c855b8f","2b6e434fec2beb5493b969da1573c1e032d72fe555548892012ba04cfb3bae42","719be54784b06a5b57c36541f7e2a93735c6745df1a3dbf48250da57e39bf1c5","f4f240746f3ad220a95836a16d9e16bbb7d3da696ed839c4902e73b820fb9c74","c68832993e8ac9da9fad61ca62c51ad596ffbbedcbe1ced274f79e8fb9c58f8e","895e90a351f640553377a6051e9c48a594f3857133952de666cb106d7f6143aa","c3f65be14a0ee80ac99012e12b536ab163afef7ccacf74ae2130c61656da648f","e104ea723a5bf602061b9adcf4083562a8e0113780f7e94f28b8bf2394779efd","9289ab23bad5cf78900676aa42887d69339d3c02cafa0a308de0a7f47d19c6ed","ed95991fcefe94ab50d14b9354c6b95a3350f42b5ba3e662e7d5b4199a092072","4a79240bc03b97831eecd17acdfc82101af922b0357ab6d8dd521f898c8efedd","403206d2ea003341b8b3f4e8666bd3b47b341e15bd4730fbe6f0aee4c0a8b9b3","e3b49bba37fdaad7d147fdc7e852a30c8b832f7a7e0da1f2b1a345ea8286d562","baca53c79a8ccad99c7de873412aa5c19e9ff810d2ffaa42b3788d203454cac1","c92ad9598ca24a29051aa67d06e6b231d5c2a8ddc8324a855641770476b11ed0","8504867656aab8cd3189a867e7d072c3d5ec35b97f107226bfd0fef5a9bc62f7","10d8f03f96da126734625c5d92548236d1b2a2f6ab599400510cc93f7ae13c6b","ed00e8f8a1c7605e1d6d846cd02f1bde995b727a1082cfe9190402b843cc4680","6225772ba2f47c409bef392206b2e7ecdfe95249a9bd6bcba1728bb5049b445b","a79d0fd42e0874b2e6bce2caa4969c77a7f1ecea896e37eb8a081dc3d1a607ed"],"paragraph_range_zero_based":[4296,4319],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p4296"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>remove the entry with the matching measId from the measIdList within the VarMeasConfig;","paragraph_zero_based":4320},{"literal_text_all_w_t_and_m_t":"2>remove the measurement reporting entry for this measId from the VarMeasReportList, if included;","paragraph_zero_based":4321},{"literal_text_all_w_t_and_m_t":"2>stop the periodical reporting timer or timer T321 or timer T322, whichever one is running, and reset the associated information (e.g. timeToTrigger) for this measId.","paragraph_zero_based":4322},{"literal_text_all_w_t_and_m_t":"NOTE:The UE does not consider the message as erroneous if the measIdToRemoveList includes any measId value that is not part of the current UE configuration.","paragraph_zero_based":4323},{"literal_text_all_w_t_and_m_t":"5.5.2.3Measurement identity addition/modification","paragraph_zero_based":4324},{"literal_text_all_w_t_and_m_t":"The network applies the procedure as follows:","paragraph_zero_based":4325},{"literal_text_all_w_t_and_m_t":"-configure a measId only if the corresponding measurement object, the corresponding reporting configuration and the corresponding quantity configuration, are configured.","paragraph_zero_based":4326},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":4327},{"literal_text_all_w_t_and_m_t":"1>for each measId included in the received measIdToAddModList:","paragraph_zero_based":4328},{"literal_text_all_w_t_and_m_t":"2>if an entry with the matching measId exists in the measIdList within the VarMeasConfig:","paragraph_zero_based":4329},{"literal_text_all_w_t_and_m_t":"3>replace the entry with the value received for this measId;","paragraph_zero_based":4330},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":4331},{"literal_text_all_w_t_and_m_t":"3>add a new entry for this measId to the measIdList within the VarMeasConfig;","paragraph_zero_based":4332},{"literal_text_all_w_t_and_m_t":"2>remove the measurement reporting entry for this measId from the VarMeasReportList, if included;","paragraph_zero_based":4333},{"literal_text_all_w_t_and_m_t":"2>stop the periodical reporting timer or timer T321 or timer T322, whichever one is running, and reset the associated information (e.g. timeToTrigger) for this measId;","paragraph_zero_based":4334},{"literal_text_all_w_t_and_m_t":"NOTE 1:If the measId associated with reportConfig for conditional reconfiguration is modified, the conditions are considered to be not fulfilled as specified in 5.3.5.13.4.","paragraph_zero_based":4335},{"literal_text_all_w_t_and_m_t":"2>if the reportType is set to reportCGI in the reportConfig associated with this measId:","paragraph_zero_based":4336},{"literal_text_all_w_t_and_m_t":"3>if the measObject associated with this measId concerns E-UTRA:","paragraph_zero_based":4337},{"literal_text_all_w_t_and_m_t":"4>if the useAutonomousGaps is included in the reportConfig associated with this measId:","paragraph_zero_based":4338},{"literal_text_all_w_t_and_m_t":"5>start timer T321 with the timer value set to 200 ms for this measId;","paragraph_zero_based":4339},{"literal_text_all_w_t_and_m_t":"4>else:","paragraph_zero_based":4340},{"literal_text_all_w_t_and_m_t":"5>start timer T321 with the timer value set to 1 second for this measId;","paragraph_zero_based":4341},{"literal_text_all_w_t_and_m_t":"3>if the measObject associated with this measId concerns NR:","paragraph_zero_based":4342},{"literal_text_all_w_t_and_m_t":"4>if the measObject associated with this measId concerns FR1:","paragraph_zero_based":4343}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808a