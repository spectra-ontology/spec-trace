{"fields":{"filename":"R2-2313675.zip::R2-2313675 38.321 CR for UAV.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"[1]3GPP TR 21.905: \"Vocabulary for 3GPP Specifications\".","paragraph_zero_based":120},{"literal_text_all_w_t_and_m_t":"[2]3GPP TS 38.300: \"NR; Overall description; Stage 2\".","paragraph_zero_based":121},{"literal_text_all_w_t_and_m_t":"[3]3GPP TS 38.322: \"NR; Radio Link Control (RLC) protocol specification\".","paragraph_zero_based":122},{"literal_text_all_w_t_and_m_t":"[4]3GPP TS 38.323: \"NR; Packet Data Convergence Protocol (PDCP) protocol specification\".","paragraph_zero_based":123},{"literal_text_all_w_t_and_m_t":"[5]3GPP TS 38.331: \"NR; Radio Resource Control (RRC); Protocol specification\".","paragraph_zero_based":124},{"literal_text_all_w_t_and_m_t":"[6]3GPP TS 38.213: \"NR; Physical Layer Procedures for control\".","paragraph_zero_based":125},{"literal_text_all_w_t_and_m_t":"[7]3GPP TS 38.214: \"NR; Physical Layer Procedures for data\".","paragraph_zero_based":126},{"literal_text_all_w_t_and_m_t":"[8]3GPP TS 38.211: \"NR; Physical channels and modulation\".","paragraph_zero_based":127},{"literal_text_all_w_t_and_m_t":"[9]3GPP TS 38.212: \"NR; Multiplexing and channel coding\".","paragraph_zero_based":128},{"literal_text_all_w_t_and_m_t":"[10]Void.","paragraph_zero_based":129},{"literal_text_all_w_t_and_m_t":"[11]3GPP TS 38.133: \"NR; Requirements for support of radio resource management\".","paragraph_zero_based":130},{"literal_text_all_w_t_and_m_t":"[12]3GPP TS 36.133: \"Evolved Universal Terrestrial Radio Access (E-UTRA); Requirements for support of radio resource management\".","paragraph_zero_based":131},{"literal_text_all_w_t_and_m_t":"[13]3GPP TS 26.114: \"Technical Specification Group Services and System Aspects; IP Multimedia Subsystem (IMS); Multimedia Telephony; Media handling and interaction\".","paragraph_zero_based":132},{"literal_text_all_w_t