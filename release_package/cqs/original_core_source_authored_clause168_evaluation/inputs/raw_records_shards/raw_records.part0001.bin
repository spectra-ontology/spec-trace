{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    slots80                             INTEGER(0..79),","paragraph_zero_based":17328},{"literal_text_all_w_t_and_m_t":"    slots160                            INTEGER(0..159),","paragraph_zero_based":17329},{"literal_text_all_w_t_and_m_t":"    slots320                            INTEGER(0..319)","paragraph_zero_based":17330},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":17331},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17332},{"literal_text_all_w_t_and_m_t":"PUCCH-CSI-Resource ::=              SEQUENCE {","paragraph_zero_based":17333},{"literal_text_all_w_t_and_m_t":"    uplinkBandwidthPartId               BWP-Id,","paragraph_zero_based":17334},{"literal_text_all_w_t_and_m_t":"    pucch-Resource                      PUCCH-ResourceId","paragraph_zero_based":17335},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":17336},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17337},{"literal_text_all_w_t_and_m_t":"PortIndexFor8Ranks ::=              CHOICE {","paragraph_zero_based":17338},{"literal_text_all_w_t_and_m_t":"    portIndex8                          SEQUENCE{","paragraph_zero_based":17339},{"literal_text_all_w_t_and_m_t":"        rank1-8                             PortIndex8                                                      OPTIONAL,   -- Need R","paragraph_zero_based":17340},{"literal_text_all_w_t_and_m_t":"        rank2-8                             SEQUENCE(SIZE(2)) OF PortIndex8                                 OPTIONAL,   -- Need R","paragraph_zero_based":17341},{"literal_text_all_w_t_and_m_t":"        rank3-8                             SEQUENCE(SIZE(3)) OF PortIndex8                                 OPTIONAL,   -- Need R","paragraph_zero_based":17342},{"literal_text_all_w_t_and_m_t":"        rank4-8                             SEQUENCE(SIZE(4)) OF PortIndex8                                 OPTIONAL,   -- Need R","paragraph_zero_based":17343},{"literal_text_all_w_t_and_m_t":"        rank5-8                             SEQUENCE(SIZE(5)) OF PortIndex8                                 OPTIONAL,   -- Need R","paragraph_zero_based":17344},{"literal_text_all_w_t_and_m_t":"        rank6-8                             SEQUENCE(SIZE(6)) OF PortIndex8                                 OPTIONAL,   -- Need R","paragraph_zero_based":17345},{"literal_text_all_w_t_and_m_t":"        rank7-8                             SEQUENCE(SIZE(7)) OF PortIndex8                                 OPTIONAL,   -- Need R","paragraph_zero_based":17346},{"literal_text_all_w_t_and_m_t":"        rank8-8                             SEQUENCE(SIZE(8)) OF PortIndex8                                 OPTIONAL    -- Need R","paragraph_zero_based":17347},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":17348},{"literal_text_all_w_t_and_m_t":"    portIndex4                          SEQUENCE{","paragraph_zero_based":17349},{"literal_text_all_w_t_and_m_t":"        rank1-4                             PortIndex4                                                      OPTIONAL,   -- Need R","paragraph_zero_based":17350},{"literal_text_all_w_t_and_m_t":"        rank2-4                             SEQUENCE(SIZE(2)) OF PortIndex4                                 OPTIONAL,   -- Need R","paragraph_zero_based":17351}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["b1493869caf3ab20e14e8ad30932ec09ab143e8482cc643311418a962cd42248","9c09e1d614abf66129f6790a697e9b30d8bc70a21a8515b2ec699db6d74128f7","cd2197d30b47d3765df870826a3963897f6e