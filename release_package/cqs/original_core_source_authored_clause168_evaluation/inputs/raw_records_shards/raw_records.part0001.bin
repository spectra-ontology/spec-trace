{"fields":{"filename":"R2-2401316.zip::R2-2401316 BLE.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"bt-Modes","paragraph_zero_based":480},{"literal_text_all_w_t_and_m_t":"This field specifies the Bluetooth mode(s) supported by the target device. This is represented by a bit string, with a one value at the bit position means the Bluetooth mode is supported; a zero value means not supported.","paragraph_zero_based":481},{"literal_text_all_w_t_and_m_t":"bt-MeasSupported","paragraph_zero_based":482},{"literal_text_all_w_t_and_m_t":"This field specifies the Bluetooth measurements supported by the target device. This is represented by a bit string, with a onevalue at the bit position means the particular measurement is supported; a zerovalue means not supported. A zero-value in all bit positions in the bit string means only the basic Bluetooth positioning method is supported by the target device which is reporting of the Bluetooth beacon identity. The following bits are assigned for the indicated measurements.","paragraph_zero_based":483},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":484},{"literal_text_all_w_t_and_m_t":"rssi:Bluetooth beacon signal strength at the target device","paragraph_zero_based":485},{"literal_text_all_w_t_and_m_t":"aod: Bluetooth beacon AoD at the target device","paragraph_zero_based":486},{"literal_text_all_w_t_and_m_t":"idleStateForMeasurements","paragraph_zero_based":487},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device requires idle state to perform BT measurements.","paragraph_zero_based":488},{"literal_text_all_w_t_and_m_t":"periodicalReportingSupported","paragraph_zero_based":489},{"literal_text_all_w_t_and_m_t":"This field, if present, specifies the positioning modes for which the target device supports periodicalReporting. This is represented by a bit string, with a one value at the bit position means periodicalReporting for the positioning mode is supported; a zero value means not supported. If this field is absent, the location server may assume that the target device does not support periodicalReporting in CommonIEsRequestLocationInformation.","paragraph_zero_based":490},{"literal_text_all_w_t_and_m_t":"scheduledLocationRequestSupported","paragraph_zero_based":491},{"literal_text_all_w_t_and_m_t":"This field, if present, specifies the positioning modes for which the target device supports scheduled location requests – i.e., supports the IE ScheduledLocationTime in IE CommonIEsRequestLocationInformation – and the time base(s) supported for the scheduled location time for each positioning mode. If this field is absent, the target device does not support scheduled location requests.","paragraph_zero_based":492},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":493},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":494},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":495},{"literal_text_all_w_t_and_m_t":"6.5.7.5Bluetooth Capability Information Request","paragraph_zero_based":496},{"literal_text_all_w_t_and_m_t":"–BT-RequestCapabilities","paragraph_zero_based":497},{"literal_text_all_w_t_and_m_t":"The IE BT-RequestCapabilities is used by the location server to request Bluetooth positioning capabilities from a target device.","paragraph_zero_based":498},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":499},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":500},{"literal_text_all_w_t_and_m_t":"BT-RequestCapabilities-r13 ::= SEQUENCE {","paragraph_zero_based":501},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":502},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"038bee5e08277a518e210695a9ad796eb7669167fb359201516fcfc3784430d8","origina