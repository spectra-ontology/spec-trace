{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SIB5 contains information relevant only for inter-RAT cell re-selection i.e. information about E-UTRA frequencies and E-UTRAs neighbouring cells relevant for cell re-selection. The IE includes cell re-selection parameters common for a frequency.","paragraph_zero_based":13608},{"literal_text_all_w_t_and_m_t":"SIB5 information element","paragraph_zero_based":13609},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":13610},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB5-START","paragraph_zero_based":13611},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13612},{"literal_text_all_w_t_and_m_t":"SIB5 ::=                            SEQUENCE {","paragraph_zero_based":13613},{"literal_text_all_w_t_and_m_t":"    carrierFreqListEUTRA                CarrierFreqListEUTRA                        OPTIONAL,       -- Need R","paragraph_zero_based":13614},{"literal_text_all_w_t_and_m_t":"    t-ReselectionEUTRA                  T-Reselection,","paragraph_zero_based":13615},{"literal_text_all_w_t_and_m_t":"    t-ReselectionEUTRA-SF               SpeedStateScaleFactors                      OPTIONAL,       -- Need S","paragraph_zero_based":13616},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension            OCTET STRING                                OPTIONAL,","paragraph_zero_based":13617},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":13618},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":13619},{"literal_text_all_w_t_and_m_t":"    carrierFreqListEUTRA-v1610      CarrierFreqListEUTRA-v1610                      OPTIONAL        -- Need R","paragraph_zero_based":13620},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":13621},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":13622},{"literal_text_all_w_t_and_m_t":"    carrierFreqListEUTRA-v1700      CarrierFreqListEUTRA-v1700                      OPTIONAL,       -- Need R","paragraph_zero_based":13623},{"literal_text_all_w_t_and_m_t":"    idleModeMeasVoiceFallback-r17   ENUMERATED{true}                                OPTIONAL        -- Need R","paragraph_zero_based":13624},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":13625},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":13626},{"literal_text_all_w_t_and_m_t":"    carrierFreqListEUTRA-v18xy      CarrierFreqListEUTRA-v18xy                      OPTIONAL        -- Need R","paragraph_zero_based":13627},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":13628},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":13629},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13630},{"literal_text_all_w_t_and_m_t":"CarrierFreqListEUTRA ::=            SEQUENCE (SIZE (1..maxEUTRA-Carrier)) OF CarrierFreqEUTRA","paragraph_zero_based":13631}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["0704e967cee57554c96efad4d01bf7c8dadd49071c8093133c066630d2c0fe10","b2cfe2c237d3e460b0a0734bd24e12e26d67103eae3f223f1bdba03584373f10","2ce3ee012b0dfa8669997d63081a11129185a0aab8ce32270a076dcce2b67d6e","d3f1917de4a52b97f871d61a9611075fc165a11a158c85c102a191bfb50e9b7e","9719e6f8c2fbba55eb80090498646cd52f175a2e95e925f51bd73bf950353bc2","598ebcb1bd4d093413394faf1b86a76466084d0ff9439c59cb761b377fc20158","dc403eacba20de2d37ce7e6ce592a675280b342e1241952243a14733ae972e87","b3cdb4ec60ded2cb4bb022ff16c211f13e3e907024401df49928962be9880469","c64c8adc913694ea7ebb05f1be3e59a14973c5594d888f75196e55aa2fe44e98","11faf72eb6e407c326cbf3ac514180b4aa5ee