{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-GAPPRIORITY-STOP","paragraph_zero_based":18840},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18841},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18842},{"literal_text_all_w_t_and_m_t":"–HighSpeedConfig","paragraph_zero_based":18843},{"literal_text_all_w_t_and_m_t":"The IE HighSpeedConfig is used to configure parameters for high speed scenarios.","paragraph_zero_based":18844},{"literal_text_all_w_t_and_m_t":"HighSpeedConfig information element","paragraph_zero_based":18845},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18846},{"literal_text_all_w_t_and_m_t":"-- TAG-HIGHSPEEDCONFIG-START","paragraph_zero_based":18847},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18848},{"literal_text_all_w_t_and_m_t":"HighSpeedConfig-r16 ::=  SEQUENCE {","paragraph_zero_based":18849},{"literal_text_all_w_t_and_m_t":"    highSpeedMeasFlag-r16    ENUMERATED {true}        OPTIONAL,   -- Cond SpCellOnly","paragraph_zero_based":18850},{"literal_text_all_w_t_and_m_t":"    highSpeedDemodFlag-r16   ENUMERATED {true}        OPTIONAL,   -- Need R","paragraph_zero_based":18851},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":18852},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18853},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18854},{"literal_text_all_w_t_and_m_t":"HighSpeedConfig-v1700 ::=  SEQUENCE {","paragraph_zero_based":18855},{"literal_text_all_w_t_and_m_t":"    highSpeedMeasCA-Scell-r17    ENUMERATED {true}        OPTIONAL,   -- Cond SCellOnly","paragraph_zero_based":18856},{"literal_text_all_w_t_and_m_t":"    highSpeedMeasInterFreq-r17   ENUMERATED {true}        OPTIONAL,   -- Cond SpCellOnly2","paragraph_zero_based":18857},{"literal_text_all_w_t_and_m_t":"    highSpeedDemodCA-Scell-r17   ENUMERATED {true}        OPTIONAL,   -- Need R","paragraph_zero_based":18858},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":18859},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18860},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18861},{"literal_text_all_w_t_and_m_t":"HighSpeedConfigFR2-r17 ::=  SEQUENCE {","paragraph_zero_based":18862},{"literal_text_all_w_t_and_m_t":"    highSpeedMeasFlagFR2-r17                    ENUMERATED {set1, set2}                       OPTIONAL,   -- Need R","paragraph_zero_based":18863}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["b5acb1426fd8b5ffc8ff8b7139c60f790ed6e9a949793e952c368d3dd5042c19","c75b3bda1bcca08e8ab07ff0f2f71c160866ded5b0975644c4b705c72aeff006","b9e7aa294b5d519ab2408081d61a09d77fb7e75a7d9572e57ef8a150f3431105","7bd1a0b8221a9a10972680a5fea1da7181935c8ffbff15761ffe7366bae3187e","5866586d5ca1e3e67c1545a271a8faad2da5571c772fc0c690995c3c658db42c","defedfe814862f5a540df5d53397ac514b1a753f009f693c9373036d6d682cd3","5c97432365fdbc594d099df4535217b18f5491271a7eb1b341722fa349270a78","3c5410deb12ed6617d842bc651f172e720212964f8acba28d004d18a0d6daab1","9ddc7dbd99c4143d645bd96f28ee3494e49ace6f114ce7f387acff79e9eabe97","9cf0f03fbfdf80fa732c3366f8cbf59db3e00e8fc69a7bdba303b782f348a0f4","129be099b41c92dafbdf4dee91e35e8ddaadc0143a1ef90bff993893dabbb9fa","55dba7aed5d9e1016e416202acd216e612585a94c5cc39c2ba348b2e72c3a44e","bae4e3b73e764750796da5d83327606215286c088d9db5abf2ed8b1793c31621","cb1ee51f4f3e929dc0a70d599b4c556f6da7a855d8474c9f824e02d19362ed4c","f6676c05768ad3ef0d285a86b24aff6a04c226c8a0c1358e96cc23db6ac4949c","c3f68f29fb99f28fc5e0b45593cd515026519e891fb92cc5ccad9c20d9a97fd5","10381c5586dd8bb11fe31bf1ddb2d7afe5d7bffce36a72d95ad24fe604476991","02f6124e206bb3c71e5ec2ad01849448ca0f47e29cd79ecf8bc19dcb8a15ff43","14b17cec2f978a17be9e88eddff4da02e9f4a2c482f4432d7321dc04cae35ee3","4d9b0f95838994d5e6bc155ab5334305e6fc7220e912b6cd10cad213614b3a36","f79e11c5499a9002cf83ad30aa9bffd854f6f87bcad6c9cdb8c7e721dfbec1b5","492d8daa18ed38381d927f41e037403041dce569f578c13afb9a7ffa1cba02ef","fce0c1f25b41769836520303de52e2c5b6e756bb4f49d3e22f70d2f5422765f2","2a86870c9d2ea8e15362d359d19f94b834532a700c89582ec70c665ef4937861"],"paragraph_range_zero_based":[18840,18863],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p18840"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    highSpeedDeploymentTypeFR2-r17              ENUMERATED {unidirectional, bidirectional}    OPTIONAL,   -- Need R","paragraph_zero_based":18864},{"literal_text_all_w_t_and_m_t":"    highSpeedLargeOneStepUL-TimingFR2-r17       ENUMERATED {true}                             OPTIONAL,   -- Need R","paragraph_zero_based":18865},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":18866},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18867},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18868},{"literal_text_all_w_t_and_m_t":"-- TAG-HIGHSPEEDCONFIG-STOP","paragraph_zero_based":18869},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18870},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18871},{"literal_text_all_w_t_and_m_t":"HighSpeedConfig field descriptions","paragraph_zero_based":18872},{"literal_text_all_w_t_and_m_t":"HighSpeedDemodCA-Scell","paragraph_zero_based":18873},{"literal_text_all_w_t_and_m_t":"If the field is present and UE supports demodulationEnhancementCA-r17, the UE shall apply the enhanced demodulation processing for HST-SFN joint transmission scheme with velocity up to 500km/h as specified in TS 38.101-4 [59]. This parameter only applies to SCell.","paragraph_zero_based":18874},{"literal_text_all_w_t_and_m_t":"highSpeedDemodFlag","paragraph_zero_based":18875},{"literal_text_all_w_t_and_m_t":"If the field is present and UE supports demodulationEnhancement-r16, the UE shall apply the enhanced demodulation processing for HST-SFN joint transmission scheme with velocity up to 500km/h as specified in TS 38.101-4 [59]. This parameter only applies to SpCell.","paragraph_zero_based":18876},{"literal_text_all_w_t_and_m_t":"highSpeedDeploymentTypeFR2","paragraph_zero_based":18877},{"literal_text_all_w_t_and_m_t":"If the field is present, and field value is unidirectional, the UE shall assume uni-directional deployment or if field value is birectional the UE shall assume bidirectional deployment for FR2 up to 350km/h as specified in TS 38.133 [14].","paragraph_zero_based":18878},{"literal_text_all_w_t_and_m_t":"highSpeedLargeOneSteptUL-TimingFR2","paragraph_zero_based":18879},{"literal_text_all_w_t_and_m_t":"If the field is present, large one step UE autonomous uplink transmit timing adjustment for FR2 up to 350km/h as specified in TS 38.133 [14] is enabled.","paragraph_zero_based":18880},{"literal_text_all_w_t_and_m_t":"highSpeedMeasCA-Scell","paragraph_zero_based":18881},{"literal_text_all_w_t_and_m_t":"If the field is present and UE supports measurementEnhancementCA-r17, the UE shall apply the enhanced RRM requirements to the serving frequency of SCell for carrier aggregation to support high speed up to 500 km/h as specified in TS 38.133 [14].","paragraph_zero_based":18882},{"literal_text_all_w_t_and_m_t":"highSpeedMeasFlag","paragraph_zero_based":18883},{"literal_text_all_w_t_and_m_t":"If the field is present and UE supports measurementEnhancement-r16, the UE shall apply the enhanced intra-NR and inter-RAT EUTRAN RRM requirements to support high speed up to 500 km/h as specified in TS 38.133 [14].","paragraph_zero_based":18884},{"literal_text_all_w_t_and_m_t":"If the field is present and UE supports intraNR-MeasurementEnhancement-r16, the UE shall apply enhanced intra-NR RRM requirement to support high speed up to 500 km/h as specified in TS 38.133 [14].","paragraph_zero_based":18885},{"literal_text_all_w_t_and_m_t":"If the field is present and UE supports interRAT-MeasurementEnhancement-r16, the UE shall apply enhanced inter-RAT EUTRAN RRM requirement to support high speed up to 500 km/h as specified in TS 38.133 [14].","paragraph_zero_based":18886},{"literal_text_all_w_t_and_m_t":"This parameter only applies to the serving frequency of SpCell.","paragraph_zero_based":18887}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["1179785d6e16f551fed089176546bc336da8004c92df10d2078304b57cce0879","6596c11d043c9ebbf8175f96a81d638f6ead3ababa62b3de2fe8d6c7a9e25d37","424a8fb6f2b2077723385862c9cf15f579dad40fc0be945a06619c91d4d83386","0f6ea56d52f03e4c5786531fbeffea1540bf77c6acac863ad7062137a7e65c19","5375aa567733b91206170ab1ec854ece2bd02510ba27b2e55779a68e54cf68d1","48b776a85ad4761dcd9e9ab69134bfefdba509b80800600ab259570544a7149b","9fbe29501b393ee565d30206d2b20cbf49e842e534c72dd36b1c40912aca95b0","2fe3a570210f932e6c4b42276dfbf45efa098e1cf56c09ecb1d8ef55253c9250","e1f410a938559a1c168a1d859af84653143d55d0d8e6a60f4e545b183f2a8b3c","dc5d2a4a9a23ec11386b22ddbac04ed3c9e0217937607b2893629ca7f493ea61","4e015e54124139b2e9262f48c042202f1fa0d39057daa489e2d0411e88ed5129","1594ea20705e815309b2264a397327dbb40eaabc618d75e6bab2382b1fa41aeb","f50a8cbc5fb966687156b90d5fb8a22d67617e048d8eb1b4997184d63a8b92cb","bc6cd113dcda9c7757ac48994fdaa5e8515ae6edb04f53dee6adebb38feb4ea3","720f8bf3436871061688f6a753707dee7a66685d42ff900468efbc79db5ab11e","950a3ce89f22e030aa1d4d6e40c8adc7ba58f667e55f09c76fa4be0eadd18be0","0d694aac071179aaac92fa64b0abed627cb563fb07a20ba6e7e44d10cc05d50e","7186dce812528899e333de4f6ca6bbc00ee669959e381dc870d22695d7afba5d","004e5dee227f6092b2028b159737c7ae3f87a5a6f8df815b9f8c33667485b527","f633dc6ec36a7ebb6d536193780191563776dbb1675bc47e2227bfb7db13eaa0","e569cfcbad81ebc47b1ac75dcc61f3b089ce8aa7048c6bf899d7712b9036fd0d","dd7aa7c0eadec3111390e98dcdae4fc1fcdc4f1c86fd6d0843f01eebabe2abef","fa8d433e56415a9d27544d122e6d7b68fb1cd302b01f181163b400097b998263","31786f795b1bf87dac72f7f3bb13b63a7dde0197a5299fd9344dbec043fd2e35"],"paragraph_range_zero_base