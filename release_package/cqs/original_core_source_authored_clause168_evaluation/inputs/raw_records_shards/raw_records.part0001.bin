ph_zero_based":31983},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31984},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETDOWNLINK-STOP","paragraph_zero_based":31985},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":31986},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31987},{"literal_text_all_w_t_and_m_t":"FeatureSetDownlink field descriptions","paragraph_zero_based":31988},{"literal_text_all_w_t_and_m_t":"featureSetListPerDownlinkCC","paragraph_zero_based":31989},{"literal_text_all_w_t_and_m_t":"Indicates which features the UE supports on the individual DL carriers of the feature set (and hence of a band entry that refer to the feature set). The UE shall hence include at least as many FeatureSetDownlinkPerCC-Id in this list as the number of carriers it supports according to the ca-BandwidthClassDL, except if indicating additional functionality by reducing the number of FeatureSetDownlinkPerCC-Id in the feature set (see NOTE 1 in FeatureSetCombination IE description). The order of the elements in this list is not relevant, i.e., the network may configure any of the carriers in accordance with any of the FeatureSetDownlinkPerCC-Id in this list.","paragraph_zero_based":31990},{"literal_text_all_w_t_and_m_t":"supportedSRS-Resources","paragraph_zero_based":31991}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["f133b536eee8f49bacc1266a2447306bd0531e65c56ad5c24036335e2721e796","0beae2540e2d5f610da1ca37495c066f1c6501c8ae0d62275eae7d2bc2c5172a","4fee4d188f118f5c5f309ba7b09590205342490b49b148ae61574d19078855fc","a38202fb9f687e8b14422fbb12b5fb938f4abb924245e3315fb0ab7d3c00ad94","06d3ce6b7e0a0e048810d08bf5da2b10496aa322806bd9d937