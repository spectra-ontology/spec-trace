{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"QuantityConfigNR field descriptions","paragraph_zero_based":24744},{"literal_text_all_w_t_and_m_t":"quantityConfigCell","paragraph_zero_based":24745},{"literal_text_all_w_t_and_m_t":"Specifies L3 filter configurations for cell measurement results for the configurable RS Types (e.g. SS/PBCH block and CSI-RS) and the configurable measurement quantities (e.g. RSRP, RSRQ and SINR).","paragraph_zero_based":24746},{"literal_text_all_w_t_and_m_t":"quantityConfigRS-Index","paragraph_zero_based":24747},{"literal_text_all_w_t_and_m_t":"Specifies L3 filter configurations for measurement results per RS index for the configurable RS Types (e.g. SS/PBCH block and CSI-RS) and the configurable measurement quantities (e.g. RSRP, RSRQ and SINR).","paragraph_zero_based":24748},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24749},{"literal_text_all_w_t_and_m_t":"QuantityConfigRS field descriptions","paragraph_zero_based":24750},{"literal_text_all_w_t_and_m_t":"csi-RS-FilterConfig","paragraph_zero_based":24751},{"literal_text_all_w_t_and_m_t":"CSI-RS based L3 filter configurations:","paragraph_zero_based":24752},{"literal_text_all_w_t_and_m_t":"Specifies L3 filter configurations for CSI-RSRP, CSI-RSRQ and CSI-SINR measurement results from the L1 filter(s), as defined in TS 38.215 [9].","paragraph_zero_based":24753},{"literal_text_all_w_t_and_m_t":"ssb-FilterConfig","paragraph_zero_based":24754},{"literal_text_all_w_t_and_m_t":"SS Block based L3 filter configurations:","paragraph_zero_based":24755},{"literal_text_all_w_t_and_m_t":"Specifies L3 filter configurations for SS-RSRP, SS-RSRQ and SS-SINR measurement results from the L1 filter(s), as defined in TS 38.215 [9].","paragraph_zero_based":24756},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24757},{"literal_text_all_w_t_and_m_t":"QuantityConfigUTRA-FDD field descriptions","paragraph_zero_based":24758},{"literal_text_all_w_t_and_m_t":"filterCoefficientRSCP","paragraph_zero_based":24759},{"literal_text_all_w_t_and_m_t":"Specifies L3 filter coefficient for FDD UTRAN CPICH_RSCP measuement results from L1 filter.","paragraph_zero_based":24760},{"literal_text_all_w_t_and_m_t":"filterCoefficientEcN0","paragraph_zero_based":24761},{"literal_text_all_w_t_and_m_t":"Specifies L3 filter coefficient for FDD UTRAN CPICH_EcN0 measuement results from L1 filter.","paragraph_zero_based":24762},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24763},{"literal_text_all_w_t_and_m_t":"–RACH-ConfigCommon","paragraph_zero_based":24764},{"literal_text_all_w_t_and_m_t":"The IE RACH-ConfigCommon is used to specify the cell specific random-access parameters.","paragraph_zero_based":24765},{"literal_text_all_w_t_and_m_t":"RACH-ConfigCommon information element","paragraph_zero_based":24766},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":24767}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["4ebc61174312717cf031e8bde989594fc23ff55a45d5c6ec77597262c34764cc","7879098e5083c64b72b3a7635abf3d445b8c5911537575c3467d886ac8e33fa4","2f7b03cb6530c298ba50dae884a765e8ab0ddc3dd1751fd72a38264a21e11507","ccbf78579f2b5f0405bcbc3a03f86ec9c3d3c43b610963192642ed36212fc55f","7ce4a96ecc900779edbb58057458b8ca9c2b2d8bb7fa981b64e061f110ffc273","05106613b3a8467b352ae5a3efda4ea66920dac25df08cebc8225115a6f74b18","c072b7118bcf5b9c6cae58fd590fc8a10f8733f3b74d44f5ac25cfbdf657b8a3","9bc8560ca35a548942e04ad1dce0f35d551123e5d58667fc81c76b0ff8a7e62b","13b80cf2ac6bbbe5c18e7274b7431ce3225c787e30a0092fa41a650a4cd17a0c