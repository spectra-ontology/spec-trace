{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The field is mandatory present at RLC bearer setup. It is optionally present, need M, at RLC re-establishment. Otherwise it is absent. Need M.","paragraph_zero_based":26832},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26833},{"literal_text_all_w_t_and_m_t":"–RLF-TimersAndConstants","paragraph_zero_based":26834},{"literal_text_all_w_t_and_m_t":"The IE RLF-TimersAndConstants is used to configure UE specific timers and constants.","paragraph_zero_based":26835},{"literal_text_all_w_t_and_m_t":"RLF-TimersAndConstants information element","paragraph_zero_based":26836},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26837},{"literal_text_all_w_t_and_m_t":"-- TAG-RLF-TIMERSANDCONSTANTS-START","paragraph_zero_based":26838},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26839},{"literal_text_all_w_t_and_m_t":"RLF-TimersAndConstants ::=          SEQUENCE {","paragraph_zero_based":26840},{"literal_text_all_w_t_and_m_t":"    t310                                ENUMERATED {ms0, ms50, ms100, ms200, ms500, ms1000, ms2000, ms4000, ms6000},","paragraph_zero_based":26841},{"literal_text_all_w_t_and_m_t":"    n310                                ENUMERATED {n1, n2, n3, n4, n6, n8, n10, n20},","paragraph_zero_based":26842},{"literal_text_all_w_t_and_m_t":"    n311                                ENUMERATED {n1, n2, n3, n4, n5, n6, n8, n10},","paragraph_zero_based":26843},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":26844},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":26845},{"literal_text_all_w_t_and_m_t":"    t311                                ENUMERATED {ms1000, ms3000, ms5000, ms10000, ms15000, ms20000, ms30000}","paragraph_zero_based":26846},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":26847},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":26848},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26849},{"literal_text_all_w_t_and_m_t":"-- TAG-RLF-TIMERSANDCONSTANTS-STOP","paragraph_zero_based":26850},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26851},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26852},{"literal_text_all_w_t_and_m_t":"RLF-TimersAndConstants field descriptions","paragraph_zero_based":26853},{"literal_text_all_w_t_and_m_t":"n3xy","paragraph_zero_based":26854},{"literal_text_all_w_t_and_m_t":"Constants are described in clause 7.3. Value n1 corresponds to 1, value n2 corresponds to 2 and so on.","paragraph_zero_based":26855}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["1d6859be86ea87e7ffc71e64f6786201b9f56f3785da1a8cb2d99645a57e33dd","997e565b6e6b692321298ee3bf8fd82daa6af702a4bc3bfbfe4a4384647b74fa","99c6a8f333148d31cedbde713d1317d4336f70345257b507c378cedae8756843","920ae438ba860bb813de961bd55d7f556b14e742a7f2db8be6568427f957ca2a","cb4cbe70dd525aced09ec40307d97389637ce53ac6cd5cfdee51bf94860bf00c","82fafa906a2184fbbe61d994e52bd86b5167c54578a271fe7c6236c7e351f783","c6f8ea6ce2f5c367877dfdcd41857e87bcfc580bfb3d2144c99995c52d6ffa3c","67052a5d45b7e3fa772668c9dbd1c47b90b34138dd8dc4aaf884ce8b221c19a5","0287ee8f0d31f5942d18b5bca2ee9ac3a99cc74dcd9e0a732bd55efe6496c991","52238105c1a25a3c393f3d7ee1cd8b506e92b2aebed7abd081b7a9280ce3f5aa","8ce8b1cad216a70dca112152680b4d3b05fe40598626383cd8cafc1bfbaf94ad","3829da39ad8ed26896d5390ebf3b7e7600fd7cfbc8fd5e8242d78747274e417c","e4fd381b1e974c30c3e4cba4cad42eca20eb6220a012825ef793a9eb889dca70","44642ff0ff48c5122830d7ff9fb373808858b7181e78a52c74eafdd68a8