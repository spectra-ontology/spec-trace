{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":9768},{"literal_text_all_w_t_and_m_t":"HO-ToEPCUTRAN","paragraph_zero_based":9769},{"literal_text_all_w_t_and_m_t":"This field is mandatory present in case of inter system handover to \"EPC\" or \"FDD UTRAN\". Otherwise it is absent.","paragraph_zero_based":9770},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9771},{"literal_text_all_w_t_and_m_t":"–Paging","paragraph_zero_based":9772},{"literal_text_all_w_t_and_m_t":"The Paging message is used for the notification of one or more UEs.","paragraph_zero_based":9773},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: N/A","paragraph_zero_based":9774},{"literal_text_all_w_t_and_m_t":"RLC-SAP: TM","paragraph_zero_based":9775},{"literal_text_all_w_t_and_m_t":"Logical channel: PCCH","paragraph_zero_based":9776},{"literal_text_all_w_t_and_m_t":"Direction: Network to UE","paragraph_zero_based":9777},{"literal_text_all_w_t_and_m_t":"Paging message","paragraph_zero_based":9778},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":9779},{"literal_text_all_w_t_and_m_t":"-- TAG-PAGING-START","paragraph_zero_based":9780},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9781},{"literal_text_all_w_t_and_m_t":"Paging ::=                          SEQUENCE {","paragraph_zero_based":9782},{"literal_text_all_w_t_and_m_t":"    pagingRecordList                    PagingRecordList                                                        OPTIONAL, -- Need N","paragraph_zero_based":9783},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension            OCTET STRING                                                            OPTIONAL,","paragraph_zero_based":9784},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                Paging-v1700-IEs                    