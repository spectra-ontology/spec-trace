ificCarrier information element","paragraph_zero_based":27114},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27115},{"literal_text_all_w_t_and_m_t":"-- TAG-SCS-SPECIFICCARRIER-START","paragraph_zero_based":27116},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27117},{"literal_text_all_w_t_and_m_t":"SCS-SpecificCarrier ::=             SEQUENCE {","paragraph_zero_based":27118},{"literal_text_all_w_t_and_m_t":"    offsetToCarrier                     INTEGER (0..2199),","paragraph_zero_based":27119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["d58f79ff9662c12df29594ea8c4f842615e88554daa2b25dc15edf1e4e74551c","fd20a4c1a09958d0481bf4c5ff19dfe665516dec350c0d771ee561221cd2904d","86a27477f16a3c80c2c19833fcc541300d579394171b723edb3dfec4c37d58c4","4afb5471d68f6df5483632e9f6ea4c2b9150f1ea2e557ded551df5386fac305a","2b7663f15f0ee7a88c9c116331c4c69173e6181c6bf7217b4b201876d975c6fc","918e018ad81a4da6e3835f5b656d50db1bc20b8fc95352682e50ba806242523c","9cd4db835ed13557016082d3f3b8c11600a5ee62bbb9b5a3312153c8d2f40148","55eed9bb337655ef8bec55371a1e2468c0c4e7b42ba26243f362208aad075e2d","6375904deadb78e40182f4a8fc9976d327fd746d2f8db650504a12de2e409e17","96a956726e5c2f5f13531bcabee4ad7f45fa143556c563ab635a468d86b4ec14","64d2ceafd4bc2a3c9541e0f964a6f94a0e504ee7b6f9e7dc417faf37f98d7c5c","ba0dce0e977bd6641a1fdf25634d69ab3a4c4f3b5e611a183d0a207153361e15","9c590dce8bd590f3b24fdff00cd63199c52c8b8c11e6a59bb9460a9f30b68083","984c7f9c6ce7a563d5b171083d2262c1f3b25372914f8a84eadf8b74b3fad63c","cd3f82037a1aa8eefb8f19ed004deed9cd80bf02b45a2362cb0ad57a71978472","a617101de7a4f416edf7ef58b87d5801ee851e7ba7982d5db9d5cd5f83824c83","84defdab147d3ea11c40997e2a1eeb782e9ad4