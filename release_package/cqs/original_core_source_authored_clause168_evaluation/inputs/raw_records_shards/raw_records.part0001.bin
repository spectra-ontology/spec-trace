{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The field is optionally present, need R, if the UE is configured with a PUCCH SCell in this cell group and if the PUCCH-TPC-CommandConfig is provided in the PDCCH-Config for the SpCell.","paragraph_zero_based":24024},{"literal_text_all_w_t_and_m_t":"Otherwise, the field is absent, Need R.","paragraph_zero_based":24025},{"literal_text_all_w_t_and_m_t":"twoPUCCHgroup","paragraph_zero_based":24026},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, if secondary PUCCH group is configured. It is absent otherwise.","paragraph_zero_based":24027},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24028},{"literal_text_all_w_t_and_m_t":"–PUSCH-Config","paragraph_zero_based":24029},{"literal_text_all_w_t_and_m_t":"The IE PUSCH-Config is used to configure the UE specific PUSCH parameters applicable to a particular BWP.","paragraph_zero_based":24030},{"literal_text_all_w_t_and_m_t":"PUSCH-Config information element","paragraph_zero_based":24031},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":24032},{"literal_text_all_w_t_and_m_t":"-- TAG-PUSCH-CONFIG-START","paragraph_zero_based":24033},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24034},{"literal_text_all_w_t_and_m_t":"PUSCH-Config ::=                        SEQUENCE {","paragraph_zero_based":24035},{"literal_text_all_w_t_and_m_t":"    dataScramblingIdentityPUSCH             INTEGER (0..1023)                                                   OPTIONAL,   -- Need S","paragraph_zero_based":24036},{"literal_text_all_w_t_and_m_t":"    txConfig                                ENUMERATED {codebook, nonCodebook}                                  OPTIONAL,   -- Need S","paragraph_zero_based":24037},{"literal_text_all_w_t_and_m_t":"    dmrs-UplinkForPUSCH-MappingTypeA        SetupRelease { DMRS-UplinkConfig }                                  OPTIONAL,   -- Need M","paragraph_zero_based":24038},{"literal_text_all_w_t_and_m_t":"    dmrs-UplinkForPUSCH-MappingTypeB        SetupRelease { DMRS-UplinkConfig }                                  OPTIONAL,   -- Need M","paragraph_zero_based":24039},{"literal_text_all_w_t_and_m_t":"    pusch-PowerControl                      PUSCH-PowerControl                                                  OPTIONAL,   -- Need M","paragraph_zero_based":24040},{"literal_text_all_w_t_and_m_t":"    frequencyHopping                        ENUMERATED {intraSlot, interSlot}                                   OPTIONAL,   -- Need S","paragraph_zero_based":24041},{"literal_text_all_w_t_and_m_t":"    frequencyHoppingOffsetLists             SEQUENCE (SIZE (1..4)) OF INTEGER (1.. maxNrofPhysicalResourceBlocks-1)","paragraph_zero_based":24042},{"literal_text_all_w_t_and_m_t":"                                                                                                                OPTIONAL,   -- Need M","paragraph_zero_based":24043},{"literal_text_all_w_t_and_m_t":"    resourceAllocation                      ENUMERATED { resourceAllocationType0, resourceAllocationType1, dynamicSwitch},","paragraph_zero_based":24044},{"literal_text_all_w_t_and_m_t":"    pusch-TimeDomainAllocationList          SetupRelease { PUSCH-TimeDomainResourceAllocationList }             OPTIONAL,   -- Need M","paragraph_zero_based":24045},{"literal_text_all_w_t_and_m_t":"    pusch-AggregationFactor                 ENUMERATED { n2, n4, n8 }                                           OPTIONAL,   -- Need S","paragraph_zero_based":24046},{"literal_text_all_w_t_and_m_t":"    mcs-Table                               ENUMERATED {qam256, qam64LowSE}                                     OPTIONAL,   -- Need S","paragraph_zero_based":24047}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"d