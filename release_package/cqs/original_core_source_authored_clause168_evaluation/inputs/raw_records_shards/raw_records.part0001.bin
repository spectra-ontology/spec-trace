{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"                                              posSibType1-7, posSibType1-8, posSibType2-1, posSibType2-2, posSibType2-3, posSibType2-4,","paragraph_zero_based":14424},{"literal_text_all_w_t_and_m_t":"                                              posSibType2-5, posSibType2-6, posSibType2-7, posSibType2-8, posSibType2-9, posSibType2-10,","paragraph_zero_based":14425},{"literal_text_all_w_t_and_m_t":"                                              posSibType2-11, posSibType2-12, posSibType2-13, posSibType2-14, posSibType2-15,","paragraph_zero_based":14426},{"literal_text_all_w_t_and_m_t":"                                              posSibType2-16, posSibType2-17, posSibType2-18, posSibType2-19, posSibType2-20,","paragraph_zero_based":14427},{"literal_text_all_w_t_and_m_t":"                                              posSibType2-21, posSibType2-22, posSibType2-23, posSibType3-1, posSibType4-1,","paragraph_zero_based":14428},{"literal_text_all_w_t_and_m_t":"                                              posSibType5-1,posSibType6-1, posSibType6-2, posSibType6-3,... },","paragraph_zero_based":14429},{"literal_text_all_w_t_and_m_t":"    areaScope-r16                ENUMERATED {true}                                              OPTIONAL -- Need S","paragraph_zero_based":14430},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14431},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14432},{"literal_text_all_w_t_and_m_t":"GNSS-ID-r16 ::= SEQUENCE {","paragraph_zero_based":14433},{"literal_text_all_w_t_and_m_t":"    gnss-id-r16              ENUMERATED{gps, sbas, qzss, galileo, glonass, bds, ..., navic-v1760},","paragraph_zero_based":14434},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":14435},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14436},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14437},{"literal_text_all_w_t_and_m_t":"SBAS-ID-r16 ::= SEQUENCE {","paragraph_zero_based":14438},{"literal_text_all_w_t_and_m_t":"    sbas-id-r16              ENUMERATED { waas, egnos, msas, gagan, ...},","paragraph_zero_based":14439},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":14440},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14441},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14442},{"literal_text_all_w_t_and_m_t":"-- TAG-POSSI-SCHEDULINGINFO-STOP","paragraph_zero_based":14443},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":14444},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14445},{"literal_text_all_w_t_and_m_t":"PosSI-SchedulingInfo field descriptions","paragraph_zero_based":14446},{"literal_text_all_w_t_and_m_t":"areaScope","paragraph_zero_based":14447}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["5f0e8cc631291022d6342172851f72175629d7366a81a9867b9bf8e9ff5f9241","762d37ce97ad32fc3272906cda29159edb89c12dc130b6386e55a641f765c60a","444fa0a9e5af508c371ea02248afe19c060b21ff806a639a15accaa069b81822","70943febeb29bb28755e94ad815ef37caffec59bfd2b22d7edd15f0553614ad2","1854c9f8d8195f7ca4c9179a156c9620973eaad23f153120b18c75d16ae8ddaa","c4ceb91dc86c61808a67cc74375ea5570c6b31f0ee5f40ab28e92ce26089c065","d805f18670c6acd5aea0f85e95f3a50536341164008e98be3c92ecc528f80df0","4499b84e6bd5af5867ef3b1ee78fdd6303b617a65d501032ddc73681d6641559","22bf2b5e0fbfd7af2eaf8f61b829318f977d223ebb4815746d071892ca592337","1761d3451174b40c6fe4be40f3d7a321dd0d0929ed76c52ece0091954db26e70","7696f8faa8e567fbad99a3dab41b2cbb4b5ccf8daf1f3daced93b7ce8ab33bf5","49805abf7c5cdaa6d798d3024f36bbb8aa1703341a8abb61cf9ec55c0cda9115","8cbad3c10659ce34471a3016bb7a76de0fff8972c29f14f53b2d4fd50e7dc2e9","f2d8d68be2ef2876f49ac9b5419bec58fa5cfadf8b5864221f0a139e024ea540","83cd95b7e3e5799ab6d3ac96e5ef28e770fffd4b2b3d66a0147caaa297410132","d905bc49d135f405b86d9bea09e70d44d728ef8a20a066ed1b50d72a318c7305","c5f07aaa672f31830924be9a098f1be750468c6f6d50014d83bd760b7cb2d4a7","fcb5417207646dc5a47c0f28a734c1f4450d17c6ba63ac0078ca84dcc231e18e","72b9f18c20360f7450057ef51d8636028936e7664f9b1484a8b94e45f8da4fb1","d256861cea4c7257dd17cb99a461cc18c95ada8b38042dd3c2fb37b2d57aef39","4ec09ff5dce9909fc4f650b890240fcfe8432e0f7bd477a9766c15b47025829e","1ce1751e85a7abdea05778d17e50e0a4f75123d1c417c5a2d51980ad9058f3e7","1a7b085190fbc0972d635a82463eb84139cde52c2930e786381e30235963606a","ebae2e44995068f69adfe99496190a9021eb0ea31ff7722937a138c281dcfcfd"],"paragraph_range_zero_based":[14424,14447],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p14424"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates that a posSIB is area specific. If the field is absent, the posSIB is cell specific.","paragraph_zero_based":14448},{"literal_text_all_w_t_and_m_t":"encrypted","paragraph_zero_based":14449},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that the pos-sib-type is encrypted as specified in TS 37.355 [49].","paragraph_zero_based":14450},{"literal_text_all_w_t_and_m_t":"gnss-id","paragraph_zero_based":14451},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that the positioning SIB type is for a specific GNSS. Indicates a specific GNSS (see also TS 37.355 [49])","paragraph_zero_based":14452},{"literal_text_all_w_t_and_m_t":"posSI-BroadcastStatus","paragraph_zero_based":14453},{"literal_text_all_w_t_and_m_t":"Indicates if the SI message is being broadcasted or not. Change of posSI-BroadcastStatus should not result in system information change notifications in Short Message transmitted with P-RNTI over DCI (see clause 6.5). The value of the indication is valid until the end of the BCCH modification period when set to broadcasting.","paragraph_zero_based":14454},{"literal_text_all_w_t_and_m_t":"If si-SchedulingInfo-v1700 is present, the network ensures that the total number of SI messages with posSI-BroadcastStatus and si-BroadcastStatus set to notBroadcasting in the concatenated list of SI messages configured by posSchedulingInfoList in posSI-SchedulingInfo and SI messages containing type2 SIB configured by schedulingInfoList2 in si-SchedulingInfo-v1700 does not exceed the limit of maxSI-Message when posSI-RequestConfig or posSI-RequestConfigRedCap or posSI-RequestConfigSUL is configured.","paragraph_zero_based":14455},{"literal_text_all_w_t_and_m_t":"posSI-RequestConfig","paragraph_zero_based":14456},{"literal_text_all_w_t_and_m_t":"Configuration of Msg1 resources that the UE uses for requesting SI-messages for which posSI-BroadcastStatus is set to notBroadcasting.","paragraph_zero_based":14457},{"literal_text_all_w_t_and_m_t":"posSI-RequestConfigRedCap","paragraph_zero_based":14458},{"literal_text_all_w_t_and_m_t":"Configuration of Msg1 resources for initialUplinkBWP-RedCap that the RedCap UE uses for requesting SI-messages for which posSI-BroadcastStatus is set to notBroadcasting.","paragraph_zero_based":14459},{"literal_text_all_w_t_and_m_t":"posSI-RequestConfigSUL","paragraph_zero_based":14460},{"literal_text_all_w_t_and_m_t":"Configuration of Msg1 resources that the UE uses for requesting SI-messages for which posSI-BroadcastStatus is set to notBroadcasting.","paragraph_zero_based":14461},{"literal_text_all_w_t_and_m_t":"posSIB-MappingInfo","paragraph_zero_based":14462},{"literal_text_all_w_t_and_m_t":"List of the posSIBs mapped to this SystemInformation message.","paragraph_zero_based":14463},{"literal_text_all_w_t_and_m_t":"posSibType","paragraph_zero_based":14464},{"literal_text_all_w_t_and_m_t":"The positioning SIB type is defined in TS 37.355 [49].","paragraph_zero_based":14465},{"literal_text_all_w_t_and_m_t":"posSI-Periodicity","paragraph_zero_based":14466},{"literal_text_all_w_t_and_m_t":"Periodicity of the SI-message in radio frames, such that rf8 denotes 8 radio frames, rf16 denotes 16 radio frames, and so on. If the offsetToSI-Used is configured, the posSI-Periodicity of rf8 cannot be used.","paragraph_zero_based":14467},{"literal_text_all_w_t_and_m_t":"offsetToSI-Used","paragraph_zero_based":14468},{"literal_text_all_w_t_and_m_t":"This field, if present indicates that all the SI messages in posSchedulingInfoList are scheduled with an offset of 8 radio frames compared to SI messages in schedulingInfoList. offsetToSI-Used may be present only if the shortest configured SI message periodicity for SI messages in schedulingInfoList is 80ms. If SI offset is used, this field is present in each of the SI messages in the posSchedulingInfoList.","paragraph_zero_based":14469},{"literal_text_all_w_t_and_m_t":"sbas-id","paragraph_zero_based":14470},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that the positioning SIB type is for a specific SBAS. Indicates a specific SBAS (see also TS 37.355 [49]).","paragraph_zero_based":14471}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["4088c6ee9a12f4f1c73f8c476ef458ef41388f0788b6135a46822da4bf9e17bd","3fe728332a5d635029cd34e331daf7f1a8f96d5051c7eae03fa1741bcabefadb","4e6a7a0e53bee9435a32e65607fbec87b83f4c8b734bf29925bb2a2ace4d04ba","025939c2239b1bb17619ea43f89d02a07e9e78a40cbae29dfadf596b0615d908","d73ff85f4ed9d5f4ec9c8980df47706630dc3f0242e5542c0489544cb40fbba7","538604db88d7c8988b0baf6a91c4418712f72c329fee81219fa1828861a2ae9e","cf8486f2397e81603f5dd9113cba27b05a7cc5f6e9b70202e0d8563febf3f5d3","3d46f32347e89365e3201724ebbb53099bea7169e46f20d6edee1dcc6e24cedb","b97641b86aebd8664ca6900103de740de2d8d9f7b612cd0865f33dc081a7a67d","761d37f74a7f28c48c0000c803d88f30f2490407477bdc21b2038c7dd4a95c42","30d099e096d5abf75b73059af5db19649cec6d609be7ee5278709c3072178158","0b434ee832c889cc2b8a4f3cb84e9cc3a3fed1b114bb408b6efde18e33d8c315","f1000c2e6bca23892beca23f1ae9a6acdbbc30ba93f43af60134aa134b8a2707","a00f846b7070f773d3abdfb6d902e62f16571878494f95ca161c91ce6e5e5f7d","f53eec1753fc1001859425789e8eb6886f218428ec0fe5586f486cd5bffd7d81","84eef361e732aac9b6fce45bc3704cde3d18be4782be248fdb14263aa9fa77cb","8fac0672d3768ceb102b287053569cc3092b23dbd78936d558e7f18c78d5d015","37eafb233a4bfe53104286f5b30731c8f3369eabc5e9f9ca7c9969464bf562cb","ea17b312910eda69a756a9ff4e54f6e325b9c6c6d799a938929bb11fc2051c92","e0980805fadf596b126b13db373c987327e4b4b38fa0eb6f28f9ff8ac4a3c1c2","8f00be3408a98bdc0c61038c145c20189c46ae6dec0b2b3b6c057e50797a6de0","0ace5a82d5a97b8956d7635cba48a51782df7d2696dd6641e40841cf135bef4e","a5ebef221dfb07b4910da613c3837e70b723011f8310dd30069309bfbabc8021","73d7c0ea16977a3019997d931dd3ed9a23b3afabf5bd18ab72c47142764a1e16"],"paragraph_range_zero_based":[14448,14471],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p14448"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14472},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":14473},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":14474},{"literal_text_all_w_t_and_m_t":"GNSS-ID-SBAS","paragraph_zero_based":14475},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if gnss-id is set to sbas. It is absent otherwise.","paragraph_zero_based":14476},{"literal_text_all_w_t_and_m_t":"MSG-1","paragraph_zero_based":14477},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if posSI-BroadcastStatus is set to notBroadcasting for any SI-message included in posSchedulingInfoList or if si-BroadcastStatus is set to notBroadcasting for any SI-message containing type2 SIB included in schedulingInfoList2. It is absent otherwise.","paragraph_zero_based":14478},{"literal_text_all_w_t_and_m_t":"SUL-MSG-1","paragraph_zero_based":14479},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if supplementaryUplink is configured in ServingCellConfigCommonSIB, and if posSI-BroadcastStatus is set to notBroadcasting for any SI-message included in posSchedulingInfoList or if si-BroadcastStatus is set to notBroadcasting for any SI-message containing type2 SIB included in schedulingInfoList2. It is absent otherwise.","paragraph_zero_based":14480},{"literal_text_all_w_t_and_m_t":"REDCAP-MSG-1","paragraph_zero_based":14481},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if initialUplinkBWP-RedCap is configured in UplinkConfigCommonSIB, and if posSI-BroadcastStatus is set to notBroadcasting for any SI-message included in posSchedulingInfoList or if si-BroadcastStatus is set to notBroadcasting for any SI-message containing type2 SIB included in schedulingInfoList2. It is absent otherwise.","paragraph_zero_based":14482},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14483},{"literal_text_all_w_t_and_m_t":"–SIBpos","paragraph_zero_based":14484},{"literal_text_all_w_t_and_m_t":"The IE SIBpos contains positioning assistance data as defined in TS 37.355 [49].","paragraph_zero_based":14485},{"literal_text_all_w_t_and_m_t":"SIBpos information element","paragraph_zero_based":14486},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":14487},{"literal_text_all_w_t_and_m_t":"-- TAG-SIPOS-START","paragraph_zero_based":14488},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14489},{"literal_text_all_w_t_and_m_t":"SIBpos-r16 ::= SEQUENCE {","paragraph_zero_based":14490},{"literal_text_all_w_t_and_m_t":"    assistanceDataSIB-Element-r16        OCTET STRING,","paragraph_zero_based":14491},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension             OCTET STRING                        OPTIONAL,","paragraph_zero_based":14492},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":14493},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14494},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14495}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["35c0f7329bd2467f363bdd6192a2a69d18f9dce59daaf36591465d829f2d05bb","e6bf1e1046e5f370b5340da86625ff6f757edcfd7e0e920e209b74071cee99de","897cf2ed88c09b180aac25eeeec46e3d9870f64a1a86fa985df9130c10a654e3","dbdeaca7b587a9d641d0f9fbadd3c151fc209186d76f7aaa6e557da6c6a20858","9451c2d2f061ee7cbad4ede282edb9508114118045f556a6e333fb99fd6f0aa3","bbb31f350fac9dfa85e30983016ff09d1f8ce631a66a9b6b45c48e817d1a049c","eb2832f64726fd86effe391aadc40dc0df60b8