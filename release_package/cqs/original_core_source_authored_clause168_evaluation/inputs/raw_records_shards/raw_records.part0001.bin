{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether or not the UE shall initiate the measurement reporting procedure when the leaving condition is met for a CLI measurement resource in srsTriggeredList or rssiTriggeredList, as specified in 5.5.4.1.","paragraph_zero_based":26424},{"literal_text_all_w_t_and_m_t":"timeToTrigger","paragraph_zero_based":26425},{"literal_text_all_w_t_and_m_t":"Time during which specific criteria for the event needs to be met in order to trigger a measurement report.","paragraph_zero_based":26426},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26427},{"literal_text_all_w_t_and_m_t":"CLI-PeriodicalReportConfig field descriptions","paragraph_zero_based":26428},{"literal_text_all_w_t_and_m_t":"maxReportCLI","paragraph_zero_based":26429},{"literal_text_all_w_t_and_m_t":"Max number of CLI measurement resource to include in the measurement report.","paragraph_zero_based":26430},{"literal_text_all_w_t_and_m_t":"reportAmount","paragraph_zero_based":26431},{"literal_text_all_w_t_and_m_t":"Number of measurement reports.","paragraph_zero_based":26432},{"literal_text_all_w_t_and_m_t":"reportQuantityCLI","paragraph_zero_based":26433},{"literal_text_all_w_t_and_m_t":"The CLI measurement quantities to be included in the measurement report.","paragraph_zero_based":26434},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26435},{"literal_text_all_w_t_and_m_t":"PeriodicalReportConfig field descriptions","paragraph_zero_based":26436},{"literal_text_all_w_t_and_m_t":"coarseLocationRequest","paragraph_zero_based":26437},{"literal_text_all_w_t_and_m_t":"This field is used to request UE to report coarse location information.","paragraph_zero_based":26438},{"literal_text_all_w_t_and_m_t":"maxNrofRS-IndexesToReport","paragraph_zero_based":26439},{"literal_text_all_w_t_and_m_t":"Max number of RS indexes to include in the measurement report.","paragraph_zero_based":26440},{"literal_text_all_w_t_and_m_t":"maxReportCells","paragraph_zero_based":26441},{"literal_text_all_w_t_and_m_t":"Max number of non-serving cells to include in the measurement report.","paragraph_zero_based":26442},{"literal_text_all_w_t_and_m_t":"reportAddNeighMeas","paragraph_zero_based":26443},{"literal_text_all_w_t_and_m_t":"Indicates that the UE shall include the best neighbour cells per serving frequency.","paragraph_zero_based":26444},{"literal_text_all_w_t_and_m_t":"reportAmount","paragraph_zero_based":26445},{"literal_text_all_w_t_and_m_t":"Number of measurement reports applicable for eventTriggered as well as for periodical report types","paragraph_zero_based":26446},{"literal_text_all_w_t_and_m_t":"reportQuantityCell","paragraph_zero_based":26447}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["54f43e8a9f9e7b1c283c0e96c4e4a95263f844e7a84973b5b751b9d3fde6a852","9424905b98cbe0172c1cede90e8829dd15d32f92a76bbc444e539b95db41e71d","2f7017903fe6ae69c8a9ef8169e11005290728d18877484befb7fa8caf6f29be","5053bdc0e14f2da60c8161ddf47c7c081d3be6040493b19727d2331ecdb971b7","9c8d4b221c0f0a9009e2c660a856df71062d7674b49bf7425b394f6d0bc4c398","1d1b8d86abc9611eb7e4abf9388e6914ecd49b3dddfe5828695ce8b7bf4a518f","0f979f947b1e4c883588ccf8c9f66c4ebf6acc50af848f755564bbf34e409581","e8c026a8f7b1c892d79739a33ef3680ff96d984c43ece8c2e92587aebd7d63d4","e85759af756b0dedf0d7e014095b9807aa22ac59426eed20cb15c6fb04f1a255","2b6254b68bd6908fdafbf75d7fa8bcbe1e0d3dca0621d8bdb27f693c5fe3e61d","668554ad7e76a86421639f05d811b5120a09a53585b939e60f0e3092e3f3689b","08262138f3b8f12f14c85fcd85b2eeec07874f0b4bd8134f8bbf9c0bdd