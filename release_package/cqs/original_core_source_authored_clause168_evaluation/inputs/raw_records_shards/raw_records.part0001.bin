{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    }                                                 OPTIONAL,","paragraph_zero_based":37032},{"literal_text_all_w_t_and_m_t":"    timeSpent-r17            INTEGER (0..4095),","paragraph_zero_based":37033},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":37034},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37035},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37036},{"literal_text_all_w_t_and_m_t":"-- TAG-VISITEDCELLINFOLIST-STOP","paragraph_zero_based":37037},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":37038},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37039},{"literal_text_all_w_t_and_m_t":"VisitedCellInfoList field descriptions","paragraph_zero_based":37040},{"literal_text_all_w_t_and_m_t":"timeSpent","paragraph_zero_based":37041},{"literal_text_all_w_t_and_m_t":"This field indicates the duration of stay in the cell or in any cell selection state and/or camped on any cell state in NR or E-UTRA approximated to the closest second. If included in VisitedPSCellInfo, it indicates the duration of stay in the PSCell or without any PSCell. If the duration of stay exceeds 4095s, the UE shall set it to 4095s.","paragraph_zero_based":37042},{"literal_text_all_w_t_and_m_t":"visitedCellId","paragraph_zero_based":37043},{"literal_text_all_w_t_and_m_t":"This field indicates the visited cell id including NR and E-UTRA cells.","paragraph_zero_based":37044},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37045},{"literal_text_all_w_t_and_m_t":"–WLAN-NameList","paragraph_zero_based":37046},{"literal_text_all_w_t_and_m_t":"The IE WLAN-NameList is used to indicate the names of the WLAN AP for which the UE is configured to measure.","paragraph_zero_based":37047},{"literal_text_all_w_t_and_m_t":"WLAN-NameList information element","paragraph_zero_based":37048},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":37049},{"literal_text_all_w_t_and_m_t":"-- TAG-WLANNAMELIST-START","paragraph_zero_based":37050},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37051},{"literal_text_all_w_t_and_m_t":"WLAN-NameList-r16 ::= SEQUENCE (SIZE (1..maxWLAN-Name-r16)) OF WLAN-Name-r16","paragraph_zero_based":37052},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37053},{"literal_text_all_w_t_and_m_t":"WLAN-Name-r16 ::= OCTET STRING (SIZE (1..32))","paragraph_zero_based":37054},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37055}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["c90e51cc9fe8ef167eaee6bfdb36ebea285f486c7293806987a194169f9ba037","41e2d9b3b7fc65945df1a1d6f40e77297b2fbc8da790403f7ceb5820e90cf798","6608c0ec0a00c74646bfcc0107e76818931fafa4951fb01f03a870703dea682e","c938b4645b1cb97bbeda0f2d09ae91a83b9a067210c9aa94ef96211e46850962","d644f46a3d49212e8ef5df45575a39ce378e5bb4e65826a9def5a0300ad3c08e","b992231b18ecc2ccda03b6f038b6a88d29c959bf6d57ec0face260a315bcab5e","c1fd2a070f4bb61302d750aa19005cbed426ddccd1a8c406ff33b54cb311c7f9","3f2fbec02732af7e134b12a897713f793f96f2cb2879059b5298db370cddbbb9","036954361c9431b6fd05ce8c1fe3e4132fb02b719341ac7c28197b306f62eaa3","3c96eb44df87ceabc9ab2ecd8bf035fb43a84520a792646802155b4e22bc55d4","bf2b10fbd26b692079798e077d740000ad429f020aaf68b961f00a2b0061277b","55aa9835dc6d3a184af623032b92e0f703cc923ff5f29aecb690139154d4397f","bd313375a9554dfca08da2ee1435bf60737c2e4f156e0bcba2615bb58b3fad66","d98705f91cf923df9d9ed025b7bc910ad67d1e64f721120719f6a302ee6655d8","16f0c9847f0f55ef4a51029958a1ffc