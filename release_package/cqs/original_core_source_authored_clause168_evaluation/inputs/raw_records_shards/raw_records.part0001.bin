d927ab62d06cc","71c60c5f0edf2fc1740075ffa2af5fc0b4bbfeec4a3c722dcf6f29666fbe0827","22bcfaa8c538ff9898b864be57fcd7aa23576fa5715f1b5cad87d9c1e1da578e","bc34d9d5bd9868d5eb8be25a4c8d05e4538dfe2d4797c72a676139cf280ce147","ed7d4118fb314522dcdab367aad21e5a233e0bd64f15ce5a2bf5f858a00949c2","f2c691ad5fdb7c97f14bbe1b411a1093c0d034c97ea4f60c7d7644ba161e41ef","4a72fc5edb95dc11d76e784210a4a60bd0cacb48a302e9dc183ee5fb69e369f3","6e1a7070280f10fe030134ae7949ac6c0978102f75ed455c6ffc0c1ab26cc5f3"],"paragraph_range_zero_based":[25728,25751],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p25728"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25752},{"literal_text_all_w_t_and_m_t":"RepetitionSchemeConfig field descriptions","paragraph_zero_based":25753},{"literal_text_all_w_t_and_m_t":"fdm-TDM","paragraph_zero_based":25754},{"literal_text_all_w_t_and_m_t":"Configures UE with a repetition scheme among fdmSchemeA, fdmSchemeB and tdmSchemeA as specified in clause 5.1 of TS 38.214 [19]. The network does not set this field to release. Upon reception of this field in RepetitionSchemeConfig-r16, the UE shall release slotBased if previously configured in the same instance of RepetitionSchemeConfig-r16.","paragraph_zero_based":25755},{"literal_text_all_w_t_and_m_t":"sequenceOffsetForRV","paragraph_zero_based":25756},{"literal_text_all_w_t_and_m_t":"For slot-based repetition scheme, selected RV sequence is applied to transmission occasions associated to the first TCI state. The RV sequence associated to the second TCI state is determined by a RV offset from that selected RV sequence.","paragraph_zero_based":25757},{"literal_text_all_w_t_and_m_t":"slotBased","paragraph_zero_based":25758},{"literal_text_all_w_t_and_m_t":"Configures UE with slot-based repetition scheme. Network always configures this field when the parameter repetitionNumber is present in IE PDSCH-TimeDomainResourceAllocationList. The network does not set this field to release. Upon reception of this field in RepetitionSchemeConfig-r16, the UE shall release fdm-TDM if previously configured in the same instance of RepetitionSchemeConfig-r16.","paragraph_zero_based":25759},{"literal_text_all_w_t_and_m_t":"startingSymbolOffsetK","paragraph_zero_based":25760},{"literal_text_all_w_t_and_m_t":"The starting symbol of the second transmission occasion has K symbol offset relative to the last symbol of the first transmission occasion. When UE is configured with tdmSchemeA, the parameter startingSymbolOffsetK is present, otherwise absent.","paragraph_zero_based":25761},{"literal_text_all_w_t_and_m_t":"tciMapping","paragraph_zero_based":25762},{"literal_text_all_w_t_and_m_t":"Enables TCI state mapping method to PDSCH transmission occasions.","paragraph_zero_based":25763},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25764},{"literal_text_all_w_t_and_m_t":"–ReportConfigId","paragraph_zero_based":25765},{"literal_text_all_w_t_and_m_t":"The IE ReportConfigId is used to identify a measurement reporting configuration.","paragraph_zero_based":25766},{"literal_text_all_w_t_and_m_t":"ReportConfigId information element","paragraph_zero_based":25767},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25768},{"literal_text_all_w_t_and_m_t":"-- TAG-REPORTCONFIGID-START","paragraph_zero_based":25769},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25770},{"literal_text_all_w_t_and_m_t":"ReportConfigId ::=                          INTEGER (1..maxReportConfigId)","paragraph_zero_based":25771},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25772},{"literal_text_all_w_t_and_m_t":"-- TAG-REPORTCONFIGID-STOP","paragraph_zero_based":25773},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":25774},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25775}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["21e656cee8de47e57a278558247a209bc2789ab9736241414fce9961a20abf9b","9638ce31d829a06d5972315e7aa96c4f5b2472fc4a42ead606e8b5ec6b8c8d1a","ac1ca8498e81022edce9b3060a9fecf94d85fe108ec12d72de054f3cbf96bc89","5773ca545d49563154f575f86fdec81d2ebca0db77229e60cbddbed