{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"UE-CapabilityRAT-ContainerList field descriptions","paragraph_zero_based":36000},{"literal_text_all_w_t_and_m_t":"ue-CapabilityRAT-Container","paragraph_zero_based":36001},{"literal_text_all_w_t_and_m_t":"Container for the UE capabilities of the indicated RAT. The encoding is defined in the specification of each RAT:","paragraph_zero_based":36002},{"literal_text_all_w_t_and_m_t":"For rat-Type set to nr: the encoding of UE capabilities is defined in UE-NR-Capability.","paragraph_zero_based":36003},{"literal_text_all_w_t_and_m_t":"For rat-Type set to eutra-nr: the encoding of UE capabilities is defined in UE-MRDC-Capability.","paragraph_zero_based":36004},{"literal_text_all_w_t_and_m_t":"For rat-Type set to eutra: the encoding of UE capabilities is defined in UE-EUTRA-Capability specified in TS 36.331 [10].","paragraph_zero_based":36005},{"literal_text_all_w_t_and_m_t":"For rat-Type set to utra-fdd: the octet string contains the INTER RAT HANDOVER INFO message defined in TS 25.331 [45].","paragraph_zero_based":36006},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36007},{"literal_text_all_w_t_and_m_t":"–UE-CapabilityRAT-RequestList","paragraph_zero_based":36008},{"literal_text_all_w_t_and_m_t":"The IE UE-CapabilityRAT-RequestList is used to request UE capabilities for one or more RATs from the UE.","paragraph_zero_based":36009},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRAT-RequestList information element","paragraph_zero_based":36010},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36011},{"literal_text_all_w_t_and_m_t":"-- TAG-UE-CAPABILITYRAT-REQUESTLIST-START","paragraph_zero_based":36012},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36013},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRAT-RequestList ::=        SEQUENCE (SIZ