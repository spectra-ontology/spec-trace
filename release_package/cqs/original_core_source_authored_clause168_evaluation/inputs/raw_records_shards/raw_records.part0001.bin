{"fields":{"filename":"R2-2401458.zip::R2-2401458.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"CommonIEsProvideCapabilities ::= SEQUENCE {","paragraph_zero_based":144},{"literal_text_all_w_t_and_m_t":"...,","paragraph_zero_based":145},{"literal_text_all_w_t_and_m_t":"[[","paragraph_zero_based":146},{"literal_text_all_w_t_and_m_t":"segmentationInfo-r14SegmentationInfo-r14OPTIONAL,-- Cond Segmentation","paragraph_zero_based":147},{"literal_text_all_w_t_and_m_t":"lpp-message-segmentation-r14BIT STRING { serverToTarget(0),","paragraph_zero_based":148},{"literal_text_all_w_t_and_m_t":"targetToServer(1) }OPTIONAL","paragraph_zero_based":149},{"literal_text_all_w_t_and_m_t":"]],","paragraph_zero_based":150},{"literal_text_all_w_t_and_m_t":"[[","paragraph_zero_based":151},{"literal_text_all_w_t_and_m_t":"remoteUE-Indication-r18BOOLEANOPTIONAL,-- Cond NR","paragraph_zero_based":152},{"literal_text_all_w_t_and_m_t":"locationEstimateAndMeasurementReporting-r18ENUMERATED { supported }OPTIONAL","paragraph_zero_based":153},{"literal_text_all_w_t_and_m_t":"]]","paragraph_zero_based":154},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":155},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":156},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":157},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":158},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":159},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":160},{"literal_text_all_w_t_and_m_t":"Segmentation","paragraph_zero_based":161},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need OP, if lpp-message-segmentation-req has been received from the location server with bit 1 (targetToServer) set to value 1. The field shall be omitted if lppmessagesegmentation-req has not been received in this location session, or has been received with bit 1 (targetToServer) set to value 0.","paragraph_zero_based":162},{"literal_text_all_w_t_and_m_t":"NR","paragraph_zero_based":163},{"literal_text_all_w_t_and_m_t":"This field is optionally present for NR access if remoteUE-IndicationReq has been received from the location server in this location session. Otherwise it is not present.","paragraph_zero_based":164},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":165},{"literal_text_all_w_t_and_m_t":"CommonIEsProvideCapabilities field descriptions","paragraph_zero_based":166},{"literal_text_all_w_t_and_m_t":"segmentationInfo","paragraph_zero_based":167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"d8b33d63fa1306a290dfb1d41f0e061f60eb9bc61338ba8f51a0b2ece58785e5","original_member_sha256":"f2c0c6f90bae1678a978a16529e8b69f70957939d0d2a5d48a0840e1efb74554","paragraph_ElementTree_utf8_XML_sha256":["4dd09079354d5fb80d246113a60da776cff5b8e3587df9bba12e02cb4436a3c7","17bb3b8d8265751d86b9bcfb5e26aa5bd1cd382c7287f79a328cf2fc6ad08e50","830c67bda48b24bbfab1e7a487db61b612627ba71faed2d52afb3cc63f224788","4b01aa07bbc866b5049b2e6f29abc9d29d0cc04bd71fcb886babfca3ab3ae163","2e9539dcb017c35276b623365d066a48f351430646bdb30c2724c2f923f376e6","ce8b938ff78b9f9b95945c0239146ac1ca24f64743e37f561ee6943f07c8b5d7","29549df1cc7c9a864a2768b80de40109ca928a2e30dc0982c0fe5fc8321f803a","0303d999ffe9be9f244771b6f9e327ab308d9d17e48984018b3b56b33cbb095f","5338d2e5086865d78f886081bca85110a39d5e055940a6f6004fa742a744de67","56a963f94750f89ce2eed94fde65365a7a87baf112253be16c9c2fc3288743f4","3701b087cdc20f409ababa92d3cc5aca41a5bcc4dbce4f7be656ab5ff41bb464","f34801125f24fc954fba3c2984f7b898f3faadd83bd374b8b19843cc3bdd6a60","27ea029b0208e1988c58e43ede68ea2fa3de1da802341ba40cbd1e430e576d3b","f650f35c74d5a44e48592962220ee73ebf2786b5b43cfee88d7feaeb34987c41","aa6c8670bd44534a4b9ffe1f0a70ca343f4e21d40f5bdda6a5e1d98ea4448a6d","112f994634afbec4b43d67e82a