{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-EgressRLC-ChannelUu","paragraph_zero_based":39192},{"literal_text_all_w_t_and_m_t":"Indicates the egress RLC channel on Uu Hop for uplink transmissions at the L2 U2N Relay UE.","paragraph_zero_based":39193},{"literal_text_all_w_t_and_m_t":"sl-EgressRLC-ChannelPC5","paragraph_zero_based":39194},{"literal_text_all_w_t_and_m_t":"Indicates the egress RLC channel on PC5 Hop for downlink transmissions at the L2 U2N Relay UE and for uplink transmissions at the L2 U2N Remote UE.","paragraph_zero_based":39195},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39196},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":39197},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":39198},{"literal_text_all_w_t_and_m_t":"L2RelayUE","paragraph_zero_based":39199},{"literal_text_all_w_t_and_m_t":"For L2 U2N Relay UE, the field is optionally present, Need M. Otherwise, it is absent.","paragraph_zero_based":39200},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39201},{"literal_text_all_w_t_and_m_t":"–SL-SyncConfig","paragraph_zero_based":39202},{"literal_text_all_w_t_and_m_t":"The IE SL-SyncConfig specifies the configuration information concerning reception of synchronisation signals from neighbouring cells as well as concerning the transmission of synchronisation signals for sidelink communication.","paragraph_zero_based":39203},{"literal_text_all_w_t_and_m_t":"SL-SyncConfig information element","paragraph_zero_based":39204},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39205},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SYNCCONFIG-START","paragraph_zero_based":39206},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39207},{"literal_text_all_w_t_and_m_t":"SL-SyncConfigList-r16 ::=          S