{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":39528},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39529},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39530},{"literal_text_all_w_t_and_m_t":"SL-MappedQoS-FlowsListDedicated-r16 ::= SEQUENCE {","paragraph_zero_based":39531},{"literal_text_all_w_t_and_m_t":"    sl-MappedQoS-FlowsToAddList-r16         SEQUENCE (SIZE (1..maxNrofSL-QFIs-r16)) OF SL-QoS-FlowIdentity-r16  OPTIONAL,    -- Need N","paragraph_zero_based":39532},{"literal_text_all_w_t_and_m_t":"    sl-MappedQoS-FlowsToReleaseList-r16      SEQUENCE (SIZE (1..maxNrofSL-QFIs-r16)) OF SL-QoS-FlowIdentity-r16  OPTIONAL     -- Need N","paragraph_zero_based":39533},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39534},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39535},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SDAP-CONFIG-STOP","paragraph_zero_based":39536},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39537},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39538},{"literal_text_all_w_t_and_m_t":"SL-SDAP-Config field descriptions","paragraph_zero_based":39539},{"literal_text_all_w_t_and_m_t":"sl-DefaultRB","paragraph_zero_based":39540},{"literal_text_all_w_t_and_m_t":"Indicates whether or not this is the default sidelink DRB for this NR sidelink communication transmission destination. Among all configured instances of SL-SDAP-Config for this destination, this field shall be set to true in at most one instance of SL-SDAP-Config and to false in all other instances.","paragraph_zero_based":39541},{"literal_text_all_w_t_and_m_t":"sl-MappedQoS-Flows","paragraph_zero_based":39542},{"literal_text_all_w_t_and_m_t":"Indicates QoS flows to be mapped to the sidelink DRB. If the field is included in dedicated signalling, it is set to sl-MappedQoS-FlowsListDedicated; otherwise, it is set to sl-MappedQoS-FlowsList.","paragraph_zero_based":39543},{"literal_text_all_w_t_and_m_t":"sl-MappedQoS-FlowsList","paragraph_zero_based":39544},{"literal_text_all_w_t_and_m_t":"Indicates the list of QoS profiles of the NR sidelink communication transmission destination mapped to this sidelink DRB.","paragraph_zero_based":39545},{"literal_text_all_w_t_and_m_t":"sl-MappedQoS-FlowsToAddList","paragraph_zero_based":39546},{"literal_text_all_w_t_and_m_t":"Indicates the list of SL QoS flows ID of the NR sidelink communication transmission destination to be additionally mapped to this sidelink DRB.","paragraph_zero_based":39547},{"literal_text_all_w_t_and_m_t":"sl-MappedQoS-FlowsToReleaseList","paragraph_zero_based":39548},{"literal_text_all_w_t_and_m_t":"Indicates the list of SL QoS flows ID of the NR sidelink communication transmission destination to be released from existing QoS flow to SLRB mapping of this sidelink DRB. ","paragraph_zero_based":39549},{"literal_text_all_w_t_and_m_t":"sl-SDAP-Header","paragraph_zero_based":39550},{"literal_text_all_w_t_and_m_t":"Indicates whether or not a SDAP header is present on this sidelink DRB. The field cannot be changed after a sidelink DRB is established. This field is set to present if the field sl-DefaultRB is set to true.","paragraph_zero_based":39551}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["1c2febde7142e9fbec40331fc028832ae75684abda6fa5ae534134aec4b48018","c0f45b8585b04236eef20d59aeb20dcc24cc4f3cd8af12d68879581248c19fe4","a9a47499129a79384e159b6979dc085a674908003d046cff408642e1eee61ecb","f4f7a0f62f8542d639357add2e80729fd5ecde923ce3cd339202cacbaadce3