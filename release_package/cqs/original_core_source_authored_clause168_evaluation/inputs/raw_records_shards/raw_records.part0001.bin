{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR2-UL to the preferred maximum number of uplink MIMO layers of each FR2-1 serving cell that the UE operates on in the cell group;","paragraph_zero_based":6528},{"literal_text_all_w_t_and_m_t":"2>else (if the UE has no preference on the maximum number of MIMO layers for the cell group):","paragraph_zero_based":6529},{"literal_text_all_w_t_and_m_t":"3>do not include reducedMaxMIMO-LayersFR1 and reducedMaxMIMO-LayersFR2 in the MaxMIMO-LayerPreference IE;","paragraph_zero_based":6530},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide maxMIMO LayerPreferenceFR2 2 of a cell group for power saving according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":6531},{"literal_text_all_w_t_and_m_t":"2>include maxMIMO-LayerPreferenceFR2-2 in the UEAssistanceInformation message;","paragraph_zero_based":6532},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on the maximum number of MIMO layers for the cell group for FR2-2:","paragraph_zero_based":6533},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to reduce the number of maximum MIMO layers of each serving cell operating on FR2 2:","paragraph_zero_based":6534},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxMIMO-LayersFR2-2 in the MaxMIMO-LayerPreferenceFR2 2 IE;","paragraph_zero_based":6535},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR2-2-DL to the preferred maximum number of downlink MIMO layers of each BWP of each FR2-2 serving cell that the UE operates on in the cell group;","paragraph_zero_based":6536},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR2-2-UL to the preferred maximum number of uplink MIMO layers of each FR2-2 serving cell that the UE operates on in the cell group;","paragraph_zero_based":6537},{"literal_text_all_w_t_and_m_t":"2>else (if the UE has no preference on the maximum number of MIMO layers for the cell group):","paragraph_zero_based":6538},{"literal_text_all_w_t_and_m_t":"3>do not include reducedMaxMIMO-LayersFR2-2 in the MaxMIMO-LayerPreferenceFR2-2 IE;","paragraph_zero_based":6539},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide minSchedulingOffsetPreference of a cell group for power saving according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":6540},{"literal_text_all_w_t_and_m_t":"2>include minSchedulingOffsetPreference in the UEAssistanceInformation message;","paragraph_zero_based":6541},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on the minimum scheduling offset for cross-slot scheduling for the cell group:","paragraph_zero_based":6542},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the value of K0 (TS 38.214 [19], clause 5.1.2.1) for cross-slot scheduling with 15 kHz SCS:","paragraph_zero_based":6543},{"literal_text_all_w_t_and_m_t":"4>include preferredK0-SCS-15kHz in the MinSchedulingOffsetPreference IE and set it to the desired value of K0;","paragraph_zero_based":6544},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the value of K0 for cross-slot scheduling with 30 kHz SCS:","paragraph_zero_based":6545},{"literal_text_all_w_t_and_m_t":"4>include preferredK0-SCS-30kHz in the MinSchedulingOffsetPreference IE and set it to the desired value of K0;","paragraph_zero_based":6546},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the value of K0 for cross-slot scheduling with 60 kHz SCS:","paragraph_zero_based":6547},{"literal_text_all_w_t_and_m_t":"4>include preferredK0-SCS-60kHz in the MinSchedulingOffsetPreference IE and set it to the desired value of K0;","paragraph_zero_based":6548},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the value of K0 for cross-slot scheduling with 120 kHz SCS:","paragraph_zero_based":6549},{"literal_text_all_w_t_and_m_t":"4>include preferredK0-SCS-120kHz in the MinSchedulingOffsetPreference IE and set it to the desired value of K0;","paragraph_zero_based":6550},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the value of K2 (TS 38.214 [19], clause 6.1.2.1) for cross-slot scheduling with 15 kHz SCS:","paragraph_zero_based":6551}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["75e86385daa26c35c92b6fd99692d7a445bc65e7cfa3d62a8c5fbe337c850fa0","cc66b55a76a6338e04d16e57ef95e93a70fe24a19a4eccd1f8dc7a87facf916e","a63c1ed0cc9a51f95ee17f51d235a79cc3e30d3e2c3430bdd748bea3aeff94cf","7447305b26676364bdb5d77ef59b38826ff7ca2114a418007f962aa7c5c5c925","03d11f1cae27edc9cbb3be2b80f2a6e174d5b6caab1f979e47b8fb07335b33d6","0f40aea5ddad137181f6d97882b13c50011c094a2e4865e1ebed409661ef9d3c","2ac2381ee50481e7372eb7992f69b0d9b46e812faf1f664616e443ef97e61942","231f7d070000271b146f86e75805897a27118f9b5549cd9700d45c1925290b0d","5647b1500728e612c6b10a1d6ce2d3bcc19a3c889ed838f972ca632d7e8f46f1","15c409e090a7ce805c50f6a86c4b1d6456b3b4105986c0f0b5967583b882accd","a91a7ba306600553bf7a8672ce1a9ae51e96bf979a1ec3f1c04cacca3d5f4bf5","f6e2da8e3805b624962c2ccc00b8a8fc1620765bcffe4087e0c4e7efeb7840fc","95b3f96db134218f959a8b86c10adb45443fbbbe9b1d61a6052dcd2379166b19","312bc54f4ac7b0213359c39dcfdd71c7eebbeab54b2bda7f8a524bcc16f90612","f27af761f0396d95beb20a6070b07d6747c7acd96df8036220eb9abd168f0788","cdb4ad9244bdf13dd583a8d0effbf1cd9a90235dbd02623f17a12ce9350ed12a","65d7df9817c0c85bbb2da3fff70db101fae3f874809a8b17b660cc7003c7c1fb","ecf3639257ed9d94dae5aec8ba135c5fea46d487ba91940f8ab21685de96f2a7","9b06f938a09f578d1ab61a15dd479289d475a2425394df510b7dee06c51692f1","593153987f62694a22066e113f4d4260362420976b796d0f4f00097ddc85a288","83afabccdbe725d58ad51576e2b8249cf3eb114c379793f01842e5e86eb8bdd4","208742e38540a05add824fe1e90a5555fda7ba557023955c2e03fbabfa520f01","c0ed27bdc53bf36e38c20bf7b8979be008dad8472a34743b0cfd3ceb179e9b9a","abf4a0b02c71435ad14c42c236b0742e31710c1136133ec290c8e5036d6f5ce5"],"paragraph_range_zero_based":[6528,6551],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p6528"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>include preferredK2-SCS-15kHz in the MinSchedulingOffsetPreference IE and set it to the desired value of K2;","paragraph_zero_based":6552},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the value of K2 for cross-slot scheduling with 30 kHz SCS:","paragraph_zero_based":6553},{"literal_text_all_w_t_and_m_t":"4>include preferredK2-SCS-30kHz in the MinSchedulingOffsetPreference IE and set it to the desired value of K2;","paragraph_zero_based":6554},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the value of K2 for cross-slot scheduling with 60 kHz SCS:","paragraph_zero_based":6555},{"literal_text_all_w_t_and_m_t":"4>include preferredK2-SCS-60kHz in the MinSchedulingOffsetPreference IE and set it to the desired value of K2;","paragraph_zero_based":6556},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the value of K2 for cross-slot scheduling with 120 kHz SCS:","paragraph_zero_based":6557},{"literal_text_all_w_t_and_m_t":"4>include preferredK2-SCS-120kHz in the MinSchedulingOffsetPreference IE and set it to the desired value of K2;","paragraph_zero_based":6558},{"literal_text_all_w_t_and_m_t":"2>else (if the UE has no preference on the minimum scheduling offset for cross-slot scheduling for the cell group):","paragraph_zero_based":6559},{"literal_text_all_w_t_and_m_t":"3>do not include preferredK0 and preferredK2 in the MinSchedulingOffsetPreference IE;","paragraph_zero_based":6560},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide minSchedulingOffsetPreferenceExt of a cell group for power saving according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":6561},{"literal_text_all_w_t_and_m_t":"2>include minSchedulingOffsetPreferenceExt in the UEAssistanceInformation message;","paragraph_zero_based":6562},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on the minimum scheduling offset for cross-slot scheduling for the cell group for FR2-2:","paragraph_zero_based":6563},{"literal_text_all_w_t_and_m_t":"3>include minSchedulingOffsetPreferenceExt in the UEAssistanceInformation message;","paragraph_zero_based":6564},{"literal_text_all_w_t_and_m_t":"4>if the UE has a preference for the value of K0 (TS 38.214 [19], clause 5.1.2.1) for cross-slot scheduling with 480 kHz SCS:","paragraph_zero_based":6565},{"literal_text_all_w_t_and_m_t":"5>include preferredK0-SCS-480kHz in the minSchedulingOffsetPreferenceExt IE and set it to the desired value of K0;","paragraph_zero_based":6566},{"literal_text_all_w_t_and_m_t":"4>if the UE has a preference for the value of K0 for cross-slot scheduling with 960 kHz SCS:","paragraph_zero_based":6567},{"literal_text_all_w_t_and_m_t":"5>include preferredK0-SCS-960kHz in the minSchedulingOffsetPreferenceExt IE and set it to the desired value of K0;","paragraph_zero_based":6568},{"literal_text_all_w_t_and_m_t":"4>if the UE has a preference for the value of K2 for cross-slot scheduling with 480 kHz SCS:","paragraph_zero_based":6569},{"literal_text_all_w_t_and_m_t":"5>include preferredK2-SCS-480kHz in the minSchedulingOffsetPreferenceExt IE and set it to the desired value of K2;","paragraph_zero_based":6570},{"literal_text_all_w_t_and_m_t":"4>if the UE has a preference for the value of K2 for cross-slot scheduling with 960 kHz SCS:","paragraph_zero_based":6571},{"literal_text_all_w_t_and_m_t":"5>include preferredK2-SCS-960kHz in the minSchedulingOffsetPreferenceExt IE and set it to the desired value of K2;","paragraph_zero_based":6572},{"literal_text_all_w_t_and_m_t":"3>else (if the UE has no preference on the minimum scheduling offset for cross-slot scheduling for the cell group):","paragraph_zero_based":6573},{"literal_text_all_w_t_and_m_t":"4>do not include preferredK0 and preferredK2 in the minSchedulingOffsetPreferenceExt IE;","paragraph_zero_based":6574},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide a release preference according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":6575}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["8b6f5e091fe0398f0dae9c53bbf06a5618c5c69fd5c790512912b5d2daa3766c","aa9d58c362839a690558323a9a9d858138e211a98cfb9e83e1f2ab2cd6063303","58015f53b5319a7d33433583e30d04f056d75450720fc683ad1f61c4e81bd009","80d6eff27b8c29bd82072f0db41771ef8936c3d16e75fe42d7ec93f6df2cada5","287cc7a2cb5c69d43862afdac8a70f3851ae24a1cb77e76378e8c58b323f5b21","d6d21fba106bc0f298d0ea716abd2308728f6410249192b1da7da8fac4344fcb","28e778feb60e76bef7fa6fe499320773f80dd72e8d0d7bd20a85fbcc83ab8f88","387fcf6be17807ce6de73072f6b473a8c41d5cbb820bee42980fac414c1b2c31","f2a478b33c4da1883cb2b26f9b92763e5f5752f834fac5f6b08bf7a818bdb847","f0bda1db3f451adb8d2fa97d128d8bb93a3f939a660bc2c7fa98cc0450461559","a19e33535f5c14678de5762b6d99842cd20672772761648052970e9067b44c30","b4f9b48c2e82f8a0458358b24c2069e64e538c627ab1ca1c08e82b5926e8830f","b037ed94f0bb83d8119fb2974853a74bcf138175199193b02c95c2d1c1be62b3","6e5074bd647fa52470da25174101975aeb91c08b7810c189b28fe9a7f1e8543e","b8b526b2c93fbab303c97a5c820d5fc7c1f0656d42ec9e8fa81f8b9b5005e64f","2b7d63f7d4e331752022803bab67d623f9a02de6e92e47a77e5850fd220d7fb9","d69551afdb640b5c2566b7a0fc60854ecbd19cd918c740dba54bb7c34b3cbfbc","766e65dd265c448d990dd07e3a9e4b2d8f2b2b686b54881cb59b20fa4ceb16f1","71ab6e2c3b123d61e5c6b2a6c4c12636c456714d8f44a07190d8c97bf47123dc","a1c606cd56d21802f656faeb6187e382dc05339809fb108bf07d691ea8f15700","5bfca0f005c22788252b2efe812dc4782857170ff3548b92fb5eece4e73ce5a8","9b5bd126c6a15ef057ed9f21990d53bbc15c76ce6662449f23f4745a31744c5f","af60fe28db2b60f5871c21bf79a591ec4adc4dacb08cff84976fd4559ddcd979","c623ba984760ab9a88a45f7867f2a23567443ddc55bd942fa38e73fb8a4f9c80"],"paragraph_range_zero_based":[6552,6575],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p6552"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>include releasePreference in the UEAssistanceInformation message;","paragraph_zero_based":6576},{"literal_text_all_w_t_and_m_t":"2>set preferredRRC-State to the desired RRC state on transmission of the UEAssistanceInformation message;","paragraph_zero_based":6577},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide an indication of preference in being provisioned with reference time information according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":6578},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference in being provisioned with reference time information:","paragraph_zero_based":6579},{"literal_text_all_w_t_and_m_t":"3>set referenceTimeInfoPreference to true;","paragraph_zero_based":6580},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":6581},{"literal_text_all_w_t_and_m_t":"3>set referenceTimeInfoPreference to false.","paragraph_zero_based":6582},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide preference on FR2 UL gap according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":6583},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference for FR2 UL gap configuration:","paragraph_zero_based":6584},{"literal_text_all_w_t_and_m_t":"3>set ul-GapFR2-PatternPreference to the preferred FR2 UL gap pattern;","paragraph_zero_based":6585},{"literal_text_all_w_t_and_m_t":"2>else (if the UE has no preference for the FR2 UL gap configuration):","paragraph_zero_based":6586},{"literal_text_all_w_t_and_m_t":"3>do not include ul-GapFR2-PatternPreference in the UL-GapFR2-Preference IE.","paragraph_zero_based":6587},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide MUSIM assistance information according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":6588},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference for MUSIM periodic gap(s):","paragraph_zero_based":6589},{"literal_text_all_w_t_and_m_t":"3>include musim-GapPreferenceList with an entry for each periodic gap the UE prefers to be configured;","paragraph_zero_based":6590},{"literal_text_all_w_t_and_m_t":"4>set musim-GapLength and musim-GapRepetitionAndOffset in the musim-GapInfo IE to the values of the length and the repetition/offset of the gap(s), respectively, the UE prefers to be configured with;","paragraph_zero_based":6591},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference for MUSIM aperiodic gap:","paragraph_zero_based":6592},{"literal_text_all_w_t_and_m_t":"3>include the field musim-GapPreferenceList, with one entry for the aperiodic gap the UE prefers to be configured;","paragraph_zero_based":6593},{"literal_text_all_w_t_and_m_t":"4>include musim-GapLength in the musim-GapInfo IE and set it to the values of the length of the gap the UE prefers to be configured with;","paragraph_zero_based":6594},{"literal_text_all_w_t_and_m_t":"4>optionally include musim-Starting-SFN-AndSubframe in the musim-GapInfo IE and set it to the starting SFN/subframe of the gap the UE prefers to be configured with;","paragraph_zero_based":6595},{"literal_text_all_w_t_and_m_t":"2>if the UE has no longer preference for the periodic/aperiodic gaps:","paragraph_zero_based":6596},{"literal_text_all_w_t_and_m_t":"3>do not include musim-GapPreferenceList in the musim-Assistance IE;","paragraph_zero_based":6597},{"literal_text_all_w_t_and_m_t":"2>if UE has a preference to leave RRC_CONNECTED state:","paragraph_zero_based":6598},{"literal_text_all_w_t_and_m_t":"3>set musim-PreferredRRC-State to the preferred RRC state.","paragraph_zero_based":6599}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["20f64715ecddfc4d504c520fbc6c442567d2357408ff80dc51e088748a556b17","be7de15643853bd962e4a4cde37f004e268dcc81d3843cc4a98aba46f51c30e8","ee4fcb1ab82662ed13bcb31852276b25938657ee8e031534197004cc405e5636","3ae42f516377a6fa9c1e8d988a17e60c65f379d013bfc39760abfbc604faec05","67f4dcf877511785e4a1e289df0c59dc9f6fba0dbd032788e4923086ac39297a","fe340d1ce03192f32502dff600877c2338b184a229a0dd22fb95c16eb1742db9","1470158ea6d6efeaaf05ddcd0d7b144ab4054bacd72b74e1543f29288c141ccf","1290a504699d96a873287b7892b478a56bbf2ad4805a39e23480103ff28936be","52bee421306a60d24888d4ecf71e54c75039360ad30b10d727334f301a0d046d","a86898fe837493490f4cfba3e4a092e28b9467dad102ebbf83b4c2153f856016","e26a62ed272fdf7ff6235974988385c86f24312fce4c7a6b4cf70d3cf41173b7","1466413968ebb0cba81d3ab96f04a50a50f25b32d0c992d547a327ba6855aceb","7573c41efdf92ba9f68a03c3d0fb9020814909bb18c415b24f4a462504c467bb","eb57150a525997e693012c77c27b9875f7042c7657a20b158ebbcb09dbd2ab08","47a3b8d46cad0d29bbe3aca2e3227825e84622e7648f469fb785fbb4a71627c6","72440f06b0ec6040938cdae0773b4631ab07c129e85f74e30d8705d9d0d0f7a6","dad4930c5d1e664810b1667325fbf0b38ed83f92d8ac09f0f97ee9ca5786d99c","103d0fd2a1df2e71974cd9035d9618b32e32641007d5339187f34bb3581c4d56","235e6107343aac5ce7e45fa8a2019dc92a6195c0bb561263078f836d0d7def50","1d406570fda07b94f9a0ab62dd8ba5b9d3681fb2a3dbabb7dc1e7be411ac58c1","817851366ab3a62b9a981ccd088d4e66dee7651797378fbed0ef9a372013e864","55f32d5fdc8514679dde72123a269f63f56371caeaa399ebeed739f02b11ac4a","8f39a02ddb008940506b37ec2141fb8b127da7e278a50f4ae35527eda400194d","43d2127c28a44ed332833d6fe6d1a412e7787694ee9234b9adb703d9c309e7b0"],"paragraph_range_zero_based":[6576,6599],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p6576"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide the relaxation state of RLM measurements of a cell group according to 5.7.4.2:","paragraph_zero_based":6600},{"literal_text_all_w_t_and_m_t":"2>if the UE performs RLM measurement relaxation on the cell group according to TS 38.133 [14]:","paragraph_zero_based":6601},{"literal_text_all_w_t_and_m_t":"3>set the rlm-MeasRelaxationState to true;","paragraph_zero_based":6602},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":6603},{"literal_text_all_w_t_and_m_t":"3>set the rlm-MeasRelaxationState to false;","paragraph_zero_based":6604},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide the relaxation state of BFD measurements of a cell group:","paragraph_zero_based":6605},{"literal_text_all_w_t_and_m_t":"2>for each serving cell of the cell group:","paragraph_zero_based":6606},{"literal_text_all_w_t_and_m_t":"3>if the UE performs BFD measurement relaxation on this serving cell according to TS 38.133 [14]:","paragraph_zero_based":6607},{"literal_text_all_w_t_and_m_t":"4>set the n-th bit of bfd-MeasRelaxationState to '1', where n is equal to the servCellIndex value + 1 of the serving cell;","paragraph_zero_based":6608},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":6609},{"literal_text_all_w_t_and_m_t":"4>set the n-th bit of bfd-MeasRelaxationState to '0', where n is equal to the servCellIndex value + 1 of the serving cell.","paragraph_zero_based":6610},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to indicate availability of data mapped to radio bearers not configured for SDT according to 5.7.4.2:","paragraph_zero_based":6611},{"literal_text_all_w_t_and_m_t":"2>include the nonSDT-DataIndication in the UEAssistanceInformation message;","paragraph_zero_based":6612},{"literal_text_all_w_t_and_m_t":"2>include and set the resumeCause according to the information received from the upper layers, if provided.","paragraph_zero_based":6613},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide an indication of preference for SCG deactivation according to 5.7.4.2:","paragraph_zero_based":6614},{"literal_text_all_w_t_and_m_t":"2>include scg-DeactivationPreference in the UEAssistanceInformation message;","paragraph_zero_based":6615},{"literal_text_all_w_t_and_m_t":"2>set the scg-DeactivationPreference to scgDeactivationPreferred if the UE prefers the SCG to be deactivated, otherwise set it to noPreference;","paragraph_zero_based":6616},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide an indication that the UE has uplink data related to a deactivated SCG according to 5.7.4.2:","paragraph_zero_based":6617},{"literal_text_all_w_t_and_m_t":"2>include uplinkData in the UEAssistanceInformation message.","paragraph_zero_based":6618},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide an indication about whether the criterion for RRM relaxation for connected mode is fulfilled or not fulfilled:","paragraph_zero_based":6619},{"literal_text_all_w_t_and_m_t":"2>if the criterion for RRM measurement relaxation for connected mode is fulfilled:","paragraph_zero_based":6620},{"literal_text_all_w_t_and_m_t":"3>set the rrm-MeasRelaxationFulfilment to true;","paragraph_zero_based":6621},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":6622},{"literal_text_all_w_t_and_m_t":"3>set the rrm-MeasRelaxationFulfilment to false.","paragraph_zero_based":6623}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["7c334e144eb15de580494e280f239ad169fd69a0ebed30f5195617ef950885f6","0a0dadb2b58031dc423396e547adfb659a8e8f154c8686cfccfd7c38c5334af7","f3996e1ada942f676587b7f11945643ef913b8bd372f1a17c371ce2b4d8cb7ed","b1a934e46bccf99e469847e0bf0a58f1904a40aa416fc784e1728f07b012161e","523112ce19e0e1ebe2bad23b9fb21c89816ac0845d5343da578625618bd138f4","0917951ad4b75dd667d5de03e66ed525c789b954a7ab81d00eefea2ba2da601d","77c888b94224d7215307e511960539705d5cfd2832e08e4a1082e7ee9aefeaf8","d23f6c6570e6d6a3a6329479fab77eaef23fcb6573cc03ca211920ef88a94047","486dcb254c12b695d377011ecaeedd05e684937c59b38254c180900f94d35a07","eb84d6bc79000470944fd6be28c26fdabcd5cb276328b6dcaf4e6b339b627dac","df7db0ddbf67457e1d6e155035fee7dce5f39c2dac2b148b0b4e733155b1c04d","6b4e6359dd79908155ef8f531baab0544c8906e82c9df71d724cc84dfd6a04bd","65d329d7b055d871d9166e98003c4c3921e3c46e6a552e93f3e48904eebc2951","e5d8a79132ffdfd7d315d83e5afc5ecb9b6b484061c628760bf6ebb6a0b23b10","07322e7040eba17f1e226ee9584062df0c7f4a2993dcad6411bf5d6b06c06842","6f5d3bb7f9e5e3fbc33af904e6c6828842784601964c33fe28c6f4959d41a245","67da8efa97a962fd673a0c5a1bbbbd98f8399325b570e28bcc8b3dad9dbe763e","ca0f8c2e2203529d0260c40f8cf87bd20beb47175a24d78a40e513d1d14396be","d0f929d3ad368e801d05e95faf306e68f5ea13cab19251a707b83b179fe2a557","33c8cb7dcd4d9bebe0b40688d7ea83a281653afcc868d4a0c1bf41f9c6be6d7f","9a400056be219c4a189272b888ba64881853a09c5c174b3118bb09bd09e647f1","791097314c1126e8d86167c9b6f0d0457a601e19366a61611b0f394d6a328d2d","4d03a6e17456a8ee32457db5bff3fb6fb3f66495c06485f2e79a933c32ba0f92","278d847c64e6dea5e4b17d335582bdb0235f26d0045c01ce9df638aa2030a7e0"],"paragraph_range_zero_based":[6600,6623],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state 