{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37104},{"literal_text_all_w_t_and_m_t":"SL-BWP-Generic field descriptions","paragraph_zero_based":37105},{"literal_text_all_w_t_and_m_t":"sl-LengthSymbols","paragraph_zero_based":37106},{"literal_text_all_w_t_and_m_t":"This field indicates the number of symbols used for sidelink in a slot without S-SSB. A single value can be (pre)configured per sidelink bandwidth part.","paragraph_zero_based":37107},{"literal_text_all_w_t_and_m_t":"sl-StartSymbol","paragraph_zero_based":37108},{"literal_text_all_w_t_and_m_t":"This field indicates the starting symbol used for sidelink in a slot without S-SSB. A single value can be (pre)configured per sidelink bandwidth part.","paragraph_zero_based":37109},{"literal_text_all_w_t_and_m_t":"sl-TxDirectCurrentLocation","paragraph_zero_based":37110},{"literal_text_all_w_t_and_m_t":"The sidelink Tx/Rx Direct Current location for the carrier. Only values in the value range of this field between 0 and 3299, which indicate the subcarrier index within the carrier corresponding to the numerology of the corresponding sidelink BWP and value 3300, which indicates \"Outside the carrier\" and value 3301, which indicates \"Undetermined position within the carrier\" are used in this version of the specification.","paragraph_zero_based":37111},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37112},{"literal_text_all_w_t_and_m_t":"–SL-BWP-ConfigCommon","paragraph_zero_based":37113},{"literal_text_all_w_t_and_m_t":"The IE SL-BWP-ConfigCommon is used to configure the cell-specific configuration information on one particular sidelink bandwidth part.","paragraph_zero_based":37114},{"literal_text_all_w_t_and_m_t":"SL-BWP-ConfigCommon information element","paragraph_zero_based":37115},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":37116},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-BWP-CONFIGCOMMON-START","paragraph_zero_based":37117},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37118},{"literal_text_all_w_t_and_m_t":"SL-BWP-ConfigCommon-r16 ::=              SEQUENCE {","paragraph_zero_based":37119},{"literal_text_all_w_t_and_m_t":"    sl-BWP-Generic-r16                       SL-BWP-Generic-r16                                         OPTIONAL,    -- Need R","paragraph_zero_based":37120},{"literal_text_all_w_t_and_m_t":"    sl-BWP-PoolConfigCommon-r16              SL-BWP-PoolConfigCommon-r16                                OPTIONAL,    -- Need R","paragraph_zero_based":37121},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":37122},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":37123},{"literal_text_all_w_t_and_m_t":"    sl-BWP-PoolConfigCommonPS-r17            SL-BWP-PoolConfigCommon-r16                                OPTIONAL,    -- Need R","paragraph_zero_based":37124},{"literal_text_all_w_t_and_m_t":"    sl-BWP-DiscPoolConfigCommon-r17          SL-BWP-DiscPoolConfigCommon-r17                            OPTIONAL     -- Need R","paragraph_zero_based":37125},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":37126},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37127}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["d3abf9c2e34753a92906c0b3f59794f8e0721f1d5d4129025cdd5bfd190197da","5df4e6c7b0ae32e1ed66cf674481e87fa7f9ff566c0faeb8be87e17246485ae2","67c9db250bb6ef650c0ca8d51109f42ec8521a038fb42a20873c87cec27d44cd","314e4631e16fe9220e7dd21d98f08b1eda0bef5aa41f8059312967f5e1f7316a","6e04584d33c624e4ce