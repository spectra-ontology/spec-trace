{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        nid-List-r16                     SEQUENCE (SIZE (1..maxNPN-r16)) OF NID-r16","paragraph_zero_based":21456},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":21457},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21458},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21459},{"literal_text_all_w_t_and_m_t":"CAG-IdentityInfo-r16 ::=         SEQUENCE {","paragraph_zero_based":21460},{"literal_text_all_w_t_and_m_t":"    cag-Identity-r16                 BIT STRING (SIZE (32)),","paragraph_zero_based":21461},{"literal_text_all_w_t_and_m_t":"    manualCAGselectionAllowed-r16    ENUMERATED {true}                         OPTIONAL   -- Need R","paragraph_zero_based":21462},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21463},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21464},{"literal_text_all_w_t_and_m_t":"NID-r16 ::=                      BIT STRING (SIZE (44))","paragraph_zero_based":21465},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21466},{"literal_text_all_w_t_and_m_t":"-- TAG-NPN-IDENTITY-STOP","paragraph_zero_based":21467},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21468},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21469},{"literal_text_all_w_t_and_m_t":"NPN-Identity field descriptions","paragraph_zero_based":21470},{"literal_text_all_w_t_and_m_t":"cag-Identity","paragraph_zero_based":21471},{"literal_text_all_w_t_and_m_t":"A CAG-ID as specified in TS 23.003 [21]. The PLMN ID and a CAG ID in the NPN-Identity identifies a PNI-NPN.","paragraph_zero_based":21472},{"literal_text_all_w_t_and_m_t":"cag-IdentityList","paragraph_zero_based":21473},{"literal_text_all_w_t_and_m_t":"The cag-IdentityList contains one or more CAG IDs. All CAG IDs associated to the same PLMN ID are listed in the same cag-IdentityList entry.","paragraph_zero_based":21474},{"literal_text_all_w_t_and_m_t":"manualCAGselectionAllowed","paragraph_zero_based":21475},{"literal_text_all_w_t_and_m_t":"The manualCAGselectionAllowed indicates that the CAG ID can be selected manually even if it is outside the UE's allowed CAG list.","paragraph_zero_based":21476},{"literal_text_all_w_t_and_m_t":"NID","paragraph_zero_based":21477},{"literal_text_all_w_t_and_m_t":"A NID as specified in TS 23.003 [21]. The PLMN ID and a NID in the NPN-Identity identifies a SNPN.","paragraph_zero_based":21478},{"literal_text_all_w_t_and_m_t":"nid-List","paragraph_zero_based":21479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["670e0feb6aef6395b5e3d7ce9eae574391faa223f8fd56e474b656cc50ecaca9","aa3e98231ff095a0cc32fafc07be046dd1e5f44c9b5076a8416617121353272c","81fd7fe254f6d76fad29d99df6b7c0781fc821fc09b90e9a81b053d0e6ae4fe1","34c17f4f1c804dce1a9bbcf2ebf838430615847dd619fac3be7797a1e460bef0","e97eb7fd700ceadce2ca82dc5b8a5c09af5f335f2dd668382f73a751706ae45e","0e678a0228ad87f288738a46276da9029bb8cc42424981aca83767345ff4e449","6052ee141c2545ee4c628e7018ec87b3f372264fa89ed54050bd24fce9c596e2","946233d9f1720c52973179d2507ac2d120a7f0d965c5d59c2682be0fb2b61d62","90fba029b5cf3d16d88164697aadbbb9ba56da8bee239f01a0a769cf897aba5d","baab99aaaac6f8a6c803a5220c82418849275ca8097faa8920aaab398a37d7fd","b186d7e915544b14c24f970d680b87ae36f2bd623a05856e8342a3030ea57da2","c95eb0aa99a67183917e940b74dad5aec6666931558fcb35d84c1a69d01ce792","ac2dc0110c6c9baf841cd05f84887144b7476741ea192ef54845e2bc51b54c76","e4ce4cda8afcf1ba6d03372fa470a105d5211d4178779feefa6174b1359efb6f","a89aa55956a9fa58538026c27952b39a9262