{"fields":{"filename":"R2-2401458.zip::R2-2401458.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field indicates whether this ProvideCapabilities message is one of many segments, as specified in clause 4.3.5.","paragraph_zero_based":168},{"literal_text_all_w_t_and_m_t":"lpp-message-segmentation","paragraph_zero_based":169},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates the target device's LPP message segmentation capabilities. If bit 0 is set to value 1, it indicates that the target device supports receiving segmented LPP messages; if bit 0 is set to value 0 it indicates that the target device does not support receiving segmented LPP messages.","paragraph_zero_based":170},{"literal_text_all_w_t_and_m_t":"If bit 1 is set to value 1, it indicates that the target device supports sending segmented LPP messages; if bit 1 is set to value 0 it indicates that the target device does not support sending segmented LPP messages.","paragraph_zero_based":171},{"literal_text_all_w_t_and_m_t":"remoteUE-Indication","paragraph_zero_based":172},{"literal_text_all_w_t_and_m_t":"This field indicates whether the target device in NR access is configured as a L2 U2N Remote UE. The target device in NR access may transmit a ProvideCapabilities message with an appropriate value of this field when it starts or stops operation as a U2N Remote UE.","paragraph_zero_based":173},{"literal_text_all_w_t_and_m_t":"locationEstimateAndMeasurementReporting","paragraph_zero_based":174},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device supports locationEstimateAndMeasurementsRequired in LocationInformationType.","paragraph_zero_based":175},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":176},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":177}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragrap