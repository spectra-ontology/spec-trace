raph_zero_based":118},{"literal_text_all_w_t_and_m_t":"-References are either specific (identified by date of publication, edition number, version number, etc.) or nonspecific.","paragraph_zero_based":119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"da5f2e9ad82a2fe16c0ac8f47ac3a2bf5df15d5802210995528b085ea041fe8c","original_member_sha256":"4dd1bab56896055218acba90ada05dd206b70fbd7a2f3b846c0e4a02e9fd0070","paragraph_ElementTree_utf8_XML_sha256":["485c908fbb566d4a990cd1489522bdb79538fa775bfb761f6f34a267a0c81951","a9e7c837fd2b769589bc509b488ff6500426341e55b7d978c0271b9d154411a9","16dd4c2d5923703e7f5bd835f2cf13ae0fadc21d9beb260167268d43504b1fb9","b78db1ed6cffd378c68f447606e7056895b0b8906dc2c114c09c224101e482cc","0d0028bdc1eec410676a8aaf32b9cc2e6a7dce38450e0f0a74a7116f46257a9a","29590de9ff424dd5f6754d6dbed457e0e03e01d3fd4e656d0e9e9bacb9f3c6ac","d912061b88d41c731d177cc650fc486e47aa1cbe1acba08e3f7402f0d84b4298","86e2eb785fe9707045e34c5ce45c34e07d290b17730596378538c4d7e2c31e86","0b6df20d4cd14a337e887a3eeb5af42f018af18c5995ea73804621066b4a58f8","a25a4b3ab57cf89f9a38b84d6c2f8fc27539daec2920d2012d187b0f140b0713","c725d8ccc3321e1c7c0f47e75a7fdec2819f47daf8ef3222c99f9bd92fbc867d","14b4181b02b7b2fe5d079dd75dc079454f47341f7c4d2f85f69dea9cd7eb19e9","8427b1f569b12d9c578aaf14bd32adbcb504d1a187ebcb5485daa94660c0abde","e6304cceb4304fbfc7217291962eaa553a748fd0cf145ca8dc52b6d2a11b18b5","b9433427ebd93a4d5ce1cf49ac7c24ea794f198e0a530b25a2be39cddb22e17f","497613aa35f021cb493656bcc77c4c0c22a111b70b1e87991060f0cce057b243","b3847d8229bd877b3ece2ffb3d7a3421e37c5c303d016e0a723807c8cc71b77b","027b4f6d02815500115868045e07620de8535e6906669a9879f0c2d9696a65fe","078e99cdfbbed0eb4c945d5cb7d94f77c9ab28bc3084ed9654c4741b39e23432","ca3c8aefb65e2dbe4722cc2faf9806842b07662a097b258166caebfaab8a9897","23be0457bcffbc5207a7ed147d2c9b4a162481b54b9937f39d9060df57626e50","c0be106feefd30f09b2801c411d3987d8