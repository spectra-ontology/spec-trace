0fe85de","e545fe9dfb8b0e0e6eea5fc84780e581e8099d06f295684e4a2a5856c159c251","d8a2f0fb524327d4e055941ae64dbbf3e22c320143ed164c869fb53fd97b56f4","7ea3cce6646fcd43f8230e3ba720dc52d97378cac21d426b7e7a07172d0ad444","fff0853b7f834b8336d184e8d6ad2134ccbe2b1f2bfd26fbefeeb781fd626fe0","7048b9ec34553623f010aa9f1dd35c8695fd764da211988956f1f0fba383bce2","be5a3cfa43bae635229227fb1eb435f99ccc8d341c20864187a5679a5666411e","cafeb04d6d52347d732f477d3dcb60cb65f74e5fe3df3b5a95e9017f2bf89cfb","07c4152c97f96f568a380dfc16abc98b60602f93e589e1b9066558c541a97424","09621401792cb52c20e2ed113055b6acbfb2ec064603a99463f6e323729cadaa","51a72280eb55cc5f5b4fbb97bd303bab4ddc17842f6b27765ae632f26717674c","6d012da233866fb5d9b97c2295c1ebc9020c01edb9878bfe027d1c5123451f42","4fb5134820e1fe5abd99d910e2b339d6996b611503243d308046cd09dd572689","8c7fa64cf767602537be2f1a2029de00e623dd4c5ddfc53da40e6e65da1c82e6","aa73180ca13dbc3f27fb953ac8e4bde13593eb7ecb7293094006ea235ce49367"],"paragraph_range_zero_based":[28344,28367],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p28344"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SRS-CC-SetIndex field descriptions","paragraph_zero_based":28368},{"literal_text_all_w_t_and_m_t":"cc-IndexInOneCC-Set","paragraph_zero_based":28369},{"literal_text_all_w_t_and_m_t":"Indicates the CC index in one CC set for Type A (see TS 38.212 [17], TS 38.213 [13], clause 7.3.1, 11.4). The network always includes this field when the srs-TPC-PDCCH-Group is set to typeA.","paragraph_zero_based":28370},{"literal_text_all_w_t_and_m_t":"cc-SetIndex","paragraph_zero_based":28371},{"literal_text_all_w_t_and_m_t":"Indicates the CC set index for Type A associated (see TS 38.212 [17], TS 38.213 [13], clause 7.3.1, 11.4). The network always includes this field when the srs-TPC-PDCCH-Group is set to typeA. The network does not configure this field to 3 in this release of specification.","paragraph_zero_based":28372},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28373},{"literal_text_all_w_t_and_m_t":"SRS-CarrierSwitching field descriptions","paragraph_zero_based":28374},{"literal_text_all_w_t_and_m_t":"monitoringCells","paragraph_zero_based":28375},{"literal_text_all_w_t_and_m_t":"A set of serving cells for monitoring PDCCH conveying SRS DCI format with CRC scrambled by TPC-SRS-RNTI (see TS 38.212 [17], TS 38.213 [13], clause 7.3.1, 11.3).","paragraph_zero_based":28376},{"literal_text_all_w_t_and_m_t":"srs-SwitchFromServCellIndex","paragraph_zero_based":28377},{"literal_text_all_w_t_and_m_t":"Indicates the serving cell whose UL transmission may be interrupted during SRS transmission on a PUSCH-less SCell. During SRS transmission on a PUSCH-less SCell, the UE may temporarily suspend the UL transmission on a serving cell with PUSCH in the same CG to allow the PUSCH-less SCell to transmit SRS. (see TS 38.214 [19], clause 6.2.1.3).","paragraph_zero_based":28378},{"literal_text_all_w_t_and_m_t":"srs-TPC-PDCCH-Group","paragraph_zero_based":28379},{"literal_text_all_w_t_and_m_t":"Network configures the UE with either typeA-SRS-TPC-PDCCH-Group or typeB-SRS-TPC-PDCCH-Group, if any.","paragraph_zero_based":28380},{"literal_text_all_w_t_and_m_t":"typeA","paragraph_zero_based":28381},{"literal_text_all_w_t_and_m_t":"Type A trigger configuration for SRS transmission on a PUSCH-less SCell (see TS 38.213 [13], clause 11.4). In this release, the network configures at most one entry (the first entry) of typeA, and the first entry corresponds to the serving cell in which the SRS-CarrierSwitching field is configured. SRS carrier switching to SUL carrier is not supported in this version of the specification.","paragraph_zero_based":28382},{"literal_text_all_w_t_and_m_t":"typeB","paragraph_zero_based":28383},{"literal_text_all_w_t_and_m_t":"Type B trigger configuration for SRS transmission on a PUSCH-less SCell (see TS 38.213 [13], clause 11.4).","paragraph_zero_based":28384},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28385},{"literal_text_all_w_t_and_m_t":"SRS-TPC-PDCCH-Config field descriptions","paragraph_zero_based":28386},{"literal_text_all_w_t_and_m_t":"srs-CC-SetIndexlist","paragraph_zero_based":28387},{"literal_text_all_w_t_and_m_t":"A list of pairs of [cc-SetIndex; cc-IndexInOneCC-Set] (see TS 38.212 [17], TS 38.213 [13], clause 7.3.1, 11.4). The network does not configure this field for typeB.","paragraph_zero_based":28388},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28389},{"literal_text_all_w_t_and_m_t":"–SRS-Config","paragraph_zero_based":28390},{"literal_text_all_w_t_and_m_t":"The IE SRS-Config is used to configure sounding reference signal transmissions. The configuration defines a list of SRS-Resources, a list of SRS-PosResources, a list of SRS-PosResourceSets and a list of SRS-ResourceSets. Each resource set defines a set of SRS-Resources or SRS-PosResources. The network triggers the transmission of the set of SRS-Resources or SRS-PosResources using a configured aperiodicSRS-ResourceTrigger (L1 DCI). The network does not configure SRS specific power control parameters, alpha (without suffix), p0 (without suffix) or pathlossReferenceRS if unifiedTCI-StateType is configured for the serving cell.","paragraph_zero_based":28391}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["d8dbfe19f62576d3afdefc3e1f438977f6ceb09d0c0fdf91ee910ade0114300c","8497ab170496149c41ff9c12cd36768eedb04d9b2ece10a55371c6655f9ee11a","55d94a44c85ea66e4111d4876047c92f3f075462c02dafdd1d30fd123295ba83","c0788f0c0aa3684342fca675908d830491e6179f0d183486bffdbd6749b30468","c160d1ae73f72e0e09a3f36afde4ba000220ef34d5678f70017200394edf34e1","3a0ed1b7f930be63a8a9f9276fbf59bafbe983aeb034c81207a270fcf7fe388b","d096219c871b0f936fce75d494c8f06d7f4c5cbc803b29f6d27df8b88770f78b","34e2aab137343f3f2c6ad6ea1663c7020654d0d5319e2fd5e1db7ab670f8fd53","c3c40b017d1a65869722f4b3ed421540ed788921ecc44a489740ce7612bed4a1","983d1392070a4ef5e119ab176a16156ebad369e7e6856986d9d381edc46328d3","412cf5f1572a980de89fbc9a53cc93dbf5af8078b3c2262a62af254cca64219e","4d048a60ce48fc5791fe787cedf7456133742c365440174f8917f530271bced0","929d1e9e2e948a860ed00890f0891e9b3a2eece5f699203a2ad05f0a805c5eb9","0df4be361f65938140fe81516d1d56542ccfc67f3893da07b6c1930c00af294c","d4c39136b7f470efb069c29040ebfa917ab5c3e9ea966dd5bcb2f63ae6bb2f87","01c28160480cc8c3c01bb94e143acfccfbfcc64f1c79ca10ccc68f3d3ba44b9f","b5dc46d2aef080f562c8cc35a397a4fa8a3155c024a69c0b3d1f458c9e94d929","8261e09b666db67c46d0c141dc1e0be6b55483b93aafe93af9340bf9841f845f","69fa6f84962fc6d94b872514e8e8e7c1a1e9efb601dfb674a9cdd0abf0ae88ea","ddae09bda8e5b6e8d39596f72c33d65b7574cb1502