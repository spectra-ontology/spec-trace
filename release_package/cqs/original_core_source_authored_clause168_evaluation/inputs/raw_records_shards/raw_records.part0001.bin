{"fields":{"filename":"R2-2401569.zip::R2-2401569 RRC corrections for XR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"TMTransparent Mode","paragraph_zero_based":432},{"literal_text_all_w_t_and_m_t":"TMGITemporary Mobile Group Identity","paragraph_zero_based":433},{"literal_text_all_w_t_and_m_t":"TNTerrestrial Network","paragraph_zero_based":434},{"literal_text_all_w_t_and_m_t":"U2NUE-to-Network","paragraph_zero_based":435},{"literal_text_all_w_t_and_m_t":"U2UUE-to-UE","paragraph_zero_based":436},{"literal_text_all_w_t_and_m_t":"UDCUplink Data Compression","paragraph_zero_based":437},{"literal_text_all_w_t_and_m_t":"UEUser Equipment","paragraph_zero_based":438},{"literal_text_all_w_t_and_m_t":"ULUplink","paragraph_zero_based":439},{"literal_text_all_w_t_and_m_t":"UMUnacknowledged Mode","paragraph_zero_based":440},{"literal_text_all_w_t_and_m_t":"UPUser Plane","paragraph_zero_based":441},{"literal_text_all_w_t_and_m_t":"VRVirtual Reality","paragraph_zero_based":442},{"literal_text_all_w_t_and_m_t":"XReXtended Reality","paragraph_zero_based":443},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":444},{"literal_text_all_w_t_and_m_t":"In the ASN.1, lower case may be used for some (parts) of the above abbreviations e.g. c-RNTI.","paragraph_zero_based":445},{"literal_text_all_w_t_and_m_t":"4General","paragraph_zero_based":446},{"literal_text_all_w_t_and_m_t":"4.1Introduction","paragraph_zero_based":447},{"literal_text_all_w_t_and_m_t":"This specification is organised as follows:","paragraph_zero_based":448},{"literal_text_all_w_t_and_m_t":"-clause 4.2 describes the RRC protocol model;","paragraph_zero_based":449},{"literal_text_all_w_t_and_m_t":"-clause 4.3 specifies the services provided to upper layers as well as the services expected from lower layers;","paragraph_zero_based":450},{"literal_text_all_w_t_and_m_t":"-clause 4.4 lists the RRC functions;","paragraph_zero_based":451},{"literal_text_all_w_t_and_m_t":"-clause 5 specifies RRC procedures, including UE state transitions;","paragraph_zero_based":452},{"literal_text_all_w_t_and_m_t":"-clause 6 specifies the RRC messages in ASN.1 and description;","paragraph_zero_based":453},{"literal_text_all_w_t_and_m_t":"-clause 7 specifies the variables (including protocol timers and constants) and counters to be used by the UE;","paragraph_zero_based":454},{"literal_text_all_w_t_and_m_t":"-clause 8 specifies the encoding of the RRC messages;","paragraph_zero_based":455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"b3775a5d14ac021fc4f5f3e8002b92527fa1c052d9b7c535f196b5410b17f720","original_member_sha256":"0b2b1acef7c2981dcae001f9ad768411cade15b8ef16fbb988748fdb44fd8de1","paragraph_ElementTree_utf8_XML_sha256":["0965b2a71fdbf4b18fd349fa4d67b1b1b42a3474f981f298c8cc63794a71e5c9","da6fcc4bb0f32d4c539a7d4cefd3204d47fd8694b55a6ee49d24a0eacfe3f296","93b08302d99b8308cf40547d08e47bf18a7fc9becc96fcc86054ffce18051d41","3c648bbdab1bdb9d936e3aee152ec61d9ba4c8d20d66be9e7980b06426a43822","0c55f561aac3e5cbc41608e259a7d270d116a5934475b56981a1be5b9ff333d0","16229eb00bbca1c3e965c4357efa74ab4f3182b0823b6a6826744a53fd527cd5","c0a4d000e55e2207cb45ead265adde505a6330fe0c09d133f730534573068121","adcfe9eedbe9afaede9ab2ee23ace064123f90491224010aed8e64c52afc908e","f9f03eba387415663e3ecedac1c492f6f9f96474b8f186a105586a6552e04e46","cbc235eb8e5a2b307a41e5b05e6bf50a7c92aacee641175ed83d6277445c5afe","2dcc720aa753888ff45132d796a556b3a2ecbbe3e18619b67b8ff06642ae35ed","e3bdfe50f02754a79ee0347cb0fa73e722e45ad73550e340d6a457da832ad4b2","f1d952828bf705baff8ab94018f33cc8346bccc151f24570c5d8c0ca2024c6b9","22a40dcd1aef3ea723ffa85be8e544064037b44ccdeeee4001c0bb773db12df3","692d64906b9aacedb72a693153f31d8352b03468041412a27693fcc454d6f658","846adc43ef7c28b5b710ca299411750391171acbfa23e3344b97e8dd46eb7ecf","390765bd841720f6600d8b941e4cd6482e9adeebcb96046fcf4174fb88b6c12c","e7fb58fffc67ea42da659e351f6ec62ae73dca321a4f62a552a4cdf55831606f","d5cb5a6bab316aed48529ec4bdda4398cbcf1d9596f9790a5021142e02360e8b","acaedb829953b12a3226c9462bd2650688d670d91dd9143ec0c2a952cb79788b","350c5e327acb97f6b3ba7bfbef0f25ffec7ad170339ab099e1337733a13b0313","ebd1c14e9e46f23c006abca41e49d802a7646ed2a89d27f1ffbf5ed8b18bd2db","34916da25b4f2711c12b9b5414f2fc6a976637629ad0eefa4a7dba78d4a1d890","415ef6ee587273ae4019526cabe53597b8f1bd58022d473be9e9d456eb0cccd0"],"paragraph_range_zero_based":[432,455],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2401569.zip::R2-2401569 RRC corrections for XR.docx:p432"}
{"fields":{"filename":"R2-2401569.zip::R2-2401569 RRC corrections for XR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-clause 9 specifies the specified and default radio configurations;","paragraph_zero_based":456},{"literal_text_all_w_t_and_m_t":"-clause 10 specifies generic error handling;","paragraph_zero_based":457},{"literal_text_all_w_t_and_m_t":"-clause 11 specifies the RRC messages transferred across network nodes;","paragraph_zero_based":458},{"literal_text_all_w_t_and_m_t":"-clause 12 specifies the UE capability related constraints and performance requirements.","paragraph_zero_based":459},{"literal_text_all_w_t_and_m_t":"4.2Architecture","paragraph_zero_based":460},{"literal_text_all_w_t_and_m_t":"4.2.1UE states and state transitions including inter RAT","paragraph_zero_based":461},{"literal_text_all_w_t_and_m_t":"A UE is either in RRC_CONNECTED state or in RRC_INACTIVE state when an RRC connection has been established. If this is not the case, i.e. no RRC connection is established, the UE is in RRC_IDLE state. The RRC states can further be characterised as follows:","paragraph_zero_based":462},{"literal_text_all_w_t_and_m_t":"-RRC_IDLE:","paragraph_zero_based":463},{"literal_text_all_w_t_and_m_t":"-A UE specific DRX may be configured by upper layers;","paragraph_zero_based":464},{"literal_text_all_w_t_and_m_t":"-At lower layers, the UE may be configured with a DRX for PTM transmission of MBS broadcast;","paragraph_zero_based":465},{"literal_text_all_w_t_and_m_t":"-UE controlled mobility based on network configuration;","paragraph_zero_based":466},{"literal_text_all_w_t_and_m_t":"-The UE:","paragraph_zero_based":467},{"literal_text_all_w_t_and_m_t":"-Monitors Short Messages transmitted with P-RNTI over DCI (see clause 6.5);","paragraph_zero_based":468},{"literal_text_all_w_t_and_m_t":"-Monitors a Paging channel for CN paging using 5G-S-TMSI, except if the UE is acting as a L2 U2N Remote UE;","paragraph_zero_based":469},{"literal_text_all_w_t_and_m_t":"-If configured by upper layers for MBS multicast reception, monitors a Paging channel for CN paging using TMGI;","paragraph_zero_based":470},{"literal_text_all_w_t_and_m_t":"-Performs neighbouring cell measurements and cell (re-)selection;","paragraph_zero_based":471},{"literal_text_all_w_t_and_m_t":"-Acquires system information and can send SI request (if configured);","paragraph_zero_based":472},{"literal_text_all_w_t_and_m_t":"-Performs logging of available measurements together with location and time for logged measurement configured UEs;","paragraph_zero_based":473},{"literal_text_all_w_t_and_m_t":"-Performs idle/inactive measurements for idle/inactive measurement configured UEs;","paragraph_zero_based":474},{"literal_text_all_w_t_and_m_t":"-If configured by upper layers for MBS broadcast reception, acquires MCCH change notification and MBS broadcast control information and data.","paragraph_zero_based":475},{"literal_text_all_w_t_and_m_t":"-RRC_INACTIVE:","paragraph_zero_based":476},{"literal_text_all_w_t_and_m_t":"-A UE specific DRX may be configured by upper layers or by RRC layer;","paragraph_zero_based":477},{"literal_text_all_w_t_and_m_t":"-At lower layers, the UE may be configured with a DRX for PTM transmission of MBS broadcast and/or a DRX for PTM transmission of MBS multicast;","paragraph_zero_based":478},{"literal_text_all_w_t_and_m_t":"-UE controlled mobility based on network configuration;","paragraph_zero_based":479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"b3775a5d14ac021fc4f5f3e8002b92527fa1c052d9b7c535f196b5410b17f720","original_member_sha256":"0b2b1acef7c2981dcae001f9ad768411cade15b8ef16fbb988748fdb44fd8de1","paragraph_ElementTree_utf8_XML_sha256":["57dad282067d82cff301f6830df1eaba5a9f1e7961b2f2ae23ba5fbe3876a31f","73d1a74ea87bb4aa4ea6570e5045910747de89462c9ea73a83ace7c9665df0c3","4825c26282722b32eb6b0226a6ff7d87b6fc1026f9922a8f1cf1240f399c7d85","c42ee530d41d6e28b6ef9068c259b57b398948404d3747188eb647e2abb4a52e","0e27967a8d8e68be8e8eb135fd63874b6e22c8ceda0a3d5d45570bc735e5b297","822b7a0c1882560195ed52d5b23c093f2ddb8e85891cbe48c16fcb8da7b13e9e","c14f19f09a0baeb92f1e2cbfa90754b8291c1c5660ca3a5a0eebfe8a88db0b27","7a04c3e90b4d9aa4b50d96fe24860a9a78d767b8d42577844a9ebe84c74095e1","43a114b101a41f448df1074698173cada4df8cc8c0f59b56f2aa5d6d0c7cb8e7","93d7c2d52df6820d50305a709b5663bc6b9ce528195c9be5381572872062bc99","a74ddbad8c85f8ae900356a0fda1a55920251a2edd837c54b59376ab803d6eec","fad4a9c3e60dae18d443579329e60902657c0079024e762764fb46f37696b213","71ac216f53982e64bbaa81e24d4d094e34b36999bdae9f37ba986b286d559134","8acba005b566259406877495263d881bb202a7e2fd77f424e8cbfc0f5785331a","ae94228f2506f404b316209bf720204bde3cf1fbfbf204e62b44998faf237a5f","5bb8840bc264bcd2ee2b50b949a77c5325d2db885020974e68bebad049738571","a0f0f586d635c2fae1dd8f09591cea96f9eb2a4f104459112a16a50aa7f69bf4","9ac262285472f62d190098f8e23465c73f0b57de8cbef72b96c136f0cb5262fd","7efa09013c3bd4b1ee16315d893733c55bb8bf0196df454cd77d4ebe8230ac6a","7fc250159637fff2904595cb9c00a931d0438e7a2cdc5aa8f129ca71fc84b608","8bfc1eb9c4cc343f3d04092f6840e352fe31d7fabef3d59165713c0abf08dacc","139fef4904d307697962819861fd67a9a203087fa146d3b2ee083b4804b4723d","9633335ae99665e50d3269d678a9897bae9a49a83004c540c864e21d77ce8e7a","3dd7c5fd8f2f00ac23727c8d7b8e8d0188ee6f7f7ab07313c01eea60d1d4c5ce"],"paragraph_range_zero_based":[456,479],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2401569.zip::R2-2401569 RRC corrections for XR.docx:p456"}
{"fields":{"filename":"R2-2401569.zip::R2-2401569 RRC corrections for XR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-The UE stores the UE Inactive AS context;","paragraph_zero_based":480},{"literal_text_all_w_t_and_m_t":"-A RAN-based notification area is configured by RRC layer;","paragraph_zero_based":481},{"literal_text_all_w_t_and_m_t":"-Transfer of unicast data and/or signalling to/from UE over radio bearers configured for SDT.","paragraph_zero_based":482},{"literal_text_all_w_t_and_m_t":"-The UE:","paragraph_zero_based":483},{"literal_text_all_w_t_and_m_t":"-Monitors Short Messages transmitted with P-RNTI over DCI (see clause 6.5);","paragraph_zero_based":484},{"literal_text_all_w_t_and_m_t":"-While T319a is running, monitors control channels associated with the shared data channel to determine if data is scheduled for it;","paragraph_zero_based":485},{"literal_text_all_w_t_and_m_t":"-While T319a is not running, monitors a Paging channel for CN paging using 5G-S-TMSI and RAN paging using fullI-RNTI, except if the UE is acting as a L2 U2N Remote UE;","paragraph_zero_based":486},{"literal_text_all_w_t_and_m_t":"-If configured by upper layers for MBS multicast reception, while T319a is not running, monitors a Paging channel for paging using TMGI;","paragraph_zero_based":487},{"literal_text_all_w_t_and_m_t":"-Performs neighbouring cell measurements and cell (re-)selection;","paragraph_zero_based":488},{"literal_text_all_w_t_and_m_t":"-Performs RAN-based notification area updates periodically and when moving outside the configured RAN-based notification area;","paragraph_zero_based":489},{"literal_text_all_w_t_and_m_t":"-Acquires system information and, while SDT procedure is not ongoing, can send SI request (if configured);","paragraph_zero_based":490},{"literal_text_all_w_t_and_m_t":"-While SDT procedure is not ongoing, performs logging of available measurements together with location and time for logged measurement configured UEs;","paragraph_zero_based":491},{"literal_text_all_w_t_and_m_t":"-While SDT procedure is not ongoing, performs idle/inactive measurements for idle/inactive measurement configured UEs;","paragraph_zero_based":492},{"literal_text_all_w_t_and_m_t":"-If configured by upper layers for MBS broadcast reception, acquires MCCH change notification and MBS broadcast control information and data;","paragraph_zero_based":493},{"literal_text_all_w_t_and_m_t":"-If configured for MBS multicast reception in RRC_INACTIVE, acquires multicast MCCH change notification and MBS multicast control information and data;","paragraph_zero_based":494},{"literal_text_all_w_t_and_m_t":"-Transmits SRS for Positioning.","paragraph_zero_based":495},{"literal_text_all_w_t_and_m_t":"-RRC_CONNECTED:","paragraph_zero_based":496},{"literal_text_all_w_t_and_m_t":"-The UE stores the AS context;","paragraph_zero_based":497},{"literal_text_all_w_t_and_m_t":"-Transfer of unicast data to/from UE;","paragraph_zero_based":498},{"literal_text_all_w_t_and_m_t":"-Transfer of MBS multicast data to UE;","paragraph_zero_based":499},{"literal_text_all_w_t_and_m_t":"-At lower layers, the UE may be configured with a UE specific DRX;","paragraph_zero_based":500},{"literal_text_all_w_t_and_m_t":"-At lower layers, the UE may be configured with a DRX for PTM transmission of MBS broadcast and/or a DRX for MBS multicast;","paragraph_zero_based":501},{"literal_text_all_w_t_and_m_t":"-At lower layers, the UE may be configured with a cell specific cell DTX/DRX;","paragraph_zero_based":502},{"literal_text_all_w_t_and_m_t":"-For UEs supporting CA, use of one or more SCells, aggregated with the SpCell, for increased bandwidth;","paragraph_zero_based":503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"b3775a5d14ac021fc4f5f3e8002b92527fa1c052d9b7c535f196b5410b17f720","original_member_sha256":"0b2b1acef7c2981dcae001f9ad768411cade15b8ef16fbb988748fdb44fd8de1","paragraph_ElementTree_utf8_XML_sha256":["9f5d7382454ce68e6ab3f6831257ecd55e8416307c707c69f308b24b343da547","489d67171f6cd17a07a302168a3b4402b20fc397b30194f5dbd022986e313f97","c06019132f3b8db38801939853ad3b40a2d28ec72c44e77cb7e252f26b22eeed","ba658824519211621e1e361eb35cac6223f3aa671cf95fb27decfa441a5cfc97","4999021af18bcc72eadd1f6f868c58d45a6a496aca223795531195600ad31302","74fe858d857d2ceeb8b714a3f22e79e4d33ce19f3cee3892656c18bc7d8201c9","a713ec44fbb52587fb029bf07a79ac57603f12741273af87a6e31bb1762e548f","3088f0e285dc7739b74101a9746f6d0669e51defab9354068f4daae422cb65ec","010e98b1f8bf3ae076a908c08c4947846279015c6d416042c0aa102220f66dec","f622f2daffed1765033c88d7641f9969214aae148c0d0ccc21e6ffb86292c3cd","7e43dc284022f279a87cca8deff447f79db01d9a12d1a9ba5103166dbc3126c9","e7b2dd22f4967250f81113d8a072108808244a0083a35bbf2555ec43d8aa7cb6","83023e833d0adb95f2ae819dc5de709d5ecf5809c0727117e20f8df7d19427b9","c187a24f6e3d29bb2887d5cef212ce5958ff879fc2cf15c82e6b755a0f27b0e6","8257f2e278a6e245c66ac148e764b9214e49fdad9ab5543ecaf75c414c7cc598","77bfabfdfaae67ffa4583625e1947ee01c8a78678b5464ea4a6c735c562fc924","e80d7dc331eeb0c2098638a902e4f9388f5c9723db6f9565c546343c9ccd5d2a","a2015b2c1b314caec1d232975408199f816bdbcc5d8911183d3aefd773d19e06","15e27276a246fb2ac16f8b89e25064fbe85182191605e0117616a6ebafc6e748","525e4072fcf43a2fd6d0bb3d8cec3a6440f6e14924f0294b928e4d54d3d4e33c","79626768b4187834190194ee0696f72b780316d05aa0b0b6d3167ad41f03eb25","d3ce137e3f0cdacf813b9a850b8fd1c47f51a1de1e6516b309760dfbac5655d4","65cc7dbc3ae8c150b18877bf310e6548c62c81cf8595822eac4c07767bd7cd9b","8a658e68942e734f737d3e3d8aa53a689b45bd8ac502e1fdfaa1b205fbeff324"],"paragraph_range_zero_based":[480,503],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2401569.zip::R2-2401569 RRC corrections for XR.docx:p480"}
{"fields":{"filename":"R2-2401569.zip::R2-2401569 RRC corrections for XR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-For UEs supporting DC, use of one SCG, aggregated with the MCG, for increased bandwidth;","paragraph_zero_based":504},{"literal_text_all_w_t_and_m_t":"-Network controlled mobility within NR, to/from E-UTRA, and to UTRA-FDD;","paragraph_zero_based":505},{"literal_text_all_w_t_and_m_t":"-Network controlled mobility (path switch) between a serving cell and a L2 U2N Relay UE, or vice versa.","paragraph_zero_based":506},{"literal_text_all_w_t_and_m_t":"-The UE:","paragraph_zero_based":507},{"literal_text_all_w_t_and_m_t":"-Monitors Short Messages transmitted with P-RNTI over DCI (see clause 6.5), if configured;","paragraph_zero_based":508},{"literal_text_all_w_t_and_m_t":"-Monitors control channels associated with the shared data channel to determine if data is scheduled for it;","paragraph_zero_based":509},{"literal_text_all_w_t_and_m_t":"-Provides channel quality and feedback information;","paragraph_zero_based":510},{"literal_text_all_w_t_and_m_t":"-Performs neighbouring cell measurements and measurement reporting;","paragraph_zero_based":511},{"literal_text_all_w_t_and_m_t":"-Acquires system information;","paragraph_zero_based":512},{"literal_text_all_w_t_and_m_t":"-Performs immediate MDT measurement together with available location reporting;","paragraph_zero_based":513},{"literal_text_all_w_t_and_m_t":"-If configured by upper layers for MBS broadcast reception, acquires MCCH change notification and MBS broadcast control information and data.","paragraph_zero_based":514},{"literal_text_all_w_t_and_m_t":"Figure 4.2.1-1 illustrates an overview of UE RRC state machine and state transitions in NR. A UE has only one RRC state in NR at one time.","paragraph_zero_based":515},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":516},{"literal_text_all_w_t_and_m_t":"Figure 4.2.1-1:UE state machine and state transitions in NR","paragraph_zero_based":517},{"literal_text_all_w_t_and_m_t":"Figure 4.2.1-2 illustrates an overview of UE state machine and state transitions in NR as well as the mobility procedures supported between NR/5GC, E-UTRA/EPC and E-UTRA/5GC.","paragraph_zero_based":518},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":519},{"literal_text_all_w_t_and_m_t":"Figure 4.2.1-2:UE state machine and state transitions between NR/5GC, E-UTRA/EPC and E-UTRA/5GC","paragraph_zero_based":520},{"literal_text_all_w_t_and_m_t":"Figure 4.2.1-3 illustrates the mobility procedure supported between NR/5GC and UTRA-FDD.","paragraph_zero_based":521},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":522},{"literal_text_all_w_t_and_m_t":"Figure 4.2.1-3:Mobility procedure supported between NR/5GC and UTRA-FDD","paragraph_zero_based":523},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":524},{"literal_text_all_w_t_and_m_t":"4.2.2Signalling radio bearers","paragraph_zero_based":525},{"literal_text_all_w_t_and_m_t":"\"Signalling Radio Bearers\" (SRBs) are defined as Radio Bearers (RBs) that are used only for the transmission of RRC and NAS messages. More specifically, the following SRBs are defined:","paragraph_zero_based":526},{"literal_text_all_w_t_and_m_t":"-SRB0 is for RRC messages using the CCCH logical channel;","paragraph_zero_based":527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"b3775a5d14ac021fc4f5f3e8002b92527fa1c052d9b7c535f196b5410b17f720","original_member_sha256":"0b2b1acef7c2981dcae001f9ad768411cade15b8ef16fbb988748fdb44fd8de1","paragraph_ElementTree_utf8_XML_sha256":["7da541881bd0e678f4856dd4bca9b2620cf5022da66457bec61df1111603216d","c84bc61524e54533d8f86ae0488f0d87fd951bacc905f72b1278254daedb75a5","8dd91ed64b7d846a9a06d7557e46e04381140e6ea3db587801ea1a6708973733","798000a18a633bfe92153c37d0195f90dde7b419c9cc84e679c39250ab2b4685","e0e78663bc2049e70567388ddd6627d4e1f5634553af48f0d6799cf64e221020","6fad97ad30fb72225a8b4c862dd54cc4068bc3880b88e89e9fbe2d98ee2ab2eb","c3e5afb11012e4ba20ac133f0da43f06d09a0332b14594ef72c3b8d6654c5cc6","b174c93e3ff228afa756267f8b8307c7718660dda4ed64a05a0035bd494138bc","ade183c5b87cf77f45914bdec6c8dec578d80b951a05c09a51434c226a39bd32","ccac756118a071e54f7c0b1e19231b9cffd0d8836b9fa0252376a1517cc6cad6","6c7da0c60c5f0df7a4c80359babc1328f8ee358a37b07d60a0711ebc94a88880","95fd12ec7c322d7260efb1ea8a55cb8b1721d963133a87ac9a3efe58a0ad2235","3b1feec340cbdff0532918a4c3d6e1c98049b84b8903fc9b097d5c02cfa59ac6","e6f02568ab076caf9973011fef150eed9b48e2c0ef93b20694867e8a53038f1e","5e1d49a63893f76a3663927b36ded078c4661003be3f8dd357b28a330f9a0e25","9974f84f60d28420fca263c01f2fd201b28f5bce4b4678e636180ddb1c34667f","f1d54f6f5f2dc80ec10cf4ce40a319008c92ee25319a090b7dbd37bb64945221","c4bb47a011fc8f1af74edea42dd35dad62b3c02ad539e9b5015cf304c5a1a601","6c740b0e7966c0f86527fdd81e6e3c8697a723cd934bb8d41fb34dd544b53daa","0ad249ef8e8025a43a937a043e5865d48bb41bde4a53b0f0c5c100b7f30a3377","426a005a1231157c0658c91b6b1cef26a33b8345e33d0ad1af9af2fd72d36453","55fcd4851f94aa087deee0f0840db533dd969ea483b39533dc5adbdab24e2dbe","8fb4062910105b6c1eeb002bad0244625d4bfe6b118f6f01994342cb3f9212c8","6c0008f91efb4a3e2168dd5f006341c69cdccf6813c13c61318c16677bedbe84"],"paragraph_range_zero_based":[504,527],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2401569.zip::R2-2401569 RRC corrections for XR.docx:p504"}
{"fields":{"filename":"R2-2401569.zip::R2-2401569 RRC corrections for XR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-SRB1 is for RRC messages (which may include a piggybacked NAS message) as well as for NAS messages prior to the establishment of SRB2, all using DCCH logical channel;","paragraph_zero_based":528},{"literal_text_all_w_t_and_m_t":"-SRB2 is for NAS messages and for RRC messages which include logged measurement information, all using DCCH logical channel. SRB2 has a lower priority than SRB1 and may be configured by the network after AS security activation;","paragraph_zero_based":529},{"literal_text_all_w_t_and_m_t":"-SRB3 is for specific RRC messages when UE is in (NG)EN-DC or NR-DC, all using DCCH logical channel;","paragraph_zero_based":530},{"literal_text_all_w_t_and_m_t":"-SRB4 is for RRC messages which include application layer measurement report information, all using DCCH logical channel. SRB4 has a lower priority than SRB1 and can only be configured by the network after AS security activation.","paragraph_zero_based":531},{"literal_text_all_w_t_and_m_t":"-SRB5 is for RRC messages which include application layer measurement report information, all using DCCH logical channel. SRB5 has a lower priority than SRB1 and SRB3 and can only be configured by the SN serving the SCG when the UE is in NR-DC, after AS security activation.","paragraph_zero_based":532},{"literal_text_all_w_t_and_m_t":"In downlink, piggybacking of NAS messages is used only for one dependant (i.e. with joint success/failure) procedure: bearer establishment/modification/release. In uplink piggybacking of NAS message is used only for transferring the initial NAS message during connection setup and connection resume.","paragraph_zero_based":533},{"literal_text_all_w_t_and_m_t":"NOTE 1:The NAS messages transferred via SRB2 are also contained in RRC messages, which however do not include any RRC protocol control information.","paragraph_zero_based":534},{"literal_text_all_w_t_and_m_t":"Once AS security is activated, all RRC messages on SRB1, SRB2, SRB3, SRB4 and SRB5, including those containing NAS messages, are integrity protected and ciphered by PDCP. NAS independently applies integrity protection and ciphering to the NAS messages, see TS 24.501 [23].","paragraph_zero_based":535},{"literal_text_all_w_t_and_m_t":"Split SRB is supported for all the MR-DC options as well as MP in both SRB1 and SRB2 (split SRB is not supported for SRB0, SRB3, SRB4 and SRB5).","paragraph_zero_based":536},{"literal_text_all_w_t_and_m_t":"For operation with shared spectrum channel access in FR1, SRB0, SRB1 and SRB3 are assigned with the highest priority Channel Access Priority Class (CAPC), (i.e. CAPC = 1) while CAPC for SRB2 is configurable.","paragraph_zero_based":537},{"literal_text_all_w_t_and_m_t":"4.3Services","paragraph_zero_based":538},{"literal_text_all_w_t_and_m_t":"4.3.1Services provided to upper layers","paragraph_zero_based":539},{"literal_text_all_w_t_and_m_t":"The RRC protocol offers the following services to upper layers:","paragraph_zero_based":540},{"literal_text_all_w_t_and_m_t":"-Broadcast of common control information;","paragraph_zero_based":541},{"literal_text_all_w_t_and_m_t":"-Notification of UEs in RRC_IDLE, e.g. about a mobile terminating call;","paragraph_zero_based":542},{"literal_text_all_w_t_and_m_t":"-Notification of UEs about ETWS and/or CMAS;","paragraph_zero_based":543},{"literal_text_all_w_t_and_m_t":"-Transfer of dedicated signalling;","paragraph_zero_based":544},{"literal_text_all_w_t_and_m_t":"-Broadcast of positioning assistance data;","paragraph_zero_based":545},{"literal_text_all_w_t_and_m_t":"-Transfer of application layer measurement configuration and reporting.","paragraph_zero_based":546},{"literal_text_all_w_t_and_m_t":"4.3.2Services expected from lower layers","paragraph_zero_based":547},{"literal_text_all_w_t_and_m_t":"In brief, the following are the main services that RRC expects from lower layers:","paragraph_zero_based":548},{"literal_text_all_w_t_and_m_t":"-Integrity protection, ciphering and loss-less in-sequence delivery of information without duplication;","paragraph_zero_based":549},{"literal_text_all_w_t_and_m_t":"4.4Functions","paragraph_zero_based":550},{"literal_text_all_w_t_and_m_t":"The RRC protocol includes the following main functions:","paragraph_zero_based":551}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"b3775a5d14ac021fc4f5f3e8002b92527fa1c052d9b7c535f196b5410b17f720","original_member_sha256":"0b2b1acef7c2981dcae001f9ad768411cade15b8ef16fbb988748fdb44fd8de1","paragraph_ElementTree_utf8_XML_sha256":["f00017110de29f63505c01832c3090f0e7459a7a7ccdfb98ee35b8401f660e9e","c50ce61fe554cc222fb15367a3c33cd71e39c19fb56e05b5ce15a95436f30727","950f929e2f323b3a6df9d1546e75a949ea26d373bcc66505a8155e7bfe9bb6fe","38941aab27e2bbe25bbd70c7dc34d785625ca22a50b5e71014442963b0036089","46beba59cd0c9651e531298be0517c8c5dd444340f6874d8f8775852b1464029","52ffba42655b50c6ac884591544930ae550b5f68833e8a7685b7d242700fb1e4","4a6bc7f3db1b333d3c5ba21e7d1eb5e787dde0d2861cb463cead3fafe079615b","2e92db44cbc1a6a8785c23b6573c10e6bb5360e847c7ab5ea538c690b0b338d7","0203d1a5d917cbdf424b519126b42c660fabc1f28da21961902b8f4b26c9cf06","f7512a5b9a03d2b028a11ef75979cb9d3f11c490aaaea5ec2687fc35ff1ece7b","765a264e47c1bb762a7d115da1970a3668312ff2d2baff183b7e978343bb29f1","4da1c8d1e4ef2199d365de42ca35e951ec9fc1c9540c0fc2253ff3eec113d272","2edd8ae9cd5e318d5d72050769898d85faf3ea2c8c006fda3a2a7bd0de80207e","8eb80e9e14f0ea0f0384a3dcd5d0759a47e6819f77eefe81da4bd91148ed5dac","042ea9fcacb92238680da41a59b22ef4013aeb96c13fde525958bce70ffb59de","8953b308175a97df494a7b7587c09931828b088ba860036b8de75818a9ff458c","4ef725c7e9d51a970d36c8507f3096d19e352fcd7435969e9cbf0a8234dbddd7","0d8588d23b63a612e8ba08d2e3f2c5ea927dfca61fb17ad297582131f522ac5a","7742a16cb516724f737ed08377dc0c77d051a82d2e42eea296be3587d5c98452","48f22d4981f8b315cdd1dcd60c6a799fbfbc6c233bad5a61692bf50856c37007","ef8967c1cb84b473b0be4a66240678c6e29d2730fb403ee4500a92636ffb99e3","232f8aaba01fc6082f9e2fa2486b3c55d27f8d8f56eb960a3de85987b3543393","00acf12405736c1308410520e857de0ac7eedbc400076434af7c3b3eb7adbd80","95114bd0c108a328af4acd4205c855465a5e2c923f2b512cb12357256a0615fe"],"paragraph_range_zero_based":[528,551],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2401569.zip::R2-2401569 RRC corrections for XR.docx:p528"}
{"fields":{"filename":"R2-2401569.zip::R2-2401569 RRC corrections for XR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-Broadcast of system information:","paragraph_zero_based":552},{"literal_text_all_w_t_and_m_t":"-Including NAS common information;","paragraph_zero_based":553},{"literal_text_all_w_t_and_m_t":"-Information applicable for UEs in RRC_IDLE and RRC_INACTIVE (e.g. cell (re-)selection parameters, neighbouring cell information) and information (also) applicable for UEs in RRC_CONNECTED (e.g. common channel configuration information);","paragraph_zero_based":554},{"literal_text_all_w_t_and_m_t":"-Including ETWS notification, CMAS notification;","paragraph_zero_based":555},{"literal_text_all_w_t_and_m_t":"-Including positioning assistance data.","paragraph_zero_based":556},{"literal_text_all_w_t_and_m_t":"-RRC connection control:","paragraph_zero_based":557},{"literal_text_all_w_t_and_m_t":"-Paging;","paragraph_zero_based":558},{"literal_text_all_w_t_and_m_t":"-Establishment/modification/suspension/resumption/release of RRC connection, including e.g. assignment/modification of UE identity (C-RNTI, fullI-RNTI, etc.), establishment/modification/suspension/resumption/release of SRBs (except for SRB0);","paragraph_zero_based":559},{"literal_text_all_w_t_and_m_t":"-Access barring;","paragraph_zero_based":560},{"literal_text_all_w_t_and_m_t":"-Initial AS security activation, i.e. initial configuration of AS integrity protection (SRBs, DRBs) and AS ciphering (SRBs, DRBs);","paragraph_zero_based":561},{"literal_text_all_w_t_and_m_t":"-RRC connection mobility including e.g. intra-frequency and inter-frequency handover, path switch from a PCell to a target L2 U2N Relay UE or from a L2 U2N Relay UE to a target PCell or from a source L2 U2N Relay UE to a target L2 U2N Relay UE, associated AS security handling, i.e. key/algorithm change, specification of RRC context information transferred between network nodes;","paragraph_zero_based":562},{"literal_text_all_w_t_and_m_t":"-Establishment/modification/suspension/resumption/release of RBs carrying user data (DRBs/MRBs);","paragraph_zero_based":563},{"literal_text_all_w_t_and_m_t":"-Radio configuration control including e.g. assignment/modification of ARQ configuration, HARQ configuration, DRX configuration;","paragraph_zero_based":564},{"literal_text_all_w_t_and_m_t":"-In case of DC, cell management including e.g. change of PSCell, addition/modification/release of SCG cell(s);","paragraph_zero_based":565},{"literal_text_all_w_t_and_m_t":"-In case of CA, cell management including e.g. addition/modification/release of SCell(s);","paragraph_zero_based":566},{"literal_text_all_w_t_and_m_t":"-In case of MP, path management including e.g. addition/modification/release of indirect path;","paragraph_zero_based":567},{"literal_text_all_w_t_and_m_t":"-QoS control including assignment/ modification of semi-persistent scheduling (SPS) configuration and configured grant configuration for DL and UL respectively, assignment/ modification of parameters for UL rate control in the UE, i.e. allocation of a priority and a prioritised bit rate (PBR) for each RB of UE and logical channel of IAB-MT.","paragraph_zero_based":568},{"literal_text_all_w_t_and_m_t":"-Recovery from radio link failure.","paragraph_zero_based":569},{"literal_text_all_w_t_and_m_t":"-Inter-RAT mobility including e.g. AS security activation, transfer of RRC context information;","paragraph_zero_based":570},{"literal_text_all_w_t_and_m_t":"-Measurement configuration and reporting:","paragraph_zero_based":571},{"literal_text_all_w_t_and_m_t":"-Establishment/modification/release of measurement configuration (e.g. intra-frequency, inter-frequency and inter- RAT measurements);","paragraph_zero_based":572},{"literal_text_all_w_t_and_m_t":"-Setup and release of measurement gaps;","paragraph_zero_based":573},{"literal_text_all_w_t_and_m_t":"-Measurement reporting.","paragraph_zero_based":574},{"literal_text_all_w_t_and_m_t":"-Configuration of BAP entity and BH RLC channels for the support of IAB-node.","paragraph_zero_based":575}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"b3775a5d14ac021fc4f5f3e8002b92527fa1c052d9b7c535f196b5410b17f720","original_member_sha256":"0b2b1acef7c2981dcae001f9ad768411cade15b8ef16fbb988748fdb44fd8de1","paragraph_ElementTree_utf8_XML_sha256":["7caa2ce4e5826123429ec6a7fc006bc8a661d86a2f6c0cc38583579d74d728a8","3d369aa349fb2fbb374dc40a5c35aa3c763fa4a8384aa02538394b1578b16f7d","86cca26b82655ca9c5e86de3b7e96e32d384dab649cfadf932f2d927d6e8d94e","2131797a46014e657d9b1fd3a4421fc2d818100f36ef11698d0b4d26be49591e","64d1077186eab521db64993f74f500c8ac48f77bc955826ca6b6c3c700731b84","55d5108640d21e6da77d756f21596920b635e37d690c31527dfa970d37ce5c30","780ee94ad5c6b6d6e67ed105c3a05de0da0684b0136abe45e1b1c9d385de7e76","3fe11e37830ebe44476ddb52649aa31edb74d08f65d7c4af7c60a209f1f2329a","eb3f71cb1ef7ea387a43b9ac69da025fc287c17873178248265f5778a66e8995","a49633a3294257bd2b5c84f94309b4508b1f2aafe4c25999358eee1ed42edcc1","d0ef8ee79ca7edc6a2467b50558a06c45ac103391929a96d06afdee6f29710d2","62262f265b5c2235e3f59b19a41faa2bf5ddd34664b02c49d9f55b0456581a67","d26394cc7567dcef63bdae27af05ccac721278a884a40ed65cc84780bc1effc8","4f4b4060971e9ac6b7e37228076c20b434af656ef84237bcdea4a0bdb0d2865f","7a3682a3a476561b2393f3d6c64c5215d7789a6d790c7bb62964ddb26590f63e","cb322ec6b98fdab3b6235f89cb49e50148659bcc9c4465b2e23792940e8e13b3","74c8d5282404fd54d4d77f6e645b98412707d16a9da633e311ddbbb59cad074b","6882eec7ca0bb8c83fd3da72ff5896f526d509f1aac756845018da73150facce","03953276b9fb363356c3534eb139981ad3236114f3663ce4dfbee73a3ea58ae0","b71b1c31ec828a2148fbf334f235ddabdebfb7050f22a52b128ad0c21be3b686","dfb7e2134d502a81c728e9c0e1ecca1f38e2fd443521fd0a3949785bbe67bb9e","c9b34b8d66471c99020aa6d65d64ad856d260b37c89c5083520cf6d5fa027663","2dfbb8145fd9dc50e5bfa6383b35555fa229f28c91d4c1bec7528e7f969ccd6e","10bebcc758a4da33a5f62a7a1baf7fc2b293a20986c47c9f6bbe4d94ce259da5"],"paragraph_range_zero_based":[552,575],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2401569.zip::R2-2401569 RRC corrections for XR.docx:p552"}
{"fields":{"filename":"R2-2401569.zip::R2-2401569 RRC corrections for XR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-Configuration of SRAP entity and Uu/PC5 Relay RLC channels for the support of L2 U2N relay.","paragraph_zero_based":576},{"literal_text_all_w_t_and_m_t":"-Other functions including e.g. generic protocol error handling, transfer of dedicated NAS information, transfer of UE radio access capability information.","paragraph_zero_based":577},{"literal_text_all_w_t_and_m_t":"-Support of self-configuration and self-optimisation.","paragraph_zero_based":578},{"literal_text_all_w_t_and_m_t":"-Support of measurement logging and reporting for network performance optimisation, as specified in TS 37.320 [61];","paragraph_zero_based":579},{"literal_text_all_w_t_and_m_t":"-Support of transfer of application layer measurement configuration and reporting.","paragraph_zero_based":580},{"literal_text_all_w_t_and_m_t":"-Configuration of side control information for NCR-node.","paragraph_zero_based":581},{"literal_text_all_w_t_and_m_t":"5Procedures","paragraph_zero_based":582},{"literal_text_all_w_t_and_m_t":"5.1General","paragraph_zero_based":583},{"literal_text_all_w_t_and_m_t":"5.1.1Introduction","paragraph_zero_based":584},{"literal_text_all_w_t_and_m_t":"This clause covers the general requirements.","paragraph_zero_based":585},{"literal_text_all_w_t_and_m_t":"5.1.2General requirements","paragraph_zero_based":586},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":587},{"literal_text_all_w_t_and_m_t":"1>process the received messages in order of reception by RRC, i.e. the processing of a message shall be completed before starting the processing of a subsequent message;","paragraph_zero_based":588},{"literal_text_all_w_t_and_m_t":"NOTE:Network may initiate a subsequent procedure prior to receiving the UE's response of a previously initiated procedure.","paragraph_zero_based":589},{"literal_text_all_w_t_and_m_t":"1>within a clause execute the steps according to the order specified in the procedural description;","paragraph_zero_based":590},{"literal_text_all_w_t_and_m_t":"1>consider the term 'radio bearer' (RB) to cover SRBs, DRBs and MRBs unless explicitly stated otherwise;","paragraph_zero_based":591},{"literal_text_all_w_t_and_m_t":"1>set the rrc-TransactionIdentifier in the response message, if included, to the same value as included in the message received from the network that triggered the response message;","paragraph_zero_based":592},{"literal_text_all_w_t_and_m_t":"1>upon receiving a choice value set to setup:","paragraph_zero_based":593},{"literal_text_all_w_t_and_m_t":"2>apply the corresponding received configuration and start using the associated resources, unless explicitly specified otherwise;","paragraph_zero_based":594},{"literal_text_all_w_t_and_m_t":"1>upon receiving a choice value set to release:","paragraph_zero_based":595},{"literal_text_all_w_t_and_m_t":"2>clear the corresponding configuration and stop using the associated resources;","paragraph_zero_based":596},{"literal_text_all_w_t_and_m_t":"1>in case the size of a list is extended, upon receiving an extension field comprising the entries in addition to the ones carried by the original field (regardless of whether the network signals more entries in total); apply the following generic behaviour unless explicitly stated otherwise:","paragraph_zero_based":597},{"literal_text_all_w_t_and_m_t":"2>create a combined list by concatenating the additional entries included in the extension field to the original field while maintaining the order among both the original and the additional entries;","paragraph_zero_based":598},{"literal_text_all_w_t_and_m_t":"2>for the combined list, created according to the previous, apply the same behaviour as defined for the original field.","paragraph_zero_based":599}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"b3775a5d14ac021fc4f5f3e8002b92527fa1c052d9b7c535f196b5410b17f720","original_member_sha256":"0b2b1acef7c2981dcae001f9ad768411cade15b8ef16fbb988748fdb44fd8de1","paragraph_ElementTree_utf8_XML_sha256":["7335d1492a7abfa60c81296ffc8dedc91579397b0cc448c0a3b17d1e4a3968f3","7c4f3b0a161c0293d5c032e5f8d87f209b2eb037dfbcaf50d905f90f629afa9b","ac19676dffaf40ae2da462047ea3fbd81c19a23d03fcdf211de1525cbf01485d","0ceeeae9559ced73922913e2fb9a45132b9c330cef77d36e489bddf09f5f78aa","3b6a0435c56c42d0d2f5636b0cb65a52ad4d77c3bc0be5861314836e76b2e4ef","fd90be4c69a0838a543f660e31ed71fea429f142fa53da51314eb12066cae480","7e82cf2b3b56259455e27602fdfbe1c89f3b549afbc8860ff62b89409b116f8a","18707b8914a3f8092045c2eaf749cbd41b77df3d540e31a844c8c3d0354fe976","3d31a7ded77a9c962ef7370dcc7842b8463be26949e5b27a000ccd05aab8f8dc","71de8d809e12833cd9d9028885b4e1ed67dda50fc6064dc65764d77e21f3a6ce","17c5cf8fed4d23cd240c70d32ec70d961c6c5ddc4c078f9a0419280110e45e4f","aa81efe1010ca0c402942592cfce854efbc4b2232bc9f337004a6bf14b7630f0","133fc346b7ee68f5420851cf12f4d3d59a6e8c784a35214d06249012251c5a16","ce39d1ed1c480a20a2dd19d900d451c1a08786f51df1f0c8be2e19f630c3eff0","0abcf4a00a040bb0cd0a4de28332d3c10aff2022121276c1fa2d93984672c72a","fdfeb58ceb2252073ccc88084d5ae7a12a9c9dddb38c09eefc9bd8242091176d","5135d448518e9ff43a274dc96e2651622e3f29d9660755e988a2a9e38de5c187","a462e46706f49d74a0822cd5edf5627518b07e40ecac3e8d021eacfa560d8657","7456ee8318d86e97168b31e1000b45f326d0613bfa1910b2936d845d1e6c4fad","b0a859f0bba69e280284d49527d55e8d415c2003a45308b9c0d0b3f1bff3f2ab","85db1b4ce68024f5c7be45463b692aa9aff5c8fd7ecca3881f7894c6da6d5d68","55a1f106076410a91984fa2d7daefea63d30cabf60d289e87397e34863af487f","00a8849b31a41f0653c2bcc527702749b10a911c5b538e6d487caa1e4913ca04","a1914eb22c556be43cd5cecb4b0c000dd25f3a864911077b499a7ceab78c1446"],"paragraph_range_zero_based":[576,599],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2401569.zip::R2-2401569 RRC corrections for XR.docx:p576"}
{"fields":{"filename":"R2-2401569.zip::R2-2401569 RRC corrections for XR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.1.3Requirements for UE in MR-DC","paragraph_zero_based":600},{"literal_text_all_w_t_and_m_t":"In this specification, the UE considers itself to be in:","paragraph_zero_based":601},{"literal_text_all_w_t_and_m_t":"-EN-DC, if and only if it is configured with nr-SecondaryCellGroupConfig according to TS 36.331[10], and it is connected to EPC,","paragraph_zero_based":602},{"literal_text_all_w_t_and_m_t":"-NGEN-DC, if and only if it is configured with nr-SecondaryCellGroupConfig according to TS 36.331[10], and it is connected to 5GC,","paragraph_zero_based":603},{"literal_text_all_w_t_and_m_t":"-NE-DC, if and only if it is configured with mrdc-SecondaryCellGroup set to eutra-SCG,","paragraph_zero_based":604},{"literal_text_all_w_t_and_m_t":"-NR-DC, if and only if it is configured with mrdc-SecondaryCellGroup set to nr-SCG,","paragraph_zero_based":605},{"literal_text_all_w_t_and_m_t":"-MR-DC, if and only if it is in (NG)EN-DC, NE-DC or NR-DC.","paragraph_zero_based":606},{"literal_text_all_w_t_and_m_t":"NOTE:This use of these terms deviates from the definition in TS 37.340 [41] and other specifications. In TS 37.340, these terms include also the case where the UE is configured with E-UTRA or NR MCG only (i.e. no NR or E-UTRA SCG) but with one or more bearers terminated in a secondary node (i.e. using NR PDCP).","paragraph_zero_based":607},{"literal_text_all_w_t_and_m_t":"The UE in (NG)EN-DC only executes a subclause of clause 5 in this specification when the subclause:","paragraph_zero_based":608},{"literal_text_all_w_t_and_m_t":"-is referred to from a subclause under execution, either in this specification or in TS 36.331 [10]; or","paragraph_zero_based":609},{"literal_text_all_w_t_and_m_t":"-applies to a message received on SRB3 (if SRB3 is established); or","paragraph_zero_based":610},{"literal_text_all_w_t_and_m_t":"-applies to field(s), IE(s), UE variable(s) or timer(s) in this specification that the UE is configured with.","paragraph_zero_based":611},{"literal_text_all_w_t_and_m_t":"When executing a subclause of clause 5 in this specification, the UE follows the requirements in clause 5.1.2 and in all subclauses of this specification applicable to the messages (including processing time requirements), fields, IEs, timers and UE variables indicated in the subclause under execution.","paragraph_zero_based":612},{"literal_text_all_w_t_and_m_t":"5.2System information","paragraph_zero_based":613},{"literal_text_all_w_t_and_m_t":"5.2.1Introduction","paragraph_zero_based":614},{"literal_text_all_w_t_and_m_t":"System Information (SI) is divided into the MIB and a number of SIBs and posSIBs where:","paragraph_zero_based":615},{"literal_text_all_w_t_and_m_t":"-the MIB is always transmitted on the BCH with a periodicity of 80 ms and repetitions made within 80 ms (TS 38.212 [17], clause 7.1) and it includes parameters that are needed to acquire SIB1 from the cell. The first transmission of the MIB is scheduled in subframes as defined in TS 38.213 [13], clause 4.1 and repetitions are scheduled according to the period of SSB;","paragraph_zero_based":616},{"literal_text_all_w_t_and_m_t":"NOTE 1:If the period of SSB is larger than 80 ms, the MIB is transmitted with the same periodicity as that of SSB.","paragraph_zero_based":617},{"literal_text_all_w_t_and_m_t":"-the SIB1 is transmitted on the DL-SCH with a periodicity of 160 ms and variable transmission repetition periodicity within 160 ms as specified in TS 38.213 [13], clause 13. The default transmission repetition periodicity of SIB1 is 20 ms but the actual transmission repetition periodicity is up to network implementation. For SSB and CORESET multiplexing pattern 1, SIB1 repetition transmission period is 20 ms. For SSB and CORESET multiplexing pattern 2/3, SIB1 transmission repetition period is the same as the SSB period (TS 38.213 [13], clause 13). SIB1 includes information regarding the availability and scheduling (e.g. mapping of SIBs to SI message, periodicity, SI-window size) of other SIBs with an indication whether one or more SIBs are only provided on-demand and, in that case, the configuration needed by the UE to perform the SI request. SIB1 is cell-specific SIB;","paragraph_zero_based":618},{"literal_text_all_w_t_and_m_t":"-SIBs other than SIB1 and posSIBs are carried in SystemInformation (SI) messages, which are transmitted on the DL-SCH. Only SIBs or posSIBs having the same periodicity can be mapped to the same SI message. SIBs and posSIBs are mapped to different SI messages, i.e. an SI message contains either only SIBs or only posSIBs. Each SI message is transmitted within periodically occurring time domain windows (referred to as SI-windows with same length for all SI messages). Each SI message is associated with an SI-window and the SI-windows of different SI messages do not overlap. That is, within one SI-window only the corresponding SI message is transmitted. An SI message may be repeated with the same content a number of times within the SI-window. Any SIB or posSIB except SIB1 can be configured to be cell specific or area specific, using an indication in SIB1. The cell specific SIB is applicable only within a cell that provides the SIB while the area specific SIB is applicable within an area referred to as SI area, which consists of one or several cells and is identified by systemInformationAreaID;","paragraph_zero_based":619},{"literal_text_all_w_t_and_m_t":"-The mapping of SIBs to SI messages is configured in schedulingInfoList and schedulingInfoList2, while the mapping of posSIBs to SI messages is configured in posSchedulingInfoList and schedulingInfoList2.Each SIB and each posSIB is mapped to a single SI message. posSIBs of the same posSibType carrying GNSS Generic Assistance Data for different GNSS/SBAS (identified by gnss-id/sbas-id, see TS 37.355 [49]) are mapped to different SI messages.Each SIB and posSIB is contained at most once in an SI message.For SIBs and posSIBs with segments, the segments contained in SI messages are transmitted according to the SI message periodicity, with one segment of a particular sibType/posSibType in each SI message;","paragraph_zero_based":620},{"literal_text_all_w_t_and_m_t":"-For a UE in RRC_CONNECTED, the network can provide system information through dedicated signalling using the RRCReconfiguration message, e.g. if the UE has an active BWP with no common search space configured to monitor system information, paging, or upon request from the UE.","paragraph_zero_based":621},{"literal_text_all_w_t_and_m_t":"-For PSCell and SCells, the network provides the required SI by dedicated signalling, i.e. within an RRCReconfiguration message. Nevertheless, the UE shall acquire MIB of the PSCell to get SFN timing of the SCG (which may be different from MCG). Upon change of relevant SI for SCell, the network releases and adds the concerned SCell. For PSCell, the required SI can only be changed with Reconfiguration with Sync.","paragraph_zero_based":622},{"literal_text_all_w_t_and_m_t":"NOTE 2:The physical layer imposes a limit to the maximum size a SIB can take. The maximum SIB1 or SI message size is 2976 bits.","paragraph_zero_based":623}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"b3775a5d14ac021fc4f5f3e8002b92527fa1c052d9b7c535f196b5410b17f720","original_member_sha256":"0b2b1acef7c2981dcae001f9ad768411cade15b8ef16fbb988748fdb44fd8de1","paragraph_ElementTree_utf8_XML_sha256":["14e309d469ba2ade2fa2e5f0788b32381513cbe11caf86bb964eb80441754e5e","08df3271a79b2151963b463d919a2406e7c9deb1ae519487d6511e9f03f623d5","105bb82520ff0e2ae80d32bb9473fd5b94b78adef6bc61d15c9e320a4f27dc06","af904dadb9508a93384c9c75f129a896e33a15c5e59dfedccb4e2ed668bde92f","03f68fc07cc86d3a2f0ba51c8939816c5158b9f9e1cc2e05e0657138cd2efc74","d258049e8736e910b0473374a33a387ad227798079a2c2f84fd4938ee55a74e4","708f47c52c6139c05ee44689ebbaa1ef7c55ad284d93d0522b4188e66e3ea9a6","f8006d5a1b52e99ca8664c4e37190ab29ed84b9f87bfbfb8b0232df7b6e88433","4569958694248059ad039af352e45af35814d2ab80cc9906827f24175a23d3f0","557cc919dc195d286a4913debb26193a0729fe1c966f3b16e3128907b1966262","c85715d115607f9d9407fa3217f08cf9864c4481b0039edbb5290490bac1f821","943453bacc669bddb686c59c0b9407d9cfddf294f53dbec9afa040ca912e4c6f","324bf4853784e57326230e7fd229bdeb7b91a30ea844e42b87123a35ae73e88b","6aeefcbb92d9643f87c6f08cd438874ac4fac38b49e8370a8f3fe36db9a0e320","f97b2d293ec1f9b70b98e27ddf13bc204f76fcbdb07114ef03f5cd8fa7e3871b","47e333bc4ba128029ad5cecfa11a77a031621d6317f82905c94d4b84ebd98208","664d2382743da97c765f08212c5b5d2ac7daca90170982eb207bb0b51c4826d5","bcffd9a7b718df642db629754af307c487712fa3a7daf7f2d6b0233acbee429e","b2571053f9e95deaa72d78698516eaa1b969b34da37f72a87bf831fefb72e290","9588b8aa020316d169c6af45132431cbb5aa951368e880a59198ee91939d5d96","076eaaa0cf7bc27b6fd63e1b063bddee9f68a887147c1cb1d4d1a8b8626a2bff","8b7dd18a3105a64028bfb229bc677e084153c6a8a2111d2976ec02cc6433d577","c25d98407699b46177a06faaa4ed976b28d80693dcd314c26ef62b585ab30ef2","7c0e059017924141e9f939523821aadbad460910fd85b3c1dcc440df8794ab58"],"paragraph_range_zero_based":[600,623],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2401569.zip::R2-2401569 RRC corrections for XR.docx:p600"}
{"fields":{"filename":"R2-2401569.zip::R2-2401569 RRC corrections for XR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.2.2System information acquisition","paragraph_zero_based":624},{"literal_text_all_w_t_and_m_t":"5.2.2.1General UE requirements","paragraph_zero_based":625},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":626},{"literal_text_all_w_t_and_m_t":"Figure 5.2.2.1-1: System information acquisition","paragraph_zero_based":627},{"literal_text_all_w_t_and_m_t":"The UE applies the SI acquisition procedure to acquire the AS, NAS- and positioning assistance data information. The procedure applies to UEs in RRC_IDLE, in RRC_INACTIVE and in RRC_CONNECTED.","paragraph_zero_based":628},{"literal_text_all_w_t_and_m_t":"The UE in RRC_IDLE and RRC_INACTIVE shall ensure having a valid version of (at least) the MIB, SIB1 through SIB4, SIB5 (if the UE supports E-UTRA), SIB11 (if the UE is configured for idle/inactive measurements), SIB12 (if UE is capable of NR sidelink communication/discovery and is configured by upper layers to receive or transmit NR sidelink communication/discovery), and SIB13, SIB14 (if UE is capable of V2X sidelink communication and is configured by upper layers to receive or transmit V2X sidelink communication), SIB15 (if UE is configured by upper layers to report disaster roaming related information), SIB16 (if the UE is capable of slice-based cell reselection and the UE receives NSAG information for cell reselection from upper layer), SIB17 (if the UE is using TRS resources for power saving in RRC_IDLE and RRC_INACTIVE), SIB19 (if UE is accessing NR via NTN access) and SIB22 (for ATG access).","paragraph_zero_based":629},{"literal_text_all_w_t_and_m_t":"The UE capable of MBS broadcast which is receiving or interested to receive MBS broadcast service(s) via a broadcast MRB shall ensure having a valid version of SIB20, regardless of the RRC state the UE is in.","paragraph_zero_based":630},{"literal_text_all_w_t_and_m_t":"The UE shall ensure having a valid version of the posSIB requested by upper layers.","paragraph_zero_based":631},{"literal_text_all_w_t_and_m_t":"5.2.2.2SIB validity and need to (re)-acquire SIB","paragraph_zero_based":632},{"literal_text_all_w_t_and_m_t":"5.2.2.2.1SIB validity","paragraph_zero_based":633},{"literal_text_all_w_t_and_m_t":"The UE shall apply the SI acquisition procedure as defined in clause 5.2.2.3 upon cell selection (e.g. upon power on), cell-reselection, return from out of coverage, after reconfiguration with sync completion, after entering the network from another RAT, upon receiving an indication that the system information has changed, upon receiving a PWS notification, upon receiving request (e.g., a positioning request) from upper layers; and whenever the UE does not have a valid version of a stored SIB or posSIB or a valid version of a requested SIB.","paragraph_zero_based":634},{"literal_text_all_w_t_and_m_t":"When the UE acquires a MIB or a SIB1 or an SI message in a serving cell as described in clause 5.2.2.3, and if the UE stores the acquired SIB, then the UE shall store the associated areaScope, if present, the first PLMN-Identity in the PLMN-IdentityInfoList for non-NPN-only cells or the first NPN identity (SNPN identity in case of SNPN, or PNI-NPN identity in case of PNI-NPN) in the NPN-IdentityInfoList for NPN-only cells, the cellIdentity, the systemInformationAreaID, if present, and the valueTag, if present, as indicated in the si-SchedulingInfo for the SIB. If the UE stores the acquired posSIB, then the UE shall store the associated areaScope, if present, the cellIdentity, the systemInformationAreaID, if present, the valueTag, if provided in assistanceDataSIB-Element, and the expirationTime if provided in assistanceDataSIB-Element. The UE may use a valid stored version of the SI except MIB, SIB1, SIB6, SIB7 or SIB8 e.g. after cell re-selection, upon return from out of coverage or after the reception of SI change indication. The valueTag and expirationTime for posSIB is optionally provided in assistanceDataSIB-Element, as specified in TS 37.355 [49].","paragraph_zero_based":635},{"literal_text_all_w_t_and_m_t":"A L2 U2N Remote UE in RRC_IDLE or RRC_INACTIVE can inform the interested SIB(s) to the connected L2 U2N Relay UE as defined in clause 5.8.9.8.2 and receive the SIB(s) from the L2 U2N Relay UE as defined in clause 5.8.9.9.3. A L2 U2N Remote UE in RRC_CONNECTED receives SIB1 and other SIB(s) in RRCReconfiguration message and performs on-demand SI request if required, as defined in clause 5.2.2.3.5 and 5.2.2.3.6. The L2 U2N Remote UE in RRC_IDLE or RRC_INACTIVE or RRC_CONNECTED is not required to obtain SI over Uu interface, but it may decide to perform the SI acquisition procedure over Uu interface as defined in clause 5.2.2.3 by UE implementation.","paragraph_zero_based":636},{"literal_text_all_w_t_and_m_t":"NOTE:The storage and management of the stored SIBs in addition to the SIBs valid for the current serving cell is left to UE implementation.","paragraph_zero_based":637},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":638},{"literal_text_all_w_t_and_m_t":"1>delete any stored version of a SIB after 3 hours from the moment it was successfully confirmed as valid;","paragraph_zero_based":639},{"literal_text_all_w_t_and_m_t":"1>for each stored version of a SIB:","paragraph_zero_based":640},{"literal_text_all_w_t_and_m_t":"2>if the areaScope is associated and its value for the stored version of the SIB is the same as the value received in the si-SchedulingInfo for that SIB from the serving cell:","paragraph_zero_based":641},{"literal_text_all_w_t_and_m_t":"3>if the UE is NPN capable and the cell is an NPN-only cell:","paragraph_zero_based":642},{"literal_text_all_w_t_and_m_t":"4>if the first NPN identity included in the NPN-IdentityInfoList, the systemInformationAreaID and the valueTag that are included in the si-SchedulingInfo for the SIB received from the serving cell are identical to the NPN identity, the systemInformationAreaID and the valueTag associated with the stored version of that SIB:","paragraph_zero_based":643},{"literal_text_all_w_t_and_m_t":"5>consider the stored SIB as valid for the cell;","paragraph_zero_based":644},{"literal_text_all_w_t_and_m_t":"3>else if the first PLMN-Identity included in the PLMN-IdentityInfoList, the systemInformationAreaID and the valueTag that are included in the si-SchedulingInfo for the SIB received from the serving cell are identical to the PLMN-Identity, the systemInformationAreaID and the valueTag associated with the stored version of that SIB:","paragraph_zero_based":645},{"literal_text_all_w_t_and_m_t":"4>consider the stored SIB as valid for the cell;","paragraph_zero_based":646},{"literal_text_all_w_t_and_m_t":"2>if the areaScope is not present for the stored version of the SIB and the areaScope value is not included in the si-SchedulingInfo for that SIB from the serving cell:","paragraph_zero_based":647}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"b3775a5d14ac021fc4f5f3e8002b92527fa1c052d9b7c535f196b5410b17f720","original_member_sha256":"0b2b1acef7c2981dcae001f9ad768411cade15b8ef16fbb988748fdb44fd8de1","paragraph_ElementTree_utf8_XML_sha256":["84b7b83b51424f6e78a63d41dedbd02ae5f4927a7d5dc4c75bf695b7b092d0fe","bc2c3673940284306b2b4f5b97c577ee6d1ae0edd551566156e40c2886146a2b","230971a123fb4484b174de7289a530ef5900020a5d48dfa249f10fdf17f0c8b6","488e7e3866202bf42107639394631240e4060064748d00ac087b58bceca841c6","dc4dd0b12b50290d6de87706b9daacaa53a774700589e640bdacf145d51203ab","16cb356b17b2795e8a574ab6626b863ae50c841d1546f597d344da19a155e80e","abed9a523700b9494b8dc341869bfa54f2fa9a1e236af57745241d7c1ea212b6","f51dfd92c887e3369a149ec758343f1901450dc7fa8bf49abfeac5384f618762","79ebfa6172c670fb3e39d20577af1a0aad2dff5210a26234ec5438a86a1fde99","417b362a88b6d832d2f3dfa1026003e8e5002a6a408d3cb4843b8f113c5cf5ca","3c2982f9af5b00967b5797839805686863fce4f8c6a48f021865b02af89e5826","610b4da5e5480418a0b8c29d83347dc262c47b4f00b8106feea32304206b7406","748a802e82e1a46336d0ff890016fd787a6eec7f5db2a7be8355c49a39ec49c9","a02807db0ec8d915329113a8943d233626900fed881559f2ca5ac0b2ff709571","bb213f3e5c6dc23bac5377407807ab340428b356e6e903c1f52d750fcd69a6e2","b72ae109c5d6dde6406b06a6df57594795888750fa0240735e4caed99936525f","5c5487ca213035acc9ccbe2de5d61b1b03be24f7a7b30decdbea1e56b8ed13b1","8d3c57a4e93380b5f5f5bb8bd50e50478d88275c018a427ee881d226cc10b9c7","81572d96992f2976c44ecf13dac7c7351a70a01314529f99d82090005ebb5fa7","0d8e1aeccda13bc9693ddc1a41cd9e5acf631f573f6b74fbd1a79a8862455747","939f5028f68d517f1f22b8ce469538f77ceab5c9497fab723da9ed03711d5022","f5cb8101dc2c452c3096da43da7d12481289ed1c378ae2975ce4709368e06cf5","4fac315e9177d3dc0c26f9396e8b9ea23feb1fde0b7c29e4385720984cbf7d21","d0b700bdce79239889a3cc42736ff8fb18472779b360eb8a04ab0b1539cbcc62"],"paragraph_range_zero_based":[624,647],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2401569.zip::R2-2401569 RRC corrections for XR.docx:p624"}
{"fields":{"filename":"R2-2401569.zip::R2-2401569 RRC corrections for XR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>if the UE is NPN capable and the cell is an NPN-only cell:","paragraph_zero_based":648},{"literal_text_all_w_t_and_m_t":"4>if the first NPN identity in the NPN-IdentityInfoList, the cellIdentity and valueTag that are included in the si-SchedulingInfo for the SIB received from the serving cell are identical to the NPN identity, the cellIdentity and the valueTag associated with the stored version of that SIB:","paragraph_zero_based":649},{"literal_text_all_w_t_and_m_t":"5>consider the stored SIB as valid for the cell;","paragraph_zero_based":650},{"literal_text_all_w_t_and_m_t":"3>else if the first PLMN-Identity in the PLMN-IdentityInfoList, the cellIdentity and valueTag that are included in the si-SchedulingInfo for the SIB received from the serving cell are identical to the PLMN-Identity, the cellIdentity and the valueTag associated with the stored version of that SIB:","paragraph_zero_based":651},{"literal_text_all_w_t_and_m_t":"4>consider the stored SIB as valid for the cell;","paragraph_zero_based":652},{"literal_text_all_w_t_and_m_t":"1>for each stored version of a posSIB:","paragraph_zero_based":653},{"literal_text_all_w_t_and_m_t":"2>if the areaScope is associated and its value for the stored version of the posSIB is the same as the value received in the posSIB-MappingInfo for that posSIB from the serving cell and the systemInformationAreaID included in the si-SchedulingInfo is identical to the systemInformationAreaID associated with the stored version of that posSIB:","paragraph_zero_based":654},{"literal_text_all_w_t_and_m_t":"3>if the valueTag (see TS 37.355 [49]) for the posSIB received from the serving cell is identical to the valueTag associated with the stored version of that posSIB; or if the expirationTime (see TS 37.355 [49]) associated with the stored posSIB has not been expired:","paragraph_zero_based":655},{"literal_text_all_w_t_and_m_t":"4>consider the stored posSIB as valid for the cell;","paragraph_zero_based":656},{"literal_text_all_w_t_and_m_t":"2>if the areaScope is not present for the stored version of the posSIB and the areaScope value is not included in the posSIB-MappingInfo for that posSIB from the serving cell and the cellIdentity for the posSIB received from the serving cell is identical to the cellIdentity associated with the stored version of that posSIB:","paragraph_zero_based":657},{"literal_text_all_w_t_and_m_t":"3>if the valueTag (see TS 37.355 [49]) for the posSIB received from the serving cell is identical to the valueTag associated with the stored version of that posSIB; or if the expirationTime (see TS 37.355 [49]) associated with the stored posSIB has not been expired:","paragraph_zero_based":658},{"literal_text_all_w_t_and_m_t":"4>consider the stored posSIB as valid for the cell;","paragraph_zero_based":659},{"literal_text_all_w_t_and_m_t":"5.2.2.2.2SI change indication and PWS notification","paragraph_zero_based":660},{"literal_text_all_w_t_and_m_t":"A modification period is used, i.e. updated SI message (other than SI message for ETWS, CMAS, positioning assistance data, and some NTN-specific information as specified in the field descriptions ) is broadcasted in the modification period following the one where SI change indication is transmitted. The modification period boundaries are defined by SFN values for which SFN mod m = 0, where m is the number of radio frames comprising the modification period. The modification period is configured by system information. If H-SFN is provided in SIB1, and UE is configured with eDRX, modification period boundaries are defined by SFN values for which (H-SFN * 1024 + SFN) mod m = 0.","paragraph_zero_based":661},{"literal_text_all_w_t_and_m_t":"For UEs in RRC_IDLE or RRC_INACTIVE configured to use an IDLE eDRX cycle longer than the modification period, an eDRX acquisition period is defined. The boundaries of the eDRX acquisition period are determined by H-SFN values for which H-SFN mod 1024 = 0.","paragraph_zero_based":662},{"literal_text_all_w_t_and_m_t":"The UE receives indications about SI modifications and/or PWS notifications using Short Message transmitted with P-RNTI over DCI (see clause 6.5). Repetitions of SI change indication may occur within preceding modification period or within preceding eDRX acquisition period. SI change indication is not applicable for SI messages containing posSIBs.","paragraph_zero_based":663},{"literal_text_all_w_t_and_m_t":"UEs in RRC_IDLE or in RRC_INACTIVE while SDT procedure is not ongoing shall monitor for SI change indication in its own paging occasion(s) that the UE monitors as specified in TS 38.304 [20]. UEs in RRC_CONNECTED shall monitor for SI change indication in any paging occasion at least once per modification period if the UE is provided with common search space, including pagingSearchSpace, searchSpaceSIB1 and searchSpaceOtherSystemInformation, on the active BWP to monitor paging, as specified in TS 38.213 [13], clause 13.","paragraph_zero_based":664},{"literal_text_all_w_t_and_m_t":"UEs in RRC_INACTIVE while SDT procedure is ongoing shall monitor for SI change indication in any paging occasion at least once per modification period, if the initial downlink BWP on which the SDT procedure is ongoing is associated with a CD-SSB.","paragraph_zero_based":665},{"literal_text_all_w_t_and_m_t":"During a modification period where ETWS or CMAS transmission is started or stopped, the SI messages carrying the posSIBs scheduled in posSchedulingInfoList may change, so the UE might not be able to successfully receive those posSIBs in the remainder of the current modification period and next modification period according to the scheduling information received prior to the change.","paragraph_zero_based":666},{"literal_text_all_w_t_and_m_t":"ETWS or CMAS capable UEs in RRC_IDLE or in RRC_INACTIVE while SDT procedure is not ongoing shall monitor for indications about PWS notification in its own paging occasion(s) that the UE monitors as specified in TS 38.304 [20]. ETWS or CMAS capable UEs in RRC_CONNECTED shall monitor for indication about PWS notification in any paging occasion at least once every defaultPagingCycle if the UE is provided with common search space, including pagingSearchSpace, searchSpaceSIB1 and searchSpaceOtherSystemInformation, on the active BWP to monitor paging.","paragraph_zero_based":667},{"literal_text_all_w_t_and_m_t":"ETWS or CMAS capable UEs in RRC_INACTIVE while SDT procedure is ongoing shall monitor for indication about PWS notification in any paging occasion at least once every defaultPagingCycle, if the initial downlink BWP on which the SDT procedure is ongoing is associated with a CD-SSB.","paragraph_zero_based":668},{"literal_text_all_w_t_and_m_t":"For Short Message reception in a paging occasion, the UE monitors the PDCCH monitoring occasion(s) for paging as specified in TS 38.304 [20] and TS 38.213 [13].","paragraph_zero_based":669},{"literal_text_all_w_t_and_m_t":"A L2 U2N Remote UE is not required to monitor paging occasion for SI modifications and/or PWS notifications. It obtains the updated system information and SIB6/7/8 from the connected L2 U2N Relay UE as defined in clause 5.8.9.9.3.","paragraph_zero_based":670},{"literal_text_all_w_t_and_m_t":"If the UE receives a Short Message, the UE shall:","paragraph_zero_based":671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"b3775a5d14ac021fc4f5f3e8002b92527fa1c052d9b7c535f196b5410b17f720","original_member_sha256":"0b2b1acef7c2981dcae001f9ad768411cade15b8ef16fbb988748fdb44fd8de1","paragraph_ElementTree_utf8_XML_sha256":["66a5a7de7e29a6253c9f26923265b3f81d591fc3709b1db784a6715cbdd235ea","a924135aa751f9b37835f0da59a16005e802c702369435d93e68263680a324fd","1c57f232379434af2b34c1fcf4081d98e55ce22647da13b286b282c852e24762","f8e67c14a1f9b67940d1d776285c4c503369c444cf0bdb9620579971b0b7a51b","1e44f8e78f636eee9dba3dd4d50a2f5bfc6c6e958764b662a9cf3e1c4d4c3bbd","e3eac643e336140b91af18dac68d53693846b983f2e42d230b98d3b4599d5861","c1dbc27ab58b8532f09676f058b34008cbf075c633a307eb130f0c0fb49d938c","950d597d54d8c158fc362c129d248e92e8eea9f7fdb01222b111970ec86f31ae","87475eea5b06e74b039b9b91e0b059bc473d1ad729b1f68862a8b3edd9a220ee","73b3b1182d339620beee924827ffc357b3f8aa803243baeb820fd2f1f58ce5a3","506c437e5c6d80e4422fa55f920e4ce2c0de3a2f3bcc5f5db66b3bdc828e80a5","f357f3b915878a72e09b497ea388972b3e0c19f0931eabf1c53e37d4121501ab","fa6789fa1b568593b6ced7cc8a57ef52cb22ea483ec2ec3abad8429e6855699f","a197b14c47ddb4e479df723faa721d0aeaa3014228c6008f30b971fa3efb10e4","a24553496badb12b8365c017802693820c1fe96b2873a11c36af5279e3949b39","1488dee2691c6b2fbf626935a98829b4c105e795e289a785603d931311c64bb6","9b0d63b78920bcd23a674a4f49550f3ede50682d793bb52532b5f30c485552d0","fb1187521d0981285f34e6e2fc13d819dd86d10463dd4abc19265af6d4bb0763","d99161fcdb3450bf54f47a6dd2195ed7fa7feac0beaaf44322759e2f093d078f","3b0a953657d6c9fdf65a954c160a27974cc2c338aee88e83c7021fffe78de423","65f1f741bde64491f750e088394a0187b26cb09b5270d71e7d4c3e53883721d6","55f9065b0c7ecca5290b090e8378d3c1cd000f79f0659d9c317dcd4aa7952f22","ea695686cc0251938242f5ff10b1744376f506e5908203556521db8c9470744c","72d202fbac2ca2180da3c4c87c7cdf0dad394c625fc72ad538c235b8732be925"],"paragraph_range_zero_based":[648,671],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2401569.zip::R2-2401569 RRC corrections for XR.docx:p648"}
{"fields":{"filename":"R2-2401569.zip::R2-2401569 RRC corrections for XR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>if the UE is ETWS capable or CMAS capable, the etwsAndCmasIndication bit of Short Message is set, and the UE is provided with searchSpaceSIB1 and searchSpaceOtherSystemInformation on the active BWP or the initial BWP:","paragraph_zero_based":672},{"literal_text_all_w_t_and_m_t":"2> immediately re-acquire the SIB1;","paragraph_zero_based":673},{"literal_text_all_w_t_and_m_t":"2>if the UE is ETWS capable and si-SchedulingInfo includes scheduling information for SIB6:","paragraph_zero_based":674},{"literal_text_all_w_t_and_m_t":"3>acquire SIB6, as specified in clause 5.2.2.3.2, immediately;","paragraph_zero_based":675},{"literal_text_all_w_t_and_m_t":"2>if the UE is ETWS capable and si-SchedulingInfo includes scheduling information for SIB7:","paragraph_zero_based":676},{"literal_text_all_w_t_and_m_t":"3>acquire SIB7, as specified in clause 5.2.2.3.2, immediately;","paragraph_zero_based":677},{"literal_text_all_w_t_and_m_t":"2>if the UE is CMAS capable and si-SchedulingInfo includes scheduling information for SIB8:","paragraph_zero_based":678},{"literal_text_all_w_t_and_m_t":"3>acquire SIB8, as specified in clause 5.2.2.3.2, immediately;","paragraph_zero_based":679},{"literal_text_all_w_t_and_m_t":"NOTE:In case SIB6, SIB7, or SIB8 overlap with a measurement gap it is left to UE implementation how to immediately acquire SIB6, SIB7, or SIB8.","paragraph_zero_based":680},{"literal_text_all_w_t_and_m_t":"1>if the UE does not operate an IDLE eDRX cycle longer than the modification period and the systemInfoModification bit of Short Message is set:","paragraph_zero_based":681},{"literal_text_all_w_t_and_m_t":"2>apply the SI acquisition procedure as defined in clause 5.2.2.3 from the start of the next modification period;","paragraph_zero_based":682},{"literal_text_all_w_t_and_m_t":"1>if the UE operates an IDLE eDRX cycle longer than the modification period and the systemInfoModification-eDRX bit of Short Message is set:","paragraph_zero_based":683},{"literal_text_all_w_t_and_m_t":"2>apply the SI acquisition procedure as defined in clause 5.2.2.3 from the start of the next eDRX acquisition period boundary.","paragraph_zero_based":684},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":685},{"literal_text_all_w_t_and_m_t":"5.2.2.3Acquisition of System Information","paragraph_zero_based":686},{"literal_text_all_w_t_and_m_t":"5.2.2.3.1Acquisition of MIB and SIB1","paragraph_zero_based":687},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":688},{"literal_text_all_w_t_and_m_t":"1>apply the specified BCCH configuration defined in 9.1.1.1;","paragraph_zero_based":689},{"literal_text_all_w_t_and_m_t":"1>if the UE is in RRC_IDLE or in RRC_INACTIVE; or","paragraph_zero_based":690},{"literal_text_all_w_t_and_m_t":"1>if the UE is in RRC_CONNECTED while T311 is running:","paragraph_zero_based":691},{"literal_text_all_w_t_and_m_t":"2>acquire the MIB, which is scheduled as specified in TS 38.213 [13];","paragraph_zero_based":692},{"literal_text_all_w_t_and_m_t":"2>if the UE is unable to acquire the MIB;","paragraph_zero_based":693},{"literal_text_all_w_t_and_m_t":"3>perform the actions as specified in clause 5.2.2.5;","paragraph_zero_based":694},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":695}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"b3775a5d14ac021fc4f5f3e8002b92527fa1c052d9b7c535f196b5410b17f720","original_member_sha256":"0b2b1acef7c2981dcae001f9ad768411cade15b8ef16fbb988748fdb44fd8de1","paragraph_ElementTree_utf8_XML_sha256":["32fd8a906279743d8f8707fa8c7aefcd1eca7735d06ce5465d1dcf482e12d05a","b1219d1f8559b058fd33468734f796582b2774f7de1a0ff031788fe57b125b05","999d317a26fb9626d113bcca880f0d5dde2fd472a707f3c8f22c5cf554f5dcb3","dd05667cb6fbc65069deeea6b810b2e9e72c42b0d3935045661863ea15813803","5716440721f85cec810f86a97e2d0f70bc820ab60c593fc7be3668718dc418fe","f6477a9c651364ef3923780fe714cd72423d41690d436da3bd1f6b5069c7497d","300a071b63fb27a4232116c0ffe604a57c42ddbbb12caaa72fb91b805cfbf124","3bf102e5560fad636c97d18847d7583af572299e66261e340e069eff18d3c620","e550478961b15823fb4ab461bd738aaa0cfb27d5b04810e4c67895e18b2d77c9","351866922b9b903f6deb377c079a8f25a38f2cdb504e8b65d75d00cec3d61761","8196a089dcd9db881c1eff174e68b1113f9203163ddc778757a2fbd1c45cdb71","86aad95819ab8bccc18caaafa6b35864fa10cdc1949b674fc2577c880df49457","0c3bbf5f4f3cc0f13f94c3139e68addc21619995f2a04594a7bd407efc44ca80","7a2e97f026e6b3f9f7e666fd3dba384ece0b5f1b687055843c0c79b829d1c175","bd4f2217313c8bdfc4cfc94519b0e6371f8478ffb700912ddb8434edd945e90e","84b2836bae9985ddcf24536dcaa0ac6edced5df4a216c5ff5c07b3b1e73420cc","54d4630780092dd3f6b315d5dd955455361d35efd8ee7524e9e669be5b6360fb","221e7fc63ae9f0c248504a45f7001c5e4e665f06cfb558dcd1abdcfbd940857e","a0db29ed5ec4fa93bebd43f68be564ee1c74766c51bf8489e20051db70b88c6a","cfab40538fc1a41257f2f22f593aa3d7536d66e3aefe1f5d99d5ffdeeafacf9f","e0fce953c382e9954960a61d1076e9503dad10e61350f45cdd785758aad2a98b","5b9787171059a56c65c3b0f45f2b0327f5059762ddd6845b941f756a89c6ce2f","21e7549e6a4b2a74330496da19a89cdcc04035b8aedf35a566aefd79e5781548","c783186e288e80b8ff2e043ee411427cdbbd1e2340e07894606ad961a7f3b870"],"paragraph_range_zero_based":[672,695],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2401569.zip::R2-2401569 RRC corrections for XR.docx:p672"}
{"fields":{"filename":"R2-2401569.zip::R2-2401569 RRC corrections for XR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>perform the actions specified in clause 5.2.2.4.1.","paragraph_zero_based":696},{"literal_text_all_w_t_and_m_t":"1>if the UE is in RRC_CONNECTED with an active BWP with common search space configured by searchSpaceSIB1 and pagingSearchSpace and has received an indication about change of system information; or","paragraph_zero_based":697},{"literal_text_all_w_t_and_m_t":"1>if the UE is in RRC_CONNECTED with an active BWP with common search space configured by searchSpaceSIB1 and the UE has not stored a valid version of a SIB or posSIB, in accordance with clause 5.2.2.2.1, of one or several required SIB(s) or posSIB(s) in accordance with clause 5.2.2.1, and, UE has not acquired SIB1 in current modification period; or","paragraph_zero_based":698},{"literal_text_all_w_t_and_m_t":"1> if the UE is in RRC_CONNECTED with an active BWP with common search space configured by searchSpaceSIB1, and, the UE has not stored a valid version of a SIB or posSIB, in accordance with clause 5.2.2.2.1, of one or several required SIB(s) or posSIB(s) in accordance with clause 5.2.2.1, and, si-BroadcastStatus for the required SIB(s) or posSI-BroadcastStatus for the required posSIB(s) is set to notBroadcasting in acquired SIB1 in current modification period; or","paragraph_zero_based":699},{"literal_text_all_w_t_and_m_t":"1>if the UE is in RRC_IDLE or in RRC_INACTIVE; or","paragraph_zero_based":700},{"literal_text_all_w_t_and_m_t":"1>if the UE is in RRC_CONNECTED while T311 is running:","paragraph_zero_based":701},{"literal_text_all_w_t_and_m_t":"2>if ssb-SubcarrierOffset indicates SIB1 is transmitted in the cell (TS 38.213 [13]) and if SIB1 acquisition is required for the UE:","paragraph_zero_based":702},{"literal_text_all_w_t_and_m_t":"3>acquire the SIB1, which is scheduled as specified in TS 38.213 [13];","paragraph_zero_based":703},{"literal_text_all_w_t_and_m_t":"3>if the UE is unable to acquire the SIB1:","paragraph_zero_based":704},{"literal_text_all_w_t_and_m_t":"4>perform the actions as specified in clause 5.2.2.5;","paragraph_zero_based":705},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":706},{"literal_text_all_w_t_and_m_t":"4>upon acquiring SIB1, perform the actions specified in clause 5.2.2.4.2.","paragraph_zero_based":707},{"literal_text_all_w_t_and_m_t":"2>else if SIB1 acquisition is required for the UE and ssb-SubcarrierOffset indicates that SIB1 is not scheduled in the cell:","paragraph_zero_based":708},{"literal_text_all_w_t_and_m_t":"3>perform the actions as specified in clause 5.2.2.5.","paragraph_zero_based":709},{"literal_text_all_w_t_and_m_t":"NOTE 1:The UE in RRC_CONNECTED is only required to acquire broadcasted SIB1 and MBS broadcast if the UE can acquire it without disrupting unicast or MBS multicast data reception, i.e., the broadcast and unicast/MBS multicast beams are quasi co-located. The UE in RRC_INACTIVE state while SDT procedure is ongoing, is only required to acquire broadcasted SIB1 and MIB if the UE can acquire them without disrupting unicast data reception, i.e. the broadcast and unicast beams are quasi co-located.","paragraph_zero_based":710},{"literal_text_all_w_t_and_m_t":"NOTE 2:UE in RRC_INACTIVE that does not support inactiveStateNTN-r17 enters RRC_IDLE upon cell reselection between TN cell and NTN cell, and initiates the NAS signalling connection recovery (see TS 24.501 [23]).","paragraph_zero_based":711},{"literal_text_all_w_t_and_m_t":"5.2.2.3.2Acquisition of an SI message","paragraph_zero_based":712},{"literal_text_all_w_t_and_m_t":"For SI message acquisition PDCCH monitoring occasion(s) are determined according to searchSpaceOtherSystemInformation. If searchSpaceOtherSystemInformation is set to zero, PDCCH monitoring occasions for SI message reception in SI-window are same as PDCCH monitoring occasions for SIB1 where the mapping between PDCCH monitoring occasions and SSBs is specified in TS 38.213[13]. If searchSpaceOtherSystemInformation is not set to zero, PDCCH monitoring occasions for SI message are determined based on search space indicated by searchSpaceOtherSystemInformation. PDCCH monitoring occasions for SI message which are not overlapping with UL symbols (determined according to tdd-UL-DL-ConfigurationCommon) are sequentially numbered from one in the SI window. The [x×N+K]th PDCCH monitoring occasion (s) for SI message in SI-window corresponds to the Kth transmitted SSB, where x = 0, 1, ...X-1, K = 1, 2, …N, N is the number of actual transmitted SSBs determined according to ssb-PositionsInBurst in SIB1 and X is equal to CEIL(number of PDCCH monitoring occasions in SI-window/N). The actual transmitted SSBs are sequentially numbered from one in ascending order of their SSB indexes. The UE assumes that, in the SI window, PDCCH for an SI message is transmitted in at least one PDCCH monitoring occasion corresponding to each transmitted SSB and thus the selection of SSB for the reception SI messages is up to UE implementation.","paragraph_zero_based":713},{"literal_text_all_w_t_and_m_t":"When acquiring an SI message, the UE shall:","paragraph_zero_based":714},{"literal_text_all_w_t_and_m_t":"1>determine the start of the SI-window for the concerned SI message as follows:","paragraph_zero_based":715},{"literal_text_all_w_t_and_m_t":"2>if the concerned SI message is configured in the schedulingInfoList:","paragraph_zero_based":716},{"literal_text_all_w_t_and_m_t":"3>for the concerned SI message, determine the number n which corresponds to the order of entry in the list of SI messages configured by schedulingInfoList in si-SchedulingInfo in SIB1;","paragraph_zero_based":717},{"literal_text_all_w_t_and_m_t":"3>determine the integer value x = (n – 1) × w, where w is the si-WindowLength;","paragraph_zero_based":718},{"literal_text_all_w_t_and_m_t":"3>the SI-window starts at the slot #a, where a = x mod N, in the radio frame for which SFN mod T = FLOOR(x/N), where T is the si-Periodicity of the concerned SI message and N is the number of slots in a radio frame as specified in TS 38.213 [13];","paragraph_zero_based":719}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"b3775a5d14ac021fc4f5f3e8002b92527fa1c052d9b7c535f196b5410b17f720","original_member_sha256":"0b2b1acef7c2981dcae001f9ad768411cade15b8ef16fbb988748fdb44fd8de1","paragraph_ElementTree_utf8_XML_sha256":["2117211a700e1c5eb9abf38a100442052080b30b7ba08b1d6e565397f31bdbdd","51a93e6664761f53184883363df8829d85ff5266eb8379b3b2a71dbd8b375ae1","3ce42f261778124d75dc9bc188e822e4cda17b76b91b509a9afee81788070d30","1e6668cd7dc4c4e533d48bf50f114ba08896bc8db6ad8e432c5f2bcf1c7bd693","ee92945017d9f830bab38ab035f61f3adc2dab1535abeb9743104ce32842a35f","83e0516e60e5e56488f2dda2b45d813aa9a58cdec702474a1d4ee139b5869d5b","5a2dd2ec2f7831508f69c88fdc79d8c2222886eb0870d6a4f6f2a167aed5a040","1cf1e45885f90ac1e1d69540d8ee2988f8f98fb815e85672bc2b17073b62126c","e63fb35f96c37d6df892e89a31ce7da9f228e4261771d309337b377fd817f7b2","9d4748bb11d03124671a6248236e30334e2962a2e6f02392aa0d2d8bac3b47ec","87f350b7ff1660000e0e1bb5123727078744e3b61f884b352032a18cb6ea4ed4","fa52c0d723313929595caa1361c7e4fa7f544b11c62132ad14ddb7b2a430d811","4236e0380062cea763a23f270dd3d2f3605c3756a8aa359b48f33e33f62e4d01","fb592810a843ecac2d9255ddac7493185acb05854fefacd543c4a16d704a3203","b35761a253b3d78be980fcff566de6c56157c2b4720d3aef3baf8295db04fbbb","12d3244cc354b856feab37ca0978bf73f8ef6201c41e486c8b3d30b1a4b39a24","19223a2cc15f083d00dfc39dea75d01986f63461afda9ec791047d48da5b8f29","f6105991bd6b7ac4c11bc8042f8635a2e9c718b5b5fbc1fa650f4dba6dc195f0","52b51c5b5940aab04d315420cfe2208e27213f669d87c2985a9fadda29ced2e7","9fc1495a7bdfe509003dcdad041dac8a2e2be6679dade97073f71ebd009b4c0b","809b5c9cc2936287138b0c5c29e63fce855394cc1280156217edfd3353ca637a","c8fd76c253e75fc3750e6ba67c21bb0479c880cbb8c4451be4d4fca9b3611c0e","d7a475cdc0e78fdb45d717d58b540dd9344cbd5a2fe57e16db83218ecdb01217","4fe3a3d5c79b0b693d5f78e8c71c5c1d49b4728a261cfdd07dc70a010a6ada05"],"paragraph_range_zero_based":[696,719],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2401569.zip::R2-2401569 RRC corrections for XR.docx:p696"}
{"fields":{"filename":"R2-2401569.zip::R2-2401569 RRC corrections for XR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>else if the concerned SI message is configured in the schedulingInfoList2;","paragraph_zero_based":720},{"literal_text_all_w_t_and_m_t":"3>determine the integer value x = (si-WindowPosition -1) × w, where w is the si-WindowLength;","paragraph_zero_based":721},{"literal_text_all_w_t_and_m_t":"3>the SI-window starts at the slot #a, where a = x mod N, in the radio frame for which SFN mod T = FLOOR(x/N), where T is the si-Periodicity of the concerned SI message and N is the number of slots in a radio frame as specified in TS 38.213 [13];","paragraph_zero_based":722},{"literal_text_all_w_t_and_m_t":"2>else if the concerned SI message is configured in the posSchedulingInfoList and offsetToSI-Used is not configured:","paragraph_zero_based":723},{"literal_text_all_w_t_and_m_t":"3>create a concatenated list of SI messages by appending the posSchedulingInfoList in posSI-SchedulingInfo in SIB1 to schedulingInfoList in si-SchedulingInfo in SIB1;","paragraph_zero_based":724},{"literal_text_all_w_t_and_m_t":"3>for the concerned SI message, determine the number n which corresponds to the order of entry in the concatenated list;","paragraph_zero_based":725},{"literal_text_all_w_t_and_m_t":"3>determine the integer value x = (n – 1) × w, where w is the si-WindowLength;","paragraph_zero_based":726},{"literal_text_all_w_t_and_m_t":"3>the SI-window starts at the slot #a, where a = x mod N, in the radio frame for which SFN mod T = FLOOR(x/N), where T is the posSI-Periodicity of the concerned SI message and N is the number of slots in a radio frame as specified in TS 38.213 [13];","paragraph_zero_based":727},{"literal_text_all_w_t_and_m_t":"2>else if the concerned SI message is configured by the posSchedulingInfoList and offsetToSI-Used is configured:","paragraph_zero_based":728},{"literal_text_all_w_t_and_m_t":"3>determine the number m which corresponds to the number of SI messages with an associated si-Periodicity of 8 radio frames (80 ms), configured by schedulingInfoList in SIB1;","paragraph_zero_based":729},{"literal_text_all_w_t_and_m_t":"3>for the concerned SI message, determine the number n which corresponds to the order of entry in the list of SI messages configured by posSchedulingInfoList in SIB1;","paragraph_zero_based":730},{"literal_text_all_w_t_and_m_t":"3>determine the integer value x = m × w + (n – 1) × w, where w is the si-WindowLength;","paragraph_zero_based":731},{"literal_text_all_w_t_and_m_t":"3>the SI-window starts at the slot #a, where a = x mod N, in the radio frame for which SFN mod T = FLOOR(x/N) +8, where T is the posSI-Periodicity of the concerned SI message and N is the number of slots in a radio frame as specified in TS 38.213 [13];","paragraph_zero_based":732},{"literal_text_all_w_t_and_m_t":"1>receive the PDCCH containing the scheduling RNTI, i.e. SI-RNTI in the PDCCH monitoring occasion(s) for SI message acquisition, from the start of the SI-window and continue until the end of the SI-window whose absolute length in time is given by si-WindowLength, or until the SI message was received;","paragraph_zero_based":733},{"literal_text_all_w_t_and_m_t":"1>if the SI message was not received by the end of the SI-window, repeat reception at the next SI-window occasion for the concerned SI message in the current modification period;","paragraph_zero_based":734},{"literal_text_all_w_t_and_m_t":"1>if all the SIB(s) and/or posSIB(s) requested in DedicatedSIBRequest message have been acquired:","paragraph_zero_based":735},{"literal_text_all_w_t_and_m_t":"2>stop timer T350, if running;","paragraph_zero_based":736},{"literal_text_all_w_t_and_m_t":"NOTE 1:The UE is only required to acquire broadcasted SI message if the UE can acquire it without disrupting unicast or MBS multicast data reception, i.e. the broadcast and unicast/MBS multicast beams are quasi co-located.","paragraph_zero_based":737},{"literal_text_all_w_t_and_m_t":"NOTE 2:The UE is not required to monitor PDCCH monitoring occasion(s) corresponding to each transmitted SSB in SI-window.","paragraph_zero_based":738},{"literal_text_all_w_t_and_m_t":"NOTE 3:If the concerned SI message was not received in the current modification period, handling of SI message acquisition is left to UE implementation.","paragraph_zero_based":739},{"literal_text_all_w_t_and_m_t":"NOTE 4:A UE in RRC_CONNECTED may stop the PDCCH monitoring during the SI window for the concerned SI message when the requested SIB(s) are acquired.","paragraph_zero_based":740},{"literal_text_all_w_t_and_m_t":"NOTE 5:A UE capable of NR sidelink communication/discovery and configured by upper layers to perform NR sidelink communication/discovery on a frequency, may acquire SIB12 or SystemInformationBlockType28 from a cell other than current serving cell (for RRC_INACTIVE or RRC_IDLE) or current PCell (for RRC_CONNECTED), if SIB12 of current serving cell (for RRC_INACTIVE or RRC_IDLE) or current PCell (for RRC_CONNECTED) does not provide configuration for NR sidelink communication/discovery for the frequency, and if the other cell providing configuration for NR sidelink communication/discovery for the frequency meets the S-criteria as defined in TS 38.304 [20] or TS 36.304 [27].","paragraph_zero_based":741},{"literal_text_all_w_t_and_m_t":"1>perform the actions for the acquired SI message as specified in clause 5.2.2.4.","paragraph_zero_based":742},{"literal_text_all_w_t_and_m_t":"5.2.2.3.3Request for on demand system information","paragraph_zero_based":743}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"b3775a5d14ac021fc4f5f3e8002b92527fa1c052d9b7c535f196b5410b17f720","original_member_sha256":"0b2b1acef7c2981dcae001f9ad768411cade15b8ef16fbb988748fdb44fd8de1","paragraph_ElementTree_utf8_XML_sha256":["132580e0e0577c91392f2a607559399f97ce5dd741c39a65ccb21be2b1c204a2","528b2c80e5282d17b13f2dbbae53d86a23fc5575dfbc0f866ce0ef7eed8fc0ed","4aaaad06c12c2a22fd1e4f8899e03b0f1d98ae6ef19c016a501c209dd7a3d0f3","aad98d4ca9ced6f1bec688dbb1fa9dbd4bb816ab733af817742e211d7099ea37","1f9963e7091a1f14e6adef07b9c74db9e62bc414fb9e0520a9b9bf38fe94c5b4","3484d9760c6a300c9775d3da230a2e067e6eb379c741ce2899901a21155c8c44","5bfc5a22675105c41d993990a1310cd473b4f8b3a7f2030f7e866fa9f29bcf6b","7c1b81b91fba3cb11a320a332c11d4c326c7cf126bda166d2688f4e4ace6401a","2f389db7183c7bef78b76aa34257ede5d1246cc9f47d75d0f9c5c24f4a2b523e","721b79c846363be58adfd91a8c476153c9307d7276f4a19236bcafaa3dc4752f","658bdbcd8082502d91110ff8238fd034b394f73ce0e1e3410bef1ee04e5d9954","462ed8e56ac9279ef232aff9d3c93ca03c2ba964d28d1076e05c08adb427c501","4ece6ea7604a500c8d3691366e396d935ba008abdeedf123eb74ef054e64a4f8","89c1ea62a3814e8a4d8b6749c83a5a25d78fb17d13c7882b6328a7d68fe4b477","2d19109943a2bff394fc1bbec9d40f9b61f8355a25e7a793203c8d312de8ff98","ef80f4c3163869be8f8c86bcd7865f153042b7d47cb5b9259ba47a205a570e73","f550b3315481f409f0353988adb5dd30ea59849198e4396bdc77fbf8305df3d0","93b9dc938061b3dbf7fe84158229a6d8be5ef2b3eeaf5596709b31e4dce63315","dd8036a30d49d71fc5331681e77bf8869b95e293a621967e5e8cd4a66dcb273f","7fefd3f279c4ac823fd10ec691e9c6a9fc2afb0c6b2ac5082c1d5e85386d99b7","a38cc00f7aa11b14fa33ecd041dc63966673ec3a39156541af6d47a6458411a0","cf09c08307222ec4b494f0654a40742bb19ba9cba169c45d3db21c074e52bb17","25b8f1498bc8c65a185bfd2c92c40c67fea110aed1ad67f4ac6af8b782047ed6","72e58aa3527e7ae7eb61b981e8ad77ee39f2c9c46b39c422ec979704298b2045"],"paragraph_range_zero_based":[720,743],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2401569.zip::R2-2401569 RRC corrections for XR.docx:p720"}
{"fields":{"filename":"R2-2401569.zip::R2-2401569 RRC corrections for XR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The UE shall, while SDT procedure is not ongoing:","paragraph_zero_based":744},{"literal_text_all_w_t_and_m_t":"1>if SIB1 includes si-SchedulingInfo containing si-RequestConfigSUL-MSG1-Repetition and criteria to select supplementary uplink as defined in TS 38.321[3], clause 5.1.1 is met and if criteria to apply MSG1 repetition as defined in TS 38.321[3], clause 5.1.1e for the concerned si-RequestConfigSUL-MSG1-Repetition is met:","paragraph_zero_based":745},{"literal_text_all_w_t_and_m_t":"2>trigger the lower layer to initiate the Random Access procedure on supplementary uplink in accordance with TS 38.321 [3] using the PRACH preamble(s) and PRACH resource(s) associated with the applicable MSG1 repetition number in si-RequestConfigSUL-MSG1-Repetition corresponding to the SI message(s) that the UE requires to operate within the cell, and for which si-BroadcastStatus is set to notBroadcasting;","paragraph_zero_based":746},{"literal_text_all_w_t_and_m_t":"2>if acknowledgement for SI request is received from lower layers:","paragraph_zero_based":747},{"literal_text_all_w_t_and_m_t":"3>acquire the requested SI message(s) as defined in clause 5.2.2.3.2, immediately;","paragraph_zero_based":748},{"literal_text_all_w_t_and_m_t":"1>else if the UE is a RedCap UE and if initialUplinkBWP-RedCap is configured in UplinkConfigCommonSIB and if SIB1 includes si-SchedulingInfo containing si-RequestConfigRedCap-MSG1-Repetition and criteria to select normal uplink as defined in TS 38.321[3], clause 5.1.1 is met and if criteria to apply MSG1 repetition as defined in TS 38.321[3], clause 5.1.1e for the concerned si-RequestConfigRedCap-MSG1-Repetition is met:","paragraph_zero_based":749},{"literal_text_all_w_t_and_m_t":"2>trigger the lower layer to initiate the Random Access procedure on normal uplink in accordance with TS 38.321 [3] using the PRACH preamble(s) and PRACH resource(s) associated with the applicable MSG1 repetition number in si-RequestConfigRedCap-MSG1-Repetition corresponding to the SI message(s) that the UE requires to operate within the cell, and for which si-BroadcastStatus is set to notBroadcasting;","paragraph_zero_based":750},{"literal_text_all_w_t_and_m_t":"2>if acknowledgement for SI request is received from lower layers:","paragraph_zero_based":751},{"literal_text_all_w_t_and_m_t":"3>acquire the requested SI message(s) as defined in clause 5.2.2.3.2, immediately;","paragraph_zero_based":752},{"literal_text_all_w_t_and_m_t":"1>else if SIB1 includes si-SchedulingInfo containing si-RequestConfigSUL and criteria to select supplementary uplink as defined in TS 38.321[3], clause 5.1.1 is met:","paragraph_zero_based":753},{"literal_text_all_w_t_and_m_t":"2>trigger the lower layer to initiate the Random Access procedure on supplementary uplink in accordance with TS 38.321 [3] using the PRACH preamble(s) and PRACH resource(s) in si-RequestConfigSUL corresponding to the SI message(s) that the UE requires to operate within the cell, and for which si-BroadcastStatus is set to notBroadcasting;","paragraph_zero_based":754},{"literal_text_all_w_t_and_m_t":"2>if acknowledgement for SI request is received from lower layers:","paragraph_zero_based":755},{"literal_text_all_w_t_and_m_t":"3>acquire the requested SI message(s) as defined in clause 5.2.2.3.2, immediately;","paragraph_zero_based":756},{"literal_text_all_w_t_and_m_t":"1>else if the UE is an (e)RedCap UE and if initialUplinkBWP-RedCap is configured in UplinkConfigCommonSIB and if SIB1 includes si-SchedulingInfo containing si-RequestConfigRedCap and criteria to select normal uplink as defined in TS 38.321[3], clause 5.1.1 is met:","paragraph_zero_based":757},{"literal_text_all_w_t_and_m_t":"2>trigger the lower layer to initiate the Random Access procedure on normal uplink in accordance with TS 38.321 [3] using the PRACH preamble(s) and PRACH resource(s) in si-RequestConfigRedcap corresponding to the SI message(s) that the UE requires to operate within the cell, and for which si-BroadcastStatus is set to notBroadcasting;","paragraph_zero_based":758},{"literal_text_all_w_t_and_m_t":"2>if acknowledgement for SI request is received from lower layers:","paragraph_zero_based":759},{"literal_text_all_w_t_and_m_t":"3>acquire the requested SI message(s) as defined in clause 5.2.2.3.2, immediately;","paragraph_zero_based":760},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":761},{"literal_text_all_w_t_and_m_t":"2>if the UE is not a RedCap UE and if SIB1 includes si-SchedulingInfo containing si-RequestConfigMSG1-Repetition and criteria to select normal uplink and to apply MSG1 repetition as defined in TS 38.321[3], clause 5.1.1e for the concerned si-RequestConfigMSG1-Repetition are met; or","paragraph_zero_based":762},{"literal_text_all_w_t_and_m_t":"2>if the UE is a RedCap UE and if initialUplinkBWP-RedCap is not configured in UplinkConfigCommonSIB and if SIB1 includes si-SchedulingInfo containing si-RequestConfigMSG1-Repetition and criteria to select normal uplink and to apply MSG1 repetition as defined in TS 38.321[3], clause 5.1.1e for the concerned si-RequestConfigMSG1-Repetition are met:","paragraph_zero_based":763},{"literal_text_all_w_t_and_m_t":"3>trigger the lower layer to initiate the Random Access procedure on normal uplink in accordance with TS 38.321 [3] using the PRACH preamble(s) and PRACH resource(s) associated with the applicable MSG1 repetition number in corresponding to the SI message(s) that the UE requires to operate within the cell, and for which si-BroadcastStatus is set to notBroadcasting;","paragraph_zero_based":764},{"literal_text_all_w_t_and_m_t":"3>if acknowledgement for SI request is received from lower layers:","paragraph_zero_based":765},{"literal_text_all_w_t_and_m_t":"4>acquire the requested SI message(s) as defined in clause 5.2.2.3.2, immediately;","paragraph_zero_based":766},{"literal_text_all_w_t_and_m_t":"2>else if the UE is neither a RedCap nor an eRedCap UE and if SIB1 includes si-SchedulingInfo containing si-RequestConfig and criteria to select normal uplink as defined in TS 38.321[3], clause 5.1.1 is met; or","paragraph_zero_based":767}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"b3775a5d14ac021fc4f5f3e8002b92527fa1c052d9b7c535f196b5410b17f720","original_member_sha256":"0b2b1acef7c2981dcae001f9ad768411cade15b8ef16fbb988748fdb44fd8de1","paragraph_ElementTree_utf8_XML_sha256":["2cbc05e7b60f2a2e2a4515b12d2d5617fabf96f0711041648f0f94abc47c9cd0","f5281cf7ba768f7341c96b194b8f8b3d37ec1c6f472afb1b032d9a7b1ee751cb","65c113c465da30ccf5f32f81adcf7412ca1c995083deabeb2af53616c61aed37","7af75c80239a87073cdd851075f27b6552ee7104af226d3d374614a963f75f01","ab341490e745bac81435356f4442ad5c29200cce2ecab60eec5fcc3e46a22b73","b6198a3209a6dfd4c8fec155cfded23280af52682f6b80bfe0d8b81677c3fd55","ce2bfc73a1a5c6165d26df8e05e5a555a46f3d7191c66e9fb478652e0264e958","616a8dbdd37b8557d88398909fc290502fce79f18e2e81104d43e0a00e7be33b","7bb8cfbbf68bab0fb6516a68d11ff59a3a05c1918ff2d6596965cd98e65beaa6","380e0d370baab98e78145a2bf570590d18d361d3387d427a525d5b8774f67ff6","67e35a0aea286fb6a15ea02333a431dc83a405eb6e0006deefa2fb3b98b70706","9111dff2b7596d66d10f79ef02bfa9e35d60a17a80448975a15bfd93eb70f6ad","0d891ef9b29744e78fd644dc19c43a899a25b5de084c3c4c6e80e8ae2049bb5a","b909db217fe7f613388a749b3838f41d50bd31eda29f88a8595fd1cd6a3bbbcc","547fa9027ddbdc178a5bc4db1e7e93b9635c3cfdd54590a666c2663a375219d7","069a345850274e4ad1c4fc1edd3b319324c097a0a09d4041de0b939f151af7bd","bc18e7f224955a9b80f49f194b67cf7f7f8d4a0ca513fa52011c7a85c9935a4f","6a220991b800b7cccd4ed9c14daed65d06bba312d5650200dfe63fd798e25960","d1d535c4754c3da1d6634d23b8340df1acf238fad84fa44f8ab075947dc72882","12262002fd93c3452d3e2cd03917