ooth positioning;","paragraph_zero_based":118},{"literal_text_all_w_t_and_m_t":"-terrestrial beacon system (TBS) positioning;","paragraph_zero_based":119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"5b02fa5d38f26c57ef4ae3249c9ddc3542b9c288e8b322c96b1e55a5ae8bf1e8","original_member_sha256":"c9d97b7a48bdd260906825d063a9aeaa517c5eaf9d984f932ecbcf5b265095df","paragraph_ElementTree_utf8_XML_sha256":["f93659204248bf7212a2a073874fa6ef6bab855e1f334d94d95f69bdfcb0d978","4f44852a857926d57cd6aaa974f4c47190612a57f3a68533b13a59b19d80aafc","84cfffd8b170c458e9fd1f937758338e77952052a138c7c60120dc1e8ee9c412","f7b3a7bb9ad97a828da3323273c2deac8004729d61d7f2c7a25185dd92d4eb66","623edfeb67c2d41b2b9e147012100dce2f709456a108863b11db12637e74c692","972c89243ea25b912af8179a8be8c77ab6d50347dd064fa94fff2d9d947bbd4b","022031e640f79d734e0c0078695b4546709c7cc0e2d4b09f740c852d83464850","90739a9b5718a75a6036a95b91a37f44f1e9aef38922942dfe97f431acb1a425","6c4b79aee2df9417fdcf7ff053d8ed2a9ea25e31efedf31e6292500ff9c4b627","8a2054446422db10127b53522c244dd671006eed469081cd46119e9103434846","09696b54939497a8ca2ba620420c03c7479c8446d64fb680ae1962b6d211066f","c002616492b1923e46d6fa95a25dac7944411eca88ccdcee2199f265ed726678","d02e8cbd697ae1810074c3012247d88e70339f7889a7482c352e21eca4a8f878","5e6e78c509901ae3936d881dd0c9b12c94a02c1a5b9226ba72b61bcdd6bc46b1","22abc003d0ea32b0f74e32548effa3a60dd95df229e1bc04cfcd7917b4ced92e","2e2746474a0e497e2ae7a72d0f4d733fbb2f86d83a952c22fbcd0dbf0b48cab9","83d2597410ea10dc30be93028a7daf96c4c61e02de1bd77ba81887d64aa4ff12","57d61fc557bf9562a7a74b2db0cc8b5d13027fd14e184a306b257890e9e47314","c46ac165b55633a6e7eb47654646f452aa167942f6ae9df0da343504a42afb38","28a72f8e68a87688c7ab09ff568935f9e91ecc346a2530cbec201cb7be9ec6b6","be7ca4a4f80adcfa36d464e79de52a9e308b26ce6a361e73d6f6fc42af19f351","737c3ca28c0bc2e8f68cee3a8c905796c0a64f04fe8832a20a8a1d1fd812f188","6e447e7062b9fd2de