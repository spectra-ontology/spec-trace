67},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":13768},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13769},{"literal_text_all_w_t_and_m_t":"TRS-ResourceSet-r17 ::=                SEQUENCE {","paragraph_zero_based":13770},{"literal_text_all_w_t_and_m_t":"    powerControlOffsetSS-r17               ENUMERATED {db-3, db0, db3, db6},","paragraph_zero_based":13771},{"literal_text_all_w_t_and_m_t":"    scramblingID-Info-r17                  CHOICE {","paragraph_zero_based":13772},{"literal_text_all_w_t_and_m_t":"        scramblingIDforCommon-r17              ScramblingId,","paragraph_zero_based":13773},{"literal_text_all_w_t_and_m_t":"        scramblingIDperResourceListWith2-r17   SEQUENCE (SIZE (2)) OF ScramblingId,","paragraph_zero_based":13774},{"literal_text_all_w_t_and_m_t":"        scramblingIDperResourceListWith4-r17   SEQUENCE (SIZE (4)) OF ScramblingId,","paragraph_zero_based":13775}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["b60e1adcd938c4e9fffb2e8c6da79078d6874978bd17bf4e4da6f4bd9be8f2fb","9c6fcf33be5eb8a120b0a956c523609a1b12f0edbb8c05166bc8922f14faaa5d","124f009892fede414854141db43f3a9be0afb8e0758c963cd86b5fb4b2202d8d","57395e066c1a1d4dc4d2c5590745329562fe836159c1ee060e66c94e19329e4b","332f3a558a3e731bb8612494b1deac02de841c072d37f02c730e46c28e7bce4f","cd5bde761f15f9f0f26753ce4cd6896d96fb452bc75c0247aa0d36885242ecf4","5d7a7b274d75c7c03445e4bea1b69d2cb2b5eae1a2eb03bfce158e33a3230f2d","1dc8336bd449f719d1b141db6620db5c3b2a3c9fa66a1ac56d9fce1dc395d4d9","3fd9526bc407d1b179ce18000f9d4813cf0cad836502436b7f0b843d9fa80bb9","ac12b3ab9c41b92a5c959504c7a9c0289435b1a8f670305a9e879aec69c05012","4ef53f6a50e979c06f1353f5cd3fd0c2d0ef1bf1cece2b1e0