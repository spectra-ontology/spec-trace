{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>select the first frequency band in the frequencyBandList (or for aerial UE frequencyBandListAerial), and frequencyBandListSUL, if present, which the UE supports and for which the UE supports at least one of the additionalSpectrumEmission values in NR-NS-PmaxList (or for aerial UE nr-NS-PmaxListAerial), if present:","paragraph_zero_based":960},{"literal_text_all_w_t_and_m_t":"4>if, the frequency band selected by the UE in frequencyBandList or frequencyBandListAerial to represent a non-serving NR carrier frequency is not a downlink only band:","paragraph_zero_based":961},{"literal_text_all_w_t_and_m_t":"5>if, for the selected frequency band, the UE supports at least one additionalSpectrumEmission in the NR-NS-PmaxList within the frequencyBandList; or","paragraph_zero_based":962},{"literal_text_all_w_t_and_m_t":"5>if, for the selected frequency band, the UE supports at least one additionalSpectrumEmission in the nr-NS-PmaxListAerial within the frequencyBandListAerial:","paragraph_zero_based":963},{"literal_text_all_w_t_and_m_t":"6>if the UE is aerial UE and it supports at least one additionalSpectrumEmission values in nr-NS-PmaxListAerial within the frequencyBandListAerial:","paragraph_zero_based":964},{"literal_text_all_w_t_and_m_t":"7>apply the first listed additionalSpectrumEmission which it supports among the values included in nr-NS-PmaxListAerial within frequencyBandListAerial;","paragraph_zero_based":965},{"literal_text_all_w_t_and_m_t":"6>else:","paragraph_zero_based":966},{"literal_text_all_w_t_and_m_t":"7>apply the first listed additionalSpectrumEmission which it supports among the values included in NR-NS-PmaxList within frequencyBandList;","paragraph_zero_based":967},{"literal_text_all_w_t_and_m_t":"6>if the additionalPmax is present in the same entry of the selected additionalSpectrumEmission within NR-NS-PmaxList or nr-NS-PmaxListAerial:","paragraph_zero_based":968},{"literal_text_all_w_t_and_m_t":"7>apply the additionalPmax;","paragraph_zero_based":969},{"literal_text_all_w_t_and_m_t":"6>else:","paragraph_zero_based":970},{"literal_text_all_w_t_and_m_t":"7>apply the p-Max;","paragraph_zero_based":971},{"literal_text_all_w_t_and_m_t":"6>if frequencyBandListSUL is present in SIB4 and, for the frequency band selected in frequencyBandListSUL, the UE supports at least one additionalSpectrumEmission in the NR-NS-PmaxList within FrequencyBandListSUL:","paragraph_zero_based":972},{"literal_text_all_w_t_and_m_t":"7>apply the first listed additionalSpectrumEmission which it supports among the values included in NR-NS-PmaxList within frequencyBandListSUL;","paragraph_zero_based":973},{"literal_text_all_w_t_and_m_t":"7>if the additionalPmax is present in the same entry of the selected additionalSpectrumEmission within NR-NS-PmaxList:","paragraph_zero_based":974},{"literal_text_all_w_t_and_m_t":"8>apply the additionalPmax;","paragraph_zero_based":975},{"literal_text_all_w_t_and_m_t":"7>else:","paragraph_zero_based":976},{"literal_text_all_w_t_and_m_t":"8>apply the p-Max;","paragraph_zero_based":977},{"literal_text_all_w_t_and_m_t":"6>else:","paragraph_zero_based":978},{"literal_text_all_w_t_and_m_t":"7>apply the p-Max;","paragraph_zero_based":979},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":980},{"literal_text_all_w_t_and_m_t":"6>apply the p-Max;","paragraph_zero_based":981},{"literal_text_all_w_t_and_m_t":"1>if in RRC_IDLE or RRC_INACTIVE, and T331 is running:","paragraph_zero_based":982},{"literal_text_all_w_t_and_m_t":"2>perform the actions as specified in 5.7.8.1a;","paragraph_zero_based":983}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","