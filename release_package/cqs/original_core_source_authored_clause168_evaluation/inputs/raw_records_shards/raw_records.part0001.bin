{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-SIB8-STOP","paragraph_zero_based":13464},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":13465},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13466},{"literal_text_all_w_t_and_m_t":"SIB8 field descriptions","paragraph_zero_based":13467},{"literal_text_all_w_t_and_m_t":"dataCodingScheme","paragraph_zero_based":13468},{"literal_text_all_w_t_and_m_t":"Identifies the alphabet/coding and the language applied variations of a CMAS notification.","paragraph_zero_based":13469},{"literal_text_all_w_t_and_m_t":"messageIdentifier","paragraph_zero_based":13470},{"literal_text_all_w_t_and_m_t":"Identifies the source and type of CMAS notification.","paragraph_zero_based":13471},{"literal_text_all_w_t_and_m_t":"serialNumber","paragraph_zero_based":13472},{"literal_text_all_w_t_and_m_t":"Identifies variations of a CMAS notification.","paragraph_zero_based":13473},{"literal_text_all_w_t_and_m_t":"warningAreaCoordinatesSegment","paragraph_zero_based":13474},{"literal_text_all_w_t_and_m_t":"If present, carries a segment, with one or more octets, of the geographical area where the CMAS warning message is valid as defined in [28]. The first octet of the first warningAreaCoordinatesSegment is equivalent to the first octet of Warning Area Coordinates IE defined in and encoded according to TS 23.041 [29] and so on.","paragraph_zero_based":13475},{"literal_text_all_w_t_and_m_t":"warningMessageSegment","paragraph_zero_based":13476},{"literal_text_all_w_t_and_m_t":"Carries a segment, with one or more octets, of the Warning Message Contents IE defined in TS 38.413 [42]. The first octet of the Warning Message Contents IE is equivalent to the first octet of the CB data IE defined in and encoded according to TS 23.041 [29], clause 9.4.2.2.5, and so on.","paragraph_zero_based":13477},{"literal_text_all_w_t_and_m_t":"warningMessageSegmentNumber","paragraph_zero_based":13478},{"literal_text_all_w_t_and_m_t":"Segment number of the CMAS warning message segment contained in the SIB. A segment number of zero corresponds to the first segment, one corresponds to the second segment, and so on. If warning area coordinates are provided for the warning message, then this field applies to both warning message segment and warning area coordinates segment.","paragraph_zero_based":13479},{"literal_text_all_w_t_and_m_t":"warningMessageSegmentType","paragraph_zero_based":13480},{"literal_text_all_w_t_and_m_t":"Indicates whether the included CMAS warning message segment is the last segment or not. If warning area coordinates are provided for the warning message, then this field applies to both warning message segment and warning area coordinates segment.","paragraph_zero_based":13481},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13482},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":13483},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":13484},{"literal_text_all_w_t_and_m_t":"Segment1","paragraph_zero_based":13485},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in the first segment of SIB8, otherwise it is absent.","paragraph_zero_based":13486},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13487}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["f9978ebda97613e2a8c75ba4c2b5317470f20047206a4a50e42909570a43b376","02d9e4a8f0f665ba8f0e068ffeebc64a1a4a23292c515a04d9aa54afd52353d8","2dd0f9e18dec7a90235f3e6f6172aaef51fbc9d6950254683004c9f65ab0197b","75b8ac35ea57e1b3bcab7b5e1dc2fe737cfcb1f04bfc7fdb737eff4a659661aa","a17e6e1ab875cdb1936618e1b36d2df1e6e9560381947cc2b4105297eeac37d8","c568ff4474a07279499d33b304c9741ab60f11917b59d67012c427f7f3196d5a","5e1729184e0170a81301189a6bb3ac150ac1c114a8ae228e677237a0765afde3","3c4854ce680669025931d4e46e1f6cf2869b4fd4aefe74573f6edfc08ab0473c","be8dafa6b2dcbe9cd636d5466899b34afffd3ae79da1aa903049424285cf363f","718fc80676783558c13c82ebd6568a91499b8a981a4fa71767b484235b292a68","51bb2dc97930353b7759125bbec105d42f0468163a768f62abb1093931ca98af","80365379d4a88552ce431a194cb883f45990eea5d289a7de79550f2ce4107868","56c589926cca31973824d7477b178fddc2b0bc52651eb81b3c197f5a2d32356f","1621d6439476df58ef43f0faa42b2db353586553984161035bc022963a12d3d5","f7e09252104833eb4a6402d6aa509eef408decbb426aaac71b36921bfb070c70","b2c755b0b506ffd99683cd7388c479f92f289260e9e091df3d35042f0a1587c7","617b594c0a0410702eb0b199a9fa962e1da036069ff16eae304a53bac0cd2c89","d938544c32d8539685700caecedbfc385b6e71861d4e7d77f6133c24537c79f5","f8f06e8b4382d38e2e70c6e662e63e3862fee69084ac985b7041563fcf5d5f65","e8b5be4640d09de4cd8725cb15a751a0513ff102f7db2bea7955a533ddb03717","7b2ac0cc558ffb2f0b4a6fc77717417b11017629da3e781c84c9df5330e1974e","5b4c10e4248ba9b017e028defc1f9e0f9c4eff916e877ef7ac7b480237fe97ec","ab3c4daf833818c96c3fb2a56d98c4d8479aaf65a806a704cd111fdfad54f3db","ed94cf2b8345cadfc11c6fb5c7100b810b2458d75ba6d0b98bd8def35af0c3d6"],"paragraph_range_zero_based":[13464,13487],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p13464"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–SIB9","paragraph_zero_based":13488},{"literal_text_all_w_t_and_m_t":"SIB9 contains information related to GPS time and Coordinated Universal Time (UTC). The UE may use the parameters provided in this system information block to obtain the UTC, the GPS and the local time.","paragraph_zero_based":13489},{"literal_text_all_w_t_and_m_t":"NOTE:The UE may use the time information for numerous purposes, possibly involving upper layers e.g. to assist GPS initialisation, to synchronise the UE clock.","paragraph_zero_based":13490},{"literal_text_all_w_t_and_m_t":"SIB9 information element","paragraph_zero_based":13491},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":13492},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB9-START","paragraph_zero_based":13493},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13494},{"literal_text_all_w_t_and_m_t":"SIB9 ::=                            SEQUENCE {","paragraph_zero_based":13495},{"literal_text_all_w_t_and_m_t":"    timeInfo                            SEQUENCE {","paragraph_zero_based":13496},{"literal_text_all_w_t_and_m_t":"        timeInfoUTC                         INTEGER (0..549755813887),","paragraph_zero_based":13497},{"literal_text_all_w_t_and_m_t":"        dayLightSavingTime                  BIT STRING (SIZE (2))                   OPTIONAL,   -- Need R","paragraph_zero_based":13498},{"literal_text_all_w_t_and_m_t":"        leapSeconds                         INTEGER (-127..128)                     OPTIONAL,   -- Need R","paragraph_zero_based":13499},{"literal_text_all_w_t_and_m_t":"        localTimeOffset                     INTEGER (-63..64)                       OPTIONAL    -- Need R","paragraph_zero_based":13500},{"literal_text_all_w_t_and_m_t":"    }                                                                               OPTIONAL,   -- Need R","paragraph_zero_based":13501},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension            OCTET STRING                                OPTIONAL,","paragraph_zero_based":13502},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":13503},{"literal_text_all_w_t_and_m_t":"     [[","paragraph_zero_based":13504},{"literal_text_all_w_t_and_m_t":"    referenceTimeInfo-r16           ReferenceTimeInfo-r16                           OPTIONAL    -- Need R","paragraph_zero_based":13505},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":13506},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":13507},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13508},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB9-STOP","paragraph_zero_based":13509},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":13510},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13511}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["6cfcb7a1344c30745050498cf9ba1c64e332b013c4916107a4f6b9294c524405","5d2071f4f8b87e8ac580f9e925c998a601a95dbe68d0740199232d32762f2d8e","54eea358e0ef3ae1e4fe6668df9776ff8e064c1b8ccec4eee6d646f66692583e","5348c1b3a0b7b6541ea7c29df66ff3cae6462d5401f74f6f9209ec96927aa5b0","3b30aaacc3e9792a454d2f6bfdc2359d47316d2eb601b46c7fe3d419df521a5e","97079579fc9e2622222c7f9d77e064ea99220efaee6debdc08547b5b46f04f27","52c8a6e2e752ac102d712e29d0b6b99b4c49ffc57cb1fed1005e7ae0e57a5f9b","0685aa5266958d1c81f2d2027ad0c890f23963004431f46e73634d5473c159e3","b236ae1df87e4d11c5620daf040a67e6160166a61647d1fb0119c8de68f574d2","e5511c5e7fe6ebd4567531f8bacd4798195dac53ca3b835493798bc633e59e57","7cef233c13c8a63689d1bcf8c09b67b5e2c4af5402c5897f0ee9ed60fbce71a2","a36e72958c9e5eeb4258cfae85a5c01819aed20b9a80c0ebfb7db520e770612d","d1a71448518782ba7de7be04ec9df9b8a01ca2df92f2ecf1071264ac9bebcec2","5736832e30bcc4f976b91c685d3bfd693564f534130e8c20924722243cf52c9b","1eae2b6e2ef26e7508656aea9a59288dc9c1ad5e7facfed6e8041ac4d419e4e9","0eb082f0dffaa71f814d384322ba30f5c3234a1f0ff2bc553642cff4e40bfc46","04f35f7966ad20173df0481a5c49a4975eb93d7015a093d477b3b0fd9d8d3a38","c791d5adea1f186a2181ae7971db35caadeac490d8456548741de2db8b7e9bd2","d14adeddc72ed4c702b62d43a6565fcb7e0d0fdfbde5ef744bf212be816e8b2e","a02e1c19165b29a1115fc987a05584024953d1caf17152853c4fc0fd2c3dbd27","c279457e0baa4a182a8f91c5a22569b99f9692c513690a2f63ecd46bb7819ae2","ffae74213c92c226baaeb74012510ab019e529fe8a95d4818d4e1ff1aea47158","3505aecfae0ccd31b9422d02188532f2b4f16db12be2b2526eb241fb062bc86d","26fbe661fbfb9722e554a33927cced43adad98fd06d4bcdbd28c6930496ac92c"],"paragraph_range_zero_based":[13488,13511],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p13488"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SIB9 field descriptions","paragraph_zero_based":13512},{"literal_text_all_w_t_and_m_t":"dayLightSavingTime","paragraph_zero_based":13513},{"literal_text_all_w_t_and_m_t":"Indicates if and how daylight-saving time (DST) is applied to obtain the local time. The semantics are the same as the semantics of the Daylight Saving Time IE in TS 24.501 [23] and TS 24.008 [38]. The first/leftmost bit of the bit string contains the b2 of octet 3 and the second bit of the bit string contains b1 of octet 3 in the value part of the Daylight Saving Time IE in TS 24.008 [38].","paragraph_zero_based":13514},{"literal_text_all_w_t_and_m_t":"leapSeconds","paragraph_zero_based":13515},{"literal_text_all_w_t_and_m_t":"Number of leap seconds offset between GPS Time and UTC. UTC and GPS time are related i.e. GPS time -leapSeconds = UTC time.","paragraph_zero_based":13516},{"literal_text_all_w_t_and_m_t":"localTimeOffset","paragraph_zero_based":13517},{"literal_text_all_w_t_and_m_t":"Offset between UTC and local time in units of 15 minutes. Actual value = field value * 15 minutes. Local time of the day is calculated as UTC time + localTimeOffset.","paragraph_zero_based":13518},{"literal_text_all_w_t_and_m_t":"timeInfoUTC","paragraph_zero_based":13519},{"literal_text_all_w_t_and_m_t":"Coordinated Universal Time corresponding to the SFN boundary at or immediately after the ending boundary of the SI-window in which SIB9 is transmitted. The field counts the number of UTC seconds in 10 ms units since 00:00:00 on Gregorian calendar date 1 January, 1900 (midnight between Sunday, December 31, 1899 and Monday, January 1, 1900). See NOTE 1. This field is excluded when determining changes in system information, i.e. changes of timeInfoUTC should neither result in system information change notifications nor in a modification of valueTag in SIB1.","paragraph_zero_based":13520},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13521},{"literal_text_all_w_t_and_m_t":"NOTE 1:The UE may use this field together with the leapSeconds field to obtain GPS time as follows: GPS Time (in seconds) = timeInfoUTC (in seconds) -  2,524,953,600 (seconds) + leapSeconds, where 2,524,953,600 is the number of seconds between 00:00:00 on Gregorian calendar date 1 January, 1900 and 00:00:00 on Gregorian calendar date 6 January, 1980 (start of GPS time).","paragraph_zero_based":13522},{"literal_text_all_w_t_and_m_t":"–SIB10","paragraph_zero_based":13523},{"literal_text_all_w_t_and_m_t":"SIB10 contains the HRNNs of the NPNs listed in SIB1.","paragraph_zero_based":13524},{"literal_text_all_w_t_and_m_t":"SIB10 information element","paragraph_zero_based":13525},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":13526},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB10-START","paragraph_zero_based":13527},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13528},{"literal_text_all_w_t_and_m_t":"SIB10-r16 ::=               SEQUENCE {","paragraph_zero_based":13529},{"literal_text_all_w_t_and_m_t":"    hrnn-List-r16               HRNN-List-r16                                   OPTIONAL,   -- Need R","paragraph_zero_based":13530},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension    OCTET STRING                                    OPTIONAL,","paragraph_zero_based":13531},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":13532},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":13533},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13534},{"literal_text_all_w_t_and_m_t":"HRNN-List-r16 ::=           SEQUENCE (SIZE (1..maxNPN-r16)) OF HRNN-r16","paragraph_zero_based":13535}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da