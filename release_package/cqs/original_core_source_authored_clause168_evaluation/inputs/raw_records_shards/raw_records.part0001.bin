{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27744},{"literal_text_all_w_t_and_m_t":"MIMOParam-r17 ::= SEQUENCE {","paragraph_zero_based":27745},{"literal_text_all_w_t_and_m_t":"    additionalPCI-ToAddModList-r17     SEQUENCE (SIZE(1..maxNrofAdditionalPCI-r17)) OF SSB-MTC-AdditionalPCI-r17  OPTIONAL,   -- Need N","paragraph_zero_based":27746},{"literal_text_all_w_t_and_m_t":"    additionalPCI-ToReleaseList-r17    SEQUENCE (SIZE(1..maxNrofAdditionalPCI-r17)) OF AdditionalPCIIndex-r17     OPTIONAL,   -- Need N","paragraph_zero_based":27747},{"literal_text_all_w_t_and_m_t":"    unifiedTCI-StateType-r17           ENUMERATED {separate, joint}                                         OPTIONAL,   -- Need R","paragraph_zero_based":27748},{"literal_text_all_w_t_and_m_t":"    uplink-PowerControlToAddModList-r17  SEQUENCE (SIZE (1..maxUL-TCI-r17)) OF Uplink-powerControl-r17      OPTIONAL,   -- Need N","paragraph_zero_based":27749},{"literal_text_all_w_t_and_m_t":"    uplink-PowerControlToReleaseList-r17 SEQUENCE (SIZE (1..maxUL-TCI-r17)) OF Uplink-powerControlId-r17    OPTIONAL,   -- Need N","paragraph_zero_based":27750},{"literal_text_all_w_t_and_m_t":"    sfnSchemePDCCH-r17                 ENUMERATED {sfnSchemeA,sfnSchemeB}                                   OPTIONAL,   -- Need R","paragraph_zero_based":27751},{"literal_text_all_w_t_and_m_t":"    sfnSchemePDSCH-r17                 ENUMERATED {sfnSchemeA,sfnSchemeB}                                   OPTIONAL    -- Need R","paragraph_zero_based":27752},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27753},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27754},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27755},{"literal_text_all_w_t_and_m_t":"-- TAG-SERVINGCELLCONFIG-STOP","paragraph_zero_based":27756},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27757},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27758},{"literal_text_all_w_t_and_m_t":"ChannelAccessConfig field descriptions","paragraph_zero_based":27759},{"literal_text_all_w_t_and_m_t":"absenceOfAnyOtherTechnology","paragraph_zero_based":27760},{"literal_text_all_w_t_and_m_t":"Presence of this field indicates absence on a long term basis (e.g. by level of regulation) of any other technology sharing the carrier; absence of this field indicates the potential presence of any other technology sharing the carrier, as specified in TS 37.213 [48] clauses 4.2.1 and 4.2.3.","paragraph_zero_based":27761},{"literal_text_all_w_t_and_m_t":"energyDetectionConfig","paragraph_zero_based":27762},{"literal_text_all_w_t_and_m_t":"Indicates whether to use the maxEnergyDetectionThreshold or the energyDetectionThresholdOffset (see TS 37.213 [48], clause 4.2.3).","paragraph_zero_based":27763},{"literal_text_all_w_t_and_m_t":"energyDetectionThresholdOffset","paragraph_zero_based":27764},{"literal_text_all_w_t_and_m_t":"Indicates the offset to the default maximum energy detection threshold value. Unit in dB. Value -13 corresponds to -13dB, value -12 corresponds to -12dB, and so on (i.e. in steps of 1dB) as specified in TS 37.213 [48], clause 4.2.3.","paragraph_zero_based":27765},{"literal_text_all_w_t_and_m_t":"maxEnergyDetectionThreshold","paragraph_zero_based":27766},{"literal_text_all_w_t_and_m_t":"Indicates the absolute maximum energy detection threshold value. Unit in dBm. Value -85 corresponds to -85 dBm, value -84 corresponds to -84 dBm, and so on (i.e. in steps of 1dBm) as specified in TS 37.213 [48], clause 4.2.3.","paragraph_zero_based":27767}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["5a5a5963f476d74bb678af67dcbe5486a30475b6f74dd73d029e2dd1a0e5496d","5f4653c937b4f42fa2920a7bf79ba4a95e5950fd03b939015fe24381bc294a03","f2aeb0279d99bf2afe34c2318460e069f072df80f0313c2ae116eaf91ef66f7c","4a86d482348a0b49d50a2c7050d4d53f19a196924d98578e0d86d3b278583342","92460f3a1122f384735cac64abf310067ec14611d33086b52aad31d1ec064ec6","1a2d4b49fe017cca1521161365ff8e9ec47f3b69d7ba8c5db0863d95337cd320","f93bcfc1fa5e2e1b3db9781277b7a620d220ffbd10eee649143c195bff0105d3","b9ff8bf06451b182b18de233fa8f60664cc15c9731e6a565337adf4e46b926e1","be04ae5db21cc0d6c08420bdc23ad925c98b469fed0ddbf14d669a41298fccb7","676dfffb9d2f1bdff979ffd739b7623f07fa14e4343fc1d9e5f8b235afde9066","15a24574e43ff281a5da8f6b17b446ee3128e9643103f636c119056123679820","b900ae2e6acc9f7161dc9282fb1981690c640fff7712caec452d0ae0995a568f","902af364303835f6e340b9eb01e2da2ba66ce3e679377c3a41895d33c8988dee","1663d3b8c989ed6e5668c038666c09cfae19e14a1bb068e75c1e1c74b09671cb","ea7e49f63c8925649e026f4ea969d630eb7d79b597cae93f4d51ea2c1e77fdda","1644547107c89267d38f91597305589e4c4196721a1a76be387e56cd0bd3e953","73a5def39beeba48b48098b30fd2b0d2518498103f00e24d53411a0be7ff6bba","85309de7dcb74415d0a4088ac469ccc1a531e18d642f042ea0a06bff12b6ae28","1b0e62ab2cf2ca5f0b217d3e735403e1f3c4ea0199e22c4c7128b36681bd7417","3d0e0d535bb1ff41c21927d8a2424591f57eb1718ab80648f6be45b8b758e7e7","23239b9e46b8a365279443cbb0fc6ff6092c3d030e348c5faa4043a7aa375ffb","ab91928eb882266f7a6e72582319e94c877672c9a2551c126b4955e055c43ddd","d894978cd963fd08ab2bf90e432e4c2374a51b17e9ce57a84d257ae5d0948049","ba9ce59cdaabd2c3eecc8ba5018a64ad46bfecf25a9d6cac40232ac15ebd5a3b"],"paragraph_range_zero_based":[27744,27767],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p27744"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ul-toDL-COT-SharingED-Threshold","paragraph_zero_based":27768},{"literal_text_all_w_t_and_m_t":"Maximum energy detection threshold that the UE should use to share channel occupancy with gNB for DL transmission as specified in TS 37.213 [48], clause 4.1.3 for downlink channel access and clause 4.2.3 for uplink channel access. This field is not applicable in semi-static channel access mode.","paragraph_zero_based":27769},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27770},{"literal_text_all_w_t_and_m_t":"ServingCellConfig field descriptions","paragraph_zero_based":27771},{"literal_text_all_w_t_and_m_t":"additionalPCI-ToAddModList","paragraph_zero_based":27772},{"literal_text_all_w_t_and_m_t":"List of information for the additional SSB with different PCI than the serving cell PCI. The additional SSBs with different PCIs are not used for serving cell quality derivation.","paragraph_zero_based":27773},{"literal_text_all_w_t_and_m_t":"bwp-InactivityTimer","paragraph_zero_based":27774},{"literal_text_all_w_t_and_m_t":"The duration in ms after which the UE falls back to the default Bandwidth Part (see TS 38.321 [3], clause 5.15). When the network releases the timer configuration, the UE stops the timer without switching to the default BWP.","paragraph_zero_based":27775},{"literal_text_all_w_t_and_m_t":"ca-SlotOffset","paragraph_zero_based":27776},{"literal_text_all_w_t_and_m_t":"Slot offset between the primary cell (PCell/PSCell) and the SCell in unaligned frame boundary with slot alignment and partial SFN alignment inter-band CA. Based on this field, the UE determines the time offset of the SCell as specified in clause 4.5 of TS 38.211 [16]. The granularity of this field is determined by the reference SCS for the slot offset (i.e. the maximum of PCell/PSCell lowest SCS among all the configured SCSs in DL/UL SCS-SpecificCarrierList in ServingCellConfigCommon or ServingCellConfigCommonSIB and this serving cell's lowest SCS among all the configured SCSs in DL/UL SCS-SpecificCarrierList in ServingCellConfigCommon or ServingCellConfigCommonSIB).","paragraph_zero_based":27777},{"literal_text_all_w_t_and_m_t":"The Network configures at most single non-zero offset duration in ms (independent on SCS) among CCs in the unaligned CA configuration. If the field is absent, the UE applies the value of 0. The slot offset value can only be changed with SCell release and add.","paragraph_zero_based":27778},{"literal_text_all_w_t_and_m_t":"cbg-TxDiffTBsProcessingType1, cbg-TxDiffTBsProcessingType2","paragraph_zero_based":27779},{"literal_text_all_w_t_and_m_t":"Indicates whether processing types 1 and 2 based CBG based operation is enabled according to Rel-16 UE capabilities.","paragraph_zero_based":27780},{"literal_text_all_w_t_and_m_t":"channelAccessConfig","paragraph_zero_based":27781},{"literal_text_all_w_t_and_m_t":"List of parameters used for access procedures of operation with shared spectrum channel access (see TS 37.213 [48).","paragraph_zero_based":27782},{"literal_text_all_w_t_and_m_t":"channelAccessMode2","paragraph_zero_based":27783},{"literal_text_all_w_t_and_m_t":"If present, this field indicates that the UE shall apply channel access procedures for operation with shared spectrum channel access in accordance with TS 37.213 [48], clause 4.4 for FR2-2. If absent, the UE does not apply these channel access procedures. The network always configures this field if channel access procedures are required for the serving cell within this region by regulations.","paragraph_zero_based":27784},{"literal_text_all_w_t_and_m_t":"Overwrites the corresponding field in ServingCellConfigCommon or ServingCellConfigCommonSIB for this serving cell.","paragraph_zero_based":27785},{"literal_text_all_w_t_and_m_t":"crossCarrierSchedulingConfig","paragraph_zero_based":27786},{"literal_text_all_w_t_and_m_t":"Indicates whether this serving cell is cross-carrier scheduled by another serving cell or whether it cross-carrier schedules another serving cell. If the field other is configured for an SpCell (i.e., the SpCell is cross-carrier scheduled by another serving cell), the SpCell can be additionally scheduled by the PDCCH on the SpCell.","paragraph_zero_based":27787},{"literal_text_all_w_t_and_m_t":"crossCarrierSchedulingConfigRelease","paragraph_zero_based":27788},{"literal_text_all_w_t_and_m_t":"If this field is included, the UE shall release the cross carrier scheduling configuration configured by crossCarrierSchedulingConfig. The network may only include either crossCarrierSchedulingConfigRelease or crossCarrierSchedulingConfig at a time.","paragraph_zero_based":27789},{"literal_text_all_w_t_and_m_t":"crs-RateMatch-PerCORESETPoolIndex","paragraph_zero_based":27790},{"literal_text_all_w_t_and_m_t":"Indicates how UE performs rate matching when both lte-CRS-PatternList1-r16 and lte-CRS-PatternList2-r16 are configured as specified in TS 38.214 [19], clause 5.1.4.2.","paragraph_zero_based":27791}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["37f0af65c0f5d0f37acf08e22690121677c51dc40d04c68b2ef80a1d04633431","68674131d87175edb48f71ecc54d8f05c88e07f2c69039c10dbf4f5727e92aab","d60f3a2a851bac018fff19d6ba3255b811ab57ae27841c2ecade1444a0818fe8","ef68032c03fa896510046856ed25b36655d8fccfa1949fd1f4afa978cef9d231","596d484df99f51c62fb01dee26696f0133d8d23d3cc077eb118417c63c98bb5a","1b2f019110659b84c3abb62ac0071c487c5a947bc25cf2da15e2264426e2bfe0","625a3a586edd7150893ad231a932a89626ea83c41f75e500f7cdc07564377bec","b5e12e48803e0de618f7ddf06a46c985dc29bd0486f8496ad83739d676fd0ddd","d39dd2894afb1229e4fc97133d54ed1f87fb7eed7bdf9441f5a472075f059f95","8c4cd5b56e3bc4c2787963cc6479f158ac3b9a77b45c9d8b91d78896bba6512b","84a204363fb52e7a7aac6c4df38e75131a477dd6fb4fba24e9d2446094f8fc23","276c40298acc9b9676b7db0aea7488ea378ba1ee88bdfd5979d8e92f139a7186","8781f550e09f78e945521c6dbe3ebf359e665148f546b51d5bce66041145ee77","7206558b53bca6707e239c6c92512df4df6f0a19aa8e029a575bf9874bb74aa5","bf9da080408e8871218caa62ec54ef2506bf1852472b7d206d550f0d5301244b","4b2e9d2e69e2be2ff9d040f74b3272508b8b8600c15e54d80fd14489b92dd4f7","99fb042db4aa170a1c53680f9bcd5864306991df177652f43d8c773e556a6829","718c0c6852fb89d4ab22f95ed2ecd9a4886624fc9b4ee7c70917c96d525b464b","ea70d8bfef65fcb974c1b994801f933be04e26625d08179843daefc61b936d68","d902f371bbc4e33d4ad5123e2d91429d1d7beaf80aefba3bfa57f841a474d5bb","b957487b1492e4c487557f07a3dd27211428cfb9836b09b5cca96a2cd5384cda","1ac0569f8043d537baa7ad67b5ff168be0b9402d78d2074996bf21545fd09743","6e759657cf05cce836e109bb4fe35a82cad076d2dd5d421b5bfb6d54f4d4ecca","a44495201986d791e8c9258896e2866d99aeef5648a041f3449bc85542ece41e"],"paragraph_range_zero_based":[27768,27791],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p27768"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"csi-RS-ValidationWithDCI","paragraph_zero_based":27792},{"literal_text_all_w_t_and_m_t":"Indicates how the UE performs periodic and semi-persistent CSI-RS reception in a slot. The presence of this field indicates that the UE uses DCI detection to validate whether to receive CSI-RS (see TS 38.213 [13], clause 11.1).","paragraph_zero_based":27793},{"literal_text_all_w_t_and_m_t":"defaultDownlinkBWP-Id","paragraph_zero_based":27794},{"literal_text_all_w_t_and_m_t":"The initial bandwidth part is referred to by BWP-Id = 0. ID of the downlink bandwidth part to be used upon expiry of the BWP inactivity timer. This field is UE specific. When the field is absent the UE uses the initial BWP as default BWP. (see TS 38.213 [13], clause 12 and TS 38.321 [3], clause 5.15).","paragraph_zero_based":27795},{"literal_text_all_w_t_and_m_t":"directionalCollisionHandling","paragraph_zero_based":27796},{"literal_text_all_w_t_and_m_t":"Indicates that this serving cell is using directional collision handling between a reference and other cell(s) for half-duplex operation in TDD CA with same SCS as specified in TS 38.213 [13], clause 11.1. The half-duplex operation only applies within the same frequency range and cell group.The network only configures this field for TDD serving cells that are using the same SCS.","paragraph_zero_based":27797},{"literal_text_all_w_t_and_m_t":"directionalCollisionHandling-DC","paragraph_zero_based":27798},{"literal_text_all_w_t_and_m_t":"For the IAB-MT, it indicates that this serving cell is using directional collision handling between a reference and other cell(s) for half-duplex operation in TDD NR-DC with same SCS within same cell group or cross different cell groups.","paragraph_zero_based":27799},{"literal_text_all_w_t_and_m_t":"dormantBWP-Config","paragraph_zero_based":27800},{"literal_text_all_w_t_and_m_t":"The dormant BWP configuration for an SCell. This field can be configured only for a (non-PUCCH) SCell.","paragraph_zero_based":27801},{"literal_text_all_w_t_and_m_t":"downlinkBWP-ToAddModList","paragraph_zero_based":27802},{"literal_text_all_w_t_and_m_t":"List of additional downlink bandwidth parts to be added or modified. (see TS 38.213 [13], clause 12).","paragraph_zero_based":27803},{"literal_text_all_w_t_and_m_t":"downlinkBWP-ToReleaseList","paragraph_zero_based":27804},{"literal_text_all_w_t_and_m_t":"List of additional downlink bandwidth parts to be released. (see TS 38.213 [13], clause 12).","paragraph_zero_based":27805},{"literal_text_all_w_t_and_m_t":"downlinkChannelBW-PerSCS-List","paragraph_zero_based":27806},{"literal_text_all_w_t_and_m_t":"A set of UE specific channel bandwidth and location configurations for different subcarrier spacings (numerologies). Defined in relation to Point A. The UE uses the configuration provided in this field only for the purpose of channel bandwidth and location determination. If absent, UE uses the configuration indicated in scs-SpecificCarrierList in DownlinkConfigCommon / DownlinkConfigCommonSIB. Network only configures channel bandwidth that corresponds to the channel bandwidth values defined in TS 38.101-1 [15], TS 38.101-2 [39], and TS 38.101-5 [75].","paragraph_zero_based":27807},{"literal_text_all_w_t_and_m_t":"dummy1, dummy 2","paragraph_zero_based":27808},{"literal_text_all_w_t_and_m_t":"This field is not used in the specification. If received it shall be ignored by the UE.","paragraph_zero_based":27809},{"literal_text_all_w_t_and_m_t":"enableBeamSwitchTiming","paragraph_zero_based":27810},{"literal_text_all_w_t_and_m_t":"Indicates the aperiodic CSI-RS triggering with beam switching triggering behaviour as defined in clause 5.2.1.5.1 of TS 38.214 [19].","paragraph_zero_based":27811},{"literal_text_all_w_t_and_m_t":"enableDefaultTCI-StatePerCoresetPoolIndex","paragraph_zero_based":27812},{"literal_text_all_w_t_and_m_t":"Presence of this field indicates the UE shall follow the release 16 behavior of default TCI state per CORESETPoolindex when the UE is configured by higher layer parameter PDCCH-Config that contains two different values of CORESETPoolIndex in ControlResourceSet is enabled.","paragraph_zero_based":27813},{"literal_text_all_w_t_and_m_t":"enableTwoDefaultTCI-States","paragraph_zero_based":27814},{"literal_text_all_w_t_and_m_t":"Presence of this field indicates the UE shall follow the release 16 behavior of two default TCI states for PDSCH when at least one TCI codepoint is mapped to two TCI states is enabled","paragraph_zero_based":27815}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["fb9f4aa7fc901e2f568822ac4d003698c4cc1ebc1d426e2f8f1ad8a685807281","99e9cd9763fb58691f34baa82185ccce7ac000c8426976a3bf94049edb11ef7e","544aa28802d8008c52681e34a9a9b53f8311ce2a1598cbb9a48e5a0564e0d25f","b6946299a8196f006a46beb0e028a327411efa8e42c8cdcd8ebf13d0a84d2e5f","450feedd208e0bcc593aeebba577b827899b65cccf2cb9c7360d4f0c1e2af8fb","c795296c651a94f3661c365745457eac2d3dc200d855c566a2f7cda14bd745e6","a90ce5048ef9395d3109f17973df9cf17bc84880cb10900549a2fc646ee4ea58","5f2a6d89dffa0dbcdea15193a5b51d80680bebf3c18ab970b8b003eafd8916c9","45caafcc96cb7740a678f7c0e028d05aa635e193bcf07bda9407273e7fe7eda5","c5dc3aa87a4b14fe643ecbfa4d936634d3d307cab60b92ce712b2f4ddab83cce","fee731866a8e5ef02ec463202fab55726986c81b312c25f8f2b68a64a3126323","95482346ce5c64693ab5cc10049c34026504ca7bad5ed1dd67558fd3ab3fff02","ce189a2e2055489a1dca13ee2d2b1844ddbf3320325680c422cffaeb726cae1d","45f09d062311133dd2767e2aedf58521429635d173a431ada12fcb4178d6543c","48ceea9790100b40c56c4ba09ff028cc50d41a72e68d1abb417268b9a8babfd5","3ae4936e767d37643bb0ce14778a73115563347f415f000392a1ee16fffb3208","2e31732336e6fac38b6bdca3cc6e9fc958596832d1cbbcd652de5731eddabfdc","dd54bd0e3c606a1441d2750a4dba77434d5516dee94be2e2310aaabd3bd3fe01","3e34b00ec76053acd1d6f422f3430b806a7e777c231d611b7b96f417f25ef9be","339e12af8fdaa8fc48bb8a5e4d7685c5de417211dbe01b41d2446e09a09b3cd0","ec4dab3921add9fcb251f2de87363f0884f4da9af3f08e33c925c13bb8d5d8c3","ee39d27f8af3ee7fca94bbd2c3bc939b3e192d7758d4f23973e2dade1056d37b","5d2cc3afb0784f2a037ad30cb458519577e19938d376dfbfc30632306ab38077","74e070dd5726399842ceae7a759ab06ad016a658f0082b1b88298b6ff20cdf22"],"paragraph_range_zero_based":[27792,27815],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p27792"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"fdmed-ReceptionMulticast","paragraph_zero_based":27816},{"literal_text_all_w_t_and_m_t":"Indicates the Type-1 HARQ codebook generation as specified in TS 38.213 [13], clause 9.1.2.1.","paragraph_zero_based":27817},{"literal_text_all_w_t_and_m_t":"firstActiveDownlinkBWP-Id","paragraph_zero_based":27818},{"literal_text_all_w_t_and_m_t":"If configured for an SpCell, this field contains the ID of the DL BWP to be activated or to be used for RLM, BFD and measurements if included in an RRCReconfiguration message contained in an NR or E-UTRA RRC message indicating that the SCG is deactivated, upon performing the RRC (re-)configuration. If the field is absent, the RRC (re-)configuration does not impose a BWP switch. If the field is absent for the PSCell at SCG deactivation, the UE considers the previously activated DL BWP as the BWP to be used for RLM, BFD and measurements. If the field is absent for the PSCell at SCG activation, the DL BWP to be activated is the DL BWP previously to be used for RLM, BFD and measurements.","paragraph_zero_based":27819},{"literal_text_all_w_t_and_m_t":"If configured for an SCell, this field contains the ID of the downlink bandwidth part to be used upon activation of an SCell. The initial bandwidth part is referred to by BWP-Id = 0.","paragraph_zero_based":27820},{"literal_text_all_w_t_and_m_t":"Upon reconfiguration with reconfigurationWithSync, the network sets the firstActiveDownlinkBWP-Id and firstActiveUplinkBWP-Id to the same value.","paragraph_zero_based":27821},{"literal_text_all_w_t_and_m_t":"initialDownlinkBWP","paragraph_zero_based":27822},{"literal_text_all_w_t_and_m_t":"The dedicated (UE-specific) configuration for the initial downlink bandwidth-part (i.e., DL BWP#0). If any of the optional IEs are configured within this IE, the UE considers the BWP#0 to be an RRC configured BWP (from UE capability viewpoint). Otherwise, the UE does not consider the BWP#0 as an RRC configured BWP (from UE capability viewpoint). Network always configures the UE with a value for this field if no other BWPs are configured. NOTE1","paragraph_zero_based":27823},{"literal_text_all_w_t_and_m_t":"intraCellGuardBandsDL-List, intraCellGuardBandsUL-List","paragraph_zero_based":27824},{"literal_text_all_w_t_and_m_t":"List of intra-cell guard bands in a serving cell for operation with shared spectrum channel access in FR1. If not configured, the guard bands are defined according to 38.101-1 [15], see TS 38.214 [19], clause 7. For operation in licensed spectrum, this field is absent, and no UE action is required.","paragraph_zero_based":27825},{"literal_text_all_w_t_and_m_t":"lte-CRS-PatternList1","paragraph_zero_based":27826},{"literal_text_all_w_t_and_m_t":"A list of LTE CRS patterns around which the UE shall do rate matching for PDSCH. The LTE CRS patterns in this list shall be non-overlapping in frequency. The network does not configure this field and lte-CRS-ToMatchAround simultaneously.","paragraph_zero_based":27827},{"literal_text_all_w_t_and_m_t":"lte-CRS-PatternList2","paragraph_zero_based":27828},{"literal_text_all_w_t_and_m_t":"A list of LTE CRS patterns around which the UE shall do rate matching for PDSCH scheduled with a DCI detected on a CORESET with CORESETPoolIndex configured with 1. This list is configured only if CORESETPoolIndex configured with 1. The first LTE CRS pattern in this list shall be fully overlapping in frequency with the first LTE CRS pattern in lte-CRS-PatternList1, The second LTE CRS pattern in this list shall be fully overlapping in frequency with the second LTE CRS pattern in lte-CRS-PatternList1, and so on. Network configures this field only if the field lte-CRS-ToMatchAround is not configured and there is at least one ControlResourceSet in one DL BWP of this serving cell with coresetPoolIndex set to 1.","paragraph_zero_based":27829},{"literal_text_all_w_t_and_m_t":"lte-CRS-ToMatchAround","paragraph_zero_based":27830},{"literal_text_all_w_t_and_m_t":"Parameters to determine an LTE CRS pattern that the UE shall rate match around.","paragraph_zero_based":27831},{"literal_text_all_w_t_and_m_t":"lte-NeighCellsCRS-AssistInfoList","paragraph_zero_based":27832},{"literal_text_all_w_t_and_m_t":"A list of LTE neighbour cells configuration information which is used to assist the UE to perform CRS interference mitigation (CRS-IM) in scenarios with overlapping spectrum for LTE and NR (see TS 38.101-4 [59]). If the field is included, it replaces any previous list, i.e. all the entries of the list are replaced and each of the LTE-NeighCellsCRS-AssistInfo entries is considered to be newly created and the conditions and Need codes for setup of the entry apply.","paragraph_zero_based":27833},{"literal_text_all_w_t_and_m_t":"lte-NeighCellsCRS-Assumptions","paragraph_zero_based":27834},{"literal_text_all_w_t_and_m_t":"If the field is not configured, the following default network configuration assumptions are valid for all LTE neighbour cells for the purpose of CRS interference mitigation (CRS-IM) in scenarios with overlapping spectrum for LTE and NR (see TS 38.101-4 [59]).","paragraph_zero_based":27835},{"literal_text_all_w_t_and_m_t":"-The CRS port number is the same as the one indicated in RateMatchPatternLTE-CRS if configured for the serving cell.","paragraph_zero_based":27836},{"literal_text_all_w_t_and_m_t":"-The CRS port number is 4 if RateMatchPatternLTE-CRS is not configured for the serving cell.","paragraph_zero_based":27837},{"literal_text_all_w_t_and_m_t":"-The channel bandwidth and centre frequency are the same as the ones indicated in RateMatchPatternLTE-CRS if configured for the serving cell.","paragraph_zero_based":27838},{"literal_text_all_w_t_and_m_t":"-The MBSFN configuration is the same as the one indicated in RateMatchPatternLTE-CRS if configured for the serving cell. If RateMatchPatternLTE-CRS is not configured for the serving cell, MBSFN subframe is not configured.","paragraph_zero_based":27839}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["0935c66f8a9395472d156959dc5d0fa2806d43a3c3229d26c5be89657984ad77","4c99a51bbcbe88fd23ca160bb3d3bbc10ea9eabdb3a9dc758c2c65726cce9506","98c7c476ff75b8dfc85924734c6ba2631e15d2b133ab41082a5bc8edbec4c9a5","c30461f7e265bbd7eac4a78ab09ef0106e3a5e672417c50316751dd1970c058e","07a32969f61eebded3f1e0f8c0e47c85f1ed004b815520282a3e3db8a12c1376","c3d018409cd838d164bf769e086c283d0579d952d6f08e4c141f56e6503264d3","f37dea396a05b801dbe9d9134acb3725d3ab078cc63412e04b7d7c294cf0e98f","b72ba3cdddb5d220e0218e5cd8b7b9983ea1d9e2bb3a1475f01ccc9ef62d9284","aa564bc24fa0ba30aabf8e0d66176066e41e1e6c79038ba6e8656baf0aaa519c","e13b37448a47da706f3b75750e8085894e4bc66dee99cd05c38936aee35537f3","c07452fa1a309f74fd09b123cdfe523ba9130dc66b63f7d77bb57b126024c22f","1ead760655ac7dec17f5a8325d3fdcd550beb01b6ca4738026463e81a080a77f","9a0e2ba02da9d4d88a3f1beb928c013d0028dba90a187b8d006d9baa0357ecdd","44a0ee280f3c66f09b1388ed2d0b02c92c1a9bb54832a703db728f7810f223d0","b84cfb14994be0cac83ed72e4c4fe354f61b3637cd7c30d4a4f102628361eaab","4f097365e5a3a8715028bf1c6c8fa44d64329ab6ef974b7017752c83555650b5","911a73f4a03d09b48dab1ccc8219faacaa09023aff1cd3da20e24bbd2e13fb7f","2ef60064d8ea3bd31cfbd72644722f149d2d55f2585e842d1c54f304e37be06f","17ca168b13f83714602b102563f0fa44303f47f09c299a2578409c6c2527b725","a83ca2d1f5fd51b5b76b506c69214fe21155583c05d9c8c2543a3fe7e76d1f18","e890c5b3976aa4294a413fe362d36692809fdd94f126276032efaf3662598cfb","91342ca75fdc2208bb754c9573dfa530aca85333a814e0ebffa87b8a8f65a384","69394f3c17683d52799e38dfac17cfce13f08032a672d9e923a7bab9bf19a5ed","0c8125c61c3bd8e405621c05c74a552ca421efccf193e80dc27da3da976dcbb2"],"paragraph_range_zero_based":[27816,27839],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p27816"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-Network-based CRS interference mitigation (i.e., CRS muting), as in crs-IntfMitigConfig specified in TS 36.331 [10], is not enabled.","paragraph_zero_based":27840},{"literal_text_all_w_t_and_m_t":"If the field is configured (i.e. false) and LTE-NeighCellsCRS-AssistInfoList is configured, the configuration provided in LTE-NeighCellsCRS-AssistInfoList overrides the default network configuration assumptions.","paragraph_zero_based":27841},{"literal_text_all_w_t_and_m_t":"If the field is configured (i.e. false) and LTE-NeighCellsCRS-AssistInfoList is not configured, it is up to the UE implementation whether to apply CRS-IM operation.","paragraph_zero_based":27842},{"literal_text_all_w_t_and_m_t":"nr-dl-PRS-PDC-Info","paragraph_zero_based":27843},{"literal_text_all_w_t_and_m_t":"Configures the DL PRS for propagation delay compensation. When configured, the UE measures the UE Rx-Tx time difference based on the reference signals configured in this field.","paragraph_zero_based":27844},{"literal_text_all_w_t_and_m_t":"nrofHARQ-BundlingGroups","paragraph_zero_based":27845},{"literal_text_all_w_t_and_m_t":"Indicates the number of HARQ bundling groups for type2 HARQ-ACK codebook.","paragraph_zero_based":27846},{"literal_text_all_w_t_and_m_t":"pathlossReferenceLinking","paragraph_zero_based":27847},{"literal_text_all_w_t_and_m_t":"Indicates whether UE shall apply as pathloss reference either the downlink of SpCell (PCell for MCG or PSCell for SCG) or of SCell that corresponds with this uplink (see TS 38.213 [13], clause 7).","paragraph_zero_based":27848},{"literal_text_all_w_t_and_m_t":"pdsch-ServingCellConfig","paragraph_zero_based":27849},{"literal_text_all_w_t_and_m_t":"PDSCH related parameters that are not BWP-specific.","paragraph_zero_based":27850},{"literal_text_all_w_t_and_m_t":"rateMatchPatternToAddModList","paragraph_zero_based":27851},{"literal_text_all_w_t_and_m_t":"Resources patterns which the UE should rate match PDSCH around. The UE rate matches around the union of all resources indicated in the rate match patterns. Rate match patterns defined here on cell level apply only to PDSCH of the same numerology. See TS 38.214 [19], clause 5.1.4.1. If a RateMatchPattern with the same RateMatchPatternId is configured in both ServingCellConfig/ServingCellConfigCommon and in SIB20/MCCH, the entire RateMatchPattern configuration shall be the same, including the set of RBs/REs indicated by the patterns for the rate matching around, and they are counted as a single rate match pattern in the total configured rate match patterns as defined in TS 38.214 [19].","paragraph_zero_based":27852},{"literal_text_all_w_t_and_m_t":"sCellDeactivationTimer","paragraph_zero_based":27853},{"literal_text_all_w_t_and_m_t":"SCell deactivation timer in TS 38.321 [3]. If the field is absent, the UE applies the value infinity.","paragraph_zero_based":27854},{"literal_text_all_w_t_and_m_t":"sfnSchemePDCCH","paragraph_zero_based":27855},{"literal_text_all_w_t_and_m_t":"This parameter is used to configure SFN scheme for PDCCH: sfnSchemeA or sfnSchemeB as specified (see TS 38.214 [19], clause 5.1). If network includes both sfnSchemePDCCH and sfnSchemePDSCH, same value shall be configured.","paragraph_zero_based":27856},{"literal_text_all_w_t_and_m_t":"sfnSchemePDSCH","paragraph_zero_based":27857},{"literal_text_all_w_t_and_m_t":"This parameter is used to configure SFN scheme for PDSCH: sfnSchemeA or sfnSchemeB as specified (see TS 38.214 [19], clause 5.1). If network includes both sfnSchemePDCCH and sfnSchemePDSCH, same value shall be configured. The network does not configure this parameter and repetitionSchemeConfig in PDSCH-Config simultaneously in the same serving cell.","paragraph_zero_based":27858},{"literal_text_all_w_t_and_m_t":"semiStaticChannelAccessConfigUE","paragraph_zero_based":27859},{"literal_text_all_w_t_and_m_t":"When this field is configured and when channelAccessMode-r16 (see IE ServingCellConfigCommon and IE ServingCellConfigCommonSIB) is configured to semiStatic, the UE operates in semi-static channel access mode and can initiate a channel occupancy periodically (see TS 37.213 [48], Clause 4.3).","paragraph_zero_based":27860},{"literal_text_all_w_t_and_m_t":"The period can be configured independently from period configured in SemiStaticChannelAccessConfig-r16 if the UE indicates the corresponding capability. Otherwise, the periodicity configured by periodUE-r17 is an integer multiple of or an integer factor of the periodicity indicated by period in SemiStaticChannelAccessConfig-r16.","paragraph_zero_based":27861},{"literal_text_all_w_t_and_m_t":"servingCellMO","paragraph_zero_based":27862},{"literal_text_all_w_t_and_m_t":"measObjectId of the MeasObjectNR in MeasConfig which is associated to the serving cell. For this MeasObjectNR, the following relationship applies between this MeasObjectNR and frequencyInfoDL in ServingCellConfigCommon of the serving cell: if ssbFrequency is configured, its value is the same as the absoluteFrequencySSB and if csi-rs-ResourceConfigMobility is configured, the value of its subcarrierSpacing is present in one entry of the scs-SpecificCarrierList, csi-RS-CellListMobility includes an entry corresponding to the serving cell (with cellId equal to physCellId in ServingCellConfigCommon) and the frequency range indicated by the csi-rs-MeasurementBW of the entry in csi-RS-CellListMobility is included in the frequency range indicated by in the entry of the scs-SpecificCarrierList.","paragraph_zero_based":27863}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["be2740c23e579ca4a37d7a9e99a82efbc02269611eb4b01e46324972e06dec0d","8d6190d83631ea71a594145a292afcf6412cc0f4867b752c4e5a7214c718ced2","ed2c72ecd4b52c5628ae78c52ae0f36eb7f7667e26f57171ef9c7917269a487f","55231cecc5b4e1ad5ea21c7146bd5602f9a313f7384cb4d411927c28466608c9","cf36baf424b9dd7abf350382c67819d0117324d75eb6bf6dd42ecf9d2e0447db","0f6a655faf106a382eedba56b69497047e69dd02917b85204385c358ae5fa110","75ef27b6110eb1235d6e04640933676eabef011479eddf3c560c49f055b8afe8","f66620ad7e23201c5193425919ef4f2ad5c4f8533fe7c3319fee99ea33abc994","dfc64baa046153d89db3d9612439c6eb617e47b1d0e93e9a82a99c61004a76d1","9686a16ad9b291fee5e9bb2f31d101f91020bcc9b58b6dcde53d1d7b9c0d4341","439e526976a362047f8825c5d6cb4abb867c0252cf3ee1efac15d46318f2555f","cde3abbb7b20c139338186300a8f7460ef7d2e3c2eeb2bb65a0901061ae7236a","6e79e85e920397e9feb05203cc51550caa285ba075c507cf20e1c3e60bf9dde6","3287aad0921e5c52b500ed73730e7639a2a5554427fd570bdb8a4fa53e8d8fe8","27bdca081c0765cac2c88f1d3128b6e4b47f0032056d797fcbab3a68d04970f0","5b7e4fa760c4954d66bf62a6542fd7afdcc8b5e3aacbbf60283b12bf462612e2","365dac3cd39fe7b0cafd6f4dcd3da0cc809a50d0932bbafe688b9c9c0f25d533","39065c3ce4f7bcb28b07c3c35e6e49e283b7f1e6bb5ac87f946390a45b0d0d0a","a3e408ece97bc5415aa6c65c522934e9310f1e6f57d5d35aed0a9483af2a72a2","b018fbda803c24a7819cba1136268009f8711b1a78e8ef1553667c057a60aae4","81e0f335f34af0f55cb39aee263a1afce98101eb53e28755f63f87e44fa99f13","522d3e6102cc3130bacbd607b65393c21032bc06c871c5b34c0f14a97e3b7933","611ab3aac85c310453bf0da3f8b0126f722ad540c89b5f0911f966a21de93d06","e66b6c0cbdb9defd2f3b751b7389529595dcee06463ffec4e7df45d36c767cde"],"paragraph_range_zero_based":[27840,27863],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p27840"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"supplementaryUplink","paragraph_zero_based":27864},{"literal_text_all_w_t_and_m_t":"Network may configure this field only when supplementaryUplinkConfig is configured in ServingCellConfigCommon or supplementaryUplink is configured in ServingCellConfigCommonSIB.","paragraph_zero_based":27865},{"literal_text_all_w_t_and_m_t":"supplementaryUplinkRelease","paragraph_zero_based":27866},{"literal_text_all_w_t_and_m_t":"If this field is included, the UE shall release the uplink configuration configured by supplementaryUplink. The network only includes either supplementaryUplinkRelease or supplementaryUplink at a time.","paragraph_zero_based":27867},{"literal_text_all_w_t_and_m_t":"tag-Id","paragraph_zero_based":27868},{"literal_text_all_w_t_and_m_t":"Timing Advance Group ID, as specified in TS 38.321 [3], which this cell belongs to.","paragraph_zero_based":27869},{"literal_text_all_w_t_and_m_t":"tci-ActivatedConfig","paragraph_zero_based":27870},{"literal_text_all_w_t_and_m_t":"If configured for an SCell, or if configured for the PSCell when the SCG is being activated upon the reception of the containing message, the UE shall consider the TCI states provided in this field as the activated TCI states for PDCCH/PDSCH reception on this serving cell.","paragraph_zero_based":27871},{"literal_text_all_w_t_and_m_t":"If configured for the PSCell when the SCG is indicated as deactivated in the containing message:","paragraph_zero_based":27872},{"literal_text_all_w_t_and_m_t":"- the UE shall consider the TCI states provided in this field as the TCI states to be activated for PDCCH/PDSCH reception upon a later SCG activation in which tci-ActivatedConfig is absent","paragraph_zero_based":27873},{"literal_text_all_w_t_and_m_t":"- if bfd-and-RLM is configured and no RS is configured in RadioLinkMonitoringConfig for RLM, respectively for BFD, the UE shall use the TCI states provided in this field for PDCCH as RS for RLM, respectively for BFD.","paragraph_zero_based":27874},{"literal_text_all_w_t_and_m_t":"When this field is absent for the PSCell and the SCG is being deactivated:","paragraph_zero_based":27875},{"literal_text_all_w_t_and_m_t":"- the UE shall consider the previously activated TCI states as the TCI states to be activated for PDCCH/PDSCH reception upon a later SCG activation in which tci-ActivatedConfig is absent","paragraph_zero_based":27876},{"literal_text_all_w_t_and_m_t":"- if bfd-and-RLM is configured and no RS is configured in RadioLinkMonitoringConfig for RLM, respectively for BFD, the UE shall use the previously activated TCI states for PDCCH as RS for RLM, respectively for BFD.","paragraph_zero_based":27877},{"literal_text_all_w_t_and_m_t":"tdd-UL-DL-ConfigurationDedicated-IAB-MT","paragraph_zero_based":27878},{"literal_text_all_w_t_and_m_t":"Resource configuration per IAB-MT D/U/F overrides all symbols (with a limitation that effectively only flexible symbols can be overwritten in Rel-16) per slot over the number of slots as provided by TDD-UL-DL ConfigurationCommon.","paragraph_zero_based":27879},{"literal_text_all_w_t_and_m_t":"unifiedTCI-StateType","paragraph_zero_based":27880},{"literal_text_all_w_t_and_m_t":"Indicates the unified TCI state type the UE is configured for this serving cell. The value separate means this serving cell is configured with dl-OrJointTCI-StateList for DL TCI state and ul-TCI-ToAddModList for UL TCI state. The value joint means this serving cell is configured with dl-OrJointTCI-StateList for joint TCI state for UL and DL operation. The network does not configure the field in a serving cell that is configured with more than one value for the coresetPoolIndex.","paragraph_zero_based":27881},{"literal_text_all_w_t_and_m_t":"uplinkConfig","paragraph_zero_based":27882},{"literal_text_all_w_t_and_m_t":"Network may configure this field only when uplinkConfigCommon is configured in ServingCellConfigCommon or ServingCellConfigCommonSIB. Addition or release of this field can only be done upon SCell addition or release (respectively).","paragraph_zero_based":27883},{"literal_text_all_w_t_and_m_t":"uplink-PowerControlToAddModList","paragraph_zero_based":27884},{"literal_text_all_w_t_and_m_t":"Configures UL power control parameters for PUSCH, PUCCH and SRS when field unifiedTCI-StateType is configured for this serving cell.","paragraph_zero_based":27885},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27886},{"literal_text_all_w_t_and_m_t":"UplinkConfig field descriptions","paragraph_zero_based":27887}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["b1d4b27aded1d274f97f83b722f8a47551a8ca827ded2494857adcd1bb2f51f9","9e7acc80548d851abb77dee39788d8004ecb5a15208465bc5ad280aba8fcaac4","63bad9b0252ed1d7c03081ef5d642cd6f1287ca5bd9542f8e9d8b6ac46480781","64d7e0fb74c3d968dda5eb0d8bcd7ed29f04308b2d0a6a58fe525d8a620d1184","c631e1eb0d12ad97252e3c61a5716e7228e67392baa00b5dca1157b1846e694c","fce833ab9bc707d4bfeddae8e2b6dd2566eca6fc768d8d8fb922cb951c8c509b","1da677e13b2e826edd8f532a8636e40ae3ae2341bc9612d9f0b8eb98ce2b0a66","27aa6681b0bbc2eb3f656ce6b14c17a47f6faf43115eb7dab0aa386330181ca2","cf5aa4cab173ff11a3541306f954944c0df0ee3aa2d0c8cdb7f746dcdaab73b3","f593072667d7900455a03cc0f13f8ddc27ad54d3587fd4090e93f01910a00a57","a0fd290f3974fea600cd23ae4ea0ecddd24af2121d4016017d0729028d1e0968","1735adc3261d51205c48d5c214b8d35e8eff16e18d8dea59d560f3973d79c72f","8925d5bc21bc6cd41aa7c30f7e10089050565891bfad0dc996ef1e02e6f9d65b","a59033f5743dbcb38146adcefd43de0d55731678ff9ac5fc9a0b730a7c1ac777","5d4114d79b181c5d09164380957556944416623d9852593095b6eb69d48d2936","9f289049d0d56df8c3e0a68333b1501057e1e422c2b43603e028b1879f9bbb4b","7dac7f9cb516138f08cdfc8e9b5d616efdc76ca24841b1dea6301619f468f28f","afd2524f94a38ad654a758532cf36c96c871511768c116bce2edb486e4bac634","48ac4e24d43cecda9e34558f5e252be2c7a017eca5c483cf0f68e2ff1003cbb1","532914636b2b3efa3e72139793244a759b6d46cd784bc41b1fbacf115b0843ea","ec6d3295f045c0c42c5b5f1be9ec103a4b70fff6479fdf7ffec625bcf0c4ecde","fbc4f70ed875f58bbe83e241a18d619ac5dc80b15a99c87141e11bac2a97f944","dc462f09a6f9454275aaf03f96aed15a7006602643a1461d602e489b9fd059ce","7f39b215da1d7cd75e200f0b423236f5fc5fa8828d86da17f4731085d51818ab"],"paragraph_range_zero_based":[27864,27887],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p27864"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"carrierSwitching","paragraph_zero_based":27888},{"literal_text_all_w_t_and_m_t":"Includes parameters for configuration of carrier based SRS switching (see TS 38.214 [19], clause 6.2.1.3.","paragraph_zero_based":27889},{"literal_text_all_w_t_and_m_t":"enableDefaultBeamPL-ForPUSCH0-0, enableDefaultBeamPL-ForPUCCH, enableDefaultBeamPL-ForSRS","paragraph_zero_based":27890},{"literal_text_all_w_t_and_m_t":"When the parameter is present, UE derives the spatial relation and the corresponding pathloss reference Rs as specified in 38.213, clauses 7.1.1, 7.2.1, 7.3.1 and 9.2.2. The network only configures these parameters for FR2.","paragraph_zero_based":27891},{"literal_text_all_w_t_and_m_t":"enablePL-RS-UpdateForPUSCH-SRS","paragraph_zero_based":27892},{"literal_text_all_w_t_and_m_t":"When this parameter is present, the Rel-16 feature of MAC CE based pathloss RS updates for PUSCH/SRS is enabled. Network only configures this parameter when the UE is configured with sri-PUSCH-PowerControl. If this field is not configured, network configures at most 4 pathloss RS resources for PUSCH/PUCCH/SRS transmissions per BWP, not including pathloss RS resources for SRS transmissions for positioning. (See TS 38.213 [13], clause 7).","paragraph_zero_based":27893},{"literal_text_all_w_t_and_m_t":"firstActiveUplinkBWP-Id","paragraph_zero_based":27894},{"literal_text_all_w_t_and_m_t":"If configured for an SpCell, this field contains the ID of the UL BWP to be activated upon performing the RRC (re-)configuration. If the field is absent, the RRC (re-)configuration does not impose a BWP switch.","paragraph_zero_based":27895},{"literal_text_all_w_t_and_m_t":"If configured for an SCell, this field contains the ID of the uplink bandwidth part to be used upon activation of an SCell. The initial bandwidth part is referred to by BandiwdthPartId = 0.","paragraph_zero_based":27896},{"literal_text_all_w_t_and_m_t":"initialUplinkBWP","paragraph_zero_based":27897},{"literal_text_all_w_t_and_m_t":"The dedicated (UE-specific) configuration for the initial uplink bandwidth-part (i.e. UL BWP#0). If any of the optional IEs are configured within this IE as part of the IE uplinkConfig, the UE considers the BWP#0 to be an RRC configured BWP (from UE capability viewpoint). Otherwise, the UE does not consider the BWP#0 as an RRC configured BWP (from UE capability viewpoint). Network always configures the UE with a value for this field if no other BWPs are configured. NOTE1","paragraph_zero_based":27898},{"literal_text_all_w_t_and_m_t":"moreThanOneNackOnlyMode","paragraph_zero_based":27899},{"literal_text_all_w_t_and_m_t":"Indicates the mode of NACK-only feedback in the PUCCH transmission, as specified in TS 38.213 [13], clause 18. If multicast CFR is not configured, this field is not included. Otherwise, if the field is absent, UE uses mode 1 for multicast CFR.","paragraph_zero_based":27900},{"literal_text_all_w_t_and_m_t":"mpr-PowerBoost-FR2","paragraph_zero_based":27901},{"literal_text_all_w_t_and_m_t":"Indicates whether UE is allowed to boost uplink transmission power by suspending in-band emission (IBE) requirements as specified in TS 38.101-2 [39]. Network only configures this field for FR2 serving cells.","paragraph_zero_based":27902},{"literal_text_all_w_t_and_m_t":"powerBoostPi2BPSK","paragraph_zero_based":27903},{"literal_text_all_w_t_and_m_t":"If this field is set to true, the UE determines the maximum output power for PUCCH/PUSCH transmissions that use pi/2 BPSK modulation according to TS 38.101-1 [15], clause 6.2.4.","paragraph_zero_based":27904},{"literal_text_all_w_t_and_m_t":"pusch-ServingCellConfig","paragraph_zero_based":27905},{"literal_text_all_w_t_and_m_t":"PUSCH related parameters that are not BWP-specific.","paragraph_zero_based":27906},{"literal_text_all_w_t_and_m_t":"uplinkBWP-ToAddModList","paragraph_zero_based":27907},{"literal_text_all_w_t_and_m_t":"The additional bandwidth parts for uplink to be added or modified. In case of TDD uplink- and downlink BWP with the same bandwidthPartId are considered as a BWP pair and must have the same center frequency.","paragraph_zero_based":27908},{"literal_text_all_w_t_and_m_t":"uplinkBWP-ToReleaseList","paragraph_zero_based":27909},{"literal_text_all_w_t_and_m_t":"The additional bandwidth parts for uplink to be released.","paragraph_zero_based":27910},{"literal_text_all_w_t_and_m_t":"uplinkChannelBW-PerSCS-List","paragraph_zero_based":27911}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["2eb22bde57947e6d04db56607a197a4ff1dfef2d4309e0a287f8660f677f1299","74080137aedd3a5ed510e375bf03b1fdba94814fa722bc6804d72fa4b114b98e","8e666c5ca825ce7245e080bc04e87943de7af9d4f813f69261e7a4d7c4208f28","10b5babf2ec95f9727d50e2bd3234fd974f000169b2ea430752e81d6cedbae03","ba53abdf20dfd81e469491a617c3c972178553114d185927cfcafb4559d36350","0c824114f2ab6689b5523c7d50619e4f020d47816942b796178c379c88464eae","a65b0b71c0846018513bf42a752724fbef26cbe2cc7dac37fbd64a290ae0aef0","dd1fc64320a42c62bdfa599bd1eb668a638ab734bd8f9a8540cf83cc9b03130d","5d20c64c770a8e33bd9ecfba450c638c97b66e3695ffdca23a9e5a1694cdf846","4b7c7bc067a4ce05cbb2f16525fc17e98bcdcb2e69947a7c559cf2732e5d2a30","7b9c6e84c6074cc8f19fe0092c3e5b35575aa43196289b4ec153c7a4964ff1c9","956e7c24949e81f233b21531f1323d9fcd0bc71ae04ab59debb28af172ed5fef","9db685f86ea2848a328ee25feede0b6a5eaabac2de3b659569d4a7f65c01aea9","615185902548e5f677fd3c6cbf4ff4ea8d151b1cfed8644e5f8aabbcdf75e8d0","9802b9ff79287766473b24204aae9f2d67aa478baf3871135ac2bdfb92b6ac06","71f6ffceea3fc633382b3537ec9e61e4233c4da30550c49298c1bed9ef62d38a","86be55b0da8188cdfa33d63faa2b75fbf0d560e19de27332a89ae1ce3879b52d","c910fa54d1beb9b8f3f9df97cc056092e5eef8a15a85d11dff195f424a6e2cf7","b3bc44b99348b1728c7fb1fd3162c196f1585f4fa3a263ccc9ba6258d1eb72c0","09d8c77ebccd9625a41c0839d1439e0c1e7c7227c301cc6ace99f8f3e1eb0d9d","3354f13add41c485a525f087ef45a93fa3fdb91faba9df669edd2a49a97a6911","a5fe02f509539ffd800acefc2116f38f618bb1c959dbb33058196f68731ded1e","7b070efb76c3d89babd08b9c1cc84ba27ab9a6d9de15885a9a4f598928749dc0","189368b16c9babc030656d4d17e1247f7ca9f100abc0c21832ef6bbc0ed73f05"],"paragraph_range_zero_based":[27888,27911],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p27888"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"A set of UE specific channel bandwidth and location configurations for different subcarrier spacings (numerologies). Defined in relation to Point A. The UE uses the configuration provided in this field only for the purpose of channel bandwidth and location determination. If absent, UE uses the configuration indicated in scs-SpecificCarrierList in UplinkConfigCommon / UplinkConfigCommonSIB. Network only configures channel bandwidth that corresponds to the channel bandwidth values defined in TS 38.101-1 [15], TS 38.101-2 [39], and TS 38.101-5 [75].","paragraph_zero_based":27912},{"literal_text_all_w_t_and_m_t":"uplinkTxSwitchingPeriodLocation","paragraph_zero_based":27913},{"literal_text_all_w_t_and_m_t":"Indicates whether the location of UL Tx switching period is configured in this uplink carrier in case of inter-band UL CA, SUL, or (NG)EN-DC, as specified in TS 38.101-1 [15] and TS 38.101-3 [34].","paragraph_zero_based":27914},{"literal_text_all_w_t_and_m_t":"In case of (NG)EN-DC, network always configures this field to TRUE for NR carrier (i.e. with (NG)EN-DC, the UL switching period always occurs on the NR carrier).","paragraph_zero_based":27915},{"literal_text_all_w_t_and_m_t":"In case of inter-band UL CA or SUL, for dynamic uplink Tx switching between 2 bands with 2 uplink carriers or 3 uplink carriers as defined in TS 38.101-1 [15], network configures this field to TRUE for the uplink carrier(s) on one band and configures this field to FALSE for the uplink carrier(s) on the other band. This field is set to the same value for the carriers on the same band.","paragraph_zero_based":27916},{"literal_text_all_w_t_and_m_t":"uplinkTxSwitchingCarrier","paragraph_zero_based":27917},{"literal_text_all_w_t_and_m_t":"Indicates that the configured carrier is carrier1 or carrier2 for dynamic uplink Tx switching, as defined in TS 38.101-1 [15] and TS 38.101-3 [34]. In case of (NG)EN-DC, network always configures the NR carrier as carrier 2.","paragraph_zero_based":27918},{"literal_text_all_w_t_and_m_t":"In case of inter-band UL CA or SUL, for dynamic uplink Tx switching between 2 bands with 2 uplink carriers or 3 uplink carriers as defined in TS 38.101-1 [15], network configures the uplink carrier(s) on one band as carrier1 and the uplink carrier(s) on the other band as carrier2. This field is set to the same value for the carriers on the same band.","paragraph_zero_based":27919},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27920},{"literal_text_all_w_t_and_m_t":"DormantBWP-Config field descriptions","paragraph_zero_based":27921},{"literal_text_all_w_t_and_m_t":"dormancyGroupWithinActiveTime","paragraph_zero_based":27922},{"literal_text_all_w_t_and_m_t":"This field contains the ID of an SCell group for Dormancy within active time, to which this SCell belongs. The use of the Dormancy within active time for SCell groups is specified in TS 38.213 [13].","paragraph_zero_based":27923},{"literal_text_all_w_t_and_m_t":"dormancyGroupOutsideActiveTime","paragraph_zero_based":27924},{"literal_text_all_w_t_and_m_t":"This field contains the ID of an SCell group for Dormancy outside active time, to which this SCell belongs. The use of the Dormancy outside active time for SCell groups is specified in TS 38.213 [13].","paragraph_zero_based":27925},{"literal_text_all_w_t_and_m_t":"dormantBWP-Id","paragraph_zero_based":27926},{"literal_text_all_w_t_and_m_t":"This field contains the ID of the downlink bandwidth part to be used as dormant BWP. If this field is configured, its value is different from defaultDownlinkBWP-Id, and at least one of the withinActiveTimeConfig and outsideActiveTimeConfig should be configured.","paragraph_zero_based":27927},{"literal_text_all_w_t_and_m_t":"firstOutsideActiveTimeBWP-Id","paragraph_zero_based":27928},{"literal_text_all_w_t_and_m_t":"This field contains the ID of the downlink bandwidth part to be activated when receiving a DCI indication for SCell dormancy outside active time.","paragraph_zero_based":27929},{"literal_text_all_w_t_and_m_t":"firstWithinActiveTimeBWP-Id","paragraph_zero_based":27930},{"literal_text_all_w_t_and_m_t":"This field contains the ID of the downlink bandwidth part to be activated when receiving a DCI indication for SCell dormancy within active time.","paragraph_zero_based":27931},{"literal_text_all_w_t_and_m_t":"outsideActiveTimeConfig","paragraph_zero_based":27932},{"literal_text_all_w_t_and_m_t":"This field contains the configuration to be used for SCell dormancy outside active time, as specified in TS 38.213 [13]. The field can only be configured when the cell group the SCell belongs to is configured with dcp-Config.","paragraph_zero_based":27933},{"literal_text_all_w_t_and_m_t":"withinActiveTimeConfig","paragraph_zero_based":27934},{"literal_text_all_w_t_and_m_t":"This field contains the configuration to be used for SCell dormancy within active time, as specified in TS 38.213 [13]. ","paragraph_zero_based":27935}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["40c3a3facdbd62867f0a938940d064e436325dde38a54e54712f797355d9d3e2","0b3be7907bf4e208f8cdafeab875a4d09ae3979ff93b2519b15e9eb81711caa1","90e7b33b90759a7d2bf86d57b0fa47395ff163f465baac3bac601a46a316618d","2a7e71aaa6bf5f0098e1aaf53a6a774ad3f931b41c40fe9478a67e4cd88b26ad","03461f569d4c423b4490db62a0acc3ac39eacdb8172683fa80d34e1d2d2962ae","f7b5cdc09fd15d5e73ed8603c526ca1cf4c06007f2634fd541b7419f90f35130","af33b769acff9555787f1755a7f1cf27bb13ab28541293be2d0f83eb2e37dc87","6c04fdaf920bf39325792586040f95679f57fe46a8310c386872a256603bf1fc","08f3b0e86a7bf5f3992b6979974903035d2a0f9b7e99f77d4b68eae69cd6ee2f","9a5451f610b55cc9434fddbc621cb61829856fa1088a201ad152254d628ebf28","1267d170ae28976642bd3d32dfb14e70bbb241f69277404c884c74fb1b63185e","5850be754024d547bfc9e669325e0adf2c86c1af7d48a7e75a33d4685cdff17e","a27a524e6f978a9c6aeafc9b9deb4fd156eedce31cf7ad9e2838a6adeca61349","33a8656b2e8a7323d0d599ad4016f99de29f6ce4ad083553f9305b255d0c08c8","f6451057febff896c5dd50a19d796aaaa5dad5bd9174584b6e7f1f9c8265421d","e4373741260a48c4be0aa7dcad8fd6941904af677bec15cc5085cf840366728e","a19e4cc2e076cdf995edd9322c6eca95d8e4db765f403708976b5dd392e75aa7","3044a5944a6a6760c18b9fbe071126a8f58e58ed9b36e6e27fac917c9c3a444f","e4c06e09e4a153e221dc27ffb096c63992c992a51b754253aeafd657946d6b2a","3112e71d220abdf8e58b1dc2533c4beca2682a15e67d75d599162a60d7599d46","86464eeb713baabfbf5c3a6ea6c93f6d6d9fe525159310ee479a859c3f997919","eca12533fa0e881e688db83f4ad80c25aa8466b69db11df7102eee4ec017510e","c1079335a3fbc6fd99eceb0a296c6a57fc4198664f660c10f00a19a45c369b97","1ed49b3d563d9b842ead0301ca1e091eb2c4026dbd5ae5994590b404c723f7e5"],"paragraph_range_zero_based":[27912,27935],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p27912"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27936},{"literal_text_all_w_t_and_m_t":"GuardBand field descriptions","paragraph_zero_based":27937},{"literal_text_all_w_t_and_m_t":"startCRB","paragraph_zero_based":27938},{"literal_text_all_w_t_and_m_t":"Indicates the starting RB of the guard band.","paragraph_zero_based":27939},{"literal_text_all_w_t_and_m_t":"nrofCRB","paragraph_zero_based":27940},{"literal_text_all_w_t_and_m_t":"Indicates the length of the guard band in RBs. When set to 0, zero-size guard band is used.","paragraph_zero_based":27941},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27942},{"literal_text_all_w_t_and_m_t":"NOTE 1:If the dedicated part of initial UL/DL BWP configuration is absent, the initial BWP can be used but with some limitations. For example, changing to another BWP requires RRCReconfiguration since DCI format 1_0 doesn't support DCI-based switching.","paragraph_zero_based":27943},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27944},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":27945},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":27946},{"literal_text_all_w_t_and_m_t":"AsyncCA","paragraph_zero_based":27947},{"literal_text_all_w_t_and_m_t":"This field is mandatory present for SCells whose slot offset between the SpCell is not 0. Otherwise it is absent, Need S.","paragraph_zero_based":27948},{"literal_text_all_w_t_and_m_t":"MeasObject","paragraph_zero_based":27949},{"literal_text_all_w_t_and_m_t":"This field is mandatory present for the SpCell if the UE has a measConfig, and it is optionally present, Need M, for SCells. For RedCap UEs, this field is optionally present, Need M.","paragraph_zero_based":27950},{"literal_text_all_w_t_and_m_t":"SCellOnly","paragraph_zero_based":27951},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, for SCells. It is absent otherwise. ","paragraph_zero_based":27952},{"literal_text_all_w_t_and_m_t":"ServingCellWithoutPUCCH","paragraph_zero_based":27953},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need S, for SCells except PUCCH SCells. It is absent otherwise.","paragraph_zero_based":27954},{"literal_text_all_w_t_and_m_t":"SyncAndCellAdd","paragraph_zero_based":27955},{"literal_text_all_w_t_and_m_t":"This field is mandatory present for a SpCell upon reconfiguration with reconfigurationWithSync and upon RRCSetup/RRCResume.","paragraph_zero_based":27956},{"literal_text_all_w_t_and_m_t":"The field is optionally present for an SpCell, Need N, upon reconfiguration without reconfigurationWithSync.","paragraph_zero_based":27957},{"literal_text_all_w_t_and_m_t":"The field is mandatory present for an SCell upon addition, and absent for SCell in other cases, Need M.","paragraph_zero_based":27958},{"literal_text_all_w_t_and_m_t":"TCI_ActivatedConfig","paragraph_zero_based":27959}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["57d8f063dd4cf74bc353b667c36acb05c56d4cee15e83ac8eaa64f87306b7495","1969278246452c404d3784eb76449013f06dc1b730c5c92736e010ebfe37ba21","7fff6a942849a73d90197ed12c14f142747b81fc1c4fa27d425397f316e13dec","465d65c9669da03749e64fe0293dcddb61f9970fec968f68b01123459d69f810","022ca2ed4d97a3412f68a2c09d2d1a22a7d150df2487eb872ace1662a8cbb029","994d5d64cfbdc1d935aa2cb1f771f33bea9a2b7d62d56bb4b1363fa117b1b1f2","cb5fe567c6d38b9a6924b754a57c41a011b112c08dc633fa3dabe397a900da35","89c2035c31bfa16591ebd748e9aa19e3640d3f948aa52492f43202a196490638","7a602998ea21338d94f7000103c464583b5049fb3499bb9f44ab0d272f75b8f5","74beefc9f9526c1101f28d94ffda095e6c2a959cbd0c5ac7ce862ffd7634856c","3705bd62fa3061a7f7fb1324e70318b7b4d1a55789ae3eae48dac4d49fe4f53f","0f3fdb37be042cf9b3f255b90a3450e812ee7b633b7fbaa0f44445266a1e8859","bbf3efe61da14916f7669c472382ef6f208897160287e6ddcd99fdeef54ce5bd","9346682d8b3c13637dc540412a51bda5e362861fa5eab2f1c8db1e832a25beb1","02c7c49c37531385cbaa611060697b64e775aa25631ad1980e89ecd042b89799","b1fa5f3b8c3122d36298d2421f1f793c5b8cbaa3b3b1776caaf1735133cd0002","ff023bc3f978b91645b687aed40df1369bf4f453e4c7c76cd6e8ab6fe9e4cef5","091a676af20bc3f16293015cb27c2a78337af1f2415222a94fb8c36907c93296","08bdcc2de5a208bfb11fdec864955cf98e547593382521ab538d7eb1454add05","932a062102522d62bf59268095e9c0a1027e5c8dd6c7dcc89afe10272b88a9e9","880eae19c7b0e7c128495bac368c1b7a191f541db6f3d825150baa9b7554bc5c","1dfcfdbf4e3e7a5013f5473ec30294d0710a6f78f3e0adff4616bf59d27dcbdc","7390ff9af482d4f36e8bb79d856cdfd944a3003ec376d7e67c3f6d3e6363ea04","99ff8e06feb73ae63ea25eca68a19575849b8664c97b0348c75b3fbbf27c804e"],"paragraph_range_zero_based":[27936,27959],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p27936"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is optional Need N for SCells if sCellState is configured, otherwise it is absent.","paragraph_zero_based":27960},{"literal_text_all_w_t_and_m_t":"This field is optional Need S for the PSCell when the SCG is indicated as deactivated or is being activated, otherwise it is absent.","paragraph_zero_based":27961},{"literal_text_all_w_t_and_m_t":"This field is absent for the PCell.","paragraph_zero_based":27962},{"literal_text_all_w_t_and_m_t":"TDD","paragraph_zero_based":27963},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, for TDD cells. It is absent otherwise.","paragraph_zero_based":27964},{"literal_text_all_w_t_and_m_t":"TDD_IAB","paragraph_zero_based":27965},{"literal_text_all_w_t_and_m_t":"For IAB-MT, this field is optionally present, Need R, for TDD cells. It is absent otherwise.","paragraph_zero_based":27966},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27967},{"literal_text_all_w_t_and_m_t":"–ServingCellConfigCommon","paragraph_zero_based":27968},{"literal_text_all_w_t_and_m_t":"The IE ServingCellConfigCommon is used to configure cell specific parameters of a UE's serving cell. The IE contains parameters which a UE would typically acquire from SSB, MIB or SIBs when accessing the cell from IDLE. With this IE, the network provides this information in dedicated signalling when configuring a UE with a SCells or with an additional cell group (SCG). It also provides it for SpCells (MCG and SCG) upon reconfiguration with sync.","paragraph_zero_based":27969},{"literal_text_all_w_t_and_m_t":"ServingCellConfigCommon information element","paragraph_zero_based":27970},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27971},{"literal_text_all_w_t_and_m_t":"-- TAG-SERVINGCELLCONFIGCOMMON-START","paragraph_zero_based":27972},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27973},{"literal_text_all_w_t_and_m_t":"ServingCellConfigCommon ::=         SEQUENCE {","paragraph_zero_based":27974},{"literal_text_all_w_t_and_m_t":"    physCellId                          PhysCellId                                                          OPTIONAL,   -- Cond HOAndServCellAdd,","paragraph_zero_based":27975},{"literal_text_all_w_t_and_m_t":"    downlinkConfigCommon                DownlinkConfigCommon                                                OPTIONAL,   -- Cond HOAndServCellAdd","paragraph_zero_based":27976},{"literal_text_all_w_t_and_m_t":"    uplinkConfigCommon                  UplinkConfigCommon                                                  OPTIONAL,   -- Need M","paragraph_zero_based":27977},{"literal_text_all_w_t_and_m_t":"    supplementaryUplinkConfig           UplinkConfigCommon                                                  OPTIONAL,   -- Need S","paragraph_zero_based":27978},{"literal_text_all_w_t_and_m_t":"    n-TimingAdvanceOffset               ENUMERATED { n0, n25600, n39936 }                                   OPTIONAL,   -- Need S","paragraph_zero_based":27979},{"literal_text_all_w_t_and_m_t":"    ssb-PositionsInBurst                CHOICE {","paragraph_zero_based":27980},{"literal_text_all_w_t_and_m_t":"        shortBitmap                         BIT STRING (SIZE (4)),","paragraph_zero_based":27981},{"literal_text_all_w_t_and_m_t":"        mediumBitmap                        BIT STRING (SIZE (8)),","paragraph_zero_based":27982},{"literal_text_all_w_t_and_m_t":"        longBitmap                          BIT STRING (SIZE (64))","paragraph_zero_based":27983}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["188abac9b1a31ecae0b88dbe77241de70ea83c3e68d1bb6df82aff967cbd3918","241407b4a3181361eaec3eb9725ad4f11f03c53dd479b4b3b2d3f456c3a5fa77","94de0d4edd50646d68d6c812b55dd5f6069e6ab31ed83ec8a62bcc4f2631a3d4","f77733f384d8d9198b7f197e12ee898f931db549ec2312e7a018fb85caf1f417","7dfefc985a4fa2a37e2f5d52160761d77f17e84a028e4622c9407313a815d6a2","819a76746396cbed51ebab4cb59154bb682e54ff73ed43b3d9080061055b8421","3f27e36649f5f1f000c5db5c94a741ab28c877efa843221caec991c9d989fc32","a2e378d5f0bad05dec4773bfbed092cc38e255e320dfec2fb3beafafca1c6adb","a137bf1687142d4c4afe65e6ad050eaf9d3ed5531405856db995f89c01032804","f607df8c23c75b23f9297f243453e1bdb98692337bfd8e244bf0ddd1a31541fe","ed92cbf4c6794adc1c9c8e476f6848cd21face38793ebe0a06c26e77ea44e613","9d162b9d39254412984c3bb6dca142bf361ee44cb7c2e96b5a7696d318356100","8526e4f7f8cdf1468f657c4c60bccd4f6564a2de422c5b6f759140a4df799e59","16c9d10329a4cfaf6a5cd03c8923fa96ba4a675922e248b2b32db11903d2a552","8ff58c37a54cf138be167b21350f2996c2e43ce8d252a5d46edbf41ca7bb364d","be57926b2eafde6915d0b28872844cc72ad30f03b6e92f76d2d52c7355cf87fa","502d0968a73f0a7f1a7a614c844519fdd0b58787f3b05f9114c8f75e87abed27","ed24fbb24ee6309aa39153e299a872cb3de7bf3aca84cd1898804a16d04f7060","b5feccec66d52903b0ae38dcc47b69313c7e599c14a45fe580df2587f9766121","4dedc1ace3ad3197bc5c1c993cb3539211104695cdd21b2bd03f6b72bcf35b82","72872281d208b94cc99078ebc3e2abcb171332fe4fb2b91d2e7039a4837ecd21","06d301073a70764d24ea5cdc623b4453d75bda2843d1bea1fe591d6d41b8a08e","21e3bbb0ddcd163996ce124289a078e08a67f60c23765ad0cee4301b9541174d","de2ef9c5a26ffc1272b7d58dc457c5cc32424f785e65915be734b357409a0f52"],"paragraph_range_zero_based":[27960,27983],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p27960"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    }                                                                                                       OPTIONAL, -- Cond AbsFreqSSB","paragraph_zero_based":27984},{"literal_text_all_w_t_and_m_t":"    ssb-periodicityServingCell          ENUMERATED { ms5, ms10, ms20, ms40, ms80, ms160, spare2, spare1 }   OPTIONAL, -- Need S","paragraph_zero_based":27985},{"literal_text_all_w_t_and_m_t":"    dmrs-TypeA-Position                 ENUMERATED {pos2, pos3},","paragraph_zero_based":27986},{"literal_text_all_w_t_and_m_t":"    lte-CRS-ToMatchAround               SetupRelease { RateMatchPatternLTE-CRS }                            OPTIONAL, -- Need M","paragraph_zero_based":27987},{"literal_text_all_w_t_and_m_t":"    rateMatchPatternToAddModList        SEQUENCE (SIZE (1..maxNrofRateMatchPatterns)) OF RateMatchPattern   OPTIONAL, -- Need N","paragraph_zero_based":27988},{"literal_text_all_w_t_and_m_t":"    rateMatchPatternToReleaseList       SEQUENCE (SIZE (1..maxNrofRateMatchPatterns)) OF RateMatchPatternId OPTIONAL, -- Need N","paragraph_zero_based":27989},{"literal_text_all_w_t_and_m_t":"    ssbSubcarrierSpacing                SubcarrierSpacing                                                   OPTIONAL, -- Cond HOAndServCellWithSSB","paragraph_zero_based":27990},{"literal_text_all_w_t_and_m_t":"    tdd-UL-DL-ConfigurationCommon       TDD-UL-DL-ConfigCommon                                              OPTIONAL, -- Cond TDD","paragraph_zero_based":27991},{"literal_text_all_w_t_and_m_t":"    ss-PBCH-BlockPower                  INTEGER (-60..50),","paragraph_zero_based":27992},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":27993},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":27994},{"literal_text_all_w_t_and_m_t":"    channelAccessMode-r16               CHOICE {","paragraph_zero_based":27995},{"literal_text_all_w_t_and_m_t":"        dynamic                             NULL,","paragraph_zero_based":27996},{"literal_text_all_w_t_and_m_t":"        semiStatic                          SemiStaticChannelAccessConfig-r16","paragraph_zero_based":27997},{"literal_text_all_w_t_and_m_t":"    }                                                                                                       OPTIONAL, -- Cond SharedSpectrum","paragraph_zero_based":27998},{"literal_text_all_w_t_and_m_t":"    discoveryBurstWindowLength-r16          ENUMERATED {ms0dot5, ms1, ms2, ms3, ms4, ms5}                   OPTIONAL, -- Need R","paragraph_zero_based":27999},{"literal_text_all_w_t_and_m_t":"    ssb-PositionQCL-r16                     SSB-PositionQCL-Relation-r16                                    OPTIONAL, -- Cond SharedSpectrum","paragraph_zero_based":28000},{"literal_text_all_w_t_and_m_t":"    highSpeedConfig-r16                     HighSpeedConfig-r16                                             OPTIONAL  -- Need R","paragraph_zero_based":28001},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":28002},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":28003},{"literal_text_all_w_t_and_m_t":"    highSpeedConfig-v1700               HighSpeedConfig-v1700                                               OPTIONAL, -- Need R","paragraph_zero_based":28004},{"literal_text_all_w_t_and_m_t":"    channelAccessMode2-r17              ENUMERATED {enabled}                                                OPTIONAL, -- Cond SharedSpectrum2","paragraph_zero_based":28005},{"literal_text_all_w_t_and_m_t":"    discoveryBurstWindowLength-r17      ENUMERATED {ms0dot125, ms0dot25, ms0dot5, ms0dot75, ms1, ms1dot25}  OPTIONAL, -- Need R","paragraph_zero_based":28006},{"literal_text_all_w_t_and_m_t":"    ssb-PositionQCL-r17                 SSB-PositionQCL-Relation-r17                                        OPTIONAL, -- Cond SharedSpectrum2","paragraph_zero_based":28007}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["6481371adc64d340a1efe2a58979df07e5bc859a2d5a79e60ed742d3432ab209","c06e9a013d91ede1d04799811f6ad81b6d5ed4f16f2bbbf62b3a60bc23265d0c","cbb495c5408581905eadbf8be3bf208e10220037cec717cb6fb3ece976d8e3e2","18c04b9a244344e99d9b8c14cb7db3bdd074f59a7da46833746b3f4ecc6b69fd","63a6f337b14f90ca09bfba52c2242d09eb1600206867eeb0e2338b449f67064c","bcf1331a120d165352c40af8854837852e6c88ea866cb413f72bf96ed57a7300","87523288824c4cf8954e70e1905c0d393973e24e08917869764b69200f7cfc96","436859122758fee062c179a0681924b0fef0126546c655299a7df04d38442ba2","547dd09a2594e338d2ea011814ad4ddf7a01ed23ca5f8a29515bbf2159ac644b","34bb7f1809deae5ffdefcc47d35e249b1a2c45dd4ca3c8b0ef5a428013073fd4","707dbf4567095de6ad697ced321e072233726b203dcefce4fae732bc466c3b8c","ffaf30d7c3274649329230693e062a35717ec53ea9a5220e16d80b0e6798fbb7","8fc6015907f8054090c313286eb82692ce08e19b3931b8e1ce32f207bb23e505","7a2b4dcdddf16c96bf7bfeacdf6d7a99c62bb63361885cec18e35b4af63ef2bc","2d038683434df857fe5c975ebb2813a8d6b6b46c51353f170d12f66209d9fffc","435e6adffa5a02117cdfcff8ac7e8833f562a20d768ab30345dfe5de59a5b7e1","10b26cc974ef89ed42b0cc051b6d4a7ced2e186b9f90b9f4e09cd4606b227445","b271f31822f799d40d6c2ea581f411d5937babfc61248a86055358b62ffef2cb","08d4ef00652c1f1dad7939337d045865658dbcb0716208923d7618934b969bb9","383a03370f54de1d11932cf5b35f4b415fe48f24116c3cd228fdc9aaefe00497","05ac1464d2d7c1cc8cb31637d2fa1a51aa093a3ef083de798fa1610f8fcc164d","d8b7d7146c0e8252feac291935663e1de34c8e171860894255592580ea23f8c6","4ae50ab2df944eb0ad78143dcbd3d2aca8792a56e7f474335a5550e6d539d771","9e209713f698aa8dc9938154fe2598564d103e33f5c44a61ed4a15952dfa3753"],"para