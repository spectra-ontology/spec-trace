{"fields":{"filename":"R2-2401316.zip::R2-2401316 BLE.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field specifies the Bluetooth primary advertisement channel periodicity that the device will use, scaling factor 0.625 ms [53].","paragraph_zero_based":336},{"literal_text_all_w_t_and_m_t":"secondAdvInterval","paragraph_zero_based":337},{"literal_text_all_w_t_and_m_t":"This field specifies the Bluetooth periodic advertising interval on secondary advertisement channels that the device will use, scaling factor 0.625 ms [53].","paragraph_zero_based":338},{"literal_text_all_w_t_and_m_t":"txPower","paragraph_zero_based":339},{"literal_text_all_w_t_and_m_t":"This field specifies the Bluetooth advertising TX power in dBm that the device will use.","paragraph_zero_based":340},{"literal_text_all_w_t_and_m_t":"cteLength","paragraph_zero_based":341},{"literal_text_all_w_t_and_m_t":"This field specifies the configured CTE length to be used by the device in number of 8us segments.","paragraph_zero_based":342},{"literal_text_all_w_t_and_m_t":"cteCount","paragraph_zero_based":343},{"literal_text_all_w_t_and_m_t":"This field specifies the number of Bluetooth packets that include a CTE that the device will transmit each periodic advertising. ","paragraph_zero_based":344},{"literal_text_all_w_t_and_m_t":"tx-PHY-M2","paragraph_zero_based":345},{"literal_text_all_w_t_and_m_t":"This field, if present and set to m2, indicates that Bluetooth TX PHY 2 Megasymbols/s will be used for AoA, otherwise Bluetooth TX PHY 1 Megasymbols/s will be used,","paragraph_zero_based":346},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":347},{"literal_text_all_w_t_and_m_t":"6.5.7.2Bluetooth Location Information Elements","paragraph_zero_based":348},{"literal_text_all_w_t_and_m_t":"–BT-MeasurementInformation","paragraph_zero_based":349},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":350},{"l