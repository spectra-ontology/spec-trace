{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    bds                         ENUMERATED {true}               OPTIONAL,","paragraph_zero_based":43920},{"literal_text_all_w_t_and_m_t":"    galileo                     ENUMERATED {true}               OPTIONAL,","paragraph_zero_based":43921},{"literal_text_all_w_t_and_m_t":"    wlan                        ENUMERATED {true}               OPTIONAL,","paragraph_zero_based":43922},{"literal_text_all_w_t_and_m_t":"    bluetooth                   ENUMERATED {true}               OPTIONAL","paragraph_zero_based":43923},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":43924},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43925},{"literal_text_all_w_t_and_m_t":"AffectedCarrierFreqCombEUTRA ::= SEQUENCE (SIZE (1..maxNrofServingCellsEUTRA)) OF ARFCN-ValueEUTRA","paragraph_zero_based":43926},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43927},{"literal_text_all_w_t_and_m_t":"AffectedCarrierFreqCombNR ::= SEQUENCE (SIZE (1..maxNrofServingCells)) OF ARFCN-ValueNR","paragraph_zero_based":43928},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43929},{"literal_text_all_w_t_and_m_t":"CandidateCellListCPC-r17 ::= SEQUENCE (SIZE (1..maxFreq)) OF CandidateCellCPC-r17","paragraph_zero_based":43930},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43931},{"literal_text_all_w_t_and_m_t":"CandidateCellCPC-r17 ::=           SEQUENCE {","paragraph_zero_based":43932},{"literal_text_all_w_t_and_m_t":"    ssbFrequency-r17                   ARFCN-ValueNR,","paragraph_zero_based":43933},{"literal_text_all_w_t_and_m_t":"    candidateCellList-r17              SEQUENCE (SIZE (1..maxNrofCondCells-r16)) OF PhysCellId","paragraph_zero_based":43934},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":43935},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43936},{"literal_text_all_w_t_and_m_t":"-- TAG-CG-CONFIG-INFO-STOP","paragraph_zero_based":43937},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":43938},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43939},{"literal_text_all_w_t_and_m_t":"CG-ConfigInfo field descriptions","paragraph_zero_based":43940},{"literal_text_all_w_t_and_m_t":"alignedDRX-Indication","paragraph_zero_based":43941},{"literal_text_all_w_t_and_m_t":"This field is signalled upon MN triggered CGI reporting by the UE that requires aligned DRX configurations between the MCG and the SCG (i.e. same DRX cycle and on-duration configured by MN completely contains on-duration configured by SN).","paragraph_zero_based":43942},{"literal_text_all_w_t_and_m_t":"allowedBC-ListMRDC","paragraph_zero_based":43943}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["73d0e631eebdfb1166cc62db4d551505aecf1d4b0ec131715bd78e833cecf866","fbd3e47865b52db15c128f4ff465a7df5c6b54ed0bc305b2f387ad4bd9995547","cd3cc52b25f6a477c9beb5eaf23342ef252a99becedbd0dc2666b592f31cdb75","e50107dd0728f3b48da68a89159d123ee5229bd329d662ef284e9cd876139ad1","adb2bdfa17ce9b62ff51090cfda43b475b918e5d5b44a763d71867ae5f666fe7","ce161feb8d4823b48570c10007b761ac9ac67b55d73d9b084a6ebe5313ccf285","1e6e4ffd1e3b8f3e84a2f669e04bcc7f0b43758dea6c03e61b00349f714c0c83","177e92ef44c6174f3b8f39068e3e4f0bbf0d1e0e59221bde5934fe4df974fe22","87b41f99afc236e70ff2d97b28356e878c2ee5e3afaf1a60d4d0b53b4e5dbfff","21ef6012c6ac8c12910b47786d1bbb5793502f211f048ce3ba4f353322ffed01","95946f9c62fdf07c89711d07cac83fe104663c70cce6abae3f4fa5707bc1556f","980f19ca4f596adba22ef867d8e3966dcbfce580a428ba8dde78974edf5decd1","b38c6bfc630111b8cc647b902cb9959d65d6a7275a8d7edee56afd189cff34f3","ee7d20d1c00c23529bceca0fae46ddea7c3a41fb168be611d9abfd310e1607d0","b2a67eca629b812f826975a65edc908a474d1c8d50b26c6ccf0ab1b6712a69ee","a48065029e3b075178c207db4f83cc69ab48e3216709a104e55dcba6b59db7ff","c1311b5759e07b24774c6e4b19952027251a6442ac913504a95030bfffacbc4b","ef87edfb844b59623762c0b8f15b5cdaf0305302478db1c5b700fe577acbc082","0a15655b8242194d47c34a12824c3f971f579c80b34c66e0c7232c78dfe471bc","26e62ec14f63953efe01d5f8b0b5ee7a7dd62eb700ac2ca424541fe15ce30e49","64935da74f07ab070db2564dac2b3dd78be2a1bd2060237b07c404b9ee3af566","0ee00920e9b3b90d47468383a6d13df56888ed2a465da7635864022a4e4bffbe","a6e2b03094ef7dbe26da44cc8d242fe795df7978f564ae98d36a6a6c098fda68","b9956a962db8e721c52c460a77cc303ae446800044cd59b5a7033f6766b48e81"],"paragraph_range_zero_based":[43920,43943],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p43920"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"A list of indices referring to band combinations in MR-DC capabilities from which SN is allowed to select the SCG band combination. Each entry refers to:","paragraph_zero_based":43944},{"literal_text_all_w_t_and_m_t":"- a band combination numbered according to supportedBandCombinationList and supportedBandCombinationList-UplinkTxSwitch in the UE-MRDC-Capability (in case of (NG)EN-DC), or according to supportedBandCombinationList and supportedBandCombinationListNEDC-Only in the UE-MRDC-Capability (in case of NE-DC), or according to supportedBandCombinationList in the UE-NR-Capability (in case of NR-DC),","paragraph_zero_based":43945},{"literal_text_all_w_t_and_m_t":"- and the Feature Sets allowed for each band entry. All MR-DC band combinations indicated by this field comprise the MCG band combination, which is a superset of the MCG band(s) selected by MN.","paragraph_zero_based":43946},{"literal_text_all_w_t_and_m_t":"allowedReducedConfigForOverheating","paragraph_zero_based":43947},{"literal_text_all_w_t_and_m_t":"Indicates the reduced configuration that the SCG is allowed to configure.","paragraph_zero_based":43948},{"literal_text_all_w_t_and_m_t":"reducedMaxCCs in allowedReducedConfigForOverheating indicates the maximum number of downlink/uplink PSCell/SCells that the SCG is allowed to configure. This field is used in (NG)EN-DC and NR-DC.","paragraph_zero_based":43949},{"literal_text_all_w_t_and_m_t":"reducedMaxBW-FR1 and reducedMaxBW-FR2 in allowedReducedConfigForOverheating indicates the maximum aggregated bandwidth across all downlink/uplink carriers of FR1 and FR2-1, respectively that the SCG is allowed to configure. reducedMaxBW-FR2-2 in allowedReducedConfigForOverheating-r17 indicates the maximum aggregated bandwidth across all downlink/uplink carriers of FR2-2 that the SCG is allowed to configure. This field is only used in NR-DC.","paragraph_zero_based":43950},{"literal_text_all_w_t_and_m_t":"reducedMaxMIMO-LayersFR1 and reducedMaxMIMO-LayersFR2 in allowedReducedConfigForOverheating indicates the maximum number of downlink/uplink MIMO layers of each serving cell operating on FR1 and FR2-1, respectively that the SCG is allowed to configure. reducedMaxMIMO-LayersFR2-2 in allowedReducedConfigForOverheating-r17 indicates the maximum number of downlink/uplink MIMO layers of each serving cell operating on FR2-2 that the SCG is allowed to configure. This field is only used in NR-DC.","paragraph_zero_based":43951},{"literal_text_all_w_t_and_m_t":"allowedResourceConfigNRDC","paragraph_zero_based":43952},{"literal_text_all_w_t_and_m_t":"Used to indicate the maximum number of resources reserved for the SCG. This field is only used in NR-DC.","paragraph_zero_based":43953},{"literal_text_all_w_t_and_m_t":"candidateCellInfoListMN, candidateCellInfoListSN","paragraph_zero_based":43954},{"literal_text_all_w_t_and_m_t":"Contains information regarding cells that the master node or the source node suggests the target gNB or DU to consider configuring. In case of MN initiated CPA or CPC, the field candidateCellInfoListMN contains information regarding cells that the MN suggests the candidate target secondary node to consider configuring for MN initiated CPA or CPC.","paragraph_zero_based":43955},{"literal_text_all_w_t_and_m_t":"For (NG)EN-DC, including CSI-RS measurement results in candidateCellInfoListMN is not supported in this version of the specification. For NR-DC, including SSB and/or CSI-RS measurement results in candidateCellInfoListMN is supported.","paragraph_zero_based":43956},{"literal_text_all_w_t_and_m_t":"candidateCellInfoListMN-EUTRA, candidateCellInfoListSN-EUTRA","paragraph_zero_based":43957},{"literal_text_all_w_t_and_m_t":"Includes the MeasResultList3EUTRA as specified in TS 36.331 [10]. Contains information regarding cells that the master node or the source node suggests the target secondary eNB to consider configuring. These fields are only used in NE-DC.","paragraph_zero_based":43958},{"literal_text_all_w_t_and_m_t":"candidateCellListCPC","paragraph_zero_based":43959},{"literal_text_all_w_t_and_m_t":"Contains information regarding cells that the source secondary node suggests the candidate target secondary node to consider configuring for SN initiated Conditional PSCell Change (CPC).","paragraph_zero_based":43960},{"literal_text_all_w_t_and_m_t":"configRestrictInfo","paragraph_zero_based":43961},{"literal_text_all_w_t_and_m_t":"Includes fields for which SgNB is explicitly indicated to observe a configuration restriction.","paragraph_zero_based":43962},{"literal_text_all_w_t_and_m_t":"drx-ConfigMCG","paragraph_zero_based":43963},{"literal_text_all_w_t_and_m_t":"This field contains the complete DRX configuration of the MCG. This field is only used in NR-DC.","paragraph_zero_based":43964},{"literal_text_all_w_t_and_m_t":"drx-InfoMCG","paragraph_zero_based":43965},{"literal_text_all_w_t_and_m_t":"This field contains the DRX long and short cycle configuration of the MCG. This field is used in (NG)EN-DC and NE-DC.","paragraph_zero_based":43966},{"literal_text_all_w_t_and_m_t":"drx-InfoMCG2","paragraph_zero_based":43967}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["37c6d44d07ab5e88a62211d58e1250b440156ab2a6c63d943b1d869a31e30dbf","cb95adc6362c4f4bcc5a2c0ad4d48017cdbe794407d4c267855f68bbdb808e1e","a816dac21f9399e7293cbf138f6f4575b1b2698428db65e5d539e63fc503024d","f21a41b88b7652d55ddd5c9f744afa572f4c24fcaf36930aba8e6a1495f6f351","63127f85ee314f20196d8e70503c8baca480e4aa1404be913e0ebdf29b351014","adb0cf931a44435cd61c750ee3e1b2c811336581b7402e6ee4119433c67caa21","324f0ce5eb46646c7af404419d112434eaa7e8f9c1fad99745caf4d7c5434a46","0a044d4db6cef23d82dd98a1d097d7b7da91d46d815ae48899d3b47b7fb64bfb","aa323e5e1b52b1411c6c058ca95a02e5b02261f32cfa03e3d97db8a94f706aa8","a21fe991065c735a94febc2fb8d1e15f476ded30bb9d47dd6cc247cd119111f7","4da36de3666a5df2e30e236c49dee058bd083dae694814a20b320d662939161c","2911fde3b961bd24d04ba64eb86cda3f4ece9f2655e45245961a54b56fe0f372","a3f40a554765b114b12d373eee21603c16f4847ef06921b377216348381b8800","a24c0469cf05d80bf514368fa33b2382093a8bd3e896dcbf5e9d8876f02fba8b","4ebd892041bf7443117e117fd28c4f40fc4f036daa469b5d7b9289f10b14e18f","c8418768803aaf88be373b268270f6a074586606bc7fb17119dc17d2da317353","68a04b1f2ef0e614afe3be5d75fdf095c7f0720402d26958c165d2153da6337e","1f10ba8f15cb916e59f50da9dd07d21ea7473b908074dbb87ca68417ad659037","570119a192f6ebcf5b2f0ac4e039abe9711394dcc15fc9026335cdcd2ad41ff1","d9bcaff3f8706d196cc2e68cc8b573cfabad45522579c86eb1604db0b4179cba","a0ca8108a53feecbe19402a584ece148e46e58d29acd1d0d64527063e744f9b3","d55c4f9fe5b13958015468691d62ee88a2cfceacc9a0297ce743e723a661acd6","7b8ad93268d2533b50f3b9ecc67e1365ccec948d159471cda5564419529a2dfa","703ffd166b69554081f57cbd6b48cb01d8b56d1b5dea3c60418f216695d8ba17"],"paragraph_range_zero_based":[43944,43967],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p43944"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field contains the drx-onDurationTimer configuration of the MCG. This field is only used in (NG)EN-DC.","paragraph_zero_based":43968},{"literal_text_all_w_t_and_m_t":"dummy, dummy1","paragraph_zero_based":43969},{"literal_text_all_w_t_and_m_t":"These fields are not used in the specification and SN ignores the received value(s).","paragraph_zero_based":43970},{"literal_text_all_w_t_and_m_t":"fr-InfoListMCG","paragraph_zero_based":43971},{"literal_text_all_w_t_and_m_t":"Contains information of FR information of serving cells that include PCell and SCell(s) configured in MCG.","paragraph_zero_based":43972},{"literal_text_all_w_t_and_m_t":"fr1-Carriers-MCG, fr2-Carriers-MCG","paragraph_zero_based":43973},{"literal_text_all_w_t_and_m_t":"Indicates the number of FR1 or FR2 serving cells configured in MCG.","paragraph_zero_based":43974},{"literal_text_all_w_t_and_m_t":"interFreqNoGap","paragraph_zero_based":43975},{"literal_text_all_w_t_and_m_t":"Indicates that the field interFrequencyConfig-NoGap-r16 has been included within the MeasConfig IE generated by the MN.","paragraph_zero_based":43976},{"literal_text_all_w_t_and_m_t":"lowMobilityEvaluationConnectedInPCell","paragraph_zero_based":43977},{"literal_text_all_w_t_and_m_t":"Indicates if low mobility criterion has been configured in NR PCell.","paragraph_zero_based":43978},{"literal_text_all_w_t_and_m_t":"maxInterFreqMeasIdentitiesSCG","paragraph_zero_based":43979},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of allowed measurement identities that the SCG is allowed to configure for inter-frequency measurement. The maximum value for this field is 10. If the field is absent, the SCG is allowed to configure inter-frequency measurements up to the maximum value. This field is only used in NR-DC.","paragraph_zero_based":43980},{"literal_text_all_w_t_and_m_t":"maxIntraFreqMeasIdentitiesSCG","paragraph_zero_based":43981},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of allowed measurement identities that the SCG is allowed to configure for intra-frequency measurement on each serving frequency. The maximum value for this field is 9 (in case of (NG)EN-DC or NR-DC) or 10 (in case of NE-DC). If the field is absent, the SCG is allowed to configure intra-frequency measurements up to the maximum value on each serving frequency.","paragraph_zero_based":43982},{"literal_text_all_w_t_and_m_t":"maxMeasCLI-ResourceSCG","paragraph_zero_based":43983},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of CLI RSSI resources that the SCG is allowed to configure.","paragraph_zero_based":43984},{"literal_text_all_w_t_and_m_t":"maxMeasFreqsSCG","paragraph_zero_based":43985},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of NR inter-frequency carriers the SN is allowed to configure with PSCell for measurements.","paragraph_zero_based":43986},{"literal_text_all_w_t_and_m_t":"maxMeasSRS-ResourceSCG","paragraph_zero_based":43987},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of SRS resources that the SCG is allowed to configure for CLI measurement.","paragraph_zero_based":43988},{"literal_text_all_w_t_and_m_t":"maxNumberCPCCandidates","paragraph_zero_based":43989},{"literal_text_all_w_t_and_m_t":"Indicates the maximum numbers of conditional reconfigurations the SN is allowed to configure for SN initiated CPC. Value 0 indicates that the SN is not allowed to configure SN initiated CPC. If the field is absent, the SN is allowed to configure up to maxNrofCondCells-r16 conditional reconfigurations for SN-initiated CPC.","paragraph_zero_based":43990},{"literal_text_all_w_t_and_m_t":"maxNumberROHC-ContextSessionsSN","paragraph_zero_based":43991}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["841e009813608a5b7eed25a2b2e1a8bf8ad24a5a153100ca209ce8efa406748f","ac4983240aba19cd19a4eb8ac2271351ae5772a3f872e95bdb6c4ca38fdbc27f","0ee0845e7f8141dd54925ba78efd8d3a46ab43e2f3b36de089f2c8861177e2a1","a00fd5ab0461226a9be943ef62978a5626c9b0f136fcd702631861380f2efa33","04c9d1113a9d2cbcae3569488a038c1e595aa09e29c44f4084a381c65d6de192","cfda5678b7bd198062b9c5eb1d2aaea8a48bf5be1532bc898d77edc07c9b2e53","a1b3b7e8e26219d180a54a64c5e0e382f147fe07cf26cbe560ab9b64488d1975","273eac76326b5c7b7e33b6b6dcf9a96caff45dc422ae56e7359ecad98f4ea674","5f7fb35d10601f6c266178da21668631f60b70bede9c465fbb2fbc1e60dba5b4","ad167d9fb4cd27eab3b12fcd1660f85d5029c180f18323abfe0765e2ae4d929c","d7e84aa0935a1794acb53c52877698a1506a24150abaa522aa2dbd8b25ee4830","3dc5283339181ca3fcee2ca613aa39162a0c45b95474af2cd38f83308d984e69","1089a28940ff5f1ddf0b6654f2f2ede2f5e3b840a148db66a023310d9f1319be","cd4d32e1cbaafb74e36c60f40ac14512f5d428dce83aebe9466ea9d57b70e61c","40c505e9db5686156212e0e0d6683c61a8025b2358c2b0a012c6ca7aa5d1d228","d006f5f932a746af2514900a5781099e3deaa489f4dcfc54643e19cf4e746167","22103f3f63ce502e9cb8980e44cd4a98e58a069b16d5d0ea7ae60eb438703367","7f75e7bb62bb1d6ee05b9558ff7d260107c1f0a57b33c8d88dec62018a5555a4","7fbfb8310a3550c11356fb5439b9a2d1047a92ccf402019e0c2e64741403b015","9a3f0dfc6bccc27a2d4b46181636c3816de285d4be852f8082d0090b890cf394","ae26e6ca0b404742cb998b583c75b83f0b6f48107f0e61d3c701a330fc31d5a1","d8243708235de3a5fc0ee4ff266616369ee953a871c24ea595fdd7bd32982b51","82f17ff6b96c12cccdea6a3dee68e46aba2c597d39a4d5aed0ef000ef26ce8ca","ba2d26a812041f014a847d2627a07dd69eea64c6127526717cd198ff75423fcd"],"paragraph_range_zero_based":[43968,43991],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p43968"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of ROHC context sessions allowed to SN terminated bearer, excluding context sessions that leave all headers uncompressed.","paragraph_zero_based":43992},{"literal_text_all_w_t_and_m_t":"maxNumberEHC-ContextsSN","paragraph_zero_based":43993},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of EHC contexts allowed to the SN terminated bearer. The field indicates the number of contexts in addition to CID = \"all zeros\", as specified in TS 38.323 [5].","paragraph_zero_based":43994},{"literal_text_all_w_t_and_m_t":"maxNumberUDC-DRB","paragraph_zero_based":43995},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of UDC DRBs allowed to SN terminated bearer. This field is used in NGEN-DC, NR-DC and NE-DC.","paragraph_zero_based":43996},{"literal_text_all_w_t_and_m_t":"maxToffset","paragraph_zero_based":43997},{"literal_text_all_w_t_and_m_t":"Indicates the maximum Toffset value the SN is allowed to use for scheduling SCG transmissions (see TS 38.213 [13]). This field is used in NR-DC only when the fields nrdc-PC-mode-FR1-r16 or nrdc-PC-mode-FR2-r16 are set to dynamic. Value ms0dot5 corresponds to 0.5 ms, value ms0dot75 corresponds to 0.75 ms, value ms1 corresponds to 1 ms and so on.","paragraph_zero_based":43998},{"literal_text_all_w_t_and_m_t":"measuredFrequenciesMN","paragraph_zero_based":43999},{"literal_text_all_w_t_and_m_t":"Used by MN to indicate a list of frequencies measured by the UE.","paragraph_zero_based":44000},{"literal_text_all_w_t_and_m_t":"measGapConfig","paragraph_zero_based":44001},{"literal_text_all_w_t_and_m_t":"Indicates the FR1 and perUE measurement gap configuration configured by MN.","paragraph_zero_based":44002},{"literal_text_all_w_t_and_m_t":"measGapConfigFR2","paragraph_zero_based":44003},{"literal_text_all_w_t_and_m_t":"Indicates the FR2 measurement gap configuration configured by MN.","paragraph_zero_based":44004},{"literal_text_all_w_t_and_m_t":"mcg-RB-Config","paragraph_zero_based":44005},{"literal_text_all_w_t_and_m_t":"Contains all of the fields in the IE RadioBearerConfig used in MN, used by the SN to support delta configuration to UE (i.e. when MN does not use full configuration option), for bearer type change between MN terminated bearer with NR PDCP to SN terminated bearer. It is also used to indicate the PDCP duplication related information for MN terminated split bearer (whether duplication is configured and if so, whether it is initially activated) in SN Addition/Modification procedure. Otherwise, this field is absent.","paragraph_zero_based":44006},{"literal_text_all_w_t_and_m_t":"measResultReportCGI, measResultReportCGI-EUTRA","paragraph_zero_based":44007},{"literal_text_all_w_t_and_m_t":"Used by MN to provide SN with CGI-Info for the cell as per SN′s request. In this version of the specification, the measResultReportCGI is used for (NG)EN-DC and NR-DC and the measResultReportCGI-EUTRA is used only for NE-DC.","paragraph_zero_based":44008},{"literal_text_all_w_t_and_m_t":"measResultSCG-EUTRA","paragraph_zero_based":44009},{"literal_text_all_w_t_and_m_t":"This field includes the MeasResultSCG-FailureMRDC IE as specified in TS 36.331 [10]. This field is only used in NE-DC.","paragraph_zero_based":44010},{"literal_text_all_w_t_and_m_t":"measResultSFTD-EUTRA","paragraph_zero_based":44011},{"literal_text_all_w_t_and_m_t":"SFTD measurement results between the PCell and the E-UTRA PScell in NE-DC. This field is only used in NE-DC.","paragraph_zero_based":44012},{"literal_text_all_w_t_and_m_t":"mrdc-AssistanceInfo","paragraph_zero_based":44013},{"literal_text_all_w_t_and_m_t":"Contains the IDC assistance information for MR-DC reported by the UE (see TS 36.331 [10]).","paragraph_zero_based":44014},{"literal_text_all_w_t_and_m_t":"nrdc-PC-mode-FR1","paragraph_zero_based":44015}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["04146cd035d8f464b5226bbe793c793c9e08af1290b54b665e8620c992655406","b2edf26331fc8d470a361b7239dd7fd342decbcf35da44c2a0d1d462135b21ed","96e8f509c63a0b6dc776fa068facd93e5256ec74a7beca4e080c66048aa0e37d","b021b92b641d3d487d8797de8164b5cfe02c36b917d8c0671ba182b6b2bcd134","1472b5ee1d3519a6d71f5fc442ee763b13cb13e6b5269dc507e45604bee80bf4","3e22179116c6436b12b19372faadd659708bc4a0c877a90f9583feba8cf97c12","a894cfd464d556137f495cce79046ad4e7d31cd8dfe4d1e8308337047d22b2dd","5234795eaa8ab97fc6356298931184426ecfbf98598b020b7df210371f8d9e97","c31c3572ecfc8bd470ae122f9dc8afd6ff414b6342067782be7e66413d06356c","7ea70149377a6d2a99a734d758d7cddff5e838aeac2d7b268998ccc132f82c8b","391a234482c6781714d031cf80db5766791d647e6a64dcd63df273950e9a421a","ca8a4e6f469727245b5f4e0405171cdc67d0fe9aca859c650bb80598922f99d8","c8edfec8e4471e9ab179ad5298ba87a87c59b19602dc3b42a16e455e70467d0d","d1ab6bf50b91d8f44ed1faa79959cc2f82bde5686018182ad875c17ea7b38811","e694c49666632410e9a9d628c22940554bf4a7196e85c0735edd60a4e9c1d2af","02aac89a429d2f2b73608fb4db4a41e3ebe4698a77522b9a981a8273db439a8c","9ea25bf2cf3ffd8f1e2f4732831436c0d911ba1dcaf39a860126a79d88111357","9189d8705b099e930e284ca67dc39256cbdfa7a4ba72cb23590f728496c024c6","5d57eceb0181368058af1dd0a42eb17aecdca884615b0be807d857112b2f547f","2f68a292b891d8a4684aefb6bf59317ddd3304f5f02b2bb72b758e2810862cb8","0581595798f7f43363b165f54c11e118f2891df6caef401d33d54ac469e54cf5","afb70f71da5cb0f6f7cd38f158417c20f30af232c18f87336034da0172cf30ed","e1d8b6bf502bdffb1b1b09771ff592c69c9de3a0e08636a548d03eb4bcc0799b","ecc3f31650e12bb10204842fa3153bdf12d49d73f1bb1096706d63713c25bc4c"],"paragraph_range_zero_based":[43992,44015],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p43992"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the uplink power sharing mode that the UE uses in NR-DC FR1 (see TS 38.213 [13], clause 7.6).","paragraph_zero_based":44016},{"literal_text_all_w_t_and_m_t":"nrdc-PC-mode-FR2","paragraph_zero_based":44017},{"literal_text_all_w_t_and_m_t":"Indicates the uplink power sharing mode that the UE uses in NR-DC FR2 (see TS 38.213 [13], clause 7.6).","paragraph_zero_based":44018},{"literal_text_all_w_t_and_m_t":"overheatingAssistanceSCG","paragraph_zero_based":44019},{"literal_text_all_w_t_and_m_t":"Contains the UE's preference on reduced configuration for NR SCG to address overheating. This field is only used in (NG)EN-DC.","paragraph_zero_based":44020},{"literal_text_all_w_t_and_m_t":"overheatingAssistanceSCG-FR2-2","paragraph_zero_based":44021},{"literal_text_all_w_t_and_m_t":"Contains the UE's preference on reduced configuration for NR SCG on FR2-2 to address overheating. This field is only used in (NG)EN-DC.","paragraph_zero_based":44022},{"literal_text_all_w_t_and_m_t":"p-maxEUTRA","paragraph_zero_based":44023},{"literal_text_all_w_t_and_m_t":"Indicates the maximum total transmit power to be used by the UE in the E-UTRA cell group (see TS 36.104 [33]). This field is used in (NG)EN-DC and NE-DC.","paragraph_zero_based":44024},{"literal_text_all_w_t_and_m_t":"p-maxNR-FR1","paragraph_zero_based":44025},{"literal_text_all_w_t_and_m_t":"For (NG)EN-DC and NE-DC, the field indicates the maximum total transmit power to be used by the UE in the NR cell group across all serving cells in frequency range 1 (FR1) (see TS 38.104 [12]). For NR-DC, it indicates the maximum total transmit power to be used by the UE in the NR cell group across all serving cells in frequency range 1 (FR1) (see TS 38.104 [12]) the UE can use in NR SCG.","paragraph_zero_based":44026},{"literal_text_all_w_t_and_m_t":"p-maxUE-FR1","paragraph_zero_based":44027},{"literal_text_all_w_t_and_m_t":"Indicates the maximum total transmit power to be used by the UE across all serving cells in frequency range 1 (FR1).","paragraph_zero_based":44028},{"literal_text_all_w_t_and_m_t":"p-maxNR-FR1-MCG","paragraph_zero_based":44029},{"literal_text_all_w_t_and_m_t":"Indicates the maximum total transmit power to be used by the UE in the NR cell group across all serving cells in frequency range 1 (FR1) (see TS 38.104 [12]) the UE can use in NR MCG. This field is only used in NR-DC.","paragraph_zero_based":44030},{"literal_text_all_w_t_and_m_t":"p-maxNR-FR2-SCG","paragraph_zero_based":44031},{"literal_text_all_w_t_and_m_t":"Indicates the maximum total transmit power to be used by the UE in the NR cell group across all serving cells in frequency range 2 (FR2) (see TS 38.104 [12]) the UE can use in NR SCG.","paragraph_zero_based":44032},{"literal_text_all_w_t_and_m_t":"p-maxUE-FR2","paragraph_zero_based":44033},{"literal_text_all_w_t_and_m_t":"Indicates the maximum total transmit power to be used by the UE across all serving cells in frequency range 2 (FR2).","paragraph_zero_based":44034},{"literal_text_all_w_t_and_m_t":"p-maxNR-FR2-MCG","paragraph_zero_based":44035},{"literal_text_all_w_t_and_m_t":"Indicates the maximum total transmit power to be used by the UE in the NR cell group across all serving cells in frequency range 2 (FR2) (see TS 38.104 [12]) the UE can use in NR MCG.","paragraph_zero_based":44036},{"literal_text_all_w_t_and_m_t":"pdcch-BlindDetectionSCG","paragraph_zero_based":44037},{"literal_text_all_w_t_and_m_t":"Indicates the maximum value of the reference number of cells for PDCCH blind detection allowed to be configured for the SCG.","paragraph_zero_based":44038},{"literal_text_all_w_t_and_m_t":"ph-InfoMCG","paragraph_zero_based":44039}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["ea94af09f545eef43084e9ca777fb8fb95ef7aee88675eea106648f5e6675bc1","41977bc1b7e949adbf7f803208a0e34536cc1325423cea37bff08e1583c57536","6981a64e1dda02202f68eb576885ada841a2c55e90d08ba6f3d8c3d7961f3646","6ce24655185206e5699588ec4de964d5a065e38309cc94f98d86cb0f8fe7d196","5a1fc0397cbb4100fa262b0df4f65ad0c304f3014f5113e3256305725dd0f2eb","51edf7d8903183baf52d595b6e0670a9d871a84b3f43b93fa6856875edc219be","205fa391f54d54be8dece5beb3548cb9901b0ef8f0b5c214a109faa2106efb47","b3e68c71d375f0de6288995078227828baabfdf0291ce9b6635d097093d2f9c0","518035e4ec9393994afd911aea8cf346dce526e5d8fe51b3919615c347164b9b","aa9d0c6519d2764cb27b647a2899611e1ef4ffaf8bc086120efbd7051a77054f","7d83d2c50b2f7c23ea58c42ae248d39a0ee1aaac8fc836cc6ee3646849d8a54d","0a0969acefc994f967763c1c9b228f884bb75e53ed2afd27e5270500100122b7","43a79f41c79a3038258009b4d65e2da991ad9e85dd53a03d622a077cdf6e1236","a12f92a65667bec66267c9cc22c175889ff71759749222493105cca03a0bffff","eae2ec43e08c9d9b1d6d9571df0e88898c5d6ecf44229ebb18b177e29093075f","14d803fa1e4b5d0aedd0f78a2b91486522e84a2c4878338d972fbab121b3497f","21b6ad5a297bc6bdc68bc6626cc751553cc6156aa8fdeece849096745e6186dc","a8f8d402409db0090be9eb2b51d3cb0572635d794bcb94fc6e945402c46bf926","79d15e7ce0680e6bf8eae8d72ed7a9d3fa653410925ad0a7b1dea6cfff904f1b","c63126e41ce6557e8a8601e8b34e8d0f44afc770ee318ac8c250a5258f8aca76","fbc3d692580d07a19fa2121da715b3f8a2e386cfac037195e63e0940df72a727","b024b17f6d1a2e8f8b455ab3a38095d869387d1973654a5ab3bd3f3fa59ec805","14afa012ed525dfce839c214429581087541d0d9c1c1d57ffd9f21ec2bfa7798","a9879574076478b95c196a90437665f6017749db429b0d56b3cbb36ec5b47656"],"paragraph_range_zero_based":[44016,44039],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p44016"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Power headroom information in MCG that is needed in the reception of PHR MAC CE in SCG.","paragraph_zero_based":44040},{"literal_text_all_w_t_and_m_t":"ph-SupplementaryUplink","paragraph_zero_based":44041},{"literal_text_all_w_t_and_m_t":"Power headroom information for supplementary uplink. For UE in (NG)EN-DC, this field is absent.","paragraph_zero_based":44042},{"literal_text_all_w_t_and_m_t":"ph-Type1or3","paragraph_zero_based":44043},{"literal_text_all_w_t_and_m_t":"Type of power headroom for a serving cell in MCG (PCell and activated SCells). type1 refers to type 1 power headroom, type3 refers to type 3 power headroom. (See TS 38.321 [3]). ","paragraph_zero_based":44044},{"literal_text_all_w_t_and_m_t":"ph-Uplink","paragraph_zero_based":44045},{"literal_text_all_w_t_and_m_t":"Power headroom information for uplink.","paragraph_zero_based":44046},{"literal_text_all_w_t_and_m_t":"powerCoordination-FR1","paragraph_zero_based":44047},{"literal_text_all_w_t_and_m_t":"Indicates the maximum power that the UE can use in FR1.","paragraph_zero_based":44048},{"literal_text_all_w_t_and_m_t":"powerCoordination-FR2","paragraph_zero_based":44049},{"literal_text_all_w_t_and_m_t":"Indicates the maximum power that the UE can use in frequency range 2 (FR2). This field is only used in NR-DC.","paragraph_zero_based":44050},{"literal_text_all_w_t_and_m_t":"scgFailureInfo","paragraph_zero_based":44051},{"literal_text_all_w_t_and_m_t":"Contains SCG failure type and measurement results. In case the sender has no measurement results available, the sender may include one empty entry (i.e. without any optional fields present) in measResultPerMOList. This field is used in (NG)EN-DC and NR-DC.","paragraph_zero_based":44052},{"literal_text_all_w_t_and_m_t":"scg-RB-Config","paragraph_zero_based":44053},{"literal_text_all_w_t_and_m_t":"Contains all of the fields in the IE RadioBearerConfig used in SN, used to allow the target SN to use delta configuration to the UE, e.g. during SN change. The field is signalled upon change of SN unless MN uses full configuration option. Otherwise, the field is absent.","paragraph_zero_based":44054},{"literal_text_all_w_t_and_m_t":"selectedBandEntriesMNList","paragraph_zero_based":44055},{"literal_text_all_w_t_and_m_t":"A list of indices referring to the position of a band entry selected by the MN, in each band combination entry in allowedBC-ListMRDC IE. BandEntryIndex 0 identifies the first band in the bandList of the BandCombination, BandEntryIndex 1 identifies the second band in the bandList of the BandCombination, and so on. This selectedBandEntriesMNList includes the same number of entries, and listed in the same order as in allowedBC-ListMRDC. The SN uses this information to determine which bands out of the NR band combinations in allowedBC-ListMRDC it can configure in SCG in NR-DC. The SN can use this information to determine for which band pair(s) it should check SimultaneousRxTxPerBandPair.","paragraph_zero_based":44056},{"literal_text_all_w_t_and_m_t":"servCellIndexRangeSCG","paragraph_zero_based":44057},{"literal_text_all_w_t_and_m_t":"Range of serving cell indices that SN is allowed to configure for SCG serving cells.","paragraph_zero_based":44058},{"literal_text_all_w_t_and_m_t":"servCellInfoListMCG-EUTRA","paragraph_zero_based":44059},{"literal_text_all_w_t_and_m_t":"Indicates the carrier frequency and the transmission bandwidth of the serving cell(s) in the MCG in intra-band (NG)EN-DC. The field is needed when MN and SN operate serving cells in the same band for either contiguous or non-contiguous intra-band band combination or LTE NR inter-band band combinations where the frequency range of the E-UTRA band is a subset of the frequency range of the NR band (as specified in Table 5.5B.4.1-1 of TS 38.101-3 [34]) in (NG)EN-DC.","paragraph_zero_based":44060},{"literal_text_all_w_t_and_m_t":"servCellInfoListMCG-NR","paragraph_zero_based":44061},{"literal_text_all_w_t_and_m_t":"Indicates the frequency band indicator, carrier center frequency, UE specific channel bandwidth and SCS of the serving cell(s) in the MCG in intra-band NE-DC. The field is needed when MN and SN operate serving cells in the same band for either contiguous or non-contiguous intra-band band combination or LTE NR inter-band band combinations where the frequency range of the E-UTRA band is a subset of the frequency range of the NR band (as specified in Table 5.5B.4.1-1 of TS 38.101-3 [34]) in NE-DC.","paragraph_zero_based":44062},{"literal_text_all_w_t_and_m_t":"servFrequenciesMN-NR","paragraph_zero_based":44063}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["79e9518937963cb89e7747708e4b1d598005cab48e36a6ab9cd47881d44a8dbb","27013c36638d04eb6a50f9642275658a237eae6f845adb14a0955fc6ce18771e","c57f87250fde8dd593b53cd5aa2db3ef8d990ec1a17106dbc70a51ccb89e554f","5954b051537b03852eeeee6e3ef0d025c53de07d3755fe34ae3f65883efb7030","fdada94bacdaeab1553bf249f4641781811cf644b7152d0a192963db046d5129","f776fe3446419b23d0cd83623b5da929d5a80c41ef51eb00ae2de1e0843aefa1","12de95714c829bb28697b00768db26242a34139d6efe8000fc555969034a483e","8fe3296d6d871d9c7c5ae1a1e1769c80016a56decd712e2f8a52b1af9218fca9","edab11206c292c6eee5c7400f2cad578158eb1e874d5cec7ec05c67e92576185","ce8a4e57cf8a94823111b6766373cc3f26ad12c90a086510a3fb7ef2e5d1dc5f","c3ecbc1c0a40472ca399e5b260ba7cec346c5d722c249c5e005f1031f10f2057","bd6ddf71458f8c41a591e0f605a2fb1bfa8d00d449183e0f3680863ae829c19b","83207b372c890369d16727489492ea301949d1e741384fd9238c63ed40cc6112","4adefc63df4141a547412e5a14d66690488fb88ea27aaa94a24aa1f4e089f9a9","a5a9c542d40e3c11a8eedbed736a40e92446b52430c198f88a72cc6254569749","09113e3805f346cb05b947256b0b3530ff2b14f2e3d4289e051380480890d21f","4b2e528ae680c3cf3094e185bfd2307b8346f9b7a2753e3f0513f9de3f05ff22","7729c4b3351ea85d1d3d6ebbf05eb16510d5c60c0e72a728cbb39a09b7512b23","b3f0216e6487338cfcf7b20c843da36695181ea39896f0fad4330b5b9cc25e56","b384db5dbdd3c15d4c957673b370e7727491ce02f183e1de43374b29173c5f03","b968d6304e0aa6427ffc04dda899709694976ec54a7c0c207a4fc778576e33ce","fc67993e774f460e417a6f351b42f4d96f642b0ad6466549340f431d9651db38","996e8351a977d42785e2660221ca088bd2daf75ff666e30b0ecb0033bcf5933b","564b14b463ce8065c0300a2ffb24f82892b5197ab2db48d309cb3db9328a81d2"],"paragraph_range_zero_based":[44040,44063],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p44040"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the frequency of all serving cells that include PCell and SCell(s) with SSB configured in MCG. This field is only used in NR-DC. servFrequenciesMN-NR indicates absoluteFrequencySSB.","paragraph_zero_based":44064},{"literal_text_all_w_t_and_m_t":"sftdFrequencyList-NR","paragraph_zero_based":44065},{"literal_text_all_w_t_and_m_t":"Includes a list of SSB frequencies. Each entry identifies the SSB frequency of a PSCell, which corresponds to one MeasResultCellSFTD-NR entry in the MeasResultCellListSFTD-NR.","paragraph_zero_based":44066},{"literal_text_all_w_t_and_m_t":"sftdFrequencyList-EUTRA","paragraph_zero_based":44067},{"literal_text_all_w_t_and_m_t":"Includes a list of E-UTRA frequencies. Each entry identifies the carrier frequency of a PSCell, which corresponds to one MeasResultSFTD-EUTRA entry in the MeasResultCellListSFTD-EUTRA.","paragraph_zero_based":44068},{"literal_text_all_w_t_and_m_t":"sidelinkUEInformationEUTRA","paragraph_zero_based":44069},{"literal_text_all_w_t_and_m_t":"This field contains the E-UTRA SidelinkUEInformation message as specified in TS 36.331 [10].","paragraph_zero_based":44070},{"literal_text_all_w_t_and_m_t":"sidelinkUEInformationNR","paragraph_zero_based":44071},{"literal_text_all_w_t_and_m_t":"This field contains the NR SidelinkUEInformationNR message.","paragraph_zero_based":44072},{"literal_text_all_w_t_and_m_t":"sourceConfigSCG","paragraph_zero_based":44073},{"literal_text_all_w_t_and_m_t":"Includes all of the current SCG configurations used by the target SN to build delta configuration to be sent to UE, e.g. during SN change. The field contains the RRCReconfiguration message, i.e. including secondaryCellGroup and measConfig. The field is signalled upon change of SN, unless MN uses full configuration option. Otherwise, the field is absent.","paragraph_zero_based":44074},{"literal_text_all_w_t_and_m_t":"sourceConfigSCG-EUTRA","paragraph_zero_based":44075},{"literal_text_all_w_t_and_m_t":"Includes the E-UTRA RRCConnectionReconfiguration message as specified in TS 36.331 [10]. In this version of the specification, the E-UTRA RRC message can only include the field scg-Configuration. In this version of the specification, this field is absent when master gNB uses full configuration option. This field is only used in NE-DC.","paragraph_zero_based":44076},{"literal_text_all_w_t_and_m_t":"twoPHRModeMCG","paragraph_zero_based":44077},{"literal_text_all_w_t_and_m_t":"Indicates if the power headroom for MCG shall be reported as two PHRs (each PHR associated with a SRS resource set) is enabled or not.","paragraph_zero_based":44078},{"literal_text_all_w_t_and_m_t":"twoSRS-PUSCH-Repetition","paragraph_zero_based":44079},{"literal_text_all_w_t_and_m_t":"Indicates whether the indicated serving cell is configured for PUSCH repetition corresponding to two SRS resource sets configured in either srs-ResourceSetToAddModList or srs-ResourceSetToAddModListDCI-0-2 with usage 'codebook' or 'noncodebook'.","paragraph_zero_based":44080},{"literal_text_all_w_t_and_m_t":"ueAssistanceInformationSourceSCG","paragraph_zero_based":44081},{"literal_text_all_w_t_and_m_t":"Includes for each UE assistance feature associated with the SCG, the information last reported by the UE in the NR UEAssistanceInformation message for the source SCG, if any.","paragraph_zero_based":44082},{"literal_text_all_w_t_and_m_t":"ue-CapabilityInfo","paragraph_zero_based":44083},{"literal_text_all_w_t_and_m_t":"Contains the IE UE-CapabilityRAT-ContainerList supported by the UE (see NOTE 3). A gNB that retrieves MRDC related capability containers ensures that the set of included MRDC containers is consistent w.r.t. the feature set related information.","paragraph_zero_based":44084},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44085},{"literal_text_all_w_t_and_m_t":"BandCombinationInfo field descriptions","paragraph_zero_based":44086},{"literal_text_all_w_t_and_m_t":"allowedFeatureSetsList","paragraph_zero_based":44087}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["b8c9427536df31afde4a24e50c8403965bf456042c700d59ad6e4ddaf8bf149d","de551b5ac43d7d4487a838529af40c35955b834cdfeb22b223a4ceb0f30f869b","eda9864421dfdbc72702cbe20ba5ea5744836682c1c09d5b65e26b6f10664be8","5b1277495c25742e4d129e98b5b719a0c7024978acd4027643e071684fac9cc7","81e04c16df2567bbbd22e139aedcbf75d792a93e22a0e4330235ea2f2dbbcfd2","33df70a7a21179808760bc7dd37b4906af4a21221712f547ce81a1fc7a02c988","01e4514a055f4c7f5d38d1c564ffd962e8f8926a877b47b032d5b56b1233a342","2fe16c17cfd1c161a0fde6740d3bb4f8939dcd98819382cf1e373c9021229f9a","7fd22d17682ddb76846588d276a19bb592af41a18ed1b2262f7163241915c09f","a1fd672ae71acafbedf7c3cd023f4207be8db136d6482339d639034ed5b73e8b","772b590e99a3a237300cbb3eaa5556cd082b30c92c499dcc9d8ea12246d5fa4f","d3f7ff3e3cb5ef4f54addcde4bd5bfb73deab60ae49ffa80799ac13d421cc053","b9678fd72ba167658de5af1402dfe05d4dd0ea68513c80cb9e7ceefa973a4c47","08b48022230dae5711bb788babd587f783052ad23115cef14d17ad2d983b0d5e","32bc37b94a56d00bfbbc1e16f35f01d816a73ebb301326a49181f310c69c0d4e","6704ce65d31433edc1edef066675eca5f8203d3aff9f9c37963ab6ea5eb5c510","3a0371ac12cd06ab0ed47cab07e4848a5cf64fcf00b76b5a9c030920375860f6","86e30163460a4fe182783c45359fbf78f2c5aa39401fa9f44fa2b04775797acd","a9cc5d42b9404b26431c84cad437b94c1d7a6c1f63c0bc9c95adb85b64f652b4","b6211c3069668affa1f876aac11fdb8d33c093c226e52b4b48492fb2bbc261d3","53859f9979425eb6b5fcc605f013733c9019dd9a27295c6cfc1b870830357f04","d80498725e6c9badef804fe8078510d95392c19fed8b3ae15e763eda2208debf","bc6ab855e0d119d0d0b2f64ab6a2bbfe7119dde5a9f80fa656493cf060dc04d1","96e4d2ec36daf18a78f1664032cdc98de00c314dd911fb28cc6e950793c81588"],"paragraph_range_zero_based":[44064,44087],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p44064"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Defines a subset of the entries in a FeatureSetCombination. Each index identifies a position in the FeatureSetCombination, which corresponds to one FeatureSetUplink/Downlink for each band entry in the associated band combination.","paragraph_zero_based":44088},{"literal_text_all_w_t_and_m_t":"bandCombinationIndex","paragraph_zero_based":44089},{"literal_text_all_w_t_and_m_t":"In case of NR-DC, this field indicates the position of a band combination in the supportedBandCombinationList. In case of NE-DC, this field indicates the position of a band combination in the supportedBandCombinationList and/or supportedBandCombinationListNEDC-Only. In case of (NG)EN-DC, this field indicates the position of a band combination in the supportedBandCombinationList and/or supportedBandCombinationList-UplinkTxSwitch. Band combination entries in supportedBandCombinationList are referred by an index which corresponds to the position of a band combination in the supportedBandCombinationList. Band combination entries in supportedBandCombinationListNEDC-Only are referred by an index which corresponds to the position of a band combination in the supportedBandCombinationListNEDC-Only increased by the number of entries in supportedBandCombinationList. Band combination entries in supportedBandCombinationList-UplinkTxSwitch are referred by an index which corresponds to the position of a band combination in the supportedBandCombinationList-UplinkTxSwitch increased by the number of entries in supportedBandCombinationList.","paragraph_zero_based":44090},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44091},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":44092},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":44093},{"literal_text_all_w_t_and_m_t":"SN-AddMod","paragraph_zero_based":44094},{"literal_text_all_w_t_and_m_t":"The field is mandatory present upon SN addition and SN change. It is optionally present upon SN modification and inter-MN handover without SN change. Otherwise, the field is absent.","paragraph_zero_based":44095},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44096},{"literal_text_all_w_t_and_m_t":"NOTE 3:The following table indicates per MN RAT and SN RAT whether RAT capabilities are included or not in ue-CapabilityInfo.","paragraph_zero_based":44097},{"literal_text_all_w_t_and_m_t":"MN RAT","paragraph_zero_based":44098},{"literal_text_all_w_t_and_m_t":"SN RAT","paragraph_zero_based":44099},{"literal_text_all_w_t_and_m_t":"NR capabilities","paragraph_zero_based":44100},{"literal_text_all_w_t_and_m_t":"E-UTRA capabilities","paragraph_zero_based":44101},{"literal_text_all_w_t_and_m_t":"MR-DC capabilities","paragraph_zero_based":44102},{"literal_text_all_w_t_and_m_t":"E-UTRA","paragraph_zero_based":44103},{"literal_text_all_w_t_and_m_t":"NR","paragraph_zero_based":44104},{"literal_text_all_w_t_and_m_t":"Need not be included if the UE Radio Capability ID as specified in 23.502 [43] is used. Included otherwise","paragraph_zero_based":44105},{"literal_text_all_w_t_and_m_t":"Not included","paragraph_zero_based":44106},{"literal_text_all_w_t_and_m_t":"Need not be included if the UE Radio Capability ID as specified in 23.502 [43] is used. Included otherwise","paragraph_zero_based":44107},{"literal_text_all_w_t_and_m_t":"NR","paragraph_zero_based":44108},{"literal_text_all_w_t_and_m_t":"E-UTRA","paragraph_zero_based":44109},{"literal_text_all_w_t_and_m_t":"Not included","paragraph_zero_based":44110},{"literal_text_all_w_t_and_m_t":"Need not be included if the UE Radio Capability ID as specified in 23.502 [43] is used. Included otherwise","paragraph_zero_based":44111}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordi