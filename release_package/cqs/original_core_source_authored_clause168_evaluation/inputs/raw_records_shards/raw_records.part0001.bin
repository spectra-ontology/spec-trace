c2adad235dba8dd738a35","ab1e93151092fc03cc28c348f8cf24cbe4275d09b9e38c59a39555cbac7adeb8","c9038ebf658b938665b357c91d7948bc55a7b659ace2fda722109265296237ba","7b6b1073c33633c0a9b797d0b7af3455ca6d124663700dbe7ad841685b33ccc0","4e83ef139aeb7f486631acb8a347d29c6c537ac9fa3992c5b628ff355fd7262f","f4524305d0bb4bcecc8d09929929b39c5f526b8a29d5c48be9080a1d1d35435e","b1d016dbddab020d65f4364b1dd529df4f0c92b7d557198c9f3c990ac57097d3","19e661207db032e43ab95a2a4c72e5900d1b767aee94e3cf44ae81e4d9e4bc76","919972c5981e81950024e0ec1e3297b4ac867c5cfc403cd81448bed74f823969","c58cc3ece966bcf81526be0f1c47c14ab5ba97047dfbb5129026b57d3fcf6b5c","89142f00ba861659d33907020add4749e6b75926c2a476d080e374d05cf75a72","90fd6391936ac18e6ddcc92f8a862439d1272278f0641596b21fea0f300894d7","716be746e2fc5fa66021a3d98925901e7dbf7eac9a938c088ed0e14e0d82b357","92dcabfa4c3edcac4b56c9dc3a205943df2374497dfb6cce752d89298a09c323","12162cd6d0d54a7c663b516692f2af0564728bda1a860f72405081c8c28e13da"],"paragraph_range_zero_based":[25344,25367],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p25344"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"DRB-ToAddMod and MRB-ToAddMod field descriptions","paragraph_zero_based":25368},{"literal_text_all_w_t_and_m_t":"cnAssociation","paragraph_zero_based":25369},{"literal_text_all_w_t_and_m_t":"Indicates if the bearer is associated with the eps-bearerIdentity (when connected to EPC) or sdap-Config (when connected to 5GC).","paragraph_zero_based":25370},{"literal_text_all_w_t_and_m_t":"daps-Config","paragraph_zero_based":25371},{"literal_text_all_w_t_and_m_t":"Indicates that the bearer is configured as DAPS bearer.","paragraph_zero_based":25372},{"literal_text_all_w_t_and_m_t":"drb-Identity","paragraph_zero_based":25373},{"literal_text_all_w_t_and_m_t":"In case of DC, the DRB identity is unique within the scope of the UE, i.e. an MCG DRB cannot use the same value as a split DRB. For a split DRB the same identity is used for the MCG and SCG parts of the configuration.","paragraph_zero_based":25374},{"literal_text_all_w_t_and_m_t":"eps-BearerIdentity","paragraph_zero_based":25375},{"literal_text_all_w_t_and_m_t":"The EPS bearer ID determines the EPS bearer.","paragraph_zero_based":25376},{"literal_text_all_w_t_and_m_t":"mbs-SessionId","paragraph_zero_based":25377},{"literal_text_all_w_t_and_m_t":"Indicates which multicast MBS session the bearer is associated with.","paragraph_zero_based":25378},{"literal_text_all_w_t_and_m_t":"mrb-Identity","paragraph_zero_based":25379},{"literal_text_all_w_t_and_m_t":"Identification of the multicast MRB.","paragraph_zero_based":25380},{"literal_text_all_w_t_and_m_t":"mrb-IdentityNew","paragraph_zero_based":25381},{"literal_text_all_w_t_and_m_t":"New identity of the multicast MRB when mrb-Identity needs to be changed, e.g. as a result of a handover.","paragraph_zero_based":25382},{"literal_text_all_w_t_and_m_t":"reestablishPDCP","paragraph_zero_based":25383},{"literal_text_all_w_t_and_m_t":"Indicates that PDCP should be re-established. Network sets this to true whenever the security key used for this radio bearer changes. Key change could for example be due to termination point change for the bearer, reconfiguration with sync, resuming an RRC connection, or the first reconfiguration after reestablishment. It is also applicable for LTE procedures when NR PDCP is configured. Network doesn't include this field for DRB if the bearer is configured as DAPS bearer.","paragraph_zero_based":25384},{"literal_text_all_w_t_and_m_t":"recoverPDCP","paragraph_zero_based":25385},{"literal_text_all_w_t_and_m_t":"Indicates that PDCP should perform recovery according to TS 38.323 [5]. Network doesn't include this field if the bearer is configured as DAPS bearer.","paragraph_zero_based":25386},{"literal_text_all_w_t_and_m_t":"sdap-Config","paragraph_zero_based":25387},{"literal_text_all_w_t_and_m_t":"The SDAP configuration determines how to map QoS flows to DRBs when NR or E-UTRA connects to the 5GC and presence/absence of UL/DL SDAP headers.","paragraph_zero_based":25388},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25389},{"literal_text_all_w_t_and_m_t":"RadioBearerConfig field descriptions","paragraph_zero_based":25390},{"literal_text_all_w_t_and_m_t":"securityConfig","paragraph_zero_based":25391}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["a55db13194274adea62a4edcb5a93bb5461407f7c701d4f06d54d971413618de","3ab9ae4f3451aad1cd8600aa931806907bf8ec33efbb25b95914ceb75381c2e8","8d374962c73a229ea5201d7b8818507473bbadc73866f1bc2eb33cbc62169fa2","0a03d9cc61ba014b7797c9bf07ad261f2f0910bcc3942078cfec12df6e5a62c0","6d3d3ff77c635aa60a0955b0b80ad54916a6bc1eee99196a7fab2a29cf8b2cdb","550f5a4d8c8f0760fcfa0bb106be36d86f465b0159d90ba2b0a7208dad9fdbe2","61f61b76d80ec7c1d2c32171b4ed3e03e5b83735dc60aff1e9181f46bf52b8d0","5bf2fc1f827858c5816329f3d1ddca24a5e6913e6fd1f34d47b1e194834f7fb4","f9b2bc18bf56af5d4212b5c15b17ba27c45925be5bcc58d9990b050e5433b32c","7cc0ccc370945368494366e1589b0cb9f2970f232cf72e046813302e5b699d3f","3b618bf1d8a33119e1b7a6c6b62e6b039f2a83664d67d6c05a50796d8722d007","6878825cdbf9184bd60061ee4ab6397d5b1e46a5a0a1dbb0ddcb876b931436d8","5379d77b52c888769b0d525845b9c4b650812d03c0460d0427f109c57778e1e6","c389e7b2c5693541869ebb8c06fd7ad2c28f330cacd1b1c743d0390f4928245d","3fe76e9361bd561185cc5518f75b781454d0dc63acd7d96782c6bc37edb7a5e2","c9af36095f74511ac3d7e9dc1c095f10c4f8c40df056b73c88390896f526ee1a","60cc2d7c50b969b448bcd3a9e8bc50a0d5f4f8ff6fbeb05b1aebc509ee82ab05","0006ea794782c35bdceb55595cb6fb4649e9a0782738d9004cdb7875862c64b2","8cca9fd71a97d6db3cc4aca1a71dfb255549b61143a6f0b7373e278148adf909","dd5ead48f122621e503824eadd0d95e167da014c341f3804e06b4c4945073381","c648052de616fad18f462c84124e2c44e3e724c353201b2a0753b53eb4028c14","64417c308b61502d3726d964c766c5450c2591aa67ca4335ea40731893395164","ae17ff4fc02c3f8828e013c7940bc7c57cfe55f550c9881e9d2c22e6594ad992","5768b9cd570538f5ca1331f87a20a401f9b58839f748be800d01d09b6e8fa7db"],"paragraph_range_zero_based":[25368,25391],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p25368"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the security algorithm and key to use for the signalling and data radio bearers configured with the list in this IE RadioBearerConfig. When the field is not included after AS security has been activated, the UE shall continue to use the currently configured keyToUse and security algorithm for the radio bearers reconfigured with the lists in this IE RadioBearerConfig. The field is not included when configuring SRB1 before AS security is activated.","paragraph_zero_based":25392},{"literal_text_all_w_t_and_m_t":"srb3-ToRelease","paragraph_zero_based":25393},{"literal_text_all_w_t_and_m_t":"Release SRB3. SRB3 release can only be done over SRB1 and only at SCG release and reconfiguration with sync.","paragraph_zero_based":25394},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25395},{"literal_text_all_w_t_and_m_t":"SecurityConfig field descriptions","paragraph_zero_based":25396},{"literal_text_all_w_t_and_m_t":"keyToUse","paragraph_zero_based":25397},{"literal_text_all_w_t_and_m_t":"Indicates if the bearers configured with the list in this IE RadioBearerConfig are using the master key or the secondary key for deriving ciphering and/or integrity protection keys. For MR-DC, network should not configure SRB1 and SRB2 with secondary key and SRB3 with the master key. When the field is not included, the UE shall continue to use the currently configured keyToUse for the radio bearers reconfigured with the lists in this IE RadioBearerConfig.","paragraph_zero_based":25398},{"literal_text_all_w_t_and_m_t":"securityAlgorithmConfig","paragraph_zero_based":25399},{"literal_text_all_w_t_and_m_t":"Indicates the security algorithm for the signalling and data radio bearers configured with the list in this IE RadioBearerConfig. When the field is not included, the UE shall continue to use the currently configured security algorithm for the radio bearers reconfigured with the lists in this IE RadioBearerConfig.","paragraph_zero_based":25400},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25401},{"literal_text_all_w_t_and_m_t":"SRB-ToAddMod field descriptions","paragraph_zero_based":25402},{"literal_text_all_w_t_and_m_t":"discardOnPDCP","paragraph_zero_based":25403},{"literal_text_all_w_t_and_m_t":"Indicates that PDCP should discard stored SDU and PDU according to TS 38.323 [5].","paragraph_zero_based":25404},{"literal_text_all_w_t_and_m_t":"reestablishPDCP","paragraph_zero_based":25405},{"literal_text_all_w_t_and_m_t":"Indicates that PDCP should be re-established. Network sets this to true whenever the security key used for this radio bearer changes. Key change could for example be due to reconfiguration with sync, for SRB2 when resuming an RRC connection, or at the first reconfiguration after RRC connection reestablishment in NR. For SRB1, when resuming an RRC connection, or at the first reconfiguration after RRC connection reestablishment in NR, the network does not set this field to true. For LTE SRBs using NR PDCP, it could be for handover, RRC connection reestablishment or resume. Network doesn't include this field if any DAPS bearer is configured.","paragraph_zero_based":25406},{"literal_text_all_w_t_and_m_t":"srb-Identity, srb-Identity-v1700","paragraph_zero_based":25407},{"literal_text_all_w_t_and_m_t":"Value 1 is applicable for SRB1 only. Value 2 is applicable for SRB2 only. Value 3 is applicable for SRB3 only. Value 4 is applicable for SRB4 only. If srb-Identity-v1700 is received for an SRB, the UE shall ignore srb-Identity (i.e. without suffix) for this SRB.","paragraph_zero_based":25408},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25409},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":25410},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":25411},{"literal_text_all_w_t_and_m_t":"RBTermChange","paragraph_zero_based":25412},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in case of:","paragraph_zero_based":25413},{"literal_text_all_w_t_and_m_t":"-set up of signalling and data radio bearer,","paragraph_zero_based":25414},{"literal_text_all_w_t_and_m_t":"-change of termination point for the radio bearer between MN and SN.","paragraph_zero_based":25415}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["a53545a32eb7d0de18a03854020cdeb74de5f005a0819620016ee7f0aabce93b","554afe192643e25a9fbe9c1943d0a040382e510c139708298d3e1f3d05697657","b033a7293bec4aa0ea30be55aec7408423d87d56146347199b08d7f96b4a9d06","1c856c5b328deeae6f61cd4f72d8cfb76f9c5b52b9f1406a7a29f7a97055dcdb","8c73cdc77a8f52a516b30fbd9a7d1858ede59ebac14ac62182482b373c75325c","75d7c8ab89b2af73d302edab8d53874de6eb6241fcfc1cd8d4fcdba0a8cdcb85","ee122d0d1ac32b488e6a014414a5ad281c718cc0d7e1ed789a951c44584ed839","39eb175b6cf7508db160a9bb0ea35b6966c8d298eab6c27602dea78b7957d0aa","71a48b8f1f3c1da43cf43e5ec89e881c77548d081d7b649156b937ceefa9988f","52afaddbc17eb1bb29c30e09d6726ee35e6958b5a86df74eb28a4f1bf95374bc","58a8f8dbfcd20bc305d8da965511ab4c29c9b3e60fc2abceb1419afa795e28b2","0f4cb33e44df261efa7ea9c72d573258bf97c5505d0a8a70e3d7334e47949473","eab293cfe355b517b723ec2087ed7d7b57a2b79d732a017b550be6a0182cc682","705cc20925d42dd3c3b5bf33efbc1105b2029de915663f07d7394a9fc0df6ec4","c9aa8063878a7a868fae8048cbf7267863570c427c60f52ab0965d0a9eea1a40","be7ebd4108652464abe43d6a40804044440f8cbf733f153aee97bf1173349f19","c78e8cd87006d4f54e00a8ed8454367382fc9d857de8dfc9d6c488c18cf2d060","cb55b06a30c99cc56cde4a2465d17876aeabfe699e9ef6e4c3ae4723f7b79c18","694164862ccea4cef76a1718edc4c5878dec2dbc77e4f48d3a2823b769913d42","df5e56a7bce1d2d6cab25c707adf459ddeacc70b309c32533645a865da5f63cf","794487b646310513289601f7bc5012acad1e6d92f8765a2b031057fcef3fdcde","1ce33fd5e42ce2751c7934db936d2e318a263901eada0f74da267b68f638e536","d03c2336917b1efa5e6aec0fa2cd8fbde58b718fc286b71f0d310ba81b7822e6","30dc069b62217244257f48b7ec4cbd9b41658cb85cdbfb008cce639c800dd107"],"paragraph_range_zero_based":[25392,25415],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p25392"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"It is optionally present otherwise, Need S.","paragraph_zero_based":25416},{"literal_text_all_w_t_and_m_t":"RBTermChange1","paragraph_zero_based":25417},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in case of:","paragraph_zero_based":25418},{"literal_text_all_w_t_and_m_t":"-set up of signalling and data radio bearer,","paragraph_zero_based":25419},{"literal_text_all_w_t_and_m_t":"-change of termination point for the radio bearer between MN and SN,","paragraph_zero_based":25420},{"literal_text_all_w_t_and_m_t":"-handover from E-UTRA/EPC or E-UTRA/5GC to NR,","paragraph_zero_based":25421},{"literal_text_all_w_t_and_m_t":"-handover from NR or E-UTRA/EPC to E-UTRA/5GC if the UE supports NGEN-DC.","paragraph_zero_based":25422},{"literal_text_all_w_t_and_m_t":"It is optionally present otherwise, Need S.","paragraph_zero_based":25423},{"literal_text_all_w_t_and_m_t":"PDCP","paragraph_zero_based":25424},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the corresponding DRB/multicast MRB is being setup or corresponding DRB/multicast MRB is reconfigured with NR PDCP or corresponding SRB associated with two RLC entities is being setup or if the number of RLC bearers associated with the DRB/multicast MRB or SRB is changed. The field is optionally present, Need S, if the corresponding SRB associated with one RLC entity is being setup or corresponding SRB is reconfigured with NR PDCP; otherwise the field is optionally present, need M.","paragraph_zero_based":25425},{"literal_text_all_w_t_and_m_t":"DRBSetup","paragraph_zero_based":25426},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the corresponding DRB is being setup; otherwise the field is optionally present, need M.","paragraph_zero_based":25427},{"literal_text_all_w_t_and_m_t":"HO-Conn","paragraph_zero_based":25428},{"literal_text_all_w_t_and_m_t":"The field is mandatory present","paragraph_zero_based":25429},{"literal_text_all_w_t_and_m_t":"-in case of inter-system handover from E-UTRA/EPC to E-UTRA/5GC or NR,","paragraph_zero_based":25430},{"literal_text_all_w_t_and_m_t":"-or when the fullConfig is included in the RRCReconfiguration message and NE-DC/NR-DC is not configured,","paragraph_zero_based":25431},{"literal_text_all_w_t_and_m_t":"-or in case of RRCSetup.","paragraph_zero_based":25432},{"literal_text_all_w_t_and_m_t":"Otherwise the field is optionally present, need N.","paragraph_zero_based":25433},{"literal_text_all_w_t_and_m_t":"Upon RRCSetup, only SRB1 can be present.","paragraph_zero_based":25434},{"literal_text_all_w_t_and_m_t":"HO-toNR","paragraph_zero_based":25435},{"literal_text_all_w_t_and_m_t":"If mrb-ToAddModList is not included, the field is mandatory present","paragraph_zero_based":25436},{"literal_text_all_w_t_and_m_t":"-in case of inter-system handover from E-UTRA/EPC to E-UTRA/5GC or NR,","paragraph_zero_based":25437},{"literal_text_all_w_t_and_m_t":"-or when the fullConfig is included in the RRCReconfiguration message and NE-DC/NR-DC is not configured.","paragraph_zero_based":25438},{"literal_text_all_w_t_and_m_t":"In case of RRCSetup, the field is absent; otherwise the field is optionally present, need N.","paragraph_zero_based":25439}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["6322d3a3515d84135d29ce93403ff625e4ef00e54cb70ebc497ce81e3bb787ba","4a6e33a03bfcdd8cb83742352b09318adf1bb21625e45b49a93622f8a562413f","2071e7b715e6d1a78538dbacbe7e1e89de5fa7dec4dea4aee90300317b43d23d","b83838db5a7e8ae3453c4a9fbe27873010889c15b5ef5d1d856cbc69c3942541","5e4231365f70b2903c12d65b90eeb680653084ed474b1021d492c5f9639e37d1","bd7d0f3a8475fe73e1124d5f925e7b2084282610a98e3f7dee65b6ac3c4cb738","31bbee41a6327f9888e4996d3bdc20e4d6dcd5ca765bb3fc61851e42e8341b77","e7621b72d897579cbc85a4fd155bb4db38bbced4f6546c13b9b95e35822b5852","c084eaec1fada45f0f115a247602362d67308a3099154a1e509f0dd3f63e06d0","4f2369f1bce99c5a7482cb5aaea675e60af22cc3680fcceb5a6e63f467562be3","7f3913db10d85be931a4ab98958b834116881225b73b032988edcb5ed824de8d","d77321b17259845f9b302bc59a9f9c2e735ba2f74f4e16c842133038b2fa68be","68883a6c443c7b993a3df02cda0981439bedc14e43fc7e76cfbfc4c730eb798e","5950410bf2b1648d947df497ca48fc522f949ec0ad75af0bca36d7984d059a1d","917f47b812d4445123742700ecb176f855ba9d4fd1d9d780cb9c006789cbd9e1","b5eb23caaf07f899c272ca18a61ed9be9b15f8056cd79e808eda08c3bda0f67b","755298359c30c774006fe4959207dd99b95ef4b33c360622be4f70c007ab6615","11236cba04cedb3866bc82b86352c1e618f0b6ec3d60df1fbf6f6c0d8b703925","db3ebcc93ad7a4866c930ce338d581f619345729278fb01befc6591415567bc9","ef2a39d1246fb3964b34a097bf3940d43dbe4d9b02db64ddeca151915117066c","55525520661b9c8e47f875304779f035f413971e2b12812b8e8cf9813560d8d1","4c817a0f59bbabd70397b8f7105aa3dfd98f5bf2babaeb7beafbcf040ff6d8a5","28fb0423d1973c6a033e5fa15835ed9fbaf47d1d2e13384894473ceb8ec6ed0b","7ef488a1b6ae3ede5e41a0e8afe14bae001585e44bbfdb298957f11b537e38ae"],"paragraph_range_zero_based":[25416,25439],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p25416"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"DAPS","paragraph_zero_based":25440},{"literal_text_all_w_t_and_m_t":"The field is optionally present, need N, in case masterCellGroup includes ReconfigurationWithSync, SCell(s) and SCG are  not configured, multi-DCI/single-DCI based multi-TRP are not configured in any DL BWP, supplementaryUplink is not configured, ethernetHeaderCompression is not configured for the DRB, conditionalReconfiguration is not configured, and NR sidelink and V2X sidelink are not configured. Otherwise the field is absent.","paragraph_zero_based":25441},{"literal_text_all_w_t_and_m_t":"MRBSetup","paragraph_zero_based":25442},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the corresponding multicast MRB is being setup; otherwise the field is optionally present, need M.","paragraph_zero_based":25443},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25444},{"literal_text_all_w_t_and_m_t":"–RadioLinkMonitoringConfig","paragraph_zero_based":25445},{"literal_text_all_w_t_and_m_t":"The IE RadioLinkMonitoringConfig is used to configure radio link monitoring for detection of beam- and/or cell radio link failure. See also TS 38.321 [3], clause 5.1.1.","paragraph_zero_based":25446},{"literal_text_all_w_t_and_m_t":"RadioLinkMonitoringConfig information element","paragraph_zero_based":25447},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25448},{"literal_text_all_w_t_and_m_t":"-- TAG-RADIOLINKMONITORINGCONFIG-START","paragraph_zero_based":25449},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25450},{"literal_text_all_w_t_and_m_t":"RadioLinkMonitoringConfig ::=       SEQUENCE {","paragraph_zero_based":25451},{"literal_text_all_w_t_and_m_t":"    failureDetectionResourcesToAddModList   SEQUENCE (SIZE(1..maxNrofFailureDetectionResources)) OF RadioLinkMonitoringRS","paragraph_zero_based":25452},{"literal_text_all_w_t_and_m_t":"                                                                                                                  OPTIONAL, -- Need N","paragraph_zero_based":25453},{"literal_text_all_w_t_and_m_t":"    failureDetectionResourcesToReleaseList  SEQUENCE (SIZE(1..maxNrofFailureDetectionResources)) OF RadioLinkMonitoringRS-Id","paragraph_zero_based":25454},{"literal_text_all_w_t_and_m_t":"                                                                                                                  OPTIONAL, -- Need N","paragraph_zero_based":25455},{"literal_text_all_w_t_and_m_t":"    beamFailureInstanceMaxCount             ENUMERATED {n1, n2, n3, n4, n5, n6, n8, n10}                          OPTIONAL, -- Need R","paragraph_zero_based":25456},{"literal_text_all_w_t_and_m_t":"    beamFailureDetectionTimer               ENUMERATED {pbfd1, pbfd2, pbfd3, pbfd4, pbfd5, pbfd6, pbfd8, pbfd10}  OPTIONAL, -- Need R","paragraph_zero_based":25457},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":25458},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":25459},{"literal_text_all_w_t_and_m_t":"    beamFailure-r17                         BeamFailureDetection-r17                                              OPTIONAL  -- Need R","paragraph_zero_based":25460},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":25461},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25462},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25463}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["0af25565a8b49fe264a7f52bd6ab5a9cd4f23e54f2f07d9e622b8e07dbbbe96a","0a0701673b06a0c