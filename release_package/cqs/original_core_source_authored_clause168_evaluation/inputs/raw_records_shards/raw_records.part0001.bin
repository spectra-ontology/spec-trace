c power control parameter for PUSCH, PUCCH and SRS.","paragraph_zero_based":30257},{"literal_text_all_w_t_and_m_t":"Uplink-PowerControl information element","paragraph_zero_based":30258},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":30259},{"literal_text_all_w_t_and_m_t":"-- TAG-UPLINK-POWERCONTROL-START","paragraph_zero_based":30260},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30261},{"literal_text_all_w_t_and_m_t":"Uplink-powerControl-r17  ::= SEQUENCE {","paragraph_zero_based":30262},{"literal_text_all_w_t_and_m_t":"    ul-powercontrolId-r17        Uplink-powerControlId-r17,","paragraph_zero_based":30263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["c7424e83d445edbcdf7109ec1999ea56bb8fcd7e20756db93abb2978530f38b4","aaa40d83a973474606548bf17f0b70aca5bcd0e535e6ca43429ad9f9b1528b2d","0401efea6e44ea7d3a23e5520dd68fc9423750271de0422cf1bc65276f6d8bf7","34d0434a1ead62d22cb1479f891a65c352be216194a67b084ce773de74952d35","a72e1b19570b43600f81983153e0f895a62a2bef5b071719e5c8ff982fea2f85","ead21dc0ad5b0988bcb91e835d8c6b4e07cfee0e03aed3642fbd99237916da3b","933a2b25e649aa94fba9cacbc2b0dfffd4e46e2e407cd33da48937252264773b","737aa435134b5e02b78b865058cd366d996405f135895809ed8ef5fd317f0841","67bca2279c9fdf41397ef26d7c1d859d17075d605f902c715371e037bddef8cb","4b0a95d85c3f9ca41bd56381bb9c9fba1ac9ee35daad20bf890b38dc6f97e36c","ab0a9f74a6149184b5af0ba391149a45f3daaed7ee8358897a128d0f3adbaa1c","f99903697a852b93123096cdc4963c3f5a808790a550e113207192fe0cd3134e","bd37e943677e6cbfd2b0485dbec123021bb3d3ba46c9b57eca688187d4b9c07c","113dfcce45fd6ee369d93abfe52134c287580a2c16e3351a572d77c8ee210d5c","972e20be0286dc04ee7f3a7a972df6e242ae026db9aa0efa83a5f7