table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"61f02ceef1d524906560f8f1a482d15e83f76eb00023609c334c63ed8d6c34a9","original_member_sha256":"f9c2336c81c37716b94a78c676bf5f6ace0ec61f8e01450cd0d55d702a9ad7ba","paragraph_ElementTree_utf8_XML_sha256":["879e3bfc5fa5a8e80ac202bbaa99f6b2729a90ee724a979b799a3b7a3fba515b","ab422d9753715558b2d083db95faf94e53816d31c49ab2240a3d1126dcf4492b","dc5f5b88ce2cba3fdff8b8813829840aa529ccdc8112dd9f40d6e83ef70f823b","957d8caffdd89e7d2f0261052ec27cc980f2e2a0020f64d7414a73e2427efeb1","1712d42c4742ba300c2e7392896017cc7b1827497c3cefda81e12ef2ad1a29bb","63cf6a90e9cd36d0879f64ed807f9cc75de5d21ddaedc1d7e49762ecc848dd0d","59c7f416eb2e08c9beeb19c597b524c7af864116a1da51c090f2f7d5710c82c0","4332ad461b93a915879c19bfae506fe0b6d02f61f95e68b818406e44b43cb4d2","50010dc84155f4ff6a1ae29f6846d3f61eca99d755eee0101751f5e18f658d67","e2bf9b30bbb4976319552eb58b4eb034ffcb7cd3fb465e8c9bac0d8c7b8849b1","92e2517c5a13cd30334f04de7f8a14ffefe863124884eeb596fd18efdc7a1c47","afe9f7bc6b60465cd30f9068e5f7e9b8bf20a58e2db04e744bd12ca61d9c6586","0bf1a66109a74e377baf63c18e06f78c24c9e37670f63976aa7010387165202b","a5e597fc200b148ae43a896a9fc8a9fdde559986ca6b3113d71926a01e6b7663","bffb1ffa6f4df510c4c8df026457b6ba4fde8aa20563f1c8224f5fd154558c6f","b1c3ef23288b6c7e6343178f139c991ef543cca21a58b3fc571158083f21ca8a","a1e355474e77af068fb33c21ab52b087a6e637adff70d866c1ece16cb5a756cb","a06311616982cc05997b801837613f6ab30d7dca570fb02647defad8d4ceac5f","3e71b455402576e5a750dfd66689701e88cfc336f7d82ac59154dfb0405148e2","c4cb4ea3a6f6374167bec7d6ab94138743500e540cc86b585688aa498798c755","ac357cc64b599797428729720a0645524000158aab00f090c2981f99830aaed6","a576420eea1a7c62685111672bb8c46c1e4c860a859e0cf429a8e1fbf7f79ae3","78eb4984030ba243ee76bc6972b6e24222d23195e1b6d74c92a82ba55b559334","c47e8a28486301df05dcff2b73914fdee8868d273d9bd6c8c5f4de3c722f3a1a"],"paragraph_range_zero_based":[24,47],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313691.zip::R2-2313691_Introduction of support for BWP operation without restriction in TS38.331.docx:p24"}
{"fields":{"filename":"R2-2313691.zip::R2-2313691_Introduction of support for BWP operation without restriction in TS38.331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"B","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Rel-18","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-16(Release 16)Rel-17(Release 17)Rel-18(Release 18)Rel-19(Release 19)","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":"Reason for change:","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"In RAN#100 meeting, a work item for BWP_Wor was revised in RP-231486. ","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"The specification need to support for BWP operation without restriction including Option B-1-1, Option B-1-2, and Option C as agreed in work item RP-231486.","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"RAN2 has agreed to reuse the legacy parameter for Option C (NCD-SSB), thus the corresponding description for NCD-SSB should be updated. ","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"In the WID, it is agreed NCD-SSB could be used for L3 intra-frequency measurement. Thus, the description for NCD-SSB in ServingCellMO and SMTC should be updated accordingly. ","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"Similar as RedCap, NCD-SSB based measurement could be also used for RACH resource selection. Thus, the corresponding description for NCD-SSB in RACH-ConfigCommon. ","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"In RAN4 LS in R2-2311750, it was agreed that: For UE capable of supporting Option B-1-1 capability and additionally supporting NeedForGap or NeedForGapNCSG or NeedForInterruption”, UE shall report no gap and no interruption/no NCSG for intra-frequency measurement.","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"Besides, some clarification on NCD-SSB are needed to clarify it could be configured for non-RedCap UE. ","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"Update the description for nonCellDefiningSSB to allow NCD-SSB based RLM/BFD/Beam management/RRM for non-RedCap UE. ","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"61f02ceef1d524906560f8f1a482d15e83f76eb00023609c334c63ed8d6c34a9","original_member_sha256":"f9c2336c81c37716b94a78c676bf5f6ace0ec61f8e01450cd0d55d702a9ad7ba","paragraph_ElementTree_utf8_XML_sha256":["5548ea596ad80e62c0a01ff2a66558fcde15635f23ed5d0740a421926b0cf321","03ce09537565dbb8c3e610871d1bfb7405dbbd6157ceaf549e31ceafe056a89a","165ece3fbffed2de63036ab4ed0988669b6b331628df57308cdba5b10c595319","94fdeca3c7a5ddc13011b2b23043486262004aef40081bbc2470c0752c9a79cf","2bc02e7cf55a04a731446eb13a39c729d7f0fa05a766bb5c2aa4ae8d75da8cf7","f8ee56f0ef6633f09f497f2b12ab22b207b27a54de74a51c1f77ce10534c726c","b28ca0fc976d0f20fff9512696bcb20182edb2b2025468939aa09bf62f38b1cb","c69bb8a1d2c14067268eda6d41c0a121287bfce8da916ad92220603742c916c2","8d09109b7683248a656e21c03fe87d71bcffe092d633916b6bbdab94d3e7a3e8","389f90e31fc3ebcc4aa53438029ad123c698340b9230596dd57c646bfd92b320","532b5575eaba29b5dd5adb8719db49f586b831edde3ef9e30faeddd9fca7950f","56c7a68c0fa32e30275ad386bfa4e8f7b433033196cb604ea3b4e24a377578f0","26aea2b6630f0f7b0db4961be4d13095394d85587d5af2582b0bd3c95f334803","0edc4ba2c7ed3ca4bb51a8b877f5c224e93e87f8c4e75bd590d875894407f2ce","460628e6a3cef6089f1842524991b53267882f01f41c2187e1e4dad9ccdfde0d","9e425a1b973c9f1ef7859a7d17a9187780624967a2a948b99dfd119f6c6294dc","dc7b97b25bc3d681cb482951582595c2a4a622cc88616182947f7def40ad2871","892310a422f629cf93fe9c4e7e5389e086fc315a5ab2d63463a5caf46e1fc462","4a11149bfa932c76904a0a08cb9035a7c0bcd381d021aba1359bfbee16810178","d69b20ef21f62f1394f6819924c59b6819dd86335db8e0ebe1beb3b35a980e95","cc39f15aba623b37bd368c9745cdd00fe2b11f871f6782ceb5ec406c3ee9be1b","90a4944f58a3e32d49200619d3f678c8ce3d904e2f071c307c9a532efe9f5f58","9117548cbe722a1a5eee84d66a552f961afc7f3590b1526728d2cfc8874939d0","4ee44571d65dfb185f4e8b85a18977977a82055ce58ff40de6fc5dab3fe57ecd"],"paragraph_range_zero_based":[48,71],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313691.zip::R2-2313691_Introduction of support for BWP operation without restriction in TS38.331.docx:p48"}
{"fields":{"filename":"R2-2313691.zip::R2-2313691_Introduction of support for BWP operation without restriction in TS38.331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Update the description for servingCellMO and smtc to allow NCD-SSB based intra-frequence L3 measurmeent for non-RedCap UE.","paragraph_zero_based":72},{"literal_text_all_w_t_and_m_t":"Update the description for rach-ConfigCommon to allow NCD-SSB based measurement could be also used for RACH resource selection.","paragraph_zero_based":73},{"literal_text_all_w_t_and_m_t":"Clarify For UE capable of supporting Option B-1-1 capability and additionally supporting NeedForGap or NeedForGapNCSG or NeedForInterruption”, UE shall report no gap and no interruption/no NCSG for intra-frequency measurement.","paragraph_zero_based":74},{"literal_text_all_w_t_and_m_t":"Updated the description for NCD-SSB to allow it could be configured for non-RedCap UE.","paragraph_zero_based":75},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":76},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":77},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":78},{"literal_text_all_w_t_and_m_t":"Specification does not support BWP operation without restriction for Option C, i.e. NCD-SSB based measurement. ","paragraph_zero_based":79},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":80},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":81},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":82},{"literal_text_all_w_t_and_m_t":"6.3.2","paragraph_zero_based":83},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":84},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":85},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":86},{"literal_text_all_w_t_and_m_t":"Y","paragraph_zero_based":87},{"literal_text_all_w_t_and_m_t":"N","paragraph_zero_based":88},