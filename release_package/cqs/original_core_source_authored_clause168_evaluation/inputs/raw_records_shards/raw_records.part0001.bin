{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21432},{"literal_text_all_w_t_and_m_t":"-- TAG-NSAG-ID-STOP","paragraph_zero_based":21433},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21434},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21435},{"literal_text_all_w_t_and_m_t":"–NSAG-IdentityInfo","paragraph_zero_based":21436},{"literal_text_all_w_t_and_m_t":"The IE NSAG-IdentityInfo is used to identify an NSAG (TS 23.501 [32]) for slice-based cell reselection.","paragraph_zero_based":21437},{"literal_text_all_w_t_and_m_t":"NSAG-IdentityInfo information element","paragraph_zero_based":21438},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21439},{"literal_text_all_w_t_and_m_t":"-- TAG-NSAG-IDENTITYINFO-START","paragraph_zero_based":21440},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21441},{"literal_text_all_w_t_and_m_t":"NSAG-IdentityInfo-r17 ::=            SEQUENCE {","paragraph_zero_based":21442},{"literal_text_all_w_t_and_m_t":"    nsag-ID-r17                          NSAG-ID-r17,","paragraph_zero_based":21443},{"literal_text_all_w_t_and_m_t":"    trackingAreaCode-r17                 TrackingAreaCode               OPTIONAL      -- Need R","paragraph_zero_based":21444},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21445},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21446},{"literal_text_all_w_t_and_m_t":"-- TAG-NSAG-IDENTITYINFO-STOP","paragraph_zero_based":21447},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21448},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21449},{"literal_text_all_w_t_and_m_t":"NSAG-IdentityInfo field descriptions","paragraph_zero_based":21450},{"literal_text_all_w_t_and_m_t":"trackingAreaCode","paragraph_zero_based":21451},{"literal_text_all_w_t_and_m_t":"If absent, UE assumes the trackingAreaCode of the serving cell.","paragraph_zero_based":21452},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21453},{"literal_text_all_w_t_and_m_t":"–NTN-Config","paragraph_zero_based":21454},{"literal_text_all_w_t_and_m_t":"The IE NTN-Config provides parameters needed for the UE to access NR via NTN access.","paragraph_zero_based":21455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["d2f94a604ac1a031553cdd34cc7fc4c3bad083b8fd8b156d71c1890dc34d3393","5f85d4482de76f0d3af19e35407d5a3cc5b4482bfcccc51f476f20fe01bdb323","32ab35401027048c946063ed93f635dfc1b83846efa1fd4944352370894ef9cf","1e97e5e52a4a584723e7a949197b4db0c57c44a4731fb9a7763ed4c5351c87e4","5bb6d608feacdbf53958183b0a353f865ec93e5927f3222b02d8101a5fbd7e31","ba5b34aa4914b8e9984a25f8e9f203fe5e29f2bebda8ae4722affb1ee3de118e","81189d9cdb1e1326899ccc2104efc935edfc69c1a8e15151b9a107e78b17496e","d010047c61d4d440bf3e5a0c28eb98d911893e453050d66580be9311d28d9235","82b5c10862e1a084ca8b7ec193607ae43605b008173c7151ec2f8881b884ec54","207d50d5c30973c253d3e73b7188faf45295590b00726f630b679879389849d5","b15c9fd4c979daa28a429c943a37e928f554c1ba103dfcb35171cce0db199710","90538faea42bfc0ed4bd31c3aafb7150dd981bf0563761097f326cd5869dd767","a94245a8a710958815ae042c099de68d284a3a028467a7d81fd950a5905493ba","2600e5be2bad76f5ff6e0d1b09bb558ba2eb3e9a0ab11fe56632116c412a85db","d9746dca66a91e70f4e395b847010ccf5bd40517ef9a5b8b5fb816050473adee","8289246ed614708e56e6dc051eb482a6757c525e98c1cf40dc1f2ba81543286c","a7248f0ee58335581d0086e767d4dadbc4b644d043e57b5cdf272c5696b39c34","e668e80ac3ece2c870967d578c4b69b3f36da5cc27f5cd1aeb8c61af6c3b7fc1","b8650c55543f5bceb6d416bc32b6059be