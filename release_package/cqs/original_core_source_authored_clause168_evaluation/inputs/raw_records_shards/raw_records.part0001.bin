{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>include coarseLocationInfo, if available;","paragraph_zero_based":5616},{"literal_text_all_w_t_and_m_t":"1>if the includeWLAN-Meas is configured in the corresponding reportConfig for this measId, set the wlan-LocationInfo of the locationInfo in the measResults as follows:","paragraph_zero_based":5617},{"literal_text_all_w_t_and_m_t":"2>if available, include the LogMeasResultWLAN, in order of decreasing RSSI for WLAN APs;","paragraph_zero_based":5618},{"literal_text_all_w_t_and_m_t":"1>if the includeBT-Meas is configured in the corresponding reportConfig for this measId, set the BT-LocationInfo of the locationInfo in the measResults as follows:","paragraph_zero_based":5619},{"literal_text_all_w_t_and_m_t":"2>if available, include the LogMeasResultBT, in order of decreasing RSSI for Bluetooth beacons;","paragraph_zero_based":5620},{"literal_text_all_w_t_and_m_t":"1>if the includeSensor-Meas is configured in the corresponding reportConfig for this measId, set the sensor-LocationInfo of the locationInfo in the measResults as follows:","paragraph_zero_based":5621},{"literal_text_all_w_t_and_m_t":"2>if available, include the sensor-MeasurementInformation;","paragraph_zero_based":5622},{"literal_text_all_w_t_and_m_t":"2>if available, include the sensor-MotionInformation;","paragraph_zero_based":5623},{"literal_text_all_w_t_and_m_t":"1>if the includeAltitudeUE is configured in the corresponding reportConfig for this measId:","paragraph_zero_based":5624},{"literal_text_all_w_t_and_m_t":"2>set the altitudeUE to include the altitude of the UE;","paragraph_zero_based":5625},{"literal_text_all_w_t_and_m_t":"1>if there is at least one applicable transmission resource pool for NR sidelink communication/discovery (for measResultsSL):","paragraph_zero_based":5626},{"literal_text_all_w_t_and_m_t":"2>set the measResultsListSL to include the CBR measurement results in accordance with the following:","paragraph_zero_based":5627},{"literal_text_all_w_t_and_m_t":"3>if the reportType is set to eventTriggered:","paragraph_zero_based":5628},{"literal_text_all_w_t_and_m_t":"4>include the transmission resource pools included in the poolsTriggeredList as defined within the VarMeasReportList for this measId;","paragraph_zero_based":5629},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":5630},{"literal_text_all_w_t_and_m_t":"4>include the applicable transmission resource pools for which the new measurement results became available since the last periodical reporting or since the measurement was initiated or reset;","paragraph_zero_based":5631},{"literal_text_all_w_t_and_m_t":"3>if the corresponding measObject concerns NR sidelink communication/discovery, then for each transmission resource pool to be reported:","paragraph_zero_based":5632},{"literal_text_all_w_t_and_m_t":"4>set the sl-poolReportIdentity to the identity of this transmission resource pool;","paragraph_zero_based":5633},{"literal_text_all_w_t_and_m_t":"4>set the sl-CBR-ResultsNR to the CBR measurement results on PSSCH and PSCCH of this transmission resource pool provided by lower layers, if available;","paragraph_zero_based":5634},{"literal_text_all_w_t_and_m_t":"NOTE 1:Void.","paragraph_zero_based":5635},{"literal_text_all_w_t_and_m_t":"1>if there is at least one applicable CLI measurement resource to report:","paragraph_zero_based":5636},{"literal_text_all_w_t_and_m_t":"2>if the reportType is set to cli-EventTriggered or cli-Periodical:","paragraph_zero_based":5637},{"literal_text_all_w_t_and_m_t":"3>set the measResultCLI to include the most interfering SRS resources or most interfering CLI-RSSI resources up to maxReportCLI in accordance with the following:","paragraph_zero_based":5638},{"literal_text_all_w_t_and_m_t":"4>if the reportType is set to cli-EventTriggered:","paragraph_zero_based":5639}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["e8f86a95f5464b61b28b536da70d533c1d913d7b91b39fd8aaba631808620609","14d1c9da267b49583755be8eff94c3c2bf7cb19381d50584eb481e1921fe56ca","ce0573be990cbe9eb71f21f6af77316e0f1d3da39e882ae058b8d0230dfb3293","d07a3e774265581d32aa331821b34594e521e24bd5c809677398e1aa09f08fd2","aaaceda54389fdead089e766bf9a842018a5c178799693641804231a4c3654f4","f496ac28eec2bac7ad851e897aa1c9647d4f20149a48a624bc84ab5a9b09ef57","575b8faf3d999913e3ff7f151634ff3e2404b8a98882d6f8eee09663be1543d5","979bdcbffe73a798afecb2ae2efa0767475a49fa8260be04dbbb09ea379f7588","1ed37577dde02c3c3000f8922a680c236b7bf95ae177fa2cf607a194a81c0d15","fbe1f7b89ff69746b07e6e7145940acc412cf64fd555265e1d480b0824b3a2e2","5f16c3325222a20f1aca0be711a9cb977d979c214d6f88092a41b130ff3c7109","1067d4e01b5b7127093b74caaa825a10cf85e166b7ce92cfef87cfcb14d06f9a","17c4733109c3482c4e485c810f4f132e180d765fd8fe9d9c0db520b996a2e0e1","73a695f6e3e4faa52cc0d0354daab58dc85d2ee314d121b434244986981a508a","66edca6328eb065cf767800128c722bf0370cf38e3a8b5e390cb17f9cbf49197","a416a8698359084d10a57dac90ed5ebf71e113af9b9d1b99a06999cc2ed1dd75","7749e884b24c1ba534458c47c691c58320272049adeb56148413a90a36c01bab","f2d75776f31727c733b91434c7ed2506de2e6416b1e5210d121b9530dbb36ce1","edf511babbf95c257d4872e4a023a599b7160beca61bfed2d6918060458d3149","d8a4ccf319ba2e390015b37f0317da667e1011ec4aaaa81257a757ba48a0b2a7","e496925c9e6df7b89321024c5020aef306bb63e78be1a739a2bcaf4a9dd6598d","bf0c8a2e69a21e76a3de7625d2484e6ca94b414830501df7453c28d99684059a","25f7c1a6daa9ec14be0b2aaaf513efebe86e910ec6161370c17537a8b605ad1b","83d59e0439cc3b75e173fd0d5d1a88e8229cbac68dc87b11c4d67b06560a8e5a"],"paragraph_range_zero_based":[5616,5639],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p5616"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5>if trigger quantity is set to srs-RSRP i.e. i1-Threshold is set to srs-RSRP:","paragraph_zero_based":5640},{"literal_text_all_w_t_and_m_t":"6>include the SRS resource included in the cli-TriggeredList as defined within the VarMeasReportList for this measId;","paragraph_zero_based":5641},{"literal_text_all_w_t_and_m_t":"5>if trigger quantity is set to cli-RSSI i.e. i1-Threshold is set to cli-RSSI:","paragraph_zero_based":5642},{"literal_text_all_w_t_and_m_t":"6>include the CLI-RSSI resource included in the cli-TriggeredList as defined within the VarMeasReportList for this measId;","paragraph_zero_based":5643},{"literal_text_all_w_t_and_m_t":"4>else:","paragraph_zero_based":5644},{"literal_text_all_w_t_and_m_t":"5>if reportQuantityCLI is set to srs-rsrp:","paragraph_zero_based":5645},{"literal_text_all_w_t_and_m_t":"6>include the applicable SRS resources for which the new measurement results became available since the last periodical reporting or since the measurement was initiated or reset;","paragraph_zero_based":5646},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":5647},{"literal_text_all_w_t_and_m_t":"6>include the applicable CLI-RSSI resources for which the new measurement results became available since the last periodical reporting or since the measurement was initiated or reset;","paragraph_zero_based":5648},{"literal_text_all_w_t_and_m_t":"4>for each SRS resource that is included in the measResultCLI:","paragraph_zero_based":5649},{"literal_text_all_w_t_and_m_t":"5>include the srs-ResourceId;","paragraph_zero_based":5650},{"literal_text_all_w_t_and_m_t":"5>set srs-RSRP-Result to include the layer 3 filtered measured results in decreasing order, i.e. the most interfering SRS resource is included first;","paragraph_zero_based":5651},{"literal_text_all_w_t_and_m_t":"4>for each CLI-RSSI resource that is included in the measResultCLI:","paragraph_zero_based":5652},{"literal_text_all_w_t_and_m_t":"5>include the rssi-ResourceId;","paragraph_zero_based":5653},{"literal_text_all_w_t_and_m_t":"5>set cli-RSSI-Result to include the layer 3 filtered measured results in decreasing order, i.e. the most interfering CLI-RSSI resource is included first;","paragraph_zero_based":5654},{"literal_text_all_w_t_and_m_t":"1>if there is at least one applicable UE Rx-Tx time difference measurement to report:","paragraph_zero_based":5655},{"literal_text_all_w_t_and_m_t":"2>set measResultRxTxTimeDiff to the latest measurement result;","paragraph_zero_based":5656},{"literal_text_all_w_t_and_m_t":"1>increment the numberOfReportsSent as defined within the VarMeasReportList for this measId by 1;","paragraph_zero_based":5657},{"literal_text_all_w_t_and_m_t":"1>stop the periodical reporting timer, if running;","paragraph_zero_based":5658},{"literal_text_all_w_t_and_m_t":"1>if the numberOfReportsSent as defined within the VarMeasReportList for this measId is less than the reportAmount as defined within the corresponding reportConfig for this measId:","paragraph_zero_based":5659},{"literal_text_all_w_t_and_m_t":"2>start the periodical reporting timer with the value of reportInterval as defined within the corresponding reportConfig for this measId;","paragraph_zero_based":5660},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":5661},{"literal_text_all_w_t_and_m_t":"2>if the reportType is set to periodical or cli-Periodical or rxTxPeriodical:","paragraph_zero_based":5662},{"literal_text_all_w_t_and_m_t":"3>remove the entry within the VarMeasReportList for this measId;","paragraph_zero_based":5663}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["54edf0d721e4d501f53c870c0f0b8c3eace958c1e664b10a3b34c746637be011","f621bf02395146e0ebdbcef314df4352bb5b28a394a3bb7d23f9026076f93aa3","bea983cc5e0b4981464c9279b38c476f8c6c6794fa10355fdb93e89164427d6c","c09f8875f00b5d7b34954bc8a8e093d5c6d4c1727b005548a97babf5b292bf64","13763601e1cdeff5b2a648510b8acbcf19d0c1e56463464730a69ecee05613cc","f4f0a28ac5919c4ea2f63f1cc1fcac80835ae8256a431a147efe944fd8934d62","a9887ef8397b5eeb073cb5cd5ef20d02479884056dbf8592f6282476b8e882a4","afe7efe45dca21049d32ba3fabec744aec4819ceeb347138c1ca180583b1e330","49090256dee24cd9ca98c68769cf8dca7cd6c071dc59b2a95fa3300cc55f8c69","445a4a588de0243f8b2fd6759c6d7ed087d8a8df392eb5610bde86a95f3cd4be","9594b53491bfaf6b686c27b17394c61cdd6166c2e2c3b0cbd5acb788ff6c2a75","96b9ebe7ea6855ecc0023d1a5325df6f01fccf762202282758a60b141c9bd944","97955763b0b7d268fbc346fd8045aa1a223137688e41f2f127a328079a67ef57","d4ffe3f81399b196d2d1d03587c9230e552b5424275db34dfc21fdc9ea889111","97cb32497f6fb74eb88f2e0ba2a41743a4bd832d05982352bb668eb29f1d3499","88182e1b238c9abd0d6419b2f3695be2197d339f8d3f7664d6385969191ee557","1b564b59e2293cc3f0a8c66a933cb7b4d6a269c599e9ce815f746e029146255b","96bfead74fc09531cc1a26b762719bd3a6da6b924e20333794e5a8f35f2ee2ee","01ca87f746a5f328c944ab639c45e47c9443589266e003a361c2b46bc7b975b8","d9847a7a360649c2a56b17e113690c36f282efba29bbb2c7b384d219429b9320","252177c51bdb3333e2b30ae26fa30dd8b6364a978c1f6c653ade8a99612a7484","6c8db343adac1c753b2c0d46b0fc87524b7fc4ff251627a0031faaa6695fb014","697daa69f4b889bfa346e24d2bc9165983f3de37fbabbe56310ab8451088ecb8","9221be367c87b7a8214bf5f0969cfbde9462f2c6fc1db245272e339f936a2004"],"paragraph_range_zero_based":[5640,5663],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p5640"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>remove this measId from the measIdList within VarMeasConfig;","paragraph_zero_based":5664},{"literal_text_all_w_t_and_m_t":"1>if the measurement reporting was configured by a sl-ConfigDedicatedNR received within the RRCConnectionReconfiguration:","paragraph_zero_based":5665},{"literal_text_all_w_t_and_m_t":"2>submit the MeasurementReport message to lower layers for transmission via SRB1, embedded in E-UTRA RRC message ULInformationTransferIRAT as specified TS 36.331 [10], clause 5.6.28;","paragraph_zero_based":5666},{"literal_text_all_w_t_and_m_t":"1>else if the UE is in (NG)EN-DC:","paragraph_zero_based":5667},{"literal_text_all_w_t_and_m_t":"2>if SRB3 is configured and the SCG is not deactivated:","paragraph_zero_based":5668},{"literal_text_all_w_t_and_m_t":"3>submit the MeasurementReport message via SRB3 to lower layers for transmission, upon which the procedure ends;","paragraph_zero_based":5669},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":5670},{"literal_text_all_w_t_and_m_t":"3>submit the MeasurementReport message via E-UTRA embedded in E-UTRA RRC message ULInformationTransferMRDC as specified in TS 36.331 [10].","paragraph_zero_based":5671},{"literal_text_all_w_t_and_m_t":"1>else if the UE is in NR-DC:","paragraph_zero_based":5672},{"literal_text_all_w_t_and_m_t":"2>if the measurement configuration that triggered this measurement report is associated with the SCG:","paragraph_zero_based":5673},{"literal_text_all_w_t_and_m_t":"3>if SRB3 is configured and the SCG is not deactivated:","paragraph_zero_based":5674},{"literal_text_all_w_t_and_m_t":"4>submit the MeasurementReport message via SRB3 to lower layers for transmission, upon which the procedure ends;","paragraph_zero_based":5675},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":5676},{"literal_text_all_w_t_and_m_t":"4>submit the MeasurementReport message via SRB1 embedded in NR RRC message ULInformationTransferMRDC as specified in 5.7.2a.3;","paragraph_zero_based":5677},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":5678},{"literal_text_all_w_t_and_m_t":"3>submit the MeasurementReport message via SRB1 to lower layers for transmission, upon which the procedure ends;","paragraph_zero_based":5679},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":5680},{"literal_text_all_w_t_and_m_t":"2>submit the MeasurementReport message to lower layers for transmission, upon which the procedure ends.","paragraph_zero_based":5681},{"literal_text_all_w_t_and_m_t":"5.5.5.2Reporting of beam measurement information","paragraph_zero_based":5682},{"literal_text_all_w_t_and_m_t":"For beam measurement information to be included in a measurement report the UE shall:","paragraph_zero_based":5683},{"literal_text_all_w_t_and_m_t":"1>if reportType is set to eventTriggered:","paragraph_zero_based":5684},{"literal_text_all_w_t_and_m_t":"2>consider the trigger quantity as the sorting quantity if available, otherwise RSRP as sorting quantity if available, otherwise RSRQ as sorting quantity if available, otherwise SINR as sorting quantity;","paragraph_zero_based":5685},{"literal_text_all_w_t_and_m_t":"1>if reportType is set to periodical:","paragraph_zero_based":5686},{"literal_text_all_w_t_and_m_t":"2>if a single reporting quantity is set to true in reportQuantityRS-Indexes;","paragraph_zero_based":5687}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["d4872e9046b1121c593ed09c771c045d2a215404c77f7731861d99b1c213c5ae","125f02003ac327c2abb32eaf3417b35a9fd3e1fc14fc6933c30b33c3154357bd","a53dd99bf884a66e753219aeecfb20ea94650b67cb1b83bdf3011195d50ab429","b7dc0359d67cbacac6d203af03910fda19e9d0ae92fc7ba086134b4053f4f0c5","70a5ac0c905d5ecfeeb16f3a93de7ae534a4849b6af328c4ade556aae7ceb19f","1b9c6d161cc8a2c5f059eaba8f5bbd652a5d75bd9da2bc98a8aba15cc8e30f8a","b59c678bab5816fac9b6fa13fefc6513d0478079a0407ff858a5fe3ed8c5cdf2","a3edf0ba1558f00e177ff8abd4748368429f8f0d720979026f1f2b9e56681ffc","85d5ee0d759d457013e0acc7ec0fd4e37f02c2e36d552c3c1e074523eb5cd876","56c9521f73c79ccf014cb8347e8392e6cbd7630ded407e9dd36e1acbcfbaa599","fea175ef8dcb0117148f755390d64be1311d1ef83369819024bfa0d0ba5f4bec","70f44ae273bedca4e8f40732e4073865d89a0c9071fbed546bca9f28f1ff9ff9","2a970c79da09edca46a3f899ffcc8b58e13564cfee9bfb9528f298f496a96a1d","c184389471845e1f2b39e60648aa791cc66c398fb6cf798c737ffd7d4c97a8be","7abc9bbc0be443809152c991f13c9e87cc3839991405d08535c7459717057cac","8c820d1045a2e2aa688411c6e96f49cf0fe1a0f2998009d46b4a5dcee4c35c86","5f3227ec29bf60840ebca690107bec433519ad4dc49e7af2e43a7b14d674f8d9","195f903fd9bcd189332296969373abe817896b321141cc39a2775be32dbf88cc","6df7e974b3b3e9ee7de9feaefef78331a001df32e0df9e827a669decdb6bb8b6","e372e00c526db7a3a0e17174d3fa0e9f95703d0ac8b84f25a64e050772be3a2d","fdc8c8865fa1ae79801629cbaec7347ebf5860949f1b1c25cea4361038fe47d8","aecdf05bf8a8a9814bc2e35c7ffe4984ec33d5481db7d2e943ba5a0ae82bc0e9","cda5fa2481877d74ab0e4cfc6f0ee1220605e5d89473e423c9d8e80f87d7e59b","2159228d999d83862f1aa6f8b037479186750e02361676af099509990bf67f41"],"paragraph_range_zero_based":[5664,5687],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p5664"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>consider the configured single quantity as the sorting quantity;","paragraph_zero_based":5688},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":5689},{"literal_text_all_w_t_and_m_t":"3>if rsrp is set to true;","paragraph_zero_based":5690},{"literal_text_all_w_t_and_m_t":"4>consider RSRP as the sorting quantity;","paragraph_zero_based":5691},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":5692},{"literal_text_all_w_t_and_m_t":"4>consider RSRQ as the sorting quantity;","paragraph_zero_based":5693},{"literal_text_all_w_t_and_m_t":"1>set rsIndexResults to include up to maxNrofRS-IndexesToReport SS/PBCH block indexes or CSI-RS indexes in order of decreasing sorting quantity as follows:","paragraph_zero_based":5694},{"literal_text_all_w_t_and_m_t":"2>if the measurement information to be included is based on SS/PBCH block:","paragraph_zero_based":5695},{"literal_text_all_w_t_and_m_t":"3>include within resultsSSB-Indexes the index associated to the best beam for that SS/PBCH block sorting quantity and if absThreshSS-BlocksConsolidation is included in the VarMeasConfig for the measObject associated to the cell for which beams are to be reported, the remaining beams whose sorting quantity is above absThreshSS-BlocksConsolidation;","paragraph_zero_based":5696},{"literal_text_all_w_t_and_m_t":"3>if includeBeamMeasurements is set to true, include the SS/PBCH based measurement results for the quantities in reportQuantityRS-Indexes for each SS/PBCH block index;","paragraph_zero_based":5697},{"literal_text_all_w_t_and_m_t":"2>else if the beam measurement information to be included is based on CSI-RS:","paragraph_zero_based":5698},{"literal_text_all_w_t_and_m_t":"3>include within resultsCSI-RS-Indexes the index associated to the best beam for that CSI-RS sorting quantity and, if absThreshCSI-RS-Consolidation is included in the VarMeasConfig for the measObject associated to the cell for which beams are to be reported, the remaining beams whose sorting quantity is above absThreshCSI-RS-Consolidation;","paragraph_zero_based":5699},{"literal_text_all_w_t_and_m_t":"3>if includeBeamMeasurements is set to true, include the CSI-RS based measurement results for the quantities in reportQuantityRS-Indexes for each CSI-RS index.","paragraph_zero_based":5700},{"literal_text_all_w_t_and_m_t":"5.5.5.3Sorting of cell measurement results","paragraph_zero_based":5701},{"literal_text_all_w_t_and_m_t":"The UE shall determine the sorting quantity according to parameters of the reportConfig associated with the measId that triggered the reporting:","paragraph_zero_based":5702},{"literal_text_all_w_t_and_m_t":"1>if the reportType is set to eventTriggered:","paragraph_zero_based":5703},{"literal_text_all_w_t_and_m_t":"2>for an NR cell, consider the quantity used in the aN-Threshold (for eventA1, eventA2, eventA4, eventA4H1 and eventA4H2) or in the a5-Threshold2 (for eventA5, eventA5H1 and eventA5H2) or in the aN-Offset (for eventA3, eventA3H1, eventA3H2 and eventA6) or in the x1-Threshold2 (for eventX1) as the sorting quantity;","paragraph_zero_based":5704},{"literal_text_all_w_t_and_m_t":"2>for an E-UTRA cell, consider the quantity used in the bN-ThresholdEUTRA as the sorting quantity;","paragraph_zero_based":5705},{"literal_text_all_w_t_and_m_t":"2>for an UTRA-FDD cell, consider the quantity used in the bN-ThresholdUTRA-FDD as the sorting quantity;","paragraph_zero_based":5706},{"literal_text_all_w_t_and_m_t":"2>for a candidate L2 U2N Relay UE, consider the yN-Threshold2-Relay as the sorting quantity;","paragraph_zero_based":5707},{"literal_text_all_w_t_and_m_t":"1>if the reportType is set to periodical:","paragraph_zero_based":5708},{"literal_text_all_w_t_and_m_t":"2>determine the sorting quantity according to reportQuantityCell for an NR cell, and according to reportQuantity for an E-UTRA cell, as below:","paragraph_zero_based":5709},{"literal_text_all_w_t_and_m_t":"3>if a single quantity is set to true:","paragraph_zero_based":5710},{"literal_text_all_w_t_and_m_t":"4>consider this quantity as the sorting quantity;","paragraph_zero_based":5711}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["08a78080bc0bf65ebb17349d4c570d45ce66163c02cbc331b6df9da98671ab35","2feba25e0a959fc549b84214617ba54d18fb5c3dd2fe3bd7521119ac1d6bad13","d50e9b10958613c498d63ea8667349d03e7b54e277ad7e9207a7eea5794e009b","ea8faf806a0a1174fc2be26b71eec9ce58b431f0967cce597431de811aa47d8f","d1a0e0d45d506d9fa775a513a1d0a9722127b0383b99f7629f1a531167118700","86d46cf4c1dd54535e39bb94f53064f94749105226ed95ce0ec347180b91d686","2158d05eceebcfdb9aa15bb57f7763b68347d1cddb409bca03e25fbc3eca0e66","deda44b39ea1928006d66cb8b1e83944d7bfaf3b3fc918c37d9f53ed3a7c4f62","d2c6560865aa699af7cb7ba830ad43e43f88787c10668b401fd81dac672d2d31","dd8a3ea5ed1bc731429b9a7ebc81562a892ac0128b5c3981e2f5b06af9e918b1","931b19f84b98bdcd82530d97abe3d453641b3ee620dab168b296c7e3c78cad44","bb2056716289a37f7478ec047801919adaf2f44fc1f49c5fae827c42b66550e8","cc86a618b4982e08e3f5c33a438e9a5f2e182c7371353b6ab49ab3dcb34eb8a9","6226011151654cbc08492328b8ea2d82a49f8ca648705a26bd65dd509857717e","755525a044a8826aa2d53f56cb969807ee0f9e340d3dd1fff9b13a7dec2d128d","7f9d156845ee2a939be471b2004b12c557ddeaad77554523709b4852d500a2cb","18e8550d9c40781fc0950069f1ad309c7eac5824ddcf0821cd4b5947b5874fd8","56c18f2e26f42fe2782b6c87921388e2aedc91da0d127d3856ab2e6b839aba58","29e883c556dd3f0a8ca85dc8b25c77a9c5348f6cad06834261936929213d7e4d","eeb72e2f76c315dad92f71cee932f37d94487d50a03bde0555fa61432e7daf0a","abb9a3b481362c256981ff4e21b7406be7a4aca050e6d256f7c3226ea8c1eb6d","49e9ed2e6a78777dd9d04145cea01fa30dcc5d5f8b1e1ab238458653a3d29379","377737d773a0c89cb1d6b395376ceab510cdcc9e929bade55fd8fad31bf5dbf2","c70d019344a6a40bfb96e4198b4d68972939df0226a9ce4646d8e3ae2ccdc533"],"paragraph_range_zero_based":[5688,5711],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p5688"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":5712},{"literal_text_all_w_t_and_m_t":"4>if rsrp is set to true;","paragraph_zero_based":5713},{"literal_text_all_w_t_and_m_t":"5>consider RSRP as the sorting quantity;","paragraph_zero_based":5714},{"literal_text_all_w_t_and_m_t":"4>else:","paragraph_zero_based":5715},{"literal_text_all_w_t_and_m_t":"5>consider RSRQ as the sorting quantity;","paragraph_zero_based":5716},{"literal_text_all_w_t_and_m_t":"2>determine the sorting quantity according to reportQuantityUTRA-FDD for UTRA-FDD cell, as below:","paragraph_zero_based":5717},{"literal_text_all_w_t_and_m_t":"3>if a single quantity is set to true:","paragraph_zero_based":5718},{"literal_text_all_w_t_and_m_t":"4>consider this quantity as the sorting quantity;","paragraph_zero_based":5719},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":5720},{"literal_text_all_w_t_and_m_t":"4>consider RSCP as the sorting quantity.","paragraph_zero_based":5721},{"literal_text_all_w_t_and_m_t":"2>for a candidate L2 U2N Relay UE, consider the reportQuantityRelay as the sorting quantity;","paragraph_zero_based":5722},{"literal_text_all_w_t_and_m_t":"5.5.6Location measurement indication","paragraph_zero_based":5723},{"literal_text_all_w_t_and_m_t":"5.5.6.1General","paragraph_zero_based":5724},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5725},{"literal_text_all_w_t_and_m_t":"Figure 5.5.5.1-1: Location measurement indication","paragraph_zero_based":5726},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to indicate to the network that the UE is going to start/stop location related measurements towards E-UTRA or NR (eutra-RSTD, nr-RSTD, nr-UE-RxTxTimeDiff, nr-PRS-RSRP) which require measurement gaps or start/stop detection of subframe and slot timing towards E-UTRA (eutra-FineTimingDetection) which requires measurement gaps. UE shall initiate this procedure only after successful AS security activation.","paragraph_zero_based":5727},{"literal_text_all_w_t_and_m_t":"NOTE:It is a network decision to configure the measurement gap.","paragraph_zero_based":5728},{"literal_text_all_w_t_and_m_t":"5.5.6.2Initiation","paragraph_zero_based":5729},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5730},{"literal_text_all_w_t_and_m_t":"1>if and only if upper layers indicate to start performing location measurements towards E-UTRA or NR or start subframe and slot timing detection towards E-UTRA, and the UE requires measurement gaps for these operations while measurement gaps are either not configured or not sufficient:","paragraph_zero_based":5731},{"literal_text_all_w_t_and_m_t":"2>if preconfigured measurement gaps for positioning and posMG-Request are configured and the UE considers that at least one of the preconfigured measurement gaps for positioning is sufficient for the location measurement when activated:","paragraph_zero_based":5732},{"literal_text_all_w_t_and_m_t":"3>trigger the lower layers to initiate the measurement gap activation request using UL MAC CE as specified in TS 38.321 [3];","paragraph_zero_based":5733},{"literal_text_all_w_t_and_m_t":"2> else:","paragraph_zero_based":5734},{"literal_text_all_w_t_and_m_t":"3>initiate the procedure to indicate start as specified in clause 5.5.6.3;","paragraph_zero_based":5735}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["cf1b46c360024e7a4484e588c4733dcced643bab50ae5c9fb0969685df14cc8a","65787939aaeeb97bd6d14f4981346dba9a6c0a43174c5fe83c02d147c21a26eb","dff640ddd0932ad16d69a1c0b199115c14556aeb9d2c807cac677f14e7d42957","12e5ce878bff3013f97ea406c396c6a637f7a7cf78c3ac728aaab0c81736927b","76693f630ac7647703a13a5ac7e8747f66c3366fc98a4538b114941920fa3103","96b0e04251e6d2cffd620b958daf31c4a952da6480981878f9a70248e1fac6f4","424710d2f73890dc298a61bf91396df6d2cdd7863c62f80667dbafefe02dbc1a","47de967b4599db46dbf1ca1826626ab10f0a199f04ec881a8b584fc025271c29","c2048d36c0ed8a7ea677f2ac3de37c7b4777a22edd869a80172decad0170ed55","3d604dc21e9a7759d191abb2de6b515482ee20ab20389d1aa8c8b2213cafb2ba","b3c98acb9dc195b2f1c6b6137a79b130194835ca59eedce50291093e5b09bfe9","4bf03b604241a0587c58b4b1c2652f0b5aa01429b17e8472f9973620257ce578","c8109bd80fc8c71979db2037b181308006b41b52cbeb9e5aeb358646d63619ed","6e6d5a0818e23c62b1056c01346d3eb94dbfd319c6bd900908e2322f6d99dde3","b0695c1634a6e067353fdddaff652f45a7ffe0613538c96d0ad8b16588fae71c","013d35c9a7e22f1eadcb7e3862d775c7ee39ed072555f7b3cc4b9f8971e75608","063b6c98b7fb990258187063c0ac2dec8c926788a6a9deb6c87c72aa928c3da0","e38f3e50f158830f70a96a08c661e4625bc47f7267e1eb27e5376bf29f4c2738","3dfcef3cbd6d117f2c86daa702d59b164e3f2f8a8756df7a02f627d9ead97e95","2fee8e098649942ca3bb29a92fc661d375e188fc2d83eafc9d5f2e350401983f","069ee8ab93033ad679cfca66525d4767584699ce597d613e66fe66ed65bcd955","a941f2fda8437219fcc6492fd6c40eb1adfcb3a3615bf11d5c0a594f527bbadc","438d46e0b64061a90d4dc747a99c5c32968d064e8dfcb0c7af0b930f3779acb1","5dc711b71595ef8b053dab385b7b7db07b2886fb4ab48b07fe080d3170865aeb"],"paragraph_range_zero_based":[5712,5735],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p5712"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"NOTE 1:The UE verifies the measurement gap situation only upon receiving the indication from upper layers. If at this point in time sufficient gaps are available, the UE does not initiate the procedure. Unless it receives a new indication from upper layers, the UE is only allowed to further repeat the procedure in the same PCell once per frequency of the target RAT if the provided measurement gaps are insufficient.","paragraph_zero_based":5736},{"literal_text_all_w_t_and_m_t":"NOTE 1a:When indication is received from upper layers for performing location measurement and there is pre-configured measurement gap configured (not preconfigured measurement gap for positioning), the UE considers this preconfigured measurement gap to be not sufficient if the measurement gap is not considered to be always activated according to clause 9.1.7.2 of TS 38.133 [14].","paragraph_zero_based":5737},{"literal_text_all_w_t_and_m_t":"1>if and only if upper layers indicate to stop performing location measurements towards E-UTRA or NR or stop subframe and slot timing detection towards E-UTRA:","paragraph_zero_based":5738},{"literal_text_all_w_t_and_m_t":"2>if there is no activated preconfigured measurement gap for positioning:","paragraph_zero_based":5739},{"literal_text_all_w_t_and_m_t":"3>if there is previously triggered UL MAC CE transmission for the measurement gap activation for positioning:","paragraph_zero_based":5740},{"literal_text_all_w_t_and_m_t":"4>indicate to the lower layers to cancel the triggered UL MAC CE transmission for the measurement gap activation as specified in TS 38.321 [3];","paragraph_zero_based":5741},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":5742},{"literal_text_all_w_t_and_m_t":"4>initiate the procedure to indicate stop as specified in 5.5.6.3.","paragraph_zero_based":5743},{"literal_text_all_w_t_and_m_t":"2>else if there is activated preconfigured measurement gap for positioning:","paragraph_zero_based":5744},{"literal_text_all_w_t_and_m_t":"3>trigger the lower layers to deactivate all the activated measurement gap(s) for positioning as specified in TS 38.321 [3].","paragraph_zero_based":5745},{"literal_text_all_w_t_and_m_t":"NOTE 2:The UE may initiate the procedure to indicate stop even if it did not previously initiate the procedure to indicate start.","paragraph_zero_based":5746},{"literal_text_all_w_t_and_m_t":"5.5.6.3Actions related to transmission of LocationMeasurementIndication message","paragraph_zero_based":5747},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of LocationMeasurementIndication message as follows:","paragraph_zero_based":5748},{"literal_text_all_w_t_and_m_t":"1>if the procedure is initiated to indicate start of location related measurements:","paragraph_zero_based":5749},{"literal_text_all_w_t_and_m_t":"2>if the procedure is initiated for RSTD measurements towards E-UTRA:","paragraph_zero_based":5750},{"literal_text_all_w_t_and_m_t":"3>set the measurementIndication to the eutra-RSTD according to the information received from upper layers;","paragraph_zero_based":5751},{"literal_text_all_w_t_and_m_t":"2>else if the procedure is initiated for positioning measurement towards NR:","paragraph_zero_based":5752},{"literal_text_all_w_t_and_m_t":"3>set the measurementIndication to the nr-PRS-Measurement according to the information received from upper layers;","paragraph_zero_based":5753},{"literal_text_all_w_t_and_m_t":"1>else if the procedure is initiated to indicate stop of location related measurements:","paragraph_zero_based":5754},{"literal_text_all_w_t_and_m_t":"2>set the measurementIndication to the value release;","paragraph_zero_based":5755},{"literal_text_all_w_t_and_m_t":"1>if the procedure is initiated to indicate start of subframe and slot timing detection towards E-UTRA:","paragraph_zero_based":5756},{"literal_text_all_w_t_and_m_t":"2>set the measurementIndication to the value eutra-FineTimingDetection;","paragraph_zero_based":5757},{"literal_text_all_w_t_and_m_t":"1>else if the procedure is initiated to indicate stop of subframe and slot timing detection towards E-UTRA:","paragraph_zero_based":5758},{"literal_text_all_w_t_and_m_t":"2>set the measurementIndication to the value release;","paragraph_zero_based":5759}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["b84706bf1704be4a0ec8e47da0db53857bc8e613e74f4fd6538009f99e0bbfcf","35547d4c16716e28d3b29675128d2680e175749731c15db7a6bc7fcfe1b09132","e3c325b6714bb1e3685003b9473de6239e87fbafcadcff84f434a75f88350884","af8884d796029090891611fa7c621f1a1f8e528c232b309a0c83f41a3ad488ba","6e0bb6b3141f9137e193006843934a86f7246ca3ffdd60e8be4be590c7104088","510ae0d0fa1d2c3c89e8c642630151bd744c96a86c7762c3c8fa2ee2ae4dcd2b","ff3f8522612b668ccb32efdab1b5248d7d623fae1ba5339498221a0632ec975c","d33f736984b8bf4898f6f289bebb1fe48393ce0fa511ffc935bc7a491001c451","8fc821794e6886d0201582ffa47c212ea4d75f9a1d92b6289e11b91db84cd2d8","9e16cea82fe4234bee2f9946c5c47ddab8e91d28de5172fa5310b5dde07128aa","42a94834c8d15df3cc2bcff8a82ccffbdd62ea0344b2d9f0345a2a24b323ca18","492bce2f734cc668335b6a2a59422ee0a8b91bcec2ff8e13f6aad7c18e9e158e","91b3db51a2820f2082421475f46c15d1eac605b2a7a9459c1231e5b21d2e149c","0f761d3bf5bd7f6c65f5d2d3270c0046301c0f2c4b0a32a2570eca148ab066a1","eddd821fe8d6e371fd032e69c9ab5fcd40470c52b69f73bfbe12040ed50a328d","569f1f1e71f65f34c3f5a54b51ea7787dfca6b81f2eaa89f0b016afe2b80017a","94bc3763651c4befecde1389139d6e660c5a6c0dbf335c9270b990b82dc213d5","85e70600ced4fe248f4546ee5cbd6a2dfe1362a79af6f90b44e3807b25877332","7e2894f07bd8127161bc8c1b363196a536e1bd203c1212c25feffb5b9536b9f3","dcddf93a163e1213da18e2370da28bcb11609b76e0fe7ba44f6089816c0cb0d3","ca47d24302de0e66479fd9d5bc0a96c051b0bba5fff8a2de215dee4f0c2a0a5e","da2ef5c3025f2c67682762100a9c05c5a4c909c3a599d11511ccf945154b56a5","004aefbfe10e57fa1783b8bdb78aa30b006db7d43058e900d6625620f287973b","688a9f2ae33474e243121f819c2995d9b4ce3d4bab8ff5316bafe7a8996a519d"],"paragraph_range_zero_based":[5736,5759],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p5736"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>submit the LocationMeasurementIndication message to lower layers for transmission, upon which the procedure ends.","paragraph_zero_based":5760},{"literal_text_all_w_t_and_m_t":"5.5aLogged Measurements","paragraph_zero_based":5761},{"literal_text_all_w_t_and_m_t":"5.5a.1Logged Measurement Configuration","paragraph_zero_based":5762},{"literal_text_all_w_t_and_m_t":"5.5a.1.1General","paragraph_zero_based":5763},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5764},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5765},{"literal_text_all_w_t_and_m_t":"Figure 5.5a.1.1-1: Logged measurement configuration","paragraph_zero_based":5766},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to configure the UE to perform logging of measurement results while in RRC_IDLE and RRC_INACTIVE. The procedure applies to logged measurements capable UEs that are in RRC_CONNECTED.","paragraph_zero_based":5767},{"literal_text_all_w_t_and_m_t":"NOTE:NG-RAN may retrieve stored logged measurement information by means of the UE information procedure.","paragraph_zero_based":5768},{"literal_text_all_w_t_and_m_t":"5.5a.1.2Initiation","paragraph_zero_based":5769},{"literal_text_all_w_t_and_m_t":"NG-RAN initiates the logged measurement configuration procedure to UE in RRC_CONNECTED by sending the LoggedMeasurementConfiguration message.","paragraph_zero_based":5770},{"literal_text_all_w_t_and_m_t":"5.5a.1.3Reception of the LoggedMeasurementConfiguration by the UE","paragraph_zero_based":5771},{"literal_text_all_w_t_and_m_t":"Upon receiving the LoggedMeasurementConfiguration message the UE shall:","paragraph_zero_based":5772},{"literal_text_all_w_t_and_m_t":"1>discard the logged measurement configuration as well as the logged measurement information as specified in 5.5a.2;","paragraph_zero_based":5773},{"literal_text_all_w_t_and_m_t":"1>store the received loggingDuration, reportType and areaConfiguration, if included, in VarLogMeasConfig;","paragraph_zero_based":5774},{"literal_text_all_w_t_and_m_t":"1>if the LoggedMeasurementConfiguration message includes plmn-IdentityList:","paragraph_zero_based":5775},{"literal_text_all_w_t_and_m_t":"2>set plmn-IdentityList in VarLogMeasReport to include the RPLMN as well as the PLMNs included in plmn-IdentityList;","paragraph_zero_based":5776},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":5777},{"literal_text_all_w_t_and_m_t":"2>set plmn-IdentityList in VarLogMeasReport to include the RPLMN;","paragraph_zero_based":5778},{"literal_text_all_w_t_and_m_t":"1>store the received absoluteTimeInfo, traceReference, traceRecordingSessionRef, and tce-Id in VarLogMeasReport;","paragraph_zero_based":5779},{"literal_text_all_w_t_and_m_t":"1>store the received bt-NameList, if included, in VarLogMeasConfig;","paragraph_zero_based":5780},{"literal_text_all_w_t_and_m_t":"1>store the received wlan-NameList, if included, in VarLogMeasConfig;","paragraph_zero_based":5781},{"literal_text_all_w_t_and_m_t":"1>store the received sensor-NameList, if included, in VarLogMeasConfig;","paragraph_zero_based":5782},{"literal_text_all_w_t_and_m_t":"1>start timer T330 with the timer value set to the loggingDuration;","paragraph_zero_based":5783}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["20ed314bf0941a7853c3d9ad448c95b5e0aea592d335a0bb02d8d71fdf138d12","3c88140b9546604b99d99f43dfa57c45dceaab6a4fc445aa468fd2bb619c3b34","80b8f73857d06074d47b00850c637e99450bae170abf6cbdd499819c16ac8e7b","7151761c2e0963008aafe87d0adf469efec1b9f612bc55315c7bcdf79c441f8a","1d0eb7d5b0bd02b63b983b6b8514a6f0f348951a52032e4fe4241d443c4fa69e","5a1688e193b71e2a35a38d119a9f1451cefb12a3b9659525d0f52c5d729a0f51","224585f39a5a517e053da969b4c06a2aa0599a7d48986e0e93155cdd96678256","6f2fbee23489405b91988ad92af2b53792b4338be1704e334511b5c1337f8197","6a78c046c07a2be959a94137f601a361084010f1bf89d8909e674dca7a80007d","8d74d56a9767220e8b83a2dbe4717e03a5c282f76e4a7460aa92549704a10528","63baba6083de3f3a9e5e552496156405ad9744dc2adea37d5780abb8031b0cee","7ac5ad095ace5db09851bc505b0b55f7325307762ed9c84663e93e11995283d8","75a5bbb37c0fd78084456430d4cf92b9dbab44ddb036a6a61036bcd5c2237f36","55abab12c696ce5e2abd80ad88193e89e261ec072f302e9dd4b4261adc49283e","83d777822c7a810a6cd281f7f5a98644222f8a32a4466f6f5379a77731704134","e468ab0971540a6141d38151ab09d2d343e0e157016057edfe22684e0a04b22e","79bc9d84c8f8a0019aa6080702ae2e43fed7924c1fd79a2a17a144e6f506fef7","66fb5fb05dafd3145b5ebf28abaf70892baae3d0376f9d2d7a2b54444adfa16b","8e781b3add7a7365c49bdae843c23528cd26f05d51f1b26c6013467892e2e28a","7318af61eb9da3bcff4837797694d1cc33676fc8389832c5f4318ced3533895b","0e66d281189b4586cb3b4cfc598795880aeb83ef27ed21f504e84c2c0e3e44d1","ed8ad2207651469fad328e54d76560559d6af309570eac4d635017cea152b1d4","7d2c6d2ec167f2bba157212c12dad4df08cbdb101fca4dd7e890326cedb92e3c","fec65a5472e3cbd5162b93230bc1b2f0aac33f4efc836f3c5445877e996fe4aa"],"paragraph_range_zero_based":[5760,5783],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p5760"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>store the received sigLoggedMeasType, if included, in VarLogMeasReport;","paragraph_zero_based":5784},{"literal_text_all_w_t_and_m_t":"1>store the received earlyMeasIndication, if included, in VarLogMeasConfig;","paragraph_zero_based":5785},{"literal_text_all_w_t_and_m_t":"5.5a.1.4T330 expiry","paragraph_zero_based":5786},{"literal_text_all_w_t_and_m_t":"Upon expiry of T330 the UE shall:","paragraph_zero_based":5787},{"literal_text_all_w_t_and_m_t":"1>release VarLogMeasConfig;","paragraph_zero_based":5788},{"literal_text_all_w_t_and_m_t":"The UE is allowed to discard stored logged measurements, i.e. to release VarLogMeasReport, 48 hours after T330 expiry.","paragraph_zero_based":5789},{"literal_text_all_w_t_and_m_t":"5.5a.2Release of Logged Measurement Configuration","paragraph_zero_based":5790},{"literal_text_all_w_t_and_m_t":"5.5a.2.1General","paragraph_zero_based":5791},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to release the logged measurement configuration as well as the logged measurement information.","paragraph_zero_based":5792},{"literal_text_all_w_t_and_m_t":"5.5a.2.2Initiation","paragraph_zero_based":5793},{"literal_text_all_w_t_and_m_t":"The UE shall initiate the procedure upon receiving a logged measurement configuration in same or another RAT. The UE shall also initiate the procedure upon power off or upon deregistration.","paragraph_zero_based":5794},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5795},{"literal_text_all_w_t_and_m_t":"1>stop timer T330, if running;","paragraph_zero_based":5796},{"literal_text_all_w_t_and_m_t":"1>if stored, discard the logged measurement configuration as well as the logged measurement information, i.e. release the UE variables VarLogMeasConfig and VarLogMeasReport.","paragraph_zero_based":5797},{"literal_text_all_w_t_and_m_t":"5.5a.3Measurements logging","paragraph_zero_based":5798},{"literal_text_all_w_t_and_m_t":"5.5a.3.1General","paragraph_zero_based":5799},{"literal_text_all_w_t_and_m_t":"This procedure specifies the logging of available measurements by a UE in RRC_IDLE and RRC_INACTIVE that has a logged measurement configuration. The actual process of logging within the UE, takes place in RRC IDLE state could continue in RRC INACTIVE state or vice versa.","paragraph_zero_based":5800},{"literal_text_all_w_t_and_m_t":"5.5a.3.2Initiation","paragraph_zero_based":5801},{"literal_text_all_w_t_and_m_t":"While T330 is running and SDT procedure is not ongoing, the UE shall:","paragraph_zero_based":5802},{"literal_text_all_w_t_and_m_t":"1>if measurement logging is suspended:","paragraph_zero_based":5803},{"literal_text_all_w_t_and_m_t":"2>if during the last logging interval the IDC problems detected by the UE is resolved, resume measurement logging;","paragraph_zero_based":5804},{"literal_text_all_w_t_and_m_t":"1>if not suspended, perform the logging in accordance with the following:","paragraph_zero_based":5805},{"literal_text_all_w_t_and_m_t":"2>if the reportType is set to periodical in the VarLogMeasConfig:","paragraph_zero_based":5806},{"literal_text_all_w_t_and_m_t":"3>if the UE is in any cell selection state (as specified in TS 38.304 [20]):","paragraph_zero_based":5807}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["a200c44c2ceaddfeadfd9bffe3f035dbf111e29c9919551b79e2095e26ea0a7b","3a8e55728f7f01b58b12afad287e2de4399e6b24f71a7f133ed3b3984acbf678","6b3f58fb43af4284b5cf7abba8928aaad42eb06151251201aa6e98a5b82b5328","7f5019c640e27e2beec9d7866277b48a333c6539c4c42a22f34821704e1b8e50","f51722705a13f4df48f7d225c7c79c8b3e756b1ed7f52c224c236298137b5f70","fe6491865206b40b34f9ef8b6b9225a4bdbc1af87eb3d28d4123772594063fc6","4a291960abbe83a6d59c44596b1e02e29a5bbf3584a02a1c5a4e69c872a15d6d","d784ec86dcd24ee5a141a9f511179bf1dc7130697186aee80163f79307af1e1a","4c42c7740c9fc7c1c887cc0f5291d77da31f352ec21e4b2b0841c7601b71c8be","5ad18b8fb0a3b07484a32596f90f4ba323ce76bcc82731d9488c2de9cbbdf1d7","2d5a03a99c69d00beeb3251467a9b38a89396f770df12b8b2d512de1e37fec0e","0619787fb1d0c606a9b6392fdbdcbe3898f9c8a2e7b08f6232272fa2541f5948","dfe706219e1a90d7b8ec094c384490b4273878286baf8509f41a777bb6146f9c","d8282b67e53bd46858de7d17cf9c456f7e142f0dbb5753e3ec05033b0f09512a","435a94196f20f386883655f247a7f1949eb5c604b8a49c70d695e9a6b53acdab","ee159687c9e81fa30bdddd2115cc3c97cf5c54906c363b5f4c614c92b1313999","9ad7aa32c62bdb560cca62a7ae5b40e6b08f6da470631807b36c7bff6b3a6b12","f3d79bd37498064f708a5a8938c8a0eac8df3914da40dba9e4c38f8203a8af89","42ec02746ea4834172eecf258abbb87274874aa5f4ee4b5aa7b2571b7bcf74f3","57aaeb31ec8297dfb035edde61761a4bc42ac560e4bac26e0ff90dad7c50fd06","5fcfd2930455374a0e0bf2e1564c4af3db3f3bca277d6308202a2998351b82f5","0acb551caa3fd500e35f10692344baaec39d8b4d2a9581cd5d357311f8d4fe8c","580b20392308c612da94a5c29401d53c712f1dc307619566ac058bb9868404c1","729a4247882b6ec366c9a6e654bcad1141a4370a35ebbc8b91a68204072d9930"],"paragraph_range_zero_based":[5784,5807],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p5784"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>perform the logging at regular time intervals, as defined by the loggingInterval in the VarLogMeasConfig;","paragraph_zero_based":5808},{"literal_text_all_w_t_and_m_t":"3>if the UE is in camped normally state on an NR cell and if the RPLMN is included in plmn-IdentityList stored in VarLogMeasReport:","paragraph_zero_based":5809},{"literal_text_all_w_t_and_m_t":"4>if areaConfiguration is not included in VarLogMeasConfig; or","paragraph_zero_based":5810},{"literal_text_all_w_t_and_m_t":"4>if the serving cell is part of the area indicated by areaConfig in areaConfiguration in VarLogMeasConfig:","paragraph_zero_based":5811},{"literal_text_all_w_t_and_m_t":"5>perform the logging at regular time intervals, as defined by the loggingInterval in the VarLogMeasConfig;","paragraph_zero_based":5812},{"literal_text_all_w_t_and_m_t":"2>else if the reportType is set to eventTriggered, and eventType is set to outOfCoverage:","paragraph_zero_based":5813},{"literal_text_all_w_t_and_m_t":"3>perform the logging at regular time intervals as defined by the loggingInterval in VarLogMeasConfig only when the UE is in any cell selection state;","paragraph_zero_based":5814},{"literal_text_all_w_t_and_m_t":"3>upon transition from any cell selection state to camped normally state in NR:","paragraph_zero_based":5815},{"literal_text_all_w_t_and_m_t":"4>if the RPLMN is included in plmn-IdentityList stored in VarLogMeasReport; and","paragraph_zero_based":5816},{"literal_text_all_w_t_and_m_t":"4>if areaConfiguration is not included in VarLogMeasConfig or if the current camping cell is part of the area indicated by areaConfig of areaConfiguration in VarLogMeasConfig:","paragraph_zero_based":5817},{"literal_text_all_w_t_and_m_t":"5>perform the logging;","paragraph_zero_based":5818},{"literal_text_all_w_t_and_m_t":"2>else if the reportType is set to eventTriggered and eventType is set to eventL1:","paragraph_zero_based":5819},{"literal_text_all_w_t_and_m_t":"3>if the UE is in camped normally state on an NR cell and if the RPLMN is included in plmn-IdentityList stored in VarLogMeasReport:","paragraph_zero_based":5820},{"literal_text_all_w_t_and_m_t":"4>if areaConfiguration is not included in VarLogMeasConfig; or","paragraph_zero_based":5821},{"literal_text_all_w_t_and_m_t":"4>if the serving cell is part of the area indicated by areaConfig in areaConfiguration in VarLogMeasConfig;","paragraph_zero_based":5822},{"literal_text_all_w_t_and_m_t":"5>perform the logging at regular time intervals as defined by the loggingInterval in VarLogMeasConfig only when the conditions indicated by the eventL1 are met;","paragraph_zero_based":5823},{"literal_text_all_w_t_and_m_t":"2>when performing the logging:","paragraph_zero_based":5824},{"literal_text_all_w_t_and_m_t":"3> if InterFreqTargetInfo is configured and if the UE detected IDC problems on at least one of the frequencies included in InterFreqTargetInfo or any inter-RAT frequency during the last logging interval, or","paragraph_zero_based":5825},{"literal_text_all_w_t_and_m_t":"3>if InterFreqTargetInfo is not configured and if the UE detected IDC problems during the last logging interval:","paragraph_zero_based":5826},{"literal_text_all_w_t_and_m_t":"4>if measResultServingCell in the VarLogMeasReport is not empty:","paragraph_zero_based":5827},{"literal_text_all_w_t_and_m_t":"5>include inDeviceCoexDetected;","paragraph_zero_based":5828},{"literal_text_all_w_t_and_m_t":"5>suspend measurement logging from the next logging interval;","paragraph_zero_based":5829},{"literal_text_all_w_t_and_m_t":"4>else:","paragraph_zero_based":5830},{"literal_text_all_w_t_and_m_t":"5>suspend measurement logging;","paragraph_zero_based":5831}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["645d898497660cab35d7393517fc549daf39b6c48b8d121851fa0ca2be9c0a8d","05b52656fce3296c81e76ae5f5ea8d8b8b9d98025f7474a8a90be6aeba1a83ab","8f9c6658f03d9ba7a9647a31c983ea057db75424f5fa0e9f2d580f06a0c6536f","7201d9e996d7939270c65793339caa97eb2f183010d16a89cd598ac8184318d3","69059c872bd7d5967ece14b05c45dfdfef0d92ac20287968ff3db94be28a6391","35fb2e3fac0544583419c91cbfbc3ddcc3d37dbaab11232f0bf8c2d1a74d2ca1","3b0b7f8d0b901b92e4f24eb684db7a16bc8d75c2c1ae45f34f9c1fe15398c363","8950b0900f0e5b36c0c472c6b0b0802515ec1e6d94af90cb5bd03495c1aadf76","0ada768b1ef104d39c298512179ecd2470e3c4d18373db92cdab519857a5db7b","6d99287a297f062ca7864a03b2ef2055599d1bb21f6a3d2ce2556293139c0570","f47cd18d269558aa06dc8fa25e418de1a1bfd1d28a35e715d27a3a3dfc61c1bb","64a898792962b5c75d9b79a2fb4cafbbfc0007d74368541a8a25f8b7500fee49","f1b5ab8c80cef99f977be46fa078083b58f334c5dc63cabb4f8393abe005eb0a","2e07924c3fc5c505be8ca9962c0667b077881c9bed95ba49a0ba702752b00954","4610d7b1b88968038f7ffec20f73d0716f9c512bdf05eee69a932572dee502ce","d57047690cf0c358e5d6d4fb8991cc4405cfed77da19d3f34e2451d839c0ca4c","549afd28505798aea520cfd3a7281d07b541e7d85a3d61a88349a8aac611d36b","8c1fe4f2ce00b32ca2899cffde0adef016765736ce981794957d1f6ac006fa18","d7349266f7adbb5af114afa7e6bf2d5ec77a9f488748b70d9407171c11e779a9","c58bdc990111b322aa753faea5fabb448305ab2898e6c2516488bb81d25422f5","45fe0d50e6417c420cda360593efc134fece2392add8a18d40fd5ba0dcaac6bb","32808e6104deb50e6079833063e352410728f29b6f7ec8f954bd8fa00333586b","8f765b723017f8af70d73372eb568845dce5dac317d86f68234684821ccbd35d","d55d9277c4da5e7e7029befe539ae4c317677a0346710a962068cc009c7d18ef"],"paragraph_range_zero_based":[5808,5831],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p5808"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>set the relativeTimeStamp to indicate the elapsed time since the moment at which the logged measurement configuration was received;","paragraph_zero_based":5832},{"literal_text_all_w_t_and_m_t":"3>if location information became available during the last logging interval, set the content of the locationInfo as in 5.3.3.7:","paragraph_zero_based":5833},{"literal_text_all_w_t_and_m_t":"3>if the UE is in any cell selection state (as specified in TS 38.304 [20]):","paragraph_zero_based":5834},{"literal_text_all_w_t_and_m_t":"4>set anyCellSelectionDetected to indicate the detection of no suitable or no acceptable cell found;","paragraph_zero_based":5835},{"literal_text_all_w_t_and_m_t":"4>if the reportType is set to eventTriggered in the VarLogMeasConfig; and","paragraph_zero_based":5836},{"literal_text_all_w_t_and_m_t":"4>if the RPLMN at the time of entering the any cell selection state is included in plmn-IdentityList stored in VarLogMeasReport; and","paragraph_zero_based":5837},{"literal_text_all_w_t_and_m_t":"4>if areaConfiguration is not included in VarLogMeasConfig or if the last suitable cell that the UE was camping on is part of the area indicated by areaConfig of areaConfiguration in VarLogMeasConfig:","paragraph_zero_based":5838},{"literal_text_all_w_t_and_m_t":"5>set the servCellIdentity to indicate global cell identity of the last suitable cell that the UE was camping on;","paragraph_zero_based":5839},{"literal_text_all_w_t_and_m_t":"5>set the measResultServingCell to include the quantities of the last suitable cell the UE was camping on;","paragraph_zero_based":5840},{"literal_text_all_w_t_and_m_t":"4>else if the reportType is set to periodical in the VarLogMeasConfig:","paragraph_zero_based":5841},{"literal_text_all_w_t_and_m_t":"5>set the servCellIdentity to indicate global cell identity of the last logged cell that the UE was camping on;","paragraph_zero_based":5842},{"literal_text_all_w_t_and_m_t":"5>set the measResultServingCell to include the quantities of the last logged cell the UE was camping on;","paragraph_zero_based":5843},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":5844},{"literal_text_all_w_t_and_m_t":"4>set the servCellIdentity to indicate global cell identity of the cell the UE is camping on;","paragraph_zero_based":5845},{"literal_text_all_w_t_and_m_t":"4>set the measResultServingCell to include the quantities of the cell the UE is camping on;","paragraph_zero_based":5846},{"literal_text_all_w_t_and_m_t":"3>if available, set the measResultNeighCells, in order of decreasing ranking-criterion as used for cell re-selection, to include measurements of neighbouring cell that became available during the last logging interval and according to the following:","paragraph_zero_based":5847},{"literal_text_all_w_t_and_m_t":"4>include measurement results for at most 6 neighbouring cells on the NR serving frequency and for at most 3 cells per NR neighbouring frequency and for the NR neighbouring frequencies in accordance with the following:","paragraph_zero_based":5848},{"literal_text_all_w_t_and_m_t":"5>if interFreqTargetInfo is included in VarLogMeasConfig:","paragraph_zero_based":5849},{"literal_text_all_w_t_and_m_t":"6>if earlyMeasIndication is included in VarLogMeasConfig;","paragraph_zero_based":5850},{"literal_text_all_w_t_and_m_t":"7>include measurement results for NR neighbouring frequencies that are included in both interFreqTargetInfo and either in measIdleCarrierListNR (within the VarMeasIdleConfig) or SIB4;","paragraph_zero_based":5851},{"literal_text_all_w_t_and_m_t":"6>else:","paragraph_zero_based":5852},{"literal_text_all_w_t_and_m_t":"7>include measurement results for NR neighbouring frequencies that are included in both interFreqTargetInfo and SIB4;","paragraph_zero_based":5853},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":5854},{"literal_text_all_w_t_and_m_t":"6>if earlyMeasIndication is included in VarLogMeasConfig;","paragraph_zero_based":5855}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["0425b6036181627009db204410f6c2961c4e508ed8a69c247cbdfbc2dbcfbd16","1c90a0ed89f4ad0a5cff1ced57500df4f8da165774240cf1d241ab1c2661859b","00bfb68dc3b30cbd4f20a5a2f86b671cf55d21fb662512dda810861f25a60449","2b67b8aa9a0a06eb2b4c80848adfd2f7acca6187cb2d312c1219df5064a9b155","327d5edb9480d0f09f64df14f229b1e420bbf1c60b66809a8cb6aac259306c7c","e7b6940d35c813d2d4b7af8a125642ea4641e47dd9edcd3a88aeb25cd7d8e657","a1c5f134997916eadda03a3c67edc5766459ca0feee0a3f17802ffe1997a4a7f","dccd7e3c752fea104caa7e8f06241f51e052f230961a7f11a415c0b6b53e2e58","9b6fda13799a4c6759be6f59df12c145764118f9e4a1f6a947bd549e55b2fa4d","e627bc9337d5e16b798135fe0ca7b9058fdf85795043b8abcdd8566528515b6c","8f2af976170698bf03d90a73f1679d08007f364df6e1347c6a9ba291205d0d53","0161df37cfa7f866d1b81560298f29052a79c61146036f6720bccc4afded39fd","f5f488660a7fd6da016b2cf5df4f988d4705469b1a93fddd250e48f4c63e23cf","4c0e0fbfed1f4108207d76324486bbb438116a2824674d59e297f462c769bfae","e3f3fbba1e92d76831d61f090b6665c445da7551bcc55c9c7fed050a1c624fa0","d060ad3309069c313597bd08117203149999de5fc960c91a4ae242904adff22a","64ea99caeabf2448fcc04e59704bf0e160caf3d40b3beced0199f54a2708ef13","33778f250d2fe72641677645d4a5d1eba6ad6d35a78d93701c3d0906d8a4ea24","f4f8bd43df8615e08107336ddaf8ad55c6b43ea4d0e250d2d1f777f9119a70f5","197080755be7db0476bff31785ab2948bbc9e47fb4b24b2a4e1d742d681aa2a4","d8a4368f3b2f0582d679945eae01617df620d312e4c24a7a5a17e6734f6c4d5b","f9d5a7282dfa72944e3c56dbe550749e07cceb692e9c09650a01b4b2d7610d3f","5bfceca7d0cf348d68307041286ca22937bdd918bc45a9658412514bd9b56b85","84f8e8988c680758a07b7dff6738be0459fb1694dfee14bea0b6e7510d6f8d61"],"paragraph_range_zero_based":[5832,5855],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p5832"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"7>include measurement results for NR neighbouring frequencies that are included in either measIdleCarrierListNR (within the VarMeasIdleConfig) or SIB4;","paragraph_zero_based":5856},{"literal_text_all_w_t_and_m_t":"6>else:","paragraph_zero_based":5857},{"literal_text_all_w_t_and_m_t":"7>include measurement results for NR neighbouring frequencies that are included in SIB4;","paragraph_zero_based":5858},{"literal_text_all_w_t_and_m_t":"4>include measurement results for at most 3 neighbours per inter-RAT frequency in accordance with the following:","paragraph_zero_based":5859},{"literal_text_all_w_t_and_m_t":"5>if earlyMeasIndication is included in VarLogMeasConfig:","paragraph_zero_based":5860},{"literal_text_all_w_t_and_m_t":"6>include measurement results for inter-RAT neighbouring frequencies that are included in either measIdleCarrierListEUTRA (within the VarMeasIdleConfig) or SIB5;","paragraph_zero_based":5861},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":5862},{"literal_text_all_w_t_and_m_t":"6>include measurement results for inter-RAT frequencies that are included in SIB5;","paragraph_zero_based":5863},{"literal_text_all_w_t_and_m_t":"4>for each neighbour cell included, include the optional fields that are available;","paragraph_zero_based":5864},{"literal_text_all_w_t_and_m_t":"NOTE 1:The UE includes the latest results of the available measurements as used for cell reselection evaluation in RRC_IDLE or RRC_INACTIVE, which are performed in accordance with the performance requirements as specified in TS 38.133 [14].","paragraph_zero_based":5865},{"literal_text_all_w_t_and_m_t":"NOTE 2:For logging the measurements on frequencies (indicated in measIdleCarrierListNR/ measIdleCarrierListEUTRA) in the logged measurement, the qualityThreshold in measIdleConfig should not be applied, and how the UE logs the measurements on the frequencies is left to the UE implementation.","paragraph_zero_based":5866},{"literal_text_all_w_t_and_m_t":"2>when the memory reserved for the logged measurement information becomes full, stop timer T330 and perform the same actions as performed upon expiry of T330, as specified in 5.5a.1.4.","paragraph_zero_based":5867},{"literal_text_all_w_t_and_m_t":"5.6UE capabilities","paragraph_zero_based":5868},{"literal_text_all_w_t_and_m_t":"5.6.1UE capability transfer","paragraph_zero_based":5869},{"literal_text_all_w_t_and_m_t":"5.6.1.1General","paragraph_zero_based":5870},{"literal_text_all_w_t_and_m_t":"This clause describes how the UE compiles and transfers its UE capability information upon receiving a UECapabilityEnquiry from the network.","paragraph_zero_based":5871},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5872},{"literal_text_all_w_t_and_m_t":"Figure 5.6.1.1-1: UE capability transfer","paragraph_zero_based":5873},{"literal_text_all_w_t_and_m_t":"5.6.1.2Initiation","paragraph_zero_based":5874},{"literal_text_all_w_t_and_m_t":"The network initiates the procedure to a UE in RRC_CONNECTED when it needs (additional) UE radio access capability information. The network should retrieve UE capabilities only after AS security activation. Network does not forward UE capabilities that were retrieved before AS security activation to the CN.","paragraph_zero_based":5875},{"literal_text_all_w_t_and_m_t":"5.6.1.3Reception of the UECapabilityEnquiry by the UE","paragraph_zero_based":5876},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of UECapabilityInformation message as follows:","paragraph_zero_based":5877},{"literal_text_all_w_t_and_m_t":"1>if the ue-CapabilityRAT-RequestList contains a UE-CapabilityRAT-Request with rat-Type set to nr:","paragraph_zero_based":5878},{"literal_text_all_w_t_and_m_t":"2>include in the ue-CapabilityRAT-ContainerList a UE-CapabilityRAT-Container of the type UE-NR-Capability and with the rat-Type set to nr;","paragraph_zero_based":5879}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["4eeb7f66548950d0a9547138b8403c3aa8a90bae3b4f221431efeaa038747037","b62ac86f019d7288da4348e5c8da035f13ea98c5cd63537c1600b4eefd448d97","8968d05767e94afc06b1ce3a7efc67bae9e25fb5711cc8b22577c775b14f54a8","543d77f4e175c11f3d2cc2e42eb3b8a93b3061b7f78cc9323849daca688132d6","5025a69f64187189cf7d0975d4e0bc8a9f207b42ebd71442412e15a9d45f65b0","6f5e05d0d2957f647da816f2d27330c46687dbc19e03cc1aa4a22fe880463f2f","aedc9ae9db0e9797edf4816116eb18a7d602a2362146ae12394d9bd97b0cb35e","a2653c5f122274d0b6aedfd1a9bd4845332fd57c97369b00c4c8a717cfaa01b2","fbb9920a4f094307351fbfc7fbbb4a421fa61b7c76d5276b2247af8728eb2761","56389e0f774cb74b25eb1dc2cd243e600891d8d710d5b3a4207cfa49e6813379","63a8731aec3e74515b808354a3d6f87194eace74d30d10066d6db15867995112","6c693f3d0a5746e86ad712f5bf3c13408699fa59b62c9638488692303cfac0ed","c7aaf61fd04f822e174ea45374c5091759e0d7c6c990e088494ff75a5c382e34","7bb384650e98fd58f99d4ffc9fd080a443f0fe5719e71110b47b7f39a52f48bb","fd6f3fd4bf0d2a47e8a7e9f1375e1a9d81a13d44cc6b7ba93a5b5b6e8eccf68f","48cda0165f5527ba0ea1ced5e28b0e4c5eb7b73477cd8f6f44671c95ec5a0171","0fbfa1dd5f6d5e9a6ac913643759db62361d8bba21e20af0fa4b6532bf7cb995","7e476b078fe01dcba62693dbd53ba012afdd89964e7b219e31285669472a6145","3070f7b66aa212ad255313ab593ff21def162b775ce9930f8d8654ac3ab49c9d","5fb7ef0b96fea995fdfba9f572a9fd8c6f3a1f91a1caafa51676d2ab62410774","1dd8075f80d9df28f2f90907957fc4e81777015dc8eb0b5e532c97a0468d2bbf","ef767a049b9007642e730c3c857ef6a5a896d1f17959ba0d7e228cce495d33a3","1e9cc7fd304570fff3eec23a3e54fb2e3a23f6431ea6db940e7f18b8ca80ea50","565896b5925f8b6cde21666277d14a902d262d64fd1bb3680a6bbdac9d17c030"],"paragraph_range_zero_based":[5856,5879],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p5856"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>include the supportedBandCombinationList, featureSets and featureSetCombinations as specified in clause 5.6.1.4;","paragraph_zero_based":5880},{"literal_text_all_w_t_and_m_t":"1>if the ue-CapabilityRAT-RequestList contains a UE-CapabilityRAT-Request with rat-Type set to eutra-nr:","paragraph_zero_based":5881},{"literal_text_all_w_t_and_m_t":"2> if the UE supports (NG)EN-DC or NE-DC:","paragraph_zero_based":5882},{"literal_text_all_w_t_and_m_t":"3>include in the ue-CapabilityRAT-ContainerList a UE-CapabilityRAT-Container of the type UE-MRDC-Capability and with the rat-Type set to eutra-nr;","paragraph_zero_based":5883},{"literal_text_all_w_t_and_m_t":"3>include the supportedBandCombinationList and featureSetCombinations as specified in clause 5.6.1.4;","paragraph_zero_based":5884},{"literal_text_all_w_t_and_m_t":"1>if the ue-CapabilityRAT-RequestList contains a UE-CapabilityRAT-Request with rat-Type set to eutra:","paragraph_zero_based":5885},{"literal_text_all_w_t_and_m_t":"2>if the UE supports E-UTRA:","paragraph_zero_based":5886},{"literal_text_all_w_t_and_m_t":"3>include in the ue-CapabilityRAT-ContainerList a ue-CapabilityRAT-Container of the type UE-EUTRA-Capability associated with the terrestrial network and with the rat-Type set to eutra as specified in TS 36.331 [10], clause 5.6.3.3, according to the capabilityRequestFilter, if received;","paragraph_zero_based":5887},{"literal_text_all_w_t_and_m_t":"1>if the ue-CapabilityRAT-RequestList contains a UE-CapabilityRAT-Request with rat-Type set to utra-fdd:","paragraph_zero_based":5888},{"literal_text_all_w_t_and_m_t":"2>if the UE supports UTRA-FDD:","paragraph_zero_based":5889},{"literal_text_all_w_t_and_m_t":"3>include the UE radio access capabilities for UTRA-FDD within a ue-CapabilityRAT-Container and with the rat-Type set to utra-fdd;","paragraph_zero_based":5890},{"literal_text_all_w_t_and_m_t":"1>if the RRC message segmentation is enabled based on the field rrc-SegAllowed received, and the encoded RRC message is larger than the maximum supported size of a PDCP SDU specified in TS 38.323 [5]:","paragraph_zero_based":5891},{"literal_text_all_w_t_and_m_t":"2>initiate the UL message segment transfer procedure as specified in clause 5.7.7;","paragraph_zero_based":5892},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":5893},{"literal_text_all_w_t_and_m_t":"2>submit the UECapabilityInformation message to lower layers for transmission, upon which the procedure ends.","paragraph_zero_based":5894},{"literal_text_all_w_t_and_m_t":"5.6.1.4Setting band combinations, feature set combinations and feature sets supported by the UE","paragraph_zero_based":5895},{"literal_text_all_w_t_and_m_t":"The UE invokes the procedures in this clause if the NR or E-UTRA network requests UE capabilities for nr, eutra-nr or eutra. This procedure is invoked once per requested rat-Type (see clause 5.6.1.3 for capability enquiry by the NR network; see TS 36.331 [10], clause 5.6.3.3 for capability enquiry by the E-UTRA network). The UE shall ensure that the feature set IDs are consistent across feature sets, feature set combinations and band combinations in all three UE capability containers that the network queries with the same fields with the same values, i.e. UE-CapabilityRequestFilterNR, UE-CapabilityRequestFilterCommon and fields in UECapabilityEnquiry message (i.e. requestedFreqBandsNR-MRDC, requestedCapabilityNR, eutra-nr-only flag, and requestedCapabilityCommon) as defined in TS 36.331, where applicable.","paragraph_zero_based":5896},{"literal_text_all_w_t_and_m_t":"NOTE 1:Capability enquiry without frequencyBandListFilter is not supported.","paragraph_zero_based":5897},{"literal_text_all_w_t_and_m_t":"NOTE 2:In (NG)EN-DC, the gNB needs the capabilities for RAT types nr and eutra-nr and it uses the featureSets in the UE-NR-Capability together with the featureSetCombinations in the UE-MRDC-Capability to determine the NR UE capabilities for the supported MRDC band combinations. Similarly, the eNB needs the capabilities for RAT types eutra and eutra-nr and it uses the featureSetsEUTRA in the UE-EUTRA-Capability together with the featureSetCombinations in the UE-MRDC-Capability to determine the E-UTRA UE capabilities for the supported MRDC band combinations. Hence, the IDs used in the featureSets must match the IDs referred to in featureSetCombinations across all three containers. The requirement on consistency implies that there are no undefined feature sets and feature set combinations.","paragraph_zero_based":5898},{"literal_text_all_w_t_and_m_t":"NOTE 3:If the UE cannot include all feature sets and feature set combinations due to message size or list size constraints, it is up to UE implementation which feature sets and feature set combinations it prioritizes.","paragraph_zero_based":5899},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5900},{"literal_text_all_w_t_and_m_t":"1>compile a list of \"candidate band combinations\" according to the filter criteria in capabilityRequestFilterCommon (if included), only consisting of bands included in frequencyBandListFilter, and prioritized in the order of frequencyBandListFilter (i.e. first include band combinations containing the first-listed band, then include remaining band combinations containing the second-listed band, and so on), where for each band in the band combination, the parameters of the band do not exceed maxBandwidthRequestedDL, maxBandwidthRequestedUL, maxCarriersRequestedDL, maxCarriersRequestedUL, ca-BandwidthClassDL-EUTRA or ca-BandwidthClassUL-EUTRA, whichever are received;","paragraph_zero_based":5901},{"literal_text_all_w_t_and_m_t":"1>for each band combination included in the list of \"candidate band combinations\":","paragraph_zero_based":5902},{"literal_text_all_w_t_and_m_t":"2>if the network (E-UTRA) included the eutra-nr-only field, or","paragraph_zero_based":5903}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["990d3395fb04d84a5aa30229025cedce251c9e484d7fe0c4659e1b77cd486fe8","fc7edef01be694209a4d667ffe66514701826e92629d202bf314aa9656d91a75","1c89b2bbae610ca57fea357fcf81158196633c59ffcd0de544adf8b0c523708f","dc88808a46339c7b30b0523bdb991e2dfea5983fd74b979be4b5100a7abefd58","fe1d4a7a0631d2d588381cb87561ecdfaf22afd2b2767dffac58df7e0e4a5733","b469491c42234b877e096419c1f0f4bfbe116ad2a9813d50866c41ed8e81072a","684da857741a3cdd30203ce0d3a44015177b668b78e890a124e94359c63a06c2","8f0eed2890279b5659ee61030478a6f209f2eff923e8b64b924ebdf80d4226c0","0d95a28ebba3819ae8a3b941504f9f9f31e12ca604dc19e8354a3bfd13fa000d","5031ae34a8baa01170b0927bb096e3d9571ddf18d9160cb053c41fa7061ecb2e","dd72591e18c0ea532787507856c8531d99cb2ffb6d488374d4aef151393f0639","8105d465ffb54f5c81f97761c732788c1a8b12cc2608ab0d4830efcef8cfbf9e","5a2813d00931ef80318e47da2c8dc390736f3091b9b9aa4ccacc175a3e46e64b","5e952df356e4844d9573f952116159af84e5d4d098cfcc99feef8e65c06474db","baa7ddbf36e38899ed7411ff9a8492a29f65ab4783dd1ee5465957c87d6112d0","ad343502ecd3a0558c7fcadfa7bfa2ab7d33e32b2761b8be687146b2f37c5e26","a9f6bbd357a034e216064ff7c39e312216fd2b10975dc15f299eb79ec8a17b43","1adaec359b217c0bb7ddc80d08f843ada92ec2ebd3b5ad4dd21c564b7f5cdcbc","1e454cc093581130e81efeb4f3d69f25aceab508d10e4920bd5cad978991d669","61901438539bf84728a4a145f752313aba0bf9af19d9c064dda6453b11abda93","8948891fa3e8d014b51d00adcbe71ae953507c942a09321344cb60a97cb3bf82","5875583d6b217614e6909516138e2aa16d64178b3848dc66603eff413b36dbce","b9bff8310ad47f70102aa061dcc60f57750d7cea8b759e79473f032846af8275","382c2ca47f2568a349471669eb51920719466418e3db316b042a6bf0e1d39f07"],"paragraph_range_zero_based":[5880,5903],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p5880"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if the requested rat-Type is eutra:","paragraph_zero_based":5904},{"literal_text_all_w_t_and_m_t":"3>remove the NR-only band combination from the list of \"candidate band combinations\";","paragraph_zero_based":5905},{"literal_text_all_w_t_and_m_t":"NOTE 4:The (E-UTRA) network may request capabilities for nr but indicate with the eutra-nr-only flag that the UE shall not include any NR band combinations in the UE-NR-Capability. In this case the procedural text above removes all NR-only band combinations from the candidate list and thereby also avoids inclusion of corresponding feature set combinations and feature sets below.","paragraph_zero_based":5906},{"literal_text_all_w_t_and_m_t":"2>if it is regarded as a fallback band combination with the same capabilities of another band combination included in the list of \"candidate band combinations\", and","paragraph_zero_based":5907},{"literal_text_all_w_t_and_m_t":"2>if this fallback band combination is generated by releasing at least one SCell or uplink configuration of SCell or SUL according to TS 38.306 [26]:","paragraph_zero_based":5908},{"literal_text_all_w_t_and_m_t":"3>remove the band combination from the list of \"candidate band combinations\";","paragraph_zero_based":5909},{"literal_text_all_w_t_and_m_t":"NOTE 5:Even if the network requests (only) capabilities for nr, it may include E-UTRA band numbers in the frequencyBandListFilter to ensure that the UE includes all necessary feature sets needed for subsequently requested eutra-nr capabilities. At this point of the procedure the list of \"candidate band combinations\" contains all NR- and/or E-UTRA-NR band combinations that match the filter (frequencyBandListFilter) provided by the NW and that match the eutra-nr-only flag (if RAT-Type nr is requested by E-UTRA). In the following, this candidate list is used to derive the band combinations, feature set combinations and feature sets to be reported in the requested capability container.","paragraph_zero_based":5910},{"literal_text_all_w_t_and_m_t":"1>if the requested rat-Type is nr:","paragraph_zero_based":5911},{"literal_text_all_w_t_and_m_t":"2>include into supportedBandCombinationList as many NR-only band combinations as possible from the list of \"candidate band combinations\", starting from the first entry;","paragraph_zero_based":5912},{"literal_text_all_w_t_and_m_t":"3>if srs-SwitchingTimeRequest is received:","paragraph_zero_based":5913},{"literal_text_all_w_t_and_m_t":"4>if SRS carrier switching is supported;","paragraph_zero_based":5914},{"literal_text_all_w_t_and_m_t":"5>include srs-SwitchingTimesListNR and srs-SwitchingAffectedBandsListNR for each band combination;","paragraph_zero_based":5915},{"literal_text_all_w_t_and_m_t":"4>set srs-SwitchingTimeRequested to true;","paragraph_zero_based":5916},{"literal_text_all_w_t_and_m_t":"2>include, into featureSetCombinations, the feature set combinations referenced from the supported band combinations as included in supportedBandCombinationList according to the previous;","paragraph_zero_based":5917},{"literal_text_all_w_t_and_m_t":"2>compile a list of \"candidate feature set combinations\" referenced from the list of \"candidate band combinations\" excluding entries (rows in feature set combinations) with same or lower capabilities;","paragraph_zero_based":5918},{"literal_text_all_w_t_and_m_t":"2>if uplinkTxSwitchRequest is received:","paragraph_zero_based":5919},{"literal_text_all_w_t_and_m_t":"3>include into supportedBandCombinationList-UplinkTxSwitch as many NR-only band combinations that supported UL TX switching as possible from the list of \"candidate band combinations\", starting from the first entry;","paragraph_zero_based":5920},{"literal_text_all_w_t_and_m_t":"4>if srs-SwitchingTimeRequest is received:","paragraph_zero_based":5921},{"literal_text_all_w_t_and_m_t":"5>if SRS carrier switching is supported;","paragraph_zero_based":5922},{"literal_text_all_w_t_and_m_t":"6>include srs-SwitchingTimesListNR and srs-SwitchingAffectedBandsListNR for each band combination;","paragraph_zero_based":5923},{"literal_text_all_w_t_and_m_t":"5>set srs-SwitchingTimeRequested to true;","paragraph_zero_based":5924},{"literal_text_all_w_t_and_m_t":"3>include, into featureSetCombinations, the feature set combinations referenced from the supported band combinations as included in supportedBandCombinationList-UplinkTxSwitch according to the previous;","paragraph_zero_based":5925},{"literal_text_all_w_t_and_m_t":"NOTE 6:This list of \"candidate feature set combinations\" contains the feature set combinations used for NR-only as well as E-UTRA-NR band combinations. It is used to derive a list of NR feature sets referred to from the feature set combinations in the UE-NR-Capability and from the feature set combinations in a UE-MRDC-Capability container.","paragraph_zero_based":5926},{"literal_text_all_w_t_and_m_t":"2>if sidelinkRequest is received:","paragraph_zero_based":5927}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["0ef43bbdd244fd84ee36018c2571e032a9a9eb08f46e095bbde3d1ea84b719e6","d4f3a7b58dd57687adb1d9f32b97b504173324441e9771e898564e586e632627","15fcbee2938514d0e2dd7231e06556ea628fae5c122c72a257f0e98ef81b7e1d","3401c7c740544e4ddf0eb0756341bfcf68d593cab561c61b5baae1f66b0318fc","c36cfa94f1dad60ad35c44e90fe331961edd51bf12a14604f30d1af8248d928b","1ff58b755ade7a5b9b8f7ddbb6a1fae91f96e7148e96df53ff87b93226321078","451f9050810f6e6a49edbd909d7929270f1dd0ed62c24bb81d373abfb0a2c3ea","c2062e336e153598cb20443d0bdeb0a6e38bda4c8bcc3ee7fa96306984add7d6","105bb0511844714664347816a8b5ae848ecb437051be6a0558df7305c585036f","68683e7ad65cb81ab620fbac95a60a54b9761323b5eaf4c72d85d87f4d06c02f","41aba67829fb7183dcae66ea63123643610739944f4759270ea3631e77fb7501","fc727ff7255ee5d2e7fbc4e030f322f6ddcaf40553799bc7e188ab951ba516c2","a20273470d0ee788e1bb0e441322092e3a47c21679aaae696a0747f447ce7d52","f19f0a69de8722cda672e5626fefecf9eca930c7ba04f7cbeaa289533db196d4","db789830cb0f9042227f579fb2dc6c4db35cf9387c70dcaf3c5517330dcd3f17","6f6251cc03caa69eb8c1d43ec758bc1cc4915b302845e39ce0337cf7637eb83e","3054fa88714bbf7edddf0ab78c5d74ac35a27c28cf074440b3e83826eff9c3b2","85480f6e4b4c50ce39dcfd575b827573a9223482a1373a66ba0095158d3648d3","0aabf982c18e838d1c935213d35754e09e007b9decba093d4d4ce2e82ec84fb1","9803d13e4a1dec88c499937485c6d817658c2eee1306dd5892305f725da9bc2b","d505854ed99c26a40c7d0fc6baaee7ec0d599addaab53c9ce7f86b3127af8b8f","950481d6997707183640a7224342fb169b9a0c0d0e868c4a4f058d2416c61459","e25fa80f4d09a9fd0c119bb43cc5c5ecfe126d19257ee912f77ca3d8ca03f4e2","0290dcb3b56c4a8699dcab05a9de8608789e33fbd80ceb99ee432d755a9db1e6"],"paragraph_range_zero_based":[5904,5927],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p5904"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>for a sidelink band combination the UE included in supportedBandCombinationListSidelinkEUTRA-NR, supportedBandCombinationListSL-RelayDiscovery or supportedBandCombinationListSL-NonRelayDiscovery:","paragraph_zero_based":5928},{"literal_text_all_w_t_and_m_t":"4>if the UE supports partial sensing for a band of the sidelink band combination, include the partial sensing capabilities for the band using the sl-TransmissionMode2-PartialSensing-r17;","paragraph_zero_based":5929},{"literal_text_all_w_t_and_m_t":"3>set sidelinkRequested to true;","paragraph_zero_based":5930},{"literal_text_all_w_t_and_m_t":"2>include into featureSets the feature sets referenced from the \"candidate feature set combinations\" and may exclude the feature sets with the parameters that exceed any of maxBandwidthRequestedDL, maxBandwidthRequestedUL, maxCarriersRequestedDL or maxCarriersRequestedUL, whichever are received;","paragraph_zero_based":5931},{"literal_text_all_w_t_and_m_t":"1>else, if the requested rat-Type is eutra-nr:","paragraph_zero_based":5932},{"literal_text_all_w_t_and_m_t":"2>include into supportedBandCombinationList and/or supportedBandCombinationListNEDC-Only as many E-UTRA-NR band combinations as possible from the list of \"candidate band combinations\", starting from the first entry;","paragraph_zero_based":5933},{"literal_text_all_w_t_and_m_t":"3>if srs-SwitchingTimeRequest is received:","paragraph_zero_based":5934},{"literal_text_all_w_t_and_m_t":"4>if SRS carrier switching is supported;","paragraph_zero_based":5935},{"literal_text_all_w_t_and_m_t":"5>include srs-SwitchingTimesListNR, srs-SwitchingTimesListEUTRA and srs-SwitchingAffectedBandsListNR for each band combination;","paragraph_zero_based":5936},{"literal_text_all_w_t_and_m_t":"4>set srs-SwitchingTimeRequested to true;","paragraph_zero_based":5937},{"literal_text_all_w_t_and_m_t":"2>include, into featureSetCombinations, the feature set combinations referenced from the supported band combinations as included in supportedBandCombinationList according to the previous;","paragraph_zero_based":5938},{"literal_text_all_w_t_and_m_t":"2>if uplinkTxSwitchRequest is received:","paragraph_zero_based":5939},{"literal_text_all_w_t_and_m_t":"3>include into supportedBandCombinationList-UplinkTxSwitch as many E-UTRA-NR band combinations that supported UL TX switching as possible from the list of \"candidate band combinations\", starting from the first entry;","paragraph_zero_based":5940},{"literal_text_all_w_t_and_m_t":"4>if srs-SwitchingTimeRequest is received:","paragraph_zero_based":5941},{"literal_text_all_w_t_and_m_t":"5>if SRS carrier switching is supported;","paragraph_zero_based":5942},{"literal_text_all_w_t_and_m_t":"6>include srs-SwitchingTimesListNR, srs-SwitchingTimesListEUTRA and srs-SwitchingAffectedBandsListNR for each band combination;","paragraph_zero_based":5943},{"literal_text_all_w_t_and_m_t":"5>set srs-SwitchingTimeRequested to true;","paragraph_zero_based":5944},{"literal_text_all_w_t_and_m_t":"3>include, into featureSetCombinations, the feature set combinations referenced from the supported band combinations as included in supportedBandCombinationList-UplinkTxSwitch according to the previous;","paragraph_zero_based":5945},{"literal_text_all_w_t_and_m_t":"1>else (if the requested rat-Type is eutra):","paragraph_zero_based":5946},{"literal_text_all_w_t_and_m_t":"2>compile a list of \"candidate feature set combinations\" referenced from the list of \"candidate band combinations\" excluding entries (rows in feature set combinations) with same or lower capabilities;","paragraph_zero_based":5947},{"literal_text_all_w_t_and_m_t":"NOTE 7:This list of \"candidate feature set combinations\" contains the feature set combinations used for E-UTRA-NR band combinations. It is used to derive a list of E-UTRA feature sets referred to from the feature set combinations in a UE-MRDC-Capability container.","paragraph_zero_based":5948},{"literal_text_all_w_t_and_m_t":"2>include into featureSetsEUTRA (in the UE-EUTRA-Capability) the feature sets referenced from the \"candidate feature set combinations\" and may exclude the feature sets with the parameters that exceed ca-BandwidthClassDL-EUTRA or ca-BandwidthClassUL-EUTRA, whichever are received;","paragraph_zero_based":5949},{"literal_text_all_w_t_and_m_t":"1>include the received frequencyBandListFilter in the field appliedFreqBandListFilter of the requested UE capability, except if the requested rat-Type is nr and the network included the eutra-nr-only field;","paragraph_zero_based":5950},{"literal_text_all_w_t_and_m_t":"1>if the network included ue-CapabilityEnquiryExt:","paragraph_zero_based":5951}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["d0e5795e8cc577c81734a15c529147613cd2f462438fefd406fa30b7d5afeb58","06f4dbe07431e65e97549cac06e8c05d62a6b5e3e5dfc8731db4a6bb71286563","36504d10af63ecd7cc204b9bcef40056fa955588af44eef9334d13a2487fee27","37805a5ee2d376576b719c51f558783ed9ce371a728a9e1e2d59fd382696379e","0a09f58a24b60c2a884b761883867bc5680989d364cfe726ccd8bb8ca330d75f","dcdff7eb6c29fa62e856852450217ad57ab76e97517a17b7c67919ea7b4aa768","e03654f966d5f6bed9991ec6ace02b4282f2ada9aece6fb63e0e6b2c8be7a0fb","cc2537bf890e2352c04e3afea8565d977f1b77f43ca7f3ce10797f596f3bf2bc","2cf94613bae87f8c33efa6897af7503ff48baebe23ebf482b84c5ce3410af67b","660693ae3b84164f6cece7e100119d9d91fee3f9d555b8b3c7e674a9ac2339ae","aad161e8ae58f3ea22732dce2b27ea7d464d7a625ac7c0c1be7cfc67aade76d0","2e57417ec33ebf6a379de220d3572858d7a66cd92a6dad2d27e611b1dccd84b5","7c2fbd620fd2c75634cb78406ef6082990d89226e180f90fa60d2d2f61868b4a","7ad112ff15886554a21181e39549d70c65e686793be74ebab9fb9f80be810c5a","783192791ce5fa4ccdf47f90ba8767465a8367c7377dfe915f4c6c76980ecbda","a7a11dd3a4a84c277c814ef51468434b3cd669b997381f91ac866236e5727436","7b9499bf32af01fecbe7239b920d7bb10083d0d6b73d9c7db43a280f7f00d4be","b76c712e514b336f81413549f7b3f86868d5cacedef28be7f703e07c1b33a327","986d3b32c6b92631f12a0aaf120b819cfc876ea7db2624bef09e1f7e8954206b","179ee13ef5f1b0f38432d4d71cb0cb879f64711ce39ed27d3a630cc814355e35","9ac32fc209727d035baa653fd227881815dd8fdfdf56e4ab214262e6ab4bcf4b","e4e86275b091b4f3be68039910499713a4f3afc65f7478141b65392428474702","cc8107b5c47626d4a932aaf7cfba0036afb3099466cf48a1f28174318676bed9","a361a71ab6f01858a86e89b32b7dfedb71d7892309cac38801261cd1655331e0"],"paragraph_range_zero_based":[5928,5951],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p5928"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>include the received ue-CapabilityEnquiryExt in the field receivedFilters;","paragraph_zero_based":5952},{"literal_text_all_w_t_and_m_t":"5.6.1.5Void","paragraph_zero_based":5953},{"literal_text_all_w_t_and_m_t":"5.7Other","paragraph_zero_based":5954},{"literal_text_all_w_t_and_m_t":"5.7.1DL information transfer","paragraph_zero_based":5955},{"literal_text_all_w_t_and_m_t":"5.7.1.1General","paragraph_zero_based":5956},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5957},{"literal_text_all_w_t_and_m_t":"Figure 5.7.1.1-1: DL information transfer","paragraph_zero_based":5958},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to transfer NAS dedicated information from NG-RAN to a UE in RRC_CONNECTED or to a UE in RRC_INACTIVE during SDT, or to transfer F1-C related information from IAB Donor-CU to IAB-DU via the collocated IAB-MT in RRC_CONNECTED.","paragraph_zero_based":5959},{"literal_text_all_w_t_and_m_t":"5.7.1.2Initiation","paragraph_zero_based":5960},{"literal_text_all_w_t_and_m_t":"The network initiates the DL information transfer procedure whenever there is a need to transfer NAS dedicated information, or F1-C related information to an IAB-node. The network initiates the DL information transfer procedure by sending the DLInformationTransfer message.","paragraph_zero_based":5961},{"literal_text_all_w_t_and_m_t":"5.7.1.3Reception of the DLInformationTransfer by the UE","paragraph_zero_based":5962},{"literal_text_all_w_t_and_m_t":"Upon receiving DLInformationTransfer message, the UE shall:","paragraph_zero_based":5963},{"literal_text_all_w_t_and_m_t":"1>if dedicatedNAS-Message is included:","paragraph_zero_based":5964},{"literal_text_all_w_t_and_m_t":"2>forward dedicatedNAS-Message to upper layers.","paragraph_zero_based":5965},{"literal_text_all_w_t_and_m_t":"1>if referenceTimeInfo is included:","paragraph_zero_based":5966},{"literal_text_all_w_t_and_m_t":"2>calculate the reference time based on the time, referenceSFN and timeInfoType if it is included;","paragraph_zero_based":5967},{"literal_text_all_w_t_and_m_t":"2>calculate the uncertainty of the reference time based on the uncertainty, if uncertainty is included;","paragraph_zero_based":5968},{"literal_text_all_w_t_and_m_t":"2>inform upper layers of the reference time and, if uncertainty is included, of the uncertainty;","paragraph_zero_based":5969},{"literal_text_all_w_t_and_m_t":"2>ignore all further referenceTimeInfo received in SIB9, if any.","paragraph_zero_based":5970},{"literal_text_all_w_t_and_m_t":"1>if sib9Fallback is included:","paragraph_zero_based":5971},{"literal_text_all_w_t_and_m_t":"2>apply referenceTimeInfo in SIB9.","paragraph_zero_based":5972},{"literal_text_all_w_t_and_m_t":"1>if rxTxTimeDiff-gNB is included:","paragraph_zero_based":5973},{"literal_text_all_w_t_and_m_t":"2>calculate the propagation delay based on the UE Rx-Tx time difference measurement and the received Rx-Tx time difference measurement at the gNB;","paragraph_zero_based":5974},{"literal_text_all_w_t_and_m_t":"2>inform upper layers of the propagation delay.","paragraph_zero_based":5975}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["89e66cf895a6fe814e80b71c9fd94edef30e3b83d6a4240d7100a8c74b925f29","d572070738a1a24f40873bb2c11b8eadea3c4fab934f8f6e5e19628e3837d008","f511f6ad029e4eb58eab691223beb2c3c95877824f3146bc90e229a62fc5e408","b95a8d2e16e82000bf4a33ce99b9e9f042f8780cb7d1442ea160b27c7e041912","7dd708976d570facb69fc754255dd9190f39d1e609e752dbde595f592c01effc","b379c60a8c32490b5254a884db2e31db088bb5969b960dcf200d23f549088d26","7a20cafc128878752a5d52057c3abc5a5144dd541eb1116cecbb11a9c27e35df","a13229fe6078e875745aebae25cc1d425716cce484e6b0f7b6710aabc37cec55","369fa806220221301389ec7f4642e20a1ed2466a3f2b7e4e6cfba83d292b3884","5820b306e84f701738c11022b91b29efa93898e55fe909e16b24f08616290c19","292a79b7b7f5a9012d700518ecf13bc2fafd1e3c3c1a4e5e3d814e85f331a1bf","13feda199656bce5efb1f9e5f9cffc333a19060fa77ae924ef3a8db75e45d7ca","bde865741dc9d3dca61a17d63ebe30d0f4420555b9542c674a00192e06fdf26e","43da5501e49af30caf084a53115eabc53abc3ed269aa15026c636144efa378bd","0edf9931a2e9fbe9d8eeaa86a1f5adfcf3843070f17a010fb5826b16255ec491","40b3773185fb60bb307c6551e9c6b2f5e53e01790f37ce9ffc82dbac17a313f6","8649690bf2cba5d5d9bb2c3f6b62803ebbd7bad14b15f800514d595faf133a94","50227933409c1f194d34b561209eff2555aa394bd2c8df892681de705012fc96","411893183c53bb10d8d33b46862834d776b99218f65f66e6b6a67c0e666e5c0b","69af4cc49cc40f9bd0df51c05529755361a7cf43e49776641745721effd6a8f9","b9be0556d19e371d392e1c3a5da4a955f179d7a2c8a99ff01156ee7d58f66c68","0e91373690ce01c520b2fb447f28b29f89e3765ca092db85fff248fb86708b06","0126e54644280fa5bd69a46baaa46eb2996ee6caec711bf815570b4e4acc0df5","4dc7943a51f792e924801a4c1af423bceebea9f75271503dadaa89e8eb1cea18"],"paragraph_range_zero_based":[5952,5975],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p5952"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>if ta-PDC is set to activate:","paragraph_zero_based":5976},{"literal_text_all_w_t_and_m_t":"2>inform upper layers of the propagation delay determined by the accumulated Timing Advance commands.","paragraph_zero_based":5977},{"literal_text_all_w_t_and_m_t":"Upon receiving DLInformationTransfer message, the IAB-MT shall:","paragraph_zero_based":5978},{"literal_text_all_w_t_and_m_t":"1>if dedicatedInfoF1c is included:","paragraph_zero_based":5979},{"literal_text_all_w_t_and_m_t":"2>forward dedicatedInfoF1c to the collocated IAB-DU.","paragraph_zero_based":5980},{"literal_text_all_w_t_and_m_t":"5.7.1aDL information transfer for MR-DC","paragraph_zero_based":5981},{"literal_text_all_w_t_and_m_t":"5.7.1a.1General","paragraph_zero_based":5982},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5983},{"literal_text_all_w_t_and_m_t":"Figure 5.7.1a.1-1: DL information transfer MR-DC","paragraph_zero_based":5984},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to transfer RRC messages from the network to the UE over SRB3 (e.g. an NR RRC reconfiguration message including reconfigurationWithSync, an E-UTRA RRC connection reconfiguration message including mobilityControlInfo, an RRC connection release message, a MobilityFromNRCommand message, or a MobilityFromEUTRACommand message) during fast MCG link recovery.","paragraph_zero_based":5985},{"literal_text_all_w_t_and_m_t":"5.7.1a.2Initiation","paragraph_zero_based":5986},{"literal_text_all_w_t_and_m_t":"The network initiates this procedure whenever there is a need to transfer an RRC message during fast MCG link recovery.","paragraph_zero_based":5987},{"literal_text_all_w_t_and_m_t":"5.7.1a.3Actions related to reception of DLInformationTransferMRDC message","paragraph_zero_based":5988},{"literal_text_all_w_t_and_m_t":"Upon receiving the DLInformationTransferMRDC, the UE shall:","paragraph_zero_based":5989},{"literal_text_all_w_t_and_m_t":"1>if the RRCReconfiguration message is included in dl-DCCH-MessageNR:","paragraph_zero_based":5990},{"literal_text_all_w_t_and_m_t":"2>perform the RRC reconfiguration procedure according to 5.3.5.3;","paragraph_zero_based":5991},{"literal_text_all_w_t_and_m_t":"1>else if the RRCRelease message is included in dl-DCCH-MessageNR:","paragraph_zero_based":5992},{"literal_text_all_w_t_and_m_t":"2>perform the RRC release procedure according to 5.3.8;","paragraph_zero_based":5993},{"literal_text_all_w_t_and_m_t":"1>else if the MobilityFromNRCommand message is included in the dl-DCCH-MessageNR:","paragraph_zero_based":5994},{"literal_text_all_w_t_and_m_t":"2>perform the mobility from NR procedure according to 5.4.3.3;","paragraph_zero_based":5995},{"literal_text_all_w_t_and_m_t":"1>else if the E-UTRA RRCConnectionReconfiguration message is included in dl-DCCH-MessageEUTRA:","paragraph_zero_based":5996},{"literal_text_all_w_t_and_m_t":"2>perform the RRC connection reconfiguration procedure as specified in TS 36.331 [10], clause 5.3.5.4;","paragraph_zero_based":5997},{"literal_text_all_w_t_and_m_t":"1>else if the E-UTRA RRCConnectionRelease message is included in dl-DCCH-MessageEUTRA:","paragraph_zero_based":5998},{"literal_text_all_w_t_and_m_t":"2>perform the RRC connection release as specified in TS 36.331 [10], clause 5.3.8;","paragraph_zero_based":5999}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["e1e6e962e5886fe5b43602111c4e784a7dd5a5ac80daa8543b62618539c6fa6a","3375309ec0142ec333433d62aa44bd0561d9ff7b880b949a1bec1bc644121a0d","9ba8e2db0b893e53d6b4ba799d91b6a7b0344fa1b47879e49529f88aa435d137","13661856220c591286af56c0f673e289a43ee98da3e0ac8b53b8096150f941f5","e921196042d9650ea193674f4110b8a3ad16a18bde4f697bcf59c68c4e2494bc","159e93726e91c1a90eee26f066ae53e0e54e9c153f6679b5aed54704ad691e92","6bd81dcaca543813c2fed5d5b9f528e600587a921e17607d4682ebe098c09cba","1dc24eba8c0c32ffd62b78d2bfe13833a6d548187ad3ea255538e492a9706fca","2742c922879ac71fb1427565ad55608cfc61df621f0a658881c3b5d93a059a87","7ae30c5d0b21d3fe7c6002583d2419e5751d3867f43c60458cdcc016478eb856","028bc272de85c509c75357042eb9bba9d0a1901a9a6c2cd8dc74c6ef5a2b8ebd","0049218440ce8da235189e2eb88ca1e37f49399cc4b65dc4b915c662db5b57a6","8f5a48ee46788ae0c218c3cd0c1165cfff74682dffdde2fc0470899a99987cbe","72df46780b53f8d02b7175f525d9599a468e3db4bb9b5417a83154f0e8422933","d57f906d7c8a9c641cab13cc517fe09c62fca1b7e745d5a425e914a54e815897","459d35a78a123c6ad49b657b903be2861bd9c31a06ea478ebc16accc30b185b9","ba053139b49f2d6358e84ad13fcfd60555635ae14f1a6dffaccb1e0be036869b","90c5c2ead5880e65f55f303180c961698f0024ece7507cf0e2471ff1a89a354e","ddd7ec1a752536487a8437df68b15a34d4faa57a4067fa6f8e72ec47af483c06","00f7e2d85d3e923c3f5312300d6ea0543f9fdde8d14d390e512ef7887fa0c485","fbbb2cb95d9b3a2765df8b01fd21a90a3d9db53fc3c040d8184e9324bfc522aa","638a83cdcddc090dca287f5d7b7cdf01186e17dfaaea7b20999989d330b95275","57e0eb2949a36cf8c48fe1dc8f715aef3d8e08285bd19f1601ad67dae7d6744c","f85332b8755c669bade7dd265c4b53c3eb3bca97e42f2dafa21c0ee11bc1ad9c"],"paragraph_range_zero_based":[5976,5999],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p5976"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>else if the MobilityFromEUTRACommand message is included in the dl-DCCH-MessageEUTRA:","paragraph_zero_based":6000},{"literal_text_all_w_t_and_m_t":"2>perform the mobility from E-UTRA procedure as specified in TS 36.331 [10], clause 5.4.3.3;","paragraph_zero_based":6001},{"literal_text_all_w_t_and_m_t":"5.7.2UL information transfer","paragraph_zero_based":6002},{"literal_text_all_w_t_and_m_t":"5.7.2.1General","paragraph_zero_based":6003},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":6004},{"literal_text_all_w_t_and_m_t":"Figure 5.7.2.1-1: UL information transfer","paragraph_zero_based":6005},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to transfer NAS dedicated information from the UE to the network in RRC_CONNECTED or in RRC_INACTIVE during SDT, or to transfer F1-C related information from IAB-DU to IAB Donor-CU via the collocated IAB-MT in RRC_CONNECTED.","paragraph_zero_based":6006},{"literal_text_all_w_t_and_m_t":"5.7.2.2Initiation","paragraph_zero_based":6007},{"literal_text_all_w_t_and_m_t":"A UE in RRC_CONNECTED or a UE in RRC_INACTIVE during SDT initiates the UL information transfer procedure whenever there is a need to transfer NAS dedicated information. The UE initiates the UL information transfer procedure by sending the ULInformationTransfer message. In addition, an IAB-MT in RRC_CONNECTED initiates the UL information transfer procedure whenever there is a need to transfer F1-C related information. When F1-C related information has to be transferred, the IAB-MT shall initiate the procedure only if SRB2 or split SRB2 is established.","paragraph_zero_based":6008},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":6009},{"literal_text_all_w_t_and_m_t":"5.7.2.3Actions related to transmission of ULInformationTransfer message","paragraph_zero_based":6010},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of the ULInformationTransfer message as follows:","paragraph_zero_based":6011},{"literal_text_all_w_t_and_m_t":"1>if the upper layer provides NAS PDU:","paragraph_zero_based":6012},{"literal_text_all_w_t_and_m_t":"2>set the dedicatedNAS-Message to include the information received from upper layers;","paragraph_zero_based":6013},{"literal_text_all_w_t_and_m_t":"1>for the IAB-MT, if there is a need to transfer F1-C related information:","paragraph_zero_based":6014},{"literal_text_all_w_t_and_m_t":"2>include the dedicatedInfoF1c;","paragraph_zero_based":6015},{"literal_text_all_w_t_and_m_t":"1>submit the ULInformationTransfer message to lower layers for transmission, upon which the procedure ends.","paragraph_zero_based":6016},{"literal_text_all_w_t_and_m_t":"5.7.2.4Failure to deliver ULInformationTransfer message","paragraph_zero_based":6017},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":6018},{"literal_text_all_w_t_and_m_t":"1>if AS security is not started and radio link failure occurs before the successful delivery of ULInformationTransfer messages has been confirmed by lower layers; or","paragraph_zero_based":6019},{"literal_text_all_w_t_and_m_t":"1>if PDCP re-establishment or release/addition (e.g due to key refresh upon PCell or PSCell change, or RRC connection re-establishment, or failure of resume procedure initiated for SDT) occurs on an SRB on which ULInformationTransfer messages were submitted for transmission but successful delivery of these messages was not confirmed by lower layers:","paragraph_zero_based":6020},{"literal_text_all_w_t_and_m_t":"2>inform upper layers about the possible failure to deliver the information contained in the concerned ULInformationTransfer messages, unless the messages only include dedicatedInfoF1c.","paragraph_zero_based":6021},{"literal_text_all_w_t_and_m_t":"5.7.2aUL information transfer for MR-DC","paragraph_zero_based":6022},{"literal_text_all_w_t_and_m_t":"5.7.2a.1General","paragraph_zero_based":6023}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["2c89a72c1da088a70da66ba2b6e44f569f28af53d9c2ba809653fd26a55be73d","f1229154520b25e8c49e20ce729d4cde91056b22ed4baa68ed0f887bad11e3b3","b78c2a04bf74aa7ce048a672e2226efc29e71a2bd2edc65a4f07bb144ceefcb0","81e2b652dce4b4765ba8134cc14f7a7feb560e284414985b439c7d5b3a15b6bf","12d943b7a9f9c0f493311eefa074fbbda9c5226990e35d85f7a29d0229bf1092","9abd960bd579d394eb12012f7679fc0c29508b3adc0122e361979228ff58de32","7f23df0b34cf9743a0743a83e94aa07239d7fe88bcd8afbbaaa5c1cf3ccb8b72","60acf303e370c459f73b2840c2374ab13c0ee472818ad159cc85d8fc7e5f50ac","acf84061ca28af26590334cca63783ee168835089fe56fef291fad3421041726","20508c504d11dcd5f16f397f594a1a9eef67a3a8647f87de4ee31ef1f3d2f663","bb0187f466eb790bb877fd6ea4a23fa1180a29df52c6f856b09b4330f45104dd","b06c261cbeb08a5988d6244f3d310956daf96bd058d1868a91be79ce69cc4214","8249e4fc1611e536898457245a9d29001c6ff64bdbe5cbdf03a72de894592543","245b9249e0a4b2a489e4a8a2bea32dc5b12cf8a1b103ebc69a9883832fb22985","cf29b4ffc6d8c4cac3ad2e3878996b81986a2a85335e382c6008ad20adac4d3e","e32b541aebfddeb03eddba2d3cff0420fe87c007c7fe4ed0fc6caf24e4dc7c91","2e07bf3700df941a3b8f3a4edf2b4954d3106b3f606182dd0986b1bb4a0be4b9","0aa970b57704595909479c824363e3793a9228aaa50cfc55f302f699e08bcfde","da6e12d0240df68c6c6394463ba07a16711eca867e7fa2601c2431ace1c835dc","abb3b87940e8290b2ebfc20e2dcb3d3f11d377bd43f2405abb3651d73add7725","7561f0601e8988c3f5fef2a01ccbc1ddb1f64c108d5b186ca0ce78bd51d0803e","de8831ec4f308e94fa7e5889141967d75c5330c17b61a17bc1e4230aa6f307d9","b35ea822b5c51657a5eaba4d351e38a47e3b6b7566d6bdb0cb55d8990da188b5","3454ec2864b5cc0592ea1c7b40c7db8e31d1c1a12e6e7e27846f171a71f61977"],"paragraph_range_zero_based":[6000,6023],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p6000"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":6024},{"literal_text_all_w_t_and_m_t":"Figure 5.7.2a.1-1: UL information transfer MR-DC","paragraph_zero_based":6025},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to transfer MR-DC dedicated information from the UE to the network e.g. the NR or E-UTRA RRC MeasurementReport, FailureInformation, UEAssistanceInformation, RRCReconfigurationComplete, MCGFailureInformation, or IABOtherInformation message.","paragraph_zero_based":6026},{"literal_text_all_w_t_and_m_t":"5.7.2a.2Initiation","paragraph_zero_based":6027},{"literal_text_all_w_t_and_m_t":"A UE in RRC_CONNECTED initiates the UL information transfer for MR-DC procedure whenever there is a need to transfer MR-DC dedicated information. I.e. the procedure is not used during an RRC connection reconfiguration involving NR or E-UTRA connection reconfiguration, in which case the MR DC information is piggybacked to the RRCReconfigurationComplete message, except in the case the UE executes an intra-SN CPC.","paragraph_zero_based":6028},{"literal_text_all_w_t_and_m_t":"5.7.2a.3Actions related to transmission of ULInformationTransferMRDC message","paragraph_zero_based":6029},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of the ULInformationTransferMRDC message as follows:","paragraph_zero_based":6030},{"literal_text_all_w_t_and_m_t":"1>if there is a need to transfer MR-DC dedicated information related to NR:","paragraph_zero_based":6031},{"literal_text_all_w_t_and_m_t":"2>set the ul-DCCH-MessageNR to include the NR MR-DC dedicated information to be transferred (e.g., NR RRC MeasurementReport, UEAssistanceInformation, FailureInformation, RRCReconfigurationComplete, MCGFailureInformation, or IABOtherInformation message);","paragraph_zero_based":6032},{"literal_text_all_w_t_and_m_t":"1>else if there is a need to transfer MR-DC dedicated information related to E-UTRA:","paragraph_zero_based":6033},{"literal_text_all_w_t_and_m_t":"2>set the ul-DCCH-MessageEUTRA to include the E-UTRA MR-DC dedicated information to be transferred (e.g., E-UTRA RRC MeasurementReport, or MCGFailureInformation message);","paragraph_zero_based":6034},{"literal_text_all_w_t_and_m_t":"1>submit the ULInformationTransferMRDC message to lower layers for transmission, upon which the procedure ends.","paragraph_zero_based":6035},{"literal_text_all_w_t_and_m_t":"5.7.2bUL transfer of IRAT information","paragraph_zero_based":6036},{"literal_text_all_w_t_and_m_t":"5.7.2b.1General","paragraph_zero_based":6037},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":6038},{"literal_text_all_w_t_and_m_t":"Figure 5.7.2b.1-1: UL transfer of IRAT information","paragraph_zero_based":6039},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to transfer from the UE to NR MCG dedicated information terminated at the NR MCG but specified by another RAT e.g. the E-UTRA MeasurementReport message, the E-UTRA SidelinkUEInformation message or the E-UTRA UEAssistanceInformation message. The specific information transferred in this message is set in accordance with:","paragraph_zero_based":6040},{"literal_text_all_w_t_and_m_t":"-the procedure specified in 5.6.10 of TS 36.331 [10] for E-UTRA UEAssistanceInformation message;","paragraph_zero_based":6041},{"literal_text_all_w_t_and_m_t":"-the procedure specified in 5.10.2 of TS 36.331 [10] for E-UTRA SidelinkUEInformation message;","paragraph_zero_based":6042},{"literal_text_all_w_t_and_m_t":"-the procedure specified in 5.5.5 of TS 36.331 [10] for E-UTRA MeasurementReport Message.","paragraph_zero_based":6043},{"literal_text_all_w_t_and_m_t":"5.7.2b.2Initiation","paragraph_zero_based":6044},{"literal_text_all_w_t_and_m_t":"A UE in RRC_CONNECTED initiates the UL information transfer procedure whenever there is a need to transfer dedicated inter-RAT information as specified in TS 36.331 [10].","paragraph_zero_based":6045},{"literal_text_all_w_t_and_m_t":"5.7.2b.3Actions related to transmission of ULInformationTransferIRAT message","paragraph_zero_based":6046},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of the ULInformationTransferIRAT message as follows:","paragraph_zero_based":6047}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["7dc5d8e3d5ee9fcedcfcbb5fa04fe169f2c677cab2a963213aba06b7e04bb515","d02d7a2f6850ee422f616f5f82803abbd69bdfc8b4e1db252909c0de4fb184b0","174da09e12db1a9696423d853f42019fe0585bb6dc14aee17755eef25a686111","a0b53e61f2d86c89b25c99887819c7ca5717b9a442b6925b610121743eb9b265","35594bae739ea63c36061d69099b0857e4018948451b33a6210732a6251ff829","bd421ad4d3a7f44ba3c0e47a7c941f58f75e4197a4780adb5636cc9354d4bdbb","7f2257340fc84e5e934d19c05c3eb693025ad895715a473863de09723d07a1b9","6641a19aa6f891c2c667d512df9c0e84fc5ed68bf5fd7a78b4a2f3ad577e49e5","c00b55bc071b9d5150b4a00a5c6275043e280909ac38df20863bdbc0337bd792","c8914900cdf2bacc4c2003f124ed6a802e4f425b7d79b285089131b4bf2ab4e4","555e1c4206f31fd9cbd7759121d469e06aa87fe341de8ff3cf0eaec100898119","2dabf3892cbf2d620a3969af0c5afa47ccb00113b4db602ac74956922f008728","249502085ed69a68eb9d79021849fb6aba401118ac3068381c9edd996940619c","77fa314746950eed7ee156db7645dc701acb92971939a7b482b11ff687e41c44","41612a25ca5783f7af0529d8245b36c8f8822af01726b3697a07e2005b3dda25","eafd674a4145adb07a42ca46695ad969022d9295e05626dfd2907559c8136bbe","ef2406b6fc58613e1ec6abceaf739b7a69131dc5962fc2ecda079dae3e8e4ca8","398646ef5fd7f7cc74e498ef501eca1b1009b638c564a783a4acaabaa60c7ec4","857aabcc99ea30e58353e50886494370be3b691edb1181fa057d4b7f4ed81e12","6396a88e0b971746cf22564f1d567d954b9b5a920545df6b0c2430e4fbdca4c7","b3b117f63d008c6e53870dc88b8da563ea3f7e05f59eb16da891f7e86cd8f2d8","b81a0cb409cd5513340537f679758c1c42806c9fc958bb48b8df119d27e807ad","41f1cce0972a72c66e8222a068d57754b4224d7831d0b69e708cc964a922a139","37238c829f17c70cd23c1a3c9e3a61f6e74b607cfea884355f1446907a36b5f0"],"paragraph_range_zero_based":[6024,6047],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p6024"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>if there is a need to transfer dedicated LTE information related to V2X sidelink communications:","paragraph_zero_based":6048},{"literal_text_all_w_t_and_m_t":"2>set the ul-DCCH-MessageEUTRA to include the V2X sidelink communication information to be transferred (e.g. the E-UTRA RRC MeasurementReport message, the E-UTRA RRC SidelinkUEInformation message, or the E-UTRA RRC UEAssistanceInformation message);","paragraph_zero_based":6049},{"literal_text_all_w_t_and_m_t":"1>submit the ULInformationTransferIRAT message to lower layers for transmission, upon which the procedure ends;","paragraph_zero_based":6050},{"literal_text_all_w_t_and_m_t":"5.7.3SCG failure information","paragraph_zero_based":6051},{"literal_text_all_w_t_and_m_t":"5.7.3.1General","paragraph_zero_based":6052},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":6053},{"literal_text_all_w_t_and_m_t":"Figure 5.7.3.1-1: SCG failure information","paragraph_zero_based":6054},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to inform E-UTRAN or NR MN about an SCG failure the UE has experienced i.e. SCG radio link failure, beam failure of the PSCell while the SCG is deactivated, failure of SCG reconfiguration with sync, SCG configuration failure for RRC message on SRB3, SCG integrity check failure, and consistent uplink LBT failures on PSCell for operation with shared spectrum channel access.","paragraph_zero_based":6055},{"literal_text_all_w_t_and_m_t":"5.7.3.2Initiation","paragraph_zero_based":6056},{"literal_text_all_w_t_and_m_t":"A UE initiates the procedure to report SCG failures when neither MCG nor SCG transmission is suspended and when one of the following conditions is met:","paragraph_zero_based":6057},{"literal_text_all_w_t_and_m_t":"1>upon detecting radio link failure for the SCG, in accordance with clause 5.3.10.3;","paragraph_zero_based":6058},{"literal_text_all_w_t_and_m_t":"1>upon detecting beam failure of the PSCell while the SCG is deactivated, in accordance with TS 38.321[3];","paragraph_zero_based":6059},{"literal_text_all_w_t_and_m_t":"1>upon reconfiguration with sync failure of the SCG, in accordance with clause 5.3.5.8.3;","paragraph_zero_based":6060},{"literal_text_all_w_t_and_m_t":"1>upon SCG configuration failure, in accordance with clause 5.3.5.8.2;","paragraph_zero_based":6061},{"literal_text_all_w_t_and_m_t":"1>upon integrity check failure indication from SCG lower layers concerning SRB3.","paragraph_zero_based":6062},{"literal_text_all_w_t_and_m_t":"Upon initiating the procedure, the UE shall:","paragraph_zero_based":6063},{"literal_text_all_w_t_and_m_t":"1>if the procedure was not initiated due to beam failure of the PSCell while the SCG is deactivated:","paragraph_zero_based":6064},{"literal_text_all_w_t_and_m_t":"2>suspend SCG transmission for all SRBs, DRBs and, if any, BH RLC channels;","paragraph_zero_based":6065},{"literal_text_all_w_t_and_m_t":"2>reset SCG MAC;","paragraph_zero_based":6066},{"literal_text_all_w_t_and_m_t":"1>stop T304 for the SCG, if running;","paragraph_zero_based":6067},{"literal_text_all_w_t_and_m_t":"1>stop conditional reconfiguration evaluation for CPC or CPA, if configured;","paragraph_zero_based":6068},{"literal_text_all_w_t_and_m_t":"1>if the UE is in (NG)EN-DC:","paragraph_zero_based":6069},{"literal_text_all_w_t_and_m_t":"2>initiate transmission of the SCGFailureInformationNR message as specified in TS 36.331 [10], clause 5.6.13a.","paragraph_zero_based":6070},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":6071}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["d6d756d4dab8513598b99a412c1559c942e84e9c7e6d936c6971def477f1700d","5a473513ab0678a892c0efff275e6b8721a6fbae21224f04cfccd972a8ff3aac","1e97ce3204b83cb8367bf1536fe4af2c07947bce721102cd4200e643aef06112","264b9665aca743cc1dc49f12489c2722a3586d81237f27757467b9406f364588","f7b4d44d0dd38d19bb7042cdca55ddf630427829494676656909117887b922e0","29c0b31b7da43dc14245697b4ea944cf6dc2e18e9d05c0ef0a1ff9aeb054931d","b81d5d972b9836b24fbd429e98484171635471191d4b26a02f30187ae9f1efe7","7e6d3fb1da16a930475a97f574c98f62776764243d1573ffdecadde99b506fc4","42bb971df467fa4e69abafa8c478b3d746b6dd7554501b0d321a6944706b1236","25028d56bcab0fb5c95dac6a30b45ce795c838547dd8a75b485ae2259dd30792","982d5a6c4a9c91cdd7f22a8ade5454f554bae69760f290138c0ae5f5787485c6","06696aba86416e2ae6c3d57c32f1eb10dc65676e55012ac790e0ed54f91c92c0","e3a7838c9e7a9b41e65b2029ee3bdde131451280e28a82a26fde76e90a2cf718","56da9e252b38974e585b7550a9a122a044c0754b636a9e50250b11c0d3cf987a","f38bb1a52cfabf9b47e535783778ccb86a0dbd2300b11944ba3b011ecf5122ca","bf5f61a8741bb299684d6c2f1a5203a41ef4b0bb2d3c818e4e631333e904cacf","eea88a11ae3380675ae8194b01ea6af46995f830d798e82db48b767acc702bf7","fa2714f76545ecd3c1869d8bfb2273d661e529cdf540f59eebca73c6165a4483","1b5ec8569fc840b9eeb81dd5ad9b71c2afa6061fc65631599a5f4389999e477e","a77d7be97b71f4c302d5d906bceb76f629293202091b3634f4e4425150a80806","db314c2855e12735e6ef9711c68daa92ac994dc687afb21b532712b4a02a6865","d559495b19dd3faa0d0d17b85f733ffd849b6352e62d042a78fcc0f2f64ccd4b","6436f08ef2541c2708eeb41047b63f6fe8ed92125e5c3ba23d557dae9b1c1b13","0f16e20cde201f24a28a9e893e7868c8b94b3f82128399443694b124e13b4ac1"],"paragraph_range_zero_based":[6048,6071],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p6048"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>initiate transmission of the SCGFailureInformation message in accordance with 5.7.3.5.","paragraph_zero_based":6072},{"literal_text_all_w_t_and_m_t":"5.7.3.3Failure type determination for (NG)EN-DC","paragraph_zero_based":6073},{"literal_text_all_w_t_and_m_t":"The UE shall set the SCG failure type as follows:","paragraph_zero_based":6074},{"literal_text_all_w_t_and_m_t":"1>if the UE initiates transmission of the SCGFailureInformationNR message due to T310 expiry:","paragraph_zero_based":6075},{"literal_text_all_w_t_and_m_t":"2>set the failureType as t310-Expiry;","paragraph_zero_based":6076},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformationNR message due to T312 expiry:","paragraph_zero_based":6077},{"literal_text_all_w_t_and_m_t":"2>set the failureType as any value and set the failureType-v1610 as t312-Expiry;","paragraph_zero_based":6078},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformationNR message to provide reconfiguration with sync failure information for an SCG:","paragraph_zero_based":6079},{"literal_text_all_w_t_and_m_t":"2>set the failureType as synchReconfigFailureSCG;","paragraph_zero_based":6080},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformationNR message to provide random access problem indication from SCG MAC:","paragraph_zero_based":6081},{"literal_text_all_w_t_and_m_t":"2>if the random access procedure was initiated for beam failure recovery:","paragraph_zero_based":6082},{"literal_text_all_w_t_and_m_t":"3>set the failureType as randomAccessProblem and set the failureType-v1610 as beamFailureRecoveryFailure;","paragraph_zero_based":6083},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":6084},{"literal_text_all_w_t_and_m_t":"3>set the failureType as randomAccessProblem;","paragraph_zero_based":6085},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformationNR message to provide indication from SCG RLC that the maximum number of retransmissions has been reached:","paragraph_zero_based":6086},{"literal_text_all_w_t_and_m_t":"2>set the failureType as rlc-MaxNumRetx;","paragraph_zero_based":6087},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformationNR message due to SRB3 integrity check failure:","paragraph_zero_based":6088},{"literal_text_all_w_t_and_m_t":"2>set the failureType as srb3-IntegrityFailure;","paragraph_zero_based":6089},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformationNR message due to Reconfiguration failure of NR RRC reconfiguration message:","paragraph_zero_based":6090},{"literal_text_all_w_t_and_m_t":"2>set the failureType as scg-reconfigFailure;","paragraph_zero_based":6091},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformationNR message due to consistent uplink LBT failures:","paragraph_zero_based":6092},{"literal_text_all_w_t_and_m_t":"2>set the failureType as any value and set the failureType-v1610 as scg-lbtFailure;","paragraph_zero_based":6093},{"literal_text_all_w_t_and_m_t":"1> else if connected as an IAB-node and the SCGFailureInformationNR is initiated due to the reception of a BH RLF indication on BAP entity from the SCG:","paragraph_zero_based":6094},{"literal_text_all_w_t_and_m_t":"2>set the failureType as any value and set failureType-v1610 as bh-RLF.","paragraph_zero_based":6095}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["82e1de9325fd16509cc8926915ef5258f625c30ad456f81f965d0aeac199e9d8","5677ebb4ebcf16b93ab51f5472bb1168dcfcb80e31636fda77714201e186be88","655afc8ee932603ddba3a65941e4d5b7fc2fe72ad5f2ea9764b1826582b3020a","ebd0ea127b6bd54fc136c22fc29a4cde16ed3fb54e4a86ccb49bd662934b4822","e84bd1a2f5e4f672e36f1c76a3322abadc7aa57c01cbdf876ebf7bd9b3084869","b57ef6e4ae9f468c25297d9f452c89d357d62ef03c490aa34cc154f33c7e1ced","e239e20ff2ece7c16296fb659d74d6fe916f09123537ebdd5fac7ec0afa80342","8a7dbf6ca6e7594697370cf21a98c4776d80b7e4b7c0fbdbee4ac1be22d7da04","ae1b36f8b431681e113711d15e0a53b4e88b26d307640cf317c63963cad7a6f9","131fc915beb277146f30609ce80b7d2d53145cb96441576e35c526b6b58a7ade","abec3be0d11b44a8d171d4be3f425d7aa842c91c86e596dd995159dd8dd2d7f3","66c0cbc96bde3b9ee99dea4f7d9ff0403eb6b7e3888bda21bd8cd9ba519db774","254bd289770bd602b52c8e2bd819462fc96750b5db2b0feb1ec6c3c9ac195409","b8695f69da9aab666ad88ca8c6c81e70e147c3f5de3dda24b82146e0a6492d07","b7e0f66e3f4a1cf06a094f45a5f130d067cf24e19302682efdc13134458498a9","d36fb0b0c6db11a60625f7ef7507b298845ea6b42901731d50542fc568b90df4","391aa8c41299caff9ff2d5ccc89d594ceac1063d629bee9e2efb4842abd6f2b9","3e1730838704147d41ccfb0e6194dabdd49d41bd296117751220959e5cfdaefa","b78fe2596c86c2afe7821b7374fba3160640ba91703cbb64c4396fe40826175f","8d53989e5558a438c854a5dc7918b53859297ece2c1008fa0ef7c3cbe5aa6ba2","2262883e89de58e84cd01fbb6e4e0aaf52b21e2d20d3704b5b21d799d945e5cc","0927c55c9cecb65becf39f17d280f91549ceb8a73fbec40f519ec34b2922b565","d877950478e22bf9eac3a4c0c1a58065a3c14de2839ab445630784bffd4994a4","0521cb1ed328abf6caaedf10ed188423a4e1c80f2e74adcb3be9a3d14e79093f"],"paragraph_range_zero_based":[6072,6095],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p6072"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformationNR message due to beam failure of the PSCell while the SCG is deactivated:","paragraph_zero_based":6096},{"literal_text_all_w_t_and_m_t":"2>set the failureType as any value and set failureType-v1610 as beamFailure.","paragraph_zero_based":6097},{"literal_text_all_w_t_and_m_t":"5.7.3.4Setting the contents of MeasResultSCG-Failure","paragraph_zero_based":6098},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of the MeasResultSCG-Failure as follows:","paragraph_zero_based":6099},{"literal_text_all_w_t_and_m_t":"1>for each MeasObjectNR configured on NR SCG for which a measId is configured and measurement results are available:","paragraph_zero_based":6100},{"literal_text_all_w_t_and_m_t":"2>include an entry in measResultPerMOList;","paragraph_zero_based":6101},{"literal_text_all_w_t_and_m_t":"2>if there is a measId configured with the MeasObjectNR and a reportConfig which has rsType set to ssb:","paragraph_zero_based":6102},{"literal_text_all_w_t_and_m_t":"3>set ssbFrequency to the value indicated by ssbFrequency as included in the MeasObjectNR;","paragraph_zero_based":6103},{"literal_text_all_w_t_and_m_t":"2>if there is a measId configured with the MeasObjectNR and a reportConfig which has rsType set to csi-rs:","paragraph_zero_based":6104},{"literal_text_all_w_t_and_m_t":"3>set refFreqCSI-RS to the value indicated by refFreqCSI-RS as included in the associated measurement object;","paragraph_zero_based":6105},{"literal_text_all_w_t_and_m_t":"2>if a serving cell is associated with the MeasObjectNR:","paragraph_zero_based":6106},{"literal_text_all_w_t_and_m_t":"3>set measResultServingCell to include the available quantities of the concerned cell and in accordance with the performance requirements in TS 38.133 [14];","paragraph_zero_based":6107},{"literal_text_all_w_t_and_m_t":"2>set the measResultNeighCellList to include the best measured cells, ordered such that the best cell is listed first, and based on measurements collected up to the moment the UE detected the failure, and set its fields as follows;","paragraph_zero_based":6108},{"literal_text_all_w_t_and_m_t":"3>ordering the cells with sorting as follows:","paragraph_zero_based":6109},{"literal_text_all_w_t_and_m_t":"4>based on SS/PBCH block if SS/PBCH block measurement results are available and otherwise based on CSI-RS;","paragraph_zero_based":6110},{"literal_text_all_w_t_and_m_t":"4>using RSRP if RSRP measurement results are available, otherwise using RSRQ if RSRQ measurement results are available, otherwise using SINR;","paragraph_zero_based":6111},{"literal_text_all_w_t_and_m_t":"3>for each neighbour cell included:","paragraph_zero_based":6112},{"literal_text_all_w_t_and_m_t":"4>include the optional fields that are available.","paragraph_zero_based":6113},{"literal_text_all_w_t_and_m_t":"NOTE:The measured quantities are filtered by the L3 filter as configured in the mobility measurement configuration. The measurements are based on the time domain measurement resource restriction, if configured. Exclude-listed cells are not required to be reported.","paragraph_zero_based":6114},{"literal_text_all_w_t_and_m_t":"1>if available, set the locationInfo as in 5.3.3.7 according to the otherConfig associated with the NR SCG.","paragraph_zero_based":6115},{"literal_text_all_w_t_and_m_t":"5.7.3.5Actions related to transmission of SCGFailureInformation message","paragraph_zero_based":6116},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of the SCGFailureInformation message as follows:","paragraph_zero_based":6117},{"literal_text_all_w_t_and_m_t":"1>if the UE initiates transmission of the SCGFailureInformation message due to T310 expiry:","paragraph_zero_based":6118},{"literal_text_all_w_t_and_m_t":"2>set the failureType as t310-Expiry;","paragraph_zero_based":6119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["4aabe3baedded76ed0f9fde376cc3e3a19b2d7b9bae4a59ec16fd124bef02275","3ecc124be30cb1cf6177388821317603d265df94e2c93ebdc275325133967606","435f78c8316d708bd0aeb6dab04e0eaeef76bf54d239ea5e80adf67bce762f2e","e6838a80c736df37d1baf61416fa7834a582b770c02e543a27db3aea4bb613da","7a778614aa09dcac7bef94c81a983cb5283a3094a9bc0434319b07c3117ce85b","5904b8b7c95e1257f2086f5edd13f5142c8972792f3f9266e6a3aa81095c6fa1","8ad1ac48c3d7897f1e279f9d0caf723d5d09687f9dc2fecc1ce655412e6e5540","e27ebb60de29baf9a951111ad428b6fe166aff1256b13b53539715aa0d600a8d","0db007a00781bdaf602a0b659b8de31864233fec258f29a9e371a885a22b2a0d","d6de0f8c6cb32a0f52b9053e18d433958a6a76fc0d0f9aacd48f52b530d6d373","634a2600661e7c7dac75f9d54e4ed69b07edb40aa455d6acde8e0e85333c2bf4","611fb7901a2d7ff568b70f57501796fab221a4f2095f1b44945b98f84e6075b2","b4506e4f87611a98ae28eb30fe574e8700d59ef58736b5793f6d046652fffb18","c8c41eb58dcbd51a8406248b27c263216b857da891965c816c3e4d956e966b6a","3dd67591b7d4f237a072e3759870447e430750c1a4831c8687192e173d6587b4","f1f6145c0842c875e658e612bb5d6121cb0bc4ce32246e82211f445ea81fcf9f","456ee1263858137d49d934f59aaf924883b625e3fc1198a131326bfb943b30c1","f27ef5a41ad4b8ad6eb5928383b58f8507bbf32368954295368e26ab9b7681a7","b0487521e58873d180bbbaded5b533c12866b6f6ab66160c1104f4f6bfb2f875","f6308537dcad443e239c96d6a70f5b4bd6f0f71497bbb2dbde8272bca77e0087","c9881ff54401dda8ca4ed500682877059664c99ae1e15e65d31a973eeda657ad","16d32dfd066974c6cf385fc24d3a957d4edf09e3d30bcb9f5e3c940c046977d7","a4cff7c6370a7a0d6441be3c8772ba70498d1dc4cb439134e54acb1ee42c2fc1","d721cc1212b92063588ec74f6be6d39d62337b826acef22dee8ffaa387f1206f"],"paragraph_range_zero_based":[6096,6119],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p6096"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformation message due to T312 expiry:","paragraph_zero_based":6120},{"literal_text_all_w_t_and_m_t":"2>set the failureType as other and set the failureType-v1610 as t312-Expiry;","paragraph_zero_based":6121},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformation message to provide reconfiguration with sync failure information for an SCG:","paragraph_zero_based":6122},{"literal_text_all_w_t_and_m_t":"2>set the failureType as synchReconfigFailureSCG;","paragraph_zero_based":6123},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformation message to provide random access problem indication from SCG MAC:","paragraph_zero_based":6124},{"literal_text_all_w_t_and_m_t":"2>if the random access procedure was initiated for beam failure recovery:","paragraph_zero_based":6125},{"literal_text_all_w_t_and_m_t":"3>set the failureType as other and set the failureType-v1610 as beamFailureRecoveryFailure;","paragraph_zero_based":6126},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":6127},{"literal_text_all_w_t_and_m_t":"3>set the failureType as randomAccessProblem;","paragraph_zero_based":6128},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformation message to provide indication from SCG RLC that the maximum number of retransmissions has been reached:","paragraph_zero_based":6129},{"literal_text_all_w_t_and_m_t":"2>set the failureType as rlc-MaxNumRetx;","paragraph_zero_based":6130},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformation message due to SRB3 IP check failure:","paragraph_zero_based":6131},{"literal_text_all_w_t_and_m_t":"2>set the failureType as srb3-IntegrityFailure;","paragraph_zero_based":6132},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformation message due to Reconfiguration failure of NR RRC reconfiguration message:","paragraph_zero_based":6133},{"literal_text_all_w_t_and_m_t":"2>set the failureType as scg-reconfigFailure;","paragraph_zero_based":6134},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformation message due to consistent uplink LBT failures:","paragraph_zero_based":6135},{"literal_text_all_w_t_and_m_t":"2>set the failureType as other and set the failureType-v1610 as scg-lbtFailure;","paragraph_zero_based":6136},{"literal_text_all_w_t_and_m_t":"1>else if connected as an IAB-node and the SCGFailureInformation is initiated due to the reception of a BH RLF indication on BAP entity from the SCG:","paragraph_zero_based":6137},{"literal_text_all_w_t_and_m_t":"2>set the failureType as other and set failureType-v1610 as bh-RLF;","paragraph_zero_based":6138},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformation message due to beam failure of the PSCell while the SCG is deactivated:","paragraph_zero_based":6139},{"literal_text_all_w_t_and_m_t":"2>set the failureType as other and set failureType-v1610 as beamFailure;","paragraph_zero_based":6140},{"literal_text_all_w_t_and_m_t":"1> include and set MeasResultSCG-Failure in accordance with 5.7.3.4;","paragraph_zero_based":6141},{"literal_text_all_w_t_and_m_t":"1>for each MeasObjectNR configured by a MeasConfig associated with the MCG, and for which measurement results are available:","paragraph_zero_based":6142},{"literal_text_all_w_t_and_m_t":"2>include an entry in measResultFreqList;","paragraph_zero_based":6143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["f8fd24998b61f12df25cfd102abefedae3a60eb3eeb6a065b19d662ebb87daee","7b09c2605ed3d5fbd87f09d422f23500dabd318ee7cb247dd31e0bed7769b781","ae0a76a3d0ccd51b0b1af7c38dea1f465de1cbe00b7944cc9cdff0a9934bda09","6602fd552792c9618939c9b18cf5872999defa9afbc071de208dd230082acdb3","546b611432b2e9c10d25d3dc971b5410a9eb749e2f52c8d19420a96a9a0210d9","5f9b0ca71459693ba857d65f4a4f825900db2893e7549750b797fb6a92a2e3d2","d7ae9eea3af3a45b1accf336ac855ec076e60b044fc6065e83fd9396a27b1242","b3e7ca7b8786293b924e2989f40c5185eb79e891282a54211f5e182e01dc3e5b","900c444296109f72bf072601bbf9276e3c6452c9fb1b2a7be9ea6fce98c9c9b2","bc2343d142d96e53a2e2b569a0663e68a6a95021361f2d62d246118640720430","03aa325573c1f86c13ff3b580d32917e455ac2073dfc7be48ee899e67f92c933","03f127f94d9b6c999ce505c1d7301d3ba01498bee78d21c640b69991ac5519d4","3e8a41fe69a8211aa04791430fd6ea25abc5bf527dc774c60d368cd8e9ab72d2","28b2c4e322670af8a0c709b8be234a9ed682016fc0a2ee42c8836df664e6469a","dafca675e160e4ebe640034590ad83701011ce6264e09fe812839c59a63973c6","905ca99b3840bf2bf7c91b55cc3b4b5f2a4a8e178591fd8c5f9d5666f6052d1c","ac6a58be25a16b979b03cf779610c0b437c78c688c83d7f37eeb39f5a961c873","4c1fda278a85d4b1457e27feec6a975fb158e331618da3129a66caa83b1289ab","9b6d58b9a761aff45e98ca6c43aad3ea0c699b4077771d9d61a272478fde3944","c4ef218f74a84fffed2b9f3b0ce6c0b7f65a9399bb08346bb1fc36f1004f3e19","92ea6b44dc0dbf3a3a462a206c24cfd9c6e33d5e2dbb5a8909a64a7f6c90f079","502866210cb5f8ee1e5ab3eb70d2bd20589842300fe27d4929fce373e157685c","a10bdbd0652a2fb1a060c2a8ffed24642e714d3570dad874c2a60b707e05d0ae","dd541b5bf78375e388c03af8acefdb0ab5d862a37e66b01b5af5708915302f01"],"paragraph_range_zero_based":[6120,6143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p6120"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if there is a measId configured with the MeasObjectNR and a reportConfig which has rsType set to ssb:","paragraph_zero_based":6144},{"literal_text_all_w_t_and_m_t":"3>set ssbFrequency in measResultFreqList to the value indicated by ssbFrequency as included in the MeasObjectNR;","paragraph_zero_based":6145},{"literal_text_all_w_t_and_m_t":"2>if there is a measId configured with the MeasObjectNR and a reportConfig which has rsType set to csi-rs:","paragraph_zero_based":6146},{"literal_text_all_w_t_and_m_t":"3>set refFreqCSI-RS in measResultFreqList to the value indicated by refFreqCSI-RS as included in the associated measurement object;","paragraph_zero_based":6147},{"literal_text_all_w_t_and_m_t":"2>if a serving cell is associated with the MeasObjectNR:","paragraph_zero_based":6148},{"literal_text_all_w_t_and_m_t":"3>set measResultServingCell in measResultFreqList to include the available quantities of the concerned cell and in accordance with the performance requirements in TS 38.133 [14];","paragraph_zero_based":6149},{"literal_text_all_w_t_and_m_t":"2>set the measResultNeighCellList in measResultFreqList to include the best measured cells, ordered such that the best cell is listed first, and based on measurements collected up to the moment the UE detected the failure, and set its fields as follows;","paragraph_zero_based":6150},{"literal_text_all_w_t_and_m_t":"3>ordering the cells with sorting as follows:","paragraph_zero_based":6151},{"literal_text_all_w_t_and_m_t":"4>based on SS/PBCH block if SS/PBCH block measurement results are available and otherwise based on CSI-RS;","paragraph_zero_based":6152},{"literal_text_all_w_t_and_m_t":"4>using RSRP if RSRP measurement results are available, otherwise using RSRQ if RSRQ measurement results are available, otherwise using SINR;","paragraph_zero_based":6153},{"literal_text_all_w_t_and_m_t":"3>for each neighbour cell included:","paragraph_zero_based":6154},{"literal_text_all_w_t_and_m_t":"4>include the optional fields that are available.","paragraph_zero_based":6155},{"literal_text_all_w_t_and_m_t":"NOTE 1:The measured quantities are filtered by the L3 filter as configured in the mobility measurement configuration. The measurements are based on the time domain measurement resource restriction, if configured. Exclude-listed cells are not required to be reported.","paragraph_zero_based":6156},{"literal_text_all_w_t_and_m_t":"NOTE 2:Field measResultSCG-Failure is used to report available results for NR frequencies the UE is configured to measure by SCG RRC signalling.","paragraph_zero_based":6157},{"literal_text_all_w_t_and_m_t":"1>if available, set the locationInfo as in 5.3.3.7 according to the otherConfig associated with the NR MCG.","paragraph_zero_based":6158},{"literal_text_all_w_t_and_m_t":"1>if the UE supports SCG failure for mobility robustness optimization:","paragraph_zero_based":6159},{"literal_text_all_w_t_and_m_t":"2>if the failureType is set to synchReconfigFailureSCG; or","paragraph_zero_based":6160},{"literal_text_all_w_t_and_m_t":"2>if the failureType is set to randomAccessProblem and the SCG failure was declared while T304 was running:","paragraph_zero_based":6161},{"literal_text_all_w_t_and_m_t":"3>set perRAInfoList to indicate the performed random access procedure related information as specified in 5.7.10.5.","paragraph_zero_based":6162},{"literal_text_all_w_t_and_m_t":"3>set the failedPSCellId to the physical cell identity and carrier frequency of the target PSCell of the failed PSCell change;","paragraph_zero_based":6163},{"literal_text_all_w_t_and_m_t":"3>set the previousPSCellId to the physical cell identity and carrier frequency of the source PSCell associated to the last received RRCReconfiguration message including reconfigurationWithSync for the SCG;","paragraph_zero_based":6164},{"literal_text_all_w_t_and_m_t":"3>set the timeSCGFailure to the elapsed time since the last execution of RRCReconfiguration message including the reconfigurationWithSync for the SCG until declaring the SCG failure;","paragraph_zero_based":6165},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":6166},{"literal_text_all_w_t_and_m_t":"3>set the failedPSCellId to the physical cell identity and carrier frequency of the PSCell in which the SCG failure was declared;","paragraph_zero_based":6167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["10a88ccbb0b1c445be2c2ccf13ab480cc1da007e19056be196fca0d0f43b13d8","2f083d208bd8fc3bb451125a6828b4626da2736655d2910c185dc5f8c6e90a6d","c2b4ca1479f5307d503b67bca72bcb590b4d8b5d1c094c485ecbdda5a6872d88","7443a9fbda940378db530e601182905c2db2dff36b4d9b2488a9bda80cdfc215","0cf4e10913f86677eb42b0bc8b2295a26c85b4ea5cca1f2b630204ef0edd3d25","3b4846f30baf755b1a36e05329bc132117c72268aab41ad40e64e666215c788c","e8d578fa20e4118d4f0806c0e2e5a1a874f567d216b5ebe853ce3bd29e88d7ed","1b779a724294709f2dc72285818af86e5e94896e84063462129f1f140a4e1b9a","b2d93d99a259185234faa19a75c36e1763c7d6c2cbe6e43eb9f36efe717e9b7b","4a1ec581a78c0abd803ff24ecbd407c9f75abedc1a4f60bfc697f4e98fba1112","ecbfd491d21b7092ac7c65b20111bda5cc0b59ccfcb24dc8fd69d6cfe6e80f82","538a4b672cad2c55f15cfdaf88c216d3993f79c7122a066b1cd20d7233c38c0e","792c56d4591fd6a55be9197b4f2dad82cd18b23c79650c68b35dabbca16a7dbe","9fc5dcf3d7ce7c59e72ce43eae588bf07f68bf255aef397cd534c65119b73a54","9bb9bec86e66669d385a8f2be5939695f1ffef938284d817adc69c19f671f9b8","86f58da0a6c8d95f8e3bd26c687d21d9f911fb2e2d5a7816594bb13bccc1929a","3adc0f8c0f77d9276e3a61db958509decc06858c7d9ac730b717817efc0ff0f4","514f960c18bc7d9a6810e51e37c529af4fb0b2623d5fec1349c589762e85267d","a1c409fd5146fed21e93474df7343414111df11be23f88d6dc62ac6de985096c","42b08a75a2d00da4ac8e380b633d123d8e19f4dd0a0ee4747bf5ed39f34e6b00","b9eb3b14e3a3fff18df7406c4701e8db0d414c891c3c856401183add2109beb7","e80c410685c5095ad3321a9493e6abf742a4f64728c2cb13bc77cfa6c5fc63d9","a537b3461760bde01871d709c0e34a233fb2ccee29fcb2796c92021e88a1da5e","cd7fc76668470db7e047f59e87c70a4407ba5c24bc7b830ef39a67cb05a4300d"],"paragraph_range_zero_based":[6144,6167],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p6144"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>if the last RRCReconfiguration message including the reconfigurationWithSync for the SCG was received to enter the PSCell in which the SCG failure was declared:","paragraph_zero_based":6168},{"literal_text_all_w_t_and_m_t":"4>set the timeSCGFailure to the elapsed time since the last execution of RRCReconfiguration message including the reconfigurationWithSync for the SCG until declaring the SCG failure;","paragraph_zero_based":6169},{"literal_text_all_w_t_and_m_t":"4>set the previousPSCellId to the physical cell identity and carrier frequency of the source PSCell associated to the last received RRCReconfiguration message including reconfigurationWithSync for the SCG;","paragraph_zero_based":6170},{"literal_text_all_w_t_and_m_t":"The UE shall submit the SCGFailureInformation message to lower layers for transmission.","paragraph_zero_based":6171},{"literal_text_all_w_t_and_m_t":"5.7.3aEUTRA SCG failure information","paragraph_zero_based":6172},{"literal_text_all_w_t_and_m_t":"5.7.3a.1General","paragraph_zero_based":6173},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":6174},{"literal_text_all_w_t_and_m_t":"Figure 5.7.3a.1-1: EUTRA SCG failure information","paragraph_zero_based":6175},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to inform NR MN about an SCG failure on E-UTRA SN the UE has experienced (e.g. SCG radio link failure, SCG change failure), as specified in TS 36.331 [10] clause 5.6.13.2.","paragraph_zero_based":6176},{"literal_text_all_w_t_and_m_t":"5.7.3a.2Initiation","paragraph_zero_based":6177},{"literal_text_all_w_t_and_m_t":"A UE initiates the procedure to report EUTRA SCG failures when neither NR MCG nor EUTRA SCG transmission is suspended and in accordance with TS 36.331 [10] clause 5.6.13.2. Actions the UE shall perform upon initiating the procedure, other than related to the transmission of the SCGFailureInformationEUTRA message are specified in TS 36.331 [10] clause 5.6.13.2.","paragraph_zero_based":6178},{"literal_text_all_w_t_and_m_t":"5.7.3a.3Actions related to transmission of SCGFailureInformationEUTRA message","paragraph_zero_based":6179},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of the SCGFailureInformationEUTRA message as follows:","paragraph_zero_based":6180},{"literal_text_all_w_t_and_m_t":"1>include failureType within failureReportSCG-EUTRA and set it to indicate the SCG failure in accordance with TS 36.331 [10] clause 5.6.13.4;","paragraph_zero_based":6181},{"literal_text_all_w_t_and_m_t":"1>include and set measResultSCG-FailureMRDC in accordance with TS 36.331 [10] clause 5.6.13.5;","paragraph_zero_based":6182},{"literal_text_all_w_t_and_m_t":"1>for each EUTRA frequency the UE is configured to measure by measConfig for which measurement results are available:","paragraph_zero_based":6183},{"literal_text_all_w_t_and_m_t":"2>set the measResultFreqListMRDC to include the best measured cells, ordered such that the best cell is listed first using RSRP to order if RSRP measurement results are available for cells on this frequency, otherwise using RSRQ to order if RSRQ measurement results are available for cells on this frequency, otherwise using SINR to order, and based on measurements collected up to the moment the UE detected the failure, and for each cell that is included, include the optional fields that are available;","paragraph_zero_based":6184},{"literal_text_all_w_t_and_m_t":"NOTE:Field measResultSCG-FailureMRDC is used to report available results for E-UTRAN frequencies the UE is configured to measure by E-UTRA RRC signalling.","paragraph_zero_based":6185},{"literal_text_all_w_t_and_m_t":"1>if available, set the locationInfo as in 5.3.3.7.:","paragraph_zero_based":6186},{"literal_text_all_w_t_and_m_t":"The UE shall submit the SCGFailureInformationEUTRA message to lower layers for transmission.","paragraph_zero_based":6187},{"literal_text_all_w_t_and_m_t":"5.7.3bMCG failure information","paragraph_zero_based":6188},{"literal_text_all_w_t_and_m_t":"5.7.3b.1General","paragraph_zero_based":6189},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":6190},{"literal_text_all_w_t_and_m_t":"Figure 5.7.3b.1-1: MCG failure information","paragraph_zero_based":6191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["53bd181a194a29d0a93daff711e3f7232bc144325ff724a7dbbfafd09e8c4231","986c57494f839d332bba78d5e915b438b25ebee9ab1aaa67d4fbac2863b1b24b","ba81a9fac802f97a2a072f34fdb03f5f73b884347569d53efe4fbbe5750f7fc1","15c34cf62da46bf9f8a37c48dc7727d2fa80fcf212d272d702b706b5f16e8f75","4b1b8fa85fe8812221f317da1eb18703255003330dcb253a526011d49ae39735","5213119136ce0e7d59b4771310e68712eb87c40d3032076c89aeb98900eba942","fbbe7486f5d81d64875ffbb539b6fa56933c5d0984a838f9033b9a195703e13e","e701ee44d158bf7b8b01bffbe8fde6bce43cc3aae9ac5480e4f044fcb54608a2","b69bf19e53090d2639ff23afa711cd050fcc7f9730c68f20c642a81feb6e128c","5a05f4db40b961625dd0f86f3abc96c5046802a4b27c042c19a17e69061faec8","325c343787771352b74355756517e195dfd2176a32e603958efabe12a68daa59","73222d241482d6adcdc512905026935cfd78637ecf8b5649edc9c411b41a1caa","4ed771c52079cf225f3bee1b3b7552cf947e8a4ded0c5a4c5ed3dff6d3ee7153","9d7cd404c52dd265d05f400ba449941cc4911b4ed7aac46d3e638361879e27b3","4a575ceec41b49134cc15e957a76ad470baa47488d12131f7397cfd9a58680f6","04fa4c2d7e1d805d176ff20c89d9f7ace9cce15c87af6f1be8b600e022f0db81","090ce5ebb2acc851257057e6d899802ca08c0d6f45bec5439bf9d32dbfe2dc12","d292799145c3628deb86793ddb7c28446217cfdfbdd902506a464c50825459ed","68188f353943e7cc53b9f502be428056cf2a6bce8bd5240776a483a60814e3b2","468871cabac73e989032b524585bc7baac0bb5460d4adbf896039670770ce532","bb8ccfef75003b0651a15458bfc4ac7c07035d38c42a2d112957c21ffdf130a5","727aa42e02e0a8c73612285d03c97496228062fa511bdbc5f7fc19ff129beb07","7f308ce1fe55bcd3faa3d2eacddec28406b7c131252b37bf9cb5e86328b67c91","7c5fdf0311206168ec63a9ddbd6d3354691fb64ca229ebc99c777cf8ad2626c6"],"paragraph_range_zero_based":[6168,6191],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p6168"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to inform the network about an MCG failure the UE has experienced i.e. MCG radio link failure. A UE in RRC_CONNECTED, for which AS security has been activated with SRB2 and at least one DRB or multicast MRB setup or, for IAB, SRB2, may initiate the fast MCG link recovery procedure in order to continue the RRC connection without re-establishment.","paragraph_zero_based":6192},{"literal_text_all_w_t_and_m_t":"5.7.3b.2Initiation","paragraph_zero_based":6193},{"literal_text_all_w_t_and_m_t":"A UE configured with split SRB1 or SRB3 initiates the procedure to report MCG failures when neither MCG nor SCG transmission is suspended, the SCG is not deactivated, t316 is configured, and when the following condition is met:","paragraph_zero_based":6194},{"literal_text_all_w_t_and_m_t":"1>upon detecting radio link failure of the MCG, in accordance with 5.3.10.3, while T316 is not running.","paragraph_zero_based":6195},{"literal_text_all_w_t_and_m_t":"Upon initiating the procedure, the UE shall:","paragraph_zero_based":6196},{"literal_text_all_w_t_and_m_t":"1>stop timer T310 for the PCell, if running;","paragraph_zero_based":6197},{"literal_text_all_w_t_and_m_t":"1>stop timer T312 for the PCell, if running;","paragraph_zero_based":6198},{"literal_text_all_w_t_and_m_t":"1>suspend MCG transmission for all SRBs, DRBs, multicast MRBs, except SRB0, and, if any, BH RLC channels;","paragraph_zero_based":6199},{"literal_text_all_w_t_and_m_t":"1>reset MCG MAC;","paragraph_zero_based":6200},{"literal_text_all_w_t_and_m_t":"1>stop conditional reconfiguration evaluation for CHO, if configured;","paragraph_zero_based":6201},{"literal_text_all_w_t_and_m_t":"1>stop conditional reconfiguration evaluation for CPC, if configured;","paragraph_zero_based":6202},{"literal_text_all_w_t_and_m_t":"1>initiate transmission of the MCGFailureInformation message in accordance with 5.7.3b.4.","paragraph_zero_based":6203},{"literal_text_all_w_t_and_m_t":"NOTE:The handling of any outstanding UL RRC messages during the initiation of the fast MCG link recovery is left to UE implementation.","paragraph_zero_based":6204},{"literal_text_all_w_t_and_m_t":"5.7.3b.3Failure type determination","paragraph_zero_based":6205},{"literal_text_all_w_t_and_m_t":"The UE shall set the MCG failure type as follows:","paragraph_zero_based":6206},{"literal_text_all_w_t_and_m_t":"1>if the UE initiates transmission of the MCGFailureInformation message due to T310 expiry:","paragraph_zero_based":6207},{"literal_text_all_w_t_and_m_t":"2>set the failureType as t310-Expiry;","paragraph_zero_based":6208},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the MCGFailureInformation message due to T312 expiry:","paragraph_zero_based":6209},{"literal_text_all_w_t_and_m_t":"2>set the failureType as t312-Expiry;","paragraph_zero_based":6210},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the MCGFailureInformation message to provide random access problem indication from MCG MAC:","paragraph_zero_based":6211},{"literal_text_all_w_t_and_m_t":"2>if the random access procedure was initiated for beam failure recovery:","paragraph_zero_based":6212},{"literal_text_all_w_t_and_m_t":"3>set the failureType as beamFailureRecoveryFailure;","paragraph_zero_based":6213},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":6214},{"literal_text_all_w_t_and_m_t":"3>set the failureType as randomAccessProblem;","paragraph_zero_based":6215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["c13462e2f195597fdffc02ec1c38fb2380960455e111ebf677bfa38be5d1fc15","8ddc9bee79643e31f5054560ddd5d8637b488ea2a4985f3cc45573916735a35d","a59be309ae162a13ea46e452b5aa583dcd187366600a1b14046c6e2ebc492284","6438d740c7f27dc9fdb488bfb7822935cf73a5f0e1fdd37592f6702249a329ee","272ee8069b526d538dfb510d33f4d690c1546be8820d1e27355ff2d37f17e591","94cdbd720790b4fcbba5e3e8f364d65f3f7ba20e3bf2be13e29d6ade43cfffdb","e9215d13545496bb1786228c942e01b125fb2f5d8145aa8c2790dbadced93f3b","f574c12def135f463f7255801ae9005d446cc8121573c2ccf52c20b932bb4482","26743913aef0f7d24695bf4cdabe476f326f9c29c8ff1a25cd5f650d25add90a","71b1729c7754a5a8cc2f3bbf3fd30d179db98092eb2bc2df6b1dbcab97ca8e75","08e2d85f6d043f0d859cd613b46ac648c4a80ee047dcd2ebc8022a85976c8fe5","d89d105c9e70d8fbcea3e0636d5219c776cba55fad081b341178571241167b1d","99f6d1c08ebfe5dffab317ec79130c18f466f27c1e68d2745b2f00d8832a5b8e","9912b261b2f38660240a32463ee40e827a55e258861345668f9402048af24f61","f789731d7413f02f4b4cd3d653aac8f9e2e3d8bb57ed62df072d9a0e85cfd451","e1675836c23decfae94bc400cde27605359289a6a37a5862f3cb9a99b151d96e","ab76ff2d7c226fe27d56f9acaff0d8eb8448b50a064d0c04bff1d175a1a2c080","bff4560d3fa35dbd52b700ff269d7e829876c6ffc03ac9ec10d592932025122d","e4b6e63b46d4088e542b100b696a1cf61a14924bfad7248af7439b543607f5b7","4654f554175dd5a6a5596259f06e50480cf6d9b86bccb2a809af3edcec22e7ed","b2b36b41214e5b4e2e41a041239d5654919f55a8ec8bc181f43a2a58bef1acf2","e7dd1099fe0d63da8cd7ee506183ee4e325dc652d938f8f45da6b343f1149ca2","877292c45fae391e641fc6cf30be733772c1d9d30e37a741cdfaff10ec91ea55","ad15f15216def1da31922509b1b5548524e13f522590ce945c9dd985c51e6814"],"paragraph_range_zero_based":[6192,6215],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p6192"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the MCGFailureInformation message to provide indication from MCG RLC that the maximum number of retransmissions has been reached:","paragraph_zero_based":6216},{"literal_text_all_w_t_and_m_t":"2>set the failureType as rlc-MaxNumRetx:","paragraph_zero_based":6217},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the MCGFailureInformation message due to consistent uplink LBT failures on the MCG:","paragraph_zero_based":6218},{"literal_text_all_w_t_and_m_t":"2>set the failureType as lbt-Failure;","paragraph_zero_based":6219},{"literal_text_all_w_t_and_m_t":"1>else if connected as an IAB-node and the MCGFailureInformation message is initiated due to the reception of a BH RLF indication on BAP entity from the MCG:","paragraph_zero_based":6220},{"literal_text_all_w_t_and_m_t":"2>set the failureType as bh-RLF.","paragraph_zero_based":6221},{"literal_text_all_w_t_and_m_t":"5.7.3b.4Actions related to transmission of MCGFailureInformation message","paragraph_zero_based":6222},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of the MCGFailureInformation message as follows:","paragraph_zero_based":6223},{"literal_text_all_w_t_and_m_t":"1>include and set failureType in accordance with 5.7.3b.3;","paragraph_zero_based":6224},{"literal_text_all_w_t_and_m_t":"1>for each MeasObjectNR configured by a measConfig associated with the MCG, and for which measurement results are available:","paragraph_zero_based":6225},{"literal_text_all_w_t_and_m_t":"2>include an entry in measResultFreqList;","paragraph_zero_based":6226},{"literal_text_all_w_t_and_m_t":"2>if there is a measId configured with the MeasObjectNR and a reportConfig which has rsType set to ssb:","paragraph_zero_based":6227},{"literal_text_all_w_t_and_m_t":"3>set ssbFrequency in measResultFreqList to the value indicated by ssbFrequency as included in the MeasObjectNR;","paragraph_zero_based":6228},{"literal_text_all_w_t_and_m_t":"2>if there is a measId configured with the MeasObjectNR and a reportConfig which has rsType set to csi-rs:","paragraph_zero_based":6229},{"literal_text_all_w_t_and_m_t":"3>set refFreqCSI-RS in measResultFreqList to the value indicated by refFreqCSI-RS as included in the associated measurement object;","paragraph_zero_based":6230},{"literal_text_all_w_t_and_m_t":"2>if a serving cell is associated with the MeasObjectNR:","paragraph_zero_based":6231},{"literal_text_all_w_t_and_m_t":"3>set measResultServingCell in measResultFreqList to include the available quantities of the concerned cell and in accordance with the performance requirements in TS 38.133 [14];","paragraph_zero_based":6232},{"literal_text_all_w_t_and_m_t":"2>set the measResultNeighCellList in measResultFreqList to include the best measured cells, ordered such that the best cell is listed first, and based on measurements collected up to the moment the UE detected the failure, and set its fields as follows;","paragraph_zero_based":6233},{"literal_text_all_w_t_and_m_t":"3>ordering the cells with sorting as follows:","paragraph_zero_based":6234},{"literal_text_all_w_t_and_m_t":"4>based on SS/PBCH block if SS/PBCH block measurement results are available and otherwise based on CSI-RS;","paragraph_zero_based":6235},{"literal_text_all_w_t_and_m_t":"4>using RSRP if RSRP measurement results are available, otherwise using RSRQ if RSRQ measurement results are available, otherwise using SINR;","paragraph_zero_based":6236},{"literal_text_all_w_t_and_m_t":"3>for each neighbour cell included:","paragraph_zero_based":6237},{"literal_text_all_w_t_and_m_t":"4>include the optional fields that are available.","paragraph_zero_based":6238},{"literal_text_all_w_t_and_m_t":"1>for each EUTRA frequency the UE is configured to measure by measConfig for which measurement results are available:","paragraph_zero_based":6239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["6433f6421f4f66d6079a3c79986a8cf3c44f7fadefaf53b11127e7a3aa1b4115","e0038a9e66349c2a4ec3f704288b3e25ae7f79359394cc112ae2b108c5a068bb","50fad3a7e3afac50912cf3a9501432e82e26b6be4d30797e6230ed30588e589b","ee6604e2f33c41044aa1bb597300f76b337bf35040da532490bd2cebd50d30b9","e45ea25be960acae9b3f384854b18284761394c134db67a3baf4bb44273b483d","7442bbb58571da1fa27aabb7e92571e9afae8968eede331513275cdb287eaa9e","d42b318f18312d28ecb33f3178e945cc200cc8932f038718f7f3dc4ec9abc430","0dfbb8765eecaffaa4fc7232d4cf7f80c3a9f63570b8877d92e6657ea3aa5d5f","22c28ff9393b7742955dc7c21b2365d34880f5539a77f81cf3c506531d203674","34ec778d1c2ee826138f8e9e95ef63bf3e0667f38c913cd127441e9794ea4661","2d208f515f71291d585a9437d0e06fc1fb6a018b65e89c1fb1c35315ad1b55d5","4ea8b452224cbeed723973f65945762fe75e48296eeb467742da178c938a37e7","956642612124014491aa1a579117b7ab691f9a17a83851fcb56ca3599b8583f5","6a05b309bedaa1d5aebcbc6b892995839e55e2122b7f5d97c6b9a13b9a843318","726db1d3fd538402231402582ebf898c6f3b917473ecb2c50090335822423664","1a797c682ba73fed650c1e455249b025f83f6fab38161695aea388be9575aa62","15d30720092d789f3cd09e4967b690b3dfcf7ce1cc6a1193a6f5c7a9d7532e8a","c5bd706e6a4134c434674743bbd0dcd7c76f3ea3d8233b45bdd75473dc81e468","9bcca3f35ff97ab0f5fd0e1dce895e939fbe66506fb6a1d2df773c021b334203","e5d689c3a9141b7863d2c669d047c171f13707983c8fc83ad75f6c5088c1e014","af16cbf1fca2b5740d6506cd7bd3efb23ece9a7afba86f5870dd45301fcf4114","d659786ecfa22071a22f9a4cd3a0f2d40b1a7d9d7acc27652b41cef1d7ae01ad","dd33380fe5edf465943a1e6d2374740d05e6d1bb4b8b591954ebd96d61033ded","2b039a0a2692fccfe9a53a0c5f121882dcc4fc0dc9120a4135236d88197795b0"],"paragraph_range_zero_based":[6216,6239],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p6216"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>set the measResultFreqListEUTRA to include the best measured cells, ordered such that the best cell is listed first using RSRP to order the cells if RSRP measurement results are available for cells on this frequency, otherwise using RSRQ to order the cells if RSRQ measurement results are available for cells on this frequency, otherwise using SINR to order the cells, based on measurements collected up to the moment the UE detected the failure, and for each cell that is included, include the optional fields that are available;","paragraph_zero_based":6240},{"literal_text_all_w_t_and_m_t":"1>for each UTRA-FDD frequency the UE is configured to measure by measConfig for which measurement results are available:","paragraph_zero_based":6241},{"literal_text_all_w_t_and_m_t":"2>set the measResultFreqListUTRA-FDD to include the best measured cells, ordered such that the best cell is listed first using RSCP to order the cells if RSCP measurement results are available for cells on this frequency, otherwise using EcN0 to order the cells, based on measurements collected up to the moment the UE detected the failure, and for each cell that is included, include the optional fields that are available;","paragraph_zero_based":6242},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":6243},{"literal_text_all_w_t_and_m_t":"1>if the UE is in NR-DC:","paragraph_zero_based":6244},{"literal_text_all_w_t_and_m_t":"2>include and set measResultSCG in accordance with 5.7.3.4;","paragraph_zero_based":6245},{"literal_text_all_w_t_and_m_t":"1>if the UE is in NE-DC:","paragraph_zero_based":6246},{"literal_text_all_w_t_and_m_t":"2>include and set measResultSCG-EUTRA in accordance with TS 36.331 [10] clause 5.6.13.5;","paragraph_zero_based":6247},{"literal_text_all_w_t_and_m_t":"NOTE 1:The measured quantities are filtered by the L3 filter as configured in the mobility measurement configuration. The measurements are based on the time domain measurement resource restriction, if configured. Exclude-listed cells are not required to be reported.","paragraph_zero_based":6248},{"literal_text_all_w_t_and_m_t":"NOTE 2:Field measResultSCG-Failure is used to report available results for NR frequencies the UE is configured to measure by SCG RRC signalling.","paragraph_zero_based":6249},{"literal_text_all_w_t_and_m_t":"NOTE 3:Field measResultSCG-EUTRA is used to report available results for E-UTRAN frequencies the UE is configured to measure by E-UTRA RRC signalling.","paragraph_zero_based":6250},{"literal_text_all_w_t_and_m_t":"1>if SRB1 is configured as split SRB and pdcp-Duplication is not configured:","paragraph_zero_based":6251},{"literal_text_all_w_t_and_m_t":"2>if the primaryPath for the PDCP entity of SRB1 refers to the MCG:","paragraph_zero_based":6252},{"literal_text_all_w_t_and_m_t":"3>set the primaryPath to refer to the SCG.","paragraph_zero_based":6253},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":6254},{"literal_text_all_w_t_and_m_t":"1>start timer T316;","paragraph_zero_based":6255},{"literal_text_all_w_t_and_m_t":"1>if SRB1 is configured as split SRB:","paragraph_zero_based":6256},{"literal_text_all_w_t_and_m_t":"2>submit the MCGFailureInformation message to lower layers for transmission via SRB1, upon which the procedure ends;","paragraph_zero_based":6257},{"literal_text_all_w_t_and_m_t":"1>else (i.e. SRB3 configured):","paragraph_zero_based":6258},{"literal_text_all_w_t_and_m_t":"2>submit the MCGFailureInformation message to lower layers for transmission embedded in NR RRC message ULInformationTransferMRDC via SRB3 as specified in 5.7.2a.3.","paragraph_zero_based":6259},{"literal_text_all_w_t_and_m_t":"5.7.3b.5T316 expiry","paragraph_zero_based":6260},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":6261},{"literal_text_all_w_t_and_m_t":"1>if T316 expires:","paragraph_zero_based":6262},{"literal_text_all_w_t_and_m_t":"2>initiate the connection re-establishment procedure as specified in 5.3.7.","paragraph_zero_based":6263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["381986a2ef5dfde7803efa760f15f4b799d9e873697ac94b7a283361d20e99b8","4635178664f83c909b0075c9000c3742dcdf4c52de45388f8cd2349fac3dafd7","d16e671863a937341bd00f60ce26f449c960f063e72826c4208fdddb743c4b25","e7bc8286a65d411d1c4be7a097f1142fcddd7d353b029f0a3c6c45771ba2e22a","2bac062f0cbb3a734ca9303ad6269110f8542496d9120b6fba6ad590f2151f65","09390fcc2bf30fe94b86ff34bfdb5ea3ef5a1adaaa632bfa79a31f3ab1301051","e55279a7c78c2359849a815a0c85b1fb79adfbd65da8f560a2d5317deb0ec206","73f769055d8a91eec8c548a52b39eeabb4efa97327163767847cee881cd85405","86ef2f539610ecda35ecff9bc1d265b1777acc36567c9a240eca79a730032c94","e5adf5bd1a8f03380afd1240137b00a0d1364637ba29b5469c7c462b5379d6b2","9fbc26c98bf617e8b0f14fdef01b8a3980055f071e9f416aec9741a56332bcad","1346331df254e6407dd4c1a6f4db5339c7e34880206aa03c5f99aa0bee3c71dd","9bb009ee1cf042c360e2d727272541d674d8666cb8cf127e260b60daf8eb5a3c","d412db4e2363571541ffbc5b815f43a90cef94dbb7b672be86d761c067d6ca55","48d8d3b84f6cca4d45a449d99697e5e46f5523ed14fb289d9c78bf7b7a0c2f55","bdd165cf9289ba402265e007068a83d138b80873f3cdd8076414b9fc808a30aa","83ea1fc38b760399c13f0a1fe905469c3379088fb1593a01878c3fd478186168","1437bbc34fd0acd0649a5e675792e1ffe8957cc9d4777dfe8fdb41e8e17842e0","13910512d006c9e1a99cc79a4b193011d17bcb0b4910688362d996ead412190d","4797811fe1dca7aa4ef836df7e1f7711190b059111923307c2918dfa95383bc0","5b2020634bb5408dd53b4abcb4e5b4c5ae972b1a1caefb1cb980bc90fae6e3d5","65472415082d4e61b177684d316259195a1681006d45659a9b56750ff763a96d","69a9a39ede6bf80d5333f78e777c20bedd1ee9accf74810cfda6d1a7363006b6","527dacb1225ee7537af4da6e93f7ac5d9f03680d39af57da8d2cd91c7b8facca"],"paragraph_range_zero_based":[6240,6263],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p6240"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.7.4UE Assistance Information","paragraph_zero_based":6264},{"literal_text_all_w_t_and_m_t":"5.7.4.1General","paragraph_zero_based":6265},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":6266},{"literal_text_all_w_t_and_m_t":"Figure 5.7.4.1-1: UE Assistance Information","paragraph_zero_based":6267},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is for the UE to inform the network of:","paragraph_zero_based":6268},{"literal_text_all_w_t_and_m_t":"-its delay budget report carrying desired increment/decrement in the connected mode DRX cycle length, or;","paragraph_zero_based":6269},{"literal_text_all_w_t_and_m_t":"-its overheating assistance information, or;","paragraph_zero_based":6270},{"literal_text_all_w_t_and_m_t":"-its IDC assistance information, or;","paragraph_zero_based":6271},{"literal_text_all_w_t_and_m_t":"-its preference on DRX parameters for power saving, or;","paragraph_zero_based":6272},{"literal_text_all_w_t_and_m_t":"-its preference on the maximum aggregated bandwidth for power saving, or;","paragraph_zero_based":6273},{"literal_text_all_w_t_and_m_t":"-its preference on the maximum number of secondary component carriers for power saving, or;","paragraph_zero_based":6274},{"literal_text_all_w_t_and_m_t":"-its preference on the maximum number of MIMO layers for power saving, or;","paragraph_zero_based":6275},{"literal_text_all_w_t_and_m_t":"-its preference on the minimum scheduling offset for cross-slot scheduling for power saving, or;","paragraph_zero_based":6276},{"literal_text_all_w_t_and_m_t":"-its preference on the RRC state, or;","paragraph_zero_based":6277},{"literal_text_all_w_t_and_m_t":"-configured grant assistance information for NR sidelink communication, or;","paragraph_zero_based":6278},{"literal_text_all_w_t_and_m_t":"-its preference in being provisioned with reference time information, or;","paragraph_zero_based":6279},{"literal_text_all_w_t_and_m_t":"-its preference for FR2 UL gap, or;","paragraph_zero_based":6280},{"literal_text_all_w_t_and_m_t":"-its preference to transition out of RRC_CONNECTED state for MUSIM operation, or;","paragraph_zero_based":6281},{"literal_text_all_w_t_and_m_t":"-its preference on the MUSIM gaps, or;","paragraph_zero_based":6282},{"literal_text_all_w_t_and_m_t":"-its relaxation state for RLM measurements, or;","paragraph_zero_based":6283},{"literal_text_all_w_t_and_m_t":"-its relaxation state for BFD measurements, or;","paragraph_zero_based":6284},{"literal_text_all_w_t_and_m_t":"-availability of data and/or signalling mapped to radio bearers which are not configured for SDT, or;","paragraph_zero_based":6285},{"literal_text_all_w_t_and_m_t":"-its preference for the SCG to be deactivated, or;","paragraph_zero_based":6286},{"literal_text_all_w_t_and_m_t":"-availability of uplink data to transmit for a DRB for which there is no MCG RLC bearer while the SCG is deactivated, or;","paragraph_zero_based":6287}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["dc7b67d0471e48911f45c0550447d9c605d41368eab327530f4bd95b2d5150a1","a874758f6ad81e911b1742e6ea8c0f0c0b1afa0c12f1f4990e19976227f73d8d","064bdaf22d1dd28958aae1139a30b479b4ccbd50843afd69272a2346794a1446","990526905874a2bc4a2e65474d775498de73e256299e83cfd49807d6acc4bed8","3c9347d49f9e3a6f733ad164e8cfcc8f5f19d9416c509b937d9fec87d9dff6f3","020404bc0c9d08c5bdeb2e7a2d6d8926400edfb8b1d3cf155039856c0bd7ed1d","fa3c918fa951b082671f5ca8aa59288e41953e71e2bedb3fdd657a6c1d5e94a0","18eb4c4a2f19cf2d6780d6cb2b2730f88198f91c5a48865da192adc786b548f4","0b7504a633e2c322d49751608f44bd7b26ded7b97e23cbad3e6f8203803dd826","240a06f03b34c0c0044b00edb24391516a33b0407e5372f418adea076da60b83","1596700e7f415ec97000ad6c1ba5f86b22b61dddd0d71f7119e19d31e3812ca5","9afba0b6da69edcf10047ed81dbbfc147bd3d82ac0e67d09f644a455d18f05ea","98eaba930e00fce8816b9c513fb12c5edd4262cb8c4414133d65dbd564b6edb0","1c12b6873dd1a8f2dca706336dd281ed07f5d6eb14c7c5e2ab1f70bd16851c71","c157b5413e2d7ffd2c8418eb69ff7e82a643ec641ff27a760cad4d07eb09f9b1","68780f492c62f45dce9f232c2940f610cc236536006015deedf764727bac8042","cca5909b5f35cf1bc0e79582d07ca3114a4684dfe820eb166d234330357a1e12","64d5c810188010a3b4ea610a84ef2c47a8bec13aa63702a4d03dbe21a0e7284f","1c38393bd6b23a6e559bd5e94d8e03775441121d53da3362586cf4dadbb0c09f","3ffe1183cec0e1cd9a3dc85a360ec7831a77b4b0d0cff8c31e121f245f5068c5","131966d36ad48f413665f31c8c90d5d546b97b1ffe3cd396c3c3fe03e0ea13bc","c7ec4807f46a95c3530d946ddf28ea86afebd0ce897210a32cafdb1d2b625c94","07744b058f4f5c8a28a5579a900cb4b3d240da7f64dcea5d8b8733bb45b6cf94","255f701165514c074dcca913365a7bd14ed0c3081f4b444da3f04f0edfab1444"],"paragraph_range_zero_based":[6264,6287],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p6264"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-change of its fulfilment status for RRM measurement relaxation criterion, or;","paragraph_zero_based":6288},{"literal_text_all_w_t_and_m_t":"-service link (specified in TS 38.300 [2]) propagation delay difference between serving cell and neighbour cell(s); or","paragraph_zero_based":6289},{"literal_text_all_w_t_and_m_t":"-availability of flight path information for Aerial UE operation.","paragraph_zero_based":6290},{"literal_text_all_w_t_and_m_t":"5.7.4.2Initiation","paragraph_zero_based":6291},{"literal_text_all_w_t_and_m_t":"A UE capable of providing delay budget report in RRC_CONNECTED may initiate the procedure in several cases, including upon being configured to provide delay budget report and upon change of delay budget preference.","paragraph_zero_based":6292},{"literal_text_all_w_t_and_m_t":"A UE capable of providing overheating assistance information in RRC_CONNECTED may initiate the procedure if it was configured to do so, upon detecting internal overheating, or upon detecting that it is no longer experiencing an overheating condition.","paragraph_zero_based":6293},{"literal_text_all_w_t_and_m_t":"A UE capable of providing IDC assistance information in RRC_CONNECTED may initiate the procedure if it was configured to do so, upon detecting IDC problem if the UE did not transmit an IDC assistance information since it was configured to provide IDC indications, or upon change of IDC problem information.","paragraph_zero_based":6294},{"literal_text_all_w_t_and_m_t":"A UE capable of providing its preference on DRX parameters of a cell group for power saving in RRC_CONNECTED may initiate the procedure in several cases, if it was configured to do so, including upon having a preference on DRX parameters and upon change of its preference on DRX parameters.","paragraph_zero_based":6295},{"literal_text_all_w_t_and_m_t":"A UE capable of providing its preference on the maximum aggregated bandwidth of a cell group for power saving in RRC_CONNECTED may initiate the procedure in several cases, if it was configured to do so, including upon having a maximum aggregated bandwidth preference and upon change of its maximum aggregated bandwidth preference.","paragraph_zero_based":6296},{"literal_text_all_w_t_and_m_t":"A UE capable of providing its preference on the maximum number of secondary component carriers of a cell group for power saving in RRC_CONNECTED may initiate the procedure in several cases, if it was configured to do so, including upon having a maximum number of secondary component carriers preference and upon change of its maximum number of secondary component carriers preference.","paragraph_zero_based":6297},{"literal_text_all_w_t_and_m_t":"A UE capable of providing its preference on the maximum number of MIMO layers of a cell group for power saving in RRC_CONNECTED may initiate the procedure in several cases, if it was configured to do so, including upon having a maximum number of MIMO layers preference and upon change of its maximum number of MIMO layers preference.","paragraph_zero_based":6298},{"literal_text_all_w_t_and_m_t":"A UE capable of providing its preference on the minimum scheduling offset for cross-slot scheduling of a cell group for power saving in RRC_CONNECTED may initiate the procedure in several cases, if it was configured to do so, including upon having a minimum scheduling offset preference and upon change of its minimum scheduling offset preference.","paragraph_zero_based":6299},{"literal_text_all_w_t_and_m_t":"A UE capable of providing assistance information to transition out of RRC_CONNECTED state may initiate the procedure if it was configured to do so, upon determining that it prefers to transition out of RRC_CONNECTED state, or upon change of its preferred RRC state.","paragraph_zero_based":6300},{"literal_text_all_w_t_and_m_t":"A UE capable of providing configured grant assistance information for NR sidelink communication in RRC_CONNECTED may initiate the procedure in several cases, including upon being configured to provide traffic pattern information and upon change of traffic patterns.","paragraph_zero_based":6301},{"literal_text_all_w_t_and_m_t":"A UE capable of providing an indication of its preference in being provisioned with reference time information may initiate the procedure upon being configured to provide this indication, or if it was configured to provide this indication and upon change of its preference.","paragraph_zero_based":6302},{"literal_text_all_w_t_and_m_t":"A UE capable of providing an indication of its preference in FR2 UL gap may initiate the procedure if it was configured to do so, upon detecting the need of FR2 UL gap activation/deactivation.","paragraph_zero_based":6303},{"literal_text_all_w_t_and_m_t":"A UE capable of providing MUSIM assistance information for gap preference may initiate the procedure if it was configured to do so, upon determining it needs the gaps, or upon change of the gap preference information.","paragraph_zero_based":6304},{"literal_text_all_w_t_and_m_t":"A UE capable of providing MUSIM assistance information for leave indication may initiate the procedure if it was configured to do so upon determining that it needs to leave RRC_CONNECTED state.","paragraph_zero_based":6305},{"literal_text_all_w_t_and_m_t":"A UE capable of relaxing its RLM measurements of a cell group in RRC_CONNECTED state shall initiate the procedure for providing an indication of its relaxation state for RLM measurements upon being configured to do so, and upon change of its relaxation state for RLM measurements in RRC_CONNECTED state.","paragraph_zero_based":6306},{"literal_text_all_w_t_and_m_t":"A UE capable of relaxing its BFD measurements in serving cells of a cell group in RRC_CONNECTED shall initiate the procedure for providing an indication of its relaxation state for BFD measurements upon being configured to do so, and upon change of its relaxation state for BFD measurements in RRC_CONNECTED state.","paragraph_zero_based":6307},{"literal_text_all_w_t_and_m_t":"A UE capable of SDT initiates this procedure when data and/or signalling mapped to radio bearers that are not configured for SDT becomes available during SDT (i.e. while SDT procedure is ongoing).","paragraph_zero_based":6308},{"literal_text_all_w_t_and_m_t":"A UE capable of providing its preference for SCG deactivation may initiate the procedure if it was configured to do so, upon determining that it prefers or does no more prefer the SCG to be deactivated.","paragraph_zero_based":6309},{"literal_text_all_w_t_and_m_t":"A UE that has uplink data to transmit for a DRB for which there is no MCG RLC bearer while the SCG is deactivated shall initiate the procedure.","paragraph_zero_based":6310},{"literal_text_all_w_t_and_m_t":"A UE capable of providing an indication of fulfilment of the RRM measurement relaxation criterion in connected mode may initiate the procedure if it was configured to do so, upon change of its fulfilment status for RRM measurement relaxation criterion for connected mode.","paragraph_zero_based":6311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["412d3705d3de3fa920df000d16c6a7c4defbb4d1be963bc51cb5d48c110eaea1","cc0f5f4441d7381dfd1a0a9113655eca95b5c5d3a4c8a4bc71b6d13b24daafc9","3428eb0013db0b3a14b8d72a1e0143a5421babf747a5dc800a3397c6ba4e848a","4774c0973ce85c54b94a4d168f3ab4fa9261066e74cb92390f603cc23e07467a","c791b7556eaa625568f0a83bc894abb7d29214080f2c28de367b5251a84a585b","876a8fd9656e3739837a781e655bc044d86fd72acec97a1ef36f7cc597f96041","5f7d4783a115fc476a94b4efcae89ee664ff4f766a9e7295233bbe084d59b257","dc5c8cf389d27df6b5a8fa50042d5be756ea0cc3b0220743a3ef20cb552ff6b0","905c8c5e53715793356d0d376b17e85b15ac17e107e5f7eb5204e57bbc3810c0","1e6e4c5738bf88348d9148ef97b1229f4963cafd125dc1f83dfb694ba285fec2","da48a56521a7ee7ec8bd2aaf0a0acfc615033edade8261ea6ae3d94e48125b6b","d957a92e157c695db120811c84d37a119a9e2423f2c6c7278f4593e80269fe98","b39f1a72da8cbc8b364a7624413c8895b2cc3b23b4620ed416dc0169e16facf1","1524dfb72200e4f7894423a5b511a8ed635d8181804bee1f9e22aca1fc0583df","e2c5260b778867189b3deea0f0f25b47a5e6e8b63ca669627ff63c49a4d27058","c14cc32ce5bd0bd2ec8bd7b52d2ce5aede895869b29ded177c84e6b966a616fc","1ab48c0d7cc8858c112aa5c7b073d07e608b2286dade78e2d028fdd095e9901d","da48edbe1ef268ac9ad8f9ad8eaec0d4fd3fc854d0d7aabb9c5a3c95fc73e975","691613b8dd457a9eceac58d0e6e358483aa0a97f2e14f7ebaf09bafaf6a9334d","5667e0c2c38e41eb249f5670242724c02576cd76ef168462688756e2e00da7f2","b581e585c2671ea7271033ee7214a10407574a702f1fba81acfbb4d37789faf0","5f49b8c30752bb59ae60a435439159e2178dcf7448e1151b593faff8fc039619","3d53e004f84373a71fa228f3a2dcf579fd63ed59b9d02c66100487f7e8b3c60a","5417f81bf52ebf63c2abec6a8f7f68ba6d6ea088e94aa9ab77a5885ae8f5783e"],"paragraph_range_zero_based":[6288,6311],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p6288"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"A UE capable of providing service link propagation delay difference between serving cell and neighbour cell(s) shall initiate the procedure upon being configured to do so, and upon determining that service link propagation delay difference between serving cell and a neighbour cell has changed more than threshPropDelayDiff compared with the last reported value.","paragraph_zero_based":6312},{"literal_text_all_w_t_and_m_t":"A UE capable of indicating the availability of flight path information may initiate the procedure, if it was configured to do so, upon determining that an initial or updated flight path information is available.","paragraph_zero_based":6313},{"literal_text_all_w_t_and_m_t":"Upon initiating the procedure, the UE shall:","paragraph_zero_based":6314},{"literal_text_all_w_t_and_m_t":"1>if configured to provide delay budget report:","paragraph_zero_based":6315},{"literal_text_all_w_t_and_m_t":"2>if the UE did not transmit a UEAssistanceInformation message with delayBudgetReport since it was configured to provide delay budget report; or","paragraph_zero_based":6316},{"literal_text_all_w_t_and_m_t":"2>if the current delay budget is different from the one indicated in the last transmission of the UEAssistanceInformation message including delayBudgetReport and timer T342 is not running:","paragraph_zero_based":6317},{"literal_text_all_w_t_and_m_t":"3>start or restart timer T342 with the timer value set to the delayBudgetReportingProhibitTimer;","paragraph_zero_based":6318},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide a delay budget report;","paragraph_zero_based":6319},{"literal_text_all_w_t_and_m_t":"1>if configured to provide overheating assistance information:","paragraph_zero_based":6320},{"literal_text_all_w_t_and_m_t":"2>if the overheating condition has been detected and T345 is not running; or","paragraph_zero_based":6321},{"literal_text_all_w_t_and_m_t":"2>if the current overheating assistance information is different from the one indicated in the last transmission of the UEAssistanceInformation message including overheatingAssistance and timer T345 is not running:","paragraph_zero_based":6322},{"literal_text_all_w_t_and_m_t":"3>start timer T345 with the timer value set to the overheatingIndicationProhibitTimer;","paragraph_zero_based":6323},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide overheating assistance information;","paragraph_zero_based":6324},{"literal_text_all_w_t_and_m_t":"1>if configured to provide IDC assistance information:","paragraph_zero_based":6325},{"literal_text_all_w_t_and_m_t":"2>if the UE did not transmit a UEAssistanceInformation message with idc-Assistance since it was configured to provide IDC assistance information:","paragraph_zero_based":6326},{"literal_text_all_w_t_and_m_t":"3>if on one or more frequencies included in candidateServingFreqListNR, the UE is experiencing IDC problems that it cannot solve by itself; or","paragraph_zero_based":6327},{"literal_text_all_w_t_and_m_t":"3>if on one or more supported UL CA combination comprising of carrier frequencies included in candidateServingFreqListNR, the UE is experiencing IDC problems that it cannot solve by itself:","paragraph_zero_based":6328},{"literal_text_all_w_t_and_m_t":"4>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide IDC assistance information;","paragraph_zero_based":6329},{"literal_text_all_w_t_and_m_t":"2>else if the current IDC assistance information is different from the one indicated in the last transmission of the UEAssistanceInformation message:","paragraph_zero_based":6330},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide IDC assistance information;","paragraph_zero_based":6331},{"literal_text_all_w_t_and_m_t":"NOTE 1:The term \"IDC problems\" refers to interference issues applicable across several subframes/slots where not necessarily all the subframes/slots are affected.","paragraph_zero_based":6332},{"literal_text_all_w_t_and_m_t":"NOTE 2:For the frequencies on which a serving cell or serving cells is configured that is activated, IDC problems consist of interference issues that the UE cannot solve by itself, during either active data exchange or upcoming data activity which is expected in up to a few hundred milliseconds.For frequencies on which a SCell or SCells is configured that is deactivated, reporting IDC problems indicates an anticipation that the activation of the SCell or SCells would result in interference issues that the UE would not be able to solve by itself.For a non-serving frequency, reporting IDC problems indicates an anticipation that if the non-serving frequency or frequencies became a serving frequency or serving frequencies then this would result in interference issues that the UE would not be able to solve by itself.","paragraph_zero_based":6333},{"literal_text_all_w_t_and_m_t":"1>if configured to provide its preference on DRX parameters of a cell group for power saving:","paragraph_zero_based":6334},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on DRX parameters of the cell group and the UE did not transmit a UEAssistanceInformation message with drx-Preference for the cell group since it was configured to provide its preference on DRX parameters of the cell group for power saving; or","paragraph_zero_based":6335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["f21b3ba1fe22e470fed9d3595c33d2f6704f52e0116e3512f73e10a5a67b3d81","9a8c75e2b8f8445376f85e75a99f7ebc128161e8f7a6f125eab1b042f878b5b9","dfbbfee0b55c7772735b4cc4036c865674f745f5bd107d25bb00c28548c02963","e458a9b066432c0bf6d94e4ced6c300291ceba55f6da2bdce7945811749bfe34","b316469411e5e5e7eb7d0c51cfa0a704d5aefdbba2239b5e7695276c457ad204","5c03421e8a8d7ff44a84716197501f9aaa4001c91a5bf312ab401de60a91ada0","c86752dab3f718cc93fbd9d0344fecfa14eb8670cd9ce48aeb34501fa61dbfdb","5fa16e16309d012c933618aae8726cd36aaa27b8e3bf1203c44fa87671e0ed4e","1de3ac55b01226fb836c16d9bc9972dc9e78062561ee9fade7d9ebeb191a48c3","5e9dfc43bc5546ca10bd8435c973989a87a2eab702d7634a169f33c658c08a7e","499bfd3fb8adddd65997e933daeb5b18f763e6e4053a9327bf65fad5ad3dcfff","d0a0fdf90fce3bc98448b04d4ec078a20b548b0a3df91da026897aafe40b3d45","67a5e878f5153ab81651bef8469a8db768e1771deb03f21d250d1cae383187c4","ab4745a34689ba665a266eed360b4588a8341c49bf422a680a9b6931271ee560","81a6c3408d16cd9ed57fcce809666db032b5a56c2b23ee83ba82a7e09f25301a","a369d079a5915484f063a349467646c92932170764bced0ac018854df46627f0","3685a35d0b9258621b5e5cb9838487412214485a22294d6611015a0c057c121a","59903192a6bc122e240cc067cbda839c9d1eaa514968ba312bf04f9f7ca0e3c9","36537640d5f05e38e2608551215b9926956b85ac932b523a592ec7dc911cc8c3","0693c1b0460a1c207cb679499bff8a25bbe5efefe2601ea3a092878a32ec7fc9","cdb37512035da32c9302c2b997891ef3b2ce58d4456f6f82efdb2e6151c3d8d1","a5048e1af7b91c33dd57571be2b2119bd7ab0c8860d25956f81735698deb3bae","436a009e39010a8d325374cbd1d5f063799ca150a077fb479cc0137572652ba8","d4db1de58a96a705c6ff69ccf70f749ad9b0a6deda3351ff3afb72eef104cc27"],"paragraph_range_zero_based":[6312,6335],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p6312"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if the current drx-Preference information for the cell group is different from the one indicated in the last transmission of the UEAssistanceInformation message including drx-Preference for the cell group and timer T346a associated with the cell group is not running:","paragraph_zero_based":6336},{"literal_text_all_w_t_and_m_t":"3>start the timer T346a with the timer value set to the drx-PreferenceProhibitTimer of the cell group;","paragraph_zero_based":6337},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide the current drx-Preference;","paragraph_zero_based":6338},{"literal_text_all_w_t_and_m_t":"1>if configured to provide its preference on the maximum aggregated bandwidth of a cell group for power saving:","paragraph_zero_based":6339},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on the maximum aggregated bandwidth of the cell group and the UE did not transmit a UEAssistanceInformation message with maxBW-Preference and/or maxBW-PreferenceFR2-2 for the cell group since it was configured to provide its preference on the maximum aggregated bandwidth of the cell group for power saving; or","paragraph_zero_based":6340},{"literal_text_all_w_t_and_m_t":"2>if the current maxBW-Preference information for the cell group is different from the one indicated in the last transmission of the UEAssistanceInformation message including maxBW-Preference and/or maxBW-PreferenceFR2-2for the cell group and timer T346b associated with the cell group is not running:","paragraph_zero_based":6341},{"literal_text_all_w_t_and_m_t":"3>start the timer T346b with the timer value set to the maxBW-PreferenceProhibitTimer of the cell group;","paragraph_zero_based":6342},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide the current maxBW-Preference and/or maxBW-PreferenceFR2-2;","paragraph_zero_based":6343},{"literal_text_all_w_t_and_m_t":"1>if configured to provide its preference on the maximum number of secondary component carriers of a cell group for power saving:","paragraph_zero_based":6344},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on the maximum number of secondary component carriers of the cell group and the UE did not transmit a UEAssistanceInformation message with maxCC-Preference for the cell group since it was configured to provide its preference on the maximum number of secondary component carriers of the cell group for power saving; or","paragraph_zero_based":6345},{"literal_text_all_w_t_and_m_t":"2>if the current maxCC-Preference information for the cell group is different from the one indicated in the last transmission of the UEAssistanceInformation message including maxCC-Preference for the cell group and timer T346c associated with the cell group is not running:","paragraph_zero_based":6346},{"literal_text_all_w_t_and_m_t":"3>start the timer T346c with the timer value set to the maxCC-PreferenceProhibitTimer of the cell group;","paragraph_zero_based":6347},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide the current maxCC-Preference;","paragraph_zero_based":6348},{"literal_text_all_w_t_and_m_t":"1>if configured to provide its preference on the maximum number of MIMO layers of a cell group for power saving:","paragraph_zero_based":6349},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on the maximum number of MIMO layers of the cell group and the UE did not transmit a UEAssistanceInformation message with maxMIMO-LayerPreference and/or maxMIMO-LayerPreferenceFR2-2 for the cell group since it was configured to provide its preference on the maximum number of MIMO layers of the cell group for power saving; or","paragraph_zero_based":6350},{"literal_text_all_w_t_and_m_t":"2>if the current maxMIMO-LayerPreference information for the cell group is different from the one indicated in the last transmission of the UEAssistanceInformation message including maxMIMO-LayerPreference and/or maxMIMO-LayerPreferenceFR2-2 for the cell group and timer T346d associated with the cell group is not running:","paragraph_zero_based":6351},{"literal_text_all_w_t_and_m_t":"3>start the timer T346d with the timer value set to the maxMIMO-LayerPreferenceProhibitTimer of the cell group;","paragraph_zero_based":6352},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide the current maxMIMO-LayerPreference and/or maxMIMO-LayerPreferenceFR2-2;","paragraph_zero_based":6353},{"literal_text_all_w_t_and_m_t":"1>if configured to provide its preference on the minimum scheduling offset for cross-slot scheduling of a cell group for power saving:","paragraph_zero_based":6354},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on the minimum scheduling offset for cross-slot scheduling of the cell group and the UE did not transmit a UEAssistanceInformation message with minSchedulingOffsetPreference and/or minSchedulingOffsetPreferenceExt for the cell group since it was configured to provide its preference on the minimum scheduling offset for cross-slot scheduling of the cell group for power saving; or","paragraph_zero_based":6355},{"literal_text_all_w_t_and_m_t":"2>if the current minSchedulingOffsetPreference and/or minSchedulingOffsetPreferenceExt information for the cell group is different from the one indicated in the last transmission of the UEAssistanceInformation message including minSchedulingOffsetPreference and/or minSchedulingOffsetPreferenceExt for the cell group and timer T346e associated with the cell group is not running:","paragraph_zero_based":6356},{"literal_text_all_w_t_and_m_t":"3>start the timer T346e with the timer value set to the minSchedulingOffsetPreferenceProhibitTimer of the cell group;","paragraph_zero_based":6357},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide the current minSchedulingOffsetPreference and/or minSchedulingOffsetPreferenceExt;","paragraph_zero_based":6358},{"literal_text_all_w_t_and_m_t":"1>if configured to provide its release preference and timer T346f is not running:","paragraph_zero_based":6359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["3a054773fb54d60d83bedd6995c6b18b16f4ce6a0e951fad7e2daeb70e3ffaf6","f956f339eebd5120cf5d8c48730af077a986d42e97d207056f70285d57301923","68a73b2129f8d4a298b715fb6274e0aa0f3b279d553c6bccdd22af45ec0d01cb","caf8548039d3aa97c0278e0e3d8d0a6e7914482df29b1eee55846dc3fb588bd7","cb6ba967a79283bdb406d721fab114810fb94891a527057821e874c227afd379","948a63eba01633996627a3575a9b353469afe63ff403dd510de2a069d8c104c6","b6245b8333d05aa62b7c8310ef1a4f037e5391fabe36c1e351cf4beb0de2e163","2db02c57cd2c9f678cfc601a5d5d4690e2284749dc2cb4ffadd3e88cafdee4ed","561d04297171910d62380dbf965aeb4b13d7cc20bd344ff2044eb9f846a19cd5","733d2fd56d37393d558c36c77ef902ad974da6d5c6ff5363b5e7d06801bd1a73","1c62d07465e6570acb802e0940510e4e0ff9f67a833cfae84ce475f858566d93","bc487d4e4ae69c8488c878cfd230937a578ac473a8362e17d80580e96ace5c82","d416212011f10956e3bc8bf994c1396bd573cd8b2cdff62f6f084170c6cf5a2f","2c283631a452f1e0cfd50e9406abd3618bd20bf2172909e0aca87ac320a18f1b","6e5b2e18701649d8ed928468585f3d30c0bc42ea32cfef2f527a28348ff789c8","b28cd4032ff8dad39ef4defb4882398ed14335210f47d5781733516733f259eb","bc7dfe162c00847d147c7794b37798b4b669320853026c2ec29f08a4ac40aa97","08dcb936e0bf3002f9866b8afec9a01dfe45efd347d110ca786415699c9b09c9","9c8d5f47c6842e6098e9dc66e20f507211935cc12d6ff254052fa6e154af4672","7217e9e328fd7799f080da2424d0a60d02edd83919e3fd6bb3350f28ddda0e7c","c279d326a0dfdfb275235785bf2f083cbe23c3958a1940c71f7c589abe6e2472","df52829e713526b9bc652c09c70b2c1b60dd8636efd6d631d1bb16ec91fbab30","e495ef9314268281c5544a19882c1e034e9a810084b632a6b261769fc412db86","e7b89c9a00f8edd77f55382aeb6709d4add1e5e865a7dd5ef03d62f441e83b4d"],"paragraph_range_zero_based":[6336,6359],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p6336"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if the UE determines that it would prefer to transition out of RRC_CONNECTED state; or","paragraph_zero_based":6360},{"literal_text_all_w_t_and_m_t":"2>if the UE is configured with connectedReporting and the UE determines that it would prefer to revert an earlier indication to transition out of RRC_CONNECTED state:","paragraph_zero_based":6361},{"literal_text_all_w_t_and_m_t":"3>start timer T346f with the timer value set to the releasePreferenceProhibitTimer;","paragraph_zero_based":6362},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide the release preference;","paragraph_zero_based":6363},{"literal_text_all_w_t_and_m_t":"1>if configured to provide configured grant assistance information for NR sidelink communication:","paragraph_zero_based":6364},{"literal_text_all_w_t_and_m_t":"2>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide configured grant assistance information for NR sidelink communication;","paragraph_zero_based":6365},{"literal_text_all_w_t_and_m_t":"1>if configured to provide preference in being provisioned with reference time information:","paragraph_zero_based":6366},{"literal_text_all_w_t_and_m_t":"2>if the UE did not transmit a UEAssistanceInformation message with referenceTimeInfoPreference since it was configured to provide preference; or","paragraph_zero_based":6367},{"literal_text_all_w_t_and_m_t":"2>if the UE's preference changed from the last time UE initiated transmission of the UEAssistanceInformation message including referenceTimeInfoPreference:","paragraph_zero_based":6368},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide preference in being provisioned with reference time information.","paragraph_zero_based":6369},{"literal_text_all_w_t_and_m_t":"1>if configured to provide its preference on FR2 UL gap:","paragraph_zero_based":6370},{"literal_text_all_w_t_and_m_t":"2>if the UE did not transmit a UEAssistanceInformation message with ul-GapFR2-Preference since it was configured to provide its preference on FR2 UL gap information:","paragraph_zero_based":6371},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference on FR2 UL gap activation/deactivation:","paragraph_zero_based":6372},{"literal_text_all_w_t_and_m_t":"4>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide FR2 UL gap preference;","paragraph_zero_based":6373},{"literal_text_all_w_t_and_m_t":"2>else if the current FR2 UL gap preference is different from the one indicated in the last transmission of the UEAssistanceInformation message:","paragraph_zero_based":6374},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide FR2 UL gap preference.","paragraph_zero_based":6375},{"literal_text_all_w_t_and_m_t":"1>if configured to provide MUSIM assistance information for leaving RRC_CONNECTED:","paragraph_zero_based":6376},{"literal_text_all_w_t_and_m_t":"2>if the UE needs to leave RRC_CONNECTED state and the timer T346g is not running:","paragraph_zero_based":6377},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide MUSIM assistance information for leaving RRC_CONNECTED;","paragraph_zero_based":6378},{"literal_text_all_w_t_and_m_t":"3>start the timer T346g with the timer value set to the musim-LeaveWithoutResponseTimer;","paragraph_zero_based":6379},{"literal_text_all_w_t_and_m_t":"1>if configured to provide MUSIM assistance information for gap preference:","paragraph_zero_based":6380},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on the MUSIM gap(s) and the UE did not transmit a UEAssistanceInformation message with musim-GapPreferenceList since it was configured to provide MUSIM assistance information for gap preference; or","paragraph_zero_based":6381},{"literal_text_all_w_t_and_m_t":"2>if the current musim-GapPreferenceList is different from the one indicated in the last transmission of the UEAssistanceInformation message including musim-GapPreferenceList and the timer T346h is not running:","paragraph_zero_based":6382},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide the current musim-GapPreferenceList;","paragraph_zero_based":6383}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["c362f4ab8a2e8fb921afebbc84c4ef5f1778999bf3d8477338fb2e121ec381d9","60b6fd34940559cb0e7dff80a1435913404289ddd9ff2d7122b9d317c5a827db","46a24d905f6511ee13c1a5c1e2cbae1c34397d34a049117413048df166611fba","654c9107bad590c8c077ee5a776082b94324452526ecc80bda6102ccc7bf77a3","e34803235e7ee6697eae83232e6627d0b51d235db638d5dd3bb9e4eed7c018c0","ee0c89d5c16b6e62f237f8a89f7da8ad24487ef2f1206a232b5a97dcf32f89cc","c87b8f2d08a1da3a7c46775953c176e16910075498464463284086de4e392b0a","d1f7dd2bbe349bccfb30d70f0fc713e2cc87ad58f5dab5730e7f6788699072ca","62d525ac041752bbcc8bac1f9fa2177ec14e2d482611786f90644cad027de5bd","a57601d22f68a0e1744e226c7965ea4bda485ce6f464249423cbc40efbff910f","a45358b7f14b2295d325b3a7f49b6f4982d909a6c7c3b41c8ae36e72f3222957","4639f81e4f4e337a0a7ed33be850c328ee2f3a19b936807cd2ab1a94522044aa","5a515485dd99f54be0c369d73d79635c49934e890d48c5e55ae3d7e1f0d36919","ccbc16919523a1dc2604940aa34b266ac51f07f7fc0d9a757bc75796adffa475","685de362c5c711aa43acd0b6846429a3e80176b1bd132fbbc89ba561ae12228d","c7be16cf12d5fb6ab3574c8381c8f9f91f5204f3a3a2a879bdc583eaf27fec26","16eee7c5ba678cf258439c017e446c2f3b252adf13cb522bead73d94880030dd","cac220dec31c5f159d437880fa14fb39081fd1df9f7e0035d675f557b060da6d","f804eb8549ab37dd7046e69c3261fb97e360e4f4b2b4b9baa3b707b4738ba616","43be8ddc22088271a15c8e0e2adf9b56894c11adf13629fb063a12eec5a617d3","84600e33f09bfbf8d8730deff6d3488cf1c207f052d2b7e17f9008d79283446f","51ac4ffabfde2170c04663654dd5501f169c0904e7968af7fda2ac05d6b6e392","22bbaffd8c229d5cda82d0a9f420ad99a7ff2c7bc57e03d72bd1e21d018bc71d","5b21fc79e83e0eea0ae72d18128bf47643ec057769b8409fada1def294510f14"],"paragraph_range_zero_based":[6360,6383],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p6360"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>start or restart the timer T346h with the timer value set to the musim-GapProhibitTimer.","paragraph_zero_based":6384},{"literal_text_all_w_t_and_m_t":"NOTE 3:The UE does not need to initiate transmission of the UEAssistanceInformation message if the difference between the current musim-GapPreferenceList and the last transmission of the UEAssistanceInformation message including musim-GapPreferenceList is only due to removal of an ended aperiodic gap.","paragraph_zero_based":6385},{"literal_text_all_w_t_and_m_t":"1>if configured to provide the relaxation state of RLM measurements of a cell group and RLM measurement of the cell group is not stopped:","paragraph_zero_based":6386},{"literal_text_all_w_t_and_m_t":"2>if the UE did not transmit a UEAssistanceInformation message with rlm-MeasRelaxationState since it was configured to provide the relaxation state of RLM measurements for the cell group; or","paragraph_zero_based":6387},{"literal_text_all_w_t_and_m_t":"2>if the relaxation state of RLM measurements for the cell group is currently different from the relaxation state reported in the last transmission of the UEAssistanceInformation message including rlm-MeasRelaxationState of the cell group and timer T346j associated with the cell group is not running:","paragraph_zero_based":6388},{"literal_text_all_w_t_and_m_t":"3>start timer T346j with the timer value set to the rlm-RelaxtionReportingProhibitTimer;","paragraph_zero_based":6389},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide the relaxation state of RLM measurements of the cell group;","paragraph_zero_based":6390},{"literal_text_all_w_t_and_m_t":"1>if configured to provide the relaxation state of BFD measurements of serving cells of a cell group and BFD measurement of the cell group is not stopped:","paragraph_zero_based":6391},{"literal_text_all_w_t_and_m_t":"2>if the UE did not transmit a UEAssistanceInformation message with bfd-MeasRelaxationState since it was configured to provide the relaxation state of BFD measurements for the cell group; or","paragraph_zero_based":6392},{"literal_text_all_w_t_and_m_t":"2>if the relaxation state of BFD measurements in any serving cell of the cell group is currently different from the relaxation state reported in the last transmission of the UEAssistanceInformation message including bfd-MeasRelaxationState of the cell group and timer T346k associated with the cell group is not running:","paragraph_zero_based":6393},{"literal_text_all_w_t_and_m_t":"3>start timer T346k with the timer value set to the bfd-RelaxtionReportingProhibitTimer;","paragraph_zero_based":6394},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide the relaxation state of BFD measurements of serving cells of the cell group.","paragraph_zero_based":6395},{"literal_text_all_w_t_and_m_t":"1>if data and/or signalling mapped to radio bearers not configured for SDT becomes available during SDT (i.e. while SDT procedure is ongoing):","paragraph_zero_based":6396},{"literal_text_all_w_t_and_m_t":"2>if the UE did not transmit a UEAssistanceInformation message with nonSDT-DataIndication since the initiation of the current resume procedure for SDT:","paragraph_zero_based":6397},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide nonSDT-DataIndication.","paragraph_zero_based":6398},{"literal_text_all_w_t_and_m_t":"1>if configured to provide its preference for SCG deactivation and timer T346i is not running;","paragraph_zero_based":6399},{"literal_text_all_w_t_and_m_t":"2>if the UE prefers the SCG to be deactivated and did not transmit a UEAssistanceInformation message with scg-DeactivationPreference since it was configured to provide its SCG deactivation preference; or","paragraph_zero_based":6400},{"literal_text_all_w_t_and_m_t":"2>if the UE preference for SCG deactivation is different from the last indicated scg-DeactivationPreference:","paragraph_zero_based":6401},{"literal_text_all_w_t_and_m_t":"3>start timer T346i with the timer value set to the scg-DeactivationPreferenceProhibitTimer;","paragraph_zero_based":6402},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide the UE preference for SCG deactivation;","paragraph_zero_based":6403},{"literal_text_all_w_t_and_m_t":"1>if the SCG is deactivated, and,","paragraph_zero_based":6404},{"literal_text_all_w_t_and_m_t":"1>the UE has uplink data to send for an SCG RLC entity while the UE previously did not have any uplink data to send for any SCG RLC entity:","paragraph_zero_based":6405},{"literal_text_all_w_t_and_m_t":"2>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to indicate that the UE has uplink data to send for a DRB whose DRB-Identity is not included in any RLC-BearerConfig in the CellGroupConfig associated with the MCG.","paragraph_zero_based":6406},{"literal_text_all_w_t_and_m_t":"1>if configured to send indications of RRM measurement relaxation criterion fulfilment:","paragraph_zero_based":6407}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["3a40b4de94c17e44b8e56982e838e2ce02faf29ff2630d85fed066e1358820ed","10bcd45a6216e77322c15c51021720b5463c91b4a5b071cba64f7c343431d2d5","37b14b600ffe9279408e68aebd77dde3da5b777ddffb8fb3f3557c41b4f571b1","33f55403155e9418584a8f72bb4819262a50dcfcfcf28a6232798bd5cd4addb0","aae173f65fd68d087248adde6d6be305f8db6e71af62a8a51b1f9563dd96880a","2fd0521ad677c3e58a28fa4ea8c70f70cef8362f6b95de3a94107c79fd0e6717","f26ded9e2d1ce6c19c877ed41e6ee771adcc3ce9813a1f8a8555b494109ab8f3","4743477f4d3ba17a5494b08fe969e468b64fd8e33e2e4e4f4e06a24eec9b9dd8","cd8ae024f88ddfb4f5afab4c6d9b7b4789c424835636e54dfed8e32648707cb5","5a09900e386e67f6fe38e28ffd09935375adc7d76f70605f42c33b6484a055c3","cf5dfa468ddd092a75a6fd025b691a4c4c0c9d10422e1b43834cc33a6d5ca1bc","eed4144e5c4cc411a56c95f0e6bfc484602c9429db50457fb6e3e456f80096dd","97c56c8c5d42acea71c3f55e8bde157f0d89e189cbf397a2cf15df38dcd95c48","33fa4d3667e6365931e931de21c3d35b4470d7074d1f954c10650a8d0b5a80c0","83ad44bce2ab6a7f2fa9e609f901e505089fa052e354c5847fb3d46578277ce4","f2f4a09230d8e7ca63e795554ae6c8e12bc7119aea6fcf422eb9d50ea76dfb7d","08dde44561a0758e2f0f28a83fdd1e9efdbe3f1641e8cb249520341ec39cf9f2","41dc69bfd21e3a7ff11b8171a7df73dcbadf185fcc651e3392d43a18803fb58b","52790c640be4d66de04ce610168f8d65d7a1990a82751b2e8486f2d2ae4bae88","eab210fef2acc1b6339b624587601e8cbd4e620c3e6bcea740f56813f124c476","78e8b82aa428cac50aa4bb800d1187d3e6803593adab0964d441b41b0bce7f8f","6774b9281f067192bef1464a61d5ca96f716851362f17ae1d57341023dbddf5d","b89dd0a15fded756615fb6e99e2809f56cd3c1d1886a4f09102bb7a76bea0b90","ac71c2f72e4b44a66b5ab8cdeeb5daff22cc4a4431f38ef542e70dc7db908d82"],"paragraph_range_zero_based":[6384,6407],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p6384"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if the criterion in 5.7.4.4 is met for a period of TSearchDeltaP-StationaryConnected:","paragraph_zero_based":6408},{"literal_text_all_w_t_and_m_t":"3>if the UE did not transmit a UEAssistanceInformation message with rrm-MeasRelaxationFulfilment as true since it was configured to provide indications of RRM measurement relaxation criterion fulfilment; or","paragraph_zero_based":6409},{"literal_text_all_w_t_and_m_t":"3>the last UEAssistanceInformation message indicated the criterion in 5.7.4.4 is not fulfilled with rrm-MeasRelaxationFulfilment as false:","paragraph_zero_based":6410},{"literal_text_all_w_t_and_m_t":"4>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to indicate that the criterion for RRM measurement relaxation for connected mode is fulfilled;","paragraph_zero_based":6411},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":6412},{"literal_text_all_w_t_and_m_t":"3>if the last UEAssistanceInformation message indicated fulfilment of the criterion in 5.7.4.4 with rrm-MeasRelaxationFulfilment as true:","paragraph_zero_based":6413},{"literal_text_all_w_t_and_m_t":"4>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to indicate that the criterion for RRM measurement relaxation for connected mode is not fulfilled.","paragraph_zero_based":6414},{"literal_text_all_w_t_and_m_t":"1>if configured to provide service link propagation delay difference between serving cell and neighbour cell(s);","paragraph_zero_based":6415},{"literal_text_all_w_t_and_m_t":"2>if the UE did not transmit a UEAssistanceInformation message with propagationDelayDifference since it was configured to provide service link propagation delay difference between serving cell and neighbour cell(s); or","paragraph_zero_based":6416},{"literal_text_all_w_t_and_m_t":"2>for any neighbour cell in neighCellInfoList, if the service link propagation delay difference between serving cell and the neighbour cell has changed more than threshPropDelayDiff since the last transmission of the UEAssistanceInformation message including propagationDelayDifference:","paragraph_zero_based":6417},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide service link propagation delay difference between serving cell and each neighbour cell included in the neighCellInfoList;","paragraph_zero_based":6418},{"literal_text_all_w_t_and_m_t":"1>if configured to indicate the availability of flight path information and the UE has flight path information available:","paragraph_zero_based":6419},{"literal_text_all_w_t_and_m_t":"2>if the UE had not previously provided a flight path information since last entering RRC_CONNECTED state; or","paragraph_zero_based":6420},{"literal_text_all_w_t_and_m_t":"2>if at least one waypoint was not previously provided; or","paragraph_zero_based":6421},{"literal_text_all_w_t_and_m_t":"2>if at least one upcoming waypoint that was previously provided is being removed; or","paragraph_zero_based":6422},{"literal_text_all_w_t_and_m_t":"2>if flightPathUpdateDistanceThr is configured and for at least one waypoint, the 3D distance between the previously provided location and the new location is more than or equal to the distance threshold configured by flightPathUpdateDistanceThr; or","paragraph_zero_based":6423},{"literal_text_all_w_t_and_m_t":"2> if flightPathUpdateTimeThr is configured and for at least one waypoint, the timestamp was not previously provided but is now available, or the time between the previously provided timestamp and the new timestamp, if available, is more than or equal to the time threshold configured by flightPathUpdateTimeThr:","paragraph_zero_based":6424},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to indicate the availability of flight path information;","paragraph_zero_based":6425},{"literal_text_all_w_t_and_m_t":"NOTE x:If neither flightPathUpdateDistanceThr nor flightPathUpdateTimeThr is configured, it is up to UE implementation whether to initiate transmission of the UEAssistanceInformation message when updated flight path information is available.","paragraph_zero_based":6426},{"literal_text_all_w_t_and_m_t":"5.7.4.3Actions related to transmission of UEAssistanceInformation message","paragraph_zero_based":6427},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of the UEAssistanceInformation message as follows:","paragraph_zero_based":6428},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide a delay budget report according to 5.7.4.2 or 5.3.5.3;","paragraph_zero_based":6429},{"literal_text_all_w_t_and_m_t":"2>set delayBudgetReport to type1 according to a desired value;","paragraph_zero_based":6430},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide overheating assistance information according to 5.7.4.2 or 5.3.5.3;","paragraph_zero_based":6431}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["3e38f9ad82d0f30d619198362648eb67feceaaaa829367b5142e95d74714dd47","3cd82823a83474ad483e79240ae0359a42a145f77c04d74a9c4488eb81d61820","f773797b28b5af4d84ea6990e78db4a223879577730cfcb25da44f474c282fd5","6b121cc571f48e941c0f57f9eb03e4b7874e917f39160ef0d54d20415501f52d","828e7112059d271ad9d164665be634d54e74c61dd8e487c05263bb61ec4580a0","d73900a12188fce756dc67d5c560fba55d6eecbc158be6eae229117c0367bb29","ef6b061dea336af0c82d9d79fa1c5ae9d12a66e643db6e207f482fdd8e588ff7","7a9fdd27b7fb7b075e50931701f976703af4a5a547871ed4cdd43d7928a03a51","7283eeacb3f803de0fa356b957b4a068b1700c3dc60f8593f9fd5c8ce4f3c8ad","7fb40f20561c3c5be77c3cc0ab4e3d3604342784662f68cb6a504aa9e6c12b03","d34d28ca07ba825f3866824b00a3eb53c157c39c7c1096867141dc7b4670c683","578c2b86e9442e11691ab8b55b8a3975ec5df9b4ff25ee4ea114685533181cf7","9de500ea301ea286eaaeb98eac09452e19497a4e7f6de39c2d3a304c6d8ba14e","ff7897486f1d4882388edb68705001a7071c45863e62a5804e30803102683733","d91f729014f266377f9ce194407e0f92cc2f7c080a129781859f30e0372a3ed7","04489a04eb2cbbbc2e4db781ef3473c2a1f684df0e7b8ffa1c2a693f5cb4a850","ed3f1f621a541396502679843a84113f54a1fd6d8da7b034fd64cdf6444fe0ad","0763b7d749a278b19aca240228e3b623a06343d4368f6ff91e968b736139ee89","2a8c8fd26c29b2dbc6f2ee96831a87662b3d0e742171042eb4cc9c11e10eab68","8527b7132a79e6c8b2fbdf688ae0e7f9dc93733926f24fc27a78c1e6af0ee4d3","b19b6b8398d72eb144058f870f9b50b607e717cc19b0627a6ac7d0b113cea181","10a4659d8f6f826172e2cf91e201a6f1403f9f3809dac61082c8c6721f9f11a7","c3970298770bf19979893dd0ea315a50c2843853bde77ea37ebbc7d74bb11bb1","742f931c2488d51df888f83f24c47d447c68fde1b41ea81f02694e5d493b17f8"],"paragraph_range_zero_based":[6408,6431],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p6408"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if the UE experiences internal overheating:","paragraph_zero_based":6432},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to temporarily reduce the number of maximum secondary component carriers:","paragraph_zero_based":6433},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxCCs in the OverheatingAssistance IE;","paragraph_zero_based":6434},{"literal_text_all_w_t_and_m_t":"4>set reducedCCsDL to the number of maximum SCells the UE prefers to be temporarily configured in downlink;","paragraph_zero_based":6435},{"literal_text_all_w_t_and_m_t":"4>set reducedCCsUL to the number of maximum SCells the UE prefers to be temporarily configured in uplink;","paragraph_zero_based":6436},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to temporarily reduce maximum aggregated bandwidth of FR1:","paragraph_zero_based":6437},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxBW-FR1 in the OverheatingAssistance IE;","paragraph_zero_based":6438},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-DL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all downlink carriers of FR1;","paragraph_zero_based":6439},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-UL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all uplink carriers of FR1;","paragraph_zero_based":6440},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to temporarily reduce maximum aggregated bandwidth of FR2-1:","paragraph_zero_based":6441},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxBW-FR2 in the OverheatingAssistance IE;","paragraph_zero_based":6442},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-DL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all downlink carriers of FR2-1;","paragraph_zero_based":6443},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-UL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all uplink carriers of FR2-1;","paragraph_zero_based":6444},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to temporarily reduce maximum aggregated bandwidth of FR2-2:","paragraph_zero_based":6445},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxBW-FR2-2 in the OverheatingAssistance IE;","paragraph_zero_based":6446},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-FR2-2-DL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all downlink carriers of FR2-2;","paragraph_zero_based":6447},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-FR2-2-UL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all uplink carriers of FR2-2;","paragraph_zero_based":6448},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to temporarily reduce the number of maximum MIMO layers of each serving cell operating on FR1:","paragraph_zero_based":6449},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxMIMO-LayersFR1 in the OverheatingAssistance IE;","paragraph_zero_based":6450},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR1-DL to the number of maximum MIMO layers of each serving cell operating on FR1 the UE prefers to be temporarily configured in downlink;","paragraph_zero_based":6451},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR1-UL to the number of maximum MIMO layers of each serving cell operating on FR1 the UE prefers to be temporarily configured in uplink;","paragraph_zero_based":6452},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to temporarily reduce the number of maximum MIMO layers of each serving cell operating on FR2-1:","paragraph_zero_based":6453},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxMIMO-LayersFR2 in the OverheatingAssistance IE;","paragraph_zero_based":6454},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR2-DL to the number of maximum MIMO layers of each serving cell operating on FR2-1 the UE prefers to be temporarily configured in downlink;","paragraph_zero_based":6455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["4e3c00997fd5a97a8fb1b77874ac7842e8c661f85b4592d6358018e17c7f97f2","cdfd54e07d7aa068a6d9a162df76d7e61410f9dde4f2f766039a3563139224b0","0effa788aa4643bc870935a1048d872a019d3be3e4667e00780a1553407518b8","2c44b00514e7c3a2ef42a35a932f956aa37ff2c6b40c2b016594b27e3778ef95","8e1cf182970bf45c86b3dc260930e370aadcbedd9fcff3865586dcf8bd87b757","7b93c52ba3eba958a8d60d5e31d8163aae68ef2246bd2485f712bd26e87f8952","3f1ad65e385d91d654c54992ab9e394218ed25942a96a506db1c3a06abdad194","5220225c85d35fc5b69f6ae519efa3620bfab30fb4183050ac423c05fec7a609","af22e78db35ab26863c347bc85c31ed272e1285bbcca8430879d8c81d62bae27","0078a004837edd62a9bd57b1e7900bafbe434157af2145f3bfed8f985c0f29b9","cb4d172965d31325b6a7f825fa821a48d729bb8a85140d4f8bce2b661c9796c9","2fc8a73af0f7b013873661553716f38623c2fad2717ac4cb7d61423edb4eb4b5","dc0875af69dfcda279bf10d9fba413e5b6089a1cb44c8c579661320159da6b40","293aa269b964b9a3884dc162d58916cc4c02d969a8e399b2eec3be6797a575b7","379a1b1dbbb9f0ddf7916f825f964c4a8e94a120510a69be27b51854035e4da8","09ef68a3f1ad18d420edd12e6c340599f6ec7c9a67f84a52c6f5bf3d43963a5c","b83c7bfea6e086897d6c903fb461d6c6ef4d47ec8566e093a265e2bf634a8c35","bcbd5ee0735fd70ba919c661c553b359bd40d768b11cd0799c7fd5a580374e43","fc37e86d0f16b39acc72a4f56f42ee94cc058dd107e9e8ee62e905df452c572f","16056dc066af2df10585151e3faef2cec57ce46063725b4826ba99abbb21936c","429e9fb3454331df12b4f4994771a925d461ac945f56c8f77aedbbfb3241c86b","bcaddf9e0a8781b139de6580ce0770a312300a0d7a3250fc604f957d62efefdb","4af8670c1c83b7cb9b20fb0a3d5ed81a0d100e19a59408bd007ef0a16d8b1133","b1a161d7ab8bc5f8f5b60828fe38e2e329a88636c3d3fbb9bcea7df41af02fab"],"paragraph_range_zero_based":[6432,6455],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p6432"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR2-UL to the number of maximum MIMO layers of each serving cell operating on FR2-1 the UE prefers to be temporarily configured in uplink;","paragraph_zero_based":6456},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to temporarily reduce the number of maximum MIMO layers of each serving cell operating on FR2-2:","paragraph_zero_based":6457},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxMIMO-LayersFR2-2 in the OverheatingAssistance IE;","paragraph_zero_based":6458},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR2-2-DL to the number of maximum MIMO layers of each serving cell operating on FR2 the UE prefers to be temporarily configured in downlink;","paragraph_zero_based":6459},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR2-2-UL to the number of maximum MIMO layers of each serving cell operating on FR2 the UE prefers to be temporarily configured in uplink;","paragraph_zero_based":6460},{"literal_text_all_w_t_and_m_t":"2>else (if the UE no longer experiences an overheating condition):","paragraph_zero_based":6461},{"literal_text_all_w_t_and_m_t":"3>do not include reducedMaxCCs, reducedMaxBW-FR1, reducedMaxBW-FR2, reducedMaxBW-FR2-2, reducedMaxMIMO-LayersFR1, reducedMaxMIMO-LayersFR2 or reducedMaxMIMO-LayersFR2-2 in OverheatingAssistance IE;","paragraph_zero_based":6462},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide IDC assistance information according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":6463},{"literal_text_all_w_t_and_m_t":"2>if there is at least one carrier frequency included in candidateServingFreqListNR, the UE is experiencing IDC problems that it cannot solve by itself:","paragraph_zero_based":6464},{"literal_text_all_w_t_and_m_t":"3>include the field affectedCarrierFreqList with an entry for each affected carrier frequency included in candidateServingFreqListNR;","paragraph_zero_based":6465},{"literal_text_all_w_t_and_m_t":"3>for each carrier frequency included in the field affectedCarrierFreqList, include interferenceDirection and set it accordingly;","paragraph_zero_based":6466},{"literal_text_all_w_t_and_m_t":"2>if there is at least one supported UL CA combination comprising of carrier frequencies included in candidateServingFreqListNR, the UE is experiencing IDC problems that it cannot solve by itself:","paragraph_zero_based":6467},{"literal_text_all_w_t_and_m_t":"3>include victimSystemType for each UL CA combination included in affectedCarrierFreqCombList;","paragraph_zero_based":6468},{"literal_text_all_w_t_and_m_t":"3>if the UE sets victimSystemType to wlan or bluetooth:","paragraph_zero_based":6469},{"literal_text_all_w_t_and_m_t":"4>include affectedCarrierFreqCombList with an entry for each supported UL CA combination comprising of carrier frequencies included in candidateServingFreqListNR, that is affected by IDC problems;","paragraph_zero_based":6470},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":6471},{"literal_text_all_w_t_and_m_t":"4>optionally include affectedCarrierFreqCombList with an entry for each supported UL CA combination comprising of carrier frequencies included in candidateServingFreqListNR, that is affected by IDC problems;","paragraph_zero_based":6472},{"literal_text_all_w_t_and_m_t":"NOTE 1:When sending an UEAssistanceInformation message to inform the IDC problems, the UE includes all IDC assistance information (rather than providing e.g. the changed part(s) of the IDC assistance information).","paragraph_zero_based":6473},{"literal_text_all_w_t_and_m_t":"NOTE 2:Upon not anymore experiencing a particular IDC problem that the UE previously reported, the UE provides an IDC indication with the modified contents of the UEAssistanceInformation message (e.g. by not including the IDC assistance information in the idc-Assistance field).","paragraph_zero_based":6474},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide drx-Preference of a cell group for power saving according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":6475},{"literal_text_all_w_t_and_m_t":"2>include drx-Preference in the UEAssistanceInformation message;","paragraph_zero_based":6476},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on DRX parameters for the cell group:","paragraph_zero_based":6477},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the long DRX cycle:","paragraph_zero_based":6478},{"literal_text_all_w_t_and_m_t":"4>include preferredDRX-LongCycle in the DRX-Preference IE and set it to the preferred value;","paragraph_zero_based":6479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["86f04e7b7f7cc9177cadce441896fd3c18425a05153b306237ed86a28f0b6105","a71eca059bb11a4312f417d27b193461965035bb7473394601cafcbf5a2cdacc","59117ee40a79d6fea0a968423a792641fe6d71e895e3f719cf15945ae0402ef9","696053552daf5279b600af2e0a228a53986ada5a09bcfa7c915aa01dba7d5f39","4f70362f0ea9c4315fc5d84a4b919f64b2f2e604593515dbae7f138b5a941b61","fbfc5a283d880a2a74e992795e6e3a4471a23e4965902d5e6fddcbe6fbf13687","f60ecd9bb5f1946b15dd6ec1ed8721fc326c494a31cf3a6e169f186e69c6c1aa","d68b1b69a49e7f8239afa9e775cc26b0a9cd20755889f7fac80c718cbae9ea90","5ce1bf19e2cb9511db2829a7048b5232bd74d9828271a52afd2e7b3e9f6f13ad","2dff175b57f806f55a06e90218a0aedb05e2b40a11a6accf144622ff685c9ebf","bcc9ca92378912da79e41e4f5abe41dca5d5e83e09f09ce58b32b104ffc2f91d","2c4a7b11201b11e479feeb5e649b10352a81cf605e6b6bc3d6c936a4034684cf","1a22dbc22213f9728ddb43b46619d9f75dbf05c247af1426eceb3efbe2c61ad1","ebf57fbd56c2d66097a510c28cb6c13df055e19053b6f6ddd6ae69fdd53660a0","51b5312ecfdae6a3e43e012223571aa0a192cabde91cc2972958e8394b8bdffb","d2c57d5ac9a02270598dc3cacefcd95ef4f6e2698de67cef7f9e63cdc2471ad9","da79f510a031d4c032a4384996f83cd470cdaee1e42c2ed8995e03658ae10f8d","4745363f35121a521d7fb82970d3fece89d0c23a2abe07361d43316caf4f6284","9543996fc16945613aa4566429032baed521cb941b971e4f39b6970d1f084b37","12cfafee6aa0bdfced9eee37ae4e671cf0a860401cfa6774b99901b0cafc9ea5","b38a3624a5a6ce7516902f43fd83566f57dc8f62b65a9eaf156f8d643e0f235d","dd80ab09b172c98e6473a70fd1e842b593536aaf1bc578fd95516225b72a959f","2b5c74ca4a7e6d072ab8a73bb3feca01b4317883b5d69ebf1408675c52ebdbbf","41a224f8c43a8a38c1bfaf8387be8f8e806a0b7b714f29bc305972f0d22839f8"],"paragraph_range_zero_based":[6456,6479],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p6456"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the DRX inactivity timer:","paragraph_zero_based":6480},{"literal_text_all_w_t_and_m_t":"4>include preferredDRX-InactivityTimer in the DRX-Preference IE and set it to the preferred value;","paragraph_zero_based":6481},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the short DRX cycle:","paragraph_zero_based":6482},{"literal_text_all_w_t_and_m_t":"4>include preferredDRX-ShortCycle in the DRX-Preference IE and set it to the preferred value;","paragraph_zero_based":6483},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the short DRX timer:","paragraph_zero_based":6484},{"literal_text_all_w_t_and_m_t":"4>include preferredDRX-ShortCycleTimer in the DRX-Preference IE and set it to the preferred value;","paragraph_zero_based":6485},{"literal_text_all_w_t_and_m_t":"2>else (if the UE has no preference on DRX parameters for the cell group):","paragraph_zero_based":6486},{"literal_text_all_w_t_and_m_t":"3>do not include preferredDRX-LongCycle, preferredDRX-InactivityTimer, preferredDRX-ShortCycle and preferredDRX-ShortCycleTimer in the DRX-Preference IE;","paragraph_zero_based":6487},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide maxBW-Preference of a cell group for power saving according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":6488},{"literal_text_all_w_t_and_m_t":"2>include maxBW-Preference in the UEAssistanceInformation message;","paragraph_zero_based":6489},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on the maximum aggregated bandwidth for the cell group:","paragraph_zero_based":6490},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to reduce the maximum aggregated bandwidth of FR1:","paragraph_zero_based":6491},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxBW-FR1 in the MaxBW-Preference IE;","paragraph_zero_based":6492},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-DL to the maximum aggregated bandwidth the UE desires to have configured across all downlink carriers of FR1 in the cell group;","paragraph_zero_based":6493},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-UL to the maximum aggregated bandwidth the UE desires to have configured across all uplink carriers of FR1 in the cell group;","paragraph_zero_based":6494},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to reduce the maximum aggregated bandwidth of FR2-1:","paragraph_zero_based":6495},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxBW-FR2 in the MaxBW-Preference IE;","paragraph_zero_based":6496},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-DL to the maximum aggregated bandwidth the UE desires to have configured across all downlink carriers of FR2-1 in the cell group;","paragraph_zero_based":6497},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-UL to the maximum aggregated bandwidth the UE desires to have configured across all uplink carriers of FR2-1 in the cell group;","paragraph_zero_based":6498},{"literal_text_all_w_t_and_m_t":"2>else (if the UE has no preference on the maximum aggregated bandwidth for the cell group):","paragraph_zero_based":6499},{"literal_text_all_w_t_and_m_t":"3>do not include reducedMaxBW-FR1 and reducedMaxBW-FR2 in the MaxBW-Preference IE;","paragraph_zero_based":6500},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide maxBW-PreferenceFR2-2 of a cell group for power saving according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":6501},{"literal_text_all_w_t_and_m_t":"2>include maxBW-PreferenceFR2-2 in the UEAssistanceInformation message;","paragraph_zero_based":6502},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to reduce the maximum aggregated bandwidth of FR2-2:","paragraph_zero_based":6503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["6adb7eb45bb4ed81bb72e9213203a3c2fb6668c189d0b8c5d2cbbc015fb82cf6","95a3336a6d41195ce7068a8ba9e4d678b91d5f1f1603f7b035a86d56cb92f28f","0112f541f8937b46e23c8a7d0db73ee307ec6c6246895afc2fcaf46f323f34fb","b3ec3b41c5e81cdddb5d76ffefa642e1789674680e2746c6907941e7add86c60","fbe5647dca07beaa13da2821bce91a3915fb694fd5dc70c5dd252acfd732de3e","1cccab75be8165aff6a1aa9e190fcb83350f0df2e859590f9ac0ac88f93771a8","0f50ad9b60e52c81a43ad5727530466cf82e31a35eba68f69fca657559cf7104","3a6d5112c4be96c1c12ee9cfe78b9347f66d0549ef49ccee6f960114d8361236","28b4c7ab4750c0463213031a85b5fa05dabf1f6f4394b004bf8af5d4640010f9","dc8f4c2bbc779ad7df3892c8b6dbbd6002fbe5a03ccacfb464ed968620067879","0ceedbdd05c9b0860b608381ab33ec96539ffe907d138b59e7bc908ad7d71cdc","03f5ba903263458abea0d927a3188f8c87b5a585416fff18a602720f32167aff","02b9afba80e75cdf11a805ef1cf9ebe4d4a6e7230f8c46baa4d8d0f4366c96d3","88bdb6cdb53adfebf6c4b9adbd490fdb49aea3aa743a09c16123ce34efc815e9","28de6e2d25ff920803cceb82b5d9e5623f5c40ab46565a71ea4b40c76a6dac3b","511372e637661745b9f8a7cf6b66230d4190946c43e9ef34fe1988aa055411ad","bd6999834973a269036e0de3fed927e2bb7cb3f7b9a55704a4b411f4b4c6a4fc","7c61c75bd925e939028f73e030c0d11dfd3d02aef7f3c88d4935c8ce52783802","e53c2c5cab9c5a25b50d5418f09a18c2cf990445aecc475e475ef3e8872c91fe","ae9d6290dc55368f1fe7a9f6437ea2caac7e5e154bee301d13e9b753a22f9b79","3e63b453e8c335a9edfd4584520a3f9b2aa8dc3a53b7ca1f551a8654e0d109f5","9896bcc718c7ded3e81870f16ca3688dc3da9a3a57b7e211dc8e5233ec0758d0","22b7eb45f6eb195b347c018870433695ee6f8a3c0ab81332415d9ee4f875e2a1","7ed63132c7cefc9ce29b507c25e9688aba26a5ba27d7edbec4f842770c789572"],"paragraph_range_zero_based":[6480,6503],