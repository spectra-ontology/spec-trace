{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Inequality A5H1-1 (Entering condition 1)","paragraph_zero_based":5400},{"literal_text_all_w_t_and_m_t":"Mp + Hys1 < Thresh1","paragraph_zero_based":5401},{"literal_text_all_w_t_and_m_t":"Inequality A5H1-2 (Entering condition 2)","paragraph_zero_based":5402},{"literal_text_all_w_t_and_m_t":"Mn + Ofn + Ocn – Hys1 > Thresh2","paragraph_zero_based":5403},{"literal_text_all_w_t_and_m_t":"Inequality A5H1-3 (Entering condition 3)","paragraph_zero_based":5404},{"literal_text_all_w_t_and_m_t":"Ms – Hys2 > Thresh3","paragraph_zero_based":5405},{"literal_text_all_w_t_and_m_t":"Inequality A5H1-4 (Leaving condition 1)","paragraph_zero_based":5406},{"literal_text_all_w_t_and_m_t":"Mp – Hys1 > Thresh1","paragraph_zero_based":5407},{"literal_text_all_w_t_and_m_t":"Inequality A5H1-5 (Leaving condition 2)","paragraph_zero_based":5408},{"literal_text_all_w_t_and_m_t":"Mn + Ofn + Ocn + Hys1 < Thresh2","paragraph_zero_based":5409},{"literal_text_all_w_t_and_m_t":"Inequality A5H1-6 (Leaving condition 3)","paragraph_zero_based":5410},{"literal_text_all_w_t_and_m_t":"Ms + Hys2 < Thresh3","paragraph_zero_based":5411},{"literal_text_all_w_t_and_m_t":"The variables in the formula are defined as follows:","paragraph_zero_based":5412},{"literal_text_all_w_t_and_m_t":"Mp is the measurement result of the NR SpCell, not taking into account any offsets.","paragraph_zero_based":5413},{"literal_text_all_w_t_and_m_t":"Mn is the measurement result of the neighbouring cell, not taking into account any offsets.","paragraph_zero_based":5414},{"literal_text_all_w_t_and_m_t":"Ofn is the measurement object specific offset of the neighbour cell (i.e. offsetMO as defined within measObjectNR corresponding to the neighbour cell).","paragraph_zero_based":5415},{"literal_text_all_w_t_and_m_t":"Ocn is the cell specific offset of the neighbour cell (i.e. cellIndividualOffset as defined within measObjectNR corresponding to the neighbour cell), and set to zero if not configured for the neighbour cell.","paragraph_zero_based":5416},{"literal_text_all_w_t_and_m_t":"Hys1 is the hysteresis parameter for this event (i.e. a5-Hysteresis as defined within reportConfigNR for this event).","paragraph_zero_based":5417},{"literal_text_all_w_t_and_m_t":"Thresh1 is the threshold parameter for this event (i.e. a5-Threshold1 as defined within reportConfigNR for this event).","paragraph_zero_based":5418},{"literal_text_all_w_t_and_m_t":"Thresh2 is the threshold parameter for this event (i.e. a5-Threshold2 as defined within reportConfigNR for this event).","paragraph_zero_based":5419},{"literal_text_all_w_t_and_m_t":"Ms is the Aerial UE altitude relative to the sea level.","paragraph_zero_based":5420},{"literal_text_all_w_t_and_m_t":"Hys2 is the hysteresis parameter for this event (i.e. h1-Hysteresis as defined within reportConfigNR for this event).","paragraph_zero_based":5421},{"literal_text_all_w_t_and_m_t":"Thresh3 is the threshold parameter for this event (i.e. h1-Threshold as defined within reportConfigNR for this event).","paragraph_zero_based":5422},{"literal_text_all_w_t_and_m_t":"Mn, Mp are expressed in dBm in case of RSRP, or in dB in case of RSRQ and RS-SINR.","paragraph_zero_based":5423}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["3cb457dd58f77816b4a8f817a0b21a69e22dfc84d555811bbb74b9145d3061b0","997740ddfdb14516043429da635e8f5acbf05e9b152ac701642b8a9fbecf32c8","2be884cc7c930bd6938bca683f200c9b747144d40f64e6e7b1bc9d34d1327b62","e6d80800fef9abb3538b8c4c93c796f615918271d28c007384aa25227b53aa