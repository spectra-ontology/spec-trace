                CHOICE {","paragraph_zero_based":30447},{"literal_text_all_w_t_and_m_t":"        bwp-Id-r16                                    BWP-Id,","paragraph_zero_based":30448},{"literal_text_all_w_t_and_m_t":"        deactivatedCarrier-r16                        ENUMERATED {deactivated}","paragraph_zero_based":30449},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":30450},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30451},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30452},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentTwoCarrierInfo-r16 ::=   SEQUENCE {","paragraph_zero_based":30453},{"literal_text_all_w_t_and_m_t":"    referenceCarrierIndex-r16                     ServCellIndex,","paragraph_zero_based":30454},{"literal_text_all_w_t_and_m_t":"    shift7dot5kHz-r16                             BOOLEAN,","paragraph_zero_based":30455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["5308c7e33b06c728f83ac239add2470d4e079b81a373a06a90289accb5e90b46","31c4fdd2f4a581edd18949774d40946ab219e08d1b745c6410a2552518a0f4c0","8270abc0779fc272d1e9af2d43ed1a24614e256c10b49b792a6cfee2d1bbc1b8","ecf79e9b421ff9df1e862467fd6502b07f1fe3366f8d15e3e8b787a3c0f2b074","6e39a031f94a4f3e18a39a9dd1e5aa3f734d38418dad45910d9882ccdbff733d","a940882abf2c59dd3242b97b28d94d962684f4de92b302b586ff8389c9fc5821","82009d9b5878ab53501b0ce0b6c9195c157ad7d743a23f7457a318d77ce7149f","96dba42516071ee5c9a7e2512ad506aed41baa9be877a021f1db5cb9815f5df6","5622d99fc4e31153c5a2125a4ee1f028445d3fedc40148a08d7296d388154718","b1fa906d569233d96fb4a9384750168add069779b26fb16443f7f4d9afc7b499","522bbf0980cdc56fb5005783a8acb2b3d6096fac86ae06f30ba6e46ee1a5383e","a7a4be88a7