39),","paragraph_zero_based":22210},{"literal_text_all_w_t_and_m_t":"            sCS480KHZoneT-SCS120KHZquarterT-SCS60KHZoneEighthT-SCS30KHZoneSixteenthT SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..4479),","paragraph_zero_based":22211},{"literal_text_all_w_t_and_m_t":"            sCS480KHZhalfT-SCS120KHZoneEighthT-SCS60KHZoneSixteenthT         SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..8959),","paragraph_zero_based":22212},{"literal_text_all_w_t_and_m_t":"            sCS480KHZquarterT-SCS120KHZoneSixteenthT                         SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..17919),","paragraph_zero_based":22213},{"literal_text_all_w_t_and_m_t":"            sCS480KHZoneEighthT                                           SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..35839),","paragraph_zero_based":22214},{"literal_text_all_w_t_and_m_t":"            sCS480KHZoneSixteenthT                                        SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..71679)","paragraph_zero_based":22215},{"literal_text_all_w_t_and_m_t":"        }","paragraph_zero_based":22216},{"literal_text_all_w_t_and_m_t":"    }                                                                                           OPTIONAL     -- Cond InitialBWP-Paging","paragraph_zero_based":22217},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":22218},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":22219},{"literal_text_all_w_t_and_m_t":"    followUnifiedTCI-State-v1720           ENUMERATED {enabled}                                  OPTIONAL     -- Need R","paragraph_zero_based":22220},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":22221},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22222},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22223}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["b79abaf6b4866f14a7b118712b5364532958f901edd63215e86b3c0d55045285","b2bc6374471fd1dfc001470c1cd6afd5a9f0c3a00386d3142a8e33e5f07182df","33259a42614b288a7b79f3e66b784edafea3b90c79aaa4d1b54759231e6bd29e","d8a613e67644cfda79ece646459faa8baac7459b491efa2081d68332ae461859","4d3f96393141d273ad29322f70a49732eef5edd2782e16a0d65e17d2e7c87162","b343a7ad50a351f8e83476dcfb005edacd20b4230cf70ba2104dcc29d5bed4fb","bd2a08c2a151e515e12c2e8b5e8fde2ece1c3c267fb69b76cf6bc3a57bf96afc","eadd2f1c06f679dd503f802cdeedfff738edb34b2d4bb93aee81ed3b18766d5a","c87dfc7dbf1a664837918e71710cfae0d0d65b36986202b8e0e0e82366e119da","2b91c17754781fbe434ca3b9d641cd13c70c3295528a68cf2e2f48965d912e90","dcfcc8f2920e268b6abd67513f39930d4d878f9ccaf87de445365e48ca5aceab","4d0e25bcb0a82f80f061537007a1403e614b6618a795c4b7da0910a646881861","2e556ab24bcc30d641766b097525d4c3bd6d03bfb070b194d5b8ed11beabc999","df270d7e22a63605ba15ffb557d9a4bed4b686089de85e8fc76ab9cb496ac6eb","fd11cd14dc7dfd558a41280a7fe200fc03f721180548f7f8516566907ff19fc8","b373f2c02a712b88e57e9f9aff2b2c63239d51764693594907e4f62ec4ca3835","cd66a47dc76803845141953ba4952c74f9f5c37cf44332664507507f1e07e449","b6250e1be200e0e0dbc945166775485155007bf863a99ea063a01625d23cfcfb","cb3005fe5eef0b46ad370a79f0fc657eabaf31b6ff52ed44629c0d4cf7f04ce4","f93caf2ef32f4154bf68963fa9bbba85691a8cfe62e686c7af1404b65067154b","85dca683ad17e6d83340eda8f74b163186a2f35d6f6bc2749cf5e4a8bba37b87","6d3d08abd7df94613ed834b6398fad8ad5f13c0e083df5e07018ba879aa659dd","b96e8424f6e57f5d6104c0ea9fbe9426d8332b49a6d79236b01d6b3b624592c1","68a088424d09b56b6020c0de2824fba628eb02229460afba3b2fb2c7a6ecd334"],"paragraph_range_zero_based":[22200,22223],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p22200"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-PDCCH-CONFIGCOMMON-STOP","paragraph_zero_based":22224},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":22225},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22226},{"literal_text_all_w_t_and_m_t":"PDCCH-ConfigCommon field descriptions","paragraph_zero_based":22227},{"literal_text_all_w_t_and_m_t":"commonControlResourceSet","paragraph_zero_based":22228},{"literal_text_all_w_t_and_m_t":"An additional common control resource set which may be configured and used for any common or UE-specific search space. If the network configures this field, it uses a ControlResourceSetId other than 0 for this ControlResourceSet. The network configures the commonControlResourceSet in SIB1 so that it is contained in the bandwidth of CORESET#0. If the RedCap-specific initial downlink BWP does not contain the entire CORESET#0, the network configures the commonControlResourceSet in the RedCap-specific initial downlink BWP in SIB1 for RedCap such that it does not have to be contained in the bandwidth of CORESET#0.","paragraph_zero_based":22229},{"literal_text_all_w_t_and_m_t":"commonSearchSpaceList, commonSearchSpaceListExt, commonSearchSpaceListExt2","paragraph_zero_based":22230},{"literal_text_all_w_t_and_m_t":"A list of additional common search spaces. If the network configures this field, it uses the SearchSpaceIds other than 0. If the field is included, it replaces any previous list, i.e. all the entries of the list are replaced and each of the SearchSpace entries is considered to be newly created and the conditions and Need codes for setup of the entry apply. If the network includes commonSearchSpaceListExt/commonSearchSpaceListExt2, it includes the same number of entries, and listed in the same order, as in commonSearchSpaceList.","paragraph_zero_based":22231},{"literal_text_all_w_t_and_m_t":"controlResourceSetZero","paragraph_zero_based":22232},{"literal_text_all_w_t_and_m_t":"Parameters of the common CORESET#0 which can be used in any common or UE-specific search spaces. The values are interpreted like the corresponding bits in MIB pdcch-ConfigSIB1. Even though this field is only configured in the initial BWP (BWP#0) controlResourceSetZero can be used in search spaces configured in other DL BWP(s) than the initial DL BWP if the conditions defined in TS 38.213 [13], clause 10 are satisfied.","paragraph_zero_based":22233},{"literal_text_all_w_t_and_m_t":"firstPDCCH-MonitoringOccasionOfPEI-O","paragraph_zero_based":22234},{"literal_text_all_w_t_and_m_t":"Offset, in number of symbols, from the start of the reference frame for PEI-O to the start of the first PDCCH monitoring occasion of PEI-O on this BWP, see TS 38.213 [13], clause 10.4A. For the case po-NumPerPEI is smaller than Ns, UE applies the (floor(i_s/po-NumPerPEI)+1)-th value out of (N_s/po-NumPerPEI) configured values in firstPDCCH-MonitoringOccasionOfPEI-O for the symbol-level offset. When po-NumPerPEI is one or multiple of Ns, UE applies the first configured value in firstPDCCH-MonitoringOccasionOfPEI-O for the symbol-level offset.","paragraph_zero_based":22235},{"literal_text_all_w_t_and_m_t":"firstPDCCH-MonitoringOccasionOfPO","paragraph_zero_based":22236},{"literal_text_all_w_t_and_m_t":"Indicates the first PDCCH monitoring occasion of each PO of the PF on this BWP, see TS 38.304 [20]. The field sCS120KHZquarterT-SCS60KHZoneEighthT-SCS30KHZoneSixteenthT, sCS120KHZoneEighthT-SCS60KHZoneSixteenthT and sCS120KHZoneSixteenthT can be applied for SCS 480kHz, corresponding to sCS480KHZoneT-SCS120KHZquarterT-SCS60KHZoneEighthT-SCS30KHZoneSixteenthT, sCS480KHZhalfT-SCS120KHZoneEighthT-SCS60KHZoneSixteenthT and sCS480KHZquarterT-SCS120KHZoneSixteenthT in IE DownlinkConfigCommonSIB respectively.","paragraph_zero_based":22237},{"literal_text_all_w_t_and_m_t":"followUnifiedTCI-State","paragraph_zero_based":22238},{"literal_text_all_w_t_and_m_t":"When set to enabled, for PDCCH reception in CORESET #0, the UE applies the \"indicated\" DL only TCI or joint TCI as specified in TS 38.214 [19], clause 5.1.5.","paragraph_zero_based":22239},{"literal_text_all_w_t_and_m_t":"pagingSearchSpace","paragraph_zero_based":22240},{"literal_text_all_w_t_and_m_t":"ID of the search space for paging (see TS 38.213 [13], clause 10.1). If the field is absent, the UE does not receive paging in this BWP (see TS 38.213 [13], clause 10). This field is absent for the RedCap-specific initial downlink BWP, if it does not include CD-SSB and the entire CORESET#0. In that case, a RedCap UE in RRC_IDLE or RRC_INACTIVE while SDT procedure is not ongoing, shall monitor paging in the initial DL BWP that includes CORESET#0.","paragraph_zero_based":22241},{"literal_text_all_w_t_and_m_t":"pei-ConfigBWP","paragraph_zero_based":22242},{"literal_text_all_w_t_and_m_t":"Provides the configuration for PEI reception in this BWP. If the field is absent, the UE does not receive PEI in this BWP.","paragraph_zero_based":22243},{"literal_text_all_w_t_and_m_t":"pei-SearchSpace","paragraph_zero_based":22244},{"literal_text_all_w_t_and_m_t":"ID of dedicated search space for PEI. It can be configured to one of up to 4 common SS sets configured by commonSearchSpaceList with SearchSpaceId > 0. The CCE aggregation levels and maximum number of PDCCH candidates per CCE aggregation level follows Table 10.1-1 of TS38.213 [13]. SearchSpaceId = 0 can be configured for the case of SS/PBCH block and CORESET multiplexing pattern 2 or 3.","paragraph_zero_based":22245},{"literal_text_all_w_t_and_m_t":"ra-SearchSpace","paragraph_zero_based":22246},{"literal_text_all_w_t_and_m_t":"ID of the Search space for random access procedure (see TS 38.213 [13], clause 10.1). If the field is absent, the UE does not receive RAR in this BWP. This field is mandatory present in the DL BWP(s) if the conditions described in TS 38.321 [3], clause 5.15 are met.","paragraph_zero_based":22247}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["2672dfb6d7e674886c67fcbf901fcd42abc05bb90cd73ac4aec2decca03e072b","237b8d8ef91d7920d58e7b9b3a0f6522dd51e1b2d127459b97d2a261cad6b82c","e657efe19c971e32cd94c1f1c701ba2aa823d339897d6b3900138bab91ddccaa","c7506950005ab1265756aa28eacfab77476818f77c732e86f9dbe83687994f27","c34fe393e4226118f962b48b10d37d4755fcfcd4f26b51dea25e747818b3a953","f8d353473a620e9882b5e1e7d4b4a6633ddbe6af6527ced0101fdbc2cf789728","0670814449132b424e049827d61f23fac9877d9bb49a3f8e9cf32cbeab5789b7","8e3a08c919d956de98be05c05fdecfd5e47ae3c665c1d23ec54f308bed6a7e46","8bb91fd5c7ffd6d8e2cbf7b1c9b8b82c2d82e098a2197f890dc7d69627b4d217","2a900a99bc45343e7e0f9d3cd6105649b4cfb1eff64d380d47c91286aa15b5ee","b388ea178a2e773c1213d07811f7705fad60bcb6a72f1af63189620351e7dc6e","4b91d365ab5f06427b383613a4fd3a08b65b1273602ff345f38dd76bcfe63e76","d6a430066518d783c4cfa620b5d3a6ed703469478726eca52767fa1f384f36cd","102132a0941e68055d8e4f71901ba7d4dba5b6894d171e9a292ca69c67d2fa9d","5eec3cae8d95817e389159d3aa17b79895fc7134de045580b982fb003e443c9e","1b52d8be7cda9e567b6f5c678ac44322a9b8092cd8f8a714d91fdc91c8962674","aec7200f108a087d363b65be9088aa39bbd9a6eb5cb465b0c3842d19b964a22d","141a58b0efa219970aa5562e71c0283d5ec131d20194a1c9b4c5c60932474609","da39df52be1ee6031ac8c3fc8d2697f2a9bd741f1bd4f2619d9dbd29f4a49137","dbdcb20eba88f927c8b9eab9a6586ff17cafc38e7cabfa6c0573adbbff9c0e47","5f30214b2f8953e2cf3cebcb9c557291340ef90899ca627f86f8af2fb10156b8","936db3d004ccc5aef30334abada94bbeadf04d204ba95bf818fede9611823ea5","e96510f41ad574fc1cb89d31b93e5c756deabf8c89e314a2f35776e3052235a1","7a349d2c9ec35d3443ea2e2104855b0ba2b9f57b79f6ad95a0c8e8a1c4db7a6e"],"paragraph_range_zero_based":[22224,22247],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p22224"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sdt-SearchSpace","paragraph_zero_based":22248},{"literal_text_all_w_t_and_m_t":"Common search space for CG-SDT and RA-SDT (see TS 38.213 [13]). If an existingSearchSpace is used, the network only signals the search space ID of the ra-SearchSpace.","paragraph_zero_based":22249},{"literal_text_all_w_t_and_m_t":"searchSpaceMCCH","paragraph_zero_based":22250},{"literal_text_all_w_t_and_m_t":"ID of the search space for MCCH. If the field is absent, the UE does not receive MCCH in this BWP (see TS 38.213 [13], clause 10). This field is absent for the RedCap-specific initial downlink BWP, if it does not include CD-SSB and the entire CORESET#0.","paragraph_zero_based":22251},{"literal_text_all_w_t_and_m_t":"searchSpaceMTCH","paragraph_zero_based":22252},{"literal_text_all_w_t_and_m_t":"ID of the search space for MTCH of MBS broadcast. If the field is absent, the UE applies searchSpaceMCCH also for MTCH, (see TS 38.213 [13], clause 10). This field is absent for the RedCap-specific initial downlink BWP, if it does not include CD-SSB and the entire CORESET#0.","paragraph_zero_based":22253},{"literal_text_all_w_t_and_m_t":"searchSpaceOtherSystemInformation","paragraph_zero_based":22254},{"literal_text_all_w_t_and_m_t":"ID of the Search space for other system information, i.e., SIB2 and beyond (see TS 38.213 [13], clause 10.1). If the field is absent, the UE does not receive other system information in this BWP. This field is absent for the RedCap-specific initial DL BWP, if it does not include CD-SSB and the entire CORESET#0. In that case, a RedCap UE in RRC_IDLE or RRC_INACTIVE shall monitor PDCCH to receive other system information using searchSpaceOtherSystemInformation in the initial DL BWP that includes CD-SSB and the entire CORESET#0.","paragraph_zero_based":22255},{"literal_text_all_w_t_and_m_t":"searchSpaceSIB1","paragraph_zero_based":22256},{"literal_text_all_w_t_and_m_t":"ID of the search space for SIB1 message. In the initial DL BWP of the UE′s PCell, the network sets this field to 0. If the field is absent, the UE does not receive SIB1 in this BWP. (see TS 38.213 [13], clause 10). This field is absent for the RedCap-specific initial DL BWP, if it does not include CD-SSB and the entire CORESET#0. In that case, a RedCap UE in RRC_IDLE or RRC_INACTIVE shall monitor PDCCH to receive SIB1 using searchSpaceSIB1 in the initial DL BWP that includes CD-SSB and the entire CORESET#0.","paragraph_zero_based":22257},{"literal_text_all_w_t_and_m_t":"searchSpaceZero","paragraph_zero_based":22258},{"literal_text_all_w_t_and_m_t":"Parameters of the common SearchSpace#0. The values are interpreted like the corresponding bits in MIB pdcch-ConfigSIB1. Even though this field is only configured in the initial BWP (BWP#0), searchSpaceZero can be used in search spaces configured in other DL BWP(s) than the initial DL BWP if the conditions described in TS 38.213 [13], clause 10, are satisfied.","paragraph_zero_based":22259},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22260},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":22261},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":22262},{"literal_text_all_w_t_and_m_t":"InitialBWP-Only","paragraph_zero_based":22263},{"literal_text_all_w_t_and_m_t":"If SIB1 is broadcast the field is mandatory present in the PDCCH-ConfigCommon of the initial BWP (BWP#0) in ServingCellConfigCommon except it is the RedCap-specific initial BWP not including CD-SSB and the entire CORESET#0; it is absent in other BWPs and when sent in system information. If SIB1 is not broadcast and there is an SSB associated to the cell, the field is optionally present, Need M, in the PDCCH-ConfigCommon of the initial BWP (BWP#0) in ServingCellConfigCommon (still with the same setting for all UEs). In other cases, the field is absent.","paragraph_zero_based":22264},{"literal_text_all_w_t_and_m_t":"OtherBWP","paragraph_zero_based":22265},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, if this BWP is not the initialDownlinkBWP and pagingSearchSpace is configured in this BWP. Otherwise this field is absent.","paragraph_zero_based":22266},{"literal_text_all_w_t_and_m_t":"InitialBWP-Paging","paragraph_zero_based":22267},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, if this BWP is the initialDownlinkBWP or initialDownlinkBWP-RedCap including CD-SSB and the entire CORESET#0, and pei-Config is configured in DownlinkConfigCommonSIB. Otherwise, this field is absent.","paragraph_zero_based":22268},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22269},{"literal_text_all_w_t_and_m_t":"–PDCCH-ConfigSIB1","paragraph_zero_based":22270},{"literal_text_all_w_t_and_m_t":"The IE PDCCH-ConfigSIB1 is used to configure CORESET#0 and search space#0.","paragraph_zero_based":22271}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["b3b60ce9b89a6e9b8194a0d3105de9c8e5faaa33fa2d6d923f10a0fe2d989072","7a7d866d4331f00680ee594308812f65b033f69ef56b0479f8834d26a2f9b505","2249b5e72bdfd30562828b6f9b3a1d620532f965b3874b55a8f33b08c2b06e89","a1a437cc2fe423154b08c46a6069f0e9c384b1d44fcf192711801bdfc0416d49","ffd5c96aeea46daf736cf5ec4987edd3b3654181844cff4a60c3210988a3dfa0","9bbb859bed5220518211762e90e65a974b2e385dc0c36b2645f4cf305e1b4444","105374550ad676442d9ce9bcd51ad2b5c7d6971e65a983e1ceeae59f6c11029e","6c79f7da7d8165d08e61dd47f28de5a9913b4b9019f70d8c432b72f4dad6de21","f2e25ed54a42eba8e5a1094cb4394084f7b5d17948032e603170603efb5