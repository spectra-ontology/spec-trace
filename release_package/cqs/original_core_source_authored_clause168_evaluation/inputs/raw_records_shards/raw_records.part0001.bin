{"fields":{"filename":"R2-2401458.zip::R2-2401458.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"]],","paragraph_zero_based":120},{"literal_text_all_w_t_and_m_t":"[[","paragraph_zero_based":121},{"literal_text_all_w_t_and_m_t":"remoteUE-IndicationReq-r18ENUMERATED { true }OPTIONAL -- Cond NR","paragraph_zero_based":122},{"literal_text_all_w_t_and_m_t":"]]","paragraph_zero_based":123},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":124},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":125},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":126},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":127},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":128},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":129},{"literal_text_all_w_t_and_m_t":"NR","paragraph_zero_based":130},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need ON, for NR access. Otherwise it is not present.","paragraph_zero_based":131},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":132},{"literal_text_all_w_t_and_m_t":"CommonIEsRequestCapabilities field descriptions","paragraph_zero_based":133},{"literal_text_all_w_t_and_m_t":"lpp-message-segmentation-req","paragraph_zero_based":134},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to provide its LPP message segmentation capabilities. If bit 0 is set to value 1, it indicates that the server is able to send segmented LPP messages to the target device; if bit 0 is set to value 0 it indicates that the server is not able to send segmented LPP messages to the target device.","paragraph_zero_based":135},{"literal_text_all_w_t_and_m_t":"If bit 1 is set to value 1, it indicates that the server is able to receive segmented LPP messages from the target device; if bit 1 is set to value 0 it indicates that the server is not able to receive segmented LPP messages from the target device.","paragraph_zero_based":136},{"literal_text_all_w_t_and_m_t":"remoteUE-IndicationReq","paragraph_zero_based":137},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to indicate if it operates as a L2 U2N Remote UE.","paragraph_zero_based":138},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":139},{"literal_text_all_w_t_and_m_t":"–CommonIEsProvideCapabilities","paragraph_zero_based":140},{"literal_text_all_w_t_and_m_t":"The CommonIEsProvideCapabilities carries common IEs for a Provide Capabilities LPP message Type.","paragraph_zero_based":141},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":142},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"d8b33d63fa1306a290dfb1d41f0e061f60eb9bc61338ba8f51a0b2ece58785e5","original_member_sha256":"f2c0c6f90bae1678a978a16529e8b69f70957939d0d2a5d48a0840e1efb74554","paragraph_ElementTree_utf8_XML_sha256":["35d7c0c3656e6b74f2d5ebc7771120b40ae43db1c6c7021370396f999f3f7310","64486edcc4382d9360079539c65d11981d6aa8556af34b9f14d347a2e1a8e133","d3adc2c0c6772247eef6dde9e26d36c46031d54d1b9f3e825c7781f70e7e7ec9","abfb6f2dc79e0b3e9dc728e9626d6df93bf1948d0a7dbf2348da0b099e7f3911","7a8f47b54cc1e892573a7847a20683cd916b428f240576bd6f098fb2cc40d2b1","9f52cdb2928da19bdafedcff818c50c2aae1a89a930051c736d4763141d93450","d661bbb2d4e4b92d10005d6aa97b46e9fc18a8404fb723a648b359b631759d56","3196766a77accc99db7962674cd0fa426505679fe0327480e288d73dbc5a3a63","bbab37c5d161047f3d621de143dfb6073b9fb9f0f1ef45e61a78bb0403aed481","d8daf85288318d47c1782dac31cac866bc72ec21a101e18a8056f0647aaf5e27","ef1509082b2d2ae09707d66df3ff34a60e6a18979a15a264734a558241e2049a","0164b4eea1c58585dd4b404313ec12139adbaffb058aa63276fcc92b12144f32","794c8761c52090e741