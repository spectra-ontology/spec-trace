{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SRS-TPC-PDCCH-Config field descriptions","paragraph_zero_based":28752},{"literal_text_all_w_t_and_m_t":"srs-CC-SetIndexlist","paragraph_zero_based":28753},{"literal_text_all_w_t_and_m_t":"A list of pairs of [cc-SetIndex; cc-IndexInOneCC-Set] (see TS 38.212 [17], TS 38.213 [13], clause 7.3.1, 11.4). The network does not configure this field for typeB.","paragraph_zero_based":28754},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28755},{"literal_text_all_w_t_and_m_t":"–SRS-Config","paragraph_zero_based":28756},{"literal_text_all_w_t_and_m_t":"The IE SRS-Config is used to configure sounding reference signal transmissions. The configuration defines a list of SRS-Resources, a list of SRS-PosResources, a list of SRS-PosResourceSets and a list of SRS-ResourceSets. Each resource set defines a set of SRS-Resources or SRS-PosResources. The network triggers the transmission of the set of SRS-Resources or SRS-PosResources using a configured aperiodicSRS-ResourceTrigger (L1 DCI). The network does not configure SRS specific power control parameters, alpha (without suffix), p0 (without suffix) or pathlossReferenceRS if unifiedTCI-StateType is configured for the serving cell.","paragraph_zero_based":28757},{"literal_text_all_w_t_and_m_t":"SRS-Config information element","paragraph_zero_based":28758},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28759},{"literal_text_all_w_t_and_m_t":"-- TAG-SRS-CONFIG-START","paragraph_zero_based":28760},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28761},{"literal_text_all_w_t_and_m_t":"SRS-Config ::=                          SEQUENCE {","paragraph_zero_based":28762},{"literal_text_all_w_t_and_m_t":"    srs-ResourceSetToReleaseList            SEQUENCE (SIZE(1..maxNrofSRS-ResourceSets)) OF SRS-ResourceSetId        OPTIONAL,   -- Need N","paragraph_zero_based":28763},{"literal_text_all_w_t_and_m_t":"    srs-ResourceSetToAddModList             SEQUENCE (SIZE(1..maxNrofSRS-ResourceSets)) OF SRS-ResourceSet          OPTIONAL,   -- Need N","paragraph_zero_based":28764},{"literal_text_all_w_t_and_m_t":"    srs-ResourceToReleaseList               SEQUENCE (SIZE(1..maxNrofSRS-Resources)) OF SRS-ResourceId              OPTIONAL,   -- Need N","paragraph_zero_based":28765},{"literal_text_all_w_t_and_m_t":"    srs-ResourceToAddModList                SEQUENCE (SIZE(1..maxNrofSRS-Resources)) OF SRS-Resource                OPTIONAL,   -- Need N","paragraph_zero_based":28766},{"literal_text_all_w_t_and_m_t":"    tpc-Accumulation                        ENUMERATED {disabled}                                                   OPTIONAL,   -- Need S","paragraph_zero_based":28767},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":28768},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":28769},{"literal_text_all_w_t_and_m_t":"    srs-RequestDCI-1-2-r16                  INTEGER (1..2)                                                          OPTIONAL, -- Need S","paragraph_zero_based":28770},{"literal_text_all_w_t_and_m_t":"    srs-RequestDCI-0-2-r16                  INTEGER (1..2)                                                          OPTIONAL, -- Need S","paragraph_zero_based":28771},{"literal_text_all_w_t_and_m_t":"    srs-ResourceSetToAddModListDCI-0-2-r16  SEQUENCE (SIZE(1..maxNrofSRS-ResourceSets)) OF SRS-ResourceSet          OPTIONAL, -- Need N","paragraph_zero_based":28772},{"literal_text_all_w_t_and_m_t":"    srs-ResourceSetToReleaseListDCI-0-2-r16 SEQUENCE (SIZE(1..maxNrofSRS-ResourceSets)) OF SRS-ResourceSetId        OPTIONAL, -- Need N","paragraph_zero_based":28773},{"literal_text_all_w_t_and_m_t":"    srs-PosResourceSetToReleaseList-r16     SEQUENCE (SIZE(1..maxNrofSRS-PosResourceSets-r16)) OF SRS-PosResourceSetId-r16","paragraph_zero_based":28774},{"literal_text_all_w_t_and_m_t":"                                                                                                                    OPTIONAL, -- Need N","paragraph_zero_based":28775}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["40880ff8a7d3d1dd0cdc63edafcdcd51afcf9bdda394c645d172961d98e94eb8","22d8143dab80afa50c79e862e585451276d1f14b3fe06e4c0a925cd10297a881","2fafe0b349c4d6aee258076c8d9593570b2074b3940655538530d132a4768c05","6d96988ab7e6e6a509715f8fdf402b2bb6285cc05e99ea0e8b49b2232ca6c3cb","ffea9249eb799dfea5913f3acee809becdf4564e704343c1b96b9b9876e6a209","d11854d4722afe185e792514b9a797951177e8285c28ea4a1253ecf532e41eee","39f4fe00841c956e493906fb8bea7d7d1d1ab87ad1d09e8685fa407ca3c3815a","2b1a1e2b33f41276659179127143e171ac84ce8ffa31585a41341b883a238c51","08c028117c80dc2470c41171ed950372398f13d727efbcd39f9c205cf70abc4c","f5d7236be784d52294f510e228f22e824c8bcd8875a9fa07724a87e2ea42ec8a","605c690714bbd5dc9511974913beb220667a87b68a5232b184ef0fc62dc3fdb1","9f626855ca349c4c14104592a7af3ad5525c157320d6b5e30985ac32bf025829","050cd42ec8d79ff8cc83e2f7b8eb8c3a0632b9bac72157285435efd57c5d9079","160e8151ecfc1cdfa7629a7631d491898f025b61680e41ed421f3774dd0db69f","cf3da0f425940b97b513717d592d582aa5ab9f09954f31e22835d3aaab854866","2fe80f4e2e65d799b73293e4ba52e2ba4ea72621445f972a9ad80ff8fcd05216","ba93851840c3270b7fd73a455988071d923bae0c5f69b429192874aca4a28c72","c0fb6345ea76c1f7ef057c5dfde41704f1e7aedeb7e8412fecfb70f4f385d61e","674fa551a799e57c46117a818c74dcfd18a186f77c0eccaf33f91e9e24926848","79ba29e71fe9036035c0bb4b9956d594a0040cd8bbce3a0371cf07ed1c1d3bf1","fb9e8847e4413db86b219b82b23162c1ac977cf709ccfe8afe5541df0129f9df","237ac1e6e38adcca66147f25e22f8e11d6735b85479