{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SlotFormatCombination ::=           SEQUENCE {","paragraph_zero_based":28032},{"literal_text_all_w_t_and_m_t":"    slotFormatCombinationId             SlotFormatCombinationId,","paragraph_zero_based":28033},{"literal_text_all_w_t_and_m_t":"    slotFormats                         SEQUENCE (SIZE (1..maxNrofSlotFormatsPerCombination)) OF INTEGER (0..255)","paragraph_zero_based":28034},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28035},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28036},{"literal_text_all_w_t_and_m_t":"SlotFormatCombinationId ::=         INTEGER (0..maxNrofSlotFormatCombinationsPerSet-1)","paragraph_zero_based":28037},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28038},{"literal_text_all_w_t_and_m_t":"-- TAG-SLOTFORMATCOMBINATIONSPERCELL-STOP","paragraph_zero_based":28039},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28040},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28041},{"literal_text_all_w_t_and_m_t":"SlotFormatCombination field descriptions","paragraph_zero_based":28042},{"literal_text_all_w_t_and_m_t":"slotFormatCombinationId","paragraph_zero_based":28043},{"literal_text_all_w_t_and_m_t":"This ID is used in the DCI payload to dynamically select this SlotFormatCombination (see TS 38.213 [13], clause 11.1.1).","paragraph_zero_based":28044},{"literal_text_all_w_t_and_m_t":"slotFormats","paragraph_zero_based":28045},{"literal_text_all_w_t_and_m_t":"Slot formats that occur in consecutive slots in time domain order as listed here (see TS 38.213 [13], clause 11.1.1 and TS 38.213 [13], clause 14 for IAB-MT).","paragraph_zero_based":28046},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28047},{"literal_text_all_w_t_and_m_t":"SlotFormatCombinationsPerCell field descriptions","paragraph_zero_based":28048},{"literal_text_all_w_t_and_m_t":"enableConfiguredUL","paragraph_zero_based":28049},{"literal_text_all_w_t_and_m_t":"If configured, the UE is allowed to transmit uplink signals/channels (SRS, PUCCH, CG-PUSCH) in the set of symbols of the slot when the UE does not detect a DCI format 2_0 providing a slot format for the set of symbols (see TS 38.213 [13], 11.1.1). This field is applicable only if cg-RetransmissionTimer-r16 is configured.","paragraph_zero_based":28050},{"literal_text_all_w_t_and_m_t":"positionInDCI","paragraph_zero_based":28051},{"literal_text_all_w_t_and_m_t":"The (starting) position (bit) of the slotFormatCombinationId (SFI-Index) for this serving cell (servingCellId) within the DCI payload (see TS 38.213 [13], clause 11.1.1).","paragraph_zero_based":28052},{"literal_text_all_w_t_and_m_t":"servingCellId","paragraph_zero_based":28053},{"literal_text_all_w_t_and_m_t":"The ID of the serving cell for which the slotFormatCombinations are applicable.","paragraph_zero_based":28054},{"literal_text_all_w_t_and_m_t":"slotFormatCombinations","paragraph_zero_based":28055}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["fbffd00bda9c9e9858433622a8e5911128482a138d0f7ff316c452e56c880d1f","a3a26686acbb04ae5d3fc1465b5213b8cc882d428ff5086baee44a2bfc55af94","0a2e39d17c6024aa3aea4662de7b2b9402cfb554abe8f0b5317853351ea0c7c1","9fa3385f145bcf200d3d2ca6c281c38f5f68f765fc8ace67ef378eef598640bf","55c741054b911e0f66ce2806a5b1642aec52e82baad4a73fd91aa197f1bb9432","75f383f00762641ea44c4316adbee28d2f0589481561ac26562a74b96721e522","dcad46d537bdfded345cdb6de33e84bbc9f6e903c4c21a66f83e16aa8efab8d5","9fea1b722b437b55eca3aa06b12d617e2e468f80c22b1dd