{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SIB-TypeInfo-v1700 ::=              SEQUENCE {","paragraph_zero_based":28296},{"literal_text_all_w_t_and_m_t":"    sibType-r17                         CHOICE {","paragraph_zero_based":28297},{"literal_text_all_w_t_and_m_t":"        type1-r17                           ENUMERATED {sibType15, sibType16, sibType17, sibType18, sibType19, sibType20, sibType21,","paragraph_zero_based":28298},{"literal_text_all_w_t_and_m_t":"                                                        spare9, spare8, spare7, spare6, spare5, spare4, spare3, spare2, spare1,...},","paragraph_zero_based":28299},{"literal_text_all_w_t_and_m_t":"        type2-r17                           SEQUENCE {","paragraph_zero_based":28300},{"literal_text_all_w_t_and_m_t":"            posSibType-r17                      ENUMERATED {posSibType1-9, posSibType1-10, posSibType2-24, posSibType2-25,","paragraph_zero_based":28301},{"literal_text_all_w_t_and_m_t":"                                                            posSibType6-4, posSibType6-5, posSibType6-6, spare9, spare8, spare7, spare6,","paragraph_zero_based":28302},{"literal_text_all_w_t_and_m_t":"                                                            spare5, spare4, spare3, spare2, spare1,...},","paragraph_zero_based":28303},{"literal_text_all_w_t_and_m_t":"            encrypted-r17                       ENUMERATED { true }                                     OPTIONAL, -- Need R","paragraph_zero_based":28304},{"literal_text_all_w_t_and_m_t":"            gnss-id-r17                         GNSS-ID-r16                                             OPTIONAL, -- Need R","paragraph_zero_based":28305},{"literal_text_all_w_t_and_m_t":"            sbas-id-r17                         SBAS-ID-r16                                             OPTIONAL  -- Need R","paragraph_zero_based":28306},{"literal_text_all_w_t_and_m_t":"        }","paragraph_zero_based":28307},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":28308},{"literal_text_all_w_t_and_m_t":"    valueTag-r17                            INTEGER (0..31)                                             OPTIONAL, -- Cond NonPosSIB","paragraph_zero_based":28309},{"literal_text_all_w_t_and_m_t":"    areaScope-r17                           ENUMERATED {true}                                           OPTIONAL  -- Need S","paragraph_zero_based":28310},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28311},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28312},{"literal_text_all_w_t_and_m_t":"-- TAG-SI-SCHEDULINGINFO-STOP","paragraph_zero_based":28313},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28314},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28315},{"literal_text_all_w_t_and_m_t":"SchedulingInfo field descriptions","paragraph_zero_based":28316},{"literal_text_all_w_t_and_m_t":"areaScope","paragraph_zero_based":28317},{"literal_text_all_w_t_and_m_t":"Indicates that a SIB is area specific. If the field is absent, the SIB is cell specific.","paragraph_zero_based":28318},{"literal_text_all_w_t_and_m_t":"si-BroadcastStatus","paragraph_zero_based":28319}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["0aecf1c6b309bbf95615ea51f2074a48ca40b26b7b33f42fdcd7d3d14215ad7a","1f703b4b5335b0e0581823603ab7e7e7e4655b784f45fd5594b2a370100f4a02","373be369545ac463a2b211fe7d5c3076ebf819e4ee9fcb7c1242512fd8ba0047","c2768d11284287e8951efcfe881b1f9b04b35e2ae2a4c29c767f3d25a8392502","1ee4d24b4459a26270e88c0c255f9da2aed777194f753fcaf295a66637e70e83","ffd6f39825d68287ee23924463b2abc0c5d55aa2eaaab0b8f432f8fb86209872","7b422f0203261285a1c24dc8a99c280f813febe4f8f1d332e6f02035ecd3d3bc","6cfbff04c3bd568fc80bb6adae84b61a73a49a57136a244adb287d99de866abb","71e0ab19fef1d612551cf0dac37a89dfaf141bc70ae7b8bf07786cd734b0631a","07a21311653b1f23bc9a08d59b0b0c2ba63dc00f06e9961fc64ab7f82b52199d","3f4d8e3a437f68b7e3ae54e70e7de49cd1d31bcc67182ab994eaf2a8e203a9e8","e1c0963ed158ef2ba7172552fad6ed32fd61e2f601df84d85aa9cd360393e199","eb0dda3cd4574d8bbdececa7494aca1b5af7c91fc3e9d04b42e39c9040135626","6929996ba32f5f30dc9805ba1ec8c8001dbe2f4cf735db58a9a1946ed6a4b198","0b26aa31bbb8ddd58c1f0a6fc6290d23b45a8f6f64e617f5bc9007ff5eba16a3","a4f77103c9f82159729ce89acec2fed58ecdd63d9d05a08146d3400caa449e89","e5dd24f19f74eabc0232cd575734193f9bbfe85781b9d9f226dcb97e16902022","58e9677fd84ce8e437e1153d519e76aa00d07f5f98186eaa15696315958ebd23","62c309877d0e4642d4ebe3c003ae948d648e717247d5075f3cc9e0227e0f061a","0421bd1b9732dc1b333ccaad0dee210f370275aad67a174a60fd88a3d5f29b5a","9992d70f960cbc2c2f6b7c2d95bd9127f3381f1473a80d9e21ab55df1a1277ed","d22b6705b54e2e79df1065840baf98718637483674c58b978fe2870bd4056185","8c7c7033c81fb5a697128d2f5f2e973a99d8782eb77357b06b9853c447664d6a","ea3f904e8c9b0c7a0bf219414398b14b9c41845209b3b5a00aa6660cbe627af4"],"paragraph_range_zero_based":[28296,28319],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p28296"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates if the SI message is being broadcasted or not. Change of si-BroadcastStatus should not result in system information change notifications in Short Message transmitted with P-RNTI over DCI (see clause 6.5). The value of the indication is valid until the end of the BCCH modification period when set to broadcasting. When SIB19 is scheduled, the si-BroadcastStatus for the mapped SIB19 is set to broadcasting.","paragraph_zero_based":28320},{"literal_text_all_w_t_and_m_t":"If si-SchedulingInfo-v1700 is present, the network ensures that the total number of SI messages with si-BroadcastStatus set to notBroadcasting in the list of concatenated SI messages configured by schedulingInfoList in si-SchedulingInfo and SI messages containing type1 SIB configured by schedulingInfoList2 in si-SchedulingInfo-v1700 does not exceed the limit of maxSI-Message when si-RequestConfig, si-RequestConfigRedCap or si-RequestConfigSUL is configured.","paragraph_zero_based":28321},{"literal_text_all_w_t_and_m_t":"si-Periodicity","paragraph_zero_based":28322},{"literal_text_all_w_t_and_m_t":"Periodicity of the SI-message in radio frames. Value rf8 corresponds to 8 radio frames, value rf16 corresponds to 16 radio frames, and so on.","paragraph_zero_based":28323},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28324},{"literal_text_all_w_t_and_m_t":"SI-SchedulingInfo field descriptions","paragraph_zero_based":28325},{"literal_text_all_w_t_and_m_t":"dummy","paragraph_zero_based":28326},{"literal_text_all_w_t_and_m_t":"This field is not used in this specification. If received, it is ignored by the UE.","paragraph_zero_based":28327},{"literal_text_all_w_t_and_m_t":"si-RequestConfig","paragraph_zero_based":28328},{"literal_text_all_w_t_and_m_t":"Configuration of Msg1 resources that the UE uses for requesting SI-messages for which si-BroadcastStatus is set to notBroadcasting.","paragraph_zero_based":28329},{"literal_text_all_w_t_and_m_t":"si-RequestConfigRedCap","paragraph_zero_based":28330},{"literal_text_all_w_t_and_m_t":"Configuration of Msg1 resources for initialUplinkBWP-RedCap that the RedCap UE uses for requesting SI-messages for which si-BroadcastStatus is set to notBroadcasting.","paragraph_zero_based":28331},{"literal_text_all_w_t_and_m_t":"si-RequestConfigSUL","paragraph_zero_based":28332},{"literal_text_all_w_t_and_m_t":"Configuration of Msg1 resources that the UE uses for requesting SI-messages for which si-BroadcastStatus is set to notBroadcasting.","paragraph_zero_based":28333},{"literal_text_all_w_t_and_m_t":"si-WindowLength","paragraph_zero_based":28334},{"literal_text_all_w_t_and_m_t":"The length of the SI scheduling window. Value s5 corresponds to 5 slots, value s10 corresponds to 10 slots and so on. The network always configures si-WindowLength to be shorter than or equal to the si-Periodicity. The values s2560-v1710 and s5120-v1710 are only applicable for SCS 480 kHz.","paragraph_zero_based":28335},{"literal_text_all_w_t_and_m_t":"systemInformationAreaID","paragraph_zero_based":28336},{"literal_text_all_w_t_and_m_t":"Indicates the system information area that the cell belongs to, if any. Any SIB with areaScope within the SI is considered to belong to this systemInformationAreaID. The systemInformationAreaID is unique within a PLMN/SNPN.","paragraph_zero_based":28337},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28338},{"literal_text_all_w_t_and_m_t":"SchedulingInfo2 field descriptions","paragraph_zero_based":28339},{"literal_text_all_w_t_and_m_t":"encrypted","paragraph_zero_based":28340},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that the pos-sib-type is encrypted as specified in TS 37.355 [49].","paragraph_zero_based":28341},{"literal_text_all_w_t_and_m_t":"gnss-id","paragraph_zero_based":28342},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that the positioning SIB type is for a specific GNSS. Indicates a specific GNSS (see also TS 37.355 [49])","paragraph_zero_based":28343}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["6a69aa395db1fa985f20244366cc068e3583bb66e4068a579d1ef59f9d06c510","ad1f030b90da1f6440e11c1ab274db462f7a135511c0722f6b7cfffa83e8480d","809f352d5d427f0c54ea953fbe295e6a73a240916ce28edd7e39bcd5f9ecef78","d456d33f618cb93e47c3d9dde97b0fc3ab747bc41d3f8e665c4301342455265f","f1cd16f54188a150a1fc51d9fc5cb8238fde1ba0ea48d3b7bb097a671b6d72d1","51605016ee207e72a64adab8abd178a535b8881041f8ddd1ee5a8cd807ba00fc","afc195301517d9dbb3440f2f2a013d452ecd8c42feeaacd4e487df6e384b5d0c","a1250b69d2805e1e190b972863c0796e84ade53fc44c8aee2dbaf1843c43b554","e6218faffa5b4f8030dd292440205cb95293088e405b8f04ca62708a7aec7290","8e8dbbaff4963c0f62f98a858809fb08f0288c1057ce853205a4f9a421344d64","0caeb53479dc64e38bd721e9ff1afbc8b9e76942d87a40e0c1ce960d76d1263c","6994ee176d3d9aed7532137857baacd3ac655728c278f08ce12db1d90c87de38","4ed43db8551ba6654bb1b2f21e1e4ae609f3b6dd035aa4d94ccaf86f382dc65d","2a1762a9f61761082d4f7aa6a9e8c72651f019b1926d623107ae24d947a6a1dd","e3bc316790d4d95643d25381701605339ef55894816269aa32bb35336be5f9c1","3b68d9166dd310da4cb183dd5fab009c5f8e204e679021065c2ca4d367cef347","76f0ffd43c41ba304ce8f1f8d67eb121145271196a2af228e8d195bd5d243b3c","a774d162dd03f69ad5d0292a41337363cbe5e8db4e865529fd63981aa9a301d1","c1c2366afb10b56dd2f09d032a5099a593b97de1715f3c8c41a16fa3015617d0","94c662506eece69834d7cae808c800428ad39a4c0c9d9c9786f3f0d5e27b9ae3","5ca5620a69fe207304c779ebc40173dcbb22d80bfa8a8fcc2b53ec83ffa7269a","b142e12036422e69574c1a31c564edf44cebb05d8697d0f158fab6bf51674e5f","e851195cb9a87c568853bd74d9a6c3f1abf3430bfdab5e8b3cffa35870fd2bf0","35095ae75fb32f0d7b2bc3a31a69444af0d5cbe9f973aea84720b05ededaf282"],"paragraph_range_zero_based":[28320,28343],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p28320"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"posSibType","paragraph_zero_based":28344},{"literal_text_all_w_t_and_m_t":"The posSIBs as defined in TS 37.355 [49] mapped to SI for scheduling using schedulingInfoList2. ","paragraph_zero_based":28345},{"literal_text_all_w_t_and_m_t":"sbas-id","paragraph_zero_based":28346},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that the positioning SIB type is for a specific SBAS. Indicates a specific SBAS (see also TS 37.355 [49]).","paragraph_zero_based":28347},{"literal_text_all_w_t_and_m_t":"si-WindowPosition","paragraph_zero_based":28348},{"literal_text_all_w_t_and_m_t":"This field indicates the SI window position of the associated SI-message. The network provides si-WindowPosition in an ascending order, i.e. si-WindowPosition in the subsequent entry in schedulingInfoList2 has always value higher than in the previous entry of schedulingInfoList2. The network configures this field in a way that ensures that SI messages scheduled by schedulingInfoList and/or posSchedulingInfoList do not overlap with SI messages scheduled by schedulingInfoList2.","paragraph_zero_based":28349},{"literal_text_all_w_t_and_m_t":"sib-MappingInfo","paragraph_zero_based":28350},{"literal_text_all_w_t_and_m_t":"Indicates which SIBs or posSIBs are contained in the SI message.","paragraph_zero_based":28351},{"literal_text_all_w_t_and_m_t":"sibType","paragraph_zero_based":28352},{"literal_text_all_w_t_and_m_t":"The type of SIB(s) mapped to SI for scheduling using schedulingInfoList2. Value type1 indicates SIBs and value type2 indicates posSIBs.","paragraph_zero_based":28353},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28354},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":28355},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":28356},{"literal_text_all_w_t_and_m_t":"MSG-1","paragraph_zero_based":28357},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if si-BroadcastStatus is set to notBroadcasting for any SI-message included in schedulingInfoList or any SI-message containing type1 SIB included in schedulingInfoList2. It is absent otherwise.","paragraph_zero_based":28358},{"literal_text_all_w_t_and_m_t":"SIB-TYPE","paragraph_zero_based":28359},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the SIB type is different from SIB6, SIB7 or SIB8. For SIB6, SIB7 and SIB8 it is absent.","paragraph_zero_based":28360},{"literal_text_all_w_t_and_m_t":"NonPosSIB","paragraph_zero_based":28361},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the SIB type is type1. For type2 it is absent.","paragraph_zero_based":28362},{"literal_text_all_w_t_and_m_t":"SUL-MSG-1","paragraph_zero_based":28363},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if supplementaryUplink is configured in ServingCellConfigCommonSIB and if si-BroadcastStatus is set to notBroadcasting for any SI-message included in schedulingInfoList or any SI-message containing type1 SIB included in schedulingInfoList2. It is absent otherwise.","paragraph_zero_based":28364},{"literal_text_all_w_t_and_m_t":"REDCAP-MSG-1","paragraph_zero_based":28365},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if initialUplinkBWP-RedCap is configured in UplinkConfigCommonSIB and if si-BroadcastStatus is set to notBroadcasting for any SI-message included in schedulingInfoList or any SI-message containing type1 SIB included in schedulingInfoList2. It is absent otherwise.","paragraph_zero_based":28366},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28367}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d95