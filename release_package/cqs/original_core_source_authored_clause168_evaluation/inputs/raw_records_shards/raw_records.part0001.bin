sed":260},{"literal_text_all_w_t_and_m_t":"SCell Activation/Deactivation (four octets)","paragraph_zero_based":261},{"literal_text_all_w_t_and_m_t":"58","paragraph_zero_based":262},{"literal_text_all_w_t_and_m_t":"SCell Activation/Deactivation (one octet)","paragraph_zero_based":263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9006a5e4d405d2bab4da8adbe85c8c54348a814c5ca98f37bc600850b83d6866","original_member_sha256":"d5d414423b1048f375344cb48c2ef975c9c8e9f4329d79a9fea35e05ea08452c","paragraph_ElementTree_utf8_XML_sha256":["87e77541f507c13aa39762257a0bb28cdbbad8671bed53afe1dc32e41d80ea88","26a4c5a522a1a1664967df937801f506765829dc082e5260dc102d4dd7746512","7434199015dcf3c1e2d663e7b7bfd6a83106e83956a38c91cb74494be7ba7722","cd0a46c9eb59d48bf5ee57bcd49fbf12d9c03f4d00cf5a0fc8371bbadebe169f","af61c828600dd37b0966a9387559603a0595882bf1c19c8ce0724189004cb9ff","e13f8c84aa68bf565defd3e8edaced30115c792560e44e8cadbe024d6d7dfd5c","b7acd4dcc238f76a5a6fc468b9838cc874a792cd37a6057bb23306de4947573f","5470b2c3cbe647cdf0a5b1df9c4babd31e3dcc5ae8ce1599bcb0ae3e1c5a8d80","f22a65e011b0be8e97a86bf6bdeb44fa4d56965d45bc5f5b0f864eacca70c27c","9299ca26e033208f8a302c163fa1ff895f5a6ff621dd8a4fcd58086bf922ce14","9b96a2cca6a59fa539a262885e118bbf9cccfc2a69cc8ef6b712175bbaf19f14","982db256e335d65512b69bb49545bb054e3553beeb4f1c129627c4e6bfcdb238","b20e2af9127e590ef651e4235d1b7e90c0579c79465852a4681ab4bdbf8831f9","a893f4be8fd7a15a4939ad5ebcd39ab2966fdb7a69e5b4030c7de2465ab196b5","612460ddcfc34b03c7a71944ef8312288b8400367fec0ca471aa76b979fbe5c5","08efb0e1a2bef4f908aa3fea96935223cf61441ed3398e1d3ee7a35025abdcbb","4fb2502dccf5f796af26f4399f505eceb99ed172bcedd06a18e5a15f8866b9d7","085080c0710d93a0503ec00936457ca9e4233113393fef601ae1df7846b60e12","9226eb894d51788476fd4416d9c23e3d91d479edd940e12b285a2ca906d868f1","e46afe54085a49458b1b988f06120ab13c40ac3693e97ed42896a05c199acc54","0c4ec99acd498a901048b