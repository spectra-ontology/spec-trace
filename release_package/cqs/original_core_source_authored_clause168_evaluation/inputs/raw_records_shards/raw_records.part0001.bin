{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    trackingAreaCode-r16             TrackingAreaCode","paragraph_zero_based":36696},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":36697},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36698},{"literal_text_all_w_t_and_m_t":"-- TAG-AREACONFIGURATION-STOP","paragraph_zero_based":36699},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36700},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36701},{"literal_text_all_w_t_and_m_t":"AreaConfiguration field descriptions","paragraph_zero_based":36702},{"literal_text_all_w_t_and_m_t":"InterFreqTargetInfo","paragraph_zero_based":36703},{"literal_text_all_w_t_and_m_t":"If configured, it indicates the neighbouring frequency and cells for which UE is requested to perform measurement logging. It can include sync raster or non-sync raster frequencies.","paragraph_zero_based":36704},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36705},{"literal_text_all_w_t_and_m_t":"–BT-NameList","paragraph_zero_based":36706},{"literal_text_all_w_t_and_m_t":"The IE BT-NameList is used to indicate the names of the Bluetooth beacon which the UE is configured to measure.","paragraph_zero_based":36707},{"literal_text_all_w_t_and_m_t":"BT-NameList information element","paragraph_zero_based":36708},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36709},{"literal_text_all_w_t_and_m_t":"-- TAG-BTNAMELIST-START","paragraph_zero_based":36710},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36711},{"literal_text_all_w_t_and_m_t":"BT-NameList-r16 ::=                SEQUENCE (SIZE (1..maxBT-Name-r16)) OF BT-Name-r16","paragraph_zero_based":36712},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36713},{"literal_text_all_w_t_and_m_t":"BT-Name-r16 ::=                    OCTET STRING (SIZE (1..248))","paragraph_zero_based":36714},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36715},{"literal_text_all_w_t_and_m_t":"-- TAG-BTNAMELIST-STOP","paragraph_zero_based":36716},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36717},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36718},{"literal_text_all_w_t_and_m_t":"BT-NameList field descriptions","paragraph_zero_based":36719}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["493c5898eb087b483650edfbee6ce14fb650556f0c240a7665e232dd0b7011f9","bbf9a5ef1ac23e067cc44907984dd64852e3e0cde84794eb8126e1a5f0f76768","c76ff2f4a655ba1444d5934282c65932807ac44e9142a379361db085dfb7caef","1d7f3809f4b01da16d65e1955ff9bdce6b0ac954c0828d002bf9c8291781f579","2b87d420edd25a183af29a02b891a2e589f91aa0920dc0658d7ba824ccec7ebc","fe30f47e54d2c8ae01e9745a50eccc697e80c236e34e7930904031f2197b8444","7e825513af3c424a2b477ae2695f222ff1504a13bf9e6804c2b9b286cdfe1247","2b39ccdca720ecaad2a67f859b23148684eadfb33d81904f153621db97c124d3","562258404bf591e53e356b16af709f3628d6cebe234c1b8680f7bcd8d2458767","9454792959e53e40dad8a5844edf8272f0f0f6d45c929c17e4b20a1bc2acfa6f","64f45f915f8baada98daf1aaca61751cb5d7537c71678baccbae993321eabe65","89d1a97d6a4908f52ebe007e59c4904f708bc3deeb78e41dc86be72f372a8326","e00ab1582978dcac79af77217550146319e33e1108fdff449f1d882551de4e0c","18ebaaf28b05cd4ba39a442a32c7b2b9deba12ec9ceb19806732e5806b3e241c","c35e00032ce7daea2f26fe4afeabf5e90589efb72e9bb925439e83bddc4f3c64","e0b7c1447862ccdde6a474ce8a793a623ae5ad3ced52151554b3a46cc80d9b02","9421456b11171d233925ca79b8b4f3404d199829925d291b613acd74535fe899","049fea19e2d4f8a47ef746543b64c40d4b13add768c6ad5f5d61b21a89931869","36c2d9d6cb3d5629686c0696408d3f587b4dd7787eb41ea5ffc13b0ec08ecffc","8514e28140b340a9fdb7fd03bbb681871d761dd03c2b885d22d7e7b75655ad46","8e3323d2ae4480f2e437613ec0a5453fb6fc8b411453edf06006c303cdefde3d","6c8b7d73c2bdf6fc50c476e169d725d613d38c284dd1008a28bb75acaef6ce6a","0c91d72e372e19d30a9dfabfc997d4baf5e2c094f508420a7052686c98793e83","2844e06c1b292d80e5dc04080de048d7e573591708bc30518bb978bd90a5b0bc"],"paragraph_range_zero_based":[36696,36719],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p36696"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"bt-Name","paragraph_zero_based":36720},{"literal_text_all_w_t_and_m_t":"If configured, the UE only performs Bluetooth measurements according to the names identified. For each name, it refers to LOCAL NAME defined in Bluetooth specification [51].","paragraph_zero_based":36721},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36722},{"literal_text_all_w_t_and_m_t":"–DedicatedInfoF1c","paragraph_zero_based":36723},{"literal_text_all_w_t_and_m_t":"The IE DedicatedInfoF1c is used to transfer IAB-DU specific F1-C related information between the network and the IAB node. The carried information consists of F1AP message encapsulated in SCTP/IP or F1-C related (SCTP)/IP packet, see TS 38.472 [64]. The RRC layer is transparent for this information.","paragraph_zero_based":36724},{"literal_text_all_w_t_and_m_t":"DedicatedInfoF1c information element","paragraph_zero_based":36725},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36726},{"literal_text_all_w_t_and_m_t":"-- TAG-DEDICATEDINFOF1C-START","paragraph_zero_based":36727},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36728},{"literal_text_all_w_t_and_m_t":"DedicatedInfoF1c-r17 ::=        OCTET STRING","paragraph_zero_based":36729},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36730},{"literal_text_all_w_t_and_m_t":"-- TAG-DEDICATEDINFOF1C-STOP","paragraph_zero_based":36731},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36732},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36733},{"literal_text_all_w_t_and_m_t":"–EUTRA-AllowedMeasBandwidth","paragraph_zero_based":36734},{"literal_text_all_w_t_and_m_t":"The IE EUTRA-AllowedMeasBandwidth is used to indicate the maximum allowed measurement bandwidth on a carrier frequency as defined by the parameter Transmission Bandwidth Configuration \"NRB\" in TS 36.104 [33]. The values mbw6, mbw15, mbw25, mbw50, mbw75, mbw100 indicate 6, 15, 25, 50, 75 and 100 resource blocks, respectively.","paragraph_zero_based":36735},{"literal_text_all_w_t_and_m_t":"EUTRA-AllowedMeasBandwidth information element","paragraph_zero_based":36736},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36737},{"literal_text_all_w_t_and_m_t":"-- TAG-EUTRA-ALLOWEDMEASBANDWIDTH-START","paragraph_zero_based":36738},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36739},{"literal_text_all_w_t_and_m_t":"EUTRA-AllowedMeasBandwidth ::=              ENUMERATED {mbw6, mbw15, mbw25, mbw50, mbw75, mbw100}","paragraph_zero_based":36740},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36741},{"literal_text_all_w_t_and_m_t":"-- TAG-EUTRA-ALLOWEDMEASBANDWIDTH-STOP","paragraph_zero_based":36742},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36743}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["4765db099bc2ac67cef78f4968d51e11e7cd9f326cd5897abec0bec1c1d29475","474520c77d44d1a7c8823ec46a142b20b9d0ff90364ed7d74f0b5739f46607a8","1d248f968a7cfeaa01ad8e8b4070c41666c98c48b9967691d203b8620c2952d4","35bdbf8f6fd0a8334a79fd5851b85a55ae6e26f3a611b970ac97a598b492a13b","0e2a10bbc820d42fdaa8f69459baf76f3bdc11720f61e85028f758b35850e319","8471ec45ccd287727454a2b312fdf47d2ecee2c2a22754296108d6819dc41d74","b2cf451b4f318eb850f669085487e70bc692415a0d54cff6708cd430b769c420","2dfb1228f0761c12095ea66010f0ef9eb7bcf3e5397550a80e534e1a10fcd545","d25945c5557c0c2a0d3ac15f50c8b4d1a3a51281a857cbe0010b6996f678f24a","49c58d75ddf68e8c4391316426157d15c791e4c15a239cf988f5cb56ab511b87","