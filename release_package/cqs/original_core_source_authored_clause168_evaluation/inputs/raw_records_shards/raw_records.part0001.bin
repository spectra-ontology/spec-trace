b914e666b1b6ddf981a6e2f50d3cd96a8759ebb3b9","028108bf945fca57e488053b6a5048997634461225798684ebc9e810a497ca1d","e26fd610e8a6e867fe573b26460adf374f0a17bef028b0b5f721e7e1163bb763","d8fcae543fe965aa298e9e1db43b416c598dbca793bd653b98fe88ea830236f7","e85eaedb9aa1eca9d85759dae472aa5037659f68d03cdcab25c2f7dd156a0ff5","a3f2c66ab942c04386cb751fc561930de51ca3535092d52df6de03e72642c9fe","cdeb3be30f429912dc4da2016899fcc918c2ced4ccdd891c9218c65fc4395505","01f51371d004dbb19eb1038b9c9afa54bc7a9f98fa42598242e96ea8b8484657","31d1679bb6e3451909680bb55ee0c3ecf2af9d607b97fd41c52aea82b25ad0e5","b4e0e1c6c43d8f077cd144645d2c5242ed861f6c2d5cf23cd5b4a533f707fd89","364f5c70c1b570e1d1817362e2005f37edd804feb5749a18b96afe580fd783df","bf8f0ed3ef1d5c6d11f7a66af00f4210b671f42beaaf25ab51c143d09f4dd962","1a9493e9f25cfe71686da6e5932c6242d0ab2c9a9d15d16eff21ab7ae10f2c18","a39d72528e42e046af87734c2a5beea09233b1fb7a6d3b27cbd4ebdf1eb29d23","4c7d31140d32974fc5b69831f6000dda4bd19694e194f6dccfc4f1f5dc7c8ee2","c5b8fcde7eed97af110bc5f15a1c0be77a70db381a8b3d6871bb87fcbd17f868","8a8f83c2fca1eae926d1d17cbfa5e7c43eb1dd8047b24099243f802a49d8f97d","675af733f653ee12e12bf73a88a49fbc6adee48642ceb7f7903664f1f222a285"],"paragraph_range_zero_based":[216,239],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2401275.zip::R2-2401275 Introduction of two QCL-TypeD properties identification and monitoring.docx:p216"}
{"fields":{"filename":"R2-2401275.zip::R2-2401275 Introduction of two QCL-TypeD properties identification and monitoring.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":240},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":241},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":242},{"literal_text_all_w_t_and_m_t":"<<<<Start of the 2nd Change>>>>","paragraph_zero_based":243},{"literal_text_all_w_t_and_m_t":"PhysicalCellGroupConfig field descriptions","paragraph_zero_based":244},{"literal_text_all_w_t_and_m_t":"ackNackFeedbackMode","paragraph_zero_based":245},{"literal_text_all_w_t_and_m_t":"Indicates which among the joint and separate ACK/NACK feedback modes to use within a slot as specified in TS 38.213 [13] (clause 9).","paragraph_zero_based":246},{"literal_text_all_w_t_and_m_t":"bdFactorR","paragraph_zero_based":247},{"literal_text_all_w_t_and_m_t":"Parameter for determining and distributing the maximum numbers of BD/CCE for mPDCCH based mPDSCH transmission as specified in TS 38.213 [13] Clause 10.1.","paragraph_zero_based":248},{"literal_text_all_w_t_and_m_t":"cs-RNTI","paragraph_zero_based":249},{"literal_text_all_w_t_and_m_t":"RNTI value for downlink SPS (see SPS-Config) and uplink configured grant (see ConfiguredGrantConfig).","paragraph_zero_based":250},{"literal_text_all_w_t_and_m_t":"downlinkAssignmentIndexDCI-0-2","paragraph_zero_based":251},{"literal_text_all_w_t_and_m_t":"Indicates if \"Downlink assignment index\" is present or absent in DCI format 0_2. If the field \"downlinkAssignmentIndexDCI-0-2\" is absent, then 0 bit for \"Downlink assignment index\" in DCI format 0_2. If the field \"downlinkAssignmentIndexDCI-0-2\" is present, then the bitwidth of \"Downlink assignment index\" in DCI format 0_2 is defined in the same was as that in DCI format 0_1 (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13], clause 9.1).","paragraph_zero_based":252},{"literal_text_all_w_t_and_m_t":"downlinkAssignmentIndexDCI-1-2","paragraph_zero_based":253},{"literal_text_all_w_t_and_m_t":"Configures the number of bits for \"Downlink assignment index\" in DCI format 1_2. If the field is absent, then 0 bit is applied for \"Downlink assignment index\" in DCI format 1_2. Note that 1 bit and 2 bits are applied if only one serving cell is configured in the DL and pdsch-HARQ-ACK-Codebook is set to dynamic. 4 bits is applied if more than one serving cell are configured in the DL and pdsch-HARQ-ACK-Codebook is set to dynamic (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13], clause 9.1).","paragraph_zero_based":254},{"literal_text_all_w_t_and_m_t":"harq-ACK-SpatialBundlingPUCCH","paragraph_zero_based":255},{"literal_text_all_w_t_and_m_t":"Enables spatial bundling of HARQ ACKs. It is configured per cell group (i.e. for all the cells within the cell group) for PUCCH reporting of HARQ-ACK. It is only applicable when more than 4 layers are possible to schedule. When the field is absent, the spatial bundling of PUCCH HARQ ACKs for the primary PUCCH group is disabled (see TS 38.213 [13], clause 9.1.2.1). If the field harq-ACK SpatialBundlingPUCCH-secondaryPUCCHgroup is present, harq-ACK-SpatialBundlingPUCCH is only applied to primary PUCCH group. Network does not configure for a UE both spatial bundling of HARQ ACKs and codeBlockGroupTransmission within the same cell group.","paragraph_zero_based":256},{"literal_text_all_w_t_and_m_t":"harq-ACK-SpatialBundlingPUCCH-secondaryPUCCHgroup","paragraph_zero_based":257},{"literal_text_all_w_t_and_m_t":"Indicates whether spatial bundling of PUCCH HARQ ACKs for the secondary PUCCH group is enabled or disabled. The field is only applicable when more than 4 layers are possible to schedule (see TS 38.213 [13], clause 9.1.2.1). When the field is absent, the use of spatial bundling of PUCCH HARQ ACKs for the secondary PUCCH group is indicated by harq-ACK-SpatialBundlingPUCCH. See TS 38.213 [13], clause 9.1.2.1. Network does not configure for a UE both spatial bundling of HARQ ACKs and codeBlockGroupTransmission within the same cell group.","paragraph_zero_based":258},{"literal_text_all_w_t_and_m_t":"harq-ACK-SpatialBundlingPUSCH","paragraph_zero_based":259},{"literal_text_all_w_t_and_m_t":"Enables spatial bundling of HARQ ACKs. It is configured per cell group (i.e. for all the cells within the cell group) for PUSCH reporting of HARQ-ACK. It is only applicable when more than 4 layers are possible to schedule. When the field is absent, the spatial bundling of PUSCH HARQ ACKs for the primary PUCCH group is disabled (see TS 38.213 [13], clauses 9.1.2.2 and 9.1.3.2). If the field harq-ACK SpatialBundlingPUSCH-secondaryPUCCHgroup is present, harq-ACK-SpatialBundlingPUSCH is only applied to primary PUCCH group. Network does not configure for a UE both spatial bundling of HARQ ACKs and codeBlockGroupTransmission within the same cell group.","paragraph_zero_based":260},{"literal_text_all_w_t_and_m_t":"harq-ACK-SpatialBundlingPUSCH-secondaryPUCCHgroup","paragraph_zero_based":261},{"literal_text_all_w_t_and_m_t":"Indicates whether spatial bundling of PUSCH HARQ ACKs for the secondary PUCCH group is enabled or disabled. The field is only applicable when more than 4 layers are possible to schedule (see TS 38.213 [13], clauses 9.1.2.2 and 9.1.3.2). When the field is absent, the use of spatial bundling of PUSCH HARQ ACKs for the secondary PUCCH group is indicated by harq-ACK-SpatialBundlingPUSCH. See TS 38.213 [13], clauses 9.1.2.2 and 9.1.3.2. Network does not configure for a UE both spatial bundling of HARQ ACKs and codeBlockGroupTransmission within the same cell group.","paragraph_zero_based":262},{"literal_text_all_w_t_and_m_t":"intraBandNC-PRACH-simulTx","paragraph_zero_based":263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9ef79a4eb2cc359be77b260df29ccfb41d1690d829d9f72664c79151548c2096","original_member_sha256":"e0a2c9353da6a7184b58797c60442cdf9a142252349ae303a56438bc61293dd7","paragraph_ElementTree_utf8_XML_sha256":["e2c4eb7bdc77f6540e8f2bfd877ae865e1ea8b6bf37db02782c3c73fed7c2e2c","2a65c4f9374a10f8a3193837b1895725e7c4ad27ef2099aa159ca5b6626a6fe6","63466f08e7d65364ee180c05330a7b939d71eeab597c4f92d0886b0214856bd5","47e3ffd45455f94c7c0ce607336dacf4cb1d14336f5bf3f3fbce3c5cfe400bc3","665b22675c16625b372eae4cd1bea206f30a689ace5caf2bc9e34ccbb4a17139","17e86fc8ae2799057715b9fb304737c86999aea99be987f5a603d2528bae036b","5aab740bcf020315ecf2e90a2cc1eac1dc48c4a41119decbed8f246fd18a5a3b","37a8780b3b7e9cbfa69e0c66764b66b6427ca7440bc6550f25cca6690123e207","854bd5e4a886e3b8a8914d6258c29ef1386712b47966ca7119f57822194d775c","deeb72c970af827398c1486c2d0efaba10de860686b17339f225d07235f52954","afa195deb7f373d07d3dd83f37b312558dbee85f9eb249e70929fa986636a576","b72cedfc0f661d99fcbb025bf4facb21cf5490a5992a36df436030d65aefa20a","0e50219940303274428d3a379e920ab2cefd9db08c610d348d1e79bcb0ad30e6","6e8b3de25bc2579d258399b17c3d598d16d7347e99cfba2edcd5cd39774838a8","3bb14e4947940750de4a2bb6b59092f4b3c2498b4bec49217ca538862feb92bd","39896537abf43abf946fe41c63599779311b59eca64ca0698f349f08ed140535","af7428b09158e97c493e58d79fe87c7ecb16e133b9ed847d87a8096ec265382b","dc75268a07b33d3b116cb6ca9ad461a89de8c3763bccc377989f2ffcc5d0b72b","cc248a488d5d545ce11f1f6a905e0378b0a39027ffcb6c4cf04d9ca5786b7f1b","14936cb333783b29131775488fe753ec4b692409565ef4b512d92a7e8c22547e","5bcf35a710e8b25784816a70f4ea721c2ea6854a6a5190f52aafab5558db6dcf","9905541604c93f33f18d753fd023337f0017188b25975d53e64c03320ec9e196","8dc7b1962e154c68c4ad038ccc2dcca3be1d9a63c520c477f308050972bfb1fd","6fd0d1d8a2b33320419e7c7eb2a097306a91a880b20f8d28d54febc07afbd105"],"paragraph_range_zero_based":[240,263],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2401275.zip::R2-2401275 Introduction of two QCL-TypeD properties identification and monitoring.docx:p240"}
{"fields":{"filename":"R2-2401275.zip::R2-2401275 Introduction of two QCL-TypeD properties identification and monitoring.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Enables parallel PRACH and SRS/PUCCH/PUSCH transmissions across CCs in intra-band non-contiguous CA (see TS 38.213 [13], clause 8.1 and TS 38.214 [19], clause 6.2.1). This field is absent in the IE CellGroupConfig when provided as part of RRCSetup message.","paragraph_zero_based":264},{"literal_text_all_w_t_and_m_t":"mcs-C-RNTI","paragraph_zero_based":265},{"literal_text_all_w_t_and_m_t":"RNTI to indicate use of qam64LowSE for grant-based transmissions. When the mcs-C-RNTI is configured, RNTI scrambling of DCI CRC is used to choose the corresponding MCS table.","paragraph_zero_based":266},{"literal_text_all_w_t_and_m_t":"ncr-RNTI","paragraph_zero_based":267},{"literal_text_all_w_t_and_m_t":"RNTI value for NCR-MT, used to scramble the PDCCHs carrying side control information (see TS 38.213 [13], clause 10.1).","paragraph_zero_based":268},{"literal_text_all_w_t_and_m_t":"nfi-TotalDAI-Included","paragraph_zero_based":269},{"literal_text_all_w_t_and_m_t":"Indicates whether the NFI and total DAI fields of the non-scheduled PDSCH group is included in the non-fallback DL grant DCI (see TS 38.212 [17], clause 7.3.1). The network configures this only when enhanced dynamic codebook is configured (pdsch-HARQ-ACK-Codebook is set to enhancedDynamic).","paragraph_zero_based":270},{"literal_text_all_w_t_and_m_t":"nrdc-PCmode-FR1","paragraph_zero_based":271},{"literal_text_all_w_t_and_m_t":"Indicates the uplink power sharing mode that the UE uses in NR-DC in frequency range 1 (FR1) (see TS 38.213 [13], clause 7.6).","paragraph_zero_based":272},{"literal_text_all_w_t_and_m_t":"nrdc-PCmode-FR2","paragraph_zero_based":273},{"literal_text_all_w_t_and_m_t":"Indicates the uplink power sharing mode that the UE uses in NR-DC in frequency range 2 (FR2) (see TS 38.213 [13], clause 7.6).","paragraph_zero_based":274},{"literal_text_all_w_t_and_m_t":"pdcch-BlindDetection, pdcch-BlindDetection2, pdcch-BlindDetection3, pdcch-BlindDetection4","paragraph_zero_based":275},{"literal_text_all_w_t_and_m_t":"Indicates the reference number of cells for PDCCH blind detection for the CG. Network configures the field for each CG when the UE is in NR DC and sets the value in accordance with the constraints specified in TS 38.213 [13]. The network configures pdcch-BlindDetection only if the UE is in NR-DC. The network configures pdcch-BlindDetection2 only if the UE is in NR-DC with at least one downlink cell using Rel-16 PDCCH monitoring capability. The network configures pdcch-BlindDetection3 only if the UE is in NR-DC with at least one downlink cell using Rel-15 PDCCH monitoring capability. The network configures pdcch-BlindDetection4 only if the UE is in NR-DC with at least one downlink cell using Rel-17 PDCCH monitoring capability.","paragraph_zero_based":276},{"literal_text_all_w_t_and_m_t":"pdcch-BlindDetectionCA-CombIndicator","paragraph_zero_based":277},{"literal_text_all_w_t_and_m_t":"Configure one combination of pdcch-BlindDetectionCA1 (for R15) and pdcch-BlindDetectionCA2 (for R16) for UE to use for scaling PDCCH monitoring capability if the number of serving cells configured to a UE is larger than the reported capability, and if UE reports more than one combination of pdcch-BlindDetectionCA1 and pdcch-BlindDetectionCA2 as UE capability. The combination of pdcch-BlindDetectionCA1 and pdcch-BlindDetectionCA2 configured by pdcch-BlindDetectionCA-CombIndicator is from the more than one combination of pdcch-BlindDetectionCA1 and pdcch-BlindDetectionCA2 reported by UE (see TS 38.213 [13], clause 10).","paragraph_zero_based":278},{"literal_text_all_w_t_and_m_t":"pdcch-BlindDetectionCA-CombIndicator-r17 is used to configure one combination of pdcch-BlindDetectionCA1 (for R15), pdcch-BlindDetectionCA2 (for R16) and pdcch-BlindDetectionCA3 (for R17) for UE to use for scaling PDCCH monitoring capability if the number of serving cells configured to a UE is larger than the reported capability, and if UE reports more than one combination of pdcch-BlindDetectionCA1, pdcch-BlindDetectionCA2 and pdcch-BlindDetectionCA3 as UE capability. The combination of pdcch-BlindDetectionCA1, pdcch-BlindDetectionCA2 and pdcch-BlindDetectionCA3 configured by pdcch-BlindDetectionCA-CombIndicator-r17 is from the more than one combination of pdcch-BlindDetectionCA1, pdcch-BlindDetectionCA2 and pdcch-BlindDetectionCA3 reported by UE (see TS 38.213 [13], clause 10).","paragraph_zero_based":279},{"literal_text_all_w_t_and_m_t":"pdcch-BlindDetectionCA-CombIndicator-r16 and pdcch-BlindDetectionCA-CombIndicator-r17 are not configured simultaneously.","paragraph_zero_based":280},{"literal_text_all_w_t_and_m_t":"p-NR-FR1","paragraph_zero_based":281},{"literal_text_all_w_t_and_m_t":"The maximum total transmit power to be used by the UE in this NR cell group across all serving cells in frequency range 1 (FR1). The maximum transmit power that the UE may use may be additionally limited by p-Max (configured in FrequencyInfoUL) and by p-UE-FR1 (configured total for all serving cells operating on FR1).","paragraph_zero_based":282},{"literal_text_all_w_t_and_m_t":"p-NR-FR2","paragraph_zero_based":283},{"literal_text_all_w_t_and_m_t":"The maximum total transmit power to be used by the UE in this NR cell group across all serving cells in frequency range 2 (FR2). The maximum transmit power that the UE may use may be additionally limited by p-Max (configured in FrequencyInfoUL) and by p-UE-FR2 (configured total for all serving cells operating on FR2). This field is only used in NR-DC. A UE does not expect to be configured with this parameter in this release of the specification.","paragraph_zero_based":284},{"literal_text_all_w_t_and_m_t":"prioLowDG-HighCG","paragraph_zero_based":285},{"literal_text_all_w_t_and_m_t":"Enable PHY prioritization for the case where low-priority dynamic grant-PUSCH collides with high-priority configured grant-PUSCH on a BWP of a serving cell (see TS 38.213 [13], clause 9), when the UE has generated transport blocks for both DG-PUSCH and CG-PUSCH as described in TS 38.321 [3].","paragraph_zero_based":286},{"literal_text_all_w_t_and_m_t":"prioHighDG-LowCG","paragraph_zero_based":287}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9ef79a4eb2cc359be77b260df29ccfb41d1690d829d9f72664c79151548c2096","original_member_sha256":"e0a2c9353da6a7184b58797c60442cdf9a142252349ae303a56438bc61293dd7","paragraph_ElementTree_utf8_XML_sha256":["8413ce30e6abacf895ee0aa37350b0bb7fc76b7b1e6bbdeee9cf306ad9083bac","29553d057f1e049d440899e1f4bc92134280572625c03d5e20999df6771b1746","92e5b8c5ed830fdf48857b0b7ac04fa15c5cafe0dc41aca4005caedec3f7a5a4","5f6e12abf092536874fbbf78438c88f1b3835fc9febc41bcc0c68889db38b807","a9503a1366037e21e6730ad4225a3ea00c8552c9d8071cd3e35f25d91ed449d9","28e77abb4f6afb8de21fe2e3ce2532c422ee14c8b64c35731f69cc567cc2c2a3","e4922f03b9d616c3d1cee2defbbac33def4f5055e3619a93b00ca1c8b070602c","7b9b24e3d14435e34924bc2681b49675e8fdb89a276608cd2b277d2cb948a579","846196a852dbe63c83af174f5357e9fa0634b64431e3cecf4c6a0cab05283292","8ba3f67fd98b1eb4b8cda98f269d687d9ddd88ff7b89d59aefba6d55f5758b16","c116660dfeed14865617611b4225488263eae90c2d14c0527fa555534cd53351","51b80f91b9bfa27859a6a37e5951dc00391f96f33381fa7ee48654f6c4a057cf","d18bf3f0281e1476a80f27fcea245c5538005e59b3f41505d2187240aff32b9b","4f11a3f6074f00745d1284fc36d53bd631eb6620800d984470c1424f6bbe2d53","1fcdf4b7eaad4a0d079638e9fbb0c8d0e78ec6a67ad143b25e4c2afd4b455fc6","7c74edb59ef66c5f715ef50a5ecdead31b28e1b037a84a7a160ed48c10ba597d","fc83cb6303706781a2bc8ccfa35fcc583118a8e926d1b5e3c7a237c48a7bbaf9","9aaa9764640b0411b85ff08ca01e7b2981def6262aa5dad7b9dc33a1e1282c0f","0dbf013f20c622eacc2cce97fb3b188ed75ccf43cfd6bf4f8fbfcbf1228907b2","67a7df43312ffdf6a9e7ebad510f1fb04fd273c3ad7870370db448c250fc0783","60ce8f66b16ab36aec6ac7b2b1478de06caccf480d455c3df16593de111276ec","04c4d661b1eafa8107cdda63172ee0a9f23afd72604295d949cec4b67d329a97","e1788c88b6c010807c97ff24ee7a324a6a3eab567ee46ea79b9873555715a865","635809d2af91d8392e186a20e1302884cb477ae865ae4a6fa2830f1a3f0cbcba"],"paragraph_range_zero_based":[264,287],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2401275.zip::R2-2401275 Introduction of two QCL-TypeD properties identification and monitoring.docx:p264"}
{"fields":{"filename":"R2-2401275.zip::R2-2401275 Introduction of two QCL-TypeD properties identification and monitoring.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Enable PHY prioritization for the case where high-priority dynamic grant PUSCH collides with low-priority configured grant PUSCH on a BWP of a serving cell (see TS 38.213 [13], clause 9), when the UE has generated transport blocks for both DG-PUSCH and CG-PUSCH as described in TS 38.321 [3].","paragraph_zero_based":288},{"literal_text_all_w_t_and_m_t":"ps-RNTI","paragraph_zero_based":289},{"literal_text_all_w_t_and_m_t":"RNTI value for scrambling CRC of DCI format 2-6 used for power saving (see TS 38.213 [13], clause 10.1).","paragraph_zero_based":290},{"literal_text_all_w_t_and_m_t":"ps-Offset","paragraph_zero_based":291},{"literal_text_all_w_t_and_m_t":"The start of the search-time of DCI format 2-6 with CRC scrambled by PS-RNTI relative to the start of the drx-onDurationTimer of Long DRX (see TS 38.213 [13], clause 10.3). Value in multiples of 0.125ms (milliseconds). 1 corresponds to 0.125 ms, 2 corresponds to 0.25 ms, 3 corresponds to 0.375 ms and so on.","paragraph_zero_based":292},{"literal_text_all_w_t_and_m_t":"ps-WakeUp","paragraph_zero_based":293},{"literal_text_all_w_t_and_m_t":"Indicates the UE to wake-up if DCI format 2-6 is not detected outside active time (see TS 38.321 [3], clause 5.7). If the field is absent, the UE does not wake-up if DCI format 2-6 is not detected outside active time.","paragraph_zero_based":294},{"literal_text_all_w_t_and_m_t":"ps-PositionDCI-2-6","paragraph_zero_based":295},{"literal_text_all_w_t_and_m_t":"Starting position of UE wakeup and SCell dormancy indication in DCI format 2-6 (see TS 38.213 [13], clause 10.3).","paragraph_zero_based":296},{"literal_text_all_w_t_and_m_t":"ps-TransmitPeriodicL1-RSRP","paragraph_zero_based":297},{"literal_text_all_w_t_and_m_t":"Indicates the UE to transmit periodic L1-RSRP report(s) when the drx-onDurationTimer does not start (see TS 38.321 [3], clause 5.7). If the field is absent, the UE does not transmit periodic L1-RSRP report(s) when the drx-onDurationTimer does not start.","paragraph_zero_based":298},{"literal_text_all_w_t_and_m_t":"ps-TransmitOtherPeriodicCSI","paragraph_zero_based":299},{"literal_text_all_w_t_and_m_t":"Indicates the UE to transmit periodic CSI report(s) other than L1-RSRP reports when the drx-onDurationTimer does not start (see TS 38.321 [3], clause 5.7). If the field is absent, the UE does not transmit periodic CSI report(s) other than L1-RSRP reports when the drx-onDurationTimer does not start.","paragraph_zero_based":300},{"literal_text_all_w_t_and_m_t":"p-UE-FR1","paragraph_zero_based":301},{"literal_text_all_w_t_and_m_t":"The maximum total transmit power to be used by the UE across all serving cells in frequency range 1 (FR1) across all cell groups. The maximum transmit power that the UE may use may be additionally limited by p-Max (configured in FrequencyInfoUL) and by p-NR-FR1 (configured for the cell group).","paragraph_zero_based":302},{"literal_text_all_w_t_and_m_t":"p-UE-FR2","paragraph_zero_based":303},{"literal_text_all_w_t_and_m_t":"The maximum total transmit power to be used by the UE across all serving cells in frequency range 2 (FR2) across all cell groups. The maximum transmit power that the UE may use may be additionally limited by p-Max (configured in FrequencyInfoUL) and by p-NR-FR2 (configured for the cell group). A UE does not expect to be configured with this parameter in this release of the specification.","paragraph_zero_based":304},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-Codebook","paragraph_zero_based":305},{"literal_text_all_w_t_and_m_t":"The PDSCH HARQ-ACK codebook is either semi-static or dynamic. This is applicable to both CA and non-CA operation (see TS 38.213 [13], clauses 9.1.2 and 9.1.3). If pdsch-HARQ-ACK-Codebook-r16 is signalled, UE shall ignore the pdsch-HARQ-ACK-Codebook (without suffix). For the HARQ-ACK for sidelink, if pdsch-HARQ-ACK-Codebook-r16 is signalled, the UE uses pdsch-HARQ-ACK-Codebook (without suffix) and ignores pdsch-HARQ-ACK-Codebook-r16. If the field pdsch-HARQ-ACK-Codebook-secondaryPUCCHgroup is present, pdsch-HARQ-ACK-Codebook is applied to primary PUCCH group. Otherwise, this field is applied to the cell group (i.e. for all the cells within the cell group). For the HARQ-ACK for sidelink, if the field pdsch-HARQ-ACK-Codebook-secondaryPUCCHgroup is present, pdsch-HARQ-ACK-Codebook is applied to primary and secondary PUCCH group and the UE ignores pdsch-HARQ-ACK-Codebook-secondaryPUCCHgroup.","paragraph_zero_based":306},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-CodebookList","paragraph_zero_based":307},{"literal_text_all_w_t_and_m_t":"A list of configurations for one or two HARQ-ACK codebooks. Each configuration in the list is defined in the same way as pdsch-HARQ-ACK-Codebook (see TS 38.212 [17], clause 7.3.1.2.2 and TS 38.213 [13], clauses 7.2.1, 9.1.2, 9.1.3 and 9.2.1). If this field is present, the field pdsch-HARQ-ACK-Codebook is ignored. If this field is present, the value of this field is applied for primary PUCCH group and for secondary PUCCH group (if configured). For the HARQ-ACK for sidelink, the UE uses pdsch-HARQ-ACK-Codebook and ignores pdsch-HARQ-ACK-CodebookList if this field is present.","paragraph_zero_based":308},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-Codebook-secondaryPUCCHgroup","paragraph_zero_based":309},{"literal_text_all_w_t_and_m_t":"The PDSCH HARQ-ACK codebook is either semi-static or dynamic. This is applicable to CA operation (see TS 38.213 [13], clauses 9.1.2 and 9.1.3). It is configured for secondary PUCCH group.","paragraph_zero_based":310},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-EnhType3DCI-Field, pdsch-HARQ-ACK-EnhType3DCI-FieldSecondaryPUCCHgroup","paragraph_zero_based":311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9ef79a4eb2cc359be77b260df29ccfb41d1690d829d9f72664c79151548c2096","original_member_sha256":"e0a2c9353da6a7184b58797c60442cdf9a142252349ae303a56438bc61293dd7","paragraph_ElementTree_utf8_XML_sha256":["976781462a0ea6d0655c67dc14cfa825ca7fa9b83b608e456ac2e35cff069004","d6b94226a8fa04142c40a0fe58bf2fb283eae78d4f1f216e5334697a7cac8900","ca5aa9094b80a9824ea84f3aa635565e227f48570230c83ea51d261734764f01","03c075ec57ec0052a710566423289b4543630690ef6e3c775038daf7c2a66668","2de2a4d54eb047ade86b29dd91187e97f92329d42dd9ee208e8c3f57cbd798a9","38d7b0aebbd1e0f66820990a3199c6bd09ad9aaedeedd6085f22be1f6981db88","de709dab5323451c9aabeb88a05b163a318a9e62236a2070308b1767f6505bc3","5e63b213391217649d9ccff8e91e0aee57919a2eb2f9f37a496e06abc0e36bc6","30b32f11775d160a4c49da2076fafaa67149a98e48a5a9ed55f5ef5b61c61b60","38a10f2b2baf541a53592cf3def7fbb78f5c5b748f2023c55b623ef5291beb26","cd10115d49554a2dc5bc33cdb5b1d49fe90006f737d270780fc4f9a5a72aa947","d9fa5343e38e127262b2b062e0fd14169e670bd48a992cf698f1542682f5c029","c5276080d8e65cfdd11a7cf65266e508f8b214eef749f79ff663e62441ce51f9","c58b925c4ab979b9521f3e598aaa21d553ddc2ed3580a8a8610c103fa898fb8b","0326ea2260be1d5fab0f827814e8fbc9ac0d70c224a36f895bf5ab013734e2f6","8437ad382b85796e6b37062e78c04458c1d721b01cc43f5f65f6d88de52431cf","b4ccc7707dff1e1bc742e6466d62fa8e1b97d8ef0b88e412ac8a769e1b1fc7fc","e975b9f58b531ffd57cd3783420db90bdbc5a49502cffa964a06581a70f6bc0c","5a0fb4f46fa7c2a4cd4c819a8fa674da3d48f25a3611e0503b3e4895fcfb1d3d","37e555fc4e10f1a57226bee212c914b8b4cb0d4680544911dc1f2d228eb86d78","0dcc1ab7131c65c546752ee4e747e7c4edcaee70d4d0795a61b4dac4db11b069","c129b0f1b064c70101ecc1bfa5fccd9573a635c5fd8501d11c24c325bb992078","8121dd3e0649615f8d4c80e4f8776ebbbb861b7eda1e5d07f576ad3791b8194b","5fcb804c05ed5ec1ae2f47ddb6887d1ebbdea3eeeca13c35009bc90a5b024e75"],"paragraph_range_zero_based":[288,311],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2401275.zip::R2-2401275 Introduction of two QCL-TypeD properties identification and monitoring.docx:p288"}
{"fields":{"filename":"R2-2401275.zip::R2-2401275 Introduction of two QCL-TypeD properties identification and monitoring.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the enhanced Type 3 codebook through a new DCI field to indicate the enhanced Type 3 HARQ-ACK codebook in the primary PUCCH group if the more than one enhanced Type 3 HARQ-ACK codebook is configured for the primary PUCCH group, or in the secondary PUCCH group if the more than one enhanced Type 3 HARQ-ACK code is configured for the secondary PUCCH group, respectively.","paragraph_zero_based":312},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-EnhType3ToAddModList, pdsch-HARQ-ACK-EnhType3SecondaryToAddModList","paragraph_zero_based":313},{"literal_text_all_w_t_and_m_t":"Configure the list of enhanced Type 3 HARQ-ACK codebooks for the primary PUCCH group and the secondary PUCCH group, respectively. When configured, DCI format 1_1 can request the UE to report A/N for one of the configured enhanced Type 3 HARQ-ACK codebooks in the corresponding PUCCH group (see TS 38.213 [13], clause 9.1.4). The network can configure pdsch-HARQ-ACK-EnhType3SecondaryToAddModList only if secondary PUCCH group is configured.","paragraph_zero_based":314},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-OneShotFeedback","paragraph_zero_based":315},{"literal_text_all_w_t_and_m_t":"When configured, the DCI format 1_1 can request the UE to report A/N for all HARQ processes and all CCs configured in the PUCCH group (see TS 38.212 [17], clause 7.3.1).","paragraph_zero_based":316},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-OneShotFeedbackCBG","paragraph_zero_based":317},{"literal_text_all_w_t_and_m_t":"When configured, the DCI format 1_1 can request the UE to include CBG level A/N for each CC with CBG level transmission configured. When not configured, the UE will report TB level A/N even if CBG level transmission is configured for a CC. The network configures this only when pdsch-HARQ-ACK-OneShotFeedback is configured.","paragraph_zero_based":318},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-OneShotFeedbackNDI","paragraph_zero_based":319},{"literal_text_all_w_t_and_m_t":"When configured, the DCI format 1_1 can request the UE to include NDI for each A/N reported. The network configures this only when pdsch-HARQ-ACK-OneShotFeedback is configured.","paragraph_zero_based":320},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-Retx, pdsch-HARQ-ACK-RetxSecondaryPUCCHgroup","paragraph_zero_based":321},{"literal_text_all_w_t_and_m_t":"When configured, the DCI format 1_1 can request the UE to perform a HARQ-ACK re-transmission on a PUCCH resource in the primary PUCCH group and the secondary PUCCH group, respectively (see TS 38.213 [13], clause 9.1.5).","paragraph_zero_based":322},{"literal_text_all_w_t_and_m_t":"pucch-sSCell, pucch-sSCellSecondaryPUCCHgroup","paragraph_zero_based":323},{"literal_text_all_w_t_and_m_t":"indictates the alternative PUCCH cells for PUCCH cell switching in the primary and the secondary PUCCH group, respectively. For the primary PUCCH group, it is configured for cells on top of SpCell. For the secondary PUCCH group, it is configured for cell on top of the PUCCH SCell.","paragraph_zero_based":324},{"literal_text_all_w_t_and_m_t":"pucch-sSCellDyn, pucch-sSCellDynsecondaryPUCCHgroup","paragraph_zero_based":325},{"literal_text_all_w_t_and_m_t":"When configured, PUCCH cell switching based on dynamic indication in DCI format 1_1 is enabled (see TS 38.213 [13], clause 9.A, clause 9.1.5), respectively for the primary PUCCH group and the secondary PUCCH group.","paragraph_zero_based":326},{"literal_text_all_w_t_and_m_t":"pucch-sSCellPattern, pucch-sSCellPatternSecondaryPUCCHgroup","paragraph_zero_based":327},{"literal_text_all_w_t_and_m_t":"When configured, the UE applies the semi-static PUCCH cell switching (see TS 38.213 [13], clause 9.A) using the time domain pattern of applicable PUCCH cells indicated by this field, respectively for the primary PUCCH group and the secondary PUCCH group.","paragraph_zero_based":328},{"literal_text_all_w_t_and_m_t":"simultaneousPUCCH-PUSCH, simultaneousPUCCH-PUSCH-SecondaryPUCCHgroup","paragraph_zero_based":329},{"literal_text_all_w_t_and_m_t":"Enables simultaneous PUCCH and PUSCH transmissions with different priorities for the primary PUCCH group and the secondary PUCCH group, respectively.","paragraph_zero_based":330},{"literal_text_all_w_t_and_m_t":"simultaneousPUCCH-PUSCH-SamePriority, simultaneousPUCCH-PUSCH-SamePriority-SecondaryPUCCHgroup","paragraph_zero_based":331},{"literal_text_all_w_t_and_m_t":"Enables simultaneous PUCCH and PUSCH transmissions on different cells in different bands with same prioritiy for the primary PUCCH group and the secondary PUCCH group, respectively, as specified in clause 9 of TS 38.213 [13].","paragraph_zero_based":332},{"literal_text_all_w_t_and_m_t":"simultaneousSR-PUSCH-diffPUCCH-Groups","paragraph_zero_based":333},{"literal_text_all_w_t_and_m_t":"Enables simultaneous SR and PUSCH transmissions in different PUCCH groups (see TS 38.321 [3], clause 5.4.1, clause 5.4.4).","paragraph_zero_based":334},{"literal_text_all_w_t_and_m_t":"sizeDCI-2-6","paragraph_zero_based":335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9ef79a4eb2cc359be77b260df29ccfb41d1690d829d9f72664c79151548c2096","original_member_sha256":"e0a2c9353da6a7184b58797c60442cdf9a142252349ae303a56438bc61293dd7","paragraph_ElementTree_utf8_XML_sha256":["13df1afa4966547efb4a3905ce186455666ea3aa4829fb935b9680519b76eb32","31047d4c17cc7b96fd44e359fbc6404943d5bc9e2ae644b4dbd330e1bad3ed73","3553c74cb1e3525c309f0ce5ae03861f7943a7932bdc3fbe07e72127f9dfe003","99d589bd8246f54214b144df940603f882c372e3b35ada12d6dbfafc46136f67","841fcdcf638bbc89c6ec179d64037ef3652f9001a972855939756deb629ed0a0","ac65420420865f4bd0a2ec5720d50c864fcb279ba9be0b41657d530e221d2638","25e5e96cb7b7c0009bdcdbae310e14bd76457f464324cf9e3e87ced8216637d9","434477abb1f6e69f1d22eb56bc0702ff95af52d63239faf7c6f765d1d83eca79","7624d39f9d716383ab7c025adc10f65e4b020900f6d6c7f65fb7107ca1788e11","09e8e0031b7782e10d2626351a32504d8f03cd37055fcdde2d5f188e99449500","7f484ef2c6e13c67a1839e48b61e66848ab0e97287fd7458e463371accab615f","63f83bf1e6765db8b0e8ca5c59a7bdc0b341f0eacb92c1685766d8dac0b32445","4d47ca888ee73c0a877f23d13a5dc40ccaa58afa8367aea84b33e374211495c1","0b56c661a0f4cb9c531a5d3a1d60616e6fca1255117df47514651827c814627e","b14af17937651ded7590e7e1ddfdcd059e90f49fc01b162d9099683d0e66169a","f086a2b9d7121c8bb86e160bce8d83df7c1e756b86fa33900b762ec0bd9cb19d","775c97a97717317f2d0a34e2d50cf5323c904c132be78c65a21643f0dbb20ef7","57a6c2966483be053e3da0c09d7a20bacc439f2dbc862a3eb8faddf4bc7b6916","0ab71483f572d94e4301abf84acd76cdd1ea1a5594b19897a9cb7e108c4fcf7b","550da6c11abef0e326250b5f2af0572c44b592a7fae3585d9c9a07b173e476e8","5b1e57c88aa45c4a7757a0bfd138e72aa24822a7774a98d53f0d270ac53adef4","c12ae01137a6fbcabcad9d09ee34b4949e2847e3389c12e6fcf2c6f2e8f9abb1","bcbe6b40268650f5c0b42e6aba686d9d0b046a35c7f86f9991696c5c96099ec3","93499325d5f41b94e7c1b4b5fb9a85563e4b68a7b39f7922a6b94b8673c7c131"],"paragraph_range_zero_based":[312,335],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2401275.zip::R2-2401275 Introduction of two QCL-TypeD properties identification and monitoring.docx:p312"}
{"fields":{"filename":"R2-2401275.zip::R2-2401275 Introduction of two QCL-TypeD properties identification and monitoring.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Size of DCI format 2-6 (see TS 38.213 [13], clause 10.3).","paragraph_zero_based":336},{"literal_text_all_w_t_and_m_t":"sp-CSI-RNTI","paragraph_zero_based":337},{"literal_text_all_w_t_and_m_t":"RNTI for Semi-Persistent CSI reporting on PUSCH (see CSI-ReportConfig) (see TS 38.214 [19], clause 5.2.1.5.2). Network always configures the UE with a value for this field when at least one CSI-ReportConfig with reportConfigType set to semiPersistentOnPUSCH is configured.","paragraph_zero_based":338},{"literal_text_all_w_t_and_m_t":"tpc-PUCCH-RNTI","paragraph_zero_based":339},{"literal_text_all_w_t_and_m_t":"RNTI used for PUCCH TPC commands on DCI (see TS 38.213 [13], clause 10.1).","paragraph_zero_based":340},{"literal_text_all_w_t_and_m_t":"tpc-PUSCH-RNTI","paragraph_zero_based":341},{"literal_text_all_w_t_and_m_t":"RNTI used for PUSCH TPC commands on DCI (see TS 38.213 [13], clause 10.1).","paragraph_zero_based":342},{"literal_text_all_w_t_and_m_t":"tpc-SRS-RNTI","paragraph_zero_based":343},{"literal_text_all_w_t_and_m_t":"RNTI used for SRS TPC commands on DCI (see TS 38.213 [13], clause 10.1).","paragraph_zero_based":344},{"literal_text_all_w_t_and_m_t":"twoQCLTypeDforPDCCHRepetition","paragraph_zero_based":345},{"literal_text_all_w_t_and_m_t":"Indicates whether a UE is expected UE to identify and monitor two QCL-TypeD properties for multiple overlapping CORESETs in the case of PDCCH repetition.","paragraph_zero_based":346},{"literal_text_all_w_t_and_m_t":"twoQCL-TypeD-ForMultiDCI","paragraph_zero_based":347},{"literal_text_all_w_t_and_m_t":"Indicates whether a UE is expected to identify and monitor two QCL-TypeD properties for multiple overlapping CORESETs, where the first QCL-TypeD is associated with coresetPoolIndex value 0, and the second QCL-TypeD is associated with coresetPoolIndex value 1.","paragraph_zero_based":348},{"literal_text_all_w_t_and_m_t":"uci-MuxWithDiffPrio, uci-MuxWithDiffPrio-secondaryPUCCHgroup","paragraph_zero_based":349},{"literal_text_all_w_t_and_m_t":"When configured, enables multiplexing a high-priority (HP) HARQ-ACK UCI and a low-priority (LP) HARQ-ACK UCI into a PUCCH or PUSCH for the primary PUCCH group and the secondary PUCCH group, respectively.","paragraph_zero_based":350},{"literal_text_all_w_t_and_m_t":"ul-TotalDAI-Included","paragraph_zero_based":351},{"literal_text_all_w_t_and_m_t":"Indicates whether the total DAI fields of the additional PDSCH group is included in the non-fallback UL grant DCI (see TS 38.212 [17], clause 7.3.1). The network configures this only when enhanced dynamic codebook is configured (pdsch-HARQ-ACK-Codebook is set to enhancedDynamic).","paragraph_zero_based":352},{"literal_text_all_w_t_and_m_t":"xScale","paragraph_zero_based":353},{"literal_text_all_w_t_and_m_t":"The UE is allowed to drop NR only if the power scaling applied to NR results in a difference between scaled and unscaled NR UL of more than xScale dB (see TS 38.213 [13]). If the value is not configured for dynamic power sharing, the UE assumes default value of 6 dB.","paragraph_zero_based":354},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":355},{"literal_text_all_w_t_and_m_t":"<<<<End of the Change>>>>","paragraph_zero_based":356}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9ef79a4eb2cc359be77b260df29ccfb41d1690d829d9f72664c79151548c2096","original_member_sha256":"e0a2c9353da6a7184b58797c60442cdf9a142252349ae303a56438bc61293dd7","paragraph_ElementTree_utf8_XML_sha256":["01ec0012af45da05e5315d93b26d41a3d081bf22a4f2d6b90bb4bf732167d5f1","1d8ed7dca3d2675db82172e718042967064eae8b715a966283bc9f3ad1abcf84","d125e8a5492cf038cb28c3cbe5484af5f98d16947eec02c574d2a5f014830258","d4602d1d78162df68d0461411527a3321261099451f9a22672c087b023ca334b","8c9a6dae2b3208f8f0d2f65f34f0d10f3254f8e114f9cddc238d40daab872171","55f6b6f3f4ab63fbe59fa2c79165ab4f595a97624dfeac17691142a550f04268","7dc85d2611bb8fd29be9f4d973f4a5c52c6bd8ae16f04dc5f7730bbf06694c60","80965639d4832c87988347c3490547f535540581ffd65b980277bde4428685a8","0d9f5ac2f9ec5157eff1b4a09ac745bc0123cbeb5c908f0edf2305e3f3ded943","272b3db2659438dab6805d785599748fdbed208d836ccb7aaae26b7f3990a57e","9d2389e60e79209581ba2ab3d6d2b9bc0716f2dd38a5d3ec4523fa9f0001c603","35488d10db4b35a3e0be2dca2fa2346f8dd60be7b0340d5a429f47e9f94b2b71","c08e1900d727530579ee9af078c0f1dc4e9f0d931d53f8d0afdd0e09ec0af91f","91057e64fdf4c0768c2e54a6f5b6992ff6523914c4d230d0fb6e3a686d102e5d","226cf818db00484f078d430496a790fdd0d7f0b69ddb48dcdaa261a9494fffa3","c1470f710c01ce46efb83dca7807d6f9ebd6be88009c53ffdef76117d8ab84c9","593b4b615ec62284f2f1e7148ea4cfe97a62bbf1ed5b6ffc1e27f4a69ac1f7d3","60e893b00dc2453d5139ce3af0130f9e318a318a6b4239abbb42f92fd9840b25","e5d6b1fde8afe5e2027c8f64b06dc6d660edf8519490290734ef16dbf817e55d","30d9d49fdbf93c8feb177d9d36f4b82cf3ee8b03894a40f6274589a615ec32d8","e132b438f485c01e0c4edc1b4e52cb0d85952d3232534a9babea2991e2d0bf29"],"paragraph_range_zero_based":[336,356],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2401275.zip::R2-2401275 Introduction of two QCL-TypeD properties identification and monitoring.docx:p336"}
