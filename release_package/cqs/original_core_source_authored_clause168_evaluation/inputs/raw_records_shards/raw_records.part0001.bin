{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34080},{"literal_text_all_w_t_and_m_t":"MIMO-ParametersPerBand field descriptions","paragraph_zero_based":34081},{"literal_text_all_w_t_and_m_t":"codebookParametersPerBand","paragraph_zero_based":34082},{"literal_text_all_w_t_and_m_t":"For a given frequency band, this field this field indicates the alternative list of SupportedCSI-RS-Resource supported for each codebook type. The supported CSI-RS resources indicated by this field are referred by codebookParametersperBC in CA-ParametersNR to indicate the supported CSI-RS resource per band combination.","paragraph_zero_based":34083},{"literal_text_all_w_t_and_m_t":"csi-RS-IM-ReceptionForFeedback/ csi-RS-ProcFrameworkForSRS/ csi-ReportFramework","paragraph_zero_based":34084},{"literal_text_all_w_t_and_m_t":"CSI related capabilities which the UE supports on each of the carriers operated on this band. If the network configures the UE with serving cells on both FR1 and FR2 bands these values may be further limited by the corresponding fields in fr1-fr2-Add-UE-NR-Capabilities.","paragraph_zero_based":34085},{"literal_text_all_w_t_and_m_t":"supportNewDMRS-Port","paragraph_zero_based":34086},{"literal_text_all_w_t_and_m_t":"Presence of this field set to supported1, supported2 or supported3 indicates that the UE supports the new DMRS port entry {0,2,3}.","paragraph_zero_based":34087},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34088},{"literal_text_all_w_t_and_m_t":"–ModulationOrder","paragraph_zero_based":34089},{"literal_text_all_w_t_and_m_t":"The IE ModulationOrder is used to convey the maximum supported modulation order.","paragraph_zero_based":34090},{"literal_text_all_w_t_and_m_t":"ModulationOrder information element","paragraph_zero_based":34091},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":34092},{"literal_text_all_w_t_and_m_t":"-- TAG-MODULATIONORDER-START","paragraph_zero_based":34093},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34094},{"literal_text_all_w_t_and_m_t":"ModulationOrder ::= ENUMERATED {bpsk-halfpi, bpsk, qpsk, qam16, qam64, qam256}","paragraph_zero_based":34095},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34096},{"literal_text_all_w_t_and_m_t":"-- TAG-MODULATIONORDER-STOP","paragraph_zero_based":34097},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":34098},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34099},{"literal_text_all_w_t_and_m_t":"–MRDC-Parameters","paragraph_zero_based":34100},{"literal_text_all_w_t_and_m_t":"The IE MRDC-Parameters contains the band combination parameters specific to MR-DC for a given MR-DC band combination.","paragraph_zero_based":34101},{"literal_text_all_w_t_and_m_t":"MRDC-Parameters information element","paragraph_zero_based":34102},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":34103}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["48e10d1082bfdc8bcac8d2ce80bfb975686542a5dc80049472a4722b9c774b5d","e5253169bbe7b17ae3a8dca8e26f579bff85a36f54d4fb81a84a9ef62b281503","35c157ef2d47fe1f572ddf59260452dc5bd9d17e53eea1b693b542390a870173","2181017c3e46dde88ec584a291a41171e5ec8736a81c8183bcc1face75facda0","0e2b35c4c5b4c9ece84c8d6506cf6eea95907903d0159f16d36afe6140f5b2a5","ad45ef9e81314ca24ccc81b4b3bfaa65a0bd06bc63368cdd4a25c369062ab618","cff4b43dc9f3a3d28e7d301a884ec511e037b41d6fdc4c44f48499cebbb9b781","ead7f6be73cb66ff2b5daded36e931401e135573a40f89c214ee35ce56a70eac","07ff1265b1650c7517725442de5f0c7990c424