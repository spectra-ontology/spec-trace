{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–CrossCarrierSchedulingConfig","paragraph_zero_based":16584},{"literal_text_all_w_t_and_m_t":"The IE CrossCarrierSchedulingConfig is used to specify the configuration when the cross-carrier scheduling is used in a cell.","paragraph_zero_based":16585},{"literal_text_all_w_t_and_m_t":"CrossCarrierSchedulingConfig information element","paragraph_zero_based":16586},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":16587},{"literal_text_all_w_t_and_m_t":"-- TAG-CROSSCARRIERSCHEDULINGCONFIG-START","paragraph_zero_based":16588},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16589},{"literal_text_all_w_t_and_m_t":"CrossCarrierSchedulingConfig ::=        SEQUENCE {","paragraph_zero_based":16590},{"literal_text_all_w_t_and_m_t":"    schedulingCellInfo                      CHOICE {","paragraph_zero_based":16591},{"literal_text_all_w_t_and_m_t":"        own                                     SEQUENCE {                  -- Cross carrier scheduling: scheduling cell","paragraph_zero_based":16592},{"literal_text_all_w_t_and_m_t":"            cif-Presence                            BOOLEAN","paragraph_zero_based":16593},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":16594},{"literal_text_all_w_t_and_m_t":"        other                                   SEQUENCE {                  -- Cross carrier scheduling: scheduled cell","paragraph_zero_based":16595},{"literal_text_all_w_t_and_m_t":"            schedulingCellId                        ServCellIndex,","paragraph_zero_based":16596},{"literal_text_all_w_t_and_m_t":"            cif-InSchedulingCell                    INTEGER (1..7)","paragraph_zero_based":16597},{"literal_text_all_w_t_and_m_t":"        }","paragraph_zero_based":16598},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":16599},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":16600},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":16601},{"literal_text_all_w_t_and_m_t":"    carrierIndicatorSize-r16            SEQUENCE {","paragraph_zero_based":16602},{"literal_text_all_w_t_and_m_t":"        carrierIndicatorSizeDCI-1-2-r16        INTEGER (0..3),","paragraph_zero_based":16603},{"literal_text_all_w_t_and_m_t":"        carrierIndicatorSizeDCI-0-2-r16        INTEGER (0..3)","paragraph_zero_based":16604},{"literal_text_all_w_t_and_m_t":"    }                                                                                       OPTIONAL,  -- Cond CIF-PRESENCE","paragraph_zero_based":16605},{"literal_text_all_w_t_and_m_t":"    enableDefaultBeamForCCS-r16         ENUMERATED {enabled}                                OPTIONAL  -- Need S","paragraph_zero_based":16606},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":16607}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["52e1bfae7656d8707bf213fe624365b492b36b062ea6b061b4a7d490630076ed","086bfd559454cc7d387ce87857d68b4a13c88bccf0ff9a2ab6de26b9c763865f","3f8b32391219d77b53213aa4a48487c502f894e99b0d4670d698f3cb99c7e734","413539241412bafaa46499b2aea596e3637b12a3f8efeec36d59f0b270e92272","7f652dfdf99219d3fff6c334f36904880875cbc44d23b4f37dd9d2f425893813","951568d547388314db0b761548096d5ce614c030f92e51b38b24ef9521098ea2","cacdf401aa38192869265fc0a7baa73752c0fda45d00254357464eefa9c5535d","d65f43520043a1af5f674e43f58dac4a016fd13f5735ce44e7b6def25ca13b57","b9bc9590453259bd82a1b02b3943197a300c36b5f4808bd3bfc50274fd741f9a","a20cda8e7a011b0e246cc97e6b4d32a42b7f35ba4fada211cc9b74175b9eb168","349ec