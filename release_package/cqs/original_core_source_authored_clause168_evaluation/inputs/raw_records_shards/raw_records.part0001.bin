{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SIB18-r17 ::=               SEQUENCE {","paragraph_zero_based":14184},{"literal_text_all_w_t_and_m_t":"    gin-ElementList-r17         SEQUENCE (SIZE (1..maxGIN-r17)) OF GIN-Element-r17            OPTIONAL,   -- Need R","paragraph_zero_based":14185},{"literal_text_all_w_t_and_m_t":"    gins-PerSNPN-List-r17       SEQUENCE (SIZE (1..maxNPN-r16)) OF GINs-PerSNPN-r17           OPTIONAL,   -- Need S","paragraph_zero_based":14186},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension    OCTET STRING                                                  OPTIONAL,","paragraph_zero_based":14187},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":14188},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14189},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14190},{"literal_text_all_w_t_and_m_t":"GIN-Element-r17 ::=         SEQUENCE {","paragraph_zero_based":14191},{"literal_text_all_w_t_and_m_t":"    plmn-Identity-r17           PLMN-Identity,","paragraph_zero_based":14192},{"literal_text_all_w_t_and_m_t":"    nid-List-r17                SEQUENCE (SIZE (1..maxGIN-r17)) OF NID-r16","paragraph_zero_based":14193},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14194},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14195},{"literal_text_all_w_t_and_m_t":"GINs-PerSNPN-r17 ::=        SEQUENCE {","paragraph_zero_based":14196},{"literal_text_all_w_t_and_m_t":"    supportedGINs-r17           BIT STRING (SIZE (1..maxGIN-r17))                             OPTIONAL   -- Need R","paragraph_zero_based":14197},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14198},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB18-STOP","paragraph_zero_based":14199},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":14200},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14201},{"literal_text_all_w_t_and_m_t":"SIB18 field descriptions","paragraph_zero_based":14202},{"literal_text_all_w_t_and_m_t":"gin-ElementList","paragraph_zero_based":14203},{"literal_text_all_w_t_and_m_t":"The gin-ElementList contains one or more GIN elements. Each GIN element contains either one GIN, which is identified by a PLMN ID and a NID, or multiple GINs that share the same PLMN ID. The total number of GINs indicated does not exceed maxGIN-r17. The GIN index m is defined as d1+d2+…+d(n-1)+i for the GIN included in the n-th entry of the gin-ElementList and the i-th entry of its corresponding GIN-Element, where d(k) is the number of GIN index values used in the k-th gin-ElementList entry.","paragraph_zero_based":14204},{"literal_text_all_w_t_and_m_t":"gins-PerSNPN-List","paragraph_zero_based":14205},{"literal_text_all_w_t_and_m_t":"Indicates the supported GINs for each SNPN. The network includes the same number of entries as the number of SNPNs in snpn-AccessInfoList in provided in SIB1, and the n-th entry in this list corresponds to the n-th SNPN listed in snpn-AccessInfoList provided in SIB1. The network configures this field only if the cell broadcasts more than one SNPN in SIB1. If this field is absent, as in case of a single SNPN broadcasted in SIB1, the UE shall associate all GINs in gin-ElementList to that SNPN. ","paragraph_zero_based":14206},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14207}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["0f8d48ece92e83129b77e92686621069f9bf813d33caf94eb72d1b749e42d335","082e5765554c432023c26a8e5777d8ce9a4caf8d21c5e7c7785197bfb7e9beec","f8620ccdf472147c01659dfd789ce64c25d89228b6921a84241c887388ae1590","c416e22b862218a3db0f59f359673c8f459dfd12d5e1e0b12f3ad3d64ab7c8d6","498900109aa34c01f352ae9b126b695b748a25a7149f645a85bcbb5f3014e623","e3150e67331610740d2e02cc19930a79dc9ff071538af884cd2db9fbf4aa0ece","630055cf173d33967fc0ae105425ccfd72d3d8d01bb4efe80c97f06f325e57af","c93ed7121e5102c32d02d74f1167fc7fa46e6f8500e1351d0a786f1b9654c8a1","f81219018ec2c86aebd35c5e821bc4ab8c87e0d305632ddc842c4ac4534d116e","79e71ed32bd9c6e16b370b993fc1cd3103873f7b01fb7236e27be6475e01755e","b8ba4880444eb9ddc0a1655c788d478264b9aa202bd1dd89b61d7ace3866d690","fb913ff0f1c17f111c9683c8e16ac4b7c449a9b4a4247bffba446edff8923b93","4a0b62e26b9674f150def9e9ad43ccc2414cc2c677a6dfc1522b4c4bd3321736","710987fa1ef087980d8b3d282c5ae2ae76fdef8f5a2e6f5b8f4904242a1786a2","3dcf6faad7287c5eee1a8d63c7cac479bbbc9846e9c6c907eabddfe92eb0e114","4e23b4d53a53ae7285db35c3e011c46b3800ed5a06f729ab6c08c99f1f176e23","5637ea55639993ed5f28165ad5bce7fe63c59cb78439cc8b4d1d608eb01759b2","3063b5d3e736b9979eddbe893fa0468048cd25df94d6143a64a742fb902b04ca","ca681c93bb8d6eab3c4ef03e3238e62c6c58ea579a749cb7b2946ddf1350d054","ea6e21317145285728853d928bc99e28104aef1b2ccef0befde545c52a43a033","d7f9b326862932ab7a4c6b17aaef4afd1e28cd30044e889e90927578b0bed8f8","d9734b42057cf33da944367788007653904f93d25ead7c9a8e7671e2e58b6064","411211bd81dbd980ccafa2b422a07f5ff72d783fdca81a2d2c8f13b8ee568573","e1508f2918391e419743b9cae712b5e6a1ca72745c5cb3b3ba7312e06cb7ac37"],"paragraph_range_zero_based":[14184,14207],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p14184"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"GINs-PerSNPN field descriptions","paragraph_zero_based":14208},{"literal_text_all_w_t_and_m_t":"supportedGINs","paragraph_zero_based":14209},{"literal_text_all_w_t_and_m_t":"Indicates the GINs which are supported by the given SNPN. The first/leftmost bit corresponds to the GIN with GIN index 1, the second bit corresponds to the GIN with GIN index 2 and so on. A bit set to 1 indicates that the GIN is supported by the SNPN. If the field is not present, then the corresponding SNPN does not support any GINs. ","paragraph_zero_based":14210},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14211},{"literal_text_all_w_t_and_m_t":"–SIB19","paragraph_zero_based":14212},{"literal_text_all_w_t_and_m_t":"SIB19 contains satellite assistance information for NTN access.","paragraph_zero_based":14213},{"literal_text_all_w_t_and_m_t":"SIB19 information element","paragraph_zero_based":14214},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":14215},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB19-START","paragraph_zero_based":14216},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14217},{"literal_text_all_w_t_and_m_t":"SIB19-r17 ::= SEQUENCE {","paragraph_zero_based":14218},{"literal_text_all_w_t_and_m_t":"    ntn-Config-r17                           NTN-Config-r17                                  OPTIONAL,       -- Need R","paragraph_zero_based":14219},{"literal_text_all_w_t_and_m_t":"    t-Service-r17                            INTEGER (0..549755813887)                       OPTIONAL,       -- Need R","paragraph_zero_based":14220},{"literal_text_all_w_t_and_m_t":"    referenceLocation-r17                    ReferenceLocation-r17                           OPTIONAL,       -- Need R","paragraph_zero_based":14221},{"literal_text_all_w_t_and_m_t":"    distanceThresh-r17                       INTEGER(0..65525)                               OPTIONAL,       -- Need R","paragraph_zero_based":14222},{"literal_text_all_w_t_and_m_t":"    ntn-NeighCellConfigList-r17              NTN-NeighCellConfigList-r17                     OPTIONAL,       -- Need R","paragraph_zero_based":14223},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension                 OCTET STRING                                    OPTIONAL,","paragraph_zero_based":14224},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":14225},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":14226},{"literal_text_all_w_t_and_m_t":"    ntn-NeighCellConfigListExt-v1720         NTN-NeighCellConfigList-r17                     OPTIONAL        -- Need R","paragraph_zero_based":14227},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":14228},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14229},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14230},{"literal_text_all_w_t_and_m_t":"NTN-NeighCellConfigList-r17 ::=          SEQUENCE (SIZE(1..maxCellNTN-r17))  OF NTN-NeighCellConfig-r17","paragraph_zero_based":14231}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["ffb47cf3a41bb829eca99b87ab2d90afbd6b278e4f09a5469097afbd14472a4e","62d7c5e32c1a8638ce053f84bcd265bacf5708a206a8d725388c18d334d4d485","1a034be4ed2d317cbea755eda2cf06efe95781bfc97a11dc4ef2acaf282b1e4d","364e47c9b16d9d5ab942d49500acee9c3396a7df4967134086e2435137d99cf2","397f7496bd4a528a54d5183f8cfad9cda37c90cbc360e17d25aa7985b1d910ac","234296901ff887d758d63af558697f80a32ee2c826ab83bf41f68c014813f2eb","495234d1768a7b600b917fd4e56562f58a61549f484a788695de241099a0b