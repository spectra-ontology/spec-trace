{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":12624},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12625},{"literal_text_all_w_t_and_m_t":"ULDedicatedMessageSegment field descriptions","paragraph_zero_based":12626},{"literal_text_all_w_t_and_m_t":"segmentNumber","paragraph_zero_based":12627},{"literal_text_all_w_t_and_m_t":"Identifies the sequence number of a segment within the encoded UL DCCH message. ","paragraph_zero_based":12628},{"literal_text_all_w_t_and_m_t":"rrc-MessageSegmentContainer","paragraph_zero_based":12629},{"literal_text_all_w_t_and_m_t":"Includes a segment of the encoded UL DCCH message. The size of the included segment in this container should be small enough that the resulting encoded RRC message PDU is less than or equal to the PDCP SDU size limit.","paragraph_zero_based":12630},{"literal_text_all_w_t_and_m_t":"rrc-MessageSegmentType","paragraph_zero_based":12631},{"literal_text_all_w_t_and_m_t":"Indicates whether the included UL DCCH message segment is the last segment or not.","paragraph_zero_based":12632},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12633},{"literal_text_all_w_t_and_m_t":"–ULInformationTransfer","paragraph_zero_based":12634},{"literal_text_all_w_t_and_m_t":"The ULInformationTransfer message is used for the uplink transfer of NAS or non-3GPP dedicated information, or IAB-DU specific F1-C related information.","paragraph_zero_based":12635},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB2 or SRB1 (only if SRB2 not established yet). If SRB2 is suspended, the UE does not send this message until SRB2 is resumed. If only dedicatedInfoF1c is included, SRB2 is used.","paragraph_zero_based":12636},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":12637},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":12638},{"literal_text_all_w_t_and_m_t":"Direction: UE to network","paragraph_zero_based":12639},{"literal_text_all_w_t_and_m_t":"ULInformationTransfer message","paragraph_zero_based":12640},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":12641},{"literal_text_all_w_t_and_m_t":"-- TAG-ULINFORMATIONTRANSFER-START","paragraph_zero_based":12642},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12643},{"literal_text_all_w_t_and_m_t":"ULInformationTransfer ::=           SEQUENCE {","paragraph_zero_based":12644},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                  CHOICE {","paragraph_zero_based":12645},{"literal_text_all_w_t_and_m_t":"        ulInformationTransfer               ULInformationTransfer-IEs,","paragraph_zero_based":12646},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture            SEQUENCE {}","paragraph_zero_based":12647}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["033b53f44379bc0c32c69b08816b6322fac77ee6e51a0f56fdde12d241b7972d","62e08dc77800c527304f6d3331e3e8ed82bae9cb87d6dbbd6d8e61f4b686941d","970467f2cdd9203db9c889135ba49bd66a481d5d457a41b8ee43782334adab22","f50dfb805f4b11ab612ddd4e543d278c82e2243bfc454943de06feeb33719a90","92cf4c32391abe2dfed5a79da4b6770463bcca66391700831709c5403e49ccd8","af3f1656b2b1767c7d3dc5a09a142737011ce1a10f46746746a6ab56d9472bb6","1ecaf8e1760b8f8aad8fdb61a015abad8a31c6e2035794cf184dfd5c9349b1fd","9fdf74e8c51d9506bfdbe29863d8ac895bd3d322ef51b7ce13309c5af025eb1b","d7666b69153469947f694533c0cff17974ccf2ddea8d51b26423655aa80806ab","d1500fa1af8980144f273ac451ecad9c4c0f90bac312fa07fc59909e7d5986dd","edb4c2e6c7bd7b7846052