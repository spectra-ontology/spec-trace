{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-PreconfigEUTRA-AnchorCarrierFreqList","paragraph_zero_based":42816},{"literal_text_all_w_t_and_m_t":"This field indicates the EUTRA anchor carrier frequency list, which can provide the NR sidelink communication configuration.","paragraph_zero_based":42817},{"literal_text_all_w_t_and_m_t":"sl-PreconfigFreqInfoList","paragraph_zero_based":42818},{"literal_text_all_w_t_and_m_t":"This field indicates the NR sidelink communication and/ or NR sidelink discovery configuration some carrier frequency(ies). In this release, only one SL-FreqConfig can be configured in the list.","paragraph_zero_based":42819},{"literal_text_all_w_t_and_m_t":"sl-PreconfigNR-AnchorCarrierFreqList","paragraph_zero_based":42820},{"literal_text_all_w_t_and_m_t":"This field indicates the NR anchor carrier frequency list, which can provide the NR sidelink communication configuration.","paragraph_zero_based":42821},{"literal_text_all_w_t_and_m_t":"sl-RadioBearerPreConfigList","paragraph_zero_based":42822},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple sidelink radio bearer configurations.","paragraph_zero_based":42823},{"literal_text_all_w_t_and_m_t":"sl-RLC-BearerPreConfigList","paragraph_zero_based":42824},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple sidelink RLC bearer configurations.","paragraph_zero_based":42825},{"literal_text_all_w_t_and_m_t":"sl-RoHC-Profiles","paragraph_zero_based":42826},{"literal_text_all_w_t_and_m_t":"This field indicates the supported RoHC profiles for NR sidelink communications.","paragraph_zero_based":42827},{"literal_text_all_w_t_and_m_t":"sl-SSB-PriorityNR","paragraph_zero_based":42828},{"literal_text_all_w_t_and_m_t":"This field indicates the priority of NR sidelink SSB transmission and reception.","paragraph_zero_based":42829},{"literal_text_all_w_t_and_m_t":"sl-TxProfileList","paragraph_zero_based":42830},{"literal_text_all_w_t_and_m_t":"List of one or multiple Tx profiles, indicating the compatibility of supporting SL DRX as specified in TS 38.321 [3]. It is up to the UE implementation whether/how to apply this field.","paragraph_zero_based":42831},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42832},{"literal_text_all_w_t_and_m_t":"–End of NR-Sidelink-Preconf","paragraph_zero_based":42833},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":42834},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42835},{"literal_text_all_w_t_and_m_t":"END","paragraph_zero_based":42836},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42837},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":42838},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42839}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["f307c3ebbcfbe6b3f9281e39c25e60be72c73e981b26684550172e9a09aba270","2877f591332ae79f80f7d7ca77a7414030fdb4de494b7eb4f9529826418e79ce","984d2541cb7abdb31ae1f1175b83233ee22420c46e2c96da78dccbb61bd86a34","1bac30cd2b6f2ae99e5fbf96d91b785bfa49d6e3f1561ec4bd55274e5e516ffb","13a743d95cd71775a172da27dad2f0409ee2dcddbbec2703f8f7c152fc68877f","2264c7f6b4da3801b6a8cea8824f663254c542c3c428aca1c45b8b6be7d3037d","b1ea0b8274c90528f97c837f8e4a4e72b6d0020ef2767a12a03f900ab96913ec","d34b7808b5589e69ae7da83a4dd0d9fd83d9b92c83a9043d9cec4f19b22c5c4f","118f6fe1f1fa3bb1df34c2769edd109a8e13bf0767d39caa44c2e4cdc445e669","ebb25e16ac24dd50ea243d6629da3f0a840b1c590c1d960b2fbab5ae22679eb8","07bd893070f045e4c6b4827a0f1e7476f8958871a8f879f0abc1cf5a5afbec45","64673