728},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14729},{"literal_text_all_w_t_and_m_t":"BFR-SSB-Resource ::=                SEQUENCE {","paragraph_zero_based":14730},{"literal_text_all_w_t_and_m_t":"    ssb                                 SSB-Index,","paragraph_zero_based":14731},{"literal_text_all_w_t_and_m_t":"    ra-PreambleIndex                    INTEGER (0..63),","paragraph_zero_based":14732},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":14733},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14734},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14735}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["44ea049a7a2d6d2941157ab2c82cbf718e0077086d3290641f56bd6d74df27e3","c58e2095be2172675d916285b25bedb5e44570ab33caaa0f18614c94ec869a10","ad92ebbde343ed53432703e13e5cd3610ed7f90101845b01936d17cb2ccb77f4","0b8d393874b07a0a5dd30e21269f0a31fb9a3f197487e5c50bb9b70456c62cd1","662ec9d79fdda85b496eaa5b1bdc16e32edff0d406410754c65f786a195485a2","f1889ff94b9d5bd4d6ea8845d697baff2ca82b7a836142bee4c27b7ffdf7d604","69eaaa66554cef0b36804bd04f648edcebb902bca9d4c7177123dadc0a60dba9","19e10cd6a027207c925e44885730de1f92ba0e3ebbd34a9757410725c88d3fe4","061e6b9a9965f38f7162e8680c8ebdbce1c5b8ea00aee0b45f4ef0e447b37a04","9ba0a123ea07c2de49135b3bd76977c5a1347c5701bed65d76211794869643dc","f98f2d3fdae40b02c254888de094560f798e57fdd585b2d9d4f82bfcc73372e8","05bb242809ade3c0673324671e8d6c3bcc1ece8806644c5f0eaab0485d934bf6","f9f29ddddf035a27e98ff3487668cae9c8f68df2c563a868dee0a9f314df2729","e4083baa5b123cd91b0d8b0098902f66a1ce2b29ede247efe2bc5179c33b92ba","59c7500365cef3d2cae6ea5921ff09f1e7f42a49d9b1c3799c13c81e55b523e7","3744c32ef9ec404d1489d