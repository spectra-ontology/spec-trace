paragraph_zero_based":20965},{"literal_text_all_w_t_and_m_t":"MsgA-PUSCH-Resource-r16 ::=                    SEQUENCE {","paragraph_zero_based":20966},{"literal_text_all_w_t_and_m_t":"    msgA-MCS-r16                                   INTEGER (0..15),","paragraph_zero_based":20967},{"literal_text_all_w_t_and_m_t":"    nrofSlotsMsgA-PUSCH-r16                        INTEGER (1..4),","paragraph_zero_based":20968},{"literal_text_all_w_t_and_m_t":"    nrofMsgA-PO-PerSlot-r16                        ENUMERATED {one, two, three, six},","paragraph_zero_based":20969},{"literal_text_all_w_t_and_m_t":"    msgA-PUSCH-TimeDomainOffset-r16                INTEGER (1..32),","paragraph_zero_based":20970},{"literal_text_all_w_t_and_m_t":"    msgA-PUSCH-TimeDomainAllocation-r16            INTEGER (1..maxNrofUL-Allocations)                            OPTIONAL, -- Need S","paragraph_zero_based":20971},{"literal_text_all_w_t_and_m_t":"    startSymbolAndLengthMsgA-PO-r16                INTEGER (0..127)                                              OPTIONAL, -- Need S","paragraph_zero_based":20972},{"literal_text_all_w_t_and_m_t":"    mappingTypeMsgA-PUSCH-r16                      ENUMERATED {typeA, typeB}                                     OPTIONAL, -- Need S","paragraph_zero_based":20973},{"literal_text_all_w_t_and_m_t":"    guardPeriodMsgA-PUSCH-r16                      INTEGER (0..3)                                                OPTIONAL, -- Need R","paragraph_zero_based":20974},{"literal_text_all_w_t_and_m_t":"    guardBandMsgA-PUSCH-r16                        INTEGER (0..1),","paragraph_zero_based":20975}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["6d11d1e234960edeb37016ce57b1136