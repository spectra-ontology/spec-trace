{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29904},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29905},{"literal_text_all_w_t_and_m_t":"-- TAG-UURELAYRLCCHANNELCONFIG-STOP","paragraph_zero_based":29906},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29907},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29908},{"literal_text_all_w_t_and_m_t":"Uu-RelayRLC-ChannelConfig field descriptions","paragraph_zero_based":29909},{"literal_text_all_w_t_and_m_t":"uu-LogicalChannelIdentity","paragraph_zero_based":29910},{"literal_text_all_w_t_and_m_t":"Indicates the logical channel id for Uu Relay RLC channel of the L2 U2N Relay UE.","paragraph_zero_based":29911},{"literal_text_all_w_t_and_m_t":"uu-RelayRLC-ChannelID","paragraph_zero_based":29912},{"literal_text_all_w_t_and_m_t":"Indicates the Uu Relay RLC channel in the link between L2 U2N Relay UE and network.","paragraph_zero_based":29913},{"literal_text_all_w_t_and_m_t":"reestablishRLC","paragraph_zero_based":29914},{"literal_text_all_w_t_and_m_t":"Indicates that RLC should be re-established.","paragraph_zero_based":29915},{"literal_text_all_w_t_and_m_t":"rlc-Config","paragraph_zero_based":29916},{"literal_text_all_w_t_and_m_t":"Determines the RLC mode (UM, AM) and provides corresponding parameters.","paragraph_zero_based":29917},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29918},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":29919},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":29920},{"literal_text_all_w_t_and_m_t":"RelayLCH-Setup","paragraph_zero_based":29921},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new logical channel for a Uu Relay RLC channel. It is optionally present, Need M, otherwise.","paragraph_zero_based":29922},{"literal_text_all_w_t_and_m_t":"RelayLCH-SetupOnly","paragraph_zero_based":29923},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new logical channel for a Uu Relay RLC channel. It is absent otherwise.","paragraph_zero_based":29924},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29925},{"literal_text_all_w_t_and_m_t":"–Uu-RelayRLC-ChannelID","paragraph_zero_based":29926},{"literal_text_all_w_t_and_m_t":"The IE Uu-RelayRLC-ChannelID is used to identify a Uu Relay RLC channel in the link between L2 U2N Relay UE and network.","paragraph_zero_based":29927}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["3ce962b61f3d6eb5b6f8b307d9b105a6223f8df91e4f8219379361766658f984","8cbe8cf0e04a13905c9ad0ca40b09c50d8bb0d8c18846027fdf9ad17b730adf4","59d3a5b89060f5d33375c50e6e215828931c4d629f42ab6a7f4b5fe6722adc99","1af6013fe26e20241d3557fd73addb5cf29b7a26d71e6783f69294c33d8bf948","63b29d421998fb01e7cff1304c17286b126fae370446b13680de1e814fc908f1","b4e9db49546592175643e0190c969647a05d5e8594397733e70a084d022a837d","57be1c85a7efa60f10b2d84222fc8782bbc569b6188aafdb1accb55afa46d943","1c344f504cb639bb67de22570971baa0b34df8fa7086355595c1eb5db2949fa8","9a5db84c4179242a7d1da4fd6840b6af074c34600821701482f103a1353da86e","d4e67ed07978f48916d201e064d4f2e44cb4287a8b28fdd3023d913c1d934be0","1d5ede29eeba3743df33a93d39179de883e1a45178ba005cf8cd085e8e90aa95","755b5774909e9e555b728e4c10dd615797b03b1b6c91765ab30aff492087c77f","40358fa1ddec488f9240acc3c5691b571e8eae813b2f63a327262713f2afb2db","7a37a0428bf61b7755a9b9301427508b784ca59726a88f79ed0717f662b0ac6c","46dcf30465d5385cc661d1ae3172903249c2a9ab0e85462b4ee8e26227f70b65","