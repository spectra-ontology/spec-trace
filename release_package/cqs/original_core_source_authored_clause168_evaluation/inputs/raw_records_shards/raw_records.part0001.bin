{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-LBT-FAILURERECOVERYCONFIG-STOP","paragraph_zero_based":18744},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18745},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18746},{"literal_text_all_w_t_and_m_t":"LBT-FailureRecoveryConfig field descriptions","paragraph_zero_based":18747},{"literal_text_all_w_t_and_m_t":"lbt-FailureDetectionTimer","paragraph_zero_based":18748},{"literal_text_all_w_t_and_m_t":"Timer for consistent uplink LBT failure detection (see TS 38.321 [3]). Value ms10 corresponds to 10 ms, value ms20 corresponds to 20 ms, and so on.","paragraph_zero_based":18749},{"literal_text_all_w_t_and_m_t":"lbt-FailureInstanceMaxCount","paragraph_zero_based":18750},{"literal_text_all_w_t_and_m_t":"This field determines after how many LBT failure indications received from the physical layer the UE triggers uplink LBT failure recovery (see TS 38.321 [3]). Value n4 corresponds to 4, value n8 corresponds to 8, and so on.","paragraph_zero_based":18751},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18752},{"literal_text_all_w_t_and_m_t":"–LocationInfo","paragraph_zero_based":18753},{"literal_text_all_w_t_and_m_t":"The IE LocationInfo is used to transfer available detailed location information, Bluetooth, WLAN and sensor available measurement results at the UE.","paragraph_zero_based":18754},{"literal_text_all_w_t_and_m_t":"LocationInfo information element","paragraph_zero_based":18755},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18756},{"literal_text_all_w_t_and_m_t":"-- TAG-LOCATIONINFO-START","paragraph_zero_based":18757},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18758},{"literal_text_all_w_t_and_m_t":"LocationInfo-r16 ::=      SEQUENCE {","paragraph_zero_based":18759},{"literal_text_all_w_t_and_m_t":"    commonLocationInfo-r16    CommonLocationInfo-r16          OPTIONAL,","paragraph_zero_based":18760},{"literal_text_all_w_t_and_m_t":"    bt-LocationInfo-r16       LogMeasResultListBT-r16         OPTIONAL,","paragraph_zero_based":18761},{"literal_text_all_w_t_and_m_t":"    wlan-LocationInfo-r16     LogMeasResultListWLAN-r16       OPTIONAL,","paragraph_zero_based":18762},{"literal_text_all_w_t_and_m_t":"    sensor-LocationInfo-r16   Sensor-LocationInfo-r16         OPTIONAL,","paragraph_zero_based":18763},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":18764},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18765},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18766},{"literal_text_all_w_t_and_m_t":"-- TAG-LOCATIONINFO-STOP","paragraph_zero_based":18767}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["ed76d4faa5f6d9f98fe19e0cead53b3504db54dd9dcec6cfe6353915133cd7c0","742539502a62068b6f19b28ddd197fb58fddef6dd355cada43aa1c6aafe9ae5b","ca2345c8841c589179097a036d402d04164c32fdf5ad93a7bb67e900283751ad","29eb159711631af5095fafe6e925fc78dd45cba79af7da9e3c46f81fd418a827","e0dc8a01976f5e2e6337a6e3552337b6da32ed65b6189022756cb30582d5e0d9","b73e7595779eed7b54d9e2a83fdb4278af132ace63eead39dbef464e74723030","625adf46f39e454fc1aeb7958ada7deb08a6761802d9d181e87fdf50245245ae","004ecaffdc29d3dc4b3c5eb11d832c0e213e8cefd8fa154acde6787562062b5a","16822106a896f163f847ec48952cd31a4763443ccbd12f23ec6e7c554568ef39","f9e61650434ba70ea15eb8a12ceafba64e8b3dafa8527f65d6ef68bd09ba0f6a","714b4728108c6419724fb581e990984e3c936eb2d70dd2104e875ef9f8140b9c","4aa2f10778f8f40ddd27f061daeface9bd83e1ecbfedcc290e686d2c89f083b6","0ee85e497de8c6e