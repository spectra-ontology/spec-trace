{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"FreqPriorityListDedicatedSlicing-r17 ::= SEQUENCE (SIZE (1.. maxFreq)) OF FreqPriorityDedicatedSlicing-r17","paragraph_zero_based":18600},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18601},{"literal_text_all_w_t_and_m_t":"FreqPriorityDedicatedSlicing-r17 ::=     SEQUENCE {","paragraph_zero_based":18602},{"literal_text_all_w_t_and_m_t":"     dl-ExplicitCarrierFreq-r17               ARFCN-ValueNR,","paragraph_zero_based":18603},{"literal_text_all_w_t_and_m_t":"    sliceInfoListDedicated-r17               SliceInfoListDedicated-r17                                    OPTIONAL  -- Cond Mandatory","paragraph_zero_based":18604},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18605},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18606},{"literal_text_all_w_t_and_m_t":"SliceInfoListDedicated-r17 ::=           SEQUENCE (SIZE (1..maxSliceInfo-r17)) OF SliceInfoDedicated-r17","paragraph_zero_based":18607},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18608},{"literal_text_all_w_t_and_m_t":"SliceInfoDedicated-r17 ::=               SEQUENCE {","paragraph_zero_based":18609},{"literal_text_all_w_t_and_m_t":"    nsag-IdentityInfo-r17                    NSAG-IdentityInfo-r17,","paragraph_zero_based":18610},{"literal_text_all_w_t_and_m_t":"    nsag-CellReselectionPriority-r17         CellReselectionPriority                                       OPTIONAL,  -- Need R","paragraph_zero_based":18611},{"literal_text_all_w_t_and_m_t":"    nsag-CellReselectionSubPriority-r17      CellReselectionSubPriority                                    OPTIONAL   -- Need R","paragraph_zero_based":18612},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18613},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18614},{"literal_text_all_w_t_and_m_t":"--