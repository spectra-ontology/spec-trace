{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"locationInfo","paragraph_zero_based":20592},{"literal_text_all_w_t_and_m_t":"Positioning related information and measurements.","paragraph_zero_based":20593},{"literal_text_all_w_t_and_m_t":"physCellId","paragraph_zero_based":20594},{"literal_text_all_w_t_and_m_t":"The physical cell identity of the NR cell for which the reporting is being performed.","paragraph_zero_based":20595},{"literal_text_all_w_t_and_m_t":"resultsSSB-Cell","paragraph_zero_based":20596},{"literal_text_all_w_t_and_m_t":"Cell level measurement results based on SS/PBCH related measurements.","paragraph_zero_based":20597},{"literal_text_all_w_t_and_m_t":"resultsSSB-Indexes","paragraph_zero_based":20598},{"literal_text_all_w_t_and_m_t":"Beam level measurement results based on SS/PBCH related measurements.","paragraph_zero_based":20599},{"literal_text_all_w_t_and_m_t":"resultsCSI-RS-Cell","paragraph_zero_based":20600},{"literal_text_all_w_t_and_m_t":"Cell level measurement results based on CSI-RS related measurements.","paragraph_zero_based":20601},{"literal_text_all_w_t_and_m_t":"resultsCSI-RS-Indexes","paragraph_zero_based":20602},{"literal_text_all_w_t_and_m_t":"Beam level measurement results based on CSI-RS related measurements.","paragraph_zero_based":20603},{"literal_text_all_w_t_and_m_t":"rsIndexResults","paragraph_zero_based":20604},{"literal_text_all_w_t_and_m_t":"Beam level measurement results.","paragraph_zero_based":20605},{"literal_text_all_w_t_and_m_t":"timeBetweenEvents","paragraph_zero_based":20606},{"literal_text_all_w_t_and_m_t":"Indicates the time elapsed between fulfilling the conditional execution conditions included in choConfig. Value in milliseconds. The maximum value 1023 means 1023ms or longer. This field may be included only in the reports associated to UEInformationResponse message, e.g., rlf-Report.","paragraph_zero_based":20607},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20608},{"literal_text_all_w_t_and_m_t":"MeasResultUTRA-FDD field descriptions","paragraph_zero_based":20609},{"literal_text_all_w_t_and_m_t":"physCellId","paragraph_zero_based":20610},{"literal_text_all_w_t_and_m_t":"The physical cell identity of the UTRA-FDD cell for which the reporting is being performed.","paragraph_zero_based":20611},{"literal_text_all_w_t_and_m_t":"utra-FDD-EcN0","paragraph_zero_based":20612},{"literal_text_all_w_t_and_m_t":"According to CPICH_Ec/No in TS 25.133 [46] for FDD.","paragraph_zero_based":20613},{"literal_text_all_w_t_and_m_t":"utra-FDD-RSCP","paragraph_zero_based":20614},{"literal_text_all_w_t_and_m_t":"According to CPICH_RSCP in TS 25.133 [46] for FDD.","paragraph_zero_based":20615}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["3c0ec13a045877690c4d6866e51dfca1d6771908981787108a132f92cf156fca","32933b02dddebc0dedad84063ea5e3da85098a74a3171276fd3f2b5ff034195c","be7ddf5a783633197c99a360fc347e7d1aa101eff314f0f607535412aa99db28","9d13128563f461038413e5d843fa05e35e0ac1ab48729c00e8becb62042c8d05","4a8272c0a011a2786dedcc3188f875c3d4cfdde1b0ff4b1cb6e24e1da11de8c2","07003c2bf71d6e779ca19a8fb27d77b62ca9ba73166dec098ce9235c139689f0","9314257cc6d809a9464b2d65d77ffe440898f6e7440fc44a073ca7cb827e2490","ed59c5871e42613795f19f4a538fa010c5fbf950141c5df18ad838f1b9e53229","ebe1b6e71c0338e3791c85de4657a665b4487105b20418b3756e27e6ca4fe4c3","e74e54473eacbd24dd68a58b5f1050f94e9cc0ffcfbe6b9807418cb6495a180d","9a969683c3df3dc2fc5c6d4373f4425e76a7719d9bbe3cff111d8808c55d584c","a54b74782b0b8fb0913937747aa480de99a6cd83eb271fcbc8bd2230f4e8a8da","b778fff