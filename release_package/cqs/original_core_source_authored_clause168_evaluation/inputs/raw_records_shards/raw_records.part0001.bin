{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE BWP-DownlinkCommon is used to configure the common parameters of a downlink BWP. They are \"cell specific\" and the network ensures the necessary alignment with corresponding parameters of other UEs. The common parameters of the initial bandwidth part of the PCell are also provided via system information. For all other serving cells, the network provides the common parameters via dedicated signalling.","paragraph_zero_based":14664},{"literal_text_all_w_t_and_m_t":"BWP-DownlinkCommon information element","paragraph_zero_based":14665},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":14666},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-DOWNLINKCOMMON-START","paragraph_zero_based":14667},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14668},{"literal_text_all_w_t_and_m_t":"BWP-DownlinkCommon ::=              SEQUENCE {","paragraph_zero_based":14669},{"literal_text_all_w_t_and_m_t":"    genericParameters                   BWP,","paragraph_zero_based":14670},{"literal_text_all_w_t_and_m_t":"    pdcch-ConfigCommon                  SetupRelease { PDCCH-ConfigCommon }                                     OPTIONAL,   -- Need M","paragraph_zero_based":14671},{"literal_text_all_w_t_and_m_t":"    pdsch-ConfigCommon                  SetupRelease { PDSCH-ConfigCommon }                                     OPTIONAL,   -- Need M","paragraph_zero_based":14672},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":14673},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14674},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14675},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-DOWNLINKCOMMON-STOP","paragraph_zero_based":14676},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":14677},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14678},{"literal_text_all_w_t_and_m_t":"BWP-DownlinkCommon field descriptions","paragraph_zero_based":14679},{"literal_text_all_w_t_and_m_t":"pdcch-ConfigCommon","paragraph_zero_based":14680},{"literal_text_all_w_t_and_m_t":"Cell specific parameters for the PDCCH of this BWP. This field is absent for a dormant BWP.","paragraph_zero_based":14681},{"literal_text_all_w_t_and_m_t":"pdsch-ConfigCommon","paragraph_zero_based":14682},{"literal_text_all_w_t_and_m_t":"Cell specific parameters for the PDSCH of this BWP.","paragraph_zero_based":14683},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14684},{"literal_text_all_w_t_and_m_t":"–BWP-DownlinkDedicated","paragraph_zero_based":14685},{"literal_text_all_w_t_and_m_t":"The IE BWP-DownlinkDedicated is used to configure the dedicated (UE specific) parameters of a downlink BWP.","paragraph_zero_based":14686},{"literal_text_all_w_t_and_m_t":"BWP-DownlinkDedicated information element","paragraph_zero_based":14687}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["42066cfc7844c4425766e50224ad24242a1b51201310bb7f307f893ada385279","1680e84dabb0b4e1e08fa8275ca71ba21bbefa8542e8d31560fe0266009319a3","5315c8ca5dce88881d8d2059b54503a5292789e078b33be9753375cddde71f3c","a7eea6095c45da67f5d59710718b964f9fdfe82f146d5893ce315175d8a27641","2c50c6458a3dc5a8b2a0860469edd5d0bb0e7d56c01d88af05b4aff879cafd44","7d977fcfed0202f8bc2e837f245cf6beac55d3726e743426baf9a49c8d8b8495","548e8043fa4f01456215edeacf82522c3dcefb5d48ac31ec30f466962f819f69","9b80bf3c54bb72081f742220f34938856da97796de481ffae61ff8fd3b8658be","806336e1f72ed499590667567f989f23ec76aa29151b7efb79ea938f37ec32e8","187220d2c7f69eae9c75535fc51d9e