rityNR-r16                INTEGER (1..8)                                                         OPTIONAL     -- Need R","paragraph_zero_based":13953},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":13954},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13955},{"literal_text_all_w_t_and_m_t":"SL-NR-AnchorCarrierFreqList-r16 ::=  SEQUENCE (SIZE (1..maxFreqSL-NR-r16)) OF ARFCN-ValueNR","paragraph_zero_based":13956},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13957},{"literal_text_all_w_t_and_m_t":"SL-EUTRA-AnchorCarrierFreqList-r16 ::= SEQUENCE (SIZE (1..maxFreqSL-EUTRA-r16)) OF ARFCN-ValueEUTRA","paragraph_zero_based":13958},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13959},{"literal_text_all_w_t_and_m_t":"SL-DiscConfigCommon-r17 ::=   SEQUENCE {","paragraph_zero_based":13960},{"literal_text_all_w_t_and_m_t":"    sl-RelayUE-ConfigCommon-r17   SL-RelayUE-Config-r17,","paragraph_zero_based":13961},{"literal_text_all_w_t_and_m_t":"    sl-RemoteUE-ConfigCommon-r17  SL-RemoteUE-Config-r17","paragraph_zero_based":13962},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":13963},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13964},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB12-STOP","paragraph_zero_based":13965},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":13966},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13967}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["b25309d0722bbc976aa5ca2629d23fb866589d8cc61322a2844e16ca118ad439","56761c696710f6a121faec12aeabef3500b4c519f7aadb2e316a5ec6cb1de256","6e1d4cff46a92b1b50ffe736e4dee38fc1abcf0f2b79860cf6a8e50996852c9f","6a535eed8da4b351fa0c76af6a615efcc4d38dae17ff2019bc36fc371740801e","5811755b3b296da7658ce91711553db9c86fc0dd8b9582dd43f2afe67c89a5b4","99d790f8fd927714c0558d99a3107613ee10f216e8d68d82d4090d199c254b1f","678df0703b0b9481ee0fac878554af9fae00159a0c1f1cabe6a73b45e49bec4a","f04252e2f559ba107def0b5c62cf8c4c68e8bae464755271f28b2b0fe373b5d2","9aa70aeea4d64970bd47035956e8c1a5a13f812453508cef72d5738942c532e2","e10ea6e6ae169a261dd15780e91e354c2c540a5e1d83d9dc3a0bff7d4b2c96d1","239fefb083595b41a686e655cbe0643c85a3970eaece144b67cfaf00a558928a","92c16df09d483a37a0c9901dd807f405c6606119e0c5c43ea0611b6f9f5d0440","956028e04d84516d05ffb662876ba02f1e4d8f8643ba377c4a6c89ef59af797b","9e25648c746d554d44c1bb666fc7c149a5a52d67af33b1a209490927233556f3","2ad47bae47187b8c48aa342e97d6cae43d8a0b7a0cfb9b327aeff8961c939b9c","ab93065cf9248fa736fdcd5d6d9f59f1bf2418236f1c68e51398738f4c1fa354","0ce275f7df2a962253926ce131ff57ce3d72332078b6f311ab8af8f6effe052f","0c52805d665d3df205714944a66a6c085faf6d3e8a5f717bbe96bd0c2d1a8779","2b5aa2a232f8eb39b2a0fb12ddd3eeaed3c645c99bb441264d0a146197e8ae06","95dcc0944a33e23f5cf3f234695dfb90f900012ba8e4a6c645c7f49056a007d7","78e0342698b9b126c8b6749a33df56a7d3ac50016db70f59b0506019fc01bc98","453c66443631380355ae94f62896fd9d95a026ccc1fa5935b68fb7b47b3d70d4","3bb8c5beb33b12dda8b1d4fdae82de9f955efd802003bc5b12635610cbe76844","d39f1ac83cd7cc3a7084d4072a0362eff52fc111604098adbc426168a7b1825e"],"paragraph_range_zero_based":[13944,13967],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p13944"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SIB12 field descriptions","paragraph_zero_based":13968},{"literal_text_all_w_t_and_m_t":"segmentContainer","paragraph_zero_based":13969},{"literal_text_all_w_t_and_m_t":"This field includes a segment of the encoded SIB12-IEs. The size of the included segment in this container should be small enough that the SIB message size is less than or equal to the maximum size of a NR SI, i.e. 2976 bits when SIB12 is broadcast.","paragraph_zero_based":13970},{"literal_text_all_w_t_and_m_t":"segmentNumber","paragraph_zero_based":13971},{"literal_text_all_w_t_and_m_t":"This field identifies the sequence number of a segment of SIB12-IEs. A segment number of zero corresponds to the first segment, A segment number of one corresponds to the second segment, and so on.","paragraph_zero_based":13972},{"literal_text_all_w_t_and_m_t":"segmentType","paragraph_zero_based":13973},{"literal_text_all_w_t_and_m_t":"This field indicates whether the included segment is the last segment or not.","paragraph_zero_based":13974},{"literal_text_all_w_t_and_m_t":"sl-CSI-Acquisition","paragraph_zero_based":13975},{"literal_text_all_w_t_and_m_t":"This field indicates whether CSI reporting is enabled in sidelink unicast. If not set, SL CSI reporting is disabled.","paragraph_zero_based":13976},{"literal_text_all_w_t_and_m_t":"sl-DRX-ConfigCommonGC-BC","paragraph_zero_based":13977},{"literal_text_all_w_t_and_m_t":"This field indicates the sidelink DRX configuration for groupcast and broadcast communication, as specified in TS 38.321 [3]. This field, if present, also indicates the gNB is capable of sidelink DRX.","paragraph_zero_based":13978},{"literal_text_all_w_t_and_m_t":"sl-EUTRA-AnchorCarrierFreqList","paragraph_zero_based":13979},{"literal_text_all_w_t_and_m_t":"This field indicates the EUTRA anchor carrier frequency list, which can provide the NR sidelink communication configurations.","paragraph_zero_based":13980},{"literal_text_all_w_t_and_m_t":"sl-FreqInfoList","paragraph_zero_based":13981},{"literal_text_all_w_t_and_m_t":"This field indicates the NR sidelink communication/discovery configuration on some carrier frequency (ies). In this release, only one entry can be configured in the list.","paragraph_zero_based":13982},{"literal_text_all_w_t_and_m_t":"sl-L2U2N-Relay","paragraph_zero_based":13983},{"literal_text_all_w_t_and_m_t":"This field indicates the support of NR sidelink Layer-2 relay.","paragraph_zero_based":13984},{"literal_text_all_w_t_and_m_t":"sl-L3U2N-RelayDiscovery","paragraph_zero_based":13985},{"literal_text_all_w_t_and_m_t":"This field indicates the support of L3 U2N relay AS-layer capability, i.e. NR sidelink relay discovery.","paragraph_zero_based":13986},{"literal_text_all_w_t_and_m_t":"sl-MaxNumConsecutiveDTX","paragraph_zero_based":13987},{"literal_text_all_w_t_and_m_t":"This field indicates the maximum number of consecutive HARQ DTX before triggering sidelink RLF. Value n1 corresponds to 1, value n2 corresponds to 2, and so on.","paragraph_zero_based":13988},{"literal_text_all_w_t_and_m_t":"sl-MeasConfigCommon","paragraph_zero_based":13989},{"literal_text_all_w_t_and_m_t":"This field indicates the measurement configurations (e.g. RSRP) for NR sidelink communication.","paragraph_zero_based":13990},{"literal_text_all_w_t_and_m_t":"sl-NonRelayDiscovery","paragraph_zero_based":13991}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["4880cd98387a981a23e538d9655e9f20573a68c81a03623230a1c53e4c540915","5a85de97e70ba13b4e196aa908e237f2b9992e01a092d981d4d7165