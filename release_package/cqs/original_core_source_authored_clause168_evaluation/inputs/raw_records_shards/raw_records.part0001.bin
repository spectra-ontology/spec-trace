{"fields":{"filename":"R2-2401316.zip::R2-2401316 BLE.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"aoa-advConfig (0),","paragraph_zero_based":408},{"literal_text_all_w_t_and_m_t":"aoa-cteConfig (1)} (SIZE(1..8))OPTIONAL,-- Need ON","paragraph_zero_based":409},{"literal_text_all_w_t_and_m_t":"bt-suggestedAoA-Config-r18BT-SuggestedAoA-Config-r18OPTIONAL-- Need ON","paragraph_zero_based":410},{"literal_text_all_w_t_and_m_t":"]]","paragraph_zero_based":411},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":412},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":413},{"literal_text_all_w_t_and_m_t":"BT-SuggestedAoA-Config-r18 ::= SEQUENCE {","paragraph_zero_based":414},{"literal_text_all_w_t_and_m_t":"cteStatus-r18ENUMERATED {enabled, disabled}OPTIONAL,-- Need ON","paragraph_zero_based":415},{"literal_text_all_w_t_and_m_t":"primaryAdvInterval-r18INTEGER (32..16777)OPTIONAL,-- Need ON","paragraph_zero_based":416},{"literal_text_all_w_t_and_m_t":"secondAdvInterval-r18INTEGER (6..65535)OPTIONAL,-- Need ON","paragraph_zero_based":417},{"literal_text_all_w_t_and_m_t":"txPower-r18INTEGER (-127..20)OPTIONAL,-- Need ON","paragraph_zero_based":418},{"literal_text_all_w_t_and_m_t":"cteLength-r18INTEGER (2..20)OPTIONAL,-- Need ON","paragraph_zero_based":419},{"literal_text_all_w_t_and_m_t":"cteCount-r18INTEGER (1..16)OPTIONAL,-- Need ON","paragraph_zero_based":420},{"literal_text_all_w_t_and_m_t":"tx-PHY-M2-r18ENUMERATED { m2 }OPTIONAL,-- Need ON","paragraph_zero_based":421},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":422},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":423},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":424},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":425},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":426},{"literal_text_all_w_t_and_m_t":"BT-RequestLocationInformation field descriptions","paragraph_zero_based":427},{"literal_text_all_w_t_and_m_t":"requestedMeasurements","paragraph_zero_based":428},{"literal_text_all_w_t_and_m_t":"This field specifies the Bluetooth measurements requested. This is represented by a bit string, with a onevalue at the bit position means the particular measurement is requested; a zerovalue means not requested. The following measurement requests can be included:","paragraph_zero_based":429},{"literal_text_all_w_t_and_m_t":"rssi: Bluetooth beacon signal strength at the target","paragraph_zero_based":430},{"literal_text_all_w_t_and_m_t":"aod: Estimated AoD per Bluetooth beacon","paragraph_zero_based":431}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"038bee5e08277a518e210695a9ad796eb7669167fb359201516fcfc3784430d8","original_member_sha256":"e32d7846969fb9d73f3e6db306c1eaae26983884f0f33261ecdad12458f09ea1","paragraph_ElementTree_utf8_XML_sha256":["08bf801343c09b283c226bb8fe51bf02466fff35029bdbd9badfee5f9bd61e63","f4ec008702752e5c6fc836a9afa330cd479ff8c86c9c8e5e3fc37ce90896e6b5","de9507cdbf9981daa084cf60cc84c2babb798e93fe9cf786047e923fc42f277f","8af31df20b32d5c8608328ec85de2cb487c9ff74fb0cf101d655550881c864c9","71dec707ead0abf76b15e4434ed012a44800a5d5696cfb2657247d4facc79f29","56b6b47517b83316fb4eeb3c8590b9b73ec57c1e82d38a9ad942ab0e35ba157a","64dbd1307353dc721da613d10605222b6e2404f34dc3f579f3fd3a45eaccf6ec","8e5c40760011dbe82768fa3dde28af5ff8108fe733ca52b4f316214653f491ad","9f94401e69894d37f6d9b4dfbd7784bd68c67f3f50fc59ced0beb9bc3140f7a8","bd3843ddf384e6b24cefa2d0bfa8b82026ec73271d57d77a94f4a8ea09d02b4a","81614c1c6a093178fca874fa2fc585abb5934617769f6375f79c3f2e116f8478","420f398323af06a2d4b23bf8c62124ff8ce888ebe75ca3b08e8e15d6795047f3","eef57c87074700f1b8b48fa0f33adea77b1f4ce213ebae164c815c0d876717a9","3f6d0088c0cb32d3cf02fc49acdd5c8717ee470bd4e24eb1c803a3a464288b8a","04f1024b6972418a8b47cb59cb38005c4ba80ec60611ccadc14b1a83fbc8c283","3b7b84df6b0e891407bedeecfd98dccb6ba211562e181cbbb2b33edd809971b7","8c472b801f726f5a50fd98e8b82f5a697565e3c9559b98e01574e7e6cc04f7ac","871f4c299f0808ccf68f99e626c02120877c6e2323cbee1ef45d5d5fbc29d21e","ac12d6853e863765286936ce3de257d472db22710d931517cc57cf7f9f957d3f","50f1dc46d7971f8bb28da41144373e825cf0d82e60fb342f17992d614bb2d6b7","9710b673163500ace4f9bfa8a80f29734a013ab4fbf9970b18c1cb74d6bb2095","39275441330e66e84fd29071963f8870006da24a0ae7a20dc8201930165fc3cb","4fe161757d7a93dc0190348d0ea590efae69a678490eccd238d40ac114775424","4443e2d19cd5d9a324a38a7d246bf9c8956268db329d1fc5534229b81fd5ca95"],"paragraph_range_zero_based":[408,431],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2401316.zip::R2-2401316 BLE.docx:p408"}
{"fields":{"filename":"R2-2401316.zip::R2-2401316 BLE.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"bt-requestedAoA-Config","paragraph_zero_based":432},{"literal_text_all_w_t_and_m_t":"This field specifies the Bluetooth AoA configuration parameters requested. This is represented by a bit string, with a onevalue at the bit position means the particular measurement is requested; a zerovalue means not requested. The following information requests can be included:","paragraph_zero_based":433},{"literal_text_all_w_t_and_m_t":"aoa-advConfig: The Bluetooth advertisement address and periodic intervals of the device","paragraph_zero_based":434},{"literal_text_all_w_t_and_m_t":"aoa-cteConfig: The configured CTE status, length, count and PHY","paragraph_zero_based":435},{"literal_text_all_w_t_and_m_t":"cteStatus","paragraph_zero_based":436},{"literal_text_all_w_t_and_m_t":"This field suggests the Bluetooth AoA transmission status of the device, and is used by the location server to suggest BLE AoA transmission of the device to be enabled or disabled:","paragraph_zero_based":437},{"literal_text_all_w_t_and_m_t":"enabled: Bluetooth AoA transmission is suggested enabled","paragraph_zero_based":438},{"literal_text_all_w_t_and_m_t":"disabled: Bluetooth AoA transmission is suggested disabled ","paragraph_zero_based":439},{"literal_text_all_w_t_and_m_t":"primaryAdvInterval","paragraph_zero_based":440},{"literal_text_all_w_t_and_m_t":"This field suggests the Bluetooth primary advertisement channel periodicity of the device, scaling factor 0.625 ms [53].","paragraph_zero_based":441},{"literal_text_all_w_t_and_m_t":"secondAdvInterval","paragraph_zero_based":442},{"literal_text_all_w_t_and_m_t":"This field suggests the Bluetooth periodic advertising interval on secondary advertisement channels of the device, scaling factor 0.625 ms [53].","paragraph_zero_based":443},{"literal_text_all_w_t_and_m_t":"txPower","paragraph_zero_based":444},{"literal_text_all_w_t_and_m_t":"This field suggests the Bluetooth advertising TX power in dBm of the device [53].","paragraph_zero_based":445},{"literal_text_all_w_t_and_m_t":"cteLength","paragraph_zero_based":446},{"literal_text_all_w_t_and_m_t":"This field suggests the CTE length ofthe device in number of 8us segments.","paragraph_zero_based":447},{"literal_text_all_w_t_and_m_t":"cteCount","paragraph_zero_based":448},{"literal_text_all_w_t_and_m_t":"This field suggests the number of Bluetooth packets that include a CTE of the device each periodic advertising event","paragraph_zero_based":449},{"literal_text_all_w_t_and_m_t":"tx-PHY-M2","paragraph_zero_based":450},{"literal_text_all_w_t_and_m_t":"This field, if present and set to m2, suggests that Bluetooth TX PHY 2 Megasymbols/s is used for AoA, otherwise Bluetooth TX PHY 1 Megasymbols/s is suggested to be used by the device,","paragraph_zero_based":451},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":452},{"literal_text_all_w_t_and_m_t":"6.5.7.4Bluetooth Capability Information","paragraph_zero_based":453},{"literal_text_all_w_t_and_m_t":"–BT-ProvideCapabilities","paragraph_zero_based":454},{"literal_text_all_w_t_and_m_t":"The IE BT-ProvideCapabilites is used by the target device to provide its capabilities for Bluetooth positioning to the location server.","paragraph_zero_based":455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"038bee5e08277a518e210695a9ad796eb7669167fb359201516fcfc3784430d8","original_member_sha256":"e32d7846969fb9d73f3e6db306c1eaae26983884f0f33261ecdad12458f09ea1","paragraph_ElementTree_utf8_XML_sha256":["fcd666f93be9b612a107497a3e2fab852903cf6af81bef0c4089402cc0ad0367","9a11f5e62d06c50e0a5ea468fa8fdebfa80c97c9dc092a00b1163a26fb2b6ce2","d02670f2d46b03c119187b60a0086a23bcd4fe858b3a2f3bf95a4c6aa5c590a6","83d795b32d0d79ca2e521b0f3177acdd365b21359a6f