{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE DRX-Config-PTM is used to configure DRX related parameters for PTM transmission as specified in TS 38.321 [3].","paragraph_zero_based":39840},{"literal_text_all_w_t_and_m_t":"DRX-Config-PTM information element","paragraph_zero_based":39841},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39842},{"literal_text_all_w_t_and_m_t":"-- TAG-DRX-CONFIGPTM-START","paragraph_zero_based":39843},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39844},{"literal_text_all_w_t_and_m_t":"DRX-ConfigPTM-r17 ::=             SEQUENCE {","paragraph_zero_based":39845},{"literal_text_all_w_t_and_m_t":"    drx-onDurationTimerPTM-r17        CHOICE {","paragraph_zero_based":39846},{"literal_text_all_w_t_and_m_t":"        subMilliSeconds                   INTEGER (1..31),","paragraph_zero_based":39847},{"literal_text_all_w_t_and_m_t":"        milliSeconds                      ENUMERATED {","paragraph_zero_based":39848},{"literal_text_all_w_t_and_m_t":"            ms1, ms2, ms3, ms4, ms5, ms6, ms8, ms10, ms20, ms30, ms40, ms50, ms60,","paragraph_zero_based":39849},{"literal_text_all_w_t_and_m_t":"            ms80, ms100, ms200, ms300, ms400, ms500, ms600, ms800, ms1000, ms1200,","paragraph_zero_based":39850},{"literal_text_all_w_t_and_m_t":"            ms1600, spare8, spare7, spare6, spare5, spare4, spare3, spare2, spare1","paragraph_zero_based":39851},{"literal_text_all_w_t_and_m_t":"        }","paragraph_zero_based":39852},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":39853},{"literal_text_all_w_t_and_m_t":"    drx-InactivityTimerPTM-r17        ENUMERATED {","paragraph_zero_based":39854},{"literal_text_all_w_t_and_m_t":"            ms0, ms1, ms2, ms3, ms4, ms5, ms6, ms8, ms10, ms20, ms30, ms40, ms50, ms60, ms80,","paragraph_zero_based":39855},{"li