{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preferred number of carriers for power saving.","paragraph_zero_based":37224},{"literal_text_all_w_t_and_m_t":"maxBW-PreferenceConfigFR2-2","paragraph_zero_based":37225},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preferred bandwidth for power saving for FR2-2.","paragraph_zero_based":37226},{"literal_text_all_w_t_and_m_t":"maxCC-PreferenceProhibitTimer","paragraph_zero_based":37227},{"literal_text_all_w_t_and_m_t":"Prohibit timer for preferred number of carriers assistance information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":37228},{"literal_text_all_w_t_and_m_t":"maxMIMO-LayerPreferenceConfig","paragraph_zero_based":37229},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preferred number of MIMO layers for power saving.","paragraph_zero_based":37230},{"literal_text_all_w_t_and_m_t":"maxMIMO-LayerPreferenceConfigFR2-2","paragraph_zero_based":37231},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preferred number of MIMO layers for power saving for FR2-2.","paragraph_zero_based":37232},{"literal_text_all_w_t_and_m_t":"maxMIMO-LayerPreferenceProhibitTimer","paragraph_zero_based":37233},{"literal_text_all_w_t_and_m_t":"Prohibit timer for preferred number of number of MIMO layers assistance information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":37234},{"literal_text_all_w_t_and_m_t":"minSchedulingOffsetPreferenceConfig","paragraph_zero_based":37235},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preferred minimumSchedulingOffset value for cross-slot scheduling for power saving.","paragraph_zero_based":37236},{"literal_text_all_w_t_and_m_t":"minSchedulingOffsetPreferenceConfigExt","paragraph_zero_based":37237},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preferred minimumSchedulingOffset value for cross-slot scheduling for power saving for SCS 480 kHz and/or 960 kHz.","paragraph_zero_based":37238},{"literal_text_all_w_t_and_m_t":"minSchedulingOffsetPreferenceProhibitTimer","paragraph_zero_based":37239},{"literal_text_all_w_t_and_m_t":"Prohibit timer for preferred minimumSchedulingOffset assistance information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":37240},{"literal_text_all_w_t_and_m_t":"musim-GapAssistanceConfig","paragraph_zero_based":37241},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information for gap preference.","paragraph_zero_based":37242},{"literal_text_all_w_t_and_m_t":"musim-GapProhibitTimer","paragraph_zero_based":37243},{"literal_text_all_w_t_and_m_t":"Prohibit timer for MUSIM assistance information reporting for gap preference.","paragraph_zero_based":37244},{"literal_text_all_w_t_and_m_t":"musim-LeaveAssistanceConfig","paragraph_zero_based":37245},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information for leaving RRC_CONNECTED for MUSIM purpose.","paragraph_zero_based":37246},{"literal_text_all_w_t_and_m_t":"musim-LeaveWithoutResponseTimer","paragraph_zero_based":37247}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["b62a2eac815c9092a41cf5e8bb31ffa46b16c934dd1f2e38ef2a45c59d82086d","84dd79c3fc9623682c548079172eb7f5e7a09414d4dcbf5df90e9e151aeb81f9","9313b4485bad13efa9cf7720e853cfa15b6b66ff2861376a0d0f559e40d7cf4a","1677924a0ca9c77aaaf27180cdb705f0a0a088ebb338599da357f7db5fa8cc6c","4cfb3adc7a168eaf877fe0ae85268b6c4281a0fa9fa0e9263c77f99b3a4148b3","a9bfcdbe868b4b765f0ec08d139a8b9ab1891d1254e2441acaef30e8fef59f49","5a9c2bfe7f249cd220716e64763980474bc93a61b7e953144f1d2862ac1f18ca","402f9d59e818656933fe1b526ab81ab549683ba2b5246e3e0a614ddb15f539ae","5084445c1a307eafcc2497926cd4a37730c930ef8a37bceaf75881b64019f754","95056286f9f2567613797e5544ff9fb5faf5da74c8da905a11d088351c106435","09bb308485c0268412363b8efa7aa3ab3ee32b8925e1ea62d90190b2dda82d55","ca3325e8177875b2873e56739f4faa7ce117f3885dd5925e85dea7808adf3b82","5321955c0413fb4d8ee15c0918621376d647c2cdbeb824d52b995796834b14ca","4cabb4c8d3fca4579582ea484067ca14da65d36dce9ddbeca80a06f4f5ccdb56","796e6790123e3ebb2fcd584f271636ec6b3c5e123ddb5b7425a837eaad027fe5","09380375f32e7bc2e26b802165beaaded7eed939982a367f5a191b9eb058cab6","fada58a35462af1648db5aff4dfb7dbfa44bd0349236e3c2c5e6f6f930c00d05","53918d9d414b7533d35b74e8b6b67f16fe6ddd4b20c0daa817e91fa17bc94b7b","7dd6408c8b68c3eda48d18cd322669b78c2a4b0fbbc99b1d79a27a6b5310f218","adcecd7d657c5a15f6bcb8bd7ed31f56f8658162b11fcc0f8d3ff92f0351504c","9866f67bba59b2d13ac3c36d21c092891e166994e2b125cc24b539433bbe88f9","b72adb3f84cb027ce6b7715120c93155ca5516b4b5ed320022ce170b0c36cc67","14e3c625bd819ad9c9caaf68dd220b6218293eb57a47efea34a3f2b60d14b15e","5bbf581c40db7b2bd866d6bbab72c802f5121e649f16d0c4b2cc6d42a0e0e042"],"paragraph_range_zero_based":[37224,37247],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p37224"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the timer for the UE to enter RRC_IDLE for MUSIM purpose as defined in clause 5.3.8.6.","paragraph_zero_based":37248},{"literal_text_all_w_t_and_m_t":"obtainCommonLocation","paragraph_zero_based":37249},{"literal_text_all_w_t_and_m_t":"Requests the UE to attempt to have detailed location information available using GNSS. NR configures the field if includeCommonLocationInfo is configured for one or more measurements.","paragraph_zero_based":37250},{"literal_text_all_w_t_and_m_t":"overheatingAssistanceConfig","paragraph_zero_based":37251},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about UE detected internal overheating.","paragraph_zero_based":37252},{"literal_text_all_w_t_and_m_t":"overheatingIndicationProhibitTimer","paragraph_zero_based":37253},{"literal_text_all_w_t_and_m_t":"Prohibit timer for overheating assistance information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":37254},{"literal_text_all_w_t_and_m_t":"propDelayDiffReportConfig","paragraph_zero_based":37255},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report service link propagation delay difference between serving cell and neighbour cell(s).","paragraph_zero_based":37256},{"literal_text_all_w_t_and_m_t":"referenceTimePreferenceReporting","paragraph_zero_based":37257},{"literal_text_all_w_t_and_m_t":"If present, the field indicates the UE is configured to provide reference time assistance information.","paragraph_zero_based":37258},{"literal_text_all_w_t_and_m_t":"releasePreferenceConfig","paragraph_zero_based":37259},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preference to leave RRC_CONNECTED state.","paragraph_zero_based":37260},{"literal_text_all_w_t_and_m_t":"rlm-RelaxationReportingConfig","paragraph_zero_based":37261},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report the relaxation state of RLM measurements.","paragraph_zero_based":37262},{"literal_text_all_w_t_and_m_t":"releasePreferenceProhibitTimer","paragraph_zero_based":37263},{"literal_text_all_w_t_and_m_t":"Prohibit timer for release preference assistance information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on. Value infinity means that once a UE has reported a release preference, the UE cannot report a release preference again during the RRC connection.","paragraph_zero_based":37264},{"literal_text_all_w_t_and_m_t":"s-SearchDeltaP-Stationary","paragraph_zero_based":37265},{"literal_text_all_w_t_and_m_t":"Parameter \"SSearchDeltaP-StationaryConnected\" in 5.7.4.4. Value dB2 corresponds to 2 dB, dB3 corresponds to 3 dB and so on.","paragraph_zero_based":37266},{"literal_text_all_w_t_and_m_t":"scg-DeactivationPreferenceConfig","paragraph_zero_based":37267},{"literal_text_all_w_t_and_m_t":"Configuration of the UE to indicate its preference for SCG deactivation.","paragraph_zero_based":37268},{"literal_text_all_w_t_and_m_t":"scg -StatePreferenceProhibitTimer","paragraph_zero_based":37269},{"literal_text_all_w_t_and_m_t":"Prohibit timer for UE indication of its preference for SCG deactivation. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":37270},{"literal_text_all_w_t_and_m_t":"sensorNameList","paragraph_zero_based":37271}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["7d821c0bde5b3ffbadf1b30692c504fc7383c7fca0650b5be988d59f1d676ad7","4b6a816fc40a3d21dcbf0c85a609cf57792394319e26e35a9efa7719f0f4fd8d","348cbf117340cbbb33c8dc8f5da0e01f2e7f7c3db336dad6f5982404add5df39","a0469cab6fe76285fc8667509e4e13bbc6e02e09634a71dce3988a85e80d9266","637c29412076b815f1af3381dad57710c2069dfc5d1c234390749a4d8910bd42","96dcb9de33964e17e766832ca0cbbdb8ef1e98eff8b15b1a5d23e79a3608de4c","0dc79d213f1d73e898d2f34abff90cbd35bdca24427af240c0549bc55f4c1810","58a33c0fa44be1294f4a38a382670394e092b3e48099648785676c5071c94166","1fce3212c65b035472d9a0fbe06cee1c98317d78add0e22b71cd58d76f9865f9","c59f2b2f513446e0f6cdbe98d4e59e69249f7191291d15550be19635d3e91d75","d9c1ad3f2a026c038f3044308f72cfec7353f10337de4d915260beb69654c341","00b80943a18a63b6968587736cbbd7175f085321f477046f2874398160dde189","cc54d81fe29087b5f5c22f4ff76abd56c4e82f4d2d0558b1877b07e505f289ee","c0fe8dcf50b802169efe95c9e586a3b822594f74de9049d2ed91ced1456d48b9","4b6091582142c8bf8c2369b08c08402c56b5fb8ebc739b83f2fdf77c9ad6d77f","be58c969757412389fa1001130493245db7312fab31a6d3db475cfc4a150137f","7bd7447bf8fbdcb17ad262ef8d509deb25ac510e45ead49198fc690166fda614","2e696b03081b77acbe65866a42c51b81fbef9cc14f671d5221265e12187f1943","96f153d28cbc21ed9fd5dd10cdfbe888d1b67d75541e1912e82632eec00153ba","c8af4ed2cd3f9c23140bf41ef6ffa74edb314ad863b752b9917007d0ac203781","4ba8881ede2cf80ac4bb0e4d51ba459d2c2b2fe96308a967903af6fc607c2242","cd6cca7903cac884e70962cb53ff57f839dc348307c6723e0b24885162984c9e","30b8777973ab9781c69b34deafb89ad857850d47478cc585664628b2a00a39b1","f521d7dfa62da24c012bd94b8e03ff8f176a6a3087a918c6012013a4544fddde"],"paragraph_range_zero_based":[37248,37271],"projection":"All w:t and m:t including tracked insertion/deletion runs; not