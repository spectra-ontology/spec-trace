{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"PDCCH-ServingCellConfig ::=         SEQUENCE {","paragraph_zero_based":22296},{"literal_text_all_w_t_and_m_t":"    slotFormatIndicator                 SetupRelease { SlotFormatIndicator }                                OPTIONAL,   -- Need M","paragraph_zero_based":22297},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":22298},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":22299},{"literal_text_all_w_t_and_m_t":"    availabilityIndicator-r16           SetupRelease {AvailabilityIndicator-r16}                            OPTIONAL,   -- Need M","paragraph_zero_based":22300},{"literal_text_all_w_t_and_m_t":"    searchSpaceSwitchTimer-r16          INTEGER (1..80)                                                     OPTIONAL    -- Need R","paragraph_zero_based":22301},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":22302},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":22303},{"literal_text_all_w_t_and_m_t":"    searchSpaceSwitchTimer-v1710        INTEGER (81..1280)                                                  OPTIONAL    -- Need R","paragraph_zero_based":22304},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":22305},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22306},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22307},{"literal_text_all_w_t_and_m_t":"-- TAG-PDCCH-SERVINGCELLCONFIG-STOP","paragraph_zero_based":22308},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":22309},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22310},{"literal_text_all_w_t_and_m_t":"PDCCH-ServingCellConfig field descriptions","paragraph_zero_based":22311},{"literal_text_all_w_t_and_m_t":"availabilityIndicator","paragraph_zero_based":22312},{"literal_text_all_w_t_and_m_t":"Use to configure monitoring a PDCCH for Availability Indicators (AI).","paragraph_zero_based":22313},{"literal_text_all_w_t_and_m_t":"searchSpaceSwitchTimer","paragraph_zero_based":22314},{"literal_text_all_w_t_and_m_t":"The value of the timer in slots for monitoring PDCCH in the active DL BWP of the serving cell before moving to the default search space group (see TS 38.213 [13], clause 10.4).","paragraph_zero_based":22315},{"literal_text_all_w_t_and_m_t":"For 15 kHz SCS, {1..20} are valid.","paragraph_zero_based":22316},{"literal_text_all_w_t_and_m_t":"For 30 kHz SCS, {1..40} are valid.","paragraph_zero_based":22317},{"literal_text_all_w_t_and_m_t":"For 60kHz SCS, {1..80} are valid.","paragraph_zero_based":22318},{"literal_text_all_w_t_and_m_t":"For 120 kHz SCS, {1..160} are valid.","paragraph_zero_based":22319}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["85cce7b6156152d57b78d8138eadf6842941666d3c9ca900b797cc683572c2d5","c15db8072bb8ae83a92385b8a16c5e85b33e0dacdbc116650dc5de1dc69b714d","2ace8943c479df8b77ffb05f56d79154ebe54b8ae507faa1b284f91cddce9a43","0555339f439c6ef48551a3ed804c1e981a90d1c59cded41851d1b855637ce13a","2b6a22bd69d51351bf737e7fe3ca35d8e1c3b72e4a00b9bfe9dc75b7220d4b35","83136520fa6bd973bcb6c696da0fe761045cd27f0f83f09920f99f47e94df25b","910afa73332441aa70900f8bed5189fec96e1dbd20df917a203e4cff69788c53","2aaf500c38355da0a5d4de8f8044a1dcc70368e7f885a9209e8d3cf65e5216f2","3ed0c7639841df40c62b9ed9562b49f28a2cde3208f8d911c8f9b01b10bcc802","d90444a8c42f7d09942336251a04f4d51b6b4805aa10f454e862314bb5e3ff1b","44592f5ba71725672572fdf1f6c788d2203978259a0c9f1d152d6876b8eb6b0b","5f5e83990a856507adda4f1b68faaefff973c78a7a6c8ba12ccc00fbd1065251","a8d6fbb7c427