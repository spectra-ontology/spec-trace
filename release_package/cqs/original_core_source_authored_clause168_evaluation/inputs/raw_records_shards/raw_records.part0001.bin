V-RRC-CR.docx:p28344"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–SK-Counter","paragraph_zero_based":28368},{"literal_text_all_w_t_and_m_t":"The IE SK-Counter is a counter used upon initial configuration of SN security for NR-DC and NE-DC, as well as upon refresh of S-KgNB or S-KeNB based on the current or newly derived KgNB during RRC Resume or RRC Reconfiguration, as defined in TS 33.501 [11].","paragraph_zero_based":28369},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28370},{"literal_text_all_w_t_and_m_t":"-- TAG-SKCOUNTER-START","paragraph_zero_based":28371},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28372},{"literal_text_all_w_t_and_m_t":"SK-Counter ::=  INTEGER (0..65535)","paragraph_zero_based":28373},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28374},{"literal_text_all_w_t_and_m_t":"-- TAG-SKCOUNTER-STOP","paragraph_zero_based":28375},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28376},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28377},{"literal_text_all_w_t_and_m_t":"–SlotFormatCombinationsPerCell","paragraph_zero_based":28378},{"literal_text_all_w_t_and_m_t":"The IE SlotFormatCombinationsPerCell is used to configure the SlotFormatCombinations applicable for one serving cell (see TS 38.213 [13], clause 11.1.1).","paragraph_zero_based":28379},{"literal_text_all_w_t_and_m_t":"SlotFormatCombinationsPerCell information element","paragraph_zero_based":28380},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28381},{"literal_text_all_w_t_and_m_t":"-- TAG-SLOTFORMATCOMBINATIONSPERCELL-START","paragraph_zero_based":28382},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28383},{"literal_text_all_w_t_and_m_t":"SlotFormatCombinationsPerCell ::=   SEQUENCE {","paragraph_zero_based":28384},{"literal_text_all_w_t_and_m_t":"    servingCellId                       ServCellIndex,","paragraph_zero_based":28385},{"literal_text_all_w_t_and_m_t":"    subcarrierSpacing                   SubcarrierSpacing,","paragraph_zero_based":28386},{"literal_text_all_w_t_and_m_t":"    subcarrierSpacing2                  SubcarrierSpacing                                                         OPTIONAL, -- Need R","paragraph_zero_based":28387},{"literal_text_all_w_t_and_m_t":"    slotFormatCombinations              SEQUENCE (SIZE (1..maxNrofSlotFormatCombinationsPerSet)) OF SlotFormatCombination","paragraph_zero_based":28388},{"literal_text_all_w_t_and_m_t":"                                                                                                                  OPTIONAL, -- Need M","paragraph_zero_based":28389},{"literal_text_all_w_t_and_m_t":"    positionInDCI                       INTEGER(0..maxSFI-DCI-PayloadSize-1)                                      OPTIONAL, -- Need M","paragraph_zero_based":28390},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":28391}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["0225c15ea286aaabf81ad385f6a6a3b983e4b58b057318447d22053c5f3adbd2","4a143aae72605f7c23efb7b846aa456578b7456efa6cd90f1bf97ae2cb1d4ffe","96ed0e3fd96591dcf23ee918c670d52009401ee50c4bdf35163aa31284c425e9","bddb289581461928d1ab1baccacce38331dea934c4ca9eb95626b8030bf831a8","5e39ae4cfc3fd775e076c1f360ebddd0c661678d5539bb379f064461834996aa","04e6e7abe075a24031bb9544a43d17123c9af6ab100704447307834a066e097e","9d51a60999bce40224a8e68568802741f607dcede33098535e1a1e0ce9ceb7ce","3234963606c186c954fd19af9387e4781a968f4bfb5c865a79f5414cb902c0e1","e27ab4180d81d0a50fe55610601b733ca21c05c76ebbfdfef