{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":16752},{"literal_text_all_w_t_and_m_t":"        pattern1                                SEQUENCE {","paragraph_zero_based":16753},{"literal_text_all_w_t_and_m_t":"            subcarrierLocation-p1                   ENUMERATED { s0, s4, s8 },","paragraph_zero_based":16754},{"literal_text_all_w_t_and_m_t":"            symbolLocation-p1                       INTEGER (0..13)","paragraph_zero_based":16755},{"literal_text_all_w_t_and_m_t":"        }","paragraph_zero_based":16756},{"literal_text_all_w_t_and_m_t":"    }                                                                                   OPTIONAL,   -- Need M","paragraph_zero_based":16757},{"literal_text_all_w_t_and_m_t":"    freqBand                            CSI-FrequencyOccupation                         OPTIONAL,   -- Need M","paragraph_zero_based":16758},{"literal_text_all_w_t_and_m_t":"    periodicityAndOffset                CSI-ResourcePeriodicityAndOffset                OPTIONAL,   -- Cond PeriodicOrSemiPersistent","paragraph_zero_based":16759},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":16760},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":16761},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16762},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-IM-RESOURCE-STOP","paragraph_zero_based":16763},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":16764},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16765},{"literal_text_all_w_t_and_m_t":"CSI-IM-Resource field descriptions","paragraph_zero_based":16766},{"literal_text_all_w_t_and_m_t":"csi-IM-ResourceElementPattern","paragraph_zero_based":16767},{"literal_text_all_w_t_and_m_t":"The resource element pattern (Pattern0 (2,2) or Pattern1 (4,1)) with corresponding parameters (see TS 38.214 [19], clause 5.2.2.4)","paragraph_zero_based":16768},{"literal_text_all_w_t_and_m_t":"freqBand","paragraph_zero_based":16769},{"literal_text_all_w_t_and_m_t":"Frequency-occupancy of CSI-IM (see TS 38.214 [19], clause 5.2.2.4)","paragraph_zero_based":16770},{"literal_text_all_w_t_and_m_t":"periodicityAndOffset","paragraph_zero_based":16771},{"literal_text_all_w_t_and_m_t":"Periodicity and slot offset for periodic/semi-persistent CSI-IM. Network always configures the UE with a value for this field for periodic and semi-persistent CSI-IM-Resources (as indicated in CSI-ResourceConfig). A change of configuration between periodic or semi-persistent and aperiodic for a CSI-IM-Resource is not supported without a release and add.","paragraph_zero_based":16772},{"literal_text_all_w_t_and_m_t":"subcarrierLocation-p0","paragraph_zero_based":16773},{"literal_text_all_w_t_and_m_t":"OFDM subcarrier occupancy of the CSI-IM resource for Pattern0 (see TS 38.214 [19], clause 5.2.2.4)","paragraph_zero_based":16774},{"literal_text_all_w_t_and_m_t":"subcarrierLocation-p1","paragraph_zero_based":16775}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["9400c5f1ec6e63b69c73500df69aad60f5bd3e040e902140663a364607c13dad","557ce78d253f5cc7572c64295e963bddc7c1ab481fb319089f5f697902f4cc9f","c6148a698d859322bf5b89ffa5a275deed7c7841551a900825e0a7f04bd6106b","cfc67e08a6aa369ff71bec385f2308391895c09609af35d63b433f9a8fa94c23","0d3d1315ac6e0205ecfeaa46b8265d8b0090a85efe7c9decf09d190c749e3830","62436dd6185df94ba0dbc7d1c12b2bed0929507a7462079a0079f4a1976617e3","0c6e6d77312e3bd582b50a752d34b9acf9dd096a00a2284b17471c8bcea1b0b7","e4accf21fbb8675358bfced28f9859dffab685807b2b2f