40fb4de161702d3d3d178d6db2d3aaae35d4d4037955437e3c111","fab402cc8a2ee6662b2ba86a60ba44423469256adfdb396cb4481f08b27d9e76","fc9927f8fa130973f2f257aa04267a5d676c3a550bb62cc63a9b872a64961b3f","132008083dfebc6fea388a1c34a23f7d24bf25fa5b6ffe53a49af23af2f6db7d","30de1dfaf55d5db7fa1d9c95eaa94f9c7c8d68a8f353fae1fb4d96bd390d228c","9d0298c03331c817c7713a02c206c0aeedd8b378441c43fa9ca6a1ed064387cd","c9a8fd3a89b058231aff9845ce95a7aefd4bfe9947842bd36bb333b05104fddc","63eb758dd6b9668e4e4a3dfefbec2809c2c32251a3e468da87bbf68873e34dde","62597cd80c56bf98a8307564b15a209d49a03bd21b471ba60f55f0656e6af564","9ddb46cfe63cef10a1965b79c03716aab33bb6592fc1ad9c79b0dd3d6beae95c","613a0a07e76e176cb63fd17325b46b323ff6f9b500e69ca0a7e520d4e22b73c3","f5ab4f30a5d7687b50a354ee4f04edf01d276883f100b32a25828bbb2c245f65","89c59487efa1de0b0b199d8913c14fa82eeba84afd74be9f5e7c7d7bc133ada6","b91ee9828bed0af215704f60da37f71a1585f301969146a057022ecf97876dac","5fbef03f8e0edf21a7c341b01e4a6f47b4d91d2962824d40f1f9005b46bcfde1","5870e26e7601216289a851845172239192b5761295cbb76bdabee025e15ae449","c29705d31fb5b837f81a35886425b54817f83b0a978d35fe064054fc8f2827de","4f10ace37ec00af9eb5cccb2b187964357d69d982bc9206e2d5bf653dec9adb3","e99446e36820e214f807656e1d77c43688544332628013793bac9312295851cf","48cdbc163c2ed7e4c22289ebf82e7a2e60ed0477a857026bdffdccb47cef4eca","adc2a9695844b2db339e84539d1ba755305801f56ed99aba0ae156d19abf8360"],"paragraph_range_zero_based":[28224,28247],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p28224"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"harq-ProcID-Offset","paragraph_zero_based":28248},{"literal_text_all_w_t_and_m_t":"Indicates the offset used in deriving the HARQ process IDs, see TS 38.321 [3], clause 5.3.1.","paragraph_zero_based":28249},{"literal_text_all_w_t_and_m_t":"mcs-Table","paragraph_zero_based":28250},{"literal_text_all_w_t_and_m_t":"Indicates the MCS table the UE shall use for DL SPS (see TS 38.214 [19],clause 5.1.3.1. If present, the UE shall use the MCS table of low-SE 64QAM table indicated in Table 5.1.3.1-3 of TS 38.214 [19]. If this field is absent and field mcs-table in PDSCH-Config is set to 'qam256' and the activating DCI is of format 1_1, the UE applies the 256QAM table indicated in Table 5.1.3.1-2 of TS 38.214 [19]. If this field is absent and the field mcs-Table-r17 in PDSCH-Config is set to 'qam1024' and the activating DCI is format 1_1, the UE applies the 1024QAM table indicated in Table 5.1.3.1-4 of TS 38.214 [19]. Otherwise, the UE applies the non-low-SE 64QAM table indicated in Table 5.1.3.1-1 of TS 38.214 [19].","paragraph_zero_based":28251},{"literal_text_all_w_t_and_m_t":"n1PUCCH-AN","paragraph_zero_based":28252},{"literal_text_all_w_t_and_m_t":"HARQ resource for PUCCH for DL SPS. The network configures the resource either as format0 or format1. The actual PUCCH-Resource is configured in PUCCH-Config and referred to by its ID. See TS 38.213 [13], clause 9.2.3.","paragraph_zero_based":28253},{"literal_text_all_w_t_and_m_t":"n1PUCCH-AN-PUCCHsSCell","paragraph_zero_based":28254},{"literal_text_all_w_t_and_m_t":"HARQ resource for PUCCH on PUCCH switching SCell (sSCell) for DL SPS. The network configures the resource either as format 0 or format 1. The actual PUCCH-Resource is configured in PUCCH-Config of the PUCCH sSCell and referred to by its ID. See TS 38.213 [13], clause 9.2.3.","paragraph_zero_based":28255},{"literal_text_all_w_t_and_m_t":"nrofHARQ-Processes","paragraph_zero_based":28256},{"literal_text_all_w_t_and_m_t":"Number of configured HARQ processes for SPS DL (see TS 38.321 [3], clause 5.8.1). If UE is configured with nrofHARQ-Processes-v1710 UE shall ignore nrofHARQ-Processes (without suffix).","paragraph_zero_based":28257},{"literal_text_all_w_t_and_m_t":"pdsch-AggregationFactor","paragraph_zero_based":28258},{"literal_text_all_w_t_and_m_t":"Number of repetitions for SPS PDSCH (see TS 38.214 [19], clause 5.1.2.1). When the field is absent, the UE applies the value 1 for MBS multicast data and the pdsch-AggregationFactor in pdsch-Config for other data.","paragraph_zero_based":28259},{"literal_text_all_w_t_and_m_t":"periodicity","paragraph_zero_based":28260},{"literal_text_all_w_t_and_m_t":"Periodicity for DL SPS (see TS 38.214 [19] and TS 38.321 [3], clause 5.8.1).","paragraph_zero_based":28261},{"literal_text_all_w_t_and_m_t":"periodicityExt","paragraph_zero_based":28262},{"literal_text_all_w_t_and_m_t":"This field is used to calculate the periodicity for DL SPS (see TS 38.214 [19] and see TS 38.321 [3], clause 5.8.1). If this field is present, the field periodicity is ignored.","paragraph_zero_based":28263},{"literal_text_all_w_t_and_m_t":"The following periodicities are supported depending on the configured subcarrier spacing [ms]:","paragraph_zero_based":28264},{"literal_text_all_w_t_and_m_t":"15 kHz:periodicityExt, where periodicityExt has a value between 1 and 640.","paragraph_zero_based":28265},{"literal_text_all_w_t_and_m_t":"30 kHz:0.5 x periodicityExt, where periodicityExt has a value between 1 and 1280.","paragraph_zero_based":28266},{"literal_text_all_w_t_and_m_t":"60 kHz with normal CP.0.25 x periodicityExt, where periodicityExt has a value between 1 and 2560.","paragraph_zero_based":28267},{"literal_text_all_w_t_and_m_t":"60 kHz with ECP:0.25 x periodicityExt, where periodicityExt has a value between 1 and 2560.","paragraph_zero_based":28268},{"literal_text_all_w_t_and_m_t":"120 kHz:0.125 x periodicityExt, where periodicityExt has a value between 1 and 5120.","paragraph_zero_based":28269},{"literal_text_all_w_t_and_m_t":"480 kHz:0.03125 x periodicityExt, where periodicityExt has a value between 1 and 20480.","paragraph_zero_based":28270},{"literal_text_all_w_t_and_m_t":"960 kHz:0.015625 x periodicityExt, where periodicityExt has a value between 1 and 40960.","paragraph_zero_based":28271}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["fefc256c878d07d7ab4c60596b38a8560c7c740082386b9754841e194349ce64","4186fb3645c4cbc2e734c63a899dd0a534a346447a3e3fd98582dd486b44c354","2798af273d56588990638b51215304deca98350d2d246a095b0049ffc67b8dc0","60f374dcb7fefef0a638adb1e4a8ad544b257d446cfa3a72f32b3062995911ed","9accaa541759d6059aca2f42076ed96555fb300328a868df77e3bfeaa677a8de","1602c0766406d19e82297ffe8ea79a9f42658c6e6500bd51aaa12a903010524f","9dd9064a1432c0d196c7810547300fc2ea10555a3b3eeae774601d427d89c594","df9d6a1aa55b64f44eda33e56fa3f4a7d9a30158db9196326f154ae1162dcf00","578c0eebee5c96ebfbbc8aac6394cfbea44f10076b8676562552e255a8a10bcf","366fa2482ee44f0d348298be1637b1e1843e82431faaeadc408538fd76136a59","cea3a7f3be23bc6900ead1834cf127f2b8618e6a488d9fc09bab1b3a89ce5a13","15055f5157314d0e5b7131dd5b50205707816192de73e51e048855f0844db8a2","7212bf74b8bf0247f73fcc74cfee366531a3537d74da613f93a8ba5aff0872fa","cfdc3bb900ea9a0cbe10ee72b0b4d800f6cec30f29ff9b5fcfead46dacd06128","549ba0d7aa31b96638bdbeb4d2505eb5389037e1289c4f4e214b22be421919e9","d7e95081f215a2439d9c1ec7974b4f556790482e43c934672b26124b5a34f5a8","3ea702208f9604c8f90579bf42a96b5542246bdf11a4e0e0fa54b6441c05bc3a","b19f69ca051247ccf43f78e014e5f23635b2514ed768d6f01c7b4a4019f16a3a","a0368ced77005a468f474f152c7195cbd514481d49ec3db0ef0d4ca061d0cbd5","d9f90e3d2319be9565f0fd138abbac0ce66702db52e6162ac6d03e022882fca5","7899650ec939141d6c11225634c8db815fa25dceeff22d43012548fdd076d786","0b536d445420a16ad0a64ca3ec89a597d2b62502ded4608df86125c1eb216060","a62bb55f9d75215b052e660854545c22b7be40e31381974966fa9b01775c3305","31a298749f5fe1dd698a591bf6f007f3ac96e6b24e169ee568dc12b98b3bcad1"],"paragraph_range_zero_based":[28248,28271],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p28248"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"periodicityExt-r17 is only applicable for SCS 480 kHz and 960 kHz.","paragraph_zero_based":28272},{"literal_text_all_w_t_and_m_t":"sps-ConfigIndex","paragraph_zero_based":28273},{"literal_text_all_w_t_and_m_t":"Indicates the index of one of multiple SPS configurations.","paragraph_zero_based":28274},{"literal_text_all_w_t_and_m_t":"sps-HARQ-Deferral","paragraph_zero_based":28275},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of slots or subslots the transmission of DL SPS HARQ-ACK in a slot or subslot can be deferred (see TS 38.213 [13], clause 9.2.5.4).","paragraph_zero_based":28276},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28277},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":28278},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":28279},{"literal_text_all_w_t_and_m_t":"SPS-List","paragraph_zero_based":28280},{"literal_text_all_w_t_and_m_t":"The field is mandatory present when included in sps-ConfigToAddModList-r16 or sps-ConfigMulticastToAddModList-r17, otherwise the field is absent.","paragraph_zero_based":28281},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28282},{"literal_text_all_w_t_and_m_t":"–SPS-ConfigIndex","paragraph_zero_based":28283},{"literal_text_all_w_t_and_m_t":"The IE SPS-ConfigIndex is used to indicate the index of one of multiple DL SPS configurations in one BWP.","paragraph_zero_based":28284},{"literal_text_all_w_t_and_m_t":"SPS-ConfigIndex information element","paragraph_zero_based":28285},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28286},{"literal_text_all_w_t_and_m_t":"-- TAG-SPS-CONFIGINDEX-START","paragraph_zero_based":28287},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28288},{"literal_text_all_w_t_and_m_t":"SPS-ConfigIndex-r16             ::= INTEGER (0.. maxNrofSPS-Config-1-r16)","paragraph_zero_based":28289},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28290},{"literal_text_all_w_t_and_m_t":"-- TAG-SPS-CONFIGINDEX-STOP","paragraph_zero_based":28291},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28292},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28293},{"literal_text_all_w_t_and_m_t":"–SPS-PUCCH-AN","paragraph_zero_based":28294},{"literal_text_all_w_t_and_m_t":"The IE SPS-PUCCH-AN is used to indicate a PUCCH resource for HARQ ACK and configure the corresponding maximum payload size for the PUCCH resource.","paragraph_zero_based":28295}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["90a69ae9ac3307e2e41b82906014e2b7e8df267aa0484b9dbee9081593e6b80c","b9e60a5bb1a4592023b4acff586731e9eedfac5770f55d0ea328efcd9d3e198f","407ccacc8a79ab60ac519ed785705070ab58e7d9e1cdee498348bf12dee6daf7","ca53e6cb41740cbc1b2a18d781913bd4fa33d568da92995c0561d9874e9d2473","f4672c89e2f326c094e5290b49e470b0c5228e0c161e84cb36579e0b4ff599a9","081d60604f2e5ea2f2fc84b7d0741e19af354d3f207fb3d510e56edea0567b13","e80cc7a60a59b3789c9b076009b84437d31d8e7993f3eabaed6cb41624384a48","a17b865c41ab609142d46f17e0e0fe39851bcfae26d6b780fc161909a3427823","02c9e6d4547949233fd97d363d83ec2f16590895509ff9e42f424eb2f83a97c1","eb63ed0290ecb913f74f1b739b85224229baf1da7dd1bfe3692383c613408e27","70cbe3e28dc88cf78612b3e0547f91e166fa38d4658bf1a9ee9176ee7a346b8c","f36237872fb21eadbad482c4c251a9b0dcd1ef6012a97bc46e97f74cb4e22d51","156e60f3cc75ad6ddefca2ea5e35f9c85912cc68fe1455ca1924184ed21052fb","ec800f4cf71f620f16cbdec9d57448176c25afae1b04e13e1a759ac74265803e","96aa6779de5