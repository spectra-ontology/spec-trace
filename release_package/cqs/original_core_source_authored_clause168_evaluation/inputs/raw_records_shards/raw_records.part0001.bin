7aa13","b0f113ad8133ee5debbdb686ef584ad87ebcbd7d4117e7cabeee4f7a5971142c","2ce258e12e59255983a80c4065f64ed1b2dc336325dd374799db862e602feaba","d7e5fae6cf40869d4bfc04d19285d758e7804640da79a80db33ce601cc119d7a","95608e59e65acd19d000d5d034c89497cc0a47afa9e3b910d3c4fbf3336cca74","22eb42ea75a1f6a2b5c36bddca6d490b6d33a961bc40e94e0330919e9a464b45","839aca1c20836f8849e45ca3b03f6f3fe6d054d6a01f6a88157c2554547cb92d","f4af174bc8f3b3a8b1be5f460d868af5250fdcaff6d3f256c56822ce42573c59","1de0590503b5935d5ea49c23aad90c242d0256940ace7154849f7e1734b995c9","10f97686bf2eb82c648c3592845129fb87a7878b6a2b820ef38c93f210a236d2","d41d97431fb98e5e3aad4099e22ea5878240f8381e17acd625095ecf860ef57b","b79a788d8a6e7c18f4a8715f90d86ab8eebe0df0299687b963ce82906af98aa0"],"paragraph_range_zero_based":[29424,29447],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p29424"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"TDD-UL-DL-ConfigDedicated field descriptions","paragraph_zero_based":29448},{"literal_text_all_w_t_and_m_t":"slotSpecificConfigurationsToAddModList","paragraph_zero_based":29449},{"literal_text_all_w_t_and_m_t":"The slotSpecificConfigurationToAddModList allows overriding UL/DL allocations provided in tdd-UL-DL-configurationCommon, see TS 38.213 [13], clause 11.1. ","paragraph_zero_based":29450},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29451},{"literal_text_all_w_t_and_m_t":"TDD-UL-DL-ConfigDedicated-IAB-MT field descriptions","paragraph_zero_based":29452},{"literal_text_all_w_t_and_m_t":"slotSpecificConfigurationsToAddModList-IAB-MT","paragraph_zero_based":29453},{"literal_text_all_w_t_and_m_t":"The slotSpecificConfigurationToAddModList-IAB-MT allows overriding UL/DL allocations provided in tdd-UL-DL-configurationCommon with a limitation that effectively only flexible symbols can be overwritten in Rel-16.","paragraph_zero_based":29454},{"literal_text_all_w_t_and_m_t":"slotSpecificConfigurationsToReleaseList-IAB-MT","paragraph_zero_based":29455},{"literal_text_all_w_t_and_m_t":"The slotSpecificConfigurationsToReleaseList-IAB-MT allows release of a set of slot configuration previously add with slotSpecificConfigurationToAddModList-IAB-MT.","paragraph_zero_based":29456},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29457},{"literal_text_all_w_t_and_m_t":"TDD-UL-DL-SlotConfig field descriptions","paragraph_zero_based":29458},{"literal_text_all_w_t_and_m_t":"nrofDownlinkSymbols","paragraph_zero_based":29459},{"literal_text_all_w_t_and_m_t":"Number of consecutive DL symbols in the beginning of the slot identified by slotIndex. If the field is absent the UE assumes that there are no leading DL symbols. (see TS 38.213 [13], clause 11.1).","paragraph_zero_based":29460},{"literal_text_all_w_t_and_m_t":"nrofUplinkSymbols","paragraph_zero_based":29461},{"literal_text_all_w_t_and_m_t":"Number of consecutive UL symbols in the end of the slot identified by slotIndex. If the field is absent the UE assumes that there are no trailing UL symbols. (see TS 38.213 [13], clause 11.1).","paragraph_zero_based":29462},{"literal_text_all_w_t_and_m_t":"slotIndex","paragraph_zero_based":29463},{"literal_text_all_w_t_and_m_t":"Identifies a slot within a slot configuration period given in tdd-UL-DL-configurationCommon, see TS 38.213 [13], clause 11.1.","paragraph_zero_based":29464},{"literal_text_all_w_t_and_m_t":"symbols","paragraph_zero_based":29465},{"literal_text_all_w_t_and_m_t":"The direction (downlink or uplink) for the symbols in this slot. Value allDownlink indicates that all symbols in this slot are used for downlink; value allUplink indicates that all symbols in this slot are used for uplink; value explicit indicates explicitly how many symbols in the beginning and end of this slot are allocated to downlink and uplink, respectively.","paragraph_zero_based":29466},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29467},{"literal_text_all_w_t_and_m_t":"TDD-UL-DL-SlotConfig-IAB-MT field descriptions","paragraph_zero_based":29468},{"literal_text_all_w_t_and_m_t":"symbols-IAB-MT","paragraph_zero_based":29469},{"literal_text_all_w_t_and_m_t":"The symbols-IAB-MT is used to configure an IAB-MT with the SlotConfig applicable for one serving cell. Value allDownlink indicates that all symbols in this slot are used for downlink; value allUplink indicates that all symbols in this slot are used for uplink; value explicit indicates explicitly how many symbols in the beginning and end of this slot are allocated to downlink and uplink, respectively; value explicit-IAB-MT indicates explicitly how many symbols in the beginning and end of this slot are allocated to uplink and downlink, respectively.","paragraph_zero_based":29470},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29471}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["cfd2bceb7a88831fca059445f0bd30a6b95aa79cfeac3ffa02b06c0177b4f8e6","70e6f09b30fa408ad38ad73c88e91a81acbc13527280744ad9ef13d41e083904","c0a43f8e79929eb00da9ea9134e947a5cb0c3d63b739984b3428d3e03897b194","78547b76ae9485a5c5d2604b70d13249323910c679d171d91c28b9e59fc1f02c","b852bfcb60c7da25d0752e86b5a7b9ba70979d5007b8b73e06aa68ddf47438bd","72d14ae7292a57822d37b942276ee07d97d0450210b0ade5cefcd37c800e73ca","f8666324a91a28915efa184bf49734b26f76f58db26bb25859b01a6f940d1b87","d2696f6eb9e25a8c81ca78d56342b36c5947648942b8ff60db07da01c7579b48","1788f02d07a8b43f457a463b5588d46989c70f36f5c27f07e9c21d05d2d843d2","1fe43e7ae50be6703debe1cef10da906aa67cd518aa67d97ba47e5a398e56a0a","fde03dfd92c9075d48c6ea99ec7b4940b59171c168e8abed3fd24561f41377f9","15fdb18713f0ec50362050fac2c3fea620a563a6c669c29a172ae199f07becf5","867b4cf533a7c81d2396b706395e8682ae3fb83c87710cfe11d1a6080a16b003","9437750270aa5a98d7031e27521bae7b081e04b0a546f4b545d7ceffb1b734c6","0fe54cbffe90188442f6a83e7855e0f777a8b28b4197a96a2525aa25ad1c3f40","a91d311ce3756596cf730ed1a5db9d6657d1e185a29dcf89410538279612214d","bab316914a11cf283b3e135fdef681ab156be3afb7be9b956666dc8fa028cf2b","304458d6d148c62d24403143dcf058f7486bf9859eb294ab52a36b233c7a249e","653e9ed951c8f3654a40d7a8f7189f4b3021f5d4f3bcc18e1e604f7585666f10","415c23adb6c6f032e17a48066c3bc308bf37b44552abf367465da5641727bb40","d561eb0ae40250feee1abbe6ba636aca55a85a52c26d91f9efe7da7b3ab3f786","dce81dc83792d451bfd6048703288baa18f3cb19a7e7f0a0e5d4e9b09434aa7e","1fc304e42e8c56552f21c688ecb13006f7b8ba32ac63859c82ba753d067e04db","99cb4f8583e5d1ce4be954a38d5afa4d71b10d