{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18408},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18409},{"literal_text_all_w_t_and_m_t":"DRX-ConfigSL field descriptions","paragraph_zero_based":18410},{"literal_text_all_w_t_and_m_t":"drx-HARQ-RTT-TimerSL","paragraph_zero_based":18411},{"literal_text_all_w_t_and_m_t":"For sidelink configured grant Type 1, value in number of symbols of the activated DL BWP of PCell. For other cases, value in number of symbols of the BWP where the PDCCH was transmitted. Value 0 is used in case sl-PUCCH-Config is not configured and the corresponding resource pool is not configured with PSFCH.","paragraph_zero_based":18412},{"literal_text_all_w_t_and_m_t":"drx-RetransmissionTimerSL","paragraph_zero_based":18413},{"literal_text_all_w_t_and_m_t":"For sidelink configured grant Type 1, value in number of slot lengths of the activated DL BWP of PCell. For other cases, value in number of slot lengths of the BWP where the PDCCH was transmitted. sl0 corresponds to 0 slots, sl1 corresponds to 1 slot, sl2 corresponds to 2 slots, and so on.","paragraph_zero_based":18414},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18415},{"literal_text_all_w_t_and_m_t":"–EphemerisInfo","paragraph_zero_based":18416},{"literal_text_all_w_t_and_m_t":"The IE EphemerisInfo provides satellite ephemeris. Ephemeris may be expressed either in format of position and velocity state vector in ECEF or in format of orbital parameters in ECI. Note: The ECI and ECEF coincide at epochTime, i.e., x,y,z axis in ECEF are aligned with x,y,z axis in ECI at epochTime.","paragraph_zero_based":18417},{"literal_text_all_w_t_and_m_t":"EphemerisInfo information element","paragraph_zero_based":18418},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18419},{"literal_text_all_w_t_and_m_t":"-- TAG-EPHEMERISINFO-START","paragraph_zero_based":18420},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18421},{"literal_text_all_w_t_and_m_t":"EphemerisInfo-r17 ::=          CHOICE {","paragraph_zero_based":18422},{"literal_text_all_w_t_and_m_t":"    positionVelocity-r17           PositionVelocity-r17,","paragraph_zero_based":18423},{"literal_text_all_w_t_and_m_t":"    orbital-r17                    Orbital-r17","paragraph_zero_based":18424},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18425},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18426},{"literal_text_all_w_t_and_m_t":"PositionVelocity-r17 ::=       SEQUENCE {","paragraph_zero_based":18427},{"literal_text_all_w_t_and_m_t":"    positionX-r17                  PositionStateVector-r17,","paragraph_zero_based":18428},{"literal_text_all_w_t_and_m_t":"    positionY-r17                  PositionStateVector-r17,","paragraph_zero_based":18429},{"literal_text_all_w_t_and_m_t":"    positionZ-r17                  PositionStateVector-r17,","paragraph_zero_based":18430},{"literal_text_all_w_t_and_m_t":"    velocityVX-r17                 VelocityStateVector-r17,","paragraph_zero_based":18431}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["8d986c339b8e0d8fd5cd9c452c43f549219c1375af8c8e0b29d04602fedc867e","9070a72ba4b64c20d58948838af7fdc3bd69b2cc552eb93c13bf8d8b3a0ebb1f","76a2e849bb0f066c3bb1564254540d0cfcd4ccfd11aa196c081f5e6158bed951","c03db4fb98e32e00497fbc9a9b5dfd38e61298b5c0b69a62688c1da93beb38f5","7ea95a88837ef4a2e5fb8c18e2c6bfe6dad8516359981a9eaa914d407b66e456","de2d1514fc3ce6033ea7785bafb5a58cbbc061683bdfab3306d9cc06bdfe7220","e013b7aa3f7536b76a7f7dc4d5b7a