I-Info-Logging-r16","paragraph_zero_based":36688},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36689},{"literal_text_all_w_t_and_m_t":"TrackingAreaCodeList-r16 ::=     SEQUENCE (SIZE (1..8)) OF TrackingAreaCode","paragraph_zero_based":36690},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36691},{"literal_text_all_w_t_and_m_t":"TrackingAreaIdentityList-r16 ::= SEQUENCE (SIZE (1..8)) OF TrackingAreaIdentity-r16","paragraph_zero_based":36692},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36693},{"literal_text_all_w_t_and_m_t":"TrackingAreaIdentity-r16 ::=     SEQUENCE {","paragraph_zero_based":36694},{"literal_text_all_w_t_and_m_t":"    plmn-Identity-r16                PLMN-Identity,","paragraph_zero_based":36695}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["7efb8cd16b33faa7770a13fcf368e5ae31b431d692bc8a2cba6aa8e5167934cc","c5b6f2536a48093f5e752d1baf352f7362a147bc404706e51aa0dc83824209d7","540d6f5c02ad9fe63c7148f1d228b5f4f008a333816a11407f4b86bfbc4b0242","c0429ea3068ea5eff9162bc51a4666e287f2356a97e247e57fdb46bf4ded8184","7b97f91f3a8cac8a525169107cb8d4c7d1ebca61a0e16fe813547073b2b68f36","feb87c3c0e394f6d647b266b92c4de0bd37b9fbcc91592eea3b5d9dd9cc03520","e09a90524f033930f05ddab30fe1d12fc201b33e92b0fe931c02db4c000254c3","add06e69e144871c0dc92bc5d24f79248c57ebd959863f851d2a68d767cb7ea6","681adb5db4eb140f68fd6c2b03e28db65418dddd09233d4920d591779f52512e","224631dbbcf8c165ef1f4ddc4e175d8998228fc0578e20bf4eb55f12ec816009","917685058a6eedd184b7c7438924efe0144be63f48b8f772e0d9b8ec34578f5b","fb0d5223e25d54c9faeb34c16e76eb9e351c6a1c1306dec0c2a937c912710fbb","404a70a4a9d9b3d89f130fa515770f32879726e3e6c4e4d97ec5ea70eedb479a","e2f2678806a4b40cf3