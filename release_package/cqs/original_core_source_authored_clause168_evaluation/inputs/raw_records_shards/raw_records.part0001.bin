{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    }                                                                                                           OPTIONAL  -- Need R","paragraph_zero_based":17592},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":17593},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":17594},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17595},{"literal_text_all_w_t_and_m_t":"CSI-RS-Index ::=                    INTEGER (0..maxNrofCSI-RS-ResourcesRRM-1)","paragraph_zero_based":17596},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17597},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-RS-RESOURCECONFIGMOBILITY-STOP","paragraph_zero_based":17598},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17599},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17600},{"literal_text_all_w_t_and_m_t":"CSI-RS-CellMobility field descriptions","paragraph_zero_based":17601},{"literal_text_all_w_t_and_m_t":"csi-rs-ResourceList-Mobility","paragraph_zero_based":17602},{"literal_text_all_w_t_and_m_t":"List of CSI-RS resources for mobility. The maximum number of CSI-RS resources that can be configured per measObjectNR depends on the configuration of associatedSSB and the support of increasedNumberofCSIRSPerMO capability (see TS 38.214 [19], clause 5.1.6.1.3).","paragraph_zero_based":17603},{"literal_text_all_w_t_and_m_t":"density","paragraph_zero_based":17604},{"literal_text_all_w_t_and_m_t":"Frequency domain density for the 1-port CSI-RS for L3 mobility. See TS 38.211 [16], clause 7.4.1.","paragraph_zero_based":17605},{"literal_text_all_w_t_and_m_t":"nrofPRBs","paragraph_zero_based":17606},{"literal_text_all_w_t_and_m_t":"Allowed size of the measurement BW in PRBs. See TS 38.211 [16], clause 7.4.1.","paragraph_zero_based":17607},{"literal_text_all_w_t_and_m_t":"startPRB","paragraph_zero_based":17608},{"literal_text_all_w_t_and_m_t":"Starting PRB index of the measurement bandwidth. See TS 38.211 [16], clause 7.4.1.","paragraph_zero_based":17609},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17610},{"literal_text_all_w_t_and_m_t":"CSI-RS-ResourceConfigMobility field descriptions","paragraph_zero_based":17611},{"literal_text_all_w_t_and_m_t":"csi-RS-CellList-Mobility","paragraph_zero_based":17612},{"literal_text_all_w_t_and_m_t":"List of cells for CSI-RS based RRM measurements.","paragraph_zero_based":17613},{"literal_text_all_w_t_and_m_t":"refServCellIndex","paragraph_zero_based":17614},{"literal_text_all_w_t_and_m_t":"Indicates the serving cell providing the timing reference for CSI-RS resources without associatedSSB. The field may be present only if there is at least one CSI-RS resource configured without associatedSSB. If this field is absent, the UE shall use the timing of the PCell for measurements on the CSI-RS resources without associatedSSB. The CSI-RS resources and the serving cell indicated by refServCellIndex for timing reference should be located in the same band.","paragraph_zero_based":17615}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["6d087bb3570ae72e59a092e9b58e255a52da8eb4e9f36111c97fec11cd3f54a1","40ffc598f8c74ad458b5a638567e42254fe381397c0b3448fee77b19f25847ab","e0d4bb8d2c8dce5d250203a4db74cb66c4bb0e6a9d503975f79c72dcdcb95b6c","eb000bf0d3652aad2ed2fe856743d8c46e594945532f9157afa615b54c12e457","5e47394f59b095cdffe4dc3ff2c2c4e0dddf551e78eda20a8e8b512368dfe9ec","7bd16895d5b2c4ef20ab21fea3eaf19d6a5f2e0d6dbf42ba39381daba403d581","fc3c93ab926cb4e3675720961869b77d104ae0c230402da00b5340d0fd27749a","6835679a31c00515c0cb2fedce2525ea5106ce318d6aee051030f43071b18ed3","4e09200fbcccb688b952a57224e53b17a199e369a4cdc4036c857f50cef42188","963945e1981855feaefd2e977e1fb06ada166f99ef7412429336df26fe5174bf","1f1115c89167a0793f258acb7065e30cb1511d0867052981558715968d7032f5","afafb413241b74cfa1c03744b675bbeec8b562f7ce7f007eb0b5a69b46095294","7c873ac8ed53d4f15d8a8c134b9f327c890ad20c89d210539dd291d10cdc8f87","79e29f68b1598b0c716b3f700f528a4ec7a1f9e620c18d8c844b0bbfcc54fcca","ead62e0c5325632791e47db72a67262cbf8a5ef3237fe7c1909628499ac8185c","ab23c8fe6b190557576728c3e6570030cb8bfdd455b4a5167a8e355abf66697a","94ebe3e598b308be7592459a572a6c92ec4e70d24439c2653a7d9ca021e41dec","be1365371db7811f57539717c220df473c97031e0c310db6f329f3fc5b89c6b0","7c77c0343b399aac12d2b39a6917878d3e7872ce61ff5b0492c534a4e5369bea","61ef36c6ef9f13733fa4ada676af503a27ef215de056c2b780d619597ee47e21","f4f4bce4f5d1b35b0c61020d95cd8cdf02a873059d2a78dba2eee8826d2616bf","f6deebfd7e0714ec42a57c18468100f4b03e6b2586b36c3877f117bd851c716c","09cee7ee15c097bdc490566653a5b0798b44297f6356d521c740594033f4a326","5bc2cd101905552091cf801f1c6c4e598cfb38051b927a8b9cecd4d8a9c9648c"],"paragraph_range_zero_based":[17592,17615],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p17592"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"subcarrierSpacing","paragraph_zero_based":17616},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing of CSI-RS.","paragraph_zero_based":17617},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":17618},{"literal_text_all_w_t_and_m_t":"FR1:    15, 30, or 60 kHz","paragraph_zero_based":17619},{"literal_text_all_w_t_and_m_t":"FR2-1:  60 or 120 kHz","paragraph_zero_based":17620},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":17621},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17622},{"literal_text_all_w_t_and_m_t":"CSI-RS-Resource-Mobility field descriptions","paragraph_zero_based":17623},{"literal_text_all_w_t_and_m_t":"associatedSSB","paragraph_zero_based":17624},{"literal_text_all_w_t_and_m_t":"If this field is present, the UE may base the timing of the CSI-RS resource indicated in CSI-RS-Resource-Mobility on the timing of the cell indicated by the cellId in the CSI-RS-CellMobility. In this case, the UE is not required to monitor that CSI-RS resource if the UE cannot detect the SS/PBCH block indicated by this associatedSSB and cellId. If this field is absent, the UE shall base the timing of the CSI-RS resource indicated in CSI-RS-Resource-Mobility on the timing of the serving cell indicated by refServCellIndex. In this case, the UE is required to measure the CSI-RS resource even if SS/PBCH block(s) with cellId in the CSI-RS-CellMobility are not detected.","paragraph_zero_based":17625},{"literal_text_all_w_t_and_m_t":"CSI-RS resources with and without associatedSSB may be configured in accordance with the rules in TS 38.214 [19], clause 5.1.6.1.3.","paragraph_zero_based":17626},{"literal_text_all_w_t_and_m_t":"csi-RS-Index","paragraph_zero_based":17627},{"literal_text_all_w_t_and_m_t":"CSI-RS resource index associated to the CSI-RS resource to be measured (and used for reporting).","paragraph_zero_based":17628},{"literal_text_all_w_t_and_m_t":"firstOFDMSymbolInTimeDomain","paragraph_zero_based":17629},{"literal_text_all_w_t_and_m_t":"Time domain allocation within a physical resource block. The field indicates the first OFDM symbol in the PRB used for CSI-RS, see TS 38.211 [16], clause 7.4.1.5.3.","paragraph_zero_based":17630},{"literal_text_all_w_t_and_m_t":"frequencyDomainAllocation","paragraph_zero_based":17631},{"literal_text_all_w_t_and_m_t":"Frequency domain allocation within a physical resource block in accordance with TS 38.211 [16], clause 7.4.1.5.3 including table 7.4.1.5.2-1. The number of bits that may be set to one depend on the chosen row in that table.","paragraph_zero_based":17632},{"literal_text_all_w_t_and_m_t":"isQuasiColocated","paragraph_zero_based":17633},{"literal_text_all_w_t_and_m_t":"Indicates that the CSI-RS resource is quasi co-located with the associated SS/PBCH block, see TS 38.214 [19], clause 5.1.6.1.3.","paragraph_zero_based":17634},{"literal_text_all_w_t_and_m_t":"sequenceGenerationConfig","paragraph_zero_based":17635},{"literal_text_all_w_t_and_m_t":"Scrambling ID for CSI-RS (see TS 38.211 [16], clause 7.4.1.5.2).","paragraph_zero_based":17636},{"literal_text_all_w_t_and_m_t":"slotConfig","paragraph_zero_based":17637},{"literal_text_all_w_t_and_m_t":"Indicates the CSI-RS periodicity (in milliseconds) and for each periodicity the offset (in number of slots). When subcarrierSpacing is set to kHz15, the maximum offset values for periodicities ms4/ms5/ms10/ms20/ms40 are 3/4/9/19/39 slots. When subcarrierSpacing is set to kHz30, the maximum offset values for periodicities ms4/ms5/ms10/ms20/ms40 are 7/9/19/39/79 slots. When subcarrierSpacing is set to kHz60, the maximum offset values for periodicities ms4/ms5/ms10/ms20/ms40 are 15/19/39/79/159 slots. When subcarrierSpacing is set kHz120, the maximum offset values for periodicities ms4/ms5/ms10/ms20/ms40 are 31/39/79/159/319 slots. When subcarrierSpacing is set to kHz480, the maximum offset values for periodicities ms4/ms5/ms10/ms20/ms40 are 127/159/319/639/1279 slots. When subcarrierSpacing is set to kHz960, the maximum offset values for periodicities ms4/ms5/ms10/ms20/ms40 are 255/319/639/1279/2559 slots. If slotConfig-r17 is present, UE shall ignore the slotConfig (without suffix).","paragraph_zero_based":17638},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17639}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["b2ce989674c22d71b996562e65e4e095b57d7a847552381fa0d46df2634e0e7a","e4461d210d01d6de507f067c88d7a3c13b2f0a2a79f8a1fd764e362ac7e36b4f","385575bf18ade80d6fd6424e2825f22492e3edd5fc57bfebfe2707d1d3e203d1","1eaefb9f72d7e3bc42d5588c89d169ca63e3a50ca6f7e3beba292c6f0408428b","8d3a332a1103a0b3fe0ad51c0fae1ce8ae1e9a62b8fb8c8a1ac29bd8ad546f25","75fbecdc74cccfa8d0bacf7beb72dd4379bf58045c37bbc2dbe827253f2af5f2","e16683c4bbd5b5be3e3ad26a1a4e0619a19d3a092591d4a4862b2e4081209b93","8570ef5669b1aff1353b9b51d377e79db23507448131351487777904d93d18f2","ead009b4b30eb033a7819c4be74276386717a13ff032b20497a8a701e54beba8","960503d06f1458b7a8f46020d7aff8ac0d7997e6661ad44fa5fb6436e882faf2","7a95b2b29812f1e5834b9d17642c6d8252e3b5a7d461388c05e3e20b73865974","1939dffb1744c5a18585d0063dd771a2770f1962af29b5b345b0baa8e31b2fc1","e9a0c7c78b2f641b1a12cf208ea59b19fb6d5244bc8402fb25d2e9ea7561dadf","60a807d0983a9d249aff0d9ad4cdc080e4fd93dfb676e040a6467cfc0a8b2050","4ae9a03de8d26fa3837a3c73b0ffe6458e4386ad0917af25dc6a2c4cf37aac8c","2c497ffb1a882cfc5de6716d72c784e3fd3e925201dc033b6b272f216d060c28","a062dea6af095ad080874384262ffb9822eeeebcc231f712099e04eddabb5b3b","4438e50255b9da11adf38ca90da6cc6c59a744c4341cdbc13b10583b62c9efab","23cecc8d2d241050dd71dc9b77222b0b798c61034a7e763a196984b02a7d1709","0aba03772eccb2acdc171a23bdc02567c7d8c941da07ddc3196b521fa92b68db","5b2e6831e4dca75f6bd8b23902f72d6636d5d842b2336ceac8f881b716a88766","51105a3a4276fdff093f9c5d83f8708509be389b9ca5be76822795b7b89f40ef","d3a088a9446bf17489c239bf7b1a411324e2a40f2011fddf157db126746cf3b2","9a244d4919528470b041f0c646307737682029d27f2094f60857f0e4bc671118"],"paragraph_range_zero_based":[17616,17639],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx:p17616"}
{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–CSI-RS-ResourceMapping","paragraph_zero_based":17640},{"literal_text_all_w_t_and_m_t":"The IE CSI-RS-ResourceMapping is used to configure the resource element mapping of a CSI-RS resource in time- and frequency domain.","paragraph_zero_based":17641},{"literal_text_all_w_t_and_m_t":"CSI-RS-ResourceMapping information element","paragraph_zero_based":17642},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17643},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-RS-RESOURCEMAPPING-START","paragraph_zero_based":17644},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17645},{"literal_text_all_w_t_and_m_t":"CSI-RS-ResourceMapping ::=          SEQUENCE {","paragraph_zero_based":17646},{"literal_text_all_w_t_and_m_t":"    frequencyDomainAllocation           CHOICE {","paragraph_zero_based":17647},{"literal_text_all_w_t_and_m_t":"        row1                                BIT STRING (SIZE (4)),","paragraph_zero_based":17648},{"literal_text_all_w_t_and_m_t":"        row2                                BIT STRING (SIZE (12)),","paragraph_zero_based":17649},{"literal_text_all_w_t_and_m_t":"        row4                                BIT STRING (SIZE (3)),","paragraph_zero_based":17650},{"literal_text_all_w_t_and_m_t":"        other                               BIT STRING (SIZE (6))","paragraph_zero_based":17651},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":17652},{"literal_text_all_w_t_and_m_t":"    nrofPorts                           ENUMERATED {p1,p2,p4,p8,p12,p16,p24,p32},","paragraph_zero_based":17653},{"literal_text_all_w_t_and_m_t":"    firstOFDMSymbolInTimeDomain         INTEGER (0..13),","paragraph_zero_based":17654},{"literal_text_all_w_t_and_m_t":"    firstOFDMSymbolInTimeDomain2        INTEGER (2..12)                                                         OPTIONAL,   -- Need R","paragraph_zero_based":17655},{"literal_text_all_w_t_and_m_t":"    cdm-Type                            ENUMERATED {noCDM, fd-CDM2, cdm4-FD2-TD2, cdm8-FD2-TD4},","paragraph_zero_based":17656},{"literal_text_all_w_t_and_m_t":"    density                             CHOICE {","paragraph_zero_based":17657},{"literal_text_all_w_t_and_m_t":"        dot5                                ENUMERATED {evenPRBs, oddPRBs},","paragraph_zero_based":17658},{"literal_text_all_w_t_and_m_t":"        one                                 NULL,","paragraph_zero_based":17659},{"literal_text_all_w_t_and_m_t":"        three                               NULL,","paragraph_zero_based":17660},{"literal_text_all_w_t_and_m_t":"        spare                               NULL","paragraph_zero_based":17661},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":17662},{"literal_text_all_w_t_and_m_t":"    freqBand                            CSI-FrequencyOccupation,","paragraph_zero_based":17663}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["71c68bc6fd2a9b42e01fe2493f32e26dbac3b5a43990bc524f83a10b242e28b6","c2357653bab3bba2080b4ddbed5326d52e176e3bd954ddf1ec0bc72f06c8f450","c1823b5493e73058cc3111e85602e6048eb76fbd9204a50ad6236a16bb4b8439","6695b69c6d268a7cfd4cbc1f5fe47bef36ecb2d2455e5d8e87fafdcaf9e6b5d6","922ab9d1f581910d500f7aa1669322d6987951a0f6be3f3f44127842d8ed9d5b","a1d8960b58b82a6bf653e43e8bb215d42f2d1309d4f457e654e728696a985b42","2b3096c770202ab7dd657016c9d4a394dc8040ef5381531ee36fa9fa79330348","1614a9eea4494374af880b10f61ff036a5eddf17e0b2548e547cd1950c748aa2","6f32cd2fe0b56149eb8b81ede48614d672da9e0b47218567fb185a54c88f5db0","71b1c4c52a