{"fields":{"filename":"R2-2313638.zip::R2-2313638 NR-UAV-RRC-CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE DL-PPW-PreConfig provides configuration for a measurement window where a UE is expected to measure the DL PRS, if it is inside the active DL BWP and with the same numerology as the active DL BWP. Based upon the indication received in the configuration, the UE identifies whether the DL PRS priority is higher than that of the other DL signals or channels and accordingly determines, for example, the UE is expected to measure the DL PRS and is not expected to receive other DL signals and channels.","paragraph_zero_based":17760},{"literal_text_all_w_t_and_m_t":"DL-PPW-PreConfig information element","paragraph_zero_based":17761},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17762},{"literal_text_all_w_t_and_m_t":"-- TAG-DL-PPW-PRECONFIG-START","paragraph_zero_based":17763},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17764},{"literal_text_all_w_t_and_m_t":"DL-PPW-PreConfig-r17 ::= SEQUENCE {","paragraph_zero_based":17765},{"literal_text_all_w_t_and_m_t":"    dl-PPW-ID-r17            DL-PPW-ID-r17,","paragraph_zero_based":17766},{"literal_text_all_w_t_and_m_t":"    dl-PPW-PeriodicityAndStartSlot-r17     DL-PPW-PeriodicityAndStartSlot-r17,","paragraph_zero_based":17767},{"literal_text_all_w_t_and_m_t":"    length-r17                               INTEGER (1..160),","paragraph_zero_based":17768},{"literal_text_all_w_t_and_m_t":"    type-r17                                 ENUMERATED {type1A, type1B, type2}                            OPTIONAL, -- Cond MultiType","paragraph_zero_based":17769},{"literal_text_all_w_t_and_m_t":"    priority-r17                             ENUMERATED {st1, st2, st3}                                    OPTIONAL  -- Cond MultiState","paragraph_zero_based":17770},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":17771},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17772},{"literal_text_all_w_t_and_m_t":"DL-PPW-ID-r17 ::= INTEGER  (0..maxNrofPPW-ID-1-r17)","paragraph_zero_based":17773},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17774},{"literal_text_all_w_t_and_m_t":"DL-PPW-PeriodicityAndStartSlot-r17 ::= CHOICE {","paragraph_zero_based":17775},{"literal_text_all_w_t_and_m_t":"    scs15                                    CHOICE {","paragraph_zero_based":17776},{"literal_text_all_w_t_and_m_t":"                      n4                         INTEGER (0..3),","paragraph_zero_based":17777},{"literal_text_all_w_t_and_m_t":"                      n5                         INTEGER (0..4),","paragraph_zero_based":17778},{"literal_text_all_w_t_and_m_t":"                      n8                         INTEGER (0..7),","paragraph_zero_based":17779},{"literal_text_all_w_t_and_m_t":"                      n10                        INTEGER (0..9),","paragraph_zero_based":17780},{"literal_text_all_w_t_and_m_t":"                      n16                        INTEGER (0..15),","paragraph_zero_based":17781},{"literal_text_all_w_t_and_m_t":"                      n20                        INTEGER (0..19),","paragraph_zero_based":17782},{"literal_text_all_w_t_and_m_t":"                      n32                        INTEGER (0..31),","paragraph_zero_based":17783}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e3250e6c0cd3fb3aba61a07b59149d950b97cf801261256eaaffa40eb003836b","original_member_sha256":"43effeec8825b995fac78441fed0808abcec562c85ad3256681daf06dadbee2c","paragraph_ElementTree_utf8_XML_sha256":["ac07fac449359cc3a48cf86baddc4730252fedf5c4e01eb0e88198e104a3e3a0","3a691353c8f418181a63d1665ff093ca802e1aeced4c34355d5b7c2b3d70d9fe","54169353e6e5bb2abe6aa58a72d77e32ac7ae022c71e0328a0dac54ea93a2601","d045df19aa26c0041a113efae27a20dce674ad300697a1fdd479