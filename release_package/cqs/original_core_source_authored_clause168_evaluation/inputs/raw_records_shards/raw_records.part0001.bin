{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24360},{"literal_text_all_w_t_and_m_t":"PUSCH-TPC-CommandConfig ::=         SEQUENCE {","paragraph_zero_based":24361},{"literal_text_all_w_t_and_m_t":"    tpc-Index                           INTEGER (1..15)                                                 OPTIONAL,   -- Cond SUL","paragraph_zero_based":24362},{"literal_text_all_w_t_and_m_t":"    tpc-IndexSUL                        INTEGER (1..15)                                                 OPTIONAL,   -- Cond SUL-Only","paragraph_zero_based":24363},{"literal_text_all_w_t_and_m_t":"    targetCell                          ServCellIndex                                                   OPTIONAL,   -- Need S","paragraph_zero_based":24364},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":24365},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":24366},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24367},{"literal_text_all_w_t_and_m_t":"-- TAG-PUSCH-TPC-COMMANDCONFIG-STOP","paragraph_zero_based":24368},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":24369},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24370},{"literal_text_all_w_t_and_m_t":"PUSCH-TPC-CommandConfig field descriptions","paragraph_zero_based":24371},{"literal_text_all_w_t_and_m_t":"targetCell","paragraph_zero_based":24372},{"literal_text_all_w_t_and_m_t":"The serving cell to which the acquired power control commands are applicable. If the value is absent, the UE applies the TPC commands to the serving cell on which the command has been received.","paragraph_zero_based":24373},{"literal_text_all_w_t_and_m_t":"tpc-Index","paragraph_zero_based":24374},{"literal_text_all_w_t_and_m_t":"An index determining the position of the first bit of TPC command inside the DCI format 2-2 payload.","paragraph_zero_based":24375},{"literal_text_all_w_t_and_m_t":"tpc-IndexSUL","paragraph_zero_based":24376},{"literal_text_all_w_t_and_m_t":"An index determining the position of the first bit of TPC command inside the DCI format 2-2 payload.","paragraph_zero_based":24377},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24378},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":24379},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":24380},{"literal_text_all_w_t_and_m_t":"SUL-Only","paragraph_zero_based":24381},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if supplementaryUplink is configured within ServingCellConfig. It is absent otherwise.","paragraph_zero_based":24382},{"literal_text_all_w_t_and_m_t":"SUL","paragraph_zero_based":24383}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["1d162fa8384915e928d79f4cc1a2786d63d50c5c6d71456b194c33e64b6dcd43","c01eb30327c598eef449c261a1baef6f98cbcd3d287f0ab37273d6a20de52473","92b8d9f5ce73b2fae289e03b59c088c956415db91a008d1f57ff0681091bb09e","c789b5a3210d02a21f292eb67aaad7b76171484ddd62d7c93f8d36f5775e9d46","850f7f87995977e8692407cf5c6d45fe027a8e21ab80abfc5d84654ad1fd099c","08999b9c32e162c214f1abf3a4ebec8cab3fe6b905e12d94683d3c29f7645061","79d6403b8c723a69d6339565e46f7eb97e88adf1bf943bec6320a9a34637c2b1","9ed6d1b2c6966aaec1f326e727934b4088335fad9adc46f662e1f2757a631ad8","6f35653a4d2414c5cb7eacc664de892951d2c1b2827dc65fb2f16b754a201222","dd6db03ffb846bdaed0fe7f63cb2b1da1685012c156370f7759014a841453b75","48a0d08e75d9b660f8ea409bd7a82bd5036d9a677c775661d005548ae1790b15","9b84451c8e14cfbb394cde21778dcdff4465753c148bc0654f34984c62b