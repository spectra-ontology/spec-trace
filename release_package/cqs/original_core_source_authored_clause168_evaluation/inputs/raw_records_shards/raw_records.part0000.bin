{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Contains L2 U2N relay operation related configurations used by L2 U2N Remote UE. The field is absent if appLayerMeasConfig or SRB4 is configured/not released.","paragraph_zero_based":10752},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10753},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":10754},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":10755},{"literal_text_all_w_t_and_m_t":"L2RemoteUE","paragraph_zero_based":10756},{"literal_text_all_w_t_and_m_t":"The field is mandatory present for L2 U2N Remote UE; otherwise it is absent.","paragraph_zero_based":10757},{"literal_text_all_w_t_and_m_t":"RestoreSCG","paragraph_zero_based":10758},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if restoreSCG is included. It is optionally present, Need M, otherwise.","paragraph_zero_based":10759},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10760},{"literal_text_all_w_t_and_m_t":"–RRCResumeComplete","paragraph_zero_based":10761},{"literal_text_all_w_t_and_m_t":"The RRCResumeComplete message is used to confirm the successful completion of an RRC connection resumption.","paragraph_zero_based":10762},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1","paragraph_zero_based":10763},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":10764},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":10765},{"literal_text_all_w_t_and_m_t":"Direction: UE to Network","paragraph_zero_based":10766},{"literal_text_all_w_t_and_m_t":"RRCResumeComplete message","paragraph_zero_based":10767},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":10768},{"literal_text_all_w_t_and_m_t":"-- TAG-RRCRESUMECOMPLETE-START","paragraph_zero_based":10769},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10770},{"literal_text_all_w_t_and_m_t":"RRCResumeComplete ::=                   SEQUENCE {","paragraph_zero_based":10771},{"literal_text_all_w_t_and_m_t":"    rrc-TransactionIdentifier               RRC-TransactionIdentifier,","paragraph_zero_based":10772},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                      CHOICE {","paragraph_zero_based":10773},{"literal_text_all_w_t_and_m_t":"        rrcResumeComplete                       RRCResumeComplete-IEs,","paragraph_zero_based":10774},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture                SEQUENCE {}","paragraph_zero_based":10775}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["77b3ce2a6e2325c119cb0f61bc9c85a2b7ca38b1454fb6e3318f6404ce2e69d9","da417f5e4a1b77d7a438ac1f3283427ca72a54ad8b40024278c162074f8408ec","3fd214f17eb9a9d4aa6ae12b97087555fa96c0223023fc7a85b7cbfbe6ef5bb2","3646cf43fd176734e8463d29f658e4fa50298a45f4cfa3de7d209126828d7226","28bd5dbe701f709978d8f475bf1978a39bf5ed02feac2162b1f10b3d374c0190","22bff8754297694fc1893cea8f937197e74bb308070b931237de613d4b414248","ec461c2016705186874315b1b7294b8b8bf15039056bb1bfec420cb23634b825","d70ae13e8f1088464df0c0035042fc73ac444d2b864a646f7c83cf1303e9db48","6da1ce28ac500a0b24cfc20a25b173bc0a249bebc6c602b10b2796445d66738f","380a03992a8654e4fe9ac9cb4d2a0872bea2f17766e61d8fcbc33068de27d703","cb0a7fa27f0ceb024c728a8ad1a4727ec0706311e09a42782c770cc1d563c96e","08b9e54ebce60ab12a647c1244476120927a4e9b4f71da5e198c7d9e62973b4d","876f9b5f988a965905dbdd20b8ce777832a6bd283aad3ac369f111af33d6c0c0","5614500475d4429a985a3ced081817b267f6e4266e01e94bab5a6492db95f88e","e27563