{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the resources by which the UE is allowed to perform NR sidelink transmission based on network scheduling on the configured BWP. For the PSFCH related configuration, if configured, will be used for PSFCH transmission/reception.","paragraph_zero_based":37608},{"literal_text_all_w_t_and_m_t":"sl-TxPoolSelectedNormal","paragraph_zero_based":37609},{"literal_text_all_w_t_and_m_t":"Indicates the resources by which the UE is allowed to perform NR sidelink transmission by UE autonomous resource selection on the configured BWP. For the PSFCH related configuration, if configured, will be used for PSFCH transmission/reception.","paragraph_zero_based":37610},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37611},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":37612},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":37613},{"literal_text_all_w_t_and_m_t":"HO","paragraph_zero_based":37614},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need M, in an RRCReconfiguration message including reconfigurationWithSync; otherwise it is absent, Need M.","paragraph_zero_based":37615},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37616},{"literal_text_all_w_t_and_m_t":"–SL-BWP-PoolConfigCommon","paragraph_zero_based":37617},{"literal_text_all_w_t_and_m_t":"The IE SL-BWP-PoolConfigCommon is used to configure the cell-specific NR sidelink communication resource pool.","paragraph_zero_based":37618},{"literal_text_all_w_t_and_m_t":"SL-BWP-PoolConfigCommon information element","paragraph_zero_based":37619},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":37620},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-BWP-POOLCONFIGCOMMON-START","paragraph_zero_based":37621},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37622},{"literal_text_all_w_t_and_m_t":"SL-BWP-PoolConfigCommon-r16 ::=      SEQUENCE {","paragraph_zero_based":37623},{"literal_text_all_w_t_and_m_t":"    sl-RxPool-r16                        SEQUENCE (SIZE (1..maxNrofRXPool-r16)) OF SL-ResourcePool-r16         OPTIONAL,    -- Need R","paragraph_zero_based":37624},{"literal_text_all_w_t_and_m_t":"    sl-TxPoolSelectedNormal-r16          SEQUENCE (SIZE (1..maxNrofTXPool-r16)) OF SL-ResourcePoolConfig-r16   OPTIONAL,    -- Need R","paragraph_zero_based":37625},{"literal_text_all_w_t_and_m_t":"    sl-TxPoolExceptional-r16             SL-ResourcePoolConfig-r16                                             OPTIONAL     -- Need R","paragraph_zero_based":37626},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37627},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37628},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-BWP-POOLCONFIGCOMMON-STOP","paragraph_zero_based":37629},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":37630},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37631}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["5b7396764e32926cff3b448b7d130f1ce7b2b87a58fd2fc0c60a2cb59dfbf5fc","17c0b189e4e086c49f732b79ecb2518b74ff45380f82a14cbcdad929abf34328","69595d1efe23bb5d7e23f764a6caf004599e97e4107e058f65eed7b3f29989a6","ec94d2413596181bdc959e6433051aa6dcb9efdeda318f55cb599a324935920c","9d8eccb1c89143f8c92dfef7727ef9a6f1b0b614eb8fea2cd207dd96c259377e","bd8cdbef70b78b22eac52d08cd921b6a947b303226efe628d5ef58c479ab401b","6ed6376978d944349cb7b3076df5fc67ac6a1353f44d1ef71e58944ed74d6bc9","7d74eb46ac1df9cbbe48b4d960c16a8a61cd25632443c