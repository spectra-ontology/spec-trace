{"fields":{"filename":"R2-2306537.zip::R2-2306537.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests GNSS-RTK-Residuals; otherwise it is not present.","paragraph_zero_based":456},{"literal_text_all_w_t_and_m_t":"FKP-Req","paragraph_zero_based":457},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests GNSS-RTK-FKP-Gradients; otherwise it is not present.","paragraph_zero_based":458},{"literal_text_all_w_t_and_m_t":"OC-Req","paragraph_zero_based":459},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests GNSS-SSR-OrbitCorrections; otherwise it is not present.","paragraph_zero_based":460},{"literal_text_all_w_t_and_m_t":"CC-Req","paragraph_zero_based":461},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests GNSS-SSR-ClockCorrections; otherwise it is not present.","paragraph_zero_based":462},{"literal_text_all_w_t_and_m_t":"CB-Req","paragraph_zero_based":463},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests GNSS-SSR-CodeBias; otherwise it is not present.","paragraph_zero_based":464},{"literal_text_all_w_t_and_m_t":"URA-Req","paragraph_zero_based":465},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests GNSS-SSR-URA; otherwise it is not present.","paragraph_zero_based":466},{"literal_text_all_w_t_and_m_t":"PB-Req","paragraph_zero_based":467},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests GNSS-SSR-PhaseBias; otherwise it is not present.","paragraph_zero_based":468},{"literal_text_all_w_t_and_m_t":"STEC-Req","paragraph_zero_based":469},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests GNSS-SSR-STEC-Correction; otherwise it is not present","paragraph_zero_based":470},{"literal_text_all_w_t_and_m_t":"Grid-Req","paragraph_zero_based":471},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests GNSSSSRGriddedCorrection; otherwise it is not present.","paragraph_zero_based":472},{"literal_text_all_w_t_and_m_t":"DNavIC-Req","paragraph_zero_based":473},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests NavIC-DifferentialCorrections; otherwise it is not present. This field may only be present if the gnss-ID indicates 'navic'.","paragraph_zero_based":474},{"literal_text_all_w_t_and_m_t":"NavIC-GridModReq","paragraph_zero_based":475},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests NavIC-GridModel; otherwise it is not present. This field may only be present if the gnss-ID indicates 'navic'.","paragraph_zero_based":476},{"literal_text_all_w_t_and_m_t":"LOS-GridReq","paragraph_zero_based":477},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests LOS-NLOS-GridPoints; otherwise it is not present.","paragraph_zero_based":478},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"7ea3ea011934f6c0dae39181d4a24ce5ca5bc379d48c0313eb5c481ec4a3b095","original_member_sha256":"7e5d65269c396c98b3a6de240a7cc5f08aa736e14c814be48fe93773a39ba42f","paragraph_ElementTree_utf8_XML_sha256":["513cc62b34709838704386377c992f51e9ed5e19f069928800bda4bdebaf60f0","a38670b801acaa4aa8ffb93f2637e4eb3b7d21efb0cc556416946ee98e779948","79a92da3c5f080e28aadf64317edd9642c3f4b4b5f0ee89503c4e0f4681922db","57381ac839f3b9d252e0f40cd1b5ad0cc1e4987d3b7a5b2aa2f94b10985b7eff","9fea8b12a4c54d9da493b70dad8e6ab8a1216eb68ced4b4379c1cdd1bce685f4","e0f4274f7aeb5bda1bda3c26c04b2e4ada41fc770700f5e7bfb81d1b2730f22c","e39ed65ec8f50a619c59b6bab