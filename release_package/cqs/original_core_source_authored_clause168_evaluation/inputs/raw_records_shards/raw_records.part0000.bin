w_t_and_m_t":"BCHBroadcast Channel","paragraph_zero_based":139},{"literal_text_all_w_t_and_m_t":"BFDBeam Failure Detection","paragraph_zero_based":140},{"literal_text_all_w_t_and_m_t":"BHBackhaul","paragraph_zero_based":141},{"literal_text_all_w_t_and_m_t":"BLBandwidth reduced Low complexity","paragraph_zero_based":142},{"literal_text_all_w_t_and_m_t":"BPSKBinary Phase Shift Keying","paragraph_zero_based":143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8d4901b891fbd4ddd84ab30e673a8dc5a4094da57e9e4b85dbb233c58abd62aa","original_member_sha256":"be142033f82c6755a6455392686a978e05ce304dac4a2fd05b9a253aaed7cdf3","paragraph_ElementTree_utf8_XML_sha256":["8b7356dc12b8ac2b9265bc7daab169ac0cc94de9806406f1b7dacf5f98caeaf4","c5d9b1a3e2cdf4e11193fa6ec3af77b2c237e30708bc8a8116afd0b4061e2806","cf8dacd4f6618e9b2392b5a692554d836efddde00af26f193121339cecd91f57","22efa5d13b3bf96064a562ffacf70af94296ee9f45369be6f93b959a10c4ba27","2eddc1ee932f7c474822c891f3db2313a7124bd1beaf1c84d17c8de9d9877348","74c01266e5ca7781bcbbbbc9f89a83a855f6e1a26773944c1ec09b3033c385de","9a1fb2c21b7d59d1e1f8087b6ed9b67c6c04c2bc628840d571c23ea76e65076d","3235510caa9780cfb631b223904187035f3997ac586e7ba531000645ab575e75","97e1443e1bd4f21929761ff0663620e6d6095a2976c6de0b168c3ee3805e2799","d0a1847271214a7486ad8ac28d1936702682945a2d7ef3727c8bd6fc07d94dcd","7afead21378e07c180e021e768c27635501cfca173040ac5f50205652f4b8f15","b99dfcb23f5dd87a0d71de27818252d56a769788380ffc4321878863c6584807","f819a171ed56a24d5cbcc715d92faac2660545aec1b649995c68679145b5d18b","cae7a44ee021c465d4274ebf5460c87f3c2720c77b2cd3f4fd98e1e2662d9d59","5cd4193622fadfeaacfe3cce51ab1ccad941e2f6f11cb1719a929aeb3d011fd6","b267ecf1860d5ba592fe1065844ca888625a1dd43af7071a5c61c725a4d726fe","821bce67344b5b79e9af6ff29c551b17b912878a84a9d416b6963a5d932c228a","0c0a674faa00f388f7b73c5dc44195d89c79a30c43eb5ee241b6a72b58704505","a1a8f7b978f916f0e793ed1c4e