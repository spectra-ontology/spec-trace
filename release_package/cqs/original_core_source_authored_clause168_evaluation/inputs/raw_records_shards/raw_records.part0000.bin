{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    sl-Mode-r16                            CHOICE  {","paragraph_zero_based":11640},{"literal_text_all_w_t_and_m_t":"        sl-AM-Mode-r16                         NULL,","paragraph_zero_based":11641},{"literal_text_all_w_t_and_m_t":"        sl-UM-Mode-r16                         NULL","paragraph_zero_based":11642},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":11643},{"literal_text_all_w_t_and_m_t":"    sl-QoS-InfoList-r16                SEQUENCE (SIZE (1..maxNrofSL-QFIsPerDest-r16)) OF SL-QoS-Info-r16","paragraph_zero_based":11644},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":11645},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11646},{"literal_text_all_w_t_and_m_t":"SL-FailureList-r16 ::=                 SEQUENCE (SIZE (1..maxNrofSL-Dest-r16)) OF SL-Failure-r16","paragraph_zero_based":11647},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11648},{"literal_text_all_w_t_and_m_t":"SL-Failure-r16 ::=                     SEQUENCE {","paragraph_zero_based":11649},{"literal_text_all_w_t_and_m_t":"    sl-DestinationIdentity-r16             SL-DestinationIdentity-r16,","paragraph_zero_based":11650},{"literal_text_all_w_t_and_m_t":"    sl-Failure-r16                         ENUMERATED {rlf,configFailure, drxReject-v1710, spare5, spare4, spare3, spare2, spare1}","paragraph_zero_based":11651},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":11652},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11653},{"literal_text_all_w_t_and_m_t":"-- TAG-SIDELINKUEINFORMATIONNR-STOP","paragraph_zero_based":11654},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":11655},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11656},{"literal_text_all_w_t_and_m_t":"SidelinkUEinformationNR field descriptions","paragraph_zero_based":11657},{"literal_text_all_w_t_and_m_t":"sl-RxDRX-ReportList","paragraph_zero_based":11658},{"literal_text_all_w_t_and_m_t":"Indicates the accepted DRX configuration that is received from the peer UE and reported to the network for NR sidelink unicast communication.","paragraph_zero_based":11659},{"literal_text_all_w_t_and_m_t":"sl-RxInterestedFreqList","paragraph_zero_based":11660},{"literal_text_all_w_t_and_m_t":"Indicates the index of frequency on which the UE is interested to receive NR sidelink communication. The value 1 corresponds to the frequency of first entry in sl-FreqInfoList broadcast in SIB12, the value 2 corresponds to the frequency of second entry in sl-FreqInfoList broadcast in SIB12 and so on. In this release, only value 1 can be included in the interested frequency list. ","paragraph_zero_based":11661},{"literal_text_all_w_t_and_m_t":"sl-RxInterestedGC-BC-DestList","paragraph_zero_based":11662},{"literal_text_all_w_t_and_m_t":"Indicates the reported QoS profile and associated destination for which UE is interested in reception to the network for NR sidelink groupcast and broadcast communication, or for NR sidelink discovery or ProSe Direct Link Establishment Request as described in TS 24.554 [72], or for Direct Link Establishment Request (TS 24.587 [57]).","paragraph_zero_based":11663}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["0c9c0dde3e1cb44fd921852fb9b7279564e96708a0c5653db6eaaad9f58dc20a","d3efd04d3ca4909312a4bfc200fe52ca81cef95ae59cf90a1c92943a62bf72b4","cb1afb677d4b1769a4e6ba18585a39eb5f8f67019626d2f7dcf3af84d3ec5084","dae1eae9131073c63698ea48548b9f8004847362a6503e530a9f58c69fa7924e","06a446635c1f86be4726291f547daf1e724007193e65aec002862237eb92500b","6137ecaf8bc64b5f9f83c2f5169674bb9a7f636cefb4a8a29b02d993a1126784","267880c26a8b90e341210d97297280dace470e287f7c3908f2442fab330c5488","bc6607bce8583c184983a59c916fe81cddf406898ab5acdd719956eb8150b127","f1c369cdde6949b044602004c923fc87ae4d9410f2d8c7e3be2e593fe5f19203","e9cd1f03bef608ff1fc2201e72513cf13b500fcb1bc0850c4074cd31b9c1a2af","91f7bc5256969bef95a3acac29b80b5c398049970aa4c802bd2735ba29f098df","0734444522e838e32d4c3ce6716ff067557837b54de946f98edcff1337394c5b","b57890210e521c045b920727ac6a2df503a3a8b075b053cab26d19262db273af","09f18fb22967c5c10b7faed6809137567c2ed0949a2c2ae440a6b02c07f3b00c","62ea984aed1557f56996c479e52b0ae012e24c454e1f7780f098221a4c7c25e5","c0107135ff860de43437579573844f236fad925c2a451685fdcc4c83080b5222","c241d2e8b96167dfcc9942dcc38017e8a6d539f5c2d9e43d421eed873c99ad74","52270b0286570bf99330583966ae27d8a208a6ac6d2bb5450efec43dd6063b29","6aa56a039879984b9ea2f592e5af27d6d9f780ade8c741518084327957edb157","7f9e1ecd00c4e08b017c7b007ac40909a7777c3bfb73e6bf70b5180cf1910f12","17b9252ab1869212689ebd179f8118a08752d59f06b60a7dbea689513074be73","13f6b57c4aee3129f318791b3781afde0868572062dad50d10054365e932b9ec","713ddd94d15fcb2e39b09e5a0347a87ce1434026c5cd3dbd6a450610afd7077b","74f27467b904e4927115cf0a436d4580618ec6c40b777ca508fee5444fcd947b"],"paragraph_range_zero_based":[11640,11663],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p11640"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-SourceIdentityRemoteUE","paragraph_zero_based":11664},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the Source Layer-2 ID to be used to establish PC5 link with the target L2 U2N Relay UE for path switch.","paragraph_zero_based":11665},{"literal_text_all_w_t_and_m_t":"sl-TxResourceReq","paragraph_zero_based":11666},{"literal_text_all_w_t_and_m_t":"Parameters to request the transmission resources for NR sidelink communication to the network in the Sidelink UE Information report.","paragraph_zero_based":11667},{"literal_text_all_w_t_and_m_t":"sl-TxResourceReqList","paragraph_zero_based":11668},{"literal_text_all_w_t_and_m_t":"List of parameters to request the transmission resources for NR sidelink communication for the associated destination. If sl-TxResourceReqList-v1700 is present, it shall contain the same number of entries, listed in the same order as in sl-TxResourceReqList-r16.","paragraph_zero_based":11669},{"literal_text_all_w_t_and_m_t":"ue-Type","paragraph_zero_based":11670},{"literal_text_all_w_t_and_m_t":"Indicates the UE is acting as U2N Relay UE or U2N Remote UE.","paragraph_zero_based":11671},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11672},{"literal_text_all_w_t_and_m_t":"SL-TxResourceReq field descriptions","paragraph_zero_based":11673},{"literal_text_all_w_t_and_m_t":"sl-CapabilityInformationSidelink","paragraph_zero_based":11674},{"literal_text_all_w_t_and_m_t":"Includes the UECapabilityInformationSidelink message (which can be also included in ueCapabilityInformationSidelink-r16 in UECapabilityEnquirySidelink from peer UE) received from the peer UE.","paragraph_zero_based":11675},{"literal_text_all_w_t_and_m_t":"sl-CastType","paragraph_zero_based":11676},{"literal_text_all_w_t_and_m_t":"Indicates the cast type for the corresponding destination for which to request the resource.","paragraph_zero_based":11677},{"literal_text_all_w_t_and_m_t":"sl-DestinationIdentity","paragraph_zero_based":11678},{"literal_text_all_w_t_and_m_t":"Indicates the destination for which the TX resource request and allocation from the network are concerned.","paragraph_zero_based":11679},{"literal_text_all_w_t_and_m_t":"sl-DRX-Indication","paragraph_zero_based":11680},{"literal_text_all_w_t_and_m_t":"Indicates the sidelink DRX is applied (value on) or not applied (value off) for the associated destination. This field is only valid for NR sidelink groupcast communication.","paragraph_zero_based":11681},{"literal_text_all_w_t_and_m_t":"sl-DRX-InfoFromRxList","paragraph_zero_based":11682},{"literal_text_all_w_t_and_m_t":"Indicates list of the sidelink DRX configurations as assistance information received from the peer UE for NR sidelink unicast communication.","paragraph_zero_based":11683},{"literal_text_all_w_t_and_m_t":"sl-QoS-InfoList","paragraph_zero_based":11684},{"literal_text_all_w_t_and_m_t":"Includes the QoS profile of the sidelink QoS flow as specified in TS 23.287 [55].","paragraph_zero_based":11685},{"literal_text_all_w_t_and_m_t":"sl-QoS-FlowIdentity","paragraph_zero_based":11686},{"literal_text_all_w_t_and_m_t":"This identity uniquely identifies one sidelink QoS flow between the UE and the network in the scope of UE, which is unique for different destination and cast type.","paragraph_zero_based":11687}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["02c53be8b2f7172f78fcbde24512832ea6cbd0f25fdb5c8269270727eb50f24d","f0eb82aef98b036e2f81b0d2192ec40fb8cf152e2cf5e8a86a6a9d09e1347ab8","bcda04c0906279aa894d117c1a2ab2f1e46e666ea26ba31c814c9222e6775f7b","a6f6d2c2bfe49ceaaefd8d67704657ee82b485e3b87f32a446ad3ebe18c14dc5","5735bd44b0d96fc9f7cc05347a2f117ca4bc35f8ffaf7aca2e229d7fb1955ada","a134a4deecb62b974dbf76a9f9d7206343a8864aaaa932d731831038b025c9d9","298101280ec9da834c636b4481da87a525bf163c3abbe9ed583b1cdcb950eeeb","e017140218ad542c0ded470539d85cca53cb482631c11c55c687ab725d17c818","c1b5ad13a7bb8cec49855414e6e5d83012fae6f32b85c8d9887c1570aa72f58f","51988ed1b5be615a310710f3b3656db0c95916709e4ed1fc7659e63773417d9f","1b40f006de5dd3341041293945fc4171c272c64e8414d0f92e20271dc62b3e5f","7971409c443fd8b9b05bc3381cdd0c1284434acccf826327e68177918f5e8148","e313cd2df30fcdd96cb49e9f80cd23e5515c280d980e6635a974a421a6401d46","83c3149ebd397c23bcbeaa00d9c8fec6363ce824a8a8b181d970ba1fdecb868b","c7299e192be7e09edeacd29528af01b671e2deeed5fb0190a32907a3370b9e9f","52a4961b2fc91f33aa501d5efc993ed7a72bd8abc2c8007bceee2fcb6cf3c84f","db725ee5d460aff7041dbfcf17730a85e32669d9a8f6f1313d27633e1193e3cc","027f1ea71b106802a02ea074164e641171458eed1006cdc29a7435a401be80fb","c819963c3f1f123efa885fd64d2039d9139dd6c0505d481acb762b8d0353cc61","840c7ba15764016af743e7ae9b77b00ad48c8cdf3dee262cac3fad89788b41f7","e0a9827891faa5d0a8f963115dab116356b2fe800ea36d74dcafaa5e40bb5fcd","bb634c2f51af00af37112c05f87de0298cc6f1ed3635ad48857d9472d552d6d4","3238d35ed80ba950fdcafd86e9cfee64e0eb6cde344f891a6cdbe488ee43c87d","c367d6be5d1553ba831936d6d838f60f27351294da686a519771f6dccb6b980f"],"paragraph_range_zero_based":[11664,11687],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p11664"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-RLC-ModeIndication","paragraph_zero_based":11688},{"literal_text_all_w_t_and_m_t":"This field indicates the RLC mode and optionally the related QoS profiles for the sidelink radio bearer, which has not been configured by the network and is initiated by another UE in unicast. The RLC mode for one sidelink radio bearer is aligned between UE and NW by the sl-QoS-FlowIdentity.","paragraph_zero_based":11689},{"literal_text_all_w_t_and_m_t":"sl-TxInterestedFreqList","paragraph_zero_based":11690},{"literal_text_all_w_t_and_m_t":"Each entry of this field indicates the index of frequency on which the UE is interested to transmit NR sidelink communication. The value 1 corresponds to the frequency of first entry in sl-FreqInfoList broadcast in SIB12, the value 2 corresponds to the frequency of second entry in sl-FreqInfoList broadcast in SIB12 and so on. In this release, only value 1 can be included in the interested frequency list. In this release, only one entry can be included in the list.","paragraph_zero_based":11691},{"literal_text_all_w_t_and_m_t":"sl-TypeTxSyncList","paragraph_zero_based":11692},{"literal_text_all_w_t_and_m_t":"A list of synchronization reference used by the UE. The UE shall include the same number of entries, listed in the same order, as in sl-TxInterestedFreqList, i.e. one for each carrier frequency included in sl-TxInterestedFreqList.","paragraph_zero_based":11693},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11694},{"literal_text_all_w_t_and_m_t":"SL-Failure field descriptions","paragraph_zero_based":11695},{"literal_text_all_w_t_and_m_t":"sl-DestinationIdentity","paragraph_zero_based":11696},{"literal_text_all_w_t_and_m_t":"Indicates the destination for which the SL failure is reporting for unicast.","paragraph_zero_based":11697},{"literal_text_all_w_t_and_m_t":"sl-Failure","paragraph_zero_based":11698},{"literal_text_all_w_t_and_m_t":"Indicates the sidelink cause for the sidelink RLF (value rlf), sidelink AS configuration failure (value configFailure) and the rejection of sidelink DRX configuration (value drxReject-v1710) for the associated destination for unicast.","paragraph_zero_based":11699},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11700},{"literal_text_all_w_t_and_m_t":"SL-RxDRX-Report field descriptions","paragraph_zero_based":11701},{"literal_text_all_w_t_and_m_t":"sl-DRX-ConfigFromTx","paragraph_zero_based":11702},{"literal_text_all_w_t_and_m_t":"Indicates the sidelink DRX configuration received from the peer UE for NR sidelink unicast communication.","paragraph_zero_based":11703},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11704},{"literal_text_all_w_t_and_m_t":"SL-RxInterestedGC-BC-Dest field descriptions","paragraph_zero_based":11705},{"literal_text_all_w_t_and_m_t":"sl-RxInterestedQoS-InfoList","paragraph_zero_based":11706},{"literal_text_all_w_t_and_m_t":"Indicates the QoS profile for which UE reports its interested service to which SL DRX is applied to the network, for NR sidelink groupcast or broadcast reception.","paragraph_zero_based":11707},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11708},{"literal_text_all_w_t_and_m_t":"SL-TxResourceReqDisc field descriptions","paragraph_zero_based":11709},{"literal_text_all_w_t_and_m_t":"sl-CastTypeDisc","paragraph_zero_based":11710},{"literal_text_all_w_t_and_m_t":"Indicates the cast type for the NR sidelink discovery messages. Only value broadcast can be set in this release.","paragraph_zero_based":11711}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["b058b36e373e66a22df9da0e88dd67fb95979066831644559b78354ed795ef1d","b7a5d64d6ab1411cce2ba22e215b0a7c5e4f4529fd4c99ec193099f6f0faf2e5","cea865face6f22a8fbf2e2f37ddab6e81f02a73b5209aa91620e7401d7f9f4b7","13ee0475097c1dbb7e4e7429922e084e7f67e3f68f0868900309232e2ba5bf83","45af5014771f0d2543b49555ed82847e6a81057e809ef6d1d24099c77cb67668","9cdf654f6a1fc1dcb6530208a9fca535c17468e0b7ca07c101b0af0c70d4ec9d","8d635853ec2a0112aa58b228c7e099550e7429663a7f7e38d153f62de160dc96","947864ec5dbf399fe8f8b7155b8e63d11fb8827506bb4f38f84bc279ab94fe65","219df64e29d6ff2de27ac0c6c457ccfe814f8f6e6ba0a2ed1f7eac88dcb1da4d","9b3492e1cc19406b49d41885de189c112760ce65d60666a054207b77c01e3f16","4240029c1ef11ed70fc83bd6636b4284515e8366d71002e194a31b140181f894","38c40396887c8a95a7a3cdd1056f21b25d4c7acab02aa78616acdc485297bfef","f5578fc125ddeb6ad63f52bfce68d2ffcf1ca299a0982d28ec4e69e02f1a9eca","d4cef4a619c2a572749442df7051aa0baf4461bf4a5adf89f196ae89cac2e3fa","1a600dc1b41b29a82c40c4bb0b6713c0ccacbf853934eb6dde88ec626c3a9a5e","47f02a685975585ce9350fde621f8ef02ba815953dca2f933e113f5231dbf841","1722df2e54d361cd2ccfd6ab87cdf5b1e555c63e2f1dbc35ac5d588d9fbb0e1e","db437243c60cd0e954823aaef98180b3f10408c75fea42d8c522444ccfcb435c","6b1b93bed71c45393d5b36280557cbf92d593924f98c578b1f260072446b4d1e","e1cb850c3b2cf8e5d77a863c801be5d2f748bedab6f63e9e28c9c4e423396ad7","0153a7c59064fab88d4ceb5bbfb9dd81239433ae0d954d70e714ad52edd895cf","e5089c347d5894c5bfcc8f08c0303f4db0e3a8aed45c9578f6f1fd2e3f7ebb5d","b2573b569b080fb437c8c1500c403b19a35d1f3f897c6807a5a7a7816c85ebc2","eebff2bcbcc871af02834ae59fdc5f1fb94145eb46c479a159b68639f4e616a1"],"paragraph_range_zero_based":[11688,11711],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p11688"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-DestinationIdentityDisc","paragraph_zero_based":11712},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the destination L2 ID for which the TX resource request and allocation from the network are concerned for relay discovery and non-relay discovery.","paragraph_zero_based":11713},{"literal_text_all_w_t_and_m_t":"sl-SourceIdentityRelayUE","paragraph_zero_based":11714},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the source L2 ID of relay-related discovery transmission by L2 U2N Relay UE.","paragraph_zero_based":11715},{"literal_text_all_w_t_and_m_t":"sl-TxInterestedFreqListDisc","paragraph_zero_based":11716},{"literal_text_all_w_t_and_m_t":"Each entry of this field indicates the index of frequency on which the UE is interested to transmit NR sidelink discovery. The value 1 corresponds to the frequency of first entry in sl-FreqInfoList broadcast in SIB12, the value 2 corresponds to the frequency of second entry in sl-FreqInfoList broadcast in SIB12 and so on. In this release, only value 1 can be included in the interested frequency list. In this release, only one entry can be included in the list.","paragraph_zero_based":11717},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11718},{"literal_text_all_w_t_and_m_t":"SL-TxResourceReqCommRelayInfo field descriptions","paragraph_zero_based":11719},{"literal_text_all_w_t_and_m_t":"sl-RelayDRXConfig","paragraph_zero_based":11720},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the applied sidelink DRX configuration for the relay related communication.","paragraph_zero_based":11721},{"literal_text_all_w_t_and_m_t":"sl-DestinationIdentityL2U2N","paragraph_zero_based":11722},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the destination L2 ID for which the TX resource request and allocation from the network are concerned for the established PC5 link for relay by L2 U2N Relay UE, or L3 U2N Relay UE.","paragraph_zero_based":11723},{"literal_text_all_w_t_and_m_t":"sl-LocalID-Request","paragraph_zero_based":11724},{"literal_text_all_w_t_and_m_t":"This field is used to request local UE ID for the corresponding destination by the L2 U2N Relay UE.","paragraph_zero_based":11725},{"literal_text_all_w_t_and_m_t":"sl-TxInterestedFreqListL2U2N","paragraph_zero_based":11726},{"literal_text_all_w_t_and_m_t":"Each entry of this field indicates the index of frequency on which the UE is interested to transmit NR sidelink communication for established PC5 link for relay. The value 1 corresponds to the frequency of first entry in sl-FreqInfoList broadcast in SIB12, the value 2 corresponds to the frequency of second entry in sl-FreqInfoList broadcast in SIB12 and so on. In this release, only value 1 can be included in the interested frequency list. In this release, only one entry can be included in the list.","paragraph_zero_based":11727},{"literal_text_all_w_t_and_m_t":"sl-PagingIdentityRemoteUE","paragraph_zero_based":11728},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the paging UE ID(s) for the corresponding destination(s) by the L2 U2N Relay UE.","paragraph_zero_based":11729},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11730},{"literal_text_all_w_t_and_m_t":"–SystemInformation","paragraph_zero_based":11731},{"literal_text_all_w_t_and_m_t":"The SystemInformation message is used to convey one or more System Information Blocks or Positioning System Information Blocks. All the SIBs or posSIBs included are transmitted with the same periodicity.","paragraph_zero_based":11732},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: N/A","paragraph_zero_based":11733},{"literal_text_all_w_t_and_m_t":"RLC-SAP: TM","paragraph_zero_based":11734},{"literal_text_all_w_t_and_m_t":"Logical channels: BCCH","paragraph_zero_based":11735}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["3bb7c79f768c676559121fffac1cca5bedabf30a7726c58e8e0de096edab00da","ecccc8626eada028bd6586672eb34662dc2152df6fcc27d4f87b1a9a71414227","11ac6a09bc42b986a04a964f415d0d354048839b8788c43cdba87a778c106ada","8758f43f5f7d99b1f9ea34194c1168c971f4cc325bb3d3887f4c12734955da8e","f3b6c905d5a6aca4946a43ff6047137e333e0d6aef220dd6734df3f2935b7258","ab5a90dfcf206829cad0b0d5cfa9135f98ce3e41829796284fbdfeb46a58b347","d38d6891e3909a188d57c1a5c658be45c6637d0f991237f618c73f9b9bcf5acf","7a81107e8c1b01030f9bce9cb0353b953d4e7f4484a2842fe8e468f084793fe1","70906c8f2ccaf98ca63b19444d8ef2192ad3ea5ab271a48a0020c98f0e6b3023","5571cc385bb7d1094ec20a74fcd046c91c4ab73960d1a0ed88f34ffcf1a8ad4b","5de3a488064e5347850a220bddcc2562f0635afc4066fe5211e5a6f9c99cb087","753bf7e689e92a76bd882d10f910db5b569a741a50d56faca3c38391caeb6123","9c39c63751a507a02b9ad16ec147a874ae5ae2404dd8dbc210c57d92a9231baa","752d8cbf959fd2a0e8e456c08815d35f2aff3ef380a36300c4088bb98017af9b","ad5abd33a8cc30bbe68e5e8634ef9ea45d2ebde667b09aa5a40d8e074f027f31","f68a1a4e71cecfbc49c438aacbff4b7fe7ffdc5f042139ef169af9732aa530cf","cfd254bf73bd7a1e04831a674090133194c6e932601926055cc45b4a6fc8287c","460a815b503c03dee7919edbd0670ad2fe15346d488770749db3c45f955a3efd","dc606fdda1fdd8aa69159cbd71e3a26bee8f73ceb5c5f09741e244c3dc5f3bcf","122f217dead2a0c52636173e100f54d469b80c8099bd8e7a567ceb0199575f6f","18f8161262d76e99bd347be0048c6aad22012cca53642f90382f9dfe0891586d","70dc895e427289e4467a8d570299907001a753e8c1b4426b14bfc648f1e8da11","7a7fc1b4cbc9afed985327813c8b90f7f1969dbcf7b82d1da283e33680dc5ca3","bb0cc3c380c9982e7f0742d0bab803ecaf8d185d43125e36262525ccce309fdf"],"paragraph_range_zero_based":[11712,11735],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p11712"}
