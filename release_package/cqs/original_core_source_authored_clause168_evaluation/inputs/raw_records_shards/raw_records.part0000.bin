eral_text_all_w_t_and_m_t":"            profiles-r17                         SEQUENCE {","paragraph_zero_based":39952},{"literal_text_all_w_t_and_m_t":"                profile0x0000-r17                    BOOLEAN,","paragraph_zero_based":39953},{"literal_text_all_w_t_and_m_t":"                profile0x0001-r17                    BOOLEAN,","paragraph_zero_based":39954},{"literal_text_all_w_t_and_m_t":"                profile0x0002-r17                    BOOLEAN","paragraph_zero_based":39955},{"literal_text_all_w_t_and_m_t":"           }","paragraph_zero_based":39956},{"literal_text_all_w_t_and_m_t":"        }","paragraph_zero_based":39957},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":39958},{"literal_text_all_w_t_and_m_t":"    t-Reordering-r17                     ENUMERATED {ms1, ms10, ms40, ms160, ms500, ms1000, ms1250, ms2750}    OPTIONAL -- Need S","paragraph_zero_based":39959}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["c4f5a9f9fb4a0230caffdd673a4f1d77d7ee0edf9c74f006b325b9c36ffc0289","dd47e578752a57985ff4a4d746beef54f68b87d051b9eb44ba4893e4301cab9e","a36ed61d35ea772d40bf28cc921bc011329950c18cbdf4b376bde8196e1e3149","34930abdce36946c0ebb2c150bbb827d1b294e7e136b69996539b91c22039660","e86b75da19f4d09af25bf2a733c03fc182000904e37c971b75dcfd8a9a294619","04418f4712d6c45789edcfa55958127d0f49837f92710a1900a1220646a9f02c","2552ffce9bb50cfb36a7f110f54cc6b3cfd9bfa2cdcd3333ec4ba2c34bb405b7","a13b6b54c9168be6e0333a8d7220298643d1975a551a7c65a89cd168c6575a16","6895b11a68802a80b2549a8ecd96f6d219652fe159d65082715957b7f70e7a5a","3e409e5db7d6a295918bdf383cb6abe0708f69011a0bd0f126fd58a6f4713710","8beb72ea04b9c73c395a7c898bd56ad59b43ff172cc0f830de86800ae9e2f4ad","637959597e6cd647663437b2a8a39ca7b62c9217341fd6ae078102cb628eab37","c29ba07d0b0d706ef453c0cc468785eef9c3e0ccd3aefda2895096eb9bd1972b","578cba2980089909ba20bb40c226641dda15576641251b4371ffa43218bdb668","dd2212dbcbf784494530b8329cc0e74d2ee8382bc670f035cb7727d58e6a782b","5aa40eaad289524c9def2cec2c6087096ae18ac9099b58f86c55d9550896eba3","5b4822c3a49fcfe719bb0cb770842bed1cbc05e9548fed3354372e386d862ca7","1a167f06f27cc18ed1acc4b1e1e6c5973b8aa2fb73d48ad45e04a4da2d504bfb","35cde1b7a707d6b55c7438e74eb41554dfb95ae7f1920e0b118030418055dafe","42a396f8429ff4513694293782a799c8c3b5813db20d3ef4dc406cb4044c42e1","14528eb428af7ad569909ebf1bb5675dc434043422c17216250cf91f127e7ec4","4000ea05ed1b98d73ffb3febc3498d7955d6ce8bb8cd91c3e065245bfffbc9a6","884bc9373d6326a151df821b036eb8c3e4a39e2e80cc76b21f6f03c082013454","41333386c6a54785396bf50a1995aefd28f2737e4e559d8d76ed4b7d60008738"],"paragraph_range_zero_based":[39936,39959],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p39936"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39960},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39961},{"literal_text_all_w_t_and_m_t":"MRB-RLC-ConfigBroadcast-r17 ::=      SEQUENCE {","paragraph_zero_based":39962},{"literal_text_all_w_t_and_m_t":"    logicalChannelIdentity-r17           LogicalChannelIdentity,","paragraph_zero_based":39963},{"literal_text_all_w_t_and_m_t":"    sn-FieldLength-r17                   ENUMERATED {size6}                       OPTIONAL, -- Need S","paragraph_zero_based":39964},{"literal_text_all_w_t_and_m_t":"    t-Reassembly-r17                     T-Reassembly                             OPTIONAL  -- Need S","paragraph_zero_based":39965},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39966},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39967},{"literal_text_all_w_t_and_m_t":"-- TAG-MBS-SESSIONINFOLIST-STOP","paragraph_zero_based":39968},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39969},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39970},{"literal_text_all_w_t_and_m_t":"MBS-SessionInfoList field descriptions","paragraph_zero_based":39971},{"literal_text_all_w_t_and_m_t":"g-RNTI","paragraph_zero_based":39972},{"literal_text_all_w_t_and_m_t":"G-RNTI used to scramble the scheduling and transmission of MTCH.","paragraph_zero_based":39973},{"literal_text_all_w_t_and_m_t":"headerCompression","paragraph_zero_based":39974},{"literal_text_all_w_t_and_m_t":"If rohc is configured, the UE shall apply the configured ROHC profile(s) in downlink.","paragraph_zero_based":39975},{"literal_text_all_w_t_and_m_t":"mbs-SessionId","paragraph_zero_based":39976},{"literal_text_all_w_t_and_m_t":"Indicates an identifier of the MBS session provided by the MTCH.","paragraph_zero_based":39977},{"literal_text_all_w_t_and_m_t":"mrb-listBroadcast","paragraph_zero_based":39978},{"literal_text_all_w_t_and_m_t":"A list of broadcast MRBs to which the associated broadcast MBS session is mapped to.","paragraph_zero_based":39979},{"literal_text_all_w_t_and_m_t":"mtch-neighbourCell","paragraph_zero_based":39980},{"literal_text_all_w_t_and_m_t":"Indicates neighbour cells which provide this service on MTCH. The first bit is set to 1 if the service is provided on MTCH in the first cell in mbs-NeighbourCellList, otherwise it is set to 0. The second bit is set to 1 if the service is provided on MTCH in the second cell in mbs-NeighbourCellList, and so on. If the service is not available in any neighbouring cell and mbs-NeighbourCellList is signalled, the network sets all bits in this field to 0. The field is absent when mbs-NeighbourCellList is absent or an empty mbs-NeighbourCellList is signalled. If this field is absent when mbs-NeighbourCellList is absent or a non-empty mbs-NeighbourCellList is signalled, the related service may or may not be available in any neighbouring cell, i.e. the UE cannot determine the presence or absence of an MBS service in neighbouring cells based on the absence of this field. If this field is absent and an empty mbs-NeighbourCellList is signalled, then the UE shall assume that MBS broadcast services signalled in mbs-SessionInfoList in the MBSBroadcastConfiguration message are not provided in any neighbour cell.","paragraph_zero_based":39981},{"literal_text_all_w_t_and_m_t":"mtch-schedulingInfo","paragraph_zero_based":39982},{"literal_text_all_w_t_and_m_t":"Indicates the index of DRX configuration entry in drx-ConfigPTM-List that is used for scheduling the MTCH. The value 0 corresponds to the first entry in drx-ConfigPTM-List, the value 1 corresponds to the second entry in drx-ConfigPTM-List and so on. In case mtch-schedulingInfo is absent for a G-RNTI (i.e. no PTM DRX), the UE shall monitor for PDCCH scrambled with G-RNTI in any slot according to the search space configured for MTCH [see TS 38.213 [13], clause 10.1].","paragraph_zero_based":39983}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["2abe93787f55e28d7214281b70226da9e1bc50c68b746e5249060b6721e2abda","34997a3d3423e219fd57aa5e198bf4e85c9f9f1d8bd1d6b41082d5b67899bfe2","b3c7864ff8b84c87512c19d1b2367391f58fede4026b7ef96c0e71a45b4c62a1","f9e5d7da1d73c03ad18b0adfb920d783feaab306f41fdae80be9c8309eff96b8","fbdbba15c874bb6e946f8fb26999fc8366887ae1b7fae42cbc673c1f0a66fb9e","1120bb8bbe46b9fa82668702e83276e45dad5795e928633fd924586d9b88c014","f81e30e7291a83dfd5adac56d464aa8d37dfa09afec61dd475ae7a043936044e","c19a5eeac326764195a2ec84d94899f23a86c97ff9d37f8825b5011fda5f3e51","bf79fc513e9581a6d8b451a5323e9dc08500d0d15db478d8c9a00e46e8c1c063","8394a1cbf26f3366319bdb89f1bbf366bc5ad7e757737973a011f67e8d788ab6","d4d45b28d5ab2e04355de49b9b2be868678071dae1192ec44dd0047dc1ce9693","561283542978889e3ea827bb72374ab9362d1ba01c3882d6874103d65b6cc2ab","aef6f6321ff1031765ba2192ec8aaa499947d9a3c6235bce36a10549d4a3869e","f3a3e32105463205e94eb9b36903dd3d009572f572c6630eed62a353fec75ac9","e3d3ce2bb3b57c4b428471b4c5372d67543dead2ab2043bb71225e7c23e6f4ad","87dfb48d58db2fe9d1f181c514fcd622d1866f0c375305922d3bb8980b4dc67d","590391058588ea5e620feef17f2aa25faf427b8f484c56ecb0c0cca949dfdbd3","12b9057e671c605bef032c553b5695d93181b4cddb80268e3144872f1f2dadcb","6c2b4eba8096988b9065d20facaa3fd1b1eafe5195fb4b69a72186b543f3665e","72ba68431a6e579620430d494db7cbf05ddc9ece48c796fea34dd1c608c5e059","e96b5932de25cb43b92a10e656f994cf1244ce239e4b84806bdc69ce7164750a","d114111deeb3aeaafddbff82b0c6f8233420fd64eb3c2ff92c62182a1cc16b57","dedb52a0b26c8301a23a010f316a5f8a85cbea31d810cf3f479828e37cffe7a4","97af68891cb49cddd65e95162ee0b84d9a4da4424857aa30cf33c448185c1328"],"paragraph_range_zero_based":[39960,39983],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p39960"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"mtch-SSB-MappingWindowIndex","paragraph_zero_based":39984},{"literal_text_all_w_t_and_m_t":"Indicates the index of MTCH-SSB-MappingWindowCycleOffset configuration entry in MTCH-SSB-MappingWindowList. The value 0 corresponds to the first entry in MTCH-SSB-MappingWindowList, the value 1 corresponds to the second entry in MTCH-SSB-MappingWindowList and so on. This field is set to the same value for all MBS sessions mapped to the same G-RNTI.","paragraph_zero_based":39985},{"literal_text_all_w_t_and_m_t":"pdcp-SN-SizeDL","paragraph_zero_based":39986},{"literal_text_all_w_t_and_m_t":"Indicates that PDCP sequence number size of 12 bits is used, as specified in TS 38.323 [5]. When the field is absent the UE applies the value as specified in 9.1.1.7.","paragraph_zero_based":39987},{"literal_text_all_w_t_and_m_t":"pdschConfigIndex","paragraph_zero_based":39988},{"literal_text_all_w_t_and_m_t":"Indicates the index of PDSCH configuration entry in pdschConfigList for MTCH. Value 0 corresponds to the first entry in pdschConfigList, the value 1 corresponds to the second entry in pdschConfigList and so on. When the field is absent the UE applies the first entry in pdschConfigList for MTCH.","paragraph_zero_based":39989},{"literal_text_all_w_t_and_m_t":"sn-FieldLength","paragraph_zero_based":39990},{"literal_text_all_w_t_and_m_t":"Indicates that the RLC SN field size of 6 bits is used, see TS 38.322 [4]. When the field is absent the UE applies the value as specified in 9.1.1.7.","paragraph_zero_based":39991},{"literal_text_all_w_t_and_m_t":"t-Reassembly","paragraph_zero_based":39992},{"literal_text_all_w_t_and_m_t":"Timer for reassembly in TS 38.322 [4], in milliseconds. Value ms0 means 0 ms, value ms5 means 5 ms and so on. When the field is absent the UE applies the value in specified in 9.1.1.7.","paragraph_zero_based":39993},{"literal_text_all_w_t_and_m_t":"t-Reordering","paragraph_zero_based":39994},{"literal_text_all_w_t_and_m_t":"Value in ms of t-Reordering specified in TS 38.323 [5]. Value ms1 corresponds to 1 ms, value ms10 corresponds to 10 ms, and so on.  When the field is absent the UE applies the value as specified in 9.1.1.7.","paragraph_zero_based":39995},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39996},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":39997},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":39998},{"literal_text_all_w_t_and_m_t":"MTCH-Mapping","paragraph_zero_based":39999},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the number of actual transmitted SSBs determined according to ssb-PositionsInBurst in SIB1 is more than 1, and searchspaceMTCH is not set to zero (including the case where searchSpaceMTCH is absent and searchSpaceMCCH is not set to zero). Otherwise, it is absent, Need R.","paragraph_zero_based":40000},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40001},{"literal_text_all_w_t_and_m_t":"–MTCH-SSB-MappingWindowList","paragraph_zero_based":40002},{"literal_text_all_w_t_and_m_t":"The IE MTCH-SSB-MappingWindowList is used to configure MTCH PDCCH ocassions to SSB mapping window related periodic and offset parameters.","paragraph_zero_based":40003},{"literal_text_all_w_t_and_m_t":"MTCH-SSB-MappingWindowList information element","paragraph_zero_based":40004},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":40005},{"literal_text_all_w_t_and_m_t":"-- TAG-MTCH-SSB-MAPPINGWINDOWLIST-START","paragraph_zero_based":40006},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40007}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96