{"fields":{"filename":"R2-2311155.zip::R2-2311155.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"B","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Rel-18","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-16(Release 16)Rel-17(Release 17)Rel-18(Release 18)Rel-19(Release 19)","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":"Reason for change:","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"RAN4 LS R2-2309463/R4-2314478 requests RAN2 to introduce a new UE assistance information to indicate UE preference for multi-Rx operation due to power saving or overheating purposes (i.e., UE preference on not operating simultaneous reception with different QCL-typeD).","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"Introduce UE capabilty for UE assistance information reporting on multi-Rx operation.","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"The new feature of UE preference reporting on multi-Rx operation introduced by RAN4 can not be supported.","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"d3539b88153eb1825c1ff8f900b2fee60bc28c01f14d3c311eac8eabe315c4d0","original_member_sha256":"4421de7f3746b536970f96e57e25fecf59510dc02ad23fdce959f0a78ff61a4c","paragraph_ElementTree_utf8_XML_sha256":["cec1f3846fc3b34f3c7dcac50f79f2ac88a33b319303e6ca142a4a8a07cd6614","01f0b7968e0905c80c4a5bb37dd205a0686493efb29c328c19e0b09bfbc34fc5","3d627ac0c50b0cdcba61d99ceb51a49487920fdc7999390e8526606c3b2a7c39","217bef1fbe8523deb895895663a57cbe1c5bca4c5657d7af99b2fe2d47b28973","7c2a4d1b34631ed11d635b9e24e48ea9d3c0bba89136aaccb4759027ff10a86c","6c8b3509ed49d5e28dc0ea4fc96e311743d4041d8e3d02c518c528bed6c2e4e4","1226e5726f39d0b9dae14546fc45f47127cab60e5954582aa261e6b541217831","95c987fcc2340a0b24bc2241ead492c94e559d6ae73aabe5c2349bf26f1866e4","c408a20b6f3de380301df2e29a364e61d44c907f67b693436737e4759a2b650d","0235075ab6662ab6f1d7db3fad9fe33122f3fc1f658165ef5efe24085d5708fc","3bc15f040bd707ea0341343d5a64e5ca12880107bc82c651b89ab4894ddb0b3b","19fcf8bd726be0399e4a5116c5e877491fa92080a4ece3b41b10892ca5249dc4","045df4430baa774010893b9f849e85a021321b2806bc331cfd4bee61ee0aba24","f7cc4501907f86490850a21591b3db13352f50634a7124127e5d2892773e98cb","71992baa6ebee001a88643f2fb11f1b5ef9c9259223e22a8e1ef707a2f4c70a3","d4ed2