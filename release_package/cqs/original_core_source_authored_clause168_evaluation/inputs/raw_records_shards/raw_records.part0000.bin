{"fields":{"filename":"R2-2301466.zip::R2-2301466_CR38.321_R17_threshold.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":144},{"literal_text_all_w_t_and_m_t":"5.1.2Random Access Resource selection","paragraph_zero_based":145},{"literal_text_all_w_t_and_m_t":"If the selected RA_TYPE is set to 4-stepRA, the MAC entity shall:","paragraph_zero_based":146},{"literal_text_all_w_t_and_m_t":"1>if the Random Access procedure was initiated for SpCell beam failure recovery (as specified in clause 5.17); and","paragraph_zero_based":147},{"literal_text_all_w_t_and_m_t":"1>if the beamFailureRecoveryTimer (in clause 5.17) is either running or not configured; and","paragraph_zero_based":148},{"literal_text_all_w_t_and_m_t":"1>if the contention-free Random Access Resources for beam failure recovery request associated with any of the SSBs and/or CSI-RSs have been explicitly provided by RRC; and","paragraph_zero_based":149},{"literal_text_all_w_t_and_m_t":"1>if at least one of the SSBs with SS-RSRP above rsrp-ThresholdSSB amongst the SSBs in candidateBeamRSList or the CSI-RSs with CSI-RSRP above rsrp-ThresholdCSI-RS amongst the CSI-RSs in candidateBeamRSList is available:","paragraph_zero_based":150},{"literal_text_all_w_t_and_m_t":"2>select an SSB with SS-RSRP above rsrp-ThresholdSSB amongst the SSBs in candidateBeamRSList or a CSI-RS with CSI-RSRP above rsrp-ThresholdCSI-RS amongst the CSI-RSs in candidateBeamRSList;","paragraph_zero_based":151},{"literal_text_all_w_t_and_m_t":"2>if CSI-RS is selected, and there is no ra-PreambleIndex associated with the selected CSI-RS:","paragraph_zero_based":152},{"literal_text_all_w_t_and_m_t":"3>set the PREAMBLE_INDEX to a ra-PreambleIndex corresponding to the SSB in candidateBeamRSList which is quasi-colocated with the selected CSI-RS as specified in TS 38.214 [7].","paragraph_zero_based":153},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":154},{"literal_text_all_w_t_and_m_t":"3>set the PREAMBLE_INDEX to a ra-PreambleIndex corresponding to the selected SSB or CSI-RS from the set of Random Access Preambles for beam failure recovery request.","paragraph_zero_based":155},{"literal_text_all_w_t_and_m_t":"1>else if the ra-PreambleIndex has been explicitly provided by PDCCH; and","paragraph_zero_based":156},{"literal_text_all_w_t_and_m_t":"1>if the ra-PreambleIndex is not 0b000000:","paragraph_zero_based":157},{"literal_text_all_w_t_and_m_t":"2>set the PREAMBLE_INDEX to the signalled ra-PreambleIndex;","paragraph_zero_based":158},{"literal_text_all_w_t_and_m_t":"2>select the SSB signalled by PDCCH.","paragraph_zero_based":159},{"literal_text_all_w_t_and_m_t":"1>else if the contention-free Random Access Resources associated with SSBs have been explicitly provided in rach-ConfigDedicated and at least one SSB with SS-RSRP above rsrp-ThresholdSSB amongst the associated SSBs is available:","paragraph_zero_based":160},{"literal_text_all_w_t_and_m_t":"2>select an SSB with SS-RSRP above rsrp-ThresholdSSB amongst the associated SSBs;","paragraph_zero_based":161},{"literal_text_all_w_t_and_m_t":"2>set the PREAMBLE_INDEX to a ra-PreambleIndex corresponding to the selected SSB.","paragraph_zero_based":162},{"literal_text_all_w_t_and_m_t":"1>else if the contention-free Random Access Resources associated with CSI-RSs have been explicitly provided in rach-ConfigDedicated and at least one CSI-RS with CSI-RSRP above rsrp-ThresholdCSI-RS amongst the associated CSI-RSs is available:","paragraph_zero_based":163},{"literal_text_all_w_t_and_m_t":"2>select a CSI-RS with CSI-RSRP above rsrp-ThresholdCSI-RS amongst the associated CSI-RSs;","paragraph_zero_based":164},{"literal_text_all_w_t_and_m_t":"2>set the PREAMBLE_INDEX to a ra-PreambleIndex corresponding to the selected CSI-RS.","paragraph_zero_based":165},{"literal_text_all_w_t_and_m_t":"1>else if the Random Access procedure was initiated for SI request (as specified in TS 38.331 [5]); and","paragraph_zero_based":166},{"literal_text_all_w_t_and_m_t":"1>if the Random Access Resources for SI request have been explicitly provided by RRC:","paragraph_zero_based":167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"7bfc481d94d17903db419976e7fade4d782f0507aad540fef2bde15e9796a1c8","original_member_sha256":"4af3775736bbe3798670044795f5e96edd1d746ce169bf0fb01a7da2f8134b1a","paragraph_ElementTree_utf8_XML_sha256":["0476a9dda668d912200f7fc321f64d072ecab11325ab790d9815763a0b9fd83f","d96e9c1d9a4dfb250f18f63da1e42245fe1f7b81141afb7da9627c6c06a5757e","9972ef3785698d300a9f914d0bfeb5ed3740b39ea782ca6f25c156218cb952d8","2c66478704c29af1c940d060ec7bd68d94845fac412896bb0a55b69b68d29589","2cf9ec9ccafc1323329b0fbee1113c0b2e0358ff50802d1bc10d41a400896bb0","5daefb0d3d1aef4e3454fa4652ccf1f9413c1b88d1676506bba74f97767a9d9a","f23c5ad4b89696baaed7d5e0c72f35d8610938375350dec595d1eb1966458b4a","4e784241503820ab7530eaeff30b11a7fdc1924109568cba985be8469a5afd05","ebd9c97797b1c3caefdddc0100e8539ea73a2ac9b31333f04811862e5b9c0664","da754f12ad006fe941cf2bff30597c926da907f2a082c2ef7ffa404116dc35cd","76dcf8941accc3dd365d416759d6d142fdd116b55fe8f5c7e30ea0bce23e4998","9312892a836d612e97a2ef2e764364af719b5eb585ed2d62606de042124df838","96385a120fac5fc6115049833ddb81b9cd54c536fa671ca1f6fa3a87943b3f7b","5702013f22ddb3af07521fc426a017282ca33bddd13d06f6c37c9fe8194a56b8","78017837f905aef37fd90b260b1ac2000eb4650e5a151ed3308a05d505b821c6","5f460eefbf7ff4e9a6756306f9067dc0bd35b0510a6d05b6953ed1aca00216a2","f9dd44f60ff47a4df00230da4baf2329e5c4d3f82558ab0701a474aa785e1f65","9df066ce97fba9bae4ab88d642d530e39b714a3ae0de7070fd2f39b7ce2c7730","47997ca7d72f5cda59598af932770d12a03f88f1985082b739689bb9c28928e3","66c3201b3eb1529fbde08d87ca5e27e68a461423cd1ff0f0a6cdcdc8f15d0358","2b3dd3d514097ce2b91bc52ebfccca496b13067fe82d783972b82e5e583a353a","90e120af2e74097ff3bdf5a478f0aabcb336a4d392f60884309bbbb05b18d387","5f47e3c6c0ee03262a5f4920e0dd08a0f9e6108a6439039229eeae06770fcb98","028d928127182548cc3ca69158081666cd635e6fa84f4f561f8c60675eb4d9b3"],"paragraph_range_zero_based":[144,167],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2301466.zip::R2-2301466_CR38.321_R17_threshold.docx:p144"}
{"fields":{"filename":"R2-2301466.zip::R2-2301466_CR38.321_R17_threshold.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if at least one of the SSBs with SS-RSRP above rsrp-ThresholdSSB is available:","paragraph_zero_based":168},{"literal_text_all_w_t_and_m_t":"3>select an SSB with SS-RSRP above rsrp-ThresholdSSB.","paragraph_zero_based":169},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":170},{"literal_text_all_w_t_and_m_t":"3>select any SSB.","paragraph_zero_based":171},{"literal_text_all_w_t_and_m_t":"2>select a Random Access Preamble corresponding to the selected SSB, from the Random Access Preamble(s) determined according to ra-PreambleStartIndex as specified in TS 38.331 [5];","paragraph_zero_based":172},{"literal_text_all_w_t_and_m_t":"2>set the PREAMBLE_INDEX to selected Random Access Preamble.","paragraph_zero_based":173},{"literal_text_all_w_t_and_m_t":"1>else (i.e. for the contention-based Random Access preamble selection):","paragraph_zero_based":174},{"literal_text_all_w_t_and_m_t":"2>if at least one of the SSBs with SS-RSRP above rsrp-ThresholdSSB is available:","paragraph_zero_based":175},{"literal_text_all_w_t_and_m_t":"3>select an SSB with SS-RSRP above rsrp-ThresholdSSB.","paragraph_zero_based":176},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":177},{"literal_text_all_w_t_and_m_t":"3>select any SSB.","paragraph_zero_based":178},{"literal_text_all_w_t_and_m_t":"2>if the RA_TYPE is switched from 2-stepRA to 4-stepRA:","paragraph_zero_based":179},{"literal_text_all_w_t_and_m_t":"3>if a Random Access Preambles group was selected during the current Random Access procedure:","paragraph_zero_based":180},{"literal_text_all_w_t_and_m_t":"4>select the same group of Random Access Preambles as was selected for the 2-step RA type.","paragraph_zero_based":181},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":182},{"literal_text_all_w_t_and_m_t":"4>if Random Access Preambles group B is configured; and","paragraph_zero_based":183},{"literal_text_all_w_t_and_m_t":"4>if the transport block size of the MSGA payload configured in the rach-ConfigDedicated corresponds to the transport block size of the MSGA payload associated with Random Access Preambles group B:","paragraph_zero_based":184},{"literal_text_all_w_t_and_m_t":"5>select the Random Access Preambles group B.","paragraph_zero_based":185},{"literal_text_all_w_t_and_m_t":"4>else:","paragraph_zero_based":186},{"literal_text_all_w_t_and_m_t":"5>select the Random Access Preambles group A.","paragraph_zero_based":187},{"literal_text_all_w_t_and_m_t":"2>else if Msg3 buffer is empty:","paragraph_zero_based":188},{"literal_text_all_w_t_and_m_t":"3>if Random Access Preambles group B is configured:","paragraph_zero_based":189},{"literal_text_all_w_t_and_m_t":"4>if the potential Msg3 size (UL data available for transmission plus MAC subheader(s) and, where required, MAC CEs) is greater than ra-Msg3SizeGroupA and the pathloss is less than PCMAX (of the Serving Cell performing the Random Access Procedure) – preambleReceivedTargetPower – msg3-DeltaPreamble – messagePowerOffsetGroupB; or","paragraph_zero_based":190},{"literal_text_all_w_t_and_m_t":"4>if the Random Access procedure was initiated for the CCCH logical channel and the CCCH SDU size plus MAC subheader is greater than ra-Msg3SizeGroupA:","paragraph_zero_based":191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"7bfc481d94d17903db419976e7fade4d782f0507aad540fef2bde15e9796a1c8","original_member_sha256":"4af3775736bbe3798670044795f5e96edd1d746ce169bf0fb01a7da2f8134b1a","paragraph_ElementTree_utf8_XML_sha256":["85e419e9e771f961f35cfd17b289c83995114e7182fbef7641ff3da91a24c256","cc2055be8b73ec11547e09356486b6465aba1d87cfca7d41fec7073dccdf2e59","d44afe69d2b82be0bf16170ed6b583be0c84d6e0fdbc66c202193e67dc823100","4d06b8b7728e96ada20a2767b7866ae9ee2b7e6f18106e49b54504fbac7312ec","6a561acb41208b343701d2b15938012caec794b55de0409e27ce5c6e683362f4","a9c32fef0136a13fad8ae5976a16fe2d02925e248f8d7515cd35ec09eced15c6","45476eee90727746e31c17ff00b166603a8f5839e753221cc92be4819ca5f1cb","af595672a8ecc5cd63eeed58a136e7f9374fc403a924667f0a28a22e8aa443b6","7d9c58f0a377214330748fae4a61e14a4996a0a5afc384886f41dafb44b55514","64cd087638da2e82ef2785f6f03e891b08703260d53b9fa7db3f84665c0ff711","71575a5dbeeea44c86d74c9f7d705bca806be10fe1bfc0b0a17ca66e66ececc8","95952a322758e1142fe26c4bc63fef5a0773c79f646aac3f956aff60466d93a2","971eceac90a3a32ab1a184cfeb2914fc8af0621ab6a41b3970b91fe604401167","109c75ba9003c7c5446e09ba9218c4799c1fb25880aa669966703294750845f3","28244957f8b017a73f95a5676172ef01be9d349392abdccd4230c32371ee34e8","ceb4bdcedd613996a0fa04ce2ea7ccf23a5e77b05513240e89367d641a9db5cf","3608902bca8ec1965944c88bbdc3b8d165d0641ea2dc64c256c3694aed821844","c57caa3c628485e3f1cdcb7e9b5bee3e3ad96bf69151955124a7012e0039dc30","ef4b6818092abc3db3fba43f58aba1422bff048474430611abcbc802f2b03ffa","3abc5ba1233317edd91606b56884823e47628b6d4593b959c049e67753092c44","70146599ffd00bad1be539096e65f3cb2941e56f10ab6350c5635271aa323341","b3116bf31e55960d368396ef92a686e0dacddd709d073f4a0b6c5ceefaa1cc13","c0d287faba378e57fe1e287b81c7fa9106b20aae59f82b1c157d8df9b6ed2ddd","c6a6f3c86804bd3503c7668ba77effe4b72b9ca45c597df824255245583606be"],"paragraph_range_zero_based":[168,191],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2301466.zip::R2-2301466_CR38.321_R17_threshold.docx:p168"}
{"fields":{"filename":"R2-2301466.zip::R2-2301466_CR38.321_R17_threshold.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5>select the Random Access Preambles group B.","paragraph_zero_based":192},{"literal_text_all_w_t_and_m_t":"4>else:","paragraph_zero_based":193},{"literal_text_all_w_t_and_m_t":"5>select the Random Access Preambles group A.","paragraph_zero_based":194},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":195},{"literal_text_all_w_t_and_m_t":"4>select the Random Access Preambles group A.","paragraph_zero_based":196},{"literal_text_all_w_t_and_m_t":"2>else (i.e. Msg3 is being retransmitted):","paragraph_zero_based":197},{"literal_text_all_w_t_and_m_t":"3>select the same group of Random Access Preambles as was used for the Random Access Preamble transmission attempt corresponding to the first transmission of Msg3.","paragraph_zero_based":198},{"literal_text_all_w_t_and_m_t":"2>select a Random Access Preamble randomly with equal probability from the Random Access Preambles associated with the selected SSB and the selected Random Access Preambles group;","paragraph_zero_based":199},{"literal_text_all_w_t_and_m_t":"2>set the PREAMBLE_INDEX to the selected Random Access Preamble.","paragraph_zero_based":200},{"literal_text_all_w_t_and_m_t":"1>if the Random Access procedure was initiated for SI request (as specified in TS 38.331 [5]); and","paragraph_zero_based":201},{"literal_text_all_w_t_and_m_t":"1>if ra-AssociationPeriodIndex and si-RequestPeriod are configured:","paragraph_zero_based":202},{"literal_text_all_w_t_and_m_t":"2>determine the next available PRACH occasion from the PRACH occasions corresponding to the selected SSB in the association period given by ra-AssociationPeriodIndex in the si-RequestPeriod permitted by the restrictions given by the ra-ssb-OccasionMaskIndex if configured (the MAC entity shall select a PRACH occasion randomly with equal probability amongst the consecutive PRACH occasions according to clause 8.1 of TS 38.213 [6] corresponding to the selected SSB).","paragraph_zero_based":203},{"literal_text_all_w_t_and_m_t":"1>else if an SSB is selected above:","paragraph_zero_based":204},{"literal_text_all_w_t_and_m_t":"2>determine the next available PRACH occasion from the PRACH occasions corresponding to the selected SSB permitted by the restrictions given by the ra-ssb-OccasionMaskIndex if configured, or ssb-SharedRO-MaskIndex if configured, or indicated by PDCCH (the MAC entity shall select a PRACH occasion randomly with equal probability amongst the consecutive PRACH occasions according to clause 8.1 of TS 38.213 [6] regardless the FR2 UL gap, corresponding to the selected SSB; the MAC entity may take into account the possible occurrence of measurement gaps and MUSIM gaps when determining the next available PRACH occasion corresponding to the selected SSB).","paragraph_zero_based":205},{"literal_text_all_w_t_and_m_t":"1>else if a CSI-RS is selected above:","paragraph_zero_based":206},{"literal_text_all_w_t_and_m_t":"2>if there is no contention-free Random Access Resource associated with the selected CSI-RS:","paragraph_zero_based":207},{"literal_text_all_w_t_and_m_t":"3>determine the next available PRACH occasion from the PRACH occasions, permitted by the restrictions given by the ra-ssb-OccasionMaskIndex if configured, corresponding to the SSB in candidateBeamRSList which is quasi-colocated with the selected CSI-RS as specified in TS 38.214 [7] (the MAC entity shall select a PRACH occasion randomly with equal probability amongst the consecutive PRACH occasions according to clause 8.1 of TS 38.213 [6] regardless the FR2 UL gap, corresponding to the SSB which is quasi-colocated with the selected CSI-RS; the MAC entity may take into account the possible occurrence of measurement gaps and MUSIM gaps when determining the next available PRACH occasion corresponding to the SSB which is quasi-colocated with the selected CSI-RS).","paragraph_zero_based":208},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":209},{"literal_text_all_w_t_and_m_t":"3>determine the next available PRACH occasion from the PRACH occasions in ra-OccasionList corresponding to the selected CSI-RS (the MAC entity shall select a PRACH occasion randomly with equal probability amongst the PRACH occasions occurring simultaneously but on different subcarriers regardless the FR2 UL gap, corresponding to the selected CSI-RS; the MAC entity may take into account the possible occurrence of measurement gaps and MUSIM gaps when determining the next available PRACH occasion corresponding to the selected CSI-RS).","paragraph_zero_based":210},{"literal_text_all_w_t_and_m_t":"1>perform the Random Access Preamble transmission procedure (see clause 5.1.3).","paragraph_zero_based":211},{"literal_text_all_w_t_and_m_t":"NOTE 1:Except for the case where the Random Access procedure was initiated for SpCell beam failure recovery, the UE determination of whether  there is an SSB with SS-RSRP above rsrp-ThresholdSSB or a CSI-RS with CSI-RSRP above rsrp-ThresholdCSI-RS, is using the latest unfiltered L1-RSRP measurement. Otherwise, the UE uses the filtered L1-RSRP measurements according to clause(s) 8.5.5.2, 8.5.6.2 of TS 38.133 [11]","paragraph_zero_based":212},{"literal_text_all_w_t_and_m_t":"NOTE 2:Void.","paragraph_zero_based":213},{"literal_text_all_w_t_and_m_t":"NOTE 3:If a RedCap UE in RRC_IDLE or RRC_INACTIVE mode is configured with a BWP indicated by initialDownlinkBWP-RedCap which is not associated with any SSB, SS-RSRP measurement is performed based on the SSB associated with the BWP indicated by initialDownlinkBWP.","paragraph_zero_based":214},{"literal_text_all_w_t_and_m_t":"NOTE 4:If a RedCap UE in RRC_IDLE or RRC_INACTIVE mode is configured with a BWP indicated by initialDownlinkBWP-RedCap which is not associated with any SSB for RACH, it is up to the UE implementation to perform a new RSRP measurements before Msg1/MsgA retransmission.","paragraph_zero_based":215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"7bfc481d94d17903db419976e7fade4d782f0507aad540fef2bde15e9796a1c8","original_member_sha256":"4af3775736bbe3798670044795f5e96edd1d746ce169bf0fb01a7da2f8134b1a","paragraph_ElementTree_utf8_XML_sha256":["665e30e802ced09b56a232e14a7cb89172785cc7ea3a8c9b5a32161aceb7dde2","682fa08907c018022e9ff500852c7087d4176e65dda0076b658b34f83ad79e26","7cd45275a96860b2ab8fc46620cb9047dfeb5b70c75dc3f303767cb2288926b2","e40c15e637dc61a9fcf16a858ff87c63fc0ab82106b9a32f594feabdc0bb3b9a","e4a33c10e1790472aa764ae01f3a35a00955dfbff1408c2671643ba85ae0fed0","befa158fcbfba0a90f156c632cc3f480a3a6ba726e6d7ab6680e5e2cfb8fde5f","065cfaf428a799b5136be080f946b500a67719ef3d1015600936a4894670751b","65fa4bac47e813df8c0d0752dea4ef6b2c442ec27a7688fab9c00e460e744a47","466f009a0f0bc577aa87176172d31e4f4881efc4c639f8afe3e0f14f62474670","ea19d2b928292d8faec85fcabc14c1d4afdb6359ac48de1d99e6387d7492e9ae","516ea8eb031d0cc9f1f43cb4bd4e34bed8cbb4215dc6e4dbab15b8ad44b3eb83","e6dd589c68999c2a16ed04e04e638f9de989b46b6a05a93789271040bd7c9da2","87025d0ffaaecd070690390324a53a7ac413415d5c6c38c9fe29c72dbfa5366e","47a5c27a6824dd62ae9a2757786301bba2253ba9aa656bf1c0f09bcfd69d87db","7c679bb999c921854a356ae0a7572035f1a95d083eed244e176b4fd9dd31eea4","063c09f313c27deaa9b2c276e76f2f0b34935d82d813630ba50640ba47745856","ed08797a99bdb1959101f62a8c08f27b302f2617d0495d8c29341e4b43129e0d","30fe1750465f57939dc5d0bac869f2cc0b825f315a7f399de639af53257a0701","8af73a3a2572c2c0ce2443dea090ffc0b88d462a0bb1ca9f34703e5d1c6dcea1","399eb5fb9c8b18770e4730ad38cec0479ac0eeee7b0be9f7177df17f163b1246","c14ecca22ecfe6ec9fa63307b2ffc355f57a277b2009e295edc3b2cac441dac5","6e8cf69aa8a7f37a2f6de1bbcb3f1202afc1037a6a32a41bfff6644e0cb8f45f","f9cc1e0d9c1139fdd6f67d1dbd370105c408faaae2b3feb3bb7ebb88312c271b","a855e3c99a48bc783e4062f8d08f1a84d337f3dc8c5e051b00de6b555223fe5a"],"paragraph_range_zero_based":[192,215],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2301466.zip::R2-2301466_CR38.321_R17_threshold.docx:p192"}
