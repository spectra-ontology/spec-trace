{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"phy-PriorityIndex","paragraph_zero_based":27048},{"literal_text_all_w_t_and_m_t":"Indicates whether this scheduling request resource is high or low priority in PHY prioritization/multiplexing handling (see TS 38.213 [13], clause 9.2.4). Value p0 indicates low priority and value p1 indicates high priority.","paragraph_zero_based":27049},{"literal_text_all_w_t_and_m_t":"resource","paragraph_zero_based":27050},{"literal_text_all_w_t_and_m_t":"ID of the PUCCH resource in which the UE shall send the scheduling request. The actual PUCCH-Resource is configured in PUCCH-Config of the same UL BWP and serving cell as this SchedulingRequestResourceConfig. The network configures a PUCCH-Resource of PUCCH-format0 or PUCCH-format1 (other formats not supported) (see TS 38.213 [13], clause 9.2.4)","paragraph_zero_based":27051},{"literal_text_all_w_t_and_m_t":"schedulingRequestID","paragraph_zero_based":27052},{"literal_text_all_w_t_and_m_t":"The ID of the SchedulingRequestConfig that uses this scheduling request resource.","paragraph_zero_based":27053},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27054},{"literal_text_all_w_t_and_m_t":"–SchedulingRequestResourceId","paragraph_zero_based":27055},{"literal_text_all_w_t_and_m_t":"The IE SchedulingRequestResourceId is used to identify scheduling request resources on PUCCH.","paragraph_zero_based":27056},{"literal_text_all_w_t_and_m_t":"SchedulingRequestResourceId information element","paragraph_zero_based":27057},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27058},{"literal_text_all_w_t_and_m_t":"-- TAG-SCHEDULINGREQUESTRESOURCEID-START","paragraph_zero_based":27059},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27060},{"literal_text_all_w_t_and_m_t":"SchedulingRequestResourceId ::=     INTEGER (1..maxNrofSR-Resources)","paragraph_zero_based":27061},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27062},{"literal_text_all_w_t_and_m_t":"-- TAG-SCHEDULINGREQUESTRESOURCEID-STOP","paragraph_zero_based":27063},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27064},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27065},{"literal_text_all_w_t_and_m_t":"–ScramblingId","paragraph_zero_based":27066},{"literal_text_all_w_t_and_m_t":"The IE ScramblingID is used for scrambling channels and reference signals.","paragraph_zero_based":27067},{"literal_text_all_w_t_and_m_t":"ScramblingId information element","paragraph_zero_based":27068},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27069},{"literal_text_all_w_t_and_m_t":"-- TAG-SCRAMBLINGID-START","paragraph_zero_based":27070},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27071}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["b1ce0a251a97a8b4343dc0649eacaa659d027f4f90cc16f7663c132b45bb6bbc","97104edabb7b16c9b25be836131dd0a9ab78dacaec5a954e1f332f16d2c865d1","41e852bd46cbaae5f708fad088cdceeb77f0df580b8087c9b630a49620381e4c","237cdf98282b62fc1168822e8ac6cb640b73714a04bc3b25dd369e1c68253f51","d6c97f3c4a60dccc5dd605c0467fb67e5ebccae810664a047eb65a8f6103de59","06929345ed6ee29f89d1d422cf759a26518e94848fda52dfa784b77ea7d1e23e","882eceafbb4f1f7e866c7c87dec727cb1197b8390d6debebffd1945eb1a38a0f","4bda2cae2dad425cc9100f777c9dffa9edba5d22500868529627e17a664cb9e4","b3270f36ce407b94bf92a89ef66f3a738c389d712927701f4a7f537121c9dcdb","3f7d70220941e049c383636792440b7ed5aeafaae681e530e17ef693ef230ee3","3b0984213ef9a85c2cb68f144004b9ca7ad8eb7cf129115f4428efc802a93339","a1c0ee1336594858e7b603cc3bd0f15e05d408b4fef6adcc72c1d2675113638e","603e59110443178dfff3cad89d8d581779a906ca8f30a7bf1f605ac0da1c0225","80b759cfeae915200a7267564b7c1a843df638f4968a6cb58a35c10763af0b7e","08fa136717aba69ca01028ee0dbd897070751634dc3b789e9d5d17db3c3219b2","19effbb5641c75b967771574706a7618ca17c914dc5e47325e7c603adbad958d","bb759062d7774699b26c4b93ea1a63b74a107524e421d5f5c89eda8f5479bb87","92c6fbd311a2bda6142768737f923de8c14226b3e450579d9f9a816f392ed765","449532974b31d93d8fccab7bcf67d1b8040d5e85bbdcdb9671a4a333bc216a7c","49273b209819a37a55898cea9c49b15b90817934d7f1b343290c25740ba42c71","3985444b5e1e206e5cf4046d0cd164e1cc8d753f252cea889508ef39cc5c94f8","33f7eeaaf02542ada2009d6de9dfb9b123a1ab754bb68c55956cf4103210de89","af93aa3e325bc25791240584c0aea1f388705c4da619d0a426b7f8e483566334","fcd44a76af2e5e6ab715712c90956e08d56db1832bcc0c4d17db130e17908362"],"paragraph_range_zero_based":[27048,27071],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p27048"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ScramblingId ::=                    INTEGER(0..1023)","paragraph_zero_based":27072},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27073},{"literal_text_all_w_t_and_m_t":"-- TAG-SCRAMBLINGID-STOP","paragraph_zero_based":27074},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27075},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27076},{"literal_text_all_w_t_and_m_t":"–SCS-SpecificCarrier","paragraph_zero_based":27077},{"literal_text_all_w_t_and_m_t":"The IE SCS-SpecificCarrier provides parameters determining the location and width of the actual carrier or the carrier bandwidth. It is defined specifically for a numerology (subcarrier spacing (SCS)) and in relation (frequency offset) to Point A.","paragraph_zero_based":27078},{"literal_text_all_w_t_and_m_t":"SCS-SpecificCarrier information element","paragraph_zero_based":27079},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27080},{"literal_text_all_w_t_and_m_t":"-- TAG-SCS-SPECIFICCARRIER-START","paragraph_zero_based":27081},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27082},{"literal_text_all_w_t_and_m_t":"SCS-SpecificCarrier ::=             SEQUENCE {","paragraph_zero_based":27083},{"literal_text_all_w_t_and_m_t":"    offsetToCarrier                     INTEGER (0..2199),","paragraph_zero_based":27084},{"literal_text_all_w_t_and_m_t":"    subcarrierSpacing                   SubcarrierSpacing,","paragraph_zero_based":27085},{"literal_text_all_w_t_and_m_t":"    carrierBandwidth                    INTEGER (1..maxNrofPhysicalResourceBlocks),","paragraph_zero_based":27086},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":27087},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":27088},{"literal_text_all_w_t_and_m_t":"    txDirectCurrentLocation         INTEGER (0..4095)                                       OPTIONAL            -- Need S","paragraph_zero_based":27089},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":27090},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27091},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27092},{"literal_text_all_w_t_and_m_t":"-- TAG-SCS-SPECIFICCARRIER-STOP","paragraph_zero_based":27093},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27094},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27095}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["e879d927d2d5748ebeef2c5ac28bf71af2ca1321a2d1313079da25de0ef28f25","c96e35611d05afcc4532dc31a700c17ed2129c3436a7d1700b470edfc1a76073","b32cb798ae326e4a979596332ece6909d413d1c3f754020a78393de312f790d6","0a2ca292d818bb15405fc4591988e3baee91e8e385cfeb24be4fb71902795625","5bdf3e01224a2b2fa3ea75c4c60d7257b62e97df6ac6f284f030068be87905f1","ad9a5c3494f4af9c56c31460825ca3f31d6ce728a45a6382bd2cbf7684f2105c","53936d2370d9d28319d623e4f6de90a59729edae62556eea09b480fd6c69112d","15ffaf52387f7441248c26a226ab8d9f4370afb63767e0c013c087fc8e6c476c","f5f4d141e274f2f4132fa8ccfe288d8307375b066bd999f8b46bfc146ad7c6ee","786f9f54e92b5b65d11b10eb43137b8bfde35f7f2568224d1567361451e43ac1","dacdd6caa182b89c3666f92a6a990456f68492b095bf93b618819c53d08e9822","6125221b9f40fd3a209797b857a45187223fb8fd3790f6544112af527b90d0cd","f347c81f409e602b05abd62fc762230a8af74fccb85dd2829a349d185233551c","8846946bbf8c2c607d10d1c8448f53e55a1c3497ebe9ac5d5608b50b710d7bee","207aa9d46d102c145f21b8fcd1ec21dffe1dd955d3558deb8920e567201bfe89","e4f9b9420e5a79bbb7cb9329d0d987c8c995c342d7a7a341084603fddf06b13c","233b38799446675f0decf55797484ed53ee8406dfa1399b08157e33fe1f5e8e4","0e65277c1c6ce01750022e1838b797d20567d376fab028b27b7f498b783509eb","128ddac9bfc127079fc9500131332c96584db5fbe620efc0f1ed0a498d37f177","0e803f1f833dbdc2800e93b8dfc0ce624ee8c0e87c5e5ebaf7288d9addb4f95d","ada6598ea02cad9504b26cae66ec91ec0cd53e2284936ffb549004592993405d","8c3cc158aafda3152287a5d8c25754243246ce72aa44ba54102087150383068d","d3a3453e81baae5608366037867a7418f732c73874ae70e214e706de2f275af8","497db08d806e759547b5b7108435f63b67edab9b8c40fc3150712b661c69064d"],"paragraph_range_zero_based":[27072,27095],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p27072"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SCS-SpecificCarrier field descriptions","paragraph_zero_based":27096},{"literal_text_all_w_t_and_m_t":"carrierBandwidth","paragraph_zero_based":27097},{"literal_text_all_w_t_and_m_t":"Width of this carrier in number of PRBs (using the subcarrierSpacing defined for this carrier) (see TS 38.211 [16], clause 4.4.2).","paragraph_zero_based":27098},{"literal_text_all_w_t_and_m_t":"offsetToCarrier","paragraph_zero_based":27099},{"literal_text_all_w_t_and_m_t":"Offset in frequency domain between Point A (lowest subcarrier of common RB 0) and the lowest usable subcarrier on this carrier in number of PRBs (using the subcarrierSpacing defined for this carrier). The maximum value corresponds to 275*8-1. See TS 38.211 [16], clause 4.4.2.","paragraph_zero_based":27100},{"literal_text_all_w_t_and_m_t":"txDirectCurrentLocation","paragraph_zero_based":27101},{"literal_text_all_w_t_and_m_t":"Indicates the downlink Tx Direct Current location for the carrier. A value in the range 0..3299 indicates the subcarrier index within the carrier. The values in the value range 3301..4095 are reserved and ignored by the UE. If this field is absent for downlink within ServingCellConfigCommon and ServingCellConfigCommonSIB, the UE assumes the default value of 3300 (i.e. \"Outside the carrier\"). (see TS 38.211 [16], clause 4.4.2). Network does not configure this field via ServingCellConfig or for uplink carriers.","paragraph_zero_based":27102},{"literal_text_all_w_t_and_m_t":"subcarrierSpacing","paragraph_zero_based":27103},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing of this carrier. It is used to convert the offsetToCarrier into an actual frequency.","paragraph_zero_based":27104},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":27105},{"literal_text_all_w_t_and_m_t":"FR1:    15 or 30 kHz","paragraph_zero_based":27106},{"literal_text_all_w_t_and_m_t":"FR2-1:  60 or 120 kHz","paragraph_zero_based":27107},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":27108},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27109},{"literal_text_all_w_t_and_m_t":"–SDAP-Config","paragraph_zero_based":27110},{"literal_text_all_w_t_and_m_t":"The IE SDAP-Config is used to set the configurable SDAP parameters for a data radio bearer. All configured instances of SDAP-Config with the same value of pdu-Session correspond to the same SDAP entity as specified in TS 37.324 [24].","paragraph_zero_based":27111},{"literal_text_all_w_t_and_m_t":"SDAP-Config information element","paragraph_zero_based":27112},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27113},{"literal_text_all_w_t_and_m_t":"-- TAG-SDAP-CONFIG-START","paragraph_zero_based":27114},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27115},{"literal_text_all_w_t_and_m_t":"SDAP-Config ::=                     SEQUENCE {","paragraph_zero_based":27116},{"literal_text_all_w_t_and_m_t":"    pdu-Session                         PDU-SessionID,","paragraph_zero_based":27117},{"literal_text_all_w_t_and_m_t":"    sdap-HeaderDL                       ENUMERATED {present, absent},","paragraph_zero_based":27118},{"literal_text_all_w_t_and_m_t":"    sdap-HeaderUL                       ENUMERATED {present, absent},","paragraph_zero_based":27119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["d1618af2b26fe35bf9f1eb09b6682a4253b3693bb34ecaa7de026c58c131b7f7","299993a075458074822bc07936aee856c866f874b136fc1d05b25bca12c731f6","59da520123c9eaa06150a7eec484b4d7b7759b8a167865c5dfc310863bd455d6","750e4ac7e798166a4c53aa95f0acae7f79a074278a6a133e3ea47a6723eead61","6bbc3b508cacd6d786d45c23d09422c0c974c390d67942389b8f34ca74b23401","6ad9001106e065de94a752371f61ca785418f8badb0b1f99394a798ff7d83d8c","f21b1265dea5196324cc04c7401ce0ae7d696579677abe51a600047557168c1a","c6212b14e2c08a89c936e96214ea98c00631ed7ce91c9fa35c133856c13c3847","55bad700ba5f05faf5a11d4483a1ad2e546a7edceb2eb24ed7606d61156c6fd9","e68dfa301cfa34c31c97d1bb819549a5b9203b30375c0f8762feb91dbbfe4b7b","d5410bda6327873996dd18d1c55cb5ad2acb0bdcf4671e1fd6a6cd3c2b813c3e","c42ec2b597558192359487f8d618fbe149ff8f047ed0469f447745c7a898df62","5018567c8ef377fdcb43374c298f23b4d23ca2afb1a3927818d73d68b239e643","ce951e9583724bfd52e2b765f381d4409a6c33c0e751add8ed513b664b74a42c","a7cd2d3a0311c1f50e4c2f137d9f97e52fb29e9c50587262e684f68c73e9bd86","46d9aab8f8b99b437e80e5ff276b3a245e12db97e2a9e7d8d15648ebf98fe65e","65853b2c10675a004d1b361a7c6a79b5650e8a9b7577dcdbebe655ce9625af19","1c25963c213202379fba43fbc037f677317348a56cd963153268758c4f4dbc06","a505fe04be2b197f60be235ef1444bb8d2ce08ef3b17573f86726a4ff9034b8f","8be18bd802910afe59547bb448961def8caec50cf8d1ecee8fdab10f17ada0a5","0506038f47b5e56b4e3d76d460b4fed6e05aa7ae5d1c6bbbb8311c79e59b5b2e","d32ea5f29d6b0b66250fcbe703b79ee5a6b531e783195c28420a9e7716b03e32","3965c3cd1981efaaa7c3ee87653302aa90babb0a705657f97fb6b7c0739b536a","ea8b1246b8aed64a04d8b5443a3dd8370f271c9b642b92d83b5ed7068afd4d9a"],"paragraph_range_zero_based":[27096,27119],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p27096"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    defaultDRB                          BOOLEAN,","paragraph_zero_based":27120},{"literal_text_all_w_t_and_m_t":"    mappedQoS-FlowsToAdd                SEQUENCE (SIZE (1..maxNrofQFIs)) OF QFI                                 OPTIONAL, -- Need N","paragraph_zero_based":27121},{"literal_text_all_w_t_and_m_t":"    mappedQoS-FlowsToRelease            SEQUENCE (SIZE (1..maxNrofQFIs)) OF QFI                                 OPTIONAL, -- Need N","paragraph_zero_based":27122},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":27123},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27124},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27125},{"literal_text_all_w_t_and_m_t":"QFI ::=                             INTEGER (0..maxQFI)","paragraph_zero_based":27126},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27127},{"literal_text_all_w_t_and_m_t":"PDU-SessionID ::=                   INTEGER (0..255)","paragraph_zero_based":27128},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27129},{"literal_text_all_w_t_and_m_t":"-- TAG-SDAP-CONFIG-STOP","paragraph_zero_based":27130},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27131},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27132},{"literal_text_all_w_t_and_m_t":"SDAP-Config field descriptions","paragraph_zero_based":27133},{"literal_text_all_w_t_and_m_t":"defaultDRB","paragraph_zero_based":27134},{"literal_text_all_w_t_and_m_t":"Indicates whether or not this is the default DRB for this PDU session. Among all configured instances of SDAP-Config with the same value of pdu-Session, this field shall be set to true in at most one instance of SDAP-Config and to false in all other instances.","paragraph_zero_based":27135},{"literal_text_all_w_t_and_m_t":"mappedQoS-FlowsToAdd","paragraph_zero_based":27136},{"literal_text_all_w_t_and_m_t":"Indicates the list of QFIs of UL QoS flows of the PDU session to be additionally mapped to this DRB. A QFI value can be included at most once in all configured instances of SDAP-Config with the same value of pdu-Session. For QoS flow remapping, the QFI value of the remapped QoS flow is only included in mappedQoS-FlowsToAdd in sdap-Config corresponding to the new DRB and not included in mappedQoS-FlowsToRelease in sdap-Config corresponding to the old DRB.","paragraph_zero_based":27137},{"literal_text_all_w_t_and_m_t":"mappedQoS-FlowsToRelease","paragraph_zero_based":27138},{"literal_text_all_w_t_and_m_t":"Indicates the list of QFIs of QoS flows of the PDU session to be released from existing QoS flow to DRB mapping of this DRB. ","paragraph_zero_based":27139},{"literal_text_all_w_t_and_m_t":"pdu-Session","paragraph_zero_based":27140},{"literal_text_all_w_t_and_m_t":"Identity of the PDU session whose QoS flows are mapped to the DRB.","paragraph_zero_based":27141},{"literal_text_all_w_t_and_m_t":"sdap-HeaderUL","paragraph_zero_based":27142},{"literal_text_all_w_t_and_m_t":"Indicates whether or not a SDAP header is present for UL data on this DRB. The field cannot be changed after a DRB is established. The network sets this field to present if the field defaultDRB is set to true.","paragraph_zero_based":27143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["f91332f01d928c0bfb94f462393fe8adb33fe4ac5c02fc8978b05d88f455e2dd","e04e4b4eb783345b2288a4f9e6aa920862bc7143a9104c3d879a240386d44151","90ebf8f4c820598ae78089003c7f333d522aebf89b3fe9de6ca99645faece035","103e432fb83a09ba226d711