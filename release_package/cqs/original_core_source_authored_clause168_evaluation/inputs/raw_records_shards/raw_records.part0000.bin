{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE MsgA-PUSCH-Config is used to specify the PUSCH allocation for MsgA in 2-step random access type procedure.","paragraph_zero_based":20928},{"literal_text_all_w_t_and_m_t":"MsgA-PUSCH-Config information element","paragraph_zero_based":20929},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":20930},{"literal_text_all_w_t_and_m_t":"-- TAG-MSGA-PUSCH-CONFIG-START","paragraph_zero_based":20931},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20932},{"literal_text_all_w_t_and_m_t":"MsgA-PUSCH-Config-r16 ::=                      SEQUENCE {","paragraph_zero_based":20933},{"literal_text_all_w_t_and_m_t":"    msgA-PUSCH-ResourceGroupA-r16                  MsgA-PUSCH-Resource-r16                                       OPTIONAL, -- Cond InitialBWPConfig","paragraph_zero_based":20934},{"literal_text_all_w_t_and_m_t":"    msgA-PUSCH-ResourceGroupB-r16                  MsgA-PUSCH-Resource-r16                                       OPTIONAL, -- Cond GroupBConfigured","paragraph_zero_based":20935},{"literal_text_all_w_t_and_m_t":"    msgA-TransformPrecoder-r16                    ENUMERATED {enabled, disabled}                                 OPTIONAL, -- Need R","paragraph_zero_based":20936},{"literal_text_all_w_t_and_m_t":"    msgA-DataScramblingIndex-r16                   INTEGER (0..1023)                                             OPTIONAL, -- Need S","paragraph_zero_based":20937},{"literal_text_all_w_t_and_m_t":"    msgA-DeltaPreamble-r16                         INTEGER (-1..6)                                               OPTIONAL  -- Need R","paragraph_zero_based":20938},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":20939},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20940},{"literal_text_all_w_t_and_m_t":"MsgA-PUSCH-Resource-r16 ::=                    SEQUENCE {","paragraph_zero_based":20941},{"literal_text_all_w_t_and_m_t":"    msgA-MCS-r16                                   INTEGER (0..15),","paragraph_zero_based":20942},{"literal_text_all_w_t_and_m_t":"    nrofSlotsMsgA-PUSCH-r16                        INTEGER (1..4),","paragraph_zero_based":20943},{"literal_text_all_w_t_and_m_t":"    nrofMsgA-PO-PerSlot-r16                        ENUMERATED {one, two, three, six},","paragraph_zero_based":20944},{"literal_text_all_w_t_and_m_t":"    msgA-PUSCH-TimeDomainOffset-r16                INTEGER (1..32),","paragraph_zero_based":20945},{"literal_text_all_w_t_and_m_t":"    msgA-PUSCH-TimeDomainAllocation-r16            INTEGER (1..maxNrofUL-Allocations)                            OPTIONAL, -- Need S","paragraph_zero_based":20946},{"literal_text_all_w_t_and_m_t":"    startSymbolAndLengthMsgA-PO-r16                INTEGER (0..127)                                              OPTIONAL, -- Need S","paragraph_zero_based":20947},{"literal_text_all_w_t_and_m_t":"    mappingTypeMsgA-PUSCH-r16                      ENUMERATED {typeA, typeB}                                     OPTIONAL, -- Need S","paragraph_zero_based":20948},{"literal_text_all_w_t_and_m_t":"    guardPeriodMsgA-PUSCH-r16                      INTEGER (0..3)                                                OPTIONAL, -- Need R","paragraph_zero_based":20949},{"literal_text_all_w_t_and_m_t":"    guardBandMsgA-PUSCH-r16                        INTEGER (0..1),","paragraph_zero_based":20950},{"literal_text_all_w_t_and_m_t":"    frequencyStartMsgA-PUSCH-r16                   INTEGER (0..maxNrofPhysicalResourceBlocks-1),","paragraph_zero_based":20951}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465