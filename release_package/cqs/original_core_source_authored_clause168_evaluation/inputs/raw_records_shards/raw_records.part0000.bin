{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"pdsch-TimeDomainAllocationList","paragraph_zero_based":22776},{"literal_text_all_w_t_and_m_t":"List of time-domain configurations for timing of DL assignment to DL data (see table 5.1.2.1.1-1 in TS 38.214 [19]).","paragraph_zero_based":22777},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22778},{"literal_text_all_w_t_and_m_t":"–PDSCH-ServingCellConfig","paragraph_zero_based":22779},{"literal_text_all_w_t_and_m_t":"The IE PDSCH-ServingCellConfig is used to configure UE specific PDSCH parameters that are common across the UE's BWPs of one serving cell.","paragraph_zero_based":22780},{"literal_text_all_w_t_and_m_t":"PDSCH-ServingCellConfig information element","paragraph_zero_based":22781},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":22782},{"literal_text_all_w_t_and_m_t":"-- TAG-PDSCH-SERVINGCELLCONFIG-START","paragraph_zero_based":22783},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22784},{"literal_text_all_w_t_and_m_t":"PDSCH-ServingCellConfig ::=             SEQUENCE {","paragraph_zero_based":22785},{"literal_text_all_w_t_and_m_t":"    codeBlockGroupTransmission              SetupRelease { PDSCH-CodeBlockGroupTransmission }              OPTIONAL,   -- Need M","paragraph_zero_based":22786},{"literal_text_all_w_t_and_m_t":"    xOverhead                               ENUMERATED { xOh6, xOh12, xOh18 }                              OPTIONAL,   -- Need S","paragraph_zero_based":22787},{"literal_text_all_w_t_and_m_t":"    nrofHARQ-ProcessesForPDSCH              ENUMERATED {n2, n4, n6, n10, n12, n16}                         OPTIONAL,   -- Need S","paragraph_zero_based":22788},{"literal_text_all_w_t_and_m_t":"    pucch-Cell                              ServCellIndex                                                  OPTIONAL,   -- Cond SCellAddOnly","paragraph_zero_based":22789},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":22790},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":22791},{"literal_text_all_w_t_and_m_t":"    maxMIMO-Layers                          INTEGER (1..8)                                                 OPTIONAL,   -- Need M","paragraph_zero_based":22792},{"literal_text_all_w_t_and_m_t":"    processingType2Enabled                  BOOLEAN                                                        OPTIONAL    -- Need M","paragraph_zero_based":22793},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":22794},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":22795},{"literal_text_all_w_t_and_m_t":"    pdsch-CodeBlockGroupTransmissionList-r16 SetupRelease { PDSCH-CodeBlockGroupTransmissionList-r16 }     OPTIONAL    -- Need M","paragraph_zero_based":22796},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":22797},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":22798},{"literal_text_all_w_t_and_m_t":"    downlinkHARQ-FeedbackDisabled-r17       SetupRelease { DownlinkHARQ-FeedbackDisabled-r17 }              OPTIONAL,   -- Need M","paragraph_zero_based":22799}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["eb7590fd77e6e8b7215f779c972cc1dc2cf56eb386675226fb0ac734f025207f","8cdf99b0b8405715c5ef902330093dfd331409c931a484fa2aab368a01e4b11a","9b28491e166718a91e39277a1da1402ecaf12b8d665b202eee2ec3188669e958","97a66f679f503d33cd505703cc421465aec5e3b20dfe5c5ed0ff5eaf1a5446ab","251a58e2707f30e34bd66c6e7758a04cbab0e9a4ea367e5a683a3d97820afba6","5818f0343e1d36cb8e93faa29ec8761f15b9357bd90824749