{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2376},{"literal_text_all_w_t_and_m_t":"DL-PRS-QCL-InformationReqTRPlist-r17 ::= SEQUENCE (SIZE (1..nrMaxTRPsPerFreq-r16)) OF","paragraph_zero_based":2377},{"literal_text_all_w_t_and_m_t":"DL-PRS-QCL-InformationReqPerTRP-r17","paragraph_zero_based":2378},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2379},{"literal_text_all_w_t_and_m_t":"DL-PRS-QCL-InformationReqPerTRP-r17 ::= SEQUENCE {","paragraph_zero_based":2380},{"literal_text_all_w_t_and_m_t":"dl-PRS-ID-r17INTEGER (0..255),","paragraph_zero_based":2381},{"literal_text_all_w_t_and_m_t":"nr-PhysCellID-r17NR-PhysCellID-r16OPTIONAL,","paragraph_zero_based":2382},{"literal_text_all_w_t_and_m_t":"nr-CellGlobalID-r17NCGI-r15OPTIONAL,","paragraph_zero_based":2383},{"literal_text_all_w_t_and_m_t":"nr-ARFCN-r17ARFCN-ValueNR-r15OPTIONAL,","paragraph_zero_based":2384},{"literal_text_all_w_t_and_m_t":"dl-prs-QCL-InformationReqSet-r17SEQUENCE (SIZE (1..nrMaxSetsPerTrpPerFreqLayer-r16)) OF","paragraph_zero_based":2385},{"literal_text_all_w_t_and_m_t":"DL-PRS-QCL-InfoReq-r17,","paragraph_zero_based":2386},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":2387},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2388},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2389},{"literal_text_all_w_t_and_m_t":"DL-PRS-QCL-InfoReq-r17 ::= SEQUENCE {","paragraph_zero_based":2390},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-ResourceSetID-r17NR-DL-PRS-ResourceSetID-r16,","paragraph_zero_based":2391},{"literal_text_all_w_t_and_m_t":"dl-prs-QCL-InformationReq-r17CHOICE {","paragraph_zero_based":2392},{"literal_text_all_w_t_and_m_t":"dl-prs-QCL-InfoRecPerResourceSet-r17DL-PRS-QCL-Info-r16,","paragraph_zero_based":2393},{"literal_text_all_w_t_and_m_t":"dl-prs-QCL-Info-requested-r17NULL","paragraph_zero_based":2394},{"literal_text_all_w_t_and_m_t":"},","paragraph_zero_based":2395},{"literal_text_all_w_t_and_m_t":"...,","paragraph_zero_based":2396},{"literal_text_all_w_t_and_m_t":"[[","paragraph_zero_based":2397},{"literal_text_all_w_t_and_m_t":"dl-prs-QCL-InfoRecPerResource-r17SEQUENCE  (SIZE (1..nrMaxResourcesPerSet-r16)) OF","paragraph_zero_based":2398},{"literal_text_all_w_t_and_m_t":"DL-PRS-QCL-Info-r16OPTIONAL","paragraph_zero_based":2399}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["bbb183ca6d6960a8696e696a7f09ac37faaf11a43f4894960d59536c2156b7a3","9b2480b29660abf80b4f227b9fe353ee2a215d9a770dff35ae888437e3fd1b1f","7a358680984939af4f11bb120928e3fb6f017196dbeb8845b03aa01968b961be","54fe1d3a41a98c13f4ce24434275ddf48bd18bf56298b7f32eda42d7b3c01403","51795d94087cc9e89ab1ff74f253d35c822ff575a2a0bef98c3bdbe96581b803","a61fa2890b0b58a71e4c2b96499b81b6ce7b7dae05531f1e80c0da5f24aeb37a","4fdc5a9624886b982d41804c924dc67c39eedff38f4c49bce697da905e1e9b11","5f2912fadac1f34d1ca3b79c23034844353f610cd3f627ba8dc96dcdd4459a0f","68f8af34d0bcdf18febf82acce8fcd6eeef2d7928991fadb5b6c7897c9cf5fc5","74f845110e1587f3be60179acaae9b0db9e58443ec2dc93903b2ce5d03fe6d1c","9f041a8cf9adfde8b66dfb76e4404e46cad9a6542c9254aa2b3ba999de2db7e2","5764c4ef57980f8c22d439907867214c7315d23da6ffa33e96e4672ded5b464d","36ab854d82a5c5076212e2e6985eae61b37f96b6e06e8d4e01ca9474210e755d","e309e004db1d9292a633e18ed6b949719812939dcd50d9c9f0eb77886c222955","3c2ed1a0298b20b4647e24cdbfcf34fd8533d68b2fc9dd46d9b3dcfb962b9913","d3a8f0f31d16f5dafe98124b6fca4c4c1876b09b57d4cd42f81eee8ed69b711a","a026370e9b092f40b229ee0f287554dcbb08efcaf203199ca570ed1ac49c54d3","e38c2a3cabf9567dc82a7957899d3e9fa8b8c0914d1883ca0e2f874c751fa448","7e993b932580a2874e47f1956b2e00297953e4530957463e56b24f0a38838dfb","3c1eb0d858664a060891055b31ecd6c6a644ef6f7c9e3f47781dd8f96b544ec9","b44c3f06a1238e0e56054e62f6bd2011d9896bc2112a62d5a468326a5089127d","6ed5e71e78a417c2c71d8867a07621decd325e6e7497930d6af435a74388a05a","05c151fb96e3f23fa6206e3993d09a7bf04a52317fba2caf03efc1de50b02def","00c6331d2bf2b6f40b73695a1e5bd61453a6e422454461a6835c8baabd990156"],"paragraph_range_zero_based":[2376,2399],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx:p2376"}
{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"]]","paragraph_zero_based":2400},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2401},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2402},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":2403},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2404},{"literal_text_all_w_t_and_m_t":"NR-On-Demand-DL-PRS-Information field descriptions","paragraph_zero_based":2405},{"literal_text_all_w_t_and_m_t":"dl-prs-FrequencyRangeReq","paragraph_zero_based":2406},{"literal_text_all_w_t_and_m_t":"This field specifies the frequency range for which the on-demand DL-PRS is requested.","paragraph_zero_based":2407},{"literal_text_all_w_t_and_m_t":"dl-prs-ResourceSetPeriodicityReq","paragraph_zero_based":2408},{"literal_text_all_w_t_and_m_t":"This field specifies the requested periodicity of the DL-PRS Resource Set in slots. The periodicity depends on the subcarrier spacing (SCS) and takes values 2μ4, 5, 8, 10, 16, 20, 32, 40, 64, 80, 160, 320, 640, 1280, 2560, 5120, 10240","paragraph_zero_based":2409},{"literal_text_all_w_t_and_m_t":"slots, where μ=0, 1, 2, 3 for SCS of 15, 30, 60 and 120 kHz respectively. μ refers to the target devices current primary cell.","paragraph_zero_based":2410},{"literal_text_all_w_t_and_m_t":"dl-prs-ResourceBandwidthReq","paragraph_zero_based":2411},{"literal_text_all_w_t_and_m_t":"This field specifies the requested number of PRBs allocated for the DL-PRS Resource (allocated DL-PRS bandwidth) in multiples of 4 PRBs. Integer value 1 corresponds to 24 PRBs, value 2 corresponds to 28 PRBs, value 3 corresponds to 32 PRBs and so on.","paragraph_zero_based":2412},{"literal_text_all_w_t_and_m_t":"dl-prs-ResourceRepetitionFactorReq","paragraph_zero_based":2413},{"literal_text_all_w_t_and_m_t":"This field specifies the requested DL-PRS Resource repetition. Enumerated values n2, n4, n6, n8, n16, n32 correspond to 2, 4, 6, 8, 16, 32 resource repetitions, respectively.","paragraph_zero_based":2414},{"literal_text_all_w_t_and_m_t":"dl-prs-NumSymbolsReq","paragraph_zero_based":2415},{"literal_text_all_w_t_and_m_t":"This field specifies the requested number of symbols per DL-PRS Resource within a slot.","paragraph_zero_based":2416},{"literal_text_all_w_t_and_m_t":"dl-prs-CombSizeN-Req","paragraph_zero_based":2417},{"literal_text_all_w_t_and_m_t":"This field specifies the requested Resource Element spacing in each symbol of the DL-PRS Resource.","paragraph_zero_based":2418},{"literal_text_all_w_t_and_m_t":"dl-prs-QCL-InformationReqTRPlist","paragraph_zero_based":2419},{"literal_text_all_w_t_and_m_t":"This field specifies the recommended or requested QCL indication with other DL reference signals.","paragraph_zero_based":2420},{"literal_text_all_w_t_and_m_t":"-dl-PRS-ID indicates the DL-PRS ID of the TRP for which the QCL information is recommended.","paragraph_zero_based":2421},{"literal_text_all_w_t_and_m_t":"-nr-PhysCellID indicates the physical Cell-ID of the TRP for which the QCL information is recommended, as defined in TS 38.331 [35].","paragraph_zero_based":2422},{"literal_text_all_w_t_and_m_t":"-nr-CellGlobalID indicates the NCGI, the globally unique identity of a cell in NR, of the TRP for which the QCL information is recommended, as defined in TS 38.331 [35].","paragraph_zero_based":2423}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["6995f48f6f39c71b8ed7ee99db00fd4ad22fcfab1d1b437e3fe94f6ae4980824","b7feeb3a80aed16e9e206c1323472ba4954317fff34752971ffe3f935a7c96b6","d016cc17eecaae0db3fbc88bc5104df38382a035fcc5beb69e43042e6931f41e","71efcc161d39f4a2f717ac2da3153aba4dc7015633e33ed3e63d899ee7788f38","84f28a239ece3981ae857a602677869a4b0d4d60cc615664dc559fb64050bccc","85f54a5069a84ca71695d37e9eb4c745fc6bf793e9fbc412b1f6eb3740f32b76","5ec4599c157e5607c65868bb2c09f284518bf47e94517760416b30f1df890877","b2b0e136a98c5070d5c26fdf611a920161e30a57f017e851aab6374b76fd4c4b","1e95074b1389ab87560ebd2427b34b5f607ae49f5772522e5a6d2735decde794","ca23697298c37b36c592eda7f838ee81ecaa7ad0935c82baf587782ae95b3912","605ccb417e39999f1de1ed0ac0859158dbd22afc4e7f51e1704721de7d1ebb55","47019f781c16b5945faff27cfeb4a51ad6cbfc3660afe2958a3b5b0b901b2a2e","e60102759c907e9bf2a9003491518d00d535bc62a1a0d0d4ae51dc917b922f9b","e7c1a3755cd95b6a8b46b0049760841cec9fccaf0defda94827164d917919a17","b8bf943974e4b34dbc29abd5018bc36ed57cb268bca5d677c832bdad7ebf5ead","7a9806668b5f3b01c756bfebd5be1188c6c4ec441490244c947a406528d7db83","fc0562288bd07ba368117d08977933d0cd2f9f382c19ee161948e868eca2b13d","b10203397b942c4e3f8e03824ff34585281997d77cda8fc8646fd487e563071f","132e1e3c13b725b51b954108c145d2ee4597e128d54082e4f8192280b4812bb6","fac4dd435892e8b7321b06796bff04470a14d2884154e7487d860cb8b807d503","4929b981c5c7029f8bc4f24fbf4dc3dd01a3cfd369327b3487e025836f6fd931","0ee6f1362be66abd9d534019f58cf1ed998d84aaa1daae588e7615ebeac5056b","5ddddb2678f8bbe7bd3a0f88b4e1fe19e324ec207e0672810dd045e4cdd68233","380ad26804ed90ba88db1de1b69c07963c1ced73d21312261032765d617cfc2d"],"paragraph_range_zero_based":[2400,2423],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx:p2400"}
{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-nr-ARFCN indicates the NR-ARFCN of the TRP's CD-SSB (as defined in TS 38.300 [47]) corresponding to nr-PhysCellID.","paragraph_zero_based":2424},{"literal_text_all_w_t_and_m_t":"-dl-prs-QCL-InformationReqSet indicates the recommended QCL information per DL-PRS Resource Set.","paragraph_zero_based":2425},{"literal_text_all_w_t_and_m_t":"-nr-DL-PRS-ResourceSetID indicates the DL-PRS Resource Set ID for which the QCL information is recommended.","paragraph_zero_based":2426},{"literal_text_all_w_t_and_m_t":"-dl-prs-QCL-InformationReq","paragraph_zero_based":2427},{"literal_text_all_w_t_and_m_t":"- dl-prs-QCL-InfoRecPerResourceSet indicates a single recommended QCL source for the DL-PRS Resource Set.","paragraph_zero_based":2428},{"literal_text_all_w_t_and_m_t":"- dl-prs-QCL-Info-requested indicates that the UE requests to provide the QCL information in the assistance data.","paragraph_zero_based":2429},{"literal_text_all_w_t_and_m_t":"-dl-prs-QCL-InfoRecPerResource indicates a list of recommended QCL sources for the DL-PRS Resource Set. If this field is present, the dl-prs-QCL-InformationReg shall be ignored by the receiver.","paragraph_zero_based":2430},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2431},{"literal_text_all_w_t_and_m_t":"–NR-On-Demand-DL-PRS-Request","paragraph_zero_based":2432},{"literal_text_all_w_t_and_m_t":"The IE NR-On-Demand-DL-PRS-Request is used by the target device to request on-demand DL-PRS from a location server.","paragraph_zero_based":2433},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":2434},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2435},{"literal_text_all_w_t_and_m_t":"NR-On-Demand-DL-PRS-Request-r17 ::= SEQUENCE {","paragraph_zero_based":2436},{"literal_text_all_w_t_and_m_t":"dl-prs-StartTime-and-Duration-r17DL-PRS-StartTime-and-Duration-r17OPTIONAL,","paragraph_zero_based":2437},{"literal_text_all_w_t_and_m_t":"nr-on-demand-DL-PRS-Information-r17 NR-On-Demand-DL-PRS-Information-r17OPTIONAL,","paragraph_zero_based":2438},{"literal_text_all_w_t_and_m_t":"dl-prs-configuration-id-PrefList-r17SEQUENCE (SIZE (1..maxOD-DL-PRS-Configs-r17)) OF DL-PRS-Configuration-ID-r17OPTIONAL,","paragraph_zero_based":2439},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":2440},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2441},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2442},{"literal_text_all_w_t_and_m_t":"DL-PRS-StartTime-and-Duration-r17 ::= SEQUENCE {","paragraph_zero_based":2443},{"literal_text_all_w_t_and_m_t":"dl-prs-start-time-r17INTEGER (1..1024)OPTIONAL,","paragraph_zero_based":2444},{"literal_text_all_w_t_and_m_t":"dl-prs-duration-r17SEQUENCE {","paragraph_zero_based":2445},{"literal_text_all_w_t_and_m_t":"seconds-r17INTEGER (0..59)OPTIONAL,","paragraph_zero_based":2446},{"literal_text_all_w_t_and_m_t":"minutes-r17INTEGER (0..59)OPTIONAL,","paragraph_zero_based":2447}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["99f560cc02ee81f695a8f52e215bd1a82ebdb35d2b50b5f40ccbf5afb7f2c59a","88d7b1e189c1fd36b129af517c797328bef9e53d8615af9c707cd4e9a3bc7540","0987562798aeec1f7d352ff84473692044de4d427e227bdc752817d0e849aa61","1531f94cb99b5acd727ea2697b7cde2dbae277c6675280674f0f2877fcbd3540","c6769482a45404db71b88147cd71aaed42e70b15472517dd065473e39e3ea0c7","f09b49df46ece45ded64be114c217792a0cfc3f668dec1993fd3fbb661693357","a3b2da66e2d447016acf8f2773420e089208d8541badec2273d02feaa438ccc5","aafc1bf5ec8687d0e1d468f389c421a7ac1af46b5643d233d39d6bc66733baa5","0a5211c1656cd76d709572acc9f5190f2f8b30d4c9a784554875e013d026237c","1efb6025a371b165269c90f96b32b70255df0296dc324cd11e7bcb23a085a5f5","c4de1238736f3f978f6e48d854ba22b7d31de70ca6efa822f755004ceb7276f1","fb67628a8bfad579525e4f7a0562d989a6fd7acac19819aa39f8a37737ae6c30","3cfdb44541467a3f29d7a91112a751e769604c6ca17be5eeaa6757585b71c022","6ba8ab4a9a3aa5a82c29e184063b6634fe5371f01b146ba0a60048c1a8d2ec4e","81c3a7cbc412d522c3ca95e3e7d3fee34bea0d306c8c2ccb29f036907e0f6ab4","10842268ab4859a1d83e3057283ab72c76e5af20588f337ce03caf1262d2736e","c54590dad1a3ad770febf5e87a790fafbf608e6026c625a0430c80ab9462c6e6","9a3108f9de374bcb27b44efb4908a12174e0fb6691a3cbbd0101fd12776d976e","72c96cf4e3561b24fb7098ced5362f0d8e4669e063a9b4ace69cad5d6ca435b0","f207870e4f72e0e7e8d9ceef8fc64cec028fe0c49c4d9282c22f0178e0854220","1c7e8e6daee55ec2bc781f9e1f770733f9d8b006cb3a55772aea7d10d5aa5801","58c9870d761aa1436c3ab531b2180b6c377842eaff4ead0e8392a0f7da5aac31","61dbaf7988cdaf82ebfa0321d180f9879e0fc0d71575321743adc184526b037b","ae69af9861b0a0320aa9d63f00c9da235d0192df0af8f5cfa8c9514caa1708b5"],"paragraph_range_zero_based":[2424,2447],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx:p2424"}
{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"hours-r17INTEGER (0..23)OPTIONAL,","paragraph_zero_based":2448},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":2449},{"literal_text_all_w_t_and_m_t":"}OPTIONAL,","paragraph_zero_based":2450},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":2451},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2452},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2453},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":2454},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2455},{"literal_text_all_w_t_and_m_t":"NR-On-Demand-DL-PRS-Request field descriptions","paragraph_zero_based":2456},{"literal_text_all_w_t_and_m_t":"dl-prs-StartTime-and-Duration","paragraph_zero_based":2457},{"literal_text_all_w_t_and_m_t":"This field specifies the requested start time and duration for the on-demand DL-PRS and comprises the following subfields:","paragraph_zero_based":2458},{"literal_text_all_w_t_and_m_t":"-dl-prs-start-time specifies the desired start time for the requested DL-PRS. It indicates the time in seconds from the time the IE NR-On-Demand-DL-PRS-Request was received.","paragraph_zero_based":2459},{"literal_text_all_w_t_and_m_t":"-dl-prs-duration specifies the desired duration of the requested DL-PRS. The desired duration is the sum of the seconds, minutes, hours fields. If this field is included, at least one of the seconds, minutes, hours fields shall be present.","paragraph_zero_based":2460},{"literal_text_all_w_t_and_m_t":"nr-on-demand-DL-PRS-Information","paragraph_zero_based":2461},{"literal_text_all_w_t_and_m_t":"This field specifies the on-demand DL-PRS configuration information requested by the target device.","paragraph_zero_based":2462},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2463},{"literal_text_all_w_t_and_m_t":"NOTE:If the network provided predefined on-demand DL-PRS configurations (NR-On-Demand-DL-PRS-Configurations), the target device can only request explicit parameters (nr-on-demand-DL-PRS-Information) within the scope of those configurations.","paragraph_zero_based":2464},{"literal_text_all_w_t_and_m_t":"dl-prs-configuration-id-PrefList","paragraph_zero_based":2465},{"literal_text_all_w_t_and_m_t":"This field specifies the on-demand DL-PRS configuration associated with DL-PRS-Configuration-ID in IE NR-On-Demand-DL-PRS-Configurations the target device wishes to obtain in the order of preference. The first DL-PRS-Configuration-ID in the list is the most preferred configuration, the second DL-PRS-Configuration-ID the second most preferred, etc.","paragraph_zero_based":2466},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2467},{"literal_text_all_w_t_and_m_t":"–NR-On-Demand-DL-PRS-Configurations-Selected-IndexList","paragraph_zero_based":2468},{"literal_text_all_w_t_and_m_t":"The IE NR-On-Demand-DL-PRS-Configurations-Selected-IndexList is used by the location server to provide the selected available on-demand DL-PRS configurations to the target device.","paragraph_zero_based":2469},{"literal_text_all_w_t_and_m_t":"In the case of available on-demand DL-PRS configurations for multiple NR positioning methods are provided, the NR-On-Demand-DL-PRS-Configurations shall be present in only one of NR-Multi-RTT-ProvideAssistanceData, NR-DL-AoD-ProvideAssistanceData, or NR-DL-TDOA-ProvideAssistanceData.","paragraph_zero_based":2470},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":2471}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree