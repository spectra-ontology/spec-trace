{"fields":{"filename":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Note, if this field is absent but the nr-SelectedDL-PRS-IndexList field is present, the nr-DL-PRS-AssistanceData may be provided in IE NR-Multi-RTT-ProvideAssistanceData or NR-DL-TDOA-ProvideAssistanceData.","paragraph_zero_based":1800},{"literal_text_all_w_t_and_m_t":"nr-SelectedDL-PRS-IndexList","paragraph_zero_based":1801},{"literal_text_all_w_t_and_m_t":"This field specifies the DL-PRS Resources which are applicable for this NR-DL-AoD-ProvideAssistanceData message.","paragraph_zero_based":1802},{"literal_text_all_w_t_and_m_t":"nr-PositionCalculationAssistance","paragraph_zero_based":1803},{"literal_text_all_w_t_and_m_t":"This field provides position calculation assistance data for UE-based mode.","paragraph_zero_based":1804},{"literal_text_all_w_t_and_m_t":"nr-DL-AoD-Error","paragraph_zero_based":1805},{"literal_text_all_w_t_and_m_t":"This field provides DL-AoD error reasons.","paragraph_zero_based":1806},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-BeamInfo","paragraph_zero_based":1807},{"literal_text_all_w_t_and_m_t":"This field provides spatial direction information of the DL-PRS Resources included in nr-DL-PRS-AssistanceData or indicated by nr-SelectedDL-PRS-IndexList.","paragraph_zero_based":1808},{"literal_text_all_w_t_and_m_t":"nr-On-Demand-DL-PRS-Configurations","paragraph_zero_based":1809},{"literal_text_all_w_t_and_m_t":"This field provides a set of available DL-PRS configurations which can be requested by the target device on-demand.","paragraph_zero_based":1810},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1811},{"literal_text_all_w_t_and_m_t":"NOTE 1:Void.","paragraph_zero_based":1812},{"literal_text_all_w_t_and_m_t":"NOTE 2:If this field is absent but the nr-On-Demand-DL-PRS-Configurations-Selected-IndexList is present, the nr-On-Demand-DL-PRS-Configurations may be provided in IE NR-Multi-RTT-ProvideAssistanceData or NR-DL-TDOA-ProvideAssistanceData.","paragraph_zero_based":1813},{"literal_text_all_w_t_and_m_t":"nr-On-Demand-DL-PRS-Configurations-Selected-IndexList","paragraph_zero_based":1814},{"literal_text_all_w_t_and_m_t":"This field specifies the selected available on-demand DL-PRS configurations which are applicable for this NR-DL-AoD-ProvideAssistanceData message.","paragraph_zero_based":1815},{"literal_text_all_w_t_and_m_t":"assistanceDataValidityArea","paragraph_zero_based":1816},{"literal_text_all_w_t_and_m_t":"This field specifies the network area for which this NR-DL-AoD-ProvideAssistanceData is valid.","paragraph_zero_based":1817},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1818},{"literal_text_all_w_t_and_m_t":"[…]","paragraph_zero_based":1819},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1820},{"literal_text_all_w_t_and_m_t":"6.5.12NR Multi-RTT Positioning","paragraph_zero_based":1821},{"literal_text_all_w_t_and_m_t":"This clause defines the information elements for NR Multi-RTT positioning (TS 38.305 [40]).","paragraph_zero_based":1822},{"literal_text_all_w_t_and_m_t":"6.5.12.1NR Multi-RTT Assistance Data","paragraph_zero_based":1823}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["e3f347ee3e03d01391ee3a5ac8eed02f67a85a3b58783f40bc83bb77b2cf109a","0ba66c71007dadd379cb67cbfecf48e767eff3e5ef22d017b8013cc32ac672ad","2e0737a3e73a1f10b9cbde61312a9106db907b0eb0f407523118f5c4f7d1527a","2fd18608afd5e3dd2234326caa7864c33a408890ea00f4426be362beb15ed2d8","bbf8d476f5f4e2c658eeba01734e529c0da59c95692beffdb87c5056ddb38619","072cc8cbebfa51a8d3bdebaaab996b1473288ab06a42bdb