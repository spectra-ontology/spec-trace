{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"T331","paragraph_zero_based":41304},{"literal_text_all_w_t_and_m_t":"Upon receiving RRCRelease message with measIdleDuration","paragraph_zero_based":41305},{"literal_text_all_w_t_and_m_t":"Upon receiving RRCSetup, RRCResume, RRCRelease with idle/inactive measurement configuration, upon cell selection/reselection to a cell that does not belong to the validityArea (if configured), or upon cell re-selection to another RAT.","paragraph_zero_based":41306},{"literal_text_all_w_t_and_m_t":"Perform the actions as specified in 5.7.8.3.","paragraph_zero_based":41307},{"literal_text_all_w_t_and_m_t":"T342","paragraph_zero_based":41308},{"literal_text_all_w_t_and_m_t":"Upon transmitting UEAssistanceInformation message with DelayBudgetReport.","paragraph_zero_based":41309},{"literal_text_all_w_t_and_m_t":"Upon releasing delayBudgetReportingConfig during the connection re-establishment/resume procedures, and upon receiving delayBudgetReportingConfig set to release.","paragraph_zero_based":41310},{"literal_text_all_w_t_and_m_t":"No action.","paragraph_zero_based":41311},{"literal_text_all_w_t_and_m_t":"T345","paragraph_zero_based":41312},{"literal_text_all_w_t_and_m_t":"Upon transmitting UEAssistanceInformation message with overheatingAssistance","paragraph_zero_based":41313},{"literal_text_all_w_t_and_m_t":"Upon releasing overheatingAssistanceConfig during the connection re-establishment procedure, upon initiating the connection resumption procedure, and upon receiving overheatingAssistanceConfig set to release.","paragraph_zero_based":41314},{"literal_text_all_w_t_and_m_t":"No action.","paragraph_zero_based":41315},{"literal_text_all_w_t_and_m_t":"T346a (The UE maintains one instance of this timer per cell group)","paragraph_zero_based":41316},{"literal_text_all_w_t_and_m_t":"Upon transmitting UEAssistanceInformation message with drx-Preference.","paragraph_zero_based":41317},{"literal_text_all_w_t_and_m_t":"Upon releasing drx-PreferenceConfig during the connection re-establishment/resume procedures, upon receiving drx-PreferenceConfig set to release, or upon performing MR-DC release.","paragraph_zero_based":41318},{"literal_text_all_w_t_and_m_t":"No action.","paragraph_zero_based":41319},{"literal_text_all_w_t_and_m_t":"T346b (The UE maintains one instance of this timer per cell group)","paragraph_zero_based":41320},{"literal_text_all_w_t_and_m_t":"Upon transmitting UEAssistanceInformation message with maxBW-Preference.","paragraph_zero_based":41321},{"literal_text_all_w_t_and_m_t":"Upon releasing maxBW-PreferenceConfig during the connection re-establishment/resume procedures, upon receiving maxBW-PreferenceConfig set to release, or upon performing MR-DC release.","paragraph_zero_based":41322},{"literal_text_all_w_t_and_m_t":"No action.","paragraph_zero_based":41323},{"literal_text_all_w_t_and_m_t":"T346c (The UE maintains one instance of this timer per cell group)","paragraph_zero_based":41324},{"literal_text_all_w_t_and_m_t":"Upon transmitting UEAssistanceInformation message with maxCC-Preference.","paragraph_zero_based":41325},{"literal_text_all_w_t_and_m_t":"Upon releasing maxCC-PreferenceConfig during the connection re-establishment/resume procedures, upon receiving maxCC-PreferenceConfig set to release, or upon performing MR-DC release.","paragraph_zero_based":41326},{"literal_text_all_w_t_and_m_t":"No action.","paragraph_zero_based":41327}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["f877fd0a37189f5df2bae74b984f3483c7ecd6c