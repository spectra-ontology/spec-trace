{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25104},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":25105},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":25106},{"literal_text_all_w_t_and_m_t":"Mandatory","paragraph_zero_based":25107},{"literal_text_all_w_t_and_m_t":"The field is mandatory present.","paragraph_zero_based":25108},{"literal_text_all_w_t_and_m_t":"Occasions","paragraph_zero_based":25109},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need S, if the field occasions is present, otherwise it is absent.","paragraph_zero_based":25110},{"literal_text_all_w_t_and_m_t":"2StepCFRA","paragraph_zero_based":25111},{"literal_text_all_w_t_and_m_t":"The field is optionally present for the case of 2-step RA type contention free random access, Need S, otherwise it is absent.","paragraph_zero_based":25112},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25113},{"literal_text_all_w_t_and_m_t":"–RACH-ConfigGeneric","paragraph_zero_based":25114},{"literal_text_all_w_t_and_m_t":"The IE RACH-ConfigGeneric is used to specify the random-access parameters both for regular random access as well as for beam failure recovery.","paragraph_zero_based":25115},{"literal_text_all_w_t_and_m_t":"RACH-ConfigGeneric information element","paragraph_zero_based":25116},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25117},{"literal_text_all_w_t_and_m_t":"-- TAG-RACH-CONFIGGENERIC-START","paragraph_zero_based":25118},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25119},{"literal_text_all_w_t_and_m_t":"RACH-ConfigGeneric ::=              SEQUENCE {","paragraph_zero_based":25120},{"literal_text_all_w_t_and_m_t":"    prach-ConfigurationIndex            INTEGER (0..255),","paragraph_zero_based":25121},{"literal_text_all_w_t_and_m_t":"    msg1-FDM                            ENUMERATED {one, two, four, eight},","paragraph_zero_based":25122},{"literal_text_all_w_t_and_m_t":"    msg1-FrequencyStart                 INTEGER (0..maxNrofPhysicalResourceBlocks-1),","paragraph_zero_based":25123},{"literal_text_all_w_t_and_m_t":"    zeroCorrelationZoneConfig           INTEGER(0..15),","paragraph_zero_based":25124},{"literal_text_all_w_t_and_m_t":"    preambleReceivedTargetPower         INTEGER (-202..-60),","paragraph_zero_based":25125},{"literal_text_all_w_t_and_m_t":"    preambleTransMax                    ENUMERATED {n3, n4, n5, n6, n7, n8, n10, n20, n50, n100, n200},","paragraph_zero_based":25126},{"literal_text_all_w_t_and_m_t":"    powerRampingStep                    ENUMERATED {dB0, dB2, dB4, dB6},","paragraph_zero_based":25127}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["611c02a57c2188b86a37fd9cbca9ae6dbca0a743c5d93b0b33a145831deae2cc","6acab494e7b61ae660eae4531ce5fbb7f8c5389a5a2dc9147565dd77a16607ea","060698e2758b86474f0a9335e7cf0525ac50fe6b98c555f1a15752b74928d933","5dbf089ae4635d5771f1efd8b0eafc71e2ce5facabb91e06da2c9e4a98a02d45","1fcd259da33a80adb4b220b88253cec4bd20873f0410be67e48a1e02322afdeb","fc6b661cbd90d780366df7aa266b764f519619688cbbd76b632e0b4bcdd8fefd","cc9af346f1a2e3273a41e444c37379fec1008684bbec95251d02f15e7f913f2c","10263d15e7c56773723df61cb2774aaff6f0ddf59957f03a4b191cdd51fc8b48","ed7367b0e43993fba6fd9b594ce754a55c58c248b3da99b7c6b385856ef21a84","6f67ecffec86834b84447fb4b5b2fb86ef556237b5f261b80d611aa17d5b5898","98eccc0e39c230e10c748684d6c2c921dc0f017ec68f96054c62338b451f9efc","1367fe0da39f8b6fb737e406bdef50ac99b2ed013498aa7f4378cea83e407964","a03646c7904f9a24ed1625f894dccd694221b9c7c82ea14dd038478ade03ba57","119a35d5231d82b066a9ed63842601ba6b506d5499a9725c61f5e73fc246df7b","a336936ab8765f9fb57112c909ff464f3217a582688658c92f44fd9291c468fb","c23457b83c1b8b9a83d56b757e8fa0cf56ba28418ac243eba9264b8a9f61661f","0204b60e5fed0c1749a73a09254444467a08a8fa242c6e9cf837206f44a1c4b7","b0b0f5ccdddb6197a02e1d9585fbf1d1b8d442f04ce3b05bf664746410990fd5","32eb48c604b76575c8a240433c3f0fee727ebc85a770384f7a5ca3e1597ea648","e3865726ff18e899424226cd9f8d0b2cedb83df542626d1c390165c5eccca48b","4bd2127dfa48fd33ed6b257b20719252328f7a4416610316d0ae9316a56719d6","d34ff2f230f0b925a31e7ede68d7712e160224759358d58e876a6f37613f043a","10dd7d9fccef204343843436d8ee2bb26f7f90371c38b4d9518222efcee8927f","5bd60e1f27f8d41179e7beb2af68717248ef1c2a40f11df95c78fdc92536876c"],"paragraph_range_zero_based":[25104,25127],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p25104"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ra-ResponseWindow                   ENUMERATED {sl1, sl2, sl4, sl8, sl10, sl20, sl40, sl80},","paragraph_zero_based":25128},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":25129},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":25130},{"literal_text_all_w_t_and_m_t":"    prach-ConfigurationPeriodScaling-IAB-r16    ENUMERATED {scf1,scf2,scf4,scf8,scf16,scf32,scf64}              OPTIONAL,   -- Need R","paragraph_zero_based":25131},{"literal_text_all_w_t_and_m_t":"    prach-ConfigurationFrameOffset-IAB-r16      INTEGER (0..63)                                                 OPTIONAL,   -- Need R","paragraph_zero_based":25132},{"literal_text_all_w_t_and_m_t":"    prach-ConfigurationSOffset-IAB-r16          INTEGER (0..39)                                                 OPTIONAL,   -- Need R","paragraph_zero_based":25133},{"literal_text_all_w_t_and_m_t":"    ra-ResponseWindow-v1610                     ENUMERATED { sl60, sl160}                                       OPTIONAL,   -- Need R","paragraph_zero_based":25134},{"literal_text_all_w_t_and_m_t":"    prach-ConfigurationIndex-v1610              INTEGER (256..262)                                              OPTIONAL    -- Need R","paragraph_zero_based":25135},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":25136},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":25137},{"literal_text_all_w_t_and_m_t":"    ra-ResponseWindow-v1700                     ENUMERATED {sl240, sl320, sl640, sl960, sl1280, sl1920, sl2560} OPTIONAL    -- Need R","paragraph_zero_based":25138},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":25139},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25140},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25141},{"literal_text_all_w_t_and_m_t":"-- TAG-RACH-CONFIGGENERIC-STOP","paragraph_zero_based":25142},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":25143},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25144},{"literal_text_all_w_t_and_m_t":"RACH-ConfigGeneric field descriptions","paragraph_zero_based":25145},{"literal_text_all_w_t_and_m_t":"msg1-FDM","paragraph_zero_based":25146},{"literal_text_all_w_t_and_m_t":"The number of PRACH transmission occasions FDMed in one time instance. (see TS 38.211 [16], clause 6.3.3.2).","paragraph_zero_based":25147},{"literal_text_all_w_t_and_m_t":"msg1-FrequencyStart","paragraph_zero_based":25148},{"literal_text_all_w_t_and_m_t":"Offset of lowest PRACH transmission occasion in frequency domain with respective to PRB 0. The value is configured so that the corresponding RACH resource is entirely within the bandwidth of the UL BWP. (see TS 38.211 [16], clause 6.3.3.2).","paragraph_zero_based":25149},{"literal_text_all_w_t_and_m_t":"powerRampingStep","paragraph_zero_based":25150},{"literal_text_all_w_t_and_m_t":"Power ramping steps for PRACH (see TS 38.321 [3],5.1.3).","paragraph_zero_based":25151}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["109b3c44655c166cf63f41a04d95f9f0c82d0302936fcf5d3d2e29f52e1f3632","6b05fcf22d7d472f9e22b163f1a250124c36bf983bec4f96c8be4341fabf1a38","9a899d51b655df980a783eca751826edba988f9e3c1df03e9f47f107e945d761","3230b273f8f0e61e6ee52d059601ccbb98f13f63c37dbd1b41cd768020216bc1","2b37be13b8750f66a4430ce7558f624b460cdbe70cf8b6d1c8447e2f6f8567a7","20fe3f993b0d2b6b912ce0163f185b852917c466923c207403e60fe5750db59e","c4a41fd17629ce7b5de110ba6b58c1b9d23522903d8f87f8c3b805ee85fcd6aa","c41d3aef2f4272ef65c8f436ba224adf9307763079ec9b973098dc8478107758","1f6bff79fa63f560bb0aa172c9de60085ca061372714a482f0f36b4ac8e089db","f264b6121c81572bb26f6ff95d93d0f7fb937932c8e9b00bf34806dedec988a6","aa02052f0e19b2cead9dccccb622243b8ca7c520a9b98de93e905a3f1985290f","af15440b8bfa13f8a990d2ce3c0fb06c67d841af9613516702f3ff6618ceda5e","92f33c6e6c8bee0a2f568806871fd9593232ed3b335449d7437deb602641f10c","3c3ec7c2d6a8bc8a7da10592f674d2915bfe697c9936f5047e59d72e1c4a8678","bf73afef5c71d9a3f9fbfc49c9d898ad0ead346cc0298e52e02ac6a534c5265f","9b4de3cf979f057ed266bf88fd8dc0f0828153d870796a207a4695ba6dac1785","e889725996d7d921b66fb743940a4a8774bd247a760367813ee512e733068da3","01c1199755fb7b425827698019c903145644ba4fd0244638a1c7628471105ae1","a61cbad88ded36ba6a6f6b7960b86e73de3e0d13332a40490755ff474a393224","060e029444797d1c0ccac1618ae5e7b0c2e7efd8452ac4956abe46154e352235","63277d42061b71c0d01c1ea81b6647693a71ab3d5aa2e691dd1ab87e8e09dc7a","d6dfa25b518e1d4ac8c8f4f6517af64fe03c21a41f4073ca0bcfbc6d8f69ee98","3328d7da2f508177b616b3e26244bbb5c2a86ebffb03b13c7cac5c8cf727b463","48ae905b4c66b7825196acb73be621806f026b3badc121e839f672efd716fece"],"paragraph_range_zero_based":[25128,25151],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p25128"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"prach-ConfigurationFrameOffset-IAB","paragraph_zero_based":25152},{"literal_text_all_w_t_and_m_t":"Frame offset for ROs defined in the baseline configuration indicated by prach-ConfigurationIndex and is used only by the IAB-MT. (see TS 38.211 [16], clause 6.3.3.2).","paragraph_zero_based":25153},{"literal_text_all_w_t_and_m_t":"prach-ConfigurationIndex","paragraph_zero_based":25154},{"literal_text_all_w_t_and_m_t":"PRACH configuration index. For prach-ConfigurationIndex configured under beamFailureRecoveryConfig, the prach-ConfigurationIndex can only correspond to the short preamble format, (see TS 38.211 [16], clause 6.3.3.2). If the field prach-ConfigurationIndex-v1610 is present, the UE shall ignore the value provided in prach-ConfigurationIndex (without suffix).","paragraph_zero_based":25155},{"literal_text_all_w_t_and_m_t":"prach-ConfigurationPeriodScaling-IAB","paragraph_zero_based":25156},{"literal_text_all_w_t_and_m_t":"Scaling factor to extend the periodicity of the baseline configuration indicated by prach-ConfigurationIndex and is used only by the IAB-MT. Value scf1 corresponds to scaling factor of 1 and so on. (see TS 38.211 [16], clause 6.3.3.2).","paragraph_zero_based":25157},{"literal_text_all_w_t_and_m_t":"prach-ConfigurationSOffset-IAB","paragraph_zero_based":25158},{"literal_text_all_w_t_and_m_t":"Subframe/Slot offset for ROs defined in the baseline configuration indicated by prach-ConfigurationIndex and is used only by the IAB-MT. (see TS 38.211 [16], clause 6.3.3.2).","paragraph_zero_based":25159},{"literal_text_all_w_t_and_m_t":"preambleReceivedTargetPower","paragraph_zero_based":25160},{"literal_text_all_w_t_and_m_t":"The target power level at the network receiver side (see TS 38.213 [13], clause 7.4, TS 38.321 [3], clauses 5.1.2, 5.1.3). Only multiples of 2 dBm may be chosen (e.g. -202, -200, -198, ...). ","paragraph_zero_based":25161},{"literal_text_all_w_t_and_m_t":"preambleTransMax","paragraph_zero_based":25162},{"literal_text_all_w_t_and_m_t":"Max number of RA preamble transmission performed before declaring a failure (see TS 38.321 [3], clauses 5.1.4, 5.1.5).","paragraph_zero_based":25163},{"literal_text_all_w_t_and_m_t":"ra-ResponseWindow","paragraph_zero_based":25164},{"literal_text_all_w_t_and_m_t":"Msg2 (RAR) window length in number of slots. The network configures a value lower than or equal to 10 ms when Msg2 is transmitted in licensed spectrum and a value lower than or equal to 40 ms when Msg2 is transmitted with shared spectrum channel access (see TS 38.321 [3], clause 5.1.4). UE ignores the field if included in SCellConfig. If ra-ResponseWindow-v1610 or ra-ResponseWindow-v1700 is signalled, UE shall ignore the ra-ResponseWindow (without suffix). The field ra-ResponseWindow-v1700 is applicable to SCS 480 kHz and SCS 960 kHz.","paragraph_zero_based":25165},{"literal_text_all_w_t_and_m_t":"zeroCorrelationZoneConfig","paragraph_zero_based":25166},{"literal_text_all_w_t_and_m_t":"N-CS configuration, see Table 6.3.3.1-5 in TS 38.211 [16].","paragraph_zero_based":25167},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25168},{"literal_text_all_w_t_and_m_t":"–RACH-ConfigGenericTwoStepRA","paragraph_zero_based":25169},{"literal_text_all_w_t_and_m_t":"The IE RACH-ConfigGenericTwoStepRA is used to specify the 2-step random access type parameters.","paragraph_zero_based":25170},{"literal_text_all_w_t_and_m_t":"RACH-ConfigGenericTwoStepRA information element","paragraph_zero_based":25171},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25172},{"literal_text_all_w_t_and_m_t":"-- TAG-RACH-CONFIGGENERICTWOSTEPRA-START","paragraph_zero_based":25173},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25174},{"literal_text_all_w_t_and_m_t":"RACH-ConfigGenericTwoStepRA-r16 ::=     SEQUENCE {","paragraph_zero_based":25175}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["cad9260f0c45f6f2c9eb6054b64c0cdea45dc912eed24ff7ad70ebfd08bbf7ef","d2abfe05408695affd1839f2f7aae1c80dee419a3a02e5629cbbc17bc07ffff9","038ac183ee0a7e3abcc322a474f764ab8beebd1b86caad0a0165e92b286b6dba","2826557a08f2cfed1e3c945d67f9425371670b257b9b345ac0b08a6a400a8adf","50ff89af09256d55e51ee7f2fe734b200ddb8c4bde64686653f05efc8318b337","5b739043b9d137f6e0ee8ec97eda098e59f6db800a792cf9bb1347a5ae883434","a7ed8a7ef0a374acc6c6765d7defaa7956b79705bb35ae3d19f1a7cf7c691e24","92e98ec31054baa34c92884716a69337421c593696044d97d726ccf38eeba8e1","979ad79ed0618782205cb5f87ec6a1fcb294a585d3979b37aebff822269013ca","85e3afcd6d926b86062b88e3966c6e39a13c38afea082d46ae59ec6258e7afc5","c839b950d61b83799030e9d7f4c14c00c98bff62175a6e635f85f50f62415cdb","83f7e0ab13f682768980c93ed95faba0d94ecee4ad33f87270d2c297944d1f48","892a4901edc5f348ea086e28f897be2aca0b9f15ea14cc26a4937b0337416433","25447444e8bb0f691088aecdeafeaa3319471f9c189346c0e40c4798f5a46e31","0f676c4b0ad05d74962907a2ee09b068752a6adec603e8dc995f7590efce435e","bd70e6fd6255e0a6a8e2979993edbb3c8a26247f3ba146a5ab157438404286ed","b2c99ea9a16b256a57371617ba249cc7739b1a1aa04c60d22dbaf1cdb9c9f789","faa8fd3ef4c02a5f25cf8d52d0158e780f23d11a4c8c608c7961298968e2c897","fd2bc361ae6e06c2fdc927a04b8bfaa75849452ae20823eaa0f376d71c4584a6","2409c0c38ce870bd77c27808df91a7dc015f6bdda40e43b00ddfc68ef6b71f26","f335db0e9991c5795bd1c4c822f5ed324f53a5b1a3525b48d7aaa06bac214d2a","08da71aa9f340560733e38153371eb03385141c6c3260b1c3f3005326a448da2","7aa509a0d250c69300ba8aaee1e0a156347841a334d744e028906e0859f818d9","e8141955f2c2e7ccc6651e790bf0cdad186e4e39ba8a2cb02fd1600b56893391"],"paragraph_range_zero_based":[25152,25175],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p25152"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    msgA-PRACH-ConfigurationIndex-r16       INTEGER (0..262)                                                OPTIONAL, -- Cond 2StepOnly","paragraph_zero_based":25176},{"literal_text_all_w_t_and_m_t":"    msgA-RO-FDM-r16                         ENUMERATED {one, two, four, eight}                              OPTIONAL, -- Cond 2StepOnly","paragraph_zero_based":25177},{"literal_text_all_w_t_and_m_t":"    msgA-RO-FrequencyStart-r16              INTEGER (0..maxNrofPhysicalResourceBlocks-1)                    OPTIONAL, -- Cond 2StepOnly","paragraph_zero_based":25178},{"literal_text_all_w_t_and_m_t":"    msgA-ZeroCorrelationZoneConfig-r16      INTEGER (0..15)                                                 OPTIONAL, -- Cond 2StepOnly","paragraph_zero_based":25179},{"literal_text_all_w_t_and_m_t":"    msgA-PreamblePowerRampingStep-r16       ENUMERATED {dB0, dB2, dB4, dB6}                                 OPTIONAL, -- Cond 2StepOnlyNoCFRA","paragraph_zero_based":25180},{"literal_text_all_w_t_and_m_t":"    msgA-PreambleReceivedTargetPower-r16    INTEGER (-202..-60)                                             OPTIONAL, -- Cond 2StepOnlyNoCFRA","paragraph_zero_based":25181},{"literal_text_all_w_t_and_m_t":"    msgB-ResponseWindow-r16                 ENUMERATED {sl1, sl2, sl4, sl8, sl10, sl20, sl40, sl80, sl160, sl320}","paragraph_zero_based":25182},{"literal_text_all_w_t_and_m_t":"                                                                                                            OPTIONAL, -- Cond NoCFRA","paragraph_zero_based":25183},{"literal_text_all_w_t_and_m_t":"    preambleTransMax-r16                    ENUMERATED {n3, n4, n5, n6, n7, n8, n10, n20, n50, n100, n200}  OPTIONAL, -- Cond 2StepOnlyNoCFRA","paragraph_zero_based":25184},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":25185},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":25186},{"literal_text_all_w_t_and_m_t":"    msgB-ResponseWindow-v1700               ENUMERATED {sl240, sl640, sl960, sl1280, sl1920, sl2560}        OPTIONAL  -- Cond NoCFRA2","paragraph_zero_based":25187},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":25188},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25189},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25190},{"literal_text_all_w_t_and_m_t":"-- TAG-RACH-CONFIGGENERICTWOSTEPRA-STOP","paragraph_zero_based":25191},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":25192},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25193},{"literal_text_all_w_t_and_m_t":"RACH-ConfigGenericTwoStepRA field descriptions","paragraph_zero_based":25194},{"literal_text_all_w_t_and_m_t":"msgA-PreamblePowerRampingStep","paragraph_zero_based":25195},{"literal_text_all_w_t_and_m_t":"Power ramping steps for msgA PRACH. If the field is absent in RACH-ConfigCommonTwoStepRA in AdditionalRACH-Config, the UE shall apply the corresponding value in RACH-ConfigCommon in the same AdditionalRACH-Config. If the field is absent in other cases, UE shall use the value of powerRampingStep in RACH-ConfigGeneric in the configured BWP (see TS 38.321 [3], 5.1.3). This field may only be present if no 4-step type RA is configured in the BWP or in the case of separate ROs with 4-step type RA. The field is absent if RACH-ConfigGenericTwoStepRA is included in CFRA-TwoStep in RACH-ConfigDedicated and then the UE uses the value of msgA-PreamblePowerRampingStep in RACH-ConfigGenericTwoStepRA configured for CBRA.","paragraph_zero_based":25196},{"literal_text_all_w_t_and_m_t":"msgA-PreambleReceivedTargetPower","paragraph_zero_based":25197},{"literal_text_all_w_t_and_m_t":"The target power level at the network receiver side (see TS 38.213 [13], clause 7.1.1 and TS 38.321 [3], clause 5.1.1). Only multiples of 2 dBm may be chosen (e.g -202, -200, -198, …). If the field is absent, UE shall use the value of preambleReceivedTargetPower in RACH-ConfigGeneric in the configured BWP. This field may only be present if no 4-step type RA is configured in the BWP. The field is absent if RACH-ConfigGenericTwoStepRA is included in CFRA-TwoStep in RACH-ConfigDedicated and then the UE uses the value of msgA-PreambleReceivedTargetPower in RACH-ConfigGenericTwoStepRA configured for CBRA.","paragraph_zero_based":25198},{"literal_text_all_w_t_and_m_t":"msgA-PRACH-ConfigurationIndex","paragraph_zero_based":25199}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["7f0211b313121e06a7e50ad930c33746f35c20df23db8d4054b979ab0ad88830","4b6ff3371a9eb2a64ba0817b80c12ea0f4092ed2a65801e56e415e2f441ff263","2cb05358189787fd75f1bc21dc996a3951997abb68f91beab0e3835464478df9","96d006b4bd272d153bfd7278dea5936168fc500d5847fd38e4b5b35fd304d1fb","d8cb2aebfa16ae1460c031f031c45b9161091cf31913af13eaf3b2b31fcfa8fd","13e4abba5b40e7a802297705d5febf0adf7714ce85386d6d44d310ea08c8db0b","95b0c401e9dfb6af54a852ee1dcc35f02fe39e0dc2c205d26d5e6190868cd99c","f9863886fff9b5cced8c4ed2923c05eb86ab5d0b1babfe48f149651f9290b88e","672eee7c6dfca08ae52ae697cb2ea2c03620358ede6358374c0d5beae19f4cdc","378905d1d344f7e1fb9c49776aec5d84144e44d9bc067a14a9d5d78393ade6aa","6f41d07c1f08d2f62526da224afeb593ff9b18102bddef23c366bb557fed7060","39d06b0e8c7560aa57dd194247c0eae872079fb3aec05f31264a09f174020298","fe7b7f816bff9021d91fe7c15e29951bd6a6c536e7e439980c25b733147fbff4","1fbf0eed5891a83062b84110932896c7b1e7730df5ef66584fd7a3adbef6b580","83f510dcb644455f979139d1ae7e13eb8b843a2a85cb421d3e2f79207a0459e4","1ac21278b67c9faa0e1203c3c6ffb3d89d4cbc5a97ff687b11f12565bc3f35bb","1cdd69c56d4bfb6f8d696324142e3ceb91b0d1da054ed2d77889cc6951475f65","b6ec57d0436208e2d3465eaaf7c5f7099166b52a7ba8476db5a0786a902f6658","51bbd8325e068b0e0c3bd6cd0112e63420fda2495353d3c05694ceb672329cf6","e91fd1ddf87a95ada625bc4cd78dbb962a4d48030077a4e32eeafe5073742052","1622db4fc258762078bd9df1d23ea602027855a1428af1f06e0eeb8b09696eda","9eb80fa341bd7914b29fda79e9fbe83d9778915a3c54b48b1116373e61c13720","36d8e1cb869f7c6c1aed03ca9616a01c846653cc18e0b92d52cf4360d2e03c5c","a45509a332fd7f8c2c2c57377d6a5b3f997aabf44b8cebc3878acc7b33f55ad9"],"paragraph_range_zero_based":[25176,25199],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p25176"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Cell-specific PRACH configuration index for 2-step RA type. If the field is absent in RACH-ConfigCommonTwoStepRA which is configured directly within a BWP (i.e. not within AdditionalRACH-Config), the UE shall use the value of corresponding 4-step random access parameter in the configured BWP. If the field is absent in RACH-ConfigCommonTwoStepRA in AdditionalRACH-Config, the UE shall apply the corresponding value in RACH-ConfigCommon in the same AdditionalRACH-Config. If the value is in the range of 256 to 262, the field prach-ConfigurationIndex-v1610 should be considered configured (see TS 38.211 [16], clause 6.3.3.2). This field may only be present if no 4-step type RA is configured in the BWP or in the case of separate ROs with 4-step type RA.","paragraph_zero_based":25200},{"literal_text_all_w_t_and_m_t":"msgA-RO-FDM","paragraph_zero_based":25201},{"literal_text_all_w_t_and_m_t":"The number of msgA PRACH transmission occasions Frequency-Division Multiplexed in one time instance. If the field is absent in RACH-ConfigCommonTwoStepRA which is configured directly within a BWP (i.e. not within AdditionalRACH-Config), UE shall use value of msg1-FDM in RACH-ConfigGeneric in the configured BWP. If the field is absent in RACH-ConfigCommonTwoStepRA in AdditionalRACH-Config, the UE shall apply the value of msg1-FDM in RACH-ConfigCommon in the same AdditionalRACH-Config (see TS 38.211 [16], clause 6.3.3.2). This field may only be present if no 4-step type RA is configured in the BWP or in the case of separate ROs with 4-step type RA.","paragraph_zero_based":25202},{"literal_text_all_w_t_and_m_t":"msgA-RO-FrequencyStart","paragraph_zero_based":25203},{"literal_text_all_w_t_and_m_t":"Offset of lowest PRACH transmissions occasion in frequency domain with respect to PRB 0. If the field is absent in RACH-ConfigCommonTwoStepRA which is configured directly within a BWP (i.e. not within AdditionalRACH-Config), UE shall use value of msg1-FrequencyStart in RACH-ConfigGeneric in the configured BWP. If the field is absent in RACH-ConfigCommonTwoStepRA in AdditionalRACH-Config, the UE shall apply the value of msg1-FrequencyStart in RACH-ConfigCommon in the same AdditionalRACH-Config (see TS 38.211 [16], clauses 5.3.2 and 6.3.3.2). This field may only be present if no 4-step type RA is configured in the BWP or in the case of separate ROs with 4-step type RA.","paragraph_zero_based":25204},{"literal_text_all_w_t_and_m_t":"msgA-ZeroCorrelationZoneConfig","paragraph_zero_based":25205},{"literal_text_all_w_t_and_m_t":"N-CS configuration for msgA preamble, see Table 6.3.3.1-5 in TS 38.211 [16]. If the field is absent in RACH-ConfigCommonTwoStepRA in AdditionalRACH-Config, the UE shall apply the corresponding value in RACH-ConfigCommon in the same AdditionalRACH-Config. If the field is absent in other cases, UE shall use value zeroCorrelationZoneConfig in RACH-ConfigGeneric in the configured BWP. This field may only be present if no 4-step type RA is configured in the BWP or in the case of separate ROs with 4-step type RA.","paragraph_zero_based":25206},{"literal_text_all_w_t_and_m_t":"msgB-ResponseWindow","paragraph_zero_based":25207},{"literal_text_all_w_t_and_m_t":"MsgB monitoring window length in number of slots. The network configures a value lower than or equal to 40ms (see TS 38.321 [3], clause 5.1.1). The network does not configure msgB-ResponseWindow-r16 simultaneously with msgB-ResponseWindow-v1700, and if both fields are absent, the UE uses the value of msgB-ResponseWindow in RACH-ConfigGenericTwoStepRA configured for CBRA.","paragraph_zero_based":25208},{"literal_text_all_w_t_and_m_t":"preambleTransMax","paragraph_zero_based":25209},{"literal_text_all_w_t_and_m_t":"Max number of RA preamble transmission performed before declaring a failure (see TS 38.321 [3], clauses 5.1.4, 5.1.5). If the field is absent in RACH-ConfigCommonTwoStepRA in AdditionalRACH-Config, the UE shall apply the corresponding value in RACH-ConfigCommon in the same AdditionalRACH-Config. If the field is absent in other cases, UE shall use the value of preambleTransMax in RACH-ConfigGeneric in the configured BWP. The field is absent if RACH-ConfigGenericTwoStepRA is included in CFRA-TwoStep in RACH-ConfigDedicated and then the UE uses the value of preambleTransMax in RACH-ConfigGenericTwoStepRA configured for CBRA.","paragraph_zero_based":25210},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25211},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":25212},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":25213},{"literal_text_all_w_t_and_m_t":"2StepOnly","paragraph_zero_based":25214},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in msgA-ConfigCommon field in BWP-UplinkCommon if rach-ConfigCommon field is absent in this BWP-UplinkCommon, otherwise the field is optionally present in msgA-ConfigCommon field in BWP-UplinkCommon, Need S.","paragraph_zero_based":25215},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in msgA-ConfigCommon in AdditionalRACH-Config if rach-ConfigCommon field is absent in this AdditionalRACH-Config, otherwise the field is optionally present in msgA-ConfigCommon field in AdditionalRACH-Config, Need S.","paragraph_zero_based":25216},{"literal_text_all_w_t_and_m_t":"2StepOnlyNoCFRA","paragraph_zero_based":25217},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if RACH-ConfigGenericTwoStepRA is included in the RACH-ConfigCommonTwoStepRA and there are no 4-step random access configurations configured in the BWP (i.e only 2-step random access type configured in the BWP), otherwise (i.e. 4-step random access configuration also exists in the BWP) the field is optionally present, Need S. When RACH-ConfigGenericTwoStepRA is included in the RACH-ConfigDedicated, this field is absent.","paragraph_zero_based":25218},{"literal_text_all_w_t_and_m_t":"NoCFRA","paragraph_zero_based":25219},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if msgB-ResponseWindow-r17 is absent and RACH-ConfigGenericTwoStepRA is not included in CFRA-TwoStep in RACH-ConfigDedicated, otherwise the field is absent, Need S.","paragraph_zero_based":25220},{"literal_text_all_w_t_and_m_t":"NoCFRA2","paragraph_zero_based":25221},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if msgB-ResponseWindow-r16 is absent and RACH-ConfigGenericTwoStepRA is not included in CFRA-TwoStep in RACH-ConfigDedicated, otherwise the field is absent, Need S.","paragraph_zero_based":25222},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25223}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["50a10f0aa90d3e652c44c87e79a78ae9048e62b2095eacbfc7a110655c8364eb","e7641d00b441c4e0225564f936cf81bb71fb2f9401eda8be4b549c085c051a0d","8481433c2da7b15e5523178c0222b1bd5b2540eae123966f7f0cdc66e3c7379d","f27852f4b7c8837a4c7bea5c84d017e5dafa2067b18a1bf1d4dd8f5b78a2f466","a463a3fd1a559128183fddcb8299251e5caaa4226cb45f73a820e0891bbbcd1c","89019a7f4e72fc5887890c46c96edd7726e1a0f440a2aa0068bf990ed4565c6c","21ec7915f2452174e63134c110b77dd0d9ca430064e4a6de7936175d26387360","3a3a77711afbd75d6610e7e865c66f98795d1d2ada95c0d312ce545abbe9b0ad","77502461292cd1e775d7d2fca791018872ea17e0cd69f57dc736e2665244cd98","80074f0d658842595f5339b0aad932e91448d6011f1066ca0564a11acb4f3a0a","a8544b8d2d5141d8e2bb9d365ad615f8eec1147f25541a7ac2399309e8627800","0dfa162ea161917d34fb917b0a15be5651a8bcf07f7a1607f282a2c9207d537d","dc4910a18f37