{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        scs30-r17            INTEGER (0..19),","paragraph_zero_based":12888},{"literal_text_all_w_t_and_m_t":"        scs60-r17            INTEGER (0..39),","paragraph_zero_based":12889},{"literal_text_all_w_t_and_m_t":"        scs120-r17           INTEGER (0..79)","paragraph_zero_based":12890},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":12891},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":12892},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":12893},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12894},{"literal_text_all_w_t_and_m_t":"-- TAG-UEPOSITIONINGASSISTANCEINFO-STOP","paragraph_zero_based":12895},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":12896},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12897},{"literal_text_all_w_t_and_m_t":"UEPositioningAssistanceInfo field descriptions","paragraph_zero_based":12898},{"literal_text_all_w_t_and_m_t":"nr-TimeStamp","paragraph_zero_based":12899},{"literal_text_all_w_t_and_m_t":"This field specifies the latest time instance at which the association is valid prior to the reporting.","paragraph_zero_based":12900},{"literal_text_all_w_t_and_m_t":"servCellID","paragraph_zero_based":12901},{"literal_text_all_w_t_and_m_t":"This field indicates the serving cell information of SRS for positioning resources associated to the UE Tx TEG report.","paragraph_zero_based":12902},{"literal_text_all_w_t_and_m_t":"ue-TxTEG-ID","paragraph_zero_based":12903},{"literal_text_all_w_t_and_m_t":"Identifies the ID of UE Tx TEG.","paragraph_zero_based":12904},{"literal_text_all_w_t_and_m_t":"ue-TxTEG-TimingErrorMarginValue","paragraph_zero_based":12905},{"literal_text_all_w_t_and_m_t":"This field specifies the UE Tx TEG timing error margin value of all the UE Tx TEGs within one UEPositioningAssistanceInfo. Value tc0 corresponds to 0 Tc, tc2 corresponds to 2 Tc and so on (see TS 37.355 [49]).","paragraph_zero_based":12906},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12907},{"literal_text_all_w_t_and_m_t":"–ULDedicatedMessageSegment","paragraph_zero_based":12908},{"literal_text_all_w_t_and_m_t":"The ULDedicatedMessageSegment message is used to transfer segments of the UECapabilityInformation or MeasurementReportAppLayer message. SRB1 is used at transfer of segments of UECapabilityInformation and SRB4 is used at transfer of segments of MeasurementReportAppLayer.","paragraph_zero_based":12909},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1 or SRB4","paragraph_zero_based":12910},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":12911}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["06035c3a119716b7eeeb8c1ff63c763891342620ea29c4e558e0ec2154ca87c4","34b096b03ce365a1c938821f15bbe447c004c0a1c1a8db5d0c597ea66eb9d3ee","d34b699ca8be52b86c74b17bffd4371103ee408a410c462eaf687c71aeb18222","761eeab0cadf4cca220977c3125897594c8ee114661fbd8fc0d58e666aee89e5","14f3300d0f1fd50fa6e2bfddb06420a35113e551fdfc06790c017f98ed3fcf36","e9c4132c2b5bdac8fc681fb97bfc5ce6ab294f7aba174c6bcd60e3ec769f85d2","a1f39ff74330fc59af243f193ef6acfbd82d89f2b8381452b5e4acc113f0b5b8","bc6a307655dc9d52901186d12b5f6808545ffcbdfe7f72480d3742dcc95af9eb","e2d11e51cb59344f17fb93485efcf5cdecd319d40973695a25a7dd0dc71f791e","39250a87f8a7b98b19cf8398eeb4b659ea866c60e9a0c1aa395dfdb4e99bd378","d08040d86ae7ebf65bc06a3baa3ba99b5be075eebd914e0ee4d3e4d7e92e2d1c","8b7f0ce5b5e5d988aa93b76129de497194220a57c1cacf519d6dbe7235b