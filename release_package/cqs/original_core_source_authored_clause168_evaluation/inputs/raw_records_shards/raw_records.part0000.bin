                             OPTIONAL    -- Cond G-RNTI","paragraph_zero_based":19262},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":19263},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19264},{"literal_text_all_w_t_and_m_t":"MBS-RNTI-SpecificConfigId-r17 ::= INTEGER (0..maxG-RNTI-1-r17)","paragraph_zero_based":19265},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19266},{"literal_text_all_w_t_and_m_t":"-- TAG-MAC-CELLGROUPCONFIG-STOP","paragraph_zero_based":19267},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":19268},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19269},{"literal_text_all_w_t_and_m_t":"MAC-CellGroupConfig field descriptions","paragraph_zero_based":19270},{"literal_text_all_w_t_and_m_t":"allowCSI-SRS-Tx-MulticastDRX-Active","paragraph_zero_based":19271}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["1503160d3bea463e6a9b4bd0abcca44f2c6d2cdd87359cddab9ba518081f9b1e","6aee9a03510753f0fb0faf410fcf672f410dc8467cc11a386fd9310bf694392e","f190e24744f46f879f51bb25ddcd1fdeef7f651d2674d218fe6dce33d01d0850","95fe3147ef33d8ce8ed6b8f755f6a921a15d8e8c3aea2537b2b50621d7114bef","b35c7821e1861b043a2852c5ec9aca1bc658d09e3f76b1e4f43e1fbc91e89ca8","337c0537842156d79bd17b692ced52f98196ae26a323addbed6e4ff647b5a70c","a5c75ced0900624980d8263f07662568aca188d7c540c286ef2b81969a15d024","9edc80df9f43cad2bdf47975f91e10bf17ba9a11ef152d05e98648344ec8384b","df5110b725774203385da8907d41f095bf65f9c571391fe749b319da72d82ce8","fe76f8359c5d999a7c5d6eacb37820a688192223aec8ca89d5eb187843cc5370","e8c2987409cc2ca32291cd51524b057636ec66649b8f30c2d2ac799354820d01","885d24c918596a15baaf500e13c9ddc6f207dd6dad171ee76b1136b8c0c