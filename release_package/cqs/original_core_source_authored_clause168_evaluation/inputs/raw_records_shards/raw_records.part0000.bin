537bb15608b6a5fe27133c9a13d0c5d57486812b","5a3985dabcaefc8ebde2b90225cf49dfd5944ed52da5ca06c58235c87670a616","49b62675a2c749cc8150ae3e72db5ef609057acfe0029eb0746a64949df4d992","c4b00f107b535fc61a5cf4a12dfc552edff944f77ecc6075dda7de8e0310d427","f2d0aa42a2214458c8ee70d98abe38fe2ebb1acdd233892591aa20d8a2858983","e7dfc9ebd442aa330d640292a2443e88b20ef2ead7a6e59473dad7c62f00660e","550396c7460835243f87b213a2d86760aa5377617e9f25803d963e12f634d3fa","c3fb6e384569c82740d33783d0ae14416fc7c0e04cc2325492b0819cecfbbd20","af2f293f78905ff6dadc68d00651264d1dc0c99e24c9c1505dbe53c8f87dc372","e8460ea13789c006581185c34c4632b025cf11ce06fa33c106450ba10d13dbdc"],"paragraph_range_zero_based":[8784,8807],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p8784"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    rrc-MessageSegmentContainer-r16         OCTET STRING,","paragraph_zero_based":8808},{"literal_text_all_w_t_and_m_t":"    rrc-MessageSegmentType-r16              ENUMERATED {notLastSegment, lastSegment},","paragraph_zero_based":8809},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension                OCTET STRING                                  OPTIONAL,","paragraph_zero_based":8810},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                    SEQUENCE {}                                   OPTIONAL","paragraph_zero_based":8811},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":8812},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":8813},{"literal_text_all_w_t_and_m_t":"-- TAG-DLDEDICATEDMESSAGESEGMENT-STOP","paragraph_zero_based":8814},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":8815},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":8816},{"literal_text_all_w_t_and_m_t":"DLDedicatedMessageSegment field descriptions","paragraph_zero_based":8817},{"literal_text_all_w_t_and_m_t":"segmentNumber","paragraph_zero_based":8818},{"literal_text_all_w_t_and_m_t":"Identifies the sequence number of a segment within the encoded DL DCCH message. The network transmits the segments with continuously increasing segmentNumber order so that the UE's RRC layer may expect to obtain them from lower layers in the correct order. Hence, the UE is not required to perform segment re-ordering on RRC level.","paragraph_zero_based":8819},{"literal_text_all_w_t_and_m_t":"rrc-MessageSegmentContainer","paragraph_zero_based":8820},{"literal_text_all_w_t_and_m_t":"Includes a segment of the encoded DL DCCH message. The size of the included segment in this container should be small enough so the resulting encoded RRC message PDU is less than or equal to the PDCP SDU size limit.","paragraph_zero_based":8821},{"literal_text_all_w_t_and_m_t":"rrc-MessageSegmentType","paragraph_zero_based":8822},{"literal_text_all_w_t_and_m_t":"Indicates whether the included DL DCCH message segment is the last segment of the message or not.","paragraph_zero_based":8823},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":8824},{"literal_text_all_w_t_and_m_t":"–DLInformationTransfer","paragraph_zero_based":8825},{"literal_text_all_w_t_and_m_t":"The DLInformationTransfer message is used for the downlink transfer of NAS dedicated information, timing information for the 5G internal system clock, or IAB-DU specific F1-C related information.","paragraph_zero_based":8826},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB2 or SRB1 (only if SRB2 not established yet). If SRB2 is suspended, the network does not send this message until SRB2 is resumed. If only dedicatedInfoF1c is included, SRB2 is used.","paragraph_zero_based":8827},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":8828},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":8829},{"literal_text_all_w_t_and_m_t":"Direction: Network to UE","paragraph_zero_based":8830},{"literal_text_all_w_t_and_m_t":"DLInformationTransfer message","paragraph_zero_based":8831}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["c0565d30a65f8922380f4dd59c604d833c1bb256b978e35d406efd44293dd5d8","861d5ffacf047aab6d09b2fb973c287bee0eb34eb5f57f89891a8edd51469f2c","28cd955532df5ce9634cebc8011d089b9de741a2b50cae1b5270f928913f2293","3f021863e20c16ae8cf5c68f19570f2856ca4b247ee6fd6cf3b397ae06983d1d","e9ec516e0740cd7e8d0ff7c