{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"DedicatedInfoF1c-r17 ::=        OCTET STRING","paragraph_zero_based":36696},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36697},{"literal_text_all_w_t_and_m_t":"-- TAG-DEDICATEDINFOF1C-STOP","paragraph_zero_based":36698},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36699},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36700},{"literal_text_all_w_t_and_m_t":"–EUTRA-AllowedMeasBandwidth","paragraph_zero_based":36701},{"literal_text_all_w_t_and_m_t":"The IE EUTRA-AllowedMeasBandwidth is used to indicate the maximum allowed measurement bandwidth on a carrier frequency as defined by the parameter Transmission Bandwidth Configuration \"NRB\" in TS 36.104 [33]. The values mbw6, mbw15, mbw25, mbw50, mbw75, mbw100 indicate 6, 15, 25, 50, 75 and 100 resource blocks, respectively.","paragraph_zero_based":36702},{"literal_text_all_w_t_and_m_t":"EUTRA-AllowedMeasBandwidth information element","paragraph_zero_based":36703},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36704},{"literal_text_all_w_t_and_m_t":"-- TAG-EUTRA-ALLOWEDMEASBANDWIDTH-START","paragraph_zero_based":36705},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36706},{"literal_text_all_w_t_and_m_t":"EUTRA-AllowedMeasBandwidth ::=              ENUMERATED {mbw6, mbw15, mbw25, mbw50, mbw75, mbw100}","paragraph_zero_based":36707},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36708},{"literal_text_all_w_t_and_m_t":"-- TAG-EUTRA-ALLOWEDMEASBANDWIDTH-STOP","paragraph_zero_based":36709},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36710},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36711},{"literal_text_all_w_t_and_m_t":"–EUTRA-MBSFN-SubframeConfigList","paragraph_zero_based":36712},{"literal_text_all_w_t_and_m_t":"The IE EUTRA-MBSFN-SubframeConfigList is used to define an E-UTRA MBSFN subframe pattern (for the purpose of NR rate matching).","paragraph_zero_based":36713},{"literal_text_all_w_t_and_m_t":"EUTRA-MBSFN-SubframeConfigList information element","paragraph_zero_based":36714},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36715},{"literal_text_all_w_t_and_m_t":"-- TAG-EUTRA-MBSFN-SUBFRAMECONFIGLIST-START","paragraph_zero_based":36716},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36717},{"literal_text_all_w_t_and_m_t":"EUTRA-MBSFN-SubframeConfigList ::= SEQUENCE (SIZE (1..maxMBSFN-Allocations)) OF EUTRA-MBSFN-SubframeConfig","paragraph_zero_based":36718},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36719}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["031c1583981b3189f094f51b26622b03cf3413f4a0452d3abe9640c5ff023903","068757b2dae124e11a7d8cd1c2feed3a4e3540c243a40ce2a619e9dcf0459991","6bd41b2560aa41cb42c8a0b2859770af6fd1bcf2c529ea389e87dcaa6f8aaa5c","ca0ff4dd13222a4b63a13bc0a0730f2463d5e6c803554a334fc0c2f5b63dacb6","1dd0e7298f4f2f22a8c898bbb915b7c191919c30cb63251f82e78602442c3fd6","309ca7c43e715bb16b02ec9bd8e84e3de87000b2dab61e2ee5983bdd830d81b4","984516afd1c38a31acc83a46d6acbe3b3191649dcfffa36dcab1cafaa701c9ab","f76ac97a0549812ed58140b7fcdfc19bc4459caefe1c281018abd991e05bfcf6","340dbe019e15031d8547f4ff7d9d0a8f98f51c80f1c3c0e93d101e041b68fba3","ec531753348c0537fa9d49cef1cea81b0ebdd4a9b1566b8ccc633cd904bfa2be","518f300ce6d91eec54802e6602681a33fe136027ba0e3885c7ea8d94720eb0bb","42223b21d31614e9298fec030f084993447cb3e94055c8c38e300315a9e636cf","5564c2ba1f34ed8bbde2131f924f827d45defa73e8022aa175c3755