{"fields":{"filename":"R2-2312499.zip::R2-2312499_38.331_Rel-18_SL_relay_service_continuity.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":1056},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1057},{"literal_text_all_w_t_and_m_t":"SL-MeasResultListRelay-r17 ::=                  SEQUENCE (SIZE (1..maxNrofRelayMeas-r17)) OF SL-MeasResultRelay-r17","paragraph_zero_based":1058},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1059},{"literal_text_all_w_t_and_m_t":"SL-MeasResultRelay-r17 ::=                      SEQUENCE {","paragraph_zero_based":1060},{"literal_text_all_w_t_and_m_t":"    cellIdentity-r17                                CellAccessRelatedInfo,","paragraph_zero_based":1061},{"literal_text_all_w_t_and_m_t":"    sl-RelayUE-Identity-r17                         SL-SourceIdentity-r17,","paragraph_zero_based":1062},{"literal_text_all_w_t_and_m_t":"    sl-MeasResult-r17                               SL-MeasResult-r16,","paragraph_zero_based":1063},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":1064},{"literal_text_all_w_t_and_m_t":"    sl-MeasQuantity-r18                             ENUMERATED { sl-rsrp, sd-rsrp }                                         OPTIONAL","paragraph_zero_based":1065},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":1066},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1067},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASUREMENTREPORTSIDELINK-STOP","paragraph_zero_based":1068},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":1069},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1070},{"literal_text_all_w_t_and_m_t":"MeasurementReportSidelink field descriptions","paragraph_zero_based":1071},{"literal_text_all_w_t_and_m_t":"sl-MeasId","paragraph_zero_based":1072},{"literal_text_all_w_t_and_m_t":"Identifies the sidelink measurement identity for which the reporting is being performed.","paragraph_zero_based":1073},{"literal_text_all_w_t_and_m_t":"sl-MeasResult","paragraph_zero_based":1074},{"literal_text_all_w_t_and_m_t":"Measured RSRP results of a unicast destination.","paragraph_zero_based":1075},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1076},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1077},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1078},{"literal_text_all_w_t_and_m_t":"Annex (not part of the specification): RAN2 Agreements","paragraph_zero_based":1079}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"78722f96da2c1b0794be02771e6d00815867826bc913cd2dc90778e7cf20a03c","original_member_sha256":"01249659941507b71cdd3a9a4350d5330966e5252dc21fbfc70854bb5a08b2f1","paragraph_ElementTree_utf8_XML_sha256":["885dc656423ad752e94fa075a16b3a0384c3d289df07c5a8e76246f313e59bfb","ad1374c99e6e1aaf081f479d567ff83ba675f1736e7cd61475c6dbdd938b78da","c4a6780656ac2996494ebdaeadf30c1f191b0696f154edfaa9382938b6e5766c","afdd44bf5d5472627e99ff54e036aa47acca513b44de0c54b6d7c70ea36c8a3f","41b694eac4783eabdbee7c6f88ca9cb3504c55c4552bed94ab744b90626ff46f","677f477a01ce9e1b7560f6fa1295d9501107eb673c9f21e7d50e9730e624dca4","9b9cd165f38cd1ff2d6e5f65f6560870d31b8fbc33e9bfe9075c68d3b574b77a","1727ffd27a9343dc5d8435ba58d6a0e407d76a4ae3001ad47f528ad299208c10","1b9f630bc6558daf2fa505b3bc7d2202f1471ad02bf142fdb34a6020e0bdca82","a4454cc77e577559ebde8b6f79e07626f035a51a94eece4cf5218b11c44ac0b3","396514ec2155faea0f5bca91219b7ebd27f47208d1fc0068b9dc1e4557d57834","ea0ded7d905c8dd859ba8934c38b3f6acc3df6928f20824c5098189b7b5769d8","38fb3e4df4b930c9181b7d79379db9310a231fc9632ba9202c73ee9464b20c02","bfb312acb925e1c34f434837419833e79f9933c40c72c02010f256b63a18df61","076105450d7b68039628f9ec542a71411c6d5b82343688383e43cdf440ca98b9","f488bde780f6c14ee6e50a515a511bfcda70845d8906e1a10ec355198b872461","6bd4296768960178f96c5ac542c408f052f7df4d59b0c7c47b9d6a7a763b3504","3a8545a3b95a9b79d23c3ec6c6336a98a6cb4cb95b351d59c346824357690500","74e0832bdf7b9ba8c8c0898bb1e88ecb8b230ad71b538cdf1c66dbc8c4ca68d3","b53c20c0d0095e8e3332be84de2abb8d712fdeadfab941ce45293731e789c280","18ddccf131268cad70f3bd4ba6b052911bb2d49575a9595e7bd045f274972c6b","ebbfd9c25a5f26fba1d8598ed6599ad582d4842e6fa179294a40b7ce347f0b73","94d51c21860e1d7f8743898025bd74f4fcdba26afe4fc7c6a3dcee68e0180616","1e790fb27089b252fdde909a514447955b16d894a4651f4fc3fb81b8717fe887"],"paragraph_range_zero_based":[1056,1079],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312499.zip::R2-2312499_38.331_Rel-18_SL_relay_service_continuity.docx:p1056"}
{"fields":{"filename":"R2-2312499.zip::R2-2312499_38.331_Rel-18_SL_relay_service_continuity.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This Annex contains the RAN2 agreements on Rel-18 WI for “NR sidelink relay enhancements”. The agreements are provided verbatim for reference.This annex shall be removed once the WI is completed.","paragraph_zero_based":1080},{"literal_text_all_w_t_and_m_t":"RAN2#119","paragraph_zero_based":1081},{"literal_text_all_w_t_and_m_t":"For inter-gNB d2i path switching and intra-/inter-gNB i2i path switching in Rel-18, the network can select a target U2N relay UE in any RRC state, i.e., RRC_CONNECTED/IDLE/INACTIVE.","paragraph_zero_based":1082},{"literal_text_all_w_t_and_m_t":"For the target U2N relay UE in any RRC state, the Rel-17 procedures for intra-gNB d2i path switching are used as a baseline for inter-gNB d2i path switching with the addition of inter-gNB signaling over the Xn interface.","paragraph_zero_based":1083},{"literal_text_all_w_t_and_m_t":"The Rel-17 remote UE oriented solution to trigger the target U2N relay UE to the CONNECTED state should also be applicable to the Rel-18 inter/intra-gNB scenarios as a baseline for single-path relay. Other mechanisms are not excluded if an issue is found with the baseline.","paragraph_zero_based":1084},{"literal_text_all_w_t_and_m_t":"When indirect-to-indirect path switch is initiated, the Remote UE can inform upper layers to release the PC5 unicast link with the source relay UE. The timing to execute link release is up to UE implementation.","paragraph_zero_based":1085},{"literal_text_all_w_t_and_m_t":"Introduce a new measurement event that considers both the PC5 link quality with the serving Relay UE and that with candidate Relay UE for the indirect-to-indirect path switch purpose.  FFS if there would be more than one event type.","paragraph_zero_based":1086},{"literal_text_all_w_t_and_m_t":"For the signalling and procedures in Uu and PC5, intra-gNB indirect-to-direct path switch is used as the baseline for inter-gNB i2d path switch.","paragraph_zero_based":1087},{"literal_text_all_w_t_and_m_t":"RAN2#119bis-e","paragraph_zero_based":1088},{"literal_text_all_w_t_and_m_t":"For i2i path switch procedure, introduce a new measurement event based on individual thresholds i.e., Event Z1: Serving L2 U2N Relay UE becomes worse than threshold1 and Candidate L2 U2N Relay UE becomes better than threshold2.  FFS if we also have an event Z2: Candidate L2 U2N Relay UE becomes an offset better than serving L2 U2N Relay UE, and in this case if/how to compare SL-RSRP of serving U2N relay UE and SD-RSRP of candidate U2N relay UE.","paragraph_zero_based":1089},{"literal_text_all_w_t_and_m_t":"For i2i scenario, re-use the SL-RSRP or SD-RSRP measurement quantities for path switching.","paragraph_zero_based":1090},{"literal_text_all_w_t_and_m_t":"For i2i scenario, serving/candidate U2N relay UEs, when SL-RSRP is unavailable, SD-RSRP is used as the measurement quantity.  Wording can be revisited if it is determined that L2IDs for U2U and U2N are always different (so that candidate U2N relay UEs would never have SL-RSRP available).","paragraph_zero_based":1091},{"literal_text_all_w_t_and_m_t":"For i2d path switch scenario, re-use the existing T304 timer","paragraph_zero_based":1092},{"literal_text_all_w_t_and_m_t":"For d2i and i2i path switch scenarios, re-use the existing T420 timer.","paragraph_zero_based":1093},{"literal_text_all_w_t_and_m_t":"RAN2#120","paragraph_zero_based":1094},{"literal_text_all_w_t_and_m_t":"RAN2 will investigate whether providing lossless delivery in DL and UL in the inter-gNB service continuity cases is feasible using Rel-17 mechanisms.","paragraph_zero_based":1095},{"literal_text_all_w_t_and_m_t":"RAN2#121","paragraph_zero_based":1096},{"literal_text_all_w_t_and_m_t":"RAN2 consider that lossless data delivery in the inter-gNB i2x cases needs to be addressed.  Solutions can be considered next meeting (including the possibility of solutions needing work from RAN3).  Solutions based on the PDCP status report mechanism are the baseline.","paragraph_zero_based":1097},{"literal_text_all_w_t_and_m_t":"RAN2 confirms that the relay UE A and relay UE B in scenario D are two different relay UEs. No UE behaviour is expected to enforce this, i.e., the network does not trigger inter-gNB path switch to the same relay UE. FFS how/if to capture in spec.","paragraph_zero_based":1098},{"literal_text_all_w_t_and_m_t":"Event Z2 will not be specified unless the issue of comparing SL-RSRP and SD-RSRP can be resolved.  LS to RAN1/RAN4 to ask about the feasibility of such comparisons, clarifying that there is not yet consensus on whether to support the event.","paragraph_zero_based":1099},{"literal_text_all_w_t_and_m_t":"RAN2#121bis-e","paragraph_zero_based":1100},{"literal_text_all_w_t_and_m_t":"For uplink lossless data delivery for path switch, continue considering solutions U3 and U5 from R2-2304305. Other solutions are not pursued.","paragraph_zero_based":1101},{"literal_text_all_w_t_and_m_t":"U3: Remote UE’s PDCP retransmission based on DL PDCP Status Report from target gNB","paragraph_zero_based":1102},{"literal_text_all_w_t_and_m_t":"U5: Source Relay UE continues to transmit UL data to source gNB and gNB forwards to the target gNB","paragraph_zero_based":1103}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"78722f96da2c1b0794be02771e6d00815867826bc913cd2dc90778e7cf20a03c","original_member_sha256":"01249659941507b71cdd3a9a4350d5330966e5252dc21fbfc70854bb5a08b2f1","paragraph_ElementTree_utf8_XML_sha256":["8c0ad9323bebccfe7eb69ac12a0cb2762dec494e95e56d21cea463857cdfb31a","2668d66e2758c1d3bce951d81c7ff8015feecbbf6b40514cc1ccab04a83a6fe2","24855ea70ab8e19e4b6219a36ac3cedb11bc555889c2c1d399eda07900dadd0a","10ff6ac26f710da39698358d0a8c5ee97c4139970b3debbcdd6cba45ff52c745","f44e2c837847763995df4e17e1e3c02f279be29bd13150f6a594c3b418e66698","6e546b55ec1ab117639b8e8d094fda1b256c0158a3d3831ac5ceceb41399dc20","58ca528c2708cda5a7604f2eb70bfd889e06716e0cb8e3c52f501310fc93991b","2154ad8af30c68d9173f5b236c5878f5a38212d7ba6b4d8daf73e7bdff2a745a","cf348a5817329ebb618217217358c16ba4d63b80563b15200cb1ce2ec235dbc6","b46f469c35236d5627c97ca94556a886c641814f46617d3b2c7604ecde65e7a4","9b327d5a538b2ba6eab414e5886abbd5f6654b669f07fdec3ea1162dc7ff4389","3df558b3d9762cd5358457d0e99ad523564ffb9484e6e2dd3e3a7f55de6973dc","45021fb2fe1c9b591231b62f1016001ff323c146c3b5262dfd776fdb92d962f8","b99b6731fcd1f8e302813850dcd51c7aa2dcffd0538935a552e83d3fc558668c","040a86ae8c4adfab322a57a0cb0edb130befff21387d0330b61c1219779914ae","6d45ebb824c8a9996edaba7da0e0800e1653b189b04e91d5f5b6830c9d712751","9406507614a8f102f0de4c0a0d8b658e2d607a4f9edeb118d818c16e837614b7","b9da4d11cd179c00eeff771b710227269f623c9affa09dc19ce20e75cab8cd04","166444093ef8e8458c06e5aeaa6afd3f584fe64c8d47e51e91525de6564cd425","f718d32c60d4e2e6d2ffe3b177fc1ded168a14a9fb5a30465b020fcb21472d82","628f8b77045c8adb9f140c75c1db2a5d17608be60659dcddc3a7d0e4b966a8c6","0420054f70f6f6cd7b4d80333e51299414325e4bbfdb36f401a5d9614f8a1ddd","396dfcedd5b0c6d0abe1fa6cadd6dfc148ef8c32a5d4642913dcf7365184e5e0","18b9ee3ea3043f0251735c4aaee127b706ec8001599896ae58fd6fea8f095be7"],"paragraph_range_zero_based":[1080,1103],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312499.zip::R2-2312499_38.331_Rel-18_SL_relay_service_continuity.docx:p1080"}
{"fields":{"filename":"R2-2312499.zip::R2-2312499_38.331_Rel-18_SL_relay_service_continuity.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"For downlink lossless data delivery for path switch, Solution-D4 is taken as the baseline solution and keep Solution-D3/D5 on the table for further decision at the next meeting.","paragraph_zero_based":1104},{"literal_text_all_w_t_and_m_t":"D3: A PDCP status report sent from Remote UE to the source gNB","paragraph_zero_based":1105},{"literal_text_all_w_t_and_m_t":"D4: Enhanced Data forwarding from source gNB to target gNB per target gNB request (legacy PDCP status report based)","paragraph_zero_based":1106},{"literal_text_all_w_t_and_m_t":"D5: Proactive Data forwarding from source gNB to target gNB","paragraph_zero_based":1107},{"literal_text_all_w_t_and_m_t":"RAN2#122","paragraph_zero_based":1108},{"literal_text_all_w_t_and_m_t":"The previous agreement from RAN2#119bis-e is revised as follows: For i2i scenario, for serving U2N relay UEs, when SL-RSRP is unavailable, SD-RSRP is used as the measurement quantity. And for candidate U2N relay UEs, only SD-RSRP is used as the measurement quantity.”","paragraph_zero_based":1109},{"literal_text_all_w_t_and_m_t":"Measurement event Z2 (i.e., Candidate L2 U2N Relay UE becomes an offset better than serving L2 U2N Relay UE) is not introduced","paragraph_zero_based":1110},{"literal_text_all_w_t_and_m_t":"RAN2 will not specify any Rel-18 enhancement for lossless behaviour for uplink service continuity in L2 U2N relay.","paragraph_zero_based":1111},{"literal_text_all_w_t_and_m_t":"RAN2 will not specify any Rel-18 enhancement from UE perspective for lossless behaviour for downlink service continuity in L2 U2N relay.","paragraph_zero_based":1112},{"literal_text_all_w_t_and_m_t":"Any operation based on direct comparison between the SD-RSRP and SL-RSRP measured at the Remote UE side is not supported in Rel-18.","paragraph_zero_based":1113},{"literal_text_all_w_t_and_m_t":"RAN2#123","paragraph_zero_based":1114},{"literal_text_all_w_t_and_m_t":"Separate thresholds for SL-RSRP and SD-RSRP can be configured for the threshold1 in Z1. This does not imply that the network is required to configure two different values.","paragraph_zero_based":1115},{"literal_text_all_w_t_and_m_t":"The SL-PathSwitchConfig IE (target relay UE ID and T420) is reused during i2i path switch.","paragraph_zero_based":1116},{"literal_text_all_w_t_and_m_t":"Target node generates the RRCReconfiguration including SL-PathSwitchConfig and sends it to source gNB. Source gNB forwards the received RRCReconfiguration message to remote UE.","paragraph_zero_based":1117},{"literal_text_all_w_t_and_m_t":"RAN2#123bis","paragraph_zero_based":1118},{"literal_text_all_w_t_and_m_t":"Same as Rel-17, Rel-18 Layer-2 U2N Remote UE supporting to be handed over to an IDLE/INACTIVE target relay UE is a UE capability.","paragraph_zero_based":1119},{"literal_text_all_w_t_and_m_t":"Reuse the Rel-17 capability flag.","paragraph_zero_based":1120},{"literal_text_all_w_t_and_m_t":"RRC state is not indicated in discovery signalling; the remote UE reports all candidate relay UEs.","paragraph_zero_based":1121},{"literal_text_all_w_t_and_m_t":"For i2i and i2d path switch procedures, the U2N remote UE applies the SL-RSRP threshold when measuring SL-RSRP and the SD-RSRP threshold when measuring SD-RSRP.","paragraph_zero_based":1122},{"literal_text_all_w_t_and_m_t":"Both SL-RSRP and SD-RSRP thresholds are expected to be available to the UE.  FFS signalling details (e.g., if the second one defaults to be equal to the first).","paragraph_zero_based":1123},{"literal_text_all_w_t_and_m_t":"The L2 U2N Remote UE indicates whether it is reporting SL-RSRP and SD-RSRP.  ASN.1 details and procedural impact to be worked out in CR implementation.","paragraph_zero_based":1124},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1125},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1126}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"78722f96da2c1b0794be02771e6d00815867826bc913cd2dc90778e7cf20a03c","original_member_sha256":"01249659941507b71cdd3a9a4350d5330966e5252dc21fbfc70854bb5a08b2f1","paragraph_ElementTree_utf8_XML_sha256":["596c97cec195429b79b4678b3a69a694c2d71d5fa7ddf417656f7638f93361e2","31299dfa410b8aec40de7b9edceab7ccc0b521c32062ae5ae143f377c55cc139","a11a0274a0bab370239fc64c362755c6ae3f84ddc49ec23aa177d593058fcaee","dabb52f0934ace4a6153ec77e7ea7f370947d4df5e56b2dd915505b57eb02001","39af9d24f0754a7be9b3d3008251fd6c40e625ae9f9e4a2dda2509953d138886","fc29123e13a6a07d7539563b2277f5dc19b13cb074ad35b46542e39c1b3ffefa","1c399979e1fa58ba5e89895f6fed26fe4cb666d1635db5cc476f1266d97e5289","ba7b9a41671731e1ece3548541efc97107d256b98c309821d1a679e57f9e4cb7","21f8fd4efe39b0ab656144cd7e7a7a75e2ba74c9e36491343bf6408996fbf8db","6d04d821f8f5fbfab622bcbcf2a31b067fb52c3c1d51f1c47a5faf0e5e669393","bf5eaf170eea6caf4d42f669643e470f9222eec064c53d140a9c69168b510e96","b2f74a4eee4b3427f688f9dc6158648a996e2e8f9dd735ba1cad3901332fced2","af8b308fe551c5283f4c3219aecbb88974537611eeef734eff7b18dc8531f589","9c55c4ca4f56b7b3fbdb6b755d5c0830df516626ec7bdcc65cae66c14df20068","d821c004978b5ebde7de478b83bfc3f6de664ceac9a235d6b83895fdea77b27c","b14336d9d6d1c1442dd20cdff62e13624b38b1a0a7ab28e0893b19956b4d5fca","5c2ed6d5a760581d3dac3fc7ebd9861da3bc14186ad3241bd27500aebccb0942","754ba5971e2a72ff2e76307739202fc552351681b9c330f0da064a4f55a7498a","71042c9d1eaa1034618f43a60120991b502bcb4e918c4434de5fab609b0aaa69","7f2325ce076861d68bb9b36a68b40cd1b00712f8a781b2b1140679e97eeb90eb","5a80fcede00155039598cd97dd08cf511e86b47c5f414f5ded54653107062dca","53fa7ee9f231567f6d01985ee8b6483772a8b3e82048c4014b27e6ef68e192f8","6b5cbfea9f9b2b2b0adc7cb1195cb732b889b57953b7e9b9efc3120c2917164d"],"paragraph_range_zero_based":[1104,1126],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312499.zip::R2-2312499_38.331_Rel-18_SL_relay_service_continuity.docx:p1104"}
