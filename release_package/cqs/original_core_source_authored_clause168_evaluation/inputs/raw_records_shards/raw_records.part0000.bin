{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    sl-TxPoolExceptional-r16         SL-ResourcePoolConfig-r16                                            OPTIONAL     -- Need M","paragraph_zero_based":37584},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37585},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37586},{"literal_text_all_w_t_and_m_t":"SL-TxPoolDedicated-r16 ::=       SEQUENCE {","paragraph_zero_based":37587},{"literal_text_all_w_t_and_m_t":"    sl-PoolToReleaseList-r16         SEQUENCE (SIZE (1..maxNrofTXPool-r16)) OF SL-ResourcePoolID-r16      OPTIONAL,    -- Need N","paragraph_zero_based":37588},{"literal_text_all_w_t_and_m_t":"    sl-PoolToAddModList-r16          SEQUENCE (SIZE (1..maxNrofTXPool-r16)) OF SL-ResourcePoolConfig-r16  OPTIONAL     -- Need N","paragraph_zero_based":37589},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37590},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37591},{"literal_text_all_w_t_and_m_t":"SL-ResourcePoolConfig-r16 ::=    SEQUENCE {","paragraph_zero_based":37592},{"literal_text_all_w_t_and_m_t":"    sl-ResourcePoolID-r16            SL-ResourcePoolID-r16,","paragraph_zero_based":37593},{"literal_text_all_w_t_and_m_t":"    sl-ResourcePool-r16              SL-ResourcePool-r16                                                  OPTIONAL    -- Need M","paragraph_zero_based":37594},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37595},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37596},{"literal_text_all_w_t_and_m_t":"SL-ResourcePoolID-r16 ::=        INTEGER (1..maxNrofPoolID-r16)","paragraph_zero_based":37597},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37598},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-BWP-POOLCONFIG-STOP","paragraph_zero_based":37599},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":37600},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37601},{"literal_text_all_w_t_and_m_t":"SL-BWP-PoolConfig field descriptions","paragraph_zero_based":37602},{"literal_text_all_w_t_and_m_t":"sl-RxPool","paragraph_zero_based":37603},{"literal_text_all_w_t_and_m_t":"Indicates the receiving resource pool on the configured BWP. For the PSFCH related configuration, if configured, will be used for PSFCH transmission/reception. If the field is included, it replaces any previous list, i.e. all the entries of the list are replaced and each of the SL-ResourcePool entries is considered to be newly created.","paragraph_zero_based":37604},{"literal_text_all_w_t_and_m_t":"sl-TxPoolExceptional","paragraph_zero_based":37605},{"literal_text_all_w_t_and_m_t":"Indicates the resources by which the UE is allowed to perform NR sidelink transmission in exceptional conditions on the configured BWP. For the PSFCH related configuration, if configured, will be used for PSFCH transmission/reception.","paragraph_zero_based":37606},{"literal_text_all_w_t_and_m_t":"sl-TxPoolScheduling","paragraph_zero_based":37607}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["1b1dc0b8950689de74e1b8082f520a3d28ef6fd5973d1bf79b8b6096f84d58b9","fee69ce79492fc84584818501a6d3a86c713ee7cd2611cc02cbeef2f97837b49","813e4eb410f0571f731ed316e56fb4310a6d17e36476775a430eed32a7f5b9f1","43583a29bdd0f58410617b4503841c5e19c0af1a44c4864f0b65d8cd7b95d576","91dafdd636f3a6b3f67103f45f052aa7956f8e654642fa79f1a0a717c17fef3d","72c6cc048604aa9cadd5867620c9d65076c33d33027e12a28e2c23464113e2ee","22190b6df590cd0d37c570c45e9c6b2a81a5868496c4e67c4300a44f20d9fb55","10a62be57135875106c7144