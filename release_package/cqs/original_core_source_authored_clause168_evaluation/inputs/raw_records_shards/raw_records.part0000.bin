{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ehc-Uplink-r16                 SEQUENCE {","paragraph_zero_based":22392},{"literal_text_all_w_t_and_m_t":"        maxCID-EHC-UL-r16              INTEGER (1..32767),","paragraph_zero_based":22393},{"literal_text_all_w_t_and_m_t":"        drb-ContinueEHC-UL-r16         ENUMERATED { true }                                      OPTIONAL,   -- Need N","paragraph_zero_based":22394},{"literal_text_all_w_t_and_m_t":"        ...","paragraph_zero_based":22395},{"literal_text_all_w_t_and_m_t":"    }                                                                                           OPTIONAL    -- Need M","paragraph_zero_based":22396},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22397},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22398},{"literal_text_all_w_t_and_m_t":"UL-DataSplitThreshold ::= ENUMERATED {","paragraph_zero_based":22399},{"literal_text_all_w_t_and_m_t":"                                            b0, b100, b200, b400, b800, b1600, b3200, b6400, b12800, b25600, b51200, b102400, b204800,","paragraph_zero_based":22400},{"literal_text_all_w_t_and_m_t":"                                            b409600, b819200, b1228800, b1638400, b2457600, b3276800, b4096000, b4915200, b5734400,","paragraph_zero_based":22401},{"literal_text_all_w_t_and_m_t":"                                            b6553600, infinity, spare8, spare7, spare6, spare5, spare4, spare3, spare2, spare1}","paragraph_zero_based":22402},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22403},{"literal_text_all_w_t_and_m_t":"DiscardTimerExt-r16 ::= ENUMERATED {ms0dot5, ms1, ms2, ms4, ms6, ms8, spare2, spare1}","paragraph_zero_based":22404},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22405},{"literal_text_all_w_t_and_m_t":"DiscardTimerExt2-r17 ::= ENUMERATED {ms2000, spare3, spare2, spare1}","paragraph_zero_based":22406},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22407},{"literal_text_all_w_t_and_m_t":"UplinkDataCompression-r17 ::= CHOICE {","paragraph_zero_based":22408},{"literal_text_all_w_t_and_m_t":"    newSetup                      SEQUENCE {","paragraph_zero_based":22409},{"literal_text_all_w_t_and_m_t":"        bufferSize-r17                ENUMERATED {kbyte2, kbyte4, kbyte8, spare1},","paragraph_zero_based":22410},{"literal_text_all_w_t_and_m_t":"        dictionary-r17                ENUMERATED {sip-SDP, operator}                            OPTIONAL    -- Need N","paragraph_zero_based":22411},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":22412},{"literal_text_all_w_t_and_m_t":"    drb-ContinueUDC           NULL","paragraph_zero_based":22413},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22414},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22415}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["19a9dc225e0a6ee58791d7fe53196ac0757a6f9f7012b528d59a6224be7af806","a1303477d54ec67105c22a28c1647b76cdf0b47066f47bc7117e50ea56d52745","88c42d6219d93918719f5c62ddaeaeadba26facb777c607be6d6c18134a80960","420e42c41e903d4104977606f4412ffb2d24b997b9df640b838b864677234c6a","560224dc233a066278258ecd24adc64c15cedf771cc52a64ac895e01ae9cde3d","312bc0f0e9aa518d57c0d28393308021b90663b9bb7ca01a8298a38d247df900","1638ff2dc252e4c92abf7a701f544c191fab067ece8ea5254a87cc3a2dc29fe4","f15cb00e96d4ef029fa210d9919aae00a01833cce6492119b05033295a4683bb","4ce3493273ecf4dfa0eeb483b35080656325ca19021e452a953ae1e595e021da","e2d31008a6f414230ca96adadc2628f114ad0a015877f0f80d49d007e245424b","9c5fcb9a389b68d4c956e2eaea8a020b76d0eaebfa18d9b5b385a11b9d6d7efd","a1e6a6fadf9eff4ee99b38603a0acd0b1e5ccf968139a1517460709dfdf7b809","0c5ec543a0edc065d8a23dd02d015d9b6bf10caef9b4575e076cfceba7f366a3","3b6ee028886977283764d2e7f7c46d74bb9f0786e629c2a01dcd3b46fc17783b","d0f28c935eb525bac36260d00711dbea4bf473bf0403d15f4d0be8543b286dc0","42fa9c13ca9bbcb8b32d4a1b9a302ddf5c45a4a21cddd04b49709ecfcfef3ef9","355016b8059db4f0360eb43a4333e6a3fb56f609d7b24a1d17d4f39c182f8a0c","6973f6b9f0a16c2a26defc78105c1560b25df6a783e924cc7e694531fc4b4dd7","959998a1cb6a40834ed3b20e79b834abcc85fc4e5133d37c52ae7cb8292ef5db","385d02a863b5cd015ec848ff9e09aa2d84ff32ce8f639a053476c9b638c03c7b","6f51372b915f4b49e38b989ee9cac479a0ad7b62b686c3daaad6ccc92e599473","5060bd8bf7078a1caf13942196b9147f1825c92bcc6b3cd21066b2f8bde91e55","8ce2322048b3604cb957a67c8d55b2cd5a9c97352b50a793acb5ac59a39c2416","63dda3bfce0443a6cfb3b6292dc570b6e0824f6e3fdc49a94c24f5bd699b487f"],"paragraph_range_zero_based":[22392,22415],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p22392"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-PDCP-CONFIG-STOP","paragraph_zero_based":22416},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":22417},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22418},{"literal_text_all_w_t_and_m_t":"PDCP-Config field descriptions","paragraph_zero_based":22419},{"literal_text_all_w_t_and_m_t":"cipheringDisabled","paragraph_zero_based":22420},{"literal_text_all_w_t_and_m_t":"If included, ciphering is disabled for this DRB regardless of which ciphering algorithm is configured for the SRB/DRBs. The field may only be included if the UE is connected to 5GC. Otherwise the field is absent. The network configures all DRBs with the same PDU-session ID with same value for this field. The value for this field cannot be changed after the DRB is set up.","paragraph_zero_based":22421},{"literal_text_all_w_t_and_m_t":"discardTimer","paragraph_zero_based":22422},{"literal_text_all_w_t_and_m_t":"Value in ms of discardTimer specified in TS 38.323 [5]. Value ms10 corresponds to 10 ms, value ms20 corresponds to 20 ms and so on. The value for this field cannot be changed in case of reconfiguration with sync, if the bearer is configured as DAPS bearer.","paragraph_zero_based":22423},{"literal_text_all_w_t_and_m_t":"discardTimerExt","paragraph_zero_based":22424},{"literal_text_all_w_t_and_m_t":"Value in ms of discardTimer specified in TS 38.323 [5]. Value ms0dot5 corresponds to 0.5 ms, value ms1 corresponds to 1ms and so on. If this field is present, the field discardTimer is ignored and discardTimerExt is used instead.","paragraph_zero_based":22425},{"literal_text_all_w_t_and_m_t":"discardTimerExt2","paragraph_zero_based":22426},{"literal_text_all_w_t_and_m_t":"Value in ms of discardTimerExt specified in TS 38.323 [5]. Value ms2000 corresponds to 2000 ms. If this field is present, the field discardTimer and discardTimerExt are ignored and discardTimerExt2 is used instead.","paragraph_zero_based":22427},{"literal_text_all_w_t_and_m_t":"drb-ContinueROHC","paragraph_zero_based":22428},{"literal_text_all_w_t_and_m_t":"Indicates whether the PDCP entity continues or resets the ROHC header compression protocol during PDCP re-establishment, as specified in TS 38.323 [5]. This field is configured only in case of resuming an RRC connection or reconfiguration with sync, where the PDCP termination point is not changed and the fullConfig is not indicated. The network does not include the field if the bearer is configured as DAPS bearer. This field can be configured for both DRB and multicast MRB.","paragraph_zero_based":22429},{"literal_text_all_w_t_and_m_t":"duplicationState","paragraph_zero_based":22430},{"literal_text_all_w_t_and_m_t":"This field indicates the uplink PDCP duplication state for the associated RLC entities at the time of receiving this IE. If set to true, the PDCP duplication state is activated for the associated RLC entity. The index for the indication is determined by ascending order of logical channel ID of all RLC entities other than the primary RLC entity indicated by primaryPath in the order of MCG and SCG, as in clause 6.1.3.32 of TS 38.321 [3]. If the number of associated RLC entities other than the primary RLC entity is two, UE ignores the value in the largest index of this field. If the field is absent, the PDCP duplication states are deactivated for all associated RLC entities. ","paragraph_zero_based":22431},{"literal_text_all_w_t_and_m_t":"ethernetHeaderCompression","paragraph_zero_based":22432},{"literal_text_all_w_t_and_m_t":"This fields configures Ethernet Header Compression. This field can only be configured for a bi-directional DRB or a bi-directional multicast MRB. The network reconfigures ethernetHeaderCompression only upon reconfiguration involving PDCP re-establishment and with neither drb-ContinueEHC-DL nor drb-ContinueEHC-UL configured. Network only configures this field when uplinkDataCompression is not configured.","paragraph_zero_based":22433},{"literal_text_all_w_t_and_m_t":"headerCompression","paragraph_zero_based":22434},{"literal_text_all_w_t_and_m_t":"If rohc is configured, the UE shall apply the configured ROHC profile(s) in both uplink and downlink. If uplinkOnlyROHC is configured, the UE shall apply the configured ROHC profile(s) in uplink (there is no header compression in downlink). ROHC can be configured for any bearer type. ROHC and EHC can be both configured simultaneously for a DRB or a multicast MRB. The network reconfigures headerCompression only upon reconfiguration involving PDCP re-establishment or involving PDCP entity reconfiguration to configure DAPS bearer(s), and without any drb-ContinueROHC. Network configures headerCompression to notUsed when outOfOrderDelivery is configured. Network only configures this field when uplinkDataCompression is not configured.","paragraph_zero_based":22435},{"literal_text_all_w_t_and_m_t":"initialRX-DELIV","paragraph_zero_based":22436},{"literal_text_all_w_t_and_m_t":"Indicates the initial value of RX_DELIV during PDCP window initialization for multicast MRB as specified in TS 38.323 [5].","paragraph_zero_based":22437},{"literal_text_all_w_t_and_m_t":"integrityProtection","paragraph_zero_based":22438},{"literal_text_all_w_t_and_m_t":"Indicates whether or not integrity protection is configured for this radio bearer. The network configures all DRBs with the same PDU-session ID with same value for this field. The value for this field cannot be changed after the DRB is set up.","paragraph_zero_based":22439}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["12173aa6d5247a0c7ac2ba52cf27efb4a36fde988f13fdbc03d1944d26b28bd4","3f7616bcb5c7ded0d7f008829a6c67cd230d0412ca1ad11cc839b245c5bc2568","07a278fa319b5c2f4c74c203566e11de3ef4508a1da121f747c2550e5e3fbe87","58cc7530d557734eca8c89379c3b1d28ad440cf3fd4537e7be84d48161ae2f8f","0738a478e6bb6664bd33b333db340695947431e10da956c96f7402a252439b26","a88fa8ac6076d99601bdee074961dd540cb25fdd540964459fdd989d904621cf","bc3b4f1b8cc89aab32899503fafcc151ec867842e422305e21e2e3817d10b72c","9f88da8ccf6d6cc7091f4316c2e86340bffa0d5db1bb20b3634c50a28824de5d","68059291d804ac8b42341679f40c92a93a2a1b7938788d1f9d62a70dedc93dfb","8a86cb6ff473f1e556932d20040796cb391c6d45bbf39f737e12a514b7c20954","82fa3a7e4572b00717913ef46d1dbd1e6530c381e976a251193bd758a22a34d3","bbcc2913eb7411614a3f78425620b7fc844086ca6fe202292d8294d4760bc6ea","c7352fef7252a405aaff1aed17276cc31eb9bceb0f4f64f0a5b9034cd93afdb8","ad20d5e4e908359e3025d3e627f10cef98d96e6769d86f0151932cc2aa29064a","6024be0d38ba9e46bdc4c77ab921815034c219d5f763c4c6e8d80168287263d9","bc1c2022559291c335de4d35cda5dcf90b4ca7c404a9522f1f43193f00e62728","129fdc1ca79a97c77c8c02fde6434ad2d3911e741ad611593b771167f258cf3c","cfc33d3cb2f218dabd5c931261fc87ae13153b70ead44afb5432152255a1a217","8ba21fce233af17f80728511a6672b15fdeb8d9d352ad576520ed4faaaa203ae","971f95287d783b3b16505b0091480994d3035be823713a346d459f96391c3a80","32b0e2a54a9224840ca1b51d631aec1d34367643f4957a42877e4ae8a72b93a4","eb962d566a17e14c96f2c2ee281951c4ad7547f8c1ccf65fc83813b25d67bb5f","c63b7d0916d67038452b40d5af24280c1a294f3ed1b937dc87cb471992f956b5","c8d984506b460e1973ae92405ed151396892433e46d1cf1d309dc6d6d2f245ef"],"paragraph_range_zero_based":[22416,22439],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p22416"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"maxCID","paragraph_zero_based":22440},{"literal_text_all_w_t_and_m_t":"Indicates the value of the MAX_CID parameter as specified in TS 38.323 [5].","paragraph_zero_based":22441},{"literal_text_all_w_t_and_m_t":"The total value of MAX_CIDs across all bearers for the UE should be less than or equal to the value of maxNumberROHC-ContextSessions parameter as indicated by the UE.","paragraph_zero_based":22442},{"literal_text_all_w_t_and_m_t":"moreThanOneRLC","paragraph_zero_based":22443},{"literal_text_all_w_t_and_m_t":"This field configures UL data transmission when more than one RLC entity is associated with the PDCP entity. This field is not present if the bearer is configured as DAPS bearer.","paragraph_zero_based":22444},{"literal_text_all_w_t_and_m_t":"moreThanTwoRLC-DRB","paragraph_zero_based":22445},{"literal_text_all_w_t_and_m_t":"This field configures UL data transmission when more than two RLC entities are associated with the PDCP entity for DRBs.","paragraph_zero_based":22446},{"literal_text_all_w_t_and_m_t":"outOfOrderDelivery","paragraph_zero_based":22447},{"literal_text_all_w_t_and_m_t":"Indicates whether or not outOfOrderDelivery specified in TS 38.323 [5] is configured. This field should be either always present or always absent, after the radio bearer is established.","paragraph_zero_based":22448},{"literal_text_all_w_t_and_m_t":"pdcp-Duplication","paragraph_zero_based":22449},{"literal_text_all_w_t_and_m_t":"Indicates whether or not uplink duplication status at the time of receiving this IE is configured and activated as specified in TS 38.323 [5]. The presence of this field indicates that duplication is configured. PDCP duplication is not configured for CA packet duplication of LTE RLC bearer. The value of this field, when the field is present, indicates the state of the duplication at the time of receiving this IE. If set to true, duplication is activated. The value of this field is always true, when configured for a SRB. For PDCP entity with more than two associated RLC entities for UL transmission, this field is always present. If the field moreThanTwoRLC-DRB is present, the value of this field is ignored and the state of the duplication is indicated by duplicationState. For PDCP entity with more than two associated RLC entities, only NR RLC bearer is supported.","paragraph_zero_based":22450},{"literal_text_all_w_t_and_m_t":"pdcp-SN-SizeDL","paragraph_zero_based":22451},{"literal_text_all_w_t_and_m_t":"PDCP sequence number size for downlink, 12 or 18 bits, as specified in TS 38.323 [5]. For SRBs only the value len12bits is applicable. The value for this field cannot be changed in case of reconfiguration with sync, if the bearer is configured as DAPS bearer.","paragraph_zero_based":22452},{"literal_text_all_w_t_and_m_t":"pdcp-SN-SizeUL","paragraph_zero_based":22453},{"literal_text_all_w_t_and_m_t":"PDCP sequence number size for uplink, 12 or 18 bits, as specified in TS 38.323 [5]. For SRBs only the value len12bits is applicable. The value for this field cannot be changed in case of reconfiguration with sync, if the bearer is configured as DAPS bearer.","paragraph_zero_based":22454},{"literal_text_all_w_t_and_m_t":"primaryPath","paragraph_zero_based":22455},{"literal_text_all_w_t_and_m_t":"Indicates the cell group ID and LCID of the primary RLC entity as specified in TS 38.323 [5], clause 5.2.1 for UL data transmission when more than one RLC entity is associated with the PDCP entity. In this version of the specification, only cell group ID corresponding to MCG is supported for SRBs, except for the split SRB2 of the IAB-MT, and except when the UE is required to set the primaryPath to refer to the SCG as specified in clause 5.7.3b.4. In this last case, if the network sends an RRCReconfiguration message (in NR-DC) or an EUTRA RRCConnectionReconfiguration message (in (NG)EN-DC) keeping SRB1 as split SRB, the network explicitly configures the primaryPath for the PDCP entity of SRB1 to refer to the MCG. In this version of the specification, only cell group ID corresponding to MCG is supported for DRBs when the SCG is deactivated. The NW indicates cellGroup for split bearers using logical channels in different cell groups. The NW always indicates logicalChannel if CA based PDCP duplication is configured in the cell group indicated by cellGroup of this field.","paragraph_zero_based":22456},{"literal_text_all_w_t_and_m_t":"splitSecondaryPath","paragraph_zero_based":22457},{"literal_text_all_w_t_and_m_t":"Indicates the LCID of the split secondary RLC entity as specified in TS 38.323 [5] for fallback to split bearer operation when UL data transmission with more than two RLC entities is associated with the PDCP entity. This RLC entity belongs to a cell group that is different from the cell group indicated by cellGroup in the field primaryPath.","paragraph_zero_based":22458},{"literal_text_all_w_t_and_m_t":"statusReportRequired","paragraph_zero_based":22459},{"literal_text_all_w_t_and_m_t":"For AM DRBs, AM MRBs and DAPS UM DRBs, indicates whether the DRB or the multicast MRB is configured to send a PDCP status report in the uplink, as specified in TS 38.323 [5]. For DAPS AM DRBs, it also indicates whether the DRB is configured to send a second PDCP status report in the uplink, as specified in TS 38.323 [5].","paragraph_zero_based":22460},{"literal_text_all_w_t_and_m_t":"survivalTimeStateSupport","paragraph_zero_based":22461},{"literal_text_all_w_t_and_m_t":"Indicates whether the DRB associated with this PDCP entity has survival time state support. If this field is configured to be true, all associated RLC entities are activated for PDCP duplication upon reception of a retransmission grant addressed to CS-RNTI, as specified in TS 38.321 [3].","paragraph_zero_based":22462},{"literal_text_all_w_t_and_m_t":"t-Reordering","paragraph_zero_based":22463}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["0677452d9dbac6a788cbb7a4696ce9777460ff00fd4944d520785105666af2f7","ab0340dfec9354b53b73ceaf73a503e4f28b5cc2ab97e9435408af96c83b5538","d22389b4113d562b83419c957659526c5544e027af1491f23ef383c6766485c0","9797e4478cac1637b6051efa4e38680bc86885b6a65498ac59c3e60a761778a6","b73efcac277341594611108493c62fad6b137c14c550f56f6bf5a4e74e725a96","a252e3e0c615c468d5a4b800ef8b37425d3f4e961e46eeeb7181c113768a75e1","237d822f0f7e7f97a813cdfb18f376819c26b4ab3fda2b8267801f61d745842f","468abae257b6af09e8cb94038ffc0ec0a892f7698336d4f0a758920c0006b7a6","c47bb621a09d785903c63a4b27fb7e06e532a1aa898ce44d48811dcee8395a75","e22ac1c8451e46849628cc87c8f01853b71fd9f1839a9b7485c55a5df3df2e9a","c89f852093801e5ec269f98643f078e531297754452f58e4420ca8abc268c4a5","d63356956042fc26e6b6ba5365fede5764f87e86fa90a7c46708682af68ea207","64eaaac74ddd3bb1bb573601f092f3040cc3fde53944602f7e6287bac27efe23","e033b0adcf8c604e86da5bb15b99857335383b110a31d10d763edd3d0d0b51e6","8fbbf2839eb37a029ce174463d5ff05a8067e07abbc4abc7c95bb75d53985808","dab1dd20c4fd28bb4a3991fdb5257f3b3e4165e298e51de89ba3cf96ae4b95de","53d2fdad567f7ba34dc0879168070700685e5f63e33bec1f73e9b10325456a2c","69fe005a71411e01f16ea1e8e06c8b5ececf5dc8d77a1bfbfebac1e4ea6e069e","d6333bbf5bc2d0e5c9aef8bf9f84d40dd012fa2d8b8309e3a1c7276bda66d3b1","8d184db93c90110ed3af53f1074072dfddee146086a5b405b8b4f86e84ee5bd8","e889a3de2e4250b65979bb43c7b59578359713e95dbff1e28c9200a3d6570080","a652259e34bc92775e3ad410403d531bf540d93be3263e218d58483385e284b2","6c45959f9307dca3d7ddcddda8932b30db68ee69d2dfbe77c1f78c8dcc244c66","a7ed4477d9dbea2451432ccd1a281a627e1c0976dc06fd6e490f82e5bdc9982f"],"paragraph_range_zero_based":[22440,22463],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p22440"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Value in ms of t-Reordering specified in TS 38.323 [5]. Value ms0 corresponds to 0 ms, value ms20 corresponds to 20 ms, value ms40 corresponds to 40 ms, and so on.  When the field is absent the UE applies the value infinity. The value for this field cannot be changed in case of reconfiguration with sync, if the bearer is configured as DAPS bearer.","paragraph_zero_based":22464},{"literal_text_all_w_t_and_m_t":"ul-DataSplitThreshold","paragraph_zero_based":22465},{"literal_text_all_w_t_and_m_t":"Parameter specified in TS 38.323 [5]. Value b0 corresponds to 0 bytes, value b100 corresponds to 100 bytes, value b200 corresponds to 200 bytes, and so on. The network sets this field to infinity for UEs not supporting splitDRB-withUL-Both-MCG-SCG and when the SCG is deactivated. If the field is absent when the split bearer is configured for the radio bearer first time, then the default value infinity is applied.","paragraph_zero_based":22466},{"literal_text_all_w_t_and_m_t":"uplinkDataCompression","paragraph_zero_based":22467},{"literal_text_all_w_t_and_m_t":"Indicates the UDC configuration that the UE shall apply. Network does not configure uplinkDataCompression for a DRB, if headerCompression or ethernetHeaderCompression is already configured or outOfOrderDelivery or DAPS is configured for the DRB. The maximum number of DRBs where uplinkDataCompression can be applied is two. The network reconfigures uplinkDataCompression only upon reconfiguration involving PDCP re-establishment. If the field is set to drb-ContinueUDC, the PDCP entity continues the uplink data compression protocol during PDCP re-establishment, as specified in TS 38.323 [5]. The field is set to drb-ContinueUDC only in case of resuming an RRC connection or reconfiguration with sync, where the PDCP termination point is not changed and the fullConfig is not indicated.","paragraph_zero_based":22468},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22469},{"literal_text_all_w_t_and_m_t":"EthernetHeaderCompression field descriptions","paragraph_zero_based":22470},{"literal_text_all_w_t_and_m_t":"drb-ContinueEHC-DL","paragraph_zero_based":22471},{"literal_text_all_w_t_and_m_t":"Indicates whether the PDCP entity continues or resets the downlink EHC header compression protocol during PDCP re-establishment, as specified in TS 38.323 [5]. The field is configured only in case of resuming an RRC connection or reconfiguration with sync, where the PDCP termination point is not changed and the fullConfig is not indicated.","paragraph_zero_based":22472},{"literal_text_all_w_t_and_m_t":"drb-ContinueEHC-UL","paragraph_zero_based":22473},{"literal_text_all_w_t_and_m_t":"Indicates whether the PDCP entity continues or resets the uplink EHC header compression protocol during PDCP re-establishment, as specified in TS 38.323 [5]. The field is configured only in case of resuming an RRC connection or reconfiguration with sync, where the PDCP termination point is not changed and the fullConfig is not indicated.","paragraph_zero_based":22474},{"literal_text_all_w_t_and_m_t":"ehc-CID-Length","paragraph_zero_based":22475},{"literal_text_all_w_t_and_m_t":"Indicates the length of the CID field for EHC packet. The value bits7 indicates the length is 7 bits, and the value bits15 indicates the length is 15 bits. Once the field ethernetHeaderCompression-r16 is configured for a DRB or a multicast MRB, the value of the field ehc-CID-Length for this DRB or multicast MRB is not reconfigured to a different value.","paragraph_zero_based":22476},{"literal_text_all_w_t_and_m_t":"ehc-Common","paragraph_zero_based":22477},{"literal_text_all_w_t_and_m_t":"Indicates the configurations that apply for both downlink and uplink.","paragraph_zero_based":22478},{"literal_text_all_w_t_and_m_t":"ehc-Downlink","paragraph_zero_based":22479},{"literal_text_all_w_t_and_m_t":"Indicates the configurations that apply for only downlink. If the field is configured, then Ethernet header compression is configured for downlink. Otherwise, it is not configured for downlink.","paragraph_zero_based":22480},{"literal_text_all_w_t_and_m_t":"ehc-Uplink","paragraph_zero_based":22481},{"literal_text_all_w_t_and_m_t":"Indicates the configurations that apply for only uplink. If the field is configured, then Ethernet header compression is configured for uplnik. Otherwise, it is not configured for uplink.","paragraph_zero_based":22482},{"literal_text_all_w_t_and_m_t":"maxCID-EHC-UL","paragraph_zero_based":22483},{"literal_text_all_w_t_and_m_t":"Indicates the value of the MAX_CID_EHC_UL parameter as specified in TS 38.323 [5]. The total value of MAX_CID_EHC_UL across all bearers for the UE should be less than or equal to the value of maxNumberEHC-Contexts parameter as indicated by the UE.","paragraph_zero_based":22484},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22485},{"literal_text_all_w_t_and_m_t":"UplinkDataCompression field descriptions","paragraph_zero_based":22486},{"literal_text_all_w_t_and_m_t":"bufferSize","paragraph_zero_based":22487}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["93a7505a632557510012f693e2b4c4a2a199ad1f4321b5a108ad02806f14b34a","82c59800659072cf12ace3725504aa0ca81e8181078b6ea43fe7a324181d18f1","55844057d617be41cc36332247317d35ffbdf56b31e13167dfd1b1b169ec6fb0","be330cc0468831285306a5922b62587237485c479289337f59a82678725a7b80","f143254f0015b7fc6de2efda82d1cf622417d447d9bb2196395cd8ae37f2306d","5881570fc279e3cd519eb769d3f37d62d9d94539e5493c5ea6d1a807afa4b049","5b71b8e659838d21a09ae2f489f5fbced7549ad057e94c2c68383670188148f7","2f623cb990079d32c6d11470885bc6ca0d8cb7b9b45c53f8cb42ef4e0a043e49","23b2af81b2659b756f2b2e5ebb0e6f2bdc4f35f2f54f4aede26d00faf83f5409","35f6c570743e21e77bc08d47fdfe6a20add336f9aa5ee5982fd85a33035d9adb","60db5a50ad8c97f6c0fb897ca0c72205a3fb78e988f06477bbc49c1757a87ad1","f4e5f5b293ec7c3bec693bfb6951251d113e241eb8e22cb46bbb7a0895913b51","563fe954b06d95ea6912bb6daf2210938ba20d815f4a1f5804034517e4fdfd11","2a8b031e0f8bf18f53a33c29bd51ca1aae3e467e1ec9da7a22b3c2d44bcfd95c","23f4023128587cce5a86f47f6ddd57dcb7e24a68aaed6c8fcca6138f4d6bb306","2e669f09750fb407ae59a18719cffa22dea8ac86e3b97c24966cc255e4e12af4","e5099f69a1deed004470e59a0df5187744b462d5c4d5667e59bda6e2fbf7a1ac","75d5c406a7fbb15b829ccff481b94c6c7657e59c263f3868d32ad83e704539c9","a7064f2420b781098112b8aa1908ba339841f9a9aab876eae9c463ac4bb15641","850f6fab69640e10d0db6f82c48eb6cfea8d6a19bf7eaba057b4128c22e32024","1b0a6e6da28b8325e9b96f99f4cfd35d4e3b24b533bb7123f226330c7ecadd4b","6b6487ca639a1c04bc07785f73e5a09b70d1f47df2e14b0ba8ff966f5c68a8c4","a2a9b0ae5a57cce5a282e7706dc1dcdbc1756f0c67831701590de13da928520b","5141bcb3ee10d72084bda077f1c8b7fa7b7ba74e76da3f60bcb1086e57e8c2d8"],"paragraph_range_zero_based":[22464,22487],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p22464"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field indicates the buffer size applied for UDC as specified in TS 38.323 [5]. Value kbyte2 means 2048 bytes, kbyte4 means 4096 bytes and so on.","paragraph_zero_based":22488},{"literal_text_all_w_t_and_m_t":"dictionary","paragraph_zero_based":22489},{"literal_text_all_w_t_and_m_t":"This field indicates which pre-defined dictionary is used for UDC as specified in TS 38.323 [5]. The value sip-SDP means that UE shall prefill the buffer with standard dictionary for SIP and SDP defined in TS 38.323 [5], and the value operator means that UE shall prefill the buffer with operator-defined dictionary.","paragraph_zero_based":22490},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22491},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":22492},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":22493},{"literal_text_all_w_t_and_m_t":"DRB","paragraph_zero_based":22494},{"literal_text_all_w_t_and_m_t":"This field is mandatory present when the corresponding DRB/multicast MRB is being set up, absent for SRBs. Otherwise this field is optionally present, need M.","paragraph_zero_based":22495},{"literal_text_all_w_t_and_m_t":"DRB2","paragraph_zero_based":22496},{"literal_text_all_w_t_and_m_t":"This field is optionally present in case of DRB, need M. Otherwise, it is absent for SRBs and MRBs.","paragraph_zero_based":22497},{"literal_text_all_w_t_and_m_t":"Drb-Duplication","paragraph_zero_based":22498},{"literal_text_all_w_t_and_m_t":"For SRBs, this field is absent. For DRBs, this field is absent if duplication is not configured. Otherwise, this field is optional, need R.","paragraph_zero_based":22499},{"literal_text_all_w_t_and_m_t":"MoreThanOneRLC","paragraph_zero_based":22500},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon RRC reconfiguration with setup of a PDCP entity for a radio bearer (except for multicast MRB) with more than one associated logical channel and upon RRC reconfiguration with the association of additional logical channels to the PDCP entity.","paragraph_zero_based":22501},{"literal_text_all_w_t_and_m_t":"The field is also mandatory present in case the field moreThanTwoRLC-DRB is included in PDCP-Config.","paragraph_zero_based":22502},{"literal_text_all_w_t_and_m_t":"Upon RRC reconfiguration when a PDCP entity is associated with multiple logical channels, this field is optionally present need M. Otherwise, this field is absent. Need R.","paragraph_zero_based":22503},{"literal_text_all_w_t_and_m_t":"MoreThanTwoRLC-DRB","paragraph_zero_based":22504},{"literal_text_all_w_t_and_m_t":"For SRBs, this field is absent.","paragraph_zero_based":22505},{"literal_text_all_w_t_and_m_t":"For DRBs, this field is mandatory present upon RRC reconfiguration with setup of a PDCP entity for a radio bearer with more than two associated logical channels and upon RRC reconfiguration with the association of one or more additional logical channel(s) to the PDCP entity so that the PDCP entity has more than two associated logical channels.","paragraph_zero_based":22506},{"literal_text_all_w_t_and_m_t":"Upon RRC reconfiguration when a PDCP entity is associated with more than two logical channels, this field is optionally present, Need M. Otherwise, the field is absent, Need R.","paragraph_zero_based":22507},{"literal_text_all_w_t_and_m_t":"Rlc-AM","paragraph_zero_based":22508},{"literal_text_all_w_t_and_m_t":"For RLC AM, the field is optionally present, need M. Otherwise, the field is absent.","paragraph_zero_based":22509},{"literal_text_all_w_t_and_m_t":"Rlc-AM-UM","paragraph_zero_based":22510},{"literal_text_all_w_t_and_m_t":"In case of DRB, for RLC UM (if the UE supports DAPS handover) or RLC AM, the field is optionally present, need R. In case of multicast MRB, if multicast MRB is associated with at least one RLC AM entity, the field is optionally present, need R. Otherwise, the field is absent.","paragraph_zero_based":22511}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["d50e7d55f6ce229474057c7db9d4bc2429efee16248420e15dc4a9a4a09767d1","b7b361aa02fe34d27ebeb96ae784a8157c983b79dcb0f00ca28da0a70f4119ca","4c93cfdac1417373dda9ffe40f0191c638417253af3d55df82307fb32696f83f","1a66e853344e5b1c166b7e0d45a086e7c0473b22bc31a6fb8e1a2c9ea5e3c0e9","630354f6612a32d4d95c42e7e5b02834c186da188218fd33ca0f6a6cd3a61a24","07e9b9f52c01ff77d5152c1c103da74b1c60c7a8a623c821467baf8f1fbfb53f","7ab6d3decbf425752932a5f66fbafa77d65c18bee07fbb97d3a6f6ba84bf751e","7e4a20abaa4987ecfdedea3aaa9db00d8c46fca926ac217d23989adfeae08aa6","79f639b25cc4adf0fde7f3904c324474fbb197ddf5e421e11c4e5d73abf62f47","c4773abd6d0a11911116724661a325f1a11b98fe3602394ba248cb0b277790d6","45e00fa94ee2b25d35d112eecd41abf2dd72617d0ba95e59cc36ac3a5bfabf33","5328b6804bdb819033fa2f774492a25fcbb6f2b1f4bf9fec350d9cae2ee6ff62","08df97f0ed6be9fa76c01a33d28cdb0d321cae22026849407cd5d830f24bfcbd","e81ab880bf22fd9bc1adea24aeab592d99a7bacb909f763c027b07b216e8be51","c454c20a4ab2327d6957a60b671834a2cb91f6a9bb2d18866f76a72e51746ef9","2d031c646c952737855e8e47867780d7bfe45154658feeb7d9e1d70c1ce21c7f","63397d59f7ba1abc3dd31eaca911ca2d997ae831c314371276d36450c4c19a7f","6e32f727c2bd3623b04e2693c411b104b69e5947e16335cd6fb950624a970584","f819e0df4bfb490a308dab85c53b850f5d71819f4101bf948915fdc1a09a6e92","9d63d11e0f8ca32847a878cda93d869b618fe6bd95f3712de178768066b7e05c","0ae20ead16d5c8613a79c2e275ea06526b39132f6ed7bd003334e8910b33ff4a","5dedfdeee704bd8ba70964d70351dd5f0ffb7dc0aa5121c0271e2113625ab52c","5cb18a7958292b523bc5102cf7b1398dd4b9d33d98a7db7544033bd65056bd44","76e47aa6b26faf3fa09298ef1d2fdd128f22d013084177226b996f8deacac882"],"paragraph_range_zero_based":[22488,22511],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p22488"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Setup","paragraph_zero_based":22512},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in case of DRB setup. Otherwise the field is optionally present, need M.","paragraph_zero_based":22513},{"literal_text_all_w_t_and_m_t":"SplitBearer","paragraph_zero_based":22514},{"literal_text_all_w_t_and_m_t":"The field is absent for SRBs. Otherwise, the field is optional present, need M, in case of radio bearer with more than one associated RLC mapped to different cell groups.","paragraph_zero_based":22515},{"literal_text_all_w_t_and_m_t":"SplitBearer2","paragraph_zero_based":22516},{"literal_text_all_w_t_and_m_t":"The field is mandatory present, in case of a split bearer. Otherwise the field is absent.","paragraph_zero_based":22517},{"literal_text_all_w_t_and_m_t":"ConnectedTo5GC","paragraph_zero_based":22518},{"literal_text_all_w_t_and_m_t":"The field is optionally present, need R, if the UE is connected to 5GC. Otherwise the field is absent.","paragraph_zero_based":22519},{"literal_text_all_w_t_and_m_t":"ConnectedTo5GC1","paragraph_zero_based":22520},{"literal_text_all_w_t_and_m_t":"The field is optionally present, need R, if the UE is connected to NR/5GC or if the UE supports user plane integrity protection when connected to E-UTRA/EPC (as specified in TS 33.401 [30]). Otherwise the field is absent.","paragraph_zero_based":22521},{"literal_text_all_w_t_and_m_t":"Setup1","paragraph_zero_based":22522},{"literal_text_all_w_t_and_m_t":"This field is mandatory present in case of DRB setup for RLC-AM and RLC-UM. Otherwise, this field is absent, Need M.","paragraph_zero_based":22523},{"literal_text_all_w_t_and_m_t":"Setup2","paragraph_zero_based":22524},{"literal_text_all_w_t_and_m_t":"This field is mandatory present in case for radio bearer setup for RLC-AM and RLC-UM. Otherwise, this field is absent, Need M.","paragraph_zero_based":22525},{"literal_text_all_w_t_and_m_t":"MRB-Initialization","paragraph_zero_based":22526},{"literal_text_all_w_t_and_m_t":"This field is mandatory present in case of multicast MRB setup. In case of PDCP re-establishment for multicast MRB, this field is optionally present, Need N. Otherwise, this field is absent, Need N.","paragraph_zero_based":22527},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22528},{"literal_text_all_w_t_and_m_t":"–PDSCH-Config","paragraph_zero_based":22529},{"literal_text_all_w_t_and_m_t":"The PDSCH-Config IE is used to configure the UE specific PDSCH parameters. If this IE is used for MBS CFR, the following fields shall be absent: tci-StatesToAddModList, tci-StatesToReleaseList, zp-CSI-RS-ResourceToAddModList, minimumSchedulingOffsetK0, antennaPortsFieldPresenceDCI-1-2, aperiodicZP-CSI-RS-ResourceSetsToAddModListDCI-1-2, aperiodicZP-CSI-RS-ResourceSetsToReleaseListDCI-1-2, dmrs-DownlinkForPDSCH-MappingTypeA-DCI-1-2, dmrs-DownlinkForPDSCH-MappingTypeB-DCI-1-2, dmrs-SequenceInitializationDCI-1-2, harq-ProcessNumberSizeDCI-1-2, mcs-TableDCI-1-2, numberOfBitsForRV-DCI-1-2, pdsch-AggregationFactor, pdsch-TimeDomainAllocationListDCI-1-2, prb-BundlingTypeDCI-1-2, priorityIndicatorDCI-1-2, rateMatchPatternGroup1DCI-1-2, rateMatchPatternGroup2DCI-1-2, resourceAllocationType1GranularityDCI-1-2, vrb-ToPRB-InterleaverDCI-1-2, referenceOfSLIVDCI-1-2, resourceAllocationDCI-1-2, dataScramblingIdentityPDSCH2-r16, repetitionSchemeConfig.","paragraph_zero_based":22530},{"literal_text_all_w_t_and_m_t":"PDSCH-Config information element","paragraph_zero_based":22531},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":22532},{"literal_text_all_w_t_and_m_t":"-- TAG-PDSCH-CONFIG-START","paragraph_zero_based":22533},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22534},{"literal_text_all_w_t_and_m_t":"PDSCH-Config ::=                        SEQUENCE {","paragraph_zero_based":22535}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["fee57f91e54ac28e9d01b9d2ee5950c6dd4aed482e69319b50b4cd9a954ff49e","0f1a23a2f73a5fb1a5ee37f22ae6f86af11c15f96e7c02cdfbce1521e52e9be7","606b8d3232f2679bf5033014e145060a0022c6fa6f29363da70fb9cfbd574e1c","10267e90af4a21df436e0102556da6f92c7269bbfa9b330bd908fe2d11a2c05f","38018cedab50ade2d36a487306957f805e0b095ae28c8d810cba24e69f458eb5","bba486e6e09927cb6f149013f6757cdea3bd31d516702364ff669279e4af4676","01895e19a0ea17f9f1b3b20478fac4dbd638b91005f5c56833db8e793c80ab9e","069dab4706918656a8e63bbb589a1eb609ba05f2f3317a174adc3656cde56c71","160d4b560f97ec7a305996e905c38db3eb4aecc1ac4f111202291bda9262c51c","6d0cb3ead2892844a921535ef3fe3b75fcaf7c65ccae185af66e127b9462b998","58034593c55cbf6a1fe3a7e62a3d39cc1c48ec609eb03970624b9a2c351b9dc9","0fdcbd36663845fcc21e967384c1c411014c992ca2a0088034d3229fcdb89252","f1aa146ac7bffb3a91d818899be2a04d38347519a9a147767b95ba748403bd46","ba83e135af6bc2fa20177b3e590745e8977624888feba541cbd8ed88048771de","35ac7ad43569f29480cdb3ad1ef301591c48fe74a6d71f9db01c72bf458507e5","0fb2bea6bbc6f3cb4bc36997b5f4c1135f7455d57e7dab9d642567e891a99870","3ff8769e3c158080ac5e939d7152b75b98b9aa09c5d7650fa525b5434b5700ca","2c7676ec44761e6c3b8fff9554a0fe3fdac49e437f43ce5dd505406c42193415","e1c7877fe52fcb079a69500a3ed6b796bdc06c321dd38a331a5b354b1f2f288f","9d733740320453e2246e5b0ae5ec88a7faf05f91c8ea6e778d9a5c1029c7a3fc","88de36d5fba1006c8d4d55f20639090e9fcde99e02462aa5103524cd74b5963d","be89a393e071f6379c32029379ba3e78ba2986fc7dcc69446fa709b9dac7bdf6","73a20081e79368c4c5037735ade2b0a9aeda49028fb45acf5439bf9f0fcc2d57","615c6cafc4d7e81ffd2b6bb2b6c32d4058aa5d656588a8657b8dda11cf5b8fb3"],"paragraph_range_zero_based":[22512,22535],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p22512"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    dataScramblingIdentityPDSCH             INTEGER (0..1023)                                                   OPTIONAL,   -- Need S","paragraph_zero_based":22536},{"literal_text_all_w_t_and_m_t":"    dmrs-DownlinkForPDSCH-MappingTypeA      SetupRelease { DMRS-DownlinkConfig }                                OPTIONAL,   -- Need M","paragraph_zero_based":22537},{"literal_text_all_w_t_and_m_t":"    dmrs-DownlinkForPDSCH-MappingTypeB      SetupRelease { DMRS-DownlinkConfig }                                OPTIONAL,   -- Need M","paragraph_zero_based":22538},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22539},{"literal_text_all_w_t_and_m_t":"    tci-StatesToAddModList                  SEQUENCE (SIZE(1..maxNrofTCI-States)) OF TCI-State                  OPTIONAL,   -- Need N","paragraph_zero_based":22540},{"literal_text_all_w_t_and_m_t":"    tci-StatesToReleaseList                 SEQUENCE (SIZE(1..maxNrofTCI-States)) OF TCI-StateId                OPTIONAL,   -- Need N","paragraph_zero_based":22541},{"literal_text_all_w_t_and_m_t":"    vrb-ToPRB-Interleaver                   ENUMERATED {n2, n4}                                                 OPTIONAL,   -- Need S","paragraph_zero_based":22542},{"literal_text_all_w_t_and_m_t":"    resourceAllocation                      ENUMERATED { resourceAllocationType0, resourceAllocationType1, dynamicSwitch},","paragraph_zero_based":22543},{"literal_text_all_w_t_and_m_t":"    pdsch-TimeDomainAllocationList          SetupRelease { PDSCH-TimeDomainResourceAllocationList }             OPTIONAL,   -- Need M","paragraph_zero_based":22544},{"literal_text_all_w_t_and_m_t":"    pdsch-AggregationFactor                 ENUMERATED { n2, n4, n8 }                                           OPTIONAL,   -- Need S","paragraph_zero_based":22545},{"literal_text_all_w_t_and_m_t":"    rateMatchPatternToAddModList            SEQUENCE (SIZE (1..maxNrofRateMatchPatterns)) OF RateMatchPattern   OPTIONAL,   -- Need N","paragraph_zero_based":22546},{"literal_text_all_w_t_and_m_t":"    rateMatchPatternToReleaseList           SEQUENCE (SIZE (1..maxNrofRateMatchPatterns)) OF RateMatchPatternId OPTIONAL,   -- Need N","paragraph_zero_based":22547},{"literal_text_all_w_t_and_m_t":"    rateMatchPatternGroup1                  RateMatchPatternGroup                                               OPTIONAL,   -- Need R","paragraph_zero_based":22548},{"literal_text_all_w_t_and_m_t":"    rateMatchPatternGroup2                  RateMatchPatternGroup                                               OPTIONAL,   -- Need R","paragraph_zero_based":22549},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22550},{"literal_text_all_w_t_and_m_t":"    rbg-Size                                ENUMERATED {config1, config2},","paragraph_zero_based":22551},{"literal_text_all_w_t_and_m_t":"    mcs-Table                               ENUMERATED {qam256, qam64LowSE}                                     OPTIONAL,   -- Need S","paragraph_zero_based":22552},{"literal_text_all_w_t_and_m_t":"    maxNrofCodeWordsScheduledByDCI          ENUMERATED {n1, n2}                                                 OPTIONAL,   -- Need R","paragraph_zero_based":22553},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22554},{"literal_text_all_w_t_and_m_t":"    prb-BundlingType                        CHOICE {","paragraph_zero_based":22555},{"literal_text_all_w_t_and_m_t":"        staticBundling                          SEQUENCE {","paragraph_zero_based":22556},{"literal_text_all_w_t_and_m_t":"            bundleSize                              ENUMERATED { n4, wideband }                                 OPTIONAL    -- Need S","paragraph_zero_based":22557},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":22558},{"literal_text_all_w_t_and_m_t":"        dynamicBundling                     SEQUENCE {","paragraph_zero_based":22559}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["cda99ba44074406b1606f51a84bbe0fefe8595d3602ce4d7887048274aa57dde","8e6eb01de7bddd0f30ccbd6bad9a59c5899f23fb2e7c52f429120e6a74e66ec2","fe438c8ba5d1f590e861745e6fb2349da8397d07f8fd85e9c6f68162160117e4","59d9d0aae781e571beedca1674cbca0a41e73f0d5f7fc02b1a746db71b2c1529","c90d65a810651e5e427c0cd599ea572297daa159ece82a2749567fbbe491398e","448c75c2d0e71b94c57a5d3c04bde0bf1b6a41d00e1cdc4d7cf0b72d9a3ee681","5355080d728ba139061740b01d806c9504123c71b9ebe36300e5d80ffd522f83","b62ebf1a28339ce18049bbde259b432db4fb86fbdc6a9dafa9a90cc0ec8c5cd3","73f261763d788e08797da36204ce34ebf2ebea68afac1fb15994746216439d89","384876d7746fe52730bd53f94bef0ec48b270994343026a0d17c2c2a3171d2b7","63644fe2750151721c6f3155507a425bd435d4709ebbabaf0480d30a04cb6760","1edf111131c6792d70c3cf96dbb68379c8f8fc76764688d14267aea13e62a6c6","ba4067915ef1eceacb54f405a374e70288049ecc541b6d246b97412c4cbc9672","677a662a8d8d43087d6af1e9c57f6aef6dbe3b401473b2305be1771601ee29b5","7916990df444caa5d4243421b8c675428e3f779541cd2423b8a5e6a0f1c684dd","6322347c225645837368951f96b11c37fd55e2a7370edfab39b58d8c333583ac","67fe009bf49e535f00fe111cb96164fc4b61e62e751c801c5defa3d9e96e053a","3c148cce55672c8329126a7e5384ee75e9739ef3e50a77ee459f9981e2624607","39160e620894a4c80ce61c08725a7b02c8f669a770069325ce4e2c0c60dbda14","cfbb65def724ea0490ac70a45c67e5a8e5273c7a2ba8889109366bfb7c65831d","e1b28128cc87f17d10ba59b0d8e499b273b216b7b1b83662f360df7dc6466657","45487bbb71832ca9a97a8c0f08bc93f5b1be8c66fbad8e0fcf1df4924b07403a","f92d521bbad5227130bddfacd5db5ee8747f94f0902267b40e5274585d1ed8ff","bee