{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9024},{"literal_text_all_w_t_and_m_t":"-- TAG-DEDICATEDSIBREQUEST-STOP","paragraph_zero_based":9025},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":9026},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9027},{"literal_text_all_w_t_and_m_t":"DedicatedSIBRequest field descriptions","paragraph_zero_based":9028},{"literal_text_all_w_t_and_m_t":"requestedSIB-List","paragraph_zero_based":9029},{"literal_text_all_w_t_and_m_t":"Contains a list of SIB(s) the UE requests while in RRC_CONNECTED.","paragraph_zero_based":9030},{"literal_text_all_w_t_and_m_t":"requestedPosSIB-List","paragraph_zero_based":9031},{"literal_text_all_w_t_and_m_t":"Contains a list of posSIB(s) the UE requests while in RRC_CONNECTED.","paragraph_zero_based":9032},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9033},{"literal_text_all_w_t_and_m_t":"PosSIB-ReqInfo field descriptions","paragraph_zero_based":9034},{"literal_text_all_w_t_and_m_t":"gnss-id","paragraph_zero_based":9035},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that the request positioning SIB type is for a specific GNSS. Indicates a specific GNSS (see also TS 37.355 [49])","paragraph_zero_based":9036},{"literal_text_all_w_t_and_m_t":"sbas-id","paragraph_zero_based":9037},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that the request positioning SIB type is for a specific SBAS. Indicates a specific SBAS (see also TS 37.355 [49]).","paragraph_zero_based":9038},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9039},{"literal_text_all_w_t_and_m_t":"–DLDedicatedMessageSegment","paragraph_zero_based":9040},{"literal_text_all_w_t_and_m_t":"The DLDedicatedMessageSegment message is used to transfer one segment of the RRCResume or RRCReconfiguration messages.","paragraph_zero_based":9041},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1","paragraph_zero_based":9042},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":9043},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":9044},{"literal_text_all_w_t_and_m_t":"Direction: Network to UE","paragraph_zero_based":9045},{"literal_text_all_w_t_and_m_t":"DLDedicatedMessageSegment message","paragraph_zero_based":9046},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":9047}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["57a8fab07ff83ef704a738cf5db3e585d46a5477ab4f4336036d3055d8c80ff5","ed7f0d56fec25f31e5830a6cd34008eb98859069cf12af358095fa7fd8f907f8","b18aefa086793d114d39da25376b51fa37da767d7c4cfe14c1fbb2ad278dea30","b714a818df6769276513d6695ad58e8b40cba66ae1783023acb44acb584c7fee","5e1e541c1e4b7c797e581b85d48b0ee4cff9df0a282e23ac06ad3ce8159fcb3b","9e27cd78efc2ed3ac0a00416133ff1a7cc23d25eb5b8b1934f70f137599f07ce","19be493858a95214904ee1373580e76129cd9a2a8f2a8bd3dae2c7f0859f2b74","4936a4484f3960432880c81635483613bb386e613dff22c5da397cd0ffc4adee","2acd1e9191e75859c4f6ac9784931796133d97a7465432bb625a24a0895e7c0e","3b6c04c8a8565f963c19869db486779717ea29c20cc0d4942b1ff135a18e9ed5","2dfcf397bca031de3b0e44aa3e4e2ead85cc9da05d3393f5aecfb0cb37d0916f","184e47ba92814d40bc9fdf7f196069cac153ca7b7e65e3546ae4f56b68d57ac0","997a1bb14e925d52b5a81f6553036aa624e742d99c4da79afd64f99b6c5e67e5","30d60df7d4b58278800e2c8a4919524d89be319c3271a36f3c8979f585e7c147","ba0d20b95690154e656230d915226fba53e6caf357a532336f009316787ccc0b","85d57da90ec21b4558fc1627a4e71505a7010d107dcedfbbb8b8c9c5