{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37296},{"literal_text_all_w_t_and_m_t":"-- TAG-RRC-TRANSACTIONIDENTIFIER-STOP","paragraph_zero_based":37297},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":37298},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37299},{"literal_text_all_w_t_and_m_t":"–Sensor-NameList","paragraph_zero_based":37300},{"literal_text_all_w_t_and_m_t":"The IE Sensor-NameList is used to indicate the names of the sensors which the UE is configured to measure.","paragraph_zero_based":37301},{"literal_text_all_w_t_and_m_t":"Sensor-NameList information element","paragraph_zero_based":37302},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":37303},{"literal_text_all_w_t_and_m_t":"-- TAG-SENSORNAMELIST-START","paragraph_zero_based":37304},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37305},{"literal_text_all_w_t_and_m_t":"Sensor-NameList-r16 ::= SEQUENCE {","paragraph_zero_based":37306},{"literal_text_all_w_t_and_m_t":"    measUncomBarPre-r16     ENUMERATED {true}            OPTIONAL,  -- Need R","paragraph_zero_based":37307},{"literal_text_all_w_t_and_m_t":"    measUeSpeed             ENUMERATED {true}            OPTIONAL,  -- Need R","paragraph_zero_based":37308},{"literal_text_all_w_t_and_m_t":"    measUeOrientation       ENUMERATED {true}            OPTIONAL   -- Need R","paragraph_zero_based":37309},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37310},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37311},{"literal_text_all_w_t_and_m_t":"-- TAG-SENSORNAMELIST-STOP","paragraph_zero_based":37312},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":37313},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37314},{"literal_text_all_w_t_and_m_t":"","parag