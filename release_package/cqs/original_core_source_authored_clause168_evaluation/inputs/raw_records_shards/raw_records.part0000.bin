11f61e0c0e3b4e847b30fc6c24285c69576e2cdec9a074d","f72c6b9b11558ddefbd13ee5c990ee2777045308238458628ff4bc69ba7ec5b7","859470e38342ef7acfa6e5462ecae15b97c7eb68a79229ca9f226bb0e839b32d","ea75e4ebf9dd3447372c0a4731d24b3f25516b78f40a5ca239afdaa4b4a89c5c"],"paragraph_range_zero_based":[1872,1895],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx:p1872"}
{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1896},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":1897},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":1898},{"literal_text_all_w_t_and_m_t":"Rep","paragraph_zero_based":1899},{"literal_text_all_w_t_and_m_t":"The field is mandatory present, if dl-PRS-ResourceRepetitionFactor is present. Otherwise it is not present.","paragraph_zero_based":1900},{"literal_text_all_w_t_and_m_t":"NotSame","paragraph_zero_based":1901},{"literal_text_all_w_t_and_m_t":"The field is optionally present, need OP. If the field is absent, the indicated nr-DL-PRS-PrioResourceID belongs to the same DL-PRS Resource Set as the nr-DL-PRS-ResourceID.","paragraph_zero_based":1902},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1903},{"literal_text_all_w_t_and_m_t":"NR-DL-PRS-Info field descriptions","paragraph_zero_based":1904},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-ResourceSetID","paragraph_zero_based":1905},{"literal_text_all_w_t_and_m_t":"This field specifies the DL-PRS Resource Set ID, which is used to identify the DL-PRS Resource Set of the TRP across all the frequency layers.","paragraph_zero_based":1906},{"literal_text_all_w_t_and_m_t":"dl-PRS-Periodicity-and-ResourceSetSlotOffset","paragraph_zero_based":1907},{"literal_text_all_w_t_and_m_t":"This field specifies the periodicity of DL-PRS allocation in slots configured per DL-PRS Resource Set and the slot offset with respect to SFN #0 slot #0 for a TRP where the DL-PRS Resource Set is configured (i.e. slot where the first DL-PRS Resource of DL-PRS Resource Set occurs).","paragraph_zero_based":1908},{"literal_text_all_w_t_and_m_t":"dl-PRS-ResourceRepetitionFactor","paragraph_zero_based":1909},{"literal_text_all_w_t_and_m_t":"This field specifies how many times each DL-PRS Resource is repeated for a single instance of the DL-PRS Resource Set. It is applied to all resources of the DL-PRS Resource Set. Enumerated values n2, n4, n6, n8, n16, n32 correspond to 2, 4, 6, 8, 16, 32 resource repetitions, respectively. If this field is absent, the value for dl-PRS-ResourceRepetitionFactor is 1 (i.e., no resource repetition).","paragraph_zero_based":1910},{"literal_text_all_w_t_and_m_t":"dl-PRS-ResourceTimeGap","paragraph_zero_based":1911},{"literal_text_all_w_t_and_m_t":"This field specifies the offset in units of slots between two repeated instances of a DL-PRS Resource corresponding to the same DL-PRS Resource ID within a single instance of the DL-PRS Resource Set. The time duration spanned by one DL-PRS Resource Set containing repeated DL-PRS Resources should not exceed DL-PRS-Periodicity.","paragraph_zero_based":1912},{"literal_text_all_w_t_and_m_t":"dl-PRS-NumSymbols","paragraph_zero_based":1913},{"literal_text_all_w_t_and_m_t":"This field specifies the number of symbols per DL-PRS Resource within a slot.","paragraph_zero_based":1914},{"literal_text_all_w_t_and_m_t":"dl-PRS-MutingOption1","paragraph_zero_based":1915},{"literal_text_all_w_t_and_m_t":"This field specifies the DL-PRS muting configuration of the TRP for the Option-1 muting, as specified in TS 38.214 [45], and comprises the following sub-fields:","paragraph_zero_based":1916},{"literal_text_all_w_t_and_m_t":"-dl-prs-MutingBitRepetitionFactor indicates the number of consecutive instances of the DL-PRS Resource Set corresponding to a single bit of the nr-option1-muting bit map. Enumerated values n1, n2, n4, n8 correspond to 1, 2, 4, 8 consecutive instances, respectively. If this sub-field is absent, the value for dl-prs-MutingBitRepetitionFactor is n1.","paragraph_zero_based":1917},{"literal_text_all_w_t_and_m_t":"-nr-option1-muting defines a bitmap of the time locations where the DL-PRS Resource is transmitted (value '1') or not (value '0') for a DL-PRS Resource Set, as specified in TS 38.214 [45].","paragraph_zero_based":1918},{"literal_text_all_w_t_and_m_t":"If this field is absent, Option-1 muting is not in use for the TRP.","paragraph_zero_based":1919}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["7393bc8b8790bd6a4ea074780673b70374c34954607c770328c443c93e2e0086","2db05284511484697b95bead8f758db0e30e6512963822a722aa919e832283ad","58a5f0373ee50fea613d82004326c53c216d667130089a204c50587593b5aecd","1e0d951c8a2fa7190665f6830882df6d88702890924d28b9fc65ec891f1ed79a","b3e889068eef8240b6b60a362b76d9a1bde590201b828cea9827269850c8820f","ce44fe5eeb7653e45bfded00645f3a647ad9f210de73afb09ccacd4787b694f6","0e923f3f7c147b84daca93ee597f0b5a81ab30bd0aff7c058e4d8e953a21808f","fd0b736c6cc4ff5a816314a20bcc9484b10eafc17d2225f96d8d7f1e5d6eec94","6457d10a996191d56b711e69bd0b4f737eddce34d329bab227b1f06405d25483","d8965e7be7f958876e00d116f8db41e2943fb226bf1bcbdd1e7f260275e7457d","456c9ddee277c4621f7ef698982ff72107e413ac008cedce052fc07aaf7ff064","a72078bbb4177f1396b1aa11ee45685c7799ea20e5e99050ea04ac54a27b4c6e","11cf818577ccd34121c58e09fbb62a933b0d6627afa400c34abe82dbaaf36c91","b2790b8a44d9ba15392c590396e7a5c70244c8374a701b16a16fb0d9829112bc","5655653381cf2245f585558fdcbdb43f05c8ea5435773f0a9ecea09b0296613d","6a3ac435634239ced11d299f1604859dea245d85e26bcccfdc7ff9ab981b02a2","ba03a0d46f8d99a6775bbf617f8fa6ea0ee8493598f382d727f5c4d7f55c98e7","e9d7d33e3ca83e3acea2f1d848200f8748a7642fec76b3c8a4663b8931535890","d98b4fab6654906a317a50f250d24569bc34395de9ebddb651d5cd4668a1422f","915b85d47c04e91c1b153fa8ec689b44208a3e66803409dc9d9c3469c244128e","0be0377215ab086dd1c8ef30b64b3dbc69261fe4854f8f330dd753015a67c6df","549597d6db35eecef36510e8051e414e1cc4ba5cc80df016b83dff43efcc4efb","2ef65afa2e19042697e39d675d91bc3c6128f4d7c0d1cb172d05ff71ad9ccb8f","336ff522a96a33b1d76fa37cc060c1a40c2d09dd7ac7335f1c8780c49c95c0ae"],"paragraph_range_zero_based":[1896,1919],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx:p1896"}
{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"dl-PRS-MutingOption2","paragraph_zero_based":1920},{"literal_text_all_w_t_and_m_t":"This field specifies the DL-PRS muting configuration of the TRP for the Option-2 muting, as specified in TS 38.214 [45], and comprises the following sub-fields:","paragraph_zero_based":1921},{"literal_text_all_w_t_and_m_t":"-nr-option2-muting defines a bitmap of the time locations where the DL-PRS Resource is transmitted (value '1') or not (value '0'). Each bit of the bitmap corresponds to a single repetition of the DL-PRS Resource within an instance of a DL-PRS Resource Set, as specified in TS 38.214 [45]. The size of this bitmap should be the same as the value for dl-PRS-ResourceRepetitionFactor.","paragraph_zero_based":1922},{"literal_text_all_w_t_and_m_t":"If this field is absent, Option-2 muting is not in use for the TRP.","paragraph_zero_based":1923},{"literal_text_all_w_t_and_m_t":"dl-PRS-ResourcePower","paragraph_zero_based":1924},{"literal_text_all_w_t_and_m_t":"This field specifies the average EPRE of the resources elements that carry the PRS in dBm that is used for PRS transmission. The UE assumes constant EPRE is used for all REs of a given DL-PRS resource.","paragraph_zero_based":1925},{"literal_text_all_w_t_and_m_t":"dl-PRS-SequenceID","paragraph_zero_based":1926},{"literal_text_all_w_t_and_m_t":"This field specifies the sequence Id used to initialize cinit value used in pseudo random generator TS 38.211 [41], clause 5.2.1 for generation of DL-PRS sequence for transmission on a given DL-PRS Resource.","paragraph_zero_based":1927},{"literal_text_all_w_t_and_m_t":"dl-PRS-CombSizeN-AndReOffset","paragraph_zero_based":1928},{"literal_text_all_w_t_and_m_t":"This field specifies the Resource Element spacing in each symbol of the DL-PRS Resource and the Resource Element (RE) offset in the frequency domain for the first symbol in a DL-PRS Resource. All DL-PRS Resource Sets belonging to the same Positioning Frequency Layer have the same value of comb size. The relative RE offsets of following symbols are defined relative to the RE Offset in the frequency domain of the first symbol in the DL-PRS Resource according to TS 38.211 [41]. The comb size configuration should be aligned with the comb size configuration for the frequency layer.","paragraph_zero_based":1929},{"literal_text_all_w_t_and_m_t":"dl-PRS-ResourceSlotOffset","paragraph_zero_based":1930},{"literal_text_all_w_t_and_m_t":"This field specifies the starting slot of the DL-PRS Resource with respect to the corresponding DL-PRS-Resource Set Slot Offset.","paragraph_zero_based":1931},{"literal_text_all_w_t_and_m_t":"dl-PRS-ResourceSymbolOffset","paragraph_zero_based":1932},{"literal_text_all_w_t_and_m_t":"This field specifies the starting symbol of the DL-PRS Resource within a slot determined by dl-PRS-ResourceSlotOffset.","paragraph_zero_based":1933},{"literal_text_all_w_t_and_m_t":"dl-PRS-QCL-Info","paragraph_zero_based":1934},{"literal_text_all_w_t_and_m_t":"This field specifies the QCL indication with other DL reference signals for serving and neighbouring cells and comprises the following subfields:","paragraph_zero_based":1935},{"literal_text_all_w_t_and_m_t":"-ssb indicates the SSB information for QCL source and comprises the following sub-fields:","paragraph_zero_based":1936},{"literal_text_all_w_t_and_m_t":"-pci specifies the physical cell ID of the cell with the SSB that is configured as the source reference signal for the DL-PRS. The UE obtains the SSB configuration for the SSB configured as source reference signal for the DL-PRS by indexing to the field nr-SSB-Config with this physical cell identity.","paragraph_zero_based":1937},{"literal_text_all_w_t_and_m_t":"-ssb-Index indicates the index for the SSB configured as the source reference signal for the DL-PRS.","paragraph_zero_based":1938},{"literal_text_all_w_t_and_m_t":"-rs-Type indicates the QCL type.","paragraph_zero_based":1939},{"literal_text_all_w_t_and_m_t":"-dl-PRS indicates the PRS information for QCL source reference signal and comprises the followings sub-fields:","paragraph_zero_based":1940},{"literal_text_all_w_t_and_m_t":"-qcl-DL-PRS-ResourceID specifies DL-PRS Resource ID of the DL-PRS resource used as the source reference signal.","paragraph_zero_based":1941},{"literal_text_all_w_t_and_m_t":"-qcl-DL-PRS-ResourceSetID indicates the DL-PRS Resource Set ID of the DL-PRS Resource Set used as the source reference signal.","paragraph_zero_based":1942},{"literal_text_all_w_t_and_m_t":"dl-PRS-ResourcePrioritySubset","paragraph_zero_based":1943}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["2cf7af5682d7b75d5f885b999069beedd53631bc8b4cfae95f8e2225c2e83af8","1b64ce46de455456fd49d46cde0b57420a49fab102a8904383c130b36779f477","7bd2b44fe66961c6ad2cb20f25707f517c6c624f5f4616c3c6ec4bb3651821f9","925b14c12477ca313d59bf713fe5c0840ae1e32d66691f9bb9119bcb8f5b5a36","f24207b045d8d061a4f1ac9217d11e1afccb90fc52627c5cc651eb0b742b4135","865770ed7a0282648742f8070802f49eab67e482e7ddd65d7a52639ac8bbca35","52fcfee4e6d356d3035c79d8da60e9de374831891a73b327da59ad0a8a74de6c","3a0e1ff6d3a3f6d85dfe514c39294728f79589751e3f218b092fcd80789acc88","b4f89e443202d97ec5989dcf4693331bf94f1a9207023647b93815861f42b68d","0b6cc21e155cc99ed86c7be3fd18fcddd19ae14fcff5cac13ace23f7f0c77ac4","cd7367d25566c6d5be35b5d36cbe78248c78749da2143c12fe7e41b4d867bb40","a49cb1988867fa8aa937d8c5a892ab65af379755f7501ce6a0f16f2f0d71363b","e7a21c9ba13135975966e1b51e16659b5ab6dfb0fb529e1ded780db241398cd9","d8b798334d3d628676816eb838f50793113ceb189dc93516d3c4ca75f1b28a3e","c56d153fa71b44c439c693a5fb03d6d8a19fd16f831dd3e52b35df1232d0f3ac","bf349954571c6f1dcf152b06df01e9c99b920c52f840f03e72d7a6e543f10a34","cdf0d065569751a0253b36ce70404e5a513de9ccbc2aed1c360b02b868fa5fba","618939fb8fb7ed7d2355efcf087fe49f2862cb954de80f354de1f32c0f361791","fef887ba4dc290479d4459a4bd105622ce83884cabf1e65aaeb5d100ea0fadb1","10e802c785dc3abe7ce4cb045155fe29513f9ad77d9c7adcc6552640e1b1a152","b3d492c495416d2f3418a92eb63fd340cb9856880dcb9374f8f1783859d3a0d5","be397b934bf7669a37d51a4f203d363f6a6c6600702393a2603df9369508548f","1e0e91954ae6d820e2c6ac55307fd871fb52b97bd2062c606f180a0c1031d591","fa4239cdca2fa0d52236f12663dba1c01b51d76352ca615463e0ac00c3b88322"],"paragraph_range_zero_based":[1920,1943],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx:p1920"}
{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field provides a subset of DL-PRS Resources, which is associated with nr-DL-PRS-ResourceID for the purpose of prioritization of DL-AoD reporting, as specified in TS 38.214 [45].","paragraph_zero_based":1944},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1945},{"literal_text_all_w_t_and_m_t":"NOTE: This field is only applicable to DL-AoD positioning method and should be ignored for DL-TDOA and Multi-RTT positioning.","paragraph_zero_based":1946},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1947},{"literal_text_all_w_t_and_m_t":"–NR-DL-PRS-ProcessingCapability","paragraph_zero_based":1948},{"literal_text_all_w_t_and_m_t":"The IE NR-DL-PRS-ProcessingCapability defines the common DL-PRS Processing capability. In the case of capabilities for multiple NR positioning methods are provided, the IE NR-DL-PRS-ProcessingCapability applies across the NR positioning methods and the target device shall indicate the same values for the capabilities in IEs NR-DL-TDOA-ProvideCapabilities, NR-DL-AoD-ProvideCapabilities, and NR-Multi-RTT-ProvideCapabilities.","paragraph_zero_based":1949},{"literal_text_all_w_t_and_m_t":"The PRS-ProcessingCapabilityPerBand is defined for a single positioning frequency layer on a certain band (i.e., a target device supporting multiple positioning frequency layers is expected to process one frequency layer at a time).","paragraph_zero_based":1950},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":1951},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1952},{"literal_text_all_w_t_and_m_t":"NR-DL-PRS-ProcessingCapability-r16 ::= SEQUENCE {","paragraph_zero_based":1953},{"literal_text_all_w_t_and_m_t":"prs-ProcessingCapabilityBandList-r16SEQUENCE (SIZE (1..nrMaxBands-r16)) OF","paragraph_ze