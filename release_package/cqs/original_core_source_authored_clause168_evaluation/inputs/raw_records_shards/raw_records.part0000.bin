{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Absolute uplink frequency configuration and subcarrier specific virtual carriers.","paragraph_zero_based":30216},{"literal_text_all_w_t_and_m_t":"InitialUplinkBWP","paragraph_zero_based":30217},{"literal_text_all_w_t_and_m_t":"The initial uplink BWP configuration for a PCell (see TS 38.213 [13], clause 12).","paragraph_zero_based":30218},{"literal_text_all_w_t_and_m_t":"initialUplinkBWP-RedCap","paragraph_zero_based":30219},{"literal_text_all_w_t_and_m_t":"If present, RedCap UEs use this UL BWP instead of initialUplinkBWP.","paragraph_zero_based":30220},{"literal_text_all_w_t_and_m_t":"If absent, RedCap UEs use initialUplinkBWP provided that it does not exceed the RedCap UE maximum bandwidth (see also clause 5.2.2.4.2).","paragraph_zero_based":30221},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30222},{"literal_text_all_w_t_and_m_t":"–Uplink-PowerControl","paragraph_zero_based":30223},{"literal_text_all_w_t_and_m_t":"The IE Uplink-PowerControl is used to configure UE specific power control parameter for PUSCH, PUCCH and SRS.","paragraph_zero_based":30224},{"literal_text_all_w_t_and_m_t":"Uplink-PowerControl information element","paragraph_zero_based":30225},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":30226},{"literal_text_all_w_t_and_m_t":"-- TAG-UPLINK-POWERCONTROL-START","paragraph_zero_based":30227},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30228},{"literal_text_all_w_t_and_m_t":"Uplink-powerControl-r17  ::= SEQUENCE {","paragraph_zero_based":30229},{"literal_text_all_w_t_and_m_t":"    ul-powercontrolId-r17        Uplink-powerControlId-r17,","paragraph_zero_based":30230},{"literal_text_all_w_t_and_m_t":"    p0AlphaSetforPUSCH-r17       P0AlphaSet-r17                                                               OPTIONAL, -- Need R","paragraph_zero_based":30231},{"literal_text_all_w_t_and_m_t":"    p0AlphaSetforPUCCH-r17       P0AlphaSet-r17                                                               OPTIONAL, -- Need R","paragraph_zero_based":30232},{"literal_text_all_w_t_and_m_t":"    p0AlphaSetforSRS-r17         P0AlphaSet-r17                                                               OPTIONAL  -- Need R","paragraph_zero_based":30233},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30234},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30235},{"literal_text_all_w_t_and_m_t":"P0AlphaSet-r17 ::=           SEQUENCE {","paragraph_zero_based":30236},{"literal_text_all_w_t_and_m_t":"    p0-r17                       INTEGER (-16..15)                                                            OPTIONAL, -- Need R","paragraph_zero_based":30237},{"literal_text_all_w_t_and_m_t":"    alpha-r17                    Alpha                                                                        OPTIONAL, -- Need S","paragraph_zero_based":30238},{"literal_text_all_w_t_and_m_t":"    closedLoopIndex-r17          ENUMERATED { i0, i1 }","paragraph_zero_based":30239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["f6bb3a5299a88deb844a0b0d7a1867c28e079771b9fb7a78a1cf780aee608f3f","8c943a63f7b96c426b88852e6afad8db99ef6ab1279971305c614b415cd556a9","2b09cd61da0a70be1425f090ea856a545b6ce275bd382abc1a5f2687c08b5633","5c4d293534a119e87914a20db37fb27024b6e30698b5a8636259d30387912efb","b944278db9b4496ae19709c9fbe11be137f31da80c381a96450bb2b6b8a9334e","83f824ecf46ad4f7d4c0949a931904b27a8c4f8676fb6f64928ed44bf1666595","016bd8c6de09a709576472e245cee275723bbf3eb211fd32b46626