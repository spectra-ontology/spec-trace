{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Positioning related information and measurements.","paragraph_zero_based":20568},{"literal_text_all_w_t_and_m_t":"physCellId","paragraph_zero_based":20569},{"literal_text_all_w_t_and_m_t":"The physical cell identity of the NR cell for which the reporting is being performed.","paragraph_zero_based":20570},{"literal_text_all_w_t_and_m_t":"resultsSSB-Cell","paragraph_zero_based":20571},{"literal_text_all_w_t_and_m_t":"Cell level measurement results based on SS/PBCH related measurements.","paragraph_zero_based":20572},{"literal_text_all_w_t_and_m_t":"resultsSSB-Indexes","paragraph_zero_based":20573},{"literal_text_all_w_t_and_m_t":"Beam level measurement results based on SS/PBCH related measurements.","paragraph_zero_based":20574},{"literal_text_all_w_t_and_m_t":"resultsCSI-RS-Cell","paragraph_zero_based":20575},{"literal_text_all_w_t_and_m_t":"Cell level measurement results based on CSI-RS related measurements.","paragraph_zero_based":20576},{"literal_text_all_w_t_and_m_t":"resultsCSI-RS-Indexes","paragraph_zero_based":20577},{"literal_text_all_w_t_and_m_t":"Beam level measurement results based on CSI-RS related measurements.","paragraph_zero_based":20578},{"literal_text_all_w_t_and_m_t":"rsIndexResults","paragraph_zero_based":20579},{"literal_text_all_w_t_and_m_t":"Beam level measurement results.","paragraph_zero_based":20580},{"literal_text_all_w_t_and_m_t":"timeBetweenEvents","paragraph_zero_based":20581},{"literal_text_all_w_t_and_m_t":"Indicates the time elapsed between fulfilling the conditional execution conditions included in choConfig. Value in milliseconds. The maximum value 1023 means 1023ms or longer. This field may be included only in the reports associated to UEInformationResponse message, e.g., rlf-Report.","paragraph_zero_based":20582},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20583},{"literal_text_all_w_t_and_m_t":"MeasResultUTRA-FDD field descriptions","paragraph_zero_based":20584},{"literal_text_all_w_t_and_m_t":"physCellId","paragraph_zero_based":20585},{"literal_text_all_w_t_and_m_t":"The physical cell identity of the UTRA-FDD cell for which the reporting is being performed.","paragraph_zero_based":20586},{"literal_text_all_w_t_and_m_t":"utra-FDD-EcN0","paragraph_zero_based":20587},{"literal_text_all_w_t_and_m_t":"According to CPICH_Ec/No in TS 25.133 [46] for FDD.","paragraph_zero_based":20588},{"literal_text_all_w_t_and_m_t":"utra-FDD-RSCP","paragraph_zero_based":20589},{"literal_text_all_w_t_and_m_t":"According to CPICH_RSCP in TS 25.133 [46] for FDD.","paragraph_zero_based":20590},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20591}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["77449f3492e16898f9915b7d3e6c56768c47574b2befbe3660d94568cda475ad","47022c16daced8da16bd6d3fb5290fd26b860ddd2945e4307fb9b3e2443b440f","eec74cbf404bce7058876f84bb8f956a2bfbafa3523a8dd55b866d2d94624f17","ce50a643764a975fdd22a822c3601a1b9bf9f2c4c3365d89f8a55bfd0cdc783a","dbe806d4a29765a40830562501967bdf056567bd6df5bb2db7251f7ec25de378","e00a28c9670073a366d136eaac893cd1ec8dd9099fd411ec3e2b6af6267f5d4a","65a6d62d100fe90635cd50495ce3459c3604f88e0ea15fd6b4e1ffbd23257dbf","3cf1a4c60c9d5b9a7330e83cc3917789a5420efbe29022057cfcdfd23083f2a6","c80d7a3cc8f1b6f42905be7fd459417eb1322185b266be4f114072aaca7f87e7","130d029868084e5e8824534dedbbbd73bc9cdc6fe50e1b1617737954268451ab","4558a1cda99aea18b8af246b4334808693e836b80bb82aae0e8ec5c5cc61feb0","1d8af913b91514fc6e42a4d666617020a5ae778fdcfc613d95a856f29e433db1","98c5d10b9618a7a6948ae0f8943de52ebda94c48668a848ba087ce6d5838f0f7","657ddd7ccdaeea5e5b29eed25ebce40471a00f2c9d1688d86af555c9dfe6cae4","87ae9d723ba7a42b33b8b7071bca9fada1400d8736d026441f366308a43fb423","d44012df94bafea639a66e347e10b6773155aa75fdb83091b8e38b31f6d0eba3","90723f9b2beed9f88fc2d9cd5164c235b0b3825e72470aac7a103eb2d105160c","673d972c0ac64e967075b31dc83a64d4c28c413fbdf7114564a4b0e73690481d","f9a83efad899a1b5ad3462b29de2ffa8feee81f395ead714aeab8359a44e9c8e","2211bf8a1e37e259cf8d0d50fd2aedc04fee51b67a1c4419c3e2e177af6c7e94","f648b45ad9de6dacedd3c289d3bb67d60141401277593217683921dcd3b91375","ff4b3695c4f0dd680b74b68e0999b6af40b7563804f0f91642e54f561d5b4d20","fe57d994fca5ca85f78a1c159fcaf0c3946b1ca1df112f24273dc07f0ddc228c","84dd48617c0e0a2d3efe6161af27b55f673049df0d854232617d478777e11ed7"],"paragraph_range_zero_based":[20568,20591],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p20568"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"MeasResults field descriptions","paragraph_zero_based":20592},{"literal_text_all_w_t_and_m_t":"coarseLocationInfo","paragraph_zero_based":20593},{"literal_text_all_w_t_and_m_t":"This field indicates the coarse location information reported by the UE. This field is coded as the Ellipsoid-Point defined in TS 37.355 [49]. The first/leftmost bit of the first octet contains the most significant bit. The least significant bits of degreesLatitude and degreesLongitude are set to 0 to meet the accuracy requirement corresponds to a granularity of approximately 2 km.","paragraph_zero_based":20594},{"literal_text_all_w_t_and_m_t":"It is up to UE implementation how many LSBs are set to 0 to meet the accuracy requirement","paragraph_zero_based":20595},{"literal_text_all_w_t_and_m_t":"excessDelay","paragraph_zero_based":20596},{"literal_text_all_w_t_and_m_t":"Indicates the ratio of packets in UL per DRB exceeding the configured delay threshold among the UL PDCP SDUs, according to the UL PDCP Excess Packet Delay per DRB mapping table, as defined in TS 38.314 [53], Table 4.3.1.e-1.","paragraph_zero_based":20597},{"literal_text_all_w_t_and_m_t":"measId","paragraph_zero_based":20598},{"literal_text_all_w_t_and_m_t":"Identifies the measurement identity for which the reporting is being performed.","paragraph_zero_based":20599},{"literal_text_all_w_t_and_m_t":"measQuantityResults","paragraph_zero_based":20600},{"literal_text_all_w_t_and_m_t":"The value sinr is not included when it is used for LogMeasReport-r16.","paragraph_zero_based":20601},{"literal_text_all_w_t_and_m_t":"measResultCellListSFTD-NR","paragraph_zero_based":20602},{"literal_text_all_w_t_and_m_t":"SFTD measurement results between the PCell and the NR neighbour cell(s) in NR standalone.","paragraph_zero_based":20603},{"literal_text_all_w_t_and_m_t":"measResultCLI","paragraph_zero_based":20604},{"literal_text_all_w_t_and_m_t":"CLI measurement results.","paragraph_zero_based":20605},{"literal_text_all_w_t_and_m_t":"measResultEUTRA","paragraph_zero_based":20606},{"literal_text_all_w_t_and_m_t":"Measured results of an E-UTRA cell.","paragraph_zero_based":20607},{"literal_text_all_w_t_and_m_t":"measResultForRSSI","paragraph_zero_based":20608},{"literal_text_all_w_t_and_m_t":"Includes measured RSSI result in dBm (see TS 38.215 [9]) and channelOccupancy which is the percentage of samples when the RSSI was above the configured channelOccupancyThreshold for the associated reportConfig.","paragraph_zero_based":20609},{"literal_text_all_w_t_and_m_t":"measResultListEUTRA","paragraph_zero_based":20610},{"literal_text_all_w_t_and_m_t":"List of measured results for the maximum number of reported best cells for an E-UTRA measurement identity.","paragraph_zero_based":20611},{"literal_text_all_w_t_and_m_t":"measResultListNR","paragraph_zero_based":20612},{"literal_text_all_w_t_and_m_t":"List of measured results for the maximum number of reported best cells for an NR measurement identity.","paragraph_zero_based":20613},{"literal_text_all_w_t_and_m_t":"measResultListUTRA-FDD","paragraph_zero_based":20614},{"literal_text_all_w_t_and_m_t":"List of measured results for the maximum number of reported best cells for a UTRA-FDD measurement identity.","paragraph_zero_based":20615}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["f31990ac99c52465ff85c9094670b1f9bd00f9518e4c11964291526a19893b87","d8311e9a29f1558e2c6953f2541ee7288c730d63af06ddd1912d106ade19362c","dca1d10d752763c53350c2e0e08f4a0e107ff01fa6936c