{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"rb-SetGroups","paragraph_zero_based":14616},{"literal_text_all_w_t_and_m_t":"Indicates the RB set groups configured for the availability combination. Each group includes consecutive RB sets.","paragraph_zero_based":14617},{"literal_text_all_w_t_and_m_t":"rb-Sets","paragraph_zero_based":14618},{"literal_text_all_w_t_and_m_t":"Indicates the one or more RB set indexes associated to one or more RB sets configured for one RB set group.","paragraph_zero_based":14619},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14620},{"literal_text_all_w_t_and_m_t":"–AvailabilityIndicator","paragraph_zero_based":14621},{"literal_text_all_w_t_and_m_t":"The IE AvailabilityIndicator is used to configure monitoring a PDCCH for Availability Indicators (AI).","paragraph_zero_based":14622},{"literal_text_all_w_t_and_m_t":"AvailabilityIndicator information element","paragraph_zero_based":14623},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":14624},{"literal_text_all_w_t_and_m_t":"-- TAG-AVAILABILITYINDICATOR-START","paragraph_zero_based":14625},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14626},{"literal_text_all_w_t_and_m_t":"AvailabilityIndicator-r16 ::=    SEQUENCE {","paragraph_zero_based":14627},{"literal_text_all_w_t_and_m_t":"    ai-RNTI-r16                      AI-RNTI-r16,","paragraph_zero_based":14628},{"literal_text_all_w_t_and_m_t":"    dci-PayloadSizeAI-r16            INTEGER (1..maxAI-DCI-PayloadSize-r16),","paragraph_zero_based":14629},{"literal_text_all_w_t_and_m_t":"    availableCombToAddModList-r16    SEQUENCE (SIZE(1..maxNrofDUCells-r16)) OF AvailabilityCombinationsPerCell-r16          OPTIONAL, -- Need N","paragraph_zero_based":14630},{"literal_text_all_w_t_and_m_t":"    availableCombToReleaseList-r16   SEQUENCE (SIZE(1..maxNrofDUCells-r16)) OF AvailabilityCombinationsPerCellIndex-r16     OPTIONAL, -- Need N","paragraph_zero_based":14631},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":14632},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14633},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14634},{"literal_text_all_w_t_and_m_t":"AI-RNTI-r16 ::=                      RNTI-Value","paragraph_zero_based":14635},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14636},{"literal_text_all_w_t_and_m_t":"-- TAG-AVAILABILITYINDICATOR-STOP","paragraph_zero_based":14637},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":14638},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14639}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["63fff48ede778e70c80c1c574b5639b64d869bdd1f7468adbfbbca04bb13fac9","44bdd55e26f19e6aba492f844e0fa69f59de596c094e9775bc6c2fd5d5d5bfd9","e2e1b3b25dac5df60f3fdc1a5a3fa9682265b14c6b84f69a16a12a53cf4f7fd5","bbf85f432473d18711e4ff7ed350156d8acd53128933c1f53e23d566e7b09705","164a3c456d52088ea69452f98880ccbdf6d65b4da3604d9f10db9dd752e8ea31","2c12a8f26c42e329dddaa3cd5027230a875cf58a01daa88ac038b70f00284ba3","283c63e246fc1b7501735d2d7d2eec2752043d123f47b565c759bfe8ef70ef98","bbc76d38b49aabe1a75c03a33fea71f38593be419d9b01a370e6001d78711faa","a8006a931e9a5f93de1b0f7165d5ae9c9d8a8cefc55531ae2ec90d6d0dfcb7ed","d4e09342ae82f8b840e1330241701dc2bb7d0807e692176bc0f6895b5dd8f021","95bae6b14571718a0f2c78782cd936658fb7b7b98f6ec5bb55684a65227e6a56","af7735dd586818c6d75087dfd14f8f4a70d25b56b33d0d2c895b70e9c4199400","37916237da757697ee8e2ed3962bb126ced17ee593ac8815c6621f7706f888ef","1d8ef1f2bd8bbc96944201ec65ee3522db9