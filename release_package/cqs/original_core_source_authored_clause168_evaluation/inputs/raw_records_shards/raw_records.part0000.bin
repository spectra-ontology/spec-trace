{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>for this measurement, consider the NR serving cell corresponding to the associated measObjectNR associated with this event.","paragraph_zero_based":4896},{"literal_text_all_w_t_and_m_t":"Inequality A1-1 (Entering condition)","paragraph_zero_based":4897},{"literal_text_all_w_t_and_m_t":"Ms – Hys > Thresh","paragraph_zero_based":4898},{"literal_text_all_w_t_and_m_t":"Inequality A1-2 (Leaving condition)","paragraph_zero_based":4899},{"literal_text_all_w_t_and_m_t":"Ms + Hys < Thresh","paragraph_zero_based":4900},{"literal_text_all_w_t_and_m_t":"The variables in the formula are defined as follows:","paragraph_zero_based":4901},{"literal_text_all_w_t_and_m_t":"Ms is the measurement result of the serving cell, not taking into account any offsets.","paragraph_zero_based":4902},{"literal_text_all_w_t_and_m_t":"Hys is the hysteresis parameter for this event (i.e. hysteresis as defined within reportConfigNR for this event).","paragraph_zero_based":4903},{"literal_text_all_w_t_and_m_t":"Thresh is the threshold parameter for this event (i.e. a1-Threshold as defined within reportConfigNR for this event).","paragraph_zero_based":4904},{"literal_text_all_w_t_and_m_t":"Ms is expressed in dBm in case of RSRP, or in dB in case of RSRQ and RS-SINR.","paragraph_zero_based":4905},{"literal_text_all_w_t_and_m_t":"Hys is expressed in dB.","paragraph_zero_based":4906},{"literal_text_all_w_t_and_m_t":"Thresh is expressed in the same unit as Ms.","paragraph_zero_based":4907},{"literal_text_all_w_t_and_m_t":"5.5.4.3Event A2 (Serving becomes worse than threshold)","paragraph_zero_based":4908},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":4909},{"literal_text_all_w_t_and_m_t":"1>consider the entering condition for this event to be satisfied when condition A2-1, as specified below, is fulfilled;","paragraph_zero_based":4910},{"literal_text_all_w_t_and_m_t":"1>consider the leaving condition for this event to be satisfied when condition A2-2, as specified below, is fulfilled;","paragraph_zero_based":4911},{"literal_text_all_w_t_and_m_t":"1>for this measurement, consider the serving cell indicated by the measObjectNR associated to this event.","paragraph_zero_based":4912},{"literal_text_all_w_t_and_m_t":"Inequality A2-1 (Entering condition)","paragraph_zero_based":4913},{"literal_text_all_w_t_and_m_t":"Ms + Hys < Thresh","paragraph_zero_based":4914},{"literal_text_all_w_t_and_m_t":"Inequality A2-2 (Leaving condition)","paragraph_zero_based":4915},{"literal_text_all_w_t_and_m_t":"Ms – Hys > Thresh","paragraph_zero_based":4916},{"literal_text_all_w_t_and_m_t":"The variables in the formula are defined as follows:","paragraph_zero_based":4917},{"literal_text_all_w_t_and_m_t":"Ms is the measurement result of the serving cell, not taking into account any offsets.","paragraph_zero_based":4918},{"literal_text_all_w_t_and_m_t":"Hys is the hysteresis parameter for this event (i.e. hysteresis as defined within reportConfigNR for this event).","paragraph_zero_based":4919}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["418bc59f7e03b55ec3acebbba2f6f442b31f9f6ae6bae80712f41af0be23d9a2","0a070ffe948994f5c89052c9ab9a8ff13367c650c8bb6f312331908c37cd6b0a","71b6d386e8aaa58d772bd5052f57857f513ff9713a4314ccb5ce49f10fec35a6","adffd34c7a9673102cf484c5ea4972c4f4972af4570cbd549932727fbf7be37b","c2f7504990fa808628ef68e95da10aeb2a52ae6c016a1da3d1199b6dc0b2943d","7f540e808140f7e5578c64628003c2127f8d531cc44ee5a40c965f8a3cec01d2","a8bf1ffb0733afa83c42e537f2711958e85f836cf6afc6bec736279739f8cf10","da12f4249584ce5c17833f1e1a2a0a397a24ed3a81acaae3ed47bd7f8bc3146b","a9e6d2707d0187d325f32126ba51986c363b7b0e5ffd5012989fe11633c69345","3364df6dad1d2ae313f012350afab11103702103c36def1a63bd7cd050c18a62","cee39c918a7a37ab65dd8bfaf51bbd6931108f1ffff0236e70087dd4c672e96c","53c3c87c05a113504830194d4bf6f05c61a788637a736a82478daa1435bff5c0","6769709131bd1e0d9d6c9b09d32ce9bc034f2237b52d41c781a31ca7a78b74e5","7751b0da572c70a1b6c7ee3ca6b53847169128c5176c094deaa701a3ed888953","a7a8ca6a80a6da7045c0e6222b2c1bb1b93ff05bee452b2ad0978a4ef643cce8","e2456f643594451eb88dc4a5312ccb440806fb7982857af0ae9b6af0f17d34fc","7c755a17e7d14ed7e2e1aa3f8eb4929a1866fa9a86eb9817654993902a36de36","0dfe20164619773965454f95964a657d89a76ab1952d6ede0a4271afc03e5974","019f667bc6360194f40ebaf02bac0ee76dd84a808e9934578d75fdea40560b76","53981410d606648604b36edde3576f2831b231bbcd041cb1badf0abb95ed0836","3ea4da2f0adba842a8173b729b860abebaa4d2a2640f2081beac745cc78a4e2d","ffa4a462d9b54d15ec89936eae9e7c411f051af12d8314c6070a32ef775fa6ed","a2702d23319e72b038781d7fe5eeb8c1dda8daf5fdf41356c38718ac790ea11f","790d0de3bafa5d368dd6221b4039009a887cc1add05d2ab66aab38a981bc94e3"],"paragraph_range_zero_based":[4896,4919],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p4896"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Thresh is the threshold parameter for this event (i.e. a2-Threshold as defined within reportConfigNR for this event).","paragraph_zero_based":4920},{"literal_text_all_w_t_and_m_t":"Ms is expressed in dBm in case of RSRP, or in dB in case of RSRQ and RS-SINR.","paragraph_zero_based":4921},{"literal_text_all_w_t_and_m_t":"Hys is expressed in dB.","paragraph_zero_based":4922},{"literal_text_all_w_t_and_m_t":"Thresh is expressed in the same unit as Ms.","paragraph_zero_based":4923},{"literal_text_all_w_t_and_m_t":"5.5.4.4Event A3 (Neighbour becomes offset better than SpCell)","paragraph_zero_based":4924},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":4925},{"literal_text_all_w_t_and_m_t":"1>consider the entering condition for this event to be satisfied when condition A3-1, as specified below, is fulfilled;","paragraph_zero_based":4926},{"literal_text_all_w_t_and_m_t":"1>consider the leaving condition for this event to be satisfied when condition A3-2, as specified below, is fulfilled;","paragraph_zero_based":4927},{"literal_text_all_w_t_and_m_t":"1>use the SpCell for Mp, Ofp and Ocp.","paragraph_zero_based":4928},{"literal_text_all_w_t_and_m_t":"NOTE 1:The cell(s) that triggers the event has reference signals indicated in the measObjectNR associated to this event which may be different from the NR SpCell measObjectNR.","paragraph_zero_based":4929},{"literal_text_all_w_t_and_m_t":"Inequality A3-1 (Entering condition)","paragraph_zero_based":4930},{"literal_text_all_w_t_and_m_t":"Mn + Ofn + Ocn – Hys > Mp + Ofp + Ocp + Off","paragraph_zero_based":4931},{"literal_text_all_w_t_and_m_t":"Inequality A3-2 (Leaving condition)","paragraph_zero_based":4932},{"literal_text_all_w_t_and_m_t":"Mn + Ofn + Ocn + Hys < Mp + Ofp + Ocp + Off","paragraph_zero_based":4933},{"literal_text_all_w_t_and_m_t":"The variables in the formula are defined as follows:","paragraph_zero_based":4934},{"literal_text_all_w_t_and_m_t":"Mn is the measurement result of the neighbouring cell, not taking into account any offsets.","paragraph_zero_based":4935},{"literal_text_all_w_t_and_m_t":"Ofn is the measurement object specific offset of the reference signal of the neighbour cell (i.e. offsetMO as defined within measObjectNR corresponding to the neighbour cell).","paragraph_zero_based":4936},{"literal_text_all_w_t_and_m_t":"Ocn is the cell specific offset of the neighbour cell (i.e. cellIndividualOffset as defined within measObjectNR corresponding to the frequency of the neighbour cell), and set to zero if not configured for the neighbour cell.","paragraph_zero_based":4937},{"literal_text_all_w_t_and_m_t":"Mp is the measurement result of the SpCell, not taking into account any offsets.","paragraph_zero_based":4938},{"literal_text_all_w_t_and_m_t":"Ofp is the measurement object specific offset of the SpCell (i.e. offsetMO as defined within measObjectNR corresponding to the SpCell).","paragraph_zero_based":4939},{"literal_text_all_w_t_and_m_t":"Ocp is the cell specific offset of the SpCell (i.e. cellIndividualOffset as defined within measObjectNR corresponding to the SpCell), and is set to zero if not configured for the SpCell.","paragraph_zero_based":4940},{"literal_text_all_w_t_and_m_t":"Hys is the hysteresis parameter for this event (i.e. hysteresis as defined within reportConfigNR for this event).","paragraph_zero_based":4941},{"literal_text_all_w_t_and_m_t":"Off is the offset parameter for this event (i.e. a3-Offset as defined within reportConfigNR for this event).","paragraph_zero_based":4942},{"literal_text_all_w_t_and_m_t":"Mn, Mp are expressed in dBm in case of RSRP, or in dB in case of RSRQ and RS-SINR.","paragraph_zero_based":4943}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["5048b17b0ab8d38e6585b6a7d82a5619ef38073749cd4fc631888d4d9d30d3f2","cd4684a7795fc42cc7bfd6ffd74e4fad78e198e40dfb871a0aaf5a793b6e9570","7c8b8077003a130c5fbf65d704bf1ed910112368053d4f67a08280f5c4b643ac","af6a62640a21aacf33afa7b8600b03c17d6df563b11114dc2f3585d3fcbc1899","587819f903cc76bff69f72fd19d1b995d481e2d8beb6f6f77737e7cdc73b1336","26be1e9835da801d31acaa6099c9774e91ce67d0b1ddf9ee430d8e1e2b19aa0e","cd76a341b8ee41220504f7951686ca13a8a0ddf9c34e2a93253a921c0ec2f3f7","f71f3c6a859fe3a6addc975ff8146e26145342e0bb9b38f06b963c9f9e8e25ad","0cb2894fd71c008e15f7d7c30e32c1fa7c646562f6d22a9b84d87ffa1b6d6d9d","0723c126a3ee5f2c40f0b6feb972692c86e1ce2410bcce1157b09de946bfc704","08b513b34ed440c4c9765692f3823bfa1de08748d038b22880d7adc50076b0f2","c822eb46a613c18eecfb859450c78ea0a2100ae6d7d99a4ff48ebd746bfa7800","eed58971719ff6570c60bcb3119fff0d45144f2c255209129331961a83474b69","6db37c6a935e51c85201ed3d8d8e2f64cfef3647e87087248a85a0a5a9197156","05fd829d4928816360266df02774b0e3358e1db01389bc25930fece7d0d4d7b2","5c192263d23253d1cc9c82cee15bad9de95d7e36117f2993192a9d9904260bcb","73bc5e1981704c3579c620648b8ca204b5e0cad79c8d1678446a7565550cbb3c","31a3fc1c3d232fb3ca2f4924e194a44219cb8f9e0efc96cf11fb6bcd700df4c3","59bbc86398a31a6544a2b6f559d51235cc64e3b3deb84a0505df12ed8d2ff1b7","32fd579fb95c18a619b08a066ca334cee3597702312c46ffa810602271864f13","d9a30d010b7afa74ce56c26eeef43c51eef0da6817505adf8c72e68375278dae","c6284568d8ba0e1379d70973487e6d6088a46c0fcc57bada969ac15c76f5dc4e","f5b33f63a804194164b8b7afcdaded4d86e9f2b521549f70f361d6838f55c93c","49bbff523f1cfdd69faef8f878e6b1a295816a27a1d82670329bec75fd262d2b"],"paragraph_range_zero_based":[4920,4943],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p4920"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Ofn, Ocn, Ofp, Ocp, Hys, Off are expressed in dB.","paragraph_zero_based":4944},{"literal_text_all_w_t_and_m_t":"NOTE 2:The definition of Event A3 also applies to CondEvent A3.","paragraph_zero_based":4945},{"literal_text_all_w_t_and_m_t":"5.5.4.5Event A4 (Neighbour becomes better than threshold)","paragraph_zero_based":4946},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":4947},{"literal_text_all_w_t_and_m_t":"1>consider the entering condition for this event to be satisfied when condition A4-1, as specified below, is fulfilled;","paragraph_zero_based":4948},{"literal_text_all_w_t_and_m_t":"1>consider the leaving condition for this event to be satisfied when condition A4-2, as specified below, is fulfilled.","paragraph_zero_based":4949},{"literal_text_all_w_t_and_m_t":"Inequality A4-1 (Entering condition)","paragraph_zero_based":4950},{"literal_text_all_w_t_and_m_t":"Mn + Ofn + Ocn – Hys > Thresh","paragraph_zero_based":4951},{"literal_text_all_w_t_and_m_t":"Inequality A4-2 (Leaving condition)","paragraph_zero_based":4952},{"literal_text_all_w_t_and_m_t":"Mn + Ofn + Ocn + Hys < Thresh","paragraph_zero_based":4953},{"literal_text_all_w_t_and_m_t":"The variables in the formula are defined as follows:","paragraph_zero_based":4954},{"literal_text_all_w_t_and_m_t":"Mn is the measurement result of the neighbouring cell, not taking into account any offsets.","paragraph_zero_based":4955},{"literal_text_all_w_t_and_m_t":"Ofn is the measurement object specific offset of the neighbour cell (i.e. offsetMO as defined within measObjectNR corresponding to the neighbour cell).","paragraph_zero_based":4956},{"literal_text_all_w_t_and_m_t":"Ocn is the measurement object specific offset of the neighbour cell (i.e. cellIndividualOffset as defined within measObjectNR corresponding to the neighbour cell), and set to zero if not configured for the neighbour cell.","paragraph_zero_based":4957},{"literal_text_all_w_t_and_m_t":"Hys is the hysteresis parameter for this event (i.e. hysteresis as defined within reportConfigNR for this event).","paragraph_zero_based":4958},{"literal_text_all_w_t_and_m_t":"Thresh is the threshold parameter for this event (i.e. a4-Threshold as defined within reportConfigNR for this event).","paragraph_zero_based":4959},{"literal_text_all_w_t_and_m_t":"Mn is expressed in dBm in case of RSRP, or in dB in case of RSRQ and RS-SINR.","paragraph_zero_based":4960},{"literal_text_all_w_t_and_m_t":"Ofn, Ocn, Hys are expressed in dB.","paragraph_zero_based":4961},{"literal_text_all_w_t_and_m_t":"Thresh is expressed in the same unit as Mn.","paragraph_zero_based":4962},{"literal_text_all_w_t_and_m_t":"NOTE:The definition of Event A4 also applies to CondEvent A4.","paragraph_zero_based":4963},{"literal_text_all_w_t_and_m_t":"5.5.4.6Event A5 (SpCell becomes worse than threshold1 and neighbour becomes better than threshold2)","paragraph_zero_based":4964},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":4965},{"literal_text_all_w_t_and_m_t":"1>consider the entering condition for this event to be satisfied when both condition A5-1 and condition A5-2, as specified below, are fulfilled;","paragraph_zero_based":4966},{"literal_text_all_w_t_and_m_t":"1>consider the leaving condition for this event to be satisfied when condition A5-3 or condition A5-4, i.e. at least one of the two, as specified below, is fulfilled;","paragraph_zero_based":4967}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["cba78dc9b