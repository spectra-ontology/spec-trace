a08d92bd79f6136fd2c69811202deecd69b34ebd","17ec16c691313386eda1207bf5aaf90bf4e763b7bdeb6851346b8b835e0d3936","7493a1d4fed48cd1af7462f77fcb847bd1c3273d60c90a06eb52bc19e7ff3fa0","430de4c49c5fb50a46ac31f6b9c2e7f57a033ceb59887781b008587fe228d343","f5f9055f389edc4c9bfd8ee7dd7c157ddab46a856af86d740a79da61deba02c9","02a4efa743a36ff4af0085b3d5709fc35986cc32475aa5a6574c23f874fa6207","fd65d0da74cd919e5c822d07ff6406c311bde4188d363031fd3a2bd9ede87eba","b336c77ea85e51a0c05ae3c5eb9c595155d241fbef269a7c41b4b67a6f8c758a","1786ffc7496294c1cbd27908e528649d756de33cdaa3a65727adf39b48bf617f","11b02ae858f8d56a97b32f6bd2f9c1b361ef8d631cde911ea7c227fe9b7eb2ba","54ced0a383e44ba34d5dd5c8ea72fc1bd6bf4cc36162c589acac998e48f85069","5ea34739d4540e898b2c6823d186a8c8db433e0898045d41d04832abdf98d568","fc502987066d46d217575aaba85bef6da9e8cd095ebc597b541a4b9a085658ab","ae7874dba1acdd2ecfd0868a2f02a21147bad71f0cdc5a3ab0c10c5123967d7b","2046fa72faa8f4f5a638fbd9925595f1f30b5acc043a4bcd497fddf101f3990f","235c09aa8ef382a32f3f90e43698016862e8cfe8dacba49463a65433b40197ab","9d6e6561b089546d447f9f643ffeb11467881c912f591050061dd161cf757a5e","fd5e5c73a845165bb2bd6805d9ac0501c83b345d425501a7334d4f8bb339d0e9","2ec33132ddb4893a3ae6857c2eed87b977d3831090bc7fb44fce0bab43186e95"],"paragraph_range_zero_based":[144,167],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2301347.zip::R2-2301347.docx:p144"}
{"fields":{"filename":"R2-2301347.zip::R2-2301347.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-POSSI-SCHEDULINGINFO-STOP","paragraph_zero_based":168},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":169},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":170},{"literal_text_all_w_t_and_m_t":"PosSI-SchedulingInfo field descriptions","paragraph_zero_based":171},{"literal_text_all_w_t_and_m_t":"areaScope","paragraph_zero_based":172},{"literal_text_all_w_t_and_m_t":"Indicates that a posSIB is area specific. If the field is absent, the posSIB is cell specific.","paragraph_zero_based":173},{"literal_text_all_w_t_and_m_t":"encrypted","paragraph_zero_based":174},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that the pos-sib-type is encrypted as specified in TS 37.355 [49].","paragraph_zero_based":175},{"literal_text_all_w_t_and_m_t":"gnss-id","paragraph_zero_based":176},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that the positioning SIB type is for a specific GNSS. Indicates a specific GNSS (see also TS 37.355 [49])","paragraph_zero_based":177},{"literal_text_all_w_t_and_m_t":"posSI-BroadcastStatus","paragraph_zero_based":178},{"literal_text_all_w_t_and_m_t":"Indicates if the SI message is being broadcasted or not. Change of posSI-BroadcastStatus should not result in system information change notifications in Short Message transmitted with P-RNTI over DCI (see clause 6.5). The value of the indication is valid until the end of the BCCH modification period when set to broadcasting.","paragraph_zero_based":179},{"literal_text_all_w_t_and_m_t":"posSI-RequestConfig","paragraph_zero_based":180},{"literal_text_all_w_t_and_m_t":"Configuration of Msg1 resources that the UE uses for requesting SI-messages for which posSI-BroadcastStatus is set to notBroadcasting.","paragraph_zero_based":181},{"literal_text_all_w_t_and_m_t":"posSI-RequestConfigSUL","paragraph_zero_based":182},{"literal_text_all_w_t_and_m_t":"Configuration of Msg1 resources that the UE uses for requesting SI-messages for which posSI-BroadcastStatus is set to notBroadcasting.","paragraph_zero_based":183},{"literal_text_all_w_t_and_m_t":"posSIB-MappingInfo","paragraph_zero_based":184},{"literal_text_all_w_t_and_m_t":"List of the posSIBs mapped to this SystemInformation message.","paragraph_zero_based":185},{"literal_text_all_w_t_and_m_t":"posSibType","paragraph_zero_based":186},{"literal_text_all_w_t_and_m_t":"The positioning SIB type is defined in TS 37.355 [49].","paragraph_zero_based":187},{"literal_text_all_w_t_and_m_t":"posSI-Periodicity","paragraph_zero_based":188},{"literal_text_all_w_t_and_m_t":"Periodicity of the SI-message in radio frames, such that rf8 denotes 8 radio frames, rf16 denotes 16 radio frames, and so on. If the offsetToSI-Used is configured, the posSI-Periodicity of rf8 cannot be used.","paragraph_zero_based":189},{"literal_text_all_w_t_and_m_t":"offsetToSI-Used","paragraph_zero_based":190},{"literal_text_all_w_t_and_m_t":"This field, if present indicates that all the SI messages in posSchedulingInfoList are scheduled with an offset of 8 radio frames compared to SI messages in schedulingInfoList. offsetToSI-Used may be present only if the shortest configured SI message periodicity for SI messages in schedulingInfoList is 80ms. If SI offset is used, this field is present in each of the SI messages in the posSchedulingInfoList.","paragraph_zero_based":191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e8db888fb982803df73b5b70d0aab8c62937a78cdcaaf45c33eae1b126eff1c9","original_member_sha256":"80851f6ec4179a1dcedf260272906258a89ff70e2fd14ccbbe1e0979b29cdbec","paragraph_ElementTree_utf8_XML_sha256":["c0ceefa8c4e1f0f6b7a169848e6b82de02221a987f22ef7ada3a14387311b310","f4d9f332790f888813b5d2f36