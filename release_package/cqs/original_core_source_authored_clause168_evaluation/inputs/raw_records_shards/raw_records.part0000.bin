{"fields":{"filename":"R2-2305849.zip::R2-2305849- CR4118 Correction for release message with re-establishment v1.0.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>start timer T311;","paragraph_zero_based":144},{"literal_text_all_w_t_and_m_t":"1>stop timer T316, if running;","paragraph_zero_based":145},{"literal_text_all_w_t_and_m_t":"1>if UE is not configured with attemptCondReconfig:","paragraph_zero_based":146},{"literal_text_all_w_t_and_m_t":"2>reset MAC;","paragraph_zero_based":147},{"literal_text_all_w_t_and_m_t":"2>release spCellConfig, if configured;","paragraph_zero_based":148},{"literal_text_all_w_t_and_m_t":"2>suspend all RBs, and BH RLC channels for IAB-MT, and Uu Relay RLC channels for L2 U2N Relay UE, except SRB0 and broadcast MRBs;","paragraph_zero_based":149},{"literal_text_all_w_t_and_m_t":"2>release the MCG SCell(s), if configured;","paragraph_zero_based":150},{"literal_text_all_w_t_and_m_t":"2>if MR-DC is configured:","paragraph_zero_based":151},{"literal_text_all_w_t_and_m_t":"3>perform MR-DC release, as specified in clause 5.3.5.10;","paragraph_zero_based":152},{"literal_text_all_w_t_and_m_t":"2>release delayBudgetReportingConfig, if configured and stop timer T342, if running;","paragraph_zero_based":153},{"literal_text_all_w_t_and_m_t":"2>release overheatingAssistanceConfig, if configured and stop timer T345, if running;","paragraph_zero_based":154},{"literal_text_all_w_t_and_m_t":"2>release idc-AssistanceConfig, if configured;","paragraph_zero_based":155},{"literal_text_all_w_t_and_m_t":"2>release btNameList, if configured;","paragraph_zero_based":156},{"literal_text_all_w_t_and_m_t":"2>release wlanNameList, if configured;","paragraph_zero_based":157},{"literal_text_all_w_t_and_m_t":"2>release sensorNameList, if configured;","paragraph_zero_based":158},{"literal_text_all_w_t_and_m_t":"2>release drx-PreferenceConfig for the MCG, if configured and stop timer T346a associated with the MCG, if running;","paragraph_zero_based":159},{"literal_text_all_w_t_and_m_t":"2>release maxBW-PreferenceConfig for the MCG, if configured and stop timer T346b associated with the MCG, if running;","paragraph_zero_based":160},{"literal_text_all_w_t_and_m_t":"2>release maxCC-PreferenceConfig for the MCG, if configured and stop timer T346c associated with the MCG, if running;","paragraph_zero_based":161},{"literal_text_all_w_t_and_m_t":"2>release maxMIMO-LayerPreferenceConfig for the MCG, if configured and stop timer T346d associated with the MCG, if running;","paragraph_zero_based":162},{"literal_text_all_w_t_and_m_t":"2>release minSchedulingOffsetPreferenceConfig for the MCG, if configured stop timer T346e associated with the MCG, if running;","paragraph_zero_based":163},{"literal_text_all_w_t_and_m_t":"2>release rlm-RelaxationReportingConfig for the MCG, if configured and stop timer T346j associated with the MCG, if running;","paragraph_zero_based":164},{"literal_text_all_w_t_and_m_t":"2>release bfd-RelaxationReportingConfig for the MCG, if configured and stop timer T346k associated with the MCG, if running;","paragraph_zero_based":165},{"literal_text_all_w_t_and_m_t":"2>release releasePreferenceConfig, if configured stop timer T346f, if running;","paragraph_zero_based":166},{"literal_text_all_w_t_and_m_t":"2>release onDemandSIB-Request if configured, and stop timer T350, if running;","paragraph_zero_based":167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"579202af481741cb7bb8161336b86b02431d52d588c77dded6efecb764b57769","original_member_sha256":"b0505b7e6667faeeee211b1942b347757320657484dec9587529cf442d0bad19","paragraph_ElementTree_utf8_XML_sha256":["8036abb967694dc115c8bcafb12c9a93c3555a1b20bfcc38853a4cd72e6e1537","45277a1e006574389cb537895dd98934339e64628e99cb868129cf9cf131e31b","f584ad30633453187383996fad85b940d279b5a0d1bc1575aed35