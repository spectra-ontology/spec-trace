9c1b0365","226f9540747982f9735e7d3971ff58129b8e4c93051bc665931142883c1b9ac2","5944d5bbaf1aa2ee831d7ab15ba051e1d7c62b80a60925cceb60c8808f43c41b","e8b44173576596ac078804618af27fa325071c79a3ec7071bf2524e59238ba95","4df7c9219fc8da8bbee93f252d859a5ce0ea32209591a119d1f5fdc0cdd7419c","42d9653914170356c9692245583cf66597d3f3fcdc8a955725f86eb245542d8a","2d0dabcd44726f9d5095d8ee9ee17685d97f040aada8e4d343c11eba5e11e433"],"paragraph_range_zero_based":[23880,23903],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p23880"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"A set with dedicated P0 values for PUCCH, i.e.,  {P01, P02,... } (see TS 38.213 [13], clause 7.2).","paragraph_zero_based":23904},{"literal_text_all_w_t_and_m_t":"pathlossReferenceRSs, pathlossReferenceRSs-v1610","paragraph_zero_based":23905},{"literal_text_all_w_t_and_m_t":"A set of Reference Signals (e.g. a CSI-RS config or a SS block) to be used for PUCCH pathloss estimation. Up to maxNrofPUCCH-PathlossReference-RSs may be configured. If the field is not configured, the UE uses the SSB as reference signal (see TS 38.213 [13], clause 7.2). The set includes Reference Signals indicated in pathlossReferenceRSs (without suffix) and in pathlossReferenceRSs-v1610. The UE maintains pathlossReferenceRSs and pathlossReferenceRSs-v1610 separately: Receiving pathlossReferenceRSs-v1610 set to release releases only the entries that were configured by pathlossReferenceRSs-v1610, and receiving pathlossReferenceRSs-v1610 set to setup replaces only the entries that were configured by pathlossReferenceRSs-v1610 with the newly signalled entries.","paragraph_zero_based":23906},{"literal_text_all_w_t_and_m_t":"twoPUCCH-PC-AdjustmentStates","paragraph_zero_based":23907},{"literal_text_all_w_t_and_m_t":"Number of PUCCH power control adjustment states maintained by the UE (i.e., g(i)). If the field is present (n2) the UE maintains two power control states (i.e., g(i,0) and g(i,1)). If the field is absent, it maintains one power control state (i.e., g(i,0)) (see TS 38.213 [13], clause 7.2).","paragraph_zero_based":23908},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23909},{"literal_text_all_w_t_and_m_t":"–PUCCH-SpatialRelationInfo","paragraph_zero_based":23910},{"literal_text_all_w_t_and_m_t":"The IE PUCCH-SpatialRelationInfo is used to configure the spatial setting for PUCCH transmission and the parameters for PUCCH power control, see TS 38.213, [13], clause 9.2.2.","paragraph_zero_based":23911},{"literal_text_all_w_t_and_m_t":"PUCCH-SpatialRelationInfo information element","paragraph_zero_based":23912},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":23913},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-SPATIALRELATIONINFO-START","paragraph_zero_based":23914},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23915},{"literal_text_all_w_t_and_m_t":"PUCCH-SpatialRelationInfo ::=           SEQUENCE {","paragraph_zero_based":23916},{"literal_text_all_w_t_and_m_t":"    pucch-SpatialRelationInfoId         PUCCH-SpatialRelationInfoId,","paragraph_zero_based":23917},{"literal_text_all_w_t_and_m_t":"    servingCellId                           ServCellIndex                                                    OPTIONAL,   -- Need S","paragraph_zero_based":23918},{"literal_text_all_w_t_and_m_t":"    referenceSignal                         CHOICE {","paragraph_zero_based":23919},{"literal_text_all_w_t_and_m_t":"        ssb-Index                               SSB-Index,","paragraph_zero_based":23920},{"literal_text_all_w_t_and_m_t":"        csi-RS-Index                            NZP-CSI-RS-ResourceId,","paragraph_zero_based":23921},{"literal_text_all_w_t_and_m_t":"        srs                                     PUCCH-SRS","paragraph_zero_based":23922},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":23923},{"literal_text_all_w_t_and_m_t":"    pucch-PathlossReferenceRS-Id            PUCCH-PathlossReferenceRS-Id,","paragraph_zero_based":23924},{"literal_text_all_w_t_and_m_t":"    p0-PUCCH-Id                             P0-PUCCH-Id,","paragraph_zero_based":23925},{"literal_text_all_w_t_and_m_t":"    closedLoopIndex                         ENUMERATED { i0, i1 }","paragraph_zero_based":23926},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":23927}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["9b45448d652fb9130d48011be9c7cb5a61d0a89958d94809e4bf362d46590b6f","c0f0e55f080a8c3df7d157cfabc426ab8116943bec639458347e9173ec366a5d","d6366f0b5fef802caa00a8e41c9688f33c251c8f12f84b889debcbd25a8f2ef6","e12b33a8c002d875efdf4a7441d64d425ae401ab37bac55083b0aac46cbcc211","79065b08aa4efe2d05fe4c45b220364b8426f0f24cb68543c34277f5fcc579e4","e841d87060efb107c33aab0f0d6e7753bc54b8dddf206b08edb8d939f970eac9","482e90728f158952cd11bb08d7e1706bdb0a0f0ee257a6940a840e8d7e33d4ea","2f703b7790dc246dcd44b6d35c22d8209585fc47f53bb86a1d8056b178962a47","bb78428cea17750ff5ddacfdd9032951042b36f063e01f997ae8848e9e5642e2","dbbd37adc34cd8f1830457b353a0df68e50ace08e5e0f9a4cf8d793134bef3f0","607340c4ff6b941a76bcd016bb4008729e3d0653c8e21ebbcee4c7eca8889394","2dc1a4e61b5c46b21af0ef5b5147cf7f06b837adc8914936a94d23ebbdce5a02","f499cc1fd2ced9ce28182892118854cd8094002419eec798f128c8a9d03a3029","e1efd18c53a73c2b34aef3459b3c729a23e720630be78cf2cb9abc2fb6c2f691","b3dd642f2f60817824cfa01c61eda7936b0f891b409ebd2f6a232ba01e5a5085","c19c8aa7968dcbb8efaa2dd97f3e6307b058e9886e6d6aecd3e8200787f21c5d","d137492ef4db9850045fa8f67510eead1b2d3f53749bf6ff9c8efd0c512ffe45","c5139f282d6e2dd8ea91cef79985a63553f9f1513e8eadc3356906b2a8414923","4ea717ce74ee21b19a50942f7503407036525bd477b969b12d5e5fc479f9255d","f4fcb6312a9fc47bb19680585cddff1fcb506cae68e4668ea08de64a19cbac5a","695065968e5b6b0b57fb1345a51a058afb3f155e637a992b73a2f7858c4ea51c","802aeb8951a8353868096b976c74f23d4896654cd8f22981a2a132c6b076d4db","4fe2a38488a3e57b6da8a2dde97626f815e48c625a0dbeaf9fdea5bf978433ec","9f3e4c537d1f059e553e7ba5f54be7dbbfb33f734d6508185107d40507cf21ae"],"paragraph_range_zero_based":[23904,23927],"projection":"All w:t and m:t including trac