paragraph_zero_based":20963},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20964},{"literal_text_all_w_t_and_m_t":"MsgA-DMRS-Config-r16 ::=                       SEQUENCE {","paragraph_zero_based":20965},{"literal_text_all_w_t_and_m_t":"    msgA-DMRS-AdditionalPosition-r16               ENUMERATED {pos0, pos1, pos3}                                 OPTIONAL, -- Need S","paragraph_zero_based":20966},{"literal_text_all_w_t_and_m_t":"    msgA-MaxLength-r16                             ENUMERATED {len2}                                             OPTIONAL, -- Need S","paragraph_zero_based":20967},{"literal_text_all_w_t_and_m_t":"    msgA-PUSCH-DMRS-CDM-Group-r16                  INTEGER (0..1)                                                OPTIONAL, -- Need S","paragraph_zero_based":20968},{"literal_text_all_w_t_and_m_t":"    msgA-PUSCH-NrofPorts-r16                       INTEGER (0..1)                                                OPTIONAL, -- Need S","paragraph_zero_based":20969},{"literal_text_all_w_t_and_m_t":"    msgA-ScramblingID0-r16                         INTEGER (0..65535)                                            OPTIONAL, -- Need S","paragraph_zero_based":20970},{"literal_text_all_w_t_and_m_t":"    msgA-ScramblingID1-r16                         INTEGER (0..65535)                                            OPTIONAL  -- Need S","paragraph_zero_based":20971},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":20972},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20973},{"literal_text_all_w_t_and_m_t":"-- TAG-MSGA-PUSCH-CONFIG-STOP","paragraph_zero_based":20974},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":20975}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a82