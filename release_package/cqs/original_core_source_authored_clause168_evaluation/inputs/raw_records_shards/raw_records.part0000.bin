{"fields":{"filename":"R2-2306537.zip::R2-2306537.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":312},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":313},{"literal_text_all_w_t_and_m_t":"GridList-r18 ::= SEQUENCE (SIZE(1..1024)) OF GridElement-r18","paragraph_zero_based":314},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":315},{"literal_text_all_w_t_and_m_t":"GridElement-r18 ::= SEQUENCE {","paragraph_zero_based":316},{"literal_text_all_w_t_and_m_t":"gnss-LOS-InfoList-r18GNSS-LOS-InfoList-r18OPTIONAL, -- Need ON","paragraph_zero_based":317},{"literal_text_all_w_t_and_m_t":"…","paragraph_zero_based":318},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":319},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":320},{"literal_text_all_w_t_and_m_t":"GNSS-LOS-InfoList-r18 ::= SEQUENCE (SIZE(1..64)) OF GNSS-LOS-InfoElement-r18","paragraph_zero_based":321},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":322},{"literal_text_all_w_t_and_m_t":"GNSS-LOS-InfoElement-r18 ::= SEQUENCE {","paragraph_zero_based":323},{"literal_text_all_w_t_and_m_t":"svID-r18SV-ID,","paragraph_zero_based":324},{"literal_text_all_w_t_and_m_t":"LOS-r18ENUMERATED{true, false, uncertain},","paragraph_zero_based":325},{"literal_text_all_w_t_and_m_t":"…","paragraph_zero_based":326},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":327},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":328},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":329},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":330},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":331},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":332},{"literal_text_all_w_t_and_m_t":"NotAlreadyProvided","paragraph_zero_based":333},{"literal_text_all_w_t_and_m_t":"This field is absent if ","paragraph_zero_based":334},{"literal_text_all_w_t_and_m_t":"this IE is provided as part of an AssistanceDataSIBelement IE with a present expirationTime field","paragraph_zero_based":335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"7ea3ea011934f6c0dae39181d4a24ce5ca5bc379d48c0313eb5c481ec4a3b095","original_member_sha256":"7e5d65269c396c98b3a6de240a7cc5f08aa736e14c814be48fe93773a39ba42f","paragraph_ElementTree_utf8_XML_sha256":["f296e8511b8bb66d616c72d6f5e21c84af747b083afaed6a32975fdbf9d1fa35","31f47273edb1db347b56a258a55b245a097681aa0abe281fc78af1f2be2081ec","70d0a5e2b939ebb4aeca24c98b00f9dea6affb06ea80991edb6a56c67ef87ebe","8d2118cb80fd2696f86624c45bf197d7631dc11d28214c199c6bb0f787ea7898","f1b5aed3fe3069a4b4f07166c7f0b417297a0709ef46d3785dcc1e2baf98fc3f","f917685e574444e9b4235637456e6c207c7c584ecfd3ad9adf5b49a1cad914a2","cb414a0d9d1591539c180edeca6270f6290f829b2106296fe5da22a8f315f9ad","e5621796fa4bc8161dca247de52e54ac13f4d931b783bda68e5d539db898e82d","8e481f5725e120d16e5b4321d2edd8904feaf2edd1c18806f6de115732f07d2b","1486856152f94558e14327ef0608c30b5d0f164cd4684b1c83160f902f772685","b19f4cac4ff0eabcc19d55fcc29cf843606759016f3d9ddcd9e982a36316aaea","b2e80b61f1b97c75a9bc2bf31c70e6dc42d8b054dc8b7cd925b4ff94114ed57c","f1bb3de826fd949416dece4eb7dec9f37ffd433ea33470ed4bdf8b64392a63e4","fb9d2f6aaefd85bb21766f563bc3003596ab71778c237f12eb2cc887fd17aeb1","c18acf4fa7901981cf4d2242b2d86f5182d467ff7c2a7500e52a092082e7206b","119c748fb1781ebcedabfe946c8249e241a053b9d3989507436edf8ce75086c1","47ed02bddc8f9b09baeca4990b9544be8df086187c6c90ebec08e2a9ab204ff6","47e28b5d93289943691a06c1e9ee0172e72dd432ee1397d463bd5a3189d34dd6","33ea438511f0cb4b613fb7bc4b2defed06a5bf626b1c648485933df4d27056e4","4f65fba8177b0ab9267b60c91b64696de07dd86d056fd7d9b833fa8db6f0e94e","ff1f9ef60970af2c1b20aff45fd81992bc78e4a17ae8892104dc7788fd9478d0","18344fd1e7f1fcf33611687da61490a1e224cc0bf268dcc1e7e87715224c0bf4","0f07e29745ef790069268f11ce48a283006c45320050df8ef761731cee21023d","bf99bebfa2e25e3e16b16189227a620f7bd59ea8113545f4958456ec420bb775"],"paragraph_range_zero_based":[312,335],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306537.zip::R2-2306537.docx:p312"}
{"fields":{"filename":"R2-2306537.zip::R2-2306537.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"the field expirationTime is already present in this IE for a different GNSS ","paragraph_zero_based":336},{"literal_text_all_w_t_and_m_t":"In both these cases, the expiration time inherited to apply to the data of associated gridList.","paragraph_zero_based":337},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":338},{"literal_text_all_w_t_and_m_t":"GNSS-LOS-NLOS-GriddedIndications field descriptions","paragraph_zero_based":339},{"literal_text_all_w_t_and_m_t":"gridPointsSetID","paragraph_zero_based":340},{"literal_text_all_w_t_and_m_t":"This field provides the ID of the LOS-NLOS Grid Point set. It is a regionally unique arbitrary number that is used by the UE to ensure that the GNSS LOS-NLOS indications are being applied to the correct set of points.","paragraph_zero_based":341},{"literal_text_all_w_t_and_m_t":"gridList","paragraph_zero_based":342},{"literal_text_all_w_t_and_m_t":"This field provides the GNSS LOS-NLOS indications for up to 1024 grid points (up to 256 grid points per altitude layer) defined in IE GNSS-LOS-NLOS-GridPoints.","paragraph_zero_based":343},{"literal_text_all_w_t_and_m_t":"The IE GNSS-LOS-NLOS-GridPoints, which belongs to this gridPointSetID, includes the same number of entries as in the gridList, and listed in the same order, as defined by the enabled bits in the bitmaskOfGrids. The upmost grid layer is populated first, followed by the lower layer.","paragraph_zero_based":344},{"literal_text_all_w_t_and_m_t":"svID","paragraph_zero_based":345},{"literal_text_all_w_t_and_m_t":"This field specifies the GNSS satellite for which the LOS-NLOS indications are provided.","paragraph_zero_based":346},{"literal_text_all_w_t_and_m_t":"LOS","paragraph_zero_based":347},{"literal_text_all_w_t_and_m_t":"This field represents a LOS indication per svID per GNSS for a specific grid point, and can take the following values:","paragraph_zero_based":348},{"literal_text_all_w_t_and_m_t":"true – the satellite vehicle is in line of sight","paragraph_zero_based":349},{"literal_text_all_w_t_and_m_t":"false – the satellite vehicle is not in line of sight","paragraph_zero_based":350},{"literal_text_all_w_t_and_m_t":"uncertain – satellite vehicle can either be in line of sight or not ","paragraph_zero_based":351},{"literal_text_all_w_t_and_m_t":"expirationTime","paragraph_zero_based":352},{"literal_text_all_w_t_and_m_t":"This field indicates when the validity of the provided assistance data fields expires. It is specified as UTC time.","paragraph_zero_based":353},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":354},{"literal_text_all_w_t_and_m_t":"End of changes","paragraph_zero_based":355},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":356},{"literal_text_all_w_t_and_m_t":"Start of changes","paragraph_zero_based":357},{"literal_text_all_w_t_and_m_t":"6.5.2.3GNSS Assistance Data Request","paragraph_zero_based":358},{"literal_text_all_w_t_and_m_t":"[…]","paragraph_zero_based":359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"7ea3ea011934f6c0dae39181d4a24ce5ca5bc379d48c0313eb5c481ec4a3b095","original_member_sha256":"7e5d65269c396c98b3a6de240a7cc5f08aa736e14c814be48fe93773a39ba42f","paragraph_ElementTree_utf8_XML_sha256":["f173c21e4d936b0465e2ab120fcac02c8685be4e8615fefec8d16da85053d895","accd4a8afb22055164e4cad8d5dab8426715416934849a5f2122072c472b0c0e","9d1fd3462a968daa7d8ec8a6cd2838ce0f5a583f0ef374420830587c939e3b80","86249acd029d1adc82df95a244756a8c476af15083be2dc182b18fdace51a0c9","d4797d82f05229963858c21ad06a4456a81f4f62ae0801cb06f628cfd939586d","0305d86aa0fa7bf1c5bc5cbbfe6390b32b0797b764d4245c83e94dd1f341b362","5ccb04f633de418d85c9f0d4186fa0e6b4578e5678e74cdd71b5d2eb25a186da","5f37bebba5c3f367b6babfb19b7f6ed9f2b1a