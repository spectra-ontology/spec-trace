ca8574a39255d8e0b2b8beca2ed315a160ed44d10fa63f55218fbb6d1e","e330f007cf41d928a836e395a15c54377b7494802eef05697e529723438b9a12","e4bacc7174285045f6ac8d56d7e49d188ced49fcce4616b81e206338a7573d6c","f0e465111dad9cb8e1229f99e581816e2d70947c734e536ff0bd278af5be8b1d"],"paragraph_range_zero_based":[9144,9167],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p9144"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"areaConfiguration","paragraph_zero_based":9168},{"literal_text_all_w_t_and_m_t":"Used to restrict the area in which the UE performs measurement logging to cells broadcasting either one of the included cell identities or one of the included tracking area codes/ frequencies.","paragraph_zero_based":9169},{"literal_text_all_w_t_and_m_t":"earlyMeasIndication","paragraph_zero_based":9170},{"literal_text_all_w_t_and_m_t":"If included, the field indicates the UE is allowed to log measurements on early measurement related frequencies in logged measurements.","paragraph_zero_based":9171},{"literal_text_all_w_t_and_m_t":"eventType","paragraph_zero_based":9172},{"literal_text_all_w_t_and_m_t":"The value outOfCoverage indicates the UE to perform logging of measurements when the UE enters any cell selection state, and the value eventL1 indicates the UE to perform logging of measurements when the triggering condition (similar as event A2 as specified in 5.5.4.3) as configured in the event is met for the camping cell in camped normally state.","paragraph_zero_based":9173},{"literal_text_all_w_t_and_m_t":"plmn-IdentityList","paragraph_zero_based":9174},{"literal_text_all_w_t_and_m_t":"Indicates a set of PLMNs defining when the UE performs measurement logging as well as the associated status indication and information retrieval i.e. the UE performs these actions when the RPLMN is part of this set of PLMNs.","paragraph_zero_based":9175},{"literal_text_all_w_t_and_m_t":"sigLoggedMeasType","paragraph_zero_based":9176},{"literal_text_all_w_t_and_m_t":"If included, the field indicates a signalling based logged measurement configuration (See TS 37.320 [61]).","paragraph_zero_based":9177},{"literal_text_all_w_t_and_m_t":"tce-Id","paragraph_zero_based":9178},{"literal_text_all_w_t_and_m_t":"Parameter Trace Collection Entity Id: See TS 32.422 [52].","paragraph_zero_based":9179},{"literal_text_all_w_t_and_m_t":"traceRecordingSessionRef","paragraph_zero_based":9180},{"literal_text_all_w_t_and_m_t":"Parameter Trace Recording Session Reference: See TS 32.422 [52].","paragraph_zero_based":9181},{"literal_text_all_w_t_and_m_t":"reportType","paragraph_zero_based":9182},{"literal_text_all_w_t_and_m_t":"Parameter configures the type of MDT configuration, specifically Periodic MDT configuration or Event Triggerd MDT configuration.","paragraph_zero_based":9183},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9184},{"literal_text_all_w_t_and_m_t":"–MBSBroadcastConfiguration","paragraph_zero_based":9185},{"literal_text_all_w_t_and_m_t":"The MBSBroadcastConfiguration message contains the control information applicable for MBS broadcast services transmitted via broadcast MRB.","paragraph_zero_based":9186},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: N/A","paragraph_zero_based":9187},{"literal_text_all_w_t_and_m_t":"RLC-SAP: UM","paragraph_zero_based":9188},{"literal_text_all_w_t_and_m_t":"Logical channel: MCCH","paragraph_zero_based":9189},{"literal_text_all_w_t_and_m_t":"Direction: Network to UE","paragraph_zero_based":9190},{"literal_text_all_w_t_and_m_t":"MBSBroadcastConfiguration message","paragraph_zero_based":9191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["3d04f3088f7e3f39236118e5bc72a8b06bfee402676834a9faf52d039578173e","ba957b9fde73d5d7557427bbaa23ea8ca0ff6e068472543a01a9f2d187573f99","f5e9a345af851fe4ce6ae1f297561d85965c35a177d1eb6cbe8bebd1102910f8","a756fcfe6bbc4d59b03688267378a5ef52552f9bacf7b1f9c3cff2f9ce49d071","1c744200503f2