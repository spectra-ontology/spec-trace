{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":15888},{"literal_text_all_w_t_and_m_t":"-- TAG-CFR-CONFIGMULTICAST-START","paragraph_zero_based":15889},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15890},{"literal_text_all_w_t_and_m_t":"CFR-ConfigMulticast-r17::= SEQUENCE {","paragraph_zero_based":15891},{"literal_text_all_w_t_and_m_t":"    locationAndBandwidthMulticast-r17              INTEGER (0..37949)                       OPTIONAL,    -- Need S","paragraph_zero_based":15892},{"literal_text_all_w_t_and_m_t":"    pdcch-ConfigMulticast-r17                      PDCCH-Config                             OPTIONAL,    -- Need M","paragraph_zero_based":15893},{"literal_text_all_w_t_and_m_t":"    pdsch-ConfigMulticast-r17                      PDSCH-Config                             OPTIONAL,    -- Need M","paragraph_zero_based":15894},{"literal_text_all_w_t_and_m_t":"    sps-ConfigMulticastToAddModList-r17            SPS-ConfigMulticastToAddModList-r17      OPTIONAL,    -- Need N","paragraph_zero_based":15895},{"literal_text_all_w_t_and_m_t":"    sps-ConfigMulticastToReleaseList-r17           SPS-ConfigMulticastToReleaseList-r17     OPTIONAL     -- Need N","paragraph_zero_based":15896},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":15897},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15898},{"literal_text_all_w_t_and_m_t":"SPS-ConfigMulticastToAddModList-r17 ::=SEQUENCE (SIZE (1..8)) OF SPS-Config","paragraph_zero_based":15899},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15900},{"literal_text_all_w_t_and_m_t":"SPS-ConfigMulticastToReleaseList-r17 ::= SEQUENCE (SIZE (1..8)) OF SPS-ConfigIndex-r16","paragraph_zero_based":15901},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15902},{"literal_text_all_w_t_and_m_t":"-- TAG-CFR-CONFIGMULTICAST-STOP","paragraph_zero_based":15903},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":15904},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15905},{"literal_text_all_w_t_and_m_t":"CFR-ConfigMulticast field descriptions","paragraph_zero_based":15906},{"literal_text_all_w_t_and_m_t":"locationAndBandwidthMulticast","paragraph_zero_based":15907},{"literal_text_all_w_t_and_m_t":"Frequency domain location and bandwidth for MBS multicast. The value of the field shall be interpreted as resource indicator value (RIV) as defined in TS 38.214 [19] with assumptions as described in TS 38.213 [13], clause 12, i.e. setting  N^size_BWP=275. The first PRB is a PRB determined by subcarrierSpacing of the associated BWP and offsetToCarrier corresponding to this subcarrier spacing. If not configured, the UE applies the value of locationAndBandwidth of the DL BWP in which the cfr-ConfigMulticast is configured.","paragraph_zero_based":15908},{"literal_text_all_w_t_and_m_t":"pdcch-ConfigMulticast","paragraph_zero_based":15909},{"literal_text_all_w_t_and_m_t":"UE specific group-common PDCCH configuration for MBS multicast for one CFR.","paragraph_zero_based":15910},{"literal_text_all_w_t_and_m_t":"pdsch-ConfigMulticast","paragraph_zero_based":15911}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["60dc42520e79036d70f1fcbeba6ca5e063f8b5a66c2f02249f73745c1a29a0c5","2a691d5595bd406ae8581419fc653a2d5039250103e229113620f11b1eb678bf","0a9102856de38f74308553b82f854c844913b955800b848df71c66ddcee36d30","7d2b8686fea91cb8c65812af0079264c66e743bd578ddbf4e332af0819feaf37","05e71e1be4e30dd80d9edc4ef9c42adfb01b8e7c8f49e9c2381c8216593785ce","b15733466e2