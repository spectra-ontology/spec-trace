0,ms480,ms640,ms1024,ms1280,ms2048,ms2560,ms5120,spare4,spare3,spare2,spare1}","paragraph_zero_based":26296},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26297},{"literal_text_all_w_t_and_m_t":"MeasTriggerQuantityCLI-r16 ::=              CHOICE {","paragraph_zero_based":26298},{"literal_text_all_w_t_and_m_t":"    srs-RSRP-r16                                SRS-RSRP-Range-r16,","paragraph_zero_based":26299},{"literal_text_all_w_t_and_m_t":"    cli-RSSI-r16                                CLI-RSSI-Range-r16","paragraph_zero_based":26300},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":26301},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26302},{"literal_text_all_w_t_and_m_t":"MeasReportQuantityCLI-r16 ::=               ENUMERATED {srs-rsrp, cli-rssi}","paragraph_zero_based":26303}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["069ffb6889231f6711c491457dd94e387459f04139b48ceb625092d1f1b201bc","6a457aca5887f7e89545aa62461fb27008d7bcc1c6c3963f3e2e7865f0f59747","f287743dccb78efd2f73c5827483a2ef08d2ddaf67f676b91f10c3e75dc6c838","6989bb8dc0fc847442d99f71de3cd096aa8f4b73d415e97a930942e81b454d48","063164189e2e5c764938a4d71a121bcc2938e44c4ec087dcf2ca5be5d8b8b440","95b78aa7ac6a0d6d217660c7b3a4e9f0bfaf8ac4a0610e7d014c9e5b9d41e0e3","aed50d5132468a014876701a3516e395eda90f35ea5038d86a15d9de5ba88f90","a9a6e50200048eef31cfa4d5774c80efb79fd6e050514046b741ded507a770e9","13f884ae1e72ed10806a59137c7c0269d3097c11bf1e75f4f1153b885cd511fa","182776fbc76ce77faba4f0a06d9094095c311c35494547da0b729f2000247c9b","1e3b5b4b78d2ecf2e12f619b2f20201435c3d4818e91804253244c8e4d73fd90","7df5d892a556446536be65d8ec58381a639e98cb513838808ac41854c254939d","0f9e377a349a37daf