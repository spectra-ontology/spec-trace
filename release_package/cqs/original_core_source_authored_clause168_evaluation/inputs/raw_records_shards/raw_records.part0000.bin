{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18576},{"literal_text_all_w_t_and_m_t":"FreqPriorityDedicatedSlicing-r17 ::=     SEQUENCE {","paragraph_zero_based":18577},{"literal_text_all_w_t_and_m_t":"     dl-ExplicitCarrierFreq-r17               ARFCN-ValueNR,","paragraph_zero_based":18578},{"literal_text_all_w_t_and_m_t":"    sliceInfoListDedicated-r17               SliceInfoListDedicated-r17                                    OPTIONAL  -- Cond Mandatory","paragraph_zero_based":18579},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18580},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18581},{"literal_text_all_w_t_and_m_t":"SliceInfoListDedicated-r17 ::=           SEQUENCE (SIZE (1..maxSliceInfo-r17)) OF SliceInfoDedicated-r17","paragraph_zero_based":18582},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18583},{"literal_text_all_w_t_and_m_t":"SliceInfoDedicated-r17 ::=               SEQUENCE {","paragraph_zero_based":18584},{"literal_text_all_w_t_and_m_t":"    nsag-IdentityInfo-r17                    NSAG-IdentityInfo-r17,","paragraph_zero_based":18585},{"literal_text_all_w_t_and_m_t":"    nsag-CellReselectionPriority-r17         CellReselectionPriority                                       OPTIONAL,  -- Need R","paragraph_zero_based":18586},{"literal_text_all_w_t_and_m_t":"    nsag-CellReselectionSubPriority-r17      CellReselectionSubPriority                                    OPTIONAL   -- Need R","paragraph_zero_based":18587},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18588},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18589},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQPRIORITYLISTDEDICATEDSLICING-STOP","paragraph_zero_based":18590},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18591},{"lit