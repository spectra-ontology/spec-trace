{"fields":{"filename":"R2-2312499.zip::R2-2312499_38.331_Rel-18_SL_relay_service_continuity.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-path switch of L2 U2N remote UE to the target PCell,","paragraph_zero_based":792},{"literal_text_all_w_t_and_m_t":"-path switch of L2 U2N remote UE to the target L2 U2N Relay UE,","paragraph_zero_based":793},{"literal_text_all_w_t_and_m_t":"-in the secondaryCellGroup at:","paragraph_zero_based":794},{"literal_text_all_w_t_and_m_t":"-PSCell addition,","paragraph_zero_based":795},{"literal_text_all_w_t_and_m_t":"-SCG resume with NR-DC or (NG)EN-DC,","paragraph_zero_based":796},{"literal_text_all_w_t_and_m_t":"-update of required SI for PSCell,","paragraph_zero_based":797},{"literal_text_all_w_t_and_m_t":"-change of AS security key derived from S-KgNB in NR-DC while the UE is configured with at least one radio bearer with keyToUse set to secondary and that is not released by this RRCReconfiguration message,","paragraph_zero_based":798},{"literal_text_all_w_t_and_m_t":"-MN handover in (NG)EN-DC.","paragraph_zero_based":799},{"literal_text_all_w_t_and_m_t":"Otherwise, it is optionally present, need M. The field is absent in the masterCellGroup in RRCResume and RRCSetup messages and is absent in the masterCellGroup in RRCReconfiguration messages if source configuration is not released during DAPS handover.","paragraph_zero_based":800},{"literal_text_all_w_t_and_m_t":"SCellAdd","paragraph_zero_based":801},{"literal_text_all_w_t_and_m_t":"The field is mandatory present upon SCell addition; otherwise it is absent, Need M.","paragraph_zero_based":802},{"literal_text_all_w_t_and_m_t":"SCellAddMod","paragraph_zero_based":803},{"literal_text_all_w_t_and_m_t":"The field is mandatory present upon SCell addition; otherwise it is optionally present, need M.","paragraph_zero_based":804},{"literal_text_all_w_t_and_m_t":"SCellAddSync","paragraph_zero_based":805},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need N:","paragraph_zero_based":806},{"literal_text_all_w_t_and_m_t":"-in the masterCellGroup at","paragraph_zero_based":807},{"literal_text_all_w_t_and_m_t":"-SCell addition,","paragraph_zero_based":808},{"literal_text_all_w_t_and_m_t":"-reconfiguration with sync,","paragraph_zero_based":809},{"literal_text_all_w_t_and_m_t":"-resume of an RRC connection.","paragraph_zero_based":810},{"literal_text_all_w_t_and_m_t":"-in the secondaryCellGroup, when the SCG is not indicated as deactivated at:","paragraph_zero_based":811},{"literal_text_all_w_t_and_m_t":"-SCG activation while the SCG was previously deactivated,","paragraph_zero_based":812},{"literal_text_all_w_t_and_m_t":"-SCell addition,","paragraph_zero_based":813},{"literal_text_all_w_t_and_m_t":"-reconfiguration with sync.","paragraph_zero_based":814},{"literal_text_all_w_t_and_m_t":"It is absent otherwise.","paragraph_zero_based":815}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"78722f96da2c1b0794be02771e6d00815867826bc913cd2dc90778e7cf20a03c","original_member_sha256":"01249659941507b71cdd3a9a4350d5330966e5252dc21fbfc70854bb5a08b2f1","paragraph_ElementTree_utf8_XML_sha256":["c4f57e75c6fd064b0d89be41839d7140d81a5f1a04865640d3ea01774b1ab63e","0a0856a62c5ad3f2987264364bb41764af28a0ed3716a72aa17b7b814d4bd786","8c1d44d4899db6c875c56ea83927050ed66988aa493a31846306b3627edde99a","25229d07ee7e45f5ed0f7e14fb5fbc7becdfbc40ae933eead1d0e7ce000b20bf","5422238d499b7f80a9cae1d0fa8242602b97c301b3998293af796aa1cf23b207","b8a8168e27b9b20f19f1d241125ff103e559e1003fd9c0bdd0ccc78cd66c2ea4","c0c2eb183de06633fcdc365808ffd5805ddbb20e90b31c8d52742d587b8331e1","025ce0d325c2cb4733f495149dabe3c18cecf79e74fd3f8030b3ee52a3efadfa","0c417b4c056b98132af34962bde9371f658a9f4fb10fd16101c2bcd82891b59a","583a58ec24cce2652dca0c90cd112c4350f36e8b24da37f2d0ef029b43e2605b","fcd7076560c9237a4a6054bef58f875014958c4073354ff7b7b3dc102ea4cfa6","6f98af794b4b723cbcadfbcf9fabc2f0a86212b006e8b41b38c882944d03074a","c6ab411c8250450c7e1c675fda802898b3371d7ca0b8e191cfcaf81d297b9381","e64b99b6632c07c2912992f609b84cfea80b35e6b0accaf9a065c2117c448f35","22a21977f5d90bbd6a050436714abfbba707e15a706150fe4c3a4a8da0b37d5c","a3cb064673b45a881e5ed483d8672261492271d665768eaa68bd740517364fad","9391f0b86db9c9f2a252dd8ba403116b1ca5fb1e2c3e9b8231c0f49e276c28ad","3774a3b7a350773fa8d24271c888e94bf4d183c036060e29b97566481d42fb30","7191c87fedf7d31c327b00a2bf3ffd895046c387a9e799008b31102949526792","093b450d7af89bdc1f94d76003f9be6d13c06578717a6abd0c3574f472d0ae3a","92e8aa7bf61c942db97bc97b4d2d71f5affe785fbbe448eb2240950b12e53f5f","4c7040276a821faa250c1d18100cbbbbea320f390a2713c6067d91f12952643a","5cb7bbc2221968b6a2eee14190e3bd6a0737230d578ba55b97f2f807be616235","6078d27215f7639bdf482c35eeaf642c5420f796822cfea4e6d174d4c6339778"],"paragraph_range_zero_based":[792,815],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312499.zip::R2-2312499_38.331_Rel-18_SL_relay_service_continuity.docx:p792"}
{"fields":{"filename":"R2-2312499.zip::R2-2312499_38.331_Rel-18_SL_relay_service_continuity.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SCG","paragraph_zero_based":816},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in an SpCellConfig for the PSCell. It is absent otherwise. ","paragraph_zero_based":817},{"literal_text_all_w_t_and_m_t":"SCellSIB20-Opt","paragraph_zero_based":818},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need M, if the field sCellSIB20 is configured. It is absent otherwise.","paragraph_zero_based":819},{"literal_text_all_w_t_and_m_t":"SCG-Opt","paragraph_zero_based":820},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need M, in an SpCellConfig for the PSCell. It is absent otherwise.","paragraph_zero_based":821},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":822},{"literal_text_all_w_t_and_m_t":"NEXT CHANGE","paragraph_zero_based":823},{"literal_text_all_w_t_and_m_t":"–ReportConfigInterRAT","paragraph_zero_based":824},{"literal_text_all_w_t_and_m_t":"The IE ReportConfigInterRAT specifies criteria for triggering of an inter-RAT measurement reporting event, or an L2 U2N relay measurement reporting event. The inter-RAT measurement reporting events for E-UTRA and UTRA-FDD are labelled BN with N equal to 1, 2 and so on. The measurement reporting events for L2 U2N relay UE are labelled YN with N equal to 1, 2 and so on. The measurement reporting events for L2 U2N relay UE are labelled Z1.","paragraph_zero_based":825},{"literal_text_all_w_t_and_m_t":"Event B1:Neighbour becomes better than absolute threshold;","paragraph_zero_based":826},{"literal_text_all_w_t_and_m_t":"Event B2:PCell becomes worse than absolute threshold1 AND Neighbour becomes better than another absolute threshold2;","paragraph_zero_based":827},{"literal_text_all_w_t_and_m_t":"Event Y1: PCell becomes worse than absolute threshold1 AND candidate L2 U2N Relay UE becomes better than another absolute threshold2;","paragraph_zero_based":828},{"literal_text_all_w_t_and_m_t":"Event Y2: Candidate L2 U2N Relay UE becomes better than absolute threshold;","paragraph_zero_based":829},{"literal_text_all_w_t_and_m_t":"Event Z1: Serving L2 U2N Relay UE becomes worse than absolute threshold1 AND candidate L2 U2N Relay UE becomes better than another absolute threshold2","paragraph_zero_based":830},{"literal_text_all_w_t_and_m_t":"ReportConfigInterRAT information element","paragraph_zero_based":831},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":832},{"literal_text_all_w_t_and_m_t":"-- TAG-REPORTCONFIGINTERRAT-START","paragraph_zero_based":833},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":834},{"literal_text_all_w_t_and_m_t":"ReportConfigInterRAT ::=                    SEQUENCE {","paragraph_zero_based":835},{"literal_text_all_w_t_and_m_t":"    reportType                                  CHOICE {","paragraph_zero_based":836},{"literal_text_all_w_t_and_m_t":"        periodical                                  PeriodicalReportConfigInterRAT,","paragraph_zero_based":837},{"literal_text_all_w_t_and_m_t":"        eventTriggered                              EventTriggerConfigInterRAT,","paragraph_zero_based":838},{"literal_text_all_w_t_and_m_t":"        reportCGI                                   ReportCGI-EUTRA,","paragraph_zero_based":839}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"78722f96da2c1b0794be02771e6d00815867826bc913cd2dc90778e7cf20a03c","original_member_sha256":"01249659941507b71cdd3a9a4350d5330966e5252dc21fbfc70854bb5a08b2f1","paragraph_ElementTree_utf8_XML_sha256":["2084551e1ad219e6752c4c772b59f004e6a6fa3ba601fe6af78e56059faf5b85","f48ae986fd8d6dd46c8456e6b873d384e1f11769e3ffbbf0f95b47826ddfa896","1d5aa1f65ff1e4a4029881863ffbb71cb2c46b9062525013b96bf6b2aa9bdaa4"