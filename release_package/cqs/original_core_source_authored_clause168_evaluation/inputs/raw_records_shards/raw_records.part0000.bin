{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39672},{"literal_text_all_w_t_and_m_t":"–SL-TxPower","paragraph_zero_based":39673},{"literal_text_all_w_t_and_m_t":"The IE SL-TxPower is used to limit the UE's sidelink transmission power on a carrier frequency. The unit is dBm. Value minusinfinity corresponds to –infinity.","paragraph_zero_based":39674},{"literal_text_all_w_t_and_m_t":"SL-TxPower information element","paragraph_zero_based":39675},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39676},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-TXPOWER-START","paragraph_zero_based":39677},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39678},{"literal_text_all_w_t_and_m_t":"SL-TxPower-r16 ::=                    CHOICE{","paragraph_zero_based":39679},{"literal_text_all_w_t_and_m_t":"    minusinfinity-r16                     NULL,","paragraph_zero_based":39680},{"literal_text_all_w_t_and_m_t":"    txPower-r16                           INTEGER (-30..33)","paragraph_zero_based":39681},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39682},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39683},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-TXPOWER-STOP","paragraph_zero_based":39684},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39685},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39686},{"literal_text_all_w_t_and_m_t":"–SL-TypeTxSync","paragraph_zero_based":39687},{"literal_text_all_w_t_and_m_t":"The IE SL-TypeTxSync indicates the synchronization reference type.","paragraph_zero_based":39688},{"literal_text_all_w_t_and_m_t":"SL-TypeTxSync information element","paragraph_zero_based":39689},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39690},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-TYPETXSYNC-START","paragraph_zero_based":39691},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39692},{"literal_text_all_w_t_and_m_t":"SL-TypeTxSync-r16 ::=                     ENUMERATED {gnss, gnbEnb, ue}","paragraph_zero_based":39693},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39694},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-TYPETXSYNC-STOP","paragraph_zero_based":39695}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["42ae12267c61b25eb5fea10c78e48d47c7914ed470e96eec0f9dd962c8fb413f","1f281d8134585d6f12fb690ecad0f862b60473d806048beea2daccce86af31cf","442b7ff13bfaedb95fcf4fecd363532680a7ddfc60163648f3a07a1effb1715d","4e4b57afcee9cf4763e18868373041352cc0ef3328b618dc58f91edb84866b68","f7ac31f288da14278f7e901ab7a2bf612176451937bc4fc2d40b9a2cd308dd2b","613889b7d9dccfd49d841e9970d9993746414a4482716fc7fce9b9029db0371c","b34c263cdca041fa1f00233687c58980397e7273e53e9d3959f9b4f0a6519ac4","37cf0abc0c64a33449f4801950664f80003fb34a7e72640bd38c3ee1167b4709","ab541c2cbc7a7ef9b330f7b99c30102dba2f40e3d863271d7bef7db98b439bc1","57a7a7203a98ca6c2bf0ea012b7a4ba3b3483a0e8893f193c5f27510469189af","2dec25419a6cc20def91f10d4af7cb80288323a1337e2adab0fb1730c366b786","90f4830fb8e633b97d779cc9a5ce64c6658e704ec835341f1eb1bdc23131eb0f","9dc1f21420b6fd592c496e8fb4f5fe7fda2082c8a7bc74364abc5cd089d0fc4d","8b8dd4c686a8b98be6cb159a9748d1b3cb62ca87351b509105ba11f0b973d2ef","c3fafccee022b484ac5a454d6261ab68577fefa2c10ea399cc5f122aaadbfe44","1ea960d48dd8ca1b5667414dfbaa28f5fa5a9fdb2737cdfe6f9769a3ba1a9a6e","40d5021ea7c62e7d399e0697155176e23ab38464e9038dbc3a887c5b746f18a6","63c33e41405218a722e037ee0f5237d526a8f6d9b7291a7db020138fdfe54d82","6c64d8fea62676799b00c2fcd919c4837ddcb