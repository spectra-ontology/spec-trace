{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"CarrierFreq-NB field descriptions","paragraph_zero_based":168},{"literal_text_all_w_t_and_m_t":"carrierFreq","paragraph_zero_based":169},{"literal_text_all_w_t_and_m_t":"This field specifies the ARFCN applicable for the NB-IoT carrier frequency as defined in TS 36.101 [21, Table 5.7.3-1].","paragraph_zero_based":170},{"literal_text_all_w_t_and_m_t":"carrierFreqOffset","paragraph_zero_based":171},{"literal_text_all_w_t_and_m_t":"This field specifies the offset of the NB-IoT channel number to EARFCN as defined in TS 36.101 [21]. ","paragraph_zero_based":172},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":173},{"literal_text_all_w_t_and_m_t":"–CarrierFreqOffsetNB","paragraph_zero_based":174},{"literal_text_all_w_t_and_m_t":"The IE CarrierFreqOffsetNB is used to provide the offset of the NB-IoT channel number to EARFCN of a NB-IoT carrier.","paragraph_zero_based":175},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":176},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":177},{"literal_text_all_w_t_and_m_t":"CarrierFreqOffsetNB-r14 ::=ENUMERATED {","paragraph_zero_based":178},{"literal_text_all_w_t_and_m_t":"v-10, v-9, v-8,v-7, v-6, v-5, v-4, v-3, v-2, v-1, v-0dot5,","paragraph_zero_based":179},{"literal_text_all_w_t_and_m_t":"v0, v1, v2, v3, v4, v5, v6, v7, v8, v9","paragraph_zero_based":180},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":181},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":182},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":183},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":184},{"literal_text_all_w_t_and_m_t":"CarrierFreqOffsetNB field descriptions","paragraph_zero_based":185},{"literal_text_all_w_t_and_m_t":"CarrierFreqOffsetNB","paragraph_zero_based":186},{"literal_text_all_w_t_and_m_t":"This field specifies the offset of the NB-IoT channel number to EARFCN as defined in TS 36.101 [21]. Value v-10 means -10, v-9 means -9, and so on.","paragraph_zero_based":187},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":188},{"literal_text_all_w_t_and_m_t":"–CellGlobalIdEUTRA-AndUTRA","paragraph_zero_based":189},{"literal_text_all_w_t_and_m_t":"The IE CellGlobalIdEUTRA-AndUTRA specifies the global Cell Identifier for EUTRA or UTRA, the globally unique identity of a cell in EUTRA or UTRA.","paragraph_zero_based":190},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["0718116c984ce5f91f5b007887eeed9e97f39526665d5e3c999aa28342304540","1a8897db0eed7bc42c35000741b2ecf44618747ebe073b231a8be0d059150f06","b6d93ecbbdb982e287145b5772ea92fd9c3797b6ca893611163bdc92f33a8d62","5602f4f0488e7858419d5960d3c4b626d88e2e0d20d7120c80cb401c1d5fa135","4d0c9bedf5c2ab8f6db51d488cd8c1a748f651aa8d71dbaea54849d454b760ca","89833a867c3485d470b8c923b14e40a4b0ea08e8df356d8ec8f674d252d3747a","92ffbf6f4f176121c1a6fa27841749fc3afef10c83b536c9a6ef6190003f9623","a00f94176daa2c70ddd872b431debd3dd378f45b40873e34e9dd19b95d952313","296fa7cfbac1301825ecb2ce5730fd07c0b132c033cff164d9e6d7f53a8ae940","6df7bc3145f86f545d51fc83d032b26ec512b09d3df1f7d2d59493dee17ce6f5","4fe15aaca5454191b59a30079befeeaa32b6f0a0f77cf287ecdfbccb6d513896","185cdfcf7229ba4f65969c847ec4638f2038bcd2f8724625c859c38045065704","6ddc937ae322f5191483700dc5c43f9105761e258780631c8ded59791416786c","80762ae703d601c9a95f850cfa76735e82acba0e80bc14ef192e2f112291ae7e","95631e1d4b2e97592bd15f264be26553c2f839e4a46cf4f7b4c4