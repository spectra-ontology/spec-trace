{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The field is mandatory present in case of sidelink DRB setup via the dedicated signalling and in case of sidelink DRB configuration via system information and pre-configuration; otherwise the field is optionally present, need M.","paragraph_zero_based":38832},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38833},{"literal_text_all_w_t_and_m_t":"–SL-RelayUE-Config","paragraph_zero_based":38834},{"literal_text_all_w_t_and_m_t":"The IE SL-RelayUE-Config specifies the configuration information for NR sidelink U2N Relay UE.","paragraph_zero_based":38835},{"literal_text_all_w_t_and_m_t":"SL-RelayUE-Config information element","paragraph_zero_based":38836},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":38837},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RELAYUE-CONFIG-START","paragraph_zero_based":38838},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38839},{"literal_text_all_w_t_and_m_t":"SL-RelayUE-Config-r17::=           SEQUENCE {","paragraph_zero_based":38840},{"literal_text_all_w_t_and_m_t":"    threshHighRelay-r17                RSRP-Range                              OPTIONAL,     -- Need R","paragraph_zero_based":38841},{"literal_text_all_w_t_and_m_t":"    threshLowRelay-r17                 RSRP-Range                              OPTIONAL,     -- Need R","paragraph_zero_based":38842},{"literal_text_all_w_t_and_m_t":"    hystMaxRelay-r17                   Hysteresis                              OPTIONAL,     -- Cond ThreshHighRelay","paragraph_zero_based":38843},{"literal_text_all_w_t_and_m_t":"    hystMinRelay-r17                   Hysteresis                              OPTIONAL      -- Cond ThreshLowRelay","paragraph_zero_based":38844},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":38845},{"literal_tex