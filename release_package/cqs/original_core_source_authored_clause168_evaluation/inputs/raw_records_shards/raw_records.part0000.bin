}                                        OPTIONAL,   -- Need N","paragraph_zero_based":25311},{"literal_text_all_w_t_and_m_t":"    pdcp-Config                             PDCP-Config                                             OPTIONAL,   -- Cond PDCP","paragraph_zero_based":25312},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":25313},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":25314},{"literal_text_all_w_t_and_m_t":"    daps-Config-r16                         ENUMERATED{true}                                        OPTIONAL    -- Cond DAPS","paragraph_zero_based":25315},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":25316},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25317},{"literal_text_all_w_t_and_m_t":"DRB-ToReleaseList ::=                   SEQUENCE (SIZE (1..maxDRB)) OF DRB-Identity","paragraph_zero_based":25318},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25319}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["30f4c739bd5c65c547c39eb0a6df6d1f64123aeee6323c4d1b1ea9f78473e658","f7dd340e50435f8b8d05982962a99695cba494cf66b6eb0ee4d2830bfb316520","a7d54a8da401748a232db8fc9a945eb0e03024e810686c7a69795f61c1e0425d","e12b13aee3fb10bd637d3af2cecbff088ffc3a74400c427563ef4521ab0ce919","1f4a80bd3cc32fcf412d9c4a032ef2028d66695618602358cb4bb9f8ac2084d7","a918a6403a4acf0cc45a7a8aba2ee2a772d30cbf4319cbc51a1d730bc5e0acbe","d983cb0543e5879ef93e2856167bf12aa3941bd07456bacf61ac65e9b767edba","6023ea4a8171c2520074f0667dd7b4643fd4c5703d29733eba8de00cfba1812c","74c09f00ac950c5ae70e055aac4da491a73f5372001d8fa2c221aff0c40efc5e","7943b5f8a1474d9b9dbdcc45e92f9a7f4d5bf7bd67fc3fe699fbf7a810caf020","9387858fe8