{"literal_text_all_w_t_and_m_t":"This clause specifies the requirements upon reception of the following MAC CEs:","paragraph_zero_based":212},{"literal_text_all_w_t_and_m_t":"-SP CSI-RS/CSI-IM Resource Set Activation/Deactivation MAC CE;","paragraph_zero_based":213},{"literal_text_all_w_t_and_m_t":"-Aperiodic CSI Trigger State Subselection MAC CE;","paragraph_zero_based":214},{"literal_text_all_w_t_and_m_t":"-TCI States Activation/Deactivation for UE-specific PDSCH MAC CE;","paragraph_zero_based":215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"7ecc7295152ab004fee6c5fe5b51922f6b04fc31c69bc0c2a87740df08932928","original_member_sha256":"5ac2a6eb195866185c7c6c25a8e6bde44e85ab5aebfb9dafb46d77b16a9bd085","paragraph_ElementTree_utf8_XML_sha256":["e3bb0b8a03f9404eb0aa52bd3427b498ee129caada5829a935245bf3202d049c","ff1cfdb8bbfe8cde80387a259a67a0da9b72489aa6ad6e5aea25e88ef57c8ab3","3dbbd53dcfca161409c307f38daa8d7fd8672519447508d5951642ac92595779","a026374d1d0ae5cec906ae6af827dd6b14db452397c7da0fe7001d7156a9b0bd","3ca02e7f4c60b6e0d28b4733444204af5d5f272b9cb9362a8021620e2ffc1109","f4e9e8cae325ffff1f02b7ade030dc71ed9ffdbe08bd87a1ca716a7fa7c1d3b1","4737f0d0d4e57b9c1da7c7b7e4d0d65891b0e2cf41f6059384b2df04b2e76c0a","1c0d591117def65fb7bbbd9bd8d14e6b850a68dfc4636be83ca20b91928c30f1","1b89d91b015150b242540307b7adf18a163a026c151b974de5694a37d442ed1e","bc4edb747804e0ddd08e81ed91972f8e14cf506df0ac9e9dbd4789f9b8d31c00","d32be74835b9af08e2f2bcda2a4007323254c2a068bb4b9b80cd98eb95b2d134","b9240f2b915ab46c7cffb179f77734883cd4d907317ad739e9d762b1a9212a75","7126bb2c2ce4a6a841ab15de6392cc42b2b289a559ba19117807055f9f78ef8d","aa46227330199331a5ff9a10705aa35472802508b54de501127eb67cfd8d0466","9dcabfdfddb0f84904d9c68b802267fb722d251df803443e683d6583eefce330","35e9c478c749ce88b01f44aa1e81a117094b2f1d76816933118ec34e53ba8da5","f7e1d95f0da382ebc4b9345b9ea34c962d9469bede97a594b213ccb35b87d161","