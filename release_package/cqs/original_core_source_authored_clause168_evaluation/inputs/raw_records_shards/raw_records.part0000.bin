{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE PUCCH-SpatialRelationInfo-Id is used to identify a PUCCH-SpatialRelationInfo","paragraph_zero_based":23952},{"literal_text_all_w_t_and_m_t":"PUCCH-SpatialRelationInfo-Id information element","paragraph_zero_based":23953},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":23954},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-SPATIALRELATIONINFO-START","paragraph_zero_based":23955},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23956},{"literal_text_all_w_t_and_m_t":"PUCCH-SpatialRelationInfoId ::=         INTEGER (1..maxNrofSpatialRelationInfos)","paragraph_zero_based":23957},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23958},{"literal_text_all_w_t_and_m_t":"PUCCH-SpatialRelationInfoId-r16 ::=     INTEGER (1..maxNrofSpatialRelationInfos-r16)","paragraph_zero_based":23959},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23960},{"literal_text_all_w_t_and_m_t":"PUCCH-SpatialRelationInfoId-v1610::=    INTEGER (maxNrofSpatialRelationInfos-plus-1..maxNrofSpatialRelationInfos-r16)","paragraph_zero_based":23961},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23962},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-SPATIALRELATIONINFO-STOP","paragraph_zero_based":23963},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23964},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23965},{"literal_text_all_w_t_and_m_t":"–PUCCH-TPC-CommandConfig","paragraph_zero_based":23966},{"literal_text_all_w_t_and_m_t":"The IE PUCCH-TPC-CommandConfig is used to configure the UE for extracting TPC commands for PUCCH from a group-TPC messages on DCI.","paragraph_zero_based":23967},{"literal_text_all_w_t_and_m_t":"PUCCH-TPC-CommandConfig information element","paragraph_zero_based":23968},{"literal_t