{"fields":{"filename":"R2-2306537.zip::R2-2306537.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests GNSS-NavigationModel; otherwise it is not present.","paragraph_zero_based":432},{"literal_text_all_w_t_and_m_t":"RTIReq","paragraph_zero_based":433},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests GNSS-RealTimeIntegrity; otherwise it is not present.","paragraph_zero_based":434},{"literal_text_all_w_t_and_m_t":"DataBitsReq","paragraph_zero_based":435},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests GNSS-DataBitAssistance; otherwise it is not present.","paragraph_zero_based":436},{"literal_text_all_w_t_and_m_t":"AcquAssistReq","paragraph_zero_based":437},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests GNSS-AcquisitionAssistance; otherwise it is not present.","paragraph_zero_based":438},{"literal_text_all_w_t_and_m_t":"AlmanacReq","paragraph_zero_based":439},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests GNSS-Almanac; otherwise it is not present.","paragraph_zero_based":440},{"literal_text_all_w_t_and_m_t":"UTCModReq","paragraph_zero_based":441},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests GNSS-UTCModel; otherwise it is not present.","paragraph_zero_based":442},{"literal_text_all_w_t_and_m_t":"AuxInfoReq","paragraph_zero_based":443},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests GNSS-AuxiliaryInformation; otherwise it is not present.","paragraph_zero_based":444},{"literal_text_all_w_t_and_m_t":"DBDS-Req","paragraph_zero_based":445},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests BDS-DifferentialCorrections; otherwise it is not present. This field may only be present if gnss-ID indicates 'bds'.","paragraph_zero_based":446},{"literal_text_all_w_t_and_m_t":"BDS-GridModReq","paragraph_zero_based":447},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests BDS-GridModel; otherwise it is not present. This field may only be present if gnss-ID indicates 'bds'.","paragraph_zero_based":448},{"literal_text_all_w_t_and_m_t":"RTK-OSR-Req","paragraph_zero_based":449},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests GNSS-RTK-Observations; otherwise it is not present.","paragraph_zero_based":450},{"literal_text_all_w_t_and_m_t":"GLO-CPB-Req","paragraph_zero_based":451},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests GLO-RTK-BiasInformation; otherwise it is not present.","paragraph_zero_based":452},{"literal_text_all_w_t_and_m_t":"MAC-Req","paragraph_zero_based":453},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests GNSSRTKMACCorrectionDifferences; otherwise it is not present.","paragraph_zero_based":454},{"literal_text_all_w_t_and_m_t":"Res-Req","paragraph_zero_based":455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"7ea3ea011934f6c0dae39181d4a24ce5ca5bc379d48c0313eb5c481ec4a3b095","original_member_sha256":"7e5d65269c396c98b3a6de240a7cc5f08aa736e14c814be48fe93773a39ba42f","paragraph_ElementTree_utf8_XML_sha256":["5de458ae7d8daedeff12443ae0ff2f4389bd1efed1264689d84575ae9371aaa8","ea791812e23b9894f49d873fca1967518b4a00a1672cebfed986056a66747388","6b08f4b4f299890dc512613af00ad0a11267bfc69a730263cc9f87efc363ced0","d4be81e72b4dab4430873e109245c884a6906ca28b9f7cbf95ca19b92678ad9a","5dec334563985aa8151dac2eae6afbb7b3f54a70b472eb8e24a8489fb7924d51","dabe629abc437b75766d2ef5a2d7fb9d29ad562e144f2abaf409d307f73b6491","6da