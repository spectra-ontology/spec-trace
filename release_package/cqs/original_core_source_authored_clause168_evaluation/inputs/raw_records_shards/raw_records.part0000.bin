{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"thresholdPercentageT304","paragraph_zero_based":37248},{"literal_text_all_w_t_and_m_t":"This field indicates the threshold for the ratio in percentage between the elapsed T304 timer and the configured value of the T304 timer. Value p40 corresponds to 40%, value p60 corresponds to 60% and so on. This field is set in the otherConfig configured by the target cell of the handover.","paragraph_zero_based":37249},{"literal_text_all_w_t_and_m_t":"thresholdPercentageT310","paragraph_zero_based":37250},{"literal_text_all_w_t_and_m_t":"This field indicates the threshold for the ratio in percentage between the elapsed T310 timer and the configured value of the T310 timer. Value p40 corresponds to 40%, value p60 corresponds to 60% and so on. This field is set in the otherConfig configured by the source cell of the handover.","paragraph_zero_based":37251},{"literal_text_all_w_t_and_m_t":"thresholdPercentageT312","paragraph_zero_based":37252},{"literal_text_all_w_t_and_m_t":"This field indicates the threshold for the ratio in percentage between the elapsed T312 timer and the configured value(s) of the T312 timer. Value p20 corresponds to 20%, value p40 corresponds to 40% and so on. This field is set in the otherConfig configured by the source cell of the handover.","paragraph_zero_based":37253},{"literal_text_all_w_t_and_m_t":"threshPropDelayDiff","paragraph_zero_based":37254},{"literal_text_all_w_t_and_m_t":"Threshold for one-way service link propagation delay difference report as specified in 5.7.4.2.","paragraph_zero_based":37255},{"literal_text_all_w_t_and_m_t":"uav-FlightPathAvailabilityConfig ","paragraph_zero_based":37256},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to indicate the availability of flight path information for Aerial UE operation.","paragraph_zero_based":37257},{"literal_text_all_w_t_and_m_t":"ul-GapFR2-PreferenceConfig","paragraph_zero_based":37258},{"literal_text_all_w_t_and_m_t":"Indicates whether UE is configured to request for FR2 UL gap activation/deactivation and preferred FR2 UL gap pattern.","paragraph_zero_based":37259},{"literal_text_all_w_t_and_m_t":"wlanNameList","paragraph_zero_based":37260},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurements from specific WLAN APs. NG-RAN configures the field if includeWLAN-Meas is configured for one or more measurements.","paragraph_zero_based":37261},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37262},{"literal_text_all_w_t_and_m_t":"NeighbourCellInfo field descriptions","paragraph_zero_based":37263},{"literal_text_all_w_t_and_m_t":"epochTime","paragraph_zero_based":37264},{"literal_text_all_w_t_and_m_t":"Indicates the epoch time used along with the ephemerisInfo to derive the propagation delay difference for the associated neighbour cell. The UE considers epoch time, indicated by the SFN and sub-frame number in this field, to be the frame nearest to the frame in which the message indicating the epoch time is received. This field is used based on the timing of the serving cell, i.e. the SFN and sub-frame number indicated in this field refers to the SFN and sub-frame of the serving cell.","paragraph_zero_based":37265},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37266},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":37267},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":37268},{"literal_text_all_w_t_and_m_t":"maxBW","paragraph_zero_based":37269},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need R, if maxBW-PreferenceConfig-r16 is setup; otherwise it is absent, need R.","paragraph_zero_based":37270},{"literal_text_all_w_t_and_m_t":"maxMIMO","paragraph_zero_based":37271}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["1438c395703210f716d9b14a5088aa639dfb445b6602654c60b6aec1ed4c242f","edcac0ab35a6b708faeceaf660822e9472fafbc95d2dcf740883460ceea2ffdb","5a465f0122ffeedaced99868d90586c270aad6be535d1cc2977239e31e7e37c4","ae30cb8fb2eeb6e7de4af374d4d594c21b0969a64bfca8e1802d615329271824","d498c1134d1f8703a8a0fcdf002a9689485e18608350914429c145399241a612","ff449f8cfb84f1c50a1a76e3ff6134f210c8f220818ff7042b1e62f317011267","9504dd50565fb61cd36752d1f4ed207d149c764dd0bf65e0baf05157158d3b38","18a78efab936f867e415fbd7bf350927821d70e3423f008161c7a65c0da291f1","0a964081be32650368eba5053e6ea42eb1e1e26391f60bde127e218c196c5837","9cf7634739f45cc1d139389daa09f1635cb6499a6ce31be55e000fc641c38e37","08d3e893a15a50e6b1a41a998fe2213f880f59c9a0cee02f70b6e79907eff2b9","6b95930c585e964fccc16add1702cd67d474ad6f30284244e4b0df32ce09a3df","c5c4b89e98fef9f535eb37cb9177d87840b7014cacfc7d7e86dd50cfccf89edc","c69ddc3cab4471803226c5733b15643986245f134f1107320f694a42aa06310a","41c786ea336957b0a0efe373f797ccdc54fef782c8494bb1d3f6c2e094ad7ab1","584990d7ae2bb001f0fd11b7b578afddc5f05f6b10ba27f163b4c298d4300c8a","0f3711cd03b91195df99feeed03914234f2bed4ebc8488bd134ef07e043e77bf","a524cdba76ca8b089c6707a1ca8ab981d93b7105701a9a6a1b501e3f38fb925c","fa2159bc4e4c808ba7dd4fa9d70f0b565e29979001d35f0112736e8c5728c422","ba8093e6b7ab4405c768fb189d292d63382636238d7920cf1ead2bf9d640c8e8","51b84f7b2323f71b7f9462b2c9e13949df1afae04d73c34577e7b423f345b197","714756b933988329e48ec89402fa9ae3618262dd12ab1a900c5ee9a83d7dd684","52f0a4f28334f15d7f232148885f05471085d6e9e614c4dab64f0a0ca770a788","03143bfc9df4a9ed53539664c98b5f85ef6bc1cd22395e85356254ccea666a86"],"paragraph_range_zero_based":[37248,37271],"projection":"All w:t and m:t including tracked ins