{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"For L2 U2N Relay UE, the field is optionally present, Need N. Otherwise, it is absent.","paragraph_zero_based":10200},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10201},{"literal_text_all_w_t_and_m_t":"–RRCReconfigurationComplete","paragraph_zero_based":10202},{"literal_text_all_w_t_and_m_t":"The RRCReconfigurationComplete message is used to confirm the successful completion of an RRC connection reconfiguration.","paragraph_zero_based":10203},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1 or SRB3","paragraph_zero_based":10204},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":10205},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":10206},{"literal_text_all_w_t_and_m_t":"Direction: UE to Network","paragraph_zero_based":10207},{"literal_text_all_w_t_and_m_t":"RRCReconfigurationComplete message","paragraph_zero_based":10208},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":10209},{"literal_text_all_w_t_and_m_t":"-- TAG-RRCRECONFIGURATIONCOMPLETE-START","paragraph_zero_based":10210},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10211},{"literal_text_all_w_t_and_m_t":"RRCReconfigurationComplete ::=              SEQUENCE {","paragraph_zero_based":10212},{"literal_text_all_w_t_and_m_t":"    rrc-TransactionIdentifier                   RRC-TransactionIdentifier,","paragraph_zero_based":10213},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                          CHOICE {","paragraph_zero_based":10214},{"literal_text_all_w_t_and_m_t":"        rrcReconfigurationComplete                  RRCReconfigurationComplete-IEs,","paragraph_zero_based":10215},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture                    SEQUENCE {}","parag