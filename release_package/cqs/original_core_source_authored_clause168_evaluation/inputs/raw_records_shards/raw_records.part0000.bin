{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Max number of RS indexes to include in the measurement report for A1-A6 events.","paragraph_zero_based":26352},{"literal_text_all_w_t_and_m_t":"maxReportCells","paragraph_zero_based":26353},{"literal_text_all_w_t_and_m_t":"Max number of non-serving cells to include in the measurement report.","paragraph_zero_based":26354},{"literal_text_all_w_t_and_m_t":"numberOfTriggeringCells","paragraph_zero_based":26355},{"literal_text_all_w_t_and_m_t":"Indicates the number of cells detected that are required to fulfill an event for a measurement report to be triggered. This field is applicable only for the events concerning neighbor cells, i.e. eventA3, eventA4, eventA5, eventA3H1, eventA3H2, eventA4H1, eventA4H2, eventA5H1, eventA5H2.","paragraph_zero_based":26356},{"literal_text_all_w_t_and_m_t":"referenceLocation1, referenceLocation2","paragraph_zero_based":26357},{"literal_text_all_w_t_and_m_t":"Reference locations used for eventD1. The referenceLocation1 is associated to serving cell and referenceLocation2 is associated to neighbour cell.","paragraph_zero_based":26358},{"literal_text_all_w_t_and_m_t":"reportAddNeighMeas","paragraph_zero_based":26359},{"literal_text_all_w_t_and_m_t":"Indicates that the UE shall include the best neighbour cells per serving frequency.","paragraph_zero_based":26360},{"literal_text_all_w_t_and_m_t":"reportAmount","paragraph_zero_based":26361},{"literal_text_all_w_t_and_m_t":"Number of measurement reports applicable for eventTriggered as well as for periodical report types.","paragraph_zero_based":26362},{"literal_text_all_w_t_and_m_t":"reportOnLeave","paragraph_zero_based":26363},{"literal_text_all_w_t_and_m_t":"Indicates whether or not the UE shall initiate the measurement reporting procedure when the leaving condition is met for a cell in cellsTriggeredList, as specified in 5.5.4.1.","paragraph_zero_based":26364},{"literal_text_all_w_t_and_m_t":"Indicates whether or not the UE shall initiate the measurement reporting procedure when the leaving condition is met if configured in eventD1, eventH1, eventH2, as specified in 5.5.4.1.","paragraph_zero_based":26365},{"literal_text_all_w_t_and_m_t":"reportQuantityCell","paragraph_zero_based":26366},{"literal_text_all_w_t_and_m_t":"The cell measurement quantities to be included in the measurement report.","paragraph_zero_based":26367},{"literal_text_all_w_t_and_m_t":"reportQuantityRS-Indexes","paragraph_zero_based":26368},{"literal_text_all_w_t_and_m_t":"Indicates which measurement information per RS index the UE shall include in the measurement report.","paragraph_zero_based":26369},{"literal_text_all_w_t_and_m_t":"timeToTrigger","paragraph_zero_based":26370},{"literal_text_all_w_t_and_m_t":"Time during which specific criteria for the event needs to be met in order to trigger a measurement report.","paragraph_zero_based":26371},{"literal_text_all_w_t_and_m_t":"useAllowedCellList","paragraph_zero_based":26372},{"literal_text_all_w_t_and_m_t":"Indicates whether only the cells included in the allow-list of the associated measObject are applicable as specified in 5.5.4.1.","paragraph_zero_based":26373},{"literal_text_all_w_t_and_m_t":"useT312","paragraph_zero_based":26374},{"literal_text_all_w_t_and_m_t":"If value TRUE is configured, the UE shall use the timer T312 with the value t312 as specified in the corresponding measObjectNR. If value FALSE is configured, the timer T312 is considered as disabled. Network configures value TRUE only if reportType is set to eventTriggered.","paragraph_zero_based":26375}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5