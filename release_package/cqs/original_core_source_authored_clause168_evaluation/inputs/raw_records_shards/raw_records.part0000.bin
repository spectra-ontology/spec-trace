{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE MAC-CellGroupConfig is used to configure MAC parameters for a cell group, including DRX.","paragraph_zero_based":19200},{"literal_text_all_w_t_and_m_t":"MAC-CellGroupConfig information element","paragraph_zero_based":19201},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":19202},{"literal_text_all_w_t_and_m_t":"-- TAG-MAC-CELLGROUPCONFIG-START","paragraph_zero_based":19203},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19204},{"literal_text_all_w_t_and_m_t":"MAC-CellGroupConfig ::=             SEQUENCE {","paragraph_zero_based":19205},{"literal_text_all_w_t_and_m_t":"    drx-Config                          SetupRelease { DRX-Config }                                     OPTIONAL,   -- Need M","paragraph_zero_based":19206},{"literal_text_all_w_t_and_m_t":"    schedulingRequestConfig             SchedulingRequestConfig                                         OPTIONAL,   -- Need M","paragraph_zero_based":19207},{"literal_text_all_w_t_and_m_t":"    bsr-Config                          BSR-Config                                                      OPTIONAL,   -- Need M","paragraph_zero_based":19208},{"literal_text_all_w_t_and_m_t":"    tag-Config                          TAG-Config                                                      OPTIONAL,   -- Need M","paragraph_zero_based":19209},{"literal_text_all_w_t_and_m_t":"    phr-Config                          SetupRelease { PHR-Config }                                     OPTIONAL,   -- Need M","paragraph_zero_based":19210},{"literal_text_all_w_t_and_m_t":"    skipUplinkTxDynamic                 BOOLEAN,","paragraph_zero_based":19211},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":19212},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":19213},{"literal_text_all_w_t_and_m_t":"    csi-Mask                            BOOLEAN                                                         OPTIONAL,   -- Need M","paragraph_zero_based":19214},{"literal_text_all_w_t_and_m_t":"    dataInactivityTimer                 SetupRelease { DataInactivityTimer }                            OPTIONAL    -- Cond MCG-Only","paragraph_zero_based":19215},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":19216},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":19217},{"literal_text_all_w_t_and_m_t":"    usePreBSR-r16                       ENUMERATED {true}                                               OPTIONAL,   -- Need R","paragraph_zero_based":19218},{"literal_text_all_w_t_and_m_t":"    schedulingRequestID-LBT-SCell-r16   SchedulingRequestId                                             OPTIONAL,   -- Need R","paragraph_zero_based":19219},{"literal_text_all_w_t_and_m_t":"    lch-BasedPrioritization-r16         ENUMERATED {enabled}                                            OPTIONAL,   -- Need R","paragraph_zero_based":19220},{"literal_text_all_w_t_and_m_t":"    schedulingRequestID-BFR-SCell-r16   SchedulingRequestId                                             OPTIONAL,   -- Need R","paragraph_zero_based":19221},{"literal_text_all_w_t_and_m_t":"    drx-ConfigSecondaryGroup-r16        SetupRelease { DRX-ConfigSecondaryGroup-r16 }                   OPTIONAL    -- Need M","paragraph_zero_based":19222},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":19223}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["c3d341b3eac9fe461254555b59fa0421af351a84ab80c1b8dc708ac79fdcfd5c","e9355f99d795b563f07fe6d68b052