{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field specifies the NCGI, the globally unique identity of a cell in NR, of the associated TRP, as defined in TS 38.331 [35]. ","paragraph_zero_based":2712},{"literal_text_all_w_t_and_m_t":"nr-ARFCN","paragraph_zero_based":2713},{"literal_text_all_w_t_and_m_t":"This field specifies the ARFCN of the TRP's CD-SSB (as defined in TS 38.300 [47]) corresponding to nr-PhysCellID associated with the dl-PRS-ID.","paragraph_zero_based":2714},{"literal_text_all_w_t_and_m_t":"nr-SFN","paragraph_zero_based":2715},{"literal_text_all_w_t_and_m_t":"This field specifies the NR system frame number for the time stamp.","paragraph_zero_based":2716},{"literal_text_all_w_t_and_m_t":"nr-Slot","paragraph_zero_based":2717},{"literal_text_all_w_t_and_m_t":"This field specifies the NR slot number within the NR system frame number indicated by nr-SFN for the time stamp.","paragraph_zero_based":2718},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2719},{"literal_text_all_w_t_and_m_t":"–NR-TimingQuality","paragraph_zero_based":2720},{"literal_text_all_w_t_and_m_t":"The IE NR-TimingQuality defines the quality of a timing value (e.g., of a TOA measurement).","paragraph_zero_based":2721},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":2722},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2723},{"literal_text_all_w_t_and_m_t":"NR-TimingQuality-r16 ::= SEQUENCE {","paragraph_zero_based":2724},{"literal_text_all_w_t_and_m_t":"timingQualityValue-r16INTEGER (0..31),","paragraph_zero_based":2725},{"literal_text_all_w_t_and_m_t":"timingQualityResolution-r16ENUMERATED {mdot1, m1, m10, m30, ...},","paragraph_zero_based":2726},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":2727},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2