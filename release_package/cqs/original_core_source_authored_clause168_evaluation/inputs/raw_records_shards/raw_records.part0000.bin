{"fields":{"filename":"R2-2311925.zip::R2-2311925_Introduction of BWP_Wor in TS38.331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE BWP-DownlinkDedicated is used to configure the dedicated (UE specific) parameters of a downlink BWP.","paragraph_zero_based":120},{"literal_text_all_w_t_and_m_t":"BWP-DownlinkDedicated information element","paragraph_zero_based":121},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":122},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-DOWNLINKDEDICATED-START","paragraph_zero_based":123},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":124},{"literal_text_all_w_t_and_m_t":"BWP-DownlinkDedicated ::=           SEQUENCE {","paragraph_zero_based":125},{"literal_text_all_w_t_and_m_t":"    pdcch-Config                        SetupRelease { PDCCH-Config }                                     OPTIONAL,   -- Need M","paragraph_zero_based":126},{"literal_text_all_w_t_and_m_t":"    pdsch-Config                        SetupRelease { PDSCH-Config }                                     OPTIONAL,   -- Need M","paragraph_zero_based":127},{"literal_text_all_w_t_and_m_t":"    sps-Config                          SetupRelease { SPS-Config }                                       OPTIONAL,   -- Need M","paragraph_zero_based":128},{"literal_text_all_w_t_and_m_t":"    radioLinkMonitoringConfig           SetupRelease { RadioLinkMonitoringConfig }                        OPTIONAL,   -- Need M","paragraph_zero_based":129},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":130},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":131},{"literal_text_all_w_t_and_m_t":"    sps-ConfigToAddModList-r16          SPS-ConfigToAddModList-r16                                        OPTIONAL,   -- Need N","paragraph_zero_based":132},{"literal_text_all_w_t_and_m_t":"    sps-ConfigToReleaseList-r16         SPS-ConfigToReleaseList-r16                                       OPTIONAL,   -- Need N","paragraph_zero_based":133},{"literal_text_all_w_t_and_m_t":"    sps-ConfigDeactivationStateList-r16 SPS-ConfigDeactivationStateList-r16                               OPTIONAL,   -- Need R","paragraph_zero_based":134},{"literal_text_all_w_t_and_m_t":"    beamFailureRecoverySCellConfig-r16  SetupRelease {BeamFailureRecoveryRSConfig-r16}                    OPTIONAL,   -- Cond SCellOnly","paragraph_zero_based":135},{"literal_text_all_w_t_and_m_t":"    sl-PDCCH-Config-r16                 SetupRelease { PDCCH-Config }                                     OPTIONAL,   -- Need M","paragraph_zero_based":136},{"literal_text_all_w_t_and_m_t":"    sl-V2X-PDCCH-Config-r16             SetupRelease { PDCCH-Config }                                     OPTIONAL    -- Need M","paragraph_zero_based":137},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":138},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":139},{"literal_text_all_w_t_and_m_t":"    preConfGapStatus-r17                BIT STRING (SIZE (maxNrofGapId-r17))                              OPTIONAL,   -- Cond PreConfigMG","paragraph_zero_based":140},{"literal_text_all_w_t_and_m_t":"    beamFailureRecoverySpCellConfig-r17 SetupRelease { BeamFailureRecoveryRSConfig-r16}                   OPTIONAL,   -- Cond SpCellOnly","paragraph_zero_based":141},{"literal_text_all_w_t_and_m_t":"    harq-FeedbackEnablingforSPSactive-r17 BOOLEAN                                                         OPTIONAL,   -- Need R","paragraph_zero_based":142},{"literal_text_all_w_t_and_m_t":"    cfr-ConfigMulticast-r17             SetupRelease { CFR-ConfigMulticast-r17 }                          OPTIONAL,   -- Need M","paragraph_zero_based":143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3cd3bd3ea6f05fcf1dde3ac1d5aa467822a74a179e280d98a06785c15716876d","original_mem