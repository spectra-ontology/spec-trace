{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39768},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39769},{"literal_text_all_w_t_and_m_t":"–CFR-ConfigMCCH-MTCH","paragraph_zero_based":39770},{"literal_text_all_w_t_and_m_t":"The IE CFR-ConfigMCCH-MTCH is used to configure the common frequency resource used for MCCH and MTCH reception.","paragraph_zero_based":39771},{"literal_text_all_w_t_and_m_t":"CFR-ConfigMCCH-MTCH information element","paragraph_zero_based":39772},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39773},{"literal_text_all_w_t_and_m_t":"-- TAG-CFR-CONFIGMCCH-MTCH-START","paragraph_zero_based":39774},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39775},{"literal_text_all_w_t_and_m_t":"CFR-ConfigMCCH-MTCH-r17 ::= SEQUENCE {","paragraph_zero_based":39776},{"literal_text_all_w_t_and_m_t":"    locationAndBandwidthBroadcast-r17          LocationAndBandwidthBroadcast-r17  OPTIONAL,  -- Need S","paragraph_zero_based":39777},{"literal_text_all_w_t_and_m_t":"    pdsch-ConfigMCCH-r17                       PDSCH-ConfigBroadcast-r17          OPTIONAL,  -- Need S","paragraph_zero_based":39778},{"literal_text_all_w_t_and_m_t":"    commonControlResourceSetExt-r17            ControlResourceSet                 OPTIONAL   -- Cond NotSIB1CommonControlResource","paragraph_zero_based":39779},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39780},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39781},{"literal_text_all_w_t_and_m_t":"LocationAndBandwidthBroadcast-r17 ::= CHOICE {","paragraph_zero_based":39782},{"literal_text_all_w_t_and_m_t":"    sameAsSib1ConfiguredLocationAndBW          NULL,","paragraph_zero_based":39783},{"literal_text_all_w_t_and_m_t":"    locationAndBandwidth                       INTEGER 