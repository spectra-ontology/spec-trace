{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18216},{"literal_text_all_w_t_and_m_t":"INT-ConfigurationPerServingCell ::= SEQUENCE {","paragraph_zero_based":18217},{"literal_text_all_w_t_and_m_t":"    servingCellId                       ServCellIndex,","paragraph_zero_based":18218},{"literal_text_all_w_t_and_m_t":"    positionInDCI                       INTEGER (0..maxINT-DCI-PayloadSize-1)","paragraph_zero_based":18219},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18220},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18221},{"literal_text_all_w_t_and_m_t":"-- TAG-DOWNLINKPREEMPTION-STOP","paragraph_zero_based":18222},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18223},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18224},{"literal_text_all_w_t_and_m_t":"DownlinkPreemption field descriptions","paragraph_zero_based":18225},{"literal_text_all_w_t_and_m_t":"dci-PayloadSize","paragraph_zero_based":18226},{"literal_text_all_w_t_and_m_t":"Total length of the DCI payload scrambled with INT-RNTI (see TS 38.213 [13], clause 11.2).","paragraph_zero_based":18227},{"literal_text_all_w_t_and_m_t":"int-ConfigurationPerServingCell","paragraph_zero_based":18228},{"literal_text_all_w_t_and_m_t":"Indicates (per serving cell) the position of the 14 bit INT values inside the DCI payload (see TS 38.213 [13], clause 11.2).","paragraph_zero_based":18229},{"literal_text_all_w_t_and_m_t":"int-RNTI","paragraph_zero_based":18230},{"literal_text_all_w_t_and_m_t":"RNTI used for indication pre-emption in DL (see TS 38.213 [13], clause 10).","paragraph_zero_based":18231},{"literal_text_all_w_t_and_m_t":"timeFrequencySet","paragraph_zero_based":18232},{"literal_text_all_w_t_and_m_t":"Set selection for DL-preemption indication (see TS 38.213 [13], clause 11.2) The set determines how the UE interprets the DL preemption DCI payload.","paragraph_zero_based":18233},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18234},{"literal_text_all_w_t_and_m_t":"INT-ConfigurationPerServingCell field descriptions","paragraph_zero_based":18235},{"literal_text_all_w_t_and_m_t":"positionInDCI","paragraph_zero_based":18236},{"literal_text_all_w_t_and_m_t":"Starting position (in number of bit) of the 14 bit INT value applicable for this serving cell (servingCellId) within the DCI payload (see TS 38.213 [13], clause 11.2). Must be multiples of 14 (bit).","paragraph_zero_based":18237},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18238},{"literal_text_all_w_t_and_m_t":"–DRB-Identity","paragraph_zero_based":18239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["c9ba697e023a72c775bce1703ad7e9073669a1994f8ce8f01843b564f78b0359","6ceba90066bc50a25bfd43f58a1d962820b7ae8a96a459e5aaf109cd8f408b28","74097adfdc8a5d2f030773e8df1c9003324bfe2833292d04eef81b9c9e8298e4","b47a39bc2feb86a3a6e6880b8da7eceb07cd2d81273ff2d4c2f1bac5416d5978","ae65c0aa8043f0ac745524e9a67fe2281361a40f4b554e4ab9d521e7dc59ad3a","630bcd222142c1a82609ed25cf381deca56a9f73ad347eacdda00ead5f0357de","858e789c49edd9fd3f1d2ee6f803b4dd7402d7033fb5db56386f9b1c5c6dfd86","bb5b0eccec5c879ade3eceda7a80f671e96e7ba6522d7e21cb643caec63eaa90","249495755e361bd19667e9fe1d4de97ec79161155df6edca31599c974ccdb727","6cfb0d239d9fa7773dea4638424993626c55569d1f646ee8b698d3d71b3dd84b","6464eb7b9bc4bbd744862691324c7f587292a20f0d4eb314db0693c5db1cd555","a14541e9ae96d233f3d0e1532e8b91558794b919fb52cb1b78652222ce744aad","86ede3af2b7de51733d4cea9062cbf36807b01cb613c9167c4c398ee18322320","e