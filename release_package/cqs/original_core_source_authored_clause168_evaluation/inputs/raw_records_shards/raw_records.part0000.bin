{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-measGapConfigFR2 (for which delta signaling applies);","paragraph_zero_based":44280},{"literal_text_all_w_t_and_m_t":"-measResultCellListSFTD;","paragraph_zero_based":44281},{"literal_text_all_w_t_and_m_t":"-measResultSFTD-EUTRA;","paragraph_zero_based":44282},{"literal_text_all_w_t_and_m_t":"-sftdFrequencyList-EUTRA;","paragraph_zero_based":44283},{"literal_text_all_w_t_and_m_t":"-sftdFrequencyList-NR;","paragraph_zero_based":44284},{"literal_text_all_w_t_and_m_t":"-ue-CapabilityInfo;","paragraph_zero_based":44285},{"literal_text_all_w_t_and_m_t":"-servFrequenciesMN-NR.","paragraph_zero_based":44286},{"literal_text_all_w_t_and_m_t":"For other fields in CG-Config and CG-ConfigInfo, the sender shall always signal the appropriate value even if same as indicated in the previous inter-node message, unless explicitly stated otherwise.","paragraph_zero_based":44287},{"literal_text_all_w_t_and_m_t":"11.3Inter-node RRC information element definitions","paragraph_zero_based":44288},{"literal_text_all_w_t_and_m_t":"–ResourceConfigNRDC","paragraph_zero_based":44289},{"literal_text_all_w_t_and_m_t":"The IE is used to indicate or request the maximum values that can be used by the SCG in NR-DC, with each value equal to or lower than the value of the corresponding field in the UE capability, as reported by the UE, unless specified otherwise.","paragraph_zero_based":44290},{"literal_text_all_w_t_and_m_t":"ResourceConfigNRDC information element","paragraph_zero_based":44291},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":44292},{"literal_text_all_w_t_and_m_t":"-- TAG-RESOURCECONFIGNRDC-START","paragraph_zero_based":44293},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44294},{"literal_text_all_w_t_and_m_t":"ResourceConfigNRDC-r17 ::= SEQUENCE