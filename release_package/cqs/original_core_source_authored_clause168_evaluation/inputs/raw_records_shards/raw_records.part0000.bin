},{"literal_text_all_w_t_and_m_t":"1>sets the NDIs for all HARQ process IDs to the value 0 for monitoring PDCCH in Sidelink resource allocation mode 1;","paragraph_zero_based":140},{"literal_text_all_w_t_and_m_t":"1>stop, if any, ongoing Random Access procedure;","paragraph_zero_based":141},{"literal_text_all_w_t_and_m_t":"1>discard explicitly signalled contention-free Random Access Resources for 4-step RA type and 2-step RA type, if any;","paragraph_zero_based":142},{"literal_text_all_w_t_and_m_t":"1>flush Msg3 buffer;","paragraph_zero_based":143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bde1953134afc7232c3b85bbe56f17a18335b0467ee90fb1e9fe1e0ffc4a998f","original_member_sha256":"5226f282075a722b4cebe17bdc4641f967c0f2298a5db15c2df09f33f91ba38f","paragraph_ElementTree_utf8_XML_sha256":["4be865076d9a636a68189733f0abaf076f7482b2501a43ec0106b8be692d58df","8f2297822a9631a2b1e1758afc2386cc7f4af5455bee95da74d00e489d47491d","63ef285bda977c4c925d85123428af076c32cba8858b5fc8bd4bcc0caa2a0aae","fa95302cb50acca2a6b2c65c464eb2aa47abc3aaf4166c85c5a39b5ae6f6ea1a","457acd554b3d1ce009db4f216c93fa9c15621c0c297ff5931a417bd427661753","91f488fe4ea750367681bc0b09e7a3be7770ffec32dff883077b7c6c890c0e86","e738e92b5478fc661007b2993b34e20e07e0117b5085b9287b07aec58f90b20b","30dd9aa0667809673ff088592ef3e43e842efdf5d9efb7fbf2c14173a65bfd1a","315c49290bb449a0227880324de27e60a71341ff3317446daaff185e308cf1d9","05c8666e410a0bdb95b5e0ce7847ea3c2e5a474a0a66820482112aafe018e0fa","6c6e8e80671895077c5f675c07dda8034e825ebb8855158ba204d846f6381594","2e2eb35077e07115901c68783ba45e9a29b8898f97b704590987d9a118de09c8","f4a3d4c9dd790e912f593bceb25771ce7dbbaad1a9923b9150513bdcde2873f0","9b2db9d18f2dfb99d85d88e9d88fd41024f529b0b5f4ef498525f05ba1076da7","b2c603e2ef331c2e0e083680510365116c26613a226b5eadb4fd5adb585130f5","f67f33e4d4af5a143938e988d2ce370073853a67f0e4accd1c26402e9143d0ec","3a2512b66b16106c791