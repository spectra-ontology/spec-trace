{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Direction: en-gNB to eNB, eNB to en-gNB, gNB to gNB, ng-eNB to gNB, gNB to ng-eNB, ng-eNB to ng-eNB, gNB DU to gNB CU, and gNB CU to gNB DU.","paragraph_zero_based":44088},{"literal_text_all_w_t_and_m_t":"MeasurementTimingConfiguration message","paragraph_zero_based":44089},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":44090},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASUREMENT-TIMING-CONFIGURATION-START","paragraph_zero_based":44091},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44092},{"literal_text_all_w_t_and_m_t":"MeasurementTimingConfiguration ::=      SEQUENCE {","paragraph_zero_based":44093},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                      CHOICE {","paragraph_zero_based":44094},{"literal_text_all_w_t_and_m_t":"        c1                                      CHOICE{","paragraph_zero_based":44095},{"literal_text_all_w_t_and_m_t":"            measTimingConf                          MeasurementTimingConfiguration-IEs,","paragraph_zero_based":44096},{"literal_text_all_w_t_and_m_t":"            spare3 NULL, spare2 NULL, spare1 NULL","paragraph_zero_based":44097},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":44098},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture        SEQUENCE {}","paragraph_zero_based":44099},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":44100},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44101},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44102},{"literal_text_all_w_t_and_m_t":"MeasurementTimingConfiguration-IEs ::=  SEQUENCE {","paragraph_zero_based":44103},{"literal_text_all_w_t_and_m_t":"    measTiming                              MeasTimingList                                      OPTIONAL,","paragraph_zero_based":44104},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                    MeasurementTimingConfiguration-v1550-IEs            OPTIONAL","paragraph_zero_based":44105},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44106},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44107},{"literal_text_all_w_t_and_m_t":"MeasurementTimingConfiguration-v1550-IEs ::= SEQUENCE {","paragraph_zero_based":44108},{"literal_text_all_w_t_and_m_t":"    campOnFirstSSB                               BOOLEAN,","paragraph_zero_based":44109},{"literal_text_all_w_t_and_m_t":"    psCellOnlyOnFirstSSB                         BOOLEAN,","paragraph_zero_based":44110},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                         MeasurementTimingConfiguration-v1610-IEs       OPTIONAL","paragraph_zero_based":44111}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["9f0db8114d17d709a4e2be10840f7809e763784d3c772f46f9bb4f3582c10069","ccc268539c8bee5527d4d5d671c4126afc8f4885749fa54ea7227a7471ffe1c2","d82c4469558126d45d34291927bc0dfbeeaa505cc5e4d1a70fc22db2ab70b5c7","e7ea986fe5bf4e16e899c08bf10e4fee71e12944a60321383ae4f10ce5bf4d1d","9b219419d239905fe8fbdecb255d0e7af6acea0d3a0dba5b1e88af4a09488b72","5ad996f3fbb3af9d5e8798350e24de05b6850562c211deda19358112ca94a997","2586cd08c661612d77ba673efe21a8243148e6f5442dbbb9765c05e0fa4530a2","00d921bee72c826d46109c377d90f71fb6d371a9165ff6cbb12b9846e40a859d","7a6af0e1bd7ef2da049cd7f74e01be88da22f2ad80e8d2f66d8bdc93d49e42dc","4251c68d9eaec7ac0fe206c0721de81eb9a1118ecc50f4295e24d5cae6a066f6","9d3f464d38c297381c8070731c0acef645483a41e0bc142af2203049fcff4a67","f4e81f8b9ee51b5417e1819085a38c8d0b9ddd85736d