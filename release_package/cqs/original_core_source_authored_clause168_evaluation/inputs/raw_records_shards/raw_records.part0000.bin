{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"MBSInterestIndication-r17-IEs ::= SEQUENCE {","paragraph_zero_based":9240},{"literal_text_all_w_t_and_m_t":"    mbs-FreqList-r17                  CarrierFreqListMBS-r17              OPTIONAL,","paragraph_zero_based":9241},{"literal_text_all_w_t_and_m_t":"    mbs-Priority-r17                  ENUMERATED {true}                   OPTIONAL,","paragraph_zero_based":9242},{"literal_text_all_w_t_and_m_t":"    mbs-ServiceList-r17               MBS-ServiceList-r17                 OPTIONAL,","paragraph_zero_based":9243},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension          OCTET STRING                        OPTIONAL,","paragraph_zero_based":9244},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension              SEQUENCE {}                         OPTIONAL","paragraph_zero_based":9245},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":9246},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9247},{"literal_text_all_w_t_and_m_t":"-- TAG-MBSINTERESTINDICATION-STOP","paragraph_zero_based":9248},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":9249},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9250},{"literal_text_all_w_t_and_m_t":"MBSInterestIndication field descriptions","paragraph_zero_based":9251},{"literal_text_all_w_t_and_m_t":"mbs-FreqList","paragraph_zero_based":9252},{"literal_text_all_w_t_and_m_t":"List of MBS frequencies on which the UE is receiving or interested to receive MBS broadcast service via a broadcast MRB.","paragraph_zero_based":9253},{"literal_text_all_w_t_and_m_t":"mbs-Priority","paragraph_zero_based":9254},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE prioritises MBS broadcast reception above unicast and MBS multicast reception. The field is present (i.e. value true), if th