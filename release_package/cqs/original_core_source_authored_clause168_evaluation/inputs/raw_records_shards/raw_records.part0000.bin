{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field provides the y-value of the location in the Cartesian coordinate system. Positive value represents northing from reference point (origin) [15]. See IE RelativeCartesianLocation.","paragraph_zero_based":576},{"literal_text_all_w_t_and_m_t":"z-value","paragraph_zero_based":577},{"literal_text_all_w_t_and_m_t":"This field provides the z-value of the location in the Cartesian coordinate system. Positive value represents height above reference point (origin) [15]. See IE RelativeCartesianLocation.","paragraph_zero_based":578},{"literal_text_all_w_t_and_m_t":"uncertaintySemiMajor","paragraph_zero_based":579},{"literal_text_all_w_t_and_m_t":"This field indicates the semi-major axis of the uncertainty ellipsoid [15].","paragraph_zero_based":580},{"literal_text_all_w_t_and_m_t":"uncertaintySemiMinor","paragraph_zero_based":581},{"literal_text_all_w_t_and_m_t":"This field indicates the semi-minor axis of the uncertainty ellipsoid [15].","paragraph_zero_based":582},{"literal_text_all_w_t_and_m_t":"orientationMajorAxis","paragraph_zero_based":583},{"literal_text_all_w_t_and_m_t":"This field indicates the orientation angle of the major axis [15].","paragraph_zero_based":584},{"literal_text_all_w_t_and_m_t":"uncertaintyAltitude","paragraph_zero_based":585},{"literal_text_all_w_t_and_m_t":"This field indicates the vertical axis of the uncertainty ellipsoid [15].","paragraph_zero_based":586},{"literal_text_all_w_t_and_m_t":"confidence","paragraph_zero_based":587},{"literal_text_all_w_t_and_m_t":"This field indicates the confidence value [15].","paragraph_zero_based":588},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":589},{"literal_text_all_w_t_and_m_t":"–LocationCoordinateTypes","paragraph_zero_based":590},{"literal_text_all_w_t_and_m_t":"The IE Loc