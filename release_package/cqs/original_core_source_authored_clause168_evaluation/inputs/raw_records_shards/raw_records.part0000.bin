          SL-DestinationIdentity-r16                                      OPTIONAL -- Need M","paragraph_zero_based":2679},{"literal_text_all_w_t_and_m_t":"}                                                                                                                OPTIONAL, -- Need M","paragraph_zero_based":2680},{"literal_text_all_w_t_and_m_t":"sl-PeerRemoteUE-LocalIdentity-Config-r18                SEQUENCE {                                                  ","paragraph_zero_based":2681},{"literal_text_all_w_t_and_m_t":"sl-PeerRemoteUE-LocalIdentity-r18                INTEGER (0..255)                                                 OPTIONAL, -- Need M","paragraph_zero_based":2682},{"literal_text_all_w_t_and_m_t":"sl-PeerRemoteUE-L2Identity-r18                   SL-DestinationIdentity-r16                                      OPTIONAL -- Need M","paragraph_zero_based":2683},{"literal_text_all_w_t_and_m_t":"}                                                                                                                OPTIONAL -- Need M","paragraph_zero_based":2684},{"literal_text_all_w_t_and_m_t":" ","paragraph_zero_based":2685},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2686},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SRAP-CONFIGPC5-STOP","paragraph_zero_based":2687}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ffe6aa9e169eee2e55d5910307b90f1a0088b587d5b1b62ff44829994c9db517","original_member_sha256":"470fa87ca234afd3cdd6813f454487933839ab990f95bcfa5c1735fcd90b61bf","paragraph_ElementTree_utf8_XML_sha256":["677bd5c7be6ce03fbc91744b23304c95b0ab566520a8ad02a072ce409513f79a","ccd7b3691d9ae5f77ae87ad5893c62ba0cc84490b572fdcae7f4dbe365f3aaec","ac49105181222e310998c55cc03c44673f85799bbf904854395fe42e3f107fc2","3266f4c2174d5b79e9f091c2c68d695e6dc53a3c44dbc9d05caad23f3f04f59e","3efcd3621510547ba90bd379d1758301ffd985b73930fa8a656a5251e1477c7b","2a