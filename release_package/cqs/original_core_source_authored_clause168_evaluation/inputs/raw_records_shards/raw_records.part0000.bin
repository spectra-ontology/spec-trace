{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":4440},{"literal_text_all_w_t_and_m_t":"1>if gapFR1 is set to setup:","paragraph_zero_based":4441},{"literal_text_all_w_t_and_m_t":"2>if an FR1 measurement gap configuration configured by gapFR1 is already setup, release the FR1 measurement gap configuration;","paragraph_zero_based":4442},{"literal_text_all_w_t_and_m_t":"2>setup the FR1 measurement gap configuration indicated by the gapFR1 in accordance with the received gapOffset, i.e., the first subframe of each gap occurs at an SFN and subframe meeting the following condition:","paragraph_zero_based":4443},{"literal_text_all_w_t_and_m_t":"SFN mod T = FLOOR(gapOffset/10);","paragraph_zero_based":4444},{"literal_text_all_w_t_and_m_t":"subframe = gapOffset mod 10;","paragraph_zero_based":4445},{"literal_text_all_w_t_and_m_t":"with T = MGRP/10 as defined in TS 38.133 [14];","paragraph_zero_based":4446},{"literal_text_all_w_t_and_m_t":"2>apply the specified timing advance mgta to the gap occurrences calculated above (i.e. the UE starts the measurement mgta ms before the gap subframe occurrences);","paragraph_zero_based":4447},{"literal_text_all_w_t_and_m_t":"1>else if gapFR1 is set to release:","paragraph_zero_based":4448},{"literal_text_all_w_t_and_m_t":"2>release the FR1 measurement gap configuration configured by gapFR1;","paragraph_zero_based":4449},{"literal_text_all_w_t_and_m_t":"1>if gapFR2 is set to setup:","paragraph_zero_based":4450},{"literal_text_all_w_t_and_m_t":"2>if an FR2 measurement gap configuration configured by gapFR2 is already setup, release the FR2 measurement gap configuration;","paragraph_zero_based":4451},{"literal_text_all_w_t_and_m_t":"2>setup the FR2 measurement gap configuration indicated by the gapFR2 in accordance with the received gapOffset, i.e., the first subframe of each gap occurs at an SFN and subframe meeting the following condition:","paragraph_zero_based":4452},{"literal_text_all_w_t_and_m_t":"SFN mod T = FLOOR(gapOffset/10);","paragraph_zero_based":4453},{"literal_text_all_w_t_and_m_t":"subframe = gapOffset mod 10;","paragraph_zero_based":4454},{"literal_text_all_w_t_and_m_t":"with T = MGRP/10 as defined in TS 38.133 [14];","paragraph_zero_based":4455},{"literal_text_all_w_t_and_m_t":"2>apply the specified timing advance mgta to the gap occurrences calculated above (i.e. the UE starts the measurement mgta ms before the gap subframe occurrences);","paragraph_zero_based":4456},{"literal_text_all_w_t_and_m_t":"1>else if gapFR2 is set to release:","paragraph_zero_based":4457},{"literal_text_all_w_t_and_m_t":"2>release the FR2 measurement gap configuration configured by gapFR2;","paragraph_zero_based":4458},{"literal_text_all_w_t_and_m_t":"1>if gapUE is set to setup:","paragraph_zero_based":4459},{"literal_text_all_w_t_and_m_t":"2>if a per UE measurement gap configuration configured by gapUE is already setup, release the per UE measurement gap configuration;","paragraph_zero_based":4460},{"literal_text_all_w_t_and_m_t":"2>setup the per UE measurement gap configuration indicated by the gapUE in accordance with the received gapOffset, i.e., the first subframe of each gap occurs at an SFN and subframe meeting the following condition:","paragraph_zero_based":4461},{"literal_text_all_w_t_and_m_t":"SFN mod T = FLOOR(gapOffset/10);","paragraph_zero_based":4462},{"literal_text_all_w_t_and_m_t":"subframe = gapOffset mod 10;","paragraph_zero_based":4463}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["f5385dd9fd08b9