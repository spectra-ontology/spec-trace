{"fields":{"filename":"R2-2301433.zip::R2-2301433 Orbit and Tropo.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"TropoDelayIntegrityErrorBounds-r17 ::= SEQUENCE {","paragraph_zero_based":312},{"literal_text_all_w_t_and_m_t":"meanTroposphereVerticalHydroStaticDelay-r17INTEGER (0..255),","paragraph_zero_based":313},{"literal_text_all_w_t_and_m_t":"stdDevTroposphereVerticalHydroStaticDelay-r17INTEGER (0..255),","paragraph_zero_based":314},{"literal_text_all_w_t_and_m_t":"meanTroposphereVerticalWetDelay-r17INTEGER (0..255),","paragraph_zero_based":315},{"literal_text_all_w_t_and_m_t":"stdDevTroposphereVerticalWetDelay-r17INTEGER (0..255),","paragraph_zero_based":316},{"literal_text_all_w_t_and_m_t":"meanTroposphereVerticalHydroStaticDelayRate-r17INTEGER (0..255),","paragraph_zero_based":317},{"literal_text_all_w_t_and_m_t":"stdDevTroposphereVerticalHydroStaticDelayRate-r17INTEGER (0..255),","paragraph_zero_based":318},{"literal_text_all_w_t_and_m_t":"meanTroposphereVerticalWetDelayRate-r17INTEGER (0..255),","paragraph_zero_based":319},{"literal_text_all_w_t_and_m_t":"stdDevTroposphereVerticalWetDelayRate-r17INTEGER (0..255),","paragraph_zero_based":320},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":321},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":322},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":323},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":324},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":325},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":326},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":327},{"literal_text_all_w_t_and_m_t":"Tropo","paragraph_zero_based":328},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if tropospericDelayCorrection is included in gridList. Otherwise it is not present.","paragraph_zero_based":329},{"literal_text_all_w_t_and_m_t":"NotProvidedForOther","paragraph_zero_based":330},{"literal_text_all_w_t_and_m_t":"This field is not present if the tropospericDelayCorrection is provided for another GNSS in the same epoch","paragraph_zero_based":331},{"literal_text_all_w_t_and_m_t":"Integrity1","paragraph_zero_based":332},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if SSR-GriddedCorrectionIntegrityParameters is present; otherwise it is not present.","paragraph_zero_based":333},{"literal_text_all_w_t_and_m_t":"Integrity2","paragraph_zero_based":334},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if troposphereRangeErrorCorrelationTime is present; otherwise it is not present.","paragraph_zero_based":335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"fb8ec76fc8fff2631a54eea3056fb58660493df02c08adfc8f87a29b6647ca9c","original_member_sha256":"c372cd2cebbb02ac4d53a8ac60ad70ed83b67917bcef75f23e4950c4d4dce8c5","paragraph_ElementTree_utf8_XML_sha256":["997f94fbba9136962f5a8f960196b5144a112e03926a98c1be57442fee9bffcb","2ae501de8363a9053c0b9c7ce08da932ef82c67afa55c89274032a55582e8b91","60e3dcf09a1713e4b2f1ba674916ac1a42b1c09e944ec71e6a94ed63f2cb5168","75877e610750a5ce9bea5091e57a4ade6c8f389345fe69fd293dcae3fd142dba","a6074522df73a6e0b9846cc1af69bc477e019c7261fde09c1eb3e8e9033a1f5c","9f658200d2d82f526df5594228c0d7f70d5dd945727ed0bf1d62b378c4abe49f","da22cc3d8dd977ccab07bb81ed2010639d013edab0a3de4114c050c828bf52a5","9b1c0de3533fa49c9df385ec98bccc016cac8daf603826fbddd3dbf4c133a26a","fef703925aeb921d558b0e5abf62ad087dd6f3ea3a21c23c205b7c8903c6c3d1","c213159a8b739d3841c26cb8b3604986e4aa187969704dcb3f15fa8879631841","ba7a3d577c6e3fc7da884f6679001e1157dabbf205feb53a732bd9360f39f1d6","03347d754bd897fc83b8330b0b550aef465b79e9e0a5e94e1d762c863df1fe9a","9aaf8194230b6f2795f305c340501de9b05b96bbd187cd647be6beafb33000d2","2dfee8263d99942b2b589d47827c4c4b1c1252b437090e5eefcae8b5cce0afd4","975a0c6e90179f9c83b2d4c232095f11b08d0d301d009f65ec91cccb745ef4ba","7ce65a24da828927c269c2ea8116da91156d87cc20964f064494cfcc24cd600d","b1f26e41c75bd657451ab37896f451c86bee532a1b7fe0dde1cf88011e6ee51c","a801af7406b99cf326f4c518785816b88fef85165a4d99878d457624f20eadcb","57a9de65af204fb960575fff8788c5b6ccb092798b497eb01997027074f9e9f1","ae06209eb20c5fd0aceee74a4905556d295bfcd1e7ca0d08f13ad102299e6932","dfd8f64b6616353eedbbe5a9a6af083ae99b3881d83207264c84f6881726d74d","efb82dad84d24a10cb8559cf765d72e00bf585238e603bc1ee842d2be2f8ed64","da654531de6214f9da4dc1ffda225dd58d082c4c0417e8d517dce880e783b3fa","0b552b284a5b41a30f6c9afb2c39df7f6cb2cb7f1971192617a8c8d1b1e44e6f"],"paragraph_range_zero_based":[312,335],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2301433.zip::R2-2301433 Orbit and Tropo.docx:p312"}
{"fields":{"filename":"R2-2301433.zip::R2-2301433 Orbit and Tropo.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":336},{"literal_text_all_w_t_and_m_t":"GNSS-SSR-GriddedCorrection field descriptions","paragraph_zero_based":337},{"literal_text_all_w_t_and_m_t":"epochTime","paragraph_zero_based":338},{"literal_text_all_w_t_and_m_t":"This field specifies the epoch time of the gridded correction data. The gnss-TimeID in GNSS-SystemTime shall be the same as the GNSS-ID in IE GNSS-GenericAssistDataElement. ","paragraph_zero_based":339},{"literal_text_all_w_t_and_m_t":"ssrUpdateInterval","paragraph_zero_based":340},{"literal_text_all_w_t_and_m_t":"This field specifies the SSR Update Interval. The SSR Update Intervals for all SSR parameters start at time 00:00:00 of the GPS time scale. A change of the SSR Update Interval during the transmission of SSR data should ensure consistent data for a target device. See table Value of ssrUpdateInterval to SSR Update Interval relation in IE GNSSSSROrbitCorrections.","paragraph_zero_based":341},{"literal_text_all_w_t_and_m_t":"iod-ssr","paragraph_zero_based":342},{"literal_text_all_w_t_and_m_t":"This field specifies the Issue of Data number for the SSR data. A change of iod-ssr is used to indicate a change in the SSR generating configuration. ","paragraph_zero_based":343},{"literal_text_all_w_t_and_m_t":"troposphericDelayQualityIndicator","paragraph_zero_based":344},{"literal_text_all_w_t_and_m_t":"This field specifies the quality indicator of the tropospheric delay. The troposphere quality indicator is represented by a combination of CLASS and VALUE. The 3 MSB define the CLASS with a range of 0-7 and the 3 LSB define the VALUE with a range of 0-7. The troposphere quality indicator is computed by:","paragraph_zero_based":345},{"literal_text_all_w_t_and_m_t":"SSR Troposphere Quality [mm] ≤ 3CLASS1+VALUE4-1  [mm]","paragraph_zero_based":346},{"literal_text_all_w_t_and_m_t":"See Table 'Relationship between SSR troposphere quality and URA indicator and physical quantity' below.","paragraph_zero_based":347},{"literal_text_all_w_t_and_m_t":"correctionPointSetID","paragraph_zero_based":348},{"literal_text_all_w_t_and_m_t":"This field provides the ID of the GNSS-SSR-CorrectionPoints set. The GNSS-SSR-GriddedCorrection are valid for the correction points provided in IE GNSS-SSR-CorrectionPoints with the same correctionPointSetID.","paragraph_zero_based":349},{"literal_text_all_w_t_and_m_t":"gridList","paragraph_zero_based":350},{"literal_text_all_w_t_and_m_t":"This field provides the troposphere delay correction together with the residual part of the STEC corrections for up to 64 correction points defined in IE GNSS-SSR-CorrectionPoints.","paragraph_zero_based":351},{"literal_text_all_w_t_and_m_t":"If the IE GNSS-SSR-CorrectionPoints, which belongs to the correctionPointSetID, includes the listOfCorrectionPoints, the gridList includes the same number of entries, and listed in the same order, as in the listOfCorrectionPoints.","paragraph_zero_based":352},{"literal_text_all_w_t_and_m_t":"If the IE GNSS-SSR-CorrectionPoints, which belongs to this correctionPointSetID, includes the arrayOfCorrectionPoints the gridList includes the same number of entries, and listed in the same order, as defined by the enabled bits in the bitmaskOfGrids.","paragraph_zero_based":353},{"literal_text_all_w_t_and_m_t":"tropospericDelayCorrection","paragraph_zero_based":354},{"literal_text_all_w_t_and_m_t":"This field specifies information element with the troposphere vertical delay components. It is only provided with at most one GNSS constellation, and if provided it is valid for all GNSS constellations. If it is provided with a different GNSS constellation the field is not provided with other GNSS constellations for the same epoch.","paragraph_zero_based":355},{"literal_text_all_w_t_and_m_t":"tropoHydroStaticVerticalDelay","paragraph_zero_based":356},{"literal_text_all_w_t_and_m_t":"This field specifies the variation in the hydro static troposphere vertical delay relative to nominal value. The target device should add the constant nominal value of 2.3 m to calculate the tropospheric hydro-static vertical delay.","paragraph_zero_based":357},{"literal_text_all_w_t_and_m_t":"Scale factor 0.004 m; range ±1.02 m.","paragraph_zero_based":358},{"literal_text_all_w_t_and_m_t":"tropoWetVerticalDelay","paragraph_zero_based":359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"fb8ec76fc8fff2631a54eea3056fb58660493df02c08adfc8f87a29b6647ca9c","original_member_sha256":"c372cd2cebbb02ac4d53a8ac60ad70ed83b67917bcef75f23e4950c4d4dce8c5","paragraph_ElementTree_utf8_XML_sha256":["a676567e1c819a316987a0eb41515a0aee9a6f3e8e61fe119118f50d927c7277","21bd02f46b13b0ff4a30a5e6ff59542ed2b4e1bd21d57da829e4e94fe9be5c8f","7c9a0da6ad2e9f9cb3c2ad15cd8be5643b3cb4084695b6217be360ea3fc08790","d257b949cb8330079f6385e4aee7a9fc767a27bdacc2e121e421f9240ac08295","e74ac066f3c786f747cd9842c3f03ab07c1d568e889980cac626fadf36e12fda","665882d927beed9cb883d8bca25ea85b3b39a2325e7b62106783f71d53c76753","e9ceaa99084381dc5270931757c8da7e303fe82943db6d8dbfa993fbb19a2a98","2b5067e4b7c8df8157ef7f95d290112da9b58d5e0a7bd366cd59ea800f166228","6ef471a08019c9fd0cd3a1c4ce259056e41b89cbeb81d4dcfdfc1ccbe8e58bf5","42bcf62d99f7923bbceb4b710e49e435e0fc6622f9b2b2aae1dba21f974587a8","86f700bfb6d79db2825a11a50eaca0036b1721f9a8ba7a9eb6da84c80f788d49","47cc467fcfe3f50a0f9422295f035d4014cf78d1c30c06df89a1c03d71b89049","747c7d74ebe1af7a7777e09147a5b7fdddfecea5d7aab3d5f77a5f094c249c7e","b31205eb98a939374ffadcda90f525296c5f8ad00ec66f0e02f8e2af778ea028","8fd19bd869539327e904154b0c48ed9071afffa64f2527129957cdca07575048","f92b0668acea8a9c71fae202da4ea5f626c50dd924225d89ce3aafb0178f1478","23b075477e0141223aba9b57b328dbbdd0a7d779bf480bfdf2c4b264d7f4c99e","24c5cf3ba5fd4c0108356d20ad848d9c3842c7099ad945c78afc25d9fa39b197","985dbd126600812206515bc351b0087fbadb945d8e6644cad9e60116f073ad99","9bf6e0c5c317671b78c6e721de1b0d045830027e3767b120b41092a7e59925ed","8e607f55e7ea2ab9267ad7e75f5be580a72163b21b557b2119a8cdfd2e1431c3","d5e624d8dbfc33f262525ab6c505cfa94af331ae060f8e6740e8c223bfe28e62","2584db0afdd26861d17f1f3f1be4d39edcfb75046d15f464f3e1c5ad18bde4a3","702249be03ee37ed98beff67ee9595d2d159b6e75fb040c1ef5b32b30069464d"],"paragraph_range_zero_based":[336,359],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2301433.zip::R2-2301433 Orbit and Tropo.docx:p336"}
{"fields":{"filename":"R2-2301433.zip::R2-2301433 Orbit and Tropo.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field specifies the variation in the wet troposphere vertical delay relative to nominal value. The target device should add the constant value of 0.252 m to calculate the tropospheric wet (non hydro-static) vertical delay.","paragraph_zero_based":360},{"literal_text_all_w_t_and_m_t":"Scale factor 0.004 m; range ±0.508 m.","paragraph_zero_based":361},{"literal_text_all_w_t_and_m_t":"svID","paragraph_zero_based":362},{"literal_text_all_w_t_and_m_t":"This field specifies the GNSS satellite for which the STEC residual corrections are provided.","paragraph_zero_based":363},{"literal_text_all_w_t_and_m_t":"stecResidualCorrection","paragraph_zero_based":364},{"literal_text_all_w_t_and_m_t":"This field specifies the STEC residual correction.","paragraph_zero_based":365},{"literal_text_all_w_t_and_m_t":"Scale factor 0.04 TECU; range ±2.52 TECU (b7) or ±1310.68 TECU (b16).","paragraph_zero_based":366},{"literal_text_all_w_t_and_m_t":"probOnsetTroposphereFault","paragraph_zero_based":367},{"literal_text_all_w_t_and_m_t":"This field specifies the Probability of Onset of Troposphere Fault per Time Unit which is the probability of occurrence of troposphere error to exceed the residual error bound for more than the Time to Alert (TTA) This field specifies the onset probability that the residual range or range rate error exceeds a bound created using the minimum allowed inflation factor Kmin, and bounding parameters as mean + Kmin * stdDev where Kmin = normInv(irMaximum / 2) and irMaximum as provided in IE GNSS-Integrity-ServiceParameters.","paragraph_zero_based":368},{"literal_text_all_w_t_and_m_t":"The probability is calculated by P=10-0.04n [hour-1] where n is the value of probOnsetTroposphereFault and the range is 10-10.2 to 1 per hour.","paragraph_zero_based":369},{"literal_text_all_w_t_and_m_t":"meanTroposphereFaultDuration","paragraph_zero_based":370},{"literal_text_all_w_t_and_m_t":"This field specifies the Mean Troposphere Fault Duration which is the mean duration between when a troposphere integrity violation occurs, and the user is alerted through GNSS-Integrity-ServiceAlert (or the integrity violation is over).","paragraph_zero_based":371},{"literal_text_all_w_t_and_m_t":"Scale factor 1 s; range 1-256 s.","paragraph_zero_based":372},{"literal_text_all_w_t_and_m_t":"troposphereRangeErrorCorrelationTime","paragraph_zero_based":373},{"literal_text_all_w_t_and_m_t":"This field specifies the Troposphere Range Error Correlation Time which is the upper bound of the correlation time of the troposphere residual range error.","paragraph_zero_based":374},{"literal_text_all_w_t_and_m_t":"The time is calculated using:","paragraph_zero_based":375},{"literal_text_all_w_t_and_m_t":"t=10i,                                                         &i≤1801800+100(i-180),  180<&i≤234 7200+1000i-234,                    &i>234 [s]","paragraph_zero_based":376},{"literal_text_all_w_t_and_m_t":"Range is 1-28,200 s.","paragraph_zero_based":377},{"literal_text_all_w_t_and_m_t":"troposphereRangeRateErrorCorrelationTime","paragraph_zero_based":378},{"literal_text_all_w_t_and_m_t":"This field specifies the Troposphere Range Rate Error Correlation Time which is the upper bound of the correlation time of the troposphere residual range rate error.","paragraph_zero_based":379},{"literal_text_all_w_t_and_m_t":"The time is calculated using:","paragraph_zero_based":380},{"literal_text_all_w_t_and_m_t":"t=10i,                                                         &i≤1801800+100(i-180),  180<&i≤234 7200+1000i-234,                    &i>234 [s]","paragraph_zero_based":381},{"literal_text_all_w_t_and_m_t":"Range is 1-28,200 s.","paragraph_zero_based":382},{"literal_text_all_w_t_and_m_t":"meanTroposphereVerticalHydroStaticDelay","paragraph_zero_based":383}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"fb8ec76fc8fff2631a54eea3056fb58660493df02c08adfc8f87a29b6647ca9c","original_member_sha256":"c372cd2cebbb02ac4d53a8ac60ad70ed83b67917bcef75f23e4950c4d4dce8c5","paragraph_ElementTree_utf8_XML_sha256":["c51604bee15e8635584894950ddfd288fd47d9cf096d90124adfbc5a60e95db0","977f15cfa47bf5eed9898855db5ea181ef021ce33fd2dc18ae4a77d282230a46","e081dac7ff56d611b6d42a2c28000e57457fe92b9599ab4ea189d16f3b33e3b5","fd1ee0838654c37f451c7114addda18f8b88140d28a128990bb279c82e19668c","3fcfa4a944a59be8a1b4dee50208782205e3ee514998765ecf03db283c4239d9","2be32da052b7d6da67a055327e18a3d6e2b3e283aeb643c66c936697ea365dd2","c4da9ee0e404ef36b936245c435a68c71ccf5f46e4d81f236844a20dbb3a8d64","ec291659f3ddec77fbff52f41a3a5e67752ab07fb0381ab27f36ddbbecbd7cd1","1954021b4b8245939448166462676d63407dbbb615be926f82ec42f8ebeb1a11","81b8eaee3213aae6ba569e41ce7f575d2bf8de989c29fcd1404b373e2f7e30fd","6703e5212c6916cb43e4fdf20ae3a242d1169bf6e76c57d8458550bb34487c28","179995a388ae029d56cbb2a86bb015b2e346f7c9697ca4ab8ab7dfa66be569d0","18a06146fcb9a1b5c218a5f31adf8902f9d37fa01bb162234c974223b8ae6d17","cd8af85179c4811923e902ad316719581be1899fa4b2556f21520e2c8841d01a","295f97b27ddf4571b71e73afbfc1fbfe4a92571e4544a853d7e3a854419db62d","976d4304970de4fe6510e296596af79ba8533623dd01cfd9cd2e07c38ad5856d","53686caffb96b612caacf6b5bfacfcc7ecc17ae7215c5d1a1f99a2f46800d75e","153c25e6a1b6400a3a34d613b3e18ab1d4936f3315442a31f284338484201b8f","44a980fcd376d9840ca6535fafe3bf705346475e4ff93f54f22ee7872c4d94e2","34da7fb316c759fb5cbca0e9fb103ddf4ebe1be047c13369eee5eb03d826d218","13ea1232869a2941793a35d64b88a9a2dcb8ebb905bd4aeb85c84c0ffa1045cb","b55510d2ba2a41716968016b78e1b1e7358e58acc951f05bfc619663d0ba73e7","80f7339296633810d8b44aa742931997597b1b6deabbfc584d33aa179882dd94","b3c0ca3b1fabda608659f61e18fe9d7c1ae608e2ab40161565b98336a52d3c6d"],"paragraph_range_zero_based":[360,383],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2301433.zip::R2-2301433 Orbit and Tropo.docx:p360"}
{"fields":{"filename":"R2-2301433.zip::R2-2301433 Orbit and Tropo.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field specifies the Mean Troposphere Vertical Hydro Static Delay Error bound which is the mean value for an overbounding model that bounds the residual troposphere error in the vertical hydro static delay component.","paragraph_zero_based":384},{"literal_text_all_w_t_and_m_t":"The bound is meanTroposphereVerticalHydroStaticDelay + K * stdDevTroposphereVerticalHydroStaticDelay and shall be so that the probability of it to be exceeded shall be lower than IRallocation for irMinimum < IRallocation < irMaximum, where K = normInv(IRallocation / 2) and irMinimum, irMaximum as provided in IE GNSS-Integrity-ServiceParameters.","paragraph_zero_based":385},{"literal_text_all_w_t_and_m_t":"This IRallocation is a fraction of the Target Integrity Risk that represents the integrity risk budget available.","paragraph_zero_based":386},{"literal_text_all_w_t_and_m_t":"Scale factor 0.005 m; range 0-1.275 m.","paragraph_zero_based":387},{"literal_text_all_w_t_and_m_t":"stdDevTroposphereVerticalHydroStaticDelay","paragraph_zero_based":388},{"literal_text_all_w_t_and_m_t":"This field specifies the Standard Deviation Troposphere Vertical Hydro Static Delay Error bound which is the standard deviation for an overbounding model that bounds the residual troposphere error in the vertical hydro static delay component.","paragraph_zero_based":389},{"literal_text_all_w_t_and_m_t":"Scale factor 0.005 m; range 0-1.275 m.","paragraph_zero_based":390},{"literal_text_all_w_t_and_m_t":"meanTroposphereVerticalWetDelay","paragraph_zero_based":391},{"literal_text_all_w_t_and_m_t":"This field specifies the Mean Troposphere Vertical Wet Static Delay Error bound which is the mean value for an overbounding model that bounds the residual troposphere error in the vertical wet delay component.","paragraph_zero_based":392},{"literal_text_all_w_t_and_m_t":"The bound is meanTroposphereVerticalWetDelay + K * stdDevTroposphereVerticalWetDelay and shall be so that the probability of it to be exceeded shall be lower than IRallocation for irMinimum < IRallocation < irMaximum, where K = normInv(IRallocation / 2) and irMinimum, irMaximum as provided in IE GNSS-Integrity-ServiceParameters.","paragraph_zero_based":393},{"literal_text_all_w_t_and_m_t":"This IRallocation is a fraction of the Target Integrity Risk that represents the integrity risk budget available.","paragraph_zero_based":394},{"literal_text_all_w_t_and_m_t":"Scale factor 0.005 m; range 0-1.275 m.","paragraph_zero_based":395},{"literal_text_all_w_t_and_m_t":"stdDevTroposphereVerticalWetDelay","paragraph_zero_based":396},{"literal_text_all_w_t_and_m_t":"This field specifies the Standard Deviation Troposphere Vertical Wet Static Delay Error bound which is the standard deviation for an overbounding model that bounds the residual troposphere error in the vertical wet delay component.","paragraph_zero_based":397},{"literal_text_all_w_t_and_m_t":"Scale factor 0.005 m; range 0-1.275 m.","paragraph_zero_based":398},{"literal_text_all_w_t_and_m_t":"meanTroposphereVerticalHydroStaticDelayRate","paragraph_zero_based":399},{"literal_text_all_w_t_and_m_t":"This field specifies the Mean Troposphere Vertical Hydro Static Delay Rate Error bound which is the mean value for an overbounding model that bounds the residual troposphere rate error in the vertical hydro static delay component.","paragraph_zero_based":400},{"literal_text_all_w_t_and_m_t":"The bound is meanTroposphereVerticalHydroStaticDelayRate + K * stdDevTroposphereVerticalHydroStaticDelayRate and shall be so that the probability of it to be exceeded shall be lower than IRallocation for irMinimum < IRallocation < irMaximum, where K = normInv(IRallocation / 2) and irMinimum, irMaximum as provided in IE GNSS-Integrity-ServiceParameters.","paragraph_zero_based":401},{"literal_text_all_w_t_and_m_t":"This IRallocation is a fraction of the Target Integrity Risk that represents the integrity risk budget available.","paragraph_zero_based":402},{"literal_text_all_w_t_and_m_t":"Scale factor 0.00005 m/s; range 0-0.01275 m/s.","paragraph_zero_based":403},{"literal_text_all_w_t_and_m_t":"stdDevTroposphereVerticalHydroStaticDelayRate","paragraph_zero_based":404},{"literal_text_all_w_t_and_m_t":"This field specifies the Standard Deviation Troposphere Vertical Hydro Static Delay Rate Error bound which is the standard deviation for an overbounding model that bounds the residual troposphere rate error in the vertical hydro static delay component.","paragraph_zero_based":405},{"literal_text_all_w_t_and_m_t":"Scale factor 0.00005 m/s; range 0-0.01275 m/s.","paragraph_zero_based":406},{"literal_text_all_w_t_and_m_t":"meanTroposphereVerticalWetDelayRate","paragraph_zero_based":407}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"fb8ec76fc8fff2631a54eea3056fb58660493df02c08adfc8f87a29b6647ca9c","original_member_sha256":"c372cd2cebbb02ac4d53a8ac60ad70ed83b67917bcef75f23e4950c4d4dce8c5","paragraph_ElementTree_utf8_XML_sha256":["6cc985aa8f2565c31c35d871fa1140f5bafc1660cd5b176d68fe0b0cda4d500d","a3c297301dad6aff15705574aafde126eee497f5bee2ba7ff324f24543336ff5","8f9757339d12f5e95ce3485af3455ba1cb3a7beb235fb6bfde58c3f653e06d65","7af4a95b7640dd82877b93d139e7c85130230b36a46166c82f0fed80ecf1b255","0cc41a60cdea14af89a7b25c4e240a17c9e94b59eebbe760b27752a6aa656d5c","87a198ee0835ff9d2771139e595fe6f63ade73aba41853294046afc30601643d","afb61b1dd28a0b73e42ad700c0ade852282d4e3cd9bdc95e401f23fc2a3eb69d","ac5f4c3d3d2ee8ef5ed27fb0e4af1b0136578cdb80517115bd4b1028cb5f9d8a","497b96825e2cb33d2104985aec7c5a0d9413cd4ea3faf3dd3dcb6990988d73b1","54d43a843ca9d8d51bc2afdfe58d41f417a07ddb05d09a458bd145b044e464b3","d14e8fdcbccafbb996cd40e2681bcd8ebf4182678851b74aa7c9ac74042bb063","58ba01897