{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>consider itself not to be configured to provide MUSIM assistance information for gap preference and stop timer T346h, if running;","paragraph_zero_based":2448},{"literal_text_all_w_t_and_m_t":"1>if the received otherConfig includes the musim-LeaveAssistanceConfig:","paragraph_zero_based":2449},{"literal_text_all_w_t_and_m_t":"2>if musim-LeaveAssistanceConfig is set to setup:","paragraph_zero_based":2450},{"literal_text_all_w_t_and_m_t":"3>consider itself to be configured to provide MUSIM assistance information for leaving RRC_CONNECTED in accordance with 5.7.4;","paragraph_zero_based":2451},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":2452},{"literal_text_all_w_t_and_m_t":"3>consider itself not to be configured to provide MUSIM assistance information for leaving RRC_CONNECTED and stop timer T346g, if running.","paragraph_zero_based":2453},{"literal_text_all_w_t_and_m_t":"1>if the received otherConfig includes the rlm-RelaxationReportingConfig:","paragraph_zero_based":2454},{"literal_text_all_w_t_and_m_t":"2>if rlm-RelaxationReportingConfig is set to setup:","paragraph_zero_based":2455},{"literal_text_all_w_t_and_m_t":"3>consider itself to be configured to report the relaxation state of RLM measurements in accordance with 5.7.4;","paragraph_zero_based":2456},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":2457},{"literal_text_all_w_t_and_m_t":"3>consider itself not to be configured to report the relaxation state of RLM measurements and stop timer T346j associated with the cell group, if running;","paragraph_zero_based":2458},{"literal_text_all_w_t_and_m_t":"1>if the received otherConfig includes the bfd-RelaxationReportingConfig:","paragraph_zero_based":2459},{"literal_text_all_w_t_and_m_t":"2>if bfd-RelaxationReportingConfig is set to setup:","paragraph_zero_based":2460},{"literal_text_all_w_t_and_m_t":"3>consider itself to be configured to report the relaxation state of BFD measurements in accordance with 5.7.4;","paragraph_zero_based":2461},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":2462},{"literal_text_all_w_t_and_m_t":"3>consider itself not to be configured to report the relaxation state of BFD measurements and stop timer T346k associated with the cell group, if running;","paragraph_zero_based":2463},{"literal_text_all_w_t_and_m_t":"1>if the received otherConfig includes the scg-DeactivationPreferenceConfig:","paragraph_zero_based":2464},{"literal_text_all_w_t_and_m_t":"2>if the scg-DeactivationPreferenceConfig is set to setup:","paragraph_zero_based":2465},{"literal_text_all_w_t_and_m_t":"3>consider itself to be configured to provide its SCG deactivation preference in accordance with 5.7.4;","paragraph_zero_based":2466},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":2467},{"literal_text_all_w_t_and_m_t":"3>consider itself not to be configured to provide its SCG deactivation preference and stop timer T346i, if running.","paragraph_zero_based":2468},{"literal_text_all_w_t_and_m_t":"1>if the received otherConfig includes the propDelayDiffReportConfig:","paragraph_zero_based":2469},{"literal_text_all_w_t_and_m_t":"2>if the propDelayDiffReportConfig is set to setup:","paragraph_zero_based":2470},{"literal_text_all_w_t_and_m_t":"3>consider itself to be configured to provide service link propagation delay difference between serving cell and neighbour cell(s) in accordance with 5.7.4;","paragraph_zero_based":2471}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["2a84b5a7e94bf2f24a4f783ec651f3cb0615c6737f41f61f827612d53416182a","381d09f09a48f40a545e9c57ae566cfa7b4080c4deeebe68fbe9d66a084f26b9","6c1cdf673761960fb7facc908450981204b065f3aa81b534e59e9d1f7a2a571d","0b2e4ef04feef47c07a1a81a336dd0e541712aaea64f1c9665386073215155ad","9ad044a4d964ff626e4be05df657e545310546db4d3135b8422228a40eb3e5d9","c8e6b2303b7abee8970a0d63f39fc9ce82180b2c0703e441a592cf4e4632b516","7dd835c8a7938322dcf20c9d24a1358c7fb0d152d46d3c3182b5c7053dcb4e3b","b3ad3b51d416b401bccfdbf3d7e3daadca3e2ba705ab14e6f56248824ad24648","fca6d6cc3107bae67cb53e81452c3de8664e0fc1766ce7e6c692e7ce401f934a","5e963d68834b22f980c6a4a8fea586688b4e53a62a004a7a67d9ed53b7d7d251","45cf74fcec83b51bf9ddf337059ff7bf8be836d8ae2ca2749d6e797039036baf","1f74291eed63f7e10a2d46d5b7bf74b92a1bdbd29119fdf0c8500fb32bd4a11b","1b91cf9ba7e0de8328f15bd067a61f7eecac32768f6556f97e0e5079d3451ac0","e6b919184af3bafc7b91f51dc1626f59f709c09a393df7bc626dc8cf11dc6eb7","dffd3d4f559d3e33e24a7d6ccb38d725dab3f5f7547897782f6f6fd86a23918a","b16335e5c3701022d19291e405839e1379d1aec2ae926cb7606567e57daf2aa7","c5d019f56212c7502a78e7e9ae1e74579d1d152e6c81c8bc4ffa9407924ca0ad","53570eef56faf862f456a2155ba0eda7dd909cc48588e88ebcee99cc54882204","c8ec3443193f8861383ed5049776d2455c3fb7d28cd4001a5d1a5d6d900b168b","02546bbe5971d8a41cd8ec0941a21a3c86f58114af989c98ef27a9c7836ab6f7","1b84d75e258132db2cac9a28b0496b2413a1ad1eeb949c71dc705048293be246","7245d1dd0553ed0d6dfba4a415baf78a4425706208f243915d2c053c1a1a56b8","5d6622a38f5f03ef219a007fd4da9bfea9d8fd64ae84d1495caac35f6a046598","ab58ea8f285fc8dcb973bab1079a4e4886e63807508ea0562d51992d9a506788"],"paragraph_range_zero_based":[2448,2471],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p2448"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":2472},{"literal_text_all_w_t_and_m_t":"3>consider itself not to be configured to provide service link propagation delay difference between serving cell and neighbour cell(s).","paragraph_zero_based":2473},{"literal_text_all_w_t_and_m_t":"1>if the received otherConfig includes the rrm-MeasRelaxationReportingConfig:","paragraph_zero_based":2474},{"literal_text_all_w_t_and_m_t":"2>if the rrm-MeasRelaxationReportingConfig is set to setup:","paragraph_zero_based":2475},{"literal_text_all_w_t_and_m_t":"3>consider itself to be configured to report the fulfilment of the criterion for relaxing RRM measurements in accordance with 5.7.4;","paragraph_zero_based":2476},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":2477},{"literal_text_all_w_t_and_m_t":"3>consider itself not to be configured to report the fulfilment of the criterion for relaxing RRM measurements.","paragraph_zero_based":2478},{"literal_text_all_w_t_and_m_t":"5.3.5.9aMUSIM gap configuration","paragraph_zero_based":2479},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":2480},{"literal_text_all_w_t_and_m_t":"1>if musim-GapConfig is set to setup:","paragraph_zero_based":2481},{"literal_text_all_w_t_and_m_t":"2>for each musim-GapId included in the received musim-GapToReleaseList:","paragraph_zero_based":2482},{"literal_text_all_w_t_and_m_t":"3>release the periodic MUSIM gap configuration associated with the musim-GapId;","paragraph_zero_based":2483},{"literal_text_all_w_t_and_m_t":"2>for each MUSIM-Gap included in the received musim-GapToAddModList:","paragraph_zero_based":2484},{"literal_text_all_w_t_and_m_t":"3>setup periodic MUSIM gap configuration indicated by the MUSIM-Gap in accordance with the received musim-GapRepetitionAndOffset (providing musim-GapRepetition and Offset value for the following condition) i.e. the first subframe of each periodic MUSIM gap occurs at an SFN and subframe of the NR PCell meeting the following condition:","paragraph_zero_based":2485},{"literal_text_all_w_t_and_m_t":"SFN mod T = FLOOR(Offset/10);","paragraph_zero_based":2486},{"literal_text_all_w_t_and_m_t":"subframe = Offset mod 10;","paragraph_zero_based":2487},{"literal_text_all_w_t_and_m_t":"with T = musim-GapRepetition/10;","paragraph_zero_based":2488},{"literal_text_all_w_t_and_m_t":"2>if musim-AperiodicGap is included:","paragraph_zero_based":2489},{"literal_text_all_w_t_and_m_t":"3>setup aperiodic MUSIM gap configuration indicated by the musim-AperiodicGap in accordance with the received musim-Starting-SFN-AndSubframe, i.e. the first subframe of aperiodic MUSIM gap occurs at an SFN and subframe of the NR PCell meeting the following condition:","paragraph_zero_based":2490},{"literal_text_all_w_t_and_m_t":"SFN = starting-SFN;","paragraph_zero_based":2491},{"literal_text_all_w_t_and_m_t":"subframe = startingSubframe;","paragraph_zero_based":2492},{"literal_text_all_w_t_and_m_t":"1>else if musim-GapConfig is set to release:","paragraph_zero_based":2493},{"literal_text_all_w_t_and_m_t":"2>release the MUSIM gap configuration.","paragraph_zero_based":2494},{"literal_text_all_w_t_and_m_t":"5.3.5.10MR-DC release","paragraph_zero_based":2495}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["50a4a62636cdf70a84527616e834f5dc97b74c1b43e1a9864854c77f10be251e","916972a80bbb06631168ab9793edea61dcb3c09d3e9c8d38526b86f5deec1d8e","22761de6e7099f48273a6459a084f74923b81040fd0fb15236d5ee842ca2c68b","2819ada98960e42e98f449c3a2bc60c971a25c470101f6a591e2ebb0a588b041","3e8f8657d1b277b9767c3834da1bb4f092946b6999a9a2711ec4be208562b952","b9adf35cbcc1f331aafe87580c3201eb04a510ce80589ce1715def626bdd3d92","2ac1a8ff28f576e7fd7dc45b99e9427f7a017310a63555150824aa3d86076cad","1d6caa42dcca84f35a6a7aedd484f72ace45d9341beb6e08274a1e16760c90e8","0e81b6773eb66f986bbc7b7175ebd08cad731f78b0e4e2534571784e84a32c9a","0060298e8363ca79c3fe9b7ca0ae9e422d55da857cb514d59f20f0a4630f092f","9490a22b04bf3834c278e7a1804e1a42da5faaa3ba8abee2edfc1800b43069da","f1f4dfe23ca87142c861888fd54afba4da5252ad58897905e22309fb84bcc5f2","6cb560da98157961a1374204bc7f6477875f5511b36ca76c82d59f2d18dd16e1","d36b8ff09ba4cfc48ce9499e2bd203095fa5b2051a2438d4bc838893431a7c5b","8df7f205db5f096fe4e8555c69de0572dd2098d2006853993fe18a1f95e703e0","7c758f24e236ca6eaf30c5912954cb320bfac0fd88c1979b8c8bfd1883486fea","bb46a867c1bf44dd7347e8aa803f3ee61af302eca474cfdc5946cdeaf45c41c7","f7bef154e9f41ea567c5e54537ed54b891276c61d4b3633eb4a6ada93a194b98","797ac69885cd4e1b733e19f7b666e3630c8790360af4bea0b8e423342c79fded","3e778ffda4bd86b62373778af19091adcea661852e679f0e437d77261b299e51","f6bf8db2ad574d556af439b80f17505fe1d20b966203906336c11bf776a9a56d","c56e1005c68f34b87b0d49755174b09efd0760df9a45440d10c52610549217a5","7d44468981e930536f605ac8a851d57731deb71a6369800a8b94fcf0dfe32eb5","23791ed94f79a21c3e66fd5d68e2a681bc9b394ce196d16f4e50fba28e29ae96"],"paragraph_range_zero_based":[2472,2495],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p2472"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":2496},{"literal_text_all_w_t_and_m_t":"1>as a result of MR-DC release triggered by E-UTRA or NR:","paragraph_zero_based":2497},{"literal_text_all_w_t_and_m_t":"2>release SRB3, if established, as specified in 5.3.5.6.2;","paragraph_zero_based":2498},{"literal_text_all_w_t_and_m_t":"2>release measConfig associated with SCG;","paragraph_zero_based":2499},{"literal_text_all_w_t_and_m_t":"2>if the UE is configured with NR SCG:","paragraph_zero_based":2500},{"literal_text_all_w_t_and_m_t":"3>release the SCG configuration as specified in clause 5.3.5.4;","paragraph_zero_based":2501},{"literal_text_all_w_t_and_m_t":"3>release otherConfig associated with the SCG, if configured;","paragraph_zero_based":2502},{"literal_text_all_w_t_and_m_t":"3>stop timers T346a, T346b, T346c, T346d, T346e, T346j and T346k associated with the SCG, if running;","paragraph_zero_based":2503},{"literal_text_all_w_t_and_m_t":"3>release bap-Config associated with the SCG, if configured;","paragraph_zero_based":2504},{"literal_text_all_w_t_and_m_t":"3>release the BAP entity as specified in TS 38.340 [47], if there is no configured bap-Config;","paragraph_zero_based":2505},{"literal_text_all_w_t_and_m_t":"3>release iab-IP-AddressConfigurationList associated with the SCG, if configured;","paragraph_zero_based":2506},{"literal_text_all_w_t_and_m_t":"2>else if the UE is configured with E-UTRA SCG:","paragraph_zero_based":2507},{"literal_text_all_w_t_and_m_t":"3>release the SCG configuration as specified in TS 36.331 [10], clause 5.3.10.19 to release the E-UTRA SCG;","paragraph_zero_based":2508},{"literal_text_all_w_t_and_m_t":"5.3.5.11Full configuration","paragraph_zero_based":2509},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":2510},{"literal_text_all_w_t_and_m_t":"1>release/ clear all current dedicated radio configurations except for the following:","paragraph_zero_based":2511},{"literal_text_all_w_t_and_m_t":"-the MCG C-RNTI;","paragraph_zero_based":2512},{"literal_text_all_w_t_and_m_t":"-the AS security configurations associated with the master key;","paragraph_zero_based":2513},{"literal_text_all_w_t_and_m_t":"-the SRB1/SRB2 configurations and DRB/multicast MRB configurations as configured by radioBearerConfig or radioBearerConfig2.","paragraph_zero_based":2514},{"literal_text_all_w_t_and_m_t":"NOTE 1:Radio configuration is not just the resource configuration but includes other configurations like MeasConfig. Radio configuration also includes the RLC bearer configurations as configured by RLC-BearerConfig, PC5 Relay RLC channel as configured by SL-RLC-ChannelConfig, and Uu Relay RLC channel as configured by Uu-RelayRLC-ChannelConfig. In case NR-DC or NE-DC is configured, this also includes the entire NR or E-UTRA SCG configuration which are released according to the MR-DC release procedure as specified in 5.3.5.10.","paragraph_zero_based":2515},{"literal_text_all_w_t_and_m_t":"NOTE 1a:For NR sidelink communication/discovery, the radio configuration includes the sidelink RRC configuration received from the network, but does not include the sidelink RRC reconfiguration and sidelink UE capability received from other UEs via PC5-RRC. In addition, the UE considers the new NR sidelink configurations as full configuration, in case of state transition and change of system information used for NR sidelink communication/discovery.","paragraph_zero_based":2516},{"literal_text_all_w_t_and_m_t":"NOTE 1b:To establish the RLC bearer of SRB(s) after release due to fullConfig, the network can include the srb-Identity within srb-ToAddModList (i.e. the UE applies RLC default configuration) and/or provide rlc-BearerToAddModList of concerned SRB(s) explicitly.","paragraph_zero_based":2517},{"literal_text_all_w_t_and_m_t":"-the logged measurement configuration;","paragraph_zero_based":2518},{"literal_text_all_w_t_and_m_t":"1>if the spCellConfig in the masterCellGroup includes the reconfigurationWithSync:","paragraph_zero_based":2519}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["6cdfdc8465b318d83c762f901c35bcb7f66ddabc2dd9265e253fb117d2728bbb","6cc1d130051707540bdee4fd241dc56ce91f8ff9772e1c6dd4ce37de85fe7d70","04b1401a81ffda176c4785a19ea629e5fe8741c7e700b5ae6a7ca88c44779ca9","f57ea3e36601172abca8061d1b3438ec8a6d4b56d0d065fd2ef21dee1bbd4965","813adeb19b0642f7a6665d01496a4e01be1d49b797f0eb6638417f0186b71b27","30b64a092c2379a7b2a3ac120bb5b29b56cb0a348702bc3d22bf924f7ff04b12","ae1a5d0ae95010609d4da5a9eaddb6d90a17a183a775c310a8995954f98b0ce0","86aea362d5ca4d2503ccea8685f711721a11510134065f47696e8ed70aadd1eb","adb510f651a30061dc0e128b84e0d8bddd72fc22a0a00014bfe9bf092a741fb7","6cd1e9155ee32efacd4541a1f958063307ccea7cddcf4d9c7c2aa10f328469f5","cfc0f3baa5ec73dc218d379125127998218a48b89233eb11f53e62da7f40e7a9","59b3b8866efa31eed92edeaf2637a0e925e2b785d71e317e5dd13f3f54aa6d15","402f42813d051146031bdec83af2f8c538db8df606ed904223111ca18152cea6","18b1e4d139712be13b25914376831c1f520e285fdc16ad7ed92ab225db9e2520","8f8944d9e9fb173940a46771337254c0c557cec25d5662ed56344027040b94fb","855e7d82048961b03ec388fa2e078e0575725bab9a0e952a0bd8c55f190615d1","e2819843a234c3967ce61585fa8cde9aacda549f0a1d931ed33f48359dc33643","fb0646cbe3a2408e214752b9ce12564e43f655acccd9a9a0f5c5e552b667c82f","25ce222ac8770faa8dea57e7903a1f199d682026065848246457e18344a05634","fc73fbd71bf07bbd117e2d2c18d62cd38f06cb41c5121b3735c79fca9d80175d","79217b95fbc72295352995229c5e6b2a33fde8f23adf7b9fd27812d83a1b22ae","51d720acf464663d2caeadfa7f89b00f2db30ef1cf2617b2aa1c7f0f0c3e5976","a5909c874603d8f6c2494497235bb378ee51bb4fb59f99afbfe2fe42e4a15205","820e5eb219b3980b131f4e565afefecdc91952b013c8b61affad32ebb0c34599"],"paragraph_range_zero_based":[2496,2519],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p2496"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>release/ clear all current common radio configurations;","paragraph_zero_based":2520},{"literal_text_all_w_t_and_m_t":"2>if sl-PathSwitchConfig was included in reconfigurationWithSync:","paragraph_zero_based":2521},{"literal_text_all_w_t_and_m_t":"3>use the default values specified in 9.2.3 for timer T311;","paragraph_zero_based":2522},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":2523},{"literal_text_all_w_t_and_m_t":"3>use the default values specified in 9.2.3 for timers T310, T311 and constants N310, N311;","paragraph_zero_based":2524},{"literal_text_all_w_t_and_m_t":"1>else (full configuration after re-establishment or during RRC resume):","paragraph_zero_based":2525},{"literal_text_all_w_t_and_m_t":"2>if the UE is acting as L2 U2N Remote UE:","paragraph_zero_based":2526},{"literal_text_all_w_t_and_m_t":"3>use value for timer T311, as included in ue-TimersAndConstants received in SIB1","paragraph_zero_based":2527},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":2528},{"literal_text_all_w_t_and_m_t":"3>use values for timers T301, T310, T311 and constants N310, N311, as included in ue-TimersAndConstants received in SIB1;","paragraph_zero_based":2529},{"literal_text_all_w_t_and_m_t":"1>if no measConfigAppLayerId is included:","paragraph_zero_based":2530},{"literal_text_all_w_t_and_m_t":"2>inform upper layers about the release of all application layer measurement configurations;","paragraph_zero_based":2531},{"literal_text_all_w_t_and_m_t":"2>discard any received application layer measurement report from upper layers;","paragraph_zero_based":2532},{"literal_text_all_w_t_and_m_t":"2>consider itself not to be configured to send application layer measurement report.","paragraph_zero_based":2533},{"literal_text_all_w_t_and_m_t":"1>if the UE is acting as L2 U2N Remote UE at the target side during reconfiguration with sync, or after re-establishment, or during RRC resume:","paragraph_zero_based":2534},{"literal_text_all_w_t_and_m_t":"2>apply the default configuration of SL-RLC1 as specified in clause 9.2.4 and associate it with the SRB1;","paragraph_zero_based":2535},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":2536},{"literal_text_all_w_t_and_m_t":"2>apply the default L1 parameter values as specified in corresponding physical layer specifications except for the following:","paragraph_zero_based":2537},{"literal_text_all_w_t_and_m_t":"-parameters for which values are provided in SIB1;","paragraph_zero_based":2538},{"literal_text_all_w_t_and_m_t":"2>apply the default MAC Cell Group configuration as specified in 9.2.2;","paragraph_zero_based":2539},{"literal_text_all_w_t_and_m_t":"2>for each srb-Identity value included in the srb-ToAddModList (SRB reconfiguration):","paragraph_zero_based":2540},{"literal_text_all_w_t_and_m_t":"3>establish an RLC entity for the corresponding SRB;","paragraph_zero_based":2541},{"literal_text_all_w_t_and_m_t":"3>apply the default SRB configuration defined in 9.2.1 for the corresponding SRB;","paragraph_zero_based":2542},{"literal_text_all_w_t_and_m_t":"NOTE 2:This is to get the SRBs (SRB1 and SRB2 for reconfiguration with sync and SRB2 for resume and reconfiguration after re-establishment) to a known state from which the reconfiguration message can do further configuration.","paragraph_zero_based":2543}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["88c79abc9914a45d5385c9080c4ea28fe647d908d7759c50dcaf6f7a48f596e7","062f21ad187b838b5e2c13bf399e9ede12919b3a1a04db3575a3c49f348a4f3a","684808d6c8b30c00011bb5982f2f6fe05a24e4deda8d1fe4bf7a0156e9fa5af3","e34005b2f949ffa49784f307ada9795dd2195f2195e58d21baedd1c41110dcab","5c50980a4eaa3ccb99188b22c25fe8134108e424df598a78786d8dff7f7306ee","c46856fc87cbe5380a37fdef078d531bc39306b69881ff24cdfb4ab2d7503ad8","148f779a567560997d9046b259c143734e81df66611542b6e32bc8409df001d5","94939fdfe503f6349d959bbe314eb3aa3d6145911ac55635aea00b7708fb1037","aa5f939170e7c1146870403bafd609f3d1de66fe61cbc30a01e83293b2e92c3e","7505b35ff512295a1da819a96cb2aebabd40c55113d8475cf7713e8a17652170","48ba1008406f873e50ba52b740e80e767887b6953f435fd092d1ebec94c3baa4","e5440532a03024f09a718756cf1f647c6312d9476481a6b2a4e2b7c646625591","53a00d1e1fdc1db05c933f89710895511dc93922b5df06ba91f0305fe0ebabd5","2e536dddc5a1f17b5cbf943bbe2b65217c5e6f69c722254c849455aeb25caa83","9726e331534e498b216d9a1eeba3a3c448eeea4d968d8c3529265a8774c1aef3","b39066a3e627fb126ac2274942465f6a3e21cfa6715a44484762a66ea21744e9","f5c004c0d6c668629041047948f935719b340a0818d7a2b07ca48e961b78beda","46be85c52a58dab3a00c0f857778d3c523d3cbc9593f42175f35a437036f2070","c18e8c8f4c003cd589223b17af567e1b07a21333f32f0e7bf4b072c86905a4bc","62ca628e7bcfa4fb78bab9be500301d2ea4f769bc7ad9f71d6f345474269025f","e96d9fd1c19b6acc83b2588b66121439be316e40063dccae112c3f386f796518","86cdf7416c7c433fda66d7c42a140133c9361b168d3231c7df636d16760da72d","58ec7d21d0a36be0b2d06ad927092fd7087fb52ae19207715b7d4ef2050c53e5","788bbfa9649162dffe6f47333b87ebd4493523d707f83a2472f826374685a5fd"],"paragraph_range_zero_based":[2520,2543],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p2520"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>for each pdu-Session that is part of the current UE configuration:","paragraph_zero_based":2544},{"literal_text_all_w_t_and_m_t":"2>release the SDAP entity (clause 5.1.2 in TS 37.324 [24]);","paragraph_zero_based":2545},{"literal_text_all_w_t_and_m_t":"2>release each DRB associated to the pdu-Session as specified in 5.3.5.6.4;","paragraph_zero_based":2546},{"literal_text_all_w_t_and_m_t":"NOTE 3:This will retain the pdu-Session but remove the DRBs including drb-identity of these bearers from the current UE configuration. Setup of the DRBs within the AS is described in clause 5.3.5.6.5 using the new configuration. The pdu-Session acts as the anchor for associating the released and re-setup DRB. In the AS the DRB re-setup is equivalent with a new DRB setup (including new PDCP and logical channel configurations).","paragraph_zero_based":2547},{"literal_text_all_w_t_and_m_t":"1>for each mbs-SessionId that is part of the current UE configuration and associated to a multicast MRB:","paragraph_zero_based":2548},{"literal_text_all_w_t_and_m_t":"2>release the SDAP entity (clause 5.1.2 in TS 37.324 [24]);","paragraph_zero_based":2549},{"literal_text_all_w_t_and_m_t":"2>release each multicast MRB associated to the mbs-SessionId as specified in 5.3.5.6.6;","paragraph_zero_based":2550},{"literal_text_all_w_t_and_m_t":"NOTE 4:This will retain the mbs-SessionId but remove the multicast MRBs including mrb-identity of these bearers from the current UE configuration. Setup of the multicast MRBs within the AS is described in clause 5.3.5.6.7 using the new configuration. The mbs-SessionId acts as the anchor for associating the released and re-setup multicast MRB. In the AS the multicast MRB re-setup is equivalent with a new multicast MRB setup (including new PDCP and logical channel configurations).","paragraph_zero_based":2551},{"literal_text_all_w_t_and_m_t":"1>for each pdu-Session that is part of the current UE configuration but not added with same pdu-Session in the drb-ToAddModList:","paragraph_zero_based":2552},{"literal_text_all_w_t_and_m_t":"2>if the procedure was triggered due to reconfiguration with sync:","paragraph_zero_based":2553},{"literal_text_all_w_t_and_m_t":"3>indicate the release of the user plane resources for the pdu-Session to upper layers after successful reconfiguration with sync;","paragraph_zero_based":2554},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":2555},{"literal_text_all_w_t_and_m_t":"3>indicate the release of the user plane resources for the pdu-Session to upper layers immediately;","paragraph_zero_based":2556},{"literal_text_all_w_t_and_m_t":"1>for each mbs-SessionId that is part of the current UE configuration but not added with the same mbs-SessionId in the mrb-ToAddModList:","paragraph_zero_based":2557},{"literal_text_all_w_t_and_m_t":"2>if the procedure was triggered due to reconfiguration with sync:","paragraph_zero_based":2558},{"literal_text_all_w_t_and_m_t":"3>indicate the release of the user plane resources for the mbs-SessionId to upper layers after successful reconfiguration with sync;","paragraph_zero_based":2559},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":2560},{"literal_text_all_w_t_and_m_t":"3>indicate the release of the user plane resources for the mbs-SessionId to upper layers immediately.","paragraph_zero_based":2561},{"literal_text_all_w_t_and_m_t":"5.3.5.12BAP configuration","paragraph_zero_based":2562},{"literal_text_all_w_t_and_m_t":"The IAB-MT shall:","paragraph_zero_based":2563},{"literal_text_all_w_t_and_m_t":"1>if the bap-Config is set to setup:","paragraph_zero_based":2564},{"literal_text_all_w_t_and_m_t":"2>if no BAP entity is established:","paragraph_zero_based":2565},{"literal_text_all_w_t_and_m_t":"3>establish a BAP entity as specified in TS 38.340 [47];","paragraph_zero_based":2566},{"literal_text_all_w_t_and_m_t":"2>if bap-Address is included:","paragraph_zero_based":2567}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["761b554ca97f8b6150308678705c313f9fb27874cc21ff85d05d3339b3f4a340","6c22412ddce942da7de8cf18d7650675c4dbb80ed3136b59d2bee8d51616d005","9e48a83db21177b0f9ed8cc0795a04f9c4b3470cbd37a217a6869edd32e9d65b","ecac566856ce8e40738c9fb2697cf3bc3f1e4aa96dedf6e1a849d317b7b64791","f0bfcc41ee7b82ea114c485edecb5ee7777c9d0b15fbc9eb5615e325dcd4697c","767c55474146a74b86ba1bb516455396227a3cde9526eeb161cbd95883437b50","bf62af47118c9e7c99af7ccfc7fe40ead4fe3ef632333a9f971ed084af9ecba4","ed6bf37c6b7f12a55de62c9f3438e1df50c52dfdc3667d9b88553e79899b40f4","9e2805e918345d7c45073192331c62cc9741e04c0e7ee61d8db74c1c3226688e","4d0889d98e2ede77591b1f15e99b0bbfdf6bbe514e203095ae9b3c68d38c04b4","7dd1bc1ebfd205f8d497385638ce6ce4b810ca4b04300c91fd12d1b089712e1a","53127a82fc9fed8eafb41b9e64d741ea8dd419c46c4f402cf6d06346223fd467","d55f35b83a54a0d8f3693bfb300955b76232ebdcd9e2b50153f949cfa3dfe12d","6bb159df33bfe47650ecfabf81b8d5434f0953a9eefb1ccdc8c4b7cbf66f36f7","4b8c41abd244d18cc1a7ed75296f7cc63bc3d12827e41128f4343724da127801","c33e630453dab0c893ede61c2484987ad865b17ca3db5cd9b48b6acea4ff3608","a12e41a72c1b673e4c85965c13b0895d9d23d0096eb80729c33f034dbf6bfd0d","00b426c1688ac7082190c47f83c5a8af333807f08cd9d8a2b48028ef04a6ad68","79443478528c492c1ae443d9523f20e540061db7eb1a46cebcc9ff322483b956","06e1143b665a2269aef3115d79226f7f6fadc4eab69c2ca9a5a27bca8b59ab32","159e8103088441e5af2d80dadee1c2128b93a29939b3ac2625a3fa33ffbede11","6f98e7de811be21f770f2e98318ee7634fee089e44d45fde2ccc9e4b4329596f","b67aaef1a96d73a796652a9cac618f9d5f559be2c32016c0eabd360a978257a0","da580a9af0debd8cda8b12e865ccdbe92581ea21bbe53c66cc4076aa202d7b5c"],"paragraph_range_zero_based":[2544,2567],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p2544"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>configure the BAP entity to use the bap-Address as this node's BAP address;","paragraph_zero_based":2568},{"literal_text_all_w_t_and_m_t":"2>if defaultUL-BAP-RoutingID is included:","paragraph_zero_based":2569},{"literal_text_all_w_t_and_m_t":"3>configure the BAP entity to apply the default UL BAP routing ID according to the configuration;","paragraph_zero_based":2570},{"literal_text_all_w_t_and_m_t":"2>if defaultUL-BH-RLC-Channel is included","paragraph_zero_based":2571},{"literal_text_all_w_t_and_m_t":"3>configure the BAP entity to apply the default UL BH RLC channel according to the configuration;","paragraph_zero_based":2572},{"literal_text_all_w_t_and_m_t":"2>if flowControlFeedbackType is included:","paragraph_zero_based":2573},{"literal_text_all_w_t_and_m_t":"3>configure the BAP entity to apply the flow control feedback according to the configuration;","paragraph_zero_based":2574},{"literal_text_all_w_t_and_m_t":"1>if the bap-Config is set to release:","paragraph_zero_based":2575},{"literal_text_all_w_t_and_m_t":"2>release the concerned bap-Config;","paragraph_zero_based":2576},{"literal_text_all_w_t_and_m_t":"2>if there is no other configured bap-Config for the MCG or for the SCG","paragraph_zero_based":2577},{"literal_text_all_w_t_and_m_t":"3>release the BAP entity as specified in TS 38.340 [47].","paragraph_zero_based":2578},{"literal_text_all_w_t_and_m_t":"5.3.5.12aIAB Other Configuration","paragraph_zero_based":2579},{"literal_text_all_w_t_and_m_t":"5.3.5.12a.1IP address management","paragraph_zero_based":2580},{"literal_text_all_w_t_and_m_t":"5.3.5.12a.1.1IP Address Release","paragraph_zero_based":2581},{"literal_text_all_w_t_and_m_t":"The IAB-MT shall:","paragraph_zero_based":2582},{"literal_text_all_w_t_and_m_t":"1>if the release is triggered by reception of the iab-IP-AddressToReleaseList:","paragraph_zero_based":2583},{"literal_text_all_w_t_and_m_t":"2>for each iab-IP-AddressIndex value included in iab-IP-AddressToReleaseList:","paragraph_zero_based":2584},{"literal_text_all_w_t_and_m_t":"3>release the corresponding IAB-IP-AddressConfiguration.","paragraph_zero_based":2585},{"literal_text_all_w_t_and_m_t":"5.3.5.12a.1.2IP Address Addition/Modification","paragraph_zero_based":2586},{"literal_text_all_w_t_and_m_t":"The IAB-MT shall:","paragraph_zero_based":2587},{"literal_text_all_w_t_and_m_t":"1>for each iab-IP-AddressIndex value included in the iab-IP-AddressToAddModList that is not part of the current IAB-MT configuration:","paragraph_zero_based":2588},{"literal_text_all_w_t_and_m_t":"2>add the IP address indicated in iab-IP-Address, corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2589},{"literal_text_all_w_t_and_m_t":"2>if added IP address is iPv4-Address:","paragraph_zero_based":2590},{"literal_text_all_w_t_and_m_t":"3>if iab-IP-Usage is set to f1-C:","paragraph_zero_based":2591}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["fcfdb56c13d660bf8831637778ecbd3afcbe687e54afd581e774185b9056c04e","e0dd1a4b0aabf3ef2feeb7b77a3bab65f1bd48dba7051ab92eb778679cbcac0b","4acd32ee5e23f3f0af62bbfb800dbe634eb2b21eaac1f4ffe793d21189a38a0a","a4a65ab54327e4f567cee142e4c7eb2cc62e67cf15543ac783e58366eeba049a","94c0ea034564846e6efab532c82fed644336824f5d06b394cd3177b1eeba780c","91bbed01320a2d911492cc47cbeaee080aff482a931083ce97207e16563495d5","5fe91ecd0de17ffe33ae929041f4be859ce1d792af01c40127c2b7fe1f53b4ca","b4ddae745fb0f5591c360927d58b7a7ff6e9e36890995653ccbd42d7c6d56aa8","1025c6fde38866bd4d03a5e02747c0f80df9