_m_t":"NR-DL-TDOA-AdditionalMeasurementsExt-r17 ::= SEQUENCE (SIZE (1..maxAddMeasTDOA-r17)) OF","paragraph_zero_based":1507},{"literal_text_all_w_t_and_m_t":"NR-DL-TDOA-AdditionalMeasurementElement-r16","paragraph_zero_based":1508},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1509},{"literal_text_all_w_t_and_m_t":"NR-DL-TDOA-AdditionalMeasurementElement-r16 ::= SEQUENCE {","paragraph_zero_based":1510},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-ResourceID-r16NR-DL-PRS-ResourceID-r16OPTIONAL,","paragraph_zero_based":1511}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["7743aca7efdf4a740497fc11cc50d2707db355b85f25d938b318e6af7e217f88","403553401248ec871f4fc30788e485740bbcbcc8bd614f7ab62f3ee4bf33f14c","3f6c4ef770f7a5f52ce9be5f933254cb8bf91a69846aec38ad575b8157c29fc8","787f649cba1176fd7475bd4f181c137f6d8737f6239d0e7719dee15f353eff5d","46b866a6630f8c4411083d4b7a1a1d637e2283b8fa241f63b9b2c0951b2dde6b","a44ea6a0d8980c11f1e03f75131712158a3313b6d7b825a17732e6d64608fa0c","ad2a47413bd66e4328bbd1be22fb871d292344054ffffa2bccf2d4930ee932a4","2cad6ff56474559e8df266854b84870e4e1a84d9f24e89b4629c2afacbb860dd","8fc1403ac275a51deda88a7014d3be325f9f1c883046440c644ba81623156dae","24f08a688a3b0c78c0205f7e646857b25461f40502c187e6a17aaafaf28aa8c2","84b55dcd0238c9887e816f674c2c3e829cc6a5e9f210c5a0afa28a5a49fe20b8","d0d2cf3b035905a903111518c6e83c507716e348212b95cd5d102b169fcf272b","cb33938527f410d0edde6ac4c55896cfaffaeda297bf201d45673bef5b7d8ad5","c1e83d82493fbd6101bd91504f7f77435b2e0ed13531155ad6e34a056c5c022c","6973df2eb66abe93ecca3b62643fb8bf501070205d06418bbc3b8a655ca9e447","4a7e6b73ce8468d416eafb433c1a2e375f1bd541dd062588b08f2d980174a82c","84f9696223e6c97d7630d4805cd0031bcaa