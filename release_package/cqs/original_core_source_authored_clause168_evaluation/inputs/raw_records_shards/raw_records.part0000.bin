{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE SL-SyncConfig specifies the configuration information concerning reception of synchronisation signals from neighbouring cells as well as concerning the transmission of synchronisation signals for sidelink communication.","paragraph_zero_based":39600},{"literal_text_all_w_t_and_m_t":"SL-SyncConfig information element","paragraph_zero_based":39601},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39602},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SYNCCONFIG-START","paragraph_zero_based":39603},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39604},{"literal_text_all_w_t_and_m_t":"SL-SyncConfigList-r16 ::=          SEQUENCE (SIZE (1..maxSL-SyncConfig-r16)) OF SL-SyncConfig-r16","paragraph_zero_based":39605},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39606},{"literal_text_all_w_t_and_m_t":"SL-SyncConfig-r16 ::=              SEQUENCE {","paragraph_zero_based":39607},{"literal_text_all_w_t_and_m_t":"    sl-SyncRefMinHyst-r16              ENUMERATED {dB0, dB3, dB6, dB9, dB12}                                   OPTIONAL,    -- Need R","paragraph_zero_based":39608},{"literal_text_all_w_t_and_m_t":"    sl-SyncRefDiffHyst-r16             ENUMERATED {dB0, dB3, dB6, dB9, dB12, dBinf}                            OPTIONAL,    -- Need R","paragraph_zero_based":39609},{"literal_text_all_w_t_and_m_t":"    sl-filterCoefficient-r16           FilterCoefficient                                                       OPTIONAL,    -- Need R","paragraph_zero_based":39610},{"literal_text_all_w_t_and_m_t":"    sl-SSB-TimeAllocation1-r16         SL-SSB-TimeAllocation-r16                                               OPTIONAL,    -- Need R","paragraph_zero_based":39611},{"literal_text_all_w_t_and_m_t":"    sl-SSB-TimeAllocation2-r16         SL-SSB-TimeAllocation-r16                                               OPTIONAL,    -- Need R","paragraph_zero_based":39612},{"literal_text_all_w_t_and_m_t":"    sl-SSB-TimeAllocation3-r16         SL-SSB-TimeAllocation-r16                                               OPTIONAL,    -- Need R","paragraph_zero_based":39613},{"literal_text_all_w_t_and_m_t":"    sl-SSID-r16                        INTEGER (0..671)                                                        OPTIONAL,    -- Need R","paragraph_zero_based":39614},{"literal_text_all_w_t_and_m_t":"    txParameters-r16                   SEQUENCE {","paragraph_zero_based":39615},{"literal_text_all_w_t_and_m_t":"        syncTxThreshIC-r16                 SL-RSRP-Range-r16                                                   OPTIONAL,    -- Need R","paragraph_zero_based":39616},{"literal_text_all_w_t_and_m_t":"        syncTxThreshOoC-r16                SL-RSRP-Range-r16                                                   OPTIONAL,    -- Need R","paragraph_zero_based":39617},{"literal_text_all_w_t_and_m_t":"        syncInfoReserved-r16               BIT STRING (SIZE (2))                                               OPTIONAL     -- Need R","paragraph_zero_based":39618},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":39619},{"literal_text_all_w_t_and_m_t":"    gnss-Sync-r16                      ENUMERATED {true}                                                       OPTIONAL,    -- Need R","paragraph_zero_based":39620},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":39621},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39622},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39623}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717