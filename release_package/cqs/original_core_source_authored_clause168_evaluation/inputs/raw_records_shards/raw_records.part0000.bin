{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"uplinkDirectCurrentBWP-SUL","paragraph_zero_based":30336},{"literal_text_all_w_t_and_m_t":"The Tx Direct Current locations for all the supplementary uplink BWPs configured at the corresponding serving cell.","paragraph_zero_based":30337},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30338},{"literal_text_all_w_t_and_m_t":"–UplinkTxDirectCurrentMoreCarrierList","paragraph_zero_based":30339},{"literal_text_all_w_t_and_m_t":"The IE UplinkTxDirectCurrentMoreCarrierList indicates the Tx Direct Current locations for intra-band CA including one, two or more uplink carriers. The UE does not report the uplink Direct Current location information for SUL carrier(s).","paragraph_zero_based":30340},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentMoreCarrierList information element","paragraph_zero_based":30341},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":30342},{"literal_text_all_w_t_and_m_t":"-- TAG-UPLINKTXDIRECTCURRENTMORECARRIERLIST-START","paragraph_zero_based":30343},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30344},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentMoreCarrierList-r17 ::=   SEQUENCE (SIZE (1..maxNrofCC-Group-r17)) OF CC-Group-r17","paragraph_zero_based":30345},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30346},{"literal_text_all_w_t_and_m_t":"CC-Group-r17 ::=           SEQUENCE {","paragraph_zero_based":30347},{"literal_text_all_w_t_and_m_t":"    servCellIndexLower-r17     ServCellIndex,","paragraph_zero_based":30348},{"literal_text_all_w_t_and_m_t":"    servCellIndexHigher-r17    ServCellIndex              OPTIONAL,","paragraph_zero_based":30349},{"literal_text_all_w_t_and_m_t":"    defaultDC-Location-r17     DefaultDC-Location-r17,","paragraph_zero_based":30350},{"literal_