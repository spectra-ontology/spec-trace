{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"UplinkCancellation-r16 ::=           SEQUENCE {","paragraph_zero_based":30096},{"literal_text_all_w_t_and_m_t":"    ci-RNTI-r16                          RNTI-Value,","paragraph_zero_based":30097},{"literal_text_all_w_t_and_m_t":"    dci-PayloadSizeForCI-r16             INTEGER (0..maxCI-DCI-PayloadSize-r16),","paragraph_zero_based":30098},{"literal_text_all_w_t_and_m_t":"    ci-ConfigurationPerServingCell-r16   SEQUENCE (SIZE (1..maxNrofServingCells)) OF CI-ConfigurationPerServingCell-r16,","paragraph_zero_based":30099},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":30100},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30101},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30102},{"literal_text_all_w_t_and_m_t":"CI-ConfigurationPerServingCell-r16 ::=   SEQUENCE {","paragraph_zero_based":30103},{"literal_text_all_w_t_and_m_t":"    servingCellId                            ServCellIndex,","paragraph_zero_based":30104},{"literal_text_all_w_t_and_m_t":"    positionInDCI-r16                        INTEGER (0..maxCI-DCI-PayloadSize-1-r16),","paragraph_zero_based":30105},{"literal_text_all_w_t_and_m_t":"    positionInDCI-ForSUL-r16                 INTEGER (0..maxCI-DCI-PayloadSize-1-r16)                             OPTIONAL,   -- Cond SUL-Only","paragraph_zero_based":30106},{"literal_text_all_w_t_and_m_t":"    ci-PayloadSize-r16                       ENUMERATED {n1, n2, n4, n5, n7, n8, n10, n14, n16, n20, n28, n32, n35, n42, n56, n112},","paragraph_zero_based":30107},{"literal_text_all_w_t_and_m_t":"    timeFrequencyRegion-r16                  SEQUENCE {","paragraph_zero_based":30108},{"literal_text_all_w_t_and_m_t":"        timeDurationForCI-r16                    ENUMERATED {n2, n4, n7, n14}                                      OPTIONAL,   -- Cond SymbolPeriodicity","paragraph_zero_based":30109},{"literal_text_all_w_t_and_m_t":"        timeGranularityForCI-r16                 ENUMERATED {n1, n2, n4, n7, n14, n28},","paragraph_zero_based":30110},{"literal_text_all_w_t_and_m_t":"        frequencyRegionForCI-r16                 INTEGER (0..37949),","paragraph_zero_based":30111},{"literal_text_all_w_t_and_m_t":"        deltaOffset-r16                          INTEGER (0..2),","paragraph_zero_based":30112},{"literal_text_all_w_t_and_m_t":"        ...","paragraph_zero_based":30113},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":30114},{"literal_text_all_w_t_and_m_t":"    uplinkCancellationPriority-v1610         ENUMERATED {enabled}                                                  OPTIONAL    -- Need S","paragraph_zero_based":30115},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30116},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30117},{"literal_text_all_w_t_and_m_t":"-- TAG-UPLINKCANCELLATION-STOP","paragraph_zero_based":30118},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":30119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["3090073edbfe6985f170bb3b22c9eb145c4d34e12c9085fc6e1e6ba250933dab","4bd11ff0cd984cc54fee45f32c909490908d2c52f161fa4b71458867cb197df2","76cda44c217c3d92123a8d7cfc77470682aac562d2d2ce6e23991bf37fcc2e8f","9cb365f145ebc52c936bbd6d6b0d0f5212289e2e9201011a94c3f8340aab3cd9","863cf16ec77a26614a5f25053756f6aa68711a609cfd3c90e9080c962a360ae1","f51ac0d2151bbc4c9f9a2176a9faeed25051246e4f49a0caa9d44fbeab3d5707","c305a249bd0e33aced5ba9cf4950a0852ea137178714ebe6ac15b3018b87b2d0","abc5939683dec3b34b1740f6c0d633af6002e89567