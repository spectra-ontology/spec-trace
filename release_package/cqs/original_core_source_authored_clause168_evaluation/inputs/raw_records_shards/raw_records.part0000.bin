"}","paragraph_zero_based":13929},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13930},{"literal_text_all_w_t_and_m_t":"SL-NR-AnchorCarrierFreqList-r16 ::=  SEQUENCE (SIZE (1..maxFreqSL-NR-r16)) OF ARFCN-ValueNR","paragraph_zero_based":13931},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13932},{"literal_text_all_w_t_and_m_t":"SL-EUTRA-AnchorCarrierFreqList-r16 ::= SEQUENCE (SIZE (1..maxFreqSL-EUTRA-r16)) OF ARFCN-ValueEUTRA","paragraph_zero_based":13933},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13934},{"literal_text_all_w_t_and_m_t":"SL-DiscConfigCommon-r17 ::=   SEQUENCE {","paragraph_zero_based":13935},{"literal_text_all_w_t_and_m_t":"    sl-RelayUE-ConfigCommon-r17   SL-RelayUE-Config-r17,","paragraph_zero_based":13936},{"literal_text_all_w_t_and_m_t":"    sl-RemoteUE-ConfigCommon-r17  SL-RemoteUE-Config-r17","paragraph_zero_based":13937},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":13938},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13939},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB12-STOP","paragraph_zero_based":13940},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":13941},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13942},{"literal_text_all_w_t_and_m_t":"SIB12 field descriptions","paragraph_zero_based":13943}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["a553abc45ffa5b223e08dfc516a0f6ffc280222cb015643e222d6fa9efee85dd","d4ca0de99cfdf44dc2ad0276e3e291c12f0fd9b33860151d139cc92b9cd9fed5","a664b7bbf7c021278f4bd03da077c138023256938d99959a3b4c0a2d35078868","f31719f13e3f5f66671fa57fd9ef35ada696e21e0d149f3b92490d4435c38b7d","5c22c188cd0cf1f0e4453275a6cfb882d199932