{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27480},{"literal_text_all_w_t_and_m_t":"-- TAG-SEMISTATICCHANNELACCESSCONFIG-STOP","paragraph_zero_based":27481},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27482},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27483},{"literal_text_all_w_t_and_m_t":"SemiStaticChannelAccessConfig field descriptions","paragraph_zero_based":27484},{"literal_text_all_w_t_and_m_t":"period","paragraph_zero_based":27485},{"literal_text_all_w_t_and_m_t":"Indicates the periodicity of the semi-static channel access mode (see TS 37.213 [48], clause 4.3). Value ms1 corresponds to 1 ms, value ms2 corresponds to 2 ms, value ms2dot5 corresponds to 2.5 ms, and so on.","paragraph_zero_based":27486},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27487},{"literal_text_all_w_t_and_m_t":"–SemiStaticChannelAccessConfigUE","paragraph_zero_based":27488},{"literal_text_all_w_t_and_m_t":"The IE SemiStaticChannelAccessConfigUE is used to configure channel access parameters for UE initiated semi-static channel access.","paragraph_zero_based":27489},{"literal_text_all_w_t_and_m_t":"SemiStaticChannelAccessConfigUE information element","paragraph_zero_based":27490},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27491},{"literal_text_all_w_t_and_m_t":"-- TAG-SEMISTATICCHANNELACCESSCONFIGUE-START","paragraph_zero_based":27492},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27493},{"literal_text_all_w_t_and_m_t":"SemiStaticChannelAccessConfigUE-r17 ::=    SEQUENCE {","paragraph_zero_based":27494},{"literal_text_all_w_t_and_m_t":"    periodUE-r17                               ENUMERATED {ms1, ms2, ms2dot5, ms4, ms5, ms10, spare2, spare1},","paragraph_zero_based":27495},{"literal_text_all_w_t_and_m_t":"    offsetUE-r17                               INTEGER (0..559)","paragraph_zero_based":27496},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27497},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27498},{"literal_text_all_w_t_and_m_t":"-- TAG-SEMISTATICCHANNELACCESSCONFIGUE-STOP","paragraph_zero_based":27499},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27500},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27501},{"literal_text_all_w_t_and_m_t":"SemiStaticChannelAccessConfigUE field descriptions","paragraph_zero_based":27502},{"literal_text_all_w_t_and_m_t":"periodUE","paragraph_zero_based":27503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["d5983fe4942498b5b37ceafcf7cdd1aac343ec4127779793bbe7e4704fc3c9a3","86410bbfd78577e90b5876abea7889c2ee7f94edf5f9ec3bfc65bbc01ace7142","fa3f8533c96ca4aa704c14c026ff67f607d460d1a15e17e599ed9213151f2086","73a100fa337bb314ce2fa96daf538fedc42c56e7124fbb36fbe2596484db4903","241ad95c6acf28807054eb00b10e400dff9b8ffb5344ef9969d1a5547e97b1d2","c214765cbc2c74dae324d1804a758680d44ad511507fa6ab188281eee6845b0e","abea99e062a54f2d2821d86caf39fe6d59f40e29fb7a8f042f14c3feb317324f","929764769805abd3d5aad907d78921bb12f006f9749cf5e84a86b9435a3653ea","67b4072cc74633498897a42dd20c8c4b8b0c53c2a126236f3979009ac5adf4b8","7838fae9c811e6a12a59169b72940cfe10004b7aef46c364bce7ae20a5e59ced","27f42f22bcac8fef92739e864be2f6813a167c53baee44defe6021c34f1a9cfa","541bf6b15a8e919b3ae9125148790de67b6786059b9d60c501c2e13f5e1b3997","ecc3246f2c1dc0ed71d89331d1e92f818e41c173821edf07508a55c4994b6c0a","c046828330122f47f60ddfe93b2236a9041a9bb23142c2f12c4a629b7dbd893f","01f355d40cf7cff8ca43da5e8fc01b3e1a41a9ce680651a8b5d80d8e5decee1a","eeac263e68375bc7b901eee30735193fb0d2782c7b5520c4792d480127d2d2ba","2b4afcd65a9a10f10803a93a387b34b1bc42d2a5665cf9992c84450724ffb1ac","56223767295036f8b75190d49b42eee93c2520616219777e987a86e5ba362045","d43962cdcd3318489a51b56695fc3455870ae2adc35d535daf82cb5b2c2043c0","b23169bb2b4f1699bbc3edd4efed0eae449b7bb757673eb3a6c309d2ab8f472d","223147b513a0227428e2a1fa7e5e2f7e656f2e2026d014fd29e248b295a0ee99","1be92502a2d04c6d6c3e82102877e536655ebaa52ca8d499a59f7b325f3fab6e","ab32689fd7b2375e0b48d6d1d28e30effb5daad219203a111ec46e5c03c3f240","a9e23c508f1d22108d5d82e54da9f1ab165dc6fb431f731c66ceae9fb7ed7dcf"],"paragraph_range_zero_based":[27480,27503],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p27480"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the period of a channel occupancy that the UE can initiate as described in TS 37.213 [48], clause 4.3. Value ms1 corresponds to 1 ms, value ms2 corresponds to 2 ms, value ms2dot5 corresponds to 2.5 ms, and so on.","paragraph_zero_based":27504},{"literal_text_all_w_t_and_m_t":"offsetUE","paragraph_zero_based":27505},{"literal_text_all_w_t_and_m_t":"Indicates the number of symbols from the beginning of the even indexed radio frame to the start of the first period within that radio frame that the UE can initiate a channel occupancy (see TS 37.213 [48], clause 4.3), based on the smallest SCS among the configured SCSs in the serving cell. The offset duration indicated by this field is less than the period duration indicated by periodUE. The maximum value is 139, 279 and 559 for 15, 30 and 60 kHz subcarrier spacing, respectively.","paragraph_zero_based":27506},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27507},{"literal_text_all_w_t_and_m_t":"–Sensor-LocationInfo","paragraph_zero_based":27508},{"literal_text_all_w_t_and_m_t":"The IE Sensor-LocationInfo is used by the UE to provide sensor information.","paragraph_zero_based":27509},{"literal_text_all_w_t_and_m_t":"Sensor-LocationInfo information element","paragraph_zero_based":27510},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27511},{"literal_text_all_w_t_and_m_t":"-- TAG-SENSORLOCATIONINFO-START","paragraph_zero_based":27512},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27513},{"literal_text_all_w_t_and_m_t":"Sensor-LocationInfo-r16 ::= SEQUENCE {","paragraph_zero_based":27514},{"literal_text_all_w_t_and_m_t":"    sensor-MeasurementInformation-r16    OCTET STRING    OPTIONAL,","paragraph_zero_based":27515},{"literal_text_all_w_t_and_m_t":"    sensor-MotionInformation-r16         OCTET STRING    OPTIONAL,","paragraph_zero_based":27516},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":27517},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27518},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27519},{"literal_text_all_w_t_and_m_t":"-- TAG-SENSORLOCATIONINFO-STOP","paragraph_zero_based":27520},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27521},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27522},{"literal_text_all_w_t_and_m_t":"Sensor-LocationInfo field descriptions","paragraph_zero_based":27523},{"literal_text_all_w_t_and_m_t":"sensor-MeasurementInformation","paragraph_zero_based":27524},{"literal_text_all_w_t_and_m_t":"This field provides barometric pressure measurements as Sensor-MeasurementInformation defined in TS 37.355 [49]. The first/leftmost bit of the first octet contains the most significant bit.","paragraph_zero_based":27525},{"literal_text_all_w_t_and_m_t":"sensor-MotionInformation","paragraph_zero_based":27526},{"literal_text_all_w_t_and_m_t":"This field provides motion sensor measurements as Sensor-MotionInformation defined in TS 37.355 [49]. The first/leftmost bit of the first octet contains the most significant bit.","paragraph_zero_based":27527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["4cd67fb342c37eb15bb6bdc617740d8b2880a8ade938cf5b1527bc49af95cf77","d6deba39bdc237e5799d0bbd7409a1034e7c4b174f207cbb3c0eb3bc61269a61","6ba67e683be8d02cd953823662ad4a724a70bc10ca37b9eba3db1f42565c5f8a","738ede053cf2700671210afb64220306db5ef95fe85022c8171c901965a81f4d","eba01e2c73010b1ee12af6e07f08df6cff1b514923f7984242f8a3e0baf0b7a9","ffa62