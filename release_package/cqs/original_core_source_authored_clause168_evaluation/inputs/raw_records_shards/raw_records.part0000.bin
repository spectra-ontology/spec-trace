{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    freqBandIndicatorNR                         FreqBandIndicatorNR         OPTIONAL,   -- Cond OptULNotSIB2","paragraph_zero_based":21072},{"literal_text_all_w_t_and_m_t":"    nr-NS-PmaxList                              NR-NS-PmaxList              OPTIONAL    -- Need S","paragraph_zero_based":21073},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21074},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21075},{"literal_text_all_w_t_and_m_t":"MultiFrequencyBandListNR-SIB-v1760 ::=      SEQUENCE (SIZE (1.. maxNrofMultiBands)) OF NR-MultiBandInfo-v1760","paragraph_zero_based":21076},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21077},{"literal_text_all_w_t_and_m_t":"NR-MultiBandInfo-v1760 ::=                  SEQUENCE {","paragraph_zero_based":21078},{"literal_text_all_w_t_and_m_t":"    nr-NS-PmaxList-v1760                        NR-NS-PmaxList-v1760        OPTIONAL    -- Need S","paragraph_zero_based":21079},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21080},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21081},{"literal_text_all_w_t_and_m_t":"MultiFrequencyBandListNR-Aerial-SIB-r18 ::=           SEQUENCE (SIZE (1.. maxNrofMultiBands)) OF NR-MultiBandInfoAerial-r18","paragraph_zero_based":21082},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21083},{"literal_text_all_w_t_and_m_t":"NR-MultiBandInfoAerial-r18 ::=                        SEQUENCE {","paragraph_zero_based":21084},{"literal_text_all_w_t_and_m_t":"    freqBandIndicatorNR-Aerial-r18                        FreqBandIndicatorNR         OPTIONAL,   -- Cond OptULNotSIB2","paragraph_zero_based":21085},{"literal_text_all_w_t_and_m_t":"    nr-NS-PmaxListAerial-r18                              NR-NS-PmaxListAerial-r18    OPTIONAL    -- Need S","paragraph_zero_based":21086},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21087},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21088},{"literal_text_all_w_t_and_m_t":"-- TAG-MULTIFREQUENCYBANDLISTNR-SIB-STOP","paragraph_zero_based":21089},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21090},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21091},{"literal_text_all_w_t_and_m_t":"NR-MultiBandInfo field descriptions","paragraph_zero_based":21092},{"literal_text_all_w_t_and_m_t":"freqBandIndicatorNR","paragraph_zero_based":21093},{"literal_text_all_w_t_and_m_t":"Provides an NR frequency band number as defined in TS 38.101-1 [15], TS 38.101-2 [39], table 5.2-1, and TS 38.101-5 [75], table 5.2.2-1.","paragraph_zero_based":21094},{"literal_text_all_w_t_and_m_t":"freqBandIndicatorNR-Aerial","paragraph_zero_based":21095}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["552ea48e8e58a9f9296727721e93e762c998eb46a87726051544f6dce636c04b","52f20723d96878821d6d04c6643fb5f769aa59442e55497b04b3d7ff260ccca3","52871cc2c94575a0349d15568be7c96badf216f68692c23f9cb8a10e0bb1c54e","6bb3e796e7c2cde50744dafafaec5f24b99a424638c7dd698119541890a2d3df","fbb6ec0915a8fd62b31aeea8b70747e1158989b64a999edd8749cab561dfc243","975ace895c30a5c2d5e3613d06871fc1ad9e421309f617151823910d141ef494","0ec4aa9790d878cba1e8d2ea344f18414f426f966ef189f905420595e84206f2","aabbb3b81100a3094b962cb86df748f933847acc8880c207c6e05f1010769767","87048ef32e355c9e40e7606e301964a2fd5a48a23b7000c490040222b7a9d006","13366fa1987f15a34c67f2876881eae47c70ebbe143e345b108608321987d480","a6397edec7871ac3e0aab161f3ff647fae5b622a43ad62b9b46dbbf76cd7f758","7b9fa20937452843a0e8f3bd99e0bd68dccb6e2645abb4e2d66d6793d5573b48","d137a719b0a88a3bd79e89f2f2f4eead0f700040471758aeefa6cd9e7db5583c","72a27e35b6bcb5beaedc529b4bb1c4ccdf438ed38736fe19420b8b2ecd14a95c","7b1a3f70649b0a2b59c561c040bd2030f102576bf823e19017116c78e9bdac09","1944127ba95e1b4556d2c0829277e60d1003bcef9ab218a7ca0aeab049e2305b","64a652cf9cca1082131ae9b0d886884861a3448c488c41f710d0789730433c06","6516da33bc02fe6514248362ef752dbff03463ed1fe220785c546eaa1abd6115","e4d079f54cb439d2143a7539a7d6bcbc1a197cd7bb65d9fd97ea62f080890d69","fbb035f2eb9d16a6487aac898ecfe482928f2e7dcb122cfa7263459b3ae38fab","b3b7018fdab17b5c4c05f63aec35e5b299e3dfaf25c054e02f96bfff0c440407","47af818c9a79b94e97898c75f52e47b6ab0845ec7d0fe535e6d20cdb1655dfae","ffcafd86e0cccf3be767459110c7bd451af238c348b0a7413f143c4502a954ed","3da469df0a7eaaafedd50a929b8c3f332735d11dd6dc6b3ce4ad361e23fbada1"],"paragraph_range_zero_based":[21072,21095],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p21072"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Provides an NR frequency band number for aerial UE, as defined in TS 38.101-1 [15], TS 38.101-2 [39], table 5.2-1, and TS 38.101-5 [75], table 5.2.2-1.","paragraph_zero_based":21096},{"literal_text_all_w_t_and_m_t":"nr-NS-PmaxList","paragraph_zero_based":21097},{"literal_text_all_w_t_and_m_t":"Provides a list of additionalPmax and additionalSpectrumEmission values. If the field is absent the UE uses value 0 for the additionalSpectrumEmission (see TS 38.101-1 [15] table 6.2.3.1-1A, TS 38.101-2 [39], table 6.2.3.1-2, and TS 38.101-5 [75], table 6.2.3.1-1A). This field is ignored by IAB-MT, the IAB-MT applies output power and emissions requirements, as specified in TS 38.174 [63]. If nr-NS-PmaxList-v1760 is present, it shall contain the same number of entries, listed in the same order as in nr-NS-PmaxList (without suffix).","paragraph_zero_based":21098},{"literal_text_all_w_t_and_m_t":"nr-NS-PmaxListAerial","paragraph_zero_based":21099},{"literal_text_all_w_t_and_m_t":"Provides a list of additionalPmax and additionalSpectrumEmission values for aerial UE. If the field is absent, the value indicated by the corresponding field within frequencyBandList for the corresponding NR frequency band number applies, if present. Otherwise (i.e. the field is not present for the corresponding NR frequency band number in any of the nr-NS-PmaxList, nr-NS-PmaxList-v1760 or nr-NS-PmaxListAerial), the UE uses value 0 for the additionalSpectrumEmission (see TS 38.101-1 [15] table 6.2.3.1-1A, TS 38.101-2 [39], table 6.2.3.1-2, and TS 38.101-5 [75], table 6.2.3.1-1A). This field is ignored by IAB-MT, the IAB-MT applies output power and emissions requirements, as specified in TS 38.174 [63].","paragraph_zero_based":21100},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21101},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":21102},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":21103},{"literal_text_all_w_t_and_m_t":"OptULNotSIB2","paragraph_zero_based":21104},{"literal_text_all_w_t_and_m_t":"The field is absent for SIB2 and is mandatory present in SIB4 and frequencyInfoDL-SIB. Otherwise, if the field is absent in frequencyInfoUL-SIB in UplinkConfigCommonSIB, the UE will use the frequency band indicated in frequencyInfoDL-SIB in DownlinkConfigCommonSIB.","paragraph_zero_based":21105},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21106},{"literal_text_all_w_t_and_m_t":"–MUSIM-GapConfig","paragraph_zero_based":21107},{"literal_text_all_w_t_and_m_t":"The IE MUSIM-GapConfig specifies the MUSIM gap configuration and controls setup/release of MUSIM gaps.","paragraph_zero_based":21108},{"literal_text_all_w_t_and_m_t":"MUSIM-GapConfig information element","paragraph_zero_based":21109},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21110},{"literal_text_all_w_t_and_m_t":"-- TAG-MUSIM-GAPCONFIG-START","paragraph_zero_based":21111},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21112},{"literal_text_all_w_t_and_m_t":"MUSIM-GapConfig-r17 ::=                  SEQUENCE {","paragraph_zero_based":21113},{"literal_text_all_w_t_and_m_t":"musim-GapToReleaseList-r17       SEQUENCE (SIZE (1..3)) OF MUSIM-GapId-r17               OPTIONAL, -- Need N","paragraph_zero_based":21114},{"literal_text_all_w_t_and_m_t":"musim-GapToAddModList-r17        SEQUENCE (SIZE (1..3)) OF MUSIM-Gap-r17             OPTIONAL, -- Need N","paragraph_zero_based":21115},{"literal_text_all_w_t_and_m_t":"musim-AperiodicGap-r17           MUSIM-GapInfo-r17                OPTIONAL, -- Need N","paragraph_zero_based":21116},{"literal_text_all_w_t_and_m_t":"   ...","paragraph_zero_based":21117},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21118},{"literal_text_all_w_t_and_m_t":"MUSIM-Gap-r17 ::=          SEQUENCE {","paragraph_zero_based":21119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["c7d78f633b34e042004e6dee43914d20a366177b8bd393cfcdba539789fddbe4","3277b28f7354c649b3256527640e43056a2dcbc8e07f9009faea842ebfa464a9","2dab506562e0e74528893e2b9faac0b77fd3834c1c56fc00aec352b8453e03ef","9e9de450e0c034ba675c1eece5e3cf92628e5a9285236dca9bfca1255736896a","0e2ba530ac563196a12c2376971acfcf849ff7595a2036b6b379fa1d5e805533","c6bb2a99f0f048591963f026a910da226de25b85664a3a0be6985739de1a0508","fa6de4a7e7433fc5821e8f7c3c3ab2b41e0b2df6dcde90254b015707c26ff47f","3e12630a4693db7d2c36ce958bc0278381ef1cb87d73944e17d43c5ad3ff0f91","f87885c6a0bf81ac26ab607d2ee28e94d0c9601162a23757f624662c2aff8f2f","db2ce388f75b650d5e0edf35bce0d441bd5633d78006d0c424cad1235b909ca0","f59ff60ae0e3dac81af9dc94985502dd0c68af3949eb66b5b7336ee22b97dc50","25d2e1042fdc0c6508ccd9d4790e666a825f89e65a115e2a3008912c51e69699","f1dc97bd2b7676155b4d419a54e37a852edb70dbda0c89def2cdd6793092fed7","1d2990f67f4eda9211604ed4d933bf76a248e776c869382bd4b020c8338fa155","813f231d61bac3ac8430f50bc97f23a5118556c5626e4a54ac09e7ee6de1d9ca","e95bb5220825ae7535cc407e4c35964941ba7156ed413ae49779a1b895fe2de4","c078ecbf38cfbac36066c44ef229c3cd60e2c14f2e09a14da510e50fd367eea0","b3bf7e5fee1fc81fdf8dcaa3d521278788a00dfd103f292885ee951fe23b077e","0d9b2f8a8a27cb40faedfe3fc151d72d37236a4aa7dca13cc671493bf18ff5c8","bdb4446b4ab342badcd57b5805ccddbcc7bfdeb2b55e476da1a4d1db295092d0","cbb5d3968f82c0fa63cd2613ae92ac2d7bef73be06f19bce6ed7e6366c8f6fd1","bcd17b9a60386d964a46dfbea044a11027f1537d263123e99f52f083be5f1a14","8728acdcb872ce77458f5fa07074765d234547f1c1e7057ffcba6202e34c58a9","362f7dd8fff50346ef0ead5b2ff23dc4a2cfa9ffe88