{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"FR2-Only","paragraph_zero_based":28128},{"literal_text_all_w_t_and_m_t":"This field is mandatory present for an FR2 carrier frequency. It is absent otherwise and UE releases any configured value.","paragraph_zero_based":28129},{"literal_text_all_w_t_and_m_t":"SharedSpectrum","paragraph_zero_based":28130},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if this cell operates with shared spectrum channel access in FR1. Otherwise, it is absent, Need R.","paragraph_zero_based":28131},{"literal_text_all_w_t_and_m_t":"SharedSpectrum2","paragraph_zero_based":28132},{"literal_text_all_w_t_and_m_t":"This field is optionally present if this cell operates with shared spectrum channel access in FR2-2, Need R. Otherwise, it is absent, Need R.","paragraph_zero_based":28133},{"literal_text_all_w_t_and_m_t":"TDD","paragraph_zero_based":28134},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, for TDD cells; otherwise it is absent.","paragraph_zero_based":28135},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28136},{"literal_text_all_w_t_and_m_t":"–ShortI-RNTI-Value","paragraph_zero_based":28137},{"literal_text_all_w_t_and_m_t":"The IE ShortI-RNTI-Value is used to identify the suspended UE context of a UE in RRC_INACTIVE using fewer bits compared to I-RNTI-Value.","paragraph_zero_based":28138},{"literal_text_all_w_t_and_m_t":"ShortI-RNTI-Value information element","paragraph_zero_based":28139},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28140},{"literal_text_all_w_t_and_m_t":"-- TAG-SHORTI-RNTI-VALUE-START","paragraph_zero_based":28141},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28142},{"literal_text_all_w_t_and_m_t":"ShortI-RNTI-Value ::=   BIT STRING (SIZE(24))","paragraph_zero_based":28143},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28144},{"literal_text_all_w_t_and_m_t":"-- TAG-SHORTI-RNTI-VALUE-STOP","paragraph_zero_based":28145},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28146},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28147},{"literal_text_all_w_t_and_m_t":"–ShortMAC-I","paragraph_zero_based":28148},{"literal_text_all_w_t_and_m_t":"The IE ShortMAC-I is used to identify and verify the UE at RRC connection re-establishment. The 16 least significant bits of the MAC-I calculated using the AS security configuration of the source PCell, as specified in 5.3.7.4.","paragraph_zero_based":28149},{"literal_text_all_w_t_and_m_t":"ShortMAC-I information element","paragraph_zero_based":28150},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28151}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["76826d821e495972d241f863d4dae2301fcbbde31ce50f4b1b47407bf906e9fa","854714330a8bc52373382eda9e33858b78afbf2292c3990392da2eb8bbfb6e36","ab5cc219f254de77f43b453029dd1e7659db228dd8d36323ee7d5bbe6b667a2a","10d87ad7ae2eccfd9ee20a3ff7fffd7dc45a9e9ed82bfaa4254ab758cc606807","d940c6dcbec5d8c182035353a9f0bde374f4eb3d49ab579d81aaf685c15eacd9","36c0bb5788d0d5cd6e18e7568637558d2ea3b011cf5008f47d5b753c30db7b63","873489b90ebe81f0e9e89bb91b1ffe8e08d70d14f5253b9c459675736e765a2f","f79a6f6844a17c018cb7bc8d537cf038fa1371e54718225ba3fab53a1a810bf0","553f8cc3072ae1b6e270230063b828a872a516bc7ae6d1d9302cda8196ecf94b","19bfa7a9a144af4d50bfa1f6d269521485a4eb9acefd9e8b1e9ba84b003a478d","ca97ff79ecb38f3366009d497805e5d3126896424d3900f287e2dd62ef7cbd2b","fa2cbb2374ee961c5bc38d7ccfb9f16f69b6f0b2afde25fb08b8e9cc722fd184","0144fa452ab0d05a906b5aa37040ca0d97daa1828bd8f0aed22a64685b0e338d","fc646414e765fc4a85a483388a2c02d30db15bea8de298155022afa3c63da6f8","901e30456fd5d6840c8a9af7659a604e9c037017f860f4cf4e942802404a257d","f0526ddc90b30e163a221149bc983b4bbe638ad0bb588954fd7d7163c2399133","d98ae0b79a598e3fe4cebba22ee5606db8e8e7956b275cfe7f1a01b0c78013e9","69e8f4093baf21d1b4360d4fb2ffea5b3b8e832970ba508edd4873dd45a38f93","8a9bded5e2d5004476e905a61bb6d6bd3ae7e471ed89e16c05c133032028ec71","424e17a97a23bd9193a52f277e7b8825d1b8fa0e1cb0a81c6be82f26e34ea6f1","d11730eaf7e8a0773ed64ed2c869e1e4cee60f73717309ad9f5c5c8479e47081","1092359e81b1004c9b3b96148e14e0429afbac1ca94efe2f56f7ce28fb2c6eb0","b8d8fce2ba9e922d365cc242ff2e268d84cc13147c023a0ad1d424df6b7ef66d","7588b5ef65541539a28080aeb98c384b8956f268a76c42c77cb395c942b67683"],"paragraph_range_zero_based":[28128,28151],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p28128"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-SHORTMAC-I-START","paragraph_zero_based":28152},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28153},{"literal_text_all_w_t_and_m_t":"ShortMAC-I ::=                      BIT STRING (SIZE (16))","paragraph_zero_based":28154},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28155},{"literal_text_all_w_t_and_m_t":"-- TAG-SHORTMAC-I-STOP","paragraph_zero_based":28156},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28157},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28158},{"literal_text_all_w_t_and_m_t":"–SINR-Range","paragraph_zero_based":28159},{"literal_text_all_w_t_and_m_t":"The IE SINR-Range specifies the value range used in SINR measurements and thresholds. For measurements, integer value for SINR measurements is according to Table 10.1.16.1-1 in TS 38.133 [14]. For thresholds, the actual value is (IE value – 46) / 2 dB.","paragraph_zero_based":28160},{"literal_text_all_w_t_and_m_t":"SINR-Range information element","paragraph_zero_based":28161},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28162},{"literal_text_all_w_t_and_m_t":"-- TAG-SINR-RANGE-START","paragraph_zero_based":28163},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28164},{"literal_text_all_w_t_and_m_t":"SINR-Range ::=                      INTEGER(0..127)","paragraph_zero_based":28165},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28166},{"literal_text_all_w_t_and_m_t":"-- TAG-SINR-RANGE-STOP","paragraph_zero_based":28167},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28168},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28169},{"literal_text_all_w_t_and_m_t":"–SI-RequestConfig","paragraph_zero_based":28170},{"literal_text_all_w_t_and_m_t":"The IE SI-RequestConfig contains configuration for Msg1 based SI request.","paragraph_zero_based":28171},{"literal_text_all_w_t_and_m_t":"SI-RequestConfig information element","paragraph_zero_based":28172},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28173},{"literal_text_all_w_t_and_m_t":"-- TAG-SI-REQUESTCONFIG-START","paragraph_zero_based":28174},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28175}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["ddc3c603b0fcf7b6c36e6c16ba74eff5faba7a239e9b0a5521010aca0f3535e8","50edaeb183490bcc8946bbf993447be526464c9a5993e325ecb5fe1d7217165d","3b0e1f5af1db2eed1f110627db86d4851bd07f7b4870bb8816020d862a41bb3c","c98181270fded7abdcb71bdf5ef4e33c937620653eb60c9352f364b13330e573","b17cdb8e1576ac6e16dff61eb714d01262410e7d4d8924f14f68f341e666ff3f","6c89698955e517311223372ef7767d2f84d3756425a872060af58ca7f92c524d","31de98b794552e79d5381f2e1170e56369d8e6d67c9727728308834351e8fd52","b4509eef2a28852ca3aa6f29c10b9214ded689b38672d6a07161c639b00cf65a","fb0c8aa1b38cf9744b95e0c9107acc260e0cd6283398ed8c8a5d4a9489f362d2","42ff49a1874cbde56aa6b5a7d66e246c0622326e14c2fbb81a6c938744018f80","a3cc95526a84d008f922f292906912c9e87771bf94f428e35c68e96b968d71b6","b41c107c2a8a6bf8d74c38aecba482e7091ddff4ad3ee49c8f84364411223aa8","ab771fdafc165a9eb286a66d7e3f8843042564c47a5ffb790c0154fe521eac56","f967fc62f2abce7f1e4dc37d462496902fa5ee3b254f3f6fa80253725dc13bb2","864fb6d8e3c4826046cf0f415aadb1e60436b702d3453774b43a2fc34923e33e","e592cbdddf45b5eb24be4f68474f38a63763751803b593451a8303aba690526b","b6639e94982b2c05bad1786fd5f0d91e8c0c317ebf3cf0178c3e4acec59d6b1f","d43b86348dafa392d4c67aa5b44905b0c2bca256e7136cf1bd07b5e0fc55d5d1","ac15814018