{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2472},{"literal_text_all_w_t_and_m_t":"NR-On-Demand-DL-PRS-Configurations-Selected-IndexList-r17 ::=","paragraph_zero_based":2473},{"literal_text_all_w_t_and_m_t":"SEQUENCE (SIZE (1..maxOD-DL-PRS-Configs-r17)) OF","paragraph_zero_based":2474},{"literal_text_all_w_t_and_m_t":"DL-PRS-Configuration-ID-r17","paragraph_zero_based":2475},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2476},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":2477},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2478},{"literal_text_all_w_t_and_m_t":"–NR-On-Demand-DL-PRS-Support","paragraph_zero_based":2479},{"literal_text_all_w_t_and_m_t":"The IE NR-On-Demand-DL-PRS-Support defines the target device's on-demand DL-PRS capabilities.","paragraph_zero_based":2480},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":2481},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2482},{"literal_text_all_w_t_and_m_t":"NR-On-Demand-DL-PRS-Support-r17 ::= SEQUENCE {","paragraph_zero_based":2483},{"literal_text_all_w_t_and_m_t":"nr-on-demand-DL-PRS-InformationSup-r17ENUMERATED { supported }OPTIONAL,","paragraph_zero_based":2484},{"literal_text_all_w_t_and_m_t":"nr-on-demand-DL-PRS-ConfigurationsSup-r17ENUMERATED { supported }OPTIONAL,","paragraph_zero_based":2485},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":2486},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2487},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":2488},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2489},{"literal_text_all_w_t_and_m_t":"NR-On-Demand-DL-PRS-Support field descriptions","paragraph_zero_based":2490},{"literal_text_all_w_t_and_m_t":"nr-on-demand-DL-PRS-InformationSup","p