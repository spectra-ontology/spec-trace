{"fields":{"filename":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-SL-L2REMOTEUE-CONFIG-STOP","paragraph_zero_based":2544},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":2545},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2546},{"literal_text_all_w_t_and_m_t":"SL-L2RemoteUE-Config field descriptions","paragraph_zero_based":2547},{"literal_text_all_w_t_and_m_t":"sl-SRAP-ConfigRemote","paragraph_zero_based":2548},{"literal_text_all_w_t_and_m_t":"Indicates SRAP configuration used for L2 U2N Remote UE.","paragraph_zero_based":2549},{"literal_text_all_w_t_and_m_t":"sl-UEIdentityRemote","paragraph_zero_based":2550},{"literal_text_all_w_t_and_m_t":"Indicates the C-RNTI to the L2 U2N Remote UE.","paragraph_zero_based":2551},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2552},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":2553},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":2554},{"literal_text_all_w_t_and_m_t":"FirstRRCReconfig","paragraph_zero_based":2555},{"literal_text_all_w_t_and_m_t":"This field is mandatory present in the first RRCReconfiguration. Otherwise the field is absent.","paragraph_zero_based":2556},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2557},{"literal_text_all_w_t_and_m_t":"<<Skip Unchanged>>","paragraph_zero_based":2558},{"literal_text_all_w_t_and_m_t":"–SL-RLC-ChannelConfig","paragraph_zero_based":2559},{"literal_text_all_w_t_and_m_t":"The IE SL-RLC-ChannelConfig specifies the configuration information for PC5 Relay RLC channel between L2 U2N Relay UE and L2 U2N Remote UE.","paragraph_zero_based":2560},{"literal_text_all_w_t_and_m_t":"SL-RLC-ChannelConfig information element","paragraph_zero_based":2561},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":2562},{"lite