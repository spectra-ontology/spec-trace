{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-RNTI-VALUE-STOP","paragraph_zero_based":26832},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26833},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26834},{"literal_text_all_w_t_and_m_t":"–RSRP-Range","paragraph_zero_based":26835},{"literal_text_all_w_t_and_m_t":"The IE RSRP-Range specifies the value range used in RSRP measurements and thresholds. For measurements, integer value for RSRP measurements is according to Table 10.1.6.1-1 in TS 38.133 [14]. For thresholds, the actual value is (IE value – 156) dBm, except for the IE value 127, in which case the actual value is infinity.","paragraph_zero_based":26836},{"literal_text_all_w_t_and_m_t":"RSRP-Range information element","paragraph_zero_based":26837},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26838},{"literal_text_all_w_t_and_m_t":"-- TAG-RSRP-RANGE-START","paragraph_zero_based":26839},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26840},{"literal_text_all_w_t_and_m_t":"RSRP-Range ::=                      INTEGER(0..127)","paragraph_zero_based":26841},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26842},{"literal_text_all_w_t_and_m_t":"-- TAG-RSRP-RANGE-STOP","paragraph_zero_based":26843},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26844},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26845},{"literal_text_all_w_t_and_m_t":"–RSRQ-Range","paragraph_zero_based":26846},{"literal_text_all_w_t_and_m_t":"The IE RSRQ-Range specifies the value range used in RSRQ measurements and thresholds. For measurements, integer value for RSRQ measurements is according to Table 10.1.11.1-1 in TS 38.133 [14]. For thresholds, the actual value is (IE value – 87) / 2 dB.","paragraph_zero_based":26847},{"literal_text_all_w_t_and_m_t":"RSRQ-Range information element","paragraph_zero_based":26848},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26849},{"literal_text_all_w_t_and_m_t":"-- TAG-RSRQ-RANGE-START","paragraph_zero_based":26850},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26851},{"literal_text_all_w_t_and_m_t":"RSRQ-Range ::=                      INTEGER(0..127)","paragraph_zero_based":26852},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26853},{"literal_text_all_w_t_and_m_t":"-- TAG-RSRQ-RANGE-STOP","paragraph_zero_based":26854},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26855}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["faebde622181d1cc59f420baae3374e288d5414dc5137895e669a47e75e92903","04788781537c4b8f0b560e0186ca0e456f5ba9a3a510938c462a76e2436d8690","e571f2a598bbb902c720c86256d4244bc6336a6ef6b8d4631b3444f990acd5e4","d3cedc34b377aa67808477c7c9490a5b0abbe55f23de06229322a50a18f6c316","ddbd30d7e806f067eb82844c80acd108452058da6c4e827542edd69336325863","e62bebe7e78588f29c7ae37d167685a572016b379ee4c0c7b6d0897c5fa013cb","78da7b98ec5dc440bcdcd1a109cfc31015d9d0822d648fc35fc2f82a9340f978","4cf12f495d5d665d322e2961af58a8190285feb320e6136993b2fa19a82b4505","d039f13cd126d0c98cb82dc58654846ca4fd2e7bc99ef3f3668982f2dd0d37e2","69a8dfeb3c0f873e858b0b45f28c341fb5dfc8ba8d76cc14af621b27d4afa52d","25b5f58b4244f7e715789513308afe8553f2f8b0347aaca0650431cdfbe4aeba","7abd5c7df00130cf0e785068f81384e725836b4b32fa60c4873db273daa7965d","f1303484762d10593c6f82c08db69a7341ab9dd4b52d79af8b8cdf743fb919bc","242722ce7338d6ea3d3019b47ef4cd4d1b40ae6be63da84e813a4f1dab283552","e7b9936f84f6417a3df1f6f5a8784d2e36fe34b547be0354bc728a5911a178ec","afe509aa097baebcfd5d0779bbbb9f553640f2dee941b820044f59ff9bfe24ed","1abd7c7020d4f47b416ace4a9613892519d5cc3399a921343496dc0519d2b8af","ab6fa65beddc2db2471657ea7adbab6097c2ed0755ac9b490e3c9ac09453f4d3","45a9457f56b114bde87748864e1637702fdbe586a5b098c60a30fbd286fad32a","c1aca0787dc7f9cbd37f8c7da7f37b227fcf5712dbbef8fc69bf9524d92ccb3c","72f3737e8ec88a9086b5e48bfc6ff4e1e2e8b1251e4c7eb5285a02c1ab580686","194602c2800bb1a4b5bbaa7fa72bbc5cfcacd5c554ffdcca2c0f40e25fdb5bad","2ceeec14963de21160f38a6ee18ee54f45461dd51a7394136267097daf12b2a1","5e578dbf16686bd74eab8571a174317332cd6459c45ce05c789c23b3ebd2eb35"],"paragraph_range_zero_based":[26832,26855],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p26832"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26856},{"literal_text_all_w_t_and_m_t":"–RSSI-Range","paragraph_zero_based":26857},{"literal_text_all_w_t_and_m_t":"The IE RSSI-Range specifies the value range used in RSSI measurements and thresholds for NR operation with shared spectrum channel access. The integer value for RSSI measurements is according to Table 10.1.34.3-1 in TS 38.133 [14].","paragraph_zero_based":26858},{"literal_text_all_w_t_and_m_t":"RSSI-Range information element","paragraph_zero_based":26859},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26860},{"literal_text_all_w_t_and_m_t":"-- TAG-RSSI-RANGE-START","paragraph_zero_based":26861},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26862},{"literal_text_all_w_t_and_m_t":"RSSI-Range-r16 ::=                  INTEGER(0..76)","paragraph_zero_based":26863},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26864},{"literal_text_all_w_t_and_m_t":"-- TAG-RSSI-RANGE-STOP","paragraph_zero_based":26865},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26866},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26867},{"literal_text_all_w_t_and_m_t":"–RxTxTimeDiff","paragraph_zero_based":26868},{"literal_text_all_w_t_and_m_t":"The IE RxTxTimeDiff contains the Rx-Tx time difference measurement at either the UE or the gNB.","paragraph_zero_based":26869},{"literal_text_all_w_t_and_m_t":"RxTxTimeDiff information element","paragraph_zero_based":26870},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26871},{"literal_text_all_w_t_and_m_t":"-- TAG-RXTXTIMEDIFF-START","paragraph_zero_based":26872},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26873},{"literal_text_all_w_t_and_m_t":"RxTxTimeDiff-r17  ::= SEQUENCE {","paragraph_zero_based":26874},{"literal_text_all_w_t_and_m_t":"    result-k5-r17         INTEGER (0..61565)                 OPTIONAL, -- Need N","paragraph_zero_based":26875},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":26876},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":26877},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26878},{"literal_text_all_w_t_and_m_t":"-- TAG-RXTXTIMEDIFF-STOP","paragraph_zero_based":26879}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["34b4278a8c491bbbe556354566c303d5e5642fb09a5ab3f0cbc449bdcb7edbc5","9be3ca9fc9f9f6060cbfbbe1920ed6df36674eeda93ce5a57ac7af67d9a93f46","85de602553258880b393d48199d36e625862c405d589e03c446f1c1d948a0db9","8d51fb206fbccd61a2fcc31f2baa2bb7d2ddfde63be2af48461605a07761d00d","6bf7ccefd1b45352163b7bbe2afb040d19c43e566141ec8b9e272b534f71e4aa","9bc9e65f60fea80f27a6aaf00bb1ae83dffeb28cc62b1f5b3e9fd6251711d81c","d9a13cf8259e4ecdc45099fe0bea612bbefc964ca5ff58b03cfa774361acaff1","fae955ae61edb13f88aee5b3edd2ac1774bef06334070afbac3c8fa606c7f7cf","e0bca45c20dcf25a7201542168b81e75c2dc9689a5be8903bfc93752e62c6eb3","547f03edcb34723dd115dae71e8dcd981f099f81dd6c4dee037a9e352afb2885","e51ee0a2a6f5e4ffbac194170a5df26fb42779d4d58d129539675cbd43e71c70","37deff205d4ec439264805c9ef0cccd0c598de8b33c44b64d65386f96c882a6d","89c71c694827d774bfefb4fb5c82be1ca9e92fd459aafa591aa795deace0137e","eb33ed6ed251313bc9a71920061076fa2d564fe96e8cc58196003066142d9526","0002a5b1eadc8bb7acb33ae4ed69aaf42406a72df7f4103a11854dbff9dd6915","85f245459d8eb41166cfd61d660e8e77c460d165ab384d9ae64dda26e00718be","d3081aebf54d1b06ccad1dbef38d911036f90c4a38906e0bbdba5bdcb8fd243e","0adb2102c1b5c164b8abd04a399464913f3715001c945ee94dde145adf2