{"fields":{"filename":"R2-2300329.zip::R2-2300329 Adding missing field description for Multi-RTT R17 TS 37355.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the IE NR-DL-PRS-ExpectedAoD-or-AoA in NR-DL-PRS-AssistanceData is requested. Enumerated value 'eAoD' indicates that expected AoD information is requested; value 'eAoA' indicates that expected AoA information is requested.","paragraph_zero_based":144},{"literal_text_all_w_t_and_m_t":"This field may only be present if the 'dl-prs' bit in nr-AdType is set to value '1'.","paragraph_zero_based":145},{"literal_text_all_w_t_and_m_t":"pre-configured-AssistanceDataRequest","paragraph_zero_based":146},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device requests pre-configured assistance data with area validity.","paragraph_zero_based":147},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":148},{"literal_text_all_w_t_and_m_t":"End of changes","paragraph_zero_based":149},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":150}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"409763e6471f2c1f34717cc7bfa872ad4d554d6aec1479aeb3f62bc9b16a6048","original_member_sha256":"ccc1b4b91b71fda123ce12217f3394b0bc7c513f824519ae259f1c64691c3f8b","paragraph_ElementTree_utf8_XML_sha256":["8e6c2a40f8383f8661f41aff76a05a1166c102ba746337e92bbea12d6726986f","38e40aba4b80cf594ce26abb321b665850169c9ddd97964946e8693b87fe9c07","6e13c01906d295cf436f37533d5129031da8902eaf8575266342259da2e0711c","3023c223d33141c99b8387bdebd0cf3b48dd7e7d4e4e51f0cefd94a952d8be55","780d3b5dad0fe5fff258305c4bd0c11b4d2abfec1be8f59ef037cd6e72438178","34730bc977f86da06658752eea38ef744e682408af27d7040684727a3e63d826","9a1f8548b41c5d0335093b189dfb0bbff2aa09f9cb49bee799a2e3ae9ad587fe"],"paragraph_range_z