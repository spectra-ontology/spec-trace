},{"literal_text_all_w_t_and_m_t":"    msgA-PRACH-RootSequenceIndex-r16                     CHOICE {","paragraph_zero_based":24874},{"literal_text_all_w_t_and_m_t":"        l839                                                 INTEGER (0..837),","paragraph_zero_based":24875},{"literal_text_all_w_t_and_m_t":"        l139                                                 INTEGER (0..137),","paragraph_zero_based":24876},{"literal_text_all_w_t_and_m_t":"        l571                                                 INTEGER (0..569),","paragraph_zero_based":24877},{"literal_text_all_w_t_and_m_t":"        l1151                                                INTEGER (0..1149)","paragraph_zero_based":24878},{"literal_text_all_w_t_and_m_t":"    }                                                                                                                   OPTIONAL, -- Cond 2StepOnly","paragraph_zero_based":24879},{"literal_text_all_w_t_and_m_t":"    msgA-TransMax-r16                                    ENUMERATED {n1, n2, n4, n6, n8, n10, n20, n50, n100, n200}     OPTIONAL, -- Need R","paragraph_zero_based":24880},{"literal_text_all_w_t_and_m_t":"    msgA-RSRP-Threshold-r16                              RSRP-Range                                                     OPTIONAL, -- Cond 2Step4Step","paragraph_zero_based":24881},{"literal_text_all_w_t_and_m_t":"    msgA-RSRP-ThresholdSSB-r16                           RSRP-Range                                                     OPTIONAL, -- Need R","paragraph_zero_based":24882},{"literal_text_all_w_t_and_m_t":"    msgA-SubcarrierSpacing-r16                           SubcarrierSpacing                                              OPTIONAL, -- Cond 2StepOnlyL139","paragraph_zero_based":24883},{"literal_text_all_w_t_and_m_t":"    msgA-RestrictedSetConfig-r16                         ENUMERATED {unrestrictedSet, restrictedSetTypeA,","paragraph_zero_based":24884},{"literal_text_all_w_t_and_m_t":"                                            