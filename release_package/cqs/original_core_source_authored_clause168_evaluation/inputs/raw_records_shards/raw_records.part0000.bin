{"fields":{"filename":"R2-2304885.zip::R2-2304885 CR to 38305 Integrity.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"STECSlant TEC","paragraph_zero_based":192},{"literal_text_all_w_t_and_m_t":"SUPLSecure User Plane Location","paragraph_zero_based":193},{"literal_text_all_w_t_and_m_t":"TADVTiming Advance","paragraph_zero_based":194},{"literal_text_all_w_t_and_m_t":"TBSTerrestrial Beacon System","paragraph_zero_based":195},{"literal_text_all_w_t_and_m_t":"TECTotal Electron Content","paragraph_zero_based":196},{"literal_text_all_w_t_and_m_t":"TEGTiming Error Group","paragraph_zero_based":197},{"literal_text_all_w_t_and_m_t":"TPTransmission Point","paragraph_zero_based":198},{"literal_text_all_w_t_and_m_t":"TRPTransmission-Reception Point","paragraph_zero_based":199},{"literal_text_all_w_t_and_m_t":"TTATime To Alert","paragraph_zero_based":200},{"literal_text_all_w_t_and_m_t":"TxTEGTx Timing Error Group","paragraph_zero_based":201},{"literal_text_all_w_t_and_m_t":"UEUser Equipment","paragraph_zero_based":202},{"literal_text_all_w_t_and_m_t":"UL-AoAUplink Angle of Arrival","paragraph_zero_based":203},{"literal_text_all_w_t_and_m_t":"UL-RTOAUplink Relative Time of Arrival","paragraph_zero_based":204},{"literal_text_all_w_t_and_m_t":"UL-SRSUplink Sounding Reference Signal","paragraph_zero_based":205},{"literal_text_all_w_t_and_m_t":"UL-TDOAUplink Time Difference of Arrival","paragraph_zero_based":206},{"literal_text_all_w_t_and_m_t":"URAUser Range Accuracy","paragraph_zero_based":207},{"literal_text_all_w_t_and_m_t":"WAASWide Area Augmentation System","paragraph_zero_based":208},{"literal_text_all_w_t_and_m_t":"WGS-84World Geodetic System 1984","paragraph_zero_based":209},{"literal_text_all_w_t_and_m_t":"WLANWireless Local Area Network","paragraph_zero_based":210},{"literal_text_all_w_t_and_m_t":"Z-AoAZenith Angles of Arrival","paragraph_zero_based":211},{"literal_text_all_w_t_and_m_t":"Next Modified Subclause","paragraph_zero_based":212},{"literal_text_all_w_t_and_m_t":"8.1.1aIntegrity Principle of Operation","paragraph_zero_based":213},{"literal_text_all_w_t_and_m_t":"For integrity operation, the network will ensure that:","paragraph_zero_based":214},{"literal_text_all_w_t_and_m_t":"P(Error > Bound for longer than TTA | NOT DNU) <= Residual Risk + IRallocation               (Equation 8.1.1a-1)","paragraph_zero_based":215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2bd06981bfa1735db77ada95dc726f733939bc78990db1a54790e7b1527f9b39","original_member_sha256":"ea7cb980358ba72e01e1d7f194ddf360632247511118ed9bd841957f774703d8","paragraph_ElementTree_utf8_XML_sha256":["33984678a999219d97c7f3fb5f37ea2ec8141dfdc58a7462824d391dfe484b9e","1d4c444495ca52faf1dd38d71f528358def205eb6f1124fd9fb64ebe4ab2f368","cf3db004c269f754430a84e1cc6680cffab6f11a0be9a6ade65912bfb034c1ad","49535779ed12badafa7f96924d2e72f0246cd42df25a76efcb56f3e49972a3b3","f91051f41f12bca9b8ce7c30f0b05cf22a8b4f88f9322ecc6c98c24ed694299e","9f7d6356948d8abd1257a0e71ac5dc2be379452a470a8ebda8bd99990f4abf63","2c3b1d8ca6bacfe121e3aae2bab1d28d92a3be482f9558bd4cac53272f9062e4","baf58128bfd8f54afcdf0baa7ed86b721e89ef8c44ac6050f2ceebee630175ee","10f9349bca587f6ac094c6fe3b3f746faabdcff31efb924518b983c1b3597e4c","672c96d5b732d1b87e20bac0be0f3300fd22ba67e76946369dd44166fe048b4c","006b51b3ce03439ec12ed5f28608a8b71a94a62fa3796a43cfd6d2b480e06ca5","862bb3872db3067c0c9c30c22b44f4bbc758ee4aaf4cc16b380426770f9a6cdf","2c09d1b1ed0bf4ed1613474c93378caaf66d2a16125c514706ab3570d01c9f8c","fdf5e241ce93c81d2d13261c5b71392406613d536223a89ebcc4c56fce3ea40a","9efc292713ce8ecee61b8e8231372f651be4da62ff5c94a6f2c4cffbd44c339f","c406581dad988cf9b033bd251dbe2726fcad9e1a83381ae6a7cceb294601acdf","81115216b17087d4e9b37c83ec116b7a9a43a37ead9b51a7af8c9c4a69875b47","6f0a5852839366f40e9fea41513cd389b4ab6e250e33e8306cdf3ce0002a91bb","dbb294aab56b747f62dd3342ffa680c54f9d65b615a1f9eef35f90efcd7c023a","010cdab0afc2eabbb905b98b65cab743f34888ce996f3efe61716b6ccd6d8f3e","3b46872ad745c5d392630d91283f928f892e25a60b86a00fa97f4f7d520e85e6","e1b5ce77472b1dbdd3856b729118ffdf0942f071a9d57412d0cca3d476dcb2ab","2ba968f07546fe6ebb9d595ef8ad7ffe1869d22f629c619cc2d87261145c7409","2b2a58d6035cd49169280702a22471b73d5dca1d73ecb91d219a5b9928e27746"],"paragraph_range_zero_based":[192,215],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2304885.zip::R2-2304885 CR to 38305 Integrity.docx:p192"}
{"fields":{"filename":"R2-2304885.zip::R2-2304885 CR to 38305 Integrity.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"for all values of IRallocation in the range irMinimum <= IRallocation <= irMaximum","paragraph_zero_based":216},{"literal_text_all_w_t_and_m_t":"for all the errors in Table 8.1.2.1b-1, which have corresponding integrity assistance data available and where the corresponding DNU flag(s) are set to false.","paragraph_zero_based":217},{"literal_text_all_w_t_and_m_t":"The integrity risk probability is decomposed into a constant Residual Risk component provided in the assistance data as well as a variable IRallocation component that corresponds to the contribution from the Bound according to the Bound formula in Equation 8.1.1a-2. IRallocation may be chosen freely by the client based on the desired Bound, therefore the network should ensure that Equation 8.1.1a-1 holds for all possible choices of IRallocation. The Residual Risk and IRallocation components may be mapped to fault and fault-free cases respectively, but the implementation is free to choose any other decomposition of the integrity risk probability into these two components.","paragraph_zero_based":218},{"literal_text_all_w_t_and_m_t":"The validity time of the integrity bounds is set as equal to twice the SSR Update Interval for the given SSR Assistance Data message, i.e. the time period between the SSR Epoch Time and the SSR Epoch Time plus twice the SSR Update Interval in the GPS time scale.","paragraph_zero_based":219},{"literal_text_all_w_t_and_m_t":"Equation 8.1.1a-1 holds for all assistance data that has been issued that is still within its validity period. If this condition cannot be met then the corresponding DNU flag must be set.","paragraph_zero_based":220},{"literal_text_all_w_t_and_m_t":"Equation 8.1.1a-1 holds at any epochs for which Assistance Data is provided. Providing Assistance Data without the Integrity Service Alert IE or Real Time Integrity IEs is interpreted as a DNU=FALSE condition. For any bound that is still valid (within its validity time), the network ensures that the Integrity Service Alert and/or Real Time Integrity IEs are also included in the provided Assistance Data if needed to satisfy the condition in Equation 8.1.1a-1. It is up to the implementation how to handle epochs for which integrity results are desired but there are no DNU flag(s) available, e.g. the Time To Alert (TTA) may be set such that there is a \"grace period\" to receive the next set of DNU flags.","paragraph_zero_based":221},{"literal_text_all_w_t_and_m_t":"Only those satellites for which the GNSS integrity assistance data are provided are monitored by the network and can be used for integrity related applications.","paragraph_zero_based":222},{"literal_text_all_w_t_and_m_t":"Where:","paragraph_zero_based":223},{"literal_text_all_w_t_and_m_t":"Error: Error is the difference between the true value of a GNSS parameter (e.g. ionosphere, troposphere etc.), and its value as estimated and provided in the corresponding assistance data as per Table 8.1.2.1b-1","paragraph_zero_based":224},{"literal_text_all_w_t_and_m_t":"Bound: Integrity Bounds provide the statistical distribution of the residual errors associated with the GNSS positioning corrections (e.g. RTK, SSR etc). Integrity bounds are used to statistically bound the residual errors after the positioning corrections have been applied. The bound is computed according to the Bound formula defined in Equation 8.1.1a-2. The bound formula describes a bounding model including a mean and standard deviation (e.g. paired over-bounding Gaussian). The bound may be scaled by multiplying the standard deviation by a K factor corresponding to an IRallocation, for any desired IRallocation within the permitted range.","paragraph_zero_based":225},{"literal_text_all_w_t_and_m_t":"Bound for a particular error is computed according to the following formula:","paragraph_zero_based":226},{"literal_text_all_w_t_and_m_t":"Bound = mean + K * stdDev(Equation 8.1.1a-2)","paragraph_zero_based":227},{"literal_text_all_w_t_and_m_t":"K = normInv(IRallocation / 2)","paragraph_zero_based":228},{"literal_text_all_w_t_and_m_t":"irMinimum <= IRallocation <= irMaximum","paragraph_zero_based":229},{"literal_text_all_w_t_and_m_t":"where:mean: mean value for this specific error, as per Table 8.1.2.1b-1","paragraph_zero_based":230},{"literal_text_all_w_t_and_m_t":"stdDev: standard deviation for this specific error, as per Table 8.1.2.1b-1","paragraph_zero_based":231},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":232},{"literal_text_all_w_t_and_m_t":"Time-to-Alert (TTA): The maximum allowable elapsed time from when the Error exceeds the Bound until a DNU flag must be issued.","paragraph_zero_based":233},{"literal_text_all_w_t_and_m_t":"Target Integrity Risk (TIR): The probability per unit of time that the Error exceeds the Bound without issuing a DNU flag within the TTA.","paragraph_zero_based":234},{"literal_text_all_w_t_and_m_t":"DNU: The DNU flag(s) corresponding to a particular error as per Table 8.1.2.1b-1. Where multiple DNU flags are specified, the DNU condition in Equation 8.1.1a-1 is present when any of the flags are true (logical OR of the flags).","paragraph_zero_based":235},{"literal_text_all_w_t_and_m_t":"Residual Risk: The residual risk is the component of the integrity risk provided in the assistance data as per Table 8.1.2.1b-1. This may correspond to the fault case risk but the implementation is permitted to allocate this component in any way that satisfies Equation 8.1.1a-1.","paragraph_zero_based":236},{"literal_text_all_w_t_and_m_t":"The Residual Risk is the Probability of Onset which is defined per unit of time and represents the probability that the feared event begins. Each Residual Risk is accompanied by a Mean Duration which represents the expected mean duration of the corresponding feared event and is used to convert the Probability of Onset to a probability that the feared event is present at any given time, i.e.","paragraph_zero_based":237},{"literal_text_all_w_t_and_m_t":"P(Feared Event is Present) = Mean Duration * Probability of Onset of Feared Event(Equation 8.1.1a-3)","paragraph_zero_based":238},{"literal_text_all_w_t_and_m_t":"irMinimum, irMaximum: Minimum and maximum allowable values of IRallocation that may be chosen by the client. Provided as service parameters from the Network according to Integrity Service Parameters.","paragraph_zero_based":239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2bd06981bfa1735db77ada95dc726f733939bc78990db1a54790e7b1527f9b39","original_member_sha256":"ea7cb980358ba72e01e1d7f194ddf360632247511118ed9bd841957f774703d8","paragraph_ElementTree_utf8_XML_sha256":["ccbed0efea4d7cfc8f275f4a2457792fe9b4f2085d7308ded7d66f01b4195f20","b164ddc030f82ef14c3fb425c94ee7646580c783aa12c6db94e561e55b1fb883","fc1c7b9e94bd77a90c2c4520d2a76dfa8a65d2803a6de7f25e53156fca091bb3","8e0cc79bdb53cf130261dd5a3f6bd099bf25940c1040162ca5917241ea01d08a","1f78d2ec1b7dc4777b8946e735620c3d4cc8c6e2d61b2c70164d2eeb1e4298c7","be8dc6212db8183e7f1292cc1f2d19eab54e579ea6e71d334dd7e8cb4a7ed67a","f5237c6f7231662514c42e1c5777bd37499f3d5e20b6f2c264650c5a8cb028da","a2e6a20e4ee05b4cb4fde621bf63f16f15fff91668cea2fc264e821689165241","89d3aed9ce6d4a5da6deb08d05a8b04992b4e18e5c5afd86fe4a5a7ae4b1c3b7","1173cdd6885ab90482c42f5a563f6e07a6fe730ee86dd1776d48267f7a986c7c","d97fc226c18809287a7527f64d69d6c5a131bc7f75583cd435a1bae6a05a63c2","120c7c3bd664f56991553e7e1f18bb04d50ce580782f94e117a9cd1348c7d0b0","e37b1358d13c18a536a25827883f1fb0ee33fdccc189268a66e1b0f036ac8fdb","526f9a184d0c33ca577adb9b3263562d4de4eeb3f31680b37f46ab3bcdd79328","f0d1a1fdca5045c78e46f2e212ea190ceebe899fb8bb07e6d47936b38113c15b","bc382539dbf7d8571be2f1ab925889943cb22f8b2a1c8cf5495c431cdd6d3