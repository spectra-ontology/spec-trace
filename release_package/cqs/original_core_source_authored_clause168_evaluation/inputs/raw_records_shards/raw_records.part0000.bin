{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18816},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18817},{"literal_text_all_w_t_and_m_t":"–HighSpeedConfig","paragraph_zero_based":18818},{"literal_text_all_w_t_and_m_t":"The IE HighSpeedConfig is used to configure parameters for high speed scenarios.","paragraph_zero_based":18819},{"literal_text_all_w_t_and_m_t":"HighSpeedConfig information element","paragraph_zero_based":18820},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18821},{"literal_text_all_w_t_and_m_t":"-- TAG-HIGHSPEEDCONFIG-START","paragraph_zero_based":18822},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18823},{"literal_text_all_w_t_and_m_t":"HighSpeedConfig-r16 ::=  SEQUENCE {","paragraph_zero_based":18824},{"literal_text_all_w_t_and_m_t":"    highSpeedMeasFlag-r16    ENUMERATED {true}        OPTIONAL,   -- Cond SpCellOnly","paragraph_zero_based":18825},{"literal_text_all_w_t_and_m_t":"    highSpeedDemodFlag-r16   ENUMERATED {true}        OPTIONAL,   -- Need R","paragraph_zero_based":18826},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":18827},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18828},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18829},{"literal_text_all_w_t_and_m_t":"HighSpeedConfig-v1700 ::=  SEQUENCE {","paragraph_zero_based":18830},{"literal_text_all_w_t_and_m_t":"    highSpeedMeasCA-Scell-r17    ENUMERATED {true}        OPTIONAL,   -- Cond SCellOnly","paragraph_zero_based":18831},{"literal_text_all_w_t_and_m_t":"    highSpeedMeasInterFreq-r17   ENUMERATED {true}        OPTIONAL,   -- Cond SpCellOnly2","paragraph_zero_based":18832},{"literal_text_all_w_t_and_m_t":"    highSpeedDemodCA-Scell-r17   ENUMERATED {true}        OPTIONAL,   -- Need R","paragraph_zero_based":18833},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":18834},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18835},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18836},{"literal_text_all_w_t_and_m_t":"HighSpeedConfigFR2-r17 ::=  SEQUENCE {","paragraph_zero_based":18837},{"literal_text_all_w_t_and_m_t":"    highSpeedMeasFlagFR2-r17                    ENUMERATED {set1, set2}                       OPTIONAL,   -- Need R","paragraph_zero_based":18838},{"literal_text_all_w_t_and_m_t":"    highSpeedDeploymentTypeFR2-r17              ENUMERATED {unidirectional, bidirectional}    OPTIONAL,   -- Need R","paragraph_zero_based":18839}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["49795c222d6472d42c3447adce7ca9522bb40df74be592706068ebcf9b73f562","d298ff76e30dfebf499b5dcb0b0e4688dab5abb3bd0357150e15c34d8d1bfa39","eda9ac2cd0d3864889e3b2e7e79e85b2beb66c8b03a54193bad1f00f60fb84de","68196304352b7a0bb66968d4a937d89fa7062399e1a5d12ef7a424e6e2011d01","19c5e243972894c363e3d3bfd13f7335678aa99546dc5f24c189e169ce704d08","4cb25a29d4dc920d851dc6676df90124effa00026bb67860719718bf49c8722f","f1f7bf12e326d8a67e35399a9eabc0be04d0e171c76513ebe1ae6b017f47ad44","dae5890eb70d0166dd6ce4442089c5b3168105709fe43301386cf7ce76c52ff4","a7b2906eb1daaffd0b4c7496f65411a271569dca99d4c9b4fdc0256457093f79","88e6d1ba4cfb0af3509435a6fc6fcd118fa49255dec41da29d3e23641622a0e9","dfd181804aadedefffcf79f53cf56a0449eb534d92e67011a9e2be816d366b9b","f56200a524d88f8cc67960229b628b304d83069e53eeb3cfa7304325fa3ad17b","aab09ec8a638922c089024af3b3aab0dd39f79a507a1956bfb5bcd4d5d41e87e","bbb3d938449ce202c25a65c3028895d1efeb69eec9369c8f1d0a89e824f1829a","18604d1d48418828699b96577f3cbc879b1c4635df0a37ba05d377f38b51e884","be2f1585908fe02a305a27fc902a30425722b1a6e60e7173e64ea3713b6f8ba3","09c87830acccc6c6e07e6279da2190eff861ea50b5a7761fd6e775f38b032612","6452e5bea7070ff49d84c65f02f133e7ae48bed633a08fab4e4a0ebfa28d1c3b","62d2f37287bb22899104ab2c25536584b11af872ee7f55d51b6afbbafed712fa","dae3e88125580694c1997d67c91fcf3f12e5e46e80e17767da9c076f28d0c648","112a159f8125411c07c1fcc15853613557274c65dc371ac61fbc1070eaaa5607","6fd8a658e483df4d39bf0d49d0c9bfb4d89b214b9c76f01d805c1264777fe52f","18404da3fb265a910462c5d4e1444a9e838f0db18b89ee026a0d7bccd5021ac9","7ae15263754b6daea0f5b6fef5cb2ca33922ff0c4da31f5981e232941e01ccfb"],"paragraph_range_zero_based":[18816,18839],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p18816"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    highSpeedLargeOneStepUL-TimingFR2-r17       ENUMERATED {true}                             OPTIONAL,   -- Need R","paragraph_zero_based":18840},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":18841},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18842},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18843},{"literal_text_all_w_t_and_m_t":"-- TAG-HIGHSPEEDCONFIG-STOP","paragraph_zero_based":18844},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18845},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18846},{"literal_text_all_w_t_and_m_t":"HighSpeedConfig field descriptions","paragraph_zero_based":18847},{"literal_text_all_w_t_and_m_t":"HighSpeedDemodCA-Scell","paragraph_zero_based":18848},{"literal_text_all_w_t_and_m_t":"If the field is present and UE supports demodulationEnhancementCA-r17, the UE shall apply the enhanced demodulation processing for HST-SFN joint transmission scheme with velocity up to 500km/h as specified in TS 38.101-4 [59]. This parameter only applies to SCell.","paragraph_zero_based":18849},{"literal_text_all_w_t_and_m_t":"highSpeedDemodFlag","paragraph_zero_based":18850},{"literal_text_all_w_t_and_m_t":"If the field is present and UE supports demodulationEnhancement-r16, the UE shall apply the enhanced demodulation processing for HST-SFN joint transmission scheme with velocity up to 500km/h as specified in TS 38.101-4 [59]. This parameter only applies to SpCell.","paragraph_zero_based":18851},{"literal_text_all_w_t_and_m_t":"highSpeedDeploymentTypeFR2","paragraph_zero_based":18852},{"literal_text_all_w_t_and_m_t":"If the field is present, and field value is unidirectional, the UE shall assume uni-directional deployment or if field value is birectional the UE shall assume bidirectional deployment for FR2 up to 350km/h as specified in TS 38.133 [14].","paragraph_zero_based":18853},{"literal_text_all_w_t_and_m_t":"highSpeedLargeOneSteptUL-TimingFR2","paragraph_zero_based":18854},{"literal_text_all_w_t_and_m_t":"If the field is present, large one step UE autonomous uplink transmit timing adjustment for FR2 up to 350km/h as specified in TS 38.133 [14] is enabled.","paragraph_zero_based":18855},{"literal_text_all_w_t_and_m_t":"highSpeedMeasCA-Scell","paragraph_zero_based":18856},{"literal_text_all_w_t_and_m_t":"If the field is present and UE supports measurementEnhancementCA-r17, the UE shall apply the enhanced RRM requirements to the serving frequency of SCell for carrier aggregation to support high speed up to 500 km/h as specified in TS 38.133 [14].","paragraph_zero_based":18857},{"literal_text_all_w_t_and_m_t":"highSpeedMeasFlag","paragraph_zero_based":18858},{"literal_text_all_w_t_and_m_t":"If the field is present and UE supports measurementEnhancement-r16, the UE shall apply the enhanced intra-NR and inter-RAT EUTRAN RRM requirements to support high speed up to 500 km/h as specified in TS 38.133 [14].","paragraph_zero_based":18859},{"literal_text_all_w_t_and_m_t":"If the field is present and UE supports intraNR-MeasurementEnhancement-r16, the UE shall apply enhanced intra-NR RRM requirement to support high speed up to 500 km/h as specified in TS 38.133 [14].","paragraph_zero_based":18860},{"literal_text_all_w_t_and_m_t":"If the field is present and UE supports interRAT-MeasurementEnhancement-r16, the UE shall apply enhanced inter-RAT EUTRAN RRM requirement to support high speed up to 500 km/h as specified in TS 38.133 [14].","paragraph_zero_based":18861},{"literal_text_all_w_t_and_m_t":"This parameter only applies to the serving frequency of SpCell.","paragraph_zero_based":18862},{"literal_text_all_w_t_and_m_t":"highSpeedMeasFlagFR2","paragraph_zero_based":18863}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["0d549e479d3416c628eaba6947b9efd6cc960a4460157b68c1a9465569bc4b5b","cc6ae1e7e25a0b9af0c1235c4f99baf9372990535cf11b1f095bf226c021bb54","40844f73079254857e03efb7512e4306721932ea76d86bcb89adebb4392d01f2","dabcda479857e4d86f44d9e5d54a5d8660213cafe4fc2bd8aa1fb2fcb1c528f7","8782cb0d4c5f88fa4506f78a609af923d53c435c08312b32be024b40094e7d1a","f64fe369e77fa5d04fb6600f505522de3ff13c788a4b8fdc5e366184cdf50905","cbeac5d7c771a88ca7a0b0dbf91169356a26d800aab29ecbef0d15e51b9e315a","66f66d99bc2dcab72a5d70749ad9d3b83a8361cc541147525ded14c47de0265a","aff5922cb4b64fa06d0ea9ee64425bc2be2da97945df8b5df42a0662cb71a2bc","bc1f7751da3ce3c7ab9a19d2e753662a1f25152175e5ea926f932663837a9ca3","0245cddf834daa89e16accf3575f7a5177b620005fec582cf288188936fb7ab6","7bc5b5419cca8a54d496aa28c5d16b1af47a5332b2230b26df4836ee89410658","9d69eecd0a8e2659cfa89328ed56349f238b017bf269f01790cdb805a053817b","994659b40ad99fdc5872d39ca4c5dd03d8c275abe0bdc75884359cd147d5ceb8","7f5434071c632a41a83bb97859e64b7e568bd30501b5b6ff7bb38c32b6e5e7a9","542b8183e9934a6b749e3bec2a8538939c24dc2de202d90bb0a0e28f6991d221","1c03c73fe780222edb2b200cec4eb39aabeda11ac3c7cc25743cee0a65a4a626","f918974e01597534a1ba4cf1f489021a906add6cbc18f57d4be7910c36d38efe","aea5522f6162989a582258c53d5cd2e1e968089ba3e4b6115b1cc48aa2e75abe","d72da237b28d3d7b110de0236d7216bf92713d54504bba620cc5751ae830590b","a50773a1d2da00bd36adc97a0bf8ba55554c3e1abfb03b97f7036ce265aa68e8","9f5a636be42b54911cd4bcf5e06f533c842cda454e04cda8c8fe3b1e11e6ef83","85cdf8c9149381f39e6d8685499cc92988b7966f57a63107108865be171158e6","41aab9181c9d8caa25bcabcebdacc189bf105f0805ed5f79a128209235ea8faa"],"paragraph_range_zero_based":[18840,18863],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p18840"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"If the field is present, the UE shall apply enhanced intra-NR RRM requirement set one to support high speed up to 350 km/h for FR2 as specified in TS 38.133 [14], if the field value is set1 or RRM requirement set two if the field value is set2.","paragraph_zero_based":18864},{"literal_text_all_w_t_and_m_t":"highSpeedMeasInterFreq","paragraph_zero_based":18865},{"literal_text_all_w_t_and_m_t":"If the field is present and UE supports measurementEnhancementInterFreq-r17, the UE shall apply the enhanced RRM requirements for inter-frequency measurement in RRC_CONNECTED to support high speed up to 500 km/h as specified in TS 38.133 [14].","paragraph_zero_based":18866},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18867},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":18868},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":18869},{"literal_text_all_w_t_and_m_t":"SCellOnly","paragraph_zero_based":18870},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, in ServingCellConfigCommon of an SCell. It is absent otherwise.","paragraph_zero_based":18871},{"literal_text_all_w_t_and_m_t":"SpCellOnly","paragraph_zero_based":18872},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, in ServingCellConfigCommonSIB or in the ServingCellConfigCommon of an SpCell. It is absent otherwise.","paragraph_zero_based":18873},{"literal_text_all_w_t_and_m_t":"SpCellOnly2","paragraph_zero_based":18874},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, in ServingCellConfigCommon of an SpCell. It is absent otherwise.","paragraph_zero_based":18875},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18876},{"literal_text_all_w_t_and_m_t":"–Hysteresis","paragraph_zero_based":18877},{"literal_text_all_w_t_and_m_t":"The IE Hysteresis is a parameter used within the entry and leave condition of an event triggered reporting condition. The actual value is field value * 0.5 dB.","paragraph_zero_based":18878},{"literal_text_all_w_t_and_m_t":"Hysteresis information element","paragraph_zero_based":18879},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18880},{"literal_text_all_w_t_and_m_t":"-- TAG-HYSTERESIS-START","paragraph_zero_based":18881},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18882},{"literal_text_all_w_t_and_m_t":"Hysteresis ::=                      INTEGER (0..30)","paragraph_zero_based":18883},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18884},{"literal_text_all_w_t_and_m_t":"-- TAG-HYSTERESIS-STOP","paragraph_zero_based":18885},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18886},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18887}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["ea672105aba457a7b8b32f66d73f36ef6e06b288317b8a88662fe14cb0e7e085","edd2542a51316e01cb46881c7121e887955df7c498a489bd6e7c5c7d8dc470c7","f2a0900d8a35a86483b06f5bc43ee126632d2533ba5fbd0973419e29ec4a97d1","6ac4205a077cdbef58b1ab5a966c84ce848a5194544851eda4d2414ae996050c","226623c8cc084fdcff0313243560f68e6157b3b88cebca057b25b0b2128eae13","f77767f32ae8b8b2b4f379b957f37d77383c044cd56c946779bacbe96baf7c7f","961e56b7547061afaff6f22f1d2018c73c738770399a07f657758dd809a969a0","64556e7516a3ce2cb447b0bf031669189460940108441749f759eaf6377aedcc","0159e78e4ceb66fbd9056b8936df5cef9476128b181425edc294528bf3416342","c907fc2386a910ebdf70528be89249eaa8f90ba571033b57f9c380dfa7d0bd04",