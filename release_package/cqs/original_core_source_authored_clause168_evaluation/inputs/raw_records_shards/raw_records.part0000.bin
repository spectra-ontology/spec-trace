iteral_text_all_w_t_and_m_t":"}","paragraph_zero_based":2582},{"literal_text_all_w_t_and_m_t":"DRB-ToReleaseList ::=                   SEQUENCE (SIZE (1..maxDRB)) OF DRB-Identity","paragraph_zero_based":2583},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2584},{"literal_text_all_w_t_and_m_t":"SecurityConfig ::=                      SEQUENCE {","paragraph_zero_based":2585},{"literal_text_all_w_t_and_m_t":"    securityAlgorithmConfig                 SecurityAlgorithmConfig                                 OPTIONAL,   -- Cond RBTermChange1","paragraph_zero_based":2586},{"literal_text_all_w_t_and_m_t":"    keyToUse                                ENUMERATED{master, secondary}                           OPTIONAL,   -- Cond RBTermChange","paragraph_zero_based":2587},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":2588},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2589},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2590},{"literal_text_all_w_t_and_m_t":"MRB-ToAddModList-r17 ::=                SEQUENCE (SIZE (1..maxMRB-r17)) OF MRB-ToAddMod-r17","paragraph_zero_based":2591}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"cfd1aef054dea290a9770e5c2de1b12f4cc7358b773882ae43663cec7a0c7249","original_member_sha256":"eb486990e07cad7e16d78b726e76051d7652abe5c7bb2e34c237c431cbcb3180","paragraph_ElementTree_utf8_XML_sha256":["76028f01351744ca870c9de58b3e980643703fa60cec128b6266ee6a9f292060","d6bd3b5e7ff2becf03c1c291af37695055108e07ffa9d4c5cb71130ea6999648","705b2c0bfcdd4b4cefc9560289877f9246768950a1f2743185b3f9a257e0a2f0","9126cae5204d609c269d48ced3720d099a4d27b8547f5de02ba3c0edfff448b1","86ee6935e11e01fb53dd54aada375a67ecbef782f507e03571e319dbdc76edf4","aae51828dfa4b7250a287506b294fa66e805ef33e7bca366b95af5c55b3376ac","40c4c5cc006b0dfbf5697f131463879674917e695fa34e939779655d035b7904","396505494aee1bde5d6b3097ad1508fdf57400bffe