{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>remove the entry with the matching reportConfigId from the reportConfigList within the VarMeasConfig;","paragraph_zero_based":4416},{"literal_text_all_w_t_and_m_t":"2>remove all measId associated with the reportConfigId from the measIdList within the VarMeasConfig, if any;","paragraph_zero_based":4417},{"literal_text_all_w_t_and_m_t":"2>if a measId is removed from the measIdList:","paragraph_zero_based":4418},{"literal_text_all_w_t_and_m_t":"3>remove the measurement reporting entry for this measId from the VarMeasReportList, if included;","paragraph_zero_based":4419},{"literal_text_all_w_t_and_m_t":"3>stop the periodical reporting timer or timer T321 or timer T322, whichever one is running, and reset the associated information (e.g. timeToTrigger) for this measId.","paragraph_zero_based":4420},{"literal_text_all_w_t_and_m_t":"NOTE:The UE does not consider the message as erroneous if the reportConfigToRemoveList includes any reportConfigId value that is not part of the current UE configuration.","paragraph_zero_based":4421},{"literal_text_all_w_t_and_m_t":"5.5.2.7Reporting configuration addition/modification","paragraph_zero_based":4422},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":4423},{"literal_text_all_w_t_and_m_t":"1>for each reportConfigId included in the received reportConfigToAddModList:","paragraph_zero_based":4424},{"literal_text_all_w_t_and_m_t":"2>if an entry with the matching reportConfigId exists in the reportConfigList within the VarMeasConfig, for this entry:","paragraph_zero_based":4425},{"literal_text_all_w_t_and_m_t":"3>reconfigure the entry with the value received for this reportConfig;","paragraph_zero_based":4426},{"literal_text_all_w_t_and_m_t":"3>for each measId associated with this reportConfigId included in the measIdList within the VarMeasConfig, if any:","paragraph_zero_based":4427},{"literal_text_all_w_t_and_m_t":"4>remove the measurement reporting entry for this measId from the VarMeasReportList, if included;","paragraph_zero_based":4428},{"literal_text_all_w_t_and_m_t":"4>stop the periodical reporting timer or timer T321 or timer T322, whichever one is running, and reset the associated information (e.g. timeToTrigger) for this measId;","paragraph_zero_based":4429},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":4430},{"literal_text_all_w_t_and_m_t":"3>add a new entry for the received reportConfig to the reportConfigList within the VarMeasConfig.","paragraph_zero_based":4431},{"literal_text_all_w_t_and_m_t":"5.5.2.8Quantity configuration","paragraph_zero_based":4432},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":4433},{"literal_text_all_w_t_and_m_t":"1>for each RAT for which the received quantityConfig includes parameter(s):","paragraph_zero_based":4434},{"literal_text_all_w_t_and_m_t":"2>set the corresponding parameter(s) in quantityConfig within VarMeasConfig to the value of the received quantityConfig parameter(s);","paragraph_zero_based":4435},{"literal_text_all_w_t_and_m_t":"1>for each measId included in the measIdList within VarMeasConfig:","paragraph_zero_based":4436},{"literal_text_all_w_t_and_m_t":"2>remove the measurement reporting entry for this measId from the VarMeasReportList, if included;","paragraph_zero_based":4437},{"literal_text_all_w_t_and_m_t":"2>stop the periodical reporting timer or timer T321 or timer T322, whichever one is running, and reset the associated information (e.g. timeToTrigger) for this measId.","paragraph_zero_based":4438},{"literal_text_all_w_t_and_m_t":"5.5.2.9Measurement gap configuration","paragraph_zero_based":4439}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba865