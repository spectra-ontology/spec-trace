{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"allowedCellsToAddModList","paragraph_zero_based":20088},{"literal_text_all_w_t_and_m_t":"List of cells to add/modify in the allow-list of cells. It applies only to SSB resources.","paragraph_zero_based":20089},{"literal_text_all_w_t_and_m_t":"allowedCellsToRemoveList","paragraph_zero_based":20090},{"literal_text_all_w_t_and_m_t":"List of cells to remove from the allow-list of cells.","paragraph_zero_based":20091},{"literal_text_all_w_t_and_m_t":"associatedMeasGapSSB","paragraph_zero_based":20092},{"literal_text_all_w_t_and_m_t":"Indicates the associated measurement gap for SSB measuring identified by ssb-ConfigMobility in this measurement object. When multiple MeasObjectNR with the same SSB frequency are configured, the network configures the same measurement gap ID in this field for each MeasObjectNR. If this field is absent, the associated measurement gap is the gap configured via gapFR1, gapFR2, or gapUE.","paragraph_zero_based":20093},{"literal_text_all_w_t_and_m_t":"associatedMeasGapSSB2","paragraph_zero_based":20094},{"literal_text_all_w_t_and_m_t":"Indicates the associated additional measurement gap for SSB measuring identified by ssb-ConfigMobility in this measurement object for NTN deployments. When multiple MeasObjectNR with the same SSB frequency are configured, the network configures the same measurement gap ID in this field for each MeasObjectNR. If this field is absent, the associated measurement gap is the gap indicated by associatedMeasGapSSB.","paragraph_zero_based":20095},{"literal_text_all_w_t_and_m_t":"associatedMeasGapCSIRS","paragraph_zero_based":20096},{"literal_text_all_w_t_and_m_t":"Indicates the associated measurement gap for CSI-RS measuring identified by csi-rs-ResourceConfigMobility in this measurement object. If this field is absent, the associated measurement gap is the gap configured via gapFR1, gapFR2, or gapUE.","paragraph_zero_based":20097},{"literal_text_all_w_t_and_m_t":"associatedMeasGapCSIRS2","paragraph_zero_based":20098},{"literal_text_all_w_t_and_m_t":"Indicates the associated additional measurement gap for CSI-RS measuring identified by csi-rs-ResourceConfigMobility in this measurement object for NTN deployments. If this field is absent, the associated measurement gap is the gap indicated by associatedMeasGapCSIRS. In this release of the specification, this field is not configured for NTN deployments.","paragraph_zero_based":20099},{"literal_text_all_w_t_and_m_t":"cellsToAddModList","paragraph_zero_based":20100},{"literal_text_all_w_t_and_m_t":"List of cells to add/modify in the cell list.","paragraph_zero_based":20101},{"literal_text_all_w_t_and_m_t":"cellsToRemoveList","paragraph_zero_based":20102},{"literal_text_all_w_t_and_m_t":"List of cells to remove from the cell list. ","paragraph_zero_based":20103},{"literal_text_all_w_t_and_m_t":"excludedCellsToAddModList","paragraph_zero_based":20104},{"literal_text_all_w_t_and_m_t":"List of cells to add/modify in the exclude-list of cells. It applies only to SSB resources.","paragraph_zero_based":20105},{"literal_text_all_w_t_and_m_t":"excludedCellsToRemoveList","paragraph_zero_based":20106},{"literal_text_all_w_t_and_m_t":"List of cells to remove from the exclude-list of cells.","paragraph_zero_based":20107},{"literal_text_all_w_t_and_m_t":"freqBandIndicatorNR","paragraph_zero_based":20108},{"literal_text_all_w_t_and_m_t":"The frequency band in which the SSB and/or CSI-RS indicated in this MeasObjectNR are located and according to which the UE shall perform the RRM measurements. This field is always provided when the network configures measurements with this MeasObjectNR.","paragraph_zero_based":20109},{"literal_text_all_w_t_and_m_t":"measCyclePSCell","paragraph_zero_based":20110},{"literal_text_all_w_t_and_m_t":"The parameter is used only when the PSCell is configured on the frequency indicated by the measObjectNR and the SCG is deactivated, see TS 38.133 [14]. The field may also be configured when the PSCell is not configured on that frequency. The network always configures measCyclePSCell for the measObjectNR associated with the PSCell if bfd-and-RLM is set to true and the SCG is deactivated. Value ms160 corresponds to 160 ms, value ms256 corresponds to 256 ms and so on.","paragraph_zero_based":20111}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["b952569455fb46412f34e422b260da9a722ffda04ec8bb8551017d5306ae84ec","cc0b3098e754d0eaf98af076fe7fed5545cff3c7a7f6ae12bf141650e5323d7d","651669ea82fd974cb40e34f16f18363517b5242bbb9c44cc01c9106968bb3f0f","ef0e30043ccab25fd82dce9e258d811061e9f6d9f448aa6c5dd24a0060393784","8b6381b2fbb12e51fb609d97e1da81bf282e1a178314b159aca815c4c7a0f09c","280291c2045c8f71de9bba4de95d049219fb71abddb210671c4a93e0848e1b99","b3e4fd325d994c24e305dd369a2e58ee437dc0ffd9920d775ca6048b797cd88a","68a935757a579173b23ee09b428b6c0c6516e3fedf0e734120ea976f0e5d2e13","ef9ea4b1eed9c45131d79389cdf6d501d593f2aeefa5117cf23f1ca29251b8db","bdc840cf25b3cfa4785306be83c2ea13938d5ffdcf73fb667aef280b3b00cb8a","c2dd4d0be25391a7090234ee0171bb9fecc038445b01abe12ac9248da847bb89","a5c52bc7e66159fa5633663153672033e9c41ce25c35354d3a0ed51702f1aa56","abe5a6af0c441d6700565d1cb14092d85752089568629c514c321fa4b82dbc63","307d790403d5666b4bb4eb3ea8a30cab546cf75acf88748130c6e837f7508524","8689c2edd1998c3aae02169a8bbf33785572e5d7c93c30613e5976a5986abd82","1dfdb47ba064b8035c80da5c4bf8ef522d937c7ed76f8d2b8446fc82fb0cff1a","27e86704143429cf368f1ea705d70f288a064391eb04a8b67fc5121e2bccf364","d86f55c65042128172c63d4327df28ae395a072f20b2d7ed4d40cef6ab7f02c1","dc66d6c48737c4bb9c64c8e0763abab5edb76dacd8afe18761f18cee5e87649b","e70dcf2afc7942f2d25090bb46d88c81e3d22405e00a34e862e56fd93489bc42","b50b84b55c8a2d22b0ec75c04d5bf8bbf2713719a1d59e219026855c602367d6","05903265248cdad4c40811a7252394894b275ea9b8c229992e87814bbed1eb27","bc852bf728e28efb7dcbdc7c6397fd029187efabba0da26efc13e15600942331","0e4dc814818c895f681639f39592be50436324062ed517c3daa44227b18a6ee0"],"paragraph_range_zero_based":[20088,20111],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p20088"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"measCycleSCell","paragraph_zero_based":20112},{"literal_text_all_w_t_and_m_t":"The parameter is used only when an SCell is configured on the frequency indicated by the measObjectNR and is in deactivated state, see TS 38.133 [14]. gNB configures the parameter whenever an SCell is configured on the frequency indicated by the measObjectNR, but the field may also be signalled when an SCell is not configured. Value sf160 corresponds to 160 sub-frames, value sf256 corresponds to 256 sub-frames and so on.","paragraph_zero_based":20113},{"literal_text_all_w_t_and_m_t":"nrofCSInrofCSI-RS-ResourcesToAverage","paragraph_zero_based":20114},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of measurement results per beam based on CSI-RS resources to be averaged. The same value applies for each detected cell associated with this MeasObjectNR.","paragraph_zero_based":20115},{"literal_text_all_w_t_and_m_t":"nrofSS-BlocksToAverage","paragraph_zero_based":20116},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of measurement results per beam based on SS/PBCH blocks to be averaged. The same value applies for each detected cell associated with this MeasObject.","paragraph_zero_based":20117},{"literal_text_all_w_t_and_m_t":"ntn-PolarizationDL","paragraph_zero_based":20118},{"literal_text_all_w_t_and_m_t":"If present, this parameter indicates polarization information for downlink transmission on service link: including Right hand, Left hand circular polarizations (RHCP, LHCP) and Linear polarization.","paragraph_zero_based":20119},{"literal_text_all_w_t_and_m_t":"ntn-PolarizationUL","paragraph_zero_based":20120},{"literal_text_all_w_t_and_m_t":"If present, this parameter indicates polarization information for uplink transmission on service link. If not present and ntn-PolarizationDL is present, UE assumes the same polarization for UL and DL.","paragraph_zero_based":20121},{"literal_text_all_w_t_and_m_t":"offsetMO","paragraph_zero_based":20122},{"literal_text_all_w_t_and_m_t":"Offset values applicable to all measured cells with reference signal(s) indicated in this MeasObjectNR.","paragraph_zero_based":20123},{"literal_text_all_w_t_and_m_t":"quantityConfigIndex","paragraph_zero_based":20124},{"literal_text_all_w_t_and_m_t":"Indicates the n-th element of quantityConfigNR-List provided in MeasConfig.","paragraph_zero_based":20125},{"literal_text_all_w_t_and_m_t":"referenceSignalConfig","paragraph_zero_based":20126},{"literal_text_all_w_t_and_m_t":"RS configuration for SS/PBCH block and CSI-RS.","paragraph_zero_based":20127},{"literal_text_all_w_t_and_m_t":"refFreqCSI-RS","paragraph_zero_based":20128},{"literal_text_all_w_t_and_m_t":"Point A which is used for mapping of CSI-RS to physical resources according to TS 38.211 [16] clause 7.4.1.5.3.","paragraph_zero_based":20129},{"literal_text_all_w_t_and_m_t":"smtc1","paragraph_zero_based":20130},{"literal_text_all_w_t_and_m_t":"Primary measurement timing configuration. (see clause 5.5.2.10).","paragraph_zero_based":20131},{"literal_text_all_w_t_and_m_t":"smtc2","paragraph_zero_based":20132},{"literal_text_all_w_t_and_m_t":"Secondary measurement timing configuration for SS corresponding to this MeasObjectNR with PCI listed in pci-List. For these SS, the periodicity is indicated by periodicity in smtc2 and the timing offset is equal to the offset indicated in periodicityAndOffset modulo periodicity. periodicity in smtc2 can only be set to a value strictly shorter than the periodicity indicated by periodicityAndOffset in smtc1 (e.g. if periodicityAndOffset indicates sf10, periodicity can only be set of sf5, if periodicityAndOffset indicates sf5, smtc2 cannot be configured).","paragraph_zero_based":20133},{"literal_text_all_w_t_and_m_t":"smtc3list","paragraph_zero_based":20134},{"literal_text_all_w_t_and_m_t":"Measurement timing configuration list for SS corresponding to IAB-MT. This is used for the IAB-node's discovery of other IAB-nodes and the IAB-Donor-DUs.","paragraph_zero_based":20135}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["4471797d8332f9cab57032586d147b2e842eecddd078691c369c2e8f248952ba","5962113c5dfb95b51246a4216bf43a6b62c0ddce5d86bc66d7af04bb7c33f4d5","ee1992fd7ed96d9463b0a5e2a2cdae385fec88fc5a0b6e7bcf85a7006e7ecd53","0845d98c4f227d4cb27a514ca599143c3983fbb869524b8278510c8a058a8780","32b62820ea0f86ec48b93064da6821a26aba01b3d792a97865919f4b72318832","5e3e4cdbb3004b0173f15a7f0681953fc04f6eed69ed72969940417d21b08069","92f258d43fb2a1637442aefff8c6a85ce94ba51dc74f549315d33ac40a80cc09","61e52a81a2898e489c6e8069cea579ed32c26b90af8cd85c6d36831161582425","3fc9a7a0eaeb842e34f8ea80ac5f355d7eff07d8e571d4c5c95b51ea3b1239d0","9b8399198fd4f0d2eadb808ca98e74b36116c69ec6ed25bcce668c697265014f","6d09938719e935a2943d30fc5e7448e29cb774e9de6bb6530baad35b9d7ada4f","afcbecd97daca930c01c5042e0135e1f2c46f212e31a9480163a1690f898a436","35e516a656bd9743dedd3628e972bed095dd007a282dc28167168de1e97b25bd","ccc7f265bc017a424d65c0c9ba4e2bd6c9962efddf17909755371fe4f1e53097","88435134dfe914becd7fe01b640c6741267115453c2681400d2196e07fbc4b2e","950ab793e821db02a1800b8b86b548220e3ce297b8cd6fce6c61a4259a4b050c","7f82d732ed1c5cd54d8a4f8422fcebdb71908397d991e9e6027102a823268d72","4735dcbf6ba95a68eba48c1185a42b627fc2948e1ccaa70ac45cdf29d4867952","10af295325518cece66cf2f4f41826e503a11ea0f6b8c947240ee0766cea48bc","32d474d32dafd8a7946fc0985a0c75eb142b06375271d3555d9d8dccae216434","5732745ce2c7578bf398dd8e6e110ab265edc3f73a850e00fb1e59cd6ed4eda9","c0da9b5dc8cf5e2a7e7b643aec84465d7df38f62d95df84e8fccb5441dfb2304","2ae214e3e98b5e85b01c2e6d68500c1aeddead77b5fe90e31d98b86edb7dba95","9a0e309e94b284d4022669f848daca74c52572dd1087c374eedb818db3c72157"],"paragraph_range_zero_based":[20112,20135],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p20112"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"smtc4list","paragraph_zero_based":20136},{"literal_text_all_w_t_and_m_t":"Measurement timing configuration list for NTN deployments, see clause 5.5.2.10.","paragraph_zero_based":20137},{"literal_text_all_w_t_and_m_t":"ssbFrequencyIndicates the frequency of the SS associated to this MeasObjectNR. For operation with shared spectrum channel access, this field is a k*30 kHz shift from the sync raster where k = 0,1,2, and so on if the reportType within the corresponding ReportConfigNR is set to reportCGI (see TS 38.211 [16], clause 7.4.3.1). Frequencies are considered to be on the sync raster if they are also identifiable with a GSCN value (see TS 38.101-1 [15], or TS 38.101-5 [75]).","paragraph_zero_based":20138},{"literal_text_all_w_t_and_m_t":"ssb-PositionQCL-Common","paragraph_zero_based":20139},{"literal_text_all_w_t_and_m_t":"Indicates the QCL relationship between SS/PBCH blocks for all measured cells as specified in TS 38.213 [13], clause 4.1.","paragraph_zero_based":20140},{"literal_text_all_w_t_and_m_t":"ssbSubcarrierSpacing","paragraph_zero_based":20141},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing of SSB.","paragraph_zero_based":20142},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":20143},{"literal_text_all_w_t_and_m_t":"FR1:    15 or 30 kHz","paragraph_zero_based":20144},{"literal_text_all_w_t_and_m_t":"FR2-1:  120 or 240 kHz","paragraph_zero_based":20145},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":20146},{"literal_text_all_w_t_and_m_t":"t312","paragraph_zero_based":20147},{"literal_text_all_w_t_and_m_t":"The value of timer T312. Value ms0 represents 0 ms, ms50 represents 50 ms and so on.","paragraph_zero_based":20148},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20149},{"literal_text_all_w_t_and_m_t":"ReferenceSignalConfig field descriptions","paragraph_zero_based":20150},{"literal_text_all_w_t_and_m_t":"csi-rs-ResourceConfigMobility","paragraph_zero_based":20151},{"literal_text_all_w_t_and_m_t":"CSI-RS resources to be used for CSI-RS based RRM measurements.","paragraph_zero_based":20152},{"literal_text_all_w_t_and_m_t":"ssb-ConfigMobility","paragraph_zero_based":20153},{"literal_text_all_w_t_and_m_t":"SSB configuration for mobility (nominal SSBs, timing configuration).","paragraph_zero_based":20154},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20155},{"literal_text_all_w_t_and_m_t":"RMTC-Config field descriptions","paragraph_zero_based":20156},{"literal_text_all_w_t_and_m_t":"measDurationSymbols","paragraph_zero_based":20157},{"literal_text_all_w_t_and_m_t":"Number of consecutive symbols for which the Physical Layer reports samples of RSSI (see TS 38.215 [9], clause 5.1.21). Value sym1 corresponds to one symbol, sym14or12 corresponds to 14 symbols of the reference numerology for NCP and 12 symbols for ECP, and so on.","paragraph_zero_based":20158},{"literal_text_all_w_t_and_m_t":"If measDurationSymbols-v1700 is signalled, the UE ignores measDurationSymbols-r16.","paragraph_zero_based":20159}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["991e0ad98222d17977c423387e39c378dfb240f50e545ff6f74db8b527f73b90","dcd1ff5f911dd8924f0d80036bdd3fe2979a0c398af2b120956a94f9442a66ef","100a834f313bb342483d3d68f97e3a750e3593b5acad1f4749dce11c358bb244","68dcd25d64414f477d92e281a2dee91f2f47d1d36c0de8112514ba4d28fd6f0d","0319952e3aff809d3233c37d825836ed696b4f0d05790a33bc4844a1b5a0c159","ae124169e748c6726c2c9b90751844ede61abe3589e9338f10808e74c60d1070","88d9abaa077d37ccff085e57bfacfa9197f4294a450f00dabf94415506f6eb57","31450d995eda8d7302ccb65803f5190eb210836ab580f6897541a13fc1df84fa","40792040567dfd48c86383bddafdcbacbb22b097fcecee19cf970d6851c212f5","a43a70b9a7edb99a8533c50962f05dacb614d98670981f792d8592061df423d2","5accd8b112dfa4839b08f1ce6187c2150cc45ca73162d83ce058409862fb94ac","1a309805c1eab6fb1894d9abb35b40cecf3741aa791f96c84d1197e6d6c2acbd","6587b74fe9a372ba37f30c28f4a7e4a88d0ce724a113b159a444d615298f7571","433d7568b94e4510e4cf6ba714822fa535ae6807eb9a9cf0834ca57b50f53330","773e78c929a66ab8a5340da80ee393df30463baddf81cd25a4ecef60b72ef038","569b0bd1a6f921df8742fc96dcdbc9c83261388bd61eddd7efe6c7c1510d1bf2","40e08e78078f382459a214ee8e8780832105680cdf2267862b727920c4e6d034","534cedb2f4383c3939f3223d1e88ed0828a2add18598861d40cec79cb4e9d01a","e591a0a2dc84e5b5dbffb3991a64fc58d0b011e49f4db04ad4c88b66632d7e18","c9889af1f51235ee601fa8365943a28a515d16a2e35c4acb3d28a8420774f034","dea87d299c6fe5367f06c6cbb121f98588a26276fb952e952c1d3fccb3fcfd12","97bbbecced273bbae1f7a756a6557b9f1ba9430264caa2bdcd3eaa0a0cbef981","12b1523e1cfe8966f22d8acc372276c977dca74e2e4b176d2dd25c7458e320f9","4b3ae964b8912af64919d3356482098ef74b0d3c3495fb7906449417b3ed08b0"],"paragraph_range_zero_based":[20136,20159],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p20136"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ref-BWPId","paragraph_zero_based":20160},{"literal_text_all_w_t_and_m_t":"Indicates the reference BWP for the TCI state indicated in tci-StateInfo. Network includes this field if tci-StateInfo is present. This field is only applicable for operation with shared spectrum channel access in FR2-2 and network does not configure this if the UE does not have any serving cells in FR2-2.","paragraph_zero_based":20161},{"literal_text_all_w_t_and_m_t":"ref-SCS-CP","paragraph_zero_based":20162},{"literal_text_all_w_t_and_m_t":"Indicates a reference subcarrier spacing and cyclic prefix to be used for RSSI measurements (see TS 38.215 [9]). Value kHz15 corresponds to 15kHz, kHz30 corresponds to 30 kHz, value kHz60-NCP corresponds to 60 kHz using normal cyclic prefix (NCP), and kHz60-ECP corresponds to 60 kHz using extended cyclic prefix (ECP).","paragraph_zero_based":20163},{"literal_text_all_w_t_and_m_t":"If ref-SCS-CP-v1700 is signalled, the UE ignores ref-SCS-CP-r16.","paragraph_zero_based":20164},{"literal_text_all_w_t_and_m_t":"ref-ServCellId","paragraph_zero_based":20165},{"literal_text_all_w_t_and_m_t":"Indicates the FR2-2 reference serving cell index for the TCI state. Network includes this field if tci-StateInfo is present. This field is only applicable for operation with shared spectrum channel access in FR2-2 and network does not configure this if the UE does not have any serving cells in FR2-2.","paragraph_zero_based":20166},{"literal_text_all_w_t_and_m_t":"rmtc-Bandwidth","paragraph_zero_based":20167},{"literal_text_all_w_t_and_m_t":"Indicates the bandwidth for the RSSI measurement (see TS 38. 215 [9], clause 5.1.21).","paragraph_zero_based":20168},{"literal_text_all_w_t_and_m_t":"rmtc-Frequency","paragraph_zero_based":20169},{"literal_text_all_w_t_and_m_t":"Indicates the center frequency of the measured bandwidth for a frequency which operates with shared spectrum channel access (see TS 38. 215 [9], clause 5.1.21).","paragraph_zero_based":20170},{"literal_text_all_w_t_and_m_t":"rmtc-Periodicity","paragraph_zero_based":20171},{"literal_text_all_w_t_and_m_t":"Indicates the RSSI measurement timing configuration (RMTC) periodicity (see TS 38.215 [9], clause 5.1.21).","paragraph_zero_based":20172},{"literal_text_all_w_t_and_m_t":"rmtc-SubframeOffset","paragraph_zero_based":20173},{"literal_text_all_w_t_and_m_t":"Indicates the RSSI measurement timing configuration (RMTC) subframe offset for this frequency (see TS 38.215 [9], clause 5.1.21). For inter-frequency measurements, this field is optional present and if it is not configured, the UE chooses a random value as rmtc-SubframeOffset for measDurationSymbols which shall be selected to be between 0 and the configured rmtc-Periodicity with equal probability.","paragraph_zero_based":20174},{"literal_text_all_w_t_and_m_t":"tci-StateId","paragraph_zero_based":20175},{"literal_text_all_w_t_and_m_t":"Indicates the TCI state to be used for RSSI measurements. This field is only applicable for shared spectrum channel access in FR2-2. Network does not configure this if the UE does not have any serving cells in FR2-2 and in such a case, it is up to UE implementation how to determine the spatial domain filter for the inter-frequency RSSI measurement in FR2-2.","paragraph_zero_based":20176},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20177},{"literal_text_all_w_t_and_m_t":"SSB-ConfigMobility field descriptions","paragraph_zero_based":20178},{"literal_text_all_w_t_and_m_t":"cca-CellsToAddModList, cca-CellsToRemoveList","paragraph_zero_based":20179},{"literal_text_all_w_t_and_m_t":"Lists of cells to be added or removed from the list of neighbor cells that apply channel access mode procedures for operation with shared spectrum channel access in accordance with TS 37.213 [48], clause 4.4 for FR2-2.","paragraph_zero_based":20180},{"literal_text_all_w_t_and_m_t":"deriveSSB-IndexFromCell","paragraph_zero_based":20181},{"literal_text_all_w_t_and_m_t":"If this field is set to true, UE assumes SFN and frame boundary alignment across cells on the same frequency carrier as specified in TS 38.133 [14]. Hence, if the UE is configured with a serving cell for which (absoluteFrequencySSB, subcarrierSpacing) in ServingCellConfigCommon is equal to (ssbFrequency, ssbSubcarrierSpacing) in this MeasObjectNR, this field indicates whether the UE can utilize the timing of this serving cell to derive the index of SS block transmitted by neighbour cell. Otherwise, this field indicates whether the UE may use the timing of any detected cell on that target frequency to derive the SSB index of all neighbour cells on that frequency.","paragraph_zero_based":20182},{"literal_text_all_w_t_and_m_t":"deriveSSB-IndexFromCellInter","paragraph_zero_based":20183}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["337ffa7dd741e81e834572473438d5e03b2412f80e73b50ee6021a16da6112cf","f279f86fde19dfc7a6587cff869f42e1a361b217f8990503b5789d9c362df4cf","3808d0f071eef3d352b8d763b2f5d6031acd6349513666f67459b4ab62ec7ee9","a8ea4666beff863b2fb2c2adec5c4cb82599ac1e39978d4c4717d93d1a58cf9f","cdf763b648350c17a5286b218df43dbafd6856bb3e531e8cfb4fcb416e24c38c","5bac859ebc69fecb12192b8006b63e2bf3201390ef800ee2543c42e4d17b670b","cd0d055687034966924c7baed9a96cc8b995ae967328dd97cf7e4ec6368aaa36","12f8971b0b22bd02da3491fa6baa79df8404d6fe6b1bfd386953bd37f64ebd4f","116edb6a45f22c577f4a2cc42cc5ee54646b498cad18ce47d5cdd892c384f71f","92f3a783471261806e0155ebc85928f5e945ac1fc6b87bee0bca5d1898f4a983","af42b179ad50e2328368fa7ac373a9b678f5a8605d2a6009c8c4095dba3557bc","5488d792aa671819da296ad90e341d4ae536e892ab2df36e433134201f0642a6","e64216e693aad59d466c303463e91fb969033e013328b2d7a12371822b67e69f","13e7ec08a8c5928016c2ef7e9ca3e07a8e8aa8b03bd743d82678f7e0fe7ca185","edd002a50d35fa6fc1ab6680107d5ddce12f45c4eee95943fa6fa499b1283f30","f692c0985e7ad4b2f2765fdf3fe67046c23d5dd6a0f444bb7adb1190394f8a98","633362598a8c56794e45e571bacdd552d7adeed071eba776c70cc7bc11fc8c80","5066c5e26ed030f3e0d9e43ccbfd84c702ab966543b23904652c4e20562d2d13","17773fa97a7e559d7731bc6bb659146661739982fb6cef7dd60fb446df5cee5c","02287cfd2da6bd184370586ce55966692751e9ea249b215167623ae7f1010702","751a867910f1ec78381159e5121824df6bedc539bd692de933079e04f117a5bf","f4829daf575ae98440509047d9207e025cc6cd9314487a6691bbdbbe852a9ccf","111284a80120dee437b3261adfd69bf34e117a0b6a77704ef4992d1404a6bc76","e3f50dad30622d1a96dc19a7da37a68e7b1478ef7c4a0f3c5738fe24d0e25d6f"],"paragraph_range_zero_based":[20160,20183],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p20160"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"If this field is present, UE assumes SFN and frame boundary alignment between the reference serving cell indicated by ServCellIndex and all neighbour cells in this MeasObjectNR as specified in TS 38.133 [14]. This field also indicates that the UE can utilize the timing of the reference serving cell indicated by ServCellIndex to derive the index of SS block transmitted by all inter-frequency neighbour cells on the frequency indicated by the MeasObjectNR. When this field is included, the network should set deriveSSB-IndexFromCell to true.","paragraph_zero_based":20184},{"literal_text_all_w_t_and_m_t":"ssb-ToMeasure","paragraph_zero_based":20185},{"literal_text_all_w_t_and_m_t":"The set of SS blocks to be measured within the SMTC measurement duration. The first/leftmost bit corresponds to SS/PBCH block index 0, the second bit corresponds to SS/PBCH block index 1, and so on. Value 0 in the bitmap indicates that the corresponding SS/PBCH block is not to be measured while value 1 indicates that the corresponding SS/PBCH block is to be measured (see TS 38.215 [9]). When the field is not configured the UE measures on all SS blocks. Regardless of the value of this field, SS/PBCH blocks outside of the applicable smtc are not to be measured. See TS 38.215 [9] clause 5.1.1.","paragraph_zero_based":20186},{"literal_text_all_w_t_and_m_t":"ssb-ToMeasureAltitudeBasedList","paragraph_zero_based":20187},{"literal_text_all_w_t_and_m_t":"List of altitude-dependent ssb-ToMeasure. The UE applies ssb-ToMeasure-r18 when the UE is within the corresponding altitude range indicated by altitudeRange and ignores ssb-ToMeasure (without suffix). For each altitude range, altitudeMin indicates the minimum altitude in meters, altitudeMax indicates the maximum altitude in meters relative to sea level, and if included, altitudeHyst indicates hysteresis in meters for determination of the altitude range. I.e., when altitudeHyst is configured for an altitude range, the UE considers itself to have entered the range if (altitudeMin + altitudeHyst) ≤ UE altitude ≤ (altitudeMax - altitudeHyst) and after entering the range considers itself to be in the range while (altitudeMin – altitudeHyst) ≤ UE altitude ≤ (altitudeMax + altitudeHyst). ","paragraph_zero_based":20188},{"literal_text_all_w_t_and_m_t":"If altitudeMin is absent, value minAltitude-r18 is used. If altitudeMax is absent, value maxAltitude-r18 is used. When the UE is in an altitude range for which a corresponding ssb-ToMeasure-r18 is not congfigured, ssb-ToMeasure (without suffix) applies.","paragraph_zero_based":20189},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20190},{"literal_text_all_w_t_and_m_t":"SSB-PositionQCL-CellsToAddMod field descriptions","paragraph_zero_based":20191},{"literal_text_all_w_t_and_m_t":"physCellId","paragraph_zero_based":20192},{"literal_text_all_w_t_and_m_t":"Physical cell identity of a cell in the cell list.","paragraph_zero_based":20193},{"literal_text_all_w_t_and_m_t":"ssb-PositionQCL","paragraph_zero_based":20194},{"literal_text_all_w_t_and_m_t":"Indicates the QCL relation between SS/PBCH blocks for a specific cell as specified in TS 38.213 [13], clause 4.1. If provided, the cell specific value overwrites the value signalled by ssb-PositionQCL-Common.","paragraph_zero_based":20195},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20196},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":20197},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":20198},{"literal_text_all_w_t_and_m_t":"AssociatedGapCSIRS","paragraph_zero_based":20199},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R if associatedMeasGapCSIRS is configured, otherwise, it is absent.","paragraph_zero_based":20200},{"literal_text_all_w_t_and_m_t":"AssociatedGapSSB","paragraph_zero_based":20201},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R if associatedMeasGapSSB is configured, otherwise, it is absent.","paragraph_zero_based":20202},{"literal_text_all_w_t_and_m_t":"CSI-RS","paragraph_zero_based":20203},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if csi-rs-ResourceConfigMobility is configured, otherwise, it is absent.","paragraph_zero_based":20204},{"literal_text_all_w_t_and_m_t":"IntraFreqConnected","paragraph_zero_based":20205},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R if the UE is configured with a serving cell for which (absoluteFrequencySSB, subcarrierSpacing) in ServingCellConfigCommon is equal to (ssbFrequency, ssbSubcarrierSpacing) in this MeasObjectNR, otherwise, it is absent.","paragraph_zero_based":20206},{"literal_text_all_w_t_and_m_t":"SCG","paragraph_zero_based":20207}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["d47dfe72e90aadf2216fc060124a7da7d10d137b8286febff824e60a44403b6a","47f74c9736a227253b8bd31700ec04572e706815e788507198f4ed3438861002","888cd0733d47bff90265cc90cb265e8392b7bab3c9bce4f8d16d53c8a70abe44","e289d3728b454b938bc6a9e09e395990824d9c5975d856e2c20456943ee878ea","432d4ae6297b143a280ecb9ddf428a137e52e2cb87e2757f705c6df5ca9e5f24","d74c3b816f820375347f9a496e9a3a23aa7b4b10a21560b366984d3ec7b9fdd2","a65f7012d2dc6c845c55238df0c48c3465a857654117308e9fdb13133e39f27d","26af3fc11eff9e0a10c3baba41411c3d56642de2f9520ab4d321b4f67d1cd4fe","5cf66d7f46faf5b96ea79e8ab4fa7e9084f586f81bca7363e6602c9b5f3f89db","ed61d568f40a0869f6302964cc26f72645e2eb30dd22115ad3e08f7a9163e8d7","44b77ff7b90aaa7d9636f32fa1759b26aa6a925295e974efb650b25a6e588ae1","c16ccfc20726c0ac5fe8c1dbd2aad2090cdebb376157f4ff16840f879537a4d8","80a3542edba16a711fef36b25f574332659988f20bf1d1ef6360111d00c7385a","32ae6a1ab1e23a9751d106a6ce2aafd13801379c2666f6ada89fdd7da5aafbff","9ac547045eb5b601de5a45af7aa9939fa7a3ed4b00c11cd94d6a85ac7d9806e0","cc10c9aab4589e9bdd895c0a3af17a538c446ec88585a8d2b76de4ee388a2cd6","6c914a1df311fc533a64f0d074465aa4145490d91734c7b07ebafb71bb0614ee","77a6a5a03d3fc375243528d7dd8aa53396b5fb612e4265cb403dde00dba14621","4bf9775f9c838b6fa264ca0200e76aa18e8c30dc2aada02e0ac081b69e43e733","31ab8a576808d9010ad6fe75739aade3a44f4da85d2ca7634ecbb504150199aa","0ab3cd368cfafbc8113a0a070f9783181618d7e42a5f3ea9de71ca65da5dc6f9","d8e37f8aa1f81c0f57e932709de24f654703bbb3aef0b99c32fed788422c6dd3","b1fbdb3dd8b9f2067011fbcd06ec804e01e3cf8df20d2b94be817065884de2e6","8894f402d8a81fe489ef622c7cf3ee3fe4f0a9d940909577675f943f3dabfef5"],"paragraph_range_zero_based":[20184,20207],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p20184"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is optionallly present, Need R, in the measConfig associated with the SCG. It is absent in the measConfig associated with the MCG.","paragraph_zero_based":20208},{"literal_text_all_w_t_and_m_t":"SharedSpectrum","paragraph_zero_based":20209},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if this MeasObject is for a frequency which operates with shared spectrum channel access in FR1. Otherwise, it is absent, Need R.","paragraph_zero_based":20210},{"literal_text_all_w_t_and_m_t":"SharedSpectrum2","paragraph_zero_based":20211},{"literal_text_all_w_t_and_m_t":"This field is optionally present if this MeasObject is for a frequency which operates with shared spectrum channel access in FR2-2, Need R. Otherwise, it is absent, Need R.","paragraph_zero_based":20212},{"literal_text_all_w_t_and_m_t":"SSBorAssociatedSSB","paragraph_zero_based":20213},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if ssb-ConfigMobility is configured or associatedSSB is configured in at least one cell. Otherwise, it is absent, Need R.","paragraph_zero_based":20214},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20215},{"literal_text_all_w_t_and_m_t":"–MeasObjectNR-SL","paragraph_zero_based":20216},{"literal_text_all_w_t_and_m_t":"The IE MeasObjectNR-SL concerns a measurement object including a list of transmission resource pool(s) for which CBR measurement is performed for NR sidelink communication/discovery.","paragraph_zero_based":20217},{"literal_text_all_w_t_and_m_t":"MeasObjectNR-SL information element","paragraph_zero_based":20218},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":20219},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASOBJECTNR-SL-START","paragraph_zero_based":20220},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20221},{"literal_text_all_w_t_and_m_t":"MeasObjectNR-SL-r16 ::=      SEQUENCE {","paragraph_zero_based":20222},{"literal_text_all_w_t_and_m_t":"    tx-PoolMeasToRemoveList-r16  Tx-PoolMeasList-r16                           OPTIONAL,       -- Need N","paragraph_zero_based":20223},{"literal_text_all_w_t_and_m_t":"    tx-PoolMeasToAddModList-r16  Tx-PoolMeasList-r16                           OPTIONAL        -- Need N","paragraph_zero_based":20224},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":20225},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20226},{"literal_text_all_w_t_and_m_t":"Tx-PoolMeasList-r16 ::= SEQUENCE (SIZE (1..maxNrofSL-PoolToMeasureNR-r16)) OF SL-ResourcePoolID-r16","paragraph_zero_based":20227},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20228},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASOBJECTNR-SL-STOP","paragraph_zero_based":20229},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":20230},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20231}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["ca6b84b79601adedceb95f1f2f1a812dd72bab2a226da1b7f62b9576459df176","7ae1a8cb2c8ff6555ae1c5aec8932301711f8b8125e145dadfc5fba9571996e4","e9ae08009f47202377b762902808750e9b1c09f36512d482bbc1a86668ab392f","77d4350aca84575fb7f61053b8078817489ee03e2e5d17156cb997e696084ac5","2d7b7928798fb08ee4daedbbd08d71ede786a6bd8469125cf7c17ba5d95269fa","4dcaa63cce28ff6911726fd4620f2a754ede0f92e324dd6b08f68875319ff131","3c59b9b0b8445b66bba8c9309052f030cbf2d1519a3ce931bc1b3fce8107ec1b","fb5394834e5f700f17ac762f61e6b8e6b0d1d6135fa03882612702efa4bf9e77","384c5873b0b649a4f8bd10d5c11968c3fbfd32925