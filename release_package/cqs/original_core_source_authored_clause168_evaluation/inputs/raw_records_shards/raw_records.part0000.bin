ines the RLC mode (UM, AM) and provides corresponding parameters.","paragraph_zero_based":14897},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14898},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":14899},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":14900},{"literal_text_all_w_t_and_m_t":"LCH-Setup","paragraph_zero_based":14901},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new logical channel for a BH RLC channel. It is optionally present, Need M, otherwise.","paragraph_zero_based":14902},{"literal_text_all_w_t_and_m_t":"LCH-SetupOnly","paragraph_zero_based":14903}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["075db90e51cc637a314b4fce1f859e77636175491538a81abe0c5fe73cf5e3fa","937d1e00538bd4990f2c98a063890bb59d012aea9e7e71b0d7d29e0aa86a1a5e","8968802cdc476380faa9e6c72c542750b93142a407764fa90ddeb518aebd86b3","c76aa516350433827d068b5f089ec5b2de3d68cf5d3cf338955db151f6d2b135","053a45afaefaccd7528c2688a4dd9902f67de1b2686adf947c09c8bfc308fa9e","d94840922f515e3816a23f9ebb380908bfaec9fe24313f27f3908cf3bcaae4a1","c2b6b1124728a94dc3bae42006a6eff6285585ac138b133e50036d3560baecb9","6cf9354f702ed08fa4fcdc796369469007fa53f7cc4c99af935d3a8ca060e13d","851b4fd3253918473f9a20532f359a9b99bf7f588c06d5b038d1572b2cbce074","a2b1c9c8b9d68bea9b5dd187e0eea429fda389151739b15c2d4dad51ea8e7209","a80890933a9a47e348db59d7bc4de7cb71762de8f4bad2216b06a6d6160170a7","fc1c03c044f0fac095bd1a453776323b76ebd50d754d644a822df64dd1bb00fd","588522c1f7f6c25236820215d3a70a0337637dcf00b3bf5b0a5d4a7a2296a850","e8b41863d67f332cd0bc63c0074a127601376b8cc7ad48531681ea2ae262604f","c92f16663ac74afe9325821ade4af33