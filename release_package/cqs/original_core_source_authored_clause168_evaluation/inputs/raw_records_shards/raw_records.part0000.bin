{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"T420","paragraph_zero_based":41376},{"literal_text_all_w_t_and_m_t":"Upon reception of the RRCReconfiguration message including sl-PathSwitchConfig","paragraph_zero_based":41377},{"literal_text_all_w_t_and_m_t":"Upon successfully sending RRCReconfigurationComplete message (i.e., PC5 RLC acknowledgement is received from target L2 U2N Relay UE)","paragraph_zero_based":41378},{"literal_text_all_w_t_and_m_t":"Perform the RRC re-establishment procedure as specified in 5.3.7.","paragraph_zero_based":41379},{"literal_text_all_w_t_and_m_t":"T430","paragraph_zero_based":41380},{"literal_text_all_w_t_and_m_t":"Start or restart from the subframe indicated by epochTime upon reception of SIB19, or upon reception of RRCReconfiguration message for the target cell including reconfigurationWithSync, or upon conditional reconfiguration execution i.e. when applying a stored RRCReconfiguration message for the target cell including reconfigurationWithSync.","paragraph_zero_based":41381},{"literal_text_all_w_t_and_m_t":"Stop T430, if it is running, for the source cell upon reception of RRCReconfiguration message including reconfigurationWithSync, or upon conditional reconfiguration execution i.e. when applying a stored RRCReconfiguration message including reconfigurationWithSync.","paragraph_zero_based":41382},{"literal_text_all_w_t_and_m_t":"Perform the actions as specified in 5.2.2.6.","paragraph_zero_based":41383},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41384},{"literal_text_all_w_t_and_m_t":"7.1.2Timer handling","paragraph_zero_based":41385},{"literal_text_all_w_t_and_m_t":"When the UE applies zero value for a timer, the timer shall be started and immediately expire unless explicitly stated otherwise.","paragraph_zero_based":41386},{"literal_text_all_w_t_and_m_t":"7.2Counters","paragraph_zero_based":41387},{"literal_text_all_w_t_and_m_t":"Counter","paragraph_zero_based":41388},{"literal_text_all_w_t_and_m_t":"Reset","paragraph_zero_based":41389},{"literal_text_all_w_t_and_m_t":"Incremented","paragraph_zero_based":41390},{"literal_text_all_w_t_and_m_t":"When reaching max value","paragraph_zero_based":41391},{"literal_text_all_w_t_and_m_t":"N310","paragraph_zero_based":41392},{"literal_text_all_w_t_and_m_t":"Upon reception of \"in-sync\" indication from lower layers;","paragraph_zero_based":41393},{"literal_text_all_w_t_and_m_t":"upon receiving RRCReconfiguration with reconfigurationWithSync for that cell group;","paragraph_zero_based":41394},{"literal_text_all_w_t_and_m_t":"upon initiating the connection re-establishment procedure.","paragraph_zero_based":41395},{"literal_text_all_w_t_and_m_t":"Upon reception of \"out-of-sync\" from lower layer while the timer T310 is stopped.","paragraph_zero_based":41396},{"literal_text_all_w_t_and_m_t":"Start timer T310","paragraph_zero_based":41397},{"literal_text_all_w_t_and_m_t":"N311","paragraph_zero_based":41398},{"literal_text_all_w_t_and_m_t":"Upon reception of \"out-of-sync\" indication from lower layers;","paragraph_zero_based":41399}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["6606b0ddb54a4460b81456138b0e8bf7a11ea95f9d0ba460f2c22bf999fb2a69","012291670f4361d78aea5c398da2f95e32200c0b38f07dcdc7b5bd78b71a63f0","a6b643004013d6313cbfab9a5c6f9aac68ccb4d571760af2422350cfcce502a0","7565c6372aab850c3ff8b1fe14463cb7054020b73b96131d144a3e61c0cba712","1ffedca49842e5dd45ab3675303ab9c660d089d9e8834bb539b1afcf0ff6f9ad","3f1eb55593f997ed6df2844b3abe38b2c6d9104476d374eb8c693f8707966157","