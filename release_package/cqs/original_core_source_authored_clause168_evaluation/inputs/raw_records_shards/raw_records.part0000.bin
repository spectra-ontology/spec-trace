d121d3e5c3714b4d9abebed024b8","1f6270f529b523a527a12ceef87b1ddc28719e10e240cb871571bdf7fc7b5340","ad315a0fe8eba270dc7a145b5b0f5ee601375f17af415e91745015c01909188d","b93eaabea5dc2e9f28360b00316791e07c05917fe733696d265372892157b187","d733cad4141a4899d61369a6a85f71eee45114e87db0ad6af78eecc74b8460dd","0bebde76920b7d6effcc805e675d3d9dfb84fa79d2282b35e14390b10c4b39cb","7538e8273e0f86e20e06e625052a0f46c2419961da77fc44ea4b8b32be8a71b8","2b89e9e67aaa56b2f7f8e6b6abb4386214a449d62fab9cf89db0db13f1681f52","eed2f793567b31454f70ace76241c768996c4ca1b0188e7d8f273b3b60148578","08793f8114402bb68409301a3566b48961ed1f777e46446507c4e41ec3ee8369"],"paragraph_range_zero_based":[18912,18935],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p18912"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"InvalidSymbolPattern field descriptions","paragraph_zero_based":18936},{"literal_text_all_w_t_and_m_t":"periodicityAndPattern","paragraph_zero_based":18937},{"literal_text_all_w_t_and_m_t":"A time domain repetition pattern at which the pattern defined by symbols recurs. This slot pattern repeats itself continuously. When the field is not configured, the UE uses the value n1 (see TS 38.214 [19], clause 6.1).","paragraph_zero_based":18938},{"literal_text_all_w_t_and_m_t":"symbols","paragraph_zero_based":18939},{"literal_text_all_w_t_and_m_t":"A symbol level bitmap in time domain (see TS 38.214[19], clause 6.1).","paragraph_zero_based":18940},{"literal_text_all_w_t_and_m_t":"For oneSlot, if ECP is configured, the first 12 bits represent the symbols within the slot and the last two bits within the bitstring are ignored by the UE; Otherwise, the 14 bits represent the symbols within the slot.","paragraph_zero_based":18941},{"literal_text_all_w_t_and_m_t":"For twoSlots, if ECP is configured, the first 12 bits represent the symbols within the first slot and the next 12 bits represent the symbols in the second slot and the last four bits within the bit string are ignored by the UE; Otherwise, the first 14 bits represent the symbols within the first slot and the next 14 bits represent the symbols in the second slot.","paragraph_zero_based":18942},{"literal_text_all_w_t_and_m_t":"For the bits representing symbols in a slot, the most significant bit of the bit string represents the first symbol in the slot and the second most significant bit represents the second symbol in the slot and so on.","paragraph_zero_based":18943},{"literal_text_all_w_t_and_m_t":"This pattern recurs (in time domain) with the configured periodicityAndPattern.","paragraph_zero_based":18944},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18945},{"literal_text_all_w_t_and_m_t":"–I-RNTI-Value","paragraph_zero_based":18946},{"literal_text_all_w_t_and_m_t":"The IE I-RNTI-Value is used to identify the suspended UE context of a UE in RRC_INACTIVE.","paragraph_zero_based":18947},{"literal_text_all_w_t_and_m_t":"I-RNTI-Value information element","paragraph_zero_based":18948},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18949},{"literal_text_all_w_t_and_m_t":"-- TAG-I-RNTI-VALUE-START","paragraph_zero_based":18950},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18951},{"literal_text_all_w_t_and_m_t":"I-RNTI-Value ::=                        BIT STRING (SIZE(40))","paragraph_zero_based":18952},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18953},{"literal_text_all_w_t_and_m_t":"-- TAG-I-RNTI-VALUE-STOP","paragraph_zero_based":18954},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18955},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18956},{"literal_text_all_w_t_and_m_t":"–LBT-FailureRecoveryConfig","paragraph_zero_based":18957},{"literal_text_all_w_t_and_m_t":"The IE LBT-FailureRecoveryConfig-r16 is used to configure the parameters used for detection of consistent uplink LBT failures for operation with shared spectrum channel access, as specified in TS 38.321 [3].","paragraph_zero_based":18958},{"literal_text_all_w_t_and_m_t":"LBT-FailureRecoveryConfig information element","paragraph_zero_based":18959}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["9d7aa8d82ab42ca17ff49b9010f2c5c3d7bc3a03f5b22c30ef70833e05b9e4c4","68592e66f71c8e1d2c6b44437cbeb048987cc5b4eb51318f56fee5497f8bf331",