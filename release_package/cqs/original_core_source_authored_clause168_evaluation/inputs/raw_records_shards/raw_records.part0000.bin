{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28392},{"literal_text_all_w_t_and_m_t":"–SlotFormatIndicator","paragraph_zero_based":28393},{"literal_text_all_w_t_and_m_t":"The IE SlotFormatIndicator is used to configure monitoring a Group-Common-PDCCH for Slot-Format-Indicators (SFI).","paragraph_zero_based":28394},{"literal_text_all_w_t_and_m_t":"SlotFormatIndicator information element","paragraph_zero_based":28395},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28396},{"literal_text_all_w_t_and_m_t":"-- TAG-SLOTFORMATINDICATOR-START","paragraph_zero_based":28397},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28398},{"literal_text_all_w_t_and_m_t":"SlotFormatIndicator ::=     SEQUENCE {","paragraph_zero_based":28399},{"literal_text_all_w_t_and_m_t":"    sfi-RNTI                    RNTI-Value,","paragraph_zero_based":28400},{"literal_text_all_w_t_and_m_t":"    dci-PayloadSize             INTEGER (1..maxSFI-DCI-PayloadSize),","paragraph_zero_based":28401},{"literal_text_all_w_t_and_m_t":"    slotFormatCombToAddModList  SEQUENCE (SIZE(1..maxNrofAggregatedCellsPerCellGroup)) OF SlotFormatCombinationsPerCell","paragraph_zero_based":28402},{"literal_text_all_w_t_and_m_t":"                                                                                                                              OPTIONAL, -- Need N","paragraph_zero_based":28403},{"literal_text_all_w_t_and_m_t":"    slotFormatCombToReleaseList SEQUENCE (SIZE(1..maxNrofAggregatedCellsPerCellGroup)) OF ServCellIndex                       OPTIONAL, -- Need N","paragraph_zero_based":28404},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":28405},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":28406},{"literal_text_all_w_t_and_m_t":"    availableRB-SetsToAddMo