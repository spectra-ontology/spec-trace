{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Mp is the measurement result of the PCell, not taking into account any offsets.","paragraph_zero_based":5040},{"literal_text_all_w_t_and_m_t":"Mn is the measurement result of the inter-RAT neighbour cell, not taking into account any offsets.","paragraph_zero_based":5041},{"literal_text_all_w_t_and_m_t":"Ofn is the measurement object specific offset of the frequency of the inter-RAT neighbour cell (i.e. eutra-Q-OffsetRange as defined within the measObjectEUTRA corresponding to the frequency of the inter-RAT neighbour cell, utra-FDD-Q-OffsetRange as defined within the measObjectUTRA-FDD corresponding to the frequency of the neighbour inter-RAT cell).","paragraph_zero_based":5042},{"literal_text_all_w_t_and_m_t":"Ocn is the cell specific offset of the inter-RAT neighbour cell (i.e. cellIndividualOffset as defined within the measObjectEUTRA corresponding to the neighbour inter-RAT cell), and set to zero if not configured for the neighbour cell.","paragraph_zero_based":5043},{"literal_text_all_w_t_and_m_t":"Hys is the hysteresis parameter for this event (i.e. hysteresis as defined within reportConfigInterRAT for this event).","paragraph_zero_based":5044},{"literal_text_all_w_t_and_m_t":"Thresh1 is the threshold parameter for this event (i.e. b2-Threshold1 as defined within reportConfigInterRAT for this event).","paragraph_zero_based":5045},{"literal_text_all_w_t_and_m_t":"Thresh2 is the threshold parameter for this event (i.e. b2-Threshold2EUTRA as defined within reportConfigInterRAT for this event, b2-Threshold2UTRA-FDD as defined for UTRA-FDD within reportConfigInterRAT for this event).","paragraph_zero_based":5046},{"literal_text_all_w_t_and_m_t":"Mp is expressed in dBm in case of RSRP, or in dB in case of RSRQ and SINR.","paragraph_zero_based":5047},{"literal_text_all_w_t_and_m_t":"Mn is expressed in dBm or dB, depending on the measurement quantity of the inter-RAT neighbour cell.","paragraph_zero_based":5048},{"literal_text_all_w_t_and_m_t":"Ofn, Ocn, Hys are expressed in dB.","paragraph_zero_based":5049},{"literal_text_all_w_t_and_m_t":"Thresh1 is expressed in the same unit as Mp.","paragraph_zero_based":5050},{"literal_text_all_w_t_and_m_t":"Thresh2 is expressed in the same unit as Mn.","paragraph_zero_based":5051},{"literal_text_all_w_t_and_m_t":"5.5.4.10Event I1 (Interference becomes higher than threshold)","paragraph_zero_based":5052},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5053},{"literal_text_all_w_t_and_m_t":"1>consider the entering condition for this event to be satisfied when condition I1-1, as specified below, is fulfilled;","paragraph_zero_based":5054},{"literal_text_all_w_t_and_m_t":"1>consider the leaving condition for this event to be satisfied when condition I1-2, as specified below, is fulfilled.","paragraph_zero_based":5055},{"literal_text_all_w_t_and_m_t":"Inequality I1-1 (Entering condition)","paragraph_zero_based":5056},{"literal_text_all_w_t_and_m_t":"Mi – Hys > Thresh","paragraph_zero_based":5057},{"literal_text_all_w_t_and_m_t":"Inequality I1-2 (Leaving condition)","paragraph_zero_based":5058},{"literal_text_all_w_t_and_m_t":"Mi+ Hys < Thresh","paragraph_zero_based":5059},{"literal_text_all_w_t_and_m_t":"The variables in the formula are defined as follows:","paragraph_zero_based":5060},{"literal_text_all_w_t_and_m_t":"Mi is the measurement result of the interference, not taking into account any offsets.","paragraph_zero_based":5061},{"literal_text_all_w_t_and_m_t":"Hys is the hysteresis parameter for this event (i.e. hysteresis as defined within reportConfigNR for this event).","paragraph_zero_based":5062},{"literal_text_all_w_t_and_m_t":"Thresh is the threshold parameter for this event (i.e. i1-Threshold as defined within reportConfigNR for this event).","paragraph_zero_based":5063}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["4f4821d10a134b3b033318a603f07dc8047b998bc42c0cd07382116ecc524da6","5bf17faa168a5d37d09911952cb74ef67b067d87c66e33abaf143cc627143f66","7eac94fa5f81e4feef403a9367d92fef522deaef5e79d7c05aaab1af38c89e41","3bc04f4be6e339c2241affc198ecd4f59851f7faac829dcc90a73b41894e380d","5d0eab92c31834de0d06e25587da11cf4725871c0c17cab4042c0b010efff4e7","e26275b1ad1f12168b8a71ad8cda638ebfe798658459514b80ad3d2009378f6b","8f63dbb73e5cf2fbf4e10b78422b626daf11ea234f8a7a107eff679ca337d951","75a79f4ffce0f56fce7f2b2153afc39453e74251910bcca81325f8de3afffff8","7b4412d3a4595b530b0239d9d9b901aba60ddb139824fb2c81113621bdac0ab4","2d56a588edaad8a3e997c16343823a21bc4560bf848cadc10e783c6135e6426c","b1d99c45db4f4083ab4a7005ec34036313c188cbb4483e347b47e20f4a4846fc","79da6cb34a2a27b4fc706b91647f61a2d05cfed3ea3c095c1c8af89ffd1f715a","66013bad3c7c1ffd49f438e711d569b7458b0fb2cf9bb6d11288130902e4773e","756f573ecdb7bfb1590e4f4527e71071fbd0592816ca2a1ad853fc6ee569fd4a","e69aa078871c8e64f4ed7643a7d1151310cfd63d13ddbc3bbf3426d4888fdad6","ee4b081e4e253c6ec464751581b556861f5118df020748efb3ff313a684a6b10","6b115e471edc8dd7671a1d4739a5f12dba04a4a6a41087fb2e7e8409c9adf3e0","36319a73acc5cf5648d53001b1df8e5fb2d591b8d35c893ce5d28079cad48eea","6eac2bc0cd83b623957d8f1136c559a6f81ab8ea52652a22c14a2bd326fdeb15","096f271b9ec4b90eb5f14456ef8843b93bc7e5e6e6a96c9eda043b331bcc91de","278d56afdc4104b3727f9067a37ec3b2639767c29d7dac26326433c63fcefb4c","d20bec5043bfceb81e471df55df75906026506bc47d02e98a07f24ebdfc3a2a4","f916e657f576c71b7696fff9013d4d9be723c97d3da45c7702364304d43f5e09","d904b09d4b3d3b4790328e717fd52b2e3161ac83cd6de4f9e66297475bc3b90d"],"paragraph_range_zero_based":[5040,5063],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p5040"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Mi, Thresh are expressed in dBm.","paragraph_zero_based":5064},{"literal_text_all_w_t_and_m_t":"Hys is expressed in dB.","paragraph_zero_based":5065},{"literal_text_all_w_t_and_m_t":"5.5.4.11Event C1 (The NR sidelink channel busy ratio is above a threshold)","paragraph_zero_based":5066},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5067},{"literal_text_all_w_t_and_m_t":"1>consider the entering condition for this event to be satisfied when condition C1-1, as specified below, is fulfilled;","paragraph_zero_based":5068},{"literal_text_all_w_t_and_m_t":"1>consider the leaving condition for this event to be satisfied when condition C1-2, as specified below, is fulfilled;","paragraph_zero_based":5069},{"literal_text_all_w_t_and_m_t":"Inequality C1-1 (Entering condition)","paragraph_zero_based":5070},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5071},{"literal_text_all_w_t_and_m_t":"Inequality C1-2 (Leaving condition)","paragraph_zero_based":5072},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5073},{"literal_text_all_w_t_and_m_t":"The variables in the formula are defined as follows:","paragraph_zero_based":5074},{"literal_text_all_w_t_and_m_t":"Ms is the measurement result of channel busy ratio of the transmission resource pool, not taking into account any offsets.","paragraph_zero_based":5075},{"literal_text_all_w_t_and_m_t":"Hys is the hysteresis parameter for this event (i.e. hysteresis as defined within reportConfigNR-SL for this event).","paragraph_zero_based":5076},{"literal_text_all_w_t_and_m_t":"Thresh is the threshold parameter for this event (i.e. c1-Threshold as defined within reportConfigNR-SL for this event).","paragraph_zero_based":5077},{"literal_text_all_w_t_and_m_t":"Ms is expressed in decimal from 0 to 1 in steps of 0.01.","paragraph_zero_based":5078},{"literal_text_all_w_t_and_m_t":"Hys is expressed is in the same unit as Ms.","paragraph_zero_based":5079},{"literal_text_all_w_t_and_m_t":"Thresh is expressed in the same unit as Ms.","paragraph_zero_based":5080},{"literal_text_all_w_t_and_m_t":"5.5.4.12Event C2 (The NR sidelink channel busy ratio is below a threshold)","paragraph_zero_based":5081},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5082},{"literal_text_all_w_t_and_m_t":"1>consider the entering condition for this event to be satisfied when condition C2-1, as specified below, is fulfilled;","paragraph_zero_based":5083},{"literal_text_all_w_t_and_m_t":"1>consider the leaving condition for this event to be satisfied when condition C2-2, as specified below, is fulfilled;","paragraph_zero_based":5084},{"literal_text_all_w_t_and_m_t":"Inequality C2-1 (Entering condition)","paragraph_zero_based":5085},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5086},{"literal_text_all_w_t_and_m_t":"Inequality C2-2 (Leaving condition)","paragraph_zero_based":5087}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["bda780a82753e7512adf65708a8178bff74fe6f615e9e9cb25df0eeabe5fd550","f9a332f60f8742321e23e527bcf87999503a392979b26670083b84a19011e894","30f65b3698541887054043d6511f835417789e8610f4c9c4c06152faa1327e1f","3edbab073df2992255447de31be1a31f10e1d2a43204107d89fa6267969611d9","c94b63f39a6c4577ae3213c770b2f875251021dd15335cb825ef8ce20ecd6550","9cb3d9347b925379e53ab95072dac8916f17dd50dc10eeedb026c01dc152117c","87e0e597264dcc2c1281323582adfeddfb0c64d02bb44df4f0853068b5e9be6b","373fc46b8a9be019dba0f57e918366453e226e45da5ed5c4e0d29547771e07a3","2ba908