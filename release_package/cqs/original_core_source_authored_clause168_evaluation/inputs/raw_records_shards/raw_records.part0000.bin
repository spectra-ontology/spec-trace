{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":1416},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1417},{"literal_text_all_w_t_and_m_t":"–LOS-NLOS-IndicatorType2","paragraph_zero_based":1418},{"literal_text_all_w_t_and_m_t":"The IE LOS-NLOS-IndicatorType2 provides information on the LOS-NLOS-Indicator type.","paragraph_zero_based":1419},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":1420},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1421},{"literal_text_all_w_t_and_m_t":"LOS-NLOS-IndicatorType2-r17 ::=ENUMERATED { hardvalue, hardAndsoftvalue }","paragraph_zero_based":1422},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1423},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":1424},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1425},{"literal_text_all_w_t_and_m_t":"–NR-AdditionalPathList","paragraph_zero_based":1426},{"literal_text_all_w_t_and_m_t":"The IE NR-AdditionalPathList is used by the target device to provide information about additional paths in association to the TOA measurements associated to NR positioning in the form of a relative time difference and a quality value. The additional path nr-RelativeTimeDifference is the detected path timing relative to the detected path timing used for the TOA value, and each additional path can be associated with a quality value nr-PathQuality.","paragraph_zero_based":1427},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":1428},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1429},{"literal_text_all_w_t_and_m_t":"NR-AdditionalPathList-r16 ::= SEQUENCE (SIZE(1..2)) OF NR-AdditionalPath-r16","paragraph_zero_based":1430},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1431},{"literal_text_all_w_t_and_m_t":"NR-AdditionalPathListExt-r17 ::= SEQUENCE (SIZE(1..8)) OF NR-AdditionalPath-r16","paragraph_zero_based":1432},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1433},{"literal_text_all_w_t_and_m_t":"NR-AdditionalPath-r16 ::= SEQUENCE {","paragraph_zero_based":1434},{"literal_text_all_w_t_and_m_t":"nr-RelativeTimeDifference-r16CHOICE {","paragraph_zero_based":1435},{"literal_text_all_w_t_and_m_t":"k0-r16INTEGER(0..16351),","paragraph_zero_based":1436},{"literal_text_all_w_t_and_m_t":"k1-r16INTEGER(0..8176),","paragraph_zero_based":1437},{"literal_text_all_w_t_and_m_t":"k2-r16INTEGER(0..4088),","paragraph_zero_based":1438},{"literal_text_all_w_t_and_m_t":"k3-r16INTEGER(0..2044),","paragraph_zero_based":1439}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["fd9bef48a67d61008cceb4ff4000d6c174fcc474c5c560cf610c9802fc83dadf","90cbcb5f7f812d1e0f1a2157f34c02697b9a2b0841fec292dffdcc044565f392","e93852927beec7bdeb27daf3d779fc03e74f756b749a017ea4181028c1601f3b","79bd7a902142293cde4278c34cf4c0b83e0c45a086c7c9555e0a6df254e5340b","1e7d3509f683105be912d38d72a9c3c9c5a63b4f418830d47b00a20e2a7a4eca","939c32338514f873f87923732b295e5702eb53ac17dc189a1adee105d4e2058b","0b38e0a168c423e9db24a6fbe40ff32e8231823f96b9436e00aeee033d0d0e0d","b9b76295d5f3caef8aebe18470429a52a931452ab37d1e7f8e59452f64ec8da8","918dad8f32140d2ca6d74ee2cf5dc0bd7e2404675e4005c8db68232bc37ce677","888ec3027726f67780f41250752c204d5df1c8ad0952d00c42100fe06638506c","e30be25f29dcc349c85788743aceda83843086b8bec8295de55835092743ee4b","ea558384790ab91040e2bf9bf1d97ea6b48327efbadee70d3a1c53162fba13aa","537af0331e088ea3cc57044b8d43e6bb2227967c5ca305af5508b8008429c80a","a19aebe349870173162d41faa37a89de860bebec6916cc850f600531d96716c9","d849e0f1a6240861c1063e8fd9e9a4e6382b39289923e452f6d1af29e1ea384f","d4e1445db2508bf41b22ce313d809f507e721b3d63d76624fa729a6e045c8c67","297534dff606167e07301d37dc438efb15a40bcb18b453630ff8856f4c0d8fac","e7870318f63f78c9964f63776ff7f113cf26f846e45bd24271cf6b7cb489ead3","62b48787200e6cdd189b16fb8925d17de732351b2194a0a9b6493cce1b445e54","a9c9e49f05a211ee4037d325ebee12d573c2c1b4b4cb5ce0ae0a52db2d2a743c","0012b2f220e3eb192ae5cf60c10bc9f83cd6ac32eaeb596e593e3e9cafab02fa","e160c99519b922e035473c5d0dec4207ea2db2ace9c30562985848e0ba171c40","24bbdb90e8a5128e01a96d63f2b16f3513a9e0ef153a2f9b93f28ce4f6903616","bf3620c248c237fbe14188307ed9528ef3f3d4fe5eece5b7afe2c393bb7cff7b"],"paragraph_range_zero_based":[1416,1439],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx:p1416"}
{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"k4-r16INTEGER(0..1022),","paragraph_zero_based":1440},{"literal_text_all_w_t_and_m_t":"k5-r16INTEGER(0..511),","paragraph_zero_based":1441},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":1442},{"literal_text_all_w_t_and_m_t":"},","paragraph_zero_based":1443},{"literal_text_all_w_t_and_m_t":"nr-PathQuality-r16NR-TimingQuality-r16OPTIONAL,","paragraph_zero_based":1444},{"literal_text_all_w_t_and_m_t":"...,","paragraph_zero_based":1445},{"literal_text_all_w_t_and_m_t":"[[","paragraph_zero_based":1446},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-RSRPP-r17INTEGER (0..126)OPTIONAL","paragraph_zero_based":1447},{"literal_text_all_w_t_and_m_t":"]]","paragraph_zero_based":1448},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":1449},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1450},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":1451},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1452},{"literal_text_all_w_t_and_m_t":"NR-AdditionalPathList field descriptions","paragraph_zero_based":1453},{"literal_text_all_w_t_and_m_t":"nr-RelativeTimeDifference","paragraph_zero_based":1454},{"literal_text_all_w_t_and_m_t":"This field specifies the additional detected path timing relative to the detected path timing of the reference resource. The mapping of reported values and measured quantity value is defined in TS 38.133 [46] clause 10.1.23.3.3 and 10.1.25.3.3. A positive value indicates that the particular path is later in time than the detected path of the reference; a negative value indicates that the particular path is earlier in time than the detected path of the reference.","paragraph_zero_based":1455},{"literal_text_all_w_t_and_m_t":"nr-PathQuality","paragraph_zero_based":1456},{"literal_text_all_w_t_and_m_t":"This field specifies the target device′s best estimate of the quality of the detected timing of the additional path.","paragraph_zero_based":1457},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-RSRPP","paragraph_zero_based":1458},{"literal_text_all_w_t_and_m_t":"This field specifies the DL PRS reference signal received path power (DL PRS-RSRPP) of the NR-AdditionalPath reported, as defined in TS 38.215 [36]. The mapping of the quantity is defined as in TS 38.133 [46].","paragraph_zero_based":1459},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1460},{"literal_text_all_w_t_and_m_t":"–NR-DL-PRS-AssistanceData","paragraph_zero_based":1461},{"literal_text_all_w_t_and_m_t":"The IE NR-DL-PRS-AssistanceData is used by the location server to provide DL-PRS assistance data.","paragraph_zero_based":1462},{"literal_text_all_w_t_and_m_t":"NOTE 1:The location server should include at least one TRP for which the SFN can be obtained by the target device, e.g. the serving TRP.","paragraph_zero_based":1463}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["d57eb4b380a5a02324548461f71ddbadf2b0e423a23fde7eb64e07d5ad41760b","b5333f0a6f6b23dc2bced4ab4fb3a27f6a124d3f220f0752d1ef307db49268e2","d3d34a4bdb27b3e32047fa5cc29e89eb399c52ea84ba8ed02bc0b0db7aace9e4","6cb9c674956eed8e26f72017aff0595966d7ef6edca3b06e79be9d69585b36d8","3b92e74761f12146452243bbfd9c69a9469d23b1e236fd1ce2e81a2be58c1f05","de42e7f269e843f4abd785dad7c64aed381a83667dd13080788dc6cf96af59d9","1388381237d8c13d537e31b29d8c5732f7cd5b4bee583ec05d820f751d28f05a","1f2964abed9aeb880868e5448554d9801befacf84adfad783a1939d3c3b6521b","d99a65e39cc259502aa5f6722d1c9a49e881b11a6332f3b0446e011122cb2e0d","533b9b42366e2d06624640c