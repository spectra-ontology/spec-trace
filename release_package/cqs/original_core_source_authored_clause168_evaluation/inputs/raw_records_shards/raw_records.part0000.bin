{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"segmentContainer","paragraph_zero_based":13944},{"literal_text_all_w_t_and_m_t":"This field includes a segment of the encoded SIB12-IEs. The size of the included segment in this container should be small enough that the SIB message size is less than or equal to the maximum size of a NR SI, i.e. 2976 bits when SIB12 is broadcast.","paragraph_zero_based":13945},{"literal_text_all_w_t_and_m_t":"segmentNumber","paragraph_zero_based":13946},{"literal_text_all_w_t_and_m_t":"This field identifies the sequence number of a segment of SIB12-IEs. A segment number of zero corresponds to the first segment, A segment number of one corresponds to the second segment, and so on.","paragraph_zero_based":13947},{"literal_text_all_w_t_and_m_t":"segmentType","paragraph_zero_based":13948},{"literal_text_all_w_t_and_m_t":"This field indicates whether the included segment is the last segment or not.","paragraph_zero_based":13949},{"literal_text_all_w_t_and_m_t":"sl-CSI-Acquisition","paragraph_zero_based":13950},{"literal_text_all_w_t_and_m_t":"This field indicates whether CSI reporting is enabled in sidelink unicast. If not set, SL CSI reporting is disabled.","paragraph_zero_based":13951},{"literal_text_all_w_t_and_m_t":"sl-DRX-ConfigCommonGC-BC","paragraph_zero_based":13952},{"literal_text_all_w_t_and_m_t":"This field indicates the sidelink DRX configuration for groupcast and broadcast communication, as specified in TS 38.321 [3]. This field, if present, also indicates the gNB is capable of sidelink DRX.","paragraph_zero_based":13953},{"literal_text_all_w_t_and_m_t":"sl-EUTRA-AnchorCarrierFreqList","paragraph_zero_based":13954},{"literal_text_all_w_t_and_m_t":"This field indicates the EUTRA anchor carrier frequency list, which can provide the NR sidelink communication configurations.","paragraph_zero_based":13955},{"literal_text_all_w_t_and_m_t":"sl-FreqInfoList","paragraph_zero_based":13956},{"literal_text_all_w_t_and_m_t":"This field indicates the NR sidelink communication/discovery configuration on some carrier frequency (ies). In this release, only one entry can be configured in the list.","paragraph_zero_based":13957},{"literal_text_all_w_t_and_m_t":"sl-L2U2N-Relay","paragraph_zero_based":13958},{"literal_text_all_w_t_and_m_t":"This field indicates the support of NR sidelink Layer-2 relay.","paragraph_zero_based":13959},{"literal_text_all_w_t_and_m_t":"sl-L3U2N-RelayDiscovery","paragraph_zero_based":13960},{"literal_text_all_w_t_and_m_t":"This field indicates the support of L3 U2N relay AS-layer capability, i.e. NR sidelink relay discovery.","paragraph_zero_based":13961},{"literal_text_all_w_t_and_m_t":"sl-MaxNumConsecutiveDTX","paragraph_zero_based":13962},{"literal_text_all_w_t_and_m_t":"This field indicates the maximum number of consecutive HARQ DTX before triggering sidelink RLF. Value n1 corresponds to 1, value n2 corresponds to 2, and so on.","paragraph_zero_based":13963},{"literal_text_all_w_t_and_m_t":"sl-MeasConfigCommon","paragraph_zero_based":13964},{"literal_text_all_w_t_and_m_t":"This field indicates the measurement configurations (e.g. RSRP) for NR sidelink communication.","paragraph_zero_based":13965},{"literal_text_all_w_t_and_m_t":"sl-NonRelayDiscovery","paragraph_zero_based":13966},{"literal_text_all_w_t_and_m_t":"This field indicates the support of NR sidelink non-relay discovery.","paragraph_zero_based":13967}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["6777bc05c97c9c9d84b78d1ffceb4de6eaba09fb56bb62241bbac280a52dc889","d8c727d65974bb7ce69d434d384c25bedffcb53906f1a76818d670b36609b861","ece7fdc40b8c59bbc69945768b7b548e39b01465f4da2a8c0bab17359f737bc4","8932f9b4e2a7f93499aa7c2676cd77692cc2ce11235acf350c0d05386afb77e9","bc37fb1dca4e434c96085d1d307d0aad92de7dcd791a9b0e9e00a4c2580eb6e5","98faa8666f49a0121564f9aeb0e1ed3c59b9362f9460c37090a03a4a17fd23aa","44ac6a061329c81da25148f0b14fa2ba93e24552c898b09d4cb649cccb8728d6","20b583ec0afdadbaf142b88f509d5752adda69c9a5d6dedc94ad8a24ba5eb001","f9a62888a6dfd314164905267484fc7086f002d7b4302226251a69efab33ae06","3bdad516787771206e07a306f5e1b96bc873d3fbec11a981341f3574b936bd48","0a7390e1a44d8ecd98bef2d34655a4b242b3b19bbb8ef4e0765a2855c779cd21","62a5bbe00f67f2d84138b94cc1e61e0860ad6965fc630211ad474273ce4f61e3","09e479a007d59ae971e2a49e5606d2dffcfad227efca9c3c9b0308c96090fc2a","c99a962ebd50f3a390b147d8eb93016558ff1e3bd7f923e9704216fe1699e628","988996855771469e4b5bb23a4182ad587abb5a6cb9b0a3e07090ccae73e0d3f3","90d1d0007191319890975e2209a2b9f8ec2b79c0e379e2918686decc7b921c8b","c3c74f8d2f412a699211fcc6ffc8793bc8647236568a8c989a4b72b6b1498f7a","2c8d3a0b80695c93d9f34079f4be2a6e832bc66a42593f1b8bca095694e4bab0","da1cd87e240ce34ade84d6b90a6d0917e2fef1757cfdc4ee17f71fe72186d7e2","793659fd0339f8e03edf8a6bbbc041c8f66ce47eea52e0eb36316b884a54d046","f389d894d235187cd1110b8afdcefbfb0195fb539fa5d7589cf741f6a1c2c30d","ae25ed48e07193ed070c1978923d92b61766b095df04bdd8b869a9052d48feea","4dba94ffa3acf9f6b99bd218ec8b743f0c6058389883ccbef2b86774ac0be900","78f681f8694a7fdc75ca8dfdbef1c493d96d200a3ab16fc019eb8b9832ebaf13"],"paragraph_range_zero_based":[13944,13967],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p13944"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-NR-AnchorCarrierFreqList","paragraph_zero_based":13968},{"literal_text_all_w_t_and_m_t":"This field indicates the NR anchor carrier frequency list, which can provide the NR sidelink communication/discovery configurations.","paragraph_zero_based":13969},{"literal_text_all_w_t_and_m_t":"sl-OffsetDFN","paragraph_zero_based":13970},{"literal_text_all_w_t_and_m_t":"Indicates the timing offset for the UE to determine DFN timing when GNSS is used for timing reference. Value 1 corresponds to 0.001 milliseconds, value 2 corresponds to 0.002 milliseconds, and so on.","paragraph_zero_based":13971},{"literal_text_all_w_t_and_m_t":"sl-RadioBearerConfigList","paragraph_zero_based":13972},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple sidelink radio bearer configurations.","paragraph_zero_based":13973},{"literal_text_all_w_t_and_m_t":"sl-RLC-BearerConfigList","paragraph_zero_based":13974},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple sidelink RLC bearer configurations.","paragraph_zero_based":13975},{"literal_text_all_w_t_and_m_t":"sl-SSB-PriorityNR","paragraph_zero_based":13976},{"literal_text_all_w_t_and_m_t":"This field indicates the priority of NR sidelink SSB transmission and reception.","paragraph_zero_based":13977},{"literal_text_all_w_t_and_m_t":"t400","paragraph_zero_based":13978},{"literal_text_all_w_t_and_m_t":"Indicates the value for timer T400 as described in clause 7.1. Value ms100 corresponds to 100 ms, value ms200 corresponds to 200 ms and so on.","paragraph_zero_based":13979},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13980},{"literal_text_all_w_t_and_m_t":"–SIB13","paragraph_zero_based":13981},{"literal_text_all_w_t_and_m_t":"SIB13 contains configurations of V2X sidelink communication defined 