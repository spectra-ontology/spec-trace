{"fields":{"filename":"R2-2311970.zip::R2-2311970 Introduction of Rel-18 Multi-path.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"n3c-MappingToReleaseList","paragraph_zero_based":2712},{"literal_text_all_w_t_and_m_t":"Indicates the list of mappings between the bearer identity of the N3C remote UE and the Uu RLC channel to be released.","paragraph_zero_based":2713},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2714},{"literal_text_all_w_t_and_m_t":"–N3C-IndirectPathAddChange","paragraph_zero_based":2715},{"literal_text_all_w_t_and_m_t":"The IE N3C-IndirectPathAddChange indicates the N3C indirect path related configuration used by N3C remote UE.","paragraph_zero_based":2716},{"literal_text_all_w_t_and_m_t":"N3C-IndirectPathAddChange information element","paragraph_zero_based":2717},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":2718},{"literal_text_all_w_t_and_m_t":"-- TAG-N3C-INDIRECTPATHADDCHANGE-START","paragraph_zero_based":2719},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2720},{"literal_text_all_w_t_and_m_t":"N3C-IndirectPathAddChange-r18 ::=  SEQUENCE {","paragraph_zero_based":2721},{"literal_text_all_w_t_and_m_t":"    n3c-RelayIdentification-r18          SEQUENCE {","paragraph_zero_based":2722},{"literal_text_all_w_t_and_m_t":"        n3c-CellGlobalId-r18                 SEQUENCE {","paragraph_zero_based":2723},{"literal_text_all_w_t_and_m_t":"           n3c-PLMN-Id-18                        PLMN-Identity,","paragraph_zero_based":2724},{"literal_text_all_w_t_and_m_t":"           n3c-CellIdentity-r18                  CellIdentity","paragraph_zero_based":2725},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":2726},{"literal_text_all_w_t_and_m_t":"    n3c-C-RNTI-r18                       RNTI-Value","paragraph_zero_based":2727},{"literal_text_all_w_t_and_m_t":"    }                                                O