{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"codebookMode","paragraph_zero_based":16224},{"literal_text_all_w_t_and_m_t":"CodebookMode as specified in TS 38.214 [19], clause 5.2.2.2.2.","paragraph_zero_based":16225},{"literal_text_all_w_t_and_m_t":"codebookType","paragraph_zero_based":16226},{"literal_text_all_w_t_and_m_t":"CodebookType including possibly sub-types and the corresponding parameters for each (see TS 38.214 [19], clause 5.2.2.2).","paragraph_zero_based":16227},{"literal_text_all_w_t_and_m_t":"n1-n2-codebookSubsetRestriction","paragraph_zero_based":16228},{"literal_text_all_w_t_and_m_t":"Number of antenna ports in first (n1) and second (n2) dimension and codebook subset restriction (see TS 38.214 [19] clause 5.2.2.2.3).","paragraph_zero_based":16229},{"literal_text_all_w_t_and_m_t":"Number of bits for codebook subset restriction is CEIL(log2(nchoosek(O1*O2,4)))+8*n1*n2 where nchoosek(a,b) = a!/(b!(a-b)!).","paragraph_zero_based":16230},{"literal_text_all_w_t_and_m_t":"n1-n2","paragraph_zero_based":16231},{"literal_text_all_w_t_and_m_t":"Number of antenna ports in first (n1) and second (n2) dimension and codebook subset restriction (see TS 38.214 [19] clause 5.2.2.2.1).","paragraph_zero_based":16232},{"literal_text_all_w_t_and_m_t":"ng-n1-n2","paragraph_zero_based":16233},{"literal_text_all_w_t_and_m_t":"Codebook subset restriction for Type I Multi-panel codebook (see TS 38.214 [19], clause 5.2.2.2.2).","paragraph_zero_based":16234},{"literal_text_all_w_t_and_m_t":"numberOfBeams","paragraph_zero_based":16235},{"literal_text_all_w_t_and_m_t":"Number of beams, L, used for linear combination.","paragraph_zero_based":16236},{"literal_text_all_w_t_and_m_t":"numberOfPMI-SubbandsPerCQI-Subband","paragraph_zero_based":16237},{"literal_text_all_w_t_and_m_t":"Field indicates how PMI subbands are defined per CQI subband according to TS 38.214 [19], clause 5.2.2.2.5, and 5.2.2.2.7.","paragraph_zero_based":16238},{"literal_text_all_w_t_and_m_t":"paramCombination","paragraph_zero_based":16239},{"literal_text_all_w_t_and_m_t":"Field describes supported parameter combination (M, α, β) as specified in TS 38.214 [19].","paragraph_zero_based":16240},{"literal_text_all_w_t_and_m_t":"phaseAlphabetSize","paragraph_zero_based":16241},{"literal_text_all_w_t_and_m_t":"The size of the PSK alphabet, QPSK or 8-PSK.","paragraph_zero_based":16242},{"literal_text_all_w_t_and_m_t":"portSelectionSamplingSize","paragraph_zero_based":16243},{"literal_text_all_w_t_and_m_t":"The size of the port selection codebook (parameter d), see TS 38.214 [19] clause 5.2.2.2.6.","paragraph_zero_based":16244},{"literal_text_all_w_t_and_m_t":"ri-Restriction","paragraph_zero_based":16245},{"literal_text_all_w_t_and_m_t":"Restriction for RI for TypeI-MultiPanel-RI-Restriction (see TS 38.214 [19], clause 5.2.2.2.2).","paragraph_zero_based":16246},{"literal_text_all_w_t_and_m_t":"subbandAmplitude","paragraph_zero_based":16247}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["311d9f036a6f70bee8ea9a65a1f073405e5f6ee341d8549908f7f6359ef5fcf0","62144c1b6da122b1d48a4d390e4271d34d720a6c5b0cd9738ee00fb6bf4b1eff","6588d3bef60d66883f79bc1c1af134650149e1655834c271035ca6c320437fc6","5664ce51a85439bbc338541312ea6271df1dbb415a6eeb314163c2b62521d82b","9496f80f21fe950bfa661ea5773aed5873aa8cbc57394c5d29e6787ab73c49eb","bb9cf1e306af4fdfd95b0410cf5cdc78d489dcbe0800bf450b7159af90b43b81","954faa0c292d93b4b0d1e3f401b6ca7e2abcdc458298348d78ff0bdaaaefe48d","21fe054f47a1c49580e6dee5be0c21a3de24450c8207abdbcd1a5672df85f6e7","36ad535a