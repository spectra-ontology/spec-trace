al_text_all_w_t_and_m_t":"This field indicates how to map sidelink QoS flows to sidelink DRB.","paragraph_zero_based":38823},{"literal_text_all_w_t_and_m_t":"slrb-Uu-ConfigIndex","paragraph_zero_based":38824},{"literal_text_all_w_t_and_m_t":"This field indicates the index of sidelink DRB configuration.","paragraph_zero_based":38825},{"literal_text_all_w_t_and_m_t":"sl-TransRange","paragraph_zero_based":38826},{"literal_text_all_w_t_and_m_t":"This field indicates the transmission range of the sidelink DRB. The unit is meter.","paragraph_zero_based":38827},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38828},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":38829},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":38830},{"literal_text_all_w_t_and_m_t":"SLRBSetup","paragraph_zero_based":38831}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["7d554f6bdc36a9edfc6f3ed1af8f473f01352874de2e409ebf2a8ebdba6b90eb","e661e4ca6f541677b5927f1710dc70bb24691b49732fbc4df9eb1b8505304e84","08e077f17ad8e86290c138402e415f92c2bb016439106279357ac603ee71920e","1001cd37fc9d1c83ffbf6f9a3e4b174c8a2d8be46a211a7958e2cbc2d4cc6fa1","2af29043777bf85129700907b8e862548e422bdb1a9c9084519806c996c644ca","c6f80fffbce236674156b395bd0e2ea75c4f353d40dac2f490f0ef7012112e9f","dbc812b2f87f9616b258a2402c8bb3d5f63ad07b73e152d54be0b8eb8beefe9d","569b9bb15cad6408b5e11019ccfb006141a8db3658d58c635c66714a507a8efc","746ed01f5e052f676dbc22c2e02469ca0bbccd27bc4e3f8923932d653633c95f","c6ac471eb4d2797ac1b376207370dfb3a1cb1082766592ed5eab9bd76f83fde7","282a8ade98dfd891824c3f80dca1062b5d3ab39c48bdcf30fb8947d8f255c2f1","dad8cf3e98808df505fb8cdad7b541864415688454bc809a