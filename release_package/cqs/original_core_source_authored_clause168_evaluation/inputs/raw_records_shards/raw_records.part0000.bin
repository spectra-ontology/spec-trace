{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ULDedicatedMessageSegment field descriptions","paragraph_zero_based":12936},{"literal_text_all_w_t_and_m_t":"segmentNumber","paragraph_zero_based":12937},{"literal_text_all_w_t_and_m_t":"Identifies the sequence number of a segment within the encoded UL DCCH message. ","paragraph_zero_based":12938},{"literal_text_all_w_t_and_m_t":"rrc-MessageSegmentContainer","paragraph_zero_based":12939},{"literal_text_all_w_t_and_m_t":"Includes a segment of the encoded UL DCCH message. The size of the included segment in this container should be small enough that the resulting encoded RRC message PDU is less than or equal to the PDCP SDU size limit.","paragraph_zero_based":12940},{"literal_text_all_w_t_and_m_t":"rrc-MessageSegmentType","paragraph_zero_based":12941},{"literal_text_all_w_t_and_m_t":"Indicates whether the included UL DCCH message segment is the last segment or not.","paragraph_zero_based":12942},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12943},{"literal_text_all_w_t_and_m_t":"–ULInformationTransfer","paragraph_zero_based":12944},{"literal_text_all_w_t_and_m_t":"The ULInformationTransfer message is used for the uplink transfer of NAS or non-3GPP dedicated information, or IAB-DU specific F1-C related information.","paragraph_zero_based":12945},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB2 or SRB1 (only if SRB2 not established yet). If SRB2 is suspended, the UE does not send this message until SRB2 is resumed. If only dedicatedInfoF1c is included, SRB2 is used.","paragraph_zero_based":12946},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":12947},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":12948},{"literal_text_all_w_t_and_m_t":"Direction: UE to network","paragraph_zero_based":12949},{"literal_text_all_w_t_and_m_t":"ULInformationTransfer message","paragraph_zero_based":12950},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":12951},{"literal_text_all_w_t_and_m_t":"-- TAG-ULINFORMATIONTRANSFER-START","paragraph_zero_based":12952},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12953},{"literal_text_all_w_t_and_m_t":"ULInformationTransfer ::=           SEQUENCE {","paragraph_zero_based":12954},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                  CHOICE {","paragraph_zero_based":12955},{"literal_text_all_w_t_and_m_t":"        ulInformationTransfer               ULInformationTransfer-IEs,","paragraph_zero_based":12956},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture            SEQUENCE {}","paragraph_zero_based":12957},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":12958},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":12959}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["970467f2cdd9203db9c889135ba49bd66a481d5d457a41b8ee43782334adab22","f50dfb805f4b11ab612ddd4e543d278c82e2243bfc454943de06feeb33719a90","92cf4c32391abe2dfed5a79da4b6770463bcca66391700831709c5403e49ccd8","af3f1656b2b1767c7d3dc5a09a142737011ce1a10f46746746a6ab56d9472bb6","1ecaf8e1760b8f8aad8fdb61a015abad8a31c6e2035794cf184dfd5c9349b1fd","9fdf74e8c51d9506bfdbe29863d8ac895bd3d322ef51b7ce13309c5af025eb1b","d7666b69153469947f694533c0cff17974ccf2ddea8d51b26423655aa80806ab","d1500fa1af8980144f273ac451ecad9c4c0f90bac312fa07fc59909e7d5986dd","e2bdf933ee0585aa2b8c45031c5d00f8becf1a0c933d4206fb22affb1de4e8ca","a568079b4cfd2186fb44371bccfcd2f41a027f74834a776f436ef01cb93a479d","4d8e73a0db2ef7fe85a2