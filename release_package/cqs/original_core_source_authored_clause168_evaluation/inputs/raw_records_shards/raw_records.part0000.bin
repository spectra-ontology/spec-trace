teral_text_all_w_t_and_m_t":"maxNumOfSemiPersistentSRSposResources-r17","paragraph_zero_based":3065},{"literal_text_all_w_t_and_m_t":"ENUMERATED { n1, n2, n4, n8, n16, n32, n64 }","paragraph_zero_based":3066},{"literal_text_all_w_t_and_m_t":"OPTIONAL,","paragraph_zero_based":3067},{"literal_text_all_w_t_and_m_t":"maxNumOfSemiPersistentSRSposResourcesPerSlot-r17","paragraph_zero_based":3068},{"literal_text_all_w_t_and_m_t":"ENUMERATED { n1, n2, n3, n4, n5, n6, n8, n10,","paragraph_zero_based":3069},{"literal_text_all_w_t_and_m_t":"n12, n14 }OPTIONAL,","paragraph_zero_based":3070},{"literal_text_all_w_t_and_m_t":"switchingTimeSRS-TX-OtherTX-r17ENUMERATED { us100, us140, us200, us300, us500 }","paragraph_zero_based":3071}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["76684d791990ddce3e8ba1703615334987790ec971d06308bdaad6c3e1aad2e4","eb5740ea73e46bbf4c7f1878d2eebf8e77ab9e6b366a080df80a58085ec82cfe","d8db167a7a9ed7941aaf0c551f792330beff53a396c30e8106c4a3a9efd22505","d98eebabc38189708e929ce756f4768671448430b034de1dfed950f441a015ce","906cf0e860b44738b3f8120f565d14f8e7bc969a60ad339ae709d4b3bf8541ad","2340fbd7f2e998669786a82c6c67075f78bf101eb51d9e0a9a99d6a203428e38","f3dcec4186bd4f79969c8ed9e6b49f1e05bb9ee793a811c071f7dd58b37065dc","89b59716d34fba6c22bd78554ba8c3654e7a380c14b3fecd970209af766b03a1","cfea8261e023981060c3c31df91db4e9d7f6b1119dc62907b58479798fd97524","61c06fe8a1632e206b8bbf4bca0b8e4545b6768540d1ef232d36bafd878b58ab","a64d28e51b6aecd3e77ce3e9f05259e93216f41e491f33dc1716657eca1c91d3","e712a24465ab252c6e0de7e94c7fe76a29e397ab08f834a4fff5035b73452591","7f860d72fcc066453976772e4c35237e06213f0ec64729e0549657b98f0ebb3e","f0c4019a485986f638b49765fbbbb09a6408f20b96984a