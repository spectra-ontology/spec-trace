4cb2625c4f64c1ca49720702e357","b3afd5d29840352ded21515afbfea82777598b2eacc21b614b6863ca871280ed","573de21de50d1b7059905ab8c020ea9b37796e619327ba9b4ca99ef1861c3403","9929ed3bdf8c10d5a17b7b0881277e3ddeeff507dbfa995dc8e5dafa46cc7824","232ee196c2e9b63e8ce83e899d48b82e37a55bb758bff20d0905bf6abe4a1629","adac0fdac016593903b057489b8061ee9eade668bbdebc96749a6fa22b764879","9afe3ee2a8f30b840a43e9fbb7fc00dbeb79678c92f4621664f117036248114a","ce84d32376f8c1ffe02409906e63e6d3bcb20dfa8954e59050c2e34dc451c940","716d446d429149090476d32394159c13a7368331b20a51063859ad8d9ad2073c"],"paragraph_range_zero_based":[39768,39791],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p39768"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"An additional common control resource set which may be configured and used for searchSpaceMCCH/searchSpaceMTCH or UE-specific search space in the BWP where searchSpaceMCCH is configured. It is contained in the bandwidth of the CFR for broadcast and larger than CORESET#0.","paragraph_zero_based":39792},{"literal_text_all_w_t_and_m_t":"locationAndBandwidthBroadcast","paragraph_zero_based":39793},{"literal_text_all_w_t_and_m_t":"Indicates starting PRB and the number of PRBs of CFR used for MCCH and MTCH reception.","paragraph_zero_based":39794},{"literal_text_all_w_t_and_m_t":"Value sameAsSib1ConfiguredLocationAndBW means the CFR for broadcast has the same location and size as the locationAndBandwidth for initial BWP configured in SIB1.","paragraph_zero_based":39795},{"literal_text_all_w_t_and_m_t":"Value locationAndBandwidth is used to configure CFR with bandwidth that is larger than and fully contains the bandwidth for the initial DL BWP configured in SIB1 and CORESET#0. The value of the field shall be interpreted as defined in TS 38.214 [19] with assumptions as described in TS 38.213 [13].","paragraph_zero_based":39796},{"literal_text_all_w_t_and_m_t":"If the field is absent, the CFR for broadcast has the same location and size as CORESET#0.","paragraph_zero_based":39797},{"literal_text_all_w_t_and_m_t":"pdsch-ConfigMCCH","paragraph_zero_based":39798},{"literal_text_all_w_t_and_m_t":"Indicates PDSCH parameters used for MCCH transmission. If the field is absent, PDSCH parameters used for MCCH are the same as those of PDSCH configuration provided in initialDownlinkBWP in SIB1.","paragraph_zero_based":39799},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39800},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":39801},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":39802},{"literal_text_all_w_t_and_m_t":"NotSIB1CommonControlResource","paragraph_zero_based":39803},{"literal_text_all_w_t_and_m_t":"The field is optional present in case commonControlResourceSet is not configured in SIB1, Need R, otherwise it is absent.","paragraph_zero_based":39804},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39805},{"literal_text_all_w_t_and_m_t":"–DRX-ConfigPTM","paragraph_zero_based":39806},{"literal_text_all_w_t_and_m_t":"The IE DRX-Config-PTM is used to configure DRX related parameters for PTM transmission as specified in TS 38.321 [3].","paragraph_zero_based":39807},{"literal_text_all_w_t_and_m_t":"DRX-Config-PTM information element","paragraph_zero_based":39808},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39809},{"literal_text_all_w_t_and_m_t":"-- TAG-DRX-CONFIGPTM-START","paragraph_zero_based":39810},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39811},{"literal_text_all_w_t_and_m_t":"DRX-ConfigPTM-r17 ::=             SEQUENCE {","paragraph_zero_based":39812},{"literal_text_all_w_t_and_m_t":"    drx-onDurationTimerPTM-r17        CHOICE {","paragraph_zero_based":39813},{"literal_text_all_w_t_and_m_t":"        subMilliSeconds                   INTEGER (1..31),","paragraph_zero_based":39814},{"literal_text_all_w_t_and_m_t":"        milliSeconds                      ENUMERATED {","paragraph_zero_based":39815}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["c5c9465e9c9d6fd67d5fba003e2b0ec151caf8dbfdcb42232ece38d0745e0aee","f42a8151293ca5ecf583f6f9bfca7a9d2d2cec27294c06970e3434f79a93ded4","a3e70d280e16e7ef9f2b547831cc95843502baf632bc