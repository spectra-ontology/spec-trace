{"fields":{"filename":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"7.1.2Timer handling","paragraph_zero_based":3120},{"literal_text_all_w_t_and_m_t":"When the UE applies zero value for a timer, the timer shall be started and immediately expire unless explicitly stated otherwise.","paragraph_zero_based":3121},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3122},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3123},{"literal_text_all_w_t_and_m_t":"<<Skip Unchanged>>","paragraph_zero_based":3124},{"literal_text_all_w_t_and_m_t":"9.1Specified configurations","paragraph_zero_based":3125},{"literal_text_all_w_t_and_m_t":"9.1.1Logical channel configurations","paragraph_zero_based":3126},{"literal_text_all_w_t_and_m_t":"9.1.1.4SCCH configuration","paragraph_zero_based":3127},{"literal_text_all_w_t_and_m_t":"Parameters that are specified for unicast of NR sidelink communication, which is used for the sidelink signalling radio bearer of PC5-RRC message. The SL-SRB using this SCCH configuration is named as SL-SRB3.","paragraph_zero_based":3128},{"literal_text_all_w_t_and_m_t":"Name","paragraph_zero_based":3129},{"literal_text_all_w_t_and_m_t":"Value","paragraph_zero_based":3130},{"literal_text_all_w_t_and_m_t":"Semantics description","paragraph_zero_based":3131},{"literal_text_all_w_t_and_m_t":"Ver","paragraph_zero_based":3132},{"literal_text_all_w_t_and_m_t":"PDCP configuration","paragraph_zero_based":3133},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3134},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3135},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3136},{"literal_text_all_w_t_and_m_t":">t-Reordering","paragraph_zero_based":3137},{"literal_text_all_w_t_and_m_t":"Undefined","paragraph_zero_based":3138},{"literal_text_all_w_t_and_m_t":"Selected by the receiving UE, up