{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-UE-RADIO-PAGING-INFORMATION-STOP","paragraph_zero_based":44208},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44209},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44210},{"literal_text_all_w_t_and_m_t":"UERadioPagingInformation field descriptions","paragraph_zero_based":44211},{"literal_text_all_w_t_and_m_t":"supportedBandListNRForPaging","paragraph_zero_based":44212},{"literal_text_all_w_t_and_m_t":"Indicates the UE supported NR frequency bands which are derived by the gNB from UE-NR-Capability.","paragraph_zero_based":44213},{"literal_text_all_w_t_and_m_t":"dl-SchedulingOffset-PDSCH-TypeA-FDD-FR1","paragraph_zero_based":44214},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports DL scheduling slot offset (K0) greater than 0 for PDSCH mapping type A in FDD FR1.","paragraph_zero_based":44215},{"literal_text_all_w_t_and_m_t":"dl-SchedulingOffset-PDSCH-TypeA-TDD-FR1","paragraph_zero_based":44216},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports DL scheduling slot offset (K0) greater than 0 for PDSCH mapping type A in TDD FR1.","paragraph_zero_based":44217},{"literal_text_all_w_t_and_m_t":"dl-SchedulingOffset-PDSCH-TypeA-TDD-FR2","paragraph_zero_based":44218},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports DL scheduling slot offset (K0) greater than 0 for PDSCH mapping type A in TDD FR2.","paragraph_zero_based":44219},{"literal_text_all_w_t_and_m_t":"dl-SchedulingOffset-PDSCH-TypeB-FDD-FR1","paragraph_zero_based":44220},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports DL scheduling slot offset (K0) greater than 0 for PDSCH mapping type B in FDD FR1.","paragraph_zero_based":44221},{"literal_text_all_w_t_and_m_t":"dl-SchedulingOffset-PDSCH-TypeB-TDD-FR1","paragraph_zero_based":44222},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports DL scheduling slot offset (K0) greater than 0 for PDSCH mapping type B in TDD FR1.","paragraph_zero_based":44223},{"literal_text_all_w_t_and_m_t":"dl-SchedulingOffset-PDSCH-TypeB-TDD-FR2","paragraph_zero_based":44224},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports DL scheduling slot offset (K0) greater than 0 for PDSCH mapping type B in TDD FR2.","paragraph_zero_based":44225},{"literal_text_all_w_t_and_m_t":"halfDuplexFDD-TypeA-RedCap","paragraph_zero_based":44226},{"literal_text_all_w_t_and_m_t":"Indicates whether the RedCap UE only supports half-duplex operation for FDD in the indicated band(s).","paragraph_zero_based":44227},{"literal_text_all_w_t_and_m_t":"inactiveStatePO-Determination","paragraph_zero_based":44228},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports to use the same i_s to determine PO in RRC_INACTIVE state as in RRC_IDLE state.","paragraph_zero_based":44229},{"literal_text_all_w_t_and_m_t":"numberOfRxRedCap","paragraph_zero_based":44230},{"literal_text_all_w_t_and_m_t":"Indicates the number of Rx branches supported by a RedCap UE.","paragraph_zero_based":44231}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["79ad6b6f79137f1cf6db23a1e9061ab24e95d7b9e50ca6e6e839dd8cbb803ded","dae3d8a848178d7a7889f128c33090b9ccae697f865296adf7cd87a507265212","cf9ddd59ed7b0c751adf9397abc1aadfe7450c464be8b9c18dd138acd8093193","fb0cd3638292489d2a492a7ade3e4f9fdc61fb92ad0f51066194cc77e822a33c","b6e55c3a6d8d48801f9090dd0754c33f335470a8f5a2e5a209dc7830de30a4ea","664cea25d24d76d1bdbbd2051619c8897124d8b674958576f65fbf9633bf8755","b50dcd60fa0ff