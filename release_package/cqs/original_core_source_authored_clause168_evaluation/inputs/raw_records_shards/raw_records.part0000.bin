{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":37800},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":37801},{"literal_text_all_w_t_and_m_t":"L2RelayUE","paragraph_zero_based":37802},{"literal_text_all_w_t_and_m_t":"For L2 U2N Relay UE, the field is optionally present, Need M. Otherwise, it is absent.","paragraph_zero_based":37803},{"literal_text_all_w_t_and_m_t":"L2RemoteUE","paragraph_zero_based":37804},{"literal_text_all_w_t_and_m_t":"For L2 U2N Remote UE, the field is optionally present, Need M. Otherwise, it is absent.","paragraph_zero_based":37805},{"literal_text_all_w_t_and_m_t":"L2U2N","paragraph_zero_based":37806},{"literal_text_all_w_t_and_m_t":"The field is optional present for L2 U2N Relay UE and L2 U2N Remote UE, need N. Otherwise, it is absent.","paragraph_zero_based":37807},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37808},{"literal_text_all_w_t_and_m_t":"–SL-ConfiguredGrantConfig","paragraph_zero_based":37809},{"literal_text_all_w_t_and_m_t":"The IE SL-ConfiguredGrantConfig specifies the configured grant configuration information for NR sidelink communication.","paragraph_zero_based":37810},{"literal_text_all_w_t_and_m_t":"SL-ConfiguredGrantConfig information element","paragraph_zero_based":37811},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":37812},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-CONFIGUREDGRANTCONFIG-START","paragraph_zero_based":37813},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37814},{"literal_text_all_w_t_and_m_t":"SL-ConfiguredGrantConfig-r16 ::=           SEQUENCE {","paragraph_zero_based":37815},{"literal_text_all_w_t_and_m_t":"    sl-ConfigIndexCG-r16                       SL-ConfigIndexCG-r16,","paragraph_zero_based":37816},{"literal_text_all_w_t_and_m_t":"    sl-PeriodCG-r16                            SL-PeriodCG-r16                                                       OPTIONAL, -- Need M","paragraph_zero_based":37817},{"literal_text_all_w_t_and_m_t":"    sl-NrOfHARQ-Processes-r16                  INTEGER (1..16)                                                       OPTIONAL, -- Need M","paragraph_zero_based":37818},{"literal_text_all_w_t_and_m_t":"    sl-HARQ-ProcID-offset-r16                  INTEGER (0..15)                                                       OPTIONAL, -- Need M","paragraph_zero_based":37819},{"literal_text_all_w_t_and_m_t":"    sl-CG-MaxTransNumList-r16                  SL-CG-MaxTransNumList-r16                                             OPTIONAL, -- Need M","paragraph_zero_based":37820},{"literal_text_all_w_t_and_m_t":"    rrc-ConfiguredSidelinkGrant-r16            SEQUENCE {","paragraph_zero_based":37821},{"literal_text_all_w_t_and_m_t":"        sl-TimeResourceCG-Type1-r16                INTEGER (0..496)                                                  OPTIONAL, -- Need M","paragraph_zero_based":37822},{"literal_text_all_w_t_and_m_t":"        sl-StartSubchannelCG-Type1-r16             INTEGER (0..26)                                                   OPTIONAL, -- Need M","paragraph_zero_based":37823}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["3ffbf3aa483f3a683a2ba265056c173926721adf79add9dfce0d8c55bb6a2385","14f710785a145882675f1e734404ef1662be2716510095a0da3c67da00938c7f","83e82dea36ace9904efef066076670e6716252db6ec7045ede8353f57aed695f","08bea0de0161ed2fd7cb077dbab278a78d8ee3f41152cbe75a2806131894a22c","8c0ecf6cd8a8e5b16396f4cac9443e0f463c34ba1d636f041420616c582ef405","5a3ccb6264e