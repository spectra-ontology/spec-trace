{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Identifies the PLMN of the cell for the reported cellIdentity: the first PLMN entry of plmn-IdentityList (when connected to EPC) or of plmn-IdentityList-r15 (when connected to 5GC) in SystemInformationBlockType1 that contained the reported cellIdentity.","paragraph_zero_based":15960},{"literal_text_all_w_t_and_m_t":"trackingAreaCode-eutra-epc, trackingAreaCode-eutra-5gc","paragraph_zero_based":15961},{"literal_text_all_w_t_and_m_t":"Indicates Tracking Area Code to which the cell indicated by cellIdentity-eutra-epc, cellIdentity-eutra-5GC belongs.","paragraph_zero_based":15962},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15963},{"literal_text_all_w_t_and_m_t":"–CGI-InfoNR","paragraph_zero_based":15964},{"literal_text_all_w_t_and_m_t":"The IE CGI-InfoNR indicates cell access related information, which is reported by the UE as part of report CGI procedure.","paragraph_zero_based":15965},{"literal_text_all_w_t_and_m_t":"CGI-InfoNR information element","paragraph_zero_based":15966},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":15967},{"literal_text_all_w_t_and_m_t":"-- TAG-CGI-INFO-NR-START","paragraph_zero_based":15968},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15969},{"literal_text_all_w_t_and_m_t":"CGI-InfoNR ::=                    SEQUENCE {","paragraph_zero_based":15970},{"literal_text_all_w_t_and_m_t":"    plmn-IdentityInfoList               PLMN-IdentityInfoList               OPTIONAL,","paragraph_zero_based":15971},{"literal_text_all_w_t_and_m_t":"    frequencyBandList                   MultiFrequencyBandListNR            OPTIONAL,","paragraph_zero_based":15972},{"literal_text_all_w_t_and_m_t":"    noSIB1                              SEQUENCE {","paragraph_zero_based":15973},{"literal_text_all_w_t_and_m_t":"        ssb-SubcarrierOffset                INTEGER (0..15),","paragraph_zero_based":15974},{"literal_text_all_w_t_and_m_t":"        pdcch-ConfigSIB1                    PDCCH-ConfigSIB1","paragraph_zero_based":15975},{"literal_text_all_w_t_and_m_t":"    }                                                                       OPTIONAL,","paragraph_zero_based":15976},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":15977},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":15978},{"literal_text_all_w_t_and_m_t":"    npn-IdentityInfoList-r16            NPN-IdentityInfoList-r16            OPTIONAL","paragraph_zero_based":15979},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":15980},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":15981},{"literal_text_all_w_t_and_m_t":"    cellReservedForOtherUse-r16         ENUMERATED {true}                   OPTIONAL","paragraph_zero_based":15982},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":15983}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["8c261fc56efb57dbcccc000dee5c298cbe3b67aca3cbcddc5dd9d264f37dd085","9cd92bfb3f3b528f9743dbe9d35cf22b2bf87fc005d14be5ad7b5f85dacb7c98","20b0c8cb7ff32ffe5baeb21f9384ffdbcb3fa204c2adc8c0717f4c11e5c69013","f2b148f08c91adde0b92eeba1c21ddc93bff51f144277ac3145b83cb5fc02e11","fdcd3c29ffb01eebf04241bb049f5f84697dbdb9474b0155314e43f79668a46a","4c577164bef97428b5b6dbd518c1525223b09214152081081fcd6b5d54f55855","d0b80736278962fa887e55a764cdc12b2b4790ed4bee7fdc1a7d1ec5879257d8","0c0bfad48e7de8d210015f9386ebbe2298f1f7714179c08503343ba718168a97","0f8f88f3401f67cd3ff058c94e7dda517e212bb61b776ff4acf1edc7e29d4db5","c08a4194115e15a7