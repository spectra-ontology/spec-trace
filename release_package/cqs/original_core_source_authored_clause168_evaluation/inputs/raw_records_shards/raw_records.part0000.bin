igIdle-NR-r16  ::=   SEQUENCE {","paragraph_zero_based":19646},{"literal_text_all_w_t_and_m_t":"    reportQuantityRS-Indexes-r16     ENUMERATED {rsrp, rsrq, both},","paragraph_zero_based":19647},{"literal_text_all_w_t_and_m_t":"    maxNrofRS-IndexesToReport-r16    INTEGER (1.. maxNrofIndexesToReport),","paragraph_zero_based":19648},{"literal_text_all_w_t_and_m_t":"    includeBeamMeasurements-r16      BOOLEAN","paragraph_zero_based":19649},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":19650},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19651},{"literal_text_all_w_t_and_m_t":"RSRQ-RangeEUTRA-r16 ::=   INTEGER (-30..46)","paragraph_zero_based":19652},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19653},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASIDLECONFIG-STOP","paragraph_zero_based":19654},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":19655}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["41bdda930a2664115669026c1691a58ae65770ebdd2baa7723bdba9571d2fb35","faa48b2c3a585bac4dc3a0970ec71c62a45aa7adf42cb631750a1c423e7ed3bd","c1d0e3c16b24d5a831982d2aa0917a3b77525584925399ad971fc9a70eaeff22","0bccb2c78ed7d805eca155983fca6d132c3fa9a970b760dd6307f9fe730887e6","5da10f2feec47909492f31d00cce014052205a33bc48a8fb81e8370bdc14a2c3","2b76b27fee280b71730c9af8fd17856a5c1e67788859911a99a1002ff7eef0a1","b08737b87cfa0dfe61de75b901a24b9abda9256109c4e670641f3e71c208c8fa","80956d23d3bd49eedc563b7e25a86840ef160ac5c743ab0ed5c79dd3d58c66e9","8a8b41bab4059dd747cbe5b88870071b381367f15cd59cadbe020571216f9737","813b12bcfade8c61c7a49f77862c5a175c668a52c9f3380d1035df0d3c1d27ae","419e61f295b43b9a65ca08aa551da22ebd1de2ae44175400a30affecc6577d