{"fields":{"filename":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":2688},{"literal_text_all_w_t_and_m_t":"SL-SRAP-ConfigPC5 field descriptions","paragraph_zero_based":2689},{"literal_text_all_w_t_and_m_t":"sl-RemoteUE-LocalIdentity","paragraph_zero_based":2690},{"literal_text_all_w_t_and_m_t":"Indicates the local UE ID of the L2 U2U Remote UE used in SRAP as specified in TS 38.351 [66].","paragraph_zero_based":2691},{"literal_text_all_w_t_and_m_t":"sl-RemoteUE-L2Identity","paragraph_zero_based":2692},{"literal_text_all_w_t_and_m_t":"Indicates the Source Layer-2 ID of the L2 U2U Remote UE as specified in TS 23.304 [65].","paragraph_zero_based":2693},{"literal_text_all_w_t_and_m_t":"sl-PeerRemoteUE-LocalIdentity","paragraph_zero_based":2694},{"literal_text_all_w_t_and_m_t":"Indicates the local UE ID of the peer L2 U2U Remote UE used in SRAP as specified in TS 38.351 [66].","paragraph_zero_based":2695},{"literal_text_all_w_t_and_m_t":"sl-PeerRemoteUE-L2Identity","paragraph_zero_based":2696},{"literal_text_all_w_t_and_m_t":"Indicates the Source Layer-2 ID of the peer L2 U2U Remote UE as specified in TS 23.304 [65].","paragraph_zero_based":2697},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2698},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2699},{"literal_text_all_w_t_and_m_t":"6.4RRC multiplicity and type constraint values","paragraph_zero_based":2700},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2701},{"literal_text_all_w_t_and_m_t":"<<Skip Unchanged>>","paragraph_zero_based":2702},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2703},{"literal_text_all_w_t_and_m_t":"6.5Short Message","paragraph_zero_based":2704},{"literal_text_all_w_t_and_m_t":"Short Messages can be transmitted on PDCCH using P-RNTI with or without associated Paging mes