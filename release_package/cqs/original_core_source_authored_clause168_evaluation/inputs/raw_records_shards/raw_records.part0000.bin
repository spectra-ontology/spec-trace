{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18960},{"literal_text_all_w_t_and_m_t":"-- TAG-LBT-FAILURERECOVERYCONFIG-START","paragraph_zero_based":18961},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18962},{"literal_text_all_w_t_and_m_t":"LBT-FailureRecoveryConfig-r16 ::=    SEQUENCE {","paragraph_zero_based":18963},{"literal_text_all_w_t_and_m_t":"    lbt-FailureInstanceMaxCount-r16      ENUMERATED {n4, n8, n16, n32, n64, n128},","paragraph_zero_based":18964},{"literal_text_all_w_t_and_m_t":"    lbt-FailureDetectionTimer-r16        ENUMERATED {ms10, ms20, ms40, ms80, ms160, ms320},","paragraph_zero_based":18965},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":18966},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18967},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18968},{"literal_text_all_w_t_and_m_t":"-- TAG-LBT-FAILURERECOVERYCONFIG-STOP","paragraph_zero_based":18969},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18970},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18971},{"literal_text_all_w_t_and_m_t":"LBT-FailureRecoveryConfig field descriptions","paragraph_zero_based":18972},{"literal_text_all_w_t_and_m_t":"lbt-FailureDetectionTimer","paragraph_zero_based":18973},{"literal_text_all_w_t_and_m_t":"Timer for consistent uplink LBT failure detection (see TS 38.321 [3]). Value ms10 corresponds to 10 ms, value ms20 corresponds to 20 ms, and so on.","paragraph_zero_based":18974},{"literal_text_all_w_t_and_m_t":"lbt-FailureInstanceMaxCount","paragraph_zero_based":18975},{"literal_text_all_w_t_and_m_t":"This field determines after how many LBT failure indications received from the physical layer the UE triggers uplink LBT failure recovery (see TS 38.321 [3]). Value n4 corresponds to 4, value n8 corresponds to 8, and so on.","paragraph_zero_based":18976},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18977},{"literal_text_all_w_t_and_m_t":"–LocationInfo","paragraph_zero_based":18978},{"literal_text_all_w_t_and_m_t":"The IE LocationInfo is used to transfer available detailed location information, Bluetooth, WLAN and sensor available measurement results at the UE.","paragraph_zero_based":18979},{"literal_text_all_w_t_and_m_t":"LocationInfo information element","paragraph_zero_based":18980},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18981},{"literal_text_all_w_t_and_m_t":"-- TAG-LOCATIONINFO-START","paragraph_zero_based":18982},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18983}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["88d7a1e26e667f6a855f268bb4037cc5155d6b725030b3e50790b9ee859aae8e","04aa3d79fcdef18159c3a836ae41fbc201ac9d873f7f822b97a86c1d58898ff3","7241bd2f7429115e1eee9e7769974527f193aa73dc499500273c7dbfe32014f3","56fe8f287b80d76e8222637491323e1a9738a634e0e686b00b4155ea55465127","fe9838fdf7af78c8f4e2d96797c99e4d50807f70824788dba4a1c71b783b3ace","1a6c640485c875758842a86dcffe8a25ed7d0b488a941b7ca3ed5ec10dcb3e62","a78c7e4b1ca4c08b831348bce98587f8e7087dbb5a3e3d20f7d0fd3df362f140","5098b7aff938f7455786d5063a1b6c1f1dff0375b0b0b3b26ed9621ee55f56f9","79d7c245bdec2e2b4863736cff133dfc3a718a7bd89c3ddc51f6aba55b29dc30","ed76d4faa5f6d9f98fe19e0cead53b3504db54dd9dcec6cfe6353915133cd7c0","742539502a62068b6f19b28ddd197fb58fddef6dd355cada43aa1c6aafe9ae5b","ca2345c8841c589179097a036d402d04164c32fdf5ad93a7bb67e900283751ad","29eb159711631af5095fafe6e925fc78dd45cba79af7da9e3c46f81fd418a827","e0dc8a01976f5e2e