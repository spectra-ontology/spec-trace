literal_text_all_w_t_and_m_t":"        ssb-MeasurementTimingConfiguration      SSB-MTC,","paragraph_zero_based":44129},{"literal_text_all_w_t_and_m_t":"        ss-RSSI-Measurement                     SS-RSSI-Measurement                             OPTIONAL","paragraph_zero_based":44130},{"literal_text_all_w_t_and_m_t":"    }                                                                                           OPTIONAL,","paragraph_zero_based":44131},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":44132},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":44133},{"literal_text_all_w_t_and_m_t":"    ssb-ToMeasure                           SSB-ToMeasure                                       OPTIONAL,","paragraph_zero_based":44134},{"literal_text_all_w_t_and_m_t":"    physCellId                              PhysCellId                                          OPTIONAL","paragraph_zero_based":44135}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["4c9e071efa4fa3e2de35cf74f1366a141a7d6d1b3e10435b0b510e0c84bc4b2a","02fccdca83103234a9533d96d01234304e34a4ed7f5e502d69d89a535a3f8268","5fe79bddc45cb3a3737a390690ab00c3367733e2ae7397a83a6724c289488bf8","82c896fd9bf6e1cb4bfc077f57acaf444b53b7e27bc0a6bdb5919d5faa30d962","f404e23bfb569045232268489c0fb047325937c1caf7b96d07af3a724cf7f4d4","b1056d6c0001f01317c45b05244e89a1e07127a5b8daccf2223ec22e5aeda268","730db769f1f0da1f003affdce425adb00ff8fc6d79b3c5541ae4a678424c33b7","7ddd5a37aa84a4abf980386acad0a09b15771b75b91574cbd00b5e969f36c5a4","3077a0f81549b04dfebe577a2376c1861d62bc070542a6609c9d88d31f421e15","bee5245394fcc2595b1c4ea60e56aa357962c0a25ff279ecb3ef4b98dd19661f","7d255dcab497763f741760c744e945549d43d9b77799b1e5f4a6133398aac840","c09992d7126461dbeccbe07cc792d0a099bbcc167461ef3e4e1874eafc647217","9c24c60ee64528ff212941f3953afc4b688e9a072de78bf587c9981f2135b12e","a787f231db8d873689f7c0a50c983c3173f5fce5344b8cb3dfb7501b84b0b73f","f0802fa3ee3ffd93c70160f83bdaf1acf4bc768ab202ffb628ecc72b43bca564","06c5e4e771c2882a19b311f7283851d2e1010efdd2466bb9b0cb98d3f905b5bd","e076c025c69307eedba34112dfbc11827897a9682a0c40888e482047392738b5","949ed9b6ad5ab4daddaa4d079b59207ff3856e9598914d85fcd7ea92f606f5ce","ea3995d17a883bd5f208bc1f4a32136541fa5e78afb8a0695144da9a3d828839","97a9a9f135d5d3e85689975f3a0e7770da1dad63151b660bb9d20e3ab3b9f0ba","f455bf6cb109b63b5be9d9e8403c843094bac5c4b6fb43f216ee532535a68fe8","009480ddd78362ef81d0905b69b50f867ad4533692a9c01dda3d9029362df888","4957a903b242fd3e02c9775080b9be390b7efb2c57c5eb68a6f700dd0961a59b","2d0c25f8d560bcd16eba77bebe1ad10c93f4b34226c2c8a7fb18510c2ddf5571"],"paragraph_range_zero_based":[44112,44135],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p44112"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":44136},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44137},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44138},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASUREMENT-TIMING-CONFIGURATION-STOP","paragraph_zero_based":44139},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44140},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44141},{"literal_text_all_w_t_and_m_t":"MeasTiming field descriptions","paragraph_zero_based":44142},{"literal_text_all_w_t_and_m_t":"carrierFreq, ssbSubcarrierSpacing","paragraph_zero_based":44143},{"literal_text_all_w_t_and_m_t":"Indicates the frequency and subcarrier spacing of the SS block of the cell for which this message is included, or of other SS blocks within the same carrier.","paragraph_zero_based":44144},{"literal_text_all_w_t_and_m_t":"ssb-MeasurementTimingConfiguration","paragraph_zero_based":44145},{"literal_text_all_w_t_and_m_t":"Indicates the SMTC which can be used to search for SSB of the cell for which the message is included. When the message is included in \"Served NR Cell Information\" (see TS 36.423 [37]), \"Served Cell Information NR\" (see TS 38.423 [35]), or \"Served Cell Information\" (see TS 38.473 [36]), the timing is based on the cell for which the message is included. When the message is included in \"NR Neighbour Information\" (see TS 36.423 [37]), or \"Served Cell Information\" (see TS 38.423 [35]), the timing is based on the cell indicated in the \"Served NR Cell Information\" or \"Served Cell Information NR\" with which the \"NR Neighbour Information\" or \"Neighbour Information NR\" is provided. When the message is included in \"CU to DU RRC Information\", the timing is based on the cell indicated by SpCell ID with which the message is included. If the field is provided by an NTN cell, the offset (derived from parameter periodicityAndOffset) is based on the assumption that the NTN payload to gNB propagation delay of the cell for which the message is included equals to 0 ms.","paragraph_zero_based":44146},{"literal_text_all_w_t_and_m_t":"ss-RSSI-Measurement","paragraph_zero_based":44147},{"literal_text_all_w_t_and_m_t":"Provides the configuration which can be used for RSSI measurements of the cell for which the message is included.","paragraph_zero_based":44148},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44149},{"literal_text_all_w_t_and_m_t":"MeasurementTimingConfiguration field descriptions","paragraph_zero_based":44150},{"literal_text_all_w_t_and_m_t":"campOnFirstSSB","paragraph_zero_based":44151},{"literal_text_all_w_t_and_m_t":"Value true indicates that the SSB indicated in the first instance of MeasTiming in the measTiming list can be used for camping and for a PCell configuration (i.e. in spCellConfigCommon of the masterCellGroup).","paragraph_zero_based":44152},{"literal_text_all_w_t_and_m_t":"csi-RS-CellMobility","paragraph_zero_based":44153},{"literal_text_all_w_t_and_m_t":"Indicates the CSI-RS configuration of the cell for which this message is included. The timing of the CSI-RS resources is based on the SSB indicated by refSSBFreq.","paragraph_zero_based":44154},{"literal_text_all_w_t_and_m_t":"csi-RS-SubcarrierSpacing","paragraph_zero_based":44155},{"literal_text_all_w_t_and_m_t":"Indicates the subcarrier spacing of the CSI-RS resources included in csi-rs-CellMobility.","paragraph_zero_based":44156},{"literal_text_all_w_t_and_m_t":"measTiming","paragraph_zero_based":44157},{"literal_text_all_w_t_and_m_t":"A list of SMTC information, SSB RSSI measurement information and associated NR frequency exchanged via EN-DC X2 Setup, EN-DC Configuration Update, Xn Setup and NG-RAN Node Configuration Update procedures, or F1 messages between gNB DU and gNB CU.","paragraph_zero_based":44158},{"literal_text_all_w_t_and_m_t":"physCellId","paragraph_zero_based":44159}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["d8ace3bb98b66e0bede5406729bed7136eabf11cdb4beb03ed0b147de102149a","7b6c012792c052bdd527e382dc1c079eeaab74d30d64d994cd6a44665cb10597","94aeeda036c26372473613043ca427b81cd7c7bf648599de8d36fa531b69d84f","68443729fc3d775a7312ff338f59f23061161b672ac7a4f5f4bb7ba2b3db1f0c","510df9903e6bd2500f00854fb0a9900da295764bc7dbaf5552cac8517e6e3a57","9a1f43bb3e02f1388b5347d702fbae7006a42a07f0e1016f0096fd1544040d11","fc3662f694e703bd2d94a201bae554ffb3b8b7b1ded07108eeb15451b787b2f1","c8adf31cf869ca1656558f8cbdcd554241e6f98751dbd0696456c7a2b945b128","e21a2c06f03b758c9dc801a3ea1d18dc0127c25173a719264cdf594b3eab0268","702732e56342774a7def4c65ee23800e127321a13cd831f280f24352c1bc99ab","0d65f5605343cfe7f72a08aa67d3693aab097b147ed3345507eb631db01c04a7","0a0cf1f9d6491f310d2cb5206f914c0534b6384789fdc85b60681478806fe40f","083060737775237c5eaaf94aa21373abed113cd8688adbd31ac2be41cc72fe23","81f6ed416746375f55605aff35ae0c9324486f4f63786a4a05e8e41c240e1095","e6329f3bc399e27093ef1bcc9f421e81784252c8bd9a241016bdd3ff1c29a71f","85cbc57f66274a6b9587f5753892eaa0676beb8b3426e47f1ecd622388450172","a8bc43020eae78d4ac55388ab207cf89d9bfb118312c72352f8903d1a101f4f0","e07d47f3624afe0d610a6471a88c1366fade5c58ea11659ef24f0059b4c6e3e2","61ea36ac53feca45f0e3adc350a25734702c80b871c419780f2d2c94d807ffef","860f4db1f30ae243110f9fe3d0aa4ed19fc6ef575e476610c8f71d856978210a","adff9f297baee8023dbfa86df648c951bc8522af801a2b4656832de595e31d39","9f78964e3805911cfdba40182129cf088fb648a5c0a92e9870bee678af5f091a","eba97c4acc2eccf0df1d20e8bbc066c99717d60fdd7432e9a24431a946a814cb","a4cee