{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Value in ms. ms1 corresponds to 1 ms, ms2 corresponds to 2 ms, and so on.","paragraph_zero_based":18336},{"literal_text_all_w_t_and_m_t":"drx-SlotOffset","paragraph_zero_based":18337},{"literal_text_all_w_t_and_m_t":"Value in 1/32 ms. Value 0 corresponds to 0 ms, value 1 corresponds to 1/32 ms, value 2 corresponds to 2/32 ms, and so on.","paragraph_zero_based":18338},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18339},{"literal_text_all_w_t_and_m_t":"–DRX-ConfigSecondaryGroup","paragraph_zero_based":18340},{"literal_text_all_w_t_and_m_t":"The IE DRX-ConfigSecondaryGroup is used to configure DRX related parameters for the second DRX group as specified in TS 38.321 [3].","paragraph_zero_based":18341},{"literal_text_all_w_t_and_m_t":"DRX-ConfigSecondaryGroup information element","paragraph_zero_based":18342},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18343},{"literal_text_all_w_t_and_m_t":"-- TAG-DRX-CONFIGSECONDARYGROUP-START","paragraph_zero_based":18344},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18345},{"literal_text_all_w_t_and_m_t":"DRX-ConfigSecondaryGroup-r16 ::=   SEQUENCE {","paragraph_zero_based":18346},{"literal_text_all_w_t_and_m_t":"    drx-onDurationTimer-r16            CHOICE {","paragraph_zero_based":18347},{"literal_text_all_w_t_and_m_t":"                                           subMilliSeconds INTEGER (1..31),","paragraph_zero_based":18348},{"literal_text_all_w_t_and_m_t":"                                           milliSeconds    ENUMERATED {","paragraph_zero_based":18349},{"literal_text_all_w_t_and_m_t":"                                               ms1, ms2, ms3, ms4, ms5, ms6, ms8, ms10, ms20, ms30, ms40, ms50, ms60,","paragraph_zero_based":18350},{"literal_text_all_w_t_and_m_t":"                                               ms80, ms100, ms200, ms300, ms400, ms500, ms600, ms800, ms1000, ms1200,","paragraph_zero_based":18351},{"literal_text_all_w_t_and_m_t":"                                               ms1600, spare8, spare7, spare6, spare5, spare4, spare3, spare2, spare1 }","paragraph_zero_based":18352},{"literal_text_all_w_t_and_m_t":"                                            },","paragraph_zero_based":18353},{"literal_text_all_w_t_and_m_t":"    drx-InactivityTimer-r16            ENUMERATED {","paragraph_zero_based":18354},{"literal_text_all_w_t_and_m_t":"                                           ms0, ms1, ms2, ms3, ms4, ms5, ms6, ms8, ms10, ms20, ms30, ms40, ms50, ms60, ms80,","paragraph_zero_based":18355},{"literal_text_all_w_t_and_m_t":"                                           ms100, ms200, ms300, ms500, ms750, ms1280, ms1920, ms2560, spare9, spare8,","paragraph_zero_based":18356},{"literal_text_all_w_t_and_m_t":"                                           spare7, spare6, spare5, spare4, spare3, spare2, spare1}","paragraph_zero_based":18357},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18358},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["928cbf7b192a52fb649443b5f6f183aee8dd44446a902fa3301cb3b28a1d7111","0228730d929f5c582ead5669deed090e852aeaee7268c8c3bc67ab014b73482e","d944ef3887a99d84b7c9f9117e5ed6f44e15cfbe29fca6cb2a2bfaf120507da3","3189b8e39d5bbc9939c0a3945d3d98d48609e110791626e4e5d15bdbc5cda1f6","f9b96d4b4a45148f42873ce51e17eaa800ef9f4aa24fe01bf70028d687e99363","7b729f793b0ff52e7d52b157cdc35f28e8a8e4e1f6c96ac982f76847f09793c0","885d14081523c4759b3d03