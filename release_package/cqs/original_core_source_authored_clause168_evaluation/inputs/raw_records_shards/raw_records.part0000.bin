_w_t_and_m_t":"","paragraph_zero_based":14298},{"literal_text_all_w_t_and_m_t":"MBS-FSAI-r17 ::= OCTET STRING (SIZE (3))","paragraph_zero_based":14299},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14300},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB21-STOP","paragraph_zero_based":14301},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":14302},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14303}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["1de47d3be00fe2b2b6ee1e3d37f1db98b90bfeb2840e99cb91f16b15f0803ccc","a15c171e4b81fb7213c523ebedc7b807e4b8c755ddc6642f189b9cdef1ff4079","d3456be54fe2f6ea2ada1ae92f9c71b61390c0c491fbe3656d3a5fba68bb045c","3f165bae3a4aa2bcbb1312ebe59fdbcc0a8321eda89b634405154d7344c3c70c","463993afe0b76a0af2b3e8f73193eb7784484aaec4862e9860252a1987c79770","0f67eb78fa7ac4600e726220559e4ca2a72a7a52c5eea639163012cf25c0fa56","22efe0d276573e2d1c5dc6fd89d83f346d0f0071ddabd359d539441b111e5212","b06e439bcbf5c956c80767ea192978c3d5e1c526d6608c0da98b548c46aed310","64cb7517b96670da739649a6bd1ea7f7f676223598ec15f2a7f81b60f10ec8ba","8e58ac3b976008aed81aaf7b60484b7e465488ee1e2bcc2bafdc2976bd43c794","c04928ceb6daa8293044a74cc29d9074daa1c8e704fdf964c759927a4ddc6195","66c75c7fa263db00a9eab759b2de405d0248a9f9b5071c08e499af007a226d5e","5a8a25c6e67a8c31d6eb73984fdb5face5027f06e5c34dce3d565347f9e5c73b","fd0f78bf8247920a3cf6c83225aa352e5349f1ff9cf3efa47eb174ad634ab9c2","73d304b2c80713902d11df878c20e94b1509c3e2115a2edc29ef4a58d7cd7a7f","dd7f858830ee805852ce91029f0043e62e72cea7a81e1c46c7b887bd6951a064","b3b69f913f1dbaef3ed6ca960231a6a3a2d39326885d9ed50ca8c5531d812253","e5f9f6926b65277a8c0bd3178784a5c559f0bb24ac2e348a5d8d53702a8c0b0b","