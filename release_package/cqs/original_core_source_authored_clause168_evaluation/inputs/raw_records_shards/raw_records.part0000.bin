{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"subframe = gapOffset mod 10;","paragraph_zero_based":4464},{"literal_text_all_w_t_and_m_t":"with T = MGRP/10 as defined in TS 38.133 [14];","paragraph_zero_based":4465},{"literal_text_all_w_t_and_m_t":"2>apply the specified timing advance mgta to the gap occurrences calculated above (i.e. the UE starts the measurement mgta ms before the gap subframe occurrences);","paragraph_zero_based":4466},{"literal_text_all_w_t_and_m_t":"1>else if gapFR1 is set to release:","paragraph_zero_based":4467},{"literal_text_all_w_t_and_m_t":"2>release the FR1 measurement gap configuration configured by gapFR1;","paragraph_zero_based":4468},{"literal_text_all_w_t_and_m_t":"1>if gapFR2 is set to setup:","paragraph_zero_based":4469},{"literal_text_all_w_t_and_m_t":"2>if an FR2 measurement gap configuration configured by gapFR2 is already setup, release the FR2 measurement gap configuration;","paragraph_zero_based":4470},{"literal_text_all_w_t_and_m_t":"2>setup the FR2 measurement gap configuration indicated by the gapFR2 in accordance with the received gapOffset, i.e., the first subframe of each gap occurs at an SFN and subframe meeting the following condition:","paragraph_zero_based":4471},{"literal_text_all_w_t_and_m_t":"SFN mod T = FLOOR(gapOffset/10);","paragraph_zero_based":4472},{"literal_text_all_w_t_and_m_t":"subframe = gapOffset mod 10;","paragraph_zero_based":4473},{"literal_text_all_w_t_and_m_t":"with T = MGRP/10 as defined in TS 38.133 [14];","paragraph_zero_based":4474},{"literal_text_all_w_t_and_m_t":"2>apply the specified timing advance mgta to the gap occurrences calculated above (i.e. the UE starts the measurement mgta ms before the gap subframe occurrences);","paragraph_zero_based":4475},{"literal_text_all_w_t_and_m_t":"1>else if gapFR2 is set to release:","paragraph_zero_based":4476},{"literal_text_all_w_t_and_m_t":"2>release the FR2 measurement gap configuration configured by gapFR2;","paragraph_zero_based":4477},{"literal_text_all_w_t_and_m_t":"1>if gapUE is set to setup:","paragraph_zero_based":4478},{"literal_text_all_w_t_and_m_t":"2>if a per UE measurement gap configuration configured by gapUE is already setup, release the per UE measurement gap configuration;","paragraph_zero_based":4479},{"literal_text_all_w_t_and_m_t":"2>setup the per UE measurement gap configuration indicated by the gapUE in accordance with the received gapOffset, i.e., the first subframe of each gap occurs at an SFN and subframe meeting the following condition:","paragraph_zero_based":4480},{"literal_text_all_w_t_and_m_t":"SFN mod T = FLOOR(gapOffset/10);","paragraph_zero_based":4481},{"literal_text_all_w_t_and_m_t":"subframe = gapOffset mod 10;","paragraph_zero_based":4482},{"literal_text_all_w_t_and_m_t":"with T = MGRP/10 as defined in TS 38.133 [14];","paragraph_zero_based":4483},{"literal_text_all_w_t_and_m_t":"2>apply the specified timing advance mgta to the gap occurrences calculated above (i.e. the UE starts the measurement mgta ms before the gap subframe occurrences);","paragraph_zero_based":4484},{"literal_text_all_w_t_and_m_t":"1>else if gapUE is set to release:","paragraph_zero_based":4485},{"literal_text_all_w_t_and_m_t":"2>release the per UE measurement gap configuration configured by gapUE.","paragraph_zero_based":4486},{"literal_text_all_w_t_and_m_t":"1>for each measGapId included in the received gapToReleaseList:","paragraph_zero_based":4487}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["f9d5efa3b20cce915aa46c30dae1165f826aebb25a341d3ef2d03a4fa7272579","cc5809b3643af845fce6b879e938dac747eaffe7ee75c3694a4994386aceca1e","5cdce1854e69358536186cd97522d36dd11796318ee3261790d1bd721ef26917","3c3133f8b4f7b35d102d2d2ebf3cca81c4490d06171874f1bc0e18987f404f37","7436eb33b460da41d11904296f8c3e2f73ef8094d66624d69e6e47c00d192223","9b697023afb9b05d43ffe22714f40a28d710497c32a6bbda96454bf5d98f0d6e","8002bb3367a561e264095a6743925076ad981b6211072b082ddeae7e9b224785","21c0b33ee354b5753ab87943387ac0cc35603d5b9bb6934380395ab5de6ab803","a865bd7271e27326de44c8e5c3f50655c60aecd9a4e49bd8c4d307c90cdd8965","8c30b52ef511e9846ea78c7063a1883fef22f405f9f07ec79bdecd37a7696849","acae38941bc0a4913cdcdaa0725288b2bace2e34c0ffe103ad29b41d29533d13","a0da24802d1521f56c046e032b6536e5eec36005c034cd3b4a5a345c6fd689da","7416db6d883c6e250a3450b97503dd467f5eb1309f10ac9accdb7b01f95b97cb","bfa528d8a6c3432f164131fad6621d9af8d522c1e39deb3ebc108fabe182a776","ba9d6e14e800c536e7f5b42b5ebae6888c46eabb1e0b76c6d5ea1bf368cc687d","58a60b79dce70afda5b25bb03bdd7c2e75aeb177b5a65b6257d8ac3b3b2604db","58f5795c92fcdf1ad14914a75369086c239f784d60575b2f8d44d35000bf2531","d2e560227cde0888bbeb81fd58a6552909e223c38efcc4c75a0c639c13a5859c","5f7be810f299e2431e8ed80583451a0ac6a94a19285cd836112872145d9e8c6d","587ab30715f79d9a79acf2fbd982c5cc5da39105a785b44ba504eac256ff8e78","182691ab76e08221a354b46955f5182b954c243d36c24033b26be63280f3eb15","080ebf76361e8579e2c7464fe0043cbb735005b5ca321311903179eee3f9f9f6","db847732b044b494997a00cfcdad7718bbc189f34b053000766de7ac3de230d5","02fb62ef5a44a47000225ac44575407d6d2243150e0557ed140d1bd325309983"],"paragraph_range_zero_based":[4464,4487],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p4464"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>release the measurement gap configuration associated with the measGapId;","paragraph_zero_based":4488},{"literal_text_all_w_t_and_m_t":"1>for each measPosPreConfigGapId included in the received posMeasGapPreConfigToReleaseList:","paragraph_zero_based":4489},{"literal_text_all_w_t_and_m_t":"2>release the measurement gap configuration associated with the measPosPreConfigGapId;","paragraph_zero_based":4490},{"literal_text_all_w_t_and_m_t":"1>for each GapConfig received in gapToAddModList:","paragraph_zero_based":4491},{"literal_text_all_w_t_and_m_t":"2>setup measurement gap configuration indicated by the GapConfig in accordance with the received gapOffset, i.e., the first subframe of each gap occurs at an SFN and subframe meeting the following condition:","paragraph_zero_based":4492},{"literal_text_all_w_t_and_m_t":"SFN mod T = FLOOR(gapOffset/10);","paragraph_zero_based":4493},{"literal_text_all_w_t_and_m_t":"subframe = gapOffset mod 10;","paragraph_zero_based":4494},{"literal_text_all_w_t_and_m_t":"with T = MGRP/10 as defined in TS 38.133 [14];","paragraph_zero_based":4495},{"literal_text_all_w_t_and_m_t":"2>apply the specified timing advance mgta to the gap occurrences calculated above (i.e. the UE starts the measurement mgta ms before the gap subframe occurrences);","paragraph_zero_based":4496},{"literal_text_all_w_t_and_m_t":"2>apply the measurement gap as per UE measurement gap, FR1 measurement gap, or FR2 measurement gap according to the gapType indicated by the GapConfig;","paragraph_zero_based":4497},{"literal_text_all_w_t_and_m_t":"2>associate the measurement gap with the measGapId indicated by the GapConfig;","paragraph_zero_based":4498},{"literal_text_all_w_t_and_m_t":"2>if gapSharing in the GapConfig is present:","paragraph_zero_based":4499},{"literal_text_all_w_t_and_m_t":"3>setup the gap sharing configuration for the measurement gap in accordance with the received gapSharing as defined in TS 38.133 [14];","paragraph_zero_based":4500},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":4501},{"literal_text_all_w_t_and_m_t":"3>release the gap sharing configuration (if configured) for the measurement gap;","paragraph_zero_based":4502},{"literal_text_all_w_t_and_m_t":"1>for each PosGapConfig received in PosMeasGapPreConfigToAddModList:","paragraph_zero_based":4503},{"literal_text_all_w_t_and_m_t":"2>if a measurement gap configuration associated with the measPosPreConfigGapId indicated by the PosGapConfig is already setup:","paragraph_zero_based":4504},{"literal_text_all_w_t_and_m_t":"3>release the measurement gap configuration;","paragraph_zero_based":4505},{"literal_text_all_w_t_and_m_t":"2>setup measurement gap configuration indicated by the PosGapConfig in accordance with the received gapOffset, i.e., the first subframe of each gap occurs at an SFN and subframe meeting the following condition:","paragraph_zero_based":4506},{"literal_text_all_w_t_and_m_t":"SFN mod T = FLOOR(gapOffset/10);","paragraph_zero_based":4507},{"literal_text_all_w_t_and_m_t":"subframe = gapOffset mod 10;","paragraph_zero_based":4508},{"literal_text_all_w_t_and_m_t":"with T = MGRP/10 as defined in TS 38.133 [14];","paragraph_zero_based":4509},{"literal_text_all_w_t_and_m_t":"2>apply the specified timing advance mgta to the gap occurrences calculated above (i.e. the UE starts the measurement mgta ms before the gap subframe occurrences);","paragraph_zero_based":4510},{"literal_text_all_w_t_and_m_t":"2>configure the measurement gap as indicated by gapType;","paragraph_zero_based":4511}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["bf4c0570652c6fb8c53982342a5228b37a7a74f766e41bc8bc0b73ccb9e6ad94","594a0ed9f0aa60b712f922476b7b94ad1f19883af6ec0a37e5394df66c1353c3","978ea60fb9f140590f7f1c863aa61b85017cf98b1587b28478dcdccc70d77777","469a8ce33b9a68c1ae0067b9dba9d29f559556e657e1419d370c87d69d80e246","25f03b6aa63af7be834ef3152284b865a186924720d90570f6565318c4e81bc7","a50d94a92e24c98ee1e0d0154647c2a4365fe71378ee3963cade9379de9aa427","7efee4b6d7a384592444ee2c086bb97a50db9d3ce1fcd53d84489e812fe9d324","72b4673e933178aaa9be3a4df4f7e58b8041ab8f31146ece707492a258921d32","2c07b559c06f89ca7e8d98af881c693e428a9d4a8ec685dfa84e809b50db02d4","646d09ef1162ed89c7bda98d8d2bea1693ce5e1c8a9f07e77724af6c0c489096","af802e66478fd5773f79746bcc482472c32e46c233e1a79e306f5f69dd16f614","78371f3fd2cb294ab76ac08809c2985844bd2865e7db08280c743ec9cdb67c1c","eeeb34a8558ea4d1ad4c37fcd122520e45b713b7867fc2130fd261d293b9d88a","f1da07b05a70bb31ac1dd9c5fe775211fea69618a6f34e0c7003a6b1dfea7d91","2bc3791a9ea38be174e8df5a1d54ca7c7fcbd5c8f7e2c94cabc26ab3ac7f0d8b","eeffca99d9cfec83cb4ba865c9c83535f54c91fbe19dafc494070ebd1b85457c","0116531198776086b439b1fc0dd88481eae0785fdc9fa05131e7d9506ea2b191","ac3a8d8096d9469af24615d687bf0b3037485d3f21b9183ceca83949a93464a7","7cfc0f5ef9a5cc04610c8c817d74d02449343adf6eb5c1e98d4fb3f3aa711f87","500d9608a346a758760fd116edb99a58d745807c80284368418c5a2c7a2b7a0f","e04a8ba6a83f2741d0e491823a2fd537ca68a8150414736ccad234f1d44072ee","8aabd02871036ee323b923b71b2d15fca10875034528ce58b488e97ea2ceedc3","6539f55cd1920c6e48ce114b31ec14ebca37111527ab981a09182e4021f2478b","813557a1faaebe2fb6ca1419afb58b8527b7ecb14c0916c3b29d82f277548b6e"],"paragraph_range_zero_based":[4488,4511],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p4488"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>for each FR1, FR2, and per UE measurement gap that is setup:","paragraph_zero_based":4512},{"literal_text_all_w_t_and_m_t":"2>if the measurement gap is configured by GapConfig and preConfigInd-r17 in the corresponding GapConfig is present:","paragraph_zero_based":4513},{"literal_text_all_w_t_and_m_t":"3>determine whether the measurement gap is activated or not according to TS 38.133 [14];","paragraph_zero_based":4514},{"literal_text_all_w_t_and_m_t":"2>else if the measurement gap is configured by PosGapConfig:","paragraph_zero_based":4515},{"literal_text_all_w_t_and_m_t":"3>consider the measurement gap to be deactivated;","paragraph_zero_based":4516},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":4517},{"literal_text_all_w_t_and_m_t":"3>consider the measurement gap to be activated.","paragraph_zero_based":4518},{"literal_text_all_w_t_and_m_t":"NOTE 1:For FR2 gap configuration with synchronous CA, for the UE in NE-DC or NR-DC, the SFN and subframe of the serving cell indicated by the refServCellIndicator is used in the gap calculation. Otherwise, the SFN and subframe of a serving cell on FR2 frequency is used in the gap calculation","paragraph_zero_based":4519},{"literal_text_all_w_t_and_m_t":"NOTE 2:For FR1 gap or per UE gap configuration, for the UE in NE-DC or NR-DC, the SFN and subframe of the serving cell indicated by the refServCellIndicator in is used in the gap calculation. Otherwise, the SFN and subframe of the PCell is used in the gap calculation.","paragraph_zero_based":4520},{"literal_text_all_w_t_and_m_t":"NOTE 3:For FR2 gap configuration with asynchronous CA, for the UE in NE-DC or NR-DC, the SFN and subframe of the serving cell indicated by the refServCellIndicator and refFR2ServCellAsyncCA is used in the gap calculation. Otherwise, the SFN and subframe of a serving cell on FR2 frequency indicated by the refFR2ServCellAsyncCA is used in the gap calculation","paragraph_zero_based":4521},{"literal_text_all_w_t_and_m_t":"5.5.2.10Reference signal measurement timing configuration","paragraph_zero_based":4522},{"literal_text_all_w_t_and_m_t":"The UE shall setup the first SS/PBCH block measurement timing configuration (SMTC) in accordance with the received periodicityAndOffset parameter (providing Periodicity and Offset value for the following condition) in the smtc1 configuration. The first subframe of each SMTC occasion occurs at an SFN and subframe of the NR SpCell meeting the following condition:","paragraph_zero_based":4523},{"literal_text_all_w_t_and_m_t":"SFN mod T = (FLOOR (Offset/10));","paragraph_zero_based":4524},{"literal_text_all_w_t_and_m_t":"if the Periodicity is larger than sf5:","paragraph_zero_based":4525},{"literal_text_all_w_t_and_m_t":"subframe = Offset mod 10;","paragraph_zero_based":4526},{"literal_text_all_w_t_and_m_t":"else:","paragraph_zero_based":4527},{"literal_text_all_w_t_and_m_t":"subframe = Offset or (Offset +5);","paragraph_zero_based":4528},{"literal_text_all_w_t_and_m_t":"with T = CEIL(Periodicity/10).","paragraph_zero_based":4529},{"literal_text_all_w_t_and_m_t":"If smtc2 is present, for cells indicated in the pci-List parameter in smtc2 in the same MeasObjectNR, the UE shall setup an additional SS/PBCH block measurement timing configuration (SMTC) in accordance with the received periodicity parameter in the smtc2 configuration and use the Offset (derived from parameter periodicityAndOffset) and duration parameter from the smtc1 configuration. The first subframe of each SMTC occasion occurs at an SFN and subframe of the NR SpCell meeting the above condition.","paragraph_zero_based":4530},{"literal_text_all_w_t_and_m_t":"If smtc2-LP is present, for cells indicated in the pci-List parameter in smtc2-LP in the same frequency (for intra frequency cell reselection) or different frequency (for inter frequency cell reselection), the UE shall setup an additional SS/PBCH block measurement timing configuration (SMTC) in accordance with the received periodicity parameter in the smtc2-LP configuration and use the Offset (derived from parameter periodicityAndOffset) and duration parameter from the smtc configuration for that frequency. The first subframe of each SMTC occasion occurs at an SFN and subframe of the NR SpCell or serving cell (for cell reselection) meeting the above condition.","paragraph_zero_based":4531},{"literal_text_all_w_t_and_m_t":"If smtc3list is present, for cells indicated in the pci-List parameter in each SSB-MTC3 element of the list in the same MeasObjectNR, the IAB-MT shall setup an additional SS block measurement timing configuration in accordance with the received periodicityAndOffset parameter (using same condition as smtc1 to identify the SFN and the subframe for SMTC occasion) in each SSB-MTC3 configuration and use the duration and ssb-ToMeasure parameters from each SSB-MTC3 configuration.","paragraph_zero_based":4532},{"literal_text_all_w_t_and_m_t":"If smtc4list is present, for cells indicated in the pci-List parameter in each SSB-MTC4 element of the list in the same MeasObjectNR, the UE shall setup an additional SS/PBCH block measurement timing configuration (SMTC) in accordance with the received offset parameter in each SSB-MTC4 configuration and use the duration parameter and periodicity (derived from parameter periodicityAndOffset) from the smtc1 configuration. The first subframe of each SMTC occasion occurs at an SFN and subframe of the NR SpCell meeting the above condition.","paragraph_zero_based":4533},{"literal_text_all_w_t_and_m_t":"On the indicated ssbFrequency, the UE shall not consider SS/PBCH block transmission in subframes outside the SMTC occasion for RRM measurements based on SS/PBCH blocks and for RRM measurements based on CSI-RS except for SFTD measurement (see TS 38.133 [14], clause 9.3.8).","paragraph_zero_based":4534},{"literal_text_all_w_t_and_m_t":"5.5.2.10aRSSI measurement timing configuration","paragraph_zero_based":4535}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["9f07ca98811d8a85502cbb0be0788324fe854230b4d7645fd4395aed1a0f6166","cd27c1b8f89973839dd94b7c5b9fa868adeeb1909f975c27562d9673682a13cc","4339eebeac922f3acf66e1d2f51202fbd54f6da0e8d37b746fa9cd22b3e561f3","0d55409a06c57c093b11798980b38c4f150d14e87a914afc616381fb94057803","0acd3f1e15f321d2ee1fdbe15843e0761fd498574469356d25e0265b5eb33d65","d4bd6668072e606e4fead8a82672f9285b58d3f9212cfa4b7a9ffebc9b87930d","af08e6f1dad40258111d7e35d97fb494543d98e80e776f35e7b3d63d82604f36","0a70d555fe82f4e117f1e8c318eb281ee85ebcef50f2d899cb52b13089bac1ca","a5d147f7bed3ff1a9c56bb3e03225d326b419bbaa5b63c831b312c836e70bc0f","cb7f082a75b46b224bef4d004a0f3afda34ec146471ad6f991dc3c87c30ba619","bbc1a65c9bc27e7c98f47028858283ef08e94f509956558175d53243b98c3e6e","1e05a4c6e40c8f02cc3a3a644051b411afc4a6e7fd07dcdd0b6c1baa8a76c253","957b2d6b470703d925d877f7e780930bcc0ce781bfa832625e79401af8a38a52","009b0d025a392b7d7273dc7dd0b408029975495258bd8176ab2945f9f2569ed2","2c68673521370ac87a2014767d947f60b8ef9822b89c5bf2c9a52354dd968ad0","88f939618dda86a47957b2196f6ab6722c14ad9ce698ad433217a4b86d97c248","75211dbf8fec30bec6148a03afa5370f56c7209b9d8bde60258fe0956aff1dde","f6d320020e66839bbdf48927db44866210ca14ece683e0da665c513976591686","b288b548d1223f03e5d16151b38db263b6e19dc4188cc9f6fb9c756a30fbab8d","fab4fbbf0501c67a1e8fac6e6b19f6e00dec4ee4d231b7b3b85d4ef5c6e91985","94e50f7c55af8cc7eab53db493f9625844fdd674f90a6c14c1cac3cf2f625099","18ecd01786c1a17dbd5d36c3472bd78ea974c0a2e0402a49cc8865c18eb14f58","828c8a75a6fe3c9b648494ad1abc098be017f240d33b3d0cebc22c957d98197f","c3cf5c6badf871ceba2006c2e3ec299d2ab871158ae08f18ee87a0da67a63905"],"paragraph_range_zero_based":[4512,4535],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p4512"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The UE shall setup the RSSI measurement timing configuration (RMTC) in accordance with the received rmtc-Periodicity and, if configured, with rmtc-SubframeOffset i.e. the first symbol of each RMTC occasion occurs at first symbol of an SFN and subframe of the NR SpCell meeting the following condition:","paragraph_zero_based":4536},{"literal_text_all_w_t_and_m_t":"SFN mod T = FLOOR(rmtc-SubframeOffset/10);","paragraph_zero_based":4537},{"literal_text_all_w_t_and_m_t":"subframe = rmtc-SubframeOffset mod 10;","paragraph_zero_based":4538},{"literal_text_all_w_t_and_m_t":"with T = rmtc-Periodicity/10;","paragraph_zero_based":4539},{"literal_text_all_w_t_and_m_t":"On the frequency configured by rmtc-Frequency, the UE shall not consider RSSI measurements outside the configured RMTC occasion which lasts for measDurationSymbols for RSSI and channel occupancy measurements.","paragraph_zero_based":4540},{"literal_text_all_w_t_and_m_t":"The UE derives the RSSI measurement duration from a combination of measDurationSymbols and ref-SCS-CP. At least for RSSI measurement confined within the active DL BWP, the UE performs RSSI measurement using the numerology of the active DL BWP during the derived measurement duration. Otherwise, the numerology used by the UE for measurements is up to UE implementation. If configured, the UE performs RSSI measurements on a bandwidth in accordance with the received rmtc-Bandwidth. If configured, the UE performs RSSI measurements according to the TCI state configured by tci-StateId in the reference BWP configured by ref-BWPId of the reference serving cell configured by ref-ServCellId (see TS 38.133 [14], clause 9.2A.7 and clause 9.3A.8).If the UE has no serving cell in FR2-2 and configured with inter-frequency RSSI measurement in FR2-2, it is up to the UE implementation how to determine the spatial domain filter for the inter-frequency RSSI measurement in FR2-2.","paragraph_zero_based":4541},{"literal_text_all_w_t_and_m_t":"5.5.2.11Measurement gap sharing configuration","paragraph_zero_based":4542},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":4543},{"literal_text_all_w_t_and_m_t":"1>if gapSharingFR1 is set to setup:","paragraph_zero_based":4544},{"literal_text_all_w_t_and_m_t":"2>if an FR1 measurement gap sharing configuration configured by gapSharingFR1 is already setup:","paragraph_zero_based":4545},{"literal_text_all_w_t_and_m_t":"3>release the FR1 measurement gap sharing configuration configured by gapSharingFR1;","paragraph_zero_based":4546},{"literal_text_all_w_t_and_m_t":"2>setup the FR1 measurement gap sharing configuration indicated by the measGapSharingConfig in accordance with the received gapSharingFR1 as defined in TS 38.133 [14];","paragraph_zero_based":4547},{"literal_text_all_w_t_and_m_t":"1>else if gapSharingFR1 is set to release:","paragraph_zero_based":4548},{"literal_text_all_w_t_and_m_t":"2>release the FR1 measurement gap sharing configuration configured by gapSharingFR1;","paragraph_zero_based":4549},{"literal_text_all_w_t_and_m_t":"1>if gapSharingFR2 is set to setup:","paragraph_zero_based":4550},{"literal_text_all_w_t_and_m_t":"2>if an FR2 measurement gap sharing configuration configured by gapSharingFR2 is already setup:","paragraph_zero_based":4551},{"literal_text_all_w_t_and_m_t":"3>release the FR2 measurement gap sharing configuration configured by gapSharingFR2;","paragraph_zero_based":4552},{"literal_text_all_w_t_and_m_t":"2>setup the FR2 measurement gap sharing configuration indicated by the measGapSharingConfig in accordance with the received gapSharingFR2 as defined in TS 38.133 [14];","paragraph_zero_based":4553},{"literal_text_all_w_t_and_m_t":"1>else if gapSharingFR2 is set to release:","paragraph_zero_based":4554},{"literal_text_all_w_t_and_m_t":"2>release the FR2 measurement gap sharing configuration configured by gapSharingFR2.","paragraph_zero_based":4555},{"literal_text_all_w_t_and_m_t":"1>if gapSharingUE is set to setup:","paragraph_zero_based":4556},{"literal_text_all_w_t_and_m_t":"2>if a per UE measurement gap sharing configuration configured by gapSharingUE is already setup:","paragraph_zero_based":4557},{"literal_text_all_w_t_and_m_t":"3>release the per UE measurement gap sharing configuration configured by gapSharingUE;","paragraph_zero_based":4558},{"literal_text_all_w_t_and_m_t":"2>setup the per UE measurement gap sharing configuration indicated by the measGapSharingConfig in accordance with the received gapSharingUE as defined in TS 38.133 [14];","paragraph_zero_based":4559}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["2dac815f24fb6d2ea1e3cc8db9c4a85abc4c48efa9765a37232cac4d233f527e","0b45330f52e50295e6e6acbdce115dedb7778122f3e9eea3cbaa97e0032d0b51","0b3e656ffb2f07cb5f066e7f167df36bad29b5e977f5d004693ea91b397cf1ce","f4d89db6d88adc4cf18f3cc62ecbf2277e7f260a4d3dab8296a2927c851f7c10","ae6a3904c4b346d08c7e87b8a315eb4e954223a68b384faad5b9dab4a91b7021","216a305307556560c3670f631235f1ad782fbc56b7f836a602e81c37e5d3cba9","f3577f7dec7713ce4a9ba6fc1e22b317570df4695480ae78492a3e20610fe681","b0f6b86ca683e14277b33b800ce6cf994d1b0c42107b9a2f831e425a967d5c09","82e5bfdd8abe65a1f373ff826e791d98a3dfd8b35c87da0861706030615ab014","1b4cba4e925e1aee59becb7a97afa6f0101c865f35f73ea5e59b4a31f742cd00","bf8b74d020215350702a39560047d7b531510b4742e43839160705fe0317f561","a79fe344e900d2413c901a7dd7217b8766bd570534e71b94ec6f41129adaf8e3","3efe1e3139db027149647af1ab2bb5d95f9381b4a09f24f3f9c98670ba1429e3","92e84b02f3a4cca0844c91caa5bfd98af264a9061282a5792297cd0e9a815340","e0f5ffd7de8e990d25be96bbe10018714807fbc7e54990f19a2a05a96887e603","e7e7235b5e1c7ba328f9fc0e708ec441b2f54846f0a091f74c0a9a79b8dd8dca","697832a8e56908d37a917dd1eeea6d27c84484c2ba04fedfd0ca4c31f0c78bc7","9741a45d15668463dea7fe9550d2eb905ec29e7b7c00ac316f4682c32f5f814a","f761b8b7c76998431339c16d42915a0d9fe2158860fdf9462fdcc532cb271c6e","3af3202adee6bf3068bc3d2d5e0ceca4f0487bdbca6119fee712a46ba829e836","305507eb76b4980e3e6829ac4dc17550a9f83fae639e0c466c46a142a23bfa7f","92284701f2ff28c27dcd23980183bfa792ac7d1bf86f2b14cb3731a3f092d3d0","cf1ed86635fb563123f40b14701912a84615f6502bc45b97518947f49615eafd","1e63ccf62ec33fc7988b182e7142560f8e426acd8a0cc5e724282b9bddf03bd4"],"paragraph_range_zero_based":[4536,4559],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p4536"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>else if gapSharingUE is set to release:","paragraph_zero_based":4560},{"literal_text_all_w_t_and_m_t":"2>release the per UE measurement gap sharing configuration configured by gapSharingUE.","paragraph_zero_based":4561},{"literal_text_all_w_t_and_m_t":"5.5.3Performing measurements","paragraph_zero_based":4562},{"literal_text_all_w_t_and_m_t":"5.5.3.1General","paragraph_zero_based":4563},{"literal_text_all_w_t_and_m_t":"An RRC_CONNECTED UE shall derive cell measurement results by measuring one or multiple beams associated per cell as configured by the network, as described in 5.5.3.3. For all cell measurement results, except for RSSI, and CLI measurement results in RRC_CONNECTED, the UE applies the layer 3 filtering as specified in 5.5.3.2, before using the measured results for evaluation of reporting criteria, measurement reporting or the criteria to trigger conditional reconfiguration execution. For cell measurements, the network can configure RSRP, RSRQ, SINR, RSCP or EcN0 as trigger quantity. For CLI measurements, the network can configure SRS-RSRP or CLI-RSSI as trigger quantity. For cell and beam measurements, reporting quantities can be any combination of quantities (i.e. only RSRP; only RSRQ; only SINR; RSRP and RSRQ; RSRP and SINR; RSRQ and SINR; RSRP, RSRQ and SINR; only RSCP; only EcN0; RSCP and EcN0), irrespective of the trigger quantity, and for CLI measurements, reporting quantities can be either SRS-RSRP or CLI-RSSI. For conditional reconfiguration execution, the network can configure up to 2 quantities, both using same RS type. The UE does not apply the layer 3 filtering as specified in 5.5.3.2 to derive the CBR measurements. The UE does not apply the layer 3 filtering as specified in 5.5.3.2 to derive the Rx-Tx time difference measurements.","paragraph_zero_based":4564},{"literal_text_all_w_t_and_m_t":"The network may also configure the UE to report measurement information per beam (which can either be measurement results per beam with respective beam identifier(s) or only beam identifier(s)), derived as described in 5.5.3.3a. If beam measurement information is configured to be included in measurement reports, the UE applies the layer 3 beam filtering as specified in 5.5.3.2. On the other hand, the exact L1 filtering of beam measurements used to derive cell measurement results is implementation dependent.","paragraph_zero_based":4565},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":4566},{"literal_text_all_w_t_and_m_t":"1>whenever the UE has a measConfig, perform RSRP and RSRQ measurements for each serving cell for which servingCellMO is configured as follows:","paragraph_zero_based":4567},{"literal_text_all_w_t_and_m_t":"2>if the reportConfig associated with at least one measId included in the measIdList within VarMeasConfig contains an rsType set to ssb and ssb-ConfigMobility is configured in the measObject indicated by the servingCellMO:","paragraph_zero_based":4568},{"literal_text_all_w_t_and_m_t":"3>if the reportConfig associated with at least one measId included in the measIdList within VarMeasConfig contains a reportQuantityRS-Indexes and maxNrofRS-IndexesToReport and contains an rsType set to ssb:","paragraph_zero_based":4569},{"literal_text_all_w_t_and_m_t":"4>derive layer 3 filtered RSRP and RSRQ per beam for the serving cell based on SS/PBCH block, as described in 5.5.3.3a;","paragraph_zero_based":4570},{"literal_text_all_w_t_and_m_t":"3>derive serving cell measurement results based on SS/PBCH block, as described in 5.5.3.3;","paragraph_zero_based":4571},{"literal_text_all_w_t_and_m_t":"2>if the reportConfig associated with at least one measId included in the measIdList within VarMeasConfig contains an rsType set to csi-rs and CSI-RS-ResourceConfigMobility is configured in the measObject indicated by the servingCellMO:","paragraph_zero_based":4572},{"literal_text_all_w_t_and_m_t":"3>if the reportConfig associated with at least one measId included in the measIdList within VarMeasConfig contains a reportQuantityRS-Indexes and maxNrofRS-IndexesToReport and contains an rsType set to csi-rs:","paragraph_zero_based":4573},{"literal_text_all_w_t_and_m_t":"4>derive layer 3 filtered RSRP and RSRQ per beam for the serving cell based on CSI-RS, as described in 5.5.3.3a;","paragraph_zero_based":4574},{"literal_text_all_w_t_and_m_t":"3>derive serving cell measurement results based on CSI-RS, as described in 5.5.3.3;","paragraph_zero_based":4575},{"literal_text_all_w_t_and_m_t":"1>for each serving cell for which servingCellMO is configured, if the reportConfig associated with at least one measId included in the measIdList within VarMeasConfig contains SINR as trigger quantity and/or reporting quantity:","paragraph_zero_based":4576},{"literal_text_all_w_t_and_m_t":"2>if the reportConfig contains rsType set to ssb and ssb-ConfigMobility is configured in the servingCellMO:","paragraph_zero_based":4577},{"literal_text_all_w_t_and_m_t":"3>if the reportConfigcontains a reportQuantityRS-Indexes and maxNrofRS-IndexesToReport:","paragraph_zero_based":4578},{"literal_text_all_w_t_and_m_t":"4>derive layer 3 filtered SINR per beam for the serving cell based on SS/PBCH block, as described in 5.5.3.3a;","paragraph_zero_based":4579},{"literal_text_all_w_t_and_m_t":"3>derive serving cell SINR based on SS/PBCH block, as described in 5.5.3.3;","paragraph_zero_based":4580},{"literal_text_all_w_t_and_m_t":"2>if the reportConfig contains rsType set to csi-rs and CSI-RS-ResourceConfigMobility is configured in the servingCellMO:","paragraph_zero_based":4581},{"literal_text_all_w_t_and_m_t":"3>if the reportConfigcontains a reportQuantityRS-Indexes and maxNrofRS-IndexesToReport:","paragraph_zero_based":4582},{"literal_text_all_w_t_and_m_t":"4>derive layer 3 filtered SINR per beam for the serving cell based on CSI-RS, as described in 5.5.3.3a;","paragraph_zero_based":4583}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["518500c4a4de6d41d7ea1864bfc5a1b59299ad1cf39f966dfc54fd8d8595d473","2d9cf5700167262c03828a9230da85882ea0dd141ba57b634646f5b2a65a8bb1","b047a1d7f5dfb86cc5ba9ed00489af52cc9e2645968c4099387ed93776f78973","30033367acba48232601324540b38eecdda97723c9d9f8f1564198723be459f7","d2b7633bb60c4f6a30e7fc89f76da84f9f8c88b5c288eafc08daacc62aefe949","db3c8821547b7c269f0f4c598850d3f68b8af9660ce0a73b6d319220767ed09f","045cc312da1bae3083ab6d895b0d0a79be984a75d3e4378a827b56f09aee6a0c","c2127dea4ed148f654a3db1f8db0aad28cf55ffcbbcb10f302637fcd62e47189","da89715f617d6e585b902fcbe596275d79416de108492ba242eb633213759a36","6a9d8b4e2af739b407846869b27e4b2b124fa4ecc547316c8922d061516c586d","bf2ca2dfc801212f47569f23ad9789399d4bb7b37fbe5623f2eb76fe22a36205","c36ee5725d392844b8419dc046dc69f1d4052c3a4ea1e9cd4924710d3fd08ca0","09ce6cebcfb625211ac0d87374836fb961cd7219915a01b841db5a34e371452b","8e3102896b8dcf6dc4b714903189d7a03c7f28c2927497070773e0018c01bdb9","7296bff086898a225cb2b9bb3a86c9c171132097fc80a7fe1d2372618c793737","16d322c5126b7144f716e3e7fc4d8f820e7423e903ab21316b25ac36e40f465b","4961ef439e83a47f41b36af44d7283ac03daccda1a5b756901161a0fd1c97096","a655040be4a3c9a2f1e07bcdaafeda2d8eca0c67222852c870644106ffef309c","32c7c286dca4d878525f593da761ed6bfc8da046d06720b4f6c545adbd52e251","3abe5244b94b00bee4a38e650e82fa18223210423b63066eb77f3eca26668e36","850190284ad8b2bcbd7ead411729f09ddd31140f2c624b3bede78e3326e3ad3d","2def0b8228efc79cda5b360047347c13a22bd11d5d1f0e17d9868a761225b6df","788e4b46135f7c7cc53d2eba68788796027db93e70ea99b8fe6f193f7d36df17","14ff16b03f522c41513783f0a922f3fdc4f86051b81095ce016748232d7aa4ac"],"paragraph_range_zero_based":[4560,4583],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p4560"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>derive serving cell SINR based on CSI-RS, as described in 5.5.3.3;","paragraph_zero_based":4584},{"literal_text_all_w_t_and_m_t":"1>for each measId included in the measIdList within VarMeasConfig:","paragraph_zero_based":4585},{"literal_text_all_w_t_and_m_t":"2>if the reportType for the associated reportConfig is set to reportCGI and timer T321 is running:","paragraph_zero_based":4586},{"literal_text_all_w_t_and_m_t":"3>if useAutonomousGaps is configured for the associated reportConfig:","paragraph_zero_based":4587},{"literal_text_all_w_t_and_m_t":"4>perform the corresponding measurements on the frequency and RAT indicated in the associated measObject using autonomous gaps as necessary;","paragraph_zero_based":4588},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":4589},{"literal_text_all_w_t_and_m_t":"4>perform the corresponding measurements on the frequency and RAT indicated in the associated measObject using available idle periods;","paragraph_zero_based":4590},{"literal_text_all_w_t_and_m_t":"3>if the cell indicated by reportCGI field for the associated measObject is an NR cell and that indicated cell is broadcasting SIB1 (see TS 38.213 [13], clause 13):","paragraph_zero_based":4591},{"literal_text_all_w_t_and_m_t":"4>try to acquire SIB1 in the concerned cell;","paragraph_zero_based":4592},{"literal_text_all_w_t_and_m_t":"3>if the cell indicated by reportCGI field is an E-UTRA cell:","paragraph_zero_based":4593},{"literal_text_all_w_t_and_m_t":"4>try to acquire SystemInformationBlockType1 in the concerned cell;","paragraph_zero_based":4594},{"literal_text_all_w_t_and_m_t":"2>if the ul-DelayValueConfig is configured for the associated reportConfig:","paragraph_zero_based":4595},{"literal_text_all_w_t_and_m_t":"3>ignore the measObject;","paragraph_zero_based":4596},{"literal_text_all_w_t_and_m_t":"3>for each of the configured DRBs, configure the PDCP layer to perform corresponding average UL PDCP packet delay measurement per DRB;","paragraph_zero_based":4597},{"literal_text_all_w_t_and_m_t":"2>if the ul-ExcessDelayConfig is configured for the associated reportConfig:","paragraph_zero_based":4598},{"literal_text_all_w_t_and_m_t":"3>ignore the measObject;","paragraph_zero_based":4599},{"literal_text_all_w_t_and_m_t":"3>for each of the configured DRBs, configure the PDCP layer to perform corresponding UL PDCP Excess Packet Delay delay measurement according to the configured threshold per DRB;","paragraph_zero_based":4600},{"literal_text_all_w_t_and_m_t":"2>if the reportType for the associated reportConfig is periodical, eventTriggered; or","paragraph_zero_based":4601},{"literal_text_all_w_t_and_m_t":"2>if the reportType for the associated reportConfig is condTriggerConfig, the measId is within the MCG VarMeasConfig and is indicated in the condExecutionCond associated to a condReconfigId in the MCG VarConditionalReconfig (for CHO, CPA or MN-initiated inter-SN CPC in NR-DC); or","paragraph_zero_based":4602},{"literal_text_all_w_t_and_m_t":"2>if the reportType for the associated reportConfig is condTriggerConfig, the measId is within the SCG VarMeasConfig and is indicated in the condExecutionCond associated to a condReconfigId in the SCG VarConditionalReconfig (for intra-SN CPC); or","paragraph_zero_based":4603},{"literal_text_all_w_t_and_m_t":"2>if the reportType for the associated reportConfig is condTriggerConfig, the measId is within the SCG VarMeasConfig and is indicated in the condExecutionCondSCG associated to a condReconfigId in the MCG VarConditionalReconfig (for SN-initiated inter-SN CPC in NR-DC); or","paragraph_zero_based":4604},{"literal_text_all_w_t_and_m_t":"2>if the reportType for the associated reportConfig is condTriggerConfig, the measId is within the SCG VarMeasConfig and is indicated in the triggerConditionSN associated to a condReconfigurationId in VarConditionalReconfiguration as specified in TS 36.331 [10] (for SN-initiated inter-SN CPC in EN-DC):","paragraph_zero_based":4605},{"literal_text_all_w_t_and_m_t":"3>if a measurement gap configuration is setup, or","paragraph_zero_based":4606},{"literal_text_all_w_t_and_m_t":"3>if the UE does not require measurement gaps to perform the concerned measurements:","paragraph_zero_based":4607}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["f73efae302755ad7d1588ad1864d5bbe6a05fa0aeda439cb93900681de245a77","4a7b6f5b077119a9b064a3581bd1e584d66cac623def477de4aca10453914572","8a7bff31fe58e6af5e0138f2ff2f5da6df2b7139265ac9cfc084e49f8f84f1bd","826a9a4fceb60fca34e1dedd9a401d0f85a54a62826c79c4663347a4a4cfb977","21214f9164fda8973a3b9c8053bbd0418bbcada5bedb5794510e61974c2ffce9","5c56e04f3dbddd2ed84ae502a6ac31861e52da6976dc7d53c66268d8d27af396","79269e783569dbba918a7fef5b9f3da7a99eab28c62b87f3f6f507e8d1d122fc","628083bc00564cb3d39ece3a3a8db1e951b2ec29b10c97d64ee7e9167fcd0183","be2030b9e797cc9bc8a32f08ae91acb355835d37d4e81aa58cce6f9b0b125274","4340321d92a81b94c83ce97fcd1dac735e959b8859ed21c894f0a54342478e66","0aac49ca7f884c0247000f9819c04ebbbdf695092aa742e9766332892c46b6d6","21408cff632f632882e36c7c738c28cf698f786c900cfa0756db7902f64b78a9","e7fa3b6cc677ac6c719f1e912d726bfe93318b7da04d54073c748f8b9f494f17","15a467cc3cd158843b6e1f4eb11cb981216c8df4c234a40e17103cb724d975c7","31c34bd62f958427d8c0dced0ca0f1ca456fb058b26953f16e7c161805c61f4a","a9fb5050002de2776e23098b2ed77d6fe22ef7af62c485690f27ea4a48d0938b","5be2596cec7a604482a4c0a443da01b796c451cdf023e082ba850548de363166","ab3ed07b6898b7918296e5e71008c4e5241363c1d635d4bd27e1ca47e1792ced","34a06932afe764ecc9ff216a3533f1b2c0a9aeb59a59f071efad8fe35106bee5","590f86cd48a5bfdca8233d66c9bd27253d62bd613893a45db46f7fcd24d0dd67","b541dc95b672d92ba6585e2c2c406822ff75ed795e3efb76e0b2f86919818efb","e4f0aa2d63218f655e4ef1869f29e9106058c06ee6be4a9a1e92a0d9e3005fe6","4d99f10175e2074597b019834dfc17d5ed7a3de05809d5b0c660d512ced81da1","e90d90cd26f9f267f1451b11458eb4a2bc9ed76332cc4caa1330164cbd4a35d7"],"paragraph_range_zero_based":[4584,4607],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p4584"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>if s-MeasureConfig is not configured, or","paragraph_zero_based":4608},{"literal_text_all_w_t_and_m_t":"4>if s-MeasureConfig is set to ssb-RSRP and the NR SpCell RSRP based on SS/PBCH block, after layer 3 filtering, is lower than ssb-RSRP, or","paragraph_zero_based":4609},{"literal_text_all_w_t_and_m_t":"4>if s-MeasureConfig is set to csi-RSRP and the NR SpCell RSRP based on CSI-RS, after layer 3 filtering, is lower than csi-RSRP:","paragraph_zero_based":4610},{"literal_text_all_w_t_and_m_t":"5>if the measObject is associated to NR and the rsType is set to csi-rs:","paragraph_zero_based":4611},{"literal_text_all_w_t_and_m_t":"6>if reportQuantityRS-Indexes and maxNrofRS-IndexesToReport for the associated reportConfig are configured:","paragraph_zero_based":4612},{"literal_text_all_w_t_and_m_t":"7>derive layer 3 filtered beam measurements only based on CSI-RS for each measurement quantity indicated in reportQuantityRS-Indexes, as described in 5.5.3.3a;","paragraph_zero_based":4613},{"literal_text_all_w_t_and_m_t":"6>derive cell measurement results based on CSI-RS for the trigger quantity and each measurement quantity indicated in reportQuantityCell using parameters from the associated measObject, as described in 5.5.3.3;","paragraph_zero_based":4614},{"literal_text_all_w_t_and_m_t":"5>if the measObject is associated to NR and the rsType is set to ssb:","paragraph_zero_based":4615},{"literal_text_all_w_t_and_m_t":"6>if reportQuantityRS-Indexes and maxNrofRS-IndexesToReport for the associated reportConfig are configured:","paragraph_zero_based":4616},{"literal_text_all_w_t_and_m_t":"7>derive layer 3 beam measurements only based on SS/PBCH block for each measurement quantity indicated in reportQuantityRS-Indexes, as described in 5.5.3.3a;","paragraph_zero_based":4617},{"literal_text_all_w_t_and_m_t":"6>derive cell measurement results based on SS/PBCH block for the trigger quantity and each measurement quantity indicated in reportQuantityCell using parameters from the associated measObject, as described in 5.5.3.3;","paragraph_zero_based":4618},{"literal_text_all_w_t_and_m_t":"5>if the measObject is associated to E-UTRA:","paragraph_zero_based":4619},{"literal_text_all_w_t_and_m_t":"6>perform the corresponding measurements associated to neighbouring cells on the frequencies indicated in the concerned measObject, as described in 5.5.3.2;","paragraph_zero_based":4620},{"literal_text_all_w_t_and_m_t":"5>if the measObject is associated to UTRA-FDD:","paragraph_zero_based":4621},{"literal_text_all_w_t_and_m_t":"6>perform the corresponding measurements associated to neighbouring cells on the frequencies indicated in the concerned measObject, as described in 5.5.3.2;","paragraph_zero_based":4622},{"literal_text_all_w_t_and_m_t":"5>if the measObject is associated to L2 U2N Relay UE:","paragraph_zero_based":4623},{"literal_text_all_w_t_and_m_t":"6>perform the corresponding measurements associated to candidate Relay UEs on the frequencies indicated in the concerned measObject, as described in 5.5.3.4;","paragraph_zero_based":4624},{"literal_text_all_w_t_and_m_t":"4>if the measRSSI-ReportConfig is configured in the associated reportConfig:","paragraph_zero_based":4625},{"literal_text_all_w_t_and_m_t":"5>perform the RSSI and channel occupancy measurements on the frequency configured by rmtc-Frequency in the associated measObject;","paragraph_zero_based":4626},{"literal_text_all_w_t_and_m_t":"NOTE 0:The network avoids configuring UEs supporting only CHO and/or Rel-16 CPC with measurements not referred to by any execution condition.","paragraph_zero_based":4627},{"literal_text_all_w_t_and_m_t":"2>if the reportType for the associated reportConfig is set to reportSFTD and the numberOfReportsSent as defined within the VarMeasReportList for this measId is less than one:","paragraph_zero_based":4628},{"literal_text_all_w_t_and_m_t":"3>if the reportSFTD-Meas is set to true:","paragraph_zero_based":4629},{"literal_text_all_w_t_and_m_t":"4>if the measObject is associated to E-UTRA:","paragraph_zero_based":4630},{"literal_text_all_w_t_and_m_t":"5>perform SFTD measurements between the PCell and the E-UTRA PSCell;","paragraph_zero_based":4631}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["20879f44915f8f2ac4e936f85c84616fd4b342dd39c51c25830779ee5ac003c9","b78e2f2784e0a2052954f2962646a63ef8f8a09f022348c731d76369f32ef9da","e52ae2b77963f442a7d486c61390bae4467ee8a49fd30eb91ee48d158e11341c","4abf659ab299ec6f9247062bbcf9c846cb7c08c4f5b85ed3ae2669a46486f7bc","0403c7234b36c5f6689c836afffa1489390aea0db22233ba582fb42e9cd4696a","e4943265be5144fe4c686db214a3599eefb2e46c0988a7b2674c181eb6377a52","fcd5285fed47cdaee1387f640aaf77c89ba16ce4d9d66a57bf99a159f93de793","d2e67fb1489864f169a794c080aa2e064463c2bd13d5ef562609206b6e667740","6de43ea75e47c8d86b8076175936867e3b0b16716d2f21896cc5e6d586503416","1b155efdd8115f090e0fb73e745df55fc3cad647b3ea31251f1bf8d0c02e7247","91420076409151c43ffc5e892c26a8001fc6a73b23ce147c71565ef64ec81abc","dabeb6e1080786e0a80b11c69a866eac41bc0230bbfb56fbff3384d37fed0c34","d6d4033f7ea6bca6fd1a871f2c6896e97a5417a434771c23af93c71c97f31969","3a932fa8974d481613f0d497264626214772e4eacf45df1d21580b6ffc91ad57","5cd97e7966c654ca4e032d4ceb6d64919887b489ac2ca5257af123bb86da403c","0cd36d48789ee58e209741c30391e2f26fc545d6f61c4ea3179295cbc82b7bf1","06aa5d8c44fb4c34709ab9b49d54dd1e8df50f74929eb7958a0e1d39a29c42d5","a4edbafbe00ba1f2c36734252bb6be31051f1ae6f4968b45563fe3c7de92db92","cee14012d1fba8325ad31550b8e2c0924475edd20fbd9ce661d138e84bda31d7","3f2fefeeb6a5a8d00b58a24b615edaa94e768be607cde8e327d0c50406874b86","64e87e81ab51ceb20e4871b1675a301c7df3cf853a7469dd5048fbde315ee153","e6773bad596e1e276c80de7d1d016b0595c61be5ff16dde06181d231b17dd59d","91167d6332ea8bf64c5799fdb31f1b7919e4e44504e4b1b75bd7b596a3d6d720","20d38f7262232a67c5c71fe53f9f17f1c01a5ac75fdcc3af25c393db90110930"],"paragraph_range_zero_based":[4608,4631],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p4608"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5>if the reportRSRP is set to true;","paragraph_zero_based":4632},{"literal_text_all_w_t_and_m_t":"6>perform RSRP measurements for the E-UTRA PSCell;","paragraph_zero_based":4633},{"literal_text_all_w_t_and_m_t":"4>else if the measObject is associated to NR:","paragraph_zero_based":4634},{"literal_text_all_w_t_and_m_t":"5>perform SFTD measurements between the PCell and the NR PSCell;","paragraph_zero_based":4635},{"literal_text_all_w_t_and_m_t":"5>if the reportRSRP is set to true;","paragraph_zero_based":4636},{"literal_text_all_w_t_and_m_t":"6>perform RSRP measurements for the NR PSCell based on SSB;","paragraph_zero_based":4637},{"literal_text_all_w_t_and_m_t":"3>else if the reportSFTD-NeighMeas is included:","paragraph_zero_based":4638},{"literal_text_all_w_t_and_m_t":"4>if the measObject is associated to NR:","paragraph_zero_based":4639},{"literal_text_all_w_t_and_m_t":"5>if the drx-SFTD-NeighMeas is included:","paragraph_zero_based":4640},{"literal_text_all_w_t_and_m_t":"6>perform SFTD measurements between the PCell and the NR neighbouring cell(s) detected based on parameters in the associated measObject using available idle periods;","paragraph_zero_based":4641},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":4642},{"literal_text_all_w_t_and_m_t":"6>perform SFTD measurements between the PCell and the NR neighbouring cell(s) detected based on parameters in the associated measObject;","paragraph_zero_based":4643},{"literal_text_all_w_t_and_m_t":"5>if the reportRSRP is set to true:","paragraph_zero_based":4644},{"literal_text_all_w_t_and_m_t":"6>perform RSRP measurements based on SSB for the NR neighbouring cell(s) detected based on parameters in the associated measObject;","paragraph_zero_based":4645},{"literal_text_all_w_t_and_m_t":"2>if the reportType for the associated reportConfig is cli-Periodical or cli-EventTriggered:","paragraph_zero_based":4646},{"literal_text_all_w_t_and_m_t":"3>perform the corresponding measurements associated to CLI measurement resources indicated in the concerned measObjectCLI;","paragraph_zero_based":4647},{"literal_text_all_w_t_and_m_t":"2>perform the evaluation of reporting criteria as specified in 5.5.4, except if reportConfig is condTriggerConfig.","paragraph_zero_based":4648},{"literal_text_all_w_t_and_m_t":"The UE acting as a L2 U2N Remote UE whenever configured with measConfig shall:","paragraph_zero_based":4649},{"literal_text_all_w_t_and_m_t":"1>perform the corresponding measurements associated to the serving L2 U2N Relay UE, as described in 5.5.3.4;","paragraph_zero_based":4650},{"literal_text_all_w_t_and_m_t":"NOTE 1:The evaluation of conditional reconfiguration execution criteria is specified in 5.3.5.13.","paragraph_zero_based":4651},{"literal_text_all_w_t_and_m_t":"The UE capable of Rx-Tx time difference measurement when configured with measObjectRxTxDiff shall:","paragraph_zero_based":4652},{"literal_text_all_w_t_and_m_t":"1>perform the corresponding Rx-Tx time difference measurements associated with downlink reference signals indicated in the concerned measObjectRxTxDiff.","paragraph_zero_based":4653},{"literal_text_all_w_t_and_m_t":"The UE capable of CBR measurement when configured to transmit NR sidelink communication/discovery shall:","paragraph_zero_based":4654},{"literal_text_all_w_t_and_m_t":"1>If the frequency used for NR sidelink communication/discovery is included in sl-FreqInfoToAddModList in sl-ConfigDedicatedNR within RRCReconfiguration message or included in sl-ConfigCommonNR within SIB12:","paragraph_zero_based":4655}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["ecf27e07c8b604c693487df756291a7f087872f1dcf289133fb0df7236902c9e","73d153bc67b4ff2f0cc10cb5d8e98f72af5be814db14e99c0910e5eb664ace38","cb8edd7a4564755ec4383344f7081edfd8362e0b34e6e61732616b83fd8dbafe","223c23ce3cd98c5fde632ba24312ba66cfee38cc87355b95b6b71888bddb0e4f","0166ca2db76bf3694ce43259cfcc47b52618f8255c3934caa13ff3b7abeae01e","2970e34a9c56b967ee3661f37fe52e28808d0f74f5e57aea546cf36d7204e998","4cf4cee47e2a1790a71a5fc64b83a7f5641268bf6316f290a38d8750d52add68","3acfa79290e20e5ab6ecffb8df482b74a788a945837250380cbcfc24ed6e8e28","d2e6997b0e503e42ccbce0aa597a06df3d569422136a3e1dd4b93a2c7cf9f8e1","0f3405df0d27d58007d631b2ad5d61bc75fb3ecf1a08203bcf1e81995eeac02c","e44e8c866dcf5e42f4b7bb4f1d2d1cd83159da70769f8d9e811ebfa9a05c96cc","24daeaf10e7c4bd926027aa88eb82b14a134d295625da5b673a1fe0aa0bf9eaa","67444409e229f75b145bb93f3f44b241a225432c1b3b8369551c9048ec9f3004","ca9221b3e8787d5579ca03f73964c8e91a78f5ac4df63c33501150c3152a8819","c243b09b011deebe6f0cec1784ea62f2261b6c6949e54d1e3ef670e71fd5767c","0d9aa97a74157d70205c5cb60d131892b62331c7c8d3bf7b29fbe0785228deb3","3d14bd4727cfad390e1405642fd3d0c33253ae05eb41d6e96da72970f190f514","eecf3ac32064f2a3dfc227c97cbee94ba4a549234c829c87548920a066a6918f","6a2d422abb0085f09fe013aaa1ecdc67a4ec0526e81c5a52aeb1f0bfc45d76f3","f1c1e10e152296c63f837e3d2434d012609542ab83df7db40c21b8d451e20faa","335ceac3995a5094b3018a739ca82354f57b014891b3319a6c5715636dd898ff","51138512c2748b4edffab4fdbddc02e5d50671f630853b787005ba3d77395910","a45d0fd75019e92cd8f837383d46509199abc7c3e39a62b96530f9d898f8c1ff","3478092094ab9f1db9209ddf4ec1c456fca4a5170490e8ae73f42c4babaaf46e"],"paragraph_range_zero_based":[4632,4655],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p4632"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if the UE is in RRC_IDLE or in RRC_INACTIVE:","paragraph_zero_based":4656},{"literal_text_all_w_t_and_m_t":"3>if configured with NR sidelink communication and the cell chosen for NR sidelink communication provides SIB12 which includes sl-TxPoolSelectedNormal or sl-TxPoolExceptional for the concerned frequency; or","paragraph_zero_based":4657},{"literal_text_all_w_t_and_m_t":"3>if configured with NR sidelink discovery and the cell chosen for NR sidelink discovery provides SIB12 which includes sl-TxPoolSelectedNormal or sl-TxPoolExceptional but does not include sl-DiscTxPoolSelected for the concerned frequency:","paragraph_zero_based":4658},{"literal_text_all_w_t_and_m_t":"4>perform CBR measurement on pool(s) in sl-TxPoolSelectedNormal or sl-TxPoolExceptional for the concerned frequency in SIB12;","paragraph_zero_based":4659},{"literal_text_all_w_t_and_m_t":"3>if configured with NR sidelink discovery and the cell chosen for NR sidelink discovery provides SIB12 which includes sl-DiscTxPoolSelected for the concerned frequency:","paragraph_zero_based":4660},{"literal_text_all_w_t_and_m_t":"4>perform CBR measurement on pools in sl-DiscTxPoolSelected and sl-TxPoolExceptional for the concerned frequency in SIB12;","paragraph_zero_based":4661},{"literal_text_all_w_t_and_m_t":"2>if the UE is in RRC_CONNECTED:","paragraph_zero_based":4662},{"literal_text_all_w_t_and_m_t":"3>if tx-PoolMeasToAddModList is included in VarMeasConfig:","paragraph_zero_based":4663},{"literal_text_all_w_t_and_m_t":"4>perform CBR measurements on each transmission resource pool indicated in the tx-PoolMeasToAddModList;","paragraph_zero_based":4664},{"literal_text_all_w_t_and_m_t":"3>if sl-DiscTxPoolSelected, sl-TxPoolSelectedNormal, sl-TxPoolScheduling or sl-TxPoolExceptional is included in sl-ConfigDedicatedNR for the concerned frequency within RRCReconfiguration:","paragraph_zero_based":4665},{"literal_text_all_w_t_and_m_t":"4>perform CBR measurement on pool(s) in sl-DiscTxPoolSelected, sl-TxPoolSelectedNormal, sl-TxPoolScheduling and sl-TxPoolExceptional if included in sl-ConfigDedicatedNR for the concerned frequency within RRCReconfiguration;","paragraph_zero_based":4666},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":4667},{"literal_text_all_w_t_and_m_t":"4>if configured with NR sidelink communication and the cell chosen for NR sidelink communication provides SIB12 which includes sl-TxPoolSelectedNormal or sl-TxPoolExceptional for the concerned frequency; or","paragraph_zero_based":4668},{"literal_text_all_w_t_and_m_t":"4>if configured with NR sidelink discovery and the cell chosen for NR sidelink discovery provides SIB12 which includes sl-TxPoolSelectedNormal or sl-TxPoolExceptional but does not provide sl-DiscTxPoolSelected for the concerned frequency:","paragraph_zero_based":4669},{"literal_text_all_w_t_and_m_t":"5>perform CBR measurement on pool(s) in sl-TxPoolSelectedNormal or sl-TxPoolExceptional for the concerned frequency in SIB12;","paragraph_zero_based":4670},{"literal_text_all_w_t_and_m_t":"4>if configured with NR sidelink discovery and the cell chosen for NR sidelink discovery provides SIB12 which includes sl-DiscTxPoolSelected for the concerned frequency:","paragraph_zero_based":4671},{"literal_text_all_w_t_and_m_t":"5>perform CBR measurement on pools in sl-DiscTxPoolSelected and sl-TxPoolExceptional for the concerned frequency in SIB12;","paragraph_zero_based":4672},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":4673},{"literal_text_all_w_t_and_m_t":"2>if configured with NR sidelink communication and sl-TxPoolSelectedNormal is included in SidelinkPreconfigNR for the concerned frequency; or","paragraph_zero_based":4674},{"literal_text_all_w_t_and_m_t":"2>if configured with NR sidelink discovery and sl-TxPoolSelectedNormal is included in SidelinkPreconfigNR but sl-DiscTxPoolSelected is not included in SidelinkPreconfigNR for the concerned frequency:","paragraph_zero_based":4675},{"literal_text_all_w_t_and_m_t":"3>perform CBR measurement on pool(s) in sl-TxPoolSelectedNormal in SidelinkPreconfigNR for the concerned frequency.","paragraph_zero_based":4676},{"literal_text_all_w_t_and_m_t":"2>if configured with NR sidelink discovery and sl-DiscTxPoolSelected is included in SidelinkPreconfigNR for the concerned frequency:","paragraph_zero_based":4677},{"literal_text_all_w_t_and_m_t":"3>perform CBR measurement on pools in sl-DiscTxPoolSelected if included in SidelinkPreconfigNR.","paragraph_zero_based":4678},{"literal_text_all_w_t_and_m_t":"NOTE 2:In case the configurations for NR sidelink communication and CBR measurement are acquired via the E-UTRA, configurations for NR sidelink communication in SIB12, sl-ConfigDedicatedNR within RRCReconfiguration used in this clause are provided by the configurations in SystemInformationBlockType28, sl-ConfigDedicatedForNR within RRCConnectionReconfiguration as specified in TS 36.331[10], respectively.","paragraph_zero_based":4679}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["87b7213efd9c616bdd4948756e78e0205d4ed9ea9deb4f30575098d2487db708","8b9fb2d63cc12ba66b160cdc1931803a9e80b8e557264487a1273b19ef1d98a0","59142171131398e7375a4caba5c44c932d438a8fc7eb6613bbf94749749cb528","9da641f252ac718ce45586d7d97c94c323bb5ceb244a8c39bb333689997bfdbf","d79283607829a5182bbc213a49f990d49d592bf11b63855b9281c09d614da2d3","347739145d2e05d4c995e7ac28c477f91e6bc7a40a8977153b0ca06f60590ba1","f86ac6c6b2bb01df86e943d882eee0be3dc94fd36cd536dce9229dbf153ccdde","545f754df1a6ac3e43d466cbb0ffa252ff5f391b3192cd122cb0923b3ee480d6","3dee5fc7382bc306d2770896fdd0a6f3c4d8b8c5e2f5fd699fe41acba9cbde70","c6d90a083ddbb78a8e176bfaa09ccb34abf5945263506af97a5f2f418a530f3e","279741270cae212dcad2feb14f12e60cb13362d18bd0ef1a3a764558ad01f43d","108457e1da82c98d9626127b99bd4b20a2b29e12b70b1094c7d21ad2896723be","ef6a53d66f281765bcab3fdc904d86d6b4f88764086b5ffcb79ed649cadfa395","1d423a4e40ce0499e0bbee2b7433e0fa10756ac12912eeaf73de87e92e35adfc","4884535fe3944b3116372369d7af08c6859ac9e020ff7e1b6e5132510fcf027f","f6924e810db7c8dbcd8a3fb98dd2d930a3cf893a7367b44608578c0b60a89278","8eb26e80397b1a9b46ba262d01365d48baffc3cf60fb8018f1f0f8bb0441a7b5","6940e895c07331aa110068ef90b0dd59e8a88c7f8bf49d07f5923ceca8286f4e","79de0076f317103448472e7d7d58418d74e1fdbfcc1b516c564b5bebf3cc16e6","28b16e4d221ee2f282cba765e991791d5749d096fb6adf267b7d58bdcbdaeef4","a9937b2b551c339cf23642df1788b6718a24eb70b4de19507aff3fcb7428b24b","4b936632e5533171432ba52b1a55919c66c55315c0b260bb01ae8fe657805268","3c20c7ac4d4352de9819242b81dd1cec18a6c2c7d4f3945823d583b197f0caa5","1b204702429b8c64c2bbf0991a7ba80efae3b0176b96efab12bad27bccb5ba00"],"paragraph_range_zero_based":[4656,4679],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p4656"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"NOTE 3:If a UE that is configured by upper layers to transmit V2X sidelink communication is configured by NR with transmission resource pool(s) and the measurement objects concerning V2X sidelink communication (i.e. by sl-ConfigDedicatedEUTRA-Info), it shall perform CBR measurement as specified in clause 5.5.3 of TS 36.331 [10], based on the transmission resource pool(s) and the measurement object(s) concerning V2X sidelink communication configured by NR.","paragraph_zero_based":4680},{"literal_text_all_w_t_and_m_t":"NOTE 4:For V2X sidelink communication, each of the CBR measurement results is associated with a resource pool, as indicated by the poolReportId (see TS 36.331 [10]), that refers to a pool as included in sl-ConfigDedicatedEUTRA-Info or SIB13.","paragraph_zero_based":4681},{"literal_text_all_w_t_and_m_t":"5.5.3.2Layer 3 filtering","paragraph_zero_based":4682},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":4683},{"literal_text_all_w_t_and_m_t":"1>for each cell measurement quantity, each beam measurement quantity, each sidelink measurement quantity as needed in clause 5.8.10, for each CLI measurement quantity that the UE performs measurements according to 5.5.3.1, for each candidate L2 U2N Relay UE measurement quantity according to 5.5.3.4, and for evaluating the detected NR sidelink U2N Relay UEs according to 5.8.15.3:","paragraph_zero_based":4684},{"literal_text_all_w_t_and_m_t":"2>filter the measured result, before using for evaluation of reporting criteria, for measurement reporting or for U2N Relay (re)selection evaluation, by the following formula:","paragraph_zero_based":4685},{"literal_text_all_w_t_and_m_t":"Fn = (1 – a)*Fn-1 + a*Mn","paragraph_zero_based":4686},{"literal_text_all_w_t_and_m_t":"where","paragraph_zero_based":4687},{"literal_text_all_w_t_and_m_t":"Mn is the latest received measurement result from the physical layer;","paragraph_zero_based":4688},{"literal_text_all_w_t_and_m_t":"Fn is the updated filtered measurement result, that is used for evaluation of reporting criteria, for measurement reporting or for U2N Relay (re)selection evaluation;","paragraph_zero_based":4689},{"literal_text_all_w_t_and_m_t":"Fn-1 is the old filtered measurement result, where F0 is set to M1 when the first measurement result from the physical layer is received; and for MeasObjectNR, a = 1/2(ki/4), where ki is the filterCoefficient for the corresponding measurement quantity of the i:th QuantityConfigNR in quantityConfigNR-List, and i is indicated by quantityConfigIndex in MeasObjectNR; for other measurements, a = 1/2(k/4), where k is the filterCoefficient for the corresponding measurement quantity received by the quantityConfig; for UTRA-FDD, a = 1/2(k/4), where k is the filterCoefficient for the corresponding measurement quantity received by quantityConfigUTRA-FDD in the QuantityConfig;","paragraph_zero_based":4690},{"literal_text_all_w_t_and_m_t":"2>adapt the filter such that the time characteristics of the filter are preserved at different input rates, observing that the filterCoefficient k assumes a sample rate equal to X ms; The value of X is equivalent to one intra-frequency L1 measurement period as defined in TS 38.133 [14] assuming non-DRX operation, and depends on frequency range.","paragraph_zero_based":4691},{"literal_text_all_w_t_and_m_t":"NOTE 1:If k is set to 0, no layer 3 filtering is applicable.","paragraph_zero_based":4692},{"literal_text_all_w_t_and_m_t":"NOTE 2:The filtering is performed in the same domain as used for evaluation of reporting criteria, for measurement reporting or for U2N Relay (re)selection evaluation, i.e., logarithmic filtering for logarithmic measurements.","paragraph_zero_based":4693},{"literal_text_all_w_t_and_m_t":"NOTE 3:The filter input rate is implementation dependent, to fulfil the performance requirements set in TS 38.133 [14]. For further details about the physical layer measurements, see TS 38.133 [14].","paragraph_zero_based":4694},{"literal_text_all_w_t_and_m_t":"NOTE 4:For CLI-RSSI measurement, it is up to UE implementation whether to reset filtering upon BWP switch.","paragraph_zero_based":4695},{"literal_text_all_w_t_and_m_t":"NOTE x:For SSB measurements when multiple altitude range-based ssb-ToMeasure are configured, it is up to UE implementation whether to reset filtering upon entering a different altitude range.","paragraph_zero_based":4696},{"literal_text_all_w_t_and_m_t":"5.5.3.3Derivation of cell measurement results","paragraph_zero_based":4697},{"literal_text_all_w_t_and_m_t":"The network may configure the UE in RRC_CONNECTED to derive RSRP, RSRQ and SINR measurement results per cell associated to NR measurement objects based on parameters configured in the measObject (e.g. maximum number of beams to be averaged and beam consolidation thresholds) and in the reportConfig (rsType to be measured, SS/PBCH block or CSI-RS).","paragraph_zero_based":4698},{"literal_text_all_w_t_and_m_t":"The network may configure the UE in RRC_IDLE or in RRC_INACTIVE to derive RSRP and RSRQ measurement results per cell associated to NR carriers based on parameters configured in measIdleCarrierListNR within VarMeasIdleConfig for measurements performed according to 5.7.8.2a.","paragraph_zero_based":4699},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":4700},{"literal_text_all_w_t_and_m_t":"1>for each cell measurement quantity to be derived based on SS/PBCH block:","paragraph_zero_based":4701},{"literal_text_all_w_t_and_m_t":"2>if nrofSS-BlocksToAverage is not configured in the associated measObject in RRC_CONNECTED or in the associated entry in measIdleCarrierListNR within VarMeasIdleConfig in RRC_IDLE/RRC_INACTIVE; or","paragraph_zero_based":4702},{"literal_text_all_w_t_and_m_t":"2>if absThreshSS-BlocksConsolidation is not configured in the associated measObject in RRC_CONNECTED or in the associated entry in measIdleCarrierListNR within VarMeasIdleConfig in RRC_IDLE/RRC_INACTIVE; or","paragraph_zero_based":4703}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["4ff44cf240eceb1ad2aa316d355d8411da241e47d9c920bfc96cca646cba8c56","bbc492919df9aa1e87ff2cd10d07ceb2ec1651924f4ce2157c8b0a71e4870ba3","d1398b9ed1c5554dd44f666ec004b44779abae8c4782fead13b7f12e162b1d58","6d03966d703770695d3de5280e0062df43e5685dbbea7d4861f09164d35ccff2","1ce4b98b7e215f24549715cd24d94310b86760f6c8833ad8d1ea0c223f37bfa0","559f30a37647b86caacf0083617d0de37cfc7c00c84c86c6d784236dbcb84b9b","c4e14db1d5744192bbb404b12da3ab2e1eeeadedc3d297d18f1774cc62aa0a03","412fd70503e8195eeb86376ec1bc10fed73fc58d34dbba5296b092e11f95d7d3","b21731f7e12d453c6129935008e20e81f9ba116579c7bb5f6b60264fa5f6b4e8","b81ca6f68ed2ae10797b1e68181074e3b4c251a995c32d3ea3eb069ce79bb097","01c1920f07594bb6e194886ec3b486f8213a42a5e5831591036a9167ed1afb82","e41fc27235546783d93d37d29bae8fef7d3c186baab6872a69ccafb41fd1415b","61bffc8efe5ac040c32adf8a408be7a072c8e316a3da458831222c5fbf17d562","e8c6fed09c1bdccff1918c9ae29864ff5cbb7084bbff9714f9cac9708c40c702","1ebbba4d012e15a514a0426c2e75f062005f89346c2c140b6b93ad104a0ec5f2","e57677646bfd7b1c97b2ec0e59503dcad016087815cebba0122499a1e8bd5ec9","1012fd3ab75024848a7848e5d5cfb1926a599e2cebc0d9f9e24152e8bc885e08","f667b0be9d0db20cd839be1bd2190abe4f88ccdce7dc43593596073cb79aabe9","0f34aae8071cc2d19a979224c762108210f2a55fcdc53547f56335452ade3343","fe4e7336ffc98caf65cd68aa683dd62ada7e8b2223dd3795f032de7c59b55099","50b3504dccfa881b67d532a35a56f35978513268c77b622f2c48354d7d95de0a","c872b7d7b3e2936698a587d3413dc345947211381ee4510d95bbd289e90955e0","0c92c4d7ca309066d7e8d354a815efe52d587465b3710e283fafe3f43e958ac5","31c041b64c8c97bbffa17858b65dd2fb2b0674c83447880ea3c6d1019fea9c6a"],"paragraph_range_zero_based":[4680,4703],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p4680"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if the highest beam measurement quantity value is below or equal to absThreshSS-BlocksConsolidation:","paragraph_zero_based":4704},{"literal_text_all_w_t_and_m_t":"3>derive each cell measurement quantity based on SS/PBCH block as the highest beam measurement quantity value, where each beam measurement quantity is described in TS 38.215 [9];","paragraph_zero_based":4705},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":4706},{"literal_text_all_w_t_and_m_t":"3>derive each cell measurement quantity based on SS/PBCH block as the linear power scale average of the highest beam measurement quantity values above absThreshSS-BlocksConsolidation where the total number of averaged beams shall not exceed nrofSS-BlocksToAverage, and where each beam measurement quantity is described in TS 38.215 [9];","paragraph_zero_based":4707},{"literal_text_all_w_t_and_m_t":"2>if in RRC_CONNECTED, apply layer 3 cell filtering as described in 5.5.3.2;","paragraph_zero_based":4708},{"literal_text_all_w_t_and_m_t":"1>for each cell measurement quantity to be derived based on CSI-RS:","paragraph_zero_based":4709},{"literal_text_all_w_t_and_m_t":"2>consider a CSI-RS resource to be applicable for deriving cell measurements when the concerned CSI-RS resource is included in the csi-rs-CellMobility including the physCellId of the cell in theCSI-RS-ResourceConfigMobility in the associated measObject;","paragraph_zero_based":4710},{"literal_text_all_w_t_and_m_t":"2>if nrofCSI-RS-ResourcesToAverage in the associated measObject is not configured; or","paragraph_zero_based":4711},{"literal_text_all_w_t_and_m_t":"2>if absThreshCSI-RS-Consolidation in the associated measObject is not configured; or","paragraph_zero_based":4712},{"literal_text_all_w_t_and_m_t":"2>if the highest beam measurement quantity value is below or equal to absThreshCSI-RS-Consolidation:","paragraph_zero_based":4713},{"literal_text_all_w_t_and_m_t":"3>derive each cell measurement quantity based on applicable CSI-RS resources for the cell as the highest beam measurement quantity value, where each beam measurement quantity is described in TS 38.215 [9];","paragraph_zero_based":4714},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":4715},{"literal_text_all_w_t_and_m_t":"3>derive each cell measurement quantity based on CSI-RS as the linear power scale average of the highest beam measurement quantity values above absThreshCSI-RS-Consolidation where the total number of averaged beams shall not exceed nrofCSI-RS-ResourcesToAverage;","paragraph_zero_based":4716},{"literal_text_all_w_t_and_m_t":"2>apply layer 3 cell filtering as described in 5.5.3.2.","paragraph_zero_based":4717},{"literal_text_all_w_t_and_m_t":"5.5.3.3aDerivation of layer 3 beam filtered measurement","paragraph_zero_based":4718},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":4719},{"literal_text_all_w_t_and_m_t":"1>for each layer 3 beam filtered measurement quantity to be derived based on SS/PBCH block;","paragraph_zero_based":4720},{"literal_text_all_w_t_and_m_t":"2>derive each configured beam measurement quantity based on SS/PBCH block as described in TS 38.215[9], and apply layer 3 beam filtering as described in 5.5.3.2;","paragraph_zero_based":4721},{"literal_text_all_w_t_and_m_t":"1>for each layer 3 beam filtered measurement quantity to be derived based on CSI-RS;","paragraph_zero_based":4722},{"literal_text_all_w_t_and_m_t":"2>derive each configured beam measurement quantity based on CSI-RS as described in TS 38.215 [9], and apply layer 3 beam filtering as described in 5.5.3.2.","paragraph_zero_based":4723},{"literal_text_all_w_t_and_m_t":"5.5.3.4Derivation of L2 U2N Relay UE measurement results","paragraph_zero_based":4724},{"literal_text_all_w_t_and_m_t":"A UE may be configured by network to derive NR sidelink measurement results of serving L2 U2N Relay UE or candidate L2 U2N Relay UEs associated to the measurement objects configured in the measObjectRelay.","paragraph_zero_based":4725},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":4726},{"literal_text_all_w_t_and_m_t":"1>for each L2 U2N Relay UE measurement quantity to be derived:","paragraph_zero_based":4727}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["f6a13f00ae7b79d6853f2b5a37a4d9def89cfc81d71f231cde0d768ee35b363f","bee6facf7b3932431f71127e4a1f69db6a9fc9a940267d1fd05ed25d5743a74f","bad04716b7e55ce616f1d96c15f72e54edf85d56587e247f8bb227a10445304c","d75dc760becdcb08f30439f35086f15e0d7d75a2c7e48c8d53e7b54bc4772e31","8271794702441c5dfba82fd41c26a35bcb31b4295bbd6baa491dfb5c7634fafb","c7494061f7777380ecba463bc27dc7db7b2345bae377339b7eb3363dad008fd3","008bbc2ad9b089fa157085a8d07dabe53403cc2a23c2d926ce294bad69aa58c7","2be8e5e6fa86932525669e0490467c4bb4719fdf6efc99367963ab3f12442388","d2e41e26a80b63bb0f9135aa87f47c5293b769bf7a3ec4a68a9478128bb1ebdd","7529357654d15e485b508cbc23b28b17f20c8de79a0eeae550c86f7b031ec41e","bd095f31181d28a495f508397483ec40bad25a48cdb0d8ce38eda21a349e287e","e4c1625c84977a9d4b3ab8a877f5155f1a0845674f16483230a726c2c5880b47","3ff70d05c4b8bb958d99d3ebdfff15d0ad462f329dedf902160afc2af2d575c1","9e0bf589e37da57ff24d32762c48efed8a1ac0cef8c6aa5011be087c4407f8e3","4c0ecad434add859b9c2a5688dcc8746f35426325162d7f37c8a39e897a8ce7d","af90c30ccabca1119c680645899a23fd9e8a667949d602fb86d875c44422e2d2","25abeb06faffcc033b15fd72c185e68b4c0cf705de95c88a2cb76b26d474f368","28970f155b0628440e7e2f8107092209b63ef5ec27dc9f72910429106f212183","aa0ad261f175c4c296198167063b9022057b14cda41c02c3f8e8b46fa6104ae3","4062d77e5c8bb7e0472b91a056e11a9c397a71a937daa9e86016856f3562e02f","ee4990bdbdfee2f2a51f01ae57d84ed3e9025a8965dcb9358c6682ed66eddd26","b4e37295df4d024ba79845f1ef74143f7560ab61f55b6df1e8a49466ee3aecea","5cdaa97d6778e21282f8459a0bc25eb7c4b28402bbc70c06630d18b028e2f6bb","c0f81193a60e8fe054ac5f00c3e8c6de4206bf888ca5396b552c59725f8032b3"],"paragraph_range_zero_based":[4704,4727],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p4704"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>derive the corresponding measurement quantity based on DMRS as described in TS 38.215 [9];","paragraph_zero_based":4728},{"literal_text_all_w_t_and_m_t":"2>apply layer 3 filtering as described in 5.5.3.2;","paragraph_zero_based":4729},{"literal_text_all_w_t_and_m_t":"5.5.4Measurement report triggering","paragraph_zero_based":4730},{"literal_text_all_w_t_and_m_t":"5.5.4.1General","paragraph_zero_based":4731},{"literal_text_all_w_t_and_m_t":"If AS security has been activated successfully, the UE shall:","paragraph_zero_based":4732},{"literal_text_all_w_t_and_m_t":"1>for each measId included in the measIdList within VarMeasConfig:","paragraph_zero_based":4733},{"literal_text_all_w_t_and_m_t":"2>if the corresponding reportConfig includes a reportType set to eventTriggered or periodical:","paragraph_zero_based":4734},{"literal_text_all_w_t_and_m_t":"3>if the corresponding measObject concerns NR:","paragraph_zero_based":4735},{"literal_text_all_w_t_and_m_t":"4>if the corresponding reportConfig includes measRSSI-ReportConfig:","paragraph_zero_based":4736},{"literal_text_all_w_t_and_m_t":"5>consider the resource indicated by the rmtc-Config on the associated frequency to be applicable;","paragraph_zero_based":4737},{"literal_text_all_w_t_and_m_t":"4>if the eventA1 or eventA2 is configured in the corresponding reportConfig:","paragraph_zero_based":4738},{"literal_text_all_w_t_and_m_t":"5>consider only the serving cell to be applicable;","paragraph_zero_based":4739},{"literal_text_all_w_t_and_m_t":"4>if the eventA3 or eventA5 or eventA3H1 or eventA3H2 or eventA5H1 or eventA5H2 is configured in the corresponding reportConfig:","paragraph_zero_based":4740},{"literal_text_all_w_t_and_m_t":"5>if a serving cell is associated with a measObjectNR and neighbours are associated with another measObjectNR, consider any serving cell associated with the other measObjectNR to be a neighbouring cell as well;","paragraph_zero_based":4741},{"literal_text_all_w_t_and_m_t":"4>if the eventX2 is configured in the corresponding reportConfig:","paragraph_zero_based":4742},{"literal_text_all_w_t_and_m_t":"5>consider only the serving L2 U2N Relay UE to be applicable;","paragraph_zero_based":4743},{"literal_text_all_w_t_and_m_t":"4>if corresponding reportConfig includes reportType set to periodical; or","paragraph_zero_based":4744},{"literal_text_all_w_t_and_m_t":"4>for measurement events other than eventA1, eventA2, eventD1, eventX2, eventH1 or eventH2:","paragraph_zero_based":4745},{"literal_text_all_w_t_and_m_t":"5>if useAllowedCellList is set to true:","paragraph_zero_based":4746},{"literal_text_all_w_t_and_m_t":"6>consider any neighbouring cell detected based on parameters in the associated measObjectNR to be applicable when the concerned cell is included in the allowedCellsToAddModList defined within the VarMeasConfig for this measId;","paragraph_zero_based":4747},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":4748},{"literal_text_all_w_t_and_m_t":"6>consider any neighbouring cell detected based on parameters in the associated measObjectNR to be applicable when the concerned cell is not included in the excludedCellsToAddModList defined within the VarMeasConfig for this measId;","paragraph_zero_based":4749},{"literal_text_all_w_t_and_m_t":"3>else if the corresponding measObject concerns E-UTRA:","paragraph_zero_based":4750},{"literal_text_all_w_t_and_m_t":"4>if eventB1 or eventB2 is configured in the corresponding reportConfig:","paragraph_zero_based":4751}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["6fba727e507f488246b10fe982228b68d6dda029e8b43a44a82f06b48c8b4a6f","53c336eb2097cebe80ea2815649df498be77bc00295aaa1ce3ed7dfcf454d788","2b84904ab417b05769c61f4f2c0b8f3f1ed9b6f7f43212f43c2439df23900a4c","895b21c695b9e4fdbc8cefa01f24e5a3e871a8a8acceb34f073437015fbd6299","77b822a2a2a698e4e3bd3e0292696c0d908fe599f29720fdbc7be424f8dc7285","bf5a7c64c2226c312c658259a5ed91a836dfb349acf580e1c574ab5ddb4c4334","b52574499ca7656e81246c4f15f0c16d84b83ca6e4cc48160d8f0864e0ba6b22","0d922202cb96720d011b81ea1d74f3a3809224737ee7b44c78a5497d43686217","0043bfa304090fabb76db783cefe8d8bdb83683bae788ff0d2c2759311134ac2","f4e44d2198b2fa9ad7e1636a4f22ce0b57e7d26051647750c4a8f81af5a7e3b5","b11e60e79d1aadaa6de1a16504bc811e9dda777b9a54bdca735d46228ca0e050","75ab13d9fed7a3f8b2815bce02bfdeaf1df6b2cb125da1277dd369001163406d","e30d8179cac427a48c1ca5f6f1a5bb891712187c31e48ca07cc47281daf987f5","31eaefd27e9155a575d0585848a8b0d681333bd74254f4249168b46965fd7e53","f2a92e23a65e2ee2063a2fb579cda64aec8c3603f66c7d2e87ea6ef78b7cb78d","4fa25f118f55245c2f0c5faa6947a9f28f85132c71edd6b65b4a52979c35f6f3","8cd3c166773e8e13aedbef849d041b3098dfa43f2ec97c4bd1ed3d8b5eeb2cb9","7e0036dcf997e40a2c3db77928f6b34be0cdec41638010f7ffdbc9950336fb71","d0833fe10064052defa06f2e98329d35592d526572e35e3f8d924bebadb71536","8fadd603d412f8cb7505f4286419a2d3c9b7ec04eb67132f8fd6fee4ef9bf9ce","7c8741d476239b42d2ce90aa0773a6795bbe86a5fec588436ecb7c4471762ef9","8250307e4636b9847e3e01f62905900973c05af8027c685b625f1138a3d3a603","f5ccefa71c8544e94f9b555dc5fab4770a9eb2709c44e69d8bd73be4871d7ce2","fdd1c8e7f2687f4865a57738375c8c3122c7ed464b541691f99f0ed9f5591a84"],"paragraph_range_zero_based":[4728,4751],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p4728"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5>consider a serving cell, if any, on the associated E-UTRA frequency as neighbour cell;","paragraph_zero_based":4752},{"literal_text_all_w_t_and_m_t":"4>consider any neighbouring cell detected on the associated frequency to be applicable when the concerned cell is not included in the excludedCellsToAddModListEUTRAN defined within the VarMeasConfig for this measId;","paragraph_zero_based":4753},{"literal_text_all_w_t_and_m_t":"3>else if the corresponding measObject concerns UTRA-FDD:","paragraph_zero_based":4754},{"literal_text_all_w_t_and_m_t":"4>if eventB1-UTRA-FDD or eventB2-UTRA-FDD is configured in the corresponding reportConfig; or","paragraph_zero_based":4755},{"literal_text_all_w_t_and_m_t":"4>if corresponding reportConfig includes reportType set to periodical:","paragraph_zero_based":4756},{"literal_text_all_w_t_and_m_t":"5>consider a neighbouring cell on the associated frequency to be applicable when the concerned cell is included in the cellsToAddModList defined within the VarMeasConfig for this measId;","paragraph_zero_based":4757},{"literal_text_all_w_t_and_m_t":"3>else if the corresponding measObject concerns L2 U2N Relay UE:","paragraph_zero_based":4758},{"literal_text_all_w_t_and_m_t":"4>if eventY1-Relay or eventY2-Relay is configured in the corresponding reportConfig; or","paragraph_zero_based":4759},{"literal_text_all_w_t_and_m_t":"4>if corresponding reportConfig includes reportType set to periodical:","paragraph_zero_based":4760},{"literal_text_all_w_t_and_m_t":"5>consider any L2 U2N Relay UE fulfilling upper layer criteria detected on the associated frequency to be applicable for this measId;","paragraph_zero_based":4761},{"literal_text_all_w_t_and_m_t":"2>else if the corresponding reportConfig includes a reportType set to reportCGI:","paragraph_zero_based":4762},{"literal_text_all_w_t_and_m_t":"3>consider the cell detected on the associated measObject which has a physical cell identity matching the value of the cellForWhichToReportCGI included in the corresponding reportConfig within the VarMeasConfig to be applicable;","paragraph_zero_based":4763},{"literal_text_all_w_t_and_m_t":"2>else if the corresponding reportConfig includes a reportType set to reportSFTD:","paragraph_zero_based":4764},{"literal_text_all_w_t_and_m_t":"3>if the corresponding measObject concerns NR:","paragraph_zero_based":4765},{"literal_text_all_w_t_and_m_t":"4>if the reportSFTD-Meas is set to true:","paragraph_zero_based":4766},{"literal_text_all_w_t_and_m_t":"5>consider the NR PSCell to be applicable;","paragraph_zero_based":4767},{"literal_text_all_w_t_and_m_t":"4>else if the reportSFTD-NeighMeas is included:","paragraph_zero_based":4768},{"literal_text_all_w_t_and_m_t":"5>if cellsForWhichToReportSFTD is configured in the corresponding reportConfig:","paragraph_zero_based":4769},{"literal_text_all_w_t_and_m_t":"6>consider any NR neighbouring cell detected on the associated measObjectNR which has a physical cell identity that is included in the cellsForWhichToReportSFTD to be applicable;","paragraph_zero_based":4770},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":4771},{"literal_text_all_w_t_and_m_t":"6>consider up to 3 strongest NR neighbouring cells detected based on parameters in the associated measObjectNR to be applicable when the concerned cells are not included in the excludedCellsToAddModList defined within the VarMeasConfig for this measId;","paragraph_zero_based":4772},{"literal_text_all_w_t_and_m_t":"3>else if the corresponding measObject concerns E-UTRA:","paragraph_zero_based":4773},{"literal_text_all_w_t_and_m_t":"4>if the reportSFTD-Meas is set to true:","paragraph_zero_based":4774},{"literal_text_all_w_t_and_m_t":"5>consider the E-UTRA PSCell to be applicable;","paragraph_zero_based":4775}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["7f583af6e1f5e55a45a8d2c2aa5d2124871507b987373b7b227e52d60b8a09ac","a5b6a51e8596b2b560a37e4337fa37e2f2e9b128ad9c602dd1c777417625c6eb","8c9044a9bd51892677b47d9757a3fd53d371e7a88432b10e505438869b9ca6b0","77003f92f3c55716926dc1f7a706985d53e35747eb7a640fede0b3964dd0678b","acda9031c3dc49526193d6dbc1af4f57678195a7ba7680628217704eae12de68","89a8f6d6d4cf6eda93d36a183434d916b35c7a58232017545bca9cc2ae8c35e8","a3c915d0747070911aea03f08b31f50255b24fe44d03ce46bc02fa4e735b5419","9b239dd36e047ad7653ef0755190a52daf8689e4c86e975dccd8dac86cd7b0bc","97148c17f937b3c183a5b3dc83c25184e55cb53c75d2ed8bb45cf2a80d23eb99","49fd5be40388772f05d9be11aa6c566a621182d5b8ed97b7ec3d97734b93f1a1","9d07cc4ff94bc87b374c8b8c4eccfb559813e3275fa57b9eeccdeeb6bd9b4a87","7cc75425920b57147712c81b1b98c9292ced095ece4f8bbfb05b27e802b97c44","280ce2f1e8e8371ad378fa0a69e298602a75392b00b2de5f0c8f34702208c406","d0389ce9be18514cc45d70b4ebd9880dd3f1dec06dd4f538c1c900eea724c5f1","035eb09354be266b147a3ce14d5f2a1e29405c0b06a6b8cae26d75adccfe63b9","3695be58de351fbf7b922b15d128b66b6332a7e204b252be77bc671831132ed1","3f01f8f093e397871ac67b79f8cb7402fc330a80da0bcd8efb6d5df4644d90a3","8112b8cfda30af1a559ff89be32c67b4d8b32a3d99bd9c4116b8824e6ffef215","c798bd0d792488e8eddcc259371e7d10eb2839f7f5111985adddd6ea2fae670f","b232a68066d4e3565e3221a473e5169d6704ea1633368555ab9aec5894a38c41","61bd7f358225cfe411d77f26fc8ec3cbb4cc6902c23c6ebeb27178a73854618d","b09a8b8cd9ea9f5869db49280c547d0072fe828f568a57d63a5d7a918f53a3b3","6e9420cc68342ca49bf64c457340b0ec1cb35ce1727dc73b3cb4937edcde43dd","5b401cdba36dc70ea3ea7ec892741d9e95567699d8e2ce64ab2f962d2600564a"],"paragraph_range_zero_based":[4752,4775],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p4752"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>else if the corresponding reportConfig includes a reportType set to cli-Periodical or cli-EventTriggered:","paragraph_zero_based":4776},{"literal_text_all_w_t_and_m_t":"3>consider all CLI measurement resources included in the corresponding measObject to be applicable;","paragraph_zero_based":4777},{"literal_text_all_w_t_and_m_t":"2>else if the corresponding reportConfig includes a reportType set to rxTxPeriodical:","paragraph_zero_based":4778},{"literal_text_all_w_t_and_m_t":"3>consider all Rx-Tx time difference measurement resources included in the corresponding measObject to be applicable;","paragraph_zero_based":4779},{"literal_text_all_w_t_and_m_t":"2>if the corresponding reportConfig concerns the reporting for NR sidelink communication/discovery (i.e. reportConfigNR-SL):","paragraph_zero_based":4780},{"literal_text_all_w_t_and_m_t":"3>consider the transmission resource pools indicated by the tx-PoolMeasToAddModList defined within the VarMeasConfig for this measId to be applicable;","paragraph_zero_based":4781},{"literal_text_all_w_t_and_m_t":"2>if the reportType is set to eventTriggered, and if the corresponding reportConfig does not include numberOfTriggeringCells, and if the entry condition applicable for this event, i.e. the event corresponding with the eventId of the corresponding reportConfig within VarMeasConfig, is fulfilled for one or more applicable cells for all measurements after layer 3 filtering taken during timeToTrigger defined for this event within the VarMeasConfig, while the VarMeasReportList does not include a measurement reporting entry for this measId (a first cell triggers the event):","paragraph_zero_based":4782},{"literal_text_all_w_t_and_m_t":"3>include a measurement reporting entry within the VarMeasReportList for this measId;","paragraph_zero_based":4783},{"literal_text_all_w_t_and_m_t":"3>set the numberOfReportsSent defined within the VarMeasReportList for this measId to 0;","paragraph_zero_based":4784},{"literal_text_all_w_t_and_m_t":"3>include the concerned cell(s) in the cellsTriggeredList defined within the VarMeasReportList for this measId;","paragraph_zero_based":4785},{"literal_text_all_w_t_and_m_t":"3>if useT312 is set to true in reportConfig for this event:","paragraph_zero_based":4786},{"literal_text_all_w_t_and_m_t":"4>if T310 for the corresponding SpCell is running; and","paragraph_zero_based":4787},{"literal_text_all_w_t_and_m_t":"4>if T312 is not running for corresponding SpCell:","paragraph_zero_based":4788},{"literal_text_all_w_t_and_m_t":"5>start timer T312 for the corresponding SpCell with the value of T312 configured in the corresponding measObjectNR;","paragraph_zero_based":4789},{"literal_text_all_w_t_and_m_t":"3>initiate the measurement reporting procedure, as specified in 5.5.5;","paragraph_zero_based":4790},{"literal_text_all_w_t_and_m_t":"2>else if the reportType is set to eventTriggered, and if the corresponding reportConfig does not include numberOfTriggeringCells, and if the entry condition applicable for this event, i.e. the event corresponding with the eventId of the corresponding reportConfig within VarMeasConfig, is fulfilled for one or more applicable cells not included in the cellsTriggeredList for all measurements after layer 3 filtering taken during timeToTrigger defined for this event within the VarMeasConfig (a subsequent cell triggers the event):","paragraph_zero_based":4791},{"literal_text_all_w_t_and_m_t":"3>set the numberOfReportsSent defined within the VarMeasReportList for this measId to 0;","paragraph_zero_based":4792},{"literal_text_all_w_t_and_m_t":"3>include the concerned cell(s) in the cellsTriggeredList defined within the VarMeasReportList for this measId;","paragraph_zero_based":4793},{"literal_text_all_w_t_and_m_t":"3>if useT312 is set to true in reportConfig for this event:","paragraph_zero_based":4794},{"literal_text_all_w_t_and_m_t":"4>if T310 for the corresponding SpCell is running; and","paragraph_zero_based":4795},{"literal_text_all_w_t_and_m_t":"4>if T312 is not running for corresponding SpCell:","paragraph_zero_based":4796},{"literal_text_all_w_t_and_m_t":"5>start timer T312 for the corresponding SpCell with the value of T312 configured in the corresponding measObjectNR;","paragraph_zero_based":4797},{"literal_text_all_w_t_and_m_t":"3>initiate the measurement reporting procedure, as specified in 5.5.5;","paragraph_zero_based":4798},{"literal_text_all_w_t_and_m_t":"2>if the reportType is set to eventTriggered, and if the corresponding reportConfig includes numberOfTriggeringCells, and if the entry condition applicable for this event, i.e. the event corresponding with the eventId of the corresponding reportConfig within VarMeasConfig, is fulfilled for one or more applicable cells for all measurements after layer 3 filtering taken during timeToTrigger defined for this event within the VarMeasConfig:","paragraph_zero_based":4799}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["c212796dd4ab5400cfe875f3c2862956afa69fa55f43340dd5dc846ec4afbbef","9db16f422593a2cdaee25b51eb6546828225cbb2c814f26eab700d93ba8c14b6","d02b6d94907222d66398dc73944f7894426a237aac58290534b242e6a0101c7c","d45b401ddf23471244f05600974427ab2208db950db65e14a949b4be4973a233","9ec738f5a715084d5ae49c41aa4dcb1aee853fdcce565368955ed50b1bd28ea7","ae35304f971344978c7cfcff2f69df43909c77f3dccda2bc57b4c74d1b163388","00e8073ff29a821de6f6202bffc8538238a19add953ce0e51a987120bb2f9021","486092752c7fc5c9d00361d318d8d81b9abb73aa4f7dcd93fdd5503c