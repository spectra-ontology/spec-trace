{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SSB-ToMeasureAltitudeBasedList-r18 ::= SEQUENCE (SIZE (1..maxNrofAltitudeRanges-r18)) OF SSB-ToMeasureAltitudeBased-r18","paragraph_zero_based":20064},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20065},{"literal_text_all_w_t_and_m_t":"SSB-ToMeasureAltitudeBased-r18 ::=     SEQUENCE {","paragraph_zero_based":20066},{"literal_text_all_w_t_and_m_t":"   altitudeRange-r18     SEQUENCE {","paragraph_zero_based":20067},{"literal_text_all_w_t_and_m_t":"      altitudeMin-r18       Altitude-r18   OPTIONAL,  -- Need S","paragraph_zero_based":20068},{"literal_text_all_w_t_and_m_t":"      altitudeMax-r18       Altitude-r18   OPTIONAL,  -- Need S","paragraph_zero_based":20069},{"literal_text_all_w_t_and_m_t":"      altitudeHyst-r18      HysteresisAltitude-r18     OPTIONAL  -- Need S","paragraph_zero_based":20070},{"literal_text_all_w_t_and_m_t":"   },","paragraph_zero_based":20071},{"literal_text_all_w_t_and_m_t":"   ssb-ToMeasure-r18   SSB-ToMeasure","paragraph_zero_based":20072},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":20073},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASOBJECTNR-STOP","paragraph_zero_based":20074},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":20075},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20076},{"literal_text_all_w_t_and_m_t":"CellsToAddMod field descriptions","paragraph_zero_based":20077},{"literal_text_all_w_t_and_m_t":"cellIndividualOffset","paragraph_zero_based":20078},{"literal_text_all_w_t_and_m_t":"Cell individual offsets applicable to a specific cell.","paragraph_zero_based":20079},{"literal_text_all_w_t_and_m_t":"physCellId","paragraph_zero_based":20080},{"literal_text_all_w_t_and_m_t":"Physical cell identity of a cell in the cell list.","paragraph_zero_based":20081},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20082},{"literal_text_all_w_t_and_m_t":"MeasObjectNR field descriptions","paragraph_zero_based":20083},{"literal_text_all_w_t_and_m_t":"absThreshCSI-RS-Consolidation","paragraph_zero_based":20084},{"literal_text_all_w_t_and_m_t":"Absolute threshold for the consolidation of measurement results per CSI-RS resource(s) from L1 filter(s). The field is used for the derivation of cell measurement results as described in 5.5.3.3 and the reporting of beam measurement information per CSI-RS resource as described in 5.5.5.2.","paragraph_zero_based":20085},{"literal_text_all_w_t_and_m_t":"absThreshSS-BlocksConsolidation","paragraph_zero_based":20086},{"literal_text_all_w_t_and_m_t":"Absolute threshold for the consolidation of measurement results per SS/PBCH block(s) from L1 filter(s). The field is used for the derivation of cell measurement results as described in 5.5.3.3 and the reporting of beam measurement information per SS/PBCH block index as described in 5.5.5.2.","paragraph_zero_based":20087}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["b458ec573cfeba4986b94d4afe77ffec59916bbe2e74cfe4763901ea913e845c","aed4572060eacc0c19d1c6a6f9d02e845ce6cdc3f8dab50856ffdd243d77281c","a5dd551f60971a3c2f716cf751132836d1a45163e5ca0f3fd3af47fc2835fece","d9230edfae9a3188c66ded610e6b8468dbcb522a6c0279016d1f15d6037999ba","912ee1bad0e3bff89ac91c1e2ae74b3a8f1314f7547b7b4f6880053237424e88","fe29d936208d7d728f20449c9268c647f72333ab68ae68d18605f5d0567ae373","b53d7dc6c934781708000d330c32a03c3b83093fb59a943840e5c3ac686fdc5f","78319a4781ac61ce3abbde54e9981b6f626d45fbca055a19eb4e134d50594d11","430df040bce152b47adca92292224aa42deaa544aae8ddfd57781a6f