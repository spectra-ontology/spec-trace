3a5c59700201e13b684a6252791f2d406","6550dc1fdfb4ca40126817e57f8cedc5550f1e97514cd11e95a2723ffdf1d38a","f1ae763d4d2d5abb8ed6ba8ab6349059804f1766123387348f6f6a85b8df53f6","1ebf17984cf93383c7a250fb2b0b7943038d02d04cca95c81ac67388863f8851","83cb23fb481df5106322852410d711811c454258f10c8239b1006f7d2732b72b","05f2b91fad603a0dc4dcb7173e4a82a484694060a05de617d1de37409d6afad0","9601be05cd5aab502c6da24aac7130e628c45d335a61de0c406476bebd15806d","cc60c5001a2898ba9af1d220c79fdc4ab5824eb4e08fc8f22fc87fb098af120a","1c6e05e18db9843e4c9f559f9ee85464b6515d9c7c472b4abf1ffb63bf828d38","5f8093f803cc2ad31a555135c10abd74adca28197aa30b216184b5e70eea8524","d663f01c1baa40c8a62eaf567d6e4dc9f679d0d9c16ba341d5c0e6c170052488","82627be36a757d016c854c3c410191824f975e9450ea241865097f452aedd2ed","a4a960e3b20c1a066ad2166e0604fa0166d92229c1c3d4d5ee14d586bc1fc9d1","7cf9c7c85bcf53cbe03a566aa6bf699a522942db322bb79cb9f4373f3768732e","37a5331d59e82829cee6cf443606adfee88451e68a69b23415aa3a4e81c7bf30","a64cbd414c6e04ddc9f18a0e9f39e18b212cd13889fbe67aa12a370be39bf866","2a79b03d9a372f83adeffb8af5505538975ffede475bb5f8fa3bf7730d30da4b","d2fa8ab843e03a986a671a28cc2d8c346f34620ea7d185de69ec1df51f2a9c35","806d0027140261b8231c39956370c4edce027623251f48814560e64dc87a0569","7e9fe5b51666cf1d8eb18019a442f0079e613bc0d9382333a5430fbaade860d2","3a09aa015c72533ad98b022cb0d903b42c62cf63bd6f31539a92f2e620efc1b6"],"paragraph_range_zero_based":[26592,26615],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p26592"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26616},{"literal_text_all_w_t_and_m_t":"LogicalChannelIdentityExt-r17 ::=           INTEGER (320..65855)","paragraph_zero_based":26617},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26618},{"literal_text_all_w_t_and_m_t":"-- TAG-RLC-BEARERCONFIG-STOP","paragraph_zero_based":26619},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26620},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26621},{"literal_text_all_w_t_and_m_t":"RLC-BearerConfig field descriptions","paragraph_zero_based":26622},{"literal_text_all_w_t_and_m_t":"isPTM-Entity","paragraph_zero_based":26623},{"literal_text_all_w_t_and_m_t":"If configured, indicates that the RLC entity is used for PTM reception. When the field is absent the RLC entity is used for PTP transmission/reception.","paragraph_zero_based":26624},{"literal_text_all_w_t_and_m_t":"logicalChannelIdentity","paragraph_zero_based":26625},{"literal_text_all_w_t_and_m_t":"ID used commonly for the MAC logical channel and for the RLC bearer. Value 4 is not configured for DRBs if SRB4 is configured.","paragraph_zero_based":26626},{"literal_text_all_w_t_and_m_t":"logicalChannelIdentityExt","paragraph_zero_based":26627},{"literal_text_all_w_t_and_m_t":"Extended logical channel ID used commonly for the MAC logical channel and for the RLC bearer for PTM reception. If this field is configured, the UE shall ignore logicalChannelIdentity.","paragraph_zero_based":26628},{"literal_text_all_w_t_and_m_t":"reestablishRLC","paragraph_zero_based":26629},{"literal_text_all_w_t_and_m_t":"Indicates that RLC should be re-established. Network sets this to true at least whenever the security key used for the radio bearer associated with this RLC entity changes. For SRB2, multicast MRBs and DRBs, unless full configuration is used, it is also set to true during the resumption of the RRC connection or the first reconfiguration after reestablishment. For SRB1, when resuming an RRC connection, or at the first reconfiguration after RRC connection reestablishment, the network does not set this field to true.","paragraph_zero_based":26630},{"literal_text_all_w_t_and_m_t":"rlc-Config","paragraph_zero_based":26631},{"literal_text_all_w_t_and_m_t":"Determines the RLC mode (UM, AM) and provides corresponding parameters. RLC mode reconfiguration can only be performed by DRB/multicast MRB release/addition or full configuration. The network may configure rlc-Config-v1610 only when rlc-Config (without suffix) is set to am.","paragraph_zero_based":26632},{"literal_text_all_w_t_and_m_t":"servedMBS-RadioBearer","paragraph_zero_based":26633},{"literal_text_all_w_t_and_m_t":"Associates the RLC Bearer with a multicast MRB. The UE shall deliver DL RLC SDUs received via the RLC entity of this RLC bearer to the PDCP entity of the servedMBS-RadioBearer.","paragraph_zero_based":26634},{"literal_text_all_w_t_and_m_t":"servedRadioBearer, servedRadioBearerSRB4","paragraph_zero_based":26635},{"literal_text_all_w_t_and_m_t":"Associates the RLC Bearer with an SRB or a DRB. The UE shall deliver DL RLC SDUs received via the RLC entity of this RLC bearer to the PDCP entity of the servedRadioBearer. Furthermore, the UE shall advertise and deliver uplink PDCP PDUs of the uplink PDCP entity of the servedRadioBearer to the uplink RLC entity of this RLC bearer unless the uplink scheduling restrictions (moreThanOneRLC in PDCP-Config and the restrictions in LogicalChannelConfig) forbid it to do so.","paragraph_zero_based":26636},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26637},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":26638},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":26639}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["476644a5e3b7bdbfa411eb113fa1f52a2a8a388edb4311a7024f604367ac9ceb","d7c343593b4f93c58111ac88b9bcf422c1a809c3db0179734a16eef1e62f62fc","b7fc7c670f1cb1a42de3867c191451c702ed989ad24f86f7d42873950b0cc418","9df2a7fc3dae3c5dc28381341945e5fe16bd82c6f9454aed01bd3cd13affbb8c","dff6fcc0c4fe0fbab276c707f31ff32c98405b743601cc0f829c8f95bae7190e","c77daa637e89568e7ebfee6519589ea26402feecb68ca29046bc50041c6b5f6d","31b07c5f18149be43b78d821c04a47f9059f7ae5896b47cac3b975727d341519","df40cae18d8622b2a83142cc4a3598bf5ae1d6fdc2117d02cb85b200d539030b","a3155c427d1a89a1c8282b7d3b427c42b2aec24017315aeccc3ca6f199736d17","b19da357ac8240433583922539cb0bf20530185d30d6eabd2d2033f8a94db687","e43050f9086b7068d3355906c97328a0f9a15bd63ea74a9404cd4b4d7cb61786","abab946408685a766310f0dd02b5e607dcb932b688d10368dfb36a3e1341e791","b92e39db5874a882617c3bf4cb7d6b5b65cf5fb810a9d917a07af4fe52422538","95ca27467039762f0392feca37642081583ebf28977e7a7264e721b29352ac60","a1afd423313ac8f1b259fdd4bc9296d4659e05245bd3a49f8ec3c1ffb90be74f","e63f9967acb050c09a1e8963b22ff2b0e28456e7d238be02bf58507fc5a1361b","bffc4fc31be3c9a70afbc734260b1e8603c85875ba5f3bba56a01bb8d919865f","302a9a9a985ec0e23704ff99932186ee5a2952c2f955386145bd88ccef00dcc8","cdc584ff0ea683d32667a729d55ca6cf15d8e767d999dc507cfd77f29a18a265","1988a30470990f33d7df25a28649ca0e80a709c90263d88e4ff913655afe317f","0d92b526d6ec7702d3fa1f880d13efaf348e2d800ad899c9ef64550f1f3795e2","d73649970c54c81334c068ed10c09ccf52b4a68008b73c0f154e7579f34f2850","445f2872403a9e53f57fc74d310134edfef781062489ad4f16463612828d78e8","bb242c4ed45d1d8e455de5c6eb69c9576cf1c7b491547c9a92253d6c4be48506"],"paragraph_range_zero_based":[26616,26639],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p26616"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"LCH-Setup","paragraph_zero_based":26640},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new logical channel for a DRB or a multicast MRB or SRB4. This field is optionally present, Need S, upon creation of a new logical channel for an SRB except SRB4. It is optionally present, Need M, otherwise.","paragraph_zero_based":26641},{"literal_text_all_w_t_and_m_t":"LCH-SetupModMRB","paragraph_zero_based":26642},{"literal_text_all_w_t_and_m_t":"This field is optionally present upon creation of a new logical channel for PTM reception for a multicast MRB. If this field is included upon creation of a new logical channel for PTM reception for a multicast MRB, it shall be present when modifying this logical channel. The field is absent for logical channels configured for an SRB and a DRB.","paragraph_zero_based":26643},{"literal_text_all_w_t_and_m_t":"LCH-SetupOnly","paragraph_zero_based":26644},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new logical channel for a DRB or an SRB (servedRadioBearer). It is absent, Need M otherwise.","paragraph_zero_based":26645},{"literal_text_all_w_t_and_m_t":"LCH-SetupOnlyMRB","paragraph_zero_based":26646},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new logical channel for a multicast MRB and upon modification of MRB-Identity of the served MRB. It is absent, Need M otherwise.","paragraph_zero_based":26647},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26648},{"literal_text_all_w_t_and_m_t":"–RLC-Config","paragraph_zero_based":26649},{"literal_text_all_w_t_and_m_t":"The IE RLC-Config is used to specify the RLC configuration of SRBs, multicast MRBs and DRBs.","paragraph_zero_based":26650},{"literal_text_all_w_t_and_m_t":"RLC-Config information element","paragraph_zero_based":26651},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26652},{"literal_text_all_w_t_and_m_t":"-- TAG-RLC-CONFIG-START","paragraph_zero_based":26653},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26654},{"literal_text_all_w_t_and_m_t":"RLC-Config ::=                      CHOICE {","paragraph_zero_based":26655},{"literal_text_all_w_t_and_m_t":"    am                                  SEQUENCE {","paragraph_zero_based":26656},{"literal_text_all_w_t_and_m_t":"        ul-AM-RLC                           UL-AM-RLC,","paragraph_zero_based":26657},{"literal_text_all_w_t_and_m_t":"        dl-AM-RLC                           DL-AM-RLC","paragraph_zero_based":26658},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":26659},{"literal_text_all_w_t_and_m_t":"    um-Bi-Directional                   SEQUENCE {","paragraph_zero_based":26660},{"literal_text_all_w_t_and_m_t":"        ul-UM-RLC                           UL-UM-RLC,","paragraph_zero_based":26661},{"literal_text_all_w_t_and_m_t":"        dl-UM-RLC                           DL-UM-RLC","paragraph_zero_based":26662},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":26663}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["8406fa5ec825089e4da5efd754d7c22ffde72f4d99348f4f618e39c05493884d","2953c71728ab9d905bd91727be2b45b44f3bfd2ae4c1f997dbade7404f635ab8","193ef34c062c078d9cae0ad26d6fd598446342afe1a2d75fbf0077de53f64796","e595c289bddd328ecba56fb912a942cb7092d624ae66f67dde49451c9653a9eb","39a421fd1ef78f2cb6e9d1c9cf5cfa804287e75a2961cd23ed247fce2a014810","f1a99d288737a4cb8c37d1a8712a46f94a0925decf3d0762b47fd0bf06