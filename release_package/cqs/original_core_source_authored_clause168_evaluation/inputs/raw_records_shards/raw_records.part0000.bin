9798a13ab54b83567342aaa1a526f5c8283137b2adbb158c022a470fd4","706d8997a5d010bf366147469e115ffa15b6a4731f88eb65aecdf17fd58ec6f8","fec6b1b5d7e0212ce6f77057f397934b4e8e50a54e5c16dfc51f8b3809a88783","387fa11a979cef77b250bf838d331ffdd912c6f579789df8b0192e44b1d49129","36e0c84691627b8e416b2107d485e5eba7d18d1c3a2ccad9a01bc5c422cb2995","6c0d5d3de469cccc242426060bd5c8c2ca80a8f80a4a39aabe088f01f2852e90","1d7c352318ab584ccc025a397d9976ca1f3e76324bcc45c31c39c4be29cdc0f3","27e37eb4c60f6f517c3d52c103e6d9f0539cb40b5a01ae84d58687ee27292f53","c242d265282dfd0116d676e96812c0e0bb7f4c45db3c60b6df1f1e375b1fb1a3","01f0b6bd6e9ec221487a852039b1f67acbc1b619748af0c21d66f89e44c243b6"],"paragraph_range_zero_based":[32784,32807],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p32784"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates which features the UE supports on the individual UL carriers of the feature set (and hence of a band entry that refers to the feature set). The UE shall hence include at least as many FeatureSetUplinkPerCC-Id in this list as the number of carriers it supports according to the ca-BandwidthClassUL, except if indicating additional functionality by reducing the number of FeatureSetUplinkPerCC-Id in the feature set (see NOTE 1 in FeatureSetCombination IE description). The order of the elements in this list is not relevant, i.e., the network may configure any of the carriers in accordance with any of the FeatureSetUplinkPerCC-Id in this list.","paragraph_zero_based":32808},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32809},{"literal_text_all_w_t_and_m_t":"–FeatureSetUplinkId","paragraph_zero_based":32810},{"literal_text_all_w_t_and_m_t":"The IE FeatureSetUplinkId identifies an uplink feature set. The FeatureSetUplinkId of a FeatureSetUplink is the index position of the FeatureSetUplink in the featureSetsUplink list in the FeatureSets IE. The first element in the list is referred to by FeatureSetUplinkId = 1, and so on. The FeatureSetUplinkId =0 is not used by an actual FeatureSetUplink but means that the UE does not support a carrier in this band of a band combination.","paragraph_zero_based":32811},{"literal_text_all_w_t_and_m_t":"FeatureSetUplinkId information element","paragraph_zero_based":32812},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32813},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETUPLINKID-START","paragraph_zero_based":32814},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32815},{"literal_text_all_w_t_and_m_t":"FeatureSetUplinkId ::=                  INTEGER (0..maxUplinkFeatureSets)","paragraph_zero_based":32816},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32817},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETUPLINKID-STOP","paragraph_zero_based":32818},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32819},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32820},{"literal_text_all_w_t_and_m_t":"–FeatureSetUplinkPerCC","paragraph_zero_based":32821},{"literal_text_all_w_t_and_m_t":"The IE FeatureSetUplinkPerCC indicates a set of features that the UE supports on the corresponding carrier of one band entry of a band combination.","paragraph_zero_based":32822},{"literal_text_all_w_t_and_m_t":"FeatureSetUplinkPerCC information element","paragraph_zero_based":32823},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32824},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETUPLINKPERCC-START","paragraph_zero_based":32825},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32826},{"literal_text_all_w_t_and_m_t":"FeatureSetUplinkPerCC ::=               SEQUENCE {","paragraph_zero_based":32827},{"literal_text_all_w_t_and_m_t":"    supportedSubcarrierSpacingUL            SubcarrierSpacing,","paragraph_zero_based":32828},{"literal_text_all_w_t_and_m_t":"    supportedBandwidthUL                    SupportedBandwidth,","paragraph_zero_based":32829},{"literal_text_all_w_t_and_m_t":"    channelBW-90mhz                         ENUMERATED {supported}                      OPTIONAL,","paragraph_zero_based":32830},{"literal_text_all_w_t_and_m_t":"    mimo-CB-PUSCH                           SEQUENCE {","paragraph_zero_based":32831}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["952feb38b773e6842f5b