{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    nrofHARQ-ProcessesForPDSCH-v1700        ENUMERATED {n32}                                               OPTIONAL    -- Need R","paragraph_zero_based":22800},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":22801},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22802},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22803},{"literal_text_all_w_t_and_m_t":"PDSCH-CodeBlockGroupTransmission ::=    SEQUENCE {","paragraph_zero_based":22804},{"literal_text_all_w_t_and_m_t":"    maxCodeBlockGroupsPerTransportBlock     ENUMERATED {n2, n4, n6, n8},","paragraph_zero_based":22805},{"literal_text_all_w_t_and_m_t":"    codeBlockGroupFlushIndicator            BOOLEAN,","paragraph_zero_based":22806},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":22807},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22808},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22809},{"literal_text_all_w_t_and_m_t":"PDSCH-CodeBlockGroupTransmissionList-r16 ::=    SEQUENCE (SIZE (1..2)) OF PDSCH-CodeBlockGroupTransmission","paragraph_zero_based":22810},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22811},{"literal_text_all_w_t_and_m_t":"DownlinkHARQ-FeedbackDisabled-r17 ::= BIT STRING (SIZE (32))","paragraph_zero_based":22812},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22813},{"literal_text_all_w_t_and_m_t":"-- TAG-PDSCH-SERVINGCELLCONFIG-STOP","paragraph_zero_based":22814},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":22815},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22816},{"literal_text_all_w_t_and_m_t":"PDSCH-CodeBlockGroupTransmission field descriptions","paragraph_zero_based":22817},{"literal_text_all_w_t_and_m_t":"codeBlockGroupFlushIndicator","paragraph_zero_based":22818},{"literal_text_all_w_t_and_m_t":"Indicates whether CBGFI for CBG based (re)transmission in DL is enabled (true). (see TS 38.212 [17], clause 7.3.1.2.2).","paragraph_zero_based":22819},{"literal_text_all_w_t_and_m_t":"maxCodeBlockGroupsPerTransportBlock","paragraph_zero_based":22820},{"literal_text_all_w_t_and_m_t":"Maximum number of code-block-groups (CBGs) per TB. In case of multiple CW, the maximum CBG is 4 (see TS 38.213 [13], clause 9.1.1).","paragraph_zero_based":22821},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22822},{"literal_text_all_w_t_and_m_t":"PDSCH-ServingCellConfig field descriptions","paragraph_zero_based":22823}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["accf91d84349d3642c76c9cc36397bc742bca1259e43ea0bb5b478e1e6bd800e","3dfe41920adc23948d9df6d52725136491daa75e40fe888d3a150777955cd062","cf313adac8019edb788f0af5d3085290e113196bf0b3bc53b2bb876cc44e75f8","a08639cbbb9ce5096c54f9f83fa31d4375996098c0edb5ffd6c8f18edcfd41e9","b73a6baca506ec31a09a501bf6a8a87b8a1e678a093027dd59c21ea59ca784be","b01810737227f8f920bbfa4d526ad84477dde2d0f901e5512503fc746989bf10","20f4891d97bc50f955579dad56eec236403de29346cb04890d6cb94831a3ea07","5e59c169fe63b14f71ca6cfd39e894cfdec13d0a3b9bb9ac95d68bf577591695","b73f097209b923c3d02fa22998b3c5e1748fafd99d0cf05151247b8b4dfbb821","81c8827a7894a2b4ec1efd6adcde8a244410c9d5eab29252a4c014a5a3f57602","6f87f49c825542112cd197abb8f3a125314b0b851cdde854afd188cdb6ff35a6","e89f6616fdd3a0c42f251c209271f8f9f943c715531fdfee4f8345999be10d94","d102d407f5641cc6a33fe8de9b8d9b707c9b5a286f90c6c73cd54262f620b50c","30c9183b2c8902199cba2f184a8807001c591e772d13f533bdaf931b26ae87db","e57ca14738a167359c651a71fbc1f80abf52a6bbd29c0c43523b1f938834cbb0","feda53de6ddf13640d8469e858795d1a11ab7f45cea0585f7efb2a8bccf2de4f","c2754cf5d8a4d6950bf0457637acc00c40ddc4ea5a0b5b6b95592d8430ff936a","f1793054e7db9d1b70159433910e28f3684683fcb18c93b8c1ad7b8faf9eed19","317aa3ec5a86a43f4bd2aa82b46f065cccd3d4e3693b72f413c719690c0f6176","81ff55d5709041c5c0d944a12b6b4d3979f3c5594ac3f9aeae04f1669f97c597","0f43e0b5d373957a0e88172e13e080e339e2aea1c9d2b5eb39697cadaef74788","16bd1031c71d52964f93d1cdffc82eb4020df7eadcec317ec4b811f5452cbd0f","afeae8a3f6bfd951d0be718f1c998359994784a08d6492b09dcf9dfd3e17e17a","c2623457f18f437b132e75389b19a06f8baeaecff42430deaa85a750e944ff18"],"paragraph_range_zero_based":[22800,22823],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p22800"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"codeBlockGroupTransmission","paragraph_zero_based":22824},{"literal_text_all_w_t_and_m_t":"Enables and configures code-block-group (CBG) based transmission (see TS 38.213 [13], clause 9.1.1). Network does not configure for a UE both spatial bundling of HARQ ACKs and codeBlockGroupTransmission within the same cell group.","paragraph_zero_based":22825},{"literal_text_all_w_t_and_m_t":"The network does not configure this field if - the SCS of at least one DL BWP configured in the cell is 480 or 960 kHz - Type-1 HARQ-ACK codebook is configured and pdsch-TimeDomainAllocationListForMultiPDSCH-r17 for this serving cell contains pdsch-AllocationList with multiple entries (multiple PDSCH) - Type-2 HARQ-ACK codebook is configured and pdsch-TimeDomainAllocationListForMultiPDSCH-r17 for any cell in the same PUCCH cell group associated with this serving cell contains pdsch-AllocationList with multiple entries (multiple PDSCH)","paragraph_zero_based":22826},{"literal_text_all_w_t_and_m_t":"downlinkHARQ-FeedbackDisabled","paragraph_zero_based":22827},{"literal_text_all_w_t_and_m_t":"Used to disable the DL HARQ feedback, sent in the uplink, per HARQ process ID. The first/leftmost bit corresponds to HARQ process ID 0, the next bit to HARQ process ID 1 and so on. Bits corresponding to HARQ process IDs that are not configured shall be ignored. The bit(s) set to one identify HARQ processes with disabled DL HARQ feedback and the bit(s) set to zero identify HARQ processes with enabled DL HARQ feedback.","paragraph_zero_based":22828},{"literal_text_all_w_t_and_m_t":"maxMIMO-Layers","paragraph_zero_based":22829},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of MIMO layers to be used for PDSCH in all BWPs of this serving cell. (see TS 38.212 [17], clause 5.4.2.1).","paragraph_zero_based":22830},{"literal_text_all_w_t_and_m_t":"nrofHARQ-ProcessesForPDSCH","paragraph_zero_based":22831},{"literal_text_all_w_t_and_m_t":"The number of HARQ processes to be used on the PDSCH of a serving cell. Value n2 corresponds to 2 HARQ processes, value n4 to 4 HARQ processes, and so on. If both nrofHARQ-ProcessesForPDSCH and nrofHARQ-ProcessesForPDSCH-v1700 are absent, the UE uses 8 HARQ processes (see TS 38.214 [19], clause 5.1).","paragraph_zero_based":22832},{"literal_text_all_w_t_and_m_t":"pdsch-CodeBlockGroupTransmissionList","paragraph_zero_based":22833},{"literal_text_all_w_t_and_m_t":"A list of configurations for up to two simultaneously constructed HARQ-ACK codebooks (see TS 38.213 [13], clause 9.3).","paragraph_zero_based":22834},{"literal_text_all_w_t_and_m_t":"processingType2Enabled","paragraph_zero_based":22835},{"literal_text_all_w_t_and_m_t":"Enables configuration of advanced processing time capability 2 for PDSCH (see 38.214 [19], clause 5.3).","paragraph_zero_based":22836},{"literal_text_all_w_t_and_m_t":"pucch-Cell","paragraph_zero_based":22837},{"literal_text_all_w_t_and_m_t":"The ID of the serving cell (of the same cell group) to use for PUCCH. If the field is absent, the UE sends the HARQ feedback on the PUCCH of the SpCell of this cell group, or on this serving cell if it is a PUCCH SCell.","paragraph_zero_based":22838},{"literal_text_all_w_t_and_m_t":"xOverhead","paragraph_zero_based":22839},{"literal_text_all_w_t_and_m_t":"Accounts for overhead from CSI-RS, CORESET, etc. If the field is absent, the UE applies value xOh0 (see TS 38.214 [19], clause 5.1.3.2).","paragraph_zero_based":22840},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22841},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":22842},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":22843},{"literal_text_all_w_t_and_m_t":"SCellAddOnly","paragraph_zero_based":22844},{"literal_text_all_w_t_and_m_t":"It is optionally present, Need S, for (non-PUCCH) SCells when adding a new SCell. The field is absent, Need M, when reconfiguring SCells. The field is also absent for the SpCells as well as for a PUCCH SCell.","paragraph_zero_based":22845},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22846},{"literal_text_all_w_t_and_m_t":"–PDSCH-TimeDomainResourceAllocationList","paragraph_zero_based":22847}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["f4d2ca3a0eebcfdee4a1833f923010a04150d353950aa5c612a70362f26206d6","a5e21b4e7f70f00108255548e05f8da62da0851f9a9a54f752c216e9e0c903bb","a6f44973c55c86c16886856088231d088a0fcf865ddcda19f387e1aafab9a003","539fefb3fdb82a1c79a1ccccefb3cc694d88dfe4516c2a2bf777cef1e7e14b74","8946cea538e3ab2a9ab5191cd847ae3d0e4f81a7b99bd5328156b0c5e4bdb00e","fa574b459e33795b4f9aa3e83b6e9cb1f665b0364659c2e952a824412346882c","27711deed41043358ef3ad60b7bf20d68531dec156f47ede54b5562eabba0036","0d938cd7d96252afb8517e0b78fbeafae51b45a5489846719ea88e8f0ba3efec","0acc8e4157bcd0794b873c8996ddad673873ffbfbddb01a2f7f7e8dc3f6b6f35","f6fcc04072685476f0fcaa83e08a6011edd5a7d8ed1cbfa18a21af95550da309","94b10e62ef8b18b9fbaf474eee09c683d2762630ede7ed5f55b5fa566d95ee27","a0fafa7f841fe4f38fc486d45a2cf8756aab1999922947013a3cf06f4e0cf2dc","abe634279b32e058890d1e15a55349a5cdf8358f07f0a2a4db5aa1460bbb1d0d","86ae3b25a2ca17e90bef9d0399acb484bee7068218bf8cffb0382dd6b67a71a4","3ca4f9a7b1e2bc3cd659ce50f99d2a95a1c36cf38fa0bc1b5e054adca0541ef9","79d0e599e2406b97c488f4802a79fc51a505827bba1de6ad924e9afbd1b4b561","5eb0d96889954a772ba6131d6fd8f36dba403be06450ef56d741fefc81b424e2","7ebd0a31735e60d2cb5a7a63436c5ca4dcbb04a725159bb18d364a358f06faaf","0e8afa291a373341720dafa1ad8decf1fca22555da11adabaa2d0695e86907ae","c75569c2d45ba1d2146d621b70213f9aae35c64710253197e2e598f1f59ef573","e51af668eb7dd3827364f2e0f2aa91cf0d0dc5a8cea5c0d02932dbdb8bc83fdb","563cb09bba6e836bfc8b2ed5d0d71b3a8d354c71d514a076a57b61c82ac24502","fd94ab576ed27b6c4f01f2a1b03b7ae6a3d8496df0113e257bd6fbadea615214","8bdb6632fe91fd64198b0d6fceca0c2f6498e1364f02f9d8d98533649947855d"],"paragraph_range_zero_based":[22824,22847],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p22824"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE PDSCH-TimeDomainResourceAllocation is used to configure a time domain relation between PDCCH and PDSCH. The PDSCH-TimeDomainResourceAllocationList contains one or more of such PDSCH-TimeDomainResourceAllocations. The network indicates in the DL assignment which of the configured time domain allocations the UE shall apply for that DL assignment. The UE determines the bit width of the DCI field based on the number of entries in the PDSCH-TimeDomainResourceAllocationList. Value 0 in the DCI field refers to the first element in this list, value 1 in the DCI field refers to the second element in this list, and so on.","paragraph_zero_based":22848},{"literal_text_all_w_t_and_m_t":"PDSCH-TimeDomainResourceAllocationList information element","paragraph_zero_based":22849},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":22850},{"literal_text_all_w_t_and_m_t":"-- TAG-PDSCH-TIMEDOMAINRESOURCEALLOCATIONLIST-START","paragraph_zero_based":22851},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22852},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22853},{"literal_text_all_w_t_and_m_t":"PDSCH-TimeDomainResourceAllocationList ::=  SEQUENCE (SIZE(1..maxNrofDL-Allocations)) OF PDSCH-TimeDomainResourceAllocation","paragraph_zero_based":22854},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22855},{"literal_text_all_w_t_and_m_t":"PDSCH-TimeDomainResourceAllocation ::=   SEQUENCE {","paragraph_zero_based":22856},{"literal_text_all_w_t_and_m_t":"    k0                                      INTEGER(0..32)                                                  OPTIONAL,   -- Need S","paragraph_zero_based":22857},{"literal_text_all_w_t_and_m_t":"    mappingType                             ENUMERATED {typeA, typeB},","paragraph_zero_based":22858},{"literal_text_all_w_t_and_m_t":"    startSymbolAndLength                    INTEGER (0..127)","paragraph_zero_based":22859},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22860},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22861},{"literal_text_all_w_t_and_m_t":"PDSCH-TimeDomainResourceAllocationList-r16 ::=  SEQUENCE (SIZE(1..maxNrofDL-Allocations)) OF PDSCH-TimeDomainResourceAllocation-r16","paragraph_zero_based":22862},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22863},{"literal_text_all_w_t_and_m_t":"PDSCH-TimeDomainResourceAllocation-r16 ::=  SEQUENCE {","paragraph_zero_based":22864},{"literal_text_all_w_t_and_m_t":"    k0-r16                                     INTEGER(0..32)                                              OPTIONAL,   -- Need S","paragraph_zero_based":22865},{"literal_text_all_w_t_and_m_t":"    mappingType-r16                            ENUMERATED {typeA, typeB},","paragraph_zero_based":22866},{"literal_text_all_w_t_and_m_t":"    startSymbolAndLength-r16                   INTEGER (0..127),","paragraph_zero_based":22867},{"literal_text_all_w_t_and_m_t":"    repetitionNumber-r16                       ENUMERATED {n2, n3, n4, n5, n6, n7, n8, n16} OPTIONAL, -- Cond Formats1-0_1-1_4-0_4-1_4-2","paragraph_zero_based":22868},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":22869},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":22870},{"literal_text_all_w_t_and_m_t":"    k0-v1710                                INTEGER(33..128)                                               OPTIONAL    -- Need S","paragraph_zero_based":22871}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["