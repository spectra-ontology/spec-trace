{"fields":{"filename":"R2-2306025.zip::R2-2306025 LPPmisc.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"n5120-r16INTEGER (0..5119),","paragraph_zero_based":312},{"literal_text_all_w_t_and_m_t":"n10240-r16INTEGER (0..10239),","paragraph_zero_based":313},{"literal_text_all_w_t_and_m_t":"n20480-r16INTEGER (0..20479),","paragraph_zero_based":314},{"literal_text_all_w_t_and_m_t":"n40960-r16INTEGER (0..40959),","paragraph_zero_based":315},{"literal_text_all_w_t_and_m_t":"n81920-r16INTEGER (0..81919),","paragraph_zero_based":316},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":317},{"literal_text_all_w_t_and_m_t":"},","paragraph_zero_based":318},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":319},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":320},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":321},{"literal_text_all_w_t_and_m_t":"DL-PRS-ResourcePrioritySubset-r17 ::= SEQUENCE (SIZE (1..maxNumPrioResources-r17)) OF","paragraph_zero_based":322},{"literal_text_all_w_t_and_m_t":"NR-DL-PRSResourcePriorityItem-r17","paragraph_zero_based":323},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":324},{"literal_text_all_w_t_and_m_t":"NR-DL-PRSResourcePriorityItem-r17 ::= SEQUENCE {","paragraph_zero_based":325},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-PrioResourceSetID-r17NR-DL-PRS-ResourceSetID-r16OPTIONAL,-- Cond NotSame","paragraph_zero_based":326},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-PrioResourceID-r17NR-DL-PRS-ResourceID-r16,","paragraph_zero_based":327},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":328},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":329},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":330},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":331},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":332},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":333},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":334},{"literal_text_all_w_t_and_m_t":"Rep","paragraph_zero_based":335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"868ffca525350b8cd9caaa00570962f5727a78ecfae70a062dbe5b906554f4e0","original_member_sha256":"8bf312286b6c91504c27741e192315ccdaf2e929a04539394e9021924ef2f9c2","paragraph_ElementTree_utf8_XML_sha256":["b8ce1c58d00478b691341d0070e49a32b8309128f02eb99cbf32bf12b40f0437","ee76792dfa79f82510d17978cd575bfdda26220051e7895244dea2b744fd0db6","4a88fc8ca35941faba943ccda0ab00d4f66a27956daf04d75b7194c14b77141e","ea027debf9d3b3adcdb9e88bf8730b3a0f0ded7f312541c063f552147ae5fae3","3250afab03cb944de92c8522a93b83ab4540ce49d6c0ee793e364fe158686717","78c248c8b8acbe034ecd9d9b7ddf8e8b2c88fd1d2b86b1cbcef629bfe07f609e","e7094251232ea8787a23d8ca8d24786095956a841b513e97784eec167b1b46a9","4863571983dd2abfbe7ad3e931e6449d3038c63916b40db8a7785da6be77a83c","a88d121ee8cd4c5750f3ad4fa5f71c822884cceca8b1d96c705a39c7a8da2dd9","544d5cd8d75017ea8a22ef7d266b9ae94c951a0c0c7e409e1a19bab4de76137f","9ee20dae1f0b2aee34bcfb6f3c3ada33af7de5a69e407f3d0e924e76e078c12c","99f703389ea4923a37b8d9c2baca5d69cdbd2d7140b221089d4a9e7f460c89e2","96370873bcfa524794b673ca1c902106a73b373bdb3079602c5f5f193b071152","8d72945a697c76c69df4fc148590fc42419e76eac1271a225eb1645d04192002","dea9bd4a4e0c77bb63309cf92b06c4f4f9f19d62b759731e55650f8aadcb359c","67c85d20d11b789051f959967aeba6256487c69e792730d0a423d794f4c7d9b8","c354e2c9da18465c39d25af94e371499a785291fe328df29cc1fa3fd5dd5068b","530d85e45dfd1f5fbd4a7ef658ab2eeea320a05db42071cd04fbafd81239f3fd","9ed9b853185c31b06375a04dc40a916af66f8ca72cd55f34c8287ed4409b6005","eb38e94a3703ede8e9a7559178feec7db59e2611721f79a1e3cff1c92f483710","24d72030012bd6fea0fec6f3898108c314613b06ca5562cae656f6268ccf2b08","be8d66ee374559d748f0fb5838234b0ca5d860e4a14a8cdad2a86366db73a055","1661b512fca3edd00e3a638d0bf62672f742961383ca70b420b551dd46726ad7","953bbcd46deb4afa25d07eef12fe0d9c252495072aaf5a534fe4956c052f4a11"],"paragraph_range_zero_based":[312,335],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306025.zip::R2-2306025 LPPmisc.docx:p312"}
{"fields":{"filename":"R2-2306025.zip::R2-2306025 LPPmisc.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The field is mandatory present, if dl-PRS-ResourceRepetitionFactor is present. Otherwise it is not present.","paragraph_zero_based":336},{"literal_text_all_w_t_and_m_t":"NotSame","paragraph_zero_based":337},{"literal_text_all_w_t_and_m_t":"The field is optionally present, need OP. If the field is absent, the indicated nr-DL-PRS-PrioResourceID belongs to the same DL-PRS Resource Set as the nr-DL-PRS-ResourceID.","paragraph_zero_based":338},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":339},{"literal_text_all_w_t_and_m_t":"NR-DL-PRS-Info field descriptions","paragraph_zero_based":340},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-ResourceID","paragraph_zero_based":341},{"literal_text_all_w_t_and_m_t":"This field specifies the DL-PRS Resource ID, which is used to identify the DL-PRS beam associated to DL-PRS Resource Set of the TRP across all the frequency layers.","paragraph_zero_based":342},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-ResourceSetID","paragraph_zero_based":343},{"literal_text_all_w_t_and_m_t":"This field specifies the DL-PRS Resource Set ID, which is used to identify the DL-PRS Resource Set of the TRP across all the frequency layers.","paragraph_zero_based":344},{"literal_text_all_w_t_and_m_t":"dl-PRS-Periodicity-and-ResourceSetSlotOffset","paragraph_zero_based":345},{"literal_text_all_w_t_and_m_t":"This field specifies the periodicity of DL-PRS allocation in slots configured per DL-PRS Resource Set and the slot offset with respect to SFN #0 slot #0 for a TRP where the DL-PRS Resource Set is configured (i.e. slot where the first DL-PRS Resource of DL-PRS Resource Set occurs).","paragraph_zero_based":346},{"literal_text_all_w_t_and_m_t":"dl-PRS-ResourceRepetitionFactor","paragraph_zero_based":347},{"literal_text_all_w_t_and_m_t":"This field specifies how many times each DL-PRS Resource is repeated for a single instance of the DL-PRS Resource Set. It is applied to all resources of the DL-PRS Resource Set. Enumerated values n2, n4, n6, n8, n16, n32 correspond to 2, 4, 6, 8, 16, 32 resource repetitions, respectively. If this field is absent, the value for dl-PRS-ResourceRepetitionFactor is 1 (i.e., no resource repetition).","paragraph_zero_based":348},{"literal_text_all_w_t_and_m_t":"dl-PRS-ResourceTimeGap","paragraph_zero_based":349},{"literal_text_all_w_t_and_m_t":"This field specifies the offset in units of slots between two repeated instances of a DL-PRS Resource corresponding to the same DL-PRS Resource ID within a single instance of the DL-PRS Resource Set. The time duration spanned by one DL-PRS Resource Set containing repeated DL-PRS Resources should not exceed DL-PRS-Periodicity.","paragraph_zero_based":350},{"literal_text_all_w_t_and_m_t":"dl-PRS-NumSymbols","paragraph_zero_based":351},{"literal_text_all_w_t_and_m_t":"This field specifies the number of symbols per DL-PRS Resource within a slot.","paragraph_zero_based":352},{"literal_text_all_w_t_and_m_t":"dl-PRS-MutingOption1","paragraph_zero_based":353},{"literal_text_all_w_t_and_m_t":"This field specifies the DL-PRS muting configuration of the TRP for the Option-1 muting, as specified in TS 38.214 [45], and comprises the following sub-fields:","paragraph_zero_based":354},{"literal_text_all_w_t_and_m_t":"-dl-prs-MutingBitRepetitionFactor indicates the number of consecutive instances of the DL-PRS Resource Set corresponding to a single bit of the nr-option1-muting bit map. Enumerated values n1, n2, n4, n8 correspond to 1, 2, 4, 8 consecutive instances, respectively. If this sub-field is absent, the value for dl-prs-MutingBitRepetitionFactor is n1.","paragraph_zero_based":355},{"literal_text_all_w_t_and_m_t":"-nr-option1-muting defines a bitmap of the time locations where the DL-PRS Resource is transmitted (value '1') or not (value '0') for a DL-PRS Resource Set, as specified in TS 38.214 [45].","paragraph_zero_based":356},{"literal_text_all_w_t_and_m_t":"If this field is absent, Option-1 muting is not in use for the TRP.","paragraph_zero_based":357},{"literal_text_all_w_t_and_m_t":"dl-PRS-MutingOption2","paragraph_zero_based":358},{"literal_text_all_w_t_and_m_t":"This field specifies the DL-PRS muting configuration of the TRP for the Option-2 muting, as specified in TS 38.214 [45], and comprises the following sub-fields:","paragraph_zero_based":359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"868ffca525350b8cd9caaa00570962f5727a78ecfae70a062dbe5b906554f4e0","original_member_sha256":"8bf312286b6c91504c27741e192315ccdaf2e929a04539394e9021924ef2f9c2","paragraph_ElementTree_utf8_XML_sha256":["6efe7a19fe78952d6f8db67c7239f4ff8e6e18289b2882ad0839acd815a7eddd","a3be495b6fc21bf1d0c75778c122b59424c75f6810f10e19323314f0d322bc96","98b98926c996e7330628a7a80ea36d600984fa579f8ac454b7dee0f6b7483f56","2f06c151b18d315adf4fd4666d149af9d6641652e67e97b555035647e497dca6","1df08d339a8d2206891412fb17cd303e2b2c77340ecd3700a764e8884cd78f4f","d5d8d717651675f934e543deebc70985f7398d7438df9fa6cff5d16a5ccafece","44d21517e0770fd8ff416fe4216c2e566d951b75e77eda9795a7cea765692a4a","62f6466d15cb9df2879a3906d6a77bc0f07daccfc57d8468649a8aa76c30b20f","e5cfa52947cdde9433f8cf5f476945d3412e0465897128728e919dbe94b2e9d0","2c9e67fef0567ffb8f8d1f51e9826c8f48faac30d8c86f38a07882b76154325a","b9994d6eb29d7a1ac47a6eb1dca76df3720acfd958e90bcecd6689e8508a8c4d","bbf734e0cfd2f192be45c27647f3820f0152f7baee4c46848d85a1eeb0a6258e","4a0678ff4bbc3b122ac86e87a7339727343adc9685469380777a70363434a09b","72599255785e919705a5c567f9ad82e1075fd4e5e4a12e2016cfbc33b878fd61","8549558a09de653d7e5b95b829a2b62d4a42b95493248da91bd35ee121c4bb26","80d114856cea6dae8e926a30f0e732a0e4153dc495ab72b7627f01cf5d0b74f7","4eef9f7612a8f955e0fa3d3a73b8689ee380675aeb1d5f2de5f2c15a60731844","76ea882f7479946a39647900789735ef9c9fe7b094eca87593672934dc9dca79","82faeb214b8975a0e05c584b7ef0f7336fb1fb04709561d6593d376f584d95f0","923839908096b7ad91d339898e1fcef7b4acad5d53daca4b8530e91174491c55","bc9e147c55ec5421dcde08c0fabb71a5c6fcee483bbfff958e947c4ad66a8477","269ca06c38a1afe816b3ea222cddff00e0e049d509afa72314a35436e7aba319","a7f29588ec6fbd0a10a29643786c40e31b7bf4d205a2504983d31059da43ce60","c4f81212a260c15aa9432d7c4a6fd302e6936fd2f8e389c0be15935c6f7fb1e8"],"paragraph_range_zero_based":[336,359],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306025.zip::R2-2306025 LPPmisc.docx:p336"}
{"fields":{"filename":"R2-2306025.zip::R2-2306025 LPPmisc.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-nr-option2-muting defines a bitmap of the time locations where the DL-PRS Resource is transmitted (value '1') or not (value '0'). Each bit of the bitmap corresponds to a single repetition of the DL-PRS Resource within an instance of a DL-PRS Resource Set, as specified in TS 38.214 [45]. The size of this bitmap should be the same as the value for dl-PRS-ResourceRepetitionFactor.","paragraph_zero_based":360},{"literal_text_all_w_t_and_m_t":"If this field is absent, Option-2 muting is not in use for the TRP.","paragraph_zero_based":361},{"literal_text_all_w_t_and_m_t":"dl-PRS-ResourcePower","paragraph_zero_based":362},{"literal_text_all_w_t_and_m_t":"This field specifies the average EPRE of the resources elements that carry the PRS in dBm that is used for PRS transmission. The UE assumes constant EPRE is used for all REs of a given DL-PRS resource.","paragraph_zero_based":363},{"literal_text_all_w_t_and_m_t":"dl-PRS-SequenceID","paragraph_zero_based":364},{"literal_text_all_w_t_and_m_t":"This field specifies the sequence Id used to initialize cinit value used in pseudo random generator TS 38.211 [41], clause 5.2.1 for generation of DL-PRS sequence for transmission on a given DL-PRS Resource.","paragraph_zero_based":365},{"literal_text_all_w_t_and_m_t":"dl-PRS-CombSizeN-AndReOffset","paragraph_zero_based":366},{"literal_text_all_w_t_and_m_t":"This field specifies the Resource Element spacing in each symbol of the DL-PRS Resource and the Resource Element (RE) offset in the frequency domain for the first symbol in a DL-PRS Resource. All DL-PRS Resource Sets belonging to the same Positioning Frequency Layer have the same value of comb size. The relative RE offsets of following symbols are defined relative to the RE Offset in the frequency domain of the first symbol in the DL-PRS Resource according to TS 38.211 [41]. The comb size configuration should be aligned with the comb size configuration for the frequency layer.","paragraph_zero_based":367},{"literal_text_all_w_t_and_m_t":"dl-PRS-ResourceSlotOffset","paragraph_zero_based":368},{"literal_text_all_w_t_and_m_t":"This field specifies the starting slot of the DL-PRS Resource with respect to the corresponding DL-PRS-Resource Set Slot Offset.","paragraph_zero_based":369},{"literal_text_all_w_t_and_m_t":"dl-PRS-ResourceSymbolOffset","paragraph_zero_based":370},{"literal_text_all_w_t_and_m_t":"This field specifies the starting symbol of the DL-PRS Resource within a slot determined by dl-PRS-ResourceSlotOffset.","paragraph_zero_based":371},{"literal_text_all_w_t_and_m_t":"dl-PRS-QCL-Info","paragraph_zero_based":372},{"literal_text_all_w_t_and_m_t":"This field specifies the QCL indication with other DL reference signals for serving and neighbouring cells and comprises the following subfields:","paragraph_zero_based":373},{"literal_text_all_w_t_and_m_t":"-ssb indicates the SSB information for QCL source and comprises the following sub-fields:","paragraph_zero_based":374},{"literal_text_all_w_t_and_m_t":"-pci specifies the physical cell ID of the cell with the SSB that is configured as the source reference signal for the DL-PRS. The UE obtains the SSB configuration for the SSB configured as source reference signal for the DL-PRS by indexing to the field nr-SSB-Config with this physical cell identity.","paragraph_zero_based":375},{"literal_text_all_w_t_and_m_t":"-ssb-Index indicates the index for the SSB configured as the source reference signal for the DL-PRS.","paragraph_zero_based":376},{"literal_text_all_w_t_and_m_t":"-rs-Type indicates the QCL type.","paragraph_zero_based":377},{"literal_text_all_w_t_and_m_t":"-dl-PRS indicates the PRS information for QCL source reference signal and comprises the followings sub-fields:","paragraph_zero_based":378},{"literal_text_all_w_t_and_m_t":"-qcl-DL-PRS-ResourceID specifies DL-PRS Resource ID of the DL-PRS resource used as the source reference signal.","paragraph_zero_based":379},{"literal_text_all_w_t_and_m_t":"-qcl-DL-PRS-ResourceSetID indicates the DL-PRS Resource Set ID of the DL-PRS Resource Set used as the source reference signal.","paragraph_zero_based":380},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-PrioResourceSetID","paragraph_zero_based":381},{"literal_text_all_w_t_and_m_t":"This fied indicates a subset of DL-PRS resource set(s) for the purpose of prioritization of DL-AOD reporting, as specified in TS 38.214 [45].","paragraph_zero_based":382},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":383}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"868ffca525350b8cd9caaa00570962f5727a78ecfae70a062dbe5b906554f4e0","original_member_sha256":"8bf312286b6c91504c27741e192315ccdaf2e929a04539394e9021924ef2f9c2","paragraph_ElementTree_utf8_XML_sha256":["2f5028e0aa10c7276fe0a3fcae437a3b7494899cc536d72721621bb36a491a5b","80729a958e93d64dd1fb00bd3252b852d803a00dea2defb4e947d804a696df77","5cd8547d6ea75b64f37bb9459d4675a977ba6204fab6dffcbcf2fe84e55a0d83","e4446316a45af06e9c42760830958a837647b27afb0d936c85f95f2b16e4955f","278120145a031a6a01a1fd44db041e21d893a91920ee9a2958546a62c0cbe17f","e61c4e45c9eca8df13eb51cd86bea589863c5abc053e83e0456f19e47f5ed028","c22ecaf53fdf56df7ee1adb9113cf57a88002dda8b9f02f5d65fb7d4199c343a","92743be301d5d8d935640196c7f27924994e2c7f044e520cb47c8fc003b81976","1785b64efb3b8de1c9b934328d7e59655d5cad67c9c6a00565180edc8872ab34","c572d3607610ca5aca4386aeb1f07f1b5aee3b65075371b884176fed1d2cc22e","b99634021478aa4f0af57a874f7eb78b2f4a0e546245260079782ffeaf915927","068ae2090ef77881de9238ce2f03f3d3a04c8591ad230da1a5a6258758655f94","8ae790adb9f6432fd9f309b20d18b24fa9691d1358db67cffca4bfdbb380b857","654029698ecb5d968bc5119e95092b7a0361fd905ebcd6bdf68169ded7752a1a","a143aa9f4b75691090d517acf741830bcaaea7bf27