add76710295441a3fef38b133fed33ce3869","30852b1a16eee51f5be25ee6cf6075f0f2974eebfe10bb6a08699a4c09bf70ff","dce3db2e3a763c068881e1e92a9f9a2ef326ff07caadb1faa8115159487e9818","acbd785e76115d9205d5313b6aa59fbbb60cde218b7d7a2d4f1fd062a5802c6a","bcfa8522b55ab78406aeb9256f17126de92f41b0c3f22061a8b246365ab3add7","128f08c6a9aeed3f3e8d4718c34004b3787036e344d5af9ff72578001e652a7b","acc8ad28fafa30bfe3c146958df0dbf47f4b98d694273f62f8b4bd6fbe10d264","567a9e5be7659077e262531900b0c7592d5eed98a3351c781e26fcbe0243d9ad","f61f50729d611e46201ea59bf2eb1f49189ee02ded61bd513c5da5ffa269964c","5cf5250e358369b6b36b756dba0d1aa239d363f39bd65020942269a4b4ac77aa","4523a2d0f76ff63f724f08229e27f7f61c260ebc32c4d26cbb27e31a882b3c44","b39143e687c7930f594f95760fb72665027443753eeb0e55444d6fe5059e961c","bcd6c6ecaa0801d70a45fb900c463bb855ba1bcae7970e2ca673bff76f63d398","ad6a293bcf5f89000a4f65b250fe28cb79fa03a7e4e7a21c1a5125816a3df958","3ab6be60271af91fac33a7787430fdb1ccd402c51a2d551734bf166b64f134e7","dce58a9a185b454e3827ab66769596027fb95f9b09354b45ede5a2da699559dd"],"paragraph_range_zero_based":[39432,39455],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p39432"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    sl-ConfiguredGrantConfigToReleaseList-r16  SEQUENCE (SIZE (1..maxNrofCG-SL-r16)) OF SL-ConfigIndexCG-r16         OPTIONAL, -- Need N","paragraph_zero_based":39456},{"literal_text_all_w_t_and_m_t":"    sl-ConfiguredGrantConfigToAddModList-r16   SEQUENCE (SIZE (1..maxNrofCG-SL-r16)) OF SL-ConfiguredGrantConfig-r16 OPTIONAL  -- Need N","paragraph_zero_based":39457},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39458},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39459},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SCHEDULEDCONFIG-STOP","paragraph_zero_based":39460},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39461},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39462},{"literal_text_all_w_t_and_m_t":"SL-ScheduledConfig field descriptions","paragraph_zero_based":39463},{"literal_text_all_w_t_and_m_t":"sl-CS-RNTI","paragraph_zero_based":39464},{"literal_text_all_w_t_and_m_t":"Indicate the RNTI used to scramble CRC of DCI format 3_0, see TS 38.321 [3].","paragraph_zero_based":39465},{"literal_text_all_w_t_and_m_t":"sl-DCI-ToSL-Trans","paragraph_zero_based":39466},{"literal_text_all_w_t_and_m_t":"Indicate the time gap between DCI reception and the first sidelink transmission scheduled by the DCI (see TS 38.214 [19], clause 8.1.2.1). Value 1 included in this field corresponds to 1 slot, value 2 corresponds to 2 slots and so on, based on the numerology of sidelink BWP.","paragraph_zero_based":39467},{"literal_text_all_w_t_and_m_t":"sl-PSFCH-ToPUCCH","paragraph_zero_based":39468},{"literal_text_all_w_t_and_m_t":"For dynamic grant and configured grant type 2, this field configures the values (in number of slot lengths) of the PSFCH to PUCCH gap. The field PSFCH-to-HARQ_feedback timing indicator in DCI format 3_0 selects one of the configured values of the PSFCH to PUCCH gap.","paragraph_zero_based":39469},{"literal_text_all_w_t_and_m_t":"sl-RNTI","paragraph_zero_based":39470},{"literal_text_all_w_t_and_m_t":"Indicate the SL-RNTI used for monitoring the network scheduling to transmit NR sidelink communication (i.e. the mode 1).","paragraph_zero_based":39471},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39472},{"literal_text_all_w_t_and_m_t":"MAC-MainConfigSL field descriptions","paragraph_zero_based":39473},{"literal_text_all_w_t_and_m_t":"sl-BSR-Config","paragraph_zero_based":39474},{"literal_text_all_w_t_and_m_t":"This field is to configure the sidelink buffer status report.","paragraph_zero_based":39475},{"literal_text_all_w_t_and_m_t":"sl-PrioritizationThres","paragraph_zero_based":39476},{"literal_text_all_w_t_and_m_t":"Indicates the SL priority threshold, which is used to determine whether SL TX is prioritized over UL TX, as specified in TS 38.321 [3]. Network does not configure the sl-PrioritizationThres and the ul-PrioritizationThres to the UE separately.","paragraph_zero_based":39477},{"literal_text_all_w_t_and_m_t":"ul-PrioritizationThres","paragraph_zero_based":39478},{"literal_text_all_w_t_and_m_t":"Indicates the UL priority threshold, which is used to determine whether SL TX is prioritized over UL TX, as specified in TS 38.321 [3]. Network does not configure the sl-PrioritizationThres and the ul-PrioritizationThres to the UE separately.","paragraph_zero_based":39479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["d19391247d550c90a1771cbea31a8a7d4f79ba01fb29bd29009c389ab9ae6130","5b383f2f11113a4d51aa07930b39fa0bd32693ec90930d596111486b4f4d272f","