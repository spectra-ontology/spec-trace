{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"nr-DL-SelectedPRS-ResourceSetIndex","paragraph_zero_based":2640},{"literal_text_all_w_t_and_m_t":"This field indicates the addressed DL-PRS Resource Set of the selected TRP of the selected frequency layer. Value 0 corresponds to the first entry in nr-DL-PRS-ResourceSetList in IE NR-DL-PRS-Info provided in IE NR-DL-PRS-AssistanceData. Value 1 corresponds to the second entry in the nr-DL-PRS-ResourceSetList in IE NR-DL-PRS-Info.","paragraph_zero_based":2641},{"literal_text_all_w_t_and_m_t":"dl-SelectedPRS-ResourceIndexList","paragraph_zero_based":2642},{"literal_text_all_w_t_and_m_t":"This field provides the list of addressed DL-PRS Resources of the selected DL-PRS Resource Set of the selected TRP of the selected frequency layer. If this field is absent, all DL-PRS Resources of the indicated DL-PRS Resource Set are addressed.","paragraph_zero_based":2643},{"literal_text_all_w_t_and_m_t":"nr-dl-SelectedPRS-ResourceIdIndex","paragraph_zero_based":2644},{"literal_text_all_w_t_and_m_t":"This field indicates the addressed DL-PRS Resource of the selected DL-PRS Resource Set of the TRP of the selected frequency layer. Value 0 corresponds to the first entry in dl-PRS-ResourceList in IE NR-DL-PRS-Info provided in IE NR-DL-PRS-AssistanceData. Value 1 corresponds to the second entry in the dl-PRS-ResourceList in IE NR-DL-PRS-Info, and so on.","paragraph_zero_based":2645},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2646},{"literal_text_all_w_t_and_m_t":"–NR-SSB-Config","paragraph_zero_based":2647},{"literal_text_all_w_t_and_m_t":"The IE NR-SSB-Config defines SSB configuration.","paragraph_zero_based":2648},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":2649},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2650},{"literal_text_all_w_t_and_m_t":"NR-SSB-Config-r16 ::= SEQUENCE {","paragraph_zero_based":2651},{"literal_text_all_w_t_and_m_t":"nr-PhysCellID-r16NR-PhysCellID-r16,","paragraph_zero_based":2652},{"literal_text_all_w_t_and_m_t":"nr-ARFCN-r16ARFCN-ValueNR-r15,","paragraph_zero_based":2653},{"literal_text_all_w_t_and_m_t":"ss-PBCH-BlockPower-r16INTEGER (-60..50),","paragraph_zero_based":2654},{"literal_text_all_w_t_and_m_t":"halfFrameIndex-r16INTEGER (0..1),","paragraph_zero_based":2655},{"literal_text_all_w_t_and_m_t":"ssb-periodicity-r16ENUMERATED { ms5, ms10, ms20, ms40, ms80, ms160, ...},","paragraph_zero_based":2656},{"literal_text_all_w_t_and_m_t":"ssb-PositionsInBurst-r16CHOICE {","paragraph_zero_based":2657},{"literal_text_all_w_t_and_m_t":"shortBitmap-r16BIT STRING (SIZE (4)),","paragraph_zero_based":2658},{"literal_text_all_w_t_and_m_t":"mediumBitmap-r16BIT STRING (SIZE (8)),","paragraph_zero_based":2659},{"literal_text_all_w_t_and_m_t":"longBitmap-r16BIT STRING (SIZE (64))","paragraph_zero_based":2660},{"literal_text_all_w_t_and_m_t":"}OPTIONAL, --Need OR","paragraph_zero_based":2661},{"literal_text_all_w_t_and_m_t":"ssb-SubcarrierSpacing-r16ENUMERATED {kHz15, kHz30, kHz60, kHz120, kHz240, ...},","paragraph_zero_based":2662},{"literal_text_all_w_t_and_m_t":"sfn-SSB-Offset-r16INTEGER (0..15),","paragraph_zero_based":2663}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["b790155fe6698719f8d9facf038c9df46f8b96e7a77ca216a856c09115f8f0c3","a5d4dff8a6df6e4b76b18f2b04c2594faccacdba162401b3e4e8499dbbce8a8c","e7965543401662b1435366c1f913b210b82928970162e8dbb12e35b23f619509","1708b396718d547c4071bc0490f17189274ca529442f17c4bd4d96f20958e824","17c78d42e259a9ae7093b09c09f4bdd8dd2ef87