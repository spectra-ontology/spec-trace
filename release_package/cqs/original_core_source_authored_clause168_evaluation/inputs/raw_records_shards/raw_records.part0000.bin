{"fields":{"filename":"R2-2300389.zip::R2-2300389.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"F","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Rel-17","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-16(Release 16)Rel-17(Release 17)Rel-18(Release 18)Rel-19(Release 19)","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":"Reason for change:","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"PhysCellID and DownlinkConfigCommon are mandatory present during the path switch between a serving cell and a L2 U2N relay UE in ServingCellConfigCommon. But the physCellID and downlinkConfigCommon are not useful during the diret to indirect path switch and NW may choose not to provide such IEs. The two IEs should only be mandatory during indirect to direct path switch.","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"Clarify PhysCellID and DownlinkConfigCommon is mandatory present during the path switch from a L2 U2N relay UE to a serving cell.","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"Impact analysis","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"Impacted 5G architecture options:","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"NR SA","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"Impacted functionality","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"NR sidelink relay","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"c7e60e196f658e3187eac15b2334b6457ddd7091cde40f923c6d5d20e088fd75","original_member_sha256":"1523b9101b790ceb291307f49f9833fb440bf047f8e1a28422ad262497223b44","paragraph_ElementTree_utf8_XML_sha256":["09cfe615b58854b5856e2d905bb2b4e46969709efbddddada2c4499eca3c363f","b204bbe2056eb4b03cbff81a1aebb8f1a75bdfc268252ca26f0088cd8d4564b8","bd1c362f29875e3614efd789785a26290546b9bdaebb4769077ed553d44e1253","4bf17c6e15b2db0c35ba4f05b48469d100c0713b4940904c077a7c6b6d09ad37","ba6e1e22c77654823b902076199c9dba4a5696c7d7b912bbb88f0f6b6eee359d","ebf9e3e17fbff2b24591a1d1f4dc34650d880eabea2181c898336ce9aea43fe0","965543a25c967523fa53ab7214ca443095acdeedd28c4de307a57a5c80f52981","ca49ba77afc3b42f1d851e1778aa9849412eddb4aeb5a261a9d237974c3fde2d","3e4f4ce6053fd675c2a380404597f5b7547863a0652951f1be09ca6b0e39f3ae","82f74b5bb546e90e268d11768fda99c8eb61863e7182894e6f75e1a732ebc23e","9aadc7df3e3f9c67d2400e22b8c5451c1372379cee9bc5bcf829dca2ed7b5f98","09cfe615b58854b5856e2d905bb2b4e46969709efbddddada2c4499eca3c363f","561574b8f7e6642377aeaace8743b0fb3b23247af6137d29a6b78aa62f249ec9","d8a66ed81647dd5127e5a609e579b65449