{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":36624},{"literal_text_all_w_t_and_m_t":"ServiceType","paragraph_zero_based":36625},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need M, when serviceType is set to streaming or vr. Otherwise, it is absent.","paragraph_zero_based":36626},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36627},{"literal_text_all_w_t_and_m_t":"–AreaConfiguration","paragraph_zero_based":36628},{"literal_text_all_w_t_and_m_t":"The AreaConfiguration indicates area for which UE is requested to perform measurement logging. If not configured, measurement logging is not restricted to specific cells or tracking areas but applies as long as the RPLMN is contained in plmn-IdentityList stored in VarLogMeasReport.","paragraph_zero_based":36629},{"literal_text_all_w_t_and_m_t":"AreaConfiguration information element","paragraph_zero_based":36630},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36631},{"literal_text_all_w_t_and_m_t":"-- TAG-AREACONFIGURATION-START","paragraph_zero_based":36632},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36633},{"literal_text_all_w_t_and_m_t":"AreaConfiguration-r16 ::=        SEQUENCE {","paragraph_zero_based":36634},{"literal_text_all_w_t_and_m_t":"    areaConfig-r16                   AreaConfig-r16,","paragraph_zero_based":36635},{"literal_text_all_w_t_and_m_t":"    interFreqTargetList-r16          SEQUENCE(SIZE (1..maxFreq)) OF InterFreqTargetInfo-r16              OPTIONAL  -- Need R","paragraph_zero_based":36636},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":36637},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36638},{"literal_text_all_w_t_and_m_t":"AreaConfiguration-v1700 ::=      SEQUENCE {","paragraph_zero_based":36639},{"literal_text_all_w_t_and_m_t":"    areaConfig-r17                   AreaConfig-r16                                                      OPTIONAL, -- Need R","paragraph_zero_based":36640},{"literal_text_all_w_t_and_m_t":"    interFreqTargetList-r17          SEQUENCE(SIZE (1..maxFreq)) OF InterFreqTargetInfo-r16              OPTIONAL  -- Need R","paragraph_zero_based":36641},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":36642},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36643},{"literal_text_all_w_t_and_m_t":"AreaConfig-r16 ::=     CHOICE {","paragraph_zero_based":36644},{"literal_text_all_w_t_and_m_t":"    cellGlobalIdList-r16             CellGlobalIdList-r16,","paragraph_zero_based":36645},{"literal_text_all_w_t_and_m_t":"    trackingAreaCodeList-r16         TrackingAreaCodeList-r16,","paragraph_zero_based":36646},{"literal_text_all_w_t_and_m_t":"    trackingAreaIdentityList-r16     TrackingAreaIdentityList-r16","paragraph_zero_based":36647}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["0e0c4d15ffcb58ab4481ac424d8436f05e7f6038b800943bcc4894724bca1e23","6de95b445f28032baa3c353da87580bc85ff396caa1118a13dc96e7fde9289af","366394d2ffc58cf138f8f2e3513a90db879804ed65e8788ba4844a79c2c52313","5369a18cb28b3a09ab571914666a0afd835713ac89be9a0787fc426e6368d7e0","956f1925bbc9632c582962ddaa6e9ae689334ee1ac8b964be6ea40cac18c9193","f3cc791e03cfbf76bfcefb5c65f5473697e62af55f0908f157af080dc9f13d5c","5b60623a94d080d4595f7d20e5d7b08c37b2b0497193ffaadaf97c0ff6641d1a","5f5cf289005380828f6489c1687f5cc2d40fb9a411228fb9ceee2a46c5836fa2","0299bbeb4f344a1fb67130e9f7bd285181379fd32c1a64102d0a0862bd2c4a7d","0d8f6c302b0d3ea1692571f6659baef51d20793691e20c756b7ebf122fde74e1","