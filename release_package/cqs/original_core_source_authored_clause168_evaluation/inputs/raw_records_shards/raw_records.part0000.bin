{"fields":{"filename":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2952},{"literal_text_all_w_t_and_m_t":"RRCReconfigurationCompleteSidelink field descriptions","paragraph_zero_based":2953},{"literal_text_all_w_t_and_m_t":"dummy","paragraph_zero_based":2954},{"literal_text_all_w_t_and_m_t":"This field is not used in the specification. The UE shall not include this field. If received it shall be ignored by the peer UE.","paragraph_zero_based":2955},{"literal_text_all_w_t_and_m_t":"sl-DRX-ConfigReject","paragraph_zero_based":2956},{"literal_text_all_w_t_and_m_t":"Indicates the rejection of sidelink DRX configuration received from the peer UE for the corresponding NR sidelink unicast communication.","paragraph_zero_based":2957},{"literal_text_all_w_t_and_m_t":"sl-SplitQoS-InfoListPC5","paragraph_zero_based":2958},{"literal_text_all_w_t_and_m_t":"Indicates the splitting QoS Info on the first PC5 hop between the Source L2 U2U Remote UE and the L2 U2U Relay UE.","paragraph_zero_based":2959},{"literal_text_all_w_t_and_m_t":"sl-AcceptQoS-InfoListPC5","paragraph_zero_based":2960},{"literal_text_all_w_t_and_m_t":"Indicates the accepted QoS Info on the second PC5 hop between the L2 U2U Relay UE and the Target L2 U2U Remote UE.","paragraph_zero_based":2961},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2962},{"literal_text_all_w_t_and_m_t":"<<Skip Unchanged>>","paragraph_zero_based":2963},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2964},{"literal_text_all_w_t_and_m_t":"7.1Timers","paragraph_zero_based":2965},{"literal_text_all_w_t_and_m_t":"7.1.1Timers (Informative)","paragraph_zero_based":2966},{"literal_text_all_w_t_and_m_t":"Timer","paragraph_zero_based":2967},{"literal_text_all_w_t_and_m_t":"Start","paragraph_zero_based":2968},{"literal_text_all_w_t_and_m_t":"Stop","paragraph_zero_based":2969},{"literal_text_all_w_t_and_m_t":"At expiry","paragraph_zero_based":2970},{"literal_text_all_w_t_and_m_t":"T300","paragraph_zero_based":2971},{"literal_text_all_w_t_and_m_t":"Upon transmission of RRCSetupRequest.","paragraph_zero_based":2972},{"literal_text_all_w_t_and_m_t":"Upon reception of RRCSetup or RRCReject message, cell re-selection, relay reselection, and upon abortion of connection establishment by upper layers.","paragraph_zero_based":2973},{"literal_text_all_w_t_and_m_t":"Perform the actions as specified in 5.3.3.7. ","paragraph_zero_based":2974},{"literal_text_all_w_t_and_m_t":"T301","paragraph_zero_based":2975}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ffe6aa9e169eee2e55d5910307b90f1a0088b587d5b1b62ff44829994c9db517","original_member_sha256":"470fa87ca234afd3cdd6813f454487933839ab990f95bcfa5c1735fcd90b61bf","paragraph_ElementTree_utf8_XML_sha256":["146468af3b16f337ea42003119ae710b2657d7439caf320d60b610c7b487264c","efd7358355bb8a2ae63cdf940d91dbd15576807fe20a5f88b3eb096de014da3e","6e333c33e40313dbe2c6ebd85bab25722807201d027c6f3b02e97b46c87b96b7","c448e2c28baab22cbd1e7e0e5f140b54a1d3baf8a2697b3e22712df192716d0a","cc3502de1887bd88c391d51e0cabfc541f219a4bd4a5ef71e1c53ce22464d8a9","fe5d09ee928bec727ebfc28bca5280388a9c09e299a4b38b0b955989ea7265aa","7daeaa762839186d41a2ce7c80504899b1a47d8d66a4b03b1763eb4ccfe7e935","bbe56c79bdfe609ed49ea5b8863ddc28fd6561c338f8d1168acee65660905705","fd5d8ae4cf8dd4a6a804c89cdf940ca1c9ae7defb3f3dfd1ca878c4654c55f68","fe09db18201980e505c5ffb1e84651a3f1e9c7e201a003c1162de1e4cb40f100","c17a97f3a60f89c8573580d17d1cb676574dc968029e182c95cd11f3d279160e","fad5c5625fc59ad1d34f7f088c863c7c5dca0d1c8b0da04a4b63422f7d0f0125","5005ac04ebd0731de71218168788a655993002c88b72e0ba2d81b5cd2764e86a","da78b8c35583094a18c82a5a55e8e6d88d8d465590126cd7d8d10035715b71d8","8d53beeac37dc22e7a3dc4484b89f857a59931a0b11998aaf589ef1ca37d878a","2796bafce1a8a062d22a35cb2c5606a64f82e53d874bda91f96f443ae4758dc9","2c034b7243be90e5a73c3ff3e72084e9a538e40a4b765796928b601162206f73","94b3917dc9891836789684f47efdc251633b823ce2836f4f2aec5160c6defd1b","355459916199154af32de14e4dc756900afc0fbc40c9490807ebb03a75d3e130","3c4fc61a1288597e1369617c9e1fc25e3a1834d279a5fa6d790e798834a336c2","dcac8a1ca32d76d2fe5dc54b6aa4d0fe8046bb2b501a71a03dcd36e825fad56f","1a3945ab7b036beabf90fc4fb19b42bafe21a4d285ac159b41ade1006d350ad6","be013bbfb27ab0a3f466d234a70b6759edd93c4a378022c6c40fa4f26488c611","0fee900dd18154e50b003b543b2c339a025fbcc511962bc10e30ae2fa45dfc60"],"paragraph_range_zero_based":[2952,2975],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx:p2952"}
{"fields":{"filename":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Upon transmission of RRCReestabilshmentRequest","paragraph_zero_based":2976},{"literal_text_all_w_t_and_m_t":"Upon reception of RRCReestablishment or RRCSetup message as well as when the selected cell becomes unsuitable or the (re)selected L2 U2N Relay UE becomes unsuitable, upon reception of notificationMessageSidelink indicating relayUE-HO or relayUE-CellReselection.","paragraph_zero_based":2977},{"literal_text_all_w_t_and_m_t":"Go to RRC_IDLE","paragraph_zero_based":2978},{"literal_text_all_w_t_and_m_t":"T302","paragraph_zero_based":2979},{"literal_text_all_w_t_and_m_t":"Upon reception of RRCReject while performing RRC connection establishment or resume, upon reception of RRCRelease with waitTime.","paragraph_zero_based":2980},{"literal_text_all_w_t_and_m_t":"Upon entering RRC_CONNECTED or RRC_IDLE, upon cell re-selection, upon cell change due to relay (re)selection, and upon reception of RRCReject message.","paragraph_zero_based":2981},{"literal_text_all_w_t_and_m_t":"Inform upper layers about barring alleviation as specified in 5.3.14.4","paragraph_zero_based":2982},{"literal_text_all_w_t_and_m_t":"T304","paragraph_zero_based":2983},{"literal_text_all_w_t_and_m_t":"Upon reception of RRCReconfiguration message including reconfigurationWithSync for the MCG which does not include sl-PathSwitchConfig, or upon reception of RRCReconfiguration message including reconfigurationWithSync for the SCG not indicated as deactivated in the NR or E-UTRA message containing the RRCReconfiguration message or upon conditional reconfiguration execution i.e. when applying a stored RRCReconfiguration message including reconfigurationWithSync.","paragraph_zero_based":2984},{"literal_text_all_w_t_and_m_t":"Upon successful completion of random access on the corresponding SpCell","paragraph_zero_based":2985},{"literal_text_all_w_t_and_m_t":"For T304 of SCG, upon SCG release","paragraph_zero_based":2986},{"literal_text_all_w_t_and_m_t":"For T304 of MCG, in case of the handover from NR or intra-NR handover, or path switch from a L2 U2N Relay UE to a NR cell, initiate the RRC re-establishment procedure; In case of handover to NR, perform the actions defined in the specifications applicable for the source RAT. If any DAPS bearer is configured and if there is no RLF in source PCell, initiate the failure information procedure.","paragraph_zero_based":2987},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2988},{"literal_text_all_w_t_and_m_t":"For T304 of SCG, inform network about the reconfiguration with sync failure by initiating the SCG failure information procedure as specified in 5.7.3.","paragraph_zero_based":2989},{"literal_text_all_w_t_and_m_t":"T310","paragraph_zero_based":2990},{"literal_text_all_w_t_and_m_t":"Upon detecting physical layer problems for the SpCell i.e. upon receiving N310 consecutive out-of-sync indications from lower layers.","paragraph_zero_based":2991},{"literal_text_all_w_t_and_m_t":"Upon receiving N311 consecutive in-sync indications from lower layers for the SpCell, upon receiving RRCReconfiguration with reconfigurationWithSync for that cell group, upon reception of MobilityFromNRCommand, upon the reconfiguration of rlf-TimersAndConstant, upon initiating the connection re-establishment procedure, upon conditional reconfiguration execution i.e. when applying a stored RRCReconfiguration message including reconfigurationWithSync for that cell group, and upon initiating the MCG failure information procedure.","paragraph_zero_based":2992},{"literal_text_all_w_t_and_m_t":"Upon SCG release, if the T310 is kept in SCG.","paragraph_zero_based":2993},{"literal_text_all_w_t_and_m_t":"If the T310 is kept in MCG: If AS security is not activated: go to RRC_IDLE else: initiate the MCG failure information procedure as specified in 5.7.3b or the connection re-establishment procedure as specified in 5.3.7 or the procedure as specified in 5.3.10.3 if any DAPS bearer is configured.","paragraph_zero_based":2994},{"literal_text_all_w_t_and_m_t":"If the T310 is kept in SCG, Inform E-UTRAN/NR about the SCG radio link failure by initiating the SCG failure information procedure as specified in 5.7.3.","paragraph_zero_based":2995},{"literal_text_all_w_t_and_m_t":"T311","paragraph_zero_based":2996},{"literal_text_all_w_t_and_m_t":"Upon initiating the RRC connection re-establishment procedure","paragraph_zero_based":2997},{"literal_text_all_w_t_and_m_t":"Upon selection of a suitable NR cell, or upon selection of a suitable L2 U2N Relay UE, or a cell using another RAT.","paragraph_zero_based":2998},{"literal_text_all_w_t_and_m_t":"Enter RRC_IDLE","paragraph_zero_based":2999}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ffe6aa9e169eee2e55d5910307b90f1a0088b587d5b1b62ff44829994c9db517","original_member_sha256":"470fa87ca234afd3cdd6813f454487933839ab990f95bcfa5c1735fcd90b61bf","paragraph_ElementTree_utf8_XML_sha256":["38690917e9319a6453121236f6f5fa26fcabeb6c44201e4c720b3a5f655f1bbf","15b9c18dea1bdf8f2071aa05ab810e62d861679182d60bf28132cee6289b2392","72a87338252872963bced7303b7945f93e19710549f513514aa685a056c424e7","fbc1311e9ebccc052d5565b5798a5d8060e3aa4cea4a3fb7a00af5cd82136f70","c412e846fef5d20e6baff87d046ddb714d3c2924cd1c41922ad87f98e5355b81","a721d083a8ed221600723a6f71b7e434bf14f812b1fa7e17ff78b57f0f81b948","ef21496ee5eb13f95e0de3eae1d0491e9de92617209b52597af015de4cff1792","c5d3ec984822543fd458334d774198b36860500bdbcb5e18ae6a7095e41aa890","6a1d8df9945c58904b6003c9ac593c9298911b0c158dafc8e5295bf91ad28287","4382902ea0b659d5aa13d4932328b68c43f29ea76ebed43d768e4d34105a704c","60379e2ecf2ced51d594bb25c53c3a37b261cf5f81271ed32163bbc105a95053","b1711bc0e33964da786c8b90296fade908639c39cce10f1c2703ac33dde7428f","6cf2c09783d06658a14f7b17e847cec33d45a460f703be80e14b3b483a2a5c07","7fbeddce0aaea7605a1c36735075e65ba92cd5eec776c8dd8efb1a60794a8b02","2abea88e0fc50c99df985bbf5ada8a204fabccbc7a86995ad31d92c6983d9c8e","240188f09c634ebe39658e5344c2f94a35562047f1460c710a4c522a4f8771b0","f357ac2f6148e27b397638d945853d1fd60f50340c8173362958a1c3a7577e47","0235c651f2cf89f8976a0738644e4f3bfd9dd2c81308f7181e2be1e0dbdba917","66ff91a0b621f8123b3b0bf49c7f1b9f40a4943f3c93d9521acf57c81a7d1eb9","312ae2600c5998fcfab01419d6347749fc5db7552ee3874a9f5f2e4b95c5d3da","7924954520b9b6d3fea7c6de051bb0eea9e28460db206a197c038635f2d799ac","c194d00d3154751192cb5167e9b795b626be8a49a2e80a71640817b01c2d7d29","219755cfdf6cfe4f761e4a831e98e04202927aa14b248f3c85b0a026f92a8814","e9f21228bc215581ae36627900f97874fcc49650fed6f5bf0fa3bb965946114e"],"paragraph_range_zero_based":[2976,2999],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx:p2976"}
{"fields":{"filename":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"T312","paragraph_zero_based":3000},{"literal_text_all_w_t_and_m_t":"If T312 is configured in MCG: Upon triggering a measurement report for a measurement identity for which T312 has been configured and useT312 has been set to true, while T310 in PCell is running.","paragraph_zero_based":3001},{"literal_text_all_w_t_and_m_t":"If T312 is configured in SCG and useT312 has been set to true: Upon triggering a measurement report for a measurement identity for which T312 has been configured, while T310 in PSCell is running.","paragraph_zero_based":3002},{"literal_text_all_w_t_and_m_t":"Upon receiving N311 consecutive in-sync indications from lower layers for the SpCell, receiving RRCReconfiguration with reconfigurationWithSync for that cell group, upon reception of MobilityFromNRCommand, upon initiating the connection re-establishment procedure, upon the reconfiguration of rlf-TimersAndConstant, upon initiating the MCG failure information procedure, upon conditional reconfiguration execution i.e. when applying a stored RRCReconfiguration message including reconfigurationWithSync for that cell group, and upon the expiry of T310 in corresponding SpCell.","paragraph_zero_based":3003},{"literal_text_all_w_t_and_m_t":"Upon SCG release, if the T312 is kept in SCG","paragraph_zero_based":3004},{"literal_text_all_w_t_and_m_t":"If the T312 is kept in MCG initiate the MCG failure information procedure as specified in 5.7.3b or the connection re-establishment procedure.","paragraph_zero_based":3005},{"literal_text_all_w_t_and_m_t":"If the T312 is kept in SCG, Inform E-UTRAN/NR about the SCG radio link failure by initiating the SCG failure information procedure.as specified in 5.7.3.","paragraph_zero_based":3006},{"literal_text_all_w_t_and_m_t":"T316","paragraph_zero_based":3007},{"literal_text_all_w_t_and_m_t":"Upon transmission of the MCGFailureInformation message","paragraph_zero_based":3008},{"literal_text_all_w_t_and_m_t":"Upon receiving RRCRelease,  RRCReconfiguration with reconfigurationwithSync for the PCell, MobilityFromNRCommand, or upon initiating the re-establishment procedure","paragraph_zero_based":3009},{"literal_text_all_w_t_and_m_t":"Perform the actions as specified in 5.7.3b.5.","paragraph_zero_based":3010},{"literal_text_all_w_t_and_m_t":"T319","paragraph_zero_based":3011},{"literal_text_all_w_t_and_m_t":"Upon transmission of RRCResumeRequest or RRCResumeRequest1 when the resume procedure is not initiated for SDT.","paragraph_zero_based":3012},{"literal_text_all_w_t_and_m_t":"Upon reception of RRCResume, RRCSetup, RRCRelease, RRCRelease with suspendConfig or RRCReject message, upon cell re-selection or upon relay (re)selection.","paragraph_zero_based":3013},{"literal_text_all_w_t_and_m_t":"Perform the actions as specified in 5.3.13.5.","paragraph_zero_based":3014},{"literal_text_all_w_t_and_m_t":"T319a","paragraph_zero_based":3015},{"literal_text_all_w_t_and_m_t":"Upon transmission of RRCResumeRequest or RRCResumeRequest1 when the resume procedure is initiated for SDT.","paragraph_zero_based":3016},{"literal_text_all_w_t_and_m_t":"Upon reception of RRCResume, RRCSetup, RRCRelease, RRCReject message or upon failure to resume RRC connection for SDT as specified in 5.3.13.5 or upon cell reselection.","paragraph_zero_based":3017},{"literal_text_all_w_t_and_m_t":"Perform the actions as specified in 5.3.13.5.","paragraph_zero_based":3018},{"literal_text_all_w_t_and_m_t":"T320","paragraph_zero_based":3019},{"literal_text_all_w_t_and_m_t":"Upon reception of t320 or upon cell (re)selection to NR from another RAT with validity time configured for dedicated priorities (in which case the remaining validity time is applied).","paragraph_zero_based":3020},{"literal_text_all_w_t_and_m_t":"Upon entering RRC_CONNECTED, upon reception of RRCRelease, when PLMN selection or SNPN selection is performed on request by NAS, when the UE enters RRC_IDLE from RRC_INACTIVE, or upon cell (re)selection to another RAT (in which case the timer is carried on to the other RAT).","paragraph_zero_based":3021},{"literal_text_all_w_t_and_m_t":"Discard the cell reselection priority information provided by dedicated signalling.","paragraph_zero_based":3022},{"literal_text_all_w_t_and_m_t":"T321","paragraph_zero_based":3023}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ffe6aa9e169eee2e55d5910307b90f1a0088b587d5b1b62ff44829994c9db517","original_member_sha256":"470fa87ca234afd3cdd6813f454487933839ab990f95bcfa5c1735fcd90b61bf","paragraph_ElementTree_utf8_XML_sha256":["555a56dfdd905502703760eb4f015f14eac86db7ebed356c033838fe4ace2ade","40d43241fbcf14f7b885dad99201c83b2732cffbcdc4f7837d69dd45fe0cc358","cd22b8211b28360eaeda81601e55b3860c872ad144291f986ba0f50bd83e88ee","d716a14a28520ed4a988102f37b01fbf37e3ca5ffd02f60dba204cc472b836cc","ed9b11b9bc9682f354fb70a247f1b83c665cc54440f9e0dde56ae631926f3e31","639f78ca2713d461850efc3ac9f96e4eb883d436e8506b087ba73fd069656efd","7c61683f7a547e2f4950fbb798dc1cf9080ed4350cf62e5790023fad52c275b4","572a30163e6ed29e7bd2ac653c5a9a6cb309de666d37ae70bfa6bb6fecb22a7a","a7a5f5c6fc5754c9b024e082c7e08f804b824632fb4111e75a07dc66c36fec18","0faf5f89888e3938c651946f7c3f61919cf18e3673f3e9d54c17be34b923a56e","b5556cd93ae5f251fcc6aaa5edf54f64b1ee2f06e8eb9627c28b0c7e31ba968c","d6bed3465c4469dc40c84f56ad9b19dab078ce3f8032651d8bf24b9b83a2fe78","c512e863929eb013522a49add37f66a0bac27a3f548fbef0ef4638ce13516383","f954a82c6521d537eb5a38fb8d1b5c41f332e72fd051306e29a5f81e51e845b8","ba2a988c62902b287911997699946ae7261746bee3124a7216637a1e28189237","e8cdec05be54b14288db3e2ba99e93d4f2d6a89a60859516225dcdd89af87b8f","e32030f5e2d1c9b5ab14c8ebe616ab4bc25310b1154231b19268a553a48045df","ec79a69d5cf2f2821290c5717cf1fdf4d1b771952ee57a6a94f2a0b8e9f9354d","82a2c4a6f4ff5b63e35cc4f4e8e2010e2ff037e843468942b1cb2d61c6f83149","f852349bae5d7fa9a9f23755d1ca8846e98fb5a5489a3b60b36621026017962c","ad743458e487bc68ec08c29922d042ed9a22301172864517f9f1484c9c2e4991","ec80c6d8335c642122e37a2e5590249b6e0ddc10a909b889c02d53bb4cf96dfc","beaf32f82cd89463edb0d6952edfc02c96b2205871750b9bcf047c3dcbc6a72b","9124c8b421bf08140071f3944cc085b93f91d07293fc573e7ba14da837f6bba0"],"paragraph_range_zero_based":[3000,3023],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx:p3000"}
{"fields":{"filename":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Upon receiving measConfig including a reportConfig with the reportType set to reportCGI","paragraph_zero_based":3024},{"literal_text_all_w_t_and_m_t":"Upon acquiring the information needed to set all fields of cgi-info, upon receiving measConfig that includes removal of the reportConfig with the reportType set to reportCGI and upon detecting that a cell is not broadcasting SIB1.","paragraph_zero_based":3025},{"literal_text_all_w_t_and_m_t":"Initiate the measurement reporting procedure, stop performing the related measurements.","paragraph_zero_based":3026},{"literal_text_all_w_t_and_m_t":"T322","paragraph_zero_based":3027},{"literal_text_all_w_t_and_m_t":"Upon receiving measConfig including reportConfigNR with the reportType set to reportSFTD and drx-SFTD-NeighMeas is set to true.","paragraph_zero_based":3028},{"literal_text_all_w_t_and_m_t":"Upon acquiring the SFTD measurement results, upon receiving measConfig that includes removal of the reportConfig with the reportType set to reportSFTD.","paragraph_zero_based":3029},{"literal_text_all_w_t_and_m_t":"Initiate the measurement reporting procedure, stop performing the related measurements.","paragraph_zero_based":3030},{"literal_text_all_w_t_and_m_t":"T325","paragraph_zero_based":3031},{"literal_text_all_w_t_and_m_t":"Upon reception of RRCRelease message with deprioritisationTimer.","paragraph_zero_based":3032},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3033},{"literal_text_all_w_t_and_m_t":"Stop deprioritisation of all frequencies or NR signalled by RRCRelease.","paragraph_zero_based":3034},{"literal_text_all_w_t_and_m_t":"T330","paragraph_zero_based":3035},{"literal_text_all_w_t_and_m_t":"Upon receiving LoggedMeasurementConfiguration message","paragraph_zero_based":3036},{"literal_text_all_w_t_and_m_t":"Upon log volume exceeding the suitable UE memory, upon initiating the release of LoggedMeasurementConfiguration procedure","paragraph_zero_based":3037},{"literal_text_all_w_t_and_m_t":"Perform the actions specified in 5.5a.1.4","paragraph_zero_based":3038},{"literal_text_all_w_t_and_m_t":"T331","paragraph_zero_based":3039},{"literal_text_all_w_t_and_m_t":"Upon receiving RRCRelease message with measIdleDuration","paragraph_zero_based":3040},{"literal_text_all_w_t_and_m_t":"Upon receiving RRCSetup, RRCResume, RRCRelease with idle/inactive measurement configuration, upon cell selection/reselection to a cell that does not belong to the validityArea (if configured), or upon cell re-selection to another RAT.","paragraph_zero_based":3041},{"literal_text_all_w_t_and_m_t":"Perform the actions as specified in 5.7.8.3.","paragraph_zero_based":3042},{"literal_text_all_w_t_and_m_t":"T342","paragraph_zero_based":3043},{"literal_text_all_w_t_and_m_t":"Upon transmitting UEAssistanceInformation message with DelayBudgetReport.","paragraph_zero_based":3044},{"literal_text_all_w_t_and_m_t":"Upon releasing delayBudgetReportingConfig during the connection re-establishment/resume procedures, and upon receiving delayBudgetReportingConfig set to release.","paragraph_zero_based":3045},{"literal_text_all_w_t_and_m_t":"No action.","paragraph_zero_based":3046},{"literal_text_all_w_t_and_m_t":"T345","paragraph_zero_based":3047}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ffe6aa9e169eee2e55d5910307b90f1a0088b587d5b1b62ff44829994c9db517","original_member_sha256":"470fa87ca234afd3cdd6813f454487933839ab990f95bcfa5c1735fcd90b61bf","paragraph_ElementTree_utf8_XML_sha256":["36e1eea4853bac398d93f4f0d8901c3419556cda29585f9b0d2b4e67daf361f9","49421a39afbf83c149501dcfbeeed2e33cfef59808f4c7e900030c1ae81c374b","47227e5d13edb2edfa14d0f5ce39485acb6302f5961eb9d7434a07e2eebdf9d5","a85d