{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18048},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":18049},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":18050},{"literal_text_all_w_t_and_m_t":"InterFreqHOAndServCellAdd","paragraph_zero_based":18051},{"literal_text_all_w_t_and_m_t":"This field is mandatory present for inter-frequency handover, and upon serving cell (PSCell/SCell) addition. Otherwise, the field is optionally present, Need M.","paragraph_zero_based":18052},{"literal_text_all_w_t_and_m_t":"ServCellAdd","paragraph_zero_based":18053},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon serving cell addition (for PSCell and SCell) and upon handover from E-UTRA to NR. It is optionally present, Need M otherwise.","paragraph_zero_based":18054},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18055},{"literal_text_all_w_t_and_m_t":"–DownlinkConfigCommonSIB","paragraph_zero_based":18056},{"literal_text_all_w_t_and_m_t":"The IE DownlinkConfigCommonSIB provides common downlink parameters of a cell.","paragraph_zero_based":18057},{"literal_text_all_w_t_and_m_t":"DownlinkConfigCommonSIB information element","paragraph_zero_based":18058},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18059},{"literal_text_all_w_t_and_m_t":"-- TAG-DOWNLINKCONFIGCOMMONSIB-START","paragraph_zero_based":18060},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18061},{"literal_text_all_w_t_and_m_t":"DownlinkConfigCommonSIB ::=     SEQUENCE {","paragraph_zero_based":18062},{"literal_text_all_w_t_and_m_t":"    frequencyInfoDL                 FrequencyInfoDL-SIB,","paragraph_zero_based":18063},{"literal_text_all_w_t_and_m_t":"    initialDownlinkBWP              BWP-DownlinkCommon,","paragraph_zer