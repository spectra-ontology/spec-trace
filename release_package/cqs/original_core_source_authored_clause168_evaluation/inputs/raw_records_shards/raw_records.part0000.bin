{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38160},{"literal_text_all_w_t_and_m_t":"SL-FreqConfigCommon-r16 ::=      SEQUENCE {","paragraph_zero_based":38161},{"literal_text_all_w_t_and_m_t":"    sl-SCS-SpecificCarrierList-r16   SEQUENCE (SIZE (1..maxSCSs)) OF SCS-SpecificCarrier,","paragraph_zero_based":38162},{"literal_text_all_w_t_and_m_t":"    sl-AbsoluteFrequencyPointA-r16   ARFCN-ValueNR,","paragraph_zero_based":38163},{"literal_text_all_w_t_and_m_t":"    sl-AbsoluteFrequencySSB-r16      ARFCN-ValueNR                                                       OPTIONAL, -- Need R","paragraph_zero_based":38164},{"literal_text_all_w_t_and_m_t":"    frequencyShift7p5khzSL-r16       ENUMERATED {true}                                                   OPTIONAL, -- Cond V2X-SL-Shared","paragraph_zero_based":38165},{"literal_text_all_w_t_and_m_t":"    valueN-r16                       INTEGER (-1..1),","paragraph_zero_based":38166},{"literal_text_all_w_t_and_m_t":"    sl-BWP-List-r16                  SEQUENCE (SIZE (1..maxNrofSL-BWPs-r16)) OF SL-BWP-ConfigCommon-r16  OPTIONAL, -- Need R","paragraph_zero_based":38167},{"literal_text_all_w_t_and_m_t":"    sl-SyncPriority-r16              ENUMERATED {gnss, gnbEnb}                                           OPTIONAL, -- Need R","paragraph_zero_based":38168},{"literal_text_all_w_t_and_m_t":"    sl-NbAsSync-r16                  BOOLEAN                                                             OPTIONAL, -- Need R","paragraph_zero_based":38169},{"literal_text_all_w_t_and_m_t":"    sl-SyncConfigList-r16            SL-SyncConfigList-r16                                               OPTIONAL, -- Need R","paragraph_zero_based":38170},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":38171},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":38172},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-FREQCONFIGCOMMON-STOP","paragraph_zero_based":38173},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":38174},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38175},{"literal_text_all_w_t_and_m_t":"SL-FreqConfigCommon field descriptions","paragraph_zero_based":38176},{"literal_text_all_w_t_and_m_t":"frequencyShift7p5khzSL","paragraph_zero_based":38177},{"literal_text_all_w_t_and_m_t":"Enable the NR SL transmission with a 7.5 kHz shift to the LTE raster. If the field is absent, the frequency shift is disabled.","paragraph_zero_based":38178},{"literal_text_all_w_t_and_m_t":"sl-AbsoluteFrequencyPointA","paragraph_zero_based":38179},{"literal_text_all_w_t_and_m_t":"Absolute frequency of the reference resource block (Common RB 0). Its lowest subcarrier is also known as Point A.","paragraph_zero_based":38180},{"literal_text_all_w_t_and_m_t":"sl-AbsoluteFrequencySSB","paragraph_zero_based":38181},{"literal_text_all_w_t_and_m_t":"Indicates the frequency location of sidelink SSB. The transmission bandwidth for sidelink SSB is within the bandwidth of this sidelink BWP.","paragraph_zero_based":38182},{"literal_text_all_w_t_and_m_t":"sl-BWP-List","paragraph_zero_based":38183}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["098565886edb32c1fd27bd942837d40fb32a3ae81b8db98616e13f8aec1a1c1b","cebe087f08ef97f517c6acf60e415542e3421cd3d01fafe42fec4c0fdbfda1d1","07ba15b025c707f53632bd232bd1b2b2f2d3af26544e655e72ecd473ab68d8fa","095ca8b74ff2fa55b3f8bce222b3e63c423cf5a1df88e1042f75ea8deb91ae4d","c8aa82867035c5d1354d96ddcc4d21c4c8c8aa9c63aa321072da9fa4fe35e6ea","3abe1f3af6879302d9986c024d14803a39e320b4315b9ce2570aa01bafaf2280","cf4c353b5b2c761f15e037876e737bb7b6f94022431dee83de5f4d1c2f644bd5","01999a409fc788d2d998c9f93b124bfbe68c9369aa05cb16ecce32ec5a70d663","8727e3472b992ca23a89e75c1ad3a1fcf5f2c5bfb04688ee53c2d9d452d480b6","063604da09549d9b54bb844d8a7b9bb401ed2be68f2f47e783d4311ab97c4718","895f19f59eb83df6d852875919a0496744bf1703b808e90c8273eb8129aba16f","6a7e6c635f563407e7c9e4964de5aab2995ca16cd7e99b05b772aa6336260443","9ba4b049489cc39ce03d241de3fbdb138270ff2bc55ebed65e60744e6c96643f","0097042d05424863a2e545bff48cccac126c5b2986dade86871cde808f7006cc","dd609dc37374f5308d8a607352de226b2cc10b9fe8d322322f20b2b209c2ad98","010cc227307b58b0f350191fc772e8b2cecfa25011b3edaa585da5942bfa64db","ffcc457150dd2ca50ee84fe85fc3bda9f6cc5226a670ceb493fd2292d028dd19","f51c75f802a057af1179775f98c5409d8beb7be5dea3cccda13cf1cd4a352344","78493860bf19a5f923a022b33491218f7be12088e19cd1b1c1c3d59a903f3f30","3a3ea839061757d71f9c30e32533255cfd709d49d4c9e0f5361c6fc09b06a4d1","317005a1f6c526d0dc00c84ce76c4eeebf1b79c4b0717a82318b433e87a82be0","423f5b42be9b57ddebdfdaecdfd6bede32a088ae6e15a3effcd9a99c670e3771","81247cca72812df4a270aedf6b1cded9fb78b99716002efdb8542e929576bda9","a730d69db18e652852b70688c605aff5ad8317640094d22bf7d89b86ec2a88e6"],"paragraph_range_zero_based":[38160,38183],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p38160"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field indicates the list of sidelink BWP(s) on which the NR sidelink communication configuration. In this release, only one BWP is allowed to be configured for NR sidelink communication.","paragraph_zero_based":38184},{"literal_text_all_w_t_and_m_t":"sl-NbAsSync","paragraph_zero_based":38185},{"literal_text_all_w_t_and_m_t":"This field indicates whether the network can be selected as synchronization reference directly/indirectly only, if sl-SyncPriority is set to gnss. If this field is set to TRUE, the network is enabled to be selected as synchronization reference directly/indirectly. The field is only present in SidelinkPreconfigNR. Otherwise it is absent.","paragraph_zero_based":38186},{"literal_text_all_w_t_and_m_t":"sl-SyncPriority","paragraph_zero_based":38187},{"literal_text_all_w_t_and_m_t":"This field indicates synchronization priority order, as specified in clause 5.8.6..","paragraph_zero_based":38188},{"literal_text_all_w_t_and_m_t":"sl-SyncConfigList","paragraph_zero_based":38189},{"literal_text_all_w_t_and_m_t":"This field indicates the configuration by which the UE is allowed to receive and transmit synchronisation information for NR sidelink communication. Network configures sl-SyncConfig including txParameters when configuring UEs to transmit synchronisation information. If this field is configured in SL-PreconfigurationNR-r16, only one entry is configured in sl-SyncConfigList.","paragraph_zero_based":38190},{"literal_text_all_w_t_and_m_t":"valueN","paragraph_zero_based":38191},{"literal_text_all_w_t_and_m_t":"Indicate the NR SL transmission with a valueN *5kHz shift to the LTE raster (see TS 38.101-1 [15], clause 5.4E.2).","paragraph_zero_based":38192},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38193},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":38194},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":38195},{"literal_text_all_w_t_and_m_t":"V2X-SL-Shared","paragraph_zero_based":38196},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if the carrier frequency configured for NR sidelink communication is shared by V2X sidelink communication. It is absent, Need R, otherwise.","paragraph_zero_based":38197},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38198},{"literal_text_all_w_t_and_m_t":"–SL-InterUE-CoordinationConfig","paragraph_zero_based":38199},{"literal_text_all_w_t_and_m_t":"The IE SL-InterUE-CoordinationConfig is used to configure the sidelink inter-UE coordination (between a UE, UE-A, and a peer UE, UE-B) parameters.","paragraph_zero_based":38200},{"literal_text_all_w_t_and_m_t":"SL-InterUE-CoordinationConfig information element","paragraph_zero_based":38201},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":38202},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-INTERUE-COORDINATIONCONFIG-START","paragraph_zero_based":38203},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38204},{"literal_text_all_w_t_and_m_t":"SL-InterUE-CoordinationConfig-r17 ::=     SEQUENCE {","paragraph_zero_based":38205},{"literal_text_all_w_t_and_m_t":"    sl-InterUE-CoordinationScheme1-r17        SL-InterUE-CoordinationScheme1-r17                                   OPTIONAL,   -- Need M","paragraph_zero_based":38206},{"literal_text_all_w_t_and_m_t":"    sl-InterUE-CoordinationScheme2-r17        SL-InterUE-CoordinationScheme2-r17                                   OPTIONAL,   -- Need M","paragraph_zero_based":38207}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f