{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE UE-CapabilityRAT-ContainerList contains a list of radio access technology specific capability containers.","paragraph_zero_based":35952},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRAT-ContainerList information element","paragraph_zero_based":35953},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":35954},{"literal_text_all_w_t_and_m_t":"-- TAG-UE-CAPABILITYRAT-CONTAINERLIST-START","paragraph_zero_based":35955},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35956},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRAT-ContainerList ::=    SEQUENCE (SIZE (0..maxRAT-CapabilityContainers)) OF UE-CapabilityRAT-Container","paragraph_zero_based":35957},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35958},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRAT-Container ::=        SEQUENCE {","paragraph_zero_based":35959},{"literal_text_all_w_t_and_m_t":"    rat-Type                              RAT-Type,","paragraph_zero_based":35960},{"literal_text_all_w_t_and_m_t":"    ue-CapabilityRAT-Container            OCTET STRING","paragraph_zero_based":35961},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":35962},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35963},{"literal_text_all_w_t_and_m_t":"-- TAG-UE-CAPABILITYRAT-CONTAINERLIST-STOP","paragraph_zero_based":35964},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":35965},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35966},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRAT-ContainerList field descriptions","paragraph_zero_based":35967},{"literal_text_all_w_t_and_m_t":"ue-CapabilityRAT-Container","paragraph_zero_based":35968},{"literal_text_all_w_t_and_m_t":"Container for the UE capabilities of the indicated RAT. The encoding is defined in the specification of each RAT:","paragraph_zero_based":35969},{"literal_text_all_w_t_and_m_t":"For rat-Type set to nr: the encoding of UE capabilities is defined in UE-NR-Capability.","paragraph_zero_based":35970},{"literal_text_all_w_t_and_m_t":"For rat-Type set to eutra-nr: the encoding of UE capabilities is defined in UE-MRDC-Capability.","paragraph_zero_based":35971},{"literal_text_all_w_t_and_m_t":"For rat-Type set to eutra: the encoding of UE capabilities is defined in UE-EUTRA-Capability specified in TS 36.331 [10].","paragraph_zero_based":35972},{"literal_text_all_w_t_and_m_t":"For rat-Type set to utra-fdd: the octet string contains the INTER RAT HANDOVER INFO message defined in TS 25.331 [45].","paragraph_zero_based":35973},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35974},{"literal_text_all_w_t_and_m_t":"–UE-CapabilityRAT-RequestList","paragraph_zero_based":35975}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["384fcb0b10f984e5c0869f00914d1c48b8e4d18b5db2cd3e332c1e862a3a806c","9c0ad19e91bc729aae439afd291b0d1f597bd3875acf2fc09cb7184ee34ff230","3dfd7c97830851cffb9ee1101951a0a88d662c928bff3985d5f864cfa80982a3","9bead2c2c2712f69b80c02e87d1fa5078eda6d988f7230b0cafbb676be52e4f4","28f05d757a18afc37185b3c13c0ecbd2a6415678b3424176f92f7edd1da9f102","263c672dd0a8e575ae4b657f1e8f7b939f8407982251be0fd85e011e477e30c3","42e7232fedff0d7ba2aee8c3408e8dccf198f61c62eab638cfa91945e3b758ae","0bb6a373f60c190562c887ffb0af43b1ae72ef8fac13b0f5d571405c93fcedbd","74a3c5144ec9c43089d365d1a8012dd1ea44e61c2aa6da54752e7f154d91a9f6","e3e089a6a84c200fb4eeb5317df406f080684b4b7917c92486e4861f57b18556","8f9ddc5142d7491716582233fb5805e639bc95c611ae64c893229b7d22f5b