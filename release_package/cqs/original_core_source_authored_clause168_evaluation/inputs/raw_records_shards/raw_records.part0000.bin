58},{"literal_text_all_w_t_and_m_t":"ssrUpdateInterval-r16INTEGER (0..15),","paragraph_zero_based":259},{"literal_text_all_w_t_and_m_t":"iod-ssr-r16INTEGER (0..15),","paragraph_zero_based":260},{"literal_text_all_w_t_and_m_t":"troposphericDelayQualityIndicator-r16BIT STRING (SIZE(6))OPTIONAL, -- Cond Tropo","paragraph_zero_based":261},{"literal_text_all_w_t_and_m_t":"correctionPointSetID-r16INTEGER (0..16383),","paragraph_zero_based":262},{"literal_text_all_w_t_and_m_t":"gridList-r16GridList-r16,","paragraph_zero_based":263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"402880a9d8f08f91fe24b048856b9780e089d79cd12536aba800d266be1e632a","original_member_sha256":"7cb6fb3149876999a30042fc450d0b566e79a928f6263bf65b46f1ac1a712180","paragraph_ElementTree_utf8_XML_sha256":["cfaec455c0641c9ac2c2c918ba822e99910b212a7c84b869f0f2caa69983e28a","4ef2390f7e1cb366f7a8a6f2b483ed14f813ee00f632f76af35a00cb665cb79b","c261ddbe9b656465acb8f870d025211b1959755fbbaf79aa35bd4239df58bdea","02f6c3618f1d3091dbee46c8de22c6eff753feef368d2a57a9399743144a8a39","9962dde733a0cb57bb83a294e144ac1f86e5bd93f81ed52986709d3d2070b06f","1640b471ae73d4c3d481cc5f83692e4197f5fc9f052cba1567bca2e2aefe668a","9fe9e5c9311e67bf0e9e3ffe0681c00690c4701d8e030c72a3be8da39a6978ac","34802dc67ce99b15f8eb881f47e04e356ef09907cc70d2e976834e079496dff9","760c671c50e67177ceac8915294e8c9f248ec41774bc2dc7cc21f036d0880002","0f6da92933db611f1cab06c0ba79601fba8bf3edab729b2decc9ee45cabde2ac","d128e1cb747191382c88ff1af90aaa92b82dbd7f623e98642f8d37e1d4645f63","6418e2688b36b831cc9c3c86aa06a6e9945194083a184702fb9d63fe8bdf8fd7","3ee268d5864cf7f63fba8a5c6fa1f7f0d638df0d31a617564b16f67e83ae7646","9b9323eaac08e7b5fef528e39bd8579bb74b3c54046cade237a6ec9c0f4940fe","4f078accd0e0b4b904a924c298a7f7897f44f6263c496d287aeebeb0413b682f","cd63b4f1017e04c12bc6db9ab701b767787e73fb49eed88fb36d5c9a45912062","3ba288ddd48fa86211e97384b4cf1cd78c4404996cc