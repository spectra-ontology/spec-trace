"original_member_sha256":"7efd55c589359846db5244076aa09f6bcb89b0414383a6c28a2936c9c5a14a52","paragraph_ElementTree_utf8_XML_sha256":["adef7ac69ef1f660840ddbdcb0f5f0c18f538054b45549a0ebc72f76fd6cc175","aaf148b311a7334ac6dccb8283fcb497770ddf939283e1c71432408af9fcbc50","88ef86aa6ab66eb43bbb9053282ada27f716a35286ebb7bbd92eee6e2fbe7ed4","e552e838f5f0592f641fc262c1c4497c5ab44f153a83b6e2fb5dc61f6c751248","a64b5ba33c610376ed5b45f42d6eee8abfe4727f9cdbd7d57935417122178fc7","9b3c6cd9a522bc55af7cf70b415d3e8f8b27ff4e1bd71df71ea4fdcd67f2b5ce","b3c86ba3369cc1beae438f788354a56400f3cdc0782fa024a438a3338c8f7bb2","62c971f8a43faa4d3580e02e52eb843b1f9043b5cbe8c6e382671bdcaece93b8","5a425b56d7b1dbcb47f345f9a302ba69691015d2c80864507ab025f730f8c59f","d34fe62b635842ed05c6075cdbb0b5799553a6935631b95239c4dbddfcda52f8","e55f03b89cc5fe7785852a9dfdc9884889ed1014401de482bb6e9bf692db9ce9","13142052944f5e5eb983a4f8e9331805371c04dae6a072e3150a46e616e20cd6","3a79936ed405e6aa8ef213fa92e6330fffe1d0c3fd6028caeec27e287ab9bb5e","dd5a29c5f08f1c5364382c04040a0b2433e173c537a4b6270bd7aa7ec515a31e","79ae3d1d9e891de6a3ff93b4a8415940f2b18fe0857252bbba7965813d8f7e5e","4ca4d2afa16e29f3be1e051c98ef476b27208a13984fed3c3a7677b5eaf4106c","24b034871d06a9a0e2d064a18316d052bb4bef3bbe2e947deab819d26856f954","8b16b0e364730cd728c8cd901da4e0c727b1728a7dc7c3224907bb2d8ffb07f5","f061a1074b49907a96a1e81b51e079dc33f1d3b29fb6a29b918a9fc0d7edd403","ce15836ce263e2360eda9db9606684983614c0f7afeefedf1d91d6c48320772b","f4117aad33b9b006ac767805442acd8a13c17d9a10fa9a90dbfe090279f51533","8f093b55144ab30f8a9e09b1505a9150ecf9be4c2c0129be2d00763e04247d76","1d8dbc0788e18ca0606c41377578942fcd99b3cd3ba34b7974f53e2c7a8d5651","4e9c5c6bc5bdb259c222a7e9afd67fd40e0b364dcbeacd7e608dd28a176980be"],"paragraph_range_zero_based":[24,47],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2301348.zip::R2-2301348.docx:p24"}
{"fields":{"filename":"R2-2301348.zip::R2-2301348.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"A","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Rel-17","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-16(Release 16)Rel-17(Release 17)Rel-18(Release 18)Rel-19(Release 19)","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":"Reason for change:","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"The condition for inclusion of the field sbas-ID in GNSS assistance data from TS 37.355 is not reflected in the posSIB definitions in TS 38.331.  This omission allows the possibility that a network sends GNSS assistance data in a posSIB that indicates applicability to both an SBAS and a (non-SBAS) GNSS, and a UE that receives such a posSIB does not know whether it should apply to the indicated GNSS or SBAS.","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"Alternatively, a network could indicate gnss-id=sbas, but then fail to include the sbas-id, and the UE would not know which SBAS the assistance data applied to.","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"The Need R condition on sbas-id in PosSIB-Type is changed to a condition indicating that sbas-id is mandatory present if gnss-id is set to sbas, and absent otherwise.","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"Network may confuse UEs by sending inconsistent metadata for a posSIB.","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"c37d2c372d2d4dda207570d35e3c89e967553baf9e0729526482088f9dbec876","original_member_sha256":"7efd55c589359846db5244076aa09f6bcb89b0414383a6c28a2936c9c5a14a52","paragraph_ElementTree_utf8_XML_sha256":["fb81bde750ea38707bcb110047ff55614c48425e2377f683ba153b530d62ad0d","4a4bbccd5c000deb17823d91f140b4b33ccc63e340765550d456292653bebcc3","a6bb41e92caeae41bd1a8971b7bdfd887cbd281c08c77ba30c2de841e586be06","e967edf1c5fbc5516b1b38cdc2d4d988ec06c7764ce1ac2b6680407603b0c715","2efa676b518f8d1638054768bbe5f5f64bdb082fe226d062018650bb7d067527","9d528454500d7acbf30935b3fd3e1c4a739330e13fb6f86afaeee6b06207db48","326d68a103d26811ba309014c0316983a24b3ad7755eb7cb395aacf1145760d2","744b23c3d5ae28600d8b8ddacffa24205c66a11967a68405a59d256c5716323e","6dd6852243b6f42395711cb2b20e9dfeffa80c5728d595083ab97dbb05598c98","e30e65b844d2bb66a25913869a09203a0a5b3044e04b4430f40d262ac0e7