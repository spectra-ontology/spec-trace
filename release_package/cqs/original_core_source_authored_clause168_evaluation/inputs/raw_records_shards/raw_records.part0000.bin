{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10920},{"literal_text_all_w_t_and_m_t":"-- TAG-SCGFAILUREINFORMATION-STOP","paragraph_zero_based":10921},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":10922},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10923},{"literal_text_all_w_t_and_m_t":"SCGFailureInformation field descriptions","paragraph_zero_based":10924},{"literal_text_all_w_t_and_m_t":"measResultFreqList","paragraph_zero_based":10925},{"literal_text_all_w_t_and_m_t":"The field contains available results of measurements on NR frequencies the UE is configured to measure by measConfig.","paragraph_zero_based":10926},{"literal_text_all_w_t_and_m_t":"measResultSCG-Failure","paragraph_zero_based":10927},{"literal_text_all_w_t_and_m_t":"The field contains the MeasResultSCG-Failure IE which includes available results of measurements on NR frequencies the UE is configured to measure by the NR SCG RRCReconfiguration message. ","paragraph_zero_based":10928},{"literal_text_all_w_t_and_m_t":"previousPSCellId","paragraph_zero_based":10929},{"literal_text_all_w_t_and_m_t":"This field indicates the physical cell id and carrier frequency of the cell that is the source PSCell of the last PSCell change.","paragraph_zero_based":10930},{"literal_text_all_w_t_and_m_t":"failedPSCellId","paragraph_zero_based":10931},{"literal_text_all_w_t_and_m_t":"This field indicates the physical cell id and carrier frequency of the cell in which SCG failure is detected or the target PSCell of the failed PSCell change or failed PSCell addition.","paragraph_zero_based":10932},{"literal_text_all_w_t_and_m_t":"timeSCGFailure","paragraph_zero_based":10933},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the time elapsed since the last execution of RRCReconfiguration with reconfigurationWithSync for the SCG until the SCG failure. Actual value = field value * 100ms. The maximum value 1023 means 102.3s or longer.","paragraph_zero_based":10934},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10935},{"literal_text_all_w_t_and_m_t":"–SCGFailureInformationEUTRA","paragraph_zero_based":10936},{"literal_text_all_w_t_and_m_t":"The SCGFailureInformationEUTRA message is used to provide information regarding E-UTRA SCG failures detected by the UE.","paragraph_zero_based":10937},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1","paragraph_zero_based":10938},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":10939},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":10940},{"literal_text_all_w_t_and_m_t":"Direction: UE to Network","paragraph_zero_based":10941},{"literal_text_all_w_t_and_m_t":"SCGFailureInformationEUTRA message","paragraph_zero_based":10942},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":10943}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["c82e887946a3af5998ece07f281dc419801b45971ed5b3361baa4c05cf15b9b8","a4f808380561e1685dbffe574d307c87a549df8039435d470c1ab2f6ead05681","3cce66cf7e7e9cd94309e866b082c6f6216d0d548442e58b16f3d9c3cf5a35ad","9331b6eb5104d9b0c94bd15b66a12b2b183e8e5f9c87b4e826bb8d289e052e07","3e5e220412c73c8f1732491f7259763e2e5d4a0445ab07bbba249a982dc798fe","1d579f32ec524913420587f3292b65c8883bcd84320c0a6d08772911ada7cb0e","f7441b64913ec4b60547fc2552537441353067951b16368df6ccee3663b7f973","15ce9fe5cf1c483590f6a5dc9334c0194e14a0d8d6408bb037b97dcbd2cdd8c5","08fd8c0d60c7fb52d8981d5b2b673c49cfcb3d12a386dd939e9f027f3c28963a","06a67d743