{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"C","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Rel-18","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-16(Release 16)Rel-17(Release 17)Rel-18(Release 18)Rel-19(Release 19)","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":"Reason for change:","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"The geographical coordinates of a TRP may be provided to an LMF in global coordinates (WGS84) or in local Cartesian coordinates as defined in TS 38.455. However, LPP currently supports global coordinates for the TRP locations and UE location estimates only.","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":" Local coordinates are introduced according to TS 23.032.","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":" Location coordinates can only be provided in global coordinates (WGS84).","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["a8ef55ed4defed0b284c3bedef986ba00905f1f148c98f5729e3ad4fdddfbd21","8c993343433284758be0140479bbc14d1b95599ed3fb2d5e1667ca1efaf0f554","fa9daa9722210953bd61ddef3d5e2408cfd815ce6c5328ff296628159ad35c48","d6edfaa74c0562bd3d92e4353e8bd240da24f7ff304e4c69bee7bc11ef8ca3fa","4772ea77156da99303564687a74c43e5c2decb6e149c1eee8ef5410d18f564f9","29eedcb715e1cff4dd98544f860ada1aa011ee9255f417b4660d70a913d97c5f","3fb6db18bd7169f5391860584c564cadadb8684ff753af80d0db2b4f7717405f","5761c4484eb82ea5b0b3492110603f8b4d0400c01ae929d9b0175542517d63f8","884b9e6adb1567c362636d79ec63592a55156dc8504730f1ea858f5b25e892cf","d04210b6868f6fecbfbb68b5a9e71cc99c2abef8ace2c8d2c3519ad53a7d9525","0453a7448bd17b69842e62ef273ab1d8aaff12fe80cf5faf9a24642a42f5ea35","940d451a02ae9bffcf4ab91d5d68521ebba0717731fc0be73256ae03fe89c47a","1d838f4c5cca933928acd6e82524e76c101ec8b08e6c8e942512c6e8fa8a1baf","dd0c9337c9d38b2f7b56078a4696340d328ae0daa8d57009320b9b24749217ed","bcbf066f9c514e0867d31ebcefef3c32933eca51ac787aafb5527e1cbab55c74","96ce32848d1d938258e1757c9b18696b38be3a6dcbb