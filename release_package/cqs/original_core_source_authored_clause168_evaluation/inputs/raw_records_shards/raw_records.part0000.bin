{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39696},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39697},{"literal_text_all_w_t_and_m_t":"–SL-UE-SelectedConfig","paragraph_zero_based":39698},{"literal_text_all_w_t_and_m_t":"IE SL-UE-SelectedConfig specifies sidelink communication configurations used for UE autonomous resource selection.","paragraph_zero_based":39699},{"literal_text_all_w_t_and_m_t":"SL-UE-SelectedConfig information element","paragraph_zero_based":39700},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39701},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-UE-SELECTEDCONFIG-START","paragraph_zero_based":39702},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39703},{"literal_text_all_w_t_and_m_t":"SL-UE-SelectedConfig-r16 ::=                 SEQUENCE {","paragraph_zero_based":39704},{"literal_text_all_w_t_and_m_t":"    sl-PSSCH-TxConfigList-r16                    SL-PSSCH-TxConfigList-r16                                   OPTIONAL,    -- Need R","paragraph_zero_based":39705},{"literal_text_all_w_t_and_m_t":"    sl-ProbResourceKeep-r16                      ENUMERATED {v0, v0dot2, v0dot4, v0dot6, v0dot8}             OPTIONAL,    -- Need R","paragraph_zero_based":39706},{"literal_text_all_w_t_and_m_t":"    sl-ReselectAfter-r16                         ENUMERATED {n1, n2, n3, n4, n5, n6, n7, n8, n9}             OPTIONAL,    -- Need R","paragraph_zero_based":39707},{"literal_text_all_w_t_and_m_t":"    sl-CBR-CommonTxConfigList-r16                SL-CBR-CommonTxConfigList-r16                               OPTIONAL,    -- Need R","paragraph_zero_based":39708},{"literal_text_all_w_t_and_m_t":"    ul-PrioritizationThres-r16                   INTEGER (1..16)                                             OPTIONAL,    -- Need R","paragraph_zero_based":39709},{"literal_text_all_w_t_and_m_t":"    sl-PrioritizationThres-r16                   INTEGER (1..8)                                              OPTIONAL,    -- Need R","paragraph_zero_based":39710},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":39711},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39712},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39713},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-UE-SELECTEDCONFIG-STOP","paragraph_zero_based":39714},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39715},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39716},{"literal_text_all_w_t_and_m_t":"SL-UE-SelectedConfig field descriptions","paragraph_zero_based":39717},{"literal_text_all_w_t_and_m_t":"sl-PrioritizationThres","paragraph_zero_based":39718},{"literal_text_all_w_t_and_m_t":"Indicates the SL priority threshold, which is used to determine whether SL TX is prioritized over UL TX, as specified in TS 38.321 [3]. Network does not configure the sl-PrioritizationThres and the ul-PrioritizationThres to the UE separately.","paragraph_zero_based":39719}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["f30cdc5a3afbf9dbc815da6d375aad3c6bac603c41557d7c6eee9aa0362ce954","75965baa9b80c5069a4d4fc3e6c56ca826d9251696855f292975077263acef4c","925449bb2c01cbdb01d91cc9aeba9343160c18ef44330e7863024623600c651a","85cd6b71f321e91b1a0a130bb029f9dfb58398ce655a36e99a03042e9c0c9e6a","5cbe9e046570bf762bca1b2e94760a655a84f669ef6fd8442a96d2edc906e715","a55bc7bcfb1be91203582cbb46511613ef47e08da8f7201907bb355138397656","ee437ba39c869d720d833f63064de3790c35fca41a46ae367641dac3e670552b","4ef88f3af196cdfdad2520194cb5327ea225e9857933c92494efd1d4dccd68b9","7a7fd42dbdb17f6bdeeeb1ed01f7566f506e47e121773618b627d454466c30bf","b79982da5cb589c6a78ad9fba65a43c10b1b6253a4c5458121ac21d648d2ff1f","ff9783c9af32cc08c9497fae874b2cff9935502ff87ada13dced9abf96984b79","cd09351e3491f6a4c1c0498365f2d1aeea6d6982469b47f07f2a2e5fa6408d84","d22b07f6e04fb2f1648a6484693bce2c0f45f7389d89ba972d3a41de86bd4dd7","22e943b02f54438e042207be425a4a5f9001232b1e471007cc1458e98c6075db","3e2a2c13f3b6a6b1de6d8170d0fa53589c2e265cb0ed5adfc14d4b3150a440d5","32ad3df4cbef61a7fb9c596aa64b8559325a31074ad6f3f9587bc7b745ae6335","4661c97e872bb2ced13383fba93c085bdf8b6fe5488e9907582bf484e7bcd70c","595f045dd871628e3b696a7e2c9f1acf664d8ae1021f7f1a10bd325fcfd305d9","9ee20baf50c870e3b9554322f7056648793c8418de670130b88a01ffef5d4350","628dc69e9d627ef3e411ddf2f5214db44f8572ffcd0b12e9892d94a2b56fb87e","d2f0e2adcfe7ed26abe5dfb136f8ba236f3b93028a9ce4e2effc600dab30005f","f771db94b59ed4989ffb4ea1b98173202792c842aef21b643268faed9bc6103a","06d7a68c77201ef9f23c17d5e3cc43ead93d66280555db36d49a66e8021f3d7e","32a098bffda32dbab2776a835f6cfbfdf15a9c20afb66c5da32b85627c8178fd"],"paragraph_range_zero_based":[39696,39719],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p39696"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-ProbResourceKeep","paragraph_zero_based":39720},{"literal_text_all_w_t_and_m_t":"Indicates the probability with which the UE keeps the current resource when the resource reselection counter reaches zero for sensing based UE autonomous resource selection (see TS 38.321 [3]).","paragraph_zero_based":39721},{"literal_text_all_w_t_and_m_t":"sl-PSSCH-TxConfigList","paragraph_zero_based":39722},{"literal_text_all_w_t_and_m_t":"Indicates PSSCH TX parameters such as MCS, sub-channel number, retransmission number, associated to different UE absolute speeds and different synchronization reference types for UE autonomous resource selection.","paragraph_zero_based":39723},{"literal_text_all_w_t_and_m_t":"sl-ReselectAfter","paragraph_zero_based":39724},{"literal_text_all_w_t_and_m_t":"Indicates the number of consecutive skipped transmissions before triggering resource reselection for sidelink communication (see TS 38.321 [3]).","paragraph_zero_based":39725},{"literal_text_all_w_t_and_m_t":"ul-PrioritizationThres","paragraph_zero_based":39726},{"literal_text_all_w_t_and_m_t":"Indicates the UL priority threshold, which is used to determine whether SL TX is prioritized over UL TX, as specified in TS 38.321 [3]. Network does not configure the sl-PrioritizationThres and the ul-PrioritizationThres to the UE separately.","paragraph_zero_based":39727},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39728},{"literal_text_all_w_t_and_m_t":"–SL-ZoneConfig","paragraph_zero_based":39729},{"literal_text_all_w_t_and_m_t":"The IE SL-ZoneConfig is used to configure the zone ID related parameters.","paragraph_zero_based":39730},{"literal_text_all_w_t_and_m_t":"SL-ZoneConfig information element","paragraph_zero_based":39731},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39732},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-ZONECONFIG-START","paragraph_zero_based":39733},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39734},{"literal_text_all_w_t_and_m_t":"SL-ZoneConfig-r16 ::=              SEQUENCE {","paragraph_zero_based":39735},{"literal_text_all_w_t_and_m_t":"    sl-ZoneLength-r16                  ENUMERATED { m5, m10, m20, m30, m40, m50, spare2, spare1},","paragraph_zero_based":39736},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":39737},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39738},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39739},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-ZONECONFIG-STOP","paragraph_zero_based":39740},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39741},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39742},{"literal_text_all_w_t_and_m_t":"SL-ZoneConfig field descriptions","paragraph_zero_based":39743}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["71f9077e2bf07d306480569d898c9fda9474f3d4bea892202f5409c3fba977ce","54ed13529b50a65041e6e78c07eddd1ba9bec1416fb655c12ae4093fda660e05","20ed37d0b3e4e2c79b5268f3fb1eef3a4a78c0bdb5e4d9cb9f3814f13bd1508c","ed86d36de6d2ca8b3a4b05223cec532020797d9d2124d040dbf23f149feeee86","c06ad6464879a7a5fe225915109bea86f6bb1e7090d131224e947f224479a5b6","05282a5a12bb9f4757fbc079dadcd8d0c51b7a5ed371a528e16f3fbb8532085a","ee791699a3f000afe9a4df638f7e8abd697036e0a0cefd7844e688a07d0aeb6b","fa5e978da209606212208dfc1228206bbda93237da807b866abb4b462fcce4e0","42488f17304abe5deee8d25fda03347eab338e95bb1c2470109d80955cdc7956","64b07cef9352407fb56535d1179dc3684b0d4e78ae167974f9a3e5ee89dbf