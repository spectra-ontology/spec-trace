cefdb7ba4bbc0d","83e214f7e8722c0c488b16f421d2435c31af09f3f52b3bacf46bf157ad40b0af","8087e0b256786debe86d291ccdcc06c52df6d6de8a6c8282eeed4711bc4dce2e","531f1dec9c5340c8da2f20e7f28d8862ca9ee6e73807f86ab27105951c4fdffd","84e000da6d0a556440e1de60f375b2e6699c1ae87e9e965ec5ba527b2497f072","c9a8aa835061c36c453db5886ce454eb0cf1787a7d673d770dfe8e3311b1fcc4","1aef104808f0423bf719eea2421059b81e1be87ab94fa58b274bac67674ca069","1d246dfb465490111918c3e4e8648f80ec33aa7d117c82c771ea783500eb6054","2c8f8f0049f5e64d151433aec09129ad544d6b154f8037a93a5bfc414237bb5f","6cf47902c57b2ee40f019d2174bada44d2158585c2ef21a1173e3a30ac182b79","7b299806e5e24a81a7f7cf46dbda3f473db2de2967eee6241f205fc473e00d27","c076a0b4ab9c49b16fb2a94cf3154a60a07243cbc94d584a20b4fb512fa583c0","7ff1f95a946c5e348328a89012feaedc3588a0aa268a9a8cbfb707e441d5c016","28e45397fc16c8e0683d75fe7c415b7b2345d595d8f58c0c880aee1d1a82a094"],"paragraph_range_zero_based":[30336,30359],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p30336"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    shift7dot5kHz-r17          BOOLEAN","paragraph_zero_based":30360},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30361},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30362},{"literal_text_all_w_t_and_m_t":"DefaultDC-Location-r17 ::= CHOICE {","paragraph_zero_based":30363},{"literal_text_all_w_t_and_m_t":"    ul                         FrequencyComponent-r17,","paragraph_zero_based":30364},{"literal_text_all_w_t_and_m_t":"    dl                         FrequencyComponent-r17,","paragraph_zero_based":30365},{"literal_text_all_w_t_and_m_t":"    ulAndDL                    FrequencyComponent-r17","paragraph_zero_based":30366},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30367},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30368},{"literal_text_all_w_t_and_m_t":"FrequencyComponent-r17 ::=  ENUMERATED {activeCarrier,configuredCarrier,activeBWP,configuredBWP}","paragraph_zero_based":30369},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30370},{"literal_text_all_w_t_and_m_t":"-- TAG-UPLINKTXDIRECTCURRENTMORECARRIERLIST-STOP","paragraph_zero_based":30371},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":30372},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30373},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentMoreCarrierList and CC-Group field descriptions","paragraph_zero_based":30374},{"literal_text_all_w_t_and_m_t":"CC-Group","paragraph_zero_based":30375},{"literal_text_all_w_t_and_m_t":"The contiguous carriers sharing the same PA in an intra-band UL CA configuration. The UE shall report only one DC location for an intra-band CC combination with one active uplink carrier in case DefaultDC-Location is set to activeCarrier or activeBWP.","paragraph_zero_based":30376},{"literal_text_all_w_t_and_m_t":"defaultDC-Location","paragraph_zero_based":30377},{"literal_text_all_w_t_and_m_t":"Indicates the default DC location derivation option. The default Tx Direct Current is located at the mathematical center of the UE bandwidth, i.e. between the lower edge of the lowest subcarrier of the lowest frequency component and the upper edge of the highest subcarrier of the highest frequency component, rounded to the subcarrier grid of the lowest SCS defined for the component carrier on which the default Direct Current is located. The lowest and highest frequency components used for derivation of mathematical center are indicated by FrequencyComponent in the associated CC-Group, where the lowest frequency component and the highest frequency component may be the same. If the mathematical center of the UE bandwidth lands on frequencies where there is no subcarrier grid defined, the subcarrier grid of the lowest SCS of the nearest lower frequency component carrier shall be extended to cover the frequency of the mathematical default Direct Current location.","paragraph_zero_based":30378},{"literal_text_all_w_t_and_m_t":"offsetToDefault","paragraph_zero_based":30379},{"literal_text_all_w_t_and_m_t":"Indicates the DC location offset to the default DC location derived from defaultDC-Location. The lowest SCS in the CC group is used as the offset granularity. Value 0 respresents no offset.","paragraph_zero_based":30380},{"literal_text_all_w_t_and_m_t":"offsetValue is used in case DefaultDC-Location is set to configuredCarrier or configuredBWP. offsetlist is used in case DefaultDC-Location is set to activeCarrier or activeBWP. Each entity in this list corresponds to the entry in carriers combination in IntraBandCC-CombinationReqList of the intra-band CA component. For each CC group, the UE shall include the same number of entries, and listed in the same order as in CC-CombinationList. If DefaultDC-Location is set the activeCarrier, same offsetValue is signalled for all requested carriers combinations with same active carriers states(regardless of the active BWP index).","paragraph_zero_based":30381},{"literal_text_all_w_t_and_m_t":"servCellIndexHigher","paragraph_zero_based":30382},{"literal_text_all_w_t_and_m_t":"Indicates the serving cell index of the highest edge of the CC-Group. If asbsent, there is only one carrier in this group indicated by servCellIndexLower.","paragraph_zero_based":30383}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["f1e7ea9a67ff78e9560f26687e3f57709a554a9c7d4776bf43a76dfba6096bc4","0c15c691faaf25701051bfaf66b710793f38b1219ef075558c444124f4d6bf5c","4b63fb7f7803e5484c2bf55cfecb8edad9bf175e3c32ba735ba28a5322d034d0","26277ffbeec5d36ffd54ed5973e4db8f53fcd14015f63d1d98d520be3e8c63fb","b1b228374defa163df0e94a7f37f1b0e57fa987fede2125af2faf00db2a10bb4","4e2b6220471f5ea95248c1dcf516af9ff8809c9f2191256190079bf35cb654ba","7b47768162af749cafa39dca531c94cc00d2e5b439d2b61739017c71d175d6c1","5c0d5f6a7a3ec9a526614e28b028b5a2ccfc6c383ed2c6a886f909b2f6473db9","9796804f3a937d35ae1ac59a057c1c979baee5e897add2388b62020ef4623b98","9e6f36d4b70c0e3a3d617c29e8995e3ad92300953417ba6cf13e4a0e006e9ca6","a469dc78cc7caad22cc1e21dcaaba6a65dbcaabb519f3c7e8a8d0e3cbdb2bbe8","9f1f5c2c1304893ea8d55333b87856bcd43c6d2f4fa8457656319df5a9475ec3","dc7c68272abe7c34f006bdc34654d41c908efb4e341e7c097afe4c50fca359b1","41a4f88afcbc4e29d7a91069bf723fc4a52505df6c8b557b7b492b59169bbc80","4b865eb482847a8bd11212ffc7f42b55c6e2b9bcd7f200a22bf16b823866784f","3ccf446eb276d5ac3a3089cd8c0e08b0a740a2592a1a4b652456aedfebec4483","cbe4b5ae2503a0acd48a91dcebcbc5be665c2fe96f3b63fbd8d9a3db8b33b2ed","97f577a3df2183135f9f3f79769dddb0e9ed85d59530c44f8612efacdfbb9b85","41706e0e336b2cd67d25927ff8d976419a301f62d04133423fb204ffebcf06d2","da651bca651a4f1ddd1d9125c2d6830d9820a05be82a031a390f56037b8372f1","2480aace537bc91233d0552d88378960b1a547070b2853908de797d99d23a3ae","c186b7fe470b3a775dead16f17156cb443a8899c3fd5ab482465c302617ef748","edab7126968b898ef92829addfc1035ee0218ae026fa4c98cc832fd355ec2475","967cc8cac61a4752f7bc9540d844fa47fbb7d7909282a25dfda79d066a14bf37"],"paragraph_range_zero_based":[30360,30383],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p30360"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"servCellIndexLower","paragraph_zero_based":30384},{"literal_text_all_w_t_and_m_t":"Indicates the serving cell index of the lowest edge of the CC-Group.","paragraph_zero_based":30385},{"literal_text_all_w_t_and_m_t":"shift7dot5kHz","paragraph_zero_based":30386},{"literal_text_all_w_t_and_m_t":"Indicates whether there is 7.5 kHz shift or not. 7.5 kHz shift is applied if the field is set to true, otherwise 7.5 kHz shift is not applied.","paragraph_zero_based":30387},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30388},{"literal_text_all_w_t_and_m_t":"DefaultDC-Location field descriptions","paragraph_zero_based":30389},{"literal_text_all_w_t_and_m_t":"dl","paragraph_zero_based":30390},{"literal_text_all_w_t_and_m_t":"Indicates that the default DC location is derived based on the DL frequencies of the frequency component.","paragraph_zero_based":30391},{"literal_text_all_w_t_and_m_t":"ul","paragraph_zero_based":30392},{"literal_text_all_w_t_and_m_t":"Indicates that the default DC location is derived based on the UL frequencies of the frequency component.","paragraph_zero_based":30393},{"literal_text_all_w_t_and_m_t":"ulAndDL","paragraph_zero_based":30394},{"literal_text_all_w_t_and_m_t":"Indicates that the default DC location is derived based on the edge most frequencies among any DL and UL frequency components.","paragraph_zero_based":30395},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30396},{"literal_text_all_w_t_and_m_t":"–UplinkTxDirectCurrentTwoCarrierList","paragraph_zero_based":30397},{"literal_text_all_w_t_and_m_t":"The IE UplinkTxDirectCurrentTwoCarrierList indicates the Tx Direct Current locations when uplink intra-band CA with two carriers is configured, based on the configured carriers and BWP numerology and the associated carrier bandwidth of the carriers. The UE does not report the uplink Direct Current location information for SUL carrier(s).","paragraph_zero_based":30398},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentTwoCarrierList information element","paragraph_zero_based":30399},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":30400},{"literal_text_all_w_t_and_m_t":"-- TAG-UPLINKTXDIRECTCURRENTTWOCARRIERLIST-START","paragraph_zero_based":30401},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30402},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentTwoCarrierList-r16 ::=   SEQUENCE (SIZE (1..maxNrofTxDC-TwoCarrier-r16)) OF UplinkTxDirectCurrentTwoCarrier-r16","paragraph_zero_based":30403},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30404},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentTwoCarrier-r16 ::=       SEQUENCE {","paragraph_zero_based":30405},{"literal_text_all_w_t_and_m_t":"    carrierOneInfo-r16                            UplinkTxDirectCurrentCarrierInfo-r16,","paragraph_zero_based":30406},{"literal_text_all_w_t_and_m_t":"    carrierTwoInfo-r16                            UplinkTxDirectCurrentCarrierInfo-r16,","paragraph_zero_based":30407}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["b3c75f5dc5eb7e6def080f9764cd255fb4c4d6982e6a099f510844f6154c86ac","9b0e0806eff00e6c3fee7002cdd5c1213cadba7d91be8564019c750d47fed54e","28b720ba190fdcbafd1be1020124a7d7700d545599933ad067ee1569c52393ef","01ec90c58343643288e0347904d5b0dc5893d0bd00f2d9b368a65b77c6c11bd1","b22ae1376a0368e24220895c51a1697b774a0519c850c8c9868075d6a9d03f10","35a9cfd33b41d0fbe24ce9660a9eeed2886e6f10771fcee8a016d676a42277e5","58363cd1daf70839d906f2327cb26c