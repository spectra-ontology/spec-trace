{"fields":{"filename":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"For L2 U2N Remote UE, the field is optionally present, Need M. Otherwise, it is absent.","paragraph_zero_based":2496},{"literal_text_all_w_t_and_m_t":"L2U2N","paragraph_zero_based":2497},{"literal_text_all_w_t_and_m_t":"The field is optional present for L2 U2N Relay UE and L2 U2N Remote UE, need N. Otherwise, it is absent.","paragraph_zero_based":2498},{"literal_text_all_w_t_and_m_t":"U2URelayUE","paragraph_zero_based":2499},{"literal_text_all_w_t_and_m_t":"For U2U Relay UE, the field is optionally present, Need M. Otherwise, it is absent.","paragraph_zero_based":2500},{"literal_text_all_w_t_and_m_t":"U2URemoteUE","paragraph_zero_based":2501},{"literal_text_all_w_t_and_m_t":"For U2U Remote UE, the field is optionally present, Need M. Otherwise, it is absent.","paragraph_zero_based":2502},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2503},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2504},{"literal_text_all_w_t_and_m_t":"<<Skip Unchanged>>","paragraph_zero_based":2505},{"literal_text_all_w_t_and_m_t":"–SL-L2RelayUE-Config","paragraph_zero_based":2506},{"literal_text_all_w_t_and_m_t":"The IE SL-L2RelayUE-Config is used to configure L2 U2N relay operation related configurations used by L2 U2N Relay UE.","paragraph_zero_based":2507},{"literal_text_all_w_t_and_m_t":"SL-L2RelayUE-Config information element","paragraph_zero_based":2508},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":2509},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-L2RELAYUE-CONFIG-START","paragraph_zero_based":2510},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2511},{"literal_text_all_w_t_and_m_t":"SL-L2RelayUE-Config-r17 ::=        SEQUENCE {","paragraph_zero_based":2512},{"literal_text_all_w_t_and_m_t":"    sl-RemoteUE-ToAddModLi