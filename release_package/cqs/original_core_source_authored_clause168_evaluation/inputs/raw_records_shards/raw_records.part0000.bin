{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE UE-CapabilityRAT-RequestList is used to request UE capabilities for one or more RATs from the UE.","paragraph_zero_based":35976},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRAT-RequestList information element","paragraph_zero_based":35977},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":35978},{"literal_text_all_w_t_and_m_t":"-- TAG-UE-CAPABILITYRAT-REQUESTLIST-START","paragraph_zero_based":35979},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35980},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRAT-RequestList ::=        SEQUENCE (SIZE (1..maxRAT-CapabilityContainers)) OF UE-CapabilityRAT-Request","paragraph_zero_based":35981},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35982},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRAT-Request ::=            SEQUENCE {","paragraph_zero_based":35983},{"literal_text_all_w_t_and_m_t":"    rat-Type                                RAT-Type,","paragraph_zero_based":35984},{"literal_text_all_w_t_and_m_t":"    capabilityRequestFilter                 OCTET STRING                    OPTIONAL,   -- Need N","paragraph_zero_based":35985},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":35986},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":35987},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35988},{"literal_text_all_w_t_and_m_t":"-- TAG-UE-CAPABILITYRAT-REQUESTLIST-STOP","paragraph_zero_based":35989},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":35990},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35991},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRAT-Request field descriptions","paragraph_zero_based":35992},{"literal_text_all_w_t_and_m_t":"capabilityRequestFilter","paragraph_zero_based":35993},{"literal_text_all_w_t_and_m_t":"Information by which the network requests the UE to filter the UE capabilities.","paragraph_zero_based":35994},{"literal_text_all_w_t_and_m_t":"For rat-Type set to nr or eutra-nr: the encoding of the capabilityRequestFilter is defined in UE-CapabilityRequestFilterNR.","paragraph_zero_based":35995},{"literal_text_all_w_t_and_m_t":"For rat-Type set to eutra: the encoding of the capabilityRequestFilter is defined by UECapabilityEnquiry message defined in TS36.331 [10], in which RAT-Type in UE-CapabilityRequest includes only 'eutra'.","paragraph_zero_based":35996},{"literal_text_all_w_t_and_m_t":"rat-Type","paragraph_zero_based":35997},{"literal_text_all_w_t_and_m_t":"The RAT type for which the NW requests UE capabilities.","paragraph_zero_based":35998},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35999}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["42acccdbcae79d638854264eafeb23052dc97a7bf61ca4efd35179375f268378","9f4bba563a23b2ccc988593e3d5839f6cfce778b6db6faf9d5c7269a29f34859","9d1d0036e28e8a51509ab2265dfecacdf490a4f7c25ba56c8b7ac449af084942","fad840c92d5fb5aa1553055e6a855b515079dd6834f6dbdabebf5bac5943a7c2","9a14b581fb29ce543b96933375525a5af222e301ccd40bfd54d94cff6ceedd83","ae12eacbd48fe4abda1ca9f19b170ef1418a5b384a34dc1c4743cb5014a07437","a7529dfa8bea2344b91a558458d1e4b536d09385b42ed3faa05e3c494633f36c","fe1e066c91bd84008690b43f438daaec202d2a908afce5b49fa1723e24058040","1f9b557b9f6dd1719f07dc60938525e1ddc8caca13716c21d9a376c42f01c474","9c20b06a12fa51a87759622f3d3c1a9b77cb1f799ac27859d98165c21da790f9","b25513b74f82f5143b19be8b3817eecb96a311d1176e7b342e0c19a003b26b64","2ded8819eac8da5f6cd1f3f30309fb97bf339605b81d9628cddf7b3ae2