{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The field is mandatory present upon creation of a new sidelink logical channel via the dedicated signalling and in case of sidelink DRB configuration via system information and pre-configuration; otherwise the field is optionally present, Need M.","paragraph_zero_based":39336},{"literal_text_all_w_t_and_m_t":"LCH-SetupOnly","paragraph_zero_based":39337},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new sidelink logical channel via the dedicated signalling and in case of sidelink DRB configuration via system information and pre-configuration. Otherwise, it is absent, Need M.","paragraph_zero_based":39338},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39339},{"literal_text_all_w_t_and_m_t":"–SL-RLC-BearerConfigIndex","paragraph_zero_based":39340},{"literal_text_all_w_t_and_m_t":"The IE SL-RLC-BearerConfigIndex is used to identify a SL RLC bearer configuration.","paragraph_zero_based":39341},{"literal_text_all_w_t_and_m_t":"SL-RLC-BearerConfigIndex information element","paragraph_zero_based":39342},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39343},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RLC-BEARERCONFIGINDEX-START","paragraph_zero_based":39344},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39345},{"literal_text_all_w_t_and_m_t":"SL-RLC-BearerConfigIndex-r16 ::=                    INTEGER (1..maxSL-LCID-r16)","paragraph_zero_based":39346},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39347},{"literal_text_all_w_t_and_m_t":"-- TAG-RLC-BEARERCONFIGINDEX-STOP","paragraph_zero_based":39348},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39349},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39350},{"literal_text_all_w_t_and_m_t":"–SL-RLC-ChannelConfig","paragraph_zero_based":39351},{"literal_text_all_w_t_and_m_t":"The IE SL-RLC-ChannelConfig specifies the configuration information for PC5 Relay RLC channel between L2 U2N Relay UE and L2 U2N Remote UE.","paragraph_zero_based":39352},{"literal_text_all_w_t_and_m_t":"SL-RLC-ChannelConfig information element","paragraph_zero_based":39353},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39354},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RLC-RLC-CHANNEL-CONFIG-START","paragraph_zero_based":39355},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39356},{"literal_text_all_w_t_and_m_t":"SL-RLC-ChannelConfig-r17 ::=                  SEQUENCE {","paragraph_zero_based":39357},{"literal_text_all_w_t_and_m_t":"    sl-RLC-ChannelID-r17                          SL-RLC-ChannelID-r17,","paragraph_zero_based":39358},{"literal_text_all_w_t_and_m_t":"    sl-RLC-Config-r17                             SL-RLC-Config-r16                                 OPTIONAL,   -- Need M","paragraph_zero_based":39359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["9589df6919ac664fe2cd65a9dc029730e01a40ee006b9aa10c483a3dbac64caf","315344764cfe19f14c658af56caa0a98f6154b6a8ddeda22942a551711da2cd5","e75fe7b2f61347c5fcfa48bce7f938687dd4f43b7704efcbbfce36235ba23247","569899d8b3e9b16c7e02042c4f865994c566c322cff856d3390555b226341906","2822a967c9c9407d5a614d452b0edcd73ecf68854c1cf1d33642f2809f24d9ba","47e563bba490dbd867d131e073219df2a6d123929b430ff66db446b616476e9b","5f03f1b993ce6cb56c7d887630b5ee984e93b14453ac89d2489644ec1c407876","fc78a40e26550dfa87da21ab6bfeb354ff46ab2b81247bced6d0749478e0ff98","72372ff885d5b724b463febc6011b5b6f0da27e3eae933be3267ae81bd5bf6f9