{"fields":{"filename":"R2-2306537.zip::R2-2306537.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":144},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":145},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":146},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":147},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":148},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":149},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":150},{"literal_text_all_w_t_and_m_t":"RTK","paragraph_zero_based":151},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the IE GNSS-RTK-Observations is included in IE GNSSGenericAssistData; otherwise it is not present.","paragraph_zero_based":152},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":153},{"literal_text_all_w_t_and_m_t":"–GNSS-GenericAssistData","paragraph_zero_based":154},{"literal_text_all_w_t_and_m_t":"The IE GNSS-GenericAssistData is used by the location server to provide assistance data for a specific GNSS. The specific GNSS for which the provided assistance data are applicable is indicated by the IE GNSSID and (if applicable) by the IE SBASID. Assistance for up to 16 GNSSs can be provided.","paragraph_zero_based":155},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":156},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":157},{"literal_text_all_w_t_and_m_t":"GNSS-GenericAssistData ::= SEQUENCE (SIZE (1..16)) OF GNSS-GenericAssistDataElement","paragraph_zero_based":158},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":159},{"literal_text_all_w_t_and_m_t":"GNSS-GenericAssistDataElement ::= SEQUENCE {","paragraph_zero_based":160},{"literal_text_all_w_t_and_m_t":"gnss-IDGNSS-ID,","paragraph_zero_based":161},{"literal_text_all_w_t_and_m_t":"sbas-IDSBAS-IDOPTIONAL, -- Cond GNSS-ID-SBAS","paragraph_zero_based":162},{"literal_text_all_w_t_and_m_t":"gnss-TimeModelsGNSS-TimeModelListOPTIONAL,-- Need ON","paragraph_zero_based":163},{"literal_text_all_w_t_and_m_t":"gnss-DifferentialCorrectionsGNSS-DifferentialCorrectionsOPTIONAL,-- Need ON","paragraph_zero_based":164},{"literal_text_all_w_t_and_m_t":"gnss-NavigationModelGNSS-NavigationModelOPTIONAL,-- Need ON","paragraph_zero_based":165},{"literal_text_all_w_t_and_m_t":"gnss-RealTimeIntegrityGNSS-RealTimeIntegrityOPTIONAL,-- Need ON","paragraph_zero_based":166},{"literal_text_all_w_t_and_m_t":"gnss-DataBitAssistanceGNSS-DataBitAssistanceOPTIONAL,-- Need ON","paragraph_zero_based":167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"7ea3ea011934f6c0dae39181d4a24ce5ca5bc379d48c0313eb5c481ec4a3b095","original_member_sha256":"7e5d65269c396c98b3a6de240a7cc5f08aa736e14c814be48fe93773a39ba42f","paragraph_ElementTree_utf8_XML_sha256":["02548812258135768a08d4611091a5b64f1910da2376924e206c10977f42cb84","8d137e18812d513d0faf5a0e7b68d5537186e168d3280a8d3e0611b8dd5fd44b","23848f4bdb9b221cc1c55485de482b5fdd5733529cd5f346f1d7e8df306d3ddd","014043f7be59515bac2fe83f2a6390da5094e4d0cadcbc01d61e98f423396371","5247c25b50f4229f1468294bc3b4b058942b4a41bb60d917b948526b7fd4f847","d0521ba73b6f0dadda239f56debed7eec17daec9526611e06b6e9adbb0ad5b54","ed8ca22e3640ff0c56304048ef706268b331b6704bc969224d981ba2614a7ea8","b375490828fd4bf5797377a65d3908524aeecd552eb82b24bce5cc39d4cb51bf","979ba349efb31540d29d75895ae5a661b50ce08f3f6851bc23aedef377a63025","183086f46fb74544f491dc9b4137d880528c06a68dbcb67b06bd93c3e8191159","4a12eb7efbadeaa1da7639006300e4a0af0bfc4297d63f496b08130633e9619d","c2c9d5ba5776fad7138b3dedbae4ca0872dd09b9e6cdfb2081323db104702043","3e305c38140efeac1b00bcbe54a23275329c79c9f1aebfccbdf1221c9168b367","d5c12606e0d67bf03fa6af2c332386da0e4aed9565fd93d6e55ec4e745f4385b","b4b20b9c04e307fd53a046d68704a91e9b59556add3