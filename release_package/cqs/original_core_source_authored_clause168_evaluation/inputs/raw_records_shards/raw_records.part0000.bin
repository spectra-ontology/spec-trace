{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18384},{"literal_text_all_w_t_and_m_t":"DRX-ConfigSL field descriptions","paragraph_zero_based":18385},{"literal_text_all_w_t_and_m_t":"drx-HARQ-RTT-TimerSL","paragraph_zero_based":18386},{"literal_text_all_w_t_and_m_t":"For sidelink configured grant Type 1, value in number of symbols of the activated DL BWP of PCell. For other cases, value in number of symbols of the BWP where the PDCCH was transmitted. Value 0 is used in case sl-PUCCH-Config is not configured and the corresponding resource pool is not configured with PSFCH.","paragraph_zero_based":18387},{"literal_text_all_w_t_and_m_t":"drx-RetransmissionTimerSL","paragraph_zero_based":18388},{"literal_text_all_w_t_and_m_t":"For sidelink configured grant Type 1, value in number of slot lengths of the activated DL BWP of PCell. For other cases, value in number of slot lengths of the BWP where the PDCCH was transmitted. sl0 corresponds to 0 slots, sl1 corresponds to 1 slot, sl2 corresponds to 2 slots, and so on.","paragraph_zero_based":18389},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18390},{"literal_text_all_w_t_and_m_t":"–EphemerisInfo","paragraph_zero_based":18391},{"literal_text_all_w_t_and_m_t":"The IE EphemerisInfo provides satellite ephemeris. Ephemeris may be expressed either in format of position and velocity state vector in ECEF or in format of orbital parameters in ECI. Note: The ECI and ECEF coincide at epochTime, i.e., x,y,z axis in ECEF are aligned with x,y,z axis in ECI at epochTime.","paragraph_zero_based":18392},{"literal_text_all_w_t_and_m_t":"EphemerisInfo information element","paragraph_zero_based":18393},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18394},{"literal_text_all_w_t_and_m_t":"-- TAG-EPHEMERISINFO-START","paragraph_zero_based":18395},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18396},{"literal_text_all_w_t_and_m_t":"EphemerisInfo-r17 ::=          CHOICE {","paragraph_zero_based":18397},{"literal_text_all_w_t_and_m_t":"    positionVelocity-r17           PositionVelocity-r17,","paragraph_zero_based":18398},{"literal_text_all_w_t_and_m_t":"    orbital-r17                    Orbital-r17","paragraph_zero_based":18399},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18400},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18401},{"literal_text_all_w_t_and_m_t":"PositionVelocity-r17 ::=       SEQUENCE {","paragraph_zero_based":18402},{"literal_text_all_w_t_and_m_t":"    positionX-r17                  PositionStateVector-r17,","paragraph_zero_based":18403},{"literal_text_all_w_t_and_m_t":"    positionY-r17                  PositionStateVector-r17,","paragraph_zero_based":18404},{"literal_text_all_w_t_and_m_t":"    positionZ-r17                  PositionStateVector-r17,","paragraph_zero_based":18405},{"literal_text_all_w_t_and_m_t":"    velocityVX-r17                 VelocityStateVector-r17,","paragraph_zero_based":18406},{"literal_text_all_w_t_and_m_t":"    velocityVY-r17                 VelocityStateVector-r17,","paragraph_zero_based":18407}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["b07dfa9a0ffcf4b8f163d4478c011da3c84dc2b0d2f0a7c83da52ebd3fd1dff7","fb81f9d8846342eb0c24e6727bc81f3f47e0a9356525cb785d2f758c970a9cf3","6e0774ad7b2ede259b45c8ce162463cf13a23fb0edf60c3a459b4c066448df70","4f347e107e44f1c9ce29eeb2a1cf085e9eee2b51765bdc5f3ffc3608fc2d66a5","4e5bbe98cbecf7d1e8f5d48dede894a86535774a0030e54b9211d77792f9108d","9c78de1a4d49f5f2d9604c622e883c40