{"fields":{"filename":"R2-2305059.zip::R2-2305059 38331_Correction_FD_SL_Relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"F","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Rel-17","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-16(Release 16)Rel-17(Release 17)Rel-18(Release 18)Rel-19(Release 19)","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":" Reason for change:","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"According to the initiation procedure 5.8.3.3, the SUI message uses for L3 Relay UE or L3 Remote UE will just use sl-TxResourceReqL3U2N-Relay, which is as same as R16 legacy sl-TxResourceReq structure. Therefore, the sl-DestinationIdentityL2U2N will not be used by L3 remote or L3 relay.","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"Removed the L3 Remote UE and L3 Relay UE from the field descriotion of sl-DestinationIdentityL2U2N.","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"Impact analysis","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"Impacted functionality: ","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"Actions related to SUI initaiton.","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"86fada5ff07263f82a7ae2684ffc6687b5dedba803d73277e43f49470661bd2e","original_member_sha256":"55341d84f1383c55565e46179ecc3fb961a2efa6d1be571bfc13d4a345f73303","paragraph_ElementTree_utf8_XML_sha256":["e4ea5591218aa96d0cd407936b651eb165fb4c75e229dab64ec9de6be991cb96","2d00e3b1a82065155328ddd802c3d4a8ebff11f4a0d6da9ecf9b1e34dc8ebfc8","285a8c8799db0481a805d2aec7ce7fc209db7244f09ed6018ec158f8b79d2b31","761fa4d36b282591b5f5bb5ee554c6086f6eb9d5925f257d405f142f9e3a17e1","9ee3a8ef1b4d8b5d23ae68c79878f83d9a7ffdf02ec93cff53f7b1de6029f4d6","062ab817e3a0ceb9c24fb32e82a4a4427541cd05a1cec04900557d158c3df865","b08252b53f111fda758564f01d6aeb287a86ceee9730eba0ca5fcf7c7dadb00e","5397ebe3cc2afa3393b897343a62f60e5b485315d8236802a715ec930f5cc336","c7f154badb51090dd578312419bcf46f1ff9111557a952165c0ca920b2e5af4d","1257bef6de0d6fbcb35da4ad9e5d1d2efb40539d216438a199be822d1e60e855","16c8d70f7d429c511b56c375317337c5d5c75b5a185ec91bf088b77069963fb7","acd6206245de4b9556a4853ff1b8b41875944834aa76df6c7d72af763f365262","6318240db9ef9ff789b2c42279fc4a12aa709d231c796ced014c8a9651101984","4c90b609a079b29456afb34bef7de2610e9c95a71e2ad9b407d03ad85aaa0454","8546cc36f7d39fd1a9f5fc73aac57827695c21a77222a9d69aa1294db8fcbb98","8b245