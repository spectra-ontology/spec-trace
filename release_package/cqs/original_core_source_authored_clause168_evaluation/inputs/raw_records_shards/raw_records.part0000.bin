                   CHOICE {","paragraph_zero_based":28262},{"literal_text_all_w_t_and_m_t":"        type1-r17                           ENUMERATED {sibType15, sibType16, sibType17, sibType18, sibType19, sibType20, sibType21,","paragraph_zero_based":28263},{"literal_text_all_w_t_and_m_t":"                                                        spare9, spare8, spare7, spare6, spare5, spare4, spare3, spare2, spare1,...},","paragraph_zero_based":28264},{"literal_text_all_w_t_and_m_t":"        type2-r17                           SEQUENCE {","paragraph_zero_based":28265},{"literal_text_all_w_t_and_m_t":"            posSibType-r17                      ENUMERATED {posSibType1-9, posSibType1-10, posSibType2-24, posSibType2-25,","paragraph_zero_based":28266},{"literal_text_all_w_t_and_m_t":"                                                            posSibType6-4, posSibType6-5, posSibType6-6, spare9, spare8, spare7, spare6,","paragraph_zero_based":28267},{"literal_text_all_w_t_and_m_t":"                                                            spare5, spare4, spare3, spare2, spare1,...},","paragraph_zero_based":28268},{"literal_text_all_w_t_and_m_t":"            encrypted-r17                       ENUMERATED { true }                                     OPTIONAL, -- Need R","paragraph_zero_based":28269},{"literal_text_all_w_t_and_m_t":"            gnss-id-r17                         GNSS-ID-r16                                             OPTIONAL, -- Need R","paragraph_zero_based":28270},{"literal_text_all_w_t_and_m_t":"            sbas-id-r17                         SBAS-ID-r16                                             OPTIONAL  -- Need R","paragraph_zero_based":28271}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b5