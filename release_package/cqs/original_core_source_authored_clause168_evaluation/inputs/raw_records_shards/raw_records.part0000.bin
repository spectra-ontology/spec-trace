                              -- config, secondary PUCCH group config} for PUCCH cell switching","paragraph_zero_based":40114},{"literal_text_all_w_t_and_m_t":"maxCBR-Config-r16                       INTEGER ::= 8       -- Maximum number of CBR range configurations for sidelink communication","paragraph_zero_based":40115},{"literal_text_all_w_t_and_m_t":"                                                            -- congestion control","paragraph_zero_based":40116},{"literal_text_all_w_t_and_m_t":"maxCBR-Config-1-r16                     INTEGER ::= 7       -- Maximum number of CBR range configurations for sidelink communication","paragraph_zero_based":40117},{"literal_text_all_w_t_and_m_t":"                                                            -- congestion control minus 1","paragraph_zero_based":40118},{"literal_text_all_w_t_and_m_t":"maxCBR-Level-r16                        INTEGER ::= 16      -- Maximum number of CBR levels","paragraph_zero_based":40119},{"literal_text_all_w_t_and_m_t":"maxCBR-Level-1-r16                      INTEGER ::= 15      -- Maximum number of CBR levels minus 1","paragraph_zero_based":40120},{"literal_text_all_w_t_and_m_t":"maxCellExcluded                         INTEGER ::= 16      -- Maximum number of NR exclude-listed cell ranges in SIB3, SIB4","paragraph_zero_based":40121},{"literal_text_all_w_t_and_m_t":"maxCellGroupings-r16                    INTEGER ::= 32      -- Maximum number of cell groupings for NR-DC","paragraph_zero_based":40122},{"literal_text_all_w_t_and_m_t":"maxCellHistory-r16                      INTEGER ::= 16      -- Maximum number of visited PCells reported","paragraph_zero_based":40123},{"literal_text_all_w_t_and_m_t":"maxPSCellHistory-r17                    INTEGER ::= 16      -- Maximum number of visited PSCells across all reported PCells","paragraph_zero_based":40124},{"literal_text_all_w_t_and_m_t":"maxCellInter                            INTEGER ::= 16      -- Maximum number of inter-Freq cells listed in SIB4","paragraph_zero_based":40125},{"literal_text_all_w_t_and_m_t":"maxCellIntra                            INTEGER ::= 16      -- Maximum number of intra-Freq cells listed in SIB3","paragraph_zero_based":40126},{"literal_text_all_w_t_and_m_t":"maxCellMeasEUTRA                        INTEGER ::= 32      -- Maximum number of cells in E-UTRAN","paragraph_zero_based":40127}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["6b8b99a9687dba632a3f855fe5ae47e632e7afa68cd5a8955c191566ad29f841","3a4426a215885643359fba83601800e8494e578c0f45d10a969193fa25b12313","44cd15e47693041066be997d8f99d4dd22b18bcba40e5e6ab969e8effeea5eff","3b8a81674ac7b26d70ed4b0057e6ac4ea56d96a12d9f069c437653ef96ceae8c","5f5a281bafada57f2708788537f49e903a600466e66e6fc0b8a086f6d8be314c","df7185a47856985669f3ee8d7cf1a4b77aa39f166e7ff5dba6488a9c24c27e2b","a5340fec5fd7efdd114c41e2e1e8aedd45e322a2db29235efb6a4ad2f93f16bb","fb61573e25d0d5d150a2e598bde56697acea747cdc34e04862632b8728f97193","583125de52fb4bb1464ff83ae2574ecb1076ab51c585bdf4052d120b56ccd471","93d9a9463aa1f301e0544e5929a472eed94dcf8567a64f62380e74064a0ab1ed","730f5a90e7b70c1f7af8c30850e5719e8a7015f1240e67280f47079e1c92ff9e","804547069b197d76169d73814290bcdcbce3887d3662eac1c80f6f11dfe118c9","912b201026d33f01b845137a422ca46a50fa753610ad9a6d4c773af388f4c43c","e8574d8702625fc42e4e54c76cd0c532bfef84e9210ff2a127397df6cc8f65fa","b7ce447326f2a5fe898be78fb5f593c2d8101969efae6a23675dbe2d24b5202a","63c79857a74b6e3c8f4226ac4078d42e64e33dd81e27fbf642c8e7a2ec79d0ae","a621dcc03e719555085249cbd8e8e702d5e638efd15c999e2756687c3ccebf91","343a467a70c0bd41b98e12873a372057e114cc18ad5378854af06723e5e1e71b","ec6d21a0c087913d4865f16f64982c7c57c8ff625dde83da0988316e05f44b6c","