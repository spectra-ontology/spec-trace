{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":37416},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37417},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37418},{"literal_text_all_w_t_and_m_t":"-- TAG-VISITEDCELLINFOLIST-STOP","paragraph_zero_based":37419},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":37420},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37421},{"literal_text_all_w_t_and_m_t":"VisitedCellInfoList field descriptions","paragraph_zero_based":37422},{"literal_text_all_w_t_and_m_t":"timeSpent","paragraph_zero_based":37423},{"literal_text_all_w_t_and_m_t":"This field indicates the duration of stay in the cell or in any cell selection state and/or camped on any cell state in NR or E-UTRA approximated to the closest second. If included in VisitedPSCellInfo, it indicates the duration of stay in the PSCell or without any PSCell. If the duration of stay exceeds 4095s, the UE shall set it to 4095s.","paragraph_zero_based":37424},{"literal_text_all_w_t_and_m_t":"visitedCellId","paragraph_zero_based":37425},{"literal_text_all_w_t_and_m_t":"This field indicates the visited cell id including NR and E-UTRA cells.","paragraph_zero_based":37426},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37427},{"literal_text_all_w_t_and_m_t":"–WLAN-NameList","paragraph_zero_based":37428},{"literal_text_all_w_t_and_m_t":"The IE WLAN-NameList is used to indicate the names of the WLAN AP for which the UE is configured to measure.","paragraph_zero_based":37429},{"literal_text_all_w_t_and_m_t":"WLAN-NameList information element","paragraph_zero_based":37430},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":37431},{"literal_text_all_w_t_and_m_t":"-- TAG-WLANNAMELIST-START","paragraph_zero_based":37432},{"l