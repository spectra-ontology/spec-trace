,{"literal_text_all_w_t_and_m_t":"    srb4-ToRelease-r17                      ENUMERATED{true}                                        OPTIONAL    -- Need N","paragraph_zero_based":25284},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":25285},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25286},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25287},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25288},{"literal_text_all_w_t_and_m_t":"SRB-ToAddModList ::=                    SEQUENCE (SIZE (1..2)) OF SRB-ToAddMod","paragraph_zero_based":25289},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25290},{"literal_text_all_w_t_and_m_t":"SRB-ToAddMod ::=                        SEQUENCE {","paragraph_zero_based":25291},{"literal_text_all_w_t_and_m_t":"    srb-Identity                            SRB-Identity,","paragraph_zero_based":25292},{"literal_text_all_w_t_and_m_t":"    reestablishPDCP                         ENUMERATED{true}                                        OPTIONAL,   -- Need N","paragraph_zero_based":25293},{"literal_text_all_w_t_and_m_t":"    discardOnPDCP                           ENUMERATED{true}                                        OPTIONAL,   -- Need N","paragraph_zero_based":25294},{"literal_text_all_w_t_and_m_t":"    pdcp-Config                             PDCP-Config                                             OPTIONAL,   -- Cond PDCP","paragraph_zero_based":25295}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["645be3c6ef854addeefe8d4f53e7019910be103baf92ee2cf44c10b903ce7200","3057295cf04e3d6431169195ebfc23e7fc06898889bebe83a6d48caaf807f13b","9421248b3a3d505f590c02320c38d0252ea095e48b83f36e5f8b