{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"For 960 kHz SCS, {1..1280} are valid.","paragraph_zero_based":22296},{"literal_text_all_w_t_and_m_t":"The network configures the same value for all serving cells in the same CellGroupForSwitch.","paragraph_zero_based":22297},{"literal_text_all_w_t_and_m_t":"slotFormatIndicator","paragraph_zero_based":22298},{"literal_text_all_w_t_and_m_t":"Configuration of Slot-Format-Indicators to be monitored in the correspondingly configured PDCCHs of this serving cell.","paragraph_zero_based":22299},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22300},{"literal_text_all_w_t_and_m_t":"–PDCP-Config","paragraph_zero_based":22301},{"literal_text_all_w_t_and_m_t":"The IE PDCP-Config is used to set the configurable PDCP parameters for signalling, MBS multicast and data radio bearers.","paragraph_zero_based":22302},{"literal_text_all_w_t_and_m_t":"PDCP-Config information element","paragraph_zero_based":22303},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":22304},{"literal_text_all_w_t_and_m_t":"-- TAG-PDCP-CONFIG-START","paragraph_zero_based":22305},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22306},{"literal_text_all_w_t_and_m_t":"PDCP-Config ::=         SEQUENCE {","paragraph_zero_based":22307},{"literal_text_all_w_t_and_m_t":"    drb                     SEQUENCE {","paragraph_zero_based":22308},{"literal_text_all_w_t_and_m_t":"        discardTimer            ENUMERATED {ms10, ms20, ms30, ms40, ms50, ms60, ms75, ms100, ms150, ms200,","paragraph_zero_based":22309},{"literal_text_all_w_t_and_m_t":"                                            ms250, ms300, ms500, ms750, ms1500, infinity}       OPTIONAL, -- Cond Setup","paragraph_zero_based":22310},{"literal_text_all_w_t_and_m_t":"        pdcp-SN-SizeUL          ENUMERATED {len12bits, len18bits}                               OPTIONAL, -- Cond Setup1","paragraph_zero_based":22311},{"literal_text_all_w_t_and_m_t":"        pdcp-SN-SizeDL          ENUMERATED {len12bits, len18bits}                               OPTIONAL, -- Cond Setup2","paragraph_zero_based":22312},{"literal_text_all_w_t_and_m_t":"        headerCompression       CHOICE {","paragraph_zero_based":22313},{"literal_text_all_w_t_and_m_t":"            notUsed                 NULL,","paragraph_zero_based":22314},{"literal_text_all_w_t_and_m_t":"            rohc                    SEQUENCE {","paragraph_zero_based":22315},{"literal_text_all_w_t_and_m_t":"                maxCID                  INTEGER (1..16383)                                      DEFAULT 15,","paragraph_zero_based":22316},{"literal_text_all_w_t_and_m_t":"                profiles                SEQUENCE {","paragraph_zero_based":22317},{"literal_text_all_w_t_and_m_t":"                    profile0x0001           BOOLEAN,","paragraph_zero_based":22318},{"literal_text_all_w_t_and_m_t":"                    profile0x0002           BOOLEAN,","paragraph_zero_based":22319}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["dadbe243b272179b64a73b05306ff10ac6f830f32bce0e56ce67b2cc0415cc93","a5895953f242f902e373111e2cf33ae047c785b7a59585a53067ce339655b019","0fe16d8089bb9b40e20a5d46df4f8c8d58e439df6e7a9a8379e6237ae2ff1e5c","e3964e17230fee3ea86c7f0c90491f63878a55103984f721346c944cbe70523f","953d3c863d44a0e0eed0748e5c9283c97ba2a1a1a3a008406ec9a8d984b4232b","20140dd059a3f82813d6183dae4bda1c9dd64db8e4ea2d4467070dbf7b6bee4f","c11042507729a0fd843ae11c9eaca6f290deee7b6b1c6f198839dbfe5510b8b2","4c2d634307e68125c54f3ecf4748f4860133300433901db0c1e