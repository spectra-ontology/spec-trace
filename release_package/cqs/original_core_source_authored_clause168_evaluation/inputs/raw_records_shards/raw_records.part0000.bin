{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26400},{"literal_text_all_w_t_and_m_t":"PeriodicalReportConfig field descriptions","paragraph_zero_based":26401},{"literal_text_all_w_t_and_m_t":"coarseLocationRequest","paragraph_zero_based":26402},{"literal_text_all_w_t_and_m_t":"This field is used to request UE to report coarse location information.","paragraph_zero_based":26403},{"literal_text_all_w_t_and_m_t":"maxNrofRS-IndexesToReport","paragraph_zero_based":26404},{"literal_text_all_w_t_and_m_t":"Max number of RS indexes to include in the measurement report.","paragraph_zero_based":26405},{"literal_text_all_w_t_and_m_t":"maxReportCells","paragraph_zero_based":26406},{"literal_text_all_w_t_and_m_t":"Max number of non-serving cells to include in the measurement report.","paragraph_zero_based":26407},{"literal_text_all_w_t_and_m_t":"reportAddNeighMeas","paragraph_zero_based":26408},{"literal_text_all_w_t_and_m_t":"Indicates that the UE shall include the best neighbour cells per serving frequency.","paragraph_zero_based":26409},{"literal_text_all_w_t_and_m_t":"reportAmount","paragraph_zero_based":26410},{"literal_text_all_w_t_and_m_t":"Number of measurement reports applicable for eventTriggered as well as for periodical report types","paragraph_zero_based":26411},{"literal_text_all_w_t_and_m_t":"reportQuantityCell","paragraph_zero_based":26412},{"literal_text_all_w_t_and_m_t":"The cell measurement quantities to be included in the measurement report.","paragraph_zero_based":26413},{"literal_text_all_w_t_and_m_t":"reportQuantityRS-Indexes","paragraph_zero_based":26414},{"literal_text_all_w_t_and_m_t":"Indicates which measurement information per RS index the UE shall include in the measurement report.","paragraph_zero_based":26415},{"literal_text_all_w_t_and_m_t":"ul-DelayValueConfig","paragraph_zero_based":26416},{"literal_text_all_w_t_and_m_t":"If the field is present, the UE shall perform the actual UL PDCP Packet Average Delay measurement per DRB as specified in TS 38.314 [53] and the UE shall ignore the fields reportQuantityCell and maxReportCells. The applicable values for the corresponding reportInterval are (one of the) {ms120, ms240, ms480, ms640, ms1024, ms2048, ms5120, ms10240, ms20480, ms40960, min1,min6, min12, min30}. The reportInterval indicates the periodicity for performing and reporting of UL PDCP Packet Average Delay per DRB measurement as specified in TS 38.314 [53].","paragraph_zero_based":26417},{"literal_text_all_w_t_and_m_t":"ul-ExcessDelayConfig","paragraph_zero_based":26418},{"literal_text_all_w_t_and_m_t":"If the field is present, the UE shall perform the actual UL PDCP Excess Packet Delay per DRB measurement as specified in TS 38.314 [53] and the UE shall ignore the fields reportQuantityCell and maxReportCells. The applicable values for the corresponding reportInterval are (one of the) {ms120, ms240, ms480, ms640, ms1024, ms2048, ms5120, ms10240, ms20480, ms40960, min1,min6, min12, min30}. The reportInterval indicates the periodicity for performing and reporting of UL PDCP Excess Packet Delay per DRB measurement as specified in TS 38.314 [53].","paragraph_zero_based":26419},{"literal_text_all_w_t_and_m_t":"useAllowedCellList","paragraph_zero_based":26420},{"literal_text_all_w_t_and_m_t":"Indicates whether only the cells included in the allow-list of the associated measObject are applicable as specified in 5.5.4.1.","paragraph_zero_based":26421},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26422},{"literal_text_all_w_t_and_m_t":"ReportSFTD-NR field descriptions","paragraph_zero_based":26423}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["224fec0e33613bf7e2459b60ecb030f6c3955ddbd96aa58aaad253ff6e4481ab","42c8271c4abd5357a26779e2d9acc52b0262f0f343053ceb5e4bbcd9abcfdd88","196abd46a9d79f81d11b4e6cd3d31daf39cabee27922cd6edfeedad198d8a359","02673c27620df8a814a2d179779a3f76f458282be8aa2e8122ffe36160285e57","c3baf88d4150013b5e18261d6832ffb95bbf7e764bfc3c8e5deb7caff7c88daa","52a758cc45b3882830fa5eb29d0e2b2e4fdc527ccdd533fe15b7934891e109ea","8b6726341194d7f271c98f74b0931a882ed71d34ea651ba59f3551a31d717997","81be8df39528bff65213796b22b56f90a793dd2b45344f33176d76803425923d","45db1287049e09337ff7c5cd49ffd88fb86bca34eb8f234c50079f005a0035c2","e3cd597d9c750b41f2fecea37e77ebd67be97ccb054bef111fe684c138ea21fb","835bb23dd0657b6a0ce1ccc50e879fd6f6f4e7cf7df969e90bc17c932ca2c7ee","76bb73c45d81cf888e19e4eb11f0da9e29869aaaa326492c437b010cb130147e","a321fc6b112383db0ad1bd8111873f9be8108ff5f3dd67d7b9bde37ce1b8b1cf","e0239ce4d670b1bda3ebdce053ed77de6535b1ad0b58cdfb07d9fd22fc2c38d1","4a5071dd0a78d7aee5dc2a6a9b670d8a6024f51a7a451b22920c7edefcd7aeae","ce96b4f01cfbfd1ce56f7a30a295a0032c5c3fd1781e2184aabb9c8f218d99b0","c9160eae0641f86a4b0b64e6d687fc7dd30c73f6781d01528fb5628be574f556","55abae886d3a7989186e6c3c335033baea3985e10a3205427ff5d166d8c3440e","c7557d17408808a814d12c5f4c2da08c8b8f5f83277b7d778526a0bae50b966f","6f213727f2884bf23429c67c0d0c7d9ea1ceab4514da49b72c00def2b585226d","77db80444a9e7848b15bc5c47b86ac39311ec62cf849a8837923c0dbecc52b73","58fdeb084e91e543db61e3cdded647849c952e1038244b51448d8d47072b9fea","5ae15a5ea14df4dec173c59348a2e3b5c8eea0fd04447dabb8e0fb3f843b480e","fa3c8188c85301e8f928f547aca6daf9ab90679cf7344948ef7ca901134e549c"],"paragraph_range_zero_based":[26400,26423],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p26