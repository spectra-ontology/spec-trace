{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"UTRA-FDD-CellIndex-r16 ::=                  INTEGER (1..maxCellMeasUTRA-FDD-r16)","paragraph_zero_based":20304},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20305},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASOBJECTUTRA-FDD-STOP","paragraph_zero_based":20306},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":20307},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20308},{"literal_text_all_w_t_and_m_t":"MeasObjectUTRA-FDD field descriptions","paragraph_zero_based":20309},{"literal_text_all_w_t_and_m_t":"carrierFreq","paragraph_zero_based":20310},{"literal_text_all_w_t_and_m_t":"Identifies UTRA-FDD carrier frequency for which this configuration is valid. NR does not configure more than one measurement object for the same physical frequency regardless of the ARFCN used to indicate this.","paragraph_zero_based":20311},{"literal_text_all_w_t_and_m_t":"cellIndexUTRA-FDD","paragraph_zero_based":20312},{"literal_text_all_w_t_and_m_t":"Entry index in the neighbouring cell list.","paragraph_zero_based":20313},{"literal_text_all_w_t_and_m_t":"cellsToAddModList","paragraph_zero_based":20314},{"literal_text_all_w_t_and_m_t":"List of UTRA-FDD cells to add/modify in the neighbouring cell list.","paragraph_zero_based":20315},{"literal_text_all_w_t_and_m_t":"cellsToRemoveList","paragraph_zero_based":20316},{"literal_text_all_w_t_and_m_t":"List of cells to remove from the neighbouring cell list.","paragraph_zero_based":20317},{"literal_text_all_w_t_and_m_t":"utra-FDD-Q-OffsetRange","paragraph_zero_based":20318},{"literal_text_all_w_t_and_m_t":"Used to indicate a frequency specific offset to be applied when evaluating triggering conditions for measurement reporting. The value is in dB.","paragraph_zero_based":20319},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20320},{"literal_text_all_w_t_and_m_t":"–MeasResultCellListSFTD-NR","paragraph_zero_based":20321},{"literal_text_all_w_t_and_m_t":"The IE MeasResultCellListSFTD-NR consists of SFN and radio frame boundary difference between the PCell and an NR cell as specified in TS 38.215 [9] and TS 38.133 [14].","paragraph_zero_based":20322},{"literal_text_all_w_t_and_m_t":"MeasResultCellListSFTD-NR information element","paragraph_zero_based":20323},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":20324},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASRESULTCELLLISTSFTD-NR-START","paragraph_zero_based":20325},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20326},{"literal_text_all_w_t_and_m_t":"MeasResultCellListSFTD-NR ::=          SEQUENCE (SIZE (1..maxCellSFTD)) OF MeasResultCellSFTD-NR","paragraph_zero_based":20327}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["6942fb0ca0aaf6e9badb7eba845b7687930f7895702c954b30fc66d82b67b747","179eab59844c5d086157457451da8b1aa37188cf79c1f827c5d6d1bd87574be5","60947cad489dd47f6cfb68b2f341c1be8cc9dd9482a1b0d069a11363662508c6","32c4533843fd32660b56d9bbe35c1bfc9fc49f344ce828259662eb0021fd26e4","a7c191a25d7819e1adaa4a9a4c671e6b18f5a57565037d8e0b5e44d0aafa2609","c4c8fbbed14d2f48963a2378c199188c16271cbb9baf63f4f12673214c76dee0","c8fa6411c7224e3a8cf8e29052f8e5fa57764b88a6f21caf4a43271d52f2dfdf","c934812feb110b62fd739a0f05d4b2b6ba7d437951266ebb8b9a9b2ade6ea0e6","f5e5b8fdab9913900d4920a44cb63884a0b48236533d63d0c63aa0a5c513c6b9","a7f7bbbb5e73d07a49265441d049c3df406b8bb263267ba4144329f61151fd2b","2523cd09ef3ee4495cd229f9c7813b3c30809403ecb41125232564912493f07b","d96f7b8e7b8fb1d3b247302d09fd