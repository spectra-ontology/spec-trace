{"fields":{"filename":"R2-2311925.zip::R2-2311925_Introduction of BWP_Wor in TS38.331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SpCellOnly2","paragraph_zero_based":288},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need M, in the BWP-UplinkCommon of an SpCell. It is absent otherwise.","paragraph_zero_based":289},{"literal_text_all_w_t_and_m_t":"–CellGroupConfig","paragraph_zero_based":290},{"literal_text_all_w_t_and_m_t":"The CellGroupConfig IE is used to configure a master cell group (MCG) or secondary cell group (SCG). A cell group comprises of one MAC entity, a set of logical channels with associated RLC entities and of a primary cell (SpCell) and one or more secondary cells (SCells).","paragraph_zero_based":291},{"literal_text_all_w_t_and_m_t":"CellGroupConfig information element","paragraph_zero_based":292},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":293},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLGROUPCONFIG-START","paragraph_zero_based":294},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":295},{"literal_text_all_w_t_and_m_t":"-- Configuration of one Cell-Group:","paragraph_zero_based":296},{"literal_text_all_w_t_and_m_t":"CellGroupConfig ::=                        SEQUENCE {","paragraph_zero_based":297},{"literal_text_all_w_t_and_m_t":"    cellGroupId                                CellGroupId,","paragraph_zero_based":298},{"literal_text_all_w_t_and_m_t":"    rlc-BearerToAddModList                     SEQUENCE (SIZE(1..maxLC-ID)) OF RLC-BearerConfig                        OPTIONAL,   -- Need N","paragraph_zero_based":299},{"literal_text_all_w_t_and_m_t":"    rlc-BearerToReleaseList                    SEQUENCE (SIZE(1..maxLC-ID)) OF LogicalChannelIdentity                  OPTIONAL,   -- Need N","paragraph_zero_based":300},{"literal_text_all_w_t_and_m_t":"    mac-CellGroupConfig                        MAC-CellGroupConfig                                                     OPTIONAL,   -- Need M","paragraph_zero_based":301},{"literal_text_all_w_t_and_m_t":"    physicalCellGroupConfig                    PhysicalCellGroupConfig                                                 OPTIONAL,   -- Need M","paragraph_zero_based":302},{"literal_text_all_w_t_and_m_t":"    spCellConfig                               SpCellConfig                                                            OPTIONAL,   -- Need M","paragraph_zero_based":303},{"literal_text_all_w_t_and_m_t":"    sCellToAddModList                          SEQUENCE (SIZE (1..maxNrofSCells)) OF SCellConfig                       OPTIONAL,   -- Need N","paragraph_zero_based":304},{"literal_text_all_w_t_and_m_t":"    sCellToReleaseList                         SEQUENCE (SIZE (1..maxNrofSCells)) OF SCellIndex                        OPTIONAL,   -- Need N","paragraph_zero_based":305},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":306},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":307},{"literal_text_all_w_t_and_m_t":"    reportUplinkTxDirectCurrent                ENUMERATED {true}                                                   OPTIONAL    -- Cond BWP-Reconfig","paragraph_zero_based":308},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":309},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":310},{"literal_text_all_w_t_and_m_t":"    bap-Address-r16                            BIT STRING (SIZE (10))                                                  OPTIONAL,   -- Need M","paragraph_zero_based":311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3cd3bd3ea6f05fcf1dde3ac1d5aa467822a74a179e280d98a06785c15716876d","original_member_sha256":"0d094412acfc7036a6b390e89ffc0838f330e4812a58534567ea0c3db4ee0e42","paragraph_ElementTree_utf8_XML_sha256":["bb052ea2c66dddcecbaefe86312268b5116e