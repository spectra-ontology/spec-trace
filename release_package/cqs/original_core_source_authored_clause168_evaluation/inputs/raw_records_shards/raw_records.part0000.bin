{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":15240},{"literal_text_all_w_t_and_m_t":"    sl-PUCCH-Config-r16                 SetupRelease { PUCCH-Config }                                           OPTIONAL,   -- Need M","paragraph_zero_based":15241},{"literal_text_all_w_t_and_m_t":"    cp-ExtensionC2-r16                  INTEGER (1..28)                                                         OPTIONAL,   -- Need R","paragraph_zero_based":15242},{"literal_text_all_w_t_and_m_t":"    cp-ExtensionC3-r16                  INTEGER (1..28)                                                         OPTIONAL,   -- Need R","paragraph_zero_based":15243},{"literal_text_all_w_t_and_m_t":"    useInterlacePUCCH-PUSCH-r16         ENUMERATED {enabled}                                                    OPTIONAL,   -- Need R","paragraph_zero_based":15244},{"literal_text_all_w_t_and_m_t":"    pucch-ConfigurationList-r16         SetupRelease { PUCCH-ConfigurationList-r16 }                            OPTIONAL,   -- Need M","paragraph_zero_based":15245},{"literal_text_all_w_t_and_m_t":"    lbt-FailureRecoveryConfig-r16       SetupRelease { LBT-FailureRecoveryConfig-r16 }                          OPTIONAL,   -- Need M","paragraph_zero_based":15246},{"literal_text_all_w_t_and_m_t":"    configuredGrantConfigToAddModList-r16                 ConfiguredGrantConfigToAddModList-r16                 OPTIONAL,   -- Need N","paragraph_zero_based":15247},{"literal_text_all_w_t_and_m_t":"    configuredGrantConfigToReleaseList-r16                ConfiguredGrantConfigToReleaseList-r16                OPTIONAL,   -- Need N","paragraph_zero_based":15248},{"literal_text_all_w_t_and_m_t":"    configuredGrantConfigType2DeactivationStateList-r16   ConfiguredGrantConfigType2DeactivationStateList-r16   OPTIONAL    -- Need R","paragraph_zero_based":15249},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":15250},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":15251},{"literal_text_all_w_t_and_m_t":"    ul-TCI-StateList-r17                CHOICE {","paragraph_zero_based":15252},{"literal_text_all_w_t_and_m_t":"        explicitlist                        SEQUENCE {","paragraph_zero_based":15253},{"literal_text_all_w_t_and_m_t":"            ul-TCI-ToAddModList-r17             SEQUENCE (SIZE (1..maxUL-TCI-r17)) OF TCI-UL-State-r17          OPTIONAL,   -- Need N","paragraph_zero_based":15254},{"literal_text_all_w_t_and_m_t":"            ul-TCI-ToReleaseList-r17            SEQUENCE (SIZE (1..maxUL-TCI-r17)) OF TCI-UL-StateId-r17        OPTIONAL    -- Need N","paragraph_zero_based":15255},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":15256},{"literal_text_all_w_t_and_m_t":"        unifiedTCI-StateRef-r17         ServingCellAndBWP-Id-r17","paragraph_zero_based":15257},{"literal_text_all_w_t_and_m_t":"    }                                                                                                           OPTIONAL,  -- Need R","paragraph_zero_based":15258},{"literal_text_all_w_t_and_m_t":"    ul-powerControl-r17                Uplink-powerControlId-r17                                                OPTIONAL,  -- Cond NoTCI-PC","paragraph_zero_based":15259},{"literal_text_all_w_t_and_m_t":"    pucch-ConfigurationListMulticast1-r17  SetupRelease { PUCCH-ConfigurationList-r16 }                         OPTIONAL,  -- Need M","paragraph_zero_based":15260},{"literal_text_all_w_t_and_m_t":"    pucch-ConfigurationListMulticast2-r17  SetupRelease { PUCCH-ConfigurationList-r16 }                         OPTIONAL   -- Need M","paragraph_zero_based":15261},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":15262},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":15263}],"source":"Whole authentic original CR source member; all