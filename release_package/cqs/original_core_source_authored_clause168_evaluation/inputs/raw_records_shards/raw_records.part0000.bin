{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SL-PSBCH-Config information element","paragraph_zero_based":38640},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":38641},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-PSBCH-CONFIG-START","paragraph_zero_based":38642},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38643},{"literal_text_all_w_t_and_m_t":"SL-PSBCH-Config-r16 ::= SEQUENCE {","paragraph_zero_based":38644},{"literal_text_all_w_t_and_m_t":"    dl-P0-PSBCH-r16         INTEGER (-16..15)                                                                   OPTIONAL,    -- Need M","paragraph_zero_based":38645},{"literal_text_all_w_t_and_m_t":"    dl-Alpha-PSBCH-r16      ENUMERATED {alpha0, alpha04, alpha05, alpha06, alpha07, alpha08, alpha09, alpha1}   OPTIONAL,    -- Need M","paragraph_zero_based":38646},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":38647},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":38648},{"literal_text_all_w_t_and_m_t":"    dl-P0-PSBCH-r17         INTEGER (-202..24)                                                                  OPTIONAL     -- Need M","paragraph_zero_based":38649},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":38650},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":38651},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38652},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-PSBCH-CONFIG-STOP","paragraph_zero_based":38653},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":38654},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38655},{"literal_text_all_w_t_and_m_t":"SL-PSBCH-Config field descriptions","paragraph_zero_based":38656},{"literal_text_all_w_t_and_m_t":"dl-Alpha-PSBCH","paragraph_zero_based":38657},{"literal_text_all_w_t_and_m_t":"Indicates alpha value for DL pathloss based power control for PSBCH. When the field is not configured the UE applies the value 1.","paragraph_zero_based":38658},{"literal_text_all_w_t_and_m_t":"dl-P0-PSBCH","paragraph_zero_based":38659},{"literal_text_all_w_t_and_m_t":"Indicates P0 value for DL pathloss based power control for PSBCH. If not configured, DL pathloss based power control is disabled for PSBCH. When dl-P0-PSBCH-r17 is configured, the UE ignores dl-P0-PSBCH-r16.","paragraph_zero_based":38660},{"literal_text_all_w_t_and_m_t":"A Remote UE which is out of coverage, considers downlink pathloss based power control is disabled for PSBCH when dl-P0-PSBCH is configured.","paragraph_zero_based":38661},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38662},{"literal_text_all_w_t_and_m_t":"–SL-PSSCH-TxConfigList","paragraph_zero_based":38663}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["c8f14d14857a06ff9dc2fe29f52408b5c3d397d42e1a516de0c07469ffda3fdb","f75c9d3a7517cf2aff716ed3fa0c17afcf4e6cb21ec115a2a74015ebc49f4579","741b509d5fb5c77d2946c92d4c76ad8655c44d6301716801577a65f857036ec1","03556d1c326fd07413f6d9a31ffb9a61d9c85b7b1e57a4f5de6345e91ee4831d","b8e2c317ea663607bfe560f58eeb56fe9a01850a74114b021f67e93b4709bd58","b98bc64a54f3e6d554418ce2953f5eea91d7c933ae7dbab5c8a36bd4cb51e596","e7499604957f4a189144c4f9f43164344757876be9a11365034aa485f2b72e37","319045e6e9f69cdd677dc375dd0aa49e6c9e5318c13db28424981942eda8aef7","ec04ecf16f66b546030af7cbd4402d69726b8938bba0bff40a3285e3d1c3640d","e658e12b622066fb3bb854f04a2888cf00dbeca80fef038c924ced1ec81fe567","7fb14f1dbe5736a38e09f67cae625e8829a0a6b58fb981f098f295098b6e2573","5960572f1101730e454bdd16c7e4e2238b9f2ac3388b49