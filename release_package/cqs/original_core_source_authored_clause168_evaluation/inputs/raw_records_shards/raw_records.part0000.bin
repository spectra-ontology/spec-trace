{"fields":{"filename":"R2-2310947.zip::R2-2310947.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":312},{"literal_text_all_w_t_and_m_t":"Agreements ","paragraph_zero_based":313},{"literal_text_all_w_t_and_m_t":"1We will support the CHO triggers for the use case of turning off the cell ","paragraph_zero_based":314},{"literal_text_all_w_t_and_m_t":"2(At least for cell DTX/DRX) Time-based CHO is not to be considered in NES.","paragraph_zero_based":315},{"literal_text_all_w_t_and_m_t":"3 Do not consider using an indication in SIB1 for triggering NES CHO execution condition","paragraph_zero_based":316},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":317},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":318}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8d4901b891fbd4ddd84ab30e673a8dc5a4094da57e9e4b85dbb233c58abd62aa","original_member_sha256":"be142033f82c6755a6455392686a978e05ce304dac4a2fd05b9a253aaed7cdf3","paragraph_ElementTree_utf8_XML_sha256":["f9014c4c836c43c1b7e5bb228761151d2738f1c2b1d2b4dfadcbc9936b5589e0","47b8bc234b3e8abf74593a842086c43867ee276ecc59b830e21d31ea5cbc0ff9","42aa45fe3c65687f19020090f770f671ecd7cf458b6c4e5c3aba13c3623dda69","b87acca460d9ba7db12f1d161d10ff48ba2beebdc5588d57a8625322c169e70f","0d3b6117972450efc7842457a8fb9c9b2403d36b87a1129d7201bc5635ecbaab","002cb805aef6cd131c05f04f2dd67bfe8a50c8f944e1fbcdca6e879011cce092","1a0c97f72c3fa173036cf06ff0bbd7ee562552feadff82e9c26b2d83dd2dfd9d"],"paragraph_range_zero_based":[312,318],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2310947.zip::R2-2310947.docx:p312"}
