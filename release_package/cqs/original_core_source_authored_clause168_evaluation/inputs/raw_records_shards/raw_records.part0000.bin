{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1632},{"literal_text_all_w_t_and_m_t":"DL-PRS-BeamInfoResourceSet-r16 ::= SEQUENCE (SIZE(1..nrMaxResourcesPerSet-r16)) OF","paragraph_zero_based":1633},{"literal_text_all_w_t_and_m_t":"DL-PRS-BeamInfoElement-r16","paragraph_zero_based":1634},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1635},{"literal_text_all_w_t_and_m_t":"DL-PRS-BeamInfoElement-r16 ::= SEQUENCE {","paragraph_zero_based":1636},{"literal_text_all_w_t_and_m_t":"dl-PRS-Azimuth-r16INTEGER (0..359),","paragraph_zero_based":1637},{"literal_text_all_w_t_and_m_t":"dl-PRS-Azimuth-fine-r16INTEGER (0..9)OPTIONAL,-- Need ON","paragraph_zero_based":1638},{"literal_text_all_w_t_and_m_t":"dl-PRS-Elevation-r16INTEGER (0..180)OPTIONAL,-- Need ON","paragraph_zero_based":1639},{"literal_text_all_w_t_and_m_t":"dl-PRS-Elevation-fine-r16INTEGER (0..9)OPTIONAL,-- Need ON","paragraph_zero_based":1640},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":1641},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":1642},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1643},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":1644},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1645},{"literal_text_all_w_t_and_m_t":"NR-DL-PRS-Beam-Info field descriptions","paragraph_zero_based":1646},{"literal_text_all_w_t_and_m_t":"dl-PRS-ID","paragraph_zero_based":1647},{"literal_text_all_w_t_and_m_t":"This field is used along with a DL-PRS Resource Set ID and a DL-PRS Resources ID to uniquely identify a DL-PRS Resource. This ID can be associated with multiple DL-PRS Resource Sets associated with a single TRP.","paragraph_zero_based":1648},{"literal_text_all_w_t_and_m_t":"Each TRP should only be associated with one such ID.","paragraph_zero_based":1649},{"literal_text_all_w_t_and_m_t":"nr-PhysCellID","paragraph_zero_based":1650},{"literal_text_all_w_t_and_m_t":"This field specifies the physical cell identity of the associated TRP, as defined in TS 38.331 [35].","paragraph_zero_based":1651},{"literal_text_all_w_t_and_m_t":"nr-CellGlobalID","paragraph_zero_based":1652},{"literal_text_all_w_t_and_m_t":"This field specifies the NCGI, the globally unique identity of a cell in NR, of the associated TRP, as defined in TS 38.331 [35]. The server should include this field if it considers that it is needed to resolve ambiguity in the TRP indicated by nr-PhysCellID.","paragraph_zero_based":1653},{"literal_text_all_w_t_and_m_t":"nr-ARFCN","paragraph_zero_based":1654},{"literal_text_all_w_t_and_m_t":"This field specifies the NR-ARFCN of the TRP's CD-SSB (as defined in TS 38.300 [47]) corresponding to nr-PhysCellID.","paragraph_zero_based":1655}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["c4718c7f85cdd9e30a22c3c4d0ab4fac5d579e42a92ed9db6f62c93a25c37614","17db4056a3cd18d642607d09d043b658347d280e6a64b6bb611a36865cf8eb68","8993f24da54d0c15319e73705510f3b32135b04e49d5f61a0da9db01a81d943c","109c77d74c2b5a705d27d4d0fc480ac70efb65f77c5f8c992e2e30c59a28915a","04a8f3005bd075cf0733045181f48ce46a6e819e95590145f9bc90e61104a527","231243fbd8382b73b1d2aaf2823403df4965a2525b75e15b6f17f81a91c2acb7","59779549cc750549e897b5684e7f3d8b79a742590432fef65837053116b34639","41c78fadf8e0e050209ac2f6372e05403d345e75514fa9d6a276efc527f5c3bb","b7c6f705cd6e3263d06a28cf73107260bb038e612c0fbf1abe9d2e3a11de68e3","480a08bb70e2277f83898a7056a8f65f3c11d1dc9d486d8b7c7843dfc67a55e7","5e522de1534e61b0d509802f953a384784b2648af7d598036476573078ce33c0","aaa66b3ad65ac9eac123797f65f6634780a17e332d3d8e7eb166f09cc25096df","6cc98537c821a1fb793360a9c0a36e570a1c0be1cb4aeeb687c5ebd9d0ea290f","31e9391e3da4eb2ee62a42dfa15a2ff5d05b1750f6d3b53eca0a963f9ef6a78b","706f329273589e1a0da7748f4ef545f1284d0157ae6afda952a1410a1f718bf1","62b947b25338e58d5d852df595bfa26c00c0790c213e2b87ee9d0150d4b1875d","d6c47a20c60341d104e4dde1b2e49107e3c6f92f6a2aab3f7c53e0f45cca98fa","6077ff3ddf5bf40d68fd308a3d3c9b47ab1b6540798e066bdfc49f6c11b54321","d47a16927141c9a1aae03226225f42a143b5bbed35dc8587fb4fd454cb6be61d","0c395af31a721d6a58b823be7e92159fb6064ba444c2f1950c814bdb4150d9b9","3ecff8a425a967f695253906f52b6b95af07a3de66e5d92fac52078aaa467891","1fcb032634d435ebd97a95b22f475ef9918034dc9796fa8580bcd1fe26d41998","cb66c877fcb7b32c780981d720a7459e85ace7837109772c1c580cb5c474f501","ef8b2c058f4d3e63fc5c262a1865a113a9095938924bb15c4017c7b7370b71dd"],"paragraph_range_zero_based":[1632,1655],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx:p1632"}
{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"associated-DL-PRS-ID","paragraph_zero_based":1656},{"literal_text_all_w_t_and_m_t":"This field specifies the dl-PRS-ID of the associated TRP from which the beam information and parameters for LCS to GCS translation are adopted. If the field is omitted, the beam information is provided via the dl-prs-BeamInfoSet field and the LCS to GCS translation parameter is provided via the lcs-GCS-TranslationParameter. If the field is present, the fields lcs-GCS-TranslationParameter and dl-PRS-BeamInfoSet shall be absent.","paragraph_zero_based":1657},{"literal_text_all_w_t_and_m_t":"lcs-GCS-TranslationParameter","paragraph_zero_based":1658},{"literal_text_all_w_t_and_m_t":"This field provides the angles α (bearing angle), β (downtilt angle) and γ (slant angle) for the translation of a Local Coordinate System (LCS) to a Global Coordinate System (GCS) as defined in TR 38.901 [44]. If this field and the field associated-DL-PRS-ID are absent, the dl-PRS-Azimuth and dl-PRS-Elevation are provided in a GCS.","paragraph_zero_based":1659},{"literal_text_all_w_t_and_m_t":"dl-PRS-BeamInfoSet","paragraph_zero_based":1660},{"literal_text_all_w_t_and_m_t":"This field provides the DL-PRS beam information for each DL-PRS Resource of the DL-PRS Resource Set associated with this TRP.","paragraph_zero_based":1661},{"literal_text_all_w_t_and_m_t":"dl-PRS-Azimuth","paragraph_zero_based":1662},{"literal_text_all_w_t_and_m_t":"This field specifies the azimuth angle of the boresight direction in which the DL-PRS Resources associated with this DL-PRS Resource ID in the DL-PRS Resource Set are transmitted.","paragraph_zero_based":1663},{"literal_text_all_w_t_and_m_t":"For a Global Coordinate System (GCS), the azimuth angle is measured counter-clockwise from geographical North.","paragraph_zero_based":1664},{"literal_text_all_w_t_and_m_t":"For a Local Coordinate System (LCS), the azimuth angle is measured measured counter-clockwise from the x-axis of the LCS.","paragraph_zero_based":1665},{"literal_text_all_w_t_and_m_t":"Scale factor 1 degree; range 0 to 359 degrees.","paragraph_zero_based":1666},{"literal_text_all_w_t_and_m_t":"dl-PRS-Azimuth-fine","paragraph_zero_based":1667},{"literal_text_all_w_t_and_m_t":"This field provides finer granularity for the dl-PRS-Azimuth.","paragraph_zero_based":1668},{"literal_text_all_w_t_and_m_t":"The total azimuth angle of the boresight direction is given by dl-PRS-Azimuth + dl-PRS-Azimuth-fine.","paragraph_zero_based":1669},{"literal_text_all_w_t_and_m_t":"Scale factor 0.1 degrees; range 0 to 0.9 degrees.","paragraph_zero_based":1670},{"literal_text_all_w_t_and_m_t":"dl-PRS-Elevation","paragraph_zero_based":1671},{"literal_text_all_w_t_and_m_t":"This field specifies the elevation angle of the boresight direction in which the DL-PRS Resources associated with this DL-PRS Resource ID in the DL-PRS Resource Set are transmitted.","paragraph_zero_based":1672},{"literal_text_all_w_t_and_m_t":"For a Global Coordinate System (GCS), the elevation angle is measured relative to zenith and positive to the horizontal direction (elevation 0 deg. points to zenith, 90 deg to the horizon).","paragraph_zero_based":1673},{"literal_text_all_w_t_and_m_t":"For a Local Coordinate System (LCS), the elevation angle is measured relative to the z-axis of the LCS (elevation 0 deg. points to the z-axis, 90 deg to the x-y plane).","paragraph_zero_based":1674},{"literal_text_all_w_t_and_m_t":"Scale factor 1 degree; range 0 to 180 degrees.","paragraph_zero_based":1675},{"literal_text_all_w_t_and_m_t":"dl-PRS-Elevation-fine","paragraph_zero_based":1676},{"literal_text_all_w_t_and_m_t":"This field provides finer granularity for the dl-PRS-Elevation.","paragraph_zero_based":1677},{"literal_text_all_w_t_and_m_t":"The total elevation angle of the boresight direction is given by dl-PRS-Elevation + dl-PRS-Elevation-fine.","paragraph_zero_based":1678},{"literal_text_all_w_t_and_m_t":"Scale factor 0.1 degrees; range 0 to 0.9 degrees.","paragraph_zero_based":1679}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["5b55f27632207b851e3123e1318451593cbf612b839e9d4e27f229e514df77ad","a0aef296bc540ee38a46cf46ad06a51fafc787df03b834e3009dbff6a929af9d","b9a0c16562cb87b657a36859dd199e49c27a4b64c1bad530780d8e870324b044","ed56246e5edb83d53345279b940a625660c7a1176ef9842fd2d450c4f36b52d2","7723bdd298d8436031a6e222786319d610e8653031f07c65a910039f913b3335","9653fb03755f4b9719b21fe16945c5e5fdfa6e32f700fde69b35075588834ffb","f9707dbba4ec003449e1f28a808d7f435f7fd0bdb659379ebd9050b9bd5cd725","bc0608caabd048e9a8e09c6acafe1fe982a7829c8e3c9bbb8c08c319e6ec4335","d9564c78a8fd17db4a535cdfbe98c868cb3b9953728bfb0e18943c3f5ed337ac","d0d2f840158f2bc902129aee0747eb3f8ad7bf3ef25edc5a357708fc9549db23","3f95cc4ddfa39a9b9359a9f510e744aee4ea4badfc5479013c2046870587f21e","66413f2e1cdfc1d8128a302632c941c6c3925e921b9a6371b17a5867089949c5","9983439bf4ea5a76ffe889bd2aed272ef04ed4fa47d63b160b1d4273f2e95e8c","f048e304230df550bcaebf422c4c8a5f031c8a4456da413717ce800d9c236db2","71b7168cc7e274a9f71b740175d2f14e95002f7c727447dc297b3b634d39af49","f6506f5cfb8247c84ca02eedc2a09c03937c4b0c38b67d3949137456c0546ae5","eccf5dd8675152cbfa679369b1e659b08e293cee5d81c1f20c5d1de5ee621023","a1a91464ef863b8404dcbe62f47dd412034667765f100ef792249a9897914a09","2da0cbfb802b2f82cf1edaaab635f3e1d67a3b872db6966d9195e3f74670014b","20ae1abcfb5ce4f0bba150cf3b51618fa56ef8d1807e016b1417c799abd9920c","eb5d4744777f98850fdc7b06fdd9cc7b78184e2400d36ecd396a11e2955a1cfd","7729ab46489aa3c5052ab75f741452