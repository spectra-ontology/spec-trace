{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Parameter type Velocity defined in TS 37.355 [49]. The first/leftmost bit of the first octet contains the most significant bit.","paragraph_zero_based":16296},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16297},{"literal_text_all_w_t_and_m_t":"–CondReconfigId","paragraph_zero_based":16298},{"literal_text_all_w_t_and_m_t":"The IE CondReconfigId is used to identify a CHO, CPA or CPC configuration.","paragraph_zero_based":16299},{"literal_text_all_w_t_and_m_t":"CondReconfigId information element","paragraph_zero_based":16300},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":16301},{"literal_text_all_w_t_and_m_t":"-- TAG-CONDRECONFIGID-START","paragraph_zero_based":16302},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16303},{"literal_text_all_w_t_and_m_t":"CondReconfigId-r16 ::=                    INTEGER (1.. maxNrofCondCells-r16)","paragraph_zero_based":16304},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16305},{"literal_text_all_w_t_and_m_t":"-- TAG-CONDRECONFIGID-STOP","paragraph_zero_based":16306},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":16307},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16308},{"literal_text_all_w_t_and_m_t":"–CondReconfigToAddModList","paragraph_zero_based":16309},{"literal_text_all_w_t_and_m_t":"The IE CondReconfigToAddModList concerns a list of conditional reconfigurations to add or modify, with for each entry the condReconfigId and the associated condExecutionCond/condExecutionCondSCG and condRRCReconfig.","paragraph_zero_based":16310},{"literal_text_all_w_t_and_m_t":"CondReconfigToAddModList information element","paragraph_zero_based":16311},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":16312},{"literal_text_all_w_t_and_m_t":"-- TAG-CONDRECONFIGTOADDMODLIST-START","paragraph_zero_based":16313},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16314},{"literal_text_all_w_t_and_m_t":"CondReconfigToAddModList-r16 ::= SEQUENCE (SIZE (1.. maxNrofCondCells-r16)) OF CondReconfigToAddMod-r16","paragraph_zero_based":16315},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16316},{"literal_text_all_w_t_and_m_t":"CondReconfigToAddMod-r16 ::=     SEQUENCE {","paragraph_zero_based":16317},{"literal_text_all_w_t_and_m_t":"    condReconfigId-r16               CondReconfigId-r16,","paragraph_zero_based":16318},{"literal_text_all_w_t_and_m_t":"    condExecutionCond-r16            SEQUENCE (SIZE (1..2)) OF MeasId                      OPTIONAL,    -- Need M","paragraph_zero_based":16319}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["80a4e3e6af1ea5c8495839f832c8e45e6444ad109b9773d6fc445bd87cea43d2","2a27451b5b077e12550e08b5c0247420cb448d59d3d99c17bb8e646efedffaf3","58a64fcc13e9f28acbc677afad935771f4a02338a34b3bb0305113ce5b843403","fbc75213893a27125efae3fa880e8e4384a03013f113c5b8b953fa18d9269f2b","e0c18a866a02d813b32603bf89864c7c48ca32e5d46e38a158ace59c48ce071f","2ecad11816de8e71a5412eaab446e713af949285fef4b9ec87d330f5792cf5b5","900b082bb6d444636c57e4041c58d4d87b25cabbdd5d1b7882b5aa56079f2eba","b7ac96c31ce87bad6d509e5d6d4c9213cd3592c69645ef0744cda1f6fffef714","122d44cf803212970eee4d34daca1c23a315bde1a487a81c5c8fcab5ee7a1c55","7c6d3a4398d27dc97950c2ac82bb2f66b740204baea10a0143122a7c35d2330d","c4b40b6507fefa1c6a015d8a6b9c932a301f0f813d30ad1700a7d54a57e24b93","c5f32975680beff7661e851e90e0bfa53705cf59a5756dde656177e348452944","97c72eb293b5353b53c73cb69ba63cf387344618b3125298808b4d423e517f96","7644afbaf759a43ee2f289c51f90ffde66b90fe4584d4ab49bf70756729988fa","796a2fe79d7fef323f08692a22a3a65a956381aa67a604887c5a1f1d8e3875ef","60310753c5b63e454273d5e0bcabf281a9c7407c2102b761861706859081f105","2e9e6180008adad8c23b1680efac018dc9c7d7d959d047cfc1574abba09dff2d","d54c39554af15a478d31bd674eebb072dc67b98df98976b9158e06564c7308dd","5fe5cd0a8bc755618bb373d4c2ffd29f13a46ee1d97180c1a7184e857abee534","1e9810253e26edec0401c9ec849a2b565aa92074c163ff345c0d9b9052aeb01d","060b39cb0c96af0f64ec508baef44ac6bb05e3b632b2c22527e52d82910feac1","c573b64e19e9731dd27c437888b3973972da0c8343548665dacad0b11d013687","e497f7d3f37ed923859a5ba170c9cd6b14ad9890f909ffe5dac397ca47325e50","94f60821395b9df4fd023636cc90b041413548d005e2f2619157b4d4550b17ce"],"paragraph_range_zero_based":[16296,16319],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p16296"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    condRRCReconfig-r16              OCTET STRING (CONTAINING RRCReconfiguration)          OPTIONAL,    -- Cond condReconfigAdd","paragraph_zero_based":16320},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":16321},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":16322},{"literal_text_all_w_t_and_m_t":"    condExecutionCondSCG-r17         OCTET STRING (CONTAINING CondReconfigExecCondSCG-r17) OPTIONAL     -- Need M","paragraph_zero_based":16323},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":16324},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":16325},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16326},{"literal_text_all_w_t_and_m_t":"CondReconfigExecCondSCG-r17 ::=  SEQUENCE (SIZE (1..2)) OF MeasId","paragraph_zero_based":16327},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16328},{"literal_text_all_w_t_and_m_t":"-- TAG-CONDRECONFIGTOADDMODLIST-STOP","paragraph_zero_based":16329},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":16330},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16331},{"literal_text_all_w_t_and_m_t":"CondReconfigToAddMod field descriptions","paragraph_zero_based":16332},{"literal_text_all_w_t_and_m_t":"condExecutionCond","paragraph_zero_based":16333},{"literal_text_all_w_t_and_m_t":"The execution condition that needs to be fulfilled in order to trigger the execution of a conditional reconfiguration for CHO, CPA, intra-SN CPC without MN involvement or MN initiated inter-SN CPC. When configuring 2 triggering events (Meas Ids) for a candidate cell, the network ensures that both refer to the same measObject. For CHO, if the network configures condEventD1 or condEventT1 for a candidate cell, the network configures a second triggering event condEventA3, condEventA4 or condEventA5 for the same candidate cell. The network does not configure both condEventD1 and condEventT1 for the same candidate cell. For CHO in terrestrial networks, the network does not indicate a MeasId associated with condEventA4. For CPA and for MN-initiated inter-SN CPC, the network only indicates MeasId(s) associated with condEventA4. For intra-SN CPC, the network only indicates MeasId(s) associated with condEventA3 or condEventA5.","paragraph_zero_based":16334},{"literal_text_all_w_t_and_m_t":"condExecutionCondSCG","paragraph_zero_based":16335},{"literal_text_all_w_t_and_m_t":"Contains execution condition that needs to be fulfilled in order to trigger the execution of a conditional reconfiguration for SN initiated inter-SN CPC. The Meas Ids refer to the measConfig associated with the SCG. When configuring 2 triggering events (Meas Ids) for a candidate cell, network ensures that both refer to the same measObject. For each condReconfigId, the network always configures either condExecutionCond or condExecutionCondSCG (not both). The network only indicates MeasId(s) associated with condEventA3 or condEventA5.","paragraph_zero_based":16336},{"literal_text_all_w_t_and_m_t":"condRRCReconfig","paragraph_zero_based":16337},{"literal_text_all_w_t_and_m_t":"The RRCReconfiguration message to be applied when the condition(s) are fulfilled. The RRCReconfiguration message contained in condRRCReconfig cannot contain the field conditionalReconfiguration or the field daps-Config.","paragraph_zero_based":16338},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16339},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":16340},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":16341},{"literal_text_all_w_t_and_m_t":"condReconfigAdd","paragraph_zero_based":16342},{"literal_text_all_w_t_and_m_t":"The field is mandatory present when a condReconfigId is being added. Otherwise the field is optional, need M.","paragraph_zero_based":16343}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["2d30c46ef6e9bd0933294a444a7ac75185acf67d866bea35d41ecd306eee16a3","ebde5c0f8fdaacff04cc9dfcef02cd35148a0f3d2f961dccefcece9374d8a4c3","6aa4018a463b87c38861722439e1aed23501b12b098ab41959bf4c5886728c15","52a3f23a75ed24df65000c3c1e8928cd4bfe6b07715abc5bb430c40eafc809f8","e658e1725f3bee99ba2b14049e78c13eca30fc6b985c293e3990f2893bd2608b","2ffd2a339a9f42f4bf02f85c8cb8a22481b7d75b228f4cc90d695f5006ddb56c","3c3fdf897f74d921fa5e97e6b6e683c3f4803e50bf0ef4b31534235b94fbab08","02429d5f63b3bdeaa3031a130ba00f63ba32bcb494d6c8d0d4905ba43e5b6f73","5d9d7a34cbda49a3f4bbfa199690bef1e46cbf06fb3be4b842c236aa10115f74","68288a5c71cd0e9bd6a7a9a62f2a2caa3be13ea75b05c0843d951de9948575a8","09cd070a04311aaa698db639d6837843162f7b0a0378f174cae8507940610e2d","281fb2fd60ac711ff449a2da9df05ff74b942211d953c99351e66c5d05f97aca","6c3a1dddf00178c14985697b3f55796a5ad7df18db1d5d8710541a8d69b7a857","4fa79e51dda0ae82a02a3c0223e07401774cb451bc52825ca4068c9068d8d67f","ccb4e14098872ab2bd71028ecbec7fd4f32475d60e58c52379daf91b7db1e5dc","7aaf9e040e118aaec595f59fcccc8c86a807c3bbd629ca8c57e852144c96c623","c8e95fe3d85477dc76cacf906c11ad4f6cf366c7ea3988a23aa1b732947745dc","35a524f6d2b41c538958b4df42d4ce92cc2817c5b582e50b34fa56fe869b3442","446580c7b03aa5c3c108ea50047e306de042b35a22de98e676f2c1744d2a7d2f","688a63cc2fc5e5d4d3a05e6ddabce4196b66394069679ffff8d92b6645abba82","5a02b77100cf243cf72189313fe92e75514c6653adfc79dc8102f22e75628463","e50688f9c69b1c9653576c19b42a5f25921f28ddedb6a5976f790ce9c16b1b67","7e943944c52cf4c8abc051b114b7c6881873f6c9c5158f62fca7bf674922657a","ff0db60aeff6bdc9d2a47396601221dc6c295e1bd717c3ae1253162fa36b8