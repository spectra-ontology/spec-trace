{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SIB21 field descriptions","paragraph_zero_based":14304},{"literal_text_all_w_t_and_m_t":"mbs-FSAI-InterFreqList","paragraph_zero_based":14305},{"literal_text_all_w_t_and_m_t":"Contains a list of neighboring frequencies including additional bands, if any, that provide MBS services and the corresponding MBS FSAIs.","paragraph_zero_based":14306},{"literal_text_all_w_t_and_m_t":"mbs-FSAI-IntraFreq","paragraph_zero_based":14307},{"literal_text_all_w_t_and_m_t":"Contains the list of MBS FSAIs for the current frequency. For MBS service continuity, the UE shall use all MBS FSAIs listed in mbs-FSAI-IntraFreq to derive the MBS frequencies of interest.","paragraph_zero_based":14308},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14309},{"literal_text_all_w_t_and_m_t":"6.3.1aPositioning System information blocks","paragraph_zero_based":14310},{"literal_text_all_w_t_and_m_t":"–PosSystemInformation-r16-IEs","paragraph_zero_based":14311},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":14312},{"literal_text_all_w_t_and_m_t":"-- TAG-POSSYSTEMINFORMATION-R16-IES-START","paragraph_zero_based":14313},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14314},{"literal_text_all_w_t_and_m_t":"PosSystemInformation-r16-IEs ::= SEQUENCE {","paragraph_zero_based":14315},{"literal_text_all_w_t_and_m_t":"    posSIB-TypeAndInfo-r16           SEQUENCE (SIZE (1..maxSIB)) OF CHOICE {","paragraph_zero_based":14316},{"literal_text_all_w_t_and_m_t":"        posSib1-1-r16                    SIBpos-r16,","paragraph_zero_based":14317},{"literal_text_all_w_t_and_m_t":"        posSib1-2-r16                    SIBpos-r16,","paragraph_zero_based":14318},{"literal_text_all_w_t_and_m_t":"        posSib1-3-r16                    SIBpos-r16,","paragraph_zero_based":1