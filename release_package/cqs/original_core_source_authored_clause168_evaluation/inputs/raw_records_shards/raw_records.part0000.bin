{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"CellAccessRelatedInfo-EUTRA-5GC  ::=    SEQUENCE {","paragraph_zero_based":15432},{"literal_text_all_w_t_and_m_t":"    plmn-IdentityList-eutra-5gc             PLMN-IdentityList-EUTRA-5GC,","paragraph_zero_based":15433},{"literal_text_all_w_t_and_m_t":"    trackingAreaCode-eutra-5gc              TrackingAreaCode,","paragraph_zero_based":15434},{"literal_text_all_w_t_and_m_t":"    ranac-5gc                               RAN-AreaCode                                OPTIONAL,","paragraph_zero_based":15435},{"literal_text_all_w_t_and_m_t":"    cellIdentity-eutra-5gc                  CellIdentity-EUTRA-5GC","paragraph_zero_based":15436},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":15437},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15438},{"literal_text_all_w_t_and_m_t":"PLMN-IdentityList-EUTRA-5GC::=          SEQUENCE (SIZE (1..maxPLMN)) OF PLMN-Identity-EUTRA-5GC","paragraph_zero_based":15439},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15440},{"literal_text_all_w_t_and_m_t":"PLMN-Identity-EUTRA-5GC ::=             CHOICE {","paragraph_zero_based":15441},{"literal_text_all_w_t_and_m_t":"    plmn-Identity-EUTRA-5GC                 PLMN-Identity,","paragraph_zero_based":15442},{"literal_text_all_w_t_and_m_t":"    plmn-index                              INTEGER (1..maxPLMN)","paragraph_zero_based":15443},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":15444},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15445},{"literal_text_all_w_t_and_m_t":"CellIdentity-EUTRA-5GC ::=              CHOICE {","paragraph_zero_based":15446},{"literal_text_all_w_t_and_m_t":"    cellIdentity-EUTRA                      BIT STRING (SIZE (28)),","paragraph_zero_based":15447},{"literal_text_all_w_t_and_m_t":"    cellId-index                            INTEGER (1..maxPLMN)","paragraph_zero_based":15448},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":15449},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15450},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLACCESSRELATEDINFOEUTRA-5GC-STOP","paragraph_zero_based":15451},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":15452},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15453},{"literal_text_all_w_t_and_m_t":"–CellAccessRelatedInfo-EUTRA-EPC","paragraph_zero_based":15454},{"literal_text_all_w_t_and_m_t":"The IE CellAccessRelatedInfo-EUTRA-EPC indicates cell access related information for an LTE cell connected to EPC.","paragraph_zero_based":15455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["bfaacace68641710366a08515c7bbe711f5fe30f000359a571af6962e0aa08e5","e2da58a6e4b4e6f1d60437492eb4e3fe0e45587a83040f87d7b1c1dc68a747ca","aa09ae627e765799da2e5dea1b372c7e59863fe1526f5cc9a01d7846d35f7713","83679694ebc181a15e8eb4e6ac258e65e67e51805b9dcca04513fd522dc1b6be","200154c304659993a206256fcb4f26ce5697943bafb8f31232c5cba69c31f920","c00fd9e6105fee1eaa85e879dec7dff13ccecc940496c4c593443b10e0b219d4","bc4c8dd23fa9a2f64e80712b6ac6e7c620d5c07f029675760164b7705a420ecd","fb6da4de4ed9b603d1c6098f4ca4238330fa47136fcd06546bb255ef0cc19b00","ba21e5de34cbae962dd10e6f6b6ef4c8482884d05dde77359e13c18754125803","a966eb0ffbbf2626b60a7a90d12d226058837cf8066df91fae3e4014cceb3509","7227208ec51dfe1a532b215fcc649b57462d522bee7085dc69462c7606578d4d","bd184d8e8c2662a22dcfd0236f3fb3db2cf319ea4f3325966772b9f3d811142d","e07f9478a607c74a8de3ba6e5b7993ecd96a02dd1b24e846f81d2faf3c6146fe","b6e0628cf7b2afcaa8027faaa1c104739365e04dce0d71