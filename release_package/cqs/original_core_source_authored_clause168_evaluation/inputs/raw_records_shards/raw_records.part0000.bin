263b068be167ced07","b6ad4756d3d43f1019f08661d080f1998f24daae3e2421d35ff1629eabc97363","9bad83368ef493d45e0060b847787bd18a1276791a0e2a351db1b44eb0a737bb","f8ea1a1d71ef0ebb2f4fb9f65cd20422b8a9b398f2bd22d8bd7a9fe96514d3af","639deb679ea221846a545fac8c5398bcf723e9b28c449484abd604156b62a2f4","a6aa6ebf5a3196d3dbcafb766ed14635ed10fd5a212517989807483e193e0bd0","c7b21b78dda4d0a93426b6f7a36fb529e99f37670b8e18855ddeea40cc10e6aa","7b9bc9416b83cfc3292e3ba7d8197e36858930763f50caf07ff75b59140d60b9","4381279f4f8faa3a7b1d5b9eca8fb6c3acffe11e1a5cf4d350089a242efbe899","a0fd7d6b8780c5a069b4926515e5410f0e7fede1bd0d2132c573f0c2be7f6a73","f699d2ed33d9a7998d2f2e634d9e1f43623aced47e05092b74263db9c9b9515b","dd399a23759ea19bab8163931f60077e2d8596fecf2a93aeef018b2cec333f65","25dcb51fc7c49fb26abfe1dbacd1588db4c39bc47eef5385144ea62e62e7a224","11b670a46dab660b76caf8aba2c18b9b7fc624bd703e8bba91e121c82c112f45","4e519a6e220df1d2b3673a501de1b3a1bfe6240523c193acf9f27be4f2f51fca","60b3304256f19852d4d97a5b3cebe54a15794a1bb814100a78c60b5e223683aa","75129b2b543ae821d61c1c1a212ec8538c30adf9182027cd7781b2c9579a3fa6","d6e1f645c7d036f910dd56c25dc5056a1ea3de03f8e8cedae6a5ed21cae62d49","2366ed04f9665176656c08ac768308814e1bd4950d0595d6f9e8dd924483a3a2","d19522bea12823b7ea56a204de2ebe4a113ce3f3950a278fad2aae156cf80bd7"],"paragraph_range_zero_based":[39144,39167],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p39144"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the codepoint of the communication range requirement field in SCI.","paragraph_zero_based":39168},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39169},{"literal_text_all_w_t_and_m_t":"SL-ResourcePool field descriptions","paragraph_zero_based":39170},{"literal_text_all_w_t_and_m_t":"dummy","paragraph_zero_based":39171},{"literal_text_all_w_t_and_m_t":"This field is not used in the specification. If received it shall be ignored by the UE.","paragraph_zero_based":39172},{"literal_text_all_w_t_and_m_t":"sl-A2X-Service","paragraph_zero_based":39173},{"literal_text_all_w_t_and_m_t":"Presence of this field indicates the resource pool is dedicated for A2X service, i.e., not to be used for other than A2X service. Value brid indicates the resource pool is for BRID, value daa indicates the resource pool is for DAA, and value bridaAndDAA indicates the resource poos is for both BRID and DAA. If this field is absent in all the configured resource pools, the UE may choose non-dedidcated resource pool for A2X service.","paragraph_zero_based":39174},{"literal_text_all_w_t_and_m_t":"sl-Additional-MCS-Table","paragraph_zero_based":39175},{"literal_text_all_w_t_and_m_t":"Indicates the MCS table(s) additionally used in the resource pool. 64QAM table is (pre-)configured as default. Zero, one or two can be additionally (pre-)configured using the 256QAM and/or low-SE MCS tables. If two MCS tables are indicated, 256QAM MCS table is the 1st table and qam64lowSE MCS table is the 2nd table as specified in TS 38.214 [19], clause 8.1.3.1.","paragraph_zero_based":39176},{"literal_text_all_w_t_and_m_t":"sl-FilterCoefficient","paragraph_zero_based":39177},{"literal_text_all_w_t_and_m_t":"This field indicates the filtering coefficient for long-term measurement and reference signal power derivation used for sidelink open-loop power control.","paragraph_zero_based":39178},{"literal_text_all_w_t_and_m_t":"sl-InterUE-CoordinationConfig","paragraph_zero_based":39179},{"literal_text_all_w_t_and_m_t":"Indicates the configured sidelink inter-UE coordination parameters.","paragraph_zero_based":39180},{"literal_text_all_w_t_and_m_t":"sl-NumSubchannel","paragraph_zero_based":39181},{"literal_text_all_w_t_and_m_t":"Indicates the number of subchannels in the corresponding resource pool, which consists of contiguous PRBs only.","paragraph_zero_based":39182},{"literal_text_all_w_t_and_m_t":"sl-PBPS-CPS-Config","paragraph_zero_based":39183},{"literal_text_all_w_t_and_m_t":"Indicates the allowed resource allocation schemes of full sensing only, partial sensing only, random resource selection only, or any combination(s), and the related configuration for power saving resource allocation schemes. This field is absent for sl-TxPoolExceptional.","paragraph_zero_based":39184},{"literal_text_all_w_t_and_m_t":"sl-PreemptionEnable","paragraph_zero_based":39185},{"literal_text_all_w_t_and_m_t":"Indicates whether pre-emption is disabled or enabled in a resource pool. If the field is present and the value is pl1, pl2, and so on (but not enabled), it means that pre-emption is enabled and a priority level p_preemption is configured. If the field is present and the value is enabled, the pre-emption is enabled (but p_preemption is not configured) and pre-emption is applicable to all levels.","paragraph_zero_based":39186},{"literal_text_all_w_t_and_m_t":"sl-PriorityThreshold-UL-URLLC","paragraph_zero_based":39187},{"literal_text_all_w_t_and_m_t":"Indicates the threshold used to determine whether NR sidelink transmission is prioritized over uplink transmission of priority index 1 as specified in TS 38.213[13], clause 16.2.4.3, or whether PUCCH transmission carrying SL HARQ is prioritized over PUCCH transmission carrying UCI of priority index 1 if they overlap in time as specified in TS 38.213 [13], clause 9.2.5.0.","paragraph_zero_based":39188},{"literal_text_all_w_t_and_m_t":"sl-PriorityThreshold","paragraph_zero_based":39189},{"literal_text_all_w_t_and_m_t":"Indicates the threshold used to determine whether NR sidelink transmission is prioritized over uplink transmission of priority index 0 as specified in TS 38.213[13], clause 16.2.4.3, or whether PUCCH transmission carrying SL HARQ is prioritized over PUCCH transmission carrying UCI of priority index 0 if they overlap in time as specified in TS 38.213 [13], clause 9.2.5.0.","paragraph_zero_based":39190},{"literal_text_all_w_t_and_m_t":"sl-RB-Number","paragraph_zero_based":39191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["a3d88ceb9497269d7255db342cae2101f21db6e6e87b5b865657abfe42687e5e","3dde5ea68961b6317456dd7740317a983b84b6e00c35152c063a80d862da7ee9","37c201f90fd2fb4cff72e88b59319f870fca68d3e29c3d7b0ba0c1dbd25751a3","f39c6a8aa0090384a9f7e88d31d997ccc909467103cfb3342cf83c36290cc9d5","ca0b0d6710093b0d49241fd201b54dc0c9e0499020ba1a9b2010a62423f8823f","f129e9352ceb75d454fa5c0cc7b03407b37571c277587ffaca19c17dcae25801","7d4ed8b6d4b677f30a9a7fc87e6e39ba78bb7748fd548c0800c933bd48a79d1b","ea66123db7d3290c59966815180373b6cd1daec03967c2cc29a49defedcad64a","67cd77dc196983df0393a9a75302139d41d204a356f4f96d567285c4b8ba4c45","d2a76689773ffb4e42b26ada8b6032bbe42d3717529ee8481e6cb0be5dd048a5","6eb5b775596132b5ff0c4ce1fe6d447a7afc8953fa274d1e0c638e9005f3a4be","a9f485ec704f8e2d4bc4517271a229f9d542f24ca7a93f1516bd43029e0a5bc7","9d57bd504f6ecef65f5a5e72034823a5e633dedc2f9065681d7e42e3b40e7f36","3f7cc52847cdff139b413ab08f8d0f15b22bab5f44cf81162aaaee1da5bde21a","b0cddcd9086fd1b2e76a0c04b54ed1abb0731fad42905be4c80f6e271a76e234","623cc37e64617bd1fcb603a3af6d9d9175d966a9b1a2a1b6dc2cfcbefd71633d","513453af8e8f319a62d1dcd90c822f80490c7919ee429eed053630592eb749fd","20d300dc0a3ee58f74afc86d8a9b73153ad260cee272afc9af943562c6a4a81a","9a5ef2011211b1b817142e01788b690a5a7dadbd29521e6d58f78eb8f074ff6c","8f7ad7edee6583f7ec80289f1a8e07fe326a05ff0397503bfcc672d0b9084e35","fa09e3b38ea7444d9707251b3c5478078a0eb41bfc4651f3cda8a622e0201ff6","815eb65585f16d1fc23c345cde7e93a29c3a90370e16a63a25b3fc567b084710","b759eefb7d33a89a2c2d1d4e0b184de0983529cf88294eadc787ccc530d58ff2","1d7f202fb43dd68515f933d486c1c02392d9289b1e0c3a24578863bebda8655e"],"paragraph_range_zero_based":[39168,39191],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p39168"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the number of PRBs in the corresponding resource pool, which consists of contiguous PRBs only. The remaining RB cannot be used (See TS 38.214[19], clause 8).","paragraph_zero_based":39192},{"literal_text_all_w_t_and_m_t":"sl-StartRB-Subchannel","paragraph_zero_based":39193},{"literal_text_all_w_t_and_m_t":"Indicates the lowest RB index of the subchannel with the lowest index in the resource pool with respect to the lowest RB index of a SL BWP.","paragraph_zero_based":39194},{"literal_text_all_w_t_and_m_t":"sl-SubchannelSize","paragraph_zero_based":39195},{"literal_text_all_w_t_and_m_t":"Indicates the minimum granularity in frequency domain for the sensing for PSSCH resource selection in the unit of PRB.","paragraph_zero_based":39196},{"literal_text_all_w_t_and_m_t":"sl-SyncAllowed","paragraph_zero_based":39197},{"literal_text_all_w_t_and_m_t":"Indicates the allowed synchronization reference(s) which is (are) allowed to use the configured resource pool.","paragraph_zero_based":39198},{"literal_text_all_w_t_and_m_t":"sl-SyncConfigIndex","paragraph_zero_based":39199},{"literal_text_all_w_t_and_m_t":"Indicates the synchronisation configuration that is associated with a reception pool, by means of an index to the corresponding entry SL-SyncConfigList of in SIB12 for NR sidelink communication.","paragraph_zero_based":39200},{"literal_text_all_w_t_and_m_t":"sl-TDD-Configuration","paragraph_zero_based":39201},{"literal_text_all_w_t_and_m_t":"Indicates the TDD configuration associated with the reception pool of the cell indicated by sl-SyncConfigIndex.","paragraph_zero_based":39202},{"literal_text_all_w_t_and_m_t":"sl-ThreshS-RSSI-CBR","paragraph_zero_based":39203},{"literal_text_all_w_t_and_m_t":"Indicates the S-RSSI threshold for determining the contribution of a sub-channel to the CBR measurement. Value 0 corresponds to -112 dBm, value 1 to -110 dBm, value n to (-112 + n*2) dBm, and so on.","paragraph_zero_based":39204},{"literal_text_all_w_t_and_m_t":"sl-TimeResource","paragraph_zero_based":39205},{"literal_text_all_w_t_and_m_t":"Indicates the bitmap of the resource pool, which is defined by repeating the bitmap with a periodicity during a SFN or DFN cycle.","paragraph_zero_based":39206},{"literal_text_all_w_t_and_m_t":"sl-TimeWindowSizeCBR","paragraph_zero_based":39207},{"literal_text_all_w_t_and_m_t":"Indicates the time window size for CBR measurement.","paragraph_zero_based":39208},{"literal_text_all_w_t_and_m_t":"sl-TimeWindowSizeCR","paragraph_zero_based":39209},{"literal_text_all_w_t_and_m_t":"Indicates the time window size for CR evaluation.","paragraph_zero_based":39210},{"literal_text_all_w_t_and_m_t":"sl-TxPercentageList","paragraph_zero_based":39211},{"literal_text_all_w_t_and_m_t":"Indicates the portion of candidate single-slot PSSCH resources over the total resources. Value p20 corresponds to 20%, and so on.","paragraph_zero_based":39212},{"literal_text_all_w_t_and_m_t":"sl-X-Overhead","paragraph_zero_based":39213},{"literal_text_all_w_t_and_m_t":"Accounts for overhead from CSI-RS, PT-RS. If the field is absent, the UE applies value n0 (see TS 38.214 [19], clause 5.1.3.2).","paragraph_zero_based":39214},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["15552cef8797edec6f9e5dba751a05ea92c5af943e0cdc6f626255433c3a8db4","c6c7bbf9c206049fc1ebb004ea147ab1d3e297263d33a99aa7f415dabb0f3bb0","a62a29dac64d761e8279ea3f50829e45f14412a080f0cfc17d0b672542408f83","9fa810f9d8ded435ef14805eefeec5a2457199dd233c73b3570807e82ed669c9","b65c223651351abc9aed620c748ad51df4a40ec32305bed77262aa49767341cc","2dc1b720f536090d7a8c23de3fdbdf332205d7b88fa7aa0323cd31d71e4a27a4","248327018ae52be88a8e1cb0783112473548ff2810f1a2ecfd0069d161a67d84","91562cc3c6145cc075e0c205d86ad63d4272737a69a38c73ed1dc6ecb2c67100","0f4726baff7b2edc9c85d271098becb2c542f6ad2d5376de2d3c078f0f8ac227","85e98328294569eed3205a00615ecf0f66b22fa97c08a639cedf9115df9963db","99219764c87657715f757bd10cc4fb6fbdef8ad8f0ae2c1cfba2549c288278c8","2ba71746021805a93217933e58b28d93348125decff35dd9a607497529d37102","0b9ed2fc536c9b34e6a291002c201de89d509b08c2fb85f5a3594ad3ee93047c","026bf6eefd39ffd610e972a2ed02a14dd5f5899ff4edb79c3336b7cc833c560d","b88e943dd54b555b7d90e7290b2e1b0ae9f782cd96d7cbac750ff9de64ca98d2","cd138e2726965b9b24620b9bb69f2bb25e8529ffc8c160d73729e086121dceff","9354db2237c99e0b7aee698ed580a91b99045695ad6878e422a569bd0a242092","0ffc06c442f3cf51136b0383cd0273c13fe642f75a1fcc812197484fcf989c32","dd099cea714bf7815dd2b4ce6d35f742062e76849236dff16d64c7da319e5549","4d6db8ddcc42fa1b04dd6744170407eb6eac9287f8264178074643fe67f9ed0b","aa1adade3ffbd45d33e6d80a87276578632b32d548a0dacf890da55f9e70b4e6","ca1579780d76fb0764964dd81daf1c7f9ccb22de6c6e99ce3a187feca991dd63","50a0348c66f280ac7499e554fe078c6b439a7bd0f03eef8eb2febd31fe0a8bcd","860f6caf5f63d8f1b34fb7dec365ae2bbda18e00df6fe4189f5e61f906c6e637"],"paragraph_range_zero_based":[39192,39215],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p39192"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SL-SyncAllowed field descriptions","paragraph_zero_based":39216},{"literal_text_all_w_t_and_m_t":"gnbEnb-Sync","paragraph_zero_based":39217},{"literal_text_all_w_t_and_m_t":"If configured, the (pre-) configured resources can be used if the UE is directly or indirectly synchronized to eNB or gNB (i.e., synchronized to a reference UE which is directly synchronized to eNB or gNB).","paragraph_zero_based":39218},{"literal_text_all_w_t_and_m_t":"gnss-Sync","paragraph_zero_based":39219},{"literal_text_all_w_t_and_m_t":"If configured, the (pre-) configured resources can be used if the UE is directly or indirectly synchronized to GNSS (i.e., synchronized to a reference UE which is directly synchronized to GNSS).","paragraph_zero_based":39220},{"literal_text_all_w_t_and_m_t":"ue-Sync","paragraph_zero_based":39221},{"literal_text_all_w_t_and_m_t":"If configured, the (pre-) configured resources can be used if the UE is synchronized to a reference UE which is not synchronized to eNB, gNB and GNSS directly or indirectly.","paragraph_zero_based":39222},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39223},{"literal_text_all_w_t_and_m_t":"SL-PSCCH-Config field descriptions","paragraph_zero_based":39224},{"literal_text_all_w_t_and_m_t":"sl-FreqResourcePSCCH","paragraph_zero_based":39225},{"literal_text_all_w_t_and_m_t":"Indicates the number of PRBs for PSCCH in a resource pool where it is not greater than the number PRBs of the subchannel.","paragraph_zero_based":39226},{"literal_text_all_w_t_and_m_t":"sl-DMRS-ScrambleID","paragraph_zero_based":39227},{"literal_text_all_w_t_and_m_t":"Indicates the initialization value for PSCCH DMRS scrambling.","paragraph_zero_based":39228},{"literal_text_all_w_t_and_m_t":"sl-NumReservedBits","paragraph_zero_based":39229},{"literal_text_all_w_t_and_m_t":"Indicates the number of reserved bits in first stage SCI.","paragraph_zero_based":39230},{"literal_text_all_w_t_and_m_t":"sl-TimeResourcePSCCH","paragraph_zero_based":39231},{"literal_text_all_w_t_and_m_t":"Indicates the number of symbols of PSCCH in a resource pool.","paragraph_zero_based":39232},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39233},{"literal_text_all_w_t_and_m_t":"SL-PSSCH-Config field descriptions","paragraph_zero_based":39234},{"literal_text_all_w_t_and_m_t":"sl-BetaOffsets2ndSCI","paragraph_zero_based":39235},{"literal_text_all_w_t_and_m_t":"Indicates candidates of beta-offset values to determine the number of coded modulation symbols for second stage SCI. The value indicates the index of Table 9.3-2 of TS 38.213 [13].","paragraph_zero_based":39236},{"literal_text_all_w_t_and_m_t":"sl-PSSCH-DMRS-TimePatternList","paragraph_zero_based":39237},{"literal_text_all_w_t_and_m_t":"Indicates the set of PSSCH DMRS time domain patterns in terms of PSSCH DMRS symbols in a slot that can be used in the resource pool.","paragraph_zero_based":39238},{"literal_text_all_w_t_and_m_t":"sl-Scaling","paragraph_zero_based":39239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["92c9915e5d6eba0b66eded4bbae8a9b30a6c5fc2d0317e8ac12293d961764e9b","fce70f4c265bd2206c5a4e5a74441779880bc8eef0f9e8d7a68c25dc9da7713f","8d7fe346fd29a1647920be291b868ef399d748029526cbe5a69de6bf322ce655","e94e9bc5712e6fcff53cfca4617080769ef1b9bc4d8a1e67ea248ca91ed35a57","05e846f7a0ffba8718ce63c51ea1fa2cbaabfab106196d8522b1154652772af4","5e20e8884bf86db6179ffd2bddd8713b0c53def909413d1687c771b7c3e71a93","21daabffbec193540c999cc46fb71a024c5bf1aa73473dd0778bbd5d35da2a87","5176b30fd3340555d32cdc08ff63db81e01268db92caf7ee03c62d1dbf60da2b","639afa6b2b0b1a02082757b26b8b70603a1043608a2cc81a0cccec9dd49bd892","79d3359a9044c21dfc47e7f1bd090b878fde8a0f8641952fa37a46afa861f4a8","cfb589e66847c545126e07182482a59318d26e3fa622bd15dd6a173bf9370e8f","5a6eb9cb1bfce411b72796502f098209d19b878a866374d1e068ff2e3de4fa3b","60936477c2d67467dfbc5347904085459508c25141896d02ca679b02d34b90a4","828c7adb66ad0f3f875262c3a175016c95127f77f757998b618b3459c6499d1b","0d5287b9c7371854bb1b8cd2c98dba6e74204e65a48935f4ab5356f532167e54","e3da3dc14f5fe597837625dcc9ddd0251a024be6f6a244b03f52c0ac818d394a","ec2b0aa046bcaaae2575069239bb333a9ade05c28d7f7ee5ab039f9a2ddb7067","1dbb37f89fa39be199181ffcaf22bfb34862ad45d9ab713f23c7fd3e0f0f1c92","c6a9d67e799978f949e3f1301717ea3a2b4412e95c7d749b2eb69a2416e4a74b","5bc6b9de85c780f36ffd4eee65c47f529b8e9df0977e38b4407ce69e0474395a","4d60dfe201c25df0d3ef054c30bd07d57d966bdaf8924f6ff73e0dbe89894b0a","bb1af0a81cb979b62fbb7af81faf1325fbb9e46c7361b1a5db9f1b3b9281f8ef","21e68c5dafbd7ee98ff03a7b198441028e857160247c8316b29bec6d7bcd9266","bf8236a0f7770730767d8fd633ee7dcde6e2d0a36f16708e342e04d910f2c671"],"paragraph_range_zero_based":[39216,39239],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p39216"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates a scaling factor to limit the number of resource elements assigned to the second stage SCI on PSSCH. Value f0p5 corresponds to 0.5, value f0p65 corresponds to 0.65, and so on.","paragraph_zero_based":39240},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39241},{"literal_text_all_w_t_and_m_t":"SL-PSFCH-Config field descriptions","paragraph_zero_based":39242},{"literal_text_all_w_t_and_m_t":"sl-MinTimeGapPSFCH","paragraph_zero_based":39243},{"literal_text_all_w_t_and_m_t":"The minimum time gap between PSFCH and the associated PSSCH in the unit of slots.","paragraph_zero_based":39244},{"literal_text_all_w_t_and_m_t":"sl-NumMuxCS-Pair","paragraph_zero_based":39245},{"literal_text_all_w_t_and_m_t":"Indicates the number of cyclic shift pairs used for a PSFCH transmission that can be multiplexed in a PRB.","paragraph_zero_based":39246},{"literal_text_all_w_t_and_m_t":"sl-PSFCH-CandidateResourceType","paragraph_zero_based":39247},{"literal_text_all_w_t_and_m_t":"Indicates the number of PSFCH resources available for multiplexing HARQ-ACK information in a PSFCH transmission (see TS 38.213 [13], clause 16.3).","paragraph_zero_based":39248},{"literal_text_all_w_t_and_m_t":"sl-PSFCH-HopID","paragraph_zero_based":39249},{"literal_text_all_w_t_and_m_t":"Scrambling ID for sequence hopping of the PSFCH used in the resource pool.","paragraph_zero_based":39250},{"literal_text_all_w_t_and_m_t":"sl-PSFCH-Period","paragraph_zero_based":39251},{"literal_text_all_w_t_and_m_t":"Indicates the period of PSFCH resource in the unit of slots within this resource pool. If set to sl0, no resource for PSFCH, and HARQ feedback for all transmissions in the resource pool is disabled.","paragraph_zero_based":39252},{"literal_text_all_w_t_and_m_t":"sl-PSFCH-RB-Set","paragraph_zero_based":39253},{"literal_text_all_w_t_and_m_t":"Indicates the set of PRBs that are actually used for PSFCH transmission and reception. The leftmost bit of the bitmap refers to the lowest RB index in the resource pool, and so on. Value 0 in the bitmap indicates that the corresponding PRB is not used for PSFCH transmission and reception while value 1 indicates that the corresponding PRB is used for PSFCH transmission and reception (see TS 38.213 [13]).","paragraph_zero_based":39254},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39255},{"literal_text_all_w_t_and_m_t":"SL-PTRS-Config field descriptions","paragraph_zero_based":39256},{"literal_text_all_w_t_and_m_t":"sl-PTRS-FreqDensity","paragraph_zero_based":39257},{"literal_text_all_w_t_and_m_t":"Presence and frequency density of SL PT-RS  as a function of scheduled BW. If the field is not configured, the UE uses K_PT-RS = 2","paragraph_zero_based":39258},{"literal_text_all_w_t_and_m_t":"sl-PTRS-TimeDensity","paragraph_zero_based":39259},{"literal_text_all_w_t_and_m_t":"Presence and time density of SL PT-RS  as a function of MCS. If the field is not configured, the UE uses L_PT-RS = 1","paragraph_zero_based":39260},{"literal_text_all_w_t_and_m_t":"sl-PTRS-RE-Offset","paragraph_zero_based":39261},{"literal_text_all_w_t_and_m_t":"Indicates the subcarrier offset for SL PT-RS . If the field is not configured, the UE applies the value offset00 (see TS 38.211 [16], clause 8.4.1.2.2).","paragraph_zero_based":39262},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["2e804fe29e15ae074ed3e77ec163e530d99e5d782de1fda66fa956b28cb7f1eb","7b6a37f8f5be2f55b4d07c9a4a690a2fc7a5732b5779cd711be3950adbec49e1","a541887a64187eada8520b8940134a1feadac88fbe503a5e021957fce724304f","e2b6710ebb7f1af11db23efa9e68cfdd6a6b21210396297090f72a333b976197","6e8e0e226a708242c5d9349035dc47f46c41d2340261aff341e4067864d1f0dc","4e799b006ea4fb292da8e060ca92a3e88bc0015c37cd0d993e3c06855e131d35","6cc6abb1bcaa3e7075b499e97a3fcd20d196c51e46e6925b2abd6550130fdfd9","395ddece641cd01ce1d643bc1e48301322f35f1efcb9f42f180898a533f72dfc","e849813fad02a7305ce1a24a56de74b6aceff9e09f9ef3e403b3fd2abf0240d5","46143234f355db478f5a93a00e6b271bfb218aee8c31110f96974a4886108f01","2bff9409430482606d92ecc188ca0e9103027993d138f5751aadf91896e557d6","62d35ba9365743df238cd67221348ecd527dd54046f695f4cc4eb729e5a9d335","bde50ef7c88c362b54d1e1ed79fa66c32e23c65b662b79455a1d6e46ca500dae","6b7f8dd1aa0cc3015d3311d935e420f732de6308ad4f0391e492c9fab4ea7192","c028451f80877199216a511e29606d4e7ebab88f226863b01fe710b7678fc917","af8d1379a0e53517c95b290cdd1c68f7b7451f2810a942b1626acaa02083c179","e940168a401492caad18a1947a175ba1fb5b7db9d542fb88f6da9ea02e5d461b","ff31e59dfee982c1782eff5ee68a6a2688f9b6573ab9120e1338bb4e699c57ba","772f9ad55a05a65e61744980dbfaf37da7562f88460c7089b26c3f1001ebc529","5e64af722dae6dd940084f7ad74cd86fec6575429d63885b86b581d927cf04ff","cc2f3f166425c75668aed4fd416b477210345cc4163eb24ae2c70d87ec6d4671","e7c7d806105c3405e77042a142e28022d9ee37f66a39183807829abb01cc86d6","dc1c065b4fbea8bff9a4ecf451c8eb4f75e2aea4eeeca38b9a179032ea396ae0","c83ac555128d3887ee3e797fd701eafba617aae5bb4e39eb1c4d8e5132f591fb"],"paragraph_range_zero_based":[39240,39263],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p39240"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SL-UE-SelectedConfigRP field descriptions","paragraph_zero_based":39264},{"literal_text_all_w_t_and_m_t":"sl-CBR-PriorityTxConfigList","paragraph_zero_based":39265},{"literal_text_all_w_t_and_m_t":"Indicates the mapping between PSSCH transmission parameter (such as MCS, PRB number, retransmission number, CR limit) sets by using the indexes of the configurations in sl-CBR-PSSCH-TxConfigList, CBR ranges by using the indexes to the entry of the CBR range configurations in sl-CBR-RangeConfigList, and priority ranges. It also indicates the default PSSCH transmission parameters to be used when CBR measurement results are not available, and MCS range for the MCS tables used in the resource pool. The field sl-CBR-PriorityTxConfigList-v1650 is present only when sl-CBR-PriorityTxConfigList-r16 is configured.","paragraph_zero_based":39266},{"literal_text_all_w_t_and_m_t":"sl-MaxNumPerReserve","paragraph_zero_based":39267},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of reserved PSCCH/PSSCH resources that can be indicated by an SCI.","paragraph_zero_based":39268},{"literal_text_all_w_t_and_m_t":"sl-MultiReserveResource","paragraph_zero_based":39269},{"literal_text_all_w_t_and_m_t":"Indicates if it is allowed to reserve a sidelink resource for an initial transmission of a TB by an SCI associated with a different TB, based on sensing and resource selection procedure.","paragraph_zero_based":39270},{"literal_text_all_w_t_and_m_t":"sl-ResourceReservePeriodList","paragraph_zero_based":39271},{"literal_text_all_w_t_and_m_t":"Set of possible resource reservation period allowed in the resource pool in the unit of ms. Up to 16 values can be configured per resource pool. The value ms0 is always configured.","paragraph_zero_based":39272},{"literal_text_all_w_t_and_m_t":"sl-RS-ForSensing","paragraph_zero_based":39273},{"literal_text_all_w_t_and_m_t":"Indicates whether DMRS of PSCCH or PSSCH is used for L1 RSRP measurement in the sensing operation.","paragraph_zero_based":39274},{"literal_text_all_w_t_and_m_t":"sl-SensingWindow","paragraph_zero_based":39275},{"literal_text_all_w_t_and_m_t":"Parameter that indicates the start of the sensing window.","paragraph_zero_based":39276},{"literal_text_all_w_t_and_m_t":"sl-SelectionWindowList","paragraph_zero_based":39277},{"literal_text_all_w_t_and_m_t":"Parameter that determines the end of the selection window in the resource selection for a TB with respect to priority indicated in SCI. Value n1 corresponds to 1*2µ, value n5 corresponds to 5*2µ, and so on, where µ = 0,1,2,3 refers to SCS 15,30,60,120 kHz respectively.","paragraph_zero_based":39278},{"literal_text_all_w_t_and_m_t":"sl-Thres-RSRP-List","paragraph_zero_based":39279},{"literal_text_all_w_t_and_m_t":"Indicates a list of 64 thresholds, and the threshold should be selected based on the priority in the decoded SCI and the priority in the SCI to be transmitted. A resource is excluded if it is indicated or reserved by a decoded SCI and PSSCH/PSCCH RSRP in the associated data resource is above a threshold.","paragraph_zero_based":39280},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39281},{"literal_text_all_w_t_and_m_t":"SL-PowerControl field descriptions","paragraph_zero_based":39282},{"literal_text_all_w_t_and_m_t":"sl-MaxTransPower","paragraph_zero_based":39283},{"literal_text_all_w_t_and_m_t":"Indicates the maximum value of the UE's sidelink transmission power on this resource pool when the sidelink transmission is performed only on this resource pool. The unit is dBm. If the sidelink transmission is PSFCH, and multiple resource pools are used, the maximum transmission power for PSFCH is configured as sum of fields sl-maxTransPower over multiple resource pools, as specified in TS 38.101-1 [15].","paragraph_zero_based":39284},{"literal_text_all_w_t_and_m_t":"sl-Alpha-PSSCH-PSCCH","paragraph_zero_based":39285},{"literal_text_all_w_t_and_m_t":"Indicates alpha value for sidelink pathloss based power control for PSCCH/PSSCH when sl-P0-PSSCH-PSCCH is configured. When the field is absent the UE applies the value 1. ","paragraph_zero_based":39286},{"literal_text_all_w_t_and_m_t":"sl-P0-PSSCH-PSCCH","paragraph_zero_based":39287}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["7d8b918616fc9ae60fecfd09264c68495e072830a1dcdabb21aad19ba7c11031","5f298cbf39fc9c33ca465748b9ceb82dedf146527a7fb96018b015b8a89696b2","5d3e86a24ec8634d17a9f6eed029f891c5a307c47b680b35d39afd28ba670ef0","eb66c21b3f53dcc22ea96733a9d2c9b06d6790f188bd4744bf0783d6dcbd5a34","f4b45bd19f9fb6ce9e07bfbdff56c4f9b47239ab3d3d926d2c881298ec9e985b","0e63c6d753119387da30c2d0091823cdfea5efa811d89ca82188488d0730c716","be422ba291a4cd5db18cff5bef9599836dcc23940e155973262ec10f2298b456","87da0fa6d9995e8f669cf7e20c9184137c428907eeae536e06c7e03709eb5885","6fe178e1e415c9e6a032840b2cfd3c6a9b2886cfc4a5e117d3519ffa1cabe498","18beec5045980a6449e7bf9ec94c79576ad2201b874fb19ea5c3116a30697f81","42b37d101c5ff3b76f2ee504a16c2f4de9e3433bc91bf70dabc9da7d0d2771f5","28dfa856ed5f41eb8c100cded0da1927cdcc80c798a53f3e45ebf901864605ec","43ab8835248dbe3b94cab343ff26d5f32c29a5e477f002ce91ba43eb15a75589","bfa956b23c4d45719de9e9e5922e0479cec91c6499fa0e3c16a282ca37a7590e","27a0db4ddd1fc22f8862b780a986d27665e38b77941c75d08bccba8da6638edc","b8b0ba1b76302f26b2e73e75c4fa17d5aa63d3d9a474c5ca06ae18e5d165844b","4a2b0f40430326236a51f8dbe1728cf2ca35fc51e5f89f0f174a72d3be56839f","e1f65034c38e06ea4a213d21e5972b1abf624cd7332dfe09429f642e3e1accfc","58a99fd6d40235270da764162efdb94a4d6f2e9aa1af9125a3827fef2f129472","84b16ee19f12c67b123949554652e23e36ed8d728821ed9e3f334f59f3f3747b","e16abb958bbaeb97c5d350e5301e9adb7ae97ba138ebd0d2dff69045e7f34024","309c42a2525e199eef6777f3779637fb94a814f0fa5a693b2ac59c2e7f8158b1","ce432c5f1ec76467c6591591ddf3bc2984ee4ea9ab3c549062200eb0ac8e8d4d","59d71a765cc63a48488e89af44b7be2513ae3f6d5dc47066a273b466c884c2c6"],"paragraph_range_zero_based":[39264,39287],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p39264"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates P0 value for sidelink pathloss based power control for PSCCH/PSSCH. If not configured, sidelink pathloss based power control is disabled for PSCCH/PSSCH. When sl-P0-PSSCH-PSCCH-r17 is configured, the UE ignores sl-P0-PSSCH-PSCCH-r16.","paragraph_zero_based":39288},{"literal_text_all_w_t_and_m_t":"dl-Alpha-PSSCH-PSCCH","paragraph_zero_based":39289},{"literal_text_all_w_t_and_m_t":"Indicates alpha value for downlink pathloss based power control for PSCCH/PSSCH when dl-P0-PSSCH-PSCCH is configured. When the field is absent the UE applies the value 1. ","paragraph_zero_based":39290},{"literal_text_all_w_t_and_m_t":"dl-P0-PSSCH-PSCCH","paragraph_zero_based":39291},{"literal_text_all_w_t_and_m_t":"Indicates P0 value for downlink pathloss based power control for PSCCH/PSSCH. If not configured, downlink pathloss based power control is disabled for PSCCH/PSSCH. When dl-P0-PSSCH-PSCCH-r17 is configured, the UE ignores dl-P0-PSSCH-PSCCH-r16.","paragraph_zero_based":39292},{"literal_text_all_w_t_and_m_t":"A Remote UE which is out of coverage, considers downlink pathloss based power control is disabled for PSCCH/PSSCH when dl-P0-PSSCH-PSCCH is configured.","paragraph_zero_based":39293},{"literal_text_all_w_t_and_m_t":"dl-Alpha-PSFCH","paragraph_zero_based":39294},{"literal_text_all_w_t_and_m_t":"Indicates alpha value for downlink pathloss based power control for PSFCH when dl-P0-PSFCH is configured. When the field is absent the UE applies the value 1. For resource pools configured with PSFCH resources overlapping in time, this field is either not configured in any of the resource pools or configured with the same value for all the resource pools.","paragraph_zero_based":39295},{"literal_text_all_w_t_and_m_t":"dl-P0-PSFCH","paragraph_zero_based":39296},{"literal_text_all_w_t_and_m_t":"Indicates P0 value for downlink pathloss based power control for PSFCH. If not configured, downlink pathloss based power control is disabled for PSFCH. When dl-P0-PSFCH-r17 is configured, the UE ignores dl-P0-PSFCH-r16. For resource pools configured with PSFCH resources overlapping in time, this field is either not configured in any of the resource pools or configured with the same value for all the resource pools.","paragraph_zero_based":39297},{"literal_text_all_w_t_and_m_t":"A Remote UE which is out of coverage, considers downlink pathloss based power control is disabled for PSFCH when dl-P0-PSFCH is configured.","paragraph_zero_based":39298},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39299},{"literal_text_all_w_t_and_m_t":"SL-MinMaxMCS-Config field descriptions","paragraph_zero_based":39300},{"literal_text_all_w_t_and_m_t":"sl-MaxMCS-PSSCH","paragraph_zero_based":39301},{"literal_text_all_w_t_and_m_t":"Indicates the maximum MCS value when using the associated MCS table. If no MCS is configured, UE autonomously selects MCS from the full range of values.","paragraph_zero_based":39302},{"literal_text_all_w_t_and_m_t":"sl-MinMCS-PSSCH","paragraph_zero_based":39303},{"literal_text_all_w_t_and_m_t":"Indicates the minimum MCS value when using the associated MCS table. If no MCS is configured, UE autonomously selects MCS from the full range of values.","paragraph_zero_based":39304},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39305},{"literal_text_all_w_t_and_m_t":"–SL-RLC-BearerConfig","paragraph_zero_based":39306},{"literal_text_all_w_t_and_m_t":"The IE SL-RLC-BearerConfig specifies the SL RLC bearer configuration information for NR sidelink communication.","paragraph_zero_based":39307},{"literal_text_all_w_t_and_m_t":"SL-RLC-BearerConfig information element","paragraph_zero_based":39308},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39309},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RLC-BEARERCONFIG-START","paragraph_zero_based":39310},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["e13f833b05c24c291c1f822fb633035fb983e1cfbe9ac140a89d81a37da19f5f","81a9e8ae84e411876c114c9bec7f42c3a23d4b62c8bc343a71daf27e5bc2124a","d3a74dc707068bc9c2199d1ce9cdb2d3522048521cfedb595a22cfb99b66e3ef","c9a94aa2029a1b082d3e06c0dccc73c953f260fef8d6b9e48829652e56e6166b","81bab4d5f644b53657e95ea98877de0091db2f458e799bbdde3b578a75aec614","ffccb05ff8acd5a74bc7ba05eb733fd5bcf180de2bdffa209a551aacd5b8f08f","10f1152367de2a60a22ff62a145c83c05e41ab97287022e3ca92768b14c0db27","adc6a040b4132c706edc5c55bfbdc403dc1d9121c10115700b728fb844bb001e","4f251d41f71c81743e87155f03c7a0dbe98089a321fdbdce450d224f8780b714","05781c1123a1911c30b41e9e40f43c2a1b8f433a693cc30bdceb6d07f1df49d4","c926d5951729c02f3868043c45b2c86a08bc5b26ad6f5ccf292a4d197ab88fc4","0a4b51995e295dbc04e7ab52d76bef08c6e568bff066c4211ea17b1328ce778f","cb6d2a9d4539c60091bc9902d451fd586ba596b17a573078e01c13c507baa0c1","335c4240f2ae6238e8fc0b1908e21b34cd361efdd1a4a5fef8ab1aeb92919bad","6f4efa8b43683247d8e3ed9f7f5f2f4f74a86e9cc78b9635af5d18044521fd3d","3148dcb20b9e9903782f08ce3d7360321c34fde6e82f943dbd35f573bb12c575","b1e355cc969af77161023eb61e53a099195193a8a72ba97d88f1325ee8ff06cb","08e0d65039ae8b205545230fcfcf47e1b7af1c807ec112a8347e09034b94c052","0e66a43645c2e627cc3f8ed7579a6f8955fb09dde16dbc51ede2f12a50835948","124b4ab9e1d7858a5819643dacd24eced02a2f981e32e2abf367407d1a2c4bde","4ad8d146cf72dfff25c480516142dcbb5942750d93e0e26eebb7cfa6ffc307fe","e628bc2df53fcf43894a7eb6ff3da96ea8b7efc69b44d896777f047364b4677a","c090e0de9e2f8517fba1dd895f06a8dd6128e8023952a57c8904e04e792cc023","5fe693068d111f76ef420bc033133afe59d981d2de899782cb4de14d3556c373"],"paragraph_range_zero_based":[39288,39311],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p39288"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SL-RLC-BearerConfig-r16 ::=                   SEQUENCE {","paragraph_zero_based":39312},{"literal_text_all_w_t_and_m_t":"    sl-RLC-BearerConfigIndex-r16                  SL-RLC-BearerConfigIndex-r16,","paragraph_zero_based":39313},{"literal_text_all_w_t_and_m_t":"    sl-ServedRadioBearer-r16                      SLRB-Uu-ConfigIndex-r16                          OPTIONAL,   -- Cond LCH-SetupOnly","paragraph_zero_based":39314},{"literal_text_all_w_t_and_m_t":"    sl-RLC-Config-r16                             SL-RLC-Config-r16                                OPTIONAL,   -- Cond LCH-Setup","paragraph_zero_based":39315},{"literal_text_all_w_t_and_m_t":"    sl-MAC-LogicalChannelConfig-r16               SL-LogicalChannelConfig-r16                      OPTIONAL,   -- Cond LCH-Setup","paragraph_zero_based":39316},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":39317},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39318},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39319},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RLC-BEARERCONFIG-STOP","paragraph_zero_based":39320},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39321},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39322},{"literal_text_all_w_t_and_m_t":"SL-RLC-BearerConfig field descriptions","paragraph_zero_based":39323},{"literal_text_all_w_t_and_m_t":"sl-MAC-LogicalChannelConfig","paragraph_zero_based":39324},{"literal_text_all_w_t_and_m_t":"The field is used to configure MAC SL logical channel parameters.","paragraph_zero_based":39325},{"literal_text_all_w_t_and_m_t":"sl-RLC-BearerConfigIndex","paragraph_zero_based":39326},{"literal_text_all_w_t_and_m_t":"The index of the RLC bearer configuration.","paragraph_zero_based":39327},{"literal_text_all_w_t_and_m_t":"sl-RLC-Config","paragraph_zero_based":39328},{"literal_text_all_w_t_and_m_t":"Determines the RLC mode (UM, AM) and provides corresponding parameters.","paragraph_zero_based":39329},{"literal_text_all_w_t_and_m_t":"sl-ServedRadioBearer","paragraph_zero_based":39330},{"literal_text_all_w_t_and_m_t":"Associates the sidelink RLC Bearer with a sidelink DRB. It indicates the index of SL radio bearer configuration, which is corresponding to the RLC bearer configuration.","paragraph_zero_based":39331},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39332},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":39333},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":39334},{"literal_text_all_w_t_and_m_t":"LCH-Setup","paragraph_zero_based":39335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["a0f6f48ff41bd959394ded5d0fb19d715e453876457abd3c1eebb0891a75132f","f35a6e96b29278d12cb619dbe8a4e6769ee6651bd0c4d3c2840a1ec6c3988947","fac3d713890b9e61c038dac2afa863b5c3bfb049b8a0eff919c2fe7b7cbebe1b","d9eeb47bd1821ca132048646903c1319ae1f7d21e912785de3331a0c2d3c7b94","f17cc3edab2af1a4e207cd202302c8173cf77fc4cbebf79bf732c01d59ad4881","03392d1bafbdd8904091d59275dd313a20b286b6443273718c2b529f9cd783d6","3a5d2ba015a30c2590528d0df51bc3e084fe42653766d107452ea074b16c3759","8918fe40c1736df80407c264319b4f7c4c5c48b916af645e820f1cdc9482bf07","a2e10122b683f5c0d878683ae8c947ab0fff6407ab50c424d37b1162363624ca","2cd28eb91e15fb9abc627049debc74764b43cac7f459b00c1abcd664a2521db2","a8f790ee572702d69469b13b3d315099b087a2def616010b56ca0aa4da0462d3","f1e5774762fc2196ba1fcec9946b10bdf3dac6c84cae891e5255fd3b61da164b","7bee24319e13cd82e0cafb8f