{"fields":{"filename":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"RRCReconfigurationComplete-v1700-IEs ::=    SEQUENCE {","paragraph_zero_based":2208},{"literal_text_all_w_t_and_m_t":"    needForGapNCSG-InfoNR-r17                   NeedForGapNCSG-InfoNR-r17                                               OPTIONAL,","paragraph_zero_based":2209},{"literal_text_all_w_t_and_m_t":"    needForGapNCSG-InfoEUTRA-r17                NeedForGapNCSG-InfoEUTRA-r17                                            OPTIONAL,","paragraph_zero_based":2210},{"literal_text_all_w_t_and_m_t":"    selectedCondRRCReconfig-r17                 CondReconfigId-r16                                                      OPTIONAL,","paragraph_zero_based":2211},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                        RRCReconfigurationComplete-v1720-IEs                                    OPTIONAL","paragraph_zero_based":2212},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2213},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2214},{"literal_text_all_w_t_and_m_t":"RRCReconfigurationComplete-v1720-IEs ::=    SEQUENCE {","paragraph_zero_based":2215},{"literal_text_all_w_t_and_m_t":"    uplinkTxDirectCurrentMoreCarrierList-r17    UplinkTxDirectCurrentMoreCarrierList-r17                                OPTIONAL,","paragraph_zero_based":2216},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                        SEQUENCE {}                                                             OPTIONAL","paragraph_zero_based":2217},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2218},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2219},{"literal_text_all_w_t_and_m_t":"-- TAG-RRCRECONFIGURATIONCOMPLETE-STOP","paragraph_zero_based":2220},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":2221},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2222},{"literal_text_all_w_t_and_m_t":"RRCReconfigurationComplete-IEs field descriptions","paragraph_zero_based":2223},{"literal_text_all_w_t_and_m_t":"needForGapsInfoNR","paragraph_zero_based":2224},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the measurement gap requirement information of the UE for NR target bands.","paragraph_zero_based":2225},{"literal_text_all_w_t_and_m_t":"needForGapNCSG-InfoEUTRA","paragraph_zero_based":2226},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the measurement gap and NCSG requirement information of the UE for EUTRA target bands.","paragraph_zero_based":2227},{"literal_text_all_w_t_and_m_t":"needForGapNCSG-InfoNR","paragraph_zero_based":2228},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the measurement gap and NCSG requirement information of the UE for NR target bands.","paragraph_zero_based":2229},{"literal_text_all_w_t_and_m_t":"scg-Response","paragraph_zero_based":2230},{"literal_text_all_w_t_and_m_t":"In case of NR-DC (nr-SCG-Response), this field includes the RRCReconfigurationComplete message. In case of NE-DC (eutra-SCG-Response), this field includes the E-UTRA RRCConnectionReconfigurationComplete message as specified in TS 36.331 [10].","paragraph_zero_based":2231}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ffe6aa9e169eee2e55d5910307b90f1a0088b587d5b1b62ff44829994c9db517","original_member_sha256":"470fa87ca234afd3cdd6813f454487933839ab990f95bcfa5c1735fcd90b61bf","paragraph_ElementTree_utf8_XML_sha256":["84be3b7b31e95cb078416baae08d5c8b75af8d18cdcb31e86f53e361cac5a04d","84652ba0d1ebcfac4ecc777d46b7aad7219fa81c4e9d6a78ae988d1c31d1cf5f","ec1625e30399b7d3d6a1abef0cba603155539566285150a715c03cae5f4cbb67","362bb77839b53a8053b8bd7aaaf89a9de8d2c2f605cb71946f90ad8b1f60fc6f","48a107a6d2c589f80457a415d