{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>include minSchedulingOffsetPreference in the UEAssistanceInformation message;","paragraph_zero_based":6528},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on the minimum scheduling offset for cross-slot scheduling for the cell group:","paragraph_zero_based":6529},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the value of K0 (TS 38.214 [19], clause 5.1.2.1) for cross-slot scheduling with 15 kHz SCS:","paragraph_zero_based":6530},{"literal_text_all_w_t_and_m_t":"4>include preferredK0-SCS-15kHz in the MinSchedulingOffsetPreference IE and set it to the desired value of K0;","paragraph_zero_based":6531},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the value of K0 for cross-slot scheduling with 30 kHz SCS:","paragraph_zero_based":6532},{"literal_text_all_w_t_and_m_t":"4>include preferredK0-SCS-30kHz in the MinSchedulingOffsetPreference IE and set it to the desired value of K0;","paragraph_zero_based":6533},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the value of K0 for cross-slot scheduling with 60 kHz SCS:","paragraph_zero_based":6534},{"literal_text_all_w_t_and_m_t":"4>include preferredK0-SCS-60kHz in the MinSchedulingOffsetPreference IE and set it to the desired value of K0;","paragraph_zero_based":6535},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the value of K0 for cross-slot scheduling with 120 kHz SCS:","paragraph_zero_based":6536},{"literal_text_all_w_t_and_m_t":"4>include preferredK0-SCS-120kHz in the MinSchedulingOffsetPreference IE and set it to the desired value of K0;","paragraph_zero_based":6537},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the value of K2 (TS 38.214 [19], clause 6.1.2.1) for cross-slot scheduling with 15 kHz SCS:","paragraph_zero_based":6538},{"literal_text_all_w_t_and_m_t":"4>include preferredK2-SCS-15kHz in the MinSchedulingOffsetPreference IE and set it to the desired value of K2;","paragraph_zero_based":6539},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the value of K2 for cross-slot scheduling with 30 kHz SCS:","paragraph_zero_based":6540},{"literal_text_all_w_t_and_m_t":"4>include preferredK2-SCS-30kHz in the MinSchedulingOffsetPreference IE and set it to the desired value of K2;","paragraph_zero_based":6541},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the value of K2 for cross-slot scheduling with 60 kHz SCS:","paragraph_zero_based":6542},{"literal_text_all_w_t_and_m_t":"4>include preferredK2-SCS-60kHz in the MinSchedulingOffsetPreference IE and set it to the desired value of K2;","paragraph_zero_based":6543},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the value of K2 for cross-slot scheduling with 120 kHz SCS:","paragraph_zero_based":6544},{"literal_text_all_w_t_and_m_t":"4>include preferredK2-SCS-120kHz in the MinSchedulingOffsetPreference IE and set it to the desired value of K2;","paragraph_zero_based":6545},{"literal_text_all_w_t_and_m_t":"2>else (if the UE has no preference on the minimum scheduling offset for cross-slot scheduling for the cell group):","paragraph_zero_based":6546},{"literal_text_all_w_t_and_m_t":"3>do not include preferredK0 and preferredK2 in the MinSchedulingOffsetPreference IE;","paragraph_zero_based":6547},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide minSchedulingOffsetPreferenceExt of a cell group for power saving according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":6548},{"literal_text_all_w_t_and_m_t":"2>include minSchedulingOffsetPreferenceExt in the UEAssistanceInformation message;","paragraph_zero_based":6549},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on the minimum scheduling offset for cross-slot scheduling for the cell group for FR2-2:","paragraph_zero_based":6550},{"literal_text_all_w_t_and_m_t":"3>include minSchedulingOffsetPreferenceExt in the UEAssistanceInformation message;","paragraph_zero_based":6551}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["3222cab1e5d5eebe7d20a636f49e4b958a56e11f42bb3a23ed979dddf1337903","7e4dc799a5578f2f06715689213148f1e8432e982719d886df8c9f379bc81213","597ee1bc7f5edac4366350c1b1af8fe8fda22e1c4d603df4b7309bc079d11a68","78da422cc7fb6702a196895ae9dbca5d00b4543d77ce877a5a66a377168a194c","7275175be48a7cc589b135d3a8ca19447a2f8ffbc65b92cac6cd36741a8c00f3","90e66a3f0d146a3b011a964fb0298a53dced6e24da140d973e64760857f53869","da83d56036c8ebc8ef846d8a69d462c0f8cbf9b8ddf74d34b002541970729bfa","e4b52be797c2a7a3fd4f64b984dcf56be8a6c7922ca970a7c3aee3d618b18e1b","6d75e6d35681d09a168586912aabf4d61661df21782b75f270e46182f2540b51","2776a534e0e42af6310a0ffab91fbbd46f1738f740d080e9587ca856fd8a3532","95bab18034a68c0201729391e86b6487df4bd656f47cca2a7c7cf96e7300d492","6ae3db5f9c0305208e9e123fc0fcb3790eb7f44f30e439c5ff1fbf596d32d5c2","bea7d7d6995f9267d2ecc5f3530c67d98998f6bf08ad423c910a22cf3a4e03a7","b9e0ecb192df1116a8bbcdd439f682e99f1f6d0b013e77fdbf4f05eba8f1a687","1bc9ef20c395f854321dcc90d112620ee18f5e24111266dd327dbdbbeca4e417","166f088ed86957f17fb5e44939148a5a1d4c02c95689638e373809502767ac8b","f526484556bf881a74c2ec4ed8f974735ba61831608d963061c08d86d20891b1","1783bd0a6c7037346ce57aef47fe4a8f1f466c3bd3314515a081af7f5b921dc3","9d2002a55ba58c245db4b91fa63ceffa93666373dcc683e36a43793af6f17d32","6b54ef1704bf65aa622d05b94e2413edf8d15000b434315026793224fdd57334","c31968ebd5ac2f4ce42a6e121bbebcc79b92ce0ab6984429ed9f8614e47c3960","289a3618d3a47f581acdf84da7be99cdabfd1c538ec706623247d4e5a39477ff","fee0153bb0b4524affef3088067c2101d9d023595fa5b98d0fd845b052eccc9b","9edfcb112e43da894290bdeefcef29067752240498045b6280df194dfb5a70a7"],"paragraph_range_zero_based":[6528,6551],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p6528"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>if the UE has a preference for the value of K0 (TS 38.214 [19], clause 5.1.2.1) for cross-slot scheduling with 480 kHz SCS:","paragraph_zero_based":6552},{"literal_text_all_w_t_and_m_t":"5>include preferredK0-SCS-480kHz in the minSchedulingOffsetPreferenceExt IE and set it to the desired value of K0;","paragraph_zero_based":6553},{"literal_text_all_w_t_and_m_t":"4>if the UE has a preference for the value of K0 for cross-slot scheduling with 960 kHz SCS:","paragraph_zero_based":6554},{"literal_text_all_w_t_and_m_t":"5>include preferredK0-SCS-960kHz in the minSchedulingOffsetPreferenceExt IE and set it to the desired value of K0;","paragraph_zero_based":6555},{"literal_text_all_w_t_and_m_t":"4>if the UE has a preference for the value of K2 for cross-slot scheduling with 480 kHz SCS:","paragraph_zero_based":6556},{"literal_text_all_w_t_and_m_t":"5>include preferredK2-SCS-480kHz in the minSchedulingOffsetPreferenceExt IE and set it to the desired value of K2;","paragraph_zero_based":6557},{"literal_text_all_w_t_and_m_t":"4>if the UE has a preference for the value of K2 for cross-slot scheduling with 960 kHz SCS:","paragraph_zero_based":6558},{"literal_text_all_w_t_and_m_t":"5>include preferredK2-SCS-960kHz in the minSchedulingOffsetPreferenceExt IE and set it to the desired value of K2;","paragraph_zero_based":6559},{"literal_text_all_w_t_and_m_t":"3>else (if the UE has no preference on the minimum scheduling offset for cross-slot scheduling for the cell group):","paragraph_zero_based":6560},{"literal_text_all_w_t_and_m_t":"4>do not include preferredK0 and preferredK2 in the minSchedulingOffsetPreferenceExt IE;","paragraph_zero_based":6561},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide a release preference according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":6562},{"literal_text_all_w_t_and_m_t":"2>include releasePreference in the UEAssistanceInformation message;","paragraph_zero_based":6563},{"literal_text_all_w_t_and_m_t":"2>set preferredRRC-State to the desired RRC state on transmission of the UEAssistanceInformation message;","paragraph_zero_based":6564},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide an indication of preference in being provisioned with reference time information according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":6565},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference in being provisioned with reference time information:","paragraph_zero_based":6566},{"literal_text_all_w_t_and_m_t":"3>set referenceTimeInfoPreference to true;","paragraph_zero_based":6567},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":6568},{"literal_text_all_w_t_and_m_t":"3>set referenceTimeInfoPreference to false.","paragraph_zero_based":6569},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide preference on FR2 UL gap according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":6570},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference for FR2 UL gap configuration:","paragraph_zero_based":6571},{"literal_text_all_w_t_and_m_t":"3>set ul-GapFR2-PatternPreference to the preferred FR2 UL gap pattern;","paragraph_zero_based":6572},{"literal_text_all_w_t_and_m_t":"2>else (if the UE has no preference for the FR2 UL gap configuration):","paragraph_zero_based":6573},{"literal_text_all_w_t_and_m_t":"3>do not include ul-GapFR2-PatternPreference in the UL-GapFR2-Preference IE.","paragraph_zero_based":6574},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide MUSIM assistance information according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":6575}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["18c7fca9b0b2b605c71b371c4654fce5a8e86a9deec28efa7013408afd39ca15","06090519b5c36d14e539c5fa163248e74dcdbb8c9a8e773ea38244eecbb6e1b9","86f5b4d59714836819f7a712afbffaa631d4133d3784e3160683993ca8611851","50352e2c29c464d975220ca336b5aa390939c1aade4f4eeb0212a510ebe8551a","70b147fdebc1af068bf6cfc734bfaf9e5a0a5705aaecaed035895de8413e1d51","8af1b2c83db50d88ee05ccc0871b0e59b3dbcd12f41e7d4f85747be973de5782","87e73049825d03853d77096b84288fe4693423c4807101a4d5c68faace7036fa","c69592323cab964ee253317547c5f3e4717209147206b186f6c8101471f060b5","c0f98d8ac8113f275794131649731c8e29ebd843cb36c3d5dc30acfde0d06c43","31fec6102afeec494424c84a5504e949e6173e2d47e34dc0f90ea31450266409","582ac8af0cc9b602cc4752e5c5ddc44ee3e132b2a89890f64e8ff1b94e4a2c58","cb3582b98f95aec578a65979de8d48eb390e0b338413f4195c8a61051246fcda","12182fab65f2581451b2d338ed508fc0ca54e40e397af5ccc73c210393aab7b3","ec997d0b72999526921e41aacd98a52b9408309d99b2d0ed6fd0d92859154ba7","2cca1f11b81febb8f52dc7175253e5a07156202335a2808a487ff5efc04a18bf","0eaadb5467776b525ecf66967fca683441acb854409a2392f2deb3bc97f7a035","b920087e7829d23d66d0fa7ea4bb539185e2ca3c7fa2abf8ee08012cb1d72301","a8b36d615c693ad0197e5745145a497853c573553cb376dd69d866ea9a7d4a68","c335e5762a4762759cdf1cf2030026617393a892452e8a7ff8170cc5f0199dd2","2348a2f04efbe1d42f2954e9463313de19792fab99c8ad58570e82ddc8a70f81","ad74017daea8d6393a7f90f01cb6e879339ae64d6207609c1c8883361463de4b","4f7a56c2e23d2d779fd3530b38bf1b4af06eb52d84a8ef844ec068b9064bb7cc","af1d4ecf01cda1489ddfba9f2f9be74c4f626616fa63817f7998f1717f4ff07f","1cacd8cb852ea6968f9f3a4e68487c8d3761c74316ca6decd21c7c28dfaccdfc"],"paragraph_range_zero_based":[6552,6575],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p6552"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference for MUSIM periodic gap(s):","paragraph_zero_based":6576},{"literal_text_all_w_t_and_m_t":"3>include musim-GapPreferenceList with an entry for each periodic gap the UE prefers to be configured;","paragraph_zero_based":6577},{"literal_text_all_w_t_and_m_t":"4>set musim-GapLength and musim-GapRepetitionAndOffset in the musim-GapInfo IE to the values of the length and the repetition/offset of the gap(s), respectively, the UE prefers to be configured with;","paragraph_zero_based":6578},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference for MUSIM aperiodic gap:","paragraph_zero_based":6579},{"literal_text_all_w_t_and_m_t":"3>include the field musim-GapPreferenceList, with one entry for the aperiodic gap the UE prefers to be configured;","paragraph_zero_based":6580},{"literal_text_all_w_t_and_m_t":"4>include musim-GapLength in the musim-GapInfo IE and set it to the values of the length of the gap the UE prefers to be configured with;","paragraph_zero_based":6581},{"literal_text_all_w_t_and_m_t":"4>optionally include musim-Starting-SFN-AndSubframe in the musim-GapInfo IE and set it to the starting SFN/subframe of the gap the UE prefers to be configured with;","paragraph_zero_based":6582},{"literal_text_all_w_t_and_m_t":"2>if the UE has no longer preference for the periodic/aperiodic gaps:","paragraph_zero_based":6583},{"literal_text_all_w_t_and_m_t":"3>do not include musim-GapPreferenceList in the musim-Assistance IE;","paragraph_zero_based":6584},{"literal_text_all_w_t_and_m_t":"2>if UE has a preference to leave RRC_CONNECTED state:","paragraph_zero_based":6585},{"literal_text_all_w_t_and_m_t":"3>set musim-PreferredRRC-State to the preferred RRC state.","paragraph_zero_based":6586},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide the relaxation state of RLM measurements of a cell group according to 5.7.4.2:","paragraph_zero_based":6587},{"literal_text_all_w_t_and_m_t":"2>if the UE performs RLM measurement relaxation on the cell group according to TS 38.133 [14]:","paragraph_zero_based":6588},{"literal_text_all_w_t_and_m_t":"3>set the rlm-MeasRelaxationState to true;","paragraph_zero_based":6589},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":6590},{"literal_text_all_w_t_and_m_t":"3>set the rlm-MeasRelaxationState to false;","paragraph_zero_based":6591},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide the relaxation state of BFD measurements of a cell group:","paragraph_zero_based":6592},{"literal_text_all_w_t_and_m_t":"2>for each serving cell of the cell group:","paragraph_zero_based":6593},{"literal_text_all_w_t_and_m_t":"3>if the UE performs BFD measurement relaxation on this serving cell according to TS 38.133 [14]:","paragraph_zero_based":6594},{"literal_text_all_w_t_and_m_t":"4>set the n-th bit of bfd-MeasRelaxationState to '1', where n is equal to the servCellIndex value + 1 of the serving cell;","paragraph_zero_based":6595},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":6596},{"literal_text_all_w_t_and_m_t":"4>set the n-th bit of bfd-MeasRelaxationState to '0', where n is equal to the servCellIndex value + 1 of the serving cell.","paragraph_zero_based":6597},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to indicate availability of data mapped to radio bearers not configured for SDT according to 5.7.4.2:","paragraph_zero_based":6598},{"literal_text_all_w_t_and_m_t":"2>include the nonSDT-DataIndication in the UEAssistanceInformation message;","paragraph_zero_based":6599}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["839e5dec93dc4c46d8b0e27cb799f589e3a62bfa485dfd519e8c9b7f55109544","90a193cab0d7210ac66e5e57097d66ff42aab65a485c7a9c287b4ac62bbd953f","7f0ab1ea32a9a74d13beadfa383b382be8819451486adee3d110e82ad0a569a1","ab1acced73094c1a02ec40851c7589a8d25b7d043ca82872881aefa42fae8033","4931bd0aa04b763f61c13b95294ad4d5e19a49e042ab8efaed388205f0a26312","f3c56188d0b6e719ca4ea36a02ff4a402f97bf25d98db71ac4bfe0425ec1e9c3","96f878587b31a2be070a0efdd0ff74cb22701845cfb4a9f44226f03ee35d8781","626e02901393bd4c0e3633803a5d65ef2343c1f3f828bedea5398ebe86d85e56","da5d49765b61947facda9903d7a6adf6d37a5305d240fc09ed75edde62a0760f","a087b12bb14b025fcbbd5831eabd1d5445415cc915fb2764f8c72c4e70f5d9fd","c6c8e1b77012706ca3fd8c2a2de1128f21ca7eeda485d2ed113e7ee98924e318","5615e68c7179529e1a6466fcc1a333fe9444527b2e106cfc355ea11bcee430ff","70dd0229335f7f467c914c29cfe21cd530ba399f71ddd4d17f6c0b903e572c5c","6efc86476cdc739eeb9a9cf0861a40d9f12e24b85729533b3fd3be5a3225af48","d02c57864781c0a4b817c2f75f435f7327b4b15a90f98b31695c92fafe05b3f9","5fdea04f2fac7b96264309a7b29b2ba6514d8ac25fb5d8f6e5b0b3fc187afcdc","21917d96cb82cba945cba93134a8b4c3ad79b36a4125eaa4913b76d8d991794a","f99b8b71753617c8425c58c5661dea51fcacd412ef10539c2bc37a81aaa9c70d","8ba79df2d6a839c72f067b087d0ddc5a09b0c817d43bd0bff810cf0077bca2ab","5abba42906d459a2a68de82b8c7ba1bd3e1b65fb3c2300ef012719df7a4763bd","185d77dfe4c4d964e925646acdd98702832f92bf56fe330a7f47532c1bc6a219","f47021cc1c0c54e60a6256a1061331c346873d189a4c2e9e6f7eef1fa3a8f4a6","2f5d3a4d71d83ca81a483031cd99cfb1b08b23dc2936e7aca96ad47a015cff24","aeda501efe6dbecc63d5054f98c2e8b445e506295b27665915907ebddd5e5d55"],"paragraph_range_zero_based":[6576,6599],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p6576"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>include and set the resumeCause according to the information received from the upper layers, if provided.","paragraph_zero_based":6600},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide an indication of preference for SCG deactivation according to 5.7.4.2:","paragraph_zero_based":6601},{"literal_text_all_w_t_and_m_t":"2>include scg-DeactivationPreference in the UEAssistanceInformation message;","paragraph_zero_based":6602},{"literal_text_all_w_t_and_m_t":"2>set the scg-DeactivationPreference to scgDeactivationPreferred if the UE prefers the SCG to be deactivated, otherwise set it to noPreference;","paragraph_zero_based":6603},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide an indication that the UE has uplink data related to a deactivated SCG according to 5.7.4.2:","paragraph_zero_based":6604},{"literal_text_all_w_t_and_m_t":"2>include uplinkData in the UEAssistanceInformation message.","paragraph_zero_based":6605},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide an indication about whether the criterion for RRM relaxation for connected mode is fulfilled or not fulfilled:","paragraph_zero_based":6606},{"literal_text_all_w_t_and_m_t":"2>if the criterion for RRM measurement relaxation for connected mode is fulfilled:","paragraph_zero_based":6607},{"literal_text_all_w_t_and_m_t":"3>set the rrm-MeasRelaxationFulfilment to true;","paragraph_zero_based":6608},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":6609},{"literal_text_all_w_t_and_m_t":"3>set the rrm-MeasRelaxationFulfilment to false.","paragraph_zero_based":6610},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide the service link propagation delay difference between serving cell and neighbour cell(s) according to 5.7.4.2;","paragraph_zero_based":6611},{"literal_text_all_w_t_and_m_t":"2>include the propagationDelayDifference for each neighbour cell in the neighCellInfoList;","paragraph_zero_based":6612},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to indicate the availability of flight path information according to 5.7.4.2;","paragraph_zero_based":6613},{"literal_text_all_w_t_and_m_t":"2>include the flightPathInfoAvailable;","paragraph_zero_based":6614},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of the UEAssistanceInformation message for configured grant assistance information for NR sidelink communication:","paragraph_zero_based":6615},{"literal_text_all_w_t_and_m_t":"1>if configured to provide configured grant assistance information for NR sidelink communication:","paragraph_zero_based":6616},{"literal_text_all_w_t_and_m_t":"2>include the sl-UE-AssistanceInformationNR;","paragraph_zero_based":6617},{"literal_text_all_w_t_and_m_t":"NOTE 4:It is up to UE implementation when and how to trigger configured grant assistance information for NR sidelink communication.","paragraph_zero_based":6618},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":6619},{"literal_text_all_w_t_and_m_t":"1>if the procedure was triggered to provide configured grant assistance information for NR sidelink communication by an NR RRCReconfiguration message that was embedded within an E-UTRA RRCConnectionReconfiguration:","paragraph_zero_based":6620},{"literal_text_all_w_t_and_m_t":"2>submit the UEAssistanceInformation to lower layers via SRB1, embedded in E-UTRA RRC message ULInformationTransferIRAT as specified in TS 36.331 [10], clause 5.6.28;","paragraph_zero_based":6621},{"literal_text_all_w_t_and_m_t":"1>else if the procedure was triggered to provide UE preference for SCG deactivation or to indicate that the UE with a deactivate SCG has uplink data to send on a DRB for which there is no MCG RLC bearer:","paragraph_zero_based":6622},{"literal_text_all_w_t_and_m_t":"2>submit the UEAssistanceInformation via SRB1 to lower layers for transmission;","paragraph_zero_based":6623}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["ee7e0954fea679048982a0f7a920c788a1e2c4726dfdd9e6bb3082d9487281c3","f673551f258ae99a7f0fb69ae63af9a5d376413be92f57a18043064b2f36ac35","91f94b4cf3c1350193fcd32bbbcbdffd6dc9837541a2d6a656d4f1deea712328","a547fddcc94b8b0a2019763716686cbb4655293b58606dc105607ab70db886ae","d8aaf440b64eb43387c43516921e6840941d39fd84b828a9aeb9273fcce33680","a1acc41d351d158ff59d93c4c9e4c6250d8035bd8afb9cc0e79782fdf1872c47","01ca6521f3ed0e09408405e98fe9dd6da1ac1e31f8349e41e021baffa095f8c9","214ca1b794bfcf880a207d9e17428891a40353409bed90a88b6862385793d1fa","e93f0ee1dbbea9ced8fa351f0ab792df948e5927b6eb6015a7bedfc5ebeadc9b","afed2b2b0555b1e9a361c1396cfaef4e55e7c60cc1bac637cb050071fabf0e38","5a7d4a7facd6c33e11ed4a9878891789ab17dd0e2152f83464be51323e82e456","9024195cc2c79ba8aa3967b32bc56c1a22f7b2f4c7e597c70327b6b3bec194b7","b13403ae9af6b172342962fd6eceb8ab4c67bd1196fea126833c58ddc374250f","375354ea400aed7e06c4c196d020e6e773da49a3bfcbcfc4f0e226e1cd367855","6e2c00ddadbfa4939895fc0642f605b6638b30f58581d84565620e5e22d2d7f0","23f9f67f3febf19bad7f128b79f4b3a5262123eac6f929eee0f46067cb63f401","439a778ee27ed47ce86242cff0896bd8d5bf4d89c9ff20e252110028ddcc546e","5150da0a7caa66c34e03b33edde72e3f63c3b67154c13b315cc1c905b25ac4e9","5033c1cfff2825c1b60da3f779b5a0929b5969eb4f4c2da9017ea0b8129a0031","1219dc90c82deb54068de28ebd02b6abbea020b2751532604a16dbf5bf0ab8e1","072ed19ce5edf6e39e455b9e95ac2e6bdac0c0f8bebc61666f60d7fb1ba8f400","2ecfca92d0690c786b210be5994eec4c73dec3fdab3a3e1d7ad6ebf1feb38908","a6587787b0bf49988b128cc3b167eb96017efe4ab8e6d94a96d27c1d789f0341","21c269ca6849bba38d75ecb5439db12131a94e0e1a679790ea90a798e0e20eec"],"paragraph_range_zero_based":[6600,6623],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p6600"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>else if the UE is in (NG)EN-DC:","paragraph_zero_based":6624},{"literal_text_all_w_t_and_m_t":"2>if SRB3 is configured and the SCG is not deactivated:","paragraph_zero_based":6625},{"literal_text_all_w_t_and_m_t":"3>submit the UEAssistanceInformation message via SRB3 to lower layers for transmission;","paragraph_zero_based":6626},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":6627},{"literal_text_all_w_t_and_m_t":"3>submit the UEAssistanceInformation message via the E-UTRA MCG embedded in E-UTRA RRC message ULInformationTransferMRDC as specified in TS 36.331 [10].","paragraph_zero_based":6628},{"literal_text_all_w_t_and_m_t":"1>else if the UE is in NR-DC:","paragraph_zero_based":6629},{"literal_text_all_w_t_and_m_t":"2>if the UE assistance configuration that triggered this UE assistance information is associated with the SCG:","paragraph_zero_based":6630},{"literal_text_all_w_t_and_m_t":"3>if SRB3 is configured and the SCG is not deactivated:","paragraph_zero_based":6631},{"literal_text_all_w_t_and_m_t":"4>submit the UEAssistanceInformation message via SRB3 to lower layers for transmission;","paragraph_zero_based":6632},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":6633},{"literal_text_all_w_t_and_m_t":"4>submit the UEAssistanceInformation message via the NR MCG embedded in NR RRC message ULInformationTransferMRDC as specified in 5.7.2a.3;","paragraph_zero_based":6634},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":6635},{"literal_text_all_w_t_and_m_t":"3>submit the UEAssistanceInformation message via SRB1 to lower layers for transmission;","paragraph_zero_based":6636},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":6637},{"literal_text_all_w_t_and_m_t":"2>submit the UEAssistanceInformation message to lower layers for transmission.","paragraph_zero_based":6638},{"literal_text_all_w_t_and_m_t":"5.7.4.3aSetting the contents of OverheatingAssistance IE","paragraph_zero_based":6639},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of OverheatingAssistance IE if initiated to provide overheating assistance indication for SCG in (NG)EN-DC according to clause 5.6.10.3 as specified in TS 36.331 [10]:","paragraph_zero_based":6640},{"literal_text_all_w_t_and_m_t":"1>if the UE prefers to temporarily reduce the number of maximum secondary component carriers for SCG:","paragraph_zero_based":6641},{"literal_text_all_w_t_and_m_t":"2>include reducedMaxCCs in the OverheatingAssistance IE;","paragraph_zero_based":6642},{"literal_text_all_w_t_and_m_t":"2>set reducedCCsDL to the number of maximum SCells of the SCG the UE prefers to be temporarily configured in downlink;","paragraph_zero_based":6643},{"literal_text_all_w_t_and_m_t":"2>set reducedCCsUL to the number of maximum SCells of the SCG the UE prefers to be temporarily configured in uplink;","paragraph_zero_based":6644},{"literal_text_all_w_t_and_m_t":"1>if the UE prefers to temporarily reduce maximum aggregated bandwidth of FR1 for SCG:","paragraph_zero_based":6645},{"literal_text_all_w_t_and_m_t":"2>include reducedMaxBW-FR1 in the OverheatingAssistance IE;","paragraph_zero_based":6646},{"literal_text_all_w_t_and_m_t":"2>set reducedBW-FR1-DL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all downlink carriers of FR1 of the SCG;","paragraph_zero_based":6647}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["513d727c351d29c80083a920987c03f3f42732388aedfcec746416b