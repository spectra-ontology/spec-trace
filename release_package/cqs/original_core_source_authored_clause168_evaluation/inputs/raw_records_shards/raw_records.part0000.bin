aragraph_zero_based":32343},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32344},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETDOWNLINK-STOP","paragraph_zero_based":32345},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32346},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32347},{"literal_text_all_w_t_and_m_t":"FeatureSetDownlink field descriptions","paragraph_zero_based":32348},{"literal_text_all_w_t_and_m_t":"featureSetListPerDownlinkCC","paragraph_zero_based":32349},{"literal_text_all_w_t_and_m_t":"Indicates which features the UE supports on the individual DL carriers of the feature set (and hence of a band entry that refer to the feature set). The UE shall hence include at least as many FeatureSetDownlinkPerCC-Id in this list as the number of carriers it supports according to the ca-BandwidthClassDL, except if indicating additional functionality by reducing the number of FeatureSetDownlinkPerCC-Id in the feature set (see NOTE 1 in FeatureSetCombination IE description). The order of the elements in this list is not relevant, i.e., the network may configure any of the carriers in accordance with any of the FeatureSetDownlinkPerCC-Id in this list.","paragraph_zero_based":32350},{"literal_text_all_w_t_and_m_t":"supportedSRS-Resources","paragraph_zero_based":32351}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["f133b536eee8f49bacc1266a2447306bd0531e65c56ad5c24036335e2721e796","0beae2540e2d5f610da1ca37495c066f1c6501c8ae0d62275eae7d2bc2c5172a","4fee4d188f118f5c5f309ba7b09590205342490b49b148ae61574d19078855fc","a38202fb9f687e8b14422fbb12b5fb938f4abb924245e3315fb0ab7d3c00ad94","06d3ce6b7e0a0e048810d08bf5da2b10496aa322806b