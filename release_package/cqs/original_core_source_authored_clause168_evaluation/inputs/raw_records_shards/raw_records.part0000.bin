{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        ra-PrioritizationForAI-r16                           BIT STRING (SIZE (2))","paragraph_zero_based":24888},{"literal_text_all_w_t_and_m_t":"    }                                                                                                                   OPTIONAL, -- Cond InitialBWP-Only","paragraph_zero_based":24889},{"literal_text_all_w_t_and_m_t":"    ra-ContentionResolutionTimer-r16                     ENUMERATED {sf8, sf16, sf24, sf32, sf40, sf48, sf56, sf64}     OPTIONAL, -- Cond 2StepOnly","paragraph_zero_based":24890},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":24891},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":24892},{"literal_text_all_w_t_and_m_t":"    ra-PrioritizationForSlicingTwoStep-r17               RA-PrioritizationForSlicing-r17              OPTIONAL, -- Cond InitialBWP-Only","paragraph_zero_based":24893},{"literal_text_all_w_t_and_m_t":"    featureCombinationPreamblesList-r17 SEQUENCE (SIZE(1..maxFeatureCombPreamblesPerRACHResource-r17)) OF FeatureCombinationPreambles-r17 OPTIONAL  -- Cond AdditionalRACH","paragraph_zero_based":24894},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":24895},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":24896},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24897},{"literal_text_all_w_t_and_m_t":"GroupB-ConfiguredTwoStepRA-r16 ::=                       SEQUENCE {","paragraph_zero_based":24898},{"literal_text_all_w_t_and_m_t":"    ra-MsgA-SizeGroupA                                   ENUMERATED {b56, b144, b208, b256, b282, b480, b640, b800,","paragraph_zero_based":24899},{"literal_text_all_w_t_and_m_t":"                                                                     b1000, b72, spare6, spare5, spare4, spare3, spare2, spare1},","paragraph_zero_based":24900},{"literal_text_all_w_t_and_m_t":"    messagePowerOffsetGroupB                             ENUMERATED {minusinfinity, dB0, dB5, dB8, dB10, dB12, dB15, dB18},","paragraph_zero_based":24901},{"literal_text_all_w_t_and_m_t":"    numberOfRA-PreamblesGroupA                           INTEGER (1..64)","paragraph_zero_based":24902},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":24903},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24904},{"literal_text_all_w_t_and_m_t":"-- TAG-RACH-CONFIGCOMMONTWOSTEPRA-STOP","paragraph_zero_based":24905},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":24906},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24907},{"literal_text_all_w_t_and_m_t":"RACH-ConfigCommonTwoStepRA field descriptions","paragraph_zero_based":24908},{"literal_text_all_w_t_and_m_t":"featureCombinationPreamblesList","paragraph_zero_based":24909},{"literal_text_all_w_t_and_m_t":"Specifies a series of preamble partitions each associated to a combination of features and 2-step RA. The network does not configure this list to have more than 16 entries.","paragraph_zero_based":24910},{"literal_text_all_w_t_and_m_t":"groupB-ConfiguredTwoStepRA","paragraph_zero_based":24911}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["6d48ce0661f5cbb194220a50e0e4fb83a77ee4f6271ce6090ed6a921a1a7bd44","f35a3e70192422ff7f6445d1e698446f95270dfe27f15288d2d8517c7c095ea4","00ae0c3e3a4acaac07d3f4363d9b93d013b85ac43164997e479b5bca967ee156","4b2a3e2c1136d53cfdd9b44090d7467a51294c8fb6e871da25dedc607f49d7f0","ce8f06721665377e32ff955cea8bf5806b5e3e37b7009e549789830a1a1a0e95","5cba9d2753f2e42ce196b145d534ed5d4b1eb679f476702ff7d1521fae8bae8b","1596d553444ec9e743dee8b537c41331644825bd7512b46ef00f45e2d16c2efa","8706efce6c5464f138ee76fd110dcfa0d75b295d815db354df2f9247541b2b59","6987623577bb208ae37d9e937423e38dbc98eb30ad61780946648310d6611a9a","4e45d3943c55ec31dae28ab5754b0d910030922001aef367d97f8aa375b6202b","c0faccf65fe976e2782b583faf2a849a7c156662264db3750c67c1751c008d76","7ca124452e100b8b99fc09077d7e089ead16162c7805464ed634d8935fa57c24","4d35280425c35ed65e52841f893ed90ebe1f3d20c0aefd42db0895ca1c7b0586","6843195c752ed7ab8e9c7e31dfdee8da710301e8b975d45084b8b429b5d50663","e71e2165fd34fbe9992e9927645f091575e03fc0ff50b295e027f253b1246653","484e41bb990beb456045ce3ad64dacb9d95770a6ac3e7df7debe075ae59fd4b8","be55a1abb44f9ed97338b8d3c32b294492a67471663e1882929a0da80adefb49","389b067751d823c55324445e5e77490c7f6cc4b13c8d38199395f6dfeaaa6af6","945670ffe63988e1d4b5a10985c15933cf362cf465af743f53041e79941d3535","b0b4cf213b59e9ea30056e0e2e0a1579c37cc6763ffcea8ec019d7921203f5ed","70784aa05f6e0d200051d6463f615aa3e5bb7f1cb07af9a306371c982ac0298a","de35568127c852b73dd58829dfb1ac0e5ff62733d285e4e7cfb4310b3a39e3a4","4af2345e5af0ceb992bd3e914a0067fdd998c72b555b2898e15dabbde40332fb","40d6b47348c41faebd61a43fddfcba872f5d244498e17c7b3f207247a7df2040"],"paragraph_range_zero_based":[24888,24911],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p24888"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Preamble grouping for 2-step random access type. If the field is absent then there is only one preamble group configured and only one msgA PUSCH configuration.","paragraph_zero_based":24912},{"literal_text_all_w_t_and_m_t":"msgA-CB-PreamblesPerSSB-PerSharedRO","paragraph_zero_based":24913},{"literal_text_all_w_t_and_m_t":"Number of contention-based preambles used for 2-step RA type from the non-CBRA 4-step type preambles associated with each SSB for RO shared with 4-step type RA. The number of preambles for 2-step RA type shall not exceed the number of preambles per SSB minus the number of contention-based preambles per SSB for 4-step type RA. The possible value range for this parameter needs to be aligned with value range for the configured SSBs per RACH occasion in ssb-perRACH-OccasionAndCB-PreamblesPerSSB in RACH-ConfigCommon. The field is only applicable for the case of shared ROs with 4-step type random access.","paragraph_zero_based":24914},{"literal_text_all_w_t_and_m_t":"msgA-PRACH-RootSequenceIndex","paragraph_zero_based":24915},{"literal_text_all_w_t_and_m_t":"PRACH root sequence index. If the field is not configured in RACH-ConfigCommonTwoStepRA which is configured directly within a BWP (i.e., not within AdditionalRACH-Config), the UE applies the value in field prach-RootSequenceIndex in RACH-ConfigCommon in the configured BWP. If the field is absent in RACH-ConfigCommonTwoStepRA in AdditionalRACH-Config, the UE applies the corresponding value of prach-RootSequenceIndex in RACH-ConfigCommon in the same AdditionalRACH-Config. When both 2-step and 4-step type random access is configured, this field is only configured for the case of separate ROs between 2-step and 4-step type random access.","paragraph_zero_based":24916},{"literal_text_all_w_t_and_m_t":"For FR2-2, only the following values are applicable depending on the used subcarrier spacing:","paragraph_zero_based":24917},{"literal_text_all_w_t_and_m_t":"120 kHz:  L=139, L=571, and L=1151","paragraph_zero_based":24918},{"literal_text_all_w_t_and_m_t":"480 kHz:  L=139, and L=571","paragraph_zero_based":24919},{"literal_text_all_w_t_and_m_t":"960 kHz:  L=139","paragraph_zero_based":24920},{"literal_text_all_w_t_and_m_t":"msgA-RestrictedSetConfig","paragraph_zero_based":24921},{"literal_text_all_w_t_and_m_t":"Configuration of an unrestricted set or one of two types of restricted sets for 2-step random access type preamble. If the field is not configured in RACH-ConfigCommonTwoStepRA which is configured directly within a BWP (i.e. not within AdditionalRACH-Config), the UE applies the value in field restrictedSetConfig in RACH-ConfigCommon in the configured BWP. If the field is absent in RACH-ConfigCommonTwoStepRA in AdditionalRACH-Config, the UE applies the value of restrictedSetConfig in RACH-ConfigCommon in the same AdditionalRACH-Config. When both 2-step and 4-step type random access is configured, this field is only configured for the case of separate ROs between 2-step and 4-step type random access.","paragraph_zero_based":24922},{"literal_text_all_w_t_and_m_t":"msgA-RSRP-Threshold","paragraph_zero_based":24923},{"literal_text_all_w_t_and_m_t":"The UE selects 2-step random access type to perform random access based on this threshold (see TS 38.321 [3], clause 5.1.1). This field is only present if both 2-step and 4-step RA type are configured for the BWP.","paragraph_zero_based":24924},{"literal_text_all_w_t_and_m_t":"msgA-RSRP-ThresholdSSB","paragraph_zero_based":24925},{"literal_text_all_w_t_and_m_t":"UE may select the SS block and corresponding PRACH resource for path-loss estimation and (re)transmission based on SS blocks that satisfy the threshold (see TS 38.213 [13]).","paragraph_zero_based":24926},{"literal_text_all_w_t_and_m_t":"msgA-SSB-PerRACH-OccasionAndCB-PreamblesPerSSB","paragraph_zero_based":24927},{"literal_text_all_w_t_and_m_t":"The meaning of this field is twofold: the CHOICE conveys the information about the number of SSBs per RACH occasion. Value oneEight corresponds to one SSB associated with 8 RACH occasions, value oneFourth corresponds to one SSB associated with 4 RACH occasions, and so on. The ENUMERATED part indicates the number of Contention Based preambles per SSB. Value n4 corresponds to 4 Contention Based preambles per SSB, value n8 corresponds to 8 Contention Based preambles per SSB, and so on. The total number of CB preambles in a RACH occasion is given by CB-preambles-per-SSB * max(1, SSB-per-rach-occasion). If the field is not configured in RACH-ConfigCommonTwoStepRA which is configured directly within a BWP (i.e. not within AdditionalRACH-Config) and both 2-step and 4-step are configured for the BWP, the UE applies the value in the field ssb-perRACH-OccasionAndCB-PreamblesPerSSB in RACH-ConfigCommon. If the field is not configured in AdditionalRACH-Config and both 2-step and 4-step are configured in AdditionalRACH-Config, the UE applies the value in the field ssb-perRACH-OccasionAndCB-PreamblesPerSSB in RACH-ConfigCommon in the same AdditionalRACH-Config. The field is not present when RACH occasions are shared between 2-step and 4-step type random access in the BWP.","paragraph_zero_based":24928},{"literal_text_all_w_t_and_m_t":"msgA-SSB-SharedRO-MaskIndex","paragraph_zero_based":24929},{"literal_text_all_w_t_and_m_t":"Indicates the subset of 4-step type ROs shared with 2-step random access type for each SSB. This field is configured when there is more than one RO per SSB. If the field is absent, and 4-step and 2-step has shared ROs, then all ROs are shared.","paragraph_zero_based":24930},{"literal_text_all_w_t_and_m_t":"msgA-SubcarrierSpacing","paragraph_zero_based":24931},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing of PRACH (see TS 38.211 [16], clause 5.3.2).","paragraph_zero_based":24932},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":24933},{"literal_text_all_w_t_and_m_t":"FR1:    15 or 30 kHz","paragraph_zero_based":24934},{"literal_text_all_w_t_and_m_t":"FR2-1:  60 or 120 kHz","paragraph_zero_based":24935}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["a21ca90995a6c1f0c318cecd7ac04627e459d0accfa813ea944c5f6fa6eab927","84d6f5ea09b080e2199c5099038516455bc15b66ce2d27b08632ff395a180413","ae647ceba73660e651f23f982c3dffd5ed31d58baad710084be64fd01b4f4ef4","27c56ae4eb730cef482b5cf9ecb707d46cf67c70d334fd9da5906a0ff4d49cec","f4242feaa6c34ab6ae22bc7da5ada1600530763eec5c10b3fa1fa1059e2a5494","ee09db89dbf4ed0e72f2d220cdad68ad36bce429c78b34e2d923db908d0d1c3e","48a1cea807d5fb67363bd6f0c59131ea38416913a437583ff5d1d69167a4b08e","b4fb5e026bf59b1f6427286a47973e65b2d02191b3659e4b0c7bd41c9692fb2b","f974a93f1c211b26ebd933a091197998f5edc057222860f5451bb18320261e73","a1b724202db7b3bdc69e40e2a45d2476b84c5007b7d8d4b229be38b856fd051d","ea0a2f86fa7960e3a723d0f7d0271b0608654ae95d72b4e8e2000a8a7801b275","f38038cd5c5da63b202a39c4ceff2bc7563b9f7221d69e7464bf595378bb1918","cdcbe5a97fb3652b054eeb83808940bc30f4b24805b36cef5fec7bf3707200c4","e4fdcbd5fc2cd8fb8467eb849b51c69f0150c99ec85c7d2dafd4341a2f77957b","3ba3c41c59c414a1cd303ef70cd60f0609ad321cc928f720d0620e32e97896f4","38a1732693fb23699fec210686da667040b2f3f3e1a46dd27eff97853c249212","d24db10a879734f05311437dcba12cec434db79303fcdf8696800b93827aae61","2e21ed154d7cd11f9b56e6be62ab661b3f50eade120c90dc01955cd07ae8dd13","42e42385fca02547504d2ac972f190da8385e6abe46089fd37494fe3c19b10e5","6842371b6f7ebd5f82988a00cc7a7cb4e7c6a2ad787dbdf07a84ffdd4441dd74","2ca3c79c0c91532213793320ebbcb1d443fd08ba90646187441d4a46e1c72f2c","4d45d041b8a26d0e002920768caaf735222b6e27bce51e8f7353d10ba13ad5dc","109bf3e8993f86a496cc5b2e360cfd1558f316a9c980fa7820cf86460fede217","10c1eb0b7e0a6f27c2e59559b743c2bbd9f2183cee1afffd017ea10fc0c045d8"],"paragraph_range_zero_based":[24912,24935],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p24912"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz.","paragraph_zero_based":24936},{"literal_text_all_w_t_and_m_t":"If the field is absent, the UE applies the SCS as derived from the msgA-PRACH-ConfigurationIndex in RACH-ConfigGenericTwoStepRA (see tables Table 6.3.3.1-1, Table 6.3.3.1-2, Table 6.3.3.2-2 and Table 6.3.3.2-3, TS 38.211 [16]) in case of 2-step only BWP, otherwise the UE applies the same SCS as Msg1 derived from RACH-ConfigCommon. The value also applies to contention free 2-step random access type (RACH-ConfigDedicated).","paragraph_zero_based":24937},{"literal_text_all_w_t_and_m_t":"msgA-TotalNumberOfRA-Preambles","paragraph_zero_based":24938},{"literal_text_all_w_t_and_m_t":"Indicates the total number of preambles used for contention-based and contention-free 2-step random access type when ROs for 2-step are not shared with 4-step. If the field is absent, and 2-step and 4-step does not have shared ROs, all 64 preambles are available for 2-step random access type.","paragraph_zero_based":24939},{"literal_text_all_w_t_and_m_t":"msgA-TransMax","paragraph_zero_based":24940},{"literal_text_all_w_t_and_m_t":"Max number of MsgA preamble transmissions performed before switching to 4-step random access (see TS 38.321 [3], clauses 5.1.1). This field is only applicable when 2-step and 4-step RA type are configured and switching to 4-step type RA is supported. If the field is absent, switching from 2-step RA type to 4-step RA type is not allowed.","paragraph_zero_based":24941},{"literal_text_all_w_t_and_m_t":"ra-ContentionResolutionTimer","paragraph_zero_based":24942},{"literal_text_all_w_t_and_m_t":"The initial value for the contention resolution timer for fallback RAR in case no 4-step random access type is configured (see TS 38.321 [3], clause 5.1.5). Value sf8 corresponds to 8 subframes, value sf16 corresponds to 16 subframes, and so on. If both 2-step and 4-step random access type resources are configured on the BWP, then this field is absent. If the field is absent in RACH-ConfigCommonTwoStepRA in AdditionalRACH-Config, the UE shall apply the corresponding value in RACH-ConfigCommon in the same AdditionalRACH-Config.","paragraph_zero_based":24943},{"literal_text_all_w_t_and_m_t":"ra-Prioritization","paragraph_zero_based":24944},{"literal_text_all_w_t_and_m_t":"Parameters which apply for prioritized random access procedure on any UL BWP of SpCell for specific Access Identities (see TS 38.321 [3], clause 5.1.1a).","paragraph_zero_based":24945},{"literal_text_all_w_t_and_m_t":"ra-PrioritizationForAI","paragraph_zero_based":24946},{"literal_text_all_w_t_and_m_t":"Indicates whether the field ra-Prioritization-r16 applies for Access Identities. The first/leftmost bit corresponds to Access Identity 1, the next bit corresponds to Access Identity 2. Value 1 for an Access Identity indicates that the field ra-Prioritization-r16 applies, otherwise the field does not apply.","paragraph_zero_based":24947},{"literal_text_all_w_t_and_m_t":"ra-PrioritizationForSlicingTwoStep","paragraph_zero_based":24948},{"literal_text_all_w_t_and_m_t":"Parameters which apply to configure prioritized CBRA 2-step random access type for slicing.","paragraph_zero_based":24949},{"literal_text_all_w_t_and_m_t":"rach-ConfigGenericTwoStepRA","paragraph_zero_based":24950},{"literal_text_all_w_t_and_m_t":"2-step random access type parameters for both regular random access and beam failure recovery.","paragraph_zero_based":24951},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24952},{"literal_text_all_w_t_and_m_t":"GroupB-ConfiguredTwoStepRA field descriptions","paragraph_zero_based":24953},{"literal_text_all_w_t_and_m_t":"messagePowerOffsetGroupB","paragraph_zero_based":24954},{"literal_text_all_w_t_and_m_t":"Threshold for preamble selection. Value is in dB. Value minusinfinity corresponds to –infinity. Value dB0 corresponds to 0 dB, dB5 corresponds to 5 dB and so on. (see TS 38.321 [3], clause 5.1.1).","paragraph_zero_based":24955},{"literal_text_all_w_t_and_m_t":"numberOfRA-PreamblesGroupA","paragraph_zero_based":24956},{"literal_text_all_w_t_and_m_t":"The number of CB preambles per SSB in group A for idle/inactive or connected mode. The setting of the number of preambles for each group should be consistent with msgA-SSB-PerRACH-OccasionAndCB-PreamblesPerSSB or msgA-CB-PreamblesPerSSB-PerSharedRO if configured.","paragraph_zero_based":24957},{"literal_text_all_w_t_and_m_t":"ra-MsgA-SizeGroupA","paragraph_zero_based":24958},{"literal_text_all_w_t_and_m_t":"Transport block size threshold in bits below which the UE shall use a contention-based RA preamble of group A. (see TS 38.321 [3], clause 5.1.1).","paragraph_zero_based":24959}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["77a03bd5323277db98fb5d6bd0536455de83c1f286dee4cfb08a41eea5bac651","e4c6524eac2e56c69ceea3a901a82913b8936083f6d65e72c3bbf1ffb4a702ba","886f98cfddb2c891f4fa0607addd1806a8eac89e2b4252bbc8f899d5fc20313d","a7b7ec4521caa49e347b57ff2719c67c8ec48f6af6929f99ca69be58cbf02738","8d4d01fd6cb35cbd3cac541ea404a37454f7305de7b112bb990b5014045be58d","fc1c2f1d4d080b38085bcf1219c3cea9a63ead20614882b0ec33a4fdb8727dc0","8c8bba37327406dfeddbfce77bc2ab4f0c3e0ee58ef97636aad12ae0f19c8ac3","0aa6a85c68777b996722bc14ba147c1f0416e782f405f5ac74fd3c27bdd35a56","3a795f7ded76d6384b3760597295cd105474d9e327628c2bc2eb7951d1e98c5a","23498fe47011c7436ad780a651b59ba8edef246f944f25025adb17468e487b87","3f3b59731e2392830e3c75e061400ca52adc51b69a9f796ec666bc37be306c8d","014ca6ae7919ee6173eab19852b637fde898755e368e19f000baf1a005f69eef","d9c9227b0a26081ee51e5304df2780ec0efcf7870f2b7c7c0b3525c05225c52f","1d9d90bc0e8bfbb0a9882c140e9b5aa9fd6574898ce98fd39b998684afcfc6d7","78280ee63503b86167677c4a73903e1578902c785880c10dd7ab98a57681e1d4","685495af930f4828aae70a34dda7d599f5804f9c279e918debb515efb19e5ff1","ca941a33ca2e2b9b58ed59cdf143e3f1fe4407c7d577e3a0f08b98a74f6a031e","0e0792e7a0b8fda54fa72ba7cc7661b051bfc30e2b3e861cdda2c7b7c501e19c","01da5832e9ea1afdffd428582bff1762fbc13ae4ffad4bf36d38e80f1135125c","91a2668db4daa423d0cb14dfd39c26cb788ffabea675b2c9eb65d45af3148d81","b4b9b8b2087449e1dfa2923a3b7f5bf3746b15a25d36803da8000b0b88d49e73","9861988eb1a64bae62abdacb576ac208cc489eb8286c587c89d8977e86451850","6c3ff8c46e97bf36f4ba0f2a02c6a6f2fe4d531307f0b00c0f5b4ddad2a7e4f5","9c5ce08ff190849111433706fa4a747cc4aff04deffcfa04dd02eba92f46b0cd"],"paragraph_range_zero_based":[24936,24959],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p24936"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24960},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":24961},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":24962},{"literal_text_all_w_t_and_m_t":"2Step4Step","paragraph_zero_based":24963},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if both 2-step random access type and 4-step random access type are configured in the BWP, otherwise the field is not present.","paragraph_zero_based":24964},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in msgA-ConfigCommon field in AdditionalRACH-Config if both 2-step random access type and 4-step random access type are configured for the same feature combination in the BWP.","paragraph_zero_based":24965},{"literal_text_all_w_t_and_m_t":"2StepOnlyL139","paragraph_zero_based":24966},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if msgA-PRACH-RootSequenceIndex L=139 and no 4-step random access type is configured, otherwise the field is absent, Need S.","paragraph_zero_based":24967},{"literal_text_all_w_t_and_m_t":"2StepOnly","paragraph_zero_based":24968},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in msgA-ConfigCommon field in BWP-UplinkCommon if rach-ConfigCommon field is absent in this BWP-UplinkCommon, otherwise the field is optionally present in msgA-ConfigCommon field in BWP-UplinkCommon, Need S.","paragraph_zero_based":24969},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in msgA-ConfigCommon field in AdditionalRACH-Config if rach-ConfigCommon field is absent in this AdditionalRACH-Config, otherwise the field is optionally present in msgA-ConfigCommon field in AdditionalRACH-Config, Need S.","paragraph_zero_based":24970},{"literal_text_all_w_t_and_m_t":"AdditionalRACH","paragraph_zero_based":24971},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the msgA-ConfigCommon is included in an AdditionalRACH-Config. When included in initialUplinkBWP-RedCap to indicate other feature(s) than redcap, this field is mandatory present with at least two FeatureCombinationPreambles list entries: one list entry indicating only redcap and the other(s) indicating both redcap and one or multiple other feature(s) (e.g. smallData, nsag or msg3-Repetitions).","paragraph_zero_based":24972},{"literal_text_all_w_t_and_m_t":"Otherwise, it is optional, Need R.","paragraph_zero_based":24973},{"literal_text_all_w_t_and_m_t":"InitialBWP-Only","paragraph_zero_based":24974},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, if this BWP is the initial BWP of SpCell. Otherwise, the field is absent.","paragraph_zero_based":24975},{"literal_text_all_w_t_and_m_t":"SharedRO","paragraph_zero_based":24976},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the 2-step random access type occasions are shared with 4-step random access type, otherwise the field is not present.","paragraph_zero_based":24977},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24978},{"literal_text_all_w_t_and_m_t":"–RACH-ConfigDedicated","paragraph_zero_based":24979},{"literal_text_all_w_t_and_m_t":"The IE RACH-ConfigDedicated is used to specify the dedicated random access parameters.","paragraph_zero_based":24980},{"literal_text_all_w_t_and_m_t":"RACH-ConfigDedicated information element","paragraph_zero_based":24981},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":24982},{"literal_text_all_w_t_and_m_t":"-- TAG-RACH-CONFIGDEDICATED-START","paragraph_zero_based":24983}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_m