{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    sst                                 BIT STRING (SIZE (8)),","paragraph_zero_based":28512},{"literal_text_all_w_t_and_m_t":"    sst-SD                              BIT STRING (SIZE (32))","paragraph_zero_based":28513},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28514},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28515},{"literal_text_all_w_t_and_m_t":"-- TAG-S-NSSAI-STOP","paragraph_zero_based":28516},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28517},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28518},{"literal_text_all_w_t_and_m_t":"S-NSSAI field descriptions","paragraph_zero_based":28519},{"literal_text_all_w_t_and_m_t":"sst","paragraph_zero_based":28520},{"literal_text_all_w_t_and_m_t":"Indicates the S-NSSAI consisting of Slice/Service Type, see TS 23.003 [21].","paragraph_zero_based":28521},{"literal_text_all_w_t_and_m_t":"sst-SD","paragraph_zero_based":28522},{"literal_text_all_w_t_and_m_t":"Indicates the S-NSSAI consisting of Slice/Service Type and Slice Differentiator, see TS 23.003 [21].","paragraph_zero_based":28523},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28524},{"literal_text_all_w_t_and_m_t":"–SpeedStateScaleFactors","paragraph_zero_based":28525},{"literal_text_all_w_t_and_m_t":"The IE SpeedStateScaleFactors concerns factors, to be applied when the UE is in medium or high speed state, used for scaling a mobility control related parameter.","paragraph_zero_based":28526},{"literal_text_all_w_t_and_m_t":"SpeedStateScaleFactors information element","paragraph_zero_based":28527},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28528},{"literal_text_all_w_t_and_m_t":"-- TAG-SPEEDSTATESCALEFACTORS-START","paragraph_zero_based":28529},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28530},{"literal_text_all_w_t_and_m_t":"SpeedStateScaleFactors ::=          SEQUENCE {","paragraph_zero_based":28531},{"literal_text_all_w_t_and_m_t":"    sf-Medium                           ENUMERATED {oDot25, oDot5, oDot75, lDot0},","paragraph_zero_based":28532},{"literal_text_all_w_t_and_m_t":"    sf-High                             ENUMERATED {oDot25, oDot5, oDot75, lDot0}","paragraph_zero_based":28533},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28534},{"literal_text_all_w_t_and_m_t":"-- TAG-SPEEDSTATESCALEFACTORS-STOP","paragraph_zero_based":28535}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["3c7e5351d202a733faffd7be2a4fdccc4061d385940c4f466eca6001fb581bbe","017ed650ef32a087f08661cb8c13205f53400ea42a309af65ae8caaed0a368df","b6828acb5948131611c66c1687fc557e9f1b0bb3effa2b5176658b1225681d54","b7377974a009590b2fcc34bac9ff6158a250e2724492439cd6fe3f28f6ec7064","fd270e2120165f0f6a9647be5cbba1da82b5d652bd35e334b1256c35b321d059","b800c83890c78c7a356470df0bad5b15c38d79b8ec11d7ef4ed12902d598987b","f110b6233437749809642801e1d68c94d78f223753ce564e2f7068fae82161f7","8a6617c99a71b6f8768fac975d1aca01349b09b66a5b1cbb78c3ae240147d5c4","37da71b793457a0228a688a0ce36ac3c16e4b4e1b4328130374c719571cc2d37","6a7591ef3d56d578f3e921a931ddc98c4b82ac7d2c94261deef5527d33e7c5e8","143caad91f02d387978886544facd5fa7cd420b4ab1e944cfd99af2353736a17","cf48c2b030228ae72cf633b9c0b21c7ea50a1c0ff0c1c2c466fc16af9bd8f5c8","8084a5e4d40aab234034ddc1cc76692ab8bdc4fd86882b9336b4a2a243680630","86d463f62d8876f9478cac7db84b5b10e94a139c272396b09c4adc803ae3f499","44d0aabc52c8274c75b15f806b67de0630e8c7a28c471a5a638e2fcdb14b6be1","46722c3e10a030b32213000dc110d75b0c30b130be233c01f0711646238e5f63","837b9f6be5ead2537e53766c14624c84b37fe5a72d24a7b757ba6bafa3e62498","6d340e82774976e1423ded3a1b70d1d676bb48a86f251c860e1ac5024ab54c98","a81035710a1088fbcee127c05f0cae18d286bb1f0ed8279fc298ac3c6bddf5ee","bbcd0b15a18fcc3c504bffcfd8d3671f550906bb4629764661c33b0ecf94beb1","51b9fcdffeba5faafa65c6658bcd4edfd24fa3c0a99d883204f3b3e6b38f7815","3ad29d32e9e11c416564626bb8abe94f864e089c0a7bed901b1ea59f8ca70042","3e8fc2877ab6eaca9fed11a7608179734a948d6b6dea54baa6daff70d73a7b1b","56f820248872777f757e0151ad0db6a160f4de4ee74c23d6108e78c6cbeb3408"],"paragraph_range_zero_based":[28512,28535],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p28512"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28536},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28537},{"literal_text_all_w_t_and_m_t":"SpeedStateScaleFactors field descriptions","paragraph_zero_based":28538},{"literal_text_all_w_t_and_m_t":"sf-High","paragraph_zero_based":28539},{"literal_text_all_w_t_and_m_t":"The concerned mobility control related parameter is multiplied with this factor if the UE is in High Mobility state as defined in TS 38.304 [20]. Value oDot25 corresponds to 0.25, value oDot5 corresponds to 0.5, oDot75 corresponds to 0.75 and so on.","paragraph_zero_based":28540},{"literal_text_all_w_t_and_m_t":"sf-Medium","paragraph_zero_based":28541},{"literal_text_all_w_t_and_m_t":"The concerned mobility control related parameter is multiplied with this factor if the UE is in Medium Mobility state as defined in TS 38.304 [20]. Value oDot25 corresponds to 0.25, value oDot5 corresponds to 0.5, value oDot75 corresponds to 0.75, and so on.","paragraph_zero_based":28542},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28543},{"literal_text_all_w_t_and_m_t":"–SPS-Config","paragraph_zero_based":28544},{"literal_text_all_w_t_and_m_t":"The IE SPS-Config is used to configure downlink semi-persistent transmission. Multiple Downlink SPS configurations may be configured in one BWP of a serving cell.","paragraph_zero_based":28545},{"literal_text_all_w_t_and_m_t":"SPS-Config information element","paragraph_zero_based":28546},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28547},{"literal_text_all_w_t_and_m_t":"-- TAG-SPS-CONFIG-START","paragraph_zero_based":28548},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28549},{"literal_text_all_w_t_and_m_t":"SPS-Config ::=                  SEQUENCE {","paragraph_zero_based":28550},{"literal_text_all_w_t_and_m_t":"    periodicity                     ENUMERATED {ms10, ms20, ms32, ms40, ms64, ms80, ms128, ms160, ms320, ms640,","paragraph_zero_based":28551},{"literal_text_all_w_t_and_m_t":"                                                        spare6, spare5, spare4, spare3, spare2, spare1},","paragraph_zero_based":28552},{"literal_text_all_w_t_and_m_t":"    nrofHARQ-Processes              INTEGER (1..8),","paragraph_zero_based":28553},{"literal_text_all_w_t_and_m_t":"    n1PUCCH-AN                      PUCCH-ResourceId                                                            OPTIONAL,   -- Need M","paragraph_zero_based":28554},{"literal_text_all_w_t_and_m_t":"    mcs-Table                       ENUMERATED {qam64LowSE}                                                     OPTIONAL,   -- Need S","paragraph_zero_based":28555},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":28556},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":28557},{"literal_text_all_w_t_and_m_t":"    sps-ConfigIndex-r16             SPS-ConfigIndex-r16                                                         OPTIONAL,   -- Cond SPS-List","paragraph_zero_based":28558},{"literal_text_all_w_t_and_m_t":"    harq-ProcID-Offset-r16          INTEGER (0..15)                                                             OPTIONAL,   -- Need R","paragraph_zero_based":28559}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["1dac33f92430f4f2d1a923fa777525cec4f886206e1d3869897e7f775a97181e","4568d56bff2687cc9e5c148b40d5295e6056732256b61940a0930ada36c35c94","ed7c5fb2b7b0b1653f0530439dae1ee7e0322ace401b0262752f103e03bb42a5","152c63e710fcc7535894e1dcab42dea25296d551ce4054f1f34a172cec86f653","1fd2ec0852f1e4952904d4fae4b892a318f69124e4e5487bb2e42533687ea40b","185952637936b4795f8ad817cca540afa930e533fc27db87a4c8ca8b61da76f4","1cbf0aa0dc4cd4b54de678acdb6076ab739d80b78c107f024929433d400b6081","9f352dd7f9e461cea631645280d664877eaa39266ef3da5fc4028014ae1962f1","351633283c9c70fc7d4f94e233bd95f3bc1fbfd34998ac7f55d0d942a3bf98aa","c2ce372a8a49011238e354fb057a3eeefa39a8ddab3439038263c5b3e23da844","c3e0a326af9e1bbe81e114f59c831c88646b0a371044682972f7b0ab481c7d61","b3229525b78776ebeadd9a121db8012d11e68fd4fb20f3afc6d79422fdad3dde","ae69136650b6e04346210a423ea7cfa1dd247807c7046da9aa33a5df88f8076d","f92538a6ec8128713152683da1e3cba194e53fb2bdbc757ceb3ef9f81b05818f","2a92c9ccb018fc2434a8e3e4a9b4ef8e48ce361b16a0aee233683e59829a2456","86a290b464b7e09485b2421dd3cf8db47bb51535ce7e42e9d855083df7295a56","9763a220bf9f5d263d82bc6abfc057eb73a981f9c3aaeb43f5b36c8f5abdc0ab","c4ee4d02c8afcb761a3a1cd8c59ab147ae3d10fae0263ce76ca41db321b20f08","98c349a35c49f49ded6ee1d48bd2d215a65b0cbd23b76f265ad575a790a9710f","eb1c2467125e9fc23d52277bf696983894740208cec99cbe6dc79256fdc45296","b31ab11507c8d661313f858ae4c131764bd943c776bcce4452ac6e5f14ccaadd","30fe450c6bd9c28fa53e6ad5a29abc5e07ac6ae421970cbae481a4b0306295bb","8364a1f24da40fb4de161702d3d3d178d6db2d3aaae35d4d4037955437e3c111","fab402cc8a2ee6662b2ba86a60ba44423469256adfdb396cb4481f08b27d9e76"],"paragraph_range_zero_based":[28536,28559],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p28536"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    periodicityExt-r16              INTEGER (1..5120)                                                           OPTIONAL,   -- Need R","paragraph_zero_based":28560},{"literal_text_all_w_t_and_m_t":"    harq-CodebookID-r16             INTEGER (1..2)                                                              OPTIONAL,   -- Need R","paragraph_zero_based":28561},{"literal_text_all_w_t_and_m_t":"    pdsch-AggregationFactor-r16     ENUMERATED {n1, n2, n4, n8 }                                                OPTIONAL    -- Need S","paragraph_zero_based":28562},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":28563},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":28564},{"literal_text_all_w_t_and_m_t":"    sps-HARQ-Deferral-r17           INTEGER (1..32)                                                             OPTIONAL,   -- Need R","paragraph_zero_based":28565},{"literal_text_all_w_t_and_m_t":"    n1PUCCH-AN-PUCCHsSCell-r17      PUCCH-ResourceId                                                            OPTIONAL,   -- Need R","paragraph_zero_based":28566},{"literal_text_all_w_t_and_m_t":"    periodicityExt-r17              INTEGER (1..40960)                                                          OPTIONAL,   -- Need R","paragraph_zero_based":28567},{"literal_text_all_w_t_and_m_t":"    nrofHARQ-Processes-v1710        INTEGER(9..32)                                                              OPTIONAL,   -- Need R","paragraph_zero_based":28568},{"literal_text_all_w_t_and_m_t":"    harq-ProcID-Offset-v1700        INTEGER (16..31)                                                            OPTIONAL    -- Need R","paragraph_zero_based":28569},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":28570},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28571},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28572},{"literal_text_all_w_t_and_m_t":"-- TAG-SPS-CONFIG-STOP","paragraph_zero_based":28573},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28574},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28575},{"literal_text_all_w_t_and_m_t":"SPS-Config field descriptions","paragraph_zero_based":28576},{"literal_text_all_w_t_and_m_t":"harq-CodebookID","paragraph_zero_based":28577},{"literal_text_all_w_t_and_m_t":"Indicates the HARQ-ACK codebook index for the corresponding HARQ-ACK codebook for SPS PDSCH and ACK for SPS PDSCH release.","paragraph_zero_based":28578},{"literal_text_all_w_t_and_m_t":"harq-ProcID-Offset","paragraph_zero_based":28579},{"literal_text_all_w_t_and_m_t":"Indicates the offset used in deriving the HARQ process IDs, see TS 38.321 [3], clause 5.3.1.","paragraph_zero_based":28580},{"literal_text_all_w_t_and_m_t":"mcs-Table","paragraph_zero_based":28581},{"literal_text_all_w_t_and_m_t":"Indicates the MCS table the UE shall use for DL SPS (see TS 38.214 [19],clause 5.1.3.1. If present, the UE shall use the MCS table of low-SE 64QAM table indicated in Table 5.1.3.1-3 of TS 38.214 [19]. If this field is absent and field mcs-table in PDSCH-Config is set to 'qam256' and the activating DCI is of format 1_1, the UE applies the 256QAM table indicated in Table 5.1.3.1-2 of TS 38.214 [19]. If this field is absent and the field mcs-Table-r17 in PDSCH-Config is set to 'qam1024' and the activating DCI is format 1_1, the UE applies the 1024QAM table indicated in Table 5.1.3.1-4 of TS 38.214 [19]. Otherwise, the UE applies the non-low-SE 64QAM table indicated in Table 5.1.3.1-1 of TS 38.214 [19].","paragraph_zero_based":28582},{"literal_text_all_w_t_and_m_t":"n1PUCCH-AN","paragraph_zero_based":28583}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["fc9927f8fa130973f2f257aa04267a5d676c3a550bb62cc63a9b872a64961b3f","132008083dfebc6fea388a1c34a23f7d24bf25fa5b6ffe53a49af23af2f6db7d","30de1dfaf55d5db7fa1d9c95eaa94f9c7c8d68a8f353fae1fb4d96bd390d228c","9d0298c03331c817c7713a02c206c0aeedd8b378441c43fa9ca6a1ed064387cd","c9a8fd3a89b058231aff9845ce95a7aefd4bfe9947842bd36bb333b05104fddc","63eb758dd6b9668e4e4a3dfefbec2809c2c32251a3e468da87bbf68873e34dde","62597cd80c56bf98a8307564b15a209d49a03bd21b471ba60f55f0656e6af564","9ddb46cfe63cef10a1965b79c03716aab33bb6592fc1ad9c79b0dd3d6beae95c","613a0a07e76e176cb63fd17325b46b323ff6f9b500e69ca0a7e520d4e22b73c3","f5ab4f30a5d7687b50a354ee4f04edf01d276883f100b32a25828bbb2c245f65","89c59487efa1de0b0b199d8913c14fa82eeba84afd74be9f5e7c7d7bc133ada6","b91ee9828bed0af215704f60da37f71a1585f301969146a057022ecf97876dac","5fbef03f8e0edf21a7c341b01e4a6f47b4d91d2962824d40f1f9005b46bcfde1","5870e26e7601216289a851845172239192b5761295cbb76bdabee025e15ae449","c29705d31fb5b837f81a35886425b54817f83b0a978d35fe064054fc8f2827de","4f10ace37ec00af9eb5cccb2b187964357d69d982bc9206e2d5bf653dec9adb3","e99446e36820e214f807656e1d77c43688544332628013793bac9312295851cf","48cdbc163c2ed7e4c22289ebf82e7a2e60ed0477a857026bdffdccb47cef4eca","adc2a9695844b2db339e84539d1ba755305801f56ed99aba0ae156d19abf8360","fefc256c878d07d7ab4c60596b38a8560c7c740082386b9754841e194349ce64","4186fb3645c4cbc2e734c63a899dd0a534a346447a3e3fd98582dd486b44c354","2798af273d56588990638b51215304deca98350d2d246a095b0049ffc67b8dc0","60f374dcb7fefef0a638adb1e4a8ad544b257d446cfa3a72f32b3062995911ed","9accaa541759d6059aca2f42076ed96555fb300328a868df77e3bfeaa677a8de"],"paragraph_range_zero_based":[28560,28583],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p28560"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"HARQ resource for PUCCH for DL SPS. The network configures the resource either as format0 or format1. The actual PUCCH-Resource is configured in PUCCH-Config and referred to by its ID. See TS 38.213 [13], clause 9.2.3.","paragraph_zero_based":28584},{"literal_text_all_w_t_and_m_t":"n1PUCCH-AN-PUCCHsSCell","paragraph_zero_based":28585},{"literal_text_all_w_t_and_m_t":"HARQ resource for PUCCH on PUCCH switching SCell (sSCell) for DL SPS. The network configures the resource either as format 0 or format 1. The actual PUCCH-Resource is configured in PUCCH-Config of the PUCCH sSCell and referred to by its ID. See TS 38.213 [13], clause 9.2.3.","paragraph_zero_based":28586},{"literal_text_all_w_t_and_m_t":"nrofHARQ-Processes","paragraph_zero_based":28587},{"literal_text_all_w_t_and_m_t":"Number of configured HARQ processes for SPS DL (see TS 38.321 [3], clause 5.8.1). If UE is configured with nrofHARQ-Processes-v1710 UE shall ignore nrofHARQ-Processes (without suffix).","paragraph_zero_based":28588},{"literal_text_all_w_t_and_m_t":"pdsch-AggregationFactor","paragraph_zero_based":28589},{"literal_text_all_w_t_and_m_t":"Number of repetitions for SPS PDSCH (see TS 38.214 [19], clause 5.1.2.1). When the field is absent, the UE applies the value 1 for MBS multicast data and the pdsch-AggregationFactor in pdsch-Config for other data.","paragraph_zero_based":28590},{"literal_text_all_w_t_and_m_t":"periodicity","paragraph_zero_based":28591},{"literal_text_all_w_t_and_m_t":"Periodicity for DL SPS (see TS 38.214 [19] and TS 38.321 [3], clause 5.8.1).","paragraph_zero_based":28592},{"literal_text_all_w_t_and_m_t":"periodicityExt","paragraph_zero_based":28593},{"literal_text_all_w_t_and_m_t":"This field is used to calculate the periodicity for DL SPS (see TS 38.214 [19] and see TS 38.321 [3], clause 5.8.1). If this field is present, the field periodicity is ignored.","paragraph_zero_based":28594},{"literal_text_all_w_t_and_m_t":"The following periodicities are supported depending on the configured subcarrier spacing [ms]:","paragraph_zero_based":28595},{"literal_text_all_w_t_and_m_t":"15 kHz:periodicityExt, where periodicityExt has a value between 1 and 640.","paragraph_zero_based":28596},{"literal_text_all_w_t_and_m_t":"30 kHz:0.5 x periodicityExt, where periodicityExt has a value between 1 and 1280.","paragraph_zero_based":28597},{"literal_text_all_w_t_and_m_t":"60 kHz with normal CP.0.25 x periodicityExt, where periodicityExt has a value between 1 and 2560.","paragraph_zero_based":28598},{"literal_text_all_w_t_and_m_t":"60 kHz with ECP:0.25 x periodicityExt, where periodicityExt has a value between 1 and 2560.","paragraph_zero_based":28599},{"literal_text_all_w_t_and_m_t":"120 kHz:0.125 x periodicityExt, where periodicityExt has a value between 1 and 5120.","paragraph_zero_based":28600},{"literal_text_all_w_t_and_m_t":"480 kHz:0.03125 x periodicityExt, where periodicityExt has a value between 1 and 20480.","paragraph_zero_based":28601},{"literal_text_all_w_t_and_m_t":"960 kHz:0.015625 x periodicityExt, where periodicityExt has a value between 1 and 40960.","paragraph_zero_based":28602},{"literal_text_all_w_t_and_m_t":"periodicityExt-r17 is only applicable for SCS 480 kHz and 960 kHz.","paragraph_zero_based":28603},{"literal_text_all_w_t_and_m_t":"sps-ConfigIndex","paragraph_zero_based":28604},{"literal_text_all_w_t_and_m_t":"Indicates the index of one of multiple SPS configurations.","paragraph_zero_based":28605},{"literal_text_all_w_t_and_m_t":"sps-HARQ-Deferral","paragraph_zero_based":28606},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of slots or subslots the transmission of DL SPS HARQ-ACK in a slot or subslot can be deferred (see TS 38.213 [13], clause 9.2.5.4).","paragraph_zero_based":28607}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["1602c0766406d19e82297ffe8ea79a9f42658c6e6500bd51aaa12a903010524f","9dd9064a1432c0d196c7810547300fc2ea10555a3b3eeae774601d427d89c594","df9d6a1aa55b64f44eda33e56fa3f4a7d9a30158db9196326f154ae1162dcf00","578c0eebee5c96ebfbbc8aac6394cfbea44f10076b8676562552e255a8a10bcf","366fa2482ee44f0d348298be1637b1e1843e82431faaeadc408538fd76136a59","cea3a7f3be23bc6900ead1834cf127f2b8618e6a488d9fc09bab1b3a89ce5a13","15055f5157314d0e5b7131dd5b50205707816192de73e51e048855f0844db8a2","7212bf74b8bf0247f73fcc74cfee366531a3537d74da613f93a8ba5aff0872fa","cfdc3bb900ea9a0cbe10ee72b0b4d800f6cec30f29ff9b5fcfead46dacd06128","549ba0d7aa31b96638bdbeb4d2505eb5389037e1289c4f4e214b22be421919e9","d7e95081f215a2439d9c1ec7974b4f556790482e43c934672b26124b5a34f5a8","3ea702208f9604c8f90579bf42a96b5542246bdf11a4e0e0fa54b6441c05bc3a","b19f69ca051247ccf43f78e014e5f23635b2514ed768d6f01c7b4a4019f16a3a","a0368ced77005a468f474f152c7195cbd514481d49ec3db0ef0d4ca061d0cbd5","d9f90e3d2319be9565f0fd138abbac0ce66702db52e6162ac6d03e022882fca5","7899650ec939141d6c11225634c8db815fa25dceeff22d43012548fdd076d786","0b536d445420a16ad0a64ca3ec89a597d2b62502ded4608df86125c1eb216060","a62bb55f9d75215b052e660854545c22b7be40e31381974966fa9b01775c3305","31a298749f5fe1dd698a591bf6f007f3ac96e6b24e169ee568dc12b98b3bcad1","90a69ae9ac3307e2e41b82906014e2b7e8df267aa0484b9dbee9081593e6b80c","b9e60a5bb1a4592023b4acff586731e9eedfac5770f55d0ea328efcd9d3e198f","407ccacc8a79ab60ac519ed785705070ab58e7d9e1cdee498348bf12dee6daf7","ca53e6cb41740cbc1b2a18d781913bd4fa33d568da92995c0561d9874e9d2473","f4672c89e2f326c094e5290b49e470b0c5228e0c161e84cb36579e0b4ff599a9"],"paragraph_range_zero_based":[28584,28607],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p28584"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28608},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":28609},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":28610},{"literal_text_all_w_t_and_m_t":"SPS-List","paragraph_zero_based":28611},{"literal_text_all_w_t_and_m_t":"The field is mandatory present when included in sps-ConfigToAddModList-r16 or sps-ConfigMulticastToAddModList-r17, otherwise the field is absent.","paragraph_zero_based":28612},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28613},{"literal_text_all_w_t_and_m_t":"–SPS-ConfigIndex","paragraph_zero_based":28614},{"literal_text_all_w_t_and_m_t":"The IE SPS-ConfigIndex is used to indicate the index of one of multiple DL SPS configurations in one BWP.","paragraph_zero_based":28615},{"literal_text_all_w_t_and_m_t":"SPS-ConfigIndex information element","paragraph_zero_based":28616},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28617},{"literal_text_all_w_t_and_m_t":"-- TAG-SPS-CONFIGINDEX-START","paragraph_zero_based":28618},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28619},{"literal_text_all_w_t_and_m_t":"SPS-ConfigIndex-r16             ::= INTEGER (0.. maxNrofSPS-Config-1-r16)","paragraph_zero_based":28620},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28621},{"literal_text_all_w_t_and_m_t":"-- TAG-SPS-CONFIGINDEX-STOP","paragraph_zero_based":28622},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28623},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28624},{"literal_text_all_w_t_and_m_t":"–SPS-PUCCH-AN","paragraph_zero_based":28625},{"literal_text_all_w_t_and_m_t":"The IE SPS-PUCCH-AN is used to indicate a PUCCH resource for HARQ ACK and configure the corresponding maximum payload size for the PUCCH resource.","paragraph_zero_based":28626},{"literal_text_all_w_t_and_m_t":"SPS-PUCCH-AN information element","paragraph_zero_based":28627},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28628},{"literal_text_all_w_t_and_m_t":"-- TAG-SPS-PUCCH-AN-START","paragraph_zero_based":28629},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28630},{"literal_text_all_w_t_and_m_t":"SPS-PUCCH-AN-r16  ::=           SEQUENCE {","paragraph_zero_based":28631}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["081d60604f2e5ea2f2fc84b7d0741e19af354d3f207fb3d510e56edea0567b13","e80cc7a60a59b3789c9b076009b84437d31d8e7993f3eabaed6cb41624384a48","a17b865c41ab609142d46f17e0e0fe39851bcfae26d6b780fc161909a3427823","02c9e6d4547949233fd97d363d83ec2f16590895509ff9e42f424eb2f83a97c1","eb63ed0290ecb913f74f1b739b85224229baf1da7dd1bfe3692383c613408e27","70cbe3e28dc88cf78612b3e0547f91e166fa38d4658bf1a9ee9176ee7a346b8c","f754c4104f558b8806a2ba6a036c6500cbf0b288ec646a95d38f4eb6ca568d2b","156e60f3cc75ad6ddefca2ea5e35f9c85912cc68fe1455ca1924184ed21052fb","ec800f4cf71f620f16cbdec9d57448176c25afae1b04e13e1a759ac74265803e","96aa6779de58aaa68ee2f5b377dcebe1242e9378d2f06de1f099f1f059e83445","ceb69e5342e9a8e2485643ebed1a47df0c1673a6cb3777cae0a2f38d081bd013","9956d20f8abbd3d0a789839d48296a77544f4bf875b7b4d11626e0df72712f4a","14a9e4c8d45340ac45de059ba0b5e3aaae01c90e1789379f555dfd9870fd97e7","614cdb674091fde6518eb10068cc60270f3c0880674019cf2dec2a2a14190231","63ffd1cbb638ebeb5214f2864efbdd160c64abf165322f5f13cd8b34f919a28f","75f36fd6acdee8c1162cbb9478d043c55f8470a62420cc19a2df56d14e009fc2","6fd8f3d3027f9a756dde90e798a1b9c6738d25a7a0ec47a312335b079f5727e1","a5d4641f2