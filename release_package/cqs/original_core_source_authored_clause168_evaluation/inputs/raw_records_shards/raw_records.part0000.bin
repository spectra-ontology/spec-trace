{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                        UE-CapabilityRequestFilterNR-v1540    OPTIONAL","paragraph_zero_based":36072},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":36073},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36074},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRequestFilterNR-v1540 ::=      SEQUENCE {","paragraph_zero_based":36075},{"literal_text_all_w_t_and_m_t":"    srs-SwitchingTimeRequest                    ENUMERATED {true}                     OPTIONAL,  -- Need N","paragraph_zero_based":36076},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                        UE-CapabilityRequestFilterNR-v1710    OPTIONAL","paragraph_zero_based":36077},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":36078},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36079},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRequestFilterNR-v1710 ::=      SEQUENCE {","paragraph_zero_based":36080},{"literal_text_all_w_t_and_m_t":"    sidelinkRequest-r17                         ENUMERATED {true}                     OPTIONAL,  -- Need N","paragraph_zero_based":36081},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                        SEQUENCE {}                           OPTIONAL","paragraph_zero_based":36082},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":36083},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36084},{"literal_text_all_w_t_and_m_t":"-- TAG-UE-CAPABILITYREQUESTFILTERNR-STOP","paragraph_zero_based":36085},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36086},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36087},{"literal_text_all_w_t_and_m_t":"–UE-MRDC-Capability","paragraph_zero_based":36088},{"literal_text_all_w_t_and_m_t":"The IE UE-