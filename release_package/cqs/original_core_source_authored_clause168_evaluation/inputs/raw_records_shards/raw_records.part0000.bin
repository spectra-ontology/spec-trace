{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"       sCS480KHZoneSixteenthT                   SEQUENCE (SIZE (1..maxPO-perPF)) OF INTEGER (0..71679)","paragraph_zero_based":22176},{"literal_text_all_w_t_and_m_t":"    }                                                                                           OPTIONAL,   -- Need R","paragraph_zero_based":22177},{"literal_text_all_w_t_and_m_t":"    pei-ConfigBWP-r17      SEQUENCE {","paragraph_zero_based":22178},{"literal_text_all_w_t_and_m_t":"        pei-SearchSpace-r17                 SearchSpaceId,","paragraph_zero_based":22179},{"literal_text_all_w_t_and_m_t":"        firstPDCCH-MonitoringOccasionOfPEI-O-r17  CHOICE {","paragraph_zero_based":22180},{"literal_text_all_w_t_and_m_t":"            sCS15KHZoneT                                                     SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..139),","paragraph_zero_based":22181},{"literal_text_all_w_t_and_m_t":"            sCS30KHZoneT-SCS15KHZhalfT                                       SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..279),","paragraph_zero_based":22182},{"literal_text_all_w_t_and_m_t":"            sCS60KHZoneT-SCS30KHZhalfT-SCS15KHZquarterT                      SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..559),","paragraph_zero_based":22183},{"literal_text_all_w_t_and_m_t":"            sCS120KHZoneT-SCS60KHZhalfT-SCS30KHZquarterT-SCS15KHZoneEighthT  SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..1119),","paragraph_zero_based":22184},{"literal_text_all_w_t_and_m_t":"            sCS120KHZhalfT-SCS60KHZquarterT-SCS30KHZoneEighthT-SCS15KHZoneSixteenthT SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..2239),","paragraph_zero_based":22185},{"literal_text_all_w_t_and_m_t":"            sCS480KHZoneT-SCS120KHZquarterT-SCS60KHZoneEighthT-SCS30KHZoneSixteenthT SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..4479),","paragraph_zero_based":22186},{"literal_text_all_w_t_and_m_t":"            sCS480KHZhalfT-SCS120KHZoneEighthT-SCS60KHZoneSixteenthT         SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..8959),","paragraph_zero_based":22187},{"literal_text_all_w_t_and_m_t":"            sCS480KHZquarterT-SCS120KHZoneSixteenthT                         SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..17919),","paragraph_zero_based":22188},{"literal_text_all_w_t_and_m_t":"            sCS480KHZoneEighthT                                           SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..35839),","paragraph_zero_based":22189},{"literal_text_all_w_t_and_m_t":"            sCS480KHZoneSixteenthT                                        SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..71679)","paragraph_zero_based":22190},{"literal_text_all_w_t_and_m_t":"        }","paragraph_zero_based":22191},{"literal_text_all_w_t_and_m_t":"    }                                                                                           OPTIONAL     -- Cond InitialBWP-Paging","paragraph_zero_based":22192},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":22193},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":22194},{"literal_text_all_w_t_and_m_t":"    followUnifiedTCI-State-v1720           ENUMERATED {enabled}                                  OPTIONAL     -- Need R","paragraph_zero_based":22195},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":22196},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22197},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22198},{"literal_text_all_w_t_and_m_t":"-- TAG-PDCCH-CONFIGCOMMON-STOP","paragraph_zero_based":22199}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["c0357b03b6b107b27844f1ac5eb110454dc6ddede5c06f9f54a0b1364cbc307c","da557fb7bb89dc7a9d984816e14e94c9853b032efd07c7166a74ef94da1202bc","1d80becd2c5a1be1c134a72e2d15fb0debc4a3662038121bd58eb4355680b293","f5e38d7608640fcf3b2315b637b168cb8a10b0f72ca985fb4b1aa8b9d54e8c2b","4000cf3bc2e2e95b04cc7bc628157c8bb73716c5307f774484e0946b5536d75a","10f91edaeaa0d386c7e5bd16feb197cb2472b286d982fbbe2c07606c1f7f69dd","6a5d77cffa631a4ac610f65ecadc3417df88e912190ccebd499e76fae1df9ac1","6157a5a77c6db375edbb6ec3256fda46a829db8d198077c37574396f41e5064a","eb09428ff8ca9302f665294951bc80ee32e7cc82205baacfb2356ff1f0db637a","9900b012c3a8d1518fa2f7df83d3300ab62bb418e7ff9326665ab51867972a37","ff88ff695f5a40fc12d006fc72235b77116a61b29258512d4034e4091d0465dc","6ac37f0d19fefb3a90a323cbf3d7d58c29843d7dcc7919a3152b864fc6a68c8c","d39ff15f2b3b0ca7d95821e9c76953f783e9d19677feb2c3952cf32ec95d832d","4443a796a743b3e386d66435cdb6d0c105d30aed667cd18a0042d6b38b66e7ea","993f824db4f9163baf55aec268508e32f569f04b172280557049a186cfcfd307","045bce920d6f75ff13bf9d642203c2920d4b3cd48706f5676daefaced0e179bf","e9c29ecea8c421cdab812b0d18f5d9b67b192d1972b703852e6c6cb5b70782bf","139b0bafed01cbe05e13388a139ff56d8b0b77e75da19b173557c5bbb3c93774","176c6e62c21ce83ed20693f9664da29d3c9a831e7cd9e0cc20d29261ded1979e","15fffa78f3bbf7a8cf74067d6709c31f60bebe48bc6a4a01320676f78bcf0653","1d3c7509ff75143237c40919536c6c896716b6c88684f7db9413b50aa2422ee9","133e33754c759b347524975000baa52b2938aacba2251a96b71bac76a27c1999","68e11e7d4f2c6800d650e14aec853c6466d7980e165c550fb78d96fe398f877d","9d2c601ec74288d82a0719d2fc66679eb9b86829f91ea71e5d36a1f94ebd57c8"],"paragraph_range_zero_based":[22176,22199],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p22176"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":22200},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22201},{"literal_text_all_w_t_and_m_t":"PDCCH-ConfigCommon field descriptions","paragraph_zero_based":22202},{"literal_text_all_w_t_and_m_t":"commonControlResourceSet","paragraph_zero_based":22203},{"literal_text_all_w_t_and_m_t":"An additional common control resource set which may be configured and used for any common or UE-specific search space. If the network configures this field, it uses a ControlResourceSetId other than 0 for this ControlResourceSet. The network configures the commonControlResourceSet in SIB1 so that it is contained in the bandwidth of CORESET#0. If the RedCap-specific initial downlink BWP does not contain the entire CORESET#0, the network configures the commonControlResourceSet in the RedCap-specific initial downlink BWP in SIB1 for RedCap such that it does not have to be contained in the bandwidth of CORESET#0.","paragraph_zero_based":22204},{"literal_text_all_w_t_and_m_t":"commonSearchSpaceList, commonSearchSpaceListExt, commonSearchSpaceListExt2","paragraph_zero_based":22205},{"literal_text_all_w_t_and_m_t":"A list of additional common search spaces. If the network configures this field, it uses the SearchSpaceIds other than 0. If the field is included, it replaces any previous list, i.e. all the entries of the list are replaced and each of the SearchSpace entries is considered to be newly created and the conditions and Need codes for setup of the entry apply. If the network includes commonSearchSpaceListExt/commonSearchSpaceListExt2, it includes the same number of entries, and listed in the same order, as in commonSearchSpaceList.","paragraph_zero_based":22206},{"literal_text_all_w_t_and_m_t":"controlResourceSetZero","paragraph_zero_based":22207},{"literal_text_all_w_t_and_m_t":"Parameters of the common CORESET#0 which can be used in any common or UE-specific search spaces. The values are interpreted like the corresponding bits in MIB pdcch-ConfigSIB1. Even though this field is only configured in the initial BWP (BWP#0) controlResourceSetZero can be used in search spaces configured in other DL BWP(s) than the initial DL BWP if the conditions defined in TS 38.213 [13], clause 10 are satisfied.","paragraph_zero_based":22208},{"literal_text_all_w_t_and_m_t":"firstPDCCH-MonitoringOccasionOfPEI-O","paragraph_zero_based":22209},{"literal_text_all_w_t_and_m_t":"Offset, in number of symbols, from the start of the reference frame for PEI-O to the start of the first PDCCH monitoring occasion of PEI-O on this BWP, see TS 38.213 [13], clause 10.4A. For the case po-NumPerPEI is smaller than Ns, UE applies the (floor(i_s/po-NumPerPEI)+1)-th value out of (N_s/po-NumPerPEI) configured values in firstPDCCH-MonitoringOccasionOfPEI-O for the symbol-level offset. When po-NumPerPEI is one or multiple of Ns, UE applies the first configured value in firstPDCCH-MonitoringOccasionOfPEI-O for the symbol-level offset.","paragraph_zero_based":22210},{"literal_text_all_w_t_and_m_t":"firstPDCCH-MonitoringOccasionOfPO","paragraph_zero_based":22211},{"literal_text_all_w_t_and_m_t":"Indicates the first PDCCH monitoring occasion of each PO of the PF on this BWP, see TS 38.304 [20]. The field sCS120KHZquarterT-SCS60KHZoneEighthT-SCS30KHZoneSixteenthT, sCS120KHZoneEighthT-SCS60KHZoneSixteenthT and sCS120KHZoneSixteenthT can be applied for SCS 480kHz, corresponding to sCS480KHZoneT-SCS120KHZquarterT-SCS60KHZoneEighthT-SCS30KHZoneSixteenthT, sCS480KHZhalfT-SCS120KHZoneEighthT-SCS60KHZoneSixteenthT and sCS480KHZquarterT-SCS120KHZoneSixteenthT in IE DownlinkConfigCommonSIB respectively.","paragraph_zero_based":22212},{"literal_text_all_w_t_and_m_t":"followUnifiedTCI-State","paragraph_zero_based":22213},{"literal_text_all_w_t_and_m_t":"When set to enabled, for PDCCH reception in CORESET #0, the UE applies the \"indicated\" DL only TCI or joint TCI as specified in TS 38.214 [19], clause 5.1.5.","paragraph_zero_based":22214},{"literal_text_all_w_t_and_m_t":"pagingSearchSpace","paragraph_zero_based":22215},{"literal_text_all_w_t_and_m_t":"ID of the search space for paging (see TS 38.213 [13], clause 10.1). If the field is absent, the UE does not receive paging in this BWP (see TS 38.213 [13], clause 10). This field is absent for the RedCap-specific initial downlink BWP, if it does not include CD-SSB and the entire CORESET#0. In that case, a RedCap UE in RRC_IDLE or RRC_INACTIVE while SDT procedure is not ongoing, shall monitor paging in the initial DL BWP that includes CORESET#0.","paragraph_zero_based":22216},{"literal_text_all_w_t_and_m_t":"pei-ConfigBWP","paragraph_zero_based":22217},{"literal_text_all_w_t_and_m_t":"Provides the configuration for PEI reception in this BWP. If the field is absent, the UE does not receive PEI in this BWP.","paragraph_zero_based":22218},{"literal_text_all_w_t_and_m_t":"pei-SearchSpace","paragraph_zero_based":22219},{"literal_text_all_w_t_and_m_t":"ID of dedicated search space for PEI. It can be configured to one of up to 4 common SS sets configured by commonSearchSpaceList with SearchSpaceId > 0. The CCE aggregation levels and maximum number of PDCCH candidates per CCE aggregation level follows Table 10.1-1 of TS38.213 [13]. SearchSpaceId = 0 can be configured for the case of SS/PBCH block and CORESET multiplexing pattern 2 or 3.","paragraph_zero_based":22220},{"literal_text_all_w_t_and_m_t":"ra-SearchSpace","paragraph_zero_based":22221},{"literal_text_all_w_t_and_m_t":"ID of the Search space for random access procedure (see TS 38.213 [13], clause 10.1). If the field is absent, the UE does not receive RAR in this BWP. This field is mandatory present in the DL BWP(s) if the conditions described in TS 38.321 [3], clause 5.15 are met.","paragraph_zero_based":22222},{"literal_text_all_w_t_and_m_t":"sdt-SearchSpace","paragraph_zero_based":22223}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["856b97cd474c72aeeeb97ab21b53bbc44d0f89a6b402505f784aa7ecfaba34c6","5b44511e48a87f5a1f240e898d05b36ded5c34e269f917098ce20960d45b5a3c","0e28551e323641457750f423be494d9b501e03c09c1ea10e103fdc145abfdaba","e2cef74dcec3cea322724a7073f0ae2afb0db95eebb3ca4d28a83c95c0f8989d","ecbb9829c0aa669b28b6f98a04b47ce1234158eb77c45a9e8647b85c711ed707","2f29efafc33ed8133de9d460e5cb59f4556d1a0d8ce5333cc7dcd8d9a62d2cde","f96ec900c92dcd8369915c080df701dad416d8610f154bfa333a5b05db882960","4b2969374922baea4449ba7545f2e81dbc9d7bbb08f46525fe540cf3a860cd0b","7b4ebad2f89df616942a470df8e9af0607ba839991507a99b91dfd0256aff55f","3f95a3b2852ff05258949df963f9e22682b6119dcd3137ad57c5f1064ece7025","5e3b787cac80ab626a0a855f0d35c3dfd104bd4054774192481cbaef81645f7a","33edb5913baae1c99341ce0571b91c779cbda9f7f149354798f3b36d9553fb44","b266299607e36327c3ae627c302aa1e33de12d47bbdd2944dae6550485fbe93e","f40909daa422c60efe3664865eede50b076b8aac594b58915aec449dd79aee82","3942bed099586a0eff9e92edb40d5dfe11c0f24e5ee2bf716556ae22bde345da","aec3d7f144788b78fdf74caf50e0b9c02b37a0b20f36e6e5ab6ed90028221c5e","5626217a2d8bfec945677f73faa03505b95eac8060e2f0b2ad4c78c7aede95c1","deb3c35f2c79d95f5ba148b210865ee58175aa95fd72e974cd55bc099072c11e","17be44bcdab903dd11b9b21bb412e271fee8383aa34a60541dc487f7b9656522","c16110a99f8bdfe310181652603516be477b1eb35b396f307373586128829501","a50e50bd2d61fb50473f5f529d8ad83e879bb24682da8932528896e4a5b9bb9b","7d8bbb3a323a97e4f1241d9f10f6b2cefd76233e4a9c897948887e462cd6e6db","4210b95facb33e53b0b8002e0ab2c4d6d2a6a1e1342f4e2da50e0b6bc9e13b6a","56e02d07523765c39c1f9959bd1eb7ff73227fe13f8631ac21e129d319033d21"],"paragraph_range_zero_based":[22200,22223],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p22200"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Common search space for CG-SDT and RA-SDT (see TS 38.213 [13]). If an existingSearchSpace is used, the network only signals the search space ID of the ra-SearchSpace.","paragraph_zero_based":22224},{"literal_text_all_w_t_and_m_t":"searchSpaceMCCH","paragraph_zero_based":22225},{"literal_text_all_w_t_and_m_t":"ID of the search space for MCCH. If the field is absent, the UE does not receive MCCH in this BWP (see TS 38.213 [13], clause 10). This field is absent for the RedCap-specific initial downlink BWP, if it does not include CD-SSB and the entire CORESET#0.","paragraph_zero_based":22226},{"literal_text_all_w_t_and_m_t":"searchSpaceMTCH","paragraph_zero_based":22227},{"literal_text_all_w_t_and_m_t":"ID of the search space for MTCH of MBS broadcast. If the field is absent, the UE applies searchSpaceMCCH also for MTCH, (see TS 38.213 [13], clause 10). This field is absent for the RedCap-specific initial downlink BWP, if it does not include CD-SSB and the entire CORESET#0.","paragraph_zero_based":22228},{"literal_text_all_w_t_and_m_t":"searchSpaceOtherSystemInformation","paragraph_zero_based":22229},{"literal_text_all_w_t_and_m_t":"ID of the Search space for other system information, i.e., SIB2 and beyond (see TS 38.213 [13], clause 10.1). If the field is absent, the UE does not receive other system information in this BWP. This field is absent for the RedCap-specific initial DL BWP, if it does not include CD-SSB and the entire CORESET#0. In that case, a RedCap UE in RRC_IDLE or RRC_INACTIVE shall monitor PDCCH to receive other system information using searchSpaceOtherSystemInformation in the initial DL BWP that includes CD-SSB and the entire CORESET#0.","paragraph_zero_based":22230},{"literal_text_all_w_t_and_m_t":"searchSpaceSIB1","paragraph_zero_based":22231},{"literal_text_all_w_t_and_m_t":"ID of the search space for SIB1 message. In the initial DL BWP of the UE′s PCell, the network sets this field to 0. If the field is absent, the UE does not receive SIB1 in this BWP. (see TS 38.213 [13], clause 10). This field is absent for the RedCap-specific initial DL BWP, if it does not include CD-SSB and the entire CORESET#0. In that case, a RedCap UE in RRC_IDLE or RRC_INACTIVE shall monitor PDCCH to receive SIB1 using searchSpaceSIB1 in the initial DL BWP that includes CD-SSB and the entire CORESET#0.","paragraph_zero_based":22232},{"literal_text_all_w_t_and_m_t":"searchSpaceZero","paragraph_zero_based":22233},{"literal_text_all_w_t_and_m_t":"Parameters of the common SearchSpace#0. The values are interpreted like the corresponding bits in MIB pdcch-ConfigSIB1. Even though this field is only configured in the initial BWP (BWP#0), searchSpaceZero can be used in search spaces configured in other DL BWP(s) than the initial DL BWP if the conditions described in TS 38.213 [13], clause 10, are satisfied.","paragraph_zero_based":22234},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22235},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":22236},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":22237},{"literal_text_all_w_t_and_m_t":"InitialBWP-Only","paragraph_zero_based":22238},{"literal_text_all_w_t_and_m_t":"If SIB1 is broadcast the field is mandatory present in the PDCCH-ConfigCommon of the initial BWP (BWP#0) in ServingCellConfigCommon except it is the RedCap-specific initial BWP not including CD-SSB and the entire CORESET#0; it is absent in other BWPs and when sent in system information. If SIB1 is not broadcast and there is an SSB associated to the cell, the field is optionally present, Need M, in the PDCCH-ConfigCommon of the initial BWP (BWP#0) in ServingCellConfigCommon (still with the same setting for all UEs). In other cases, the field is absent.","paragraph_zero_based":22239},{"literal_text_all_w_t_and_m_t":"OtherBWP","paragraph_zero_based":22240},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, if this BWP is not the initialDownlinkBWP and pagingSearchSpace is configured in this BWP. Otherwise this field is absent.","paragraph_zero_based":22241},{"literal_text_all_w_t_and_m_t":"InitialBWP-Paging","paragraph_zero_based":22242},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, if this BWP is the initialDownlinkBWP or initialDownlinkBWP-RedCap including CD-SSB and the entire CORESET#0, and pei-Config is configured in DownlinkConfigCommonSIB. Otherwise, this field is absent.","paragraph_zero_based":22243},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22244},{"literal_text_all_w_t_and_m_t":"–PDCCH-ConfigSIB1","paragraph_zero_based":22245},{"literal_text_all_w_t_and_m_t":"The IE PDCCH-ConfigSIB1 is used to configure CORESET#0 and search space#0.","paragraph_zero_based":22246},{"literal_text_all_w_t_and_m_t":"PDCCH-ConfigSIB1 information element","paragraph_zero_based":22247}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["bc3688cf7ef961e2cb08f23109f1f61d3cc2f7d428075b753e0aee5c043e0704","d08fa5c434cf04963f834a77a1ac1588e3fcd87407e1e81e4c120a24e5c40634","c3aef354c463798cb76c3fdbd34b2e37ab0b1eabcd87ffb6fc02811ea9bd1eaa","58e10b1b7f82eb114bbd47ccd7263c9fdfb8b4fe32a11bbc3993997ea5ecafc4","b337491f543512397c29cecc4479f23353ba672fece9e4d64390c14545c1ca67","02e98fa3a0ccfde8efbb6b3e8615c08426239fa0049293112c770368ee298e63","496832a8cab4427b4fb5439a338bac5d3cb44a12e0eaefb45175baa178c631ef","b0931fc7f9d0c2d632d581eaa33041f41c1b2cc97c58c71404560842bab58351","e5cb3125db36639cb3fd2d