{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SL-FreqConfig-r16 ::=              SEQUENCE {","paragraph_zero_based":38112},{"literal_text_all_w_t_and_m_t":"    sl-Freq-Id-r16                     SL-Freq-Id-r16,","paragraph_zero_based":38113},{"literal_text_all_w_t_and_m_t":"    sl-SCS-SpecificCarrierList-r16     SEQUENCE (SIZE (1..maxSCSs)) OF SCS-SpecificCarrier,","paragraph_zero_based":38114},{"literal_text_all_w_t_and_m_t":"    sl-AbsoluteFrequencyPointA-r16     ARFCN-ValueNR                                                   OPTIONAL,  -- Need M","paragraph_zero_based":38115},{"literal_text_all_w_t_and_m_t":"    sl-AbsoluteFrequencySSB-r16        ARFCN-ValueNR                                                   OPTIONAL,  -- Need R","paragraph_zero_based":38116},{"literal_text_all_w_t_and_m_t":"    frequencyShift7p5khzSL-r16         ENUMERATED {true}                                               OPTIONAL,  -- Cond V2X-SL-Shared","paragraph_zero_based":38117},{"literal_text_all_w_t_and_m_t":"    valueN-r16                         INTEGER (-1..1),","paragraph_zero_based":38118},{"literal_text_all_w_t_and_m_t":"    sl-BWP-ToReleaseList-r16           SEQUENCE (SIZE (1..maxNrofSL-BWPs-r16)) OF BWP-Id               OPTIONAL,  -- Need N","paragraph_zero_based":38119},{"literal_text_all_w_t_and_m_t":"    sl-BWP-ToAddModList-r16            SEQUENCE (SIZE (1..maxNrofSL-BWPs-r16)) OF SL-BWP-Config-r16    OPTIONAL,  -- Need N","paragraph_zero_based":38120},{"literal_text_all_w_t_and_m_t":"    sl-SyncConfigList-r16              SL-SyncConfigList-r16                                           OPTIONAL,  -- Need M","paragraph_zero_based":38121},{"literal_text_all_w_t_and_m_t":"    sl-SyncPriority-r16                ENUMERATED {gnss, gnbEnb}                                       OPTIONAL   -- Need M","paragraph_zero_based":38122},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":38123},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38124},{"literal_text_all_w_t_and_m_t":"SL-Freq-Id-r16 ::=                     INTEGER (1.. maxNrofFreqSL-r16)","paragraph_zero_based":38125},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38126},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-FREQCONFIG-STOP","paragraph_zero_based":38127},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":38128},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38129},{"literal_text_all_w_t_and_m_t":"SL-FreqConfig field descriptions","paragraph_zero_based":38130},{"literal_text_all_w_t_and_m_t":"frequencyShift7p5khzSL","paragraph_zero_based":38131},{"literal_text_all_w_t_and_m_t":"Enable the NR SL transmission with a 7.5 kHz shift to the LTE raster. If the field is absent, the frequency shift is disabled.","paragraph_zero_based":38132},{"literal_text_all_w_t_and_m_t":"sl-AbsoluteFrequencyPointA","paragraph_zero_based":38133},{"literal_text_all_w_t_and_m_t":"Absolute frequency of the reference resource block (Common RB 0). Its lowest subcarrier is also known as Point A.","paragraph_zero_based":38134},{"literal_text_all_w_t_and_m_t":"sl-AbsoluteFrequencySSB","paragraph_zero_based":38135}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["931a7704d360d32358195b118df6041d6c3c99a16d86bbe58e8f501564118441","1f4a0b5ce1f5a5c3cd537a59bd34de535d05ccab7f1f98fe59e54f3f943559be","558eeadf1669391f453c9ea69b8d8175349a249a1a7cc9fc2b60fef7098f986f","95cd2cda9729c5862a55504c6660d53a53f628d75a14f15265941c2a6a5503bc","7eea54361bde6c170d111f9a8b4e49ead70df9794a3ec83d6277f30a690dc269","81f34ac