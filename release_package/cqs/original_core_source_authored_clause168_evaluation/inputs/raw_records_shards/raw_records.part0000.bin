{"fields":{"filename":"R2-2306827.zip::R2-2306827.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>include sl-PagingDelivery if the Paging message received from network containing the ue-Identity of the L2 U2N Remote UE;","paragraph_zero_based":240},{"literal_text_all_w_t_and_m_t":"1>include sl-SIB1-Delivery if any of the conditions for initiating Uu message transfer procedure related to SIB1 are met;","paragraph_zero_based":241},{"literal_text_all_w_t_and_m_t":"1>include sl-SystemInformationDelivery if any of the conditions for initiating Uu message transfer procedure related to System Information are met;","paragraph_zero_based":242},{"literal_text_all_w_t_and_m_t":"1>submit the UuMessageTransferSidelink message to lower layers for transmission.","paragraph_zero_based":243},{"literal_text_all_w_t_and_m_t":"NOTE:The L2 U2N Relay UE may perform unsolicited forwarding of SIB1 to the L2 U2N Remote UE based on UE implementation.","paragraph_zero_based":244},{"literal_text_all_w_t_and_m_t":"[…]","paragraph_zero_based":245},{"literal_text_all_w_t_and_m_t":"NEXT CHANGE","paragraph_zero_based":246},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":247},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":248},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":249},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":250},{"literal_text_all_w_t_and_m_t":"6.6.2Message definitions","paragraph_zero_based":251},{"literal_text_all_w_t_and_m_t":"[…]","paragraph_zero_based":252},{"literal_text_all_w_t_and_m_t":"–RemoteUEInformationSidelink","paragraph_zero_based":253},{"literal_text_all_w_t_and_m_t":"The RemoteUEInformationSidelink message is used to request SIB(s) or provide paging related information as specified in clause 5.8.9.8.1.","paragraph_zero_based":254},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SL-SRB3","paragraph_zero_based":255},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":256},{"literal_text_all_w_t_and_m_t":"Logical channel: SCCH","paragraph_zero_based":257},{"literal_text_all_w_t_and_m_t":"Direction: L2 U2N Remote UE to L2 U2N Relay UE","paragraph_zero_based":258},{"literal_text_all_w_t_and_m_t":"RemoteUEInformationSidelink message","paragraph_zero_based":259},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":260},{"literal_text_all_w_t_and_m_t":"-- TAG-REMOTEUEINFORMATIONSIDELINK-START","paragraph_zero_based":261},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":262},{"literal_text_all_w_t_and_m_t":"RemoteUEInformationSidelink-r17 ::=           SEQUENCE {","paragraph_zero_based":263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"dec1e4511df8447a3ea458a0ce278295c0151fd5172112dce961ebbde193783e","original_member_sha256":"d20a68ac0bd13aa84db23fe0b3c3cbdd952a7f22a689b8f8c07eda17c3796b74","paragraph_ElementTree_utf8_XML_sha256":["b1021efb9cb1c371c5402968317984b8092d87aee0b33f06e1849b887e494012","8dc35a7d8908e9d14e4ac2235e7d99ad789b7ebafd432ebda2adb12f90adb969","4bf06452b60546a4791a0469d76c7c17f8ccdbd5080c0fd7f90457d59b820049","5881037476b8d7f9d093503effd3fac0067e782868dad68fb963d32a9c5a685a","8275ede57a7e80558df16e5dfaaa135408383c6f7623e5b79c27c29a7fd2115e","fa7a141e3be59eab9a28cb24310b14f4cf80c5ae7abeaf348bb0c44e31e6ef60","574c2486e64f283b5cf2d41b8a4d802a7eda50ce36def338074926277ef394db","c61cb68849218d65f99cbed9017c8ed6b030db4430562af650c55f865492ddbc","2dff9f4eaaa6902b9bf1d1f4f2940b1c3569765d23fd89668a1fc06d4b154e2f","e676cd15ee011b3ad752eb8e44faed55df46519c584e6171c77f1063d11f2fb4","6935b4c842a6ff5562cc061a3189912311001f5fda5b7d6d381a3e667a94b05a","e3ae7047473c9607a3355b276a4124e08f5ec9236da315f002a5b04a26037d10","b4c47a02f3a37a0c3d12a1ab2e99656ec0dff0fede3cdcb6eefcbf44fcf42239","fbf784227ae0bbc1c9e791d6fb439cb80e654158471ee07a5e04fafa56eec636","