{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    }                                                                                                     OPTIONAL  -- Need R","paragraph_zero_based":18624},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18625},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18626},{"literal_text_all_w_t_and_m_t":"SliceCellListNR-r17 ::=           SEQUENCE (SIZE (1..maxCellSlice-r17)) OF PCI-Range","paragraph_zero_based":18627},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18628},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQPRIORITYLISTSLICING-STOP","paragraph_zero_based":18629},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18630},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18631},{"literal_text_all_w_t_and_m_t":"FreqPriorityListSlicing field descriptions","paragraph_zero_based":18632},{"literal_text_all_w_t_and_m_t":"dl-ImplicitCarrierFreq","paragraph_zero_based":18633},{"literal_text_all_w_t_and_m_t":"Indicates the downlink carrier frequency to which sliceInfoList is associated with. The frequency is signalled implicitly, value 0 corresponds to the serving frequency, value 1 corresponds to the first frequency indicated by the InterFreqCarrierFreqList in SIB4, and value 2 corresponds to the second frequency indicated by the InterFreqCarrierFreqList in SIB4, and so on.","paragraph_zero_based":18634},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18635},{"literal_text_all_w_t_and_m_t":"SliceInfo field descriptions","paragraph_zero_based":18636},{"literal_text_all_w_t_and_m_t":"sliceAllowedCellListNR","paragraph_zero_based":18637},{"literal_text_all_w_t_and_m_t":"List of allow-listed cells for slicing. If present, the cells listed in this list support the corresponding nsag-frequency pair, and the cells not listed in this list do not support the corresponding nsag-frequency pair, according to TS 38.304 [20], clause 5.2.4.11.","paragraph_zero_based":18638},{"literal_text_all_w_t_and_m_t":"sliceCellListNR","paragraph_zero_based":18639},{"literal_text_all_w_t_and_m_t":"Contains either the list of allow-listed or exclude-listed cells for slicing. If absent, it implies all the cells support the corresponding nsag-frequency pair, according to 38.304 [20], clause 5.2.4.11.","paragraph_zero_based":18640},{"literal_text_all_w_t_and_m_t":"sliceExcludedCellListNR","paragraph_zero_based":18641},{"literal_text_all_w_t_and_m_t":"List of exclude-listed cells for slicing. If present, the cells listed in this list do not support the corresponding nsag-frequency pair, and the cells not listed in this list support the corresponding nsag-frequency pair, according to TS 38.304 [20], clause 5.2.4.11.","paragraph_zero_based":18642},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18643},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":18644},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":18645},{"literal_text_all_w_t_and_m_t":"Mandatory","paragraph_zero_based":18646},{"literal_text_all_w_t_and_m_t":"The field is mandatory present.","paragraph_zero_based":18647}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["5a2bfe25d2ca3543c7a8e8bda888f724029d60815720319afe3000fa13c9eb9e","8597b69a88ac2f7912a22e1a0a94583de3444eca1d6f89ae09b59b3f80f6c775","b160f94d505691f073b3064884f3da1337c30e2c6d8c4a1a9a6f31f6f80ead84","f15d366af95dfaa8f59a8362d7c81673d771e7f349c214a1a8719bb77d42b6d8","821ad05e58a9cdba1ffe1c8657c4c3f30a1d48c6238427b20c1d1