body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"579202af481741cb7bb8161336b86b02431d52d588c77dded6efecb764b57769","original_member_sha256":"b0505b7e6667faeeee211b1942b347757320657484dec9587529cf442d0bad19","paragraph_ElementTree_utf8_XML_sha256":["e7ee3ac7e8f0387becdae378873d0436ee41c2aac54fd0eb88a5f3657ff4ab7c","99d862fe0fd93f000c9cd50ac85674c6d098c430b169cc6abedae84eba806c22","549bd08054ed437ff3830d5c495b6ba211412b1bbcf82892fca346434e12230e","38eaf53f71bc8faf196c6c8a5939fb76f5f2249abd4ed6cb4171e7ae285b1124","4d8ddcab91cb26617282b8fc3ef65085784fd75fa96b5bacb2d7d98e267d2091","7409c926556712a7be43c382b2f6729442ec8bc1383f1c67a3632e30df95460a","71c731b31ec9a9ab2978a357fd81e9197c24ff8b5097beb9dd51f42a3640be2a","e5d1e964a4b288102bd60f8305f341b6f5c7bb16bf73f61fd5eb4e7fe9d58733","a7988d7a5ce90b8674351506e5d20b76efc9c42f0d722181e9eed82f4786d618","d8fa72923b33e63e838a739dcbb08af3061f8f0559020196399d2536c6d4fb60","339ffd652006ee93f017d5b19648ff0f645ad29061e73149e2d688740f0a64b6","c3cab02940f906073aeb8737733d4c577fcb25f58d09885082fead6c3bd1ab3c","793b96d5ab69227eab891a054480129e86a1e21962c1842082b1903356795320","908830d6f0fe016286a464be1134597b20d51b5e77901917c8fe311ffdf1ede5","1485acda57476dc5e08bcb09d3de669bbcd170b1fbeb969005e99258976bfe82","262730755cc2bc50986802271dedd747439158ce1efe05650ad3b138024e7c93","0d8a75f837597e918dc57c22635f3fd3a3cf7472ca262f8bf2f74144bf94c64b","d7ac67bccdf6f2c51682df0f07b9d2a0282c144742b3a3f0481034a43bd888f9","6a5a0ad7435622e272da0db444c5a0f0e96bee89d6b76f845dbcd07719a8e2c9","b403050aa6ce9ab26288f5c504a4d2be23f60e4842c63f34490c40a288f04662","9477498ab98df9a6fc2982685e23606fe0daf6107f6f6c34836d9510acdc3a6a","57ab18baa0c00a82b7a561003bf8e0e7db6f9271df2add95a6a51974bf59b38b","a82f279b88710c711b2c73835abf13fc7f45fc8253084efb3b2fe092137ba0c2","8d7f907a6bf06d1e02955e977b2a2a1bc29a6d7523bfd651f406e90f8555f030"],"paragraph_range_zero_based":[96,119],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2305849.zip::R2-2305849- CR4118 Correction for release message with re-establishment v1.0.docx:p96"}
{"fields":{"filename":"R2-2305849.zip::R2-2305849- CR4118 Correction for release message with re-establishment v1.0.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.3.7.2Initiation","paragraph_zero_based":120},{"literal_text_all_w_t_and_m_t":"The UE initiates the procedure when one of the following conditions is met:","paragraph_zero_based":121},{"literal_text_all_w_t_and_m_t":"1>upon detecting radio link failure of the MCG and t316 is not configured, in accordance with 5.3.10; or","paragraph_zero_based":122},{"literal_text_all_w_t_and_m_t":"1>upon detecting radio link failure of the MCG while SCG transmission is suspended, in accordance with 5.3.10; or","paragraph_zero_based":123},{"literal_text_all_w_t_and_m_t":"1>upon detecting radio link failure of the MCG while PSCell change or PSCell addition is ongoing, in accordance with 5.3.10; or","paragraph_zero_based":124},{"literal_text_all_w_t_and_m_t":"1>upon detecting radio link failure of the MCG while the SCG is deactivated, in accordance with 5.3.10; or","paragraph_zero_based":125},{"literal_text_all_w_t_and_m_t":"1>upon re-configuration with sync failure of the MCG, in accordance with clause 5.3.5.8.3; or","paragraph_zero_based":126},{"literal_text_all_w_t_and_m_t":"1>upon mobility from NR failure, in accordance with clause 5.4.3.5; or","paragraph_zero_based":127},{"literal_text_all_w_t_and_m_t":"1>upon integrity check failure indication from lower layers concerning SRB1 or SRB2, except if the integrity check failure is detected on the RRCReestablishment message; or","paragraph_zero_based":128},{"literal_text_all_w_t_and_m_t":"1>upon an RRC connection reconfiguration failure, in accordance with clause 5.3.5.8.2; or","paragraph_zero_based":129},{"literal_text_all_w_t_and_m_t":"1>upon detecting radio link failure for the SCG while MCG transmission is suspended, in accordance with clause 5.3.10.3 in NR-DC or in accordance with TS 36.331 [10] clause 5.3.11.3 in NE-DC; or","paragraph_zero_based":130},{"literal_text_all_w_t_and_m_t":"1>upon reconfiguration with sync failure of the SCG while MCG transmission is suspended in accordance with clause 5.3.5.8.3; or","paragraph_zero_based":131},{"literal_text_all_w_t_and_m_t":"1>upon SCG change failure while MCG transmission is suspended in accordance with TS 36.331 [10] clause 5.3.5.7a; or","paragraph_zero_based":132},{"literal_text_all_w_t_and_m_t":"1>upon SCG configuration failure while MCG transmission is suspended in accordance with clause 5.3.5.8.2 in NR-DC or in accordance with TS 36.331 [10] clause 5.3.5.5 in NE-DC; or","paragraph_zero_based":133},{"literal_text_all_w_t_and_m_t":"1>upon integrity check failure indication from SCG lower layers concerning SRB3 while MCG is suspended; or","paragraph_zero_based":134},{"literal_text_all_w_t_and_m_t":"1>upon T316 expiry, in accordance with clause 5.7.3b.5; or","paragraph_zero_based":135},{"literal_text_all_w_t_and_m_t":"1>upon detecting sidelink radio link failure by L2 U2N Remote UE in RRC_CONNECTED, in accordance with clause 5.8.9.3; or","paragraph_zero_based":136},{"literal_text_all_w_t_and_m_t":"1>upon reception of NotificationMessageSidelink including indicationType by L2 U2N Remote UE in RRC_CONNECTED, in accordance with clause 5.8.9.10; or","paragraph_zero_based":137},{"literal_text_all_w_t_and_m_t":"1>upon PC5 unicast link release indicated by upper layer at L2 U2N Remote UE in RRC_CONNECTED while T301 is not running.","paragraph_zero_based":138},{"literal_text_all_w_t_and_m_t":"NOTE 0:It is up to UE implementation whether to initiate the procedure while T346g is running.","paragraph_zero_based":139},{"literal_text_all_w_t_and_m_t":"Upon initiation of the procedure, the UE shall:","paragraph_zero_based":140},{"literal_text_all_w_t_and_m_t":"1>stop timer T310, if running;","paragraph_zero_based":141},{"literal_text_all_w_t_and_m_t":"1>stop timer T312, if running;","paragraph_zero_based":142},{"literal_text_all_w_t_and_m_t":"1>stop timer T304, if running;","paragraph_zero_based":143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"579202af481741cb7bb8161336b86b02431d52d588c77dded6efecb764b57769","original_member_sha256":"b0505b7e6667faeeee211b1942b347757320657484dec9587529cf442d0bad19","paragraph_ElementTree_utf8_XML_sha256":["a49830d0804d3793f1eec564996393636b40c51a7a4877c8197d0272316a7402","4c3bced70a8e42402bca3555394f7f724f55cece7400ff6a997d659b852ea920","d6aa8fcc85fcb3dd709881c3324c84acd8482f5aadfc63670e447a8158c0ba5f","bbbf98b95d7f27c6117b26446d745078756db4a3f91949e9886c902f3057512d","f5a47b7ebdd10d460926c77144c9e45cda62e33d53f9c2d6d4e4b128b115ca15","7d95f62beb6113f2b7244f798c3f2ac7ad0f1682e552d3c74057c5356445328c","e7da0f3a410000c29df11a278dc59d5ecaa40c4d777a722aad73f27402240ab5","ca44802ad125dc7f4b908a6541357f525122b9f7f79353270db9f977fbc06691","e8a7962796a5aab37e1a8baddfae69eb3135fc62a017d59be32d7887747f187d","dc1e0f7cc911db631b95108cd25518813fe26bfdb99301d5494178b1a6d9e19a","58882cfe1ff7766e31613ada2850b9491848d531ea2f169d92e9488c1a75c71d","0c65fefe4b3b3e5f67a78c66b73e693de704a10cadc6f3d6dec5fadd2144177c","d02071b523357d6f89b45327c1d12418b7f109475ac7f64f6aeeab49148146d8","2a24c74785f8b8e17f2c21d448ff0dc508472fbadede77c29d406d87d9c14a67","3f8ea902b156eb0368b4192dbe5e62d3dd00b0e47eb4bbb67413a42ab6c9e6a7","1d00251b70f7497acdb85ae3b1dfaad096dfa7ce2f21a6743111ebdadcd95093","454f827fbd5d6a4c7afb73e27629e95bd765b542bf519b1b964ed58a5a358f97","68e141ff312436c1ec9003aad692299b54a0e43d9181ac2d753e16dc08bf8598","e056f13f2d3392ed9ca655dc4f0a7b1c07b96297107c067da249153605be7582","1a975d7bf21335ace0487449a08158d9b99752e69c18974bd294fcca2cf10b25","e2fce242bc3bd33cabb824327d74105d13663d3bbe59fceed1708235ff67de27","69d663e4745af7e291c631e19631a01b7c1f6f2cff492937b8c2c4dcd632b2ce","db503d472a362bac26b270b9bc0bf6db77f7593ce700abfbb122e51cd43e5219","e2f94ed0a5715698