","cbed5f96b3a32ec36b078b8388be9a12034073c8564e0dd507a0fd9afde78c0c","2e87c0bf36ddf996ab25f48e3e5fc8db438ee8203ab1d1fb2cba3a7e0f7cc1c9","a1e412a0084dce6c93e38c164eb54805dba10ad6eb3afb03fd309cb1d5ed3ac6","223644239dfd3a8466768496ee078295438b0c173b0eea80168bf1ce41e2c55f","458c6b5bfbd49f13b9f38454928d3fcacc22616265f14d71ef6e22aa5fcafb8e","ee42c97d22eb857c1ea2e8455ef954e3c02b010a3f315319b1a0b7719b88501f","9dbc694c866bcf92c586dc39365ca2522d0b5c4b123f523d66ec225da886863b","e01a9b7aa9832b8fd2609650ebdb793e07ffc8c271cee4c5a9c73192e12e258d","851f9e635160cf114ffffc2e852dea0363bd72e189c090861b851a7a8ac3e559","ecbdf5968ccdddce6387db57065972c29596cf83753e5f99a94e0ed382942168","ed4dc5cab7ae4f639bf56a2e09b24fe9880b9121b45b795698dc93f6bef6811d","3bbcae18f9c7e927cf908b6a0fc932dee66d15bd3402ec218c634698a8f299c6","d4a63f74b9493bb93bd34cb54f682986e35838a3fe90786b76bbf77502cd7049","14dc43c6cbf35694cac4c1dd7d4c75c969d52cb240908e371944af97c399de37","5c436797c90ef1d65b435714b1039b25badbb11594ec7ca09440e66a77ed05e8"],"paragraph_range_zero_based":[9624,9647],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p9624"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9648},{"literal_text_all_w_t_and_m_t":"RAN-VisibleMeasurements field descriptions","paragraph_zero_based":9649},{"literal_text_all_w_t_and_m_t":"appLayerBufferLevelList","paragraph_zero_based":9650},{"literal_text_all_w_t_and_m_t":"The field indicates a list of application layer buffer levels, and each AppLayerBufferLevel indicates the application layer buffer level in ms. Value 0 corresponds to 0ms, value 1 corresponds to 10ms, value 2 corresponds to 20 ms and so on. If the buffer level is larger than the maximum value of 30000 (5 minutes), the UE reports 30000.","paragraph_zero_based":9651},{"literal_text_all_w_t_and_m_t":"playoutDelayForMediaStartup","paragraph_zero_based":9652},{"literal_text_all_w_t_and_m_t":"Indicates the application layer playout delay for media start-up in ms. Value 0 corresponds to 0ms, value 1 corresponds to 1ms, value 2 corresponds to 2 ms and so on. If the playout delay for media start-up is larger than the maximum value of 30000ms, the UE reports 30000.","paragraph_zero_based":9653},{"literal_text_all_w_t_and_m_t":"pdu-SessionIdList","paragraph_zero_based":9654},{"literal_text_all_w_t_and_m_t":"Contains the identity of the PDU session, or the identities of the PDU sessions, used for application data flows subject to the RAN visible application layer measurements.","paragraph_zero_based":9655},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9656},{"literal_text_all_w_t_and_m_t":"–MIB","paragraph_zero_based":9657},{"literal_text_all_w_t_and_m_t":"The MIB includes the system information transmitted on BCH.","paragraph_zero_based":9658},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: N/A","paragraph_zero_based":9659},{"literal_text_all_w_t_and_m_t":"RLC-SAP: TM","paragraph_zero_based":9660},{"literal_text_all_w_t_and_m_t":"Logical channel: BCCH","paragraph_zero_based":9661},{"literal_text_all_w_t_and_m_t":"Direction: Network to UE","paragraph_zero_based":9662},{"literal_text_all_w_t_and_m_t":"MIB","paragraph_zero_based":9663},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":9664},{"literal_text_all_w_t_and_m_t":"-- TAG-MIB-START","paragraph_zero_based":9665},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9666},{"literal_text_all_w_t_and_m_t":"MIB ::=                             SEQUENCE {","paragraph_zero_based":9667},{"literal_text_all_w_t_and_m_t":"    systemFrameNumber                   BIT STRING (SIZE (6)),","paragraph_zero_based":9668},{"literal_text_all_w_t_and_m_t":"    subCarrierSpacingCommon             ENUMERATED {scs15or60, scs30or120},","paragraph_zero_based":9669},{"literal_text_all_w_t_and_m_t":"    ssb-SubcarrierOffset                INTEGER (0..15),","paragraph_zero_based":9670},{"literal_text_all_w_t_and_m_t":"    dmrs-TypeA-Position                 ENUMERATED {pos2, pos3},","paragraph_zero_based":9671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["8aedb57bea7f63d656cc2664db9a9492ea42a235460b3e1feb9507fa917a4e8a","2aba0ccc791f090d22617efac0118af3a38829a3f7d370080d45628c862cf021","f1381faa73e8c550bcb674f8cfb360cfc665385a9f953c6b0892ac5385d06f1c","1aea8fd1f24411bd07c86d682672fd7d54a6ca93492f7f9b286053db53f163cb","1a005219afa54956e8cb7ed95f0c81e68018fb7ebec9dd7dc375b26e75d295e7","0e4da5b619b9cec17688f6c134ff1cf35b2a30c383a11a7cb13ad75fab3e9370","17c79555c43cb9509b62edebd7b1cd836570c2ebed51e1e7a719e72d55344f4c","13836748fe0c09c5dda4e491c4fb5ab4774353f333a267deeef792c648913044","da363215eeca872ea1285f57b3fa3b1947924fd160f31d507c762bba58ad92df","6f881713ea970a88a5b154ee655fdbe3126b1bc4587bf8ff824b0dd6ae5e24af","9203f400b235e3778a9c62bfd9a3529f5a730411eb58e9cfccf1a5b7398fb576","9d8d5d588e70530f4856ff0819bd125f78fbd8dc18efc1854830655925d1bc00","f4b8b299b0994988fee1bde42d8a64af8833794c99783a6c97c8de8947fc0093","d8188a88df53c9f9680d67f88980d05da59c5c177d24a13cc0d800cb09e51269","26559253e3bc40a33c87c02b9ba2d39ccb6efcf43313e2d640ea3adfacd1f6eb","9f4c15f1081aba9ec29b3d71c25b851ba4c0334973fffbe4f6b13f6813a8f6f9","b7e1d565f298e0cbdedcb70bb59913ab2e27d943a0ebc589ddfff416115ac14e","e21b9f52c52a0cd7bd8f37ae24435171873842a4eaaf9e6f3cec14c3abb0cd39","86646780559fe0084f340e380c9bb03ca1409aae3f44eac929f8ef2275076f3b","b1cd73ed1a29af7a308cd7e4d951389c498efce60679cea886f83a824be3b41f","64aff7539d6d85811ea1957d4fa5b6e4d73508e2e6c230852033079e18f36d68","b53da6aed3a627f0a01cf6f5724fe9dfec58b4fdf86c6f159bcc9b452808d76f","1f2e05788d5585366d9393f8717e85d1605ae996a002197318ef2888a1d35960","e0d11b0cf63ebb27fcd747f2261c3801bb544aeb636095976bf69cf668522470"],"paragraph_range_zero_based":[9648,9671],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p9648"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    pdcch-ConfigSIB1                    PDCCH-ConfigSIB1,","paragraph_zero_based":9672},{"literal_text_all_w_t_and_m_t":"    cellBarred                          ENUMERATED {barred, notBarred},","paragraph_zero_based":9673},{"literal_text_all_w_t_and_m_t":"    intraFreqReselection                ENUMERATED {allowed, notAllowed},","paragraph_zero_based":9674},{"literal_text_all_w_t_and_m_t":"    spare                               BIT STRING (SIZE (1))","paragraph_zero_based":9675},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":9676},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9677},{"literal_text_all_w_t_and_m_t":"-- TAG-MIB-STOP","paragraph_zero_based":9678},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":9679},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9680},{"literal_text_all_w_t_and_m_t":"MIB field descriptions","paragraph_zero_based":9681},{"literal_text_all_w_t_and_m_t":"cellBarred","paragraph_zero_based":9682},{"literal_text_all_w_t_and_m_t":"Value barred means that the cell is barred, as defined in TS 38.304 [20]. This field is ignored by IAB-MT. This field is ignored for connectivity to NTN.","paragraph_zero_based":9683},{"literal_text_all_w_t_and_m_t":"dmrs-TypeA-Position","paragraph_zero_based":9684},{"literal_text_all_w_t_and_m_t":"Position of (first) DM-RS for downlink (see TS 38.211 [16], clause 7.4.1.1.2) and uplink (see TS 38.211 [16], clause 6.4.1.1.3).","paragraph_zero_based":9685},{"literal_text_all_w_t_and_m_t":"intraFreqReselection","paragraph_zero_based":9686},{"literal_text_all_w_t_and_m_t":"Controls cell selection/reselection to intra-frequency cells when the highest ranked cell is barred, or treated as barred by the UE, as specified in TS 38.304 [20]. This field is ignored by IAB-MT.","paragraph_zero_based":9687},{"literal_text_all_w_t_and_m_t":"pdcch-ConfigSIB1","paragraph_zero_based":9688},{"literal_text_all_w_t_and_m_t":"Determines a common ControlResourceSet (CORESET), a common search space and necessary PDCCH parameters. If the field ssb-SubcarrierOffset indicates that SIB1 is absent, the field pdcch-ConfigSIB1 indicates the frequency positions where the UE may find SS/PBCH block with SIB1 or the frequency range where the network does not provide SS/PBCH block with SIB1 (see TS 38.213 [13], clause 13).","paragraph_zero_based":9689},{"literal_text_all_w_t_and_m_t":"ssb-SubcarrierOffset","paragraph_zero_based":9690},{"literal_text_all_w_t_and_m_t":"Corresponds to kSSB (see TS 38.213 [13]), which is the frequency domain offset between SSB and the overall resource block grid in number of subcarriers. (See TS 38.211 [16], clause 7.4.3.1). For operation with shared spectrum channel access in FR1 (see 37.213 [48]), this field corresponds to kSSB, and kSSB is obtained from kSSB (see TS 38.211 [16], clause 7.4.3.1); the LSB of this field is used also for deriving the QCL relation between SS/PBCH blocks as specified in TS 38.213 [13], clause 4.1.","paragraph_zero_based":9691},{"literal_text_all_w_t_and_m_t":"The value range of this field may be extended by an additional most significant bit encoded within PBCH as specified in TS 38.213 [13].","paragraph_zero_based":9692},{"literal_text_all_w_t_and_m_t":"This field may indicate that this cell does not provide SIB1 and that there is hence no CORESET#0 configured in MIB (see TS 38.213 [13], clause 13). In this case, the field pdcch-ConfigSIB1 may indicate the frequency positions where the UE may (not) find a SS/PBCH with a control resource set and search space for SIB1 (see TS 38.213 [13], clause 13).","paragraph_zero_based":9693},{"literal_text_all_w_t_and_m_t":"subCarrierSpacingCommon","paragraph_zero_based":9694},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing for SIB1, Msg.2/4 and MsgB for initial access, paging and broadcast SI-messages. If the UE acquires this MIB on an FR1 carrier frequency, the value scs15or60 corresponds to 15 kHz and the value scs30or120 corresponds to 30 kHz. If the UE acquires this MIB on an FR2 carrier frequency, the value scs15or60 corresponds to 60 kHz and the value scs30or120 corresponds to 120 kHz. For operation with shared spectrum channel access in FR1 (see 37.213 [48]) and for operation in FR2-2, the subcarrier spacing for SIB1, Msg.2/4 and MsgB for initial access, paging and broadcast SI-messages is same as that for the corresponding SSB. For operation with shared spectrum channel access, this field instead is used for deriving the QCL relation between SS/PBCH blocks as specified in TS 38.213 [13], clause 4.1.","paragraph_zero_based":9695}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["de609582f536bd0095162f3f8d52188f41c09cc96782bb4907a2b6098f379055","ef4663b65a2adf3d4083584bd40768fd1639d12eab92efbfe351914650cc0519","b3134b7a44a874fba2869e965aceeef0c1718b2eda9db5fa4620e90dfe0f0b1e","74223d0052804a0a5477280fd905a620a113c7d28501f145b6a1e8253a780fa2","d5259e3be5bdc55a0432fa8cc7ea06366388187c4561dc1ea95fa33cbb9d2cb1","314622f3a4076bef2180ff07213ea689b22a97d9adc996af957effbd09c8bf75","ccb66bb268b96b34f3964fd23c49b728df53d92a597d9d1b9af90cbccd0fa713","efb93a59a2aad6d949f90585d12709490c50465598e2c9afc0c68c13d9a1b5a7","741c847196ca9fe4ec743a23d1885933614b03b4f50b2ad725076b834088bee3","43f71061b3115c7d37b0ede8965956aebe405859a2afd0e892b28d2618b517e4","572fe03e908d051f0d15c5826a415c3e730f92866a2fe92ce5353c3afe2c12dd","b1ff8ca0bf29bbf7a40bdc6df1d1e740f007b553351ad99704c5a46c56b5a52a","6b6a2791dbbc4335593e5df0fbf923ccdeb41e541b865849b5882b140267ace2","3fbc1ab778f9a9a345aee1e0f5cb2de91a0355ecaccdf3539af72d391dd7aa2b","e4ca4846a6a184fb3ac9283861669d7a28ac4b629e0c8f6b2e1812fa5097b457","4be8232c72ea4a39be1a1eba4f11b306ade9175caf392bb2250c5d4b22848dc6","a1fb5902ed1c54e5e301b950a8348d19cde011a557e87a4f3754a77ee434531e","09cd8197ff5f377b7c617bf3f04be5e9d719d6be832a720630ca7bf372695868","ee44b06198c1b2ccb5051ad2ebf27ec864d30c5260d59027d66e97d012c8a229","baff5ba5eae493ffade494e0f2dc1ecb010c0403f467f494e5186604e97d4995","ca52bcfe744eaef35aff1380d5be6c97109573bb8f385ed4f7a71ac4a368a7ea","1ea19af59758cad00ca94539b1546da4e85b87437f3a579098c7512202a686d5","f517685177aab0a64d8098ffdfc894c03c1dab395526239b968238cc060b944f","b359c0edd03c01bc6c24f851cd130398a355bf0a4d15284385c31d8215513c29"],"paragraph_range_zero_based":[9672,9695],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p9672"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"systemFrameNumber","paragraph_zero_based":9696},{"literal_text_all_w_t_and_m_t":"The 6 most significant bits (MSB) of the 10-bit System Frame Number (SFN). The 4 LSB of the SFN are conveyed in the PBCH transport block as part of channel coding (i.e. outside the MIB encoding), as defined in clause 7.1 in TS 38.212 [17].","paragraph_zero_based":9697},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9698},{"literal_text_all_w_t_and_m_t":"–MobilityFromNRCommand","paragraph_zero_based":9699},{"literal_text_all_w_t_and_m_t":"The MobilityFromNRCommand message is used to command handover from NR to E-UTRA/EPC, E-UTRA/5GC or UTRA-FDD.","paragraph_zero_based":9700},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1","paragraph_zero_based":9701},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":9702},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":9703},{"literal_text_all_w_t_and_m_t":"Direction: Network to UE","paragraph_zero_based":9704},{"literal_text_all_w_t_and_m_t":"MobilityFromNRCommand message","paragraph_zero_based":9705},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":9706},{"literal_text_all_w_t_and_m_t":"-- TAG-MOBILITYFROMNRCOMMAND-START","paragraph_zero_based":9707},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9708},{"literal_text_all_w_t_and_m_t":"MobilityFromNRCommand ::=           SEQUENCE {","paragraph_zero_based":9709},{"literal_text_all_w_t_and_m_t":"    rrc-TransactionIdentifier           RRC-TransactionIdentifier,","paragraph_zero_based":9710},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                  CHOICE {","paragraph_zero_based":9711},{"literal_text_all_w_t_and_m_t":"            mobilityFromNRCommand           MobilityFromNRCommand-IEs,","paragraph_zero_based":9712},{"literal_text_all_w_t_and_m_t":"            criticalExtensionsFuture        SEQUENCE {}","paragraph_zero_based":9713},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":9714},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":9715},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9716},{"literal_text_all_w_t_and_m_t":"MobilityFromNRCommand-IEs ::=       SEQUENCE {","paragraph_zero_based":9717},{"literal_text_all_w_t_and_m_t":"    targetRAT-Type                      ENUMERATED { eutra, utra-fdd-v1610, spare2, spare1, ...},","paragraph_zero_based":9718},{"literal_text_all_w_t_and_m_t":"    targetRAT-MessageContainer          OCTET STRING,","paragraph_zero_based":9719}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["fdd2b62fb98954889baa7b8b4b2cc8b7843d0e4b92306acda62b285976592763","d0dedb0c4aa04b9eea86e1a0212fcf9e509ee9edeb4a8da49faeb1eca103d19e","fb39241043e76183ef83459bdde435c9048d8467141ef6a8424e55c05e6f3e64","9ac03a01661de5e09aac3ce12705aca0a1c8f98736c2a253e5cef961e9eb6b7b","38ae381a3c2674538d118556b764b9cc218b05dd7e378886a508f11d2278eb7d","fa4548b77a42fb4e8ec6b88678ce7ee66cd624310c8a6ca9f424aecedc287fba","99617ea6f89987bc89dd2caf34e7ac2851e67e6fa19787167e501e62647d96b1","c6b2d4fbbff80d7396aaa2ae343c2e7b5a0f50d56e5046fab2a3594c26a2699b","1180273ac287cc7b8aaf00fb18a282666fd820d46c171d4bdd4a4c1fff996e99","a2aebc5a7aa2522fdef998a50bba154006cd0b5aa8a32c4f3c811ff07e3614ff","a965282f6eebf64b830e53ce184b7e116bd9ec86b0adce1f5ba809a6b00168d6","60a2d4048fa4217080d859f65e25f57559cd3e09bf0857d3ac81baaa99a150c3","e7214049790d2fce646a93a15598835cc7288d45550d6a7ee6fee4d77b448547","00dd36886b0994594f64a08ab69fe