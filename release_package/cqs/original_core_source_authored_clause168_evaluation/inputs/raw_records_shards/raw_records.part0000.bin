{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19344},{"literal_text_all_w_t_and_m_t":"–MeasConfig","paragraph_zero_based":19345},{"literal_text_all_w_t_and_m_t":"The IE MeasConfig specifies measurements to be performed by the UE, and covers intra-frequency, inter-frequency and inter-RAT mobility as well as configuration of measurement gaps.","paragraph_zero_based":19346},{"literal_text_all_w_t_and_m_t":"MeasConfig information element","paragraph_zero_based":19347},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":19348},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASCONFIG-START","paragraph_zero_based":19349},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19350},{"literal_text_all_w_t_and_m_t":"MeasConfig ::=                      SEQUENCE {","paragraph_zero_based":19351},{"literal_text_all_w_t_and_m_t":"    measObjectToRemoveList              MeasObjectToRemoveList                                              OPTIONAL,   -- Need N","paragraph_zero_based":19352},{"literal_text_all_w_t_and_m_t":"    measObjectToAddModList              MeasObjectToAddModList                                              OPTIONAL,   -- Need N","paragraph_zero_based":19353},{"literal_text_all_w_t_and_m_t":"    reportConfigToRemoveList            ReportConfigToRemoveList                                            OPTIONAL,   -- Need N","paragraph_zero_based":19354},{"literal_text_all_w_t_and_m_t":"    reportConfigToAddModList            ReportConfigToAddModList                                            OPTIONAL,   -- Need N","paragraph_zero_based":19355},{"literal_text_all_w_t_and_m_t":"    measIdToRemoveList                  MeasIdToRemoveList                                                  OPTIONAL,   -- Need N","paragraph_zero_based":19356},{"literal_text_all_w_t_and_m_t":"    measIdToAddModList                  MeasIdToAddModList                                                  OPTIONAL,   -- Need N","paragraph_zero_based":19357},{"literal_text_all_w_t_and_m_t":"    s-MeasureConfig                     CHOICE {","paragraph_zero_based":19358},{"literal_text_all_w_t_and_m_t":"        ssb-RSRP                            RSRP-Range,","paragraph_zero_based":19359},{"literal_text_all_w_t_and_m_t":"        csi-RSRP                            RSRP-Range","paragraph_zero_based":19360},{"literal_text_all_w_t_and_m_t":"    }                                                                                                       OPTIONAL,   -- Need M","paragraph_zero_based":19361},{"literal_text_all_w_t_and_m_t":"    quantityConfig                      QuantityConfig                                                      OPTIONAL,   -- Need M","paragraph_zero_based":19362},{"literal_text_all_w_t_and_m_t":"    measGapConfig                       MeasGapConfig                                                       OPTIONAL,   -- Need M","paragraph_zero_based":19363},{"literal_text_all_w_t_and_m_t":"    measGapSharingConfig                MeasGapSharingConfig                                                OPTIONAL,   -- Need M","paragraph_zero_based":19364},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":19365},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":19366},{"literal_text_all_w_t_and_m_t":"    interFrequencyConfig-NoGap-r16      ENUMERATED {true}                                                   OPTIONAL    -- Need R","paragraph_zero_based":19367}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["e17b6f98e6ebbdec8