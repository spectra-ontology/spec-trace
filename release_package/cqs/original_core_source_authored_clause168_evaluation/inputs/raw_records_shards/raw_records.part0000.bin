t_XML_sha256":"bfa8f542c0e3785a3c515c87ef2946d7c13a696829509410eb2d1e44b96d7c84","original_member_sha256":"d255eefa640f12daa70d88c45e2ac0c744cd0bb42e80e880ce71f15b3086c419","paragraph_ElementTree_utf8_XML_sha256":["0e19b81f87d3bdc2ef8b647396cef0b654a0980685f47da385dbf025b72d6b3a","a9c53bdfdd39f8e6ca97cd76d19167c48157f0677c11978d12e4c36116d72d0a","5344855e0fe3fa7f07b6e9f317481cc9b7dfd6f4dd34d3babe988ed5122da228","a2f6639e81b0b309dc2818dc9d799155d7eacc71f419342dc03b98db169b2da1","0fbc15aca88709f6e0bf1a4ad3b9408ba17eba977f695f93b785cfcbd249c3c5","e0d334f23360a49063cb320b71d49e2def0fe9a5e62366582f2ae3c702804472","e9bb87084260d960fe8bd9766a936465efd063900f4c24da12cdccbb087e37cf","37af868d797143f2f4c78d0430a28d61e696204a98d6d30cc71e31b834542543","f0c962faa7eb7da162ce4cc0907bfe475042520891e2dbb21a8ee1ffdab2d682","7e85ce478e209d0d2c158e5a9941ab2af0d3f96791ae3375ba35acfb2035094a","ffbb247ee065aee728a9425d0566548b22fb77f21ba1ee91c1bbdf65a25d33d9","83c7c63b7e064386d69c2724cd6cf1b784e8809b9a5f5530e0cb97c705f27633","08eed9f3d3c0d7b5ad9be1268595ad2385e4e52065f3b7cf1b63e31e7a945772","5088cc15e2280550796b212be9e2cb84ba7be08e5e8ef8357a7987518a9b92db","ccf3e542702790e906a6e62672ded541e15cf1844698454a407440a6d9bd3bf9","15c688de34899defee20bf40d5bf07ec6e66c5369a7f00a115b509170ca43ab4","e127f5f36047df71a523d9fc7438651c56df8ee54afb27eb5796b70c202318b0","73e61e81b73c1707d43cde5a184477ca2042f4c4701ef35e50c63924c61e4f29","49069048e641b79dbced68ded3190a3fb952b6c2769342d89bbcfc02dc29b02c","e5a540b784baac4e7e88e4749d98f4312b0928d04870520da544cce2e21619f3","21ea53af5e30e1a51c6a7fe6e9dd847a61d9bcf9c59f9904a4279e085aa137a3","d11228f01d099ef8a23678e33ee8d6112c3b487062935fbef0a8f2520ceba344","408d42fb52d6847a90ce6eaf454357ce6d0a5e4a2e16ff35598e3a848601dbb6","624a8ffe8c34a78ad400e3d3f36639a710f524d4fa450dfab6b8b247bc5da3e1"],"paragraph_range_zero_based":[96,119],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2303212.zip::R2-2303212 Correction on PSFCH reception for NR sidelink.docx:p96"}
{"fields":{"filename":"R2-2303212.zip::R2-2303212 Correction on PSFCH reception for NR sidelink.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"START OF CHANGE","paragraph_zero_based":120},{"literal_text_all_w_t_and_m_t":"5.22.1.3.2PSFCH reception","paragraph_zero_based":121},{"literal_text_all_w_t_and_m_t":"The MAC entity shall for each PSSCH transmission:","paragraph_zero_based":122},{"literal_text_all_w_t_and_m_t":"1>if an acknowledgement corresponding to the PSSCH transmission in clause 5.22.1.3.1a is obtained from the physical layer:","paragraph_zero_based":123},{"literal_text_all_w_t_and_m_t":"2>deliver the acknowledgement to the corresponding Sidelink HARQ entity for the Sidelink process;","paragraph_zero_based":124},{"literal_text_all_w_t_and_m_t":"else:","paragraph_zero_based":125},{"literal_text_all_w_t_and_m_t":"2>if negative-only acknowledgement was enabled in the SCI:","paragraph_zero_based":126},{"literal_text_all_w_t_and_m_t":"3>deliver a positive acknowledgement to the corresponding Sidelink HARQ entity for the Sidelink process;","paragraph_zero_based":127},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":128},{"literal_text_all_w_t_and_m_t":"3>deliver a negative acknowledgement to the corresponding Sidelink HARQ entity for the Sidelink process;","paragraph_zero_based":129},{"literal_text_all_w_t_and_m_t":"1>if the PSSCH transmission occurs for a pair of Source Layer-2 ID and Destination Layer-2 ID corresponding to a PC5-RRC connection which has been established by upper layers:","paragraph_zero_based":130},{"literal_text_all_w_t_and_m_t":"2>perform the HARQ-Based Sidelink RLF Detection procedure as specified in clause 5.22.1.3.3.","paragraph_zero_based":131},{"literal_text_all_w_t_and_m_t":"If sl-PUCCH-Config is configured by RRC, the MAC entity shall for a PUCCH transmission occasion:","paragraph_zero_based":132},{"literal_text_all_w_t_and_m_t":"1>if the timeAlignmentTimer, associated with the TAG containing the Serving Cell on which the HARQ feedback is to be transmitted, is stopped or expired:","paragraph_zero_based":133},{"literal_text_all_w_t_and_m_t":"2>not instruct the physical layer to generate acknowledgement(s) of the data in this TB.","paragraph_zero_based":134},{"literal_text_all_w_t_and_m_t":"1>else if a MAC PDU has been obtained for a sidelink grant associated to the PUCCH transmission occasion in clause 5.22.1.3.1, the MAC entity shall:","paragraph_zero_based":135},{"literal_text_all_w_t_and_m_t":"2>if the most recent transmission of the MAC PDU was not prioritized as specified in clause 5.22.1.3.1a:","paragraph_zero_based":136},{"literal_text_all_w_t_and_m_t":"3>instruct the physical layer to signal a negative acknowledgement on the PUCCH according to clause 16.5 of TS 38.213 [6].","paragraph_zero_based":137},{"literal_text_all_w_t_and_m_t":"2>else if HARQ feedback has been disabled for the MAC PDU and next retransmission(s) of the MAC PDU is not required; or","paragraph_zero_based":138},{"literal_text_all_w_t_and_m_t":"2>else if all PSCCH duration(s) and PSSCH duration(s) for initial transmission of a MAC PDU of the dynamic sidelink grant or the configured sidelink grant is not in SL DRX Active time as specified in clause 5.28.3 of any destination that has data to be sent:","paragraph_zero_based":139},{"literal_text_all_w_t_and_m_t":"3>instruct the physical layer to signal a positive acknowledgement corresponding to the transmission on the PUCCH according to clause 16.5 of TS 38.213 [6].","paragraph_zero_based":140},{"literal_text_all_w_t_and_m_t":"2>else if HARQ feedback has been disabled for the MAC PDU, and no sidelink grant is available for next retransmission(s) of the MAC PDU (including immediately after all PSSCH duration(s) in an sl-PeriodCG for the sidelink grant, the number of transmissions of the MAC PDU has not reached sl-MaxTransNum corresponding to the highest priority of the logical channel(s) in the MAC PDU, if configured in sl-CG-MaxTransNumList for the sidelink grant by RRC), if any; or","paragraph_zero_based":141},{"literal_text_all_w_t_and_m_t":"2>else if PSCCH duration(s) and PSSCH duration(s) for one or more retransmissions of a MAC PDU of the dynamic sidelink grant or the configured sidelink grant is not in SL DRX Active time as specified in clause 5.28.3 of the destination that has data to be sent:","paragraph_zero_based":142},{"literal_text_all_w_t_and_m_t":"3>instruct the physical layer to signal a negative acknowledgement corresponding to the transmission on the PUCCH according to clause 16.5 of TS 38.213 [6].","paragraph_zero_based":143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bfa8f542c0e3785a3c515c87ef2946d7c13a696829509410eb2d1e44b96d7c84","original_member_sha256":"d255eefa640f12daa70d88c45e2ac0c744cd0bb42e80e880ce71f15b3086c419","paragraph_ElementTree_utf8_XML_sha256":["bea1013bbf9b5e6e904fcf3282039a7ff2b535d2f5d7db7bc345fc8e99b0b76a","f891268d1ab6552b477ffafc4f2a364614ef829b9ff868a5ce5f7078f8e77691","db60d0e9698cbcc61b7ffc8dc60be211b22d7f179d067dc13b60840bfeaa4fdf","c725ec90ab5ce9d4e5acd79aea3799093c4ecd0904497ea30af754e4a349c89c","c10a3fc65609ac32764190a3538cb3f6435639167405c60924fa0c532b27f927","b993fb9cbdb2d16369e6d2b20e8df9c0741b1caf88d7611d712e06317dad9f9a","fd4e6e7db0aa95c74c0987ac1f9963db7905e6b07e2d39b93806b89d83ef6554","3aacd98afaa0b3e7fbb0d0fee4c2203c7eda7571ef1577e74e2bcc6cdaf50da9","ce60d6fd57629661c91c05e732b503eb6f6de19710a01f8ae0d46e825ee85975","51044b8b2eb43c6b2679e8353afed8536ad01bf765ac90f1eeb837d7af6c4b83","54dd491157d18f54e47ce3ecfc32fea1d322b556cee4a9bab62fe83e657e896d","530bfdd9f02c029ae7e199848ad4fe9cc669b18523dbc1259ef2856152946bb6","c4b63236e20539f8ff70b29204111cd192d80fed4531236374c74d85c5d9107c","1f3b8a70b11653ed2d0596bd123dff5cfe1c7acbf2212281791bf90c798ed313","0c440beb9451d77d4fd24803925b358e43b4c87a3f405160af48ff95c62bc86b","d844cee5311ece5eecc6aba83db6e5a27020cda7f80bbc279f40b357fe6d1e0f","5dd9c394b15227046df8789718eb3a0c060b907136ffa48e0e06203e359f5747","8dc53c530400dec98d03632a8b5447e688a2d6ca03f553f40bcf2978e6597105","a07d7b1875d12660a55f3bbaf51ab243086e85ecf19341d76ac6a7bde7c0b6b4","c65c71344dfad0348b26ec919cab8bf5fcad0c2bca4bb2ac75f86766bd92a0f0","94d1fb8c2307a95fd54fe601178af6995db6ef3c281d4f15e771710eb29f9c4e","17b69d7213fc02e0fd9e7525333bff303e1f06e7550fcdc9a28403d2f9610193","570d63e0ee2580fea29a7bd1c2c8bde6e4aa64fa7f7d24ba755e217638552e67","0eef435d0ab383926b50c857aa6c9d216076a580d3d9d11771969100cddc769c"],"paragraph_range_zero_based":[120,143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2303212.zip::R2-2303212 Correction on PSFCH reception for NR sidelink.docx:p120"}
