{"fields":{"filename":"R2-2306115.zip::R2-2306115_Corrections on L2 U2N Relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":96},{"literal_text_all_w_t_and_m_t":"If the UE is implemented according to this CR but the network is not, there is no inter-operability issue foreseen.","paragraph_zero_based":97},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":98},{"literal_text_all_w_t_and_m_t":"If the network is implemented according to this CR but the UE is not, there is no inter-operability issue foreseen.","paragraph_zero_based":99},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":100},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":101},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":102},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":103},{"literal_text_all_w_t_and_m_t":"Minor non-controversial errors will remain in specification, leading to risk of misunderstanding.","paragraph_zero_based":104},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":105},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":106},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":107},{"literal_text_all_w_t_and_m_t":"5.8.9.3, 5.8.3.2, 5.8.6.1","paragraph_zero_based":108},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":109},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":110},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":111},{"literal_text_all_w_t_and_m_t":"Y","paragraph_zero_based":112},{"literal_text_all_w_t_and_m_t":"N","paragraph_zero_based":113},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":114},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":115},{"literal_text_all_w_t_and_m_t":"Other specs","paragraph_zero_based":116},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":117},{"literal_text_all_w_t_and_m_t":"X","paragraph_zero_based":118},{"literal_text_all_w_t_and_m_t":" Other core specifications","paragraph_zero_based":119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"c1ed42b119e148cbb57fcea39491d4da5b78930bc8a6166f3f3e3aba27e25a2c","original_member_sha256":"f3afebf4757d0143b195626e6dcb6201bb479e0a62fc2aa634fb9db81c094386","paragraph_ElementTree_utf8_XML_sha256":["651defafd48507b36d60c1f091f49bb0bcbd94f9d994fe0c4016e1a25422a64a","28f73a5b19c47e568fee93ca3490cb4777b87824514884ccc042f8fa830373ec","bea045c49d7684aa755845f539e231031c4bafe57937fa263f076aa8e94b5332","0191f52fb9269329a1510ac54dcc146ece2019b69c803b79360dda071390a65a","17ccd2da14e7edff5e864742b5e52411a303cec6b35d4f51f11bd5264e9180e7","5df30c3d5952182f7a805977c5f6c8f80e82c54784deb0908975e4561765b002","dc98ca55ea09f2316abff47dec3d674b93188856f8c5e5c55882fea63b819fbd","dab719b0bcf21289390c9dfefd8d8724a52a9a3f05440563b5e43a52734d19cc","15021805bbdb960d291856853a6d7b40164e1033017f8f1436e54d247861a0fd","8864e17d9a6fb0508f4749ae1665a93cf3e5076cf2c17c47f314529c7ffaf3c2","3e48d26ca9b9b7542285e126d1e8c23fa538b732ed0c171ee888ad2069fbd145","8c0d203660a89d4ac585b5b62825d0538f7d329cc4de37a7f34fe717af6a3511","2eef82097b47347d893473f760a312d890bf5f0e7139ef168f8d93c0d3f79239","929193b223ddffd419f5137fbc65e083bbc3ea121b011438d68fc9e823675c83","00d0e0be326330e8c8917ff01ef4e09a885d61d05b7a2954b87a5f830f2e52d3","0febd30dcea930b21a637f1284e08f810aa6117fac746d3725f7157332f8b861","2c48cb22b915ae496d21bc02f7f1fd3e8ed771e2ec956e756d43a53a71e8d4f5","e697dc6d45a055fb219d38aa2625742162292058f0b1ffc4dc2abf4ba6ce2e38","30a7a2cb4665b90180a963d374a834f4536d3f4414adae3f1b4f55e696d35697","e2be052f0f3c2762f7bfcbd82a011f437655c0e15391a3205af90f8334ec4f9e","906564c3450a18f92accb8c6c49921bbd66a443475f47b27ca75f3ccd0539110","ce7a989c7f143f8a5a3b69bacf403ee4d4638a33a85aa050ef03ad98676ebb25","8accf6da787e3005cd08c9c244a5560e1569cb4220fd3d4145d