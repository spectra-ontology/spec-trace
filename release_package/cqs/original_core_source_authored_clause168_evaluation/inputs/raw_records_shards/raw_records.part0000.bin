{"fields":{"filename":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"If the target device is supporting multiple Galileo signals, the location server includes both F/Nav and I/Nav clock models in gnss-ClockModel if the location server assumes the target device to perform location information calculation using multiple signals.","paragraph_zero_based":1032},{"literal_text_all_w_t_and_m_t":"stanClockToc","paragraph_zero_based":1033},{"literal_text_all_w_t_and_m_t":"Parameter toc defined in [8].","paragraph_zero_based":1034},{"literal_text_all_w_t_and_m_t":"Scale factor 60 seconds.","paragraph_zero_based":1035},{"literal_text_all_w_t_and_m_t":"stanClockAF2","paragraph_zero_based":1036},{"literal_text_all_w_t_and_m_t":"Parameter af2 defined in [8].","paragraph_zero_based":1037},{"literal_text_all_w_t_and_m_t":"Scale factor 2-59 seconds/second2.","paragraph_zero_based":1038},{"literal_text_all_w_t_and_m_t":"stanClockAF1","paragraph_zero_based":1039},{"literal_text_all_w_t_and_m_t":"Parameter af1 defined in [8].","paragraph_zero_based":1040},{"literal_text_all_w_t_and_m_t":"Scale factor 2-46 seconds/second.","paragraph_zero_based":1041},{"literal_text_all_w_t_and_m_t":"stanClockAF0","paragraph_zero_based":1042},{"literal_text_all_w_t_and_m_t":"Parameter af0 defined in [8].","paragraph_zero_based":1043},{"literal_text_all_w_t_and_m_t":"Scale factor 2-34 seconds.","paragraph_zero_based":1044},{"literal_text_all_w_t_and_m_t":"stanClockTgd","paragraph_zero_based":1045},{"literal_text_all_w_t_and_m_t":"Parameter TGD, Broadcast Group Delay (BGD), defined in [8].","paragraph_zero_based":1046},{"literal_text_all_w_t_and_m_t":"Scale factor 2-32 seconds.","paragraph_zero_based":1047},{"literal_text_all_w_t_and_m_t":"This field is required if the target device supports only single frequency Galileo signal.","paragraph_zero_based":1048},{"literal_text_all_w_t_and_m_t":"sisa","paragraph_zero_based":1049},{"literal_text_all_w_t_and_m_t":"Signal-In-Space Accuracy (SISA), defined in [8] clause 5.1.11.","paragraph_zero_based":1050},{"literal_text_all_w_t_and_m_t":"stanModelID","paragraph_zero_based":1051},{"literal_text_all_w_t_and_m_t":"This field specifies the identity of the clock model according to the table Value of stanModelID to Identity relation below. This field is required if the location server includes both F/Nav and I/Nav Galileo clock models in gnss-ClockModel.","paragraph_zero_based":1052},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1053},{"literal_text_all_w_t_and_m_t":"Value of stanModelID to Identity relation","paragraph_zero_based":1054},{"literal_text_all_w_t_and_m_t":"Value of stanModelID","paragraph_zero_based":1055}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["3298fff3d3f0f93307fba2ed264a2fb9c33610f8691c2339cd3dd5310e6091a8","8342c6eff0f46a61097a387de8a2206bf7b98380e1cf6d461c64513d080782b4","9812098cf4763737da62e7aca821d03fb18efaa62f92528f051d66f5a2d5a9cf","ed505f98231e020c3a7465f6d131823af1bd062932975df0540db8d85f8c18ac","c860b3c9c6dec01ae5c3daa8b6a63e513af7bd755c217e6d8e1bc735f417fef9","3406d77526b026e15a25effc57e9ff526089a44876cd6f608210fa527e937ea6","d8d17ac329643fc955f6d93e112c6152706e236b1feb8be1708201855f2d1e38","3ab187749c48f360a0cb5aae2002d02d999ff6299e5aafd981187c15c6698a90","4aedc09774e557badbca902caf2262556293f08682aa6d653e629d4635851700","66cd67f06b29b76a2de392cda5105ea0cadad42f576751f1968febce85b28f9b","3278926a8c817cea4d0faabe8c4549c5f91763ad983d3f1cff54b16d19fcaa39","76fa83a073fcc8dcfa228f0faf91db0e636d46514d4184445fd3bc8fee82f1b3","85922265b7db13fa6cf6dffbd92bbe938594ef190a4ebc2270eceae3d1a86837","8fffbf70e544152d0800292739f1033981d995000f8efc1a6cf3b7f4e6baa162","d245ebe6b956b37ff8bd11f080321c5a462b5de5ee43675b49d7e2b73b91f6a1","59af27998f32e626b0ec5cded9bdff569fcb736e0d001926fd553198285d1e05","f81434c45a6828339552bf37e62d4042cbcb3d751a91504b22995fe8defc6896","e4b7a332351c54a361a40955cfd86ba2188f4540d67edc4fb47853cd17981ee4","49d80424da48e3ca5729dd9f9b2ac12a1ffc4fafd1b385dea92861c9ea547816","38e666bb31bc990a5642c7158a7df7237c9a4ac07026967983b76e73e7a506d6","cf750fd84dd559334c44604cc970304696d43b51e04d9379529b8dbad2c5cb44","35300e68c851ba782836a9f039e5e8593b823cdb025197da20bd8e583e5240e7","8cbb9a11c7b2607d8e758c80fdabd41a42b0977ab7fb9a3448a42988efb131f1","51193d8dc8ded5f42dfe8666a552ecaeab834a3e1fc3e2103bd610459152dd67"],"paragraph_range_zero_based":[1032,1055],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx:p1032"}
{"fields":{"filename":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Identity","paragraph_zero_based":1056},{"literal_text_all_w_t_and_m_t":"0","paragraph_zero_based":1057},{"literal_text_all_w_t_and_m_t":"I/Nav (E1,E5b)","paragraph_zero_based":1058},{"literal_text_all_w_t_and_m_t":"1","paragraph_zero_based":1059},{"literal_text_all_w_t_and_m_t":"F/Nav (E1,E5a)","paragraph_zero_based":1060},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1061},{"literal_text_all_w_t_and_m_t":"[…]","paragraph_zero_based":1062},{"literal_text_all_w_t_and_m_t":"–GNSS-RealTimeIntegrity","paragraph_zero_based":1063},{"literal_text_all_w_t_and_m_t":"The IE GNSS-RealTimeIntegrity is used by the location server to provide parameters that describe the real-time status of the GNSS constellations. GNSS-RealTimeIntegrity data communicates the health of the GNSS signals to the mobile in realtime.","paragraph_zero_based":1064},{"literal_text_all_w_t_and_m_t":"The location server always transmits the GNSS-RealTimeIntegrity with the current list of unhealthy signals (i.e., not only for signals/SVs currently visible at the reference location), for any GNSS positioning attempt and whenever GNSS assistance data are sent. If the number of bad signals is zero, then the GNSS-RealTimeIntegrity IE is omitted.","paragraph_zero_based":1065},{"literal_text_all_w_t_and_m_t":"NOTE 1:If GNSS integrity assistance data are provided (i.e., any of GNSS-Integrity-ServiceParameters, GNSS-Integrity-ServiceAlert, ORBIT-IntegrityParameters, SSR-IntegrityOrbitBounds, CLOCK-IntegrityParameters, SSR-IntegrityClockBounds, SSR-IntegrityCodeBiasBounds, SSR-IntegrityPhaseBiasBounds, STEC-IntegrityParameters, STEC-IntegrityErrorBounds, SSR-GriddedCorrectionIntegrityParameters, TropoDelayIntegrityErrorBounds) the following interpretation of the IE GNSS-RealTimeIntegrity applies:","paragraph_zero_based":1066},{"literal_text_all_w_t_and_m_t":"-Absence of the IE GNSS-RealTimeIntegrity indicates DNU=FALSE according to the Integrity Principle of Operation specified in clause 8.1.1a of TS 38.305 [40] for all GNSS satellites for which integrity assistance data are provided.","paragraph_zero_based":1067},{"literal_text_all_w_t_and_m_t":"-Presence of the IE GNSS-RealTimeIntegrity for a GNSS satellite and signal combination indicates DNU=TRUE for this GNSS satellite and signal combination according to the Integrity Principle of Operation specified in clause 8.1.1a of TS 38.305 [40].","paragraph_zero_based":1068},{"literal_text_all_w_t_and_m_t":"NOTE 2:The UE assumes that only those satellites for which the GNSS integrity assistance data are provided are monitored by the network and can be used for integrity related applications.","paragraph_zero_based":1069},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1070},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":1071},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1072},{"literal_text_all_w_t_and_m_t":"GNSS-RealTimeIntegrity ::= SEQUENCE {","paragraph_zero_based":1073},{"literal_text_all_w_t_and_m_t":"gnss-BadSignalListGNSS-BadSignalList,","paragraph_zero_based":1074},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":1075},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":1076},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1077},{"literal_text_all_w_t_and_m_t":"GNSS-BadSignalList ::= SEQUENCE (SIZE(1..64)) OF BadSignalElement","paragraph_zero_based":1078},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1079}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["c1ee8ddd5f8e175848144408a41f3cd95f271ea3f5e203686d2cbb32a0de9d7b","81a495d9fc75fb175b98f4bfbde4c8ba5435864b968eca52e79a05cee420e305","5b0a87dee4e5b7cd6111ded39bfa096c65dfb07394423efbc0575fb206cd7319","e81c15d2e0ec3c4b5b00ba84919cf252f0e254593167284a33cb5d628fa2171f","a54cf65cdf05c6503c3d6e1f4a351c17f1bd921f65ccc790427278e088bf8acc","4d39f1fc2d0fc67510ca675a9cb1da5fcbc0b750304664f3b5b10ab1098746be","69aff350f7b2126d8a542931b5d96797096315f130b6f5cb86a5d9bd3185a456","f153ac603fbb6e9cc53e493a2152eab8a0dd8e9f6689c03287418a974e7205ab","f30ff3ef091ef2df7575af945ddb7ce60ee8cb7f4430b360960f7ba31cd1a562","ad8c4ed8c96e4d0bf9415bd4de2c1c457aadde7c4aedb15edb90b13bc270317b","ac65c1fa733db7efb2c70484cc8b331f22c860a339d24cbb0de0a5a2e1c59e8d","1b309e122010d3afe68c3b404d2eba4b503ab8a2047126918d3d4d79db783bd0","433b83e56fc1955a019b77cd69358b403ede9aa7e62cfe17b1e569131534f40e","f9bc228c601b603d68822f0d51b76d2b91b61ea45767afe9ef9845cb4b2f50a6","e8e0884a14f5bbfb833e2c746ec97a4c6e325af2313dbfbcc4fe871b99c0d833","9414eab64cdb4dfc786f9e4f6faf5fcaf5742cc8389ade0adf35d1fb018d444e","29213ca859fea9e1c600043613e200bcb783072cfcb38f83ed7f28a4d337b301","3b7c172243ce8220ce5a468097e7c29567c31453f30d42f056168c4ea5542818","03a2b4fad8e1c21c41c0f1badd327f4af0b5efbf81dc08c4abee30dd486b856f","c36b1b79f9d3613015c26459d69fe1d99e079d59271cb4351fbbca5785bdb2df","3400106d5ca6fef767dec05717ec5e574439b6182f45ee364ff937aa99a28fc2","0b39de2e8d736c14bfe017e2b3fcbb647fe0f886ed8e7335d52271e9cddbb890","459cbd295751c3d5aa361a17d71f10a5a05fba4d10e778c9165893964a666eb9","75cd94ab7d22f7da4a089e606915c00dd24b25a2b9c04766cf8199e29dd905fb"],"paragraph_range_zero_based":[1056,1079],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx:p1056"}
{"fields":{"filename":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"BadSignalElement ::= SEQUENCE {","paragraph_zero_based":1080},{"literal_text_all_w_t_and_m_t":"badSVIDSV-ID,","paragraph_zero_based":1081},{"literal_text_all_w_t_and_m_t":"badSignalIDGNSS-SignalIDsOPTIONAL,-- Need OP","paragraph_zero_based":1082},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":1083},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":1084},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1085},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":1086},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1087},{"literal_text_all_w_t_and_m_t":"GNSS-RealTimeIntegrity field descriptions","paragraph_zero_based":1088},{"literal_text_all_w_t_and_m_t":"gnss-BadSignalList","paragraph_zero_based":1089},{"literal_text_all_w_t_and_m_t":"This field specifies a list of satellites with bad signal or signals. ","paragraph_zero_based":1090},{"literal_text_all_w_t_and_m_t":"badSVID","paragraph_zero_based":1091},{"literal_text_all_w_t_and_m_t":"This field specifies the GNSS SVID of the satellite with bad signal or signals.","paragraph_zero_based":1092},{"literal_text_all_w_t_and_m_t":"badSignalID","paragraph_zero_based":1093},{"literal_text_all_w_t_and_m_t":"This field identifies the bad signal or signals of a satellite. This is represented by a bit string in GNSS-SignalIDs, with a onevalue at a bit position means the particular GNSS signal type of the SV is unhealthy; a zerovalue means healthy. Absence of this field means that all signals on the specific SV are bad. ","paragraph_zero_based":1094},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1095},{"literal_text_all_w_t_and_m_t":"[…]","paragraph_zero_based":1096},{"literal_text_all_w_t_and_m_t":"–GNSS-AcquisitionAssistance","paragraph_zero_based":1097},{"literal_text_all_w_t_and_m_t":"The IE GNSS-AcquisitionAssistance is used by the location server to provide parameters that enable fast acquisition of the GNSS signals. Essentially, these parameters describe the range and derivatives from respective satellites to the reference location at the reference time GNSS-SystemTime provided in IE GNSS-ReferenceTime.","paragraph_zero_based":1098},{"literal_text_all_w_t_and_m_t":"Whenever GNSS-AcquisitionAssistance is provided by the location server, the IE GNSS-ReferenceTime is provided as well. E.g., even if the target device request for assistance data includes only a request for GNSS-AcquisitionAssistance, the location server also provides the corresponding IE GNSS-ReferenceTime.","paragraph_zero_based":1099},{"literal_text_all_w_t_and_m_t":"Figure 6.5.2.2-1 illustrates the relation between some of the fields, using GPS TOW as exemplary reference.","paragraph_zero_based":1100},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":1101},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1102},{"literal_text_all_w_t_and_m_t":"GNSS-AcquisitionAssistance ::= SEQUENCE {","paragraph_zero_based":1103}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["9f6983db40bb5b335ad1e1556cb8bd8adaf8cb0a4613556f8e44d1bd6e65e8c5","56d0e639d73f06b4cfd92743453eae71c063014bc398906e8c79b2a807e9f222","d9b9e19f273b79dd8359d58095b643f3243f88d57c312b39aff05ba92aba38c9","e19708ce90b6b10f3bb7b55348385081a826c949996907b5fa6600f730be9c77","d84851a16811ae21df6950164071d24ba7dee47512836cc4bbf44e57c853171b","028975baaa4ba7eb08857ee819bd70d1a72e27fc7bd94504c2a2ad08a4e56c80","5c95a6830ca3cc11d304cb1b5b9a976e28b11d0fa6e7616a4d01b34fbf3814d9","5afa020bb77b83e50da34f2d1b3a919f512ae49b6617ad9d7ad405b7641e28a0","95702cc8e7e9c072d6e88642bc2881de6be4f65b22cfa391348d848d5e885026","1907159622abca62bf9f8c2e93e9bb50de4a9a2db775ac7583101fe1a18e50d8","e6af90547535d57736583859190f89de06e3515acae5ae1ce8f6cac2b81e2890","1fde22baf93847bead966ddb8e65f303d33595e7da58310d18c436eeab9050bc","f83fb62a3075fc8299f624f388c1a6bcef35e3a13eea30e946d66a1b5fde5151","6ed2de4144f63d177594693ca0c9d6c7e51e0ef18d5e4de0f9425cefcb9641cc","91c5bd51cc7ace97e4073d493bc0d6fec7553e312769ab77ace6acd044ec66ee","55bb2bd6b7326efbf79760ab0453572b4d6b1516dee5e2f0845507227b9bb92a","773bf53953e76dd44a0c99deb1bcaed19575d1c034dd20d7615c5de1a9affb0e","51642bcf1e1af18d6c97bf881f7924749b1e8847454d206bcebc2e7acacee7e3","31d58b4b922ec5a60e9a87c1dc254b860cf665afbe9631bff6b3487584baaad2","ff59d6aee00caec537345469eb06ad3490c95dee6cd474518c51af0f22359ec2","3e6947195cfab141bfd3b26531ae2aa1e8ffde2cf198ae62d47c7c982ca215d2","3ed8168dc30664f92983c5beb2b8fdf2179f528a36b17ab4957a6f5891eb2dc1","dc316e80366c9fbc71010cff99fdf2646f99260bf26be5004c4f7382dc4e170f","39b319b2a62762c36076fa5269961e0bcfca676b7a4cda525c752ff7b19fec96"],"paragraph_range_zero_based":[1080,1103],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx:p1080"}
