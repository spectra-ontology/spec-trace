IZE (10)),","paragraph_zero_based":1365},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":1366},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":1367}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["ee6fe954dee0ea9e5f031943d36db51a594db0811281af2627910027e1fa49cb","b3331d6254c3c07e5ff4db6600d5ff95f21d29dc8e33c470ccd88315c564f844","3a0fff5300e4867cb7ebe4cffc70ae8132d1aa386c75309b04a79afb92367b9a","ef0062a296d9a7c046a1b75493b62b007aa5f90cdc179ad2e4bc985ffcdd63b8","5b777cd24ce8cf2dca12f35d726540d65c077bf3bdd9cd605b5b5ddb4c32c90e","7ecc61db6d657901e1341c4cb33e0d518d510f8ea22782224df708b4e6653e97","003adca5eaa9e414de3cf493ceaa02cf132932fb1602673c228ef73af1a5487f","cac0eaf549337f1a5bf905c2445cae56d31fff68eb54a6eddbd4cb4aa5b80b9c","544662c5badd24bc2bee9222a64e308c1b8b151134e107c1a41eb099c92cff36","d640d95677b4b63d52a5e20ac7578ec8319a65b5721c15c7c1983c34683f2deb","43d44bb09c6d12b79885f97a8601accaa2f2becd618457f335e7544457b7bdcd","5d18b16e71c66589171bca928e8c12971a37d53e44f71bbd6b5f5c36e486b82b","2fe29fd004bf6335033fc223911800d3e6a115c1d0b1443323a3c13d20637013","c3a22f30914348b975f71a7b58f50cddc370b89bc190b08c9bf95a71b25c4027","c91e935fbb64b658b876b4193358a194f221d39fe9e156d1e7eb5962a4e3d199","000015efa72dcb38c4ca7433f4c634b0e51782c6d19794c038663f39734e4941","1fc3b5aa3e8613449919f737a3538c8616638b5fc89185b8c461706fd3c85d9a","fae63a78a66a56becbc5b8a2ab56dc6be8d6b188216ea1292991f118d5a5a4f5","08a931fbcd2cbcec44df846dae5e8745609e4c8eba10ccd3704e8adf2e767c66","4b0773a9016b1736f955c5c260f49afb7943cab0d789564c23bc94b37d1363b6","fb93535b9047ca6d5fd1b1ed62d844744d4fbc87ca5160142cc660c565c0df24","a7261127790220ebb86942ab7fcdf5d65e7edb818502956d2877aeb27d91c3af","ed7b3e539caf7fc02cc4bf1f5d41a6c28c47a30560b60dcc3f64ee24adb51219","1fb1ab237396cd34129967f3e58bc58cbd60fac4d77714e7817fb747f9fa1b1c"],"paragraph_range_zero_based":[1344,1367],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx:p1344"}
{"fields":{"filename":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}OPTIONAL,","paragraph_zero_based":1368},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":1369},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":1370},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1371},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":1372},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1373},{"literal_text_all_w_t_and_m_t":"MeasurementReferenceTime field descriptions","paragraph_zero_based":1374},{"literal_text_all_w_t_and_m_t":"gnss-TOD-msec","paragraph_zero_based":1375},{"literal_text_all_w_t_and_m_t":"This field specifies the GNSS TOD for which the measurements and/or location estimate are valid. The 22 bits of GNSS TOD are the least significant bits. The most significant bits are derived by the location server to unambiguously derive the GNSS TOD.","paragraph_zero_based":1376},{"literal_text_all_w_t_and_m_t":"The value for GNSS TOD is derived from the GNSS specific system time indicated in gnss-TimeID rounded down to the nearest millisecond unit.","paragraph_zero_based":1377},{"literal_text_all_w_t_and_m_t":"Scale factor 1 millisecond.","paragraph_zero_based":1378},{"literal_text_all_w_t_and_m_t":"gnss-TOD-frac","paragraph_zero_based":1379},{"literal_text_all_w_t_and_m_t":"This field specifies the fractional part of the GNSS TOD in 250 ns resolution. The total GNSS TOD is given by gnss-TOD-msec + gnss-TOD-frac.","paragraph_zero_based":1380},{"literal_text_all_w_t_and_m_t":"Scale factor 250 nanoseconds.","paragraph_zero_based":1381},{"literal_text_all_w_t_and_m_t":"gnss-TOD-unc","paragraph_zero_based":1382},{"literal_text_all_w_t_and_m_t":"This field provides the accuracy of the relation GNSS-network time when GNSS-network time association is provided. When GNSS-network time association is not provided, this element can be included to provide the accuracy of the reported gnss-TOD-msec.","paragraph_zero_based":1383},{"literal_text_all_w_t_and_m_t":"If GNSS TOD is the given GNSS time, then the true GNSS time, corresponding to the provided network time if applicable, as observed at the target device location, lies in the interval [GNSS TOD – gnss-TOD-unc, GNSS TOD + gnss-TOD-unc].","paragraph_zero_based":1384},{"literal_text_all_w_t_and_m_t":"The uncertainty r, expressed in microseconds, is mapped to a number K, with the following formula:","paragraph_zero_based":1385},{"literal_text_all_w_t_and_m_t":"r = C*(((1+x)K)-1)","paragraph_zero_based":1386},{"literal_text_all_w_t_and_m_t":"with C = 0.5 and x = 0.14. To encode any higher value of uncertainty than that corresponding in the above formula to K=127, the same value, K=127, shall also be used. The uncertainty is then coded on 7 bits, as the binary encoding of K. Examples of gnss-TOD-unc value are as in the table Value of K to Value of uncertainty relation below.","paragraph_zero_based":1387},{"literal_text_all_w_t_and_m_t":"This field shall be included if the target device provides GNSS-network time relationship.","paragraph_zero_based":1388},{"literal_text_all_w_t_and_m_t":"gnss-TimeID","paragraph_zero_based":1389},{"literal_text_all_w_t_and_m_t":"This field specifies the GNSS system time for which the gnss-TOD-msec (and gnss-TOD-frac if applicable) is provided.","paragraph_zero_based":1390},{"literal_text_all_w_t_and_m_t":"networkTime","paragraph_zero_based":1391}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["36a161ed3a60b33ff5779bcd205ab0ba8bde26fe3ba1db2fb8e3fe42b7ac5029","3a248f78447ab6468fe39926ed3ec962ab3b66b21a72ff70e5ee9fa0f53be5c1","bbd46108bba174e8e9726fe9390fbfa17d4df3b855b21a151d0c08f989185f2d","0dc09af286d1d55e8e78a75f84e2134ebee720ea87fbb189714bfc91599f454d","f3c7ec240ce719edda0f253c60e4c99c3a8e03f7a1573d55ce140911d44e31e2","3c74fc90b1b34c4c808cc58b22822e40ff07822e216a31f096fe15fdf8f9b37c","7bdbb04d0d73ba6b8e6349cbe610435dcfe49056df58ef4828f41d791e03a925","6509e532c1685d5c228fc2ea33865bb259ab49d55a829158b78cc561e0d72605","2aa25af6a70236a541227846d835cf2a436d40a253f37ad1d9955689ec70f3f2","f5105cd43a7862e43d4b91ab28b53fa0b087d7d973c38c11ffe671554f191e9c","788698e9e797ad187b82290349f3f7f50a37068aa153caf53c2fe4ea828df0d8","84e5db767d32680f8ec9e02515ef1f8193f4c1a0d713f844d3275470961d39ee","c9ae970610733d745cc528569885f1fc217ce33f26d7875d5157681013d4d018","8d33a3ed6a3d8f06f742055cd7810a7500cb16b629c594fb754f3dc11956cc41","796c749dc87b488f07d5333a07185eb65eb810c03c22a920250cc9bbb8445892","11c7a0314cd5c07ca4c9bc33d12509cacb0851af46f58a35858a0efac89f2d12","7e1f3aa2e9ab1a56ad4ddc30fc0f9d2cbe239db4aa802e89d2b628ff0637e5b3","ac059bbd9c84f07e0aecc847f206008968796f22862d5c5f24af67950ecd9199","367720ad7af9424a32cb926a057d27cfd9ce9bfc50bbd5206116e538f0e43480","5167dbac45f76e7df0b1e6b06d8a4307071ef1db4d78c081901cf7e0eb874fbb","42d47c11345c694033ac4ab345a592ad1472b28682db88412e7d1b6b26c2519f","5c5efb14a76e0a42e58cd656dcb9b4076437eca08626892d39a612d1a308e6cd","b09a40e75ee45c8baa06f450d4fe8779bab39240ec7fe3fa4977de2367fcf098","513ce7375146e06f5f61ebfb77ae4f4246ac686306a9e096add1d2fda768f46d"],"paragraph_range_zero_based":[1368,1391],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx:p1368"}
{"fields":{"filename":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"These fields specify the network time event which the GNSS TOD time stamps.","paragraph_zero_based":1392},{"literal_text_all_w_t_and_m_t":"This field shall be included if the target device provides GNSS-network time relationship.","paragraph_zero_based":1393},{"literal_text_all_w_t_and_m_t":"physCellId","paragraph_zero_based":1394},{"literal_text_all_w_t_and_m_t":"This field identifies the reference cell (E-UTRA), as defined in TS 36.331 [12], that is used for the GNSS-network time relation.","paragraph_zero_based":1395},{"literal_text_all_w_t_and_m_t":"cellGlobalId","paragraph_zero_based":1396},{"literal_text_all_w_t_and_m_t":"This field specifies the globally unique cell identifier (Evolved Cell Global Identifier (ECGI) in E-UTRA, global UTRAN Cell Identifier in UTRA, or Cell Global Identification (CGI) in GERAN) of the reference cell, as defined in TS 36.331 [12] for E-UTRA and in TS 25.331 [13] for UTRA, for which the GNSS network time relation is provided. ","paragraph_zero_based":1397},{"literal_text_all_w_t_and_m_t":"systemFrameNumber","paragraph_zero_based":1398},{"literal_text_all_w_t_and_m_t":"This field specifies the system frame number in E-UTRA which the GNSS time time stamps, as defined in TS 36.331 [12].","paragraph_zero_based":1399},{"literal_text_all_w_t_and_m_t":"mode","paragraph_zero_based":1400},{"literal_text_all_w_t_and_m_t":"This field identifies the reference cell for the GNSS-network time relation, as defined in TS 25.331 [13].","paragraph_zero_based":1401},{"literal_text_all_w_t_and_m_t":"referenceSystemFrameNumber","paragraph_zero_based":1402},{"literal_text_all_w_t_and_m_t":"This field specifies the system frame number in UTRA, as defined in TS 25.331 [13], which is used for time stamping.","paragraph_zero_based":1403},{"literal_text_all_w_t_and_m_t":"bcchCarrier, bsic","paragraph_zero_based":1404},{"literal_text_all_w_t_and_m_t":"This field identifies the reference cell for the GNSS-network time relation in GERAN, as defined in TS 44.031 [14].","paragraph_zero_based":1405},{"literal_text_all_w_t_and_m_t":"referenceFN, referenceFNMSB","paragraph_zero_based":1406},{"literal_text_all_w_t_and_m_t":"These fields specify the frame number in GERAN which the GNSS time time stamps, as defined in TS 44.031 [14]. The time of the reference frame boundary is as observed by the target device, i.e. without Timing Advance compensation. The referenceFNMSB field indicates the most significant bits of the frame number of the reference BTS corresponding to the GNSS-MeasurementList. Starting from the complete GSM frame number denoted FN, the target device calculates Reference FN MSB as","paragraph_zero_based":1407},{"literal_text_all_w_t_and_m_t":"Reference FN MSB = floor(FN/42432)","paragraph_zero_based":1408},{"literal_text_all_w_t_and_m_t":"The complete GSM frame number FN can then be reconstructed in the location server by combining the fields referenceFN with referenceFNMSB in the following way","paragraph_zero_based":1409},{"literal_text_all_w_t_and_m_t":"FN = referenceFNMSB *42432 + referenceFN","paragraph_zero_based":1410},{"literal_text_all_w_t_and_m_t":"deltaGNSS-TOD","paragraph_zero_based":1411},{"literal_text_all_w_t_and_m_t":"This field specifies the difference in milliseconds between gnss-TOD-msec reported and the milli-second part of the SV time tsv_1 of the first SV in the list reported from the target device, as defined in TS 44.031 [14]. The deltaGNSS-TOD is defined as","paragraph_zero_based":1412},{"literal_text_all_w_t_and_m_t":"deltaGNSS-TOD = gnss-TOD-msec - fix(tsv_1)","paragraph_zero_based":1413},{"literal_text_all_w_t_and_m_t":"where fix() denotes rounding to the nearest integer towards zero.","paragraph_zero_based":1414},{"literal_text_all_w_t_and_m_t":"nbPhysCellId","paragraph_zero_based":1415}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["11c3a588a82bc19d01222a4f5869edc9f05ad772113c364ed12a4eecf40952ba","393594a07e9a571bab861563718eae1c915d82959cc71beb5ca094c1dfab1524","75b58262a7f4b61a623e46ce2bd84df6f14d0b6cbc550f26a9745aa72bcfdb75","8c65893128ceeb6613ff2f2a4d1661447eab2e265361c4bc2cafb20711a8fbd1","02e152431208fa9b96d9d201ef75d34c51fea1143579297d0fde516ac17661f1","e41214134222018f8176e2bc7d529a80edc427a2957cef2dbfe1afd3dd4501af","b2578069d4476b6142fd55f836c6d1e408b79ac8933f4c01ad3a13333d537aaa","90a3f815ee2f4a4ee1c27f395d7844e1723ef3bb42bdb3114ece319d4905c328","a360df28f9c3a15af863800c8ca1999ce951a267545f014941475b29ee9a0bc6","3180d1e53784c064c3f1dff5d8f9207c2b1b5156ff4202548d8a0c7f7bd7b0c7","caa7b56cf062a98d282313e8a4686c05628f4eefcbdfabfd2fcbfe5f19dc14f8","97143931db59337b283d8f94bb49fcad9e4a39037f34f086b1af0e12e805c4f7","70d48f6cdf4d1907708e21cd7d411b50579815e1d530fa5d465f0b651c809a26","d9754f201e8ed9613fb6ad26e83acd1c1d103e5778e554fc0c50bdbcfccaa5b1","ac4ab88a683339827171b7affe7ad7c02b4ac0980f1c44a04efc0c1bb6167bb7","a8c107f12cab306101eae401e74e59621625ed73107a1568341f4103c636921b","9552d8a27c23372c0c245f2b9f3942cb7a105ee313bc98c6f262e5c0c43cff0e","fd866367ddb4ff16e6d382e8e47f8c2c02371353aedd417de45fe913d5fda1be","633be5eb98e476836e6bf5726c25fa2d44bedc54db0512ae61e8a19523a7c5d9","a328102715ffc090017a355015e524ae63f8090dbd608e873e8e5d5e088acfe1","fee15b9c8ff4f30c6fab247b0cedbed3d65219168433f7616771833602360d73","b4653e8a3c7b84b757bcfedfbcfc1764231d3a054812cb920af748a1c512af36","9bce7f25f7cf0bf4ea7bc9d3d1a11bf5157834cf16682fd9983439f6439f3285","b5c0c4fa5055841da632bd847303aa26bdac5478dc6115c529fe39dcef910c8e"],"paragraph_range_zero_based":[1392,1415],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx:p1392"}
{"fields":{"filename":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field identifies the reference cell, as defined in TS 36.331 [12] that is used for the GNSS-network time relation.","paragraph_zero_based":1416},{"literal_text_all_w_t_and_m_t":"nbCellGlobalId","paragraph_zero_based":1417},{"literal_text_all_w_t_and_m_t":"This field specifies the global cell identifier of the NB-IoT reference cell, as defined in TS 36.331 [12], for which the GNSS network time relation is provided.","paragraph_zero_based":1418},{"literal_text_all_w_t_and_m_t":"sfn","paragraph_zero_based":1419},{"literal_text_all_w_t_and_m_t":"This field specifies the system frame number in NB-IoT which the GNSS time time stamps, as defined in TS 36.331 [12].","paragraph_zero_based":1420},{"literal_text_all_w_t_and_m_t":"hyperSFN","paragraph_zero_based":1421},{"literal_text_all_w_t_and_m_t":"This field specifies the hyper-SFN in NB-IoT which the GNSS time time stamps, as defined in TS 36.331 [12].","paragraph_zero_based":1422},{"literal_text_all_w_t_and_m_t":"nrPhysCellId","paragraph_zero_based":1423},{"literal_text_all_w_t_and_m_t":"This field identifies the reference cell (NR), as defined in TS 38.331 [35], that is used for the GNSS-network time relation.","paragraph_zero_based":1424},{"literal_text_all_w_t_and_m_t":"nrCellGlobalID","paragraph_zero_based":1425},{"literal_text_all_w_t_and_m_t":"This field specifies the NR Cell Global Identifier (NCGI) of the reference cell, as defined in TS 38.331 [35], for which the GNSS network time relation is provided.","paragraph_zero_based":1426},{"literal_text_all_w_t_and_m_t":"nr-sfn","paragraph_zero_based":1427},{"literal_text_all_w_t_and_m_t":"This field specifies the system frame number in NR which the GNSS time time stamps, as defined in TS 38.331 [35],","paragraph_zero_based":1428},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1429},{"literal_text_all_w_t_and_m_t":"Value of K to Value of uncertainty relation","paragraph_zero_based":1430},{"literal_text_all_w_t_and_m_t":"Value of K","paragraph_zero_based":1431},{"literal_text_all_w_t_and_m_t":"Value of uncertainty","paragraph_zero_based":1432},{"literal_text_all_w_t_and_m_t":"0","paragraph_zero_based":1433},{"literal_text_all_w_t_and_m_t":"0 microseconds","paragraph_zero_based":1434},{"literal_text_all_w_t_and_m_t":"1","paragraph_zero_based":1435},{"literal_text_all_w_t_and_m_t":"0.07 microseconds","paragraph_zero_based":1436},{"literal_text_all_w_t_and_m_t":"2","paragraph_zero_based":1437},{"literal_text_all_w_t_and_m_t":"0.1498 microseconds","paragraph_zero_based":1438},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":1439}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["e1295c36d7adb3de7550cacc6c5f0e4adbab839c34418fb1fcf2d343cbdeead7","638bc4c7de9daa73f2ff8b435bad2e39a977067e084429ba2d6f40df16544288","0fc03caeffdc2a9a512ded634c9691e64ba8bf5e328c9dc0efb8678c873c1ba4","c5f687575923c39258b27e8ed49413e149cfdb54037e69f765bf2a19c66470e6","5bfc28ca323d04dfb8ee6ae5a94773a428783726fb205a339cb84ab1eeecca75","c808cbaa529371d11e21ee9672d508d712af3c7de2a1118963f7f5b0ce6fba11","ab1bb3999159e8f1282a96ec8ec5c34f285795c8e705586b2a6b671ea09a756d","45bec71739e9e63f8191d5b6b1a5a549e71eee9f1a21ff3c8b462a9f403bd0bb","0ea7db5aa092db44747d0aadd05e1224493a6af2e58b256ddcecf9ff680542cc","16b9dfbb920e53163039593447f95cae72ddd28d6640d1599b2161eaafc9315f","0f67d1b8f18feb4ada179c9346057b5eac78365865d2669e48bd516e8f340e30","655467665ad1f06c4dbcc18231ed3fc7114458b30fa8b09b45385ffb8e7c1dbc","3adeab2cb4f775bf5d6ee0119b7a3731a117785de1d256