{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–RA-Prioritization","paragraph_zero_based":25224},{"literal_text_all_w_t_and_m_t":"The IE RA-Prioritization is used to configure prioritized random access.","paragraph_zero_based":25225},{"literal_text_all_w_t_and_m_t":"RA-Prioritization information element","paragraph_zero_based":25226},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25227},{"literal_text_all_w_t_and_m_t":"-- TAG-RA-PRIORITIZATION-START","paragraph_zero_based":25228},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25229},{"literal_text_all_w_t_and_m_t":"RA-Prioritization ::=           SEQUENCE {","paragraph_zero_based":25230},{"literal_text_all_w_t_and_m_t":"    powerRampingStepHighPriority    ENUMERATED {dB0, dB2, dB4, dB6},","paragraph_zero_based":25231},{"literal_text_all_w_t_and_m_t":"    scalingFactorBI                 ENUMERATED {zero, dot25, dot5, dot75}                               OPTIONAL,   -- Need R","paragraph_zero_based":25232},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":25233},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25234},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25235},{"literal_text_all_w_t_and_m_t":"-- TAG-RA-PRIORITIZATION-STOP","paragraph_zero_based":25236},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":25237},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25238},{"literal_text_all_w_t_and_m_t":"RA-Prioritization field descriptions","paragraph_zero_based":25239},{"literal_text_all_w_t_and_m_t":"powerRampingStepHighPrioritiy","paragraph_zero_based":25240},{"literal_text_all_w_t_and_m_t":"Power ramping step applied for prioritized random access procedure.","paragraph_zero_based":25241},{"literal_text_all_w_t_and_m_t":"scalingFactorBI","paragraph_zero_based":25242},{"literal_text_all_w_t_and_m_t":"Scaling factor for the backoff indicator (BI) for the prioritized random access procedure. (see TS 38.321 [3], clause 5.1.4). Value zero corresponds to 0, value dot25 corresponds to 0.25 and so on.","paragraph_zero_based":25243},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25244},{"literal_text_all_w_t_and_m_t":"–RA-PrioritizationForSlicing","paragraph_zero_based":25245},{"literal_text_all_w_t_and_m_t":"The IE RA-PrioritizationForSlicing is used to configure prioritized random access for slicing.","paragraph_zero_based":25246},{"literal_text_all_w_t_and_m_t":"RA-PrioritizationForSlicing information element","paragraph_zero_based":25247}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["5073506993b3f5debb76e627d37a370dd85ad304f728c727a2a8eea5ebfc6164","0de1a510298923cc4cb9ad1028edd15ab7ec81b161898e732d9d6468796a9478","345f136b7d8746ee34fd3db65d8796b9c512dddfd3f2dc74c69da8f29f16ba7f","bf707e5c1f845738a5fd0df6438014167b16bf6cb268bf018bcb3527c3d42069","69c8e393393ae6554148d980c36d79376ec037629dbc3f34807e46d7adf911cf","84c9e029381831536b8b40f15d3c980a479d0b77abc168fe7462259ef6f2908e","ef95655605951b1a88f4e2f8d8cd1f173b2a1b84954d1fb218b7b6f951e09c9f","2a0f00a53b57495aa960aa4bf5a2eea75e2dec014a4c7674ee3b32e6efddae41","017c84316b87ada4f5f39e189628ca527cc1030de8a91df5708f32f5ad245182","d1b2f66c33454c0d2f1abcd6dfa78856cad69b9005ee4e70041e4f627eb220e8","dc68519fc74c6ba3e0ee1578e29a32835fe04485db18bf539461c0ca2b9a00bc","48c74b440cc6dc1e7465f93dbac81d7ea9a0bde0b09ef339ccbcee460110fa77","ddba6b492d52199d925a831b0fda5a725fed6bb86b68d71333ee05b72a7c288b","6ae388875af05c9845223bbb6b0b6443a3680c47ce0e1c601fc2a356b33bcba9","97818f