{"fields":{"filename":"R2-2305059.zip::R2-2305059 38331_Correction_FD_SL_Relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":240},{"literal_text_all_w_t_and_m_t":"SL-FailureList-r16 ::=                 SEQUENCE (SIZE (1..maxNrofSL-Dest-r16)) OF SL-Failure-r16","paragraph_zero_based":241},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":242},{"literal_text_all_w_t_and_m_t":"SL-Failure-r16 ::=                     SEQUENCE {","paragraph_zero_based":243},{"literal_text_all_w_t_and_m_t":"    sl-DestinationIdentity-r16             SL-DestinationIdentity-r16,","paragraph_zero_based":244},{"literal_text_all_w_t_and_m_t":"    sl-Failure-r16                         ENUMERATED {rlf,configFailure, drxReject-v1710, spare5, spare4, spare3, spare2, spare1}","paragraph_zero_based":245},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":246},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":247},{"literal_text_all_w_t_and_m_t":"-- TAG-SIDELINKUEINFORMATIONNR-STOP","paragraph_zero_based":248},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":249},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":250},{"literal_text_all_w_t_and_m_t":"SidelinkUEinformationNR field descriptions","paragraph_zero_based":251},{"literal_text_all_w_t_and_m_t":"sl-RxDRX-ReportList","paragraph_zero_based":252},{"literal_text_all_w_t_and_m_t":"Indicates the accepted DRX configuration that is received from the peer UE and reported to the network for NR sidelink unicast communication.","paragraph_zero_based":253},{"literal_text_all_w_t_and_m_t":"sl-RxInterestedFreqList","paragraph_zero_based":254},{"literal_text_all_w_t_and_m_t":"Indicates the index of frequency on which the UE is interested to receive NR sidelink communication. The value 1 corresponds to the frequency of first entry in sl-FreqInfoList broadcast in SIB12, the value 2 corresponds to the frequency of second entry in sl-FreqInfoList broadcast in SIB12 and so on. In this release, only value 1 can be included in the interested frequency list. ","paragraph_zero_based":255},{"literal_text_all_w_t_and_m_t":"sl-RxInterestedGC-BC-DestList","paragraph_zero_based":256},{"literal_text_all_w_t_and_m_t":"Indicates the reported QoS profile and associated destination for which UE is interested in reception to the network for NR sidelink groupcast and broadcast communication, or for NR sidelink discovery or ProSe Direct Link Establishment Request as described in TS 24.554 [72], or for Direct Link Establishment Request (TS 24.587 [57]).","paragraph_zero_based":257},{"literal_text_all_w_t_and_m_t":"sl-SourceIdentityRemoteUE","paragraph_zero_based":258},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the Source Layer-2 ID to be used to establish PC5 link with the target L2 U2N Relay UE for path switch.","paragraph_zero_based":259},{"literal_text_all_w_t_and_m_t":"sl-TxResourceReq","paragraph_zero_based":260},{"literal_text_all_w_t_and_m_t":"Parameters to request the transmission resources for NR sidelink communication to the network in the Sidelink UE Information report.","paragraph_zero_based":261},{"literal_text_all_w_t_and_m_t":"sl-TxResourceReqList","paragraph_zero_based":262},{"literal_text_all_w_t_and_m_t":"List of parameters to request the transmission resources for NR sidelink communication for the associated destination. If sl-TxResourceReqList-v1700 is present, it shall contain the same number of entries, listed in the same order as in sl-TxResourceReqList-r16.","paragraph_zero_based":263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"86fada5ff07263f82a7ae2684ffc6687b5dedba803d73277e43f49470661bd2e","original_member_sha256":"55341d84f1383c55565e46179ecc3fb961a2efa6d1be571bfc13d4a345f73303","paragraph_ElementTree_utf8_XML_sha256":["b253c8004e04a0700b095abff2053190a9ac3aad8187860da86db97ba23f8ac6","a18522346928c499d7b328fcd7ff8addbf589789ff0b14ac2a6f11cdea81e6af","4a2f1c805d572fe9cfc04f12cf3f932f04027ee65b7875fb446261bf9c231b70","63beb299eccc7bf24126390b37f73819a086d969852723252d5dbcf9e874db18","bac43842a6d8912595aeeef963971a930939088e36cb363d2afb8197ad698601","451169d017e58440e921e4ae387f8ec9adafb283042b3402b36cb45fec3d6495","16ad3b4e00d5f838b951efa504d41c3021d8476de0495118a79b1ebb748d286f","4ad0a6d26f700896a56e798bcfeeeef6626e50c0d3801b4691b9b5ff231e3276","dad90688aece576bb4f2793c1dbd2d20659593b7dd55caf98d3fe33c794bf238","fe2e585b3d25cc5b90d486b65ed77b2b5b5e3d99716ece110627e764bbd98125","56aff4b942476c86f17f77508bc3d6830e2f54ac6c9f563100068d9b7ebc3766","0f12cb893d1677a62f63c3f0d6efc619d1b8f462945dd97baac470c881594c00","30baaa8dfcc6f5fddc8ca3eeefc7987fc0e412e9fda563748cb055ce127b5e78","9196c9fb912ba05710db0b5015b9d87f7719c0ac892264aaf7bd522d0cf6662a","e48a28b120a5ead6b807a12667da02fead06ee8dcceb342b5ac77323e33c3346","9f649fa2bd0639d43f66ab094f5d7699480b8d2054ad979943094c0991f2dfbe","ec0e94bbc985a572646e04dcc3cb9f67aef0b11f500646ac6aef5982da9c5658","206a7d40fa3b2b1d7e6f1cac93c193997a9277562bff5c3ecc26ee5188a79832","bf9d692d9030f2e0c951f9eb7868d25db0f35ccc51dd57a18a99d4cd73185ff4","e9f7e102f63f2db860704446a09fcfaabf03e8eaf42673e49fc374cbdb8bce99","9dc1c284e71fef5ebfde18ba012e575055823774ddffffa1aaf771e1a802260b","7981b0f648917e139c6804c7c074317c82da7506b70a950de19b843ab98f9f5b","b661013ca2de62121aa9a4958ca10e7b2fa3d007071c4d9314a02b8f2f04d1c8","4e35c4da1f00e7b0c1b422b5dce293bd84dbf58611d57b8e2f4f35ac7d58b3cd"],"paragraph_range_zero_based":[240,263],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2305059.zip::R2-2305059 38331_Correction_FD_SL_Relay.docx:p240"}
{"fields":{"filename":"R2-2305059.zip::R2-2305059 38331_Correction_FD_SL_Relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ue-Type","paragraph_zero_based":264},{"literal_text_all_w_t_and_m_t":"Indicates the UE is acting as U2N Relay UE or U2N Remote UE.","paragraph_zero_based":265},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":266},{"literal_text_all_w_t_and_m_t":"SL-TxResourceReq field descriptions","paragraph_zero_based":267},{"literal_text_all_w_t_and_m_t":"sl-CapabilityInformationSidelink","paragraph_zero_based":268},{"literal_text_all_w_t_and_m_t":"Includes the UECapabilityInformationSidelink message (which can be also included in ueCapabilityInformationSidelink-r16 in UECapabilityEnquirySidelink from peer UE) received from the peer UE.","paragraph_zero_based":269},{"literal_text_all_w_t_and_m_t":"sl-CastType","paragraph_zero_based":270},{"literal_text_all_w_t_and_m_t":"Indicates the cast type for the corresponding destination for which to request the resource.","paragraph_zero_based":271},{"literal_text_all_w_t_and_m_t":"sl-DestinationIdentity","paragraph_zero_based":272},{"literal_text_all_w_t_and_m_t":"Indicates the destination for which the TX resource request and allocation from the network are concerned.","paragraph_zero_based":273},{"literal_text_all_w_t_and_m_t":"sl-DRX-Indication","paragraph_zero_based":274},{"literal_text_all_w_t_and_m_t":"Indicates the sidelink DRX is applied (value on) or not applied (value off) for the associated destination. This field is only valid for NR sidelink groupcast communication.","paragraph_zero_based":275},{"literal_text_all_w_t_and_m_t":"sl-DRX-InfoFromRxList","paragraph_zero_based":276},{"literal_text_all_w_t_and_m_t":"Indicates list of the sidelink DRX configurations as assistance information received from the peer UE for NR sidelink unicast communication.","paragraph_zero_based":277},{"literal_text_all_w_t_and_m_t":"sl-QoS-InfoList","paragraph_zero_based":278},{"literal_text_all_w_t_and_m_t":"Includes the QoS profile of the sidelink QoS flow as specified in TS 23.287 [55].","paragraph_zero_based":279},{"literal_text_all_w_t_and_m_t":"sl-QoS-FlowIdentity","paragraph_zero_based":280},{"literal_text_all_w_t_and_m_t":"This identity uniquely identifies one sidelink QoS flow between the UE and the network in the scope of UE, which is unique for different destination and cast type.","paragraph_zero_based":281},{"literal_text_all_w_t_and_m_t":"sl-RLC-ModeIndication","paragraph_zero_based":282},{"literal_text_all_w_t_and_m_t":"This field indicates the RLC mode and optionally the related QoS profiles for the sidelink radio bearer, which has not been configured by the network and is initiated by another UE in unicast. The RLC mode for one sidelink radio bearer is aligned between UE and NW by the sl-QoS-FlowIdentity.","paragraph_zero_based":283},{"literal_text_all_w_t_and_m_t":"sl-TxInterestedFreqList","paragraph_zero_based":284},{"literal_text_all_w_t_and_m_t":"Each entry of this field indicates the index of frequency on which the UE is interested to transmit NR sidelink communication. The value 1 corresponds to the frequency of first entry in sl-FreqInfoList broadcast in SIB12, the value 2 corresponds to the frequency of second entry in sl-FreqInfoList broadcast in SIB12 and so on. In this release, only value 1 can be included in the interested frequency list. In this release, only one entry can be included in the list.","paragraph_zero_based":285},{"literal_text_all_w_t_and_m_t":"sl-TypeTxSyncList","paragraph_zero_based":286},{"literal_text_all_w_t_and_m_t":"A list of synchronization reference used by the UE. The UE shall include the same number of entries, listed in the same order, as in sl-TxInterestedFreqList, i.e. one for each carrier frequency included in sl-TxInterestedFreqList.","paragraph_zero_based":287}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"86fada5ff07263f82a7ae2684ffc6687b5dedba803d73277e43f49470661bd2e","original_member_sha256":"55341d84f1383c55565e46179ecc3fb961a2efa6d1be571bfc13d4a345f73303","paragraph_ElementTree_utf8_XML_sha256":["d08b21b0dce52577c29ed55a8d1670d8321059dc744da57ac44f94934166ab87","1f38ac5c1d3c614906a27f90810ca4496954cf907e948d21cc1099f4c67b8fde","05b608fdd1221a1809dd25ccda41a09ba53f25a9944771c95552335ed56d814d","c755d5da957aa48aebcf5c60db76abb9b1260761f938a404f8b8068ddd1fd462","00404111429b1bd0f6e1287845690f6ad38025223a900277d657121d504afb6f","c7240dfa957292b4608a2a949bfeb74c62da94723737ded33eff088c379752b5","6bf483b70a9e822bde89906b219a969177bac80dff34772195c4f9c598833704","85f2b4ef1125979faeb5a3a683d0c34f2a73ada1d94eab56c22b9e104a4d7890","cb2dc90a28c39cc15041d14ae31a810b07d9b2b2f3d2359d614303debc1e5cfe","fcbf3c27c55feddb1cca7b409c2f09d9fffe98f0978c15b52467b34ba0d4d95a","213555490be9b64d851040614defed374a80afd63154be68e94e8ca4cad1c376","dfdf3b6b2dd2776545110f748b5713cf8eb5f5af784d399e4903a6ca82981467","66a014ecdd2f5f8835cd1d161fecdbbec74488601d469e7da6b8261dd9d6b654","fa06e55ce91b7c0bcacb5bd8b4b1b71c6dbb784ef9c5aba4669f14c9af0d20f7","135e5403cddb4e2d170b093539ee6ff5512f91ad392434ce3aa65d113308cd92","680222127b32bd9e3580896fa95aac77361d36587a29453370fee2c1ea11a733","a204485fcbfcb8e5f4258740fca608fc6dcdcdc9f8396eab759d521310b95cdd","c486999253ed07f89852c9e40edf1edc37787c914651bfcf29ffb90afe562765","1613af83b3665176904f4a7926b7d6b22a705065a35a2a82cde69d61d234f3a9","a16b15e6ebc37c0bc8f1d125188550ed8447d59f120d3ae383cb683b547f1959","33fad8056dfafe30fb6c913ca4b51a630278ab84ea86e279fada8107a67a4f2d","1ea48980299ae6a022db90c1bebd66d762f6fd1ff7d4e4061948d507850a077b","b24cc74000cc17c1b5922ccb4012d36b274b736e32524e9e73c02c2b2c33febf","77cb54f43ab4f5a8ddfe7161325c3a3f08a8ddd6c93e3f15944256dc6e3b675c"],"paragraph_range_zero_based":[264,287],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2305059.zip::R2-2305059 38331_Correction_FD_SL_Relay.docx:p264"}
{"fields":{"filename":"R2-2305059.zip::R2-2305059 38331_Correction_FD_SL_Relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":288},{"literal_text_all_w_t_and_m_t":"SL-Failure field descriptions","paragraph_zero_based":289},{"literal_text_all_w_t_and_m_t":"sl-DestinationIdentity","paragraph_zero_based":290},{"literal_text_all_w_t_and_m_t":"Indicates the destination for which the SL failure is reporting for unicast.","paragraph_zero_based":291},{"literal_text_all_w_t_and_m_t":"sl-Failure","paragraph_zero_based":292},{"literal_text_all_w_t_and_m_t":"Indicates the sidelink cause for the sidelink RLF (value rlf), sidelink AS configuration failure (value configFailure) and the rejection of sidelink DRX configuration (value drxReject-v1710) for the associated destination for unicast.","paragraph_zero_based":293},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":294},{"literal_text_all_w_t_and_m_t":"SL-RxDRX-Report field descriptions","paragraph_zero_based":295},{"literal_text_all_w_t_and_m_t":"sl-DRX-ConfigFromTx","paragraph_zero_based":296},{"literal_text_all_w_t_and_m_t":"Indicates the sidelink DRX configuration received from the peer UE for NR sidelink unicast communication.","paragraph_zero_based":297},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":298},{"literal_text_all_w_t_and_m_t":"SL-RxInterestedGC-BC-Dest field descriptions","paragraph_zero_based":299},{"literal_text_all_w_t_and_m_t":"sl-RxInterestedQoS-InfoList","paragraph_zero_based":300},{"literal_text_all_w_t_and_m_t":"Indicates the QoS profile for which UE reports its interested service to which SL DRX is applied to the network, for NR sidelink groupcast or broadcast reception.","paragraph_zero_based":301},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":302},{"literal_text_all_w_t_and_m_t":"SL-TxResourceReqDisc field descriptions","paragraph_zero_based":303},{"literal_text_all_w_t_and_m_t":"sl-CastTypeDisc","paragraph_zero_based":304},{"literal_text_all_w_t_and_m_t":"Indicates the cast type for the NR sidelink discovery messages. Only value broadcast can be set in this release.","paragraph_zero_based":305},{"literal_text_all_w_t_and_m_t":"sl-DestinationIdentityDisc","paragraph_zero_based":306},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the destination L2 ID for which the TX resource request and allocation from the network are concerned for relay discovery and non-relay discovery.","paragraph_zero_based":307},{"literal_text_all_w_t_and_m_t":"sl-SourceIdentityRelayUE","paragraph_zero_based":308},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the source L2 ID of relay-related discovery transmission by L2 U2N Relay UE.","paragraph_zero_based":309},{"literal_text_all_w_t_and_m_t":"sl-TxInterestedFreqListDisc","paragraph_zero_based":310},{"literal_text_all_w_t_and_m_t":"Each entry of this field indicates the index of frequency on which the UE is interested to transmit NR sidelink discovery. The value 1 corresponds to the frequency of first entry in sl-FreqInfoList broadcast in SIB12, the value 2 corresponds to the frequency of second entry in sl-FreqInfoList broadcast in SIB12 and so on. In this release, only value 1 can be included in the interested frequency list. In this release, only one entry can be included in the list.","paragraph_zero_based":311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"86fada5ff07263f82a7ae2684ffc6687b5dedba803d73277e43f49470661bd2e","original_member_sha256":"55341d84f1383c55565e46179ecc3fb961a2efa6d1be571bfc13d4a345f73303","paragraph_ElementTree_utf8_XML_sha256":["6e8bfe68c18a7d73ac2560727da090f1392db9e76c0f7c0d2048d9db83097b4b","40a65f5e939c399d00513167a4aaad3f9c00b2d52e1ed2fa3b33b595e2d282a1","ae163294e6a2cff85e50c233c562ed1d2489d47ef81627b512a1cbe317057ae1","6ad2