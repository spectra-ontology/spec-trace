{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    measGapId-r17                       MeasGapId-r17,","paragraph_zero_based":19440},{"literal_text_all_w_t_and_m_t":"    gapType-r17                         ENUMERATED {perUE, perFR1, perFR2},","paragraph_zero_based":19441},{"literal_text_all_w_t_and_m_t":"    gapOffset-r17                       INTEGER (0..159),","paragraph_zero_based":19442},{"literal_text_all_w_t_and_m_t":"    mgl-r17                             ENUMERATED {ms1, ms1dot5, ms2, ms3, ms3dot5, ms4, ms5, ms5dot5, ms6, ms10, ms20},","paragraph_zero_based":19443},{"literal_text_all_w_t_and_m_t":"    mgrp-r17                            ENUMERATED {ms20, ms40, ms80, ms160},","paragraph_zero_based":19444},{"literal_text_all_w_t_and_m_t":"    mgta-r17                            ENUMERATED {ms0, ms0dot25, ms0dot5, ms0dot75},","paragraph_zero_based":19445},{"literal_text_all_w_t_and_m_t":"    refServCellIndicator-r17            ENUMERATED {pCell, pSCell, mcg-FR2}                                 OPTIONAL,   -- Cond NEDCorNRDC","paragraph_zero_based":19446},{"literal_text_all_w_t_and_m_t":"    refFR2-ServCellAsyncCA-r17          ServCellIndex                                                       OPTIONAL,   -- Cond AsyncCA","paragraph_zero_based":19447},{"literal_text_all_w_t_and_m_t":"    preConfigInd-r17                    ENUMERATED {true}                                                   OPTIONAL,   -- Need R","paragraph_zero_based":19448},{"literal_text_all_w_t_and_m_t":"    ncsgInd-r17                         ENUMERATED {true}                                                   OPTIONAL,   -- Need R","paragraph_zero_based":19449},{"literal_text_all_w_t_and_m_t":"    gapAssociationPRS-r17               ENUMERATED {true}                                                   OPTIONAL,   -- Need R","paragraph_zero_based":19450},{"literal_text_all_w_t_and_m_t":"    gapSharing-r17                      MeasGapSharingScheme                                                OPTIONAL,   -- Need R","paragraph_zero_based":19451},{"literal_text_all_w_t_and_m_t":"    gapPriority-r17                     GapPriority-r17                                                     OPTIONAL,   -- Need R","paragraph_zero_based":19452},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":19453},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":19454},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19455},{"literal_text_all_w_t_and_m_t":"PosMeasGapPreConfigToAddModList-r17 ::= SEQUENCE (SIZE (1..maxNrofPreConfigPosGapId-r17)) OF PosGapConfig-r17","paragraph_zero_based":19456},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19457},{"literal_text_all_w_t_and_m_t":"PosMeasGapPreConfigToReleaseList-r17 ::= SEQUENCE (SIZE (1..maxNrofPreConfigPosGapId-r17)) OF MeasPosPreConfigGapId-r17","paragraph_zero_based":19458},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19459},{"literal_text_all_w_t_and_m_t":"PosGapConfig-r17 ::=                SEQUENCE {","paragraph_zero_based":19460},{"literal_text_all_w_t_and_m_t":"    measPosPreConfigGapId-r17           MeasPosPreConfigGapId-r17,","paragraph_zero_based":19461},{"literal_text_all_w_t_and_m_t":"    gapOffset-r17                       INTEGER (0..159),","paragraph_zero_based":19462},{"literal_text_all_w_t_and_m_t":"    mgl-r17                             ENUMERATED {ms1dot5, ms3, ms3dot5, ms4, ms5dot5, ms6, ms10, ms20},","paragraph_zero_based":19463}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["447e19b62c