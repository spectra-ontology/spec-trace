{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"V2X sidelink communication: AS functionality enabling V2X Communication as defined in TS 23.285 [56], between nearby UEs, using E-UTRA technology but not traversing any network node.","paragraph_zero_based":240},{"literal_text_all_w_t_and_m_t":"3.2Abbreviations","paragraph_zero_based":241},{"literal_text_all_w_t_and_m_t":"For the purposes of the present document, the abbreviations given in TR 21.905 [1] and the following apply. An abbreviation defined in the present document takes precedence over the definition of the same abbreviation, if any, in TR 21.905 [1].","paragraph_zero_based":242},{"literal_text_all_w_t_and_m_t":"5GC5G Core Network","paragraph_zero_based":243},{"literal_text_all_w_t_and_m_t":"ACKAcknowledgement","paragraph_zero_based":244},{"literal_text_all_w_t_and_m_t":"AMAcknowledged Mode","paragraph_zero_based":245},{"literal_text_all_w_t_and_m_t":"ARQAutomatic Repeat Request","paragraph_zero_based":246},{"literal_text_all_w_t_and_m_t":"ASAccess Stratum","paragraph_zero_based":247},{"literal_text_all_w_t_and_m_t":"ASN.1Abstract Syntax Notation One","paragraph_zero_based":248},{"literal_text_all_w_t_and_m_t":"BAPBackhaul Adaptation Protocol","paragraph_zero_based":249},{"literal_text_all_w_t_and_m_t":"BCDBinary Coded Decimal","paragraph_zero_based":250},{"literal_text_all_w_t_and_m_t":"BFDBeam Failure Detection","paragraph_zero_based":251},{"literal_text_all_w_t_and_m_t":"BHBackhaul","paragraph_zero_based":252},{"literal_text_all_w_t_and_m_t":"BLERBlock Error Rate","paragraph_zero_based":253},{"literal_text_all_w_t_and_m_t":"BWPBandwidth Part","paragraph_zero_based":254},{"literal_text_all_w_t_and_m_t":"CACarrier Aggregation","paragraph_zero_based":255},{"literal_text_all_w_t_and_m_t":"CAGClosed Access Group","paragraph_zero_based":256},{"literal_text_a