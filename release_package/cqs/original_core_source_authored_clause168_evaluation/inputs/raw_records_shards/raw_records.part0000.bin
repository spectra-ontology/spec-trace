{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30480},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":30481},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":30482},{"literal_text_all_w_t_and_m_t":"PeriodicOrSemiPersistent","paragraph_zero_based":30483},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need M, for periodic and semi-persistent ZP-CSI-RS-Resources (as indicated in PDSCH-Config). The field is absent otherwise.","paragraph_zero_based":30484},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30485},{"literal_text_all_w_t_and_m_t":"–ZP-CSI-RS-ResourceSet","paragraph_zero_based":30486},{"literal_text_all_w_t_and_m_t":"The IE ZP-CSI-RS-ResourceSet refers to a set of ZP-CSI-RS-Resources using their ZP-CSI-RS-ResourceIds.","paragraph_zero_based":30487},{"literal_text_all_w_t_and_m_t":"ZP-CSI-RS-ResourceSet information element","paragraph_zero_based":30488},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":30489},{"literal_text_all_w_t_and_m_t":"-- TAG-ZP-CSI-RS-RESOURCESET-START","paragraph_zero_based":30490},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30491},{"literal_text_all_w_t_and_m_t":"ZP-CSI-RS-ResourceSet ::=           SEQUENCE {","paragraph_zero_based":30492},{"literal_text_all_w_t_and_m_t":"    zp-CSI-RS-ResourceSetId             ZP-CSI-RS-ResourceSetId,","paragraph_zero_based":30493},{"literal_text_all_w_t_and_m_t":"    zp-CSI-RS-ResourceIdList            SEQUENCE (SIZE(1..maxNrofZP-CSI-RS-ResourcesPerSet)) OF ZP-CSI-RS-ResourceId,","paragraph_zero_based":30494},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":30495},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30496},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30497},{"literal_text_all_w_t_and_m_t":"-- TAG-ZP-CSI-RS-RESOURCESET-STOP","paragraph_zero_based":30498},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":30499},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30500},{"literal_text_all_w_t_and_m_t":"ZP-CSI-RS-ResourceSet field descriptions","paragraph_zero_based":30501},{"literal_text_all_w_t_and_m_t":"zp-CSI-RS-ResourceIdList","paragraph_zero_based":30502},{"literal_text_all_w_t_and_m_t":"The list of ZP-CSI-RS-ResourceId identifying the ZP-CSI-RS-Resource elements belonging to this set.","paragraph_zero_based":30503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["7a5c4bd0be6e8163565e447d993ede0faeb5f83f8f16062dacd7c7eecb2acd73","6c21801882317b8ada3ccd0dc5722af11c9e3ac6d4929865a8b7435eb533c612","58cbf515f53d3a17c876493899d75230096d4edbe7c9a8d1eb450354685fb88b","16537f46c5e247240876c0e04421e416f6a491e5a12482689133ba226952b607","89433ece92da1bcd337cad942de3897ea0a0022300275a6699779a752e862a0b","48b6242f8ec38e1b3b5113e9fd7744ecec626ca3548172f2119f21d0599b3cfb","0901d9fac1547ec661e9f5c483e58245a63aa245888c934ca439795230e2089e","f779de906d060e7a42e7f1cf4f5f336e70e44af55548e99785a0bd0247f9003c","fcd0481b3fc5d0f51ec03c848870a7542b42bc8f516215384c7b3b13fe9901a4","dd83b497ba4b03d0faf510c51618e6cd8079efa7e85405f3cd843390b8db14c0","08867afd7b7bc3a11e299c47faf8c5b350cd664bc56fce377c2d84a3d2fb4029","f68e026c49914cf1432ba3ad0e4122899f3fb0416239e80d93635faaf6343789","73eefaae10c335c90289222e1bdc2956a81fe02c0621fbdce9e6c0597c2560af","05d56b282386551f84bd2a3ca6c9f31dfa25eef2f365437a0340950d5b7ea349","bf19b61f62ca09d9ede678632dec4f6977cf54df04fe5125f42ccf45f0c267b5","bbd39c5cefb814943227707f6dff3fe7a6b18bb1