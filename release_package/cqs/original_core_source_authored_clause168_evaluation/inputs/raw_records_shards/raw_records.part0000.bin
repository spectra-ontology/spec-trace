{"fields":{"filename":"R2-2310947.zip::R2-2310947.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"C-RNTICell RNTI","paragraph_zero_based":144},{"literal_text_all_w_t_and_m_t":"CAGClosed Access Group","paragraph_zero_based":145},{"literal_text_all_w_t_and_m_t":"CAPCChannel Access Priority Class","paragraph_zero_based":146},{"literal_text_all_w_t_and_m_t":"CBRAContention Based Random Access","paragraph_zero_based":147},{"literal_text_all_w_t_and_m_t":"CCEControl Channel Element","paragraph_zero_based":148},{"literal_text_all_w_t_and_m_t":"CD-SSBCell Defining SSB","paragraph_zero_based":149},{"literal_text_all_w_t_and_m_t":"CFRCommon Frequency Resource","paragraph_zero_based":150},{"literal_text_all_w_t_and_m_t":"CFRAContention Free Random Access","paragraph_zero_based":151},{"literal_text_all_w_t_and_m_t":"CGConfigured Grant","paragraph_zero_based":152},{"literal_text_all_w_t_and_m_t":"CHOConditional Handover","paragraph_zero_based":153},{"literal_text_all_w_t_and_m_t":"CIoTCellular Internet of Things","paragraph_zero_based":154},{"literal_text_all_w_t_and_m_t":"CLICross Link interference","paragraph_zero_based":155},{"literal_text_all_w_t_and_m_t":"CMASCommercial Mobile Alert Service","paragraph_zero_based":156},{"literal_text_all_w_t_and_m_t":"CORESETControl Resource Set","paragraph_zero_based":157},{"literal_text_all_w_t_and_m_t":"CPCyclic Prefix","paragraph_zero_based":158},{"literal_text_all_w_t_and_m_t":"CPAConditional PSCell Addition","paragraph_zero_based":159},{"literal_text_all_w_t_and_m_t":"CPCConditional PSCell Change","paragraph_zero_based":160},{"literal_text_all_w_t_and_m_t":"DAGDirected Acyclic Graph","paragraph_zero_based":161},{"literal_text_all_w_t_and_m_t":"DAPSDual Active Protocol Stack","paragraph_zero_based":162},{"literal_text_all_w_t_and_m_t":"DFTDiscrete Fourier Transform","paragraph_zero_based":163},{"literal_text_all_w_t_and_m_t":"DCIDownlink Control Information","paragraph_zero_based":164},{"literal_text_all_w_t_and_m_t":"DCPDCI with CRC scrambled by PS-RNTI","paragraph_zero_based":165},{"literal_text_all_w_t_and_m_t":"DL-AoDDownlink Angle-of-Departure","paragraph_zero_based":166},{"literal_text_all_w_t_and_m_t":"DL-SCHDownlink Shared Channel","paragraph_zero_based":167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8d4901b891fbd4ddd84ab30e673a8dc5a4094da57e9e4b85dbb233c58abd62aa","original_member_sha256":"be142033f82c6755a6455392686a978e05ce304dac4a2fd05b9a253aaed7cdf3","paragraph_ElementTree_utf8_XML_sha256":["18214f6a31086984d99ab989cf94b0e386e125e1e33b444664051daac00ce4f0","07177a083c6fb41326cbc1dcfb919e839d78f368276330d3e54a6ee2b1b189cc","935258f1d784f6c55a8028b2d13fd5da3a604994162f7a2f600503e6d3a6a0ff","4c9d62cf0b53b995ecd0fb4eb2a65639a4abe239ea216bb0db01b9bd9740d766","9e5d45fe3d8417ec02170cac9bb100947bc6b3074e50d0ab829f121889f2a14b","7fd55b3ac7b72ba6020bba5cbfda30c05461dc7c3fbcd2cdacc9a8e0da06a4ab","5bd9f4b3c1761346e83c33a15624151cea6a47eebca6eca82c575c9c13ba39d2","c06b7fb8745925a1d3b851754425fe5be00aaf5dacf1c5a9b41d9033c4bc5378","bcd48d3ee22372be9a88a639d4dd1a2dac17bc2de7482bad5f56928fd8beb9dc","1853e2265dd7d4ba60719789d88f00da5afc0ddb3348ddc8dbfd830bc2bcd1ec","9d978f8d63c357ed0aa5dc8ca45ed2f9ba3411bbc78151ec1c807415d7ef688f","09da05b5d222c46a5b5a994e2d644043333b83ec52e9c58245d8b87ad5ab91a2","9fcb0e2253a0692fea6566f53c1da8e7cc8d9b826e803f2bb480181f11dc7ab1","f786b76cc5be0fec703949e1c6380cedc9ba7ca3cf8cfb55225a3f8e95290d77","4a05407fa9a20fa2b60d94090810f0caf83399f46801d9eead6697ccf067f1fc","e1cae43d1d8e5400453ada2239266ceaef4cc1f0e28003b3761d5f8ecbf21c3b","1d475a10d1ab14e7c9bcf33ed186aef3e267ba58ee954b0ff388a1459df3988b","d992246a6b7b5720b1332f93b922166a63a935b59f3c89bc64cbe3c38977e8f2","557ee3c1fd57869ccdec37a646e6ab2ae29dd7aba1d93d19356a1a5cc47721ac","e4b2842de56fede4137bd6d6d6f99ec30ea938b84765f9ea8590b9a489bc10ce","543d7e08acf32b4cf8042a50387b104fe538c4409c11ee24fc1c4299be7de735","8f24f43b435708ff9781c4d367bbe44c0eebf67754202c5d9f16eb247a4a8ad0","60b4383c018d56215482d08cf2a158a071d3578b9739bfa332c79e7a56072b1e","102e3f708dbb878ea7aa25f3a718c814fd7958eb87befbea57d1eba775fafb0b"],"paragraph_range_zero_based":[144,167],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2310947.zip::R2-2310947.docx:p144"}
{"fields":{"filename":"R2-2310947.zip::R2-2310947.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"DL-TDOADownlink Time Difference Of Arrival","paragraph_zero_based":168},{"literal_text_all_w_t_and_m_t":"DMRSDemodulation Reference Signal","paragraph_zero_based":169},{"literal_text_all_w_t_and_m_t":"DRXDiscontinuous Reception","paragraph_zero_based":170},{"literal_text_all_w_t_and_m_t":"DTX Discontinuous Transmission","paragraph_zero_based":171},{"literal_text_all_w_t_and_m_t":"E-CIDEnhanced Cell-ID (positioning method)","paragraph_zero_based":172},{"literal_text_all_w_t_and_m_t":"EHCEthernet Header Compression","paragraph_zero_based":173},{"literal_text_all_w_t_and_m_t":"ePWSenhancements of Public Warning System","paragraph_zero_based":174},{"literal_text_all_w_t_and_m_t":"END OF FIRST CHANGE","paragraph_zero_based":175},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":176},{"literal_text_all_w_t_and_m_t":"START OF SECOND CHANGE","paragraph_zero_based":177},{"literal_text_all_w_t_and_m_t":"15.4Support for Energy Saving","paragraph_zero_based":178},{"literal_text_all_w_t_and_m_t":"15.4.1General","paragraph_zero_based":179},{"literal_text_all_w_t_and_m_t":"The aim of this function is to reduce operational expenses through energy savings.","paragraph_zero_based":180},{"literal_text_all_w_t_and_m_t":"The function allows, for example in a deployment where capacity boosters can be distinguished from cells providing basic coverage, to optimize energy consumption enabling the possibility for an E-UTRA or NR cell providing additional capacity via single or dual connectivity, to be switched off when its capacity is no longer needed and to be re-activated on a need basis, and other various techniques in time, frequency, spatial and power domains.","paragraph_zero_based":181},{"literal_text_all_w_t_and_m_t":"15.4.2Solution description","paragraph_zero_based":182},{"literal_text_all_w_t_and_m_t":"15.4.2.1Intra-system energy saving","paragraph_zero_based":183},{"literal_text_all_w_t_and_m_t":"The solution builds upon the possibility for the NG-RAN node owning a capacity booster cell to autonomously decide to switch-off such cell to lower energy consumption (inactive state). The decision is typically based on cell load information, consistently with configured information. The switch-off decision may also be taken by O&M.","paragraph_zero_based":184},{"literal_text_all_w_t_and_m_t":"The NG-RAN node may initiate handover actions in order to off-load the cell being switched off and may indicate the reason for handover with an appropriate cause value to support the target node in taking subsequent actions, e.g. when selecting the target cell for subsequent handovers.","paragraph_zero_based":185},{"literal_text_all_w_t_and_m_t":"All neighbour NG-RAN nodes are informed by the NG-RAN node owning the concerned cell about the switch-off actions over the Xn interface, by means of the NG-RAN node Configuration Update procedure.","paragraph_zero_based":186},{"literal_text_all_w_t_and_m_t":"All informed nodes maintain the cell configuration data, e.g., neighbour relationship configuration, also when a certain cell is inactive. If basic coverage is ensured by NG-RAN node cells, NG-RAN node owning non-capacity boosting cells may request a re-activation over the Xn interface if capacity needs in such cells demand to do so. This is achieved via the Cell Activation procedure. During switch off time period of the boost cell, the NG-RAN node may prevent idle mode UEs from camping on this cell and may prevent incoming handovers to the same cell.","paragraph_zero_based":187},{"literal_text_all_w_t_and_m_t":"The NG-RAN node receiving a request should act accordingly. The switch-on decision may also be taken by O&M. All peer NG-RAN nodes are informed by the NG-RAN node owning the concerned cell about the re-activation by an indication on the Xn interface.","paragraph_zero_based":188},{"literal_text_all_w_t_and_m_t":"15.4.2.2Inter-system energy saving","paragraph_zero_based":189},{"literal_text_all_w_t_and_m_t":"The solution builds upon the possibility for the NG-RAN node owning a capacity booster cell to autonomously decide to switch-off such cell to dormant state. The decision is typically based on cell load information, consistently with configured information. The switch-off decision may also be taken by O&M. The NG-RAN node indicates the switch-off action to the eNB over NG interface and S1 interface. The NG-RAN node could also indicate the switch-on action to the eNB over NG interface and S1 interface.","paragraph_zero_based":190},{"literal_text_all_w_t_and_m_t":"The eNB providing basic coverage may request a NG-RAN node's cell re-activation based on its own cell load information or neighbour cell load information, the switch-on decision may also be taken by O&M. The eNB requests a NG-RAN node's cell re-activation and receives the NG-RAN node's cell re-activation reply from the NG-RAN node over the S1 interface and NG interface. Upon reception of the re-activation request, the NG-RAN node's cell should remain switched on at least until expiration of the minimum activation time. The minimum activation time may be configured by O&M or be left to the NG-RAN node's implementation.","paragraph_zero_based":191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8d4901b891fbd4ddd84ab30e673a8dc5a4094da57e9e4b85dbb233c58abd62aa","original_member_sha256":"be142033f82c6755a6455392686a978e05ce304dac4a2fd05b9a253aaed7cdf3","paragraph_ElementTree_utf8_XML_sha256":["ea715f8a3f64fd60d5eccc98525c1e29c12a47119bd4b7077d3d95b032ac7b3d","2913d823592ec0c4095f561b8b51c478f43095bc4ddb88757f55d39115a7b8da","8cf5ca9db6000d1dd73c1502e767e405ce6e36d472d2ea302bbdd1e8d21c5bd9","035ae34e1e9c4e5e5691179779534bcb25995ab1091990e519d21e38431b97eb","50d6a9f8a25e232e4d57bda158243b74dafcb7413ef4b4310bc15cd9c3ee4f0d","9a8ec0dd80ef294c19c676d7c9bd3999a14fb81093cdac1b8d567d68e8de79ac","72af649ba196f0b95d1ad19d82856f801b454376c2da599e250cb206030e89a1","e48534c09c1c17cc9102d7a6e151385f4fbaec9ac33b0aaa4d8787d21e0e2651","e1218844b9780e29f57474931bb3b92a8745bc4e5482c4d9a2449c379db36667","dff4f4a0251648cf32a882619d148da3b44faa63b636da451a3f04b22e6f69f5","2ab7628ff19f3848dae69747919d0c59310772e51a3dfbb2bcd8e0650cb6f62c","d695b3ce0f67a135e1bc6b839f7eeb9b4c475944c680004281e3084be6ba30a0","9d03b05f13dbe0653d9b868b9149071056b91cd62c3d650686f3942005cd2575","46821c0f80140f89454fb4da92be3b82c8587fa17422fac8e4ce9ec2e897aaca","08bbe8e40fedc30ccd7673d85875aab3e38171ea7741dff9dfc93ad4cf2c9b8e","f24a0cffde95339be3c952709d498ea320924c41c24488e78ce9a08870ff1764","431cfacdf4c6b3dff92a0e0e643ccf7b23ecb63a55c696c6626fac0d395186d3","7279d2066edfe1a979153ce9c96870e52f655c2901ec2f0fe2d5f9dfb8a0e61d","c579bb482646a6f2431519a620fdc526397d502eefe41ea6784e3706a1470e50","10ccdbd986a830ea4441ecd89b610ea37bc945294a8baf7a8e77ba55bd76eca3","4cc481c2a10be4d838b8ee831e7eff3a3070d0aad815ebdc26951500fe122244","c5522c941e0fc8426bdb8115e6374d80046f6238a788704c0739d70495f9dcea","0ffcdf9e066ed9cbc66f4072d0c2fd8bb080c6b7868ff53449c75de067ae517d","6bd174606d595ca25e2750a7594a89c3b475a52fb1eab250b9f10e6566657fdf"],"paragraph_range_zero_based":[168,191],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2310947.zip::R2-2310947.docx:p168"}
{"fields":{"filename":"R2-2310947.zip::R2-2310947.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"15.4.2.x1Cell DTX/DRX","paragraph_zero_based":192},{"literal_text_all_w_t_and_m_t":"To facilitate reducing gNB downlink transmission/uplink reception activity time, UE can be configured with a periodic cell DTX/DRX pattern (i.e. active and non-active periods). The pattern configuration for cell DTX/DRX is common for the UEs configured with this feature in the cell. The cell DTX and cell DRX patterns can be configured and activated separately. When cell DTX is configured and activated for the concerned cell, the UE does not monitor PDCCH in selected cases or SPS occasions during cell DTX non-active duration. When cell DRX is configured and activated for the concerned cell, the UE does not transmit on CG resources or transmit a SR during cell DRX non-active duration. This feature is only applicable to UEs in RRC_CONNECTED state and it does not impact Random Access procedure, SSB transmission, paging, and system information broadcasting.  Cell DTX/DRX can be activated/deactivated by RRC signalling or L1 group common signalling. Cell DTX/DRX is characterized by the following:","paragraph_zero_based":193},{"literal_text_all_w_t_and_m_t":"-active duration: duration that the UE waits for to receive PDCCHs or SPS occasions, and transmit SR or CG. In this duration, the gNB transmission/reception of PDCCH, SPS, SR and CG, (FFS RAN1 agreements) are not impacted for the purpose of network energy saving; ","paragraph_zero_based":194},{"literal_text_all_w_t_and_m_t":"-cycle: specifies the periodic repetition of the active-duration followed by a period of non-active duration;","paragraph_zero_based":195},{"literal_text_all_w_t_and_m_t":"Active duration and cycle parameters are common between cell DTX and cell DRX, when both are configured;","paragraph_zero_based":196},{"literal_text_all_w_t_and_m_t":"Once the gNB recognizes there is an emergency call or public safety related service (e.g. MPS or MCS), the network should ensure that there is no impact to that service (e.g. it may release or deactivate cell DTX/DRX configuration). The network should also ensure that there is at least partial overlapping between UE’s connected mode DRX on-duration and cell DTX/DRX active duration, i.e. the UE’s connected mode DRX periodicity is a multiple of cell DTX/DRX  periodicity or vice versa.   ","paragraph_zero_based":197},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":198},{"literal_text_all_w_t_and_m_t":"Editor’s note: FFS on how to mention cell DTX/DRX on sections 10.2, 10.3 and 11.","paragraph_zero_based":199},{"literal_text_all_w_t_and_m_t":"15.4.2.x2Conditional Handover","paragraph_zero_based":200},{"literal_text_all_w_t_and_m_t":"The same principle as described in 9.2.3.4 applies to conditional handover in case the source cell is using a network energy saving solution, unless hereunder specified. In this case, the following additional triggering conditions are supported, upon which UE may execute CHO to a candidate cell, as defined in TS 38.331 [x]:","paragraph_zero_based":201},{"literal_text_all_w_t_and_m_t":"Editor’s note: FFS further updates on triggering conditions.","paragraph_zero_based":202},{"literal_text_all_w_t_and_m_t":"Editor’s note: FFS on how UE knows the source cell is using a network energy saving solution and whether this needs to be captured in stage 2.","paragraph_zero_based":203},{"literal_text_all_w_t_and_m_t":"Editor’s note: FFS if this clause could be merged with another clause e.g. 15.4.2.1.","paragraph_zero_based":204},{"literal_text_all_w_t_and_m_t":"15.4.2.x3Camping Restrictions","paragraph_zero_based":205},{"literal_text_all_w_t_and_m_t":"The access of NES Capable UEs to a cell is  controlled by a single bit in SIB1 (if present), otherwise the barring mechanisms described in clause 7.4 apply. The definition of NES capable UEs is FFS.","paragraph_zero_based":206},{"literal_text_all_w_t_and_m_t":"15.4.2.x4Inter-band CA SSB-less SCell","paragraph_zero_based":207},{"literal_text_all_w_t_and_m_t":"Editor’s note: FFS on content and whether a section is needed for inter-band SSB-less.","paragraph_zero_based":208},{"literal_text_all_w_t_and_m_t":"15.4.2.x5Spatial and power domain adaptation","paragraph_zero_based":209},{"literal_text_all_w_t_and_m_t":"Editor’s note: FFS on content.","paragraph_zero_based":210},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":211},{"literal_text_all_w_t_and_m_t":"15.4.3O&M requirements","paragraph_zero_based":212},{"literal_text_all_w_t_and_m_t":"Operators should be able to configure the energy saving function.","paragraph_zero_based":213},{"literal_text_all_w_t_and_m_t":"The configured information should include:","paragraph_zero_based":214},{"literal_text_all_w_t_and_m_t":"-The ability of an NG-RAN node to perform autonomous cell switch-off;","paragraph_zero_based":215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8d4901b891fbd4ddd84ab30e673a8dc5a4094da57e9e4b85dbb233c58abd62aa","original_member_sha256":"be142033f82c6755a6455392686a978e05ce304dac4a2fd05b9a253aaed7cdf3","paragraph_ElementTree_utf8_XML_sha256":["be5b0477ec322dd00a9663a71badee5ddd37e7d52d4cc62530c8f217104be131","214d5adcba312b0eee9bc490e0bf2c5e34b5da5b11811e9d270af9e1f0a84524","c0f2590635923febfe195208083f84ec160f5cf9477210b439c1e567e93a1749","fbc66f520ca80f9db76f33b7e54a1f0395c234f653e8f1d4f24ac323a71f255d","0e488c01548008e80533c7d9ff6413be179c3ca55138cebaab1ecb189fa710d4","9d862512de058ca113a72259fde5608ec3ad96700b7faa72bf765e5b331fde35","62b17642507917d0ec67ee1b637bc93ae1fc2cd0afab8ba5f9002d9224010099","5d1ac7e7effa3a0b64b9b2b99b0014a58e63aa957c4a4bb51944c90082c5fa76","811de2ebf6a51b84bd2ce7e1e38bcc983453346ac8f0781c510de12a45dc5173","5fb69a203ed94ffe17198fe616266bca795ac3bc10c997871f745e06284ac6b4","2c200b584de26ae21b27f8c78894f743b3fbdacb8bfcbdf915f4b9626481e5d1","330bc46ca720384d0761cac11262f58520463687c434b84789bc83c87940ae08","d19885d90121d854b5f95d7b191074796bcc13869faafe05fd71d2d00b8871b8","2499bd3035ca820e4f3664fd199c976355f7395d8b4996d0224236a76a680e03","3fecf749af8c9f514ebd292b595ac87716c11bd40eb9d3d37cc0781fc1969b0c","b6574e3b58a4bb06a88b88d0cd882989cfa7123cb6dd637117b8c4841a339574","f8981fa2f30479e21d1fa57370fc8ba7e2c51075e31f22457857792f42e809dc","8c5badf408880f7180cc059f465336088fea1b27078198e9edaaa0f4d5b6b1ad","733c45e45cc32ea860643ab23f9d1659d7c5fd1b77d0e75ed31acbede1708f98","263e69b5c9b0dfb6713555c746729451e019e52f4003513b7c402974e15c6ba7","ed4b59274f6246e78eba146f2caba770ee30e9307028cf837c576b5a0ba25941","92b8f4c4c9ce1cb9fde466f843638dda96f668220e705fdf1efd496ecf705792","19c5bdcd917da17fba84754fcfc0e6ceb3f292134796890a6adf7a5f10373b11","636829aad131561f06850196c863f42e61f4e63163c777862cde234925591e35"],"paragraph_range_zero_based":[192,215],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2310947.zip::R2-2310947.docx:p192"}
{"fields":{"filename":"R2-2310947.zip::R2-2310947.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-The ability of an NG-RAN node to request the re-activation of a configured list of inactive cells owned by a peer NG-RAN node.","paragraph_zero_based":216},{"literal_text_all_w_t_and_m_t":"O&M may also configure:","paragraph_zero_based":217},{"literal_text_all_w_t_and_m_t":"-policies used by the NG-RAN node for cell switch-off decision;","paragraph_zero_based":218},{"literal_text_all_w_t_and_m_t":"-policies used by peer NG-RAN nodes for requesting the re-activation of an inactive cell;","paragraph_zero_based":219},{"literal_text_all_w_t_and_m_t":"-The minimum time an NG-RAN node's cell should remain activated upon reception of a re-activation request from an eNB.","paragraph_zero_based":220},{"literal_text_all_w_t_and_m_t":"END OF SECOND CHANGE","paragraph_zero_based":221},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":222},{"literal_text_all_w_t_and_m_t":"Annex: RAN2 Agreements","paragraph_zero_based":223},{"literal_text_all_w_t_and_m_t":"RAN2#121","paragraph_zero_based":224},{"literal_text_all_w_t_and_m_t":"Agreements ","paragraph_zero_based":225},{"literal_text_all_w_t_and_m_t":"There will be no impact to RACH, paging, and SIBs in idle/inactive for both gNB and Rel-18 and legacy UEs","paragraph_zero_based":226},{"literal_text_all_w_t_and_m_t":"Rel-18 NES capable CONNECTED UE(s) can perform RACH and receive SIBs in non-active duration of cell DTX and/or DRX (i.e., same behavior for cell DTX and cell DRX).  No further enhancements for CBRA and CFRA will be pursued.","paragraph_zero_based":227},{"literal_text_all_w_t_and_m_t":"Pattern configuration for cell DRX/DTX is common for Rel-18 UEs in the cell.   FFS whether we have DTX UE specific inactivity timer .  FFS on configuration signaling and stage 3.  ","paragraph_zero_based":228},{"literal_text_all_w_t_and_m_t":"Confirm study item agreement that we can have separate DTX and DRX configuration.   We will focus on designing DTX/DRX for at least single configuration.  FFS whether multiple configuration of cell DTX or DRX will be supported.  ","paragraph_zero_based":229},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":230},{"literal_text_all_w_t_and_m_t":"Agreements:","paragraph_zero_based":231},{"literal_text_all_w_t_and_m_t":"RAN2 confirms that non-NES UEs can access to NES cells if NES solution is backwards compatible","paragraph_zero_based":232},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":233},{"literal_text_all_w_t_and_m_t":"Agreements:","paragraph_zero_based":234},{"literal_text_all_w_t_and_m_t":"Study whether CHO enhancements are needed for the purpose of turning off the cell","paragraph_zero_based":235},{"literal_text_all_w_t_and_m_t":"Continue discussing CHO in the context of different NES techniques.  ","paragraph_zero_based":236},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":237},{"literal_text_all_w_t_and_m_t":"RAN2#121bis-e","paragraph_zero_based":238},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8d4901b891fbd4ddd84ab30e673a8dc5a4094da57e9e4b85dbb233c58abd62aa","original_member_sha256":"be142033f82c6755a6455392686a978e05ce304dac4a2fd05b9a253aaed7cdf3","paragraph_ElementTree_utf8_XML_sha256":["b550aa12c1af3c87eb28186700d25767a380b6e56106ba7a63c5aabac40371c3","ff0322958b7dda452470dea926256d37b4ce42c0a8b529dfe8cd4fef8806ef74","2ff6733fcdf922beefb74faebd3ed9d9e7c4e3f11f51ec4b3d511e43146e3254","565314aa0814fa5b1a298a42ff26cbe0528615e33c436988a6df6ac567ea7b7a","f73fcca8d9616d6ce28780d679c8dec3cd22f0ba01daf242a043f6274cfe6db6","02f0c1a77c68b4e38ea169cff8cc5e6ce7e2a6ce1c38277bbbe3b2ff56f1757e","74969ae80f358d9729c0d57866c404ec22fd700b77fb45104d8f35393581823b","0ffc70ea9a45687cdb53c673cf45a525bc1dc8b7acbb8b557f7af3dc694f2653","32bdc6a628adca68f1850f2024bbc46e4912e814ddaeadf84f7cc065fa2500a5","07b3a25ffd6225181a914ee3c1fb69e1b76e213d48fca490d6d8b20509c913ad","63107e51c976fbf6ab041483a80dd24073f2016cc308ee0d6c498f605b1912e0","ac61b3916e567077207901a28838460e93c6a6e54511c0be36432a93cbc5c894","7ed24f4bcdd5e3baee4a5b21d83514046802deaf06b8642d327395ad9a38439d","1a726b1a3a0d2804de73c0ee974b8f1be5ad3b2a854ba1892234aa1b32fefcd9","4c651ea340504e59379abd382fe7bd2fcf4ee63bcabf820a9e109613a75cb203","05d2ce5617626edef606830dc3e8e872d766e50682ddb10e9460df863a431329","2d0ef568b70fa6c4913391f4ba34dba810c94ce04ee7a49344da510f73af173f","4338cf45333156d2f0bb8bbdacc5f5063e4516697e5ba9ce05f802a9b75ccc81","09c61ce7c17499dbc1e399fdc8f91060fa96ef5b6cb3b3cfa9a3939ae5ea8924","d56b763ceacc671f7f60b3e17ec3889cc5d6172f3f11917a346eba8454b84f43","d70e78ef7fc9ec78b1e6fa0d88eddde6a7e6e9856adeec24697659765afc483b","0976b2084d305ed0f6a70afb905f09b303bb4eac5f4b1c53e1f2d92cc5bf79ab","cb9a06b852158e25ea2d030acac0b1b8c89d94ab9f26c4e29d7ca66fec1e60ac","55f7b28d6e60c86eb2e74ff9131b69e8e689f5db014adb830a05212c3296c394"],"paragraph_range_zero_based":[216,239],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2310947.zip::R2-2310947.docx:p216"}
{"fields":{"filename":"R2-2310947.zip::R2-2310947.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":240},{"literal_text_all_w_t_and_m_t":"Agreements ","paragraph_zero_based":241},{"literal_text_all_w_t_and_m_t":"A periodic cell DTX/DRX configuration is explicitly signalled to the UEs. ","paragraph_zero_based":242},{"literal_text_all_w_t_and_m_t":"A periodic cell DTX/DRX pattern is configured by UE specific RRC signalling. ","paragraph_zero_based":243},{"literal_text_all_w_t_and_m_t":"The Cell DTX/DRX configuration contains at least: periodicity, start slot/offset, on duration. ","paragraph_zero_based":244},{"literal_text_all_w_t_and_m_t":"As a baseline Cell DTX/DRX is activated/deactivated implicitly by RRC signalling, i.e. activated immediately once configured by RRC and deactivated once the RRC configuration is released. ","paragraph_zero_based":245},{"literal_text_all_w_t_and_m_t":"From RAN2 point of view, majority companies see a benefit with L1 signalling for Cell DTX/DRX activation/deactivation, send a LS to RAN1 (email 308) with our preference and ask about feasibility and design details.   Ask about feasibility and reliability of using L1 signaling.  Clarify that the question is about activation/deactivation copy the agreement from last meeting that we are focusing on single configuration.  Extract a few key benefits of dynamic signaling from email discussion and online discussions","paragraph_zero_based":246},{"literal_text_all_w_t_and_m_t":"As baseline, UE doesn’t monitor SPS occasions during Cell DTX non-active period. As baseline, gNB is assumed to be not transmitting PDSCH to that UE on such SPS occasions during the Cell DTX non-active period","paragraph_zero_based":247},{"literal_text_all_w_t_and_m_t":"As baseline, UE does not transmit on CG occasions during Cell DRX non-active periods","paragraph_zero_based":248},{"literal_text_all_w_t_and_m_t":"As baseline, UE does not transmit SR occasions overlapping with Cell DRX non-active periods, e.g. SR transmissions are dropped during the non-active period ","paragraph_zero_based":249},{"literal_text_all_w_t_and_m_t":"FFS: whether we will allow to configure the UE per SR configuration with whether SR can be transmitted during Cell DRX non-active period to to support high priority traffic ","paragraph_zero_based":250},{"literal_text_all_w_t_and_m_t":"(for the SRs that will be dropped) If SR is not to be transmitted on an PUCCH occasion during Cell DRX non-active time, the UE keep the SR pending, i.e., the UE delays the SR transmission till the Cell DRX active period without triggering RACH.  For the FFS case there may be some exceptions.  ","paragraph_zero_based":251},{"literal_text_all_w_t_and_m_t":"The understanding for the gNB scheduling behaviour for new transmissions during Cell DTX non-active period is that the gNB does not schedule UE-specific dynamic grants/assignments, even if the UE is in C-DRX Active Time.   UE doesn’t monitor PDCCH for dynamic grants/assignments for new transmissions during Cell DTX non-active period, even if the UE is in C-DRX Active time.   FFS how to deal with any exceptions (e.g. SR if agreed and RACH).  ","paragraph_zero_based":252},{"literal_text_all_w_t_and_m_t":"FFS how to deal with retransmissions","paragraph_zero_based":253},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":254},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":255},{"literal_text_all_w_t_and_m_t":"Agreements","paragraph_zero_based":256},{"literal_text_all_w_t_and_m_t":"-RAN2 agree to make enhancement in CHO procedure based on that the source cell entering “NES mode”.  FFS further details","paragraph_zero_based":257},{"literal_text_all_w_t_and_m_t":"-For source cell CHO framework, RAN2 assumes a reference scenario where the UE has already performed CHO conditions evaluation by the time the source cell starts some “NES-mode”","paragraph_zero_based":258},{"literal_text_all_w_t_and_m_t":"-As a baseline, UE initiates CHO evaluation upon receiving the CHO configuration.  FFS what trigger is used for execution of CHO","paragraph_zero_based":259},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":260},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":261},{"literal_text_all_w_t_and_m_t":"RAN2#122","paragraph_zero_based":262},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8d4901b891fbd4ddd84ab30e673a8dc5a4094da57e9e4b85dbb233c58abd62aa","original_member_sha256":"be142033f82c6755a6455392686a978e05ce304dac4a2fd05b9a253aaed7cdf3","paragraph_ElementTree_utf8_XML_sha256":["7e38bc76b63bc82eb0b7a99d6f70e486694df61a1d269dc5415156304856531e","28627aa71931af9b61b48415e1588df33c276e79b8ec3eb901cb62026a723e2d","9391062b8420ea9e7b9fe4f290e857891286d51b8be43f21e96e48079fbc43a4","d18e3bddb584d1e4fcb3590861eeb02aa08254b0ef4e5c0315b6a7ff5c1aedfa","091a1a72c995f9b3f6dbd0e4493da8851bf66636046da825288af7ce55ad1ab4","a5f290d286c9c60e7e193c72bb26da826fcebf8524530cf19033fc8b2fabef5c","a5819ea0fbc5359edf2c71530cd18d78cb58787cee9ad6183aa4e87066e01dd5","4742850c81f53b6c47c09ed8799e259dc6947f4ed9d820c70196048e6805fbc7","08b3bcee95cb14c24560feef1b042d1ede07b1b78cbc2543997d1db7fe0e34f5","2fe611d208a2d3fefcce3573f3edc64f74f695561080ce2f0fd004b7cd53c2dd","e749cadb4e46921ef5e2f556cf561621437305831b3e31dad08c54d88b5818fd","539341f49c7b573f07fc9dacab5d147fa2441563d1821f65055d9e934957f3b1","8848bd303b800f480a1330f32dc95ad5c6d9dc10342a07188c85f5f002565f38","3a2f8ac227b253baf98a82ff8e37e4ebbbf3694694e5db337db1a5bdeb91d1d9","34281396065335f09cd03005c477806c831d6c08024d4b7a21f19fba3fe8bcfc","978e6a757fe46e66a87465bcd47a3a5a2c48d5167806de644e92d3522eed8471","fb0aa829ab1c56e0982652c1ea88cab181ef932244599db363237205932293f3","0b896e81c61d6f35ada6bcda7a4d1c4ad2d7234d8358236af0009947f1316274","b7cfa939a82081f9e328265e5eae4e5a6b092407514bd0a912b14761ac8b9f4c","0a77bc31ab2482a34055b255c66e02973fb99a666ee38acf25d65f41e18bcc85","c702b1fb0c6582a8caef6aa8108f6ff46930a779858289e7c97f34d481380736","68febbfb9c0a9c8d18b05e14e620986dd2eb135fe06a221f9657d97f5d586f67","2ce837b00ddb64de30b3c81612f1fa3f61a8cff1dc94417278ee839f9cd270c7","dc6722595b593928d81a7b8bca6d43ce146a5bf0e18431c69f4180b054fdc8f5"],"paragraph_range_zero_based":[240,263],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2310947.zip::R2-2310947.docx:p240"}
{"fields":{"filename":"R2-2310947.zip::R2-2310947.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Agreements:","paragraph_zero_based":264},{"literal_text_all_w_t_and_m_t":"1UE monitors PDCCH for RAR during Cell DTX non-active time. The ra-ResponseWindow could be started as legacy.","paragraph_zero_based":265},{"literal_text_all_w_t_and_m_t":"2UE monitors PDCCH for msg4 during Cell DTX non-active time. The ra-ContentionResolutionTimer could be started as legacy.","paragraph_zero_based":266},{"literal_text_all_w_t_and_m_t":"3Working assumption:  When the retransmission timer is running (if C-DRX is configured), the UE is expected to monitor PDCCH, like in legacy.  It is up to the network whether it schedules retransmissions out of the Cell DTX active period, i.e., when the DRX retransmission timer is running, the UE should monitor PDCCH regardless of the Cell DTX.   ","paragraph_zero_based":267},{"literal_text_all_w_t_and_m_t":"4Once gNB recognizes there is an emergency call or public safety related service (e.g. MPS/MCS), the NW should ensure there is no impact to the emergency call (e.g. may deactivate Cell DTX/DRX).  The behavior is captured in stage 2 spec","paragraph_zero_based":268},{"literal_text_all_w_t_and_m_t":"5When an DG grant is received, by the gNB during cell DRX/DTX, the UE follows the grant assignment (i.e. like in legacy).  This includes DL HARQ feedback.  ","paragraph_zero_based":269},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":270},{"literal_text_all_w_t_and_m_t":"Agreements:","paragraph_zero_based":271},{"literal_text_all_w_t_and_m_t":"If RAN4 conclude SSB-less SCell for inter-band CA for FR1 and co-located cells is feasible, the signaling of intra-band CA (including RRC change on timing of SSB-less SCell and capability signaling) can be considered as its baseline. Whether other new signaling is required depends on RAN4 input.","paragraph_zero_based":272},{"literal_text_all_w_t_and_m_t":"If RAN4 concludes it is feasible, RAN2 can further work on at leaest the following specification impacts:","paragraph_zero_based":273},{"literal_text_all_w_t_and_m_t":"-RRC configuration of the frequency of the SSB to be used for the UE to obtain the timing reference for the inter-band SCell.","paragraph_zero_based":274},{"literal_text_all_w_t_and_m_t":"-UE capability reporting to indicate whether UE supports configuration of inter-band SCell that does not transmit SS/PBCH block.","paragraph_zero_based":275},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":276},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":277},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":278},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":279},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":280},{"literal_text_all_w_t_and_m_t":"Agreements:","paragraph_zero_based":281},{"literal_text_all_w_t_and_m_t":"We will define UE capabilities with signaling.  Details are FFS and will be discussed later during the WI phase.  ","paragraph_zero_based":282},{"literal_text_all_w_t_and_m_t":"Separate camping restrictions for NES-capable and non-NES UEs will be defined.  FFS if it is a single bit or more.   ","paragraph_zero_based":283},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":284},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":285},{"literal_text_all_w_t_and_m_t":"Agreements","paragraph_zero_based":286},{"literal_text_all_w_t_and_m_t":"1.We will have a CHO solution that considers NES mode of at least source cell.  ","paragraph_zero_based":287}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8d4901b891fbd4ddd84ab30e673a8dc5a4094da57e9e4b85dbb233c58abd62aa","original_member_sha256":"be142033f82c6755a6455392686a978e05ce304dac4a2fd05b9a253aaed7cdf3","paragraph_ElementTree_utf8_XML_sha256":["7224feddc0ea9faa4b77a0ad255087c9c79713be48843681c185063d1d6efbf6","97be840a7700e9c7e3e3c3bf1167b04a73e32fa9ee378f4b62f446e2315de674","5967f83aa06995a25793e3fe95bf766fd341413bedb5c4c1c4ec64b1a5c566c3","b6d705fd7fe72cdd0ea0a4dc3dd3228d8235ee1572b26d0627c0785411bdf342","296afbf7a3df4c18d5eb8784dfb229c5c0f948c9769e3aab26e6e715f84bc712","cbb8056e1a217d1d4a4c63f61ad8c108b38a9d9250b8d15d6ec275cf17a38d6d","5bb24263b556cd72a6c9660d86ff37a7421527ffe438b35be93d421d5937aa93","cf9da81a1c42b6a547d72367f4eca7901039abcd4698528be7541348ccad71a5","c855d3ee3c631b1a9056975f18d65b54ad00de149f0e8b88ffb33d907cc70712","8d64c0b52460074ae7fb4f23fe58f142d720f63806b67ee14d9f0a0223e4493f","a1ae2ac7b741f06fd333541a5e57d45a44bbaf6a77ac167794757e5e6a8dce5b","9100d53c8e0d2b7f73212533c2278cb74a2c55955760a7e32cc2ed5752493ace","9f539656711e18e0867761b846eda3a8a268b5965b6779641a87a547aa2ad7c3","50dbe1592a799c2530bf019c10d8fdd1a92d94747d404178ea95dc8611f08f11","b7f39a47acd936ecb0ffc46dff81e240751923c64bb0c434168d151d5d29af61","f5c791059e284994ef0ad7cb7f8e2b051dff8ace1662379f50344c4dff8e2698","7a884010e7afc2cf2e2b868bc72d706539aaac8f90e5324591ac42a8befd9776","14eb69a96d736ef535c2591955a0eeccdc8ed875673371222913b04f65ab0a3f","b1da92322a5e19bb95d414403b5dd05f3cc59f0aa1c7c6d35c664b45df62647f","e9c80aa301e53b537b9d98de1553364405b304705323e8fafb9067a19759fba4","0112d93bcbc584e366636f7a277542bed317fa38bda621b4365d7cd45204cd24","4e3c441fcbece5f9075031f3afd69e3a331a08de21d77958ff7ef817b54cbc62","e3b5f8fba985781124980c9b0154ab8feff9c46f61d1974534fb2b38a4e05ccc","a093afaeb024b57270b8bf404ad21dddc89132db79601fbd69c5d1eeb13a082c"],"paragraph_range_zero_based":[264,287],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2310947.zip::R2-2310947.docx:p264"}
{"fields":{"filename":"R2-2310947.zip::R2-2310947.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2.We can have a specific NES CHO execution condition based on source cell NES mode.   FFS how the UE determines is in NES mode.   FFS on how this is achieved in RRC","paragraph_zero_based":288},{"literal_text_all_w_t_and_m_t":"3.We will not introduce new L1 signalling for the purpose of CHO","paragraph_zero_based":289},{"literal_text_all_w_t_and_m_t":"4.Event A3, A4, A5 can be configured as a CHO execution condition in the NES scenario.   We will study the time based mechanism","paragraph_zero_based":290},{"literal_text_all_w_t_and_m_t":"RAN2#123","paragraph_zero_based":291},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":292},{"literal_text_all_w_t_and_m_t":"Agreements:","paragraph_zero_based":293},{"literal_text_all_w_t_and_m_t":"1Activation/deactivation is per serving cell.  FFS if the configuration is per cell or per MAC entity ","paragraph_zero_based":294},{"literal_text_all_w_t_and_m_t":"2RAN2 will reuse the start timer formula of the onDurationTimer from UE C-DRX (including SlotOffset) to specify the start of cellDTX-onDurationTimer (and cellDRX-onDurationTimer) in 38.321.","paragraph_zero_based":295},{"literal_text_all_w_t_and_m_t":"3The gNB should ensures that there is at least partial overlapping between UE C-DRX on-duration and cell DTX/DRX on-duration.  It is up to network implementation to ensure the alignment.  We will capture this in stage 2 specification.  ","paragraph_zero_based":296},{"literal_text_all_w_t_and_m_t":"Understanding is that alignment means that the cell DTX/DRX and C-DRX periodicity should be multiple of each other.   FFS if we anything needs to be specified in stage 3 (i.e. in IE description)","paragraph_zero_based":297},{"literal_text_all_w_t_and_m_t":"4As a baseline legacy C-DRX reconfiguration is used to change UE C-DRX configuration once Cell DTX/DRX is activated/deactivated.","paragraph_zero_based":298},{"literal_text_all_w_t_and_m_t":"5RAN2 specifies cellDTX-onDurationTimer (and cellDRX-onDurationTimer) to have the same value range as UE C-DRX on-duration timer. ","paragraph_zero_based":299},{"literal_text_all_w_t_and_m_t":"6RAN2 specifies cellDTX-Cycle (and cellDRX-Cycle) to have the same value range as UE C-DRX Long cycle. ","paragraph_zero_based":300},{"literal_text_all_w_t_and_m_t":"7Separate DTX and DRX configuration means that the features can be enabled separately (i.e. Cell DTX can be configured without Cell DRX)","paragraph_zero_based":301},{"literal_text_all_w_t_and_m_t":"8On-duration and Cycle parameters are common between cell DTX and DRX, when both are configured.  FFS if we have different start offset configuration for cell DTX and cell DRX","paragraph_zero_based":302},{"literal_text_all_w_t_and_m_t":"9RAN2 will not introduce a MAC CE for cell DTX/DRX (de)activation.  ","paragraph_zero_based":303},{"literal_text_all_w_t_and_m_t":"10Confirm working assumption, when the retransmission timer is running (if C-DRX is configured), the UE is expected to monitor PDCCH, like in legacy.  It is up to the network whether it schedules retransmissions out of the Cell DTX active period, i.e., when the DRX retransmission timer is running, the UE should monitor PDCCH regardless of the Cell DTX.","paragraph_zero_based":304},{"literal_text_all_w_t_and_m_t":"11We focus on the case where DTX in RRC can only be configured when C-DRX is configured.  We will not optimize for the case where C-DRX is not configured.","paragraph_zero_based":305},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":306},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":307},{"literal_text_all_w_t_and_m_t":"Agreements","paragraph_zero_based":308},{"literal_text_all_w_t_and_m_t":"-One single bit in SIB1 is introduced for controlling all “NES-capable UEs” to access a cell.  FFS what “NES capable UE” bit means.  The NES UE always follows the NES bit used for barring, if present.  If not present the UE shall follow legacy barring.  ","paragraph_zero_based":309},{"literal_text_all_w_t_and_m_t":"-No new cell baring techniques for non-NES UEs will be specified.  ","paragraph_zero_based":310},{"literal_text_all_w_t_and_m_t":"-No new cell re-selection techniques will be considered in this Rel-18","paragraph_zero_based":311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"8d4901b891fbd4ddd84ab30e673a8dc5a4094da57e9e4b85dbb233c58abd62aa","original_member_sha256":"be142033f82c6755a6455392686a978e05ce304dac4a2fd05b9a253aaed7cdf3","paragraph_ElementTree_utf8_XML_sha256":["aaa6ad2dde4ca3357d8d77eb25e62cd2be63ef83c10f494648c239bac280d617","58d19d2226b3e20d149d847778fb79e864ca2622fdf00b838096ad0e37bbb994","415d89acb0d4bdbc43b6f1fdc4d4e5580a8dc572e2dae429a9beb28ea206011a","788a52ec2601bde0303fb9f56a46c799050a8a936f6dbda79651550778f23761","97b006303acd215c4533ed2a4226b18aa3a3dd98e5e59aaa996e2c0180c55911","2182bac00a5a9d0e9c50640cab5109d3918266ad048a9163b2a393ab157acaa9","362e961443652dec5eaaef075c1d4907f7da1ed9c75a1942ed190bd4f135d1d1","87368434afa0ffdf992e6cc71f53ba13690867acc56705cd2205c05e34fd692f","5fe35c7b1a9099d9598b64d7bc9d288707b4277fd6fca8afe75e4c8e67dec0b1","373110ec0721f6d529cb0504f437e21f41a2379a1803ac7b0367572620d48dc7","f546cbf7f89b336b5b69a736e7c2af5cb12ea73d3df828011947709ec2175490","d15bb290ee52f615f0f400d51ec2960ac4b561157114f61149558ce626b5aa9d","4b87686ca568b7bef317f1bd5d5b77faf6f0f54f39c27fb23f4cb96122605f37","ca099f4619d81f3927835e4612ec4be3872f26d9e3e659711ddef44a348957c7","e7ab314055050b9c596e9483a92f3c81d227d263acf7a027d1a181a77756366e","c8b7b278a35a86e3ff5c7e98432de51de75d6cc9897043548d9a43064cdba8cd","7e23564077fcb70df2f1297a21951291484f56c47741e3dc0d5ddb125a8746e8","c0e4274a96d1b159ca56a95f150e3e9262151eba55be7238aa3057e22a6ead22","2c955e8f1ff1bd19e09f7b7f0d274dcc20a43