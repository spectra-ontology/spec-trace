","32f6d5e95b7449d4da9c6c0ab156dca62fa04727b9c4a9b454580640654b4297","f53155f6e0bbac9463408a4d95f2daaeaab96744850202e6b14071ffad4fb624","55aa25bf4b0f60256bd15e588b2599af09c4a0115a78ef8d3d2c8e0ae9abc996","ff92dd6bdcd84d8f76525446770d1300a24da012d4010dc41f60873439db16a3"],"paragraph_range_zero_based":[264,287],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2301431.zip::R2-2301431 Orbit and Tropo.docx:p264"}
{"fields":{"filename":"R2-2301431.zip::R2-2301431 Orbit and Tropo.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"},","paragraph_zero_based":288},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":289},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":290},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":291},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":292},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":293},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":294},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":295},{"literal_text_all_w_t_and_m_t":"Tropo","paragraph_zero_based":296},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if tropospericDelayCorrection is included in gridList. Otherwise it is not present.","paragraph_zero_based":297},{"literal_text_all_w_t_and_m_t":"NotProvidedForOther","paragraph_zero_based":298},{"literal_text_all_w_t_and_m_t":"This field is not present if the tropospericDelayCorrection is provided for another GNSS in the same epoch","paragraph_zero_based":299},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":300},{"literal_text_all_w_t_and_m_t":"GNSS-SSR-GriddedCorrection field descriptions","paragraph_zero_based":301},{"literal_text_all_w_t_and_m_t":"epochTime","paragraph_zero_based":302},{"literal_text_all_w_t_and_m_t":"This field specifies the epoch time of the gridded correction data. The gnss-TimeID in GNSS-SystemTime shall be the same as the GNSS-ID in IE GNSS-GenericAssistDataElement. ","paragraph_zero_based":303},{"literal_text_all_w_t_and_m_t":"ssrUpdateInterval","paragraph_zero_based":304},{"literal_text_all_w_t_and_m_t":"This field specifies the SSR Update Interval. The SSR Update Intervals for all SSR parameters start at time 00:00:00 of the GPS time scale. A change of the SSR Update Interval during the transmission of SSR data should ensure consistent data for a target device. See table Value of ssrUpdateInterval to SSR Update Interval relation in IE GNSSSSROrbitCorrections.","paragraph_zero_based":305},{"literal_text_all_w_t_and_m_t":"iod-ssr","paragraph_zero_based":306},{"literal_text_all_w_t_and_m_t":"This field specifies the Issue of Data number for the SSR data. A change of iod-ssr is used to indicate a change in the SSR generating configuration. ","paragraph_zero_based":307},{"literal_text_all_w_t_and_m_t":"troposphericDelayQualityIndicator","paragraph_zero_based":308},{"literal_text_all_w_t_and_m_t":"This field specifies the quality indicator of the tropospheric delay. The troposphere quality indicator is represented by a combination of CLASS and VALUE. The 3 MSB define the CLASS with a range of 0-7 and the 3 LSB define the VALUE with a range of 0-7. The troposphere quality indicator is computed by:","paragraph_zero_based":309},{"literal_text_all_w_t_and_m_t":"SSR Troposphere Quality [mm] ≤ 3CLASS1+VALUE4-1  [mm]","paragraph_zero_based":310},{"literal_text_all_w_t_and_m_t":"See Table 'Relationship between SSR troposphere quality and URA indicator and physical quantity' below.","paragraph_zero_based":311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"402880a9d8f08f91fe24b048856b9780e089d79cd12536aba800d266be1e632a","original_member_sha256":"7cb6fb3149876999a30042fc450d0b566e79a928f6263bf65b46f1ac1a712180","paragraph_ElementTree_utf8_XML_sha256":["7075ce140ab96313cc8268a41972217b8f3f056899286c728bdd27ea079d286b","aa338194d4c3f0112d232bb3d0c71488fe4dc5b4185c5b2c55c939a9952b78ef","3e10694b7126da6564e8179bc82f65eb3dc6c7471a64328acc90173c8aa45e60","03347d754bd897fc83b8330b0b550aef465b79e9e0a5e94e1d762c863df1fe9a","9aaf8194230b6f2795f305c340501de9b05b96bbd187cd647be6beafb33000d2","2dfee8263d99942b2b589d47827c4c4b1c1252b437090e5eefcae8b5cce0afd4","975a0c6e90179f9c83b2d4c232095f11b08d0d301d009f65ec91cccb745ef4ba","7ce65a24da828927c269c2ea8116da91156d87cc20964f064494cfcc24cd600d","b1f26e41c75bd657451ab37896f451c86bee532a1b7fe0dde1cf88011e6ee51c","a801af7406b99cf326f4c518785816b88fef85165a4d99878d457624f20eadcb","faed5fdcc961c94a92dc710b9339afe065ac1a035dd0a7eb8bd482bfabf9c9b7","ae3dba7bf47f89bb136eff650b90d9e7cbd5a92f7ae196ae45e0ef24d6e9fc88","a676567e1c819a316987a0eb41515a0aee9a6f3e8e61fe119118f50d927c7277","1fa7bb8975298f85020c5985e991de0499cf50cc619ab607c72aa6ec03c2db61","7c9a0da6ad2e9f9cb3c2ad15cd8be5643b3cb4084695b6217be360ea3fc08790","d257b949cb8330079f6385e4aee7a9fc767a27bdacc2e121e421f9240ac08295","e74ac066f3c786f747cd9842c3f03ab07c1d568e889980cac626fadf36e12fda","665882d927beed9cb883d8bca25ea85b3b39a2325e7b62106783f71d53c76753","e9ceaa99084381dc5270931757c8da7e303fe82943db6d8dbfa993fbb19a2a98","2b5067e4b7c8df8157ef7f95d290112da9b58d5e0a7bd366cd59ea800f166228","6ef471a08019c9fd0cd3a1c4ce259056e41b89cbeb81d4dcfdfc1ccbe8e58bf5","42bcf62d99f7923bbceb4b710e49e435e0fc6622f9b2b2aae1dba21f974587a8","86f700bfb6d79db2825a11a50eaca0036b1721f9a8ba7a9eb6da84c80f788d49","47cc467fcfe3f50a0f9422295f035d4014cf78d1c30c06df89a1c03d71b89049"],"paragraph_range_zero_based":[288,311],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2301431.zip::R2-2301431 Orbit and Tropo.docx:p288"}
{"fields":{"filename":"R2-2301431.zip::R2-2301431 Orbit and Tropo.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"correctionPointSetID","paragraph_zero_based":312},{"literal_text_all_w_t_and_m_t":"This field provides the ID of the GNSS-SSR-CorrectionPoints set. The GNSS-SSR-GriddedCorrection are valid for the correction points provided in IE GNSS-SSR-CorrectionPoints with the same correctionPointSetID.","paragraph_zero_based":313},{"literal_text_all_w_t_and_m_t":"gridList","paragraph_zero_based":314},{"literal_text_all_w_t_and_m_t":"This field provides the troposphere delay correction together with the residual part of the STEC corrections for up to 64 correction points defined in IE GNSS-SSR-CorrectionPoints.","paragraph_zero_based":315},{"literal_text_all_w_t_and_m_t":"If the IE GNSS-SSR-CorrectionPoints, which belongs to the correctionPointSetID, includes the listOfCorrectionPoints, the gridList includes the same number of entries, and listed in the same order, as in the listOfCorrectionPoints.","paragraph_zero_based":316},{"literal_text_all_w_t_and_m_t":"If the IE GNSS-SSR-CorrectionPoints, which belongs to this correctionPointSetID, includes the arrayOfCorrectionPoints the gridList includes the same number of entries, and listed in the same order, as defined by the enabled bits in the bitmaskOfGrids.","paragraph_zero_based":317},{"literal_text_all_w_t_and_m_t":"tropospericDelayCorrection","paragraph_zero_based":318},{"literal_text_all_w_t_and_m_t":"This field specifies information element with the troposphere vertical delay components. It is only provided with at most one GNSS constellation, and if provided it is valid for all GNSS constellations. If it is provided with a different GNSS constellation the field is not provided with other GNSS constellations for the same epoch.","paragraph_zero_based":319},{"literal_text_all_w_t_and_m_t":"tropoHydroStaticVerticalDelay","paragraph_zero_based":320},{"literal_text_all_w_t_and_m_t":"This field specifies the variation in the hydro static troposphere vertical delay relative to nominal value. The target device should add the constant nominal value of 2.3 m to calculate the tropospheric hydro-static vertical delay.","paragraph_zero_based":321},{"literal_text_all_w_t_and_m_t":"Scale factor 0.004 m; range ±1.02 m.","paragraph_zero_based":322},{"literal_text_all_w_t_and_m_t":"tropoWetVerticalDelay","paragraph_zero_based":323},{"literal_text_all_w_t_and_m_t":"This field specifies the variation in the wet troposphere vertical delay relative to nominal value. The target device should add the constant value of 0.252 m to calculate the tropospheric wet (non hydro-static) vertical delay.","paragraph_zero_based":324},{"literal_text_all_w_t_and_m_t":"Scale factor 0.004 m; range ±0.508 m.","paragraph_zero_based":325},{"literal_text_all_w_t_and_m_t":"svID","paragraph_zero_based":326},{"literal_text_all_w_t_and_m_t":"This field specifies the GNSS satellite for which the STEC residual corrections are provided.","paragraph_zero_based":327},{"literal_text_all_w_t_and_m_t":"stecResidualCorrection","paragraph_zero_based":328},{"literal_text_all_w_t_and_m_t":"This field specifies the STEC residual correction.","paragraph_zero_based":329},{"literal_text_all_w_t_and_m_t":"Scale factor 0.04 TECU; range ±2.52 TECU (b7) or ±1310.68 TECU (b16).","paragraph_zero_based":330},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":331},{"literal_text_all_w_t_and_m_t":"Relationship between SSR troposphere quality and URA indicator and physical quantity","paragraph_zero_based":332},{"literal_text_all_w_t_and_m_t":"CLASS","paragraph_zero_based":333},{"literal_text_all_w_t_and_m_t":"VALUE","paragraph_zero_based":334},{"literal_text_all_w_t_and_m_t":"Index","paragraph_zero_based":335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha25