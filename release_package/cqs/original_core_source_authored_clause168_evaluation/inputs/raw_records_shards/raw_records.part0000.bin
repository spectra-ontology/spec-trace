{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"            cif-InSchedulingCell                    INTEGER (1..7)","paragraph_zero_based":16872},{"literal_text_all_w_t_and_m_t":"        }","paragraph_zero_based":16873},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":16874},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":16875},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":16876},{"literal_text_all_w_t_and_m_t":"    carrierIndicatorSize-r16            SEQUENCE {","paragraph_zero_based":16877},{"literal_text_all_w_t_and_m_t":"        carrierIndicatorSizeDCI-1-2-r16        INTEGER (0..3),","paragraph_zero_based":16878},{"literal_text_all_w_t_and_m_t":"        carrierIndicatorSizeDCI-0-2-r16        INTEGER (0..3)","paragraph_zero_based":16879},{"literal_text_all_w_t_and_m_t":"    }                                                                                       OPTIONAL,  -- Cond CIF-PRESENCE","paragraph_zero_based":16880},{"literal_text_all_w_t_and_m_t":"    enableDefaultBeamForCCS-r16         ENUMERATED {enabled}                                OPTIONAL  -- Need S","paragraph_zero_based":16881},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":16882},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":16883},{"literal_text_all_w_t_and_m_t":"    ccs-BlindDetectionSplit-r17         ENUMERATED {oneSeventh, threeFourteenth, twoSeventh, threeSeventh,","paragraph_zero_based":16884},{"literal_text_all_w_t_and_m_t":"                                            oneHalf, fourSeventh, fiveSeventh, spare1}      OPTIONAL  -- Need R","paragraph_zero_based":16885},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":16886},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":16887},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16888},{"literal_text_all_w_t_and_m_t":"-- TAG-CROSSCARRIERSCHEDULINGCONFIG-STOP","paragraph_zero_based":16889},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":16890},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16891},{"literal_text_all_w_t_and_m_t":"CrossCarrierSchedulingConfig field descriptions","paragraph_zero_based":16892},{"literal_text_all_w_t_and_m_t":"carrierIndicatorSizeDCI-0-2, carrierIndicatorSizeDCI-1-2","paragraph_zero_based":16893},{"literal_text_all_w_t_and_m_t":"Configures the number of bits for the field of carrier indicator in PDCCH DCI format 0_2/1_2. The field carrierIndicatorSizeDCI-0-2 refers to DCI format 0_2 and the field carrierIndicatorSizeDCI-1-2 refers to DCI format 1_2, respectively (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13], clause 10.1).","paragraph_zero_based":16894},{"literal_text_all_w_t_and_m_t":"ccs-BlindDetectionSplit","paragraph_zero_based":16895}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["a1f382a8b1073b6c45eefcc30d9be8fbe99afb831bcba884f5ce12d1feed15be","ceeb314298d8d259467dbe132ed830a212f38d79a1ee9adc72051edbc91565d8","bea2305193eb32933d8bb63206ea957dbbfa1c8befef9b047d4e2240e18b81c4","c00b97ea9fcf8486e0e18099173995a50e95aa85bc85faa819ad503a798cfadf","053eb60c6e9d1f219a3fc0d54954a2403f0fba802f7d800b6a86b4b7c1abc2ba","439dd6e71685d42cb63371a7b0538c59810747d36cfb3a34593daabd75839a13","451ae9f8337f97eb7ba0c7945783c7d4e8718073a95ee468968b7070e3c9a2c7","4a5fc6cb153e008512a8f294126674edb7394312144259494da36a8ec3eaa14a","c565508c7b523fbb1751f54552df7794f9656eb73fd829d31a5933959986b175","3283b1a47c39173e30c130d855763ad358fd158e2369940116e0d8187949f8e3","760bd73d9a00c606151962f092274dd45b4ffdb0857cf7a7e84f32aa19e6ea39","28b2ac6fadfae80561a4ee8a9499cb38dc6f7e5f7ef1d7d7490982fcf4683610","02dc0a09028f99781c752f0c2220f3aa5a70973cf629675f9711e3501a2458bb","754adae6045af583acbc144fb6d364c5886e33144aac65062f829991e153c083","934fc693e4b7e868de3b42555a3ca623d285c72225dc380c62499b680396411e","7be61d3ad59868c8a49b10ca1e522372a63030aec7584a761b506032750fe474","7f3ce4d1683f84b5647e7dae87245fcac3588114efe1940b88ef2616ad4ad941","de7fad9c8a208ab107874cf3a0acaacc1945e5a85c807479721e22da10df69d1","5a1670c2d7bd50a19ef247e428ec7a9150ebb10e2f27c85af0a147101b75d8c1","46d7e63b2386e9699f27f673d76d0895e86f0ee1d86360ce82318f70632a7d9c","662b4cf57fa7c845c23ced0325494ec967d248cad5774042bcc30769fd16678d","4486d5c7fddc1273424ee6fad71555af9c21c984f7338954f49d366a935750b5","247625db85d1c6988742671a1f9c6bcbd58a0c91ef1a58348bcd9589ced5db47","866f5476ca69b70dca33b68e03483df354e1ca28aeba295a3bb9e2ac8618ed11"],"paragraph_range_zero_based":[16872,16895],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p16872"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the share of blind detection candidates and non-overlapping CCEs for PDCCH monitoring on an SpCell and an SCell when cross-carrier scheduling is configured from the SCell for the SpCell (see TS 38.213 [13], clause 10.1.1). The network only configures this field when it sets the field other for an SpCell, i.e., when it configures cross-carrier scheduling of the SpCell by a PDCCH on an Scell.","paragraph_zero_based":16896},{"literal_text_all_w_t_and_m_t":"cif-Presence","paragraph_zero_based":16897},{"literal_text_all_w_t_and_m_t":"The field is used to indicate whether carrier indicator field is present (value true) or not (value false) in PDCCH DCI formats, see TS 38.213 [13]. If cif-Presence is set to true, the CIF value indicating a grant or assignment for this cell is 0.","paragraph_zero_based":16898},{"literal_text_all_w_t_and_m_t":"cif-InSchedulingCell","paragraph_zero_based":16899},{"literal_text_all_w_t_and_m_t":"The field indicates the CIF value used in the scheduling cell to indicate a grant or assignment applicable for this cell, see TS 38.213 [13]. If configured for an SpCell, the non-fallback DCI formats on the SpCell include same number of CIF bits as the corresponding non-fallback DCI formats on the scheduling cell, and the CIF bits are considered reserved.","paragraph_zero_based":16900},{"literal_text_all_w_t_and_m_t":"enableDefaultBeamForCCS","paragraph_zero_based":16901},{"literal_text_all_w_t_and_m_t":"This field indicates whether default beam selection for cross-carrier scheduled PDSCH is enabled, see TS 38.214 [19]. If not present, the default beam selection behaviour is not applied, i.e. Rel-15 behaviour is applied. This field can only be configured in the cross-scheduled SCell or SpCell.","paragraph_zero_based":16902},{"literal_text_all_w_t_and_m_t":"other","paragraph_zero_based":16903},{"literal_text_all_w_t_and_m_t":"Parameters for cross-carrier scheduling. If configured for an SpCell, the SpCell can be scheduled by the PDCCH on another SCell as well as by the PDCCH on the SpCell. If configured for an SCell, the SCell is scheduled by a PDDCH on another cell.","paragraph_zero_based":16904},{"literal_text_all_w_t_and_m_t":"own","paragraph_zero_based":16905},{"literal_text_all_w_t_and_m_t":"Parameters for self-scheduling, i.e., a serving cell is scheduled by its own PDCCH.","paragraph_zero_based":16906},{"literal_text_all_w_t_and_m_t":"schedulingCellId","paragraph_zero_based":16907},{"literal_text_all_w_t_and_m_t":"If configured for an SpCell, this field indicates which SCell, in addition to the SpCell, signals the downlink allocations and uplink grants, if applicable, for the concerned SpCell. If configured for an Scell, this field indicates which cell signals the downlink allocations and uplink grants, if applicable, for the concerned SCell. In case the UE is configured with DC, the scheduling cell is part of the same cell group (i.e. MCG or SCG) as the scheduled cell. In case the UE is configured with two PUCCH groups, the scheduling cell and the scheduled cell are within the same PUCCH group. If drx-ConfigSecondaryGroup is configured in the MAC-CellGroupConfig associated with this serving cell, the scheduling cell and the scheduled cell belong to the same Frequency Range. In addition, the serving cell with an aperiodic CSI trigger and the PUSCH resource scheduled for the report are on the same carrier and serving cell, but the cell for which CSI is reported may belong to the same or a different Frequency Range. The network should not trigger a CSI request for a serving cell in the other Frequency Range when that serving cell is outside Active Time.","paragraph_zero_based":16908},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16909},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":16910},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":16911},{"literal_text_all_w_t_and_m_t":"CIF-PRESENCE","paragraph_zero_based":16912},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the cif-Presence is set to true. The field is absent otherwise.","paragraph_zero_based":16913},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16914},{"literal_text_all_w_t_and_m_t":"–CSI-AperiodicTriggerStateList","paragraph_zero_based":16915},{"literal_text_all_w_t_and_m_t":"The CSI-AperiodicTriggerStateList IE is used to configure the UE with a list of aperiodic trigger states. Each codepoint of the DCI field \"CSI request\" is associated with one trigger state (see TS 38.321 [3], clause 6.1.3.13). Upon reception of the value associated with a trigger state, the UE will perform measurement of CSI-RS, CSI-IM and/or SSB (reference signals) and aperiodic reporting on L1 according to all entries in the associatedReportConfigInfoList for that trigger state.","paragraph_zero_based":16916},{"literal_text_all_w_t_and_m_t":"CSI-AperiodicTriggerStateList information element","paragraph_zero_based":16917},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":16918},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-APERIODICTRIGGERSTATELIST-START","paragraph_zero_based":16919}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["01fc379261e6e5d27f7b2c3bf6c822394a854966a7746d087351312002c5a38e","6e144490d1bc61b2ceb7948bbe36d35b610c5b485e6ab2a7e67fc708a5b2a616","80b5763ff9141bc16706881f48f0c4049d90e239d8222218fb94ecf57970e3fd","41e9b812aac1602d4e42ce2a5efbed2645f0f27e02281a6209b923b350ba92c2","40b5e1d4bbd878