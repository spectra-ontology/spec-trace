{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"},","paragraph_zero_based":2064},{"literal_text_all_w_t_and_m_t":"...,","paragraph_zero_based":2065},{"literal_text_all_w_t_and_m_t":"[[","paragraph_zero_based":2066},{"literal_text_all_w_t_and_m_t":"ppw-maxNumOfDL-Bandwidth-r17CHOICE {","paragraph_zero_based":2067},{"literal_text_all_w_t_and_m_t":"fr1ENUMERATED {mhz5, mhz10, mhz20, mhz40,","paragraph_zero_based":2068},{"literal_text_all_w_t_and_m_t":"mhz50, mhz80, mhz100},","paragraph_zero_based":2069},{"literal_text_all_w_t_and_m_t":"fr2ENUMERATED {mhz50, mhz100, mhz200, mhz400}","paragraph_zero_based":2070},{"literal_text_all_w_t_and_m_t":"}OPTIONAL","paragraph_zero_based":2071},{"literal_text_all_w_t_and_m_t":"]]","paragraph_zero_based":2072},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2073},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2074},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":2075},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2076},{"literal_text_all_w_t_and_m_t":"NR-DL-PRS-ProcessingCapability field descriptions","paragraph_zero_based":2077},{"literal_text_all_w_t_and_m_t":"maxSupportedFreqLayers","paragraph_zero_based":2078},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of positioning frequency layers supported by UE.","paragraph_zero_based":2079},{"literal_text_all_w_t_and_m_t":"simulLTE-NR-PRS","paragraph_zero_based":2080},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports parallel processing of LTE PRS and NR PRS.","paragraph_zero_based":2081},{"literal_text_all_w_t_and_m_t":"dummy","paragraph_zero_based":2082},{"literal_text_all_w_t_and_m_t":"This field is not used in the specification. If received it shall be ignored by the receiver.","paragraph_zero_based":2083},{"literal_text_all_w_t_and_m_t":"supportedBandwidthPRS","paragraph_zero_based":2084},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of DL-PRS bandwidth in MHz, which is supported and reported by UE.","paragraph_zero_based":2085},{"literal_text_all_w_t_and_m_t":"dl-PRS-BufferType","paragraph_zero_based":2086},{"literal_text_all_w_t_and_m_t":"Indicates DL-PRS buffering capability. Value type1 indicates sub-slot/symbol level buffering and value type2 indicates slot level buffering.","paragraph_zero_based":2087}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["d1fa2a75050d8d05239e51f003a30919ce53f69cee3efd6279f6b026f04017bf","208ba72640ee8df1fc58f94f6e4f71d08fc471a40ac2cd9040f7aa352e6e1d4b","93250f00ad5007791c48ac8e947c10987157a0682a3a9219d815005a9a3998fe","e3c96fedfdada1c917a1a89a8c6d6700d0336c7a20531fa8b0197cad20ea62ab","406bb769c37892687ea9e99c4e0f90b03d61f476a40f4f96a08733ea32f809e2","fe72b0bc324097061b3897c1e2676c91daf35e6b749e903ac5156b1dd80ae078","8f8a161b71a643f50e59cca1dc2a9f9468cadd17dfe19ebb7e9b4edac25cd60c","62f30385bae80df1fa6758e1c77f3bb2cb6db8e003da93488c5ec8e61a7cf002","121af96f7aa7c063f1046ee3b435d068f69d1b0262d1f3a975a95fe878606224","4522076394885fad5cc4ca86ff51673425790edaeb07f32da9dbcaa62e1416eb","4e9071f97cb836a03b62c05529bcdcecd58c3cc7fbcd8b87692668fb6f783ee2","e91a3b44ec17da0d4ee42f5817a8589bce65a12756a067651ff91f6a6bed5973","60020ae6513497c7df6eb240b27a43a49db2c62891293bd1b032d5b05d515be9","db7f874055857bef86c11d96e302e5b78a15d752b1933827c4b1d1cad8ac8497","594617b6df8eb0d5b80cab405574c281c6fcaea2305396a889757393b6beb2e4","69bcad5e8bb1365098cf9d3bd7d4a26bd16bf5175dc8b8e1dbb00b485fb5c91b","c1314321be21b2d351af48b0029eb0e19f2b708b1aa0cc299d93ad161e913642","4506587984eb8d4f4b10c1324a0dcf406df48e1dab7b837068e628a36e45965b","a02fa4ea782e15d452830a3a2694a473c0e6d4110f640c576d8981a450f60222","38d9544bcaa802536ab18ba5da31a4cfc178ace8ad7a8f8cf472ca1e67cb15cd","483a12a2a438a1a9aeeab1736cc230e6fc3a534caeb842598ba295f592cb94aa","ee636c52be383116a2e312ff62faf499b85dab847be033db3285f8fcca6e9e20","9aa3ac48b0933d38886b43326b196dc434ca6f60e444a611c47517d15453f786","0e428f0f60acbd7fc3bd3a43ec98997737cb749280267f0742520b10676f1bf2"],"paragraph_range_zero_based":[2064,2087],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx:p2064"}
{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"durationOfPRS-Processing","paragraph_zero_based":2088},{"literal_text_all_w_t_and_m_t":"Indicates the duration N of DL-PRS symbols in units of ms a UE can process every T ms assuming maximum DL-PRS bandwidth provided in supportedBandwidthPRS and comprises the following subfields:","paragraph_zero_based":2089},{"literal_text_all_w_t_and_m_t":"-durationOfPRS-ProcessingSymbols: This field specifies the values for N. Enumerated values indicate 0.125, 0.25, 0.5, 1, 2, 4, 8, 12, 16, 20, 25, 30, 35, 40, 45, 50 ms.","paragraph_zero_based":2090},{"literal_text_all_w_t_and_m_t":"-durationOfPRS-ProcessingSymbolsInEveryTms: This field specifies the values for T. Enumerated values indicate 8, 16, 20, 30, 40, 80, 160, 320, 640, 1280 ms.","paragraph_zero_based":2091},{"literal_text_all_w_t_and_m_t":"See NOTE.","paragraph_zero_based":2092},{"literal_text_all_w_t_and_m_t":"maxNumOfDL-PRS-ResProcessedPerSlot","paragraph_zero_based":2093},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of DL-PRS resources that UE can process in a slot. SCS: 15 kHz, 30 kHz, 60 kHz are applicable for FR1 bands. SCS: 60 kHz, 120 kHz are applicable for FR2 bands. ","paragraph_zero_based":2094},{"literal_text_all_w_t_and_m_t":"supportedDL-PRS-ProcessingSamples-RRC-CONNECTED","paragraph_zero_based":2095},{"literal_text_all_w_t_and_m_t":"Indicates the UE capability for support of measurements based on measuring M=1 or M=2 (instances) of a DL-PRS Resource Set. The UE can include this field only if the UE supports prs-ProcessingCapabilityBandList. Otherwise, the UE does not include this field.","paragraph_zero_based":2096},{"literal_text_all_w_t_and_m_t":"NOTE:This feature is supported for both UE-assisted and UE based positioning.","paragraph_zero_based":2097},{"literal_text_all_w_t_and_m_t":"prs-ProcessingWindowType1A","paragraph_zero_based":2098},{"literal_text_all_w_t_and_m_t":"Indicates the supported DL-PRS processing types subject to the UE determining that DL-PRS to be higher priority for DL-PRS measurement outside MG and in a DL-PRS Processing Window.","paragraph_zero_based":2099},{"literal_text_all_w_t_and_m_t":"Type 1A refers to the determination of prioritization between DL-PRS and other DL signals/channels in all OFDM symbols within the PRS Processing Window. The DL signals/channels from all DL CCs (per UE) are affected across LTE and NR. Enumerated value indicates supported priority handing options of DL-PRS:","paragraph_zero_based":2100},{"literal_text_all_w_t_and_m_t":"-option1: UE indicates support of two priority states.","paragraph_zero_based":2101},{"literal_text_all_w_t_and_m_t":"-State 1: DL-PRS is higher priority than all PDCCH/PDSCH/CSI-RS","paragraph_zero_based":2102},{"literal_text_all_w_t_and_m_t":"-State 2: DL-PRS is lower priority than all PDCCH/PDSCH/CSI-RS","paragraph_zero_based":2103},{"literal_text_all_w_t_and_m_t":"-option2: UE indicates support of three priority states","paragraph_zero_based":2104},{"literal_text_all_w_t_and_m_t":"-State 1: DL-PRS is higher priority than all PDCCH/PDSCH/CSI-RS","paragraph_zero_based":2105},{"literal_text_all_w_t_and_m_t":"-State 2: DL-PRS is lower priority than PDCCH and URLLC PDSCH and higher priority than other PDSCH/CSI-RS","paragraph_zero_based":2106},{"literal_text_all_w_t_and_m_t":"Note: The URLLC channel corresponds a dynamically scheduled PDSCH whose PUCCH resource for carrying ACK/NAK is marked as high-priority.","paragraph_zero_based":2107},{"literal_text_all_w_t_and_m_t":"-State 3: DL-PRS is lower priority than all PDCCH/PDSCH/CSI-RS","paragraph_zero_based":2108},{"literal_text_all_w_t_and_m_t":"-option3: UE indicates support of single priority state","paragraph_zero_based":2109},{"literal_text_all_w_t_and_m_t":"-State 1: DL-PRS is higher priority than all PDCCH/PDSCH/CSI-RS","paragraph_zero_based":2110},{"literal_text_all_w_t_and_m_t":"The UE can include this field only if the UE supports prs-ProcessingCapabilityBandList. Otherwise, the UE does not include this field.","paragraph_zero_based":2111}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["f029368f98fd06846adeb7a76f513b9eb1290798dd760ff7c1591feea4613378","ce24fcc6ce25e47622d0125a23da2c396a41d249460db2f98f333811b09c7cc3","6f507ff0879455d37d2c8aff06f86f17357f361ed6313dd92ef8f19d3fb789fb","c1254e9669849c5a4c318a76dd96045379bcbeb26e1dd7d9850c33183f5e03b2","d8d10915d4b42850eedb1a778f6a19824261ec55e40905c44dad796bb19b4c3d","03c8ecda26789008cfc5fdab79e7477551285a8a39f39b85f07ca27486dd5d03","82bf8fc3c5abb6a5d5b7a171f4b73da2669260be0d578841d74a003ade8280bb","6bd9758354eab83da43de1f29561e7d338f493a0cf75eba854090666a10cdab1","b3cb39f5dbe2e7f157bdb929a874892b963913485f4a04216294419134d108dc","5912262e74c24a0382b0d6096349c014068636bb7d5dfe641e89e6eac2819a5b","b6120d04aca3df51ae050b934c898bbc7c4f5cbadb8139ff9af441424ae2bb27","9cbeca8385993fa57fbeb80e7e5d43f6de287aee82e96ccd3782360eba4b96af","9b1093850135fd4684a412af16cdebdc8f1f9b49b1069fd08c073a4bc9278bc1","c2f73511edc236c811ea2a1e74c7913f9ccc1a29bf261b259a3c1c3e417fa01b","355836cf2b068482b3a3311f398fbbeb567a4432532b9647dc31e9ff93a6e2f6","77f4a67fad661785f851e299c2f4405efee7e788e24e8d534cf74110c88fd227","87878b6bf778ee4d116bf75e068b5795fc288543cba9ed7b1d5919571d0dead4","ca54b041aed522e9851f64453e61822c2e453340e17b9ae5c9f9b6a5d7968c17","4c5480fcf61a6d7b5204f35d6b6124fb23149867c1b53ceb421905e7871b3748","e25d29e39aec45be7d3461d53bf29bcd326468e3e00115411de9047e8cada2b2","85457a8bad28cef7079a5ef57f0dec1fdb1bb6de7975045d6cdf291335a0aeae","9a1994bfe178e6d3ed9bae9bad78e47c4e1031de8a4a96b6920bd0d17ab5ab1f","e14d469201080e369c44ac1422ec64e9fd28e53ddd74f10eb2edd3984260be3d","5ad9edd2de5951d5c25aa9e7d970b96c9407a83947fbf20459d008e238213b98"],"paragraph_range_zero_based":[2088,2111],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx:p2088"}
{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"NOTE:Within a PRS processing window, UE measurement is inside the active DL BWP with PRS having the same numerology as the active DL BWP.","paragraph_zero_based":2112},{"literal_text_all_w_t_and_m_t":"prs-ProcessingWindowType1B","paragraph_zero_based":2113},{"literal_text_all_w_t_and_m_t":"Indicates the supported DL-PRS processing types subject to the UE determining that DL-PRS to be higher priority for DL-PRS measurement outside MG and in a DL-PRS Processing Window.","paragraph_zero_based":2114},{"literal_text_all_w_t_and_m_t":"Type 1B refers to the determination of prioritization between DL-PRS and other DL signals/channels in all OFDM symbols within the PRS processing window. The DL signals/channels from a certain band are affected. Enumerated value indicates supported priority handing options of DL-PRS (see prs-ProcessingWindowType1A).","paragraph_zero_based":2115},{"literal_text_all_w_t_and_m_t":"The UE can include this field only if the UE supports prs-ProcessingCapabilityBandList. Otherwise, the UE does not include this field.","paragraph_zero_based":2116},{"literal_text_all_w_t_and_m_t":"NOTE:Within a PRS processing window, UE measurement is inside the active DL BWP with PRS having the same numerology as the active DL BWP.","paragraph_zero_based":2117},{"literal_text_all_w_t_and_m_t":"prs-ProcessingWindowType2","paragraph_zero_based":2118},{"literal_text_all_w_t_and_m_t":"Indicates the supported DL-PRS processing types subject to the UE determining that DL-PRS to be higher priority for DL-PRS measurement outside MG and in a DL-PRS Processing Window.","paragraph_zero_based":2119},{"literal_text_all_w_t_and_m_t":"Type 2 refers to the determination of prioritization between DL-PRS and other DL signals/channels only in DL-PRS symbols within the PRS processing window. Enumerated value indicates supported priority handing options of DL-PRS (see prs-ProcessingWindowType1A).","paragraph_zero_based":2120},{"literal_text_all_w_t_and_m_t":"The UE can include this field only if the UE supports prs-ProcessingCapabilityBandList. Otherwise, the UE does not include this field.","paragraph_zero_based":2121},{"literal_text_all_w_t_and_m_t":"NOTE:Within a PRS processing window, UE measurement is inside the active DL BWP with PRS having the same numerology as the active DL BWP.","paragraph_zero_based":2122},{"literal_text_all_w_t_and_m_t":"prs-ProcessingCapabilityOutsideMGinPPW","paragraph_zero_based":2123},{"literal_text_all_w_t_and_m_t":"Indicates the DL-PRS Processing Capability outside MG and comprises the following subfields:","paragraph_zero_based":2124},{"literal_text_all_w_t_and_m_t":"-prsProcessingType: Indicates the DL-PRS Processing Window Type for which the prs-ProcessingCapabilityOutsideMGinPPW are provided.","paragraph_zero_based":2125},{"literal_text_all_w_t_and_m_t":"-ppw-dl-PRS-BufferType: Indicates DL-PRS buffering capability. Value 'type1' indicates sub-slot/symbol level buffering and value 'type2' indicates slot level buffering.","paragraph_zero_based":2126},{"literal_text_all_w_t_and_m_t":"-ppw-durationOfPRS-Processing1: Indicates the duration of DL-PRS symbols N in units of ms a UE can process every T ms assuming maximum DL-PRS bandwidth provided in ppw-maxNumOfDL-Bandwidth and comprises the following subfields:","paragraph_zero_based":2127},{"literal_text_all_w_t_and_m_t":"-ppw-durationOfPRS-ProcessingSymbolsN: This field specifies the values for N. Enumerated values indicate 0.125, 0.25, 0.5, 1, 2, 4, 6, 8, 12, 16, 20, 25, 30, 32, 35, 40, 45, 50 ms.","paragraph_zero_based":2128},{"literal_text_all_w_t_and_m_t":"-ppw-durationOfPRS-ProcessingSymbolsT: This field specifies the values for T. Enumerated values indicate 1, 2, 4, 8, 16, 20, 30, 40, 80, 160, 320, 640, 1280 ms.","paragraph_zero_based":2129},{"literal_text_all_w_t_and_m_t":"-ppw-durationOfPRS-Processing2: Indicates the duration of DL-PRS symbols N2 in units of ms a UE can process inT2 ms assuming maximum DL-PRS bandwidth provided in ppw-maxNumOfDL-Bandwidth and comprises the following subfields:","paragraph_zero_based":2130},{"literal_text_all_w_t_and_m_t":"-ppw-durationOfPRS-ProcessingSymbolsN2: This field specifies the values for N2. Enumerated values indicate 0.125, 0.25, 0.5, 1, 2, 3, 4, 5, 6, 8, 12 ms.","paragraph_zero_based":2131},{"literal_text_all_w_t_and_m_t":"-ppw-durationOfPRS-ProcessingSymbolsT2: This field specifies the values for T2. Enumerated values indicate 4, 5, 6, 8 ms.","paragraph_zero_based":2132},{"literal_text_all_w_t_and_m_t":"- ppw-maxNumOfDL-PRS-ResProcessedPerSlot: Indicates the maximum number of DL-PRS resources that UE can process in a slot. SCS: 15 kHz, 30 kHz, 60 kHz are applicable for FR1 bands. SCS: 60 kHz, 120 kHz are applicable for FR2 bands.","paragraph_zero_based":2133},{"literal_text_all_w_t_and_m_t":"- ppw-maxNumOfDL-Bandwidth: Indicates the maximum number of DL PRS bandwidth in MHz, which is supported and reported by UE for PRS measurement outside MG within the PPW.","paragraph_zero_based":2134},{"literal_text_all_w_t_and_m_t":"The UE can include this field only if the UE supports one of prs-ProcessingWindowType1A, prs-ProcessingWindowType1B and prs-ProcessingWindowType2. Otherwise, the UE does not include this field.","paragraph_zero_based":2135}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["7916e72f7fe66eb084e9eeca065de0390f2fa4346c71c0c44c93ef0466247719","add2a7ea6d91e500906ef13ffa0906779044c3ed759941a3e76c598018d50708","b744d2906eb2013a3206e777dbbe9da749dbfddae4ebb9e022b512f2ef63a57e","c206e30e2901b58a40c873c48d1eec51d648029a92a7156641d0924f7f1f26e1","3c8533c24a2fa41703b8368d33fb2b92b9f8c0f6ca08aaf98d9ec34464439323","03b6174dca715624409642b7f820fc571c02a193277130991ddb40f14110841c","8ce6343326585dc26ce557b86f2862f79e4e041fe45e94680c3e96e38eaef9b3","b1569c8514f4f5006f78eef17ec4d74c3c1748fa9849e8eb96a0d24584b01761","49ccc186a1940c3a1b9c0794eaf03d64a86078373de1d33ebf40909c5951c19f","616c20bdeb00361eeef6ba6a8e6d19d96a63e28bfff93c87bcc3b83e0622fb4f","a3e4b4c484696b3e1540141ad383c1a302a13ab797cd890de9bebbcbd03debfe","40dc8d78cd2622451340b6863f0fa191ac657739a007f06c33093e81dc1295d4","9624fcc18c6c3bc089d7529178d209c5f8c39c987644914a24a88fde3eb330b8","8080dd90fef2266cf5ad0a16a9f0399df0a4ae3b83d8fe48c01144a336bc40fc","729af1a98efac714c47793b1be99faf8289f4be2dc47e1c0b77fd07dec3bd914","97f3e1f354426568aeba6615c57cf41f62ba4f1968b30772df5d3b4e2146356c","be8e2194ae63d826cd7ce71dbb90771eb2dcdde7abcb063fc38eb2b3436a6852","ae8fd1446018c0b571c9b1411288e3574016c7ef97b477553b45657f81c839a0","0c944428f13991180848bf89d996a5d55bff4122a6d2a31e18c319a0c4265391","d7e9cc59dc71394fa6ac20ae093a70b1a819537faa39da686fa762a3dba12bf6","742d6e94e6a5dee500efec85ac7ffac28d741391a7ef0e4151a32fd4efb23aa7","cfba36662891f27a224aac539c0fe175672643060c5947b9eaf03313c417f5e0","58b9f4752728f98373ca96254e5580f5715934ccc92dc794d5e0c4e929c6e197","d42cd352f659c2252fb5b83844364e67e705ac6c55aa14bb5a012dec6163bc71"],"paragraph_range_zero_based":[2112,2135],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx:p2112"}
{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"NOTE:A UE that supports one of prs-ProcessingWindowType1, prs-ProcessingWindowType1B or prs-ProcessingWindowType2 defined in TS 38.331 [35] shall always support ppw-dl-PRS-BufferType, ppw-durationOfPRS-Processing1, ppw-durationOfPRS-Processing2, ppw-maxNumOfDL-PRS-ResProcessedPerSlot, and ppw-maxNumOfDL-BandwidthFR1 or ppw-maxNumOfDL-BandwidthFR2.","paragraph_zero_based":2136},{"literal_text_all_w_t_and_m_t":"dl-PRS-BufferType-RRC-Inactive","paragraph_zero_based":2137},{"literal_text_all_w_t_and_m_t":"Indicates DL-PRS buffering capability in RRC_INACTIVE state. Value 'type1' indicates sub-slot/symbol level buffering and value 'type2' indicates slot level buffering.","paragraph_zero_based":2138},{"literal_text_all_w_t_and_m_t":"durationOfPRS-Processing-RRC-Inactive","paragraph_zero_based":2139},{"literal_text_all_w_t_and_m_t":"Indicates the duration N of DL-PRS symbols in units of ms a UE can process every T ms in RRC_INACTIVE state assuming maximum DL-PRS bandwidth provided in supportedBandwidthPRS and comprises the following subfields:","paragraph_zero_based":2140},{"literal_text_all_w_t_and_m_t":"-durationOfPRS-ProcessingSymbols: This field specifies the values for N. Enumerated values indicate 0.125, 0.25, 0.5, 1, 2, 4, 6, 8, 12, 16, 20, 25, 30, 32, 35, 40, 45, 50 ms.","paragraph_zero_based":2141},{"literal_text_all_w_t_and_m_t":"-durationOfPRS-ProcessingSymbolsInEveryTms: This field specifies the values for T. Enumerated values indicate 8, 16, 20, 30, 40, 80, 160, 320, 640, 1280 ms.","paragraph_zero_based":2142},{"literal_text_all_w_t_and_m_t":"See NOTE.","paragraph_zero_based":2143},{"literal_text_all_w_t_and_m_t":"maxNumOfDL-PRS-ResProcessedPerSlot-RRC-Inactive","paragraph_zero_based":2144},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of DL-PRS resources a UE can process in a slot in RRC_INACTIVE state. SCS: 15 kHz, 30 kHz, 60 kHz are applicable for FR1 bands. SCS: 60 kHz, 120 kHz are applicable for FR2 bands.","paragraph_zero_based":2145},{"literal_text_all_w_t_and_m_t":"supportedLowerRxBeamSweepingFactor-FR2","paragraph_zero_based":2146},{"literal_text_all_w_t_and_m_t":"Indicates support of the lower Rx beam sweeping factor than 8 for FR2. Enumerated value indicates the number of Rx beam sweeping factors supported.","paragraph_zero_based":2147},{"literal_text_all_w_t_and_m_t":"supportedDL-PRS-ProcessingSamples-RRC-Inactive","paragraph_zero_based":2148},{"literal_text_all_w_t_and_m_t":"Indicates the UE capability for support of measurements based on measuring M=1 or M=2 samples (instances) of a DL-PRS Resource Set in RRC_INACTIVE state. The UE can include this field only if the UE supports prs-ProcessingRRC-Inactive defined in TS 38.331 [35]. Otherwise, the UE does not include this field.","paragraph_zero_based":2149},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2150},{"literal_text_all_w_t_and_m_t":"NOTE:When the target device provides the durationOfPRS-Processing capability (N, T) for any P(≥T) time window defined in TS 38. 214 [45] clause 5.1.6.5, the target device should be capable of processing all DL-PRS resources within P, if","paragraph_zero_based":2151},{"literal_text_all_w_t_and_m_t":"-N≥K where K is defined in the TS 38.214 [45] clause 5.1.6.5, and","paragraph_zero_based":2152},{"literal_text_all_w_t_and_m_t":"-the number of DL-PRS Resources in each slot does not exceed the maxNumOfDL-PRS-ResProcessedPerSlot, and","paragraph_zero_based":2153},{"literal_text_all_w_t_and_m_t":"-the configured measurement gap and a maximum ratio of measurement gap length (MGL) / measurement gap repetition period (MGRP) is as specified in TS 38.133 [46].","paragraph_zero_based":2154},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2155},{"literal_text_all_w_t_and_m_t":"–NR-DL-PRS-QCL-ProcessingCapability","paragraph_zero_based":2156},{"literal_text_all_w_t_and_m_t":"The IE NR-DL-PRS-QCL-ProcessingCapability defines the common UE DL-PRS QCL Processing capability. The UE can include this IE only if the UE supports NR-DL-PRS-ProcessingCapability. Otherwise, the UE does not include this IE.","paragraph_zero_based":2157},{"literal_text_all_w_t_and_m_t":"In the case of capabilities for multiple NR positioning methods are provided, the IE NR-DL-PRS-QCL-ProcessingCapability applies across the NR positioning methods and the target device shall indicate the same values for the capabilities in IEs NR-DL-TDOA-ProvideCapabilities, NR-DL-AoD-ProvideCapabilities, and NR-Multi-RTT-ProvideCapabilities.","paragraph_zero_based":2158},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":2159}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["ddcc05ea868b19e54e0c15d68e31b2444086e2f94ccdcdb9d0f6ac3bf9f8a787","0c1d74446c76da162963e3db00f9a38c71535fffb6722e6cb9d53ca654265bd1","ddc9f084512e21f2bdf57e03debebb7b9582fe5954cbe80a3dca2574e6d3ab92","ac056a8bf42a023ee3b1b7114d89a2332cdafbc43035bac5b68850ed261b8853","7e4b9f09946b958441b1e00b8a39cd3205c73a777fb4fc86795314a92d52920b","2e7a8cda61043e44c45729614fbc6c3823f769c48b63c65bfebe8e8307d57c83","4e91f373568881f50c6768ae86f24c18b188ae18d704cf3cdb267b8e6ea33164","125392ff8bf9eca09cb5cfd6f49e795291ebb2602c3728e9dfdb7baa7af890db","0c1ce43939ff1bc340986c24afbb7557646ebad17644580f91d4173c15166005","a51851aa158afecf78029338cd54ce6c9a1866b38b6f20149a6b9bf543b31956","10024defe2afd597ca34f224075a4ff83b27c364cf862fe65f410b006fc50060","b21ac274d90050abf60786d620be79aa15a57d186d5f42e6323071345796156e","9b396c154a0e50ab540dab9c97e6a52cfeae968ad00ef1833c14f9dad964a890","541507b6667d97f231c476d6908c1d9977f30def70ed70fb2de1c14a534fff9f","4fdeaf97d35df4ccf2a7feb4e44490dd1deab8841cc2f64f9e4f6b1584c0a5e4","a5d02209a586dfd1d8e911dd4bca5bc97cc778fece29a55af5b52c9ccbeccb6f","27f08dfffb98cb9e698680732e0903601ffb48e3b770ab086995c8cd24b096c1","633939bea1f701b7d25ccea94242aef220b8415fb0d3447bf058b827b3482352","3b510c3ac26bf013cedd2c4be52f9cdaf6c2f09447e5128d754c4bb3b912a3d2","5970d8f7b0c4bc4a26159d67bc3c9bec017476f958f97d81a7f43f6a2d0230e5","64ab716ec2c12bcc28155aad3904d247a5cb765f261f40b70e33b1a95e28239a","3eab883e58ff81654f9d1cca4650da57da7af81eed08a1365e3f0298d2411322","910a62875bcf0deed76f3af191566cccd48ec1f101cbc4205e32f49c80b1baf2","3647829541c5ea219793ef6731e366cc6bea8610349c5b886bb8e412e5769f3f"],"paragraph_range_zero_based":[2136,2159],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx:p2136"}
{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2160},{"literal_text_all_w_t_and_m_t":"NR-DL-PRS-QCL-ProcessingCapability-r16 ::= SEQUENCE {","paragraph_zero_based":2161},{"literal_text_all_w_t_and_m_t":"dl-PRS-QCL-ProcessingCapabilityBandList-r16SEQUENCE (SIZE (1..nrMaxBands-r16)) OF","paragraph_zero_based":2162},{"literal_text_all_w_t_and_m_t":"DL-PRS-QCL-ProcessingCapabilityPerBand-r16,","paragraph_zero_based":2163},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":2164},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2165},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2166},{"literal_text_all_w_t_and_m_t":"DL-PRS-QCL-ProcessingCapabilityPerBand-r16 ::= SEQUENCE {","paragraph_zero_based":2167},{"literal_text_all_w_t_and_m_t":"freqBandIndicatorNR-r16FreqBandIndicatorNR-r16,","paragraph_zero_based":2168},{"literal_text_all_w_t_and_m_t":"ssb-FromNeighCellAsQCL-r16ENUMERATED { supported}OPTIONAL,","paragraph_zero_based":2169},{"literal_text_all_w_t_and_m_t":"prs-FromServNeighCellAsQCL-r16ENUMERATED { supported} OPTIONAL,","paragraph_zero_based":2170},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":2171},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2172},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2173},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":2174},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2175},{"literal_text_all_w_t_and_m_t":"NR-DL-PRS-QCL-ProcessingCapability field descriptions","paragraph_zero_based":2176},{"literal_text_all_w_t_and_m_t":"ssb-FromNeighCellAsQCL","paragraph_zero_based":2177},{"literal_text_all_w_t_and_m_t":"Indicates the support of SSB from neighbour cell as QCL source of a DL-PRS. UE supporting this feature also support reusing SSB measurement from RRM for receiving PRS.","paragraph_zero_based":2178},{"literal_text_all_w_t_and_m_t":"Note: It refers to Type-C for FR1 and Type-C & Type-D support for FR2.","paragraph_zero_based":2179},{"literal_text_all_w_t_and_m_t":"prs-FromServNeighCellAsQCL","paragraph_zero_based":2180},{"literal_text_all_w_t_and_m_t":"Indicates the support of DL-PRS from serving/neighbour cell as QCL source of a DL-PRS.","paragraph_zero_based":2181},{"literal_text_all_w_t_and_m_t":"Note 1:It refers to Type-D support for FR2.","paragraph_zero_based":2182},{"literal_text_all_w_t_and_m_t":"Note 2:A PRS from a PRS-only TP is treated as PRS from a non-serving cell.","paragraph_zero_based":2183}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["7deb044d4a2d9ea2c01f5fb75e0a88bbd4d12bee033af3de376894487513f479","51594156b5f6aa39c145a192abdc164089743e4328e09f81b9dff3efdfbadf02","b9df4a00b280df1f28e5265381a71bdcde7c71f0a41726cccd8a4fb033960bb3","f8b0e873e11a730b714d9a051d79dfb422a80df11f29e21e988f05a0e336f9e6","9f41dc101fb5ad5357be10b1bebf2be4989d9c220e0489c66cd4c2dfd8d50e8e","7574328d591d4cc3d4fcb56b2c84075e921e6800303840a7d0fd337e60cdd070","f1ea4502ca873106f021e109e3536df31860ef0eb057f32ed6a5ee9834e4f40d","a1b0cdfb046756a40b6d4fb73aeae2926428230700d645bdd5fe3d8bdc93ca24","0aa93a7da00a5a5d116b71c4634ea9874766f60eedb8deb80f91fab0514fd064","f7398fbb79109a36a17d387487d16ba7f803c4cb9235d83f1159783c20e5db53","46c728aa51a3b918dc4884fc50784b4882a1bc149f0691d7a42064c33d310213","18ce44d620eb3085cb1e16a27ad72cb0849044f2ca1f3c2ea06e7803ef0f2904","19fe789cfc3a2010206b15170c947e998f018f46f0b21b0d5f543f9e6869c071","b623e7bf72e4f43f2e792d33d7364546c7f37f1d4fadd6b10f07d7ff00c57ab5","8b5c7c6a29e726e96f394d206f7c8