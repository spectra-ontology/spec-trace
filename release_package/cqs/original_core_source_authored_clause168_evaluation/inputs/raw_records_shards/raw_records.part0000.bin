{"fields":{"filename":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"...,","paragraph_zero_based":1680},{"literal_text_all_w_t_and_m_t":"[[","paragraph_zero_based":1681},{"literal_text_all_w_t_and_m_t":"ten-ms-unit-ResponseTime-r17PositioningModesOPTIONAL,","paragraph_zero_based":1682},{"literal_text_all_w_t_and_m_t":"nr-PosCalcAssistanceSupport-r17BIT STRING {trpLocSup(0),","paragraph_zero_based":1683},{"literal_text_all_w_t_and_m_t":"beamInfoSup(1),","paragraph_zero_based":1684},{"literal_text_all_w_t_and_m_t":"rtdInfoSup(2),","paragraph_zero_based":1685},{"literal_text_all_w_t_and_m_t":"trpTEG-InfoSup(3)","paragraph_zero_based":1686},{"literal_text_all_w_t_and_m_t":"}(SIZE (1..8))OPTIONAL,","paragraph_zero_based":1687},{"literal_text_all_w_t_and_m_t":"nr-los-nlos-AssistanceDataSupport-r17SEQUENCE {","paragraph_zero_based":1688},{"literal_text_all_w_t_and_m_t":"type-r17LOS-NLOS-IndicatorType2-r17,","paragraph_zero_based":1689},{"literal_text_all_w_t_and_m_t":"granularity-r17LOS-NLOS-IndicatorGranularity2-r17,","paragraph_zero_based":1690},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":1691},{"literal_text_all_w_t_and_m_t":"}OPTIONAL,","paragraph_zero_based":1692},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-ExpectedAoD-or-AoA-Sup-r17BIT STRING {eAoD(0),","paragraph_zero_based":1693},{"literal_text_all_w_t_and_m_t":"eAoA(1)","paragraph_zero_based":1694},{"literal_text_all_w_t_and_m_t":"}(SIZE (1..8))OPTIONAL,","paragraph_zero_based":1695},{"literal_text_all_w_t_and_m_t":"nr-DL-TDOA-On-Demand-DL-PRS-Support-r17NR-On-Demand-DL-PRS-Support-r17OPTIONAL,","paragraph_zero_based":1696},{"literal_text_all_w_t_and_m_t":"nr-los-nlos-IndicatorSupport-r17SEQUENCE {","paragraph_zero_based":1697},{"literal_text_all_w_t_and_m_t":"type-r17LOS-NLOS-IndicatorType2-r17,","paragraph_zero_based":1698},{"literal_text_all_w_t_and_m_t":"granularity-r17LOS-NLOS-IndicatorGranularity2-r17,","paragraph_zero_based":1699},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":1700},{"literal_text_all_w_t_and_m_t":"}OPTIONAL,","paragraph_zero_based":1701},{"literal_text_all_w_t_and_m_t":"additionalPathsExtSupport-r17ENUMERATED { n4, n6, n8 }OPTIONAL,","paragraph_zero_based":1702},{"literal_text_all_w_t_and_m_t":"scheduledLocationRequestSupported-r17ScheduledLocationTimeSupportPerMode-r17OPTIONAL,","paragraph_zero_based":1703}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["55335c349a97c7957f5c2b22200d8693ff5313dd2759db04eab0861172b22230","9f1fd7b46973419db351566292d6e26e9fe794d2ad284d110d4613b259b260c3","e321af2825d60cbb9f1b021a5b005f340a31b10fc0310fc8f1f7cccc684140a1","15124c48e4ab9f9124038732a9d72083aaee330b9d7b8dce4a0705558a7f47ba","814c3aff41d0ed2b7c1327758feb237fe6acf83dc38e13852a5bded1dda1b2ad","78462370c733a48e7303ae663e7577205d38eba483a674461f9a8660af894b2b","1a300f07b0b24f2a9ef5da9f65a0e672148d50256e633c6537520a728667342d","011607ebc94dc7847d2f51747942e1270a2e30f8d666df24af079eccd761a3dc","81251d5f3ee72e060ccc745566908266c0ace43c288c1f99008d38ecd233567f","5178c89a2ad3ef2f36303dd57ea11b9866c86f9d6c90d6577f9c298d40c1d898","ff59f76f4d697ec2e6868282da2f294697b95e837b05b1037d55b98c7d039ce6","dc1e5de108238ee2417e97246dd8ab7313ac6b424ff842543888bd77df58fbe3","9f14ed7649787d0d7703ea8f89a6895a1c5d1aa96e40d5e0dcb4632619207319","cf16763f2ad9e4bdc3abaf60c90887e279af4222d442750136f683c0f80c7e10","564a396e0abe0efd48b8d6eccca3e8cc33a11cf1e1a06e278a539a5732e29daf","94254f91d06185f52dfa27963de00418029f55337e31b83f0c15bb97cf6debaf","644253427bd5b5244605571d13f80763a8f8eecb88c475ca787abb16765b62b2","7def9b1df5b69b99ccf8aa4aa8ebeab859db78229c30d7fc43066c17f0179b6f","e7a12df9dfd3ed258ea991b923a0aa536dbd8c0215d554abb6ae6ec0d35539b1","473256c8b1697e8e0937d06d4dae0dca416c7d86f12f5a2046af99bf4a39a155","3e4cae17861f9822876a1c28920f52947adcbf646f3f020b778868070d431cb7","1f7be178b91291db155dab3e3751d17d2401d8f00fcdb0c77c13f539b248560e","2a4a6aedbf9afcec3ef01a35be280da12d8e4a6a30e441da9606fcc0f7a38063","07196e2875293f0a01a7392639647d735142b569e87f1b337d747801c074c5c9"],"paragraph_range_zero_based":[1680,1703],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx:p1680"}
{"fields":{"filename":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"nr-dl-prs-AssistanceDataValidity-r17SEQUENCE {","paragraph_zero_based":1704},{"literal_text_all_w_t_and_m_t":"area-validity-r17INTEGER (1..maxNrOfAreas-r17)OPTIONAL,...","paragraph_zero_based":1705},{"literal_text_all_w_t_and_m_t":"}OPTIONAL,","paragraph_zero_based":1706},{"literal_text_all_w_t_and_m_t":"multiMeasInSameMeasReport-r17ENUMERATED { supported }OPTIONAL,","paragraph_zero_based":1707},{"literal_text_all_w_t_and_m_t":"mg-ActivationRequest-r17ENUMERATED { supported }OPTIONAL","paragraph_zero_based":1708},{"literal_text_all_w_t_and_m_t":"]],","paragraph_zero_based":1709},{"literal_text_all_w_t_and_m_t":"[[","paragraph_zero_based":1710},{"literal_text_all_w_t_and_m_t":"posMeasGapSupport-r17ENUMERATED { supported }OPTIONAL","paragraph_zero_based":1711},{"literal_text_all_w_t_and_m_t":"]]","paragraph_zero_based":1712},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":1713},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1714},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":1715},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1716},{"literal_text_all_w_t_and_m_t":"NR-DL-TDOA-ProvideCapabilities field descriptions","paragraph_zero_based":1717},{"literal_text_all_w_t_and_m_t":"nr-DL-TDOA-Mode","paragraph_zero_based":1718},{"literal_text_all_w_t_and_m_t":"This field specifies the NR DL-TDOA mode(s) supported by the target device.","paragraph_zero_based":1719},{"literal_text_all_w_t_and_m_t":"periodicalReporting","paragraph_zero_based":1720},{"literal_text_all_w_t_and_m_t":"This field, if present, specifies the positioning modes for which the target device supports periodicalReporting. This is represented by a bit string, with a onevalue at the bit position means periodicalReporting for the positioning mode is supported; a zerovalue means not supported. If this field is absent, the target device does not support periodicalReporting in CommonIEsRequestLocationInformation.","paragraph_zero_based":1721},{"literal_text_all_w_t_and_m_t":"ten-ms-unit-ResponseTime","paragraph_zero_based":1722},{"literal_text_all_w_t_and_m_t":"This field, if present, specifies the positioning modes for which the target device supports the enumerated value 'ten-milli-seconds' in the IE ResponseTime in IE CommonIEsRequestLocationInformation. This is represented by a bit string, with a onevalue at the bit position means 'ten-milli-seconds' response time unit for the positioning mode is supported; a zerovalue means not supported. If this field is absent, the target device does not support 'ten-milli-seconds' response time unit in CommonIEsRequestLocationInformation.","paragraph_zero_based":1723},{"literal_text_all_w_t_and_m_t":"nr-PosCalcAssistanceSupport","paragraph_zero_based":1724},{"literal_text_all_w_t_and_m_t":"This field indicates the Position Calculation Assistance Data supported by the target device for UE-based DL-TDOA. This is represented by a bit string, with a onevalue at the bit position means the particular assistance data is supported; a zerovalue means not supported.","paragraph_zero_based":1725},{"literal_text_all_w_t_and_m_t":"-bit 0 indicates whether the field nr-TRP-LocationInfo in IE NR-PositionCalculationAssistance is supported or not;","paragraph_zero_based":1726},{"literal_text_all_w_t_and_m_t":"-bit 1 indicates whether the field nr-DL-PRS-BeamInfo in IE NR-PositionCalculationAssistance is supported or not;","paragraph_zero_based":1727}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["c1374da005be36377c90471f5541cf96238e7e6eed2f3eef10fc2324422b78d1","18e5a01c29846d8ff81230734d2534a1d946e3b5699d6159207be9921c1950e7","4228e13b4d2591e873c5e2e72085ab1e5aa0762db005b60489a978141fac344f","286d82611d58eb6345ba804a42e79bbf7cb0758666174a64450bde4e5cf7af53","22d4a3e03dc6dbf3348bf31707735830504c63dea6be9a321d39b1eda0fdb1ac","44a67e179bd79c905f9f539d5b36c789a63698ca17f99633f8f33746179082bb","7c041f1b21f6a005a0fa9f4e8e6eed98835ffb6d6ccce4b7393e9b465a0f9b93","c700c5994a9ed9b54470603a4e30cccfc8be5661635d5b21afb0ce36f08af0ab","169fcd586d0ab8976e972cd09f6e98701303fefc660e5df70559ab0b207bf4d7","99d596aa12512fc2343a18eebc3f06f1dd70369de8a5d0bfb0432357822e93a4","cae0ac465ec01576a3a9261d4f6692ade82043417c2a3d374e5445fc664818e8","13aa4675551e06f60663ac1007b9d563e46ce2e24477b46ff0b7e84b8b444e34","436acdb50157beff8ec3ae3f4514784829e765c8ecf1d573a3293291c2079341","e616479b6459f59dc32269e6df9f1e7f9604d84a2ace1f992dac6d7db36db83d","14a28f74f3b1fc5cbfc1394ebf495fc2d488d45b03f6dcd7697ab4e722e4077a","e117eb5ac1cd8552dede6580156a53673588cfba287452b4e214c38d7fe06923","f241f1eabf171319be9e95a4e6e3f8916f60dbbd65e56c845bb09d7b21d10505","899264f19c7a49ca2a5f594b2d3cd5aa2858711e435a729b9b148d03fb112195","f305fd260172db2022a03ce08d48c7b10aba55ea3d3780069c301065eb205b6a","73e8b4a8c44f08bb48f4286c9f5f8074648855506eb422adda7311478cbcba91","392fb2b438fca548af6eff8f57cc425eccd106c3744e13149aae0cdfa03a7d56","4dcff494e4973c2d42d831975472ddd7221b594d93f09861370769f2480010f2","199547696e76271ed20760ef25e03f168a276050e776439a97c4900d1865038b","c945ca9a0123c969d86f86046c212d375f54e2eb2f8df3e4dd7e68401358227e"],"paragraph_range_zero_based":[1704,1727],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx:p1704"}
{"fields":{"filename":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-bit 2 indicates whether the field nr-RTD-Info in IE NR-PositionCalculationAssistance is supported or not;","paragraph_zero_based":1728},{"literal_text_all_w_t_and_m_t":"-bit 3 indicates whether the field nr-DL-PRS-TRP-TEG-Info in IE NR-PositionCalculationAssistance is supported or not. The UE can indicate this bit only if the UE supports prs-ProcessingCapabilityBandList and any of maxNrOfDL-PRS-ResourceSetPerTrpPerFrequencyLayer, maxNrOfTRP-AcrossFreqs, maxNrOfPosLayer, maxNrOfDL-PRS-ResourcesPerResourceSet and maxNrOfDL-PRS-ResourcesPerPositioningFrequencylayer. Otherwise, the UE does not include this field.","paragraph_zero_based":1729},{"literal_text_all_w_t_and_m_t":"nr-los-nlos-AssistanceDataSupport","paragraph_zero_based":1730},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device supports the NR-DL-PRS-ExpectedLOS-NLOS-Assistance in IE NR-PositionCalculationAssistance:","paragraph_zero_based":1731},{"literal_text_all_w_t_and_m_t":"-type indicates whether the target device supports 'hard' value or 'hard' and 'soft' value in LOS-NLOS-Indicator in IE NR-DL-PRS-ExpectedLOS-NLOS-Assistance.","paragraph_zero_based":1732},{"literal_text_all_w_t_and_m_t":"-granularity indicates whether the target device supports nr-los-nlos-indicator in IE NR-DL-PRS-ExpectedLOS-NLOS-Assistance 'per-trp', 'per-resource', or both.","paragraph_zero_based":1733},{"literal_text_all_w_t_and_m_t":"The UE can include this field only if the UE supports one of maxDL-PRS-RSRP-MeasurementFR1, maxDL-PRS-RSRP-MeasurementFR2, dl-RSTD-MeasurementPerPairOfTRP-FR1, dl-RSTD-MeasurementPerPairOfTRP-FR2, maxNrOfRx-TX-MeasFR1, maxNrOfRx-TX-MeasFR2, supportOfRSRP-MeasFR1 and supportOfRSRP-MeasFR2. Otherwise, the UE does not include this field.","paragraph_zero_based":1734},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-ExpectedAoD-or-AoA-Sup","paragraph_zero_based":1735},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device supports the NR-DL-PRS-ExpectedAoD-or-AoA in NR-DL-PRS-AssistanceData.","paragraph_zero_based":1736},{"literal_text_all_w_t_and_m_t":"nr-DL-TDOA-On-Demand-DL-PRS-Support","paragraph_zero_based":1737},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device supports on-demand DL-PRS requests. ","paragraph_zero_based":1738},{"literal_text_all_w_t_and_m_t":"nr-los-nlos-IndicatorSupport","paragraph_zero_based":1739},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device supports nr-los-nlos-Indicator reporting in IE NR-DL-TDOA-SignalMeasurementInformation.","paragraph_zero_based":1740},{"literal_text_all_w_t_and_m_t":"-type indicates whether the target device supports 'hard' value or 'hard' and 'soft' value in IE LOS-NLOS-Indicator.","paragraph_zero_based":1741},{"literal_text_all_w_t_and_m_t":"-granularity indicates whether the target device supports LOS-NLOS-Indicator reporting per TRP, per DL-PRS Resource, or both.","paragraph_zero_based":1742},{"literal_text_all_w_t_and_m_t":"NOTE:A single value is reported when both Multi-RTT and DL-TDOA are supported.","paragraph_zero_based":1743},{"literal_text_all_w_t_and_m_t":"additionalPathsExtSupport","paragraph_zero_based":1744},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device supports the nr-AdditionalPathListExt reporting in IE NR-DL-TDOA-SignalMeasurementInformation. The enumerated value indicates the number of additional paths supported by the target device.","paragraph_zero_based":1745},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1746},{"literal_text_all_w_t_and_m_t":"NOTE:The supportOfDL-PRS-FirstPathRSRP in IE NR-DL-TDOA-MeasurementCapability also applies to the additional paths.","paragraph_zero_based":1747},{"literal_text_all_w_t_and_m_t":"scheduledLocationRequestSupported","paragraph_zero_based":1748},{"literal_text_all_w_t_and_m_t":"This field, if present, specifies the positioning modes for which the target device supports scheduled location requests – i.e., supports the IE ScheduledLocationTime in IE CommonIEsRequestLocationInformation – and the time base(s) supported for the scheduled location time for each positioning mode. If this field is absent, the target device does not support scheduled location requests.","paragraph_zero_based":1749},{"literal_text_all_w_t_and_m_t":"nr-dl-prs-AssistanceDataValidity","paragraph_zero_based":1750},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device supports validity conditions for pre-configured assistance data and comprises the following subfields:","paragraph_zero_based":1751}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["0a7e3c102506cbe1646b28eba19cb61314b437df68e800bfa67bb0434c134648","84185c172decd9744c7e7c8e88ee23548beff5f32ea78dfd02bb4b58d6b354e8","caa8cdea6cafb702dc635014419a9f08e3278f99462cd053bfa61da349dcbf99","f7328b10c75c4ba2181bf55fb9ff0c1927f2bf1b3db81a42bcfbc6a08300992b","c98d0b8243796108dfd97e8a88807cf13dd30e583d8e8cc6b9af69873c60fc02","2af3a1258748ebd8517a309d04919f321bdb9003c63e75c10f6b13b426a06d04","1ba8d3adfa7741cd613f80ab465f2c725105d8cecfb0485c48ee10fdfb1ca19d","91620e602db732b8703b6fdd4293be3a9bd2a99c9105c16abccdc3c301b4f5f1","566451afeaabe8a7adda195837b8ab4fbec43291c603aae337d148205be45b33","b3f605331c309950fdd9060b96789cedff3546034c44691404fdd3c8ec5fc57f","219d844918799ea3785f64597f3ff83add13b8d2bc3842c4b6853191b1c75f1e","a3684882cac4c4f460d7b400ad230027e8262aadb44f723a71620649105ea82a","7abfe73c50e05fe62260840ab9cd1eda934d2ed831f43993046f2a20dad17fb8","29528e10d6bbb62827c94253a84e5c9b52a04dd96cbf6a8358c54cb7d0b09344","4ae3c7231abe1c8231661e9cbd758b1ad6a7fce1353c4710bbbdbb1562116714","d155e12897d75346398d4f28ddd0372725dde24d9b9fc0f62eac9a9790668fd0","6730937b8cc9aba4410f613a218dde3b4f840330c0be5323b9b1f4562a6d1c95","78749cfa7b39f7e9a2eedca5cc9cfa7ce155f73913d99e9d759b6a67c95498ee","ab3c705357750eb3cc4a85ecce678d0612b54a382f43474d6330b559f910686a","f190c6e60dd1a470231fdd335fe45a326cd289e722f26c664ae26e8777afee12","58da0c12ba67e360a501cfe67abf776636db7e766a7d6dda22a9fd9baca8a0d6","70ed87c6f084abe59a741c8ba956fd812083e8486c066794b07f96c181b473b3","e38400041d69ceff2b2361b9ea102ad31e510898ab7913cfb9de535fd9b82e02","83607961583c104eaa01ee6a62c8b5f6a5938129a8884c78fe14c10c3d85ea5b"],"paragraph_range_zero_based":[1728,1751],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx:p1728"}
{"fields":{"filename":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-area-validity indicates that the target device supports pre-configured assistance data with area validity. The integer number indicates the maximum number of areas the target device supports.","paragraph_zero_based":1752},{"literal_text_all_w_t_and_m_t":"multiMeasInSameMeasReport","paragraph_zero_based":1753},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device supports multiple measurement instances in a single measurement report.","paragraph_zero_based":1754},{"literal_text_all_w_t_and_m_t":"mg-ActivationRequest","paragraph_zero_based":1755},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device supports UL MAC CE for positioning measurement gap activation/deactivation request for DL-PRS measurements. The UE can include this field only if the UE supports mg-ActivationRequestPRS-Meas and mg-ActivationCommPRS-Meas defined in TS 38.331 [35].","paragraph_zero_based":1756},{"literal_text_all_w_t_and_m_t":"posMeasGapSupport","paragraph_zero_based":1757},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device supports pre-configured positioning measurement gap for DL-PRS measurements. The UE can include this field only if the UE supports mg-ActivationCommPRS-Meas defined in TS 38.331 [35].","paragraph_zero_based":1758},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1759},{"literal_text_all_w_t_and_m_t":"[...]","paragraph_zero_based":1760},{"literal_text_all_w_t_and_m_t":"6.5.11NR DL-AoD Positioning","paragraph_zero_based":1761},{"literal_text_all_w_t_and_m_t":"This clause defines the information elements for NR downlink AoD positioning (TS 38.305 [40]).","paragraph_zero_based":1762},{"literal_text_all_w_t_and_m_t":"6.5.11.1NR DL-AoD Assistance Data","paragraph_zero_based":1763},{"literal_text_all_w_t_and_m_t":"–NR-DL-AoD-ProvideAssistanceData","paragraph_zero_based":1764},{"literal_text_all_w_t_and_m_t":"The IE NR-DL-AoD-ProvideAssistanceData is used by the location server to provide assistance data to enable UEassisted and UE-based NR DL-AoD. It may also be used to provide NR DL-AoD positioning specific error reason.","paragraph_zero_based":1765},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":1766},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1767},{"literal_text_all_w_t_and_m_t":"NR-DL-AoD-ProvideAssistanceData-r16 ::= SEQUENCE {","paragraph_zero_based":1768},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-AssistanceData-r16NR-DL-PRS-AssistanceData-r16OPTIONAL,-- Need ON","paragraph_zero_based":1769},{"literal_text_all_w_t_and_m_t":"nr-SelectedDL-PRS-IndexList-r16NR-SelectedDL-PRS-IndexList-r16OPTIONAL,-- Need ON","paragraph_zero_based":1770},{"literal_text_all_w_t_and_m_t":"nr-PositionCalculationAssistance-r16","paragraph_zero_based":1771},{"literal_text_all_w_t_and_m_t":"NR-PositionCalculationAssistance-r16","paragraph_zero_based":1772},{"literal_text_all_w_t_and_m_t":"OPTIONAL,-- Cond UEB","paragraph_zero_based":1773},{"literal_text_all_w_t_and_m_t":"nr-DL-AoD-Error-r16NR-DL-AoD-Error-r16OPTIONAL,-- Need ON","paragraph_zero_based":1774},{"literal_text_all_w_t_and_m_t":"...,","paragraph_zero_based":1775}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["a15a1821b65f804273e9aed77c1f62faf47e25ada33fa17a9762ccef133e48ac","f4b6679d240ede500c3e2026245ff73c79fd825fc3e1bc8141ebf8972ce325fa","0a6b750a5c5f3b140c130f249bd784a99466911ec93840f6851254ec85d9a90a","2b9c155c312d40c248cc4715b71799e437