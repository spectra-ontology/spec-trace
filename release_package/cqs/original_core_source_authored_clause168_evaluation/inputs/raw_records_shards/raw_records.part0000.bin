{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"lpp-message-segmentation-r14BIT STRING { serverToTarget(0),","paragraph_zero_based":792},{"literal_text_all_w_t_and_m_t":"targetToServer(1) }OPTIONAL","paragraph_zero_based":793},{"literal_text_all_w_t_and_m_t":"]]","paragraph_zero_based":794},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":795},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":796},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":797},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":798},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":799},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":800},{"literal_text_all_w_t_and_m_t":"Segmentation","paragraph_zero_based":801},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need OP, if lpp-message-segmentation-req has been received from the location server with bit 1 (targetToServer) set to value 1. The field shall be omitted if lppmessagesegmentation-req has not been received in this location session, or has been received with bit 1 (targetToServer) set to value 0.","paragraph_zero_based":802},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":803},{"literal_text_all_w_t_and_m_t":"CommonIEsProvideCapabilities field descriptions","paragraph_zero_based":804},{"literal_text_all_w_t_and_m_t":"segmentationInfo","paragraph_zero_based":805},{"literal_text_all_w_t_and_m_t":"This field indicates whether this ProvideCapabilities message is one of many segments, as specified in clause 4.3.5.","paragraph_zero_based":806},{"literal_text_all_w_t_and_m_t":"lpp-message-segmentation","paragraph_zero_based":807},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates the target device's LPP message segmentation capabilities. If bit 0 is set to value 1, it indicates that the target device supports receiving segmented LPP messages; if bit 0 is set to value 0 it indicates that the target device does not support receiving segmented LPP messages.","paragraph_zero_based":808},{"literal_text_all_w_t_and_m_t":"If bit 1 is set to value 1, it indicates that the target device supports sending segmented LPP messages; if bit 1 is set to value 0 it indicates that the target device does not support sending segmented LPP messages.","paragraph_zero_based":809},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":810},{"literal_text_all_w_t_and_m_t":"–CommonIEsRequestAssistanceData","paragraph_zero_based":811},{"literal_text_all_w_t_and_m_t":"The CommonIEsRequestAssistanceData carries common IEs for a Request Assistance Data LPP message Type.","paragraph_zero_based":812},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":813},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":814},{"literal_text_all_w_t_and_m_t":"CommonIEsRequestAssistanceData ::= SEQUENCE {","paragraph_zero_based":815}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["3e367f3cc4ba24027d8e8a143057a2fbb7a678b701d9f7d3ef15ff14a06d98d9","fe25f5edf047d58c1efc5a373808db5bbf03d5c12d0077b4bf9b18a2d1d60d4d","d45bd8bd65c2f1eaf302977e01022bf09eadaa6b5ce965e625d5235aaf35f8b2","404c3f6b52b3df4340e8db7df36f3ebaa10dd2e77d9fd00989e5aa28eaa9073a","538e807bfa62a6e186213a18352a490e1d8635a2513158b83f4cf1070f76635b","448f2d9c6b239a0d78a2fa88698931ee1b6cb678a5cbd606a92470f583006eed","a1826dbb445e5b681e94f47f8ae4607ec9260cbe08b917aa9aade4c675748a80","32af4e15ad319aa0d1879281742f5ead385c4d76215e999038960b26ab8abd74","6c09feaac9a88e3b29000b