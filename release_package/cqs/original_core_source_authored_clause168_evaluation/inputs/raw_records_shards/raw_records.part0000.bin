{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SL-InterUE-CoordinationScheme2-r17 ::=    SEQUENCE {","paragraph_zero_based":38232},{"literal_text_all_w_t_and_m_t":"    sl-IUC-Scheme2-r17                        ENUMERATED {enabled}                                                 OPTIONAL,   -- Need R","paragraph_zero_based":38233},{"literal_text_all_w_t_and_m_t":"    sl-RB-SetPSFCH-r17                        BIT STRING (SIZE (10..275))                                          OPTIONAL,   -- Need M","paragraph_zero_based":38234},{"literal_text_all_w_t_and_m_t":"    sl-TypeUE-A-r17                           ENUMERATED {enabled}                                                 OPTIONAL,   -- Need R","paragraph_zero_based":38235},{"literal_text_all_w_t_and_m_t":"    sl-PSFCH-Occasion-r17                     INTEGER (0..1)                                                       OPTIONAL,   -- Need M","paragraph_zero_based":38236},{"literal_text_all_w_t_and_m_t":"    sl-SlotLevelResourceExclusion-r17         ENUMERATED {enabled}                                                 OPTIONAL,   -- Need R","paragraph_zero_based":38237},{"literal_text_all_w_t_and_m_t":"    sl-OptionForCondition2-A-1-r17            INTEGER (0..1)                                                       OPTIONAL,   -- Need M","paragraph_zero_based":38238},{"literal_text_all_w_t_and_m_t":"    sl-IndicationUE-B-r17                     ENUMERATED {enabled, disabled}                                       OPTIONAL,   -- Need M","paragraph_zero_based":38239},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":38240},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":38241},{"literal_text_all_w_t_and_m_t":"    sl-DeltaRSRP-Thresh-v1720                 INTEGER (-30..30)                                                    OPTIONAL    -- Need M","paragraph_zero_based":38242},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":38243},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":38244},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38245},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38246},{"literal_text_all_w_t_and_m_t":"SL-ThresholdRSRP-Condition1-B-1-r17 ::=   SEQUENCE {","paragraph_zero_based":38247},{"literal_text_all_w_t_and_m_t":"    sl-Priority-r17                           INTEGER (1..8),","paragraph_zero_based":38248},{"literal_text_all_w_t_and_m_t":"    sl-ThresholdRSRP-Condition1-B-1-r17       INTEGER (0..66)","paragraph_zero_based":38249},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":38250},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38251},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-INTERUE-COORDINATIONCONFIG-STOP","paragraph_zero_based":38252},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":38253},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38254},{"literal_text_all_w_t_and_m_t":"SL-InterUE-CoordinationScheme1 field descriptions","paragraph_zero_based":38255}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["a3a0677c5d3897d2ce72d1681fc3b87c7a1a512ca03a73c30ea3bcc0b6987a07","a8f00ed87840e90327ce6d2a801d0d64aa8ecac7610bbe11e92a6db62271ccb1","1235f30e41e07a68bd61352c2337fdfed7e70527ca42d5bf7d89b3f1f7692883","d426b630f9eaa7a34677b043d4c53bc91084aeac36d7f1908fb621033c4ece40","746cfb0e914e7eccac372ad4f8505379268f54a69a62b218ac629677ad2120c7","72b0806251703de63da212e6d23f8d4feb7d5ffa54b5b922cc2858789f3fc27a","af3fd9f5eb1430f7f705a6fee722b8dd707d0c05b12fb3ec88d8d3d42a50674f","1a7351d84e10f21a91b47d0c0bf39ac281a778c28be83f89b665095c47060a4a","8cfdf3893b5afd23c4f685eec58075de474c64ab691b55f25ff4e17b3219e2e7","0719fdcfb9d2a538e653cce900637c26965870719baf60402b4d8acf40692203","b0a13f7baf0778c3410246b9d9abd84de2654b479b16202f6fbc9cd427d355b5","f4a1822301e605fa947c7ce0175e26160b13c23d625f9e97f7ba929c5e292bf1","b0fe2989c116c63f3be45b73d9a99589acd9e0157d0188212f3c4d83913856e4","cc3a09121dc65d6e712d21e6df7cb66c106395832d2335839c9717b40c2b5a17","d0c6a4ff3325c342910853f08ad9946d807c6d4640d0cf2df3ccf1bfd41a5c39","3bb8ebb50ef7b0b9e42d70814b1c398dcfb0fa0014f8048eb202ffc882fe6377","655c9fd2847fc8f802b8c15becb85e9b8c7c25bb7adda629661a4f284040dfaa","58d61a99e2abde600b52710825018af757b30e164c6efc7d9b18b8aa33cfed08","b9cbe0f079fe932ef0befd57362922a616d45c9eac10fbc40624a2da40e18757","84184204760837f0f80d1452802476bf527b3687f9dc5a7bd222b3e88c979d8f","ceafa1f31eff31e60e7725f21b66917e3c4046cd7ec1235001371b06c16414f9","b57d9bd1326758bcb0bb18b7fc6e331bd20ebfbc60500d9af1ec917504963778","c1ec259f3416daa824c71480542288336a2055fe3419559fec4384c484f36969","bca1216d119c41a0986f6f81fc5d0a12f7709807732fb6d47782a58211bc9217"],"paragraph_range_zero_based":[38232,38255],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p38232"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-Condition1-A-2","paragraph_zero_based":38256},{"literal_text_all_w_t_and_m_t":"Indicates disabling the use of condition of excluding from preferred resource set resource(s) in slot(s) where UE-A, when it is intended receiver of UE-B, does not expect to perform SL reception from UE-B due to half duplex operation.","paragraph_zero_based":38257},{"literal_text_all_w_t_and_m_t":"sl-ContainerCoordInfo","paragraph_zero_based":38258},{"literal_text_all_w_t_and_m_t":"Indicates whether a SCI format 2-C can be used as the container of inter-UE coordination information transmission from UE-A to UE-B in Scheme 1 in addition to using MAC CE.","paragraph_zero_based":38259},{"literal_text_all_w_t_and_m_t":"sl-ContainerRequest","paragraph_zero_based":38260},{"literal_text_all_w_t_and_m_t":"Indicates whether a SCI format 2-C can be used as the container of an explicit request for inter-UE coordination information transmission from UE-B to UE-A in Scheme 1 in addition to using MAC CE.","paragraph_zero_based":38261},{"literal_text_all_w_t_and_m_t":"sl-DetermineResourceType","paragraph_zero_based":38262},{"literal_text_all_w_t_and_m_t":"Indicates how to determine the resource set type to be provided by inter-UE coordination information transmission. Value \"uea\" means the resource set type is determined by UE-A's implementation. Value \"ueb\" means the resource set type is determined by UE-B's request.","paragraph_zero_based":38263},{"literal_text_all_w_t_and_m_t":"sl-IUC-Condition","paragraph_zero_based":38264},{"literal_text_all_w_t_and_m_t":"Indicates whether inter-UE coordination information triggered by a condition is enabled or not other than explicit request reception.","paragraph_zero_based":38265},{"literal_text_all_w_t_and_m_t":"sl-IUC-Explicit","paragraph_zero_based":38266},{"literal_text_all_w_t_and_m_t":"Indicates whether inter-UE coordination information triggered by an explicit request is enabled or not. ","paragraph_zero_based":38267},{"literal_text_all_w_t_and_m_t":"sl-MaxSlotOffsetTRIV","paragraph_zero_based":38268},{"literal_text_all_w_t_and_m_t":"Indicates the maximum value of logical slot offset with respect to a reference slot that is used for representing the first resource location of each TRIV to indicate the set of resources in Scheme 1 as specified in TS 38.214 [19].","paragraph_zero_based":38269},{"literal_text_all_w_t_and_m_t":"sl-NumSubCH-PreferredResousrceSet","paragraph_zero_based":38270},{"literal_text_all_w_t_and_m_t":"Indicates the number of sub-channels used for determining the preferred resource set in Scheme 1 when the inter-UE coordination information transmission is triggered by a condition other than explicit request reception.","paragraph_zero_based":38271},{"literal_text_all_w_t_and_m_t":"sl-PriorityCoordInfoCondition","paragraph_zero_based":38272},{"literal_text_all_w_t_and_m_t":"Parameter used to determine the priority values for the purpose defined in TS 38.213 [13] and TS 38.214 [19] including, the priority value for sensing and candidate resource (re-)selection for transmitting the TB carrying the IUC MAC CE and the priority value in the SCI Format 1-A corresponding to the TB carrying the IUC MAC CE, triggered by a condition other than explicit request reception in Scheme 1. The priority value of IUC MAC CE used in LCP procedure (see TS 38.321 [3]) is fixed as \"1\".","paragraph_zero_based":38273},{"literal_text_all_w_t_and_m_t":"sl-PriorityCoordInfoExplicit","paragraph_zero_based":38274},{"literal_text_all_w_t_and_m_t":"Parameter used to determine the priority values for the purpose defined in TS 38.213 [13] and TS 38.214 [19] including, the priority value for sensing and candidate resource (re-)selection for transmitting the TB carrying the IUC MAC CE and the priority value in the SCI Format 1-A corresponding to the TB carrying the IUC MAC CE, triggered by an explicit request in Scheme 1. The priority value of IUC MAC CE used in LCP procedure (see TS 38.321 [3]) is fixed as \"1\".","paragraph_zero_based":38275},{"literal_text_all_w_t_and_m_t":"sl-PriorityPreferredResourceSet","paragraph_zero_based":38276},{"literal_text_all_w_t_and_m_t":"Indicates the priority value used for determining the preferred resource set in Scheme 1 when the inter-UE coordination information transmission is triggered by a condition other than explicit request reception.","paragraph_zero_based":38277},{"literal_text_all_w_t_and_m_t":"sl-PriorityRequest","paragraph_zero_based":38278},{"literal_text_all_w_t_and_m_t":"Parameter used to determine the priority values for the purpose defined in TS 38.213 [13] and TS 38.214 [19] including, the priority value for sensing and candidate resource (re-)selection for transmitting the TB carrying the IUC request MAC CE and the priority value in the SCI Format 1-A corresponding to the TB carrying the IUC request MAC CE, in an explicit request for inter-UE coordination information in Scheme 1. The priority value of IUC request MAC CE used in LCP procedure (see TS 38.321 [3]) is fixed as \"1\".","paragraph_zero_based":38279}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["85d1e9aff41075631145df84423a038b0607490a803ea5baf025b9bfd5912983","8941bac5e7b8d8c2fcad63e3bb5c59de1ede91f339bcf413c068b300da6481b3","61a4cb4af1218482edcdfe53510c26b8339f06c7145bba1876a2b104903e3c3f","686c6ed2614c907f8e4c8a552ad3e0c938919a0cf2d310eae49bfe0a6d2931e7","f5918c224721fc78215fab46e50ab497c6ef9760b8d6ccf3a91f25a528c9a87d","ff00858cb97d33b590de5feb0a07e78ef614640ae37ef18b3e62e1df7ca28992","e217ffd2e35a828e1eae2324875ea981bfdba8d48b52fa5b989eb188dfed3e86","8496ecbf32b37974cff3f4c3b18100e80cb5e46e3d7873b0805453abb44c6be0","1848deaac9d6558dd706ce8f85953f96b6de71cae73cb0aec6b6406ad5d70fb2","62731dc0b2c2a231a29d958b333c810623f63fc41540b3b89fb9ab856d62e25f","5282b36e535707498760aa90b87f4347892352e9213a17b4d7c142511cfa278f","0cf0c184fc5a6d343ce19aa55f858db8db5998373b83f1d86993a5376dc75437","d4d74b6aad3ddec39fd27ba3ee2b6aba4cacedfae0d0dcffed54bd182d2c933b","8efb1640ba3fe1c0c134b9d1baf7c7b56990576de336f96452d855a2340cbb70","286d5b15fb52aaad3eefd16ac91d2ca382f42d23ee94a41a00b7e8710d83ad8e","4cd077f6a9a7e773a0e3912e2b2f230f13ed0e31e7ac6e0294ce1b787b6c8195","6fbf15abb5e7f9ccd7ed44bae9d447d09a8f6772a1fea7f1d7de99202cfb9616","f937753fe3512e96fd83d0bf51e3d79f0d99bb0032a7a115c9b78196b1ab4892","6fa0ee0e4e4f2dd3202957efb7a7ecb65342d57b5ddbad1db348c816c3198a4a","532a4618c16c80203133f2502daf39d091da19a00c6a5e504816a2132e8b2215","e0d7b45d384243772b9a5f2419c42054c347cfd7d9cd2f0c8e5a1cb3eb0efe35","28a00f8704bea718133fea82ebdc6fb7f586462048958985466ad06ca8645967","68f3f1ef0b75558fb83d20407f1350a6675537d14d0be718cf339ef95b9fe90e","cb139c8254ddd76e4dd91e071f44f9c0f34aa79f8cd3feea7197580034bad835"],"paragraph_range_zero_based":[38256,38279],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p38256"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-ReservedPeriodPreferredResourceSet","paragraph_zero_based":38280},{"literal_text_all_w_t_and_m_t":"Indicates the resource reservation interval used for determining the preferred resource set in Scheme 1 when the inter-UE coordination information transmission is triggered by a condition, by means of an index to the corresponding entry of sl-ResourceReservePeriodList-r16. ","paragraph_zero_based":38281},{"literal_text_all_w_t_and_m_t":"sl-TriggerConditionCoordInfo","paragraph_zero_based":38282},{"literal_text_all_w_t_and_m_t":"Indicates the additional alternative trigger condition of inter-UE coordination information triggered by a condition rather than request reception in Scheme-1 from UE-A to UE-B. Value 0 means inter-UE coordination information is triggered by UE-A's implementation. Value 1 means inter-UE coordination information can be triggered only when UE-A has data to be transmitted together with the inter-UE coordination information to UE-B.","paragraph_zero_based":38283},{"literal_text_all_w_t_and_m_t":"sl-TriggerConditionRequest","paragraph_zero_based":38284},{"literal_text_all_w_t_and_m_t":"Indicates the trigger condition of an explicit request from UE-B to UE-A. Value 0 means the explicit request is triggered by UE-B's implementation. Value 1 means the explicit request can be triggered only when UE-B has data to be transmitted to UE-A.","paragraph_zero_based":38285},{"literal_text_all_w_t_and_m_t":"sl-ThresholdRSRP-Condition1-B-1-Option1List","paragraph_zero_based":38286},{"literal_text_all_w_t_and_m_t":"Indicates the RSRP threshold used to determine reserved resource(s) of other UE(s) whose RSRP measurement is larger than it as the set of resource(s) non-preferred for UE-B's transmission for Condition 1-B-1 of Scheme 1, as specified in TS 38.214 [19]. Value 0 corresponds to minus infinity dBm, value 1 corresponds to -128dBm, value 2 corresponds to -126dBm, value n corresponds to (-128 + (n-1)*2) dBm and so on, value 66 corresponds to infinity dBm.","paragraph_zero_based":38287},{"literal_text_all_w_t_and_m_t":"sl-ThresholdRSRP-Condition1-B-1-Option2List","paragraph_zero_based":38288},{"literal_text_all_w_t_and_m_t":"Indicates the RSRP threshold used to determine reserved resource(s) of other UE(s) whose RSRP measurement is smaller than it as the set of resource(s) non-preferred for UE-B's transmission for Condition 1-B-1 of Scheme 1, as specified in TS 38.214 [19]. Value 0 corresponds to minus infinity dBm, value 1 corresponds to -128dBm, value 2 corresponds to -126dBm, value n corresponds to (-128 + (n-1)*2) dBm and so on, value 66 corresponds to infinity dBm.","paragraph_zero_based":38289},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38290},{"literal_text_all_w_t_and_m_t":"SL-InterUE-CoordinationScheme2 field descriptions","paragraph_zero_based":38291},{"literal_text_all_w_t_and_m_t":"sl-DeltaRSRP-Thresh","paragraph_zero_based":38292},{"literal_text_all_w_t_and_m_t":"Indicates the RSRP threshold delta value corresponding to deltaRSRPThresh specified in clause 16.3.0 of TS 38.213 [13] and used to determine reserved resource(s) of other UE(s). Value in dB. Only even values (step size 2) allowed.","paragraph_zero_based":38293},{"literal_text_all_w_t_and_m_t":"sl-IndicationUE-B","paragraph_zero_based":38294},{"literal_text_all_w_t_and_m_t":"Indicates whether to enable or disable the usage of 1 LSB of reserved bits of a SCI format 1-A to indicate of whether UE scheduling a conflict TB can be UE-B or not.","paragraph_zero_based":38295},{"literal_text_all_w_t_and_m_t":"sl-IUC-Scheme2","paragraph_zero_based":38296},{"literal_text_all_w_t_and_m_t":"Indicates whether inter-UE coordination Scheme 2 is enabled or not.","paragraph_zero_based":38297},{"literal_text_all_w_t_and_m_t":"sl-OptionForCondition2-A-1","paragraph_zero_based":38298},{"literal_text_all_w_t_and_m_t":"Indicates the RSRP threshold used to consider additional criteria for condition 2-A-1. Value 0 corresponds to using the RSRP threshold according to the priorities included in the SCI, UE uses thresholds sl-Thres-RSRP-List, in its resource pool configuration sl-UE-SelectedConfigRP, corresponding to ThresPSSCH-RSRP-List specified in clause 16.3.0 of TS 38.213 [13]. Value 1 corresponds to using a (pre)configured RSRP threshold delta value sl-DeltaRSRP-Thresh, corresponding to deltaRSRPThresh specified in clause 16.3.0 of TS 38.213 [13].","paragraph_zero_based":38299},{"literal_text_all_w_t_and_m_t":"sl-PSFCH-Occasion","paragraph_zero_based":38300},{"literal_text_all_w_t_and_m_t":"Indicates the reference slot from which a PSFCH occasion for inter-UE coordination information transmission is derived. Value 0 corresponds to the slot where UE-B's SCI is transmitted and value 1 corresponds to the slot where expected/potential resource conflict occurs on PSSCH resource indicated by UE-B's SCI.","paragraph_zero_based":38301},{"literal_text_all_w_t_and_m_t":"sl-RB-SetPSFCH","paragraph_zero_based":38302},{"literal_text_all_w_t_and_m_t":"Indicates the set of PRBs that are actually used for inter-UE coordination information transmission and reception in Scheme 2. The leftmost bit of the bitmap refers to the lowest RB index in the resource pool, and so on.","paragraph_zero_based":38303}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["018ff1b7f0b4ce72258e066623f78c782c85b181bd0872c44bf6e1f86cfa450c","56e4365109952954741c0ac1a3713db8247933755027029f43e4ea651280dbc7","b2b27f67796864512001434d06a4a4968e70d453d889a91872af71c0122627d7","588e6f9838b3e005b7d1edf42fb54275ba566ce62ff523acbc4e6845daa4cff7","29a4c66b77ec26d8cb314a161924a2bd1b2e682c4bf259a58725461402c6469a","c797ffbb11da77dfd7e41e6b9c19c21c0777987cacc0253df65e4974410a5e36","b00fce34306dcc7740a7b03abf948ad8836e1fbf7a64fae9ae715e4e212ed009","9c005eedbc482938e97d419bb6ec99770d16865c52eb500c26c77d55137814b3","259343ddd467463442da2c020f4c62471df1bc70579a565e6e1a5d2ee3a3015a","d978be6d0454989ac60477480145a3824d3e289017f5d54a2ea82132f1a3550c","31903a1cae93f9b29da0bbdb0d9331d92c04494220fda47d66cafcfbfc704ce7","3e83696338b85b5e8d9374f99b735a00b0597fba58f73e61dcdac448005917e8","037e0b856cc9e330becffbeea28778dd96ab2cb6215899a71267495d3d0f1f14","ded00878b1b83638ea4efb6108085082e2102ba4a65c937bf93ff43b988bdd53","d287f7f6840b2eb4cc83c6085494bdf4f963f4087e62bccfbb3d3df43a067092","ef8e52fa29d33a62027473a5707a0ecb99abcf98dc98cc3d8b5b6d16475c3547","0ea915f34e7ebb5210096c7d208bde35b962dc59fa012b7b5b3fe5f5be5be7a6","2a06659abb4624f946b5b0e2c28871f5f33e44a521585fa0a94401af8989db4f","9e9a2b4341ac93cddc5bb692478b3b51a3c5cf58786c8e757d5053c12fae7218","911becd72b7b6d9055ce35e8282a5377976c3fb6e8c6c5c4be025be7a7e5a585","981c240f99edc263e31178f2f7336edd7ee7482969a1afdca6c12fee9555a56d","99d3bb610d766d4e9346cf0f2e737a77f84cb65fffc0ac9fd9b94114f6d66adf","0aa2e84af21996c44f726547a973cdeada07d53142a73a4903c4d13151554f87","73233c5d9c27a1fe9c5bb25719fd2742185fabb6b6929d76050d66286e28ec62"],"paragraph_range_zero_based":[38280,38303],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p38280"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-SlotLevelResourceExclusion","paragraph_zero_based":38304},{"literal_text_all_w_t_and_m_t":"Indicates that physical layer of UE-B reports resources in a slot including the next reserved resource indicated by the corresponding UE-B's SCI to higher layer.","paragraph_zero_based":38305},{"literal_text_all_w_t_and_m_t":"sl-TypeUE-A","paragraph_zero_based":38306},{"literal_text_all_w_t_and_m_t":"Indicates that a non-destination UE of a TB transmitted by UE-B can be UE-A which sends inter-UE coordination information to UE-B, when UE-A is a destination UE of another TB conflicting with the TB transmitted by UE-B.","paragraph_zero_based":38307},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38308},{"literal_text_all_w_t_and_m_t":"–SL-LogicalChannelConfig","paragraph_zero_based":38309},{"literal_text_all_w_t_and_m_t":"The IE SL-LogicalChannelConfig is used to configure the sidelink logical channel parameters.","paragraph_zero_based":38310},{"literal_text_all_w_t_and_m_t":"SL-LogicalChannelConfig information element","paragraph_zero_based":38311},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":38312},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-LOGICALCHANNELCONFIG-START","paragraph_zero_based":38313},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38314},{"literal_text_all_w_t_and_m_t":"SL-LogicalChannelConfig-r16 ::=            SEQUENCE {","paragraph_zero_based":38315},{"literal_text_all_w_t_and_m_t":"    sl-Priority-r16                            INTEGER (1..8),","paragraph_zero_based":38316},{"literal_text_all_w_t_and_m_t":"    sl-PrioritisedBitRate-r16                  ENUMERATED {kBps0, kBps8, kBps16, kBps32, kBps64, kBps128, kBps256, kBps512,","paragraph_zero_based":38317},{"literal_text_all_w_t_and_m_t":"                                               kBps1024, kBps2048, kBps4096, kBps8192, kBps16384, kBps32768, kBps65536, infinity},","paragraph_zero_based":38318},{"literal_text_all_w_t_and_m_t":"    sl-BucketSizeDuration-r16                  ENUMERATED {ms5, ms10, ms20, ms50, ms100, ms150, ms300, ms500, ms1000,","paragraph_zero_based":38319},{"literal_text_all_w_t_and_m_t":"                                               spare7, spare6, spare5, spare4, spare3,spare2, spare1},","paragraph_zero_based":38320},{"literal_text_all_w_t_and_m_t":"    sl-ConfiguredGrantType1Allowed-r16         ENUMERATED {true}                                                        OPTIONAL,   -- Need R","paragraph_zero_based":38321},{"literal_text_all_w_t_and_m_t":"    sl-HARQ-FeedbackEnabled-r16                ENUMERATED {enabled, disabled }                                          OPTIONAL,   -- Need R","paragraph_zero_based":38322},{"literal_text_all_w_t_and_m_t":"    sl-AllowedCG-List-r16                      SEQUENCE (SIZE (0.. maxNrofCG-SL-1-r16)) OF SL-ConfigIndexCG-r16","paragraph_zero_based":38323},{"literal_text_all_w_t_and_m_t":"                                                                                                                        OPTIONAL,   -- Need R","paragraph_zero_based":38324},{"literal_text_all_w_t_and_m_t":"    sl-AllowedSCS-List-r16                     SEQUENCE (SIZE (1..maxSCSs)) OF SubcarrierSpacing                        OPTIONAL,   -- Need R","paragraph_zero_based":38325},{"literal_text_all_w_t_and_m_t":"    sl-MaxPUSCH-Duration-r16                   ENUMERATED {ms0p02, ms0p04, ms0p0625, ms0p125, ms0p25, ms0p5, spare2, spare1}","paragraph_zero_based":38326},{"literal_text_all_w_t_and_m_t":"                                                                                                                        OPTIONAL,   -- Need R","paragraph_zero_based":38327}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["4bc9297f4874c744a9007c0090e2a8e63093b8921dadf713e2309c960ad8c129","f6e7aae435a30a7953092de3add0b4a128661d82ecc71437b2f0124f8805abeb","370f16ac8847695c48a59b526a5846eabee1d92b3ac17798dde536ec416c954e","e112e0c2cc85cc2cb9cbe0b6786e15f4286a629bad96cceac2fcb9567e8a2ec9","2082dfbce32837cd543abd8cd632e4c3c43c94a4797d977a8b940a4a42f32bf1","b9cf9485951cb6e7b0528415851656c28e1d313875a1cc7a92f2b001108d8b3a","2ab3190952c61efea992f7212c7f2b008210acb65420acc643f2dfd7b49b5aae","8d6707891e921bab9743589b05910ab52c1f62e42f579f698b6eedd22d6bd691","8235c86f258b503b2886484ee97449fd346efa57c4089ab05e2d20dff17055e3","f189cd251353e4d70b551899d675dd7e01d9ac9658b9a96b91dda03b18efb955","94a90036d88ea6c2b705c692c6fc8abe02cd10549e7e7c385bf05e40f4bcee98","c93be2e6a3ae9385ec4b18685fbdd06f379ea05af9b4038f6163a20a1e2ca95f","e5333febb0eace42aac395645f1c202bc20237bad02b986c9c57e88f66aa15c9","321f531a24ebe7789b7c7863cded666cb4c58b310d290d2fb9cd1364947c61aa","ebf4003b251fa9c0da2a87d4391916946df9a4de9ce113e68c1d0de3254ba147","31bdef32160bc2124630ae8016793cdd3e88b40476a7c1b0203c7647d228cb29","bf39e113bcd53f27706cc7dd07cf90f494c3e4d7e4e006d1181bfa69a5848c61","7bb0d745567acd065c90cad1003ed75e81cfb58cba2fb5681dcbeaeffc2c17ae","5a46c5579a2ecf6dc2b8abe9ffde012568707c4c4bdb325b15c78b0fd3864c0a","eadd22594ee7f7d8caf61f9759b61e75c8085f339711e363259f600aaaaaeae4","36991a629d2c4b4fbf7b4588e36a3ac50439c9ec32d78f3a2e3c249c724c03cd","75526f44559e8add429ebbf0909b0d4ac61e2c99ecf667b075fabc0c702cf514","7d6e2ae2ab11d00969cb56687028536624085bbe4510e11faf26944008f6af0a","898a0d3e9aba32ad8fd51e333a30a07772d87c64af8866fa6eb8113d1c085379"],"paragraph_range_zero_based":[38304,38327],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p38304"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    sl-LogicalChannelGroup-r16                 INTEGER (0..maxLCG-ID)                                                   OPTIONAL,   -- Need R","paragraph_zero_based":38328},{"literal_text_all_w_t_and_m_t":"    sl-SchedulingRequestId-r16                 SchedulingRequestId                                                      OPTIONAL,   -- Need R","paragraph_zero_based":38329},{"literal_text_all_w_t_and_m_t":"    sl-LogicalChannelSR-DelayTimerApplied-r16  BOOLEAN                                                                  OPTIONAL,   -- Need R","paragraph_zero_based":38330},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":38331},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":38332},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-LOGICALCHANNELCONFIG-STOP","paragraph_zero_based":38333},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":38334},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38335},{"literal_text_all_w_t_and_m_t":"SL-LogicalChannelConfig field descriptions","paragraph_zero_based":38336},{"literal_text_all_w_t_and_m_t":"sl-AllowedCG-List","paragraph_zero_based":38337},{"literal_text_all_w_t_and_m_t":"This restriction applies only when the SL grant is a configured grant. If present, SL MAC SDUs from this logical channel can only be mapped to the indicated configured grant configuration. If the size of the sequence is zero, then SL MAC SDUs from this logical channel cannot be mapped to any configured grant configurations. If the field is not present, SL MAC SDUs from this logical channel can be mapped to any configured grant configurations. If the field sl-ConfiguredGrantType1Allowed is present, only those sidelink configured grant type 1 configurations indicated in this sequence are allowed for use by this sidelink logical channel; otherwise, this sequence shall not include any sidelink configured grant type 1 configuration. Corresponds to \"sl-AllowedCG-List\" as specified in TS 38.321 [3].","paragraph_zero_based":38338},{"literal_text_all_w_t_and_m_t":"sl-AllowedSCS-List","paragraph_zero_based":38339},{"literal_text_all_w_t_and_m_t":"If present, indicate the numerology of UL-SCH resources that this sidelink logical channel is mapped to, when checking the SR trigger condition. Corresponds to ' sl-AllowedSCS-List' in TS 38.321 [3].","paragraph_zero_based":38340},{"literal_text_all_w_t_and_m_t":"sl-BucketSizeDuration","paragraph_zero_based":38341},{"literal_text_all_w_t_and_m_t":"Value in ms. ms5 corresponds to 5 ms, value ms10 corresponds to 10 ms, and so on.","paragraph_zero_based":38342},{"literal_text_all_w_t_and_m_t":"sl-ConfiguredGrantType1Allowed","paragraph_zero_based":38343},{"literal_text_all_w_t_and_m_t":"If present and set to true, or if the capability lcp-RestrictionSidelink as specified in TS 38.306 [26] is not indicated, SL MAC SDUs from this sidelink logical channel can be transmitted on a sidelink configured grant type 1. Otherwise, SL MAC SDUs from this logical channel cannot be transmitted on a sidelink configured grant type 1. Corresponds to 'sl-configuredGrantType1Allowed' in TS 38.321 [3].","paragraph_zero_based":38344},{"literal_text_all_w_t_and_m_t":"sl-HARQ-FeedbackEnabled","paragraph_zero_based":38345},{"literal_text_all_w_t_and_m_t":"Network always includes this field. It indicates the HARQ feedback enabled/disabled restriction in LCP for this sidelink logical channel. If set to enabled, the sidelink logical channel will be multiplexed only with a logical channel which enabling the HARQ feedback. If set to disabled, the sidelink logical channel cannot be multiplexed with a logical channel which enabling the HARQ feedback. Corresponds to 'sl-HARQ-FeedbackEnabled' in TS 38.321 [3]. If this field of at least one sidelink logical channel for the UE is set to enabled, sl-PSFCH-Config should be mandatory present in configuration SL-ResourcePool of at least one of the sidelink resource pools.","paragraph_zero_based":38346},{"literal_text_all_w_t_and_m_t":"sl-LogicalChannelGroup","paragraph_zero_based":38347},{"literal_text_all_w_t_and_m_t":"ID of the sidelink logical channel group, as specified in TS 38.321 [3], which the sidelink logical channel belongs to.","paragraph_zero_based":38348},{"literal_text_all_w_t_and_m_t":"sl-LogicalChannelSR-DelayTimerApplied","paragraph_zero_based":38349},{"literal_text_all_w_t_and_m_t":"Indicates whether to apply the delay timer for SR transmission for this sidelink logical channel. Set to false if logicalChannelSR-DelayTimer is not included in sl-BSR-Config.","paragraph_zero_based":38350},{"literal_text_all_w_t_and_m_t":"sl-MaxPUSCH-Duration","paragraph_zero_based":38351}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["0bdd930af0263454adfa100d918366d52cd4bb12ae9c2505327954c626c34c12","fd2dc365f3efd4854d1e192da1e06a4090d3afcb8ab236667673dc8c839eb106","0a3126407bd8c347425eb6a56f29d2c278ab34a93944a7aec2e89e7d3bb01643","198de8a4605cce26817699b84cc1e7780f005f5054ab72bfe5271aa8f815d789","8fa3f7e2a3dc258940ae4960821864303c82c90a83171f71251790d094f05cb4","bc424e4ff1166c60a7b700ddd13479a51aba52ead7585c62c61c851ef037daee","7444ecf487691109e5e383ed90675ea5d45f5fc6425ecf85f8baa8d0d46b6d0b","7530bf8aa18f610244114ccc4114c8ef1ca227834c36154fbf347e96380988d7","dc86026d19e0245cace2d537e21cfeeba5c69eaa2453fee3a075cd763232a5d1","80e6eecf21e7fb3d0e7c9f0462b2ad301b68911a02904347f9824e3ac7964670","5a184e062f2ff9290ac00b97f31103d76c34f41cc1749456744f851875ec6ed9","a6181ee0afb46741e75b