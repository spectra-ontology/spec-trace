{"fields":{"filename":"R2-2312499.zip::R2-2312499_38.331_Rel-18_SL_relay_service_continuity.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>set the numberOfReportsSent defined within the VarMeasReportList for this measId to 0;","paragraph_zero_based":288},{"literal_text_all_w_t_and_m_t":"3>initiate the measurement reporting procedure, as specified in 5.5.5;","paragraph_zero_based":289},{"literal_text_all_w_t_and_m_t":"2>upon expiry of the periodical reporting timer for this measId:","paragraph_zero_based":290},{"literal_text_all_w_t_and_m_t":"3>initiate the measurement reporting procedure, as specified in 5.5.5.","paragraph_zero_based":291},{"literal_text_all_w_t_and_m_t":"2>if the corresponding reportConfig includes a reportType is set to reportSFTD:","paragraph_zero_based":292},{"literal_text_all_w_t_and_m_t":"3>if the corresponding measObject concerns NR:","paragraph_zero_based":293},{"literal_text_all_w_t_and_m_t":"4>if the drx-SFTD-NeighMeas is included:","paragraph_zero_based":294},{"literal_text_all_w_t_and_m_t":"5>if the quantity to be reported becomes available for each requested pair of PCell and NR cell:","paragraph_zero_based":295},{"literal_text_all_w_t_and_m_t":"6>stop timer T322;","paragraph_zero_based":296},{"literal_text_all_w_t_and_m_t":"6>initiate the measurement reporting procedure, as specified in 5.5.5;","paragraph_zero_based":297},{"literal_text_all_w_t_and_m_t":"4>else","paragraph_zero_based":298},{"literal_text_all_w_t_and_m_t":"5>initiate the measurement reporting procedure, as specified in 5.5.5, immediately after the quantity to be reported becomes available for each requested pair of PCell and NR cell or the maximal measurement reporting delay as specified in TS 38.133 [14];","paragraph_zero_based":299},{"literal_text_all_w_t_and_m_t":"3>else if the corresponding measObject concerns E-UTRA:","paragraph_zero_based":300},{"literal_text_all_w_t_and_m_t":"4>initiate the measurement reporting procedure, as specified in 5.5.5, immediately after the quantity to be reported becomes available for the pair of PCell and E-UTRA PSCell or the maximal measurement reporting delay as specified in TS 38.133 [14];","paragraph_zero_based":301},{"literal_text_all_w_t_and_m_t":"2>if reportType is set to reportCGI:","paragraph_zero_based":302},{"literal_text_all_w_t_and_m_t":"3>if the UE acquired the SIB1 or SystemInformationBlockType1 for the requested cell; or","paragraph_zero_based":303},{"literal_text_all_w_t_and_m_t":"3>if the UE detects that the requested NR cell is not transmitting SIB1 (see TS 38.213 [13], clause 13):","paragraph_zero_based":304},{"literal_text_all_w_t_and_m_t":"4>stop timer T321;","paragraph_zero_based":305},{"literal_text_all_w_t_and_m_t":"4>include a measurement reporting entry within the VarMeasReportList for this measId;","paragraph_zero_based":306},{"literal_text_all_w_t_and_m_t":"4>set the numberOfReportsSent defined within the VarMeasReportList for this measId to 0;","paragraph_zero_based":307},{"literal_text_all_w_t_and_m_t":"4>initiate the measurement reporting procedure, as specified in 5.5.5;","paragraph_zero_based":308},{"literal_text_all_w_t_and_m_t":"2>upon the expiry of T321 for this measId:","paragraph_zero_based":309},{"literal_text_all_w_t_and_m_t":"3>include a measurement reporting entry within the VarMeasReportList for this measId;","paragraph_zero_based":310},{"literal_text_all_w_t_and_m_t":"3>set the numberOfReportsSent defined within the VarMeasReportList for this measId to 0;","paragraph_zero_based":311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"78722f96da2c1b0794be02771e6d00815867826bc913cd2dc90778e7cf20a03c","original_member_sha256":"01249659941507b71cdd3a9a4350d5330966e5252dc21fbfc70854bb5a08b2f1","paragraph_ElementTree_utf8_XML_sha256":["10b2d3d720e2c80d02352e2bd6b2159ed874a4668632094fbb51da5023012ee0","4d4ea132ca5526a6caca8a1e2219b650e1bb4e9ca17d0490ce139c03c726fcf0","ce8e9def53b1ebeae5eb954c243fc9d0020058d06ba5874f017d54aec2d8a289","cdbbc7b22b3977e39312a289cc77fdc034dad70fbc8dfda7014ec148a7adb78f","fcf00f4b604d7e0a91b08a87c1dd7520dfb5d4670473b65c5cadc865103fd910","7252128dcdebfc9356fbe5dcfd142840bb77e1fc0aea590d8ece60fc0bd918df","335126166e2de4cd49289aefc102465e8592777e5e449475449e2da1a1687bfe","c305d5cb6c04dfff570af906a431126b0c30f52c16b1e004f3dec0be63a7b72b","6fc962fb15a5d199af2d6105559a450e48af23d222296aa87ecfadb7b0e531f6","7afd1a92688130667adf0d122703cef447d5c171caf993799e5fabd9ab4d0bf0","2361c0afae438c7345a20c117a2143123dc730a74ddb28cbfe1b6411242b2e52","ae067c17a807d35508df75515049761127992e80d60ea8a40c244b3ddca360f0","855081e1c880f7c9186e12039f81ba3230f67faaec85fe20159ce79aa0d51159","8e0daa51798c6629de60e24363b1438c54e9d2de43cfd6ac7d66ba919b4e27ca","89209623d2c38fb9573361835eb6cba80abcefede11dc8e4a7ca5a802f56f3b1","ef467c15d039e71af14b0da3c508dfc4f1ff1690a4c2d330bdc82d89e6499981","4c401174aea1d5f41ed52e42ea0a02f73546e9efe1858e5f3a33ae10bf000002","1a63d424937c5874fadcc2727e5dfebf1776466c88fbe8eea91b25acdbf81db6","67160d0a650089f2bdfa1f18d1797de21a54ade08000640dc9d7b198255b7bc1","5814dc1db656f4b14c0469f2027cc6d2a6b2c138623d1d49ab671cea350d47f9","f4061ffe9764677c267c8134ff7205a3ae7742e16ae98e0e9fc50866c590beda","c7e40f23b358a971a7979c1ffde5e2ed20fc6717554171cf2f9d657d191dc6f5","442487d999728a957b3d98b7c121f2efa1d91cfae0110e9c4b263202862d965c","271af4c2d02b7af73f91511be0863deb0167438b5c6d073e263b6aa8767f2463"],"paragraph_range_zero_based":[288,311],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312499.zip::R2-2312499_38.331_Rel-18_SL_relay_service_continuity.docx:p288"}
{"fields":{"filename":"R2-2312499.zip::R2-2312499_38.331_Rel-18_SL_relay_service_continuity.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>initiate the measurement reporting procedure, as specified in 5.5.5.","paragraph_zero_based":312},{"literal_text_all_w_t_and_m_t":"2>upon the expiry of T322 for this measId:","paragraph_zero_based":313},{"literal_text_all_w_t_and_m_t":"3>initiate the measurement reporting procedure, as specified in 5.5.5.","paragraph_zero_based":314},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":315},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":316},{"literal_text_all_w_t_and_m_t":"NEXT CHANGE","paragraph_zero_based":317},{"literal_text_all_w_t_and_m_t":"5.5.4.XXEvent Z1 (Serving L2 U2N Relay UE becomes worse than threshold1 and Candidate L2 U2N Relay UE becomes better than threshold2)","paragraph_zero_based":318},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":319},{"literal_text_all_w_t_and_m_t":"1>consider the entering condition for this event to be satisfied when both condition Z1-1 and condition Z1-2, as specified below, are fulfilled;","paragraph_zero_based":320},{"literal_text_all_w_t_and_m_t":"1>consider the leaving condition for this event to be satisfied when condition Z1-3 or condition Z1-4, i.e. at least one of the two, as specified below, is fulfilled;","paragraph_zero_based":321},{"literal_text_all_w_t_and_m_t":"Inequality Z1-1 (Entering condition 1)","paragraph_zero_based":322},{"literal_text_all_w_t_and_m_t":"Mr + Hys < Thresh1","paragraph_zero_based":323},{"literal_text_all_w_t_and_m_t":"Inequality Z1-2 (Entering condition 2)","paragraph_zero_based":324},{"literal_text_all_w_t_and_m_t":"Mn – Hys > Thresh2","paragraph_zero_based":325},{"literal_text_all_w_t_and_m_t":"Inequality Z1-3 (Leaving condition 1)","paragraph_zero_based":326},{"literal_text_all_w_t_and_m_t":"Mr – Hys > Thresh1","paragraph_zero_based":327},{"literal_text_all_w_t_and_m_t":"Inequality Z1-4 (Leaving condition 2)","paragraph_zero_based":328},{"literal_text_all_w_t_and_m_t":"Mn + Hys < Thresh2","paragraph_zero_based":329},{"literal_text_all_w_t_and_m_t":"The variables in the formula are defined as follows:","paragraph_zero_based":330},{"literal_text_all_w_t_and_m_t":"Mr is the measurement result of the serving L2 U2N Relay UE, not taking into account any offsets.","paragraph_zero_based":331},{"literal_text_all_w_t_and_m_t":"Mn is the measurement result of the candidate L2 U2N Relay UE, not taking into account any offsets.","paragraph_zero_based":332},{"literal_text_all_w_t_and_m_t":"Hys is the hysteresis parameter for this event (i.e. hysteresis as defined within reportConfigInterRAT for this event).","paragraph_zero_based":333},{"literal_text_all_w_t_and_m_t":"Thresh1 is the threshold parameter for this event (i.e. sl-rsrp in z1-Threshold1-Relay as defined within reportConfigInterRAT if the UE measures SL-RSRP, or sd-rsrp in z1-Threshold1-Relay as defined within reportConfigInterRAT if the UE measures SD-RSRP for this event).","paragraph_zero_based":334},{"literal_text_all_w_t_and_m_t":"Thresh2 is the threshold parameter for this event (i.e. z1-Threshold2-Relay as defined within reportConfigInterRAT for this event).","paragraph_zero_based":335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"78722f96da2c1b0794be02771e6d00815867826bc913cd2dc90778e7cf20a03c","original_member_sha256":"01249659941507b71cdd3a9a4350d5330966e5252dc21fbfc70854bb5a08b2f1","paragraph_ElementTree_utf8_XML_sha256":["8856be8c9a3a2da224511126a35f248ea959dee79db33cc739b85bd727523d10","36b8502404757a285b8ce135010434efdeca5ceb4ded920720fbdeb5acdf30d1","01d47f3d02207ff5b505fff88eaa77c1e77c07f9376283f94eadcb16a372ef17","3f2d3a63554ace6250a3b7f0732f75d815d722b27e8fac260416d53ee2054a93","16ecc42e8f378efdf5f02b452991f88e93e12b53033c60b2c63490bebba4dcc8","da4e070091b66332f41a7aec19d1b9392983010365cf59fef5b65580bf4aa113","77c1206b27e44658d5f716aed1d86711f1d8b4ff8e164aab276f6180f046f703","2aff447c8cbb6dba0de549051b9030c2e46962bdf2d4bdfb38cc3c4707fbdc8f","afc18c4b1f5d853af90ad9ce5b7aa329d773af711c2d80d30cd652832a85e237","c7502b1dd11dfea81a06876d5c01d3589670e4a91cb54115a80af08892f2fc61","8dfbc6d36a7ecad61b6a82b63ce412db6d30f50d12b69267a6390cc1ce1eb64d","aba6da168e8a7c1a6881ac9a3ef9216b18f344a39b7763df35b36799109d2f17","194673689d76c87d0b18d0a9e38a8ee4e891a4a41b04256bbc2353039de0c5be","3d9e3f384829f1f5fdd195c36041b9730abc54202a5631f2f04426b3533c7fd4","b32ab41f607ae451df717265950a37c4a1f200b26e199d7e3ecae8fcdb3e8ce6","8f6dd612458893cb89aee8f61760ef2c22e724982f9f92ef629cb18335604411","11f0816ed28641443ae23bb3005e0115cc1eafc29d0e433a54f21c9c4af1e80c","a68e553042f6e64183708f3384767347e3013bc0beb8ea29fe7ea36a982bcb60","59db86fe5b6aaea7b91c23e969547cc4f428f263e81cfe657db5619e63100b8e","b939da0800d939bda2a999beaa1d2860743e821814ee7e709e20fd9db6718a8f","cf94ef905252fb412c39aea7ef0d7201d916c6699259b90dd0899193dbb1a15a","2714d1eb9094d82ccc30cd5b1bc8ca91cb2d191975227a85cef870de155cb4b6","adc9aca1de0a3de6e2762b9dff06c0d2795ee52dac105f99a060a239b4ed0c37","e591246c7f3addc7e474c4326def6c4a83e6fcd7d8177b3cd2a461ba8f457e8c"],"paragraph_range_zero_based":[312,335],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312499.zip::R2-2312499_38.331_Rel-18_SL_relay_service_continuity.docx:p312"}
{"fields":{"filename":"R2-2312499.zip::R2-2312499_38.331_Rel-18_SL_relay_service_continuity.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Mr is expressed in dBm or dB, depending on the measurement quantity of serving L2 U2N Relay UE.","paragraph_zero_based":336},{"literal_text_all_w_t_and_m_t":"Mn is expressed in dBm or dB, depending on the measurement quantity of candidate L2 U2N Relay UE.","paragraph_zero_based":337},{"literal_text_all_w_t_and_m_t":"Hys are expressed in dB.","paragraph_zero_based":338},{"literal_text_all_w_t_and_m_t":"Thresh1 is expressed in the same unit as Mr.","paragraph_zero_based":339},{"literal_text_all_w_t_and_m_t":"Thresh2 is expressed in the same unit as Mn.","paragraph_zero_based":340},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":341},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":342},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":343},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":344},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":345},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":346},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":347},{"literal_text_all_w_t_and_m_t":"NEXT CHANGE","paragraph_zero_based":348},{"literal_text_all_w_t_and_m_t":"5.5.5Measurement reporting","paragraph_zero_based":349},{"literal_text_all_w_t_and_m_t":"5.5.5.1General","paragraph_zero_based":350},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":351},{"literal_text_all_w_t_and_m_t":"Figure 5.5.5.1-1: Measurement reporting","paragraph_zero_based":352},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to transfer measurement results from the UE to the network. The UE shall initiate this procedure only after successful AS security activation.","paragraph_zero_based":353},{"literal_text_all_w_t_and_m_t":"For the measId for which the measurement reporting procedure was triggered, the UE shall set the measResults within the MeasurementReport message as follows:","paragraph_zero_based":354},{"literal_text_all_w_t_and_m_t":"1>set the measId to the measurement identity that triggered the measurement reporting;","paragraph_zero_based":355},{"literal_text_all_w_t_and_m_t":"1>for each serving cell configured with servingCellMO:","paragraph_zero_based":356},{"literal_text_all_w_t_and_m_t":"2>if the reportConfig associated with the measId that triggered the measurement reporting includes rsType:","paragraph_zero_based":357},{"literal_text_all_w_t_and_m_t":"3>if the serving cell measurements based on the rsType included in the reportConfig that triggered the measurement report are available:","paragraph_zero_based":358},{"literal_text_all_w_t_and_m_t":"4>set the measResultServingCell within measResultServingMOList to include RSRP, RSRQ and the available SINR of the serving cell, derived based on the rsType included in the reportConfig that triggered the measurement report;","paragraph_zero_based":359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"78722f96da2c1b0794be02771e6d00815867826bc913cd2dc90778e7cf20a03c","original_member_sha256":"01249659941507b71cdd3a9a4350d5330966e5252dc21fbfc70854bb5a08b2f1","paragraph_ElementTree_utf8_XML_sha256":["5f85404ba8ea68cdd14760e81584691b60d6be6b87394a8c6154e287d52f58ed","2117144cfe290c04055d6c11ee0e54ce9e1ba959689f81466e0a1a13cca015a1","74225c097ca4f6366f74670670d89468706c274de1f8847dbd413bb6c54d33cc","f80fde0540f0c764265164f87d40c3a8b33b7c7f3632fb76da71ec90a105717a","47fb1b4e23607fdc386ee35a26565fb778a10f674300f49e5ff32215dd79aec8","0ff6334a857393705e8493a294d4c29af23a4577259ce2be34a8898af17a4d6d","77ef2ce2960fb16b7d59c8c3e1241d4f4312aaf528c580562ac7f185bc299de3","ddfa0575442b024878daf50f21737c5fd3cf0d14f596680293f5ab106b6277ad","339b5f578a69eb2440839ac2c45e616ba99d260d36c4a3b1acff40dfa7dd8870","1bc1ea3069c7ea5f44ba76283a98846658b33ea022674db81121bb3dfbd43d4c","d9fa744452cfe2ba3d06197cb593eab06386401fafc89f5fb964b15018902511","81dcfccc718c74608ed550ccf34ae13742f881de56109d70457a2d9cb84bebea","a0ac3c34725fafc8e7096f8bfed493cabdb4e598e7f8b094c9029b026b43b13d","cc47e51f75f1de72fa88633803355e2871e2c9419701be2db198f74858ec4489","61b4ab815d26e25b92bf314336e59ac5abd9060fc458f06a583f33c92bba97f4","feb35c41131f7033d4d667fa49af1c56bbf381f1dbc7483394c299dd46408d7b","bbc1bc8f30ca4ff84d068a6708232917fd020c0812646fccfc169749e035aae3","96e80faefce0a5e7f5f24ef3bdf984d090f5702d954f001416ddbf1613d95d6c","5e343a33e9fa570cf62274131750c731db744ce85bcbda915a6fc23ee8e8634e","ea11e9a48ddab38092c96c93abb85c8cf030ff7401b5e73f7bfee04086766536","a98f9f62680a7393a59737b34ef94455336f22a6114aa06e7dbada0ad51adecc","52b6a30c2ca5396dfc8dbefb0389c8f8cf24a94ff94ae1801446d89aa1e6cfbd","ad56c6f59bbe323a4759a55c7948fb1729d41fb1a3b5e6df376b94e249b18652","0aa04f828d4bae11c3272378a62fddf65f30a7dcd9695adbc0513b14a4c35f46"],"paragraph_range_zero_based":[336,359],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312499.zip::R2-2312499_38.331_Rel-18_SL_relay_service_continuity.docx:p336"}
{"fields":{"filename":"R2-2312499.zip::R2-2312499_38.331_Rel-18_SL_relay_service_continuity.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":360},{"literal_text_all_w_t_and_m_t":"3>if SSB based serving cell measurements are available:","paragraph_zero_based":361},{"literal_text_all_w_t_and_m_t":"4>set the measResultServingCell within measResultServingMOList to include RSRP, RSRQ and the available SINR of the serving cell, derived based on SSB;","paragraph_zero_based":362},{"literal_text_all_w_t_and_m_t":"3>else if CSI-RS based serving cell measurements are available:","paragraph_zero_based":363},{"literal_text_all_w_t_and_m_t":"4>set the measResultServingCell within measResultServingMOList to include RSRP, RSRQ and the available SINR of the serving cell, derived based on CSI-RS;","paragraph_zero_based":364},{"literal_text_all_w_t_and_m_t":"1>set the servCellId within measResultServingMOList to include each NR serving cell that is configured with servingCellMO, if any;","paragraph_zero_based":365},{"literal_text_all_w_t_and_m_t":"1>if the reportConfig associated with the measId that triggered the measurement reporting includes reportQuantityRS-Indexes and maxNrofRS-IndexesToReport:","paragraph_zero_based":366},{"literal_text_all_w_t_and_m_t":"2>for each serving cell configured with servingCellMO, include beam measurement information according to the associated reportConfig as described in 5.5.5.2;","paragraph_zero_based":367},{"literal_text_all_w_t_and_m_t":"1>if the reportConfig associated with the measId that triggered the measurement reporting includes reportAddNeighMeas:","paragraph_zero_based":368},{"literal_text_all_w_t_and_m_t":"2>for each measObjectId referenced in the measIdList which is also referenced with servingCellMO, other than the measObjectId corresponding with the measId that triggered the measurement reporting:","paragraph_zero_based":369},{"literal_text_all_w_t_and_m_t":"3>if the measObjectNR indicated by the servingCellMO includes the RS resource configuration corresponding to the rsType indicated in the reportConfig:","paragraph_zero_based":370},{"literal_text_all_w_t_and_m_t":"4>set the measResultBestNeighCell within measResultServingMOList to include the physCellId and the available measurement quantities based on the reportQuantityCell and rsType indicated in reportConfig of the non-serving cell corresponding to the concerned measObjectNR with the highest measured RSRP if RSRP measurement results are available for cells corresponding to this measObjectNR, otherwise with the highest measured RSRQ if RSRQ measurement results are available for cells corresponding to this measObjectNR, otherwise with the highest measured SINR;","paragraph_zero_based":371},{"literal_text_all_w_t_and_m_t":"4>if the reportConfig associated with the measId that triggered the measurement reporting includes reportQuantityRS-Indexes and maxNrofRS-IndexesToReport:","paragraph_zero_based":372},{"literal_text_all_w_t_and_m_t":"5>for each best non-serving cell included in the measurement report:","paragraph_zero_based":373},{"literal_text_all_w_t_and_m_t":"6>include beam measurement information according to the associated reportConfig as described in 5.5.5.2;","paragraph_zero_based":374},{"literal_text_all_w_t_and_m_t":"1>if the reportConfig associated with the measId that triggered the measurement reporting is set to eventTriggered and eventID is set to eventA3, or eventA4, or eventA5, or eventB1, or eventB2:","paragraph_zero_based":375},{"literal_text_all_w_t_and_m_t":"2>if the UE is in NE-DC and the measurement configuration that triggered this measurement report is associated with the MCG:","paragraph_zero_based":376},{"literal_text_all_w_t_and_m_t":"3>set the measResultServFreqListEUTRA-SCG to include an entry for each E-UTRA SCG serving frequency with the following:","paragraph_zero_based":377},{"literal_text_all_w_t_and_m_t":"4>include carrierFreq of the E-UTRA serving frequency;","paragraph_zero_based":378},{"literal_text_all_w_t_and_m_t":"4>set the measResultServingCell to include the available measurement quantities that the UE is configured to measure by the measurement configuration associated with the SCG;","paragraph_zero_based":379},{"literal_text_all_w_t_and_m_t":"4>if reportConfig associated with the measId that triggered the measurement reporting includes reportAddNeighMeas:","paragraph_zero_based":380},{"literal_text_all_w_t_and_m_t":"5>set the measResultServFreqListEUTRA-SCG to include within measResultBestNeighCell the quantities of the best non-serving cell, based on RSRP, on the concerned serving frequency;","paragraph_zero_based":381},{"literal_text_all_w_t_and_m_t":"1>if reportConfig associated with the measId that triggered the measurement reporting is set to eventTriggered and eventID is set to eventA3, or eventA4, or eventA5:","paragraph_zero_based":382},{"literal_text_all_w_t_and_m_t":"2>if the UE is in NR-DC and the measurement configuration that triggered this measurement report is associated with the MCG:","paragraph_zero_based":383}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"78722f96da2c1b0794be02771e6d00815867826bc913cd2dc90778e7cf20a03c","original_member_sha256":"01249659941507b71cdd3a9a4350d5330966e5252dc21fbfc70854bb5a08b2f1","paragraph_ElementTree_utf8_XML_sha256":["fc5bbbd85216f9d69aa930c4ae38eaeb57638d3479a7585fb54a70a1b9d8f299","468585258a69b13afeffd34f0986bc1c8506555a4c18825cf656fb1de4933eee","bd93c40fe4095bc27063c7fe601a52cb1136202a97c743a1d7dbd92e7345e1fe","0bf5fe1bde5269b1db9e429a78fe732739c7a2457fb730653fe8d7dab820f323","54b198e06acd6c10dba6063e58b1bc7cb828d8f1ef62b9c554df701f28afc39e","b5b985a4a80dff3710f8e97b1af22189e76db4236a13aba14757569e268149c8","a2add2e7389dfabecd048cf32a28dad9b92302f96b420f5618e3c9eb3b5cb926","96b60c3c382f