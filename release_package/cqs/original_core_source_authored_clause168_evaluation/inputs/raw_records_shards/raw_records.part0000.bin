{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":19368},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":19369},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19370},{"literal_text_all_w_t_and_m_t":"MeasObjectToRemoveList ::=              SEQUENCE (SIZE (1..maxNrofObjectId)) OF MeasObjectId","paragraph_zero_based":19371},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19372},{"literal_text_all_w_t_and_m_t":"MeasIdToRemoveList ::=                  SEQUENCE (SIZE (1..maxNrofMeasId)) OF MeasId","paragraph_zero_based":19373},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19374},{"literal_text_all_w_t_and_m_t":"ReportConfigToRemoveList ::=            SEQUENCE (SIZE (1..maxReportConfigId)) OF ReportConfigId","paragraph_zero_based":19375},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19376},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASCONFIG-STOP","paragraph_zero_based":19377},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":19378},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19379},{"literal_text_all_w_t_and_m_t":"MeasConfig field descriptions","paragraph_zero_based":19380},{"literal_text_all_w_t_and_m_t":"interFrequencyConfig-NoGap-r16","paragraph_zero_based":19381},{"literal_text_all_w_t_and_m_t":"If the field is set to true, UE is configured to perform SSB based inter-frequency measurement without measurement gaps when the inter-frequency SSB is completely contained in the active DL BWP of the UE, as specified in TS 38.133 [14], clause 9.3. Otherwise, the SSB based inter-frequency measurement is performed within measurement gaps. In NR-DC, the field can only be configured in the measConfig associated with MCG, and when configured, it applies to all the inter-frequency measurements configured by MN and SN.","paragraph_zero_based":19382},{"literal_text_all_w_t_and_m_t":"measGapConfig","paragraph_zero_based":19383},{"literal_text_all_w_t_and_m_t":"Used to setup and release measurement gaps in NR.","paragraph_zero_based":19384},{"literal_text_all_w_t_and_m_t":"measIdToAddModList","paragraph_zero_based":19385},{"literal_text_all_w_t_and_m_t":"List of measurement identities to add and/or modify.","paragraph_zero_based":19386},{"literal_text_all_w_t_and_m_t":"measIdToRemoveList","paragraph_zero_based":19387},{"literal_text_all_w_t_and_m_t":"List of measurement identities to remove.","paragraph_zero_based":19388},{"literal_text_all_w_t_and_m_t":"measObjectToAddModList","paragraph_zero_based":19389},{"literal_text_all_w_t_and_m_t":"List of measurement objects to add and/or modify.","paragraph_zero_based":19390},{"literal_text_all_w_t_and_m_t":"measObjectToRemoveList","paragraph_zero_based":19391}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["59d717045ff20cd3c52ce5bd0890f98192ad8a2568fc475999e860277a9114cd","f53ed45deb3813aa7df47483572e7a36bb7ac6eb53a5a6d79d6970d2334c9162","4a5310627973b9a644bba4d401740d84e5e29c7f10a6bcc891a871aea1fdaade","69e0d1d18e7b2b460d2ac696e03ab17d345fd0e5aa8140f767d17d5c69ff3708","46ec55a3577c04c234e137b3aa1d2ec102c1ea64f036a105eb78880e3a040c6f","494418c7c90a00a7f57278300c0f435c986806c58cbb6933d9d169dbe584c27a","6b0f2a5ae2e1c49191e0eb815de6df8bca979aa35f8be4f6d337e3e6c0478911","cb358c10ae1b44c573816ed2ea62888d54cbe87809649e0ce824e84ed1cec46a","e80e9fc84be4e23edea56bc383da45f25d42952f4f1f88483fba636629911733","a85717a49737ca3a05248224dc107d7788b7e422b0ae32d37e6cb8c462977340","df383de606eaeaacfc00a7fe5459f12b89333b400ded711d363233e138c612b4",