{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-MEASCONFIG-STOP","paragraph_zero_based":17136},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17137},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17138},{"literal_text_all_w_t_and_m_t":"CSI-MeasConfig field descriptions","paragraph_zero_based":17139},{"literal_text_all_w_t_and_m_t":"aperiodicTriggerStateList","paragraph_zero_based":17140},{"literal_text_all_w_t_and_m_t":"Contains trigger states for dynamically selecting one or more aperiodic and semi-persistent reporting configurations and/or triggering one or more aperiodic CSI-RS resource sets for channel and/or interference measurement (see TS 38.214 [19], clause 5.2.1).","paragraph_zero_based":17141},{"literal_text_all_w_t_and_m_t":"csi-IM-ResourceSetToAddModList","paragraph_zero_based":17142},{"literal_text_all_w_t_and_m_t":"Pool of CSI-IM-ResourceSet which can be referred to from CSI-ResourceConfig or from MAC CEs.","paragraph_zero_based":17143},{"literal_text_all_w_t_and_m_t":"csi-IM-ResourceToAddModList","paragraph_zero_based":17144},{"literal_text_all_w_t_and_m_t":"Pool of CSI-IM-Resource which can be referred to from CSI-IM-ResourceSet.","paragraph_zero_based":17145},{"literal_text_all_w_t_and_m_t":"csi-ReportConfigToAddModList","paragraph_zero_based":17146},{"literal_text_all_w_t_and_m_t":"Configured CSI report settings as specified in TS 38.214 [19] clause 5.2.1.1.","paragraph_zero_based":17147},{"literal_text_all_w_t_and_m_t":"csi-ResourceConfigToAddModList","paragraph_zero_based":17148},{"literal_text_all_w_t_and_m_t":"Configured CSI resource settings as specified in TS 38.214 [19] clause 5.2.1.2.","paragraph_zero_based":17149},{"literal_text_all_w_t_and_m_t":"csi-SSB-ResourceSetToAddModList","paragraph_zero_based":17150},{"literal_text_all_w_t_and_m_