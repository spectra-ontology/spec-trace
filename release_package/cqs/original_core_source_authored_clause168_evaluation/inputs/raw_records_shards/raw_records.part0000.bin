{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"E-UTRAN","paragraph_zero_based":43272},{"literal_text_all_w_t_and_m_t":"May be included if UE Radio Capability ID as specified in 23.502 [43] is used for the UE. Included otherwise.","paragraph_zero_based":43273},{"literal_text_all_w_t_and_m_t":"May be included","paragraph_zero_based":43274},{"literal_text_all_w_t_and_m_t":"May be included","paragraph_zero_based":43275},{"literal_text_all_w_t_and_m_t":"May be included, ignored by gNB if received","paragraph_zero_based":43276},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43277},{"literal_text_all_w_t_and_m_t":"NOTE 2:The following table indicates, in case of inter-RAT handover from E-UTRA, which additional IEs are included or not:","paragraph_zero_based":43278},{"literal_text_all_w_t_and_m_t":"Source system","paragraph_zero_based":43279},{"literal_text_all_w_t_and_m_t":"sourceConfig","paragraph_zero_based":43280},{"literal_text_all_w_t_and_m_t":"rrm-Config","paragraph_zero_based":43281},{"literal_text_all_w_t_and_m_t":"as-Context","paragraph_zero_based":43282},{"literal_text_all_w_t_and_m_t":"E-UTRA/EPC","paragraph_zero_based":43283},{"literal_text_all_w_t_and_m_t":"Not included","paragraph_zero_based":43284},{"literal_text_all_w_t_and_m_t":"May be included","paragraph_zero_based":43285},{"literal_text_all_w_t_and_m_t":"Not included","paragraph_zero_based":43286},{"literal_text_all_w_t_and_m_t":"E-UTRA/5GC","paragraph_zero_based":43287},{"literal_text_all_w_t_and_m_t":"May be included, but only radioBearerConfig is included in the RRCReconfiguration.","paragraph_zero_based":43288},{"literal_text_all_w_t_and_m_t":"May be included","paragraph_zero_based":43289},{"literal_text_all_w_t_and_m_t":"Not included","paragraph_zero_based":43290},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43291},{"literal_text_all_w_t_and_m_t":"–CG-Config","paragraph_zero_based":43292},{"literal_text_all_w_t_and_m_t":"This message is used to transfer the SCG radio configuration as generated by the SgNB or SeNB. It can also be used by a CU to request a DU to perform certain actions, e.g. to request the DU to perform a new lower layer configuration.","paragraph_zero_based":43293},{"literal_text_all_w_t_and_m_t":"Direction: Secondary gNB or eNB to master gNB or eNB, alternatively CU to DU.","paragraph_zero_based":43294},{"literal_text_all_w_t_and_m_t":"CG-Config message","paragraph_zero_based":43295}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["18c2600e12fb307d44fb493b2b59f1bfd488316affb121f368cbeddf5179624f","d6b1567421da7deeaefbe55eb96cc27ceb620cb5acbb7aa4bcaa8459c404cf3c","8668e339841cd5961ce176fcc9ca9df0d66ebdfb9168b4bab18b9d8ddb6dd4a3","99674efb3f8383d8ff414a53ed9649ef5df848fdab236d2f0d9cc106a0cf61ac","ffe55446eebac15aadbb4496084b809ba6a38814657b4de177888b7200eda195","3edb4862a7f7d6b17ac6f747e8e133ffb2740499f3e4c6a06867662825198c47","74147f7fca46f7dc9932c67b9af9ef1952fb82397d355de4eed583a7201fbda2","710fe5550d3295bc820b03ab8a921b2e82764537e7852f2ab0d98878f3ead9bf","e6faabdcbf7e65b001bf58649399c8cef07a8f9e4c149977b87b65e93cfda7a2","e2d132c64acbdb5665dbc143074283458c04f5d4c3df95b97c55795c5e3c0776","57880ae0193ce89a3f5df43422c03b24c52c53c038ee08fda8f098f5bbefcf63","4498b9da106f7b2ff673996b672d35c7c62a89713d74dd876959480ae0519d0f","45e91474df144117db2fad2af7c6e6fb281b01542e00cf47e985570c9142cac5","3903cacdefe3e4008c620bf4fe172c7e73789866965076e591ae38e0e44c9bc5","e37de5b1f674635ee57d087e166f934bcbc9c8908a9f556534f52f23c3b3886b","e8616080ae356f6ea40e3d155dcbaa5ce3cbca4476b