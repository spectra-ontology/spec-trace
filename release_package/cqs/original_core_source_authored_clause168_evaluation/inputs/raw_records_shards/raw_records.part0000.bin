{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ran-AreaCells","paragraph_zero_based":10320},{"literal_text_all_w_t_and_m_t":"The total number of cells of all PLMNs does not exceed 32.","paragraph_zero_based":10321},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10322},{"literal_text_all_w_t_and_m_t":"SDT-Config field descriptions","paragraph_zero_based":10323},{"literal_text_all_w_t_and_m_t":"sdt-DRB-ContinueROHC","paragraph_zero_based":10324},{"literal_text_all_w_t_and_m_t":"Indicates whether the PDCP entity of the radio bearers configured for SDT continues or resets the ROHC header compression protocol during PDCP re-establishment during SDT procedure, as specified in TS 38.323 [5]. Value cell indicates that ROHC header compression continues when the UE resumes for SDT in the same cell as the PCell when the RRCRelease message was received. Value rna indicates that ROHC header compression continues when the UE resumes for SDT in a cell belonging to the same RNA as the PCell where the RRCRelease message was received. If the field is absent, the UE releases any stored value for this field and the PDCP entity of the radio bearers configured for SDT always resets the ROHC header compression protocol during PDCP re-establishment when SDT procedure is initiated, as specified in TS 38.323 [5].","paragraph_zero_based":10325},{"literal_text_all_w_t_and_m_t":"sdt-DRB-List","paragraph_zero_based":10326},{"literal_text_all_w_t_and_m_t":"Indicates the ID(s) of the DRB(s) that are configured for SDT. If size of the sequence is zero, then the UE assumes that none of the DRBs are configured for SDT. The network only configures MN terminated MCG bearers for SDT.","paragraph_zero_based":10327},{"literal_text_all_w_t_and_m_t":"sdt-SRB2-Indication","paragraph_zero_based":10328},{"literal_text_all_w_t_and_m_t":"Indiates whether SRB2 is configured for SDT or not.","paragraph_zero_based":10329},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10330},{"literal_text_all_w_t_and_m_t":"SDT-MAC-PHY-CG-Config field descriptions","paragraph_zero_based":10331},{"literal_text_all_w_t_and_m_t":"cg-SDT-ConfigInitialBWP-DL","paragraph_zero_based":10332},{"literal_text_all_w_t_and_m_t":"Downlink BWP configuration for CG-SDT. If a UE is a RedCap UE and if the initialDownlinkBWP-RedCap is configured in downlinkConfigCommon in SIB1, this field is configured for initialDownlinkBWP-RedCap, otherwise it is configured for initialDownlinkBWP.","paragraph_zero_based":10333},{"literal_text_all_w_t_and_m_t":"cg-SDT-ConfigInitialBWP-NUL","paragraph_zero_based":10334},{"literal_text_all_w_t_and_m_t":"UL BWP configuration for CG-SDT on NUL carrier. If a UE is a RedCap UE and if the initialUplinkBWP-RedCap is configured in uplinkConfigCommon in SIB1, this field is configured for initialUplinkBWP-RedCap, otherwise it is configured for initialUplinkBWP for NUL.","paragraph_zero_based":10335},{"literal_text_all_w_t_and_m_t":"cg-SDT-ConfigInitialBWP-SUL","paragraph_zero_based":10336},{"literal_text_all_w_t_and_m_t":"UL BWP configuration for CG-SDT on SUL carrier configured for the initialUplinkBWP for SUL.","paragraph_zero_based":10337},{"literal_text_all_w_t_and_m_t":"cg-SDT-CS-RNTI","paragraph_zero_based":10338},{"literal_text_all_w_t_and_m_t":"The CS-RNTI value for CG-SDT as specified in TS 38.321 [3].","paragraph_zero_based":10339},{"literal_text_all_w_t_and_m_t":"cg-SDT-RSRP-ThresholdSSB","paragraph_zero_based":10340},{"literal_text_all_w_t_and_m_t":"An RSRP threshold configured for SSB selection for CG-SDT as specified in TS 38.321 [3].","paragraph_zero_based":10341},{"literal_text_all_w_t_and_m_t":"cg-SDT-TA-ValidationConfig","paragraph_zero_based":10342},{"literal_text_all_w_t_and_m_t":"Configuration for the RSRP based TA validation. If this field is not configured, then the UE does not perform RSRP based TA validation.","paragraph_zero_based":10343}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["12dfa15e9d78c4f92f5e22453559de46e510b7ccdb9dd6942787d66064350e85","b75ded31eb496646d91182f46b679c09936a5266527053ce05e6fe4842196266","ea187f0e8721c7ba7448ecc003327b82a5e396b0c1a4d93037f94ce73d066c5a","92c0781303032e43767f72209b0dfc0586b691c8b5cf7bfdf2713c64e22125b6","80ac77af155554f0d9546f26667e7d207231ca63b4fd2d00709de922f99f1882","82a6de5bac6fc15f42f27fc75897ef045adb2c029252f4cb30c16d1c8b99cc78","00f441dd8611f36e49f7175f95010a9649b89b52c6b19773ed4e08ef6e254651","6cfe3d180ddebf1279f540c3e24d6fa457c4efcb9a94bdec17976b2ff8e28c1e","b8165bb9ed965beda1b13f82ab6e10ffcf6c6b8cbf075ce41b43281677badbbf","80f7392dc6c830882edad6cb6dbbbcf52a8cbff91b054eb71269c32fedce7213","221d71787ca282ee56d559394974e4553b91fdc75ce0f57dccdd1d9bd6d70a35","17997f62d2e14c3a6f4bf3d076fc37c5ba09f113981bac64ccfd671d269d8545","9146e285d2f5d65c7191bb0faff1c603aac17a2eb62cd79c7ca3a16bd95487c8","bd533d433c62c8bbd657b737624189da48263e9d38da92c0ee7aebd088453862","03db60f46e2971014811243939c3faef1dba0a577c033fc27a9487a4d36ef228","ed3fc8817f0c34867a3f650b1ad18efbbaa1fb201372dd3041e34fce8936566c","fb25ab9b5a7f99eeed0a8d06e55bc3bab5df14dfa7c66d6768e60ecea3c1f7d6","6abbd11c4b383d479b313350844b2108cd7708d41d3137fe5bffa284d7a641cb","6c316a74281c1d7fd0a54dc57419ab362fdb648974dd2814c722db049fb5f964","5d999e82640c0419cee1810c988a315c3c428f1497b251eb6cf57782136ef071","2b0972defdcf060a80b80a1b132b33b4bd81519dd5c009a09a5116a619d2af65","f7df200a64a92a70e2394186f2cf42657ffc0d3cd199836f3c5c794593a1f86a","cf51ffe7311ae2d39d87d0612bf4e20bfbfe1532f30c02215c43aabe8ca36380","06c189133e4b99d790b873801565d5552e79e9a5b7853a0f8e4567c2c9cc1ae5"],"paragraph_range_zero_based":[10320,10343],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p10320"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"cg-SDT-timeAlignmentTimer","paragraph_zero_based":10344},{"literal_text_all_w_t_and_m_t":"TAT value for CG-SDT as specified in TS 38.321 [3]. The network always configures this field when sdt-MAC-PHY-CG-Config is configured.","paragraph_zero_based":10345},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10346},{"literal_text_all_w_t_and_m_t":"CG-SDT-ConfigLCH-Restriction field descriptions","paragraph_zero_based":10347},{"literal_text_all_w_t_and_m_t":"allowedCG-List","paragraph_zero_based":10348},{"literal_text_all_w_t_and_m_t":"This restriction applies only when the UL grant is a configured grant for CG-SDT. If present, UL MAC SDUs from this logical channel can only be mapped to the indicated CG-SDT configured grant configuration. If the size of the sequence is zero, then UL MAC SDUs from this logical channel cannot be mapped to any CG-SDT configured grant configurations. If the field is not present, UL MAC SDUs from this logical channel can be mapped to any CG-SDT configured grant configurations. If the field configuredGrantType1Allowed is present, only those CG-SDT configured grant type 1 configurations indicated in this sequence are allowed for use by this logical channel; otherwise, this sequence shall not include any CG-SDT configured grant type 1 configuration. Corresponds to \"allowedCG-List\" as specified in TS 38.321 [3].","paragraph_zero_based":10349},{"literal_text_all_w_t_and_m_t":"configuredGrantType1Allowed","paragraph_zero_based":10350},{"literal_text_all_w_t_and_m_t":"If present, or if the capability lcp-Restriction as specified in TS 38.306 [26] is not supported, UL MAC SDUs from this logical channel can be transmitted on a configured grant type 1 for CG-SDT. Otherwise, UL MAC SDUs from this logical channel cannot be transmitted on a configured grant type 1 for CG-SDT. Corresponds to \"configuredGrantType1Allowed\" in TS 38.321 [3].","paragraph_zero_based":10351},{"literal_text_all_w_t_and_m_t":"logicalChannelIdentity","paragraph_zero_based":10352},{"literal_text_all_w_t_and_m_t":"ID used commonly for the MAC logical channel and for the RLC bearer associated with a servedRadioBearer configured for SDT.","paragraph_zero_based":10353},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10354},{"literal_text_all_w_t_and_m_t":"CG-SDT-TA-ValidationConfig field descriptions","paragraph_zero_based":10355},{"literal_text_all_w_t_and_m_t":"cg-SDT-RSRP-ChangeThreshold","paragraph_zero_based":10356},{"literal_text_all_w_t_and_m_t":"The RSRP threshold for TA validation for CG-SDT as specified in TS 38.321 [3]. Value dB2 corresponds to 2 dB, value dB4 corresponds to 4 dB and so on.","paragraph_zero_based":10357},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10358},{"literal_text_all_w_t_and_m_t":"SRS-PosRRC-InactiveConfig field descriptions","paragraph_zero_based":10359},{"literal_text_all_w_t_and_m_t":"bwp-NUL","paragraph_zero_based":10360},{"literal_text_all_w_t_and_m_t":"BWP configuration for SRS for Positioning during the RRC_INACTIVE state in Normal Uplink Carrier. If the field is absent UE is configured with an SRS for Positioning associated with the initial UL BWP and transmitted, during the RRC_INACTIVE state, inside the initial UL BWP with the same CP and SCS as configured for initial UL BWP.","paragraph_zero_based":10361},{"literal_text_all_w_t_and_m_t":"bwp-SUL","paragraph_zero_based":10362},{"literal_text_all_w_t_and_m_t":"BWP configuration for SRS for Positioning during the RRC_INACTIVE state in Supplementary Uplink Carrier. If the field is absent UE is configured with an SRS for Positioning associated with the initial UL BWP and transmitted, during the RRC_INACTIVE state, inside the initial UL BWP with the same CP and SCS as configured for initial UL BWP.","paragraph_zero_based":10363},{"literal_text_all_w_t_and_m_t":"inactivePosSRS-RSRP-ChangeThreshold","paragraph_zero_based":10364},{"literal_text_all_w_t_and_m_t":"RSRP threshold for the increase/decrease of RSRP for time alignment validation as specified in TS 38.321 [3].","paragraph_zero_based":10365},{"literal_text_all_w_t_and_m_t":"inactivePosSRS-TimeAlignmentTimer","paragraph_zero_based":10366},{"literal_text_all_w_t_and_m_t":"TAT value for SRS for positioning transmission during RRC_INACTIVE state as specified in TS 38.321 [3]. The network always configures this field when srs-PosRRC-Inactive is configured.","paragraph_zero_based":10367}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["b01d84711f34a4b48cb9510b10d5ae3d50fc8020583f81df88ec219c309b9ae9","10bd0434e7266cd5dddf2157e6c7d475299564927bdef99cf92150a2c162818c","7e6b2f27f043d376df6e1511893dbf84c8fe5952b50cd6169ffe865c2132a8cc","2c42c3278ce7d5ebf5b9d5047ddcb2a089fc0f9476c05550b0c707a417095724","a1c50da6494bd0270fc23607b6db7db1c591fbe3664a143552c9cf9b80066a47","87552fc382927e457459d7c4041f57d2fa7182bc3a1ec5b21d48618352232b28","5df89ef8e027297848277520b1cb51dd0c1c03a16845795bc455efd56fe0370b","b8e2dadde30cac9946e43d366dbf70df5278770393069e312373e52e24fe7109","8a30a1998aff0e8295b53087e02db0700db6ab5b768c0e61f5c87c45696918cb","e2dc24c2b7ba6ce5cbe6eab5230d56288b4f545d4907439815c8289423e146f6","0fedd07d62f90108b69da97a98eedf5068c2168475ab28ae05f994c8e265ba1a","84af8d7d90dd1baf64be1e81634cdfe8be603ab682a24bbc928586208b747985","4422ae0bd3993a73381c9321b05406200d8f142fab85e7b3ff23a5180dd5f9a8","7693981b5208d7915999f454caa75f595976ef9c3e0cf00cb9ecc5aee0bed956","f2cba173436204d2a7ea1964cf290720272733f24f3cc52e94e69e2a3226898f","c2c13eed6afdaddc4e2aec2f8ac122cc4b450987b51f92f7ade167219686c7a4","baea8bd969078a1b3156ae65339975293afc70284fa03a82023fd9b7c126c093","695feb3aeff18f61d4cbeb4d5db55f58629f511be62451225f44f2adeb7f0371","702a1dd3bf44d2f9248738230f85bb2b94651da73d49e200097f5e6b405267d0","dd0d14b6ecbf994dcaa5c4fb80124930a7d3ce5305ff137ca7298daa4696137a","c3bb65be8241579577369fbe4eea0730bd23c50db8b45731015499cf1107ce5d","4fedb1888af00f2017878ee43b6f7da7aa3f54da20240dea3be6e2232b6e0037","54f72c4ab0364bc196f775ab9f17bd14dbaacf7ca5ff1b0f00822678f453b491","3a4dca33cf769ff9b411f37bb53d449a570012facc75afce80f0997871b855dc"],"paragraph_range_zero_based":[10344,10367],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p10344"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"srs-PosConfigNUL","paragraph_zero_based":10368},{"literal_text_all_w_t_and_m_t":"SRS for Positioning configuration in RRC_INACTIVE state in Normal Uplink Carrier.","paragraph_zero_based":10369},{"literal_text_all_w_t_and_m_t":"srs-PosConfigSUL","paragraph_zero_based":10370},{"literal_text_all_w_t_and_m_t":"SRS for Positioning configuration in RRC_INACTIVE state in Supplementary Uplink Carrier.","paragraph_zero_based":10371},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10372},{"literal_text_all_w_t_and_m_t":"SuspendConfig field descriptions","paragraph_zero_based":10373},{"literal_text_all_w_t_and_m_t":"ncd-SSB-RedCapInitialBWP-SDT","paragraph_zero_based":10374},{"literal_text_all_w_t_and_m_t":"Indicates that the UE uses the RedCap-specific initial DL BWP associated with the NCD-SSB for SDT. The network configures this field if a RedCap UE is configured with SDT in the RedCap-specific initial DL BWP not associated with CD-SSB. If configured, the NCD-SSB indicated by this field can only be used during the SDT procedure for CG-SDT or RA-SDT.","paragraph_zero_based":10375},{"literal_text_all_w_t_and_m_t":"ran-ExtendedPagingCycle","paragraph_zero_based":10376},{"literal_text_all_w_t_and_m_t":"The extended DRX (eDRX) cycle for RAN-initiated paging to be applied by the UE. Value rf256 corresponds to 256 radio frames, value rf512 corresponds to 512 radio frames and so on. Value of the field indicates an eDRX cycle which is shorter or equal to the IDLE mode eDRX cycle configured for the UE.","paragraph_zero_based":10377},{"literal_text_all_w_t_and_m_t":"ran-NotificationAreaInfo","paragraph_zero_based":10378},{"literal_text_all_w_t_and_m_t":"Network ensures that the UE in RRC_INACTIVE always has a valid ran-NotificationAreaInfo.","paragraph_zero_based":10379},{"literal_text_all_w_t_and_m_t":"ran-PagingCycle","paragraph_zero_based":10380},{"literal_text_all_w_t_and_m_t":"Refers to the UE specific cycle for RAN-initiated paging. Value rf32 corresponds to 32 radio frames, value rf64 corresponds to 64 radio frames and so on.","paragraph_zero_based":10381},{"literal_text_all_w_t_and_m_t":"sl-UEIdentityRemote","paragraph_zero_based":10382},{"literal_text_all_w_t_and_m_t":"Indicates the C-RNTI to the L2 U2N Remote UE.","paragraph_zero_based":10383},{"literal_text_all_w_t_and_m_t":"t380","paragraph_zero_based":10384},{"literal_text_all_w_t_and_m_t":"Refers to the timer that triggers the periodic RNAU procedure in UE. Value min5 corresponds to 5 minutes, value min10 corresponds to 10 minutes and so on.","paragraph_zero_based":10385},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10386},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":10387},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":10388},{"literal_text_all_w_t_and_m_t":"L2RemoteUE","paragraph_zero_based":10389},{"literal_text_all_w_t_and_m_t":"The field is mandatory present for L2 U2N Remote UE's RNAU; otherwise it is absent.","paragraph_zero_based":10390},{"literal_text_all_w_t_and_m_t":"RANPaging","paragraph_zero_based":10391}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["d7609ed4246a44ce787f31f5724cc77bd410c17fa940ef17f930d023d2bc76c0","ea40745f5c8c41b955c0e581ac3edb8f95301ebdc6c660c50afc77d5f689f956","3085525b1478f9624c4280383d466d71b213e2a6a258fb4f02ad26b4d29a59cd","d23c46eb472af1c999ab234736eae8ebdd04fb43fe1b5c5ef1e953288ee012a5","0e2325c22b608b33f2aff0d3f34d1eb289e5859a5fcea2daf1e023f1f4de1b92","88d9d9ca6b935e0073d859ea2c75b75f91735de5d4a1e8bdfdb9da0db1771146","87109320894043966ba96e45aa62d2e7ca8026ed67683f4d372e158ecae66b12","e9118c2ff546d2e7e0c19c888d4aae9024d30d6b86f3bf3432675ee4ab39435e","1279fdb733fba50be37fbc64dc2e885c2dd9037439350bcb4876875e4c22e36e","f3d7fb2e8a8a8c0530270359e217f51b0fbfe7c3c8e95f1f2dac362e50e423bb","6f1adad9a411a6aa5bb42b7ec14bd4f534cb4ffa08e38a573d771d681433ca35","ba53113de3e2740999a2b425b257de4998e08be422bd303f6e3e73f9c290c2e9","97ae51ec30de3d5769f2a36d0d54d1a32df454d3f6d9d5a78e1b44b50a27a3ea","aaf6c97d6829775eaaec0b9e0dc01072a494ff16cb4d5846d4e9f3544c166cd3","447a1e897bcba91d06db12c7fbaac24905f641ba8e8c2c899efe68f5567ffdeb","03ef7e2bb4d5222934cf42bc690e68cad1b2ead800a092dd4cf29a6dc1e2f3ce","94545e05e54d31bfecc8e50bcbc850019ee2a90d42a2807e95630ef0a670b9ba","1a97383d39a02cca48bdfd337fc01f571a893fe82b4cae30ae59410fc2f6f7f7","3b301e078aa01bfa25e5bc030f43ae98f31236d436092d72b81d47138e364128","28b1352aa1ca840219b98b45771b091052172e69c625eff7e46c68347dcd51af","2224b5e33e40a5651089b628d2fc9e464faf28c6bead2d433e7075d50facb170","8accb03a347b04c69df4bf06acfb6a9416f066ed1d10d9c16bde299473791b76","3e42bfa017540736931abd5369683eedc842ad3436d27937c0af0db3c707615e","0af337884f2820efad51bf7095618fc06bcb6c25e4d27adfcb4a7c6fe4d00794"],"paragraph_range_zero_based":[10368,10391],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p10368"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, if the UE is configured with IDLE eDRX, see TS 24.501 [23]; otherwise the field is not present.","paragraph_zero_based":10392},{"literal_text_all_w_t_and_m_t":"Redirection2","paragraph_zero_based":10393},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if redirectedCarrierInfo is included; otherwise the field is not present.","paragraph_zero_based":10394},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10395},{"literal_text_all_w_t_and_m_t":"–RRCResume","paragraph_zero_based":10396},{"literal_text_all_w_t_and_m_t":"The RRCResume message is used to resume the suspended RRC connection.","paragraph_zero_based":10397},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1","paragraph_zero_based":10398},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":10399},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":10400},{"literal_text_all_w_t_and_m_t":"Direction: Network to UE","paragraph_zero_based":10401},{"literal_text_all_w_t_and_m_t":"RRCResume message","paragraph_zero_based":10402},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":10403},{"literal_text_all_w_t_and_m_t":"-- TAG-RRCRESUME-START","paragraph_zero_based":10404},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10405},{"literal_text_all_w_t_and_m_t":"RRCResume ::=                       SEQUENCE {","paragraph_zero_based":10406},{"literal_text_all_w_t_and_m_t":"    rrc-TransactionIdentifier           RRC-TransactionIdentifier,","paragraph_zero_based":10407},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                  CHOICE {","paragraph_zero_based":10408},{"literal_text_all_w_t_and_m_t":"        rrcResume                           RRCResume-IEs,","paragraph_zero_based":10409},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture            SEQUENCE {}","paragraph_zero_based":10410},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":10411},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":10412},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10413},{"literal_text_all_w_t_and_m_t":"RRCResume-IEs ::=                   SEQUENCE {","paragraph_zero_based":10414},{"literal_text_all_w_t_and_m_t":"    radioBearerConfig                   RadioBearerConfig                                               OPTIONAL, -- Need M","paragraph_zero_based":10415}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["5e17a1eb4b93f18137d12775aa4279e5213167e5e2c0eabd9c0f883a6dedba02","5aca1fba66a0db41cc08bc34fc604602cb670bb7ff51c165977baf4422631cff","9a41479e7f1ca584ce1b7e65d8c9afc50f084dc6aafc1adaf291d145cb3ac652","197c5e8fc2b6960fe719d4710e48532f5824b9c1fa1eb08585b59744ea11230b","7fb0849243ca8544746827ed3f1f585715ce5641f91f23ebb8a1482382fd79a6","479f12a956d64f470f7faee50722bd17806145a08f3a110269cfe6e967709995","0958c81cae06fd69366e0e6708cb3070c1fb9a08d2f8c19e4b1271f034c59ca5","20a7b4cfbd3a5baab1be121b6458d97a1cc79136169a3c0039f1a76403f2fa96","c2a9957167715fa61c255509acaa30057cefdcfd093af81bf8c3b0f6e6491837","b309b6508a52c663921cb8277ebc3439ae6bb3a2dba41d9bad449dc5abf03e61","e819408e195e60839a30efc6606296029680df1af2bec2f94c12a78db2a9a6b9","6c67b13d399892007bb85dec35514e6f45cb2f2aa35d204bb3c654af982f108b","9b872b31e4eeaf678b036bcc4327429503bc912630316deddaca4e3d8d19c717","64a5860796df87485d19d2d4b6f502d3b92087605ef8411655d7eff3168ff626","cd4756e10048e228f67aa576e54a1bae40fe8291678507a3b94